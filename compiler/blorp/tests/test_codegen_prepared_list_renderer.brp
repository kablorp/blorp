func test_render_prepared_list_op_successes() -> Bool:
	pointer_ok: Bool = render_prepared_list_op(
		PointerGet(
			"xs",
			"idx",
		),
	) == "blorp_list_get((blorp_List*)xs, idx)"
	checked_ok: Bool = render_prepared_list_op(InlineCheckedGet({
		list = "xs",
		index = "idx",
		temp_seed = "seed",
		width_bytes = "8",
	})) == (
		"({ blorp_List* __lg_list_seed = (blorp_List*)xs; long __lg_idx_seed = idx; "
		+ "(__builtin_expect(!__lg_list_seed || __lg_idx_seed < 0 || __lg_idx_seed >= "
		+ "__lg_list_seed->len, 0) ? NULL : ({ uintptr_t __lg_bits_seed = 0; "
		+ "memcpy(&__lg_bits_seed, (char*)__lg_list_seed->data + __lg_idx_seed * 8, 8); "
		+ "(void*)__lg_bits_seed; })); })"
	)
	proven_ok: Bool = render_prepared_list_op(InlineProvenGet({
		list = "xs",
		index = "idx",
		temp_seed = "seed",
		width_bytes = "4",
	})) == (
		"({ blorp_List* __lg_list_seed = (blorp_List*)xs; long __lg_idx_seed = idx; ({ "
		+ "uintptr_t __lg_bits_seed = 0; memcpy(&__lg_bits_seed, (char*)__lg_list_seed-"
		+ ">data + __lg_idx_seed * 4, 4); (void*)__lg_bits_seed; }); })"
	)
	load_checked_ok: Bool = render_prepared_list_op(InlineStructLoadChecked({
		list_tmp = "__list",
		index_tmp = "__idx",
		out_tmp = "__out",
		temp_seed = "seed",
		struct_ty = "Small",
	})) == (
		"if (__builtin_expect(!__list || __idx < 0 || __idx >= __list->len, 0)) { "
		+ "memset(&__out, 0, sizeof(Small)); } else if (__list->storage_mode == "
		+ "BLORP_LIST_STORAGE_INLINE && __list->elem_size == (int16_t)sizeof(Small)) { "
		+ "memcpy(&__out, (char*)__list->data + __idx * sizeof(Small), sizeof(Small)); } "
		+ "else { void* __lg_raw_seed = blorp_list_get(__list, __idx); if (!__lg_raw_seed) "
		+ "{ memset(&__out, 0, sizeof(Small)); } else { __out = "
		+ "blorp_unbox_struct(__lg_raw_seed, Small); } }"
	)
	load_proven_ok: Bool = render_prepared_list_op(InlineStructLoadProven({
		list_tmp = "__list",
		index_tmp = "__idx",
		out_tmp = "__out",
		temp_seed = "seed",
		struct_ty = "Small",
	})) == (
		"if (__list->storage_mode == BLORP_LIST_STORAGE_INLINE && __list->elem_size == "
		+ "(int16_t)sizeof(Small)) { memcpy(&__out, (char*)__list->data + __idx * "
		+ "sizeof(Small), sizeof(Small)); } else { void* __lg_raw_seed = "
		+ "blorp_list_get(__list, __idx); if (!__lg_raw_seed) { memset(&__out, 0, "
		+ "sizeof(Small)); } else { __out = blorp_unbox_struct(__lg_raw_seed, Small); } }"
	)
	struct_unbox_list_name_ok: Bool = render_prepared_list_op(
		ListInlineStructUnboxListName("seed"),
	) == "__lg_list_seed"

	struct_unbox_index_name_ok: Bool = render_prepared_list_op(
		ListInlineStructUnboxIndexName("seed"),
	) == "__lg_idx_seed"

	struct_unbox_out_name_ok: Bool = render_prepared_list_op(
		ListInlineStructUnboxOutName("seed"),
	) == "__lg_out_seed"

	struct_unbox_open_ok: Bool = render_prepared_list_op(ListInlineStructUnboxOpen({
		list = "__lg_list_seed",
		list_expr = "xs",
		index = "__lg_idx_seed",
		index_expr = "idx",
		struct_ty = "Small",
		out = "__lg_out_seed",
	})) == (
		"({ blorp_List* __lg_list_seed = (blorp_List*)xs; long __lg_idx_seed = idx; "
		+ "Small __lg_out_seed;"
	)
	struct_unbox_close_ok: Bool = render_prepared_list_op(
		ListInlineStructUnboxClose("__lg_out_seed"),
	) == "__lg_out_seed; })"

	bits_load_ok: Bool = render_prepared_list_op(InlineBitsLoad({
		list_tmp = "__list",
		index_tmp = "__idx",
		bits_tmp = "__bits",
		width_bytes = "8",
	})) == "uintptr_t __bits = 0; memcpy(&__bits, (char*)__list->data + __idx * 8, 8);"
	bits_store_ok: Bool = render_prepared_list_op(InlineBitsStore({
		list = "xs",
		index = "idx",
		value = "(void*)(long)(42L)",
		temp_seed = "seed",
		width_bytes = "8",
	})) == (
		"({ blorp_List* __list_store_seed = (blorp_List*)xs; long __list_store_idx_seed "
		+ "= idx; uintptr_t __list_store_bits_seed = (uintptr_t)(void*)(long)(42L); "
		+ "memcpy((char*)__list_store_seed->data + __list_store_idx_seed * 8, "
		+ "&__list_store_bits_seed, 8); })"
	)
	pointer_set_raw_store_ok: Bool = render_prepared_list_op(PointerSetRawStore({
		list = "xs",
		index = "idx",
		value = "value",
	})) == "blorp_list_set_raw((blorp_List*)xs, idx, (void*)value)"
	pointer_handoff_store_ok: Bool = render_prepared_list_op(PointerHandoffSetOwnedStore({
		list = "xs",
		index = "idx",
		value = "value",
	})) == "blorp_list_handoff_set_owned((blorp_List*)xs, idx, (void*)value)"
	struct_set_raw_store_ok: Bool = render_prepared_list_op(InlineStructSetRawStore({
		list = "xs",
		index = "idx",
		value = "next",
		boxing = StructAddressBoxing,
		temp_seed = "seed",
		struct_ty = "Small",
	})) == (
		"({ blorp_List* __list_store_seed = (blorp_List*)xs; long __list_store_idx_seed "
		+ "= idx; Small __list_elem_seed = next; if (__list_store_seed && "
		+ "__list_store_seed->storage_mode == BLORP_LIST_STORAGE_INLINE && "
		+ "__list_store_seed->elem_size == (int16_t)sizeof(Small)) { "
		+ "blorp_list_set_raw_copy(__list_store_seed, __list_store_idx_seed, "
		+ "&__list_elem_seed); } else { blorp_list_set_raw((blorp_List*)__list_store_seed, "
		+ "__list_store_idx_seed, (void*)blorp_box_struct(&__list_elem_seed, "
		+ "sizeof(Small))); } })"
	)
	struct_handoff_store_ok: Bool = render_prepared_list_op(InlineStructHandoffSetOwnedStore({
		list = "xs",
		index = "idx",
		value = "next",
		boxing = StackResultBoxing,
		temp_seed = "seed",
		struct_ty = "Small",
	})) == (
		"({ blorp_List* __list_store_seed = (blorp_List*)xs; long __list_store_idx_seed "
		+ "= idx; Small __list_elem_seed = next; if (__list_store_seed && "
		+ "__list_store_seed->storage_mode == BLORP_LIST_STORAGE_INLINE && "
		+ "__list_store_seed->elem_size == (int16_t)sizeof(Small)) { "
		+ "blorp_list_set_raw_copy(__list_store_seed, __list_store_idx_seed, "
		+ "&__list_elem_seed); } else { blorp_list_handoff_set_owned((blorp_List*)__list_st"
		+ "ore_seed, __list_store_idx_seed, (void*)blorp_box_stack_result(__list_elem_seed)"
		+ "); } })"
	)
	pointer_swap_ok: Bool = render_prepared_list_op(PointerSwap({
		list = "xs",
		left_index = "left",
		right_index = "right",
		temp_seed = "seed",
	})) == (
		"({ blorp_List* __list_swap_seed = (blorp_List*)xs; long __list_swap_i_seed = "
		+ "left; long __list_swap_j_seed = right; if (__builtin_expect(__list_swap_seed && "
		+ "__list_swap_i_seed != __list_swap_j_seed, 1)) { void* __list_swap_tmp_seed = "
		+ "blorp_list_get(__list_swap_seed, __list_swap_i_seed); "
		+ "blorp_list_set_raw(__list_swap_seed, __list_swap_i_seed, "
		+ "blorp_list_get(__list_swap_seed, __list_swap_j_seed)); "
		+ "blorp_list_set_raw(__list_swap_seed, __list_swap_j_seed, __list_swap_tmp_seed); "
		+ "} })"
	)
	bits_swap_ok: Bool = render_prepared_list_op(InlineBitsSwap({
		list = "xs",
		left_index = "left",
		right_index = "right",
		temp_seed = "seed",
		width_bytes = "8",
	})) == (
		"({ blorp_List* __list_swap_seed = (blorp_List*)xs; long __list_swap_i_seed = "
		+ "left; long __list_swap_j_seed = right; if (__builtin_expect(__list_swap_seed && "
		+ "__list_swap_i_seed != __list_swap_j_seed, 1)) { char* __list_swap_base_seed = "
		+ "(char*)__list_swap_seed->data; uintptr_t __list_swap_bits_seed = 0; "
		+ "memcpy(&__list_swap_bits_seed, __list_swap_base_seed + __list_swap_i_seed * 8, "
		+ "8); memcpy(__list_swap_base_seed + __list_swap_i_seed * 8, "
		+ "__list_swap_base_seed + __list_swap_j_seed * 8, 8); "
		+ "memcpy(__list_swap_base_seed + __list_swap_j_seed * 8, &__list_swap_bits_seed, "
		+ "8); } })"
	)
	struct_swap_ok: Bool = render_prepared_list_op(InlineStructSwap({
		list = "xs",
		left_index = "left",
		right_index = "right",
		temp_seed = "seed",
	})) == (
		"({ blorp_List* __list_swap_seed = (blorp_List*)xs; long __list_swap_i_seed = "
		+ "left; long __list_swap_j_seed = right; if (__builtin_expect(__list_swap_seed && "
		+ "__list_swap_i_seed != __list_swap_j_seed, 1)) { if (__list_swap_seed-"
		+ ">storage_mode == BLORP_LIST_STORAGE_INLINE) { char* __list_swap_base_seed = "
		+ "(char*)__list_swap_seed->data; size_t __list_swap_size_seed = "
		+ "(size_t)__list_swap_seed->elem_size; void* __list_swap_a_seed = "
		+ "__list_swap_base_seed + __list_swap_i_seed * __list_swap_size_seed; void* "
		+ "__list_swap_b_seed = __list_swap_base_seed + __list_swap_j_seed * "
		+ "__list_swap_size_seed; unsigned char __list_swap_bytes_seed[__list_swap_size_see"
		+ "d]; memcpy(__list_swap_bytes_seed, __list_swap_a_seed, __list_swap_size_seed); "
		+ "memcpy(__list_swap_a_seed, __list_swap_b_seed, __list_swap_size_seed); "
		+ "memcpy(__list_swap_b_seed, __list_swap_bytes_seed, __list_swap_size_seed); } "
		+ "else { void* __list_swap_tmp_seed = blorp_list_get(__list_swap_seed, "
		+ "__list_swap_i_seed); blorp_list_set_raw(__list_swap_seed, __list_swap_i_seed, "
		+ "blorp_list_get(__list_swap_seed, __list_swap_j_seed)); "
		+ "blorp_list_set_raw(__list_swap_seed, __list_swap_j_seed, __list_swap_tmp_seed); "
		+ "} } })"
	)
	handoff_source_slot_ok: Bool = render_prepared_list_op(HandoffSetSourceSlot({
		result = "result",
		out_index = "out_idx",
		source = "source",
		source_index = "source_idx",
	})) == (
		"blorp_list_handoff_set_source_slot((blorp_List*)result, out_idx, "
		+ "(blorp_List*)source, source_idx)"
	)
	copy_span_ok: Bool = render_prepared_list_op(CopySpanUninit({
		dst = "dst",
		dst_start = "dst_start",
		src = "src",
		src_start = "src_start",
		count = "count",
	})) == (
		"blorp_list_copy_span_uninit((blorp_List*)dst, dst_start, (blorp_List*)src, "
		+ "src_start, count)"
	)
	ensure_unique_ok: Bool = render_prepared_list_op(EnsureUnique({
		list = "xs",
		temp_seed = "seed",
	})) == (
		"({ blorp_List* __list_unique_seed = (blorp_List*)xs; "
		+ "(__builtin_expect(__list_unique_seed && blorp_is_unique(__list_unique_seed), 1) "
		+ "? __list_unique_seed : blorp_list_cow(__list_unique_seed)); })"
	)
	ensure_capacity_ok: Bool = render_prepared_list_op(EnsureCapacity({
		list = "xs",
		capacity = "capacity",
		temp_seed = "seed",
	})) == (
		"({ blorp_List* __list_cap_seed = (blorp_List*)xs; long __list_cap_min_seed = "
		+ "capacity; (__builtin_expect(__list_cap_seed && blorp_is_unique(__list_cap_seed) "
		+ "&& __list_cap_seed->capacity >= __list_cap_min_seed, 1) ? __list_cap_seed : "
		+ "blorp_list_ensure_capacity(__list_cap_seed, __list_cap_min_seed)); })"
	)
	reuse_alloc_ok: Bool = render_prepared_list_op(ReuseAlloc({
		list = "xs",
		capacity = "capacity",
	})) == "blorp_list_reuse_alloc(xs, capacity)"
	reuse_alloc_release_ok: Bool = render_prepared_list_op(ReuseAllocWithRelease({
		list = "xs",
		capacity = "capacity",
		temp_seed = "seed",
	})) == (
		"({ blorp_List* __lst_seed = blorp_list_reuse_alloc(xs, capacity); "
		+ "blorp_list_init_elem_release(__lst_seed, blorp_elem_release_fn); __lst_seed; })"
	)
	alloc_pointer_ok: Bool = render_prepared_list_op(
		ListAllocPointer("capacity"),
	) == "blorp_list_new(capacity)"
	alloc_inline_ok: Bool = render_prepared_list_op(ListAllocInline({
		capacity = "capacity",
		elem_size = "8",
	})) == "blorp_list_new_inline(capacity, 8)"
	alloc_inline_struct_ok: Bool = render_prepared_list_op(ListAllocInlineStruct({
		capacity = "capacity",
		struct_ty = "Small",
	})) == "blorp_list_new_inline(capacity, sizeof(Small))"
	alloc_release_ok: Bool = render_prepared_list_op(ListAllocWithRelease({
		alloc_expr = "blorp_list_new(capacity)",
		result_tmp = "__result",
	})) == (
		"({ blorp_List* __result = blorp_list_new(capacity); "
		+ "blorp_list_init_elem_release(__result, blorp_elem_release_fn); __result; })"
	)
	retain_for_ok: Bool = render_prepared_list_op(RetainFor({
		list = "xs",
		value = "value",
	})) == "blorp_list_retain_for((blorp_List*)xs, (void*)value)"
	retain_noop_ok: Bool = render_prepared_list_op(RetainForNoop) == "((void)0)"
	construct_name_ok: Bool = render_prepared_list_op(ListConstructName("seed")) == "__lst_seed"
	construct_ok: Bool = render_prepared_list_op(ListConstruct({
		list = "__lst_seed",
		alloc_expr = "blorp_list_new(2)",
		statements = "__lst_seed = blorp_list_append(__lst_seed, value);",
	})) == (
		"({ blorp_List* __lst_seed = blorp_list_new(2); __lst_seed = "
		+ "blorp_list_append(__lst_seed, value); __lst_seed; })"
	)
	construct_release_ok: Bool = render_prepared_list_op(
		ListConstructInitElemRelease(
			"__lst",
		),
	) == "blorp_list_init_elem_release(__lst, blorp_elem_release_fn);"
	construct_struct_ok: Bool = render_prepared_list_op(ListConstructInlineStructSet({
		list = "__lst",
		index = "2",
		value = "next",
		temp_seed = "seed",
		struct_ty = "Small",
	})) == (
		"{ Small __lst_elem_seed = next; blorp_list_set_raw_copy(__lst, 2, "
		+ "&__lst_elem_seed); }"
	)
	construct_len_ok: Bool = render_prepared_list_op(
		ListConstructSetLen(
			"__lst",
			"3",
		),
	) == "__lst->len = 3;"
	construct_append_ok: Bool = render_prepared_list_op(ListConstructAppend({
		list = "__lst",
		value = "value",
	})) == "__lst = blorp_list_append(__lst, value);"
	construct_append_owned_ok: Bool = render_prepared_list_op(ListConstructAppendOwned({
		list = "__lst",
		value = "value",
	})) == "__lst = blorp_list_append_owned(__lst, value);"
	handoff_capacity_name_ok: Bool = render_prepared_list_op(
		ListHandoffCapacityName("seed"),
	) == "__lh_cap_seed"

	handoff_reuse_name_ok: Bool = render_prepared_list_op(
		ListHandoffReuseName("seed"),
	) == "__lh_reuse_seed"

	handoff_release_name_ok: Bool = render_prepared_list_op(
		ListHandoffReleaseName("seed"),
	) == "__lh_release_seed"

	handoff_borrow_prefix_ok: Bool = render_prepared_list_op(ListHandoffBorrowPrefix({
		source_ty = "blorp_List*",
		source = "source",
		source_expr = "xs",
		capacity_expr = "3L",
		length = "len",
		release_fn = "NULL",
		result_ty = "blorp_List*",
		result = "result",
		storage_mode = "BLORP_LIST_STORAGE_POINTER",
		elem_size = "sizeof(void*)",
		out = "out",
		temp_seed = "seed",
	})) == (
		"({ blorp_List* source = xs; long __lh_cap_seed = 3L; long len = source ? "
		+ "((blorp_List*)source)->len : 0L; void (*__lh_release_seed)(void*) = NULL; "
		+ "blorp_List* result = (blorp_List*)blorp_list_handoff_begin_borrow(__lh_cap_seed,"
		+ " __lh_release_seed, BLORP_LIST_STORAGE_POINTER, sizeof(void*)); long out = 0L;"
	)
	handoff_reuse_prefix_ok: Bool = render_prepared_list_op(ListHandoffReusePrefix({
		source_ty = "blorp_List*",
		source = "source",
		source_expr = "xs",
		capacity_expr = "3L",
		length = "len",
		release_fn = "NULL",
		result_ty = "blorp_List*",
		result = "result",
		storage_mode = "BLORP_LIST_STORAGE_POINTER",
		elem_size = "sizeof(void*)",
		out = "out",
		temp_seed = "seed",
	})) == (
		"({ blorp_List* source = xs; long __lh_cap_seed = 3L; long len = source ? "
		+ "((blorp_List*)source)->len : 0L; void (*__lh_release_seed)(void*) = NULL; bool "
		+ "__lh_reuse_seed = false; blorp_List* result = (blorp_List*)blorp_list_handoff_be"
		+ "gin_reuse((blorp_List*)source, __lh_cap_seed, __lh_release_seed, "
		+ "BLORP_LIST_STORAGE_POINTER, sizeof(void*), &__lh_reuse_seed); long out = 0L;"
	)
	handoff_borrow_suffix_ok: Bool = render_prepared_list_op(ListHandoffBorrowSuffix({
		result = "result",
		out = "out",
		length = "len",
	})) == (
		"blorp_list_handoff_finish((blorp_List*)result, out, len, false, NULL); result; "
		+ "})"
	)
	handoff_reuse_suffix_ok: Bool = render_prepared_list_op(ListHandoffReuseSuffix({
		result = "result",
		out = "out",
		length = "len",
		source = "source",
		temp_seed = "seed",
	})) == (
		"blorp_list_handoff_finish((blorp_List*)result, out, len, __lh_reuse_seed, "
		+ "(blorp_List*)source); result; })"
	)

	(
		pointer_ok
		and checked_ok
		and proven_ok
		and load_checked_ok
		and load_proven_ok
		and bits_load_ok
		and bits_store_ok
		and pointer_set_raw_store_ok
		and pointer_handoff_store_ok
		and struct_set_raw_store_ok
		and struct_handoff_store_ok
		and pointer_swap_ok
		and bits_swap_ok
		and struct_swap_ok
		and handoff_source_slot_ok
		and struct_unbox_list_name_ok
		and struct_unbox_index_name_ok
		and struct_unbox_out_name_ok
		and struct_unbox_open_ok
		and struct_unbox_close_ok
		and copy_span_ok
		and ensure_unique_ok
		and ensure_capacity_ok
		and reuse_alloc_ok
		and reuse_alloc_release_ok
		and alloc_pointer_ok
		and alloc_inline_ok
		and alloc_inline_struct_ok
		and alloc_release_ok
		and retain_for_ok
		and retain_noop_ok
		and construct_name_ok
		and construct_ok
		and construct_release_ok
		and construct_struct_ok
		and construct_len_ok
		and construct_append_ok
		and construct_append_owned_ok
		and handoff_capacity_name_ok
		and handoff_reuse_name_ok
		and handoff_release_name_ok
		and handoff_borrow_prefix_ok
		and handoff_reuse_prefix_ok
		and handoff_borrow_suffix_ok
		and handoff_reuse_suffix_ok
	)


func test_render_prepared_list_successes() -> Bool:
	pointer_ok: Bool = match render_prepared_list(
		"list_get_pointer",
		["xs", "i"],
	):
		Ok(rendered):
			rendered == "blorp_list_get((blorp_List*)xs, i)"
		Err(error):
			False

	inline_ok: Bool = match render_prepared_list(
		"list_get_inline_proven",
		["xs", "i", "0", "8"],
	):
		Ok(rendered):
			rendered == (
				"({ blorp_List* __lg_list_0 = (blorp_List*)xs; long __lg_idx_0 = i; ({ uintptr_t "
				+ "__lg_bits_0 = 0; memcpy(&__lg_bits_0, (char*)__lg_list_0->data + __lg_idx_0 * 8,"
				+ " 8); (void*)__lg_bits_0; }); })"
			)
		Err(error):
			False

	load_ok: Bool = match render_prepared_list(
		"list_inline_struct_load_proven",
		["__list", "__idx", "__out", "0", "Small"],
	):
		Ok(rendered):
			rendered == (
				"if (__list->storage_mode == BLORP_LIST_STORAGE_INLINE && __list->elem_size == "
				+ "(int16_t)sizeof(Small)) { memcpy(&__out, (char*)__list->data + __idx * "
				+ "sizeof(Small), sizeof(Small)); } else { void* __lg_raw_0 = "
				+ "blorp_list_get(__list, __idx); if (!__lg_raw_0) { memset(&__out, 0, "
				+ "sizeof(Small)); } else { __out = blorp_unbox_struct(__lg_raw_0, Small); } }"
			)
		Err(error):
			False

	checked_load_ok: Bool = match render_prepared_list(
		"list_inline_struct_load_checked",
		["__list", "__idx", "__out", "0", "Small"],
	):
		Ok(rendered):
			rendered == (
				"if (__builtin_expect(!__list || __idx < 0 || __idx >= __list->len, 0)) { "
				+ "memset(&__out, 0, sizeof(Small)); } else if (__list->storage_mode == "
				+ "BLORP_LIST_STORAGE_INLINE && __list->elem_size == (int16_t)sizeof(Small)) { "
				+ "memcpy(&__out, (char*)__list->data + __idx * sizeof(Small), sizeof(Small)); } "
				+ "else { void* __lg_raw_0 = blorp_list_get(__list, __idx); if (!__lg_raw_0) { "
				+ "memset(&__out, 0, sizeof(Small)); } else { __out = "
				+ "blorp_unbox_struct(__lg_raw_0, Small); } }"
			)
		Err(error):
			False

	bits_load_ok: Bool = match render_prepared_list(
		"list_inline_bits_load",
		["((blorp_List*)lst)", "__tailrec_i", "__tailrec_bits_0", "8"],
	):
		Ok(rendered):
			rendered == (
				"uintptr_t __tailrec_bits_0 = 0; memcpy(&__tailrec_bits_0, "
				+ "(char*)((blorp_List*)lst)->data + __tailrec_i * 8, 8);"
			)
		Err(error):
			False

	bits_store_ok: Bool = match render_prepared_list(
		"list_inline_bits_store",
		["xs", "idx", "(void*)(long)(42L)", "0", "8"],
	):
		Ok(rendered):
			rendered == (
				"({ blorp_List* __list_store_0 = (blorp_List*)xs; long __list_store_idx_0 = idx; "
				+ "uintptr_t __list_store_bits_0 = (uintptr_t)(void*)(long)(42L); "
				+ "memcpy((char*)__list_store_0->data + __list_store_idx_0 * 8, "
				+ "&__list_store_bits_0, 8); })"
			)
		Err(error):
			False

	struct_store_ok: Bool = match render_prepared_list(
		"list_inline_struct_set_raw_store",
		["xs", "idx", "next", "0", "Small"],
	):
		Ok(rendered):
			rendered == (
				"({ blorp_List* __list_store_0 = (blorp_List*)xs; long __list_store_idx_0 = idx; "
				+ "Small __list_elem_0 = next; if (__list_store_0 && __list_store_0->storage_mode "
				+ "== BLORP_LIST_STORAGE_INLINE && __list_store_0->elem_size == "
				+ "(int16_t)sizeof(Small)) { blorp_list_set_raw_copy(__list_store_0, "
				+ "__list_store_idx_0, &__list_elem_0); } else { blorp_list_set_raw((blorp_List*)__"
				+ "list_store_0, __list_store_idx_0, (void*)blorp_box_struct(&__list_elem_0, "
				+ "sizeof(Small))); } })"
			)
		Err(error):
			False

	struct_stack_store_ok: Bool = match render_prepared_list(
		"list_inline_struct_set_raw_store_stack_result",
		["xs", "idx", "next", "0", "Small"],
	):
		Ok(rendered):
			rendered == (
				"({ blorp_List* __list_store_0 = (blorp_List*)xs; long __list_store_idx_0 = idx; "
				+ "Small __list_elem_0 = next; if (__list_store_0 && __list_store_0->storage_mode "
				+ "== BLORP_LIST_STORAGE_INLINE && __list_store_0->elem_size == "
				+ "(int16_t)sizeof(Small)) { blorp_list_set_raw_copy(__list_store_0, "
				+ "__list_store_idx_0, &__list_elem_0); } else { blorp_list_set_raw((blorp_List*)__"
				+ "list_store_0, __list_store_idx_0, (void*)blorp_box_stack_result(__list_elem_0));"
				+ " } })"
			)
		Err(error):
			False

	alloc_inline_ok: Bool = match render_prepared_list(
		"list_alloc_inline",
		["capacity", "sizeof(Small)"],
	):
		Ok(rendered):
			rendered == "blorp_list_new_inline(capacity, sizeof(Small))"
		Err(error):
			False

	alloc_inline_struct_ok: Bool = match render_prepared_list(
		"list_alloc_inline_struct",
		["capacity", "Small"],
	):
		Ok(rendered):
			rendered == "blorp_list_new_inline(capacity, sizeof(Small))"
		Err(error):
			False

	alloc_release_ok: Bool = match render_prepared_list(
		"list_alloc_with_release",
		["blorp_list_new(capacity)", "__result"],
	):
		Ok(rendered):
			rendered == (
				"({ blorp_List* __result = blorp_list_new(capacity); "
				+ "blorp_list_init_elem_release(__result, blorp_elem_release_fn); __result; })"
			)
		Err(error):
			False

	construct_name_ok: Bool = match render_prepared_list("list_construct_name", ["0"]):
		Ok(rendered):
			rendered == "__lst_0"
		Err(error):
			False

	construct_ok: Bool = match render_prepared_list(
		"list_construct",
		["__lst_0", "blorp_list_new(2)", "__lst_0 = blorp_list_append(__lst_0, value);"],
	):
		Ok(rendered):
			rendered == (
				"({ blorp_List* __lst_0 = blorp_list_new(2); __lst_0 = blorp_list_append(__lst_0,"
				+ " value); __lst_0; })"
			)
		Err(error):
			False

	construct_append_ok: Bool = match render_prepared_list(
		"list_construct_append_owned",
		["__lst", "value"],
	):
		Ok(rendered):
			rendered == "__lst = blorp_list_append_owned(__lst, value);"
		Err(error):
			False

	construct_struct_ok: Bool = match render_prepared_list(
		"list_construct_inline_struct_set",
		["__lst", "2", "next", "0", "Small"],
	):
		Ok(rendered):
			rendered == "{ Small __lst_elem_0 = next; blorp_list_set_raw_copy(__lst, 2, &__lst_elem_0); }"
		Err(error):
			False

	storage_mode_pointer_ok: Bool = match render_prepared_list("list_storage_mode_pointer", []):
		Ok(rendered):
			rendered == "BLORP_LIST_STORAGE_POINTER"
		Err(error):
			False

	storage_mode_inline_ok: Bool = match render_prepared_list("list_storage_mode_inline", []):
		Ok(rendered):
			rendered == "BLORP_LIST_STORAGE_INLINE"
		Err(error):
			False

	element_size_pointer_ok: Bool = match render_prepared_list("list_element_size_pointer", []):
		Ok(rendered):
			rendered == "sizeof(void*)"
		Err(error):
			False

	element_size_inline_struct_ok: Bool = match render_prepared_list(
		"list_element_size_inline_struct",
		["Small"],
	):
		Ok(rendered):
			rendered == "sizeof(Small)"
		Err(error):
			False

	element_release_fn_ok: Bool = match render_prepared_list("list_element_release_fn", []):
		Ok(rendered):
			rendered == "blorp_elem_release_fn"
		Err(error):
			False

	element_release_none_ok: Bool = match render_prepared_list("list_element_release_none", []):
		Ok(rendered):
			rendered == "NULL"
		Err(error):
			False

	all_ok: Bool = (
		pointer_ok
		and inline_ok
		and load_ok
		and checked_load_ok
		and bits_load_ok
		and bits_store_ok
		and struct_store_ok
		and struct_stack_store_ok
		and alloc_inline_ok
		and alloc_inline_struct_ok
		and alloc_release_ok
		and construct_name_ok
		and construct_ok
		and construct_append_ok
		and construct_struct_ok
		and storage_mode_pointer_ok
		and storage_mode_inline_ok
		and element_size_pointer_ok
		and element_size_inline_struct_ok
		and element_release_fn_ok
		and element_release_none_ok
	)

	all_ok


func test_render_prepared_list_swap_success() -> Bool:
	match render_prepared_list(
		"list_pointer_swap",
		["xs", "left", "right", "0"],
	):
		Ok(rendered):
			rendered == (
				"({ blorp_List* __list_swap_0 = (blorp_List*)xs; long __list_swap_i_0 = left; "
				+ "long __list_swap_j_0 = right; if (__builtin_expect(__list_swap_0 && "
				+ "__list_swap_i_0 != __list_swap_j_0, 1)) { void* __list_swap_tmp_0 = "
				+ "blorp_list_get(__list_swap_0, __list_swap_i_0); blorp_list_set_raw(__list_swap_0"
				+ ", __list_swap_i_0, blorp_list_get(__list_swap_0, __list_swap_j_0)); "
				+ "blorp_list_set_raw(__list_swap_0, __list_swap_j_0, __list_swap_tmp_0); } })"
			)
		Err(error):
			False


func test_render_prepared_list_errors_are_typed() -> Bool:
	wrong_arity_ok: Bool = match render_prepared_list("list_get_pointer", ["xs"]):
		Ok(rendered):
			False
		Err(error):
			match error:
				WrongArity(info, got):
					(
						prepared_list_template_name(info) == "list_get_pointer"
						and prepared_list_template_arity(info) == 2
						and got == 1
					)
				UnsupportedPreparedListOp(name):
					False

