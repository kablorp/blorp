import:
	../codegen_prepared_list_renderer:
		ALL_TEMPLATES,
		CompilerCommand(RenderManifestCommand, RenderPreparedListCommand, UnknownCommand),
		PreparedListOp(
			CopySpanUninit,
			EnsureCapacity,
			EnsureUnique,
			HandoffSetSourceSlot,
			InlineCheckedGet,
			InlineBitsLoad,
			InlineBitsSwap,
			InlineBitsStore,
			InlineProvenGet,
			InlineStructHandoffSetOwnedStore,
			InlineStructSwap,
			InlineStructLoadChecked,
			InlineStructLoadProven,
			InlineStructSetRawStore,
			ListAllocInline,
			ListAllocPointer,
			ListAllocWithRelease,
			ListConstructAppend,
			ListConstructAppendOwned,
			ListConstructInitElemRelease,
			ListConstructInlineStructSet,
			ListConstructSetLen,
			PointerHandoffSetOwnedStore,
			PointerSwap,
			PointerGet,
			PointerSetRawStore,
			RetainFor,
			RetainForNoop,
			ReuseAlloc,
			ReuseAllocWithRelease,
		),
		RenderError(UnsupportedPreparedListOp, WrongArity),
		parse_command,
		parse_prepared_list_template,
		prepared_list_template_arity,
		prepared_list_template_name,
		render_error_to_string,
		render_manifest_line,
		render_manifest_lines,
		render_prepared_list,
		render_prepared_list_op,
	test: TestSuite


func parsed_template_has(name: String, expected_name: String, expected_arity: Int) -> Bool:
	match parse_prepared_list_template(name):
		Some(info):
			(
				prepared_list_template_name(info) == expected_name
				and prepared_list_template_arity(info) == expected_arity
			)
		None: False


func manifest_line_is(name: String, expected: String) -> Bool:
	match parse_prepared_list_template(name):
		Some(info): render_manifest_line(info) == expected
		None: False


func test_parse_command_routes() -> Bool:
	render_command: CompilerCommand = parse_command("prepared-list")
	manifest_command: CompilerCommand = parse_command("manifest")
	unknown_command: CompilerCommand = parse_command("wat")

	render_ok: Bool = match render_command:
		RenderPreparedListCommand: True
		RenderManifestCommand: False
		UnknownCommand: False

	manifest_ok: Bool = match manifest_command:
		RenderPreparedListCommand: False
		RenderManifestCommand: True
		UnknownCommand: False

	unknown_ok: Bool = match unknown_command:
		RenderPreparedListCommand: False
		RenderManifestCommand: False
		UnknownCommand: True

	render_ok and manifest_ok and unknown_ok


func test_parse_template_shapes() -> Bool:
	pointer_ok: Bool = parsed_template_has("list_get_pointer", "list_get_pointer", 2)
	inline_checked_ok: Bool = parsed_template_has(
		"list_get_inline_checked",
		"list_get_inline_checked",
		4,
	)
	inline_proven_ok: Bool = parsed_template_has(
		"list_get_inline_proven",
		"list_get_inline_proven",
		4,
	)
	bits_load_ok: Bool = parsed_template_has("list_inline_bits_load", "list_inline_bits_load", 4)
	bits_store_ok: Bool = parsed_template_has("list_inline_bits_store", "list_inline_bits_store", 5)
	pointer_set_raw_store_ok: Bool = parsed_template_has(
		"list_pointer_set_raw_store",
		"list_pointer_set_raw_store",
		3,
	)
	pointer_handoff_store_ok: Bool = parsed_template_has(
		"list_pointer_handoff_set_owned_store",
		"list_pointer_handoff_set_owned_store",
		3,
	)
	struct_set_raw_store_ok: Bool = parsed_template_has(
		"list_inline_struct_set_raw_store",
		"list_inline_struct_set_raw_store",
		8,
	)
	struct_handoff_store_ok: Bool = parsed_template_has(
		"list_inline_struct_handoff_set_owned_store",
		"list_inline_struct_handoff_set_owned_store",
		8,
	)
	pointer_swap_ok: Bool = parsed_template_has("list_pointer_swap", "list_pointer_swap", 7)
	bits_swap_ok: Bool = parsed_template_has("list_inline_bits_swap", "list_inline_bits_swap", 9)
	struct_swap_ok: Bool = parsed_template_has(
		"list_inline_struct_swap",
		"list_inline_struct_swap",
		12,
	)
	struct_load_checked_ok: Bool = parsed_template_has(
		"list_inline_struct_load_checked",
		"list_inline_struct_load_checked",
		5,
	)
	struct_load_proven_ok: Bool = parsed_template_has(
		"list_inline_struct_load_proven",
		"list_inline_struct_load_proven",
		5,
	)
	handoff_source_slot_ok: Bool = parsed_template_has(
		"list_handoff_set_source_slot",
		"list_handoff_set_source_slot",
		4,
	)
	copy_span_ok: Bool = parsed_template_has("list_copy_span_uninit", "list_copy_span_uninit", 5)
	ensure_unique_ok: Bool = parsed_template_has("list_ensure_unique", "list_ensure_unique", 2)
	ensure_capacity_ok: Bool = parsed_template_has(
		"list_ensure_capacity",
		"list_ensure_capacity",
		3,
	)
	reuse_alloc_ok: Bool = parsed_template_has("list_reuse_alloc", "list_reuse_alloc", 2)
	reuse_alloc_release_ok: Bool = parsed_template_has(
		"list_reuse_alloc_with_release",
		"list_reuse_alloc_with_release",
		3,
	)
	alloc_pointer_ok: Bool = parsed_template_has("list_alloc_pointer", "list_alloc_pointer", 1)
	alloc_inline_ok: Bool = parsed_template_has("list_alloc_inline", "list_alloc_inline", 2)
	alloc_release_ok: Bool = parsed_template_has(
		"list_alloc_with_release",
		"list_alloc_with_release",
		2,
	)
	retain_for_ok: Bool = parsed_template_has("list_retain_for", "list_retain_for", 2)
	retain_noop_ok: Bool = parsed_template_has("list_retain_for_noop", "list_retain_for_noop", 0)
	construct_release_ok: Bool = parsed_template_has(
		"list_construct_init_elem_release",
		"list_construct_init_elem_release",
		1,
	)
	construct_struct_ok: Bool = parsed_template_has(
		"list_construct_inline_struct_set",
		"list_construct_inline_struct_set",
		5,
	)
	construct_len_ok: Bool = parsed_template_has(
		"list_construct_set_len",
		"list_construct_set_len",
		2,
	)
	construct_append_ok: Bool = parsed_template_has(
		"list_construct_append",
		"list_construct_append",
		2,
	)
	construct_append_owned_ok: Bool = parsed_template_has(
		"list_construct_append_owned",
		"list_construct_append_owned",
		2,
	)

	missing_ok: Bool = match parse_prepared_list_template("list_len"):
		Some(template): False
		None: True

	all_ok: Bool = (
		pointer_ok
		and inline_checked_ok
		and inline_proven_ok
		and bits_load_ok
		and bits_store_ok
		and pointer_set_raw_store_ok
		and pointer_handoff_store_ok
		and struct_set_raw_store_ok
		and struct_handoff_store_ok
		and pointer_swap_ok
		and bits_swap_ok
		and struct_swap_ok
		and struct_load_checked_ok
		and struct_load_proven_ok
		and handoff_source_slot_ok
		and copy_span_ok
		and ensure_unique_ok
		and ensure_capacity_ok
		and reuse_alloc_ok
		and reuse_alloc_release_ok
		and alloc_pointer_ok
		and alloc_inline_ok
		and alloc_release_ok
		and retain_for_ok
		and retain_noop_ok
		and construct_release_ok
		and construct_struct_ok
		and construct_len_ok
		and construct_append_ok
		and construct_append_owned_ok
		and missing_ok
	)

	all_ok


func test_render_prepared_list_op_successes() -> Bool:
	pointer_ok: Bool = render_prepared_list_op(
		PointerGet(
			"xs",
			"idx",
		),
	) == "blorp_list_get((blorp_List*)xs, idx)"
	checked_ok: Bool = render_prepared_list_op(InlineCheckedGet({
		list = "xs",
		index = "idx",
		temp_seed = "seed",
		width_bytes = "8",
	})) == (
		"({ blorp_List* __lg_list_seed = (blorp_List*)xs; long __lg_idx_seed = idx; "
		+ "(__builtin_expect(!__lg_list_seed || __lg_idx_seed < 0 || __lg_idx_seed >= "
		+ "__lg_list_seed->len, 0) ? NULL : ({ uintptr_t __lg_bits_seed = 0; "
		+ "memcpy(&__lg_bits_seed, (char*)__lg_list_seed->data + __lg_idx_seed * 8, 8); "
		+ "(void*)__lg_bits_seed; })); })"
	)
	proven_ok: Bool = render_prepared_list_op(InlineProvenGet({
		list = "xs",
		index = "idx",
		temp_seed = "seed",
		width_bytes = "4",
	})) == (
		"({ blorp_List* __lg_list_seed = (blorp_List*)xs; long __lg_idx_seed = idx; ({ "
		+ "uintptr_t __lg_bits_seed = 0; memcpy(&__lg_bits_seed, (char*)__lg_list_seed-"
		+ ">data + __lg_idx_seed * 4, 4); (void*)__lg_bits_seed; }); })"
	)
	load_checked_ok: Bool = render_prepared_list_op(InlineStructLoadChecked({
		list_tmp = "__list",
		index_tmp = "__idx",
		out_tmp = "__out",
		raw_tmp = "__raw",
		struct_ty = "Small",
	})) == (
		"if (__builtin_expect(!__list || __idx < 0 || __idx >= __list->len, 0)) { "
		+ "memset(&__out, 0, sizeof(Small)); } else if (__list->storage_mode == "
		+ "BLORP_LIST_STORAGE_INLINE && __list->elem_size == (int16_t)sizeof(Small)) { "
		+ "memcpy(&__out, (char*)__list->data + __idx * sizeof(Small), sizeof(Small)); } "
		+ "else { void* __raw = blorp_list_get(__list, __idx); if (!__raw) { memset(&__out,"
		+ " 0, sizeof(Small)); } else { __out = blorp_unbox_struct(__raw, Small); } }"
	)
	load_proven_ok: Bool = render_prepared_list_op(InlineStructLoadProven({
		list_tmp = "__list",
		index_tmp = "__idx",
		out_tmp = "__out",
		raw_tmp = "__raw",
		struct_ty = "Small",
	})) == (
		"if (__list->storage_mode == BLORP_LIST_STORAGE_INLINE && __list->elem_size == "
		+ "(int16_t)sizeof(Small)) { memcpy(&__out, (char*)__list->data + __idx * "
		+ "sizeof(Small), sizeof(Small)); } else { void* __raw = blorp_list_get(__list, "
		+ "__idx); if (!__raw) { memset(&__out, 0, sizeof(Small)); } else { __out = "
		+ "blorp_unbox_struct(__raw, Small); } }"
	)
	bits_load_ok: Bool = render_prepared_list_op(InlineBitsLoad({
		list_tmp = "__list",
		index_tmp = "__idx",
		bits_tmp = "__bits",
		width_bytes = "8",
	})) == "uintptr_t __bits = 0; memcpy(&__bits, (char*)__list->data + __idx * 8, 8);"
	bits_store_ok: Bool = render_prepared_list_op(InlineBitsStore({
		list = "xs",
		index = "idx",
		value = "(void*)(long)(42L)",
		temp_seed = "seed",
		width_bytes = "8",
	})) == (
		"({ blorp_List* __list_store_seed = (blorp_List*)xs; long __list_store_idx_seed "
		+ "= idx; uintptr_t __list_store_bits_seed = (uintptr_t)(void*)(long)(42L); "
		+ "memcpy((char*)__list_store_seed->data + __list_store_idx_seed * 8, "
		+ "&__list_store_bits_seed, 8); })"
	)
	pointer_set_raw_store_ok: Bool = render_prepared_list_op(PointerSetRawStore({
		list = "xs",
		index = "idx",
		value = "value",
	})) == "blorp_list_set_raw((blorp_List*)xs, idx, (void*)value)"
	pointer_handoff_store_ok: Bool = render_prepared_list_op(PointerHandoffSetOwnedStore({
		list = "xs",
		index = "idx",
		value = "value",
	})) == "blorp_list_handoff_set_owned((blorp_List*)xs, idx, (void*)value)"
	struct_set_raw_store_ok: Bool = render_prepared_list_op(InlineStructSetRawStore({
		list = "xs",
		index = "idx",
		value = "next",
		boxed_value = "blorp_box_struct(&__elem, sizeof(Small))",
		list_tmp = "__list",
		index_tmp = "__idx",
		elem_tmp = "__elem",
		struct_ty = "Small",
	})) == (
		"({ blorp_List* __list = (blorp_List*)xs; long __idx = idx; Small __elem = next; "
		+ "if (__list && __list->storage_mode == BLORP_LIST_STORAGE_INLINE && __list-"
		+ ">elem_size == (int16_t)sizeof(Small)) { blorp_list_set_raw_copy(__list, __idx, "
		+ "&__elem); } else { blorp_list_set_raw((blorp_List*)__list, __idx, "
		+ "(void*)blorp_box_struct(&__elem, sizeof(Small))); } })"
	)
	struct_handoff_store_ok: Bool = render_prepared_list_op(InlineStructHandoffSetOwnedStore({
		list = "xs",
		index = "idx",
		value = "next",
		boxed_value = "blorp_box_struct(&__elem, sizeof(Small))",
		list_tmp = "__list",
		index_tmp = "__idx",
		elem_tmp = "__elem",
		struct_ty = "Small",
	})) == (
		"({ blorp_List* __list = (blorp_List*)xs; long __idx = idx; Small __elem = next; "
		+ "if (__list && __list->storage_mode == BLORP_LIST_STORAGE_INLINE && __list-"
		+ ">elem_size == (int16_t)sizeof(Small)) { blorp_list_set_raw_copy(__list, __idx, "
		+ "&__elem); } else { blorp_list_handoff_set_owned((blorp_List*)__list, __idx, "
		+ "(void*)blorp_box_struct(&__elem, sizeof(Small))); } })"
	)
	pointer_swap_ok: Bool = render_prepared_list_op(PointerSwap({
		list = "xs",
		left_index = "left",
		right_index = "right",
		list_tmp = "__list",
		left_index_tmp = "__left",
		right_index_tmp = "__right",
		value_tmp = "__value",
	})) == (
		"({ blorp_List* __list = (blorp_List*)xs; long __left = left; long __right = "
		+ "right; if (__builtin_expect(__list && __left != __right, 1)) { void* __value = "
		+ "blorp_list_get(__list, __left); blorp_list_set_raw(__list, __left, "
		+ "blorp_list_get(__list, __right)); blorp_list_set_raw(__list, __right, __value); "
		+ "} })"
	)
	bits_swap_ok: Bool = render_prepared_list_op(InlineBitsSwap({
		list = "xs",
		left_index = "left",
		right_index = "right",
		list_tmp = "__list",
		left_index_tmp = "__left",
		right_index_tmp = "__right",
		base_tmp = "__base",
		bits_tmp = "__bits",
		width_bytes = "8",
	})) == (
		"({ blorp_List* __list = (blorp_List*)xs; long __left = left; long __right = "
		+ "right; if (__builtin_expect(__list && __left != __right, 1)) { char* __base = "
		+ "(char*)__list->data; uintptr_t __bits = 0; memcpy(&__bits, __base + __left * 8, "
		+ "8); memcpy(__base + __left * 8, __base + __right * 8, 8); memcpy(__base + "
		+ "__right * 8, &__bits, 8); } })"
	)
	struct_swap_ok: Bool = render_prepared_list_op(InlineStructSwap({
		list = "xs",
		left_index = "left",
		right_index = "right",
		list_tmp = "__list",
		left_index_tmp = "__left",
		right_index_tmp = "__right",
		base_tmp = "__base",
		size_tmp = "__size",
		left_slot_tmp = "__left_slot",
		right_slot_tmp = "__right_slot",
		bytes_tmp = "__bytes",
		value_tmp = "__value",
	})) == (
		"({ blorp_List* __list = (blorp_List*)xs; long __left = left; long __right = "
		+ "right; if (__builtin_expect(__list && __left != __right, 1)) { if (__list-"
		+ ">storage_mode == BLORP_LIST_STORAGE_INLINE) { char* __base = (char*)__list-"
		+ ">data; size_t __size = (size_t)__list->elem_size; void* __left_slot = __base + "
		+ "__left * __size; void* __right_slot = __base + __right * __size; unsigned char "
		+ "__bytes[__size]; memcpy(__bytes, __left_slot, __size); memcpy(__left_slot, "
		+ "__right_slot, __size); memcpy(__right_slot, __bytes, __size); } else { void* "
		+ "__value = blorp_list_get(__list, __left); blorp_list_set_raw(__list, __left, "
		+ "blorp_list_get(__list, __right)); blorp_list_set_raw(__list, __right, __value); "
		+ "} } })"
	)
	handoff_source_slot_ok: Bool = render_prepared_list_op(HandoffSetSourceSlot({
		result = "result",
		out_index = "out_idx",
		source = "source",
		source_index = "source_idx",
	})) == (
		"blorp_list_handoff_set_source_slot((blorp_List*)result, out_idx, "
		+ "(blorp_List*)source, source_idx)"
	)
	copy_span_ok: Bool = render_prepared_list_op(CopySpanUninit({
		dst = "dst",
		dst_start = "dst_start",
		src = "src",
		src_start = "src_start",
		count = "count",
	})) == (
		"blorp_list_copy_span_uninit((blorp_List*)dst, dst_start, (blorp_List*)src, "
		+ "src_start, count)"
	)
	ensure_unique_ok: Bool = render_prepared_list_op(EnsureUnique({
		list = "xs",
		temp_seed = "seed",
	})) == (
		"({ blorp_List* __list_unique_seed = (blorp_List*)xs; "
		+ "(__builtin_expect(__list_unique_seed && blorp_is_unique(__list_unique_seed), 1) "
		+ "? __list_unique_seed : blorp_list_cow(__list_unique_seed)); })"
	)
	ensure_capacity_ok: Bool = render_prepared_list_op(EnsureCapacity({
		list = "xs",
		capacity = "capacity",
		temp_seed = "seed",
	})) == (
		"({ blorp_List* __list_cap_seed = (blorp_List*)xs; long __list_cap_min_seed = "
		+ "capacity; (__builtin_expect(__list_cap_seed && blorp_is_unique(__list_cap_seed) "
		+ "&& __list_cap_seed->capacity >= __list_cap_min_seed, 1) ? __list_cap_seed : "
		+ "blorp_list_ensure_capacity(__list_cap_seed, __list_cap_min_seed)); })"
	)
	reuse_alloc_ok: Bool = render_prepared_list_op(ReuseAlloc({
		list = "xs",
		capacity = "capacity",
	})) == "blorp_list_reuse_alloc(xs, capacity)"
	reuse_alloc_release_ok: Bool = render_prepared_list_op(ReuseAllocWithRelease({
		list = "xs",
		capacity = "capacity",
		temp_seed = "seed",
	})) == (
		"({ blorp_List* __lst_seed = blorp_list_reuse_alloc(xs, capacity); "
		+ "blorp_list_init_elem_release(__lst_seed, blorp_elem_release_fn); __lst_seed; })"
	)
	alloc_pointer_ok: Bool = render_prepared_list_op(
		ListAllocPointer("capacity"),
	) == "blorp_list_new(capacity)"
	alloc_inline_ok: Bool = render_prepared_list_op(ListAllocInline({
		capacity = "capacity",
		elem_size = "8",
	})) == "blorp_list_new_inline(capacity, 8)"
	alloc_release_ok: Bool = render_prepared_list_op(ListAllocWithRelease({
		alloc_expr = "blorp_list_new(capacity)",
		result_tmp = "__result",
	})) == (
		"({ blorp_List* __result = blorp_list_new(capacity); "
		+ "blorp_list_init_elem_release(__result, blorp_elem_release_fn); __result; })"
	)
	retain_for_ok: Bool = render_prepared_list_op(RetainFor({
		list = "xs",
		value = "value",
	})) == "blorp_list_retain_for((blorp_List*)xs, (void*)value)"
	retain_noop_ok: Bool = render_prepared_list_op(RetainForNoop) == "((void)0)"
	construct_release_ok: Bool = render_prepared_list_op(
		ListConstructInitElemRelease(
			"__lst",
		),
	) == "blorp_list_init_elem_release(__lst, blorp_elem_release_fn);"
	construct_struct_ok: Bool = render_prepared_list_op(ListConstructInlineStructSet({
		list = "__lst",
		index = "2",
		value = "next",
		elem_tmp = "__elem",
		struct_ty = "Small",
	})) == "{ Small __elem = next; blorp_list_set_raw_copy(__lst, 2, &__elem); }"
	construct_len_ok: Bool = render_prepared_list_op(
		ListConstructSetLen(
			"__lst",
			"3",
		),
	) == "__lst->len = 3;"
	construct_append_ok: Bool = render_prepared_list_op(ListConstructAppend({
		list = "__lst",
		value = "value",
	})) == "__lst = blorp_list_append(__lst, value);"
	construct_append_owned_ok: Bool = render_prepared_list_op(ListConstructAppendOwned({
		list = "__lst",
		value = "value",
	})) == "__lst = blorp_list_append_owned(__lst, value);"

	(
		pointer_ok
		and checked_ok
		and proven_ok
		and load_checked_ok
		and load_proven_ok
		and bits_load_ok
		and bits_store_ok
		and pointer_set_raw_store_ok
		and pointer_handoff_store_ok
		and struct_set_raw_store_ok
		and struct_handoff_store_ok
		and pointer_swap_ok
		and bits_swap_ok
		and struct_swap_ok
		and handoff_source_slot_ok
		and copy_span_ok
		and ensure_unique_ok
		and ensure_capacity_ok
		and reuse_alloc_ok
		and reuse_alloc_release_ok
		and alloc_pointer_ok
		and alloc_inline_ok
		and alloc_release_ok
		and retain_for_ok
		and retain_noop_ok
		and construct_release_ok
		and construct_struct_ok
		and construct_len_ok
		and construct_append_ok
		and construct_append_owned_ok
	)


func test_render_prepared_list_successes() -> Bool:
	pointer_ok: Bool = match render_prepared_list(
		"list_get_pointer",
		["xs", "i"],
	):
		Ok(rendered): rendered == "blorp_list_get((blorp_List*)xs, i)"
		Err(error): False

	inline_ok: Bool = match render_prepared_list(
		"list_get_inline_proven",
		["xs", "i", "0", "8"],
	):
		Ok(rendered):
			rendered == (
				"({ blorp_List* __lg_list_0 = (blorp_List*)xs; long __lg_idx_0 = i; ({ uintptr_t "
				+ "__lg_bits_0 = 0; memcpy(&__lg_bits_0, (char*)__lg_list_0->data + __lg_idx_0 * 8,"
				+ " 8); (void*)__lg_bits_0; }); })"
			)
		Err(error): False

	load_ok: Bool = match render_prepared_list(
		"list_inline_struct_load_proven",
		["__list", "__idx", "__out", "__raw", "Small"],
	):
		Ok(rendered):
			rendered == (
				"if (__list->storage_mode == BLORP_LIST_STORAGE_INLINE && __list->elem_size == "
				+ "(int16_t)sizeof(Small)) { memcpy(&__out, (char*)__list->data + __idx * "
				+ "sizeof(Small), sizeof(Small)); } else { void* __raw = blorp_list_get(__list, "
				+ "__idx); if (!__raw) { memset(&__out, 0, sizeof(Small)); } else { __out = "
				+ "blorp_unbox_struct(__raw, Small); } }"
			)
		Err(error): False

	bits_load_ok: Bool = match render_prepared_list(
		"list_inline_bits_load",
		["((blorp_List*)lst)", "__tailrec_i", "__tailrec_bits_0", "8"],
	):
		Ok(rendered):
			rendered == (
				"uintptr_t __tailrec_bits_0 = 0; memcpy(&__tailrec_bits_0, "
				+ "(char*)((blorp_List*)lst)->data + __tailrec_i * 8, 8);"
			)
		Err(error): False

	bits_store_ok: Bool = match render_prepared_list(
		"list_inline_bits_store",
		["xs", "idx", "(void*)(long)(42L)", "0", "8"],
	):
		Ok(rendered):
			rendered == (
				"({ blorp_List* __list_store_0 = (blorp_List*)xs; long __list_store_idx_0 = idx; "
				+ "uintptr_t __list_store_bits_0 = (uintptr_t)(void*)(long)(42L); "
				+ "memcpy((char*)__list_store_0->data + __list_store_idx_0 * 8, "
				+ "&__list_store_bits_0, 8); })"
			)
		Err(error): False

	struct_store_ok: Bool = match render_prepared_list(
		"list_inline_struct_set_raw_store",
		[
			"xs",
			"idx",
			"next",
			"blorp_box_struct(&__elem, sizeof(Small))",
			"__list",
			"__idx",
			"__elem",
			"Small",
		],
	):
		Ok(rendered):
			rendered == (
				"({ blorp_List* __list = (blorp_List*)xs; long __idx = idx; Small __elem = next; "
				+ "if (__list && __list->storage_mode == BLORP_LIST_STORAGE_INLINE && __list-"
				+ ">elem_size == (int16_t)sizeof(Small)) { blorp_list_set_raw_copy(__list, __idx, "
				+ "&__elem); } else { blorp_list_set_raw((blorp_List*)__list, __idx, "
				+ "(void*)blorp_box_struct(&__elem, sizeof(Small))); } })"
			)
		Err(error): False

	alloc_inline_ok: Bool = match render_prepared_list(
		"list_alloc_inline",
		["capacity", "sizeof(Small)"],
	):
		Ok(rendered): rendered == "blorp_list_new_inline(capacity, sizeof(Small))"
		Err(error): False

	alloc_release_ok: Bool = match render_prepared_list(
		"list_alloc_with_release",
		["blorp_list_new(capacity)", "__result"],
	):
		Ok(rendered):
			rendered == (
				"({ blorp_List* __result = blorp_list_new(capacity); "
				+ "blorp_list_init_elem_release(__result, blorp_elem_release_fn); __result; })"
			)
		Err(error): False

	construct_append_ok: Bool = match render_prepared_list(
		"list_construct_append_owned",
		["__lst", "value"],
	):
		Ok(rendered): rendered == "__lst = blorp_list_append_owned(__lst, value);"
		Err(error): False

	construct_struct_ok: Bool = match render_prepared_list(
		"list_construct_inline_struct_set",
		["__lst", "2", "next", "__elem", "Small"],
	):
		Ok(rendered):
			rendered == "{ Small __elem = next; blorp_list_set_raw_copy(__lst, 2, &__elem); }"
		Err(error): False

	all_ok: Bool = (
		pointer_ok
		and inline_ok
		and load_ok
		and bits_load_ok
		and bits_store_ok
		and struct_store_ok
		and alloc_inline_ok
		and alloc_release_ok
		and construct_append_ok
		and construct_struct_ok
	)

	all_ok


func test_render_prepared_list_swap_success() -> Bool:
	match render_prepared_list(
		"list_pointer_swap",
		["xs", "left", "right", "__list", "__left", "__right", "__value"],
	):
		Ok(rendered):
			rendered == (
				"({ blorp_List* __list = (blorp_List*)xs; long __left = left; long __right = "
				+ "right; if (__builtin_expect(__list && __left != __right, 1)) { void* __value = "
				+ "blorp_list_get(__list, __left); blorp_list_set_raw(__list, __left, "
				+ "blorp_list_get(__list, __right)); blorp_list_set_raw(__list, __right, __value); "
				+ "} })"
			)
		Err(error): False


func test_render_prepared_list_errors_are_typed() -> Bool:
	wrong_arity_ok: Bool = match render_prepared_list("list_get_pointer", ["xs"]):
		Ok(rendered): False
		Err(error):
			match error:
				WrongArity(info, got):
					(
						prepared_list_template_name(info) == "list_get_pointer"
						and prepared_list_template_arity(info) == 2
						and got == 1
					)
				UnsupportedPreparedListOp(name): False

	load_arity_ok: Bool = match render_prepared_list("list_inline_struct_load_checked", ["__list"]):
		Ok(rendered): False
		Err(error):
			match error:
				WrongArity(info, got):
					(
						prepared_list_template_name(info) == "list_inline_struct_load_checked"
						and prepared_list_template_arity(info) == 5
						and got == 1
					)
				UnsupportedPreparedListOp(name): False

	bits_load_arity_ok: Bool = match render_prepared_list("list_inline_bits_load", ["__list"]):
		Ok(rendered): False
		Err(error):
			match error:
				WrongArity(info, got):
					(
						prepared_list_template_name(info) == "list_inline_bits_load"
						and prepared_list_template_arity(info) == 4
						and got == 1
					)
				UnsupportedPreparedListOp(name): False

	bits_store_arity_ok: Bool = match render_prepared_list("list_inline_bits_store", ["xs"]):
		Ok(rendered): False
		Err(error):
			match error:
				WrongArity(info, got):
					(
						prepared_list_template_name(info) == "list_inline_bits_store"
						and prepared_list_template_arity(info) == 5
						and got == 1
					)
				UnsupportedPreparedListOp(name): False

	struct_store_arity_ok: Bool = match render_prepared_list(
		"list_inline_struct_set_raw_store",
		["xs"],
	):
		Ok(rendered): False
		Err(error):
			match error:
				WrongArity(info, got):
					(
						prepared_list_template_name(info) == "list_inline_struct_set_raw_store"
						and prepared_list_template_arity(info) == 8
						and got == 1
					)
				UnsupportedPreparedListOp(name): False

	pointer_swap_arity_ok: Bool = match render_prepared_list("list_pointer_swap", ["xs"]):
		Ok(rendered): False
		Err(error):
			match error:
				WrongArity(info, got):
					(
						prepared_list_template_name(info) == "list_pointer_swap"
						and prepared_list_template_arity(info) == 7
						and got == 1
					)
				UnsupportedPreparedListOp(name): False

	ensure_capacity_arity_ok: Bool = match render_prepared_list("list_ensure_capacity", ["xs"]):
		Ok(rendered): False
		Err(error):
			match error:
				WrongArity(info, got):
					(
						prepared_list_template_name(info) == "list_ensure_capacity"
						and prepared_list_template_arity(info) == 3
						and got == 1
					)
				UnsupportedPreparedListOp(name): False

	retain_noop_arity_ok: Bool = match render_prepared_list("list_retain_for_noop", ["xs"]):
		Ok(rendered): False
		Err(error):
			match error:
				WrongArity(info, got):
					(
						prepared_list_template_name(info) == "list_retain_for_noop"
						and prepared_list_template_arity(info) == 0
						and got == 1
					)
				UnsupportedPreparedListOp(name): False

	alloc_inline_arity_ok: Bool = match render_prepared_list("list_alloc_inline", ["capacity"]):
		Ok(rendered): False
		Err(error):
			match error:
				WrongArity(info, got):
					(
						prepared_list_template_name(info) == "list_alloc_inline"
						and prepared_list_template_arity(info) == 2
						and got == 1
					)
				UnsupportedPreparedListOp(name): False

	unsupported_ok: Bool = match render_prepared_list("list_len", ["xs"]):
		Ok(rendered): False
		Err(error):
			match error:
				WrongArity(info, got): False
				UnsupportedPreparedListOp(name): name == "list_len"

	all_ok: Bool = (
		wrong_arity_ok
		and load_arity_ok
		and bits_load_arity_ok
		and bits_store_arity_ok
		and struct_store_arity_ok
		and pointer_swap_arity_ok
		and ensure_capacity_arity_ok
		and retain_noop_arity_ok
		and alloc_inline_arity_ok
		and unsupported_ok
	)

	all_ok


func test_render_error_to_string() -> Bool:
	unsupported_error: RenderError = UnsupportedPreparedListOp("missing")

	arity_text: String = match render_prepared_list(
		"list_get_inline_checked",
		["a", "b", "c", "d", "e"],
	):
		Ok(rendered): rendered
		Err(error): render_error_to_string(error)

	unsupported_text: String = render_error_to_string(unsupported_error)

	(
		arity_text == "prepared list op list_get_inline_checked expected 4 arg(s), got 5"
		and unsupported_text == "unsupported prepared list op: missing"
	)


func test_render_manifest_lines() -> Bool:
	lines: List[String] = render_manifest_lines()
	count_ok: Bool = lines.length() == ALL_TEMPLATES.length()

	first_ok: Bool = match lines:
		[]: False
		[first, ...rest]:
			first == "list_get_pointer\t2\tblorp_list_get((blorp_List*)@0@, @1@)"

	inline_checked_ok: Bool = manifest_line_is(
		"list_get_inline_checked",
		"list_get_inline_checked\t4\t({ blorp_List* __lg_list_@2@ = (blorp_List*)@0@; long __lg_idx_@2@ = @1@; (__builtin_expect(!__lg_list_@2@ || __lg_idx_@2@ < 0 || __lg_idx_@2@ >= __lg_list_@2@->len, 0) ? NULL : ({ uintptr_t __lg_bits_@2@ = 0; memcpy(&__lg_bits_@2@, (char*)__lg_list_@2@->data + __lg_idx_@2@ * @3@, @3@); (void*)__lg_bits_@2@; })); })",
	)
	bits_load_ok: Bool = manifest_line_is(
		"list_inline_bits_load",
		"list_inline_bits_load\t4\tuintptr_t @2@ = 0; memcpy(&@2@, (char*)@0@->data + @1@ * @3@, @3@);",
	)
	bits_store_ok: Bool = manifest_line_is(
		"list_inline_bits_store",
		"list_inline_bits_store\t5\t({ blorp_List* __list_store_@3@ = (blorp_List*)@0@; long __list_store_idx_@3@ = @1@; uintptr_t __list_store_bits_@3@ = (uintptr_t)@2@; memcpy((char*)__list_store_@3@->data + __list_store_idx_@3@ * @4@, &__list_store_bits_@3@, @4@); })",
	)
	pointer_set_raw_store_ok: Bool = manifest_line_is(
		"list_pointer_set_raw_store",
		"list_pointer_set_raw_store\t3\tblorp_list_set_raw((blorp_List*)@0@, @1@, (void*)@2@)",
	)
	pointer_handoff_store_ok: Bool = manifest_line_is(
		"list_pointer_handoff_set_owned_store",
		"list_pointer_handoff_set_owned_store\t3\tblorp_list_handoff_set_owned((blorp_List*)@0@, @1@, (void*)@2@)",
	)
	struct_set_raw_store_ok: Bool = manifest_line_is(
		"list_inline_struct_set_raw_store",
		"list_inline_struct_set_raw_store\t8\t({ blorp_List* @4@ = (blorp_List*)@0@; long @5@ = @1@; @7@ @6@ = @2@; if (@4@ && @4@->storage_mode == BLORP_LIST_STORAGE_INLINE && @4@->elem_size == (int16_t)sizeof(@7@)) { blorp_list_set_raw_copy(@4@, @5@, &@6@); } else { blorp_list_set_raw((blorp_List*)@4@, @5@, (void*)@3@); } })",
	)
	struct_handoff_store_ok: Bool = manifest_line_is(
		"list_inline_struct_handoff_set_owned_store",
		"list_inline_struct_handoff_set_owned_store\t8\t({ blorp_List* @4@ = (blorp_List*)@0@; long @5@ = @1@; @7@ @6@ = @2@; if (@4@ && @4@->storage_mode == BLORP_LIST_STORAGE_INLINE && @4@->elem_size == (int16_t)sizeof(@7@)) { blorp_list_set_raw_copy(@4@, @5@, &@6@); } else { blorp_list_handoff_set_owned((blorp_List*)@4@, @5@, (void*)@3@); } })",
	)
	pointer_swap_ok: Bool = manifest_line_is(
		"list_pointer_swap",
		"list_pointer_swap\t7\t({ blorp_List* @3@ = (blorp_List*)@0@; long @4@ = @1@; long @5@ = @2@; if (__builtin_expect(@3@ && @4@ != @5@, 1)) { void* @6@ = blorp_list_get(@3@, @4@); blorp_list_set_raw(@3@, @4@, blorp_list_get(@3@, @5@)); blorp_list_set_raw(@3@, @5@, @6@); } })",
	)
	bits_swap_ok: Bool = manifest_line_is(
		"list_inline_bits_swap",
		"list_inline_bits_swap\t9\t({ blorp_List* @3@ = (blorp_List*)@0@; long @4@ = @1@; long @5@ = @2@; if (__builtin_expect(@3@ && @4@ != @5@, 1)) { char* @6@ = (char*)@3@->data; uintptr_t @7@ = 0; memcpy(&@7@, @6@ + @4@ * @8@, @8@); memcpy(@6@ + @4@ * @8@, @6@ + @5@ * @8@, @8@); memcpy(@6@ + @5@ * @8@, &@7@, @8@); } })",
	)
	struct_swap_ok: Bool = manifest_line_is(
		"list_inline_struct_swap",
		"list_inline_struct_swap\t12\t({ blorp_List* @3@ = (blorp_List*)@0@; long @4@ = @1@; long @5@ = @2@; if (__builtin_expect(@3@ && @4@ != @5@, 1)) { if (@3@->storage_mode == BLORP_LIST_STORAGE_INLINE) { char* @6@ = (char*)@3@->data; size_t @7@ = (size_t)@3@->elem_size; void* @8@ = @6@ + @4@ * @7@; void* @9@ = @6@ + @5@ * @7@; unsigned char @10@[@7@]; memcpy(@10@, @8@, @7@); memcpy(@8@, @9@, @7@); memcpy(@9@, @10@, @7@); } else { void* @11@ = blorp_list_get(@3@, @4@); blorp_list_set_raw(@3@, @4@, blorp_list_get(@3@, @5@)); blorp_list_set_raw(@3@, @5@, @11@); } } })",
	)
	struct_load_checked_ok: Bool = manifest_line_is(
		"list_inline_struct_load_checked",
		"list_inline_struct_load_checked\t5\tif (__builtin_expect(!@0@ || @1@ < 0 || @1@ >= @0@->len, 0)) { memset(&@2@, 0, sizeof(@4@)); } else if (@0@->storage_mode == BLORP_LIST_STORAGE_INLINE && @0@->elem_size == (int16_t)sizeof(@4@)) { memcpy(&@2@, (char*)@0@->data + @1@ * sizeof(@4@), sizeof(@4@)); } else { void* @3@ = blorp_list_get(@0@, @1@); if (!@3@) { memset(&@2@, 0, sizeof(@4@)); } else { @2@ = blorp_unbox_struct(@3@, @4@); } }",
	)
	struct_load_proven_ok: Bool = manifest_line_is(
		"list_inline_struct_load_proven",
		"list_inline_struct_load_proven\t5\tif (@0@->storage_mode == BLORP_LIST_STORAGE_INLINE && @0@->elem_size == (int16_t)sizeof(@4@)) { memcpy(&@2@, (char*)@0@->data + @1@ * sizeof(@4@), sizeof(@4@)); } else { void* @3@ = blorp_list_get(@0@, @1@); if (!@3@) { memset(&@2@, 0, sizeof(@4@)); } else { @2@ = blorp_unbox_struct(@3@, @4@); } }",
	)
	handoff_source_slot_ok: Bool = manifest_line_is(
		"list_handoff_set_source_slot",
		"list_handoff_set_source_slot\t4\tblorp_list_handoff_set_source_slot((blorp_List*)@0@, @1@, (blorp_List*)@2@, @3@)",
	)
	copy_span_ok: Bool = manifest_line_is(
		"list_copy_span_uninit",
		"list_copy_span_uninit\t5\tblorp_list_copy_span_uninit((blorp_List*)@0@, @1@, (blorp_List*)@2@, @3@, @4@)",
	)
	ensure_unique_ok: Bool = manifest_line_is(
		"list_ensure_unique",
		"list_ensure_unique\t2\t({ blorp_List* __list_unique_@1@ = (blorp_List*)@0@; (__builtin_expect(__list_unique_@1@ && blorp_is_unique(__list_unique_@1@), 1) ? __list_unique_@1@ : blorp_list_cow(__list_unique_@1@)); })",
	)
	ensure_capacity_ok: Bool = manifest_line_is(
		"list_ensure_capacity",
		"list_ensure_capacity\t3\t({ blorp_List* __list_cap_@2@ = (blorp_List*)@0@; long __list_cap_min_@2@ = @1@; (__builtin_expect(__list_cap_@2@ && blorp_is_unique(__list_cap_@2@) && __list_cap_@2@->capacity >= __list_cap_min_@2@, 1) ? __list_cap_@2@ : blorp_list_ensure_capacity(__list_cap_@2@, __list_cap_min_@2@)); })",
	)
	reuse_alloc_ok: Bool = manifest_line_is(
		"list_reuse_alloc",
		"list_reuse_alloc\t2\tblorp_list_reuse_alloc(@0@, @1@)",
	)
	reuse_alloc_release_ok: Bool = manifest_line_is(
		"list_reuse_alloc_with_release",
		"list_reuse_alloc_with_release\t3\t({ blorp_List* __lst_@2@ = blorp_list_reuse_alloc(@0@, @1@); blorp_list_init_elem_release(__lst_@2@, blorp_elem_release_fn); __lst_@2@; })",
	)
	alloc_pointer_ok: Bool = manifest_line_is(
		"list_alloc_pointer",
		"list_alloc_pointer\t1\tblorp_list_new(@0@)",
	)
	alloc_inline_ok: Bool = manifest_line_is(
		"list_alloc_inline",
		"list_alloc_inline\t2\tblorp_list_new_inline(@0@, @1@)",
	)
	alloc_release_ok: Bool = manifest_line_is(
		"list_alloc_with_release",
		"list_alloc_with_release\t2\t({ blorp_List* @1@ = @0@; blorp_list_init_elem_release(@1@, blorp_elem_release_fn); @1@; })",
	)
	retain_for_ok: Bool = manifest_line_is(
		"list_retain_for",
		"list_retain_for\t2\tblorp_list_retain_for((blorp_List*)@0@, (void*)@1@)",
	)
	retain_noop_ok: Bool = manifest_line_is(
		"list_retain_for_noop",
		"list_retain_for_noop\t0\t((void)0)",
	)

	(
		count_ok
		and first_ok
		and inline_checked_ok
		and bits_load_ok
		and bits_store_ok
		and pointer_set_raw_store_ok
		and pointer_handoff_store_ok
		and struct_set_raw_store_ok
		and struct_handoff_store_ok
		and pointer_swap_ok
		and bits_swap_ok
		and struct_swap_ok
		and struct_load_checked_ok
		and struct_load_proven_ok
		and handoff_source_slot_ok
		and copy_span_ok
		and ensure_unique_ok
		and ensure_capacity_ok
		and reuse_alloc_ok
		and reuse_alloc_release_ok
		and alloc_pointer_ok
		and alloc_inline_ok
		and alloc_release_ok
		and retain_for_ok
		and retain_noop_ok
	)


tests: TestSuite = {
	description = "Self-hosted compiler prepared list renderer",
	tests = [
		("parse command routes", test_parse_command_routes),
		("parse template shapes", test_parse_template_shapes),
		("render prepared list op successes", test_render_prepared_list_op_successes),
		("render prepared list successes", test_render_prepared_list_successes),
		("render prepared list swap success", test_render_prepared_list_swap_success),
		("render prepared list errors are typed", test_render_prepared_list_errors_are_typed),
		("render error to string", test_render_error_to_string),
		("render manifest lines", test_render_manifest_lines),
	]
}
