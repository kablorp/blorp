	ensure_capacity_arity_ok: Bool = match render_prepared_list("list_ensure_capacity", ["xs"]):
		Ok(rendered):
			False
		Err(error):
			match error:
				WrongArity(info, got):
					(
						prepared_list_template_name(info) == "list_ensure_capacity"
						and prepared_list_template_arity(info) == 3
						and got == 1
					)
				UnsupportedPreparedListOp(name):
					False

	retain_noop_arity_ok: Bool = match render_prepared_list("list_retain_for_noop", ["xs"]):
		Ok(rendered):
			False
		Err(error):
			match error:
				WrongArity(info, got):
					(
						prepared_list_template_name(info) == "list_retain_for_noop"
						and prepared_list_template_arity(info) == 0
						and got == 1
					)
				UnsupportedPreparedListOp(name):
					False

	alloc_inline_arity_ok: Bool = match render_prepared_list("list_alloc_inline", ["capacity"]):
		Ok(rendered):
			False
		Err(error):
			match error:
				WrongArity(info, got):
					(
						prepared_list_template_name(info) == "list_alloc_inline"
						and prepared_list_template_arity(info) == 2
						and got == 1
					)
				UnsupportedPreparedListOp(name):
					False

	unsupported_ok: Bool = match render_prepared_list("list_len", ["xs"]):
		Ok(rendered):
			False
		Err(error):
			match error:
				WrongArity(info, got):
					False
				UnsupportedPreparedListOp(name):
					name == "list_len"

	all_ok: Bool = (
		wrong_arity_ok
		and load_arity_ok
		and bits_load_arity_ok
		and bits_store_arity_ok
		and struct_store_arity_ok
		and pointer_swap_arity_ok
		and ensure_capacity_arity_ok
		and retain_noop_arity_ok
		and alloc_inline_arity_ok
		and unsupported_ok
	)

	all_ok


func test_render_error_to_string() -> Bool:
	unsupported_error: RenderError = UnsupportedPreparedListOp("missing")

	arity_text: String = match render_prepared_list(
		"list_get_inline_checked",
		["a", "b", "c", "d", "e"],
	):
		Ok(rendered):
			rendered
		Err(error):
			render_error_to_string(error)

	unsupported_text: String = render_error_to_string(unsupported_error)

	(
		arity_text == "prepared list op list_get_inline_checked expected 4 arg(s), got 5"
		and unsupported_text == "unsupported prepared list op: missing"
	)


tests: TestSuite = {
	description = "Self-hosted compiler prepared list renderer",
	tests = [
		("parse template shapes", test_parse_template_shapes),
		("render prepared list op successes", test_render_prepared_list_op_successes),
		("render prepared list successes", test_render_prepared_list_successes),
		("render prepared list swap success", test_render_prepared_list_swap_success),
		("render prepared list errors are typed", test_render_prepared_list_errors_are_typed),
		("render error to string", test_render_error_to_string),
	]
}
