import:
	../src/stage_01_file_io/compiler_source:
		CompilerCursor,
		CompilerSourceFile,
		CompilerSourceSpan,
		compiler_source_cursor_at,
		compiler_source_file,
		compiler_source_span,
	../src/stage_02_lex/compiler_parse_diagnostic: CompilerParseDiagnostic, compiler_parse_error
	../src/stage_03_parse/compiler_parsed_ast:
		ParsedDecl(FunctionParsedDecl, ParsedErrorDecl),
		ParsedExpr(
			ParsedAscriptionExpr,
			ParsedCharLiteralExpr,
			ParsedForExpr,
			ParsedIntLiteralExpr,
			ParsedMatchExpr,
			ParsedNameExpr,
			ParsedTupleDestructExpr,
		),
		ParsedForBinder(ParsedForTupleBinder),
		ParsedIdentifier,
		ParsedListPatternSpread(ParsedListSpreadName),
		ParsedMatchCase,
		ParsedParamBinder(ParsedParamTupleBinder),
		ParsedPattern(
			ParsedCharPattern,
			ParsedFloatPattern,
			ParsedIntPattern,
			ParsedListPattern,
			ParsedNamePattern,
			ParsedOrPattern,
			ParsedTuplePattern,
		),
		ParsedProgram,
		ParsedProgramPhase(RawParsedProgram, TypecheckSourceProgram),
		ParsedTypeExpr(ParsedMissingType, ParsedNamedType, ParsedTupleType),
		parsed_decl_name,
		parsed_identifier,
		parsed_program_has_errors,
		parsed_program_ok,
		parsed_program_phase_from_name,
		parsed_program_phase_name,
	../src/stage_03_parse/compiler_parsed_ast_json:
		PARSED_DECL_KIND_FUNCTION,
		PARSED_PROGRAM_KIND,
		parsed_program_to_json,
	test: TestSuite


pure func source_file() -> CompilerSourceFile:
	compiler_source_file("ast.brp", "ast", "func main(): 1")


pure func span_between(
	src: CompilerSourceFile,
	start_offset: Int,
	end_offset: Int,
) -> CompilerSourceSpan:
	start: CompilerCursor = compiler_source_cursor_at(src, start_offset)
	finish: CompilerCursor = compiler_source_cursor_at(src, end_offset)
	compiler_source_span(src, start, finish)


pure func test_parsed_program_phase_names_round_trip() -> Bool:
	(
		parsed_program_phase_name(RawParsedProgram) == "raw_parse"
		and parsed_program_phase_name(TypecheckSourceProgram) == "typecheck_source"
		and parsed_program_phase_from_name("raw_parse") == Some(RawParsedProgram)
		and parsed_program_phase_from_name("typecheck_source") == Some(TypecheckSourceProgram)
		and parsed_program_phase_from_name("unknown") == None
	)


func test_parsed_program_without_diagnostics_is_ok() -> Bool:
	src: CompilerSourceFile = source_file()
	name: ParsedIdentifier = parsed_identifier(
		"main",
		span_between(src, 5, 9),
	)
	return_type: ParsedTypeExpr = ParsedMissingType(span_between(src, 11, 11))
	body: ParsedExpr = ParsedIntLiteralExpr(
		"1",
		span_between(src, 13, 14),
	)
	decl: ParsedDecl = FunctionParsedDecl({
		name = name,
		keyword_span = Some(span_between(src, 0, 4)),
		type_params = [],
		params = [],
		return_type = Some(return_type),
		dim_constraints = [],
		body = Some(body),
		is_pure = False,
		annotations = [],
		doc = None,
		span = span_between(src, 0, 14),
	})
	program: ParsedProgram = {
		source = src,
		decls = [decl],
		diagnostics = []
	}

	(
		parsed_program_ok(program)
		and not parsed_program_has_errors(program)
		and parsed_decl_name(decl).get_or("") == "main"
	)


func test_parsed_program_with_error_is_not_ok() -> Bool:
	src: CompilerSourceFile = source_file()
	span: CompilerSourceSpan = span_between(src, 0, 4)
	diag: CompilerParseDiagnostic = compiler_parse_error(span, "expected declaration")
	program: ParsedProgram = {
		source = src,
		decls = [ParsedErrorDecl(span)],
		diagnostics = [diag]
	}
	not parsed_program_ok(program) and parsed_program_has_errors(program)


func test_parsed_program_json_includes_source_decl_and_diagnostics() -> Bool:
	src: CompilerSourceFile = source_file()
	name: ParsedIdentifier = parsed_identifier(
		"main",
		span_between(src, 5, 9),
	)
	body: ParsedExpr = ParsedIntLiteralExpr(
		"1",
		span_between(src, 13, 14),
	)
	decl: ParsedDecl = FunctionParsedDecl({
		name = name,
		keyword_span = Some(span_between(src, 0, 4)),
		type_params = [],
		params = [],
		return_type = None,
		dim_constraints = [],
		body = Some(body),
		is_pure = False,
		annotations = [],
		doc = None,
		span = span_between(src, 0, 14),
	})
	program: ParsedProgram = {
		source = src,
		decls = [decl],
		diagnostics = []
	}
	text: String = parsed_program_to_json(program).to_string()

	(
		text.contains("\"kind\":\"" + PARSED_PROGRAM_KIND + "\"")
		and text.contains("\"path\":\"ast.brp\"")
		and text.contains("\"kind\":\"" + PARSED_DECL_KIND_FUNCTION + "\"")
		and text.contains("\"name\":\"main\"")
		and text.contains("\"diagnostics\":[]")
	)


func test_parsed_program_json_includes_ascription_expr() -> Bool:
	src: CompilerSourceFile = source_file()
	name: ParsedIdentifier = parsed_identifier(
		"main",
		span_between(src, 5, 9),
	)
	int_type: ParsedTypeExpr = ParsedNamedType(
		parsed_identifier(
			"Int",
			span_between(src, 18, 21),
		),
		[],
		span_between(src, 18, 21),
	)
	body: ParsedExpr = ParsedAscriptionExpr(
		ParsedIntLiteralExpr(
			"1",
			span_between(src, 13, 14),
		),
		int_type,
		span_between(src, 13, 21),
	)
	decl: ParsedDecl = FunctionParsedDecl({
		name = name,
		keyword_span = Some(span_between(src, 0, 4)),
		type_params = [],
		params = [],
		return_type = None,
		dim_constraints = [],
		body = Some(body),
		is_pure = False,
		annotations = [],
		doc = None,
		span = span_between(src, 0, 21),
	})
	program: ParsedProgram = {
		source = src,
		decls = [decl],
		diagnostics = []
	}
	text: String = parsed_program_to_json(program).to_string()

	text.contains("\"kind\":\"ascription\"") and text.contains("\"type\"")


func test_parsed_program_json_includes_char_literal_expr() -> Bool:
	src: CompilerSourceFile = source_file()
	name: ParsedIdentifier = parsed_identifier(
		"main",
		span_between(src, 5, 9),
	)
	body: ParsedExpr = ParsedCharLiteralExpr(
		65,
		span_between(src, 13, 16),
	)
	decl: ParsedDecl = FunctionParsedDecl({
		name = name,
		keyword_span = Some(span_between(src, 0, 4)),
		type_params = [],
		params = [],
		return_type = None,
		dim_constraints = [],
		body = Some(body),
		is_pure = False,
		annotations = [],
		doc = None,
		span = span_between(src, 0, 16),
	})
	program: ParsedProgram = {
		source = src,
		decls = [decl],
		diagnostics = []
	}
	text: String = parsed_program_to_json(program).to_string()

	text.contains("\"kind\":\"char_literal\"") and text.contains("\"value\":65")


func test_parsed_program_json_includes_rich_patterns() -> Bool:
	src: CompilerSourceFile = source_file()
	name: ParsedIdentifier = parsed_identifier(
		"main",
		span_between(src, 5, 9),
	)
	cases: List[ParsedMatchCase] = [
		{
			pattern = ParsedFloatPattern(
				"3.5",
				span_between(src, 13, 16),
			),
			body = ParsedIntLiteralExpr(
				"1",
				span_between(src, 18, 19),
			),
			span = span_between(src, 13, 19)
		},
		{
			pattern = ParsedCharPattern(
				65,
				span_between(src, 20, 23),
			),
			body = ParsedIntLiteralExpr(
				"2",
				span_between(src, 25, 26),
			),
			span = span_between(src, 20, 26)
		},
		{
			pattern = ParsedOrPattern(
				[ParsedIntPattern(
						"0",
						span_between(src, 27, 28),
					), ParsedIntPattern(
						"1",
						span_between(src, 31, 32),
					)],
				span_between(
					src,
					27,
					32,
				),
			),
			body = ParsedIntLiteralExpr(
				"3",
				span_between(src, 34, 35),
			),
			span = span_between(src, 27, 35)
		},
		{
			pattern = ParsedTuplePattern(
				[ParsedIntPattern(
						"0",
						span_between(src, 36, 37),
					), ParsedIntPattern(
						"0",
						span_between(src, 39, 40),
					), ParsedIntPattern(
						"0",
						span_between(src, 42, 43),
					)],
				span_between(
					src,
					35,
					44,
				),
			),
			body = ParsedIntLiteralExpr(
				"4",
				span_between(src, 46, 47),
			),
			span = span_between(src, 35, 47)
		},
		{
			pattern = ParsedListPattern(
				[ParsedNamePattern(parsed_identifier("head", span_between(src, 48, 52)))],
				Some(ParsedListSpreadName(parsed_identifier("rest", span_between(src, 57, 61)))),
				span_between(src, 47, 62),
			),
			body = ParsedIntLiteralExpr(
				"5",
				span_between(src, 64, 65),
			),
			span = span_between(src, 47, 65)
		},
	]
	body: ParsedExpr = ParsedMatchExpr(
		ParsedNameExpr(parsed_identifier("value", span_between(src, 13, 18))),
		cases,
		span_between(src, 10, 35),
	)
	decl: ParsedDecl = FunctionParsedDecl({
		name = name,
		keyword_span = Some(span_between(src, 0, 4)),
		type_params = [],
		params = [],
		return_type = None,
		dim_constraints = [],
		body = Some(body),
		is_pure = False,
		annotations = [],
		doc = None,
		span = span_between(src, 0, 35),
	})
	program: ParsedProgram = {
		source = src,
		decls = [decl],
		diagnostics = []
	}
	text: String = parsed_program_to_json(program).to_string()

	(
		text.contains("\"kind\":\"float\"")
		and text.contains("\"kind\":\"char\"")
		and text.contains("\"kind\":\"or\"")
		and text.contains("\"kind\":\"tuple\"")
		and text.contains("\"kind\":\"list\"")
		and text.contains("\"spread\"")
		and text.contains("\"text\":\"rest\"")
	)


func test_parsed_program_json_includes_for_tuple_binder() -> Bool:
	src: CompilerSourceFile = source_file()
	name: ParsedIdentifier = parsed_identifier(
		"main",
		span_between(src, 5, 9),
	)
	body: ParsedExpr = ParsedForExpr(
		ParsedForTupleBinder(
			[parsed_identifier(
					"key",
					span_between(src, 13, 16),
				), parsed_identifier(
					"value",
					span_between(src, 18, 23),
				)],
			span_between(
				src,
				12,
				24,
			),
		),
		ParsedNameExpr(parsed_identifier("pairs", span_between(src, 28, 33))),
		ParsedIntLiteralExpr(
			"1",
			span_between(src, 35, 36),
		),
		span_between(
			src,
			8,
			36,
		),
	)
	decl: ParsedDecl = FunctionParsedDecl({
		name = name,
		keyword_span = Some(span_between(src, 0, 4)),
		type_params = [],
		params = [],
		return_type = None,
		dim_constraints = [],
		body = Some(body),
		is_pure = False,
		annotations = [],
		doc = None,
		span = span_between(src, 0, 36),
	})
	program: ParsedProgram = {
		source = src,
		decls = [decl],
		diagnostics = []
	}
	text: String = parsed_program_to_json(program).to_string()

	(
		text.contains("\"kind\":\"for\"")
		and text.contains("\"binder\"")
		and text.contains("\"kind\":\"tuple\"")
		and text.contains("\"text\":\"key\"")
		and text.contains("\"text\":\"value\"")
	)


func test_parsed_program_json_includes_tuple_destruct_expr() -> Bool:
	src: CompilerSourceFile = source_file()
	name: ParsedIdentifier = parsed_identifier(
		"main",
		span_between(src, 5, 9),
	)
	body: ParsedExpr = ParsedTupleDestructExpr(
		[parsed_identifier(
				"left",
				span_between(src, 13, 17),
			), parsed_identifier(
				"right",
				span_between(src, 19, 24),
			)],
		ParsedNameExpr(parsed_identifier("pair", span_between(src, 28, 32))),
		span_between(
			src,
			12,
			32,
		),
	)
	decl: ParsedDecl = FunctionParsedDecl({
		name = name,
		keyword_span = Some(span_between(src, 0, 4)),
		type_params = [],
		params = [],
		return_type = None,
		dim_constraints = [],
		body = Some(body),
		is_pure = False,
		annotations = [],
		doc = None,
		span = span_between(src, 0, 32),
	})
	program: ParsedProgram = {
		source = src,
		decls = [decl],
		diagnostics = []
	}
	text: String = parsed_program_to_json(program).to_string()

	(
		text.contains("\"kind\":\"tuple_destruct\"")
		and text.contains("\"names\"")
		and text.contains("\"text\":\"left\"")
		and text.contains("\"text\":\"right\"")
		and text.contains("\"value\"")
	)


func test_parsed_program_json_includes_tuple_param_binder() -> Bool:
	src: CompilerSourceFile = source_file()
	name: ParsedIdentifier = parsed_identifier(
		"main",
		span_between(src, 5, 9),
	)
	param_type: ParsedTypeExpr = ParsedTupleType(
		[ParsedNamedType(
				parsed_identifier(
					"Int",
					span_between(src, 30, 33),
				),
				[],
				span_between(src, 30, 33),
			), ParsedNamedType(
				parsed_identifier(
					"Int",
					span_between(src, 35, 38),
				),
				[],
				span_between(src, 35, 38),
			)],
		span_between(
			src,
			29,
			39,
		),
	)
	decl: ParsedDecl = FunctionParsedDecl({
		name = name,
		keyword_span = Some(span_between(src, 0, 4)),
		type_params = [],
		params = [
			{
				binder = ParsedParamTupleBinder(
					[parsed_identifier(
							"left",
							span_between(src, 13, 17),
						), parsed_identifier(
							"right",
							span_between(src, 19, 24),
						)],
					span_between(
						src,
						12,
						25,
					),
				),
				type_expr = Some(param_type),
				span = span_between(src, 12, 39)
			},
		],
		return_type = None,
		dim_constraints = [],
		body = Some(ParsedIntLiteralExpr("1", span_between(src, 43, 44))),
		is_pure = False,
		annotations = [],
		doc = None,
		span = span_between(src, 0, 44),
	})
	program: ParsedProgram = {
		source = src,
		decls = [decl],
		diagnostics = []
	}
	text: String = parsed_program_to_json(program).to_string()

	(
		text.contains("\"binder\"")
		and text.contains("\"kind\":\"tuple\"")
		and text.contains("\"text\":\"left\"")
		and text.contains("\"text\":\"right\"")
		and text.contains("\"type\"")
	)


tests: TestSuite = {
	description = "Compiler parsed AST foundation",
	tests = [
		("parsed program phase names round trip", test_parsed_program_phase_names_round_trip),
		("parsed program without diagnostics is ok", test_parsed_program_without_diagnostics_is_ok),
		("parsed program with error is not ok", test_parsed_program_with_error_is_not_ok),
		(
			"parsed program JSON includes source decl and diagnostics",
			test_parsed_program_json_includes_source_decl_and_diagnostics,
		),
		(
			"parsed program JSON includes ascription expr",
			test_parsed_program_json_includes_ascription_expr,
		),
		(
			"parsed program JSON includes char literal expr",
			test_parsed_program_json_includes_char_literal_expr,
		),
		(
			"parsed program JSON includes rich patterns",
			test_parsed_program_json_includes_rich_patterns,
		),
		(
			"parsed program JSON includes for tuple binder",
			test_parsed_program_json_includes_for_tuple_binder,
		),
		(
			"parsed program JSON includes tuple destruct expr",
			test_parsed_program_json_includes_tuple_destruct_expr,
		),
		(
			"parsed program JSON includes tuple param binder",
			test_parsed_program_json_includes_tuple_param_binder,
		),
	]
}
