import:
	../src/stage_10_backend/build_artifact: BuildPlatform(BuildLinux, BuildMacos)
	../src/stage_12_cli/host_c:
		HostCCompiler,
		HostCCompilerFamily(HostClang, HostGcc, HostOtherCompiler),
		HostTlsBackend(HostTlsOpenSsl, HostTlsUnsupported),
	../src/stage_12_cli/platform:
		HostPlatformError(
			HostArgumentListInvalid,
			HostPlatformInterrupted,
			HostPlatformUnsupported,
			HostTlsBackendInvalid,
		),
		HostProcessExecution(HostProcessInterrupted),
		HostToolchainProbe,
		discover_host_toolchain,
		discover_host_toolchain_with_runner,
		host_c_compiler_family,
		host_cache_root,
		host_tls_configuration,
		parse_host_arguments,
		parse_host_platform,
		parse_host_tls_backend,
	bytes: bytes
	process: ProcessCommand
	test: TestSuite
	units: mebibytes, seconds


private pure func platform_is_linux(platform: BuildPlatform) -> Bool:
	match platform:
		BuildLinux:
			True
		BuildMacos:
			False


private pure func platform_is_macos(platform: BuildPlatform) -> Bool:
	match platform:
		BuildLinux:
			False
		BuildMacos:
			True


pure func test_platform_output_is_normalized() -> Bool:
	linux: Bool = match parse_host_platform(" Linux\n"):
		Ok(platform):
			platform_is_linux(platform)
		Err(_):
			False

	macos: Bool = match parse_host_platform("Darwin\n"):
		Ok(platform):
			platform_is_macos(platform)
		Err(_):
			False

	unsupported: Bool = match parse_host_platform("Plan9"):
		Err(HostPlatformUnsupported(name)):
			name == "Plan9"
		_:
			False

	linux and macos and unsupported


pure func test_compiler_family_uses_version_output() -> Bool:
	(
		host_c_compiler_family("Apple clang version 18.0") == HostClang
		and host_c_compiler_family("gcc (GCC) 15.1") == HostGcc
		and host_c_compiler_family(
			"cc (Ubuntu 14.2.0-4ubuntu2) 14.2.0\nCopyright (C) 2024 Free Software Foundation, Inc.",
		) == HostGcc
		and host_c_compiler_family("custom compiler") == HostOtherCompiler
	)


pure func test_tls_backend_is_validated_once() -> Bool:
	default_backend: Bool = match parse_host_tls_backend(None):
		Ok(HostTlsUnsupported):
			True
		_:
			False

	openssl_backend: Bool = match parse_host_tls_backend(Some(" OpenSSL ")):
		Ok(HostTlsOpenSsl):
			True
		_:
			False

	invalid_backend: Bool = match parse_host_tls_backend(Some("native")):
		Err(HostTlsBackendInvalid(value)):
			value == "native"
		_:
			False

	configuration = host_tls_configuration(HostTlsOpenSsl, ["-I/ssl include"], ["-lssl"])

	(
		default_backend
		and openssl_backend
		and invalid_backend
		and configuration.runtime_arguments == [
			"-DBLORP_TLS_BACKEND_PROFILE_OPENSSL=1",
			"-I/ssl include",
		]
		and configuration.link_arguments == ["-lssl"]
	)


pure func test_cache_root_precedence_is_explicit() -> Bool:
	(
		host_cache_root(Some("/override"), Some("/xdg"), Some("/home"), "/tmp") == "/override"
		and host_cache_root(None, Some("/xdg"), Some("/home"), "/tmp") == "/xdg/blorp/cas"
		and host_cache_root(None, None, Some("/home"), "/tmp") == "/home/.cache/blorp/cas"
		and host_cache_root(None, None, None, "/tmp") == "/tmp/.cache/blorp/cas"
	)


pure func test_host_argument_lists_preserve_boundaries() -> Bool:
	parsed: Bool = match parse_host_arguments(
		"-I'/path with spaces' \"-DNAME=a b\" '' plain\\ value",
	):
		Ok(arguments):
			arguments == ["-I/path with spaces", "-DNAME=a b", "", "plain value"]
		Err(_):
			False

	invalid: Bool = match parse_host_arguments("'unterminated"):
		Err(HostArgumentListInvalid(_)):
			True
		_:
			False

	parsed and invalid


private func test_real_host_toolchain_probe() -> Bool:
	compiler: HostCCompiler = {
		program = "cc",
		prefix_arguments = [],
		family = HostOtherCompiler
	}
	probe: HostToolchainProbe = {
		compiler = compiler,
		uname_program = "uname",
		timeout = Some(seconds(10)),
		capture_limit = mebibytes(4)
	}

	match discover_host_toolchain(probe):
		Ok(toolchain):
			(
				toolchain.identity.length() > 0
				and toolchain.target_identity.length() > 0
				and toolchain.compiler.family != HostOtherCompiler
			)
		Err(_):
			False


private func test_host_toolchain_probe_propagates_interruption() -> Bool:
	probe: HostToolchainProbe = {
		compiler = {
			program = "cc",
			prefix_arguments = [],
			family = HostOtherCompiler
		},
		uname_program = "uname",
		timeout = Some(seconds(10)),
		capture_limit = mebibytes(4)
	}

	match discover_host_toolchain_with_runner(
		probe,
		func(_: ProcessCommand): HostProcessInterrupted(2, bytes(3), bytes(4)),
	):
		Err(HostPlatformInterrupted(signal, stdout, stderr)):
			signal == 2 and stdout.length() == 3 and stderr.length() == 4
		_:
			False


tests: TestSuite = {
	description = "Blorp compiler host platform discovery",
	tests = [
		("platform output is normalized", test_platform_output_is_normalized),
		("compiler family uses version output", test_compiler_family_uses_version_output),
		("TLS backend is validated once", test_tls_backend_is_validated_once),
		("cache root precedence is explicit", test_cache_root_precedence_is_explicit),
		("host argument lists preserve boundaries", test_host_argument_lists_preserve_boundaries),
		(
			"host toolchain probe propagates interruption",
			test_host_toolchain_probe_propagates_interruption,
		),
		("real host toolchain probe", test_real_host_toolchain_probe),
	]
}
