import:
	../src/stage_01_file_io/source:
		CompilerCursor,
		CompilerSourceFile,
		CompilerSourceSpan,
		compiler_source_advance,
		compiler_source_at_end,
		compiler_source_cursor_at,
		compiler_source_file,
		compiler_source_peek,
		compiler_source_span,
		compiler_source_span_label,
		compiler_source_span_text,
		compiler_source_start,
	test: TestSuite


pure func sample_source() -> CompilerSourceFile:
	compiler_source_file("sample.brp", "sample", "a\nbc\ndef")


func test_source_keeps_metadata() -> Bool:
	src: CompilerSourceFile = sample_source()
	src.path == "sample.brp" and src.module_name == "sample" and src.text.length() == 8


func test_cursor_tracks_newlines() -> Bool:
	src: CompilerSourceFile = sample_source()
	start: CompilerCursor = compiler_source_start(src)
	after_a: CompilerCursor = compiler_source_advance(src, start)
	after_newline: CompilerCursor = compiler_source_advance(src, after_a)

	(
		after_newline.offset == 2
		and after_newline.line == 2
		and after_newline.column == 1
		and compiler_source_peek(src, after_newline).get_or('x') == 'b'
	)


func test_cursor_tracks_tabs_as_four_column_stops() -> Bool:
	src: CompilerSourceFile = compiler_source_file("tabs.brp", "tabs", "\tindent")
	start: CompilerCursor = compiler_source_start(src)
	after_tab: CompilerCursor = compiler_source_advance(src, start)
	after_i: CompilerCursor = compiler_source_advance(src, after_tab)

	after_tab.offset == 1 and after_tab.line == 1 and after_tab.column == 5 and after_i.column == 6


func test_cursor_at_clamps_and_reconstructs_position() -> Bool:
	src: CompilerSourceFile = sample_source()
	before_start: CompilerCursor = compiler_source_cursor_at(src, -5)
	middle: CompilerCursor = compiler_source_cursor_at(src, 5)
	past_end: CompilerCursor = compiler_source_cursor_at(src, 99)

	(
		before_start.offset == 0
		and middle.offset == 5
		and middle.line == 3
		and middle.column == 1
		and past_end.offset == src.text.length()
		and compiler_source_at_end(src, past_end)
	)


func test_span_text_and_label() -> Bool:
	src: CompilerSourceFile = sample_source()
	start: CompilerCursor = compiler_source_cursor_at(src, 2)
	finish: CompilerCursor = compiler_source_cursor_at(src, 4)
	span: CompilerSourceSpan = compiler_source_span(src, start, finish)

	(
		compiler_source_span_text(src, span) == "bc"
		and compiler_source_span_label(span) == "sample.brp:2:1"
	)


tests: TestSuite = {
	description = "Compiler source foundation",
	tests = [
		("source keeps metadata", test_source_keeps_metadata),
		("cursor tracks newlines", test_cursor_tracks_newlines),
		("cursor tracks tabs as four column stops", test_cursor_tracks_tabs_as_four_column_stops),
		(
			"cursor_at clamps and reconstructs position",
			test_cursor_at_clamps_and_reconstructs_position,
		),
		("span text and label", test_span_text_and_label),
	]
}
