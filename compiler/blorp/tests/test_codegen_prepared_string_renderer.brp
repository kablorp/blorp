import:
	../codegen_prepared_string_renderer:
		ALL_TEMPLATES,
		CompilerCommand(RenderManifestCommand, RenderPreparedStringCommand, UnknownCommand),
		PreparedStringOp(ByteCopy, ByteRead, ByteWrite, FindByteFrom, SetLen),
		RenderError(UnsupportedPreparedStringOp, WrongArity),
		parse_command,
		parse_prepared_string_template,
		prepared_string_template_arity,
		prepared_string_template_name,
		render_error_to_string,
		render_manifest_line,
		render_manifest_lines,
		render_prepared_string,
		render_prepared_string_op,
	test: TestSuite


func parsed_template_has(name: String, expected_name: String, expected_arity: Int) -> Bool:
	match parse_prepared_string_template(name):
		Some(info):
			(
				prepared_string_template_name(info) == expected_name
				and prepared_string_template_arity(info) == expected_arity
			)
		None:
			False


func manifest_line_is(name: String, expected: String) -> Bool:
	match parse_prepared_string_template(name):
		Some(info):
			render_manifest_line(info) == expected
		None:
			False


func test_parse_command_routes() -> Bool:
	render_command: CompilerCommand = parse_command("prepared-string")
	manifest_command: CompilerCommand = parse_command("manifest")
	unknown_command: CompilerCommand = parse_command("wat")

	render_ok: Bool = match render_command:
		RenderPreparedStringCommand:
			True
		RenderManifestCommand:
			False
		UnknownCommand:
			False

	manifest_ok: Bool = match manifest_command:
		RenderPreparedStringCommand:
			False
		RenderManifestCommand:
			True
		UnknownCommand:
			False

	unknown_ok: Bool = match unknown_command:
		RenderPreparedStringCommand:
			False
		RenderManifestCommand:
			False
		UnknownCommand:
			True

	render_ok and manifest_ok and unknown_ok


func test_parse_template_shapes() -> Bool:
	find_ok: Bool = parsed_template_has("string_find_byte_from", "string_find_byte_from", 4)
	read_ok: Bool = parsed_template_has("string_byte_read", "string_byte_read", 2)
	write_ok: Bool = parsed_template_has("string_byte_write", "string_byte_write", 3)
	copy_ok: Bool = parsed_template_has("string_byte_copy", "string_byte_copy", 6)
	set_len_ok: Bool = parsed_template_has("string_set_len", "string_set_len", 2)

	missing_ok: Bool = match parse_prepared_string_template("string_len"):
		Some(template):
			False
		None:
			True

	find_ok and read_ok and write_ok and copy_ok and set_len_ok and missing_ok


func test_render_prepared_string_op_successes() -> Bool:
	find_ok: Bool = render_prepared_string_op(FindByteFrom({
		source = "source",
		byte = "byte",
		start = "start",
		temp_seed = "seed",
	})) == (
		"({ blorp_String* __string_find_src_seed = (blorp_String*)source; long "
		+ "__string_find_byte_seed = byte; long __string_find_start_seed = start; "
		+ "blorp_string_find_byte_from(__string_find_src_seed, __string_find_byte_seed, "
		+ "__string_find_start_seed); })"
	)
	read_ok: Bool = render_prepared_string_op(
		ByteRead(
			"src",
			"idx",
		),
	) == "(long)(unsigned char)((blorp_String*)src)->data[idx]"
	write_ok: Bool = render_prepared_string_op(
		ByteWrite(
			"dst",
			"idx",
			"byte",
		),
	) == "(((blorp_String*)dst)->data[idx] = (char)byte)"
	copy_ok: Bool = render_prepared_string_op(ByteCopy({
		dst = "dst",
		dst_pos = "dst_pos",
		src = "src",
		src_pos = "src_pos",
		len = "len",
		temp_seed = "seed",
	})) == (
		"({ blorp_String* __string_copy_dst_seed = (blorp_String*)dst; long "
		+ "__string_copy_dst_pos_seed = dst_pos; blorp_String* __string_copy_src_seed = "
		+ "(blorp_String*)src; long __string_copy_src_pos_seed = src_pos; long "
		+ "__string_copy_len_seed = len; if (__string_copy_len_seed > 0) { "
		+ "memcpy(__string_copy_dst_seed->data + __string_copy_dst_pos_seed, "
		+ "__string_copy_src_seed->data + __string_copy_src_pos_seed, "
		+ "(size_t)__string_copy_len_seed); } (void)0; })"
	)
	set_len_ok: Bool = render_prepared_string_op(
		SetLen(
			"target",
			"new_len",
		),
	) == "({ blorp_String* __sl = (blorp_String*)target; long __sn = new_len; __sl->len = __sn; __sl->data[__sn] = '\\0'; (void)0; })"
	find_ok and read_ok and write_ok and copy_ok and set_len_ok


func test_render_prepared_string_successes() -> Bool:
	find_ok: Bool = match render_prepared_string(
		"string_find_byte_from",
		["s", "b", "start", "0"],
	):
		Ok(rendered):
			rendered == (
				"({ blorp_String* __string_find_src_0 = (blorp_String*)s; long "
				+ "__string_find_byte_0 = b; long __string_find_start_0 = start; "
				+ "blorp_string_find_byte_from(__string_find_src_0, __string_find_byte_0, "
				+ "__string_find_start_0); })"
			)
		Err(error):
			False

	read_ok: Bool = match render_prepared_string(
		"string_byte_read",
		["s", "i"],
	):
		Ok(rendered):
			rendered == "(long)(unsigned char)((blorp_String*)s)->data[i]"
		Err(error):
			False

	copy_ok: Bool = match render_prepared_string(
		"string_byte_copy",
		["d", "dp", "s", "sp", "n", "0"],
	):
		Ok(rendered):
			rendered == (
				"({ blorp_String* __string_copy_dst_0 = (blorp_String*)d; long "
				+ "__string_copy_dst_pos_0 = dp; blorp_String* __string_copy_src_0 = "
				+ "(blorp_String*)s; long __string_copy_src_pos_0 = sp; long __string_copy_len_0 = "
				+ "n; if (__string_copy_len_0 > 0) { memcpy(__string_copy_dst_0->data + "
				+ "__string_copy_dst_pos_0, __string_copy_src_0->data + __string_copy_src_pos_0, "
				+ "(size_t)__string_copy_len_0); } (void)0; })"
			)
		Err(error):
			False

	set_len_ok: Bool = match render_prepared_string(
		"string_set_len",
		["target", "n"],
	):
		Ok(rendered):
			rendered == "({ blorp_String* __sl = (blorp_String*)target; long __sn = n; __sl->len = __sn; __sl->data[__sn] = '\\0'; (void)0; })"
		Err(error):
			False

	find_ok and read_ok and copy_ok and set_len_ok


func test_render_prepared_string_errors_are_typed() -> Bool:
	wrong_arity_ok: Bool = match render_prepared_string("string_byte_read", ["s"]):
		Ok(rendered):
			False
		Err(error):
			match error:
				WrongArity(info, got):
					(
						prepared_string_template_name(info) == "string_byte_read"
						and prepared_string_template_arity(info) == 2
						and got == 1
					)
				UnsupportedPreparedStringOp(name):
					False

	unsupported_ok: Bool = match render_prepared_string("string_len", ["s"]):
		Ok(rendered):
			False
		Err(error):
			match error:
				WrongArity(info, got):
					False
				UnsupportedPreparedStringOp(name):
					name == "string_len"

	wrong_arity_ok and unsupported_ok


func test_render_error_to_string() -> Bool:
	unsupported_error: RenderError = UnsupportedPreparedStringOp("missing")

	arity_text: String = match render_prepared_string(
		"string_byte_copy",
		["a", "b", "c", "d", "e"],
	):
		Ok(rendered):
			rendered
		Err(error):
			render_error_to_string(error)

	unsupported_text: String = render_error_to_string(unsupported_error)

	(
		arity_text == "prepared string op string_byte_copy expected 6 arg(s), got 5"
		and unsupported_text == "unsupported prepared string op: missing"
	)


func test_render_manifest_lines() -> Bool:
	lines: List[String] = render_manifest_lines()
	count_ok: Bool = lines.length() == ALL_TEMPLATES.length()

	first_ok: Bool = match lines:
		[]:
			False
		[first, ...rest]:
			first == "string_find_byte_from\t4\t({ blorp_String* __string_find_src_@3@ = (blorp_String*)@0@; long __string_find_byte_@3@ = @1@; long __string_find_start_@3@ = @2@; blorp_string_find_byte_from(__string_find_src_@3@, __string_find_byte_@3@, __string_find_start_@3@); })"

	find_ok: Bool = manifest_line_is(
		"string_find_byte_from",
		"string_find_byte_from\t4\t({ blorp_String* __string_find_src_@3@ = (blorp_String*)@0@; long __string_find_byte_@3@ = @1@; long __string_find_start_@3@ = @2@; blorp_string_find_byte_from(__string_find_src_@3@, __string_find_byte_@3@, __string_find_start_@3@); })",
	)
	copy_ok: Bool = manifest_line_is(
		"string_byte_copy",
		"string_byte_copy\t6\t({ blorp_String* __string_copy_dst_@5@ = (blorp_String*)@0@; long __string_copy_dst_pos_@5@ = @1@; blorp_String* __string_copy_src_@5@ = (blorp_String*)@2@; long __string_copy_src_pos_@5@ = @3@; long __string_copy_len_@5@ = @4@; if (__string_copy_len_@5@ > 0) { memcpy(__string_copy_dst_@5@->data + __string_copy_dst_pos_@5@, __string_copy_src_@5@->data + __string_copy_src_pos_@5@, (size_t)__string_copy_len_@5@); } (void)0; })",
	)
	set_len_ok: Bool = manifest_line_is(
		"string_set_len",
		"string_set_len\t2\t({ blorp_String* __sl = (blorp_String*)@0@; long __sn = @1@; __sl->len = __sn; __sl->data[__sn] = '\\0'; (void)0; })",
	)
	count_ok and first_ok and find_ok and copy_ok and set_len_ok


tests: TestSuite = {
	description = "Self-hosted compiler prepared string renderer",
	tests = [
		("parse command routes", test_parse_command_routes),
		("parse template shapes", test_parse_template_shapes),
		("render prepared string op successes", test_render_prepared_string_op_successes),
		("render prepared string successes", test_render_prepared_string_successes),
		("render prepared string errors are typed", test_render_prepared_string_errors_are_typed),
		("render error to string", test_render_error_to_string),
		("render manifest lines", test_render_manifest_lines),
	]
}
