import:
	../src/stage_09_core/ownership:
		BuiltinOwnershipCoverage(CoveredByContract, PrePerceusSentinel),
		OwnershipArgMode(BorrowArg, ConsumeArg, CowConsumeArg, RetainArg, TransferArg),
		OwnershipCallContract,
		OwnershipContractViolation(
			AliasIndexOutOfRange,
			AliasOfConsumedArg,
			BorrowedResultWithoutPreservedArg,
		),
		OwnershipResultMode(
			ReturnAliasOfArg,
			ReturnBorrowed,
			ReturnOwned,
			ReturnPrimitive,
			ReturnVoid,
		),
		arg_allows_borrowed_result_alias,
		arg_consumes_caller,
		arg_mode_to_string,
		arg_preserves_caller,
		builtin_contract,
		builtin_ownership_coverage,
		contract_is_well_formed,
		contract_violation_to_string,
		intrinsic_contract,
		validate_contract,
	test: TestSuite


pure func arg_mode_equal(left: OwnershipArgMode, right: OwnershipArgMode) -> Bool:
	match left:
		BorrowArg:
			match right:
				BorrowArg:
					True
				_:
					False
		RetainArg:
			match right:
				RetainArg:
					True
				_:
					False
		ConsumeArg:
			match right:
				ConsumeArg:
					True
				_:
					False
		CowConsumeArg:
			match right:
				CowConsumeArg:
					True
				_:
					False
		TransferArg:
			match right:
				TransferArg:
					True
				_:
					False


pure func arg_modes_equal(left: List[OwnershipArgMode], right: List[OwnershipArgMode]) -> Bool:
	match left:
		[]:
			match right:
				[]:
					True
				[right_head, ...right_tail]:
					False
		[left_head, ...left_tail]:
			match right:
				[]:
					False
				[right_head, ...right_tail]:
					arg_mode_equal(left_head, right_head) and arg_modes_equal(left_tail, right_tail)


pure func result_mode_equal(left: OwnershipResultMode, right: OwnershipResultMode) -> Bool:
	match left:
		ReturnVoid:
			match right:
				ReturnVoid:
					True
				_:
					False
		ReturnPrimitive:
			match right:
				ReturnPrimitive:
					True
				_:
					False
		ReturnOwned:
			match right:
				ReturnOwned:
					True
				_:
					False
		ReturnBorrowed:
			match right:
				ReturnBorrowed:
					True
				_:
					False
		ReturnAliasOfArg(left_index):
			match right:
				ReturnAliasOfArg(right_index):
					left_index == right_index
				_:
					False


pure func contract_equal(left: OwnershipCallContract, right: OwnershipCallContract) -> Bool:
	arg_modes_equal(left.args, right.args) and result_mode_equal(left.result, right.result)


pure func violation_equal(
	left: OwnershipContractViolation,
	right: OwnershipContractViolation,
) -> Bool:
	match left:
		AliasIndexOutOfRange(left_index, left_arg_count):
			match right:
				AliasIndexOutOfRange(right_index, right_arg_count):
					left_index == right_index and left_arg_count == right_arg_count
				_:
					False
		AliasOfConsumedArg(left_index, left_mode):
			match right:
				AliasOfConsumedArg(right_index, right_mode):
					left_index == right_index and arg_mode_equal(left_mode, right_mode)
				_:
					False
		BorrowedResultWithoutPreservedArg:
			match right:
				BorrowedResultWithoutPreservedArg:
					True
				_:
					False


pure func single_violation_is(
	actual: List[OwnershipContractViolation],
	expected: OwnershipContractViolation,
) -> Bool:
	match actual:
		[only]:
			violation_equal(only, expected)
		[]:
			False
		[first, second, ...rest]:
			False


pure func check_contract(
	actual: Option[OwnershipCallContract],
	expected: OwnershipCallContract,
) -> Bool:
	match actual:
		Some(contract):
			contract_is_well_formed(contract) and contract_equal(contract, expected)
		None:
			False


pure func test_arg_mode_semantics() -> Bool:
	(
		arg_preserves_caller(BorrowArg)
		and arg_preserves_caller(RetainArg)
		and arg_consumes_caller(ConsumeArg)
		and arg_consumes_caller(CowConsumeArg)
		and arg_consumes_caller(TransferArg)
		and arg_allows_borrowed_result_alias(BorrowArg)
		and arg_allows_borrowed_result_alias(RetainArg)
		and not arg_allows_borrowed_result_alias(TransferArg)
		and arg_mode_to_string(CowConsumeArg) == "CowConsume"
	)


pure func test_alias_contract_must_reference_existing_arg() -> Bool:
	contract: OwnershipCallContract = {
		args = [BorrowArg],
		result = ReturnAliasOfArg(1)
	}

	single_violation_is(
		validate_contract(contract),
		AliasIndexOutOfRange(1, 1),
	) and not contract_is_well_formed(contract)


pure func test_alias_contract_must_reference_preserved_arg() -> Bool:
	consume_contract: OwnershipCallContract = {
		args = [ConsumeArg],
		result = ReturnAliasOfArg(0)
	}
	cow_contract: OwnershipCallContract = {
		args = [CowConsumeArg],
		result = ReturnAliasOfArg(0)
	}
	transfer_contract: OwnershipCallContract = {
		args = [TransferArg],
		result = ReturnAliasOfArg(0)
	}

	single_violation_is(
		validate_contract(consume_contract),
		AliasOfConsumedArg(0, ConsumeArg),
	) and single_violation_is(
		validate_contract(cow_contract),
		AliasOfConsumedArg(0, CowConsumeArg),
	) and single_violation_is(
		validate_contract(transfer_contract),
		AliasOfConsumedArg(0, TransferArg),
	)


pure func test_valid_alias_contract_is_well_formed() -> Bool:
	borrowed: OwnershipCallContract = {
		args = [BorrowArg, ConsumeArg],
		result = ReturnAliasOfArg(0)
	}
	retained: OwnershipCallContract = {
		args = [RetainArg],
		result = ReturnAliasOfArg(0)
	}

	contract_is_well_formed(borrowed) and contract_is_well_formed(retained)


pure func test_borrowed_result_must_have_preserved_anchor() -> Bool:
	invalid: OwnershipCallContract = {
		args = [ConsumeArg, TransferArg],
		result = ReturnBorrowed
	}
	valid: OwnershipCallContract = {
		args = [ConsumeArg, BorrowArg],
		result = ReturnBorrowed
	}

	(
		single_violation_is(validate_contract(invalid), BorrowedResultWithoutPreservedArg)
		and contract_is_well_formed(valid)
	)


pure func test_violation_strings_are_stable() -> Bool:
	(
		contract_violation_to_string(
			AliasIndexOutOfRange(
				1,
				1,
			),
		) == "ReturnAliasOfArg 1 is outside the contract arity 1"
		and contract_violation_to_string(
			AliasOfConsumedArg(
				0,
				TransferArg,
			),
		) == "ReturnAliasOfArg 0 points at Transfer, which does not preserve caller ownership"
		and contract_violation_to_string(
			BorrowedResultWithoutPreservedArg,
		) == "ReturnBorrowed has no Borrow/Retain argument to anchor its lifetime"
	)


pure func test_list_intrinsic_contracts() -> Bool:
	check_contract(
		intrinsic_contract("math_round", 1),
		{
			args = [BorrowArg],
			result = ReturnPrimitive
		},
	) and check_contract(
		intrinsic_contract("list_len", 1),
		{
			args = [BorrowArg],
			result = ReturnPrimitive
		},
	) and check_contract(
		intrinsic_contract("list_get", 2),
		{
			args = [BorrowArg, BorrowArg],
			result = ReturnAliasOfArg(0)
		},
	) and check_contract(
		intrinsic_contract("list_ensure_capacity", 2),
		{
			args = [CowConsumeArg, BorrowArg],
			result = ReturnOwned
		},
	) and check_contract(
		intrinsic_contract("list_reuse_alloc", 2),
		{
			args = [CowConsumeArg, BorrowArg],
			result = ReturnOwned
		},
	)


pure func test_collection_intrinsic_transfer_contracts() -> Bool:
	check_contract(
		intrinsic_contract("dict_set_key_at", 3),
		{
			args = [BorrowArg, BorrowArg, TransferArg],
			result = ReturnVoid
		},
	) and check_contract(
		intrinsic_contract("dict_retain_value_for", 2),
		{
			args = [BorrowArg, RetainArg],
			result = ReturnVoid
		},
	) and check_contract(
		intrinsic_contract("set_reuse_alloc", 2),
		{
			args = [CowConsumeArg, BorrowArg],
			result = ReturnOwned
		},
	) and check_contract(
		intrinsic_contract("set_alloc_entry", 1),
		{
			args = [TransferArg],
			result = ReturnOwned
		},
	)


pure func test_structural_intrinsic_contract_families() -> Bool:
	check_contract(
		intrinsic_contract("list_copy_span_uninit", 5),
		{
			args = [BorrowArg, BorrowArg, BorrowArg, BorrowArg, BorrowArg],
			result = ReturnVoid
		},
	) and check_contract(
		intrinsic_contract("dict_key_at", 2),
		{
			args = [BorrowArg, BorrowArg],
			result = ReturnAliasOfArg(0)
		},
	) and check_contract(
		intrinsic_contract("set_free_entry", 2),
		{
			args = [BorrowArg, TransferArg],
			result = ReturnVoid
		},
	) and check_contract(
		intrinsic_contract("slice_source", 1),
		{
			args = [BorrowArg],
			result = ReturnAliasOfArg(0)
		},
	) and check_contract(
		intrinsic_contract("tensor_get_unchecked", 2),
		{
			args = [BorrowArg, BorrowArg],
			result = ReturnAliasOfArg(0)
		},
	) and check_contract(
		intrinsic_contract("bytes_cow", 1),
		{
			args = [CowConsumeArg],
			result = ReturnOwned
		},
	)


pure func test_scalar_intrinsic_contract_families() -> Bool:
	check_contract(
		intrinsic_contract("math_infinity", 0),
		{
			args = [],
			result = ReturnPrimitive
		},
	) and check_contract(
		intrinsic_contract("math_log1p", 1),
		{
			args = [BorrowArg],
			result = ReturnPrimitive
		},
	) and check_contract(
		intrinsic_contract("bit_xor", 2),
		{
			args = [BorrowArg, BorrowArg],
			result = ReturnPrimitive
		},
	) and check_contract(
		intrinsic_contract("math_fma", 3),
		{
			args = [BorrowArg, BorrowArg, BorrowArg],
			result = ReturnPrimitive
		},
	) and intrinsic_contract("math_fma", 2) == None


pure func test_runtime_builtin_contracts() -> Bool:
	check_contract(
		builtin_contract("blorp_list_append_owned", 2),
		{
			args = [CowConsumeArg, TransferArg],
			result = ReturnOwned
		},
	) and check_contract(
		builtin_contract("blorp_list_append", 2),
		{
			args = [CowConsumeArg, RetainArg],
			result = ReturnOwned
		},
	) and check_contract(
		builtin_contract("blorp_channel_send_timeout_status", 3),
		{
			args = [BorrowArg, RetainArg, BorrowArg],
			result = ReturnPrimitive
		},
	) and check_contract(
		builtin_contract("blorp_channel_send_timeout_attempt", 3),
		{
			args = [BorrowArg, RetainArg, BorrowArg],
			result = ReturnOwned
		},
	)


pure func test_extended_runtime_builtin_contracts() -> Bool:
	check_contract(
		builtin_contract("blorp_read_file", 1),
		{
			args = [BorrowArg],
			result = ReturnOwned
		},
	) and check_contract(
		builtin_contract("blorp_now_us", 0),
		{
			args = [],
			result = ReturnPrimitive
		},
	) and check_contract(
		builtin_contract("blorp_signal_on", 2),
		{
			args = [BorrowArg, RetainArg],
			result = ReturnVoid
		},
	) and check_contract(
		builtin_contract("blorp_process_run_command_raw", 3),
		{
			args = [BorrowArg, BorrowArg, BorrowArg],
			result = ReturnOwned
		},
	) and check_contract(
		builtin_contract("blorp_file_create_directories_raw", 1),
		{
			args = [BorrowArg],
			result = ReturnOwned
		},
	) and check_contract(
		builtin_contract("blorp_file_rename_path_raw", 2),
		{
			args = [BorrowArg, BorrowArg],
			result = ReturnOwned
		},
	) and check_contract(
		builtin_contract("blorp_file_write_text_atomic_raw", 3),
		{
			args = [BorrowArg, BorrowArg, BorrowArg],
			result = ReturnOwned
		},
	) and check_contract(
		builtin_contract("blorp_file_remove_directory_tree_raw", 1),
		{
			args = [BorrowArg],
			result = ReturnOwned
		},
	) and check_contract(
		builtin_contract("blorp_compiler_runtime_source", 0),
		{
			args = [],
			result = ReturnOwned
		},
	) and check_contract(
		builtin_contract("blorp_compiler_runtime_decl", 0),
		{
			args = [],
			result = ReturnOwned
		},
	) and check_contract(
		builtin_contract("blorp_dict_insert", 3),
		{
			args = [CowConsumeArg, RetainArg, RetainArg],
			result = ReturnOwned
		},
	) and check_contract(
		builtin_contract("blorp_checked_get", 2),
		{
			args = [BorrowArg, BorrowArg],
			result = ReturnAliasOfArg(0)
		},
	) and check_contract(
		builtin_contract("blorp_tcp_accept_raw", 1),
		{
			args = [BorrowArg],
			result = ReturnOwned
		},
	) and check_contract(
		builtin_contract("blorp_fallible_stream_fold_raw", 4),
		{
			args = [BorrowArg, ConsumeArg, BorrowArg, BorrowArg],
			result = ReturnOwned
		},
	)


pure func test_polymorphic_builtin_contracts() -> Bool:
	check_contract(
		builtin_contract("blorp_map_parallel", 2),
		{
			args = [BorrowArg, BorrowArg],
			result = ReturnOwned
		},
	) and check_contract(
		builtin_contract("blorp_map_parallel", 3),
		{
			args = [BorrowArg, BorrowArg, BorrowArg],
			result = ReturnOwned
		},
	) and builtin_contract("blorp_map_parallel", 4) == None and check_contract(
		builtin_contract("blorp_fold_parallel", 3),
		{
			args = [BorrowArg, ConsumeArg, BorrowArg],
			result = ReturnOwned
		},
	) and check_contract(
		builtin_contract("blorp_fold_parallel", 4),
		{
			args = [BorrowArg, ConsumeArg, BorrowArg, BorrowArg],
			result = ReturnOwned
		},
	) and check_contract(
		builtin_contract("blorp_vector_to_string_Color", 1),
		{
			args = [BorrowArg],
			result = ReturnOwned
		},
	) and check_contract(
		builtin_contract("blorp_channel_recv_int32", 1),
		{
			args = [BorrowArg],
			result = ReturnPrimitive
		},
	) and check_contract(
		builtin_contract("blorp_channel_recv_timeout_f32", 2),
		{
			args = [BorrowArg, BorrowArg],
			result = ReturnPrimitive
		},
	)


pure func test_builtin_ownership_coverage_distinguishes_sentinels() -> Bool:
	covered: Bool = match builtin_ownership_coverage("blorp_read_file", 1):
		Some(CoveredByContract):
			True
		_:
			False

	sentinel: Bool = match builtin_ownership_coverage("blorp_eq_dispatch", 2):
		Some(PrePerceusSentinel(reason)):
			reason.contains("specialized before Perceus")
		_:
			False

	covered and sentinel and builtin_ownership_coverage("not_a_builtin", 0) == None


pure func test_process_session_operation_contracts() -> Bool:
	borrow_one_owned: OwnershipCallContract = {
		args = [BorrowArg],
		result = ReturnOwned
	}

	check_contract(
		builtin_contract("blorp_process_session_start_raw", 1),
		borrow_one_owned,
	) and check_contract(
		builtin_contract("blorp_process_session_state_raw", 1),
		borrow_one_owned,
	) and check_contract(
		builtin_contract("blorp_process_session_close_stdin_raw", 1),
		borrow_one_owned,
	) and check_contract(
		builtin_contract("blorp_process_session_terminate_raw", 1),
		borrow_one_owned,
	) and check_contract(
		builtin_contract("blorp_process_session_kill_raw", 1),
		borrow_one_owned,
	) and check_contract(
		builtin_contract("blorp_process_session_write_raw", 2),
		{
			args = [BorrowArg, BorrowArg],
			result = ReturnOwned
		},
	) and check_contract(
		builtin_contract("blorp_process_session_write_from_raw", 3),
		{
			args = [BorrowArg, BorrowArg, BorrowArg],
			result = ReturnOwned
		},
	) and check_contract(
		builtin_contract("blorp_process_session_poll_raw", 3),
		{
			args = [BorrowArg, BorrowArg, BorrowArg],
			result = ReturnOwned
		},
	)


pure func test_finalizers_consume_handles() -> Bool:
	check_contract(
		builtin_contract("blorp_file_close_reader", 1),
		{
			args = [ConsumeArg],
			result = ReturnVoid
		},
	) and check_contract(
		builtin_contract("blorp_tcp_close_stream", 1),
		{
			args = [ConsumeArg],
			result = ReturnVoid
		},
	) and check_contract(
		builtin_contract("blorp_tls_close_session", 1),
		{
			args = [ConsumeArg],
			result = ReturnVoid
		},
	) and check_contract(
		builtin_contract("blorp_udp_close_socket", 1),
		{
			args = [ConsumeArg],
			result = ReturnVoid
		},
	) and check_contract(
		builtin_contract("blorp_process_session_close", 1),
		{
			args = [ConsumeArg],
			result = ReturnVoid
		},
	)


pure func test_variadic_string_concat_contract() -> Bool:
	check_contract(
		builtin_contract("blorp_string_concat_many", 4),
		{
			args = [BorrowArg, ConsumeArg, ConsumeArg, ConsumeArg],
			result = ReturnOwned
		},
	) and builtin_contract("blorp_string_concat_many", 0) == None


tests: TestSuite = {
	description = "Blorp compiler Core ownership contracts",
	tests = [
		("arg mode semantics", test_arg_mode_semantics),
		(
			"alias contract must reference existing arg",
			test_alias_contract_must_reference_existing_arg,
		),
		(
			"alias contract must reference preserved arg",
			test_alias_contract_must_reference_preserved_arg,
		),
		("valid alias contract is well formed", test_valid_alias_contract_is_well_formed),
		(
			"borrowed result must have preserved anchor",
			test_borrowed_result_must_have_preserved_anchor,
		),
		("ownership violation diagnostic strings remain stable", test_violation_strings_are_stable),
		("list intrinsic contracts", test_list_intrinsic_contracts),
		("collection intrinsic transfer contracts", test_collection_intrinsic_transfer_contracts),
		("structural intrinsic contract families", test_structural_intrinsic_contract_families),
		("scalar intrinsic contract families", test_scalar_intrinsic_contract_families),
		("runtime builtin contracts", test_runtime_builtin_contracts),
		("extended runtime builtin contracts", test_extended_runtime_builtin_contracts),
		("polymorphic builtin contracts", test_polymorphic_builtin_contracts),
		(
			"builtin ownership coverage distinguishes sentinels",
			test_builtin_ownership_coverage_distinguishes_sentinels,
		),
		("process-session operation contracts", test_process_session_operation_contracts),
		("finalizers consume handles", test_finalizers_consume_handles),
		("variadic string concat contract", test_variadic_string_concat_contract),
	]
}
