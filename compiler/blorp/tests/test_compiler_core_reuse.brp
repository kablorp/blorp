	test: TestSuite


pure func named_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


pure func unique_var(name: String, uniq: Int) -> CoreVar:
	{
		name = name,
		uniq = uniq,
		def_id = None
	}


pure func expr_type() -> CoreType:
	UnionType("Expr")


pure func int_type() -> CoreType:
	NamedType("Int", [])


pure func string_type() -> CoreType:
	NamedType("String", [])


pure func list_int_type() -> CoreType:
	NamedType("List", [int_type()])


pure func set_int_type() -> CoreType:
	NamedType("Set", [int_type()])


pure func dict_int_string_type() -> CoreType:
	NamedType(
		"Dict",
		[int_type(), string_type()],
	)


pure func heap_record_type(name: String) -> CoreType:
	HeapRecordType(name)


pure func int_expr(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), int_type(), SyntheticSourceLoc)


pure func bool_expr(value: Bool) -> CoreExpr:
	LiteralExpr(
		BoolLiteral(value),
		NamedType("Bool", []),
		SyntheticSourceLoc,
	)


pure func range_loop_binder() -> CoreLoopBinder:
	{
		variable = named_var("index"),
		typ = int_type(),
		range_direction = RangeForwardOnly
	}


pure func expr_union_field() -> CoreUnionField:
	{
		typ = expr_type(),
		release_policy = ArcReleasePolicy
	}


pure func expr_union_decl() -> CoreUnionDecl:
	{
		abi_type = None,
		name = "Expr",
		type_params = [],
		payload_storage = ErasedUnionPayloadStorage,
		variants = [
			{
				name = "Add",
				c_name = "Expr_Add",
				tag_c_name = "BLORP_TAG_EXPR_ADD",
				tag = 1,
				fields = [expr_union_field(), expr_union_field()],
				def_id = None
			},
			{
				name = "Num",
				c_name = "Expr_Num",
				tag_c_name = "BLORP_TAG_EXPR_NUM",
				tag = 2,
				fields = [],
				def_id = None
			},
		],
		loc = SyntheticSourceLoc
	}


pure func decls() -> List[CoreDecl]:
	[UnionDecl(expr_union_decl())]


pure func expr_var() -> CoreVar:
	named_var("expr")


pure func result_var() -> CoreVar:
	named_var("result")


pure func left_var() -> CoreVar:
	unique_var("left", 1)


pure func right_var() -> CoreVar:
	unique_var("right", 2)


pure func expr_var_expr(variable: CoreVar) -> CoreExpr:
	VarExpr(variable, expr_type(), SyntheticSourceLoc)


pure func pointer_box(value: CoreExpr) -> CoreBoxedStorageValue:
	{
		kind = PointerBox,
		value = value,
		needs_release = True,
		transfers_ownership = True
	}


pure func add_construct(args: List[CoreBoxedStorageValue]) -> CoreExpr:
	UnionConstructExpr(
		{
			type_name = "Expr",
			constructor_name = "Add",
			constructor_c_name = "Expr_Add",
			representation = GenericUnionRepresentation,
			payload_storage = ErasedUnionPayloadStorage,
			uses_release_mask = True,
			release_mask = 3,
			args = args
		},
		expr_type(),
		SyntheticSourceLoc,
	)


pure func add_construct_from_fields() -> CoreExpr:
	add_construct([
		pointer_box(expr_var_expr(left_var())),
		pointer_box(expr_var_expr(right_var())),
	])


pure func field_binding(
	variable: CoreVar,
	field_index: Int,
	mode: CoreMatchBindingMode,
) -> CoreMatchBinding:
	{
		variable = variable,
		typ = expr_type(),
		accessor = VariantFieldAccessor(RootAccessor, "Expr", "Add", field_index),
		mode = mode
	}


pure func owned_add_bindings() -> List[CoreMatchBinding]:
	[
		field_binding(left_var(), 0, MatchOwnBindingMode),
		field_binding(right_var(), 1, MatchOwnBindingMode),
	]


pure func borrowed_add_bindings() -> List[CoreMatchBinding]:
	[
		field_binding(left_var(), 0, MatchBorrowBindingMode),
		field_binding(right_var(), 1, MatchBorrowBindingMode),
	]


pure func add_case(bindings: List[CoreMatchBinding], body: CoreExpr) -> CoreConstructorMatchCase:
	{
		constructor = "Add",
		accessor = RootAccessor,
		test = UnionTagConstructorTest("Expr", "Add"),
		bindings = bindings,
		body = ConstructorMatchBodyExpr(body)
	}


pure func prepared_match(bindings: List[CoreMatchBinding], body: CoreExpr) -> CoreExpr:
	ConstructorMatchExpr(
		expr_var_expr(expr_var()),
		ArcReleasePolicy,
		[add_case(bindings, body)],
		ConstructorMatchFallbackFail,
		expr_type(),
		SyntheticSourceLoc,
	)


pure func prepared_let_drop(bindings: List[CoreMatchBinding], body: CoreExpr) -> CoreExpr:
	LetExpr(
		result_var(),
		False,
		expr_type(),
		prepared_match(bindings, body),
		DropExpr(
			expr_var(),
			expr_type(),
			ArcReleasePolicy,
			expr_var_expr(result_var()),
			expr_type(),
			SyntheticSourceLoc,
		),
	)


pure func rewrite_expr(expr: CoreExpr) -> CoreExpr:
	rewrite_prepared_expr(decls(), expr)


pure func list_var_expr(variable: CoreVar) -> CoreExpr:
	VarExpr(variable, list_int_type(), SyntheticSourceLoc)


pure func list_alloc_expr(capacity: Int) -> CoreExpr:
	ListAllocExpr(
		{
			layout = InlineListStorage(8),
			capacity = int_expr(capacity),
			elem_needs_release = False
		},
		list_int_type(),
		SyntheticSourceLoc,
	)


pure func set_alloc_expr() -> CoreExpr:
	SetAllocExpr(GenericHashContainerConstructor, set_int_type(), SyntheticSourceLoc)


pure func dict_construct_expr() -> CoreExpr:
	DictConstructExpr(
		{
			constructor = GenericHashContainerConstructor,
			entries = [],
			value_needs_release = True
		},
		dict_int_string_type(),
		SyntheticSourceLoc,
	)


pure func dropped_allocation_expr(
	dropped_var: CoreVar,
	result_var: CoreVar,
	typ: CoreType,
	allocation: CoreExpr,
) -> CoreExpr:
	DropExpr(
		dropped_var,
		typ,
		ArcReleasePolicy,
		LetExpr(
			result_var,
			False,
			typ,
			allocation,
			VarExpr(result_var, typ, SyntheticSourceLoc),
		),
		typ,
		SyntheticSourceLoc,
	)


pure func list_handoff_expr_with_body(
	source_var: CoreVar,
	result_var: CoreVar,
	body: CoreExpr,
) -> CoreExpr:
	ListHandoffExpr(
		{
			mode = BorrowFreshHandoff,
			layout = InlineListStorage(8),
			elem_needs_release = False,
			source = list_var_expr(source_var),
			source_var = unique_var("__lh_source", 20),
			source_type = list_int_type(),
			result_type = list_int_type(),
			capacity = int_expr(4),
			result_var = result_var,
			len_var = unique_var("__lh_len", 21),
			out_var = unique_var("__lh_out", 22),
			body = body,
			write_order = ForwardCompactingHandoff
		},
		list_int_type(),
		SyntheticSourceLoc,
	)


pure func list_handoff_expr(source_var: CoreVar, result_var: CoreVar) -> CoreExpr:
	list_handoff_expr_with_body(
		source_var,
		result_var,
		VoidExpr(VoidType, SyntheticSourceLoc),
	)


pure func dropped_handoff_expr() -> CoreExpr:
	source_var: CoreVar = named_var("xs")
	handoff_result_var: CoreVar = named_var("__cdrop_xs")

	LetExpr(
		handoff_result_var,
		False,
		list_int_type(),
		list_handoff_expr(source_var, handoff_result_var),
		DropExpr(
			source_var,
			list_int_type(),
			ArcReleasePolicy,
			list_var_expr(handoff_result_var),
			list_int_type(),
			SyntheticSourceLoc,
		),
	)


pure func record_fields(value: CoreExpr) -> List[CoreRecordFieldValue]:
	[
		{
			name = "value",
			value = value
		},
	]


pure func dropped_record_result_expr(
	source_var: CoreVar,
	result_var: CoreVar,
	source_type: CoreType,
	result_type: CoreType,
	release_policy: CoreReleasePolicy,
	fields: List[CoreRecordFieldValue],
) -> CoreExpr:
	LetExpr(
		result_var,
		False,
		result_type,
		RecordExpr(fields, result_type, SyntheticSourceLoc),
		DropExpr(
			source_var,
			source_type,
			release_policy,
			VarExpr(result_var, result_type, SyntheticSourceLoc),
			result_type,
			SyntheticSourceLoc,
		),
	)


pure func top_record_reuse_source(expr: CoreExpr) -> Option[CoreVar]:
	match expr:
		RecordReuseExpr(source, fields, typ, loc):
			match source:
				VarExpr(variable, source_type, source_loc):
					Some(variable)
				_:
					None
		_:
			None


pure func intrinsic_name_from_kind(kind: CoreCallKind) -> Option[String]:
	match kind:
		IntrinsicCall(name):
			Some(name)
		BuiltinCall(name):
			None
		UserCall(name, def_id, captured_def_ids):
			None
		ForeignCall(name, arg_passing):
			None
		DirectRuntimeCall(call):
			None
		OperationResultCall(call):
			None
		FallibleStreamTerminalCall(call):
			None
		TensorParallelCall(name, layout):
			None
		DictWithCapacityCall(constructor):
			None
		ListToStringCall(name):
			None
		ClosureCall:
			None
		UnknownCall:
			None
		SelectedDirectCall(def_id):
			None
		_:
			None


