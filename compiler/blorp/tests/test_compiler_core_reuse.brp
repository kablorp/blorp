import:
	../compiler_core_json:
		CoreAccessor(RootAccessor, VariantFieldAccessor),
		CoreBoxKind(PointerBox),
		CoreBoxedStorageValue,
		CoreConstructorMatchBody(
			ConstructorMatchBodyExpr,
			ConstructorMatchBodyLength,
			ConstructorMatchBodyLiteral,
		),
		CoreConstructorMatchCase,
		CoreConstructorMatchFallback(ConstructorMatchFallbackFail),
		CoreConstructorMatchTest(UnionTagConstructorTest),
		CoreDecl(UnionDecl),
		CoreExpr(
			AccessorLiteralMatchExpr,
			AssignExpr,
			BinaryExpr,
			BorrowLetExpr,
			BoxExpr,
			BreakExpr,
			CastExpr,
			CallExpr,
			ClosureCreateExpr,
			ConcurrentExpr,
			ConcurrentlyLoopExpr,
			ConstructorMatchExpr,
			ContinueExpr,
			CooperativeCheckpointExpr,
			DetachExpr,
			DictConstructExpr,
			DropExpr,
			DupExpr,
			FieldExpr,
			ForChannelExpr,
			ForDictExpr,
			ForListExpr,
			ForRangeExpr,
			ForResourceSourceExpr,
			ForSetExpr,
			ForStreamExpr,
			ForStringExpr,
			ForTensorExpr,
			IfExpr,
			LengthMatchExpr,
			LetExpr,
			ListAllocExpr,
			ListConstructExpr,
			ListGetExpr,
			ListHandoffExpr,
			ListHandoffSetOwnedExpr,
			ListHandoffSetSourceSlotExpr,
			ListRetainExpr,
			ListSetExpr,
			ListSwapExpr,
			LiteralExpr,
			LiteralMatchExpr,
			LogicalExpr,
			RangeExpr,
			RecordConstructExpr,
			RecordExpr,
			ResourceCleanupExitExpr,
			ResourceScopeExpr,
			SelectExpr,
			SeqExpr,
			SetAllocExpr,
			StringByteCopyExpr,
			StringByteReadExpr,
			StringByteWriteExpr,
			StringSetLenExpr,
			TailrecListSpreadLoopExpr,
			TailrecListSpreadRecurExpr,
			TailrecLoopExpr,
			TailrecRecurExpr,
			TensorBoxedLiteralExpr,
			TensorLiteralExpr,
			TensorPackedLiteralExpr,
			TensorRawFillExpr,
			TensorRawReadExpr,
			TensorRawViewLetExpr,
			TensorRawWriteExpr,
			TupleConstructExpr,
			TupleExpr,
			TupleFieldExpr,
			UnaryExpr,
			UnionConstructExpr,
			UnionReuseConstructExpr,
			UnboxExpr,
			VarExpr,
			VoidExpr,
			WhileExpr,
		),
		CoreMatchBinding,
		CoreMatchBindingMode(MatchBorrowBindingMode, MatchOwnBindingMode),
		CoreReleasePolicy(ArcReleasePolicy),
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType, UnionType),
		CoreUnionDecl,
		CoreUnionField,
		CoreUnionPayloadStorage(ErasedUnionPayloadStorage),
		CoreUnionRepresentation(GenericUnionRepresentation),
		CoreVar,
	../compiler_core_reuse: rewrite_prepared_expr
	test: TestSuite


pure func named_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


pure func unique_var(name: String, uniq: Int) -> CoreVar:
	{
		name = name,
		uniq = uniq,
		def_id = None
	}


pure func expr_type() -> CoreType:
	UnionType("Expr")


pure func int_type() -> CoreType:
	NamedType("Int", [])


pure func expr_union_field() -> CoreUnionField:
	{
		typ = expr_type(),
		release_policy = ArcReleasePolicy
	}


pure func expr_union_decl() -> CoreUnionDecl:
	{
		name = "Expr",
		payload_storage = ErasedUnionPayloadStorage,
		variants = [
			{
				name = "Add",
				c_name = "Expr_Add",
				tag_c_name = "BLORP_TAG_EXPR_ADD",
				tag = 1,
				fields = [expr_union_field(), expr_union_field()],
				def_id = None
			},
			{
				name = "Num",
				c_name = "Expr_Num",
				tag_c_name = "BLORP_TAG_EXPR_NUM",
				tag = 2,
				fields = [],
				def_id = None
			},
		],
		loc = SyntheticSourceLoc
	}


pure func decls() -> List[CoreDecl]:
	[UnionDecl(expr_union_decl())]


pure func expr_var() -> CoreVar:
	named_var("expr")


pure func result_var() -> CoreVar:
	named_var("result")


pure func left_var() -> CoreVar:
	unique_var("left", 1)


pure func right_var() -> CoreVar:
	unique_var("right", 2)


pure func expr_var_expr(variable: CoreVar) -> CoreExpr:
	VarExpr(variable, expr_type(), SyntheticSourceLoc)


pure func pointer_box(value: CoreExpr) -> CoreBoxedStorageValue:
	{
		kind = PointerBox,
		value = value,
		needs_release = True,
		transfers_ownership = True
	}


pure func add_construct(args: List[CoreBoxedStorageValue]) -> CoreExpr:
	UnionConstructExpr(
		{
			type_name = "Expr",
			constructor_name = "Add",
			constructor_c_name = "Expr_Add",
			representation = GenericUnionRepresentation,
			payload_storage = ErasedUnionPayloadStorage,
			uses_release_mask = True,
			release_mask = 3,
			args = args
		},
		expr_type(),
		SyntheticSourceLoc,
	)


pure func add_construct_from_fields() -> CoreExpr:
	add_construct([
		pointer_box(expr_var_expr(left_var())),
		pointer_box(expr_var_expr(right_var())),
	])


pure func field_binding(
	variable: CoreVar,
	field_index: Int,
	mode: CoreMatchBindingMode,
) -> CoreMatchBinding:
	{
		variable = variable,
		typ = expr_type(),
		accessor = VariantFieldAccessor(RootAccessor, "Expr", "Add", field_index),
		mode = mode
	}


pure func owned_add_bindings() -> List[CoreMatchBinding]:
	[
		field_binding(left_var(), 0, MatchOwnBindingMode),
		field_binding(right_var(), 1, MatchOwnBindingMode),
	]


pure func borrowed_add_bindings() -> List[CoreMatchBinding]:
	[
		field_binding(left_var(), 0, MatchBorrowBindingMode),
		field_binding(right_var(), 1, MatchBorrowBindingMode),
	]


pure func add_case(bindings: List[CoreMatchBinding], body: CoreExpr) -> CoreConstructorMatchCase:
	{
		constructor = "Add",
		accessor = RootAccessor,
		test = UnionTagConstructorTest("Expr", "Add"),
		bindings = bindings,
		body = ConstructorMatchBodyExpr(body)
	}


pure func prepared_match(bindings: List[CoreMatchBinding], body: CoreExpr) -> CoreExpr:
	ConstructorMatchExpr(
		expr_var_expr(expr_var()),
		ArcReleasePolicy,
		[add_case(bindings, body)],
		ConstructorMatchFallbackFail,
		expr_type(),
		SyntheticSourceLoc,
	)


pure func prepared_let_drop(bindings: List[CoreMatchBinding], body: CoreExpr) -> CoreExpr:
	LetExpr(
		result_var(),
		False,
		expr_type(),
		prepared_match(bindings, body),
		DropExpr(
			expr_var(),
			expr_type(),
			ArcReleasePolicy,
			expr_var_expr(result_var()),
			expr_type(),
			SyntheticSourceLoc,
		),
	)


pure func rewrite_expr(expr: CoreExpr) -> CoreExpr:
	rewrite_prepared_expr(decls(), expr)


pure func count_reuse_in_body(body: CoreConstructorMatchBody) -> Int:
	match body:
		ConstructorMatchBodyExpr(expr):
			count_reuse(expr)
		ConstructorMatchBodyLiteral(match_expr):
			0
		ConstructorMatchBodyLength(match_expr):
			0


pure func count_reuse_in_cases(cases: List[CoreConstructorMatchCase]) -> Int:
	var count: Int = 0

	for match_case in cases:
		count += count_reuse_in_body(match_case.body)

	count


pure func count_reuse_in_exprs(exprs: List[CoreExpr]) -> Int:
	var count: Int = 0

	for expr in exprs:
		count += count_reuse(expr)

	count


pure func count_reuse(expr: CoreExpr) -> Int:
	match expr:
		UnionReuseConstructExpr(construct, typ, loc):
			1
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			count_reuse(scrutinee) + count_reuse_in_cases(cases)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			count_reuse(cond) + count_reuse(then_expr) + count_reuse(else_expr)
		LetExpr(variable, is_mutable, value_type, rhs, body):
			count_reuse(rhs) + count_reuse(body)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			count_reuse(body)
		BorrowLetExpr(variable, value_type, rhs, body):
			count_reuse(rhs) + count_reuse(body)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			count_reuse(body)
		SeqExpr(first, second):
			count_reuse(first) + count_reuse(second)
		CallExpr(kind, callee, args, typ, loc):
			count_reuse(callee) + count_reuse_in_exprs(args)
		BinaryExpr(op, left, right, typ, loc):
			count_reuse(left) + count_reuse(right)
		UnaryExpr(op, inner, typ, loc):
			count_reuse(inner)
		LogicalExpr(op, left, right, typ, loc):
			count_reuse(left) + count_reuse(right)
		AssignExpr(variable, rhs, typ, loc):
			count_reuse(rhs)
		CastExpr(inner, typ, loc):
			count_reuse(inner)
		UnboxExpr(unbox_kind, inner, typ, loc):
			count_reuse(inner)
		FieldExpr(inner, field, typ, loc):
			count_reuse(inner)
		TupleFieldExpr(inner, index, typ, loc):
			count_reuse(inner)
		TupleExpr(items, typ, loc):
			count_reuse_in_exprs(items)
		TensorRawViewLetExpr(binding, body, typ, loc):
			count_reuse(body)
		WhileExpr(cond, body, typ, loc):
			count_reuse(cond) + count_reuse(body)
		TailrecLoopExpr(params, return_type, body, loc):
			count_reuse(body)
		TailrecRecurExpr(args, typ, loc):
			count_reuse_in_exprs(args)
		TailrecListSpreadRecurExpr(rebinds, spread_index, typ, loc):
			0
		ForRangeExpr(binder, start, end, step, typ, loc):
			count_reuse(start) + count_reuse(end) + count_reuse(step)
		RangeExpr(start, end, typ, loc):
			count_reuse(start) + count_reuse(end)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			count_reuse(scrutinee)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			count_reuse(scrutinee)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			count_reuse(scrutinee)
		UnionConstructExpr(construct, typ, loc):
			0
		VarExpr(variable, typ, loc):
			0
		LiteralExpr(literal, typ, loc):
			0
		VoidExpr(typ, loc):
			0
		CooperativeCheckpointExpr(typ, loc):
			0
		BoxExpr(box, typ, loc):
			0
		TupleConstructExpr(construct, typ, loc):
			0
		ClosureCreateExpr(closure, typ, loc):
			0
		ListConstructExpr(construct, typ, loc):
			0
		ListAllocExpr(alloc, typ, loc):
			0
		ListGetExpr(get, typ, loc):
			0
		ListHandoffExpr(handoff, typ, loc):
			0
		ListHandoffSetOwnedExpr(set, typ, loc):
			0
		ListHandoffSetSourceSlotExpr(set, typ, loc):
			0
		StringByteReadExpr(read, typ, loc):
			0
		StringByteWriteExpr(write, typ, loc):
			0
		StringByteCopyExpr(copy, typ, loc):
			0
		StringSetLenExpr(set_len, typ, loc):
			0
		TensorLiteralExpr(literal, typ, loc):
			0
		TensorBoxedLiteralExpr(literal, typ, loc):
			0
		TensorPackedLiteralExpr(literal, typ, loc):
			0
		TensorRawFillExpr(fill, typ, loc):
			0
		TensorRawReadExpr(read, typ, loc):
			0
		TensorRawWriteExpr(write, typ, loc):
			0
		DictConstructExpr(construct, typ, loc):
			0
		SetAllocExpr(alloc, typ, loc):
			0
		ListRetainExpr(retain, typ, loc):
			0
		ListSetExpr(set, typ, loc):
			0
		ListSwapExpr(swap, typ, loc):
			0
		RecordExpr(fields, typ, loc):
			0
		RecordConstructExpr(type_name, fields, typ, loc):
			0
		DetachExpr(detached, typ, loc):
			0
		BreakExpr(typ, loc):
			0
		ContinueExpr(typ, loc):
			0
		ResourceScopeExpr(scope, typ, loc):
			0
		ResourceCleanupExitExpr(exit, typ, loc):
			0
		TailrecListSpreadLoopExpr(loop, loc):
			0
		ForChannelExpr(loop, typ, loc):
			0
		ForListExpr(loop, typ, loc):
			0
		ForStringExpr(loop, typ, loc):
			0
		ForDictExpr(loop, typ, loc):
			0
		ForSetExpr(loop, typ, loc):
			0
		ForStreamExpr(loop, typ, loc):
			0
		ForResourceSourceExpr(loop, typ, loc):
			0
		ForTensorExpr(loop, typ, loc):
			0
		ConcurrentlyLoopExpr(loop, typ, loc):
			0
		ConcurrentExpr(block, typ, loc):
			0
		SelectExpr(selection, typ, loc):
			0


pure func test_rewrites_owned_union_match_result() -> Bool:
	rewritten: CoreExpr = rewrite_expr(
		prepared_let_drop(
			owned_add_bindings(),
			add_construct_from_fields(),
		),
	)

	count_reuse(rewritten) == 1


pure func test_rejects_borrowed_union_match_fields() -> Bool:
	rewritten: CoreExpr = rewrite_expr(
		prepared_let_drop(
			borrowed_add_bindings(),
			add_construct_from_fields(),
		),
	)

	count_reuse(rewritten) == 0


pure func test_reuses_all_if_branches() -> Bool:
	body: CoreExpr = IfExpr(
		VarExpr(
			unique_var("cond", 3),
			int_type(),
			SyntheticSourceLoc,
		),
		add_construct_from_fields(),
		add_construct_from_fields(),
		expr_type(),
		SyntheticSourceLoc,
	)
	rewritten: CoreExpr = rewrite_expr(prepared_let_drop(owned_add_bindings(), body))

	count_reuse(rewritten) == 2


pure func test_rejects_partial_if_branch() -> Bool:
	body: CoreExpr = IfExpr(
		VarExpr(
			unique_var("cond", 3),
			int_type(),
			SyntheticSourceLoc,
		),
		add_construct_from_fields(),
		expr_var_expr(left_var()),
		expr_type(),
		SyntheticSourceLoc,
	)
	rewritten: CoreExpr = rewrite_expr(prepared_let_drop(owned_add_bindings(), body))

	count_reuse(rewritten) == 0


pure func test_rejects_source_alias_payload() -> Bool:
	body: CoreExpr = add_construct([
		pointer_box(expr_var_expr(expr_var())),
		pointer_box(expr_var_expr(right_var())),
	])
	rewritten: CoreExpr = rewrite_expr(prepared_let_drop(owned_add_bindings(), body))

	count_reuse(rewritten) == 0


tests: TestSuite = {
	description = "Blorp compiler Core reuse",
	tests = [
		("rewrites owned union match result", test_rewrites_owned_union_match_result),
		("rejects borrowed union match fields", test_rejects_borrowed_union_match_fields),
		("reuses all if branches", test_reuses_all_if_branches),
		("rejects partial if branch", test_rejects_partial_if_branch),
		("rejects source alias payload", test_rejects_source_alias_payload),
	]
}
