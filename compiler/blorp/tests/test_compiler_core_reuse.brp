pure func test_rewrites_dead_heap_record_allocation() -> Bool:
	source_var: CoreVar = named_var("old")
	result_var: CoreVar = named_var("next")
	record_type: CoreType = heap_record_type("Counter")
	rewritten: CoreExpr = rewrite_post_perceus_expr(
		dropped_record_result_expr(
			source_var,
			result_var,
			record_type,
			record_type,
			ArcReleasePolicy,
			record_fields(int_expr(2)),
		),
	)

	match top_record_reuse_source(rewritten):
