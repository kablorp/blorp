	)
	rewritten: CoreExpr = rewrite_post_perceus_expr(
		list_handoff_expr_with_body(
			named_var("items"),
			named_var("results"),
			handoff_body,
		),
	)

	count_reuse(rewritten) == 1


pure func test_rejects_dead_record_allocation_with_different_type() -> Bool:
	rewritten: CoreExpr = rewrite_post_perceus_expr(
		dropped_record_result_expr(
			named_var("old"),
			named_var("next"),
			heap_record_type("Counter"),
			heap_record_type("OtherCounter"),
			ArcReleasePolicy,
			record_fields(int_expr(2)),
		),
	)

	top_record_reuse_source(rewritten) == None


pure func test_rejects_dead_record_allocation_without_arc_drop() -> Bool:
	record_type: CoreType = heap_record_type("Counter")
	rewritten: CoreExpr = rewrite_post_perceus_expr(
		dropped_record_result_expr(
			named_var("old"),
			named_var("next"),
			record_type,
			record_type,
			NoReleasePolicy,
			record_fields(int_expr(2)),
		),
	)

	top_record_reuse_source(rewritten) == None


pure func test_rejects_dead_record_allocation_that_assigns_source() -> Bool:
	source_var: CoreVar = named_var("old")
	record_type: CoreType = heap_record_type("Counter")
	assign_source: CoreExpr = AssignExpr(
		source_var,
		VarExpr(source_var, record_type, SyntheticSourceLoc),
		VoidType,
		SyntheticSourceLoc,
	)
	rewritten: CoreExpr = rewrite_post_perceus_expr(
		dropped_record_result_expr(
			source_var,
			named_var("next"),
			record_type,
			record_type,
			ArcReleasePolicy,
			record_fields(SeqExpr(assign_source, int_expr(2))),
		),
	)

	top_record_reuse_source(rewritten) == None


tests: TestSuite = {
	description = "Blorp compiler Core reuse",
	tests = [
		("rewrites dead list allocation", test_rewrites_dead_list_allocation),
		("rewrites dead set allocation", test_rewrites_dead_set_allocation),
		("rewrites dead dict allocation", test_rewrites_dead_dict_allocation),
		("rewrites dead heap-record allocation", test_rewrites_dead_heap_record_allocation),
		(
			"rewrites dead heap-record allocation that reads its source",
			test_rewrites_dead_heap_record_allocation_that_reads_source,
		),
		(
			"rewrites dead heap-record allocation in a while body",
			test_rewrites_dead_heap_record_allocation_in_while_body,
		),
		(
			"rewrites dead heap-record allocation in a range body",
			test_rewrites_dead_heap_record_allocation_in_range_body,
		),
		(
			"rewrites dead heap-record allocation in a list body",
			test_rewrites_dead_heap_record_allocation_in_list_body,
		),
		(
			"rewrites dead heap-record allocation in a constructor match",
			test_rewrites_dead_heap_record_allocation_in_constructor_match,
		),
		(
			"rewrites dead heap-record allocation in a list handoff body",
			test_rewrites_dead_heap_record_allocation_in_list_handoff_body,
		),
		(
			"rejects dead record allocation with a different type",
			test_rejects_dead_record_allocation_with_different_type,
		),
		(
			"rejects dead record allocation without an ARC drop",
			test_rejects_dead_record_allocation_without_arc_drop,
		),
		(
			"rejects dead record allocation that assigns its source",
			test_rejects_dead_record_allocation_that_assigns_source,
		),
		("upgrades post handoff drop", test_upgrades_post_handoff_drop),
		("rewrites owned union match result", test_rewrites_owned_union_match_result),
		("rejects borrowed union match fields", test_rejects_borrowed_union_match_fields),
		("reuses all if branches", test_reuses_all_if_branches),
		("rejects partial if branch", test_rejects_partial_if_branch),
		("rejects source alias payload", test_rejects_source_alias_payload),
	]
}
