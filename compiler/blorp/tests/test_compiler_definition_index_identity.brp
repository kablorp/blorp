import:
	../src/stage_01_file_io/source:
		CompilerSourceSpan,
		compiler_source_file,
		compiler_source_span,
		compiler_source_start,
	../src/stage_03_parse/parser_bridge as ParserBridge
	../src/stage_03_parse/source_ast_finalize: finalized_typecheck_program_ast
	../src/stage_04_modules/loaded_module:
		ANONYMOUS_IDENTITY,
		CompilerModuleIdentity,
		CompilerModuleOrigin(CompilerUserModule),
		compiler_loaded_module_identity,
		compiler_loaded_module_set,
		compiler_loaded_module_set_target,
		compiler_module_identity_for_program,
		compiler_module_load_candidate,
		compiler_resolved_module_identity_from_resolver,
	../src/stage_05_types/env: ENV_EMPTY
	../src/stage_06_typecheck/graph/definition_identity:
		CompilerSourceDefinitionKind(CompilerTraitDefinition),
		compiler_func_callable_key,
		compiler_func_callable_keys_equal,
		compiler_source_definition_key,
	../src/stage_06_typecheck/graph/definition_index:
		CompilerDefinitionIndex,
		CompilerDefinitionIndexConflict,
		compiler_definition_index_conflict_message,
		compiler_definition_index_empty,
		compiler_definition_index_find_func_callable_id,
		compiler_definition_index_func_callable_bindings,
		compiler_definition_index_func_callable_id_count,
		compiler_definition_index_initial_seed,
		compiler_definition_index_insert_func_callable_id,
		compiler_definition_index_insert_source_definition_id,
		compiler_definition_index_next_def_id,
	test: TestSuite


private pure func module_identity(canonical_path: String) -> CompilerModuleIdentity:
	program = ParserBridge.parsed_typecheck_source_bridge_artifact(
		"shared.brp",
		canonical_path,
		"pure func render() -> Int:\n\t1",
		False,
	).program

	match compiler_loaded_module_set(
		compiler_module_load_candidate(
			compiler_resolved_module_identity_from_resolver(canonical_path, CompilerUserModule),
			program,
		),
		[],
	):
		Ok(modules):
			compiler_loaded_module_identity(compiler_loaded_module_set_target(modules))
		Err(_):
			ANONYMOUS_IDENTITY


private pure func shared_span() -> CompilerSourceSpan:
	source = compiler_source_file("shared.brp", "shared", "pure func render() -> Int:\n\t1")
	start = compiler_source_start(source)
	compiler_source_span(source, start, start)


private pure func direct_module_identity_with_name(
	path: String,
	module_name: String,
) -> CompilerModuleIdentity:
	program = ParserBridge.parsed_typecheck_source_bridge_artifact(
		path,
		module_name,
		"pure func render() -> Int:\n\t1",
		False,
	).program
	compiler_module_identity_for_program(finalized_typecheck_program_ast(program))


private pure func direct_module_identity(path: String) -> CompilerModuleIdentity:
	direct_module_identity_with_name(path, "shared")


private pure func empty_index() -> CompilerDefinitionIndex:
	seed = compiler_definition_index_initial_seed(ENV_EMPTY)
	compiler_definition_index_empty(seed)


private pure func conflict_message(error: CompilerDefinitionIndexConflict) -> String:
	compiler_definition_index_conflict_message(error)


pure func test_definition_keys_include_canonical_module_identity() -> Bool:
	span = shared_span()
	left = compiler_func_callable_key(module_identity("pkg/left"), "render", span)
	right = compiler_func_callable_key(module_identity("pkg/right"), "render", span)

	not compiler_func_callable_keys_equal(left, right)


pure func test_definition_index_accepts_repeated_identical_binding() -> Bool:
	key = compiler_func_callable_key(module_identity("pkg/render"), "render", shared_span())
	empty = empty_index()
	def_id = compiler_definition_index_next_def_id(empty)

	match compiler_definition_index_insert_func_callable_id(empty, key, def_id):
		Err(_):
			False
		Ok(first):
			match compiler_definition_index_insert_func_callable_id(first, key, def_id):
				Err(_):
					False
				Ok(repeated):
					(
						compiler_definition_index_func_callable_id_count(repeated) == 1
						and compiler_definition_index_find_func_callable_id(
							repeated,
							key,
						) == Some(def_id)
					)


pure func test_definition_index_module_bucket_collision_preserves_exact_identity() -> Bool:
	span = shared_span()
	left = compiler_func_callable_key(direct_module_identity("pkg/left/shared.brp"), "render", span)
	right = compiler_func_callable_key(
		direct_module_identity("pkg/right/shared.brp"),
		"render",
		span,
	)
	empty = empty_index()
	left_id = compiler_definition_index_next_def_id(empty)

	match compiler_definition_index_insert_func_callable_id(empty, left, left_id):
		Err(_):
			False
		Ok(with_left):
			right_id = compiler_definition_index_next_def_id(with_left)

			match compiler_definition_index_insert_func_callable_id(with_left, right, right_id):
				Err(_):
					False
				Ok(with_both):
					(
						compiler_definition_index_find_func_callable_id(
							with_both,
							left,
						) == Some(left_id)
						and compiler_definition_index_find_func_callable_id(
							with_both,
							right,
						) == Some(right_id)
					)


pure func test_definition_index_name_bindings_preserve_insertion_order() -> Bool:
	span = shared_span()
	first = compiler_func_callable_key(
		direct_module_identity_with_name("pkg/first-a.brp", "group-a"),
		"render",
		span,
	)
	middle = compiler_func_callable_key(
		direct_module_identity_with_name("pkg/middle.brp", "group-b"),
		"render",
		span,
	)
	last = compiler_func_callable_key(
		direct_module_identity_with_name("pkg/last-a.brp", "group-a"),
		"render",
		span,
	)
	empty = empty_index()
	first_id = compiler_definition_index_next_def_id(empty)

	match compiler_definition_index_insert_func_callable_id(empty, first, first_id):
		Err(_):
			False
		Ok(with_first):
			middle_id = compiler_definition_index_next_def_id(with_first)

			match compiler_definition_index_insert_func_callable_id(with_first, middle, middle_id):
				Err(_):
					False
				Ok(with_middle):
					last_id = compiler_definition_index_next_def_id(with_middle)

					match compiler_definition_index_insert_func_callable_id(
						with_middle,
						last,
						last_id,
					):
						Err(_):
							False
						Ok(index):
							compiler_definition_index_func_callable_bindings(
								index,
								"render",
							).map(
								func(binding): binding[1],
							) == [first_id, middle_id, last_id]


pure func test_definition_index_rejects_key_remapping() -> Bool:
	key = compiler_func_callable_key(module_identity("pkg/render"), "render", shared_span())
	empty = empty_index()
	def_id = compiler_definition_index_next_def_id(empty)

	match compiler_definition_index_insert_func_callable_id(empty, key, def_id):
		Err(_):
			False
		Ok(first):
			match compiler_definition_index_insert_func_callable_id(first, key, def_id + 1):
				Ok(_):
					False
				Err(error):
					(
						conflict_message(
							error,
						).contains("already maps to definition ID " + def_id.to_string())
						and compiler_definition_index_find_func_callable_id(
							first,
							key,
						) == Some(def_id)
					)


pure func test_definition_index_rejects_definition_id_reuse() -> Bool:
	span = shared_span()
	left = compiler_func_callable_key(module_identity("pkg/left"), "render", span)
	right = compiler_func_callable_key(module_identity("pkg/right"), "render", span)
	empty = empty_index()
	def_id = compiler_definition_index_next_def_id(empty)

	match compiler_definition_index_insert_func_callable_id(empty, left, def_id):
		Err(_):
			False
		Ok(first):
			match compiler_definition_index_insert_func_callable_id(first, right, def_id):
				Ok(_):
					False
				Err(error):
					(
						conflict_message(
							error,
						).contains(
							"definition ID " + def_id.to_string() + " is below allocation frontier " + (def_id + 1).to_string(),
						)
						and compiler_definition_index_find_func_callable_id(
							first,
							left,
						) == Some(def_id)
						and compiler_definition_index_find_func_callable_id(first, right).is_none()
					)


pure func test_definition_index_rejects_source_definition_id_reuse() -> Bool:
	span = shared_span()
	left = compiler_source_definition_key(
		module_identity("pkg/left"),
		CompilerTraitDefinition,
		"Renderable",
		None,
		span,
	)
	right = compiler_source_definition_key(
		module_identity("pkg/right"),
		CompilerTraitDefinition,
		"Renderable",
		None,
		span,
	)
	empty = empty_index()
	def_id = compiler_definition_index_next_def_id(empty)

	match compiler_definition_index_insert_source_definition_id(empty, left, def_id):
		Err(_):
			False
		Ok(first):
			compiler_definition_index_insert_source_definition_id(first, right, def_id).is_err()


pure func test_definition_index_rejects_cross_kind_id_reuse() -> Bool:
	span = shared_span()
	callable = compiler_func_callable_key(module_identity("pkg/callable"), "render", span)
	source = compiler_source_definition_key(
		module_identity("pkg/source"),
		CompilerTraitDefinition,
		"Renderable",
		None,
		span,
	)
	empty = empty_index()
	def_id = compiler_definition_index_next_def_id(empty)

	callable_then_source = match compiler_definition_index_insert_func_callable_id(
		empty,
		callable,
		def_id,
	):
		Err(_):
			False
		Ok(first):
			compiler_definition_index_insert_source_definition_id(first, source, def_id).is_err()

	source_then_callable = match compiler_definition_index_insert_source_definition_id(
		empty,
		source,
		def_id,
	):
		Err(_):
			False
		Ok(first):
			compiler_definition_index_insert_func_callable_id(first, callable, def_id).is_err()

	callable_then_source and source_then_callable


tests: TestSuite = {
	description = "Compiler definition index module identity",
	tests = [
		(
			"definition keys include canonical module identity",
			test_definition_keys_include_canonical_module_identity,
		),
		(
			"repeated identical bindings are idempotent",
			test_definition_index_accepts_repeated_identical_binding,
		),
		(
			"module lookup buckets preserve exact identity under display-name collisions",
			test_definition_index_module_bucket_collision_preserves_exact_identity,
		),
		(
			"name-wide bindings preserve insertion order across module buckets",
			test_definition_index_name_bindings_preserve_insertion_order,
		),
		("definition keys cannot be remapped", test_definition_index_rejects_key_remapping),
		("definition IDs cannot be reused", test_definition_index_rejects_definition_id_reuse),
		(
			"source definition IDs cannot be reused",
			test_definition_index_rejects_source_definition_id_reuse,
		),
		(
			"definition IDs cannot be reused across key kinds",
			test_definition_index_rejects_cross_kind_id_reuse,
		),
	]
}
