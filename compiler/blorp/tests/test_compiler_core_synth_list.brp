private pure func body_for(function_info: CoreFunction) -> Option[CoreExpr]:
	synthesize_list_body(function_info)


private pure func contains_intrinsic(expr: CoreExpr, expected: String) -> Bool:
	match expr:
		CallExpr(IntrinsicCall(name), _, _, _, _):
			name == expected or immediate_core_expr_children(expr).any(func(child):
				contains_intrinsic(child, expected)
			)
		_:
			immediate_core_expr_children(expr).any(func(child):
				contains_intrinsic(child, expected)
			)


private pure func contains_closure_call(expr: CoreExpr) -> Bool:
	match expr:
		CallExpr(ClosureCall, _, _, _, _):
			True
		_:
			immediate_core_expr_children(expr).any(func(child): contains_closure_call(child))


private pure func contains_loop(expr: CoreExpr) -> Bool:
	match expr:
		ForRangeExpr(_, _, _, _, _, _):
			True
		WhileExpr(_, _, _, _):
			True
		_:
			immediate_core_expr_children(expr).any(func(child): contains_loop(child))


private pure func contains_break(expr: CoreExpr) -> Bool:
	match expr:
		BreakExpr(_, _):
			True
		_:
			immediate_core_expr_children(expr).any(func(child): contains_break(child))


private pure func contains_if(expr: CoreExpr) -> Bool:
	match expr:
		IfExpr(_, _, _, _, _):
			True
		_:
			immediate_core_expr_children(expr).any(func(child): contains_if(child))


private pure func contains_mutable_let(expr: CoreExpr) -> Bool:
	match expr:
		LetExpr(_, True, _, _, _):
			True
		_:
			immediate_core_expr_children(expr).any(func(child): contains_mutable_let(child))


private pure func contains_tuple(expr: CoreExpr) -> Bool:
	match expr:
		TupleExpr(_, _, _):
			True
		_:
			immediate_core_expr_children(expr).any(func(child): contains_tuple(child))


private pure func contains_raw_match(expr: CoreExpr) -> Bool:
	match expr:
		RawMatchExpr(_, _, _, _):
			True
		_:
			immediate_core_expr_children(expr).any(func(child): contains_raw_match(child))


private pure func contains_concurrently_loop(expr: CoreExpr, expects_timeout: Bool) -> Bool:
	match expr:
		PreClosureConcurrentlyLoopExpr(loop, _, _):
			match loop.timeout:
				Some(_):
					expects_timeout
				None:
					not expects_timeout
		_:
			immediate_core_expr_children(expr).any(func(child):
				contains_concurrently_loop(child, expects_timeout)
			)


private pure func contains_parameter_identity(expr: CoreExpr, expected: CoreVar) -> Bool:
	match expr:
		VarExpr(variable, _, _):
			variable == expected
		_:
			immediate_core_expr_children(expr).any(func(child):
				contains_parameter_identity(child, expected)
			)


private pure func contains_struct_unbox(expr: CoreExpr, expected: String) -> Bool:
	match expr:
		UnboxExpr(StructUnbox(c_type), _, _, _):
			c_type == expected or immediate_core_expr_children(expr).any(func(child):
				contains_struct_unbox(child, expected)
			)
		_:
			immediate_core_expr_children(expr).any(func(child):
				contains_struct_unbox(child, expected)
			)


private pure func synthesized_named(
	name: String,
	param_types: List[CoreType],
	return_type: CoreType,
) -> Option[CoreExpr]:
	body_for(list_builtin(name, param_types, return_type))


private pure func test_all_current_post_mono_list_operations_are_synthesized() -> Bool:
	accepted_list_functions().all(func(function_info: CoreFunction):
		match body_for(function_info):
			Some(body):
				function_info.params.all(func(function_param: CoreParam):
					contains_parameter_identity(body, function_param.name)
				)
			None:
				False
	)


private pure func test_storage_and_bounds_family_is_explicit_core() -> Bool:
	append = synthesized_named(
		"append",
		[LIST_INT_TYPE, INT_TYPE],
		LIST_INT_TYPE,
	)
	get = synthesized_named(
		"get",
		[LIST_INT_TYPE, INT_TYPE],
		OPTION_INT_TYPE,
	)
	remove = synthesized_named(
		"__unsafe_list_remove",
		[LIST_INT_TYPE, INT_TYPE],
		LIST_INT_TYPE,
	)

	match (append, get, remove):
		(Some(append_body), Some(get_body), Some(remove_body)):
			(
				contains_intrinsic(append_body, "list_ensure_capacity")
				and contains_intrinsic(append_body, "list_retain_for")
				and contains_intrinsic(get_body, "list_get_unchecked")
				and contains_if(get_body)
				and contains_intrinsic(remove_body, "list_release_elem")
				and contains_loop(remove_body)
			)
		_:
			False


private pure func test_transform_and_partition_family_uses_callbacks_and_owned_slots() -> Bool:
	map_body = synthesized_named(
		"map",
		[LIST_INT_TYPE, function_type([INT_TYPE], STRING_TYPE)],
		LIST_STRING_TYPE,
	)
	filter_map_body = synthesized_named(
		"filter_map",
		[LIST_INT_TYPE, function_type([INT_TYPE], OPTION_STRING_TYPE)],
		LIST_STRING_TYPE,
	)
	partition_body = synthesized_named(
		"partition",
		[LIST_INT_TYPE, function_type([INT_TYPE], BOOL_TYPE)],
		PARTITION_TYPE,
	)

	match (map_body, filter_map_body, partition_body):
		(Some(mapped), Some(filtered), Some(partitioned)):
			(
				contains_closure_call(mapped)
				and contains_intrinsic(mapped, "list_set_owned")
				and contains_loop(mapped)
				and contains_raw_match(filtered)
				and contains_tuple(partitioned)
			)
		_:
			False


private pure func test_terminal_and_search_family_short_circuits() -> Bool:
	all_body = synthesized_named(
		"all",
		[LIST_INT_TYPE, function_type([INT_TYPE], BOOL_TYPE)],
		BOOL_TYPE,
	)
	binary_body = synthesized_named(
		"binary_search",
		[LIST_INT_TYPE, INT_TYPE],
		OPTION_INT_TYPE,
	)

	match (all_body, binary_body):
		(Some(all_expr), Some(binary_expr)):
			(
				contains_closure_call(all_expr)
				and contains_break(all_expr)
				and contains_mutable_let(all_expr)
				and contains_loop(binary_expr)
				and contains_break(binary_expr)
			)
		_:
			False


private pure func test_sort_and_nested_materialization_are_explicit_core() -> Bool:
	sort_body = synthesized_named("sort", [LIST_INT_TYPE], LIST_INT_TYPE)
	windows_body = synthesized_named(
		"windows",
		[LIST_INT_TYPE, INT_TYPE],
		LIST_LIST_INT_TYPE,
	)
	unzip_body = synthesized_named("unzip", [LIST_INT_STRING_PAIR_TYPE], UNZIP_TYPE)

	match (sort_body, windows_body, unzip_body):
		(Some(sorted), Some(windowed), Some(unzipped)):
			(
				contains_loop(sorted)
				and contains_mutable_let(sorted)
				and contains_intrinsic(sorted, "list_alloc")
				and contains_intrinsic(windowed, "list_set_owned")
				and contains_tuple(unzipped)
			)
		_:
			False


private pure func test_concurrent_family_uses_pre_closure_concurrently_loop() -> Bool:
	callback_type: CoreType = function_type([INT_TYPE], STRING_TYPE)
	concurrent_body = synthesized_named(
		"concurrent",
		[LIST_INT_TYPE, INT_TYPE, callback_type],
		CONCURRENT_RESULT_TYPE,
	)
	timeout_body = synthesized_named(
		"__concurrent_timeout_ms",
		[LIST_INT_TYPE, INT_TYPE, INT_TYPE, callback_type],
		CONCURRENT_RESULT_TYPE,
	)

	match (concurrent_body, timeout_body):
		(Some(concurrent_expr), Some(timeout_expr)):
			(
				contains_concurrently_loop(concurrent_expr, False)
				and contains_concurrently_loop(timeout_expr, True)
			)
		_:
			False


private pure func test_parameter_core_var_identity_is_preserved() -> Bool:
	self_param = param("items", 701, LIST_INT_TYPE)
	callback_param = param(
		"transform",
		702,
		function_type([INT_TYPE], STRING_TYPE),
	)
	function_info = builtin_function(
		"std/list",
		"map",
		[self_param, callback_param],
		LIST_STRING_TYPE,
	)

	match body_for(function_info):
		Some(body):
			(
				contains_parameter_identity(body, self_param.name)
				and contains_parameter_identity(body, callback_param.name)
			)
		None:
			False


private pure func test_concrete_generic_element_layout_is_preserved() -> Bool:
	point_type: CoreType = ValueRecordType("Point")
	list_point_type: CoreType = NamedType("List", [point_type])
	callback_type: CoreType = function_type([point_type], point_type)

	match (
		synthesized_named(
			"map",
			[list_point_type, callback_type],
			list_point_type,
		)
	):
		Some(body):
			contains_struct_unbox(body, "Point") and contains_closure_call(body)
		None:
			False


private pure func test_module_signature_and_concreteness_are_exact() -> Bool:
	wrong_module = builtin_function(
		"std/stream",
		"map",
		[param("items", 801, LIST_INT_TYPE), param(
				"f",
				802,
				function_type([INT_TYPE], STRING_TYPE),
			)],
		LIST_STRING_TYPE,
	)
	wrong_element = list_builtin(
		"append",
		[LIST_INT_TYPE, STRING_TYPE],
		LIST_INT_TYPE,
	)
	wrong_return = list_builtin("length", [LIST_INT_TYPE], BOOL_TYPE)
	stale_alias = list_builtin(
		"__unsafe_list_append",
		[LIST_INT_TYPE, INT_TYPE],
		LIST_INT_TYPE,
	)
	stale_reverse_alias = list_builtin("__unsafe_list_reverse", [LIST_INT_TYPE], LIST_INT_TYPE)
	source_only = list_builtin("list", [INT_TYPE], LIST_INT_TYPE)
	non_synthesized_builtin = list_builtin("to_string", [LIST_INT_TYPE], STRING_TYPE)
	unresolved = list_builtin(
		"map",
		[
			NamedType("List", [TypeParameterType("T")]),
			function_type([TypeParameterType("T")], STRING_TYPE),
		],
		LIST_STRING_TYPE,
	)

	(
		body_for(wrong_module).is_none()
		and body_for(wrong_element).is_none()
		and body_for(wrong_return).is_none()
		and body_for(stale_alias).is_none()
		and body_for(stale_reverse_alias).is_none()
		and body_for(source_only).is_none()
		and body_for(non_synthesized_builtin).is_none()
		and body_for(unresolved).is_none()
	)


tests: TestSuite = {
	description = "Compiler Core list synthesis",
	tests = [
		(
			"all current post-mono list operations synthesize",
			test_all_current_post_mono_list_operations_are_synthesized,
		),
		(
			"storage and bounds family is explicit Core",
			test_storage_and_bounds_family_is_explicit_core,
		),
		(
			"transform and partition family owns result slots",
			test_transform_and_partition_family_uses_callbacks_and_owned_slots,
		),
		(
			"terminal and search family short-circuits",
			test_terminal_and_search_family_short_circuits,
		),
		(
			"sort and nested materialization stay in Core",
			test_sort_and_nested_materialization_are_explicit_core,
		),
		(
			"concurrent family uses pre-closure loop",
			test_concurrent_family_uses_pre_closure_concurrently_loop,
		),
		("parameter CoreVar identity is preserved", test_parameter_core_var_identity_is_preserved),
		(
			"concrete generic element layout is preserved",
			test_concrete_generic_element_layout_is_preserved,
		),
		(
			"module, signatures, and types are exact",
			test_module_signature_and_concreteness_are_exact,
		),
	]
}
