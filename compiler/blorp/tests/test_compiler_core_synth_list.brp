import:
	../src/stage_09_core/core_json:
		CoreCallKind(ClosureCall, IntrinsicCall),
		CoreExpr(
			BreakExpr,
			CallExpr,
			ForRangeExpr,
			IfExpr,
			LetExpr,
			PreClosureConcurrentlyLoopExpr,
			RawMatchExpr,
			TupleExpr,
			UnboxExpr,
			VarExpr,
			WhileExpr,
		),
		CoreFunction,
		CoreFunctionKind(UnresolvedBuiltinFunction),
		CoreParam,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(FunctionType, NamedType, TupleType, TypeParameterType, ValueRecordType, VoidType),
		CoreUnboxKind(StructUnbox),
		CoreVar,
	../src/stage_09_core/core_synth_list: synthesize_list_body
	../src/stage_09_core/core_traverse: immediate_core_expr_children
	test: TestSuite


private INT_TYPE: CoreType = NamedType("Int", [])

private BOOL_TYPE: CoreType = NamedType("Bool", [])

private STRING_TYPE: CoreType = NamedType("String", [])

private VOID_TYPE: CoreType = VoidType

private CONCURRENCY_ERROR_TYPE: CoreType = NamedType("ConcurrencyError", [])

private LIST_INT_TYPE: CoreType = NamedType("List", [INT_TYPE])

private LIST_STRING_TYPE: CoreType = NamedType("List", [STRING_TYPE])

private LIST_LIST_INT_TYPE: CoreType = NamedType("List", [LIST_INT_TYPE])

private PARALLEL_LIST_INT_TYPE: CoreType = NamedType("ParallelList", [INT_TYPE])

private PARALLEL_LIST_STRING_TYPE: CoreType = NamedType("ParallelList", [STRING_TYPE])

private OPTION_INT_TYPE: CoreType = NamedType("Option", [INT_TYPE])

private OPTION_STRING_TYPE: CoreType = NamedType("Option", [STRING_TYPE])

private INT_STRING_PAIR_TYPE: CoreType = TupleType([INT_TYPE, STRING_TYPE])

private INT_INT_PAIR_TYPE: CoreType = TupleType([INT_TYPE, INT_TYPE])

private LIST_INT_STRING_PAIR_TYPE: CoreType = NamedType("List", [INT_STRING_PAIR_TYPE])

private LIST_INT_INT_PAIR_TYPE: CoreType = NamedType("List", [INT_INT_PAIR_TYPE])

private PARTITION_TYPE: CoreType = TupleType([LIST_INT_TYPE, LIST_INT_TYPE])

private UNZIP_TYPE: CoreType = TupleType([LIST_INT_TYPE, LIST_STRING_TYPE])

private CONCURRENT_RESULT_TYPE: CoreType = NamedType(
	"List",
	[
		NamedType(
			"Result",
			[STRING_TYPE, CONCURRENCY_ERROR_TYPE],
		),
	],
)


private pure func core_var(name: String, uniq: Int) -> CoreVar:
	{
		name = name,
		uniq = uniq,
		def_id = Some(uniq)
	}


private pure func param(name: String, uniq: Int, typ: CoreType) -> CoreParam:
	{
		name = core_var(name, uniq),
		typ = typ,
		loc = SyntheticSourceLoc
	}


private pure func function_type(params: List[CoreType], return_type: CoreType) -> CoreType:
	FunctionType(True, params, return_type)


private pure func builtin_function(
	module_name: String,
	source_name: String,
	params: List[CoreParam],
	return_type: CoreType,
) -> CoreFunction:
	{
		name = module_name.replace("/", "_") + "__" + source_name + "__mono_fixture",
		source_module = Some(module_name),
		type_params = [],
		params = params,
		return_type = return_type,
		body = None,
		is_pure = True,
		function_kind = UnresolvedBuiltinFunction,
		def_id = 1,
		loc = SyntheticSourceLoc
	}


private pure func list_builtin(
	source_name: String,
	param_types: List[CoreType],
	return_type: CoreType,
) -> CoreFunction:
	params: List[CoreParam] = param_types.map_indexed(func(index: Int, typ: CoreType):
		param("p${index}", 100 + index, typ)
	)
	builtin_function("std/list", source_name, params, return_type)


