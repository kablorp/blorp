import:
	../language_surface_manifest:
		RenderError(UnsupportedLanguageSurfaceOp, WrongArity),
		language_surface_template_arity,
		language_surface_template_name,
		parse_language_surface_template,
		render_error_to_string,
		render_language_surface,
	test: TestSuite


pure func parsed_template_has(name: String, expected_name: String, expected_arity: Int) -> Bool:
	match parse_language_surface_template(name):
		Some(info):
			(
				language_surface_template_name(info) == expected_name
				and language_surface_template_arity(info) == expected_arity
			)
		None:
			False


pure func rendered_table_is(name: String, expected: String) -> Bool:
	match render_language_surface(name, []):
		Ok(rendered):
			rendered == expected
		Err(error):
			False


pure func expected_keywords() -> String:
	(
		"func;pure;var;union;record;void;while;for;in;if;else;and;or;not;match;True;"
		+ "False;break;continue;debug;struct;enum;with;resource;foreign;private;builtin;"
		+ "concurrent;concurrently;detach;select;into;from;after;sealed;import;as;trait;"
		+ "implements;Self;type;alias;where"
	)


pure func expected_prelude_imports() -> String:
	(
		"option:Option;result:Result;bool:Bool;char:Char;bytes:Bytes;string:String;list:"
		+ "List;list:ParallelList;parallel_list:ParallelList;vector:ParallelVector;"
		+ "parallel_vector:ParallelVector;matrix:ParallelMatrix;parallel_matrix:"
		+ "ParallelMatrix;range:Range;dict:Dict;set:Set;file:FileReader;file:FileWriter;"
		+ "file:FileAppender;file:FileReadWriter;file:FileReadAppender"
	)


pure func expected_prelude_ufcs_modules() -> String:
	(
		"option;result;bool;char;bytes;string;list;parallel_list;vector;parallel_vector;"
		+ "matrix;parallel_matrix;range;dict;set;file"
	)


pure func test_parse_template_shapes() -> Bool:
	keywords_ok: Bool = parsed_template_has(
		"language_lsp_completion_keywords",
		"language_lsp_completion_keywords",
		0,
	)
	imports_ok: Bool = parsed_template_has(
		"language_prelude_method_type_imports",
		"language_prelude_method_type_imports",
		0,
	)
	ufcs_modules_ok: Bool = parsed_template_has(
		"language_prelude_ufcs_modules",
		"language_prelude_ufcs_modules",
		0,
	)

	keywords_ok and imports_ok and ufcs_modules_ok


pure func test_render_tables() -> Bool:
	keywords_ok: Bool = rendered_table_is("language_lsp_completion_keywords", expected_keywords())
	imports_ok: Bool = rendered_table_is(
		"language_prelude_method_type_imports",
		expected_prelude_imports(),
	)
	ufcs_modules_ok: Bool = rendered_table_is(
		"language_prelude_ufcs_modules",
		expected_prelude_ufcs_modules(),
	)

	keywords_ok and imports_ok and ufcs_modules_ok


pure func test_render_errors_are_typed() -> Bool:
	wrong_arity_ok: Bool = match render_language_surface(
		"language_lsp_completion_keywords",
		["extra"],
	):
		Err(WrongArity(info, actual)):
			(
				language_surface_template_name(info) == "language_lsp_completion_keywords"
				and language_surface_template_arity(info) == 0
				and actual == 1
			)
		Ok(value):
			False
		Err(UnsupportedLanguageSurfaceOp(name)):
			False

	unsupported_ok: Bool = match render_language_surface("language_missing", []):
		Err(UnsupportedLanguageSurfaceOp(name)):
			name == "language_missing"
		Ok(value):
			False
		Err(WrongArity(info, actual)):
			False

	wrong_arity_ok and unsupported_ok


pure func test_error_text() -> Bool:
	arity_text: String = match render_language_surface(
		"language_lsp_completion_keywords",
		["extra"],
	):
		Err(error):
			render_error_to_string(error)
		Ok(value):
			value

	unsupported_text: String = render_error_to_string(
		UnsupportedLanguageSurfaceOp("language_missing"),
	)

	(
		arity_text == "language surface op language_lsp_completion_keywords expected 0 arg(s), got 1"
		and unsupported_text == "unsupported language surface op: language_missing"
	)


tests: TestSuite = {
	description = "Self-hosted language surface manifest",
	tests = [
		("parse template shapes", test_parse_template_shapes),
		("render tables", test_render_tables),
		("render errors are typed", test_render_errors_are_typed),
		("error text", test_error_text),
	]
}
