import:
	../src/stage_09_core/compiler_core_desugar: desugar_expr, desugar_program
	../src/stage_09_core/compiler_core_json:
		CoreBinaryOp(AddOp, EqualOp, NotEqualOp),
		CoreCallKind(BuiltinCall),
		CoreDecl(FunctionDecl, GlobalDecl),
		CoreExpr(
			BinaryExpr,
			CallExpr,
			LetExpr,
			LiteralExpr,
			UnaryExpr,
			VarExpr,
			VoidExpr,
		),
		CoreFunction,
		CoreFunctionKind(UserFunction),
		CoreGlobal,
		CoreLiteral(StringLiteral),
		CoreProgram,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType, VoidType),
		CoreUnaryOp(NotOp),
		CoreVar,
		core_expr_to_json,
		core_program_to_json,
	test: TestSuite


pure func string_type() -> CoreType:
	NamedType("String", [])


pure func bool_type() -> CoreType:
	NamedType("Bool", [])


pure func int_type() -> CoreType:
	NamedType("Int", [])


pure func named_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


pure func string_lit(value: String) -> CoreExpr:
	LiteralExpr(StringLiteral(value), string_type(), SyntheticSourceLoc)


pure func string_var(name: String) -> CoreExpr:
	VarExpr(named_var(name), string_type(), SyntheticSourceLoc)


pure func int_var(name: String) -> CoreExpr:
	VarExpr(named_var(name), int_type(), SyntheticSourceLoc)


pure func core_exprs_equal(left: CoreExpr, right: CoreExpr) -> Bool:
	core_expr_to_json(left).to_string() == core_expr_to_json(right).to_string()


pure func core_programs_equal(left: CoreProgram, right: CoreProgram) -> Bool:
	core_program_to_json(left).to_string() == core_program_to_json(right).to_string()


pure func builtin_call(name: String, args: List[CoreExpr], typ: CoreType) -> CoreExpr:
	CallExpr(BuiltinCall(name), VoidExpr(VoidType, SyntheticSourceLoc), args, typ, SyntheticSourceLoc)


func test_desugars_string_add_to_concat_call() -> Bool:
	expr = BinaryExpr(
		AddOp,
		string_lit("a"),
		string_lit("b"),
		string_type(),
		SyntheticSourceLoc,
	)
	expected = builtin_call("blorp_string_concat", [string_lit("a"), string_lit("b")], string_type())

	core_exprs_equal(desugar_expr(expr), expected)


func test_desugars_string_equal_to_builtin_call() -> Bool:
	expr = BinaryExpr(
		EqualOp,
		string_lit("a"),
		string_lit("b"),
		bool_type(),
		SyntheticSourceLoc,
	)
	expected = builtin_call("blorp_string_eq", [string_lit("a"), string_lit("b")], bool_type())

	core_exprs_equal(desugar_expr(expr), expected)


func test_desugars_string_not_equal_to_not_builtin_call() -> Bool:
	expr = BinaryExpr(
		NotEqualOp,
		string_lit("a"),
		string_lit("b"),
		bool_type(),
		SyntheticSourceLoc,
	)
	expected = UnaryExpr(
		NotOp,
		builtin_call("blorp_string_eq", [string_lit("a"), string_lit("b")], bool_type()),
		bool_type(),
		SyntheticSourceLoc,
	)

	core_exprs_equal(desugar_expr(expr), expected)


func test_leaves_non_string_add_as_binary_expr() -> Bool:
	expr = BinaryExpr(
		AddOp,
		int_var("a"),
		int_var("b"),
		int_type(),
		SyntheticSourceLoc,
	)

	core_exprs_equal(desugar_expr(expr), expr)


func test_desugars_nested_string_add_inside_let() -> Bool:
	expr = LetExpr(
		named_var("message"),
		False,
		string_type(),
		BinaryExpr(
			AddOp,
			string_lit("a"),
			string_lit("b"),
			string_type(),
			SyntheticSourceLoc,
		),
		string_var("message"),
	)
	expected = LetExpr(
		named_var("message"),
		False,
		string_type(),
		builtin_call("blorp_string_concat", [string_lit("a"), string_lit("b")], string_type()),
		string_var("message"),
	)

	core_exprs_equal(desugar_expr(expr), expected)


pure func sample_function(body: CoreExpr) -> CoreFunction:
	{
		name = "make_message",
		source_module = None,
		type_params = [],
		params = [],
		return_type = string_type(),
		body = Some(body),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 1,
		loc = SyntheticSourceLoc
	}


pure func sample_global(init: CoreExpr) -> CoreGlobal:
	{
		name = named_var("message"),
		source_module = None,
		typ = string_type(),
		init = init,
		is_mutable = False,
		is_const = False,
		is_private = False,
		def_id = 2,
		loc = SyntheticSourceLoc
	}


func test_desugars_program_function_and_global_bodies() -> Bool:
	source_expr = BinaryExpr(
		AddOp,
		string_lit("a"),
		string_lit("b"),
		string_type(),
		SyntheticSourceLoc,
	)
	desugared_expr = builtin_call(
		"blorp_string_concat",
		[string_lit("a"), string_lit("b")],
		string_type(),
	)
	source_program: CoreProgram = {
		decls = [
			FunctionDecl(sample_function(source_expr)),
			GlobalDecl(sample_global(source_expr)),
		],
		foreign_includes = []
	}
	expected: CoreProgram = {
		decls = [
			FunctionDecl(sample_function(desugared_expr)),
			GlobalDecl(sample_global(desugared_expr)),
		],
		foreign_includes = []
	}

	core_programs_equal(desugar_program(source_program), expected)


tests: TestSuite = {
	description = "Blorp compiler Core desugar",
	tests = [
		("desugars string add to concat call", test_desugars_string_add_to_concat_call),
		("desugars string equal to builtin call", test_desugars_string_equal_to_builtin_call),
		(
			"desugars string not equal to not builtin call",
			test_desugars_string_not_equal_to_not_builtin_call,
		),
		("leaves non string add as binary expr", test_leaves_non_string_add_as_binary_expr),
		("desugars nested string add inside let", test_desugars_nested_string_add_inside_let),
		(
			"desugars program function and global bodies",
			test_desugars_program_function_and_global_bodies,
		),
	]
}
