	test: TestSuite


pure func source_file() -> CompilerSourceFile:
	compiler_source_file("ctfe_materialize.brp", "ctfe_materialize", "VALUE = 1")


pure func source_span() -> CompilerSourceSpan:
	src: CompilerSourceFile = source_file()
	cursor: CompilerCursor = compiler_source_cursor_at(src, 0)
	compiler_source_span(src, cursor, cursor)


pure func int_value(value: Int) -> CompilerCtfeValue:
	compiler_ctfe_int(source_span(), value)


pure func float_value(value: Float) -> CompilerCtfeValue:
	compiler_ctfe_float(source_span(), value)


pure func string_value(value: String) -> CompilerCtfeValue:
	compiler_ctfe_string(source_span(), value)


pure func bool_value(value: Bool) -> CompilerCtfeValue:
	compiler_ctfe_bool(source_span(), value)


pure func char_value(value: Int) -> CompilerCtfeValue:
	compiler_ctfe_char(source_span(), to_char(value))


pure func tuple_value(values: List[CompilerCtfeValue]) -> CompilerCtfeValue:
	compiler_ctfe_value(CompilerTupleType(values.map(
			func(value): value.typ,
		)), CompilerCtfeTupleValue(values), source_span())


pure func list_value(values: List[CompilerCtfeValue]) -> CompilerCtfeValue:
	compiler_ctfe_value(
		compiler_type_list(compiler_type_int()),
		CompilerCtfeListValue(values),
		source_span(),
	)


pure func record_value(fields: List[(String, CompilerCtfeValue)]) -> CompilerCtfeValue:
	compiler_ctfe_value(
		CompilerNamedType("Box", []),
		CompilerCtfeRecordValue(fields),
		source_span(),
	)


pure func dict_value(entries: List[(CompilerCtfeValue, CompilerCtfeValue)]) -> CompilerCtfeValue:
	compiler_ctfe_value(
		CompilerNamedType(
			"Dict",
			[compiler_type_string(), compiler_type_int()],
		),
		CompilerCtfeDictValue(entries),
		source_span(),
	)


pure func range_value(start: CompilerCtfeValue, end: CompilerCtfeValue) -> CompilerCtfeValue:
	compiler_ctfe_value(
		CompilerRangeType(compiler_type_int()),
		CompilerCtfeRangeValue(start, end),
		source_span(),
	)


pure func constructor_value(
	name: String,
	args: List[CompilerCtfeValue],
	callable_id: Option[Int],
) -> CompilerCtfeValue:
	compiler_ctfe_value(
		CompilerNamedType("Option", [compiler_type_int()]),
		CompilerCtfeConstructorValue({
			name = name,
			args = args,
			constructor_info = compiler_ctfe_constructor_info("Option", args.length(), callable_id),
		}),
		source_span(),
	)


pure func function_reference_value() -> CompilerCtfeValue:
	compiler_ctfe_function_reference(
		CompilerFunctionType(True, [compiler_type_int()], compiler_type_int()),
		source_span(),
		23,
		"increment",
		True,
	)


pure func lambda_source() -> CompilerCtfeLambdaSource:
	lambda_type = CompilerFunctionType(True, [], compiler_type_int())
	{
		is_pure = True,
		params = [],
		return_annotation = Some(compiler_type_int()),
		body = CompilerTypedIntLiteralExpr(
			"42",
			source_span(),
			{
				source_type = None,
				origin = CompilerSynthesizedOrigin("ctfe_materialize_test"),
				value_slot = {
					semantic_type = compiler_type_int(),
					decision = CompilerTypeKeep(compiler_type_int())
				},
				proofs = compiler_unrefined_binding(),
				resolved_call = None,
				resource_dependencies = []
			},
		),
		span = source_span(),
		info = {
			source_type = None,
			origin = CompilerSynthesizedOrigin("ctfe_materialize_test"),
			value_slot = {
				semantic_type = lambda_type,
				decision = CompilerTypeKeep(lambda_type)
			},
			proofs = compiler_unrefined_binding(),
			resolved_call = None,
			resource_dependencies = []
		}
	}


pure func lambda_expr() -> CompilerTypedExpr:
	source = lambda_source()
	CompilerTypedLambdaExpr(
		source.is_pure,
		source.params,
		source.return_annotation,
		source.body,
		source.span,
		source.info,
	)


pure func lambda_value_with_env(env: CompilerCtfeEnv) -> CompilerCtfeValue:
	source = lambda_source()
	compiler_ctfe_value(compiler_typed_expr_info_value_type(source.info), CompilerCtfeLambdaValue({
			source = source,
			env = env,
		}), source.span)


pure func lambda_value() -> CompilerCtfeValue:
	lambda_value_with_env(compiler_ctfe_env_empty())


pure func captured_lambda_value() -> CompilerCtfeValue:
	lambda_value_with_env(
		compiler_ctfe_bind_local_value(
			compiler_ctfe_env_empty(),
			"offset",
			compiler_ctfe_int(source_span(), 3),
		),
	)


pure func materialized_type_is(value: CompilerCtfeValue, expected: CompilerType) -> Bool:
	match compiler_ctfe_materialize_value(value):
		Ok(materialized):
			compiler_types_equal(compiler_typed_expr_value_type(materialized), expected)
		Err(_):
			False


pure func materialize_error_is(
	error: CompilerCtfeMaterializeError,
	expected: CompilerCtfeMaterializeError,
) -> Bool:
	error == expected


func test_materializes_scalar_literals() -> Bool:
	int_ok = match compiler_ctfe_materialize_value(int_value(42)):
		Ok(CompilerTypedIntLiteralExpr(text, _, _)):
			text == "42"
		_:
			False

	float_ok = match compiler_ctfe_materialize_value(float_value(3.141592653589793)):
		Ok(CompilerTypedFloatLiteralExpr(text, _, _)):
			text == "3.141592653589793"
		_:
			False

	non_finite_float_ok = match compiler_ctfe_materialize_value(float_value(1.0 / 0.0)):
		Ok(CompilerTypedFloatLiteralExpr(text, _, _)):
			text == "inf"
		_:
			False

	negative_infinity_float_ok = match compiler_ctfe_materialize_value(float_value(-1.0 / 0.0)):
		Ok(CompilerTypedFloatLiteralExpr(text, _, _)):
			text == "-inf"
		_:
			False

	nan_float_ok = match compiler_ctfe_materialize_value(float_value(0.0 / 0.0)):
		Ok(CompilerTypedFloatLiteralExpr(text, _, _)):
			text == "nan"
		_:
			False

	bool_ok = match compiler_ctfe_materialize_value(bool_value(True)):
		Ok(CompilerTypedBoolLiteralExpr(value, _, _)):
			value
		_:
			False

	char_ok = match compiler_ctfe_materialize_value(char_value(65)):
		Ok(CompilerTypedCharLiteralExpr(value, _, _)):
			value == 65
		_:
			False

	string_ok = match compiler_ctfe_materialize_value(string_value("blorp")):
		Ok(CompilerTypedStringLiteralExpr(value, _, _)):
			value == "blorp"
		_:
			False

	void_ok = match compiler_ctfe_materialize_value(compiler_ctfe_void(source_span())):
		Ok(CompilerTypedVoidExpr(_, _)):
			True
		_:
			False

	(
		int_ok
		and float_ok
		and non_finite_float_ok
		and negative_infinity_float_ok
		and nan_float_ok
		and bool_ok
		and char_ok
		and string_ok
		and void_ok
		and materialized_type_is(int_value(1), compiler_type_int())
		and materialized_type_is(compiler_ctfe_void(source_span()), compiler_type_void())
	)


func test_materializes_aggregate_literals() -> Bool:
	tuple_ok = match compiler_ctfe_materialize_value(
		tuple_value([int_value(1), string_value("x")]),
	):
		Ok(CompilerTypedTupleExpr(items, _, _)):
			items.length() == 2
		_:
			False

	list_ok = match compiler_ctfe_materialize_value(list_value([int_value(1), int_value(2)])):
		Ok(CompilerTypedListExpr(items, _, _)):
			items.length() == 2
		_:
			False

	record_ok = match compiler_ctfe_materialize_value(record_value([("value", int_value(3))])):
		Ok(CompilerTypedRecordExpr(fields, _, _)):
			match fields.get(0):
				Some(field):
					field.name.text == "value"
				None:
					False
		_:
			False

	dict_ok = match compiler_ctfe_materialize_value(
		dict_value([(string_value("answer"), int_value(42))]),
	):
		Ok(CompilerTypedDictExpr(entries, _, _)):
			entries.length() == 1
		_:
			False

	range_ok = match compiler_ctfe_materialize_value(range_value(int_value(0), int_value(3))):
		Ok(CompilerTypedRangeExpr(_, _, _, _)):
			True
		_:
			False

	tuple_ok and list_ok and record_ok and dict_ok and range_ok


func test_materializes_constructors() -> Bool:
	nullary_ok = match compiler_ctfe_materialize_value(constructor_value("None", [], Some(16))):
		Ok(CompilerTypedNameExpr(name, info)):
			name.text == "None" and match info.resolved_call:
				Some(call):
					match call.target:
						CompilerResolvedDirectCall(callable_id, origin):
							match origin:
								CompilerCallableConstructor(parent_type):
									callable_id == 16 and parent_type == "Option"
								_:
									False
						_:
							False
				None:
					False
		_:
			False

	expr = compiler_ctfe_materialize_value(constructor_value("Some", [int_value(42)], Some(17)))

	call_ok = match expr:
		Ok(call_expr):
			match call_expr:
				CompilerTypedCallExpr(callee, args, _, _):
					callee_ok = match callee:
						CompilerTypedNameExpr(name, _):
							name.text == "Some"
						_:
							False

					resolved_ok = match compiler_typed_expr_resolved_call(call_expr):
						Some(call):
							match call.target:
								CompilerResolvedDirectCall(callable_id, origin):
									match origin:
										CompilerCallableConstructor(parent_type):
											callable_id == 17 and parent_type == "Option"
										_:
											False
								_:
									False
						None:
							False

					callee_ok and args.length() == 1 and resolved_ok
				_:
					False
		_:
			False

	nullary_ok and call_ok


func test_materializes_function_references() -> Bool:
	value = function_reference_value()

	typed_ok = match compiler_ctfe_materialize_value(value):
		Ok(materialized):
			resolved_ok = match compiler_typed_expr_resolved_call(materialized):
				Some(call):
					match call.target:
						CompilerResolvedDirectCall(callable_id, origin):
							match origin:
								CompilerCallableLocal:
									(
										callable_id == 23
										and call.instantiated_params.length() == 1
										and compiler_types_equal(
											call.instantiated_return,
											compiler_type_int(),
										)
									)
								_:
									False
						_:
							False
				None:
					False

			match materialized:
				CompilerTypedNameExpr(name, _):
					name.text == "increment" and resolved_ok
				_:
					False
		_:
			False

	parsed_ok = match compiler_ctfe_materialize_parsed_expr(value):
		Ok(ParsedNameExpr(name)):
			name.text == "increment"
		_:
			False

	typed_ok and parsed_ok


func test_materializes_lambda_without_inventing_parsed_source() -> Bool:
	typed_ok = match compiler_ctfe_materialize_value(lambda_value()):
		Ok(CompilerTypedLambdaExpr(_, _, _, _, _, _)):
			True
		_:
			False

	parsed_unavailable = match compiler_ctfe_materialize_parsed_expr(lambda_value()):
		Err(error):
			materialize_error_is(error, CompilerCtfeLambdaSourceUnavailable)
		_:
			False

	typed_ok and parsed_unavailable


func test_rejects_captured_lambda_materialization() -> Bool:
	match compiler_ctfe_materialize_value(captured_lambda_value()):
		Err(error):
			materialize_error_is(error, CompilerCtfeCapturedLambda)
		_:
			False


func test_rejects_captured_lambda_nested_in_aggregate() -> Bool:
	match compiler_ctfe_materialize_value(record_value([("callback", captured_lambda_value())])):
		Err(error):
			materialize_error_is(error, CompilerCtfeCapturedLambda)
		_:
			False


func test_materializes_parsed_literals() -> Bool:
	int_ok = match compiler_ctfe_materialize_parsed_expr(int_value(42)):
		Ok(ParsedIntLiteralExpr(text, _)):
			text == "42"
		_:
			False

	float_ok = match compiler_ctfe_materialize_parsed_expr(float_value(3.141592653589793)):
		Ok(ParsedFloatLiteralExpr(text, _)):
			text == "3.141592653589793"
		_:
			False

	bool_ok = match compiler_ctfe_materialize_parsed_expr(bool_value(True)):
		Ok(ParsedBoolLiteralExpr(value, _)):
			value
		_:
			False

	string_ok = match compiler_ctfe_materialize_parsed_expr(string_value("blorp")):
		Ok(ParsedStringLiteralExpr(value, _, _)):
			value == "blorp"
		_:
			False

	int_ok and float_ok and bool_ok and string_ok


func test_materializes_parsed_aggregates_and_constructors() -> Bool:
	tuple_ok = match compiler_ctfe_materialize_parsed_expr(
		tuple_value([int_value(1), string_value("x")]),
	):
		Ok(ParsedTupleExpr(items, _)):
			items.length() == 2
		_:
			False

	list_ok = match compiler_ctfe_materialize_parsed_expr(list_value([int_value(1), int_value(2)])):
		Ok(ParsedListExpr(items, _)):
			items.length() == 2
		_:
			False

	record_ok = match compiler_ctfe_materialize_parsed_expr(
		record_value([("value", int_value(3))]),
	):
		Ok(ParsedRecordExpr(fields, _)):
			match fields.get(0):
				Some(field):
					field.name.text == "value"
				None:
					False
		_:
			False

	dict_ok = match compiler_ctfe_materialize_parsed_expr(
		dict_value([(string_value("answer"), int_value(42))]),
	):
		Ok(ParsedDictExpr(entries, _)):
			match entries.get(0):
				Some(entry):
					match entry.key:
						ParsedStringLiteralExpr(text, _, _):
							text == "answer"
						_:
							False
				None:
					False
		_:
			False

	nullary_ok = match compiler_ctfe_materialize_parsed_expr(constructor_value("None", [], None)):
		Ok(ParsedNameExpr(name)):
			name.text == "None"
		_:
			False

	call_ok = match compiler_ctfe_materialize_parsed_expr(
		constructor_value(
			"Some",
			[int_value(4)],
			Some(9),
		),
	):
		Ok(ParsedCallExpr(callee, args, _)):
			callee_ok = match callee:
				ParsedNameExpr(name):
					name.text == "Some"
				_:
					False

			callee_ok and args.length() == 1
		_:
			False

	tuple_ok and list_ok and record_ok and dict_ok and nullary_ok and call_ok


tests: TestSuite = {
	description = "Compiler CTFE materialize",
	tests = [
		("materializes scalar literals", test_materializes_scalar_literals),
		("materializes aggregate literals", test_materializes_aggregate_literals),
		("materializes constructors", test_materializes_constructors),
		("materializes function references", test_materializes_function_references),
		(
			"materializes typed lambdas without inventing parsed source",
			test_materializes_lambda_without_inventing_parsed_source,
		),
		("rejects captured lambda materialization", test_rejects_captured_lambda_materialization),
		(
			"rejects captured lambda nested in aggregate",
			test_rejects_captured_lambda_nested_in_aggregate,
		),
		("materializes parsed literals", test_materializes_parsed_literals),
		(
			"materializes parsed aggregates and constructors",
			test_materializes_parsed_aggregates_and_constructors,
		),
	]
}
