import:
	../src/stage_01_file_io/compiler_source:
		CompilerCursor,
		CompilerSourceFile,
		CompilerSourceSpan,
		compiler_source_cursor_at,
		compiler_source_file,
		compiler_source_span,
	../src/stage_03_parse/compiler_parsed_ast:
		ParsedExpr(
			ParsedBoolLiteralExpr,
			ParsedCallExpr,
			ParsedDictExpr,
			ParsedFloatLiteralExpr,
			ParsedIntLiteralExpr,
			ParsedListExpr,
			ParsedNameExpr,
			ParsedRecordExpr,
			ParsedStringLiteralExpr,
			ParsedTupleExpr,
		),
	../src/stage_05_types/compiler_refinement: unrefined_binding
	../src/stage_05_types/compiler_type:
		SemanticType(SemanticFunctionType, SemanticNamedType, SemanticRangeType, SemanticTupleType),
		type_int,
		type_list,
		type_string,
		type_void,
		types_equal,
	../src/stage_05_types/compiler_type_widening: ValueSlot(KeptValueSlot)
	../src/stage_06_typecheck/compiler_infer:
		CallableOrigin(CallableConstructor, CallableLocal),
		ExprTypeOrigin(SynthesizedOrigin),
		ResolvedCallTarget(ResolvedDirectCall),
		TypedExpr(
			TypedBoolLiteralExpr,
			TypedCallExpr,
			TypedCharLiteralExpr,
			TypedDictExpr,
			TypedFloatLiteralExpr,
			TypedIntLiteralExpr,
			TypedListExpr,
			TypedLambdaExpr,
			TypedNameExpr,
			TypedRangeExpr,
			TypedRecordExpr,
			TypedStringLiteralExpr,
			TypedTupleExpr,
			TypedVoidExpr,
		),
		typed_expr_info_value_type,
		typed_expr_resolved_call,
		typed_expr_value_type,
	../src/stage_07_ctfe/compiler_ctfe_env: compiler_ctfe_bind_local_value, compiler_ctfe_env_empty
	../src/stage_07_ctfe/compiler_ctfe_materialize:
		CompilerCtfeMaterializeError(
			CompilerCtfeCapturedLambda,
			CompilerCtfeLambdaSourceUnavailable,
		),
		compiler_ctfe_materialize_parsed_expr,
		compiler_ctfe_materialize_value,
	../src/stage_07_ctfe/compiler_ctfe_value:
		CompilerCtfeEnv,
		CompilerCtfeLambdaSource,
		CompilerCtfeValue,
		CompilerCtfeValueDesc(
			CompilerCtfeConstructorValue,
			CompilerCtfeDictValue,
			CompilerCtfeLambdaValue,
			CompilerCtfeListValue,
			CompilerCtfeRangeValue,
			CompilerCtfeRecordValue,
			CompilerCtfeTupleValue,
		),
		compiler_ctfe_bool,
		compiler_ctfe_char,
		compiler_ctfe_constructor_info,
		compiler_ctfe_float,
