import:
	../src/stage_01_file_io/source:
		Cursor,
		SourceFile,
		SourceSpan,
		source_cursor_at,
		source_file,
		source_span,
	../src/stage_03_parse/parsed_ast:
		ParsedExpr(
			ParsedBoolLiteralExpr,
			ParsedCallExpr,
			ParsedDictExpr,
			ParsedFloatLiteralExpr,
			ParsedIntLiteralExpr,
			ParsedListExpr,
			ParsedNameExpr,
			ParsedRecordExpr,
			ParsedStringLiteralExpr,
			ParsedTupleExpr,
		),
	../src/stage_05_types/refinement: UNREFINED_BINDING
	../src/stage_05_types/semantic_type:
		SemanticType(SemanticFunctionType, SemanticNamedType, SemanticRangeType, SemanticTupleType),
		TYPE_INT,
		TYPE_STRING,
		TYPE_VOID,
		type_list,
		types_equal,
	../src/stage_05_types/type_widening: ValueSlot(KeptValueSlot)
	../src/stage_06_typecheck/infer:
		CallableOrigin(CallableConstructor, CallableLocal),
		ExprTypeOrigin(SynthesizedOrigin),
		ResolvedCallTarget(ResolvedDirectCall),
		TypedExpr(
			TypedBoolLiteralExpr,
			TypedCallExpr,
			TypedCharLiteralExpr,
			TypedDictExpr,
			TypedFloatLiteralExpr,
			TypedIntLiteralExpr,
			TypedListExpr,
			TypedLambdaExpr,
			TypedNameExpr,
			TypedRangeExpr,
			TypedRecordExpr,
			TypedStringLiteralExpr,
			TypedTupleExpr,
			TypedVoidExpr,
		),
		typed_expr_info_value_type,
		typed_expr_resolved_call,
		typed_expr_value_type,
	../src/stage_07_ctfe/env: CTFE_ENV_EMPTY, ctfe_bind_local_value
	../src/stage_07_ctfe/materialize:
		CtfeMaterializeError(CtfeCapturedLambda, CtfeLambdaSourceUnavailable),
		ctfe_materialize_parsed_expr,
		ctfe_materialize_value,
	../src/stage_07_ctfe/value:
		CtfeEnv,
		CtfeLambdaSource,
		CtfeValue,
		CtfeValueDesc(
			CtfeConstructorValue,
			CtfeDictValue,
			CtfeLambdaValue,
			CtfeListValue,
			CtfeRangeValue,
			CtfeRecordValue,
			CtfeTupleValue,
		),
		ctfe_bool,
		ctfe_char,
		ctfe_constructor_info,
		ctfe_float,
		ctfe_function_reference,
		ctfe_int,
		ctfe_string,
		ctfe_value,
		ctfe_void,
	test: TestSuite


pure func fixture_source_file() -> SourceFile:
	source_file("materialize.brp", "materialize", "VALUE = 1")


pure func fixture_source_span() -> SourceSpan:
	src: SourceFile = fixture_source_file()
	cursor: Cursor = source_cursor_at(src, 0)
	source_span(src, cursor, cursor)


pure func int_value(value: Int) -> CtfeValue:
	ctfe_int(fixture_source_span(), value)


pure func float_value(value: Float) -> CtfeValue:
	ctfe_float(fixture_source_span(), value)


pure func string_value(value: String) -> CtfeValue:
	ctfe_string(fixture_source_span(), value)


pure func bool_value(value: Bool) -> CtfeValue:
	ctfe_bool(fixture_source_span(), value)


pure func char_value(value: Int) -> CtfeValue:
	ctfe_char(fixture_source_span(), to_char(value))


pure func tuple_value(values: List[CtfeValue]) -> CtfeValue:
	ctfe_value(SemanticTupleType(values.map(
			func(value): value.typ,
		)), CtfeTupleValue(values), fixture_source_span())


pure func list_value(values: List[CtfeValue]) -> CtfeValue:
	ctfe_value(type_list(TYPE_INT), CtfeListValue(values), fixture_source_span())


pure func record_value(fields: List[(String, CtfeValue)]) -> CtfeValue:
	ctfe_value(
		SemanticNamedType("Box", []),
		CtfeRecordValue(fields),
		fixture_source_span(),
	)


pure func dict_value(entries: List[(CtfeValue, CtfeValue)]) -> CtfeValue:
	ctfe_value(
		SemanticNamedType(
			"Dict",
			[TYPE_STRING, TYPE_INT],
		),
		CtfeDictValue(entries),
		fixture_source_span(),
	)


pure func range_value(start: CtfeValue, end: CtfeValue) -> CtfeValue:
	ctfe_value(
		SemanticRangeType(TYPE_INT),
		CtfeRangeValue(start, end),
		fixture_source_span(),
	)


pure func constructor_value(
	name: String,
	args: List[CtfeValue],
	callable_id: Option[Int],
) -> CtfeValue:
	ctfe_value(
		SemanticNamedType("Option", [TYPE_INT]),
		CtfeConstructorValue({
			name = name,
			args = args,
			constructor_info = ctfe_constructor_info("Option", args.length(), callable_id),
		}),
		fixture_source_span(),
	)


pure func function_reference_value() -> CtfeValue:
	ctfe_function_reference(
		SemanticFunctionType(True, [TYPE_INT], TYPE_INT),
		fixture_source_span(),
		23,
		"increment",
		True,
	)


pure func lambda_source() -> CtfeLambdaSource:
	lambda_type = SemanticFunctionType(True, [], TYPE_INT)
	{
		is_pure = True,
		params = [],
		return_annotation = Some(TYPE_INT),
		body = TypedIntLiteralExpr(
			"42",
			fixture_source_span(),
			{
				source_type = None,
				origin = SynthesizedOrigin("ctfe_materialize_test"),
				value_slot = KeptValueSlot(TYPE_INT),
				proofs = UNREFINED_BINDING,
				resolved_call = None,
				resolved_definition_id = None,
				resource_dependencies = []
			},
		),
		span = fixture_source_span(),
		info = {
			source_type = None,
			origin = SynthesizedOrigin("ctfe_materialize_test"),
			value_slot = KeptValueSlot(lambda_type),
			proofs = UNREFINED_BINDING,
			resolved_call = None,
			resolved_definition_id = None,
			resource_dependencies = []
		}
	}


pure func lambda_expr() -> TypedExpr:
	source = lambda_source()
	TypedLambdaExpr(
		source.is_pure,
		source.params,
		source.return_annotation,
		source.body,
		source.span,
		source.info,
	)


pure func lambda_value_with_env(env: CtfeEnv) -> CtfeValue:
	source = lambda_source()
	ctfe_value(typed_expr_info_value_type(source.info), CtfeLambdaValue({
			source = source,
			env = env,
		}), source.span)


pure func lambda_value() -> CtfeValue:
	lambda_value_with_env(CTFE_ENV_EMPTY)


pure func captured_lambda_value() -> CtfeValue:
	lambda_value_with_env(
		ctfe_bind_local_value(
			CTFE_ENV_EMPTY,
			"offset",
			ctfe_int(fixture_source_span(), 3),
		),
	)


pure func materialized_type_is(value: CtfeValue, expected: SemanticType) -> Bool:
	match ctfe_materialize_value(value):
		Ok(materialized):
			types_equal(typed_expr_value_type(materialized), expected)
		Err(_):
			False


pure func materialize_error_is(error: CtfeMaterializeError, expected: CtfeMaterializeError) -> Bool:
	error == expected


func test_materializes_scalar_literals() -> Bool:
	int_ok = match ctfe_materialize_value(int_value(42)):
		Ok(TypedIntLiteralExpr(text, _, _)):
			text == "42"
		_:
			False

	float_ok = match ctfe_materialize_value(float_value(3.141592653589793)):
		Ok(TypedFloatLiteralExpr(text, _, _)):
			text == "3.141592653589793"
		_:
			False

	non_finite_float_ok = match ctfe_materialize_value(float_value(1.0 / 0.0)):
		Ok(TypedFloatLiteralExpr(text, _, _)):
			text == "inf"
		_:
			False

	negative_infinity_float_ok = match ctfe_materialize_value(float_value(-1.0 / 0.0)):
		Ok(TypedFloatLiteralExpr(text, _, _)):
			text == "-inf"
		_:
			False

	nan_float_ok = match ctfe_materialize_value(float_value(0.0 / 0.0)):
		Ok(TypedFloatLiteralExpr(text, _, _)):
			text == "nan"
		_:
			False

	bool_ok = match ctfe_materialize_value(bool_value(True)):
		Ok(TypedBoolLiteralExpr(value, _, _)):
			value
		_:
			False

	char_ok = match ctfe_materialize_value(char_value(65)):
		Ok(TypedCharLiteralExpr(value, _, _)):
			value == 65
		_:
			False

	string_ok = match ctfe_materialize_value(string_value("blorp")):
		Ok(TypedStringLiteralExpr(value, _, _)):
			value == "blorp"
		_:
			False

	void_ok = match ctfe_materialize_value(ctfe_void(fixture_source_span())):
		Ok(TypedVoidExpr(_, _)):
			True
		_:
			False

	(
		int_ok
		and float_ok
		and non_finite_float_ok
		and negative_infinity_float_ok
		and nan_float_ok
		and bool_ok
		and char_ok
		and string_ok
		and void_ok
		and materialized_type_is(int_value(1), TYPE_INT)
		and materialized_type_is(ctfe_void(fixture_source_span()), TYPE_VOID)
	)


func test_materializes_aggregate_literals() -> Bool:
	tuple_ok = match ctfe_materialize_value(tuple_value([int_value(1), string_value("x")])):
		Ok(TypedTupleExpr(items, _, _)):
			items.length() == 2
		_:
			False

	list_ok = match ctfe_materialize_value(list_value([int_value(1), int_value(2)])):
		Ok(TypedListExpr(items, _, _)):
			items.length() == 2
		_:
			False

	record_ok = match ctfe_materialize_value(record_value([("value", int_value(3))])):
		Ok(TypedRecordExpr(fields, _, _)):
			match fields.get(0):
				Some(field):
					field.name.text == "value"
				None:
					False
		_:
			False

	dict_ok = match ctfe_materialize_value(dict_value([(string_value("answer"), int_value(42))])):
		Ok(TypedDictExpr(entries, _, _)):
			entries.length() == 1
		_:
			False

	range_ok = match ctfe_materialize_value(range_value(int_value(0), int_value(3))):
		Ok(TypedRangeExpr(_, _, _, _)):
			True
		_:
			False

	tuple_ok and list_ok and record_ok and dict_ok and range_ok


func test_materializes_constructors() -> Bool:
	nullary_ok = match ctfe_materialize_value(constructor_value("None", [], Some(16))):
		Ok(TypedNameExpr(name, info)):
			name.text == "None" and match info.resolved_call:
				Some(call):
					match call.target:
						ResolvedDirectCall(callable_id, origin):
							match origin:
								CallableConstructor(parent_type):
									callable_id == 16 and parent_type == "Option"
								_:
									False
						_:
							False
				None:
					False
		_:
			False

	expr = ctfe_materialize_value(constructor_value("Some", [int_value(42)], Some(17)))

	call_ok = match expr:
		Ok(call_expr):
			match call_expr:
				TypedCallExpr(callee, args, _, _):
					callee_ok = match callee:
						TypedNameExpr(name, _):
							name.text == "Some"
						_:
							False

					resolved_ok = match typed_expr_resolved_call(call_expr):
						Some(call):
							match call.target:
								ResolvedDirectCall(callable_id, origin):
									match origin:
										CallableConstructor(parent_type):
											callable_id == 17 and parent_type == "Option"
										_:
											False
								_:
									False
						None:
							False

					callee_ok and args.length() == 1 and resolved_ok
				_:
					False
		_:
			False

	nullary_ok and call_ok


func test_materializes_function_references() -> Bool:
	value = function_reference_value()

	typed_ok = match ctfe_materialize_value(value):
		Ok(materialized):
			resolved_ok = match typed_expr_resolved_call(materialized):
				Some(call):
					match call.target:
						ResolvedDirectCall(callable_id, origin):
							match origin:
								CallableLocal:
									(
										callable_id == 23
										and call.instantiated_params.length() == 1
										and types_equal(call.instantiated_return, TYPE_INT)
									)
								_:
									False
						_:
							False
				None:
					False

			match materialized:
				TypedNameExpr(name, _):
					name.text == "increment" and resolved_ok
				_:
					False
		_:
			False

	parsed_ok = match ctfe_materialize_parsed_expr(value):
		Ok(ParsedNameExpr(name)):
			name.text == "increment"
		_:
			False

	typed_ok and parsed_ok


func test_materializes_lambda_without_inventing_parsed_source() -> Bool:
	typed_ok = match ctfe_materialize_value(lambda_value()):
		Ok(TypedLambdaExpr(_, _, _, _, _, _)):
			True
		_:
			False

	parsed_unavailable = match ctfe_materialize_parsed_expr(lambda_value()):
		Err(error):
			materialize_error_is(error, CtfeLambdaSourceUnavailable)
		_:
			False

	typed_ok and parsed_unavailable


func test_rejects_captured_lambda_materialization() -> Bool:
	match ctfe_materialize_value(captured_lambda_value()):
		Err(error):
			materialize_error_is(error, CtfeCapturedLambda)
		_:
			False


func test_rejects_captured_lambda_nested_in_aggregate() -> Bool:
	match ctfe_materialize_value(record_value([("callback", captured_lambda_value())])):
		Err(error):
			materialize_error_is(error, CtfeCapturedLambda)
		_:
			False


func test_materializes_parsed_literals() -> Bool:
	int_ok = match ctfe_materialize_parsed_expr(int_value(42)):
		Ok(ParsedIntLiteralExpr(text, _)):
			text == "42"
		_:
			False

	float_ok = match ctfe_materialize_parsed_expr(float_value(3.141592653589793)):
		Ok(ParsedFloatLiteralExpr(text, _)):
			text == "3.141592653589793"
		_:
			False

	bool_ok = match ctfe_materialize_parsed_expr(bool_value(True)):
		Ok(ParsedBoolLiteralExpr(value, _)):
			value
		_:
			False

	string_ok = match ctfe_materialize_parsed_expr(string_value("blorp")):
		Ok(ParsedStringLiteralExpr(value, _, _)):
			value == "blorp"
		_:
			False

	int_ok and float_ok and bool_ok and string_ok


func test_materializes_parsed_aggregates_and_constructors() -> Bool:
	tuple_ok = match ctfe_materialize_parsed_expr(tuple_value([int_value(1), string_value("x")])):
		Ok(ParsedTupleExpr(items, _)):
			items.length() == 2
		_:
			False

	list_ok = match ctfe_materialize_parsed_expr(list_value([int_value(1), int_value(2)])):
		Ok(ParsedListExpr(items, _)):
			items.length() == 2
		_:
			False

	record_ok = match ctfe_materialize_parsed_expr(record_value([("value", int_value(3))])):
		Ok(ParsedRecordExpr(fields, _)):
			match fields.get(0):
				Some(field):
					field.name.text == "value"
				None:
					False
		_:
			False

	dict_ok = match ctfe_materialize_parsed_expr(
		dict_value([(string_value("answer"), int_value(42))]),
	):
		Ok(ParsedDictExpr(entries, _)):
			match entries.get(0):
				Some(entry):
					match entry.key:
						ParsedStringLiteralExpr(text, _, _):
							text == "answer"
						_:
							False
				None:
					False
		_:
			False

	nullary_ok = match ctfe_materialize_parsed_expr(constructor_value("None", [], None)):
		Ok(ParsedNameExpr(name)):
			name.text == "None"
		_:
			False

	call_ok = match ctfe_materialize_parsed_expr(
		constructor_value(
			"Some",
			[int_value(4)],
			Some(9),
		),
	):
		Ok(ParsedCallExpr(callee, args, _)):
			callee_ok = match callee:
				ParsedNameExpr(name):
					name.text == "Some"
				_:
					False

			callee_ok and args.length() == 1
		_:
			False

	tuple_ok and list_ok and record_ok and dict_ok and nullary_ok and call_ok


tests: TestSuite = {
	description = "Compiler CTFE materialize",
	tests = [
		("materializes scalar literals", test_materializes_scalar_literals),
		("materializes aggregate literals", test_materializes_aggregate_literals),
		("materializes constructors", test_materializes_constructors),
		("materializes function references", test_materializes_function_references),
		(
			"materializes typed lambdas without inventing parsed source",
			test_materializes_lambda_without_inventing_parsed_source,
		),
		("rejects captured lambda materialization", test_rejects_captured_lambda_materialization),
		(
			"rejects captured lambda nested in aggregate",
			test_rejects_captured_lambda_nested_in_aggregate,
		),
		("materializes parsed literals", test_materializes_parsed_literals),
		(
			"materializes parsed aggregates and constructors",
			test_materializes_parsed_aggregates_and_constructors,
		),
	]
}
