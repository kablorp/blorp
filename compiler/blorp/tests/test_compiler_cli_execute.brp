import:
	../src/stage_03_parse/compiler_parser_bridge as ParserBridge
	../src/stage_03_parse/compiler_source_ast_finalize: FinalizedTypecheckProgram
	../src/stage_09_core/compiler_core_json:
		CoreCallKind(SelectedDirectCall, UserCall),
		CoreDecl(FunctionDecl),
		CoreExpr(CallExpr, LetExpr, LiteralExpr, VarExpr),
		CoreFunctionKind(UserFunction),
		CoreLiteral(IntLiteral, StringLiteral),
		CoreParam,
		CoreProgram,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType),
		CoreVar,
		core_program_to_json,
	../src/stage_09_core/compiler_core_traverse: immediate_core_expr_children
	../src/stage_09_core/compiler_semantic_worker_protocol:
		SEMANTIC_MIDDLE_DOMAIN,
		SEMANTIC_MIDDLE_SCHEMA_VERSION,
		semantic_middle_capability_name,
	../src/stage_10_backend/compiler_build_artifact:
		BuildNativeFeature(BuildRaylib, BuildTls),
		BuildOptimization(BuildFast),
		BuildRuntimeRequirement(BuildEmbeddedRuntime, BuildExternalRuntime),
	../src/stage_12_cli/compiler_cli: run_cli
	../src/stage_12_cli/compiler_cli_artifact_json: cli_run_plan_to_json
	../src/stage_12_cli/compiler_cli_compile_execute:
		CliCompileExecution(CliCompileArtifact, CliCompileStopped),
		CliCompilePreparation(CliCompilePreparationReady),
		execute_compile_plan,
		execute_run_plan,
		graph_native_features,
		prepare_compile_plan,
		prepare_compile_plan_with_frontend_policy,
		prepare_compile_plan_with_typed_validation,
	../src/stage_12_cli/compiler_cli_compile_frontend: CliFrontendCompilePolicy
	../src/stage_12_cli/compiler_cli_execute: execute_check_plan
	../src/stage_12_cli/compiler_cli_plan:
		CliFrontendGraphSource,
		CliFrontendImportEdge,
		CliFrontendModuleGraph,
		CliFrontendModuleOrigin(CliFrontendPkgModule, CliFrontendStdModule, CliFrontendUserModule),
		CliRunPlan(CliRunCheck, CliRunCompile, CliRunSource),
	../src/stage_12_cli/compiler_cli_typecheck: typecheck_frontend_root_only
	io: print_error
	json: JsonValue(JsonNumber, JsonObject, JsonString, JsonVector), get_field
	system: mkdir, remove_dir, remove_file, temp_dir, write_file
	test: TestSuite


pure func compiled_response_fixture() -> JsonValue:
	compiled_response_fixture_with_core(JsonObject([
		("kind", JsonString("program")),
		("decls", JsonVector([])),
		("foreign_includes", JsonVector([])),
	]))


pure func typecheck_program_fixture(
	path: String,
	module_name: String,
	source: String,
) -> FinalizedTypecheckProgram:
	ParserBridge.parsed_typecheck_source_bridge_artifact(path, module_name, source, False).program


pure func compiled_response_fixture_with_core(core: JsonValue) -> JsonValue:
	JsonObject([
		("schema", JsonNumber(to_float(SEMANTIC_MIDDLE_SCHEMA_VERSION))),
		("domain", JsonString(SEMANTIC_MIDDLE_DOMAIN)),
		("kind", JsonString("compiled")),
		("capabilities", JsonVector([
			JsonString("core_post_synth"),
			JsonString("core_pre_dce"),
			JsonString("rendered_stage_observations"),
		])),
		("core", core),
		("observations", JsonVector([])),
	])


pure func named_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


pure func function_decl(
	name: String,
	def_id: Int,
	params: List[CoreParam],
	return_type: CoreType,
	body: CoreExpr,
) -> CoreDecl:
	FunctionDecl({
		name = name,
		source_module = None,
		type_params = [],
		params = params,
		return_type = return_type,
		body = Some(body),
		is_pure = True,
		function_kind = UserFunction,
		def_id = def_id,
		loc = SyntheticSourceLoc,
	})


pure func mutable_string_owner_pre_dce_program() -> CoreProgram:
	desc: CoreVar = named_var("desc")
	read: CoreVar = named_var("read")
	string_type: CoreType = NamedType("String", [])
	int_type: CoreType = NamedType("Int", [])
	read_param: CoreParam = {
		name = named_var("value"),
		typ = string_type,
		loc = SyntheticSourceLoc
	}

	{
		decls = [function_decl(
				"read",
				2,
				[read_param],
				int_type,
				LiteralExpr(IntLiteral(1), int_type, SyntheticSourceLoc),
			), function_decl(
				"main",
				1,
				[],
				int_type,
				LetExpr(
					desc,
					True,
					string_type,
					LiteralExpr(StringLiteral("description"), string_type, SyntheticSourceLoc),
					CallExpr(
						UserCall("read", Some(2), []),
						VarExpr(
							read,
							NamedType("Function", []),
							SyntheticSourceLoc,
						),
						[VarExpr(desc, string_type, SyntheticSourceLoc)],
						int_type,
						SyntheticSourceLoc,
					),
				),
			)],
		foreign_includes = []
	}


func write_source(path: String) -> Bool:
	match write_file(path, "func main(args: List[String]) -> Int:\n\t0\n"):
		Ok(_):
			True
		Err(_):
			False


func write_desugar_source(path: String) -> Bool:
	match write_file(
		path,
		"pure func message() -> String:\n" + "\t\"early\" + \"boundary\"\n\n" + "func main(args: List[String]) -> Int:\n" + "\tprint(message())\n" + "\t0\n",
	):
		Ok(_):
			True
		Err(_):
			False


func write_debug_policy_source(path: String) -> Bool:
	source: String =
		|@debug_only
		|pure func inspect() -> Int:
		|	7
		|
		|pure func debug_policy_marker() -> Void:
		|	void
		|
		|func main(args: List[String]) -> Int:
		|	value: Int = inspect()
		|	debug:
		|		debug_policy_marker()
		|	value

	match write_file(path, source):
		Ok(_):
			True
		Err(_):
			False


private pure func call_targets_def_id(expr: CoreExpr, target_def_id: Int) -> Bool:
	direct_call: Bool = match expr:
		CallExpr(SelectedDirectCall(def_id), _, _, _, _):
			def_id == target_def_id
		CallExpr(UserCall(_, Some(def_id), _), _, _, _, _):
			def_id == target_def_id
		_:
			False

	(
		direct_call
		or immediate_core_expr_children(
			expr,
		).any(
			func(child): call_targets_def_id(child, target_def_id),
		)
	)


private pure func function_def_id(program: CoreProgram, name: String) -> Option[Int]:
	program.decls
		.filter_map(func(decl):
			match decl:
				FunctionDecl(function_info):
					if function_info.name == name:
						Some(function_info.def_id)
					else:
						None
				_:
					None
		)
		.get(0)


private pure func main_calls_def_id(program: CoreProgram, target_def_id: Int) -> Bool:
	program.decls.any(func(decl):
		match decl:
			FunctionDecl(function_info):
				(
					function_info.name == "main"
					and function_info.body
						.map(func(body): call_targets_def_id(body, target_def_id))
						.get_or(False)
				)
			_:
				False
	)


private pure func main_calls_debug_policy_marker(program: CoreProgram) -> Bool:
	function_def_id(program, "debug_policy_marker")
		.map(func(def_id): main_calls_def_id(program, def_id))
		.get_or(False)


func test_check_executes_without_host_plan() -> Bool:
	path: String = temp_dir() + "/blorp_cli_execute_check.brp"
	_ = remove_file(path)

	if not write_source(path):
		False
	else:
		plan = run_cli(["check", "--no-format", path])
		_ = remove_file(path)

		match plan:
			CliRunCheck(check_plan):
				result = execute_check_plan(check_plan)
				encoded = cli_run_plan_to_json(plan)

				(
					result.status == 0
					and result.stdout.contains("Type checking succeeded.")
					and result.stderr == ""
					and get_field(encoded, "error").is_some()
				)
			_:
				False


func test_check_reports_imported_module_errors() -> Bool:
	plan = run_cli([
		"check",
		"--no-format",
		"tests/test_compiler/typecheck/should_fail/module_undefined_identifier.brp",
	])

	match plan:
		CliRunCheck(check_plan):
			result = execute_check_plan(check_plan)

			result.status == 1 and result.stderr.contains("nonexistent_var")
		_:
			False


func cleanup_configured_std_root(std_dir: String) -> Void:
	_ = remove_file(std_dir + "/prelude.brp")
	_ = remove_file(std_dir + "/constants.brp")
	_ = remove_dir(std_dir)


func test_check_configured_std_root_uses_canonical_module_spans() -> Bool:
	std_dir: String = temp_dir() + "/blorp_cli_execute_configured_library"
	source_path: String = std_dir + "/constants.brp"
	cleanup_configured_std_root(std_dir)

	source: String =
		|ANSWER: Int = 42
		|
		|func main(args: List[String]) -> Int:
		|	ANSWER

	if not ((
		mkdir(std_dir)
		and write_file(std_dir + "/prelude.brp", "").is_ok()
		and write_file(source_path, source).is_ok()
	)):
		cleanup_configured_std_root(std_dir)
		False
	else:
		plan = run_cli([
			"check",
			"--no-format",
			"--std-dir",
			std_dir,
			source_path,
		])
		cleanup_configured_std_root(std_dir)

		match plan:
			CliRunCheck(check_plan):
				result = execute_check_plan(check_plan)

				result.status == 0 and result.stderr == ""
			_:
				False


pure func test_check_visits_all_roots_and_reports_shared_dependency_once() -> Bool:
	first_root: CliFrontendGraphSource = {
		path = "/project/first.brp",
		module_name = "first",
		source_text = "import:\n\tshared: broken\n\npure func first() -> Int: broken()",
		parsed_source = JsonObject([]),
		typecheck_program = typecheck_program_fixture(
			"/project/first.brp",
			"first",
			"import:\n\tshared: broken\n\npure func first() -> Int: broken()",
		),
		origin = CliFrontendUserModule
	}
	second_root: CliFrontendGraphSource = {
		path = "/project/second.brp",
		module_name = "second",
		source_text = "import:\n\tshared: broken\n\npure func second() -> Int: broken()",
		parsed_source = JsonObject([]),
		typecheck_program = typecheck_program_fixture(
			"/project/second.brp",
			"second",
			"import:\n\tshared: broken\n\npure func second() -> Int: broken()",
		),
		origin = CliFrontendUserModule
	}
	dependency: CliFrontendGraphSource = {
		path = "/project/shared.brp",
		module_name = "shared",
		source_text = "pure func broken() -> Int: missing_shared_value",
		parsed_source = JsonObject([]),
		typecheck_program = typecheck_program_fixture(
			"/project/shared.brp",
			"shared",
			"pure func broken() -> Int: missing_shared_value",
		),
		origin = CliFrontendUserModule
	}
	first_edge: CliFrontendImportEdge = {
		from_path = first_root.path,
		from_module = first_root.module_name,
		import_path = "shared",
		resolved_path = Some(dependency.path),
		resolved_module = Some(dependency.module_name),
		resolved_origin = Some(CliFrontendUserModule)
	}
	second_edge: CliFrontendImportEdge = {
		from_path = second_root.path,
		from_module = second_root.module_name,
		import_path = "shared",
		resolved_path = Some(dependency.path),
		resolved_module = Some(dependency.module_name),
		resolved_origin = Some(CliFrontendUserModule)
	}
	graph: CliFrontendModuleGraph = {
		context = {
			std_dir = None,
			source_packages = [],
			package_roots = []
		},
		roots = [first_root, second_root],
		modules = [dependency],
		import_edges = [first_edge, second_edge],
		diagnostics = []
	}
	result = execute_check_plan({
		args = [],
		graph = graph,
		options = {
			debug = False,
			dump_ast = False,
			dump_typed_ast = False,
			no_format = True,
			std_dir = None,
			paths = [first_root.path, second_root.path]
		},
	})

	(
		result.status == 1
		and result.stdout.contains("Checking /project/first.brp")
		and result.stdout.contains("Checking /project/second.brp")
		and result.stderr.count("missing_shared_value") == 1
	)


pure func test_check_root_only_returns_no_dependency_artifacts() -> Bool:
	root: CliFrontendGraphSource = {
		path = "/project/main.brp",
		module_name = "main",
		source_text = "import:\n\tdep: helper\n\nfunc main() -> Int: helper()",
		parsed_source = JsonObject([]),
		typecheck_program = typecheck_program_fixture(
			"/project/main.brp",
			"main",
			"import:\n\tdep: helper\n\nfunc main() -> Int: helper()",
		),
		origin = CliFrontendUserModule
	}
	dependency: CliFrontendGraphSource = {
		path = "/project/dep.brp",
		module_name = "dep",
		source_text = "pure func helper() -> Int: 1",
		parsed_source = JsonObject([]),
		typecheck_program = typecheck_program_fixture(
			"/project/dep.brp",
			"dep",
			"pure func helper() -> Int: 1",
		),
		origin = CliFrontendUserModule
	}
	edge: CliFrontendImportEdge = {
		from_path = root.path,
		from_module = root.module_name,
		import_path = "dep",
		resolved_path = Some(dependency.path),
		resolved_module = Some(dependency.module_name),
		resolved_origin = Some(CliFrontendUserModule)
	}
	graph: CliFrontendModuleGraph = {
		context = {
			std_dir = None,
			source_packages = [],
			package_roots = []
		},
		roots = [root],
		modules = [dependency],
		import_edges = [edge],
		diagnostics = []
	}

	typechecked = typecheck_frontend_root_only(graph, root, False)
	typechecked.modules.length() == 0


func test_compile_builds_one_typed_request_and_artifact() -> Bool:
	path: String = temp_dir() + "/blorp_cli_execute_compile.brp"
	_ = remove_file(path)

	if not write_source(path):
		False
	else:
		plan = run_cli(["compile", "--no-format", path])
		_ = remove_file(path)

		match plan:
			CliRunCompile(compile_plan):
				match execute_compile_plan(compile_plan, compiled_response_fixture()):
					CliCompileArtifact(request, artifact, _, _):
						(
							request.target_path == path
							and request.module_imports.any(
								func(module): module.module_name == "std/prelude",
							)
							and request.required_capabilities.length() == 3
							and request.require_main
							and artifact.c_code.length() > 0
							and artifact.runtime_requirement == BuildEmbeddedRuntime
							and artifact.source.path == path
							and artifact.compatibility.optimization == BuildFast
						)
					_:
						False
			_:
				False


func test_compile_worker_request_starts_after_blorp_synth() -> Bool:
	path: String = temp_dir() + "/blorp_cli_execute_post_synth.brp"
	_ = remove_file(path)

	if not write_desugar_source(path):
		False
	else:
		plan = run_cli(["compile", "--no-format", path])
		_ = remove_file(path)

		match plan:
			CliRunCompile(compile_plan):
				match prepare_compile_plan(compile_plan):
					Ok(CliCompilePreparationReady(prepared)):
						rendered: String = core_program_to_json(prepared.request.core).to_string()

						(
							rendered.contains("blorp_string_concat")
							and prepared.request.required_capabilities
								.map(semantic_middle_capability_name)
								.contains("core_post_synth")
						)
					_:
						False
			_:
				False


func test_compile_frontend_policy_allows_debug_calls_while_erasing_debug_blocks() -> Bool:
	path: String = temp_dir() + "/blorp_cli_execute_debug_policy.brp"
	_ = remove_file(path)

	if not write_debug_policy_source(path):
		False
	else:
		plan = run_cli(["compile", "--no-format", path])
		_ = remove_file(path)

		match plan:
			CliRunCompile(compile_plan):
				policy: CliFrontendCompilePolicy = {
					allow_debug_only_calls = True,
					retain_debug_blocks = False
				}

				match prepare_compile_plan_with_frontend_policy(compile_plan, policy):
					Ok(CliCompilePreparationReady(prepared)):
						if main_calls_debug_policy_marker(prepared.request.core):
							print_error("debug-policy marker call survived debug-block erasure")
							False
						else:
							True
					Err(errors):
						print_error(
							"policy-aware compile preparation failed:\n" + errors.join("\n"),
						)
						False
					Ok(_):
						print_error("policy-aware compile preparation stopped unexpectedly")
						False
			_:
				False


func test_compile_typed_validation_stops_before_core_preparation() -> Bool:
	path: String = temp_dir() + "/blorp_cli_execute_typed_validation.brp"
	_ = remove_file(path)

	if not write_source(path):
		False
	else:
		plan = run_cli(["compile", "--no-format", path])
		_ = remove_file(path)

		match plan:
			CliRunCompile(compile_plan):
				policy: CliFrontendCompilePolicy = {
					allow_debug_only_calls = False,
					retain_debug_blocks = False
				}

				match (
					prepare_compile_plan_with_typed_validation(
						compile_plan,
						policy,
						pure func(_): ["typed validation sentinel"],
					)
				):
					Err(errors):
						errors == ["typed validation sentinel"]
					Ok(_):
						False
			_:
				False


func test_early_stop_does_not_consult_worker_response() -> Bool:
	path: String = temp_dir() + "/blorp_cli_execute_early_stop.brp"
	_ = remove_file(path)

	if not write_desugar_source(path):
		False
	else:
		plan = run_cli([
			"compile",
			"--no-format",
			"--dump-core-after=desugar",
			"--stop-after=desugar",
			path,
		])
		_ = remove_file(path)

		match plan:
			CliRunCompile(compile_plan):
				match execute_compile_plan(compile_plan, JsonObject([])):
					CliCompileStopped(target_path, stage_name, rendered, observations):
						(
							target_path == path
							and stage_name == "desugar"
							and rendered.contains("blorp_string_concat")
							and observations.map(
								func(observation): observation.stage_name,
							) == ["desugar"]
						)
					_:
						False
			_:
				False


func test_run_builds_one_typed_request_and_artifact() -> Bool:
	path: String = temp_dir() + "/blorp_cli_execute_run.brp"
	_ = remove_file(path)

	if not write_source(path):
		False
	else:
		plan = run_cli([
			"run",
			"--no-format",
			"--profile",
			path,
		])
		_ = remove_file(path)

		match plan:
			CliRunSource(run_plan):
				encoded = cli_run_plan_to_json(plan)

				match execute_run_plan(run_plan, compiled_response_fixture()):
					CliCompileArtifact(request, artifact, _, _):
						(
							get_field(encoded, "error").is_some()
							and request.target_path == path
							and request.module_imports.any(
								func(module): module.module_name == "std/prelude",
							)
							and request.require_main
							and artifact.c_code.length() > 0
							and artifact.runtime_requirement == BuildExternalRuntime
							and artifact.compatibility.profile
						)
					_:
						False
			_:
				False


func test_compile_emits_completed_core_without_repeating_late_pipeline() -> Bool:
	path: String = temp_dir() + "/blorp_cli_execute_prepared_core.brp"
	_ = remove_file(path)

	if not write_source(path):
		False
	else:
		plan = run_cli(["compile", "--no-format", path])
		_ = remove_file(path)
		response: JsonValue = compiled_response_fixture_with_core(
			core_program_to_json(mutable_string_owner_pre_dce_program()),
		)

		match plan:
			CliRunCompile(compile_plan):
				match execute_compile_plan(compile_plan, response):
					CliCompileArtifact(_, artifact, _, _):
						artifact.c_code.count("blorp_release(desc);") == 1
					_:
						False
			_:
				False


pure func test_native_features_come_from_typed_graph() -> Bool:
	graph: CliFrontendModuleGraph = {
		context = {
			std_dir = None,
			source_packages = [],
			package_roots = []
		},
		roots = [
			{
				path = "/project/main.brp",
				module_name = "main",
				source_text = "",
				parsed_source = JsonObject([]),
				typecheck_program = typecheck_program_fixture("/project/main.brp", "main", ""),
				origin = CliFrontendUserModule
			},
		],
		modules = [
			{
				path = "/builtin/raylib.brp",
				module_name = "pkg/raylib/core",
				source_text = "",
				parsed_source = JsonObject([]),
				typecheck_program = typecheck_program_fixture(
					"/builtin/raylib.brp",
					"pkg/raylib/core",
					"",
				),
				origin = CliFrontendPkgModule("raylib")
			},
			{
				path = "/project/std/net/tls.brp",
				module_name = "std/net/tls",
				source_text = "",
				parsed_source = JsonObject([]),
				typecheck_program = typecheck_program_fixture(
					"/project/std/net/tls.brp",
					"std/net/tls",
					"",
				),
				origin = CliFrontendStdModule
			},
			{
				path = "/other/raylib.brp",
				module_name = "not_raylib",
				source_text = "",
				parsed_source = JsonObject([]),
				typecheck_program = typecheck_program_fixture(
					"/other/raylib.brp",
					"not_raylib",
					"",
				),
				origin = CliFrontendUserModule
			},
			{
				path = "/other/tls.brp",
				module_name = "std/net/tls",
				source_text = "",
				parsed_source = JsonObject([]),
				typecheck_program = typecheck_program_fixture("/other/tls.brp", "std/net/tls", ""),
				origin = CliFrontendUserModule
			},
		],
		import_edges = [],
		diagnostics = []
	}

	graph_native_features(graph) == [BuildRaylib, BuildTls]


tests: TestSuite = {
	description = "Blorp CLI in-process execution",
	tests = [
		("check executes without host plan", test_check_executes_without_host_plan),
		("check reports imported module errors", test_check_reports_imported_module_errors),
		(
			"check configured std root uses canonical module spans",
			test_check_configured_std_root_uses_canonical_module_spans,
		),
		(
			"check visits all roots and reports a shared dependency once",
			test_check_visits_all_roots_and_reports_shared_dependency_once,
		),
		(
