import:
	../compiler_type:
		CompilerDimOp(CompilerDimAdd, CompilerDimMultiply),
		CompilerType(
			CompilerArrayType,
			CompilerConstIntType,
			CompilerDimOpType,
			CompilerFunctionType,
			CompilerMetaType,
			CompilerNamedType,
			CompilerRangeType,
			CompilerTypeVar,
			CompilerVarDimsType,
		),
		compiler_type_bool,
		compiler_type_int,
		compiler_type_string,
	../compiler_type_json:
		compiler_dim_op_to_json,
		compiler_optional_type_to_json,
		compiler_type_list_to_json,
		compiler_type_to_json,
	json: JsonValue(JsonBool, JsonNull, JsonNumber, JsonObject, JsonString, JsonVector)
	test: TestSuite


pure func json_values_equal(left: JsonValue, right: JsonValue) -> Bool:
	left.to_string() == right.to_string()


func test_named_type_json_preserves_args() -> Bool:
	encoded = compiler_type_to_json(
		CompilerNamedType(
			"Result",
			[compiler_type_int(), compiler_type_string()],
		),
	)
	expected = JsonObject([
		("kind", JsonString("named")),
		("name", JsonString("Result")),
		("args", JsonVector([JsonObject([
					("kind", JsonString("named")),
					("name", JsonString("Int")),
					("args", JsonVector([])),
				]), JsonObject([
					("kind", JsonString("named")),
					("name", JsonString("String")),
					("args", JsonVector([])),
				])])),
	])

	json_values_equal(encoded, expected)


func test_function_type_json_preserves_purity_and_return_type() -> Bool:
	encoded = compiler_type_to_json(
		CompilerFunctionType(
			True,
			[compiler_type_int(), compiler_type_string()],
			compiler_type_bool(),
		),
	)
	expected = JsonObject([
		("kind", JsonString("function")),
		("pure", JsonBool(True)),
		("params", JsonVector([
				compiler_type_to_json(compiler_type_int()),
				compiler_type_to_json(compiler_type_string()),
			])),
		("return_type", compiler_type_to_json(compiler_type_bool())),
	])

	json_values_equal(encoded, expected)


func test_array_type_json_preserves_dimension_expression() -> Bool:
	dim = CompilerDimOpType(CompilerDimAdd, CompilerVarDimsType("#N"), CompilerConstIntType(1))
	encoded = compiler_type_to_json(CompilerArrayType(compiler_type_int(), [dim]))
	expected = JsonObject([
		("kind", JsonString("array")),
		("element", compiler_type_to_json(compiler_type_int())),
		("dims", JsonVector([compiler_type_to_json(dim)])),
	])

	json_values_equal(encoded, expected)


func test_type_json_covers_remaining_structural_variants() -> Bool:
	values = compiler_type_list_to_json([
		CompilerTypeVar("T"),
		CompilerRangeType(CompilerConstIntType(3)),
		CompilerMetaType(7),
	])
	expected = JsonVector([JsonObject([
			("kind", JsonString("type_var")),
			("name", JsonString("T")),
		]), JsonObject([
			("kind", JsonString("range")),
			("inner", compiler_type_to_json(CompilerConstIntType(3))),
		]), JsonObject([("kind", JsonString("meta")), ("id", JsonNumber(7.0))])])

	json_values_equal(values, expected)


func test_optional_type_json_and_dim_op_tags() -> Bool:
	(
		json_values_equal(compiler_optional_type_to_json(None), JsonNull)
		and json_values_equal(
			compiler_optional_type_to_json(Some(compiler_type_int())),
			compiler_type_to_json(compiler_type_int()),
		)
		and json_values_equal(compiler_dim_op_to_json(CompilerDimMultiply), JsonString("multiply"))
	)


tests: TestSuite = {
	description = "Compiler type JSON",
	tests = [
		("named type JSON preserves args", test_named_type_json_preserves_args),
		(
			"function type JSON preserves purity and return type",
			test_function_type_json_preserves_purity_and_return_type,
		),
		(
			"array type JSON preserves dimension expression",
			test_array_type_json_preserves_dimension_expression,
		),
		(
			"type JSON covers remaining structural variants",
			test_type_json_covers_remaining_structural_variants,
		),
		("optional type JSON and dim op tags", test_optional_type_json_and_dim_op_tags),
	]
}
