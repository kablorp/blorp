import:
	../src/stage_12_cli/cli_test_result:
		CLI_TEST_ARTIFACT_RESULT_PREFIX,
		completed_cli_test_artifact_result,
		parse_cli_test_artifact_result,
	process as Process: ProcessExit(Exited, Signaled)
	test: TestSuite


pure func test_parses_exact_artifact_result() -> Bool:
	match parse_cli_test_artifact_result(
		"user output\n" + CLI_TEST_ARTIFACT_RESULT_PREFIX + "passed=6 failed=1 tests=7\n",
	):
		Some(result):
			result.passed == 6 and result.failed == 1 and result.tests == 7
		None:
			False


pure func test_rejects_inconsistent_artifact_result() -> Bool:
	parse_cli_test_artifact_result(
		CLI_TEST_ARTIFACT_RESULT_PREFIX + "passed=7 failed=1 tests=7",
	).is_none()


pure func test_uses_last_valid_artifact_result() -> Bool:
	output: String = CLI_TEST_ARTIFACT_RESULT_PREFIX + "passed=99 failed=0 tests=99\n" + (CLI_TEST_ARTIFACT_RESULT_PREFIX + "passed=2 failed=0 tests=2\n")

	match parse_cli_test_artifact_result(output):
		Some(result):
			result.passed == 2 and result.failed == 0 and result.tests == 2
		None:
			False


func test_abnormal_exit_preserves_completed_counts() -> Bool:
	partial = parse_cli_test_artifact_result(
		CLI_TEST_ARTIFACT_RESULT_PREFIX + "passed=4 failed=1 tests=5",
	)

	match partial:
		Some(result):
			timed_out = completed_cli_test_artifact_result(Some(result), Process.TimedOut)
			signaled = completed_cli_test_artifact_result(Some(result), Signaled(9))
			valid: Bool = (
				timed_out.passed == 4
				and timed_out.failed == 2
				and timed_out.tests == 6
				and signaled.passed == timed_out.passed
				and signaled.failed == timed_out.failed
				and signaled.tests == timed_out.tests
			)

			if not valid:
				print_error(
					"unexpected abnormal counts: timeout=" + timed_out.passed.to_string() + "/" + timed_out.failed.to_string() + "/" + timed_out.tests.to_string() + " signal=" + signaled.passed.to_string() + "/" + signaled.failed.to_string() + "/" + signaled.tests.to_string(),
				)

			valid
		None:
			False


pure func test_normal_failing_exit_preserves_reported_counts() -> Bool:
	partial = parse_cli_test_artifact_result(
		CLI_TEST_ARTIFACT_RESULT_PREFIX + "passed=4 failed=1 tests=5",
	)

	match partial:
		Some(result):
			completed_cli_test_artifact_result(Some(result), Exited(1)) == result
		None:
			False


tests: TestSuite = {
	description = "Compiler CLI test artifact result",
	tests = [
		("parses exact artifact result", test_parses_exact_artifact_result),
		("rejects inconsistent artifact result", test_rejects_inconsistent_artifact_result),
		("uses last valid artifact result", test_uses_last_valid_artifact_result),
		("abnormal exit preserves completed counts", test_abnormal_exit_preserves_completed_counts),
		(
			"normal failing exit preserves reported counts",
			test_normal_failing_exit_preserves_reported_counts,
		),
	]
}
