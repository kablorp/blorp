	)

	(
		count_loops(fused) == 1
		and count_list_call("range", fused) == 0
		and count_list_call("map", fused) == 0
		and count_list_call("fold_left", fused) == 0
		and count_intrinsic("list_alloc", fused) == 0
	)


pure func test_list_collect_uses_owned_scalar_store() -> Bool:
	source: CoreExpr = variable("xs", LIST_INT)
	predicate: CoreExpr = callback("predicate", [TY_INT], TY_BOOL)
	fused: CoreExpr = fuse(filter_call(source, predicate, LIST_INT))

	(
		count_handoffs(fused) == 1
		and count_intrinsic("list_handoff_set_source_slot", fused) == 0
		and count_intrinsic("list_handoff_set_owned", fused) == 1
	)


pure func test_filter_map_collect_uses_owned_store() -> Bool:
	source: CoreExpr = variable("xs", LIST_INT)
	mapper: CoreExpr = callback(
		"filter_mapper",
		[TY_INT],
		NamedType("Option", [TY_INT]),
	)
	fused: CoreExpr = fuse(filter_map_call(source, mapper, LIST_INT))

	(
		count_handoffs(fused) == 1
		and count_intrinsic("list_handoff_set_owned", fused) == 1
		and count_intrinsic("list_handoff_set_source_slot", fused) == 0
	)


pure func test_filter_map_policy_tracks_borrowed_payload() -> Bool:
	source: CoreExpr = variable("items", LIST_STRING)
	mapper: CoreExpr = callback(
		"filter_mapper",
		[TY_STRING],
		NamedType("Option", [TY_STRING]),
	)

	match collection_pipeline_plan(filter_map_call(source, mapper, LIST_STRING)):
		Some(plan):
			match collection_collect_policy_for_plan(
				collection_pipeline_model(EMPTY_PROGRAM),
				plan,
			):
				Some(policy):
					(
						policy.source_access == CollectionBorrowManagedAlias
						and policy.filter_map_payload_policy == CollectionBorrowedPayloadAliasFromOwnedOption
					)
				None:
					False
		None:
			False


pure func test_managed_filter_map_collect_uses_owned_store() -> Bool:
	source: CoreExpr = variable("items", LIST_STRING)
	mapper: CoreExpr = callback(
		"filter_mapper",
		[TY_STRING],
		NamedType("Option", [TY_STRING]),
	)
	fused: CoreExpr = fuse(filter_map_call(source, mapper, LIST_STRING))

	(
		count_handoffs(fused) == 1
		and count_list_call("filter_map", fused) == 0
		and count_intrinsic("list_handoff_set_owned", fused) == 1
		and count_intrinsic("list_handoff_set_source_slot", fused) == 0
	)


pure func test_managed_filter_map_plan_is_recognized() -> Bool:
	source: CoreExpr = variable("items", LIST_STRING)
	mapper: CoreExpr = callback(
		"filter_mapper",
