	match collection_same_type_source_access_policy(
		collection_pipeline_model(EMPTY_PROGRAM),
		option_int,
		[option_int],
	):
		CollectionEligible(policy):
			policy.source_access == CollectionBindUnboxedValue
		CollectionIneligible(_):
			False


pure func test_stack_option_types_compare_equal() -> Bool:
	option_int: CoreType = NamedType("Option", [TY_INT])

	match collection_same_type_source_access_policy(
		collection_pipeline_model(EMPTY_PROGRAM),
		option_int,
		[option_int],
	):
		CollectionIneligible(CollectionTypesDiffer):
			False
		_:
			True


pure func test_arc_boxed_int128_collect_is_not_lowered() -> Bool:
	source: CoreExpr = variable("items", LIST_INT128)
	predicate: CoreExpr = callback("predicate", [TY_INT128], TY_BOOL)
	mapper: CoreExpr = callback("mapper", [TY_INT128], TY_INT128)
	fused: CoreExpr = fuse(
		map_call(
			filter_call(source, predicate, LIST_INT128),
			mapper,
			LIST_INT128,
		),
	)

	count_handoffs(fused) == 0 and count_list_call("map", fused) == 1


pure func test_unknown_layout_has_no_collect_policy() -> Bool:
	source: CoreExpr = variable("items", LIST_WIDGET)
	predicate: CoreExpr = callback("predicate", [TY_WIDGET], TY_BOOL)

	match collection_pipeline_plan(filter_call(source, predicate, LIST_WIDGET)):
		Some(plan):
			collection_collect_policy_for_plan(
				collection_pipeline_model(EMPTY_PROGRAM),
				plan,
			) == None
		None:
			False


pure func test_registered_heap_record_uses_borrow_policy() -> Bool:
	widget_decl: CoreHeapRecordDecl = {
		abi_type = None,
		name = "Widget",
		type_params = [],
		fields = [],
		loc = SyntheticSourceLoc
	}
	program: CoreProgram = {
		decls = [HeapRecordDecl(widget_decl)],
		foreign_includes = []
	}
	source: CoreExpr = variable("items", LIST_WIDGET)
	predicate: CoreExpr = callback("predicate", [TY_WIDGET], TY_BOOL)

	match collection_pipeline_plan(filter_call(source, predicate, LIST_WIDGET)):
		Some(plan):
			match collection_collect_policy_for_plan(collection_pipeline_model(program), plan):
				Some(policy):
					policy.source_access == CollectionBorrowManagedAlias
				None:
					False
		None:
			False


pure func test_heap_record_alias_handoff_preserves_release_metadata() -> Bool:
	alias_type: CoreType = NamedType("WidgetAlias", [])
	program: CoreProgram = {
		decls = [TypeAliasDecl({
				abi_type = None,
				name = "WidgetAlias",
				type_params = [],
				target = TY_WIDGET,
				is_opaque = False,
				loc = SyntheticSourceLoc,
		}), HeapRecordDecl({
				abi_type = None,
				name = "Widget",
				type_params = [],
				fields = [],
				loc = SyntheticSourceLoc,
			})],
		foreign_includes = []
	}
	source_type: CoreType = NamedType("List", [alias_type])
	source: CoreExpr = variable("items", source_type)
	predicate: CoreExpr = callback("predicate", [alias_type], TY_BOOL)
	fused: CoreExpr = fuse_collection_expr(
		collection_pipeline_model(program),
		filter_call(source, predicate, source_type),
	)

	count_expr(fused, pure func(candidate):
		match candidate:
			ListHandoffExpr(handoff, _, _):
				match handoff.layout:
					PointerListStorage:
						handoff.elem_needs_release
					_:
						False
			_:
				False
	) == 1


pure func test_alias_policy_uses_canonical_type() -> Bool:
	alias_decl: CoreTypeAliasDecl = {
		abi_type = None,
		name = "Count",
		type_params = [],
		target = TY_INT,
		is_opaque = False,
		loc = SyntheticSourceLoc
	}
	program: CoreProgram = {
		decls = [TypeAliasDecl(alias_decl)],
		foreign_includes = []
	}
	source: CoreExpr = variable(
		"items",
		NamedType("List", [TY_COUNT]),
	)
	mapper: CoreExpr = callback("mapper", [TY_COUNT], TY_INT)

	match collection_pipeline_plan(map_call(source, mapper, LIST_INT)):
		Some(plan):
			match collection_collect_policy_for_plan(collection_pipeline_model(program), plan):
				Some(policy):
					(
						policy.source_access == CollectionBindUnboxedValue
						and core_mono_type_equal(policy.result_element_type, TY_INT)
						and policy.filter_map_payload_policy == CollectionNoFilterMapPayload
					)
				None:
					False
		None:
			False


pure func test_alias_pipeline_plan_is_recognized() -> Bool:
	source: CoreExpr = variable(
		"items",
		NamedType("List", [TY_COUNT]),
	)
	mapper: CoreExpr = callback("mapper", [TY_COUNT], TY_INT)

	collection_pipeline_plan(map_call(source, mapper, LIST_INT)).is_some()


pure func test_alias_type_is_canonicalized() -> Bool:
	alias_decl: CoreTypeAliasDecl = {
		abi_type = None,
		name = "Count",
		type_params = [],
		target = TY_INT,
		is_opaque = False,
		loc = SyntheticSourceLoc
	}
	program: CoreProgram = {
		decls = [TypeAliasDecl(alias_decl)],
		foreign_includes = []
	}

	match collection_canonical_type(collection_pipeline_model(program), TY_COUNT):
		NamedType("Int", []):
			True
		_:
			False


pure func test_no_capture_lambda_is_inlined() -> Bool:
	param: CoreParam = {
		name = core_var("value"),
		typ = TY_INT,
		loc = SyntheticSourceLoc
	}
	lambda: CoreExpr = LambdaExpr(
		[param],
		TY_INT,
		VarExpr(param.name, TY_INT, SyntheticSourceLoc),
		True,
		FunctionType(True, [TY_INT], TY_INT),
		SyntheticSourceLoc,
	)
	fused: CoreExpr = fuse(map_call(variable("items", LIST_INT), lambda, LIST_INT))

	count_handoffs(fused) == 1 and count_closure_calls(fused) == 0


pure func test_generated_names_use_compiler_namespace() -> Bool:
	source: CoreExpr = variable("$blorp$collection_pipeline$6$source$1", LIST_INT)
	predicate: CoreExpr = callback("predicate", [TY_INT], TY_BOOL)
	fused: CoreExpr = fuse(filter_call(source, predicate, LIST_INT))

	count_expr(fused, pure func(candidate):
		match candidate:
			ListHandoffExpr(handoff, _, _):
				handoff.source_var.name.starts_with("$blorp$collection_pipeline$")
			_:
				False
	) == 1


