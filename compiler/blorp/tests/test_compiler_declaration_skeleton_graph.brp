private enum TestDeclarationSourceKind:
	TestRecordTypeSource
	TestUnionTypeSource
	TestBuiltinTypeSource
	TestAliasTypeSource
	TestConstructorSource
	TestFunctionSource
	TestForeignFunctionSource
	TestGlobalSource
	TestTraitSource
	TestTraitMethodSource
	TestImplementationSource
	TestImplementationMethodSource
	TestDefaultImplementationMethodSource


private pure func finalized_program(
	path: String,
	module_name: String,
	source: String,
) -> FinalizedTypecheckProgram:
	ParserBridge.parsed_typecheck_source_bridge_artifact(path, module_name, source, False).program


private pure func module_load_candidate(
	path: String,
	module_path: String,
	source: String,
) -> CompilerModuleLoadCandidate:
	compiler_module_load_candidate(
		compiler_resolved_module_identity_from_resolver(module_path, CompilerUserModule),
		finalized_program(path, module_path, source),
	)


private pure func accept_empty_view(
	scope: CompilerPreparedModuleScope,
) -> CompilerBoundModuleViewBinding:
	CompilerBoundModuleViewReady(
		COMPILER_MODULE_VIEW_EMPTY,
		prepared_module_program(compiler_prepared_module_scope_module(scope)),
		COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
		[],
	)


private pure func bound_graph() -> Option[CompilerBoundModuleGraph]:
	bound_graph_from_source(
		"record Box {value: Int}\n\nunion Signal:\n\tReady\n\tBusy(Int)\n\ntype NativeWord = builtin\n\ntype alias BoxAlias = Box\n\npure func answer() -> Int:\n\t42\n\nforeign:\n\tpure func native_floor(value: Float) -> Float = \"floor\"\n\ncount: Int = 1\n\ntrait Measure:\n\tpure func measure(value: Self) -> Int\n\tpure func doubled(value: Self) -> Int: measure(value) * 2\n\nimplements Measure for Box:\n\tpure func measure(value: Box) -> Int:\n\t\tvalue.value\n\nprivate record Hidden {value: Int}",
	)


private pure func bound_graph_from_source(source: String) -> Option[CompilerBoundModuleGraph]:
	target = module_load_candidate("main.brp", "app/main", source)

	match compiler_indexed_graph_build(target, []):
		Err(_):
			None
		Ok(indexed):
			match compiler_bound_module_graph_build(indexed, [], accept_empty_view):
				Err(_):
					None
				Ok(bound):
					Some(bound)


private pure func skeleton_graph_errors(
	source: String,
) -> List[CompilerDeclarationSkeletonGraphError]:
	match bound_graph_from_source(source):
		None:
			[]
		Some(bound):
			match compiler_declaration_skeleton_graph_build(bound):
				Ok(_):
					[]
				Err(errors):
					errors


private pure func skeleton_kinds(
	skeletons: List[CompilerDeclarationSkeleton],
) -> List[CompilerDeclarationSkeletonKind]:
	skeletons.map(compiler_declaration_skeleton_kind)


private pure func skeleton_names(skeletons: List[CompilerDeclarationSkeleton]) -> List[String]:
	skeletons.map(compiler_declaration_skeleton_name)


private pure func skeleton_source_kind(
	skeleton: CompilerDeclarationSkeleton,
) -> TestDeclarationSourceKind:
	match compiler_declaration_skeleton_source(skeleton):
		CompilerTypeDeclarationSourceValue(CompilerRecordTypeSource(_)):
			TestRecordTypeSource
		CompilerTypeDeclarationSourceValue(CompilerUnionTypeSource(_)):
			TestUnionTypeSource
		CompilerTypeDeclarationSourceValue(CompilerBuiltinTypeSource(_)):
			TestBuiltinTypeSource
		CompilerTypeDeclarationSourceValue(CompilerAliasTypeSource(_)):
			TestAliasTypeSource
		CompilerConstructorDeclarationSourceValue(_, _):
			TestConstructorSource
		CompilerCallableDeclarationSourceValue(CompilerFunctionCallableSource(_)):
			TestFunctionSource
		CompilerCallableDeclarationSourceValue(CompilerForeignCallableSource(_)):
			TestForeignFunctionSource
		CompilerCallableDeclarationSourceValue(CompilerImplementationMethodCallableSource(_, _)):
			TestImplementationMethodSource
		CompilerCallableDeclarationSourceValue(CompilerDefaultImplementationMethodCallableSource(_, _, _)):
			TestDefaultImplementationMethodSource
		CompilerGlobalDeclarationSourceValue(_):
			TestGlobalSource
		CompilerTraitDeclarationSourceValue(_):
			TestTraitSource
		CompilerTraitMethodDeclarationSourceValue(_):
			TestTraitMethodSource
		CompilerImplementationDeclarationSourceValue(_):
			TestImplementationSource


private pure func skeleton_named(
	skeletons: List[CompilerDeclarationSkeleton],
	name: String,
) -> Option[CompilerDeclarationSkeleton]:
	var result: Option[CompilerDeclarationSkeleton] = None

	for skeleton in skeletons:
		if compiler_declaration_skeleton_name(skeleton) == name:
			result = Some(skeleton)
			break

	result


func test_skeleton_graph_preserves_category_and_source_order() -> Bool:
	match bound_graph():
		None:
			False
		Some(bound):
			match compiler_declaration_skeleton_graph_build(bound):
				Err(_):
					False
				Ok(graph):
					skeletons = compiler_declaration_skeleton_graph_skeletons(graph)

					(
						skeleton_kinds(
							skeletons,
						) == [
							CompilerTypeSkeletonKind,
							CompilerTypeSkeletonKind,
							CompilerConstructorSkeletonKind,
							CompilerConstructorSkeletonKind,
							CompilerTypeSkeletonKind,
							CompilerTypeSkeletonKind,
							CompilerCallableSkeletonKind,
							CompilerCallableSkeletonKind,
							CompilerGlobalSkeletonKind,
							CompilerTraitSkeletonKind,
							CompilerTraitMethodSkeletonKind,
							CompilerTraitMethodSkeletonKind,
							CompilerImplementationSkeletonKind,
							CompilerCallableSkeletonKind,
							CompilerCallableSkeletonKind,
							CompilerTypeSkeletonKind,
						]
						and skeleton_names(
							skeletons,
						) == [
							"Box",
							"Signal",
							"Ready",
							"Busy",
							"NativeWord",
							"BoxAlias",
							"answer",
							"native_floor",
							"count",
							"Measure",
							"measure",
							"doubled",
							"Measure",
							"doubled",
							"measure",
							"Hidden",
						]
					)


func test_skeleton_graph_round_trips_exact_identity_and_visibility() -> Bool:
	match bound_graph():
		None:
			False
		Some(bound):
			match compiler_declaration_skeleton_graph_build(bound):
				Err(_):
					False
				Ok(graph):
					skeletons = compiler_declaration_skeleton_graph_skeletons(graph)
					type_skeletons = compiler_declaration_skeleton_graph_type_skeletons(graph)
					callable_skeletons = compiler_declaration_skeleton_graph_callable_skeletons(
						graph,
					)
					global_skeletons = compiler_declaration_skeleton_graph_global_skeletons(graph)
					implementation_skeletons = compiler_declaration_skeleton_graph_implementation_skeletons(
						graph,
					)
					first = skeletons.get(0)
					hidden = skeleton_named(skeletons, "Hidden")
					all_ids_round_trip = skeletons.all(
						func(
							skeleton,
						): compiler_declaration_skeleton_graph_find(
							graph,
							compiler_declaration_skeleton_id(skeleton),
						).is_some(),
					)
					all_type_ids_round_trip = type_skeletons.all(func(type_skeleton):
						compiler_declaration_skeleton_graph_find_type(
							graph,
							compiler_type_id_module_identity(type_skeleton.id),
							compiler_type_id_name(type_skeleton.id),
						).is_some()
					)

					match (first, hidden):
						(Some(first_skeleton), Some(hidden_skeleton)):
							(
								all_ids_round_trip
								and all_type_ids_round_trip
								and type_skeletons.length() == 5
								and callable_skeletons.length() == 4
								and global_skeletons.length() == 1
								and implementation_skeletons.length() == 1
								and compiler_declaration_skeleton_visibility(
									first_skeleton,
								) == CompilerPublicDeclaration
								and compiler_declaration_skeleton_visibility(
									hidden_skeleton,
								) == CompilerPrivateDeclaration
								and compiler_declaration_skeleton_graph_find(
									graph,
									compiler_declaration_skeleton_id(
										first_skeleton,
									),
								).map(compiler_declaration_skeleton_name) == Some("Box")
							)
						_:
							False


func test_skeleton_graph_preserves_category_aligned_source() -> Bool:
	match bound_graph():
		None:
			False
		Some(bound):
			match compiler_declaration_skeleton_graph_build(bound):
				Err(_):
					False
				Ok(graph):
					compiler_declaration_skeleton_graph_skeletons(
						graph,
					).map(
						skeleton_source_kind,
					) == [
						TestRecordTypeSource,
						TestUnionTypeSource,
						TestConstructorSource,
						TestConstructorSource,
						TestBuiltinTypeSource,
						TestAliasTypeSource,
						TestFunctionSource,
						TestForeignFunctionSource,
						TestGlobalSource,
						TestTraitSource,
						TestTraitMethodSource,
						TestTraitMethodSource,
						TestImplementationSource,
						TestDefaultImplementationMethodSource,
						TestImplementationMethodSource,
						TestRecordTypeSource,
					]


func test_constructor_source_owns_exact_parent_type_identity() -> Bool:
	match bound_graph():
		None:
			False
		Some(bound):
			match compiler_declaration_skeleton_graph_build(bound):
				Err(_):
					False
				Ok(graph):
					module_identity = compiler_bound_module_identity(
						compiler_bound_module_graph_target(bound),
					)
					signal = compiler_declaration_skeleton_graph_find_type(
						graph,
						module_identity,
						"Signal",
					)
					busy = skeleton_named(
						compiler_declaration_skeleton_graph_skeletons(graph),
						"Busy",
					)

					match (signal, busy):
						(Some(signal_type), Some(busy_skeleton)):
							match compiler_declaration_skeleton_source(busy_skeleton):
								CompilerConstructorDeclarationSourceValue(parent_type_id, _):
									compiler_type_ids_equal(parent_type_id, signal_type.id)
								_:
									False
						_:
							False


func test_skeleton_graph_rejects_duplicate_type_namespace() -> Bool:
	errors = skeleton_graph_errors("record Item {value: Int}\n\nunion Item:\n\tReady")
	messages = errors.map(compiler_declaration_skeleton_graph_error_message)

	match errors:
		[CompilerDuplicateTypeDeclaration(_, name, _)]:
			(
				name == "Item"
				and messages == ["duplicate type declaration 'Item' in module 'app/main'"]
			)
		_:
			False


func test_skeleton_graph_rejects_duplicate_trait_namespace() -> Bool:
	errors = skeleton_graph_errors(
		"trait Measure:\n\tpure func measure(value: Self) -> Int\n\ntrait Measure:\n\tpure func other(value: Self) -> Int",
	)

	match errors:
		[CompilerDuplicateTraitDeclaration(_, name, _)]:
			name == "Measure"
		_:
			False


func test_skeleton_graph_rejects_duplicate_constructor_within_parent() -> Bool:
	errors = skeleton_graph_errors("union Signal:\n\tReady\n\tReady")

	match errors:
		[CompilerDuplicateConstructorDeclaration(parent, name, _)]:
			compiler_type_id_name(parent) == "Signal" and name == "Ready"
		_:
			False


func test_skeleton_graph_preserves_duplicate_diagnostic_order() -> Bool:
	errors = skeleton_graph_errors(
		"record Item {value: Int}\n\nunion Item:\n\tReady\n\ntrait Measure:\n\tpure func measure(value: Self) -> Int\n\ntrait Measure:\n\tpure func other(value: Self) -> Int\n\nunion Signal:\n\tReady\n\tReady",
	)

	match errors:
		[CompilerDuplicateTypeDeclaration(_, type_name, _), CompilerDuplicateTraitDeclaration(_, trait_name, _), CompilerDuplicateConstructorDeclaration(parent, constructor_name, _)]:
			(
				type_name == "Item"
				and trait_name == "Measure"
				and compiler_type_id_name(parent) == "Signal"
				and constructor_name == "Ready"
			)
		_:
			False


func test_skeleton_graph_allows_same_constructor_name_across_parents() -> Bool:
	match bound_graph_from_source("union First:\n\tReady\n\nunion Second:\n\tReady"):
		None:
			False
		Some(bound):
			match compiler_declaration_skeleton_graph_build(bound):
				Err(_):
					False
				Ok(graph):
					compiler_declaration_skeleton_graph_skeletons(graph)
						.filter(func(skeleton):
							compiler_declaration_skeleton_name(skeleton) == "Ready"
						)
						.length() == 2


func test_skeleton_graph_places_target_before_dependencies() -> Bool:
	target = module_load_candidate("main.brp", "app/main", "record Target {value: Int}")
	dependency = module_load_candidate(
		"dependency.brp",
		"app/dependency",
		"record Dependency {value: Int}",
	)

	match compiler_indexed_graph_build(target, [dependency]):
		Err(_):
			False
		Ok(indexed):
			match compiler_bound_module_graph_build(indexed, ["app/dependency"], accept_empty_view):
				Err(_):
					False
				Ok(bound):
					match compiler_declaration_skeleton_graph_build(bound):
						Err(_):
							False
						Ok(graph):
							skeleton_names(
								compiler_declaration_skeleton_graph_skeletons(
									graph,
								),
							) == ["Target", "Dependency"]


func test_skeleton_graph_excludes_parser_recovery_modules() -> Bool:
	target = module_load_candidate("main.brp", "app/main", "record Valid {value: Int}")
	recovery_source = "record RecoveryOnly {value: Int}\n\nfunc broken("
	recovery_program = finalized_program("recovery.brp", "app/recovery", recovery_source)
	recovery = compiler_module_load_candidate(
		compiler_resolved_module_identity_from_resolver("app/recovery", CompilerUserModule),
		recovery_program,
	)

	if not parsed_program_has_errors(finalized_typecheck_program_ast(recovery_program)):
		False
	else:
		match compiler_indexed_graph_build(target, [recovery]):
			Err(_):
				False
			Ok(indexed):
				match compiler_bound_module_graph_build(
					indexed,
					["app/recovery"],
					accept_empty_view,
				):
					Err(_):
						False
					Ok(bound):
						match compiler_declaration_skeleton_graph_build(bound):
							Err(_):
								False
							Ok(graph):
								skeleton_names(
									compiler_declaration_skeleton_graph_skeletons(
										graph,
									),
								) == ["Valid"]


tests: TestSuite = {
	description = "Compiler declaration skeleton graph",
	tests = [
		(
			"preserves category and source order",
			test_skeleton_graph_preserves_category_and_source_order,
		),
		(
			"round trips exact identity and visibility",
			test_skeleton_graph_round_trips_exact_identity_and_visibility,
		),
		(
			"preserves category-aligned source",
			test_skeleton_graph_preserves_category_aligned_source,
		),
		(
			"constructor source owns exact parent type identity",
			test_constructor_source_owns_exact_parent_type_identity,
		),
		("rejects duplicate type namespace", test_skeleton_graph_rejects_duplicate_type_namespace),
		(
			"rejects duplicate trait namespace",
			test_skeleton_graph_rejects_duplicate_trait_namespace,
		),
		(
			"rejects duplicate constructor within parent",
			test_skeleton_graph_rejects_duplicate_constructor_within_parent,
		),
		(
			"preserves duplicate diagnostic order",
			test_skeleton_graph_preserves_duplicate_diagnostic_order,
		),
		(
			"allows same constructor name across parents",
			test_skeleton_graph_allows_same_constructor_name_across_parents,
		),
		(
			"places target before dependencies",
			test_skeleton_graph_places_target_before_dependencies,
		),
		("excludes parser recovery modules", test_skeleton_graph_excludes_parser_recovery_modules),
	]
}
