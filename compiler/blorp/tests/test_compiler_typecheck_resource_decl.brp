import:
	../src/stage_01_file_io/compiler_source:
		CompilerCursor,
		CompilerSourceFile,
		CompilerSourceSpan,
		compiler_source_cursor_at,
		compiler_source_file,
		compiler_source_span,
	../src/stage_03_parse/compiler_parsed_ast:
		ParsedDecl(FunctionParsedDecl),
		ParsedExpr(ParsedBuiltinExpr, ParsedIntLiteralExpr),
		ParsedFunctionAnnotation(ParsedResourceResultOrdinaryAnnotation),
		ParsedIdentifier,
		ParsedParam,
		ParsedParamBinder(ParsedParamNameBinder),
		ParsedProgram,
		ParsedTypeExpr(ParsedNamedType, ParsedTupleType),
		parsed_identifier,
	../src/stage_05_types/compiler_env:
		CompilerResourceArgPolicy(CompilerAllowResourceArgs),
		CompilerSymbolKind(CompilerFuncSymbolKind),
		compiler_env_lookup,
	../src/stage_06_typecheck/compiler_typecheck_decl:
		compiler_typecheck_prescan_program,
		compiler_typecheck_register_program_signature_decls,
	../src/stage_06_typecheck/compiler_typecheck_state:
		CompilerTypecheckState,
		compiler_typecheck_state_add_known_resource_type_name,
		compiler_typecheck_state_empty,
	test: TestSuite


pure func source_file() -> CompilerSourceFile:
	compiler_source_file("resource_decl.brp", "resource_decl", "func main(): 1")


pure func source_span() -> CompilerSourceSpan:
	src: CompilerSourceFile = source_file()
	cursor: CompilerCursor = compiler_source_cursor_at(src, 0)
	compiler_source_span(src, cursor, cursor)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, source_span())


pure func int_expr() -> ParsedExpr:
	ParsedIntLiteralExpr("1", source_span())


pure func int_type() -> ParsedTypeExpr:
	ParsedNamedType(ident("Int"), [], source_span())


pure func resource_type() -> ParsedTypeExpr:
	ParsedNamedType(ident("CheckpointReader"), [], source_span())


pure func nested_resource_type() -> ParsedTypeExpr:
	ParsedTupleType(
		[
			int_type(),
			ParsedTupleType(
				[int_type(), resource_type()],
				source_span(),
			),
		],
		source_span(),
	)


pure func fallible_stream_type() -> ParsedTypeExpr:
	ParsedNamedType(
		ident("FallibleStream"),
		[int_type(), int_type()],
		source_span(),
	)


pure func named_param(name: String, type_expr: ParsedTypeExpr) -> ParsedParam:
	{
		binder = ParsedParamNameBinder(ident(name)),
		type_expr = Some(type_expr),
		span = source_span()
	}


pure func function_signature_decl(
	name: String,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
) -> ParsedDecl:
	FunctionParsedDecl({
		name = ident(name),
		type_params = [],
		params = params,
		return_type = return_type,
		dim_constraints = [],
		body = Some(int_expr()),
		is_pure = False,
		annotations = [],
		doc = None,
		span = source_span(),
	})


pure func builtin_function_signature_decl(
	name: String,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	annotations: List[ParsedFunctionAnnotation],
) -> ParsedDecl:
	FunctionParsedDecl({
		name = ident(name),
		type_params = [],
		params = params,
		return_type = return_type,
		dim_constraints = [],
		body = Some(ParsedBuiltinExpr(None, source_span())),
		is_pure = False,
		annotations = annotations,
		doc = None,
		span = source_span(),
	})


pure func program(decls: List[ParsedDecl]) -> ParsedProgram:
	{
		source = source_file(),
		decls = decls,
		diagnostics = []
	}


pure func resource_state() -> CompilerTypecheckState:
	compiler_typecheck_state_add_known_resource_type_name(
		compiler_typecheck_state_empty(),
		"CheckpointReader",
	)


func test_resource_signature_boundaries_and_builtin_resource_policy() -> Bool:
	reader = resource_type()
	nested_reader = nested_resource_type()
	bad_program = program([
		function_signature_decl(
			"use_reader",
			[named_param("reader", nested_reader)],
			Some(int_type()),
		),
		function_signature_decl("make_reader", [], Some(nested_reader)),
	])
	bad_state = compiler_typecheck_register_program_signature_decls(
		compiler_typecheck_prescan_program(resource_state(), bad_program),
		bad_program,
	)
	good_program = program(
		[
			builtin_function_signature_decl(
				"read_one",
				[named_param("reader", reader)],
				Some(int_type()),
				[ParsedResourceResultOrdinaryAnnotation],
			),
		],
	)
	good_state = compiler_typecheck_register_program_signature_decls(
		compiler_typecheck_prescan_program(resource_state(), good_program),
		good_program,
	)
	stream_program = program(
		[
			builtin_function_signature_decl(
				"collect_result",
				[named_param("self", fallible_stream_type())],
				Some(int_type()),
				[ParsedResourceResultOrdinaryAnnotation],
			),
		],
	)
	stream_state = compiler_typecheck_register_program_signature_decls(
		compiler_typecheck_prescan_program(compiler_typecheck_state_empty(), stream_program),
		stream_program,
	)

	resource_policy_ok: Bool = match compiler_env_lookup(good_state.env, "read_one"):
		Some(symbol):
			match symbol.kind:
				CompilerFuncSymbolKind(info):
					match info.resource_args:
						CompilerAllowResourceArgs(CompilerResourceResultOrdinary):
							True
						_:
							False
				_:
					False
		None:
			False

	stream_policy_ok: Bool = match compiler_env_lookup(stream_state.env, "collect_result"):
		Some(symbol):
			match symbol.kind:
				CompilerFuncSymbolKind(info):
					match info.resource_args:
						CompilerAllowResourceArgs(CompilerResourceResultOrdinary):
							True
						_:
							False
				_:
					False
		None:
			False

	(
		bad_state.errors.length() == 2
		and bad_state.errors
			.get_or(0, "")
			.contains("parameter 'reader' cannot contain a resource type")
		and bad_state.errors
			.get_or(1, "")
			.contains("return type cannot contain a resource type")
		and good_state.errors.length() == 0
		and resource_policy_ok
		and stream_state.errors.length() == 0
		and stream_policy_ok
	)


tests: TestSuite = {
	description = "compiler typecheck resource declarations",
	tests = [
		(
			"resource signature boundaries and builtin resource policy",
			test_resource_signature_boundaries_and_builtin_resource_policy,
		),
	]
}
