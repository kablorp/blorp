import:
	../src/stage_12_cli/cli_test_batch:
		CliTestPartitionPolicy(BoundedSanitizedTestPartition, MaximalCompatibleTestPartition),
		batch_test_source_candidates,
	../src/stage_12_cli/cli_test_discovery: CliTestSourcePath
	test: TestSuite


private pure func sized_candidate(
	index: Int,
	module_name: String,
	source_bytes: Int,
) -> CliTestSourcePath:
	path: String = "/tmp/test_${index}.brp"
	{
		source_path = path,
		io_path = path,
		canonical_path = path,
		module_name = module_name,
		source_bytes = source_bytes,
		is_leak_baseline_program = False
	}


private pure func candidate(index: Int, module_name: String) -> CliTestSourcePath:
	sized_candidate(index, module_name, 1024)


private pure func candidates(count: Int) -> List[CliTestSourcePath]:
	var result: List[CliTestSourcePath] = []

	for index in 0..count:
		result = result.append(candidate(index, "test_${index}"))

	result


private pure func flattened_source_paths(batches: List[List[CliTestSourcePath]]) -> List[String]:
	var paths: List[String] = []

	for batch in batches:
		for item in batch:
			paths = paths.append(item.source_path)

	paths


private pure func partition(candidates: List[CliTestSourcePath]) -> List[List[CliTestSourcePath]]:
	batch_test_source_candidates(candidates, MaximalCompatibleTestPartition)


pure func test_unique_sources_share_one_compilation() -> Bool:
	batches = partition(candidates(17))

	(
		batches.length() == 1
		and batches
			.get(0)
			.map(func(batch): batch.length() == 17)
			.get_or(False)
	)


pure func test_repeated_module_names_start_a_new_batch() -> Bool:
	inputs: List[CliTestSourcePath] = [
		candidate(0, "shared"),
		candidate(1, "unique"),
		candidate(2, "shared"),
	]
	batches = partition(inputs)

	(
		batches.length() == 2
		and batches
			.get(0)
			.map(func(batch):
				flattened_source_paths([batch]) == ["/tmp/test_0.brp", "/tmp/test_1.brp"]
			)
			.get_or(False)
		and batches
			.get(1)
			.map(func(batch):
				flattened_source_paths([batch]) == ["/tmp/test_2.brp"]
			)
			.get_or(False)
	)


pure func test_batching_preserves_candidate_identity_and_order() -> Bool:
	inputs: List[CliTestSourcePath] = candidates(67)
	batches = partition(inputs)

	flattened_source_paths(batches) == inputs.map(func(item): item.source_path)


pure func test_empty_and_large_unique_inputs_do_not_create_empty_batches() -> Bool:
	empty_batches = partition([])
	large_batches = partition(candidates(1000))

	empty_batches.length() == 0 and large_batches.length() == 1


pure func test_sanitized_sources_retain_bounded_compilations() -> Bool:
	batches = batch_test_source_candidates(candidates(17), BoundedSanitizedTestPartition)

	(
		batches.length() == 3
		and batches
			.get(0)
			.map(func(batch): batch.length() == 8)
			.get_or(False)
		and batches
			.get(1)
			.map(func(batch): batch.length() == 8)
			.get_or(False)
		and batches
			.get(2)
			.map(func(batch): batch.length() == 1)
			.get_or(False)
	)


pure func test_oversized_sanitized_source_uses_a_singleton_compilation() -> Bool:
	inputs: List[CliTestSourcePath] = [
		sized_candidate(0, "first", 1),
		sized_candidate(1, "oversized", 512 * 1024 + 1),
		sized_candidate(2, "last", 1),
	]
	batches = batch_test_source_candidates(inputs, BoundedSanitizedTestPartition)

	(
		batches.length() == 3
		and batches
			.get(0)
			.map(func(batch): batch.length() == 1)
			.get_or(False)
		and batches
			.get(1)
			.map(func(batch): batch.length() == 1)
			.get_or(False)
		and batches
			.get(2)
			.map(func(batch): batch.length() == 1)
			.get_or(False)
	)


tests: TestSuite = {
	description = "Compiler CLI test batching",
	tests = [
		("unique sources share one compilation", test_unique_sources_share_one_compilation),
		("repeated module names start a new batch", test_repeated_module_names_start_a_new_batch),
		(
			"batching preserves candidate identity and order",
			test_batching_preserves_candidate_identity_and_order,
		),
		(
			"empty and large unique inputs do not create empty batches",
			test_empty_and_large_unique_inputs_do_not_create_empty_batches,
		),
		(
			"sanitized sources retain bounded compilations",
			test_sanitized_sources_retain_bounded_compilations,
		),
		(
			"oversized sanitized source uses a singleton compilation",
			test_oversized_sanitized_source_uses_a_singleton_compilation,
		),
	]
}
