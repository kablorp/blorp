import:
	../src/stage_12_cli/cli_args: CliTestMode(CliTestAll, CliTestDocOnly, CliTestSuiteOnly)
	../src/stage_12_cli/cli_test_batch: batch_test_source_candidates
	../src/stage_12_cli/cli_test_discovery: CliTestSourcePath
	test: TestSuite


private pure func candidate(index: Int, module_name: String) -> CliTestSourcePath:
	path: String = "/tmp/test_${index}.brp"
	{
		source_path = path,
		io_path = path,
		canonical_path = path,
		module_name = module_name,
		is_leak_baseline_program = False
	}


private pure func candidates(count: Int) -> List[CliTestSourcePath]:
	var result: List[CliTestSourcePath] = []

	for index in 0..count:
		result = result.append(candidate(index, "test_${index}"))

	result


private pure func flattened_source_paths(batches: List[List[CliTestSourcePath]]) -> List[String]:
	var paths: List[String] = []

	for batch in batches:
		for item in batch:
			paths = paths.append(item.source_path)

	paths


pure func test_suite_only_batches_use_the_larger_source_limit() -> Bool:
	batches = batch_test_source_candidates(candidates(33), CliTestSuiteOnly)

	(
		batches.length() == 2
		and batches
			.get(0)
			.map(func(batch): batch.length() == 32)
			.get_or(False)
		and batches
			.get(1)
			.map(func(batch): batch.length() == 1)
			.get_or(False)
	)


pure func test_doctest_and_mixed_batches_keep_the_conservative_limit() -> Bool:
	doctest_batches = batch_test_source_candidates(candidates(33), CliTestDocOnly)
	mixed_batches = batch_test_source_candidates(candidates(33), CliTestAll)

	(
		doctest_batches.length() == 3
		and mixed_batches.length() == 3
		and doctest_batches
			.get(0)
			.map(func(batch): batch.length() == 16)
			.get_or(False)
		and mixed_batches
			.get(1)
			.map(func(batch): batch.length() == 16)
			.get_or(False)
	)


pure func test_repeated_module_names_start_a_new_batch() -> Bool:
	inputs: List[CliTestSourcePath] = [
		candidate(0, "shared"),
		candidate(1, "unique"),
		candidate(2, "shared"),
	]
	batches = batch_test_source_candidates(inputs, CliTestSuiteOnly)

	(
		batches.length() == 2
		and batches
			.get(0)
			.map(func(batch):
				flattened_source_paths([batch]) == ["/tmp/test_0.brp", "/tmp/test_1.brp"]
			)
			.get_or(False)
		and batches
			.get(1)
			.map(func(batch):
				flattened_source_paths([batch]) == ["/tmp/test_2.brp"]
			)
			.get_or(False)
	)


pure func test_batching_preserves_candidate_identity_and_order() -> Bool:
	inputs: List[CliTestSourcePath] = candidates(67)
	batches = batch_test_source_candidates(inputs, CliTestSuiteOnly)

	flattened_source_paths(batches) == inputs.map(func(item): item.source_path)


pure func test_empty_and_exact_boundaries_do_not_create_empty_batches() -> Bool:
	empty_batches = batch_test_source_candidates([], CliTestSuiteOnly)
	doctest_boundary = batch_test_source_candidates(candidates(16), CliTestDocOnly)
	mixed_over_boundary = batch_test_source_candidates(candidates(17), CliTestAll)
	suite_boundary = batch_test_source_candidates(candidates(32), CliTestSuiteOnly)
	suite_over_boundary = batch_test_source_candidates(candidates(33), CliTestSuiteOnly)

	(
		empty_batches.length() == 0
		and doctest_boundary.length() == 1
		and mixed_over_boundary.length() == 2
		and suite_boundary.length() == 1
		and suite_over_boundary.length() == 2
	)


tests: TestSuite = {
	description = "Compiler CLI test batching",
	tests = [
		(
			"TestSuite-only batches use the larger source limit",
			test_suite_only_batches_use_the_larger_source_limit,
		),
		(
			"doctest and mixed batches keep the conservative source limit",
			test_doctest_and_mixed_batches_keep_the_conservative_limit,
		),
		("repeated module names start a new batch", test_repeated_module_names_start_a_new_batch),
		(
			"batching preserves candidate identity and order",
			test_batching_preserves_candidate_identity_and_order,
		),
		(
			"empty and exact boundaries do not create empty batches",
			test_empty_and_exact_boundaries_do_not_create_empty_batches,
		),
	]
}
