import:
	../src/stage_05_types/compiler_env:
		CompilerFuncOrigin(CompilerUserDefinedFunc),
		CompilerPurity(CompilerPure),
		CompilerResourceArgPolicy(CompilerRejectResourceArgs),
		CompilerTraitDef,
		compiler_env_add_trait,
		compiler_env_empty,
		compiler_env_get_trait,
		compiler_func_symbol,
		compiler_trait_def,
		compiler_trait_method_sig,
	../src/stage_05_types/compiler_generic_params: make_bound_type_param
	../src/stage_05_types/compiler_type:
		CompilerDimOp(CompilerDimAdd),
		CompilerType(
			CompilerArrayType,
			CompilerConstIntType,
			CompilerDimOpType,
			CompilerFunctionType,
			CompilerNamedType,
			CompilerRangeType,
			CompilerTupleType,
		),
		compiler_canonical_module_type_name,
		compiler_type_bool,
		compiler_type_int,
		compiler_type_string,
		compiler_types_equal,
	../src/stage_05_types/compiler_type_resolution: compiler_resolve_qualified_type_names
	../src/stage_06_typecheck/compiler_typecheck_decl:
		compiler_resolve_imported_type_aliases_from_bindings,
	../src/stage_06_typecheck/compiler_typecheck_state:
		CompilerImportedNameBinding,
		CompilerTypecheckTypeHome,
	memory: get_mem_stats, reset_mem_stats
	test: TestSuite


private pure func runtime_owned_string(text: String) -> String:
	text.substring(0, text.length())


private pure func nested_type_with_runtime_owned_names() -> CompilerType:
	CompilerNamedType(runtime_owned_string("List"), [CompilerArrayType(
				CompilerNamedType(runtime_owned_string("String"), []),
				[CompilerConstIntType(4)],
			)])


private pure func unchanged_nested_type_tree() -> CompilerType:
	CompilerFunctionType(True, [CompilerTupleType([
				CompilerNamedType(runtime_owned_string("List"), [compiler_type_string()]),
				CompilerArrayType(
					compiler_type_int(),
					[
						CompilerDimOpType(
							CompilerDimAdd,
							CompilerConstIntType(2),
							CompilerConstIntType(2),
						),
					],
				),
			])], CompilerRangeType(compiler_type_int()))


private pure func nested_type_tree_with_name(name: String) -> CompilerType:
	CompilerFunctionType(True, [CompilerTupleType([
				CompilerArrayType(
					CompilerNamedType("Keep", []),
					[
						CompilerDimOpType(
							CompilerDimAdd,
							CompilerRangeType(CompilerNamedType(name, [])),
							CompilerConstIntType(1),
						),
					],
				),
				CompilerNamedType("Keep", []),
			])], compiler_type_int())


private pure func imported_name_bindings() -> List[CompilerImportedNameBinding]:
	[
		{
			local_name = "Imported",
			module_path = "pkg/module",
			original_name = "Source"
		},
	]


private pure func imported_type_homes() -> List[CompilerTypecheckTypeHome]:
	[
		{
			type_name = "Imported",
			module_path = "pkg/module",
			imported = True
		},
	]


private pure func trait_lookup_after_environment_release() -> Option[CompilerTraitDef]:
	nested_type = nested_type_with_runtime_owned_names()
	method = compiler_trait_method_sig(
		runtime_owned_string("render"),
		[nested_type],
		nested_type,
		True,
	)
	env = compiler_env_add_trait(
		compiler_env_empty(),
		compiler_trait_def(
			103,
			runtime_owned_string("Renderable"),
			[runtime_owned_string("Stringable")],
			[method],
		),
	)

	compiler_env_get_trait(env, "Renderable")


func test_trait_lookup_shares_without_deep_copy() -> Bool:
	nested_type: CompilerType = CompilerNamedType(
		"List",
		[CompilerArrayType(compiler_type_string(), [CompilerConstIntType(4)])],
	)
	method = compiler_trait_method_sig("render", [nested_type], nested_type, True)
	env = compiler_env_add_trait(
		compiler_env_empty(),
		compiler_trait_def(101, "Renderable", ["Stringable"], [method]),
	)
	reset_mem_stats()
	found = compiler_env_get_trait(env, "Renderable")
	stats = get_mem_stats()

	match found:
		Some(trait_def):
			(
				stats.total_allocations <= 1
				and trait_def.name == "Renderable"
				and trait_def.supertraits == ["Stringable"]
				and match trait_def.methods.get(0):
					Some(found_method):
						found_method.name == "render" and compiler_types_equal(
							found_method.params.get_or(0, compiler_type_int()),
							nested_type,
						) and compiler_types_equal(found_method.return_type, nested_type)
					None:
						False
			)
		None:
			False


func test_trait_lookup_retains_dynamic_values_and_preserves_cow() -> Bool:
	expected_type: CompilerType = CompilerNamedType(
		"List",
		[CompilerArrayType(compiler_type_string(), [CompilerConstIntType(4)])],
	)

	match trait_lookup_after_environment_release():
		Some(trait_def):
			extended_methods = trait_def.methods.append(
				compiler_trait_method_sig(
					"extra",
					[],
					compiler_type_int(),
					True,
				),
			)

			match trait_def.methods.get(0):
				Some(method):
					(
						trait_def.name == "Renderable"
						and trait_def.supertraits == ["Stringable"]
						and method.name == "render"
						and compiler_types_equal(
							method.params.get_or(0, compiler_type_int()),
							expected_type,
						)
						and compiler_types_equal(method.return_type, expected_type)
						and trait_def.methods.length() == 1
						and extended_methods.length() == 2
					)
				None:
					False
		None:
			False


func test_function_symbol_shares_nested_values_without_deep_copy() -> Bool:
	nested_type: CompilerType = CompilerFunctionType(
		True,
		[CompilerNamedType("List", [nested_type_with_runtime_owned_names()])],
		compiler_type_bool(),
	)
	type_params = [make_bound_type_param("T", [])]
	param_names = [Some("value")]
	dim_constraints = [(nested_type, nested_type)]
	reset_mem_stats()
	symbol = compiler_func_symbol(
		102,
		nested_type,
		type_params,
		param_names,
		CompilerPure,
		CompilerUserDefinedFunc,
		CompilerRejectResourceArgs,
		None,
		dim_constraints,
		None,
		False,
	)
	stats = get_mem_stats()

	constraint_preserved = match symbol.dim_constraints.get(0):
		Some(constraint):
			(
				compiler_types_equal(constraint[0], nested_type)
				and compiler_types_equal(constraint[1], nested_type)
			)
		None:
			False

	(
		stats.total_allocations <= 1
		and compiler_types_equal(symbol.func_type, nested_type)
		and symbol.type_params.length() == 1
		and symbol.param_names == param_names
		and constraint_preserved
	)


func test_qualified_type_resolution_shares_unchanged_tree() -> Bool:
	module_aliases = [("Unused", "pkg/unused")]
	typ = unchanged_nested_type_tree()
	reset_mem_stats()
	resolved = compiler_resolve_qualified_type_names(module_aliases, typ)
	stats = get_mem_stats()

	-- The changed-only recursive path allocates four times; rebuilding this
	-- representative tree allocated 16 times.
	stats.total_allocations <= 4 and compiler_types_equal(resolved, typ)


func test_qualified_type_resolution_changes_one_leaf_without_mutating_source() -> Bool:
	source = nested_type_tree_with_name("Alias.Target")
	resolved = compiler_resolve_qualified_type_names([("Alias", "pkg/module")], source)

	(
		compiler_types_equal(source, nested_type_tree_with_name("Alias.Target"))
		and compiler_types_equal(
			resolved,
			nested_type_tree_with_name(
				compiler_canonical_module_type_name(
					"pkg/module",
					"Target",
				),
			),
		)
	)


func test_imported_type_resolution_shares_unchanged_tree() -> Bool:
	imported_names = imported_name_bindings()
	type_homes = imported_type_homes()
	typ = unchanged_nested_type_tree()
	reset_mem_stats()
	resolved = compiler_resolve_imported_type_aliases_from_bindings(imported_names, type_homes, typ)
	stats = get_mem_stats()

	-- The same four ownership allocations remain; rebuilding this tree allocated 21 times.
	stats.total_allocations <= 4 and compiler_types_equal(resolved, typ)


func test_imported_type_resolution_changes_one_leaf_without_mutating_source() -> Bool:
	imported_names = imported_name_bindings()
	type_homes = imported_type_homes()
	source = nested_type_tree_with_name("Imported")
	resolved = compiler_resolve_imported_type_aliases_from_bindings(
		imported_names,
		type_homes,
		source,
	)

	(
		compiler_types_equal(source, nested_type_tree_with_name("Imported"))
		and compiler_types_equal(
			resolved,
			nested_type_tree_with_name(
				compiler_canonical_module_type_name(
					"pkg/module",
					"Source",
				),
			),
		)
	)


tests: TestSuite = {
	description = "Compiler immutable sharing",
	tests = [
		("trait lookup shares without deep copy", test_trait_lookup_shares_without_deep_copy),
		(
			"trait lookup retains dynamic values and preserves COW",
			test_trait_lookup_retains_dynamic_values_and_preserves_cow,
		),
		(
			"function symbol shares nested values without deep copy",
			test_function_symbol_shares_nested_values_without_deep_copy,
		),
		(
			"qualified type resolution shares unchanged tree",
			test_qualified_type_resolution_shares_unchanged_tree,
		),
		(
			"qualified type resolution changes one leaf without mutating source",
			test_qualified_type_resolution_changes_one_leaf_without_mutating_source,
		),
		(
			"imported type resolution shares unchanged tree",
			test_imported_type_resolution_shares_unchanged_tree,
		),
		(
			"imported type resolution changes one leaf without mutating source",
			test_imported_type_resolution_changes_one_leaf_without_mutating_source,
		),
	]
}
