import:
	../src/stage_05_types/env:
		FuncOrigin(UserDefinedFunc),
		Purity(Pure),
		ResourceArgPolicy(RejectResourceArgs),
		TraitDef,
		env_add_trait,
		env_empty,
		env_get_trait,
		func_symbol,
		trait_def,
		trait_method_sig,
	../src/stage_05_types/generic_params: make_bound_type_param
	../src/stage_05_types/semantic_type:
		SemanticDimOp(SemanticDimAdd),
		SemanticType(
			SemanticArrayType,
			SemanticConstIntType,
			SemanticDimOpType,
			SemanticFunctionType,
			SemanticNamedType,
			SemanticRangeType,
			SemanticTupleType,
		),
		canonical_module_type_name,
		type_bool,
		type_int,
		type_string,
		types_equal,
	../src/stage_05_types/type_resolution: resolve_qualified_type_names
	../src/stage_06_typecheck/typecheck_decl: resolve_imported_type_aliases_from_bindings
	../src/stage_06_typecheck/typecheck_state:
		CompilerImportedNameBinding,
		CompilerTypecheckTypeHome,
	../src/stage_09_core/core_consume_specialize as CoreConsumeSpecialize
	../src/stage_09_core/core_json:
		CoreDecl(FunctionDecl, TypeAliasDecl),
		CoreExpr(CastExpr, LetExpr, LiteralExpr, VarExpr),
		CoreFunctionKind(UserFunction),
		CoreLiteral(IntLiteral),
		CoreParam,
		CoreProgram,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType),
		CoreVar,
	../src/stage_09_core/core_perceus: insert_drops_program
	memory: get_mem_stats, reset_mem_stats
	test: TestSuite


-- These ceilings include pass bookkeeping and output construction. Before Core
-- values were shared, the same fixtures allocated 140 and 2,835 objects.
-- Known coverage limit: resolver scope and resource-cleanup list sharing are
-- behavior-tested in their pass suites, but do not have isolated allocation
-- ceilings because surrounding Core reconstruction dominates those operations.
private MAX_CONSUME_SPECIALIZE_SHARING_ALLOCATIONS: Int = 16

private MAX_PERCEUS_SHARING_ALLOCATIONS: Int = 384

private MAX_PERCEUS_TYPE_DEPTH_ALLOCATION_GROWTH: Int = 8


private record CoreRewriteMeasurement {
	program: CoreProgram,
	allocations: Int
}


private pure func runtime_owned_string(text: String) -> String:
	text.substring(0, text.length())


private pure func nested_type_with_runtime_owned_names() -> SemanticType:
	SemanticNamedType(runtime_owned_string("List"), [SemanticArrayType(
				SemanticNamedType(runtime_owned_string("String"), []),
				[SemanticConstIntType(4)],
			)])


private pure func unchanged_nested_type_tree() -> SemanticType:
	SemanticFunctionType(True, [SemanticTupleType([
				SemanticNamedType(runtime_owned_string("List"), [type_string()]),
				SemanticArrayType(
					type_int(),
					[
						SemanticDimOpType(
							SemanticDimAdd,
							SemanticConstIntType(2),
							SemanticConstIntType(2),
						),
					],
				),
			])], SemanticRangeType(type_int()))


private pure func nested_type_tree_with_name(name: String) -> SemanticType:
	SemanticFunctionType(True, [SemanticTupleType([
				SemanticArrayType(
					SemanticNamedType("Keep", []),
					[
						SemanticDimOpType(
							SemanticDimAdd,
							SemanticRangeType(SemanticNamedType(name, [])),
							SemanticConstIntType(1),
						),
					],
				),
				SemanticNamedType("Keep", []),
			])], type_int())


private pure func nested_core_type(depth: Int) -> CoreType:
	var result: CoreType = NamedType("Leaf", [])
	var index: Int = 0

	while index < depth:
		result = NamedType("Layer", [result])
		index += 1

	result


private pure func nested_core_type_depth(typ: CoreType) -> Int:
	match typ:
		NamedType(name, args):
			if name == "Leaf":
				0
			else if name == "Layer":
				match args.get(0):
					Some(inner):
						1 + nested_core_type_depth(inner)
					None:
						-1
			else:
				-1
		_:
			-1


private pure func nested_core_expr(depth: Int, typ: CoreType) -> CoreExpr:
	var result: CoreExpr = LiteralExpr(IntLiteral(7), typ, SyntheticSourceLoc)
	var index: Int = 0

	while index < depth:
		result = CastExpr(result, typ, SyntheticSourceLoc)
		index += 1

	result


private pure func core_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


private pure func core_param(name: String, typ: CoreType) -> CoreParam:
	{
		name = core_var(name),
		typ = typ,
		loc = SyntheticSourceLoc
	}


private pure func nested_core_expr_depth(expr: CoreExpr) -> Int:
	match expr:
		CastExpr(inner, typ, loc):
			if nested_core_type_depth(typ) >= 0:
				1 + nested_core_expr_depth(inner)
			else:
				-1
		LiteralExpr(literal, typ, loc):
			if nested_core_type_depth(typ) >= 0:
				0
			else:
				-1
		_:
			-1


private pure func nested_core_type_preserves_cow(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			extended_args: List[CoreType] = args.append(NamedType("Extra", []))
			name == "Layer" and args.length() == 1 and extended_args.length() == 2
		_:
			False


private func rewrite_alias_fixture(type_depth: Int) -> CoreRewriteMeasurement:
	target: CoreType = nested_core_type(type_depth)
	program: CoreProgram = {
		decls = [TypeAliasDecl({
				name = "Nested",
				type_params = [],
				target = target,
				is_opaque = False,
				loc = SyntheticSourceLoc,
			})],
		foreign_includes = []
	}
	reset_mem_stats()
	rewritten: CoreProgram = CoreConsumeSpecialize.rewrite_program(program)
	stats = get_mem_stats()

	{
		program = rewritten,
		allocations = stats.total_allocations
	}


private func rewrite_perceus_fixture(type_depth: Int) -> CoreRewriteMeasurement:
	typ: CoreType = nested_core_type(type_depth)
	managed_type: CoreType = NamedType("String", [])
	rhs: CoreExpr = nested_core_expr(16, typ)
	body: CoreExpr = LetExpr(
		core_var("temporary"),
		False,
		typ,
		rhs,
		VarExpr(core_var("value"), managed_type, SyntheticSourceLoc),
	)
	program: CoreProgram = {
		decls = [FunctionDecl({
				name = "borrowed_identity",
				source_module = None,
				type_params = [],
				params = [core_param("value", managed_type)],
				return_type = managed_type,
				body = Some(body),
				is_pure = True,
				function_kind = UserFunction,
				def_id = 1,
				loc = SyntheticSourceLoc,
			})],
		foreign_includes = []
	}
	reset_mem_stats()
	rewritten: CoreProgram = insert_drops_program(program)
	stats = get_mem_stats()

	{
		program = rewritten,
		allocations = stats.total_allocations
	}


private pure func rewritten_alias_preserves_shared_target(
	program: CoreProgram,
	type_depth: Int,
) -> Bool:
	match program.decls:
		[TypeAliasDecl(alias_decl)]:
			(
				nested_core_type_depth(alias_decl.target) == type_depth
				and nested_core_type_preserves_cow(alias_decl.target)
			)
		_:
			False


private pure func rewritten_perceus_body_preserves_shared_types(
	program: CoreProgram,
	type_depth: Int,
) -> Bool:
	match program.decls:
		[FunctionDecl(func_info)]:
			match func_info.body:
				Some(LetExpr(variable, is_mutable, typ, rhs, body)):
					(
						not is_mutable
						and nested_core_type_depth(typ) == type_depth
						and nested_core_expr_depth(rhs) == 16
						and nested_core_type_preserves_cow(typ)
					)
				_:
					False
		_:
			False


private pure func imported_name_bindings() -> List[CompilerImportedNameBinding]:
	[
		{
			local_name = "Imported",
			module_path = "pkg/module",
			original_name = "Source"
		},
	]


private pure func imported_type_homes() -> List[CompilerTypecheckTypeHome]:
	[
		{
			type_name = "Imported",
			module_path = "pkg/module",
			imported = True
		},
	]


private pure func trait_lookup_after_environment_release() -> Option[TraitDef]:
	nested_type = nested_type_with_runtime_owned_names()
	method = trait_method_sig(runtime_owned_string("render"), [nested_type], nested_type, True)
	env = env_add_trait(
		env_empty(),
		trait_def(
			103,
			runtime_owned_string("Renderable"),
			[runtime_owned_string("Stringable")],
			[method],
		),
	)

	env_get_trait(env, "Renderable")


func test_trait_lookup_shares_without_deep_copy() -> Bool:
	nested_type: SemanticType = SemanticNamedType(
		"List",
		[SemanticArrayType(type_string(), [SemanticConstIntType(4)])],
	)
	method = trait_method_sig("render", [nested_type], nested_type, True)
	env = env_add_trait(
		env_empty(),
		trait_def(101, "Renderable", ["Stringable"], [method]),
	)
	reset_mem_stats()
	found = env_get_trait(env, "Renderable")
	stats = get_mem_stats()

	match found:
		Some(trait_def):
			(
				stats.total_allocations <= 1
				and trait_def.name == "Renderable"
				and trait_def.supertraits == ["Stringable"]
				and match trait_def.methods.get(0):
					Some(found_method):
						found_method.name == "render" and types_equal(
							found_method.params.get_or(0, type_int()),
							nested_type,
						) and types_equal(found_method.return_type, nested_type)
					None:
						False
			)
		None:
			False


func test_trait_lookup_retains_dynamic_values_and_preserves_cow() -> Bool:
	expected_type: SemanticType = SemanticNamedType(
		"List",
		[SemanticArrayType(type_string(), [SemanticConstIntType(4)])],
	)

	match trait_lookup_after_environment_release():
		Some(trait_def):
			extended_methods = trait_def.methods.append(
				trait_method_sig(
					"extra",
					[],
					type_int(),
					True,
				),
			)

			match trait_def.methods.get(0):
				Some(method):
					(
						trait_def.name == "Renderable"
						and trait_def.supertraits == ["Stringable"]
						and method.name == "render"
						and types_equal(
							method.params.get_or(0, type_int()),
							expected_type,
						)
						and types_equal(method.return_type, expected_type)
						and trait_def.methods.length() == 1
						and extended_methods.length() == 2
					)
				None:
					False
		None:
			False


func test_function_symbol_shares_nested_values_without_deep_copy() -> Bool:
	nested_type: SemanticType = SemanticFunctionType(
		True,
		[SemanticNamedType("List", [nested_type_with_runtime_owned_names()])],
		type_bool(),
	)
	type_params = [make_bound_type_param("T", [])]
	param_names = [Some("value")]
	dim_constraints = [(nested_type, nested_type)]
	reset_mem_stats()
	symbol = func_symbol(
		102,
		nested_type,
		type_params,
		param_names,
		Pure,
		UserDefinedFunc,
		RejectResourceArgs,
		None,
		dim_constraints,
		None,
		False,
	)
	stats = get_mem_stats()

	constraint_preserved = match symbol.dim_constraints.get(0):
		Some(constraint):
			types_equal(constraint[0], nested_type) and types_equal(constraint[1], nested_type)
		None:
			False

	(
		stats.total_allocations <= 1
		and types_equal(symbol.func_type, nested_type)
		and symbol.type_params.length() == 1
		and symbol.param_names == param_names
		and constraint_preserved
	)


func test_qualified_type_resolution_shares_unchanged_tree() -> Bool:
	module_aliases = [("Unused", "pkg/unused")]
	typ = unchanged_nested_type_tree()
	reset_mem_stats()
	resolved = resolve_qualified_type_names(module_aliases, typ)
	stats = get_mem_stats()

	-- The changed-only recursive path allocates four times; rebuilding this
	-- representative tree allocated 16 times.
	stats.total_allocations <= 4 and types_equal(resolved, typ)


func test_qualified_type_resolution_changes_one_leaf_without_mutating_source() -> Bool:
	source = nested_type_tree_with_name("Alias.Target")
	resolved = resolve_qualified_type_names([("Alias", "pkg/module")], source)

	(
		types_equal(source, nested_type_tree_with_name("Alias.Target"))
		and types_equal(
			resolved,
			nested_type_tree_with_name(canonical_module_type_name("pkg/module", "Target")),
		)
	)


func test_imported_type_resolution_shares_unchanged_tree() -> Bool:
	imported_names = imported_name_bindings()
	type_homes = imported_type_homes()
	typ = unchanged_nested_type_tree()
	reset_mem_stats()
	resolved = resolve_imported_type_aliases_from_bindings(imported_names, type_homes, typ)
	stats = get_mem_stats()

	-- The same four ownership allocations remain; rebuilding this tree allocated 21 times.
	stats.total_allocations <= 4 and types_equal(resolved, typ)


func test_imported_type_resolution_changes_one_leaf_without_mutating_source() -> Bool:
	imported_names = imported_name_bindings()
	type_homes = imported_type_homes()
	source = nested_type_tree_with_name("Imported")
	resolved = resolve_imported_type_aliases_from_bindings(imported_names, type_homes, source)

	(
		types_equal(source, nested_type_tree_with_name("Imported"))
		and types_equal(
			resolved,
			nested_type_tree_with_name(canonical_module_type_name("pkg/module", "Source")),
		)
	)


func test_consume_specialize_shares_unchanged_declaration_types() -> Bool:
	measurement: CoreRewriteMeasurement = rewrite_alias_fixture(64)
	allocations_ok: Bool = measurement.allocations <= MAX_CONSUME_SPECIALIZE_SHARING_ALLOCATIONS

	if not allocations_ok:
		print("consume specialize immutable declaration allocations: ${measurement.allocations}")
	else:
		void

	allocations_ok and rewritten_alias_preserves_shared_target(measurement.program, 64)


func test_perceus_shares_reused_type_metadata() -> Bool:
	shallow: CoreRewriteMeasurement = rewrite_perceus_fixture(1)
	deep: CoreRewriteMeasurement = rewrite_perceus_fixture(64)
	allocations_ok: Bool = deep.allocations <= MAX_PERCEUS_SHARING_ALLOCATIONS
	depth_growth_ok: Bool = deep.allocations - shallow.allocations <= MAX_PERCEUS_TYPE_DEPTH_ALLOCATION_GROWTH

	if not allocations_ok or not depth_growth_ok:
		print(
			"Perceus reused type metadata allocations: shallow=${shallow.allocations}, deep=${deep.allocations}",
		)
	else:
		void

	(
		allocations_ok
		and depth_growth_ok
		and rewritten_perceus_body_preserves_shared_types(shallow.program, 1)
		and rewritten_perceus_body_preserves_shared_types(deep.program, 64)
	)


tests: TestSuite = {
	description = "Compiler immutable sharing",
	tests = [
		("trait lookup shares without deep copy", test_trait_lookup_shares_without_deep_copy),
		(
			"trait lookup retains dynamic values and preserves COW",
			test_trait_lookup_retains_dynamic_values_and_preserves_cow,
		),
		(
			"function symbol shares nested values without deep copy",
			test_function_symbol_shares_nested_values_without_deep_copy,
		),
		(
			"qualified type resolution shares unchanged tree",
			test_qualified_type_resolution_shares_unchanged_tree,
		),
		(
			"qualified type resolution changes one leaf without mutating source",
			test_qualified_type_resolution_changes_one_leaf_without_mutating_source,
		),
		(
			"imported type resolution shares unchanged tree",
			test_imported_type_resolution_shares_unchanged_tree,
		),
		(
			"imported type resolution changes one leaf without mutating source",
			test_imported_type_resolution_changes_one_leaf_without_mutating_source,
		),
		(
			"consume specialize shares unchanged declaration types",
			test_consume_specialize_shares_unchanged_declaration_types,
		),
		("Perceus shares reused type metadata", test_perceus_shares_reused_type_metadata),
	]
}
