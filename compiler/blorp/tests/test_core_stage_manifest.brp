import:
	../core_stage_manifest:
		CoreStageRenderError(UnsupportedCoreStageOp, WrongArity),
		core_stage_template_arity,
		core_stage_template_name,
		parse_core_stage_template,
		render_core_stage,
		render_error_to_string,
		render_manifest_line,
		render_manifest_lines,
	test: TestSuite


pure func parsed_template_has(name: String, expected_name: String, expected_arity: Int) -> Bool:
	match parse_core_stage_template(name):
		Some(info):
			(
				core_stage_template_name(info) == expected_name
				and core_stage_template_arity(info) == expected_arity
			)
		None:
			False


pure func rendered_stage_is(name: String, args: List[String], expected: String) -> Bool:
	match render_core_stage(name, args):
		Ok(rendered):
			rendered == expected
		Err(error):
			False


pure func manifest_line_is(name: String, expected: String) -> Bool:
	match parse_core_stage_template(name):
		Some(info):
			render_manifest_line(info) == expected
		None:
			False


pure func expected_stage_names() -> String:
	(
		"lower, debug, desugar, mono, synth, match, trait_resolve, resolve, std_inline, "
		+ "tailrec, fusion, specialize, dce, consume_specialize, perceus, reuse, closure, "
		+ "final"
	)


pure func test_parse_template_shapes() -> Bool:
	valid_names_ok: Bool = parsed_template_has(
		"core_stage_valid_names",
		"core_stage_valid_names",
		0,
	)
	unknown_error_ok: Bool = parsed_template_has(
		"core_stage_unknown_error",
		"core_stage_unknown_error",
		2,
	)

	valid_names_ok and unknown_error_ok


pure func test_render_stage_values() -> Bool:
	valid_names_ok: Bool = rendered_stage_is("core_stage_valid_names", [], expected_stage_names())
	typo_ok: Bool = rendered_stage_is(
		"core_stage_unknown_error",
		["monot", "monot"],
		"unknown stage \"monot\" (did you mean \"mono\"?) (valid: " + expected_stage_names() + ")",
	)
	unknown_ok: Bool = rendered_stage_is(
		"core_stage_unknown_error",
		["parsed", "parsed"],
		"unknown stage \"parsed\" (valid: " + expected_stage_names() + ")",
	)
	quoted_ok: Bool = rendered_stage_is(
		"core_stage_unknown_error",
		["bad\"stage", "bad\"stage"],
		"unknown stage \"bad\\\"stage\" (valid: " + expected_stage_names() + ")",
	)

	valid_names_ok and typo_ok and unknown_ok and quoted_ok


pure func test_render_errors_are_typed() -> Bool:
	wrong_arity_ok: Bool = match render_core_stage("core_stage_valid_names", ["extra"]):
		Err(WrongArity(info, actual)):
			(
				core_stage_template_name(info) == "core_stage_valid_names"
				and core_stage_template_arity(info) == 0
				and actual == 1
			)
		Ok(value):
			False
		Err(UnsupportedCoreStageOp(name)):
			False

	unsupported_ok: Bool = match render_core_stage("core_stage_missing", []):
		Err(UnsupportedCoreStageOp(name)):
			name == "core_stage_missing"
		Ok(value):
			False
		Err(WrongArity(info, actual)):
			False

	wrong_arity_ok and unsupported_ok


pure func test_manifest_lines() -> Bool:
	valid_names_ok: Bool = manifest_line_is(
		"core_stage_valid_names",
		"core_stage_valid_names\t0\t" + expected_stage_names(),
	)
	unknown_error_ok: Bool = manifest_line_is(
		"core_stage_unknown_error",
		"core_stage_unknown_error\t2\tunknown stage \"@0@\" (valid: " + expected_stage_names() + ")",
	)
	count_ok: Bool = render_manifest_lines().length() == 2

	valid_names_ok and unknown_error_ok and count_ok


pure func test_error_text() -> Bool:
	arity_text: String = match render_core_stage("core_stage_valid_names", ["extra"]):
		Err(error):
			render_error_to_string(error)
		Ok(value):
			value

	unsupported_text: String = render_error_to_string(UnsupportedCoreStageOp("core_stage_missing"))

	(
		arity_text == "core stage op core_stage_valid_names expected 0 arg(s), got 1"
		and unsupported_text == "unsupported core stage op: core_stage_missing"
	)


tests: TestSuite = {
	description = "Self-hosted Core stage manifest",
	tests = [
		("parse template shapes", test_parse_template_shapes),
		("render stage values", test_render_stage_values),
		("render errors are typed", test_render_errors_are_typed),
		("manifest lines", test_manifest_lines),
		("error text", test_error_text),
	]
}
