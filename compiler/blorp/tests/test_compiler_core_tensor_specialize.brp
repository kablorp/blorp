		("static tensor length folds to literal", test_static_tensor_length_folds_to_literal),
		("runtime lengths dispatch to intrinsics", test_runtime_lengths_dispatch_to_intrinsics),
		(
			"constant Float32 checked reads use unchecked intrinsic",
			test_constant_float32_checked_read_uses_unchecked_intrinsic,
		),
		(
			"dynamic Float checked reads use typed runtime",
			test_dynamic_float_checked_read_uses_typed_runtime,
		),
		(
			"out-of-bounds literal checked reads keep runtime check",
			test_out_of_bounds_literal_checked_read_keeps_runtime_check,
		),
		(
			"dynamic Int checked reads unbox runtime pointer",
			test_dynamic_int_checked_read_unboxes_runtime_pointer,
		),
		(
			"constant enum checked reads use Int intrinsic",
			test_constant_enum_checked_read_uses_int_intrinsic,
		),
		(
			"Float matrix checked reads use typed runtime",
			test_float_matrix_checked_read_uses_typed_runtime,
		),
		(
			"rank-3 Int checked reads inject static shape",
			test_rank3_int_checked_read_injects_static_shape,
		),
		(
			"rank-3 Float checked reads use typed shape runtime",
			test_rank3_float_checked_read_uses_typed_shape_runtime,
		),
		(
			"typed vector and matrix writes select runtime",
			test_typed_vector_and_matrix_writes_select_runtime,
		),
		(
			"preboxed numeric writes keep generic runtime",
			test_preboxed_numeric_write_keeps_generic_runtime,
		),
		("numeric vector fills select runtime", test_numeric_vector_fills_select_runtime),
		("numeric matrix fills select runtime", test_numeric_matrix_fills_select_runtime),
		("Float16 fill stays generic", test_float16_fill_stays_generic),
		(
			"Float unary tensor math uses base runtime",
			test_float_unary_tensor_math_uses_base_runtime,
		),
		(
			"Float32 unary tensor math selects runtime",
			test_float32_unary_tensor_math_selects_runtime,
		),
		(
			"imported scalar math lift selects tensor runtime",
			test_imported_scalar_math_lift_selects_tensor_runtime,
		),
		(
			"Float16 unary tensor math selects runtime",
			test_float16_unary_tensor_math_selects_runtime,
		),
		(
			"unary tensor math requires tensor receiver",
			test_unary_tensor_math_requires_tensor_receiver,
		),
		("Int tensor reductions select runtime", test_int_tensor_reductions_select_runtime),
		("Float tensor reductions select runtime", test_float_tensor_reductions_select_runtime),
		("Float32 tensor reductions select runtime", test_float32_tensor_reductions_select_runtime),
		("Float16 tensor reductions select runtime", test_float16_tensor_reductions_select_runtime),
		(
			"tensor reductions require tensor receiver",
			test_tensor_reductions_require_tensor_receiver,
		),
		(
			"tensor reductions require supported element type",
			test_tensor_reductions_require_supported_element_type,
		),
		("bounds-proven read hoists raw view", test_bounds_proven_read_hoists_raw_view),
		("temporary tensor source is not hoisted", test_temporary_tensor_source_is_not_hoisted),
		("resource scope blocks raw-view hoisting", test_resource_scope_blocks_raw_view_hoisting),
		("raw writes require unique storage", test_write_hoist_requires_unique_storage),
		("out-of-bounds loops are not hoisted", test_out_of_bounds_loop_is_not_hoisted),
		(
			"nonnegative addition range starts prove bounds",
