			vector_type,
		)
	)


pure func test_unary_tensor_math_requires_tensor_receiver() -> Bool:
	call: CoreExpr = builtin_call("blorp_vector_norm", [variable("value", FLOAT_TYPE)], FLOAT_TYPE)

	match specialized_body(call):
		Some(body):
			is_builtin_call(body, "blorp_vector_norm", 1)
		_:
			False


pure func tensor_reduction_call(name: String, element_type: CoreType) -> CoreExpr:
	values_type: CoreType = tensor_with_dims(element_type, [TensorStaticDim(4)])
	builtin_call(name, [variable("values", values_type)], element_type)


pure func tensor_reduction_specializes(
	name: String,
	runtime_name: String,
	element_type: CoreType,
) -> Bool:
	specializes_to_builtin(
		tensor_reduction_call(name, element_type),
		runtime_name,
		1,
	)


pure func tensor_reductions_specialize(
	element_type: CoreType,
	max_runtime_name: String,
	min_runtime_name: String,
) -> Bool:
	(
		tensor_reduction_specializes("blorp_max", max_runtime_name, element_type)
		and tensor_reduction_specializes("blorp_min", min_runtime_name, element_type)
	)


pure func test_int_tensor_reductions_select_runtime() -> Bool:
	tensor_reductions_specialize(INT_TYPE, "blorp_vector_max_int", "blorp_vector_min_int")


pure func test_float_tensor_reductions_select_runtime() -> Bool:
	tensor_reductions_specialize(FLOAT_TYPE, "blorp_vector_max_float", "blorp_vector_min_float")


pure func test_float32_tensor_reductions_select_runtime() -> Bool:
	tensor_reductions_specialize(
		FLOAT32_TYPE,
		"blorp_vector_max_float32",
		"blorp_vector_min_float32",
	)


pure func test_float16_tensor_reductions_select_runtime() -> Bool:
	tensor_reductions_specialize(
		FLOAT16_TYPE,
		"blorp_vector_max_float16",
		"blorp_vector_min_float16",
	)


pure func test_tensor_reductions_require_tensor_receiver() -> Bool:
	non_tensor: CoreExpr = builtin_call("blorp_max", [variable("value", INT_TYPE)], INT_TYPE)

	match specialized_body(non_tensor):
		Some(body):
			is_builtin_call(body, "blorp_max", 1)
		_:
			False


pure func test_tensor_reductions_require_supported_element_type() -> Bool:
	custom_type: CoreType = named_type("Ranked")
	custom_tensor: CoreExpr = tensor_reduction_call("blorp_min", custom_type)

	match specialized_body(custom_tensor):
		Some(body):
			is_builtin_call(body, "blorp_min", 1)
		_:
			False


pure func checked_float_read(values: CoreExpr) -> CoreExpr:
	builtin_call(
		"blorp_checked_get_f64",
		[values, variable("i", INT_TYPE)],
		FLOAT_TYPE,
	)


pure func safe_float_read(values: CoreExpr) -> CoreExpr:
	CallExpr(
		IntrinsicCall("tensor_get_f64"),
		VoidExpr(
			VoidType,
			SyntheticSourceLoc,
		),
		[values, variable("i", INT_TYPE)],
		FLOAT_TYPE,
		SyntheticSourceLoc,
	)


pure func range_loop(values: CoreExpr, body: CoreExpr) -> CoreExpr:
	ForRangeExpr(
		LOOP_BINDER,
		int_literal(0),
		length_call(values),
		body,
		VoidType,
		SyntheticSourceLoc,
	)


pure func test_bounds_proven_read_hoists_raw_view() -> Bool:
	values: CoreExpr = variable("values", tensor_type(4))
	loop: CoreExpr = range_loop(values, checked_float_read(values))

	match specialized_body(loop):
		Some(LetExpr(_, False, NamedType("Bool", []), _, IfExpr(_, fast_loop, fallback, VoidType, _))):
			match fast_loop:
				TensorRawViewLetExpr(binding, ForRangeExpr(_, _, LiteralExpr(IntLiteral(4), _, _), TensorRawReadExpr(read, _, _), _, _), _, _):
					(
						binding.kind == TensorFloat64Elements
						and read.kind == TensorFloat64Elements
						and binding.variable == read.view
						and exprs_equal(
							fallback,
							ForRangeExpr(
								LOOP_BINDER,
								int_literal(0),
								int_literal(4),
								safe_float_read(values),
								VoidType,
								SyntheticSourceLoc,
							),
						)
					)
				_:
					False
		_:
			False


pure func test_temporary_tensor_source_is_not_hoisted() -> Bool:
	parent: CoreExpr = variable(
		"parent",
		TensorType({
			element_type = FLOAT_TYPE,
			dims = [TensorStaticDim(2), TensorStaticDim(4)],
		}),
	)
	temporary: CoreExpr = builtin_call(
		"blorp_tensor_slice_row",
		[parent, int_literal(0)],
		tensor_type(4),
	)
	loop: CoreExpr = range_loop(temporary, checked_float_read(temporary))

	match specialized_body(loop):
		Some(ForRangeExpr(_, _, LiteralExpr(IntLiteral(4), _, _), _, _, _)):
			True
		_:
			False


pure func test_resource_scope_blocks_raw_view_hoisting() -> Bool:
	values: CoreExpr = variable("values", tensor_type(4))
	scope: CoreExpr = ResourceScopeExpr(
		{
			variable = core_var("resource"),
			typ = named_type("FileReader"),
			acquire = variable("reader", named_type("FileReader")),
			body = checked_float_read(values),
			cleanup = VoidExpr(VoidType, SyntheticSourceLoc)
		},
		VoidType,
		SyntheticSourceLoc,
	)

	match specialized_body(range_loop(values, scope)):
		Some(ForRangeExpr(_, _, LiteralExpr(IntLiteral(4), _, _), ResourceScopeExpr(_, _, _), _, _)):
			True
		_:
			False


pure func test_write_hoist_requires_unique_storage() -> Bool:
	values: CoreExpr = variable("values", tensor_type(4))
	write: CoreExpr = AssignExpr(
		core_var("values"),
		builtin_call(
			"blorp_vector_set_inplace_f64",
			[values, variable("i", INT_TYPE), float_literal(1.5)],
			tensor_type(4),
		),
		VoidType,
		SyntheticSourceLoc,
	)

	match specialized_body(range_loop(values, write)):
		Some(LetExpr(_, False, _, condition, IfExpr(_, fast_loop, fallback_loop, VoidType, _))):
			(
				contains_intrinsic(condition, "tensor_is_unique")
				and contains_raw_write(fast_loop)
				and contains_builtin_named(fallback_loop, "blorp_vector_set_inplace_f64")
			)
		_:
			False


pure func test_out_of_bounds_loop_is_not_hoisted() -> Bool:
	values: CoreExpr = variable("values", tensor_type(4))
	loop: CoreExpr = ForRangeExpr(
		LOOP_BINDER,
		int_literal(0),
		int_literal(5),
		checked_float_read(values),
		VoidType,
		SyntheticSourceLoc,
	)

	match specialized_body(loop):
		Some(ForRangeExpr(_, _, LiteralExpr(IntLiteral(5), _, _), _, _, _)):
			True
		_:
			False


pure func test_nonnegative_addition_start_proves_bounds() -> Bool:
	values: CoreExpr = variable("values", tensor_type(4))
	start: CoreExpr = BinaryExpr(
		AddOp,
		int_literal(0),
		int_literal(1),
		INT_TYPE,
		SyntheticSourceLoc,
	)
	loop: CoreExpr = ForRangeExpr(
		LOOP_BINDER,
		start,
		int_literal(4),
		checked_float_read(values),
		VoidType,
		SyntheticSourceLoc,
	)

	match specialized_body(loop):
		Some(LetExpr(_, False, _, _, IfExpr(_, TensorRawViewLetExpr(_, _, _, _), _, VoidType, _))):
			True
		_:
			False


pure func test_nested_raw_view_region_is_not_rehoisted() -> Bool:
	values: CoreExpr = variable("values", tensor_type(4))
	inner_loop: CoreExpr = range_loop(values, checked_float_read(values))
	outer_binder: CoreLoopBinder = {
		variable = core_var("j"),
		typ = INT_TYPE,
		range_direction = RangeForwardOnly
	}
	outer_loop: CoreExpr = ForRangeExpr(
		outer_binder,
		int_literal(0),
		int_literal(2),
		inner_loop,
		VoidType,
		SyntheticSourceLoc,
	)

	match specialized_body(outer_loop):
		Some(ForRangeExpr(_, _, _, body, _, _)):
			match body:
				LetExpr(_, False, _, _, IfExpr(_, TensorRawViewLetExpr(_, _, _, _), _, _, _)):
					True
				_:
					False
		_:
			False


