import:
	../src/stage_09_core/ir:
		CoreBinaryOp(AddOp),
		CoreBoxKind(PrimBox),
		CoreCallKind(BuiltinCall, IntrinsicCall, SelectedDirectCall, UserCall),
		CoreDecl(FunctionDecl),
		CoreExpr(
			AssignExpr,
			BinaryExpr,
			BoxExpr,
			CallExpr,
			ForRangeExpr,
			IfExpr,
			LiteralExpr,
			ResourceScopeExpr,
			TensorRawReadExpr,
			TensorRawViewLetExpr,
			TensorRawWriteExpr,
			UnboxExpr,
			VarExpr,
			VoidExpr,
		),
		CoreFunctionKind(UserFunction),
		CoreLiteral(FloatLiteral, IntLiteral),
		CoreLoopBinder,
		CoreLoopRangeDirection(RangeForwardOnly),
		CoreProgram,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreTensorDim(TensorRuntimeDim, TensorStaticDim),
		CoreTensorRawScalarKind(TensorFloat64Elements),
		CoreType(EnumType, NamedType, TensorType, VoidType),
		CoreUnboxKind(PrimUnbox),
		CoreVar,
		core_expr_to_json,
	../src/stage_09_core/tensor_specialize: specialize_program
	../src/stage_09_core/traverse: immediate_core_expr_children
	test: TestSuite


pure func named_type(name: String) -> CoreType:
	NamedType(name, [])


private INT_TYPE: CoreType = NamedType("Int", [])

private FLOAT_TYPE: CoreType = NamedType("Float", [])

private FLOAT32_TYPE: CoreType = NamedType("Float32", [])

private FLOAT16_TYPE: CoreType = NamedType("Float16", [])

private RAW_POINTER_TYPE: CoreType = NamedType("Ptr", [])

private RUNTIME_TENSOR_TYPE: CoreType = TensorType({
	element_type = FLOAT_TYPE,
	dims = [TensorRuntimeDim("N")],
})

private LOOP_BINDER: CoreLoopBinder = {
	variable = {
		name = "i",
		uniq = 0,
		def_id = None
	},
	typ = INT_TYPE,
	range_direction = RangeForwardOnly
}


pure func tensor_with_dims(element_type: CoreType, dims: List[CoreTensorDim]) -> CoreType:
	TensorType({
		element_type = element_type,
		dims = dims,
	})


pure func tensor_type(dim: Int) -> CoreType:
	tensor_with_dims(FLOAT_TYPE, [TensorStaticDim(dim)])


pure func core_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


pure func variable(name: String, typ: CoreType) -> CoreExpr:
	VarExpr(core_var(name), typ, SyntheticSourceLoc)


pure func int_literal(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), INT_TYPE, SyntheticSourceLoc)


pure func float_literal(value: Float) -> CoreExpr:
	LiteralExpr(FloatLiteral(value), FLOAT_TYPE, SyntheticSourceLoc)


pure func builtin_call(name: String, args: List[CoreExpr], typ: CoreType) -> CoreExpr:
	CallExpr(
		BuiltinCall(name),
		VoidExpr(VoidType, SyntheticSourceLoc),
		args,
		typ,
		SyntheticSourceLoc,
	)


pure func length_call(value: CoreExpr) -> CoreExpr:
	builtin_call("blorp_length", [value], INT_TYPE)


pure func program_with_body(body: CoreExpr) -> CoreProgram:
	{
		decls = [FunctionDecl({
				name = "main",
				source_module = None,
				type_params = [],
				params = [],
				return_type = VoidType,
				body = Some(body),
				is_pure = True,
				function_kind = UserFunction,
				def_id = 1,
				loc = SyntheticSourceLoc,
			})],
		foreign_includes = []
	}


pure func specialized_body(body: CoreExpr) -> Option[CoreExpr]:
	match specialize_program(program_with_body(body)).decls:
		[FunctionDecl(function_info)]:
			function_info.body
		_:
			None


pure func exprs_equal(left: CoreExpr, right: CoreExpr) -> Bool:
	core_expr_to_json(left).to_string() == core_expr_to_json(right).to_string()


pure func contains_intrinsic(expr: CoreExpr, expected: String) -> Bool:
	match expr:
		CallExpr(IntrinsicCall(name), _, _, _, _):
			(
				name == expected
				or immediate_core_expr_children(
					expr,
				).any(
					func(child): contains_intrinsic(child, expected),
				)
			)
		_:
			immediate_core_expr_children(expr).any(func(child): contains_intrinsic(child, expected))


pure func contains_builtin_named(expr: CoreExpr, expected: String) -> Bool:
	match expr:
		CallExpr(BuiltinCall(name), _, _, _, _):
			(
				name == expected
				or immediate_core_expr_children(
					expr,
				).any(
					func(child): contains_builtin_named(child, expected),
				)
			)
		_:
			immediate_core_expr_children(
				expr,
			).any(
				func(child): contains_builtin_named(child, expected),
			)


pure func contains_raw_write(expr: CoreExpr) -> Bool:
	match expr:
		TensorRawWriteExpr(_, _, _):
			True
		_:
			immediate_core_expr_children(expr).any(contains_raw_write)


pure func call_kind_is_builtin(kind: CoreCallKind, expected: String) -> Bool:
	match kind:
		BuiltinCall(name):
			name == expected
		_:
			False


pure func has_rank3_static_shape_args(args: List[CoreExpr]) -> Bool:
	match args:
		[_, LiteralExpr(IntLiteral(2), _, _), LiteralExpr(IntLiteral(3), _, _), LiteralExpr(IntLiteral(4), _, _), _, _, _]:
			True
		_:
			False


pure func is_builtin_call(expr: CoreExpr, expected_name: String, expected_arity: Int) -> Bool:
	match expr:
		CallExpr(kind, _, args, _, _):
			args.length() == expected_arity and call_kind_is_builtin(kind, expected_name)
		_:
			False


pure func is_intrinsic_call(expr: CoreExpr, expected_name: String, expected_arity: Int) -> Bool:
	match expr:
		CallExpr(kind, _, args, _, _):
			match kind:
				IntrinsicCall(name):
					name == expected_name and args.length() == expected_arity
				_:
					False
		_:
			False


pure func specializes_to_builtin(
	expr: CoreExpr,
	expected_name: String,
	expected_arity: Int,
) -> Bool:
	match specialized_body(expr):
		Some(body):
			is_builtin_call(body, expected_name, expected_arity)
		_:
			False


pure func is_prim_unbox_of_builtin(
	expr: CoreExpr,
	expected_name: String,
	expected_arity: Int,
) -> Bool:
	match expr:
		UnboxExpr(PrimUnbox, value, _, _):
			is_builtin_call(value, expected_name, expected_arity)
		_:
			False


pure func is_rank3_shape_call(expr: CoreExpr, expected_name: String) -> Bool:
	match expr:
		CallExpr(kind, _, args, _, _):
			call_kind_is_builtin(kind, expected_name) and has_rank3_static_shape_args(args)
		_:
			False


pure func is_prim_unbox_of_rank3_shape_call(expr: CoreExpr, expected_name: String) -> Bool:
	match expr:
		UnboxExpr(PrimUnbox, value, _, _):
			is_rank3_shape_call(value, expected_name)
		_:
			False


pure func test_static_tensor_length_folds_to_literal() -> Bool:
	values: CoreExpr = variable("values", tensor_type(4))

	match specialized_body(length_call(values)):
		Some(LiteralExpr(IntLiteral(4), NamedType("Int", []), _)):
			True
		_:
			False


pure func test_runtime_lengths_dispatch_to_intrinsics() -> Bool:
	list_value: CoreExpr = variable(
		"items",
		NamedType("List", [INT_TYPE]),
	)
	tensor_value: CoreExpr = variable("values", RUNTIME_TENSOR_TYPE)

	match (specialized_body(length_call(list_value)), specialized_body(length_call(tensor_value))):
		(Some(CallExpr(IntrinsicCall("list_len"), _, [_], _, _)), Some(CallExpr(IntrinsicCall("tensor_len"), _, [_], _, _))):
			True
		_:
			False


pure func test_constant_float32_checked_read_uses_unchecked_intrinsic() -> Bool:
	values_type: CoreType = tensor_with_dims(FLOAT32_TYPE, [TensorStaticDim(4)])
	values: CoreExpr = variable("values", values_type)
	read: CoreExpr = builtin_call(
		"blorp_checked_get",
		[values, int_literal(2)],
		FLOAT32_TYPE,
	)

	match specialized_body(read):
		Some(body):
			is_intrinsic_call(body, "tensor_get_f32", 2)
		_:
			False


pure func test_dynamic_float_checked_read_uses_typed_runtime() -> Bool:
	values: CoreExpr = variable("values", tensor_type(4))
	read: CoreExpr = builtin_call(
		"blorp_checked_get",
		[values, variable("index", INT_TYPE)],
		FLOAT_TYPE,
	)

	match specialized_body(read):
		Some(body):
			is_builtin_call(body, "blorp_checked_get_f64", 2)
		_:
			False


pure func test_out_of_bounds_literal_checked_read_keeps_runtime_check() -> Bool:
	values: CoreExpr = variable("values", tensor_type(4))
	read: CoreExpr = builtin_call(
		"blorp_checked_get",
		[values, int_literal(4)],
		FLOAT_TYPE,
	)

	match specialized_body(read):
		Some(body):
			is_builtin_call(body, "blorp_checked_get_f64", 2)
		_:
			False


pure func test_dynamic_int_checked_read_unboxes_runtime_pointer() -> Bool:
	values_type: CoreType = tensor_with_dims(INT_TYPE, [TensorStaticDim(4)])
	values: CoreExpr = variable("values", values_type)
	read: CoreExpr = builtin_call(
		"blorp_checked_get",
		[values, variable("index", INT_TYPE)],
		INT_TYPE,
	)

	match specialized_body(read):
		Some(body):
			is_prim_unbox_of_builtin(body, "blorp_checked_get", 2)
		_:
			False


pure func test_constant_enum_checked_read_uses_int_intrinsic() -> Bool:
	color_type: CoreType = EnumType("Color")
	values_type: CoreType = tensor_with_dims(color_type, [TensorStaticDim(4)])
	read: CoreExpr = builtin_call(
		"blorp_checked_get",
		[variable("values", values_type), int_literal(2)],
		color_type,
	)

	match specialized_body(read):
		Some(body):
			is_intrinsic_call(body, "tensor_get_i64", 2)
		_:
			False


pure func test_float_matrix_checked_read_uses_typed_runtime() -> Bool:
	values_type: CoreType = tensor_with_dims(
		FLOAT_TYPE,
		[TensorStaticDim(2), TensorStaticDim(3)],
	)
	read: CoreExpr = builtin_call(
		"blorp_matrix_checked_get",
		[variable("values", values_type), int_literal(1), int_literal(2)],
		FLOAT_TYPE,
	)

	match specialized_body(read):
		Some(body):
			is_builtin_call(body, "blorp_matrix_checked_get_f64", 3)
		_:
			False


pure func test_rank3_int_checked_read_injects_static_shape() -> Bool:
	values_type: CoreType = tensor_with_dims(
		INT_TYPE,
		[TensorStaticDim(2), TensorStaticDim(3), TensorStaticDim(4)],
	)
	read: CoreExpr = builtin_call(
		"blorp_tensor3_checked_get",
		[
			variable("values", values_type),
			variable("i", INT_TYPE),
			variable("j", INT_TYPE),
			variable("k", INT_TYPE),
		],
		INT_TYPE,
	)

	match specialized_body(read):
		Some(body):
			is_prim_unbox_of_rank3_shape_call(body, "blorp_tensor3_checked_get_shape")
		_:
			False


pure func test_rank3_float_checked_read_uses_typed_shape_runtime() -> Bool:
	values_type: CoreType = tensor_with_dims(
		FLOAT_TYPE,
		[TensorStaticDim(2), TensorStaticDim(3), TensorStaticDim(4)],
	)
	read: CoreExpr = builtin_call(
		"blorp_tensor3_checked_get",
		[
			variable("values", values_type),
			variable("i", INT_TYPE),
			variable("j", INT_TYPE),
			variable("k", INT_TYPE),
		],
		FLOAT_TYPE,
	)

	match specialized_body(read):
		Some(body):
			is_rank3_shape_call(body, "blorp_tensor3_checked_get_shape_f64")
		_:
			False


pure func test_typed_vector_and_matrix_writes_select_runtime() -> Bool:
	vector_type: CoreType = tensor_type(4)
	matrix_type: CoreType = tensor_with_dims(
		FLOAT_TYPE,
		[TensorStaticDim(2), TensorStaticDim(3)],
	)
	vector_write: CoreExpr = builtin_call(
		"blorp_checked_set",
		[variable("values", vector_type), int_literal(1), float_literal(2.0)],
		vector_type,
	)
	matrix_write: CoreExpr = builtin_call(
		"blorp_matrix_checked_set",
		[variable("matrix", matrix_type), int_literal(1), int_literal(2), float_literal(3.0)],
		matrix_type,
	)

	match specialized_body(vector_write):
		Some(vector_body):
			match specialized_body(matrix_write):
				Some(matrix_body):
					(
						is_builtin_call(vector_body, "blorp_vector_set_inplace_f64", 3)
						and is_builtin_call(matrix_body, "blorp_matrix_checked_set_f64", 4)
					)
				_:
					False
		_:
			False


pure func test_preboxed_numeric_write_keeps_generic_runtime() -> Bool:
	values_type: CoreType = tensor_with_dims(INT_TYPE, [TensorStaticDim(4)])
	boxed_value: CoreExpr = BoxExpr(
		{
			kind = PrimBox,
			value = int_literal(2),
			source_type = INT_TYPE
		},
		RAW_POINTER_TYPE,
		SyntheticSourceLoc,
	)
	write: CoreExpr = builtin_call(
		"blorp_checked_set",
		[variable("values", values_type), int_literal(1), boxed_value],
		values_type,
	)

	match specialized_body(write):
		Some(body):
			is_builtin_call(body, "blorp_checked_set", 3)
		_:
			False


pure func vector_fill(element_type: CoreType) -> CoreExpr:
	result_type: CoreType = tensor_with_dims(element_type, [TensorStaticDim(4)])
	builtin_call(
		"blorp_vector_new_fill",
		[variable("value", element_type), int_literal(4)],
		result_type,
	)


pure func matrix_fill(element_type: CoreType) -> CoreExpr:
	result_type: CoreType = tensor_with_dims(
		element_type,
		[TensorStaticDim(2), TensorStaticDim(3)],
	)
	builtin_call(
		"blorp_matrix_new_fill",
		[variable("value", element_type), int_literal(2), int_literal(3)],
		result_type,
	)


pure func test_numeric_vector_fills_select_runtime() -> Bool:
	(
		specializes_to_builtin(vector_fill(INT_TYPE), "blorp_vector_new_fill_i64", 2)
		and specializes_to_builtin(vector_fill(FLOAT_TYPE), "blorp_vector_new_fill_f64", 2)
		and specializes_to_builtin(vector_fill(FLOAT32_TYPE), "blorp_vector_new_fill_f32", 2)
	)


pure func test_numeric_matrix_fills_select_runtime() -> Bool:
	(
		specializes_to_builtin(matrix_fill(INT_TYPE), "blorp_matrix_new_fill_i64", 3)
		and specializes_to_builtin(matrix_fill(FLOAT_TYPE), "blorp_matrix_new_fill_f64", 3)
		and specializes_to_builtin(matrix_fill(FLOAT32_TYPE), "blorp_matrix_new_fill_f32", 3)
	)


pure func test_float16_fill_stays_generic() -> Bool:
	match specialized_body(vector_fill(FLOAT16_TYPE)):
		Some(body):
			is_builtin_call(body, "blorp_vector_new_fill", 2)
		_:
			False


pure func unary_tensor_math_call(
	name: String,
	element_type: CoreType,
	result_type: CoreType,
) -> CoreExpr:
	values_type: CoreType = tensor_with_dims(element_type, [TensorStaticDim(4)])
	builtin_call(name, [variable("values", values_type)], result_type)


pure func selected_unary_tensor_math_call(
	name: String,
	element_type: CoreType,
	result_type: CoreType,
) -> CoreExpr:
	values_type: CoreType = tensor_with_dims(element_type, [TensorStaticDim(4)])
	CallExpr(
		SelectedDirectCall(17),
		VarExpr(
			{
				name = name,
				uniq = 0,
				def_id = Some(17)
			},
			NamedType(
				"Function",
				[],
			),
			SyntheticSourceLoc,
		),
		[variable("values", values_type)],
		result_type,
		SyntheticSourceLoc,
	)


pure func user_unary_tensor_math_call(
	name: String,
	element_type: CoreType,
	result_type: CoreType,
) -> CoreExpr:
	values_type: CoreType = tensor_with_dims(element_type, [TensorStaticDim(4)])
	CallExpr(
		UserCall(
			name,
			Some(17),
			[],
		),
		VarExpr(
			{
				name = name,
				uniq = 0,
				def_id = Some(17)
			},
			NamedType(
				"Function",
				[],
			),
			SyntheticSourceLoc,
		),
		[variable("values", values_type)],
		result_type,
		SyntheticSourceLoc,
	)


pure func unary_tensor_math_specializes(
	name: String,
	runtime_name: String,
	element_type: CoreType,
	result_type: CoreType,
) -> Bool:
	specializes_to_builtin(
		unary_tensor_math_call(name, element_type, result_type),
		runtime_name,
		1,
	)


pure func test_float_unary_tensor_math_uses_base_runtime() -> Bool:
	vector_type: CoreType = tensor_with_dims(FLOAT_TYPE, [TensorStaticDim(4)])

	(
		unary_tensor_math_specializes(
			"blorp_vector_norm",
			"blorp_vector_norm",
			FLOAT_TYPE,
			FLOAT_TYPE,
		)
		and unary_tensor_math_specializes(
			"blorp_vector_sqrt",
			"blorp_vector_sqrt",
			FLOAT_TYPE,
			vector_type,
		)
		and unary_tensor_math_specializes(
			"blorp_vector_exp",
			"blorp_vector_exp",
			FLOAT_TYPE,
			vector_type,
		)
		and unary_tensor_math_specializes(
			"blorp_vector_log",
			"blorp_vector_log",
			FLOAT_TYPE,
			vector_type,
		)
	)


pure func test_float32_unary_tensor_math_selects_runtime() -> Bool:
	vector_type: CoreType = tensor_with_dims(FLOAT32_TYPE, [TensorStaticDim(4)])

	(
		unary_tensor_math_specializes(
			"blorp_vector_norm",
			"blorp_vector_norm_float32",
			FLOAT32_TYPE,
			FLOAT32_TYPE,
		)
		and unary_tensor_math_specializes(
			"blorp_vector_sqrt",
			"blorp_vector_sqrt_float32",
			FLOAT32_TYPE,
			vector_type,
		)
		and unary_tensor_math_specializes(
			"blorp_vector_exp",
			"blorp_vector_exp_float32",
			FLOAT32_TYPE,
			vector_type,
		)
		and unary_tensor_math_specializes(
			"blorp_vector_log",
			"blorp_vector_log_float32",
			FLOAT32_TYPE,
			vector_type,
		)
	)


pure func test_imported_scalar_math_lift_selects_tensor_runtime() -> Bool:
	vector_type: CoreType = tensor_with_dims(FLOAT_TYPE, [TensorStaticDim(4)])

	selected_ok: Bool = match specialized_body(
		selected_unary_tensor_math_call(
			"std_float__sqrt",
			FLOAT_TYPE,
			vector_type,
		),
	):
		Some(body):
			contains_builtin_named(body, "blorp_vector_sqrt")
		_:
			False

	user_ok: Bool = match specialized_body(
		user_unary_tensor_math_call(
			"std_float__sqrt",
			FLOAT_TYPE,
			vector_type,
		),
	):
		Some(body):
			contains_builtin_named(body, "blorp_vector_sqrt")
		_:
			False

	selected_ok and user_ok


pure func test_float16_unary_tensor_math_selects_runtime() -> Bool:
	vector_type: CoreType = tensor_with_dims(FLOAT16_TYPE, [TensorStaticDim(4)])

	(
