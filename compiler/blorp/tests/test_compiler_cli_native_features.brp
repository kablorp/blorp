import:
	../src/stage_03_parse/parser_bridge as ParserBridge
	../src/stage_03_parse/source_ast_finalize: FinalizedTypecheckProgram
	../src/stage_10_backend/build_artifact: BuildNativeFeature(BuildRaylib, BuildTls)
	../src/stage_12_cli/cli_native_features: graph_native_features
	../src/stage_12_cli/cli_plan:
		CliFrontendGraphSource,
		CliFrontendModuleGraph,
		CliFrontendModuleOrigin(CliFrontendPkgModule, CliFrontendStdModule, CliFrontendUserModule),
	test: TestSuite


private pure func typecheck_program_fixture(
	path: String,
	module_name: String,
) -> FinalizedTypecheckProgram:
	ParserBridge.parsed_typecheck_source_bridge_artifact(path, module_name, "", False).program


private pure func graph_source(
	path: String,
	module_name: String,
	origin: CliFrontendModuleOrigin,
) -> CliFrontendGraphSource:
	{
		path = path,
		module_name = module_name,
		source_text = "",
		typecheck_program = typecheck_program_fixture(path, module_name),
		origin = origin
	}


pure func test_native_features_come_from_graph_identity() -> Bool:
	graph: CliFrontendModuleGraph = {
		context = {
			std_dir = None,
			source_packages = [],
			package_roots = []
		},
		roots = [graph_source("/project/main.brp", "main", CliFrontendUserModule)],
		modules = [
			graph_source("/builtin/raylib.brp", "pkg/raylib/core", CliFrontendPkgModule("raylib")),
			graph_source("/project/std/net/tls.brp", "std/net/tls", CliFrontendStdModule),
			graph_source("/other/raylib.brp", "not_raylib", CliFrontendUserModule),
			graph_source("/other/tls.brp", "std/net/tls", CliFrontendUserModule),
		],
		import_edges = [],
		diagnostics = []
	}

	graph_native_features(graph) == [BuildRaylib, BuildTls]


tests: TestSuite = {
	description = "Blorp CLI native features",
	tests = [
		(
			"derive native features from graph identity",
			test_native_features_come_from_graph_identity,
		),
	]
}
