func test_render_backend_errors_are_typed() -> Bool:
	match render_prepared_backend("backend_dict_ctor_custom_no_release", ["hash_key"]):
		Ok(rendered):
			False
		Err(error):
			match error:
				WrongArity(info, got):
					(
						prepared_backend_template_name(
							info,
						) == "backend_dict_ctor_custom_no_release"
						and prepared_backend_template_arity(info) == 2
						and got == 1
					)
				UnsupportedPreparedBackendOp(name):
					False


func test_render_error_to_string() -> Bool:
	arity_text: String = match render_prepared_backend("backend_set_ctor_generic", ["extra"]):
		Ok(rendered):
			rendered
		Err(error):
			render_error_to_string(error)

	unsupported_text: String = render_error_to_string(UnsupportedPreparedBackendOp("missing"))

	(
		arity_text == "prepared backend op backend_set_ctor_generic expected 0 arg(s), got 1"
		and unsupported_text == "unsupported prepared backend op: missing"
	)


