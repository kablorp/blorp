import:
	../codegen_prepared_backend_renderer:
		ALL_TEMPLATES,
		RenderError(UnsupportedPreparedBackendOp, WrongArity),
		parse_prepared_backend_template,
		prepared_backend_template_arity,
		prepared_backend_template_name,
		render_error_to_string,
		render_manifest_line,
		render_manifest_lines,
		render_prepared_backend,
	test: TestSuite


func parsed_template_has(name: String, expected_name: String, expected_arity: Int) -> Bool:
	match parse_prepared_backend_template(name):
		Some(info):
			(
				prepared_backend_template_name(info) == expected_name
				and prepared_backend_template_arity(info) == expected_arity
			)
		None:
			False


func manifest_line_is(name: String, expected: String) -> Bool:
	match parse_prepared_backend_template(name):
		Some(info):
			render_manifest_line(info) == expected
		None:
			False


func rendered_backend_is(name: String, args: List[String], expected: String) -> Bool:
	match render_prepared_backend(name, args):
		Ok(rendered):
			rendered == expected
		Err(error):
			False


