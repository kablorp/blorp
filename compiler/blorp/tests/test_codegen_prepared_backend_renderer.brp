import:
	../src/stage_10_backend/codegen_prepared_backend_renderer:
		ChannelRecvReleasePolicy(KeepChannelRecvValue, ReleaseChannelRecvValue),
		ChannelRetainingSendRuntime(ChannelSendRuntime),
		ChannelRetainingSendTimeoutRuntime(ChannelSendTimeoutRuntime),
		DictKeyReleasePolicy(DictKeepKey, DictReleaseKey),
		ElemReleaseArg(ElemReleaseFn, NoElemRelease),
		PreparedBackendOp(
			BackendChannelIterHeader,
			BackendChannelIterLoopOpen,
			BackendChannelIterReleaseObject,
			BackendChannelIterSourceBinding,
			BackendChannelIterValueInit,
			BackendChannelRecvTimeoutAttempt,
			BackendChannelRecvTimeoutAttemptNoReleaseMask,
			BackendChannelRetainingSend,
			BackendChannelRetainingSendWithTimeout,
			BackendChannelSendTimeoutAttemptRetainedValue,
			BackendChannelTryRecvAttempt,
			BackendChannelTryRecvAttemptNoReleaseMask,
			BackendChannelTrySendAttempt,
			BackendDictConstructEmpty,
			BackendDictConstructWithBody,
			BackendDictCtorCustom,
			BackendDictCtorString,
			BackendDictInsert,
			BackendDictIterDeletedSlotGuard,
			BackendDictIterHeader,
			BackendDictIterKeyBinding,
			BackendDictIterLoopOpen,
			BackendDictIterPairBinding,
			BackendDictIterSlotBinding,
			BackendDictIterSourceBinding,
			BackendDictStackOptionInt128Get,
			BackendDictStackOptionLongGet,
			BackendDictStackOptionUInt128Get,
			BackendDictStackOptionValueRecordGet,
			BackendDictValueReleaseInit,
			BackendDictWithCapacityCustom,
			BackendFlatIterLengthBinding,
			BackendFlatIterLoopHeader,
			BackendFlatIterLoopOpen,
			BackendFlatIterRawDataBinding,
			BackendFlatIterRawValueBinding,
			BackendFlatIterSourceBinding,
			BackendSelectAfterArm,
			BackendSelectArmsDecl,
			BackendSelectCleanupFrameDecl,
			BackendSelectCleanupPop,
			BackendSelectCleanupPush,
			BackendSelectFirstBranchOpen,
			BackendSelectNextBranchOpen,
			BackendSelectReceivedValueBinding,
			BackendSelectRecvArm,
			BackendSelectSealedArm,
			BackendSelectWait,
			BackendSetCtorCustom,
			BackendSetIterEntryKey,
			BackendSetIterHeader,
			BackendSetIterLoopOpen,
			BackendSetIterRelease,
			BackendSetIterRetain,
			BackendSetIterSourceBinding,
			BackendStackOptionNone,
			BackendStackOptionSomeValue,
			BackendStackOptionSomeVoidStatement,
			BackendStackOptionTaggedNone,
			BackendStackOptionTaggedValue,
			BackendStackOptionTaggedVoidStatement,
			BackendStackResultErr,
			BackendStackResultOk,
			BackendStackResultTaggedPayload,
			BackendStringByteCopy,
			BackendStringByteRead,
			BackendStringByteWrite,
			BackendStringFindByteFrom,
			BackendStringIterCodepointBinding,
			BackendStringIterHeader,
			BackendStringIterLoopOpen,
			BackendStringIterSourceBinding,
			BackendStringSetLen,
		),
		render_prepared_backend_op,
	test: TestSuite


func rendered_backend_op_is(op: PreparedBackendOp, expected: String) -> Bool:
	render_prepared_backend_op(op) == expected


pure func one_line(text: String) -> String:
	text.replace("\n", " ")


func test_render_backend_successes() -> Bool:
	dict_string_ok: Bool = rendered_backend_op_is(BackendDictCtorString, "blorp_dict_new_string()")
	dict_custom_release_ok: Bool = rendered_backend_op_is(
		BackendDictCtorCustom(
			{
				hash_fn = "hash_key",
				equals_fn = "equals_key"
			},
			ElemReleaseFn,
		),
		(
			"blorp_dict_new_custom((unsigned long (*)(void*))hash_key, (bool (*)(void*, "
			+ "void*))equals_key, blorp_elem_release_fn)"
		),
	)
	dict_value_record_ok: Bool = rendered_backend_op_is(
		BackendDictStackOptionValueRecordGet(
			{
				dict = "dict",
				key = "key",
				temp_seed = "0",
				option_c_type = "blorp_StackOption_Point",
				payload_c_type = "Point",
				none_value = "{0}"
			},
			DictKeepKey,
		),
		(
			"({ blorp_Dict* __gso_dict_0 = (blorp_Dict*)dict; void* __gso_key_0 = key; void* "
			+ "__gso_raw_0 = NULL; bool __gso_found_0 = blorp_dict_get_raw(__gso_dict_0, "
			+ "__gso_key_0, &__gso_raw_0); blorp_StackOption_Point __gso_result_0; if "
			+ "(__gso_found_0) { __gso_result_0 = ((blorp_StackOption_Point){ .tag = "
			+ "BLORP_TAG_SOME, .value = blorp_unbox_struct(__gso_raw_0, Point) }); } else { "
			+ "__gso_result_0 = ((blorp_StackOption_Point){ .tag = BLORP_TAG_NONE, .value = "
			+ "{0} }); } __gso_result_0; })"
		),
	)
	dict_long_release_ok: Bool = rendered_backend_op_is(
		BackendDictStackOptionLongGet(
			{
				dict = "dict",
				key = "key",
				temp_seed = "0",
				option_c_type = "blorp_StackOption_Range",
				none_value = "0"
			},
			DictReleaseKey,
		),
		(
			"({ blorp_Dict* __gso_dict_0 = (blorp_Dict*)dict; void* __gso_key_0 = key; void* "
			+ "__gso_raw_0 = NULL; bool __gso_found_0 = blorp_dict_get_raw(__gso_dict_0, "
			+ "__gso_key_0, &__gso_raw_0); blorp_StackOption_Range __gso_result_0; if "
			+ "(__gso_found_0) { __gso_result_0 = ((blorp_StackOption_Range){ .tag = "
			+ "BLORP_TAG_SOME, .value = (long)__gso_raw_0 }); } else { __gso_result_0 = "
			+ "((blorp_StackOption_Range){ .tag = BLORP_TAG_NONE, .value = 0 }); } "
			+ "blorp_release(__gso_key_0); __gso_result_0; })"
		),
	)
	dict_int128_ok: Bool = rendered_backend_op_is(
		BackendDictStackOptionInt128Get(
			{
				dict = "dict",
				key = "key",
				temp_seed = "0",
				option_c_type = "blorp_StackOption_Int128",
				none_value = "0"
			},
			DictKeepKey,
		),
		(
			"({ blorp_Dict* __gso_dict_0 = (blorp_Dict*)dict; void* __gso_key_0 = key; void* "
			+ "__gso_raw_0 = NULL; bool __gso_found_0 = blorp_dict_get_raw(__gso_dict_0, "
			+ "__gso_key_0, &__gso_raw_0); blorp_StackOption_Int128 __gso_result_0; if "
			+ "(__gso_found_0) { __gso_result_0 = ((blorp_StackOption_Int128){ .tag = "
			+ "BLORP_TAG_SOME, .value = blorp_unbox_int128(__gso_raw_0) }); } else { "
			+ "__gso_result_0 = ((blorp_StackOption_Int128){ .tag = BLORP_TAG_NONE, .value = 0 "
			+ "}); } __gso_result_0; })"
		),
	)
	dict_uint128_release_ok: Bool = rendered_backend_op_is(
		BackendDictStackOptionUInt128Get(
			{
				dict = "dict",
				key = "key",
				temp_seed = "0",
				option_c_type = "blorp_StackOption_UInt128",
				none_value = "0"
			},
			DictReleaseKey,
		),
		(
			"({ blorp_Dict* __gso_dict_0 = (blorp_Dict*)dict; void* __gso_key_0 = key; void* "
			+ "__gso_raw_0 = NULL; bool __gso_found_0 = blorp_dict_get_raw(__gso_dict_0, "
			+ "__gso_key_0, &__gso_raw_0); blorp_StackOption_UInt128 __gso_result_0; if "
			+ "(__gso_found_0) { __gso_result_0 = ((blorp_StackOption_UInt128){ .tag = "
			+ "BLORP_TAG_SOME, .value = blorp_unbox_uint128(__gso_raw_0) }); } else { "
			+ "__gso_result_0 = ((blorp_StackOption_UInt128){ .tag = BLORP_TAG_NONE, .value = "
			+ "0 }); } blorp_release(__gso_key_0); __gso_result_0; })"
		),
	)
	dict_construct_empty_ok: Bool = rendered_backend_op_is(
		BackendDictConstructEmpty("blorp_dict_new()"),
		"blorp_dict_new()",
	)
	dict_value_release_ok: Bool = rendered_backend_op_is(
		BackendDictValueReleaseInit("0"),
		" blorp_dict_set_value_release(__dict_0, blorp_elem_release_fn);",
	)
	dict_insert_ok: Bool = rendered_backend_op_is(BackendDictInsert({
			temp_seed = "0",
			key = "(void*)(long)(1L)",
			value = "(void*)(long)(10L)",
			key_transfers_ownership = False,
			value_transfers_ownership = False,
		}), " __dict_0 = blorp_dict_insert(__dict_0, (void*)(long)(1L), (void*)(long)(10L));")
	dict_insert_owned_ok: Bool = rendered_backend_op_is(
		BackendDictInsert({
			temp_seed = "1",
			key = "make_key()",
			value = "make_value()",
			key_transfers_ownership = True,
			value_transfers_ownership = True,
		}),
		(
			" { void* __dict_key_1 = make_key(); void* __dict_value_1 = make_value(); "
			+ "__dict_1 = blorp_dict_insert(__dict_1, __dict_key_1, __dict_value_1); "
			+ "blorp_release(__dict_key_1); blorp_release(__dict_value_1); }"
		),
	)
	dict_iter_source_ok: Bool = rendered_backend_op_is(BackendDictIterSourceBinding({
			dict = "__dict_iter_0",
			source = "items",
		}), "blorp_Dict* __dict_iter_0 = (blorp_Dict*)items;")
	dict_iter_loop_ok: Bool = rendered_backend_op_is(BackendDictIterLoopOpen({
			index = "__di_0",
			dict = "__dict_iter_0",
		}), "for (long __di_0 = 0; __di_0 < __dict_iter_0->order_len; __di_0++) {")
	dict_iter_header_ok: Bool = rendered_backend_op_is(
		BackendDictIterHeader({
			dict = "__dict_iter_0",
			source = "items",
			index = "__di_0",
		}),
		(
			"blorp_Dict* __dict_iter_0 = (blorp_Dict*)items; for (long __di_0 = 0; __di_0 < "
			+ "__dict_iter_0->order_len; __di_0++) {"
		),
	)
	dict_iter_slot_ok: Bool = rendered_backend_op_is(BackendDictIterSlotBinding({
			slot = "__dslot_0",
			dict = "__dict_iter_0",
			index = "__di_0",
		}), "long __dslot_0 = __dict_iter_0->order[__di_0];")
	dict_iter_guard_ok: Bool = rendered_backend_op_is(
		BackendDictIterDeletedSlotGuard("__dslot_0"),
		"if (__dslot_0 < 0) continue;",
	)
	dict_iter_key_ok: Bool = rendered_backend_op_is(BackendDictIterKeyBinding({
			key_c_type = "long",
			binding = "key",
			dict = "__dict_iter_0",
			slot = "__dslot_0",
		}), "long key = (long)__dict_iter_0->keys[__dslot_0];")
	dict_iter_pair_ok: Bool = rendered_backend_op_is(
		BackendDictIterPairBinding({
			entry = "entry",
			dict = "__dict_iter_0",
			slot = "__dslot_0",
		}),
		(
			"blorp_Tuple* entry = blorp_tuple_new(2, __dict_iter_0->keys[__dslot_0], "
			+ "__dict_iter_0->values[__dslot_0]);"
		),
	)
	dict_construct_with_body_ok: Bool = rendered_backend_op_is(
		BackendDictConstructWithBody({
			ctor = "blorp_dict_new()",
			temp_seed = "0",
			release_init = " blorp_dict_set_value_release(__dict_0, blorp_elem_release_fn);",
			insert_statements = " __dict_0 = blorp_dict_insert(__dict_0, key, value);",
		}),
		(
			"({ blorp_Dict* __dict_0 = blorp_dict_new(); blorp_dict_set_value_release(__dict_"
			+ "0, blorp_elem_release_fn); __dict_0 = blorp_dict_insert(__dict_0, key, value); "
			+ "__dict_0; })"
		),
	)
	set_custom_no_release_ok: Bool = rendered_backend_op_is(
		BackendSetCtorCustom(
			{
				hash_fn = "hash_key",
				equals_fn = "equals_key"
			},
			NoElemRelease,
		),
		(
			"blorp_set_new_custom((unsigned long (*)(void*))hash_key, (bool (*)(void*, "
			+ "void*))equals_key, NULL)"
		),
	)
	set_iter_source_ok: Bool = rendered_backend_op_is(BackendSetIterSourceBinding({
			set = "__set_iter_0",
			source = "items",
		}), "blorp_Set* __set_iter_0 = (blorp_Set*)items;")
	set_iter_retain_ok: Bool = rendered_backend_op_is(
		BackendSetIterRetain("__set_iter_0"),
		"blorp_retain(__set_iter_0);",
	)
	set_iter_loop_ok: Bool = rendered_backend_op_is(
		BackendSetIterLoopOpen({
			entry = "__set_entry_0",
			set = "__set_iter_0",
		}),
		(
			"for (blorp_SetEntry* __set_entry_0 = __set_iter_0->first; __set_entry_0 != NULL;"
			+ " __set_entry_0 = __set_entry_0->next_order) {"
		),
	)
	set_iter_header_ok: Bool = rendered_backend_op_is(
		BackendSetIterHeader({
			set = "__set_iter_0",
			source = "items",
			entry = "__set_entry_0",
		}),
		(
			"blorp_Set* __set_iter_0 = (blorp_Set*)items; blorp_retain(__set_iter_0); for "
			+ "(blorp_SetEntry* __set_entry_0 = __set_iter_0->first; __set_entry_0 != NULL; "
			+ "__set_entry_0 = __set_entry_0->next_order) {"
		),
	)
	set_iter_entry_key_ok: Bool = rendered_backend_op_is(
		BackendSetIterEntryKey("__set_entry_0"),
		"__set_entry_0->key",
	)
	set_iter_release_ok: Bool = rendered_backend_op_is(
		BackendSetIterRelease("__set_iter_0"),
		"blorp_release(__set_iter_0);",
	)
	string_find_ok: Bool = rendered_backend_op_is(
		BackendStringFindByteFrom({
			source = "source",
			byte = "byte",
			start = "start",
			temp_seed = "seed",
		}),
		(
			"({ blorp_String* __string_find_src_seed = (blorp_String*)source; long "
			+ "__string_find_byte_seed = byte; long __string_find_start_seed = start; "
			+ "blorp_string_find_byte_from(__string_find_src_seed, __string_find_byte_seed, "
			+ "__string_find_start_seed); })"
		),
	)
	string_read_ok: Bool = rendered_backend_op_is(
		BackendStringByteRead("src", "idx"),
		"(long)(unsigned char)((blorp_String*)src)->data[idx]",
	)
	string_write_ok: Bool = rendered_backend_op_is(
		BackendStringByteWrite("dst", "idx", "byte"),
		"(((blorp_String*)dst)->data[idx] = (char)byte)",
	)
	string_copy_ok: Bool = rendered_backend_op_is(
		BackendStringByteCopy({
			dst = "dst",
			dst_pos = "dst_pos",
			src = "src",
			src_pos = "src_pos",
			len = "len",
			temp_seed = "seed",
		}),
		(
			"({ blorp_String* __string_copy_dst_seed = (blorp_String*)dst; long "
			+ "__string_copy_dst_pos_seed = dst_pos; blorp_String* __string_copy_src_seed = "
			+ "(blorp_String*)src; long __string_copy_src_pos_seed = src_pos; long "
			+ "__string_copy_len_seed = len; if (__string_copy_len_seed > 0) { "
			+ "memcpy(__string_copy_dst_seed->data + __string_copy_dst_pos_seed, "
			+ "__string_copy_src_seed->data + __string_copy_src_pos_seed, "
			+ "(size_t)__string_copy_len_seed); } (void)0; })"
		),
	)
	string_set_len_ok: Bool = rendered_backend_op_is(
		BackendStringSetLen("target", "new_len"),
		"({ blorp_String* __sl = (blorp_String*)target; long __sn = new_len; __sl->len = __sn; __sl->data[__sn] = '\\0'; (void)0; })",
	)
	capacity_custom_release_ok: Bool = rendered_backend_op_is(
		BackendDictWithCapacityCustom(
			{
				capacity = "cap",
				hash_fn = "hash_key",
				equals_fn = "equals_key"
			},
			ElemReleaseFn,
		),
		(
			"blorp_dict_with_capacity_custom(cap, (unsigned long (*)(void*))hash_key, (bool "
			+ "(*)(void*, void*))equals_key, blorp_elem_release_fn)"
		),
	)
	channel_release_expected: String =
		|({ blorp_Channel* __ch_0 = blorp_channel_new(cap);
		|blorp_channel_init_elem_release(__ch_0, blorp_elem_release_fn); __ch_0; })
	channel_release_ok: Bool = rendered_backend_op_is(BackendChannelWithElemRelease({
			capacity = "cap",
			temp_seed = "0",
		}), one_line(channel_release_expected))
	channel_retaining_send_expected: String =
		|({ void* __chan_send_value_1 = make_value();
		|blorp_CancelCleanupFrame __chan_send_cleanup_1;
		|blorp_task_cleanup_push(&__chan_send_cleanup_1, &__chan_send_value_1, (void*)__chan_send_value_1, blorp_cleanup_release_arc_value);
		|long __chan_send_result_1 = blorp_channel_send(ch, __chan_send_value_1);
		|blorp_task_cleanup_pop_slot(&__chan_send_value_1);
		|blorp_release(__chan_send_value_1); __chan_send_result_1; })
	channel_retaining_send_ok: Bool = rendered_backend_op_is(
		BackendChannelRetainingSend(
			{
				result_type = "long",
				channel = "ch",
				value = "make_value()",
				temp_seed = "1"
			},
			ChannelSendRuntime,
		),
		one_line(channel_retaining_send_expected),
	)
	channel_retaining_send_timeout_expected: String =
		|({ void* __chan_send_value_4 = make_value();
		|blorp_CancelCleanupFrame __chan_send_cleanup_4;
		|blorp_task_cleanup_push(&__chan_send_cleanup_4, &__chan_send_value_4, (void*)__chan_send_value_4, blorp_cleanup_release_arc_value);
		|long __chan_send_result_4 = blorp_channel_send_timeout(ch, __chan_send_value_4, timeout_ms);
		|blorp_task_cleanup_pop_slot(&__chan_send_value_4);
		|blorp_release(__chan_send_value_4); __chan_send_result_4; })
	channel_retaining_send_timeout_ok: Bool = rendered_backend_op_is(
		BackendChannelRetainingSendWithTimeout(
			{
				result_type = "long",
				channel = "ch",
				value = "make_value()",
				timeout = "timeout_ms",
				temp_seed = "4"
			},
			ChannelSendTimeoutRuntime,
		),
		one_line(channel_retaining_send_timeout_expected),
	)
	channel_try_send_attempt_expected: String =
		|({ long __chan_send_status_0 = blorp_channel_try_send_status(ch, value);
		|SendAttemptC __chan_send_result_0;
		|if (__chan_send_status_0 == BLORP_CHANNEL_SEND_ACCEPTED) { __chan_send_result_0 = ACCEPTED; }
		|else if (__chan_send_status_0 == BLORP_CHANNEL_SEND_WOULD_BLOCK) { __chan_send_result_0 = WOULD_BLOCK; }
		|else if (__chan_send_status_0 == BLORP_CHANNEL_SEND_SEALED) { __chan_send_result_0 = SEALED; }
		|else { __chan_send_result_0 = TIMED_OUT; }
		|__chan_send_result_0; })
	channel_try_send_attempt_ok: Bool = rendered_backend_op_is(
		BackendChannelTrySendAttempt({
			result_type = "SendAttemptC",
			channel = "ch",
			value = "value",
			temp_seed = "0",
			constructors = {
				accepted = "ACCEPTED",
				would_block = "WOULD_BLOCK",
				sealed = "SEALED",
				timed_out = "TIMED_OUT"
			},
		}),
		one_line(channel_try_send_attempt_expected),
	)
	channel_send_timeout_attempt_retained_expected: String =
		|({ void* __chan_send_value_0 = make_value();
		|blorp_CancelCleanupFrame __chan_send_cleanup_0;
		|blorp_task_cleanup_push(&__chan_send_cleanup_0, &__chan_send_value_0, (void*)__chan_send_value_0, blorp_cleanup_release_arc_value);
		|long __chan_send_status_0 = blorp_channel_send_timeout_status(ch, __chan_send_value_0, timeout_ms);
		|blorp_task_cleanup_pop_slot(&__chan_send_value_0);
		|blorp_release(__chan_send_value_0);
		|SendAttemptC __chan_send_result_0;
		|if (__chan_send_status_0 == BLORP_CHANNEL_SEND_ACCEPTED) { __chan_send_result_0 = ACCEPTED; }
		|else if (__chan_send_status_0 == BLORP_CHANNEL_SEND_WOULD_BLOCK) { __chan_send_result_0 = WOULD_BLOCK; }
		|else if (__chan_send_status_0 == BLORP_CHANNEL_SEND_SEALED) { __chan_send_result_0 = SEALED; }
		|else { __chan_send_result_0 = TIMED_OUT; }
		|__chan_send_result_0; })
	channel_send_timeout_attempt_retained_ok: Bool = rendered_backend_op_is(
		BackendChannelSendTimeoutAttemptRetainedValue({
			result_type = "SendAttemptC",
			channel = "ch",
			value = "make_value()",
			timeout = "timeout_ms",
			temp_seed = "0",
			constructors = {
				accepted = "ACCEPTED",
				would_block = "WOULD_BLOCK",
				sealed = "SEALED",
				timed_out = "TIMED_OUT"
			},
		}),
		one_line(channel_send_timeout_attempt_retained_expected),
	)
	channel_try_recv_attempt_keep_expected: String =
		|({ void* __chan_recv_value_0 = NULL;
		|long __chan_recv_status_0 = blorp_channel_try_recv_status_raw((blorp_Channel*)ch, &__chan_recv_value_0);
		|RecvAttemptC __chan_recv_result_0;
		|if (__chan_recv_status_0 == BLORP_CHANNEL_RECV_VALUE) { __chan_recv_result_0 = VALUE(__chan_recv_value_0, 0UL); }
		|else if (__chan_recv_status_0 == BLORP_CHANNEL_RECV_SEALED) { __chan_recv_result_0 = SEALED; }
		|else { __chan_recv_result_0 = EMPTY; }
		|__chan_recv_result_0; })
	channel_try_recv_attempt_keep_ok: Bool = rendered_backend_op_is(
		BackendChannelTryRecvAttempt({
			result_type = "RecvAttemptC",
			channel = "ch",
			temp_seed = "0",
			release_policy = KeepChannelRecvValue,
			constructors = {
				value = "VALUE",
				sealed = "SEALED",
				empty = "EMPTY"
			},
		}),
		one_line(channel_try_recv_attempt_keep_expected),
	)
	channel_try_recv_attempt_release_expected: String =
		|({ void* __chan_recv_value_0 = NULL;
