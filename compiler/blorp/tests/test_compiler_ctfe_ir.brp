	test: TestSuite


pure func source_file() -> CompilerSourceFile:
	compiler_source_file("ctfe_ir.brp", "ctfe_ir", "VALUE = 1")


pure func source_span() -> CompilerSourceSpan:
	src: CompilerSourceFile = source_file()
	cursor: CompilerCursor = compiler_source_cursor_at(src, 0)
	compiler_source_span(src, cursor, cursor)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, source_span())


pure func expr_info_for(typ: CompilerType) -> CompilerTypedExprInfo:
	{
		source_type = None,
		semantic_type = typ,
		value_type = typ,
		origin = CompilerSynthesizedOrigin("ctfe_ir_test"),
		value_slot = {
			semantic_type = typ,
			decision = CompilerTypeKeep(typ)
		},
		proofs = compiler_unrefined_binding(),
		resolved_call = None,
		resource_dependencies = []
	}


pure func expr_info() -> CompilerTypedExprInfo:
	expr_info_for(compiler_type_int())


pure func void_expr_info() -> CompilerTypedExprInfo:
	expr_info_for(compiler_type_void())


pure func string_expr_info() -> CompilerTypedExprInfo:
	expr_info_for(compiler_type_string())


pure func resolved_call(
	callable_id: Int,
	source_name: String,
	purity: CompilerPurity,
) -> CompilerResolvedCallInfo:
	resolved_call_with_origin(callable_id, source_name, purity, CompilerCallableLocal)


pure func resolved_call_with_origin(
	callable_id: Int,
	source_name: String,
	purity: CompilerPurity,
	origin: CompilerCallableOrigin,
) -> CompilerResolvedCallInfo:
	{
		callee_name = source_name,
		source_name = source_name,
		purity = purity,
		target = CompilerResolvedDirectCall(callable_id, origin),
		instantiated_params = [],
		instantiated_return = compiler_type_int(),
		resource_args = CompilerRejectResourceArgs,
		dim_constraints = [],
		loop_producer = None
	}


pure func expr_info_with_call(call: CompilerResolvedCallInfo) -> CompilerTypedExprInfo:
	{ expr_info() | resolved_call = Some(call) }


pure func expr_info_for_with_call(
	typ: CompilerType,
	call: CompilerResolvedCallInfo,
) -> CompilerTypedExprInfo:
	{ expr_info_for(typ) | resolved_call = Some(call) }


pure func int_expr(text: String) -> CompilerTypedExpr:
	CompilerTypedIntLiteralExpr(text, source_span(), expr_info())


pure func bool_expr(value: Bool) -> CompilerTypedExpr:
	CompilerTypedBoolLiteralExpr(value, source_span(), expr_info_for(compiler_type_bool()))


pure func name_expr(name: String) -> CompilerTypedExpr:
	CompilerTypedNameExpr(ident(name), expr_info())


pure func name_expr_with_call(name: String, call: CompilerResolvedCallInfo) -> CompilerTypedExpr:
	CompilerTypedNameExpr(ident(name), expr_info_with_call(call))


pure func constructor_context() -> CompilerCtfeContext:
	{
		functions = [],
		imported_functions = [],
		constructors = [("None", compiler_ctfe_constructor_info("Option", 0, None))],
		module_aliases = [],
		module_global_envs = [],
		active_module_path = None
	}


pure func is_int_literal(expr: CompilerCtfeIrExpr, expected: String) -> Bool:
	match expr.desc:
		CompilerCtfeIrLiteralExpr(CompilerCtfeIrIntLiteral(text)):
			text == expected
		_:
			False


pure func matches_value_reference(expr: CompilerCtfeIrExpr) -> Bool:
	match expr.desc:
		CompilerCtfeIrIdentExpr(identifier):
			match identifier.reference_kind:
				CompilerCtfeIrValueReference:
					True
				_:
					False
		_:
			False


func test_translates_literals_and_binary_exprs() -> Bool:
	typed = CompilerTypedBinaryExpr(
		ParsedAddOp,
		int_expr("1"),
		int_expr("2"),
		source_span(),
		expr_info(),
	)

	match compiler_ctfe_ir_from_typed_expr_without_context(typed):
		Ok(expr):
			match expr.desc:
				CompilerCtfeIrBinaryExpr(ParsedAddOp, left, right):
					(
						is_int_literal(left, "1")
						and is_int_literal(right, "2")
						and compiler_types_equal(expr.value_type, compiler_type_int())
					)
				_:
					False
		Err(_):
			False


func test_translates_transparent_and_collection_exprs() -> Bool:
	list_expr = CompilerTypedListExpr(
		[int_expr("1"), int_expr("2")],
		source_span(),
		expr_info(),
	)
	typed = CompilerTypedAscriptionExpr(list_expr, compiler_type_int(), source_span(), expr_info())

	match compiler_ctfe_ir_from_typed_expr_without_context(typed):
		Ok(expr):
			match expr.desc:
				CompilerCtfeIrTransparentExpr(inner):
					match inner.desc:
						CompilerCtfeIrListExpr(items):
							items.length() == 2
						_:
							False
				_:
					False
		Err(_):
			False


func test_translates_record_and_dict_exprs() -> Bool:
	record_field: CompilerTypedRecordField = {
		name = ident("value"),
		value = int_expr("1"),
		span = source_span()
	}
	dict_entry: CompilerTypedDictEntry = {
		key = int_expr("1"),
		value = int_expr("2")
	}
	record_result = compiler_ctfe_ir_from_typed_expr_without_context(
		CompilerTypedRecordExpr(
			[record_field],
			source_span(),
			expr_info(),
		),
	)
	dict_result = compiler_ctfe_ir_from_typed_expr_without_context(
		CompilerTypedDictExpr(
			[dict_entry],
			source_span(),
			expr_info(),
		),
	)

	var record_ok: Bool = False

	match record_result:
		Ok(record_expr):
			match record_expr.desc:
				CompilerCtfeIrRecordExpr(fields):
					match fields.get(0):
						Some(field):
							record_ok = field.name == "value"
						None:
							void
				_:
					void
		Err(_):
			void

	var dict_ok: Bool = False

	match dict_result:
		Ok(dict_expr):
			match dict_expr.desc:
				CompilerCtfeIrDictExpr(entries):
					dict_ok = entries.length() == 1
				_:
					void
		Err(_):
			void

	record_ok and dict_ok


func test_translates_field_access_kinds() -> Bool:
	record_field: CompilerTypedRecordField = {
		name = ident("value"),
		value = int_expr("1"),
		span = source_span()
	}
	record_expr = CompilerTypedRecordExpr(
		[record_field],
		source_span(),
		expr_info_for(CompilerNamedType("Box", [])),
	)
	tuple_type = CompilerTupleType([compiler_type_int(), compiler_type_int()])
	tuple_expr = CompilerTypedTupleExpr(
		[int_expr("1"), int_expr("2")],
		source_span(),
		expr_info_for(tuple_type),
	)
	range_expr = CompilerTypedRangeExpr(
		int_expr("0"),
		int_expr("3"),
		source_span(),
		expr_info_for(CompilerNamedType("Range", [])),
	)

	record_result = compiler_ctfe_ir_from_typed_expr_without_context(
		CompilerTypedFieldAccessExpr(
			record_expr,
			ident("value"),
			source_span(),
			expr_info(),
		),
	)
	tuple_result = compiler_ctfe_ir_from_typed_expr_without_context(
		CompilerTypedFieldAccessExpr(
			tuple_expr,
			ident("1"),
			source_span(),
			expr_info(),
		),
	)
	range_result = compiler_ctfe_ir_from_typed_expr_without_context(
		CompilerTypedFieldAccessExpr(
			range_expr,
			ident("start"),
			source_span(),
			expr_info(),
		),
	)

	var record_ok: Bool = False

	match record_result:
		Ok(expr):
			match expr.desc:
				CompilerCtfeIrFieldAccessExpr(access):
					match access.kind:
						CompilerCtfeIrRecordField(field):
							record_ok = field == "value"
						_:
							void
				_:
					void
		Err(_):
			void

	var tuple_ok: Bool = False

	match tuple_result:
		Ok(expr):
			match expr.desc:
				CompilerCtfeIrFieldAccessExpr(access):
					match access.kind:
						CompilerCtfeIrTupleField(index, field):
							tuple_ok = index == 1 and field == "1"
						_:
							void
				_:
					void
		Err(_):
			void

	var range_ok: Bool = False

	match range_result:
		Ok(expr):
			match expr.desc:
				CompilerCtfeIrFieldAccessExpr(access):
					match access.kind:
						CompilerCtfeIrRangeStartField:
							range_ok = True
						_:
							void
				_:
					void
		Err(_):
			void

	record_ok and tuple_ok and range_ok


func test_translates_imported_global_field_access() -> Bool:
	context = compiler_ctfe_context_with_module_alias(
		compiler_ctfe_context_empty(),
		"Dep",
		"dep/math",
	)
	typed = CompilerTypedFieldAccessExpr(
		name_expr("Dep"),
		ident("OFFSET"),
		source_span(),
		expr_info(),
	)

	match compiler_ctfe_ir_from_typed_expr(context, typed):
		Ok(expr):
			match expr.desc:
				CompilerCtfeIrImportedGlobalExpr(imported):
					imported.module_path == "dep/math" and imported.name == "OFFSET"
				_:
					False
		Err(_):
			False


func test_translates_block_local_bindings() -> Bool:
	payload: CompilerTypedVarDeclPayload = {
		name = ident("x"),
		annotation = Some(compiler_type_int()),
		initializer = int_expr("1"),
		is_mutable = False,
		span = source_span()
	}
	typed = CompilerTypedBlockExpr(
		[CompilerTypedVarDeclExpr(payload, void_expr_info()), int_expr("2")],
		source_span(),
		expr_info(),
	)

	match compiler_ctfe_ir_from_typed_expr_without_context(typed):
		Ok(expr):
			match expr.desc:
				CompilerCtfeIrBlockExpr(block):
					match block.items.get(0):
						Some(item):
							match item:
								CompilerCtfeIrBindValueItem(name, _, init, is_mutable):
									(
										name == "x"
										and not is_mutable
										and is_int_literal(init, "1")
										and is_int_literal(block.result, "2")
									)
								_:
									False
						None:
							False
				_:
					False
		Err(_):
			False


func test_translates_block_local_assignment_items() -> Bool:
	payload: CompilerTypedVarDeclPayload = {
		name = ident("x"),
		annotation = Some(compiler_type_int()),
		initializer = int_expr("1"),
		is_mutable = True,
		span = source_span()
	}
	typed = CompilerTypedBlockExpr(
		[
			CompilerTypedVarDeclExpr(payload, void_expr_info()),
			CompilerTypedAssignExpr(
				ident("x"),
				CompilerLocalAssignScope,
				int_expr("2"),
				source_span(),
				void_expr_info(),
			),
			name_expr("x"),
		],
		source_span(),
		expr_info(),
	)

	match compiler_ctfe_ir_from_typed_expr_without_context(typed):
		Ok(expr):
			match expr.desc:
				CompilerCtfeIrBlockExpr(block):
					match block.items.get(1):
						Some(item):
							match item:
								CompilerCtfeIrAssignItem(target, value, _):
									match target:
										CompilerCtfeIrLocalAssign(name):
											name == "x" and is_int_literal(value, "2")
										_:
											False
								_:
									False
						None:
							False
				_:
					False
		Err(_):
			False


func test_translates_block_tuple_destructuring_items() -> Bool:
	typed = CompilerTypedBlockExpr(
		[
			CompilerTypedTupleDestructExpr(
				[ident("left"), ident("right")],
				CompilerTypedTupleExpr(
					[int_expr("1"), int_expr("2")],
					source_span(),
					expr_info(),
				),
				source_span(),
				void_expr_info(),
			),
			name_expr("left"),
		],
		source_span(),
		expr_info(),
	)

	match compiler_ctfe_ir_from_typed_expr_without_context(typed):
		Ok(expr):
			match expr.desc:
				CompilerCtfeIrBlockExpr(block):
					match block.items.get(0):
						Some(item):
							match item:
								CompilerCtfeIrBindTupleItem(names, init):
									match init.desc:
										CompilerCtfeIrTupleExpr(items):
											(
												names.length() == 2
												and names.get(0) == Some("left")
												and names.get(1) == Some("right")
												and items.length() == 2
											)
										_:
											False
								_:
									False
						None:
							False
				_:
					False
		Err(_):
			False


func test_translates_block_question_bind_items() -> Bool:
	typed = CompilerTypedBlockExpr(
		[
			CompilerTypedQuestionBindExpr(
				ident("value"),
				Some(compiler_type_int()),
				name_expr("maybe"),
				source_span(),
				void_expr_info(),
			),
			name_expr("value"),
		],
		source_span(),
		expr_info(),
	)

	match compiler_ctfe_ir_from_typed_expr_without_context(typed):
		Ok(expr):
			match expr.desc:
				CompilerCtfeIrBlockExpr(block):
					match block.items.get(0):
						Some(item):
							match item:
								CompilerCtfeIrBindQuestionItem(name, annotation, rhs):
									match annotation:
										Some(typ):
											(
												name == "value"
												and compiler_types_equal(typ, compiler_type_int())
												and matches_value_reference(rhs)
											)
										None:
											False
								_:
									False
						None:
							False
				_:
					False
		Err(_):
			False


func test_translates_string_interpolation_parts() -> Bool:
	typed = CompilerTypedStringInterpolationPartsExpr(
		[CompilerTypedInterpolationLiteral("n="), CompilerTypedInterpolationExpr(int_expr("42"))],
		False,
		source_span(),
		string_expr_info(),
	)

	match compiler_ctfe_ir_from_typed_expr_without_context(typed):
		Ok(expr):
			match expr.desc:
				CompilerCtfeIrStringInterpolationExpr(parts, is_multiline):
					match parts.get(0):
						Some(CompilerCtfeIrStringText(text)):
							match parts.get(1):
								Some(CompilerCtfeIrStringExpr(value)):
									(
										text == "n="
										and is_int_literal(value, "42")
										and not is_multiline
										and compiler_types_equal(
											expr.value_type,
											compiler_type_string(),
										)
									)
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False


func test_translates_match_exprs() -> Bool:
	case_zero: CompilerTypedMatchCase = {
		pattern = CompilerTypedIntPattern("0", source_span()),
		body = int_expr("0"),
		span = source_span()
	}
	case_value: CompilerTypedMatchCase = {
		pattern = CompilerTypedNamePattern(ident("value"), compiler_type_int()),
		body = name_expr("value"),
		span = source_span()
	}
	typed = CompilerTypedMatchExpr(
		int_expr("1"),
		[case_zero, case_value],
		source_span(),
		expr_info(),
	)

	match compiler_ctfe_ir_from_typed_expr_without_context(typed):
		Ok(expr):
			match expr.desc:
				CompilerCtfeIrMatchExpr(scrutinee, cases):
					match cases.get(1):
						Some(case):
							(
								is_int_literal(scrutinee, "1")
								and cases.length() == 2
								and matches_value_reference(case.body)
							)
						None:
							False
				_:
					False
		Err(_):
			False


func test_translates_while_and_loop_control() -> Bool:
	typed = CompilerTypedWhileExpr(
		bool_expr(True),
		CompilerTypedBreakExpr(source_span(), void_expr_info()),
		source_span(),
		void_expr_info(),
	)
	while_result = compiler_ctfe_ir_from_typed_expr_without_context(typed)
	break_result = compiler_ctfe_ir_from_typed_expr_without_context(
		CompilerTypedBreakExpr(
			source_span(),
			void_expr_info(),
		),
	)
	continue_result = compiler_ctfe_ir_from_typed_expr_without_context(
		CompilerTypedContinueExpr(
			source_span(),
			void_expr_info(),
		),
	)

	var while_ok: Bool = False

	match while_result:
		Ok(expr):
			match expr.desc:
				CompilerCtfeIrWhileExpr(condition, body):
					var condition_ok: Bool = False
					var body_ok: Bool = False

					match condition.desc:
						CompilerCtfeIrLiteralExpr(CompilerCtfeIrBoolLiteral(value)):
							condition_ok = value
						_:
							void

					match body.desc:
						CompilerCtfeIrBreakExpr:
							body_ok = True
						_:
							void

					while_ok = (
						compiler_types_equal(expr.value_type, compiler_type_void())
						and condition_ok
						and body_ok
					)
				_:
					void
		Err(_):
			void

	var control_ok: Bool = False

	match break_result:
		Ok(break_expr):
			match continue_result:
				Ok(continue_expr):
					var break_ok: Bool = False
					var continue_ok: Bool = False

					match break_expr.desc:
						CompilerCtfeIrBreakExpr:
							break_ok = True
						_:
							void

					match continue_expr.desc:
						CompilerCtfeIrContinueExpr:
							continue_ok = True
						_:
							void

					control_ok = break_ok and continue_ok
				Err(_):
					void
		Err(_):
			void

	while_ok and control_ok


func test_translates_for_loops() -> Bool:
	iterable = CompilerTypedListExpr([int_expr("1")], source_span(), expr_info())
	name_result = compiler_ctfe_ir_from_typed_expr_without_context(
		CompilerTypedForExpr(
			ParsedForNameBinder(ident("item")),
			iterable,
			None,
			CompilerTypedContinueExpr(source_span(), void_expr_info()),
			source_span(),
			void_expr_info(),
		),
	)
	tuple_result = compiler_ctfe_ir_from_typed_expr_without_context(
		CompilerTypedForExpr(
			ParsedForTupleBinder(
				[ident("left"), ident("right")],
				source_span(),
			),
			iterable,
			None,
			CompilerTypedBreakExpr(
				source_span(),
				void_expr_info(),
			),
			source_span(),
			void_expr_info(),
		),
	)

	var name_ok: Bool = False

	match name_result:
		Ok(expr):
			match expr.desc:
				CompilerCtfeIrForExpr(name, _, body):
					var body_ok: Bool = False

					match body.desc:
						CompilerCtfeIrContinueExpr:
							body_ok = True
						_:
							void

					name_ok = name == "item" and body_ok
				_:
					void
		Err(_):
			void

	var tuple_ok: Bool = False

	match tuple_result:
		Ok(expr):
			match expr.desc:
				CompilerCtfeIrForTupleExpr(names, _, body):
					var body_ok: Bool = False

					match body.desc:
						CompilerCtfeIrBreakExpr:
							body_ok = True
						_:
							void

					tuple_ok = (
						names.length() == 2
						and names.get_or(0, "") == "left"
						and names.get_or(1, "") == "right"
						and body_ok
					)
				_:
					void
		Err(_):
			void

	name_ok and tuple_ok


func test_translates_name_references() -> Bool:
	value_result = compiler_ctfe_ir_from_typed_expr(constructor_context(), name_expr("value"))
	constructor_result = compiler_ctfe_ir_from_typed_expr(constructor_context(), name_expr("None"))

	var value_ok: Bool = False

	match value_result:
		Ok(value_expr):
			match value_expr.desc:
				CompilerCtfeIrIdentExpr(value_ident):
					match value_ident.reference_kind:
						CompilerCtfeIrValueReference:
							value_ok = True
						_:
							void
				_:
					void
		Err(_):
			void

	var constructor_ok: Bool = False

	match constructor_result:
		Ok(constructor_expr):
			match constructor_expr.desc:
				CompilerCtfeIrIdentExpr(constructor_ident):
					match constructor_ident.reference_kind:
						CompilerCtfeIrNullaryConstructorReference(constructor):
							constructor_ok = (
								constructor.name == "None"
								and constructor.parent_type == "Option"
							)
						_:
							void
				_:
					void
		Err(_):
			void

	value_ok and constructor_ok


func test_translates_resolved_nullary_constructor_reference_without_context() -> Bool:
	constructor_call = resolved_call_with_origin(
		41,
		"None#41",
		CompilerPure,
		CompilerCallableConstructor("Option"),
	)

	match compiler_ctfe_ir_from_typed_expr_without_context(
		name_expr_with_call(
			"None",
			constructor_call,
		),
	):
		Ok(expr):
			match expr.desc:
				CompilerCtfeIrIdentExpr(identifier):
					match identifier.reference_kind:
						CompilerCtfeIrNullaryConstructorReference(constructor):
							(
								constructor.name == "None"
								and constructor.parent_type == "Option"
								and constructor.callable_id == Some(41)
							)
						_:
							False
				_:
					False
		Err(_):
			False


func test_translates_local_function_references() -> Bool:
	pure_typed = name_expr_with_call(
		"helper",
		resolved_call(7, "helper#7", CompilerPure),
	)
	impure_typed = name_expr_with_call(
		"write_value",
		resolved_call(8, "write_value#8", CompilerImpure),
	)

	pure_ok = match compiler_ctfe_ir_from_typed_expr_without_context(pure_typed):
		Ok(expr):
			match expr.desc:
				CompilerCtfeIrIdentExpr(identifier):
					match identifier.reference_kind:
						CompilerCtfeIrLocalFunctionReference(call):
							call.callable_id == 7 and call.source_name == "helper" and call.is_pure
						_:
							False
				_:
					False
		Err(_):
			False

	impure_ok = match compiler_ctfe_ir_from_typed_expr_without_context(impure_typed):
		Ok(expr):
			match expr.desc:
				CompilerCtfeIrIdentExpr(identifier):
					match identifier.reference_kind:
						CompilerCtfeIrLocalFunctionReference(call):
							(
								call.callable_id == 8
								and call.source_name == "write_value"
								and not call.is_pure
							)
						_:
							False
				_:
					False
		Err(_):
			False

	pure_ok and impure_ok


func test_translates_call_kinds() -> Bool:
	local_call = resolved_call(7, "helper#7", CompilerPure)
	constructor_call = resolved_call_with_origin(
		8,
		"Some#8",
		CompilerPure,
		CompilerCallableConstructor("Option"),
	)
	imported_call = resolved_call_with_origin(
		9,
		"map#9",
		CompilerPure,
		CompilerCallableImported("std/list"),
	)
	local_typed = CompilerTypedCallExpr(
		name_expr_with_call("helper", local_call),
		[int_expr("1")],
		source_span(),
		expr_info_with_call(local_call),
	)
	constructor_typed = CompilerTypedCallExpr(
		name_expr_with_call("Some", constructor_call),
		[int_expr("2")],
		source_span(),
		expr_info_for_with_call(
			CompilerNamedType("Option", [compiler_type_int()]),
			constructor_call,
		),
	)
	imported_typed = CompilerTypedCallExpr(
		name_expr_with_call("map", imported_call),
		[int_expr("3")],
		source_span(),
		expr_info_with_call(imported_call),
	)

	local_result = compiler_ctfe_ir_from_typed_expr_without_context(local_typed)
	constructor_result = compiler_ctfe_ir_from_typed_expr_without_context(constructor_typed)
	imported_result = compiler_ctfe_ir_from_typed_expr_without_context(imported_typed)

	var local_ok: Bool = False

	match local_result:
		Ok(expr):
			match expr.desc:
				CompilerCtfeIrCallExpr(call):
					match call.kind:
						CompilerCtfeIrLocalCall(direct):
							local_ok = (
								direct.callable_id == 7
								and direct.source_name == "helper"
								and call.args.length() == 1
							)
						_:
							void
				_:
					void
		Err(_):
			void

	var constructor_ok: Bool = False

	match constructor_result:
		Ok(expr):
			match expr.desc:
				CompilerCtfeIrCallExpr(call):
					match call.kind:
						CompilerCtfeIrConstructorCall(direct, parent_type):
							constructor_ok = (
								direct.callable_id == 8
								and direct.source_name == "Some"
								and parent_type == "Option"
								and call.args.length() == 1
							)
						_:
							void
				_:
					void
		Err(_):
			void

	var imported_ok: Bool = False

	match imported_result:
		Ok(expr):
			match expr.desc:
				CompilerCtfeIrCallExpr(call):
					match call.kind:
						CompilerCtfeIrImportedCall(direct, module_path):
							imported_ok = (
								direct.callable_id == 9
								and direct.source_name == "map"
								and module_path == "std/list"
								and call.args.length() == 1
							)
						_:
							void
				_:
					void
		Err(_):
			void

	local_ok and constructor_ok and imported_ok


func test_translates_supported_builtin_call() -> Bool:
	builtin_call = resolved_call_with_origin(
		10,
		"to_float32",
		CompilerPure,
		CompilerCallableBuiltin,
	)
	typed = CompilerTypedCallExpr(
		name_expr_with_call("to_float32", builtin_call),
		[int_expr("1")],
		source_span(),
		expr_info_for_with_call(
			CompilerNamedType("Float32", []),
			builtin_call,
		),
	)

	match compiler_ctfe_ir_from_typed_expr_without_context(typed):
		Ok(expr):
			match expr.desc:
				CompilerCtfeIrCallExpr(call):
					match call.kind:
						CompilerCtfeIrBuiltinCall(direct, _):
							(
								direct.callable_id == 10
								and direct.source_name == "to_float32"
								and direct.is_pure
								and call.args.length() == 1
							)
						_:
							False
				_:
					False
		Err(_):
			False


func test_keeps_unadmitted_builtin_call_unsupported() -> Bool:
	builtin_call = resolved_call_with_origin(
		11,
		"hash_combine",
		CompilerPure,
		CompilerCallableBuiltin,
	)
	typed = CompilerTypedCallExpr(
		name_expr_with_call(
			"hash_combine",
			builtin_call,
		),
		[int_expr("1"), int_expr("2")],
		source_span(),
		expr_info_with_call(builtin_call),
	)

	match compiler_ctfe_ir_from_typed_expr_without_context(typed):
		Ok(expr):
			match expr.desc:
				CompilerCtfeIrCallExpr(call):
					match call.kind:
						CompilerCtfeIrUnsupportedCall(form):
							form == "hash_combine"
						_:
							False
				_:
					False
		Err(_):
			False


func test_translates_resolved_trait_method_as_imported_call() -> Bool:
	call: CompilerResolvedCallInfo = {
		callee_name = "length",
		source_name = "length#17",
		purity = CompilerPure,
		target = CompilerResolvedTraitMethodCall("Length", Some({
				callable_id = 17,
				module_path = "std/list",
			})),
		instantiated_params = [compiler_type_int()],
		instantiated_return = compiler_type_int(),
		resource_args = CompilerRejectResourceArgs,
		dim_constraints = [],
		loop_producer = None
	}
	typed = CompilerTypedCallExpr(
		name_expr_with_call("length", call),
		[int_expr("1")],
		source_span(),
		expr_info_with_call(call),
	)

	match compiler_ctfe_ir_from_typed_expr_without_context(typed):
		Ok(expr):
			match expr.desc:
				CompilerCtfeIrCallExpr(ctfe_call):
					match ctfe_call.kind:
						CompilerCtfeIrImportedCall(direct, module_path):
							(
								direct.callable_id == 17
								and direct.source_name == "length"
								and module_path == "std/list"
							)
						_:
							False
				_:
					False
		Err(_):
			False


func test_rejects_unsupported_forms_at_translation_boundary() -> Bool:
	typed = CompilerTypedSubscriptExpr(
		name_expr("items"),
		[int_expr("0")],
		source_span(),
		expr_info(),
	)

	match compiler_ctfe_ir_from_typed_expr_without_context(typed):
		Err(error):
			compiler_ctfe_ir_translate_error_message(
				error,
			) == "compile-time constant evaluation does not support subscript expressions yet"
		Ok(_):
			False


func test_translates_lambda_as_explicit_ctfe_ir() -> Bool:
	typed = CompilerTypedLambdaExpr(
		True,
		[],
		Some(compiler_type_int()),
		int_expr("42"),
		source_span(),
		expr_info_for(CompilerFunctionType(True, [], compiler_type_int())),
	)

	match compiler_ctfe_ir_from_typed_expr_without_context(typed):
		Ok(expr):
			match expr.desc:
				CompilerCtfeIrLambdaExpr(lambda):
					(
						lambda.is_pure
						and lambda.params.length() == 0
						and lambda.return_annotation.is_some()
						and compiler_types_equal(
							compiler_typed_expr_value_type(lambda.body),
							compiler_type_int(),
						)
					)
				_:
					False
		Err(_):
			False


tests: TestSuite = {
	description = "Compiler CTFE IR",
	tests = [
		("translates literals and binary exprs", test_translates_literals_and_binary_exprs),
		(
			"translates transparent and collection exprs",
			test_translates_transparent_and_collection_exprs,
		),
		("translates record and dict exprs", test_translates_record_and_dict_exprs),
		("translates lambdas as explicit CTFE IR", test_translates_lambda_as_explicit_ctfe_ir),
		("translates field access kinds", test_translates_field_access_kinds),
		("translates imported global field access", test_translates_imported_global_field_access),
		("translates block local bindings", test_translates_block_local_bindings),
		("translates block local assignment items", test_translates_block_local_assignment_items),
		(
			"translates block tuple destructuring items",
			test_translates_block_tuple_destructuring_items,
		),
		("translates block question bind items", test_translates_block_question_bind_items),
		("translates string interpolation parts", test_translates_string_interpolation_parts),
		("translates match exprs", test_translates_match_exprs),
		("translates while and loop control", test_translates_while_and_loop_control),
		("translates for loops", test_translates_for_loops),
		("translates name references", test_translates_name_references),
		(
			"translates resolved nullary constructor reference without context",
			test_translates_resolved_nullary_constructor_reference_without_context,
		),
		("translates local function references", test_translates_local_function_references),
		("translates call kinds", test_translates_call_kinds),
		("translates supported builtin call", test_translates_supported_builtin_call),
		(
			"keeps unadmitted builtin call unsupported",
			test_keeps_unadmitted_builtin_call_unsupported,
		),
		(
			"translates resolved trait method as imported call",
			test_translates_resolved_trait_method_as_imported_call,
		),
		(
			"rejects unsupported forms at translation boundary",
			test_rejects_unsupported_forms_at_translation_boundary,
		),
	]
}
