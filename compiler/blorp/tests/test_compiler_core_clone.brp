import:
	../src/stage_09_core/compiler_core_clone:
		clone_core_literal,
		clone_core_source_loc,
		clone_core_type,
		clone_core_var,
	../src/stage_09_core/compiler_core_json:
		CoreLiteral(StringLiteral),
		CoreSourceLoc(KnownSourceLoc),
		CoreType(NamedType, StackResultType, TensorType, TupleType),
		CoreVar,
		core_type_to_json,
	test: TestSuite


pure func test_clones_recursive_core_type() -> Bool:
	original = StackResultType(
		TupleType([NamedType("List", [NamedType("String", [])]), TensorType({
				element_type = NamedType("Float", []),
				dims = [],
			})]),
		NamedType("Error", [NamedType("String", [])]),
	)
	cloned = clone_core_type(original)

	core_type_to_json(original).to_string() == core_type_to_json(cloned).to_string()


pure func test_clones_core_var() -> Bool:
	original: CoreVar = {
		name = "value",
		uniq = 7,
		def_id = Some(11)
	}
	cloned = clone_core_var(original)

	(
		original.name == cloned.name
		and original.uniq == cloned.uniq
		and original.def_id == cloned.def_id
	)


pure func test_clones_managed_literal() -> Bool:
	original = StringLiteral("managed")
	cloned = clone_core_literal(original)

	match cloned:
		StringLiteral(value):
			value == "managed"
		_:
			False


pure func test_clones_known_source_location() -> Bool:
	original = KnownSourceLoc({
		file = "example.brp",
		line = 2,
		column = 3,
		end_line = 4,
		end_column = 5,
	})
	cloned = clone_core_source_loc(original)

	match cloned:
		KnownSourceLoc(span):
			(
				span.file == "example.brp"
				and span.line == 2
				and span.column == 3
				and span.end_line == 4
				and span.end_column == 5
			)
		_:
			False


tests: TestSuite = {
	description = "Blorp compiler Core cloning",
	tests = [
		("clones recursive Core type", test_clones_recursive_core_type),
		("clones Core variable", test_clones_core_var),
		("clones managed literal", test_clones_managed_literal),
		("clones known source location", test_clones_known_source_location),
	]
}
