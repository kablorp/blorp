import:
	../src/stage_01_file_io/source: compiler_source_file
	../src/stage_03_parse/language_parser: parse_compiler_source
	../src/stage_04_modules/loaded_module:
		CompilerModuleIdentity,
		CompilerModuleOrigin(CompilerUserModule),
		compiler_module_identity_for_program,
	../src/stage_06_typecheck/typecheck_bridge:
		TypecheckGraphRequest,
		TypecheckImportModule,
		compiler_typecheck_graph,
	../src/stage_12_lsp/lsp_analysis_cache:
		lsp_analysis_cache,
		lsp_analysis_cache_lexed,
		lsp_analysis_cache_parsed,
		lsp_analysis_cache_remove_lexed,
		lsp_analysis_cache_remove_typed,
		lsp_analysis_cache_remove_typed_for_module,
		lsp_analysis_cache_store_lexed,
		lsp_analysis_cache_store_parsed,
		lsp_analysis_cache_store_typed,
		lsp_analysis_cache_typed,
		lsp_module_analysis_fingerprints_equal,
	../src/stage_12_lsp/lsp_analysis_model:
		LspLexedArtifact,
		LspModuleAnalysisFingerprint,
		LspModuleSemanticIndex,
		LspParseFingerprint,
		LspTypedArtifact,
		lsp_empty_module_semantic_index,
		lsp_lexed_artifact,
		lsp_lexed_artifact_fingerprint,
		lsp_parsed_artifact,
		lsp_parsed_artifact_fingerprint,
		lsp_typed_artifact_fingerprint,
		lsp_typed_artifact_from_compiler,
	../src/stage_12_lsp/lsp_fingerprint_model:
		LspContentFingerprint,
		LspFrontendFingerprint,
		LspSemanticArtifactId,
	../src/stage_12_lsp/lsp_identity: LspDocumentUri, lsp_document_uri
	../src/stage_12_lsp/lsp_snapshot_model: lsp_configuration_epoch
	../src/stage_12_lsp/lsp_workspace_model:
		LspDiscoveredSourceProvenance(LspDiskSource),
		LspSourceSnapshot,
		lsp_source_snapshot_for_layers,
	../src/stage_12_lsp/lsp_workspace_source: lsp_discovered_source_layer, lsp_source_layers
	test: TestSuite


private SOURCE_URI: String = "file:///workspace/main.brp"


private pure func uri() -> LspDocumentUri:
	lsp_document_uri(SOURCE_URI)


private pure func fingerprint(source: String, frontend: String) -> LspParseFingerprint:
	{
		uri = uri(),
		source = {value = source},
		frontend = {value = frontend}
	}


private pure func selected_source(source: String) -> Option[LspSourceSnapshot]:
	compiler_source = compiler_source_file("/workspace/main.brp", "main", source)
	layers = lsp_source_layers(
		uri(),
		Some(lsp_discovered_source_layer(compiler_source, LspDiskSource)),
		None,
	)
	lsp_source_snapshot_for_layers(layers)


private pure func artifact(source: String, frontend: String) -> Option[LspLexedArtifact]:
	selected ?= selected_source(source)
	Some(lsp_lexed_artifact(selected, {value = frontend}))


private pure func artifact_fingerprint(artifact: LspLexedArtifact) -> LspParseFingerprint:
	lsp_lexed_artifact_fingerprint(artifact)


private pure func module_identity(path: String) -> CompilerModuleIdentity:
	program = parse_compiler_source(compiler_source_file(path, "shared", "VALUE = 1\n"))
	compiler_module_identity_for_program(program)


private pure func module_fingerprint(
	identity: CompilerModuleIdentity,
	epoch: Int,
) -> Option[LspModuleAnalysisFingerprint]:
	module_fingerprint_with_source(identity, epoch, "VALUE = 1\n")


private pure func module_fingerprint_with_source(
	identity: CompilerModuleIdentity,
	epoch: Int,
	source_text: String,
) -> Option[LspModuleAnalysisFingerprint]:
	configuration_epoch ?= lsp_configuration_epoch(epoch)

	Some({
		module_identity = identity,
		source = {value = source_text},
		configuration_epoch = configuration_epoch,
		frontend = {value = "frontend-v1"},
	})


private pure func typed_artifact_with_claimed_source(
	epoch: Int,
	claimed_source: String,
) -> Option[LspTypedArtifact]:
	path: String = "/workspace/main.brp"
	module_name: String = "main"
	text: String = "VALUE = 1\n"
	target: TypecheckImportModule = {
		path = path,
		module_name = module_name,
		module_path = module_name,
		text = text,
		typecheck_program = None,
		origin = CompilerUserModule
	}
	request: TypecheckGraphRequest = {
		target = target,
		modules = [],
		module_targets = [],
		resolved_imports = [],
		include_comments = False,
		allow_debug_only_calls = False
	}
	graph = compiler_typecheck_graph(request)
	identity = graph.target.module_identity
	fingerprint ?= module_fingerprint_with_source(identity, epoch, claimed_source)
	artifact_id: LspSemanticArtifactId = {value = "main-artifact"}

	match lsp_empty_module_semantic_index(identity, artifact_id, uri()):
		Err(_):
			None
		Ok(index):
			lsp_typed_artifact_from_compiler(artifact_id, uri(), fingerprint, graph, index)


pure func test_lexed_cache_requires_exact_fingerprint() -> Bool:
	match artifact("VALUE = 1\n", "frontend-v1"):
		None:
			False
		Some(exact):
			cache = lsp_analysis_cache_store_lexed(lsp_analysis_cache(), exact)
			exact_fingerprint = artifact_fingerprint(exact)

			(
				lsp_analysis_cache_lexed(cache, exact_fingerprint).is_some()
				and lsp_analysis_cache_lexed(
					cache,
					fingerprint("VALUE = 2\n", "frontend-v1"),
				).is_none()
				and lsp_analysis_cache_lexed(
					cache,
					fingerprint("VALUE = 1\n", "frontend-v2"),
				).is_none()
			)


private pure func typed_artifact(epoch: Int) -> Option[LspTypedArtifact]:
	typed_artifact_with_claimed_source(epoch, "VALUE = 1\n")


pure func test_lexed_cache_replacement_invalidates_old_fingerprint() -> Bool:
	match artifact("VALUE = 1\n", "frontend-v1"):
		None:
			False
		Some(first):
			match artifact("VALUE = 2\n", "frontend-v1"):
				None:
					False
				Some(second):
					first_fingerprint = artifact_fingerprint(first)
					second_fingerprint = artifact_fingerprint(second)
					initial = lsp_analysis_cache_store_lexed(lsp_analysis_cache(), first)
					replaced = lsp_analysis_cache_store_lexed(initial, second)
					stale_removal = lsp_analysis_cache_remove_lexed(replaced, first_fingerprint)
					exact_removal = lsp_analysis_cache_remove_lexed(
						stale_removal,
						second_fingerprint,
					)

					(
						lsp_analysis_cache_lexed(initial, first_fingerprint).is_some()
						and lsp_analysis_cache_lexed(replaced, first_fingerprint).is_none()
						and lsp_analysis_cache_lexed(replaced, second_fingerprint).is_some()
						and lsp_analysis_cache_lexed(stale_removal, second_fingerprint).is_some()
						and lsp_analysis_cache_lexed(exact_removal, second_fingerprint).is_none()
					)


pure func test_parsed_cache_requires_canonical_source_fingerprint() -> Bool:
	match selected_source("VALUE = 1\n"):
		None:
			False
		Some(source):
			artifact = lsp_parsed_artifact(source, {value = "frontend-v1"})
			exact = lsp_parsed_artifact_fingerprint(artifact)
			cache = lsp_analysis_cache_store_parsed(lsp_analysis_cache(), artifact)

			lsp_analysis_cache_parsed(cache, exact).is_some() and lsp_analysis_cache_parsed(
				cache,
				fingerprint("VALUE = 2\n", "frontend-v1"),
			).is_none()


pure func test_typed_fingerprint_uses_exact_identity_source_and_epoch() -> Bool:
	target = module_identity("/workspace/main.brp")
	other = module_identity("/workspace/other.brp")

	match (
		module_fingerprint(target, 1),
		module_fingerprint(other, 1),
		module_fingerprint_with_source(target, 1, "VALUE = 2\n"),
		module_fingerprint(target, 2),
	):
		(Some(exact), Some(other_identity), Some(other_source), Some(new_epoch)):
			(
				lsp_module_analysis_fingerprints_equal(exact, exact)
				and not lsp_module_analysis_fingerprints_equal(exact, other_identity)
				and not lsp_module_analysis_fingerprints_equal(exact, other_source)
				and not lsp_module_analysis_fingerprints_equal(exact, new_epoch)
			)
		_:
			False


pure func test_typed_cache_rejects_stale_lookup_and_removal() -> Bool:
	match typed_artifact(1):
		None:
			False
		Some(first):
			match typed_artifact(2):
				None:
					False
				Some(second):
					first_fingerprint = lsp_typed_artifact_fingerprint(first)
					second_fingerprint = lsp_typed_artifact_fingerprint(second)
					cache = lsp_analysis_cache_store_typed(lsp_analysis_cache(), second)
					stale_removal = lsp_analysis_cache_remove_typed(cache, first_fingerprint)
					exact_removal = lsp_analysis_cache_remove_typed(
						stale_removal,
						second_fingerprint,
					)

					(
						lsp_analysis_cache_typed(cache, first_fingerprint).is_none()
						and lsp_analysis_cache_typed(cache, second_fingerprint).is_some()
						and lsp_analysis_cache_typed(stale_removal, second_fingerprint).is_some()
						and lsp_analysis_cache_typed(exact_removal, second_fingerprint).is_none()
					)


pure func test_typed_cache_can_evict_stale_artifact_by_module_identity() -> Bool:
	match typed_artifact(1):
		None:
			False
		Some(stale):
			fingerprint = lsp_typed_artifact_fingerprint(stale)
			cache = lsp_analysis_cache_store_typed(lsp_analysis_cache(), stale)
			evicted = lsp_analysis_cache_remove_typed_for_module(cache, fingerprint.module_identity)

			(
				lsp_analysis_cache_typed(cache, fingerprint).is_some()
				and lsp_analysis_cache_typed(evicted, fingerprint).is_none()
			)


pure func test_typed_artifact_rejects_mismatched_source_claim() -> Bool:
	typed_artifact_with_claimed_source(1, "VALUE = 2\n").is_none()


tests: TestSuite = {
	description = "Compiler LSP analysis cache",
	tests = [
		("require exact lexed fingerprint", test_lexed_cache_requires_exact_fingerprint),
		(
			"replace stale lexed artifact while preserving prior snapshot",
			test_lexed_cache_replacement_invalidates_old_fingerprint,
		),
		(
			"parsed cache requires canonical source fingerprint",
			test_parsed_cache_requires_canonical_source_fingerprint,
		),
		(
			"typed fingerprint uses exact identity source and epoch",
			test_typed_fingerprint_uses_exact_identity_source_and_epoch,
		),
		(
			"typed cache rejects stale lookup and removal",
			test_typed_cache_rejects_stale_lookup_and_removal,
		),
		(
			"typed artifact rejects mismatched source claim",
			test_typed_artifact_rejects_mismatched_source_claim,
		),
		(
			"typed cache can evict stale artifact by module identity",
			test_typed_cache_can_evict_stale_artifact_by_module_identity,
		),
	]
}
