import:
	../src/stage_08_core_lower/core_identity: core_ufcs_function_name
	../src/stage_09_core/core_json:
		CoreBinaryOp(AddOp),
		CoreCallKind(BuiltinCall, DeferredTraitCall, SelectedDirectCall, SelectedTraitCall),
		CoreDecl(FunctionDecl, ImplDecl),
		CoreExpr(BinaryExpr, CallExpr, LiteralExpr, VarExpr),
		CoreFunction,
		CoreFunctionKind(UserFunction),
		CoreImplDecl,
		CoreLiteral(IntLiteral),
		CoreParam,
		CoreProgram,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(FunctionType, NamedType, TypeParameterType),
		CoreTypeParam,
		CoreVar,
		core_expr_type,
	../src/stage_09_core/core_mono: core_mono_type_equal
	../src/stage_09_core/core_mono_impl: specialize_generic_impls
	../src/stage_09_core/core_mono_specialize: CoreMonoProgramSpecialization
	../src/stage_09_core/core_monomorphize: specialize_generic_functions_and_data
	test: TestSuite


pure func named_type(name: String) -> CoreType:
	NamedType(name, [])


pure func type_parameter(name: String) -> CoreType:
	TypeParameterType(name)


pure func applied_type(name: String, args: List[CoreType]) -> CoreType:
	NamedType(name, args)


pure func named_var(name: String, def_id: Option[Int]) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = def_id
	}


pure func param(name: String, typ: CoreType) -> CoreParam:
	{
		name = named_var(name, None),
		typ = typ,
		loc = SyntheticSourceLoc
	}


pure func function_type(params: List[CoreType], return_type: CoreType) -> CoreType:
	FunctionType(True, params, return_type)


pure func int_literal(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), named_type("Int"), SyntheticSourceLoc)


pure func variable(name: String, typ: CoreType) -> CoreExpr:
	VarExpr(
		named_var(name, None),
		typ,
		SyntheticSourceLoc,
	)


pure func type_param(name: String, bounds: List[String]) -> CoreTypeParam:
	{
		name = name,
		bounds = bounds
	}


pure func method(
	name: String,
	def_id: Int,
	type_params: List[String],
	params: List[CoreParam],
	return_type: CoreType,
	body: CoreExpr,
) -> CoreFunction:
	{
		name = name,
		source_module = None,
		type_params = type_params,
		params = params,
		return_type = return_type,
		body = Some(body),
		is_pure = True,
		function_kind = UserFunction,
		def_id = def_id,
		loc = SyntheticSourceLoc
	}


pure func generic_impl(
	trait_name: String,
	methods: List[CoreFunction],
	for_type: CoreType,
	type_params: List[CoreTypeParam],
) -> CoreDecl:
	ImplDecl({
		trait_name = trait_name,
		for_type = for_type,
		type_params = type_params,
		methods = methods,
		loc = SyntheticSourceLoc,
	})


pure func deferred_call(
	trait_name: String,
	method_name: String,
	args: List[CoreExpr],
	return_type: CoreType,
) -> CoreExpr:
	arg_types: List[CoreType] = args.map(pure func(arg):
		match arg:
			VarExpr(_, typ, _):
				typ
			_:
				named_type("Int")
	)

	CallExpr(
		DeferredTraitCall(trait_name, method_name),
		VarExpr(
			named_var(method_name, None),
			function_type(arg_types, return_type),
			SyntheticSourceLoc,
		),
		args,
		return_type,
		SyntheticSourceLoc,
	)


pure func builtin_call(name: String, args: List[CoreExpr], return_type: CoreType) -> CoreExpr:
	CallExpr(
		BuiltinCall(name),
		VarExpr(
			named_var(name, None),
			function_type(
				args.map(core_expr_type),
				return_type,
			),
			SyntheticSourceLoc,
		),
		args,
		return_type,
		SyntheticSourceLoc,
	)


pure func main_function(body: CoreExpr, return_type: CoreType) -> CoreDecl:
	FunctionDecl(method("main", 90, [], [], return_type, body))


pure func program(decls: List[CoreDecl]) -> CoreProgram:
	{
		decls = decls,
		foreign_includes = []
	}


pure func find_concrete_impl(
	program: CoreProgram,
	trait_name: String,
	for_type: CoreType,
) -> Option[CoreImplDecl]:
	var found: Option[CoreImplDecl] = None

	for decl in program.decls:
		match decl:
			ImplDecl(impl):
				if (
					impl.trait_name == trait_name
					and impl.type_params.is_empty()
					and core_mono_type_equal(impl.for_type, for_type)
				):
					found = Some(impl)
					break
			_:
				void

	found


pure func count_concrete_impls(program: CoreProgram, trait_name: String, for_type: CoreType) -> Int:
	var count: Int = 0

	for decl in program.decls:
		match decl:
			ImplDecl(impl):
				if (
					impl.trait_name == trait_name
					and impl.type_params.is_empty()
					and core_mono_type_equal(impl.for_type, for_type)
				):
					count += 1
			_:
				void

	count


pure func program_has_function(program: CoreProgram, name: String) -> Bool:
	program.decls.any(pure func(decl):
		match decl:
			FunctionDecl(function):
				function.name == name
			_:
				False
	)


pure func generic_unary_impl(
	trait_name: String,
	method_name: String,
	container_name: String,
	bounds: List[String],
	def_id: Int,
) -> CoreDecl:
	t: CoreType = type_parameter("T")
	container_t: CoreType = applied_type(container_name, [t])

	generic_impl(
		trait_name,
		[
			method(
				method_name,
				def_id,
				["T"],
				[param("value", container_t)],
				named_type("Int"),
				int_literal(1),
			),
		],
		container_t,
		[type_param("T", bounds)],
	)


func test_specializes_explicit_deferred_trait_call() -> Bool:
	list_int: CoreType = applied_type("List", [named_type("Int")])
	source: CoreProgram = program([
		generic_unary_impl("Display", "display", "List", [], 10),
		main_function(
			deferred_call("Display", "display", [variable("items", list_int)], named_type("Int")),
			named_type("Int"),
		),
	])
	result: CoreMonoProgramSpecialization = specialize_generic_impls(source, 100)

	match find_concrete_impl(result.program, "Display", list_int):
		Some(impl):
			match impl.methods:
				[specialized]:
					(
						result.next_def_id == 101
						and specialized.def_id == 100
						and specialized.type_params.is_empty()
						and specialized.params
							.get(0)
							.map(pure func(value): core_mono_type_equal(value.typ, list_int))
							.get_or(False)
					)
				_:
					False
		None:
			False


func test_specializes_typechecker_selected_trait_call() -> Bool:
	list_int: CoreType = applied_type("List", [named_type("Int")])
	source_method: CoreFunction = { method("display", 10, ["T"], [param(
				"items",
				applied_type("List", [type_parameter("T")]),
			)], named_type("Int"), int_literal(1)) | source_module = Some("std/display") }
	call: CoreExpr = CallExpr(
		SelectedTraitCall("Display", "display", "std/display", 10),
		VarExpr(
			named_var(
				core_ufcs_function_name("std/display", "display"),
				Some(10),
			),
			function_type([list_int], named_type("Int")),
			SyntheticSourceLoc,
		),
		[variable("items", list_int)],
		named_type("Int"),
		SyntheticSourceLoc,
	)
	result: CoreMonoProgramSpecialization = specialize_generic_impls(program([
			generic_impl(
				"Display",
				[source_method],
				applied_type("List", [type_parameter("T")]),
				[type_param("T", [])],
			),
			main_function(call, named_type("Int")),
		]), 100)

	result.next_def_id == 101 and find_concrete_impl(result.program, "Display", list_int).is_some()


func test_specializes_target_module_selected_trait_call() -> Bool:
	list_int: CoreType = applied_type("List", [named_type("Int")])
	source_method: CoreFunction = method("display", 10, ["T"], [param(
				"items",
				applied_type("List", [type_parameter("T")]),
			)], named_type("Int"), int_literal(1))
	call: CoreExpr = CallExpr(
		SelectedTraitCall("Display", "display", "app", 10),
		VarExpr(
			named_var("display", Some(10)),
			function_type([list_int], named_type("Int")),
			SyntheticSourceLoc,
		),
		[variable("items", list_int)],
		named_type("Int"),
		SyntheticSourceLoc,
	)
	result: CoreMonoProgramSpecialization = specialize_generic_impls(program([
			generic_impl(
				"Display",
				[source_method],
				applied_type("List", [type_parameter("T")]),
				[type_param("T", [])],
			),
			main_function(call, named_type("Int")),
		]), 100)

	result.next_def_id == 101 and find_concrete_impl(result.program, "Display", list_int).is_some()


func test_trait_identity_disambiguates_same_method_name() -> Bool:
	list_int: CoreType = applied_type("List", [named_type("Int")])
	result: CoreMonoProgramSpecialization = specialize_generic_impls(program([
			generic_unary_impl("Display", "show", "List", [], 10),
			generic_unary_impl("Debug", "show", "List", [], 20),
			main_function(
				deferred_call("Display", "show", [variable("items", list_int)], named_type("Int")),
				named_type("Int"),
			),
		]), 100)

	(
		result.next_def_id == 101
		and find_concrete_impl(result.program, "Display", list_int).is_some()
		and find_concrete_impl(result.program, "Debug", list_int).is_none()
	)


func test_ambiguous_generic_impl_candidates_fail_closed() -> Bool:
	list_int: CoreType = applied_type("List", [named_type("Int")])
	result: CoreMonoProgramSpecialization = specialize_generic_impls(program([
			generic_unary_impl("Display", "display", "List", [], 10),
			generic_unary_impl("Display", "display", "List", [], 20),
			main_function(
				deferred_call(
					"Display",
					"display",
					[variable("items", list_int)],
					named_type("Int"),
				),
				named_type("Int"),
			),
		]), 100)

	result.next_def_id == 100 and find_concrete_impl(result.program, "Display", list_int).is_none()


func test_preserves_method_local_type_params() -> Bool:
	t: CoreType = type_parameter("T")
	u: CoreType = type_parameter("U")
	box_t: CoreType = applied_type("Box", [t])
	box_int: CoreType = applied_type("Box", [named_type("Int")])
	result: CoreMonoProgramSpecialization = specialize_generic_impls(
		program([
			generic_impl(
				"Convert",
				[
					method(
						"convert",
						10,
						["T", "U"],
						[param("self", box_t), param("fallback", u)],
						u,
						variable(
							"fallback",
							u,
						),
					),
				],
				box_t,
				[type_param("T", [])],
			),
			main_function(
				deferred_call(
					"Convert",
					"convert",
					[variable("value", box_int), variable("fallback", named_type("String"))],
					named_type("String"),
				),
				named_type("String"),
			),
		]),
		100,
	)

	match find_concrete_impl(result.program, "Convert", box_int):
		Some(impl):
			match impl.methods.get(0):
				Some(specialized):
					(
						specialized.type_params == ["U"]
						and specialized.params
							.get(1)
							.map(pure func(value): core_mono_type_equal(value.typ, u))
							.get_or(False)
						and core_mono_type_equal(specialized.return_type, u)
					)
				None:
					False
		None:
			False


func test_specializes_operator_impl() -> Bool:
	t: CoreType = type_parameter("T")
	box_t: CoreType = applied_type("Box", [t])
	box_int: CoreType = applied_type("Box", [named_type("Int")])
	add_impl: CoreDecl = generic_impl(
		"Addable",
		[
			method(
				"add",
				10,
				["T"],
				[param("left", box_t), param("right", box_t)],
				box_t,
				variable(
					"left",
					box_t,
				),
			),
		],
		box_t,
		[type_param("T", [])],
	)
	body: CoreExpr = BinaryExpr(
		AddOp,
		variable("left", box_int),
		variable("right", box_int),
		box_int,
		SyntheticSourceLoc,
	)
	result: CoreMonoProgramSpecialization = specialize_generic_impls(
		program([add_impl, main_function(body, box_int)]),
		100,
	)

	result.next_def_id == 101 and find_concrete_impl(result.program, "Addable", box_int).is_some()


