func test_deduplicates_repeated_demands() -> Bool:
	list_int: CoreType = applied_type("List", [named_type("Int")])
	call: CoreExpr = deferred_call(
		"Display",
		"display",
		[variable("items", list_int)],
		named_type("Int"),
	)
	result: CoreMonoProgramSpecialization = specialize_generic_impls(program([
			generic_unary_impl("Display", "display", "List", [], 10),
			main_function(call, named_type("Int")),
			FunctionDecl(method("other", 91, [], [], named_type("Int"), call)),
		]), 100)

	result.next_def_id == 101 and count_concrete_impls(result.program, "Display", list_int) == 1


func test_existing_concrete_impl_suppresses_specialization() -> Bool:
	t: CoreType = type_parameter("T")
	list_t: CoreType = applied_type("List", [t])
	list_int: CoreType = applied_type("List", [named_type("Int")])
	concrete_impl: CoreDecl = generic_impl(
		"Display",
		[method("display", 20, [], [param("items", list_int)], named_type("Int"), int_literal(2))],
		list_int,
		[],
	)
	result: CoreMonoProgramSpecialization = specialize_generic_impls(program([
			generic_impl(
				"Display",
				[
					method(
						"display",
						10,
						["T"],
						[param("items", list_t)],
						named_type("Int"),
						int_literal(1),
					),
				],
				list_t,
				[type_param("T", [])],
			),
			concrete_impl,
			main_function(
				deferred_call(
					"Display",
					"display",
					[variable("items", list_int)],
					named_type("Int"),
				),
				named_type("Int"),
			),
		]), 100)

	result.next_def_id == 100 and count_concrete_impls(result.program, "Display", list_int) == 1


func test_static_trait_method_uses_result_type() -> Bool:
	t: CoreType = type_parameter("T")
	box_t: CoreType = applied_type("Box", [t])
	box_int: CoreType = applied_type("Box", [named_type("Int")])
	zero_impl: CoreDecl = generic_impl("HasZero", [method(
				"zero",
				10,
				["T"],
				[],
				box_t,
				variable("zero_box", box_t),
			)], box_t, [type_param("T", [])])
	result: CoreMonoProgramSpecialization = specialize_generic_impls(program([
			zero_impl,
			main_function(
				deferred_call("HasZero", "zero", [], box_int),
				box_int,
			),
		]), 100)

	result.next_def_id == 101 and find_concrete_impl(result.program, "HasZero", box_int).is_some()


func test_materializes_bound_impl_transitively() -> Bool:
	wrapper_int: CoreType = applied_type("Wrapper", [named_type("Int")])
	box_wrapper_int: CoreType = applied_type("Box", [wrapper_int])
	result: CoreMonoProgramSpecialization = specialize_generic_impls(program([
			generic_unary_impl("Display", "display", "Box", ["Stringable"], 10),
			generic_unary_impl("Stringable", "to_string", "Wrapper", [], 20),
			main_function(
				deferred_call(
					"Display",
					"display",
					[variable("value", box_wrapper_int)],
					named_type("Int"),
				),
				named_type("Int"),
			),
		]), 100)

	(
		result.next_def_id == 102
		and find_concrete_impl(result.program, "Display", box_wrapper_int).is_some()
		and find_concrete_impl(result.program, "Stringable", wrapper_int).is_some()
	)


func test_discovers_demand_in_specialized_impl_body() -> Bool:
	t: CoreType = type_parameter("T")
	box_t: CoreType = applied_type("Box", [t])
	wrapper_int: CoreType = applied_type("Wrapper", [named_type("Int")])
	box_wrapper_int: CoreType = applied_type("Box", [wrapper_int])
	display_impl: CoreDecl = generic_impl(
		"Display",
		[
			method(
				"display",
				10,
				["T"],
				[param("value", box_t), param("inner", t)],
				named_type("String"),
				deferred_call(
					"Stringable",
					"to_string",
					[variable("inner", t)],
					named_type("String"),
				),
			),
		],
		box_t,
		[type_param("T", [])],
	)
	result: CoreMonoProgramSpecialization = specialize_generic_impls(
		program([
			display_impl,
			generic_unary_impl("Stringable", "to_string", "Wrapper", [], 20),
			main_function(
				deferred_call(
					"Display",
					"display",
					[variable("value", box_wrapper_int), variable("inner", wrapper_int)],
					named_type("String"),
				),
				named_type("String"),
			),
		]),
		100,
	)

	(
		result.next_def_id == 102
		and find_concrete_impl(result.program, "Display", box_wrapper_int).is_some()
		and find_concrete_impl(result.program, "Stringable", wrapper_int).is_some()
	)


func test_unresolved_caller_does_not_materialize_impl() -> Bool:
	list_t: CoreType = applied_type("List", [type_parameter("U")])
	generic_user: CoreDecl = FunctionDecl(
		method(
			"use_display",
			90,
			["U"],
			[param("items", list_t)],
			named_type("Int"),
			deferred_call("Display", "display", [variable("items", list_t)], named_type("Int")),
		),
	)
	result: CoreMonoProgramSpecialization = specialize_generic_impls(program([
			generic_unary_impl("Display", "display", "List", [], 10),
			generic_user,
		]), 100)

	result.next_def_id == 100 and result.program.decls.length() == 2


func test_rewrites_specialized_method_references_to_fresh_ids() -> Bool:
	t: CoreType = type_parameter("T")
	box_t: CoreType = applied_type("Box", [t])
	box_int: CoreType = applied_type("Box", [named_type("Int")])
	helper_call: CoreExpr = CallExpr(
		SelectedDirectCall(11),
		VarExpr(
			named_var("helper", Some(11)),
			function_type([box_t], named_type("Int")),
			SyntheticSourceLoc,
		),
		[variable("value", box_t)],
		named_type("Int"),
		SyntheticSourceLoc,
	)
	source_impl: CoreDecl = generic_impl(
		"Display",
		[
			method("display", 10, ["T"], [param("value", box_t)], named_type("Int"), helper_call),
			method(
				"helper",
				11,
				["T"],
				[param("value", box_t)],
				named_type("Int"),
				int_literal(1),
			),
		],
		box_t,
		[type_param("T", [])],
	)
	result: CoreMonoProgramSpecialization = specialize_generic_impls(program([
			source_impl,
			main_function(
				deferred_call(
					"Display",
					"display",
					[variable("value", box_int)],
					named_type("Int"),
				),
				named_type("Int"),
			),
		]), 100)

	match find_concrete_impl(result.program, "Display", box_int):
		Some(impl):
			match impl.methods:
				[display, helper]:
					match display.body:
						Some(CallExpr(SelectedDirectCall(def_id), VarExpr(callee, _, _), _, _, _)):
							(
								result.next_def_id == 102
								and display.def_id == 100
								and helper.def_id == 101
								and def_id == 101
								and callee.def_id == Some(101)
							)
						_:
							False
				_:
					False
		None:
			False


func test_does_not_rewrite_colliding_unrelated_callable_id() -> Bool:
	t: CoreType = type_parameter("T")
	box_t: CoreType = applied_type("Box", [t])
	box_int: CoreType = applied_type("Box", [named_type("Int")])
	imported_call: CoreExpr = CallExpr(
		SelectedDirectCall(11),
		VarExpr(
			named_var("imported_helper", Some(11)),
			function_type([box_t], named_type("Int")),
			SyntheticSourceLoc,
		),
		[variable("value", box_t)],
		named_type("Int"),
		SyntheticSourceLoc,
	)
	result: CoreMonoProgramSpecialization = specialize_generic_impls(
		program([
			generic_impl(
				"Display",
				[
					method(
						"display",
						10,
						["T"],
						[param("value", box_t)],
						named_type("Int"),
						imported_call,
					),
					method(
						"helper",
						11,
						["T"],
						[param("value", box_t)],
						named_type("Int"),
						int_literal(1),
					),
				],
				box_t,
				[type_param("T", [])],
			),
			main_function(
				deferred_call(
					"Display",
					"display",
					[variable("value", box_int)],
					named_type("Int"),
				),
				named_type("Int"),
			),
		]),
		100,
	)

	match find_concrete_impl(result.program, "Display", box_int):
		Some(impl):
			match impl.methods:
				[display, _]:
					match display.body:
						Some(CallExpr(SelectedDirectCall(def_id), VarExpr(callee, _, _), _, _, _)):
							def_id == 11 and callee.def_id == Some(11)
						_:
							False
				_:
					False
		None:
			False


func test_callable_fixpoint_exposes_impl_demand_from_specialized_function() -> Bool:
	t: CoreType = type_parameter("T")
	list_t: CoreType = applied_type("List", [t])
	list_int: CoreType = applied_type("List", [named_type("Int")])
	render: CoreDecl = FunctionDecl(
		method(
			"render",
			30,
			["T"],
			[param("items", list_t)],
			named_type("Int"),
			deferred_call("Display", "display", [variable("items", list_t)], named_type("Int")),
		),
	)
	main_call: CoreExpr = CallExpr(
		SelectedDirectCall(30),
		VarExpr(
			named_var("render", Some(30)),
			function_type([list_int], named_type("Int")),
			SyntheticSourceLoc,
		),
		[variable("items", list_int)],
		named_type("Int"),
		SyntheticSourceLoc,
	)
	result = specialize_generic_functions_and_data(program([
			render,
			generic_unary_impl("Display", "display", "List", [], 10),
			main_function(main_call, named_type("Int")),
		]), 100)

	(
		result.next_def_id == 102
		and program_has_function(result.program, "render__mono_Int")
		and find_concrete_impl(result.program, "Display", list_int).is_some()
	)


func test_callable_fixpoint_exposes_function_demand_from_specialized_impl() -> Bool:
	t: CoreType = type_parameter("T")
	box_t: CoreType = applied_type("Box", [t])
	box_int: CoreType = applied_type("Box", [named_type("Int")])
	identity: CoreDecl = FunctionDecl(
		method(
			"identity",
			30,
			["T"],
			[param("value", t)],
			t,
			variable("value", t),
		),
	)
	identity_call: CoreExpr = CallExpr(
		SelectedDirectCall(30),
		VarExpr(
			named_var("identity", Some(30)),
			function_type([t], t),
			SyntheticSourceLoc,
		),
		[variable("inner", t)],
		t,
		SyntheticSourceLoc,
	)
	display_impl: CoreDecl = generic_impl(
		"Display",
		[
			method(
				"display",
				10,
				["T"],
				[param("value", box_t), param("inner", t)],
				t,
				identity_call,
			),
		],
		box_t,
		[type_param("T", [])],
	)
	result = specialize_generic_functions_and_data(
		program([
			identity,
			display_impl,
			main_function(
				deferred_call(
					"Display",
					"display",
					[variable("value", box_int), variable("inner", named_type("Int"))],
					named_type("Int"),
				),
				named_type("Int"),
			),
		]),
		100,
	)

	(
		result.next_def_id == 102
		and find_concrete_impl(result.program, "Display", box_int).is_some()
		and program_has_function(result.program, "identity__mono_Int")
	)


tests: TestSuite = {
	description = "Blorp compiler generic impl monomorphization",
	tests = [
		("specializes explicit deferred trait call", test_specializes_explicit_deferred_trait_call),
		(
			"specializes typechecker-selected trait call",
			test_specializes_typechecker_selected_trait_call,
		),
		(
			"specializes target-module selected trait call",
			test_specializes_target_module_selected_trait_call,
		),
		(
			"trait identity disambiguates same method name",
			test_trait_identity_disambiguates_same_method_name,
		),
		(
			"ambiguous generic impl candidates fail closed",
			test_ambiguous_generic_impl_candidates_fail_closed,
		),
		("preserves method-local type parameters", test_preserves_method_local_type_params),
		("specializes operator impl", test_specializes_operator_impl),
		(
			"specializes Stringable impl for builtin to-string",
			test_specializes_stringable_impl_for_builtin_to_string,
		),
		(
			"builtin List to-string materializes element impl",
			test_builtin_list_to_string_materializes_element_impl,
		),
		("deduplicates repeated demands", test_deduplicates_repeated_demands),
		(
			"existing concrete impl suppresses specialization",
			test_existing_concrete_impl_suppresses_specialization,
		),
		("static trait method uses result type", test_static_trait_method_uses_result_type),
		("materializes bound impl transitively", test_materializes_bound_impl_transitively),
		(
			"discovers demand in specialized impl body",
			test_discovers_demand_in_specialized_impl_body,
		),
		(
			"unresolved caller does not materialize impl",
			test_unresolved_caller_does_not_materialize_impl,
		),
		(
			"rewrites specialized method references to fresh ids",
			test_rewrites_specialized_method_references_to_fresh_ids,
		),
		(
			"does not rewrite colliding unrelated callable id",
			test_does_not_rewrite_colliding_unrelated_callable_id,
		),
		(
			"callable fixpoint exposes impl demand from specialized function",
			test_callable_fixpoint_exposes_impl_demand_from_specialized_function,
		),
		(
			"callable fixpoint exposes function demand from specialized impl",
			test_callable_fixpoint_exposes_function_demand_from_specialized_impl,
		),
	]
}
