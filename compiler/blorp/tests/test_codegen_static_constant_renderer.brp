		3,
	)
	stack_result_initializer_ok: Bool = parsed_template_has(
		"static_stack_result_initializer",
		"static_stack_result_initializer",
		4,
	)
	stack_value_ok: Bool = parsed_template_has(
		"static_stack_value_global",
		"static_stack_value_global",
		3,
	)
	scalar_global_ok: Bool = parsed_template_has("static_scalar_global", "static_scalar_global", 3)
	uninitialized_global_ok: Bool = parsed_template_has(
