func test_render_static_constant_successes() -> Bool:
	object_ok: Bool = rendered_static_constant_is(
		"static_string_object",
		["__blorp_static_string_GREETING", "6", "5", "hello"],
		(
			"static struct { blorp_Object header; long len; long capacity; char data[6]; } "
			+ "__blorp_static_string_GREETING = { { BLORP_IMMORTAL_REFCOUNT, "
		) + "BLORP_ALLOC_CLASS_DIRECT, 0 }, 5L, 5L, \"hello\" };",
	)
	tuple_object_ok: Bool = rendered_static_constant_is(
		"static_tuple_object",
		[
			"__blorp_static_tuple_PAIR",
			"3",
			"2",
			"1",
			"(void*)(long)(7L), (void*)(blorp_String*)&__blorp_static_string_PAIR_1",
		],
		(
			"static struct { blorp_Object header; long arity; long release_mask; void* "
			+ "elem[3]; } __blorp_static_tuple_PAIR = { .header = { BLORP_IMMORTAL_REFCOUNT, "
			+ "BLORP_ALLOC_CLASS_DIRECT, 0 }, .arity = 2L, .release_mask = 1UL, .elem = { "
			+ "(void*)(long)(7L), (void*)(blorp_String*)&__blorp_static_string_PAIR_1 } };"
		),
	)
	pointer_list_object_ok: Bool = rendered_static_constant_is(
		"static_pointer_list_object",
		["__blorp_static_list_NAMES", "5", "2", "2", "blorp_elem_release_fn", (
				"(void*)(blorp_String*)&__blorp_static_string_NAMES_elem_0, "
				+ "(void*)(blorp_String*)&__blorp_static_string_NAMES_elem_1"
			)],
		(
			"static struct { blorp_Object header; long len; long capacity; void "
			+ "(*elem_release)(void*); int16_t elem_size; uint8_t storage_mode; char __pad[5]; "
			+ "void* data[2]; } __blorp_static_list_NAMES = { { BLORP_IMMORTAL_REFCOUNT, "
			+ "BLORP_ALLOC_CLASS_DIRECT, 0 }, 2L, 2L, blorp_elem_release_fn, "
			+ "(int16_t)sizeof(void*), BLORP_LIST_STORAGE_POINTER, { 0 }, { "
			+ "(void*)(blorp_String*)&__blorp_static_string_NAMES_elem_0, "
			+ "(void*)(blorp_String*)&__blorp_static_string_NAMES_elem_1 } };"
		),
	)
	inline_list_object_ok: Bool = rendered_static_constant_is(
		"static_inline_list_object",
		[
			"__blorp_static_list_NUMBERS",
			"5",
			"uintptr_t",
			"3",
			"3",
			"8",
			"((uintptr_t)(1L)), ((uintptr_t)(2L)), ((uintptr_t)(3L))",
		],
		(
			"static struct { blorp_Object header; long len; long capacity; void "
			+ "(*elem_release)(void*); int16_t elem_size; uint8_t storage_mode; char __pad[5]; "
			+ "uintptr_t data[3]; } __blorp_static_list_NUMBERS = { { BLORP_IMMORTAL_REFCOUNT, "
			+ "BLORP_ALLOC_CLASS_DIRECT, 0 }, 3L, 3L, NULL, (int16_t)8, "
			+ "BLORP_LIST_STORAGE_INLINE, { 0 }, { ((uintptr_t)(1L)), ((uintptr_t)(2L)), "
			+ "((uintptr_t)(3L)) } };"
		),
	)
	record_object_ok: Bool = rendered_static_constant_is(
		"static_record_object",
		["Counter", "__blorp_static_record_COUNTER", ", 7L"],
		(
			"static Counter __blorp_static_record_COUNTER = { { BLORP_IMMORTAL_REFCOUNT, "
			+ "BLORP_ALLOC_CLASS_DIRECT, 0 }, 7L };"
		),
	)
	union_object_ok: Bool = rendered_static_constant_is(
		"static_union_object",
		[
			"Choice__mono_String",
			"__blorp_static_union_CHOSEN",
			"TAG_Choice__mono_String_Picked",
			"Picked",
			"(blorp_String*)&__blorp_static_string_CHOSEN_Picked_0",
		],
		(
			"static Choice__mono_String __blorp_static_union_CHOSEN = { .header = { "
			+ "BLORP_IMMORTAL_REFCOUNT, BLORP_ALLOC_CLASS_DIRECT, 0 }, .tag = "
			+ "TAG_Choice__mono_String_Picked, .data.Picked = { "
			+ "(blorp_String*)&__blorp_static_string_CHOSEN_Picked_0 } };"
		),
	)
	string_ok: Bool = rendered_static_constant_is(
		"static_string_global_pointer",
		["GREETING", "__blorp_static_string_GREETING"],
		"static blorp_String* GREETING = (blorp_String*)&__blorp_static_string_GREETING;",
	)
	list_ok: Bool = rendered_static_constant_is(
		"static_list_global_pointer",
		["VALUES", "__blorp_static_list_VALUES"],
		"static blorp_List* VALUES = (blorp_List*)&__blorp_static_list_VALUES;",
	)
	tuple_ok: Bool = rendered_static_constant_is(
		"static_tuple_global_pointer",
		["PAIR", "__blorp_static_tuple_PAIR"],
		"static blorp_Tuple* PAIR = (blorp_Tuple*)&__blorp_static_tuple_PAIR;",
	)
	typed_pointer_ok: Bool = rendered_static_constant_is(
		"static_typed_pointer_global",
		["Box__mono_String*", "BOXED", "__blorp_static_record_BOXED"],
		(
			"static Box__mono_String* BOXED = (Box__mono_String*)&__blorp_static_record_BOXED"
			+ ";"
		),
	)
	stack_result_initializer_ok: Bool = rendered_static_constant_is(
		"static_stack_result_initializer",
		["1", "1", "Err", "(void*)(blorp_String*)&__blorp_static_string_ERR_0"],
		(
			"{ .tag = 1, .release_mask = 1UL, .data.Err.field0 = "
			+ "(void*)(blorp_String*)&__blorp_static_string_ERR_0 }"
		),
	)
	stack_value_ok: Bool = rendered_static_constant_is(
		"static_stack_value_global",
		["blorp_StackResult_Int_String", "RESULT", "{ .tag = BLORP_TAG_OK }"],
		"static blorp_StackResult_Int_String RESULT = { .tag = BLORP_TAG_OK };",
	)
	scalar_global_ok: Bool = rendered_static_constant_is(
		"static_scalar_global",
		["long", "MAX", "100L"],
		"static long MAX = 100L;",
	)
	uninitialized_global_ok: Bool = rendered_static_constant_is(
		"static_uninitialized_global",
		["long", "computed"],
		"static long computed;",
	)
	string_storage_ok: Bool = rendered_static_constant_is(
		"static_string_storage_name",
		["GREETING"],
		"__blorp_static_string_GREETING",
	)
	list_storage_ok: Bool = rendered_static_constant_is(
		"static_list_storage_name",
		["VALUES"],
		"__blorp_static_list_VALUES",
	)
	tuple_storage_ok: Bool = rendered_static_constant_is(
		"static_tuple_storage_name",
		["PAIR"],
		"__blorp_static_tuple_PAIR",
	)
	record_storage_ok: Bool = rendered_static_constant_is(
		"static_record_storage_name",
		["COUNTER"],
		"__blorp_static_record_COUNTER",
	)
	union_storage_ok: Bool = rendered_static_constant_is(
		"static_union_storage_name",
		["CHOSEN"],
		"__blorp_static_union_CHOSEN",
	)
	child_path_ok: Bool = rendered_static_constant_is(
		"static_child_path",
		["ROOT", "field"],
		"ROOT_field",
	)
	list_child_path_ok: Bool = rendered_static_constant_is(
		"static_list_child_path",
		["ROOT", "2"],
		"ROOT_elem_2",
	)
	tuple_child_path_ok: Bool = rendered_static_constant_is(
		"static_tuple_child_path",
		["ROOT", "3"],
		"ROOT_3",
	)
	union_child_path_ok: Bool = rendered_static_constant_is(
		"static_union_child_path",
		["ROOT", "Picked", "0"],
		"ROOT_Picked_0",
	)
	string_initializer_ok: Bool = rendered_static_constant_is(
		"static_string_pointer_initializer",
		["__blorp_static_string_GREETING"],
		"(blorp_String*)&__blorp_static_string_GREETING",
	)
	list_initializer_ok: Bool = rendered_static_constant_is(
		"static_list_pointer_initializer",
		["__blorp_static_list_VALUES"],
		"(blorp_List*)&__blorp_static_list_VALUES",
	)
	tuple_initializer_ok: Bool = rendered_static_constant_is(
		"static_tuple_pointer_initializer",
		["__blorp_static_tuple_PAIR"],
		"(blorp_Tuple*)&__blorp_static_tuple_PAIR",
	)
	typed_initializer_ok: Bool = rendered_static_constant_is(
		"static_typed_pointer_initializer",
		["Counter*", "__blorp_static_record_COUNTER"],
		"(Counter*)&__blorp_static_record_COUNTER",
	)
	pointer_slot_initializer_ok: Bool = rendered_static_constant_is(
		"static_pointer_slot_initializer",
		["(blorp_String*)&__blorp_static_string_GREETING"],
		"(void*)(blorp_String*)&__blorp_static_string_GREETING",
	)
	primitive_slot_initializer_ok: Bool = rendered_static_constant_is(
		"static_primitive_slot_initializer",
		["7L"],
		"(void*)(long)(7L)",
	)
	void_slot_initializer_ok: Bool = rendered_static_constant_is(
		"static_void_slot_initializer",
		[],
		"(void*)0",
	)
	inline_cast_initializer_ok: Bool = rendered_static_constant_is(
		"static_inline_element_cast_initializer",
		["uintptr_t", "7L"],
		"((uintptr_t)(7L))",
	)

	(
		object_ok
		and tuple_object_ok
		and pointer_list_object_ok
		and inline_list_object_ok
		and record_object_ok
		and union_object_ok
		and string_ok
		and list_ok
		and tuple_ok
		and typed_pointer_ok
		and stack_result_initializer_ok
		and stack_value_ok
		and scalar_global_ok
		and uninitialized_global_ok
		and string_storage_ok
		and list_storage_ok
		and tuple_storage_ok
		and record_storage_ok
		and union_storage_ok
		and child_path_ok
		and list_child_path_ok
		and tuple_child_path_ok
		and union_child_path_ok
		and string_initializer_ok
		and list_initializer_ok
		and tuple_initializer_ok
		and typed_initializer_ok
		and pointer_slot_initializer_ok
		and primitive_slot_initializer_ok
		and void_slot_initializer_ok
		and inline_cast_initializer_ok
	)


func test_render_static_constant_errors_are_typed() -> Bool:
	wrong_arity_ok: Bool = match render_static_constant(
		"static_string_global_pointer",
		["GREETING"],
	):
		Err(WrongArity(info, actual)):
			(
				static_constant_template_name(info) == "static_string_global_pointer"
				and static_constant_template_arity(info) == 2
				and actual == 1
			)
		Ok(value):
			False
		Err(UnsupportedStaticConstantOp(name)):
			False

	unsupported_ok: Bool = match render_static_constant("static_missing", []):
		Err(UnsupportedStaticConstantOp(name)):
			name == "static_missing"
		Ok(value):
			False
		Err(WrongArity(info, actual)):
			False

	wrong_arity_ok and unsupported_ok


func test_manifest_lines() -> Bool:
	object_ok: Bool = manifest_line_is(
		"static_string_object",
		"static_string_object\t4\tstatic struct { blorp_Object header; long len; " + "long capacity; char data[@1@]; } @0@ = { { BLORP_IMMORTAL_REFCOUNT, " + "BLORP_ALLOC_CLASS_DIRECT, 0 }, @2@L, @2@L, \"@3@\" };",
	)
	tuple_object_ok: Bool = manifest_line_is(
		"static_tuple_object",
		"static_tuple_object\t5\tstatic struct { blorp_Object header; long arity; " + "long release_mask; void* elem[@1@]; } @0@ = { .header = { " + "BLORP_IMMORTAL_REFCOUNT, BLORP_ALLOC_CLASS_DIRECT, 0 }, .arity = @2@L, " + ".release_mask = @3@UL, .elem = { @4@ } };",
	)
	pointer_list_object_ok: Bool = manifest_line_is(
		"static_pointer_list_object",
		"static_pointer_list_object\t6\tstatic struct { blorp_Object header; long len; " + "long capacity; void (*elem_release)(void*); int16_t elem_size; uint8_t " + "storage_mode; char __pad[@1@]; void* data[@2@]; } @0@ = { { " + "BLORP_IMMORTAL_REFCOUNT, BLORP_ALLOC_CLASS_DIRECT, 0 }, @3@L, @2@L, " + "@4@, (int16_t)sizeof(void*), BLORP_LIST_STORAGE_POINTER, { 0 }, { @5@ } };",
	)
	inline_list_object_ok: Bool = manifest_line_is(
		"static_inline_list_object",
		"static_inline_list_object\t7\tstatic struct { blorp_Object header; long len; " + "long capacity; void (*elem_release)(void*); int16_t elem_size; uint8_t " + "storage_mode; char __pad[@1@]; @2@ data[@3@]; } @0@ = { { " + "BLORP_IMMORTAL_REFCOUNT, BLORP_ALLOC_CLASS_DIRECT, 0 }, @4@L, @3@L, NULL, " + "(int16_t)@5@, BLORP_LIST_STORAGE_INLINE, { 0 }, { @6@ } };",
	)
	record_object_ok: Bool = manifest_line_is(
		"static_record_object",
		"static_record_object\t3\tstatic @0@ @1@ = { { BLORP_IMMORTAL_REFCOUNT, " + "BLORP_ALLOC_CLASS_DIRECT, 0 }@2@ };",
	)
	union_object_ok: Bool = manifest_line_is(
		"static_union_object",
		"static_union_object\t5\tstatic @0@ @1@ = { .header = { " + "BLORP_IMMORTAL_REFCOUNT, BLORP_ALLOC_CLASS_DIRECT, 0 }, .tag = @2@, " + ".data.@3@ = { @4@ } };",
	)
	string_ok: Bool = manifest_line_is(
		"static_string_global_pointer",
		"static_string_global_pointer\t2\tstatic blorp_String* @0@ = (blorp_String*)&@1@;",
	)
	list_ok: Bool = manifest_line_is(
		"static_list_global_pointer",
		"static_list_global_pointer\t2\tstatic blorp_List* @0@ = (blorp_List*)&@1@;",
	)
	tuple_ok: Bool = manifest_line_is(
		"static_tuple_global_pointer",
		"static_tuple_global_pointer\t2\tstatic blorp_Tuple* @0@ = (blorp_Tuple*)&@1@;",
	)
	typed_pointer_ok: Bool = manifest_line_is(
		"static_typed_pointer_global",
		"static_typed_pointer_global\t3\tstatic @0@ @1@ = (@0@)&@2@;",
	)
	stack_result_initializer_ok: Bool = manifest_line_is(
		"static_stack_result_initializer",
		"static_stack_result_initializer\t4\t{ .tag = @0@, .release_mask = @1@UL, .data.@2@.field0 = @3@ }",
	)
	stack_value_ok: Bool = manifest_line_is(
		"static_stack_value_global",
		"static_stack_value_global\t3\tstatic @0@ @1@ = @2@;",
	)
	scalar_global_ok: Bool = manifest_line_is(
		"static_scalar_global",
		"static_scalar_global\t3\tstatic @0@ @1@ = @2@;",
	)
	uninitialized_global_ok: Bool = manifest_line_is(
		"static_uninitialized_global",
		"static_uninitialized_global\t2\tstatic @0@ @1@;",
	)
	string_storage_ok: Bool = manifest_line_is(
		"static_string_storage_name",
		"static_string_storage_name\t1\t__blorp_static_string_@0@",
	)
	list_storage_ok: Bool = manifest_line_is(
		"static_list_storage_name",
		"static_list_storage_name\t1\t__blorp_static_list_@0@",
	)
	tuple_storage_ok: Bool = manifest_line_is(
		"static_tuple_storage_name",
		"static_tuple_storage_name\t1\t__blorp_static_tuple_@0@",
	)
	record_storage_ok: Bool = manifest_line_is(
		"static_record_storage_name",
		"static_record_storage_name\t1\t__blorp_static_record_@0@",
	)
	union_storage_ok: Bool = manifest_line_is(
		"static_union_storage_name",
		"static_union_storage_name\t1\t__blorp_static_union_@0@",
	)
	child_path_ok: Bool = manifest_line_is("static_child_path", "static_child_path\t2\t@0@_@1@")
	list_child_path_ok: Bool = manifest_line_is(
		"static_list_child_path",
		"static_list_child_path\t2\t@0@_elem_@1@",
	)
	tuple_child_path_ok: Bool = manifest_line_is(
		"static_tuple_child_path",
		"static_tuple_child_path\t2\t@0@_@1@",
	)
	union_child_path_ok: Bool = manifest_line_is(
		"static_union_child_path",
		"static_union_child_path\t3\t@0@_@1@_@2@",
	)
	string_initializer_ok: Bool = manifest_line_is(
		"static_string_pointer_initializer",
		"static_string_pointer_initializer\t1\t(blorp_String*)&@0@",
	)
	list_initializer_ok: Bool = manifest_line_is(
		"static_list_pointer_initializer",
		"static_list_pointer_initializer\t1\t(blorp_List*)&@0@",
	)
	tuple_initializer_ok: Bool = manifest_line_is(
		"static_tuple_pointer_initializer",
		"static_tuple_pointer_initializer\t1\t(blorp_Tuple*)&@0@",
	)
	typed_initializer_ok: Bool = manifest_line_is(
		"static_typed_pointer_initializer",
		"static_typed_pointer_initializer\t2\t(@0@)&@1@",
	)
	pointer_slot_initializer_ok: Bool = manifest_line_is(
		"static_pointer_slot_initializer",
		"static_pointer_slot_initializer\t1\t(void*)@0@",
	)
	primitive_slot_initializer_ok: Bool = manifest_line_is(
		"static_primitive_slot_initializer",
		"static_primitive_slot_initializer\t1\t(void*)(long)(@0@)",
	)
	void_slot_initializer_ok: Bool = manifest_line_is(
		"static_void_slot_initializer",
		"static_void_slot_initializer\t0\t(void*)0",
	)
	inline_cast_initializer_ok: Bool = manifest_line_is(
		"static_inline_element_cast_initializer",
		"static_inline_element_cast_initializer\t2\t((@0@)(@1@))",
	)
	count_ok: Bool = render_manifest_lines().length() == 31

	(
		object_ok
		and tuple_object_ok
		and pointer_list_object_ok
		and inline_list_object_ok
		and record_object_ok
		and union_object_ok
		and string_ok
		and list_ok
		and tuple_ok
		and typed_pointer_ok
		and stack_result_initializer_ok
		and stack_value_ok
		and scalar_global_ok
		and uninitialized_global_ok
		and string_storage_ok
		and list_storage_ok
		and tuple_storage_ok
		and record_storage_ok
		and union_storage_ok
		and child_path_ok
		and list_child_path_ok
		and tuple_child_path_ok
		and union_child_path_ok
		and string_initializer_ok
		and list_initializer_ok
		and tuple_initializer_ok
		and typed_initializer_ok
		and pointer_slot_initializer_ok
		and primitive_slot_initializer_ok
		and void_slot_initializer_ok
		and inline_cast_initializer_ok
		and count_ok
	)


func test_error_text() -> Bool:
	arity_text: String = match render_static_constant("static_string_global_pointer", ["VALUE"]):
		Err(error):
			render_error_to_string(error)
		Ok(value):
			value

	unsupported_text: String = render_error_to_string(UnsupportedStaticConstantOp("static_missing"))

	(
		arity_text == "static constant op static_string_global_pointer expected 2 arg(s), got 1"
		and unsupported_text == "unsupported static constant op: static_missing"
	)


tests: TestSuite = {
	description = "Self-hosted compiler static constant renderer",
	tests = [
		("parse template shapes", test_parse_template_shapes),
		("render static constant successes", test_render_static_constant_successes),
		("render static constant errors are typed", test_render_static_constant_errors_are_typed),
		("manifest lines", test_manifest_lines),
		("error text", test_error_text),
	]
}
