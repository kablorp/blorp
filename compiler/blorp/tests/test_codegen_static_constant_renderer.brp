import:
	../codegen_static_constant_renderer:
		RenderError(UnsupportedStaticConstantOp, WrongArity),
		parse_static_constant_template,
		render_error_to_string,
		render_manifest_line,
		render_manifest_lines,
		render_static_constant,
		static_constant_template_arity,
		static_constant_template_name,
	test: TestSuite


func parsed_template_has(name: String, expected_name: String, expected_arity: Int) -> Bool:
	match parse_static_constant_template(name):
		Some(info):
			(
				static_constant_template_name(info) == expected_name
				and static_constant_template_arity(info) == expected_arity
			)
		None:
			False


func rendered_static_constant_is(name: String, args: List[String], expected: String) -> Bool:
	match render_static_constant(name, args):
		Ok(rendered):
			rendered == expected
		Err(error):
			False


func manifest_line_is(name: String, expected: String) -> Bool:
	match parse_static_constant_template(name):
		Some(info):
			render_manifest_line(info) == expected
		None:
			False


func test_parse_template_shapes() -> Bool:
	object_ok: Bool = parsed_template_has("static_string_object", "static_string_object", 4)
	tuple_object_ok: Bool = parsed_template_has("static_tuple_object", "static_tuple_object", 5)
	pointer_list_object_ok: Bool = parsed_template_has(
		"static_pointer_list_object",
		"static_pointer_list_object",
		6,
	)
	inline_list_object_ok: Bool = parsed_template_has(
		"static_inline_list_object",
		"static_inline_list_object",
		7,
	)
	record_object_ok: Bool = parsed_template_has("static_record_object", "static_record_object", 3)
	union_object_ok: Bool = parsed_template_has("static_union_object", "static_union_object", 5)
	string_ok: Bool = parsed_template_has(
		"static_string_global_pointer",
		"static_string_global_pointer",
		2,
