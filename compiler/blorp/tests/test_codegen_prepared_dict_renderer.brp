import:
	../codegen_prepared_dict_renderer:
		ALL_TEMPLATES,
		CompilerCommand(RenderManifestCommand, RenderPreparedDictCommand, UnknownCommand),
		RenderError(UnsupportedPreparedDictOp, WrongArity),
		parse_command,
		parse_prepared_dict_template,
		prepared_dict_template_arity,
		prepared_dict_template_name,
		render_error_to_string,
		render_manifest_line,
		render_manifest_lines,
		render_prepared_dict,
	test: TestSuite


func parsed_template_has(name: String, expected_name: String, expected_arity: Int) -> Bool:
	match parse_prepared_dict_template(name):
		Some(info):
			(
				prepared_dict_template_name(info) == expected_name
				and prepared_dict_template_arity(info) == expected_arity
			)
		None:
			False


func manifest_line_is(name: String, expected: String) -> Bool:
	match parse_prepared_dict_template(name):
		Some(info):
			render_manifest_line(info) == expected
		None:
			False


func rendered_prepared_dict_is(name: String, args: List[String], expected: String) -> Bool:
	match render_prepared_dict(name, args):
		Ok(rendered):
			rendered == expected
		Err(error):
			False


func test_parse_command_routes() -> Bool:
	render_command: CompilerCommand = parse_command("prepared-dict")
	manifest_command: CompilerCommand = parse_command("manifest")
	unknown_command: CompilerCommand = parse_command("wat")

	render_ok: Bool = match render_command:
		RenderPreparedDictCommand:
			True
		RenderManifestCommand:
			False
		UnknownCommand:
			False

	manifest_ok: Bool = match manifest_command:
		RenderPreparedDictCommand:
			False
		RenderManifestCommand:
			True
		UnknownCommand:
			False

	unknown_ok: Bool = match unknown_command:
		RenderPreparedDictCommand:
			False
		RenderManifestCommand:
			False
		UnknownCommand:
			True

	render_ok and manifest_ok and unknown_ok


func test_parse_template_shapes() -> Bool:
	value_record_ok: Bool = parsed_template_has(
		"dict_stack_option_get_value_record",
		"dict_stack_option_get_value_record",
		6,
	)
	value_record_release_ok: Bool = parsed_template_has(
		"dict_stack_option_get_value_record_release_key",
		"dict_stack_option_get_value_record_release_key",
		6,
	)
	long_ok: Bool = parsed_template_has(
		"dict_stack_option_get_long",
		"dict_stack_option_get_long",
		5,
	)
	long_release_ok: Bool = parsed_template_has(
		"dict_stack_option_get_long_release_key",
		"dict_stack_option_get_long_release_key",
		5,
	)
	int128_ok: Bool = parsed_template_has(
		"dict_stack_option_get_int128",
		"dict_stack_option_get_int128",
		5,
	)
	int128_release_ok: Bool = parsed_template_has(
		"dict_stack_option_get_int128_release_key",
		"dict_stack_option_get_int128_release_key",
		5,
	)
	uint128_ok: Bool = parsed_template_has(
		"dict_stack_option_get_uint128",
		"dict_stack_option_get_uint128",
		5,
	)
	uint128_release_ok: Bool = parsed_template_has(
		"dict_stack_option_get_uint128_release_key",
		"dict_stack_option_get_uint128_release_key",
		5,
	)
	construct_empty_ok: Bool = parsed_template_has(
		"dict_construct_empty",
		"dict_construct_empty",
		1,
	)
	value_release_ok: Bool = parsed_template_has(
		"dict_value_release_init",
		"dict_value_release_init",
		1,
	)
	insert_ok: Bool = parsed_template_has("dict_insert", "dict_insert", 3)
	iter_source_ok: Bool = parsed_template_has(
		"dict_iter_source_binding",
		"dict_iter_source_binding",
		2,
	)
	iter_loop_ok: Bool = parsed_template_has("dict_iter_loop_open", "dict_iter_loop_open", 2)
	iter_slot_ok: Bool = parsed_template_has("dict_iter_slot_binding", "dict_iter_slot_binding", 3)
	iter_guard_ok: Bool = parsed_template_has(
		"dict_iter_deleted_slot_guard",
		"dict_iter_deleted_slot_guard",
		1,
	)
	iter_key_ok: Bool = parsed_template_has("dict_iter_key_binding", "dict_iter_key_binding", 4)
	iter_pair_ok: Bool = parsed_template_has("dict_iter_pair_binding", "dict_iter_pair_binding", 3)
	construct_with_body_ok: Bool = parsed_template_has(
		"dict_construct_with_body",
		"dict_construct_with_body",
		4,
	)
	missing_ok: Bool = not parsed_template_has("dict_get", "dict_get", 1)

	(
		value_record_ok
		and value_record_release_ok
		and long_ok
		and long_release_ok
		and int128_ok
		and int128_release_ok
		and uint128_ok
		and uint128_release_ok
		and construct_empty_ok
		and value_release_ok
		and insert_ok
		and iter_source_ok
		and iter_loop_ok
		and iter_slot_ok
		and iter_guard_ok
		and iter_key_ok
		and iter_pair_ok
		and construct_with_body_ok
		and missing_ok
	)


func test_render_prepared_dict_successes() -> Bool:
	value_record_ok: Bool = match render_prepared_dict(
		"dict_stack_option_get_value_record",
		["dict", "key", "0", "blorp_StackOption_Point", "Point", "{0}"],
	):
		Ok(rendered):
			rendered == (
				"({ blorp_Dict* __gso_dict_0 = (blorp_Dict*)dict; void* __gso_key_0 = key; void* "
				+ "__gso_raw_0 = NULL; bool __gso_found_0 = blorp_dict_get_raw(__gso_dict_0, "
				+ "__gso_key_0, &__gso_raw_0); blorp_StackOption_Point __gso_result_0; if "
				+ "(__gso_found_0) { __gso_result_0 = ((blorp_StackOption_Point){ .tag = "
				+ "BLORP_TAG_SOME, .value = blorp_unbox_struct(__gso_raw_0, Point) }); } else { "
				+ "__gso_result_0 = ((blorp_StackOption_Point){ .tag = BLORP_TAG_NONE, .value = "
				+ "{0} }); } __gso_result_0; })"
			)
		Err(error):
			False

	long_release_ok: Bool = match render_prepared_dict(
		"dict_stack_option_get_long_release_key",
		["dict", "key", "0", "blorp_StackOption_Range", "0"],
	):
		Ok(rendered):
			rendered == (
				"({ blorp_Dict* __gso_dict_0 = (blorp_Dict*)dict; void* __gso_key_0 = key; void* "
				+ "__gso_raw_0 = NULL; bool __gso_found_0 = blorp_dict_get_raw(__gso_dict_0, "
				+ "__gso_key_0, &__gso_raw_0); blorp_StackOption_Range __gso_result_0; if "
				+ "(__gso_found_0) { __gso_result_0 = ((blorp_StackOption_Range){ .tag = "
				+ "BLORP_TAG_SOME, .value = (long)__gso_raw_0 }); } else { __gso_result_0 = "
				+ "((blorp_StackOption_Range){ .tag = BLORP_TAG_NONE, .value = 0 }); } "
				+ "blorp_release(__gso_key_0); __gso_result_0; })"
			)
		Err(error):
			False

	int128_ok: Bool = match render_prepared_dict(
		"dict_stack_option_get_int128",
		["dict", "key", "0", "blorp_StackOption_Int128", "0"],
	):
		Ok(rendered):
			rendered == (
				"({ blorp_Dict* __gso_dict_0 = (blorp_Dict*)dict; void* __gso_key_0 = key; void* "
				+ "__gso_raw_0 = NULL; bool __gso_found_0 = blorp_dict_get_raw(__gso_dict_0, "
				+ "__gso_key_0, &__gso_raw_0); blorp_StackOption_Int128 __gso_result_0; if "
				+ "(__gso_found_0) { __gso_result_0 = ((blorp_StackOption_Int128){ .tag = "
				+ "BLORP_TAG_SOME, .value = blorp_unbox_int128(__gso_raw_0) }); } else { "
				+ "__gso_result_0 = ((blorp_StackOption_Int128){ .tag = BLORP_TAG_NONE, .value = 0 "
				+ "}); } __gso_result_0; })"
			)
		Err(error):
			False

	uint128_release_ok: Bool = match render_prepared_dict(
		"dict_stack_option_get_uint128_release_key",
		["dict", "key", "0", "blorp_StackOption_UInt128", "0"],
	):
		Ok(rendered):
			rendered == (
				"({ blorp_Dict* __gso_dict_0 = (blorp_Dict*)dict; void* __gso_key_0 = key; void* "
				+ "__gso_raw_0 = NULL; bool __gso_found_0 = blorp_dict_get_raw(__gso_dict_0, "
				+ "__gso_key_0, &__gso_raw_0); blorp_StackOption_UInt128 __gso_result_0; if "
				+ "(__gso_found_0) { __gso_result_0 = ((blorp_StackOption_UInt128){ .tag = "
				+ "BLORP_TAG_SOME, .value = blorp_unbox_uint128(__gso_raw_0) }); } else { "
				+ "__gso_result_0 = ((blorp_StackOption_UInt128){ .tag = BLORP_TAG_NONE, .value = "
				+ "0 }); } blorp_release(__gso_key_0); __gso_result_0; })"
			)
		Err(error):
			False

	construct_empty_ok: Bool = rendered_prepared_dict_is(
		"dict_construct_empty",
		["blorp_dict_new()"],
		"blorp_dict_new()",
	)

	value_release_ok: Bool = rendered_prepared_dict_is(
		"dict_value_release_init",
		["0"],
		" blorp_dict_set_value_release(__dict_0, blorp_elem_release_fn);",
	)

	insert_ok: Bool = rendered_prepared_dict_is(
		"dict_insert",
		["0", "(void*)(long)(1L)", "(void*)(long)(10L)"],
		" __dict_0 = blorp_dict_insert(__dict_0, (void*)(long)(1L), (void*)(long)(10L));",
	)

	iter_source_ok: Bool = rendered_prepared_dict_is(
		"dict_iter_source_binding",
		["__dict_iter_0", "items"],
		"blorp_Dict* __dict_iter_0 = (blorp_Dict*)items;",
	)

	iter_loop_ok: Bool = rendered_prepared_dict_is(
		"dict_iter_loop_open",
		["__di_0", "__dict_iter_0"],
		"for (long __di_0 = 0; __di_0 < __dict_iter_0->order_len; __di_0++) {",
	)

	iter_slot_ok: Bool = rendered_prepared_dict_is(
		"dict_iter_slot_binding",
		["__dslot_0", "__dict_iter_0", "__di_0"],
		"long __dslot_0 = __dict_iter_0->order[__di_0];",
	)

	iter_guard_ok: Bool = rendered_prepared_dict_is(
		"dict_iter_deleted_slot_guard",
		["__dslot_0"],
		"if (__dslot_0 < 0) continue;",
	)

	iter_key_ok: Bool = rendered_prepared_dict_is(
		"dict_iter_key_binding",
		["long", "key", "__dict_iter_0", "__dslot_0"],
		"long key = (long)__dict_iter_0->keys[__dslot_0];",
	)

	iter_pair_ok: Bool = rendered_prepared_dict_is(
		"dict_iter_pair_binding",
		["entry", "__dict_iter_0", "__dslot_0"],
		(
			"blorp_Tuple* entry = blorp_tuple_new(2, __dict_iter_0->keys[__dslot_0], "
			+ "__dict_iter_0->values[__dslot_0]);"
		),
	)

	construct_with_body_ok: Bool = rendered_prepared_dict_is(
		"dict_construct_with_body",
		[
			"blorp_dict_new()",
			"0",
			" blorp_dict_set_value_release(__dict_0, blorp_elem_release_fn);",
			" __dict_0 = blorp_dict_insert(__dict_0, key, value);",
		],
		(
			"({ blorp_Dict* __dict_0 = blorp_dict_new(); blorp_dict_set_value_release(__dict_"
			+ "0, blorp_elem_release_fn); __dict_0 = blorp_dict_insert(__dict_0, key, value); "
			+ "__dict_0; })"
		),
	)

	(
		value_record_ok
		and long_release_ok
		and int128_ok
		and uint128_release_ok
		and construct_empty_ok
		and value_release_ok
		and insert_ok
		and iter_source_ok
		and iter_loop_ok
		and iter_slot_ok
		and iter_guard_ok
		and iter_key_ok
		and iter_pair_ok
		and construct_with_body_ok
	)


func test_render_prepared_dict_errors_are_typed() -> Bool:
	match render_prepared_dict("dict_stack_option_get_long", ["dict"]):
		Ok(rendered):
			False
		Err(error):
			match error:
				WrongArity(info, got):
					(
						prepared_dict_template_name(info) == "dict_stack_option_get_long"
						and prepared_dict_template_arity(info) == 5
						and got == 1
					)
				UnsupportedPreparedDictOp(name):
					False


func test_render_error_to_string() -> Bool:
	arity_text: String = match render_prepared_dict("dict_stack_option_get_long", ["dict"]):
		Ok(rendered):
			rendered
		Err(error):
			render_error_to_string(error)

	unsupported_text: String = render_error_to_string(UnsupportedPreparedDictOp("missing"))

	(
		arity_text == "prepared dict op dict_stack_option_get_long expected 5 arg(s), got 1"
		and unsupported_text == "unsupported prepared dict op: missing"
	)


func test_render_manifest_lines() -> Bool:
	lines: List[String] = render_manifest_lines()
	count_ok: Bool = lines.length() == ALL_TEMPLATES.length()

	first_ok: Bool = match lines:
		[]:
			False
		[first, ...rest]:
			first == "dict_stack_option_get_value_record\t6\t({ blorp_Dict* __gso_dict_@2@ = (blorp_Dict*)@0@; void* __gso_key_@2@ = @1@; void* __gso_raw_@2@ = NULL; bool __gso_found_@2@ = blorp_dict_get_raw(__gso_dict_@2@, __gso_key_@2@, &__gso_raw_@2@); @3@ __gso_result_@2@; if (__gso_found_@2@) { __gso_result_@2@ = ((@3@){ .tag = BLORP_TAG_SOME, .value = blorp_unbox_struct(__gso_raw_@2@, @4@) }); } else { __gso_result_@2@ = ((@3@){ .tag = BLORP_TAG_NONE, .value = @5@ }); } __gso_result_@2@; })"

	long_release_ok: Bool = manifest_line_is(
		"dict_stack_option_get_long_release_key",
		"dict_stack_option_get_long_release_key\t5\t({ blorp_Dict* __gso_dict_@2@ = (blorp_Dict*)@0@; void* __gso_key_@2@ = @1@; void* __gso_raw_@2@ = NULL; bool __gso_found_@2@ = blorp_dict_get_raw(__gso_dict_@2@, __gso_key_@2@, &__gso_raw_@2@); @3@ __gso_result_@2@; if (__gso_found_@2@) { __gso_result_@2@ = ((@3@){ .tag = BLORP_TAG_SOME, .value = (long)__gso_raw_@2@ }); } else { __gso_result_@2@ = ((@3@){ .tag = BLORP_TAG_NONE, .value = @4@ }); } blorp_release(__gso_key_@2@); __gso_result_@2@; })",
	)
	insert_ok: Bool = manifest_line_is(
		"dict_insert",
		"dict_insert\t3\t __dict_@0@ = blorp_dict_insert(__dict_@0@, @1@, @2@);",
	)
	iter_source_ok: Bool = manifest_line_is(
		"dict_iter_source_binding",
		"dict_iter_source_binding\t2\tblorp_Dict* @0@ = (blorp_Dict*)@1@;",
	)
	iter_loop_ok: Bool = manifest_line_is(
		"dict_iter_loop_open",
		"dict_iter_loop_open\t2\tfor (long @0@ = 0; @0@ < @1@->order_len; @0@++) {",
	)
	iter_slot_ok: Bool = manifest_line_is(
		"dict_iter_slot_binding",
		"dict_iter_slot_binding\t3\tlong @0@ = @1@->order[@2@];",
	)
	iter_guard_ok: Bool = manifest_line_is(
		"dict_iter_deleted_slot_guard",
		"dict_iter_deleted_slot_guard\t1\tif (@0@ < 0) continue;",
	)
	iter_key_ok: Bool = manifest_line_is(
		"dict_iter_key_binding",
		"dict_iter_key_binding\t4\t@0@ @1@ = (@0@)@2@->keys[@3@];",
	)
	iter_pair_ok: Bool = manifest_line_is(
		"dict_iter_pair_binding",
		"dict_iter_pair_binding\t3\tblorp_Tuple* @0@ = blorp_tuple_new(2, @1@->keys[@2@], @1@->values[@2@]);",
	)
	construct_ok: Bool = manifest_line_is(
		"dict_construct_with_body",
		"dict_construct_with_body\t4\t({ blorp_Dict* __dict_@1@ = @0@;@2@@3@ __dict_@1@; })",
	)

	(
		count_ok
		and first_ok
		and long_release_ok
		and insert_ok
		and iter_source_ok
		and iter_loop_ok
		and iter_slot_ok
		and iter_guard_ok
		and iter_key_ok
		and iter_pair_ok
		and construct_ok
	)


tests: TestSuite = {
	description = "Self-hosted compiler prepared dict renderer",
	tests = [
		("parse command routes", test_parse_command_routes),
		("parse template shapes", test_parse_template_shapes),
		("render prepared dict successes", test_render_prepared_dict_successes),
		("render prepared dict errors are typed", test_render_prepared_dict_errors_are_typed),
		("render error to string", test_render_error_to_string),
		("render manifest lines", test_render_manifest_lines),
	]
}
