import:
	../src/stage_03_parse/parser_bridge as ParserBridge
	../src/stage_03_parse/source_ast_finalize:
		FinalizedImportPathRewrite,
		FinalizedTypecheckProgram,
		finalized_typecheck_program_rewrite_import_paths,
	../src/stage_04_modules/loaded_module:
		CompilerModuleLoadCandidate,
		CompilerModuleOrigin(CompilerStdlibModule, CompilerUserModule),
		compiler_module_identity_display_name,
		compiler_module_load_candidate,
		compiler_module_load_candidate_canonical_path,
		compiler_resolved_module_identity_from_resolver,
	../src/stage_06_typecheck/graph/definition_index:
		compiler_definition_index_func_callable_id_count,
		compiler_definition_index_initial_seed,
		compiler_definition_index_next_def_id,
		compiler_definition_index_seed_next_def_id,
	../src/stage_06_typecheck/graph/indexed_graph:
		CompilerIndexedGraph,
		CompilerIndexedGraphError,
		compiler_indexed_graph_build,
		compiler_indexed_graph_definition_index,
		compiler_indexed_graph_error_message,
		compiler_indexed_graph_find_dependency,
		compiler_indexed_graph_find_dependency_scope,
		compiler_indexed_graph_modules,
		compiler_indexed_graph_select_dependencies,
		compiler_indexed_graph_select_dependency_scopes,
		compiler_indexed_graph_target,
		compiler_indexed_graph_target_scope,
		compiler_prepared_module_identity,
		compiler_prepared_module_scope_module,
		compiler_prepared_module_scopes_are_compatible,
		prepared_module_program,
	memory: get_mem_stats, reset_mem_stats
	test: TestSuite


private pure func finalized_program(
	path: String,
	module_name: String,
	source: String,
) -> FinalizedTypecheckProgram:
	ParserBridge.parsed_typecheck_source_bridge_artifact(path, module_name, source, False).program


private pure func module_load_candidate(
	path: String,
	module_path: String,
	source: String,
) -> CompilerModuleLoadCandidate:
	module_load_candidate_with_origin(path, module_path, source, CompilerUserModule)


private pure func module_load_candidate_with_origin(
	path: String,
	module_path: String,
	source: String,
	origin: CompilerModuleOrigin,
) -> CompilerModuleLoadCandidate:
	compiler_module_load_candidate(
		compiler_resolved_module_identity_from_resolver(module_path, origin),
		finalized_program(path, module_path, source),
	)


private pure func module_load_candidate_with_resolved_import(
	path: String,
	module_path: String,
	resolved_import: String,
) -> CompilerModuleLoadCandidate:
	source: String = "import:\n\tshared\n\npure func value() -> Int:\n\t1"
	rewrite: FinalizedImportPathRewrite = {
		from_path = path,
		from_module = module_path,
		import_path = "shared",
		resolved_module = resolved_import
	}
	rewritten = finalized_typecheck_program_rewrite_import_paths(
		finalized_program(path, module_path, source),
		path,
		module_path,
		[rewrite],
	)
	compiler_module_load_candidate(
		compiler_resolved_module_identity_from_resolver(module_path, CompilerUserModule),
		rewritten,
	)


private pure func indexed_graph_build(
	target: CompilerModuleLoadCandidate,
	modules: List[CompilerModuleLoadCandidate],
) -> Result[CompilerIndexedGraph, List[CompilerIndexedGraphError]]:
	compiler_indexed_graph_build(target, modules)


private pure func first_error_message(errors: List[CompilerIndexedGraphError]) -> Option[String]:
	errors
		.get(0)
		.map(compiler_indexed_graph_error_message)


pure func test_indexed_graph_owns_canonical_modules_and_definition_index() -> Bool:
	target = module_load_candidate(
		"src/main.brp",
		"app/main",
		"func main(args: List[String]) -> Int:\n\t0",
	)
	dependency = module_load_candidate(
		"src/math.brp",
		"pkg/math",
		"pure func answer() -> Int:\n\t42",
	)

	match indexed_graph_build(target, [dependency]):
		Ok(graph):
			found_dependency = compiler_indexed_graph_find_dependency(graph, "pkg/math")
			definition_index = compiler_indexed_graph_definition_index(graph)
			initial_next_def_id = compiler_definition_index_seed_next_def_id(
				compiler_definition_index_initial_seed(),
			)

			(
				compiler_module_identity_display_name(
					compiler_prepared_module_identity(
						compiler_indexed_graph_target(graph),
					),
				) == "app/main"
				and compiler_indexed_graph_modules(graph).length() == 1
				and match found_dependency:
					Some(found):
						compiler_module_identity_display_name(
							compiler_prepared_module_identity(found),
						) == "pkg/math"
					None:
						False
				and compiler_indexed_graph_find_dependency(graph, "math").is_none()
				and compiler_definition_index_func_callable_id_count(definition_index) == 2
				and compiler_definition_index_next_def_id(
					definition_index,
				) == initial_next_def_id + 2
			)
		Err(_):
			False


pure func test_indexed_graph_rejects_duplicate_dependency_identity() -> Bool:
	target = module_load_candidate("main.brp", "main", "func main(): 0")
	first = module_load_candidate("first.brp", "shared", "pure func first(): 1")
	duplicate = module_load_candidate("second.brp", "shared", "pure func second(): 2")

	match (
		indexed_graph_build(
			target,
			[first, duplicate],
		)
	):
		Ok(_):
			False
		Err(errors):
			(
				errors.length() == 1
				and first_error_message(
					errors,
				) == Some(
					"duplicate canonical module identity 'shared': 'first.brp' and 'second.brp'",
				)
			)


pure func test_indexed_graph_rejects_target_dependency_identity_conflict() -> Bool:
	target = module_load_candidate("main.brp", "app", "func main(): 0")
	duplicate = module_load_candidate("copy.brp", "app", "pure func copy(): 1")

	match indexed_graph_build(target, [duplicate]):
		Ok(_):
			False
		Err(errors):
			(
				errors.length() == 1
				and first_error_message(
					errors,
				) == Some("duplicate canonical module identity 'app': 'main.brp' and 'copy.brp'")
			)


pure func test_indexed_graph_preserves_source_name_separately_from_canonical_path() -> Bool:
	target = compiler_module_load_candidate(
		compiler_resolved_module_identity_from_resolver("pkg/resolved", CompilerUserModule),
		finalized_program("main.brp", "declared", "func main(): 0"),
	)

	match indexed_graph_build(target, []):
		Err(_):
			False
		Ok(graph):
			module = compiler_indexed_graph_target(graph)

			(
				compiler_module_identity_display_name(
					compiler_prepared_module_identity(module),
				) == "pkg/resolved"
				and prepared_module_program(module).source.module_name == "declared"
			)


pure func test_indexed_graph_keeps_same_source_distinct_across_canonical_modules() -> Bool:
	target = module_load_candidate("main.brp", "app", "func main(): 0")
	left = module_load_candidate("shared.brp", "pkg/left", "pure func render() -> Int:\n\t1")
	right = module_load_candidate("shared.brp", "pkg/right", "pure func render() -> Int:\n\t1")

	match (
		indexed_graph_build(
			target,
			[left, right],
		)
	):
		Err(_):
			False
		Ok(graph):
			(
				compiler_indexed_graph_modules(graph).length() == 2
				and compiler_definition_index_func_callable_id_count(
					compiler_indexed_graph_definition_index(graph),
				) == 3
			)


pure func test_indexed_graph_validates_dependency_selection() -> Bool:
	target = module_load_candidate("main.brp", "app", "func main(): 0")
	first = module_load_candidate("first.brp", "pkg/first", "pure func first(): 1")
	second = module_load_candidate("second.brp", "pkg/second", "pure func second(): 2")

	match (
		indexed_graph_build(
			target,
			[first, second],
		)
	):
		Err(_):
			False
		Ok(graph):
			selected_ok = match (
				compiler_indexed_graph_select_dependencies(
					graph,
					["pkg/second", "pkg/first"],
				)
			):
				Ok(selected):
					selected
						.map(compiler_prepared_module_identity)
						.map(compiler_module_identity_display_name) == ["pkg/second", "pkg/first"]
				Err(_):
					False

			selected_scopes_ok = match (
				compiler_indexed_graph_select_dependency_scopes(
					graph,
					["pkg/second", "pkg/first"],
				)
			):
				Ok(selected_scopes):
					(
						selected_scopes
							.map(compiler_prepared_module_scope_module)
							.map(compiler_prepared_module_identity)
							.map(
								compiler_module_identity_display_name,
							) == ["pkg/second", "pkg/first"]
						and selected_scopes.all(func(scope):
							compiler_prepared_module_scopes_are_compatible(
								compiler_indexed_graph_target_scope(graph),
								scope,
							)
						)
					)
				Err(_):
					False

			unknown_ok = match compiler_indexed_graph_select_dependencies(graph, ["missing"]):
				Ok(_):
					False
				Err(errors):
					(
						errors.length() == 1
						and first_error_message(
							errors,
						) == Some("unknown typecheck module target 'missing'")
					)

			duplicate_ok = match (
				compiler_indexed_graph_select_dependencies(
					graph,
					["pkg/first", "pkg/first"],
				)
			):
				Ok(_):
					False
				Err(errors):
					(
						errors.length() == 1
						and first_error_message(
							errors,
						) == Some("duplicate typecheck module target 'pkg/first'")
					)

			selected_ok and selected_scopes_ok and unknown_ok and duplicate_ok


private pure func target_accepts_dependency_scope_from(
	target_graph: CompilerIndexedGraph,
	dependency_graph: CompilerIndexedGraph,
) -> Option[Bool]:
	compiler_indexed_graph_find_dependency_scope(dependency_graph, "dep").map(func(scope):
		compiler_prepared_module_scopes_are_compatible(
			compiler_indexed_graph_target_scope(target_graph),
			scope,
		)
	)


pure func test_prepared_module_scopes_require_compatible_graphs() -> Bool:
	target = module_load_candidate("main.brp", "app", "func main(): 0")
	dependency_program = finalized_program("dep.brp", "dep", "pure func value(): 1")
	dependency = compiler_module_load_candidate(
		compiler_resolved_module_identity_from_resolver("dep", CompilerUserModule),
		dependency_program,
	)
	different_dependency = module_load_candidate("dep.brp", "dep", "pure func value(): 2")
	different_origin_dependency = compiler_module_load_candidate(
		compiler_resolved_module_identity_from_resolver("dep", CompilerStdlibModule),
		dependency_program,
	)

	match indexed_graph_build(target, [dependency]):
		Err(_):
			False
		Ok(first_graph):
			match indexed_graph_build(target, [dependency]):
				Err(_):
					False
				Ok(second_graph):
					match indexed_graph_build(target, [different_dependency]):
						Err(_):
							False
						Ok(different_graph):
							match indexed_graph_build(target, [different_origin_dependency]):
								Err(_):
									False
								Ok(different_origin_graph):
									(
										target_accepts_dependency_scope_from(
											first_graph,
											first_graph,
										) == Some(True)
										and target_accepts_dependency_scope_from(
											first_graph,
											second_graph,
										) == Some(True)
										and target_accepts_dependency_scope_from(
											first_graph,
											different_graph,
										) == Some(False)
										and target_accepts_dependency_scope_from(
											first_graph,
											different_origin_graph,
										) == Some(False)
									)


pure func test_prepared_module_scopes_compare_resolved_programs() -> Bool:
	target = module_load_candidate("main.brp", "app", "func main(): 0")
	first_dependency = module_load_candidate_with_resolved_import("dep.brp", "dep", "pkg/first")
	second_dependency = module_load_candidate_with_resolved_import("dep.brp", "dep", "pkg/second")

	match indexed_graph_build(target, [first_dependency]):
		Err(_):
			False
		Ok(first_graph):
			match indexed_graph_build(target, [second_dependency]):
				Err(_):
					False
				Ok(second_graph):
					target_accepts_dependency_scope_from(first_graph, second_graph) == Some(False)


pure func test_prepared_module_scopes_reject_different_module_order() -> Bool:
	target = module_load_candidate("main.brp", "app", "func main(): 0")
	first_dependency = module_load_candidate("first.brp", "pkg/first", "pure func first(): 1")
	second_dependency = module_load_candidate("second.brp", "pkg/second", "pure func second(): 2")

	match (
		indexed_graph_build(
			target,
			[first_dependency, second_dependency],
		)
	):
		Err(_):
			False
		Ok(first_graph):
			match (
				indexed_graph_build(
					target,
					[second_dependency, first_dependency],
				)
			):
				Err(_):
					False
				Ok(reordered_graph):
					not compiler_prepared_module_scopes_are_compatible(
						compiler_indexed_graph_target_scope(first_graph),
						compiler_indexed_graph_target_scope(reordered_graph),
					)


private func build_and_release_indexed_graph() -> Bool:
	target = module_load_candidate("main.brp", "app", "func main(): 0")
	dependency = module_load_candidate("dep.brp", "dep", "pure func value(): 1")

	match indexed_graph_build(target, [dependency]):
		Err(_):
			False
		Ok(graph):
			compiler_indexed_graph_modules(graph).length() == 1


private func build_and_release_graph_inputs() -> Bool:
	target = module_load_candidate("main.brp", "app", "func main(): 0")
	dependency = module_load_candidate("dep.brp", "dep", "pure func value(): 1")
	seed_next_def_id = compiler_definition_index_seed_next_def_id(
		compiler_definition_index_initial_seed(),
	)

	(
		compiler_module_load_candidate_canonical_path(target) == "app"
		and compiler_module_load_candidate_canonical_path(dependency) == "dep"
		and seed_next_def_id > 0
	)


func test_indexed_graph_releases_owned_values() -> Bool:
	reset_mem_stats()
	inputs_built = build_and_release_graph_inputs()
	input_stats = get_mem_stats()

	reset_mem_stats()
	built = build_and_release_indexed_graph()
	stats = get_mem_stats()
	released = (
		stats.current_objects == input_stats.current_objects
		and stats.total_allocations - stats.total_releases == input_stats.total_allocations - input_stats.total_releases
	)

	if not released:
		print(
			"indexed graph memory delta: input_current=" + input_stats.current_objects.to_string() + " graph_current=" + stats.current_objects.to_string() + " input_net=" + (input_stats.total_allocations - input_stats.total_releases).to_string() + " graph_net=" + (stats.total_allocations - stats.total_releases).to_string(),
		)

	inputs_built and built and released


tests: TestSuite = {
	description = "Compiler indexed graph",
	tests = [
		(
			"owns canonical modules and definition index",
			test_indexed_graph_owns_canonical_modules_and_definition_index,
		),
		(
			"rejects duplicate dependency identity",
			test_indexed_graph_rejects_duplicate_dependency_identity,
		),
		(
			"rejects target dependency identity conflict",
			test_indexed_graph_rejects_target_dependency_identity_conflict,
		),
		(
			"preserves source name separately from canonical path",
			test_indexed_graph_preserves_source_name_separately_from_canonical_path,
		),
		(
			"keeps identical source spans distinct across canonical modules",
			test_indexed_graph_keeps_same_source_distinct_across_canonical_modules,
		),
		("validates dependency selection", test_indexed_graph_validates_dependency_selection),
		(
			"prepared module scopes require compatible graphs",
			test_prepared_module_scopes_require_compatible_graphs,
		),
		(
			"prepared module scopes compare resolved programs",
			test_prepared_module_scopes_compare_resolved_programs,
		),
		(
			"prepared module scopes reject different module order",
			test_prepared_module_scopes_reject_different_module_order,
		),
		("indexed graph releases owned values", test_indexed_graph_releases_owned_values),
	]
}
