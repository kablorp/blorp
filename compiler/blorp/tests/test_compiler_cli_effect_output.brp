import:
	../src/stage_09_core/compiler_semantic_worker_protocol: SemanticMiddleDiagnostic
	../src/stage_12_cli/compiler_cli_core_observation: CliCoreObservation
	../src/stage_12_cli/compiler_cli_effect_output:
		render_compile_timings,
		render_core_observations,
		render_semantic_diagnostics,
	../src/stage_12_cli/compiler_cli_timing: CliCompileTiming
	test: TestSuite


pure func test_semantic_diagnostics_include_location_code_and_help() -> Bool:
	diagnostics: List[SemanticMiddleDiagnostic] = [
		{
			code = "core_resource",
			message = "resource escaped its scope",
			path = Some("src/main.brp"),
			line = 12,
			column = 4,
			help = Some("return an ordinary value")
		},
		{
			code = "core_projection",
			message = "unsupported Core form",
			path = None,
			line = 0,
			column = 0,
			help = None
		},
	]
	rendered: String = render_semantic_diagnostics(diagnostics)

	(
		rendered.contains("src/main.brp:12:4: error[core_resource]: resource escaped its scope")
		and rendered.contains("help: return an ordinary value")
		and rendered.contains("error[core_projection]: unsupported Core form")
	)


pure func test_observations_have_one_header_and_stage_boundaries() -> Bool:
	observations: List[CliCoreObservation] = [
		{
			stage_name = "lower",
			rendered = "lower body\n"
		},
		{
			stage_name = "resolve",
			rendered = "resolved body"
		},
	]
	rendered: String = render_core_observations("src/main.brp", observations)

	(
		rendered.starts_with("-- blorp src/main.brp\n")
		and rendered.contains("===== after lower =====\nlower body\n")
		and rendered.contains("===== after resolve =====\nresolved body\n")
		and rendered.count("-- blorp") == 1
	)


pure func test_compile_timings_include_phases_and_total() -> Bool:
	timings: List[CliCompileTiming] = [
		{
			label = "frontend",
			microseconds = 1250
		},
		{
			label = "semantic_middle",
			microseconds = 2750
		},
	]
	rendered: String = render_compile_timings(timings)

	(
		rendered.contains("frontend\t1.25 ms")
		and rendered.contains("semantic_middle\t2.75 ms")
		and rendered.contains("total\t4")
	)


tests: TestSuite = {
	description = "Blorp compiler CLI effect output",
	tests = [
		(
			"semantic diagnostics include location, code, and help",
			test_semantic_diagnostics_include_location_code_and_help,
		),
		(
			"observations have one header and stage boundaries",
			test_observations_have_one_header_and_stage_boundaries,
		),
		(
			"compile timings include phases and total",
			test_compile_timings_include_phases_and_total,
		),
	]
}
