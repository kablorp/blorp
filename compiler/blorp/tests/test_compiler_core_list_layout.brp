import:
	../src/stage_08_core_lower/core_list_layout:
		annotate_list_layouts,
		build_layout_type_index,
		list_element_needs_release_with_index,
		list_layout_for_type_with_index,
	../src/stage_09_core/core_json:
		CoreBoxKind(PointerBox, StructBox),
		CoreDecl(
			EnumDecl,
			FunctionDecl,
			GlobalDecl,
			HeapRecordDecl,
			ImplDecl,
			TypeAliasDecl,
			ValueRecordDecl,
		),
		CoreExpr(
			ForListExpr,
			ListAllocExpr,
			ListConstructExpr,
			LiteralExpr,
			RecordExpr,
			VarExpr,
			VoidExpr,
		),
		CoreFunction,
		CoreFunctionKind(UserFunction),
		CoreListStorageLayout(InlineListStorage, InlineStructListStorage, PointerListStorage),
		CoreLiteral(IntLiteral),
		CoreLoopRangeDirection(RangeMayRunBackward),
		CoreProgram,
		CoreReleasePolicy(NoReleasePolicy),
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(
			EnumType,
			FunctionType,
			HeapRecordType,
			NamedType,
			SelfType,
			StackResultType,
			TupleType,
			TypeParameterType,
			ValueRecordType,
			VoidType,
		),
		CoreVar,
	test: TestSuite


pure func named_type(name: String) -> CoreType:
	NamedType(name, [])


pure func list_type(element_type: CoreType) -> CoreType:
	NamedType("List", [element_type])


pure func core_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


pure func empty_program(decls: List[CoreDecl]) -> CoreProgram:
	{
		decls = decls,
		foreign_includes = []
	}


pure func int_literal(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), named_type("Int"), SyntheticSourceLoc)


pure func is_inline_layout(layout: CoreListStorageLayout, width: Int) -> Bool:
	match layout:
		InlineListStorage(actual_width):
			actual_width == width
		_:
			False


pure func is_inline_struct_layout(layout: CoreListStorageLayout, name: String) -> Bool:
	match layout:
		InlineStructListStorage(actual_name):
			actual_name == name
		_:
			False


pure func is_pointer_layout(layout: CoreListStorageLayout) -> Bool:
	match layout:
		PointerListStorage:
			True
		_:
			False


pure func stale_list_construct(typ: CoreType) -> CoreExpr:
	ListConstructExpr(
		{
			layout = PointerListStorage,
			elements = [],
			elem_needs_release = True
		},
		typ,
		SyntheticSourceLoc,
	)


pure func stale_value_record_list_construct(list_typ: CoreType, record_typ: CoreType) -> CoreExpr:
	ListConstructExpr(
		{
			layout = PointerListStorage,
			elements = [
				{
					kind = PointerBox,
					value = RecordExpr([], record_typ, SyntheticSourceLoc),
					needs_release = False,
					transfers_ownership = False
				},
			],
			elem_needs_release = False
		},
		list_typ,
		SyntheticSourceLoc,
	)


pure func stale_enum_list_construct(list_typ: CoreType, enum_typ: CoreType) -> CoreExpr:
	ListConstructExpr(
		{
			layout = PointerListStorage,
			elements = [
				{
					kind = PointerBox,
					value = VarExpr(core_var("TinyZero"), enum_typ, SyntheticSourceLoc),
					needs_release = False,
					transfers_ownership = False
				},
			],
			elem_needs_release = False
		},
		list_typ,
		SyntheticSourceLoc,
	)


pure func stale_heap_record_list_construct(list_typ: CoreType, record_typ: CoreType) -> CoreExpr:
	ListConstructExpr(
		{
			layout = PointerListStorage,
			elements = [
				{
					kind = PointerBox,
					value = RecordExpr([], record_typ, SyntheticSourceLoc),
					needs_release = False,
					transfers_ownership = False
				},
			],
			elem_needs_release = False
		},
		list_typ,
		SyntheticSourceLoc,
	)


pure func stale_stack_result_list_construct(list_typ: CoreType, result_typ: CoreType) -> CoreExpr:
	ListConstructExpr(
		{
			layout = PointerListStorage,
			elements = [
				{
					kind = PointerBox,
					value = VarExpr(core_var("result"), result_typ, SyntheticSourceLoc),
					needs_release = False,
					transfers_ownership = False
				},
			],
			elem_needs_release = False
		},
		list_typ,
		SyntheticSourceLoc,
	)


pure func stale_list_alloc(typ: CoreType) -> CoreExpr:
	ListAllocExpr(
		{
			layout = InlineListStorage(1),
			capacity = int_literal(4),
			elem_needs_release = False
		},
		typ,
		SyntheticSourceLoc,
	)


pure func stale_list_loop(list_typ: CoreType, element_typ: CoreType) -> CoreExpr:
	ForListExpr(
		{
			binder = {
				variable = core_var("item"),
				typ = element_typ,
				range_direction = RangeMayRunBackward
			},
			layout = PointerListStorage,
			iterable = VarExpr(core_var("items"), list_typ, SyntheticSourceLoc),
			iterable_release_policy = NoReleasePolicy,
			body = VoidExpr(VoidType, SyntheticSourceLoc)
		},
		VoidType,
		SyntheticSourceLoc,
	)


pure func function_decl(name: String, def_id: Int, body: CoreExpr) -> CoreDecl:
	FunctionDecl({
		name = name,
		source_module = None,
		type_params = [],
		params = [],
		return_type = VoidType,
		body = Some(body),
		is_pure = True,
		function_kind = UserFunction,
		def_id = def_id,
		loc = SyntheticSourceLoc,
	})


pure func global_decl(
	name: String,
	def_id: Int,
	typ: CoreType,
	init: CoreExpr,
) -> CoreDecl:
	GlobalDecl({
		name = core_var(name),
		source_module = None,
		typ = typ,
		init = init,
		is_mutable = False,
		is_const = False,
		is_private = False,
		def_id = def_id,
		loc = SyntheticSourceLoc,
	})


pure func test_classifies_primitive_widths() -> Bool:
	program: CoreProgram = empty_program([])
	index = build_layout_type_index(program)
	cases: List[(String, Int)] = [
		("Bool", 1),
		("Char", 4),
		("Int16", 2),
		("Float32", 4),
		("Int", 8),
		("Float", 8),
	]

	cases.all(func(pair):
		match list_layout_for_type_with_index(index, list_type(named_type(pair[0]))):
			InlineListStorage(width):
				width == pair[1]
			_:
				False
	)


pure func test_classifies_declared_enum_and_value_record() -> Bool:
	program: CoreProgram = empty_program([
		EnumDecl({
			name = "Tiny",
			type_params = [],
			variants = [
				{
					name = "Zero",
					c_name = "Tiny_Zero",
					tag = 0,
					def_id = None
				},
				{
					name = "Max",
					c_name = "Tiny_Max",
					tag = 255,
					def_id = None
				},
			],
			loc = SyntheticSourceLoc,
		}),
		ValueRecordDecl({
			name = "Point",
			type_params = [],
			fields = [],
			loc = SyntheticSourceLoc,
		}),
	])
	index = build_layout_type_index(program)

	is_inline_layout(
		list_layout_for_type_with_index(index, list_type(EnumType("Tiny"))),
		1,
	) and is_inline_struct_layout(
		list_layout_for_type_with_index(index, list_type(ValueRecordType("Point"))),
		"Point",
	)


pure func test_expands_aliases() -> Bool:
	program: CoreProgram = empty_program([TypeAliasDecl({
			name = "Count",
			type_params = [],
			target = named_type("Int"),
			is_opaque = False,
			loc = SyntheticSourceLoc,
		}), TypeAliasDecl({
			name = "Bag",
			type_params = ["T"],
			target = NamedType("List", [TypeParameterType("T")]),
			is_opaque = False,
			loc = SyntheticSourceLoc,
		}), TypeAliasDecl({
			name = "CycleA",
			type_params = [],
			target = named_type("CycleB"),
			is_opaque = False,
			loc = SyntheticSourceLoc,
		}), TypeAliasDecl({
			name = "CycleB",
			type_params = [],
			target = named_type("CycleA"),
			is_opaque = False,
			loc = SyntheticSourceLoc,
		})])
	index = build_layout_type_index(program)

	is_inline_layout(
		list_layout_for_type_with_index(index, list_type(named_type("Count"))),
		8,
	) and is_inline_layout(
		list_layout_for_type_with_index(
			index,
			NamedType("Bag", [named_type("Int")]),
		),
		8,
	) and is_pointer_layout(list_layout_for_type_with_index(index, list_type(named_type("CycleA"))))


pure func test_alias_substitution_preserves_nominal_identity() -> Bool:
	program: CoreProgram = empty_program([ValueRecordDecl({
			name = "T",
			type_params = [],
			fields = [],
			loc = SyntheticSourceLoc,
		}), TypeAliasDecl({
			name = "NominalBag",
			type_params = ["T"],
			target = NamedType("List", [NamedType("T", [])]),
			is_opaque = False,
			loc = SyntheticSourceLoc,
		})])
	index = build_layout_type_index(program)

	is_inline_struct_layout(
		list_layout_for_type_with_index(
			index,
			NamedType("NominalBag", [named_type("Int")]),
		),
		"T",
	)


pure func test_resolves_aliases_across_nested_function_and_tuple_types() -> Bool:
	program: CoreProgram = empty_program([
		TypeAliasDecl({
			name = "Pair",
			type_params = ["T"],
			target = TupleType([
				TypeParameterType("T"),
				NamedType("List", [TypeParameterType("T")]),
			]),
			is_opaque = False,
			loc = SyntheticSourceLoc,
		}),
		TypeAliasDecl({
			name = "Callback",
			type_params = ["T"],
			target = FunctionType(
				True,
				[
					NamedType("Pair", [TypeParameterType("T")]),
					NamedType("Pair", [TypeParameterType("T")]),
				],
				NamedType(
					"Pair",
					[TypeParameterType("T")],
				),
			),
			is_opaque = False,
			loc = SyntheticSourceLoc,
		}),
	])
	index = build_layout_type_index(program)

	is_pointer_layout(
		list_layout_for_type_with_index(
			index,
			list_type(NamedType("Callback", [named_type("Int")])),
		),
	)


pure func test_classifies_stack_option_inline_struct() -> Bool:
	program: CoreProgram = empty_program([])
	index = build_layout_type_index(program)
	option_int: CoreType = NamedType("Option", [named_type("Int")])

	is_inline_struct_layout(
		list_layout_for_type_with_index(index, list_type(option_int)),
		"blorp_StackOption_Int",
	)


pure func test_classifies_pointer_release_policy() -> Bool:
	program: CoreProgram = empty_program([])
	index = build_layout_type_index(program)
	string_type: CoreType = named_type("String")
	int128_type: CoreType = named_type("Int128")

	(
		is_pointer_layout(list_layout_for_type_with_index(index, list_type(string_type)))
		and list_element_needs_release_with_index(index, string_type)
		and is_pointer_layout(list_layout_for_type_with_index(index, list_type(int128_type)))
		and list_element_needs_release_with_index(index, int128_type)
		and not list_element_needs_release_with_index(index, TypeParameterType("T"))
		and not list_element_needs_release_with_index(index, SelfType)
	)


pure func test_indexed_layout_queries_reuse_declaration_facts() -> Bool:
	program: CoreProgram = empty_program([TypeAliasDecl({
			name = "OwnedAlias",
			type_params = [],
			target = named_type("Owned"),
			is_opaque = False,
			loc = SyntheticSourceLoc,
		}), HeapRecordDecl({
			name = "Owned",
			type_params = [],
			fields = [],
			loc = SyntheticSourceLoc,
		})])
	index = build_layout_type_index(program)
	alias_type = named_type("OwnedAlias")

	(
		is_pointer_layout(list_layout_for_type_with_index(index, list_type(alias_type)))
		and list_element_needs_release_with_index(index, alias_type)
	)


pure func test_annotates_function_global_and_impl_bodies() -> Bool:
	int_list: CoreType = list_type(named_type("Int"))
	string_list: CoreType = list_type(named_type("String"))
	method: CoreFunction = {
		name = "method",
		source_module = None,
		type_params = [],
		params = [],
		return_type = int_list,
		body = Some(stale_list_construct(int_list)),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 3,
		loc = SyntheticSourceLoc
	}
	annotated = annotate_list_layouts(empty_program([
		function_decl("make", 1, stale_list_construct(int_list)),
		global_decl("names", 2, string_list, stale_list_alloc(string_list)),
		ImplDecl({
			trait_name = "Maker",
			for_type = named_type("Int"),
			type_params = [],
			methods = [method],
			loc = SyntheticSourceLoc,
		}),
	]))

	match annotated.decls:
		[FunctionDecl(function_info), GlobalDecl(global_info), ImplDecl(impl_info)]:
			match (function_info.body, global_info.init, impl_info.methods.get(0)):
				(Some(ListConstructExpr(function_list, _, _)), ListAllocExpr(global_list, _, _), Some(method_info)):
					match method_info.body:
						Some(ListConstructExpr(method_list, _, _)):
							(
								is_inline_layout(function_list.layout, 8)
								and not function_list.elem_needs_release
								and is_pointer_layout(global_list.layout)
								and global_list.elem_needs_release
								and is_inline_layout(method_list.layout, 8)
							)
						_:
							False
				_:
					False
		_:
			False


pure func test_defers_inline_struct_element_reboxing() -> Bool:
	record_type: CoreType = ValueRecordType("Point")
	point_list: CoreType = list_type(record_type)
	annotated = annotate_list_layouts(empty_program([ValueRecordDecl({
			name = "Point",
			type_params = [],
			fields = [],
			loc = SyntheticSourceLoc,
		}), function_decl(
			"make_points",
			4,
			stale_value_record_list_construct(point_list, record_type),
		)]))

	match annotated.decls:
		[ValueRecordDecl(_), FunctionDecl(function_info)]:
			match function_info.body:
				Some(ListConstructExpr(construct, _, _)):
					match (construct.layout, construct.elements):
						(InlineStructListStorage("Point"), [element]):
							match element.kind:
								PointerBox:
									not element.needs_release
								_:
									False
						_:
							False
				_:
					False
		_:
			False


pure func test_defers_inline_enum_element_reboxing() -> Bool:
	enum_type: CoreType = EnumType("Tiny")
	tiny_list: CoreType = list_type(enum_type)
	annotated = annotate_list_layouts(empty_program([
		EnumDecl({
			name = "Tiny",
			type_params = [],
			variants = [
				{
					name = "TinyZero",
					c_name = "Tiny_Zero",
					tag = 0,
					def_id = None
				},
			],
			loc = SyntheticSourceLoc,
		}),
		function_decl(
			"make_tiny",
			5,
			stale_enum_list_construct(tiny_list, enum_type),
		),
	]))

	match annotated.decls:
		[EnumDecl(_), FunctionDecl(function_info)]:
			match function_info.body:
				Some(ListConstructExpr(construct, _, _)):
					match (construct.layout, construct.elements):
						(InlineListStorage(1), [element]):
							match element.kind:
								PointerBox:
									not element.needs_release
								_:
									False
						_:
							False
				_:
					False
		_:
			False


pure func test_repairs_heap_record_element_release_metadata() -> Bool:
	record_type: CoreType = HeapRecordType("SourceFile")
	source_list: CoreType = list_type(record_type)
	annotated = annotate_list_layouts(empty_program([HeapRecordDecl({
			name = "SourceFile",
			type_params = [],
			fields = [],
			loc = SyntheticSourceLoc,
		}), function_decl(
			"make_sources",
			6,
			stale_heap_record_list_construct(source_list, record_type),
		)]))

	match annotated.decls:
		[HeapRecordDecl(_), FunctionDecl(function_info)]:
			match function_info.body:
				Some(ListConstructExpr(construct, _, _)):
					match (construct.layout, construct.elements):
						(PointerListStorage, [element]):
							element.needs_release and construct.elem_needs_release
						_:
							False
				_:
					False
		_:
			False


pure func test_repairs_aliased_heap_record_element_release_metadata() -> Bool:
	record_type: CoreType = HeapRecordType("SourceFile")
	alias_type: CoreType = named_type("SourceAlias")
	source_list: CoreType = list_type(alias_type)
	annotated = annotate_list_layouts(empty_program([TypeAliasDecl({
			name = "SourceAlias",
			type_params = [],
			target = named_type("SourceFile"),
			is_opaque = False,
			loc = SyntheticSourceLoc,
		}), HeapRecordDecl({
			name = "SourceFile",
			type_params = [],
			fields = [],
			loc = SyntheticSourceLoc,
		}), function_decl(
			"make_aliased_sources",
			7,
			stale_heap_record_list_construct(source_list, record_type),
		)]))

	match annotated.decls:
		[TypeAliasDecl(_), HeapRecordDecl(_), FunctionDecl(function_info)]:
			match function_info.body:
				Some(ListConstructExpr(construct, _, _)):
					match (construct.layout, construct.elements):
						(PointerListStorage, [element]):
							element.needs_release and construct.elem_needs_release
						_:
							False
				_:
					False
		_:
			False


pure func test_repairs_stack_result_element_boxing() -> Bool:
	result_type: CoreType = StackResultType(named_type("Int"), named_type("String"))
	result_list: CoreType = list_type(result_type)
	annotated: CoreProgram = annotate_list_layouts(empty_program([function_decl(
					"make_results",
					7,
					stale_stack_result_list_construct(result_list, result_type),
				)]))

	match annotated.decls:
		[FunctionDecl(function_info)]:
			match function_info.body:
				Some(ListConstructExpr(construct, _, _)):
					match (construct.layout, construct.elements):
						(PointerListStorage, [element]):
							match element.kind:
								StructBox(c_type):
									(
										c_type == "blorp_StackResult"
										and element.needs_release
										and construct.elem_needs_release
									)
								_:
									False
						_:
							False
				_:
					False
		_:
			False


pure func test_annotates_inline_struct_list_loop() -> Bool:
	option_type: CoreType = NamedType("Option", [named_type("Int")])
	options_type: CoreType = list_type(option_type)
	annotated: CoreProgram = annotate_list_layouts(empty_program([function_decl(
					"visit_options",
					8,
					stale_list_loop(options_type, option_type),
				)]))

	match annotated.decls:
		[FunctionDecl(function_info)]:
			match function_info.body:
				Some(ForListExpr(for_list, _, _)):
					is_inline_struct_layout(for_list.layout, "blorp_StackOption_Int")
				_:
					False
		_:
			False


tests: TestSuite = {
	description = "Blorp compiler Core list layout",
	tests = [
		("classifies primitive widths", test_classifies_primitive_widths),
		(
			"classifies declared enum and value record",
			test_classifies_declared_enum_and_value_record,
		),
		("expands aliases", test_expands_aliases),
		(
			"alias substitution preserves nominal identity",
			test_alias_substitution_preserves_nominal_identity,
		),
		(
			"resolves aliases across nested function and tuple types",
			test_resolves_aliases_across_nested_function_and_tuple_types,
		),
		("classifies stack option inline struct", test_classifies_stack_option_inline_struct),
		("classifies pointer release policy", test_classifies_pointer_release_policy),
		(
			"indexed layout queries reuse declaration facts",
			test_indexed_layout_queries_reuse_declaration_facts,
		),
		(
			"annotates function global and impl bodies",
			test_annotates_function_global_and_impl_bodies,
		),
		("defers inline struct element reboxing", test_defers_inline_struct_element_reboxing),
		("defers inline enum element reboxing", test_defers_inline_enum_element_reboxing),
		(
			"repairs heap record element release metadata",
			test_repairs_heap_record_element_release_metadata,
		),
		(
			"repairs aliased heap record element release metadata",
			test_repairs_aliased_heap_record_element_release_metadata,
		),
		("repairs stack result element boxing", test_repairs_stack_result_element_boxing),
		("annotates inline struct list loop", test_annotates_inline_struct_list_loop),
	]
}
