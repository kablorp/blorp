pure func int_type() -> CoreType:
	NamedType("Int", [])


pure func float_type() -> CoreType:
	NamedType("Float", [])


pure func float32_type() -> CoreType:
	NamedType("Float32", [])


pure func float16_type() -> CoreType:
	NamedType("Float16", [])


pure func int_boxed_value(value: CoreExpr) -> CoreBoxedStorageValue:
	{
		kind = PrimBox,
		value = value,
		needs_release = False,
		transfers_ownership = False
	}


pure func pointer_boxed_value(value: CoreExpr) -> CoreBoxedStorageValue:
	{
		kind = PointerBox,
		value = value,
		needs_release = True,
		transfers_ownership = False
	}


pure func string_type() -> CoreType:
	NamedType("String", [])


pure func dict_string_int_type() -> CoreType:
	NamedType(
		"Dict",
		[string_type(), int_type()],
	)


pure func vector_int_type() -> CoreType:
	NamedType("Vector", [int_type()])


pure func no_release_union_field(typ: CoreType) -> CoreUnionField:
	{
		typ = typ,
		release_policy = NoReleasePolicy
	}


pure func closure_type() -> CoreType:
	NamedType("Closure", [])


pure func bool_type() -> CoreType:
	NamedType("Bool", [])


pure func tensor_type() -> CoreType:
	TensorType({
		element_type = int_type(),
		dims = [TensorStaticDim(2)],
	})


pure func tensor_matrix_type() -> CoreType:
	TensorType({
		element_type = int_type(),
		dims = [TensorStaticDim(2), TensorStaticDim(2)],
	})


pure func range_type() -> CoreType:
	RangeType


pure func point_type() -> CoreType:
	ValueRecordType("Point")


pure func box_type() -> CoreType:
	HeapRecordType("Box")


pure func choice_type() -> CoreType:
	UnionType("Choice")


pure func raw_pointer_type() -> CoreType:
	NamedType("Ptr", [])


pure func named_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


pure func tensor_i64_literal() -> CoreExpr:
	TensorLiteralExpr(
		{
			shape = TensorVectorLength(2),
			payload = TensorRawLiteralPayload({
				raw_kind = TensorInt64Elements,
				elements = [int_literal(1), int_literal(2)],
			})
		},
		tensor_type(),
		SyntheticSourceLoc,
	)


pure func raw_vector_literal() -> CoreExpr:
	VectorExpr(
		[int_literal(1), int_literal(2)],
		vector_int_type(),
		SyntheticSourceLoc,
	)


pure func raw_detailed_tensor_vector_literal() -> CoreExpr:
	VectorExpr(
		[int_literal(1), int_literal(2)],
		tensor_type(),
		SyntheticSourceLoc,
	)


pure func raw_detailed_tensor_matrix_literal() -> CoreExpr:
	VectorExpr(
		[
			raw_detailed_tensor_vector_literal(),
			VectorExpr(
				[int_literal(3), int_literal(4)],
				tensor_type(),
				SyntheticSourceLoc,
			),
		],
		tensor_matrix_type(),
		SyntheticSourceLoc,
	)


pure func prepared_vector_literal() -> CoreExpr:
	TensorLiteralExpr(
		{
			shape = TensorVectorLength(2),
			payload = TensorRawLiteralPayload({
				raw_kind = TensorInt64Elements,
				elements = [int_literal(1), int_literal(2)],
			})
		},
