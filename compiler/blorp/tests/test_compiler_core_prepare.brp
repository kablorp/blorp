	}


pure func choice_union_decl() -> CoreUnionDecl:
	{
		name = "Choice",
		type_params = [],
		payload_storage = TypedUnionPayloadStorage,
		variants = [
			{
				name = "Picked",
				c_name = "__def_44_Picked",
				tag_c_name = "TAG_Choice_Picked",
				tag = 0,
				fields = [no_release_union_field(int_type())],
				def_id = Some(44)
			},
		],
		loc = SyntheticSourceLoc
	}


pure func program_with_body(body: CoreExpr, return_type: CoreType) -> CoreProgram:
	{
		decls = [FunctionDecl(identity_function(body, return_type))],
		foreign_includes = []
	}


pure func program_with_point_body(body: CoreExpr) -> CoreProgram:
	{
		decls = [
			ValueRecordDecl(point_record_decl()),
			FunctionDecl(identity_function(body, point_type())),
		],
		foreign_includes = []
	}


pure func program_with_choice_body(body: CoreExpr) -> CoreProgram:
	{
		decls = [
			UnionDecl(choice_union_decl()),
			FunctionDecl(identity_function(body, choice_type())),
		],
		foreign_includes = []
	}


pure func programs_equal(left: CoreProgram, right: CoreProgram) -> Bool:
	core_program_to_json(left).to_string() == core_program_to_json(right).to_string()


pure func int_literal(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), int_type(), SyntheticSourceLoc)


pure func float_literal(value: Float) -> CoreExpr:
	LiteralExpr(FloatLiteral(value), float_type(), SyntheticSourceLoc)


pure func string_literal(value: String) -> CoreExpr:
	LiteralExpr(StringLiteral(value), string_type(), SyntheticSourceLoc)


