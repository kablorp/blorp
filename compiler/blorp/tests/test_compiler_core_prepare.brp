pure func test_prepare_reboxes_inline_struct_list_after_ownership() -> Bool:
	list_type: CoreType = NamedType("List", [point_type()])
	point_value: CoreExpr = VarExpr(named_var("point"), point_type(), SyntheticSourceLoc)
	body: CoreExpr = ListConstructExpr(
		{
			layout = InlineStructListStorage("Point"),
			elements = [
				{
					kind = PointerBox,
					value = point_value,
					needs_release = False,
					transfers_ownership = False
				},
			],
			elem_needs_release = False
		},
		list_type,
		SyntheticSourceLoc,
	)
	actual: CoreProgram = prepare_program({
		decls = [
			ValueRecordDecl(point_record_decl()),
			FunctionDecl(identity_function(body, list_type)),
		],
		foreign_includes = [],
	})

	match actual.decls:
		[ValueRecordDecl(_), FunctionDecl(function_info)]:
			match function_info.body:
				Some(ListConstructExpr(construct, _, _)):
					match construct.elements:
						[element]:
							match element.kind:
								StructBox("Point"):
									not element.needs_release
								_:
									False
						_:
							False
				_:
					False
		_:
			False


pure func test_primitive_tuple_slot_type_is_narrow() -> Bool:
	(
		is_primitive_tuple_slot_type(int_type())
		and is_primitive_tuple_slot_type(bool_type())
		and is_primitive_tuple_slot_type(range_type())
		and not is_primitive_tuple_slot_type(string_type())
		and not is_primitive_tuple_slot_type(point_type())
		and not is_primitive_tuple_slot_type(int_pair_type())
	)


tests: TestSuite = {
	description = "Blorp compiler Core prepare",
	tests = [
		("prepare converts primitive tuple literal", test_prepare_converts_primitive_tuple_literal),
		(
			"prepare converts float tuple literal without release bits",
			test_prepare_converts_float_tuple_literal_without_release_bits,
		),
		(
			"prepare converts all-float tuple literal without release bits",
			test_prepare_converts_all_float_tuple_literal_without_release_bits,
		),
		(
			"prepare converts managed pointer tuple literal",
			test_prepare_converts_managed_pointer_tuple_literal,
		),
		(
			"prepare converts unmanaged pointer tuple literal",
			test_prepare_converts_unmanaged_pointer_tuple_literal,
		),
		(
			"prepare converts TestSuite pair tuple literal",
			test_prepare_converts_test_suite_pair_tuple_literal,
		),
		(
			"prepare converts nullable Option tuple literal",
			test_prepare_converts_nullable_option_tuple_literal,
		),
		(
			"prepare converts union value record tuple literal",
			test_prepare_converts_union_value_record_tuple_literal,
		),
		("prepare orders value record fields", test_prepare_orders_value_record_fields),
		(
			"prepare orders value record construct fields",
			test_prepare_orders_value_record_construct_fields,
		),
		("prepare orders heap record fields", test_prepare_orders_heap_record_fields),
		("prepare converts raw dict literal", test_prepare_converts_raw_dict_literal),
		("prepare converts raw vector literal", test_prepare_converts_raw_vector_literal),
		(
			"prepare converts detailed tensor raw vector literal",
			test_prepare_converts_detailed_tensor_raw_vector_literal,
		),
		(
			"prepare flattens detailed tensor raw matrix literal",
			test_prepare_flattens_detailed_tensor_raw_matrix_literal,
		),
		(
			"prepare leaves invalid value record fields unprepared",
			test_prepare_leaves_invalid_value_record_fields_unprepared,
		),
		("prepare recurses into call arguments", test_prepare_recurses_into_call_arguments),
		("prepare converts union constructor call", test_prepare_converts_union_constructor_call),
		("prepare converts stack Option Some call", test_prepare_converts_stack_option_some_call),
		(
			"prepare converts nullable Option union Some call",
			test_prepare_converts_nullable_option_union_some_call,
		),
		(
			"prepare boxes nested nullable Option Some call",
			test_prepare_boxes_nested_nullable_option_some_call,
		),
		(
			"prepare converts boxed Option stack Result Some call",
			test_prepare_converts_boxed_option_stack_result_some_call,
		),
		("prepare converts stack Result Ok call", test_prepare_converts_stack_result_ok_call),
		("prepare converts boxed Result Ok call", test_prepare_converts_boxed_result_ok_call),
		(
			"prepare marks raw tensor for-loop storage",
			test_prepare_marks_raw_tensor_for_loop_storage,
		),
		(
			"prepare preserves tensor row-slice loop storage",
			test_prepare_preserves_tensor_row_slice_loop_storage,
		),
		(
			"prepare removes proven tensor storage guard",
			test_prepare_removes_proven_tensor_storage_guard,
		),
		(
			"prepare reboxes inline struct list after ownership",
			test_prepare_reboxes_inline_struct_list_after_ownership,
		),
		("primitive tuple slot type is narrow", test_primitive_tuple_slot_type_is_narrow),
	]
}
