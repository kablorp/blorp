pure func tensor_for_expr(element_storage: CoreTensorForElementStorage) -> CoreExpr:
	values_var: CoreVar = named_var("values")

	ForTensorExpr(
		{
			binder = tensor_loop_binder("item"),
			element_storage = element_storage,
			iterable = VarExpr(values_var, tensor_type(), SyntheticSourceLoc),
			iterable_release_policy = NoReleasePolicy,
			body = VoidExpr(VoidType, SyntheticSourceLoc)
		},
		VoidType,
		SyntheticSourceLoc,
	)


pure func tensor_for_body(element_storage: CoreTensorForElementStorage) -> CoreExpr:
	values_var: CoreVar = named_var("values")

	LetExpr(
		values_var,
		False,
		tensor_type(),
		tensor_i64_literal(),
		tensor_for_expr(element_storage),
	)


pure func tensor_row_slice_element() -> CoreTensorForElementStorage:
	TensorForRowSliceElement({
		row_size = "2L",
		result_first_dim = "2L",
		runtime_derived = False,
	})


pure func tensor_row_slice_for_expr() -> CoreExpr:
	values_var: CoreVar = named_var("values")

	ForTensorExpr(
		{
			binder = tensor_row_loop_binder("row"),
			element_storage = tensor_row_slice_element(),
			iterable = VarExpr(values_var, tensor_type(), SyntheticSourceLoc),
			iterable_release_policy = NoReleasePolicy,
			body = VoidExpr(VoidType, SyntheticSourceLoc)
		},
		VoidType,
		SyntheticSourceLoc,
	)


pure func tensor_row_slice_for_body() -> CoreExpr:
	values_var: CoreVar = named_var("values")

	LetExpr(values_var, False, tensor_type(), tensor_i64_literal(), tensor_row_slice_for_expr())


pure func tensor_storage_guard_call(source: CoreExpr) -> CoreExpr:
	CallExpr(
		IntrinsicCall("tensor_is_i64_storage"),
		VarExpr(named_var("tensor_is_i64_storage"), closure_type(), SyntheticSourceLoc),
		[source],
		bool_type(),
		SyntheticSourceLoc,
	)


pure func tensor_guard_body() -> CoreExpr:
	values_var: CoreVar = named_var("values")
	guard_var: CoreVar = named_var("storage_ok")

	LetExpr(
		values_var,
		False,
		tensor_type(),
		tensor_i64_literal(),
		LetExpr(
			guard_var,
			False,
			bool_type(),
			tensor_storage_guard_call(VarExpr(values_var, tensor_type(), SyntheticSourceLoc)),
			IfExpr(
				VarExpr(guard_var, bool_type(), SyntheticSourceLoc),
				int_literal(1),
				int_literal(2),
				int_type(),
				SyntheticSourceLoc,
			),
		),
	)


pure func tensor_guard_body_simplified() -> CoreExpr:
	values_var: CoreVar = named_var("values")

	LetExpr(values_var, False, tensor_type(), tensor_i64_literal(), int_literal(1))


pure func test_prepare_converts_primitive_tuple_literal() -> Bool:
	actual: CoreProgram = prepare_program(
		program_with_body(
			primitive_tuple_literal(),
			int_pair_type(),
		),
	)
	expected: CoreProgram = program_with_body(prepared_primitive_tuple_literal(), int_pair_type())

	programs_equal(actual, expected)


