	)


pure func tensor_runtime_read_element() -> CoreTensorRuntimeReadElement:
	{
		value_c_type = "long",
		helper = TensorRuntimeReadI64
	}


pure func tensor_loop_binder(name: String) -> CoreLoopBinder:
	{
		variable = named_var(name),
		typ = int_type(),
		range_direction = RangeForwardOnly
	}


pure func tensor_row_loop_binder(name: String) -> CoreLoopBinder:
	{
		variable = named_var(name),
		typ = tensor_type(),
		range_direction = RangeForwardOnly
	}


