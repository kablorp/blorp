import:
	../compiler_core_json:
		CoreCallKind(UserCall),
		CoreDecl(FunctionDecl, HeapRecordDecl, UnionDecl, ValueRecordDecl),
		CoreExpr(
			CallExpr,
			ClosureCreateExpr,
			LiteralExpr,
			RecordExpr,
			RecordConstructExpr,
			TupleConstructExpr,
			TupleExpr,
			UnionConstructExpr,
			VarExpr,
		),
		CoreFunction,
		CoreFunctionKind(UserFunction),
		CoreHeapRecordDecl,
		CoreLiteral(IntLiteral, StringLiteral),
		CoreProgram,
		CoreReleasePolicy(ArcReleasePolicy, NoReleasePolicy),
		CoreSourceLoc(SyntheticSourceLoc),
		CoreTupleElement(TuplePointerElement, TuplePrimElement, TupleVoidElement),
		CoreType(HeapRecordType, NamedType, TupleType, UnionType, ValueRecordType, VoidType),
		CoreUnionDecl,
		CoreUnionRepresentation(GenericUnionRepresentation, StackOptionRepresentation),
		CoreValueRecordDecl,
		core_program_to_json,
	../compiler_core_prepare: is_primitive_tuple_slot_type, prepare_program
	test: TestSuite


pure func int_type() -> CoreType:
	NamedType("Int", [])


pure func string_type() -> CoreType:
	NamedType("String", [])


pure func closure_type() -> CoreType:
	NamedType("Closure", [])


pure func bool_type() -> CoreType:
	NamedType("Bool", [])


pure func point_type() -> CoreType:
	ValueRecordType("Point")


pure func box_type() -> CoreType:
	HeapRecordType("Box")


pure func choice_type() -> CoreType:
	UnionType("Choice")


pure func option_int_type() -> CoreType:
	NamedType("Option", [int_type()])


pure func int_pair_type() -> CoreType:
	TupleType([int_type(), int_type()])


pure func string_int_pair_type() -> CoreType:
	TupleType([string_type(), int_type()])


pure func string_closure_pair_type() -> CoreType:
	TupleType([string_type(), closure_type()])


pure func identity_function(body: CoreExpr, return_type: CoreType) -> CoreFunction:
	{
		name = "identity",
		source_module = None,
		type_params = [],
		params = [],
		return_type = return_type,
		body = Some(body),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 1,
		loc = SyntheticSourceLoc
	}


pure func point_record_decl() -> CoreValueRecordDecl:
	{
		name = "Point",
		fields = [{
				name = "x",
				typ = int_type()
			}, {
				name = "y",
				typ = int_type()
			}],
		loc = SyntheticSourceLoc
	}


pure func box_heap_record_decl() -> CoreHeapRecordDecl:
	{
		name = "Box",
		fields = [{
				name = "count",
				typ = int_type(),
				release_policy = NoReleasePolicy
			}, {
				name = "label",
				typ = string_type(),
				release_policy = ArcReleasePolicy
			}],
		loc = SyntheticSourceLoc
	}


pure func choice_union_decl() -> CoreUnionDecl:
	{
		name = "Choice",
		variants = [{
				name = "Picked",
				c_name = "__def_44_Picked",
				tag_c_name = "TAG_Choice_Picked",
				tag = 0,
				fields = [int_type()],
				def_id = Some(44)
			}],
		loc = SyntheticSourceLoc
	}


pure func program_with_body(body: CoreExpr, return_type: CoreType) -> CoreProgram:
	{decls = [FunctionDecl(identity_function(body, return_type))]}


pure func program_with_point_body(body: CoreExpr) -> CoreProgram:
	{
		decls = [
			ValueRecordDecl(point_record_decl()),
			FunctionDecl(identity_function(body, point_type())),
		],
	}


pure func program_with_choice_body(body: CoreExpr) -> CoreProgram:
	{decls = [UnionDecl(choice_union_decl()), FunctionDecl(identity_function(body, choice_type()))]}


pure func programs_equal(left: CoreProgram, right: CoreProgram) -> Bool:
	core_program_to_json(left).to_string() == core_program_to_json(right).to_string()


pure func int_literal(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), int_type(), SyntheticSourceLoc)


pure func string_literal(value: String) -> CoreExpr:
	LiteralExpr(StringLiteral(value), string_type(), SyntheticSourceLoc)


pure func primitive_tuple_literal() -> CoreExpr:
	TupleExpr(
		[int_literal(1), int_literal(2)],
		int_pair_type(),
		SyntheticSourceLoc,
	)


pure func prepared_primitive_tuple_literal() -> CoreExpr:
	TupleConstructExpr(
		{
			elements = [TuplePrimElement(int_literal(1)), TuplePrimElement(int_literal(2))],
			release_mask = 0,
			retain_mask = 0
		},
		int_pair_type(),
		SyntheticSourceLoc,
	)


pure func mixed_tuple_literal() -> CoreExpr:
	TupleExpr(
		[string_literal("name"), int_literal(2)],
		string_int_pair_type(),
		SyntheticSourceLoc,
	)


pure func prepared_mixed_tuple_literal() -> CoreExpr:
	TupleConstructExpr(
		{
			elements = [
				TuplePointerElement(string_literal("name")),
				TuplePrimElement(int_literal(2)),
			],
			release_mask = 1,
			retain_mask = 1
		},
		string_int_pair_type(),
		SyntheticSourceLoc,
	)


pure func closure_create_expr() -> CoreExpr:
	ClosureCreateExpr(
		{
			function_name = "_blorp_eta_0",
			def_id = 77,
			c_name = "__def_77__blorp_eta_0",
			static_name = "__sc___def_77__blorp_eta_0",
			captures = []
		},
		closure_type(),
		SyntheticSourceLoc,
	)


pure func test_suite_pair_tuple_literal() -> CoreExpr:
	TupleExpr(
		[string_literal("case"), closure_create_expr()],
		string_closure_pair_type(),
		SyntheticSourceLoc,
	)


pure func prepared_test_suite_pair_tuple_literal() -> CoreExpr:
	TupleConstructExpr(
		{
			elements = [
				TuplePointerElement(string_literal("case")),
				TuplePointerElement(closure_create_expr()),
			],
			release_mask = 3,
			retain_mask = 1
		},
		string_closure_pair_type(),
		SyntheticSourceLoc,
	)


pure func out_of_order_point_literal() -> CoreExpr:
	RecordExpr(
		[{
				name = "y",
				value = int_literal(2)
			}, {
				name = "x",
				value = int_literal(1)
			}],
		point_type(),
		SyntheticSourceLoc,
	)


pure func prepared_point_literal() -> CoreExpr:
	RecordConstructExpr(
		"Point",
		[{
				name = "x",
				value = int_literal(1)
			}, {
				name = "y",
				value = int_literal(2)
			}],
		point_type(),
		SyntheticSourceLoc,
	)


pure func out_of_order_box_literal() -> CoreExpr:
	RecordExpr(
		[{
				name = "label",
				value = string_literal("box")
			}, {
				name = "count",
				value = int_literal(7)
			}],
		box_type(),
		SyntheticSourceLoc,
	)


pure func prepared_box_literal() -> CoreExpr:
	RecordConstructExpr(
		"Box",
		[{
				name = "count",
				value = int_literal(7)
			}, {
				name = "label",
				value = string_literal("box")
			}],
		box_type(),
		SyntheticSourceLoc,
	)


pure func incomplete_point_literal() -> CoreExpr:
	RecordExpr(
		[{
				name = "x",
				value = int_literal(1)
			}],
		point_type(),
		SyntheticSourceLoc,
	)


pure func nested_tuple_literal() -> CoreExpr:
	CallExpr(
		UserCall(
			"consume",
			None,
		),
		VarExpr(
			{
				name = "consume",
				uniq = 0,
				def_id = None
			},
			VoidType,
			SyntheticSourceLoc,
		),
		[primitive_tuple_literal()],
		VoidType,
		SyntheticSourceLoc,
	)


pure func prepared_nested_tuple_literal() -> CoreExpr:
	CallExpr(
		UserCall(
			"consume",
			None,
		),
		VarExpr(
			{
				name = "consume",
				uniq = 0,
				def_id = None
			},
			VoidType,
			SyntheticSourceLoc,
		),
		[prepared_primitive_tuple_literal()],
		VoidType,
		SyntheticSourceLoc,
	)


pure func choice_constructor_call() -> CoreExpr:
	CallExpr(
		UserCall(
			"Picked",
			Some(44),
		),
		VarExpr(
			{
				name = "__def_44_Picked",
				uniq = 0,
				def_id = Some(44)
			},
			choice_type(),
			SyntheticSourceLoc,
		),
		[int_literal(7)],
		choice_type(),
		SyntheticSourceLoc,
	)


pure func prepared_choice_constructor() -> CoreExpr:
	UnionConstructExpr(
		{
			type_name = "Choice",
			constructor_name = "Picked",
			constructor_c_name = "__def_44_Picked",
			representation = GenericUnionRepresentation,
			args = [int_literal(7)]
		},
		choice_type(),
		SyntheticSourceLoc,
	)


pure func stack_option_some_call() -> CoreExpr:
	CallExpr(
		UserCall(
			"Some",
			None,
		),
		VarExpr(
			{
				name = "Some",
				uniq = 0,
				def_id = None
			},
			option_int_type(),
			SyntheticSourceLoc,
		),
		[int_literal(7)],
		option_int_type(),
		SyntheticSourceLoc,
	)


pure func prepared_stack_option_some() -> CoreExpr:
	UnionConstructExpr(
		{
			type_name = "Option",
			constructor_name = "Some",
			constructor_c_name = "Some",
			representation = StackOptionRepresentation({
				option_type = "blorp_StackOption_Int",
				tag = 0,
				none_value = "0L",
			}),
			args = [int_literal(7)]
		},
		option_int_type(),
		SyntheticSourceLoc,
	)


pure func test_prepare_converts_primitive_tuple_literal() -> Bool:
	actual: CoreProgram = prepare_program(
		program_with_body(
			primitive_tuple_literal(),
			int_pair_type(),
		),
	)
	expected: CoreProgram = program_with_body(prepared_primitive_tuple_literal(), int_pair_type())

	programs_equal(actual, expected)


pure func test_prepare_converts_managed_pointer_tuple_literal() -> Bool:
	actual: CoreProgram = prepare_program(
		program_with_body(
			mixed_tuple_literal(),
			string_int_pair_type(),
		),
	)
	expected: CoreProgram = program_with_body(
		prepared_mixed_tuple_literal(),
		string_int_pair_type(),
	)

	programs_equal(actual, expected)


pure func test_prepare_converts_test_suite_pair_tuple_literal() -> Bool:
	actual: CoreProgram = prepare_program(
		program_with_body(
			test_suite_pair_tuple_literal(),
			string_closure_pair_type(),
		),
	)
	expected: CoreProgram = program_with_body(
		prepared_test_suite_pair_tuple_literal(),
		string_closure_pair_type(),
	)

	programs_equal(actual, expected)


pure func test_prepare_orders_value_record_fields() -> Bool:
	actual: CoreProgram = prepare_program(program_with_point_body(out_of_order_point_literal()))
	expected: CoreProgram = program_with_point_body(prepared_point_literal())

	programs_equal(actual, expected)


pure func test_prepare_orders_heap_record_fields() -> Bool:
	actual: CoreProgram = prepare_program(
		{
			decls = [
				HeapRecordDecl(box_heap_record_decl()),
				FunctionDecl(identity_function(out_of_order_box_literal(), box_type())),
			],
		},
	)
	expected: CoreProgram = {
		decls = [
			HeapRecordDecl(box_heap_record_decl()),
			FunctionDecl(identity_function(prepared_box_literal(), box_type())),
		],
	}

	programs_equal(actual, expected)


pure func test_prepare_leaves_invalid_value_record_fields_unprepared() -> Bool:
	actual: CoreProgram = prepare_program(program_with_point_body(incomplete_point_literal()))
	expected: CoreProgram = program_with_point_body(incomplete_point_literal())

	programs_equal(actual, expected)


pure func test_prepare_recurses_into_call_arguments() -> Bool:
	actual: CoreProgram = prepare_program(program_with_body(nested_tuple_literal(), VoidType))
	expected: CoreProgram = program_with_body(prepared_nested_tuple_literal(), VoidType)

	programs_equal(actual, expected)


pure func test_prepare_converts_union_constructor_call() -> Bool:
	actual: CoreProgram = prepare_program(program_with_choice_body(choice_constructor_call()))
	expected: CoreProgram = program_with_choice_body(prepared_choice_constructor())

	programs_equal(actual, expected)


pure func test_prepare_converts_stack_option_some_call() -> Bool:
	actual: CoreProgram = prepare_program(
		program_with_body(
			stack_option_some_call(),
			option_int_type(),
		),
	)
	expected: CoreProgram = program_with_body(prepared_stack_option_some(), option_int_type())

	programs_equal(actual, expected)


pure func test_primitive_tuple_slot_type_is_narrow() -> Bool:
	(
		is_primitive_tuple_slot_type(int_type())
		and is_primitive_tuple_slot_type(bool_type())
		and not is_primitive_tuple_slot_type(string_type())
		and not is_primitive_tuple_slot_type(point_type())
		and not is_primitive_tuple_slot_type(int_pair_type())
	)


tests: TestSuite = {
	description = "Blorp compiler Core prepare",
	tests = [
		("prepare converts primitive tuple literal", test_prepare_converts_primitive_tuple_literal),
		(
			"prepare converts managed pointer tuple literal",
			test_prepare_converts_managed_pointer_tuple_literal,
		),
		(
			"prepare converts TestSuite pair tuple literal",
			test_prepare_converts_test_suite_pair_tuple_literal,
		),
		("prepare orders value record fields", test_prepare_orders_value_record_fields),
		("prepare orders heap record fields", test_prepare_orders_heap_record_fields),
		(
			"prepare leaves invalid value record fields unprepared",
			test_prepare_leaves_invalid_value_record_fields_unprepared,
		),
		("prepare recurses into call arguments", test_prepare_recurses_into_call_arguments),
		("prepare converts union constructor call", test_prepare_converts_union_constructor_call),
		("prepare converts stack Option Some call", test_prepare_converts_stack_option_some_call),
		("primitive tuple slot type is narrow", test_primitive_tuple_slot_type_is_narrow),
	]
}
