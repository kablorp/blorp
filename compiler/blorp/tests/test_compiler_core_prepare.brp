pure func int_pair_type() -> CoreType:
	TupleType([int_type(), int_type()])


pure func int_float_pair_type() -> CoreType:
	TupleType([int_type(), float_type()])


pure func float_tuple_type() -> CoreType:
	TupleType([float_type(), float32_type(), float16_type()])


pure func string_int_pair_type() -> CoreType:
	TupleType([string_type(), int_type()])


pure func raw_pointer_int_pair_type() -> CoreType:
	TupleType([raw_pointer_type(), int_type()])


pure func string_closure_pair_type() -> CoreType:
	TupleType([string_type(), closure_type()])


pure func option_string_pair_type() -> CoreType:
	TupleType([option_string_type(), option_string_type()])


pure func choice_point_pair_type() -> CoreType:
	TupleType([choice_type(), point_type()])


pure func identity_function(body: CoreExpr, return_type: CoreType) -> CoreFunction:
	{
		name = "identity",
		source_module = None,
		type_params = [],
		params = [],
		return_type = return_type,
		body = Some(body),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 1,
		loc = SyntheticSourceLoc
	}


