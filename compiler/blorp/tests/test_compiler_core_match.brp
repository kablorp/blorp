			match cases.get(0):
				Some(first_case):
					first_case.constructor == "Some"
				None:
					False
		_:
			False


pure func test_compiles_tuple_constructor_and_list_columns() -> Bool:
	result = compile_match_cases(
		collect_match_constructor_names(empty_program()),
		[raw_match_case(
				TuplePattern([
					ConstructorPattern("Some", []),
					ListPattern([NamePattern("value")], None),
				]),
				variable_expr("value", int_type()),
			), raw_match_case(WildcardPattern, int_expr(20))],
	)

	match result:
		Some(SemanticConstructorMatch(TupleFieldSemanticMatchAccessor(RootSemanticMatchAccessor, 0), cases, _)):
			match cases.get(0):
				Some(first_case):
					match first_case.body:
						SemanticLengthMatch(TupleFieldSemanticMatchAccessor(RootSemanticMatchAccessor, 1), length_cases, None, Some(_)):
							length_cases.length() == 1
						_:
							False
				None:
					False
		_:
			False


pure func test_compiles_tuple_with_two_list_columns() -> Bool:
	result = compile_match_cases(
		collect_match_constructor_names(empty_program()),
		[raw_match_case(
				TuplePattern([
					ListPattern([NamePattern("left")], None),
					ListPattern([NamePattern("right")], None),
				]),
				variable_expr("right", int_type()),
			), raw_match_case(WildcardPattern, int_expr(20))],
	)

	match result:
		Some(SemanticLengthMatch(TupleFieldSemanticMatchAccessor(RootSemanticMatchAccessor, 0), first_cases, None, Some(_))):
			match first_cases.get(0):
				Some(first_case):
					match first_case.body:
						SemanticLengthMatch(TupleFieldSemanticMatchAccessor(RootSemanticMatchAccessor, 1), second_cases, None, Some(_)):
							second_cases.length() == 1
						_:
							False
				None:
					False
		_:
			False


pure func test_preserves_list_spread_source_order() -> Bool:
	result = compile_match_cases(
		collect_match_constructor_names(empty_program()),
		[raw_match_case(
				ListPattern([NamePattern("head")], Some(NamePattern("rest"))),
				int_expr(10),
			), raw_match_case(
				ListPattern([NamePattern("only")], None),
				int_expr(20),
			), raw_match_case(WildcardPattern, int_expr(30))],
	)

	match result:
		Some(SemanticLengthMatch(RootSemanticMatchAccessor, exact_cases, geq, fallback)):
			exact_cases.is_empty() and fallback.is_some() and match geq:
				Some(found):
					found.minimum_length == 1
				None:
					False
		_:
			False


pure func test_compiles_list_literal_elements() -> Bool:
	result = compile_match_cases(
		collect_match_constructor_names(empty_program()),
		[raw_match_case(
				ListPattern([LiteralPattern(IntLiteral(1))], None),
				int_expr(10),
			), raw_match_case(
				ListPattern([LiteralPattern(IntLiteral(2))], None),
				int_expr(20),
			), raw_match_case(WildcardPattern, int_expr(30))],
	)

	match result:
		Some(SemanticLengthMatch(RootSemanticMatchAccessor, cases, None, Some(_))):
			match cases.get(0):
				Some(length_case):
					length_case.length == 1 and match length_case.body:
						SemanticLiteralMatch(ListElementSemanticMatchAccessor(RootSemanticMatchAccessor, 0), _, _):
							True
						_:
							False
				None:
					False
		_:
			False


pure func test_compiles_list_constructor_elements() -> Bool:
	result = compile_match_cases(
		collect_match_constructor_names(empty_program()),
		[raw_match_case(
				ListPattern([ConstructorPattern("Some", [NamePattern("value")])], None),
				int_expr(10),
			), raw_match_case(WildcardPattern, int_expr(20))],
	)

	match result:
		Some(SemanticLengthMatch(_, cases, None, Some(_))):
			match cases.get(0):
				Some(length_case):
					match length_case.body:
						SemanticConstructorMatch(ListElementSemanticMatchAccessor(RootSemanticMatchAccessor, 0), constructor_cases, _):
							constructor_cases.length() == 1
						_:
							False
				None:
					False
		_:
			False


pure func test_compiles_list_tuple_elements() -> Bool:
	result = compile_match_cases(
		collect_match_constructor_names(empty_program()),
		[raw_match_case(
				ListPattern(
					[TuplePattern([NamePattern("key"), NamePattern("value")])],
					Some(NamePattern("rest")),
				),
				variable_expr("value", int_type()),
			), raw_match_case(WildcardPattern, int_expr(20))],
	)

	match result:
		Some(SemanticLengthMatch(_, _, Some(geq), Some(_))):
			match geq.body:
				SemanticMatchLeaf(bindings, _):
					var found: Bool = False

					for binding in bindings:
						if binding.variable.name == "value":
							match binding.accessor:
								TupleFieldSemanticMatchAccessor(ListElementSemanticMatchAccessor(RootSemanticMatchAccessor, 0), 1):
									found = True
									break
								_:
									void

					found
				_:
					False
		_:
			False


pure func test_omits_unused_list_spread_binding() -> Bool:
	result = compile_match_cases(collect_match_constructor_names(empty_program()), [raw_match_case(
				ListPattern([NamePattern("head")], Some(NamePattern("rest"))),
				int_expr(10),
			)])

	match result:
		Some(tree):
			not tree_has_list_spread_binding(tree, "rest")
		None:
			False


pure func test_preserves_used_list_spread_binding() -> Bool:
	result = compile_match_cases(collect_match_constructor_names(empty_program()), [raw_match_case(
				ListPattern([NamePattern("head")], Some(NamePattern("rest"))),
				variable_expr("rest", list_int_type()),
			)])

	match result:
		Some(tree):
			tree_has_list_spread_binding(tree, "rest")
		None:
			False


pure func test_omits_list_spread_shadowed_by_let_body() -> Bool:
	shadowed_body: CoreExpr = LetExpr(
		core_var("rest"),
		False,
		list_int_type(),
		variable_expr("replacement", list_int_type()),
		variable_expr("rest", list_int_type()),
	)
	result = compile_match_cases(collect_match_constructor_names(empty_program()), [raw_match_case(
				ListPattern([NamePattern("head")], Some(NamePattern("rest"))),
				shadowed_body,
			)])

	match result:
		Some(tree):
			not tree_has_list_spread_binding(tree, "rest")
		None:
			False


pure func test_preserves_list_spread_used_by_let_rhs() -> Bool:
	outer_use: CoreExpr = LetExpr(
		core_var("rest"),
		False,
		list_int_type(),
		variable_expr("rest", list_int_type()),
		int_expr(10),
	)
	result = compile_match_cases(collect_match_constructor_names(empty_program()), [raw_match_case(
				ListPattern([NamePattern("head")], Some(NamePattern("rest"))),
				outer_use,
			)])

	match result:
		Some(tree):
			tree_has_list_spread_binding(tree, "rest")
		None:
			False


pure func test_compiles_constructor_wrapped_list_pattern() -> Bool:
	result = compile_match_cases(
		collect_match_constructor_names(empty_program()),
		[raw_match_case(
				ConstructorPattern(
					"Some",
					[ListPattern([NamePattern("head")], Some(NamePattern("rest")))],
				),
				variable_expr("head", int_type()),
			), raw_match_case(
				ConstructorPattern("Some", [ListPattern([], None)]),
				int_expr(20),
			), raw_match_case(
				ConstructorPattern("None", []),
				int_expr(30),
			), raw_match_case(WildcardPattern, int_expr(40))],
	)

	match result:
		Some(SemanticConstructorMatch(_, cases, Some(_))):
			match cases.get(0):
				Some(first_case):
					match first_case.body:
						SemanticLengthMatch(VariantFieldSemanticMatchAccessor(RootSemanticMatchAccessor, "Some", 0), _, _, _):
							True
						_:
							False
				None:
					False
		_:
			False


pure func test_program_compiles_nested_matches_bottom_up() -> Bool:
	inner_match = RawMatchExpr(
		variable_expr(
			"inner",
			int_type(),
		),
		[
			raw_match_case(LiteralPattern(IntLiteral(1)), int_expr(10)),
			raw_match_case(WildcardPattern, int_expr(20)),
		],
		int_type(),
		SyntheticSourceLoc,
	)
	outer_match = RawMatchExpr(
		variable_expr(
			"outer",
			int_type(),
		),
		[
			raw_match_case(LiteralPattern(IntLiteral(0)), inner_match),
			raw_match_case(WildcardPattern, int_expr(30)),
		],
		int_type(),
		SyntheticSourceLoc,
	)
	body = first_function_body(compile_program(program_with_body(outer_match)))

	match body:
		Some(SemanticMatchExpr(_, SemanticLiteralMatch(_, cases, _), _, _)):
			match cases.get(0):
				Some(first_case):
					match first_case.body:
						SemanticMatchLeaf(_, SemanticMatchExpr(_, SemanticLiteralMatch(_, _, _), _, _)):
							True
						_:
							False
				None:
					False
		_:
			False


pure func test_program_normalizes_before_direct_constructor_fusion() -> Bool:
	raw_match = RawMatchExpr(
		constructor_call(
			"None",
			[],
		),
		[
			raw_match_case(NamePattern("None"), int_expr(7)),
			raw_match_case(WildcardPattern, int_expr(9)),
		],
		int_type(),
		SyntheticSourceLoc,
	)

	match first_function_body(compile_program(program_with_body(raw_match))):
		Some(LiteralExpr(IntLiteral(7), _, _)):
			True
		_:
			False


tests: TestSuite = {
	description = "Blorp compiler Core match",
	tests = [
		("normalizes nested builtin constructors", test_normalizes_nested_builtin_constructors),
		("fuses direct constructor binding", test_fuses_direct_constructor_binding),
		(
			"fuses direct constructor wildcard fallback",
			test_fuses_direct_constructor_wildcard_fallback,
		),
		(
			"non-simple matching constructor blocks fusion",
			test_non_simple_matching_constructor_blocks_fusion,
		),
		("expands or-pattern before direct fusion", test_expands_or_pattern_before_direct_fusion),
		("does not fuse non-constructor call", test_does_not_fuse_non_constructor_call),
		("compiles catchall binding leaf", test_compiles_catchall_binding_leaf),
		("compiles literal switch with fallback", test_compiles_literal_switch_with_fallback),
		("compiles flat constructor switch", test_compiles_flat_constructor_switch),
		("compiles constructor literal payload", test_compiles_constructor_literal_payload),
		("compiles nested constructor payload", test_compiles_nested_constructor_payload),
		(
			"constructor payload catchall shadows later cases",
			test_constructor_payload_catchall_shadows_later_cases,
		),
		("compiles constructor tuple payload", test_compiles_constructor_tuple_payload),
		("compiles simple tuple bindings", test_compiles_simple_tuple_bindings),
		("compiles tuple literal columns", test_compiles_tuple_literal_columns),
		("compiles tuple constructor columns", test_compiles_tuple_constructor_columns),
		(
			"compiles tuple constructor and list columns",
			test_compiles_tuple_constructor_and_list_columns,
		),
		("compiles tuple with two list columns", test_compiles_tuple_with_two_list_columns),
		("preserves list spread source order", test_preserves_list_spread_source_order),
		("compiles list literal elements", test_compiles_list_literal_elements),
		("compiles list constructor elements", test_compiles_list_constructor_elements),
		("compiles list tuple elements", test_compiles_list_tuple_elements),
		("omits unused list spread binding", test_omits_unused_list_spread_binding),
		("preserves used list spread binding", test_preserves_used_list_spread_binding),
		("omits list spread shadowed by let body", test_omits_list_spread_shadowed_by_let_body),
		("preserves list spread used by let rhs", test_preserves_list_spread_used_by_let_rhs),
		(
			"compiles constructor wrapped list pattern",
			test_compiles_constructor_wrapped_list_pattern,
		),
		(
			"program compiles nested matches bottom up",
			test_program_compiles_nested_matches_bottom_up,
		),
		(
			"program normalizes before direct constructor fusion",
			test_program_normalizes_before_direct_constructor_fusion,
		),
	]
}
