			test_rejected_open_session_ignores_sync_until_close,
		),
		("pending open queues document events", test_pending_open_queues_document_events),
		("pending open drains document events", test_pending_open_drains_document_events),
		("pending open returns server busy", test_pending_open_returns_server_busy),
		("pending save serializes close", test_pending_save_serializes_close),
