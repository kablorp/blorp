	opened ?= resolve_requested_open(open_requested, document)
	save_event ?= client_event(DID_SAVE_VALID_BODY)
	save_requested ?= apply_server_event(opened.state, save_event).to_option()
	save_token ?= first_save_effect_token(save_requested)
	refreshed ?= apply_server_event(
		save_requested.state,
		ServerSavedSourceUpdated(
			save_token,
			{
				uri = document_uri("file:///workspace/main.brp"),
				layer = discovered_source_layer(
					source_file("/workspace/main.brp", "main", "VALUE = 30\n"),
					DiskSource,
				)
			},
		),
	).to_option()
	document ?= server_find_document(refreshed.state, document_uri("file:///workspace/main.brp"))

	Some(
		(
			has_save_refresh(save_requested)
			and save_requested.effects.length() == 1
			and document.document.text == "VALUE = 10\n"
		),
	)


pure func test_save_refresh_is_effectful_and_preserves_overlay() -> Bool:
