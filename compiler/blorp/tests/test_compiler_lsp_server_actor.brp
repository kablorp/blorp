private pure func discovered_source() -> LspDiscoveredSourceSnapshot:
	{
		uri = lsp_document_uri("file:///workspace/main.brp"),
		layer = lsp_discovered_source_layer(
			compiler_source_file("/workspace/main.brp", "main", "VALUE = 1\n"),
			LspDiskSource,
		)
	}


private pure func configuration() -> LspWorkspaceConfiguration:
	{
		workspace_roots = [
			{
				client_uri = lsp_document_uri("file:///workspace"),
				client_path = "/workspace",
				canonical_path = "/workspace"
			},
		],
		std_provider = CompilerProjectFilesystemStd("std"),
		source_packages = [],
		native_package_roots = []
	}


private INITIALIZE_BODY: String =
	|{"jsonrpc":"2.0","id":7,"method":"initialize","params":{"processId":31,"capabilities":{}}}

private INITIALIZED_BODY: String =
	|{"jsonrpc":"2.0","method":"initialized","params":{}}

private DUPLICATE_INITIALIZE_BODY: String =
	|{"jsonrpc":"2.0","id":8,"method":"initialize","params":{"processId":31,"capabilities":{}}}

private HOVER_BODY: String =
	|{"jsonrpc":"2.0","id":9,"method":"textDocument/hover","params":{}}

private DID_OPEN_BODY: String =
	|{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{}}

private VALID_DID_OPEN_BODY: String =
	|{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///workspace/main.brp","languageId":"blorp","version":1,"text":"VALUE = 10\n"}}}

private DID_CHANGE_VERSION_TWO_BODY: String =
	|{"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"file:///workspace/main.brp","version":2},"contentChanges":[{"text":"VALUE = 20\n"}]}}

private DID_CHANGE_VERSION_THREE_BODY: String =
	|{"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"file:///workspace/main.brp","version":3},"contentChanges":[{"text":"VALUE = 30\n"}]}}

private DID_CHANGE_STALE_BODY: String =
	|{"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"file:///workspace/main.brp","version":1},"contentChanges":[{"text":"STALE\n"}]}}

private DID_SAVE_VALID_BODY: String =
	|{"jsonrpc":"2.0","method":"textDocument/didSave","params":{"textDocument":{"uri":"file:///workspace/main.brp"}}}

private DID_CLOSE_VALID_BODY: String =
	|{"jsonrpc":"2.0","method":"textDocument/didClose","params":{"textDocument":{"uri":"file:///workspace/main.brp"}}}

private EXIT_BODY: String =
	|{"jsonrpc":"2.0","method":"exit","params":null}

private SHUTDOWN_BODY: String =
	|{"jsonrpc":"2.0","id":10,"method":"shutdown","params":null}


private pure func running_server_state(workspace: LspWorkspace) -> Option[LspNativeServerState]:
	ready ?= awaiting_initialized_server_state(workspace)
	initialized ?= client_event(INITIALIZED_BODY)
	running ?= lsp_apply_server_event(ready, initialized).to_option()
	Some(running.state)


private pure func awaiting_initialized_server_state(
	workspace: LspWorkspace,
) -> Option[LspNativeServerState]:
	initialize ?= client_event(INITIALIZE_BODY)
	loading ?= lsp_apply_server_event(
		lsp_initial_server_state(source_load_environment()),
		initialize,
	).to_option()
	load_token ?= first_load_token(loading)
	ready ?= lsp_apply_server_event(
		loading.state,
		LspServerSourceLoadSucceeded(load_token, workspace, []),
	).to_option()
	Some(ready.state)


private pure func source_load_environment() -> LspSourceLoadEnvironment:
	{
		working_directory = "/workspace",
		std_override = None,
		package_cache_root = "/cache",
		policy = lsp_default_source_discovery_policy()
	}


private pure func first_analysis_request(
	transition: LspServerActorTransition,
) -> Option[LspCompilerAnalysisRequest]:
	match transition.effects.get(0):
		Some(LspStartAnalysis(request)):
			Some(request)
		_:
			None


private pure func has_cancellation_effect(
	transition: LspServerActorTransition,
	token_value: Int,
) -> Bool:
	transition.effects.any(func(effect):
		match effect:
			LspCancelAnalysis(token):
				lsp_cancellation_token_value(token) == token_value
			_:
				False
	)


private pure func has_completion_rejection(transition: LspServerActorTransition) -> Bool:
	transition.effects.any(func(effect):
		match effect:
			LspAnalysisCompletionRejected(LspAnalysisCompletionMissingTarget(_)):
				True
			_:
				False
	)


private pure func latest_wins_case() -> Option[Bool]:
	source = discovered_source()
	workspace ?= lsp_workspace(configuration(), [source]).to_option()
	initial ?= running_server_state(workspace)
	open_event ?= client_event(VALID_DID_OPEN_BODY)
	open_requested ?= lsp_apply_server_event(initial, open_event).to_option()
	document ?= valid_open_document()
	opened ?= resolve_requested_open(open_requested, document)
	revision_one_request ?= first_analysis_request(opened)
	revision_one_completion: LspAnalysisCompletion = {
		scheduled = {
			token = revision_one_request.cancellation_token,
			plan = revision_one_request.plan
		},
		result = Err(LspAnalysisWorkerFailed("stale worker failure"))
	}

	change_event ?= client_event(DID_CHANGE_VERSION_TWO_BODY)
	changed ?= lsp_apply_server_event(opened.state, change_event).to_option()
	newest_change_event ?= client_event(DID_CHANGE_VERSION_THREE_BODY)
	newest ?= lsp_apply_server_event(changed.state, newest_change_event).to_option()

	if (
		not has_cancellation_effect(
			changed,
			lsp_cancellation_token_value(revision_one_request.cancellation_token),
		)
		or not newest.effects.is_empty()
		or lsp_server_pending_analysis(newest.state).is_none()
	):
		None
	else:
		completed ?= lsp_apply_server_event(
			newest.state,
			LspServerAnalysisCompleted(revision_one_completion),
		).to_option()
		replacement ?= first_analysis_request(completed)
		active ?= lsp_server_active_analysis(completed.state)

		Some(
			(
				completed.effects.length() == 1
				and lsp_cancellation_token_value(
					replacement.cancellation_token,
				) == lsp_cancellation_token_value(active.token)
				and lsp_workspace_revision_value(replacement.plan.workspace_revision) == 3
				and lsp_server_pending_analysis(completed.state).is_none()
			),
		)


pure func test_stale_completion_starts_only_newest_replacement() -> Bool:
	latest_wins_case().get_or(False)


private pure func ready_state_starts_idle_case() -> Option[Bool]:
	source = discovered_source()
	workspace ?= lsp_workspace(configuration(), [source]).to_option()
	state ?= running_server_state(workspace)
	Some(
		(
			lsp_server_active_analysis(state).is_none()
			and lsp_server_pending_analysis(state).is_none()
		),
	)


pure func test_ready_state_starts_idle() -> Bool:
	ready_state_starts_idle_case().get_or(False)


pure func test_cancellation_failure_releases_payload() -> Bool:
	failure = LspAnalysisWaveCancelled(lsp_cancellation_token(0))

	match failure:
		LspAnalysisWaveCancelled(token):
			lsp_cancellation_token_value(token) == 0
		_:
			False


private pure func opening_starts_analysis_case() -> Option[Bool]:
	source = discovered_source()
	workspace ?= lsp_workspace(configuration(), [source]).to_option()
	state ?= running_server_state(workspace)
	open_event ?= client_event(VALID_DID_OPEN_BODY)
	open_requested ?= lsp_apply_server_event(state, open_event).to_option()
	document ?= valid_open_document()
	opened ?= resolve_requested_open(open_requested, document)

	Some(
		(
			opened.effects.length() == 1
			and lsp_server_active_analysis(opened.state).is_some()
			and lsp_server_pending_analysis(opened.state).is_none()
		),
	)


pure func test_opening_starts_analysis() -> Bool:
	opening_starts_analysis_case().get_or(False)


private pure func shutdown_retires_analysis_case() -> Option[Bool]:
	source = discovered_source()
	workspace ?= lsp_workspace(configuration(), [source]).to_option()
	state ?= running_server_state(workspace)
	open_event ?= client_event(VALID_DID_OPEN_BODY)
	open_requested ?= lsp_apply_server_event(state, open_event).to_option()
	document ?= valid_open_document()
	opened ?= resolve_requested_open(open_requested, document)
	request ?= first_analysis_request(opened)
	shutdown ?= client_event(SHUTDOWN_BODY)
	shutting_down ?= lsp_apply_server_event(opened.state, shutdown).to_option()
	completion: LspAnalysisCompletion = {
		scheduled = {
			token = request.cancellation_token,
			plan = request.plan
		},
		result = Err(LspAnalysisWorkerFailed("late completion"))
	}
	late ?= lsp_apply_server_event(
		shutting_down.state,
		LspServerAnalysisCompleted(completion),
	).to_option()

	Some(
		(
			first_sent_message(shutting_down).is_some()
			and has_cancellation_effect(
				shutting_down,
				lsp_cancellation_token_value(request.cancellation_token),
			)
			and lsp_server_active_analysis(shutting_down.state).is_none()
			and lsp_server_pending_analysis(shutting_down.state).is_none()
			and late.effects.is_empty()
			and lsp_server_active_analysis(late.state).is_none()
		),
	)


pure func test_shutdown_retires_analysis_and_ignores_late_completion() -> Bool:
	shutdown_retires_analysis_case().get_or(False)


private pure func change_queues_replacement_case() -> Option[Bool]:
	source = discovered_source()
	workspace ?= lsp_workspace(configuration(), [source]).to_option()
	state ?= running_server_state(workspace)
	open_event ?= client_event(VALID_DID_OPEN_BODY)
	open_requested ?= lsp_apply_server_event(state, open_event).to_option()
	document ?= valid_open_document()
	opened ?= resolve_requested_open(open_requested, document)
	change_event ?= client_event(DID_CHANGE_VERSION_TWO_BODY)
	changed ?= lsp_apply_server_event(opened.state, change_event).to_option()

	Some(
		(
			changed.effects.length() == 1
			and has_cancellation_effect(changed, 0)
			and lsp_server_active_analysis(changed.state).is_some()
			and lsp_server_pending_analysis(changed.state).is_some()
		),
	)


pure func test_change_queues_replacement() -> Bool:
	change_queues_replacement_case().get_or(False)


private pure func rejected_completion_retires_active_case() -> Option[Bool]:
	source = discovered_source()
	workspace ?= lsp_workspace(configuration(), [source]).to_option()
	state ?= running_server_state(workspace)
	open_event ?= client_event(VALID_DID_OPEN_BODY)
	open_requested ?= lsp_apply_server_event(state, open_event).to_option()
	document ?= valid_open_document()
	opened ?= resolve_requested_open(open_requested, document)
	request ?= first_analysis_request(opened)
	malformed: LspAnalysisCompletion = {
		scheduled = {
			token = request.cancellation_token,
			plan = { request.plan | targets = [] }
		},
		result = Ok({
			workspace_revision = request.plan.workspace_revision,
			dependencies = lsp_dependency_store(),
			outcomes = [],
		})
	}
	rejected ?= lsp_apply_server_event(
		opened.state,
		LspServerAnalysisCompleted(malformed),
	).to_option()

	change_event ?= client_event(DID_CHANGE_VERSION_TWO_BODY)
	recovered ?= lsp_apply_server_event(rejected.state, change_event).to_option()

	Some(
		(
			has_completion_rejection(rejected)
			and lsp_server_active_analysis(rejected.state).is_none()
			and first_analysis_request(recovered).is_some()
			and lsp_server_active_analysis(recovered.state).is_some()
		),
	)


pure func test_rejected_completion_retires_active_analysis() -> Bool:
	rejected_completion_retires_active_case().get_or(False)


private pure func client_event(body: String) -> Option[LspServerEvent]:
	envelope ?= decode_lsp_json_rpc_body(body).to_option()
	Some(LspServerClientEnvelope(envelope))


private pure func first_sent_message(transition: LspServerActorTransition) -> Option[String]:
	effect ?= transition.effects.find(func(candidate):
		match candidate:
			LspSendMessage(_):
				True
			_:
				False
	)

	match effect:
		LspSendMessage(body):
			Some(body)
		_:
			None


private pure func first_load_token(
	transition: LspServerActorTransition,
) -> Option[LspSourceLoadToken]:
	effect ?= transition.effects.find(func(candidate):
		match candidate:
			LspLoadWorkspace(_, _):
				True
			_:
				False
	)

	match effect:
		LspLoadWorkspace(token, _):
			Some(token)
		_:
			None


private pure func first_load_effect(transition: LspServerActorTransition) -> Bool:
	first_load_token(transition).is_some()


private pure func first_open_effect_token(
	transition: LspServerActorTransition,
) -> Option[LspDocumentEffectToken]:
	effect ?= transition.effects.find(func(candidate):
		match candidate:
			LspResolveOpenDocument(_, _):
				True
			_:
				False
	)

	match effect:
		LspResolveOpenDocument(token, _):
			Some(token)
		_:
			None


private pure func has_open_resolution(transition: LspServerActorTransition) -> Bool:
	first_open_effect_token(transition).is_some()


private pure func first_save_effect_token(
	transition: LspServerActorTransition,
) -> Option[LspDocumentEffectToken]:
	effect ?= transition.effects.find(func(candidate):
		match candidate:
			LspRefreshSavedSource(_, _):
				True
			_:
				False
	)

	match effect:
		LspRefreshSavedSource(token, _):
			Some(token)
		_:
			None


private pure func has_save_refresh(transition: LspServerActorTransition) -> Bool:
	first_save_effect_token(transition).is_some()


private pure func has_document_sync_issue(transition: LspServerActorTransition) -> Bool:
	transition.effects.any(func(effect):
		match effect:
			LspReportDocumentSyncIssue(_):
				True
			_:
				False
	)


private pure func has_diagnostic_clear(transition: LspServerActorTransition) -> Bool:
	transition.effects.any(func(effect):
		match effect:
			LspClearDiagnostics(_):
				True
			_:
				False
	)


private pure func resolve_requested_open(
	transition: LspServerActorTransition,
	document: LspOpenedDocument,
) -> Option[LspServerActorTransition]:
	token ?= first_open_effect_token(transition)
	lsp_apply_server_event(
		transition.state,
		resolved_open_event(token, document),
	).to_option()


private pure func resolved_open_event(
	token: LspDocumentEffectToken,
	document: LspOpenedDocument,
) -> LspServerEvent:
	resolved: LspResolvedDocumentOpen = {
		document = document,
		source = compiler_source_file("/workspace/main.brp", "main", document.document.text),
		provenance = LspDiskSource
	}
	LspServerDocumentOpenResolved(token, resolved)


private pure func saved_source(text: String) -> LspDiscoveredSourceSnapshot:
	{
		uri = lsp_document_uri("file:///workspace/main.brp"),
		layer = lsp_discovered_source_layer(
			compiler_source_file("/workspace/main.brp", "main", text),
			LspDiskSource,
		)
	}


private pure func valid_open_document() -> Option[LspOpenedDocument]:
	version ?= lsp_document_version(1)
	Some({
		document = {
			uri = lsp_document_uri("file:///workspace/main.brp"),
			version = version,
			text = "VALUE = 10\n"
		},
		language_id = "blorp",
	})


private pure func canonical_document_routing_case() -> Option[Bool]:
	workspace ?= lsp_workspace(configuration(), [discovered_source()]).to_option()
	state ?= running_server_state(workspace)
	open_event ?= client_event(VALID_DID_OPEN_BODY)
	open_requested ?= lsp_apply_server_event(state, open_event).to_option()
	actor_configuration ?= lsp_server_workspace_configuration(open_requested.state)
	document ?= valid_open_document()
	opened ?= resolve_requested_open(open_requested, document)
	opened_document ?= lsp_server_find_document(
		opened.state,
		lsp_document_uri("file:///workspace/main.brp"),
	)
	duplicate ?= lsp_apply_server_event(opened.state, open_event).to_option()
	change_event ?= client_event(DID_CHANGE_VERSION_TWO_BODY)
	changed ?= lsp_apply_server_event(duplicate.state, change_event).to_option()
	changed_document ?= lsp_server_find_document(
		changed.state,
		lsp_document_uri("file:///workspace/main.brp"),
	)
	stale_event ?= client_event(DID_CHANGE_STALE_BODY)
	stale ?= lsp_apply_server_event(changed.state, stale_event).to_option()
	stale_document ?= lsp_server_find_document(
		stale.state,
		lsp_document_uri("file:///workspace/main.brp"),
	)
	close_event ?= client_event(DID_CLOSE_VALID_BODY)
	closed ?= lsp_apply_server_event(stale.state, close_event).to_option()

	Some(
		(
			has_open_resolution(open_requested)
			and open_requested.effects.length() == 1
			and actor_configuration.workspace_roots.length() == 1
			and first_analysis_request(opened).is_some()
			and opened_document.document.text == "VALUE = 10\n"
			and duplicate.effects.is_empty()
			and changed_document.document.text == "VALUE = 20\n"
			and stale.effects.is_empty()
			and stale_document.document.text == "VALUE = 20\n"
			and has_diagnostic_clear(closed)
			and lsp_server_find_document(
				closed.state,
				lsp_document_uri("file:///workspace/main.brp"),
			).is_none()
		),
	)


pure func test_document_notifications_route_through_canonical_workspace() -> Bool:
	canonical_document_routing_case().get_or(False)


private pure func save_refresh_routing_case() -> Option[Bool]:
	workspace ?= lsp_workspace(configuration(), [discovered_source()]).to_option()
	state ?= running_server_state(workspace)
	open_event ?= client_event(VALID_DID_OPEN_BODY)
	open_requested ?= lsp_apply_server_event(state, open_event).to_option()
	document ?= valid_open_document()
	opened ?= resolve_requested_open(open_requested, document)
	save_event ?= client_event(DID_SAVE_VALID_BODY)
	save_requested ?= lsp_apply_server_event(opened.state, save_event).to_option()
	save_token ?= first_save_effect_token(save_requested)
	refreshed ?= lsp_apply_server_event(
		save_requested.state,
		LspServerSavedSourceUpdated(
			save_token,
			{
				uri = lsp_document_uri("file:///workspace/main.brp"),
				layer = lsp_discovered_source_layer(
					compiler_source_file("/workspace/main.brp", "main", "VALUE = 30\n"),
					LspDiskSource,
				)
			},
		),
	).to_option()
	document ?= lsp_server_find_document(
		refreshed.state,
		lsp_document_uri("file:///workspace/main.brp"),
	)

	Some(
		(
			has_save_refresh(save_requested)
			and save_requested.effects.length() == 1
			and document.document.text == "VALUE = 10\n"
		),
	)


pure func test_save_refresh_is_effectful_and_preserves_overlay() -> Bool:
	save_refresh_routing_case().get_or(False)


private pure func rejected_open_session_case() -> Option[Bool]:
	uri = lsp_document_uri("file:///workspace/main.brp")
	workspace ?= lsp_workspace(configuration(), [discovered_source()]).to_option()
	state ?= running_server_state(workspace)
	open_event ?= client_event(VALID_DID_OPEN_BODY)
	first_request ?= lsp_apply_server_event(state, open_event).to_option()
	open_token ?= first_open_effect_token(first_request)
	rejected ?= lsp_apply_server_event(
		first_request.state,
		LspServerDocumentOpenResolutionFailed(open_token, uri, LspOpenSourceOutsideCatalog(uri)),
	).to_option()
	duplicate ?= lsp_apply_server_event(rejected.state, open_event).to_option()
	change_event ?= client_event(DID_CHANGE_VERSION_TWO_BODY)
	ignored_change ?= lsp_apply_server_event(duplicate.state, change_event).to_option()
	close_event ?= client_event(DID_CLOSE_VALID_BODY)
	closed ?= lsp_apply_server_event(ignored_change.state, close_event).to_option()
	reopened ?= lsp_apply_server_event(closed.state, open_event).to_option()

	Some(
		(
			has_document_sync_issue(rejected)
			and duplicate.effects.is_empty()
			and ignored_change.effects.is_empty()
			and closed.effects.is_empty()
			and has_open_resolution(reopened)
		),
	)


pure func test_rejected_open_session_ignores_sync_until_close() -> Bool:
	rejected_open_session_case().get_or(False)


private pure func event_is_rejected_while_document_effect_pending(
	state: LspNativeServerState,
	event: LspServerEvent,
) -> Bool:
	match lsp_apply_server_event(state, event):
		Err(LspServerDocumentEffectPending):
			True
		_:
			False


private pure func pending_open_serializes_document_events_case() -> Option[Bool]:
	workspace ?= lsp_workspace(configuration(), [discovered_source()]).to_option()
	state ?= running_server_state(workspace)
	open_event ?= client_event(VALID_DID_OPEN_BODY)
	open_requested ?= lsp_apply_server_event(state, open_event).to_option()
	change_event ?= client_event(DID_CHANGE_VERSION_TWO_BODY)
	save_event ?= client_event(DID_SAVE_VALID_BODY)
	close_event ?= client_event(DID_CLOSE_VALID_BODY)

	Some(
		(
			event_is_rejected_while_document_effect_pending(open_requested.state, change_event)
			and event_is_rejected_while_document_effect_pending(open_requested.state, save_event)
			and event_is_rejected_while_document_effect_pending(open_requested.state, close_event)
		),
	)


pure func test_pending_open_serializes_document_events() -> Bool:
	pending_open_serializes_document_events_case().get_or(False)


private pure func pending_save_serializes_close_case() -> Option[Bool]:
	workspace ?= lsp_workspace(configuration(), [discovered_source()]).to_option()
	state ?= running_server_state(workspace)
	open_event ?= client_event(VALID_DID_OPEN_BODY)
	open_requested ?= lsp_apply_server_event(state, open_event).to_option()
	document ?= valid_open_document()
	opened ?= resolve_requested_open(open_requested, document)
	save_event ?= client_event(DID_SAVE_VALID_BODY)
	save_requested ?= lsp_apply_server_event(opened.state, save_event).to_option()
	close_event ?= client_event(DID_CLOSE_VALID_BODY)

	Some(
		(
			has_save_refresh(save_requested)
			and event_is_rejected_while_document_effect_pending(save_requested.state, close_event)
		),
	)


pure func test_pending_save_serializes_close() -> Bool:
	pending_save_serializes_close_case().get_or(False)


private pure func pending_document_effect_allows_lifecycle_case() -> Option[Bool]:
	uri = lsp_document_uri("file:///workspace/main.brp")
	workspace ?= lsp_workspace(configuration(), [discovered_source()]).to_option()
	state ?= running_server_state(workspace)
	open_event ?= client_event(VALID_DID_OPEN_BODY)
	open_requested ?= lsp_apply_server_event(state, open_event).to_option()
	open_token ?= first_open_effect_token(open_requested)
	document ?= valid_open_document()
	shutdown_event ?= client_event(SHUTDOWN_BODY)
	shut_down ?= lsp_apply_server_event(open_requested.state, shutdown_event).to_option()
	stale ?= lsp_apply_server_event(
		shut_down.state,
		resolved_open_event(open_token, document),
	).to_option()
	exit_event ?= client_event(EXIT_BODY)
	exited ?= lsp_apply_server_event(open_requested.state, exit_event).to_option()

	Some(
		(
			first_sent_message(shut_down).is_some()
			and stale.effects.is_empty()
			and lsp_server_find_document(stale.state, uri).is_none()
			and exited.effects.any(func(effect):
				match effect:
					LspExitServer(LspExitFailure):
						True
					_:
						False
			)
		),
	)


pure func test_pending_document_effect_allows_lifecycle_control() -> Bool:
	pending_document_effect_allows_lifecycle_case().get_or(False)


private pure func stale_open_completion_case() -> Option[Bool]:
	uri = lsp_document_uri("file:///workspace/main.brp")
	workspace ?= lsp_workspace(configuration(), [discovered_source()]).to_option()
	state ?= running_server_state(workspace)
	open_event ?= client_event(VALID_DID_OPEN_BODY)
	first_request ?= lsp_apply_server_event(state, open_event).to_option()
	first_token ?= first_open_effect_token(first_request)
	document ?= valid_open_document()
	opened ?= resolve_requested_open(first_request, document)
	close_event ?= client_event(DID_CLOSE_VALID_BODY)
	closed ?= lsp_apply_server_event(opened.state, close_event).to_option()
	second_request ?= lsp_apply_server_event(closed.state, open_event).to_option()
	second_token ?= first_open_effect_token(second_request)
	stale ?= lsp_apply_server_event(
		second_request.state,
		resolved_open_event(first_token, document),
	).to_option()
	resolved ?= lsp_apply_server_event(
		stale.state,
		resolved_open_event(second_token, document),
	).to_option()

	Some(
		(
			lsp_document_effect_token_value(
				first_token,
			) != lsp_document_effect_token_value(second_token)
			and stale.effects.is_empty()
			and lsp_server_find_document(stale.state, uri).is_none()
			and lsp_server_find_document(resolved.state, uri).is_some()
		),
	)


pure func test_stale_open_completion_cannot_satisfy_reopened_document() -> Bool:
	stale_open_completion_case().get_or(False)


private pure func stale_save_completion_case() -> Option[Bool]:
	workspace ?= lsp_workspace(configuration(), [discovered_source()]).to_option()
	state ?= running_server_state(workspace)
	open_event ?= client_event(VALID_DID_OPEN_BODY)
	open_requested ?= lsp_apply_server_event(state, open_event).to_option()
	document ?= valid_open_document()
	opened ?= resolve_requested_open(open_requested, document)
	save_event ?= client_event(DID_SAVE_VALID_BODY)
	first_save ?= lsp_apply_server_event(opened.state, save_event).to_option()
	first_token ?= first_save_effect_token(first_save)
	first_completed ?= lsp_apply_server_event(
		first_save.state,
		LspServerSavedSourceUpdated(first_token, saved_source("VALUE = 30\n")),
	).to_option()
	second_save ?= lsp_apply_server_event(first_completed.state, save_event).to_option()
	second_token ?= first_save_effect_token(second_save)
	stale ?= lsp_apply_server_event(
		second_save.state,
		LspServerSavedSourceUpdated(first_token, saved_source("VALUE = 31\n")),
	).to_option()
	second_completed ?= lsp_apply_server_event(
		stale.state,
		LspServerSavedSourceUpdated(second_token, saved_source("VALUE = 32\n")),
	).to_option()
	third_save ?= lsp_apply_server_event(second_completed.state, save_event).to_option()

	Some(
		(
			lsp_document_effect_token_value(
				first_token,
			) != lsp_document_effect_token_value(second_token)
			and stale.effects.is_empty()
			and has_save_refresh(third_save)
		),
	)


pure func test_stale_save_completion_cannot_satisfy_newer_refresh() -> Bool:
	stale_save_completion_case().get_or(False)


private pure func document_notifications_respect_lifecycle_case() -> Option[Bool]:
	uri = lsp_document_uri("file:///workspace/main.brp")
	workspace ?= lsp_workspace(configuration(), [discovered_source()]).to_option()
	awaiting ?= awaiting_initialized_server_state(workspace)
	open_event ?= client_event(VALID_DID_OPEN_BODY)
	ignored_before_initialized ?= lsp_apply_server_event(awaiting, open_event).to_option()
	running ?= running_server_state(workspace)
	shutdown_event ?= client_event(SHUTDOWN_BODY)
	shut_down ?= lsp_apply_server_event(running, shutdown_event).to_option()
	ignored_after_shutdown ?= lsp_apply_server_event(shut_down.state, open_event).to_option()

	Some(
		(
			ignored_before_initialized.effects.is_empty()
			and lsp_server_find_document(ignored_before_initialized.state, uri).is_none()
			and ignored_after_shutdown.effects.is_empty()
			and lsp_server_find_document(ignored_after_shutdown.state, uri).is_none()
		),
	)


pure func test_document_notifications_respect_lifecycle_admission() -> Bool:
	document_notifications_respect_lifecycle_case().get_or(False)


private pure func response_code(body: String) -> Option[Float]:
	value ?= parse_json(body).to_option()
	error ?= get_field(value, "error")
	code ?= get_field(error, "code")
	as_number(code)


private pure func response_id(body: String) -> Option[Float]:
	value ?= parse_json(body).to_option()
	id ?= get_field(value, "id")
	as_number(id)


private pure func initialization_commits_only_after_loading_case() -> Option[Bool]:
	initialize ?= client_event(INITIALIZE_BODY)
	loading ?= lsp_apply_server_event(
		lsp_initial_server_state(source_load_environment()),
		initialize,
	).to_option()

	if (
		not lsp_server_is_loading(loading.state)
		or not first_load_effect(loading)
		or first_sent_message(loading).is_some()
	):
		None
	else:
		load_token ?= first_load_token(loading)
		source = discovered_source()
		workspace ?= lsp_workspace(configuration(), [source]).to_option()
		ready ?= lsp_apply_server_event(
			loading.state,
			LspServerSourceLoadSucceeded(load_token, workspace, []),
		).to_option()
		response ?= first_sent_message(ready)
		awaiting_lifecycle ?= lsp_server_lifecycle(ready.state)
		initialized ?= client_event(INITIALIZED_BODY)
		running ?= lsp_apply_server_event(ready.state, initialized).to_option()
		running_lifecycle ?= lsp_server_lifecycle(running.state)

		Some(
			(
				response_id(response) == Some(7.0)
				and response_code(response).is_none()
				and ready.effects.length() == 1
				and lsp_lifecycle_running_initialization(awaiting_lifecycle).is_none()
				and lsp_lifecycle_running_initialization(running_lifecycle).is_some()
			),
		)


pure func test_initialize_commits_only_after_source_loading() -> Bool:
	initialization_commits_only_after_loading_case().get_or(False)


private pure func source_load_issues_are_emitted_case() -> Option[Bool]:
	initialize ?= client_event(INITIALIZE_BODY)
	loading ?= lsp_apply_server_event(
		lsp_initial_server_state(source_load_environment()),
		initialize,
	).to_option()
	load_token ?= first_load_token(loading)
	workspace ?= lsp_workspace(configuration(), [discovered_source()]).to_option()
	ready ?= lsp_apply_server_event(
		loading.state,
		LspServerSourceLoadSucceeded(
			load_token,
			workspace,
			[LspSourceLoadDirectoryReadFailed("/workspace/src", "permission denied")],
		),
	).to_option()

	Some(
		ready.effects.any(func(effect):
			match effect:
				LspReportSourceLoadIssues(issues):
					issues.length() == 1
				_:
					False
		),
	)


pure func test_source_load_issues_are_emitted_not_retained() -> Bool:
	source_load_issues_are_emitted_case().get_or(False)


private pure func failed_loading_allows_retry_case() -> Option[Bool]:
	initialize ?= client_event(INITIALIZE_BODY)
	loading ?= lsp_apply_server_event(
		lsp_initial_server_state(source_load_environment()),
		initialize,
	).to_option()
	load_token ?= first_load_token(loading)
	failed ?= lsp_apply_server_event(
		loading.state,
		LspServerSourceLoadFailed(load_token, LspSourceLoadNoWorkspaceRoot),
	).to_option()
	response ?= first_sent_message(failed)
	retry ?= lsp_apply_server_event(failed.state, initialize).to_option()

	Some(
		(
			response_id(response) == Some(7.0)
			and response_code(response) == Some(-32603.0)
			and first_load_effect(retry)
			and lsp_server_is_loading(retry.state)
		),
	)


pure func test_failed_source_loading_allows_initialize_retry() -> Bool:
	failed_loading_allows_retry_case().get_or(False)


private pure func stale_loading_completion_is_ignored_case() -> Option[Bool]:
	initialize ?= client_event(INITIALIZE_BODY)
	first_loading ?= lsp_apply_server_event(
		lsp_initial_server_state(source_load_environment()),
		initialize,
	).to_option()
	first_token ?= first_load_token(first_loading)
	failed ?= lsp_apply_server_event(
		first_loading.state,
		LspServerSourceLoadFailed(first_token, LspSourceLoadNoWorkspaceRoot),
	).to_option()
	retry ?= lsp_apply_server_event(failed.state, initialize).to_option()
	retry_token ?= first_load_token(retry)
	source = discovered_source()
	workspace ?= lsp_workspace(configuration(), [source]).to_option()
	stale ?= lsp_apply_server_event(
		retry.state,
		LspServerSourceLoadSucceeded(first_token, workspace, []),
	).to_option()
	ready ?= lsp_apply_server_event(
		stale.state,
		LspServerSourceLoadSucceeded(retry_token, workspace, []),
	).to_option()

	Some(
		(
			lsp_server_is_loading(stale.state)
			and stale.effects.is_empty()
			and first_sent_message(ready).is_some()
		),
	)


pure func test_stale_source_loading_completion_is_ignored() -> Bool:
	stale_loading_completion_is_ignored_case().get_or(False)


private pure func duplicate_initialize_while_loading_case() -> Option[Bool]:
	initialize ?= client_event(INITIALIZE_BODY)
	duplicate ?= client_event(DUPLICATE_INITIALIZE_BODY)
	loading ?= lsp_apply_server_event(
		lsp_initial_server_state(source_load_environment()),
		initialize,
	).to_option()
	rejected ?= lsp_apply_server_event(loading.state, duplicate).to_option()
	response ?= first_sent_message(rejected)

	Some(
		(
			lsp_server_is_loading(rejected.state)
			and response_id(response) == Some(8.0)
			and response_code(response) == Some(-32600.0)
		),
	)


pure func test_duplicate_initialize_is_rejected_while_loading() -> Bool:
	duplicate_initialize_while_loading_case().get_or(False)


private pure func loading_admission_case() -> Option[Bool]:
	initialize ?= client_event(INITIALIZE_BODY)
	hover ?= client_event(HOVER_BODY)
	did_open ?= client_event(DID_OPEN_BODY)
	loading ?= lsp_apply_server_event(
		lsp_initial_server_state(source_load_environment()),
		initialize,
	).to_option()
	rejected ?= lsp_apply_server_event(loading.state, hover).to_option()
	response ?= first_sent_message(rejected)
	ignored ?= lsp_apply_server_event(rejected.state, did_open).to_option()

	Some(
		(
			response_id(response) == Some(9.0)
			and response_code(response) == Some(-32002.0)
			and ignored.effects.is_empty()
			and lsp_server_is_loading(ignored.state)
		),
	)


pure func test_loading_rejects_requests_and_ignores_notifications() -> Bool:
	loading_admission_case().get_or(False)


private pure func loading_exit_case() -> Option[Bool]:
	initialize ?= client_event(INITIALIZE_BODY)
	exit ?= client_event(EXIT_BODY)
	loading ?= lsp_apply_server_event(
		lsp_initial_server_state(source_load_environment()),
		initialize,
	).to_option()
	exited ?= lsp_apply_server_event(loading.state, exit).to_option()

	Some(exited.effects.any(func(effect):
			match effect:
				LspExitServer(LspExitFailure):
					True
				_:
					False
		) and lsp_server_lifecycle(exited.state).is_none())


pure func test_exit_while_loading_uses_pre_shutdown_failure_status() -> Bool:
	loading_exit_case().get_or(False)


