			"current analysis failure publishes clear diagnostics",
			test_current_analysis_failure_publishes_clear,
		),
		("change queues replacement", test_change_queues_replacement),
		(
			"rejected completion retires active analysis",
			test_rejected_completion_retires_active_analysis,
		),
		(
			"stale completion starts only newest replacement",
			test_stale_completion_starts_only_newest_replacement,
		),
		(
			"accepted semantic queries return snapshot result",
			test_accepted_semantic_queries_return_snapshot_result,
		),
		(
			"document highlight query returns sorted ranges",
			test_document_highlight_query_returns_sorted_ranges,
		),
		("semantic notifications emit no response", test_semantic_notifications_emit_no_response),
	]
