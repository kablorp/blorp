private pure func stale_open_completion_case() -> Option[Bool]:
	uri = document_uri("file:///workspace/main.brp")
	workspace ?= workspace(configuration(), [discovered_source()]).to_option()
	state ?= running_server_state(workspace)
	open_event ?= client_event(VALID_DID_OPEN_BODY)
	first_request ?= apply_server_event(state, open_event).to_option()
	first_token ?= first_open_effect_token(first_request)
	document ?= valid_open_document()
	opened ?= resolve_requested_open(first_request, document)
	close_event ?= client_event(DID_CLOSE_VALID_BODY)
	closed ?= apply_server_event(opened.state, close_event).to_option()
	second_request ?= apply_server_event(closed.state, open_event).to_option()
	second_token ?= first_open_effect_token(second_request)
	stale ?= apply_server_event(
		second_request.state,
		resolved_open_event(first_token, document),
	).to_option()
	resolved ?= apply_server_event(
		stale.state,
		resolved_open_event(second_token, document),
	).to_option()

	Some(
		(
			document_effect_token_value(first_token) != document_effect_token_value(second_token)
			and stale.effects.is_empty()
			and server_find_document(stale.state, uri).is_none()
			and server_find_document(resolved.state, uri).is_some()
		),
	)


