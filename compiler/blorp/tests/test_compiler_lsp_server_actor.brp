		),
		(
			"source load issues are emitted not retained",
			test_source_load_issues_are_emitted_not_retained,
		),
		(
			"failed source loading allows initialize retry",
			test_failed_source_loading_allows_initialize_retry,
		),
		(
			"stale source loading completion is ignored",
			test_stale_source_loading_completion_is_ignored,
		),
		(
			"duplicate initialize is rejected while loading",
			test_duplicate_initialize_is_rejected_while_loading,
		),
		(
			"loading rejects requests and ignores notifications",
			test_loading_rejects_requests_and_ignores_notifications,
		),
		(
			"exit while loading uses pre-shutdown failure status",
			test_exit_while_loading_uses_pre_shutdown_failure_status,
		),
		(
			"document notifications route through canonical workspace",
			test_document_notifications_route_through_canonical_workspace,
		),
		(
			"save refresh is effectful and preserves overlay",
			test_save_refresh_is_effectful_and_preserves_overlay,
		),
		(
			"rejected open session ignores sync until close",
			test_rejected_open_session_ignores_sync_until_close,
		),
		("pending open serializes document events", test_pending_open_serializes_document_events),
		("pending save serializes close", test_pending_save_serializes_close),
		(
			"pending document effect allows lifecycle control",
			test_pending_document_effect_allows_lifecycle_control,
		),
		(
			"stale open completion cannot satisfy reopened document",
			test_stale_open_completion_cannot_satisfy_reopened_document,
		),
		(
			"stale save completion cannot satisfy newer refresh",
			test_stale_save_completion_cannot_satisfy_newer_refresh,
		),
		(
			"document notifications respect lifecycle admission",
			test_document_notifications_respect_lifecycle_admission,
		),
		("ready state starts idle", test_ready_state_starts_idle),
		("cancellation failure releases payload", test_cancellation_failure_releases_payload),
		("opening starts analysis", test_opening_starts_analysis),
		(
			"shutdown retires analysis and ignores late completion",
			test_shutdown_retires_analysis_and_ignores_late_completion,
		),
		("change queues replacement", test_change_queues_replacement),
		(
			"rejected completion retires active analysis",
			test_rejected_completion_retires_active_analysis,
		),
		(
			"stale completion starts only newest replacement",
			test_stale_completion_starts_only_newest_replacement,
		),
	]
}
