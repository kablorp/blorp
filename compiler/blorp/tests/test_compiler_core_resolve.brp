	list_id: Int = 124
	cursor_id: Int = 125
	view_id: Int = 126
	source_id: Int = 127
	result_id: Int = 128
	len_id: Int = 129
	out_id: Int = 130
	tail_list_body: CoreExpr = TupleExpr(
