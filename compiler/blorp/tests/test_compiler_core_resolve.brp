pure func test_preserves_unknown_call() -> Bool:
	unknown = unknown_call("external", None)
	resolved = resolve_callable_id_calls(program([function_decl("main", 1, unknown)]))

	match main_body(resolved):
		Some(CallExpr(UnknownCall, _, _, _, _)):
			True
		_:
			False


pure func test_resolves_global_read_and_assignment_target() -> Bool:
	global_name: String = "module__GLOBAL_COUNT"
	global_id: Int = 100
	body_type: CoreType = TupleType([int_type(), void_type()])
	resolved: CoreProgram = resolve_global_value_refs(program([
		global_decl(global_name, global_id, int_literal(0)),
		function_decl(
			"main",
			101,
			TupleExpr(
				[var_expr(global_name), AssignExpr(
						core_var(global_name, None),
						int_literal(1),
						void_type(),
						SyntheticSourceLoc,
					)],
				body_type,
				SyntheticSourceLoc,
			),
		),
	]))

	match function_body(resolved, "main"):
		Some(TupleExpr(items, typ, loc)):
			match (items.get(0), items.get(1)):
				(Some(read), Some(AssignExpr(target, rhs, assign_type, assign_loc))):
					var_has_definition(read, global_id) and target.def_id == Some(global_id)
				_:
					False
		_:
			False


pure func test_resolves_embedded_ownership_and_raw_tensor_vars() -> Bool:
	global_name: String = "module__RAW_GLOBAL"
	global_id: Int = 134
	items: List[CoreExpr] = [
		DupExpr(
			core_var(global_name, None),
			int_type(),
			NoRetainPolicy,
			int_literal(0),
			int_type(),
			SyntheticSourceLoc,
		),
		DropExpr(
			core_var(global_name, None),
			int_type(),
			NoReleasePolicy,
			int_literal(0),
			int_type(),
			SyntheticSourceLoc,
		),
		TensorRawReadExpr(
			{
				view = core_var(global_name, None),
				kind = TensorInt64Elements,
				index = var_expr(global_name)
			},
			int_type(),
			SyntheticSourceLoc,
		),
		TensorRawWriteExpr(
			{
				view = core_var(global_name, None),
				kind = TensorInt64Elements,
				index = var_expr(global_name),
				value = var_expr(global_name)
			},
			void_type(),
			SyntheticSourceLoc,
		),
	]
