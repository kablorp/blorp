			{
				variable = variable,
				item_type = int_type(),
				item_mode = ConcurrentlyLoopCopyItem,
				iterable = outer,
				body = local,
				timeout = None,
				limit = int_literal(1),
				output = ConcurrentlyLoopDiscard
			},
