		SyntheticSourceLoc,
	)
	handoff_body: CoreExpr = TupleExpr(
		[var_expr(source_name), var_expr(result_name), var_expr(len_name), var_expr(out_name)],
		TupleType([
			int_type(),
			int_type(),
			int_type(),
			int_type(),
		]),
		SyntheticSourceLoc,
	)
	items: List[CoreExpr] = [
		TailrecLoopExpr(
			[core_param(param_name)],
			int_type(),
			var_expr(param_name),
			SyntheticSourceLoc,
		),
		TailrecListSpreadLoopExpr(
			{
				params = [core_param(param_name)],
				return_type = int_type(),
				list_index = 0,
				list_param = core_param(list_name),
				cursor = core_var(cursor_name, None),
				layout = PointerListStorage,
				body = tail_list_body
			},
			SyntheticSourceLoc,
		),
		TensorRawViewLetExpr(
			{
				variable = core_var(view_name, None),
				kind = TensorInt64Elements,
				source = var_expr(view_name)
			},
			var_expr(view_name),
			int_type(),
			SyntheticSourceLoc,
		),
		ListHandoffExpr(
			{
				mode = BorrowFreshHandoff,
				layout = PointerListStorage,
				elem_needs_release = False,
				source = var_expr(source_name),
				source_var = core_var(source_name, None),
				source_type = int_type(),
				result_type = int_type(),
				capacity = int_literal(1),
				result_var = core_var(result_name, None),
				len_var = core_var(len_name, None),
				out_var = core_var(out_name, None),
				body = handoff_body,
				write_order = ForwardCompactingHandoff
			},
			int_type(),
			SyntheticSourceLoc,
		),
	]
	resolved: CoreProgram = resolve_global_value_refs(program([
		global_decl(param_name, param_id, int_literal(0)),
		global_decl(list_name, list_id, int_literal(0)),
		global_decl(cursor_name, cursor_id, int_literal(0)),
		global_decl(view_name, view_id, int_literal(0)),
		global_decl(source_name, source_id, int_literal(0)),
		global_decl(result_name, result_id, int_literal(0)),
		global_decl(len_name, len_id, int_literal(0)),
		global_decl(out_name, out_id, int_literal(0)),
		function_decl(
			"main",
			131,
			TupleExpr(items, TupleType(items.map(
					func(_): int_type(),
				)), SyntheticSourceLoc),
		),
	]))

	match function_body(resolved, "main"):
		Some(TupleExpr(resolved_items, typ, loc)):
			match (
				resolved_items.get(0),
				resolved_items.get(1),
				resolved_items.get(2),
				resolved_items.get(3),
			):
				(Some(TailrecLoopExpr(params, return_type, body, loop_loc)), Some(TailrecListSpreadLoopExpr(loop, spread_loc)), Some(TensorRawViewLetExpr(binding, view_body, view_type, view_loc)), Some(ListHandoffExpr(handoff, handoff_type, handoff_loc))):
					(
						var_is_unresolved(body)
						and tuple_vars_are_unresolved(loop.body, 3)
						and var_has_definition(binding.source, view_id)
						and var_is_unresolved(view_body)
						and var_has_definition(handoff.source, source_id)
						and tuple_vars_are_unresolved(handoff.body, 4)
					)
				_:
					False
		_:
			False


pure func match_binding(name: String) -> CoreMatchBinding:
	{
		variable = core_var(name, None),
		typ = int_type(),
		accessor = RootAccessor,
		mode = MatchBorrowBindingMode
	}


pure func match_scope_is_correct(expr: CoreExpr, global_id: Int) -> Bool:
	match expr:
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			match cases.get(0):
				Some(match_case):
					var_has_definition(scrutinee, global_id) and var_is_unresolved(match_case.body)
				None:
					False
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			match match_expr.cases.get(0):
				Some(match_case):
					var_has_definition(scrutinee, global_id) and var_is_unresolved(match_case.body)
				None:
					False
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			match match_expr.cases.get(0):
				Some(match_case):
					match match_case.branch.body:
						ConstructorMatchBodyExpr(body):
							var_has_definition(scrutinee, global_id) and var_is_unresolved(body)
						_:
							False
				None:
					False
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			match cases.get(0):
				Some(match_case):
					match match_case.body:
						ConstructorMatchBodyExpr(body):
							var_has_definition(scrutinee, global_id) and var_is_unresolved(body)
						_:
							False
				None:
					False
		_:
			False


