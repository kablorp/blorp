	local: CoreVar = core_var(local_name, None)
	nested_body: CoreExpr = TupleExpr(
		[var_expr(local_name), var_expr(global_name)],
		TupleType([int_type(), int_type()]),
		SyntheticSourceLoc,
	)
	body: CoreExpr = TupleExpr(
		[LetExpr(local, False, int_type(), int_literal(1), nested_body), var_expr(global_name)],
		TupleType([TupleType([int_type(), int_type()]), int_type()]),
		SyntheticSourceLoc,
	)
	resolved: CoreProgram = resolve_global_value_refs(program([
		global_decl(local_name, 129, int_literal(0)),
		global_decl(global_name, global_id, int_literal(0)),
		function_decl("main", 131, body),
	]))

	match function_body(resolved, "main"):
		Some(TupleExpr(items, _, _)):
			match (items.get(0), items.get(1)):
				(Some(LetExpr(variable, is_mutable, typ, rhs, inner_body)), Some(sibling)):
					match inner_body:
						TupleExpr(inner_items, _, _):
							match (inner_items.get(0), inner_items.get(1)):
								(Some(local_ref), Some(global_ref)):
									(
										var_is_unresolved(local_ref)
										and var_has_definition(global_ref, global_id)
										and var_has_definition(sibling, global_id)
									)
								_:
									False
						_:
							False
				_:
					False
		_:
			False


pure func loop_scope_is_correct(expr: CoreExpr, global_id: Int) -> Bool:
	match expr:
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			var_has_definition(start, global_id) and var_is_unresolved(body)
		ForChannelExpr(loop, typ, loc):
			var_has_definition(loop.iterable, global_id) and var_is_unresolved(loop.body)
		ForListExpr(loop, typ, loc):
			var_has_definition(loop.iterable, global_id) and var_is_unresolved(loop.body)
		ForStringExpr(loop, typ, loc):
			var_has_definition(loop.iterable, global_id) and var_is_unresolved(loop.body)
		ForDictExpr(loop, typ, loc):
			var_has_definition(loop.iterable, global_id) and var_is_unresolved(loop.body)
		ForSetExpr(loop, typ, loc):
			var_has_definition(loop.iterable, global_id) and var_is_unresolved(loop.body)
		ForStreamExpr(loop, typ, loc):
			var_has_definition(loop.iterable, global_id) and var_is_unresolved(loop.body)
		ForResourceSourceExpr(loop, typ, loc):
			var_has_definition(loop.iterable, global_id) and var_is_unresolved(loop.body)
		ForTensorExpr(loop, typ, loc):
			var_has_definition(loop.iterable, global_id) and var_is_unresolved(loop.body)
		_:
			False


