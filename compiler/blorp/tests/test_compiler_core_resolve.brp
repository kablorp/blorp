pure func optional_var_has_definition(value: Option[CoreExpr], definition_id: Int) -> Bool:
	match value:
		Some(expr):
			var_has_definition(expr, definition_id)
		None:
			False


pure func concurrency_scope_is_correct(expr: CoreExpr, global_id: Int) -> Bool:
	match expr:
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			var_has_definition(loop.iterable, global_id) and var_is_unresolved(loop.body)
		ConcurrentlyLoopExpr(loop, typ, loc):
			var_has_definition(loop.iterable, global_id) and var_is_unresolved(loop.body)
		PreClosureConcurrentExpr(block, typ, loc):
			match block.bindings.get(0):
				Some(binding):
					(
						var_has_definition(binding.rhs, global_id)
						and optional_var_has_definition(block.timeout, global_id)
						and var_is_unresolved(block.body)
					)
				None:
					False
		ConcurrentExpr(block, typ, loc):
			match block.bindings.get(0):
				Some(binding):
					(
						var_has_definition(binding.rhs, global_id)
						and optional_var_has_definition(block.timeout, global_id)
						and var_is_unresolved(block.body)
					)
				None:
					False
		SelectExpr(select_expr, typ, loc):
			match select_expr.get(0):
				Some(arm):
					match arm.kind:
						SelectRecvArm(recv):
							(
								var_has_definition(recv.channel, global_id)
								and var_is_unresolved(arm.body)
							)
						SelectSealedArm(channel):
							(
								var_has_definition(channel, global_id)
								and var_has_definition(arm.body, global_id)
							)
						SelectAfterArm(timeout):
							(
								var_has_definition(timeout, global_id)
								and var_has_definition(arm.body, global_id)
							)
				None:
					False
		_:
			False


pure func test_concurrency_and_select_binder_scopes() -> Bool:
	global_name: String = "module__TASK_VALUE"
	global_id: Int = 120
	variable: CoreVar = core_var(global_name, None)
	outer: CoreExpr = var_expr(global_name)
	local: CoreExpr = var_expr(global_name)
	task: CoreTaskClosure = task_closure("task", 121)
	items: List[CoreExpr] = [
		PreClosureConcurrentlyLoopExpr(
			{
				variable = variable,
				item_type = int_type(),
				item_mode = ConcurrentlyLoopCopyItem,
				iterable = outer,
				body = local,
				timeout = None,
				limit = int_literal(1),
				output = ConcurrentlyLoopDiscard
			},
			int_type(),
			SyntheticSourceLoc,
		),
		ConcurrentlyLoopExpr(
			{
				variable = variable,
				item_type = int_type(),
				item_mode = ConcurrentlyLoopCopyItem,
				iterable = outer,
				body = local,
				timeout = None,
				limit = int_literal(1),
				output = ConcurrentlyLoopDiscard,
				task = task
			},
			int_type(),
			SyntheticSourceLoc,
		),
		PreClosureConcurrentExpr(
			{
				bindings = [
					{
						variable = variable,
						typ = int_type(),
						rhs = outer
					},
				],
				body = local,
				timeout = Some(outer),
				max_threads = None
			},
			int_type(),
			SyntheticSourceLoc,
		),
		ConcurrentExpr(
			{
				bindings = [
					{
						variable = variable,
						typ = int_type(),
						rhs = outer,
						task = task
					},
				],
				body = local,
				timeout = Some(outer),
				max_threads = None
			},
			int_type(),
			SyntheticSourceLoc,
		),
		SelectExpr(
			[
				{
					kind = SelectRecvArm({
						binder = variable,
						elem_type = int_type(),
						channel = outer,
					}),
					body = local,
					loc = SyntheticSourceLoc
				},
			],
			int_type(),
			SyntheticSourceLoc,
		),
		SelectExpr(
			[
				{
					kind = SelectSealedArm(outer),
					body = outer,
					loc = SyntheticSourceLoc
				},
			],
			int_type(),
			SyntheticSourceLoc,
		),
		SelectExpr(
			[
				{
					kind = SelectAfterArm(outer),
					body = outer,
					loc = SyntheticSourceLoc
				},
			],
			int_type(),
			SyntheticSourceLoc,
		),
	]
	resolved: CoreProgram = resolve_global_value_refs(program([
		global_decl(global_name, global_id, int_literal(0)),
		function_decl(
			"main",
			122,
			TupleExpr(items, TupleType(items.map(
					func(_): int_type(),
				)), SyntheticSourceLoc),
		),
	]))

	match function_body(resolved, "main"):
		Some(TupleExpr(resolved_items, typ, loc)):
			var all_correct: Bool = resolved_items.length() == items.length()

			for item in resolved_items:
				if not concurrency_scope_is_correct(item, global_id):
					all_correct = False
					break
				else:
					void

			all_correct
		_:
			False


pure func tuple_vars_are_unresolved(expr: CoreExpr, expected_count: Int) -> Bool:
	match expr:
		TupleExpr(items, typ, loc):
			var all_unresolved: Bool = items.length() == expected_count

			for item in items:
				if not var_is_unresolved(item):
					all_unresolved = False
					break
				else:
					void

			all_unresolved
		_:
			False


pure func test_tailrec_tensor_view_and_list_handoff_scopes() -> Bool:
	param_name: String = "module__TAIL_PARAM"
	list_name: String = "module__TAIL_LIST"
	cursor_name: String = "module__TAIL_CURSOR"
	view_name: String = "module__RAW_VIEW"
	source_name: String = "module__HANDOFF_SOURCE"
	result_name: String = "module__HANDOFF_RESULT"
	len_name: String = "module__HANDOFF_LEN"
	out_name: String = "module__HANDOFF_OUT"
