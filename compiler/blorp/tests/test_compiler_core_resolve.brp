pure func int_type() -> CoreType:
	NamedType("Int", [])


pure func bool_type() -> CoreType:
	NamedType("Bool", [])


pure func void_type() -> CoreType:
	VoidType


pure func core_var(name: String, def_id: Option[Int]) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = def_id
	}


pure func int_literal(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), int_type(), SyntheticSourceLoc)


pure func var_expr(name: String) -> CoreExpr:
	VarExpr(
		core_var(name, None),
		int_type(),
		SyntheticSourceLoc,
	)


pure func core_param(name: String) -> CoreParam:
	{
		name = core_var(name, None),
		typ = int_type(),
		loc = SyntheticSourceLoc
	}


pure func loop_binder(name: String) -> CoreLoopBinder:
	{
		variable = core_var(name, None),
		typ = int_type(),
		range_direction = RangeForwardOnly
	}


pure func task_closure(name: String, def_id: Int) -> CoreTaskClosure:
	{
		function_name = name,
		def_id = def_id,
		c_name = name,
		static_name = name,
		captures = [],
		return_type = int_type()
	}


pure func selected_call(name: String, def_id: Int) -> CoreExpr:
	CallExpr(
		SelectedDirectCall(def_id),
		VarExpr(
			core_var(name, Some(def_id)),
			int_type(),
			SyntheticSourceLoc,
		),
		[],
		int_type(),
		SyntheticSourceLoc,
	)


pure func selected_call_without_callee_id(name: String, def_id: Int) -> CoreExpr:
	CallExpr(
		SelectedDirectCall(def_id),
		VarExpr(
			core_var(name, None),
			int_type(),
			SyntheticSourceLoc,
		),
		[],
		int_type(),
		SyntheticSourceLoc,
	)


pure func unknown_call(name: String, def_id: Option[Int]) -> CoreExpr:
	CallExpr(
		UnknownCall,
		VarExpr(
			core_var(name, def_id),
			int_type(),
			SyntheticSourceLoc,
		),
		[],
		int_type(),
		SyntheticSourceLoc,
	)


pure func function_decl(name: String, def_id: Int, body: CoreExpr) -> CoreDecl:
	function_decl_with_params(name, def_id, [], body)


pure func function_decl_in_module(
	module_name: String,
	source_name: String,
	def_id: Int,
	body: CoreExpr,
) -> CoreDecl:
	FunctionDecl({
		name = module_name.replace("/", "_") + "__" + source_name,
		source_module = Some(module_name),
		type_params = [],
		params = [core_param("value")],
		return_type = int_type(),
		body = Some(body),
		is_pure = True,
		function_kind = UserFunction,
		def_id = def_id,
		loc = SyntheticSourceLoc,
	})


pure func function_decl_with_params(
	name: String,
	def_id: Int,
	params: List[CoreParam],
	body: CoreExpr,
) -> CoreDecl:
	FunctionDecl({
		name = name,
		source_module = None,
		type_params = [],
		params = params,
		return_type = int_type(),
		body = Some(body),
		is_pure = True,
		function_kind = UserFunction,
		def_id = def_id,
		loc = SyntheticSourceLoc,
	})


pure func foreign_decl(name: String, c_name: String, def_id: Int) -> CoreDecl:
	FunctionDecl({
		name = name,
		source_module = None,
		type_params = [],
		params = [core_param("value")],
		return_type = int_type(),
		body = None,
		is_pure = True,
		function_kind = ForeignFunction({
			c_name = c_name,
			includes = [],
			link_flags = [],
			arg_passing = ForeignBorrowArgs,
		}),
		def_id = def_id,
		loc = SyntheticSourceLoc,
	})


pure func builtin_decl_in_module(
	module_name: String,
	name: String,
	c_name: String,
	def_id: Int,
) -> CoreDecl:
	FunctionDecl({
		name = name,
		source_module = Some(module_name),
		type_params = [],
		params = [core_param("value")],
		return_type = int_type(),
		body = None,
		is_pure = True,
		function_kind = BuiltinFunction(c_name),
		def_id = def_id,
		loc = SyntheticSourceLoc,
	})


pure func unresolved_builtin_body_decl_in_module(
	module_name: String,
	name: String,
	def_id: Int,
) -> CoreDecl:
	FunctionDecl({
		name = name,
		source_module = Some(module_name),
		type_params = [],
		params = [core_param("value")],
		return_type = int_type(),
		body = Some(int_literal(1)),
		is_pure = True,
		function_kind = UnresolvedBuiltinFunction,
		def_id = def_id,
		loc = SyntheticSourceLoc,
	})


pure func enum_decl(name: String, constructor: String, constructor_id: Int) -> CoreDecl:
	EnumDecl({
		name = name,
		type_params = [],
		variants = [
			{
				name = constructor,
				c_name = constructor,
				tag = 0,
				def_id = Some(constructor_id)
			},
		],
		loc = SyntheticSourceLoc,
	})


pure func payload_union_decl(name: String, constructor: String, constructor_id: Int) -> CoreDecl:
	UnionDecl({
		name = name,
		type_params = [],
		payload_storage = TypedUnionPayloadStorage,
		variants = [
			{
				name = constructor,
				c_name = constructor,
				tag_c_name = constructor + "_TAG",
				tag = 0,
				fields = [
					{
						typ = int_type(),
						release_policy = NoReleasePolicy
					},
				],
				def_id = Some(constructor_id)
			},
		],
		loc = SyntheticSourceLoc,
	})


pure func global_decl(name: String, def_id: Int, init: CoreExpr) -> CoreDecl:
	GlobalDecl({
		name = core_var(name, None),
		source_module = None,
		typ = int_type(),
		init = init,
		is_mutable = True,
		is_const = False,
		is_private = True,
		def_id = def_id,
		loc = SyntheticSourceLoc,
	})


pure func global_decl_in_module(
	module_name: String,
	source_name: String,
	def_id: Int,
	init: CoreExpr,
) -> CoreDecl:
	GlobalDecl({
		name = core_var(module_name.replace("/", "_") + "__" + source_name, None),
		source_module = Some(module_name),
		typ = int_type(),
		init = init,
		is_mutable = False,
		is_const = True,
		is_private = False,
		def_id = def_id,
		loc = SyntheticSourceLoc,
	})


pure func program(decls: List[CoreDecl]) -> CoreProgram:
	{
		decls = decls,
		foreign_includes = []
	}


pure func resolve_without_imports(input: CoreProgram) -> CoreProgram:
	resolve_core_program(input, [], [])


pure func call_expr(name: String, callee_type: CoreType, args: List[CoreExpr]) -> CoreExpr:
	return_type: CoreType = match callee_type:
		FunctionType(_, _, result_type):
			result_type
		_:
			int_type()

	CallExpr(
		UnknownCall,
		VarExpr(
			core_var(name, None),
			callee_type,
			SyntheticSourceLoc,
		),
		args,
		return_type,
		SyntheticSourceLoc,
	)


pure func int_function_type(param_count: Int) -> CoreType:
	var params: List[CoreType] = []
	var index: Int = 0

	while index < param_count:
		params = params.append(int_type())
		index += 1

	FunctionType(True, params, int_type())


pure func constructor_function_type(params: List[CoreType], parent_type: CoreType) -> CoreType:
	FunctionType(True, params, parent_type)


pure func resolved_call_kind(input: CoreProgram) -> Option[CoreCallKind]:
	match main_body(input):
		Some(CallExpr(kind, _, _, _, _)):
			Some(kind)
		_:
			None


pure func resolved_user_call_is(input: CoreProgram, name: String, def_id: Option[Int]) -> Bool:
	match resolved_call_kind(input):
		Some(UserCall(actual_name, actual_def_id, consumed_args)):
			actual_name == name and actual_def_id == def_id and consumed_args.is_empty()
		_:
			False


pure func resolved_foreign_call_is(input: CoreProgram, c_name: String) -> Bool:
	match resolved_call_kind(input):
		Some(ForeignCall(actual_name, ForeignBorrowArgs)):
			actual_name == c_name
		_:
			False


pure func resolved_builtin_call_is(input: CoreProgram, runtime_name: String) -> Bool:
	match resolved_call_kind(input):
		Some(BuiltinCall(actual_name)):
			actual_name == runtime_name
		_:
			False


pure func resolved_intrinsic_call_is(input: CoreProgram, intrinsic_name: String) -> Bool:
	match resolved_call_kind(input):
		Some(IntrinsicCall(actual_name)):
			actual_name == intrinsic_name
		_:
			False


pure func import_binding(
	local_name: String,
	module_path: String,
	original_name: Option[String],
) -> CoreResolveImportBinding:
	{
		local_name = local_name,
		module_path = module_path,
		original_name = original_name
	}


pure func typed_param(name: String, typ: CoreType) -> CoreParam:
	{
		name = core_var(name, None),
		typ = typ,
		loc = SyntheticSourceLoc
	}


pure func main_body(program_value: CoreProgram) -> Option[CoreExpr]:
	match program_value.decls.get(0):
		Some(FunctionDecl(function_info)):
			function_info.body
		_:
			None


pure func function_body(program_value: CoreProgram, name: String) -> Option[CoreExpr]:
	var found: Option[CoreExpr] = None

	for decl in program_value.decls:
		match decl:
			FunctionDecl(function_info):
				if function_info.name == name:
					found = function_info.body
					break
				else:
					void
			_:
				void

	found


pure func global_init(program_value: CoreProgram, name: String) -> Option[CoreExpr]:
	var found: Option[CoreExpr] = None

	for decl in program_value.decls:
		match decl:
			GlobalDecl(global):
				if global.name.name == name:
					found = Some(global.init)
					break
				else:
					void
			_:
				void

	found


pure func var_has_definition(expr: CoreExpr, definition_id: Int) -> Bool:
	match expr:
		VarExpr(variable, typ, loc):
			variable.def_id == Some(definition_id)
		_:
			False


pure func var_is_unresolved(expr: CoreExpr) -> Bool:
	match expr:
		VarExpr(variable, typ, loc):
			variable.def_id.is_none()
		_:
			False


pure func replace_child_with_seven(expr: CoreExpr) -> CoreExpr:
	int_literal(7)


pure func replace_child_with_context(value: Int, expr: CoreExpr) -> CoreExpr:
	int_literal(value)


pure func replace_match_result_with_seven(
	bindings: List[CoreMatchBinding],
	body: CoreExpr,
) -> CoreExpr:
	int_literal(7 + bindings.length())


pure func replace_match_result_with_context(
	value: Int,
	bindings: List[CoreMatchBinding],
	body: CoreExpr,
) -> CoreExpr:
	int_literal(value + bindings.length())


pure func test_context_traversal_matches_plain_traversal() -> Bool:
	binding: CoreMatchBinding = match_binding("item")
	nested_match: CoreExpr = ConstructorMatchExpr(
		int_literal(0),
		NoReleasePolicy,
		[
			{
				constructor = "Value",
				accessor = RootAccessor,
				test = EnumConstructorTest("Value"),
				bindings = [binding],
				body = ConstructorMatchBodyLength({
					accessor = RootAccessor,
					cases = [
						{
							length = 1,
							branch = {
								bindings = [binding],
								body = ConstructorMatchBodyExpr(int_literal(1))
							}
						},
					],
					geq = None,
					fallback = None,
					result_type = int_type(),
					loc = SyntheticSourceLoc,
				})
			},
		],
		ConstructorMatchFallbackBindings(
			[binding],
			int_literal(2),
		),
		int_type(),
		SyntheticSourceLoc,
	)
	aggregate: CoreExpr = TupleExpr(
		[int_literal(1), nested_match],
		TupleType([int_type(), int_type()]),
		SyntheticSourceLoc,
	)
	plain_children: CoreExpr = map_core_expr_children(aggregate, replace_child_with_seven)
	context_children: CoreExpr = map_core_expr_children_with_context(
		aggregate,
		7,
		replace_child_with_context,
	)
	plain_matches: CoreExpr = map_core_match_results(nested_match, replace_match_result_with_seven)
	context_matches: CoreExpr = map_core_match_results_with_context(
		nested_match,
		7,
		replace_match_result_with_context,
	)

	(
		core_expr_to_json(
			plain_children,
		).to_string() == core_expr_to_json(context_children).to_string()
		and core_expr_to_json(
			plain_matches,
		).to_string() == core_expr_to_json(context_matches).to_string()
	)


pure func deep_sequence(final_item: CoreExpr, depth: Int) -> CoreExpr:
	var result: CoreExpr = final_item
	var index: Int = 0

	while index < depth:
		result = SeqExpr(int_literal(index), result)
		index += 1

	result


pure func deep_sequence_call_is_resolved(
	expr: CoreExpr,
	callable_id: Int,
	expected_depth: Int,
) -> Bool:
	var current: CoreExpr = expr
	var resolved_items: Int = 0
	var valid: Bool = True

	while resolved_items < expected_depth and valid:
		match current:
			SeqExpr(first, second):
				match first:
					LiteralExpr(IntLiteral(value), typ, loc):
						if value == expected_depth - resolved_items - 1:
							current = second
							resolved_items += 1
						else:
							valid = False
					_:
						valid = False
			_:
				valid = False

	if not valid or resolved_items != expected_depth:
		False
	else:
		match current:
			CallExpr(UserCall(name, def_id, consumed_args), callee, args, typ, loc):
				name == "helper" and def_id == Some(callable_id)
			_:
				False


pure func nested_selected_calls(
	final_expr: CoreExpr,
	name: String,
	def_id: Int,
	depth: Int,
) -> CoreExpr:
	var result: CoreExpr = final_expr
	var index: Int = 0

	while index < depth:
		result = CallExpr(
			SelectedDirectCall(def_id),
			VarExpr(
				core_var(name, Some(def_id)),
				int_type(),
				SyntheticSourceLoc,
			),
			[result],
			int_type(),
			SyntheticSourceLoc,
		)
		index += 1

	result


pure func deep_selected_call(name: String, def_id: Int, depth: Int) -> CoreExpr:
	nested_selected_calls(
		selected_call(name, def_id),
		name,
		def_id,
		depth,
	)


pure func deep_call_is_resolved(expr: CoreExpr, callable_id: Int, expected_depth: Int) -> Bool:
	var current: CoreExpr = expr
	var resolved_calls: Int = 0
	var valid: Bool = True

	while resolved_calls < expected_depth and valid:
		match current:
			CallExpr(UserCall(name, def_id, consumed_args), callee, args, typ, loc):
				match args.get(0):
					Some(next):
						if name == "helper" and def_id == Some(callable_id):
							current = next
							resolved_calls += 1
						else:
							valid = False
					None:
						valid = False
			_:
				valid = False

	if not valid or resolved_calls != expected_depth:
		False
	else:
		match current:
			CallExpr(UserCall(name, def_id, consumed_args), callee, args, typ, loc):
				name == "helper" and def_id == Some(callable_id) and args.length() == 0
			_:
				False


pure func deep_sequence_global_is_resolved(
	expr: CoreExpr,
	global_name: String,
	global_id: Int,
	expected_depth: Int,
) -> Bool:
	var current: CoreExpr = expr
	var resolved_items: Int = 0
	var valid: Bool = True

	while resolved_items < expected_depth and valid:
		match current:
			SeqExpr(first, second):
				match first:
					LiteralExpr(IntLiteral(value), typ, loc):
						if value == expected_depth - resolved_items - 1:
							current = second
							resolved_items += 1
						else:
							valid = False
					_:
						valid = False
			_:
				valid = False

	if not valid or resolved_items != expected_depth:
		False
	else:
		match current:
			VarExpr(variable, typ, loc):
				variable.name == global_name and variable.def_id == Some(global_id)
			_:
				False


pure func deep_call_global_is_resolved(
	expr: CoreExpr,
	global_name: String,
	global_id: Int,
	callable_id: Int,
	expected_depth: Int,
) -> Bool:
	var current: CoreExpr = expr
	var resolved_calls: Int = 0
	var valid: Bool = True

	while resolved_calls < expected_depth and valid:
		match current:
			CallExpr(SelectedDirectCall(def_id), callee, args, typ, loc):
				match args.get(0):
					Some(next):
						if def_id == callable_id:
							current = next
							resolved_calls += 1
						else:
							valid = False
					None:
						valid = False
			_:
				valid = False

	if not valid or resolved_calls != expected_depth:
		False
	else:
		match current:
			VarExpr(variable, typ, loc):
				variable.name == global_name and variable.def_id == Some(global_id)
			_:
				False


pure func nested_ifs(final_expr: CoreExpr, depth: Int) -> CoreExpr:
	var result: CoreExpr = final_expr
	var index: Int = 0

	while index < depth:
		condition: CoreExpr = LiteralExpr(BoolLiteral(True), bool_type(), SyntheticSourceLoc)
		result = IfExpr(condition, result, int_literal(0), int_type(), SyntheticSourceLoc)
		index += 1

	result


pure func deep_if_global_is_resolved(
	expr: CoreExpr,
	global_name: String,
	global_id: Int,
	expected_depth: Int,
) -> Bool:
	var current: CoreExpr = expr
	var resolved_ifs: Int = 0
	var valid: Bool = True

	while resolved_ifs < expected_depth and valid:
		match current:
			IfExpr(cond, then_expr, else_expr, typ, loc):
				current = then_expr
				resolved_ifs += 1
			_:
				valid = False

	if not valid or resolved_ifs != expected_depth:
		False
	else:
		match current:
			VarExpr(variable, typ, loc):
				variable.name == global_name and variable.def_id == Some(global_id)
			_:
				False


pure func deep_cast_type(index: Int) -> CoreType:
	if index % 2 == 0:
		int_type()
	else:
		bool_type()


pure func deep_cast_loc(index: Int) -> CoreSourceLoc:
	KnownSourceLoc({
		file = "deep_cast.brp",
		line = index + 1,
		column = index + 2,
		end_line = index + 1,
		end_column = index + 3,
	})


pure func nested_casts(final_expr: CoreExpr, depth: Int) -> CoreExpr:
	var result: CoreExpr = final_expr
	var index: Int = 0

	while index < depth:
		result = CastExpr(result, deep_cast_type(index), deep_cast_loc(index))
		index += 1

	result


pure func deep_cast_global_is_resolved(
	expr: CoreExpr,
	global_name: String,
	global_id: Int,
	expected_depth: Int,
) -> Bool:
	var current: CoreExpr = expr
	var resolved_casts: Int = 0
	var valid: Bool = True

	while resolved_casts < expected_depth and valid:
		match current:
			CastExpr(value, typ, loc):
				expected_index: Int = expected_depth - resolved_casts - 1

				expected_type_name: String = if expected_index % 2 == 0:
					"Int"
				else:
					"Bool"

				type_matches: Bool = match typ:
					NamedType(name, args):
						name == expected_type_name and args.length() == 0
					_:
						False

				loc_matches: Bool = match loc:
					KnownSourceLoc(span):
						(
							span.file == "deep_cast.brp"
							and span.line == expected_index + 1
							and span.column == expected_index + 2
							and span.end_line == expected_index + 1
							and span.end_column == expected_index + 3
						)
					_:
						False

				if type_matches and loc_matches:
					current = value
					resolved_casts += 1
				else:
					valid = False
			_:
				valid = False

	if not valid or resolved_casts != expected_depth:
		False
	else:
		match current:
			VarExpr(variable, typ, loc):
				variable.name == global_name and variable.def_id == Some(global_id)
			_:
				False


pure func nested_tuples(final_expr: CoreExpr, depth: Int) -> CoreExpr:
	var result: CoreExpr = final_expr
	var index: Int = 0

	while index < depth:
		result = TupleExpr([result], TupleType([int_type()]), SyntheticSourceLoc)
		index += 1

	result


pure func nested_tuple_global_is_resolved(
	expr: CoreExpr,
	global_name: String,
	global_id: Int,
	expected_depth: Int,
) -> Bool:
	var current: CoreExpr = expr
	var resolved_tuples: Int = 0
	var valid: Bool = True

	while resolved_tuples < expected_depth and valid:
		match current:
			TupleExpr(items, typ, loc):
				match items.get(0):
					Some(next):
						current = next
						resolved_tuples += 1
					None:
						valid = False
			_:
				valid = False

	if not valid or resolved_tuples != expected_depth:
		False
	else:
		match current:
			VarExpr(variable, typ, loc):
				variable.name == global_name and variable.def_id == Some(global_id)
			_:
				False


