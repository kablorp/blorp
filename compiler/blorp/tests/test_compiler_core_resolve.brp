pure func test_resolves_embedded_ownership_and_raw_tensor_vars() -> Bool:
	global_name: String = "module__RAW_GLOBAL"
	global_id: Int = 134
	items: List[CoreExpr] = [
		DupExpr(
			core_var(global_name, None),
			int_type(),
			NoRetainPolicy,
			int_literal(0),
			int_type(),
			SyntheticSourceLoc,
		),
		DropExpr(
			core_var(global_name, None),
			int_type(),
			NoReleasePolicy,
			int_literal(0),
			int_type(),
			SyntheticSourceLoc,
		),
		TensorRawReadExpr(
			{
				view = core_var(global_name, None),
				kind = TensorInt64Elements,
				index = var_expr(global_name)
			},
			int_type(),
			SyntheticSourceLoc,
		),
		TensorRawWriteExpr(
			{
				view = core_var(global_name, None),
				kind = TensorInt64Elements,
				index = var_expr(global_name),
				value = var_expr(global_name)
			},
			void_type(),
			SyntheticSourceLoc,
		),
	]
	resolved: CoreProgram = resolve_global_value_refs(program([
		global_decl(global_name, global_id, int_literal(0)),
		function_decl(
			"main",
			135,
			TupleExpr(items, TupleType([
					int_type(),
					int_type(),
					int_type(),
					void_type(),
				]), SyntheticSourceLoc),
		),
	]))

	match function_body(resolved, "main"):
		Some(TupleExpr(resolved_items, typ, loc)):
			match (
				resolved_items.get(0),
				resolved_items.get(1),
				resolved_items.get(2),
				resolved_items.get(3),
			):
				(Some(DupExpr(dup_var, _, _, _, _, _)), Some(DropExpr(drop_var, _, _, _, _, _)), Some(TensorRawReadExpr(read, _, _)), Some(TensorRawWriteExpr(write, _, _))):
					(
						dup_var.def_id == Some(global_id)
						and drop_var.def_id == Some(global_id)
						and read.view.def_id == Some(global_id)
						and var_has_definition(read.index, global_id)
						and write.view.def_id == Some(global_id)
						and var_has_definition(write.index, global_id)
						and var_has_definition(write.value, global_id)
					)
				_:
					False
		_:
			False


