pure func call_has_definition(expr: CoreExpr, definition_id: Int) -> Bool:
	match expr:
		CallExpr(UserCall(_, def_id, _), _, _, _, _):
			def_id == Some(definition_id)
		_:
			False


pure func same_named_constructors_resolve(first_decl: CoreDecl, second_decl: CoreDecl) -> Bool:
	first_type: CoreType = NamedType("First", [])
	second_type: CoreType = NamedType("Second", [])
	resolved: CoreProgram = resolve_without_imports(program([
		function_decl(
			"first_value",
			1,
			VarExpr(
				core_var("Empty", None),
				first_type,
				SyntheticSourceLoc,
			),
		),
		function_decl(
			"second_value",
			2,
			VarExpr(
				core_var("Empty", None),
				second_type,
				SyntheticSourceLoc,
			),
		),
		function_decl(
			"first_call",
			3,
			call_expr(
				"Empty",
				constructor_function_type([], first_type),
				[],
			),
		),
		function_decl(
			"second_call",
			4,
			call_expr(
				"Empty",
				constructor_function_type([], second_type),
				[],
			),
		),
		first_decl,
		second_decl,
	]))

	match (
		function_body(resolved, "first_value"),
		function_body(resolved, "second_value"),
		function_body(resolved, "first_call"),
		function_body(resolved, "second_call"),
	):
		(Some(first_value), Some(second_value), Some(first_call), Some(second_call)):
			(
				var_has_definition(first_value, 7)
				and var_has_definition(second_value, 8)
				and call_has_definition(first_call, 7)
				and call_has_definition(second_call, 8)
			)
		_:
			False


pure func test_same_named_constructors_resolve_by_type_in_declaration_order() -> Bool:
	same_named_constructors_resolve(
		enum_decl("First", "Empty", 7),
		enum_decl("Second", "Empty", 8),
	)


pure func test_same_named_constructors_resolve_by_type_in_reverse_order() -> Bool:
	same_named_constructors_resolve(
		enum_decl("Second", "Empty", 8),
		enum_decl("First", "Empty", 7),
	)


