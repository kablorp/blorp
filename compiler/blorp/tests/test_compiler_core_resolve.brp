pure func basic_scope_is_correct(expr: CoreExpr, global_id: Int) -> Bool:
	match expr:
		LetExpr(variable, is_mutable, typ, rhs, body):
			var_has_definition(rhs, global_id) and var_is_unresolved(body)
		BorrowLetExpr(variable, typ, rhs, body):
			var_has_definition(rhs, global_id) and var_is_unresolved(body)
		LambdaExpr(params, return_type, body, is_pure, typ, loc):
			var_is_unresolved(body)
		ResourceScopeExpr(scope, typ, loc):
			(
				var_has_definition(scope.acquire, global_id)
				and var_is_unresolved(scope.body)
				and var_is_unresolved(scope.cleanup)
			)
		_:
			False


pure func test_let_lambda_and_resource_scopes() -> Bool:
	global_name: String = "module__SCOPED"
	global_id: Int = 116
	local: CoreVar = core_var(global_name, None)
	items: List[CoreExpr] = [
		LetExpr(local, False, int_type(), var_expr(global_name), var_expr(global_name)),
		BorrowLetExpr(local, int_type(), var_expr(global_name), var_expr(global_name)),
		LambdaExpr(
			[core_param(global_name)],
			int_type(),
			var_expr(global_name),
			True,
			NamedType("Function", []),
			SyntheticSourceLoc,
		),
		ResourceScopeExpr(
			{
				variable = local,
				typ = int_type(),
				acquire = var_expr(global_name),
				body = var_expr(global_name),
				cleanup = var_expr(global_name)
			},
			int_type(),
			SyntheticSourceLoc,
		),
	]
	resolved: CoreProgram = resolve_global_value_refs(program([
		global_decl(global_name, global_id, int_literal(0)),
		function_decl(
			"main",
			117,
			TupleExpr(items, TupleType([
					int_type(),
					int_type(),
					int_type(),
					int_type(),
				]), SyntheticSourceLoc),
		),
	]))

	match function_body(resolved, "main"):
		Some(TupleExpr(resolved_items, typ, loc)):
			var all_correct: Bool = resolved_items.length() == items.length()

			for item in resolved_items:
				if not basic_scope_is_correct(item, global_id):
					all_correct = False
					break
				else:
					void

			all_correct
		_:
			False


pure func test_extended_scope_survives_sibling_children() -> Bool:
	local_name: String = "module__LOCAL"
	global_name: String = "module__GLOBAL"
