	]))

	match function_body(resolved, "main"):
		Some(TupleExpr(resolved_items, typ, loc)):
			match (
				resolved_items.get(0),
				resolved_items.get(1),
				resolved_items.get(2),
				resolved_items.get(3),
			):
				(Some(TailrecLoopExpr(params, return_type, body, loop_loc)), Some(TailrecListSpreadLoopExpr(loop, spread_loc)), Some(TensorRawViewLetExpr(binding, view_body, view_type, view_loc)), Some(ListHandoffExpr(handoff, handoff_type, handoff_loc))):
					(
						var_is_unresolved(body)
						and tuple_vars_are_unresolved(loop.body, 3)
						and var_has_definition(binding.source, view_id)
						and var_is_unresolved(view_body)
						and var_has_definition(handoff.source, source_id)
						and tuple_vars_are_unresolved(handoff.body, 4)
					)
				_:
					False
		_:
			False


pure func match_binding(name: String) -> CoreMatchBinding:
	{
		variable = core_var(name, None),
		typ = int_type(),
		accessor = RootAccessor,
		mode = MatchBorrowBindingMode
	}


pure func match_scope_is_correct(expr: CoreExpr, global_id: Int) -> Bool:
	match expr:
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			match cases.get(0):
				Some(match_case):
					var_has_definition(scrutinee, global_id) and var_is_unresolved(match_case.body)
				None:
					False
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			match match_expr.cases.get(0):
				Some(match_case):
					var_has_definition(scrutinee, global_id) and var_is_unresolved(match_case.body)
				None:
					False
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			match match_expr.cases.get(0):
				Some(match_case):
					match match_case.branch.body:
						ConstructorMatchBodyExpr(body):
							var_has_definition(scrutinee, global_id) and var_is_unresolved(body)
						_:
							False
				None:
					False
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			match cases.get(0):
				Some(match_case):
					match match_case.body:
						ConstructorMatchBodyExpr(body):
							var_has_definition(scrutinee, global_id) and var_is_unresolved(body)
						_:
							False
				None:
					False
		_:
			False


pure func test_all_match_binding_scopes() -> Bool:
	global_name: String = "module__MATCH_VALUE"
	global_id: Int = 132
	binding: CoreMatchBinding = match_binding(global_name)
	scrutinee: CoreExpr = var_expr(global_name)
	body: CoreExpr = var_expr(global_name)
	literal_match: CoreExpr = LiteralMatchExpr(
		scrutinee,
		[
			{
				literal = IntLiteral(0),
				bindings = [binding],
				body = body
			},
		],
		LiteralMatchFallbackFail,
		int_type(),
		SyntheticSourceLoc,
	)
	accessor_match: CoreExpr = AccessorLiteralMatchExpr(
		scrutinee,
		NoReleasePolicy,
		{
			accessor = RootAccessor,
			scrutinee_type = int_type(),
			cases = [
				{
					literal = IntLiteral(0),
					bindings = [binding],
					body = body
				},
			],
			fallback = LiteralMatchFallbackFail,
			result_type = int_type(),
			loc = SyntheticSourceLoc
		},
		int_type(),
		SyntheticSourceLoc,
	)
	length_match: CoreExpr = LengthMatchExpr(
		scrutinee,
		NoReleasePolicy,
		{
			accessor = RootAccessor,
			cases = [
				{
					length = 1,
					branch = {
						bindings = [binding],
						body = ConstructorMatchBodyExpr(body)
					}
				},
			],
			geq = None,
			fallback = None,
			result_type = int_type(),
			loc = SyntheticSourceLoc
		},
		int_type(),
		SyntheticSourceLoc,
	)
	constructor_match: CoreExpr = ConstructorMatchExpr(
		scrutinee,
		NoReleasePolicy,
		[
			{
				constructor = "Value",
				accessor = RootAccessor,
				test = EnumConstructorTest("Value"),
				bindings = [binding],
				body = ConstructorMatchBodyExpr(body)
			},
		],
		ConstructorMatchFallbackFail,
		int_type(),
		SyntheticSourceLoc,
	)
	items: List[CoreExpr] = [literal_match, accessor_match, length_match, constructor_match]
	resolved: CoreProgram = resolve_global_value_refs(program([
		global_decl(global_name, global_id, int_literal(0)),
		function_decl(
			"main",
			133,
			TupleExpr(items, TupleType(items.map(
					func(_): int_type(),
				)), SyntheticSourceLoc),
		),
	]))

	match function_body(resolved, "main"):
		Some(TupleExpr(resolved_items, typ, loc)):
			var all_correct: Bool = resolved_items.length() == items.length()

			for item in resolved_items:
				if not match_scope_is_correct(item, global_id):
					all_correct = False
					break
				else:
					void

			all_correct
		_:
			False


pure func literal_fallback_scopes_are_correct(
	bound_expr: CoreExpr,
	unbound_expr: CoreExpr,
	global_id: Int,
) -> Bool:
	bound_ok: Bool = match bound_expr:
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			match fallback:
				LiteralMatchFallbackBindings(bindings, body):
					var_has_definition(scrutinee, global_id) and var_is_unresolved(body)
				_:
					False
		_:
			False

	unbound_ok: Bool = match unbound_expr:
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			match fallback:
				LiteralMatchFallbackBody(body):
					var_has_definition(scrutinee, global_id) and var_has_definition(body, global_id)
				_:
					False
		_:
			False

	bound_ok and unbound_ok


pure func length_fallback_scopes_are_correct(expr: CoreExpr, global_id: Int) -> Bool:
	match expr:
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			match (match_expr.geq, match_expr.fallback):
				(Some(geq), Some(fallback)):
					match (geq.branch.body, fallback.body):
						(ConstructorMatchBodyExpr(geq_body), ConstructorMatchBodyExpr(fallback_body)):
							(
								var_has_definition(scrutinee, global_id)
								and var_is_unresolved(geq_body)
								and var_is_unresolved(fallback_body)
							)
						_:
							False
				_:
					False
		_:
			False


pure func nested_constructor_scope_is_correct(expr: CoreExpr, global_id: Int) -> Bool:
	match expr:
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			match (cases.get(0), fallback):
				(Some(match_case), ConstructorMatchFallbackBindings(fallback_bindings, fallback_body)):
					match match_case.body:
						ConstructorMatchBodyLength(length_match):
							match length_match.cases.get(0):
								Some(length_case):
									match length_case.branch.body:
										ConstructorMatchBodyExpr(nested_body):
											(
												var_has_definition(scrutinee, global_id)
												and var_is_unresolved(nested_body)
												and var_is_unresolved(fallback_body)
											)
										_:
											False
								None:
									False
						_:
							False
				_:
					False
		_:
			False


pure func test_match_fallback_and_nested_binding_scopes() -> Bool:
	global_name: String = "module__MATCH_FALLBACK"
	global_id: Int = 138
	binding: CoreMatchBinding = match_binding(global_name)
	scrutinee: CoreExpr = var_expr(global_name)
	body: CoreExpr = var_expr(global_name)
	bound_literal: CoreExpr = LiteralMatchExpr(
		scrutinee,
		[],
		LiteralMatchFallbackBindings([binding], body),
		int_type(),
		SyntheticSourceLoc,
	)
	unbound_literal: CoreExpr = LiteralMatchExpr(
		scrutinee,
		[],
		LiteralMatchFallbackBody(body),
		int_type(),
		SyntheticSourceLoc,
	)
	length_match: CoreExpr = LengthMatchExpr(
		scrutinee,
		NoReleasePolicy,
		{
			accessor = RootAccessor,
			cases = [],
			geq = Some({
				minimum_length = 1,
				branch = {
					bindings = [binding],
					body = ConstructorMatchBodyExpr(body)
				},
			}),
			fallback = Some({
				bindings = [binding],
				body = ConstructorMatchBodyExpr(body),
			}),
			result_type = int_type(),
			loc = SyntheticSourceLoc
		},
		int_type(),
		SyntheticSourceLoc,
	)
	nested_length: CoreConstructorLengthMatch = {
		accessor = RootAccessor,
		cases = [
			{
				length = 1,
				branch = {
					bindings = [],
					body = ConstructorMatchBodyExpr(body)
				}
			},
		],
		geq = None,
		fallback = None,
		result_type = int_type(),
		loc = SyntheticSourceLoc
	}
	nested_constructor: CoreExpr = ConstructorMatchExpr(
		scrutinee,
		NoReleasePolicy,
		[
			{
				constructor = "Value",
				accessor = RootAccessor,
				test = EnumConstructorTest("Value"),
				bindings = [binding],
				body = ConstructorMatchBodyLength(nested_length)
			},
		],
		ConstructorMatchFallbackBindings(
			[binding],
			body,
		),
		int_type(),
		SyntheticSourceLoc,
	)
	items: List[CoreExpr] = [bound_literal, unbound_literal, length_match, nested_constructor]
	resolved: CoreProgram = resolve_global_value_refs(program([
		global_decl(global_name, global_id, int_literal(0)),
		function_decl(
			"main",
			139,
			TupleExpr(items, TupleType([
					int_type(),
					int_type(),
					int_type(),
					int_type(),
				]), SyntheticSourceLoc),
		),
	]))

	match function_body(resolved, "main"):
		Some(TupleExpr(resolved_items, typ, loc)):
			match (
				resolved_items.get(0),
				resolved_items.get(1),
				resolved_items.get(2),
				resolved_items.get(3),
			):
				(Some(bound_expr), Some(unbound_expr), Some(length_expr), Some(nested_expr)):
					(
						literal_fallback_scopes_are_correct(bound_expr, unbound_expr, global_id)
						and length_fallback_scopes_are_correct(length_expr, global_id)
						and nested_constructor_scope_is_correct(nested_expr, global_id)
					)
				_:
					False
		_:
			False


tests: TestSuite = {
	description = "Blorp compiler Core binding resolution",
	tests = [
		(
			"context traversal matches plain traversal",
			test_context_traversal_matches_plain_traversal,
		),
		(
			"deep sequence callable resolution is stack bounded",
			test_deep_sequence_callable_resolution_is_stack_bounded,
		),
		(
			"deep call resolution avoids generic mapper frames",
			test_deep_call_callable_resolution_avoids_generic_mapper_frames,
		),
		(
			"deep global resolution spines are stack bounded",
			test_deep_global_resolution_spines_are_stack_bounded,
		),
		("resolves unique selected direct call", test_resolves_unique_selected_direct_call),
		(
			"resolves selected metadata without callee id",
			test_resolves_selected_direct_metadata_without_callee_id,
		),
		(
			"resolves module-local id collision by qualified name",
			test_resolves_module_local_id_collision_by_qualified_name,
		),
		("resolves repeated callable identity", test_resolves_repeated_callable_identity),
		("leaves stale selected name unresolved", test_leaves_stale_selected_name_unresolved),
		(
			"resolves unknown call with unique callable id",
			test_resolves_unknown_call_with_unique_callable_id,
		),
		("preserves unknown call", test_preserves_unknown_call),
		(
			"resolves global read and assignment target",
			test_resolves_global_read_and_assignment_target,
		),
		(
			"resolves embedded ownership and raw tensor variables",
			test_resolves_embedded_ownership_and_raw_tensor_vars,
		),
		("resolves implementation method body", test_resolves_impl_method_body),
		("preserves existing global value identity", test_preserves_existing_global_value_identity),
		(
			"leaves distinct same-named globals ambiguous",
			test_leaves_distinct_same_named_globals_ambiguous,
		),
		(
			"deduplicates repeated exact global identity",
			test_deduplicates_repeated_exact_global_identity,
		),
		(
			"qualified global names isolate module-local ids",
			test_qualified_global_names_isolate_module_local_ids,
		),
		(
			"global initializer uses declaration scope",
			test_global_initializer_uses_declaration_scope,
		),
		("function parameter shadows global value", test_function_parameter_shadows_global_value),
		("let lambda and resource scopes", test_let_lambda_and_resource_scopes),
		("extended scope survives sibling children", test_extended_scope_survives_sibling_children),
		("all for-loop binder scopes", test_all_for_loop_binder_scopes),
		("concurrency and select binder scopes", test_concurrency_and_select_binder_scopes),
		(
			"tailrec tensor view and list handoff scopes",
			test_tailrec_tensor_view_and_list_handoff_scopes,
		),
		("all match binding scopes", test_all_match_binding_scopes),
		(
			"match fallback and nested binding scopes",
			test_match_fallback_and_nested_binding_scopes,
		),
	]
}
