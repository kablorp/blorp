		SyntheticSourceLoc,
	)
	resolved: CoreProgram = resolve_core_program(
		program([
			function_decl_in_module("std/list", "join", selected_id, int_literal(1)),
			function_decl_in_module("std/path", "join", 3549, int_literal(2)),
			function_decl_in_module("compiler/source_graph", "caller", 4000, selected_call),
		]),
		[],
		[
			{
				module_name = "compiler/source_graph",
				import_bindings = [import_binding("join", "std/path", Some("join"))]
			},
		],
	)

	match function_body(resolved, "compiler_source_graph__caller"):
		Some(CallExpr(UserCall(name, def_id, _), VarExpr(callee, _, _), _, _, _)):
			(
				name == "std_list__join"
				and def_id == Some(selected_id)
				and callee.name == "std_list__join"
				and callee.def_id == Some(selected_id)
			)
		_:
			False


