		int_type(),
		SyntheticSourceLoc,
	)
	unbound_literal: CoreExpr = LiteralMatchExpr(
		scrutinee,
		[],
		LiteralMatchFallbackBody(body),
		int_type(),
		SyntheticSourceLoc,
	)
	length_match: CoreExpr = LengthMatchExpr(
		scrutinee,
		NoReleasePolicy,
		{
			accessor = RootAccessor,
			cases = [],
			geq = Some({
				minimum_length = 1,
				branch = {
					bindings = [binding],
					body = ConstructorMatchBodyExpr(body)
				},
			}),
			fallback = Some({
				bindings = [binding],
				body = ConstructorMatchBodyExpr(body),
			}),
			result_type = int_type(),
			loc = SyntheticSourceLoc
		},
		int_type(),
		SyntheticSourceLoc,
	)
	nested_length: CoreConstructorLengthMatch = {
		accessor = RootAccessor,
		cases = [
			{
				length = 1,
				branch = {
					bindings = [],
					body = ConstructorMatchBodyExpr(body)
				}
			},
		],
		geq = None,
		fallback = None,
		result_type = int_type(),
		loc = SyntheticSourceLoc
	}
	nested_constructor: CoreExpr = ConstructorMatchExpr(
		scrutinee,
		NoReleasePolicy,
		[
			{
				constructor = "Value",
				accessor = RootAccessor,
				test = EnumConstructorTest("Value"),
				bindings = [binding],
				body = ConstructorMatchBodyLength(nested_length)
			},
		],
		ConstructorMatchFallbackBindings(
			[binding],
			body,
		),
		int_type(),
		SyntheticSourceLoc,
	)
	items: List[CoreExpr] = [bound_literal, unbound_literal, length_match, nested_constructor]
	resolved: CoreProgram = resolve_global_value_refs(program([
		global_decl(global_name, global_id, int_literal(0)),
		function_decl(
			"main",
			139,
			TupleExpr(items, TupleType([
					int_type(),
					int_type(),
					int_type(),
					int_type(),
				]), SyntheticSourceLoc),
		),
	]))

	match function_body(resolved, "main"):
		Some(TupleExpr(resolved_items, typ, loc)):
			match (
				resolved_items.get(0),
				resolved_items.get(1),
				resolved_items.get(2),
				resolved_items.get(3),
			):
				(Some(bound_expr), Some(unbound_expr), Some(length_expr), Some(nested_expr)):
					(
						literal_fallback_scopes_are_correct(bound_expr, unbound_expr, global_id)
						and length_fallback_scopes_are_correct(length_expr, global_id)
						and nested_constructor_scope_is_correct(nested_expr, global_id)
					)
				_:
					False
		_:
			False


