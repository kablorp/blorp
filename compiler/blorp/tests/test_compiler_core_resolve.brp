				item_type = int_type(),
				item_mode = ConcurrentlyLoopCopyItem,
				iterable = outer,
				body = local,
				timeout = None,
				limit = int_literal(1),
				output = ConcurrentlyLoopDiscard,
				task = task
			},
			int_type(),
			SyntheticSourceLoc,
		),
		PreClosureConcurrentExpr(
			{
				bindings = [
					{
						variable = variable,
						typ = int_type(),
						rhs = outer
					},
				],
				body = local,
				timeout = Some(outer),
				max_threads = None
			},
			int_type(),
			SyntheticSourceLoc,
		),
		ConcurrentExpr(
			{
				bindings = [
					{
						variable = variable,
						typ = int_type(),
						rhs = outer,
						task = task
					},
				],
				body = local,
				timeout = Some(outer),
				max_threads = None
			},
			int_type(),
			SyntheticSourceLoc,
		),
		SelectExpr(
			[
				{
					kind = SelectRecvArm({
						binder = variable,
						elem_type = int_type(),
						channel = outer,
					}),
					body = local,
					loc = SyntheticSourceLoc
				},
			],
			int_type(),
			SyntheticSourceLoc,
		),
		SelectExpr(
			[
				{
					kind = SelectSealedArm(outer),
					body = outer,
					loc = SyntheticSourceLoc
				},
			],
			int_type(),
			SyntheticSourceLoc,
		),
		SelectExpr(
			[
				{
					kind = SelectAfterArm(outer),
					body = outer,
					loc = SyntheticSourceLoc
				},
			],
			int_type(),
			SyntheticSourceLoc,
		),
	]
	resolved: CoreProgram = resolve_global_value_refs(program([
		global_decl(global_name, global_id, int_literal(0)),
		function_decl(
			"main",
			122,
			TupleExpr(items, TupleType(items.map(
					func(_): int_type(),
				)), SyntheticSourceLoc),
		),
	]))

	match function_body(resolved, "main"):
		Some(TupleExpr(resolved_items, typ, loc)):
			var all_correct: Bool = resolved_items.length() == items.length()

			for item in resolved_items:
				if not concurrency_scope_is_correct(item, global_id):
					all_correct = False
					break
				else:
					void

			all_correct
		_:
			False


