pure func basic_scope_is_correct(expr: CoreExpr, global_id: Int) -> Bool:
	match expr:
		LetExpr(variable, is_mutable, typ, rhs, body):
			var_has_definition(rhs, global_id) and var_is_unresolved(body)
		BorrowLetExpr(variable, typ, rhs, body):
			var_has_definition(rhs, global_id) and var_is_unresolved(body)
		LambdaExpr(params, return_type, body, is_pure, typ, loc):
			var_is_unresolved(body)
		ResourceScopeExpr(scope, typ, loc):
			(
				var_has_definition(scope.acquire, global_id)
				and var_is_unresolved(scope.body)
				and var_is_unresolved(scope.cleanup)
			)
		_:
			False


