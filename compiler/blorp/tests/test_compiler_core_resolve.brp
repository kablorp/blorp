pure func test_pattern_binding_shadows_imported_function() -> Bool:
	local_name: String = "arg"
	comparison: CoreExpr = CallExpr(
		BuiltinCall("blorp_string_eq"),
		int_literal(0),
		[var_expr(local_name), int_literal(1)],
		bool_type(),
		SyntheticSourceLoc,
	)
	inner_match: CoreExpr = ConstructorMatchExpr(
		int_literal(0),
		NoReleasePolicy,
		[
			{
				constructor = "Value",
				accessor = RootAccessor,
				test = EnumConstructorTest("Value"),
				bindings = [match_binding(local_name)],
				body = ConstructorMatchBodyExpr(comparison)
			},
		],
		ConstructorMatchFallbackFail,
		int_type(),
		SyntheticSourceLoc,
	)
	match_expr: CoreExpr = ConstructorMatchExpr(
		int_literal(0),
		NoReleasePolicy,
		[
			{
				constructor = "Outer",
				accessor = RootAccessor,
				test = EnumConstructorTest("Outer"),
				bindings = [match_binding("error")],
				body = ConstructorMatchBodyExpr(inner_match)
			},
		],
		ConstructorMatchFallbackFail,
		int_type(),
		SyntheticSourceLoc,
	)
	input: CoreProgram = program([
		function_decl("main", 1, match_expr),
		function_decl_in_module("std/options", local_name, 2, int_literal(2)),
	])

	trait_resolved: CoreProgram = match resolve_core_traits(input):
		Ok(output):
			output
		Err(_):
			input

	resolved: CoreProgram = resolve_core_program(
		trait_resolved,
		[import_binding(local_name, "std/options", Some(local_name))],
		[],
	)

	match function_body(resolved, "main"):
		Some(ConstructorMatchExpr(_, _, cases, _, _, _)):
			match cases.get(0):
				Some(match_case):
					match match_case.body:
						ConstructorMatchBodyExpr(ConstructorMatchExpr(_, _, inner_cases, _, _, _)):
							match inner_cases.get(0):
								Some(inner_case):
									match inner_case.body:
										ConstructorMatchBodyExpr(body):
											match body:
												CallExpr(_, _, args, _, _):
													match args.get(0):
														Some(first_arg):
															var_is_unresolved(first_arg)
														None:
															False
												_:
													False
										_:
											False
								None:
									False
						_:
							False
				None:
					False
		_:
			False


