pure func optional_var_has_definition(value: Option[CoreExpr], definition_id: Int) -> Bool:
	match value:
		Some(expr):
			var_has_definition(expr, definition_id)
		None:
			False


pure func concurrency_scope_is_correct(expr: CoreExpr, global_id: Int) -> Bool:
	match expr:
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			var_has_definition(loop.iterable, global_id) and var_is_unresolved(loop.body)
		ConcurrentlyLoopExpr(loop, typ, loc):
			var_has_definition(loop.iterable, global_id) and var_is_unresolved(loop.body)
		PreClosureConcurrentExpr(block, typ, loc):
			match block.bindings.get(0):
				Some(binding):
					(
						var_has_definition(binding.rhs, global_id)
						and optional_var_has_definition(block.timeout, global_id)
						and var_is_unresolved(block.body)
					)
				None:
					False
		ConcurrentExpr(block, typ, loc):
			match block.bindings.get(0):
				Some(binding):
					(
						var_has_definition(binding.rhs, global_id)
						and optional_var_has_definition(block.timeout, global_id)
						and var_is_unresolved(block.body)
					)
				None:
					False
		SelectExpr(select_expr, typ, loc):
			match select_expr.get(0):
				Some(arm):
					match arm.kind:
						SelectRecvArm(recv):
							(
								var_has_definition(recv.channel, global_id)
								and var_is_unresolved(arm.body)
							)
						SelectSealedArm(channel):
							(
								var_has_definition(channel, global_id)
								and var_has_definition(arm.body, global_id)
							)
						SelectAfterArm(timeout):
							(
								var_has_definition(timeout, global_id)
								and var_has_definition(arm.body, global_id)
							)
				None:
					False
		_:
			False


pure func test_concurrency_and_select_binder_scopes() -> Bool:
	global_name: String = "module__TASK_VALUE"
