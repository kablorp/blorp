import:
	../src/stage_04_modules/compiler_module_type_identity: compiler_local_type_names_from_decls
	../src/stage_03_parse/compiler_parsed_ast:
		ParsedDecl(
			BuiltinTypeParsedDecl,
			ParsedErrorDecl,
			PrivateParsedDecl,
			RecordParsedDecl,
			TypeAliasParsedDecl,
			UnionParsedDecl,
		),
		ParsedIdentifier,
		ParsedTypeExpr(ParsedNamedType),
		parsed_identifier,
	../src/stage_01_file_io/compiler_source:
		CompilerCursor,
		CompilerSourceFile,
		CompilerSourceSpan,
		compiler_source_cursor_at,
		compiler_source_file,
		compiler_source_span,
	test: TestSuite


pure func source_file() -> CompilerSourceFile:
	compiler_source_file("module_identity.brp", "module_identity", "")


pure func source_span(src: CompilerSourceFile) -> CompilerSourceSpan:
	cursor: CompilerCursor = compiler_source_cursor_at(src, 0)
	compiler_source_span(src, cursor, cursor)


pure func identifier(src: CompilerSourceFile, text: String) -> ParsedIdentifier:
	parsed_identifier(text, source_span(src))


pure func named_type(src: CompilerSourceFile, text: String) -> ParsedTypeExpr:
	ParsedNamedType(
		identifier(src, text),
		[],
		source_span(src),
	)


pure func record_decl(src: CompilerSourceFile, name: String) -> ParsedDecl:
	RecordParsedDecl({
		name = identifier(src, name),
		type_params = [],
		fields = [],
		is_struct = False,
		doc = None,
		span = source_span(src),
	})


pure func union_decl(src: CompilerSourceFile, name: String) -> ParsedDecl:
	UnionParsedDecl({
		name = identifier(src, name),
		type_params = [],
		variants = [],
		is_enum = False,
		doc = None,
		span = source_span(src),
	})


pure func type_alias_decl(src: CompilerSourceFile, name: String) -> ParsedDecl:
	TypeAliasParsedDecl({
		name = identifier(src, name),
		type_params = [],
		target = named_type(src, "Int"),
		is_opaque = False,
		doc = None,
		span = source_span(src),
	})


pure func builtin_type_decl(src: CompilerSourceFile, name: String) -> ParsedDecl:
	BuiltinTypeParsedDecl({
		name = identifier(src, name),
		type_params = [],
		is_resource = False,
		cleanup = None,
		doc = None,
		span = source_span(src),
	})


func test_local_type_names_are_sorted_unique_and_private_transparent() -> Bool:
	src: CompilerSourceFile = source_file()
	span: CompilerSourceSpan = source_span(src)
	decls: List[ParsedDecl] = [
		record_decl(src, "Zoo"),
		ParsedErrorDecl(span),
		type_alias_decl(src, "Alias"),
		PrivateParsedDecl(
			union_decl(src, "Hidden"),
			span,
		),
		builtin_type_decl(src, "Native"),
		record_decl(src, "Alias"),
		union_decl(src, "Choice"),
	]

	compiler_local_type_names_from_decls(decls) == ["Alias", "Choice", "Hidden", "Native", "Zoo"]


tests: TestSuite = {
	description = "Compiler module type identity",
	tests = [
		(
			"local type names are sorted unique and private transparent",
			test_local_type_names_are_sorted_unique_and_private_transparent,
		),
	]
}
