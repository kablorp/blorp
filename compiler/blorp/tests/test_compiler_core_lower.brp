		CompilerTypedAssignScope(CompilerLocalAssignScope),
		CompilerTypedExpr(
			CompilerTypedAscriptionExpr,
			CompilerTypedAssignExpr,
			CompilerTypedBinaryExpr,
			CompilerTypedBlockExpr,
			CompilerTypedBoolLiteralExpr,
			CompilerTypedCallExpr,
			CompilerTypedDictExpr,
			CompilerTypedFieldAccessExpr,
			CompilerTypedIfExpr,
			CompilerTypedIntLiteralExpr,
			CompilerTypedListExpr,
			CompilerTypedNameExpr,
			CompilerTypedOpaqueFromExpr,
			CompilerTypedOpaqueIntoExpr,
			CompilerTypedRangeExpr,
			CompilerTypedRecordExpr,
			CompilerTypedTupleExpr,
			CompilerTypedVarDeclExpr,
			CompilerTypedVectorExpr,
		),
		CompilerTypedExprInfo,
		CompilerTypedVarDeclPayload,
		CompilerTypedRecordField,
	../src/stage_03_parse/compiler_parsed_ast:
		ParsedBinaryOp(ParsedAddOp),
		ParsedExpr(ParsedIntLiteralExpr),
		ParsedFunctionDecl,
		ParsedIdentifier,
		ParsedParam,
		ParsedParamBinder(ParsedParamNameBinder),
		ParsedTypeExpr(ParsedNamedType),
		ParsedVarDecl,
		parsed_identifier,
	../src/stage_05_types/compiler_refinement: compiler_unrefined_binding
	../src/stage_01_file_io/compiler_source:
		CompilerCursor,
		CompilerSourceFile,
		CompilerSourceSpan,
		compiler_source_cursor_at,
		compiler_source_file,
		compiler_source_span,
	../src/stage_05_types/compiler_type:
		CompilerType(
			CompilerArrayType,
			CompilerConstIntType,
			CompilerNamedType,
			CompilerRangeType,
			CompilerTupleType,
		),
		compiler_function_type,
		compiler_type_list,
		compiler_type_bool,
		compiler_type_int,
