import:
	../compiler_core_json:
		CoreBinaryOp(AddOp),
		CoreDecl(FunctionDecl, GlobalDecl),
		CoreExpr(
			AssignExpr,
			BinaryExpr,
			FieldExpr,
			IfExpr,
			LiteralExpr,
			RangeExpr,
			RecordExpr,
			SeqExpr,
			TupleExpr,
			VarExpr,
		),
		CoreLiteral(BoolLiteral, IntLiteral, WideIntLiteral),
		CoreType(NamedType, RangeType, TupleType),
		core_expr_to_json,
		core_type_to_json,
	../compiler_core_lower:
		CompilerCoreLowerError(CompilerCoreLowerUnsupported),
		compiler_core_lower_context,
		compiler_core_lower_type,
		compiler_core_source_loc,
		lower_typed_decl,
		lower_typed_expr,
		lower_typed_program,
	../compiler_infer:
		CompilerExprTypeOrigin(CompilerSynthesizedOrigin),
		CompilerTypedAssignScope(CompilerLocalAssignScope),
		CompilerTypedExpr(
			CompilerTypedAscriptionExpr,
			CompilerTypedAssignExpr,
			CompilerTypedBinaryExpr,
			CompilerTypedBlockExpr,
			CompilerTypedBoolLiteralExpr,
			CompilerTypedCallExpr,
			CompilerTypedFieldAccessExpr,
			CompilerTypedIfExpr,
			CompilerTypedIntLiteralExpr,
			CompilerTypedNameExpr,
			CompilerTypedRangeExpr,
			CompilerTypedRecordExpr,
			CompilerTypedTupleExpr,
		),
		CompilerTypedExprInfo,
		CompilerTypedRecordField,
	../compiler_parsed_ast:
		ParsedBinaryOp(ParsedAddOp),
		ParsedExpr(ParsedIntLiteralExpr),
		ParsedFunctionDecl,
		ParsedIdentifier,
		ParsedParam,
		ParsedParamBinder(ParsedParamNameBinder),
		ParsedTypeExpr(ParsedNamedType),
		ParsedVarDecl,
		parsed_identifier,
	../compiler_refinement: compiler_unrefined_binding
	../compiler_source:
		CompilerCursor,
		CompilerSourceFile,
		CompilerSourceSpan,
		compiler_source_cursor_at,
		compiler_source_file,
		compiler_source_span,
	../compiler_type:
		CompilerType(CompilerNamedType, CompilerRangeType, CompilerTupleType),
		compiler_type_bool,
		compiler_type_int,
	../compiler_type_widening: CompilerTypeWideningDecision(CompilerTypeKeep)
	../compiler_typecheck_decl:
		CompilerTypedDecl(CompilerTypedFunctionDecl, CompilerTypedGlobalVarDecl),
		CompilerTypedFunctionInfo,
		CompilerTypedGlobalVarInfo,
		CompilerTypedProgram,
	test: TestSuite


pure func source_file() -> CompilerSourceFile:
	compiler_source_file("core_lower.brp", "core_lower", "func main(x: Int) -> Int: x + 1")


pure func source_span() -> CompilerSourceSpan:
	src: CompilerSourceFile = source_file()
	start: CompilerCursor = compiler_source_cursor_at(src, 0)
	finish: CompilerCursor = compiler_source_cursor_at(src, 4)
	compiler_source_span(src, start, finish)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, source_span())


pure func int_type() -> CompilerType:
	compiler_type_int()


pure func core_int_type() -> CoreType:
	NamedType("Int", [])


pure func core_bool_type() -> CoreType:
	NamedType("Bool", [])


pure func expr_info(typ: CompilerType) -> CompilerTypedExprInfo:
	{
		source_type = None,
		semantic_type = typ,
		value_type = typ,
		origin = CompilerSynthesizedOrigin("core lower test"),
		value_slot = {
			semantic_type = typ,
			decision = CompilerTypeKeep(typ)
		},
		proofs = compiler_unrefined_binding(),
		resolved_call = None,
		resource_dependencies = []
	}


pure func int_expr(text: String) -> CompilerTypedExpr:
	CompilerTypedIntLiteralExpr(text, source_span(), expr_info(int_type()))


pure func bool_expr(value: Bool) -> CompilerTypedExpr:
	CompilerTypedBoolLiteralExpr(value, source_span(), expr_info(compiler_type_bool()))


pure func parsed_int_expr(text: String) -> ParsedExpr:
	ParsedIntLiteralExpr(text, source_span())


pure func parsed_type_int() -> ParsedTypeExpr:
	ParsedNamedType(ident("Int"), [], source_span())


pure func parsed_param(name: String) -> ParsedParam:
	{
		binder = ParsedParamNameBinder(ident(name)),
		type_expr = Some(parsed_type_int()),
		span = source_span()
	}


pure func parsed_function_decl() -> ParsedFunctionDecl:
	{
		name = ident("answer"),
		type_params = [],
		params = [parsed_param("x")],
		return_type = Some(parsed_type_int()),
		dim_constraints = [],
		body = Some(parsed_int_expr("1")),
		is_pure = True,
		annotations = [],
		doc = None,
		span = source_span()
	}


pure func parsed_var_decl() -> ParsedVarDecl:
	{
		name = ident("answer"),
		type_expr = Some(parsed_type_int()),
		value = parsed_int_expr("42"),
		is_mutable = False,
		span = source_span()
	}


pure func core_exprs_equal(left: CoreExpr, right: CoreExpr) -> Bool:
	core_expr_to_json(left).to_string() == core_expr_to_json(right).to_string()


func test_lowers_int_literal_with_known_location() -> Bool:
	match lower_typed_expr(int_expr("42")):
		Ok(expr):
			expected = LiteralExpr(
				IntLiteral(42),
				core_int_type(),
				compiler_core_source_loc(source_span()),
			)
			core_exprs_equal(expr, expected)
		Err(_):
			False


func test_lowers_wide_int_literal_when_it_does_not_fit_int() -> Bool:
	match lower_typed_expr(int_expr("999999999999999999999999999999")):
		Ok(expr):
			expected = LiteralExpr(
				WideIntLiteral("999999999999999999999999999999"),
				core_int_type(),
				compiler_core_source_loc(source_span()),
			)
			core_exprs_equal(expr, expected)
		Err(_):
			False


func test_lowers_ufcs_identifier_suffix_to_def_id() -> Bool:
	expr = CompilerTypedNameExpr(ident("__ufcs_map#77"), expr_info(int_type()))

	match lower_typed_expr(expr):
		Ok(VarExpr(variable, typ, _)):
			(
				variable.name == "__ufcs_map"
				and variable.def_id == Some(77)
				and core_type_to_json(
					typ,
				).to_string() == core_type_to_json(core_int_type()).to_string()
			)
		_:
			False


func test_lowers_binary_expression() -> Bool:
	expr = CompilerTypedBinaryExpr(
		ParsedAddOp,
		int_expr("1"),
		int_expr("2"),
		source_span(),
		expr_info(int_type()),
	)

	match lower_typed_expr(expr):
		Ok(BinaryExpr(AddOp, left, right, typ, _)):
			core_exprs_equal(
				left,
				LiteralExpr(
					IntLiteral(1),
					core_int_type(),
					compiler_core_source_loc(source_span()),
				),
			) and core_exprs_equal(
				right,
				LiteralExpr(
					IntLiteral(2),
					core_int_type(),
					compiler_core_source_loc(source_span()),
				),
			) and core_type_to_json(
				typ,
			).to_string() == core_type_to_json(core_int_type()).to_string()
		_:
			False


func test_lowers_tuple_expression() -> Bool:
	tuple_type = CompilerTupleType([compiler_type_int(), compiler_type_int()])
	expr = CompilerTypedTupleExpr(
		[int_expr("1"), int_expr("2")],
		source_span(),
		expr_info(tuple_type),
	)

	match lower_typed_expr(expr):
		Ok(TupleExpr(items, typ, _)):
			(
				items.length() == 2
				and core_type_to_json(
					typ,
				).to_string() == core_type_to_json(
					TupleType([NamedType("Int", []), NamedType("Int", [])]),
				).to_string()
			)
		_:
			False


func test_lowers_if_expression() -> Bool:
	expr = CompilerTypedIfExpr(
		bool_expr(True),
		int_expr("1"),
		Some(int_expr("2")),
		source_span(),
		expr_info(int_type()),
	)

	match lower_typed_expr(expr):
		Ok(IfExpr(condition, then_branch, else_branch, typ, _)):
			core_exprs_equal(
				condition,
				LiteralExpr(
					BoolLiteral(True),
					core_bool_type(),
					compiler_core_source_loc(source_span()),
				),
			) and core_exprs_equal(
				then_branch,
				LiteralExpr(
					IntLiteral(1),
					core_int_type(),
					compiler_core_source_loc(source_span()),
				),
			) and core_exprs_equal(
				else_branch,
				LiteralExpr(
					IntLiteral(2),
					core_int_type(),
					compiler_core_source_loc(source_span()),
				),
			) and core_type_to_json(
				typ,
			).to_string() == core_type_to_json(core_int_type()).to_string()
		_:
			False


func test_lowers_block_expression_to_sequence() -> Bool:
	expr = CompilerTypedBlockExpr(
		[int_expr("1"), int_expr("2")],
		source_span(),
		expr_info(int_type()),
	)

	match lower_typed_expr(expr):
		Ok(SeqExpr(first, second)):
			core_exprs_equal(
				first,
				LiteralExpr(
					IntLiteral(1),
					core_int_type(),
					compiler_core_source_loc(source_span()),
				),
			) and core_exprs_equal(
				second,
				LiteralExpr(
					IntLiteral(2),
					core_int_type(),
					compiler_core_source_loc(source_span()),
				),
			)
		_:
			False


func test_lowers_ascription_to_inner_expression() -> Bool:
	expr = CompilerTypedAscriptionExpr(
		int_expr("3"),
		int_type(),
		source_span(),
		expr_info(int_type()),
	)

	match lower_typed_expr(expr):
		Ok(lowered):
			core_exprs_equal(
				lowered,
				LiteralExpr(
					IntLiteral(3),
					core_int_type(),
					compiler_core_source_loc(source_span()),
				),
			)
		Err(_):
			False


func test_lowers_assignment_expression() -> Bool:
	expr = CompilerTypedAssignExpr(
		ident("x"),
		CompilerLocalAssignScope,
		int_expr("4"),
		source_span(),
		expr_info(int_type()),
	)

	match lower_typed_expr(expr):
		Ok(AssignExpr(variable, rhs, typ, _)):
			variable.name == "x" and core_exprs_equal(
				rhs,
				LiteralExpr(
					IntLiteral(4),
					core_int_type(),
					compiler_core_source_loc(source_span()),
				),
			) and core_type_to_json(
				typ,
			).to_string() == core_type_to_json(core_int_type()).to_string()
		_:
			False


func test_lowers_field_access_expression() -> Bool:
	receiver_type = CompilerNamedType("Point", [])
	receiver = CompilerTypedNameExpr(ident("point"), expr_info(receiver_type))
	expr = CompilerTypedFieldAccessExpr(receiver, ident("x"), source_span(), expr_info(int_type()))

	match lower_typed_expr(expr):
		Ok(FieldExpr(lowered_receiver, field_name, typ, _)):
			field_name == "x" and core_exprs_equal(
				lowered_receiver,
				VarExpr(
					{
						name = "point",
						uniq = 0,
						def_id = None
					},
					NamedType("Point", []),
					compiler_core_source_loc(source_span()),
				),
			) and core_type_to_json(
				typ,
			).to_string() == core_type_to_json(core_int_type()).to_string()
		_:
			False


func test_lowers_range_expression() -> Bool:
	range_type = CompilerRangeType(compiler_type_int())
	expr = CompilerTypedRangeExpr(
		int_expr("1"),
		int_expr("5"),
		source_span(),
		expr_info(range_type),
	)

	match lower_typed_expr(expr):
		Ok(RangeExpr(start, end_value, typ, _)):
			core_exprs_equal(
				start,
				LiteralExpr(
					IntLiteral(1),
					core_int_type(),
					compiler_core_source_loc(source_span()),
				),
			) and core_exprs_equal(
				end_value,
				LiteralExpr(
					IntLiteral(5),
					core_int_type(),
					compiler_core_source_loc(source_span()),
				),
			) and core_type_to_json(typ).to_string() == core_type_to_json(RangeType).to_string()
		_:
			False


func test_lowers_record_expression() -> Bool:
	record_type = CompilerNamedType("Point", [])
	fields: List[CompilerTypedRecordField] = [
		{
			name = ident("x"),
			value = int_expr("1"),
			span = source_span()
		},
		{
			name = ident("y"),
			value = int_expr("2"),
			span = source_span()
		},
	]
	expr = CompilerTypedRecordExpr(fields, source_span(), expr_info(record_type))

	match lower_typed_expr(expr):
		Ok(RecordExpr(core_fields, typ, _)):
			match (core_fields.get(0), core_fields.get(1)):
				(Some(first), Some(second)):
					(
						core_fields.length() == 2
						and first.name == "x"
						and second.name == "y"
						and core_type_to_json(
							typ,
						).to_string() == core_type_to_json(NamedType("Point", [])).to_string()
					)
				_:
					False
		_:
			False


func test_reports_unsupported_expression_shape() -> Bool:
	call_expr = CompilerTypedCallExpr(
		CompilerTypedNameExpr(ident("f"), expr_info(int_type())),
		[],
		source_span(),
		expr_info(int_type()),
	)

	match lower_typed_expr(call_expr):
		Err(CompilerCoreLowerUnsupported(label)):
			label == "call"
		_:
			False


func test_lowers_tuple_type() -> Bool:
	tuple_type = CompilerTupleType([compiler_type_int(), compiler_type_bool()])

	match compiler_core_lower_type(tuple_type):
		Ok(lowered_tuple):
			core_type_to_json(
				lowered_tuple,
			).to_string() == core_type_to_json(
				TupleType([NamedType("Int", []), NamedType("Bool", [])]),
			).to_string()
		_:
			False


func test_lowers_function_decl_preserving_callable_id() -> Bool:
	info: CompilerTypedFunctionInfo = {
		decl = parsed_function_decl(),
		callable_id = Some(42),
		param_types = [int_type()],
		source_return_type = Some(int_type()),
		semantic_return_type = int_type(),
		body = Some(int_expr("1"))
	}
	context = compiler_core_lower_context(100, None)

	match lower_typed_decl(context, CompilerTypedFunctionDecl(info)):
		Ok(result):
			match result.decl:
				FunctionDecl(func_info):
					(
						result.context.next_def_id == 100
						and func_info.def_id == 42
						and func_info.name == "answer"
						and func_info.params.length() == 1
						and func_info.body.is_some()
					)
				_:
					False
		Err(_):
			False


func test_lowers_global_decl_minting_def_id() -> Bool:
	info: CompilerTypedGlobalVarInfo = {
		decl = parsed_var_decl(),
		binding_type = int_type(),
		source_type = Some(int_type()),
		value = int_expr("42")
	}
	context = compiler_core_lower_context(10, None)

	match lower_typed_decl(context, CompilerTypedGlobalVarDecl(info)):
		Ok(result):
			match result.decl:
				GlobalDecl(global_info):
					(
						result.context.next_def_id == 11
						and global_info.def_id == 10
						and global_info.name.name == "answer"
						and core_exprs_equal(
							global_info.init,
							LiteralExpr(
								IntLiteral(42),
								core_int_type(),
								compiler_core_source_loc(source_span()),
							),
						)
					)
				_:
					False
		Err(_):
			False


func test_lowers_program_sequentially() -> Bool:
	func_info: CompilerTypedFunctionInfo = {
		decl = parsed_function_decl(),
		callable_id = None,
		param_types = [int_type()],
		source_return_type = Some(int_type()),
		semantic_return_type = int_type(),
		body = Some(int_expr("1"))
	}
	global_info: CompilerTypedGlobalVarInfo = {
		decl = parsed_var_decl(),
		binding_type = int_type(),
		source_type = Some(int_type()),
		value = int_expr("42")
	}
	program: CompilerTypedProgram = {
		source = source_file(),
		decls = [CompilerTypedFunctionDecl(func_info), CompilerTypedGlobalVarDecl(global_info)],
		diagnostics = []
	}

	match lower_typed_program(
		compiler_core_lower_context(7, None),
		program,
	):
		Ok(result):
			(
				result.context.next_def_id == 9
				and result.program.decls.length() == 2
				and result.program.foreign_includes.length() == 0
			)
		Err(_):
			False


tests: TestSuite = {
	description = "Blorp compiler Core lowering",
	tests = [
		("lowers int literal with known location", test_lowers_int_literal_with_known_location),
		(
			"lowers wide int literal when it does not fit Int",
			test_lowers_wide_int_literal_when_it_does_not_fit_int,
		),
		("lowers UFCS identifier suffix to def id", test_lowers_ufcs_identifier_suffix_to_def_id),
		("lowers binary expression", test_lowers_binary_expression),
		("lowers tuple expression", test_lowers_tuple_expression),
		("lowers if expression", test_lowers_if_expression),
		("lowers block expression to sequence", test_lowers_block_expression_to_sequence),
		("lowers ascription to inner expression", test_lowers_ascription_to_inner_expression),
		("lowers assignment expression", test_lowers_assignment_expression),
		("lowers field access expression", test_lowers_field_access_expression),
		("lowers range expression", test_lowers_range_expression),
		("lowers record expression", test_lowers_record_expression),
		("reports unsupported expression shape", test_reports_unsupported_expression_shape),
		("lowers tuple type", test_lowers_tuple_type),
		(
			"lowers function decl preserving callable id",
			test_lowers_function_decl_preserving_callable_id,
		),
		("lowers global decl minting def id", test_lowers_global_decl_minting_def_id),
		("lowers program sequentially", test_lowers_program_sequentially),
	]
}
