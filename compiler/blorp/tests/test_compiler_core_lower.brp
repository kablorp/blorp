func test_lowers_function_decl_preserving_callable_id() -> Bool:
	info: CompilerTypedFunctionInfo = {
		decl = parsed_function_decl(),
		callable_id = Some(42),
		effective_type_params = [compiler_make_bound_type_param("T", [])],
		param_types = [int_type()],
		source_return_type = Some(int_type()),
		semantic_return_type = int_type(),
		body = Some(int_expr("1"))
	}
	context = compiler_core_lower_context(100, None)

	match lower_typed_decl(context, CompilerTypedFunctionDecl(info)):
		Ok(result):
			match result.decl:
				FunctionDecl(func_info):
					(
						result.context.next_def_id == 100
						and func_info.def_id == 42
						and func_info.name == "answer"
						and func_info.type_params == ["T"]
						and func_info.params.length() == 1
						and func_info.body.is_some()
					)
				_:
					False
		Err(_):
			False


func test_lowers_foreign_function_metadata() -> Bool:
	info: CompilerTypedForeignFunctionInfo = {
		decl = parsed_foreign_function_decl(),
		callable_id = Some(44),
		param_types = [int_type()],
		semantic_return_type = int_type(),
		c_name = "c_native_answer",
		includes = ["native.h"],
		link_flags = [
			{
				platform = Some(CompilerTypedForeignLinux),
				flag = "-ldl"
			},
		],
		arg_passing = CompilerTypedForeignDefaultArgs,
		block_span = source_span()
	}
	program: CompilerTypedProgram = {
		source = source_file(),
		decls = [CompilerTypedForeignFunctionDecl(info)],
		diagnostics = []
	}

	match lower_typed_program(
		compiler_core_lower_context(100, None),
		program,
	):
		Ok(result):
			match result.program.decls.get(0):
				Some(FunctionDecl(function_info)):
					match function_info.function_kind:
						ForeignFunction(foreign_info):
							arg_passing_ok: Bool = match foreign_info.arg_passing:
								ForeignDefaultArgs(policies):
									policies.length() == 0
								_:
									False

							(
								result.context.next_def_id == 100
								and function_info.def_id == 44
								and function_info.body.is_none()
								and foreign_info.c_name == "c_native_answer"
								and foreign_info.includes == ["native.h"]
								and foreign_info.link_flags.length() == 1
								and arg_passing_ok
								and result.program.foreign_includes == ["native.h"]
							)
						_:
							False
				_:
					False
		Err(_):
			False


