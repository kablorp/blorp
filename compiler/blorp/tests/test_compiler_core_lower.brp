func test_lowers_question_bind_option_to_raw_match() -> Bool:
	rhs = TypedNameExpr(ident("maybe"), expr_info(option_int_type()))
	question = TypedQuestionBindExpr(
		ident("value"),
		None,
		rhs,
		source_span(),
		expr_info(int_type()),
	)
	tail = TypedNameExpr(ident("done"), expr_info(option_int_type()))
	expr = TypedBlockExpr(
		[question, tail],
		source_span(),
		expr_info(option_int_type()),
	)

	match lower_typed_expr(expr):
		Ok(LetExpr(temp_var, is_mutable, bind_type, bind_rhs, body)):
			match body:
				RawMatchExpr(scrutinee, cases, typ, _):
					json = core_expr_to_json(body).to_string()

					scrutinee_ok: Bool = match scrutinee:
						VarExpr(scrutinee_var, scrutinee_type, _):
							(
								scrutinee_var.name == temp_var.name
								and core_types_equal(scrutinee_type, core_option_int_type())
							)
						_:
							False

					(
						temp_var.name.starts_with("__qb_value")
						and not is_mutable
						and core_types_equal(bind_type, core_option_int_type())
						and core_exprs_equal(
							bind_rhs,
							VarExpr(
								{
									name = "maybe",
									uniq = 0,
									def_id = None
								},
								core_option_int_type(),
								compiler_core_source_loc(source_span()),
							),
						)
						and scrutinee_ok
						and cases.length() == 2
						and core_types_equal(typ, core_option_int_type())
						and json.contains("\"kind\":\"raw_match\"")
						and json.contains("\"name\":\"Some\"")
						and json.contains("\"name\":\"None\"")
						and not json.contains("\"kind\":\"stack_option_some\"")
						and not json.contains("\"kind\":\"stack_option_none\"")
						and json.contains("blorp_option_none")
					)
				_:
					False
		_:
			False


