	):
		Ok(result):
			match result.decl:
				ImplDecl(impl_info):
					match impl_info.methods.get(0):
						Some(lowered_method):
							(
								result.context.next_def_id == 11
								and impl_info.trait_name == "Display"
								and core_type_to_json(
									impl_info.for_type,
								).to_string() == core_type_to_json(core_int_type()).to_string()
								and impl_info.type_params.length() == 1
