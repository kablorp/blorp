				and core_type_to_json(typ).to_string() == core_type_to_json(VoidType).to_string()
			)
		_:
			False


func test_lowers_dict_tuple_for_expression() -> Bool:
	iterable = TypedNameExpr(ident("items"), expr_info(dict_int_int_type()))
	body = TypedBreakExpr(source_span(), expr_info(TYPE_VOID))
	expr = TypedForExpr(
		ParsedForTupleBinder(
			[ident("key"), ident("value")],
			source_span(),
		),
		iterable,
		None,
		body,
		source_span(),
		expr_info(TYPE_VOID),
	)

	match lower_typed_expr(expr):
		Ok(ForDictExpr(for_dict, _, _)):
			match for_dict.body:
				LetExpr(key_var, False, key_type, TupleFieldExpr(key_tuple, 0, _, _), value_let):
					match value_let:
						LetExpr(value_var, False, value_type, TupleFieldExpr(value_tuple, 1, _, _), BreakExpr(_, _)):
							match (key_tuple, value_tuple):
								(VarExpr(key_source, _, _), VarExpr(value_source, _, _)):
									(
										key_var.name == "key"
										and value_var.name == "value"
										and key_source.name == for_dict.binder.variable.name
										and value_source.name == for_dict.binder.variable.name
										and core_types_equal(key_type, core_int_type())
										and core_types_equal(value_type, core_int_type())
										and core_types_equal(
											for_dict.binder.typ,
											TupleType([core_int_type(), core_int_type()]),
										)
									)
								_:
									False
						_:
							False
				_:
					False
		_:
			False


