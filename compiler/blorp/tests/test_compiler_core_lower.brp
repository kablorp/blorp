func test_lowers_block_head_concurrent_block_with_tail_scope() -> Bool:
	concurrent_expr = TypedConcurrentBlockExpr(
		[],
		[typed_concurrent_binding("task", int_expr("1"))],
		source_span(),
		expr_info(TYPE_VOID),
	)
	tail = TypedNameExpr(ident("task"), expr_info(task_result_int_type()))
	expr = TypedBlockExpr(
		[concurrent_expr, tail],
		source_span(),
		expr_info(task_result_int_type()),
	)

	match lower_typed_expr(expr):
		Ok(PreClosureConcurrentExpr(block, typ, _)):
			match block.bindings.get(0):
				Some(binding):
					(
						block.bindings.length() == 1
						and binding.variable.name == "task"
						and core_type_to_json(
							binding.typ,
						).to_string() == core_type_to_json(core_task_result_int_type()).to_string()
						and core_exprs_equal(
							binding.rhs,
							LiteralExpr(
								IntLiteral(1),
								core_int_type(),
								compiler_core_source_loc(source_span()),
							),
						)
						and core_exprs_equal(
							block.body,
							VarExpr(
								{
									name = "task",
									uniq = 0,
									def_id = None
								},
								core_task_result_int_type(),
								compiler_core_source_loc(source_span()),
							),
						)
						and block.timeout.is_none()
						and block.max_threads.is_none()
						and core_type_to_json(
							typ,
						).to_string() == core_type_to_json(core_task_result_int_type()).to_string()
					)
				None:
					False
		_:
			False


