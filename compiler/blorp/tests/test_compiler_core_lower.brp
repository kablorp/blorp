func test_lowers_result_with_try_error_map() -> Bool:
	error_map: TypedWithErrorMap = {
		name = ident("code"),
		value = string_expr("mapped"),
		span = source_span()
	}
	binding: TypedWithBinding = {
		name = ident("file"),
		annotation = None,
		value = TypedNameExpr(ident("opened"), expr_info(result_file_int_type())),
		kind = ParsedWithTryBinding,
		error_map = Some(error_map),
		cleanup_function = Some("blorp_file_close"),
		resource_loop_item_name = None,
		span = source_span()
	}
	expr = TypedWithExpr(
		binding,
		TypedNameExpr(ident("done"), expr_info(result_int_string_type())),
		source_span(),
		expr_info(result_int_string_type()),
	)

	match lower_typed_expr(expr):
		Ok(lowered):
			-- This post-return traversal detects escaped match data whose owner was released.
			json = core_expr_to_json(lowered).to_string()

			(
				json.contains("\"name\":\"code\"")
				and json.contains("mapped")
				and json.contains("blorp_result_err")
				and json.contains("blorp_file_close")
			)
		Err(_):
			False


func test_lowers_while_expression() -> Bool:
	body = TypedBlockExpr(
		[int_expr("1"), TypedBreakExpr(source_span(), expr_info(TYPE_VOID))],
		source_span(),
		expr_info(TYPE_VOID),
	)
	expr = TypedWhileExpr(bool_expr(True), body, source_span(), expr_info(TYPE_VOID))

	match lower_typed_expr(expr):
		Ok(WhileExpr(condition, lowered_body, typ, _)):
			body_ok: Bool = match lowered_body:
				SeqExpr(_, BreakExpr(_, _)):
					True
				_:
					False

			body_ok and core_exprs_equal(
				condition,
				LiteralExpr(
					BoolLiteral(True),
					core_bool_type(),
					compiler_core_source_loc(source_span()),
				),
			) and core_type_to_json(typ).to_string() == core_type_to_json(VoidType).to_string()
		_:
			False


func test_lowers_range_for_expression() -> Bool:
	iterable = TypedRangeExpr(
		int_expr("1"),
		int_expr("3"),
		source_span(),
		expr_info(SemanticNamedType("Range", [])),
	)
	body = TypedBreakExpr(source_span(), expr_info(TYPE_VOID))
	expr = TypedForExpr(
		ParsedForNameBinder(ident("i")),
		iterable,
		None,
		body,
		source_span(),
		expr_info(TYPE_VOID),
	)

	match lower_typed_expr(expr):
		Ok(ForRangeExpr(binder, start, end_value, lowered_body, typ, _)):
			(
				binder.variable.name == "i"
				and core_type_to_json(
					binder.typ,
				).to_string() == core_type_to_json(core_int_type()).to_string()
				and core_loop_range_direction_to_string(
					binder.range_direction,
				) == "may_run_backward"
				and core_exprs_equal(
					start,
					LiteralExpr(
						IntLiteral(1),
						core_int_type(),
						compiler_core_source_loc(source_span()),
					),
				)
				and core_exprs_equal(
					end_value,
					LiteralExpr(
						IntLiteral(3),
						core_int_type(),
						compiler_core_source_loc(source_span()),
					),
				)
				and core_exprs_equal(
					lowered_body,
					BreakExpr(VoidType, compiler_core_source_loc(source_span())),
				)
				and core_type_to_json(typ).to_string() == core_type_to_json(VoidType).to_string()
			)
		_:
			False


func test_lowers_first_class_range_for_once() -> Bool:
	range_type = SemanticNamedType("Range", [])
	make_range = TypedNameExpr(
		ident("make_range"),
		expr_info(semantic_function_type(True, [], range_type)),
	)
	iterable = TypedCallExpr(make_range, [], source_span(), expr_info(range_type))
	body = TypedBreakExpr(source_span(), expr_info(TYPE_VOID))
	expr = TypedForExpr(
		ParsedForNameBinder(ident("i")),
		iterable,
		None,
		body,
		source_span(),
		expr_info(TYPE_VOID),
	)

	match lower_typed_expr(expr):
		Ok(LetExpr(range_var, False, range_core_type, range_rhs, loop)):
			rhs_ok: Bool = match range_rhs:
				CallExpr(_, VarExpr(callee, _, _), [], _, _):
					callee.name == "make_range"
				_:
					False

			loop_ok: Bool = match loop:
				ForRangeExpr(binder, start, end_value, BreakExpr(_, _), _, _):
					start_ok: Bool = match start:
						FieldExpr(VarExpr(start_var, _, _), "start", start_type, _):
							(
								start_var.name == range_var.name
								and core_types_equal(start_type, core_int_type())
							)
						_:
							False

					end_ok: Bool = match end_value:
						FieldExpr(VarExpr(end_var, _, _), "end", end_type, _):
							(
								end_var.name == range_var.name
								and core_types_equal(end_type, core_int_type())
							)
						_:
							False

					(
						binder.variable.name == "i"
						and core_types_equal(binder.typ, core_int_type())
						and start_ok
						and end_ok
					)
				_:
					False

			range_var.name.starts_with("__loop_range_source_") and core_types_equal(
				range_core_type,
				NamedType("Range", []),
			) and rhs_ok and loop_ok
		_:
			False


