func test_lowers_block_local_var_decl_to_let() -> Bool:
	payload: CompilerTypedVarDeclPayload = {
		name = ident("x"),
		annotation = Some(int_type()),
		initializer = int_expr("1"),
		is_mutable = True,
		span = source_span()
	}
	expr = CompilerTypedBlockExpr(
		[
			CompilerTypedVarDeclExpr(payload, expr_info(compiler_type_void())),
			CompilerTypedNameExpr(ident("x"), expr_info(int_type())),
		],
		source_span(),
		expr_info(int_type()),
	)

	match lower_typed_expr(expr):
		Ok(LetExpr(variable, is_mutable, bind_type, rhs, body)):
			(
				variable.name == "x"
				and is_mutable
				and core_type_to_json(
					bind_type,
				).to_string() == core_type_to_json(core_int_type()).to_string()
				and core_exprs_equal(
					rhs,
					LiteralExpr(
						IntLiteral(1),
						core_int_type(),
						compiler_core_source_loc(source_span()),
					),
				)
				and core_exprs_equal(
					body,
					VarExpr(
						{
							name = "x",
							uniq = 0,
							def_id = None
						},
						core_int_type(),
						compiler_core_source_loc(source_span()),
					),
				)
			)
		_:
			False


func test_lowers_tuple_destruct_in_block() -> Bool:
	destruct = CompilerTypedTupleDestructExpr(
		[ident("a"), ident("b")],
		tuple_int_bool_expr(),
		source_span(),
		expr_info(compiler_type_void()),
	)
	tail = CompilerTypedNameExpr(ident("a"), expr_info(int_type()))
	expr = CompilerTypedBlockExpr(
		[destruct, tail],
		source_span(),
		expr_info(int_type()),
	)

	match lower_typed_expr(expr):
		Ok(LetExpr(temp_var, is_mutable, bind_type, bind_rhs, body)):
			match body:
				LetExpr(first_var, first_mutable, first_type, first_rhs, after_first):
					match after_first:
						LetExpr(second_var, second_mutable, second_type, second_rhs, final_body):
							first_rhs_ok: Bool = match first_rhs:
								TupleFieldExpr(tuple_ref, index, field_type, _):
									(
										index == 0
										and core_types_equal(field_type, core_int_type())
										and core_exprs_equal(
											tuple_ref,
											VarExpr(
												temp_var,
												core_tuple_int_bool_type(),
												compiler_core_source_loc(source_span()),
											),
										)
									)
								_:
									False

							second_rhs_ok: Bool = match second_rhs:
								TupleFieldExpr(tuple_ref, index, field_type, _):
									(
										index == 1
										and core_types_equal(field_type, core_bool_type())
										and core_exprs_equal(
											tuple_ref,
											VarExpr(
												temp_var,
												core_tuple_int_bool_type(),
												compiler_core_source_loc(source_span()),
											),
										)
									)
								_:
									False

							(
								temp_var.name.starts_with("__td_")
								and not is_mutable
								and core_types_equal(bind_type, core_tuple_int_bool_type())
								and core_exprs_equal(
									bind_rhs,
									TupleExpr(
										[
											LiteralExpr(
												IntLiteral(1),
												core_int_type(),
												compiler_core_source_loc(source_span()),
											),
											LiteralExpr(
												BoolLiteral(True),
												core_bool_type(),
												compiler_core_source_loc(source_span()),
											),
										],
										core_tuple_int_bool_type(),
										compiler_core_source_loc(source_span()),
									),
								)
								and first_var.name == "a"
								and not first_mutable
								and core_types_equal(first_type, core_int_type())
								and first_rhs_ok
								and second_var.name == "b"
								and not second_mutable
								and core_types_equal(second_type, core_bool_type())
								and second_rhs_ok
								and core_exprs_equal(
									final_body,
									VarExpr(
										{
											name = "a",
											uniq = 0,
											def_id = None
										},
										core_int_type(),
										compiler_core_source_loc(source_span()),
									),
								)
							)
						_:
							False
				_:
					False
		_:
			False


func test_lowers_tuple_destruct_skipping_wildcard() -> Bool:
	destruct = CompilerTypedTupleDestructExpr(
		[ident("_"), ident("b")],
		tuple_int_bool_expr(),
		source_span(),
		expr_info(compiler_type_void()),
	)
	tail = CompilerTypedNameExpr(ident("b"), expr_info(compiler_type_bool()))
	expr = CompilerTypedBlockExpr(
		[destruct, tail],
		source_span(),
		expr_info(compiler_type_bool()),
	)

	match lower_typed_expr(expr):
		Ok(LetExpr(temp_var, _, bind_type, _, body)):
			match body:
				LetExpr(bound_var, is_mutable, field_type, rhs, final_body):
					rhs_ok: Bool = match rhs:
						TupleFieldExpr(tuple_ref, index, rhs_type, _):
							(
								index == 1
								and core_types_equal(rhs_type, core_bool_type())
								and core_exprs_equal(
									tuple_ref,
									VarExpr(
										temp_var,
										core_tuple_int_bool_type(),
										compiler_core_source_loc(source_span()),
									),
								)
							)
						_:
							False

					(
						core_types_equal(bind_type, core_tuple_int_bool_type())
						and bound_var.name == "b"
						and not is_mutable
						and core_types_equal(field_type, core_bool_type())
						and rhs_ok
						and core_exprs_equal(
							final_body,
							VarExpr(
								{
