func test_lowers_function_decl_preserving_callable_id() -> Bool:
	info: TypedFunctionInfo = {
		decl = parsed_function_decl(),
		callable_id = Some(42),
		effective_type_params = [make_bound_type_param("T", [])],
		param_types = [int_type()],
		source_return_type = Some(int_type()),
		semantic_return_type = int_type(),
		body = Some(int_expr("1"))
	}
	context = compiler_core_lower_context(100, None)

	match lower_typed_decl(context, TypedFunctionDecl(info)):
		Ok(result):
			match result.decl:
				FunctionDecl(func_info):
					(
						result.context.next_def_id == 100
						and func_info.def_id == 42
						and func_info.name == "answer"
						and func_info.type_params == ["T"]
						and func_info.params.length() == 1
						and func_info.body.is_some()
					)
				_:
					False
		Err(_):
			False


func test_lowers_tuple_pattern_parameter_bindings() -> Bool:
	info: TypedFunctionInfo = {
		decl = { parsed_function_decl() |
			params = [parsed_tuple_param(["left", "_"])],
			return_type = Some(parsed_type_int())
		},
		callable_id = Some(43),
		effective_type_params = [],
		param_types = [SemanticTupleType([int_type(), TYPE_BOOL])],
		source_return_type = Some(int_type()),
		semantic_return_type = int_type(),
		body = Some(TypedNameExpr(ident("left"), expr_info(int_type())))
	}

	match lower_typed_decl(
		compiler_core_lower_context(100, None),
		TypedFunctionDecl(info),
	):
		Ok(result):
			match result.decl:
				FunctionDecl(function):
					match (function.params, function.body):
						([parameter], Some(LetExpr(variable, False, bind_type, rhs, body))):
							(
								parameter.name.name.starts_with("__pattern_param_0_")
								and variable.name == "left"
								and core_types_equal(bind_type, core_int_type())
								and match rhs:
									TupleFieldExpr(VarExpr(source, source_type, _), 0, field_type, _):
										(
											source.name == parameter.name.name
											and core_types_equal(source_type, parameter.typ)
											and core_types_equal(field_type, core_int_type())
										)
									_:
										False
								and match body:
									VarExpr(body_var, body_type, _):
										(
											body_var.name == "left"
											and core_types_equal(body_type, core_int_type())
										)
									_:
										False
							)
						_:
							False
				_:
					False
		Err(_):
			False


