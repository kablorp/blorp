pure func source_file() -> CompilerSourceFile:
	compiler_source_file("core_lower.brp", "core_lower", "func main(x: Int) -> Int: x + 1")


pure func source_span() -> CompilerSourceSpan:
	src: CompilerSourceFile = source_file()
	start: CompilerCursor = compiler_source_cursor_at(src, 0)
	finish: CompilerCursor = compiler_source_cursor_at(src, 4)
	compiler_source_span(src, start, finish)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, source_span())


pure func int_type() -> SemanticType:
	TYPE_INT


pure func core_int_type() -> CoreType:
	NamedType("Int", [])


pure func core_bool_type() -> CoreType:
	NamedType("Bool", [])


pure func core_function_type() -> CoreType:
	FunctionType(True, [core_int_type()], core_int_type())


pure func tuple_int_bool_type() -> SemanticType:
	SemanticTupleType([int_type(), TYPE_BOOL])


pure func core_tuple_int_bool_type() -> CoreType:
	TupleType([core_int_type(), core_bool_type()])


pure func function_type() -> SemanticType:
	semantic_function_type(True, [int_type()], int_type())


pure func list_int_type() -> SemanticType:
	type_list(int_type())


pure func set_int_type() -> SemanticType:
	SemanticNamedType("Set", [int_type()])


pure func vector_int_type() -> SemanticType:
	SemanticArrayType(int_type(), [SemanticConstIntType(2)])


pure func matrix_int_type() -> SemanticType:
	SemanticArrayType(
		int_type(),
		[SemanticConstIntType(2), SemanticConstIntType(3)],
	)


pure func parallel_vector_int_type() -> SemanticType:
	SemanticNamedType(
		"ParallelVector",
		[int_type(), SemanticConstIntType(2)],
	)


pure func parallel_matrix_int_type() -> SemanticType:
	SemanticNamedType(
		"ParallelMatrix",
		[int_type(), SemanticConstIntType(2), SemanticConstIntType(3)],
	)


pure func dict_int_int_type() -> SemanticType:
	SemanticNamedType(
		"Dict",
		[int_type(), int_type()],
	)


pure func channel_int_type() -> SemanticType:
	SemanticNamedType("Channel", [int_type()])


pure func stream_int_type() -> SemanticType:
	SemanticNamedType("Stream", [int_type()])


pure func resource_source_file_type() -> SemanticType:
	SemanticNamedType(
		"std/stream::ResourceSource",
		[file_resource_type(), TYPE_STRING],
	)


pure func duration_type() -> SemanticType:
	SemanticNamedType("std/units::Duration", [])


pure func core_duration_type() -> CoreType:
	NamedType("std_units__Duration", [])


pure func concurrency_error_type() -> SemanticType:
	SemanticNamedType("ConcurrencyError", [])


pure func task_result_int_type() -> SemanticType:
	SemanticNamedType(
		"Result",
		[int_type(), concurrency_error_type()],
	)


pure func core_task_result_int_type() -> CoreType:
	NamedType(
		"Result",
		[core_int_type(), NamedType("ConcurrencyError", [])],
	)


pure func option_int_type() -> SemanticType:
	SemanticNamedType("Option", [int_type()])


pure func core_option_int_type() -> CoreType:
	NamedType("Option", [core_int_type()])


pure func result_int_string_type() -> SemanticType:
	SemanticNamedType(
		"Result",
		[int_type(), TYPE_STRING],
	)


pure func core_result_int_string_type() -> CoreType:
	NamedType(
		"Result",
		[core_int_type(), NamedType("String", [])],
	)


pure func file_resource_type() -> SemanticType:
	SemanticNamedType("File", [])


pure func core_file_resource_type() -> CoreType:
	NamedType("File", [])


pure func result_file_string_type() -> SemanticType:
	SemanticNamedType(
		"Result",
		[file_resource_type(), TYPE_STRING],
	)


pure func result_file_int_type() -> SemanticType:
	SemanticNamedType(
		"Result",
		[file_resource_type(), int_type()],
	)


pure func core_types_equal(left: CoreType, right: CoreType) -> Bool:
	core_type_to_json(left).to_string() == core_type_to_json(right).to_string()


pure func expr_info(typ: SemanticType) -> TypedExprInfo:
	{
		source_type = None,
		origin = SynthesizedOrigin("core lower test"),
		value_slot = KeptValueSlot(typ),
		proofs = UNREFINED_BINDING,
		resolved_call = None,
		resolved_definition_id = None,
		resource_dependencies = []
	}


pure func expr_info_with_value_type(
	semantic_type: SemanticType,
	value_type: SemanticType,
) -> TypedExprInfo:
	{
		source_type = None,
		origin = SynthesizedOrigin("core lower test"),
		value_slot = WidenedValueSlot(semantic_type, value_type, MutableBindingWidening),
		proofs = UNREFINED_BINDING,
		resolved_call = None,
		resolved_definition_id = None,
		resource_dependencies = []
	}


pure func expr_info_with_resolved(typ: SemanticType, resolved: ResolvedCallInfo) -> TypedExprInfo:
	{ expr_info(typ) | resolved_call = Some(resolved) }


pure func resolved_call_info(callee_name: String, target: ResolvedCallTarget) -> ResolvedCallInfo:
	{
		callee_name = callee_name,
		source_name = callee_name,
		purity = Pure,
		target = target,
		instantiated_params = [int_type()],
		instantiated_return = int_type(),
		resource_args = RejectResourceArgs,
		dim_constraints = [],
		loop_producer = None
	}


pure func int_expr(text: String) -> TypedExpr:
	TypedIntLiteralExpr(text, source_span(), expr_info(int_type()))


pure func float_expr(text: String) -> TypedExpr:
	TypedFloatLiteralExpr(text, source_span(), expr_info(SemanticNamedType("Float", [])))


pure func bool_expr(value: Bool) -> TypedExpr:
	TypedBoolLiteralExpr(value, source_span(), expr_info(TYPE_BOOL))


pure func string_expr(value: String) -> TypedExpr:
	TypedStringLiteralExpr(value, source_span(), expr_info(TYPE_STRING))


pure func tuple_int_bool_expr() -> TypedExpr:
	TypedTupleExpr(
		[int_expr("1"), bool_expr(True)],
		source_span(),
		expr_info(tuple_int_bool_type()),
	)


pure func typed_concurrent_binding(name: String, value: TypedExpr) -> TypedConcurrentBinding:
	{
		name = ident(name),
		annotation = None,
		value = value,
		span = source_span(),
		info = expr_info(task_result_int_type())
	}


pure func parsed_int_expr(text: String) -> ParsedExpr:
	ParsedIntLiteralExpr(text, source_span())


pure func parsed_type_int() -> ParsedTypeExpr:
	ParsedNamedType(ident("Int"), [], source_span())


pure func parsed_type_string() -> ParsedTypeExpr:
	ParsedNamedType(ident("String"), [], source_span())


pure func parsed_param(name: String) -> ParsedParam:
	{
		binder = ParsedParamNameBinder(ident(name)),
		type_expr = Some(parsed_type_int()),
		span = source_span()
	}


pure func parsed_tuple_param(names: List[String]) -> ParsedParam:
	{
		binder = ParsedParamTupleBinder(
			names.map(ident),
			source_span(),
		),
		type_expr = None,
		span = source_span()
	}


pure func parsed_field(name: String, type_expr: ParsedTypeExpr) -> ParsedFieldDecl:
	{
		name = ident(name),
		type_expr = type_expr,
		span = source_span()
	}


pure func parsed_function_decl() -> ParsedFunctionDecl:
	{
		name = ident("answer"),
		keyword_span = Some(source_span()),
		type_params = [],
		params = [parsed_param("x")],
		return_type = Some(parsed_type_int()),
		dim_constraints = [],
		body = Some(parsed_int_expr("1")),
		is_pure = True,
		annotations = [],
		doc = None,
		span = source_span()
	}


pure func parsed_type_alias_decl() -> ParsedTypeAliasDecl:
	{
		name = ident("Count"),
		type_params = [],
		target = parsed_type_int(),
		is_opaque = True,
		doc = None,
		span = source_span()
	}


pure func parsed_trait_method_decl() -> ParsedTraitMethodDecl:
	{
		name = ident("display"),
		params = [parsed_param("value")],
		return_type = Some(parsed_type_int()),
		body = None,
		is_pure = True,
		span = source_span()
	}


pure func parsed_trait_decl() -> ParsedTraitDecl:
	{
		name = ident("Display"),
		type_params = [],
		supertraits = [ident("Equatable")],
		methods = [parsed_trait_method_decl()],
		doc = None,
		span = source_span()
	}


pure func parsed_impl_decl() -> ParsedImplDecl:
	{
		trait_name = ident("Display"),
		for_type = parsed_type_int(),
		methods = [parsed_function_decl()],
		doc = None,
		span = source_span()
	}


pure func parsed_foreign_function_decl() -> ParsedForeignFunctionDecl:
	{
		name = ident("native_answer"),
		params = [parsed_param("x")],
		return_type = parsed_type_int(),
		c_name = Some("c_native_answer"),
		is_pure = False,
		is_private = False,
		annotations = [],
		span = source_span()
	}


pure func parsed_record_decl(is_struct: Bool) -> ParsedRecordDecl:
	{
		name = ident("Point"),
		type_params = [],
		fields = [
			parsed_field("x", parsed_type_int()),
			parsed_field("label", parsed_type_string()),
		],
		is_struct = is_struct,
		doc = None,
		span = source_span()
	}


pure func parsed_variant(name: String, fields: List[ParsedTypeExpr]) -> ParsedVariantDecl:
	{
		name = ident(name),
		fields = fields,
		span = source_span()
	}


pure func parsed_union_decl(is_enum: Bool) -> ParsedUnionDecl:
	variants: List[ParsedVariantDecl] = if is_enum:
		[parsed_variant("First", []), parsed_variant("Second", [])]
	else:
		[parsed_variant("First", [parsed_type_int()]), parsed_variant("Second", [])]

	{
		name = ident("Choice"),
		type_params = [],
		variants = variants,
		is_enum = is_enum,
		doc = None,
		span = source_span()
	}


pure func parsed_type_param(name: String) -> ParsedTypeParamDecl:
	{
		name = ident(name),
		bounds = [],
		span = source_span()
	}


pure func parsed_var_decl() -> ParsedVarDecl:
	{
		name = ident("answer"),
		type_expr = Some(parsed_type_int()),
		value = parsed_int_expr("42"),
		is_mutable = False,
		span = source_span()
	}


pure func typed_record_field(
	name: String,
	source_type: SemanticType,
	semantic_type: SemanticType,
) -> TypedRecordFieldInfo:
	{
		name = name,
		source_type = source_type,
		semantic_type = semantic_type,
		definition_id = None,
		declaration_span = source_span(),
		selection_span = source_span()
	}


pure func typed_record_info(is_struct: Bool) -> TypedRecordInfo:
	{
		decl = parsed_record_decl(is_struct),
		fields = [
			typed_record_field("x", int_type(), int_type()),
			typed_record_field("label", TYPE_STRING, TYPE_STRING),
		]
	}


pure func typed_union_variant(
	name: String,
	fields: List[SemanticType],
	tag: Int,
	def_id: Option[Int],
) -> TypedUnionVariantInfo:
	{
		name = name,
		fields = fields,
		tag = tag,
		def_id = def_id,
		declaration_span = source_span(),
		selection_span = source_span()
	}


pure func typed_union_info(is_enum: Bool) -> TypedUnionInfo:
	variants: List[TypedUnionVariantInfo] = if is_enum:
		[
			typed_union_variant("First", [], 0, Some(101)),
			typed_union_variant("Second", [], 1, Some(102)),
		]
	else:
		[
			typed_union_variant("First", [int_type()], 0, Some(101)),
			typed_union_variant("Second", [], 1, Some(102)),
		]

	{
		decl = parsed_union_decl(is_enum),
		variants = variants
	}


pure func typed_generic_union_info() -> TypedUnionInfo:
	{
		decl = { parsed_union_decl(False) | type_params = [parsed_type_param("T")] },
		variants = [
			typed_union_variant("First", [SemanticTypeVar("T")], 0, Some(101)),
			typed_union_variant("Second", [], 1, Some(102)),
		]
	}


pure func core_exprs_equal(left: CoreExpr, right: CoreExpr) -> Bool:
	core_expr_to_json(left).to_string() == core_expr_to_json(right).to_string()


pure func lower_typed_program_fixture_to_json(
	program: TypedProgram,
	next_def_id: Int,
) -> Result[String, CompilerCoreLowerError]:
	result ?= lower_typed_program(
		compiler_core_lower_context(next_def_id, None),
		program,
	)
	Ok(core_program_to_json(result.program).to_string())


func test_lowers_int_literal_with_known_location() -> Bool:
	match lower_typed_expr(int_expr("42")):
		Ok(expr):
			expected = LiteralExpr(
				IntLiteral(42),
				core_int_type(),
				compiler_core_source_loc(source_span()),
			)
			core_exprs_equal(expr, expected)
		Err(_):
			False


func test_lowers_special_float_literals() -> Bool:
	match (
		lower_typed_expr(float_expr("inf")),
		lower_typed_expr(float_expr("-inf")),
		lower_typed_expr(float_expr("nan")),
	):
		(Ok(LiteralExpr(FloatInfinityLiteral, _, _)), Ok(LiteralExpr(FloatNegInfinityLiteral, _, _)), Ok(LiteralExpr(FloatNanLiteral, _, _))):
			True
		_:
			False


func test_lowers_debug_block_for_core_debug() -> Bool:
	expr = TypedDebugBlockExpr(int_expr("1"), source_span(), expr_info(TYPE_VOID))

	match lower_typed_expr(expr):
		Ok(DebugBlockExpr(LiteralExpr(IntLiteral(1), _, _), VoidType, _)):
			True
		_:
			False


func test_lowers_wide_int_literal_when_it_does_not_fit_int() -> Bool:
	match lower_typed_expr(int_expr("999999999999999999999999999999")):
		Ok(expr):
			expected = LiteralExpr(
				WideIntLiteral("999999999999999999999999999999"),
				core_int_type(),
				compiler_core_source_loc(source_span()),
			)
			core_exprs_equal(expr, expected)
		Err(_):
			False


func test_lowers_expression_value_type_after_widening() -> Bool:
	expr = TypedIntLiteralExpr(
		"1",
		source_span(),
		expr_info_with_value_type(SemanticConstIntType(1), int_type()),
	)

	match lower_typed_expr(expr):
		Ok(LiteralExpr(IntLiteral(1), typ, _)):
			core_type_to_json(typ).to_string() == core_type_to_json(core_int_type()).to_string()
		_:
			False


func test_lowers_const_int_expression_value_type_as_int() -> Bool:
	expr = TypedIntLiteralExpr("7", source_span(), expr_info(SemanticConstIntType(7)))

	match lower_typed_expr(expr):
		Ok(LiteralExpr(IntLiteral(7), typ, _)):
			core_type_to_json(typ).to_string() == core_type_to_json(core_int_type()).to_string()
		_:
			False


func test_lowers_string_interpolation_without_core_sugar() -> Bool:
	expr = TypedStringInterpolationPartsExpr(
		[TypedInterpolationLiteral("value="), TypedInterpolationExpr(int_expr("7"))],
		False,
		source_span(),
		expr_info(TYPE_STRING),
	)

	match lower_typed_expr(expr):
		Ok(CallExpr(BuiltinCall("blorp_string_concat_consume"), _, [LiteralExpr(StringLiteral("value="), _, _), CallExpr(BuiltinCall("blorp_to_string"), _, [_], _, _)], _, _)):
			True
		_:
			False


