func test_lowers_lambda_expression() -> Bool:
	param: TypedLambdaParam = {
		name = ident("x"),
		source_type = Some(int_type()),
		param_type = int_type()
	}
	body = TypedNameExpr(ident("x"), expr_info(int_type()))
	expr = TypedLambdaExpr(
		True,
		[param],
		Some(int_type()),
		body,
		source_span(),
		expr_info(function_type()),
	)

	match lower_typed_expr(expr):
		Ok(LambdaExpr(params, return_type, lowered_body, is_pure, typ, _)):
			match params.get(0):
				Some(first):
					(
						params.length() == 1
						and first.name.name == "x"
						and is_pure
						and core_type_to_json(
							first.typ,
						).to_string() == core_type_to_json(core_int_type()).to_string()
						and core_type_to_json(
							return_type,
						).to_string() == core_type_to_json(core_int_type()).to_string()
						and core_type_to_json(
							typ,
						).to_string() == core_type_to_json(core_function_type()).to_string()
						and core_exprs_equal(
							lowered_body,
