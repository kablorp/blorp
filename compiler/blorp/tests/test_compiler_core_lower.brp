		CoreCallKind(ClosureCall, IntrinsicCall, UserCall),
		CoreDecl(FunctionDecl, GlobalDecl),
		CoreExpr(
			AssignExpr,
			BinaryExpr,
			CallExpr,
			DictExpr,
			FieldExpr,
			IfExpr,
			LetExpr,
			ListConstructExpr,
