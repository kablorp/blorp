func test_lowers_windows_loop_view_to_slices() -> Bool:
	source = TypedNameExpr(ident("values"), expr_info(vector_int_type()))
	window_type = SemanticArrayType(int_type(), [SemanticConstIntType(2)])
	iterable = TypedCallExpr(
		TypedNameExpr(
			ident("windows"),
			expr_info(function_type()),
		),
		[source, int_expr("2")],
		source_span(),
		expr_info(window_type),
	)
	body = TypedNameExpr(ident("window"), expr_info(window_type))
	expr = TypedForExpr(
		ParsedForNameBinder(ident("window")),
		iterable,
		Some(TypedWindowsLoopView(2, window_type)),
		body,
		source_span(),
		expr_info(TYPE_VOID),
	)

	match lower_typed_expr(expr):
		Ok(LetExpr(source_var, False, source_type, VarExpr(values_var, _, _), loop)):
			match loop:
				ForRangeExpr(index_binder, _, end_value, loop_body, typ, _):
					match loop_body:
						LetExpr(window_var, False, lowered_window_type, slice_call, VarExpr(body_var, _, _)):
							(
								values_var.name == "values"
								and source_var.name.starts_with("__loop_windows_source_")
								and index_binder.variable.name.starts_with("__loop_windows_index_")
								and window_var.name == "window"
								and body_var.name == "window"
								and core_types_equal(
									source_type,
									compiler_core_lower_type(vector_int_type()).get_or(VoidType),
								)
								and core_types_equal(
									lowered_window_type,
									compiler_core_lower_type(window_type).get_or(VoidType),
								)
								and core_expr_to_json(end_value)
									.to_string()
									.contains("length")
								and core_expr_to_json(slice_call)
									.to_string()
									.contains("checked_slice")
								and core_expr_to_json(slice_call)
									.to_string()
									.contains(source_var.name)
								and core_types_equal(typ, VoidType)
							)
						_:
							False
				_:
					False
		_:
			False


func test_lowers_enumerate_tuple_loop_view() -> Bool:
	source = TypedNameExpr(ident("values"), expr_info(vector_int_type()))
	iterable = TypedCallExpr(
		TypedNameExpr(ident("enumerate"), expr_info(function_type())),
		[source],
		source_span(),
		expr_info(SemanticTupleType([SemanticRangeType(SemanticConstIntType(2)), int_type()])),
	)
	body = TypedNameExpr(ident("value"), expr_info(int_type()))
	expr = TypedForExpr(
		ParsedForTupleBinder(
			[ident("index"), ident("value")],
			source_span(),
		),
		iterable,
		Some(
			TypedEnumerateLoopView(
				SemanticTupleType([SemanticRangeType(SemanticConstIntType(2)), int_type()]),
			),
		),
		body,
		source_span(),
		expr_info(TYPE_VOID),
	)

	match lower_typed_expr(expr):
		Ok(LetExpr(source_var, False, source_type, VarExpr(values_var, _, _), loop)):
			match loop:
				ForRangeExpr(binder, _, length_call, loop_body, typ, _):
					length_source: Option[String] = match length_call:
						CallExpr(UnknownCall, VarExpr(length_var, _, _), [VarExpr(value, _, _)], _, _):
							if length_var.name == "length":
								Some(value.name)
							else:
								None
						_:
							None

					element_source: Option[String] = match loop_body:
						LetExpr(value_var, False, value_type, element_call, VarExpr(body_var, _, _)):
							match element_call:
								CallExpr(UnknownCall, VarExpr(get_var, _, _), [VarExpr(value, _, _), VarExpr(index_var, _, _)], result_type, _):
									if (
										value_var.name == "value"
										and body_var.name == "value"
										and get_var.name == "checked_get"
										and index_var.name == "index"
										and core_types_equal(value_type, core_int_type())
										and core_types_equal(result_type, core_int_type())
									):
										Some(value.name)
									else:
										None
								_:
									None
						_:
							None

					(
						values_var.name == "values"
						and binder.variable.name == "index"
						and core_types_equal(binder.typ, RangeType)
						and core_types_equal(
							source_type,
							compiler_core_lower_type(vector_int_type()).get_or(VoidType),
						)
						and length_source == Some(source_var.name)
						and element_source == Some(source_var.name)
						and core_types_equal(typ, VoidType)
					)
				_:
					False
		_:
			False


