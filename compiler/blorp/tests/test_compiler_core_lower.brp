pure func source_file() -> CompilerSourceFile:
	compiler_source_file("core_lower.brp", "core_lower", "func main(x: Int) -> Int: x + 1")


pure func source_span() -> CompilerSourceSpan:
	src: CompilerSourceFile = source_file()
	start: CompilerCursor = compiler_source_cursor_at(src, 0)
	finish: CompilerCursor = compiler_source_cursor_at(src, 4)
	compiler_source_span(src, start, finish)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, source_span())


pure func int_type() -> CompilerType:
	compiler_type_int()


pure func core_int_type() -> CoreType:
	NamedType("Int", [])


pure func core_bool_type() -> CoreType:
	NamedType("Bool", [])


pure func tuple_int_bool_type() -> CompilerType:
	CompilerTupleType([int_type(), compiler_type_bool()])


pure func core_tuple_int_bool_type() -> CoreType:
	TupleType([core_int_type(), core_bool_type()])


pure func function_type() -> CompilerType:
	compiler_function_type(True, [int_type()], int_type())


pure func list_int_type() -> CompilerType:
	compiler_type_list(int_type())


pure func set_int_type() -> CompilerType:
	CompilerNamedType("Set", [int_type()])


pure func vector_int_type() -> CompilerType:
	CompilerArrayType(int_type(), [CompilerConstIntType(2)])


pure func dict_int_int_type() -> CompilerType:
	CompilerNamedType(
		"Dict",
		[int_type(), int_type()],
	)


pure func channel_int_type() -> CompilerType:
	CompilerNamedType("Channel", [int_type()])


pure func stream_int_type() -> CompilerType:
	CompilerNamedType("Stream", [int_type()])


pure func duration_type() -> CompilerType:
	CompilerNamedType("Duration", [])


pure func concurrency_error_type() -> CompilerType:
	CompilerNamedType("ConcurrencyError", [])


pure func task_result_int_type() -> CompilerType:
	CompilerNamedType(
		"Result",
		[int_type(), concurrency_error_type()],
	)


pure func core_task_result_int_type() -> CoreType:
	NamedType(
		"Result",
		[core_int_type(), NamedType("ConcurrencyError", [])],
	)


pure func option_int_type() -> CompilerType:
	CompilerNamedType("Option", [int_type()])


pure func core_option_int_type() -> CoreType:
	NamedType("Option", [core_int_type()])


pure func result_int_string_type() -> CompilerType:
	CompilerNamedType(
		"Result",
		[int_type(), compiler_type_string()],
	)


pure func core_result_int_string_type() -> CoreType:
	NamedType(
		"Result",
		[core_int_type(), NamedType("String", [])],
	)


pure func file_resource_type() -> CompilerType:
	CompilerNamedType("File", [])


pure func core_file_resource_type() -> CoreType:
	NamedType("File", [])


pure func result_file_string_type() -> CompilerType:
	CompilerNamedType(
		"Result",
		[file_resource_type(), compiler_type_string()],
	)


pure func result_file_int_type() -> CompilerType:
	CompilerNamedType(
		"Result",
		[file_resource_type(), int_type()],
	)


pure func core_types_equal(left: CoreType, right: CoreType) -> Bool:
	core_type_to_json(left).to_string() == core_type_to_json(right).to_string()


pure func expr_info(typ: CompilerType) -> CompilerTypedExprInfo:
	{
		source_type = None,
		semantic_type = typ,
		value_type = typ,
		origin = CompilerSynthesizedOrigin("core lower test"),
		value_slot = {
			semantic_type = typ,
			decision = CompilerTypeKeep(typ)
		},
		proofs = compiler_unrefined_binding(),
		resolved_call = None,
		resource_dependencies = []
	}


pure func expr_info_with_value_type(
	semantic_type: CompilerType,
	value_type: CompilerType,
) -> CompilerTypedExprInfo:
	{
		source_type = None,
		semantic_type = semantic_type,
		value_type = value_type,
		origin = CompilerSynthesizedOrigin("core lower test"),
		value_slot = {
			semantic_type = semantic_type,
			decision = CompilerTypeWiden(semantic_type, value_type, CompilerMutableBinding)
		},
		proofs = compiler_unrefined_binding(),
		resolved_call = None,
		resource_dependencies = []
	}


pure func expr_info_with_resolved(
	typ: CompilerType,
	resolved: CompilerResolvedCallInfo,
) -> CompilerTypedExprInfo:
	{ expr_info(typ) | resolved_call = Some(resolved) }


pure func resolved_call_info(
	callee_name: String,
	target: CompilerResolvedCallTarget,
) -> CompilerResolvedCallInfo:
	{
		callee_name = callee_name,
		source_name = callee_name,
		purity = CompilerPure,
		target = target,
		instantiated_params = [int_type()],
		instantiated_return = int_type(),
		resource_args = CompilerRejectResourceArgs,
		dim_constraints = [],
		loop_producer = None
	}


pure func int_expr(text: String) -> CompilerTypedExpr:
	CompilerTypedIntLiteralExpr(text, source_span(), expr_info(int_type()))


pure func bool_expr(value: Bool) -> CompilerTypedExpr:
	CompilerTypedBoolLiteralExpr(value, source_span(), expr_info(compiler_type_bool()))


pure func string_expr(value: String) -> CompilerTypedExpr:
	CompilerTypedStringLiteralExpr(value, source_span(), expr_info(compiler_type_string()))


pure func tuple_int_bool_expr() -> CompilerTypedExpr:
	CompilerTypedTupleExpr(
		[int_expr("1"), bool_expr(True)],
		source_span(),
		expr_info(tuple_int_bool_type()),
	)


pure func typed_concurrent_binding(
	name: String,
	value: CompilerTypedExpr,
) -> CompilerTypedConcurrentBinding:
	{
		name = ident(name),
		annotation = None,
		value = value,
		span = source_span(),
		info = expr_info(task_result_int_type())
	}


pure func parsed_int_expr(text: String) -> ParsedExpr:
	ParsedIntLiteralExpr(text, source_span())


pure func parsed_type_int() -> ParsedTypeExpr:
	ParsedNamedType(ident("Int"), [], source_span())


pure func parsed_type_string() -> ParsedTypeExpr:
	ParsedNamedType(ident("String"), [], source_span())


pure func parsed_param(name: String) -> ParsedParam:
	{
		binder = ParsedParamNameBinder(ident(name)),
		type_expr = Some(parsed_type_int()),
		span = source_span()
	}


pure func parsed_field(name: String, type_expr: ParsedTypeExpr) -> ParsedFieldDecl:
	{
		name = ident(name),
		type_expr = type_expr,
		span = source_span()
	}


pure func parsed_function_decl() -> ParsedFunctionDecl:
	{
		name = ident("answer"),
		type_params = [],
		params = [parsed_param("x")],
		return_type = Some(parsed_type_int()),
		dim_constraints = [],
		body = Some(parsed_int_expr("1")),
		is_pure = True,
		annotations = [],
		doc = None,
		span = source_span()
	}


pure func parsed_type_alias_decl() -> ParsedTypeAliasDecl:
	{
		name = ident("Count"),
		type_params = [],
		target = parsed_type_int(),
		is_opaque = True,
		doc = None,
		span = source_span()
	}


pure func parsed_trait_method_decl() -> ParsedTraitMethodDecl:
	{
		name = ident("display"),
		params = [parsed_param("value")],
		return_type = Some(parsed_type_int()),
		body = None,
		is_pure = True,
		span = source_span()
	}


pure func parsed_trait_decl() -> ParsedTraitDecl:
	{
		name = ident("Display"),
		type_params = [],
		supertraits = [ident("Equatable")],
		methods = [parsed_trait_method_decl()],
		doc = None,
		span = source_span()
	}


pure func parsed_impl_decl() -> ParsedImplDecl:
	{
		trait_name = ident("Display"),
		for_type = parsed_type_int(),
		methods = [parsed_function_decl()],
		doc = None,
		span = source_span()
	}


pure func parsed_foreign_function_decl() -> ParsedForeignFunctionDecl:
	{
		name = ident("native_answer"),
		params = [parsed_param("x")],
		return_type = parsed_type_int(),
		c_name = Some("c_native_answer"),
		is_pure = False,
		is_private = False,
		annotations = [],
		span = source_span()
	}


pure func parsed_record_decl(is_struct: Bool) -> ParsedRecordDecl:
	{
		name = ident("Point"),
		type_params = [],
		fields = [
			parsed_field("x", parsed_type_int()),
			parsed_field("label", parsed_type_string()),
		],
		is_struct = is_struct,
		doc = None,
		span = source_span()
	}


pure func parsed_variant(name: String, fields: List[ParsedTypeExpr]) -> ParsedVariantDecl:
	{
		name = ident(name),
		fields = fields,
		span = source_span()
	}


pure func parsed_union_decl(is_enum: Bool) -> ParsedUnionDecl:
	variants: List[ParsedVariantDecl] = if is_enum:
		[parsed_variant("First", []), parsed_variant("Second", [])]
	else:
		[parsed_variant("First", [parsed_type_int()]), parsed_variant("Second", [])]

	{
		name = ident("Choice"),
		type_params = [],
		variants = variants,
		is_enum = is_enum,
		doc = None,
		span = source_span()
	}


pure func parsed_var_decl() -> ParsedVarDecl:
	{
		name = ident("answer"),
		type_expr = Some(parsed_type_int()),
		value = parsed_int_expr("42"),
		is_mutable = False,
		span = source_span()
	}


pure func typed_record_field(
	name: String,
	source_type: CompilerType,
	semantic_type: CompilerType,
) -> CompilerTypedRecordFieldInfo:
	{
		name = name,
		source_type = source_type,
		semantic_type = semantic_type
	}


pure func typed_record_info(is_struct: Bool) -> CompilerTypedRecordInfo:
	{
		decl = parsed_record_decl(is_struct),
		fields = [
			typed_record_field("x", int_type(), int_type()),
			typed_record_field("label", compiler_type_string(), compiler_type_string()),
		]
	}


pure func typed_union_variant(
	name: String,
	fields: List[CompilerType],
	tag: Int,
	def_id: Option[Int],
) -> CompilerTypedUnionVariantInfo:
	{
		name = name,
		fields = fields,
		tag = tag,
		def_id = def_id
	}


pure func typed_union_info(is_enum: Bool) -> CompilerTypedUnionInfo:
	variants: List[CompilerTypedUnionVariantInfo] = if is_enum:
		[
			typed_union_variant("First", [], 0, Some(101)),
			typed_union_variant("Second", [], 1, Some(102)),
		]
	else:
		[
			typed_union_variant("First", [int_type()], 0, Some(101)),
			typed_union_variant("Second", [], 1, Some(102)),
		]

	{
		decl = parsed_union_decl(is_enum),
		variants = variants
	}


pure func core_exprs_equal(left: CoreExpr, right: CoreExpr) -> Bool:
	core_expr_to_json(left).to_string() == core_expr_to_json(right).to_string()


pure func lower_typed_program_fixture_to_json(
	program: CompilerTypedProgram,
	next_def_id: Int,
) -> Result[String, CompilerCoreLowerError]:
	result ?= lower_typed_program(
		compiler_core_lower_context(next_def_id, None),
		program,
	)
	Ok(core_program_to_json(result.program).to_string())


func test_lowers_int_literal_with_known_location() -> Bool:
	match lower_typed_expr(int_expr("42")):
		Ok(expr):
			expected = LiteralExpr(
				IntLiteral(42),
				core_int_type(),
				compiler_core_source_loc(source_span()),
			)
			core_exprs_equal(expr, expected)
		Err(_):
			False


func test_lowers_wide_int_literal_when_it_does_not_fit_int() -> Bool:
	match lower_typed_expr(int_expr("999999999999999999999999999999")):
		Ok(expr):
			expected = LiteralExpr(
				WideIntLiteral("999999999999999999999999999999"),
				core_int_type(),
				compiler_core_source_loc(source_span()),
			)
			core_exprs_equal(expr, expected)
		Err(_):
			False


func test_lowers_expression_value_type_after_widening() -> Bool:
	expr = CompilerTypedIntLiteralExpr(
		"1",
		source_span(),
		expr_info_with_value_type(CompilerConstIntType(1), int_type()),
	)

	match lower_typed_expr(expr):
		Ok(LiteralExpr(IntLiteral(1), typ, _)):
			core_type_to_json(typ).to_string() == core_type_to_json(core_int_type()).to_string()
		_:
			False


func test_lowers_const_int_expression_value_type_as_int() -> Bool:
	expr = CompilerTypedIntLiteralExpr("7", source_span(), expr_info(CompilerConstIntType(7)))

	match lower_typed_expr(expr):
		Ok(LiteralExpr(IntLiteral(7), typ, _)):
			core_type_to_json(typ).to_string() == core_type_to_json(core_int_type()).to_string()
		_:
			False


func test_lowers_ufcs_identifier_suffix_to_def_id() -> Bool:
	expr = CompilerTypedNameExpr(ident("__ufcs_map#77"), expr_info(int_type()))

	match lower_typed_expr(expr):
		Ok(VarExpr(variable, typ, _)):
			(
				variable.name == "__ufcs_map"
				and variable.def_id == Some(77)
				and core_type_to_json(
					typ,
				).to_string() == core_type_to_json(core_int_type()).to_string()
			)
		_:
			False


func test_lowers_binary_expression() -> Bool:
	expr = CompilerTypedBinaryExpr(
		ParsedAddOp,
		int_expr("1"),
		int_expr("2"),
		source_span(),
		expr_info(int_type()),
	)

	match lower_typed_expr(expr):
		Ok(BinaryExpr(op, left, right, typ, _)):
			core_binary_op_to_string(op) == "add" and core_exprs_equal(
				left,
				LiteralExpr(
					IntLiteral(1),
					core_int_type(),
					compiler_core_source_loc(source_span()),
				),
			) and core_exprs_equal(
				right,
				LiteralExpr(
					IntLiteral(2),
					core_int_type(),
					compiler_core_source_loc(source_span()),
				),
			) and core_type_to_json(
				typ,
			).to_string() == core_type_to_json(core_int_type()).to_string()
		_:
			False


func direct_call_lowers_to_selected_direct_call(
	callee_name: String,
	callable_id: Int,
	origin: CompilerCallableOrigin,
) -> Bool:
	callee = CompilerTypedNameExpr(ident(callee_name), expr_info(function_type()))
	resolved = resolved_call_info(
		callee_name,
		CompilerResolvedDirectCall(callable_id, origin),
	)
	expr = CompilerTypedCallExpr(
		callee,
		[int_expr("5")],
		source_span(),
		expr_info_with_resolved(int_type(), resolved),
	)

	match lower_typed_expr(expr):
		Ok(CallExpr(SelectedDirectCall(def_id), lowered_callee, args, typ, _)):
			def_id == callable_id and args.length() == 1 and core_exprs_equal(
				lowered_callee,
				VarExpr(
					{
						name = callee_name,
						uniq = 0,
						def_id = None
					},
					NamedType("Closure", []),
					compiler_core_source_loc(source_span()),
				),
			) and core_type_to_json(
				typ,
			).to_string() == core_type_to_json(core_int_type()).to_string()
		_:
			False


func test_lowers_resolved_local_direct_call() -> Bool:
	direct_call_lowers_to_selected_direct_call("add_one", 88, CompilerCallableLocal)


func direct_call_lowers_to_unknown_call(
	callee_name: String,
	callable_id: Int,
	origin: CompilerCallableOrigin,
) -> Bool:
	callee = CompilerTypedNameExpr(ident(callee_name), expr_info(function_type()))
	resolved = resolved_call_info(
		callee_name,
		CompilerResolvedDirectCall(callable_id, origin),
	)
	expr = CompilerTypedCallExpr(
		callee,
		[int_expr("5")],
		source_span(),
		expr_info_with_resolved(int_type(), resolved),
	)

	match lower_typed_expr(expr):
		Ok(CallExpr(UnknownCall, _, args, typ, _)):
			(
				args.length() == 1
				and core_type_to_json(
					typ,
				).to_string() == core_type_to_json(core_int_type()).to_string()
			)
		_:
			False


func test_lowers_resolved_imported_direct_call_as_unknown() -> Bool:
	direct_call_lowers_to_unknown_call("external_add", 92, CompilerCallableImported("math"))


func test_lowers_resolved_constructor_direct_call_as_unknown() -> Bool:
	direct_call_lowers_to_unknown_call("Some", 93, CompilerCallableConstructor("Option"))


