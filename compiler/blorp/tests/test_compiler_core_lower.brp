func test_lowers_tuple_destruct_in_block() -> Bool:
	destruct = TypedTupleDestructExpr(
		[ident("a"), ident("b")],
		tuple_int_bool_expr(),
		source_span(),
		expr_info(TYPE_VOID),
	)
	tail = TypedNameExpr(ident("a"), expr_info(int_type()))
	expr = TypedBlockExpr(
		[destruct, tail],
		source_span(),
		expr_info(int_type()),
	)

	match lower_typed_expr(expr):
		Ok(LetExpr(temp_var, is_mutable, bind_type, bind_rhs, body)):
			match body:
				LetExpr(first_var, first_mutable, first_type, first_rhs, after_first):
					match after_first:
						LetExpr(second_var, second_mutable, second_type, second_rhs, final_body):
							first_rhs_ok: Bool = match first_rhs:
								TupleFieldExpr(tuple_ref, index, field_type, _):
									(
										index == 0
										and core_types_equal(field_type, core_int_type())
										and core_exprs_equal(
											tuple_ref,
											VarExpr(
												temp_var,
												core_tuple_int_bool_type(),
												compiler_core_source_loc(source_span()),
											),
										)
									)
								_:
									False

							second_rhs_ok: Bool = match second_rhs:
								TupleFieldExpr(tuple_ref, index, field_type, _):
									(
										index == 1
										and core_types_equal(field_type, core_bool_type())
										and core_exprs_equal(
											tuple_ref,
											VarExpr(
												temp_var,
												core_tuple_int_bool_type(),
												compiler_core_source_loc(source_span()),
											),
										)
									)
								_:
									False

							(
								temp_var.name.starts_with("__td_")
								and not is_mutable
								and core_types_equal(bind_type, core_tuple_int_bool_type())
								and core_exprs_equal(
									bind_rhs,
									TupleExpr(
										[
											LiteralExpr(
												IntLiteral(1),
												core_int_type(),
												compiler_core_source_loc(source_span()),
											),
											LiteralExpr(
												BoolLiteral(True),
												core_bool_type(),
												compiler_core_source_loc(source_span()),
											),
										],
										core_tuple_int_bool_type(),
										compiler_core_source_loc(source_span()),
									),
								)
								and first_var.name == "a"
								and not first_mutable
								and core_types_equal(first_type, core_int_type())
								and first_rhs_ok
								and second_var.name == "b"
								and not second_mutable
								and core_types_equal(second_type, core_bool_type())
								and second_rhs_ok
								and core_exprs_equal(
									final_body,
									VarExpr(
										{
											name = "a",
											uniq = 0,
											def_id = None
										},
										core_int_type(),
										compiler_core_source_loc(source_span()),
									),
								)
							)
						_:
							False
				_:
					False
		_:
			False


