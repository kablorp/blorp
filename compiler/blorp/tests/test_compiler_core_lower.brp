		[],
		source_span(),
		expr_info(record_type),
	)

	match lower_typed_expr(expr):
		Ok(LetExpr(_, False, _, _, RecordUpdateExpr(VarExpr(_, _, _), fields, _, _))):
			fields.is_empty()
		_:
			False


