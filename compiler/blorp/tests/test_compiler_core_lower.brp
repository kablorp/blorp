			RangeExpr,
			RecordExpr,
			SeqExpr,
			TupleExpr,
			VarExpr,
			VectorExpr,
		),
		CoreLiteral(BoolLiteral, IntLiteral, WideIntLiteral),
		CoreType(NamedType, RangeType, TupleType),
		core_binary_op_to_string,
		core_box_kind_to_json,
		core_expr_to_json,
		core_list_storage_layout_to_json,
		core_type_to_json,
