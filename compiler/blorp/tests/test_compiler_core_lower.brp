func test_lowers_enumerate2_tuple_loop_view() -> Bool:
	source = TypedNameExpr(ident("values"), expr_info(matrix_int_type()))
	loop_element_type: SemanticType = SemanticTupleType([
		SemanticRangeType(SemanticConstIntType(2)),
		SemanticRangeType(SemanticConstIntType(3)),
		int_type(),
	])
	iterable = TypedCallExpr(
		TypedNameExpr(ident("enumerate2"), expr_info(function_type())),
		[source],
		source_span(),
		expr_info(loop_element_type),
	)
	body = TypedNameExpr(ident("value"), expr_info(int_type()))
	expr = TypedForExpr(
		ParsedForTupleBinder(
			[ident("row"), ident("column"), ident("value")],
			source_span(),
		),
		iterable,
		Some(TypedEnumerate2LoopView(loop_element_type)),
		body,
		source_span(),
		expr_info(TYPE_VOID),
	)

	match lower_typed_expr(expr):
		Ok(LetExpr(source_var, False, source_type, VarExpr(values_var, _, _), outer_loop)):
			match outer_loop:
				ForRangeExpr(row_binder, _, rows_call, inner_loop, outer_type, _):
					match (rows_call, inner_loop):
						(CallExpr(UnknownCall, VarExpr(length_var, _, _), [VarExpr(rows_source, _, _)], _, _), ForRangeExpr(column_binder, _, column_count, loop_body, inner_type, _)):
							match (column_count, loop_body):
								(LiteralExpr(IntLiteral(3), _, _), LetExpr(value_var, False, value_type, value_call, VarExpr(body_var, _, _))):
									match value_call:
										CallExpr(UnknownCall, VarExpr(get_var, _, _), [VarExpr(value_source, _, _), VarExpr(row_var, _, _), VarExpr(column_var, _, _)], result_type, _):
											(
												values_var.name == "values"
												and length_var.name == "length"
												and rows_source.name == source_var.name
												and value_source.name == source_var.name
												and row_binder.variable.name == "row"
												and row_var.name == "row"
												and column_binder.variable.name == "column"
												and column_var.name == "column"
												and value_var.name == "value"
												and body_var.name == "value"
												and get_var.name == "matrix_checked_get"
												and core_types_equal(row_binder.typ, RangeType)
												and core_types_equal(column_binder.typ, RangeType)
												and core_types_equal(value_type, core_int_type())
												and core_types_equal(result_type, core_int_type())
												and core_types_equal(
													source_type,
													compiler_core_lower_type(
														matrix_int_type(),
													).get_or(VoidType),
												)
												and core_types_equal(outer_type, VoidType)
												and core_types_equal(inner_type, VoidType)
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		_:
			False


