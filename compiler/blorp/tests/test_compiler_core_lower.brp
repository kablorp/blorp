func test_lowers_plain_with_to_resource_scope() -> Bool:
	binding: CompilerTypedWithBinding = {
		name = ident("file"),
		annotation = None,
		value = CompilerTypedNameExpr(ident("opened"), expr_info(file_resource_type())),
		kind = ParsedWithPlainBinding,
		error_map = None,
		cleanup_function = Some("blorp_file_close"),
		span = source_span()
	}
	expr = CompilerTypedWithExpr(binding, int_expr("7"), source_span(), expr_info(int_type()))

	match lower_typed_expr(expr):
		Ok(ResourceScopeExpr(scope, typ, _)):
			cleanup_json = core_expr_to_json(scope.cleanup).to_string()

			(
				scope.variable.name == "file"
				and core_types_equal(scope.typ, core_file_resource_type())
				and core_types_equal(typ, core_int_type())
				and cleanup_json.contains("blorp_file_close")
				and cleanup_json.contains("\"name\":\"file\"")
			)
		_:
			False


func test_lowers_plain_with_fallback_close() -> Bool:
	binding: CompilerTypedWithBinding = {
		name = ident("resource"),
		annotation = None,
		value = CompilerTypedNameExpr(ident("opened"), expr_info(file_resource_type())),
		kind = ParsedWithPlainBinding,
		error_map = None,
		cleanup_function = None,
		span = source_span()
	}
	expr = CompilerTypedWithExpr(binding, int_expr("7"), source_span(), expr_info(int_type()))

	match lower_typed_expr(expr):
		Ok(ResourceScopeExpr(scope, _, _)):
			match scope.cleanup:
				CallExpr(UnknownCall, VarExpr(callee, _, _), [arg], _, _):
					match arg:
						VarExpr(resource_var, _, _):
							callee.name == "close" and resource_var.name == "resource"
						_:
							False
				_:
					False
		_:
			False


