							"Dict",
							[NamedType("Int", []), NamedType("Int", [])],
						),
					).to_string()
				None:
					False
		_:
			False


func test_lowers_if_expression() -> Bool:
	expr = CompilerTypedIfExpr(
		bool_expr(True),
		int_expr("1"),
		Some(int_expr("2")),
		source_span(),
		expr_info(int_type()),
	)

	match lower_typed_expr(expr):
		Ok(IfExpr(condition, then_branch, else_branch, typ, _)):
			core_exprs_equal(
				condition,
				LiteralExpr(
					BoolLiteral(True),
					core_bool_type(),
					compiler_core_source_loc(source_span()),
				),
			) and core_exprs_equal(
				then_branch,
				LiteralExpr(
					IntLiteral(1),
					core_int_type(),
					compiler_core_source_loc(source_span()),
				),
			) and core_exprs_equal(
				else_branch,
				LiteralExpr(
					IntLiteral(2),
					core_int_type(),
					compiler_core_source_loc(source_span()),
				),
			) and core_type_to_json(
				typ,
			).to_string() == core_type_to_json(core_int_type()).to_string()
		_:
			False


func test_lowers_literal_match_expression() -> Bool:
	case_one: CompilerTypedMatchCase = {
		pattern = CompilerTypedIntPattern("1", source_span()),
		body = int_expr("10"),
		span = source_span()
	}
	fallback_case: CompilerTypedMatchCase = {
		pattern = CompilerTypedWildcardPattern(source_span()),
		body = int_expr("20"),
		span = source_span()
	}
	expr = CompilerTypedMatchExpr(
		CompilerTypedNameExpr(
			ident("x"),
			expr_info(int_type()),
		),
		[case_one, fallback_case],
		source_span(),
		expr_info(int_type()),
	)

	match lower_typed_expr(expr):
		Ok(LiteralMatchExpr(scrutinee, cases, fallback, typ, _)):
			match (cases.get(0), fallback):
				(Some(first), LiteralMatchFallbackBody(fallback_body)):
					literal_ok: Bool = match first.literal:
						IntLiteral(value):
							value == 1
						_:
							False

					(
						literal_ok
						and cases.length() == 1
						and first.bindings.length() == 0
						and core_exprs_equal(
							scrutinee,
							VarExpr(
								{
									name = "x",
									uniq = 0,
									def_id = None
								},
								core_int_type(),
								compiler_core_source_loc(source_span()),
							),
						)
						and core_exprs_equal(
							first.body,
							LiteralExpr(
								IntLiteral(10),
								core_int_type(),
								compiler_core_source_loc(source_span()),
							),
						)
						and core_exprs_equal(
							fallback_body,
							LiteralExpr(
								IntLiteral(20),
								core_int_type(),
								compiler_core_source_loc(source_span()),
							),
						)
						and core_type_to_json(
							typ,
						).to_string() == core_type_to_json(core_int_type()).to_string()
					)
				_:
					False
		_:
			False


