func test_lowers_match_expression_to_raw_core_patterns() -> Bool:
	case_one: TypedMatchCase = {
		pattern = TypedIntPattern("1", source_span()),
		body = int_expr("10"),
		span = source_span()
	}
	fallback_case: TypedMatchCase = {
		pattern = TypedWildcardPattern(source_span()),
		body = int_expr("20"),
		span = source_span()
	}
	expr = TypedMatchExpr(
		TypedNameExpr(
			ident("x"),
			expr_info(int_type()),
		),
		[case_one, fallback_case],
		source_span(),
		expr_info(int_type()),
	)

	match lower_typed_expr(expr):
		Ok(lowered):
			match lowered:
				RawMatchExpr(scrutinee, cases, typ, _):
					match (cases.get(0), cases.get(1)):
						(Some(first), Some(fallback)):
							literal_ok: Bool = match first.pattern:
								LiteralPattern(IntLiteral(value)):
									value == 1
								_:
									False

							fallback_ok: Bool = match fallback.pattern:
								WildcardPattern:
									True
								_:
									False

							literal_ok and fallback_ok and cases.length() == 2 and core_exprs_equal(
								scrutinee,
								VarExpr(
									{
										name = "x",
										uniq = 0,
										def_id = None
									},
									core_int_type(),
									compiler_core_source_loc(source_span()),
								),
							) and core_exprs_equal(
								first.body,
								LiteralExpr(
									IntLiteral(10),
									core_int_type(),
									compiler_core_source_loc(source_span()),
								),
							) and core_exprs_equal(
								fallback.body,
								LiteralExpr(
									IntLiteral(20),
									core_int_type(),
									compiler_core_source_loc(source_span()),
								),
							) and core_type_to_json(
								typ,
							).to_string() == core_type_to_json(core_int_type()).to_string()
						_:
							False
				_:
					False
		_:
			False


func test_lowers_binding_and_constructor_match_patterns() -> Bool:
	binding_case: TypedMatchCase = {
		pattern = TypedConstructorPattern(
			ident("Some"),
			[TypedNamePattern(ident("value"), int_type())],
			source_span(),
			101,
		),
		body = int_expr("10"),
		span = source_span()
	}
	expr = TypedMatchExpr(
		TypedNameExpr(ident("x"), expr_info(int_type())),
		[binding_case],
		source_span(),
		expr_info(int_type()),
	)

	match lower_typed_expr(expr):
		Ok(lowered):
			json = core_expr_to_json(lowered).to_string()

			(
				json.contains("raw_match")
				and json.contains("constructor")
				and json.contains("Some")
				and json.contains("value")
				and json.contains("10")
			)
		_:
			False


func test_lowers_select_expression() -> Bool:
	channel_expr = TypedNameExpr(ident("channel"), expr_info(channel_int_type()))
	recv_arm: TypedSelectArm = {
		kind = TypedSelectReceiveArm(ident("value"), int_type(), channel_expr),
		body = TypedNameExpr(ident("value"), expr_info(int_type())),
		span = source_span()
	}
	sealed_arm: TypedSelectArm = {
		kind = TypedSelectSealedArm(int_type(), channel_expr),
		body = TypedVoidExpr(source_span(), expr_info(TYPE_VOID)),
		span = source_span()
	}
	after_arm: TypedSelectArm = {
		kind = TypedSelectAfterArm(int_expr("5")),
		body = TypedBreakExpr(source_span(), expr_info(TYPE_VOID)),
		span = source_span()
	}
	expr = TypedSelectExpr(
		[recv_arm, sealed_arm, after_arm],
		source_span(),
		expr_info(TYPE_VOID),
	)

	match lower_typed_expr(expr):
		Ok(SelectExpr(select_expr, typ, _)):
			match (select_expr.get(0), select_expr.get(1), select_expr.get(2)):
				(Some(first), Some(second), Some(third)):
					recv_ok: Bool = match first.kind:
						SelectRecvArm(recv):
							(
								recv.binder.name == "value"
								and core_type_to_json(
									recv.elem_type,
								).to_string() == core_type_to_json(core_int_type()).to_string()
								and core_exprs_equal(
									recv.channel,
									VarExpr(
										{
											name = "channel",
											uniq = 0,
											def_id = None
										},
										NamedType(
											"Channel",
											[core_int_type()],
										),
										compiler_core_source_loc(source_span()),
									),
								)
							)
						_:
							False

					sealed_ok: Bool = match second.kind:
						SelectSealedArm(sealed_channel):
							core_exprs_equal(
								sealed_channel,
								VarExpr(
									{
										name = "channel",
										uniq = 0,
										def_id = None
									},
									NamedType(
										"Channel",
										[core_int_type()],
									),
									compiler_core_source_loc(source_span()),
								),
							)
						_:
							False

					after_ok: Bool = match third.kind:
						SelectAfterArm(timeout):
							core_exprs_equal(
								timeout,
								LiteralExpr(
									IntLiteral(5),
									core_int_type(),
									compiler_core_source_loc(source_span()),
								),
							)
						_:
							False

					(
						select_expr.length() == 3
						and recv_ok
						and sealed_ok
						and after_ok
						and core_exprs_equal(
							first.body,
							VarExpr(
								{
									name = "value",
									uniq = 0,
									def_id = None
								},
								core_int_type(),
								compiler_core_source_loc(source_span()),
							),
						)
						and core_exprs_equal(
							second.body,
							VoidExpr(VoidType, compiler_core_source_loc(source_span())),
						)
						and core_exprs_equal(
							third.body,
							BreakExpr(VoidType, compiler_core_source_loc(source_span())),
						)
						and core_type_to_json(
							typ,
						).to_string() == core_type_to_json(VoidType).to_string()
					)
				_:
					False
		_:
			False


func test_lowers_select_duration_timeout_with_round_up() -> Bool:
	after_arm: TypedSelectArm = {
		kind = TypedSelectAfterArm(TypedNameExpr(ident("timeout"), expr_info(duration_type()))),
		body = TypedVoidExpr(source_span(), expr_info(TYPE_VOID)),
		span = source_span()
	}
	expr = TypedSelectExpr([after_arm], source_span(), expr_info(TYPE_VOID))

	match lower_typed_expr(expr):
		Ok(SelectExpr(select_expr, _, _)):
			match select_expr.get(0):
				Some(arm):
					match arm.kind:
						SelectAfterArm(timeout):
							match timeout:
								LetExpr(duration_var, duration_mut, duration_type_value, duration_rhs, converted):
									match converted:
										LetExpr(microseconds_var, microseconds_mut, microseconds_type, microseconds_rhs, rounded):
											timeout_json = core_expr_to_json(rounded).to_string()

											(
												duration_var.name.starts_with("__timeout_duration")
												and not duration_mut
												and core_type_to_json(
													duration_type_value,
												).to_string() == core_type_to_json(
													core_duration_type(),
												).to_string()
												and core_exprs_equal(
													duration_rhs,
													VarExpr(
														{
															name = "timeout",
															uniq = 0,
															def_id = None
														},
														core_duration_type(),
														compiler_core_source_loc(source_span()),
													),
												)
												and microseconds_var.name.starts_with(
													"__timeout_microseconds",
												)
												and not microseconds_mut
												and core_type_to_json(
													microseconds_type,
												).to_string() == core_type_to_json(
													core_int_type(),
												).to_string()
												and match microseconds_rhs:
													VarExpr(microseconds_source, microseconds_source_type, _):
														(
															microseconds_source.name == duration_var.name
															and core_type_to_json(
																microseconds_source_type,
															).to_string() == core_type_to_json(
																core_int_type(),
															).to_string()
														)
													_:
														False
												and timeout_json.contains("__timeout_whole_ms")
												and timeout_json.contains("less_equal")
												and timeout_json.contains("modulo")
												and timeout_json.contains("add")
											)
										_:
											False
								_:
									False
						_:
							False
				None:
					False
		_:
			False


