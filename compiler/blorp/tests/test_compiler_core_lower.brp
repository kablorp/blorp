					)
				None:
					False
		_:
			False


func test_lowers_concurrent_parameters() -> Bool:
	timeout_param: CompilerTypedConcurrentParam = {
		name = ident("timeout"),
		value = int_expr("5"),
		span = source_span()
	}
	max_threads_param: CompilerTypedConcurrentParam = {
		name = ident("max_threads"),
		value = int_expr("4"),
		span = source_span()
	}
	expr = CompilerTypedConcurrentBlockExpr(
		[timeout_param, max_threads_param],
		[typed_concurrent_binding("task", int_expr("1"))],
		source_span(),
		expr_info(compiler_type_void()),
	)

	match lower_typed_expr(expr):
		Ok(PreClosureConcurrentExpr(block, typ, _)):
			timeout_ok: Bool = match block.timeout:
				Some(timeout):
					core_exprs_equal(
						timeout,
						LiteralExpr(
							IntLiteral(5),
							core_int_type(),
							compiler_core_source_loc(source_span()),
						),
					)
				None:
					False

			(
				timeout_ok
				and block.max_threads == Some(4)
				and block.bindings.length() == 1
				and core_type_to_json(typ).to_string() == core_type_to_json(VoidType).to_string()
			)
		_:
			False


func test_lowers_concurrent_for_parameters() -> Bool:
	limit_param: CompilerTypedConcurrentParam = {
		name = ident("limit"),
		value = int_expr("2"),
		span = source_span()
	}
	timeout_param: CompilerTypedConcurrentParam = {
		name = ident("timeout"),
		value = int_expr("5"),
		span = source_span()
	}
	iterable = CompilerTypedNameExpr(ident("nums"), expr_info(list_int_type()))
	body = int_expr("7")
	expr = CompilerTypedConcurrentForExpr(
		ident("n"),
		iterable,
		[limit_param, timeout_param],
		body,
		source_span(),
		expr_info(compiler_type_void()),
	)

	match lower_typed_expr(expr):
		Ok(PreClosureConcurrentlyLoopExpr(loop, typ, _)):
			loop_json = core_expr_to_json(
				PreClosureConcurrentlyLoopExpr(
					loop,
					typ,
					compiler_core_source_loc(source_span()),
				),
			).to_string()

			timeout_ok: Bool = match loop.timeout:
				Some(timeout):
					core_exprs_equal(
						timeout,
						LiteralExpr(
							IntLiteral(5),
							core_int_type(),
							compiler_core_source_loc(source_span()),
						),
					)
				None:
					False

			body_ok: Bool = match loop.body:
				SeqExpr(first, second):
					core_exprs_equal(
						first,
						LiteralExpr(
							IntLiteral(7),
							core_int_type(),
							compiler_core_source_loc(source_span()),
						),
					) and core_exprs_equal(
						second,
						VoidExpr(VoidType, compiler_core_source_loc(source_span())),
					)
				_:
					False

			(
				loop.variable.name == "n"
				and core_types_equal(loop.item_type, core_int_type())
				and loop_json.contains("\"item_mode\":{\"kind\":\"copy\"}")
				and core_exprs_equal(
					loop.iterable,
					VarExpr(
						{
							name = "nums",
							uniq = 0,
							def_id = None
						},
						NamedType(
							"List",
							[core_int_type()],
						),
						compiler_core_source_loc(source_span()),
					),
				)
				and body_ok
				and timeout_ok
				and core_exprs_equal(
					loop.limit,
					LiteralExpr(
						IntLiteral(2),
						core_int_type(),
						compiler_core_source_loc(source_span()),
					),
				)
				and loop_json.contains("\"output\":\"discard\"")
				and core_types_equal(typ, VoidType)
			)
		_:
			False


