func test_lowers_record_update_with_explicit_core_intent() -> Bool:
	record_type = SemanticNamedType("Point", [])
	base = TypedNameExpr(ident("point"), expr_info(record_type))
	update: TypedRecordField = {
		name = ident("y"),
		value = int_expr("9"),
		span = source_span(),
		definition_id = None
	}
	record_fields: List[FieldDecl] = [
		{
			name = "x",
			field_type = int_type(),
			definition_id = None
		},
		{
			name = "y",
			field_type = int_type(),
			definition_id = None
		},
	]
	expr = TypedRecordUpdateExpr(
		base,
		[update],
		record_fields,
		source_span(),
		expr_info(record_type),
	)

	match lower_typed_expr(expr):
		Ok(LetExpr(temp, False, _, VarExpr(base_var, _, _), RecordUpdateExpr(VarExpr(update_base, _, _), fields, _, _))):
			match (fields.get(0), fields.get(1)):
				(Some(retained), Some(replacement)):
					retained_uses_temp: Bool = match retained.value:
						FieldExpr(VarExpr(field_base, _, _), "x", _, _):
							field_base == temp
						_:
							False

					(
						base_var.name == "point"
						and update_base == temp
						and fields.length() == 2
						and retained.name == "x"
						and retained_uses_temp
						and replacement.name == "y"
						and core_exprs_equal(
							replacement.value,
							LiteralExpr(
								IntLiteral(9),
								core_int_type(),
								compiler_core_source_loc(source_span()),
							),
						)
					)
				_:
					False
		_:
			False


