func test_lowers_resource_source_for_expression() -> Bool:
	item_name = ident("__resource_item")
	binding: TypedWithBinding = {
		name = ident("file"),
		annotation = None,
		value = TypedNameExpr(item_name, expr_info(file_resource_type())),
		kind = ParsedWithPlainBinding,
		error_map = None,
		cleanup_function = Some("blorp_file_close"),
		resource_loop_item_name = Some(item_name.text),
		span = source_span()
	}
	scoped_body = TypedWithExpr(
		binding,
		TypedVoidExpr(source_span(), expr_info(TYPE_VOID)),
		source_span(),
		expr_info(TYPE_VOID),
	)
	expr = TypedForExpr(
		ParsedForNameBinder(item_name),
		TypedNameExpr(ident("files"), expr_info(resource_source_file_type())),
		None,
		scoped_body,
		source_span(),
		expr_info(TYPE_VOID),
	)

	match lower_typed_expr(expr):
		Ok(ForResourceSourceExpr(loop, typ, _)):
			match loop.body:
				ResourceScopeExpr(scope, _, _):
					(
						loop.binder.variable.name == item_name.text
						and core_types_equal(loop.binder.typ, core_file_resource_type())
						and core_release_policy_to_string(loop.iterable_release_policy) == "arc"
						and scope.variable.name == "file"
						and core_expr_to_json(scope.acquire)
							.to_string()
							.contains(item_name.text)
						and core_expr_to_json(scope.cleanup)
							.to_string()
							.contains("blorp_file_close")
						and core_types_equal(typ, VoidType)
					)
