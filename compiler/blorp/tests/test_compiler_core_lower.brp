		[timeout_param, max_threads_param],
		[typed_concurrent_binding("task", int_expr("1"))],
		source_span(),
		expr_info(TYPE_VOID),
	)

	match lower_typed_expr(expr):
		Ok(PreClosureConcurrentExpr(block, typ, _)):
			timeout_ok: Bool = match block.timeout:
