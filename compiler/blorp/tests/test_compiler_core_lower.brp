func test_lowers_select_expression() -> Bool:
	channel_expr = CompilerTypedNameExpr(ident("channel"), expr_info(channel_int_type()))
	recv_arm: CompilerTypedSelectArm = {
		kind = CompilerTypedSelectReceiveArm(ident("value"), int_type(), channel_expr),
		body = CompilerTypedNameExpr(ident("value"), expr_info(int_type())),
		span = source_span()
	}
	sealed_arm: CompilerTypedSelectArm = {
		kind = CompilerTypedSelectSealedArm(int_type(), channel_expr),
		body = CompilerTypedVoidExpr(source_span(), expr_info(compiler_type_void())),
		span = source_span()
	}
	after_arm: CompilerTypedSelectArm = {
		kind = CompilerTypedSelectAfterArm(int_expr("5")),
		body = CompilerTypedBreakExpr(source_span(), expr_info(compiler_type_void())),
		span = source_span()
	}
	expr = CompilerTypedSelectExpr(
		[recv_arm, sealed_arm, after_arm],
		source_span(),
		expr_info(compiler_type_void()),
	)

	match lower_typed_expr(expr):
		Ok(SelectExpr(select_expr, typ, _)):
			match (select_expr.arms.get(0), select_expr.arms.get(1), select_expr.arms.get(2)):
				(Some(first), Some(second), Some(third)):
					recv_ok: Bool = match first.kind:
						SelectRecvArm(recv):
							(
								recv.binder.name == "value"
								and core_type_to_json(
									recv.elem_type,
								).to_string() == core_type_to_json(core_int_type()).to_string()
								and core_exprs_equal(
									recv.channel,
									VarExpr(
										{
											name = "channel",
											uniq = 0,
											def_id = None
										},
										NamedType(
											"Channel",
											[core_int_type()],
										),
										compiler_core_source_loc(source_span()),
									),
								)
							)
						_:
							False

					sealed_ok: Bool = match second.kind:
						SelectSealedArm(sealed_channel):
							core_exprs_equal(
								sealed_channel,
								VarExpr(
									{
										name = "channel",
										uniq = 0,
										def_id = None
									},
									NamedType(
										"Channel",
										[core_int_type()],
									),
									compiler_core_source_loc(source_span()),
								),
							)
						_:
							False

					after_ok: Bool = match third.kind:
						SelectAfterArm(timeout):
							core_exprs_equal(
								timeout,
								LiteralExpr(
									IntLiteral(5),
									core_int_type(),
									compiler_core_source_loc(source_span()),
								),
							)
						_:
							False

					(
						select_expr.arms.length() == 3
						and recv_ok
						and sealed_ok
						and after_ok
						and core_exprs_equal(
							first.body,
							VarExpr(
								{
									name = "value",
									uniq = 0,
									def_id = None
								},
								core_int_type(),
								compiler_core_source_loc(source_span()),
							),
						)
						and core_exprs_equal(
							second.body,
							VoidExpr(VoidType, compiler_core_source_loc(source_span())),
						)
						and core_exprs_equal(
							third.body,
							BreakExpr(VoidType, compiler_core_source_loc(source_span())),
						)
						and core_type_to_json(
							typ,
						).to_string() == core_type_to_json(VoidType).to_string()
					)
				_:
					False
		_:
			False


func test_lowers_select_duration_timeout_with_round_up() -> Bool:
	after_arm: CompilerTypedSelectArm = {
		kind = CompilerTypedSelectAfterArm(
			CompilerTypedNameExpr(
				ident("timeout"),
				expr_info(duration_type()),
			),
		),
		body = CompilerTypedVoidExpr(source_span(), expr_info(compiler_type_void())),
		span = source_span()
	}
	expr = CompilerTypedSelectExpr([after_arm], source_span(), expr_info(compiler_type_void()))

	match lower_typed_expr(expr):
		Ok(SelectExpr(select_expr, _, _)):
			match select_expr.arms.get(0):
				Some(arm):
					match arm.kind:
						SelectAfterArm(timeout):
							match timeout:
								LetExpr(duration_var, duration_mut, duration_type_value, duration_rhs, converted):
									match converted:
										LetExpr(microseconds_var, microseconds_mut, microseconds_type, microseconds_rhs, rounded):
											timeout_json = core_expr_to_json(rounded).to_string()

											(
												duration_var.name.starts_with("__timeout_duration")
												and not duration_mut
												and core_type_to_json(
													duration_type_value,
												).to_string() == core_type_to_json(
													NamedType(
														"Duration",
														[],
													),
												).to_string()
												and core_exprs_equal(
													duration_rhs,
													VarExpr(
														{
															name = "timeout",
															uniq = 0,
															def_id = None
														},
														NamedType(
															"Duration",
															[],
														),
														compiler_core_source_loc(source_span()),
													),
												)
												and microseconds_var.name.starts_with(
													"__timeout_microseconds",
												)
												and not microseconds_mut
												and core_type_to_json(
													microseconds_type,
												).to_string() == core_type_to_json(
													core_int_type(),
												).to_string()
												and match microseconds_rhs:
													VarExpr(microseconds_source, microseconds_source_type, _):
														(
															microseconds_source.name == duration_var.name
															and core_type_to_json(
																microseconds_source_type,
															).to_string() == core_type_to_json(
																core_int_type(),
															).to_string()
														)
													_:
														False
												and timeout_json.contains("__timeout_whole_ms")
												and timeout_json.contains("less_equal")
												and timeout_json.contains("modulo")
												and timeout_json.contains("add")
											)
										_:
											False
								_:
									False
						_:
							False
				None:
					False
		_:
			False


