		_:
			False


func test_lowers_concurrent_for_parameters() -> Bool:
	limit_param: TypedConcurrentParam = {
		name = ident("limit"),
		value = int_expr("2"),
		span = source_span()
	}
	timeout_param: TypedConcurrentParam = {
		name = ident("timeout"),
		value = int_expr("5"),
		span = source_span()
	}
	iterable = TypedNameExpr(ident("nums"), expr_info(list_int_type()))
	body = int_expr("7")
	expr = TypedConcurrentForExpr(
		ident("n"),
		iterable,
		[limit_param, timeout_param],
		body,
		source_span(),
		expr_info(TYPE_VOID),
	)

	match lower_typed_expr(expr):
		Ok(PreClosureConcurrentlyLoopExpr(loop, typ, _)):
			loop_json = core_expr_to_json(
				PreClosureConcurrentlyLoopExpr(
					loop,
					typ,
					compiler_core_source_loc(source_span()),
				),
			).to_string()

			timeout_ok: Bool = match loop.timeout:
				Some(timeout):
					core_exprs_equal(
						timeout,
						LiteralExpr(
							IntLiteral(5),
							core_int_type(),
							compiler_core_source_loc(source_span()),
						),
					)
				None:
					False

			body_ok: Bool = match loop.body:
				SeqExpr(first, second):
					core_exprs_equal(
						first,
						LiteralExpr(
							IntLiteral(7),
							core_int_type(),
							compiler_core_source_loc(source_span()),
						),
					) and core_exprs_equal(
						second,
						VoidExpr(VoidType, compiler_core_source_loc(source_span())),
					)
				_:
					False

			(
				loop.variable.name == "n"
				and core_types_equal(loop.item_type, core_int_type())
				and loop_json.contains("\"item_mode\":{\"kind\":\"copy\"}")
				and core_exprs_equal(
					loop.iterable,
					VarExpr(
						{
							name = "nums",
							uniq = 0,
							def_id = None
						},
						NamedType(
							"List",
							[core_int_type()],
						),
						compiler_core_source_loc(source_span()),
					),
				)
				and body_ok
				and timeout_ok
				and core_exprs_equal(
					loop.limit,
					LiteralExpr(
						IntLiteral(2),
						core_int_type(),
						compiler_core_source_loc(source_span()),
					),
				)
				and loop_json.contains("\"output\":\"discard\"")
				and core_types_equal(typ, VoidType)
			)
		_:
			False


func test_lowers_concurrent_resource_source_for() -> Bool:
	item_name = ident("__resource_concurrent_item")
	binding: TypedWithBinding = {
		name = ident("file"),
		annotation = None,
		value = TypedNameExpr(item_name, expr_info(file_resource_type())),
		kind = ParsedWithPlainBinding,
		error_map = None,
		cleanup_function = Some("blorp_file_close"),
		resource_loop_item_name = Some(item_name.text),
		span = source_span()
	}
	limit_param: TypedConcurrentParam = {
		name = ident("limit"),
		value = int_expr("2"),
		span = source_span()
	}
	expr = TypedConcurrentForExpr(
		item_name,
		TypedNameExpr(ident("files"), expr_info(resource_source_file_type())),
		[limit_param],
		TypedWithExpr(
			binding,
			TypedVoidExpr(source_span(), expr_info(TYPE_VOID)),
			source_span(),
			expr_info(TYPE_VOID),
		),
		source_span(),
		expr_info(TYPE_VOID),
	)

	match lower_typed_expr(expr):
		Ok(PreClosureConcurrentlyLoopExpr(loop, typ, _)):
			match (loop.item_mode, loop.body):
				(ConcurrentlyLoopMoveResourceItem(move_item), ResourceScopeExpr(scope, _, _)):
					(
						loop.variable.name == item_name.text
						and core_types_equal(loop.item_type, core_file_resource_type())
						and core_types_equal(move_item.resource_type, core_file_resource_type())
						and core_types_equal(
							move_item.error_type,
							NamedType("String", []),
						)
						and scope.variable.name == "file"
						and core_expr_to_json(scope.cleanup)
							.to_string()
							.contains("blorp_file_close")
						and core_types_equal(typ, VoidType)
					)
				_:
					False
		_:
			False


