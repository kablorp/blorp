								).bounds == ["Display"]
								and impl_info.methods.length() == 1
								and lowered_method.name == "answer"
								and lowered_method.def_id == 10
							)
						None:
							False
				_:
					False
		Err(_):
			False


func test_lowers_program_sequentially() -> Bool:
	func_info: TypedFunctionInfo = {
		decl = parsed_function_decl(),
		callable_id = None,
		effective_type_params = [],
		param_types = [int_type()],
		source_return_type = Some(int_type()),
		semantic_return_type = int_type(),
		body = Some(int_expr("1"))
	}
	global_info: TypedGlobalVarInfo = {
		decl = parsed_var_decl(),
		definition_id = None,
		binding_type = int_type(),
		source_type = Some(int_type()),
		value = int_expr("42")
	}
	program: TypedProgram = {
		source = source_file(),
		decls = [TypedFunctionDecl(func_info), TypedGlobalVarDecl(global_info)],
		diagnostics = [],
		type_definitions = [],
		type_references = []
	}

	match lower_typed_program(
		compiler_core_lower_context(7, None),
		program,
	):
		Ok(result):
			(
				result.context.next_def_id == 9
				and result.program.decls.length() == 2
				and result.program.foreign_includes.length() == 0
			)
		Err(_):
			False


func test_prepares_module_graph_at_core_boundary() -> Bool:
	module_function: TypedFunctionInfo = {
		decl = parsed_function_decl(),
		callable_id = None,
		effective_type_params = [],
		param_types = [int_type()],
		source_return_type = Some(type_list(int_type())),
		semantic_return_type = type_list(int_type()),
		body = Some(TypedListExpr([int_expr("1")], source_span(), expr_info(type_list(int_type()))))
	}
	target_function: TypedFunctionInfo = {
		decl = parsed_function_decl(),
		callable_id = None,
		effective_type_params = [],
		param_types = [int_type()],
		source_return_type = Some(int_type()),
		semantic_return_type = int_type(),
		body = Some(int_expr("2"))
	}
	module_program: TypedProgram = {
		source = source_file(),
		decls = [TypedFunctionDecl(module_function)],
		diagnostics = [],
		type_definitions = [],
		type_references = []
	}
	target_program: TypedProgram = {
		source = source_file(),
		decls = [TypedFunctionDecl(target_function)],
		diagnostics = [],
		type_definitions = [],
		type_references = []
	}
	module_unit: CompilerCoreGraphUnit = {
		module_name = "pkg/math",
		typed_program = module_program
	}

	match prepare_core_graph(target_program, [module_unit], 10):
		Ok(prepared):
			match prepared.program.decls:
				[FunctionDecl(module_info), FunctionDecl(target_info)]:
					module_layout_is_inline: Bool = match module_info.body:
						Some(ListConstructExpr(construct, _, _)):
							match construct.layout:
								InlineListStorage(8):
									True
								_:
									False
						_:
							False

					(
						prepared.next_def_id == 12
						and module_info.name == "pkg_math__answer"
						and module_info.source_module == Some("pkg/math")
						and module_info.def_id == 10
						and target_info.name == "answer"
						and target_info.source_module.is_none()
						and target_info.def_id == 11
						and module_layout_is_inline
					)
				_:
					False
		Err(_):
			False


func test_consumes_import_and_builtin_type_metadata() -> Bool:
	import_decl: ParsedImportDecl = {
		module_path = "std/list",
		module_alias = None,
		symbols = None,
		span = source_span()
	}
	builtin_type: ParsedBuiltinTypeDecl = {
		name = ident("Int"),
		type_params = [],
		is_resource = False,
		cleanup = None,
		doc = None,
		span = source_span()
	}
	program: TypedProgram = {
		source = source_file(),
		decls = [
			TypedParsedDecl(ImportBlockParsedDecl([import_decl], source_span())),
			TypedParsedDecl(BuiltinTypeParsedDecl(builtin_type)),
		],
		diagnostics = [],
		type_definitions = [],
		type_references = []
	}

	match lower_typed_program(
		compiler_core_lower_context(7, None),
		program,
	):
		Ok(result):
			result.context.next_def_id == 7 and result.program.decls.length() == 0
		Err(_):
			False


func test_rejects_untyped_non_metadata_declaration() -> Bool:
	program: TypedProgram = {
		source = source_file(),
		decls = [TypedParsedDecl(ParsedErrorDecl(source_span()))],
		diagnostics = [],
		type_definitions = [],
		type_references = []
	}

	match lower_typed_program(
		compiler_core_lower_context(7, None),
		program,
	):
		Err(CompilerCoreLowerUnsupported(message)):
			message == "untyped parsed declaration"
		_:
			False


func test_lowers_typed_program_fixture_to_core_json() -> Bool:
	func_info: TypedFunctionInfo = {
		decl = parsed_function_decl(),
		callable_id = Some(42),
		effective_type_params = [],
		param_types = [int_type()],
		source_return_type = Some(int_type()),
		semantic_return_type = int_type(),
		body = Some(int_expr("1"))
	}
	program: TypedProgram = {
		source = source_file(),
		decls = [TypedFunctionDecl(func_info)],
		diagnostics = [],
		type_definitions = [],
		type_references = []
	}

	match lower_typed_program_fixture_to_json(program, 7):
		Ok(json):
			(
				json.contains("\"kind\":\"program\"")
				and json.contains("\"kind\":\"function\"")
				and json.contains("\"name\":\"answer\"")
				and json.contains("\"def_id\":42")
			)
		Err(_):
			False


