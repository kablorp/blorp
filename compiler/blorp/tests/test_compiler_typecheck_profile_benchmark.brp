import:
	../benchmarks/compiler_alias_resolution_profile_fixture:
		CompilerAliasRegistrationBenchmarkConfig,
		CompilerAliasResolutionBenchmarkConfig,
		compiler_alias_registration_benchmark,
		compiler_alias_resolution_benchmark,
	../benchmarks/compiler_type_header_mixed_profile_fixture:
		CompilerMixedTypeHeaderBenchmarkConfig,
		compiler_mixed_type_header_benchmark,
	../benchmarks/compiler_typecheck_profile_fixture:
		CompilerTypecheckBenchmarkConfig,
		compiler_typecheck_benchmark,
	test: TestSuite


private func test_small_typecheck_profile_fixture() -> Bool:
	config: CompilerTypecheckBenchmarkConfig = {
		iterations = 1,
		module_count = 2,
		type_depth = 3,
		probes_per_module = 4,
		retain_parsed_programs = False
	}
	result = compiler_typecheck_benchmark(config)

	(
		result.artifact_count == 3
		and result.source_declaration_count == 15
		and result.typed_declaration_count == 15
		and result.error_count == 0
		and result.checksum == 33
		and result.workload_valid
	)


private func test_repeated_typecheck_profile_fixture() -> Bool:
	result = compiler_typecheck_benchmark({
		iterations = 2,
		module_count = 2,
		type_depth = 3,
		probes_per_module = 4,
		retain_parsed_programs = True,
	})

	result.workload_valid and result.error_count == 0 and result.checksum == 66


private func test_mixed_type_header_fixture_validates_semantic_work() -> Bool:
	result = compiler_mixed_type_header_benchmark({
		iterations = 1,
		module_count = 3,
		shapes_per_module = 2,
		probes_per_module = 3,
		import_fanout = 2,
		retain_parsed_programs = True,
	})

	(
		result.artifact_count == 4
		and result.source_declaration_count == 40
		and result.typed_declaration_count == 40
		and result.resolved_import_count == 6
		and result.record_count == 12
		and result.alias_count == 9
		and result.union_count == 3
		and result.function_count == 13
		and result.private_count == 3
		and result.error_count == 0
		and result.checksum == 130
		and result.workload_valid
	)


private func test_alias_resolution_profile_fixture_counts_logical_work() -> Bool:
	config: CompilerAliasResolutionBenchmarkConfig = {
		iterations = 2,
		alias_depth = 3,
		type_depth = 4,
		resolutions_per_iteration = 5
	}
	result = compiler_alias_resolution_benchmark(config)

	(
		result.alias_count == 3
		and result.target_node_count == 9
		and result.resolution_count == 10
		and result.expected_alias_expansion_count == 30
		and result.expected_result_node_count == 90
		and result.checksum == 90
		and result.workload_valid
	)


private func test_alias_registration_profile_fixture_counts_logical_work() -> Bool:
	config: CompilerAliasRegistrationBenchmarkConfig = {
		iterations = 2,
		alias_count = 3,
		type_depth = 4
	}
	result = compiler_alias_registration_benchmark(config)

	(
		result.alias_count == 3
		and result.target_node_count == 9
		and result.registration_count == 6
		and result.baseline_registration_copy_node_count == 54
		and result.checksum == 18
		and result.workload_valid
	)


tests: TestSuite = {
	description = "Compiler typecheck profile benchmark",
	tests = [
		("small fixture is deterministic", test_small_typecheck_profile_fixture),
		("repeated fixture validates every iteration", test_repeated_typecheck_profile_fixture),
		(
			"mixed type header fixture validates semantic work",
			test_mixed_type_header_fixture_validates_semantic_work,
		),
		(
			"alias fixture counts logical work",
			test_alias_resolution_profile_fixture_counts_logical_work,
		),
		(
			"alias registration fixture counts logical work",
			test_alias_registration_profile_fixture_counts_logical_work,
		),
	]
}
