import:
	../benchmarks/compiler_typecheck_profile_fixture:
		CompilerTypecheckBenchmarkConfig,
		compiler_typecheck_benchmark,
	test: TestSuite


private func test_small_typecheck_profile_fixture() -> Bool:
	config: CompilerTypecheckBenchmarkConfig = {
		iterations = 1,
		module_count = 2,
		type_depth = 3,
		probes_per_module = 4
	}
	result = compiler_typecheck_benchmark(config)

	(
		result.artifact_count == 3
		and result.source_declaration_count == 15
		and result.typed_declaration_count == 15
		and result.error_count == 0
		and result.checksum == 33
		and result.workload_valid
	)


private func test_repeated_typecheck_profile_fixture() -> Bool:
	result = compiler_typecheck_benchmark({
		iterations = 2,
		module_count = 2,
		type_depth = 3,
		probes_per_module = 4,
	})

	result.workload_valid and result.error_count == 0 and result.checksum == 66


tests: TestSuite = {
	description = "Compiler typecheck profile benchmark",
	tests = [
		("small fixture is deterministic", test_small_typecheck_profile_fixture),
		("repeated fixture validates every iteration", test_repeated_typecheck_profile_fixture),
	]
}
