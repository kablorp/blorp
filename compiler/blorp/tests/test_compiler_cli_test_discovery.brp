private pure func parse(source: String) -> ParsedProgram:
	parse_compiler_source(compiler_source_file("test.brp", "test", source))


private pure func typed_module(module_name: String, source: String) -> CompilerTypecheckedModule:
	program: ParsedProgram = parse_compiler_source(
		compiler_source_file(
			module_name + ".brp",
			module_name,
			source,
		),
	)
	result: CompilerTypecheckProgramResult = compiler_typecheck_program(
		compiler_typecheck_state_empty(),
		program,
	)

	{
		path = program.source.path,
		module_name = module_name,
		module_path = module_name,
		parsed_program = program,
		module_surface = module_surface_for_program(program),
		typed_program = result.program,
		errors = result.state.errors,
		import_bindings = [],
		ctfe_evaluated = False
	}


private pure func check_action(paths: List[String]) -> CliAction:
	CliCheck({
		dump_ast = False,
		dump_typed_ast = False,
		debug = False,
		no_format = True,
		std_dir = Some("std"),
		paths = paths,
	})


private func resolve_written_test_suite(
	path_value: String,
) -> Result[CliTestSuiteBindingResolution, String]:
	action: CliAction = check_action([path_value])
	discovered ?= discover_test_sources(
		[path_value],
		".",
		False,
	).map_err(
		func(error): message(error),
	)

	root ?= match discovered:
		[source]:
			Ok(parsed_cli_source_from_program(source.program))
		_:
			Err("test identity resolution requires exactly one discovered source")

	graph ?= frontend_module_graph_for_roots(action, [root])

	match graph.roots:
		[root]:
			typechecked = typecheck_frontend_root(graph, root, False)
			errors: List[String] = typechecked_graph_errors(typechecked)

			if errors.length() == 0:
				Ok(resolve_test_suite_binding(typechecked.target))
			else:
				Err(errors.join("\n"))
		_:
			Err("test identity resolution requires exactly one frontend root")


private func expect_features(
	label: String,
	program: ParsedProgram,
	features: CliTestSourceFeatures,
	has_main: Bool,
	has_tests_binding: Bool,
	has_doctests: Bool,
) -> Bool:
	matches: Bool = (
		program.diagnostics.length() == 0
		and features.has_main == has_main
		and features.has_tests_binding == has_tests_binding
		and features.has_doctests == has_doctests
	)

	if not matches:
		message: String = label + ": diagnostics=" + program.diagnostics
			.length()
			.to_string() + ", main=" + features.has_main.to_string() + ", tests=" + features.has_tests_binding.to_string() + ", doctests=" + features.has_doctests.to_string()

		print_error(message)

	matches


func test_classification_uses_top_level_declarations() -> Bool:
	test_suite_type: String = "Test" + "Suite"
	test_import: String = "\ttest: " + test_suite_type + "\n\n\n"
	source: String = "import:\n" + test_import + "tests:" + " " + test_suite_type + " = {\n" + "\tdescription = \"sample\",\n" + "\ttests = []\n" + "}\n\n\n" + "func main(args: List[String]) -> Int:\n" + "\t0\n"

	program = parse(source)
	features = classify_test_source(program)

	expect_features("top-level", program, features, True, True, False)


func test_classification_ignores_source_text_lookalikes() -> Bool:
	lookalike: String = "tests:" + " TestSuite and func main("
	source: String =
		|---
		|This sentence mentions doctests: but does not declare them.
		|---
		|pure func example() -> String:
		|	"${lookalike}"
	program = parse(source)
	features = classify_test_source(program)

	expect_features("lookalike", program, features, False, False, False)


func test_classification_defers_tests_binding_type_identity() -> Bool:
	program = parse("tests: Int = 1")
	features = classify_test_source(program)

	expect_features("deferred type identity", program, features, False, True, False)


func test_classification_reads_private_declarations_and_parsed_docs() -> Bool:
	test_suite_type: String = "Test" + "Suite"
	source: String = "---\n" + "Example.\n\n" + "doctests:\n" + "\t:: returns one\n" + "\texample() == 1\n" + "---\n" + "pure func example() -> Int:\n" + "\t1\n\n\n" + "private tests:" + " " + test_suite_type + " = {\n" + "\tdescription = \"private sample\",\n" + "\ttests = []\n" + "}\n"

	program = parse(source)
	features = classify_test_source(program)

	expect_features("private and docs", program, features, False, True, True)


private func exercise_filesystem_discovery() -> Result[Bool, IOError]:
	with root ?= temporary_directory(temp_dir(), "blorp_test_discovery_"):
		root_path: String = root.resource_path()
		nested: String = root_path.join("nested")
		skipped: String = root_path.join("should_fail")
		leak_baselines: String = root_path.join("tests/test_blorp/memory/leak_check_baselines")
		created_nested ?= create_directories(nested)
		created_skipped ?= create_directories(skipped)
		created_leak_baselines ?= create_directories(leak_baselines)

		test_suite_type: String = "Test" + "Suite"
		test_import: String = "import:\n\ttest: " + test_suite_type + "\n\n"
		suite_value: String = "{\n\tdescription = \"suite\",\n\ttests = []\n}\n"
		suite_source: String = test_import + "type alias Suite = " + test_suite_type + "\n\n" + "tests: Suite = " + suite_value
		direct_suite_source: String = test_import + "tests:" + " " + test_suite_type + " = " + suite_value
		private_suite_source: String = test_import + "private tests:" + " " + test_suite_type + " = " + suite_value
		doctest_source: String =
			|---
			|Example.
			|
			|doctests:
			|	:: true
			|	True
			|---
			|pure func example() -> Bool:
			|	True
		ignored_source: String = "tests:" + " " + test_suite_type + " = {\n\tdescription = \"ignored\",\n\ttests = []\n}\n"

		wrote_suite ?= write_text_atomic(
			root_path.join("a.brp"),
			suite_source,
		)
		wrote_broken ?= write_text_atomic(
			root_path.join("broken.brp"),
			"pure func broken(",
		)
		wrote_helper ?= write_text_atomic(
			root_path.join("helper.brp"),
			"pure func helper() -> Int: 1\n",
		)
		wrote_doctest ?= write_text_atomic(
			nested.join("b.brp"),
			doctest_source,
		)
		wrote_ignored ?= write_text_atomic(
			skipped.join("ignored.brp"),
			ignored_source,
		)
		direct_suite_path: String = skipped.join("direct_identity.brp")
		wrote_direct_suite ?= write_text_atomic(direct_suite_path, direct_suite_source)
		private_suite_path: String = skipped.join("private_identity.brp")
		wrote_private_suite ?= write_text_atomic(private_suite_path, private_suite_source)
		wrote_text ?= write_text_atomic(
			root_path.join("notes.txt"),
			suite_source,
		)
		leak_baseline_path: String = leak_baselines.join("standalone.brp")
		wrote_leak_baseline ?= write_text_atomic(
			leak_baseline_path,
			"func main(args: List[String]) -> Int:\n\t0\n",
		)

		discovered ?= discover_test_sources(
			[root_path, root_path.join("a.brp")],
			root_path,
			False,
		)
		explicit_skipped ?= discover_test_sources([skipped.join("ignored.brp")], root_path, False)
		explicit_non_blorp ?= discover_test_sources([root_path.join("notes.txt")], root_path, False)
		with_leak_baseline ?= discover_test_sources([root_path], root_path, True)
		paths: List[String] = discovered.map(func(source): source.program.source.path)
		suite_found: Bool = discovered.any(func(source):
			(
				source.program.source.path == root_path.join("a.brp")
				and source.features.has_tests_binding
				and source.program.source.text == suite_source
			)
		)
		doctest_found: Bool = discovered.any(func(source):
			source.program.source.path == nested.join("b.brp") and source.features.has_doctests
		)
		broken_found: Bool = discovered.any(func(source):
			(
				source.program.source.path == root_path.join("broken.brp")
				and parsed_program_has_errors(source.program)
				and not source.features.has_tests_binding
			)
		)
		leak_baseline_found: Bool = with_leak_baseline.any(func(source):
			if source.program.source.path == leak_baseline_path:
				source.is_leak_baseline_program and match source.isolation:
					CliFreshTestFilesystem(isolated_root):
						isolated_root == "tests/test_blorp/memory"
					_:
						False
			else:
				False
		)
		missing_path: String = root_path.join("missing.brp")

		missing_rejected: Bool = match discover_test_sources([missing_path], root_path, False):
			Err(NotFound(path)):
				path == missing_path
			_:
				False

		alias_identity_resolved: Bool = match resolve_written_test_suite(root_path.join("a.brp")):
			Ok(CliTestSuiteBindingResolved):
				True
			Ok(resolution):
				print_error(
					"expected resolved TestSuite identity, got " + test_suite_resolution_description(
						resolution,
					),
				)
				False
			Err(error):
				print_error("typed TestSuite identity failed:\n" + error)
				False

		direct_identity_resolved: Bool = match resolve_written_test_suite(direct_suite_path):
			Ok(CliTestSuiteBindingResolved):
				True
			Ok(resolution):
				print_error(
					"expected direct TestSuite identity, got " + test_suite_resolution_description(
						resolution,
					),
				)
				False
			Err(error):
				print_error("direct TestSuite identity failed:\n" + error)
				False

		private_identity_rejected: Bool = match resolve_written_test_suite(private_suite_path):
			Ok(CliTestSuiteBindingInaccessible):
				True
			Ok(resolution):
				print_error(
					"expected inaccessible private TestSuite, got " + test_suite_resolution_description(
						resolution,
					),
				)
				False
			Err(error):
				print_error("private TestSuite identity failed:\n" + error)
				False

		Ok(
			(
				paths == [
					root_path.join("a.brp"),
					root_path.join("broken.brp"),
					nested.join("b.brp"),
				]
				and suite_found
				and doctest_found
				and broken_found
				and explicit_skipped.length() == 1
				and explicit_non_blorp.length() == 0
				and leak_baseline_found
				and missing_rejected
				and alias_identity_resolved
				and direct_identity_resolved
				and private_identity_rejected
			),
		)


func test_filesystem_discovery_is_structural_and_deterministic() -> Bool:
	match exercise_filesystem_discovery():
		Ok(result):
			result
		Err(err):
			print_error("filesystem discovery failed: " + message(err))
			False


pure func test_execution_isolation_uses_explicit_roots() -> Bool:
	memory: Bool = match test_execution_isolation(
		"/workspace/tests/test_blorp/memory/example.brp",
		"/workspace",
	):
		CliFreshTestFilesystem(root):
			root == "tests/test_blorp/memory"
		_:
			False

	concurrency: Bool = match test_execution_isolation(
		"/workspace/tests/test_blorp/concurrency/example.brp",
		"/workspace",
	):
		CliFreshTestProcess(root):
			root == "tests/test_blorp/concurrency"
		_:
			False

	shared: Bool = match test_execution_isolation(
		"/workspace/tests/test_blorp/types/example.brp",
		"/workspace",
	):
		CliSharedTestProcess:
			True
		_:
			False

	root_boundary: Bool = match test_execution_isolation(
		"/workspace/tests/test_blorp/memory_extra/example.brp",
		"/workspace",
	):
		CliSharedTestProcess:
			True
		_:
			False

	memory and concurrency and shared and root_boundary


private pure func test_suite_resolution_description(
	resolution: CliTestSuiteBindingResolution,
) -> String:
	match resolution:
		CliTestSuiteBindingResolved:
			"resolved"
		CliTestSuiteBindingMissing:
			"missing"
		CliTestSuiteBindingWrongType(typ):
			"wrong type " + compiler_type_to_string(typ)
		CliTestSuiteBindingInaccessible:
			"inaccessible"
		CliTestSuiteBindingAmbiguous:
			"ambiguous"
		CliTestSuiteBindingInvalidProgram:
			"invalid program"


func test_suite_binding_resolution_uses_valid_typed_modules() -> Bool:
	test_suite_type: String = "Test" + "Suite"
	local_source: String = "record " + test_suite_type + " {}\n" + "tests:" + " " + test_suite_type + " = {}\n"
	local_module: CompilerTypecheckedModule = typed_module("local", local_source)
	wrong_module: CompilerTypecheckedModule = typed_module("wrong", "tests: Int = 1\n")
	missing_module: CompilerTypecheckedModule = typed_module(
		"missing",
		"pure func helper() -> Int: 1\n",
	)
	duplicate_module: CompilerTypecheckedModule = typed_module(
		"duplicate",
		"tests: Int = 1\ntests: Int = 2\n",
	)
	invalid_module: CompilerTypecheckedModule = typed_module(
		"invalid",
		"tests: Int = \"not an integer\"\n",
	)

	local_resolution: CliTestSuiteBindingResolution = resolve_test_suite_binding(local_module)
	wrong_resolution: CliTestSuiteBindingResolution = resolve_test_suite_binding(wrong_module)
	missing_resolution: CliTestSuiteBindingResolution = resolve_test_suite_binding(missing_module)
	duplicate_resolution: CliTestSuiteBindingResolution = resolve_test_suite_binding(
		duplicate_module,
	)
	invalid_resolution: CliTestSuiteBindingResolution = resolve_test_suite_binding(invalid_module)

	local_same_name: Bool = match local_resolution:
		CliTestSuiteBindingWrongType(_):
			True
		_:
			False

	wrong_type: Bool = match wrong_resolution:
		CliTestSuiteBindingWrongType(typ):
			compiler_type_to_string(typ) == "Int"
		_:
			False

	missing: Bool = match missing_resolution:
		CliTestSuiteBindingMissing:
			True
		_:
			False

	duplicate_ambiguous: Bool = match duplicate_resolution:
		CliTestSuiteBindingAmbiguous:
			True
		_:
			False

	initializer_invalid: Bool = match invalid_resolution:
		CliTestSuiteBindingInvalidProgram:
			invalid_module.errors.length() > 0
		_:
			False

	valid_modules_have_no_errors: Bool = (
		local_module.errors.length() == 0
		and wrong_module.errors.length() == 0
		and missing_module.errors.length() == 0
	)

	matches: Bool = (
		valid_modules_have_no_errors
		and local_same_name
		and wrong_type
		and missing
		and duplicate_ambiguous
		and initializer_invalid
	)

	if not matches:
		print_error(
			"TestSuite resolutions: local=" + test_suite_resolution_description(
				local_resolution,
			) + ", wrong=" + test_suite_resolution_description(
				wrong_resolution,
			) + ", missing=" + test_suite_resolution_description(
				missing_resolution,
			) + ", duplicate=" + test_suite_resolution_description(
				duplicate_resolution,
			) + ", invalid=" + test_suite_resolution_description(invalid_resolution),
		)

	matches


tests: TestSuite = {
	description = "Blorp CLI test discovery",
	tests = [
		(
			"classification uses top-level declarations",
			test_classification_uses_top_level_declarations,
		),
		(
			"classification ignores source text lookalikes",
			test_classification_ignores_source_text_lookalikes,
		),
		(
			"classification defers tests binding type identity",
			test_classification_defers_tests_binding_type_identity,
		),
		(
			"classification reads private declarations and parsed docs",
			test_classification_reads_private_declarations_and_parsed_docs,
		),
		(
			"filesystem discovery is structural and deterministic",
			test_filesystem_discovery_is_structural_and_deterministic,
		),
		("execution isolation uses explicit roots", test_execution_isolation_uses_explicit_roots),
		(
			"TestSuite binding resolution uses valid typed modules",
			test_suite_binding_resolution_uses_valid_typed_modules,
		),
	]
}
