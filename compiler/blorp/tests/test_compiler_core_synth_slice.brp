import:
	../src/stage_09_core/ir:
		CoreCallKind(BuiltinCall, IntrinsicCall),
		CoreExpr(BoxExpr, BreakExpr, CallExpr, ForRangeExpr, LetExpr),
		CoreFunction,
		CoreFunctionKind(UnresolvedBuiltinFunction),
		CoreParam,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType),
		CoreVar,
	../src/stage_09_core/synth_slice: synthesize_slice_body
	../src/stage_09_core/traverse: immediate_core_expr_children
	test: TestSuite


private INT_TYPE: CoreType = NamedType("Int", [])

private STRING_TYPE: CoreType = NamedType("String", [])

private SLICE_TYPE: CoreType = NamedType("StringSlice", [])

private CHAR_TYPE: CoreType = NamedType("Char", [])

private BOOL_TYPE: CoreType = NamedType("Bool", [])


pure func core_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


pure func param(name: String, typ: CoreType) -> CoreParam:
	{
		name = core_var(name),
		typ = typ,
		loc = SyntheticSourceLoc
	}


pure func builtin_function(
	module_name: String,
	source_name: String,
	params: List[CoreParam],
	return_type: CoreType,
) -> CoreFunction:
	{
		name = module_name.replace("/", "_") + "__" + source_name + "__mono_fixture",
		source_module = Some(module_name),
		type_params = [],
		params = params,
		return_type = return_type,
		body = None,
		is_pure = True,
		function_kind = UnresolvedBuiltinFunction,
		def_id = 1,
		loc = SyntheticSourceLoc
	}


pure func contains_intrinsic(expr: CoreExpr, expected: String) -> Bool:
	match expr:
		CallExpr(IntrinsicCall(name), _, _, _, _):
			(
				name == expected
				or immediate_core_expr_children(
					expr,
				).any(
					func(child): contains_intrinsic(child, expected),
				)
			)
		_:
			immediate_core_expr_children(expr).any(func(child):
				contains_intrinsic(child, expected)
			)


pure func contains_builtin(expr: CoreExpr, expected: String) -> Bool:
	match expr:
		CallExpr(BuiltinCall(name), _, _, _, _):
			(
				name == expected
				or immediate_core_expr_children(
					expr,
				).any(
					func(child): contains_builtin(child, expected),
				)
			)
		_:
			immediate_core_expr_children(expr).any(func(child):
				contains_builtin(child, expected)
			)


pure func contains_loop(expr: CoreExpr) -> Bool:
	match expr:
		ForRangeExpr(_, _, _, _, _, _):
			True
		_:
			immediate_core_expr_children(expr).any(func(child): contains_loop(child))


pure func contains_break(expr: CoreExpr) -> Bool:
	match expr:
		BreakExpr(_, _):
			True
		_:
			immediate_core_expr_children(expr).any(func(child): contains_break(child))


pure func contains_box(expr: CoreExpr) -> Bool:
	match expr:
		BoxExpr(_, _, _):
			True
		_:
			immediate_core_expr_children(expr).any(func(child): contains_box(child))


pure func contains_let_named(expr: CoreExpr, expected: String) -> Bool:
	match expr:
		LetExpr(variable, _, _, _, _):
			(
				variable.name == expected
				or immediate_core_expr_children(
					expr,
				).any(
					func(child): contains_let_named(child, expected),
				)
			)
		_:
			immediate_core_expr_children(expr).any(func(child):
				contains_let_named(child, expected)
			)


pure func synthesized_body(function_info: CoreFunction) -> Option[CoreExpr]:
	synthesize_slice_body(function_info)


pure func test_slice_from_string_and_length_use_intrinsics() -> Bool:
	from_string = builtin_function(
		"std/slice",
		"from_string",
		[param("source", STRING_TYPE)],
		SLICE_TYPE,
	)
	length = builtin_function("std/slice", "length", [param("slice", SLICE_TYPE)], INT_TYPE)

	match (synthesized_body(from_string), synthesized_body(length)):
		(Some(from_body), Some(length_body)):
			(
				contains_intrinsic(from_body, "slice_alloc")
				and contains_intrinsic(from_body, "string_len")
				and contains_intrinsic(length_body, "slice_len")
			)
		_:
			False


pure func test_slice_to_string_copies_exact_bytes() -> Bool:
	function_info = builtin_function(
		"std/slice",
		"to_string",
		[param("slice", SLICE_TYPE)],
		STRING_TYPE,
	)

	match synthesized_body(function_info):
		Some(body):
			(
				contains_intrinsic(body, "string_alloc")
				and contains_intrinsic(body, "string_get_byte")
				and contains_intrinsic(body, "string_set_byte")
				and contains_intrinsic(body, "string_set_len")
				and contains_loop(body)
			)
		None:
			False


pure func test_slice_substring_clamps_and_reuses_source() -> Bool:
	function_info = builtin_function(
		"std/slice",
		"substring",
		[param("slice", SLICE_TYPE), param("start", INT_TYPE), param("length", INT_TYPE)],
		SLICE_TYPE,
	)

	match synthesized_body(function_info):
		Some(body):
			(
				contains_intrinsic(body, "slice_source")
				and contains_intrinsic(body, "slice_start")
				and contains_intrinsic(body, "slice_len")
				and contains_intrinsic(body, "slice_alloc")
			)
		None:
			False


pure func test_slice_starts_with_short_circuits() -> Bool:
	function_info = builtin_function(
		"std/slice",
		"starts_with",
		[param("slice", SLICE_TYPE), param("prefix", STRING_TYPE)],
		BOOL_TYPE,
	)

	match synthesized_body(function_info):
		Some(body):
			(
				contains_intrinsic(body, "string_get_byte")
				and contains_loop(body)
				and contains_break(body)
				and not contains_let_named(body, "__prefix")
			)
		None:
			False


pure func test_slice_get_builds_checked_option() -> Bool:
	function_info = builtin_function(
		"std/slice",
		"get",
		[param("slice", SLICE_TYPE), param("index", INT_TYPE)],
		NamedType(
			"Option",
			[CHAR_TYPE],
		),
	)

	match synthesized_body(function_info):
		Some(body):
			(
				contains_builtin(body, "blorp_option_none")
				and contains_builtin(body, "blorp_option_some")
				and contains_box(body)
			)
		None:
			False


pure func test_slice_synthesis_rejects_wrong_module_and_signature() -> Bool:
	wrong_module = builtin_function("app/slice", "length", [param("slice", SLICE_TYPE)], INT_TYPE)
	wrong_signature = builtin_function(
		"std/slice",
		"length",
		[param("slice", STRING_TYPE)],
		INT_TYPE,
	)

	synthesized_body(wrong_module) == None and synthesized_body(wrong_signature) == None


tests: TestSuite = {
	description = "Compiler Core StringSlice synthesis",
	tests = [
		(
			"StringSlice construction and length use intrinsics",
			test_slice_from_string_and_length_use_intrinsics,
		),
		("StringSlice to_string copies exact bytes", test_slice_to_string_copies_exact_bytes),
		(
			"StringSlice substring clamps and reuses source",
			test_slice_substring_clamps_and_reuses_source,
		),
		("StringSlice starts_with short-circuits", test_slice_starts_with_short_circuits),
		("StringSlice get builds checked Option", test_slice_get_builds_checked_option),
		(
			"StringSlice synthesis rejects wrong module and signature",
			test_slice_synthesis_rejects_wrong_module_and_signature,
		),
	]
}
