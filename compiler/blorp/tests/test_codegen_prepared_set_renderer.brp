import:
	../codegen_prepared_set_renderer:
		ALL_TEMPLATES,
		CompilerCommand(RenderManifestCommand, RenderPreparedSetCommand, UnknownCommand),
		RenderError(UnsupportedPreparedSetOp, WrongArity),
		parse_command,
		parse_prepared_set_template,
		prepared_set_template_arity,
		prepared_set_template_name,
		render_error_to_string,
		render_manifest_line,
		render_manifest_lines,
		render_prepared_set,
	test: TestSuite


func parsed_template_has(name: String, expected_name: String, expected_arity: Int) -> Bool:
	match parse_prepared_set_template(name):
		Some(info):
			(
				prepared_set_template_name(info) == expected_name
				and prepared_set_template_arity(info) == expected_arity
			)
		None:
			False


func manifest_line_is(name: String, expected: String) -> Bool:
	match parse_prepared_set_template(name):
		Some(info):
			render_manifest_line(info) == expected
		None:
			False


func rendered_prepared_set_is(name: String, args: List[String], expected: String) -> Bool:
	match render_prepared_set(name, args):
		Ok(rendered):
			rendered == expected
		Err(error):
			False


func test_parse_command_routes() -> Bool:
	render_command: CompilerCommand = parse_command("prepared-set")
	manifest_command: CompilerCommand = parse_command("manifest")
	unknown_command: CompilerCommand = parse_command("wat")

	render_ok: Bool = match render_command:
		RenderPreparedSetCommand:
			True
		RenderManifestCommand:
			False
		UnknownCommand:
			False

	manifest_ok: Bool = match manifest_command:
		RenderPreparedSetCommand:
			False
		RenderManifestCommand:
			True
		UnknownCommand:
			False

	unknown_ok: Bool = match unknown_command:
		RenderPreparedSetCommand:
			False
		RenderManifestCommand:
			False
		UnknownCommand:
			True

	render_ok and manifest_ok and unknown_ok


func test_parse_template_shapes() -> Bool:
	source_ok: Bool = parsed_template_has("set_iter_source_binding", "set_iter_source_binding", 2)
	retain_ok: Bool = parsed_template_has("set_iter_retain", "set_iter_retain", 1)
	loop_ok: Bool = parsed_template_has("set_iter_loop_open", "set_iter_loop_open", 2)
	entry_key_ok: Bool = parsed_template_has("set_iter_entry_key", "set_iter_entry_key", 1)
	release_ok: Bool = parsed_template_has("set_iter_release", "set_iter_release", 1)
	missing_ok: Bool = not parsed_template_has("set_iter_missing", "set_iter_missing", 1)

	source_ok and retain_ok and loop_ok and entry_key_ok and release_ok and missing_ok


func test_render_prepared_set_successes() -> Bool:
	source_ok: Bool = rendered_prepared_set_is(
		"set_iter_source_binding",
		["__set_iter_0", "items"],
		"blorp_Set* __set_iter_0 = (blorp_Set*)items;",
	)
	retain_ok: Bool = rendered_prepared_set_is(
		"set_iter_retain",
		["__set_iter_0"],
		"blorp_retain(__set_iter_0);",
	)
	loop_ok: Bool = rendered_prepared_set_is(
		"set_iter_loop_open",
		["__set_entry_0", "__set_iter_0"],
		(
			"for (blorp_SetEntry* __set_entry_0 = __set_iter_0->first; __set_entry_0 != NULL;"
			+ " __set_entry_0 = __set_entry_0->next_order) {"
		),
	)
	entry_key_ok: Bool = rendered_prepared_set_is(
		"set_iter_entry_key",
		["__set_entry_0"],
		"__set_entry_0->key",
	)
	release_ok: Bool = rendered_prepared_set_is(
		"set_iter_release",
		["__set_iter_0"],
		"blorp_release(__set_iter_0);",
	)

	source_ok and retain_ok and loop_ok and entry_key_ok and release_ok


func test_render_prepared_set_errors_are_typed() -> Bool:
	match render_prepared_set("set_iter_source_binding", ["items"]):
		Ok(rendered):
			False
		Err(error):
			match error:
				WrongArity(info, got):
					(
						prepared_set_template_name(info) == "set_iter_source_binding"
						and prepared_set_template_arity(info) == 2
						and got == 1
					)
				UnsupportedPreparedSetOp(name):
					False


func test_render_error_to_string() -> Bool:
	arity_text: String = match render_prepared_set("set_iter_retain", []):
		Ok(rendered):
			rendered
		Err(error):
			render_error_to_string(error)

	unsupported_text: String = render_error_to_string(UnsupportedPreparedSetOp("missing"))

	(
		arity_text == "prepared set op set_iter_retain expected 1 arg(s), got 0"
		and unsupported_text == "unsupported prepared set op: missing"
	)


func test_render_manifest_lines() -> Bool:
	lines: List[String] = render_manifest_lines()
	count_ok: Bool = lines.length() == ALL_TEMPLATES.length()

	first_ok: Bool = match lines:
		[]:
			False
		[first, ...rest]:
			first == "set_iter_source_binding\t2\tblorp_Set* @0@ = (blorp_Set*)@1@;"

	retain_ok: Bool = manifest_line_is("set_iter_retain", "set_iter_retain\t1\tblorp_retain(@0@);")
	loop_ok: Bool = manifest_line_is(
		"set_iter_loop_open",
		"set_iter_loop_open\t2\tfor (blorp_SetEntry* @0@ = @1@->first; @0@ != NULL; @0@ = @0@->next_order) {",
	)
	entry_key_ok: Bool = manifest_line_is("set_iter_entry_key", "set_iter_entry_key\t1\t@0@->key")
	release_ok: Bool = manifest_line_is(
		"set_iter_release",
		"set_iter_release\t1\tblorp_release(@0@);",
	)

	count_ok and first_ok and retain_ok and loop_ok and entry_key_ok and release_ok


tests: TestSuite = {
	description = "Self-hosted compiler prepared set renderer",
	tests = [
		("parse command routes", test_parse_command_routes),
		("parse template shapes", test_parse_template_shapes),
		("render prepared set successes", test_render_prepared_set_successes),
		("render prepared set errors are typed", test_render_prepared_set_errors_are_typed),
		("render error to string", test_render_error_to_string),
		("render manifest lines", test_render_manifest_lines),
	]
}
