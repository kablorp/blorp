private pure func configuration() -> LspWorkspaceConfiguration:
	{
		workspace_roots = [
			{
				client_uri = lsp_document_uri("file:///workspace"),
				client_path = "/workspace",
				canonical_path = "/workspace"
			},
		],
		std_provider = CompilerProjectFilesystemStd("std"),
		source_packages = [],
		native_package_roots = []
	}


private pure func discovered(module_name: String, text: String) -> LspDiscoveredSourceSnapshot:
	{
		uri = lsp_document_uri("file:///workspace/" + module_name + ".brp"),
		layer = lsp_discovered_source_layer(
			compiler_source_file("/workspace/" + module_name + ".brp", module_name, text),
			LspDiskSource,
		)
	}


private pure func analysis_request_for_sources(
	sources: List[LspDiscoveredSourceSnapshot],
) -> Option[LspCompilerAnalysisRequest]:
	workspace_request ?= workspace_and_analysis_request(sources, sources)
	Some(workspace_request[1])


private pure func workspace_and_analysis_request(
	sources: List[LspDiscoveredSourceSnapshot],
	opened_sources: List[LspDiscoveredSourceSnapshot],
) -> Option[(LspWorkspace, LspCompilerAnalysisRequest)]:
	workspace ?= lsp_workspace(configuration(), sources).to_option()
	opened ?= open_sources_for_analysis(workspace, opened_sources, 1)
	plan ?= lsp_plan_analysis(opened[1]).to_option()
	Some(
		(opened[0], {
				plan = plan,
				cancellation_token = lsp_cancellation_token(1)
			}),
	)


private pure func open_sources_for_analysis(
	workspace: LspWorkspace,
	sources: List[LspDiscoveredSourceSnapshot],
	version_value: Int,
) -> Option[(LspWorkspace, LspWorkspaceTransition)]:
	match sources:
		[]:
			None
		[source, ...remaining]:
			version ?= lsp_document_version(version_value)
			applied ?= lsp_apply_workspace_event(
				workspace,
				LspResolvedDocumentOpened({
					document = {
						document = {
							uri = source.uri,
							version = version,
							text = source.layer.source.text
						},
						language_id = "blorp"
					},
					source = source.layer.source,
					provenance = source.layer.provenance,
				}),
			).to_option()

			match remaining:
				[]:
					Some(applied)
				_:
					open_sources_for_analysis(applied[0], remaining, version_value + 1)


private pure func analysis_request() -> Option[LspCompilerAnalysisRequest]:
	analysis_request_for_sources([
		discovered(
			"main",
			"import:\n\tlib: answer\n\nfunc main(args: List[String]):\n\tprint(answer().to_string())\n",
		),
		discovered("lib", "pure func answer() -> Int:\n\t42\n"),
	])


private pure func imported_global_analysis_request() -> Option[LspCompilerAnalysisRequest]:
	analysis_request_for_sources([
		discovered(
			"main",
			"import:\n\tlib: ANSWER\n\nfunc main(args: List[String]):\n\tprint(ANSWER.to_string())\n",
		),
		discovered("qualified", "import:\n\tlib as L\n\nfunc read() -> Int:\n\tL.ANSWER\n"),
		discovered("lib", "ANSWER: Int = 42\n"),
	])


private pure func imported_constructor_analysis_request() -> Option[LspCompilerAnalysisRequest]:
	analysis_request_for_sources([
		discovered(
			"main",
			"import:\n\tlib: Choice(Some, None)\n\npure func make(value: Int) -> Choice:\n\tSome(value)\n\npure func empty() -> Choice:\n\tNone\n\npure func read(choice: Choice) -> Int:\n\tmatch choice:\n\t\tSome(value): value\n\t\tNone: 0\n",
		),
		discovered(
			"qualified",
			"import:\n\tlib as L\n\npure func make(value: Int) -> L.Choice:\n\tL.Some(value)\n\npure func empty() -> L.Choice:\n\tL.None\n\npure func read(choice: L.Choice) -> Int:\n\tmatch choice:\n\t\tL.Some(value): value\n\t\tL.None: 0\n",
		),
		discovered("lib", "union Choice:\n\tNone\n\tSome(Int)\n"),
	])


private pure func imported_type_analysis_request() -> Option[LspCompilerAnalysisRequest]:
	analysis_request_for_sources([
		discovered(
			"main",
			"import:\n\tlib: Box as LocalBox\n\npure func identity(value: LocalBox) -> LocalBox:\n\tvalue\n",
		),
		discovered(
			"qualified",
			"import:\n\tlib as L\n\npure func identity(value: L.Box) -> L.Box:\n\tvalue\n",
		),
		discovered("lib", "record Box {value: Int}\n"),
	])


private pure func imported_field_analysis_request() -> Option[LspCompilerAnalysisRequest]:
	analysis_request_for_sources([
		discovered(
			"main",
			"import:\n\tlib: Box\n\npure func make() -> Box:\n\t{value = 1}\n\npure func read(box: Box) -> Int:\n\tbox.value\n",
		),
		discovered(
			"qualified",
			"import:\n\tlib as L\n\npure func make() -> L.Box:\n\t{value = 1}\n\npure func read(box: L.Box) -> Int:\n\tbox.value\n",
		),
		discovered(
			"other_user",
			"import:\n\tother as O\n\npure func make() -> O.Box:\n\t{value = \"other\"}\n\npure func read(box: O.Box) -> String:\n\tbox.value\n",
		),
		discovered("lib", "record Box {value: Int}\n"),
		discovered("other", "record Box {value: String}\n"),
	])


private pure func same_named_constructor_analysis_request() -> Option[LspCompilerAnalysisRequest]:
	analysis_request_for_sources([
		discovered("left", "union LeftChoice:\n\tNone\n\tSome(Int)\n"),
		discovered("right", "union RightChoice:\n\tNone\n\tSome(Int)\n"),
	])


private pure func exported_symbol_name(symbol: LspSemanticSymbolId) -> Option[String]:
	match symbol:
		LspExportedSemanticSymbol(exported):
			exported_id: LspExportedSymbolId = exported
			Some(compiler_exported_symbol_key_name(exported_id.key))
		_:
			None


private pure func successful_target_for_uri(
	outcomes: List[LspTargetAnalysisOutcome],
	uri: LspDocumentUri,
) -> Option[LspSuccessfulAnalysisTarget]:
	matches = outcomes.filter_map(func(outcome):
		match outcome:
			LspTargetAnalysisSucceeded(success):
				if success.target.identity.uri == uri:
					Some(success)
				else:
					None
			_:
				None
	)
	matches.get(0)


private pure func failed_target_for_uri(
	outcomes: List[LspTargetAnalysisOutcome],
	uri: LspDocumentUri,
) -> Option[LspFailedAnalysisTarget]:
	matches = outcomes.filter_map(func(outcome):
		match outcome:
			LspTargetAnalysisFailed(failure):
				if failure.target.identity.uri == uri:
					Some(failure)
				else:
					None
			_:
				None
	)
	matches.get(0)


private func analysis_typechecks_one_graph_and_builds_indexes() -> Option[Bool]:
	request ?= analysis_request()
	result ?= lsp_run_compiler_analysis(request).to_option()
	main ?= successful_target_for_uri(
		result.outcomes,
		lsp_document_uri("file:///workspace/main.brp"),
	)
	lib ?= successful_target_for_uri(result.outcomes, lsp_document_uri("file:///workspace/lib.brp"))
	main_index = lsp_typed_artifact_module_index(main.typed.artifact)
	lib_index = lsp_typed_artifact_module_index(lib.typed.artifact)

	Some(
		(
			result.outcomes.length() == 2
			and main.diagnostics.all(func(publication): publication.diagnostics.is_empty())
			and lib.diagnostics.all(func(publication): publication.diagnostics.is_empty())
			and lsp_module_semantic_index_definitions(main_index).length() == 1
			and lsp_module_semantic_index_references(main_index).length() == 2
			and lsp_module_semantic_index_definitions(lib_index).length() == 1
			and lsp_module_semantic_index_references(lib_index).length() == 1
		),
	)


func test_analysis_typechecks_one_graph_and_builds_indexes() -> Bool:
	analysis_typechecks_one_graph_and_builds_indexes().get_or(False)


private func imported_global_uses_provider_identity() -> Option[Bool]:
	request ?= imported_global_analysis_request()
	result ?= lsp_run_compiler_analysis(request).to_option()
	main ?= successful_target_for_uri(
		result.outcomes,
		lsp_document_uri("file:///workspace/main.brp"),
	)
	lib ?= successful_target_for_uri(result.outcomes, lsp_document_uri("file:///workspace/lib.brp"))
	qualified ?= successful_target_for_uri(
		result.outcomes,
		lsp_document_uri("file:///workspace/qualified.brp"),
	)
	main_index = lsp_typed_artifact_module_index(main.typed.artifact)
	lib_index = lsp_typed_artifact_module_index(lib.typed.artifact)
	qualified_index = lsp_typed_artifact_module_index(qualified.typed.artifact)
	provider_definition ?= lsp_module_semantic_index_definitions(lib_index).get(0)
	bare_reference ?= lsp_module_semantic_index_references(main_index).find(func(reference):
		(
			not reference.is_declaration
			and lsp_semantic_symbol_ids_equal(reference.symbol, provider_definition.symbol)
		)
	)
	qualified_reference ?= lsp_module_semantic_index_references(
		qualified_index,
	).find(func(reference):
		(
			not reference.is_declaration
			and lsp_semantic_symbol_ids_equal(reference.symbol, provider_definition.symbol)
		)
	)

	Some(
		(
			bare_reference.location.range.start.utf16_character == 7
			and qualified_reference.location.range.start.utf16_character == 3
		),
	)


func test_imported_global_uses_provider_identity() -> Bool:
	imported_global_uses_provider_identity().get_or(False)


private func imported_constructor_uses_provider_identity() -> Option[Bool]:
	request ?= imported_constructor_analysis_request()
	result ?= lsp_run_compiler_analysis(request).to_option()
	main ?= successful_target_for_uri(
		result.outcomes,
		lsp_document_uri("file:///workspace/main.brp"),
	)
	lib ?= successful_target_for_uri(result.outcomes, lsp_document_uri("file:///workspace/lib.brp"))
	qualified ?= successful_target_for_uri(
		result.outcomes,
		lsp_document_uri("file:///workspace/qualified.brp"),
	)
	main_index = lsp_typed_artifact_module_index(main.typed.artifact)
	lib_index = lsp_typed_artifact_module_index(lib.typed.artifact)
	qualified_index = lsp_typed_artifact_module_index(qualified.typed.artifact)
	provider_some ?= lsp_module_semantic_index_definitions(lib_index).find(func(definition):
		exported_symbol_name(definition.symbol) == Some("Some")
	)
	provider_none ?= lsp_module_semantic_index_definitions(lib_index).find(func(definition):
		exported_symbol_name(definition.symbol) == Some("None")
	)
	bare_references = lsp_module_semantic_index_references(main_index)
	qualified_references = lsp_module_semantic_index_references(qualified_index)
	bare_some = bare_references.filter(func(reference):
		lsp_semantic_symbol_ids_equal(reference.symbol, provider_some.symbol)
	)
	bare_none = bare_references.filter(func(reference):
		lsp_semantic_symbol_ids_equal(reference.symbol, provider_none.symbol)
	)
	qualified_some = qualified_references.filter(func(reference):
		lsp_semantic_symbol_ids_equal(reference.symbol, provider_some.symbol)
	)
	qualified_none = qualified_references.filter(func(reference):
		lsp_semantic_symbol_ids_equal(reference.symbol, provider_none.symbol)
	)

	Some(
		(
			bare_some.length() == 2
			and bare_none.length() == 2
			and qualified_some.length() == 2
			and qualified_none.length() == 2
			and bare_some.any(func(reference): reference.location.range.start.line == 4)
			and bare_some.any(func(reference): reference.location.range.start.line == 11)
			and bare_none.any(func(reference): reference.location.range.start.line == 7)
			and bare_none.any(func(reference): reference.location.range.start.line == 12)
			and qualified_some.any(func(reference):
				(
					reference.location.range.start.line == 4
					and reference.location.range.start.utf16_character == 3
				)
			)
			and qualified_some.any(func(reference):
				(
					reference.location.range.start.line == 11
					and reference.location.range.start.utf16_character == 4
				)
			)
			and qualified_none.any(func(reference):
				(
					reference.location.range.start.line == 7
					and reference.location.range.start.utf16_character == 3
				)
			)
			and qualified_none.any(func(reference):
				(
					reference.location.range.start.line == 12
					and reference.location.range.start.utf16_character == 4
				)
			)
		),
	)


func test_imported_constructor_uses_provider_identity() -> Bool:
	imported_constructor_uses_provider_identity().get_or(False)


private func imported_type_uses_provider_identity() -> Option[Bool]:
	request ?= imported_type_analysis_request()
	result ?= lsp_run_compiler_analysis(request).to_option()
	main ?= successful_target_for_uri(
		result.outcomes,
		lsp_document_uri("file:///workspace/main.brp"),
	)
	lib ?= successful_target_for_uri(result.outcomes, lsp_document_uri("file:///workspace/lib.brp"))
	qualified ?= successful_target_for_uri(
		result.outcomes,
		lsp_document_uri("file:///workspace/qualified.brp"),
	)
	main_index = lsp_typed_artifact_module_index(main.typed.artifact)
	lib_index = lsp_typed_artifact_module_index(lib.typed.artifact)
	qualified_index = lsp_typed_artifact_module_index(qualified.typed.artifact)
	provider_box ?= lsp_module_semantic_index_definitions(lib_index).find(func(definition):
		exported_symbol_name(definition.symbol) == Some("Box")
	)
	bare_references = lsp_module_semantic_index_references(main_index).filter(func(reference):
		lsp_semantic_symbol_ids_equal(reference.symbol, provider_box.symbol)
	)
	qualified_references = lsp_module_semantic_index_references(
		qualified_index,
	).filter(
		func(reference): lsp_semantic_symbol_ids_equal(reference.symbol, provider_box.symbol),
	)

	Some(
		(
			bare_references.length() == 2
			and qualified_references.length() == 2
			and bare_references.all(func(reference): reference.location.range.start.line == 3)
			and qualified_references.all(func(reference): reference.location.range.start.line == 3)
			and qualified_references.any(func(reference):
				reference.location.range.start.utf16_character == 28
			)
			and qualified_references.any(func(reference):
				reference.location.range.start.utf16_character == 38
			)
		),
	)


func test_imported_type_uses_provider_identity() -> Bool:
	imported_type_uses_provider_identity().get_or(False)


private func imported_field_uses_provider_identity() -> Option[Bool]:
	request ?= imported_field_analysis_request()
	result ?= lsp_run_compiler_analysis(request).to_option()
	main ?= successful_target_for_uri(
		result.outcomes,
		lsp_document_uri("file:///workspace/main.brp"),
	)
	lib ?= successful_target_for_uri(result.outcomes, lsp_document_uri("file:///workspace/lib.brp"))
	qualified ?= successful_target_for_uri(
		result.outcomes,
		lsp_document_uri("file:///workspace/qualified.brp"),
	)
	other_user ?= successful_target_for_uri(
		result.outcomes,
		lsp_document_uri("file:///workspace/other_user.brp"),
	)
	other ?= successful_target_for_uri(
		result.outcomes,
		lsp_document_uri("file:///workspace/other.brp"),
	)
	main_index = lsp_typed_artifact_module_index(main.typed.artifact)
	lib_index = lsp_typed_artifact_module_index(lib.typed.artifact)
	qualified_index = lsp_typed_artifact_module_index(qualified.typed.artifact)
	other_user_index = lsp_typed_artifact_module_index(other_user.typed.artifact)
	other_index = lsp_typed_artifact_module_index(other.typed.artifact)
	provider_field ?= lsp_module_semantic_index_definitions(lib_index).find(func(definition):
		exported_symbol_name(definition.symbol) == Some("value")
	)
	other_provider_field ?= lsp_module_semantic_index_definitions(
		other_index,
	).find(func(definition):
		exported_symbol_name(definition.symbol) == Some("value")
	)
	bare_references = lsp_module_semantic_index_references(main_index).filter(func(reference):
		lsp_semantic_symbol_ids_equal(reference.symbol, provider_field.symbol)
	)
	qualified_references = lsp_module_semantic_index_references(
		qualified_index,
	).filter(
		func(reference): lsp_semantic_symbol_ids_equal(reference.symbol, provider_field.symbol),
	)
	other_references = lsp_module_semantic_index_references(
		other_user_index,
	).filter(func(reference):
		lsp_semantic_symbol_ids_equal(reference.symbol, other_provider_field.symbol)
	)

	Some(
		(
			not lsp_semantic_symbol_ids_equal(provider_field.symbol, other_provider_field.symbol)
			and other_references.length() == 2
			and bare_references.length() == 2
			and qualified_references.length() == 2
			and bare_references.any(func(reference): reference.location.range.start.line == 4)
			and bare_references.any(func(reference): reference.location.range.start.line == 7)
			and qualified_references.any(func(reference): reference.location.range.start.line == 4)
			and qualified_references.any(func(reference): reference.location.range.start.line == 7)
		),
	)


func test_imported_field_uses_provider_identity() -> Bool:
	imported_field_uses_provider_identity().get_or(False)


private func same_named_constructors_keep_module_identity() -> Option[Bool]:
	request ?= same_named_constructor_analysis_request()
	result ?= lsp_run_compiler_analysis(request).to_option()
	left ?= successful_target_for_uri(
		result.outcomes,
		lsp_document_uri("file:///workspace/left.brp"),
	)
	right ?= successful_target_for_uri(
		result.outcomes,
		lsp_document_uri("file:///workspace/right.brp"),
	)
	left_some ?= lsp_module_semantic_index_definitions(
		lsp_typed_artifact_module_index(
			left.typed.artifact,
		),
	).find(
		func(definition): exported_symbol_name(definition.symbol) == Some("Some"),
	)
	right_some ?= lsp_module_semantic_index_definitions(
		lsp_typed_artifact_module_index(
			right.typed.artifact,
		),
	).find(
		func(definition): exported_symbol_name(definition.symbol) == Some("Some"),
	)

	Some(not lsp_semantic_symbol_ids_equal(left_some.symbol, right_some.symbol))


func test_same_named_constructors_keep_module_identity() -> Bool:
	same_named_constructors_keep_module_identity().get_or(False)


private func mixed_success_and_parse_failure() -> Option[Bool]:
	request ?= analysis_request_for_sources([
		discovered("valid", "pure func answer() -> Int:\n\t42\n"),
		discovered("broken", "pure func broken( -> Int:\n\t42\n"),
	])
	result ?= lsp_run_compiler_analysis(request).to_option()
	valid ?= successful_target_for_uri(
		result.outcomes,
		lsp_document_uri("file:///workspace/valid.brp"),
	)
	broken ?= failed_target_for_uri(
		result.outcomes,
		lsp_document_uri("file:///workspace/broken.brp"),
	)
	valid_index = lsp_typed_artifact_module_index(valid.typed.artifact)

	failure_is_parse = match broken.failure:
		LspTargetParseFailed:
			True
		_:
			False

	Some(lsp_module_semantic_index_definitions(valid_index).length() == 1 and failure_is_parse)


func test_failed_root_does_not_suppress_successful_index() -> Bool:
	mixed_success_and_parse_failure().get_or(False)


private func missing_import_has_exact_source_diagnostic_case() -> Option[Bool]:
	missing_import_message = "module 'missing/module' is not loaded for import registration"
	request ?= analysis_request_for_sources([
		discovered("main", "import:\n\tmissing/module: value\n\nVALUE: Int = value\n"),
		discovered("healthy", "HEALTHY: Int = 1\n"),
	])
	result ?= lsp_run_compiler_analysis(request).to_option()
	failed ?= failed_target_for_uri(result.outcomes, lsp_document_uri("file:///workspace/main.brp"))
	_healthy ?= successful_target_for_uri(
		result.outcomes,
		lsp_document_uri("file:///workspace/healthy.brp"),
	)
	publication ?= failed.diagnostics.find(func(candidate):
		candidate.diagnostics.any(func(diagnostic):
			diagnostic.message == missing_import_message
		)
	)
	diagnostic ?= publication.diagnostics.find(func(candidate):
		candidate.message == missing_import_message
	)

	failure_is_typecheck = match failed.failure:
		LspTargetTypecheckFailed:
			True
		_:
			False

	Some(
		(
			failure_is_typecheck
			and result.outcomes.length() == 2
			and failed.diagnostics.length() == 1
			and publication.identity == failed.target.identity
			and diagnostic.message == missing_import_message
			and diagnostic.code == Some("typecheck")
			and diagnostic.severity == LspErrorDiagnostic
			and diagnostic.range.start.line == 1
			and diagnostic.range.start.utf16_character == 1
			and diagnostic.range.end.line == 1
			and diagnostic.range.end.utf16_character == 15
		),
	)


func test_missing_import_has_exact_source_diagnostic() -> Bool:
	missing_import_has_exact_source_diagnostic_case().get_or(False)


private func scoped_catalog_analysis_commits_case() -> Option[Bool]:
	main = discovered("main", "import:\n\tdep: ANSWER\n\nRESULT: Int = ANSWER\n")
	dependency = discovered("dep", "ANSWER: Int = 42\n")
	var sources: List[LspDiscoveredSourceSnapshot] = [main, dependency]
	var index: Int = 0

	while index < 98:
		sources = sources.append(
			discovered(
				"unrelated_${index.to_string()}",
				"VALUE: Int = ${index.to_string()}\n",
			),
		)
		index += 1

	workspace_request ?= workspace_and_analysis_request(sources, [main])
	request = workspace_request[1]
	result ?= lsp_run_compiler_analysis(request).to_option()
	dependency_names = lsp_dependency_store_values(result.dependencies)
		.map(func(state):
			compiler_resolved_module_canonical_path(lsp_module_dependency_identity(state))
		)
		.sort()
	completion: LspAnalysisCompletion = {
		scheduled = {
			token = request.cancellation_token,
			plan = request.plan
		},
		result = Ok(result)
	}

	committed: Bool = match lsp_apply_analysis_completion(workspace_request[0], completion):
		Ok((_, LspAnalysisCommitted(_))):
			True
		_:
			False

	Some(result.outcomes.length() == 1 and dependency_names == ["dep", "main"] and committed)


func test_scoped_catalog_analysis_commits() -> Bool:
	scoped_catalog_analysis_commits_case().get_or(False)


private func root_close_refreshes_cached_dependencies_case() -> Option[Bool]:
	main = discovered("main", "MAIN: Int = 1\n")
	other = discovered("other", "OTHER: Int = 2\n")
	initial ?= workspace_and_analysis_request(
		[main, other],
		[main, other],
	)
	initial_request = initial[1]
	initial_result ?= lsp_run_compiler_analysis(initial_request).to_option()
	initial_completion: LspAnalysisCompletion = {
		scheduled = {
			token = initial_request.cancellation_token,
			plan = initial_request.plan
		},
		result = Ok(initial_result)
	}
	committed ?= lsp_apply_analysis_completion(initial[0], initial_completion).to_option()
	closed ?= lsp_apply_workspace_event(
		committed[0],
		LspWorkspaceDocumentClosed(other.uri),
	).to_option()
	plan ?= lsp_plan_analysis(closed[1]).to_option()
	request: LspCompilerAnalysisRequest = {
		plan = plan,
		cancellation_token = lsp_cancellation_token(2)
	}
	result ?= lsp_run_compiler_analysis(request).to_option()
	dependency_names = lsp_dependency_store_values(result.dependencies)
		.map(func(state):
			compiler_resolved_module_canonical_path(lsp_module_dependency_identity(state))
		)
		.sort()
	completion: LspAnalysisCompletion = {
		scheduled = {
			token = request.cancellation_token,
			plan = request.plan
		},
		result = Ok(result)
	}

	refresh_committed: Bool = match lsp_apply_analysis_completion(closed[0], completion):
		Ok((_, LspAnalysisCommitted(_))):
			True
		_:
			False

	Some(
		(
			plan.targets.is_empty()
			and plan.roots.length() == 1
			and result.outcomes.is_empty()
			and dependency_names == ["main"]
			and refresh_committed
		),
	)


func test_root_close_refreshes_cached_dependencies() -> Bool:
	root_close_refreshes_cached_dependencies_case().get_or(False)


tests: TestSuite = {
	description = "Compiler LSP production compiler service",
	tests = [
		(
			"typecheck one graph and build semantic indexes",
			test_analysis_typechecks_one_graph_and_builds_indexes,
		),
		("imported global uses provider identity", test_imported_global_uses_provider_identity),
		(
			"imported constructor uses provider identity",
			test_imported_constructor_uses_provider_identity,
		),
		("imported type uses provider identity", test_imported_type_uses_provider_identity),
		("imported field uses provider identity", test_imported_field_uses_provider_identity),
		(
			"same-named constructors keep module identity",
			test_same_named_constructors_keep_module_identity,
		),
		(
			"failed root does not suppress successful index",
			test_failed_root_does_not_suppress_successful_index,
		),
		(
			"missing import has exact source diagnostic",
			test_missing_import_has_exact_source_diagnostic,
		),
		("scoped catalog analysis commits", test_scoped_catalog_analysis_commits),
		(
			"root close refreshes cached dependencies",
			test_root_close_refreshes_cached_dependencies,
		),
	]
}
