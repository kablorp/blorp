pure func test_builtin_and_intrinsic_contract_lookup() -> Bool:
	env: PerceusEnv = empty_env()

	contract_is(
		contract_for_call(env, IntrinsicCall("list_len"), 1, int_type()),
		[BorrowArg],
		ReturnPrimitive,
	) and contract_is(
		contract_for_call(env, BuiltinCall("blorp_yield_now"), 0, void_type()),
		[],
		ReturnVoid,
	)


pure func test_foreign_and_closure_calls_borrow_arguments() -> Bool:
	env: PerceusEnv = empty_env()

	contract_is(
		contract_for_call(
			env,
			ForeignCall(
				"external_make_string",
				ForeignBorrowArgs,
			),
			2,
			string_type(),
		),
		[BorrowArg, BorrowArg],
		ReturnOwned,
	) and contract_is(
		contract_for_call(env, ClosureCall, 1, int_type()),
		[BorrowArg],
		ReturnPrimitive,
	) and contract_is(Some(borrow_contract_for_signature(env, 0, void_type())), [], ReturnVoid)


