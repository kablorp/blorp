pure func test_owned_temporary_tuple_field_owner_is_released() -> Bool:
	tuple_type: CoreType = TupleType([list_int_type()])
	field_result: CoreExpr = TupleFieldExpr(
		user_call_expr("make_pair", Some(90), [], [], tuple_type),
		0,
		list_int_type(),
		SyntheticSourceLoc,
