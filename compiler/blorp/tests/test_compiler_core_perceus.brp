	var index: Int = depth - 1

	while index >= 0:
		name: String = "consume_${index}"
		callee_name: String = "consume_${index + 1}"
		decls = decls.append(
			function_decl(
				name,
				1000 + index,
				[core_param("value", list_int_type())],
				list_int_type(),
				user_call_expr(
					callee_name,
					Some(1001 + index),
					[],
