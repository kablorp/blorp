pure func test_nested_consumed_parameter_returns_transfer_each_owner() -> Bool:
	doc_type: CoreType = UnionType("Doc")
	concat_expr: CoreExpr = UnionConstructExpr(
		{
			type_name = "Doc",
			constructor_name = "Concat",
			constructor_c_name = "Concat",
			representation = GenericUnionRepresentation,
			payload_storage = ErasedUnionPayloadStorage,
			uses_release_mask = False,
			release_mask = 0,
			args = [
				transferring_boxed_value(var_expr("a", doc_type)),
				transferring_boxed_value(var_expr("b", doc_type)),
			]
		},
		doc_type,
		SyntheticSourceLoc,
	)
	inner_match: CoreExpr = ConstructorMatchExpr(
		var_expr(
			"b",
			doc_type,
		),
		NoReleasePolicy,
		[
			{
				constructor = "Nil",
				accessor = RootAccessor,
				test = UnionTagConstructorTest("TAG_Doc_Nil", "Doc"),
				bindings = [],
				body = ConstructorMatchBodyExpr(var_expr("a", doc_type))
			},
		],
		ConstructorMatchFallbackBody(concat_expr),
		doc_type,
		SyntheticSourceLoc,
	)
	cat: CoreDecl = function_decl(
		"cat",
		812,
		[core_param("a", doc_type), core_param("b", doc_type)],
		doc_type,
		ConstructorMatchExpr(
			var_expr(
				"a",
				doc_type,
			),
			NoReleasePolicy,
			[
				{
					constructor = "Nil",
					accessor = RootAccessor,
					test = UnionTagConstructorTest("TAG_Doc_Nil", "Doc"),
					bindings = [],
					body = ConstructorMatchBodyExpr(var_expr("b", doc_type))
				},
			],
			ConstructorMatchFallbackBody(inner_match),
			doc_type,
			SyntheticSourceLoc,
		),
	)
	program: CoreProgram = insert_drops_program({
		decls = [
			UnionDecl({
				name = "Doc",
				type_params = [],
				payload_storage = ErasedUnionPayloadStorage,
				variants = [
					union_variant("Nil", 0, None, []),
					union_variant(
						"Concat",
						1,
						None,
						[union_field(doc_type), union_field(doc_type)],
					),
				],
				loc = SyntheticSourceLoc,
			}),
			cat,
		],
		foreign_includes = [],
	})

	match function_body(program, "cat"):
		Some(body):
			(
				dup_count_for("a", body) == 0
				and dup_count_for("b", body) == 0
				and drop_count_for("a", body) == 1
				and drop_count_for("b", body) == 1
			)
		None:
			False


