		ReturnOwned,
	)


pure func test_borrowed_managed_parameter_return_is_retained() -> Bool:
	program: CoreProgram = {
		decls = [function_decl(
				"identity",
				80,
				[core_param("value", list_int_type())],
				list_int_type(),
				var_expr("value", list_int_type()),
			)],
		foreign_includes = []
	}
	rewritten: CoreProgram = insert_drops_program(program)

	match function_body(rewritten, "identity"):
		Some(body):
			dup_count_for("value", body) == 1 and drop_count_for("value", body) == 0
		None:
			False


