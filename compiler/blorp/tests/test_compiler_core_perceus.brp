import:
	../src/stage_09_core/compiler_core_json:
		CoreBinaryOp(AddOp),
		CoreCallKind(BuiltinCall, ClosureCall, ForeignCall, IntrinsicCall, UserCall),
		CoreDecl(HeapRecordDecl, UnionDecl),
		CoreExpr(
			AssignExpr,
			BinaryExpr,
			CallExpr,
			DropExpr,
			DupExpr,
			IfExpr,
			LetExpr,
			LiteralExpr,
			SeqExpr,
			TupleExpr,
			VarExpr,
			VoidExpr,
			WhileExpr,
		),
		CoreForeignArgPassing(ForeignBorrowArgs),
		CoreLiteral(BoolLiteral, IntLiteral),
		CoreProgram,
		CoreReleasePolicy(NoReleasePolicy),
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(
			BoxedResultType,
			HeapRecordType,
			NamedType,
			StackResultType,
			TupleType,
			UnionType,
			VoidType,
		),
		CoreUnionField,
		CoreUnionPayloadStorage(ErasedUnionPayloadStorage),
		CoreUnionVariant,
		CoreVar,
	../src/stage_09_core/compiler_core_ownership:
		OwnershipArgMode(BorrowArg, ConsumeArg, CowConsumeArg, RetainArg, TransferArg),
		OwnershipCallContract,
		OwnershipResultMode(
			ReturnAliasOfArg,
			ReturnBorrowed,
			ReturnOwned,
			ReturnPrimitive,
			ReturnVoid,
		),
	../src/stage_09_core/compiler_core_perceus:
		PerceusEnv,
		borrow_contract_for_signature,
		build_env,
		contract_for_call,
		count_uses,
		empty_env,
		insert_drops_expr,
		is_linear,
		is_managed_type,
		lookup_constructor_call_contract,
		result_mode_for_type,
	test: TestSuite


pure func named_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


pure func int_type() -> CoreType:
	NamedType("Int", [])


pure func bool_type() -> CoreType:
	NamedType("Bool", [])


pure func string_type() -> CoreType:
	NamedType("String", [])


pure func list_int_type() -> CoreType:
	NamedType("List", [int_type()])


pure func list_string_type() -> CoreType:
	NamedType("List", [string_type()])


pure func void_type() -> CoreType:
	VoidType


pure func int_expr(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), int_type(), SyntheticSourceLoc)


pure func bool_expr(value: Bool) -> CoreExpr:
	LiteralExpr(BoolLiteral(value), bool_type(), SyntheticSourceLoc)


pure func var_expr(name: String, typ: CoreType) -> CoreExpr:
	VarExpr(named_var(name), typ, SyntheticSourceLoc)


pure func binary_expr(left: CoreExpr, right: CoreExpr, typ: CoreType) -> CoreExpr:
	BinaryExpr(AddOp, left, right, typ, SyntheticSourceLoc)


pure func call_expr(name: String, args: List[CoreExpr], typ: CoreType) -> CoreExpr:
	CallExpr(
		BuiltinCall(name),
		var_expr(
			name,
			NamedType("Function", []),
		),
		args,
		typ,
		SyntheticSourceLoc,
	)


pure func intrinsic_expr(name: String, args: List[CoreExpr], typ: CoreType) -> CoreExpr:
	CallExpr(
		IntrinsicCall(name),
		var_expr(
			name,
			NamedType("Function", []),
		),
		args,
		typ,
		SyntheticSourceLoc,
	)


pure func tuple_expr(items: List[CoreExpr]) -> CoreExpr:
	TupleExpr(items, TupleType([string_type(), string_type(), string_type()]), SyntheticSourceLoc)


pure func union_field(typ: CoreType) -> CoreUnionField:
	{
		typ = typ,
		release_policy = NoReleasePolicy
	}


pure func union_variant(
	name: String,
	tag: Int,
	def_id: Option[Int],
	fields: List[CoreUnionField],
) -> CoreUnionVariant:
	{
		name = name,
		c_name = name,
		tag_c_name = "TAG_Tree_${name}",
		tag = tag,
		fields = fields,
		def_id = def_id
	}


pure func decl_env_program() -> CoreProgram:
	{
		decls = [
			HeapRecordDecl({
				name = "Node",
				fields = [],
				loc = SyntheticSourceLoc,
			}),
			UnionDecl({
				name = "Tree",
				payload_storage = ErasedUnionPayloadStorage,
				variants = [
					union_variant("Leaf", 0, None, []),
					union_variant(
						"Node",
						1,
						Some(42),
						[union_field(string_type()), union_field(string_type())],
					),
				],
				loc = SyntheticSourceLoc,
			}),
		],
		foreign_includes = []
	}


pure func arg_mode_equal(left: OwnershipArgMode, right: OwnershipArgMode) -> Bool:
	match left:
		BorrowArg:
			match right:
				BorrowArg:
					True
				RetainArg:
					False
				ConsumeArg:
					False
				CowConsumeArg:
					False
				TransferArg:
					False
		RetainArg:
			match right:
				BorrowArg:
					False
				RetainArg:
					True
				ConsumeArg:
					False
				CowConsumeArg:
					False
				TransferArg:
					False
		ConsumeArg:
			match right:
				BorrowArg:
					False
				RetainArg:
					False
				ConsumeArg:
					True
				CowConsumeArg:
					False
				TransferArg:
					False
		CowConsumeArg:
			match right:
				BorrowArg:
					False
				RetainArg:
					False
				ConsumeArg:
					False
				CowConsumeArg:
					True
				TransferArg:
					False
		TransferArg:
			match right:
				BorrowArg:
					False
				RetainArg:
					False
				ConsumeArg:
					False
				CowConsumeArg:
					False
				TransferArg:
					True


pure func arg_modes_equal(left: List[OwnershipArgMode], right: List[OwnershipArgMode]) -> Bool:
	match left:
		[]:
			match right:
				[]:
					True
				[right_head, ...right_tail]:
					False
		[left_head, ...left_tail]:
			match right:
				[]:
					False
				[right_head, ...right_tail]:
					arg_mode_equal(left_head, right_head) and arg_modes_equal(left_tail, right_tail)


pure func result_mode_equal(left: OwnershipResultMode, right: OwnershipResultMode) -> Bool:
	match left:
		ReturnVoid:
			match right:
				ReturnVoid:
					True
				ReturnPrimitive:
					False
				ReturnOwned:
					False
				ReturnBorrowed:
					False
				ReturnAliasOfArg(right_index):
					False
		ReturnPrimitive:
			match right:
				ReturnVoid:
					False
				ReturnPrimitive:
					True
				ReturnOwned:
					False
				ReturnBorrowed:
					False
				ReturnAliasOfArg(right_index):
					False
		ReturnOwned:
			match right:
				ReturnVoid:
					False
				ReturnPrimitive:
					False
				ReturnOwned:
					True
				ReturnBorrowed:
					False
				ReturnAliasOfArg(right_index):
					False
		ReturnBorrowed:
			match right:
				ReturnVoid:
					False
				ReturnPrimitive:
					False
				ReturnOwned:
					False
				ReturnBorrowed:
					True
				ReturnAliasOfArg(right_index):
					False
		ReturnAliasOfArg(left_index):
			match right:
				ReturnVoid:
					False
				ReturnPrimitive:
					False
				ReturnOwned:
					False
				ReturnBorrowed:
					False
				ReturnAliasOfArg(right_index):
					left_index == right_index


pure func contract_is(
	actual: Option[OwnershipCallContract],
	expected_args: List[OwnershipArgMode],
	expected_result: OwnershipResultMode,
) -> Bool:
	match actual:
		Some(contract):
			(
				arg_modes_equal(contract.args, expected_args)
				and result_mode_equal(contract.result, expected_result)
			)
		None:
			False


pure func drop_count_for(name: String, expr: CoreExpr) -> Int:
	match expr:
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			nested: Int = drop_count_for(name, body)

			if variable.name == name:
				nested + 1
			else:
				nested
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			drop_count_for(name, body)
		LetExpr(variable, is_mutable, typ, rhs, body):
			drop_count_for(name, rhs) + drop_count_for(name, body)
		SeqExpr(first, second):
			drop_count_for(name, first) + drop_count_for(name, second)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			drop_count_for(
				name,
				cond,
			) + drop_count_for(name, then_expr) + drop_count_for(name, else_expr)
		BinaryExpr(op, left, right, typ, loc):
			drop_count_for(name, left) + drop_count_for(name, right)
		CallExpr(kind, callee, args, typ, loc):
			drop_count_for(name, callee) + drop_count_in_args(name, args)
		_:
			0


pure func drop_count_in_args(name: String, args: List[CoreExpr]) -> Int:
	var total: Int = 0

	for arg in args:
		total += drop_count_for(name, arg)

	total


pure func dup_count_for(name: String, expr: CoreExpr) -> Int:
	match expr:
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			nested: Int = dup_count_for(name, body)

			if variable.name == name:
				nested + 1
			else:
				nested
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			dup_count_for(name, body)
		LetExpr(variable, is_mutable, typ, rhs, body):
			dup_count_for(name, rhs) + dup_count_for(name, body)
		SeqExpr(first, second):
			dup_count_for(name, first) + dup_count_for(name, second)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			dup_count_for(
				name,
				cond,
			) + dup_count_for(name, then_expr) + dup_count_for(name, else_expr)
		BinaryExpr(op, left, right, typ, loc):
			dup_count_for(name, left) + dup_count_for(name, right)
		CallExpr(kind, callee, args, typ, loc):
			dup_count_for(name, callee) + dup_count_in_args(name, args)
		_:
			0


pure func dup_count_in_args(name: String, args: List[CoreExpr]) -> Int:
	var total: Int = 0

	for arg in args:
		total += dup_count_for(name, arg)

	total


pure func is_post_drop_after_value(name: String, expr: CoreExpr) -> Bool:
	match expr:
		LetExpr(temp_var, is_mutable, temp_type, rhs, body):
			match rhs:
				CallExpr(kind, callee, args, typ, loc):
					match body:
						DropExpr(drop_var, value_type, release_policy, drop_body, drop_type, drop_loc):
							match drop_body:
								VarExpr(result_var, result_type, result_loc):
									drop_var.name == name and result_var.name == temp_var.name
								_:
									False
						_:
							False
				_:
					False
		_:
			False


pure func outer_let_body_is_post_drop_after_value(name: String, expr: CoreExpr) -> Bool:
	match expr:
		LetExpr(variable, is_mutable, typ, rhs, body):
			is_post_drop_after_value(name, body)
		_:
			False


pure func test_default_managed_types() -> Bool:
	env: PerceusEnv = empty_env()

	(
		is_managed_type(env, string_type())
		and is_managed_type(env, list_int_type())
		and is_managed_type(
			env,
			BoxedResultType(string_type(), int_type()),
		)
		and is_managed_type(
			env,
			StackResultType(string_type(), int_type()),
		)
		and not is_managed_type(env, int_type())
		and not is_managed_type(env, bool_type())
	)


pure func test_program_decls_extend_managed_types() -> Bool:
	env: PerceusEnv = build_env(decl_env_program())

	is_managed_type(
		env,
		NamedType("Node", []),
	) and is_managed_type(
		env,
		NamedType("Tree", []),
	) and is_managed_type(
		env,
		HeapRecordType("AnyRecord"),
	) and is_managed_type(env, UnionType("AnyUnion"))


pure func test_result_mode_for_type() -> Bool:
	env: PerceusEnv = empty_env()

	result_mode_equal(
		result_mode_for_type(env, void_type()),
		ReturnVoid,
	) and result_mode_equal(
		result_mode_for_type(env, int_type()),
		ReturnPrimitive,
	) and result_mode_equal(
		result_mode_for_type(env, string_type()),
		ReturnOwned,
	)


pure func test_constructor_contracts_transfer_payload_fields() -> Bool:
	env: PerceusEnv = build_env(decl_env_program())

	contract_is(
		lookup_constructor_call_contract(env, "Node", None, 2),
		[TransferArg, TransferArg],
		ReturnOwned,
	) and contract_is(
		contract_for_call(
			env,
			UserCall(
				"WrongNameButSameDefId",
				Some(42),
				[],
			),
			2,
			UnionType("Tree"),
		),
		[TransferArg, TransferArg],
		ReturnOwned,
	) and lookup_constructor_call_contract(env, "Node", None, 1) == None


pure func test_builtin_and_intrinsic_contract_lookup() -> Bool:
	env: PerceusEnv = empty_env()

	contract_is(
		contract_for_call(env, IntrinsicCall("list_len"), 1, int_type()),
		[BorrowArg],
		ReturnPrimitive,
	) and contract_is(
		contract_for_call(env, BuiltinCall("blorp_yield_now"), 0, void_type()),
		[],
		ReturnVoid,
	)


pure func test_foreign_and_closure_calls_borrow_arguments() -> Bool:
	env: PerceusEnv = empty_env()

	contract_is(
		contract_for_call(
			env,
			ForeignCall(
				"external_make_string",
				ForeignBorrowArgs,
			),
			2,
			string_type(),
		),
		[BorrowArg, BorrowArg],
		ReturnOwned,
	) and contract_is(
		contract_for_call(env, ClosureCall, 1, int_type()),
		[BorrowArg],
		ReturnPrimitive,
	) and contract_is(Some(borrow_contract_for_signature(env, 0, void_type())), [], ReturnVoid)


pure func test_count_uses_counts_linear_occurrences() -> Bool:
	count_uses(
		"x",
		binary_expr(
			var_expr("x", int_type()),
			var_expr("x", int_type()),
			int_type(),
		),
	) == 2


pure func test_count_uses_respects_shadowing() -> Bool:
	expr: CoreExpr = LetExpr(
		named_var("x"),
		False,
		int_type(),
		var_expr("x", int_type()),
		var_expr("x", int_type()),
	)

	count_uses("x", expr) == 1


pure func test_count_uses_takes_branch_maximum() -> Bool:
	expr: CoreExpr = IfExpr(
		bool_expr(True),
		binary_expr(
			var_expr("x", int_type()),
			var_expr("x", int_type()),
			int_type(),
		),
		var_expr("x", int_type()),
		int_type(),
		SyntheticSourceLoc,
	)

	count_uses("x", expr) == 2


pure func test_count_uses_ignores_assignment_target() -> Bool:
	expr: CoreExpr = AssignExpr(
		named_var("x"),
		var_expr("rhs", int_type()),
		void_type(),
		SyntheticSourceLoc,
	)

	count_uses("x", expr) == 0 and count_uses("rhs", expr) == 1


pure func test_linearity_accepts_linear_expressions() -> Bool:
	(
		is_linear(call_expr("identity", [int_expr(1)], int_type()))
		and is_linear(binary_expr(int_expr(1), int_expr(2), int_type()))
	)


pure func test_linearity_rejects_control_flow() -> Bool:
	if_expr: CoreExpr = IfExpr(
		bool_expr(True),
		int_expr(1),
		int_expr(2),
		int_type(),
		SyntheticSourceLoc,
	)
	while_expr: CoreExpr = WhileExpr(
		bool_expr(False),
		VoidExpr(void_type(), SyntheticSourceLoc),
		void_type(),
		SyntheticSourceLoc,
	)

	not is_linear(if_expr) and not is_linear(while_expr)


pure func test_unused_managed_let_gets_drop() -> Bool:
	expr: CoreExpr = LetExpr(
		named_var("s"),
		False,
		string_type(),
		var_expr("source", string_type()),
		int_expr(1),
	)
	rewritten: CoreExpr = insert_drops_expr(empty_env(), expr)

	drop_count_for("s", rewritten) == 1 and dup_count_for("s", rewritten) == 0


pure func test_unmanaged_let_gets_no_drop() -> Bool:
	expr: CoreExpr = LetExpr(named_var("n"), False, int_type(), int_expr(1), int_expr(2))
	rewritten: CoreExpr = insert_drops_expr(empty_env(), expr)

	drop_count_for("n", rewritten) == 0 and dup_count_for("n", rewritten) == 0


pure func test_once_used_managed_let_transfers_without_dup_or_drop() -> Bool:
	expr: CoreExpr = LetExpr(
		named_var("s"),
		False,
		string_type(),
		var_expr("source", string_type()),
		var_expr("s", string_type()),
	)
	rewritten: CoreExpr = insert_drops_expr(empty_env(), expr)

	drop_count_for("s", rewritten) == 0 and dup_count_for("s", rewritten) == 0


pure func test_reused_managed_let_gets_one_dup_per_extra_use() -> Bool:
	body: CoreExpr = tuple_expr([
		var_expr("s", string_type()),
		var_expr("s", string_type()),
		var_expr("s", string_type()),
	])
	expr: CoreExpr = LetExpr(
		named_var("s"),
		False,
		string_type(),
		var_expr("source", string_type()),
		body,
	)
	rewritten: CoreExpr = insert_drops_expr(empty_env(), expr)

	drop_count_for("s", rewritten) == 0 and dup_count_for("s", rewritten) == 2


pure func test_borrowed_intrinsic_drops_after_call() -> Bool:
	body: CoreExpr = intrinsic_expr("list_len", [var_expr("xs", list_int_type())], int_type())
	expr: CoreExpr = LetExpr(
		named_var("xs"),
		False,
		list_int_type(),
		var_expr("source", list_int_type()),
		body,
	)
	rewritten: CoreExpr = insert_drops_expr(empty_env(), expr)

	(
		drop_count_for("xs", rewritten) == 1
		and dup_count_for("xs", rewritten) == 0
		and outer_let_body_is_post_drop_after_value("xs", rewritten)
	)


pure func test_cow_consuming_intrinsic_consumes_directly() -> Bool:
	body: CoreExpr = intrinsic_expr(
		"list_ensure_unique",
		[var_expr("xs", list_int_type())],
		list_int_type(),
	)
	expr: CoreExpr = LetExpr(
		named_var("xs"),
		False,
		list_int_type(),
		var_expr("source", list_int_type()),
		body,
	)
	rewritten: CoreExpr = insert_drops_expr(empty_env(), expr)

	drop_count_for("xs", rewritten) == 0 and dup_count_for("xs", rewritten) == 0


pure func test_aliasing_intrinsic_result_suppresses_post_drop() -> Bool:
	body: CoreExpr = intrinsic_expr(
		"list_get",
		[var_expr("xs", list_string_type()), int_expr(0)],
		string_type(),
	)
	expr: CoreExpr = LetExpr(
		named_var("xs"),
		False,
		list_string_type(),
		var_expr("source", list_string_type()),
		body,
	)
	rewritten: CoreExpr = insert_drops_expr(empty_env(), expr)

	drop_count_for("xs", rewritten) == 0 and dup_count_for("xs", rewritten) == 0


pure func test_consume_then_borrow_gets_dup_and_post_drop() -> Bool:
	consume: CoreExpr = intrinsic_expr(
		"list_ensure_unique",
		[var_expr("xs", list_int_type())],
		list_int_type(),
	)
	borrow: CoreExpr = intrinsic_expr("list_len", [var_expr("xs", list_int_type())], int_type())
	body: CoreExpr = SeqExpr(consume, borrow)
	expr: CoreExpr = LetExpr(
		named_var("xs"),
		False,
		list_int_type(),
		var_expr("source", list_int_type()),
		body,
	)
	rewritten: CoreExpr = insert_drops_expr(empty_env(), expr)

	drop_count_for("xs", rewritten) == 1 and dup_count_for("xs", rewritten) == 1


tests: TestSuite = {
	description = "Blorp compiler Core Perceus",
	tests = [
		("default managed types", test_default_managed_types),
		("program decls extend managed types", test_program_decls_extend_managed_types),
		("result mode for type", test_result_mode_for_type),
		(
			"constructor contracts transfer payload fields",
			test_constructor_contracts_transfer_payload_fields,
		),
		("builtin and intrinsic contract lookup", test_builtin_and_intrinsic_contract_lookup),
		(
			"foreign and closure calls borrow arguments",
			test_foreign_and_closure_calls_borrow_arguments,
		),
		("count uses counts linear occurrences", test_count_uses_counts_linear_occurrences),
		("count uses respects shadowing", test_count_uses_respects_shadowing),
		("count uses takes branch maximum", test_count_uses_takes_branch_maximum),
		("count uses ignores assignment target", test_count_uses_ignores_assignment_target),
		("linearity accepts linear expressions", test_linearity_accepts_linear_expressions),
		("linearity rejects control flow", test_linearity_rejects_control_flow),
		("unused managed let gets drop", test_unused_managed_let_gets_drop),
		("unmanaged let gets no drop", test_unmanaged_let_gets_no_drop),
		(
			"once-used managed let transfers without dup or drop",
			test_once_used_managed_let_transfers_without_dup_or_drop,
		),
		(
			"reused managed let gets one dup per extra use",
			test_reused_managed_let_gets_one_dup_per_extra_use,
		),
		("borrowed intrinsic drops after call", test_borrowed_intrinsic_drops_after_call),
		(
			"COW-consuming intrinsic consumes directly",
			test_cow_consuming_intrinsic_consumes_directly,
		),
		(
			"aliasing intrinsic result suppresses post-drop",
			test_aliasing_intrinsic_result_suppresses_post_drop,
		),
		(
			"consume then borrow gets dup and post-drop",
			test_consume_then_borrow_gets_dup_and_post_drop,
		),
	]
}
