pure func test_exact_alias_contract_recognizes_retained_wrapped_result() -> Bool:
	param: CoreParam = core_param_with_id("value", 1453, list_string_type())
	local: CoreVar = {
		name = "local",
		uniq = 0,
		def_id = Some(1454)
	}
	retained_sequence: CoreExpr = DupExpr(
		param.name,
		list_string_type(),
		ArcRetainPolicy,
		SeqExpr(
			int_expr(0),
			VarExpr(param.name, list_string_type(), SyntheticSourceLoc),
		),
		list_string_type(),
		SyntheticSourceLoc,
	)
	retained_let: CoreExpr = DupExpr(
		param.name,
		list_string_type(),
		ArcRetainPolicy,
		LetExpr(
			local,
			False,
			int_type(),
			int_expr(0),
			VarExpr(param.name, list_string_type(), SyntheticSourceLoc),
		),
		list_string_type(),
		SyntheticSourceLoc,
	)
	retained_branch: CoreExpr = DupExpr(
		param.name,
		list_string_type(),
		ArcRetainPolicy,
		IfExpr(
			bool_expr(True),
			VarExpr(param.name, list_string_type(), SyntheticSourceLoc),
			intrinsic_expr("list_alloc", [int_expr(0)], list_string_type()),
			list_string_type(),
			SyntheticSourceLoc,
		),
		list_string_type(),
		SyntheticSourceLoc,
	)
	retained_match: CoreExpr = DupExpr(
		param.name,
		list_string_type(),
		ArcRetainPolicy,
		LiteralMatchExpr(int_expr(1), [literal_case(
					IntLiteral(1),
					[],
					VarExpr(param.name, list_string_type(), SyntheticSourceLoc),
				)], LiteralMatchFallbackBody(
				intrinsic_expr(
					"list_alloc",
					[int_expr(0)],
					list_string_type(),
				),
			), list_string_type(), SyntheticSourceLoc),
		list_string_type(),
		SyntheticSourceLoc,
	)
	retained_resource: CoreExpr = DupExpr(
		param.name,
		list_string_type(),
		ArcRetainPolicy,
		ResourceScopeExpr(
			{
				variable = {
					name = "resource",
					uniq = 0,
					def_id = Some(1455)
				},
				typ = int_type(),
				acquire = int_expr(0),
				body = VarExpr(param.name, list_string_type(), SyntheticSourceLoc),
				cleanup = VoidExpr(void_type(), SyntheticSourceLoc)
			},
			list_string_type(),
			SyntheticSourceLoc,
		),
		list_string_type(),
		SyntheticSourceLoc,
	)

	(
		not borrowed_result_aliases_param(empty_env(), param, retained_sequence)
		and not borrowed_result_aliases_param(empty_env(), param, retained_let)
		and not borrowed_result_aliases_param(empty_env(), param, retained_branch)
		and not borrowed_result_aliases_param(empty_env(), param, retained_match)
		and not borrowed_result_aliases_param(empty_env(), param, retained_resource)
	)


