pure func test_consumed_parameter_owner_outlives_borrowed_match_payload_retain() -> Bool:
	pattern_type: CoreType = UnionType("Pattern")
	tag_type: CoreType = UnionType("Tag")
	payload_type: CoreType = list_int_type()
	payload_binding: CoreMatchBinding = {
		variable = named_var("payload"),
		typ = payload_type,
		accessor = VariantFieldAccessor(RootAccessor, "Tag", "Some", 0),
		mode = MatchBorrowBindingMode
	}
	take_tag: CoreDecl = function_decl(
		"take_tag",
		225,
		[core_param("value", tag_type)],
		tag_type,
		var_expr("value", tag_type),
	)
	take_payload: CoreDecl = function_decl(
		"take_payload",
		226,
		[core_param("value", payload_type)],
		payload_type,
		intrinsic_expr("list_ensure_unique", [var_expr("value", payload_type)], payload_type),
	)
	consume_owner: CoreExpr = LetExpr(
		named_var("taken_tag"),
		False,
		tag_type,
		user_call_expr("take_tag", Some(225), [], [var_expr("actual", tag_type)], tag_type),
		VoidExpr(void_type(), SyntheticSourceLoc),
	)
	consume_payload: CoreExpr = LetExpr(
		named_var("taken_payload"),
		False,
		payload_type,
		user_call_expr(
			"take_payload",
			Some(226),
			[],
			[var_expr("payload", payload_type)],
			payload_type,
		),
		VoidExpr(void_type(), SyntheticSourceLoc),
	)
	inspect_payload: CoreExpr = ConstructorMatchExpr(
		var_expr("actual", tag_type),
		NoReleasePolicy,
		[constructor_case(
				"Some",
				[payload_binding],
				IfExpr(
					bool_expr(True),
					consume_payload,
					VoidExpr(void_type(), SyntheticSourceLoc),
					void_type(),
					SyntheticSourceLoc,
				),
			)],
		ConstructorMatchFallbackBody(VoidExpr(void_type(), SyntheticSourceLoc)),
		void_type(),
		SyntheticSourceLoc,
	)
	match_body: CoreExpr = ConstructorMatchExpr(
		var_expr("pattern", pattern_type),
		NoReleasePolicy,
		[constructor_case(
				"PatternNamed",
				[],
				IfExpr(
					bool_expr(True),
					consume_owner,
					inspect_payload,
					void_type(),
					SyntheticSourceLoc,
				),
			)],
		ConstructorMatchFallbackBody(VoidExpr(void_type(), SyntheticSourceLoc)),
		void_type(),
		SyntheticSourceLoc,
	)
	body: CoreExpr = LetExpr(
		named_var("actual"),
		False,
		tag_type,
		var_expr("source", tag_type),
		match_body,
	)
	program: CoreProgram = insert_drops_program({
		decls = [
			UnionDecl({
				name = "Pattern",
				type_params = [],
				payload_storage = ErasedUnionPayloadStorage,
				variants = [
					union_variant("PatternVar", 0, None, []),
					union_variant("PatternNamed", 1, None, []),
				],
				loc = SyntheticSourceLoc,
			}),
			UnionDecl({
				name = "Tag",
				type_params = [],
				payload_storage = ErasedUnionPayloadStorage,
				variants = [
					union_variant("Some", 0, None, [union_field(payload_type)]),
					union_variant("None", 1, None, []),
				],
				loc = SyntheticSourceLoc,
			}),
			take_tag,
			take_payload,
			function_decl(
				"bind_payload",
				227,
				[core_param("pattern", pattern_type)],
				void_type(),
				body,
			),
		],
		foreign_includes = [],
	})

	match function_body(program, "bind_payload"):
		Some(rewritten):
			(
				dup_count_for("payload", rewritten) == 1
				and not owner_drop_wraps_payload_dup("actual", "payload", rewritten)
			)
		None:
			False


pure func test_nested_aggregate_call_retains_borrowed_match_binding() -> Bool:
	payload_type: CoreType = list_int_type()
	span_type: CoreType = HeapRecordType("Span")
	parsed_type: CoreType = HeapRecordType("Parsed")
	step_type: CoreType = HeapRecordType("Step")
	make_parsed: CoreDecl = function_decl(
		"make_parsed",
		220,
		[core_param("value", payload_type), core_param("span", span_type)],
		parsed_type,
		RecordConstructExpr(
			"Parsed",
			[
				{
					name = "value",
					value = var_expr("value", payload_type)
				},
				{
					name = "span",
					value = var_expr("span", span_type)
				},
			],
			parsed_type,
			SyntheticSourceLoc,
		),
	)
	span_rhs: CoreExpr = FieldExpr(
		var_expr("token", HeapRecordType("Token")),
		"span",
		span_type,
		SyntheticSourceLoc,
	)
	call: CoreExpr = CallExpr(
		UserCall(
			"make_parsed",
			Some(220),
			[],
		),
		var_expr(
			"make_parsed",
			NamedType("Function", []),
		),
		[var_expr("payload", payload_type), var_expr("span", span_type)],
		parsed_type,
		SyntheticSourceLoc,
	)
	nested_value: CoreExpr = LetExpr(
		named_var("span"),
		False,
		span_type,
		span_rhs,
		DupExpr(
			named_var("span"),
			span_type,
			ArcRetainPolicy,
			call,
			parsed_type,
			SyntheticSourceLoc,
		),
	)
	match_body: CoreExpr = constructor_match_expr(
		[
			constructor_case(
				"Some",
				[match_binding("payload", payload_type)],
				RecordConstructExpr(
					"Step",
					[
						{
							name = "value",
							value = nested_value
						},
					],
					step_type,
					SyntheticSourceLoc,
				),
			),
		],
		var_expr(
			"fallback_step",
			step_type,
		),
		step_type,
	)
	program: CoreProgram = insert_drops_program({
		decls = [
			make_parsed,
			function_decl(
				"parse_token",
				221,
				[
					core_param("tag", UnionType("Tag")),
					core_param("token", HeapRecordType("Token")),
					core_param("fallback_step", step_type),
				],
				step_type,
				match_body,
			),
		],
		foreign_includes = [],
	})

	match function_body(program, "parse_token"):
		Some(rewritten):
			dup_count_for("payload", rewritten) == 1
		None:
			False


pure func test_many_borrowed_constructor_cases_preserve_ownership() -> Bool:
	var decls: List[CoreDecl] = []
	var index: Int = 0

	while index < 128:
		payload_type: CoreType = list_int_type()
		result_type: CoreType = TupleType([payload_type])
		body: CoreExpr = constructor_match_expr(
			[constructor_case(
					"Some",
					[match_binding("payload", payload_type)],
					TupleExpr([var_expr("payload", payload_type)], result_type, SyntheticSourceLoc),
				)],
			TupleExpr([], result_type, SyntheticSourceLoc),
			result_type,
		)
		decls = decls.append(
			function_decl(
				"pack_${index}",
				1000 + index,
				[core_param("tag", UnionType("Tag"))],
				result_type,
				body,
			),
		)
		index += 1

	program: CoreProgram = insert_drops_program({
		decls = decls,
		foreign_includes = [],
	})

	match function_body(program, "pack_127"):
		Some(rewritten):
			program.decls.length() == 128 and dup_count_for("payload", rewritten) == 1
		None:
			False


