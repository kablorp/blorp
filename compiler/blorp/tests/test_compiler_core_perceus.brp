					list_int_type(),
				),
			),
		)
		index -= 1

	rewritten: CoreProgram = insert_drops_program({
		decls = decls,
		foreign_includes = [],
	})

	match function_body(rewritten, "consume_0"):
		Some(CallExpr(UserCall(name, def_id, consumed_args), callee, args, typ, loc)):
			int_lists_equal(consumed_args, [0])
