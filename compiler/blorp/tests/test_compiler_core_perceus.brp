pure func test_constructor_match_nested_length_shadowing_stays_conservative() -> Bool:
	length_body: CoreConstructorMatchBody = constructor_length_body(
		[
			{
				length = 1,
				branch = constructor_length_branch(
					[match_binding("xs", list_int_type())],
					ConstructorMatchBodyExpr(var_expr("xs", list_int_type())),
				)
			},
		],
		None,
		Some(constructor_length_branch([], ConstructorMatchBodyExpr(int_expr(0)))),
		list_int_type(),
	)
	body: CoreExpr = constructor_match_expr_with_fallback(
		[constructor_case_body("Some", [], length_body)],
		ConstructorMatchFallbackFail,
		list_int_type(),
	)
	expr: CoreExpr = LetExpr(
		named_var("xs"),
		False,
		list_int_type(),
		var_expr("source", list_int_type()),
		body,
	)
	rewritten: CoreExpr = insert_drops_expr(empty_env(), expr)

	(
		drop_count_for("xs", rewritten) == 1
		and dup_count_for("xs", rewritten) == 0
		and not top_let_constructor_match_has_nested_length_branch_drops("xs", rewritten)
	)


