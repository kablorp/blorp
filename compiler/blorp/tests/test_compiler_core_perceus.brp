pure func named_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


pure func core_param(name: String, typ: CoreType) -> CoreParam:
	{
		name = named_var(name),
		typ = typ,
		loc = SyntheticSourceLoc
	}


pure func core_param_with_id(name: String, def_id: Int, typ: CoreType) -> CoreParam:
	{
		name = {
			name = name,
			uniq = 0,
			def_id = Some(def_id)
		},
		typ = typ,
		loc = SyntheticSourceLoc
	}


pure func function_decl(
	name: String,
	def_id: Int,
	params: List[CoreParam],
	return_type: CoreType,
	body: CoreExpr,
) -> CoreDecl:
	FunctionDecl({
		name = name,
		source_module = None,
		type_params = [],
		params = params,
		return_type = return_type,
		body = Some(body),
		is_pure = True,
		function_kind = UserFunction,
		def_id = def_id,
		loc = SyntheticSourceLoc,
	})


pure func global_decl(
	name: String,
	def_id: Int,
	typ: CoreType,
	init: CoreExpr,
) -> CoreDecl:
	GlobalDecl({
		name = {
			name = name,
			uniq = 0,
			def_id = Some(def_id)
		},
		source_module = None,
		typ = typ,
		init = init,
		is_mutable = False,
		is_const = True,
		is_private = True,
		def_id = def_id,
		loc = SyntheticSourceLoc,
	})


pure func mutable_global_decl(
	name: String,
	def_id: Int,
	typ: CoreType,
	init: CoreExpr,
) -> CoreDecl:
	GlobalDecl({
		name = {
			name = name,
			uniq = 0,
			def_id = Some(def_id)
		},
		source_module = None,
		typ = typ,
		init = init,
		is_mutable = True,
		is_const = False,
		is_private = True,
		def_id = def_id,
		loc = SyntheticSourceLoc,
	})


pure func unresolved_name_global_decl(
	name: String,
	def_id: Int,
	typ: CoreType,
	init: CoreExpr,
) -> CoreDecl:
	GlobalDecl({
		name = named_var(name),
		source_module = None,
		typ = typ,
		init = init,
		is_mutable = False,
		is_const = True,
		is_private = True,
		def_id = def_id,
		loc = SyntheticSourceLoc,
	})


pure func unresolved_name_mutable_global_decl(
	name: String,
	def_id: Int,
	typ: CoreType,
	init: CoreExpr,
) -> CoreDecl:
	GlobalDecl({
		name = named_var(name),
		source_module = None,
		typ = typ,
		init = init,
		is_mutable = True,
		is_const = False,
		is_private = True,
		def_id = def_id,
		loc = SyntheticSourceLoc,
	})


pure func function_body(program: CoreProgram, name: String) -> Option[CoreExpr]:
	var found: Option[CoreExpr] = None

	for decl in program.decls:
		match decl:
			FunctionDecl(func_info):
				if func_info.name == name:
					found = func_info.body
					break
				else:
					void
			_:
				void

	found


pure func int_type() -> CoreType:
	NamedType("Int", [])


pure func bool_type() -> CoreType:
	NamedType("Bool", [])


pure func string_type() -> CoreType:
	NamedType("String", [])


pure func list_int_type() -> CoreType:
	NamedType("List", [int_type()])


pure func list_string_type() -> CoreType:
	NamedType("List", [string_type()])


pure func tensor_int_type() -> CoreType:
	TensorType({
		element_type = int_type(),
		dims = [TensorStaticDim(2)],
	})


pure func channel_string_type() -> CoreType:
	NamedType("Channel", [string_type()])


pure func recv_attempt_string_type() -> CoreType:
	UnionType("RecvAttempt")


pure func closure_type() -> CoreType:
	NamedType("Closure", [])


pure func boxed_string_type() -> CoreType:
	UnionType("BoxedString")


pure func void_type() -> CoreType:
	VoidType


pure func int_expr(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), int_type(), SyntheticSourceLoc)


pure func bool_expr(value: Bool) -> CoreExpr:
	LiteralExpr(BoolLiteral(value), bool_type(), SyntheticSourceLoc)


pure func var_expr(name: String, typ: CoreType) -> CoreExpr:
	VarExpr(named_var(name), typ, SyntheticSourceLoc)


pure func binary_expr(left: CoreExpr, right: CoreExpr, typ: CoreType) -> CoreExpr:
	BinaryExpr(AddOp, left, right, typ, SyntheticSourceLoc)


pure func call_expr(name: String, args: List[CoreExpr], typ: CoreType) -> CoreExpr:
	CallExpr(
		BuiltinCall(name),
		var_expr(
			name,
			NamedType("Function", []),
		),
		args,
		typ,
		SyntheticSourceLoc,
	)


pure func intrinsic_expr(name: String, args: List[CoreExpr], typ: CoreType) -> CoreExpr:
	CallExpr(
		IntrinsicCall(name),
		var_expr(
			name,
			NamedType("Function", []),
		),
		args,
		typ,
		SyntheticSourceLoc,
	)


pure func user_call_expr(
	name: String,
	def_id: Option[Int],
	consumed_args: List[Int],
	args: List[CoreExpr],
	typ: CoreType,
) -> CoreExpr:
	CallExpr(
		UserCall(name, def_id, consumed_args),
		var_expr(
			name,
			NamedType("Function", []),
		),
		args,
		typ,
		SyntheticSourceLoc,
	)


pure func tuple_expr(items: List[CoreExpr]) -> CoreExpr:
	TupleExpr(items, TupleType([string_type(), string_type(), string_type()]), SyntheticSourceLoc)


pure func match_binding(name: String, typ: CoreType) -> CoreMatchBinding:
	{
		variable = named_var(name),
		typ = typ,
		accessor = RootAccessor,
		mode = MatchBorrowBindingMode
	}


pure func constructor_case(
	constructor: String,
	bindings: List[CoreMatchBinding],
	body: CoreExpr,
) -> CoreConstructorMatchCase:
	constructor_case_body(constructor, bindings, ConstructorMatchBodyExpr(body))


pure func constructor_case_body(
	constructor: String,
	bindings: List[CoreMatchBinding],
	body: CoreConstructorMatchBody,
) -> CoreConstructorMatchCase:
	{
		constructor = constructor,
		accessor = RootAccessor,
		test = EnumConstructorTest(constructor),
		bindings = bindings,
		body = body
	}


pure func literal_case(
	literal: CoreLiteral,
	bindings: List[CoreMatchBinding],
	body: CoreExpr,
) -> CoreLiteralMatchCase:
	{
		literal = literal,
		bindings = bindings,
		body = body
	}


pure func constructor_literal_body(
	cases: List[CoreLiteralMatchCase],
	fallback: CoreLiteralMatchFallback,
	typ: CoreType,
) -> CoreConstructorMatchBody:
	ConstructorMatchBodyLiteral({
		accessor = RootAccessor,
		scrutinee_type = int_type(),
		cases = cases,
		fallback = fallback,
		result_type = typ,
		loc = SyntheticSourceLoc,
	})


pure func constructor_length_branch(
	bindings: List[CoreMatchBinding],
	body: CoreConstructorMatchBody,
) -> CoreConstructorLengthMatchBranch:
	{
		bindings = bindings,
		body = body
	}


pure func constructor_length_body(
	cases: List[CoreConstructorLengthMatchCase],
	geq: Option[CoreConstructorLengthMatchGeq],
	fallback: Option[CoreConstructorLengthMatchBranch],
	typ: CoreType,
) -> CoreConstructorMatchBody:
	ConstructorMatchBodyLength({
		accessor = RootAccessor,
		cases = cases,
		geq = geq,
		fallback = fallback,
		result_type = typ,
		loc = SyntheticSourceLoc,
	})


pure func constructor_match_expr(
	cases: List[CoreConstructorMatchCase],
	fallback_body: CoreExpr,
	typ: CoreType,
) -> CoreExpr:
	ConstructorMatchExpr(
		var_expr("tag", UnionType("Tag")),
		NoReleasePolicy,
		cases,
		ConstructorMatchFallbackBody(fallback_body),
		typ,
		SyntheticSourceLoc,
	)


pure func constructor_match_expr_with_fallback(
	cases: List[CoreConstructorMatchCase],
	fallback: CoreConstructorMatchFallback,
	typ: CoreType,
) -> CoreExpr:
	ConstructorMatchExpr(
		var_expr("tag", UnionType("Tag")),
		NoReleasePolicy,
		cases,
		fallback,
		typ,
		SyntheticSourceLoc,
	)


pure func union_field(typ: CoreType) -> CoreUnionField:
	{
		typ = typ,
		release_policy = NoReleasePolicy
	}


pure func transferring_boxed_value(value: CoreExpr) -> CoreBoxedStorageValue:
	{
		kind = PointerBox,
		value = value,
		needs_release = True,
		transfers_ownership = True
	}


pure func boxed_string_construct(value: CoreExpr) -> CoreExpr:
	UnionConstructExpr(
		{
			type_name = "BoxedString",
			constructor_name = "Node",
			constructor_c_name = "Node",
			representation = GenericUnionRepresentation,
			payload_storage = ErasedUnionPayloadStorage,
			uses_release_mask = False,
			release_mask = 0,
			args = [transferring_boxed_value(value)]
		},
		boxed_string_type(),
		SyntheticSourceLoc,
	)


pure func union_variant(
	name: String,
	tag: Int,
	def_id: Option[Int],
	fields: List[CoreUnionField],
) -> CoreUnionVariant:
	{
		name = name,
		c_name = name,
		tag_c_name = "TAG_Tree_${name}",
		tag = tag,
		fields = fields,
		def_id = def_id
	}


pure func decl_env_program() -> CoreProgram:
	{
		decls = [
			HeapRecordDecl({
				name = "Node",
				type_params = [],
				fields = [],
				loc = SyntheticSourceLoc,
			}),
			UnionDecl({
				name = "Tree",
				type_params = [],
				payload_storage = ErasedUnionPayloadStorage,
				variants = [
					union_variant("Leaf", 0, None, []),
					union_variant(
						"Node",
						1,
						Some(42),
						[union_field(string_type()), union_field(string_type())],
					),
				],
				loc = SyntheticSourceLoc,
			}),
			UnionDecl({
				name = "BoxedString",
				type_params = [],
				payload_storage = ErasedUnionPayloadStorage,
				variants = [union_variant("Node", 0, Some(99), [union_field(string_type())])],
				loc = SyntheticSourceLoc,
			}),
		],
		foreign_includes = []
	}


pure func arg_mode_equal(left: OwnershipArgMode, right: OwnershipArgMode) -> Bool:
	match left:
		BorrowArg:
			match right:
				BorrowArg:
					True
				RetainArg:
					False
				ConsumeArg:
					False
				CowConsumeArg:
					False
				TransferArg:
					False
		RetainArg:
			match right:
				BorrowArg:
					False
				RetainArg:
					True
				ConsumeArg:
					False
				CowConsumeArg:
					False
				TransferArg:
					False
		ConsumeArg:
			match right:
				BorrowArg:
					False
				RetainArg:
					False
				ConsumeArg:
					True
				CowConsumeArg:
					False
				TransferArg:
					False
		CowConsumeArg:
			match right:
				BorrowArg:
					False
				RetainArg:
					False
				ConsumeArg:
					False
				CowConsumeArg:
					True
				TransferArg:
					False
		TransferArg:
			match right:
				BorrowArg:
					False
				RetainArg:
					False
				ConsumeArg:
					False
				CowConsumeArg:
					False
				TransferArg:
					True


pure func arg_modes_equal(left: List[OwnershipArgMode], right: List[OwnershipArgMode]) -> Bool:
	match left:
		[]:
			match right:
				[]:
					True
				[right_head, ...right_tail]:
					False
		[left_head, ...left_tail]:
			match right:
				[]:
					False
				[right_head, ...right_tail]:
					arg_mode_equal(left_head, right_head) and arg_modes_equal(left_tail, right_tail)


pure func int_lists_equal(left: List[Int], right: List[Int]) -> Bool:
	match left:
		[]:
			right.length() == 0
		[left_head, ...left_tail]:
			match right:
				[]:
					False
				[right_head, ...right_tail]:
					left_head == right_head and int_lists_equal(left_tail, right_tail)


pure func result_mode_equal(left: OwnershipResultMode, right: OwnershipResultMode) -> Bool:
	match left:
		ReturnVoid:
			match right:
				ReturnVoid:
					True
				ReturnPrimitive:
					False
				ReturnOwned:
					False
				ReturnBorrowed:
					False
				ReturnAliasOfArg(right_index):
					False
		ReturnPrimitive:
			match right:
				ReturnVoid:
					False
				ReturnPrimitive:
					True
				ReturnOwned:
					False
				ReturnBorrowed:
					False
				ReturnAliasOfArg(right_index):
					False
		ReturnOwned:
			match right:
				ReturnVoid:
					False
				ReturnPrimitive:
					False
				ReturnOwned:
					True
				ReturnBorrowed:
					False
				ReturnAliasOfArg(right_index):
					False
		ReturnBorrowed:
			match right:
				ReturnVoid:
					False
				ReturnPrimitive:
					False
				ReturnOwned:
					False
				ReturnBorrowed:
					True
				ReturnAliasOfArg(right_index):
					False
		ReturnAliasOfArg(left_index):
			match right:
				ReturnVoid:
					False
				ReturnPrimitive:
					False
				ReturnOwned:
					False
				ReturnBorrowed:
					False
				ReturnAliasOfArg(right_index):
					left_index == right_index


pure func contract_is(
	actual: Option[OwnershipCallContract],
	expected_args: List[OwnershipArgMode],
	expected_result: OwnershipResultMode,
) -> Bool:
	match actual:
		Some(contract):
			(
				arg_modes_equal(contract.args, expected_args)
				and result_mode_equal(contract.result, expected_result)
			)
		None:
			False


pure func contract_is_none(contract: Option[OwnershipCallContract]) -> Bool:
	match contract:
		Some(_):
			False
		None:
			True


pure func drop_count_for(name: String, expr: CoreExpr) -> Int:
	match expr:
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			nested: Int = drop_count_for(name, body)

			if variable.name == name:
				nested + 1
			else:
				nested
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			drop_count_for(name, body)
		LetExpr(variable, is_mutable, typ, rhs, body):
			drop_count_for(name, rhs) + drop_count_for(name, body)
		BorrowLetExpr(variable, typ, rhs, body):
			drop_count_for(name, rhs) + drop_count_for(name, body)
		SeqExpr(first, second):
			drop_count_for(name, first) + drop_count_for(name, second)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			drop_count_for(
				name,
				cond,
			) + drop_count_for(name, then_expr) + drop_count_for(name, else_expr)
		WhileExpr(cond, body, typ, loc):
			drop_count_for(name, cond) + drop_count_for(name, body)
		ForListExpr(loop, typ, loc):
			drop_count_for(name, loop.iterable) + drop_count_for(name, loop.body)
		BinaryExpr(op, left, right, typ, loc):
			drop_count_for(name, left) + drop_count_for(name, right)
		CallExpr(kind, callee, args, typ, loc):
			drop_count_for(name, callee) + drop_count_in_args(name, args)
		AssignExpr(variable, rhs, typ, loc):
			drop_count_for(name, rhs)
		LambdaExpr(params, return_type, body, is_pure, typ, loc):
			drop_count_for(name, body)
		UnionConstructExpr(construct, typ, loc):
			drop_count_in_boxed_values(name, construct.args)
		TupleExpr(items, typ, loc):
			drop_count_in_args(name, items)
		RecordExpr(fields, typ, loc):
			drop_count_in_record_fields(name, fields)
		RecordConstructExpr(type_name, fields, typ, loc):
			drop_count_in_record_fields(name, fields)
		ResourceScopeExpr(scope, typ, loc):
			drop_count_for(
				name,
				scope.acquire,
			) + drop_count_for(name, scope.body) + drop_count_for(name, scope.cleanup)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			drop_count_for(
				name,
				scrutinee,
			) + drop_count_in_constructor_cases(
				name,
				cases,
			) + drop_count_in_constructor_fallback(name, fallback)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			drop_count_for(
				name,
				scrutinee,
			) + drop_count_in_literal_cases(
				name,
				cases,
			) + drop_count_in_literal_fallback(name, fallback)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			drop_count_for(
				name,
				scrutinee,
			) + drop_count_in_constructor_literal_match(name, match_expr)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			drop_count_for(
				name,
				scrutinee,
			) + drop_count_in_constructor_length_match(name, match_expr)
		_:
			0


pure func drop_count_in_args(name: String, args: List[CoreExpr]) -> Int:
	var total: Int = 0

	for arg in args:
		total += drop_count_for(name, arg)

	total


pure func drop_count_in_record_fields(name: String, fields: List[CoreRecordFieldValue]) -> Int:
	var total: Int = 0

	for field in fields:
		total += drop_count_for(name, field.value)

	total


pure func drop_count_in_boxed_values(name: String, values: List[CoreBoxedStorageValue]) -> Int:
	var total: Int = 0

	for value in values:
		total += drop_count_for(name, value.value)

	total


pure func drop_count_in_constructor_body(name: String, body: CoreConstructorMatchBody) -> Int:
	match body:
		ConstructorMatchBodyExpr(expr):
			drop_count_for(name, expr)
		ConstructorMatchBodyLiteral(match_expr):
			drop_count_in_constructor_literal_match(name, match_expr)
		ConstructorMatchBodyLength(match_expr):
			drop_count_in_constructor_length_match(name, match_expr)


pure func drop_count_in_literal_cases(name: String, cases: List[CoreLiteralMatchCase]) -> Int:
	var total: Int = 0

	for match_case in cases:
		total += drop_count_for(name, match_case.body)

	total


pure func drop_count_in_literal_fallback(name: String, fallback: CoreLiteralMatchFallback) -> Int:
	match fallback:
		LiteralMatchFallbackBody(body):
			drop_count_for(name, body)
		LiteralMatchFallbackBindings(bindings, body):
			drop_count_for(name, body)
		LiteralMatchFallbackFail:
			0


pure func drop_count_in_constructor_literal_match(
	name: String,
	match_expr: CoreConstructorLiteralMatch,
) -> Int:
	drop_count_in_literal_cases(
		name,
		match_expr.cases,
	) + drop_count_in_literal_fallback(name, match_expr.fallback)


pure func drop_count_in_constructor_length_branch(
	name: String,
	branch: CoreConstructorLengthMatchBranch,
) -> Int:
	drop_count_in_constructor_body(name, branch.body)


pure func drop_count_in_constructor_length_cases(
	name: String,
	cases: List[CoreConstructorLengthMatchCase],
) -> Int:
	var total: Int = 0

	for match_case in cases:
		total += drop_count_in_constructor_length_branch(name, match_case.branch)

	total


pure func drop_count_in_constructor_length_geq(
	name: String,
	geq: Option[CoreConstructorLengthMatchGeq],
) -> Int:
	match geq:
		Some(match_case):
			drop_count_in_constructor_length_branch(name, match_case.branch)
		None:
			0


pure func drop_count_in_constructor_length_fallback(
	name: String,
	fallback: Option[CoreConstructorLengthMatchBranch],
) -> Int:
	match fallback:
		Some(branch):
			drop_count_in_constructor_length_branch(name, branch)
		None:
			0


pure func drop_count_in_constructor_length_match(
	name: String,
	match_expr: CoreConstructorLengthMatch,
) -> Int:
	drop_count_in_constructor_length_cases(
		name,
		match_expr.cases,
	) + drop_count_in_constructor_length_geq(
		name,
		match_expr.geq,
	) + drop_count_in_constructor_length_fallback(name, match_expr.fallback)


pure func drop_count_in_constructor_cases(
	name: String,
	cases: List[CoreConstructorMatchCase],
) -> Int:
	var total: Int = 0

	for match_case in cases:
		total += drop_count_in_constructor_body(name, match_case.body)

	total


pure func drop_count_in_constructor_fallback(
	name: String,
	fallback: CoreConstructorMatchFallback,
) -> Int:
	match fallback:
		ConstructorMatchFallbackBody(body):
			drop_count_for(name, body)
		_:
			0


pure func dup_count_for(name: String, expr: CoreExpr) -> Int:
	match expr:
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			nested: Int = dup_count_for(name, body)

			if variable.name == name:
				nested + 1
			else:
				nested
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			dup_count_for(name, body)
		LetExpr(variable, is_mutable, typ, rhs, body):
			dup_count_for(name, rhs) + dup_count_for(name, body)
		BorrowLetExpr(variable, typ, rhs, body):
			dup_count_for(name, rhs) + dup_count_for(name, body)
		SeqExpr(first, second):
			dup_count_for(name, first) + dup_count_for(name, second)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			dup_count_for(
				name,
				cond,
			) + dup_count_for(name, then_expr) + dup_count_for(name, else_expr)
		WhileExpr(cond, body, typ, loc):
			dup_count_for(name, cond) + dup_count_for(name, body)
		ForListExpr(loop, typ, loc):
			dup_count_for(name, loop.iterable) + dup_count_for(name, loop.body)
		BinaryExpr(op, left, right, typ, loc):
			dup_count_for(name, left) + dup_count_for(name, right)
		UnaryExpr(op, inner, typ, loc):
			dup_count_for(name, inner)
		LogicalExpr(op, left, right, typ, loc):
			dup_count_for(name, left) + dup_count_for(name, right)
		CastExpr(inner, typ, loc):
			dup_count_for(name, inner)
		BoxExpr(box, typ, loc):
			dup_count_for(name, box.value)
		UnboxExpr(kind, inner, typ, loc):
			dup_count_for(name, inner)
		FieldExpr(owner, field, typ, loc):
			dup_count_for(name, owner)
		TupleFieldExpr(owner, field_index, typ, loc):
			dup_count_for(name, owner)
		CallExpr(kind, callee, args, typ, loc):
			dup_count_for(name, callee) + dup_count_in_args(name, args)
		AssignExpr(variable, rhs, typ, loc):
			dup_count_for(name, rhs)
		LambdaExpr(params, return_type, body, is_pure, typ, loc):
			dup_count_for(name, body)
		UnionConstructExpr(construct, typ, loc):
			dup_count_in_boxed_values(name, construct.args)
		ListHandoffSetOwnedExpr(set, typ, loc):
			dup_count_for(
				name,
				set.list,
			) + dup_count_for(name, set.index) + dup_count_for(name, set.value.value)
		ListSetExpr(set, typ, loc):
			dup_count_for(
				name,
				set.list,
			) + dup_count_for(name, set.index) + dup_count_for(name, set.value.value)
		TupleExpr(items, typ, loc):
			dup_count_in_args(name, items)
		RecordExpr(fields, typ, loc):
			dup_count_in_record_fields(name, fields)
		RecordConstructExpr(type_name, fields, typ, loc):
			dup_count_in_record_fields(name, fields)
		ResourceScopeExpr(scope, typ, loc):
			dup_count_for(
				name,
				scope.acquire,
			) + dup_count_for(name, scope.body) + dup_count_for(name, scope.cleanup)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			dup_count_for(
				name,
				scrutinee,
			) + dup_count_in_constructor_cases(
				name,
				cases,
			) + dup_count_in_constructor_fallback(name, fallback)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			dup_count_for(
				name,
				scrutinee,
			) + dup_count_in_literal_cases(
				name,
				cases,
			) + dup_count_in_literal_fallback(name, fallback)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			dup_count_for(
				name,
				scrutinee,
			) + dup_count_in_constructor_literal_match(name, match_expr)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			dup_count_for(name, scrutinee) + dup_count_in_constructor_length_match(name, match_expr)
		_:
			0


pure func dup_count_in_args(name: String, args: List[CoreExpr]) -> Int:
	var total: Int = 0

	for arg in args:
		total += dup_count_for(name, arg)

	total


pure func dup_count_in_record_fields(name: String, fields: List[CoreRecordFieldValue]) -> Int:
	var total: Int = 0

	for field in fields:
		total += dup_count_for(name, field.value)

	total


pure func dup_count_in_boxed_values(name: String, values: List[CoreBoxedStorageValue]) -> Int:
	var total: Int = 0

	for value in values:
		total += dup_count_for(name, value.value)

	total


pure func dup_count_in_constructor_body(name: String, body: CoreConstructorMatchBody) -> Int:
	match body:
		ConstructorMatchBodyExpr(expr):
			dup_count_for(name, expr)
		ConstructorMatchBodyLiteral(match_expr):
			dup_count_in_constructor_literal_match(name, match_expr)
		ConstructorMatchBodyLength(match_expr):
			dup_count_in_constructor_length_match(name, match_expr)


pure func dup_count_in_literal_cases(name: String, cases: List[CoreLiteralMatchCase]) -> Int:
	var total: Int = 0

	for match_case in cases:
		total += dup_count_for(name, match_case.body)

	total


pure func dup_count_in_literal_fallback(name: String, fallback: CoreLiteralMatchFallback) -> Int:
	match fallback:
		LiteralMatchFallbackBody(body):
			dup_count_for(name, body)
		LiteralMatchFallbackBindings(bindings, body):
			dup_count_for(name, body)
		LiteralMatchFallbackFail:
			0


pure func dup_count_in_constructor_literal_match(
	name: String,
	match_expr: CoreConstructorLiteralMatch,
) -> Int:
	dup_count_in_literal_cases(
		name,
		match_expr.cases,
	) + dup_count_in_literal_fallback(name, match_expr.fallback)


pure func owner_drop_wraps_payload_dup_in_constructor_body(
	owner: String,
	payload: String,
	body: CoreConstructorMatchBody,
) -> Bool:
	match body:
		ConstructorMatchBodyExpr(expr):
			owner_drop_wraps_payload_dup(owner, payload, expr)
		_:
			False


pure func owner_drop_wraps_payload_dup_in_constructor_cases(
	owner: String,
	payload: String,
	cases: List[CoreConstructorMatchCase],
) -> Bool:
	cases.any(func(match_case):
		owner_drop_wraps_payload_dup_in_constructor_body(owner, payload, match_case.body)
	)


pure func owner_drop_wraps_payload_dup_in_constructor_fallback(
	owner: String,
	payload: String,
	fallback: CoreConstructorMatchFallback,
) -> Bool:
	match fallback:
		ConstructorMatchFallbackBody(body):
			owner_drop_wraps_payload_dup(owner, payload, body)
		ConstructorMatchFallbackBindings(_, body):
			owner_drop_wraps_payload_dup(owner, payload, body)
		ConstructorMatchFallbackFail:
			False


pure func owner_drop_wraps_payload_dup_in_exprs(
	owner: String,
	payload: String,
	exprs: List[CoreExpr],
) -> Bool:
	exprs.any(func(expr): owner_drop_wraps_payload_dup(owner, payload, expr))


pure func owner_drop_wraps_payload_dup(owner: String, payload: String, expr: CoreExpr) -> Bool:
	match expr:
		DropExpr(variable, _, _, body, _, _):
			(
				variable.name == owner and dup_count_for(payload, body) > 0
				or owner_drop_wraps_payload_dup(owner, payload, body)
			)
		DupExpr(_, _, _, body, _, _):
			owner_drop_wraps_payload_dup(owner, payload, body)
		LetExpr(_, _, _, rhs, body):
			(
				owner_drop_wraps_payload_dup(owner, payload, rhs)
				or owner_drop_wraps_payload_dup(owner, payload, body)
			)
		BorrowLetExpr(_, _, rhs, body):
			(
				owner_drop_wraps_payload_dup(owner, payload, rhs)
				or owner_drop_wraps_payload_dup(owner, payload, body)
			)
		SeqExpr(first, second):
			(
				owner_drop_wraps_payload_dup(owner, payload, first)
				or owner_drop_wraps_payload_dup(owner, payload, second)
			)
		IfExpr(cond, then_expr, else_expr, _, _):
			(
				owner_drop_wraps_payload_dup(owner, payload, cond)
				or owner_drop_wraps_payload_dup(owner, payload, then_expr)
				or owner_drop_wraps_payload_dup(owner, payload, else_expr)
			)
		CallExpr(_, callee, args, _, _):
			(
				owner_drop_wraps_payload_dup(owner, payload, callee)
				or owner_drop_wraps_payload_dup_in_exprs(owner, payload, args)
			)
		ConstructorMatchExpr(scrutinee, _, cases, fallback, _, _):
			(
				owner_drop_wraps_payload_dup(owner, payload, scrutinee)
				or owner_drop_wraps_payload_dup_in_constructor_cases(owner, payload, cases)
				or owner_drop_wraps_payload_dup_in_constructor_fallback(owner, payload, fallback)
			)
		_:
			False


pure func dup_count_in_constructor_length_branch(
	name: String,
	branch: CoreConstructorLengthMatchBranch,
) -> Int:
	dup_count_in_constructor_body(name, branch.body)


pure func dup_count_in_constructor_length_cases(
	name: String,
	cases: List[CoreConstructorLengthMatchCase],
) -> Int:
	var total: Int = 0

	for match_case in cases:
		total += dup_count_in_constructor_length_branch(name, match_case.branch)

	total


pure func dup_count_in_constructor_length_geq(
	name: String,
	geq: Option[CoreConstructorLengthMatchGeq],
) -> Int:
	match geq:
		Some(match_case):
			dup_count_in_constructor_length_branch(name, match_case.branch)
		None:
			0


pure func dup_count_in_constructor_length_fallback(
	name: String,
	fallback: Option[CoreConstructorLengthMatchBranch],
) -> Int:
	match fallback:
		Some(branch):
			dup_count_in_constructor_length_branch(name, branch)
		None:
			0


pure func dup_count_in_constructor_length_match(
	name: String,
	match_expr: CoreConstructorLengthMatch,
) -> Int:
	dup_count_in_constructor_length_cases(
		name,
		match_expr.cases,
	) + dup_count_in_constructor_length_geq(
		name,
		match_expr.geq,
	) + dup_count_in_constructor_length_fallback(name, match_expr.fallback)


pure func dup_count_in_constructor_cases(
	name: String,
	cases: List[CoreConstructorMatchCase],
) -> Int:
	var total: Int = 0

	for match_case in cases:
		total += dup_count_in_constructor_body(name, match_case.body)

	total


pure func dup_count_in_constructor_fallback(
	name: String,
	fallback: CoreConstructorMatchFallback,
) -> Int:
	match fallback:
		ConstructorMatchFallbackBody(body):
			dup_count_for(name, body)
		_:
			0


pure func is_post_drop_after_value(name: String, expr: CoreExpr) -> Bool:
	match expr:
		LetExpr(temp_var, is_mutable, temp_type, rhs, body):
			match rhs:
				CallExpr(kind, callee, args, typ, loc):
					match body:
						DropExpr(drop_var, value_type, release_policy, drop_body, drop_type, drop_loc):
							match drop_body:
								VarExpr(result_var, result_type, result_loc):
									drop_var.name == name and result_var.name == temp_var.name
								_:
									False
						_:
							False
				_:
					False
		_:
			False


pure func outer_let_body_is_post_drop_after_value(name: String, expr: CoreExpr) -> Bool:
	match expr:
		LetExpr(variable, is_mutable, typ, rhs, body):
			body_is_post_drop_after_value(name, body)
		_:
			False


pure func body_is_post_drop_after_value(name: String, body: CoreExpr) -> Bool:
	match body:
		DupExpr(variable, value_type, policy, inner, typ, loc):
			if variable.name == name:
				False
			else:
				body_is_post_drop_after_value(name, inner)
		_:
			is_post_drop_after_value(name, body)


pure func outer_let_body_is_post_drop_after_raw_view(name: String, expr: CoreExpr) -> Bool:
	match expr:
		LetExpr(variable, is_mutable, typ, rhs, body):
			match body:
				LetExpr(result_var, False, result_type, TensorRawViewLetExpr(binding, raw_body, raw_type, raw_loc), DropExpr(drop_var, _, _, VarExpr(returned, _, _), _, _)):
					drop_var.name == name and returned.name == result_var.name
				_:
					False
		_:
			False


pure func outer_let_body_is_post_drop_after_accessor_match(name: String, expr: CoreExpr) -> Bool:
	match expr:
		LetExpr(variable, is_mutable, typ, rhs, body):
			match body:
				LetExpr(result_var, False, result_type, AccessorLiteralMatchExpr(scrutinee, policy, match_expr, match_type, match_loc), DropExpr(drop_var, _, _, VarExpr(returned, _, _), _, _)):
					drop_var.name == name and returned.name == result_var.name
				_:
					False
		_:
			False


pure func outer_let_body_is_post_drop_after_length_match(name: String, expr: CoreExpr) -> Bool:
	match expr:
		LetExpr(variable, is_mutable, typ, rhs, body):
			match body:
				LetExpr(result_var, False, result_type, LengthMatchExpr(scrutinee, policy, match_expr, match_type, match_loc), DropExpr(drop_var, _, _, VarExpr(returned, _, _), _, _)):
					drop_var.name == name and returned.name == result_var.name
				_:
					False
		_:
			False


pure func has_drop_before_assign_for(name: String, expr: CoreExpr) -> Bool:
	match expr:
		SeqExpr(first, second):
			match first:
				DropExpr(variable, value_type, release_policy, body, typ, loc):
					match second:
						AssignExpr(target, rhs, assign_type, assign_loc):
							variable.name == name and target.name == name
						_:
							(
								has_drop_before_assign_for(name, first)
								or has_drop_before_assign_for(name, second)
							)
				_:
					(
						has_drop_before_assign_for(name, first)
						or has_drop_before_assign_for(name, second)
					)
		LetExpr(variable, is_mutable, typ, rhs, body):
			has_drop_before_assign_for(name, rhs) or has_drop_before_assign_for(name, body)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			has_drop_before_assign_for(name, body)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			has_drop_before_assign_for(name, body)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			(
				has_drop_before_assign_for(name, cond)
				or has_drop_before_assign_for(name, then_expr)
				or has_drop_before_assign_for(name, else_expr)
			)
		WhileExpr(cond, body, typ, loc):
			has_drop_before_assign_for(name, cond) or has_drop_before_assign_for(name, body)
		ForListExpr(loop, typ, loc):
			(
				has_drop_before_assign_for(name, loop.iterable)
				or has_drop_before_assign_for(name, loop.body)
			)
		_:
			False


pure func is_pre_drop_before_int(name: String, expected: Int, expr: CoreExpr) -> Bool:
	match expr:
		DropExpr(drop_var, value_type, release_policy, body, typ, loc):
			match body:
				LiteralExpr(IntLiteral(value), literal_type, literal_loc):
					drop_var.name == name and value == expected
				_:
					False
		_:
			False


pure func top_let_if_has_branch_drops(name: String, expr: CoreExpr) -> Bool:
	match expr:
		LetExpr(variable, is_mutable, typ, rhs, body):
			body_if_has_branch_drops(name, body)
		_:
			False


pure func body_if_has_branch_drops(name: String, body: CoreExpr) -> Bool:
	match body:
		DupExpr(variable, value_type, policy, inner, typ, loc):
			if variable.name == name:
				False
			else:
				body_if_has_branch_drops(name, inner)
		_:
			match body:
				IfExpr(cond, then_expr, else_expr, if_type, if_loc):
					(
						is_post_drop_after_value(name, then_expr)
						and is_pre_drop_before_int(name, 0, else_expr)
					)
				_:
					False


pure func expr_has_while_body_dup(name: String, expr: CoreExpr) -> Bool:
	match expr:
		WhileExpr(cond, loop_body, while_type, loc):
			dup_count_for(name, loop_body) > 0
		SeqExpr(first, second):
			expr_has_while_body_dup(name, first) or expr_has_while_body_dup(name, second)
		LetExpr(variable, is_mutable, typ, rhs, body):
			expr_has_while_body_dup(name, rhs) or expr_has_while_body_dup(name, body)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			expr_has_while_body_dup(name, body)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			expr_has_while_body_dup(name, body)
		_:
			False


pure func top_let_while_body_has_dup(name: String, expr: CoreExpr) -> Bool:
	match expr:
		LetExpr(variable, is_mutable, typ, rhs, body):
			expr_has_while_body_dup(name, body)
		_:
			False


pure func expr_has_for_list_body_dup(name: String, expr: CoreExpr) -> Bool:
	match expr:
		ForListExpr(loop, typ, loc):
			dup_count_for(name, loop.body) > 0
		SeqExpr(first, second):
			expr_has_for_list_body_dup(name, first) or expr_has_for_list_body_dup(name, second)
		LetExpr(variable, is_mutable, typ, rhs, body):
			expr_has_for_list_body_dup(name, rhs) or expr_has_for_list_body_dup(name, body)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			expr_has_for_list_body_dup(name, body)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			expr_has_for_list_body_dup(name, body)
		_:
			False


pure func top_let_for_list_body_has_dup(name: String, expr: CoreExpr) -> Bool:
	match expr:
		LetExpr(variable, is_mutable, typ, rhs, body):
			expr_has_for_list_body_dup(name, body)
		_:
			False


pure func top_let_if_has_borrowed_then_only_drop(name: String, expr: CoreExpr) -> Bool:
	match expr:
		LetExpr(variable, is_mutable, typ, rhs, body):
			body_if_has_borrowed_then_only_drop(name, body)
		_:
			False


pure func body_if_has_borrowed_then_only_drop(name: String, body: CoreExpr) -> Bool:
	match body:
		DupExpr(variable, value_type, policy, inner, typ, loc):
			if variable.name == name:
				False
			else:
				body_if_has_borrowed_then_only_drop(name, inner)
		_:
			match body:
				IfExpr(cond, then_expr, else_expr, if_type, if_loc):
					(
						is_post_drop_after_value(name, then_expr)
						and drop_count_for(name, else_expr) == 0
					)
				_:
					False


pure func top_let_body_is_constructor_match(expr: CoreExpr) -> Bool:
	match expr:
		LetExpr(variable, is_mutable, typ, rhs, body):
			body_is_constructor_match(body)
		_:
			False


pure func body_is_constructor_match(body: CoreExpr) -> Bool:
	match body:
		DupExpr(variable, value_type, policy, inner, typ, loc):
			body_is_constructor_match(inner)
		_:
			match body:
				ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, match_type, loc):
					True
				_:
					False


pure func top_let_body_is_post_drop_after_constructor_match(name: String, expr: CoreExpr) -> Bool:
	match expr:
		LetExpr(variable, is_mutable, typ, rhs, body):
			body_is_post_drop_after_constructor_match(name, body)
		_:
			False


pure func body_is_post_drop_after_constructor_match(name: String, body: CoreExpr) -> Bool:
	match body:
		DupExpr(variable, value_type, policy, inner, typ, loc):
			if variable.name == name:
				False
			else:
				body_is_post_drop_after_constructor_match(name, inner)
		_:
			match body:
				LetExpr(temp_var, temp_mutable, temp_type, match_body, drop_body):
					match match_body:
						ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, match_type, loc):
							match drop_body:
								DropExpr(drop_var, value_type, release_policy, returned, drop_type, drop_loc):
									match returned:
										VarExpr(result_var, result_type, result_loc):
											(
												drop_var.name == name
												and result_var.name == temp_var.name
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func constructor_body_has_post_drop(name: String, body: CoreConstructorMatchBody) -> Bool:
	match body:
		ConstructorMatchBodyExpr(expr):
			is_post_drop_after_value(name, expr)
		_:
			False


pure func top_let_first_constructor_case_shadows(name: String, expr: CoreExpr) -> Bool:
	match expr:
		LetExpr(variable, is_mutable, typ, rhs, body):
			match body:
				ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, match_type, loc):
					match cases.get(0):
						Some(match_case):
							match_case.bindings.any(func(binding): binding.variable.name == name)
						None:
							False
				_:
					False
		_:
			False


pure func top_let_first_constructor_case_binding_has_identity(
	name: String,
	def_id: Int,
	expr: CoreExpr,
) -> Bool:
	match expr:
		LetExpr(variable, is_mutable, typ, rhs, body):
			match body:
				ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, match_type, loc):
					match cases.get(0):
						Some(match_case):
							match match_case.bindings.get(0):
								Some(binding):
									(
										binding.variable.name == name
										and binding.variable.def_id == Some(def_id)
									)
								None:
									False
						None:
							False
				_:
					False
		_:
			False


pure func constructor_fallback_has_pre_drop_int(
	name: String,
	expected: Int,
	fallback: CoreConstructorMatchFallback,
) -> Bool:
	match fallback:
		ConstructorMatchFallbackBody(fallback_body):
			is_pre_drop_before_int(name, expected, fallback_body)
		_:
			False


pure func constructor_fallback_has_no_drop_or_fail(
	name: String,
	fallback: CoreConstructorMatchFallback,
) -> Bool:
	match fallback:
		ConstructorMatchFallbackBody(fallback_body):
			drop_count_for(name, fallback_body) == 0
		ConstructorMatchFallbackFail:
			True
		_:
			False


pure func constructor_case_has_branch_drops(
	name: String,
	match_case: CoreConstructorMatchCase,
	fallback: CoreConstructorMatchFallback,
) -> Bool:
	(
		constructor_body_has_post_drop(name, match_case.body)
		and constructor_fallback_has_pre_drop_int(name, 0, fallback)
	)


pure func constructor_case_has_borrowed_case_only_drop(
	name: String,
	match_case: CoreConstructorMatchCase,
	fallback: CoreConstructorMatchFallback,
) -> Bool:
	(
		constructor_body_has_post_drop(name, match_case.body)
		and constructor_fallback_has_no_drop_or_fail(name, fallback)
	)


pure func top_let_constructor_match_has_branch_drops(name: String, expr: CoreExpr) -> Bool:
	match expr:
		LetExpr(variable, is_mutable, typ, rhs, body):
			body_constructor_match_has_branch_drops(name, body)
		_:
			False


pure func body_constructor_match_has_branch_drops(name: String, body: CoreExpr) -> Bool:
	match body:
		DupExpr(variable, value_type, policy, inner, typ, loc):
			if variable.name == name:
				False
			else:
				body_constructor_match_has_branch_drops(name, inner)
		_:
			match body:
				ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, match_type, loc):
					match cases:
						[match_case]:
							constructor_case_has_branch_drops(name, match_case, fallback)
						_:
							False
				_:
					False


pure func top_let_constructor_match_has_borrowed_case_only_drop(
	name: String,
	expr: CoreExpr,
) -> Bool:
	match expr:
		LetExpr(variable, is_mutable, typ, rhs, body):
			body_constructor_match_has_borrowed_case_only_drop(name, body)
		_:
			False


pure func body_constructor_match_has_borrowed_case_only_drop(name: String, body: CoreExpr) -> Bool:
	match body:
		DupExpr(variable, value_type, policy, inner, typ, loc):
			if variable.name == name:
				False
			else:
				body_constructor_match_has_borrowed_case_only_drop(name, inner)
		_:
			match body:
				ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, match_type, loc):
					match cases:
						[match_case]:
							constructor_case_has_borrowed_case_only_drop(name, match_case, fallback)
						_:
							False
				_:
					False


pure func nested_constructor_match_drops_only_first_case(name: String, body: CoreExpr) -> Bool:
	match body:
		LetExpr(variable, is_mutable, typ, rhs, inner):
			(
				nested_constructor_match_drops_only_first_case(name, rhs)
				or nested_constructor_match_drops_only_first_case(name, inner)
			)
		BorrowLetExpr(variable, typ, rhs, inner):
			(
				nested_constructor_match_drops_only_first_case(name, rhs)
				or nested_constructor_match_drops_only_first_case(name, inner)
			)
		SeqExpr(first, second):
			(
				nested_constructor_match_drops_only_first_case(name, first)
				or nested_constructor_match_drops_only_first_case(name, second)
			)
		DupExpr(variable, value_type, policy, inner, typ, loc):
			nested_constructor_match_drops_only_first_case(name, inner)
		DropExpr(variable, value_type, policy, inner, typ, loc):
			nested_constructor_match_drops_only_first_case(name, inner)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, match_type, loc):
			match cases:
				[first, second]:
					match (first.body, second.body):
						(ConstructorMatchBodyExpr(first_body), ConstructorMatchBodyExpr(second_body)):
							(
								drop_count_for(name, first_body) == 1
								and drop_count_for(name, second_body) == 0
							)
						_:
							False
				_:
					False
		_:
			False


pure func nested_if_drops_only_else_branch(name: String, body: CoreExpr) -> Bool:
	match body:
		LetExpr(variable, is_mutable, typ, rhs, inner):
			(
				nested_if_drops_only_else_branch(name, rhs)
				or nested_if_drops_only_else_branch(name, inner)
			)
		BorrowLetExpr(variable, typ, rhs, inner):
			(
				nested_if_drops_only_else_branch(name, rhs)
				or nested_if_drops_only_else_branch(name, inner)
			)
		SeqExpr(first, second):
			(
				nested_if_drops_only_else_branch(name, first)
				or nested_if_drops_only_else_branch(name, second)
			)
		DupExpr(variable, value_type, policy, inner, typ, loc):
			nested_if_drops_only_else_branch(name, inner)
		DropExpr(variable, value_type, policy, inner, typ, loc):
			nested_if_drops_only_else_branch(name, inner)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			drop_count_for(name, then_expr) == 0 and drop_count_for(name, else_expr) == 1
		_:
			False


pure func literal_fallback_has_pre_drop_int(
	name: String,
	expected: Int,
	fallback: CoreLiteralMatchFallback,
) -> Bool:
	match fallback:
