pure func test_consuming_user_call_propagates_consumed_parameter() -> Bool:
	callee: CoreDecl = function_decl(
		"take",
		87,
		[core_param("owned", list_int_type())],
		list_int_type(),
		intrinsic_expr("list_ensure_unique", [var_expr("owned", list_int_type())], list_int_type()),
	)
	forward: CoreDecl = function_decl(
		"forward",
		88,
		[core_param("borrowed", list_int_type())],
		list_int_type(),
		user_call_expr(
			"take",
			Some(87),
			[0],
			[var_expr("borrowed", list_int_type())],
			list_int_type(),
		),
	)
	program: CoreProgram = {
		decls = [callee, forward],
		foreign_includes = []
	}
	rewritten: CoreProgram = insert_drops_program(program)

	match function_body(rewritten, "forward"):
		Some(body):
			dup_count_for("borrowed", body) == 0 and drop_count_for("borrowed", body) == 0
		None:
			False


pure func test_program_infers_read_only_user_call_borrows_argument() -> Bool:
	inspect: CoreDecl = function_decl(
		"inspect",
		89,
		[core_param("value", list_int_type())],
		int_type(),
		intrinsic_expr("list_len", [var_expr("value", list_int_type())], int_type()),
	)
	caller_body: CoreExpr = LetExpr(
		named_var("xs"),
