	inner_match: CoreExpr = ConstructorMatchExpr(
		var_expr("answer", outer_result_type),
		NoReleasePolicy,
		[constructor_case("Ok", [], int_expr(1))],
		ConstructorMatchFallbackBody(int_expr(0)),
		int_type(),
		SyntheticSourceLoc,
	)
	outer_match: CoreExpr = ConstructorMatchExpr(
		var_expr("answer", outer_result_type),
		NoReleasePolicy,
		[constructor_case("Ok", [], inner_match)],
		ConstructorMatchFallbackBody(int_expr(0)),
		int_type(),
		SyntheticSourceLoc,
	)
	concurrent_expr: CoreExpr = PreClosureConcurrentExpr(
		{
			bindings = [
				{
					variable = named_var("answer"),
					typ = outer_result_type,
					rhs = var_expr("source", inner_result_type)
				},
			],
			body = outer_match,
			timeout = None,
			max_threads = None
		},
		int_type(),
		SyntheticSourceLoc,
	)
	rewritten: CoreExpr = insert_drops_expr(empty_env(), concurrent_expr)

	dup_count_for("answer", rewritten) == 0


