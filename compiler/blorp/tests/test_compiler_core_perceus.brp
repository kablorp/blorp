pure func literal_case_has_branch_drops(
	name: String,
	match_case: CoreLiteralMatchCase,
	fallback: CoreLiteralMatchFallback,
) -> Bool:
	(
		is_post_drop_after_value(name, match_case.body)
		and literal_fallback_has_pre_drop_int(name, 0, fallback)
	)


