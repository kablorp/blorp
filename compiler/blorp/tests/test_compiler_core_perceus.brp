	shared_def_id: Int = 1300
	read: CoreDecl = function_decl(
		"read_specialization",
		shared_def_id,
		[core_param("value", list_int_type())],
		int_type(),
		intrinsic_expr("list_len", [var_expr("value", list_int_type())], int_type()),
	)
	consume: CoreDecl = function_decl(
		"consume_specialization",
		shared_def_id,
		[core_param("value", list_int_type())],
		list_int_type(),
		intrinsic_expr("list_ensure_unique", [var_expr("value", list_int_type())], list_int_type()),
	)
	read_caller: CoreDecl = function_decl(
		"read_caller",
		1301,
		[core_param("value", list_int_type())],
		int_type(),
		user_call_expr(
			"read_specialization",
			Some(shared_def_id),
			[],
			[var_expr("value", list_int_type())],
			int_type(),
		),
	)
	consume_caller: CoreDecl = function_decl(
		"consume_caller",
		1302,
		[core_param("value", list_int_type())],
		list_int_type(),
		user_call_expr(
			"consume_specialization",
			Some(shared_def_id),
			[],
			[var_expr("value", list_int_type())],
			list_int_type(),
		),
	)
	rewritten: CoreProgram = insert_drops_program({
		decls = [read, consume, read_caller, consume_caller],
		foreign_includes = [],
	})

	read_borrows: Bool = match function_body(rewritten, "read_caller"):
		Some(CallExpr(UserCall(name, def_id, consumed_args), callee, args, typ, loc)):
			consumed_args.length() == 0
		Some(body):
			False
		None:
			False

	consume_transfers: Bool = match function_body(rewritten, "consume_caller"):
		Some(CallExpr(UserCall(name, def_id, consumed_args), callee, args, typ, loc)):
			int_lists_equal(consumed_args, [0])
		Some(body):
			False
		None:
			False

	read_borrows and consume_transfers


