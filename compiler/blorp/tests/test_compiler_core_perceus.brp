pure func test_default_managed_types() -> Bool:
	env: PerceusEnv = empty_env()

	(
		is_managed_type(env, string_type())
		and is_managed_type(env, list_int_type())
		and is_managed_type(
			env,
			BoxedResultType(string_type(), int_type()),
		)
		and is_managed_type(
			env,
			StackResultType(string_type(), int_type()),
		)
		and not is_managed_type(
			env,
			StackResultType(int_type(), int_type()),
		)
		and is_managed_type(env, TupleType([string_type()]))
		and is_managed_type(env, closure_type())
		and is_managed_type(
			env,
			NamedType(
				"FallibleStream",
				[int_type(), string_type()],
			),
		)
		and is_managed_type(
			env,
			NamedType("std_stream__Stream", [int_type()]),
		)
		and is_managed_type(
			env,
			NamedType(
				"std/stream::FallibleStream",
				[int_type(), string_type()],
			),
		)
		and is_managed_type(
			env,
			NamedType(
				"std_stream__ResourceSource",
				[int_type(), string_type()],
			),
		)
		and is_managed_type(
			env,
			NamedType(
				"std/stream::ResourceSource",
				[int_type(), string_type()],
			),
		)
		and not is_managed_type(
			env,
			NamedType("Option", [int_type()]),
		)
		and is_managed_type(
			env,
			NamedType("Option", [string_type()]),
		)
		and is_managed_type(
			env,
			NamedType("Option", [NamedType("Option", [int_type()])]),
		)
		and not is_managed_type(env, int_type())
		and not is_managed_type(env, bool_type())
	)


pure func test_program_decls_extend_managed_types() -> Bool:
	env: PerceusEnv = build_env(decl_env_program())

	is_managed_type(
