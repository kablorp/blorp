				85,
				[core_param("node", HeapRecordType("Node"))],
				string_type(),
				field_result,
			)],
		foreign_includes = []
	}
	rewritten: CoreProgram = insert_drops_program(program)

	match function_body(rewritten, "node_text"):
		Some(body):
			dup_count_for("__borrowed_result_node_0", body) == 1
		None:
			False


