pure func constructor_length_fallback_has_pre_drop_int(
	name: String,
	expected: Int,
	fallback: Option[CoreConstructorLengthMatchBranch],
) -> Bool:
	match fallback:
		Some(branch):
			match branch.body:
				ConstructorMatchBodyExpr(expr):
					is_pre_drop_before_int(name, expected, expr)
				_:
					False
		None:
			False


