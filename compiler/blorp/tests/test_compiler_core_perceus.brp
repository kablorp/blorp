pure func test_user_contract_inference_converges_beyond_eight_edges() -> Bool:
	depth: Int = 12
	leaf_name: String = "inspect_${depth}"
	var decls: List[CoreDecl] = [function_decl(
			leaf_name,
			900 + depth,
			[core_param("value", list_int_type())],
			int_type(),
			intrinsic_expr("list_len", [var_expr("value", list_int_type())], int_type()),
		)]
	var index: Int = depth - 1

	while index >= 0:
		name: String = "inspect_${index}"
		callee_name: String = "inspect_${index + 1}"
		decls = decls.append(
			function_decl(
				name,
				900 + index,
				[core_param("value", list_int_type())],
				int_type(),
				user_call_expr(
					callee_name,
					Some(901 + index),
					[],
					[var_expr("value", list_int_type())],
					int_type(),
				),
			),
		)
		index -= 1

	rewritten: CoreProgram = insert_drops_program({
		decls = decls,
		foreign_includes = [],
	})

	match function_body(rewritten, "inspect_0"):
		Some(CallExpr(UserCall(name, def_id, consumed_args), callee, args, typ, loc)):
			consumed_args.length() == 0
		Some(body):
			False
		None:
			False


