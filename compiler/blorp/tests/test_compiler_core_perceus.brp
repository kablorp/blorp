	) and is_managed_type(env, UnionType("AnyUnion"))


pure func test_result_mode_for_type() -> Bool:
	env: PerceusEnv = empty_env()

	result_mode_equal(
		result_mode_for_type(env, void_type()),
		ReturnVoid,
	) and result_mode_equal(
		result_mode_for_type(env, int_type()),
		ReturnPrimitive,
	) and result_mode_equal(
		result_mode_for_type(env, string_type()),
		ReturnOwned,
	) and result_mode_equal(
		result_mode_for_type(
			env,
			StackResultType(string_type(), int_type()),
		),
		ReturnOwned,
	) and result_mode_equal(
		result_mode_for_type(
			env,
			StackResultType(int_type(), int_type()),
		),
		ReturnPrimitive,
	) and result_mode_equal(
		result_mode_for_type(env, TupleType([string_type()])),
		ReturnOwned,
	)


pure func test_stack_result_uses_stack_ownership_policies() -> Bool:
	result_type: CoreType = StackResultType(string_type(), int_type())
	unused: CoreExpr = insert_drops_expr(
		empty_env(),
		LetExpr(
			named_var("result"),
			False,
			result_type,
			var_expr("source", result_type),
			int_expr(0),
		),
	)
	reused: CoreExpr = insert_drops_expr(
		empty_env(),
		LetExpr(
			named_var("result"),
			False,
			result_type,
			var_expr(
				"source",
				result_type,
			),
			TupleExpr(
				[var_expr("result", result_type), var_expr("result", result_type)],
				TupleType([result_type, result_type]),
				SyntheticSourceLoc,
			),
		),
	)

	unused_uses_stack_release: Bool = match unused:
		LetExpr(variable, is_mutable, typ, DupExpr(source_var, source_type, StackResultRetainPolicy, retained, retained_type, retain_loc), DropExpr(drop_var, value_type, StackResultReleasePolicy, drop_body, drop_body_type, drop_loc)):
			source_var.name == "source" and drop_var.name == "result"
		_:
			False

	reused_uses_stack_retain: Bool = match reused:
		LetExpr(variable, is_mutable, typ, DupExpr(source_var, source_type, StackResultRetainPolicy, retained, retained_type, retain_loc), DupExpr(dup_var, value_type, StackResultRetainPolicy, inner, body_type, loc)):
			source_var.name == "source" and dup_var.name == "result"
		_:
			False

	unused_uses_stack_release and reused_uses_stack_retain


pure func test_constructor_contracts_transfer_payload_fields() -> Bool:
	env: PerceusEnv = build_env(decl_env_program())
	missing_def_id: Int = 404

	contract_is(
		lookup_constructor_call_contract(env, "Node", None, 2),
		[TransferArg, TransferArg],
		ReturnOwned,
	) and contract_is(
		contract_for_call(
			env,
			UserCall(
				"WrongNameButSameDefId",
				Some(42),
				[],
			),
			2,
			UnionType("Tree"),
		),
		[TransferArg, TransferArg],
		ReturnOwned,
	) and contract_is(
		lookup_constructor_call_contract(env, "Node", Some(missing_def_id), 2),
		[TransferArg, TransferArg],
		ReturnOwned,
	) and contract_is_none(lookup_constructor_call_contract(env, "Node", None, 3))


pure func test_constructor_contracts_are_scoped_by_return_type() -> Bool:
	env: PerceusEnv = build_env(decl_env_program())
	missing_def_id: Int = 404

	(
		contract_is_none(contract_for_call(env, UserCall("Node", None, []), 1, UnionType("Tree")))
		and contract_is(
			contract_for_call(
				env,
				UserCall("Node", None, []),
				1,
				boxed_string_type(),
			),
			[TransferArg],
			ReturnOwned,
		)
		and contract_is(
			contract_for_call(
				env,
				UserCall("WrongNameButSameDefId", Some(99), []),
				1,
				NamedType("BoxedString", []),
			),
			[TransferArg],
			ReturnOwned,
		)
		and contract_is(
			contract_for_call(
				env,
				UserCall("Node", Some(missing_def_id), []),
				2,
				UnionType("Tree"),
			),
			[TransferArg, TransferArg],
			ReturnOwned,
		)
	)


pure func test_consumed_user_call_contract_transfers_declared_args() -> Bool:
	env: PerceusEnv = empty_env()

	contract_is(
