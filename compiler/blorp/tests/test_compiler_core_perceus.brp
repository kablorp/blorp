pure func body_constructor_match_has_nested_literal_branch_drops(
	name: String,
	body: CoreExpr,
) -> Bool:
	match body:
		DupExpr(variable, value_type, policy, inner, typ, loc):
			if variable.name == name:
				False
			else:
				body_constructor_match_has_nested_literal_branch_drops(name, inner)
		_:
			match body:
				ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, match_type, loc):
					match cases:
						[match_case]:
							match match_case.body:
								ConstructorMatchBodyLiteral(match_expr):
									constructor_literal_match_has_branch_drops(name, match_expr)
								_:
									False
						_:
							False
				_:
					False


pure func constructor_length_branch_has_post_drop(
