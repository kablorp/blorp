pure func test_result_propagation_balances_reserved_consumed_parameter_owner() -> Bool:
	result_type: CoreType = StackResultType(int_type(), string_type())
	consume_or_error: CoreDecl = function_decl(
		"consume_or_error",
		813,
		[core_param("key", string_type()), core_param("succeeds", bool_type())],
		result_type,
		IfExpr(
			var_expr("succeeds", bool_type()),
			user_call_expr("Ok", Some(1207), [], [int_expr(1)], result_type),
			user_call_expr("Err", Some(1208), [], [var_expr("key", string_type())], result_type),
			result_type,
			SyntheticSourceLoc,
		),
	)
	ok_case: CoreConstructorMatchCase = {
		constructor = "Ok",
		accessor = RootAccessor,
		test = StackResultOkConstructorTest("blorp_StackResult"),
		bindings = [
			{
				variable = named_var("value"),
				typ = int_type(),
				accessor = StackResultOkPayloadAccessor(RootAccessor),
				mode = MatchBorrowBindingMode
			},
		],
		body = ConstructorMatchBodyExpr(
			IfExpr(
				var_expr("valid", bool_type()),
				user_call_expr("Ok", Some(1207), [], [var_expr("value", int_type())], result_type),
				user_call_expr(
					"Err",
					Some(1208),
					[],
					[var_expr("key", string_type())],
					result_type,
				),
				result_type,
				SyntheticSourceLoc,
			),
		)
	}
	err_case: CoreConstructorMatchCase = {
		constructor = "Err",
		accessor = RootAccessor,
		test = StackResultErrConstructorTest("blorp_StackResult"),
		bindings = [
			{
				variable = named_var("propagated_error"),
				typ = string_type(),
				accessor = StackResultErrPayloadAccessor(RootAccessor),
				mode = MatchBorrowBindingMode
			},
		],
		body = ConstructorMatchBodyExpr(
			call_expr(
				"blorp_result_err",
				[var_expr("propagated_error", string_type())],
				result_type,
			),
		)
	}
	decode_key: CoreDecl = function_decl(
		"decode_key",
		814,
		[core_param("key", string_type()), core_param("valid", bool_type())],
		result_type,
		LetExpr(
			named_var("fallible"),
			False,
			result_type,
			user_call_expr(
				"consume_or_error",
				Some(813),
				[],
				[var_expr("key", string_type()), bool_expr(True)],
				result_type,
			),
			ConstructorMatchExpr(
				var_expr(
					"fallible",
					result_type,
				),
				NoReleasePolicy,
				[ok_case, err_case],
				ConstructorMatchFallbackFail,
				result_type,
				SyntheticSourceLoc,
			),
		),
	)
	rewritten: CoreProgram = insert_drops_program({
		decls = [consume_or_error, decode_key],
		foreign_includes = [],
	})

	match function_body(rewritten, "decode_key"):
		Some(body):
			dup_count_for("key", body) == 1 and drop_count_for("key", body) == 2
		None:
			False


