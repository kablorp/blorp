			)],
		intrinsic_expr("list_alloc", [int_expr(0)], payload_type),
		payload_type,
	)
	body: CoreExpr = ResourceScopeExpr(
		{
			variable = named_var("reader"),
			typ = UnionType("Reader"),
			acquire = var_expr("reader_source", UnionType("Reader")),
			body = match_body,
			cleanup = VoidExpr(void_type(), SyntheticSourceLoc)
		},
		payload_type,
		SyntheticSourceLoc,
	)
	program: CoreProgram = insert_drops_program({
		decls = [function_decl("read_payload", 217, [], payload_type, body)],
		foreign_includes = [],
	})

	match function_body(program, "read_payload"):
		Some(rewritten):
			dup_count_for("payload", rewritten) == 1
		None:
			False


pure func test_resource_scope_binder_shadows_unresolved_borrowed_param() -> Bool:
	resource_type: CoreType = string_type()
	body: CoreExpr = ResourceScopeExpr(
		{
			variable = named_var("resource"),
			typ = resource_type,
			acquire = LiteralExpr(StringLiteral("open"), resource_type, SyntheticSourceLoc),
			body = var_expr("resource", resource_type),
			cleanup = VoidExpr(void_type(), SyntheticSourceLoc)
		},
		resource_type,
		SyntheticSourceLoc,
	)
	program: CoreProgram = insert_drops_program({
		decls = [
			function_decl(
				"read_resource",
				1439,
				[core_param("resource", resource_type)],
				resource_type,
				body,
			),
		],
		foreign_includes = [],
	})

	match function_body(program, "read_resource"):
		Some(ResourceScopeExpr(scope, typ, loc)):
			match scope.body:
				VarExpr(variable, body_type, body_loc):
					variable.name == "resource"
				_:
					False
		_:
			False


