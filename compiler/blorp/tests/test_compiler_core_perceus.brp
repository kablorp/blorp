pure func test_value_record_update_field_read_preserves_core_tree() -> Bool:
	pair_type: CoreType = ValueRecordType("Pair")
	initial: CoreExpr = RecordConstructExpr(
		"Pair",
		[
			{
				name = "a",
				value = int_expr(10)
			},
			{
				name = "b",
				value = int_expr(32)
			},
		],
		pair_type,
		SyntheticSourceLoc,
	)
	updated: CoreExpr = LetExpr(
		named_var("__upd_0"),
		False,
		pair_type,
		var_expr(
			"p",
			pair_type,
		),
		RecordConstructExpr(
			"Pair",
			[
				{
					name = "a",
					value = int_expr(40)
				},
				{
					name = "b",
					value = FieldExpr(
						var_expr("__upd_0", pair_type),
						"b",
						int_type(),
						SyntheticSourceLoc,
					)
				},
			],
			pair_type,
			SyntheticSourceLoc,
		),
	)
	body: CoreExpr = LetExpr(
		named_var("p"),
		False,
		pair_type,
		initial,
		LetExpr(
			named_var("q"),
			False,
			pair_type,
			updated,
			FieldExpr(
				var_expr("q", pair_type),
				"a",
				int_type(),
				SyntheticSourceLoc,
			),
		),
	)
	program: CoreProgram = insert_drops_program({
		decls = [function_decl("record_update", 224, [], int_type(), body)],
		foreign_includes = [],
	})

	match function_body(program, "record_update"):
		Some(LetExpr(p, p_mutable, p_type, p_rhs, p_body)):
			match p_body:
				LetExpr(q, q_mutable, q_type, q_rhs, q_body):
					count_uses("q", q_body) == 1
				_:
					False
		Some(_):
			False
		None:
			False


