pure func test_constructor_match_branch_use_prevents_pre_match_drop() -> Bool:
	body: CoreExpr = constructor_match_expr(
		[constructor_case(
				"Some",
				[],
				var_expr("s", string_type()),
			)],
		var_expr("s", string_type()),
		string_type(),
	)
	expr: CoreExpr = LetExpr(
		named_var("s"),
		False,
		string_type(),
		var_expr("source", string_type()),
		body,
	)
	rewritten: CoreExpr = insert_drops_expr(empty_env(), expr)

	top_let_body_is_constructor_match(rewritten) and drop_count_for("s", rewritten) == 0


pure func test_constructor_match_aliasing_scrutinee_drops_owner_after_match() -> Bool:
	body: CoreExpr = ConstructorMatchExpr(
		var_expr("tag", UnionType("Tag")),
		NoReleasePolicy,
		[constructor_case("Some", [], int_expr(1))],
		ConstructorMatchFallbackBody(int_expr(0)),
		int_type(),
		SyntheticSourceLoc,
	)
	expr: CoreExpr = LetExpr(
		named_var("tag"),
		False,
		UnionType("Tag"),
		var_expr("source", UnionType("Tag")),
		body,
	)
	env: PerceusEnv = { empty_env() | managed_type_names = ["Tag"] }
	rewritten: CoreExpr = insert_drops_expr(env, expr)

	(
		drop_count_for("tag", rewritten) == 1
		and dup_count_for("tag", rewritten) == 0
		and top_let_body_is_post_drop_after_constructor_match("tag", rewritten)
	)


