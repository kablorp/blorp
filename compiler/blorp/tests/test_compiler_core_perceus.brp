		var_expr("source", list_string_type()),
		body,
	)
	rewritten: CoreExpr = insert_drops_expr(empty_env(), expr)

	drop_count_for("xs", rewritten) == 0 and dup_count_for("xs", rewritten) == 0


pure func test_consume_then_borrow_gets_dup_and_post_drop() -> Bool:
	consume: CoreExpr = intrinsic_expr(
		"list_ensure_unique",
		[var_expr("xs", list_int_type())],
		list_int_type(),
	)
	borrow: CoreExpr = intrinsic_expr("list_len", [var_expr("xs", list_int_type())], int_type())
	body: CoreExpr = SeqExpr(consume, borrow)
	expr: CoreExpr = LetExpr(
		named_var("xs"),
		False,
		list_int_type(),
		var_expr("source", list_int_type()),
		body,
	)
	rewritten: CoreExpr = insert_drops_expr(empty_env(), expr)

	drop_count_for("xs", rewritten) == 1 and dup_count_for("xs", rewritten) == 1


