import:
	../core_fairness_policy:
		RenderError(UnsupportedFairnessOp, WrongArity),
		fairness_template_arity,
		fairness_template_name,
		parse_fairness_template,
		render_error_to_string,
		render_fairness,
		render_manifest_line,
		render_manifest_lines,
	test: TestSuite


func parsed_template_has(name: String, expected_name: String, expected_arity: Int) -> Bool:
	match parse_fairness_template(name):
		Some(info):
			(
				fairness_template_name(info) == expected_name
				and fairness_template_arity(info) == expected_arity
			)
		None:
			False


func rendered_policy_is(name: String, args: List[String], expected: String) -> Bool:
	match render_fairness(name, args):
		Ok(rendered):
			rendered == expected
		Err(error):
			False


func manifest_line_is(name: String, expected: String) -> Bool:
	match parse_fairness_template(name):
		Some(info):
			render_manifest_line(info) == expected
		None:
			False


func test_parse_template_shapes() -> Bool:
	checkpoint_ok: Bool = parsed_template_has(
		"fairness_body_checkpoint",
		"fairness_body_checkpoint",
		0,
	)
	seq_checkpoint_ok: Bool = parsed_template_has(
		"fairness_body_seq_checkpoint",
		"fairness_body_seq_checkpoint",
		0,
	)
	other_ok: Bool = parsed_template_has("fairness_body_other", "fairness_body_other", 0)

	checkpoint_ok and seq_checkpoint_ok and other_ok


func test_render_policy_values() -> Bool:
	checkpoint_ok: Bool = rendered_policy_is("fairness_body_checkpoint", [], "true")
	seq_checkpoint_ok: Bool = rendered_policy_is("fairness_body_seq_checkpoint", [], "true")
	other_ok: Bool = rendered_policy_is("fairness_body_other", [], "false")

	checkpoint_ok and seq_checkpoint_ok and other_ok


func test_render_errors_are_typed() -> Bool:
	wrong_arity_ok: Bool = match render_fairness("fairness_body_other", ["extra"]):
		Err(WrongArity(info, actual)):
			(
				fairness_template_name(info) == "fairness_body_other"
				and fairness_template_arity(info) == 0
				and actual == 1
			)
		Ok(value):
			False
		Err(UnsupportedFairnessOp(name)):
			False

	unsupported_ok: Bool = match render_fairness("fairness_missing", []):
		Err(UnsupportedFairnessOp(name)):
			name == "fairness_missing"
		Ok(value):
			False
		Err(WrongArity(info, actual)):
			False

	wrong_arity_ok and unsupported_ok


func test_manifest_lines() -> Bool:
	checkpoint_ok: Bool = manifest_line_is(
		"fairness_body_checkpoint",
		"fairness_body_checkpoint\t0\ttrue",
	)
	seq_checkpoint_ok: Bool = manifest_line_is(
		"fairness_body_seq_checkpoint",
		"fairness_body_seq_checkpoint\t0\ttrue",
	)
	other_ok: Bool = manifest_line_is("fairness_body_other", "fairness_body_other\t0\tfalse")
	count_ok: Bool = render_manifest_lines().length() == 3

	checkpoint_ok and seq_checkpoint_ok and other_ok and count_ok


func test_error_text() -> Bool:
	arity_text: String = match render_fairness("fairness_body_other", ["extra"]):
		Err(error):
			render_error_to_string(error)
		Ok(value):
			value

	unsupported_text: String = render_error_to_string(UnsupportedFairnessOp("fairness_missing"))

	(
		arity_text == "fairness op fairness_body_other expected 0 arg(s), got 1"
		and unsupported_text == "unsupported fairness op: fairness_missing"
	)


tests: TestSuite = {
	description = "Self-hosted Core fairness policy",
	tests = [
		("parse template shapes", test_parse_template_shapes),
		("render policy values", test_render_policy_values),
		("render errors are typed", test_render_errors_are_typed),
		("manifest lines", test_manifest_lines),
		("error text", test_error_text),
	]
}
