		is_pure = False,
		function_kind = UserFunction,
		def_id = 30,
		loc = SyntheticSourceLoc
	}

	{
		decls = [FunctionDecl(run_concurrent)],
		foreign_includes = []
	}


pure func resource_concurrent_loop_program() -> CoreProgram:
	source_param: CoreParam = local_param("source", resource_source_type())
	conn_var: CoreVar = local_var("conn")
	move_item: CoreConcurrentlyLoopMoveResourceItem = {
		resource_type = tcp_stream_type(),
		error_type = tcp_error_type()
	}
	run_loop: CoreFunction = {
		name = "run_loop",
		source_module = None,
		type_params = [],
		params = [source_param],
		return_type = VoidType,
		body = Some(
			PreClosureConcurrentlyLoopExpr(
				{
					variable = conn_var,
					item_type = tcp_stream_type(),
					item_mode = ConcurrentlyLoopMoveResourceItem(move_item),
					iterable = VarExpr(
						source_param.name,
						resource_source_type(),
						SyntheticSourceLoc,
					),
					body = CallExpr(
						UserCall("stream_local_port", Some(77), []),
						VarExpr(local_var("Tcp"), closure_type(), SyntheticSourceLoc),
						[VarExpr(conn_var, tcp_stream_type(), SyntheticSourceLoc)],
						VoidType,
						SyntheticSourceLoc,
					),
					timeout = None,
					limit = LiteralExpr(IntLiteral(1), int_type(), SyntheticSourceLoc),
					output = ConcurrentlyLoopDiscard
				},
				VoidType,
				SyntheticSourceLoc,
			),
		),
		is_pure = False,
		function_kind = UserFunction,
		def_id = 40,
		loc = SyntheticSourceLoc
	}

	{
		decls = [FunctionDecl(run_loop)],
		foreign_includes = []
	}


pure func deep_sequence_program() -> CoreProgram:
	captured: CoreParam = local_param("captured", int_type())
	var body: CoreExpr = VoidExpr(VoidType, SyntheticSourceLoc)
	var index: Int = 0

	while index < DEEP_SEQUENCE_LENGTH:
		item: CoreExpr = if index == 0:
			CallExpr(
				UserCall("consume", Some(49), [0]),
				VarExpr(local_var("consume"), closure_type(), SyntheticSourceLoc),
				[VarExpr(captured.name, int_type(), SyntheticSourceLoc)],
				VoidType,
				SyntheticSourceLoc,
			)
		else:
			LiteralExpr(IntLiteral(index), int_type(), SyntheticSourceLoc)

		body = SeqExpr(item, body)
		index += 1

	consume: CoreFunction = {
		name = "consume",
		source_module = None,
		type_params = [],
		params = [local_param("value", int_type())],
		return_type = VoidType,
		body = Some(VoidExpr(VoidType, SyntheticSourceLoc)),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 49,
		loc = SyntheticSourceLoc
	}

	function: CoreFunction = {
		name = "deep_sequence",
		source_module = None,
		type_params = [],
		params = [captured],
		return_type = VoidType,
		body = Some(PreClosureDetachExpr({body = body}, VoidType, SyntheticSourceLoc)),
		is_pure = False,
		function_kind = UserFunction,
		def_id = 50,
		loc = SyntheticSourceLoc
	}

	{
		decls = [FunctionDecl(consume), FunctionDecl(function)],
		foreign_includes = []
	}


pure func has_deep_sequence_shape(expr: CoreExpr) -> Bool:
	var current: CoreExpr = expr
	var remaining: Int = DEEP_SEQUENCE_LENGTH
	var valid: Bool = True

	while valid and remaining > 0:
		match current:
			SeqExpr(first, second):
				item_is_expected: Bool = if remaining == 1:
					match first:
						CallExpr(UserCall(name, def_id, consumed_args), callee, args, typ, loc):
							name == "consume" and def_id == Some(49) and consumed_args == [0]
						_:
							False
				else:
					match first:
						LiteralExpr(IntLiteral(value), typ, loc):
							value == remaining - 1
						_:
							False

				if item_is_expected:
					current = second
					remaining -= 1
				else:
					valid = False
			_:
				valid = False

	if valid and remaining == 0:
		match current:
			VoidExpr(typ, loc):
				True
			_:
				False
	else:
		False


pure func test_deep_sequence_conversion_is_stack_bounded() -> Bool:
	converted: CoreProgram = convert_program(deep_sequence_program())

	match converted.decls:
		[FunctionDecl(consume), FunctionDecl(function), FunctionDecl(task)]:
			match (function.body, task.body, task.function_kind):
				(Some(DetachExpr(detached, typ, loc)), Some(task_body), ClosureBodyFunction(abi)):
					(
						detached.task.function_name == task.name
						and detached.task.def_id == task.def_id
						and task.name == "_blorp_task_0"
						and task.def_id == 51
						and detached.task.captures.length() == 1
						and detached.task.captures
							.get(0)
							.map(func(capture): capture.name)
							.get_or("") == "captured"
						and abi.task_abi
						and has_deep_sequence_shape(task_body)
					)
				_:
					False
		_:
			False


pure func deep_control_flow_program() -> CoreProgram:
	var body: CoreExpr = VoidExpr(VoidType, SyntheticSourceLoc)
	var index: Int = 0
	subject: CoreVar = local_var("subject")
	subject_type: CoreType = EnumType("Flag")

	while index < DEEP_CONTROL_FLOW_LENGTH:
		value: CoreVar = local_var("value")
		logical: CoreExpr = LogicalExpr(
			AndOp,
			LiteralExpr(BoolLiteral(True), bool_type(), SyntheticSourceLoc),
			LiteralExpr(BoolLiteral(False), bool_type(), SyntheticSourceLoc),
			bool_type(),
			SyntheticSourceLoc,
		)
		body = ConstructorMatchExpr(
			VarExpr(
				subject,
				subject_type,
				SyntheticSourceLoc,
			),
			NoReleasePolicy,
			[
				{
					constructor = "Value",
					accessor = RootAccessor,
					test = EnumConstructorTest("Value"),
					bindings = [],
					body = ConstructorMatchBodyExpr(
						LetExpr(
							value,
							False,
							bool_type(),
							logical,
							body,
						),
					)
				},
			],
			ConstructorMatchFallbackFail,
			VoidType,
			SyntheticSourceLoc,
		)
		index += 1

	function: CoreFunction = {
		name = "deep_control_flow",
		source_module = None,
		type_params = [],
		params = [local_param("subject", subject_type)],
		return_type = VoidType,
		body = Some(body),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 52,
		loc = SyntheticSourceLoc
	}

	{
		decls = [FunctionDecl(function)],
		foreign_includes = []
	}


pure func has_deep_control_flow_shape(expr: CoreExpr) -> Bool:
	var current: CoreExpr = expr
	var remaining: Int = DEEP_CONTROL_FLOW_LENGTH
	var valid: Bool = True

	while valid and remaining > 0:
		match current:
			ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
				match cases:
					[match_case]:
						match match_case.body:
							ConstructorMatchBodyExpr(LetExpr(variable, is_mutable, var_type, rhs, body)):
								match rhs:
									LogicalExpr(AndOp, left, right, logical_type, logical_loc):
										current = body
										remaining -= 1
									_:
										valid = False
							_:
								valid = False
					_:
						valid = False
			_:
				valid = False

	if valid and remaining == 0:
		match current:
			VoidExpr(typ, loc):
				True
			_:
				False
	else:
		False


pure func test_deep_control_flow_conversion_is_stack_bounded() -> Bool:
	converted: CoreProgram = convert_program(deep_control_flow_program())

	match converted.decls:
		[FunctionDecl(function)]:
			function.body
				.map(has_deep_control_flow_shape)
				.get_or(False)
		_:
			False


pure func test_lambda_is_hoisted_to_closure_body() -> Bool:
	converted: CoreProgram = convert_program(lambda_program())

	match converted.decls:
		[FunctionDecl(make_lambda), FunctionDecl(hoisted)]:
			match make_lambda.body:
				Some(ClosureCreateExpr(closure, typ, loc)):
					match hoisted.function_kind:
						ClosureBodyFunction(abi):
							(
								closure.function_name == hoisted.name
								and closure.def_id == hoisted.def_id
								and closure.captures.length() == 1
								and closure.captures
									.get(0)
									.map(func(c): c.name)
									.get_or("") == "base"
								and abi.params.length() == 1
								and abi.params
									.get(0)
									.map(func(p): p.name.name)
									.get_or("") == "x"
								and abi.captures.length() == 1
								and abi.task_abi == False
							)
						UserFunction:
							False
						BuiltinFunction(c_name):
							False
						UnresolvedBuiltinFunction:
							False
						ForeignFunction(_):
							False
				Some(other):
					False
				None:
					False
		[]:
			False
		[first]:
			False
		[first, second]:
			False
		[first, second, third, ...rest]:
			False


pure func test_pre_closure_detach_gets_task_closure() -> Bool:
	converted: CoreProgram = convert_program(detach_program())

	match converted.decls:
		[FunctionDecl(run_detach), FunctionDecl(task_func)]:
			match run_detach.body:
				Some(DetachExpr(detached, typ, loc)):
					match task_func.function_kind:
						ClosureBodyFunction(abi):
							(
								detached.task.function_name == task_func.name
								and detached.task.def_id == task_func.def_id
								and is_void_type(detached.task.return_type)
								and abi.task_abi == True
							)
						UserFunction:
							False
						BuiltinFunction(c_name):
							False
						UnresolvedBuiltinFunction:
							False
						ForeignFunction(_):
							False
				Some(other):
					False
				None:
					False
		[]:
			False
		[first]:
			False
		[first, second]:
			False
		[first, second, third, ...rest]:
			False


pure func test_pre_closure_detach_balances_copy_captures() -> Bool:
	converted: CoreProgram = convert_program(copied_task_capture_transfer_program())

	match converted.decls:
		[FunctionDecl(run_detach), FunctionDecl(task_func)]:
			match task_func.function_kind:
				ClosureBodyFunction(abi):
					match task_func.body:
						Some(SeqExpr(CallExpr(UserCall(call_name, call_def_id, consumed_args), callee, call_args, call_type, call_loc), DropExpr(drop_var, drop_type, release_policy, VoidExpr(drop_body_type, drop_body_loc), drop_result_type, drop_loc))):
							(
								call_name == "consume_first"
								and consumed_args.length() == 1
								and consumed_args
									.get(0)
									.get_or(-1) == 0
								and call_args.length() == 2
								and is_void_type(call_type)
								and drop_var.name == "done"
								and is_channel_string_type(drop_type)
								and is_arc_release_policy(release_policy)
								and is_void_type(drop_body_type)
								and is_void_type(drop_result_type)
								and abi.moved_captures.length() == 2
							)
						Some(other):
							False
						None:
							False
				UserFunction:
					False
				BuiltinFunction(c_name):
					False
				UnresolvedBuiltinFunction:
					False
				ForeignFunction(_):
					False
		[]:
			False
		[first]:
			False
		[first, second]:
			False
		[first, second, third, ...rest]:
			False


pure func test_pre_closure_concurrent_task_returns_rhs_type() -> Bool:
	converted: CoreProgram = convert_program(concurrent_program())

	match converted.decls:
		[FunctionDecl(run_concurrent), FunctionDecl(task_func)]:
			match run_concurrent.body:
				Some(ConcurrentExpr(block, typ, loc)):
					match block.bindings:
						[produced_binding]:
							match task_func.function_kind:
								ClosureBodyFunction(abi):
									(
										produced_binding.task.function_name == task_func.name
										and is_int_stack_result_type(produced_binding.typ)
										and is_int_type(produced_binding.task.return_type)
										and is_int_type(task_func.return_type)
										and abi.task_abi == True
									)
								UserFunction:
									False
								BuiltinFunction(c_name):
									False
								UnresolvedBuiltinFunction:
									False
								ForeignFunction(_):
									False
						[]:
							False
						[first, second, ...rest]:
							False
				Some(other):
					False
				None:
					False
		[]:
			False
		[first]:
			False
		[first, second]:
			False
		[first, second, third, ...rest]:
			False


pure func test_pre_closure_resource_loop_captures_moved_item_not_callee_alias() -> Bool:
	converted: CoreProgram = convert_program(resource_concurrent_loop_program())

	match converted.decls:
		[FunctionDecl(run_loop), FunctionDecl(task_func)]:
			match run_loop.body:
				Some(ConcurrentlyLoopExpr(loop, typ, loc)):
					match loop.task.captures:
						[capture]:
							match task_func.function_kind:
								ClosureBodyFunction(abi):
									(
										capture.name == "conn"
										and abi.captures.length() == 1
										and abi.captures
											.get(0)
											.map(func(c): c.name)
											.get_or("") == "conn"
										and abi.moved_captures.length() == 1
										and abi.moved_captures
											.get(0)
											.get_or("") == "conn"
									)
								UserFunction:
									False
								BuiltinFunction(c_name):
									False
								UnresolvedBuiltinFunction:
									False
								ForeignFunction(_):
									False
						[]:
							False
						[first, second, ...rest]:
							False
				Some(other):
					False
				None:
					False
		[]:
			False
		[first]:
			False
		[first, second]:
			False
		[first, second, third, ...rest]:
			False


