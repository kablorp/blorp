import:
	../src/stage_09_core/compiler_core_closure: convert_program
	../src/stage_09_core/compiler_core_json:
		CoreAccessor(RootAccessor),
		CoreBinaryOp(AddOp),
		CoreCallKind(UserCall),
		CoreConcurrentlyLoopItemMode(ConcurrentlyLoopMoveResourceItem),
		CoreConcurrentlyLoopMoveResourceItem,
		CoreConcurrentlyLoopOutput(ConcurrentlyLoopDiscard),
		CoreConstructorMatchBody(ConstructorMatchBodyExpr),
		CoreConstructorMatchFallback(ConstructorMatchFallbackFail),
		CoreConstructorMatchTest(EnumConstructorTest),
		CoreDecl(FunctionDecl),
		CoreExpr(
			BinaryExpr,
			CallExpr,
			ClosureCreateExpr,
			ConcurrentExpr,
			ConcurrentlyLoopExpr,
			ConstructorMatchExpr,
			DetachExpr,
			DropExpr,
			LambdaExpr,
			LetExpr,
			LiteralExpr,
			LogicalExpr,
			PreClosureConcurrentExpr,
			PreClosureConcurrentlyLoopExpr,
			PreClosureDetachExpr,
			SeqExpr,
			VarExpr,
			VoidExpr,
		),
		CoreFunction,
		CoreFunctionKind(
			BuiltinFunction,
			ClosureBodyFunction,
			ForeignFunction,
			UnresolvedBuiltinFunction,
			UserFunction,
		),
		CoreLiteral(BoolLiteral, IntLiteral),
		CoreLogicalOp(AndOp),
		CoreParam,
		CoreProgram,
		CoreReleasePolicy(
			ArcReleaseOnlyPolicy,
			ArcReleasePolicy,
			NoReleasePolicy,
			StackResultReleasePolicy,
		),
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(
			BoxedResultType,
			EnumType,
			HeapRecordType,
			NamedType,
			RangeType,
			StackResultType,
			TensorType,
			TupleType,
			UnionType,
			ValueRecordType,
			VoidType,
		),
		CoreVar,
	test: TestSuite


DEEP_SEQUENCE_LENGTH: Int = 1024

DEEP_CONTROL_FLOW_LENGTH: Int = 48


pure func int_type() -> CoreType:
	NamedType("Int", [])


pure func bool_type() -> CoreType:
	NamedType("Bool", [])


pure func string_type() -> CoreType:
	NamedType("String", [])


pure func channel_string_type() -> CoreType:
	NamedType("Channel", [string_type()])


pure func closure_type() -> CoreType:
	NamedType("Closure", [])


pure func tcp_stream_type() -> CoreType:
	NamedType("TcpStream", [])


pure func tcp_error_type() -> CoreType:
	UnionType("TcpError")


pure func resource_source_type() -> CoreType:
	NamedType(
		"ResourceSource",
		[tcp_stream_type(), tcp_error_type()],
	)


pure func is_void_type(typ: CoreType) -> Bool:
	match typ:
		VoidType:
			True
		NamedType(name, args):
			False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		HeapRecordType(name):
			False
		UnionType(name):
			False
		RangeType:
			False
		TensorType(info):
			False
		TupleType(items):
			False


pure func is_int_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			name == "Int" and args.length() == 0
		VoidType:
			False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		HeapRecordType(name):
			False
		UnionType(name):
			False
		RangeType:
			False
		TensorType(info):
			False
		TupleType(items):
			False


pure func is_string_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			name == "String" and args.length() == 0
		VoidType:
			False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		HeapRecordType(name):
			False
		UnionType(name):
			False
		RangeType:
			False
		TensorType(info):
			False
		TupleType(items):
			False


pure func is_channel_string_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			(
				name == "Channel"
				and args.length() == 1
				and args
					.get(0)
					.map(is_string_type)
					.get_or(False)
			)
		VoidType:
			False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		HeapRecordType(name):
			False
		UnionType(name):
			False
		RangeType:
			False
		TensorType(info):
			False
		TupleType(items):
			False


pure func is_arc_release_policy(policy: CoreReleasePolicy) -> Bool:
	match policy:
		ArcReleasePolicy:
			True
		ArcReleaseOnlyPolicy:
			False
		StackResultReleasePolicy:
			False
		NoReleasePolicy:
			False


pure func is_int_stack_result_type(typ: CoreType) -> Bool:
	match typ:
		StackResultType(ok_type, err_type):
			is_int_type(ok_type) and is_int_type(err_type)
		NamedType(name, args):
			False
		VoidType:
			False
		BoxedResultType(ok_type, err_type):
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		HeapRecordType(name):
			False
		UnionType(name):
			False
		RangeType:
			False
		TensorType(info):
			False
		TupleType(items):
			False


pure func local_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


pure func local_param(name: String, typ: CoreType) -> CoreParam:
	{
		name = local_var(name),
		typ = typ,
		loc = SyntheticSourceLoc
	}


pure func lambda_program() -> CoreProgram:
	make_lambda: CoreFunction = {
		name = "make_lambda",
		source_module = None,
		type_params = [],
		params = [local_param("base", int_type())],
		return_type = closure_type(),
		body = Some(
			LambdaExpr(
				[local_param("x", int_type())],
				int_type(),
				BinaryExpr(
					AddOp,
					VarExpr(local_var("base"), int_type(), SyntheticSourceLoc),
					VarExpr(local_var("x"), int_type(), SyntheticSourceLoc),
					int_type(),
					SyntheticSourceLoc,
				),
				True,
				closure_type(),
				SyntheticSourceLoc,
			),
		),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 10,
		loc = SyntheticSourceLoc
	}

	{
		decls = [FunctionDecl(make_lambda)],
		foreign_includes = []
	}


pure func detach_program() -> CoreProgram:
	run_detach: CoreFunction = {
		name = "run_detach",
		source_module = None,
		type_params = [],
		params = [],
		return_type = VoidType,
		body = Some(
			PreClosureDetachExpr(
				{body = VoidExpr(VoidType, SyntheticSourceLoc)},
				VoidType,
				SyntheticSourceLoc,
			),
		),
		is_pure = False,
		function_kind = UserFunction,
		def_id = 20,
		loc = SyntheticSourceLoc
	}

	{
		decls = [FunctionDecl(run_detach)],
		foreign_includes = []
	}


pure func copied_task_capture_transfer_program() -> CoreProgram:
	ch_param: CoreParam = local_param("ch", channel_string_type())
	done_param: CoreParam = local_param("done", channel_string_type())
	run_detach: CoreFunction = {
		name = "run_detach_with_capture_transfer",
		source_module = None,
		type_params = [],
		params = [ch_param, done_param],
		return_type = VoidType,
		body = Some(
			PreClosureDetachExpr(
				{body = CallExpr(
						UserCall("consume_first", Some(77), [0]),
						VarExpr(local_var("consume_first"), closure_type(), SyntheticSourceLoc),
						[
							VarExpr(ch_param.name, channel_string_type(), SyntheticSourceLoc),
							VarExpr(done_param.name, channel_string_type(), SyntheticSourceLoc),
						],
						VoidType,
						SyntheticSourceLoc,
					)},
				VoidType,
				SyntheticSourceLoc,
			),
		),
		is_pure = False,
		function_kind = UserFunction,
		def_id = 25,
		loc = SyntheticSourceLoc
	}

	{
		decls = [FunctionDecl(run_detach)],
		foreign_includes = []
	}


pure func concurrent_program() -> CoreProgram:
	run_concurrent: CoreFunction = {
		name = "run_concurrent",
		source_module = None,
		type_params = [],
		params = [],
		return_type = int_type(),
