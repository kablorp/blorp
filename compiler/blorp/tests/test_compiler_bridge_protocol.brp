import:
	../compiler_bridge_protocol:
		BRIDGE_DOMAIN,
		BRIDGE_SCHEMA_VERSION,
		BridgeAction(
			CompileSourceAction,
			EmitPostClosureCAction,
			EmitCAction,
			LowerAndCompileAction,
			RendererTemplatesAction,
			RenderAction,
			RenderManyAction,
			RunCorePipelineAction,
			TypecheckAndCompileAction,
		),
		BridgeEnvelope,
		BridgeProtocolError(
			ExpectedField,
			InvalidJson,
			MissingField,
			UnsupportedAction,
			UnsupportedDomain,
			UnsupportedSchema,
		),
		bridge_action_name,
		bridge_error_json,
		bridge_protocol_error_code,
		bridge_protocol_error_message,
		bridge_success_json,
		decode_bridge_envelope_value,
		parse_bridge_action,
	json: JsonValue(JsonBool, JsonObject, JsonString), as_bool, as_string, get_field, parse_json
	test: TestSuite


func decode_bridge_envelope(source: String) -> Result[BridgeEnvelope, BridgeProtocolError]:
	match parse_json(source):
		Ok(value):
			decode_bridge_envelope_value(value)
		Err(message):
			Err(InvalidJson(message))


func action_round_trip(name: String, action: BridgeAction) -> Bool:
	match parse_bridge_action(name):
		Ok(parsed):
			parsed == action and bridge_action_name(parsed) == name
		Err(_):
			False


func test_action_names_are_stable() -> Bool:
	(
		action_round_trip("render", RenderAction)
		and action_round_trip("render_many", RenderManyAction)
			and action_round_trip("renderer_templates", RendererTemplatesAction)
			and action_round_trip("emit_c", EmitCAction)
			and action_round_trip("emit_post_closure_c", EmitPostClosureCAction)
			and action_round_trip("run_core_pipeline", RunCorePipelineAction)
		and action_round_trip("lower_and_compile", LowerAndCompileAction)
		and action_round_trip("typecheck_and_compile", TypecheckAndCompileAction)
		and action_round_trip("compile_source", CompileSourceAction)
	)


func test_decode_current_compile_source_envelope() -> Bool:
	source: String = "{\"schema\":1,\"domain\":\"compiler\",\"action\":\"compile_source\"," + "\"payload\":{\"filename\":\"main.brp\",\"source\":\"func main(args: List[String]):\\n\\t0\"}}"

	match decode_bridge_envelope(source):
		Ok(envelope):
			match get_field(envelope.payload, "filename"):
				Some(filename_value):
					match as_string(filename_value):
						Some(filename):
							match get_field(envelope.payload, "source"):
								Some(source_value):
									match as_string(source_value):
										Some(source_text):
											(
												envelope.schema == BRIDGE_SCHEMA_VERSION
												and envelope.domain == BRIDGE_DOMAIN
												and envelope.action == CompileSourceAction
												and envelope.action_name == "compile_source"
												and filename == "main.brp"
												and source_text.contains("func main")
											)
										None:
											False
								None:
									False
						None:
							False
				None:
					False
		Err(InvalidJson(message)):
			False
		Err(MissingField(field_name)):
			False
		Err(ExpectedField(field_name, expected)):
			False
		Err(UnsupportedSchema(schema)):
			False
		Err(UnsupportedDomain(domain)):
			False
		Err(UnsupportedAction(action)):
			False


func test_decode_future_payload_envelope() -> Bool:
	source: String = "{\"schema\":1,\"domain\":\"compiler\",\"action\":\"emit_c\"," + "\"payload\":{\"core\":\"final-core-json\"}}"

	match decode_bridge_envelope(source):
		Ok(envelope):
			match get_field(envelope.payload, "core"):
				Some(value):
					match as_string(value):
						Some(core):
							envelope.action == EmitCAction and core == "final-core-json"
						None:
							False
				None:
					False
		Err(_):
			False


func test_decode_errors_are_typed() -> Bool:
	missing_schema_ok: Bool = match decode_bridge_envelope(
		"{\"domain\":\"compiler\",\"action\":\"compile_source\"}",
	):
		Err(MissingField(field_name)):
			field_name == "schema"
		_:
			False

	wrong_schema_ok: Bool = match decode_bridge_envelope(
		"{\"schema\":2,\"domain\":\"compiler\",\"action\":\"compile_source\"}",
	):
		Err(UnsupportedSchema(schema)):
			schema == 2
		_:
			False

	wrong_domain_ok: Bool = match decode_bridge_envelope(
		"{\"schema\":1,\"domain\":\"fmt\",\"action\":\"compile_source\"}",
	):
		Err(UnsupportedDomain(domain)):
			domain == "fmt"
		_:
			False

	wrong_action_ok: Bool = match decode_bridge_envelope(
		"{\"schema\":1,\"domain\":\"compiler\",\"action\":\"missing\"}",
	):
		Err(UnsupportedAction(action)):
			action == "missing"
		_:
			False

	missing_payload_ok: Bool = match decode_bridge_envelope(
		"{\"schema\":1,\"domain\":\"compiler\",\"action\":\"compile_source\"}",
	):
		Err(MissingField(field_name)):
			field_name == "payload"
		_:
			False

	wrong_payload_type_ok: Bool = match decode_bridge_envelope(
		"{\"schema\":1,\"domain\":\"compiler\",\"action\":\"compile_source\",\"payload\":true}",
	):
		Err(ExpectedField(field_name, expected)):
			field_name == "payload" and expected == "an object"
		_:
			False

	invalid_json_ok: Bool = match decode_bridge_envelope("{not json"):
		Err(InvalidJson(message)):
			message.length() > 0
		_:
			False

	wrong_type_ok: Bool = match decode_bridge_envelope(
		"{\"schema\":\"1\",\"domain\":\"compiler\",\"action\":\"compile_source\"}",
	):
		Err(ExpectedField(field_name, expected)):
			field_name == "schema" and expected == "a number"
		_:
			False

	all_ok: Bool = (
		missing_schema_ok
		and wrong_schema_ok
		and wrong_domain_ok
		and wrong_action_ok
		and missing_payload_ok
		and wrong_payload_type_ok
		and invalid_json_ok
		and wrong_type_ok
	)

	all_ok


func test_error_code_and_message() -> Bool:
	action_error: BridgeProtocolError = UnsupportedAction("missing")
	schema_error: BridgeProtocolError = UnsupportedSchema(9)
	field_error: BridgeProtocolError = ExpectedField("schema", "a number")

	(
		bridge_protocol_error_code(action_error) == "unsupported_action"
		and bridge_protocol_error_message(
			action_error,
		) == "unsupported Blorp bridge action: missing"
		and bridge_protocol_error_code(schema_error) == "unsupported_schema"
		and bridge_protocol_error_message(schema_error) == "unsupported Blorp bridge schema: 9"
		and bridge_protocol_error_code(field_error) == "invalid_request"
		and bridge_protocol_error_message(field_error) == "bridge field `schema` must be a number"
	)


func test_response_json_shapes() -> Bool:
	success = bridge_success_json(JsonObject([("c_code", JsonString("int main(void){}"))]))
	error = bridge_error_json(UnsupportedAction("missing"))

	success_ok: Bool = match get_field(success, "ok"):
		Some(value):
			match as_bool(value):
				Some(ok):
					ok
				None:
					False
		None:
			False

	error_ok: Bool = match get_field(error, "error"):
		Some(error_value):
			match get_field(error_value, "code"):
				Some(code_value):
					match as_string(code_value):
						Some(code):
							code == "unsupported_action"
						None:
							False
				None:
					False
		None:
			False

	responses_ok: Bool = success_ok and error_ok

	responses_ok


tests: TestSuite = {
	description = "Blorp compiler bridge protocol",
	tests = [
		("action names are stable", test_action_names_are_stable),
		("decode current compile_source envelope", test_decode_current_compile_source_envelope),
		("decode future payload envelope", test_decode_future_payload_envelope),
		("decode errors are typed", test_decode_errors_are_typed),
		("error code and message", test_error_code_and_message),
		("response JSON shapes", test_response_json_shapes),
	]
}
