private record TypeHeaderFixture {
	bound: CompilerBoundModuleGraph,
	skeletons: CompilerDeclarationSkeletonGraph,
	graph: CompilerTypeHeaderGraph
}


private pure func finalized_program(source: String) -> FinalizedTypecheckProgram:
	ParserBridge.parsed_typecheck_source_bridge_artifact(
		"types.brp",
		"std/types",
		source,
		False,
	).program


private pure func module_load_candidate(source: String) -> CompilerModuleLoadCandidate:
	module_load_candidate_at("std/types", source)


private pure func module_load_candidate_at(
	module_path: String,
	source: String,
) -> CompilerModuleLoadCandidate:
	compiler_module_load_candidate(
		compiler_resolved_module_identity_from_resolver(module_path, CompilerStdlibModule),
		ParserBridge.parsed_typecheck_source_bridge_artifact(
			module_path + ".brp",
			module_path,
			source,
			False,
		).program,
	)


private pure func accept_empty_view(
	scope: CompilerPreparedModuleScope,
) -> CompilerBoundModuleViewBinding:
	CompilerBoundModuleViewReady(
		COMPILER_MODULE_VIEW_EMPTY,
		prepared_module_program(compiler_prepared_module_scope_module(scope)),
		COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
		[],
	)


private pure func type_parameter_graph(
	source: String,
) -> Option[(CompilerBoundModuleGraph, CompilerDeclarationSkeletonGraph, CompilerResolvedTypeParameterGraph)]:
	indexed ?= compiler_indexed_graph_build(module_load_candidate(source), []).to_option()
	bound ?= compiler_bound_module_graph_build(indexed, [], accept_empty_view).to_option()
	skeletons ?= compiler_declaration_skeleton_graph_build(bound).to_option()
	aliases ?= compiler_type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= compiler_resolved_type_parameter_graph_build(aliases).to_option()
	Some((bound, skeletons, parameters))


private pure func type_header_fixture_at(
	module_path: String,
	source: String,
) -> Option[TypeHeaderFixture]:
	indexed ?= compiler_indexed_graph_build(
		module_load_candidate_at(module_path, source),
		[],
	).to_option()
	bound ?= compiler_bound_module_graph_build(indexed, [], accept_empty_view).to_option()
	skeletons ?= compiler_declaration_skeleton_graph_build(bound).to_option()
	aliases ?= compiler_type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= compiler_resolved_type_parameter_graph_build(aliases).to_option()
	graph ?= compiler_type_header_graph_build(parameters).to_option()
	Some({
		bound = bound,
		skeletons = skeletons,
		graph = graph,
	})


private pure func type_header_fixture(source: String) -> Option[TypeHeaderFixture]:
	type_header_fixture_at("std/types", source)


private pure func accept_dependency_alias_view(
	scope: CompilerPreparedModuleScope,
) -> CompilerBoundModuleViewBinding:
	path = compiler_prepared_module_scope_canonical_path(scope)
	program = prepared_module_program(compiler_prepared_module_scope_module(scope))

	if path == "std/types":
		match compiler_module_view_register_module_alias(
			COMPILER_MODULE_VIEW_EMPTY,
			"Dep",
			"pkg/dep",
		):
			CompilerModuleAliasAdded(view):
				CompilerBoundModuleViewReady(
					view,
					program,
					COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
					[],
				)
			_:
				CompilerBoundModuleViewReady(
					COMPILER_MODULE_VIEW_EMPTY,
					program,
					COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
					[],
				)
	else:
		CompilerBoundModuleViewReady(
			COMPILER_MODULE_VIEW_EMPTY,
			program,
			COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
			[],
		)


private pure func cross_module_type_parameter_graph_with_target(
	target_source: String,
	dependency_source: String,
) -> Option[(CompilerBoundModuleGraph, CompilerDeclarationSkeletonGraph, CompilerResolvedTypeParameterGraph)]:
	target = module_load_candidate(target_source)
	dependency = module_load_candidate_at("pkg/dep", dependency_source)
	indexed ?= compiler_indexed_graph_build(target, [dependency]).to_option()
	bound ?= compiler_bound_module_graph_build(
		indexed,
		["pkg/dep"],
		accept_dependency_alias_view,
	).to_option()
	skeletons ?= compiler_declaration_skeleton_graph_build(bound).to_option()
	aliases ?= compiler_type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= compiler_resolved_type_parameter_graph_build(aliases).to_option()
	Some((bound, skeletons, parameters))


private pure func cross_module_type_parameter_graph(
	dependency_source: String,
) -> Option[(CompilerBoundModuleGraph, CompilerDeclarationSkeletonGraph, CompilerResolvedTypeParameterGraph)]:
	cross_module_type_parameter_graph_with_target(
		"record UsesRemote {value: Dep.Remote}",
		dependency_source,
	)


private pure func accept_dependency_selective_view(
	scope: CompilerPreparedModuleScope,
) -> CompilerBoundModuleViewBinding:
	path = compiler_prepared_module_scope_canonical_path(scope)
	program = prepared_module_program(compiler_prepared_module_scope_module(scope))

	if path == "std/types":
		match compiler_module_view_register_selective_name(
			COMPILER_MODULE_VIEW_EMPTY,
			"IOError",
			"fs",
			"IOError",
		):
			CompilerSelectiveNameAdded(view):
				CompilerBoundModuleViewReady(
					view,
					program,
					COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
					[],
				)
			_:
				CompilerBoundModuleViewReady(
					COMPILER_MODULE_VIEW_EMPTY,
					program,
					COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
					[],
				)
	else:
		CompilerBoundModuleViewReady(
			COMPILER_MODULE_VIEW_EMPTY,
			program,
			COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
			[],
		)


private pure func selective_cross_module_type_parameter_graph(

) -> Option[(CompilerBoundModuleGraph, CompilerResolvedTypeParameterGraph)]:
	target_source: String =
		|union UsesImportedError:
		| Item(IOError)
	target = module_load_candidate(target_source)
	dependency_source: String =
		|union IOError:
		| NotFound(String)
	dependency = module_load_candidate_at("fs", dependency_source)
	indexed ?= compiler_indexed_graph_build(target, [dependency]).to_option()
	bound ?= compiler_bound_module_graph_build(
		indexed,
		["fs"],
		accept_dependency_selective_view,
	).to_option()
	skeletons ?= compiler_declaration_skeleton_graph_build(bound).to_option()
	aliases ?= compiler_type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= compiler_resolved_type_parameter_graph_build(aliases).to_option()
	Some((bound, parameters))


private pure func fixture_type_id(
	fixture: TypeHeaderFixture,
	name: String,
) -> Option[CompilerTypeId]:
	compiler_declaration_skeleton_graph_find_type(
		fixture.skeletons,
		compiler_bound_module_identity(compiler_bound_module_graph_target(fixture.bound)),
		name,
	).map(
		func(info): info.id,
	)


private pure func source() -> String:
	|record Node[T] {value: T, next: Option[Node[T]]}
	|
	|union Choice:
	|	Item(Node[Int])
	|	Empty
	|
	|type alias Alias = Node[String]
	|opaque type Secret = String
	|resource type Handle = builtin("close_handle")
	|record Owned {handle: Option[Handle]}


private pure func type_header_kind_name(header: CompilerTypeHeader) -> String:
	match compiler_type_header_shape(header):
		CompilerRecordTypeHeader(_, _):
			"record"
		CompilerUnionTypeHeader(_, _):
			"union"
		CompilerBuiltinTypeHeader(_):
			"builtin"
		CompilerAliasTypeHeader(_, _):
			"alias"


private pure func recursive_node_shape_matches(
	node_id: CompilerTypeId,
	header: CompilerTypeHeader,
) -> Bool:
	match compiler_type_header_shape(header):
		CompilerRecordTypeHeader(CompilerHeapRecord, fields):
			match (fields.get(0), fields.get(1)):
				(Some(value), Some(next)):
					match (value.typ, next.typ):
						(CompilerTypeParameterShape(parameter_id), CompilerIntrinsicTypeShape(CompilerIntrinsicOption, [option_arg])):
							match option_arg:
								CompilerDeclaredTypeShape(resolved_node_id, [node_arg]):
									match node_arg:
										CompilerTypeParameterShape(node_parameter_id):
											(
												compiler_type_parameter_id_name(parameter_id) == "T"
												and compiler_type_ids_equal(
													resolved_node_id,
													node_id,
												)
												and compiler_type_parameter_ids_equal(
													parameter_id,
													node_parameter_id,
												)
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		_:
			False


func test_type_header_graph_rejects_unknown_shapes_atomically() -> Bool:
	match type_parameter_graph("record Broken {value: MissingType}"):
		None:
			False
		Some((_, _, parameters)):
			match compiler_type_header_graph_build(parameters):
				Ok(_):
					False
				Err([CompilerTypeHeaderUnknownType(_, "MissingType")]):
					True
				Err(_):
					False


func test_type_header_graph_rejects_enum_payload_before_installation() -> Bool:
	source: String =
		|enum Bad:
		| Value(Int)

	match type_parameter_graph(source):
		None:
			False
		Some((_, _, parameters)):
			match compiler_type_header_graph_build(parameters):
				Err([CompilerTypeHeaderInvalidEnumVariantFields(_, "Value")]):
					True
				_:
					False


func test_type_header_graph_accepts_implicit_prelude_type_without_loaded_std() -> Bool:
	match type_header_fixture("record HasItems {items: List[Int]}"):
		Some(fixture):
			match fixture_type_id(fixture, "HasItems"):
				None:
					False
				Some(type_id):
					match compiler_type_header_graph_find(fixture.graph, type_id):
						Some(header):
							match compiler_type_header_shape(header):
								CompilerRecordTypeHeader(_, [field]):
									match field.typ:
										CompilerPreludeTypeShape(CompilerPreludeList, [CompilerIntrinsicTypeShape(CompilerIntrinsicInt, [])]):
											True
										_:
											False
								_:
									False
						None:
							False
		None:
			False


func test_type_header_graph_preserves_local_prelude_name_shadow() -> Bool:
	source: String =
		|record List {value: Int}
		|record UsesLocal {items: List}

	match type_header_fixture(source):
		None:
			False
		Some(fixture):
			match (fixture_type_id(fixture, "List"), fixture_type_id(fixture, "UsesLocal")):
				(Some(list_id), Some(uses_id)):
					match compiler_type_header_graph_find(fixture.graph, uses_id):
						Some(header):
							match compiler_type_header_shape(header):
								CompilerRecordTypeHeader(_, [field]):
									match field.typ:
										CompilerDeclaredTypeShape(resolved_id, []):
											compiler_type_ids_equal(resolved_id, list_id)
										_:
											False
								_:
									False
						None:
							False
				_:
					False


func test_type_header_graph_preserves_implicit_prelude_resource_capability() -> Bool:
	match type_header_fixture("record Reads {reader: FileReader}"):
		None:
			False
		Some(fixture):
			match fixture_type_id(fixture, "Reads"):
				Some(type_id):
					compiler_type_header_graph_find(fixture.graph, type_id)
						.map(compiler_type_header_contains_resource)
						.get_or(False)
				None:
					False


func test_type_header_graph_resolves_qualified_reference_to_exact_dependency_id() -> Bool:
	match cross_module_type_parameter_graph("record Remote {value: Int}"):
		None:
			False
		Some((bound, skeletons, parameters)):
			match compiler_type_header_graph_build(parameters):
				Err(_):
					False
				Ok(graph):
					match compiler_bound_module_graph_find_canonical_path(bound, "pkg/dep"):
						None:
							False
						Some(dependency):
							match (
								compiler_declaration_skeleton_graph_find_type(
									skeletons,
									compiler_bound_module_identity(dependency),
									"Remote",
								),
								compiler_declaration_skeleton_graph_find_type(
									skeletons,
									compiler_bound_module_identity(
										compiler_bound_module_graph_target(bound),
									),
									"UsesRemote",
								),
							):
								(Some(remote), Some(uses_remote)):
									match compiler_type_header_graph_find(graph, uses_remote.id):
										Some(header):
											match compiler_type_header_shape(header):
												CompilerRecordTypeHeader(_, [field]):
													match field.typ:
														CompilerDeclaredTypeShape(resolved_id, []):
															compiler_type_ids_equal(
																resolved_id,
																remote.id,
															)
														_:
															False
												_:
													False
										None:
											False
								_:
									False


func test_type_header_graph_rejects_private_qualified_reference() -> Bool:
	match cross_module_type_parameter_graph("private record Remote {value: Int}"):
		None:
			False
		Some((_, _, parameters)):
			match compiler_type_header_graph_build(parameters):
				Err([CompilerTypeHeaderPrivateTypeReference(_, _)]):
					True
				_:
					False


func test_type_header_graph_preserves_deterministic_category_order() -> Bool:
	match type_header_fixture(source()):
		None:
			False
		Some(fixture):
			compiler_type_header_graph_headers(
				fixture.graph,
			).map(
				type_header_kind_name,
			) == ["record", "union", "alias", "alias", "builtin", "record"]


func test_type_header_graph_resolves_recursive_generic_shapes() -> Bool:
	match type_header_fixture(source()):
		None:
			False
		Some(fixture):
			match fixture_type_id(fixture, "Node"):
				None:
					False
				Some(node_id):
					compiler_type_header_graph_find(fixture.graph, node_id)
						.map(func(header): recursive_node_shape_matches(node_id, header))
						.get_or(False)


private pure func alias_and_constructor_shapes_match(
	choice_id: CompilerTypeId,
	choice: CompilerTypeHeader,
	alias_header: CompilerTypeHeader,
	secret: CompilerTypeHeader,
) -> Bool:
	match (
		compiler_type_header_shape(choice),
		compiler_type_header_shape(alias_header),
		compiler_type_header_shape(secret),
	):
		(CompilerUnionTypeHeader(CompilerTaggedUnion, variants), CompilerAliasTypeHeader(CompilerTransparentAlias, _), CompilerAliasTypeHeader(CompilerOpaqueAlias, _)):
			variants.all(func(variant):
				compiler_type_ids_equal(variant.parent_type_id, choice_id)
			)
		_:
			False


func test_type_header_graph_preserves_alias_opacity_and_constructor_parent() -> Bool:
	match type_header_fixture(source()):
		None:
			False
		Some(fixture):
			match (
				fixture_type_id(fixture, "Choice"),
				fixture_type_id(fixture, "Alias"),
				fixture_type_id(fixture, "Secret"),
			):
				(Some(choice_id), Some(alias_id), Some(secret_id)):
					match (
						compiler_type_header_graph_find(fixture.graph, choice_id),
						compiler_type_header_graph_find(fixture.graph, alias_id),
						compiler_type_header_graph_find(fixture.graph, secret_id),
					):
						(Some(choice), Some(alias_header), Some(secret)):
							alias_and_constructor_shapes_match(
								choice_id,
								choice,
								alias_header,
								secret,
							)
						_:
							False
				_:
					False


func test_type_header_graph_computes_transitive_resource_containment() -> Bool:
	match type_header_fixture(source()):
		None:
			False
		Some(fixture):
			match (fixture_type_id(fixture, "Handle"), fixture_type_id(fixture, "Owned")):
				(Some(handle_id), Some(owned_id)):
					match (
						compiler_type_header_graph_find(fixture.graph, handle_id),
						compiler_type_header_graph_find(fixture.graph, owned_id),
					):
						(Some(handle), Some(owned)):
							(
								compiler_type_header_contains_resource(handle)
								and compiler_type_header_contains_resource(owned)
							)
						_:
							False
				_:
					False


func test_resource_containment_uses_exact_identity_with_same_name() -> Bool:
	target_source: String =
		|record Remote {value: Int}
		|record UsesDependency {value: Dep.Remote}
	dependency_source: String =
		|resource type Handle = builtin("close_handle")
		|record Remote {value: Handle}

	match cross_module_type_parameter_graph_with_target(target_source, dependency_source):
		None:
			False
		Some((bound, skeletons, parameters)):
			match compiler_type_header_graph_build(parameters):
				Err(_):
					False
				Ok(graph):
					match compiler_bound_module_graph_find_canonical_path(bound, "pkg/dep"):
						None:
							False
						Some(dependency):
							target_identity = compiler_bound_module_identity(
								compiler_bound_module_graph_target(bound),
							)
							dependency_identity = compiler_bound_module_identity(dependency)

							match (
								compiler_declaration_skeleton_graph_find_type(
									skeletons,
									target_identity,
									"Remote",
								),
								compiler_declaration_skeleton_graph_find_type(
									skeletons,
									target_identity,
									"UsesDependency",
								),
								compiler_declaration_skeleton_graph_find_type(
									skeletons,
									dependency_identity,
									"Remote",
								),
							):
								(Some(local), Some(uses_dependency), Some(remote_dependency)):
									(
										not compiler_type_header_graph_find(graph, local.id)
											.map(compiler_type_header_contains_resource)
											.get_or(False)
										and compiler_type_header_graph_find(
											graph,
											remote_dependency.id,
										)
											.map(compiler_type_header_contains_resource)
											.get_or(False)
										and compiler_type_header_graph_find(
											graph,
											uses_dependency.id,
										)
											.map(compiler_type_header_contains_resource)
											.get_or(False)
									)
								_:
									False


func test_type_header_graph_projects_builtin_visibility_by_module() -> Bool:
	source: String =
		|type Scalar = builtin
		|private resource type HiddenHandle = builtin("close_hidden")

	match type_header_fixture(source):
		None:
			False
		Some(fixture):
			identity = compiler_bound_module_identity(
				compiler_bound_module_graph_target(fixture.bound),
			)
			local_names: List[String] = compiler_type_header_graph_local_builtin_headers(
				fixture.graph,
				identity,
			).map(
				func(header): compiler_type_id_name(compiler_builtin_type_header_id(header)),
			)
			public_names: List[String] = compiler_type_header_graph_public_builtin_headers(
				fixture.graph,
				identity,
			).map(
				func(header): compiler_type_id_name(compiler_builtin_type_header_id(header)),
			)

			local_names == ["Scalar", "HiddenHandle"] and public_names == ["Scalar"]


func test_builtin_header_installation_preserves_resource_policy_and_visibility() -> Bool:
	source: String =
		|type Scalar = builtin
		|private resource type HiddenHandle = builtin("close_hidden")

	match type_header_fixture(source):
		None:
			False
		Some(fixture):
			identity = compiler_bound_module_identity(
				compiler_bound_module_graph_target(fixture.bound),
			)
			local = typecheck_install_local_builtin_headers(
				compiler_typecheck_state_for_origin(TYPECHECK_STDLIB_ORIGIN),
				fixture.graph,
				identity,
				"std/types",
			)
			imported = typecheck_install_imported_builtin_headers(
				compiler_typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
				fixture.graph,
				identity,
				"std/types",
			)
			canonical_scalar = canonical_module_type_name("std/types", "Scalar")
			canonical_hidden = canonical_module_type_name("std/types", "HiddenHandle")

			(
				local.errors.length() == 0
				and env_get_type_kind(local.env, "Scalar") == Some(TypeBuiltin)
				and env_get_type_kind(local.env, "HiddenHandle") == Some(TypeResource)
				and find_resource_cleanup(local.context, "HiddenHandle") == Some("close_hidden")
				and env_get_type_kind(imported.env, canonical_scalar) == Some(TypeBuiltin)
				and env_get_type_kind(imported.env, canonical_hidden).is_none()
			)


