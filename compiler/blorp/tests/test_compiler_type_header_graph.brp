												and actual_name == canonical_error
											)
										_:
											False
								None:
									False


func test_local_union_header_installation_preserves_shape_and_constructor_identity() -> Bool:
	source: String =
		|type alias Names[T] = List[T]
		|resource type Handle = builtin
		|union Tree[T]:
		| Leaf(T)
		| Branch(Tree[T], Tree[T])
		| NamesReady(Names[String])
		| Owns(Handle)
		|enum Color:
		| Red
		| Blue

	match type_header_fixture(source):
		None:
			False
		Some(fixture):
			identity = compiler_bound_module_identity(
				compiler_bound_module_graph_target(fixture.bound),
			)
			with_builtins = typecheck_install_local_builtin_headers(
				compiler_typecheck_state_for_origin(TYPECHECK_STDLIB_ORIGIN),
				fixture.graph,
				identity,
				"std/types",
			)
			state = typecheck_install_local_union_headers(
				with_builtins,
				fixture.graph,
				identity,
				"std/types",
			)
			tree_header = compiler_type_header_graph_local_union_headers(
				fixture.graph,
				identity,
			).get(0)

			match (
				env_get_type_decl(state.env, "Tree"),
				env_get_type_decl(state.env, "Color"),
				env_get_constructor_for_parent(state.env, "Tree", "Branch"),
				tree_header,
			):
				(Some((parameters, variants)), Some((_, colors)), Some(branch), Some(header)):
					match (variants.get(2), compiler_union_type_header_variants(header).get(1)):
						(Some(names_ready), Some(branch_header)):
							(
								state.errors.length() == 0
								and parameters == ["T"]
								and env_get_type_kind(state.env, "Tree") == Some(TypeUnion)
								and env_get_type_kind(state.env, "Color") == Some(TypeEnum)
								and variants.length() == 4
								and colors.length() == 2
								and branch.tag == 1
								and branch.constructor_id == compiler_constructor_id_definition_id(
									branch_header.id,
								)
								and names_ready.fields.length() == 1
								and types_equal(
									names_ready.fields
										.get(0)
										.get_or(SemanticNamedType("Void", [])),
									SemanticNamedType(
										"List",
										[SemanticNamedType("String", [])],
									),
								)
								and env_get_type_contains_resource(state.env, "Tree")
							)
						_:
							False
				_:
					False


func test_imported_enum_header_uses_canonical_parent_and_exact_constructor_id() -> Bool:
	source: String =
		|enum DirectoryEntryKind:
		| EntryFile
		| EntryDirectory

	match type_header_fixture_at("fs", source):
		None:
			False
		Some(fixture):
			module = compiler_bound_module_graph_target(fixture.bound)
			identity = compiler_bound_module_identity(module)
			module_path = compiler_prepared_module_scope_canonical_path(
				compiler_bound_module_scope(module),
			)
			state = typecheck_install_imported_union_headers(
				compiler_typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
				fixture.graph,
				identity,
				module_path,
			)
			canonical_kind = canonical_module_type_name(module_path, "DirectoryEntryKind")
			header = compiler_type_header_graph_public_union_headers(fixture.graph, identity).get(0)

			match (env_get_constructor(state.env, "EntryDirectory"), header):
				(Some(constructor), Some(union_header)):
					match compiler_union_type_header_variants(union_header).get(1):
						Some(variant):
							(
								state.errors.length() == 0
								and constructor.parent_type == canonical_kind
								and constructor.constructor_id == compiler_constructor_id_definition_id(
									variant.id,
								)
							)
						None:
							False
				_:
					False


tests: TestSuite = {
	description = "Compiler type header graph",
	tests = [
		(
			"preserves deterministic category order",
			test_type_header_graph_preserves_deterministic_category_order,
		),
		(
			"resolves recursive generic shapes",
			test_type_header_graph_resolves_recursive_generic_shapes,
		),
		(
			"preserves alias opacity and constructor parent",
			test_type_header_graph_preserves_alias_opacity_and_constructor_parent,
		),
		(
			"computes transitive resource containment",
			test_type_header_graph_computes_transitive_resource_containment,
		),
		(
			"resource containment uses exact identity with same name",
			test_resource_containment_uses_exact_identity_with_same_name,
		),
		(
			"rejects unknown shapes atomically",
			test_type_header_graph_rejects_unknown_shapes_atomically,
		),
		(
			"rejects enum payload before installation",
			test_type_header_graph_rejects_enum_payload_before_installation,
		),
		(
			"accepts implicit prelude type without loaded std",
			test_type_header_graph_accepts_implicit_prelude_type_without_loaded_std,
		),
		(
			"preserves local prelude name shadow",
			test_type_header_graph_preserves_local_prelude_name_shadow,
		),
		(
			"preserves implicit prelude resource capability",
			test_type_header_graph_preserves_implicit_prelude_resource_capability,
		),
		(
			"resolves qualified reference to exact dependency ID",
			test_type_header_graph_resolves_qualified_reference_to_exact_dependency_id,
		),
		(
			"rejects private qualified reference",
			test_type_header_graph_rejects_private_qualified_reference,
		),
		(
			"projects builtin visibility by module",
			test_type_header_graph_projects_builtin_visibility_by_module,
		),
		(
			"builtin installation preserves resource policy and visibility",
			test_builtin_header_installation_preserves_resource_policy_and_visibility,
		),
		(
			"projects record visibility by module",
			test_type_header_graph_projects_record_visibility_by_module,
		),
		(
			"local record installation preserves shape and layout",
			test_local_record_header_installation_preserves_shape_and_layout,
		),
		(
			"record installation uses exact cross-module identity",
			test_record_header_installation_uses_exact_cross_module_identity,
		),
		(
			"imported record qualifies owner-local prelude type",
			test_imported_record_header_qualifies_owner_local_prelude_type,
		),
		(
			"projects alias visibility by module",
			test_type_header_graph_projects_alias_visibility_by_module,
		),
		(
			"local alias installation preserves layout target and home",
			test_local_alias_header_installation_preserves_layout_target_and_home,
		),
		(
			"imported alias installation uses canonical target and home",
			test_imported_alias_header_installation_uses_canonical_target_and_home,
		),
		(
			"projects union visibility by module",
			test_type_header_graph_projects_union_visibility_by_module,
		),
		(
			"preserves selectively imported prelude union payload identity",
			test_union_header_installation_preserves_selectively_imported_prelude_identity,
		),
		(
			"local union installation preserves shape and constructor identity",
			test_local_union_header_installation_preserves_shape_and_constructor_identity,
		),
		(
			"imported enum installation uses canonical parent and constructor identity",
			test_imported_enum_header_uses_canonical_parent_and_exact_constructor_id,
		),
	]
}
