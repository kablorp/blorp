func test_type_header_graph_projects_alias_visibility_by_module() -> Bool:
	source: String =
		|type alias PublicAlias = String
		|private opaque type HiddenAlias = Int

	match type_header_fixture(source):
		None:
			False
		Some(fixture):
			identity = compiler_bound_module_identity(
				compiler_bound_module_graph_target(fixture.bound),
			)
			local_headers = compiler_type_header_graph_local_alias_headers(fixture.graph, identity)
			public_headers = compiler_type_header_graph_public_alias_headers(
				fixture.graph,
				identity,
			)

			match (local_headers, public_headers):
				([transparent_header, opaque_header], [public_header]):
					(
						compiler_type_id_name(
							compiler_alias_type_header_id(transparent_header),
						) == "PublicAlias"
						and compiler_type_id_name(
							compiler_alias_type_header_id(opaque_header),
						) == "HiddenAlias"
						and compiler_type_id_name(
							compiler_alias_type_header_id(public_header),
						) == "PublicAlias"
						and compiler_alias_type_header_layout(
							transparent_header,
						) == CompilerTransparentAlias
						and compiler_alias_type_header_layout(opaque_header) == CompilerOpaqueAlias
					)
				_:
					False


func test_local_alias_header_installation_preserves_layout_target_and_home() -> Bool:
	source: String =
		|record Local {value: Int}
		|type alias Wrapped[T] = List[T]
		|opaque type Secret = Local

	match type_header_fixture(source):
		None:
			False
		Some(fixture):
			identity = compiler_bound_module_identity(
				compiler_bound_module_graph_target(fixture.bound),
			)
			with_records = typecheck_install_local_record_headers(
				compiler_typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
				fixture.graph,
				identity,
				"std/types",
			)
			state = typecheck_install_local_alias_headers(
				with_records,
				fixture.graph,
				identity,
				"std/types",
			)

			match (env_get_alias(state.env, "Wrapped"), env_get_opaque_alias(state.env, "Secret")):
				(Some((wrapped_parameters, wrapped_target)), Some((secret_parameters, secret_target, secret_home))):
					state.errors.length() == 0 and wrapped_parameters == ["T"] and types_equal(
						wrapped_target,
						SemanticNamedType("List", [SemanticTypeVar("T")]),
					) and secret_parameters.is_empty() and types_equal(
						secret_target,
						SemanticNamedType("Local", []),
					) and secret_home == Some(
						"std/types",
					) and compiler_typecheck_state_find_type_home(
						state,
						"Wrapped",
					).is_none() and compiler_typecheck_state_find_type_home(
						state,
						"Secret",
					) == Some(
						"std/types",
					) and not compiler_typecheck_state_type_home_is_imported(state, "Secret")
				_:
					False


func test_imported_alias_header_installation_uses_canonical_target_and_home() -> Bool:
	source: String =
		|record Local {value: Int}
		|type alias Wrapped[T] = List[T]
		|opaque type Secret = Local
		|private type alias Hidden = Int

	match type_header_fixture_at("pkg/api", source):
		None:
			False
		Some(fixture):
			module = compiler_bound_module_graph_target(fixture.bound)
			identity = compiler_bound_module_identity(module)
			module_path = compiler_prepared_module_scope_canonical_path(
				compiler_bound_module_scope(module),
			)
			with_records = typecheck_install_imported_record_headers(
				compiler_typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
				fixture.graph,
				identity,
				module_path,
			)
			state = typecheck_install_imported_alias_headers(
				with_records,
				fixture.graph,
				identity,
				module_path,
			)
			canonical_wrapped = canonical_module_type_name(module_path, "Wrapped")
			canonical_secret = canonical_module_type_name(module_path, "Secret")
			canonical_local = canonical_module_type_name(module_path, "Local")
			canonical_hidden = canonical_module_type_name(module_path, "Hidden")

			match (
				env_get_alias(state.env, canonical_wrapped),
				env_get_opaque_alias(state.env, canonical_secret),
			):
				(Some((wrapped_parameters, wrapped_target)), Some((_, secret_target, secret_home))):
					state.errors.length() == 0 and wrapped_parameters == ["T"] and types_equal(
						wrapped_target,
						SemanticNamedType("List", [SemanticTypeVar("T")]),
					) and types_equal(
						secret_target,
						SemanticNamedType(canonical_local, []),
					) and secret_home == Some(
						module_path,
					) and compiler_typecheck_state_find_type_home(
						state,
						canonical_wrapped,
					).is_none() and compiler_typecheck_state_find_type_home(
						state,
						canonical_secret,
					) == Some(
						module_path,
					) and compiler_typecheck_state_type_home_is_imported(
						state,
						canonical_secret,
					) and env_get_alias(state.env, canonical_hidden).is_none()
				_:
					False


