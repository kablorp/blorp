import:
	../codegen_prepared_constructor_renderer:
		PreparedConstructorOp(
			ConstructorCall,
			ConstructorNullableNone,
			ConstructorNullablePayload,
			ConstructorSymbol,
			StackOptionNone,
			StackOptionValue,
			StackOptionVoidStatement,
			StackResultPayload,
		),
		RenderError(InvalidPreparedConstructorJson, UnsupportedPreparedConstructorOp, WrongArity),
		parse_prepared_constructor_template,
		prepared_constructor_template_arity,
		prepared_constructor_template_name,
		render_error_to_string,
		render_manifest_line,
		render_manifest_lines,
		render_prepared_constructor,
		render_prepared_constructor_json,
		render_prepared_constructor_op,
	test: TestSuite


func parsed_template_has(name: String, expected_name: String, expected_arity: Int) -> Bool:
	match parse_prepared_constructor_template(name):
		Some(info):
			(
				prepared_constructor_template_name(info) == expected_name
				and prepared_constructor_template_arity(info) == expected_arity
			)
		None:
			False


func rendered_constructor_is(name: String, args: List[String], expected: String) -> Bool:
	match render_prepared_constructor(name, args):
		Ok(rendered):
			rendered == expected
		Err(error):
			False


func rendered_constructor_json_is(source: String, expected: String) -> Bool:
	match render_prepared_constructor_json(source):
		Ok(rendered):
			rendered == expected
		Err(error):
			False


func manifest_line_is(name: String, expected: String) -> Bool:
	match parse_prepared_constructor_template(name):
		Some(info):
			render_manifest_line(info) == expected
		None:
			False


func test_parse_template_shapes() -> Bool:
	call_ok: Bool = parsed_template_has("backend_constructor_call", "backend_constructor_call", 2)
	symbol_ok: Bool = parsed_template_has(
		"backend_constructor_symbol",
		"backend_constructor_symbol",
		1,
	)
	none_ok: Bool = parsed_template_has(
		"backend_constructor_nullable_none",
		"backend_constructor_nullable_none",
		0,
	)
	payload_ok: Bool = parsed_template_has(
		"backend_constructor_nullable_payload",
		"backend_constructor_nullable_payload",
		1,
	)
	stack_option_ok: Bool = parsed_template_has(
		"backend_constructor_stack_option_value",
		"backend_constructor_stack_option_value",
		3,
	)
	stack_option_void_ok: Bool = parsed_template_has(
		"backend_constructor_stack_option_void_statement",
		"backend_constructor_stack_option_void_statement",
		3,
	)
	stack_option_none_ok: Bool = parsed_template_has(
		"backend_constructor_stack_option_none",
		"backend_constructor_stack_option_none",
		3,
	)
	stack_result_ok: Bool = parsed_template_has(
		"backend_constructor_stack_result_payload",
		"backend_constructor_stack_result_payload",
		5,
	)

	(
		call_ok
		and symbol_ok
		and none_ok
		and payload_ok
		and stack_option_ok
		and stack_option_void_ok
		and stack_option_none_ok
		and stack_result_ok
	)


func test_render_prepared_constructor_op_successes() -> Bool:
	call_ok: Bool = render_prepared_constructor_op(ConstructorCall({
		callee = "Point_make",
		argument_list = "x, y",
	})) == "Point_make(x, y)"
	empty_call_ok: Bool = render_prepared_constructor_op(ConstructorCall({
		callee = "Unit_make",
		argument_list = "",
	})) == "Unit_make()"
	symbol_ok: Bool = render_prepared_constructor_op(ConstructorSymbol("None")) == "None"
	nullable_none_ok: Bool = render_prepared_constructor_op(ConstructorNullableNone) == "NULL"
	nullable_payload_ok: Bool = render_prepared_constructor_op(
		ConstructorNullablePayload("value"),
	) == "value"
	stack_option_ok: Bool = render_prepared_constructor_op(StackOptionValue({
		option_type = "blorp_StackOption_Int",
		tag = "BLORP_TAG_SOME",
		value = "7L",
	})) == "((blorp_StackOption_Int){ .tag = BLORP_TAG_SOME, .value = 7L })"
	stack_option_void_ok: Bool = render_prepared_constructor_op(StackOptionVoidStatement({
		option_type = "blorp_StackOption_Void",
		tag = "BLORP_TAG_SOME",
		statement = "do_side_effect();",
	})) == (
		"({ do_side_effect(); ((blorp_StackOption_Void){ .tag = BLORP_TAG_SOME, .value = "
		+ "0 }); })"
	)
	stack_option_none_ok: Bool = render_prepared_constructor_op(StackOptionNone({
		option_type = "blorp_StackOption_Int",
		tag = "BLORP_TAG_NONE",
		none_value = "0L",
	})) == "((blorp_StackOption_Int){ .tag = BLORP_TAG_NONE, .value = 0L })"
	stack_result_ok: Bool = render_prepared_constructor_op(StackResultPayload({
		result_type = "blorp_StackResult_Int_String",
		tag = "BLORP_TAG_OK",
		field = "Ok",
		payload = "value",
		release_mask = "1",
	})) == (
		"((blorp_StackResult_Int_String){ .tag = BLORP_TAG_OK, .release_mask = 1UL, ."
		+ "data.Ok.field0 = value })"
	)

	(
		call_ok
		and empty_call_ok
		and symbol_ok
		and nullable_none_ok
		and nullable_payload_ok
		and stack_option_ok
		and stack_option_void_ok
		and stack_option_none_ok
		and stack_result_ok
	)


func test_render_prepared_constructor_successes() -> Bool:
	call_ok: Bool = rendered_constructor_is(
		"backend_constructor_call",
		["Pair_make", "left, right, 3UL"],
		"Pair_make(left, right, 3UL)",
	)
	empty_call_ok: Bool = rendered_constructor_is(
		"backend_constructor_call",
		["Empty_make", ""],
		"Empty_make()",
	)
	symbol_ok: Bool = rendered_constructor_is("backend_constructor_symbol", ["Unknown"], "Unknown")
	none_ok: Bool = rendered_constructor_is("backend_constructor_nullable_none", [], "NULL")
	payload_ok: Bool = rendered_constructor_is(
		"backend_constructor_nullable_payload",
		["payload"],
		"payload",
	)
	stack_option_ok: Bool = rendered_constructor_is(
		"backend_constructor_stack_option_value",
		["blorp_StackOption_Int", "BLORP_TAG_SOME", "7L"],
		"((blorp_StackOption_Int){ .tag = BLORP_TAG_SOME, .value = 7L })",
	)
	stack_option_void_ok: Bool = rendered_constructor_is(
		"backend_constructor_stack_option_void_statement",
		["blorp_StackOption_Void", "BLORP_TAG_SOME", "do_side_effect();"],
		(
			"({ do_side_effect(); ((blorp_StackOption_Void){ .tag = BLORP_TAG_SOME, .value = "
			+ "0 }); })"
		),
	)
	stack_option_none_ok: Bool = rendered_constructor_is(
		"backend_constructor_stack_option_none",
		["blorp_StackOption_Int", "BLORP_TAG_NONE", "0L"],
		"((blorp_StackOption_Int){ .tag = BLORP_TAG_NONE, .value = 0L })",
	)
	stack_result_ok: Bool = rendered_constructor_is(
		"backend_constructor_stack_result_payload",
		["blorp_StackResult_Int_String", "BLORP_TAG_ERR", "Err", "error", "1"],
		(
			"((blorp_StackResult_Int_String){ .tag = BLORP_TAG_ERR, .release_mask = 1UL, ."
			+ "data.Err.field0 = error })"
		),
	)

	(
		call_ok
		and empty_call_ok
		and symbol_ok
		and none_ok
		and payload_ok
		and stack_option_ok
		and stack_option_void_ok
		and stack_option_none_ok
		and stack_result_ok
	)


func test_render_prepared_constructor_json_successes() -> Bool:
	call_ok: Bool = rendered_constructor_json_is(
		"{\"op\":\"constructor_call\",\"callee\":\"Point_make\",\"argument_list\":\"x, y\"}",
		"Point_make(x, y)",
	)
	empty_call_ok: Bool = rendered_constructor_json_is(
		"{\"op\":\"constructor_call\",\"callee\":\"Empty_make\",\"argument_list\":\"\"}",
		"Empty_make()",
	)
	symbol_ok: Bool = rendered_constructor_json_is(
		"{\"op\":\"constructor_symbol\",\"name\":\"None\"}",
		"None",
	)
	none_ok: Bool = rendered_constructor_json_is("{\"op\":\"constructor_nullable_none\"}", "NULL")
	payload_ok: Bool = rendered_constructor_json_is(
		"{\"op\":\"constructor_nullable_payload\",\"payload\":\"value\"}",
		"value",
	)
	stack_option_ok: Bool = rendered_constructor_json_is(
		"{\"op\":\"stack_option_value\",\"option_type\":\"blorp_StackOption_Int\",\"tag\":\"BLORP_TAG_SOME\",\"value\":\"7L\"}",
		"((blorp_StackOption_Int){ .tag = BLORP_TAG_SOME, .value = 7L })",
	)
	stack_option_void_ok: Bool = rendered_constructor_json_is(
		"{\"op\":\"stack_option_void_statement\",\"option_type\":\"blorp_StackOption_Void\",\"tag\":\"BLORP_TAG_SOME\",\"statement\":\"do_side_effect();\"}",
		(
			"({ do_side_effect(); ((blorp_StackOption_Void){ .tag = BLORP_TAG_SOME, .value = "
			+ "0 }); })"
		),
	)
	stack_option_none_ok: Bool = rendered_constructor_json_is(
		"{\"op\":\"stack_option_none\",\"option_type\":\"blorp_StackOption_Int\",\"tag\":\"BLORP_TAG_NONE\",\"none_value\":\"0L\"}",
		"((blorp_StackOption_Int){ .tag = BLORP_TAG_NONE, .value = 0L })",
	)
	stack_result_ok: Bool = rendered_constructor_json_is(
		"{\"op\":\"stack_result_payload\",\"result_type\":\"blorp_StackResult_Int_String\",\"tag\":\"BLORP_TAG_ERR\",\"field\":\"Err\",\"payload\":\"error\",\"release_mask\":\"1\"}",
		(
			"((blorp_StackResult_Int_String){ .tag = BLORP_TAG_ERR, .release_mask = 1UL, ."
			+ "data.Err.field0 = error })"
		),
	)

	(
		call_ok
		and empty_call_ok
		and symbol_ok
		and none_ok
		and payload_ok
		and stack_option_ok
		and stack_option_void_ok
		and stack_option_none_ok
		and stack_result_ok
	)


func test_render_prepared_constructor_errors_are_typed() -> Bool:
	wrong_arity_ok: Bool = match render_prepared_constructor(
		"backend_constructor_call",
		["Point_make"],
	):
		Err(WrongArity(info, actual)):
			(
				prepared_constructor_template_name(info) == "backend_constructor_call"
				and prepared_constructor_template_arity(info) == 2
				and actual == 1
			)
		Ok(value):
			False
		Err(UnsupportedPreparedConstructorOp(name)):
			False
		Err(InvalidPreparedConstructorJson(message)):
			False

	unsupported_ok: Bool = match render_prepared_constructor("backend_missing", []):
		Err(UnsupportedPreparedConstructorOp(name)):
			name == "backend_missing"
		Ok(value):
			False
		Err(WrongArity(info, actual)):
			False
		Err(InvalidPreparedConstructorJson(message)):
			False

	wrong_arity_ok and unsupported_ok


func test_render_prepared_constructor_json_errors_are_typed() -> Bool:
	missing_field_ok: Bool = match render_prepared_constructor_json(
		"{\"op\":\"constructor_call\",\"callee\":\"Point_make\"}",
	):
		Err(InvalidPreparedConstructorJson(message)):
			message == "missing string field: argument_list"
		Ok(value):
			False
		Err(WrongArity(info, actual)):
			False
		Err(UnsupportedPreparedConstructorOp(name)):
			False

	unknown_op_ok: Bool = match render_prepared_constructor_json(
		"{\"op\":\"constructor_missing\"}",
	):
		Err(InvalidPreparedConstructorJson(message)):
			message == "unknown constructor op: constructor_missing"
		Ok(value):
			False
		Err(WrongArity(info, actual)):
			False
		Err(UnsupportedPreparedConstructorOp(name)):
			False

	parse_error_ok: Bool = match render_prepared_constructor_json("{not json"):
		Err(InvalidPreparedConstructorJson(message)):
			message.length() > 0
		Ok(value):
			False
		Err(WrongArity(info, actual)):
			False
		Err(UnsupportedPreparedConstructorOp(name)):
			False

	missing_field_ok and unknown_op_ok and parse_error_ok


func test_manifest_lines() -> Bool:
	call_ok: Bool = manifest_line_is(
		"backend_constructor_call",
		"backend_constructor_call\t2\t@0@(@1@)",
	)
	symbol_ok: Bool = manifest_line_is(
		"backend_constructor_symbol",
		"backend_constructor_symbol\t1\t@0@",
	)
	nullable_none_ok: Bool = manifest_line_is(
		"backend_constructor_nullable_none",
		"backend_constructor_nullable_none\t0\tNULL",
	)
	nullable_payload_ok: Bool = manifest_line_is(
		"backend_constructor_nullable_payload",
		"backend_constructor_nullable_payload\t1\t@0@",
	)
	stack_option_value_ok: Bool = manifest_line_is(
		"backend_constructor_stack_option_value",
		"backend_constructor_stack_option_value\t3\t((@0@){ .tag = @1@, .value = @2@ })",
	)
	stack_option_void_ok: Bool = manifest_line_is(
		"backend_constructor_stack_option_void_statement",
		"backend_constructor_stack_option_void_statement\t3\t({ @2@ ((@0@){ .tag = @1@, .value = 0 }); })",
	)
	stack_option_none_ok: Bool = manifest_line_is(
		"backend_constructor_stack_option_none",
		"backend_constructor_stack_option_none\t3\t((@0@){ .tag = @1@, .value = @2@ })",
	)
	stack_result_ok: Bool = manifest_line_is(
		"backend_constructor_stack_result_payload",
		"backend_constructor_stack_result_payload\t5\t((@0@){ .tag = @1@, .release_mask = @4@UL, .data.@2@.field0 = @3@ })",
	)
	manifest_count_ok: Bool = render_manifest_lines().length() == 8

	(
		call_ok
		and symbol_ok
		and nullable_none_ok
		and nullable_payload_ok
		and stack_option_value_ok
		and stack_option_void_ok
		and stack_option_none_ok
		and stack_result_ok
		and manifest_count_ok
	)


func test_error_text() -> Bool:
	arity_text: String = match render_prepared_constructor(
		"backend_constructor_call",
		["Point_make"],
	):
		Err(error):
			render_error_to_string(error)
		Ok(value):
			value

	unsupported_text: String = render_error_to_string(
		UnsupportedPreparedConstructorOp("backend_missing"),
	)
	json_text: String = render_error_to_string(
		InvalidPreparedConstructorJson("missing string field: op"),
	)

	(
		arity_text == "prepared constructor op backend_constructor_call expected 2 arg(s), got 1"
		and unsupported_text == "unsupported prepared constructor op: backend_missing"
		and json_text == "invalid prepared constructor JSON: missing string field: op"
	)


tests: TestSuite = {
	description = "Self-hosted compiler prepared constructor renderer",
	tests = [
		("parse template shapes", test_parse_template_shapes),
		("render prepared constructor op successes", test_render_prepared_constructor_op_successes),
		("render prepared constructor successes", test_render_prepared_constructor_successes),
		(
			"render prepared constructor json successes",
			test_render_prepared_constructor_json_successes,
		),
		(
			"render prepared constructor errors are typed",
			test_render_prepared_constructor_errors_are_typed,
		),
		(
			"render prepared constructor json errors are typed",
			test_render_prepared_constructor_json_errors_are_typed,
		),
		("manifest lines", test_manifest_lines),
		("error text", test_error_text),
	]
}
