import:
	../src/stage_12_cli/compiler_cli_args:
		CliAction(
			CliCheck,
			CliCheckHelp,
			CliCompile,
			CliCompileHelp,
			CliError,
			CliFormat,
			CliLsp,
			CliPackage,
			CliPurify,
			CliPurifyHelp,
			CliRun,
			CliRunHelp,
			CliTest,
			CliTestHelp,
			CliTestWarmupOnly,
			CliUsage,
			CliVersion,
		),
		CliFormatAction(CliFormatFiles),
		CliFormatMode(CliFormatCheckDiff),
		CliPackageAction(
			CliPackageCheck,
			CliPackageFetchTarget,
			CliPackagePack,
			CliPackageVendorTarget,
		),
		CliSanitizerMode(CliSanitizeUndefined),
		CliTestMode(CliTestDocOnly),
		parse_cli_args,
	test: TestSuite


func test_top_level_dispatch() -> Bool:
	help_ok: Bool = match parse_cli_args(["--help"]):
		CliUsage(status):
			status == 0
		_:
			False

	empty_ok: Bool = match parse_cli_args([]):
		CliUsage(status):
			status == 1
		_:
			False

	version_ok: Bool = match parse_cli_args(["--version"]):
		CliVersion:
			True
		_:
			False

	unknown_ok: Bool = match parse_cli_args(["wat"]):
		CliError(message):
			message == "Error: Unknown command"
		_:
			False

	all_ok: Bool = help_ok and empty_ok and version_ok and unknown_ok

	all_ok


func test_small_command_parsers() -> Bool:
	lsp_ok: Bool = match parse_cli_args(["lsp"]):
		CliLsp(CliLspRun):
			True
		_:
			False

	lsp_help_ok: Bool = match parse_cli_args(["lsp", "-h"]):
		CliLsp(CliLspHelp):
			True
		_:
			False

	purify_ok: Bool = match parse_cli_args([
		"purify",
		"--dry-run",
		"-v",
		"src",
	]):
		CliPurify(args):
			args.dry_run and args.verbose and args.paths == ["src"]
		_:
			False

	check_ok: Bool = match parse_cli_args([
		"check",
		"--dump-typed-ast",
		"--std-dir",
		"std",
		"src",
	]):
		CliCheck(args):
			args.dump_typed_ast and args.std_dir == Some("std") and args.paths == ["src"]
		_:
			False

	lsp_ok and lsp_help_ok and purify_ok and check_ok


func test_command_specific_help() -> Bool:
	check_help_ok: Bool = match parse_cli_args(["check", "--help"]):
		CliCheckHelp:
			True
		_:
			False

	compile_help_ok: Bool = match parse_cli_args(["compile", "-h"]):
		CliCompileHelp:
			True
		_:
			False

	run_help_ok: Bool = match parse_cli_args(["run", "--help"]):
		CliRunHelp:
			True
		_:
			False

	test_help_ok: Bool = match parse_cli_args(["test", "-h"]):
		CliTestHelp:
			True
		_:
			False

	purify_help_ok: Bool = match parse_cli_args(["purify", "--help"]):
		CliPurifyHelp:
			True
		_:
			False

	all_ok: Bool = (
		check_help_ok
		and compile_help_ok
		and run_help_ok
		and test_help_ok
		and purify_help_ok
	)

	all_ok


func test_format_parser() -> Bool:
	diff_ok: Bool = match parse_cli_args([
		"format",
		"--diff",
		"a.brp",
		"src",
	]):
		CliFormat(CliFormatFiles(args)):
			args.mode == CliFormatCheckDiff and args.paths == ["a.brp", "src"]
		_:
			False

	emit_program_json_rejected: Bool = match parse_cli_args(
		["format", "--emit-program-json", "a.brp"],
	):
		CliError(message):
			message == "unknown format option: --emit-program-json"
		_:
			False

	missing_ok: Bool = match parse_cli_args(["format"]):
		CliError(message):
			message.contains("no files specified")
		_:
			False

	all_ok: Bool = diff_ok and emit_program_json_rejected and missing_ok

	all_ok


func test_package_parser() -> Bool:
	check_ok: Bool = match parse_cli_args(["package", "check", "pkg"]):
		CliPackage(CliPackageCheck(path)):
			path == "pkg"
		_:
			False

	pack_ok: Bool = match parse_cli_args([
		"package",
		"pack",
		"pkg",
		"-o",
		"pkg.blp",
	]):
		CliPackage(CliPackagePack(args)):
			args.path == "pkg" and args.output == "pkg.blp"
		_:
			False

	pack_long_output_ok: Bool = match parse_cli_args([
		"package",
		"pack",
		"pkg",
		"--output",
		"pkg.blp",
	]):
		CliPackage(CliPackagePack(args)):
			args.path == "pkg" and args.output == "pkg.blp"
		_:
			False

	pack_ignores_unknown_dash_options_ok: Bool = match parse_cli_args([
		"package",
		"pack",
		"pkg",
		"--ignored-by-legacy-parser",
		"-o",
		"pkg.blp",
	]):
		CliPackage(CliPackagePack(args)):
			args.path == "pkg" and args.output == "pkg.blp"
		_:
			False

	fetch_ok: Bool = match parse_cli_args([
		"package",
		"fetch",
		"alias",
		"https://example.invalid/pkg",
	]):
		CliPackage(CliPackageFetchTarget(target, locations)):
			target == "alias" and locations == ["https://example.invalid/pkg"]
		_:
			False

	vendor_ok: Bool = match parse_cli_args([
		"package",
		"vendor",
		"hash",
		"vendor/hash",
	]):
		CliPackage(CliPackageVendorTarget(target, dest)):
			target == "hash" and dest == Some("vendor/hash")
		_:
			False

	error_ok: Bool = match parse_cli_args([
		"package",
		"hash",
		"one",
		"two",
	]):
		CliError(message):
			message == "Error: package hash accepts exactly one path"
		_:
			False

	all_ok: Bool = (
		check_ok
		and pack_ok
		and pack_long_output_ok
		and pack_ignores_unknown_dash_options_ok
		and fetch_ok
		and vendor_ok
		and error_ok
	)

	all_ok


func test_compile_parser() -> Bool:
	compile_ok: Bool = match parse_cli_args([
		"compile",
		"--profile",
		"--dump-core-after=lower,mono",
		"--stop-after",
		"final",
		"--dump-core-file",
		"core.txt",
		"--no-embed-runtime",
		"-o",
		"main.c",
		"main.brp",
	]):
		CliCompile(args):
			(
				args.profile
				and args.dump_core_after == ["lower", "mono"]
				and args.stop_after == Some("final")
				and args.dump_file == Some("core.txt")
				and not args.embed_runtime
				and args.output == Some("main.c")
				and args.files == ["main.brp"]
			)
		_:
			False

	stop_defaults_dump_ok: Bool = match parse_cli_args(
		["compile", "--stop-after=mono", "main.brp"],
	):
		CliCompile(args):
			args.stop_after == Some("mono") and args.dump_core_after == ["mono"]
		_:
			False

	unknown_option_ok: Bool = match parse_cli_args(["compile", "--bogus"]):
		CliError(message):
			message == "Error: unknown compile option: --bogus"
		_:
			False

	multiple_inputs_error_ok: Bool = match parse_cli_args(["compile", "one.brp", "two.brp"]):
		CliError(message):
			message == "Error: Multiple input files not supported"
		_:
			False

	missing_input_error_ok: Bool = match parse_cli_args(["compile"]):
		CliError(message):
			message == "Error: No input file specified"
		_:
			False

	missing_stage_value_error_ok: Bool = match parse_cli_args(["compile", "--dump-core-after"]):
		CliError(message):
			message == "Error: --dump-core-after requires a value"
		_:
			False

	all_ok: Bool = (
		compile_ok
		and stop_defaults_dump_ok
		and unknown_option_ok
		and multiple_inputs_error_ok
		and missing_input_error_ok
		and missing_stage_value_error_ok
	)

	all_ok


func test_run_and_test_parsers() -> Bool:
	run_ok: Bool = match parse_cli_args([
		"run",
		"--release",
		"--sanitize=undefined",
		"--timeout",
		"5",
		"--threads",
		"4",
		"main.brp",
		"--",
		"one",
		"two",
	]):
		CliRun(args):
			(
				args.release
				and args.sanitizer == Some(CliSanitizeUndefined)
				and args.timeout == Some(5)
				and args.threads == Some(4)
				and args.files == ["main.brp"]
				and args.user_args == ["one", "two"]
			)
		_:
			False

	test_ok: Bool = match parse_cli_args([
		"test",
		"--doc",
		"--repeat",
		"3",
		"-j",
		"8",
		"--no-cache",
		"tests",
	]):
		CliTest(args):
			(
				args.mode == CliTestDocOnly
				and args.repeat == 3
				and args.jobs == 8
				and not args.cache
				and args.paths == ["tests"]
			)
		_:
			False

	repeat_error_ok: Bool = match parse_cli_args(["test", "--repeat", "0"]):
		CliError(message):
			message == "Error: --repeat requires a positive integer"
		_:
			False

	run_timeout_integer_error_ok: Bool = match parse_cli_args(["run", "--timeout", "soon"]):
		CliError(message):
			message == "Error: --timeout requires an integer"
		_:
			False

	test_jobs_integer_error_ok: Bool = match parse_cli_args(["test", "-j", "many"]):
		CliError(message):
			message == "Error: -j requires an integer"
		_:
			False

	repeat_integer_error_ok: Bool = match parse_cli_args(["test", "--repeat", "many"]):
		CliError(message):
			message == "Error: --repeat requires a positive integer"
		_:
			False

	warmup_only_ok: Bool = match parse_cli_args(["test", "--warmup-only"]):
		CliTestWarmupOnly:
			True
		_:
			False

	warmup_only_validates_later_options_ok: Bool = match parse_cli_args(
		["test", "--warmup-only", "--bogus"],
	):
		CliError(message):
			message == "Error: unknown test option: --bogus"
		_:
			False

	warmup_only_rejects_paths_ok: Bool = match parse_cli_args([
		"test",
		"--warmup-only",
		"tests/test_blorp/types/test_bool.brp",
	]):
		CliError(message):
			message == "Error: test --warmup-only does not accept test paths"
		_:
			False

	run_no_input_error_ok: Bool = match parse_cli_args(["run"]):
		CliError(message):
			message == "Error: No input file specified"
		_:
			False

	run_multiple_inputs_error_ok: Bool = match parse_cli_args(["run", "one.brp", "two.brp"]):
		CliError(message):
			message == "Error: Multiple input files not supported"
		_:
			False

	run_missing_timeout_value_ok: Bool = match parse_cli_args(["run", "--timeout"]):
		CliError(message):
			message == "Error: --timeout requires a value"
		_:
			False

	test_no_path_error_ok: Bool = match parse_cli_args(["test"]):
		CliError(message):
			message == "Error: No test path specified"
		_:
			False

	test_missing_jobs_value_ok: Bool = match parse_cli_args(["test", "-j"]):
		CliError(message):
			message == "Error: -j requires a value"
		_:
			False

	all_ok: Bool = (
		run_ok
		and test_ok
		and repeat_error_ok
		and run_timeout_integer_error_ok
		and test_jobs_integer_error_ok
		and repeat_integer_error_ok
		and warmup_only_ok
		and warmup_only_validates_later_options_ok
		and warmup_only_rejects_paths_ok
		and run_no_input_error_ok
		and run_multiple_inputs_error_ok
		and run_missing_timeout_value_ok
		and test_no_path_error_ok
		and test_missing_jobs_value_ok
	)

	all_ok


func test_other_required_path_validation() -> Bool:
	check_no_input_error_ok: Bool = match parse_cli_args(["check"]):
		CliError(message):
			message == "Error: No input file specified"
		_:
			False

	purify_no_input_error_ok: Bool = match parse_cli_args(["purify"]):
		CliError(message):
			message == "Error: No input files specified"
		_:
			False

	check_missing_std_dir_value_ok: Bool = match parse_cli_args(["check", "--std-dir"]):
		CliError(message):
			message == "Error: --std-dir requires a value"
		_:
			False

	purify_help_still_bypasses_validation_ok: Bool = match parse_cli_args(["purify", "-h"]):
		CliPurifyHelp:
			True
		_:
			False

	all_ok: Bool = (
		check_no_input_error_ok
		and purify_no_input_error_ok
		and check_missing_std_dir_value_ok
		and purify_help_still_bypasses_validation_ok
	)

	all_ok


tests: TestSuite = {
	description = "Blorp CLI argument parser",
	tests = [
		("top-level dispatch", test_top_level_dispatch),
		("small command parsers", test_small_command_parsers),
		("command-specific help", test_command_specific_help),
		("format parser", test_format_parser),
		("package parser", test_package_parser),
		("compile parser", test_compile_parser),
		("run and test parsers", test_run_and_test_parsers),
		("other required path validation", test_other_required_path_validation),
	]
}
