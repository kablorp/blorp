import:
	../src/stage_01_file_io/source: compiler_source_file
	../src/stage_04_modules/loaded_module: compiler_module_identity_storage_key
	../src/stage_04_modules/source_package_layout: CompilerSourcePackageLayout
	../src/stage_06_typecheck/typecheck_bridge:
		TypecheckGraphRequest,
		TypecheckImportModule,
		compiler_typecheck_graph,
	../src/stage_12_lsp/lsp_analysis_cache: LspAnalysisCacheSnapshot, lsp_analysis_cache_store_typed
	../src/stage_12_lsp/lsp_analysis_model:
		LspModuleSemanticIndex,
		LspSemanticIndexState(LspSemanticIndexUnavailable),
		lsp_typed_artifact_from_compiler,
	../src/stage_12_lsp/lsp_analysis_planner: lsp_frontend_fingerprint, lsp_plan_analysis
	../src/stage_12_lsp/lsp_architecture:
		LspAnalysisPlan,
		LspAnalysisPlanningRequirement(LspAnalysisPlanRequired),
		LspInvalidationReason(LspDocumentIdentityInvalidated, LspSourceContentInvalidated),
