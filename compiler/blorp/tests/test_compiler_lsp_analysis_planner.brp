	../src/stage_12_lsp/lsp_identity: lsp_document_uri, lsp_document_uri_value
	../src/stage_12_lsp/lsp_snapshot_model: lsp_workspace_revision_value
	../src/stage_12_lsp/lsp_workspace: lsp_workspace, lsp_workspace_snapshot
