import:
	../src/stage_12_cli/compiler_cli_run_policy: run_timeout_duration
	test: TestSuite
	units: seconds, to_microseconds


pure func test_zero_disables_run_timeout() -> Bool:
	(
		run_timeout_duration(None).is_none()
		and run_timeout_duration(Some(0)).is_none()
		and match run_timeout_duration(Some(3)):
			Some(duration):
				to_microseconds(duration) == to_microseconds(seconds(3))
			None:
				False
	)


tests: TestSuite = {
	description = "Compiler CLI run policy",
	tests = [("zero disables the run timeout", test_zero_disables_run_timeout)]
}
