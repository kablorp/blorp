import:
	../src/stage_03_parse/compiler_parser_bridge as ParserBridge
	../src/stage_09_core/compiler_core_json:
		CoreBinaryOp(AddOp),
		CoreCallKind(UserCall),
		CoreDecl(FunctionDecl),
		CoreExpr(
			BinaryExpr,
			CallExpr,
			CooperativeCheckpointExpr,
			LetExpr,
			LiteralExpr,
			SeqExpr,
			VarExpr,
			VoidExpr,
			WhileExpr,
		),
		CoreFunction,
		CoreFunctionKind(UserFunction),
		CoreLiteral(BoolLiteral, IntLiteral, StringLiteral),
		CoreParam,
		CoreProgram,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType, VoidType),
		CoreVar,
		core_program_to_json,
		decode_core_program_json,
	../src/stage_12_cli/compiler_bridge: handle_request
	../src/stage_12_cli/compiler_parser_bridge_cli as ParserBridgeCli
	bytes: from_hex
	json:
		JsonValue(JsonNumber, JsonObject, JsonString, JsonVector),
		as_array,
		as_bool,
		as_string,
		get_field,
		parse_json,
	system: remove_file, temp_dir, write_file
	test: TestSuite


pure func response_value(source: String) -> Option[JsonValue]:
	match parse_json(handle_request(source)):
		Ok(value):
			Some(value)
		Err(_):
			None


pure func parser_response_value(source: String) -> Option[JsonValue]:
	match parse_json(ParserBridge.handle_request(source)):
		Ok(value):
			Some(value)
		Err(_):
			None


pure func parsed_json_value(source: String) -> Option[JsonValue]:
	match parse_json(source):
		Ok(value):
			Some(value)
		Err(_):
			None


pure func bool_field(value: JsonValue, name: String) -> Bool:
	match get_field(value, name):
		Some(field):
			match as_bool(field):
				Some(b):
					b
				None:
					False
		None:
			False


pure func string_field(value: JsonValue, name: String) -> String:
	match get_field(value, name):
		Some(field):
			match as_string(field):
				Some(text):
					text
				None:
					""
		None:
			""


pure func error_code(value: JsonValue) -> String:
	match get_field(value, "error"):
		Some(error):
			string_field(error, "code")
		None:
			""


pure func error_message(value: JsonValue) -> String:
	match get_field(value, "error"):
		Some(error):
			string_field(error, "message")
		None:
			""


pure func first_rendered_item_text(value: JsonValue) -> String:
	match get_field(value, "items"):
		Some(items_value):
			match as_array(items_value):
				Some(items):
					match items.get(0):
						Some(item):
							string_field(item, "text")
						None:
							""
				None:
					""
		None:
			""


pure func artifact_string_field(value: JsonValue, name: String) -> String:
	match get_field(value, "artifact"):
		Some(artifact):
			string_field(artifact, name)
		None:
			""


pure func core_response(value: JsonValue) -> Option[CoreProgram]:
	match get_field(value, "core"):
		Some(core_json):
			match decode_core_program_json(core_json):
				Ok(program):
					Some(program)
				Err(error):
					None
		None:
			None


pure func core_programs_equal(left: CoreProgram, right: CoreProgram) -> Bool:
	core_program_to_json(left).to_string() == core_program_to_json(right).to_string()


pure func option_core_program_equal(left: Option[CoreProgram], right: CoreProgram) -> Bool:
	match left:
		Some(program):
			core_programs_equal(program, right)
		None:
			False


pure func request_json(action: String, payload: JsonValue) -> String:
	JsonObject([
		("schema", JsonNumber(1.0)),
		("domain", JsonString("compiler")),
		("action", JsonString(action)),
		("payload", payload),
	]).to_string()


pure func json_string_list(values: List[String]) -> JsonValue:
	JsonVector(values.map(
		func(value: String): JsonString(value),
	))


pure func render_item_json(op: String, args: List[String]) -> JsonValue:
	JsonObject([("op", JsonString(op)), ("args", json_string_list(args))])


pure func render_many_payload_json(renderer: String, op: String, args: List[String]) -> JsonValue:
	JsonObject([
		("renderer", JsonString(renderer)),
		("items", JsonVector([render_item_json(op, args)])),
	])


pure func render_many_request_json(renderer: String, op: String, args: List[String]) -> String:
	request_json(
		"render_many",
		render_many_payload_json(renderer, op, args),
	)


pure func run_core_pipeline_response(stage: String, program: CoreProgram) -> Option[CoreProgram]:
	request: String = request_json("run_core_pipeline", JsonObject([
			("stage", JsonString(stage)),
			("core", core_program_to_json(program)),
		]))
	response ?= response_value(request)

	if bool_field(response, "ok"):
		core_response(response)
	else:
		None


pure func bridge_emit_program() -> CoreProgram:
	int_type = NamedType("Int", [])
	main_func: CoreFunction = {
		name = "main",
		source_module = None,
		type_params = [],
		params = [],
		return_type = int_type,
		body = Some(
			BinaryExpr(
				AddOp,
				LiteralExpr(IntLiteral(39), int_type, SyntheticSourceLoc),
				LiteralExpr(IntLiteral(3), int_type, SyntheticSourceLoc),
				int_type,
				SyntheticSourceLoc,
			),
		),
		is_pure = False,
		function_kind = UserFunction,
		def_id = 1,
		loc = SyntheticSourceLoc
	}

	{
		decls = [FunctionDecl(main_func)],
		foreign_includes = []
	}


pure func bridge_loop_program() -> CoreProgram:
	bool_type = NamedType("Bool", [])
	main_func: CoreFunction = {
		name = "main",
		source_module = None,
		type_params = [],
		params = [],
		return_type = VoidType,
		body = Some(
			WhileExpr(
				LiteralExpr(BoolLiteral(True), bool_type, SyntheticSourceLoc),
				VoidExpr(VoidType, SyntheticSourceLoc),
				VoidType,
				SyntheticSourceLoc,
			),
		),
		is_pure = False,
		function_kind = UserFunction,
		def_id = 4,
		loc = SyntheticSourceLoc
	}

	{
		decls = [FunctionDecl(main_func)],
		foreign_includes = []
	}


pure func expected_bridge_loop_program_after_tail_pipeline() -> CoreProgram:
	bool_type = NamedType("Bool", [])
	main_func: CoreFunction = {
		name = "main",
		source_module = None,
		type_params = [],
		params = [],
		return_type = VoidType,
		body = Some(
			WhileExpr(
				LiteralExpr(BoolLiteral(True), bool_type, SyntheticSourceLoc),
				SeqExpr(
					CooperativeCheckpointExpr(VoidType, SyntheticSourceLoc),
					VoidExpr(VoidType, SyntheticSourceLoc),
				),
				VoidType,
				SyntheticSourceLoc,
			),
		),
		is_pure = False,
		function_kind = UserFunction,
		def_id = 4,
		loc = SyntheticSourceLoc
	}

	{
		decls = [FunctionDecl(main_func)],
		foreign_includes = []
	}


pure func test_render_payload_request() -> Bool:
	request: String = render_many_request_json(
		"core_stage",
		"core_stage_unknown_error",
		["monot", "monot"],
	)

	match response_value(request):
		Some(response):
			(
				bool_field(response, "ok")
				and first_rendered_item_text(
					response,
				) == "unknown stage \"monot\" (did you mean \"mono\"?) (valid: ${expected_core_stage_names()})"
			)
		None:
			False


pure func test_render_many_request() -> Bool:
	request: String = render_many_request_json(
		"core_stage",
		"core_stage_unknown_error",
		["monot", "monot"],
	)

	match response_value(request):
		Some(response):
			(
				bool_field(response, "ok")
				and first_rendered_item_text(
					response,
				) == "unknown stage \"monot\" (did you mean \"mono\"?) (valid: ${expected_core_stage_names()})"
			)
		None:
			False


pure func expected_core_stage_names() -> String:
	(
		"lower, debug, desugar, mono, synth, match, trait_resolve, resolve, std_inline, "
		+ "tailrec, fusion, specialize, dce, consume_specialize, perceus, reuse, closure, "
		+ "final"
	)


pure func test_render_core_stage_request() -> Bool:
	request: String = render_many_request_json(
		"core_stage",
		"core_stage_unknown_error",
		["monot", "monot"],
	)

	match response_value(request):
		Some(response):
			(
				bool_field(response, "ok")
				and first_rendered_item_text(
					response,
				) == "unknown stage \"monot\" (did you mean \"mono\"?) (valid: ${expected_core_stage_names()})"
			)
		None:
			False


pure func test_render_core_trait_resolve_request() -> Bool:
	request: String = render_many_request_json(
		"core_trait_resolve",
		"core_trait_resolve_no_impl_hint",
		["to_string", "Widgit", "Gadget;Widget"],
	)

	match response_value(request):
		Some(response):
			bool_field(response, "ok") and first_rendered_item_text(response) == (
				"did you mean to call it on a Widget? Or add `implements <trait> for Widgit:` "
				+ "defining `to_string`."
			)
		None:
			False


pure func test_emit_core_c_core_payload_request() -> Bool:
	request: String = request_json(
		"emit_core_c",
		JsonObject([("core", core_program_to_json(bridge_emit_program()))]),
	)

	match response_value(request):
		Some(response):
			(
				bool_field(response, "ok")
				and artifact_string_field(response, "c_code").contains("int main(void)")
				and artifact_string_field(response, "c_code").contains("return (39 + 3);")
			)
		None:
			False


pure func bridge_mutable_string_pre_dce_program() -> CoreProgram:
	desc: CoreVar = {name = "desc", uniq = 0, def_id = None}
	read: CoreVar = {name = "read", uniq = 0, def_id = None}
	string_type: CoreType = NamedType("String", [])
	int_type: CoreType = NamedType("Int", [])
	read_param: CoreParam = {
		name = {name = "value", uniq = 0, def_id = None},
		typ = string_type,
		loc = SyntheticSourceLoc
	}
	read_func: CoreFunction = {
		name = "read",
		source_module = None,
		type_params = [],
		params = [read_param],
		return_type = int_type,
		body = Some(LiteralExpr(IntLiteral(1), int_type, SyntheticSourceLoc)),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 5,
		loc = SyntheticSourceLoc
	}
	render_func: CoreFunction = {
		name = "render",
		source_module = None,
		type_params = [],
		params = [],
		return_type = int_type,
		body = Some(
			LetExpr(
				desc,
				True,
				string_type,
				LiteralExpr(StringLiteral("description"), string_type, SyntheticSourceLoc),
				CallExpr(
					UserCall("read", Some(5), []),
					VarExpr(read, NamedType("Function", []), SyntheticSourceLoc),
					[VarExpr(desc, string_type, SyntheticSourceLoc)],
					int_type,
					SyntheticSourceLoc,
				),
			),
		),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 4,
		loc = SyntheticSourceLoc
	}

	{
		decls = [FunctionDecl(read_func), FunctionDecl(render_func)],
		foreign_includes = []
	}


pure func test_emit_core_c_preserves_mutable_owner_cleanup() -> Bool:
	request: String = request_json(
		"emit_core_c",
		JsonObject([("core", core_program_to_json(bridge_mutable_string_pre_dce_program()))]),
	)

	match response_value(request):
		Some(response):
			code: String = artifact_string_field(response, "c_code")
			bool_field(response, "ok") and code.count("blorp_release(desc);") == 1
		None:
			False


pure func test_run_core_pipeline_tail_stage_returns_core_payload() -> Bool:
	option_core_program_equal(
		run_core_pipeline_response("post_closure_tail", bridge_loop_program()),
		expected_bridge_loop_program_after_tail_pipeline(),
	)


pure func test_run_core_pipeline_final_stage_returns_core_payload() -> Bool:
	option_core_program_equal(
		run_core_pipeline_response("final", bridge_loop_program()),
		expected_bridge_loop_program_after_tail_pipeline(),
	)


pure func test_run_core_pipeline_reuse_stage_returns_core_payload() -> Bool:
	option_core_program_equal(
		run_core_pipeline_response("reuse", bridge_loop_program()),
		bridge_loop_program(),
	)


pure func test_run_core_pipeline_consume_specialize_stage_returns_core_payload() -> Bool:
	option_core_program_equal(
		run_core_pipeline_response("consume_specialize", bridge_loop_program()),
		bridge_loop_program(),
