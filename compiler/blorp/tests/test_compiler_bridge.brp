import:
	../compiler_bridge: handle_request
	../compiler_core_json:
		CoreBinaryOp(AddOp),
		CoreDecl(FunctionDecl),
		CoreExpr(BinaryExpr, CooperativeCheckpointExpr, LiteralExpr, SeqExpr, VoidExpr, WhileExpr),
		CoreFunction,
		CoreFunctionKind(UserFunction),
		CoreLiteral(BoolLiteral, IntLiteral),
		CoreProgram,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType, VoidType),
		core_program_to_json,
		decode_core_program_json,
	json:
		JsonValue(JsonNumber, JsonObject, JsonString, JsonVector),
		as_array,
		as_bool,
		as_string,
		get_field,
		parse_json,
	test: TestSuite


pure func response_value(source: String) -> Option[JsonValue]:
	match parse_json(handle_request(source)):
		Ok(value):
			Some(value)
		Err(_):
			None


pure func bool_field(value: JsonValue, name: String) -> Bool:
	match get_field(value, name):
		Some(field):
			match as_bool(field):
				Some(b):
					b
				None:
					False
		None:
			False


pure func string_field(value: JsonValue, name: String) -> String:
	match get_field(value, name):
		Some(field):
			match as_string(field):
				Some(text):
					text
				None:
					""
		None:
			""


pure func error_code(value: JsonValue) -> String:
	match get_field(value, "error"):
		Some(error):
			string_field(error, "code")
		None:
			""


pure func first_rendered_item_text(value: JsonValue) -> String:
	match get_field(value, "items"):
		Some(items_value):
			match as_array(items_value):
				Some(items):
					match items.get(0):
						Some(item):
							string_field(item, "text")
						None:
							""
				None:
					""
		None:
			""


pure func artifact_string_field(value: JsonValue, name: String) -> String:
	match get_field(value, "artifact"):
		Some(artifact):
			string_field(artifact, name)
		None:
			""


pure func core_response(value: JsonValue) -> Option[CoreProgram]:
	match get_field(value, "core"):
		Some(core_json):
			match decode_core_program_json(core_json):
				Ok(program):
					Some(program)
				Err(error):
					None
		None:
			None


pure func core_programs_equal(left: CoreProgram, right: CoreProgram) -> Bool:
	core_program_to_json(left).to_string() == core_program_to_json(right).to_string()


pure func option_core_program_equal(left: Option[CoreProgram], right: CoreProgram) -> Bool:
	match left:
		Some(program):
			core_programs_equal(program, right)
		None:
			False


pure func request_json(action: String, payload: JsonValue) -> String:
	JsonObject([
		("schema", JsonNumber(1.0)),
		("domain", JsonString("compiler")),
		("action", JsonString(action)),
		("payload", payload),
	]).to_string()


pure func json_string_list(values: List[String]) -> JsonValue:
	var items: List[JsonValue] = []

	for value in values:
		items = items.append(JsonString(value))

	JsonVector(items)


pure func render_item_json(op: String, args: List[String]) -> JsonValue:
	JsonObject([
		("op", JsonString(op)),
		("args", json_string_list(args)),
	])


pure func render_many_payload_json(
	renderer: String,
	op: String,
	args: List[String],
) -> JsonValue:
	JsonObject([
		("renderer", JsonString(renderer)),
		("items", JsonVector([render_item_json(op, args)])),
	])


pure func render_many_request_json(
	renderer: String,
	op: String,
	args: List[String],
) -> String:
	request_json("render_many", render_many_payload_json(renderer, op, args))


pure func run_core_pipeline_response(
	stage: String,
	program: CoreProgram,
) -> Option[CoreProgram]:
	request: String = request_json("run_core_pipeline", JsonObject([
			("stage", JsonString(stage)),
			("core", core_program_to_json(program)),
		]))
	response ?= response_value(request)

	if bool_field(response, "ok"):
		core_response(response)
	else:
		None


pure func bridge_emit_program() -> CoreProgram:
	int_type = NamedType("Int", [])
	main_func: CoreFunction = {
		name = "main",
		source_module = None,
		type_params = [],
		params = [],
		return_type = int_type,
		body = Some(
			BinaryExpr(
				AddOp,
				LiteralExpr(IntLiteral(39), int_type, SyntheticSourceLoc),
				LiteralExpr(IntLiteral(3), int_type, SyntheticSourceLoc),
				int_type,
				SyntheticSourceLoc,
			),
		),
		is_pure = False,
		function_kind = UserFunction,
		def_id = 1,
		loc = SyntheticSourceLoc
	}

	{
		decls = [FunctionDecl(main_func)],
		foreign_includes = []
	}


pure func bridge_loop_program() -> CoreProgram:
	bool_type = NamedType("Bool", [])
	main_func: CoreFunction = {
		name = "main",
		source_module = None,
		type_params = [],
		params = [],
		return_type = VoidType,
		body = Some(
			WhileExpr(
				LiteralExpr(BoolLiteral(True), bool_type, SyntheticSourceLoc),
				VoidExpr(VoidType, SyntheticSourceLoc),
				VoidType,
				SyntheticSourceLoc,
			),
		),
		is_pure = False,
		function_kind = UserFunction,
		def_id = 4,
		loc = SyntheticSourceLoc
	}

	{
		decls = [FunctionDecl(main_func)],
		foreign_includes = []
	}


pure func expected_bridge_loop_program_after_tail_pipeline() -> CoreProgram:
	bool_type = NamedType("Bool", [])
	main_func: CoreFunction = {
		name = "main",
		source_module = None,
		type_params = [],
		params = [],
		return_type = VoidType,
		body = Some(
			WhileExpr(
				LiteralExpr(BoolLiteral(True), bool_type, SyntheticSourceLoc),
				SeqExpr(
					CooperativeCheckpointExpr(VoidType, SyntheticSourceLoc),
					VoidExpr(VoidType, SyntheticSourceLoc),
				),
				VoidType,
				SyntheticSourceLoc,
			),
		),
		is_pure = False,
		function_kind = UserFunction,
		def_id = 4,
		loc = SyntheticSourceLoc
	}

	{
		decls = [FunctionDecl(main_func)],
		foreign_includes = []
	}


pure func test_render_payload_request() -> Bool:
	request: String = render_many_request_json(
		"core_stage",
		"core_stage_unknown_error",
		["monot", "monot"],
	)

	match response_value(request):
		Some(response):
			(
				bool_field(response, "ok")
				and first_rendered_item_text(
					response,
				) == "unknown stage \"monot\" (did you mean \"mono\"?) (valid: ${expected_core_stage_names()})"
			)
		None:
			False


pure func test_render_many_request() -> Bool:
	request: String = render_many_request_json(
		"core_stage",
		"core_stage_unknown_error",
		["monot", "monot"],
	)

	match response_value(request):
		Some(response):
			(
				bool_field(response, "ok")
				and first_rendered_item_text(
					response,
				) == "unknown stage \"monot\" (did you mean \"mono\"?) (valid: ${expected_core_stage_names()})"
			)
		None:
			False


pure func test_render_core_error_request() -> Bool:
	request: String = render_many_request_json(
		"core_error",
		"core_error_format",
		["lower", "expression missing type", "12", "8", "some", "run Infer.infer first"],
	)

	match response_value(request):
		Some(response):
			(
				bool_field(response, "ok")
				and first_rendered_item_text(
					response,
				) == "lower: expression missing type at 12:8\n  hint: run Infer.infer first"
			)
		None:
			False


pure func expected_core_stage_names() -> String:
	|lower, debug, desugar, mono, synth, match, trait_resolve, resolve, std_inline, tailrec, fusion, specialize, dce, consume_specialize, perceus, reuse, closure, final


pure func expected_core_profile_table() -> String:
	table: String =
		|phase      ms      %
		|--------------------
		|lower*    1.5   33.3
		|mono      3.0   66.7
		|--------------------
		|total     4.5  100.0
		|* first entry includes work before the first stage callback
	table + "\n"


pure func test_render_core_profile_request() -> Bool:
	profile_entries: String =
		|core	lower	1.5
		|core	mono	3.0
	request: String = render_many_request_json(
		"core_profile",
		"core_profile_format",
		[profile_entries],
	)

	match response_value(request):
		Some(response):
			(
				bool_field(response, "ok")
				and first_rendered_item_text(response) == expected_core_profile_table()
			)
		None:
			False


pure func test_render_core_stage_request() -> Bool:
	request: String = render_many_request_json(
		"core_stage",
		"core_stage_unknown_error",
		["monot", "monot"],
	)

	match response_value(request):
		Some(response):
			(
				bool_field(response, "ok")
				and first_rendered_item_text(
					response,
				) == "unknown stage \"monot\" (did you mean \"mono\"?) (valid: ${expected_core_stage_names()})"
			)
		None:
			False


pure func test_render_core_trait_resolve_request() -> Bool:
	request: String = render_many_request_json(
		"core_trait_resolve",
		"core_trait_resolve_no_impl_hint",
		["to_string", "Widgit", "Gadget;Widget"],
	)

	match response_value(request):
		Some(response):
			bool_field(response, "ok") and first_rendered_item_text(
				response,
			) == "did you mean to call it on a Widget? Or add `implements <trait> for Widgit:` defining `to_string`."
		None:
			False


pure func test_emit_post_closure_c_core_payload_request() -> Bool:
	request: String = request_json(
		"emit_post_closure_c",
		JsonObject([("core", core_program_to_json(bridge_emit_program()))]),
	)

	match response_value(request):
		Some(response):
			(
				bool_field(response, "ok")
				and artifact_string_field(response, "c_code").contains("int main(void)")
				and artifact_string_field(response, "c_code").contains("return (39 + 3);")
			)
		None:
			False


pure func test_run_core_pipeline_tail_stage_returns_core_payload() -> Bool:
	option_core_program_equal(
		run_core_pipeline_response("post_closure_tail", bridge_loop_program()),
		expected_bridge_loop_program_after_tail_pipeline(),
	)


pure func test_run_core_pipeline_final_stage_returns_core_payload() -> Bool:
	option_core_program_equal(
		run_core_pipeline_response("final", bridge_loop_program()),
		expected_bridge_loop_program_after_tail_pipeline(),
	)


pure func test_run_core_pipeline_reuse_stage_returns_core_payload() -> Bool:
	option_core_program_equal(
		run_core_pipeline_response("reuse", bridge_loop_program()),
		bridge_loop_program(),
	)


pure func test_prepared_emit_action_is_not_supported() -> Bool:
	request: String = request_json(
		"emit_c",
		JsonObject([("core", core_program_to_json(bridge_emit_program()))]),
	)

	match response_value(request):
		Some(response):
			not bool_field(response, "ok") and error_code(response) == "unsupported_action"
		None:
			False


pure func test_dispatch_errors_are_structured() -> Bool:
	bad_renderer: String = render_many_request_json("missing", "whatever", [])

	bad_op: String = render_many_request_json("core_stage", "missing", [])

	bad_renderer_ok: Bool = match response_value(bad_renderer):
		Some(response):
			not bool_field(response, "ok") and error_code(response) == "unsupported_renderer"
		None:
			False

	bad_op_ok: Bool = match response_value(bad_op):
		Some(response):
			not bool_field(response, "ok") and error_code(response) == "render_error"
		None:
			False

	bad_renderer_ok and bad_op_ok


pure func test_legacy_top_level_renderer_fields_are_rejected() -> Bool:
	request: String = JsonObject([
		("schema", JsonNumber(1.0)),
		("domain", JsonString("compiler")),
		("action", JsonString("render_many")),
		("renderer", JsonString("core_stage")),
		(
			"items",
			JsonVector([render_item_json("core_stage_unknown_error", ["monot", "monot"])]),
		),
	]).to_string()

	match response_value(request):
		Some(response):
			not bool_field(response, "ok") and error_code(response) == "invalid_request"
		None:
			False


pure func test_future_stage_actions_are_explicitly_unsupported() -> Bool:
	(
		unsupported_action_ok("lower_and_compile")
		and unsupported_action_ok("typecheck_and_compile")
		and unsupported_action_ok("compile_source")
	)


pure func unsupported_action_ok(action: String) -> Bool:
	request: String = request_json(action, JsonObject([("core", JsonString("{}"))]))

	match response_value(request):
		Some(response):
			not bool_field(response, "ok") and error_code(response) == "unsupported_action"
		None:
			False


tests: TestSuite = {
	description = "Blorp compiler bridge dispatcher",
	tests = [
		("render payload request", test_render_payload_request),
		("render many request", test_render_many_request),
		("render core error request", test_render_core_error_request),
		("render core profile request", test_render_core_profile_request),
		("render core stage request", test_render_core_stage_request),
		("render core trait resolve request", test_render_core_trait_resolve_request),
		("emit_post_closure_c Core payload request", test_emit_post_closure_c_core_payload_request),
		(
			"run_core_pipeline tail stage returns Core payload",
			test_run_core_pipeline_tail_stage_returns_core_payload,
		),
		(
			"run_core_pipeline final stage returns Core payload",
			test_run_core_pipeline_final_stage_returns_core_payload,
		),
		(
			"run_core_pipeline reuse stage returns Core payload",
			test_run_core_pipeline_reuse_stage_returns_core_payload,
		),
		("prepared emit action is not supported", test_prepared_emit_action_is_not_supported),
		("dispatch errors are structured", test_dispatch_errors_are_structured),
		(
			"legacy top level renderer fields are rejected",
			test_legacy_top_level_renderer_fields_are_rejected,
		),
		(
			"future stage actions are explicitly unsupported",
			test_future_stage_actions_are_explicitly_unsupported,
		),
	]
}
