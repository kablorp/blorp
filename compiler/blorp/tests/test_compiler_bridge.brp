import:
	../compiler_bridge: handle_request
	../compiler_core_json:
		CoreBinaryOp(AddOp),
		CoreCallKind(UserCall),
		CoreDecl(FunctionDecl, GlobalDecl),
		CoreExpr(
			BinaryExpr,
			CallExpr,
			CooperativeCheckpointExpr,
			LiteralExpr,
			SeqExpr,
			TailrecRecurExpr,
			VarExpr,
			VoidExpr,
			WhileExpr,
		),
		CoreFunction,
		CoreFunctionKind(UserFunction),
		CoreGlobal,
		CoreLiteral(BoolLiteral, IntLiteral),
		CoreParam,
		CoreProgram,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType, VoidType),
		CoreVar,
		core_program_to_json,
		decode_core_program_json,
	json:
		JsonValue(JsonBool, JsonNull, JsonNumber, JsonObject, JsonString, JsonVector),
		as_array,
		as_bool,
		as_string,
		get_field,
		parse_json,
	test: TestSuite


pure func response_value(source: String) -> Option[JsonValue]:
	match parse_json(handle_request(source)):
		Ok(value):
			Some(value)
		Err(_):
			None


pure func bool_field(value: JsonValue, name: String) -> Bool:
	match get_field(value, name):
		Some(field):
			match as_bool(field):
				Some(b):
					b
				None:
					False
		None:
			False


pure func string_field(value: JsonValue, name: String) -> String:
	match get_field(value, name):
		Some(field):
			match as_string(field):
				Some(text):
					text
				None:
					""
		None:
			""


pure func error_code(value: JsonValue) -> String:
	match get_field(value, "error"):
		Some(error):
			string_field(error, "code")
		None:
			""


pure func error_message(value: JsonValue) -> String:
	match get_field(value, "error"):
		Some(error):
			string_field(error, "message")
		None:
			""


pure func first_rendered_item_text(value: JsonValue) -> String:
	match get_field(value, "items"):
		Some(items_value):
			match as_array(items_value):
				Some(items):
					match items.get(0):
						Some(item):
							string_field(item, "text")
						None:
							""
				None:
					""
		None:
			""


pure func int_field(value: JsonValue, name: String) -> Int:
	match get_field(value, name):
		Some(field):
			match field:
				JsonNumber(number):
					to_int(number)
				JsonNull:
					-1
				JsonBool(flag):
					-1
				JsonString(text):
					-1
				JsonVector(items):
					-1
				JsonObject(fields):
					-1
		None:
			-1


pure func artifact_string_field(value: JsonValue, name: String) -> String:
	match get_field(value, "artifact"):
		Some(artifact):
			string_field(artifact, name)
		None:
			""


pure func artifact_array_length(value: JsonValue, name: String) -> Int:
	match get_field(value, "artifact"):
		Some(artifact):
			match get_field(artifact, name):
				Some(field):
					match as_array(field):
						Some(items):
							items.length()
						None:
							-1
				None:
					-1
		None:
			-1


pure func core_response(value: JsonValue) -> Option[CoreProgram]:
	match get_field(value, "core"):
		Some(core_json):
			match decode_core_program_json(core_json):
				Ok(program):
					Some(program)
				Err(error):
					None
		None:
			None


pure func core_programs_equal(left: CoreProgram, right: CoreProgram) -> Bool:
	core_program_to_json(left).to_string() == core_program_to_json(right).to_string()


pure func request_json(action: String, payload: JsonValue) -> String:
	JsonObject([
		("schema", JsonNumber(1.0)),
		("domain", JsonString("compiler")),
		("action", JsonString(action)),
		("payload", payload),
	]).to_string()


pure func bridge_emit_program() -> CoreProgram:
	int_type = NamedType("Int", [])
	main_func: CoreFunction = {
		name = "main",
		source_module = None,
		type_params = [],
		params = [],
		return_type = int_type,
		body = Some(
			BinaryExpr(
				AddOp,
				LiteralExpr(IntLiteral(39), int_type, SyntheticSourceLoc),
				LiteralExpr(IntLiteral(3), int_type, SyntheticSourceLoc),
				int_type,
				SyntheticSourceLoc,
			),
		),
		is_pure = False,
		function_kind = UserFunction,
		def_id = 1,
		loc = SyntheticSourceLoc
	}

	{
		decls = [FunctionDecl(main_func)],
		foreign_includes = []
	}


pure func unsupported_global_init_program() -> CoreProgram:
	int_type = NamedType("Int", [])
	global_var: CoreVar = {
		name = "BAD_GLOBAL",
		uniq = 0,
		def_id = Some(91)
	}
	global: CoreGlobal = {
		name = global_var,
		typ = int_type,
		init = TailrecRecurExpr([], int_type, SyntheticSourceLoc),
		is_mutable = False,
		is_const = True,
		def_id = 91,
		loc = SyntheticSourceLoc
	}
	main_func: CoreFunction = {
		name = "main",
		source_module = None,
		type_params = [],
		params = [],
		return_type = int_type,
		body = Some(LiteralExpr(IntLiteral(0), int_type, SyntheticSourceLoc)),
		is_pure = False,
		function_kind = UserFunction,
		def_id = 92,
		loc = SyntheticSourceLoc
	}

	{
		decls = [GlobalDecl(global), FunctionDecl(main_func)],
		foreign_includes = []
	}


pure func bridge_param_x() -> CoreVar:
	{
		name = "x",
		uniq = 0,
		def_id = None
	}


pure func bridge_identity_func(int_type: CoreType) -> CoreFunction:
	param: CoreParam = {
		name = bridge_param_x(),
		typ = int_type,
		loc = SyntheticSourceLoc
	}

	{
		name = "id",
		source_module = None,
		type_params = [],
		params = [param],
		return_type = int_type,
		body = Some(VarExpr(bridge_param_x(), int_type, SyntheticSourceLoc)),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 2,
		loc = SyntheticSourceLoc
	}


pure func bridge_call_program() -> CoreProgram:
	int_type = NamedType("Int", [])
	id_var: CoreVar = {
		name = "id",
		uniq = 0,
		def_id = Some(2)
	}
	main_func: CoreFunction = {
		name = "main",
		source_module = None,
		type_params = [],
		params = [],
		return_type = int_type,
		body = Some(
			CallExpr(
				UserCall("id", Some(2), []),
				VarExpr(id_var, int_type, SyntheticSourceLoc),
				[LiteralExpr(IntLiteral(41), int_type, SyntheticSourceLoc)],
				int_type,
				SyntheticSourceLoc,
			),
		),
		is_pure = False,
		function_kind = UserFunction,
		def_id = 3,
		loc = SyntheticSourceLoc
	}

	{
		decls = [FunctionDecl(bridge_identity_func(int_type)), FunctionDecl(main_func)],
		foreign_includes = []
	}


pure func bridge_loop_program() -> CoreProgram:
	bool_type = NamedType("Bool", [])
	main_func: CoreFunction = {
		name = "main",
		source_module = None,
		type_params = [],
		params = [],
		return_type = VoidType,
		body = Some(
			WhileExpr(
				LiteralExpr(BoolLiteral(True), bool_type, SyntheticSourceLoc),
				VoidExpr(VoidType, SyntheticSourceLoc),
				VoidType,
				SyntheticSourceLoc,
			),
		),
		is_pure = False,
		function_kind = UserFunction,
		def_id = 4,
		loc = SyntheticSourceLoc
	}

	{
		decls = [FunctionDecl(main_func)],
		foreign_includes = []
	}


pure func expected_bridge_loop_program_after_tail_pipeline() -> CoreProgram:
	bool_type = NamedType("Bool", [])
	main_func: CoreFunction = {
		name = "main",
		source_module = None,
		type_params = [],
		params = [],
		return_type = VoidType,
		body = Some(
			WhileExpr(
				LiteralExpr(BoolLiteral(True), bool_type, SyntheticSourceLoc),
				SeqExpr(
					CooperativeCheckpointExpr(VoidType, SyntheticSourceLoc),
					VoidExpr(VoidType, SyntheticSourceLoc),
				),
				VoidType,
				SyntheticSourceLoc,
			),
		),
		is_pure = False,
		function_kind = UserFunction,
		def_id = 4,
		loc = SyntheticSourceLoc
	}

	{
		decls = [FunctionDecl(main_func)],
		foreign_includes = []
	}


pure func test_render_payload_request() -> Bool:
	request: String = "{\"schema\":1,\"domain\":\"compiler\",\"action\":\"render\"," + "\"payload\":{\"renderer\":\"prepared_tuple\",\"op\":\"backend_tuple_name\"," + "\"args\":[\"7\"]}}"

	match response_value(request):
		Some(response):
			bool_field(response, "ok") and string_field(response, "text") == "__tup_7"
		None:
			False


pure func test_render_many_request() -> Bool:
	request: String = "{\"schema\":1,\"domain\":\"compiler\",\"action\":\"render_many\"," + "\"payload\":{\"renderer\":\"prepared_tuple\",\"items\":[" + "{\"op\":\"backend_tuple_name\",\"args\":[\"2\"]}," + "{\"op\":\"backend_tuple_arg\",\"args\":[\"value\"]}]}}"

	match response_value(request):
		Some(response):
			bool_field(response, "ok") and first_rendered_item_text(response) == "__tup_2"
		None:
			False


pure func test_render_core_error_request() -> Bool:
	request: String = "{\"schema\":1,\"domain\":\"compiler\",\"action\":\"render\"," + "\"payload\":{\"renderer\":\"core_error\",\"op\":\"core_error_format\"," + "\"args\":[\"lower\",\"expression missing type\",\"12\",\"8\",\"some\",\"run Infer.infer first\"]}}"

	match response_value(request):
		Some(response):
			(
				bool_field(response, "ok")
				and string_field(
					response,
					"text",
				) == "lower: expression missing type at 12:8\n  hint: run Infer.infer first"
			)
		None:
			False


pure func expected_core_stage_names() -> String:
	(
		"lower, debug, desugar, mono, synth, match, trait_resolve, resolve, std_inline, "
		+ "tailrec, fusion, specialize, dce, consume_specialize, perceus, reuse, closure, "
		+ "final"
	)


pure func expected_core_profile_table() -> String:
	"phase      ms      %\n" + "--------------------\n" + "lower*    1.5   33.3\n" + "mono      3.0   66.7\n" + "--------------------\n" + "total     4.5  100.0\n" + "* first entry includes work before the first stage callback\n"


pure func test_render_core_profile_request() -> Bool:
	request: String = "{\"schema\":1,\"domain\":\"compiler\",\"action\":\"render\"," + "\"payload\":{\"renderer\":\"core_profile\",\"op\":\"core_profile_format\"," + "\"args\":[\"core\\tlower\\t1.5\\ncore\\tmono\\t3.0\"]}}"

	match response_value(request):
		Some(response):
			(
				bool_field(response, "ok")
				and string_field(response, "text") == expected_core_profile_table()
			)
		None:
			False


pure func test_render_core_stage_request() -> Bool:
	request: String = "{\"schema\":1,\"domain\":\"compiler\",\"action\":\"render\"," + "\"payload\":{\"renderer\":\"core_stage\",\"op\":\"core_stage_unknown_error\"," + "\"args\":[\"monot\",\"monot\"]}}"

	match response_value(request):
		Some(response):
			(
				bool_field(response, "ok")
				and string_field(
					response,
					"text",
				) == "unknown stage \"monot\" (did you mean \"mono\"?) (valid: " + expected_core_stage_names() + ")"
			)
		None:
			False


pure func test_render_core_trait_resolve_request() -> Bool:
	request: String = "{\"schema\":1,\"domain\":\"compiler\",\"action\":\"render\"," + "\"payload\":{\"renderer\":\"core_trait_resolve\",\"op\":\"core_trait_resolve_no_impl_hint\"," + "\"args\":[\"to_string\",\"Widgit\",\"Gadget;Widget\"]}}"

	match response_value(request):
		Some(response):
			bool_field(response, "ok") and string_field(response, "text") == (
				"did you mean to call it on a Widget? Or add `implements <trait> for Widgit:` "
				+ "defining `to_string`."
			)
		None:
			False


pure func template_items_contain(response: JsonValue, op: String, arity: Int) -> Bool:
	match get_field(response, "items"):
		Some(items_value):
			match as_array(items_value):
				Some(items):
					var found: Bool = False

					for item in items:
						if string_field(item, "op") == op and int_field(item, "arity") == arity:
							found = True

					found
				None:
					False
		None:
			False


pure func test_renderer_templates_request() -> Bool:
	request: String = "{\"schema\":1,\"domain\":\"compiler\",\"action\":\"renderer_templates\"," + "\"payload\":{\"renderer\":\"intrinsic\"}}"

	match response_value(request):
		Some(response):
			(
				bool_field(response, "ok")
				and template_items_contain(response, "math_sqrt", 1)
				and template_items_contain(response, "math_fma", 3)
			)
		None:
			False


pure func test_render_prepared_list_checked_load_request() -> Bool:
	request: String = "{\"schema\":1,\"domain\":\"compiler\",\"action\":\"render\"," + "\"payload\":{\"renderer\":\"prepared_list\",\"op\":\"list_inline_struct_load_checked\"," + "\"args\":[\"__list\",\"__idx\",\"__out\",\"0\",\"Small\"]}}"

	match response_value(request):
		Some(response):
			bool_field(response, "ok") and string_field(response, "text") == (
				"if (__builtin_expect(!__list || __idx < 0 || __idx >= __list->len, 0)) { "
				+ "memset(&__out, 0, sizeof(Small)); } else if (__list->storage_mode == "
				+ "BLORP_LIST_STORAGE_INLINE && __list->elem_size == (int16_t)sizeof(Small)) { "
				+ "memcpy(&__out, (char*)__list->data + __idx * sizeof(Small), sizeof(Small)); } "
				+ "else { void* __lg_raw_0 = blorp_list_get(__list, __idx); if (!__lg_raw_0) { "
				+ "memset(&__out, 0, sizeof(Small)); } else { __out = "
				+ "blorp_unbox_struct(__lg_raw_0, Small); } }"
			)
		None:
			False


pure func test_emit_c_core_payload_request() -> Bool:
	request: String = request_json(
		"emit_c",
		JsonObject([("core", core_program_to_json(bridge_emit_program()))]),
	)

	match response_value(request):
		Some(response):
			(
				bool_field(response, "ok")
				and artifact_string_field(response, "c_code").contains("int main(void)")
				and artifact_string_field(response, "c_code").contains("return (39 + 3);")
				and artifact_array_length(response, "link_flags") == 0
				and artifact_array_length(response, "include_dirs") == 0
			)
		None:
			False


pure func test_emit_c_core_call_payload_request() -> Bool:
	request: String = request_json(
		"emit_c",
		JsonObject([("core", core_program_to_json(bridge_call_program()))]),
	)

	match response_value(request):
		Some(response):
			(
				bool_field(response, "ok")
				and artifact_string_field(response, "c_code").contains("long id(long x)")
				and artifact_string_field(response, "c_code").contains("return id(41);")
			)
		None:
			False


pure func test_prepare_and_emit_c_core_payload_request() -> Bool:
	request: String = request_json(
		"prepare_and_emit_c",
		JsonObject([("core", core_program_to_json(bridge_emit_program()))]),
	)

	match response_value(request):
		Some(response):
			(
				bool_field(response, "ok")
				and artifact_string_field(response, "c_code").contains("int main(void)")
				and artifact_string_field(response, "c_code").contains("return (39 + 3);")
			)
		None:
			False


pure func test_run_core_pipeline_tail_stage_returns_core_payload() -> Bool:
	request: String = request_json("run_core_pipeline", JsonObject([
			("stage", JsonString("tail_resource_fairness_prepare")),
			("core", core_program_to_json(bridge_loop_program())),
		]))

	match response_value(request):
		Some(response):
			if bool_field(response, "ok"):
				match core_response(response):
					Some(program):
						core_programs_equal(
							program,
							expected_bridge_loop_program_after_tail_pipeline(),
						)
					None:
						False
			else:
				False
		None:
			False


pure func test_emit_c_rejects_invalid_core_payload() -> Bool:
	request: String = request_json(
		"emit_c",
		JsonObject([("core", JsonObject([("kind", JsonString("not_program"))]))]),
	)

	match response_value(request):
		Some(response):
			not bool_field(response, "ok") and error_code(response) == "invalid_request"
		None:
			False


pure func test_emit_c_rejects_legacy_artifact_payload() -> Bool:
	request: String = "{\"schema\":1,\"domain\":\"compiler\",\"action\":\"emit_c\"," + "\"payload\":{\"c_code\":\"int main(void) { return 0; }\\n\"," + "\"link_flags\":[\"-lm\"],\"include_dirs\":[\"runtime/include\"]}}"

	match response_value(request):
		Some(response):
			not bool_field(response, "ok") and error_code(response) == "invalid_request"
		None:
			False


pure func test_emit_c_rejects_unsupported_emission() -> Bool:
	request: String = request_json(
		"emit_c",
		JsonObject([("core", core_program_to_json(unsupported_global_init_program()))]),
	)

	match response_value(request):
		Some(response):
			(
				not bool_field(response, "ok")
				and error_code(response) == "emit_error"
				and error_message(response).contains("unsupported global initializer")
			)
		None:
			False


pure func test_dispatch_errors_are_structured() -> Bool:
	bad_renderer: String = "{\"schema\":1,\"domain\":\"compiler\",\"action\":\"render\"," + "\"payload\":{\"renderer\":\"missing\",\"op\":\"whatever\",\"args\":[]}}"

	bad_op: String = "{\"schema\":1,\"domain\":\"compiler\",\"action\":\"render\"," + "\"payload\":{\"renderer\":\"prepared_tuple\",\"op\":\"missing\",\"args\":[]}}"

	bad_renderer_ok: Bool = match response_value(bad_renderer):
		Some(response):
			not bool_field(response, "ok") and error_code(response) == "unsupported_renderer"
		None:
			False

	bad_op_ok: Bool = match response_value(bad_op):
		Some(response):
			not bool_field(response, "ok") and error_code(response) == "render_error"
		None:
			False

	bad_renderer_ok and bad_op_ok


pure func test_legacy_top_level_renderer_fields_are_rejected() -> Bool:
	request: String = "{\"schema\":1,\"domain\":\"compiler\",\"action\":\"render\"," + "\"renderer\":\"prepared_tuple\",\"op\":\"backend_tuple_name\",\"args\":[\"2\"]}"

	match response_value(request):
		Some(response):
			not bool_field(response, "ok") and error_code(response) == "invalid_request"
		None:
			False


pure func test_future_stage_actions_are_explicitly_unsupported() -> Bool:
	(
		unsupported_action_ok("lower_and_compile")
		and unsupported_action_ok("typecheck_and_compile")
		and unsupported_action_ok("compile_source")
	)


pure func unsupported_action_ok(action: String) -> Bool:
	request: String = "{\"schema\":1,\"domain\":\"compiler\",\"action\":\"" + action + "\"," + "\"payload\":{\"core\":\"{}\"}}"

	match response_value(request):
		Some(response):
			not bool_field(response, "ok") and error_code(response) == "unsupported_action"
		None:
			False


tests: TestSuite = {
	description = "Blorp compiler bridge dispatcher",
	tests = [
		("render payload request", test_render_payload_request),
		("render many request", test_render_many_request),
		("render core error request", test_render_core_error_request),
		("render core profile request", test_render_core_profile_request),
		("render core stage request", test_render_core_stage_request),
		("render core trait resolve request", test_render_core_trait_resolve_request),
		("renderer templates request", test_renderer_templates_request),
		(
			"render prepared list checked load request",
			test_render_prepared_list_checked_load_request,
		),
		("emit_c Core payload request", test_emit_c_core_payload_request),
		("emit_c Core call payload request", test_emit_c_core_call_payload_request),
		("prepare_and_emit_c Core payload request", test_prepare_and_emit_c_core_payload_request),
		(
			"run_core_pipeline tail stage returns Core payload",
			test_run_core_pipeline_tail_stage_returns_core_payload,
		),
		("emit_c rejects invalid Core payload", test_emit_c_rejects_invalid_core_payload),
		("emit_c rejects legacy artifact payload", test_emit_c_rejects_legacy_artifact_payload),
		("emit_c rejects unsupported emission", test_emit_c_rejects_unsupported_emission),
		("dispatch errors are structured", test_dispatch_errors_are_structured),
		(
			"legacy top level renderer fields are rejected",
			test_legacy_top_level_renderer_fields_are_rejected,
		),
		(
			"future stage actions are explicitly unsupported",
			test_future_stage_actions_are_explicitly_unsupported,
		),
	]
}
