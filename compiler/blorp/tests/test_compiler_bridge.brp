	description = "Blorp compiler bridge dispatcher",
	tests = [
		("render payload request", test_render_payload_request),
		("render many request", test_render_many_request),
		("render core stage request", test_render_core_stage_request),
		("render core trait resolve request", test_render_core_trait_resolve_request),
		("emit_core_c Core payload request", test_emit_core_c_core_payload_request),
		(
			"emit_core_c preserves mutable owner cleanup",
			test_emit_core_c_preserves_mutable_owner_cleanup,
		),
		(
			"run_core_pipeline tail stage returns Core payload",
			test_run_core_pipeline_tail_stage_returns_core_payload,
		),
		(
			"run_core_pipeline final stage returns Core payload",
			test_run_core_pipeline_final_stage_returns_core_payload,
		),
		(
			"run_core_pipeline reuse stage returns Core payload",
			test_run_core_pipeline_reuse_stage_returns_core_payload,
		),
		(
			"run_core_pipeline consume_specialize stage returns Core payload",
			test_run_core_pipeline_consume_specialize_stage_returns_core_payload,
		),
		("prepared emit action is not supported", test_prepared_emit_action_is_not_supported),
		("backend bridge rejects frontend actions", test_backend_bridge_rejects_frontend_actions),
		("parser bridge rejects backend actions", test_parser_bridge_rejects_backend_actions),
		(
			"parser bridge rejects typecheck_source action",
			test_parser_bridge_rejects_typecheck_source_action,
		),
		("dispatch errors are structured", test_dispatch_errors_are_structured),
		(
			"legacy top level renderer fields are rejected",
			test_legacy_top_level_renderer_fields_are_rejected,
		),
		("parse_source returns parsed AST artifact", test_parse_source_returns_parsed_ast_artifact),
		(
			"parse_source preserves raw UTF-8 string literals",
			test_parse_source_preserves_raw_utf8_string_literals,
		),
		(
			"parse_source typecheck artifact includes module surface",
			test_parse_source_typecheck_artifact_includes_module_surface,
		),
		("parse_source accepts typecheck AST phase", test_parse_source_accepts_typecheck_ast_phase),
		(
			"parse_source raw phase keeps raw string interpolation",
			test_parse_source_raw_phase_keeps_raw_string_interpolation,
		),
		(
			"parse_source typecheck phase hoists nested function",
			test_parse_source_typecheck_phase_hoists_nested_function,
		),
		(
			"parse_source raw phase keeps nested function",
			test_parse_source_raw_phase_keeps_nested_function,
		),
		(
			"parse_source typecheck phase rewrites subscript read",
			test_parse_source_typecheck_phase_rewrites_subscript_read,
		),
		(
			"parse_source raw phase keeps subscript read",
			test_parse_source_raw_phase_keeps_subscript_read,
		),
		(
			"parse_sources returns ordered AST artifacts",
			test_parse_sources_returns_ordered_ast_artifacts,
		),
		(
			"parse_sources typecheck artifacts include module surface",
			test_parse_sources_typecheck_artifacts_include_module_surface,
		),
		(
			"parse_sources accepts shared typecheck AST phase",
			test_parse_sources_accepts_shared_typecheck_ast_phase,
		),
		("CLI parse_source reads path payload", test_cli_parse_source_reads_path_payload),
		("CLI parse_source reports missing path", test_cli_parse_source_reports_missing_path),
		(
			"future stage actions are explicitly unsupported",
