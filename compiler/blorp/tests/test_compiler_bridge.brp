import:
	../compiler_bridge: handle_request
	json:
		JsonValue(JsonBool, JsonNumber, JsonObject, JsonString, JsonVector),
		as_array,
		as_bool,
		as_number,
		as_string,
		get_field,
		parse_json,
	test: TestSuite


func response_value(source: String) -> Option[JsonValue]:
	match parse_json(handle_request(source)):
		Ok(value):
			Some(value)
		Err(_):
			None


func bool_field(value: JsonValue, name: String) -> Bool:
	match get_field(value, name):
		Some(field):
			match as_bool(field):
				Some(b):
					b
				None:
					False
		None:
			False


func string_field(value: JsonValue, name: String) -> String:
	match get_field(value, name):
		Some(field):
			match as_string(field):
				Some(text):
					text
				None:
					""
		None:
			""


func int_field(value: JsonValue, name: String) -> Int:
	match get_field(value, name):
		Some(field):
			match as_number(field):
				Some(number):
					to_int(number)
				None:
					0
		None:
			0


func error_code(value: JsonValue) -> String:
	match get_field(value, "error"):
		Some(error):
			string_field(error, "code")
		None:
			""


func names_contain(value: JsonValue, expected: String) -> Bool:
	match get_field(value, "names"):
		Some(names_value):
			match as_array(names_value):
				Some(names):
					var found: Bool = False

					for item in names:
						match as_string(item):
							Some(name):
								if name == expected:
									found = True
							None:
								void

					found
				None:
					False
		None:
			False


func first_rendered_item_text(value: JsonValue) -> String:
	match get_field(value, "items"):
		Some(items_value):
			match as_array(items_value):
				Some(items):
					match items.get(0):
						Some(item):
							string_field(item, "text")
						None:
							""
				None:
					""
		None:
			""


func test_render_static_constant_request() -> Bool:
	request: String = "{\"schema\":1,\"domain\":\"compiler\",\"action\":\"render\"," + "\"renderer\":\"static_constant\",\"op\":\"static_string_global_pointer\"," + "\"args\":[\"GREETING\",\"__blorp_static_string_GREETING\"]}"

	match response_value(request):
		Some(response):
			(
				bool_field(response, "ok")
				and string_field(
					response,
					"text",
				) == "static blorp_String* GREETING = (blorp_String*)&__blorp_static_string_GREETING;"
			)
		None:
			False


func test_render_payload_request() -> Bool:
	request: String = "{\"schema\":1,\"domain\":\"compiler\",\"action\":\"render\"," + "\"payload\":{\"renderer\":\"prepared_tuple\",\"op\":\"backend_tuple_name\"," + "\"args\":[\"7\"]}}"

	match response_value(request):
		Some(response):
			bool_field(response, "ok") and string_field(response, "text") == "__tup_7"
		None:
			False


func test_render_many_request() -> Bool:
	request: String = "{\"schema\":1,\"domain\":\"compiler\",\"action\":\"render_many\"," + "\"renderer\":\"prepared_tuple\",\"items\":[" + "{\"op\":\"backend_tuple_name\",\"args\":[\"2\"]}," + "{\"op\":\"backend_tuple_arg\",\"args\":[\"value\"]}]}"

	match response_value(request):
		Some(response):
			bool_field(response, "ok") and first_rendered_item_text(response) == "__tup_2"
		None:
			False


func test_list_ops_request() -> Bool:
	request: String = "{\"schema\":1,\"domain\":\"compiler\",\"action\":\"list_ops\"," + "\"renderer\":\"language_surface\"}"

	match response_value(request):
		Some(response):
			(
				bool_field(response, "ok")
				and names_contain(response, "language_lsp_completion_keywords")
			)
		None:
			False


func test_template_arity_request() -> Bool:
	request: String = "{\"schema\":1,\"domain\":\"compiler\",\"action\":\"template_arity\"," + "\"renderer\":\"prepared_tuple\",\"op\":\"backend_tuple_construct\"}"

	match response_value(request):
		Some(response):
			bool_field(response, "ok") and int_field(response, "arity") == 2
		None:
			False


func test_dispatch_errors_are_structured() -> Bool:
	bad_renderer: String = "{\"schema\":1,\"domain\":\"compiler\",\"action\":\"list_ops\"," + "\"renderer\":\"missing\"}"

	bad_op: String = "{\"schema\":1,\"domain\":\"compiler\",\"action\":\"template_arity\"," + "\"renderer\":\"prepared_tuple\",\"op\":\"missing\"}"

	bad_renderer_ok: Bool = match response_value(bad_renderer):
		Some(response):
			not bool_field(response, "ok") and error_code(response) == "unsupported_renderer"
		None:
			False

	bad_op_ok: Bool = match response_value(bad_op):
		Some(response):
			not bool_field(response, "ok") and error_code(response) == "unsupported_op"
		None:
			False

	bad_renderer_ok and bad_op_ok


tests: TestSuite = {
	description = "Blorp compiler bridge dispatcher",
	tests = [
		("render static constant request", test_render_static_constant_request),
		("render payload request", test_render_payload_request),
		("render many request", test_render_many_request),
		("list ops request", test_list_ops_request),
		("template arity request", test_template_arity_request),
		("dispatch errors are structured", test_dispatch_errors_are_structured),
	]
}
