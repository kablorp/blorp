import:
	../src/stage_09_core/trait_resolve_diagnostics: render_core_trait_no_impl_hint
	test: TestSuite


private EXPECTED_SUGGESTION_HINT: String = (
	"did you mean to call it on a Widget? Or add `implements <trait> for Widgit:` "
	+ "defining `to_string`."
)

private EXPECTED_CANDIDATES_HINT: String = (
	"types with an `add` impl in scope: Bool, String. Add `implements <trait> for "
	+ "Vector:` to extend it."
)

private EXPECTED_EMPTY_HINT: String = (
	"no type in scope implements `add`. Define an `implements <trait> for Vector:` "
	+ "block with a `add` method."
)


pure func test_render_hint_values() -> Bool:
	render_core_trait_no_impl_hint(
		"to_string",
		"Widgit",
		["Gadget", "Widget"],
	) == EXPECTED_SUGGESTION_HINT and render_core_trait_no_impl_hint(
		"add",
		"Vector",
		["String", "Bool"],
	) == EXPECTED_CANDIDATES_HINT and render_core_trait_no_impl_hint(
		"add",
		"Vector",
		[],
	) == EXPECTED_EMPTY_HINT


tests: TestSuite = {
	description = "Self-hosted Core trait resolve diagnostics",
	tests = [("render hint values", test_render_hint_values)]
}
