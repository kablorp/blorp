import:
	../core_trait_resolve_diagnostics:
		CoreTraitResolveRenderError(UnsupportedTraitResolveOp, WrongArity),
		core_trait_resolve_template_arity,
		core_trait_resolve_template_name,
		parse_core_trait_resolve_template,
		render_core_trait_resolve,
		render_error_to_string,
	test: TestSuite


pure func parsed_template_has(name: String, expected_name: String, expected_arity: Int) -> Bool:
	match parse_core_trait_resolve_template(name):
		Some(info):
			(
				core_trait_resolve_template_name(info) == expected_name
				and core_trait_resolve_template_arity(info) == expected_arity
			)
		None:
			False


pure func rendered_hint_is(name: String, args: List[String], expected: String) -> Bool:
	match render_core_trait_resolve(name, args):
		Ok(rendered):
			rendered == expected
		Err(error):
			False


pure func expected_suggestion_hint() -> String:
	(
		"did you mean to call it on a Widget? Or add `implements <trait> for Widgit:` "
		+ "defining `to_string`."
	)


pure func expected_candidates_hint() -> String:
	(
		"types with an `add` impl in scope: Bool, String. Add `implements <trait> for "
		+ "Vector:` to extend it."
	)


pure func expected_empty_hint() -> String:
	(
		"no type in scope implements `add`. Define an `implements <trait> for Vector:` "
		+ "block with a `add` method."
	)


pure func test_parse_template_shapes() -> Bool:
	parsed_template_has("core_trait_resolve_no_impl_hint", "core_trait_resolve_no_impl_hint", 3)


pure func test_render_hint_values() -> Bool:
	suggestion_ok: Bool = rendered_hint_is(
		"core_trait_resolve_no_impl_hint",
		["to_string", "Widgit", "Gadget;Widget"],
		expected_suggestion_hint(),
	)
	candidates_ok: Bool = rendered_hint_is(
		"core_trait_resolve_no_impl_hint",
		["add", "Vector", "String;Bool"],
		expected_candidates_hint(),
	)
	empty_ok: Bool = rendered_hint_is(
		"core_trait_resolve_no_impl_hint",
		["add", "Vector", ""],
		expected_empty_hint(),
	)

	suggestion_ok and candidates_ok and empty_ok


pure func test_render_errors_are_typed() -> Bool:
	wrong_arity_ok: Bool = match (
		render_core_trait_resolve(
			"core_trait_resolve_no_impl_hint",
			["add", "Vector"],
		)
	):
		Err(WrongArity(info, actual)):
			(
				core_trait_resolve_template_name(info) == "core_trait_resolve_no_impl_hint"
				and core_trait_resolve_template_arity(info) == 3
				and actual == 2
			)
		Ok(value):
			False
		Err(UnsupportedTraitResolveOp(name)):
			False

	unsupported_ok: Bool = match render_core_trait_resolve("core_trait_resolve_missing", []):
		Err(UnsupportedTraitResolveOp(name)):
			name == "core_trait_resolve_missing"
		Ok(value):
			False
		Err(WrongArity(info, actual)):
			False

	wrong_arity_ok and unsupported_ok


pure func test_error_text() -> Bool:
	arity_text: String = match (
		render_core_trait_resolve(
			"core_trait_resolve_no_impl_hint",
			["add", "Vector"],
		)
	):
		Err(error):
			render_error_to_string(error)
		Ok(value):
			value

	unsupported_text: String = render_error_to_string(
		UnsupportedTraitResolveOp("core_trait_resolve_missing"),
	)

	(
		arity_text == "core trait resolve op core_trait_resolve_no_impl_hint expected 3 arg(s), got 2"
		and unsupported_text == "unsupported core trait resolve op: core_trait_resolve_missing"
	)


tests: TestSuite = {
	description = "Self-hosted Core trait resolve diagnostics",
	tests = [
		("parse template shapes", test_parse_template_shapes),
		("render hint values", test_render_hint_values),
		("render errors are typed", test_render_errors_are_typed),
		("error text", test_error_text),
	]
}
