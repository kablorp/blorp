pure func callable_span(start_line: Int, end_line: Int) -> CompilerSourceSpan:
	{
		path = "app.brp",
		module_name = "app",
		start_offset = start_line,
		start_line = start_line,
		start_column = 2,
		end_offset = end_line,
		end_line = end_line,
		end_column = 1
	}


private pure func finalized_program(
	path: String,
	module_name: String,
	source: String,
) -> FinalizedTypecheckProgram:
	ParserBridge.parsed_typecheck_source_bridge_artifact(path, module_name, source, False).program


private pure func parsed_program(
	path: String,
	module_name: String,
	source: String,
) -> ParsedProgram:
	finalized_typecheck_program_ast(finalized_program(path, module_name, source))


private pure func prepared_module(
	path: String,
	module_name: String,
	source: String,
) -> Option[CompilerPreparedModuleScope]:
	prepared_module_with_origin(path, module_name, source, CompilerUserModule)


private pure func prepared_module_with_origin(
	path: String,
	module_name: String,
	source: String,
	origin: CompilerModuleOrigin,
) -> Option[CompilerPreparedModuleScope]:
	candidate = compiler_module_load_candidate(
		compiler_resolved_module_identity_from_resolver(module_name, origin),
		finalized_program(path, module_name, source),
	)

	match compiler_indexed_graph_build(candidate, []):
		Ok(graph):
			Some(compiler_indexed_graph_target_scope(graph))
		Err(_):
			None


private pure func direct_state(module_name: String) -> CompilerTypecheckState:
	compiler_typecheck_state_scope_to_program(
		compiler_typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
		parsed_program(module_name + ".brp", module_name, ""),
	)


private pure func graph_with_dependency() -> Option[CompilerIndexedGraph]:
	target = compiler_module_load_candidate(
		compiler_resolved_module_identity_from_resolver("app", CompilerUserModule),
		finalized_program("app.brp", "app", "pure func app_value() -> Int:\n\t0"),
	)
	dependency = compiler_module_load_candidate(
		compiler_resolved_module_identity_from_resolver("dep", CompilerUserModule),
		finalized_program(
			"dep.brp",
			"dep",
			"pure func render() -> Int:\n\t1\n\nunion Signal:\n\tReady",
		),
	)

	match compiler_indexed_graph_build(target, [dependency]):
		Ok(graph):
			Some(graph)
		Err(_):
			None


func test_state_initialization_and_origin_policy() -> Bool:
	user_state = compiler_typecheck_state_for_origin(TYPECHECK_USER_ORIGIN)
	std_state = compiler_typecheck_state_for_origin(TYPECHECK_STDLIB_ORIGIN)
	source_package_state = compiler_typecheck_state_for_origin(
		CompilerSourcePackageModule("pkg/demo"),
	)
	debug_state = compiler_typecheck_state_with_debug_calls(user_state, True)

	(
		not compiler_typecheck_state_allows_builtin(user_state)
		and compiler_typecheck_state_allows_foreign(user_state)
		and compiler_typecheck_state_allows_builtin(std_state)
		and not compiler_typecheck_state_allows_foreign(std_state)
		and not compiler_typecheck_state_allows_builtin(source_package_state)
		and not compiler_typecheck_state_allows_foreign(source_package_state)
		and not user_state.allow_debug_only_calls
		and debug_state.allow_debug_only_calls
		and compiler_typecheck_state_is_stdlib(std_state)
	)


func test_imported_modules_and_import_bindings_are_deduped() -> Bool:
	state = compiler_typecheck_state_for_origin(TYPECHECK_USER_ORIGIN)
	var with_modules = compiler_typecheck_state_add_imported_module(state, "std/list")
	with_modules = compiler_typecheck_state_add_imported_module(with_modules, "std/list")
	with_modules = compiler_typecheck_state_add_imported_module(with_modules, "std/string")

	with_alias = compiler_typecheck_state_register_module_alias(with_modules, "List", "std/list")
	with_duplicate_alias = compiler_typecheck_state_register_module_alias(
		with_alias,
		"List",
		"std/list",
	)
	with_name = compiler_typecheck_state_register_imported_name(
		with_duplicate_alias,
		"map",
		"std/list",
		"map",
	)
	with_bindings = with_name.state

	(
		compiler_module_view_imported_modules(with_bindings.module_view).length() == 2
		and compiler_typecheck_state_has_imported_module(with_bindings, "std/list")
		and compiler_typecheck_state_has_imported_module(with_bindings, "std/string")
		and compiler_module_view_import_bindings(with_bindings.module_view).length() == 2
		and compiler_typecheck_state_has_qualified_module_binding(with_bindings, "List", "std/list")
		and compiler_typecheck_state_has_selective_definition_binding(
			with_bindings,
			"map",
			"std/list",
			"map",
		)
	)


func test_import_binding_kind_is_explicit() -> Bool:
	qualified: CompilerImportBinding = CompilerQualifiedModuleBinding("List", "std/list")
	selective: CompilerImportBinding = CompilerSelectiveDefinitionBinding("map", "std/list", "map")

	qualified_shape = match qualified:
		CompilerQualifiedModuleBinding(local_name, module_path):
			local_name == "List" and module_path == "std/list"
		CompilerSelectiveDefinitionBinding(_, _, _):
			False

	selective_shape = match selective:
		CompilerQualifiedModuleBinding(_, _):
			False
		CompilerSelectiveDefinitionBinding(local_name, module_path, source_name):
			local_name == "map" and module_path == "std/list" and source_name == "map"

	qualified_shape and selective_shape


func test_module_alias_and_imported_name_namespace_collisions() -> Bool:
	with_top_level = compiler_typecheck_state_remember_top_level_name(
		compiler_typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
		"Result",
		CompilerTopLevelType,
	)
	alias_conflict = compiler_typecheck_state_register_module_alias(
		with_top_level,
		"Result",
		"std/result",
	)
	alias_ok = compiler_typecheck_state_register_module_alias(with_top_level, "List", "std/list")
	alias_repeat = compiler_typecheck_state_register_module_alias(alias_ok, "List", "std/list")
	alias_rebind = compiler_typecheck_state_register_module_alias(
		alias_repeat,
		"List",
		"other/list",
	)
	import_conflict = compiler_typecheck_state_register_imported_name(
		alias_ok,
		"List",
		"std/list",
		"List",
	)
	import_ok = compiler_typecheck_state_register_imported_name(alias_ok, "map", "std/list", "map")
	import_duplicate = compiler_typecheck_state_register_imported_name(
		import_ok.state,
		"map",
		"std/list",
		"map",
	)

	(
		compiler_typecheck_state_find_top_level_name(
			with_top_level,
			"Result",
		) == Some(CompilerTopLevelType)
		and compiler_top_level_name_kind_label(CompilerTopLevelTrait) == "trait"
		and alias_conflict.errors.length() == 1
		and compiler_typecheck_state_find_module_alias(alias_ok, "List") == Some("std/list")
		and alias_repeat.errors.length() == 0
		and compiler_module_view_module_aliases(alias_repeat.module_view).length() == 1
		and alias_rebind.errors.length() == 1
		and import_conflict.registered == False
		and import_conflict.state.errors.length() == 1
		and import_ok.registered
		and compiler_module_view_imported_names(import_ok.state.module_view).length() == 1
		and import_duplicate.registered == False
		and import_duplicate.state.errors.length() == 1
	)


func test_name_lookup_indexes_are_complete_and_state_local() -> Bool:
	base = compiler_typecheck_state_for_origin(TYPECHECK_USER_ORIGIN)
	with_top_level = compiler_typecheck_state_remember_top_level_name(
		base,
		"Widget",
		CompilerTopLevelType,
	)
	duplicate_top_level = compiler_typecheck_state_remember_top_level_name(
		with_top_level,
		"Widget",
		CompilerTopLevelFunction,
	)
	imported = compiler_typecheck_state_register_imported_name(
		with_top_level,
		"map",
		"std/list",
		"map",
	)
	duplicate_import = compiler_typecheck_state_register_imported_name(
		imported.state,
		"map",
		"other/list",
		"different_map",
	)
	cleared = compiler_typecheck_state_clear_module_name_indexes(imported.state)

	(
		compiler_typecheck_state_find_top_level_name(base, "Widget").is_none()
		and compiler_module_view_imported_names(base.module_view).length() == 0
		and compiler_typecheck_state_find_top_level_name(
			with_top_level,
			"Widget",
		) == Some(CompilerTopLevelType)
		and compiler_typecheck_state_find_top_level_name(
			duplicate_top_level,
			"Widget",
		) == Some(CompilerTopLevelType)
		and compiler_module_view_imported_names(imported.state.module_view).length() == 1
		and compiler_typecheck_state_find_imported_name(
			imported.state,
			"map",
		).map(
			func(binding): binding.module_path,
		) == Some("std/list")
		and not duplicate_import.registered
		and compiler_module_view_imported_names(duplicate_import.state.module_view).length() == 1
		and compiler_typecheck_state_find_imported_name(
			duplicate_import.state,
			"map",
		).map(
			func(binding): binding.original_name,
		) == Some("map")
		and compiler_module_view_imported_names(with_top_level.module_view).is_empty()
		and compiler_module_view_imported_names(cleared.module_view).is_empty()
		and compiler_module_view_import_bindings(cleared.module_view).is_empty()
		and compiler_typecheck_state_find_top_level_name(cleared, "Widget").is_none()
		and compiler_module_view_imported_names(imported.state.module_view).length() == 1
		and compiler_typecheck_state_find_top_level_name(
			imported.state,
			"Widget",
		) == Some(CompilerTopLevelType)
	)


func test_known_names_and_type_home_precedence() -> Bool:
	var state = compiler_typecheck_state_add_known_type_name(
		compiler_typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
		"Widget",
	)
	state = compiler_typecheck_state_add_known_type_name(state, "Widget")
	state = compiler_typecheck_state_add_known_type_name(state, "Reader")
	state = compiler_typecheck_state_add_known_resource_type_name(state, "Reader")
	state = compiler_typecheck_state_add_known_type_name(state, "Reader")
	state = compiler_typecheck_state_add_known_resource_type_name(state, "Reader")
	state = compiler_typecheck_state_remember_top_level_name(
		state,
		"main",
		CompilerTopLevelFunction,
	)
	imported_home = compiler_typecheck_state_record_type_home(state, "Widget", "pkg/widgets", True)
	ignored_import = compiler_typecheck_state_record_type_home(
		imported_home,
		"Widget",
		"pkg/other_widgets",
		True,
	)
	local_home = compiler_typecheck_state_record_type_home(
		ignored_import,
		"Widget",
		"app/main",
		False,
	)
	cleared = compiler_typecheck_state_clear_known_type_index(local_home)

	(
		compiler_typecheck_state_has_known_type_name(local_home, "Widget")
		and compiler_typecheck_state_has_known_type_name(local_home, "Reader")
		and compiler_typecheck_state_has_known_resource_type_name(local_home, "Reader")
		and not compiler_typecheck_state_has_known_resource_type_name(local_home, "Widget")
		and not compiler_typecheck_state_has_known_type_name(cleared, "Widget")
		and not compiler_typecheck_state_has_known_type_name(cleared, "Reader")
		and not compiler_typecheck_state_has_known_resource_type_name(cleared, "Reader")
		and compiler_typecheck_state_find_top_level_name(
			local_home,
			"main",
		) == Some(CompilerTopLevelFunction)
		and compiler_typecheck_state_find_type_home(imported_home, "Widget") == Some("pkg/widgets")
		and compiler_typecheck_state_find_type_home(ignored_import, "Widget") == Some("pkg/widgets")
		and compiler_typecheck_state_find_type_home(local_home, "Widget") == Some("app/main")
		and compiler_typecheck_state_type_home_matches(local_home, "Widget", "app/main")
	)


func test_callable_ids_and_private_impls_are_state_local() -> Bool:
	base = direct_state("app")
	key = compiler_func_callable_key(
		compiler_typecheck_state_module_identity(base),
		"render",
		callable_span(10, 12),
	)
	other_key = compiler_func_callable_key(
		compiler_typecheck_state_module_identity(base),
		"render",
		callable_span(20, 22),
	)
	instance = impl_instance(7, "Display", TYPE_INT, [], False)

	match compiler_typecheck_state_claim_func_callable_id(base, key):
		CompilerDefinitionIdMissing(_):
			False
		CompilerDefinitionIdClaimed(with_first, first_id):
			match compiler_typecheck_state_claim_func_callable_id(with_first, key):
				CompilerDefinitionIdMissing(_):
					False
				CompilerDefinitionIdClaimed(with_repeat, repeated_id):
					match compiler_typecheck_state_claim_func_callable_id(with_repeat, other_key):
						CompilerDefinitionIdMissing(_):
							False
						CompilerDefinitionIdClaimed(with_other, other_id):
							with_impl = compiler_typecheck_state_add_private_impl(
								with_other,
								instance,
							)
							conflict = compiler_typecheck_state_find_private_impl_conflict(
								with_impl,
								instance,
							)

							(
								repeated_id == first_id
								and other_id == first_id + 1
								and compiler_typecheck_state_func_callable_bindings(
									with_impl,
									"render",
								).length() == 2
								and with_impl.errors.length() == 0
								and with_impl.private_impls.length() == 1
								and conflict.is_some()
							)


func test_unscoped_definition_claim_is_rejected() -> Bool:
	base = compiler_typecheck_state_for_origin(TYPECHECK_USER_ORIGIN)
	key = compiler_func_callable_key(
		compiler_typecheck_state_module_identity(base),
		"render",
		callable_span(10, 12),
	)

	match compiler_typecheck_state_claim_func_callable_id(base, key):
		CompilerDefinitionIdClaimed(_, _):
			False
		CompilerDefinitionIdMissing(with_error):
			(
				with_error.errors.length() == 1
				and with_error.errors
					.get_or(0, "")
					.contains("before selecting a module")
			)


func test_reserved_definition_ids_are_read_only_and_graph_owned() -> Bool:
	match prepared_module(
		"render.brp",
		"pkg/render",
		"pure func render(value: Int) -> Int:\n\tvalue\n\npure func render(value: String) -> Int:\n\tvalue.length()",
	):
		None:
			False
		Some(module):
			reserved = compiler_typecheck_state_enter_prepared_module_scope(
				compiler_typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
				module,
			)
			missing_key = compiler_func_callable_key(
				compiler_typecheck_state_module_identity(reserved),
				"not_planned",
				callable_span(30, 32),
			)

			match compiler_typecheck_state_claim_func_callable_id(reserved, missing_key):
				CompilerDefinitionIdClaimed(_, _):
					False
				CompilerDefinitionIdMissing(with_error):
					(
						compiler_typecheck_state_func_callable_bindings(
							reserved,
							"render",
						).length() == 2
						and compiler_typecheck_state_find_func_callable_id(
							with_error,
							missing_key,
						).is_none()
						and with_error.errors.length() == 1
						and with_error.errors
							.get_or(0, "")
							.contains("missing reserved definition ID")
					)


func test_reserved_source_definition_ids_are_precise() -> Bool:
	match prepared_module("types.brp", "types", "union A:\n\tLeft\n\nunion B:\n\tRight"):
		None:
			False
		Some(module):
			reserved = compiler_typecheck_state_enter_prepared_module_scope(
				compiler_typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
				module,
			)

			(
				compiler_typecheck_state_source_definition_bindings_for_name(
					reserved,
					"Left",
				).length() == 1
				and compiler_typecheck_state_source_definition_bindings_for_name(
					reserved,
					"Right",
				).length() == 1
				and reserved.env.next_def_id == compiler_definition_index_next_def_id(
					compiler_typecheck_state_definition_index(reserved),
				)
			)


func test_definition_keys_reuse_source_spans() -> Bool:
	module_identity = compiler_typecheck_state_module_identity(
		compiler_typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
	)
	source = compiler_source_file("app.brp", "app", "func render(): 0")
	start = compiler_source_start(source)
	span = compiler_source_span(source, start, start)
	callable_key = compiler_func_callable_key(module_identity, "render", span)
	definition_key = compiler_source_definition_key(
		module_identity,
		CompilerConstructorDefinition,
		"Render",
		None,
		span,
	)
	callable_span = compiler_func_callable_key_span(callable_key)
	definition_span = compiler_source_definition_key_span(definition_key)

	(
		callable_span.path == "app.brp"
		and callable_span.module_name == "app"
		and callable_span.start_offset == 0
		and definition_span.path == "app.brp"
		and definition_span.module_name == "app"
		and definition_span.end_offset == 0
	)


func test_definition_index_installation_never_lowers_env_frontier() -> Bool:
	match prepared_module("empty.brp", "empty", ""):
		None:
			False
		Some(module):
			base = compiler_typecheck_state_for_origin(TYPECHECK_USER_ORIGIN)
			advanced_next_def_id = base.env.next_def_id + 20
			advanced = { base | env = { base.env | next_def_id = advanced_next_def_id } }
			installed = compiler_typecheck_state_enter_prepared_module_scope(advanced, module)

			(
				installed.env.next_def_id == advanced_next_def_id
				and compiler_definition_index_next_def_id(
					compiler_typecheck_state_definition_index(installed),
				) == advanced_next_def_id
			)


func test_prepared_scope_switches_and_restores_identity_and_origin_together() -> Bool:
	target = direct_state("app")

	match prepared_module_with_origin(
		"dependency.brp",
		"dependency",
		"pure func value() -> Int:\n\t1",
		CompilerSourcePackageModule("pkg/dependency"),
	):
		None:
			False
		Some(module):
			scoped = compiler_typecheck_state_scope_to_imported_module(target, module)
			restored = compiler_typecheck_state_restore_definition_scope(scoped, target)

			(
				compiler_module_identity_display_name(
					compiler_typecheck_state_module_identity(scoped),
				) == "dependency"
				and not compiler_typecheck_state_allows_foreign(scoped)
				and compiler_module_identity_display_name(
					compiler_typecheck_state_module_identity(restored),
				) == "app"
				and compiler_typecheck_state_allows_foreign(restored)
			)


func test_reserved_scope_rejects_replacement_from_another_graph() -> Bool:
	match (
		prepared_module("first.brp", "shared", "pure func first() -> Int:\n\t1"),
		prepared_module("second.brp", "shared", "pure func second() -> Int:\n\t2"),
	):
		(Some(first_scope), Some(second_scope)):
			first_state = compiler_typecheck_state_enter_prepared_module_scope(
				compiler_typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
				first_scope,
			)
			rejected = compiler_typecheck_state_enter_prepared_module_scope(
				first_state,
				second_scope,
			)

			(
				rejected.errors.length() == 1
				and rejected.errors
					.get_or(0, "")
					.contains("cannot replace an indexed graph scope")
				and compiler_typecheck_state_func_callable_bindings(rejected, "first").length() == 1
				and compiler_typecheck_state_func_callable_bindings(
					rejected,
					"second",
				).length() == 0
			)
		_:
			False


func test_reserved_scope_rejects_definition_ids_owned_by_another_module() -> Bool:
	match graph_with_dependency():
		None:
			False
		Some(graph):
			state = compiler_typecheck_state_enter_prepared_module_scope(
				compiler_typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
				compiler_indexed_graph_target_scope(graph),
			)

			match (
				compiler_typecheck_state_func_callable_bindings(state, "render").get(0),
				compiler_typecheck_state_source_definition_bindings_for_name(
					state,
					"Ready",
				).get(0),
			):
				(Some(callable_binding), Some(source_binding)):
					callable_claim = compiler_typecheck_state_claim_func_callable_id(
						state,
						callable_binding[0],
					)
					source_claim = compiler_typecheck_state_claim_source_definition_id(
						state,
						source_binding[0],
					)

					match (callable_claim, source_claim):
						(CompilerDefinitionIdMissing(callable_error), CompilerDefinitionIdMissing(source_error)):
							(
								callable_error.errors
									.get_or(0, "")
									.contains("callable definition ID owned by a different module")
								and source_error.errors
									.get_or(0, "")
									.contains("source definition ID owned by a different module")
							)
						_:
							False
				_:
					False


func test_initial_definition_index_seed_matches_typecheck_environment() -> Bool:
	compiler_definition_index_seed_next_def_id(
		compiler_definition_index_initial_seed(
			ENV_EMPTY,
		),
	) == compiler_typecheck_state_for_origin(TYPECHECK_USER_ORIGIN).env.next_def_id


func test_add_diagnostic_preserves_structured_span() -> Bool:
	span = callable_span(7, 11)
	state = compiler_typecheck_state_add_diagnostic(
		compiler_typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
		compiler_typecheck_diagnostic("located failure", Some(span)),
	)

	match (state.errors, state.diagnostics):
		([message], [diagnostic]):
			match diagnostic.span:
				Some(preserved):
					(
						message == "located failure"
						and diagnostic.message == message
						and compiler_source_spans_equal(preserved, span)
					)
				None:
					False
		_:
			False


func test_type_shape_memo_reset_preserves_semantic_state() -> Bool:
	base = compiler_typecheck_state_add_known_type_name(
		compiler_typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
		"Widget",
	)
	memo = { TYPE_SHAPE_MEMO_EMPTY | contains_target = [
			{
				typ = TYPE_INT,
				contains_one_shot_stream = True,
				contains_resource_source = False
			},
		] }
	seeded = { base | type_shape_memo = memo }
	reset = compiler_typecheck_state_reset_type_shape_memo(seeded)

	(
		compiler_typecheck_state_has_known_type_name(reset, "Widget")
		and reset.type_shape_memo.contains_target.length() == 0
		and reset.type_shape_memo.function_carrier.length() == 0
	)


tests: TestSuite = {
	description = "Compiler typecheck state substrate",
	tests = [
		("state initialization and origin policy", test_state_initialization_and_origin_policy),
		(
			"imported modules and import bindings are deduped",
			test_imported_modules_and_import_bindings_are_deduped,
		),
		("import binding kind is explicit", test_import_binding_kind_is_explicit),
		(
			"module alias and imported name namespace collisions",
			test_module_alias_and_imported_name_namespace_collisions,
		),
		(
			"name lookup indexes are complete and state local",
			test_name_lookup_indexes_are_complete_and_state_local,
		),
		("known names and type home precedence", test_known_names_and_type_home_precedence),
		(
			"callable ids and private impls are state local",
			test_callable_ids_and_private_impls_are_state_local,
		),
		("unscoped definition claims are rejected", test_unscoped_definition_claim_is_rejected),
		(
			"reserved definition ids are read-only and graph-owned",
			test_reserved_definition_ids_are_read_only_and_graph_owned,
		),
		(
			"reserved source definition ids are precise",
			test_reserved_source_definition_ids_are_precise,
		),
		("definition keys reuse source spans", test_definition_keys_reuse_source_spans),
		(
			"definition index installation never lowers env frontier",
			test_definition_index_installation_never_lowers_env_frontier,
		),
		(
			"prepared scope switches and restores identity and origin together",
			test_prepared_scope_switches_and_restores_identity_and_origin_together,
		),
		(
			"reserved scope rejects replacement from another graph",
			test_reserved_scope_rejects_replacement_from_another_graph,
		),
		(
			"reserved scope rejects definition ids owned by another module",
			test_reserved_scope_rejects_definition_ids_owned_by_another_module,
		),
		(
			"initial definition index seed matches typecheck environment",
			test_initial_definition_index_seed_matches_typecheck_environment,
		),
		(
			"adding diagnostics preserves structured spans",
			test_add_diagnostic_preserves_structured_span,
		),
		(
			"type-shape memo reset preserves semantic state",
			test_type_shape_memo_reset_preserves_semantic_state,
		),
	]
}
