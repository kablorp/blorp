pure func callable_span(start_line: Int, end_line: Int) -> CompilerSourceSpan:
	{
		path = "app.brp",
		module_name = "app",
		start_offset = start_line,
		start_line = start_line,
		start_column = 2,
		end_offset = end_line,
		end_line = end_line,
		end_column = 1
	}


func test_state_initialization_and_origin_policy() -> Bool:
	user_state = compiler_typecheck_state_empty()
	std_state = compiler_typecheck_state_stdlib()
	source_package_state = compiler_typecheck_state_for_origin(
		CompilerSourcePackageModule("pkg/demo"),
	)
	debug_state = compiler_typecheck_state_with_debug_calls(user_state, True)

	(
		not compiler_typecheck_state_allows_builtin(user_state)
		and compiler_typecheck_state_allows_foreign(user_state)
		and compiler_typecheck_state_allows_builtin(std_state)
		and not compiler_typecheck_state_allows_foreign(std_state)
		and not compiler_typecheck_state_allows_builtin(source_package_state)
		and not compiler_typecheck_state_allows_foreign(source_package_state)
		and not user_state.allow_debug_only_calls
		and debug_state.allow_debug_only_calls
		and compiler_typecheck_state_is_stdlib(std_state)
	)


func test_imported_modules_and_import_bindings_are_deduped() -> Bool:
	state = compiler_typecheck_state_empty()
	var with_modules = compiler_typecheck_state_add_imported_module(state, "std/list")
	with_modules = compiler_typecheck_state_add_imported_module(with_modules, "std/list")
	with_modules = compiler_typecheck_state_add_imported_module(with_modules, "std/string")

	var with_bindings = compiler_typecheck_state_add_import_binding(
		with_modules,
		"List",
		"std/list",
		None,
	)
	with_bindings = compiler_typecheck_state_add_import_binding(
		with_bindings,
		"List",
		"std/list",
		None,
	)
	with_bindings = compiler_typecheck_state_add_import_binding(
		with_bindings,
		"map",
		"std/list",
		Some("map"),
	)

	(
		with_bindings.imported_modules.length() == 2
		and compiler_typecheck_state_has_imported_module(with_bindings, "std/list")
		and compiler_typecheck_state_has_imported_module(with_bindings, "std/string")
		and with_bindings.import_bindings.length() == 2
		and compiler_typecheck_state_has_import_binding(with_bindings, "List", "std/list", None)
		and compiler_typecheck_state_has_import_binding(
			with_bindings,
			"map",
			"std/list",
			Some("map"),
		)
	)


func test_module_alias_and_imported_name_namespace_collisions() -> Bool:
	with_top_level = compiler_typecheck_state_remember_top_level_name(
		compiler_typecheck_state_empty(),
		"Result",
		CompilerTopLevelType,
	)
	alias_conflict = compiler_typecheck_state_register_module_alias(
		with_top_level,
		"Result",
		"std/result",
	)
	alias_ok = compiler_typecheck_state_register_module_alias(with_top_level, "List", "std/list")
	alias_repeat = compiler_typecheck_state_register_module_alias(alias_ok, "List", "std/list")
	alias_rebind = compiler_typecheck_state_register_module_alias(
		alias_repeat,
		"List",
		"other/list",
	)
	import_conflict = compiler_typecheck_state_register_imported_name(
		alias_ok,
		"List",
		"std/list",
		"List",
	)
	import_ok = compiler_typecheck_state_register_imported_name(alias_ok, "map", "std/list", "map")
	import_duplicate = compiler_typecheck_state_register_imported_name(
		import_ok.state,
		"map",
		"std/list",
		"map",
	)

	(
		compiler_typecheck_state_find_top_level_name(
			with_top_level,
			"Result",
		) == Some(CompilerTopLevelType)
		and compiler_top_level_name_kind_label(CompilerTopLevelTrait) == "trait"
		and alias_conflict.errors.length() == 1
		and compiler_typecheck_state_find_module_alias(alias_ok, "List") == Some("std/list")
		and alias_repeat.errors.length() == 0
		and alias_repeat.module_aliases.length() == 1
		and alias_rebind.errors.length() == 1
		and import_conflict.registered == False
		and import_conflict.state.errors.length() == 1
		and import_ok.registered
		and import_ok.state.imported_names.length() == 1
		and import_duplicate.registered == False
		and import_duplicate.state.errors.length() == 1
	)


func test_name_lookup_indexes_are_complete_and_state_local() -> Bool:
	base = compiler_typecheck_state_empty()
	with_top_level = compiler_typecheck_state_remember_top_level_name(
		base,
		"Widget",
		CompilerTopLevelType,
	)
	duplicate_top_level = compiler_typecheck_state_remember_top_level_name(
		with_top_level,
		"Widget",
		CompilerTopLevelFunction,
	)
	imported = compiler_typecheck_state_register_imported_name(
		with_top_level,
		"map",
		"std/list",
		"map",
	)
	duplicate_import = compiler_typecheck_state_register_imported_name(
		imported.state,
		"map",
		"other/list",
		"different_map",
	)
	cleared = compiler_typecheck_state_clear_module_name_indexes(imported.state)

	(
		base.top_level_names.length() == 0
		and base.imported_names_by_local_name.length() == 0
		and with_top_level.top_level_names.get("Widget") == Some(CompilerTopLevelType)
		and duplicate_top_level.top_level_names.length() == 1
		and duplicate_top_level.top_level_names.get("Widget") == Some(CompilerTopLevelType)
		and imported.state.imported_names.length() == 1
		and imported.state.imported_names_by_local_name
			.get("map")
			.map(func(binding): binding.module_path) == Some("std/list")
		and not duplicate_import.registered
		and duplicate_import.state.imported_names.length() == 1
		and duplicate_import.state.imported_names_by_local_name.length() == 1
		and compiler_typecheck_state_find_imported_name(
			duplicate_import.state,
			"map",
		).map(
			func(binding): binding.original_name,
		) == Some("map")
		and with_top_level.imported_names_by_local_name.length() == 0
		and cleared.imported_names.is_empty()
		and cleared.imported_names_by_local_name.is_empty()
		and cleared.top_level_names.is_empty()
		and imported.state.imported_names.length() == 1
		and imported.state.top_level_names.length() == 1
	)


func test_known_names_and_type_home_precedence() -> Bool:
	var state = compiler_typecheck_state_add_known_type_name(
		compiler_typecheck_state_empty(),
		"Widget",
	)
	state = compiler_typecheck_state_add_known_resource_type_name(state, "Reader")
	state = compiler_typecheck_state_remember_top_level_name(
		state,
		"main",
		CompilerTopLevelFunction,
	)
	imported_home = compiler_typecheck_state_record_type_home(state, "Widget", "pkg/widgets", True)
	ignored_import = compiler_typecheck_state_record_type_home(
		imported_home,
		"Widget",
		"pkg/other_widgets",
		True,
	)
	local_home = compiler_typecheck_state_record_type_home(
		ignored_import,
		"Widget",
		"app/main",
		False,
	)

	(
		compiler_typecheck_state_has_known_type_name(local_home, "Widget")
		and compiler_typecheck_state_has_known_type_name(local_home, "Reader")
		and compiler_typecheck_state_has_known_resource_type_name(local_home, "Reader")
		and compiler_typecheck_state_find_top_level_name(
			local_home,
			"main",
		) == Some(CompilerTopLevelFunction)
		and compiler_typecheck_state_find_type_home(imported_home, "Widget") == Some("pkg/widgets")
		and compiler_typecheck_state_find_type_home(ignored_import, "Widget") == Some("pkg/widgets")
		and compiler_typecheck_state_find_type_home(local_home, "Widget") == Some("app/main")
		and compiler_typecheck_state_type_home_matches(local_home, "Widget", "app/main")
	)


func test_callable_ids_and_private_impls_are_state_local() -> Bool:
	key = compiler_func_callable_key(
		"render",
		callable_span(10, 12),
	)
	other_key = compiler_func_callable_key(
		"render",
		callable_span(20, 22),
	)
	instance = compiler_impl_instance(7, "Display", compiler_type_int(), [], False)
	var with_id = compiler_typecheck_state_record_func_callable_id(
		compiler_typecheck_state_empty(),
		key,
		4,
	)
	with_id = compiler_typecheck_state_record_func_callable_id(with_id, key, 5)
	with_id = compiler_typecheck_state_record_func_callable_id(with_id, other_key, 6)
	with_id = compiler_typecheck_state_add_private_impl(with_id, instance)
	conflict = compiler_typecheck_state_find_private_impl_conflict(with_id, instance)

	(
		compiler_typecheck_state_find_func_callable_id(with_id, key) == Some(5)
		and compiler_typecheck_state_find_func_callable_id(with_id, other_key) == Some(6)
		and with_id.func_callable_ids_by_name
			.get("render")
			.get_or([])
			.length() == 2
		and with_id.private_impls.length() == 1
		and with_id.private_impls
			.get(0)
			.get_or(instance).def_id == 7
		and conflict.is_some()
	)


func test_reserved_callable_ids_share_lookup_index() -> Bool:
	first_key = compiler_func_callable_key(
		"render",
		callable_span(10, 12),
	)
	second_key = compiler_func_callable_key(
		"render",
		callable_span(20, 22),
	)
	var seeded = compiler_typecheck_state_record_func_callable_id(
		compiler_typecheck_state_empty(),
		first_key,
		41,
	)
	seeded = compiler_typecheck_state_record_func_callable_id(seeded, second_key, 42)
	reserved = compiler_typecheck_state_with_reserved_definition_ids(
		compiler_typecheck_state_empty(),
		seeded.func_callable_ids_by_name,
		{},
		43,
	)

	(
		compiler_typecheck_state_find_func_callable_id(reserved, first_key) == Some(41)
		and compiler_typecheck_state_find_func_callable_id(reserved, second_key) == Some(42)
	)


func test_shared_reserved_definition_ids_are_copy_on_write() -> Bool:
	first_callable = compiler_func_callable_key(
		"render",
		callable_span(10, 12),
	)
	second_callable = compiler_func_callable_key(
		"render",
		callable_span(20, 22),
	)
	source = compiler_source_file("types.brp", "types", "union A:\n\tSame")
	start = compiler_source_start(source)
	span = compiler_source_span(source, start, start)
	first_source = compiler_source_definition_key(
		CompilerConstructorDefinition,
		"Same",
		Some("A"),
		span,
	)
	second_source = compiler_source_definition_key(
		CompilerConstructorDefinition,
		"Same",
		Some("B"),
		span,
	)
	var seed = compiler_typecheck_state_record_func_callable_id(
		compiler_typecheck_state_empty(),
		first_callable,
		41,
	)
	seed = compiler_typecheck_state_record_source_definition_id(seed, first_source, 51)
	sibling = compiler_typecheck_state_with_reserved_definition_ids(
		compiler_typecheck_state_empty(),
		seed.func_callable_ids_by_name,
		seed.source_definition_ids_by_name,
		60,
	)
	var updated = compiler_typecheck_state_with_reserved_definition_ids(
		compiler_typecheck_state_empty(),
		seed.func_callable_ids_by_name,
		seed.source_definition_ids_by_name,
		60,
	)
	updated = compiler_typecheck_state_record_func_callable_id(updated, first_callable, 42)
	updated = compiler_typecheck_state_record_func_callable_id(updated, second_callable, 43)
	updated = compiler_typecheck_state_record_source_definition_id(updated, first_source, 52)
	updated = compiler_typecheck_state_record_source_definition_id(updated, second_source, 53)

	(
		compiler_typecheck_state_find_func_callable_id(seed, first_callable) == Some(41)
		and compiler_typecheck_state_find_func_callable_id(seed, second_callable).is_none()
		and compiler_typecheck_state_find_source_definition_id(seed, first_source) == Some(51)
		and compiler_typecheck_state_find_source_definition_id(seed, second_source).is_none()
		and compiler_typecheck_state_find_func_callable_id(sibling, first_callable) == Some(41)
		and compiler_typecheck_state_find_func_callable_id(sibling, second_callable).is_none()
		and compiler_typecheck_state_find_source_definition_id(sibling, first_source) == Some(51)
		and compiler_typecheck_state_find_source_definition_id(sibling, second_source).is_none()
		and compiler_typecheck_state_find_func_callable_id(updated, first_callable) == Some(42)
		and compiler_typecheck_state_find_func_callable_id(updated, second_callable) == Some(43)
		and compiler_typecheck_state_find_source_definition_id(updated, first_source) == Some(52)
		and compiler_typecheck_state_find_source_definition_id(updated, second_source) == Some(53)
	)


func test_reserved_source_definition_ids_are_precise() -> Bool:
	source = compiler_source_file("types.brp", "types", "union A:\n\tSame")
	start = compiler_source_start(source)
	span = compiler_source_span(source, start, start)
	left_key = compiler_source_definition_key(
		CompilerConstructorDefinition,
		"Same",
		Some("A"),
		span,
	)
	right_key = compiler_source_definition_key(
		CompilerConstructorDefinition,
		"Same",
		Some("B"),
		span,
	)
	var state = compiler_typecheck_state_record_source_definition_id(
		compiler_typecheck_state_empty(),
		left_key,
		41,
	)
	state = compiler_typecheck_state_record_source_definition_id(state, right_key, 42)
	reserved = compiler_typecheck_state_with_reserved_definition_ids(
		compiler_typecheck_state_empty(),
		state.func_callable_ids_by_name,
		state.source_definition_ids_by_name,
		43,
	)

	(
		compiler_typecheck_state_find_source_definition_id(reserved, left_key) == Some(41)
		and compiler_typecheck_state_find_source_definition_id(reserved, right_key) == Some(42)
		and reserved.source_definition_ids_by_name
			.get("Same")
			.get_or([])
			.length() == 2
		and reserved.env.next_def_id == 43
	)


func test_definition_keys_reuse_source_spans() -> Bool:
	source = compiler_source_file("app.brp", "app", "func render(): 0")
	start = compiler_source_start(source)
	span = compiler_source_span(source, start, start)
	callable_key = compiler_func_callable_key("render", span)
	definition_key = compiler_source_definition_key(
		CompilerConstructorDefinition,
		"Render",
		None,
		span,
	)

	(
		callable_key.span.path == "app.brp"
		and callable_key.span.module_name == "app"
		and callable_key.span.start_offset == 0
		and definition_key.span.path == "app.brp"
		and definition_key.span.module_name == "app"
		and definition_key.span.end_offset == 0
	)


func test_type_shape_memo_reset_preserves_semantic_state() -> Bool:
	base = compiler_typecheck_state_add_known_type_name(compiler_typecheck_state_empty(), "Widget")
	memo = { compiler_type_shape_memo_empty() | contains_target = [
			{
				typ = compiler_type_int(),
				contains_one_shot_stream = True,
				contains_resource_source = False
			},
		] }
	seeded = { base | type_shape_memo = memo }
	reset = compiler_typecheck_state_reset_type_shape_memo(seeded)

	(
		compiler_typecheck_state_has_known_type_name(reset, "Widget")
		and reset.type_shape_memo.contains_target.length() == 0
		and reset.type_shape_memo.function_carrier.length() == 0
	)


tests: TestSuite = {
	description = "Compiler typecheck state substrate",
	tests = [
		("state initialization and origin policy", test_state_initialization_and_origin_policy),
		(
			"imported modules and import bindings are deduped",
			test_imported_modules_and_import_bindings_are_deduped,
		),
		(
			"module alias and imported name namespace collisions",
			test_module_alias_and_imported_name_namespace_collisions,
		),
		(
			"name lookup indexes are complete and state local",
			test_name_lookup_indexes_are_complete_and_state_local,
		),
		("known names and type home precedence", test_known_names_and_type_home_precedence),
		(
			"callable ids and private impls are state local",
			test_callable_ids_and_private_impls_are_state_local,
		),
		("reserved callable ids share lookup index", test_reserved_callable_ids_share_lookup_index),
		(
			"shared reserved definition ids are copy on write",
			test_shared_reserved_definition_ids_are_copy_on_write,
		),
		(
			"reserved source definition ids are precise",
			test_reserved_source_definition_ids_are_precise,
		),
		("definition keys reuse source spans", test_definition_keys_reuse_source_spans),
		(
			"type-shape memo reset preserves semantic state",
			test_type_shape_memo_reset_preserves_semantic_state,
		),
	]
}
