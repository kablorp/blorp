import:
	../src/stage_01_file_io/source: source_file
	../src/stage_04_modules/frontend_graph:
		FrontendImportResolution(FrontendResolvedImport, FrontendUnresolvedImport),
		frontend_graph_import_edges,
		frontend_graph_modules,
	../src/stage_04_modules/loaded_module:
		ModuleOrigin(NativePackageModule, UserModule),
		resolved_module_canonical_path,
		resolved_module_identity_from_resolver,
		resolved_module_origin,
	../src/stage_04_modules/source_package_layout: SourcePackageLayout
	../src/stage_12_lsp/document_model: OpenedDocument, VersionedDocumentText, document_version
	../src/stage_12_lsp/frontend_graph: frontend_graph_for_roots, frontend_graph_for_sources
	../src/stage_12_lsp/identity: DocumentUri, document_uri
	../src/stage_12_lsp/workspace_model:
		DiscoveredSourceProvenance(
			DiskSource,
			NativePackageSource,
			SourcePackageSource,
			StandardLibrarySource,
		),
		DiscoveredSourceSnapshot,
	../src/stage_12_lsp/workspace_source:
		discovered_source_layer,
		set_open_document_source,
		source_layers_from_discovered,
	../src/stage_12_lsp/workspace_store: dependency_store_length
	test: TestSuite


private pure func uri(module_name: String) -> DocumentUri:
	document_uri("file:///workspace/" + module_name + ".brp")


private pure func source_package() -> SourcePackageLayout:
	{
		package_alias = "math",
		package_name = "math_core",
		source_dir = "/packages/math/src",
		exports = ["math_core/main", "math_core/stats"]
	}


private pure func discovered(module_name: String, text: String) -> DiscoveredSourceSnapshot:
	{
		uri = uri(module_name),
		layer = discovered_source_layer(
			source_file("/workspace/" + module_name + ".brp", module_name, text),
			DiskSource,
		)
	}


private pure func discovered_at(
	uri_name: String,
	path: String,
	module_name: String,
	text: String,
	provenance: DiscoveredSourceProvenance,
) -> DiscoveredSourceSnapshot:
	{
		uri = uri(uri_name),
		layer = discovered_source_layer(
			source_file(path, module_name, text),
			provenance,
		)
	}


private pure func opened(module_name: String, text: String) -> Option[OpenedDocument]:
	version ?= document_version(2)
	document: VersionedDocumentText = {
		uri = uri(module_name),
		version = version,
		text = text
	}
	Some({
		document = document,
		language_id = "blorp",
	})


func test_graph_uses_overlay_imports_from_the_selected_snapshot() -> Bool:
	match source_layers_from_discovered([
		discovered("main", "import:\n\tdep\n\nVALUE = 1\n"),
		discovered("dep", "VALUE = 2\n"),
		discovered("other", "VALUE = 3\n"),
	]):
		Err(_):
			False
		Ok(disk_sources):
			match opened("main", "import:\n\tother\n\nVALUE = 1\n"):
				None:
					False
				Some(open_document):
					sources = set_open_document_source(
						disk_sources,
						open_document,
						source_file("/workspace/main.brp", "main", open_document.document.text),
						DiskSource,
					)

					match frontend_graph_for_sources(sources):
						Err(_):
							False
						Ok(snapshot):
							match frontend_graph_import_edges(snapshot.graph):
								[edge]:
									match edge.resolution:
										FrontendResolvedImport(target):
											(
												edge.requested_path == "other"
												and resolved_module_canonical_path(
													target,
												) == "other"
												and dependency_store_length(
													snapshot.dependencies,
												) == 3
											)
										_:
											False
								_:
									False


func test_graph_resolves_relative_import_by_selected_source_path() -> Bool:
	match source_layers_from_discovered([
		discovered("main", "import:\n\t./dep\n\nVALUE = 1\n"),
		discovered("dep", "VALUE = 2\n"),
	]):
		Err(_):
			False
		Ok(sources):
			match frontend_graph_for_sources(sources):
				Err(_):
					False
				Ok(snapshot):
					match frontend_graph_import_edges(snapshot.graph):
						[edge]:
							match edge.resolution:
								FrontendResolvedImport(target):
									(
										edge.requested_path == "./dep"
										and resolved_module_canonical_path(target) == "dep"
									)
								_:
									False
						_:
							False


func test_graph_uses_cli_std_before_local_precedence() -> Bool:
	match source_layers_from_discovered([
		discovered("main", "import:\n\tdep\n\nVALUE = 1\n"),
		discovered("dep", "VALUE = 2\n"),
		discovered_at(
			"stdlib-dep",
			"/stdlib/dep.brp",
			"std/dep",
			"VALUE = 3\n",
			StandardLibrarySource,
		),
	]):
		Err(_):
			False
		Ok(sources):
			match frontend_graph_for_sources(sources):
				Err(_):
					False
				Ok(snapshot):
					match frontend_graph_import_edges(snapshot.graph):
						[edge]:
							match edge.resolution:
								FrontendResolvedImport(target):
									resolved_module_canonical_path(target) == "std/dep"
								_:
									False
						_:
							False


func test_source_package_import_does_not_fall_through_to_std() -> Bool:
	match source_layers_from_discovered([
		discovered_at(
			"package-main",
			"/packages/math/src/math/main.brp",
			"math/main",
			"import:\n\tdep\n\nVALUE = 1\n",
			SourcePackageSource(source_package()),
		),
		discovered_at(
			"stdlib-dep",
			"/stdlib/dep.brp",
			"std/dep",
			"VALUE = 2\n",
			StandardLibrarySource,
		),
	]):
		Err(_):
			False
		Ok(sources):
			match frontend_graph_for_sources(sources):
				Err(_):
					False
				Ok(snapshot):
					match frontend_graph_import_edges(snapshot.graph):
						[edge]:
							edge.resolution == FrontendUnresolvedImport
						_:
							False


func test_source_package_export_uses_alias_identity_and_shared_source_uri() -> Bool:
	match source_layers_from_discovered([
		discovered("main", "import:\n\tmath/stats\n\nVALUE = 1\n"),
		discovered_at(
			"package-stats",
			"/packages/math/src/math_core/stats.brp",
			"math_core/stats",
			"VALUE = 2\n",
			SourcePackageSource(source_package()),
		),
	]):
		Err(_):
			False
		Ok(sources):
			match frontend_graph_for_sources(sources):
				Err(_):
					False
				Ok(snapshot):
					alias_edge = frontend_graph_import_edges(snapshot.graph).find(func(edge):
						edge.requested_path == "math/stats"
					)

					match alias_edge:
						Some(edge):
							match edge.resolution:
								FrontendResolvedImport(target):
									(
										resolved_module_canonical_path(target) == "math/stats"
										and dependency_store_length(snapshot.dependencies) == 3
									)
								_:
									False
						None:
							False


func test_source_package_relative_import_cannot_escape_package_origin() -> Bool:
	match source_layers_from_discovered([
		discovered_at(
			"package-main",
			"/packages/math/src/main.brp",
			"math/main",
			"import:\n\t../outside\n\nVALUE = 1\n",
			SourcePackageSource(source_package()),
		),
		discovered_at(
			"outside",
			"/packages/math/outside.brp",
			"outside",
			"VALUE = 2\n",
			DiskSource,
		),
	]):
		Err(_):
			False
		Ok(sources):
			match frontend_graph_for_sources(sources):
				Err(_):
					False
				Ok(snapshot):
					match frontend_graph_import_edges(snapshot.graph):
						[edge]:
							edge.resolution == FrontendUnresolvedImport
						_:
							False


func test_native_package_import_preserves_package_identity() -> Bool:
	match source_layers_from_discovered([
		discovered("main", "import:\n\tpkg/sqlite\n\nVALUE = 1\n"),
		discovered_at(
			"native-sqlite",
			"/packages/native/sqlite.brp",
			"pkg/sqlite",
			"VALUE = 2\n",
			NativePackageSource("sqlite-id"),
		),
	]):
		Err(_):
			False
		Ok(sources):
			match frontend_graph_for_sources(sources):
				Err(_):
					False
				Ok(snapshot):
					match frontend_graph_import_edges(snapshot.graph):
						[edge]:
							match edge.resolution:
								FrontendResolvedImport(target):
									match resolved_module_origin(target):
										NativePackageModule(package_id):
											package_id == "sqlite-id"
										_:
											False
								_:
									False
						_:
							False


func test_rooted_graph_includes_shared_implicit_compiler_modules() -> Bool:
	match source_layers_from_discovered([
		discovered("main", "VALUE: Int = 1\n"),
		discovered_at(
			"stdlib-prelude",
			"/stdlib/prelude.brp",
			"std/prelude",
			"PRELUDE: Int = 1\n",
			StandardLibrarySource,
		),
		discovered_at(
			"stdlib-tuple",
			"/stdlib/tuple.brp",
			"std/tuple",
			"TUPLE_IMPLS: Int = 1\n",
			StandardLibrarySource,
		),
	]):
		Err(_):
			False
		Ok(sources):
			root = resolved_module_identity_from_resolver("main", UserModule)

			match frontend_graph_for_roots(sources, [root]):
				Err(_):
					False
				Ok(snapshot):
					module_paths = frontend_graph_modules(snapshot.graph)
						.map(func(module):
							resolved_module_canonical_path(module.identity)
						)
						.sort()

					module_paths == ["main", "std/prelude", "std/tuple"]


tests: TestSuite = {
	description = "LSP frontend graph source provider",
	tests = [
		(
			"use overlay imports from selected snapshot",
			test_graph_uses_overlay_imports_from_the_selected_snapshot,
		),
		(
			"resolve relative import by selected source path",
			test_graph_resolves_relative_import_by_selected_source_path,
		),
		("use CLI std before local precedence", test_graph_uses_cli_std_before_local_precedence),
		(
			"source package import does not fall through to std",
			test_source_package_import_does_not_fall_through_to_std,
		),
		(
			"source package export uses alias identity and shared source URI",
			test_source_package_export_uses_alias_identity_and_shared_source_uri,
		),
		(
			"source package relative import cannot escape package origin",
			test_source_package_relative_import_cannot_escape_package_origin,
		),
		(
			"native package import preserves package identity",
			test_native_package_import_preserves_package_identity,
		),
		(
			"rooted graph includes shared implicit compiler modules",
			test_rooted_graph_includes_shared_implicit_compiler_modules,
		),
	]
}
