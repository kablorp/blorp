	[
		string_builtin(
			"split",
			[string_param("self", 41), string_param("delimiter", 42)],
			LIST_STRING_TYPE,
		),
		string_builtin(
			"replace",
			[string_param("self", 43), string_param("old", 44), string_param("new", 45)],
			STRING_TYPE,
		),
		string_builtin(
			"repeat",
			[string_param("self", 46), int_param("count", 47)],
			STRING_TYPE,
		),
		string_builtin("reverse", [string_param("self", 48)], STRING_TYPE),
	]


pure func slicing_functions() -> List[CoreFunction]:
	[
		string_builtin(
			"drop_left",
			[string_param("self", 51), int_param("count", 52)],
			STRING_TYPE,
		),
		string_builtin(
			"take_left",
			[string_param("self", 53), int_param("count", 54)],
			STRING_TYPE,
		),
		string_builtin(
			"take_right",
			[string_param("self", 55), int_param("count", 56)],
			STRING_TYPE,
		),
		string_builtin(
			"drop_right",
