import:
	../src/stage_09_core/compiler_core_json:
		CoreCallKind(IntrinsicCall),
		CoreExpr(BreakExpr, CallExpr, ForRangeExpr, LetExpr, VarExpr, WhileExpr),
		CoreFunction,
		CoreFunctionKind(UnresolvedBuiltinFunction),
		CoreParam,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType),
		CoreVar,
	../src/stage_09_core/compiler_core_synth_string: synthesize_string_body
	../src/stage_09_core/compiler_core_traverse: immediate_core_expr_children
	test: TestSuite


private INT_TYPE: CoreType = NamedType("Int", [])

private BOOL_TYPE: CoreType = NamedType("Bool", [])

private CHAR_TYPE: CoreType = NamedType("Char", [])

private STRING_TYPE: CoreType = NamedType("String", [])

private LIST_STRING_TYPE: CoreType = NamedType("List", [STRING_TYPE])


pure func core_var(name: String, uniq: Int) -> CoreVar:
	{
		name = name,
		uniq = uniq,
		def_id = Some(uniq)
	}


pure func param(name: String, uniq: Int, typ: CoreType) -> CoreParam:
	{
		name = core_var(name, uniq),
		typ = typ,
		loc = SyntheticSourceLoc
	}


pure func builtin_function(
	module_name: String,
	source_name: String,
	params: List[CoreParam],
	return_type: CoreType,
) -> CoreFunction:
	{
		name = module_name.replace("/", "_") + "__" + source_name + "__mono_fixture",
		source_module = Some(module_name),
		type_params = [],
		params = params,
		return_type = return_type,
		body = None,
		is_pure = True,
		function_kind = UnresolvedBuiltinFunction,
		def_id = 1,
		loc = SyntheticSourceLoc
	}


pure func string_param(name: String, uniq: Int) -> CoreParam:
	param(name, uniq, STRING_TYPE)


pure func int_param(name: String, uniq: Int) -> CoreParam:
	param(name, uniq, INT_TYPE)


pure func char_param(name: String, uniq: Int) -> CoreParam:
	param(name, uniq, CHAR_TYPE)


pure func string_builtin(
	name: String,
	params: List[CoreParam],
	return_type: CoreType,
) -> CoreFunction:
	builtin_function("std/string", name, params, return_type)


pure func contains_intrinsic(expr: CoreExpr, expected: String) -> Bool:
	match expr:
		CallExpr(IntrinsicCall(name), _, _, _, _):
			name == expected or immediate_core_expr_children(expr).any(func(child):
				contains_intrinsic(child, expected)
			)
		_:
			immediate_core_expr_children(expr).any(func(child):
				contains_intrinsic(child, expected)
			)


pure func contains_loop(expr: CoreExpr) -> Bool:
	match expr:
		ForRangeExpr(_, _, _, _, _, _):
			True
		WhileExpr(_, _, _, _):
			True
		_:
			immediate_core_expr_children(expr).any(func(child): contains_loop(child))


pure func contains_break(expr: CoreExpr) -> Bool:
	match expr:
		BreakExpr(_, _):
			True
		_:
			immediate_core_expr_children(expr).any(func(child): contains_break(child))


pure func contains_mutable_let(expr: CoreExpr) -> Bool:
	match expr:
		LetExpr(_, True, _, _, _):
			True
		_:
			immediate_core_expr_children(expr).any(func(child): contains_mutable_let(child))


pure func contains_parameter_identity(expr: CoreExpr, expected: CoreVar) -> Bool:
	match expr:
		VarExpr(variable, _, _):
			variable == expected
		_:
			immediate_core_expr_children(expr).any(func(child):
				contains_parameter_identity(child, expected)
			)


pure func body_preserves_all_parameters(function_info: CoreFunction) -> Bool:
	match synthesize_string_body(function_info):
		Some(body):
			function_info.params.all(func(parameter):
				contains_parameter_identity(body, parameter.name)
			)
		None:
			False


pure func capacity_functions() -> List[CoreFunction]:
	[
		string_builtin("string", [int_param("capacity", 11)], STRING_TYPE),
		string_builtin("string_with_capacity", [int_param("capacity", 12)], STRING_TYPE),
		string_builtin(
			"reserve",
			[string_param("self", 13), int_param("capacity", 14)],
			STRING_TYPE,
		),
		string_builtin(
			"append_char",
			[string_param("self", 15), char_param("character", 16)],
			STRING_TYPE,
		),
		string_builtin(
			"string_append_char",
			[string_param("self", 17), char_param("character", 18)],
			STRING_TYPE,
		),
		string_builtin("length", [string_param("self", 19)], INT_TYPE),
	]


pure func search_functions() -> List[CoreFunction]:
	[
		string_builtin(
			"substring",
			[string_param("self", 21), int_param("start", 22), int_param("length", 23)],
			STRING_TYPE,
		),
		string_builtin(
			"starts_with",
			[string_param("self", 24), string_param("prefix", 25)],
			BOOL_TYPE,
		),
		string_builtin(
			"ends_with",
			[string_param("self", 26), string_param("suffix", 27)],
			BOOL_TYPE,
		),
		string_builtin(
			"contains",
			[string_param("self", 28), string_param("needle", 29)],
			BOOL_TYPE,
		),
		string_builtin(
			"raw_index_of",
			[string_param("self", 30), string_param("needle", 31)],
			INT_TYPE,
		),
		string_builtin(
			"raw_last_index_of",
			[string_param("self", 32), string_param("needle", 33)],
			INT_TYPE,
		),
		string_builtin(
			"count",
			[string_param("self", 34), string_param("needle", 35)],
			INT_TYPE,
		),
	]


