pure func padding_functions() -> List[CoreFunction]:
	[
		string_builtin(
			"pad_left",
			[string_param("self", 71), int_param("width", 72), char_param("fill", 73)],
			STRING_TYPE,
		),
		string_builtin(
			"pad_right",
			[string_param("self", 74), int_param("width", 75), char_param("fill", 76)],
			STRING_TYPE,
		),
		string_builtin(
			"center",
			[string_param("self", 77), int_param("width", 78), char_param("fill", 79)],
			STRING_TYPE,
		),
	]


pure func case_functions() -> List[CoreFunction]:
	[
		string_builtin("capitalize", [string_param("self", 81)], STRING_TYPE),
		string_builtin("title_case", [string_param("self", 82)], STRING_TYPE),
		string_builtin("is_numeric", [string_param("self", 83)], BOOL_TYPE),
		string_builtin("is_ascii", [string_param("self", 84)], BOOL_TYPE),
		string_builtin("is_blank", [string_param("self", 85)], BOOL_TYPE),
		string_builtin("is_lower", [string_param("self", 86)], BOOL_TYPE),
		string_builtin("is_upper", [string_param("self", 87)], BOOL_TYPE),
	]


pure func comparison_functions() -> List[CoreFunction]:
	[
		string_builtin(
			"longest_common_prefix",
			[string_param("left", 91), string_param("right", 92)],
			STRING_TYPE,
		),
		string_builtin(
			"hamming_distance_raw",
			[string_param("left", 93), string_param("right", 94)],
			INT_TYPE,
		),
	]


pure func all_string_functions() -> List[CoreFunction]:
	capacity_functions()
		.concat(search_functions())
		.concat(allocation_functions())
		.concat(slicing_functions())
		.concat(padding_functions())
		.concat(case_functions())
		.concat(comparison_functions())


pure func test_all_string_signatures_are_synthesized() -> Bool:
	all_string_functions().length() == 37 and all_string_functions().all(func(function_info):
		body_preserves_all_parameters(function_info)
	)


pure func test_string_search_family_uses_visible_core_control_flow() -> Bool:
	search = string_builtin(
		"raw_index_of",
		[string_param("self", 101), string_param("needle", 102)],
		INT_TYPE,
	)

	match synthesize_string_body(search):
		Some(body):
			(
				contains_intrinsic(body, "string_len")
				and contains_intrinsic(body, "string_get_byte")
				and contains_loop(body)
				and contains_break(body)
				and contains_mutable_let(body)
			)
		None:
			False


pure func test_string_allocation_family_uses_exact_size_primitives() -> Bool:
	split = string_builtin(
		"split",
		[string_param("self", 121), string_param("delimiter", 122)],
		LIST_STRING_TYPE,
	)
	replace = string_builtin(
		"replace",
		[string_param("self", 123), string_param("old", 124), string_param("new", 125)],
		STRING_TYPE,
	)

	match (synthesize_string_body(split), synthesize_string_body(replace)):
		(Some(split_body), Some(replace_body)):
			(
				contains_intrinsic(split_body, "list_alloc")
				and contains_intrinsic(split_body, "list_set_len")
				and contains_intrinsic(split_body, "string_copy_bytes")
				and contains_intrinsic(replace_body, "string_alloc")
				and contains_intrinsic(replace_body, "string_copy_bytes")
				and contains_intrinsic(replace_body, "string_set_len")
				and contains_loop(split_body)
				and contains_loop(replace_body)
			)
		_:
			False


pure func test_string_append_char_exposes_utf8_and_capacity_logic() -> Bool:
	append = string_builtin(
		"append_char",
		[string_param("self", 131), char_param("character", 132)],
		STRING_TYPE,
	)

	match synthesize_string_body(append):
		Some(body):
			(
				contains_intrinsic(body, "string_ensure_capacity")
				and contains_intrinsic(body, "string_set_byte")
				and contains_intrinsic(body, "string_set_len")
				and contains_intrinsic(body, "shift_right")
				and contains_intrinsic(body, "bit_and")
				and contains_intrinsic(body, "bit_or")
			)
		None:
			False


pure func test_string_slicing_family_clamps_and_copies_bytes() -> Bool:
	substring = string_builtin(
		"substring",
		[string_param("self", 141), int_param("start", 142), int_param("length", 143)],
		STRING_TYPE,
	)
	trim_chars = string_builtin(
		"trim_chars",
		[string_param("self", 144), string_param("characters", 145)],
		STRING_TYPE,
	)

	match (synthesize_string_body(substring), synthesize_string_body(trim_chars)):
		(Some(substring_body), Some(trim_body)):
			(
				contains_intrinsic(substring_body, "string_len")
				and contains_intrinsic(substring_body, "string_alloc")
				and contains_intrinsic(substring_body, "string_copy_bytes")
				and contains_intrinsic(substring_body, "string_set_len")
				and contains_intrinsic(trim_body, "string_get_byte")
				and contains_intrinsic(trim_body, "string_copy_bytes")
				and contains_loop(trim_body)
				and contains_break(trim_body)
			)
		_:
			False


pure func test_string_padding_family_allocates_once_and_fills_ranges() -> Bool:
	center = string_builtin(
		"center",
		[string_param("self", 151), int_param("width", 152), char_param("fill", 153)],
		STRING_TYPE,
	)

	match synthesize_string_body(center):
		Some(body):
			(
				contains_intrinsic(body, "string_alloc")
				and contains_intrinsic(body, "string_set_byte")
				and contains_intrinsic(body, "string_copy_bytes")
				and contains_intrinsic(body, "string_set_len")
				and contains_loop(body)
			)
		None:
			False


pure func test_string_case_and_classification_families_short_circuit() -> Bool:
	title_case = string_builtin("title_case", [string_param("self", 161)], STRING_TYPE)
	is_numeric = string_builtin("is_numeric", [string_param("self", 162)], BOOL_TYPE)

	match (synthesize_string_body(title_case), synthesize_string_body(is_numeric)):
		(Some(title_body), Some(classification_body)):
			(
				contains_intrinsic(title_body, "string_alloc")
				and contains_intrinsic(title_body, "string_get_byte")
				and contains_intrinsic(title_body, "string_set_byte")
				and contains_loop(title_body)
				and contains_intrinsic(classification_body, "string_get_byte")
				and contains_loop(classification_body)
				and contains_break(classification_body)
				and contains_mutable_let(classification_body)
			)
		_:
			False


pure func test_string_comparison_family_scans_and_materializes_results() -> Bool:
	prefix = string_builtin(
		"longest_common_prefix",
		[string_param("left", 171), string_param("right", 172)],
		STRING_TYPE,
	)
	hamming = string_builtin(
		"hamming_distance_raw",
		[string_param("left", 173), string_param("right", 174)],
		INT_TYPE,
	)

	match (synthesize_string_body(prefix), synthesize_string_body(hamming)):
		(Some(prefix_body), Some(hamming_body)):
			(
				contains_intrinsic(prefix_body, "string_get_byte")
				and contains_intrinsic(prefix_body, "string_copy_bytes")
				and contains_loop(prefix_body)
				and contains_intrinsic(hamming_body, "string_get_byte")
				and contains_loop(hamming_body)
				and contains_mutable_let(hamming_body)
			)
		_:
			False


pure func test_string_synthesis_rejects_wrong_identity_and_signatures() -> Bool:
	wrong_module = builtin_function("app/string", "length", [string_param("self", 111)], INT_TYPE)
	wrong_parameter = string_builtin("length", [int_param("self", 112)], INT_TYPE)
	wrong_return = string_builtin("length", [string_param("self", 113)], STRING_TYPE)
	wrong_arity = string_builtin(
		"substring",
		[string_param("self", 114), int_param("start", 115)],
		STRING_TYPE,
	)
	unknown = string_builtin("not_a_string_builtin", [string_param("self", 116)], STRING_TYPE)
	wrong_list_element = string_builtin(
		"split",
		[string_param("self", 117), string_param("delimiter", 118)],
		NamedType(
			"List",
			[INT_TYPE],
		),
	)
	runtime_builtin = string_builtin(
		"append_int",
		[string_param("self", 119), int_param("value", 120)],
		STRING_TYPE,
	)

	(
		synthesize_string_body(wrong_module) == None
		and synthesize_string_body(wrong_parameter) == None
		and synthesize_string_body(wrong_return) == None
		and synthesize_string_body(wrong_arity) == None
		and synthesize_string_body(unknown) == None
		and synthesize_string_body(wrong_list_element) == None
		and synthesize_string_body(runtime_builtin) == None
	)


tests: TestSuite = {
	description = "Compiler Core string synthesis",
	tests = [
		(
			"all string signatures synthesize and preserve parameters",
			test_all_string_signatures_are_synthesized,
		),
		(
			"string search family uses visible Core control flow",
			test_string_search_family_uses_visible_core_control_flow,
		),
		(
			"string allocation family uses exact-size primitives",
			test_string_allocation_family_uses_exact_size_primitives,
		),
		(
			"string append char exposes UTF-8 and capacity logic",
			test_string_append_char_exposes_utf8_and_capacity_logic,
		),
		(
			"string slicing family clamps and copies bytes",
			test_string_slicing_family_clamps_and_copies_bytes,
		),
		(
			"string padding family allocates once and fills ranges",
			test_string_padding_family_allocates_once_and_fills_ranges,
		),
		(
			"string case and classification families short-circuit",
			test_string_case_and_classification_families_short_circuit,
		),
		(
			"string comparison family scans and materializes results",
			test_string_comparison_family_scans_and_materializes_results,
		),
		(
			"string synthesis rejects wrong identity and signatures",
			test_string_synthesis_rejects_wrong_identity_and_signatures,
		),
	]
}
