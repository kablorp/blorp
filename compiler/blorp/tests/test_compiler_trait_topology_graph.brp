private record TraitTopologyFixture {
	bound_graph: CompilerBoundModuleGraph,
	skeleton_graph: CompilerDeclarationSkeletonGraph,
	type_header_graph: CompilerTypeHeaderGraph
}


private pure func module_load_candidate(
	module_path: String,
	source: String,
) -> CompilerModuleLoadCandidate:
	compiler_module_load_candidate(
		compiler_resolved_module_identity_from_resolver(module_path, CompilerUserModule),
		ParserBridge.parsed_typecheck_source_bridge_artifact(
			module_path + ".brp",
			module_path,
			source,
			False,
		).program,
	)


private pure func accept_empty_view(
	scope: CompilerPreparedModuleScope,
) -> CompilerBoundModuleViewBinding:
	CompilerBoundModuleViewReady(
		COMPILER_MODULE_VIEW_EMPTY,
		prepared_module_program(compiler_prepared_module_scope_module(scope)),
		COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
		[],
	)


private pure func accept_imported_base_view(
	scope: CompilerPreparedModuleScope,
) -> CompilerBoundModuleViewBinding:
	program = prepared_module_program(compiler_prepared_module_scope_module(scope))

	if compiler_prepared_module_scope_canonical_path(scope) == "main":
		match compiler_module_view_register_selective_name(
			COMPILER_MODULE_VIEW_EMPTY,
			"ImportedBase",
			"dep",
			"Base",
		):
			CompilerSelectiveNameAdded(view):
				CompilerBoundModuleViewReady(
					view,
					program,
					COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
					[],
				)
			_:
				CompilerBoundModuleViewReady(
					COMPILER_MODULE_VIEW_EMPTY,
					program,
					COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
					[],
				)
	else:
		CompilerBoundModuleViewReady(
			COMPILER_MODULE_VIEW_EMPTY,
			program,
			COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
			[],
		)


private pure func accept_imported_non_trait_view(
	scope: CompilerPreparedModuleScope,
) -> CompilerBoundModuleViewBinding:
	program = prepared_module_program(compiler_prepared_module_scope_module(scope))

	if compiler_prepared_module_scope_canonical_path(scope) == "main":
		match compiler_module_view_register_selective_name(
			COMPILER_MODULE_VIEW_EMPTY,
			"Stringable",
			"dep",
			"Stringable",
		):
			CompilerSelectiveNameAdded(view):
				CompilerBoundModuleViewReady(
					view,
					program,
					COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
					[],
				)
			_:
				CompilerBoundModuleViewReady(
					COMPILER_MODULE_VIEW_EMPTY,
					program,
					COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
					[],
				)
	else:
		CompilerBoundModuleViewReady(
			COMPILER_MODULE_VIEW_EMPTY,
			program,
			COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
			[],
		)


private pure func accept_local_non_trait_view(
	scope: CompilerPreparedModuleScope,
) -> CompilerBoundModuleViewBinding:
	program = prepared_module_program(compiler_prepared_module_scope_module(scope))

	match compiler_module_view_register_local_name(
		COMPILER_MODULE_VIEW_EMPTY,
		"Stringable",
		CompilerTopLevelType,
	):
		CompilerLocalNameAdded(view):
			CompilerBoundModuleViewReady(view, program, COMPILER_BOUND_MODULE_VISIBILITY_EMPTY, [])
		_:
			CompilerBoundModuleViewReady(
				COMPILER_MODULE_VIEW_EMPTY,
				program,
				COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
				[],
			)


private pure func fixture(
	target_source: String,
	dependency_source: Option[String],
) -> Option[TraitTopologyFixture]:
	target = module_load_candidate("main", target_source)

	dependencies: List[CompilerModuleLoadCandidate] = match dependency_source:
		Some(source):
			[module_load_candidate("dep", source)]
		None:
			[]

	indexed ?= compiler_indexed_graph_build(target, dependencies).to_option()

	bound ?= match dependency_source:
		Some(_):
			compiler_bound_module_graph_build(
				indexed,
				["dep"],
				accept_imported_base_view,
			).to_option()
		None:
			compiler_bound_module_graph_build(indexed, [], accept_empty_view).to_option()

	skeletons ?= compiler_declaration_skeleton_graph_build(bound).to_option()
	aliases ?= compiler_type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= compiler_resolved_type_parameter_graph_build(aliases).to_option()
	type_headers ?= compiler_type_header_graph_build(parameters).to_option()
	Some({
		bound_graph = bound,
		skeleton_graph = skeletons,
		type_header_graph = type_headers,
	})


private pure func local_fixture(source: String) -> Option[TraitTopologyFixture]:
	fixture(source, None)


private pure func imported_non_trait_fixture() -> Option[TraitTopologyFixture]:
	target = module_load_candidate("main", "trait Broken: Stringable")
	dependency = module_load_candidate("dep", "record Stringable {value: Int}")
	indexed ?= compiler_indexed_graph_build(target, [dependency]).to_option()
	bound ?= compiler_bound_module_graph_build(
		indexed,
		["dep"],
		accept_imported_non_trait_view,
	).to_option()
	skeletons ?= compiler_declaration_skeleton_graph_build(bound).to_option()
	aliases ?= compiler_type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= compiler_resolved_type_parameter_graph_build(aliases).to_option()
	type_headers ?= compiler_type_header_graph_build(parameters).to_option()
	Some({
		bound_graph = bound,
		skeleton_graph = skeletons,
		type_header_graph = type_headers,
	})


private pure func local_non_trait_fixture() -> Option[TraitTopologyFixture]:
	target = module_load_candidate(
		"main",
		"record Stringable {value: Int}\n\ntrait Broken: Stringable",
	)
	indexed ?= compiler_indexed_graph_build(target, []).to_option()
	bound ?= compiler_bound_module_graph_build(indexed, [], accept_local_non_trait_view).to_option()
	skeletons ?= compiler_declaration_skeleton_graph_build(bound).to_option()
	aliases ?= compiler_type_alias_dependency_graph_validate(skeletons).to_option()
	parameters ?= compiler_resolved_type_parameter_graph_build(aliases).to_option()
	type_headers ?= compiler_type_header_graph_build(parameters).to_option()
	Some({
		bound_graph = bound,
		skeleton_graph = skeletons,
		type_header_graph = type_headers,
	})


private pure func trait_id(
	fixture_value: TraitTopologyFixture,
	name: String,
) -> Option[CompilerTraitId]:
	module_identity = compiler_bound_module_identity(
		compiler_bound_module_graph_target(fixture_value.bound_graph),
	)
	compiler_declaration_skeleton_graph_find_trait(
		fixture_value.skeleton_graph,
		module_identity,
		name,
	).map(
		func(info): info.id,
	)


private pure func dependency_trait_id(
	fixture_value: TraitTopologyFixture,
	name: String,
) -> Option[CompilerTraitId]:
	module ?= compiler_bound_module_graph_find_canonical_path(fixture_value.bound_graph, "dep")
	compiler_declaration_skeleton_graph_find_trait(
		fixture_value.skeleton_graph,
		compiler_bound_module_identity(module),
		name,
	).map(
		func(info): info.id,
	)


private pure func topology_errors(source: String) -> Option[List[String]]:
	fixture_value ?= local_fixture(source)

	match compiler_trait_topology_graph_build(fixture_value.type_header_graph):
		Ok(_):
			Some([])
		Err(errors):
			Some(errors.map(compiler_trait_topology_graph_error_message))


private pure func topology_errors_equal(source: String, expected: List[String]) -> Bool:
	match topology_errors(source):
		Some(actual):
			actual == expected
		None:
			False


private pure func trait_topology_resolves_exact_ids_and_method_categories() -> Option[Bool]:
	source: String =
		|trait Base:
		|	pure func base(self: Self) -> Int
		|
		|trait Derived[T: Base]: Base:
		|	pure func required(self: Self, value: T) -> Int
		|	pure func provided(self: Self) -> Int: 1
	fixture_value ?= local_fixture(source)
	base_id ?= trait_id(fixture_value, "Base")
	derived_id ?= trait_id(fixture_value, "Derived")
	topology ?= compiler_trait_topology_graph_build(fixture_value.type_header_graph).to_option()
	header ?= compiler_trait_topology_graph_find(topology, derived_id)
	parameters = compiler_trait_topology_header_parameters(header)
	methods = compiler_trait_topology_header_methods(header)
	supertrait ?= compiler_trait_topology_header_supertraits(header).get(0)
	parameter ?= parameters.get(0)
	parameter_bound ?= compiler_trait_type_parameter_bounds(parameter).get(0)
	required_method ?= methods.get(0)
	default_method ?= methods.get(1)
	Some(
		(
			compiler_trait_topology_graph_headers(topology).length() == 2
			and compiler_trait_topology_header_supertraits(header).length() == 1
			and compiler_trait_ids_equal(supertrait, base_id)
			and parameters.length() == 1
			and compiler_trait_ids_equal(compiler_trait_type_parameter_owner(parameter), derived_id)
			and compiler_trait_type_parameter_bounds(parameter).length() == 1
			and compiler_trait_ids_equal(parameter_bound, base_id)
			and methods.length() == 2
			and compiler_trait_ids_equal(
				compiler_trait_method_slot_owner(required_method),
				derived_id,
			)
			and compiler_trait_method_slot_category(required_method) == CompilerRequiredTraitMethod
			and compiler_trait_method_slot_category(default_method) == CompilerDefaultTraitMethod
		),
	)


pure func test_trait_topology_resolves_exact_ids_and_method_categories() -> Bool:
	trait_topology_resolves_exact_ids_and_method_categories().get_or(False)


private pure func named_parameter_binder_equals(
	binder: CompilerCallableParameterBinder,
	expected: String,
) -> Bool:
	match binder:
		CompilerNamedParameter(name):
			name == expected
		_:
			False


private pure func trait_method_signature_uses_exact_trait_owned_types() -> Option[Bool]:
	fixture_value ?= local_fixture(
		"trait Mapper[T]:\n\tpure func map(self: Self, value: T, callback: pure (T) -> String) -> String",
	)
	owner ?= trait_id(fixture_value, "Mapper")
	topology ?= compiler_trait_topology_graph_build(fixture_value.type_header_graph).to_option()
	header ?= compiler_trait_topology_graph_find(topology, owner)
	method ?= compiler_trait_topology_header_methods(header).get(0)
	signature = compiler_trait_method_slot_signature(method)
	parameters = compiler_callable_signature_parameters(signature)
	self_parameter ?= parameters.get(0)
	value_parameter ?= parameters.get(1)
	callback_parameter ?= parameters.get(2)

	self_ok = match compiler_callable_parameter_type(self_parameter):
		CompilerTraitSelfTypeShape(self_owner):
			compiler_trait_ids_equal(self_owner, owner)
		_:
			False

	value_ok = match compiler_callable_parameter_type(value_parameter):
		CompilerTraitTypeParameterShape(value_id):
			(
				compiler_trait_ids_equal(compiler_trait_type_parameter_id_owner(value_id), owner)
				and compiler_trait_type_parameter_id_index(value_id) == 0
				and compiler_trait_type_parameter_id_name(value_id) == "T"
			)
		_:
			False

	callback_ok = match compiler_callable_parameter_type(callback_parameter):
		CompilerFunctionTypeShape(True, [CompilerTraitTypeParameterShape(callback_id)], CompilerIntrinsicTypeShape(CompilerIntrinsicString, [])):
			compiler_trait_type_parameter_id_index(callback_id) == 0
		_:
			False

	return_ok = match compiler_callable_signature_return_type(signature):
		CompilerIntrinsicTypeShape(CompilerIntrinsicString, []):
			True
		_:
			False

	Some(
		(
			self_ok
			and value_ok
			and callback_ok
			and return_ok
			and compiler_callable_signature_is_pure(signature)
			and named_parameter_binder_equals(
				compiler_callable_parameter_binder(self_parameter),
				"self",
			)
			and named_parameter_binder_equals(
				compiler_callable_parameter_binder(value_parameter),
				"value",
			)
			and named_parameter_binder_equals(
				compiler_callable_parameter_binder(callback_parameter),
				"callback",
			)
		),
	)


pure func test_trait_method_signature_uses_exact_trait_owned_types() -> Bool:
	trait_method_signature_uses_exact_trait_owned_types().get_or(False)


private pure func trait_method_identity_round_trips() -> Option[Bool]:
	fixture_value ?= local_fixture(
		"trait Numbered:\n\tpure func first(self: Self) -> Int\n\tpure func second(self: Self) -> Int: 2",
	)
	owner ?= trait_id(fixture_value, "Numbered")
	topology ?= compiler_trait_topology_graph_build(fixture_value.type_header_graph).to_option()
	header ?= compiler_trait_topology_graph_find(topology, owner)
	first ?= compiler_trait_topology_header_methods(header).get(0)
	second ?= compiler_trait_topology_header_methods(header).get(1)
	first_id = compiler_trait_method_slot_id(first)
	second_id = compiler_trait_method_slot_id(second)
	found_first ?= compiler_trait_topology_graph_find_method(topology, first_id)
	found_second ?= compiler_trait_topology_graph_find_method(topology, second_id)
	Some(
		(
			compiler_trait_method_id_index(first_id) == 0
			and compiler_trait_method_id_index(second_id) == 1
			and compiler_trait_ids_equal(compiler_trait_method_id_owner(first_id), owner)
			and compiler_trait_ids_equal(compiler_trait_method_id_owner(second_id), owner)
			and not compiler_trait_method_ids_equal(first_id, second_id)
			and compiler_trait_method_ids_equal(
				compiler_trait_method_slot_id(found_first),
				first_id,
			)
			and compiler_trait_method_ids_equal(
				compiler_trait_method_slot_id(found_second),
				second_id,
			)
		),
	)


pure func test_trait_method_identity_round_trips() -> Bool:
	trait_method_identity_round_trips().get_or(False)


private pure func trait_method_lookup_rejects_foreign_id() -> Option[Bool]:
	first_fixture ?= local_fixture("trait First:\n\tpure func first(self: Self) -> Int")
	second_fixture ?= local_fixture("trait Second:\n\tpure func second(self: Self) -> Int")
	first_owner ?= trait_id(first_fixture, "First")
	first_topology ?= compiler_trait_topology_graph_build(
		first_fixture.type_header_graph,
	).to_option()
	first_header ?= compiler_trait_topology_graph_find(first_topology, first_owner)
	first_method ?= compiler_trait_topology_header_methods(first_header).get(0)
	second_topology ?= compiler_trait_topology_graph_build(
		second_fixture.type_header_graph,
	).to_option()
	Some(
		compiler_trait_topology_graph_find_method(
			second_topology,
			compiler_trait_method_slot_id(first_method),
		).is_none(),
	)


pure func test_trait_method_lookup_rejects_foreign_id() -> Bool:
	trait_method_lookup_rejects_foreign_id().get_or(False)


private pure func trait_topology_transitive_supertraits_are_deterministic() -> Option[Bool]:
	source: String =
		|trait Root:
		|	pure func root(self: Self) -> Int
		|
		|trait Left: Root:
		|	pure func left(self: Self) -> Int
		|
		|trait Right: Root:
		|	pure func right(self: Self) -> Int
		|
		|trait Leaf: Left + Right:
		|	pure func leaf(self: Self) -> Int
	fixture_value ?= local_fixture(source)
	leaf ?= trait_id(fixture_value, "Leaf")
	topology ?= compiler_trait_topology_graph_build(fixture_value.type_header_graph).to_option()
	supertraits ?= compiler_trait_topology_graph_transitive_supertraits(topology, leaf)
	Some(supertraits.map(func(id): compiler_trait_id_name(id)) == ["Left", "Root", "Right"])


pure func test_trait_topology_transitive_supertraits_are_deterministic() -> Bool:
	trait_topology_transitive_supertraits_are_deterministic().get_or(False)


private pure func trait_topology_transitive_supertraits_reject_foreign_id() -> Option[Bool]:
	first_fixture ?= local_fixture("trait First:\n\tpure func first(self: Self) -> Int")
	second_fixture ?= local_fixture("trait Second:\n\tpure func second(self: Self) -> Int")
	first_id ?= trait_id(first_fixture, "First")
	second_topology ?= compiler_trait_topology_graph_build(
		second_fixture.type_header_graph,
	).to_option()
	Some(compiler_trait_topology_graph_transitive_supertraits(second_topology, first_id).is_none())


pure func test_trait_topology_transitive_supertraits_reject_foreign_id() -> Bool:
	trait_topology_transitive_supertraits_reject_foreign_id().get_or(False)


private pure func synthetic_prelude_transitive_supertraits_are_complete() -> Option[Bool]:
	fixture_value ?= local_fixture(
		"trait Sorted: Orderable:\n\tpure func sorted(self: Self) -> Bool",
	)
	sorted ?= trait_id(fixture_value, "Sorted")
	topology ?= compiler_trait_topology_graph_build(fixture_value.type_header_graph).to_option()
	supertraits ?= compiler_trait_topology_graph_transitive_supertraits(topology, sorted)
	Some(supertraits.map(compiler_trait_id_name) == ["Orderable", "Equatable"])


pure func test_synthetic_prelude_transitive_supertraits_are_complete() -> Bool:
	synthetic_prelude_transitive_supertraits_are_complete().get_or(False)


pure func test_builtin_trait_cycle_diagnostic_is_internal_and_unlocated() -> Bool:
	(
		compiler_trait_topology_graph_error_message(
			CompilerBuiltinTraitTopologyCycle,
		) == "compiler builtin trait inheritance contains a cycle"
		and compiler_trait_topology_graph_error_span(CompilerBuiltinTraitTopologyCycle).is_none()
	)


private pure func trait_topology_resolves_imported_alias_to_exact_id() -> Option[Bool]:
	target_source: String =
		|import:
		|	dep: Base as ImportedBase
		|
		|trait Base:
		|	pure func local_base(self: Self) -> Int
		|
		|trait Child: ImportedBase:
		|	pure func child(self: Self) -> Int
	dependency_source: String =
		|trait Base:
		|	pure func base(self: Self) -> Int
	fixture_value ?= fixture(target_source, Some(dependency_source))
	child_id ?= trait_id(fixture_value, "Child")
	local_base_id ?= trait_id(fixture_value, "Base")
	base_id ?= dependency_trait_id(fixture_value, "Base")
	topology ?= compiler_trait_topology_graph_build(fixture_value.type_header_graph).to_option()
	header ?= compiler_trait_topology_graph_find(topology, child_id)
	local_base_header ?= compiler_trait_topology_graph_find(topology, local_base_id)
	imported_base_header ?= compiler_trait_topology_graph_find(topology, base_id)
	supertraits = compiler_trait_topology_header_supertraits(header)
	supertrait ?= supertraits.get(0)
	Some(
		(
			supertraits.length() == 1
			and compiler_trait_ids_equal(supertrait, base_id)
			and not compiler_trait_ids_equal(local_base_id, base_id)
			and not compiler_trait_ids_equal(supertrait, child_id)
			and compiler_trait_topology_header_methods(local_base_header).length() == 1
			and compiler_trait_topology_header_methods(imported_base_header).length() == 1
		),
	)


pure func test_trait_topology_resolves_imported_alias_to_exact_id() -> Bool:
	trait_topology_resolves_imported_alias_to_exact_id().get_or(False)


private pure func compiler_surface_trait_ids_are_disjoint() -> Option[Bool]:
	equatable ?= compiler_prelude_trait_id("Equatable")
	stringable ?= compiler_prelude_trait_id("Stringable")
	compiler_surface = compiler_module_identity_for_compiler_surface("prelude-traits")
	loaded_surface = compiler_module_identity_from_resolved(
		compiler_resolved_module_identity_from_resolver(
			"<compiler:prelude-traits>",
			CompilerUserModule,
		),
	)
	Some(
		(
			compiler_prelude_trait_id("NotAPreludeTrait").is_none()
			and not compiler_trait_ids_equal(equatable, stringable)
			and compiler_module_identities_equal(
				compiler_trait_id_module_identity(equatable),
				compiler_surface,
			)
			and not compiler_module_identities_equal(compiler_surface, loaded_surface)
			and compiler_module_identity_storage_key(
				compiler_surface,
			) != compiler_module_identity_storage_key(loaded_surface)
			and compiler_module_identity_display_name(
				compiler_surface,
			) == "<compiler:prelude-traits>"
		),
	)


pure func test_compiler_surface_trait_ids_are_disjoint() -> Bool:
	compiler_surface_trait_ids_are_disjoint().get_or(False)


pure func test_trait_topology_rejects_unknown_references() -> Bool:
	source: String =
		|trait Broken[T: MissingBound]: MissingParent:
		|	pure func broken(self: Self) -> Int
	topology_errors_equal(
		source,
		[
			"trait 'Broken' has unknown supertrait 'MissingParent'",
			"trait 'Broken' type parameter 'T' has unknown bound 'MissingBound'",
		],
	)


pure func test_trait_topology_accepts_compiler_builtin_without_import() -> Bool:
	topology_errors_equal("trait NumericValue: Addable", [])


private pure func imported_non_trait_does_not_fall_back_to_builtin() -> Option[Bool]:
	fixture_value ?= imported_non_trait_fixture()

	match compiler_trait_topology_graph_build(fixture_value.type_header_graph):
		Ok(_):
			Some(False)
		Err(errors):
			Some(
				errors.map(
					compiler_trait_topology_graph_error_message,
				) == ["trait 'Broken' has unknown supertrait 'Stringable'"],
			)


pure func test_imported_non_trait_does_not_fall_back_to_builtin() -> Bool:
	imported_non_trait_does_not_fall_back_to_builtin().get_or(False)


private pure func local_non_trait_does_not_fall_back_to_builtin() -> Option[Bool]:
	fixture_value ?= local_non_trait_fixture()

	match compiler_trait_topology_graph_build(fixture_value.type_header_graph):
		Ok(_):
			Some(False)
		Err(errors):
			Some(
				errors.map(
					compiler_trait_topology_graph_error_message,
				) == ["trait 'Broken' has unknown supertrait 'Stringable'"],
			)


pure func test_local_non_trait_does_not_fall_back_to_builtin() -> Bool:
	local_non_trait_does_not_fall_back_to_builtin().get_or(False)


private pure func trait_topology_error_spans_are_precise() -> Option[Bool]:
	fixture_value ?= local_fixture(
		"trait Broken[T: MissingBound]: MissingParent:\n\tpure func broken(self: Self) -> Int",
	)

	match compiler_trait_topology_graph_build(fixture_value.type_header_graph):
		Ok(_):
			Some(False)
		Err(errors):
			first ?= errors.get(0)
			second ?= errors.get(1)
			first_span ?= compiler_trait_topology_graph_error_span(first)
			second_span ?= compiler_trait_topology_graph_error_span(second)
			Some(
				(
					first_span.path == "main.brp"
					and first_span.start_line == 1
					and second_span.path == "main.brp"
					and second_span.start_line == 1
					and first_span.start_column != second_span.start_column
				),
			)


pure func test_trait_topology_errors_retain_reference_spans() -> Bool:
	trait_topology_error_spans_are_precise().get_or(False)


private pure func trait_method_type_error_retains_type_span() -> Option[Bool]:
	fixture_value ?= local_fixture(
		"trait Broken:\n\tpure func broken(self: Self, value: MissingType) -> Int",
	)

	match compiler_trait_topology_graph_build(fixture_value.type_header_graph):
		Ok(_):
			Some(False)
		Err(errors):
			error ?= errors.get(0)
			span ?= compiler_trait_topology_graph_error_span(error)
			Some(
				(
					compiler_trait_topology_graph_error_message(
						error,
					) == "Unknown type 'MissingType' while resolving 'Broken.broken'"
					and span.path == "main.brp"
					and span.start_line == 2
					and span.start_column > 1
				),
			)


pure func test_trait_method_type_error_retains_type_span() -> Bool:
	trait_method_type_error_retains_type_span().get_or(False)


private pure func trait_cycle_error_uses_closing_edge_span() -> Option[Bool]:
	fixture_value ?= local_fixture("trait Alpha: Beta\n\ntrait Beta: Gamma\n\ntrait Gamma: Alpha")

	match compiler_trait_topology_graph_build(fixture_value.type_header_graph):
		Ok(_):
			Some(False)
		Err(errors):
			error ?= errors.get(0)
			span ?= compiler_trait_topology_graph_error_span(error)
			Some(span.path == "main.brp" and span.start_line == 5 and span.start_column == 14)


pure func test_trait_cycle_error_uses_closing_edge_span() -> Bool:
	trait_cycle_error_uses_closing_edge_span().get_or(False)


pure func test_trait_topology_rejects_duplicate_method_names() -> Bool:
	source: String =
		|trait Broken:
		|	pure func duplicate(self: Self) -> Int
		|	pure func duplicate(self: Self, value: Int) -> Int
	topology_errors_equal(source, ["trait 'Broken' declares method 'duplicate' more than once"])


pure func test_trait_topology_rejects_duplicate_edges_and_parameters() -> Bool:
	source: String =
		|trait Base:
		|	pure func base(self: Self) -> Int
		|
		|trait Broken[T, T]: Base + Base:
		|	pure func broken(self: Self) -> Int
	topology_errors_equal(
		source,
		[
			"trait 'Broken' names supertrait 'Base' more than once",
			"trait 'Broken' declares type parameter 'T' more than once",
		],
	)


pure func test_trait_topology_rejects_cycles_deterministically() -> Bool:
	source: String =
		|trait Alpha: Beta
		|
		|trait Beta: Gamma
		|
		|trait Gamma: Alpha
	topology_errors_equal(source, ["trait inheritance cycle: Alpha -> Beta -> Gamma -> Alpha"])


tests: TestSuite = {
	description = "Compiler trait topology graph",
	tests = [
		(
			"resolves exact ids and method categories",
			test_trait_topology_resolves_exact_ids_and_method_categories,
		),
		(
			"trait method signatures use exact trait-owned types",
			test_trait_method_signature_uses_exact_trait_owned_types,
		),
		("trait method identity round trips", test_trait_method_identity_round_trips),
		("method lookup rejects a foreign id", test_trait_method_lookup_rejects_foreign_id),
		(
			"transitive supertraits are deterministic",
			test_trait_topology_transitive_supertraits_are_deterministic,
		),
		(
			"transitive supertraits reject a foreign id",
			test_trait_topology_transitive_supertraits_reject_foreign_id,
		),
		(
			"synthetic prelude transitive supertraits are complete",
			test_synthetic_prelude_transitive_supertraits_are_complete,
		),
		(
			"builtin trait cycle diagnostic is internal and unlocated",
			test_builtin_trait_cycle_diagnostic_is_internal_and_unlocated,
		),
		(
			"resolves imported aliases to exact ids",
			test_trait_topology_resolves_imported_alias_to_exact_id,
		),
		("compiler surface ids are disjoint", test_compiler_surface_trait_ids_are_disjoint),
		("rejects unknown references", test_trait_topology_rejects_unknown_references),
		(
			"accepts compiler builtin without import",
			test_trait_topology_accepts_compiler_builtin_without_import,
		),
		(
			"imported non-trait does not fall back to builtin",
			test_imported_non_trait_does_not_fall_back_to_builtin,
		),
		(
			"local non-trait does not fall back to builtin",
			test_local_non_trait_does_not_fall_back_to_builtin,
		),
		("errors retain reference spans", test_trait_topology_errors_retain_reference_spans),
		("method type errors retain type spans", test_trait_method_type_error_retains_type_span),
		("cycle error uses closing edge span", test_trait_cycle_error_uses_closing_edge_span),
		("rejects duplicate method names", test_trait_topology_rejects_duplicate_method_names),
		(
			"rejects duplicate edges and parameters",
			test_trait_topology_rejects_duplicate_edges_and_parameters,
		),
		("rejects cycles deterministically", test_trait_topology_rejects_cycles_deterministically),
	]
}
