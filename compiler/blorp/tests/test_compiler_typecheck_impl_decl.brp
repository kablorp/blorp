import:
	../src/stage_01_file_io/compiler_source:
		CompilerCursor,
		CompilerSourceFile,
		CompilerSourceSpan,
		compiler_source_cursor_at,
		compiler_source_file,
		compiler_source_span,
	../src/stage_03_parse/compiler_parsed_ast:
		ParsedDecl(
			FunctionParsedDecl,
			ImplParsedDecl,
			PrivateParsedDecl,
			RecordParsedDecl,
			TraitParsedDecl,
		),
		ParsedExpr(ParsedCallExpr, ParsedIntLiteralExpr, ParsedNameExpr, ParsedStringLiteralExpr),
		ParsedFunctionDecl,
		ParsedIdentifier,
		ParsedParam,
		ParsedParamBinder(ParsedParamNameBinder),
		ParsedProgram,
		ParsedStringLiteralForm(ParsedPlainStringLiteral),
		ParsedTraitMethodDecl,
		ParsedTypeExpr(ParsedBoundedType, ParsedNamedType),
		parsed_identifier,
	../src/stage_05_types/compiler_env: ImplInstance, env_get_trait
	../src/stage_05_types/compiler_generic_params: bound_type_param_name
	../src/stage_05_types/compiler_type:
		CompilerType(CompilerNamedType, CompilerTypeVar),
		compiler_types_equal,
	../src/stage_06_typecheck/compiler_typecheck_decl:
		compiler_typecheck_check_program_bodies,
		compiler_typecheck_prescan_program,
		compiler_typecheck_register_program_impl_decls,
		compiler_typecheck_register_program_signature_decls,
		compiler_typecheck_register_program_type_decls,
	../src/stage_06_typecheck/compiler_typecheck_state:
		CompilerTypecheckState,
		compiler_typecheck_state_empty,
		compiler_typecheck_state_record_type_home,
	test: TestSuite


pure func source_file_named(module_name: String) -> CompilerSourceFile:
	compiler_source_file(module_name + ".brp", module_name, "func main(): 1")


pure func source_span() -> CompilerSourceSpan:
	src: CompilerSourceFile = source_file_named("decl")
	cursor: CompilerCursor = compiler_source_cursor_at(src, 0)
	compiler_source_span(src, cursor, cursor)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, source_span())


pure func named_type(name: String) -> ParsedTypeExpr:
	ParsedNamedType(ident(name), [], source_span())


pure func generic_named_type(name: String, args: List[ParsedTypeExpr]) -> ParsedTypeExpr:
	ParsedNamedType(ident(name), args, source_span())


pure func bounded_type(name: String, bounds: List[String]) -> ParsedTypeExpr:
	ParsedBoundedType(
		ident(name),
		bounds.map(ident),
		source_span(),
	)


pure func int_type() -> ParsedTypeExpr:
	named_type("Int")


pure func string_type() -> ParsedTypeExpr:
	named_type("String")


pure func int_expr() -> ParsedExpr:
	ParsedIntLiteralExpr("1", source_span())


pure func string_expr() -> ParsedExpr:
	ParsedStringLiteralExpr("text", ParsedPlainStringLiteral, source_span())


pure func name_expr(name: String) -> ParsedExpr:
	ParsedNameExpr(ident(name))


pure func call_expr(name: String, args: List[ParsedExpr]) -> ParsedExpr:
	ParsedCallExpr(name_expr(name), args, source_span())


pure func named_param(name: String, type_expr: ParsedTypeExpr) -> ParsedParam:
	{
		binder = ParsedParamNameBinder(ident(name)),
		type_expr = Some(type_expr),
		span = source_span()
	}


pure func function_decl_with_body(
	name: String,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	body: ParsedExpr,
	is_pure: Bool,
) -> ParsedFunctionDecl:
	{
		name = ident(name),
		keyword_span = Some(source_span()),
		type_params = [],
		params = params,
		return_type = return_type,
		dim_constraints = [],
		body = Some(body),
		is_pure = is_pure,
		annotations = [],
		doc = None,
		span = source_span()
	}


pure func function_decl_parsed(
	name: String,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	body: ParsedExpr,
	is_pure: Bool,
) -> ParsedDecl:
	FunctionParsedDecl(function_decl_with_body(name, params, return_type, body, is_pure))


pure func record_decl(name: String) -> ParsedDecl:
	RecordParsedDecl({
		name = ident(name),
		type_params = [],
		fields = [],
		is_struct = False,
		doc = None,
		span = source_span(),
	})


pure func trait_decl(name: String) -> ParsedDecl:
	trait_decl_with_details(name, [], [])


pure func trait_method_decl(
	name: String,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	is_pure: Bool,
	has_default: Bool,
) -> ParsedTraitMethodDecl:
	body: Option[ParsedExpr] = if has_default:
		Some(int_expr())
	else:
		None

	{
		name = ident(name),
		params = params,
		return_type = return_type,
		body = body,
		is_pure = is_pure,
		span = source_span()
	}


pure func trait_decl_with_details(
	name: String,
	supertraits: List[String],
	methods: List[ParsedTraitMethodDecl],
) -> ParsedDecl:
	TraitParsedDecl({
		name = ident(name),
		type_params = [],
		supertraits = supertraits.map(ident),
		methods = methods,
		doc = None,
		span = source_span(),
	})


pure func impl_decl_with_methods(
	trait_name: String,
	for_type: ParsedTypeExpr,
	methods: List[ParsedFunctionDecl],
) -> ParsedDecl:
	ImplParsedDecl({
		trait_name = ident(trait_name),
		for_type = for_type,
		methods = methods,
		doc = None,
		span = source_span(),
	})


pure func impl_decl(trait_name: String, for_type: ParsedTypeExpr) -> ParsedDecl:
	impl_decl_with_methods(trait_name, for_type, [])


pure func private_impl_decl(trait_name: String, for_type: ParsedTypeExpr) -> ParsedDecl:
	PrivateParsedDecl(
		impl_decl(trait_name, for_type),
		source_span(),
	)


pure func program_named(module_name: String, decls: List[ParsedDecl]) -> ParsedProgram:
	{
		source = source_file_named(module_name),
		decls = decls,
		diagnostics = []
	}


pure func program(decls: List[ParsedDecl]) -> ParsedProgram:
	program_named("decl", decls)


pure func has_impl_for_type(
	instances: List[ImplInstance],
	trait_name: String,
	for_type: CompilerType,
) -> Bool:
	var found = False

	for instance in instances:
		if (
			instance.trait_name == trait_name
			and not instance.is_builtin
			and compiler_types_equal(instance.for_type, for_type)
		):
			found = True
			break

	found


pure func has_impl_with_bound(
	instances: List[ImplInstance],
	trait_name: String,
	for_type: CompilerType,
	bound_name: String,
) -> Bool:
	var found = False

	for instance in instances:
		if (
			instance.trait_name == trait_name
			and not instance.is_builtin
			and compiler_types_equal(instance.for_type, for_type)
			and instance.bounds.map(bound_type_param_name) == [bound_name]
		):
			found = True
			break

	found


pure func has_impl_with_trait_bound(
	instances: List[ImplInstance],
	trait_name: String,
	for_type: CompilerType,
	bound_name: String,
	required_trait: String,
) -> Bool:
	var found = False

	for instance in instances:
		if (
			instance.trait_name == trait_name
			and not instance.is_builtin
			and compiler_types_equal(instance.for_type, for_type)
			and instance.bounds.length() == 1
		):
			match instance.bounds.get(0):
				Some(bound):
					found = (
						bound.name == bound_name
						and bound.bounds.map(func(trait_ref): trait_ref) == [required_trait]
					)
				None:
					void

		if found:
			break

	found


pure func index_types_and_signatures(source_program: ParsedProgram) -> CompilerTypecheckState:
	compiler_typecheck_register_program_signature_decls(
		compiler_typecheck_register_program_type_decls(
			compiler_typecheck_prescan_program(compiler_typecheck_state_empty(), source_program),
			source_program,
		),
		source_program,
	)


pure func index_program_headers(source_program: ParsedProgram) -> CompilerTypecheckState:
	compiler_typecheck_register_program_impl_decls(
		index_types_and_signatures(source_program),
		source_program,
	)


func test_registers_public_and_private_impl_headers() -> Bool:
	source_program = program([
		trait_decl("CheckpointDisplay"),
		trait_decl("CheckpointHidden"),
		record_decl("CheckpointWidget"),
		record_decl("CheckpointSecret"),
		impl_decl("CheckpointDisplay", named_type("CheckpointWidget")),
		private_impl_decl("CheckpointHidden", named_type("CheckpointSecret")),
	])
	base_state = index_types_and_signatures(source_program)
	state = compiler_typecheck_register_program_impl_decls(base_state, source_program)

	trait_home_ok: Bool = match env_get_trait(state.env, "CheckpointDisplay"):
		Some(trait_def):
			trait_def.module_path == Some("decl")
		None:
			False

	(
		state.errors.length() == 0
		and state.env.impls.length() == base_state.env.impls.length() + 1
		and state.private_impls.length() == 1
		and trait_home_ok
		and has_impl_for_type(
			state.env.impls,
			"CheckpointDisplay",
			CompilerNamedType("CheckpointWidget", []),
		)
		and has_impl_for_type(
			state.private_impls,
			"CheckpointHidden",
			CompilerNamedType("CheckpointSecret", []),
		)
	)


func test_registers_generic_impl_bounds_from_for_type() -> Bool:
	source_program = program([
		trait_decl("CheckpointPrintable"),
		record_decl("CheckpointBox"),
		impl_decl(
			"CheckpointPrintable",
			generic_named_type("CheckpointBox", [named_type("T")]),
		),
	])
	base_state = index_types_and_signatures(source_program)
	state = compiler_typecheck_register_program_impl_decls(base_state, source_program)

	state.errors.length() == 0 and has_impl_with_bound(
		state.env.impls,
		"CheckpointPrintable",
		CompilerNamedType("CheckpointBox", [CompilerTypeVar("T")]),
		"T",
	)


func test_registers_generic_impl_inline_trait_bounds() -> Bool:
	source_program = program([
		trait_decl("CheckpointPrintable"),
		trait_decl("CheckpointShowable"),
		record_decl("CheckpointBox"),
		impl_decl(
			"CheckpointPrintable",
			generic_named_type("CheckpointBox", [bounded_type("T", ["CheckpointShowable"])]),
		),
	])
	base_state = index_types_and_signatures(source_program)
	state = compiler_typecheck_register_program_impl_decls(base_state, source_program)

	state.errors.length() == 0 and has_impl_with_trait_bound(
		state.env.impls,
		"CheckpointPrintable",
		CompilerNamedType("CheckpointBox", [CompilerTypeVar("T")]),
		"T",
		"CheckpointShowable",
	)


func test_impl_registration_reports_public_and_private_conflicts() -> Bool:
	public_program = program([
		trait_decl("CheckpointDisplay"),
		record_decl("CheckpointWidget"),
		impl_decl("CheckpointDisplay", named_type("CheckpointWidget")),
		impl_decl("CheckpointDisplay", named_type("CheckpointWidget")),
	])
	public_base = index_types_and_signatures(public_program)
	public_state = compiler_typecheck_register_program_impl_decls(public_base, public_program)

	private_program = program([
		trait_decl("CheckpointHidden"),
		record_decl("CheckpointSecret"),
		private_impl_decl("CheckpointHidden", named_type("CheckpointSecret")),
		private_impl_decl("CheckpointHidden", named_type("CheckpointSecret")),
	])
	private_base = index_types_and_signatures(private_program)
	private_state = compiler_typecheck_register_program_impl_decls(private_base, private_program)

	(
		public_state.env.impls.length() == public_base.env.impls.length() + 1
		and public_state.errors.length() == 1
		and public_state.errors
			.get_or(0, "")
			.contains("conflicting implementation of trait 'CheckpointDisplay'")
		and private_state.private_impls.length() == 1
		and private_state.errors.length() == 1
		and private_state.errors
			.get_or(0, "")
			.contains("conflicting implementation of trait 'CheckpointHidden'")
	)


func test_impl_registration_reports_orphan_impls_when_homes_are_known() -> Bool:
	trait_program = program_named("other/traits", [trait_decl("ExternalTrait")])
	var state = compiler_typecheck_register_program_signature_decls(
		compiler_typecheck_prescan_program(compiler_typecheck_state_empty(), trait_program),
		trait_program,
	)
	state = compiler_typecheck_state_record_type_home(state, "ExternalBox", "other/types", True)
	base_impl_count = state.env.impls.length()
	impl_program = program_named(
		"local/app",
		[impl_decl("ExternalTrait", named_type("ExternalBox"))],
	)
	state = compiler_typecheck_register_program_impl_decls(state, impl_program)

	(
		state.errors.length() == 1
		and state.errors
			.get_or(0, "")
			.contains("orphan impl")
		and state.env.impls.length() == base_impl_count + 1
	)


func test_impl_method_body_reports_wrong_return_type() -> Bool:
	source_program = program([
		trait_decl("CheckpointDisplay"),
		record_decl("CheckpointWidget"),
		impl_decl_with_methods(
			"CheckpointDisplay",
			named_type("CheckpointWidget"),
			[
				function_decl_with_body(
					"show",
					[named_param("value", named_type("CheckpointWidget"))],
					Some(int_type()),
					string_expr(),
					False,
				),
			],
		),
	])
	state = compiler_typecheck_check_program_bodies(
		index_program_headers(source_program),
		source_program,
	)

	(
		state.errors.length() == 1
		and state.errors
			.get_or(0, "")
			.contains("Function 'show' returns wrong type")
	)


func test_core_trait_is_visible_for_user_owned_impl() -> Bool:
	source_program = program([
		record_decl("CheckpointWidget"),
		impl_decl_with_methods(
			"Stringable",
			named_type("CheckpointWidget"),
			[
				function_decl_with_body(
					"to_string",
					[named_param("value", named_type("CheckpointWidget"))],
					Some(string_type()),
					string_expr(),
					True,
				),
			],
		),
	])
	state = compiler_typecheck_check_program_bodies(
		index_program_headers(source_program),
		source_program,
	)

	state.errors.length() == 0


func test_pure_impl_method_body_rejects_impure_call() -> Bool:
	source_program = program([
		trait_decl("CheckpointDisplay"),
		record_decl("CheckpointWidget"),
		function_decl_parsed("impure_value", [], Some(int_type()), int_expr(), False),
		impl_decl_with_methods(
			"CheckpointDisplay",
			named_type("CheckpointWidget"),
			[function_decl_with_body(
					"show",
					[named_param("value", named_type("CheckpointWidget"))],
					Some(int_type()),
					call_expr("impure_value", []),
					True,
				)],
		),
	])
	state = compiler_typecheck_check_program_bodies(
		index_program_headers(source_program),
		source_program,
	)

	(
		state.errors.length() == 1
		and state.errors
			.get_or(0, "")
			.contains("Pure function 'show' cannot call impure function 'impure_value'")
	)


func test_impl_validation_reports_missing_required_method() -> Bool:
	source_program = program([
		trait_decl_with_details(
			"CheckpointDisplay",
			[],
			[
				trait_method_decl(
					"show",
					[named_param("value", named_type("Self"))],
					Some(string_type()),
					True,
					False,
				),
			],
		),
		record_decl("CheckpointWidget"),
		impl_decl("CheckpointDisplay", named_type("CheckpointWidget")),
	])
	state = compiler_typecheck_check_program_bodies(
		index_program_headers(source_program),
		source_program,
	)

	(
		state.errors.length() == 1
		and state.errors
			.get_or(0, "")
			.contains("impl CheckpointDisplay for CheckpointWidget: missing required method 'show'")
	)


func test_impl_validation_reports_unsatisfied_supertrait() -> Bool:
	source_program = program([
		trait_decl("CheckpointStringable"),
		trait_decl_with_details("CheckpointDisplay", ["CheckpointStringable"], []),
		record_decl("CheckpointWidget"),
		impl_decl("CheckpointDisplay", named_type("CheckpointWidget")),
	])
	state = compiler_typecheck_check_program_bodies(
		index_program_headers(source_program),
		source_program,
	)

	(
		state.errors.length() == 1
		and state.errors
			.get_or(0, "")
			.contains((
					"impl CheckpointDisplay for CheckpointWidget: supertrait 'CheckpointStringable' "
					+ "is not implemented"
				))
	)


func test_impl_validation_accepts_explicit_supertrait_impl() -> Bool:
	source_program = program([
		trait_decl("CheckpointStringable"),
		trait_decl_with_details("CheckpointDisplay", ["CheckpointStringable"], []),
		record_decl("CheckpointWidget"),
		impl_decl("CheckpointStringable", named_type("CheckpointWidget")),
		impl_decl("CheckpointDisplay", named_type("CheckpointWidget")),
	])
	state = compiler_typecheck_check_program_bodies(
		index_program_headers(source_program),
		source_program,
	)

	state.errors.length() == 0


func test_impl_validation_accepts_supertrait_from_inline_bound() -> Bool:
	source_program = program([
		trait_decl("CheckpointStringable"),
		trait_decl_with_details("CheckpointDisplay", ["CheckpointStringable"], []),
		impl_decl(
			"CheckpointDisplay",
			bounded_type("T", ["CheckpointStringable"]),
		),
	])
	state = compiler_typecheck_check_program_bodies(
		index_program_headers(source_program),
		source_program,
	)

	state.errors.length() == 0


func test_impl_validation_reports_method_signature_mismatch() -> Bool:
	source_program = program([
		trait_decl_with_details(
			"CheckpointDisplay",
			[],
			[
				trait_method_decl(
					"show",
					[named_param("value", named_type("Self"))],
					Some(string_type()),
					True,
					False,
				),
			],
		),
		record_decl("CheckpointWidget"),
		impl_decl_with_methods(
			"CheckpointDisplay",
			named_type("CheckpointWidget"),
			[
				function_decl_with_body(
					"show",
					[named_param("value", int_type())],
					Some(string_type()),
					string_expr(),
					False,
				),
			],
		),
	])
	state = compiler_typecheck_check_program_bodies(
		index_program_headers(source_program),
		source_program,
	)

	(
		state.errors.length() == 2
		and state.errors
			.get_or(0, "")
			.contains("impl CheckpointDisplay for CheckpointWidget: method 'show' must be pure")
		and state.errors
			.get_or(1, "")
			.contains((
					"impl CheckpointDisplay for CheckpointWidget: method 'show' parameter 'value' "
					+ "has type Int, trait requires CheckpointWidget"
				))
	)


tests: TestSuite = {
	description = "Compiler typecheck impl declaration indexing",
	tests = [
		(
			"registers public and private impl headers",
			test_registers_public_and_private_impl_headers,
		),
		(
			"registers generic impl bounds from for type",
			test_registers_generic_impl_bounds_from_for_type,
		),
		(
			"registers generic impl inline trait bounds",
			test_registers_generic_impl_inline_trait_bounds,
		),
		(
			"impl registration reports public and private conflicts",
			test_impl_registration_reports_public_and_private_conflicts,
		),
		(
			"impl registration reports orphan impls when homes are known",
			test_impl_registration_reports_orphan_impls_when_homes_are_known,
		),
		(
			"impl method body reports wrong return type",
			test_impl_method_body_reports_wrong_return_type,
		),
		(
			"core trait is visible for user-owned impl",
			test_core_trait_is_visible_for_user_owned_impl,
		),
		(
			"pure impl method body rejects impure call",
			test_pure_impl_method_body_rejects_impure_call,
		),
		(
			"impl validation reports missing required method",
			test_impl_validation_reports_missing_required_method,
		),
		(
			"impl validation reports unsatisfied supertrait",
			test_impl_validation_reports_unsatisfied_supertrait,
		),
		(
			"impl validation accepts explicit supertrait impl",
			test_impl_validation_accepts_explicit_supertrait_impl,
		),
		(
			"impl validation accepts supertrait from inline bound",
			test_impl_validation_accepts_supertrait_from_inline_bound,
		),
		(
			"impl validation reports method signature mismatch",
			test_impl_validation_reports_method_signature_mismatch,
		),
	]
}
