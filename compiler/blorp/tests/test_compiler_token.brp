import:
	../src/stage_01_file_io/source:
		CompilerCursor,
		CompilerSourceFile,
		CompilerSourceSpan,
		compiler_source_cursor_at,
		compiler_source_file,
		compiler_source_span,
	../src/stage_02_lex/token:
		CompilerKeyword(FuncKeyword),
		CompilerSymbol(LeftParenSymbol),
		CompilerToken,
		CompilerTokenKind(EndOfFileToken, IdentifierToken, KeywordToken, SymbolToken),
		CompilerTrivia,
		CompilerTriviaKind(CommentTrivia, WhitespaceTrivia),
		compiler_keyword_text,
		compiler_symbol_text,
		compiler_token,
		compiler_token_kind_name,
		compiler_token_text,
		compiler_token_with_trivia,
		compiler_trivia,
	test: TestSuite


pure func source_file() -> CompilerSourceFile:
	compiler_source_file("tokens.brp", "tokens", "func main -- doc")


pure func span_between(
	src: CompilerSourceFile,
	start_offset: Int,
	end_offset: Int,
) -> CompilerSourceSpan:
	start: CompilerCursor = compiler_source_cursor_at(src, start_offset)
	finish: CompilerCursor = compiler_source_cursor_at(src, end_offset)
	compiler_source_span(src, start, finish)


func test_keyword_and_symbol_text() -> Bool:
	compiler_keyword_text(FuncKeyword) == "func" and compiler_symbol_text(LeftParenSymbol) == "("


func test_token_text_comes_from_span() -> Bool:
	src: CompilerSourceFile = source_file()
	token: CompilerToken = compiler_token(
		KeywordToken(FuncKeyword),
		span_between(src, 0, 4),
	)

	(
		compiler_token_text(src, token) == "func"
		and compiler_token_kind_name(token.kind) == "keyword func"
	)


func test_token_trivia_is_explicit() -> Bool:
	src: CompilerSourceFile = source_file()
	leading: CompilerTrivia = compiler_trivia(
		WhitespaceTrivia,
		" ",
		span_between(src, 4, 5),
	)
	trailing: CompilerTrivia = compiler_trivia(
		CommentTrivia,
		"-- doc",
		span_between(src, 10, 16),
	)
	token: CompilerToken = compiler_token_with_trivia(
		IdentifierToken("main"),
		span_between(src, 5, 9),
		[leading],
		[trailing],
	)

	(
		token.leading_trivia.length() == 1
		and token.trailing_trivia.length() == 1
		and compiler_token_text(src, token) == "main"
	)


func test_eof_token_has_name() -> Bool:
	src: CompilerSourceFile = source_file()
	token: CompilerToken = compiler_token(
		EndOfFileToken,
		span_between(src, src.text.length(), src.text.length()),
	)
	compiler_token_kind_name(token.kind) == "end of file"


tests: TestSuite = {
	description = "Compiler token foundation",
	tests = [
		("keyword and symbol text", test_keyword_and_symbol_text),
		("token text comes from span", test_token_text_comes_from_span),
		("token trivia is explicit", test_token_trivia_is_explicit),
		("eof token has name", test_eof_token_has_name),
	]
}
