import:
	../src/stage_12_cli/cli_args:
		CliSanitizerMode(CliSanitizeOff, CliSanitizeUndefined),
		CliTestArgs,
		CliTestMode(CliTestAll),
	../src/stage_12_cli/cli_test_environment: CliTestEnvironment, resolve_test_args_environment
	test: TestSuite


private pure func options() -> CliTestArgs:
	{
		profile = False,
		debug = False,
		sanitizer = None,
		leak_check = False,
		maximal_artifacts = False,
		no_format = False,
		timeout = None,
		jobs = 1,
		repeat = 1,
		mode = CliTestAll,
		cache = False,
		std_dir = None,
		paths = ["tests"]
	}


private pure func environment() -> CliTestEnvironment:
	{
		test_timeout = Some("7"),
		timeout = Some("9"),
		sanitizer = Some("undefined"),
		leak_check = Some("1")
	}


pure func test_environment_uses_test_timeout_before_generic_timeout() -> Bool:
	match resolve_test_args_environment(options(), environment()):
		Ok(resolved):
			(
				resolved.timeout == Some(7)
				and resolved.sanitizer == Some(CliSanitizeUndefined)
				and resolved.leak_check
			)
		Err(_):
			False


pure func test_environment_uses_thirty_second_default() -> Bool:
	empty: CliTestEnvironment = {
		test_timeout = None,
		timeout = None,
		sanitizer = None,
		leak_check = None
	}

	match resolve_test_args_environment(options(), empty):
		Ok(resolved):
			resolved.timeout == Some(30)
		Err(_):
			False


pure func test_cli_options_override_test_environment() -> Bool:
	configured = { options() |
		timeout = Some(0),
		sanitizer = Some(CliSanitizeOff),
		leak_check = True
	}

	match resolve_test_args_environment(configured, environment()):
		Ok(resolved):
			(
				resolved.timeout == Some(0)
				and resolved.sanitizer == Some(CliSanitizeOff)
				and resolved.leak_check
			)
		Err(_):
			False


pure func test_invalid_test_environment_is_rejected() -> Bool:
	bad = { environment() | test_timeout = Some("later") }
	resolve_test_args_environment(options(), bad).is_err()


pure func test_maximal_artifacts_reject_active_sanitizers() -> Bool:
	maximal = { options() | maximal_artifacts = True }

	match resolve_test_args_environment(maximal, environment()):
		Err(message):
			message == "Error: --maximal-artifacts cannot be used with sanitizers"
		Ok(_):
			False


tests: TestSuite = {
	description = "Blorp compiler test environment",
	tests = [
		(
			"test timeout precedes generic timeout",
			test_environment_uses_test_timeout_before_generic_timeout,
		),
		("uses thirty second default", test_environment_uses_thirty_second_default),
		("CLI options override environment", test_cli_options_override_test_environment),
		("invalid environment is rejected", test_invalid_test_environment_is_rejected),
		(
			"maximal artifacts reject active sanitizers",
			test_maximal_artifacts_reject_active_sanitizers,
		),
	]
}
