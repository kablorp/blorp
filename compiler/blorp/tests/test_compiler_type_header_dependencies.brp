		compiler_module_view_register_module_alias,
		compiler_module_view_register_selective_name,
	test: TestSuite


private pure func parsed_program(source: String) -> ParsedProgram:
	finalized_typecheck_program_ast(
		ParserBridge.parsed_typecheck_source_bridge_artifact(
			"aliases.brp",
			"aliases",
			source,
			False,
		).program,
	)


private pure func finalized_program(
	path: String,
	module_name: String,
	source: String,
) -> FinalizedTypecheckProgram:
	ParserBridge.parsed_typecheck_source_bridge_artifact(path, module_name, source, False).program


private pure func module_load_candidate(
	path: String,
	module_path: String,
	source: String,
) -> CompilerModuleLoadCandidate:
	compiler_module_load_candidate(
		compiler_resolved_module_identity_from_resolver(module_path, CompilerUserModule),
		finalized_program(path, module_path, source),
	)


private pure func view_with_alias(
	local_name: String,
	module_path: String,
) -> Option[CompilerModuleView]:
	match compiler_module_view_register_module_alias(
		COMPILER_MODULE_VIEW_EMPTY,
		local_name,
		module_path,
	):
		CompilerModuleAliasAdded(view):
			Some(view)
		_:
			None


private pure func bind_cross_module_alias_view(
	scope: CompilerPreparedModuleScope,
) -> CompilerBoundModuleViewBinding:
	path = compiler_prepared_module_scope_canonical_path(scope)
	program = prepared_module_program(compiler_prepared_module_scope_module(scope))

	view = if path == "app/main":
		view_with_alias("Dep", "pkg/dep")
	else if path == "pkg/dep":
		view_with_alias("Main", "app/main")
	else:
		None

	match view:
		Some(bound_view):
			CompilerBoundModuleViewReady(
				bound_view,
				program,
				COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
				[],
			)
		None:
			CompilerBoundModuleViewRejected("missing test module view", [])


private pure func cross_module_skeleton_graph(
	dependency_source: String,
) -> Option[CompilerDeclarationSkeletonGraph]:
	target = module_load_candidate("main.brp", "app/main", "type alias First = Dep.Second")
	dependency = module_load_candidate("dep.brp", "pkg/dep", dependency_source)

	match compiler_indexed_graph_build(target, [dependency]):
		Err(_):
			None
		Ok(indexed):
			match compiler_bound_module_graph_build(
				indexed,
				["pkg/dep"],
				bind_cross_module_alias_view,
			):
				Err(_):
					None
				Ok(bound):
					match compiler_declaration_skeleton_graph_build(bound):
						Ok(graph):
							Some(graph)
						Err(_):
							None


private pure func bind_type_parameter_view(
	scope: CompilerPreparedModuleScope,
) -> CompilerBoundModuleViewBinding:
	path = compiler_prepared_module_scope_canonical_path(scope)
	program = prepared_module_program(compiler_prepared_module_scope_module(scope))

	if path == "app/main":
		match compiler_module_view_register_selective_name(
			COMPILER_MODULE_VIEW_EMPTY,
			"RemoteBound",
			"pkg/dep",
			"ExternalBound",
		):
			CompilerSelectiveNameAdded(view):
				CompilerBoundModuleViewReady(
					view,
					program,
					COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
					[],
				)
			_:
				CompilerBoundModuleViewRejected("missing selective bound view", [])
	else:
		CompilerBoundModuleViewReady(
			COMPILER_MODULE_VIEW_EMPTY,
			program,
			COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
			[],
		)


private pure func type_parameter_dependency_graph(
	bound_name: String,
) -> Option[CompilerAcyclicTypeAliasDependencyGraph]:
	target_source = "trait LocalBound:\n\tpure func local(value: Self) -> Int\n\nrecord Box[T: LocalBound + " + bound_name + "] {value: T}"
	dependency_source = "trait ExternalBound:\n\tpure func external(value: Self) -> Int"
	target = module_load_candidate("main.brp", "app/main", target_source)
	dependency = module_load_candidate("dep.brp", "pkg/dep", dependency_source)

	match compiler_indexed_graph_build(target, [dependency]):
		Err(_):
			None
		Ok(indexed):
			match compiler_bound_module_graph_build(indexed, ["pkg/dep"], bind_type_parameter_view):
				Err(_):
					None
				Ok(bound):
					match compiler_declaration_skeleton_graph_build(bound):
						Err(_):
							None
						Ok(skeletons):
							compiler_type_alias_dependency_graph_validate(skeletons).to_option()


func test_alias_dependencies_are_structural_and_ignore_type_params() -> Bool:
	program = parsed_program(
		"type alias Box[T] = List[T]\n\ntype alias MaybeBox[T] = Option[Box[T]]",
	)
	nodes = compiler_local_type_alias_dependency_graph_nodes(
		compiler_local_type_alias_dependency_graph_build(program.decls),
	)

	(
		nodes.length() == 2
		and nodes
			.get(0)
			.map(func(node): node.name == "Box" and node.dependencies.length() == 0)
			.get_or(False)
		and nodes
			.get(1)
			.map(func(node): node.name == "MaybeBox" and node.dependencies == ["Box"])
			.get_or(False)
	)


func test_alias_cycle_reports_deterministic_path() -> Bool:
	program = parsed_program(
		"type alias First = List[Second]\n\ntype alias Second = (Third, Int)\n\ntype alias Third = First",
	)
	graph = compiler_local_type_alias_dependency_graph_build(program.decls)

	match compiler_local_type_alias_dependency_graph_check_cycles(graph):
		CompilerTypeAliasCycle(cycle):
			cycle == ["First", "Second", "Third", "First"]
		CompilerTypeAliasesAcyclic:
			False


func test_alias_self_cycle_is_rejected() -> Bool:
	program = parsed_program("opaque type Recursive = Recursive")
	graph = compiler_local_type_alias_dependency_graph_build(program.decls)

	match compiler_local_type_alias_dependency_graph_check_cycles(graph):
		CompilerTypeAliasCycle(cycle):
			cycle == ["Recursive", "Recursive"]
		CompilerTypeAliasesAcyclic:
			False


func test_record_recursion_does_not_create_alias_cycle() -> Bool:
	program = parsed_program("record Node {children: List[Node]}\n\ntype alias Nodes = List[Node]")
	graph = compiler_local_type_alias_dependency_graph_build(program.decls)

	compiler_local_type_alias_dependency_graph_check_cycles(graph) == CompilerTypeAliasesAcyclic


func test_graph_alias_dependencies_resolve_qualified_cycle_by_identity() -> Bool:
	match cross_module_skeleton_graph("type alias Second = Main.First"):
		None:
			False
		Some(skeleton_graph):
			match compiler_type_alias_dependency_graph_build(skeleton_graph):
				Err(_):
					False
				Ok(graph):
					match compiler_type_alias_dependency_graph_check_cycles(graph):
						CompilerTypeAliasIdentitiesAcyclic:
							False
						CompilerTypeAliasIdentityCycle(cycle):
							(
								compiler_type_alias_dependency_graph_nodes(graph).length() == 2
								and compiler_type_alias_dependency_graph_validation_errors(
									skeleton_graph,
								) == [
									"Type alias cycle: app/main.First -> pkg/dep.Second -> app/main.First",
								]
								and cycle.map(
									compiler_type_alias_identity_display_name,
								) == ["app/main.First", "pkg/dep.Second", "app/main.First"]
							)


func test_graph_alias_dependencies_accept_qualified_acyclic_edge() -> Bool:
	match cross_module_skeleton_graph("type alias Second = Int"):
		None:
			False
		Some(skeleton_graph):
			match compiler_type_alias_dependency_graph_build(skeleton_graph):
				Err(_):
					False
				Ok(graph):
					(
						compiler_type_alias_dependency_graph_nodes(graph).length() == 2
						and compiler_type_alias_dependency_graph_check_cycles(
							graph,
						) == CompilerTypeAliasIdentitiesAcyclic
						and match compiler_type_alias_dependency_graph_validate(skeleton_graph):
							Ok(acyclic):
								compiler_acyclic_type_alias_dependency_graph_nodes(
									acyclic,
								).length() == 2
							Err(_):
								False
					)


func test_type_parameter_bounds_resolve_to_exact_trait_identities() -> Bool:
	match type_parameter_dependency_graph("RemoteBound"):
		None:
			False
		Some(dependencies):
			match compiler_resolved_type_parameter_graph_build(dependencies):
				Err(_):
					False
				Ok(graph):
					entries = compiler_resolved_type_parameter_graph_entries(graph)

					match entries.get(0):
						None:
							False
						Some(entry):
							match entry.parameters.get(0):
								None:
									False
								Some(param):
									match (param.bounds.get(0), param.bounds.get(1)):
										(Some(local_bound), Some(remote_bound)):
											(
												compiler_type_parameter_id_name(param.id) == "T"
												and param.bounds.length() == 2
												and compiler_trait_id_name(
													local_bound,
												) == "LocalBound"
												and compiler_module_identity_display_name(
													compiler_trait_id_module_identity(
														local_bound,
													),
												) == "app/main"
												and compiler_trait_id_name(
													remote_bound,
												) == "ExternalBound"
												and compiler_module_identity_display_name(
													compiler_trait_id_module_identity(
														remote_bound,
													),
												) == "pkg/dep"
											)
										_:
											False


func test_type_parameter_bounds_reject_unknown_trait() -> Bool:
	match type_parameter_dependency_graph("MissingBound"):
		None:
			False
		Some(dependencies):
			match compiler_resolved_type_parameter_graph_build(dependencies):
				Ok(_):
					False
				Err(errors):
					match errors.get(0):
						Some(error):
							match error:
								CompilerTypeParameterBoundNotFound(_, "T", "MissingBound"):
									compiler_resolved_type_parameter_graph_error_message(
										error,
									).contains("MissingBound")
								_:
									False
						_:
							False


tests: TestSuite = {
	description = "Compiler type header dependencies",
	tests = [
		(
			"alias dependencies are structural and ignore type params",
			test_alias_dependencies_are_structural_and_ignore_type_params,
		),
		("alias cycle reports deterministic path", test_alias_cycle_reports_deterministic_path),
		("alias self cycle is rejected", test_alias_self_cycle_is_rejected),
		(
			"record recursion does not create alias cycle",
			test_record_recursion_does_not_create_alias_cycle,
		),
		(
			"graph alias dependencies resolve qualified cycle by identity",
			test_graph_alias_dependencies_resolve_qualified_cycle_by_identity,
		),
		(
			"graph alias dependencies accept qualified acyclic edge",
			test_graph_alias_dependencies_accept_qualified_acyclic_edge,
		),
		(
			"type parameter bounds resolve to exact trait identities",
			test_type_parameter_bounds_resolve_to_exact_trait_identities,
		),
		(
			"type parameter bounds reject unknown trait",
			test_type_parameter_bounds_reject_unknown_trait,
		),
	]
}
