import:
	../src/stage_03_parse/parsed_ast: ParsedProgram
	../src/stage_03_parse/parser_bridge as ParserBridge
	../src/stage_03_parse/source_ast_finalize:
		FinalizedTypecheckProgram,
		finalized_typecheck_program_ast,
	../src/stage_04_modules/loaded_module:
		CompilerModuleLoadCandidate,
		CompilerModuleOrigin(CompilerUserModule),
		compiler_module_identity_display_name,
		compiler_module_load_candidate,
		compiler_resolved_module_identity_from_resolver,
	../src/stage_06_typecheck/graph/indexed_graph:
		CompilerPreparedModuleScope,
		compiler_indexed_graph_build,
		compiler_prepared_module_scope_canonical_path,
		compiler_prepared_module_scope_module,
		prepared_module_program,
	../src/stage_06_typecheck/headers/declaration_skeleton:
		CompilerDeclarationSkeletonGraph,
		compiler_declaration_skeleton_graph_build,
		compiler_trait_id_module_identity,
		compiler_trait_id_name,
	../src/stage_06_typecheck/headers/type_header_dependencies:
		CompilerAcyclicTypeAliasDependencyGraph,
		CompilerTypeAliasCycleCheck(CompilerTypeAliasCycle, CompilerTypeAliasesAcyclic),
		CompilerTypeAliasIdentityCycleCheck(
			CompilerTypeAliasIdentitiesAcyclic,
			CompilerTypeAliasIdentityCycle,
		),
		compiler_acyclic_type_alias_dependency_graph_nodes,
		compiler_local_type_alias_dependency_graph_build,
		compiler_local_type_alias_dependency_graph_check_cycles,
		compiler_local_type_alias_dependency_graph_nodes,
		compiler_type_alias_dependency_graph_build,
		compiler_type_alias_dependency_graph_check_cycles,
		compiler_type_alias_dependency_graph_nodes,
		compiler_type_alias_dependency_graph_validate,
		compiler_type_alias_dependency_graph_validation_errors,
		compiler_type_alias_identity_display_name,
	../src/stage_06_typecheck/headers/type_parameter_headers:
		CompilerResolvedTypeParameterGraphError(CompilerTypeParameterBoundNotFound),
		compiler_resolved_type_parameter_graph_build,
		compiler_resolved_type_parameter_graph_entries,
		compiler_resolved_type_parameter_graph_error_message,
		compiler_type_parameter_id_name,
	../src/stage_06_typecheck/modules/bound_module_graph:
		COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
		CompilerBoundModuleViewBinding(
			CompilerBoundModuleViewReady,
			CompilerBoundModuleViewRejected,
		),
		compiler_bound_module_graph_build,
	../src/stage_06_typecheck/modules/module_view:
		COMPILER_MODULE_VIEW_EMPTY,
		CompilerModuleAliasRegistration(CompilerModuleAliasAdded),
