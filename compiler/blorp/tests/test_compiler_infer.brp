func test_concurrent_block_rejects_unknown_and_duplicate_params() -> Bool:
	unknown_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedConcurrentBlockExpr(
			[concurrent_param("workers", int_expr("2"))],
			ParsedBlockExpr([assign_expr("result", int_expr("1"))], source_span()),
			source_span(),
		),
	)
	duplicate_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedConcurrentBlockExpr(
			[
				concurrent_param("timeout", int_expr("1")),
				concurrent_param("timeout", int_expr("2")),
			],
			ParsedBlockExpr(
				[assign_expr("result", int_expr("1"))],
				source_span(),
			),
			source_span(),
		),
	)

	unknown_result.context.state.errors.length() == 1 and unknown_result.context.state.errors
		.get_or(0, "")
		.contains(
			"Unknown concurrent parameter `workers`",
		) and duplicate_result.context.state.errors.length() == 1 and duplicate_result.context.state.errors
		.get_or(0, "")
		.contains("Duplicate concurrent parameter `timeout`")


func test_concurrent_block_rejects_empty_and_non_binding_body() -> Bool:
	empty_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedConcurrentBlockExpr(
			[],
			ParsedBlockExpr([], source_span()),
			source_span(),
		),
	)
	non_binding_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedConcurrentBlockExpr(
			[],
			ParsedBlockExpr([int_expr("1")], source_span()),
			source_span(),
		),
	)
	non_block_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedConcurrentBlockExpr([], int_expr("1"), source_span()),
	)

	empty_result.context.state.errors.length() == 1 and empty_result.context.state.errors
		.get_or(0, "")
		.contains(
			"concurrent: block cannot be empty",
		) and non_binding_result.context.state.errors.length() == 1 and non_binding_result.context.state.errors
		.get_or(0, "")
