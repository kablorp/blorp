func test_direct_call_errors_are_specific() -> Bool:
	arity_result = compiler_infer_expr(
		compiler_infer_context(state_with_add_one_func()),
		call_expr(ParsedNameExpr(ident("add_one")), []),
	)
	mismatch_result = compiler_infer_expr(
		compiler_infer_context(state_with_add_one_func()),
		call_expr(ParsedNameExpr(ident("add_one")), [string_expr("x")]),
	)
	non_function_result = compiler_infer_expr(
		compiler_infer_context(state_with_int_binding("value")),
		call_expr(ParsedNameExpr(ident("value")), []),
	)

	(
		arity_result.context.state.errors.length() == 1
		and arity_result.context.state.errors
			.get_or(0, "")
			.contains("Function 'add_one' expects 1 argument, got 0")
		and mismatch_result.context.state.errors.length() == 1
		and mismatch_result.context.state.errors
			.get_or(0, "")
			.contains("Argument type mismatch: in call to 'add_one', argument 1 expected Int, got String")
		and non_function_result.context.state.errors.length() == 1
		and non_function_result.context.state.errors
			.get_or(0, "")
			.contains("Cannot call non-function type: Int")
	)


