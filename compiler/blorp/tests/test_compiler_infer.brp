			CompilerArgumentSlot,
			CompilerCollectionElement,
			CompilerMutableBinding,
			CompilerNumericOperator,
		),
		compiler_widening_reasons_equal,
	../compiler_typecheck_state:
		CompilerTypecheckState,
		compiler_typecheck_state_empty,
		compiler_typecheck_state_register_module_alias,
	test: TestSuite


pure func source_file() -> CompilerSourceFile:
	compiler_source_file("infer.brp", "infer", "func main(): 1")


pure func source_span() -> CompilerSourceSpan:
	src: CompilerSourceFile = source_file()
	cursor: CompilerCursor = compiler_source_cursor_at(src, 0)
	compiler_source_span(src, cursor, cursor)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, source_span())


pure func lambda_param(name: String, type_expr: Option[ParsedTypeExpr]) -> ParsedLambdaParam:
	{name = ident(name), type_expr = type_expr, span = source_span()}


pure func named_type(name: String) -> ParsedTypeExpr:
	ParsedNamedType(ident(name), [], source_span())


pure func int_expr(text: String) -> ParsedExpr:
	ParsedIntLiteralExpr(text, source_span())


pure func string_expr(text: String) -> ParsedExpr:
	ParsedStringLiteralExpr(text, ParsedPlainStringLiteral, source_span())


pure func interpolation_expr(parts: List[ParsedStringInterpolationPart]) -> ParsedExpr:
	ParsedStringInterpolationPartsExpr(parts, False, source_span())


pure func bool_expr(value: Bool) -> ParsedExpr:
	ParsedBoolLiteralExpr(value, source_span())


pure func float_expr(text: String) -> ParsedExpr:
	ParsedFloatLiteralExpr(text, source_span())


pure func binary_expr(op: ParsedBinaryOp, left: ParsedExpr, right: ParsedExpr) -> ParsedExpr:
	ParsedBinaryExpr(op, left, right, source_span())


pure func call_expr(callee: ParsedExpr, args: List[ParsedExpr]) -> ParsedExpr:
	ParsedCallExpr(callee, args, source_span())


pure func tuple_expr(items: List[ParsedExpr]) -> ParsedExpr:
	ParsedTupleExpr(items, source_span())


pure func tuple_destruct_expr(names: List[String], value: ParsedExpr) -> ParsedExpr:
	ParsedTupleDestructExpr(names.map(ident), value, source_span())


pure func assign_expr(name: String, value: ParsedExpr) -> ParsedExpr:
	ParsedAssignExpr(ident(name), value, source_span())


pure func compound_assign_expr(name: String, value: ParsedExpr) -> ParsedExpr:
	ParsedCompoundAssignExpr(ident(name), ParsedAssignAddOp, value, source_span())


pure func match_case(pattern: ParsedPattern, body: ParsedExpr) -> ParsedMatchCase:
	{pattern = pattern, body = body, span = source_span()}


pure func list_expr(items: List[ParsedExpr]) -> ParsedExpr:
	ParsedListExpr(items, source_span())


pure func vector_expr(items: List[ParsedExpr]) -> ParsedExpr:
	ParsedVectorExpr(items, source_span())


pure func dict_entry(key: ParsedExpr, value: ParsedExpr) -> ParsedDictEntry:
	{key = key, value = value, span = source_span()}


pure func dict_expr(entries: List[ParsedDictEntry]) -> ParsedExpr:
	ParsedDictExpr(entries, source_span())


pure func record_field(name: String, value: ParsedExpr) -> ParsedRecordExprField:
	{name = ident(name), value = value, span = source_span()}


pure func record_expr(fields: List[ParsedRecordExprField]) -> ParsedExpr:
	ParsedRecordExpr(fields, source_span())


pure func record_update_expr(
	receiver: ParsedExpr,
	fields: List[ParsedRecordExprField],
) -> ParsedExpr:
	ParsedRecordUpdateExpr(receiver, fields, source_span())


pure func field_access_expr(receiver: ParsedExpr, field: String) -> ParsedExpr:
	ParsedFieldAccessExpr(receiver, ident(field), source_span())


pure func subscript_expr(receiver: ParsedExpr, indices: List[ParsedExpr]) -> ParsedExpr:
	ParsedSubscriptExpr(receiver, indices, source_span())


pure func subscript_assign_expr(
	target: ParsedExpr,
	indices: List[ParsedExpr],
	value: ParsedExpr,
) -> ParsedExpr:
	ParsedSubscriptAssignExpr(target, indices, value, source_span())


pure func vector_subscript_assign_block(
	is_mutable: Bool,
	indices: List[ParsedExpr],
	value: ParsedExpr,
) -> ParsedExpr:
	ParsedBlockExpr(
		[
			ParsedVarDeclExpr(
				ident("values"),
				None,
				vector_expr([int_expr("1"), int_expr("2")]),
				is_mutable,
				source_span(),
			),
			subscript_assign_expr(ParsedNameExpr(ident("values")), indices, value),
		],
		source_span(),
	)


pure func range_expr(start_expr: ParsedExpr, end_expr: ParsedExpr) -> ParsedExpr:
	ParsedRangeExpr(start_expr, end_expr, source_span())


pure func for_name_expr(name: String, iterable: ParsedExpr, body: ParsedExpr) -> ParsedExpr:
	ParsedForExpr(ParsedForNameBinder(ident(name)), iterable, body, source_span())


pure func optional_types_equal(
	left: Option[CompilerType],
	right: Option[CompilerType],
) -> Bool:
	match (left, right):
		(Some(left_type), Some(right_type)):
			compiler_types_equal(left_type, right_type)
		(None, None):
			True
		_:
			False


pure func state_with_int_binding(name: String) -> CompilerTypecheckState:
	state = compiler_typecheck_state_empty()
	{ state |
		env = compiler_env_add_var_with_details(
			state.env,
			name,
			compiler_type_int(),
			Some(compiler_type_int()),
			CompilerImmutableBinding,
			CompilerLetBinding,
			compiler_unrefined_binding(),
		)
	}


pure func state_with_add_one_func() -> CompilerTypecheckState:
	state = compiler_typecheck_state_empty()
	{ state |
		env = compiler_env_add_func(
			state.env,
			"add_one",
			CompilerFunctionType(True, [compiler_type_int()], compiler_type_int()),
			CompilerPure,
			CompilerUserDefinedFunc,
		)
	}


pure func state_with_module_scale_func() -> (CompilerTypecheckState, Int):
	state = compiler_typecheck_state_register_module_alias(
		compiler_typecheck_state_empty(),
		"M",
		"math",
	)

	match compiler_env_mint_def_id(state.env):
		(next_env, def_id):
			symbol = compiler_func_symbol(
				def_id,
				CompilerFunctionType(True, [compiler_type_int()], compiler_type_int()),
				[],
				[Some("value")],
				CompilerPure,
				CompilerUserDefinedFunc,
				CompilerRejectResourceArgs,
				Some("math"),
				[],
				None,
				False,
			)
			(
				{ state |
					env = compiler_env_add_func_with_info(next_env, "scale", symbol)
				},
				def_id,
			)


pure func infer_overload_entry(
	def_id: Int,
	param_type: CompilerType,
	return_type: CompilerType,
) -> CompilerOverloadEntry:
	{
		def_id = def_id,
		func_type = CompilerFunctionType(True, [param_type], return_type),
		type_params = [],
		param_names = [Some("value")],
		purity = CompilerPure,
		origin = CompilerUserDefinedFunc,
		resource_args = CompilerRejectResourceArgs,
		module_path = None,
		dim_constraints = [],
		loop_producer = None,
		debug_only = False
	}


pure func state_with_describe_overloads() -> CompilerTypecheckState:
	base = state_with_int_binding("count")
	int_entry = infer_overload_entry(101, compiler_type_int(), compiler_type_string())
	string_entry = infer_overload_entry(102, compiler_type_string(), compiler_type_int())
	{ base |
		env = compiler_env_add_overload(
			compiler_env_add_overload(base.env, "describe", int_entry),
			"describe",
			string_entry,
		)
	}


pure func state_with_string_size_ufcs() -> CompilerTypecheckState:
	state = compiler_typecheck_state_empty()
	size_entry = infer_overload_entry(201, compiler_type_string(), compiler_type_int())
	{ state |
		env = compiler_env_add_ufcs_method(state.env, "size", size_entry)
	}


pure func state_with_generic_identity_func() -> CompilerTypecheckState:
	state = compiler_typecheck_state_empty()
	{ state |
		env = compiler_env_add_func(
			state.env,
			"id",
			CompilerFunctionType(True, [CompilerTypeVar("T")], CompilerTypeVar("T")),
			CompilerPure,
			CompilerUserDefinedFunc,
		)
	}


pure func state_with_generic_first_func() -> CompilerTypecheckState:
	state = compiler_typecheck_state_empty()
	{ state |
		env = compiler_env_add_func(
			state.env,
			"first",
			CompilerFunctionType(
				True,
				[compiler_type_list(CompilerTypeVar("T"))],
				CompilerTypeVar("T"),
			),
			CompilerPure,
			CompilerUserDefinedFunc,
		)
	}


pure func state_with_generic_choose_func() -> CompilerTypecheckState:
	state = compiler_typecheck_state_empty()
	{ state |
		env = compiler_env_add_func(
			state.env,
			"choose",
			CompilerFunctionType(
				True,
				[CompilerTypeVar("T"), CompilerTypeVar("T")],
				CompilerTypeVar("T"),
			),
			CompilerPure,
			CompilerUserDefinedFunc,
		)
	}


pure func field_decl(name: String, field_type: CompilerType) -> CompilerFieldDecl:
	{name = name, field_type = field_type}


pure func state_with_point_record() -> CompilerTypecheckState:
	state = compiler_typecheck_state_empty()
	{ state |
		env = compiler_env_add_record(
			state.env,
			"Point",
			[],
			[
				field_decl("x", compiler_type_int()),
				field_decl("y", compiler_type_string()),
			],
			False,
			False,
		)
	}


pure func state_with_point_binding() -> CompilerTypecheckState:
	state = state_with_point_record()
	{ state |
		env = compiler_env_add_var_with_details(
			state.env,
			"point",
			CompilerNamedType("Point", []),
			Some(CompilerNamedType("Point", [])),
			CompilerImmutableBinding,
			CompilerLetBinding,
			compiler_unrefined_binding(),
		)
	}


pure func state_with_matrix_binding() -> CompilerTypecheckState:
	state = compiler_typecheck_state_empty()
	matrix_type: CompilerType = CompilerArrayType(
		compiler_type_int(),
		[CompilerConstIntType(2), CompilerConstIntType(3)],
	)
	{ state |
		env = compiler_env_add_var_with_details(
			state.env,
			"matrix",
			matrix_type,
			Some(matrix_type),
			CompilerImmutableBinding,
			CompilerLetBinding,
			compiler_unrefined_binding(),
		)
	}


func test_int_literal_expected_argument_slot_preserves_semantic_type() -> Bool:
	ctx = compiler_infer_with_expected_value_slot(
		compiler_infer_context(compiler_typecheck_state_empty()),
		compiler_type_int(),
		CompilerExpectedArgumentSlot,
	)
	result = compiler_infer_expr(ctx, int_expr("1"))
	typed = result.expr

	(
		compiler_types_equal(compiler_typed_expr_semantic_type(typed), CompilerConstIntType(1))
		and compiler_types_equal(compiler_typed_expr_value_type(typed), compiler_type_int())
		and match compiler_typed_expr_widening(typed):
			CompilerTypeWiden(from_type, to_type, reason):
				(
					compiler_types_equal(from_type, CompilerConstIntType(1))
					and compiler_types_equal(to_type, compiler_type_int())
					and compiler_widening_reasons_equal(reason, CompilerArgumentSlot)
				)
			CompilerTypeKeep(_):
				False
	)


func test_identifier_lookup_preserves_source_type() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(state_with_int_binding("value")),
		ParsedNameExpr(ident("value")),
	)
	typed = result.expr

	(
		result.context.state.errors.length() == 0
		and optional_types_equal(compiler_typed_expr_source_type(typed), Some(compiler_type_int()))
		and compiler_types_equal(compiler_typed_expr_semantic_type(typed), compiler_type_int())
		and compiler_types_equal(compiler_typed_expr_value_type(typed), compiler_type_int())
	)


func test_unknown_identifier_records_error() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedNameExpr(ident("missing")),
	)

	(
		result.context.state.errors.length() == 1
		and result.context.state.errors.get_or(0, "").contains("Unbound value `missing`")
	)


func test_var_decl_updates_environment_and_widens_mutable_initializer() -> Bool:
	decl_expr = ParsedVarDeclExpr(ident("x"), None, int_expr("1"), True, source_span())
	result = compiler_infer_expr(compiler_infer_context(compiler_typecheck_state_empty()), decl_expr)

	(
		optional_types_equal(
			compiler_env_get_var_type(result.context.state.env, "x"),
			Some(CompilerConstIntType(1)),
		)
		and compiler_types_equal(compiler_typed_expr_semantic_type(result.expr), CompilerNamedType("Void", []))
		and match compiler_typed_expr_var_initializer_widening(result.expr):
			CompilerTypeWiden(from_type, to_type, reason):
				(
					compiler_types_equal(from_type, CompilerConstIntType(1))
					and compiler_types_equal(to_type, compiler_type_int())
					and compiler_widening_reasons_equal(reason, CompilerMutableBinding)
				)
			CompilerTypeKeep(_):
				False
	)


func test_annotated_var_decl_widens_literal_initializer() -> Bool:
	decl_expr = ParsedVarDeclExpr(ident("x"), Some(named_type("Int")), int_expr("1"), False, source_span())
	result = compiler_infer_expr(compiler_infer_context(compiler_typecheck_state_empty()), decl_expr)

	(
		result.context.state.errors.length() == 0
		and optional_types_equal(compiler_env_get_var_type(result.context.state.env, "x"), Some(compiler_type_int()))
		and match compiler_typed_expr_var_initializer_widening(result.expr):
			CompilerTypeKeep(typ):
				compiler_types_equal(typ, compiler_type_int())
			_:
				False
	)


func test_block_scopes_local_bindings_and_uses_last_expression_type() -> Bool:
	block = ParsedBlockExpr(
		[
			ParsedVarDeclExpr(ident("x"), None, int_expr("1"), False, source_span()),
			ParsedNameExpr(ident("x")),
		],
		source_span(),
	)
	result = compiler_infer_expr(compiler_infer_context(compiler_typecheck_state_empty()), block)

	(
		result.context.state.errors.length() == 0
		and compiler_types_equal(compiler_typed_expr_semantic_type(result.expr), CompilerConstIntType(1))
		and compiler_env_get_var_type(result.context.state.env, "x") == None
	)


func test_block_preserves_last_expression_value_type() -> Bool:
	block = ParsedBlockExpr([int_expr("1")], source_span())
	result = compiler_infer_expr(
		compiler_infer_with_expected_value_slot(
			compiler_infer_context(compiler_typecheck_state_empty()),
			compiler_type_int(),
			CompilerExpectedArgumentSlot,
		),
		block,
	)

	(
		result.context.state.errors.length() == 0
		and compiler_types_equal(compiler_typed_expr_semantic_type(result.expr), CompilerConstIntType(1))
		and compiler_types_equal(compiler_typed_expr_value_type(result.expr), compiler_type_int())
	)


func test_debug_block_checks_body_and_returns_void() -> Bool:
	ok_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedDebugBlockExpr(
			ParsedBlockExpr([int_expr("1")], source_span()),
			source_span(),
		),
	)
	error_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedDebugBlockExpr(ParsedNameExpr(ident("missing")), source_span()),
	)

	(
		ok_result.context.state.errors.length() == 0
		and compiler_types_equal(compiler_typed_expr_semantic_type(ok_result.expr), compiler_type_void())
		and error_result.context.state.errors.length() == 1
		and error_result.context.state.errors.get_or(0, "").contains("Unbound value `missing`")
		and compiler_types_equal(compiler_typed_expr_semantic_type(error_result.expr), compiler_type_void())
	)


func test_ascription_records_source_type_and_rejects_mismatch() -> Bool:
	ok_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedAscriptionExpr(int_expr("1"), named_type("Int"), source_span()),
	)
	error_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedAscriptionExpr(string_expr("x"), named_type("Int"), source_span()),
	)

	(
		ok_result.context.state.errors.length() == 0
		and optional_types_equal(
			compiler_typed_expr_source_type(ok_result.expr),
			Some(compiler_type_int()),
		)
		and compiler_types_equal(compiler_typed_expr_semantic_type(ok_result.expr), compiler_type_int())
		and match compiler_typed_expr_origin(ok_result.expr):
			CompilerExplicitAnnotationOrigin(source_type):
				compiler_types_equal(source_type, compiler_type_int())
			_:
				False
		and error_result.context.state.errors.length() == 1
		and error_result.context.state.errors
			.get_or(0, "")
			.contains("Ascribed type `Int` does not match value type `String`")
	)


func test_arithmetic_widens_literal_operands() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		binary_expr(ParsedAddOp, int_expr("1"), int_expr("2")),
	)

	(
		result.context.state.errors.length() == 0
		and compiler_types_equal(compiler_typed_expr_semantic_type(result.expr), compiler_type_int())
		and match compiler_typed_expr_binary_left_widening(result.expr):
			CompilerTypeWiden(from_type, to_type, reason):
				(
					compiler_types_equal(from_type, CompilerConstIntType(1))
					and compiler_types_equal(to_type, compiler_type_int())
					and compiler_widening_reasons_equal(
						reason,
						CompilerNumericOperator(ParsedAddOp),
					)
				)
			CompilerTypeKeep(_):
				False
		and match compiler_typed_expr_binary_right_widening(result.expr):
			CompilerTypeWiden(from_type, to_type, reason):
				(
					compiler_types_equal(from_type, CompilerConstIntType(2))
					and compiler_types_equal(to_type, compiler_type_int())
					and compiler_widening_reasons_equal(
						reason,
						CompilerNumericOperator(ParsedAddOp),
					)
				)
			CompilerTypeKeep(_):
				False
	)


func test_modulo_refines_non_negative_literal_result() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		binary_expr(ParsedModuloOp, int_expr("5"), int_expr("3")),
	)

	(
		result.context.state.errors.length() == 0
		and compiler_types_equal(
			compiler_typed_expr_semantic_type(result.expr),
			CompilerRangeType(CompilerConstIntType(3)),
		)
	)


func test_string_addition_and_mismatch_error() -> Bool:
	ok_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		binary_expr(ParsedAddOp, string_expr("a"), string_expr("b")),
	)
	error_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		binary_expr(ParsedAddOp, string_expr("a"), int_expr("1")),
	)

	(
		ok_result.context.state.errors.length() == 0
		and compiler_types_equal(compiler_typed_expr_semantic_type(ok_result.expr), compiler_type_string())
		and error_result.context.state.errors.length() == 1
