		compiler_typed_expr_binary_right_widening,
		compiler_typed_expr_call_arg_widening,
		compiler_typed_expr_dict_key_widening,
		compiler_typed_expr_dict_value_widening,
		compiler_typed_expr_field_access_receiver_type,
		compiler_typed_expr_list_item_widening,
		compiler_typed_expr_origin,
		compiler_typed_expr_record_field_widening,
		compiler_typed_expr_resolved_call,
		compiler_typed_expr_semantic_type,
		compiler_typed_expr_source_type,
		compiler_typed_expr_value_type,
		compiler_typed_expr_var_initializer_widening,
		compiler_typed_expr_vector_item_widening,
		compiler_typed_expr_widening,
	../compiler_parsed_ast:
		ParsedBinaryOp(
			ParsedAddOp,
			ParsedEqualOp,
			ParsedLessOp,
			ParsedModuloOp,
		),
		ParsedCompoundAssignOp(ParsedAssignAddOp),
		ParsedExpr(
			ParsedAscriptionExpr,
			ParsedAssignExpr,
			ParsedBinaryExpr,
			ParsedBlockExpr,
			ParsedBoolLiteralExpr,
			ParsedBreakExpr,
			ParsedCallExpr,
			ParsedCompoundAssignExpr,
			ParsedContinueExpr,
			ParsedDebugBlockExpr,
			ParsedDictExpr,
			ParsedFieldAccessExpr,
			ParsedForExpr,
			ParsedIfExpr,
			ParsedIntLiteralExpr,
			ParsedLambdaExpr,
			ParsedListExpr,
			ParsedLogicalExpr,
			ParsedMatchExpr,
			ParsedNameExpr,
			ParsedRangeExpr,
			ParsedRecordExpr,
			ParsedRecordUpdateExpr,
			ParsedStringLiteralExpr,
			ParsedSubscriptAssignExpr,
			ParsedSubscriptExpr,
			ParsedTupleExpr,
			ParsedTupleDestructExpr,
			ParsedUnaryExpr,
			ParsedVarDeclExpr,
			ParsedVectorExpr,
			ParsedWhileExpr,
		),
		ParsedDictEntry,
		ParsedForBinder(ParsedForNameBinder, ParsedForTupleBinder),
		ParsedIdentifier,
		ParsedLambdaParam,
		ParsedLogicalOp(ParsedAndOp),
		ParsedMatchCase,
		ParsedPattern(
			ParsedBoolPattern,
			ParsedNamePattern,
			ParsedWildcardPattern,
		),
		ParsedRecordExprField,
		ParsedStringInterpolationPart(ParsedInterpolationExpr, ParsedInterpolationLiteral),
		ParsedStringLiteralForm(ParsedPlainStringLiteral),
		ParsedTypeExpr(ParsedNamedType),
		ParsedUnaryOp(ParsedNegateOp, ParsedNotOp),
		parsed_identifier,
	../compiler_refinement: compiler_unrefined_binding
	../compiler_source:
		CompilerCursor,
		CompilerSourceFile,
		CompilerSourceSpan,
		compiler_source_cursor_at,
		compiler_source_file,
		compiler_source_span,
	../compiler_type:
		CompilerType(
			CompilerArrayType,
			CompilerConstIntType,
			CompilerFunctionType,
			CompilerNamedType,
			CompilerRangeType,
			CompilerTupleType,
			CompilerTypeVar,
		),
		compiler_type_bool,
		compiler_type_int,
		compiler_type_list,
		compiler_type_string,
		compiler_type_void,
		compiler_types_equal,
	../compiler_type_widening:
		CompilerCollectionKind(CompilerDictLiteral, CompilerListLiteral, CompilerVectorLiteral),
		CompilerTypeWideningDecision(CompilerTypeKeep, CompilerTypeWiden),
