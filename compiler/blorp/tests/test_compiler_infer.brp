		and compiler_env_get_var_type(result.context.state.env, "entry_key") == None
		and compiler_env_get_var_type(result.context.state.env, "entry_value") == None
	)


func test_for_invalid_iterable_and_tuple_binder_errors() -> Bool:
	invalid_iterable = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		for_name_expr("x", int_expr("1"), ParsedVoidExpr(source_span())),
	)
	tuple_non_tuple_element = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedForExpr(
			ParsedForTupleBinder([ident("a"), ident("b")], source_span()),
			list_expr([int_expr("1")]),
			ParsedVoidExpr(source_span()),
			source_span(),
		),
	)
	tuple_arity = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedForExpr(
			ParsedForTupleBinder([ident("a")], source_span()),
			list_expr([tuple_expr([int_expr("1"), int_expr("2")])]),
			ParsedVoidExpr(source_span()),
			source_span(),
		),
	)

	(
		invalid_iterable.context.state.errors.length() == 1
		and invalid_iterable.context.state.errors
			.get_or(0, "")
			.contains("Cannot iterate over type")
		and tuple_non_tuple_element.context.state.errors.length() == 1
		and tuple_non_tuple_element.context.state.errors
			.get_or(0, "")
			.contains("Tuple for-loop requires iterable elements to be tuples")
		and tuple_arity.context.state.errors.length() == 1
		and tuple_arity.context.state.errors
			.get_or(0, "")
			.contains("Tuple for-loop arity mismatch")
	)


func test_for_rejects_same_scope_redeclaration() -> Bool:
	block = ParsedBlockExpr(
		[
			ParsedVarDeclExpr(ident("i"), None, int_expr("0"), False, source_span()),
			for_name_expr("i", range_expr(int_expr("0"), int_expr("3")), ParsedVoidExpr(source_span())),
		],
		source_span(),
	)
	result = compiler_infer_expr(compiler_infer_context(compiler_typecheck_state_empty()), block)

	(
		result.context.state.errors.length() == 1
		and result.context.state.errors
			.get_or(0, "")
			.contains("Cannot redeclare `i` in for loop")
	)


