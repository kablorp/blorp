				and match compiler_typed_expr_resolved_call(result.expr):
					Some(info):
						(
							info.callee_name == "scale"
							and info.callable_id == Some(expected_callable_id)
							and match info.purity:
								CompilerPure:
									True
								_:
									False
						)
					None:
						False
			)


