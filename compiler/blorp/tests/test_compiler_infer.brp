func test_assignment_updates_mutable_binding() -> Bool:
	block = ParsedBlockExpr(
		[
			ParsedVarDeclExpr(ident("m"), Some(named_type("Int")), int_expr("1"), True, source_span()),
			assign_expr("m", int_expr("2")),
			ParsedNameExpr(ident("m")),
		],
		source_span(),
	)
	result = compiler_infer_expr(compiler_infer_context(compiler_typecheck_state_empty()), block)

	(
