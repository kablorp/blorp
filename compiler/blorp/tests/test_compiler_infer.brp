func test_opaque_conversion_errors_are_specific() -> Bool:
	state = state_with_opaque_user_id()
	wrong_inner_result = compiler_infer_expr(
		compiler_infer_context(state),
		ParsedOpaqueIntoExpr(named_type("UserId"), string_expr("oops"), source_span()),
	)
	non_opaque_result = compiler_infer_expr(
		compiler_infer_context(state),
		ParsedOpaqueIntoExpr(named_type("Int"), int_expr("1"), source_span()),
	)
	foreign_state = { state |
		env = compiler_env_add_opaque_alias(
			state.env,
			"ForeignId",
			[],
			compiler_type_int(),
			Some("other_module"),
		)
	}
	foreign_result = compiler_infer_expr(
		compiler_infer_context(foreign_state),
		ParsedOpaqueIntoExpr(named_type("ForeignId"), int_expr("1"), source_span()),
	)

	(
		wrong_inner_result.context.state.errors.length() == 1
		and wrong_inner_result.context.state.errors
			.get_or(0, "")
			.contains("into expected Int, got String")
		and non_opaque_result.context.state.errors.length() == 1
		and non_opaque_result.context.state.errors
			.get_or(0, "")
			.contains("Type 'Int' is not an opaque type")
		and foreign_result.context.state.errors.length() == 1
		and foreign_result.context.state.errors
			.get_or(0, "")
			.contains((
					"Opaque type 'ForeignId' can only use into/from conversions in its defining "
					+ "module"
				))
	)


func test_arithmetic_widens_literal_operands() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		binary_expr(ParsedAddOp, int_expr("1"), int_expr("2")),
	)

	(
		result.context.state.errors.length() == 0
		and compiler_types_equal(
			compiler_typed_expr_semantic_type(result.expr),
			compiler_type_int(),
		)
		and match compiler_typed_expr_binary_left_widening(result.expr):
			CompilerTypeWiden(from_type, to_type, reason):
				(
					compiler_types_equal(from_type, CompilerConstIntType(1))
					and compiler_types_equal(to_type, compiler_type_int())
					and compiler_widening_reasons_equal(
						reason,
						CompilerNumericOperator(ParsedAddOp),
					)
				)
			CompilerTypeKeep(_):
				False
		and match compiler_typed_expr_binary_right_widening(result.expr):
			CompilerTypeWiden(from_type, to_type, reason):
				(
					compiler_types_equal(from_type, CompilerConstIntType(2))
					and compiler_types_equal(to_type, compiler_type_int())
					and compiler_widening_reasons_equal(
						reason,
						CompilerNumericOperator(ParsedAddOp),
					)
				)
			CompilerTypeKeep(_):
				False
	)


