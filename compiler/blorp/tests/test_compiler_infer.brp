			None:
				False
		and string_result.context.state.errors.length() == 0
		and compiler_types_equal(compiler_typed_expr_semantic_type(string_result.expr), compiler_type_int())
		and match compiler_typed_expr_resolved_call(string_result.expr):
			Some(info):
				info.callee_name == "describe" and info.callable_id == Some(102)
			None:
				False
	)


