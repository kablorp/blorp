func test_subscript_errors_are_specific() -> Bool:
	list_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		subscript_expr(list_expr([int_expr("1")]), [int_expr("0")]),
	)
	oob_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		subscript_expr(vector_expr([int_expr("1")]), [int_expr("1")]),
	)
	runtime_result = compiler_infer_expr(
		compiler_infer_context(state_with_int_binding("i")),
		subscript_expr(vector_expr([int_expr("1")]), [ParsedNameExpr(ident("i"))]),
	)

	(
		list_result.context.state.errors.length() == 1
