		and compiler_env_get_var_type(result.context.state.env, "None") == None
	)


func test_match_constructor_pattern_errors_are_specific() -> Bool:
	arity_result = compiler_infer_expr(
		compiler_infer_context(state_with_option_int_value()),
		ParsedMatchExpr(
			ParsedNameExpr(ident("maybe")),
			[match_case(
					ParsedConstructorPattern(ident("Some"), [], source_span()),
					int_expr("1"),
				), match_case(ParsedWildcardPattern(source_span()), int_expr("0"))],
			source_span(),
		),
	)
	parent_result = compiler_infer_expr(
		compiler_infer_context(state_with_option_int_value()),
		ParsedMatchExpr(int_expr("1"), [match_case(
					ParsedConstructorPattern(
						ident("Some"),
						[ParsedWildcardPattern(source_span())],
						source_span(),
					),
					int_expr("1"),
				)], source_span()),
	)
	unknown_result = compiler_infer_expr(
		compiler_infer_context(state_with_option_int_value()),
		ParsedMatchExpr(
			ParsedNameExpr(ident("maybe")),
			[match_case(
					ParsedConstructorPattern(ident("Missing"), [], source_span()),
					int_expr("1"),
				), match_case(ParsedWildcardPattern(source_span()), int_expr("0"))],
			source_span(),
		),
	)

	arity_result.context.state.errors.length() == 1 and arity_result.context.state.errors
		.get_or(0, "")
		.contains(
			"Constructor Some expects 1 field(s), but pattern has 0",
		) and parent_result.context.state.errors.length() == 1 and parent_result.context.state.errors
		.get_or(0, "")
		.contains(
			"Constructor Some cannot match scrutinee of type #1",
		) and unknown_result.context.state.errors.length() == 1 and unknown_result.context.state.errors
		.get_or(0, "")
		.contains("Unknown constructor pattern `Missing`")


func test_match_constructor_exhaustiveness_reports_missing_variants() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(state_with_option_int_value()),
		ParsedMatchExpr(ParsedNameExpr(ident("maybe")), [match_case(
					ParsedConstructorPattern(
						ident("Some"),
						[ParsedNamePattern(ident("value"))],
						source_span(),
					),
					ParsedNameExpr(ident("value")),
				)], source_span()),
	)

	result.context.state.errors.length() == 1 and result.context.state.errors
		.get_or(0, "")
		.contains("Non-exhaustive match on Option: missing None")


func test_match_list_exhaustiveness() -> Bool:
	no_spread_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedMatchExpr(list_expr([int_expr("1"), int_expr("2")]), [match_case(
					ParsedListPattern([ParsedNamePattern(ident("value"))], None, source_span()),
					int_expr("1"),
				)], source_span()),
	)
	missing_empty_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedMatchExpr(list_expr([int_expr("1"), int_expr("2")]), [match_case(
					ParsedListPattern(
						[ParsedNamePattern(ident("head"))],
						Some(ParsedListSpreadName(ident("tail"))),
						source_span(),
					),
					int_expr("1"),
				)], source_span()),
	)
	exhaustive_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedMatchExpr(
			list_expr([int_expr("1"), int_expr("2")]),
			[match_case(
					ParsedListPattern([], None, source_span()),
					int_expr("0"),
				), match_case(
					ParsedListPattern(
						[ParsedNamePattern(ident("head"))],
						Some(ParsedListSpreadName(ident("tail"))),
						source_span(),
					),
					ParsedNameExpr(ident("head")),
				)],
			source_span(),
		),
	)

	no_spread_result.context.state.errors.length() == 1 and no_spread_result.context.state.errors
		.get_or(0, "")
		.contains(
			"Non-exhaustive match on List: add a catch-all spread pattern",
		) and missing_empty_result.context.state.errors.length() == 1 and missing_empty_result.context.state.errors
		.get_or(0, "")
		.contains(
			"Non-exhaustive match on List: missing []",
		) and exhaustive_result.context.state.errors.length() == 0 and compiler_types_equal(
		compiler_typed_expr_semantic_type(exhaustive_result.expr),
		compiler_type_int(),
	)


func test_match_open_scalar_requires_catch_all() -> Bool:
	non_exhaustive_result = compiler_infer_expr(
		compiler_infer_context(state_with_int_binding("count")),
		ParsedMatchExpr(ParsedNameExpr(ident("count")), [match_case(
					ParsedIntPattern("1", source_span()),
					int_expr("1"),
				)], source_span()),
	)
	exhaustive_result = compiler_infer_expr(
		compiler_infer_context(state_with_int_binding("count")),
		ParsedMatchExpr(
			ParsedNameExpr(ident("count")),
			[match_case(
					ParsedIntPattern("1", source_span()),
					int_expr("1"),
				), match_case(ParsedWildcardPattern(source_span()), int_expr("0"))],
			source_span(),
		),
	)

	(
		non_exhaustive_result.context.state.errors.length() == 1
		and non_exhaustive_result.context.state.errors
			.get_or(0, "")
			.contains("Non-exhaustive match on Int: add a wildcard")
		and exhaustive_result.context.state.errors.length() == 0
	)


func test_match_nested_pattern_errors_are_specific() -> Bool:
	tuple_arity_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedMatchExpr(
			tuple_expr([int_expr("1")]),
			[
				match_case(
					ParsedTuplePattern(
						[ParsedNamePattern(ident("left")), ParsedNamePattern(ident("right"))],
						source_span(),
					),
					int_expr("1"),
				),
			],
			source_span(),
		),
	)
	list_type_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedMatchExpr(int_expr("1"), [match_case(
					ParsedListPattern(
						[],
						Some(ParsedListSpreadWildcard(source_span())),
						source_span(),
					),
					int_expr("1"),
				)], source_span()),
	)
	or_binding_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedMatchExpr(
			int_expr("1"),
			[
				match_case(
					ParsedOrPattern(
						[ParsedNamePattern(ident("value")), ParsedWildcardPattern(source_span())],
						source_span(),
					),
					ParsedNameExpr(ident("value")),
				),
			],
			source_span(),
		),
	)

	(
		tuple_arity_result.context.state.errors.length() == 1
		and tuple_arity_result.context.state.errors
			.get_or(0, "")
			.contains("Tuple pattern has 2 elements, but scrutinee tuple has 1 elements")
		and list_type_result.context.state.errors.length() == 1
		and list_type_result.context.state.errors
			.get_or(0, "")
			.contains("List pattern cannot match scrutinee of type #1")
		and or_binding_result.context.state.errors.length() == 1
		and or_binding_result.context.state.errors
			.get_or(0, "")
			.contains("Or-pattern alternatives must bind the same variables")
	)


func test_match_errors_are_specific() -> Bool:
	non_exhaustive_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedMatchExpr(bool_expr(True), [match_case(
					ParsedBoolPattern(True, source_span()),
					int_expr("1"),
				)], source_span()),
	)
	branch_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedMatchExpr(
			bool_expr(True),
			[match_case(
					ParsedBoolPattern(True, source_span()),
					int_expr("1"),
				), match_case(
					ParsedBoolPattern(False, source_span()),
					string_expr("x"),
				)],
			source_span(),
		),
	)

	(
		non_exhaustive_result.context.state.errors.length() == 1
		and non_exhaustive_result.context.state.errors
			.get_or(0, "")
			.contains("Non-exhaustive match on Bool: missing False")
		and branch_result.context.state.errors.length() == 1
		and branch_result.context.state.errors
			.get_or(0, "")
			.contains("Match branch type mismatch: expected #1, got String")
	)


func test_while_break_and_continue_loop_context() -> Bool:
	break_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedBreakExpr(source_span()),
	)
	continue_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedContinueExpr(source_span()),
	)
	while_break_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedWhileExpr(bool_expr(True), ParsedBreakExpr(source_span()), source_span()),
	)
	while_continue_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedWhileExpr(bool_expr(True), ParsedContinueExpr(source_span()), source_span()),
	)

	break_result.context.state.errors.length() == 1 and break_result.context.state.errors
		.get_or(0, "")
		.contains(
			"'break' can only be used inside a loop",
		) and continue_result.context.state.errors.length() == 1 and continue_result.context.state.errors
		.get_or(0, "")
		.contains(
			"'continue' can only be used inside a loop",
		) and while_break_result.context.state.errors.length() == 0 and compiler_types_equal(
		compiler_typed_expr_semantic_type(while_break_result.expr),
		compiler_type_void(),
	) and while_continue_result.context.state.errors.length() == 0 and compiler_types_equal(
		compiler_typed_expr_semantic_type(while_continue_result.expr),
		compiler_type_void(),
	)


