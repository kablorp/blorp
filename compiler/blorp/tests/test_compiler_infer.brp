		.get_or(0, "")
		.contains(
			"Duplicate concurrent binding `left`",
		) and sibling_result.context.state.errors.length() == 1 and sibling_result.context.state.errors
		.get_or(0, "")
		.contains("concurrent binding `left` is not available inside another concurrent task")


