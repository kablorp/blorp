func test_dict_literal_infers_key_value_types_and_widening() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		dict_expr([
			dict_entry(int_expr("1"), string_expr("one")),
			dict_entry(int_expr("2"), string_expr("two")),
		]),
	)

	key_widening_ok = match compiler_typed_expr_dict_key_widening(result.expr, 0):
		CompilerTypeWiden(from_type, to_type, reason):
			(
				compiler_types_equal(from_type, CompilerConstIntType(1))
				and compiler_types_equal(to_type, compiler_type_int())
				and compiler_widening_reasons_equal(
					reason,
					CompilerCollectionElement(CompilerDictLiteral),
				)
			)
		CompilerTypeKeep(_):
			False

	value_widening_ok = match compiler_typed_expr_dict_value_widening(result.expr, 0):
		CompilerTypeKeep(value_type):
			compiler_types_equal(value_type, compiler_type_string())
		CompilerTypeWiden(_, _, _):
			False

	result.context.state.errors.length() == 0 and compiler_types_equal(
		compiler_typed_expr_semantic_type(result.expr),
		CompilerNamedType(
			"Dict",
			[compiler_type_int(), compiler_type_string()],
		),
	) and key_widening_ok and value_widening_ok


