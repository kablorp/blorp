		and compiler_types_equal(compiler_typed_expr_semantic_type(result.expr), compiler_type_void())
		and compiler_env_get_var_type(result.context.state.env, "item") == None
	)


func test_for_tuple_binder_binds_iterable_tuple_elements() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedForExpr(
			ParsedForTupleBinder([ident("a"), ident("b")], source_span()),
			list_expr([tuple_expr([int_expr("1"), string_expr("two")])]),
			ParsedBlockExpr(
				[
					ParsedNameExpr(ident("a")),
					ParsedNameExpr(ident("b")),
				],
				source_span(),
			),
			source_span(),
		),
	)

	(
		result.context.state.errors.length() == 0
		and compiler_types_equal(compiler_typed_expr_semantic_type(result.expr), compiler_type_void())
		and compiler_env_get_var_type(result.context.state.env, "a") == None
		and compiler_env_get_var_type(result.context.state.env, "b") == None
	)


func test_for_tuple_binder_binds_dict_entries() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
