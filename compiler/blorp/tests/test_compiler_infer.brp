func test_range_expr_requires_int_endpoints() -> Bool:
	ok_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		range_expr(int_expr("0"), int_expr("3")),
	)
	error_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		range_expr(string_expr("start"), string_expr("end")),
	)

	(
		ok_result.context.state.errors.length() == 0
		and compiler_types_equal(
			compiler_typed_expr_semantic_type(ok_result.expr),
			CompilerNamedType("Range", []),
		)
		and error_result.context.state.errors.length() == 2
		and error_result.context.state.errors
			.get_or(0, "")
			.contains("Range start must be Int, got String")
		and error_result.context.state.errors
			.get_or(1, "")
			.contains("Range end must be Int, got String")
	)


func test_if_with_else_infers_common_int_type() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedIfExpr(
			bool_expr(True),
			int_expr("1"),
			Some(int_expr("2")),
			source_span(),
		),
	)

	(
		result.context.state.errors.length() == 0
		and compiler_types_equal(compiler_typed_expr_semantic_type(result.expr), compiler_type_int())
	)


func test_if_without_else_requires_void_then_branch() -> Bool:
	ok_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedIfExpr(
			bool_expr(True),
			ParsedVoidExpr(source_span()),
			None,
			source_span(),
		),
	)
	error_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedIfExpr(
			bool_expr(True),
			int_expr("1"),
			None,
			source_span(),
		),
	)

	(
		ok_result.context.state.errors.length() == 0
		and compiler_types_equal(compiler_typed_expr_semantic_type(ok_result.expr), compiler_type_void())
		and error_result.context.state.errors.length() == 1
		and error_result.context.state.errors
			.get_or(0, "")
			.contains("if-expression without else cannot produce a value")
	)


func test_if_errors_for_condition_and_branch_mismatch() -> Bool:
	condition_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedIfExpr(
			string_expr("x"),
			int_expr("1"),
			Some(int_expr("2")),
			source_span(),
		),
	)
	branch_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedIfExpr(
			bool_expr(True),
			int_expr("1"),
			Some(string_expr("x")),
			source_span(),
		),
	)

	(
		condition_result.context.state.errors.length() == 1
		and condition_result.context.state.errors
			.get_or(0, "")
			.contains("If condition must be Bool, got String")
		and branch_result.context.state.errors.length() == 1
		and branch_result.context.state.errors
			.get_or(0, "")
			.contains("If-else type mismatch: then-branch returns")
	)


func test_match_bool_patterns_infer_common_type() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedMatchExpr(
			bool_expr(True),
			[
				match_case(ParsedBoolPattern(True, source_span()), int_expr("1")),
				match_case(ParsedBoolPattern(False, source_span()), int_expr("2")),
			],
			source_span(),
		),
	)

	(
		result.context.state.errors.length() == 0
		and compiler_types_equal(compiler_typed_expr_semantic_type(result.expr), compiler_type_int())
	)


func test_match_name_pattern_binds_inside_case_only() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedMatchExpr(
			int_expr("1"),
			[match_case(ParsedNamePattern(ident("value")), ParsedNameExpr(ident("value")))],
			source_span(),
		),
	)

	(
		result.context.state.errors.length() == 0
		and compiler_types_equal(compiler_typed_expr_semantic_type(result.expr), CompilerConstIntType(1))
		and compiler_env_get_var_type(result.context.state.env, "value") == None
	)


func test_match_errors_are_specific() -> Bool:
	non_exhaustive_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedMatchExpr(
			bool_expr(True),
			[match_case(ParsedBoolPattern(True, source_span()), int_expr("1"))],
			source_span(),
		),
	)
	branch_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedMatchExpr(
			bool_expr(True),
			[
				match_case(ParsedBoolPattern(True, source_span()), int_expr("1")),
				match_case(ParsedBoolPattern(False, source_span()), string_expr("x")),
			],
			source_span(),
		),
	)

	(
		non_exhaustive_result.context.state.errors.length() == 1
		and non_exhaustive_result.context.state.errors
			.get_or(0, "")
			.contains("Non-exhaustive match on Bool: missing False")
		and branch_result.context.state.errors.length() == 1
		and branch_result.context.state.errors
			.get_or(0, "")
			.contains("Match branch type mismatch: expected #1, got String")
	)


func test_while_break_and_continue_loop_context() -> Bool:
	break_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedBreakExpr(source_span()),
	)
	continue_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedContinueExpr(source_span()),
	)
	while_break_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedWhileExpr(bool_expr(True), ParsedBreakExpr(source_span()), source_span()),
	)
	while_continue_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedWhileExpr(bool_expr(True), ParsedContinueExpr(source_span()), source_span()),
	)

	(
		break_result.context.state.errors.length() == 1
		and break_result.context.state.errors
			.get_or(0, "")
			.contains("'break' can only be used inside a loop")
		and continue_result.context.state.errors.length() == 1
		and continue_result.context.state.errors
			.get_or(0, "")
			.contains("'continue' can only be used inside a loop")
		and while_break_result.context.state.errors.length() == 0
		and compiler_types_equal(compiler_typed_expr_semantic_type(while_break_result.expr), compiler_type_void())
		and while_continue_result.context.state.errors.length() == 0
		and compiler_types_equal(compiler_typed_expr_semantic_type(while_continue_result.expr), compiler_type_void())
	)


func test_while_condition_must_be_bool() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedWhileExpr(string_expr("x"), ParsedVoidExpr(source_span()), source_span()),
	)

	(
		result.context.state.errors.length() == 1
		and result.context.state.errors
			.get_or(0, "")
			.contains("While condition must be Bool, got String")
	)


func test_for_range_binder_is_scoped_to_body() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		for_name_expr(
			"i",
			range_expr(int_expr("0"), int_expr("3")),
			ParsedNameExpr(ident("i")),
		),
	)

	(
		result.context.state.errors.length() == 0
		and compiler_types_equal(compiler_typed_expr_semantic_type(result.expr), compiler_type_void())
		and compiler_env_get_var_type(result.context.state.env, "i") == None
	)


func test_for_list_binder_allows_loop_control() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		for_name_expr(
			"item",
			list_expr([int_expr("1"), int_expr("2")]),
			ParsedBlockExpr(
				[
					ParsedNameExpr(ident("item")),
					ParsedContinueExpr(source_span()),
				],
				source_span(),
			),
