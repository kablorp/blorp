func test_match_list_pattern_binds_elements_and_spread() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedMatchExpr(
			list_expr([int_expr("1"), int_expr("2")]),
			[match_case(
					ParsedListPattern([], None, source_span()),
					tuple_expr([
						ParsedAscriptionExpr(int_expr("0"), named_type("Int"), source_span()),
						list_expr([int_expr("0")]),
					]),
				), match_case(
					ParsedListPattern(
						[ParsedNamePattern(ident("head"))],
						Some(ParsedListSpreadName(ident("tail"))),
						source_span(),
					),
					tuple_expr([
						ParsedNameExpr(ident("head")),
						ParsedNameExpr(ident("tail")),
					]),
				)],
			source_span(),
		),
	)

	(
		result.context.state.errors.length() == 0
		and compiler_types_equal(compiler_typed_expr_semantic_type(result.expr), CompilerTupleType([
				compiler_type_int(),
				compiler_type_list(compiler_type_int()),
			]))
		and compiler_env_get_var_type(result.context.state.env, "head") == None
		and compiler_env_get_var_type(result.context.state.env, "tail") == None
	)


