func test_tuple_destruct_errors_are_specific() -> Bool:
	arity_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		tuple_destruct_expr(["a"], tuple_expr([int_expr("1"), int_expr("2")])),
	)
	non_tuple_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		tuple_destruct_expr(
			["a", "b"],
			int_expr("1"),
		),
	)
	redeclare_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedBlockExpr(
			[
				ParsedVarDeclExpr(ident("a"), None, int_expr("1"), False, source_span()),
				tuple_destruct_expr(
					["a", "b"],
					tuple_expr([int_expr("2"), int_expr("3")]),
				),
			],
			source_span(),
		),
	)

	arity_result.context.state.errors.length() == 1 and arity_result.context.state.errors
		.get_or(0, "")
		.contains(
			"Tuple destructuring arity mismatch: expected 1 elements, got 2",
		) and non_tuple_result.context.state.errors.length() == 1 and non_tuple_result.context.state.errors
		.get_or(0, "")
		.contains(
			"Tuple destructuring requires a tuple type, got #1",
		) and redeclare_result.context.state.errors.length() == 1 and redeclare_result.context.state.errors
		.get_or(0, "")
		.contains("Cannot redeclare `a` in tuple destructuring")


