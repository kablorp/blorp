func test_record_literal_errors_are_specific() -> Bool:
	missing_result = compiler_infer_expr(
		compiler_infer_with_expected(
			compiler_infer_context(state_with_point_record()),
			CompilerNamedType("Point", []),
		),
		record_expr([record_field("x", int_expr("1"))]),
	)
	unknown_result = compiler_infer_expr(
		compiler_infer_with_expected(
			compiler_infer_context(state_with_point_record()),
			CompilerNamedType("Point", []),
		),
		record_expr([
			record_field("x", int_expr("1")),
			record_field("z", string_expr("bad")),
		]),
	)
	empty_result = compiler_infer_expr(
		compiler_infer_context(state_with_point_record()),
		record_expr([]),
	)

	missing_result.context.state.errors.length() == 1 and missing_result.context.state.errors
		.get_or(0, "")
		.contains(
			"Record literal is missing field(s): y",
		) and unknown_result.context.state.errors.length() == 2 and unknown_result.context.state.errors
		.get_or(0, "")
		.contains(
			"Unknown field 'z' in record literal. Valid fields: x, y",
		) and unknown_result.context.state.errors
		.get_or(1, "")
		.contains(
			"Record literal is missing field(s): y",
		) and empty_result.context.state.errors.length() == 1 and empty_result.context.state.errors
		.get_or(0, "")
		.contains("Cannot infer record type without annotation")


