	)
	sibling_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedConcurrentBlockExpr(
			[],
			ParsedBlockExpr(
				[
					assign_expr("left", int_expr("1")),
					assign_expr("right", ParsedNameExpr(ident("left"))),
				],
