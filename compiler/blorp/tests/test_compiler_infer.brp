pure func source_file() -> CompilerSourceFile:
	compiler_source_file("infer.brp", "infer", "func main(): 1")


pure func source_span() -> CompilerSourceSpan:
	src: CompilerSourceFile = source_file()
	cursor: CompilerCursor = compiler_source_cursor_at(src, 0)
	compiler_source_span(src, cursor, cursor)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, source_span())


pure func lambda_param(name: String, type_expr: Option[ParsedTypeExpr]) -> ParsedLambdaParam:
	{
		name = ident(name),
		type_expr = type_expr,
		span = source_span()
	}


pure func named_type(name: String) -> ParsedTypeExpr:
	ParsedNamedType(ident(name), [], source_span())


pure func generic_named_type(name: String, args: List[ParsedTypeExpr]) -> ParsedTypeExpr:
	ParsedNamedType(ident(name), args, source_span())


pure func int_expr(text: String) -> ParsedExpr:
	ParsedIntLiteralExpr(text, source_span())


pure func string_expr(text: String) -> ParsedExpr:
	ParsedStringLiteralExpr(text, ParsedPlainStringLiteral, source_span())


pure func interpolation_expr(parts: List[ParsedStringInterpolationPart]) -> ParsedExpr:
	ParsedStringInterpolationPartsExpr(parts, False, source_span())


pure func bool_expr(value: Bool) -> ParsedExpr:
	ParsedBoolLiteralExpr(value, source_span())


pure func float_expr(text: String) -> ParsedExpr:
	ParsedFloatLiteralExpr(text, source_span())


pure func binary_expr(op: ParsedBinaryOp, left: ParsedExpr, right: ParsedExpr) -> ParsedExpr:
	ParsedBinaryExpr(op, left, right, source_span())


pure func call_expr(callee: ParsedExpr, args: List[ParsedExpr]) -> ParsedExpr:
	ParsedCallExpr(callee, args, source_span())


pure func concurrent_param(name: String, value: ParsedExpr) -> ParsedConcurrentParam:
	{
		name = ident(name),
		value = value,
		span = source_span()
	}


pure func select_receive_arm(
	name: String,
	channel: ParsedExpr,
	body: ParsedExpr,
) -> ParsedSelectArm:
	{
		kind = ParsedSelectReceiveArm(ident(name), channel),
		body = body,
		span = source_span()
	}


pure func select_sealed_arm(channel: ParsedExpr, body: ParsedExpr) -> ParsedSelectArm:
	{
		kind = ParsedSelectSealedArm(channel),
		body = body,
		span = source_span()
	}


pure func select_after_arm(timeout: ParsedExpr, body: ParsedExpr) -> ParsedSelectArm:
	{
		kind = ParsedSelectAfterArm(timeout),
		body = body,
		span = source_span()
	}


pure func tuple_expr(items: List[ParsedExpr]) -> ParsedExpr:
	ParsedTupleExpr(items, source_span())


pure func tuple_destruct_expr(names: List[String], value: ParsedExpr) -> ParsedExpr:
	ParsedTupleDestructExpr(
		names.map(ident),
		value,
		source_span(),
	)


pure func assign_expr(name: String, value: ParsedExpr) -> ParsedExpr:
	ParsedAssignExpr(ident(name), value, source_span())


pure func compound_assign_expr(name: String, value: ParsedExpr) -> ParsedExpr:
	ParsedCompoundAssignExpr(ident(name), ParsedAssignAddOp, value, source_span())


pure func question_bind_expr(
	name: String,
	annotation: Option[ParsedTypeExpr],
	value: ParsedExpr,
) -> ParsedExpr:
	ParsedQuestionBindExpr(ident(name), annotation, value, source_span())


pure func with_error_map(name: String, value: ParsedExpr) -> ParsedWithErrorMap:
	{
		name = ident(name),
		value = value,
		span = source_span()
	}


pure func with_binding(
	name: String,
	annotation: Option[ParsedTypeExpr],
	value: ParsedExpr,
	kind: ParsedWithBindingKind,
	error_map: Option[ParsedWithErrorMap],
) -> ParsedWithBinding:
	{
		name = ident(name),
		type_expr = annotation,
		value = value,
		kind = kind,
		error_map = error_map,
		span = source_span()
	}


pure func match_case(pattern: ParsedPattern, body: ParsedExpr) -> ParsedMatchCase:
	{
		pattern = pattern,
		body = body,
		span = source_span()
	}


pure func list_expr(items: List[ParsedExpr]) -> ParsedExpr:
	ParsedListExpr(items, source_span())


pure func vector_expr(items: List[ParsedExpr]) -> ParsedExpr:
	ParsedVectorExpr(items, source_span())


pure func dict_entry(key: ParsedExpr, value: ParsedExpr) -> ParsedDictEntry:
	{
		key = key,
		value = value,
		span = source_span()
	}


pure func dict_expr(entries: List[ParsedDictEntry]) -> ParsedExpr:
	ParsedDictExpr(entries, source_span())


pure func record_field(name: String, value: ParsedExpr) -> ParsedRecordExprField:
	{
		name = ident(name),
		value = value,
		span = source_span()
	}


pure func record_expr(fields: List[ParsedRecordExprField]) -> ParsedExpr:
	ParsedRecordExpr(fields, source_span())


pure func record_update_expr(
	receiver: ParsedExpr,
	fields: List[ParsedRecordExprField],
) -> ParsedExpr:
	ParsedRecordUpdateExpr(receiver, fields, source_span())


pure func field_access_expr(receiver: ParsedExpr, field: String) -> ParsedExpr:
	ParsedFieldAccessExpr(receiver, ident(field), source_span())


pure func subscript_expr(receiver: ParsedExpr, indices: List[ParsedExpr]) -> ParsedExpr:
	ParsedSubscriptExpr(receiver, indices, source_span())


pure func subscript_assign_expr(
	target: ParsedExpr,
	indices: List[ParsedExpr],
	value: ParsedExpr,
) -> ParsedExpr:
	ParsedSubscriptAssignExpr(target, indices, value, source_span())


pure func vector_subscript_assign_block(
	is_mutable: Bool,
	indices: List[ParsedExpr],
	value: ParsedExpr,
) -> ParsedExpr:
	ParsedBlockExpr(
		[
			ParsedVarDeclExpr(
				ident("values"),
				None,
				vector_expr([int_expr("1"), int_expr("2")]),
				is_mutable,
				source_span(),
			),
			subscript_assign_expr(ParsedNameExpr(ident("values")), indices, value),
		],
		source_span(),
	)


pure func range_expr(start_expr: ParsedExpr, end_expr: ParsedExpr) -> ParsedExpr:
	ParsedRangeExpr(start_expr, end_expr, source_span())


pure func for_name_expr(name: String, iterable: ParsedExpr, body: ParsedExpr) -> ParsedExpr:
	ParsedForExpr(ParsedForNameBinder(ident(name)), iterable, body, source_span())


pure func optional_types_equal(left: Option[CompilerType], right: Option[CompilerType]) -> Bool:
	match (left, right):
		(Some(left_type), Some(right_type)):
			compiler_types_equal(left_type, right_type)
		(None, None):
			True
		_:
			False


pure func state_with_int_binding(name: String) -> CompilerTypecheckState:
	state = compiler_typecheck_state_empty()
	{ state |
		env = compiler_env_add_var_with_details(
			state.env,
			name,
			compiler_type_int(),
			Some(compiler_type_int()),
			CompilerImmutableBinding,
			CompilerLetBinding,
			compiler_unrefined_binding(),
		)
	}


pure func state_with_list_binding(
	name: String,
	element_type: CompilerType,
) -> CompilerTypecheckState:
	state = compiler_typecheck_state_empty()
	list_type = compiler_type_list(element_type)
	{ state |
		env = compiler_env_add_var_with_details(
			state.env,
			name,
			list_type,
			Some(list_type),
			CompilerImmutableBinding,
			CompilerLetBinding,
			compiler_unrefined_binding(),
		)
	}


pure func compiler_type_channel(element: CompilerType) -> CompilerType:
	CompilerNamedType("Channel", [element])


pure func state_with_channel_binding(
	name: String,
	element_type: CompilerType,
) -> CompilerTypecheckState:
	state = compiler_typecheck_state_empty()
	{ state |
		env = compiler_env_add_var_with_details(
			state.env,
			name,
			compiler_type_channel(element_type),
			Some(compiler_type_channel(element_type)),
			CompilerImmutableBinding,
			CompilerLetBinding,
			compiler_unrefined_binding(),
		)
	}


pure func state_with_add_one_func() -> CompilerTypecheckState:
	state = compiler_typecheck_state_empty()
	{ state | env = compiler_env_add_func(
			state.env,
			"add_one",
			CompilerFunctionType(True, [compiler_type_int()], compiler_type_int()),
			CompilerPure,
			CompilerUserDefinedFunc,
		) }


pure func state_with_impure_tick_func() -> CompilerTypecheckState:
	state = compiler_typecheck_state_empty()
	{ state | env = compiler_env_add_func(
			state.env,
			"tick",
			CompilerFunctionType(True, [compiler_type_int()], compiler_type_int()),
			CompilerImpure,
			CompilerUserDefinedFunc,
		) }


pure func state_with_channel_and_impure_tick() -> CompilerTypecheckState:
	state = state_with_impure_tick_func()
	{ state |
		env = compiler_env_add_var_with_details(
			state.env,
			"ch",
			compiler_type_channel(compiler_type_int()),
			Some(compiler_type_channel(compiler_type_int())),
			CompilerImmutableBinding,
			CompilerLetBinding,
			compiler_unrefined_binding(),
		)
	}


pure func state_with_list_and_impure_tick() -> CompilerTypecheckState:
	state = state_with_impure_tick_func()
	list_type = compiler_type_list(compiler_type_int())
	{ state |
		env = compiler_env_add_var_with_details(
			state.env,
			"nums",
			list_type,
			Some(list_type),
			CompilerImmutableBinding,
			CompilerLetBinding,
			compiler_unrefined_binding(),
		)
	}


pure func compiler_type_reader() -> CompilerType:
	CompilerNamedType("Reader", [])


pure func compiler_type_stream(inner: CompilerType) -> CompilerType:
	CompilerNamedType("Stream", [inner])


pure func compiler_type_fallible_stream(
	inner: CompilerType,
	error_type: CompilerType,
) -> CompilerType:
	CompilerNamedType(
		"FallibleStream",
		[inner, error_type],
	)


pure func compiler_type_resource_source(
	resource_type: CompilerType,
	error_type: CompilerType,
) -> CompilerType:
	CompilerNamedType(
		"ResourceSource",
		[resource_type, error_type],
	)


pure func compiler_type_option(inner: CompilerType) -> CompilerType:
	CompilerNamedType("Option", [inner])


pure func compiler_type_result(ok_type: CompilerType, error_type: CompilerType) -> CompilerType:
	CompilerNamedType(
		"Result",
		[ok_type, error_type],
	)


pure func add_infer_value(
	state: CompilerTypecheckState,
	name: String,
	typ: CompilerType,
) -> CompilerTypecheckState:
	{ state |
		env = compiler_env_add_var_with_details(
			state.env,
			name,
			typ,
			Some(typ),
			CompilerImmutableBinding,
			CompilerLetBinding,
			compiler_unrefined_binding(),
		)
	}


pure func state_with_resource_values() -> CompilerTypecheckState:
	with_resource_type = compiler_typecheck_state_add_known_resource_type_name(
		compiler_typecheck_state_empty(),
		"Reader",
	)
	with_reader = add_infer_value(with_resource_type, "reader_source", compiler_type_reader())
	with_maybe_reader = add_infer_value(
		with_reader,
		"maybe_reader",
		compiler_type_option(compiler_type_reader()),
	)
	with_result_reader = add_infer_value(
		with_maybe_reader,
		"result_reader",
		compiler_type_result(compiler_type_reader(), compiler_type_int()),
	)
	with_option_result = add_infer_value(
		with_result_reader,
		"option_result",
		compiler_type_option(compiler_type_int()),
	)
	add_infer_value(
		with_option_result,
		"result_value",
		compiler_type_result(compiler_type_int(), compiler_type_string()),
	)


pure func state_with_stream_and_source_values() -> CompilerTypecheckState:
	state = compiler_typecheck_state_empty()
	with_stream = add_infer_value(state, "s", compiler_type_stream(compiler_type_int()))
	with_fallible_stream = add_infer_value(
		with_stream,
		"fs",
		compiler_type_fallible_stream(compiler_type_string(), compiler_type_string()),
	)
	add_infer_value(
		with_fallible_stream,
		"source",
		compiler_type_resource_source(compiler_type_reader(), compiler_type_string()),
	)


pure func state_with_stream_source_binding_values() -> CompilerTypecheckState:
	state = state_with_stream_and_source_values()
	with_maybe_stream = add_infer_value(
		state,
		"maybe_stream",
		compiler_type_option(compiler_type_stream(compiler_type_int())),
	)
	with_maybe_source = add_infer_value(
		with_maybe_stream,
		"maybe_source",
		compiler_type_option(
			compiler_type_resource_source(
				compiler_type_reader(),
				compiler_type_string(),
			),
		),
	)
	with_stream_carrier_func = add_infer_value(
		with_maybe_source,
		"stream_carrier_func",
		CompilerFunctionType(
			True,
			[],
			compiler_type_option(compiler_type_stream(compiler_type_int())),
		),
	)
	{ with_stream_carrier_func | env = compiler_env_add_func(
			with_stream_carrier_func.env,
			"make_source",
			CompilerFunctionType(
				True,
				[],
				compiler_type_resource_source(compiler_type_reader(), compiler_type_string()),
			),
			CompilerPure,
			CompilerUserDefinedFunc,
		) }


pure func state_with_resource_and_impure_tick() -> CompilerTypecheckState:
	state = state_with_resource_values()
	{ state | env = compiler_env_add_func(
			state.env,
			"tick",
			CompilerFunctionType(True, [compiler_type_int()], compiler_type_int()),
			CompilerImpure,
			CompilerUserDefinedFunc,
		) }


pure func add_resource_operation(
	state: CompilerTypecheckState,
	name: String,
	return_type: CompilerType,
	result_policy: CompilerResourceResultPolicy,
) -> CompilerTypecheckState:
	match compiler_env_mint_def_id(state.env):
		(next_env, def_id):
			symbol = compiler_func_symbol(
				def_id,
				CompilerFunctionType(True, [compiler_type_reader()], return_type),
				[],
				[Some("reader")],
				CompilerPure,
				CompilerUserDefinedFunc,
				CompilerAllowResourceArgs(result_policy),
				None,
				[],
				None,
				False,
			)
			{ state | env = compiler_env_add_func_with_info(next_env, name, symbol) }


pure func state_with_resource_operations() -> CompilerTypecheckState:
	with_dependent_string = add_resource_operation(
		state_with_resource_values(),
		"read_line",
		compiler_type_string(),
		CompilerResourceResultDependent,
	)
	with_dependent_reader = add_resource_operation(
		with_dependent_string,
		"child_reader",
		compiler_type_reader(),
		CompilerResourceResultDependent,
	)
	with_ordinary_string = add_resource_operation(
		with_dependent_reader,
		"reader_path",
		compiler_type_string(),
		CompilerResourceResultOrdinary,
	)
	{ with_ordinary_string | env = compiler_env_add_func(
			with_ordinary_string.env,
			"ordinary_len",
			CompilerFunctionType(True, [compiler_type_string()], compiler_type_int()),
			CompilerPure,
			CompilerUserDefinedFunc,
		) }


pure func state_with_module_scale_func() -> (CompilerTypecheckState, Int):
	state = compiler_typecheck_state_register_module_alias(
		compiler_typecheck_state_empty(),
		"M",
		"math",
	)

	match compiler_env_mint_def_id(state.env):
		(next_env, def_id):
			symbol = compiler_func_symbol(
				def_id,
				CompilerFunctionType(True, [compiler_type_int()], compiler_type_int()),
				[],
				[Some("value")],
				CompilerPure,
				CompilerUserDefinedFunc,
				CompilerRejectResourceArgs,
				Some("math"),
				[],
				None,
				False,
			)
			({ state | env = compiler_env_add_func_with_info(next_env, "scale", symbol) }, def_id)


pure func state_with_module_version_var() -> CompilerTypecheckState:
	state = compiler_typecheck_state_register_module_alias(
		compiler_typecheck_state_empty(),
		"M",
		"math",
	)
	with_local = compiler_env_add_var_with_details(
		state.env,
		"version",
		compiler_type_int(),
		Some(compiler_type_int()),
		CompilerImmutableBinding,
		CompilerLetBinding,
		compiler_unrefined_binding(),
	)
	with_module = compiler_env_add_var_with_module_details(
		with_local,
		"build_version",
		compiler_type_string(),
		Some(compiler_type_string()),
		CompilerImmutableBinding,
		CompilerLetBinding,
		compiler_unrefined_binding(),
		Some("math"),
	)

	{ state | env = with_module }


pure func infer_overload_entry(
	def_id: Int,
	param_type: CompilerType,
	return_type: CompilerType,
) -> CompilerOverloadEntry:
	{
		def_id = def_id,
		func_type = CompilerFunctionType(True, [param_type], return_type),
		type_params = [],
		param_names = [Some("value")],
		purity = CompilerPure,
		origin = CompilerUserDefinedFunc,
		resource_args = CompilerRejectResourceArgs,
		module_path = None,
		dim_constraints = [],
		loop_producer = None,
		debug_only = False
	}


pure func infer_two_arg_overload_entry(
	def_id: Int,
	first_param_type: CompilerType,
	second_param_type: CompilerType,
	return_type: CompilerType,
) -> CompilerOverloadEntry:
	{
		def_id = def_id,
		func_type = CompilerFunctionType(
			True,
			[first_param_type, second_param_type],
