func test_concurrent_for_rejects_value_context_non_list_and_bad_params() -> Bool:
	value_context_result = compiler_infer_expr(
		compiler_infer_with_expected_value_slot(
			compiler_infer_context(state_with_list_binding("nums", compiler_type_int())),
			compiler_type_int(),
			CompilerExpectedArgumentSlot,
		),
		ParsedConcurrentForExpr(
			ident("n"),
			ParsedNameExpr(ident("nums")),
			[concurrent_param("limit", int_expr("2"))],
			ParsedBlockExpr([ParsedVoidExpr(source_span())], source_span()),
			source_span(),
		),
	)
	non_list_result = compiler_infer_expr(
		compiler_infer_context(state_with_int_binding("plain")),
		ParsedConcurrentForExpr(
			ident("n"),
			ParsedNameExpr(ident("plain")),
			[concurrent_param("limit", int_expr("2"))],
			ParsedBlockExpr([ParsedVoidExpr(source_span())], source_span()),
			source_span(),
		),
	)
	unknown_param_result = compiler_infer_expr(
		compiler_infer_context(state_with_list_binding("nums", compiler_type_int())),
		ParsedConcurrentForExpr(
			ident("n"),
			ParsedNameExpr(ident("nums")),
			[concurrent_param("workers", int_expr("2"))],
			ParsedBlockExpr([ParsedVoidExpr(source_span())], source_span()),
			source_span(),
		),
	)
	duplicate_param_result = compiler_infer_expr(
		compiler_infer_context(state_with_list_binding("nums", compiler_type_int())),
		ParsedConcurrentForExpr(
			ident("n"),
			ParsedNameExpr(ident("nums")),
			[concurrent_param("limit", int_expr("2")), concurrent_param("limit", int_expr("3"))],
			ParsedBlockExpr(
				[ParsedVoidExpr(source_span())],
				source_span(),
			),
			source_span(),
		),
	)
	bad_limit_result = compiler_infer_expr(
		compiler_infer_context(state_with_list_binding("nums", compiler_type_int())),
		ParsedConcurrentForExpr(
			ident("n"),
			ParsedNameExpr(ident("nums")),
			[concurrent_param("limit", string_expr("two"))],
			ParsedBlockExpr([ParsedVoidExpr(source_span())], source_span()),
			source_span(),
		),
	)
	bad_timeout_result = compiler_infer_expr(
		compiler_infer_context(state_with_list_binding("nums", compiler_type_int())),
		ParsedConcurrentForExpr(
			ident("n"),
			ParsedNameExpr(ident("nums")),
			[
				concurrent_param("limit", int_expr("2")),
				concurrent_param("timeout", string_expr("soon")),
			],
			ParsedBlockExpr(
				[ParsedVoidExpr(source_span())],
				source_span(),
			),
			source_span(),
		),
	)

	(
		value_context_result.context.state.errors.length() == 1
		and value_context_result.context.state.errors
			.get_or(0, "")
			.contains("`for ... concurrently(...)` is statement-only and does not collect results")
		and non_list_result.context.state.errors.length() == 1
		and non_list_result.context.state.errors
			.get_or(0, "")
			.contains("`for ... concurrently` requires a List or ResourceSource, got Int")
		and unknown_param_result.context.state.errors.length() == 1
		and unknown_param_result.context.state.errors
			.get_or(0, "")
			.contains("Unknown `for ... concurrently` parameter `workers`")
		and duplicate_param_result.context.state.errors.length() == 1
		and duplicate_param_result.context.state.errors
			.get_or(0, "")
			.contains("Duplicate `for ... concurrently` parameter `limit`")
		and bad_limit_result.context.state.errors.length() == 1
		and bad_limit_result.context.state.errors
			.get_or(0, "")
			.contains("`for ... concurrently(...)` limit must be Int")
		and bad_timeout_result.context.state.errors.length() == 1
		and bad_timeout_result.context.state.errors
			.get_or(0, "")
			.contains("`for ... concurrently(...)` timeout must be Int milliseconds or Duration")
	)


