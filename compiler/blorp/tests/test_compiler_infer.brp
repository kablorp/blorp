import:
	../compiler_env:
		CompilerFieldDecl,
		CompilerFuncOrigin(CompilerUserDefinedFunc),
		CompilerPurity(CompilerPure),
		CompilerVarMutability(CompilerImmutableBinding),
		CompilerVarOrigin(CompilerLetBinding),
		compiler_env_add_record,
		compiler_env_add_func,
		compiler_env_add_var_with_details,
		compiler_env_get_func_callable_id,
		compiler_env_get_var_type,
	../compiler_infer:
		CompilerExprTypeOrigin(CompilerExplicitAnnotationOrigin),
		CompilerExpectedValueSlotContext(CompilerExpectedArgumentSlot),
		compiler_infer_context,
		compiler_infer_expr,
		compiler_infer_with_expected,
		compiler_infer_with_expected_value_slot,
		compiler_typed_expr_binary_left_widening,
		compiler_typed_expr_binary_right_widening,
		compiler_typed_expr_call_arg_widening,
		compiler_typed_expr_dict_key_widening,
		compiler_typed_expr_dict_value_widening,
		compiler_typed_expr_field_access_receiver_type,
		compiler_typed_expr_list_item_widening,
		compiler_typed_expr_origin,
		compiler_typed_expr_record_field_widening,
		compiler_typed_expr_resolved_call,
		compiler_typed_expr_semantic_type,
		compiler_typed_expr_source_type,
		compiler_typed_expr_value_type,
		compiler_typed_expr_var_initializer_widening,
		compiler_typed_expr_widening,
	../compiler_parsed_ast:
		ParsedBinaryOp(
			ParsedAddOp,
			ParsedEqualOp,
			ParsedLessOp,
			ParsedModuloOp,
		),
		ParsedExpr(
			ParsedAscriptionExpr,
			ParsedBinaryExpr,
			ParsedBlockExpr,
			ParsedBoolLiteralExpr,
			ParsedBreakExpr,
			ParsedCallExpr,
			ParsedContinueExpr,
			ParsedDictExpr,
			ParsedFieldAccessExpr,
			ParsedForExpr,
			ParsedIfExpr,
			ParsedIntLiteralExpr,
			ParsedListExpr,
			ParsedLogicalExpr,
			ParsedNameExpr,
			ParsedRangeExpr,
			ParsedRecordExpr,
			ParsedStringLiteralExpr,
			ParsedTupleExpr,
			ParsedUnaryExpr,
			ParsedVarDeclExpr,
			ParsedWhileExpr,
		),
		ParsedDictEntry,
		ParsedForBinder(ParsedForNameBinder, ParsedForTupleBinder),
		ParsedIdentifier,
		ParsedLogicalOp(ParsedAndOp),
		ParsedRecordExprField,
		ParsedStringLiteralForm(ParsedPlainStringLiteral),
		ParsedTypeExpr(ParsedNamedType),
		ParsedUnaryOp(ParsedNegateOp, ParsedNotOp),
		parsed_identifier,
	../compiler_refinement: compiler_unrefined_binding
	../compiler_source:
		CompilerCursor,
		CompilerSourceFile,
		CompilerSourceSpan,
		compiler_source_cursor_at,
		compiler_source_file,
		compiler_source_span,
	../compiler_type:
		CompilerType(
			CompilerConstIntType,
			CompilerFunctionType,
			CompilerNamedType,
			CompilerRangeType,
			CompilerTupleType,
		),
		compiler_type_bool,
		compiler_type_int,
		compiler_type_list,
		compiler_type_string,
		compiler_type_void,
		compiler_types_equal,
	../compiler_type_widening:
		CompilerCollectionKind(CompilerDictLiteral, CompilerListLiteral),
		CompilerTypeWideningDecision(CompilerTypeKeep, CompilerTypeWiden),
		CompilerTypeWideningReason(
			CompilerArgumentSlot,
			CompilerCollectionElement,
			CompilerMutableBinding,
			CompilerNumericOperator,
		),
		compiler_widening_reasons_equal,
	../compiler_typecheck_state:
		CompilerTypecheckState,
		compiler_typecheck_state_empty,
	test: TestSuite


pure func source_file() -> CompilerSourceFile:
	compiler_source_file("infer.brp", "infer", "func main(): 1")


pure func source_span() -> CompilerSourceSpan:
	src: CompilerSourceFile = source_file()
	cursor: CompilerCursor = compiler_source_cursor_at(src, 0)
	compiler_source_span(src, cursor, cursor)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, source_span())


pure func named_type(name: String) -> ParsedTypeExpr:
	ParsedNamedType(ident(name), [], source_span())


pure func int_expr(text: String) -> ParsedExpr:
	ParsedIntLiteralExpr(text, source_span())


pure func string_expr(text: String) -> ParsedExpr:
	ParsedStringLiteralExpr(text, ParsedPlainStringLiteral, source_span())


pure func bool_expr(value: Bool) -> ParsedExpr:
	ParsedBoolLiteralExpr(value, source_span())


pure func float_expr(text: String) -> ParsedExpr:
	ParsedFloatLiteralExpr(text, source_span())


pure func binary_expr(op: ParsedBinaryOp, left: ParsedExpr, right: ParsedExpr) -> ParsedExpr:
	ParsedBinaryExpr(op, left, right, source_span())


pure func call_expr(callee: ParsedExpr, args: List[ParsedExpr]) -> ParsedExpr:
	ParsedCallExpr(callee, args, source_span())


pure func tuple_expr(items: List[ParsedExpr]) -> ParsedExpr:
	ParsedTupleExpr(items, source_span())


pure func list_expr(items: List[ParsedExpr]) -> ParsedExpr:
	ParsedListExpr(items, source_span())


pure func dict_entry(key: ParsedExpr, value: ParsedExpr) -> ParsedDictEntry:
	{key = key, value = value, span = source_span()}


pure func dict_expr(entries: List[ParsedDictEntry]) -> ParsedExpr:
	ParsedDictExpr(entries, source_span())


pure func record_field(name: String, value: ParsedExpr) -> ParsedRecordExprField:
	{name = ident(name), value = value, span = source_span()}


pure func record_expr(fields: List[ParsedRecordExprField]) -> ParsedExpr:
	ParsedRecordExpr(fields, source_span())


pure func field_access_expr(receiver: ParsedExpr, field: String) -> ParsedExpr:
	ParsedFieldAccessExpr(receiver, ident(field), source_span())


pure func range_expr(start_expr: ParsedExpr, end_expr: ParsedExpr) -> ParsedExpr:
	ParsedRangeExpr(start_expr, end_expr, source_span())


pure func for_name_expr(name: String, iterable: ParsedExpr, body: ParsedExpr) -> ParsedExpr:
	ParsedForExpr(ParsedForNameBinder(ident(name)), iterable, body, source_span())


pure func optional_types_equal(
	left: Option[CompilerType],
	right: Option[CompilerType],
) -> Bool:
	match (left, right):
		(Some(left_type), Some(right_type)):
			compiler_types_equal(left_type, right_type)
		(None, None):
			True
		_:
			False


pure func state_with_int_binding(name: String) -> CompilerTypecheckState:
	state = compiler_typecheck_state_empty()
	{ state |
		env = compiler_env_add_var_with_details(
			state.env,
			name,
			compiler_type_int(),
			Some(compiler_type_int()),
			CompilerImmutableBinding,
			CompilerLetBinding,
			compiler_unrefined_binding(),
		)
	}


pure func state_with_add_one_func() -> CompilerTypecheckState:
	state = compiler_typecheck_state_empty()
	{ state |
		env = compiler_env_add_func(
			state.env,
			"add_one",
			CompilerFunctionType(True, [compiler_type_int()], compiler_type_int()),
			CompilerPure,
			CompilerUserDefinedFunc,
		)
	}


pure func field_decl(name: String, field_type: CompilerType) -> CompilerFieldDecl:
	{name = name, field_type = field_type}


pure func state_with_point_record() -> CompilerTypecheckState:
	state = compiler_typecheck_state_empty()
	{ state |
		env = compiler_env_add_record(
			state.env,
			"Point",
			[],
			[
				field_decl("x", compiler_type_int()),
				field_decl("y", compiler_type_string()),
			],
			False,
			False,
		)
	}


pure func state_with_point_binding() -> CompilerTypecheckState:
	state = state_with_point_record()
	{ state |
		env = compiler_env_add_var_with_details(
			state.env,
			"point",
			CompilerNamedType("Point", []),
			Some(CompilerNamedType("Point", [])),
			CompilerImmutableBinding,
			CompilerLetBinding,
			compiler_unrefined_binding(),
		)
	}


func test_int_literal_expected_argument_slot_preserves_semantic_type() -> Bool:
	ctx = compiler_infer_with_expected_value_slot(
		compiler_infer_context(compiler_typecheck_state_empty()),
		compiler_type_int(),
		CompilerExpectedArgumentSlot,
	)
	result = compiler_infer_expr(ctx, int_expr("1"))
	typed = result.expr

	(
		compiler_types_equal(compiler_typed_expr_semantic_type(typed), CompilerConstIntType(1))
		and compiler_types_equal(compiler_typed_expr_value_type(typed), compiler_type_int())
		and match compiler_typed_expr_widening(typed):
			CompilerTypeWiden(from_type, to_type, reason):
				(
					compiler_types_equal(from_type, CompilerConstIntType(1))
					and compiler_types_equal(to_type, compiler_type_int())
					and compiler_widening_reasons_equal(reason, CompilerArgumentSlot)
				)
			CompilerTypeKeep(_):
				False
	)


func test_identifier_lookup_preserves_source_type() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(state_with_int_binding("value")),
		ParsedNameExpr(ident("value")),
	)
	typed = result.expr

	(
		result.context.state.errors.length() == 0
		and optional_types_equal(compiler_typed_expr_source_type(typed), Some(compiler_type_int()))
		and compiler_types_equal(compiler_typed_expr_semantic_type(typed), compiler_type_int())
		and compiler_types_equal(compiler_typed_expr_value_type(typed), compiler_type_int())
	)


func test_unknown_identifier_records_error() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedNameExpr(ident("missing")),
	)

	(
		result.context.state.errors.length() == 1
		and result.context.state.errors.get_or(0, "").contains("Unbound value `missing`")
	)


func test_var_decl_updates_environment_and_widens_mutable_initializer() -> Bool:
	decl_expr = ParsedVarDeclExpr(ident("x"), None, int_expr("1"), True, source_span())
	result = compiler_infer_expr(compiler_infer_context(compiler_typecheck_state_empty()), decl_expr)

	(
		optional_types_equal(
			compiler_env_get_var_type(result.context.state.env, "x"),
			Some(CompilerConstIntType(1)),
		)
		and compiler_types_equal(compiler_typed_expr_semantic_type(result.expr), CompilerNamedType("Void", []))
		and match compiler_typed_expr_var_initializer_widening(result.expr):
			CompilerTypeWiden(from_type, to_type, reason):
				(
					compiler_types_equal(from_type, CompilerConstIntType(1))
					and compiler_types_equal(to_type, compiler_type_int())
					and compiler_widening_reasons_equal(reason, CompilerMutableBinding)
				)
			CompilerTypeKeep(_):
				False
	)


func test_block_scopes_local_bindings_and_uses_last_expression_type() -> Bool:
	block = ParsedBlockExpr(
		[
			ParsedVarDeclExpr(ident("x"), None, int_expr("1"), False, source_span()),
			ParsedNameExpr(ident("x")),
		],
		source_span(),
	)
	result = compiler_infer_expr(compiler_infer_context(compiler_typecheck_state_empty()), block)

	(
		result.context.state.errors.length() == 0
		and compiler_types_equal(compiler_typed_expr_semantic_type(result.expr), CompilerConstIntType(1))
		and compiler_env_get_var_type(result.context.state.env, "x") == None
	)


func test_ascription_records_source_type_and_rejects_mismatch() -> Bool:
	ok_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedAscriptionExpr(int_expr("1"), named_type("Int"), source_span()),
	)
	error_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedAscriptionExpr(string_expr("x"), named_type("Int"), source_span()),
	)

	(
		ok_result.context.state.errors.length() == 0
		and optional_types_equal(
			compiler_typed_expr_source_type(ok_result.expr),
			Some(compiler_type_int()),
		)
		and compiler_types_equal(compiler_typed_expr_semantic_type(ok_result.expr), compiler_type_int())
		and match compiler_typed_expr_origin(ok_result.expr):
			CompilerExplicitAnnotationOrigin(source_type):
				compiler_types_equal(source_type, compiler_type_int())
			_:
				False
		and error_result.context.state.errors.length() == 1
		and error_result.context.state.errors
			.get_or(0, "")
			.contains("Ascribed type `Int` does not match value type `String`")
	)


func test_arithmetic_widens_literal_operands() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		binary_expr(ParsedAddOp, int_expr("1"), int_expr("2")),
	)

	(
		result.context.state.errors.length() == 0
		and compiler_types_equal(compiler_typed_expr_semantic_type(result.expr), compiler_type_int())
		and match compiler_typed_expr_binary_left_widening(result.expr):
			CompilerTypeWiden(from_type, to_type, reason):
				(
					compiler_types_equal(from_type, CompilerConstIntType(1))
					and compiler_types_equal(to_type, compiler_type_int())
					and compiler_widening_reasons_equal(
						reason,
						CompilerNumericOperator(ParsedAddOp),
					)
				)
			CompilerTypeKeep(_):
				False
		and match compiler_typed_expr_binary_right_widening(result.expr):
			CompilerTypeWiden(from_type, to_type, reason):
				(
					compiler_types_equal(from_type, CompilerConstIntType(2))
					and compiler_types_equal(to_type, compiler_type_int())
					and compiler_widening_reasons_equal(
						reason,
						CompilerNumericOperator(ParsedAddOp),
					)
				)
			CompilerTypeKeep(_):
				False
	)


func test_modulo_refines_non_negative_literal_result() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		binary_expr(ParsedModuloOp, int_expr("5"), int_expr("3")),
	)

	(
		result.context.state.errors.length() == 0
		and compiler_types_equal(
			compiler_typed_expr_semantic_type(result.expr),
			CompilerRangeType(CompilerConstIntType(3)),
		)
	)


func test_string_addition_and_mismatch_error() -> Bool:
	ok_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		binary_expr(ParsedAddOp, string_expr("a"), string_expr("b")),
	)
	error_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		binary_expr(ParsedAddOp, string_expr("a"), int_expr("1")),
	)

	(
		ok_result.context.state.errors.length() == 0
		and compiler_types_equal(compiler_typed_expr_semantic_type(ok_result.expr), compiler_type_string())
		and error_result.context.state.errors.length() == 1
		and error_result.context.state.errors
			.get_or(0, "")
			.contains("Cannot apply + to String and Int")
	)


func test_comparison_and_equality_return_bool() -> Bool:
	less_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		binary_expr(ParsedLessOp, string_expr("a"), string_expr("b")),
	)
	equal_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		binary_expr(ParsedEqualOp, int_expr("1"), int_expr("2")),
	)

	(
		less_result.context.state.errors.length() == 0
		and compiler_types_equal(compiler_typed_expr_semantic_type(less_result.expr), compiler_type_bool())
		and equal_result.context.state.errors.length() == 0
		and compiler_types_equal(compiler_typed_expr_semantic_type(equal_result.expr), compiler_type_bool())
	)


func test_unary_and_logical_ops() -> Bool:
	neg_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedUnaryExpr(ParsedNegateOp, int_expr("1"), source_span()),
	)
	not_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedUnaryExpr(ParsedNotOp, bool_expr(True), source_span()),
	)
	logical_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedLogicalExpr(ParsedAndOp, bool_expr(True), bool_expr(False), source_span()),
	)
	error_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedLogicalExpr(ParsedAndOp, bool_expr(True), float_expr("1.0"), source_span()),
	)

	(
		neg_result.context.state.errors.length() == 0
		and compiler_types_equal(compiler_typed_expr_semantic_type(neg_result.expr), compiler_type_int())
		and not_result.context.state.errors.length() == 0
		and compiler_types_equal(compiler_typed_expr_semantic_type(not_result.expr), compiler_type_bool())
		and logical_result.context.state.errors.length() == 0
		and compiler_types_equal(compiler_typed_expr_semantic_type(logical_result.expr), compiler_type_bool())
		and error_result.context.state.errors.length() == 1
		and error_result.context.state.errors
			.get_or(0, "")
			.contains("Logical operation requires Bool operands, got Bool and Float")
	)


func test_direct_call_infers_return_type() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(state_with_add_one_func()),
		call_expr(ParsedNameExpr(ident("add_one")), [int_expr("1")]),
	)

	(
		result.context.state.errors.length() == 0
		and compiler_types_equal(compiler_typed_expr_semantic_type(result.expr), compiler_type_int())
	)


func test_direct_call_widens_argument() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(state_with_add_one_func()),
		call_expr(ParsedNameExpr(ident("add_one")), [int_expr("1")]),
	)

	(
		result.context.state.errors.length() == 0
		and match compiler_typed_expr_call_arg_widening(result.expr, 0):
			CompilerTypeWiden(from_type, to_type, reason):
				(
					compiler_types_equal(from_type, CompilerConstIntType(1))
					and compiler_types_equal(to_type, compiler_type_int())
					and compiler_widening_reasons_equal(reason, CompilerArgumentSlot)
				)
			CompilerTypeKeep(_):
				False
	)


func test_direct_call_records_resolved_metadata() -> Bool:
	state = state_with_add_one_func()
	result = compiler_infer_expr(
		compiler_infer_context(state),
		call_expr(ParsedNameExpr(ident("add_one")), [int_expr("1")]),
	)
	expected_callable_id = compiler_env_get_func_callable_id(state.env, "add_one")

	(
		result.context.state.errors.length() == 0
		and match compiler_typed_expr_resolved_call(result.expr):
			Some(info):
				(
					info.callee_name == "add_one"
					and match (info.callable_id, expected_callable_id):
						(Some(callable_id), Some(expected)):
							callable_id == expected
						_:
							False
					and match info.purity:
						CompilerPure:
							True
						_:
							False
				)
			None:
				False
	)


func test_direct_call_errors_are_specific() -> Bool:
	arity_result = compiler_infer_expr(
		compiler_infer_context(state_with_add_one_func()),
		call_expr(ParsedNameExpr(ident("add_one")), []),
	)
	mismatch_result = compiler_infer_expr(
		compiler_infer_context(state_with_add_one_func()),
		call_expr(ParsedNameExpr(ident("add_one")), [string_expr("x")]),
	)
	non_function_result = compiler_infer_expr(
		compiler_infer_context(state_with_int_binding("value")),
		call_expr(ParsedNameExpr(ident("value")), []),
	)

	(
		arity_result.context.state.errors.length() == 1
		and arity_result.context.state.errors
			.get_or(0, "")
			.contains("Function 'add_one' expects 1 argument, got 0")
		and mismatch_result.context.state.errors.length() == 1
		and mismatch_result.context.state.errors
			.get_or(0, "")
			.contains("Argument type mismatch: in call to 'add_one', argument 1 expected Int, got String")
		and non_function_result.context.state.errors.length() == 1
		and non_function_result.context.state.errors
			.get_or(0, "")
			.contains("Cannot call non-function type: Int")
	)


func test_tuple_literal_infers_element_types() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		tuple_expr([int_expr("1"), string_expr("x")]),
	)

	(
		result.context.state.errors.length() == 0
		and compiler_types_equal(
			compiler_typed_expr_semantic_type(result.expr),
			CompilerTupleType([CompilerConstIntType(1), compiler_type_string()]),
		)
	)


func test_list_literal_infers_element_type_and_widening() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		list_expr([int_expr("1"), int_expr("2")]),
	)

	(
		result.context.state.errors.length() == 0
		and compiler_types_equal(
			compiler_typed_expr_semantic_type(result.expr),
			compiler_type_list(compiler_type_int()),
		)
		and match compiler_typed_expr_list_item_widening(result.expr, 0):
			CompilerTypeWiden(from_type, to_type, reason):
				(
					compiler_types_equal(from_type, CompilerConstIntType(1))
					and compiler_types_equal(to_type, compiler_type_int())
					and compiler_widening_reasons_equal(
						reason,
						CompilerCollectionElement(CompilerListLiteral),
					)
				)
			CompilerTypeKeep(_):
				False
	)


func test_empty_list_uses_expected_type() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_with_expected(
			compiler_infer_context(compiler_typecheck_state_empty()),
			compiler_type_list(compiler_type_string()),
		),
		list_expr([]),
	)

	(
		result.context.state.errors.length() == 0
		and compiler_types_equal(
			compiler_typed_expr_semantic_type(result.expr),
			compiler_type_list(compiler_type_string()),
		)
	)


func test_empty_list_without_expected_type_errors() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		list_expr([]),
	)

	(
		result.context.state.errors.length() == 1
		and result.context.state.errors
			.get_or(0, "")
			.contains("Cannot infer element type for empty list literal")
	)


func test_list_literal_mismatch_error_is_specific() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		list_expr([int_expr("1"), string_expr("x")]),
	)

	(
		result.context.state.errors.length() == 1
		and result.context.state.errors
			.get_or(0, "")
			.contains("List element 2 expected Int, got String")
	)


func test_dict_literal_infers_key_value_types_and_widening() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		dict_expr([
			dict_entry(int_expr("1"), string_expr("one")),
			dict_entry(int_expr("2"), string_expr("two")),
		]),
	)

	(
		result.context.state.errors.length() == 0
		and compiler_types_equal(
			compiler_typed_expr_semantic_type(result.expr),
			CompilerNamedType("Dict", [compiler_type_int(), compiler_type_string()]),
		)
		and match compiler_typed_expr_dict_key_widening(result.expr, 0):
			CompilerTypeWiden(from_type, to_type, reason):
				(
					compiler_types_equal(from_type, CompilerConstIntType(1))
					and compiler_types_equal(to_type, compiler_type_int())
					and compiler_widening_reasons_equal(
						reason,
						CompilerCollectionElement(CompilerDictLiteral),
					)
				)
			CompilerTypeKeep(_):
				False
		and match compiler_typed_expr_dict_value_widening(result.expr, 0):
			CompilerTypeKeep(value_type):
				compiler_types_equal(value_type, compiler_type_string())
			CompilerTypeWiden(_, _, _):
				False
	)


func test_empty_dict_uses_expected_type() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_with_expected(
			compiler_infer_context(compiler_typecheck_state_empty()),
			CompilerNamedType("Dict", [compiler_type_string(), compiler_type_int()]),
		),
		dict_expr([]),
	)

	(
		result.context.state.errors.length() == 0
		and compiler_types_equal(
			compiler_typed_expr_semantic_type(result.expr),
			CompilerNamedType("Dict", [compiler_type_string(), compiler_type_int()]),
		)
	)


func test_dict_literal_errors_are_specific() -> Bool:
	empty_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		dict_expr([]),
	)
	key_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		dict_expr([
			dict_entry(int_expr("1"), string_expr("one")),
			dict_entry(string_expr("two"), string_expr("two")),
		]),
	)
	value_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		dict_expr([
			dict_entry(int_expr("1"), string_expr("one")),
			dict_entry(int_expr("2"), int_expr("2")),
		]),
	)

	(
		empty_result.context.state.errors.length() == 1
		and empty_result.context.state.errors
			.get_or(0, "")
			.contains("Cannot infer type of empty dict literal")
		and key_result.context.state.errors.length() == 1
		and key_result.context.state.errors
			.get_or(0, "")
			.contains("Dict literal key 2 expected Int, got String")
		and value_result.context.state.errors.length() == 1
		and value_result.context.state.errors
			.get_or(0, "")
			.contains("Dict literal value 2 expected String, got Int")
	)


func test_record_literal_uses_expected_type_and_widens_fields() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_with_expected(
			compiler_infer_context(state_with_point_record()),
			CompilerNamedType("Point", []),
		),
		record_expr([
			record_field("x", int_expr("1")),
			record_field("y", string_expr("one")),
		]),
	)

	(
		result.context.state.errors.length() == 0
		and compiler_types_equal(
			compiler_typed_expr_semantic_type(result.expr),
			CompilerNamedType("Point", []),
		)
		and match compiler_typed_expr_record_field_widening(result.expr, "x"):
			CompilerTypeWiden(from_type, to_type, reason):
				(
					compiler_types_equal(from_type, CompilerConstIntType(1))
					and compiler_types_equal(to_type, compiler_type_int())
					and compiler_widening_reasons_equal(reason, CompilerArgumentSlot)
				)
			CompilerTypeKeep(_):
				False
	)


func test_record_literal_can_infer_unique_matching_record() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(state_with_point_record()),
		record_expr([
			record_field("x", int_expr("1")),
			record_field("y", string_expr("one")),
		]),
	)

	(
		result.context.state.errors.length() == 0
		and compiler_types_equal(
			compiler_typed_expr_semantic_type(result.expr),
			CompilerNamedType("Point", []),
		)
	)


func test_record_literal_errors_are_specific() -> Bool:
	missing_result = compiler_infer_expr(
		compiler_infer_with_expected(
			compiler_infer_context(state_with_point_record()),
			CompilerNamedType("Point", []),
		),
		record_expr([record_field("x", int_expr("1"))]),
	)
	unknown_result = compiler_infer_expr(
		compiler_infer_with_expected(
			compiler_infer_context(state_with_point_record()),
			CompilerNamedType("Point", []),
		),
		record_expr([
			record_field("x", int_expr("1")),
			record_field("z", string_expr("bad")),
		]),
	)
	empty_result = compiler_infer_expr(
		compiler_infer_context(state_with_point_record()),
		record_expr([]),
	)

	(
		missing_result.context.state.errors.length() == 1
		and missing_result.context.state.errors
			.get_or(0, "")
			.contains("Record literal is missing field(s): y")
		and unknown_result.context.state.errors.length() == 2
		and unknown_result.context.state.errors
			.get_or(0, "")
			.contains("Unknown field 'z' in record literal. Valid fields: x, y")
		and unknown_result.context.state.errors
			.get_or(1, "")
			.contains("Record literal is missing field(s): y")
		and empty_result.context.state.errors.length() == 1
		and empty_result.context.state.errors
			.get_or(0, "")
			.contains("Cannot infer record type without annotation")
	)


func test_record_literal_ambiguous_field_set_errors() -> Bool:
	state = state_with_point_record()
	ambiguous_state = { state |
		env = compiler_env_add_record(
			state.env,
			"OtherPoint",
			[],
			[
				field_decl("x", compiler_type_int()),
				field_decl("y", compiler_type_string()),
			],
			False,
			False,
		)
	}
	result = compiler_infer_expr(
		compiler_infer_context(ambiguous_state),
		record_expr([
			record_field("x", int_expr("1")),
			record_field("y", string_expr("one")),
		]),
	)

	(
		result.context.state.errors.length() == 1
		and result.context.state.errors
			.get_or(0, "")
			.contains("Ambiguous record literal")
	)


func test_field_access_for_records_and_tuples() -> Bool:
	record_result = compiler_infer_expr(
		compiler_infer_context(state_with_point_binding()),
		field_access_expr(ParsedNameExpr(ident("point")), "y"),
	)
	tuple_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		field_access_expr(tuple_expr([int_expr("1"), string_expr("two")]), "1"),
	)

	(
		record_result.context.state.errors.length() == 0
		and compiler_types_equal(
			compiler_typed_expr_semantic_type(record_result.expr),
			compiler_type_string(),
		)
		and optional_types_equal(
			compiler_typed_expr_field_access_receiver_type(record_result.expr),
			Some(CompilerNamedType("Point", [])),
		)
		and tuple_result.context.state.errors.length() == 0
		and compiler_types_equal(
			compiler_typed_expr_semantic_type(tuple_result.expr),
			compiler_type_string(),
		)
	)


func test_field_access_errors_are_specific() -> Bool:
	missing_field = compiler_infer_expr(
		compiler_infer_context(state_with_point_binding()),
		field_access_expr(ParsedNameExpr(ident("point")), "z"),
	)
	not_record = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		field_access_expr(int_expr("1"), "x"),
	)

	(
		missing_field.context.state.errors.length() == 1
		and missing_field.context.state.errors
			.get_or(0, "")
			.contains("Record Point has no field 'z'. Valid fields: x, y")
		and not_record.context.state.errors.length() == 1
		and not_record.context.state.errors
			.get_or(0, "")
			.contains("Cannot access field on type #1")
	)


func test_range_expr_requires_int_endpoints() -> Bool:
	ok_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		range_expr(int_expr("0"), int_expr("3")),
	)
	error_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		range_expr(string_expr("start"), string_expr("end")),
	)

	(
		ok_result.context.state.errors.length() == 0
		and compiler_types_equal(
			compiler_typed_expr_semantic_type(ok_result.expr),
			CompilerNamedType("Range", []),
		)
		and error_result.context.state.errors.length() == 2
		and error_result.context.state.errors
			.get_or(0, "")
			.contains("Range start must be Int, got String")
		and error_result.context.state.errors
			.get_or(1, "")
			.contains("Range end must be Int, got String")
	)


func test_if_with_else_infers_common_int_type() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedIfExpr(
			bool_expr(True),
			int_expr("1"),
			Some(int_expr("2")),
			source_span(),
		),
	)

	(
		result.context.state.errors.length() == 0
		and compiler_types_equal(compiler_typed_expr_semantic_type(result.expr), compiler_type_int())
	)


func test_if_without_else_requires_void_then_branch() -> Bool:
	ok_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedIfExpr(
			bool_expr(True),
			ParsedVoidExpr(source_span()),
			None,
			source_span(),
		),
	)
	error_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedIfExpr(
			bool_expr(True),
			int_expr("1"),
			None,
			source_span(),
		),
	)

	(
		ok_result.context.state.errors.length() == 0
		and compiler_types_equal(compiler_typed_expr_semantic_type(ok_result.expr), compiler_type_void())
		and error_result.context.state.errors.length() == 1
		and error_result.context.state.errors
			.get_or(0, "")
			.contains("if-expression without else cannot produce a value")
	)


func test_if_errors_for_condition_and_branch_mismatch() -> Bool:
	condition_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedIfExpr(
			string_expr("x"),
			int_expr("1"),
			Some(int_expr("2")),
			source_span(),
		),
	)
	branch_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedIfExpr(
			bool_expr(True),
			int_expr("1"),
			Some(string_expr("x")),
			source_span(),
		),
	)

	(
		condition_result.context.state.errors.length() == 1
		and condition_result.context.state.errors
			.get_or(0, "")
			.contains("If condition must be Bool, got String")
		and branch_result.context.state.errors.length() == 1
		and branch_result.context.state.errors
			.get_or(0, "")
			.contains("If-else type mismatch: then-branch returns")
	)


func test_while_break_and_continue_loop_context() -> Bool:
	break_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedBreakExpr(source_span()),
	)
	continue_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedContinueExpr(source_span()),
	)
	while_break_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedWhileExpr(bool_expr(True), ParsedBreakExpr(source_span()), source_span()),
	)
	while_continue_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedWhileExpr(bool_expr(True), ParsedContinueExpr(source_span()), source_span()),
	)

	(
		break_result.context.state.errors.length() == 1
		and break_result.context.state.errors
			.get_or(0, "")
			.contains("'break' can only be used inside a loop")
		and continue_result.context.state.errors.length() == 1
		and continue_result.context.state.errors
			.get_or(0, "")
			.contains("'continue' can only be used inside a loop")
		and while_break_result.context.state.errors.length() == 0
		and compiler_types_equal(compiler_typed_expr_semantic_type(while_break_result.expr), compiler_type_void())
		and while_continue_result.context.state.errors.length() == 0
		and compiler_types_equal(compiler_typed_expr_semantic_type(while_continue_result.expr), compiler_type_void())
	)


func test_while_condition_must_be_bool() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedWhileExpr(string_expr("x"), ParsedVoidExpr(source_span()), source_span()),
	)

	(
		result.context.state.errors.length() == 1
		and result.context.state.errors
			.get_or(0, "")
			.contains("While condition must be Bool, got String")
	)


func test_for_range_binder_is_scoped_to_body() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		for_name_expr(
			"i",
			range_expr(int_expr("0"), int_expr("3")),
			ParsedNameExpr(ident("i")),
		),
	)

	(
		result.context.state.errors.length() == 0
		and compiler_types_equal(compiler_typed_expr_semantic_type(result.expr), compiler_type_void())
		and compiler_env_get_var_type(result.context.state.env, "i") == None
	)


func test_for_list_binder_allows_loop_control() -> Bool:
	result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		for_name_expr(
			"item",
			list_expr([int_expr("1"), int_expr("2")]),
			ParsedBlockExpr(
				[
					ParsedNameExpr(ident("item")),
					ParsedContinueExpr(source_span()),
				],
				source_span(),
			),
		),
	)

	(
		result.context.state.errors.length() == 0
		and compiler_types_equal(compiler_typed_expr_semantic_type(result.expr), compiler_type_void())
		and compiler_env_get_var_type(result.context.state.env, "item") == None
	)


func test_for_invalid_iterable_and_tuple_binder_errors() -> Bool:
	invalid_iterable = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		for_name_expr("x", int_expr("1"), ParsedVoidExpr(source_span())),
	)
	tuple_binder = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedForExpr(
			ParsedForTupleBinder([ident("a"), ident("b")], source_span()),
			list_expr([tuple_expr([int_expr("1"), int_expr("2")])]),
			ParsedVoidExpr(source_span()),
			source_span(),
		),
	)

	(
		invalid_iterable.context.state.errors.length() == 1
		and invalid_iterable.context.state.errors
			.get_or(0, "")
			.contains("Cannot iterate over type")
		and tuple_binder.context.state.errors.length() == 1
		and tuple_binder.context.state.errors
			.get_or(0, "")
			.contains("Tuple for-loop binders are not yet supported by Blorp inference")
	)


func test_for_rejects_same_scope_redeclaration() -> Bool:
	block = ParsedBlockExpr(
		[
			ParsedVarDeclExpr(ident("i"), None, int_expr("0"), False, source_span()),
			for_name_expr("i", range_expr(int_expr("0"), int_expr("3")), ParsedVoidExpr(source_span())),
		],
		source_span(),
	)
	result = compiler_infer_expr(compiler_infer_context(compiler_typecheck_state_empty()), block)

	(
		result.context.state.errors.length() == 1
		and result.context.state.errors
			.get_or(0, "")
			.contains("Cannot redeclare `i` in for loop")
	)


tests: TestSuite = {
	description = "Compiler inference",
	tests = [
		(
			"int literal expected argument slot preserves semantic type",
			test_int_literal_expected_argument_slot_preserves_semantic_type,
		),
		("identifier lookup preserves source type", test_identifier_lookup_preserves_source_type),
		("unknown identifier records error", test_unknown_identifier_records_error),
		(
			"var decl updates environment and widens mutable initializer",
			test_var_decl_updates_environment_and_widens_mutable_initializer,
		),
		(
			"block scopes local bindings and uses last expression type",
			test_block_scopes_local_bindings_and_uses_last_expression_type,
		),
		("ascription records source type and rejects mismatch", test_ascription_records_source_type_and_rejects_mismatch),
		("arithmetic widens literal operands", test_arithmetic_widens_literal_operands),
		("modulo refines non-negative literal result", test_modulo_refines_non_negative_literal_result),
		("string addition and mismatch error", test_string_addition_and_mismatch_error),
		("comparison and equality return bool", test_comparison_and_equality_return_bool),
		("unary and logical ops", test_unary_and_logical_ops),
		("direct call infers return type", test_direct_call_infers_return_type),
		("direct call widens argument", test_direct_call_widens_argument),
		("direct call records resolved metadata", test_direct_call_records_resolved_metadata),
		("direct call errors are specific", test_direct_call_errors_are_specific),
		("tuple literal infers element types", test_tuple_literal_infers_element_types),
		("list literal infers element type and widening", test_list_literal_infers_element_type_and_widening),
		("empty list uses expected type", test_empty_list_uses_expected_type),
		("empty list without expected type errors", test_empty_list_without_expected_type_errors),
		("list literal mismatch error is specific", test_list_literal_mismatch_error_is_specific),
		("dict literal infers key value types and widening", test_dict_literal_infers_key_value_types_and_widening),
		("empty dict uses expected type", test_empty_dict_uses_expected_type),
		("dict literal errors are specific", test_dict_literal_errors_are_specific),
		("record literal uses expected type and widens fields", test_record_literal_uses_expected_type_and_widens_fields),
		("record literal can infer unique matching record", test_record_literal_can_infer_unique_matching_record),
		("record literal errors are specific", test_record_literal_errors_are_specific),
		("record literal ambiguous field set errors", test_record_literal_ambiguous_field_set_errors),
		("field access for records and tuples", test_field_access_for_records_and_tuples),
		("field access errors are specific", test_field_access_errors_are_specific),
		("range expr requires int endpoints", test_range_expr_requires_int_endpoints),
		("if with else infers common int type", test_if_with_else_infers_common_int_type),
		("if without else requires void then branch", test_if_without_else_requires_void_then_branch),
		("if errors for condition and branch mismatch", test_if_errors_for_condition_and_branch_mismatch),
		("while break and continue loop context", test_while_break_and_continue_loop_context),
		("while condition must be bool", test_while_condition_must_be_bool),
		("for range binder is scoped to body", test_for_range_binder_is_scoped_to_body),
		("for list binder allows loop control", test_for_list_binder_allows_loop_control),
		("for invalid iterable and tuple binder errors", test_for_invalid_iterable_and_tuple_binder_errors),
		("for rejects same scope redeclaration", test_for_rejects_same_scope_redeclaration),
	]
}
