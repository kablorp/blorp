func test_assignment_errors_are_specific() -> Bool:
	immutable_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedBlockExpr(
			[
				assign_expr("x", int_expr("1")),
				assign_expr("x", int_expr("2")),
			],
			source_span(),
		),
	)
	mismatch_result = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedBlockExpr(
			[
				ParsedVarDeclExpr(ident("m"), Some(named_type("Int")), int_expr("1"), True, source_span()),
				assign_expr("m", string_expr("bad")),
			],
			source_span(),
		),
	)
	function_result = compiler_infer_expr(
		compiler_infer_context(state_with_add_one_func()),
		assign_expr("add_one", int_expr("1")),
	)

	(
		immutable_result.context.state.errors.length() == 1
		and immutable_result.context.state.errors
			.get_or(0, "")
			.contains("Cannot assign to immutable variable 'x'")
		and mismatch_result.context.state.errors.length() == 1
		and mismatch_result.context.state.errors
			.get_or(0, "")
			.contains("Cannot assign to variable 'm'")
		and function_result.context.state.errors.length() == 1
		and function_result.context.state.errors
			.get_or(0, "")
			.contains("Cannot assign to function 'add_one'")
	)


