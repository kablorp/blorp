		and oob_result.context.state.errors
			.get_or(0, "")
			.contains("Index 1 out of bounds for dimension of size 1")
		and runtime_result.context.state.errors.length() == 1
		and runtime_result.context.state.errors
			.get_or(0, "")
			.contains("Subscript index must be a compile-time integer literal")
	)


