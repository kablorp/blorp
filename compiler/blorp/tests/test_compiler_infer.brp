					ParsedConstructorPattern(
						ident("Some"),
						[ParsedNamePattern(ident("value"))],
						source_span(),
					),
					ParsedNameExpr(ident("value")),
				), match_case(ParsedNamePattern(ident("None")), int_expr("0"))],
			source_span(),
