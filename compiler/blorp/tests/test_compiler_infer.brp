			with_binding("reader", None, int_expr("1"), ParsedWithPlainBinding, None),
			ParsedVoidExpr(source_span()),
			source_span(),
		),
	)
	annotation_result = compiler_infer_expr(
		compiler_infer_context(state_with_resource_values()),
		ParsedWithExpr(
			with_binding(
				"reader",
				Some(named_type("Int")),
				ParsedNameExpr(ident("reader_source")),
				ParsedWithPlainBinding,
				None,
			),
			ParsedVoidExpr(source_span()),
			source_span(),
		),
	)
	escape_result = compiler_infer_expr(
		compiler_infer_context(state_with_resource_values()),
		ParsedWithExpr(
			with_binding(
				"reader",
				None,
				ParsedNameExpr(ident("reader_source")),
				ParsedWithPlainBinding,
				None,
			),
			ParsedNameExpr(ident("reader")),
			source_span(),
		),
	)

	(
