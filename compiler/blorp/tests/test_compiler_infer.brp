func test_for_invalid_iterable_and_tuple_binder_errors() -> Bool:
	invalid_iterable = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		for_name_expr("x", int_expr("1"), ParsedVoidExpr(source_span())),
	)
	tuple_non_tuple_element = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedForExpr(
			ParsedForTupleBinder(
				[ident("a"), ident("b")],
				source_span(),
			),
			list_expr([int_expr("1")]),
			ParsedVoidExpr(source_span()),
			source_span(),
		),
	)
	tuple_arity = compiler_infer_expr(
		compiler_infer_context(compiler_typecheck_state_empty()),
		ParsedForExpr(
			ParsedForTupleBinder([ident("a")], source_span()),
			list_expr([tuple_expr([int_expr("1"), int_expr("2")])]),
			ParsedVoidExpr(source_span()),
			source_span(),
		),
	)

	invalid_iterable.context.state.errors.length() == 1 and invalid_iterable.context.state.errors
		.get_or(0, "")
		.contains(
			"Cannot iterate over type",
		) and tuple_non_tuple_element.context.state.errors.length() == 1 and tuple_non_tuple_element.context.state.errors
		.get_or(0, "")
		.contains(
			"Tuple for-loop requires iterable elements to be tuples",
		) and tuple_arity.context.state.errors.length() == 1 and tuple_arity.context.state.errors
		.get_or(0, "")
		.contains("Tuple for-loop arity mismatch")


func test_for_rejects_same_scope_redeclaration() -> Bool:
	block = ParsedBlockExpr(
		[ParsedVarDeclExpr(ident("i"), None, int_expr("0"), False, source_span()), for_name_expr(
				"i",
				range_expr(int_expr("0"), int_expr("3")),
				ParsedVoidExpr(source_span()),
			)],
		source_span(),
	)
	result = compiler_infer_expr(compiler_infer_context(compiler_typecheck_state_empty()), block)

	result.context.state.errors.length() == 1 and result.context.state.errors
		.get_or(0, "")
		.contains("Cannot redeclare `i` in for loop")


tests: TestSuite = {
	description = "Compiler inference",
	tests = [
		(
			"int literal expected argument slot preserves semantic type",
			test_int_literal_expected_argument_slot_preserves_semantic_type,
		),
		("identifier lookup preserves source type", test_identifier_lookup_preserves_source_type),
		("unknown identifier records error", test_unknown_identifier_records_error),
		(
			"var decl updates environment and widens mutable initializer",
			test_var_decl_updates_environment_and_widens_mutable_initializer,
		),
		(
			"annotated var decl widens literal initializer",
			test_annotated_var_decl_widens_literal_initializer,
		),
		(
			"block scopes local bindings and uses last expression type",
			test_block_scopes_local_bindings_and_uses_last_expression_type,
		),
		(
			"block preserves last expression value type",
			test_block_preserves_last_expression_value_type,
		),
