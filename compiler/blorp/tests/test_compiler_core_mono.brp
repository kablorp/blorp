import:
	../src/stage_09_core/compiler_core_json:
		CoreDimOp(DimAdd, DimDivide, DimMultiply, DimSubtract),
		CoreTensorDim(TensorDimOperation, TensorRuntimeDim, TensorStaticDim, TensorVariadicDim),
		CoreType(
			FunctionType,
			NamedType,
			RangeType,
			SelfType,
			TensorType,
			TupleType,
			TypeParameterType,
		),
	../src/stage_09_core/compiler_core_mono:
		CoreMonoSubstitution,
		CoreMonoSubstitutionValue(DimPackSubstitution, DimSubstitution, TypeSubstitution),
		apply_type_substitution,
		collect_type_substitution,
		core_mono_substitution_value_equal,
		core_mono_type_equal,
		is_concrete_substitution,
		mangle_specialization_name,
		substitution_closes_parameters,
	test: TestSuite


pure func named_type(name: String) -> CoreType:
	NamedType(name, [])


pure func type_parameter(name: String) -> CoreType:
	TypeParameterType(name)


pure func tensor_type(element_type: CoreType, dims: List[CoreTensorDim]) -> CoreType:
	TensorType({
		element_type = element_type,
		dims = dims,
	})


pure func substitution_value(
	substitution: CoreMonoSubstitution,
	name: String,
) -> Option[CoreMonoSubstitutionValue]:
	var found: Option[CoreMonoSubstitutionValue] = None

	for (binding_name, value) in substitution:
		if binding_name == name:
			found = Some(value)
			break

	found


pure func substitution_has_value(
	substitution: CoreMonoSubstitution,
	name: String,
	expected: CoreMonoSubstitutionValue,
) -> Bool:
	match substitution_value(substitution, name):
		Some(actual):
			core_mono_substitution_value_equal(actual, expected)
		None:
			False


func test_collects_simple_type_parameter() -> Bool:
	match collect_type_substitution(["T"], [], type_parameter("T"), named_type("Int"), []):
		Some(substitution):
			substitution_has_value(substitution, "T", TypeSubstitution(named_type("Int")))
		None:
			False


func test_collects_nested_type_parameter() -> Bool:
	match collect_type_substitution(
		["T"],
		[],
		NamedType("List", [type_parameter("T")]),
		NamedType("List", [named_type("String")]),
		[],
	):
		Some(substitution):
			substitution_has_value(substitution, "T", TypeSubstitution(named_type("String")))
		None:
			False


func test_rejects_conflicting_repeated_parameter() -> Bool:
	match collect_type_substitution(["T"], [], type_parameter("T"), named_type("Int"), []):
		Some(first):
			match collect_type_substitution(
				["T"],
				[],
				type_parameter("T"),
				named_type("String"),
				first,
			):
				Some(_):
					False
				None:
					True
		None:
			False


func test_repeated_parameter_accepts_same_type() -> Bool:
	match collect_type_substitution(["T"], [], type_parameter("T"), named_type("Int"), []):
		Some(first):
			match collect_type_substitution(
				["T"],
				[],
				type_parameter("T"),
				named_type("Int"),
				first,
			):
				Some(second):
					second.length() == 1
				None:
					False
		None:
			False


func test_identity_evidence_does_not_conflict_with_concrete_evidence() -> Bool:
	match collect_type_substitution(["T"], [], type_parameter("T"), type_parameter("T"), []):
		Some(identity):
			match collect_type_substitution(
				["T"],
				[],
				type_parameter("T"),
				named_type("String"),
				identity,
			):
				Some(concrete):
					substitution_has_value(concrete, "T", TypeSubstitution(named_type("String")))
				None:
					False
		None:
			False


func test_unresolved_outer_evidence_keeps_substitution_open() -> Bool:
	match collect_type_substitution(["T"], ["Outer"], type_parameter("T"), named_type("Int"), []):
		Some(concrete):
			match collect_type_substitution(
				["T"],
				["Outer"],
				type_parameter("T"),
				type_parameter("Outer"),
				concrete,
			):
				Some(open):
					(
						substitution_has_value(open, "T", TypeSubstitution(type_parameter("Outer")))
						and not is_concrete_substitution(["Outer"], open)
					)
				None:
					False
		None:
			False


func test_same_named_outer_type_evidence_stays_open_in_both_orders() -> Bool:
	param_type = type_parameter("T")
	concrete_type = named_type("Int")

	identity_then_concrete: Bool = match collect_type_substitution(
		["T"],
		["T"],
		param_type,
		param_type,
		[],
	):
		Some(identity):
			match collect_type_substitution(["T"], ["T"], param_type, concrete_type, identity):
				Some(open):
					(
						substitution_has_value(open, "T", TypeSubstitution(param_type))
						and not is_concrete_substitution(["T"], open)
					)
				None:
					False
		None:
			False

	concrete_then_identity: Bool = match collect_type_substitution(
		["T"],
		["T"],
		param_type,
		concrete_type,
		[],
	):
		Some(concrete):
			match collect_type_substitution(["T"], ["T"], param_type, param_type, concrete):
				Some(open):
					(
						substitution_has_value(open, "T", TypeSubstitution(param_type))
						and not is_concrete_substitution(["T"], open)
					)
				None:
					False
		None:
			False

	identity_then_concrete and concrete_then_identity


func test_nominal_type_name_is_not_a_type_parameter() -> Bool:
	match collect_type_substitution(["T"], [], named_type("T"), named_type("Int"), []):
		Some(substitution):
			substitution.is_empty()
		None:
			False


func test_collects_and_applies_self_type() -> Bool:
	match collect_type_substitution(["Self"], [], SelfType, named_type("Int"), []):
		Some(substitution):
			core_mono_type_equal(
				apply_type_substitution(
					substitution,
					FunctionType(True, [SelfType], SelfType),
				),
				FunctionType(True, [named_type("Int")], named_type("Int")),
			)
		None:
			False


func test_dimension_parameter_ignores_value_type_evidence() -> Bool:
	match collect_type_substitution(["#N"], [], type_parameter("#N"), named_type("Int"), []):
		Some(substitution):
			substitution.is_empty()
		None:
			False


func test_same_named_outer_dimension_evidence_stays_open_in_both_orders() -> Bool:
	param_type = tensor_type(named_type("Int"), [TensorRuntimeDim("#N")])
	concrete_type = tensor_type(named_type("Int"), [TensorStaticDim(4)])

	identity_then_concrete: Bool = match collect_type_substitution(
		["#N"],
		["#N"],
		param_type,
		param_type,
		[],
	):
		Some(identity):
			match collect_type_substitution(["#N"], ["#N"], param_type, concrete_type, identity):
				Some(open):
					(
						substitution_has_value(open, "#N", DimSubstitution(TensorRuntimeDim("#N")))
						and not is_concrete_substitution(["#N"], open)
					)
				None:
					False
		None:
			False

	concrete_then_identity: Bool = match collect_type_substitution(
		["#N"],
		["#N"],
		param_type,
		concrete_type,
		[],
	):
		Some(concrete):
			match collect_type_substitution(["#N"], ["#N"], param_type, param_type, concrete):
				Some(open):
					(
						substitution_has_value(open, "#N", DimSubstitution(TensorRuntimeDim("#N")))
						and not is_concrete_substitution(["#N"], open)
					)
				None:
					False
		None:
			False

	identity_then_concrete and concrete_then_identity


func test_dimension_identity_does_not_conflict_with_concrete_evidence() -> Bool:
	param_type = tensor_type(named_type("Int"), [TensorRuntimeDim("#N")])

	match collect_type_substitution(["#N"], [], param_type, param_type, []):
		Some(identity):
			match collect_type_substitution(
				["#N"],
				[],
				param_type,
				tensor_type(named_type("Int"), [TensorStaticDim(4)]),
				identity,
			):
				Some(concrete):
					substitution_has_value(concrete, "#N", DimSubstitution(TensorStaticDim(4)))
				None:
					False
		None:
			False


func test_equivalent_dimension_evidence_is_normalized() -> Bool:
	param_type = tensor_type(named_type("Int"), [TensorRuntimeDim("#N")])
	first_arg = tensor_type(
		named_type("Int"),
		[TensorDimOperation(DimAdd, TensorStaticDim(2), TensorStaticDim(2))],
	)
	second_arg = tensor_type(named_type("Int"), [TensorStaticDim(4)])

	match collect_type_substitution(["#N"], [], param_type, first_arg, []):
		Some(first):
			match collect_type_substitution(["#N"], [], param_type, second_arg, first):
				Some(second):
					substitution_has_value(second, "#N", DimSubstitution(TensorStaticDim(4)))
				None:
					False
		None:
			False


func test_nested_dimension_constants_are_normalized() -> Bool:
	param_type = tensor_type(named_type("Int"), [TensorRuntimeDim("#N")])
	outer_dim = TensorRuntimeDim("#Outer")
	first_arg = tensor_type(named_type("Int"), [TensorDimOperation(
				DimSubtract,
				TensorDimOperation(DimAdd, outer_dim, TensorStaticDim(2)),
				TensorStaticDim(2),
			)])
	second_arg = tensor_type(named_type("Int"), [outer_dim])

	match collect_type_substitution(["#N"], ["#Outer"], param_type, first_arg, []):
		Some(first):
			match collect_type_substitution(["#N"], ["#Outer"], param_type, second_arg, first):
				Some(second):
					substitution_has_value(second, "#N", DimSubstitution(outer_dim))
				None:
					False
		None:
			False


func test_value_substitution_erases_range_refinement() -> Bool:
	match collect_type_substitution(["T"], [], type_parameter("T"), RangeType, []):
		Some(substitution):
			substitution_has_value(substitution, "T", TypeSubstitution(named_type("Int")))
		None:
			False


func test_same_named_outer_dimension_pack_stays_open_in_both_orders() -> Bool:
	param_type = tensor_type(named_type("Int"), [TensorVariadicDim("#Ds")])
	concrete_type = tensor_type(
		named_type("Int"),
		[TensorStaticDim(2), TensorStaticDim(3)],
	)

	identity_then_concrete: Bool = match collect_type_substitution(
		[],
		["#Ds"],
		param_type,
		param_type,
		[],
	):
		Some(identity):
			match collect_type_substitution([], ["#Ds"], param_type, concrete_type, identity):
				Some(open):
					(
						substitution_has_value(
							open,
							"#Ds",
							DimPackSubstitution([TensorVariadicDim("#Ds")]),
						)
						and not is_concrete_substitution(["#Ds"], open)
					)
				None:
					False
		None:
			False

	concrete_then_identity: Bool = match collect_type_substitution(
		[],
		["#Ds"],
		param_type,
		concrete_type,
		[],
	):
		Some(concrete):
			match collect_type_substitution([], ["#Ds"], param_type, param_type, concrete):
				Some(open):
					(
						substitution_has_value(
							open,
							"#Ds",
							DimPackSubstitution([TensorVariadicDim("#Ds")]),
						)
						and not is_concrete_substitution(["#Ds"], open)
					)
				None:
					False
		None:
			False

	identity_then_concrete and concrete_then_identity


func test_collects_variadic_tensor_dimensions() -> Bool:
	param_type = tensor_type(
		type_parameter("T"),
		[TensorRuntimeDim("#N"), TensorVariadicDim("#Ds")],
	)
	arg_type = tensor_type(
		named_type("Float"),
		[TensorStaticDim(2), TensorStaticDim(3), TensorStaticDim(4)],
	)

	match (
		collect_type_substitution(
			["T", "#N", "#Ds"],
			[],
			param_type,
			arg_type,
			[],
		)
	):
		Some(substitution):
			type_ok: Bool = substitution_has_value(
				substitution,
				"T",
				TypeSubstitution(named_type("Float")),
			)
			first_dim_ok: Bool = substitution_has_value(
				substitution,
				"#N",
				DimSubstitution(TensorStaticDim(2)),
			)
			dim_pack_ok: Bool = substitution_has_value(
				substitution,
				"#Ds",
				DimPackSubstitution([TensorStaticDim(3), TensorStaticDim(4)]),
			)

			if not type_ok:
				print("missing T substitution")

			if not first_dim_ok:
				print("missing #N substitution")

			if not dim_pack_ok:
				print("missing #Ds substitution")

			type_ok and first_dim_ok and dim_pack_ok
		None:
			False


func test_collects_implicit_trailing_dimension_pack() -> Bool:
	param_type = tensor_type(
		named_type("Int"),
		[TensorRuntimeDim("#N"), TensorVariadicDim("#Ds")],
	)
	arg_type = tensor_type(
		named_type("Int"),
		[TensorStaticDim(2), TensorStaticDim(3)],
	)

	match collect_type_substitution(["#N"], [], param_type, arg_type, []):
		Some(substitution):
			(
				substitution_has_value(substitution, "#N", DimSubstitution(TensorStaticDim(2)))
				and substitution_has_value(
					substitution,
					"#Ds",
					DimPackSubstitution([TensorStaticDim(3)]),
				)
				and core_mono_type_equal(
					apply_type_substitution(substitution, param_type),
					arg_type,
				)
			)
		None:
			False


func test_applies_nested_type_and_dimension_substitution() -> Bool:
	substitution: CoreMonoSubstitution = [
		("T", TypeSubstitution(named_type("Float"))),
		("#N", DimSubstitution(TensorStaticDim(8))),
		("#Ds", DimPackSubstitution([TensorStaticDim(3), TensorStaticDim(4)])),
	]
	source = TupleType([
		NamedType("List", [type_parameter("T")]),
		tensor_type(
			type_parameter("T"),
			[TensorRuntimeDim("#N"), TensorVariadicDim("#Ds")],
		),
	])

	core_mono_type_equal(
		apply_type_substitution(
			substitution,
			source,
		),
		TupleType([
			NamedType("List", [named_type("Float")]),
			tensor_type(
				named_type("Float"),
				[TensorStaticDim(8), TensorStaticDim(3), TensorStaticDim(4)],
			),
		]),
	)


func test_dimension_substitution_erases_value_parameter_to_int() -> Bool:
	substitution: CoreMonoSubstitution = [("#N", DimSubstitution(TensorStaticDim(8)))]

	core_mono_type_equal(
		apply_type_substitution(substitution, type_parameter("#N")),
		named_type("Int"),
	)


func test_dimension_pack_application_resolves_nested_scalar_dimensions() -> Bool:
	substitution: CoreMonoSubstitution = [
		("#Ds", DimPackSubstitution([TensorRuntimeDim("#N")])),
		("#N", DimSubstitution(TensorStaticDim(4))),
	]

	core_mono_type_equal(
		apply_type_substitution(
			substitution,
			tensor_type(named_type("Float"), [TensorVariadicDim("#Ds")]),
		),
		tensor_type(named_type("Float"), [TensorStaticDim(4)]),
	)


func test_dimension_pack_application_terminates_on_indirect_cycle() -> Bool:
	substitution: CoreMonoSubstitution = [
		("#As", DimPackSubstitution([TensorVariadicDim("#Bs")])),
		("#Bs", DimPackSubstitution([TensorVariadicDim("#As")])),
	]

	core_mono_type_equal(
		apply_type_substitution(
			substitution,
			tensor_type(named_type("Float"), [TensorVariadicDim("#As")]),
		),
		tensor_type(named_type("Float"), [TensorVariadicDim("#As")]),
	)


func test_applies_function_type_substitution() -> Bool:
	substitution: CoreMonoSubstitution = [("T", TypeSubstitution(named_type("String")))]

	core_mono_type_equal(
		apply_type_substitution(
			substitution,
			FunctionType(True, [NamedType("List", [type_parameter("T")])], type_parameter("T")),
		),
		FunctionType(True, [NamedType("List", [named_type("String")])], named_type("String")),
	)


func test_concrete_substitution_rejects_unresolved_types() -> Bool:
	(
		is_concrete_substitution(
			["T"],
			[("T", TypeSubstitution(NamedType("List", [named_type("Int")])))],
		)
		and not is_concrete_substitution(
			["T", "V"],
			[("T", TypeSubstitution(NamedType("List", [type_parameter("V")])))],
		)
		and not is_concrete_substitution(
			["#Ds", "#N"],
			[("#Ds", DimPackSubstitution([TensorRuntimeDim("#N")]))],
		)
	)


func test_specialization_requires_a_closed_signature() -> Bool:
	partial: CoreMonoSubstitution = [("U", TypeSubstitution(named_type("String")))]
	identity: CoreMonoSubstitution = [
		("T", TypeSubstitution(type_parameter("T"))),
		("U", TypeSubstitution(named_type("String"))),
	]
	closed: CoreMonoSubstitution = [
		("T", TypeSubstitution(named_type("Int"))),
		("U", TypeSubstitution(named_type("String"))),
	]
	closed_dimension: CoreMonoSubstitution = [("#N", DimSubstitution(TensorStaticDim(2)))]

	not substitution_closes_parameters(
		partial,
		["T", "U"],
	) and not substitution_closes_parameters(
		identity,
		["T", "U"],
	) and substitution_closes_parameters(
		closed,
		["T", "U"],
	) and substitution_closes_parameters(closed_dimension, ["#N"])


func test_mangle_is_sorted_and_encodes_shapes() -> Bool:
	substitution: CoreMonoSubstitution = [
		(
			"B",
			TypeSubstitution(
				tensor_type(
					named_type("Float"),
					[
						TensorStaticDim(2),
						TensorDimOperation(DimMultiply, TensorStaticDim(3), TensorStaticDim(4)),
					],
				),
			),
		),
		("A", TypeSubstitution(NamedType("List", [named_type("Int")]))),
	]
	reversed: CoreMonoSubstitution = [
		("A", TypeSubstitution(NamedType("List", [named_type("Int")]))),
		(
			"B",
			TypeSubstitution(
				tensor_type(
					named_type("Float"),
					[
						TensorStaticDim(2),
						TensorDimOperation(DimMultiply, TensorStaticDim(3), TensorStaticDim(4)),
					],
				),
			),
		),
	]
	changed_shape: CoreMonoSubstitution = [
		("A", TypeSubstitution(NamedType("List", [named_type("Int")]))),
		(
			"B",
			TypeSubstitution(
				tensor_type(
					named_type("Float"),
					[TensorStaticDim(2), TensorStaticDim(13)],
				),
			),
		),
	]
	name = mangle_specialization_name("pair", substitution)

	(
		name == mangle_specialization_name("pair", reversed)
		and name != mangle_specialization_name("pair", changed_shape)
		and name
			.get_or("")
			.starts_with("pair__mono_sig_")
	)


func test_mangle_distinguishes_scalar_and_variadic_dimensions() -> Bool:
	substitution: CoreMonoSubstitution = [
		("T", TypeSubstitution(named_type("Float"))),
		("#N", DimSubstitution(TensorStaticDim(2))),
		("#Ds", DimPackSubstitution([TensorStaticDim(3), TensorStaticDim(4)])),
	]
	changed: CoreMonoSubstitution = [
		("T", TypeSubstitution(named_type("Float"))),
		("#N", DimSubstitution(TensorStaticDim(3))),
		("#Ds", DimPackSubstitution([TensorStaticDim(2), TensorStaticDim(4)])),
	]
	name = mangle_specialization_name("shape", substitution)

	(
		name != mangle_specialization_name("shape", changed)
		and name
			.get_or("")
			.starts_with("shape__mono_sig_")
	)


func test_mangle_preserves_non_exact_dimension_division() -> Bool:
	substitution: CoreMonoSubstitution = [
		(
			"#N",
			DimSubstitution(
				TensorDimOperation(
					DimDivide,
					TensorStaticDim(5),
					TensorStaticDim(2),
				),
			),
		),
	]
	static: CoreMonoSubstitution = [("#N", DimSubstitution(TensorStaticDim(2)))]
	name = mangle_specialization_name("divide", substitution)

	(
		name != mangle_specialization_name("divide", static)
		and name
			.get_or("")
			.starts_with("divide__mono_sig_")
	)


func test_mangle_distinguishes_nested_and_underscored_types() -> Bool:
	underscored: CoreMonoSubstitution = [("T", TypeSubstitution(named_type("A_B")))]
	nested: CoreMonoSubstitution = [("T", TypeSubstitution(NamedType("A", [named_type("B")])))]

	mangle_specialization_name(
		"convert",
		underscored,
	) != mangle_specialization_name("convert", nested)


func test_mangle_frames_multiple_substitution_values() -> Bool:
	left: CoreMonoSubstitution = [
		("T", TypeSubstitution(named_type("A_B"))),
		("U", TypeSubstitution(named_type("C"))),
	]
	right: CoreMonoSubstitution = [
		("T", TypeSubstitution(named_type("A"))),
		("U", TypeSubstitution(named_type("B_C"))),
	]

	mangle_specialization_name("combine", left) != mangle_specialization_name("combine", right)


tests: TestSuite = {
	description = "Blorp compiler Core monomorphization",
	tests = [
		("collects simple type parameter", test_collects_simple_type_parameter),
		("collects nested type parameter", test_collects_nested_type_parameter),
		("rejects conflicting repeated parameter", test_rejects_conflicting_repeated_parameter),
		("repeated parameter accepts same type", test_repeated_parameter_accepts_same_type),
		(
			"identity evidence does not conflict with concrete evidence",
			test_identity_evidence_does_not_conflict_with_concrete_evidence,
		),
		(
			"unresolved outer evidence keeps substitution open",
			test_unresolved_outer_evidence_keeps_substitution_open,
		),
		(
			"same-named outer type evidence stays open in both orders",
			test_same_named_outer_type_evidence_stays_open_in_both_orders,
		),
		(
			"nominal type name is not a type parameter",
			test_nominal_type_name_is_not_a_type_parameter,
		),
		("collects and applies Self type", test_collects_and_applies_self_type),
		(
			"dimension parameter ignores value type evidence",
			test_dimension_parameter_ignores_value_type_evidence,
		),
		(
			"same-named outer dimension evidence stays open in both orders",
			test_same_named_outer_dimension_evidence_stays_open_in_both_orders,
		),
		(
			"dimension identity does not conflict with concrete evidence",
			test_dimension_identity_does_not_conflict_with_concrete_evidence,
		),
		(
			"equivalent dimension evidence is normalized",
			test_equivalent_dimension_evidence_is_normalized,
		),
		(
			"nested dimension constants are normalized",
			test_nested_dimension_constants_are_normalized,
		),
		(
			"value substitution erases range refinement",
			test_value_substitution_erases_range_refinement,
		),
		(
			"same-named outer dimension pack stays open in both orders",
			test_same_named_outer_dimension_pack_stays_open_in_both_orders,
		),
		("collects variadic tensor dimensions", test_collects_variadic_tensor_dimensions),
		(
			"collects implicit trailing dimension pack",
			test_collects_implicit_trailing_dimension_pack,
		),
		(
			"applies nested type and dimension substitution",
			test_applies_nested_type_and_dimension_substitution,
		),
