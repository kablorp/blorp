import:
	../src/stage_12_lsp/lsp_frame_codec:
		LspFrameDecodeOutcome(LspFrameDecodeFailed, LspFrameDecodeReady),
		LspFrameDecodeTransition,
		LspFrameDecoder,
		LspFrameLimits,
		lsp_default_frame_limits,
		lsp_encode_frame,
		lsp_feed_frame_decoder,
		lsp_finish_frame_decoder,
		lsp_frame_decoder,
		lsp_frame_limits,
	../src/stage_12_lsp/lsp_transport_model:
		LspTransportError(
			LspFrameBodyTooLarge,
			LspFrameHeaderTooLarge,
			LspIncompleteFrameBody,
			LspIncompleteFrameHeader,
			LspInvalidFrameBodyUtf8,
			LspInvalidFrameHeader,
		),
	bytes: bytes
	int: INT_MAX
	test: TestSuite


private ZERO_LENGTH_FRAME_STRESS_COUNT: Int = 512


private pure func test_limits() -> LspFrameLimits:
	lsp_frame_limits(128, 64).get_or(lsp_default_frame_limits())


private pure func feed_text(
	transition: LspFrameDecodeTransition,
	text: String,
) -> Option[LspFrameDecodeTransition]:
	decoder ?= transition_decoder(transition)
	Some(lsp_feed_frame_decoder(decoder, text.to_bytes()))


private pure func transition_decoder(
	transition: LspFrameDecodeTransition,
) -> Option[LspFrameDecoder]:
	match transition.outcome:
		LspFrameDecodeReady(decoder):
			Some(decoder)
		LspFrameDecodeFailed(_):
			None


private pure func transition_error(
	transition: LspFrameDecodeTransition,
) -> Option[LspTransportError]:
	match transition.outcome:
		LspFrameDecodeReady(_):
			None
		LspFrameDecodeFailed(error):
			Some(error)


private pure func initial_transition() -> LspFrameDecodeTransition:
	{
		outcome = LspFrameDecodeReady(lsp_frame_decoder(test_limits())),
		bodies = []
	}


private pure func fragmented_frame_case() -> Option[Bool]:
	header ?= feed_text(initial_transition(), "Content-Len")
	header_finished ?= feed_text(header, "gth: 5\r\n\r\nhe")
	completed ?= feed_text(header_finished, "llo")
	decoder ?= transition_decoder(completed)

	Some(completed.bodies == ["hello"] and lsp_finish_frame_decoder(decoder).is_ok())


pure func test_fragmented_header_and_body() -> Bool:
	fragmented_frame_case().get_or(False)


private pure func fragmented_terminator_case() -> Option[Bool]:
	first ?= feed_text(initial_transition(), "Content-Length: 1\r")
	second ?= feed_text(first, "\n\r")
	completed ?= feed_text(second, "\na")
	Some(completed.bodies == ["a"])


pure func test_header_terminator_can_cross_every_chunk_boundary() -> Bool:
	fragmented_terminator_case().get_or(False)


private pure func multiple_frames_case() -> Option[Bool]:
	decoded ?= feed_text(
		initial_transition(),
		"Content-Length: 1\r\n\r\naContent-Length: 2\r\n\r\nbc",
	)
	Some(decoded.bodies == ["a", "bc"])


pure func test_multiple_frames_in_one_chunk() -> Bool:
	multiple_frames_case().get_or(False)


pure func test_completed_frame_is_preserved_before_later_frame_error() -> Bool:
	transition = lsp_feed_frame_decoder(
		lsp_frame_decoder(test_limits()),
		"Content-Length: 1\r\n\r\naContent-Length: nope\r\n\r\n".to_bytes(),
	)

	match transition.outcome:
		LspFrameDecodeFailed(LspInvalidFrameHeader(_)):
			transition.bodies == ["a"]
		_:
			False


pure func test_completed_frame_is_preserved_before_later_utf8_error() -> Bool:
	frames = "Content-Length: 1\r\n\r\naContent-Length: 1\r\n\r\n"
		.to_bytes()
		.append(invalid_utf8_body())

	transition = lsp_feed_frame_decoder(lsp_frame_decoder(test_limits()), frames)

	match transition.outcome:
		LspFrameDecodeFailed(LspInvalidFrameBodyUtf8):
			transition.bodies == ["a"]
		_:
			False


pure func test_completed_frame_is_preserved_before_later_body_limit_error() -> Bool:
	limits = lsp_frame_limits(128, 1).get_or(lsp_default_frame_limits())
	transition = lsp_feed_frame_decoder(
		lsp_frame_decoder(limits),
		"Content-Length: 1\r\n\r\naContent-Length: 2\r\n\r\n".to_bytes(),
	)

	match transition.outcome:
		LspFrameDecodeFailed(LspFrameBodyTooLarge(1)):
			transition.bodies == ["a"]
		_:
			False


private pure func zero_length_then_frame_case() -> Option[Bool]:
	decoded ?= feed_text(
		initial_transition(),
		"Content-Length: 0\r\n\r\nContent-Length: 1\r\n\r\na",
	)
	Some(decoded.bodies == ["", "a"])


pure func test_zero_length_body_does_not_stall_next_frame() -> Bool:
	zero_length_then_frame_case().get_or(False)


private pure func case_insensitive_headers_case() -> Option[Bool]:
	decoded ?= feed_text(
		initial_transition(),
		"content-length: 2\r\nContent-Type: application/vscode-jsonrpc; charset=utf-8\r\nX-Test: yes\r\n\r\n{}",
	)
	Some(decoded.bodies == ["{}"])


pure func test_case_insensitive_content_length_and_unknown_headers() -> Bool:
	case_insensitive_headers_case().get_or(False)


pure func test_non_utf8_content_type_is_rejected() -> Bool:
	match transition_error(
		lsp_feed_frame_decoder(
			lsp_frame_decoder(test_limits()),
			("Content-Length: 1\r\n" + "Content-Type: application/vscode-jsonrpc; charset=iso-8859-1\r\n\r\na").to_bytes(),
		),
	):
		Some(LspInvalidFrameHeader(_)):
			True
		_:
			False


private pure func legacy_utf8_content_type_case() -> Option[Bool]:
	decoded ?= feed_text(
		initial_transition(),
		"Content-Length: 1\r\nContent-Type: application/vscode-jsonrpc; charset=utf8\r\n\r\na",
	)
	Some(decoded.bodies == ["a"])


pure func test_legacy_utf8_content_type_is_accepted() -> Bool:
	legacy_utf8_content_type_case().get_or(False)


pure func test_duplicate_content_type_is_rejected() -> Bool:
	match transition_error(
		lsp_feed_frame_decoder(
			lsp_frame_decoder(test_limits()),
			("Content-Length: 1\r\n" + "Content-Type: application/vscode-jsonrpc; charset=utf-8\r\n" + "Content-Type: application/vscode-jsonrpc\r\n\r\na").to_bytes(),
		),
	):
		Some(LspInvalidFrameHeader(_)):
			True
		_:
			False


private pure func token_header_name_case() -> Option[Bool]:
	decoded ?= feed_text(initial_transition(), "X_Custom-Header: yes\r\nContent-Length: 1\r\n\r\na")
	Some(decoded.bodies == ["a"])


pure func test_unknown_header_accepts_rfc_token_name() -> Bool:
	token_header_name_case().get_or(False)


private pure func encoded_utf8_length_case() -> Option[Bool]:
	encoded ?= lsp_encode_frame("é").to_option()
	Some(encoded.to_string() == "Content-Length: 2\r\n\r\né")


pure func test_encoder_uses_utf8_byte_length() -> Bool:
	encoded_utf8_length_case().get_or(False)


private pure func valid_multibyte_body_case() -> Option[Bool]:
	decoded ?= feed_text(initial_transition(), "Content-Length: 2\r\n\r\né")
	Some(decoded.bodies == ["é"])


pure func test_decoder_accepts_valid_multibyte_utf8() -> Bool:
	valid_multibyte_body_case().get_or(False)


private pure func many_zero_length_frames_case() -> Option[Bool]:
	var reversed_frames: List[String] = []

	for _ in 0..ZERO_LENGTH_FRAME_STRESS_COUNT:
		reversed_frames = ["Content-Length: 0\r\n\r\n"] + reversed_frames

	decoded ?= feed_text(
		initial_transition(),
		reversed_frames
			.reverse()
			.join(""),
	)
	Some(
		(
			decoded.bodies.length() == ZERO_LENGTH_FRAME_STRESS_COUNT
			and decoded.bodies.all(func(body): body.is_empty())
		),
	)


pure func test_many_frames_preserve_order() -> Bool:
	many_zero_length_frames_case().get_or(False)


pure func test_duplicate_content_length_is_rejected() -> Bool:
	match transition_error(
		lsp_feed_frame_decoder(
			lsp_frame_decoder(test_limits()),
			"Content-Length: 1\r\nContent-Length: 1\r\n\r\na".to_bytes(),
		),
	):
		Some(LspInvalidFrameHeader(_)):
			True
		_:
			False


pure func test_non_decimal_content_length_is_rejected() -> Bool:
	match transition_error(
		lsp_feed_frame_decoder(
			lsp_frame_decoder(test_limits()),
			"Content-Length: +1\r\n\r\na".to_bytes(),
		),
	):
		Some(LspInvalidFrameHeader(_)):
			True
		_:
			False


pure func test_malformed_header_line_is_rejected() -> Bool:
	match transition_error(
		lsp_feed_frame_decoder(
			lsp_frame_decoder(test_limits()),
			"Content-Length 1\r\n\r\na".to_bytes(),
		),
	):
		Some(LspInvalidFrameHeader(_)):
			True
		_:
			False


pure func test_whitespace_before_header_colon_is_rejected() -> Bool:
	match transition_error(
		lsp_feed_frame_decoder(
			lsp_frame_decoder(test_limits()),
			"Content-Length : 1\r\n\r\na".to_bytes(),
		),
	):
		Some(LspInvalidFrameHeader(_)):
			True
