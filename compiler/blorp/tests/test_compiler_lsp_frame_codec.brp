pure func test_missing_content_length_is_rejected() -> Bool:
	match transition_error(
		lsp_feed_frame_decoder(
			lsp_frame_decoder(test_limits()),
			"Content-Type: application/vscode-jsonrpc\r\n\r\n".to_bytes(),
		),
	):
		Some(LspInvalidFrameHeader(_)):
			True
		_:
			False


pure func test_control_byte_in_header_value_is_rejected() -> Bool:
	prefix = "X-Test: ".to_bytes()
	control = bytes(1).set_index(0, 0)
	suffix = "\r\nContent-Length: 1\r\n\r\na".to_bytes()
	frame = prefix
		.append(control)
		.append(suffix)

	match transition_error(lsp_feed_frame_decoder(lsp_frame_decoder(test_limits()), frame)):
		Some(LspInvalidFrameHeader(_)):
			True
		_:
			False


pure func test_trailing_control_byte_is_rejected_before_value_trimming() -> Bool:
	match transition_error(
		lsp_feed_frame_decoder(
			lsp_frame_decoder(test_limits()),
			"X-Test: value\r\r\nContent-Length: 1\r\n\r\na".to_bytes(),
		),
	):
		Some(LspInvalidFrameHeader(_)):
			True
		_:
			False


pure func test_header_limit_is_enforced() -> Bool:
	limits = lsp_frame_limits(20, 64).get_or(lsp_default_frame_limits())

	match transition_error(
		lsp_feed_frame_decoder(
			lsp_frame_decoder(limits),
			"Content-Length: 1\r\n\r\na".to_bytes(),
		),
	):
		Some(LspFrameHeaderTooLarge(_, _)):
			True
		_:
			False


pure func test_header_limit_is_enforced_before_a_terminator_arrives() -> Bool:
	limits = lsp_frame_limits(8, 64).get_or(lsp_default_frame_limits())

	match transition_error(
		lsp_feed_frame_decoder(
			lsp_frame_decoder(limits),
			"123456789".to_bytes(),
		),
	):
		Some(LspFrameHeaderTooLarge(9, 8)):
			True
		_:
			False


private pure func exact_limits_case() -> Option[Bool]:
	header = "Content-Length: 1\r\n\r\n"
	limits ?= lsp_frame_limits(
		header
			.to_bytes()
			.length(),
		1,
	)
	decoded = lsp_feed_frame_decoder(lsp_frame_decoder(limits), (header + "a").to_bytes())
	Some(decoded.bodies == ["a"])


pure func test_exact_header_and_body_limits_are_accepted() -> Bool:
	exact_limits_case().get_or(False)


pure func test_frame_limits_reject_non_positive_bounds() -> Bool:
	(
		lsp_frame_limits(0, 1).is_none()
		and lsp_frame_limits(1, 0).is_none()
		and lsp_frame_limits(-1, 1).is_none()
		and lsp_frame_limits(1, -1).is_none()
	)


pure func test_maximum_header_limit_does_not_drop_input() -> Bool:
	limits = lsp_frame_limits(INT_MAX, 1).get_or(lsp_default_frame_limits())
	decoded = lsp_feed_frame_decoder(
		lsp_frame_decoder(limits),
		"Content-Length: 0\r\n\r\n".to_bytes(),
	)

	decoded.bodies == [""]


pure func test_body_limit_is_enforced_without_allocating_body() -> Bool:
	match transition_error(
		lsp_feed_frame_decoder(
			lsp_frame_decoder(test_limits()),
			"Content-Length: 65\r\n\r\n".to_bytes(),
		),
	):
		Some(LspFrameBodyTooLarge(64)):
			True
		_:
			False


pure func test_single_digit_body_limit_is_enforced() -> Bool:
	limits = lsp_frame_limits(128, 1).get_or(lsp_default_frame_limits())

	match transition_error(
		lsp_feed_frame_decoder(
			lsp_frame_decoder(limits),
			"Content-Length: 2\r\n\r\n".to_bytes(),
		),
	):
		Some(LspFrameBodyTooLarge(1)):
			True
		_:
			False


pure func test_huge_content_length_is_bounded_before_integer_overflow() -> Bool:
	match transition_error(
		lsp_feed_frame_decoder(
			lsp_frame_decoder(test_limits()),
			"Content-Length: 999999999999999999999999999999999999\r\n\r\n".to_bytes(),
		),
	):
		Some(LspFrameBodyTooLarge(64)):
			True
		_:
			False


private pure func invalid_utf8_body() -> Bytes:
	bytes(1).set_index(0, 255)


private pure func bytes_from_values(values: List[Int]) -> Bytes:
	var result: Bytes = bytes(values.length())
	var index: Int = 0

	for value in values:
		result = result.set_index(index, value)
		index += 1

	result


private pure func frame_with_body(body: Bytes) -> Bytes:
	header = "Content-Length: ${body.length()}\r\n\r\n".to_bytes()
	header.append(body)


private pure func invalid_utf8_is_rejected(body: Bytes) -> Bool:
	match transition_error(
		lsp_feed_frame_decoder(
			lsp_frame_decoder(test_limits()),
			frame_with_body(body),
		),
	):
		Some(LspInvalidFrameBodyUtf8):
			True
		_:
			False


pure func test_invalid_utf8_body_is_rejected() -> Bool:
	invalid_utf8_is_rejected(invalid_utf8_body())


pure func test_overlong_surrogate_and_out_of_range_utf8_are_rejected() -> Bool:
	(
		invalid_utf8_is_rejected(bytes_from_values([192, 128]))
		and invalid_utf8_is_rejected(bytes_from_values([237, 160, 128]))
		and invalid_utf8_is_rejected(bytes_from_values([244, 144, 128, 128]))
		and invalid_utf8_is_rejected(bytes_from_values([226, 130]))
	)


pure func test_encoder_rejects_a_string_with_invalid_utf8_bytes() -> Bool:
	invalid = bytes_from_values([255]).to_string()

	match lsp_encode_frame(invalid):
		Err(LspInvalidFrameBodyUtf8):
			True
		_:
			False


private pure func split_frame_at(frame: Bytes, split: Int) -> Bool:
	first = lsp_feed_frame_decoder(
		lsp_frame_decoder(test_limits()),
		frame.slice(0, split),
	)

	match first.outcome:
		LspFrameDecodeFailed(_):
			False
		LspFrameDecodeReady(next_decoder):
			second = lsp_feed_frame_decoder(
				next_decoder,
				frame.slice(split, frame.length() - split),
			)

			match second.outcome:
				LspFrameDecodeFailed(_):
					False
				LspFrameDecodeReady(completed_decoder):
					(
						first.bodies + second.bodies == ["hello"]
						and lsp_finish_frame_decoder(completed_decoder).is_ok()
					)


pure func test_frame_decodes_at_every_two_chunk_split() -> Bool:
	frame = "Content-Length: 5\r\nX-Test: yes\r\n\r\nhello".to_bytes()
	var split: Int = 0
	var valid: Bool = True

	while split <= frame.length() and valid:
		valid = split_frame_at(frame, split)
		split += 1

	valid


private pure func frame_decodes_in_one_byte_chunks(
	frame: Bytes,
	limits: LspFrameLimits,
	expected_body: String,
) -> Bool:
	var decoder_option: Option[LspFrameDecoder] = Some(lsp_frame_decoder(limits))
	var bodies: List[String] = []
	var index: Int = 0

	while index < frame.length() and decoder_option.is_some():
		match decoder_option:
			None:
				void
			Some(decoder):
				transition = lsp_feed_frame_decoder(
					decoder,
					frame.slice(index, 1),
				)

				for body in transition.bodies:
					bodies = bodies.append(body)

				decoder_option = transition_decoder(transition)

		index += 1

	match decoder_option:
		None:
			False
		Some(completed_decoder):
			bodies == [expected_body] and lsp_finish_frame_decoder(completed_decoder).is_ok()


pure func test_frame_decodes_when_every_byte_is_a_chunk() -> Bool:
	frame_decodes_in_one_byte_chunks(
		"Content-Length: 5\r\n\r\nhello".to_bytes(),
		test_limits(),
		"hello",
	)


pure func test_large_body_decodes_from_one_byte_chunks() -> Bool:
	body = "x".repeat(4096)
	limits = lsp_frame_limits(128, body.length()).get_or(lsp_default_frame_limits())
	frame = "Content-Length: ${body.length()}\r\n\r\n${body}".to_bytes()

	frame_decodes_in_one_byte_chunks(frame, limits, body)


private pure func decoder_branches_from_partial_body_case() -> Option[Bool]:
	partial = lsp_feed_frame_decoder(
		lsp_frame_decoder(test_limits()),
		"Content-Length: 2\r\n\r\na".to_bytes(),
	)
	decoder ?= transition_decoder(partial)
	left = lsp_feed_frame_decoder(decoder, "b".to_bytes())
	right = lsp_feed_frame_decoder(decoder, "c".to_bytes())

	Some(left.bodies == ["ab"] and right.bodies == ["ac"])


pure func test_retained_partial_body_decoder_has_value_semantics() -> Bool:
	decoder_branches_from_partial_body_case().get_or(False)


private pure func decoder_branches_from_partial_header_case() -> Option[Bool]:
	partial = lsp_feed_frame_decoder(lsp_frame_decoder(test_limits()), "Content-Len".to_bytes())
	decoder ?= transition_decoder(partial)
	left = lsp_feed_frame_decoder(decoder, "gth: 1\r\n\r\na".to_bytes())
	right = lsp_feed_frame_decoder(decoder, "gth: 1\r\n\r\nb".to_bytes())

	Some(left.bodies == ["a"] and right.bodies == ["b"])


pure func test_retained_partial_header_decoder_has_value_semantics() -> Bool:
	decoder_branches_from_partial_header_case().get_or(False)


private pure func incomplete_header_case() -> Bool:
	transition = lsp_feed_frame_decoder(
		lsp_frame_decoder(test_limits()),
		"Content-Length: 1\r\n".to_bytes(),
	)

	match transition_decoder(transition):
		None:
			False
		Some(decoder):
			match lsp_finish_frame_decoder(decoder):
				Err(LspIncompleteFrameHeader):
					True
				_:
					False


pure func test_eof_with_incomplete_header_is_rejected() -> Bool:
	incomplete_header_case()


private pure func incomplete_body_case() -> Bool:
	transition = lsp_feed_frame_decoder(
		lsp_frame_decoder(test_limits()),
		"Content-Length: 2\r\n\r\na".to_bytes(),
	)

	match transition_decoder(transition):
		None:
			False
		Some(decoder):
			match lsp_finish_frame_decoder(decoder):
				Err(LspIncompleteFrameBody):
					True
				_:
					False


pure func test_eof_with_incomplete_body_is_rejected() -> Bool:
	incomplete_body_case()


pure func test_clean_eof_at_frame_boundary_succeeds() -> Bool:
	lsp_finish_frame_decoder(lsp_frame_decoder(test_limits())).is_ok()


tests: TestSuite = {
	description = "Blorp LSP frame codec",
	tests = [
		("fragmented header and body", test_fragmented_header_and_body),
		(
			"header terminator can cross every chunk boundary",
			test_header_terminator_can_cross_every_chunk_boundary,
		),
		("multiple frames in one chunk", test_multiple_frames_in_one_chunk),
		(
			"completed frame is preserved before later frame error",
			test_completed_frame_is_preserved_before_later_frame_error,
		),
		(
			"completed frame is preserved before later UTF-8 error",
			test_completed_frame_is_preserved_before_later_utf8_error,
		),
		(
			"completed frame is preserved before later body limit error",
			test_completed_frame_is_preserved_before_later_body_limit_error,
		),
		(
			"zero-length body does not stall next frame",
			test_zero_length_body_does_not_stall_next_frame,
		),
		(
			"case-insensitive content length and unknown headers",
			test_case_insensitive_content_length_and_unknown_headers,
		),
		("non-UTF-8 content type is rejected", test_non_utf8_content_type_is_rejected),
		("legacy UTF-8 content type is accepted", test_legacy_utf8_content_type_is_accepted),
		("duplicate content type is rejected", test_duplicate_content_type_is_rejected),
		("unknown header accepts RFC token name", test_unknown_header_accepts_rfc_token_name),
		("encoder uses UTF-8 byte length", test_encoder_uses_utf8_byte_length),
		("decoder accepts valid multibyte UTF-8", test_decoder_accepts_valid_multibyte_utf8),
		("many frames preserve order", test_many_frames_preserve_order),
		("duplicate content length is rejected", test_duplicate_content_length_is_rejected),
		("non-decimal content length is rejected", test_non_decimal_content_length_is_rejected),
		("malformed header line is rejected", test_malformed_header_line_is_rejected),
		(
			"whitespace before header colon is rejected",
			test_whitespace_before_header_colon_is_rejected,
		),
		("missing content length is rejected", test_missing_content_length_is_rejected),
		("control byte in header value is rejected", test_control_byte_in_header_value_is_rejected),
		(
			"trailing control byte is rejected before value trimming",
			test_trailing_control_byte_is_rejected_before_value_trimming,
		),
		("header limit is enforced", test_header_limit_is_enforced),
		(
			"header limit is enforced before a terminator arrives",
			test_header_limit_is_enforced_before_a_terminator_arrives,
		),
		(
			"exact header and body limits are accepted",
			test_exact_header_and_body_limits_are_accepted,
		),
		("frame limits reject non-positive bounds", test_frame_limits_reject_non_positive_bounds),
		("maximum header limit does not drop input", test_maximum_header_limit_does_not_drop_input),
		(
			"body limit is enforced without allocating body",
			test_body_limit_is_enforced_without_allocating_body,
		),
		("single-digit body limit is enforced", test_single_digit_body_limit_is_enforced),
		(
			"huge content length is bounded before integer overflow",
			test_huge_content_length_is_bounded_before_integer_overflow,
		),
		("invalid UTF-8 body is rejected", test_invalid_utf8_body_is_rejected),
		(
			"overlong, surrogate, and out-of-range UTF-8 are rejected",
			test_overlong_surrogate_and_out_of_range_utf8_are_rejected,
		),
		(
			"encoder rejects a string with invalid UTF-8 bytes",
