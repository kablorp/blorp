import:
	../src/stage_01_file_io/compiler_source:
		CompilerCursor,
		CompilerSourceFile,
		CompilerSourceSpan,
		compiler_source_cursor_at,
		compiler_source_file,
		compiler_source_span,
	../src/stage_03_parse/compiler_parsed_ast:
		ParsedBinaryOp(ParsedAddOp),
		ParsedExpr(ParsedIntLiteralExpr),
		ParsedIdentifier,
		ParsedTypeExpr(ParsedNamedType),
		ParsedVarDecl,
		parsed_identifier,
	../src/stage_05_types/compiler_refinement: compiler_unrefined_binding
	../src/stage_05_types/compiler_type: compiler_type_int
	../src/stage_05_types/compiler_type_widening: CompilerValueSlot(CompilerKeptValueSlot)
	../src/stage_06_typecheck/compiler_infer:
		CompilerExprTypeOrigin(CompilerSynthesizedOrigin),
		CompilerTypedExpr(
			CompilerTypedBinaryExpr,
			CompilerTypedIntLiteralExpr,
			CompilerTypedNameExpr,
		),
		CompilerTypedExprInfo,
	../src/stage_06_typecheck/compiler_typecheck_decl:
		CompilerTypedDecl(CompilerTypedGlobalVarDecl, CompilerTypedPrivateDecl),
		CompilerTypedGlobalVarInfo,
		CompilerTypedProgram,
	../src/stage_06_typecheck/compiler_typecheck_state: CompilerImportBinding
	../src/stage_07_ctfe/compiler_ctfe_context:
		CompilerCtfeContext,
		CompilerCtfeImportedProgram,
		compiler_ctfe_context_empty,
		compiler_ctfe_context_module_global_value,
	../src/stage_07_ctfe/compiler_ctfe_env: compiler_ctfe_env_empty, compiler_ctfe_lookup_value
	../src/stage_07_ctfe/compiler_ctfe_eval: CompilerCtfeEvalError, compiler_ctfe_eval_error_message
	../src/stage_07_ctfe/compiler_ctfe_globals:
		compiler_ctfe_eval_imported_program_global_envs,
		compiler_ctfe_eval_program_global_env,
		compiler_ctfe_evaluate_program_globals,
		compiler_ctfe_rewrite_program_globals,
		compiler_ctfe_rewrite_program_globals_with_import_bindings,
	../src/stage_07_ctfe/compiler_ctfe_value:
		CompilerCtfeEnv,
		compiler_ctfe_int,
		compiler_ctfe_values_equal,
	test: TestSuite


pure func source_file() -> CompilerSourceFile:
	compiler_source_file("ctfe_global_eval.brp", "ctfe_global_eval", "VALUE = 1")


pure func source_span() -> CompilerSourceSpan:
	src: CompilerSourceFile = source_file()
	cursor: CompilerCursor = compiler_source_cursor_at(src, 0)
	compiler_source_span(src, cursor, cursor)


pure func ident(text: String) -> ParsedIdentifier:
	parsed_identifier(text, source_span())


pure func named_type(name: String) -> ParsedTypeExpr:
	ParsedNamedType(ident(name), [], source_span())


pure func parsed_var(name: String, is_mutable: Bool) -> ParsedVarDecl:
	{
		name = ident(name),
		type_expr = Some(named_type("Int")),
		value = ParsedIntLiteralExpr("0", source_span()),
		is_mutable = is_mutable,
		span = source_span()
	}


pure func expr_info() -> CompilerTypedExprInfo:
	{
		source_type = None,
		origin = CompilerSynthesizedOrigin("ctfe_global_eval_test"),
		value_slot = CompilerKeptValueSlot(compiler_type_int()),
		proofs = compiler_unrefined_binding(),
		resolved_call = None,
		resource_dependencies = []
	}


pure func int_expr(text: String) -> CompilerTypedExpr:
	CompilerTypedIntLiteralExpr(text, source_span(), expr_info())


pure func name_expr(name: String) -> CompilerTypedExpr:
	CompilerTypedNameExpr(ident(name), expr_info())


pure func add_expr(left: CompilerTypedExpr, right: CompilerTypedExpr) -> CompilerTypedExpr:
	CompilerTypedBinaryExpr(ParsedAddOp, left, right, source_span(), expr_info())


pure func typed_global(
	name: String,
	is_mutable: Bool,
	value: CompilerTypedExpr,
) -> CompilerTypedGlobalVarInfo:
	{
		decl = parsed_var(name, is_mutable),
		binding_type = compiler_type_int(),
		source_type = Some(compiler_type_int()),
		value = value
	}


pure func typed_global_decl(
	name: String,
	is_mutable: Bool,
	value: CompilerTypedExpr,
) -> CompilerTypedDecl:
	CompilerTypedGlobalVarDecl(typed_global(name, is_mutable, value))


pure func private_typed_global_decl(
	name: String,
	is_mutable: Bool,
	value: CompilerTypedExpr,
) -> CompilerTypedDecl:
	CompilerTypedPrivateDecl(typed_global_decl(name, is_mutable, value))


pure func typed_program(decls: List[CompilerTypedDecl]) -> CompilerTypedProgram:
	{
		source = source_file(),
		decls = decls,
		diagnostics = []
	}


pure func import_binding(
	local_name: String,
	module_path: String,
	original_name: Option[String],
) -> CompilerImportBinding:
	{
		local_name = local_name,
		module_path = module_path,
		original_name = original_name
	}


pure func lookup_equals(env: CompilerCtfeEnv, name: String, expected: Int) -> Bool:
	match compiler_ctfe_lookup_value(env, name):
		Ok(value):
			compiler_ctfe_values_equal(
				value,
				compiler_ctfe_int(source_span(), expected),
			)
		Err(_):
			False


pure func result_error_message(result: Result[CompilerCtfeEnv, CompilerCtfeEvalError]) -> String:
	match result:
		Err(error):
			compiler_ctfe_eval_error_message(error)
		Ok(_):
			""


func test_eval_program_globals_in_source_order() -> Bool:
	program = typed_program([
		typed_global_decl("A", False, int_expr("1")),
		typed_global_decl(
			"B",
			False,
			add_expr(name_expr("A"), int_expr("2")),
		),
	])
	result = compiler_ctfe_eval_program_global_env(
		compiler_ctfe_context_empty(),
		compiler_ctfe_env_empty(),
		program,
	)

	match result:
		Ok(env):
			lookup_equals(env, "A", 1) and lookup_equals(env, "B", 3)
		Err(_):
			False


func test_eval_program_rejects_later_global_reference() -> Bool:
	program = typed_program([
		typed_global_decl("A", False, name_expr("B")),
		typed_global_decl("B", False, int_expr("2")),
	])

	result_error_message(
		compiler_ctfe_eval_program_global_env(
			compiler_ctfe_context_empty(),
			compiler_ctfe_env_empty(),
			program,
		),
	) == "global constant initializer cannot reference later global constant 'B'"


func test_eval_program_rejects_self_reference() -> Bool:
	program = typed_program([typed_global_decl("A", False, name_expr("A"))])

	result_error_message(
		compiler_ctfe_eval_program_global_env(
			compiler_ctfe_context_empty(),
			compiler_ctfe_env_empty(),
			program,
		),
	) == "global constant initializer cannot reference itself: 'A'"


func test_eval_program_keeps_mutable_global_runtime_initialized() -> Bool:
	program = typed_program([
		typed_global_decl("RUNTIME", True, int_expr("1")),
		typed_global_decl("A", False, name_expr("RUNTIME")),
	])

	result_error_message(
		compiler_ctfe_eval_program_global_env(
			compiler_ctfe_context_empty(),
			compiler_ctfe_env_empty(),
			program,
		),
	) == (
		"global constant initializer cannot reference global 'RUNTIME' because it is not "
		+ "a compile-time constant"
	)


func test_eval_program_evaluates_private_globals() -> Bool:
	program = typed_program([
		private_typed_global_decl("HIDDEN", False, int_expr("5")),
		typed_global_decl(
			"PUBLIC",
			False,
			add_expr(name_expr("HIDDEN"), int_expr("1")),
		),
	])
	result = compiler_ctfe_eval_program_global_env(
		compiler_ctfe_context_empty(),
		compiler_ctfe_env_empty(),
		program,
	)

	match result:
		Ok(env):
			lookup_equals(env, "HIDDEN", 5) and lookup_equals(env, "PUBLIC", 6)
		Err(_):
			False


func test_eval_imported_program_global_envs_attach_to_context() -> Bool:
	imported_programs: List[CompilerCtfeImportedProgram] = [
		{
			module_path = "dep",
			program = typed_program([typed_global_decl("VALUE", False, int_expr("42"))]),
			import_bindings = []
		},
	]
	result: Result[CompilerCtfeContext, CompilerCtfeEvalError] = compiler_ctfe_eval_imported_program_global_envs(
		compiler_ctfe_context_empty(),
		imported_programs,
	)

	match result:
		Ok(context):
			match compiler_ctfe_context_module_global_value(context, "dep", "VALUE"):
				Some(value):
					compiler_ctfe_values_equal(
						value,
						compiler_ctfe_int(source_span(), 42),
					)
				None:
					False
		Err(_):
			False


func test_eval_imported_program_globals_use_dependency_bindings() -> Bool:
	imported_programs: List[CompilerCtfeImportedProgram] = [
		{
			module_path = "base",
			program = typed_program([typed_global_decl("VALUE", False, int_expr("40"))]),
			import_bindings = []
		},
		{
			module_path = "dep",
			program = typed_program([typed_global_decl(
						"NEXT",
						False,
						add_expr(name_expr("VALUE"), int_expr("1")),
					)]),
			import_bindings = [import_binding("VALUE", "base", Some("VALUE"))]
		},
	]
	result = compiler_ctfe_eval_imported_program_global_envs(
		compiler_ctfe_context_empty(),
		imported_programs,
	)

	match result:
		Ok(context):
			match compiler_ctfe_context_module_global_value(context, "dep", "NEXT"):
				Some(value):
					compiler_ctfe_values_equal(
						value,
						compiler_ctfe_int(source_span(), 41),
					)
				None:
					False
		Err(_):
			False


pure func rewrite_globals_fixture() -> Result[CompilerTypedProgram, CompilerCtfeEvalError]:
	program = typed_program([
		typed_global_decl(
			"A",
			False,
			add_expr(int_expr("1"), int_expr("2")),
		),
		typed_global_decl(
			"RUNTIME",
			True,
			add_expr(int_expr("3"), int_expr("4")),
		),
	])
	compiler_ctfe_rewrite_program_globals(
		compiler_ctfe_context_empty(),
		compiler_ctfe_env_empty(),
		program,
	)


func test_rewrite_program_globals_materializes_typed_initializer() -> Bool:
	result = rewrite_globals_fixture()

	match result:
		Ok(rewritten):
			match rewritten.decls.get(0):
				Some(CompilerTypedGlobalVarDecl(info)):
					match info.value:
						CompilerTypedIntLiteralExpr(text, _, _):
							text == "3"
						_:
							False
				_:
					False
		Err(_):
			False


func test_rewrite_program_globals_materializes_parsed_initializer() -> Bool:
	result = rewrite_globals_fixture()

	match result:
		Ok(rewritten):
			match rewritten.decls.get(0):
				Some(CompilerTypedGlobalVarDecl(info)):
					match info.decl.value:
						ParsedIntLiteralExpr(text, _):
							text == "3"
						_:
							False
				_:
					False
		Err(_):
			False


func test_rewrite_program_globals_keeps_materialized_global_immutable() -> Bool:
	result = rewrite_globals_fixture()

	match result:
		Ok(rewritten):
			match rewritten.decls.get(0):
				Some(CompilerTypedGlobalVarDecl(info)):
					not info.decl.is_mutable
				_:
					False
		Err(_):
			False


func test_rewrite_program_globals_leaves_mutable_initializer_runtime() -> Bool:
	result = rewrite_globals_fixture()

	match result:
		Ok(rewritten):
			match rewritten.decls.get(1):
				Some(CompilerTypedGlobalVarDecl(info)):
					match info.value:
						CompilerTypedBinaryExpr(_, _, _, _, _):
							info.decl.is_mutable
						_:
							False
				_:
					False
		Err(_):
			False


func test_rewrite_program_globals_uses_selective_imported_constant() -> Bool:
	imported_programs: List[CompilerCtfeImportedProgram] = [
		{
			module_path = "dep",
			program = typed_program([typed_global_decl("OFFSET", False, int_expr("41"))]),
			import_bindings = []
		},
	]
	context_result = compiler_ctfe_eval_imported_program_global_envs(
		compiler_ctfe_context_empty(),
		imported_programs,
	)
	program = typed_program([typed_global_decl(
				"ANSWER",
				False,
				add_expr(name_expr("OFFSET"), int_expr("1")),
			)])

	match context_result:
		Ok(context):
			result = compiler_ctfe_rewrite_program_globals_with_import_bindings(
				context,
				[import_binding("OFFSET", "dep", Some("OFFSET"))],
				program,
			)

			match result:
				Ok(rewritten):
					match rewritten.decls.get(0):
						Some(CompilerTypedGlobalVarDecl(info)):
							match info.value:
								CompilerTypedIntLiteralExpr(text, _, _):
									text == "42"
								_:
									False
						_:
							False
				Err(_):
					False
		Err(_):
			False


func test_rewrite_program_globals_rejects_runtime_initialized_selective_import() -> Bool:
	imported_programs: List[CompilerCtfeImportedProgram] = [
		{
			module_path = "dep",
			program = typed_program([typed_global_decl("OFFSET", True, int_expr("41"))]),
			import_bindings = []
		},
	]
	context_result = compiler_ctfe_eval_imported_program_global_envs(
		compiler_ctfe_context_empty(),
		imported_programs,
	)
	program = typed_program([typed_global_decl("ANSWER", False, name_expr("OFFSET"))])

	match context_result:
		Ok(context):
			result = compiler_ctfe_rewrite_program_globals_with_import_bindings(
				context,
				[import_binding("OFFSET", "dep", Some("OFFSET"))],
				program,
			)

			match result:
				Err(error):
					compiler_ctfe_eval_error_message(error) == (
						"global constant initializer cannot reference imported value 'dep.OFFSET' "
						+ "because it is not a compile-time constant"
					)
				Ok(_):
					False
		Err(_):
			False


func test_evaluate_program_globals_builds_context_and_rewrites_target() -> Bool:
	imported_programs: List[CompilerCtfeImportedProgram] = [
		{
			module_path = "dep",
			program = typed_program([typed_global_decl("OFFSET", False, int_expr("40"))]),
			import_bindings = []
		},
	]
	program = typed_program([typed_global_decl(
				"ANSWER",
				False,
				add_expr(name_expr("OFFSET"), int_expr("2")),
			)])
	result = compiler_ctfe_evaluate_program_globals(
		program,
		imported_programs,
		[import_binding("OFFSET", "dep", Some("OFFSET"))],
	)

	match result:
		Ok(rewritten):
			match rewritten.decls.get(0):
				Some(CompilerTypedGlobalVarDecl(info)):
					match info.value:
						CompilerTypedIntLiteralExpr(text, _, _):
							text == "42"
						_:
							False
				_:
					False
		Err(_):
			False


tests: TestSuite = {
	description = "Compiler CTFE global eval",
	tests = [
		("eval program globals in source order", test_eval_program_globals_in_source_order),
		(
			"eval program rejects later global reference",
			test_eval_program_rejects_later_global_reference,
		),
		("eval program rejects self reference", test_eval_program_rejects_self_reference),
		(
			"eval program keeps mutable global runtime initialized",
			test_eval_program_keeps_mutable_global_runtime_initialized,
		),
		("eval program evaluates private globals", test_eval_program_evaluates_private_globals),
		(
			"eval imported program global envs attach to context",
			test_eval_imported_program_global_envs_attach_to_context,
		),
		(
			"eval imported program globals use dependency bindings",
			test_eval_imported_program_globals_use_dependency_bindings,
		),
		(
			"rewrite program globals materializes typed initializer",
			test_rewrite_program_globals_materializes_typed_initializer,
		),
		(
			"rewrite program globals materializes parsed initializer",
			test_rewrite_program_globals_materializes_parsed_initializer,
		),
		(
			"rewrite program globals keeps materialized global immutable",
			test_rewrite_program_globals_keeps_materialized_global_immutable,
		),
		(
			"rewrite program globals leaves mutable initializer runtime",
			test_rewrite_program_globals_leaves_mutable_initializer_runtime,
		),
		(
			"rewrite program globals uses selective imported constant",
			test_rewrite_program_globals_uses_selective_imported_constant,
		),
		(
			"rewrite program globals rejects runtime initialized selective import",
			test_rewrite_program_globals_rejects_runtime_initialized_selective_import,
		),
		(
			"evaluate program globals builds context and rewrites target",
			test_evaluate_program_globals_builds_context_and_rewrites_target,
		),
	]
}
