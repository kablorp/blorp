import:
	../src/stage_01_file_io/compiler_source:
		CompilerCursor,
		CompilerSourceFile,
		CompilerSourceSpan,
		compiler_source_cursor_at,
		compiler_source_file,
		compiler_source_span,
	../src/stage_05_types/compiler_type:
		CompilerType(CompilerNamedType),
		compiler_type_int,
		compiler_type_string,
	../src/stage_07_ctfe/compiler_ctfe_value:
		CompilerCtfeError(CompilerCtfeUnsupported),
		CompilerCtfeValue,
		compiler_ctfe_bool,
		compiler_ctfe_char,
		compiler_ctfe_int,
		compiler_ctfe_string,
		compiler_ctfe_values_equal,
	../src/stage_07_ctfe/compiler_ctfe_value_ops:
		CompilerCtfeOptionState(CompilerCtfeOptionNone, CompilerCtfeOptionSome),
		CompilerCtfeResultState(CompilerCtfeResultErr, CompilerCtfeResultOk),
		compiler_ctfe_option_none_value,
		compiler_ctfe_option_some_value,
		compiler_ctfe_option_state,
		compiler_ctfe_result_err_value,
		compiler_ctfe_result_ok_value,
		compiler_ctfe_result_state,
		compiler_ctfe_string_text_of_value,
	test: TestSuite


pure func source_file() -> CompilerSourceFile:
	compiler_source_file("ctfe_value_ops.brp", "ctfe_value_ops", "VALUE = 1")


pure func source_span() -> CompilerSourceSpan:
	src: CompilerSourceFile = source_file()
	cursor: CompilerCursor = compiler_source_cursor_at(src, 0)
	compiler_source_span(src, cursor, cursor)


pure func int_value(value: Int) -> CompilerCtfeValue:
	compiler_ctfe_int(source_span(), value)


pure func string_value(value: String) -> CompilerCtfeValue:
	compiler_ctfe_string(source_span(), value)


pure func bool_value(value: Bool) -> CompilerCtfeValue:
	compiler_ctfe_bool(source_span(), value)


pure func char_value(value: Int) -> CompilerCtfeValue:
	compiler_ctfe_char(source_span(), to_char(value))


pure func option_int_type() -> CompilerType:
	CompilerNamedType("Option", [compiler_type_int()])


pure func result_int_string_type() -> CompilerType:
	CompilerNamedType(
		"Result",
		[compiler_type_int(), compiler_type_string()],
	)


func test_option_state_decodes_constructor_values() -> Bool:
	some = compiler_ctfe_option_some_value(option_int_type(), source_span(), int_value(42))
	none = compiler_ctfe_option_none_value(option_int_type(), source_span())

	var some_ok: Bool = False

	match compiler_ctfe_option_state(some):
		Ok(CompilerCtfeOptionSome(value)):
			some_ok = compiler_ctfe_values_equal(value, int_value(42))
		_:
			void

	var none_ok: Bool = False

	match compiler_ctfe_option_state(none):
		Ok(CompilerCtfeOptionNone):
			none_ok = True
		_:
			void

	some_ok and none_ok


func test_result_state_decodes_constructor_values() -> Bool:
	ok = compiler_ctfe_result_ok_value(result_int_string_type(), source_span(), int_value(7))
	err = compiler_ctfe_result_err_value(
		result_int_string_type(),
		source_span(),
		string_value("bad"),
	)

	var ok_matches: Bool = False

	match compiler_ctfe_result_state(ok):
		Ok(CompilerCtfeResultOk(value)):
			ok_matches = compiler_ctfe_values_equal(value, int_value(7))
		_:
			void

	var err_matches: Bool = False

	match compiler_ctfe_result_state(err):
		Ok(CompilerCtfeResultErr(value)):
			err_matches = compiler_ctfe_values_equal(value, string_value("bad"))
		_:
			void

	ok_matches and err_matches


func test_carrier_state_rejects_non_carriers() -> Bool:
	option_error = compiler_ctfe_option_state(int_value(1))
	result_error = compiler_ctfe_result_state(int_value(1))

	var option_ok: Bool = False

	match option_error:
		Err(CompilerCtfeUnsupported(option_form)):
			option_ok = option_form == "Option helper on non-Option values"
		_:
			void

	var result_ok: Bool = False

	match result_error:
		Err(CompilerCtfeUnsupported(result_form)):
			result_ok = result_form == "Result helper on non-Result values"
		_:
			void

	option_ok and result_ok


pure func string_text(result: Result[String, CompilerCtfeError]) -> String:
	match result:
		Ok(text):
			text
		Err(_):
			"<error>"


func test_string_text_of_string_value() -> Bool:
	string_text(compiler_ctfe_string_text_of_value(string_value("label"))) == "label"


func test_string_text_of_int_value() -> Bool:
	string_text(compiler_ctfe_string_text_of_value(int_value(42))) == "42"


func test_string_text_of_bool_value() -> Bool:
	string_text(compiler_ctfe_string_text_of_value(bool_value(True))) == "True"


func test_string_text_of_char_value() -> Bool:
	string_text(compiler_ctfe_string_text_of_value(char_value(90))) == "Z"


tests: TestSuite = {
	description = "Compiler CTFE value ops",
	tests = [
		("option state decodes constructor values", test_option_state_decodes_constructor_values),
		("result state decodes constructor values", test_result_state_decodes_constructor_values),
		("carrier state rejects non-carriers", test_carrier_state_rejects_non_carriers),
		("string text of String values", test_string_text_of_string_value),
		("string text of Int values", test_string_text_of_int_value),
		("string text of Bool values", test_string_text_of_bool_value),
		("string text of Char values", test_string_text_of_char_value),
	]
}
