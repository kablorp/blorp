import:
	../src/stage_09_core/ir:
		CoreBoxKind(FloatBox, PointerBox, PrimBox, StructBox),
		CoreCallKind(BuiltinCall, IntrinsicCall),
		CoreDecl(EnumDecl, HeapRecordDecl, TypeAliasDecl, ValueRecordDecl),
		CoreExpr(
			BoxExpr,
			CallExpr,
			CastExpr,
			ConstructorMatchExpr,
			ListAllocExpr,
			ListConstructExpr,
			LiteralExpr,
			UnboxExpr,
			VarExpr,
			VoidExpr,
		),
		CoreListStorageLayout(InlineListStorage),
		CoreLiteral(IntLiteral),
		CoreProgram,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreTensorDim(TensorStaticDim),
		CoreType(
			FunctionType,
			HeapRecordType,
			NamedType,
			StackResultType,
			TensorType,
			TupleType,
			ValueRecordType,
			VoidType,
		),
		CoreUnboxKind(PointerUnbox, StructUnbox),
		CoreVar,
		core_expr_to_json,
	../src/stage_09_core/specialize_collection: specialize_collection_expr
	../src/stage_09_core/specialize_layout:
		CoreSpecializeLayout,
		build_specialize_layout,
	../src/stage_09_core/traverse: immediate_core_expr_children
	test: TestSuite


private pure func named_type(name: String) -> CoreType:
	NamedType(name, [])


private pure func core_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


private pure func variable(name: String, typ: CoreType) -> CoreExpr:
	VarExpr(core_var(name), typ, SyntheticSourceLoc)


private pure func int_literal(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), named_type("Int"), SyntheticSourceLoc)


private pure func call(name: String, args: List[CoreExpr], typ: CoreType) -> CoreExpr:
	CallExpr(
		BuiltinCall(name),
		VoidExpr(VoidType, SyntheticSourceLoc),
		args,
		typ,
		SyntheticSourceLoc,
	)


private pure func intrinsic(name: String, args: List[CoreExpr], typ: CoreType) -> CoreExpr:
	CallExpr(
		IntrinsicCall(name),
		VoidExpr(VoidType, SyntheticSourceLoc),
		args,
		typ,
		SyntheticSourceLoc,
	)


private pure func function_type(params: List[CoreType], result: CoreType) -> CoreType:
	FunctionType(True, params, result)


private pure func list_type(element: CoreType) -> CoreType:
	NamedType("List", [element])


private pure func stream_type(element: CoreType) -> CoreType:
	NamedType("Stream", [element])


private pure func option_type(payload: CoreType) -> CoreType:
	NamedType("Option", [payload])


private pure func tensor_type(element: CoreType, dims: List[Int]) -> CoreType:
	TensorType({
		element_type = element,
		dims = dims.map(func(dim): TensorStaticDim(dim)),
	})


private pure func collection_program() -> CoreProgram:
	{
		decls = [
			TypeAliasDecl({
				name = "Name",
				type_params = [],
				target = named_type("String"),
				is_opaque = False,
				loc = SyntheticSourceLoc,
			}),
			TypeAliasDecl({
				name = "Shade",
				type_params = [],
				target = named_type("Color"),
				is_opaque = False,
				loc = SyntheticSourceLoc,
			}),
			EnumDecl({
				name = "Color",
				type_params = [],
				variants = [
					{
						name = "Red",
						c_name = "Color_Red",
						tag = 0,
						def_id = None
					},
					{
						name = "Blue",
						c_name = "Color_Blue",
						tag = 1,
						def_id = None
					},
				],
				loc = SyntheticSourceLoc,
			}),
			ValueRecordDecl({
				name = "Pair",
				type_params = [],
				fields = [],
				loc = SyntheticSourceLoc,
			}),
			HeapRecordDecl({
				name = "Widget",
				type_params = [],
				fields = [],
				loc = SyntheticSourceLoc,
			}),
		],
		foreign_includes = []
	}


private pure func collection_layout() -> CoreSpecializeLayout:
	build_specialize_layout(collection_program())


private pure func specialized(expr: CoreExpr) -> CoreExpr:
	specialize_collection_expr(collection_layout(), expr)


private pure func is_int_literal(expr: CoreExpr, expected: Int) -> Bool:
	match expr:
		LiteralExpr(IntLiteral(value), _, _):
			value == expected
		_:
			False


private pure func call_name(expr: CoreExpr) -> Option[String]:
	match expr:
		CallExpr(BuiltinCall(name), _, _, _, _):
			Some(name)
		CallExpr(IntrinsicCall(name), _, _, _, _):
			Some(name)
		_:
			None


private pure func call_last_int_is(expr: CoreExpr, expected: Int) -> Bool:
	match expr:
		CallExpr(BuiltinCall(_), _, args, _, _):
			match args.last():
				Some(last):
					is_int_literal(last, expected)
				None:
					False
		_:
			False


private pure func contains_call(expr: CoreExpr, expected: String) -> Bool:
	if call_name(expr) == Some(expected):
		True
	else:
		var found: Bool = False

		for child in immediate_core_expr_children(expr):
			if contains_call(child, expected):
				found = True
				break

		found


private pure func contains_constructor_match(expr: CoreExpr) -> Bool:
	match expr:
		ConstructorMatchExpr(_, _, _, _, _, _):
			True
		_:
			var found: Bool = False

			for child in immediate_core_expr_children(expr):
				if contains_constructor_match(child):
					found = True
					break

			found


private pure func both_pointer_boxes(left: CoreExpr, right: CoreExpr) -> Bool:
	match (left, right):
		(BoxExpr(_, NamedType("Ptr", []), _), BoxExpr(_, NamedType("Ptr", []), _)):
			True
		_:
			False


private pure func dict_get_boxes_key(expr: CoreExpr) -> Bool:
	match expr:
		CallExpr(_, _, [_, BoxExpr(_, NamedType("Ptr", []), _)], _, _):
			True
		_:
			False


private pure func unfold_has_layouts(expr: CoreExpr, element: Int, state: Int) -> Bool:
	match expr:
		CallExpr(BuiltinCall("blorp_stream_unfold"), _, [BoxExpr(_, NamedType("Ptr", []), _), _, element_layout, state_layout], _, _):
			is_int_literal(element_layout, element) and is_int_literal(state_layout, state)
		_:
			False


private pure func stream_repeat_boxes_immediate(expr: CoreExpr) -> Bool:
	serialized: String = core_expr_to_json(expr).to_string()

	(
		serialized.contains("\"name\":\"blorp_stream_repeat\"")
		and serialized.contains("\"kind\":\"box\"")
		and serialized.contains("\"kind\":{\"kind\":\"prim\"}")
	)


private pure func unfold_has_trailing_layouts(expr: CoreExpr, element: Int, state: Int) -> Bool:
	match expr:
		CallExpr(BuiltinCall("blorp_stream_unfold"), _, [_, _, element_layout, state_layout], _, _):
			is_int_literal(element_layout, element) and is_int_literal(state_layout, state)
		_:
			False


private pure func fold_has_box_and_release(expr: CoreExpr) -> Bool:
	match expr:
		UnboxExpr(StructUnbox("Pair"), CallExpr(BuiltinCall("blorp_fold_parallel_with"), _, args, NamedType("Ptr", []), _), ValueRecordType("Pair"), _):
			match args:
				[_, BoxExpr(_, NamedType("Ptr", []), _), _, _, release_flag]:
					is_int_literal(release_flag, 1)
				_:
					False
		_:
			False


private pure func no_boxed_fold_initial_value(expr: CoreExpr) -> Bool:
	match expr:
		CallExpr(_, _, [_, LiteralExpr(_, _, _), _], _, _):
			True
		_:
			False


private pure func no_boxed_set_contains_value(expr: CoreExpr) -> Bool:
	match expr:
		CallExpr(_, _, [_, LiteralExpr(_, _, _)], _, _):
			True
		_:
			False


private pure func set_add_boxes_element(expr: CoreExpr) -> Bool:
	match expr:
		CallExpr(BuiltinCall("blorp_set_add"), _, [VarExpr(_, _, _), BoxExpr(_, NamedType("Ptr", []), _)], _, _):
			True
		_:
			False


private pure func set_add_refines_empty_constructor(expr: CoreExpr) -> Bool:
	match expr:
		CallExpr(_, _, args, _, _):
			match args.get(0):
				Some(CallExpr(kind, _, constructor_args, _, _)):
					match kind:
						BuiltinCall(name):
							name == "blorp_set_new" and constructor_args.is_empty()
						_:
							False
				_:
					False
		_:
			False


private pure func immediate_dict_insert_is_refined(expr: CoreExpr) -> Bool:
	match expr:
		CallExpr(BuiltinCall("blorp_dict_insert"), _, [CallExpr(BuiltinCall("blorp_dict_new"), _, [], NamedType("Dict", [NamedType("Shade", []), NamedType("Int", [])]), _), key, value], _, _):
			both_pointer_boxes(key, value)
		_:
			False


private pure func parallel_filter_map_fallback_shape(expr: CoreExpr) -> Bool:
	var found: Bool = False

	if contains_call(expr, "list_alloc"):
		found = (
			contains_call(expr, "list_set_owned")
			and contains_call(expr, "list_set_len")
			and contains_constructor_match(expr)
		)

	found


pure func test_list_alloc_uses_concrete_layout() -> Bool:
	result: CoreExpr = specialized(
		intrinsic(
			"list_alloc",
			[int_literal(4)],
			list_type(named_type("Int")),
		),
	)

	match result:
		ListAllocExpr(alloc, NamedType("List", [NamedType("Int", [])]), _):
			match alloc.layout:
				InlineListStorage(8):
					not alloc.elem_needs_release
				_:
					False
		_:
			False


pure func test_stale_pointer_cast_of_float_is_reboxed() -> Bool:
	float_type: CoreType = named_type("Float")

	match specialized(
		CastExpr(
			variable("value", float_type),
			named_type("Ptr"),
			SyntheticSourceLoc,
		),
	):
		BoxExpr(box, NamedType("Ptr", []), _):
			box.kind == FloatBox and box.source_type == float_type
		_:
			False


pure func test_list_alloc_alias_enum_uses_registry_layout() -> Bool:
	result: CoreExpr = specialized(
		call(
			"blorp_list_new",
			[int_literal(4)],
			list_type(named_type("Shade")),
		),
	)

	match result:
		ListAllocExpr(alloc, NamedType("List", [NamedType("Shade", [])]), _):
			match alloc.layout:
				InlineListStorage(1):
					not alloc.elem_needs_release
				_:
					False
		_:
			False


pure func test_erased_stack_result_metadata_is_canonicalized() -> Bool:
	result_type: CoreType = StackResultType(named_type("Int"), named_type("String"))
	list_result_type: CoreType = list_type(result_type)
	stale: CoreExpr = ListConstructExpr(
		{
			layout = InlineListStorage(8),
			elements = [
				{
					kind = PointerBox,
					value = variable("result", result_type),
					needs_release = False,
					transfers_ownership = False
				},
			],
			elem_needs_release = False
		},
		list_result_type,
		SyntheticSourceLoc,
	)

	match specialized(stale):
		ListConstructExpr(construct, _, _):
			match construct.elements:
				[boxed]:
					match boxed.kind:
						StructBox("blorp_StackResult"):
							boxed.needs_release
						_:
							False
				_:
					False
		_:
			False


pure func test_box_and_unbox_metadata_is_canonicalized() -> Bool:
	pair_type: CoreType = ValueRecordType("Pair")
	value: CoreExpr = variable("pair", pair_type)
	stale_box: CoreExpr = BoxExpr(
		{
			kind = PointerBox,
			value = value,
			source_type = pair_type
		},
		named_type("Ptr"),
		SyntheticSourceLoc,
	)
	stale_unbox: CoreExpr = UnboxExpr(
		PointerUnbox,
		variable("raw", named_type("Ptr")),
		pair_type,
		SyntheticSourceLoc,
	)

	match (specialized(stale_box), specialized(stale_unbox)):
		(BoxExpr(box, _, _), UnboxExpr(StructUnbox(unbox_type), _, _, _)):
			match box.kind:
				StructBox(box_type):
					box_type == "Pair" and unbox_type == "Pair"
				_:
					False
		_:
			False


pure func test_managed_void_slot_box_becomes_borrowed_cast() -> Bool:
	boxed: CoreExpr = BoxExpr(
		{
			kind = PointerBox,
			value = variable("text", named_type("String")),
			source_type = named_type("String")
		},
		named_type("Ptr"),
		SyntheticSourceLoc,
	)

	match specialized(boxed):
		CastExpr(VarExpr(variable, NamedType("String", []), _), NamedType("Ptr", []), _):
			variable.name == "text"
		_:
			False


pure func test_hash_container_constructor_dispatch() -> Bool:
	string_set: CoreExpr = call(
		"blorp_set_new",
		[],
		NamedType("Set", [named_type("String")]),
	)
	float_dict: CoreExpr = call(
		"blorp_dict_new",
		[],
		NamedType(
			"Dict",
			[named_type("Float"), named_type("Int")],
		),
	)
	alias_capacity: CoreExpr = call(
		"blorp_dict_with_capacity",
		[int_literal(8)],
		NamedType(
			"Dict",
			[named_type("Name"), named_type("Int")],
		),
	)
	record_dict: CoreExpr = call(
		"blorp_dict_new",
		[],
		NamedType(
			"Dict",
			[HeapRecordType("Widget"), named_type("Int")],
		),
	)

	(
		call_name(specialized(string_set)) == Some("blorp_set_new_string")
		and call_name(specialized(float_dict)) == Some("blorp_dict_new_float")
		and call_name(specialized(alias_capacity)) == Some("blorp_dict_with_capacity_string")
		and call_name(specialized(record_dict)) == Some("blorp_dict_new_custom")
	)


pure func test_immediate_dict_constructor_refinement_and_boxing() -> Bool:
	dict_type: CoreType = NamedType(
		"Dict",
		[named_type("Shade"), named_type("Int")],
	)
	dict_new: CoreExpr = call("blorp_dict_new", [], dict_type)
	result: CoreExpr = specialized(
		call(
			"blorp_dict_insert",
			[dict_new, variable("key", named_type("Shade")), int_literal(1)],
			dict_type,
		),
	)

	immediate_dict_insert_is_refined(result)


pure func test_set_add_boxes_only_the_element() -> Bool:
	set_type: CoreType = NamedType("Set", [named_type("Int")])

	set_add_boxes_element(
		specialized(
			call(
				"blorp_set_add",
				[variable("set", set_type), int_literal(1)],
				set_type,
			),
		),
	)


pure func test_set_add_refines_empty_constructor() -> Bool:
	set_type: CoreType = NamedType("Set", [named_type("Int")])

	set_add_refines_empty_constructor(
		specialized(
			call(
				"blorp_set_add",
				[call("blorp_set_new", [], set_type), int_literal(1)],
				set_type,
			),
		),
	)


pure func test_non_void_slot_collection_calls_remain_unboxed() -> Bool:
	set_type: CoreType = NamedType("Set", [named_type("Int")])
	list_int: CoreType = list_type(named_type("Int"))
	contains: CoreExpr = specialized(
		call(
			"blorp_set_contains",
			[variable("set", set_type), int_literal(1)],
			named_type("Bool"),
		),
	)
	fold: CoreExpr = specialized(
		call(
			"blorp_list_fold_left",
			[
				variable("items", list_int),
				int_literal(0),
				variable(
					"fold",
					function_type(
						[named_type("Int"), named_type("Int")],
						named_type("Int"),
					),
				),
			],
			named_type("Int"),
		),
	)

	no_boxed_set_contains_value(contains) and no_boxed_fold_initial_value(fold)


pure func test_dict_get_and_channel_receive_option_dispatch() -> Bool:
	dict_type: CoreType = NamedType(
		"Dict",
		[named_type("Int"), named_type("String")],
	)
	dict_get: CoreExpr = specialized(
		call(
			"blorp_dict_get",
			[variable("dict", dict_type), int_literal(1)],
			option_type(named_type("String")),
		),
	)
	channel_recv: CoreExpr = specialized(call("blorp_channel_recv", [variable(
					"channel",
					NamedType("Channel", [named_type("Int")]),
				)], option_type(named_type("Int"))))
	channel_timeout: CoreExpr = specialized(
		call(
			"blorp_channel_recv_timeout",
			[variable(
					"channel",
					NamedType("Channel", [named_type("String")]),
				), int_literal(5)],
			option_type(named_type("String")),
		),
	)

	(
		call_name(dict_get) == Some("blorp_dict_get_nullable")
		and call_name(channel_recv) == Some("blorp_channel_recv_int")
		and call_name(channel_timeout) == Some("blorp_channel_recv_timeout_nullable")
		and dict_get_boxes_key(dict_get)
	)


pure func test_already_specialized_dict_get_boxes_primitive_key() -> Bool:
	dict_type: CoreType = NamedType(
		"Dict",
		[named_type("Int"), named_type("String")],
	)
	dict_get: CoreExpr = specialized(
		call(
			"blorp_dict_get_nullable",
			[variable("dict", dict_type), int_literal(1)],
			option_type(named_type("String")),
		),
	)

	call_name(dict_get) == Some("blorp_dict_get_nullable") and dict_get_boxes_key(dict_get)


pure func test_nullable_managed_option_runtime_renames() -> Bool:
	getenv: CoreExpr = specialized(
		call(
			"blorp_getenv",
			[variable("name", named_type("String"))],
			option_type(named_type("String")),
		),
	)
	decode: CoreExpr = specialized(
		call(
			"blorp_decode_utf8",
			[variable("bytes", named_type("Bytes"))],
			option_type(list_type(named_type("Char"))),
		),
	)
	base64: CoreExpr = specialized(
		call(
			"blorp_base64_decode",
			[variable("text", named_type("String"))],
			option_type(named_type("String")),
		),
	)
	from_hex: CoreExpr = specialized(
		call(
			"blorp_bytes_from_hex",
			[variable("text", named_type("String"))],
			option_type(named_type("Bytes")),
		),
	)

	(
		call_name(getenv) == Some("blorp_getenv_nullable")
		and call_name(decode) == Some("blorp_decode_utf8_nullable")
		and call_name(base64) == Some("blorp_base64_decode_nullable")
		and call_name(from_hex) == Some("blorp_bytes_from_hex_nullable")
	)


pure func test_stream_repeat_map_and_unfold_layouts() -> Bool:
	repeat: CoreExpr = specialized(
		call(
			"blorp_stream_repeat",
			[variable("text", named_type("String"))],
			stream_type(named_type("String")),
		),
	)
	map: CoreExpr = specialized(
		call(
			"blorp_stream_map",
			[variable("stream", stream_type(named_type("Int"))), variable(
					"map",
					function_type([named_type("Int")], named_type("String")),
				)],
			stream_type(named_type("String")),
		),
	)
	unfold: CoreExpr = specialized(
		call(
			"blorp_stream_unfold",
			[int_literal(0), variable(
					"next",
					function_type(
						[named_type("Int")],
						option_type(TupleType([named_type("String"), named_type("Int")])),
					),
				)],
			stream_type(named_type("String")),
		),
	)

	call_last_int_is(repeat, 1) and call_last_int_is(map, 2) and unfold_has_layouts(unfold, 2, 0)


pure func test_stream_option_dispatch() -> Bool:
	filter_map: CoreExpr = specialized(
		call(
			"blorp_stream_filter_map",
			[variable("stream", stream_type(named_type("Int"))), variable(
					"filter_map",
					function_type([named_type("Int")], option_type(named_type("String"))),
				)],
			stream_type(named_type("String")),
		),
	)
	find: CoreExpr = specialized(
		call(
			"blorp_stream_find",
			[variable("stream", stream_type(named_type("Int"))), variable(
					"predicate",
					function_type([named_type("Int")], named_type("Bool")),
				)],
			option_type(named_type("Int")),
		),
	)
	fallible_find: CoreExpr = specialized(
		call(
			"blorp_fallible_stream_find_raw",
			[
				variable(
					"stream",
					NamedType(
						"FallibleStream",
						[named_type("String"), named_type("String")],
					),
				),
				variable(
					"predicate",
					function_type([named_type("String")], named_type("Bool")),
				),
			],
			StackResultType(
				option_type(named_type("String")),
				named_type("String"),
			),
		),
	)

	(
		call_name(filter_map) == Some("blorp_stream_filter_map_nullable")
		and call_name(find) == Some("blorp_stream_find_int")
		and call_name(fallible_find) == Some("blorp_fallible_stream_find_raw_nullable")
	)


pure func test_stream_scalar_and_managed_state_layouts() -> Bool:
	repeat: CoreExpr = specialized(
		call(
			"blorp_stream_repeat",
			[int_literal(7)],
			stream_type(named_type("Int")),
		),
	)
	map: CoreExpr = specialized(
		call(
			"blorp_stream_map",
			[variable("stream", stream_type(named_type("String"))), variable(
					"map",
					function_type([named_type("String")], named_type("Int")),
				)],
			stream_type(named_type("Int")),
		),
	)
	unfold: CoreExpr = specialized(
		call(
			"blorp_stream_unfold",
			[variable("state", named_type("String")), variable(
					"next",
					function_type(
						[named_type("String")],
						option_type(TupleType([named_type("String"), named_type("String")])),
					),
				)],
			stream_type(named_type("String")),
		),
	)

	(
		stream_repeat_boxes_immediate(repeat)
		and call_last_int_is(repeat, 0)
		and call_last_int_is(map, 0)
		and unfold_has_trailing_layouts(unfold, 2, 2)
	)


pure func test_parallel_filter_map_dispatch_and_fallback() -> Bool:
	list_int: CoreType = list_type(named_type("Int"))
	direct: CoreExpr = specialized(
		call(
			"blorp_filter_map_parallel",
			[variable("items", list_int), variable(
					"map",
					function_type([named_type("Int")], option_type(named_type("String"))),
				)],
			list_type(named_type("String")),
		),
	)
	fallback: CoreExpr = specialized(
		call(
			"blorp_filter_map_parallel",
			[variable("items", list_int), variable(
					"map",
					function_type([named_type("Int")], option_type(ValueRecordType("Pair"))),
				)],
			list_type(ValueRecordType("Pair")),
		),
	)

	(
		call_name(direct) == Some("blorp_filter_map_parallel_nullable")
		and call_last_int_is(direct, 1)
		and parallel_filter_map_fallback_shape(fallback)
	)


pure func test_collection_map_release_metadata() -> Bool:
	pair: CoreType = ValueRecordType("Pair")
	list_map: CoreExpr = specialized(
		call(
			"blorp_map_parallel",
			[variable("items", list_type(named_type("Int"))), variable(
					"map",
					function_type([named_type("Int")], pair),
				)],
			list_type(pair),
		),
	)
	vector_map: CoreExpr = specialized(
		call(
			"blorp_vector_map",
			[variable(
					"items",
					tensor_type(named_type("Int"), [4]),
				), variable(
					"map",
					function_type([named_type("Int")], pair),
				)],
			tensor_type(
				pair,
				[4],
			),
		),
	)
	matrix_zip: CoreExpr = specialized(
		call(
			"blorp_matrix_zip_map",
			[
				variable(
					"left",
					tensor_type(
						named_type("Float"),
						[2, 3],
					),
				),
				variable(
					"right",
					tensor_type(
						named_type("Float"),
						[2, 3],
					),
				),
				variable(
					"zip",
					function_type(
						[named_type("Float"), named_type("Float")],
						named_type("Float"),
					),
				),
			],
			tensor_type(
				named_type("Float"),
				[2, 3],
			),
		),
	)

	(
		call_last_int_is(list_map, 1)
		and call_last_int_is(vector_map, 1)
		and call_last_int_is(matrix_zip, 0)
	)


pure func test_fold_release_metadata_and_raw_result() -> Bool:
	fold: CoreExpr = specialized(
		call(
			"blorp_fold_parallel_with",
			[
				variable("items", list_type(named_type("Int"))),
				variable("init", ValueRecordType("Pair")),
				variable(
					"fold",
					function_type(
						[ValueRecordType("Pair"), named_type("Int")],
						ValueRecordType("Pair"),
					),
				),
				int_literal(2),
			],
			ValueRecordType("Pair"),
		),
	)
	fallible: CoreExpr = specialized(
		call(
			"blorp_fallible_stream_fold_raw",
			[
				variable(
					"stream",
					NamedType(
						"FallibleStream",
						[named_type("Int"), named_type("String")],
					),
				),
				int_literal(0),
				variable(
					"fold",
					function_type(
						[named_type("Int"), named_type("Int")],
						StackResultType(
							named_type("Int"),
							named_type("String"),
						),
					),
				),
			],
			StackResultType(
				named_type("Int"),
				named_type("String"),
			),
		),
	)

	fold_has_box_and_release(fold) and call_last_int_is(fallible, 0)


tests: TestSuite = {
	description = "Blorp compiler collection and stream specialization",
	tests = [
		("list allocation uses concrete layout", test_list_alloc_uses_concrete_layout),
		("stale pointer cast of Float is reboxed", test_stale_pointer_cast_of_float_is_reboxed),
		(
			"list allocation alias enum uses registry layout",
			test_list_alloc_alias_enum_uses_registry_layout,
		),
		(
			"erased stack Result metadata is canonicalized",
			test_erased_stack_result_metadata_is_canonicalized,
		),
		("box and unbox metadata is canonicalized", test_box_and_unbox_metadata_is_canonicalized),
		(
			"managed void-slot box becomes a borrowed cast",
			test_managed_void_slot_box_becomes_borrowed_cast,
		),
		("hash container constructor dispatch", test_hash_container_constructor_dispatch),
		(
			"immediate dict constructor refinement and boxing",
			test_immediate_dict_constructor_refinement_and_boxing,
		),
		("set add boxes only the element", test_set_add_boxes_only_the_element),
		("set add refines empty constructor", test_set_add_refines_empty_constructor),
		(
			"non-void-slot collection calls remain unboxed",
			test_non_void_slot_collection_calls_remain_unboxed,
		),
		(
			"dict get and Channel receive Option dispatch",
			test_dict_get_and_channel_receive_option_dispatch,
		),
		(
			"already-specialized dict get boxes primitive key",
			test_already_specialized_dict_get_boxes_primitive_key,
		),
		("nullable managed Option runtime renames", test_nullable_managed_option_runtime_renames),
		("stream repeat, map, and unfold layouts", test_stream_repeat_map_and_unfold_layouts),
		("stream scalar and managed-state layouts", test_stream_scalar_and_managed_state_layouts),
		("stream Option dispatch", test_stream_option_dispatch),
		(
			"parallel filter-map dispatch and fallback",
			test_parallel_filter_map_dispatch_and_fallback,
		),
		("collection map release metadata", test_collection_map_release_metadata),
		("fold release metadata and raw result", test_fold_release_metadata_and_raw_result),
	]
}
