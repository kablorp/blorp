		None:
			False
		Some(running):
			match handled_transition(running, DID_SAVE_UNOPENED_BODY):
				None:
					False
				Some(saved):
					match handled_transition(saved.state, DID_CLOSE_UNOPENED_BODY):
						None:
							False
						Some(closed):
							(
								saved.action == LifecycleContinue
								and closed.action == LifecycleContinue
								and server_find_document(
									closed.state,
									document_uri("file:///workspace/other.brp"),
								) == None
							)


func test_running_did_close_removes_overlay_and_allows_reopen() -> Bool:
	match running_server_state():
		None:
			False
		Some(running):
			match handled_transition(running, DID_OPEN_BODY):
				None:
					False
				Some(opened):
					match handled_transition(opened.state, DID_CLOSE_BODY):
						None:
							False
						Some(closed):
							removed: Bool = server_find_document(
								closed.state,
								document_uri("file:///workspace/main.brp"),
							) == None

							match handled_transition(closed.state, DID_OPEN_REPLACEMENT_BODY):
								None:
									False
								Some(reopened):
									match server_find_document(
										reopened.state,
										document_uri("file:///workspace/main.brp"),
									):
										Some(document):
											(
												closed.action == LifecycleContinue
												and removed
												and document.document.text == "replacement"
												and document_version_value(
													document.document.version,
												) == 99
											)
										None:
											False


func test_save_and_close_requests_return_errors_and_preserve_overlay() -> Bool:
	match running_server_state():
		None:
			False
		Some(running):
			match handled_transition(running, DID_OPEN_BODY):
				None:
					False
				Some(opened):
					match handled_transition(opened.state, DID_SAVE_REQUEST_BODY):
						None:
							False
						Some(save_request):
							save_response_ok: Bool = match save_request.action:
								LifecycleRespond(body):
									(
										response_error_code(body) == Some(-32600.0)
										and response_integer_id(body) == Some(48)
									)
								_:
									False

							match handled_transition(save_request.state, DID_CLOSE_REQUEST_BODY):
								None:
									False
								Some(close_request):
									close_response_ok: Bool = match close_request.action:
										LifecycleRespond(body):
											(
												response_error_code(body) == Some(-32600.0)
												and response_integer_id(body) == Some(49)
											)
										_:
											False

									state_ok: Bool = match server_find_document(
										close_request.state,
										document_uri("file:///workspace/main.brp"),
									):
										Some(document):
											document.document.text == "original"
										None:
											False

									save_response_ok and close_response_ok and state_ok


func test_invalid_save_and_close_notifications_preserve_overlay() -> Bool:
	match running_server_state():
		None:
			False
		Some(running):
			match handled_transition(running, DID_OPEN_BODY):
				None:
					False
				Some(opened):
					match handled_transition(opened.state, DID_SAVE_INVALID_BODY):
						None:
							False
						Some(invalid_save):
							match handled_transition(invalid_save.state, DID_CLOSE_INVALID_BODY):
								None:
									False
								Some(invalid_close):
									match server_find_document(
										invalid_close.state,
										document_uri("file:///workspace/main.brp"),
									):
										Some(document):
											(
												invalid_save.action == LifecycleContinue
												and invalid_close.action == LifecycleContinue
												and document.document.text == "original"
											)
										None:
											False


func test_unknown_running_method_preserves_validated_envelope() -> Bool:
	match running_server_state():
		None:
			False
		Some(running):
			match handled_transition(running, DID_OPEN_BODY):
				None:
					False
				Some(opened):
					match dispatch_lsp_server_body(opened.state, HOVER_BODY):
						ServerUnhandled(state, envelope):
							document_preserved: Bool = match server_find_document(
								state,
								document_uri("file:///workspace/main.brp"),
							):
								Some(document):
									document.document.text == "original"
								None:
									False

							json_rpc_method(envelope) == "textDocument/hover" and document_preserved
						ServerHandled(_):
							False


func test_shutdown_and_ignored_notification_preserve_overlay() -> Bool:
	match running_server_state():
		None:
			False
		Some(running):
			match handled_transition(running, DID_OPEN_BODY):
				None:
					False
				Some(opened):
					match handled_transition(opened.state, SHUTDOWN_BODY):
						None:
							False
						Some(shutdown):
							match handled_transition(shutdown.state, DID_OPEN_REPLACEMENT_BODY):
								None:
									False
								Some(ignored):
									match server_find_document(
										ignored.state,
										document_uri("file:///workspace/main.brp"),
									):
										Some(document):
											(
												ignored.action == LifecycleContinue
												and document.document.text == "original"
											)
										None:
											False


tests: TestSuite = {
	description = "Blorp LSP server dispatch",
	tests = [
		("schedule versioned analysis on didOpen", test_did_open_schedules_versioned_analysis_work),
		("advance analysis revision on didChange", test_did_change_advances_analysis_revision),
		("schedule no analysis for stale didChange", test_stale_change_schedules_no_analysis_work),
		("schedule diagnostic clearing on didClose", test_did_close_schedules_diagnostic_clear),
		("reject diagnostic clearing after reopen", test_diagnostic_clear_is_rejected_after_reopen),
		(
			"retain diagnostic clearing across unrelated activity",
			test_diagnostic_clear_survives_unrelated_document_activity,
		),
		(
			"reject diagnostic clearing after shutdown",
			test_diagnostic_clear_is_rejected_after_shutdown,
		),
		(
			"reject diagnostic completion after change",
			test_diagnostic_completion_is_rejected_after_change,
		),
		(
			"respect versioned diagnostic capability",
			test_diagnostic_publication_uses_client_version_capability,
		),
		("route running didOpen", test_running_did_open_updates_canonical_server_state),
		(
			"preserve overlay on duplicate didOpen",
			test_duplicate_did_open_preserves_original_server_overlay,
		),
		("respond to didOpen request form", test_did_open_request_returns_required_error_response),
		("gate didOpen before initialize", test_did_open_before_initialize_does_not_create_overlay),
		("route running didChange", test_running_did_change_updates_canonical_server_state),
		("ignore unopened didChange", test_unopened_did_change_preserves_empty_store),
		(
			"distinguish version-only change from empty text",
			test_empty_did_change_events_preserve_text_and_advance_version,
		),
		(
			"preserve overlay on stale and invalid didChange",
			test_stale_and_invalid_did_change_preserve_overlay,
		),
		(
			"respond to didChange request form",
			test_did_change_request_returns_error_and_preserves_overlay,
		),
		("route running didSave", test_running_did_save_preserves_newer_versioned_overlay),
		(
			"ignore unopened didSave and didClose",
			test_unopened_did_save_and_did_close_preserve_empty_store,
		),
		(
			"remove overlay and allow reopen",
			test_running_did_close_removes_overlay_and_allows_reopen,
		),
		(
			"respond to didSave and didClose request forms",
			test_save_and_close_requests_return_errors_and_preserve_overlay,
		),
		(
			"preserve overlay on invalid didSave and didClose",
			test_invalid_save_and_close_notifications_preserve_overlay,
		),
		(
			"preserve unknown running envelope",
			test_unknown_running_method_preserves_validated_envelope,
		),
		(
			"preserve overlay through shutdown",
			test_shutdown_and_ignored_notification_preserve_overlay,
		),
	]
}
