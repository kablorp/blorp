									)
								_:
									False

							state_ok: Bool = match server_find_document(
								rejected.state,
								document_uri("file:///workspace/main.brp"),
							):
								Some(document):
									document.document.text == "original"
								None:
									False

							response_ok and state_ok


func test_running_did_save_preserves_newer_versioned_overlay() -> Bool:
	match running_server_state():
		None:
			False
		Some(running):
			match handled_transition(running, DID_OPEN_BODY):
				None:
					False
				Some(opened):
					match handled_transition(opened.state, DID_CHANGE_BODY):
						None:
							False
						Some(changed):
							match handled_transition(changed.state, DID_SAVE_BODY):
								None:
									False
								Some(saved):
									match handled_transition(
										saved.state,
										DID_SAVE_WITHOUT_TEXT_BODY,
									):
										None:
											False
										Some(saved_without_text):
											match server_find_document(
												saved_without_text.state,
												document_uri("file:///workspace/main.brp"),
											):
												Some(document):
													(
														saved.action == LifecycleContinue
														and saved_without_text.action == LifecycleContinue
														and document.language_id == "blorp"
														and document.document.text == "changed"
														and document_version_value(
															document.document.version,
														) == 13
													)
												None:
													False


func test_unopened_did_save_and_did_close_preserve_empty_store() -> Bool:
