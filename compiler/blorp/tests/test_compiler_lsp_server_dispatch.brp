func test_empty_did_change_events_preserve_text_and_advance_version() -> Bool:
	match running_server_state():
		None:
			False
		Some(running):
			match handled_transition(running, DID_OPEN_BODY):
				None:
					False
				Some(opened):
					match handled_transition(opened.state, DID_CHANGE_VERSION_ONLY_BODY):
						None:
							False
						Some(version_only):
							match handled_transition(
								version_only.state,
								DID_CHANGE_EMPTY_TEXT_BODY,
							):
								None:
									False
								Some(cleared):
									match server_find_document(
										version_only.state,
										document_uri("file:///workspace/main.brp"),
									):
										None:
											False
										Some(version_only_document):
											match server_find_document(
												cleared.state,
												document_uri("file:///workspace/main.brp"),
											):
												Some(cleared_document):
													(
														version_only_document.language_id == "blorp"
														and version_only_document.document.text == "original"
														and document_version_value(
															version_only_document.document.version,
														) == 13
														and cleared_document.language_id == "blorp"
														and cleared_document.document.text == ""
														and document_version_value(
															cleared_document.document.version,
														) == 14
													)
												None:
													False


func test_stale_and_invalid_did_change_preserve_overlay() -> Bool:
