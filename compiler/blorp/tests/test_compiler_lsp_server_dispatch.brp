						None:
							False
						Some(stale):
							match handled_transition(stale.state, DID_CHANGE_INVALID_BODY):
								None:
									False
								Some(invalid):
									match server_find_document(
										invalid.state,
										document_uri("file:///workspace/main.brp"),
									):
										Some(document):
											(
												stale.action == LifecycleContinue
												and invalid.action == LifecycleContinue
												and document.document.text == "original"
												and document_version_value(
													document.document.version,
												) == 12
											)
										None:
											False


func test_did_change_request_returns_error_and_preserves_overlay() -> Bool:
	match running_server_state():
		None:
			False
		Some(running):
			match handled_transition(running, DID_OPEN_BODY):
				None:
					False
				Some(opened):
					match handled_transition(opened.state, DID_CHANGE_REQUEST_BODY):
						None:
							False
						Some(rejected):
							response_ok: Bool = match rejected.action:
								LifecycleRespond(body):
									(
										response_error_code(body) == Some(-32600.0)
