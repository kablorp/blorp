func test_did_open_request_returns_required_error_response() -> Bool:
	match running_server_state():
		None:
			False
		Some(running):
			match handled_transition(running, DID_OPEN_BODY):
				None:
					False
				Some(opened):
					match handled_transition(opened.state, DID_OPEN_REQUEST_BODY):
						Some(transition):
							response_ok: Bool = match transition.action:
								LifecycleRespond(body):
									(
										response_error_code(body) == Some(-32600.0)
										and response_integer_id(body) == Some(44)
									)
								_:
									False

							state_ok: Bool = match server_find_document(
								transition.state,
								document_uri("file:///workspace/main.brp"),
							):
								Some(document):
									document.document.text == "original"
								None:
									False

							response_ok and state_ok
						None:
							False


