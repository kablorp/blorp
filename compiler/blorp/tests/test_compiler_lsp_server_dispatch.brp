import:
	../src/stage_12_lsp/diagnostic_model: DiagnosticClearRequest, DiagnosticPublication
	../src/stage_12_lsp/document_model: document_version_value
	../src/stage_12_lsp/identity: document_uri
	../src/stage_12_lsp/json_rpc: json_rpc_method
	../src/stage_12_lsp/lifecycle_dispatch: LifecycleAction(LifecycleContinue, LifecycleRespond)
	../src/stage_12_lsp/server_dispatch:
		ServerDispatch(ServerHandled, ServerUnhandled),
		ServerState,
		ServerTransition,
		dispatch_lsp_server_body,
		server_accept_diagnostic_publication,
		server_encode_diagnostic_clear,
		server_encode_diagnostic_publication,
		server_find_document,
		server_state,
	../src/stage_12_lsp/server_work:
		DocumentAnalysisRequest,
		ServerWork(AnalyzeDocument, ClearDocumentDiagnostics),
		document_analysis_document,
		document_analysis_identity,
	../src/stage_12_lsp/snapshot_model: configuration_epoch_value, workspace_revision_value
	json: as_number, get_field, parse_json
	test: TestSuite


private INITIALIZE_BODY: String =
	|{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"processId":null,"capabilities":{}}}

private INITIALIZE_VERSIONED_DIAGNOSTICS_BODY: String =
	|{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"processId":null,"capabilities":{"textDocument":{"publishDiagnostics":{"versionSupport":true}}}}}

private INITIALIZED_BODY: String =
	|{"jsonrpc":"2.0","method":"initialized","params":{}}

private DID_OPEN_BODY: String =
	|{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///workspace/main.brp","languageId":"blorp","version":12,"text":"original"}}}

private DID_OPEN_REPLACEMENT_BODY: String =
	|{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///workspace/main.brp","languageId":"blorp","version":99,"text":"replacement"}}}

private DID_OPEN_OTHER_BODY: String =
	|{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///workspace/other.brp","languageId":"blorp","version":1,"text":"other"}}}

private DID_OPEN_REQUEST_BODY: String =
	|{"jsonrpc":"2.0","id":44,"method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///workspace/main.brp","languageId":"blorp","version":12,"text":"original"}}}

private DID_CHANGE_BODY: String =
	|{"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"file:///workspace/main.brp","version":13},"contentChanges":[{"text":"changed"}]}}

private DID_CHANGE_STALE_BODY: String =
	|{"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"file:///workspace/main.brp","version":11},"contentChanges":[{"text":"stale"}]}}

private DID_CHANGE_UNOPENED_BODY: String =
	|{"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"file:///workspace/other.brp","version":2},"contentChanges":[{"text":"unopened"}]}}

private DID_CHANGE_VERSION_ONLY_BODY: String =
	|{"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"file:///workspace/main.brp","version":13},"contentChanges":[]}}

private DID_CHANGE_EMPTY_TEXT_BODY: String =
	|{"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"file:///workspace/main.brp","version":14},"contentChanges":[{"text":""}]}}

private DID_CHANGE_INVALID_BODY: String =
	|{"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"file:///workspace/main.brp","version":13},"contentChanges":[{"text":"partial mutation must not land"},{"range":{"start":{"line":0,"character":0},"end":{"line":0,"character":0}},"text":"x"}]}}

private DID_CHANGE_REQUEST_BODY: String =
	|{"jsonrpc":"2.0","id":47,"method":"textDocument/didChange","params":{"textDocument":{"uri":"file:///workspace/main.brp","version":13},"contentChanges":[{"text":"changed"}]}}

private DID_SAVE_BODY: String =
	|{"jsonrpc":"2.0","method":"textDocument/didSave","params":{"textDocument":{"uri":"file:///workspace/main.brp"},"text":"stale saved text"}}

private DID_SAVE_WITHOUT_TEXT_BODY: String =
	|{"jsonrpc":"2.0","method":"textDocument/didSave","params":{"textDocument":{"uri":"file:///workspace/main.brp"}}}

private DID_SAVE_UNOPENED_BODY: String =
	|{"jsonrpc":"2.0","method":"textDocument/didSave","params":{"textDocument":{"uri":"file:///workspace/other.brp"},"text":"unopened"}}

private DID_SAVE_REQUEST_BODY: String =
	|{"jsonrpc":"2.0","id":48,"method":"textDocument/didSave","params":{"textDocument":{"uri":"file:///workspace/main.brp"},"text":"request text"}}

private DID_SAVE_INVALID_BODY: String =
	|{"jsonrpc":"2.0","method":"textDocument/didSave","params":{"textDocument":{"uri":"file:///workspace/main.brp"},"text":null}}

private DID_CLOSE_BODY: String =
	|{"jsonrpc":"2.0","method":"textDocument/didClose","params":{"textDocument":{"uri":"file:///workspace/main.brp"}}}

private DID_CLOSE_UNOPENED_BODY: String =
	|{"jsonrpc":"2.0","method":"textDocument/didClose","params":{"textDocument":{"uri":"file:///workspace/other.brp"}}}

private DID_CLOSE_REQUEST_BODY: String =
	|{"jsonrpc":"2.0","id":49,"method":"textDocument/didClose","params":{"textDocument":{"uri":"file:///workspace/main.brp"}}}

private DID_CLOSE_INVALID_BODY: String =
	|{"jsonrpc":"2.0","method":"textDocument/didClose","params":{"textDocument":false}}

private HOVER_BODY: String =
	|{"jsonrpc":"2.0","id":45,"method":"textDocument/hover","params":{}}

private SHUTDOWN_BODY: String =
	|{"jsonrpc":"2.0","id":46,"method":"shutdown","params":null}


private pure func handled_transition(state: ServerState, body: String) -> Option[ServerTransition]:
	match dispatch_lsp_server_body(state, body):
		ServerHandled(transition):
			Some(transition)
		ServerUnhandled(_, _):
			None


private pure func running_server_state() -> Option[ServerState]:
	initialized ?= handled_transition(server_state(), INITIALIZE_BODY)
	running ?= handled_transition(initialized.state, INITIALIZED_BODY)
	Some(running.state)


private pure func versioned_diagnostics_server_state() -> Option[ServerState]:
	initialized ?= handled_transition(server_state(), INITIALIZE_VERSIONED_DIAGNOSTICS_BODY)
	running ?= handled_transition(initialized.state, INITIALIZED_BODY)
	Some(running.state)


private pure func response_error_code(body: String) -> Option[Float]:
	value ?= match parse_json(body):
		Ok(value):
			Some(value)
		Err(_):
			None

	error ?= get_field(value, "error")
	code ?= get_field(error, "code")
	code.as_number()


private pure func response_integer_id(body: String) -> Option[Int]:
	value ?= match parse_json(body):
		Ok(value):
			Some(value)
		Err(_):
			None

	id ?= get_field(value, "id")
	number ?= id.as_number()
	Some(to_int(number))


private pure func published_diagnostic_version(body: String) -> Option[Float]:
	value ?= match parse_json(body):
		Ok(value):
			Some(value)
		Err(_):
			None

	params ?= get_field(value, "params")
	version ?= get_field(params, "version")
	version.as_number()


private pure func first_analysis_work(
	transition: ServerTransition,
) -> Option[DocumentAnalysisRequest]:
	match transition.work.get(0):
		Some(AnalyzeDocument(request)):
			Some(request)
		_:
			None


private pure func first_diagnostic_clear_work(
	transition: ServerTransition,
) -> Option[DiagnosticClearRequest]:
	match transition.work.get(0):
		Some(ClearDocumentDiagnostics(request)):
			Some(request)
		_:
			None


func test_did_open_schedules_versioned_analysis_work() -> Bool:
	match running_server_state():
		None:
			False
		Some(running):
			match handled_transition(running, DID_OPEN_BODY):
				None:
					False
				Some(opened):
					match first_analysis_work(opened):
						None:
							False
						Some(request):
							document = document_analysis_document(request)
							identity = document_analysis_identity(request)

							(
								document.text == "original"
								and document_version_value(document.version) == 12
								and identity.uri == document.uri
								and workspace_revision_value(identity.workspace_revision) == 1
								and configuration_epoch_value(identity.configuration_epoch) == 0
							)


func test_did_change_advances_analysis_revision() -> Bool:
	match running_server_state():
		None:
			False
		Some(running):
			match handled_transition(running, DID_OPEN_BODY):
				None:
					False
				Some(opened):
					match handled_transition(opened.state, DID_CHANGE_BODY):
						None:
							False
						Some(changed):
							match first_analysis_work(changed):
								None:
									False
								Some(request):
									document = document_analysis_document(request)
									identity = document_analysis_identity(request)

									(
										document.text == "changed"
										and document_version_value(document.version) == 13
										and workspace_revision_value(
											identity.workspace_revision,
										) == 2
									)


func test_stale_change_schedules_no_analysis_work() -> Bool:
	match running_server_state():
		None:
			False
		Some(running):
			match handled_transition(running, DID_OPEN_BODY):
				None:
					False
				Some(opened):
					match handled_transition(opened.state, DID_CHANGE_STALE_BODY):
						Some(stale):
							stale.work.is_empty()
						None:
							False


func test_did_close_schedules_diagnostic_clear() -> Bool:
	expected_uri = document_uri("file:///workspace/main.brp")

	match running_server_state():
		None:
			False
		Some(running):
			match handled_transition(running, DID_OPEN_BODY):
				None:
					False
				Some(opened):
					match handled_transition(opened.state, DID_CLOSE_BODY):
						Some(closed):
							match first_diagnostic_clear_work(closed):
								Some(identity):
									identity.uri == expected_uri
								None:
									False
						None:
							False


func test_diagnostic_clear_is_rejected_after_reopen() -> Bool:
	match running_server_state():
		None:
			False
		Some(running):
			match handled_transition(running, DID_OPEN_BODY):
				None:
					False
				Some(opened):
					match handled_transition(opened.state, DID_CLOSE_BODY):
						None:
							False
						Some(closed):
							match first_diagnostic_clear_work(closed):
								None:
									False
								Some(identity):
									encoded_while_closed = server_encode_diagnostic_clear(
										closed.state,
										identity,
									).is_some()

									match handled_transition(closed.state, DID_OPEN_BODY):
										None:
											False
										Some(reopened):
											(
												encoded_while_closed
												and server_encode_diagnostic_clear(
													reopened.state,
													identity,
												) == None
											)


func test_diagnostic_clear_survives_unrelated_document_activity() -> Bool:
	match running_server_state():
		None:
			False
		Some(running):
			match handled_transition(running, DID_OPEN_BODY):
				None:
					False
				Some(opened):
					match handled_transition(opened.state, DID_CLOSE_BODY):
						None:
							False
						Some(closed):
							match first_diagnostic_clear_work(closed):
								None:
									False
								Some(identity):
									match handled_transition(closed.state, DID_OPEN_OTHER_BODY):
										None:
											False
										Some(other_opened):
											server_encode_diagnostic_clear(
												other_opened.state,
												identity,
											).is_some()


func test_diagnostic_clear_is_rejected_after_shutdown() -> Bool:
	match running_server_state():
		None:
			False
		Some(running):
			match handled_transition(running, DID_OPEN_BODY):
				None:
					False
				Some(opened):
					match handled_transition(opened.state, DID_CLOSE_BODY):
						None:
							False
						Some(closed):
							match first_diagnostic_clear_work(closed):
								None:
									False
								Some(identity):
									match handled_transition(closed.state, SHUTDOWN_BODY):
										None:
											False
										Some(shutdown):
											server_encode_diagnostic_clear(
												shutdown.state,
												identity,
											) == None


func test_diagnostic_completion_is_rejected_after_change() -> Bool:
	match running_server_state():
		None:
			False
		Some(running):
			match handled_transition(running, DID_OPEN_BODY):
				None:
					False
				Some(opened):
					match first_analysis_work(opened):
						None:
							False
						Some(request):
							publication: DiagnosticPublication = {
								identity = document_analysis_identity(request),
								diagnostics = []
							}

							accepted_before_change: Bool = match server_accept_diagnostic_publication(
								opened.state,
								publication,
							):
								Some(_):
									True
								None:
									False

							match handled_transition(opened.state, DID_CHANGE_BODY):
								Some(changed):
									(
										accepted_before_change
										and server_accept_diagnostic_publication(
											changed.state,
											publication,
										) == None
									)
								None:
									False


func test_diagnostic_publication_uses_client_version_capability() -> Bool:
	match versioned_diagnostics_server_state():
		None:
			False
		Some(running):
			match handled_transition(running, DID_OPEN_BODY):
				None:
					False
				Some(opened):
					match first_analysis_work(opened):
						None:
							False
						Some(request):
							publication: DiagnosticPublication = {
								identity = document_analysis_identity(request),
								diagnostics = []
							}

							match server_encode_diagnostic_publication(opened.state, publication):
								Some(body):
									published_diagnostic_version(body) == Some(12.0)
								None:
									False


func test_running_did_open_updates_canonical_server_state() -> Bool:
	match running_server_state():
		None:
			False
		Some(running):
			match handled_transition(running, DID_OPEN_BODY):
				None:
					False
				Some(opened):
					match server_find_document(
						opened.state,
						document_uri("file:///workspace/main.brp"),
					):
						Some(document):
							(
								opened.action == LifecycleContinue
								and document.document.text == "original"
								and document_version_value(document.document.version) == 12
							)
						None:
							False


