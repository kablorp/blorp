			(
				parsed_program_ok(program)
				and trait_decl.name.text == "Hashable"
				and trait_decl.supertraits.length() == 2
				and trait_decl.methods.length() == 0
			)
		_:
			False


func test_parse_empty_trait_reports_error() -> Bool:
	program_source: String = "trait Empty:"
	program = parse_compiler_source(source(program_source))

	parsed_program_has_errors(program) and program.diagnostics.length() > 0


func test_parse_impl_declaration() -> Bool:
	program_source: String = "record Point {x: Int, y: Int}\n\nimplements Stringable for Point:\n\tpure func to_string(p: Point) -> String:\n\t\t\"point\""
	program = parse_compiler_source(source(program_source))

	match program.decls.get(1):
		Some(ImplParsedDecl(impl_decl)):
			for_type_ok: Bool = match impl_decl.for_type:
				ParsedNamedType(name, args, _):
					name.text == "Point" and args.length() == 0
				_:
					False

			method_ok: Bool = match impl_decl.methods.get(0):
				Some(method_decl):
					match method_decl.body:
						Some(_):
							method_decl.name.text == "to_string" and method_decl.is_pure
						None:
							False
				None:
					False

			ok: Bool = (
				parsed_program_ok(program)
				and impl_decl.trait_name.text == "Stringable"
				and impl_decl.methods.length() == 1
				and for_type_ok
				and method_ok
			)

			ok
		_:
			False


func test_parse_multiline_call_args_in_impl_before_next_impl() -> Bool:
	program_source: String = "implements Stringable for BBox:\n\tpure func to_string(bb: BBox) -> String:\n\t\t\"BBox(\" + to_string(\n\t\t\tbb.min_lon,\n\t\t) + \", \" + to_string(\n\t\t\tbb.min_lat,\n\t\t) + \")\"\n\nimplements Equatable for BBox:\n\tpure func equals(a: BBox, b: BBox) -> Bool:\n\t\tTrue"
	program = parse_compiler_source(source(program_source))

	second_impl_ok: Bool = match program.decls.get(1):
		Some(ImplParsedDecl(impl_decl)):
			impl_decl.trait_name.text == "Equatable" and impl_decl.methods.length() == 1
		_:
			False

	parsed_program_ok(program) and program.decls.length() == 2 and second_impl_ok


func test_parse_leading_dot_impl_method_before_docstring() -> Bool:
	program_source: String = "implements Stringable for Port:\n\tpure func to_string(value: Port) -> String:\n\t\tvalue\n\t\t\t.port_value()\n\t\t\t.to_string()\n\n---\nReturn the local port.\n---\nfunc local_port(value: Port) -> Int:\n\t1"
	program = parse_compiler_source(source(program_source))

	function_ok: Bool = match program.decls.get(1):
		Some(FunctionParsedDecl(function_decl)):
			function_decl.name.text == "local_port"
		_:
			False

	parsed_program_ok(program) and program.decls.length() == 2 and function_ok


func test_parse_private_trait_declaration() -> Bool:
	program_source: String = "private trait FileClosable:\n\tpure func close(handle: Self) -> Int"
	program = parse_compiler_source(source(program_source))

