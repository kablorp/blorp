func test_parse_binary_operator_precedence() -> Bool:
	program = parse_compiler_source(
		source("func compute(a: Int, b: Int, c: Int) -> Int: a + b * c - 2"),
	)

	match program.decls.get(0):
		Some(FunctionParsedDecl(function_decl)):
			match function_decl.body:
				Some(ParsedBinaryExpr(ParsedSubtractOp, left, right, _)):
					left_ok: Bool = match left:
						ParsedBinaryExpr(ParsedAddOp, add_left, add_right, _):
							add_left_ok: Bool = match add_left:
								ParsedNameExpr(identifier):
									identifier.text == "a"
								_:
									False

							add_right_ok: Bool = match add_right:
								ParsedBinaryExpr(ParsedMultiplyOp, mul_left, mul_right, _):
									mul_left_ok: Bool = match mul_left:
										ParsedNameExpr(identifier):
											identifier.text == "b"
										_:
											False

									mul_right_ok: Bool = match mul_right:
										ParsedNameExpr(identifier):
											identifier.text == "c"
										_:
											False

									mul_left_ok and mul_right_ok
								_:
									False

							add_left_ok and add_right_ok
						_:
							False

					right_ok: Bool = match right:
						ParsedIntLiteralExpr(text, _):
							text == "2"
						_:
							False

					parsed_program_ok(program) and left_ok and right_ok
				_:
					False
		_:
			False


func test_parse_logical_precedence() -> Bool:
	program = parse_compiler_source(
		source("func compare(a: Int, b: Int) -> Bool: a < b and b > 0 or a == b"),
	)

	match program.decls.get(0):
		Some(FunctionParsedDecl(function_decl)):
			match function_decl.body:
				Some(ParsedLogicalExpr(ParsedOrOp, left, right, _)):
					left_ok: Bool = match left:
						ParsedLogicalExpr(ParsedAndOp, and_left, and_right, _):
							and_left_ok: Bool = match and_left:
								ParsedBinaryExpr(ParsedLessOp, _, _, _):
									True
								_:
									False

							and_right_ok: Bool = match and_right:
								ParsedBinaryExpr(ParsedGreaterOp, _, _, _):
									True
								_:
									False

							and_left_ok and and_right_ok
						_:
							False

					right_ok: Bool = match right:
						ParsedBinaryExpr(ParsedEqualOp, _, _, _):
							True
						_:
							False

					parsed_program_ok(program) and left_ok and right_ok
				_:
					False
		_:
			False


