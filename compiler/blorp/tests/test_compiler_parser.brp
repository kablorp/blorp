		_:
			False


func test_parse_final_leading_dot_expression_before_top_level_decl() -> Bool:
	program_source: String = "func zip_empty() -> Bool:\n    a: List[Int] = []\n    a\n        .zip([1, 2, 3])\n        .length() == 0\n\ntests: Int = 1"
	program = parse_compiler_source(source(program_source))

