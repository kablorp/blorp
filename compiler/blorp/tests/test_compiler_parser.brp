								and for_binder_tuple_name_at(binder, 0, "key")
								and for_binder_tuple_name_at(binder, 1, "value")
							)
						_:
							False
				_:
					False
		_:
			False

	second_binder_ok: Bool = match program.decls.get(1):
		Some(FunctionParsedDecl(function_decl)):
			match function_decl.body:
				Some(ParsedBlockExpr(items, _)):
					match items.get(1):
						Some(ParsedForExpr(binder, _, _, _)):
							(
								for_binder_tuple_length(binder, 2)
								and for_binder_tuple_name_at(binder, 0, "_")
								and for_binder_tuple_name_at(binder, 1, "val")
							)
						_:
							False
				_:
					False
		_:
			False

	parsed_program_ok(program) and first_binder_ok and second_binder_ok


