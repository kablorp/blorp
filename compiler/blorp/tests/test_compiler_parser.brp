						and trait_decl.methods.length() == 1
					)
				_:
					False
		_:
			False


func test_parse_impl_inline_bounds() -> Bool:
	program_source: String = "trait Showable:\n\tpure func show(value: Self) -> String\n\nrecord Box[T] {value: T}\n\nimplements Showable for Box[T:Showable+Equatable]:\n\tpure func show(b: Box[T]) -> String:\n\t\t\"box\""
	program = parse_compiler_source(source(program_source))

	match program.decls.get(2):
		Some(ImplParsedDecl(impl_decl)):
			match impl_decl.for_type:
				ParsedNamedType(name, args, _):
					arg_ok: Bool = match args.get(0):
						Some(ParsedBoundedType(arg_name, bounds, _)):
							(
								arg_name.text == "T"
								and bounds.length() == 2
								and parsed_program_ok(program)
							)
						_:
							False

					name.text == "Box" and arg_ok
				_:
					False
		_:
			False


func test_parse_tuple_impl_target() -> Bool:
	program_source: String = "implements Stringable for (A:Stringable, B:Stringable):\n\tpure func to_string(t: (A, B)) -> String:\n\t\t\"tuple\""
	program = parse_compiler_source(source(program_source))

	match program.decls.get(0):
		Some(ImplParsedDecl(impl_decl)):
			match impl_decl.for_type:
				ParsedTupleType(items, _):
					first_ok: Bool = match items.get(0):
						Some(ParsedBoundedType(name, bounds, _)):
							name.text == "A" and bounds.length() == 1
						_:
							False

					second_ok: Bool = match items.get(1):
						Some(ParsedBoundedType(name, bounds, _)):
							name.text == "B" and bounds.length() == 1
						_:
							False

					parsed_program_ok(program) and first_ok and second_ok
				_:
					False
		_:
			False


func test_parse_dim_arithmetic_type() -> Bool:
	program_source: String = "pure func flatten[T, #M, #N](m: T[#M, #N]) -> T[#M * #N]:\n\tm[0]\n\npure func padded[T, #N](v: T[(#N + #1) * #2]) -> Int:\n\tlength(v)"
	program = parse_compiler_source(source(program_source))

	first_ok: Bool = match program.decls.get(0):
		Some(FunctionParsedDecl(function_decl)):
			match function_decl.return_type:
				Some(ParsedArrayType(_, dims, _)):
					match dims.get(0):
						Some(ParsedDimBinaryType(_, _, _, _)):
							True
						_:
							False
				_:
					False
		_:
			False

	second_ok: Bool = match program.decls.get(1):
		Some(FunctionParsedDecl(function_decl)):
			match function_decl.params.get(0):
				Some(param):
					match param.type_expr:
						Some(ParsedArrayType(_, dims, _)):
							match dims.get(0):
								Some(ParsedDimBinaryType(ParsedDimMultiplyOp, _, _, _)):
									True
								_:
									False
						_:
							False
				None:
					False
		_:
			False

	parsed_program_ok(program) and first_ok and second_ok


func test_parse_generic_function_declaration() -> Bool:
	program_source: String = "func identity[T](x: T) -> T:\n\tx"
	program = parse_compiler_source(source(program_source))

	match program.decls.get(0):
		Some(FunctionParsedDecl(function_decl)):
			body_ok: Bool = match function_decl.body:
				Some(ParsedBlockExpr(items, _)):
					items.length() == 1
				_:
					False

			ok: Bool = (
				parsed_program_ok(program)
				and function_decl.name.text == "identity"
				and function_decl.type_params.length() == 1
				and function_decl.params.length() == 1
				and body_ok
			)

			ok
		_:
			False


func test_parse_top_level_var_declarations() -> Bool:
	program_source: String = "X: Int = 42\nY = 99\nvar Z: String = \"ok\""
	program = parse_compiler_source(source(program_source))

	match program.decls.get(0):
		Some(VarParsedDecl(first_decl)):
			first_ok: Bool = match first_decl.type_expr:
				Some(ParsedNamedType(type_name, _, _)):
					(
						first_decl.name.text == "X"
						and type_name.text == "Int"
						and not first_decl.is_mutable
					)
				_:
					False

			second_ok: Bool = match program.decls.get(1):
				Some(VarParsedDecl(second_decl)):
					value_ok: Bool = match second_decl.value:
						ParsedIntLiteralExpr(text, _):
							text == "99"
						_:
							False

					no_type: Bool = match second_decl.type_expr:
						None:
							True
						Some(_):
							False

					ok: Bool = (
						second_decl.name.text == "Y"
						and no_type
						and not second_decl.is_mutable
						and value_ok
					)

					ok
				_:
					False

			third_ok: Bool = match program.decls.get(2):
				Some(VarParsedDecl(third_decl)):
					third_decl.name.text == "Z" and third_decl.is_mutable
				_:
					False

			ok: Bool = (
				parsed_program_ok(program)
				and program.decls.length() == 3
				and first_ok
				and second_ok
				and third_ok
			)

			ok
		_:
			False


