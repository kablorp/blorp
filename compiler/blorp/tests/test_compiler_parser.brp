func test_parse_qualified_type_names() -> Bool:
	program_source: String = "func lookup(items: D.Dict[String, Int]) -> O.Option[Int]:\n\tnone()"
	program = parse_compiler_source(source(program_source))

	match program.decls.get(0):
		Some(FunctionParsedDecl(function_decl)):
			param_ok: Bool = match function_decl.params.get(0):
				Some(param):
					match param.type_expr:
						Some(ParsedQualifiedNamedType(module_name, type_name, args, _)):
							first_arg_ok: Bool = match args.get(0):
								Some(ParsedNamedType(arg_name, _, _)):
									arg_name.text == "String"
								_:
									False

							second_arg_ok: Bool = match args.get(1):
								Some(ParsedNamedType(arg_name, _, _)):
									arg_name.text == "Int"
								_:
									False

							ok: Bool = (
								param_name_is(param, "items")
								and module_name.text == "D"
								and type_name.text == "Dict"
								and args.length() == 2
								and first_arg_ok
								and second_arg_ok
							)

							ok
						_:
							False
				None:
					False

			return_ok: Bool = match function_decl.return_type:
				Some(ParsedQualifiedNamedType(module_name, type_name, args, _)):
					match args.get(0):
						Some(ParsedNamedType(arg_name, _, _)):
							(
								module_name.text == "O"
								and type_name.text == "Option"
								and args.length() == 1
								and arg_name.text == "Int"
							)
						_:
							False
				_:
					False

			parsed_program_ok(program) and param_ok and return_ok
		_:
			False


