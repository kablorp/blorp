	program = parse_compiler_source(source(program_source))

	match program.decls.get(1):
		Some(FunctionParsedDecl(function_decl)):
			param_ok: Bool = match function_decl.params.get(1):
				Some(param):
					match param.binder:
						ParsedParamNameBinder(name):
							name.text == "after"
						_:
							False
				None:
					False

			expr_ok: Bool = match function_decl.body:
				Some(ParsedBlockExpr(items, _)):
					match items.get(0):
						Some(ParsedBinaryExpr(ParsedSubtractOp, left, _, _)):
							match left:
								ParsedFieldAccessExpr(receiver, field, _):
									match receiver:
										ParsedNameExpr(name):
											(
												name.text == "after"
												and field.text == "total_allocations"
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False

			parsed_program_ok(program) and param_ok and expr_ok
		_:
			False


