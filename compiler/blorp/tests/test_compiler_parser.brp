func test_parse_record_literal_and_update() -> Bool:
	program_source: String = "func make(point: Point):\n\t{x = 1, y = 2}\n\t{ point | x = point.x + 1 }"
	program = parse_compiler_source(source(program_source))

	match program.decls.get(0):
		Some(FunctionParsedDecl(function_decl)):
			match function_decl.body:
				Some(ParsedBlockExpr(items, _)):
					record_ok: Bool = match items.get(0):
						Some(ParsedRecordExpr(fields, _)):
							first_ok: Bool = match fields.get(0):
								Some(field):
									field.name.text == "x"
								None:
									False

							fields.length() == 2 and first_ok
						_:
							False

					update_ok: Bool = match items.get(1):
						Some(ParsedRecordUpdateExpr(base, fields, _)):
							base_ok: Bool = match base:
								ParsedNameExpr(name):
									name.text == "point"
								_:
									False

							field_ok: Bool = match fields.get(0):
								Some(field):
									value_ok: Bool = match field.value:
										ParsedBinaryExpr(ParsedAddOp, _, _, _):
											True
										_:
											False

									field.name.text == "x" and value_ok
								None:
									False

							base_ok and fields.length() == 1 and field_ok
						_:
							False

					parsed_program_ok(program) and items.length() == 2 and record_ok and update_ok
				_:
					False
		_:
			False


