func test_parse_list_patterns() -> Bool:
	program_source: String = "func classify(xs: List[Int]) -> Int:\n\tmatch xs:\n\t\t[]: 0\n\t\t[x]: x\n\t\t[a, b]: a + b\n\t\t[head, ...tail]: head\n\t\t[..._]: 1"
	program = parse_compiler_source(source(program_source))
	cases = first_match_cases(program)

	empty_ok: Bool = match cases.get(0):
		Some(case):
			match case.pattern:
				ParsedListPattern(items, spread, _):
					items.length() == 0 and list_spread_is_none(spread)
				_:
					False
		None:
			False

	single_ok: Bool = match cases.get(1):
		Some(case):
			match case.pattern:
				ParsedListPattern(items, spread, _):
					first_ok: Bool = match items.get(0):
						Some(item):
							pattern_is_name(item, "x")
						None:
							False

					items.length() == 1 and first_ok and list_spread_is_none(spread)
				_:
					False
		None:
			False

	multi_ok: Bool = match cases.get(2):
		Some(case):
			match case.pattern:
				ParsedListPattern(items, spread, _):
					first_ok: Bool = match items.get(0):
						Some(item):
							pattern_is_name(item, "a")
						None:
							False

					second_ok: Bool = match items.get(1):
						Some(item):
							pattern_is_name(item, "b")
						None:
							False

					items.length() == 2 and first_ok and second_ok and list_spread_is_none(spread)
				_:
					False
		None:
			False

	spread_ok: Bool = match cases.get(3):
		Some(case):
			match case.pattern:
				ParsedListPattern(items, spread, _):
					first_ok: Bool = match items.get(0):
						Some(item):
							pattern_is_name(item, "head")
						None:
							False

					items.length() == 1 and first_ok and list_spread_is_name(spread, "tail")
				_:
					False
		None:
			False

	wildcard_spread_ok: Bool = match cases.get(4):
		Some(case):
			match case.pattern:
				ParsedListPattern(items, spread, _):
					items.length() == 0 and list_spread_is_wildcard(spread)
				_:
					False
		None:
			False

	ok: Bool = (
		parsed_program_ok(program)
		and cases.length() == 5
		and empty_ok
		and single_ok
		and multi_ok
		and spread_ok
		and wildcard_spread_ok
	)

	ok


