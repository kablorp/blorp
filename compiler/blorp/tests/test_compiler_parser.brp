func test_parse_lambda_expression() -> Bool:
	program = parse_compiler_source(source("func make_adder(): pure func(x: Int, y) -> Int: x + y"))

	match program.decls.get(0):
		Some(FunctionParsedDecl(function_decl)):
			match function_decl.body:
				Some(ParsedLambdaExpr(is_pure, params, return_type, body, _)):
					first_param_ok: Bool = match params.get(0):
						Some(param):
							match param.type_expr:
								Some(ParsedNamedType(type_name, _, _)):
									lambda_param_name_is(param, "x") and type_name.text == "Int"
								_:
									False
						None:
							False

					second_param_ok: Bool = match params.get(1):
						Some(param):
							no_type: Bool = match param.type_expr:
								None:
									True
								Some(_):
									False

							lambda_param_name_is(param, "y") and no_type
						None:
							False

					return_ok: Bool = match return_type:
						Some(ParsedNamedType(type_name, _, _)):
							type_name.text == "Int"
						_:
							False

					body_ok: Bool = match body:
						ParsedBinaryExpr(ParsedAddOp, _, _, _):
							True
						_:
							False

					ok: Bool = (
						parsed_program_ok(program)
						and is_pure
						and params.length() == 2
						and first_param_ok
						and second_param_ok
						and return_ok
						and body_ok
					)

					ok
				_:
					False
		_:
			False


