			function_decl.name.text == "concurrent"
		_:
			False

	field_name_ok: Bool = match program.decls.get(1):
		Some(FunctionParsedDecl(function_decl)):
			match function_decl.body:
				Some(ParsedBlockExpr(items, _)):
					match items.get(1):
						Some(ParsedCallExpr(callee, _, _)):
							match callee:
								ParsedFieldAccessExpr(_, field, _):
									field.text == "concurrent"
								_:
									False
						_:
							False
				_:
					False
		_:
			False

	parsed_program_ok(program) and function_name_ok and field_name_ok


func test_parse_after_keyword_as_identifier() -> Bool:
