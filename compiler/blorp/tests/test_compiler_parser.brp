import:
	../src/stage_01_file_io/compiler_source: CompilerSourceFile, compiler_source_file
	../src/stage_02_lex/compiler_parse_diagnostic: compiler_parse_diagnostic_to_string
	../src/stage_03_parse/compiler_parsed_ast:
		ParsedConcurrentParam,
		ParsedDecl(
			BuiltinTypeParsedDecl,
			ForeignBlockParsedDecl,
			FunctionParsedDecl,
			ImplParsedDecl,
			ImportBlockParsedDecl,
			ParsedErrorDecl,
			PrivateParsedDecl,
			RecordParsedDecl,
			TraitParsedDecl,
			TypeAliasParsedDecl,
			UnionParsedDecl,
			VarParsedDecl,
		),
		ParsedExpr(
			ParsedAssignExpr,
			ParsedAscriptionExpr,
			ParsedBinaryExpr,
			ParsedBlockExpr,
			ParsedBreakExpr,
			ParsedBuiltinExpr,
			ParsedCallExpr,
			ParsedCharLiteralExpr,
			ParsedConcurrentBlockExpr,
			ParsedConcurrentForExpr,
			ParsedDebugBlockExpr,
			ParsedContinueExpr,
			ParsedCompoundAssignExpr,
			ParsedDetachExpr,
			ParsedDictExpr,
			ParsedForExpr,
			ParsedFieldAccessExpr,
			ParsedIfExpr,
			ParsedIntLiteralExpr,
			ParsedFunctionDeclExpr,
			ParsedLambdaExpr,
			ParsedListExpr,
			ParsedLogicalExpr,
			ParsedMatchExpr,
			ParsedNameExpr,
			ParsedOpaqueFromExpr,
			ParsedOpaqueIntoExpr,
			ParsedQuestionBindExpr,
			ParsedRecordExpr,
			ParsedRecordUpdateExpr,
			ParsedSelectExpr,
			ParsedStringInterpolationExpr,
			ParsedSubscriptAssignExpr,
			ParsedSubscriptExpr,
			ParsedTupleExpr,
			ParsedTupleDestructExpr,
			ParsedVarDeclExpr,
			ParsedVectorExpr,
			ParsedVoidExpr,
			ParsedWithExpr,
			ParsedWhileExpr,
		),
		ParsedForBinder(ParsedForNameBinder, ParsedForTupleBinder),
		ParsedForeignBlockArg,
		ParsedForeignFunctionDecl,
		ParsedFunctionAnnotation(
			ParsedDebugOnlyAnnotation,
			ParsedNoCopyAnnotation,
			ParsedResourceResultOrdinaryAnnotation,
			ParsedTailRecursiveAnnotation,
		),
		ParsedLambdaParam,
		ParsedListPatternSpread(ParsedListSpreadName, ParsedListSpreadWildcard),
		ParsedMatchCase,
		ParsedParam,
		ParsedParamBinder(ParsedParamNameBinder, ParsedParamTupleBinder, ParsedParamWildcardBinder),
		ParsedPattern(
			ParsedCharPattern,
			ParsedConstructorPattern,
			ParsedFloatPattern,
			ParsedIntPattern,
			ParsedListPattern,
			ParsedNamePattern,
			ParsedOrPattern,
			ParsedQualifiedConstructorPattern,
			ParsedTuplePattern,
		),
		ParsedProgram,
		ParsedSelectArm,
		ParsedSelectArmKind(ParsedSelectAfterArm, ParsedSelectReceiveArm, ParsedSelectSealedArm),
		ParsedTypeExpr(
			ParsedArrayType,
			ParsedBoundedType,
			ParsedDimBinaryType,
			ParsedDimNameType,
			ParsedFunctionType,
			ParsedNamedType,
			ParsedQualifiedNamedType,
			ParsedRangeType,
			ParsedTupleType,
		),
		ParsedTypeParamDecl,
		ParsedWithBinding,
		ParsedWithBindingKind(ParsedWithPlainBinding, ParsedWithTryBinding),
		parsed_program_has_errors,
		parsed_program_ok,
	../src/stage_03_parse/compiler_parsed_ast_json: parsed_program_to_json
	../src/stage_03_parse/compiler_parser: parse_compiler_source
	test: TestSuite


pure func source(text: String) -> CompilerSourceFile:
	compiler_source_file("parser.brp", "parser", text)


pure func first_diagnostic_text(program_source: String) -> String:
	program = parse_compiler_source(source(program_source))

	match program.diagnostics.get(0):
		Some(diagnostic):
			compiler_parse_diagnostic_to_string(diagnostic)
		None:
			""


pure func is_qualified_constructor_pattern(
	pattern: ParsedPattern,
	module_text: String,
	constructor_text: String,
	arg_count: Int,
) -> Bool:
	match pattern:
		ParsedQualifiedConstructorPattern(module_name, constructor_name, args, _):
			(
				module_name.text == module_text
				and constructor_name.text == constructor_text
				and args.length() == arg_count
			)
		_:
			False


pure func first_match_cases(program: ParsedProgram) -> List[ParsedMatchCase]:
	match program.decls.get(0):
		Some(FunctionParsedDecl(function_decl)):
			match function_decl.body:
				Some(ParsedBlockExpr(items, _)):
					match items.get(0):
						Some(ParsedMatchExpr(_, cases, _)):
							cases
						_:
							[]
				_:
					[]
		_:
			[]


pure func int_pattern_at(cases: List[ParsedMatchCase], index: Int, expected: String) -> Bool:
	match cases.get(index):
		Some(case):
			match case.pattern:
				ParsedIntPattern(text, _):
					text == expected
				_:
					False
		None:
			False


pure func float_pattern_at(cases: List[ParsedMatchCase], index: Int, expected: String) -> Bool:
	match cases.get(index):
		Some(case):
			match case.pattern:
				ParsedFloatPattern(text, _):
					text == expected
				_:
					False
		None:
			False


pure func char_pattern_at(cases: List[ParsedMatchCase], index: Int, expected: Int) -> Bool:
	match cases.get(index):
		Some(case):
			match case.pattern:
				ParsedCharPattern(codepoint, _):
					codepoint == expected
				_:
					False
		None:
			False


pure func or_pattern_at(cases: List[ParsedMatchCase], index: Int, expected_count: Int) -> Bool:
	match cases.get(index):
		Some(case):
			match case.pattern:
				ParsedOrPattern(patterns, _):
					patterns.length() == expected_count
				_:
					False
		None:
			False


pure func tuple_pattern_at(cases: List[ParsedMatchCase], index: Int, expected_count: Int) -> Bool:
	match cases.get(index):
		Some(case):
			match case.pattern:
				ParsedTuplePattern(items, _):
					items.length() == expected_count
				_:
					False
		None:
			False


pure func pattern_is_name(pattern: ParsedPattern, expected: String) -> Bool:
	match pattern:
		ParsedNamePattern(name):
			name.text == expected
		_:
			False


pure func list_spread_is_none(spread: Option[ParsedListPatternSpread]) -> Bool:
	match spread:
		None:
			True
		Some(_):
			False


pure func list_spread_is_name(spread: Option[ParsedListPatternSpread], expected: String) -> Bool:
	match spread:
		Some(ParsedListSpreadName(name)):
			name.text == expected
		_:
			False


pure func list_spread_is_wildcard(spread: Option[ParsedListPatternSpread]) -> Bool:
	match spread:
		Some(ParsedListSpreadWildcard(_)):
			True
		_:
			False


pure func for_binder_is_name(binder: ParsedForBinder, expected: String) -> Bool:
	match binder:
		ParsedForNameBinder(name):
			name.text == expected
		ParsedForTupleBinder(_, _):
			False


pure func for_binder_tuple_name_at(binder: ParsedForBinder, index: Int, expected: String) -> Bool:
	match binder:
		ParsedForTupleBinder(items, _):
			match items.get(index):
				Some(item):
					item.text == expected
				None:
					False
		ParsedForNameBinder(_):
			False


pure func for_binder_tuple_length(binder: ParsedForBinder, expected: Int) -> Bool:
	match binder:
		ParsedForTupleBinder(items, _):
			items.length() == expected
		ParsedForNameBinder(_):
			False


pure func param_name_text(param: ParsedParam) -> Option[String]:
	match param.binder:
		ParsedParamNameBinder(name):
			Some(name.text)
		_:
			None


pure func param_name_is(param: ParsedParam, expected: String) -> Bool:
	param_name_text(param).get_or("") == expected


pure func param_is_wildcard(param: ParsedParam) -> Bool:
	match param.binder:
		ParsedParamWildcardBinder(_):
			True
		_:
			False


pure func param_type_is_named(param: ParsedParam, expected: String) -> Bool:
	match param.type_expr:
		Some(type_expr):
			type_expr_is_named(type_expr, expected)
		None:
			False


pure func param_tuple_length(param: ParsedParam, expected: Int) -> Bool:
	match param.binder:
		ParsedParamTupleBinder(items, _):
			items.length() == expected
		_:
			False


pure func param_tuple_name_at(param: ParsedParam, index: Int, expected: String) -> Bool:
	match param.binder:
		ParsedParamTupleBinder(items, _):
			match items.get(index):
				Some(item):
					item.text == expected
				None:
					False
		_:
			False


pure func lambda_param_name_text(param: ParsedLambdaParam) -> Option[String]:
	Some(param.name.text)


pure func lambda_param_name_is(param: ParsedLambdaParam, expected: String) -> Bool:
	lambda_param_name_text(param).get_or("") == expected


pure func type_param_at_matches(
	params: List[ParsedTypeParamDecl],
	index: Int,
	name_text: String,
	bound_count: Int,
) -> Bool:
	match params.get(index):
		Some(param):
			param.name.text == name_text and param.bounds.length() == bound_count
		None:
			False


pure func type_param_first_bound_matches(
	params: List[ParsedTypeParamDecl],
	index: Int,
	name_text: String,
	bound_text: String,
) -> Bool:
	match params.get(index):
		Some(param):
			match param.bounds.get(0):
				Some(bound):
					param.name.text == name_text and bound.text == bound_text
				None:
					False
		None:
			False


pure func type_expr_is_named(type_expr: ParsedTypeExpr, name_text: String) -> Bool:
	match type_expr:
		ParsedNamedType(name, _, _):
			name.text == name_text
		_:
			False


pure func optional_type_expr_is_named(type_expr: Option[ParsedTypeExpr], name_text: String) -> Bool:
	match type_expr:
		Some(type_value):
			type_expr_is_named(type_value, name_text)
		None:
			False


pure func expr_is_int_literal(expr: ParsedExpr, text: String) -> Bool:
	match expr:
		ParsedIntLiteralExpr(actual, _):
			actual == text
		_:
			False


pure func expr_is_name(expr: ParsedExpr, name_text: String) -> Bool:
	match expr:
		ParsedNameExpr(name):
			name.text == name_text
		_:
			False


pure func expr_is_opaque_into_named_int(
	expr: ParsedExpr,
	type_name: String,
	literal_text: String,
) -> Bool:
	match expr:
		ParsedOpaqueIntoExpr(type_value, inner, _):
			type_expr_is_named(type_value, type_name) and expr_is_int_literal(inner, literal_text)
		_:
			False


pure func expr_is_opaque_from_named_name(
	expr: ParsedExpr,
	type_name: String,
	name_text: String,
) -> Bool:
	match expr:
		ParsedOpaqueFromExpr(type_value, inner, _):
			type_expr_is_named(type_value, type_name) and expr_is_name(inner, name_text)
		_:
			False


pure func expr_is_call_named(expr: ParsedExpr, name_text: String) -> Bool:
	match expr:
		ParsedCallExpr(callee, _, _):
			match callee:
				ParsedNameExpr(name):
					name.text == name_text
				_:
					False
		_:
			False


pure func expr_is_block_with_item_count(expr: ParsedExpr, expected: Int) -> Bool:
	match expr:
		ParsedBlockExpr(items, _):
			items.length() == expected
		_:
			False


pure func concurrent_param_at_is_int_literal(
	params: List[ParsedConcurrentParam],
	index: Int,
	name_text: String,
	value_text: String,
) -> Bool:
	match params.get(index):
		Some(param):
			param.name.text == name_text and expr_is_int_literal(param.value, value_text)
		None:
			False


pure func type_expr_is_dim_name(
	type_expr: ParsedTypeExpr,
	name_text: String,
	is_variadic_expected: Bool,
) -> Bool:
	match type_expr:
		ParsedDimNameType(name, is_variadic, _):
			name.text == name_text and is_variadic == is_variadic_expected
		_:
			False


pure func type_expr_is_named_array_with_dim(
	type_expr: ParsedTypeExpr,
	base_name: String,
	dim_name: String,
) -> Bool:
	match type_expr:
		ParsedArrayType(base, dims, _):
			base_ok: Bool = type_expr_is_named(base, base_name)

			dim_ok: Bool = match dims.get(0):
				Some(dim):
					type_expr_is_dim_name(dim, dim_name, False)
				None:
					False

			base_ok and dim_ok
		_:
			False


pure func type_expr_is_named_array_with_variadic_dim(
	type_expr: ParsedTypeExpr,
	base_name: String,
	dim_name: String,
) -> Bool:
	match type_expr:
		ParsedArrayType(base, dims, _):
			base_ok: Bool = type_expr_is_named(base, base_name)

			dim_ok: Bool = match dims.get(0):
				Some(dim):
					type_expr_is_dim_name(dim, dim_name, True)
				None:
					False

			base_ok and dim_ok
		_:
			False


pure func param_at_is_named_array_with_variadic_dim(
	params: List[ParsedParam],
	index: Int,
	base_name: String,
	dim_name: String,
) -> Bool:
	match params.get(index):
		Some(param):
			match param.type_expr:
				Some(type_expr):
					type_expr_is_named_array_with_variadic_dim(type_expr, base_name, dim_name)
				None:
					False
		None:
			False


pure func select_arm_at_is_receive(
	arms: List[ParsedSelectArm],
	index: Int,
	binder_text: String,
	channel_name: String,
	body_count: Int,
) -> Bool:
	match arms.get(index):
		Some(arm):
			match arm.kind:
				ParsedSelectReceiveArm(binder, channel):
					(
						binder.text == binder_text
						and expr_is_name(channel, channel_name)
						and expr_is_block_with_item_count(arm.body, body_count)
					)
				_:
					False
		None:
			False


pure func select_arm_at_is_sealed(
	arms: List[ParsedSelectArm],
	index: Int,
	channel_name: String,
	body_count: Int,
) -> Bool:
	match arms.get(index):
		Some(arm):
			match arm.kind:
				ParsedSelectSealedArm(channel):
					(
						expr_is_name(channel, channel_name)
						and expr_is_block_with_item_count(arm.body, body_count)
					)
				_:
					False
		None:
			False


pure func select_arm_at_is_after_int(
	arms: List[ParsedSelectArm],
	index: Int,
	timeout_text: String,
	body_count: Int,
) -> Bool:
	match arms.get(index):
		Some(arm):
			match arm.kind:
				ParsedSelectAfterArm(timeout):
					(
						expr_is_int_literal(timeout, timeout_text)
						and expr_is_block_with_item_count(arm.body, body_count)
					)
				_:
					False
		None:
			False


pure func optional_string_is_none(value: Option[String]) -> Bool:
	match value:
		None:
			True
		Some(_):
			False


pure func optional_type_is_none(value: Option[ParsedTypeExpr]) -> Bool:
	match value:
		None:
			True
		Some(_):
			False


pure func optional_type_is_named(value: Option[ParsedTypeExpr], name_text: String) -> Bool:
	match value:
		Some(type_expr):
			type_expr_is_named(type_expr, name_text)
		None:
			False


pure func with_error_map_is_none(binding: ParsedWithBinding) -> Bool:
	match binding.error_map:
		None:
			True
		Some(_):
			False


pure func with_binding_is_plain_int(
	binding: ParsedWithBinding,
	name_text: String,
	value_text: String,
) -> Bool:
	(
		binding.kind == ParsedWithPlainBinding
		and binding.name.text == name_text
		and optional_type_is_none(binding.type_expr)
		and expr_is_int_literal(binding.value, value_text)
		and with_error_map_is_none(binding)
	)


pure func with_error_map_matches(
	binding: ParsedWithBinding,
	error_name: String,
	mapper_name: String,
) -> Bool:
	match binding.error_map:
		Some(error_map):
			error_map.name.text == error_name and expr_is_call_named(error_map.value, mapper_name)
		None:
			False


pure func with_binding_is_typed_try_mapped(
	binding: ParsedWithBinding,
	name_text: String,
	type_name: String,
	value_name: String,
	error_name: String,
	mapper_name: String,
) -> Bool:
	(
		binding.kind == ParsedWithTryBinding
		and binding.name.text == name_text
		and optional_type_is_named(binding.type_expr, type_name)
		and expr_is_call_named(binding.value, value_name)
		and with_error_map_matches(binding, error_name, mapper_name)
	)


pure func foreign_arg_at_matches(
	args: List[ParsedForeignBlockArg],
	index: Int,
	name_text: String,
	value_text: String,
) -> Bool:
	match args.get(index):
		Some(arg):
			arg.name.text == name_text and arg.value == value_text
		None:
			False


pure func annotation_at_is_no_copy(annotations: List[ParsedFunctionAnnotation], index: Int) -> Bool:
	match annotations.get(index):
		Some(ParsedNoCopyAnnotation):
			True
		_:
			False


pure func foreign_function_at_is_pure_sqrt(
	functions: List[ParsedForeignFunctionDecl],
	index: Int,
) -> Bool:
	match functions.get(index):
		Some(function_decl):
			(
				function_decl.name.text == "sqrt"
				and function_decl.params.length() == 1
				and function_decl.is_pure
				and not function_decl.is_private
				and function_decl.annotations.length() == 0
				and function_decl.c_name.get_or("") == "sqrt"
				and type_expr_is_named(function_decl.return_type, "Float")
			)
		None:
			False


pure func foreign_function_at_is_no_copy_process(
	functions: List[ParsedForeignFunctionDecl],
	index: Int,
) -> Bool:
	match functions.get(index):
		Some(function_decl):
			(
				function_decl.name.text == "process"
				and not function_decl.is_pure
				and annotation_at_is_no_copy(function_decl.annotations, 0)
				and optional_string_is_none(function_decl.c_name)
				and param_at_is_named_array_with_variadic_dim(
					function_decl.params,
					0,
					"Float",
					"#Ds",
				)
			)
		None:
			False


pure func foreign_function_at_is_private_secret(
	functions: List[ParsedForeignFunctionDecl],
	index: Int,
) -> Bool:
	match functions.get(index):
		Some(function_decl):
			(
				function_decl.name.text == "secret"
				and function_decl.is_private
				and function_decl.is_pure
				and function_decl.c_name.get_or("") == "secret_c"
			)
		None:
			False


pure func optional_type_is_range_dim(type_expr: Option[ParsedTypeExpr], dim_name: String) -> Bool:
	match type_expr:
		Some(ParsedRangeType(dim, _)):
			type_expr_is_dim_name(dim, dim_name, False)
		_:
			False


func test_parse_empty_program() -> Bool:
	program = parse_compiler_source(source(""))

	parsed_program_ok(program) and program.decls.length() == 0


func test_parse_program_projects_json_for_bridge() -> Bool:
	program = parse_compiler_source(source("func main(args: List[String]) -> Int:\n\t0\n"))
	text: String = parsed_program_to_json(program).to_string()

	(
		parsed_program_ok(program)
		and text.contains("\"kind\":\"parsed_program\"")
		and text.contains("\"path\":\"parser.brp\"")
		and text.contains("\"module\":\"parser\"")
		and text.contains("\"decls\":[")
		and text.contains("\"diagnostics\":[]")
	)


func test_parse_simple_inline_function() -> Bool:
	program = parse_compiler_source(source("func main(): 1"))

	match program.decls.get(0):
		Some(FunctionParsedDecl(function_decl)):
			body_ok: Bool = match function_decl.body:
				Some(ParsedIntLiteralExpr(text, _)):
					text == "1"
				_:
					False

			ok: Bool = (
				parsed_program_ok(program)
				and function_decl.name.text == "main"
				and function_decl.params.length() == 0
				and not function_decl.is_pure
				and function_decl.doc.get_or("") == ""
				and body_ok
			)

			ok
		_:
			False


func test_parse_bodyless_function_signature() -> Bool:
	program_source: String = "func map[T, U](self: Option[T], f: (T) -> U) -> Option[U]:"
	program = parse_compiler_source(source(program_source))

	match program.decls.get(0):
		Some(FunctionParsedDecl(function_decl)):
			body_ok: Bool = match function_decl.body:
				None:
					True
				Some(_):
					False

			callback_ok: Bool = match function_decl.params.get(1):
				Some(param):
					match param.type_expr:
						Some(ParsedFunctionType(False, params, return_type, _)):
							match params.get(0):
								Some(param_type):
									(
										type_expr_is_named(param_type, "T")
										and type_expr_is_named(return_type, "U")
									)
								None:
									False
						_:
							False
				None:
					False

			ok: Bool = (
				parsed_program_ok(program)
				and function_decl.name.text == "map"
				and function_decl.params.length() == 2
				and body_ok
				and callback_ok
			)

			ok
		_:
			False


func test_parse_bodyless_function_before_docstring() -> Bool:
	program_source: String = "func map[T](self: Set[T]) -> Set[T]:\n\n---\nFilter elements.\n---\npure func filter[T](self: Set[T]) -> Set[T]:\n\tbuiltin(\"std/set.filter\")"
	program = parse_compiler_source(source(program_source))

	first_ok: Bool = match program.decls.get(0):
		Some(FunctionParsedDecl(function_decl)):
			match function_decl.body:
				None:
					function_decl.name.text == "map"
				Some(_):
					False
		_:
			False

	second_ok: Bool = match program.decls.get(1):
		Some(FunctionParsedDecl(function_decl)):
			(
				function_decl.name.text == "filter"
				and function_decl.doc.get_or("") == "Filter elements."
			)
		_:
			False

	parsed_program_ok(program) and first_ok and second_ok


func test_parse_multiline_function_params() -> Bool:
	program_source: String = "pure func add(\n\tx: Int,\n\ty: Int,\n) -> Int:\n\tx"
	program = parse_compiler_source(source(program_source))

	match program.decls.get(0):
		Some(FunctionParsedDecl(function_decl)):
			body_ok: Bool = match function_decl.body:
				Some(ParsedBlockExpr(items, _)):
					match items.get(0):
						Some(ParsedNameExpr(name)):
							name.text == "x"
						_:
							False
				_:
					False

			ok: Bool = (
				parsed_program_ok(program)
				and function_decl.is_pure
				and function_decl.params.length() == 2
				and body_ok
			)

			ok
		_:
			False


func test_parse_function_params_and_return_type() -> Bool:
	program_source: String = "pure func add(x: Int, y: List[String]) -> Int:\n\tx"
	program = parse_compiler_source(source(program_source))

	match program.decls.get(0):
		Some(FunctionParsedDecl(function_decl)):
			first_param_ok: Bool = match function_decl.params.get(0):
				Some(param):
					match param.type_expr:
						Some(ParsedNamedType(name, args, _)):
							param_name_is(param, "x") and name.text == "Int" and args.length() == 0
						_:
							False
				None:
					False

			second_param_ok: Bool = match function_decl.params.get(1):
				Some(param):
					match param.type_expr:
						Some(ParsedNamedType(name, args, _)):
							match args.get(0):
								Some(ParsedNamedType(arg_name, _, _)):
									(
										param_name_is(param, "y")
										and name.text == "List"
										and arg_name.text == "String"
									)
								_:
									False
						_:
							False
				None:
					False

			return_ok: Bool = match function_decl.return_type:
				Some(ParsedNamedType(name, args, _)):
					name.text == "Int" and args.length() == 0
				_:
					False

			body_ok: Bool = match function_decl.body:
				Some(ParsedBlockExpr(items, _)):
					match items.get(0):
						Some(ParsedNameExpr(identifier)):
							identifier.text == "x"
						_:
							False
				_:
					False

			ok: Bool = (
				parsed_program_ok(program)
				and function_decl.name.text == "add"
				and function_decl.is_pure
				and function_decl.params.length() == 2
				and first_param_ok
				and second_param_ok
				and return_ok
				and body_ok
			)

			ok
		_:
			False


func test_parse_tuple_destructuring_params() -> Bool:
	program_source: String = "func typed((left, right): (Int, Int)) -> Int:\n\tleft + right\n\nfunc inferred((x, y)) -> Int:\n\tx + y"
	program = parse_compiler_source(source(program_source))

	typed_ok: Bool = match program.decls.get(0):
		Some(FunctionParsedDecl(function_decl)):
			match function_decl.params.get(0):
				Some(param):
					type_ok: Bool = match param.type_expr:
						Some(ParsedTupleType(items, _)):
							items.length() == 2
						_:
							False

					tuple_ok: Bool = (
						param_tuple_length(param, 2)
						and param_tuple_name_at(param, 0, "left")
						and param_tuple_name_at(param, 1, "right")
					)

					tuple_ok and type_ok
				None:
					False
		_:
			False

	inferred_ok: Bool = match program.decls.get(1):
		Some(FunctionParsedDecl(function_decl)):
			match function_decl.params.get(0):
				Some(param):
					no_type: Bool = match param.type_expr:
						None:
							True
						Some(_):
							False

					tuple_ok: Bool = (
						param_tuple_length(param, 2)
						and param_tuple_name_at(param, 0, "x")
						and param_tuple_name_at(param, 1, "y")
					)

					tuple_ok and no_type
				None:
					False
		_:
			False

	parsed_program_ok(program) and typed_ok and inferred_ok


