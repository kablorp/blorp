	match program.decls.get(0):
		Some(FunctionParsedDecl(function_decl)):
			match function_decl.body:
				Some(ParsedBlockExpr(items, _)):
					match items.get(0):
						Some(ParsedIfExpr(cond, then_branch, else_branch, _)):
							cond_ok: Bool = match cond:
								ParsedBinaryExpr(ParsedGreaterOp, _, _, _):
									True
								_:
									False

							then_ok: Bool = match then_branch:
								ParsedBlockExpr(then_items, _):
									then_items.length() == 1
								_:
									False

							else_ok: Bool = match else_branch:
								Some(ParsedBlockExpr(else_items, _)):
									else_items.length() == 1
								_:
									False

							parsed_program_ok(program) and cond_ok and then_ok and else_ok
						_:
							False
				_:
					False
		_:
			False


