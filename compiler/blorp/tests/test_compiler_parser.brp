func test_parse_multiline_selective_import_symbols() -> Bool:
	program_source: String = "import:\n\tgeographic:\n\t\tCoord,\n\t\tPolygon,\n\t\tShape(Circle, Square)\n\tjson: parse_json\n\nfunc main(): 0"
	program = parse_compiler_source(source(program_source))

	match program.decls.get(0):
		Some(ImportBlockParsedDecl(items, _)):
			first_ok: Bool = match items.get(0):
				Some(item):
					match item.symbols:
						Some(symbols):
							first_symbol_ok: Bool = match symbols.get(0):
								Some(symbol):
									(
										symbol.name.text == "Coord"
										and symbol.constructors.length() == 0
									)
								None:
									False

							third_symbol_ok: Bool = match symbols.get(2):
								Some(symbol):
									(
										symbol.name.text == "Shape"
										and symbol.constructors.length() == 2
									)
								None:
									False

							(
								item.module_path == "geographic"
								and symbols.length() == 3
								and first_symbol_ok
								and third_symbol_ok
							)
						None:
							False
				None:
					False

			second_ok: Bool = match items.get(1):
				Some(item):
					match item.symbols:
						Some(symbols):
							match symbols.get(0):
								Some(symbol):
									item.module_path == "json" and symbol.name.text == "parse_json"
								None:
									False
						None:
							False
				None:
					False

			parsed_program_ok(program) and items.length() == 2 and first_ok and second_ok
		_:
			False


