							param_ok: Bool = match params.get(0):
								Some(ParsedTupleType(items, _)):
									items.length() == 2
								_:
									False

							return_ok: Bool = match return_type:
								ParsedNamedType(name, _, _):
									name.text == "Int"
								_:
									False

							parsed_program_ok(program) and param_ok and return_ok
						_:
							False
				None:
					False
		_:
			False


func test_parse_trait_declaration() -> Bool:
	program_source: String = "trait Comparable:\n\tpure func same(a: Self, b: Self) -> Bool\n\tpure func different(a: Self, b: Self) -> Bool:\n\t\tnot same(a, b)\n\ntrait Rankable: Comparable:\n\tpure func rank(a: Self, b: Self) -> Int"
	program = parse_compiler_source(source(program_source))

	match program.decls.get(0):
		Some(TraitParsedDecl(trait_decl)):
			default_body_ok: Bool = match trait_decl.methods.get(1):
				Some(method_decl):
					match method_decl.body:
						Some(_):
							method_decl.name.text == "different" and method_decl.is_pure
						None:
							False
				None:
					False

			rankable_ok: Bool = match program.decls.get(1):
				Some(TraitParsedDecl(rankable_decl)):
					(
						rankable_decl.name.text == "Rankable"
						and rankable_decl.supertraits.length() == 1
						and rankable_decl.methods.length() == 1
					)
				_:
					False

			ok: Bool = (
				parsed_program_ok(program)
				and trait_decl.name.text == "Comparable"
				and trait_decl.methods.length() == 2
				and default_body_ok
				and rankable_ok
			)

			ok
		_:
			False


func test_parse_supertrait_only_declaration() -> Bool:
	program_source: String = "trait Hashable: Equatable + Stringable"
	program = parse_compiler_source(source(program_source))

	match program.decls.get(0):
