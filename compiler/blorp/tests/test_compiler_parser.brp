						Some(ParsedMatchExpr(scrutinee, cases, _)):
							scrutinee_ok: Bool = match scrutinee:
								ParsedNameExpr(identifier):
									identifier.text == "opt"
								_:
									False

							first_case_ok: Bool = match cases.get(0):
								Some(case):
									match case.pattern:
										ParsedConstructorPattern(name, args, _):
											name.text == "Some" and args.length() == 1
										_:
											False
								None:
									False

							second_case_ok: Bool = match cases.get(1):
								Some(case):
									match case.pattern:
										ParsedNamePattern(name):
											name.text == "None"
										_:
											False
								None:
									False

							ok: Bool = (
								parsed_program_ok(program)
								and scrutinee_ok
								and cases.length() == 2
								and first_case_ok
								and second_case_ok
							)

							ok
						_:
							False
				_:
					False
		_:
			False


