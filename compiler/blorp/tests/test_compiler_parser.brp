func test_parse_foreign_block_declaration() -> Bool:
	program_source: String = "foreign(include: \"math.h\", link_linux: \"-ldl\"):\n\tpure func sqrt(x: Float) -> Float = \"sqrt\"\n\t@no_copy func process(data: Float[#Ds...]) -> Int"
	program = parse_compiler_source(source(program_source))

	match program.decls.get(0):
		Some(ForeignBlockParsedDecl(args, functions, _)):
			(
				parsed_program_ok(program)
				and args.length() == 2
				and functions.length() == 2
				and foreign_arg_at_matches(args, 0, "include", "math.h")
				and foreign_arg_at_matches(args, 1, "link_linux", "-ldl")
				and foreign_function_at_is_pure_sqrt(functions, 0)
				and foreign_function_at_is_no_copy_process(functions, 1)
			)
		_:
			False


