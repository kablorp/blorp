func test_parse_var_decl_and_compound_assignment() -> Bool:
	program_source: String = "func countdown(n: Int) -> Int:\n\tvar x: Int = n\n\tx -= 1\n\tx"
	program = parse_compiler_source(source(program_source))

	match program.decls.get(0):
		Some(FunctionParsedDecl(function_decl)):
			match function_decl.body:
				Some(ParsedBlockExpr(items, _)):
					var_ok: Bool = match items.get(0):
						Some(ParsedVarDeclExpr(name, type_expr, value, is_mutable, _)):
							type_ok: Bool = match type_expr:
								Some(ParsedNamedType(type_name, _, _)):
									type_name.text == "Int"
								_:
									False

							value_ok: Bool = match value:
								ParsedNameExpr(value_name):
									value_name.text == "n"
								_:
									False

							name.text == "x" and is_mutable and type_ok and value_ok
						_:
							False

					compound_ok: Bool = match items.get(1):
						Some(ParsedCompoundAssignExpr(name, ParsedAssignSubtractOp, value, _)):
							value_ok: Bool = match value:
								ParsedIntLiteralExpr(text, _):
									text == "1"
								_:
									False

							name.text == "x" and value_ok
						_:
							False

					parsed_program_ok(program) and items.length() == 3 and var_ok and compound_ok
				_:
					False
		_:
			False


func test_parse_typed_bind_question_bind_and_assignment() -> Bool:
	program_source: String = "func process(raw: String) -> Int:\n\tparsed: Int ?= parse(raw)\n\ttotal: Int = parsed\n\ttotal = total + 1\n\ttotal"
	program = parse_compiler_source(source(program_source))

	match program.decls.get(0):
		Some(FunctionParsedDecl(function_decl)):
			match function_decl.body:
				Some(ParsedBlockExpr(items, _)):
					question_ok: Bool = match items.get(0):
						Some(ParsedQuestionBindExpr(name, type_expr, value, _)):
							type_ok: Bool = match type_expr:
								Some(ParsedNamedType(type_name, _, _)):
									type_name.text == "Int"
								_:
									False

							value_ok: Bool = match value:
								ParsedCallExpr(callee, args, _):
									callee_ok: Bool = match callee:
										ParsedNameExpr(callee_name):
											callee_name.text == "parse"
										_:
											False

									callee_ok and args.length() == 1
								_:
									False

							name.text == "parsed" and type_ok and value_ok
						_:
							False

					bind_ok: Bool = match items.get(1):
						Some(ParsedVarDeclExpr(name, type_expr, value, is_mutable, _)):
							type_ok: Bool = match type_expr:
								Some(ParsedNamedType(type_name, _, _)):
									type_name.text == "Int"
								_:
									False

							value_ok: Bool = match value:
								ParsedNameExpr(value_name):
									value_name.text == "parsed"
								_:
									False

							name.text == "total" and not is_mutable and type_ok and value_ok
						_:
							False

					assign_ok: Bool = match items.get(2):
						Some(ParsedAssignExpr(name, value, _)):
							value_ok: Bool = match value:
								ParsedBinaryExpr(ParsedAddOp, _, _, _):
									True
								_:
									False

							name.text == "total" and value_ok
						_:
							False

					ok: Bool = (
						parsed_program_ok(program)
						and items.length() == 4
						and question_ok
						and bind_ok
						and assign_ok
					)

					ok
				_:
					False
		_:
			False


