func test_parse_import_block_declaration() -> Bool:
	program_source: String = "import:\n\toption: Option(Some, None)\n\tdict as D\n\tdebug as dbg\n\nfunc main(): 0"
	program = parse_compiler_source(source(program_source))

	match program.decls.get(0):
		Some(ImportBlockParsedDecl(items, _)):
			first_ok: Bool = match items.get(0):
				Some(item):
					symbols_ok: Bool = match item.symbols:
						Some(symbols):
							match symbols.get(0):
								Some(symbol):
									(
										symbol.name.text == "Option"
										and symbol.constructors.length() == 2
									)
								None:
									False
						None:
							False

					no_alias: Bool = match item.module_alias:
						None:
							True
						Some(_):
							False

					item.module_path == "option" and no_alias and symbols_ok
				None:
					False

			second_ok: Bool = match items.get(1):
				Some(item):
					match item.module_alias:
						Some(module_alias):
							no_symbols: Bool = match item.symbols:
								None:
									True
								Some(_):
									False

							ok: Bool = (
								item.module_path == "dict"
								and module_alias.text == "D"
								and no_symbols
							)

							ok
						None:
							False
				None:
					False

			third_ok: Bool = match items.get(2):
				Some(item):
					match item.module_alias:
						Some(module_alias):
							no_symbols: Bool = match item.symbols:
								None:
									True
								Some(_):
									False

							ok: Bool = (
								item.module_path == "debug"
								and module_alias.text == "dbg"
								and no_symbols
							)

							ok
						None:
							False
				None:
					False

			final_ok: Bool = (
				parsed_program_ok(program)
				and items.length() == 3
				and first_ok
				and second_ok
				and third_ok
			)

			final_ok
		_:
			False


