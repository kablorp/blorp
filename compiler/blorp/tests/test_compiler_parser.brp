func test_parse_postfix_call_field_subscript_chain() -> Bool:
	program = parse_compiler_source(
		source("func first_name(items: List[Person]) -> String: items[0].name.upper()"),
	)

	match program.decls.get(0):
		Some(FunctionParsedDecl(function_decl)):
			match function_decl.body:
				Some(ParsedCallExpr(callee, args, _)):
					callee_ok: Bool = match callee:
						ParsedFieldAccessExpr(receiver, field, _):
							receiver_ok: Bool = match receiver:
								ParsedFieldAccessExpr(sub_receiver, sub_field, _):
									sub_receiver_ok: Bool = match sub_receiver:
										ParsedSubscriptExpr(index_receiver, indices, _):
											index_receiver_ok: Bool = match index_receiver:
												ParsedNameExpr(identifier):
													identifier.text == "items"
												_:
													False

											index_ok: Bool = match indices.get(0):
												Some(ParsedIntLiteralExpr(text, _)):
													text == "0"
												_:
													False

											index_receiver_ok and indices.length() == 1 and index_ok
										_:
											False

									sub_receiver_ok and sub_field.text == "name"
								_:
									False

							receiver_ok and field.text == "upper"
						_:
							False

					parsed_program_ok(program) and args.length() == 0 and callee_ok
				_:
					False
		_:
			False


