func test_parse_dimension_type_parameters() -> Bool:
	program_source: String = "type ParallelVector[T, #N] = builtin"
	program = parse_compiler_source(source(program_source))

	match program.decls.get(0):
		Some(BuiltinTypeParsedDecl(builtin_decl)):
			first_ok: Bool = type_param_at_matches(builtin_decl.type_params, 0, "T", 0)
			second_ok: Bool = type_param_at_matches(builtin_decl.type_params, 1, "#N", 0)

			(
				parsed_program_ok(program)
				and builtin_decl.type_params.length() == 2
				and first_ok
				and second_ok
			)
		_:
			False


func test_parse_builtin_type_argument_reports_error() -> Bool:
	program_source: String = "type WidgetHandle = builtin(\"blorp_widget_close\")"
	diagnostic_text: String = first_diagnostic_text(program_source)
	program = parse_compiler_source(source(program_source))

	(
		parsed_program_has_errors(program)
		and diagnostic_text.contains("builtin type declarations do not take arguments")
	)


func test_parse_type_alias_declaration() -> Bool:
	program = parse_compiler_source(source("type alias IntList = List[Int]"))

	match program.decls.get(0):
		Some(TypeAliasParsedDecl(alias_decl)):
			target_ok: Bool = match alias_decl.target:
				ParsedNamedType(name, args, _):
					name.text == "List" and args.length() == 1
				_:
					False

			ok: Bool = (
				parsed_program_ok(program)
				and alias_decl.name.text == "IntList"
				and not alias_decl.is_opaque
				and target_ok
			)

			ok
		_:
			False


func test_parse_opaque_type_alias_and_conversions() -> Bool:
	program_source: String = "opaque type UserId = Int\n\nfunc main() -> Int:\n\tid: UserId = into UserId(1)\n\traw: Int = from UserId(id)\n\traw"
	program = parse_compiler_source(source(program_source))

	match program.decls.get(0):
		Some(TypeAliasParsedDecl(alias_decl)):
			alias_ok: Bool = (
				alias_decl.name.text == "UserId"
				and alias_decl.is_opaque
				and type_expr_is_named(alias_decl.target, "Int")
			)

			body_ok: Bool = match program.decls.get(1):
				Some(FunctionParsedDecl(function_decl)):
					match function_decl.body:
						Some(ParsedBlockExpr(items, _)):
							into_ok: Bool = match items.get(0):
								Some(ParsedVarDeclExpr(name, type_expr, value, is_mutable, _)):
									(
										name.text == "id"
										and not is_mutable
										and optional_type_expr_is_named(type_expr, "UserId")
										and expr_is_opaque_into_named_int(value, "UserId", "1")
									)
								_:
									False

							from_ok: Bool = match items.get(1):
								Some(ParsedVarDeclExpr(name, type_expr, value, is_mutable, _)):
									(
										name.text == "raw"
										and not is_mutable
										and optional_type_expr_is_named(type_expr, "Int")
										and expr_is_opaque_from_named_name(value, "UserId", "id")
									)
								_:
									False

							return_ok: Bool = match items.get(2):
								Some(expr):
									expr_is_name(expr, "raw")
								None:
									False

							items.length() == 3 and into_ok and from_ok and return_ok
						_:
							False
				_:
					False

			parsed_program_ok(program) and alias_ok and body_ok
		_:
			False


func test_parse_bounded_type_parameters_and_array_range_types() -> Bool:
	program_source: String = "pure func argmax[T:Orderable, #N](arr: T[#N]) -> ..#N:\n\t0"
	program = parse_compiler_source(source(program_source))

	match program.decls.get(0):
		Some(FunctionParsedDecl(function_decl)):
			type_param_ok: Bool = type_param_first_bound_matches(
				function_decl.type_params,
				0,
				"T",
				"Orderable",
			)
			dim_param_ok: Bool = type_param_at_matches(function_decl.type_params, 1, "#N", 0)

			param_type_ok: Bool = match function_decl.params.get(0):
				Some(param):
					match param.type_expr:
						Some(type_expr):
							type_expr_is_named_array_with_dim(type_expr, "T", "#N")
						None:
							False
				None:
					False

			return_type_ok: Bool = optional_type_is_range_dim(function_decl.return_type, "#N")

			(
				parsed_program_ok(program)
				and type_param_ok
				and dim_param_ok
				and param_type_ok
				and return_type_ok
			)
		_:
			False


func test_parse_range_type_requires_hash_dimension() -> Bool:
	program_source: String = "func main(args: List[String]) -> Int:\n\tx: ..5 = 3\n\t0"
	program = parse_compiler_source(source(program_source))

	parsed_program_has_errors(program) and program.diagnostics.length() > 0


func test_parse_function_type_parameter() -> Bool:
	program_source: String = "pure func parallel[T, U, #N](\n\tself: T[#N],\n\tbody: pure (ParallelVector[T, #N]) -> ParallelVector[U, #N],\n) -> U[#N]:\n\tbuiltin(\"std/vector.parallel\")"
	program = parse_compiler_source(source(program_source))

	match program.decls.get(0):
		Some(FunctionParsedDecl(function_decl)):
			match function_decl.params.get(1):
				Some(param):
					match param.type_expr:
						Some(ParsedFunctionType(is_pure, params, return_type, _)):
							param_ok: Bool = match params.get(0):
								Some(ParsedNamedType(name, args, _)):
									name.text == "ParallelVector" and args.length() == 2
								_:
									False

							return_ok: Bool = match return_type:
								ParsedNamedType(name, args, _):
									name.text == "ParallelVector" and args.length() == 2
								_:
									False

							parsed_program_ok(program) and is_pure and param_ok and return_ok
						_:
							False
				None:
					False
		_:
			False


func test_parse_function_type_single_tuple_parameter() -> Bool:
	program_source: String = "func apply(\n\tcallback: ((Int, String)) -> Int,\n) -> Int:\n\t0"
	program = parse_compiler_source(source(program_source))

