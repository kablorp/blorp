func test_parse_while_and_for_statements_in_block() -> Bool:
	program_source: String = "func run(xs: List[Int]):\n\twhile ready:\n\t\ttick()\n\tfor x in xs:\n\t\tuse(x)"
	program = parse_compiler_source(source(program_source))

	match program.decls.get(0):
		Some(FunctionParsedDecl(function_decl)):
			match function_decl.body:
				Some(ParsedBlockExpr(items, _)):
					while_ok: Bool = match items.get(0):
						Some(ParsedWhileExpr(cond, body, _)):
							cond_ok: Bool = match cond:
								ParsedNameExpr(identifier):
									identifier.text == "ready"
								_:
									False

							body_ok: Bool = match body:
								ParsedBlockExpr(body_items, _):
									body_items.length() == 1
								_:
									False

							cond_ok and body_ok
						_:
							False

					for_ok: Bool = match items.get(1):
						Some(ParsedForExpr(binder, iter, body, _)):
							iter_ok: Bool = match iter:
								ParsedNameExpr(identifier):
									identifier.text == "xs"
								_:
									False

							body_ok: Bool = match body:
								ParsedBlockExpr(body_items, _):
									body_items.length() == 1
								_:
									False

							for_binder_is_name(binder, "x") and iter_ok and body_ok
						_:
							False

					parsed_program_ok(program) and items.length() == 2 and while_ok and for_ok
				_:
					False
		_:
			False


