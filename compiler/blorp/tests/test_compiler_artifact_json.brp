import:
	../compiler_artifact_json:
		CArtifact,
		CArtifactJsonError(
			ExpectedStringArrayField,
			ExpectedStringField,
			ExpectedTopLevelObject,
			MissingField,
		),
		c_artifact_error_to_string,
		c_artifact_to_json,
		decode_c_artifact_json,
	json: JsonValue(JsonBool, JsonNull, JsonNumber, JsonObject, JsonString, JsonVector)
	test: TestSuite


func sample_artifact() -> CArtifact:
	{
		c_code = "int main(void) { return 0; }\n",
		link_flags = ["-lm", "-lpthread"],
		include_dirs = ["runtime/include", "pkg/include"]
	}


func strings_equal(left: List[String], right: List[String]) -> Bool:
	if left.length() != right.length():
		False
	else:
		var index: Int = 0
		var ok: Bool = True

		while index < left.length():
			if ok:
				match left.get(index):
					Some(left_item):
						match right.get(index):
							Some(right_item):
								ok = left_item == right_item
							None:
								ok = False
					None:
						ok = False

			index += 1

		ok


func artifacts_equal(left: CArtifact, right: CArtifact) -> Bool:
	(
		left.c_code == right.c_code
		and strings_equal(left.link_flags, right.link_flags)
		and strings_equal(left.include_dirs, right.include_dirs)
	)


func test_artifact_json_round_trips() -> Bool:
	artifact: CArtifact = sample_artifact()

	match decode_c_artifact_json(c_artifact_to_json(artifact)):
		Ok(decoded):
			artifacts_equal(decoded, artifact)
		Err(ExpectedTopLevelObject):
			False
		Err(MissingField(field_name)):
			False
		Err(ExpectedStringField(field_name)):
			False
		Err(ExpectedStringArrayField(field_name)):
			False


func test_artifact_json_preserves_empty_lists() -> Bool:
	artifact: CArtifact = {
		c_code = "void f(void) {}\n",
		link_flags = [],
		include_dirs = []
	}

	match decode_c_artifact_json(c_artifact_to_json(artifact)):
		Ok(decoded):
			(
				decoded.c_code == artifact.c_code
				and decoded.link_flags.length() == 0
				and decoded.include_dirs.length() == 0
			)
		Err(ExpectedTopLevelObject):
			False
		Err(MissingField(field_name)):
			False
		Err(ExpectedStringField(field_name)):
			False
		Err(ExpectedStringArrayField(field_name)):
			False


func test_artifact_json_rejects_missing_c_code() -> Bool:
	value: JsonValue = JsonObject([
		("link_flags", JsonVector([])),
		("include_dirs", JsonVector([])),
	])

	match decode_c_artifact_json(value):
		Ok(artifact):
			False
		Err(ExpectedTopLevelObject):
			False
		Err(MissingField(field_name)):
			field_name == "c_code"
		Err(ExpectedStringField(field_name)):
			False
		Err(ExpectedStringArrayField(field_name)):
			False


func test_artifact_json_rejects_non_string_c_code() -> Bool:
	value: JsonValue = JsonObject([
		("c_code", JsonNumber(1.0)),
		("link_flags", JsonVector([])),
		("include_dirs", JsonVector([])),
	])

	match decode_c_artifact_json(value):
		Ok(artifact):
			False
		Err(ExpectedTopLevelObject):
			False
		Err(MissingField(field_name)):
			False
		Err(ExpectedStringField(field_name)):
			field_name == "c_code"
		Err(ExpectedStringArrayField(field_name)):
			False


func test_artifact_json_rejects_non_string_link_flag() -> Bool:
	value: JsonValue = JsonObject([
		("c_code", JsonString("int main(void) { return 0; }\n")),
		("link_flags", JsonVector([JsonString("-lm"), JsonBool(True)])),
		("include_dirs", JsonVector([])),
	])

	match decode_c_artifact_json(value):
		Ok(artifact):
			False
		Err(ExpectedTopLevelObject):
			False
		Err(MissingField(field_name)):
			False
		Err(ExpectedStringField(field_name)):
			False
		Err(ExpectedStringArrayField(field_name)):
			field_name == "link_flags"


func test_artifact_json_rejects_non_object() -> Bool:
	match decode_c_artifact_json(JsonNull):
		Ok(artifact):
			False
		Err(ExpectedTopLevelObject):
			True
		Err(MissingField(field_name)):
			False
		Err(ExpectedStringField(field_name)):
			False
		Err(ExpectedStringArrayField(field_name)):
			False


func test_artifact_json_error_strings_are_stable() -> Bool:
	(
		c_artifact_error_to_string(ExpectedTopLevelObject) == "C artifact JSON must be an object"
		and c_artifact_error_to_string(MissingField("c_code")) == "missing C artifact field: c_code"
		and c_artifact_error_to_string(
			ExpectedStringField("c_code"),
		) == "C artifact field `c_code` must be a string"
		and c_artifact_error_to_string(
			ExpectedStringArrayField(
				"link_flags",
			),
		) == "C artifact field `link_flags` must be an array of strings"
	)


tests: TestSuite = {
	description = "Blorp compiler C artifact JSON",
	tests = [
		("artifact JSON round trips", test_artifact_json_round_trips),
		("artifact JSON preserves empty lists", test_artifact_json_preserves_empty_lists),
		("artifact JSON rejects missing c_code", test_artifact_json_rejects_missing_c_code),
		("artifact JSON rejects non-string c_code", test_artifact_json_rejects_non_string_c_code),
		(
			"artifact JSON rejects non-string link flag",
			test_artifact_json_rejects_non_string_link_flag,
		),
		("artifact JSON rejects non-object", test_artifact_json_rejects_non_object),
		("artifact JSON error strings are stable", test_artifact_json_error_strings_are_stable),
	]
}
