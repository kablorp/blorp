import:
	../compiler_artifact_json: CArtifact, c_artifact_to_json
	json: JsonValue(JsonObject), as_array, as_string, get_field
	test: TestSuite, run_suite


func sample_artifact() -> CArtifact:
	{
		c_code = "int main(void) { return 0; }\n",
		link_flags = ["-lm", "-lpthread"],
		include_dirs = ["runtime/include", "pkg/include"]
	}


func string_field_is(value: JsonValue, name: String, expected: String) -> Bool:
	match get_field(value, name):
		Some(field):
			match as_string(field):
				Some(text):
					text == expected
				None:
					False
		None:
			False


func string_array_field_is(value: JsonValue, name: String, expected: List[String]) -> Bool:
	match get_field(value, name):
		Some(field):
			match as_array(field):
				Some(items):
					if items.length() != expected.length():
						False
					else:
						var index: Int = 0
						var ok: Bool = True

						while index < items.length():
							if ok:
								match items.get(index):
									Some(item):
										match expected.get(index):
											Some(expected_item):
												match as_string(item):
													Some(text):
														ok = text == expected_item
													None:
														ok = False
											None:
												ok = False
									None:
										ok = False

							index += 1

						ok
				None:
					False
		None:
			False


func test_artifact_json_has_fields() -> Bool:
	value: JsonValue = c_artifact_to_json(sample_artifact())

	string_field_is(value, "c_code", "int main(void) { return 0; }\n") and string_array_field_is(
		value,
		"link_flags",
		["-lm", "-lpthread"],
	) and string_array_field_is(
		value,
		"include_dirs",
		["runtime/include", "pkg/include"],
	)


func test_artifact_json_preserves_empty_lists() -> Bool:
	artifact: CArtifact = {
		c_code = "void f(void) {}\n",
		link_flags = [],
		include_dirs = []
	}
	value: JsonValue = c_artifact_to_json(artifact)

	(
		string_field_is(value, "c_code", artifact.c_code)
		and string_array_field_is(value, "link_flags", [])
		and string_array_field_is(value, "include_dirs", [])
	)


tests: TestSuite = {
	description = "Blorp compiler C artifact JSON",
	tests = [
		("artifact JSON has fields", test_artifact_json_has_fields),
		("artifact JSON preserves empty lists", test_artifact_json_preserves_empty_lists),
	]
}


func main(args: List[String]) -> Int:
	if run_suite(tests):
		0
	else:
		1
