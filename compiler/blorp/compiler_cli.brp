-- Blorp-owned outer CLI wrapper.
--
-- This is intentionally a migration shell: Blorp owns argument parsing and
-- dispatch planning, while command execution delegates to the existing OCaml CLI
-- until each command is ported inward.
import:
	compiler_bridge_protocol:
		BRIDGE_DOMAIN,
		BRIDGE_SCHEMA_VERSION,
		BridgeEnvelope,
		bridge_success_json,
	compiler_cli_args:
		CliAction(
			CliCheck,
			CliCheckHelp,
			CliCompile,
			CliCompileHelp,
			CliCompilerBridge,
			CliCompilerBridgePrepare,
			CliError,
			CliFormat,
			CliLsp,
			CliPackage,
			CliPurify,
			CliPurifyHelp,
			CliRepl,
			CliRun,
			CliRunHelp,
			CliTest,
			CliTestHelp,
			CliTestWarmupOnly,
			CliUsage,
			CliVersion,
		),
		CliPackageAction(
			CliPackageCheck,
			CliPackageCheckHelp,
			CliPackageFetchAll,
			CliPackageFetchHelp,
			CliPackageFetchTarget,
			CliPackageHash,
			CliPackageHashHelp,
			CliPackageHelp,
			CliPackagePack,
			CliPackagePackHelp,
			CliPackageVendorAll,
			CliPackageVendorHelp,
			CliPackageVendorTarget,
		),
		CliReplAction(CliReplHelp, CliReplRun),
		CliSanitizerMode(CliSanitizeAddressUndefined, CliSanitizeOff, CliSanitizeUndefined),
		CliTestMode(CliTestAll, CliTestDocOnly, CliTestSuiteOnly),
		parse_cli_args,
	compiler_format: FormatCommandResult, run_format_command
	compiler_parser_bridge as ParserBridge
	fs: message, open_read
	json:
		JsonValue(JsonBool, JsonNull, JsonNumber, JsonObject, JsonString, JsonVector),
		as_array,
		as_string,
		get_field,
	path: join, normalize, stem
	system: getcwd, is_directory


private CLI_WRAPPER_ERROR_EXIT: Int = 1

private CLI_WRAPPER_SUCCESS_EXIT: Int = 0

private TOP_LEVEL_USAGE: String =
	|blorp - Blorp Compiler
	|
	|Usage: blorp <command> [options] [args]
	|
	|Commands:
	|  check      Parse, import, and type check .brp files
	|  compile    Compile a .brp file to C
	|  run        Compile and run a .brp file
	|  test       Run tests (file or directory)
	|  format     Format source files
	|  package    Validate source packages
	|  lsp        Start LSP server
	|  repl       Interactive REPL
	|  purify     Automatically mark pure functions
	|
	|Flags:
	|  --version  Show version
	|  --help     Show this help
	|
	|Run 'blorp <command> --help' for details on a specific command.
	|
	|Project config:
	|  blorp.toml          Optional project config; [std].path sets std directory
	|
	|Environment:
	|  BLORP_STD=<path>      Use std directory (--std-dir overrides; beats blorp.toml)
	|  BLORP_TIMEOUT=N       Default timeout (CLI flag overrides)
	|  BLORP_TEST_TIMEOUT=N  Default test timeout (test --timeout overrides)
	|  BLORP_SANITIZE=1|address|undefined
	|                         Enable sanitizers (CLI flag overrides)
	|  BLORP_LEAK_CHECK=1    Enable leak reporting (CLI flag overrides)
	|  BLORP_TLS_BACKEND=unsupported|openssl
	|                         Select runtime TLS backend profile (default: unsupported)
	|  BLORP_THREADS=N       Runtime worker thread pool size (run --threads overrides)
	|  BLORP_NO_FORMAT=1     Skip auto-formatting (CLI flag overrides)

private CHECK_HELP: String =
	|Usage: blorp check [options] <file.brp|dir> [...]
	|
	|Options:
	|  --dump-ast                Print AST summary and continue checking
	|  --dump-typed-ast          Print typed AST and continue checking
	|  --debug                   Enable debug functions
	|  --no-format               Skip auto-formatting
	|  --std-dir <d>             Use std library from directory
	|
	|Accepts files or directories (recursively finds .brp files).

private COMPILE_HELP: String =
	|Usage: blorp compile [options] <file.brp>
	|
	|Options:
	|  --ast                     Print AST and exit (no typecheck, no emit)
	|  --dump-ast                Print AST summary and continue compiling
	|  --dump-typed-ast          Print typed AST and continue compiling
	|  --dump-core               Dump Core IR at the final stage
	|  --dump-core-after=STAGE[,STAGE...]
	|                            Dump Core IR after the given stage(s);
	|                            repeatable and comma-separated both work
	|  --dump-core-file=PATH     Redirect --dump-core output to PATH
	|  --stop-after=STAGE        Stop after the given stage (implies no emit)
	|                            STAGE: lower, debug, desugar, mono, synth, match,
	|                                   trait_resolve, resolve, std_inline, tailrec, fusion,
	|                                   specialize, dce, perceus, reuse, closure, final
	|  --time-phases             Print per-phase compiler wall time to stderr
	|  --check-invariants        Run post-stage IR invariant checks (slower; use for debugging)
	|  --debug                   Enable debug functions
	|  --no-format               Skip auto-formatting
	|  --no-embed-runtime        Emit C that expects an external runtime declaration/header
	|  --std-dir <d>             Use std library from directory
	|  -o <file>                 Output C file path

private RUN_HELP: String =
	|Usage: blorp run [options] <file.brp> [-- args...]
	|
	|Options:
	|  --profile      Run with profiling
	|  --release      Compile generated C with -O2
	|  --debug        Enable debug functions
	|  --sanitize     Compile with AddressSanitizer + UBSan
	|  --sanitize=undefined
	|                 Compile with UBSan only (useful for fiber-heavy runs on Darwin)
	|  --leak-check   Report leaked objects on exit
	|  --no-format    Skip auto-formatting
	|  --timeout N    Kill after N seconds
	|  --threads N    Set max thread pool size
	|  --std-dir <d>  Use std library from directory

private TEST_HELP: String =
	|Usage: blorp test [options] <file.brp | directory> ...
	|
	|Options:
	|  --profile      Run with profiling
	|  --debug        Enable debug functions
	|  --sanitize     Run with AddressSanitizer + UBSan
	|  --sanitize=undefined
	|                 Run with UBSan only (useful for fiber-heavy tests on Darwin)
	|  --leak-check   Report leaked objects on exit
	|  --timeout N    Kill each test after N seconds (default: BLORP_TEST_TIMEOUT, BLORP_TIMEOUT, or 30; 0 disables)
	|  --repeat N     Run selected tests N times; disables result caching for this run
	|  -j N           Run tests with N parallel workers
	|  --doc          Run only doctests
	|  --suite        Run only TestSuite tests
	|  --no-format    Skip auto-formatting before test
	|  --no-cache     Disable test result caching
	|  --warmup-only  Pre-warm runtime artifacts, then exit
	|  --std-dir <d>  Use std library from directory

private PURIFY_HELP: String =
	|Usage: blorp purify [options] <file.brp|dir>
	|
	|Options:
	|  --dry-run      Show which functions would be purified without modifying the file
	|  --verbose, -v  Show detailed purification progress

private REPL_HELP: String =
	|Usage: blorp repl [options]
	|
	|Options:
	|  --debug      Enable debug functions
	|  --help, -h   Show this help

private LSP_HELP: String =
	|Usage: blorp lsp
	|
	|Starts the Language Server Protocol server over stdin/stdout.
	|
	|Options:
	|  --help, -h   Show this help

private PACKAGE_HELP: String =
	|Usage: blorp package <command> [args]
	|
	|Commands:
	|  check <path>          Validate a portable source package directory
	|  hash <path>           Print a portable source package BLAKE3 hash
	|  pack <path> -o <file> Write a deterministic .blorpkg artifact
	|  fetch [hash-or-alias [from ...]] Cache verified package artifacts
	|  vendor [hash-or-alias [path]] Copy cached packages into vendor dirs
	|
	|A source package contains package.toml plus src/*.brp files.
	|Package code may import only std modules and modules from the same package.

private PACKAGE_CHECK_HELP: String =
	|Usage: blorp package check <path>
	|
	|Validates package.toml, exported source files, imports, and the
	|portable-source policy: no foreign declarations and no builtin use.

private PACKAGE_HASH_HELP: String =
	|Usage: blorp package hash <path>
	|
	|Validates a source package and prints its canonical BLAKE3 content hash.

private PACKAGE_PACK_HELP: String =
	|Usage: blorp package pack <path> -o <file>
	|
	|Validates a source package and writes a deterministic source artifact.

private PACKAGE_FETCH_HELP: String =
	|Usage: blorp package fetch
	|       blorp package fetch <alias>
	|       blorp package fetch <hash> <from>...
	|
	|Without arguments, fetches all downloadable packages from blorp.toml.
	|With explicit locations, installs the first matching artifact.
	|With an alias, reads hash and from from the nearest blorp.toml.
	|Locations may be local paths, file:// URLs, or HTTP(S) artifact URLs.

private PACKAGE_VENDOR_HELP: String =
	|Usage: blorp package vendor
	|       blorp package vendor <hash> <path>
	|       blorp package vendor <alias> [path]
	|
	|Without arguments, vendors cached packages from blorp.toml to vendor/<alias>.
	|With an alias, reads the nearest blorp.toml.
	|With a hash, pass an explicit destination path.


enum CliDelegationIo:
	BatchCliDelegation
	TerminalCliDelegation


record LegacyCliDelegation {
	args: List[String],
	io: CliDelegationIo
}


record CliHandledResult {
	status: Int,
	stdout: String,
	stderr: String
}


record CliRunContext {
	version: Option[String]
}


record CliRunRequest {
	args: List[String],
	version: Option[String]
}


union CliRunPlan:
	CliRunHandled(CliHandledResult)
	CliRunDelegate(LegacyCliDelegation)
	CliRunParsedSource(CliFrontendParsedSource)
	CliRunFrontendOptions(CliFrontendOptionsPlan)
	CliRunTest(CliTestRunPlan)
	CliRunPurify(CliPurifyRunPlan)
	CliRunRepl(CliReplRunPlan)
	CliRunLsp(CliLspRunPlan)
	CliRunPackage(CliPackageRunPlan)


enum CliFrontendCommand:
	CliFrontendCheck
	CliFrontendCompile
	CliFrontendRun


record CliFrontendParsedSource {
	command: CliFrontendCommand,
	args: List[String],
	options: JsonValue,
	path: String,
	module_name: String,
	parsed_source: JsonValue
}


record CliFrontendOptionsPlan {
	command: CliFrontendCommand,
	args: List[String],
	options: JsonValue
}


record CliTestRunPlan {
	args: List[String],
	options: JsonValue
}


record CliPurifyRunPlan {
	args: List[String],
	options: JsonValue
}


record CliReplRunPlan {
	args: List[String],
	debug: Bool
}


record CliLspRunPlan {
	args: List[String]
}


union CliPackageRunCommand:
	CliPackageRunCheck(String)
	CliPackageRunHash(String)
	CliPackageRunPack(String, String)
	CliPackageRunFetchAll
	CliPackageRunFetchTarget(String, List[String])
	CliPackageRunVendorAll
	CliPackageRunVendorTarget(String, Option[String])


record CliPackageRunPlan {
	args: List[String],
	command: CliPackageRunCommand
}


private pure func action_needs_terminal_io(action: CliAction) -> Bool:
	match action:
		CliRun(_):
			True
		CliRepl(_):
			True
		CliLsp(_):
			True
		CliCompilerBridge(args):
			args.length() == 0
		CliCompilerBridgePrepare(_):
			False
		_:
			False


private pure func cli_frontend_command_name(command: CliFrontendCommand) -> String:
	match command:
		CliFrontendCheck:
			"check"
		CliFrontendCompile:
			"compile"
		CliFrontendRun:
			"run"


private pure func delegation_io_name(io: CliDelegationIo) -> String:
	match io:
		BatchCliDelegation:
			"batch"
		TerminalCliDelegation:
			"terminal"


private pure func delegation_io_for_action(action: CliAction) -> CliDelegationIo:
	if action_needs_terminal_io(action):
		TerminalCliDelegation
	else:
		BatchCliDelegation


private pure func cli_result(status: Int, stdout: String, stderr: String) -> CliHandledResult:
	{
		status = status,
		stdout = stdout,
		stderr = stderr
	}


private pure func handled_error(message: String) -> CliRunPlan:
	CliRunHandled(cli_result(CLI_WRAPPER_ERROR_EXIT, "", message + "\n"))


private pure func handled_stdout(text: String) -> CliRunPlan:
	CliRunHandled(cli_result(CLI_WRAPPER_SUCCESS_EXIT, text + "\n", ""))


private pure func handled_stdout_with_status(status: Int, text: String) -> CliRunPlan:
	CliRunHandled(cli_result(status, text + "\n", ""))


private pure func format_handled_result(format_result: FormatCommandResult) -> CliHandledResult:
	cli_result(format_result.status, format_result.stdout, format_result.stderr)


private pure func help_text_for_action(action: CliAction) -> Option[String]:
	match action:
		CliCheckHelp:
			Some(CHECK_HELP)
		CliCompileHelp:
			Some(COMPILE_HELP)
		CliRunHelp:
			Some(RUN_HELP)
		CliTestHelp:
			Some(TEST_HELP)
		CliPurifyHelp:
			Some(PURIFY_HELP)
		CliLsp(CliLspHelp):
			Some(LSP_HELP)
		CliRepl(CliReplHelp):
			Some(REPL_HELP)
		CliPackage(CliPackageHelp):
			Some(PACKAGE_HELP)
		CliPackage(CliPackageCheckHelp):
			Some(PACKAGE_CHECK_HELP)
		CliPackage(CliPackageHashHelp):
			Some(PACKAGE_HASH_HELP)
		CliPackage(CliPackagePackHelp):
			Some(PACKAGE_PACK_HELP)
		CliPackage(CliPackageFetchHelp):
			Some(PACKAGE_FETCH_HELP)
		CliPackage(CliPackageVendorHelp):
			Some(PACKAGE_VENDOR_HELP)
		_:
			None


private pure func args_after_command(
	user_args: List[String],
	command: String,
) -> Option[List[String]]:
	match user_args:
		[head, ...rest]:
			if head == command:
				Some(rest)
			else:
				None
		[]:
			None


private pure func absolute_normalized_path(cwd: String, path: String) -> String:
	if path.starts_with("/"):
		normalize(path)
	else:
		normalize(join(cwd, path))


private pure func is_path_under_dir(dir: String, path: String) -> Bool:
	path == dir or path.starts_with(dir + "/")


private func should_auto_format_cli_source(path: String) -> Bool:
	cwd: String = getcwd()
	std_dir: String = normalize(join(cwd, "std"))
	source_path: String = absolute_normalized_path(cwd, path)

	not is_path_under_dir(std_dir, source_path)


private pure func action_uses_auto_format(action: CliAction) -> Bool:
	match action:
		CliCheck(args):
			not args.no_format
		CliCompile(args):
			not args.no_format
		CliRun(args):
			not args.no_format
		_:
			False


private func auto_format_cli_source_if_needed(action: CliAction, path: String) -> Void:
	if action_uses_auto_format(action) and should_auto_format_cli_source(path):
		_ = run_format_command([path])


private func parsed_source_plan_for_action(
	user_args: List[String],
	action: CliAction,
) -> Option[CliRunPlan]:
	match frontend_source_for_action(action):
		Some((command, path, options)):
			auto_format_cli_source_if_needed(action, path)

			match parse_cli_source_file(path):
				Ok((module_name, artifact)):
					Some(CliRunParsedSource({
						command = command,
						args = user_args,
						options = options,
						path = path,
						module_name = module_name,
						parsed_source = artifact,
					}))
				Err(message):
					Some(handled_error(message))
		None:
			None


private pure func frontend_options_plan_for_action(
	user_args: List[String],
	action: CliAction,
) -> Option[CliFrontendOptionsPlan]:
	match action:
		CliCompile(args):
			Some({
				command = CliFrontendCompile,
				args = user_args,
				options = cli_compile_options_json(args),
			})
		CliRun(args):
			Some({
				command = CliFrontendRun,
				args = user_args,
				options = cli_run_options_json(args),
			})
		CliCheck(args):
			Some({
				command = CliFrontendCheck,
				args = user_args,
				options = cli_check_options_json(args),
			})
		_:
			None


private func run_cli_with_context(user_args: List[String], context: CliRunContext) -> CliRunPlan:
	action: CliAction = parse_cli_args(user_args)

	match action:
		CliError(message):
			handled_error(message)
		CliUsage(status):
			handled_stdout_with_status(status, TOP_LEVEL_USAGE)
		CliVersion:
			match context.version:
				Some(version):
					handled_stdout(version)
				None:
					CliRunDelegate({
						args = user_args,
						io = delegation_io_for_action(action),
					})
		_:
			match help_text_for_action(action):
				Some(help_text):
					handled_stdout(help_text)
				None:
					match action:
						CliFormat(_):
							match args_after_command(user_args, "format"):
								Some(format_args):
									CliRunHandled(
										format_handled_result(run_format_command(format_args)),
									)
								None:
									handled_error(
										"internal error: format command missing from CLI args",
									)
						CliTest(args):
							CliRunTest({
								args = user_args,
								options = cli_test_options_json(args),
							})
						CliTestWarmupOnly:
							CliRunTest({
								args = user_args,
								options = cli_test_warmup_options_json(),
							})
						CliPurify(args):
							CliRunPurify({
								args = user_args,
								options = cli_purify_options_json(args),
							})
						CliRepl(repl_action):
							match repl_action:
								CliReplRun(repl_debug):
									CliRunRepl({
										args = user_args,
										debug = repl_debug,
									})
								CliReplHelp:
									handled_stdout(REPL_HELP)
						CliLsp(CliLspRun):
							CliRunLsp({args = user_args})
						CliLsp(CliLspHelp):
							handled_stdout(LSP_HELP)
						CliPackage(package_action):
							match package_action:
								CliPackageHelp:
									handled_stdout(PACKAGE_HELP)
								CliPackageCheckHelp:
									handled_stdout(PACKAGE_CHECK_HELP)
								CliPackageCheck(path):
									CliRunPackage({
										args = user_args,
										command = CliPackageRunCheck(path),
									})
								CliPackageHashHelp:
									handled_stdout(PACKAGE_HASH_HELP)
								CliPackageHash(path):
									CliRunPackage({
										args = user_args,
										command = CliPackageRunHash(path),
									})
								CliPackagePackHelp:
									handled_stdout(PACKAGE_PACK_HELP)
								CliPackagePack(pack_args):
									CliRunPackage({
										args = user_args,
										command = CliPackageRunPack(
											pack_args.path,
											pack_args.output,
										),
									})
								CliPackageFetchHelp:
									handled_stdout(PACKAGE_FETCH_HELP)
								CliPackageFetchAll:
									CliRunPackage({
										args = user_args,
										command = CliPackageRunFetchAll,
									})
								CliPackageFetchTarget(target, locations):
									CliRunPackage({
										args = user_args,
										command = CliPackageRunFetchTarget(target, locations),
									})
								CliPackageVendorHelp:
									handled_stdout(PACKAGE_VENDOR_HELP)
								CliPackageVendorAll:
									CliRunPackage({
										args = user_args,
										command = CliPackageRunVendorAll,
									})
								CliPackageVendorTarget(target, dest):
									CliRunPackage({
										args = user_args,
										command = CliPackageRunVendorTarget(target, dest),
									})
						_:
							match parsed_source_plan_for_action(user_args, action):
								Some(plan):
									plan
								None:
									match frontend_options_plan_for_action(user_args, action):
										Some(frontend_options):
											CliRunFrontendOptions(frontend_options)
										None:
											CliRunDelegate({
												args = user_args,
												io = delegation_io_for_action(action),
											})


func run_cli(user_args: List[String]) -> CliRunPlan:
	run_cli_with_context(user_args, {version = None})


func run_cli_with_version(user_args: List[String], version: String) -> CliRunPlan:
	run_cli_with_context(user_args, {version = Some(version)})


private pure func single_path(paths: List[String]) -> Option[String]:
	match paths:
		[path]:
			Some(path)
		_:
			None


private func frontend_source_for_action(
	action: CliAction,
) -> Option[(CliFrontendCommand, String, JsonValue)]:
	match action:
		CliCompile(args):
			match single_path(args.files):
				Some(path):
					Some((CliFrontendCompile, path, cli_compile_options_json(args)))
				None:
					None
		CliRun(args):
			match single_path(args.files):
				Some(path):
					Some((CliFrontendRun, path, cli_run_options_json(args)))
				None:
					None
		CliCheck(args):
			match single_path(args.paths):
				Some(path):
					if is_directory(path):
						None
					else:
						Some((CliFrontendCheck, path, cli_check_options_json(args)))
				None:
					None
		_:
			None


private func read_text_file(path: String) -> Result[String, String]:
	with reader ?= open_read(path) on err => message(err):
		match reader.read_text():
			Ok(source):
				Ok(source)
			Err(err):
				Err(message(err))


private pure func module_name_for_cli_path(path: String) -> String:
	stem(path)


private pure func parse_source_request_value(
	path: String,
	module_name: String,
	source: String,
) -> JsonValue:
	JsonObject([
		("schema", JsonNumber(to_float(BRIDGE_SCHEMA_VERSION))),
		("domain", JsonString(BRIDGE_DOMAIN)),
		("action", JsonString("parse_source")),
		("payload", JsonObject([
				("path", JsonString(path)),
				("module", JsonString(module_name)),
				("text", JsonString(source)),
			])),
	])


private pure func parser_artifact(response: JsonValue) -> Result[JsonValue, String]:
	match get_field(response, "ok"):
		Some(JsonBool(True)):
			match get_field(response, "artifact"):
				Some(artifact):
					Ok(artifact)
				None:
					Err("parser response missing artifact")
		Some(JsonBool(False)):
			match get_field(response, "error"):
				Some(error):
					match get_field(error, "message"):
						Some(message):
							match as_string(message):
								Some(text):
									Err(text)
								None:
									Err("parser response error message was not a string")
						None:
							Err("parser response missing error message")
				None:
					Err("parser response missing error object")
		_:
			Err("parser response missing ok flag")


private func parse_cli_source_file(path: String) -> Result[(String, JsonValue), String]:
	source ?= read_text_file(
		path,
	).map_err(
		func(err): "failed to read source file `" + path + "`: " + err,
	)
	module_name: String = module_name_for_cli_path(path)
	response: JsonValue = ParserBridge.handle_request_value(
		parse_source_request_value(
			path,
			module_name,
			source,
		),
	)
	artifact ?= parser_artifact(response)
	Ok((module_name, artifact))


private pure func json_string_list(values: List[String]) -> JsonValue:
	var items: List[JsonValue] = []

	for value in values:
		items = items.append(JsonString(value))

	JsonVector(items)


private pure func json_optional_string(value: Option[String]) -> JsonValue:
	match value:
		Some(text):
			JsonString(text)
		None:
			JsonNull


private pure func json_optional_int(value: Option[Int]) -> JsonValue:
	match value:
		Some(number):
			JsonNumber(to_float(number))
		None:
			JsonNull


private pure func cli_sanitizer_mode_name(mode: CliSanitizerMode) -> String:
	match mode:
		CliSanitizeOff:
			"off"
		CliSanitizeAddressUndefined:
			"address_undefined"
		CliSanitizeUndefined:
			"undefined"


private pure func json_optional_sanitizer_mode(value: Option[CliSanitizerMode]) -> JsonValue:
	match value:
		Some(mode):
			JsonString(cli_sanitizer_mode_name(mode))
		None:
			JsonNull


