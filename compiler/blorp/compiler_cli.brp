	|Usage: blorp package check <path>
	|
	|Validates package.toml, exported source files, imports, and the
	|portable-source policy: no foreign declarations and no builtin use.

private PACKAGE_HASH_HELP: String =
	|Usage: blorp package hash <path>
	|
	|Validates a source package and prints its canonical BLAKE3 content hash.

private PACKAGE_PACK_HELP: String =
	|Usage: blorp package pack <path> -o <file>
	|
	|Validates a source package and writes a deterministic source artifact.

private PACKAGE_FETCH_HELP: String =
	|Usage: blorp package fetch
	|       blorp package fetch <alias>
	|       blorp package fetch <hash> <from>...
	|
	|Without arguments, fetches all downloadable packages from blorp.toml.
	|With explicit locations, installs the first matching artifact.
	|With an alias, reads hash and from from the nearest blorp.toml.
	|Locations may be local paths, file:// URLs, or HTTP(S) artifact URLs.

private PACKAGE_VENDOR_HELP: String =
	|Usage: blorp package vendor
	|       blorp package vendor <hash> <path>
	|       blorp package vendor <alias> [path]
	|
	|Without arguments, vendors cached packages from blorp.toml to vendor/<alias>.
	|With an alias, reads the nearest blorp.toml.
	|With a hash, pass an explicit destination path.


enum CliDelegationIo:
	BatchCliDelegation
	TerminalCliDelegation


record LegacyCliDelegation {
	args: List[String],
	io: CliDelegationIo
}


record CliHandledResult {
	status: Int,
	stdout: String,
	stderr: String
}


record CliRunContext {
	version: Option[String]
}


record CliRunRequest {
	args: List[String],
	version: Option[String]
}


union CliRunPlan:
	CliRunHandled(CliHandledResult)
	CliRunDelegate(LegacyCliDelegation)
	CliRunParsedSource(CliFrontendParsedSource)
	CliRunParsedSourceBatch(CliCheckSourceBatch)
	CliRunFrontendOptions(CliFrontendOptionsPlan)
	CliRunTest(CliTestRunPlan)
	CliRunPurify(CliPurifyRunPlan)
	CliRunRepl(CliReplRunPlan)
	CliRunLsp(CliLspRunPlan)
	CliRunPackage(CliPackageRunPlan)


enum CliFrontendCommand:
	CliFrontendCheck
	CliFrontendCompile
	CliFrontendRun


union CliSourceTarget:
	CliSourceFileTarget(String)
	CliSourceDirectoryTarget(String)


record CliCheckTargetExpansion {
	targets: List[CliSourceTarget],
	source_paths: List[String]
}


record CliSourceFile {
	path: String,
	module_name: String,
	source_text: String
}


record CliParsedSourceFile {
	path: String,
	module_name: String,
	source_text: String,
	parsed_source: JsonValue
}


record CliCheckSourceBatch {
	args: List[String],
	options: JsonValue,
	sources: List[CliParsedSourceFile],
	modules: List[CliParsedSourceFile]
}


record CliFrontendParsedSource {
	command: CliFrontendCommand,
	args: List[String],
	options: JsonValue,
	source: CliParsedSourceFile,
	modules: List[CliParsedSourceFile]
}


record CliFrontendOptionsPlan {
	command: CliFrontendCommand,
	args: List[String],
	options: JsonValue
}


record CliTestRunPlan {
	args: List[String],
	options: JsonValue
}


record CliPurifyRunPlan {
	args: List[String],
	options: JsonValue
}


record CliReplRunPlan {
	args: List[String],
	debug: Bool
}


record CliLspRunPlan {
	args: List[String]
}


union CliPackageRunCommand:
	CliPackageRunCheck(String)
	CliPackageRunHash(String)
	CliPackageRunPack(String, String)
	CliPackageRunFetchAll
	CliPackageRunFetchTarget(String, List[String])
	CliPackageRunVendorAll
	CliPackageRunVendorTarget(String, Option[String])


record CliPackageRunPlan {
	args: List[String],
	command: CliPackageRunCommand
}


private pure func action_needs_terminal_io(action: CliAction) -> Bool:
	match action:
		CliRun(_):
			True
		CliRepl(_):
			True
		CliLsp(_):
			True
		_:
			False


private pure func cli_frontend_command_name(command: CliFrontendCommand) -> String:
	match command:
		CliFrontendCheck:
			"check"
		CliFrontendCompile:
			"compile"
		CliFrontendRun:
			"run"


private pure func delegation_io_name(io: CliDelegationIo) -> String:
	match io:
		BatchCliDelegation:
			"batch"
		TerminalCliDelegation:
			"terminal"


private pure func delegation_io_for_action(action: CliAction) -> CliDelegationIo:
	if action_needs_terminal_io(action):
		TerminalCliDelegation
	else:
		BatchCliDelegation


private pure func cli_result(status: Int, stdout: String, stderr: String) -> CliHandledResult:
	{
		status = status,
		stdout = stdout,
		stderr = stderr
	}


private pure func handled_error(message: String) -> CliRunPlan:
	CliRunHandled(cli_result(CLI_WRAPPER_ERROR_EXIT, "", message + "\n"))


private pure func handled_stdout(text: String) -> CliRunPlan:
	CliRunHandled(cli_result(CLI_WRAPPER_SUCCESS_EXIT, text + "\n", ""))


private pure func handled_stdout_with_status(status: Int, text: String) -> CliRunPlan:
	CliRunHandled(cli_result(status, text + "\n", ""))


private pure func format_handled_result(format_result: FormatCommandResult) -> CliHandledResult:
	cli_result(format_result.status, format_result.stdout, format_result.stderr)


private pure func help_text_for_action(action: CliAction) -> Option[String]:
	match action:
		CliCheckHelp:
			Some(CHECK_HELP)
		CliCompileHelp:
			Some(COMPILE_HELP)
		CliRunHelp:
			Some(RUN_HELP)
		CliTestHelp:
			Some(TEST_HELP)
		CliPurifyHelp:
			Some(PURIFY_HELP)
		CliLsp(CliLspHelp):
			Some(LSP_HELP)
		CliRepl(CliReplHelp):
			Some(REPL_HELP)
		CliPackage(CliPackageHelp):
			Some(PACKAGE_HELP)
		CliPackage(CliPackageCheckHelp):
			Some(PACKAGE_CHECK_HELP)
		CliPackage(CliPackageHashHelp):
			Some(PACKAGE_HASH_HELP)
		CliPackage(CliPackagePackHelp):
			Some(PACKAGE_PACK_HELP)
		CliPackage(CliPackageFetchHelp):
			Some(PACKAGE_FETCH_HELP)
		CliPackage(CliPackageVendorHelp):
			Some(PACKAGE_VENDOR_HELP)
		_:
			None


private pure func args_after_command(
	user_args: List[String],
	command: String,
) -> Option[List[String]]:
	match user_args:
		[head, ...rest]:
			if head == command:
				Some(rest)
			else:
				None
		[]:
			None


private pure func absolute_normalized_path(cwd: String, path: String) -> String:
	if path.starts_with("/"):
		normalize(path)
	else:
		normalize(join(cwd, path))


private pure func is_path_under_dir(dir: String, path: String) -> Bool:
	normalized_dir: String = normalize(dir)
	normalized_path: String = normalize(path)
	normalized_path == normalized_dir or normalized_path.starts_with(normalized_dir + "/")


private func should_auto_format_cli_source(path: String) -> Bool:
	cwd: String = getcwd()
	std_dir: String = normalize(join(cwd, "std"))
	source_path: String = absolute_normalized_path(cwd, path)

	not is_path_under_dir(std_dir, source_path)


private func env_disables_auto_format() -> Bool:
	match getenv("BLORP_NO_FORMAT"):
		Some(value):
			value == "1"
		None:
			False


private func action_uses_auto_format(action: CliAction) -> Bool:
	if env_disables_auto_format():
		False
	else:
		match action:
			CliCheck(args):
				not args.no_format
			CliCompile(args):
				not args.no_format
			CliRun(args):
				not args.no_format
			_:
				False


private pure func format_cli_source_error(
	path: String,
	format_result: FormatCommandResult,
) -> String:
	detail: String = if format_result.stderr != "":
		format_result.stderr.trim_right()
	else if format_result.stdout != "":
		format_result.stdout.trim_right()
	else:
		"failed to format source file `" + path + "`"

	if detail == "":
		"failed to format source file `" + path + "`"
	else:
		detail


private func auto_format_cli_source_if_needed(
	action: CliAction,
	path: String,
) -> Result[Void, String]:
	if action_uses_auto_format(action) and should_auto_format_cli_source(path):
		format_result: FormatCommandResult = run_format_command([path])

		if format_result.status == 0:
			Ok(void)
		else:
			Err(format_cli_source_error(path, format_result))
	else:
		Ok(void)


private func parsed_source_plan_for_action(
	user_args: List[String],
	action: CliAction,
) -> Option[CliRunPlan]:
	match frontend_source_for_action(action):
		Some((command, path, options)):
			match parse_cli_source_file_for_action(action, path):
				Ok(source):
					match source_graph_modules_for_roots(action, [source]):
						Ok(modules):
							Some(CliRunParsedSource({
								command = command,
								args = user_args,
								options = options,
								source = source,
								modules = modules,
							}))
						Err(message):
							Some(handled_error(message))
				Err(message):
					Some(handled_error(message))
		None:
			None


private func check_plan_for_args(user_args: List[String], args: CliCheckArgs) -> CliRunPlan:
	match expand_check_targets(args.paths):
		Ok(expansion):
			match read_cli_sources_for_action(CliCheck(args), expansion.source_paths):
				Ok(sources):
					match single_explicit_check_source(expansion, sources):
						Some(source):
							match parse_cli_source(source):
								Ok(parsed):
									match source_graph_modules_for_roots(CliCheck(args), [parsed]):
										Ok(modules):
											CliRunParsedSource({
												command = CliFrontendCheck,
												args = user_args,
												options = cli_check_options_json(args),
												source = parsed,
												modules = modules,
											})
										Err(message):
											handled_error(message)
								Err(message):
									handled_error(message)
						None:
							if sources.length() == 0:
								handled_error(NO_BLORP_FILES_ERROR)
							else:
								match parse_cli_sources(sources):
									Ok(parsed_sources):
										match source_graph_modules_for_roots(
											CliCheck(args),
											parsed_sources,
										):
											Ok(modules):
												CliRunParsedSourceBatch({
													args = user_args,
													options = cli_check_options_json(args),
													sources = parsed_sources,
													modules = modules,
												})
											Err(message):
												handled_error(message)
									Err(message):
										handled_error(message)
				Err(message):
					handled_error(message)
		Err(message):
			handled_error(message)


private func run_cli_with_context(user_args: List[String], context: CliRunContext) -> CliRunPlan:
	action: CliAction = parse_cli_args(user_args)

	match action:
		CliError(message):
			handled_error(message)
		CliUsage(status):
			handled_stdout_with_status(status, TOP_LEVEL_USAGE)
		CliVersion:
			match context.version:
				Some(version):
					handled_stdout(version)
				None:
					CliRunDelegate({
						args = user_args,
						io = delegation_io_for_action(action),
					})
		_:
			match help_text_for_action(action):
				Some(help_text):
					handled_stdout(help_text)
				None:
					match action:
						CliFormat(_):
							match args_after_command(user_args, "format"):
								Some(format_args):
									CliRunHandled(
										format_handled_result(run_format_command(format_args)),
									)
								None:
									handled_error(
										"internal error: format command missing from CLI args",
									)
						CliTest(args):
							CliRunTest({
								args = user_args,
								options = cli_test_options_json(args),
							})
						CliTestWarmupOnly:
							CliRunTest({
								args = user_args,
								options = cli_test_warmup_options_json(),
							})
						CliPurify(args):
							CliRunPurify({
								args = user_args,
								options = cli_purify_options_json(args),
							})
						CliRepl(repl_action):
							match repl_action:
								CliReplRun(repl_debug):
									CliRunRepl({
										args = user_args,
										debug = repl_debug,
									})
								CliReplHelp:
									handled_stdout(REPL_HELP)
						CliLsp(CliLspRun):
							CliRunLsp({args = user_args})
						CliLsp(CliLspHelp):
							handled_stdout(LSP_HELP)
						CliPackage(package_action):
							match package_action:
								CliPackageHelp:
									handled_stdout(PACKAGE_HELP)
								CliPackageCheckHelp:
									handled_stdout(PACKAGE_CHECK_HELP)
								CliPackageCheck(path):
									CliRunPackage({
										args = user_args,
										command = CliPackageRunCheck(path),
									})
								CliPackageHashHelp:
									handled_stdout(PACKAGE_HASH_HELP)
								CliPackageHash(path):
									CliRunPackage({
										args = user_args,
										command = CliPackageRunHash(path),
									})
								CliPackagePackHelp:
									handled_stdout(PACKAGE_PACK_HELP)
								CliPackagePack(pack_args):
									CliRunPackage({
										args = user_args,
										command = CliPackageRunPack(
											pack_args.path,
											pack_args.output,
										),
									})
								CliPackageFetchHelp:
									handled_stdout(PACKAGE_FETCH_HELP)
								CliPackageFetchAll:
									CliRunPackage({
										args = user_args,
										command = CliPackageRunFetchAll,
									})
								CliPackageFetchTarget(target, locations):
									CliRunPackage({
										args = user_args,
										command = CliPackageRunFetchTarget(target, locations),
									})
								CliPackageVendorHelp:
									handled_stdout(PACKAGE_VENDOR_HELP)
								CliPackageVendorAll:
									CliRunPackage({
										args = user_args,
										command = CliPackageRunVendorAll,
									})
								CliPackageVendorTarget(target, dest):
									CliRunPackage({
										args = user_args,
										command = CliPackageRunVendorTarget(target, dest),
									})
						CliCheck(args):
							check_plan_for_args(user_args, args)
						_:
							match parsed_source_plan_for_action(user_args, action):
								Some(plan):
									plan
								None:
									CliRunDelegate({
										args = user_args,
										io = delegation_io_for_action(action),
									})


func run_cli(user_args: List[String]) -> CliRunPlan:
	run_cli_with_context(user_args, {version = None})


func run_cli_with_version(user_args: List[String], version: String) -> CliRunPlan:
	run_cli_with_context(user_args, {version = Some(version)})


private pure func single_path(paths: List[String]) -> Option[String]:
	match paths:
		[path]:
			Some(path)
		_:
			None


private func frontend_source_for_action(
	action: CliAction,
) -> Option[(CliFrontendCommand, String, JsonValue)]:
	match action:
		CliCompile(args):
			match single_path(args.files):
				Some(path):
					Some((CliFrontendCompile, path, cli_compile_options_json(args)))
				None:
					None
		CliRun(args):
			match single_path(args.files):
				Some(path):
					Some((CliFrontendRun, path, cli_run_options_json(args)))
				None:
					None
		_:
			None


private pure func is_blorp_source_path(path: String) -> Bool:
	path.ends_with(".brp")


private pure func blorp_source_paths(paths: List[String]) -> List[String]:
	var sources: List[String] = []

	for path in paths:
		if is_blorp_source_path(path):
			sources = sources.append(path)

	sources


private func expand_check_target(path: String) -> Result[CliCheckTargetExpansion, String]:
	if not file_exists(path):
		Err("failed to read source file `" + path + "`: not found: " + path)
	else if is_directory(path):
		Ok({
			targets = [CliSourceDirectoryTarget(path)],
			source_paths = blorp_source_paths(walk_dir(path)),
		})
	else:
		Ok({
			targets = [CliSourceFileTarget(path)],
			source_paths = [path],
		})


func expand_check_targets(paths: List[String]) -> Result[CliCheckTargetExpansion, String]:
	var targets: List[CliSourceTarget] = []
	var source_paths: List[String] = []
	var error: Option[String] = None

	for path in paths:
		match error:
			Some(_):
				break
			None:
				match expand_check_target(path):
					Ok(expansion):
						targets = targets.concat(expansion.targets)
						source_paths = source_paths.concat(expansion.source_paths)
					Err(message):
						error = Some(message)

	match error:
		Some(message):
			Err(message)
		None:
			Ok({
				targets = targets,
				source_paths = source_paths.sort(),
			})


private func read_text_file(path: String) -> Result[String, String]:
	with reader ?= open_read(path) on err => message(err):
		match reader.read_text():
			Ok(source):
				Ok(source)
			Err(err):
				Err(message(err))


private pure func module_name_for_cli_path(path: String) -> String:
	stem(path)


private func read_cli_source_file(path: String) -> Result[CliSourceFile, String]:
	source ?= read_text_file(
		path,
	).map_err(
		func(err): "failed to read source file `" + path + "`: " + err,
	)

	Ok({
		path = path,
		module_name = module_name_for_cli_path(path),
		source_text = source,
	})


private func read_cli_source_file_for_action(
	action: CliAction,
	path: String,
) -> Result[CliSourceFile, String]:
	match auto_format_cli_source_if_needed(action, path):
		Ok(_):
			read_cli_source_file(path)
		Err(message):
			Err(message)


private func read_cli_sources_for_action(
	action: CliAction,
	paths: List[String],
) -> Result[List[CliSourceFile], String]:
	var sources: List[CliSourceFile] = []
	var error: Option[String] = None

	for path in paths:
		match error:
			Some(_):
				break
			None:
				match read_cli_source_file_for_action(action, path):
					Ok(source):
						sources = sources.append(source)
					Err(message):
						error = Some(message)

	match error:
		Some(message):
			Err(message)
		None:
			Ok(sources)


private pure func single_explicit_check_source(
	expansion: CliCheckTargetExpansion,
	sources: List[CliSourceFile],
) -> Option[CliSourceFile]:
	match expansion.targets:
		[CliSourceFileTarget(path)]:
			match sources:
				[source]:
					if source.path == path:
						Some(source)
					else:
						None
				_:
					None
		_:
			None


private pure func parse_source_request_value(
	path: String,
	module_name: String,
	source: String,
) -> JsonValue:
	JsonObject([
		("schema", JsonNumber(to_float(BRIDGE_SCHEMA_VERSION))),
		("domain", JsonString(BRIDGE_DOMAIN)),
		("action", JsonString("parse_source")),
		("payload", JsonObject([
				("path", JsonString(path)),
				("module", JsonString(module_name)),
				("text", JsonString(source)),
			])),
	])


private pure func parse_source_item_request_value(source: CliSourceFile) -> JsonValue:
	JsonObject([
		("path", JsonString(source.path)),
		("module", JsonString(source.module_name)),
		("text", JsonString(source.source_text)),
	])


private pure func parse_source_item_request_values(sources: List[CliSourceFile]) -> JsonValue:
	var items: List[JsonValue] = []

	for source in sources:
		items = items.append(parse_source_item_request_value(source))

	JsonVector(items)


private pure func parse_sources_request_value(sources: List[CliSourceFile]) -> JsonValue:
	JsonObject([
		("schema", JsonNumber(to_float(BRIDGE_SCHEMA_VERSION))),
		("domain", JsonString(BRIDGE_DOMAIN)),
		("action", JsonString("parse_sources")),
		("payload", JsonObject([
				("include_comments", JsonBool(False)),
				("sources", parse_source_item_request_values(sources)),
			])),
	])


private pure func parser_artifact(response: JsonValue) -> Result[JsonValue, String]:
	match get_field(response, "ok"):
		Some(JsonBool(True)):
			match get_field(response, "artifact"):
				Some(artifact):
					Ok(artifact)
				None:
					Err("parser response missing artifact")
		Some(JsonBool(False)):
			match get_field(response, "error"):
				Some(error):
					match get_field(error, "message"):
						Some(message):
							match as_string(message):
								Some(text):
									Err(text)
								None:
									Err("parser response error message was not a string")
						None:
							Err("parser response missing error message")
				None:
					Err("parser response missing error object")
		_:
			Err("parser response missing ok flag")


private pure func parser_string_field(
	value: JsonValue,
	field_name: String,
) -> Result[String, String]:
	match get_field(value, field_name):
		Some(field):
			match as_string(field):
				Some(text):
					Ok(text)
				None:
					Err("parser response field `" + field_name + "` was not a string")
		None:
			Err("parser response missing field `" + field_name + "`")


private pure func parser_sources_artifacts(response: JsonValue) -> Result[List[JsonValue], String]:
	artifact ?= parser_artifact(response)

	match get_field(artifact, "sources"):
		Some(sources_value):
			match as_array(sources_value):
				Some(sources):
					Ok(sources)
				None:
					Err("parser response sources field was not an array")
		None:
			Err("parser response missing sources field")


private func parse_cli_source(source: CliSourceFile) -> Result[CliParsedSourceFile, String]:
	response: JsonValue = ParserBridge.handle_request_value(
		parse_source_request_value(
			source.path,
			source.module_name,
			source.source_text,
		),
	)
	artifact ?= parser_artifact(response)
	Ok({
		path = source.path,
		module_name = source.module_name,
		source_text = source.source_text,
		parsed_source = artifact,
	})


private pure func parsed_source_for_artifact(
	source: CliSourceFile,
	artifact: JsonValue,
) -> Result[CliParsedSourceFile, String]:
	artifact_path ?= parser_string_field(artifact, "path")
	artifact_module_name ?= parser_string_field(artifact, "module")

	if artifact_path != source.path:
		Err(
			"parser response path `" + artifact_path + "` did not match source `" + source.path + "`",
		)
	else if artifact_module_name != source.module_name:
		Err(
			"parser response module `" + artifact_module_name + "` did not match source `" + source.module_name + "`",
		)
	else:
		Ok({
			path = source.path,
			module_name = source.module_name,
			source_text = source.source_text,
			parsed_source = artifact,
		})


private pure func parse_cli_source_artifacts_at(
	sources: List[CliSourceFile],
	artifacts: List[JsonValue],
	index: Int,
	parsed_sources: List[CliParsedSourceFile],
) -> Result[List[CliParsedSourceFile], String]:
	if index >= sources.length():
		Ok(parsed_sources)
	else:
		match (sources.get(index), artifacts.get(index)):
			(Some(source), Some(artifact)):
				parsed ?= parsed_source_for_artifact(source, artifact)
				parse_cli_source_artifacts_at(
					sources,
					artifacts,
					index + 1,
					parsed_sources.append(parsed),
				)
			_:
				Err("parser response source count did not match request")


private func parse_cli_sources(
	sources: List[CliSourceFile],
) -> Result[List[CliParsedSourceFile], String]:
	response: JsonValue = ParserBridge.handle_request_value(parse_sources_request_value(sources))
	artifacts ?= parser_sources_artifacts(response)

	if artifacts.length() != sources.length():
		Err("parser response source count did not match request")
	else:
		parse_cli_source_artifacts_at(sources, artifacts, 0, [])


record CliResolvedImportSource {
	path: String,
	module_name: String
}


record CliSourcePackage {
	package_alias: String,
	package_name: String,
	source_dir: String,
	exports: List[String]
}


record CliSourceGraphContext {
	std_dir: Option[String],
	source_packages: List[CliSourcePackage],
	package_roots: List[String]
}


record CliSourceGraphDiscovery {
	sources: List[CliSourceFile],
	seen_paths: List[String]
}


private pure func json_array_field_or_empty(value: JsonValue, name: String) -> List[JsonValue]:
	match get_field(value, name):
		Some(field):
			match as_array(field):
				Some(items):
					items
				None:
					[]
		None:
			[]


private pure func json_string_field_or_none(value: JsonValue, name: String) -> Option[String]:
	match get_field(value, name):
		Some(field):
			as_string(field)
		None:
			None


private pure func parsed_import_paths_from_imports(imports_value: JsonValue) -> List[String]:
	var imports: List[String] = []

	match as_array(imports_value):
		Some(items):
			for item in items:
				match json_string_field_or_none(item, "module_path"):
					Some(module_path):
						imports = imports.append(module_path)
					None:
						void
		None:
			void

	imports


private pure func parsed_import_paths_from_decl(decl: JsonValue) -> List[String]:
	match json_string_field_or_none(decl, "kind"):
		Some(kind):
			if kind == "import_block":
				match get_field(decl, "imports"):
					Some(imports_value):
						parsed_import_paths_from_imports(imports_value)
					None:
						[]
			else:
				[]
		None:
			[]


private pure func parsed_source_import_paths(source: CliParsedSourceFile) -> List[String]:
	match get_field(source.parsed_source, "parsed_ast"):
		Some(parsed_ast):
			var imports: List[String] = []

			for decl in json_array_field_or_empty(parsed_ast, "decls"):
				imports = imports.concat(parsed_import_paths_from_decl(decl))

			imports
		None:
			[]


private pure func action_std_dir(action: CliAction) -> Option[String]:
	match action:
		CliCheck(args):
			args.std_dir
		CliCompile(args):
			args.std_dir
		CliRun(args):
			args.std_dir
		CliTest(args):
			args.std_dir
		_:
			None


private func graph_std_dir(action: CliAction) -> Option[String]:
	match action_std_dir(action):
		Some(path):
			Some(path)
		None:
			getenv("BLORP_STD")


private pure func strip_prefix(prefix: String, text: String) -> String:
	text.drop_left(prefix.length())


private pure func absolute_path_from(cwd: String, path: String) -> String:
	if path.starts_with("/"):
		normalize(path)
	else:
		normalize(join(cwd, path))


private func absolute_path(path: String) -> String:
	absolute_path_from(getcwd(), path)


private pure func config_relative_path(config_dir: String, path: String) -> String:
	if path.starts_with("/"):
		normalize(path)
	else:
		normalize(join(config_dir, path))


private pure func is_identifier_start(ch: Char) -> Bool:
	ch >= 'a' and ch <= 'z' or ch >= 'A' and ch <= 'Z' or ch == '_'


private pure func is_identifier_rest(ch: Char) -> Bool:
	is_identifier_start(ch) or ch >= '0' and ch <= '9'


private pure func is_blorp_identifier(text: String) -> Bool:
	if text.length() == 0:
		False
	else:
		match text.get(0):
			Some(first):
				if not is_identifier_start(first):
					False
				else:
					var ok: Bool = True
					var i: Int = 1

					while i < text.length() and ok:
						match text.get(i):
							Some(ch):
								if not is_identifier_rest(ch):
									ok = False
							None:
								ok = False

						i += 1

					ok
			None:
				False


private pure func valid_package_alias(package_alias: String) -> Bool:
	is_blorp_identifier(package_alias) and package_alias != "std" and package_alias != "pkg"


private pure func append_unique_string(values: List[String], value: String) -> List[String]:
	if values.contains(value):
		values
	else:
		values.append(value)


private pure func module_source_filename(module_path: String) -> String:
	if module_path.ends_with(".brp"):
		module_path
	else:
		module_path + ".brp"


private pure func toml_string_value(value: TomlValue) -> Option[String]:
	match value:
		TomlString(text):
			Some("" + text)
		_:
			None


private pure func toml_string_list_value(value: TomlValue) -> Option[List[String]]:
	match value:
		TomlArray(items):
			var strings: List[String] = []
			var ok: Bool = True

			for item in items:
				if not ok:
					break

				match item:
					TomlString(text):
						strings = strings.append("" + text)
					_:
						ok = False

			if ok:
				Some(strings)
			else:
				None
		_:
			None


private pure func toml_table_string_field(value: TomlValue, field_name: String) -> Option[String]:
	match value:
		TomlTable(fields):
			match fields.get(field_name):
				Some(field):
					toml_string_value(field)
				None:
					None
		_:
			None


private pure func toml_string_at(toml: TomlValue, key: String) -> Option[String]:
	match toml_lookup(toml, key):
		Some(value):
			toml_string_value(value)
		None:
			None


private pure func toml_string_list_at(toml: TomlValue, key: String) -> Option[List[String]]:
	match toml_lookup(toml, key):
		Some(value):
			toml_string_list_value(value)
		None:
			None


private pure func package_alias_from_toml_key(key: String) -> Option[String]:
	if not key.starts_with("packages."):
		None
	else:
		rest: String = strip_prefix("packages.", key)

		match rest.split("."):
			[package_alias]:
				if valid_package_alias(package_alias):
					Some(package_alias)
				else:
					None
			[package_alias, _]:
				if valid_package_alias(package_alias):
					Some(package_alias)
				else:
					None
			_:
				None


private pure func package_aliases_from_toml(toml: TomlValue) -> List[String]:
	match toml:
		TomlTable(fields):
			var aliases: List[String] = []

			for key in fields.keys():
				match package_alias_from_toml_key(key):
					Some(package_alias):
						aliases = append_unique_string(aliases, package_alias)
					None:
						void

			aliases
		_:
			[]


private pure func package_alias_inline_value(
	toml: TomlValue,
	package_alias: String,
) -> Option[TomlValue]:
	toml_lookup(toml, "packages." + package_alias)


private pure func package_alias_string_config(
	toml: TomlValue,
	package_alias: String,
	field_name: String,
) -> Option[String]:
	match toml_string_at(toml, "packages." + package_alias + "." + field_name):
		Some(value):
			Some(value)
		None:
			match package_alias_inline_value(toml, package_alias):
				Some(inline_value):
					toml_table_string_field(inline_value, field_name)
				None:
					None


private pure func is_hex_char(ch: Char) -> Bool:
	ch >= '0' and ch <= '9' or ch >= 'a' and ch <= 'f' or ch >= 'A' and ch <= 'F'


private pure func is_hex_string(text: String) -> Bool:
	if text.length() == 0:
		False
	else:
		var ok: Bool = True
		var i: Int = 0

		while i < text.length() and ok:
			match text.get(i):
				Some(ch):
					if not is_hex_char(ch):
						ok = False
				None:
					ok = False

			i += 1

		ok


private pure func normalize_hash_pin(pin: String) -> Option[String]:
	lower_pin: String = pin
		.trim()
		.lower()

	hash: String = if lower_pin.starts_with("blake3:"):
		strip_prefix("blake3:", lower_pin)
	else:
		lower_pin

	if (
		hash.length() >= 16
		and hash.length() <= 64
		and is_hex_string(hash)
	):
		Some(hash)
	else:
		None


private func package_cache_root() -> String:
	match getenv("BLORP_PACKAGE_CACHE"):
		Some(path):
			if (
				path
					.trim()
					.length() > 0
			):
				path
			else:
				package_cache_root_without_override()
		None:
			package_cache_root_without_override()


private func package_cache_root_without_override() -> String:
	cache_base: String = match getenv("XDG_CACHE_HOME"):
		Some(path):
			if (
				path
					.trim()
					.length() > 0
			):
				path
			else:
				default_package_cache_base()
		None:
			default_package_cache_base()

	join(
		join(cache_base, "blorp"),
		"packages",
	)


private func default_package_cache_base() -> String:
	match getenv("HOME"):
		Some(home):
			if (
				home
					.trim()
					.length() > 0
			):
				join(home, ".cache")
			else:
				join(temp_dir(), ".cache")
		None:
			join(temp_dir(), ".cache")


private func cached_package_root_for_pin(pin: String) -> Option[String]:
	match normalize_hash_pin(pin):
		Some(normalized):
			cache_dir: String = join(
				join(package_cache_root(), "blake3"),
				normalized.take_left(16),
			)

			if not file_exists(join(cache_dir, "READY")):
				None
			else:
				match read_text_file(join(cache_dir, "HASH")):
					Ok(actual):
						if (
							actual
								.trim()
								.lower()
								.starts_with(normalized)
						):
							Some(cache_dir)
						else:
							None
					Err(_):
						None
		None:
			None


private func package_root_for_alias(
	config_dir: String,
	toml: TomlValue,
	package_alias: String,
) -> Option[String]:
	match package_alias_string_config(toml, package_alias, "path"):
		Some(path):
			if (
				path
					.trim()
					.length() == 0
			):
				None
			else:
				Some(config_relative_path(config_dir, path))
		None:
			match package_alias_string_config(toml, package_alias, "hash"):
				Some(pin):
					cached_package_root_for_pin(pin)
				None:
					None


record CliPackageManifest {
	name: String,
	std_compat: String,
	exports: List[String]
}


private pure func package_manifest_from_toml(toml: TomlValue) -> Option[CliPackageManifest]:
	name ?= toml_string_at(toml, "package.name")
	std_compat ?= toml_string_at(toml, "compat.std")
	exports ?= toml_string_list_at(toml, "exports.modules")

	if (
		valid_package_alias(name)
		and std_compat == CURRENT_PACKAGE_STD_COMPAT
		and exports.length() > 0
	):
		Some({
			name = name,
			std_compat = std_compat,
			exports = exports,
		})
	else:
		None


private func package_exports_exist(source_dir: String, exports: List[String]) -> Bool:
	var ok: Bool = True

	for module_name in exports:
		if not file_exists(join(source_dir, module_source_filename(module_name))):
			ok = False
			break

	ok


private func read_source_package(
	package_alias: String,
	package_root: String,
) -> Option[CliSourcePackage]:
	source_dir: String = normalize(join(package_root, "src"))

	if not is_directory(source_dir):
		None
	else:
		match read_text_file(join(package_root, "package.toml")):
			Ok(source):
				match parse_toml(source):
					Ok(toml):
						match package_manifest_from_toml(toml):
							Some(manifest):
								if package_exports_exist(source_dir, manifest.exports):
									Some({
										package_alias = package_alias,
										package_name = manifest.name,
										source_dir = source_dir,
										exports = manifest.exports,
									})
								else:
									None
							None:
								None
					Err(_):
						None
			Err(_):
				None


private func find_blorp_config_from_dir(base_dir: String) -> Option[String]:
	var current: String = absolute_path(base_dir)
	var result: Option[String] = None
	var done: Bool = False

	while not done:
		candidate: String = join(current, "blorp.toml")

		if file_exists(candidate) and not is_directory(candidate):
			result = Some(candidate)
			done = True
		else:
			parent: String = dirname(current)

			if parent == current:
				done = True
			else:
				current = parent

	result


private pure func source_package_seen(
	packages: List[CliSourcePackage],
	package_alias: String,
	source_dir: String,
) -> Bool:
	var seen: Bool = False

	for package in packages:
		if package.package_alias == package_alias and package.source_dir == source_dir:
			seen = True
			break

	seen


private func source_packages_from_config(config_path: String) -> List[CliSourcePackage]:
	config_dir: String = dirname(config_path)

	match read_text_file(config_path):
		Ok(source):
			match parse_toml(source):
				Ok(toml):
					var packages: List[CliSourcePackage] = []

					for package_alias in package_aliases_from_toml(toml):
						match package_root_for_alias(config_dir, toml, package_alias):
							Some(package_root):
								match read_source_package(package_alias, package_root):
									Some(package):
										if not source_package_seen(
											packages,
											package.package_alias,
											package.source_dir,
										):
											packages = packages.append(package)
									None:
										void
							None:
								void

					packages
				Err(_):
					[]
		Err(_):
			[]


private func source_packages_from_base_dir(base_dir: String) -> List[CliSourcePackage]:
	match find_blorp_config_from_dir(base_dir):
		Some(config_path):
			source_packages_from_config(config_path)
		None:
			[]


private func find_pkg_root_from_dir(base_dir: String) -> Option[String]:
	var current: String = absolute_path(base_dir)
	var result: Option[String] = None
	var done: Bool = False

	while not done:
		candidate: String = join(current, "pkg")

		if is_directory(candidate):
			result = Some(candidate)
			done = True
		else:
			parent: String = dirname(current)

			if parent == current:
				done = True
			else:
				current = parent

	result


private pure func append_unique_package(
	packages: List[CliSourcePackage],
	package: CliSourcePackage,
) -> List[CliSourcePackage]:
	if source_package_seen(packages, package.package_alias, package.source_dir):
		packages
	else:
		packages.append(package)


private pure func append_unique_packages(
	packages: List[CliSourcePackage],
	more: List[CliSourcePackage],
) -> List[CliSourcePackage]:
	var result: List[CliSourcePackage] = packages

	for package in more:
		result = append_unique_package(result, package)

	result


private func source_graph_context_for_sources(
	action: CliAction,
	roots: List[CliParsedSourceFile],
) -> CliSourceGraphContext:
	var source_packages: List[CliSourcePackage] = []
	var package_roots: List[String] = []
	cwd_pkg: String = join(getcwd(), "pkg")

	if is_directory(cwd_pkg):
		package_roots = append_unique_string(package_roots, normalize(cwd_pkg))

	for root in roots:
		base_dir: String = dirname(root.path)
		source_packages = append_unique_packages(
			source_packages,
			source_packages_from_base_dir(base_dir),
		)

		match find_pkg_root_from_dir(base_dir):
			Some(pkg_root):
				package_roots = append_unique_string(package_roots, normalize(pkg_root))
			None:
				void

	{
		std_dir = graph_std_dir(action),
		source_packages = source_packages,
		package_roots = package_roots
	}


private pure func source_path_seen(paths: List[String], path: String) -> Bool:
	var seen: Bool = False

	for item in paths:
		if item == path:
			seen = True
			break

	seen


private pure func split_module_ref(module_path: String) -> Option[(String, String)]:
	match module_path.split("/"):
		[]:
			None
		[""]:
			None
		[head]:
			if head.length() == 0:
				None
			else:
				Some((head, ""))
		[head, ...rest]:
			if head.length() == 0:
				None
			else:
				Some((head, rest.join("/")))


private func source_package_for_base_dir(
	context: CliSourceGraphContext,
	base_dir: String,
) -> Option[CliSourcePackage]:
	var result: Option[CliSourcePackage] = None

	for package in context.source_packages:
		if is_path_under_dir(package.source_dir, absolute_path(base_dir)):
			result = Some(package)
			break

	result


private pure func source_package_export_for_alias(
	package: CliSourcePackage,
	module_path: String,
) -> Option[String]:
	match split_module_ref(module_path):
		Some((head, rest)):
			if head != package.package_alias:
				None
			else:
				package_module: String = if rest.length() == 0:
					"" + package.package_name
				else:
					package.package_name + "/" + rest

				if package.exports.contains(package_module):
					Some(package_module)
				else:
					None
		None:
			None


private func resolve_source_package_alias_import(
	context: CliSourceGraphContext,
	module_path: String,
) -> Option[CliResolvedImportSource]:
	var result: Option[CliResolvedImportSource] = None

	for package in context.source_packages:
		if result.is_some():
			break

		match source_package_export_for_alias(package, module_path):
			Some(package_module):
				path: String = join(package.source_dir, module_source_filename(package_module))

				if file_exists(path):
					result = Some({
						path = path,
						module_name = module_path,
					})
			None:
				void

	result


private func resolve_source_package_internal_import(
	package: CliSourcePackage,
	module_path: String,
) -> Option[CliResolvedImportSource]:
	if module_path == package.package_name or module_path.starts_with(package.package_name + "/"):
		path: String = join(package.source_dir, module_source_filename(module_path))

		if file_exists(path):
			Some({
				path = path,
				module_name = module_path,
			})
		else:
			None
	else:
		None


private pure func relative_import_allowed(
	current_package: Option[CliSourcePackage],
	candidate: String,
) -> Bool:
	match current_package:
		Some(package):
			is_path_under_dir(package.source_dir, candidate)
		None:
			True


private func resolve_relative_import_source(
	current_package: Option[CliSourcePackage],
	base_dir: String,
	module_path: String,
) -> Option[CliResolvedImportSource]:
	candidate: String = if module_path.starts_with("./"):
		rest: String = strip_prefix("./", module_path)
		join(base_dir, module_source_filename(rest))
	else:
		normalize(join(base_dir, module_source_filename(module_path)))

	if file_exists(candidate) and relative_import_allowed(current_package, candidate):
		Some({
			path = candidate,
			module_name = module_path,
		})
	else:
		None


private func resolve_pkg_import_source_path(
	context: CliSourceGraphContext,
	current_package: Option[CliSourcePackage],
	base_dir: String,
	module_path: String,
) -> Option[CliResolvedImportSource]:
	if current_package.is_some():
		None
	else:
		std_base: Bool = match context.std_dir:
			Some(std_dir):
				is_path_under_dir(std_dir, absolute_path(base_dir))
			None:
				False

		if std_base:
			None
		else:
			rest: String = strip_prefix("pkg/", module_path)
			var result: Option[CliResolvedImportSource] = None

			for package_root in context.package_roots:
				if result.is_some():
					break

				candidate: String = join(package_root, module_source_filename(rest))

				if file_exists(candidate):
					result = Some({
						path = candidate,
						module_name = module_path,
					})

			result


private func resolve_import_source_path(
	context: CliSourceGraphContext,
	base_dir: String,
	module_path: String,
) -> Option[CliResolvedImportSource]:
	current_package: Option[CliSourcePackage] = source_package_for_base_dir(context, base_dir)

	if module_path.starts_with("pkg/"):
		resolve_pkg_import_source_path(context, current_package, base_dir, module_path)
	else if module_path.starts_with("std/"):
		match context.std_dir:
			Some(dir):
				rest: String = strip_prefix("std/", module_path)
				path: String = join(dir, module_source_filename(rest))

				if file_exists(path):
					Some({
						path = path,
						module_name = module_path,
					})
				else:
					None
			None:
				None
	else if module_path.starts_with("./") or module_path.starts_with("../"):
		resolve_relative_import_source(current_package, base_dir, module_path)
	else:
		match current_package:
			Some(package):
				resolve_source_package_internal_import(package, module_path)
			None:
				match resolve_source_package_alias_import(context, module_path):
					Some(resolved):
						Some(resolved)
					None:
						match context.std_dir:
							Some(dir):
								std_path: String = join(dir, module_source_filename(module_path))

								if file_exists(std_path):
									Some({
										path = std_path,
										module_name = "std/" + module_path,
									})
								else:
									local_path: String = join(
										base_dir,
										module_source_filename(module_path),
									)

									if file_exists(local_path):
										Some({
											path = local_path,
											module_name = module_path,
										})
									else:
										None
							None:
								local_path: String = join(
									base_dir,
									module_source_filename(module_path),
								)

								if file_exists(local_path):
									Some({
										path = local_path,
										module_name = module_path,
									})
								else:
									None


private func read_cli_import_source(
	resolved: CliResolvedImportSource,
) -> Result[Option[CliSourceFile], String]:
	if not file_exists(resolved.path):
		Ok(None)
	else:
		source ?= read_text_file(
			resolved.path,
		).map_err(
			func(err): "failed to read source file `" + resolved.path + "`: " + err,
		)

		Ok(Some({
			path = resolved.path,
			module_name = resolved.module_name,
			source_text = source,
		}))


private func discover_import_sources_for_parsed_source(
	context: CliSourceGraphContext,
	source: CliParsedSourceFile,
	seen_paths: List[String],
) -> Result[CliSourceGraphDiscovery, String]:
	var sources: List[CliSourceFile] = []
	var seen: List[String] = seen_paths
	var error: Option[String] = None
	base_dir: String = dirname(source.path)

	for module_path in parsed_source_import_paths(source):
		match error:
			Some(_):
				break
			None:
				match resolve_import_source_path(context, base_dir, module_path):
					Some(resolved):
						if not source_path_seen(seen, resolved.path):
							match read_cli_import_source(resolved):
								Ok(Some(import_source)):
									seen = seen.append(import_source.path)
									sources = sources.append(import_source)
								Ok(None):
									void
								Err(message):
									error = Some(message)
					None:
						void

	match error:
		Some(message):
			Err(message)
		None:
			Ok({
				sources = sources,
				seen_paths = seen,
			})


private func discover_import_sources_for_parsed_sources(
	context: CliSourceGraphContext,
	parsed_sources: List[CliParsedSourceFile],
	seen_paths: List[String],
) -> Result[CliSourceGraphDiscovery, String]:
	var sources: List[CliSourceFile] = []
	var seen: List[String] = seen_paths
	var error: Option[String] = None

	for source in parsed_sources:
		match error:
			Some(_):
				break
			None:
				match discover_import_sources_for_parsed_source(context, source, seen):
					Ok(discovery):
						seen = discovery.seen_paths
						sources = sources.concat(discovery.sources)
					Err(message):
						error = Some(message)

	match error:
		Some(message):
			Err(message)
		None:
			Ok({
				sources = sources,
				seen_paths = seen,
			})


private pure func parsed_source_paths(sources: List[CliParsedSourceFile]) -> List[String]:
	var paths: List[String] = []

	for source in sources:
		paths = paths.append(source.path)

	paths


private func source_graph_modules_for_roots(
	action: CliAction,
	roots: List[CliParsedSourceFile],
) -> Result[List[CliParsedSourceFile], String]:
	var modules: List[CliParsedSourceFile] = []
	var seen_paths: List[String] = parsed_source_paths(roots)
	context: CliSourceGraphContext = source_graph_context_for_sources(action, roots)
	initial ?= discover_import_sources_for_parsed_sources(context, roots, seen_paths)
	seen_paths = initial.seen_paths
	var pending: List[CliSourceFile] = initial.sources
	var error: Option[String] = None

	while pending.length() > 0:
		match error:
			Some(_):
				break
			None:
				match parse_cli_sources(pending):
					Ok(parsed_batch):
						modules = modules.concat(parsed_batch)

						match discover_import_sources_for_parsed_sources(
							context,
							parsed_batch,
							seen_paths,
						):
							Ok(discovery):
								seen_paths = discovery.seen_paths
								pending = discovery.sources
							Err(message):
								error = Some(message)
					Err(message):
						error = Some(message)

	match error:
		Some(message):
			Err(message)
		None:
			Ok(modules)


private func parse_cli_source_file_for_action(
	action: CliAction,
	path: String,
) -> Result[CliParsedSourceFile, String]:
	source ?= read_cli_source_file_for_action(action, path)
	parse_cli_source(source)


private pure func json_string_list(values: List[String]) -> JsonValue:
	var items: List[JsonValue] = []

	for value in values:
		items = items.append(JsonString(value))

	JsonVector(items)


private pure func json_optional_string(value: Option[String]) -> JsonValue:
	match value:
		Some(text):
			JsonString(text)
		None:
			JsonNull


private pure func json_optional_int(value: Option[Int]) -> JsonValue:
	match value:
		Some(number):
			JsonNumber(to_float(number))
		None:
			JsonNull


private pure func cli_sanitizer_mode_name(mode: CliSanitizerMode) -> String:
	match mode:
		CliSanitizeOff:
			"off"
		CliSanitizeAddressUndefined:
			"address_undefined"
		CliSanitizeUndefined:
			"undefined"


private pure func json_optional_sanitizer_mode(value: Option[CliSanitizerMode]) -> JsonValue:
	match value:
		Some(mode):
			JsonString(cli_sanitizer_mode_name(mode))
		None:
			JsonNull


private pure func cli_check_options_json(args: CliCheckArgs) -> JsonValue:
	JsonObject([
		("kind", JsonString("check")),
		("dump_ast", JsonBool(args.dump_ast)),
		("dump_typed_ast", JsonBool(args.dump_typed_ast)),
		("debug", JsonBool(args.debug)),
		("no_format", JsonBool(args.no_format)),
		("std_dir", json_optional_string(args.std_dir)),
		("paths", json_string_list(args.paths)),
	])


private pure func cli_compile_options_json(args: CliCompileArgs) -> JsonValue:
	JsonObject([
		("kind", JsonString("compile")),
		("ast_only", JsonBool(args.ast_only)),
		("dump_ast", JsonBool(args.dump_ast)),
		("dump_typed_ast", JsonBool(args.dump_typed_ast)),
		("dump_core_after", json_string_list(args.dump_core_after)),
		("dump_file", json_optional_string(args.dump_file)),
		("stop_after", json_optional_string(args.stop_after)),
		("time_phases", JsonBool(args.time_phases)),
		("check_invariants", JsonBool(args.check_invariants)),
		("debug", JsonBool(args.debug)),
		("no_format", JsonBool(args.no_format)),
		("embed_runtime", JsonBool(args.embed_runtime)),
		("std_dir", json_optional_string(args.std_dir)),
		("output", json_optional_string(args.output)),
		("files", json_string_list(args.files)),
	])


private pure func cli_run_options_json(args: CliRunArgs) -> JsonValue:
	JsonObject([
		("kind", JsonString("run")),
		("profile", JsonBool(args.profile)),
		("debug", JsonBool(args.debug)),
		("sanitizer", json_optional_sanitizer_mode(args.sanitizer)),
		("leak_check", JsonBool(args.leak_check)),
		("release", JsonBool(args.release)),
		("no_format", JsonBool(args.no_format)),
		("timeout", json_optional_int(args.timeout)),
		("threads", json_optional_int(args.threads)),
		("std_dir", json_optional_string(args.std_dir)),
		("files", json_string_list(args.files)),
		("user_args", json_string_list(args.user_args)),
	])


private pure func cli_test_mode_name(mode: CliTestMode) -> String:
	match mode:
		CliTestAll:
			"all"
		CliTestDocOnly:
			"doc"
		CliTestSuiteOnly:
			"suite"


private pure func cli_test_options_json(args: CliTestArgs) -> JsonValue:
	JsonObject([
		("kind", JsonString("test")),
		("profile", JsonBool(args.profile)),
		("debug", JsonBool(args.debug)),
		("sanitizer", json_optional_sanitizer_mode(args.sanitizer)),
		("leak_check", JsonBool(args.leak_check)),
		("no_format", JsonBool(args.no_format)),
		("timeout", json_optional_int(args.timeout)),
		("jobs", JsonNumber(to_float(args.jobs))),
		("repeat", JsonNumber(to_float(args.repeat))),
		("mode", JsonString(cli_test_mode_name(args.mode))),
		("cache", JsonBool(args.cache)),
		("std_dir", json_optional_string(args.std_dir)),
