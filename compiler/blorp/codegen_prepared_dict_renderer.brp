	}]

USAGE: String = (
	"Usage: codegen_prepared_dict_renderer prepared-dict <name> [rendered-arg...] | "
	+ "manifest"
)

private OPEN_BRACE: String = "{"

private CLOSE_BRACE: String = "}"


private pure func c_block(body: String) -> String:
	OPEN_BRACE + " " + body + " " + CLOSE_BRACE


private pure func c_statement_expr(body: String) -> String:
	"(" + c_block(body) + ")"


pure func parse_command(command: String) -> CompilerCommand:
	match command:
		"prepared-dict":
			RenderPreparedDictCommand
		"manifest":
			RenderManifestCommand
		_:
			UnknownCommand


pure func prepared_dict_template_name(info: PreparedDictTemplateInfo) -> String:
	info.name


pure func prepared_dict_template_arity(info: PreparedDictTemplateInfo) -> Int:
	info.arity


pure func parse_prepared_dict_template(name: String) -> Option[PreparedDictTemplateInfo]:
	var found: Option[PreparedDictTemplateInfo] = None

	for info in ALL_TEMPLATES:
		if found.is_none() and info.name == name:
			found = Some(info)

	found


pure func render_error_to_string(error: RenderError) -> String:
	match error:
		WrongArity(info, got):
			"prepared dict op ${info.name} expected ${info.arity} arg(s), got ${got}"
		UnsupportedPreparedDictOp(name):
			"unsupported prepared dict op: ${name}"


pure func wrong_arity_for_args(info: PreparedDictTemplateInfo, args: List[String]) -> RenderError:
	WrongArity(info, args.length())


private pure func parse_stack_option_value_record_get_args(
	args: List[String],
) -> Option[StackOptionValueRecordGetArgs]:
	match args:
		[dict, key, temp_seed, option_c_type, payload_c_type, none_value]:
			Some({
				dict = dict,
				key = key,
				temp_seed = temp_seed,
				option_c_type = option_c_type,
				payload_c_type = payload_c_type,
				none_value = none_value,
			})
		_:
			None


private pure func parse_stack_option_scalar_get_args(
	args: List[String],
) -> Option[StackOptionScalarGetArgs]:
	match args:
		[dict, key, temp_seed, option_c_type, none_value]:
			Some({
				dict = dict,
				key = key,
				temp_seed = temp_seed,
				option_c_type = option_c_type,
				none_value = none_value,
			})
		_:
			None


private pure func parse_dict_call_with_capacity_args(
	args: List[String],
) -> Option[DictCallWithCapacityArgs]:
	match args:
		[function_name, capacity]:
			Some({
				function_name = function_name,
				capacity = capacity,
			})
		_:
			None


