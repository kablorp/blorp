			})
		_:
			None


private pure func stack_option_dict_tmp(temp_seed: String) -> String:
	"__gso_dict_${temp_seed}"


private pure func stack_option_key_tmp(temp_seed: String) -> String:
	"__gso_key_${temp_seed}"


private pure func stack_option_found_tmp(temp_seed: String) -> String:
	"__gso_found_${temp_seed}"


private pure func stack_option_raw_tmp(temp_seed: String) -> String:
	"__gso_raw_${temp_seed}"


private pure func stack_option_result_tmp(temp_seed: String) -> String:
	"__gso_result_${temp_seed}"


private pure func dict_construct_tmp(temp_seed: String) -> String:
	"__dict_${temp_seed}"


private pure func render_stack_option_none_assignment(
	result_tmp: String,
	option_c_type: String,
	none_value: String,
) -> String:
	"${result_tmp} = ((${option_c_type}){ .tag = BLORP_TAG_NONE, .value = ${none_value} });"


private pure func render_stack_option_some_assignment(
	result_tmp: String,
	option_c_type: String,
	payload_expr: String,
) -> String:
	"${result_tmp} = ((${option_c_type}){ .tag = BLORP_TAG_SOME, .value = ${payload_expr} });"


private pure func render_key_release_tail(
	policy: KeyReleasePolicy,
	key_tmp: String,
	result_tmp: String,
) -> String:
	match policy:
		KeepKey:
			"${result_tmp};"
		ReleaseKey:
			"blorp_release(${key_tmp}); ${result_tmp};"


private pure func render_stack_option_dict_shell(
	dict: String,
	key: String,
	temp_seed: String,
	option_c_type: String,
	none_value: String,
	payload_expr: String,
	key_policy: KeyReleasePolicy,
) -> String:
	dict_tmp: String = stack_option_dict_tmp(temp_seed)
	key_tmp: String = stack_option_key_tmp(temp_seed)
	found_tmp: String = stack_option_found_tmp(temp_seed)
	raw_tmp: String = stack_option_raw_tmp(temp_seed)
	result_tmp: String = stack_option_result_tmp(temp_seed)
	dict_bind: String = "blorp_Dict* ${dict_tmp} = (blorp_Dict*)${dict};"
	key_bind: String = "void* ${key_tmp} = ${key};"
	raw_decl: String = "void* ${raw_tmp} = NULL;"
	found_bind: String = "bool ${found_tmp} = blorp_dict_get_raw(${dict_tmp}, ${key_tmp}, &${raw_tmp});"
	result_decl: String = "${option_c_type} ${result_tmp};"
	found_condition: String = "if (${found_tmp}) "
	some_body: String = render_stack_option_some_assignment(result_tmp, option_c_type, payload_expr)
	none_body: String = render_stack_option_none_assignment(result_tmp, option_c_type, none_value)
	tail: String = render_key_release_tail(key_policy, key_tmp, result_tmp)

	c_statement_expr(
		dict_bind + " " + key_bind + " " + raw_decl + " " + found_bind + " " + result_decl + " " + found_condition + c_block(
			some_body,
		) + " else " + c_block(none_body) + " " + tail,
	)


private pure func render_stack_option_value_record_get(
	args: StackOptionValueRecordGetArgs,
	key_policy: KeyReleasePolicy,
) -> String:
	raw_tmp: String = stack_option_raw_tmp(args.temp_seed)
	payload_expr: String = "blorp_unbox_struct(${raw_tmp}, ${args.payload_c_type})"
	render_stack_option_dict_shell(
		args.dict,
		args.key,
		args.temp_seed,
		args.option_c_type,
		args.none_value,
		payload_expr,
		key_policy,
	)


private pure func render_stack_option_long_get(
	args: StackOptionScalarGetArgs,
	key_policy: KeyReleasePolicy,
) -> String:
	raw_tmp: String = stack_option_raw_tmp(args.temp_seed)
	payload_expr: String = "(long)${raw_tmp}"
	render_stack_option_dict_shell(
		args.dict,
		args.key,
		args.temp_seed,
		args.option_c_type,
		args.none_value,
		payload_expr,
		key_policy,
	)


private pure func render_stack_option_erased_get(
	args: StackOptionScalarGetArgs,
	key_policy: KeyReleasePolicy,
	unbox_fn: String,
) -> String:
	raw_tmp: String = stack_option_raw_tmp(args.temp_seed)
	payload_expr: String = "${unbox_fn}(${raw_tmp})"
	render_stack_option_dict_shell(
		args.dict,
		args.key,
		args.temp_seed,
		args.option_c_type,
		args.none_value,
		payload_expr,
		key_policy,
	)


private pure func render_dict_value_release_init(temp_seed: String) -> String:
	dict_tmp: String = dict_construct_tmp(temp_seed)
	" blorp_dict_set_value_release(${dict_tmp}, blorp_elem_release_fn);"


private pure func render_dict_call_with_capacity(args: DictCallWithCapacityArgs) -> String:
	"${args.function_name}(${args.capacity})"


private pure func render_dict_custom_ctor(args: DictCustomCtorArgs) -> String:
	"${args.function_name}((unsigned long (*)(void*))${args.hash_fn}, " + "(bool (*)(void*, void*))${args.equals_fn}, ${args.key_release})"


private pure func render_dict_custom_with_capacity_ctor(
	args: DictCustomWithCapacityCtorArgs,
) -> String:
	"${args.function_name}(${args.capacity}, (unsigned long (*)(void*))" + "${args.hash_fn}, (bool (*)(void*, void*))${args.equals_fn}, " + "${args.key_release})"


private pure func render_dict_insert(args: DictInsertArgs) -> String:
	dict_tmp: String = dict_construct_tmp(args.temp_seed)
	" ${dict_tmp} = blorp_dict_insert(${dict_tmp}, ${args.key}, ${args.value});"


private pure func render_dict_iter_source_binding(args: DictIterSourceBindingArgs) -> String:
	"blorp_Dict* ${args.dict} = (blorp_Dict*)${args.source};"


private pure func render_dict_iter_loop_open(args: DictIterLoopOpenArgs) -> String:
	"for (long ${args.index} = 0; ${args.index} < ${args.dict}->order_len; ${args.index}++) {"


private pure func render_dict_iter_slot_binding(args: DictIterSlotBindingArgs) -> String:
	"long ${args.slot} = ${args.dict}->order[${args.index}];"


private pure func render_dict_iter_deleted_slot_guard(slot: String) -> String:
	"if (${slot} < 0) continue;"


private pure func render_dict_iter_key_binding(args: DictIterKeyBindingArgs) -> String:
	"${args.key_c_type} ${args.binding} = (${args.key_c_type})${args.dict}->keys[${args.slot}];"


private pure func render_dict_iter_pair_binding(args: DictIterPairBindingArgs) -> String:
	"blorp_Tuple* ${args.entry} = blorp_tuple_new(2, " + "${args.dict}->keys[${args.slot}], ${args.dict}->values[${args.slot}]);"


private pure func render_dict_construct_with_body(args: DictConstructWithBodyArgs) -> String:
	dict_tmp: String = dict_construct_tmp(args.temp_seed)
	c_statement_expr(
		"blorp_Dict* ${dict_tmp} = ${args.ctor};${args.release_init}${args.insert_statements} ${dict_tmp};",
	)


pure func render_prepared_dict_op(op: PreparedDictOp) -> String:
	match op:
		StackOptionValueRecordGet(args, key_policy):
			render_stack_option_value_record_get(args, key_policy)
		StackOptionLongGet(args, key_policy):
			render_stack_option_long_get(args, key_policy)
		StackOptionInt128Get(args, key_policy):
			render_stack_option_erased_get(args, key_policy, "blorp_unbox_int128")
		StackOptionUInt128Get(args, key_policy):
			render_stack_option_erased_get(args, key_policy, "blorp_unbox_uint128")
		DictConstructEmpty(ctor):
			ctor
		DictCallNoArgs(function_name):
			"${function_name}()"
		DictCallWithCapacity(args):
			render_dict_call_with_capacity(args)
		DictCustomCtor(args):
			render_dict_custom_ctor(args)
		DictCustomWithCapacityCtor(args):
			render_dict_custom_with_capacity_ctor(args)
		DictValueReleaseInit(temp_seed):
			render_dict_value_release_init(temp_seed)
		DictInsert(args):
			render_dict_insert(args)
		DictIterSourceBinding(args):
			render_dict_iter_source_binding(args)
		DictIterLoopOpen(args):
			render_dict_iter_loop_open(args)
		DictIterSlotBinding(args):
			render_dict_iter_slot_binding(args)
		DictIterDeletedSlotGuard(slot):
			render_dict_iter_deleted_slot_guard(slot)
		DictIterKeyBinding(args):
			render_dict_iter_key_binding(args)
		DictIterPairBinding(args):
			render_dict_iter_pair_binding(args)
		DictConstructWithBody(args):
			render_dict_construct_with_body(args)


pure func build_prepared_dict_op(
	info: PreparedDictTemplateInfo,
	args: List[String],
) -> Result[PreparedDictOp, RenderError]:
	match info.template:
		DictStackOptionGetValueRecordTemplate:
			parsed ?= parse_stack_option_value_record_get_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(StackOptionValueRecordGet(parsed, KeepKey))
		DictStackOptionGetValueRecordReleaseKeyTemplate:
			parsed ?= parse_stack_option_value_record_get_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(StackOptionValueRecordGet(parsed, ReleaseKey))
		DictStackOptionGetLongTemplate:
			parsed ?= parse_stack_option_scalar_get_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(StackOptionLongGet(parsed, KeepKey))
		DictStackOptionGetLongReleaseKeyTemplate:
			parsed ?= parse_stack_option_scalar_get_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(StackOptionLongGet(parsed, ReleaseKey))
		DictStackOptionGetInt128Template:
			parsed ?= parse_stack_option_scalar_get_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(StackOptionInt128Get(parsed, KeepKey))
		DictStackOptionGetInt128ReleaseKeyTemplate:
			parsed ?= parse_stack_option_scalar_get_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(StackOptionInt128Get(parsed, ReleaseKey))
		DictStackOptionGetUInt128Template:
			parsed ?= parse_stack_option_scalar_get_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(StackOptionUInt128Get(parsed, KeepKey))
		DictStackOptionGetUInt128ReleaseKeyTemplate:
			parsed ?= parse_stack_option_scalar_get_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(StackOptionUInt128Get(parsed, ReleaseKey))
		DictConstructEmptyTemplate:
			match args:
				[ctor]:
					Ok(DictConstructEmpty(ctor))
				_:
					Err(wrong_arity_for_args(info, args))
		DictCallNoArgsTemplate:
			match args:
				[function_name]:
					Ok(DictCallNoArgs(function_name))
				_:
					Err(wrong_arity_for_args(info, args))
		DictCallWithCapacityTemplate:
			parsed ?= parse_dict_call_with_capacity_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(DictCallWithCapacity(parsed))
		DictCustomCtorTemplate:
			parsed ?= parse_dict_custom_ctor_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(DictCustomCtor(parsed))
		DictCustomWithCapacityCtorTemplate:
			parsed ?= parse_dict_custom_with_capacity_ctor_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(DictCustomWithCapacityCtor(parsed))
		DictValueReleaseInitTemplate:
			match args:
				[temp_seed]:
					Ok(DictValueReleaseInit(temp_seed))
				_:
					Err(wrong_arity_for_args(info, args))
		DictInsertTemplate:
			parsed ?= parse_dict_insert_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(DictInsert(parsed))
		DictIterSourceBindingTemplate:
			parsed ?= parse_dict_iter_source_binding_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(DictIterSourceBinding(parsed))
		DictIterLoopOpenTemplate:
			parsed ?= parse_dict_iter_loop_open_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(DictIterLoopOpen(parsed))
		DictIterSlotBindingTemplate:
			parsed ?= parse_dict_iter_slot_binding_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(DictIterSlotBinding(parsed))
		DictIterDeletedSlotGuardTemplate:
			match args:
				[slot]:
					Ok(DictIterDeletedSlotGuard(slot))
				_:
					Err(wrong_arity_for_args(info, args))
		DictIterKeyBindingTemplate:
			parsed ?= parse_dict_iter_key_binding_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(DictIterKeyBinding(parsed))
		DictIterPairBindingTemplate:
			parsed ?= parse_dict_iter_pair_binding_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(DictIterPairBinding(parsed))
		DictConstructWithBodyTemplate:
			parsed ?= parse_dict_construct_with_body_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(DictConstructWithBody(parsed))


pure func render_prepared_dict(name: String, args: List[String]) -> Result[String, RenderError]:
	match parse_prepared_dict_template(name):
		Some(info):
			match build_prepared_dict_op(info, args):
				Ok(op):
					Ok(render_prepared_dict_op(op))
				Err(error):
					Err(error)
		None:
			Err(UnsupportedPreparedDictOp(name))


private PLACEHOLDER_STACK_OPTION_VALUE_RECORD_GET_ARGS: StackOptionValueRecordGetArgs = {
	dict = "@0@",
	key = "@1@",
	temp_seed = "@2@",
	option_c_type = "@3@",
	payload_c_type = "@4@",
	none_value = "@5@"
}

private PLACEHOLDER_STACK_OPTION_SCALAR_GET_ARGS: StackOptionScalarGetArgs = {
	dict = "@0@",
	key = "@1@",
	temp_seed = "@2@",
	option_c_type = "@3@",
	none_value = "@4@"
}

private PLACEHOLDER_DICT_CALL_WITH_CAPACITY_ARGS: DictCallWithCapacityArgs = {
	function_name = "@0@",
	capacity = "@1@"
}

private PLACEHOLDER_DICT_CUSTOM_CTOR_ARGS: DictCustomCtorArgs = {
	function_name = "@0@",
	hash_fn = "@1@",
	equals_fn = "@2@",
	key_release = "@3@"
}

private PLACEHOLDER_DICT_CUSTOM_WITH_CAPACITY_CTOR_ARGS: DictCustomWithCapacityCtorArgs = {
	function_name = "@0@",
	capacity = "@1@",
	hash_fn = "@2@",
	equals_fn = "@3@",
	key_release = "@4@"
}

private PLACEHOLDER_DICT_INSERT_ARGS: DictInsertArgs = {
	temp_seed = "@0@",
	key = "@1@",
	value = "@2@"
}

private PLACEHOLDER_DICT_ITER_SOURCE_BINDING_ARGS: DictIterSourceBindingArgs = {
	dict = "@0@",
	source = "@1@"
}

private PLACEHOLDER_DICT_ITER_LOOP_OPEN_ARGS: DictIterLoopOpenArgs = {
	index = "@0@",
	dict = "@1@"
}

private PLACEHOLDER_DICT_ITER_SLOT_BINDING_ARGS: DictIterSlotBindingArgs = {
	slot = "@0@",
	dict = "@1@",
	index = "@2@"
}

private PLACEHOLDER_DICT_ITER_KEY_BINDING_ARGS: DictIterKeyBindingArgs = {
	key_c_type = "@0@",
	binding = "@1@",
	dict = "@2@",
	slot = "@3@"
}

private PLACEHOLDER_DICT_ITER_PAIR_BINDING_ARGS: DictIterPairBindingArgs = {
	entry = "@0@",
	dict = "@1@",
	slot = "@2@"
}

private PLACEHOLDER_DICT_CONSTRUCT_WITH_BODY_ARGS: DictConstructWithBodyArgs = {
	ctor = "@0@",
	temp_seed = "@1@",
	release_init = "@2@",
	insert_statements = "@3@"
}


private pure func placeholder_prepared_dict_op(info: PreparedDictTemplateInfo) -> PreparedDictOp:
	match info.template:
		DictStackOptionGetValueRecordTemplate:
			StackOptionValueRecordGet(PLACEHOLDER_STACK_OPTION_VALUE_RECORD_GET_ARGS, KeepKey)
		DictStackOptionGetValueRecordReleaseKeyTemplate:
			StackOptionValueRecordGet(PLACEHOLDER_STACK_OPTION_VALUE_RECORD_GET_ARGS, ReleaseKey)
		DictStackOptionGetLongTemplate:
			StackOptionLongGet(PLACEHOLDER_STACK_OPTION_SCALAR_GET_ARGS, KeepKey)
		DictStackOptionGetLongReleaseKeyTemplate:
			StackOptionLongGet(PLACEHOLDER_STACK_OPTION_SCALAR_GET_ARGS, ReleaseKey)
		DictStackOptionGetInt128Template:
			StackOptionInt128Get(PLACEHOLDER_STACK_OPTION_SCALAR_GET_ARGS, KeepKey)
		DictStackOptionGetInt128ReleaseKeyTemplate:
			StackOptionInt128Get(PLACEHOLDER_STACK_OPTION_SCALAR_GET_ARGS, ReleaseKey)
		DictStackOptionGetUInt128Template:
			StackOptionUInt128Get(PLACEHOLDER_STACK_OPTION_SCALAR_GET_ARGS, KeepKey)
		DictStackOptionGetUInt128ReleaseKeyTemplate:
			StackOptionUInt128Get(PLACEHOLDER_STACK_OPTION_SCALAR_GET_ARGS, ReleaseKey)
		DictConstructEmptyTemplate:
			DictConstructEmpty("@0@")
		DictCallNoArgsTemplate:
			DictCallNoArgs("@0@")
		DictCallWithCapacityTemplate:
			DictCallWithCapacity(PLACEHOLDER_DICT_CALL_WITH_CAPACITY_ARGS)
		DictCustomCtorTemplate:
			DictCustomCtor(PLACEHOLDER_DICT_CUSTOM_CTOR_ARGS)
		DictCustomWithCapacityCtorTemplate:
			DictCustomWithCapacityCtor(PLACEHOLDER_DICT_CUSTOM_WITH_CAPACITY_CTOR_ARGS)
		DictValueReleaseInitTemplate:
			DictValueReleaseInit("@0@")
		DictInsertTemplate:
			DictInsert(PLACEHOLDER_DICT_INSERT_ARGS)
		DictIterSourceBindingTemplate:
			DictIterSourceBinding(PLACEHOLDER_DICT_ITER_SOURCE_BINDING_ARGS)
		DictIterLoopOpenTemplate:
			DictIterLoopOpen(PLACEHOLDER_DICT_ITER_LOOP_OPEN_ARGS)
		DictIterSlotBindingTemplate:
			DictIterSlotBinding(PLACEHOLDER_DICT_ITER_SLOT_BINDING_ARGS)
		DictIterDeletedSlotGuardTemplate:
			DictIterDeletedSlotGuard("@0@")
		DictIterKeyBindingTemplate:
			DictIterKeyBinding(PLACEHOLDER_DICT_ITER_KEY_BINDING_ARGS)
		DictIterPairBindingTemplate:
			DictIterPairBinding(PLACEHOLDER_DICT_ITER_PAIR_BINDING_ARGS)
		DictConstructWithBodyTemplate:
			DictConstructWithBody(PLACEHOLDER_DICT_CONSTRUCT_WITH_BODY_ARGS)


pure func render_manifest_line(info: PreparedDictTemplateInfo) -> String:
	name: String = prepared_dict_template_name(info)
	arity: Int = prepared_dict_template_arity(info)
	body: String = render_prepared_dict_op(placeholder_prepared_dict_op(info))
	"${name}\t${arity}\t${body}"


pure func render_manifest_lines() -> List[String]:
	ALL_TEMPLATES.map(render_manifest_line)


func print_manifest() -> Void:
	for line in render_manifest_lines():
		print(line)


func print_result(result: Result[String, RenderError]) -> Int:
	match result:
		Ok(rendered):
			puts(rendered)
			0
		Err(error):
			print(render_error_to_string(error))
			1


func main(args: List[String]) -> Int:
	match args:
		[program_name, command_name, ...command_args]:
			match parse_command(command_name):
				RenderPreparedDictCommand:
					match command_args:
						[name, ...rendered_args]:
							print_result(render_prepared_dict(name, rendered_args))
						[]:
							print(USAGE)
							1
				RenderManifestCommand:
					print_manifest()
					0
				UnknownCommand:
					print(USAGE)
					1
		[]:
			print(USAGE)
			1
		[program_name]:
			print(USAGE)
			1
