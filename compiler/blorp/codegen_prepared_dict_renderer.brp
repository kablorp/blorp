		name = "dict_stack_option_get_value_record",
		arity = 6
	}, {
		template = DictStackOptionGetValueRecordReleaseKeyTemplate,
		name = "dict_stack_option_get_value_record_release_key",
		arity = 6
	}, {
		template = DictStackOptionGetLongTemplate,
		name = "dict_stack_option_get_long",
		arity = 5
	}, {
		template = DictStackOptionGetLongReleaseKeyTemplate,
		name = "dict_stack_option_get_long_release_key",
		arity = 5
	}, {
		template = DictStackOptionGetInt128Template,
		name = "dict_stack_option_get_int128",
		arity = 5
	}, {
		template = DictStackOptionGetInt128ReleaseKeyTemplate,
		name = "dict_stack_option_get_int128_release_key",
		arity = 5
	}, {
		template = DictStackOptionGetUInt128Template,
		name = "dict_stack_option_get_uint128",
		arity = 5
	}, {
		template = DictStackOptionGetUInt128ReleaseKeyTemplate,
		name = "dict_stack_option_get_uint128_release_key",
		arity = 5
	}, {
		template = DictConstructEmptyTemplate,
		name = "dict_construct_empty",
		arity = 1
	}, {
		template = DictCallNoArgsTemplate,
		name = "dict_call_no_args",
		arity = 1
	}, {
		template = DictCallWithCapacityTemplate,
		name = "dict_call_with_capacity",
		arity = 2
	}, {
		template = DictCustomCtorTemplate,
		name = "dict_custom_ctor",
		arity = 4
	}, {
		template = DictCustomWithCapacityCtorTemplate,
		name = "dict_custom_with_capacity_ctor",
		arity = 5
	}, {
		template = DictValueReleaseInitTemplate,
		name = "dict_value_release_init",
		arity = 1
	}, {
		template = DictInsertTemplate,
		name = "dict_insert",
		arity = 3
	}, {
		template = DictIterSourceBindingTemplate,
		name = "dict_iter_source_binding",
		arity = 2
	}, {
		template = DictIterLoopOpenTemplate,
