			Some({
				entry = entry,
				dict = dict,
				slot = slot,
			})
		_:
			None


private pure func parse_dict_iter_source_binding_args(
	args: List[String],
) -> Option[DictIterSourceBindingArgs]:
	match args:
		[dict, source]:
			Some({
				dict = dict,
				source = source,
			})
		_:
			None


