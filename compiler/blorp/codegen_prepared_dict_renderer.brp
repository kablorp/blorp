				hash_fn = hash_fn,
				equals_fn = equals_fn,
				key_release = key_release,
			})
		_:
			None


private pure func parse_dict_custom_with_capacity_ctor_args(
	args: List[String],
) -> Option[DictCustomWithCapacityCtorArgs]:
	match args:
		[function_name, capacity, hash_fn, equals_fn, key_release]:
			Some({
				function_name = function_name,
				capacity = capacity,
				hash_fn = hash_fn,
				equals_fn = equals_fn,
				key_release = key_release,
			})
		_:
			None


private pure func parse_dict_insert_args(args: List[String]) -> Option[DictInsertArgs]:
	match args:
		[temp_seed, key, value]:
			Some({
				temp_seed = temp_seed,
				key = key,
				value = value,
			})
		_:
			None


private pure func parse_dict_iter_pair_binding_args(
	args: List[String],
