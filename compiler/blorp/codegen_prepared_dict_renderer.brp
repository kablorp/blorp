-- Blorp-authored renderer for prepared dict Core nodes.
--
-- OCaml still owns Core traversal, child expression emission, ownership
-- analysis, ABI strings, and fresh temp seeds. This module owns final C snippet
-- shape and local temp-name conventions for prepared dict templates.
enum CompilerCommand:
	RenderPreparedDictCommand
	RenderManifestCommand
	UnknownCommand


enum PreparedDictTemplate:
	DictStackOptionGetValueRecordTemplate
	DictStackOptionGetValueRecordReleaseKeyTemplate
	DictStackOptionGetLongTemplate
	DictStackOptionGetLongReleaseKeyTemplate
	DictStackOptionGetInt128Template
	DictStackOptionGetInt128ReleaseKeyTemplate
	DictStackOptionGetUInt128Template
	DictStackOptionGetUInt128ReleaseKeyTemplate
	DictConstructEmptyTemplate
	DictCallNoArgsTemplate
	DictCallWithCapacityTemplate
	DictCustomCtorTemplate
	DictCustomWithCapacityCtorTemplate
	DictValueReleaseInitTemplate
	DictInsertTemplate
	DictIterSourceBindingTemplate
	DictIterLoopOpenTemplate
	DictIterSlotBindingTemplate
	DictIterDeletedSlotGuardTemplate
	DictIterKeyBindingTemplate
	DictIterPairBindingTemplate
	DictConstructWithBodyTemplate


record PreparedDictTemplateInfo {
	template: PreparedDictTemplate,
	name: String,
	arity: Int
}


private enum KeyReleasePolicy:
	KeepKey
	ReleaseKey


record StackOptionValueRecordGetArgs {
	dict: String,
	key: String,
	temp_seed: String,
	option_c_type: String,
	payload_c_type: String,
	none_value: String
}


record StackOptionScalarGetArgs {
	dict: String,
	key: String,
	temp_seed: String,
	option_c_type: String,
	none_value: String
}


record DictCallWithCapacityArgs {
	function_name: String,
	capacity: String
}


record DictCustomCtorArgs {
	function_name: String,
	hash_fn: String,
	equals_fn: String,
	key_release: String
}


record DictCustomWithCapacityCtorArgs {
	function_name: String,
	capacity: String,
	hash_fn: String,
	equals_fn: String,
	key_release: String
}


record DictInsertArgs {
	temp_seed: String,
	key: String,
	value: String
}


record DictIterPairBindingArgs {
	entry: String,
	dict: String,
	slot: String
}


record DictIterSourceBindingArgs {
	dict: String,
	source: String
}


record DictIterLoopOpenArgs {
	index: String,
	dict: String
}


record DictIterSlotBindingArgs {
	slot: String,
	dict: String,
	index: String
}


record DictIterKeyBindingArgs {
	key_c_type: String,
	binding: String,
	dict: String,
	slot: String
}


record DictConstructWithBodyArgs {
	ctor: String,
	temp_seed: String,
	release_init: String,
	insert_statements: String
}


union PreparedDictOp:
	StackOptionValueRecordGet(StackOptionValueRecordGetArgs, KeyReleasePolicy)
	StackOptionLongGet(StackOptionScalarGetArgs, KeyReleasePolicy)
	StackOptionInt128Get(StackOptionScalarGetArgs, KeyReleasePolicy)
	StackOptionUInt128Get(StackOptionScalarGetArgs, KeyReleasePolicy)
	DictConstructEmpty(String)
	DictCallNoArgs(String)
	DictCallWithCapacity(DictCallWithCapacityArgs)
	DictCustomCtor(DictCustomCtorArgs)
	DictCustomWithCapacityCtor(DictCustomWithCapacityCtorArgs)
	DictValueReleaseInit(String)
	DictInsert(DictInsertArgs)
	DictIterSourceBinding(DictIterSourceBindingArgs)
	DictIterLoopOpen(DictIterLoopOpenArgs)
	DictIterSlotBinding(DictIterSlotBindingArgs)
	DictIterDeletedSlotGuard(String)
	DictIterKeyBinding(DictIterKeyBindingArgs)
	DictIterPairBinding(DictIterPairBindingArgs)
	DictConstructWithBody(DictConstructWithBodyArgs)


union RenderError:
	WrongArity(PreparedDictTemplateInfo, Int)
	UnsupportedPreparedDictOp(String)


