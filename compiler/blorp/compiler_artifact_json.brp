-- Typed JSON shape for Blorp-owned C emission results.
--
-- This is intentionally small: OCaml can treat the response as a single JSON
-- artifact while Blorp code gets a precise type for the data it owns.
import:
	json: JsonValue(JsonObject, JsonString, JsonVector)


private C_CODE_FIELD: String = "c_code"

private LINK_FLAGS_FIELD: String = "link_flags"

private INCLUDE_DIRS_FIELD: String = "include_dirs"


record CArtifact {
	c_code: String,
	link_flags: List[String],
	include_dirs: List[String]
}


private pure func strings_to_json(items: List[String]) -> JsonValue:
	JsonVector(items.map(
		func(item: String): JsonString(item),
	))


pure func c_artifact_to_json(artifact: CArtifact) -> JsonValue:
	JsonObject([
		(C_CODE_FIELD, JsonString(artifact.c_code)),
		(LINK_FLAGS_FIELD, strings_to_json(artifact.link_flags)),
		(INCLUDE_DIRS_FIELD, strings_to_json(artifact.include_dirs)),
	])
