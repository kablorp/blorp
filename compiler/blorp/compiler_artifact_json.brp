-- Typed JSON shape for Blorp-owned C emission results.
--
-- This is intentionally small: OCaml can treat the response as a single JSON
-- artifact while Blorp code gets a precise type for the data it owns.
import:
	json:
		JsonValue(JsonBool, JsonNull, JsonNumber, JsonObject, JsonString, JsonVector),
		as_array,
		as_string,
		get_field


private C_CODE_FIELD: String = "c_code"
private LINK_FLAGS_FIELD: String = "link_flags"
private INCLUDE_DIRS_FIELD: String = "include_dirs"


record CArtifact {
	c_code: String,
	link_flags: List[String],
	include_dirs: List[String]
}


union CArtifactJsonError:
	ExpectedTopLevelObject
	MissingField(String)
	ExpectedStringField(String)
	ExpectedStringArrayField(String)


private pure func strings_to_json(items: List[String]) -> JsonValue:
	var json_items: List[JsonValue] = []

	for item in items:
		json_items = json_items.append(JsonString(item))

	JsonVector(json_items)


pure func c_artifact_to_json(artifact: CArtifact) -> JsonValue:
	JsonObject([
		(C_CODE_FIELD, JsonString(artifact.c_code)),
		(LINK_FLAGS_FIELD, strings_to_json(artifact.link_flags)),
		(INCLUDE_DIRS_FIELD, strings_to_json(artifact.include_dirs)),
	])


private pure func artifact_field(value: JsonValue, field_name: String) -> Result[JsonValue, CArtifactJsonError]:
	match value:
		JsonObject(fields):
			match get_field(JsonObject(fields), field_name):
				Some(field):
					Ok(field)
				None:
					Err(MissingField(field_name))
		JsonNull:
			Err(ExpectedTopLevelObject)
		JsonBool(flag):
			Err(ExpectedTopLevelObject)
		JsonNumber(number):
			Err(ExpectedTopLevelObject)
		JsonString(text):
			Err(ExpectedTopLevelObject)
		JsonVector(items):
			Err(ExpectedTopLevelObject)


private pure func string_field(value: JsonValue, field_name: String) -> Result[String, CArtifactJsonError]:
	field ?= artifact_field(value, field_name)

	match as_string(field):
		Some(text):
			Ok(text)
		None:
			Err(ExpectedStringField(field_name))


private pure func string_array_field(
	value: JsonValue,
	field_name: String,
) -> Result[List[String], CArtifactJsonError]:
	field ?= artifact_field(value, field_name)

	match as_array(field):
		Some(items):
			var strings: List[String] = []
			var error: Option[CArtifactJsonError] = None

			for item in items:
				match error:
					Some(existing_error):
						void
					None:
						match as_string(item):
							Some(text):
								strings = strings.append(text)
							None:
								error = Some(ExpectedStringArrayField(field_name))

			match error:
				Some(existing_error):
					Err(existing_error)
				None:
					Ok(strings)
		None:
			Err(ExpectedStringArrayField(field_name))


pure func decode_c_artifact_json(value: JsonValue) -> Result[CArtifact, CArtifactJsonError]:
	c_code ?= string_field(value, C_CODE_FIELD)
	link_flags ?= string_array_field(value, LINK_FLAGS_FIELD)
	include_dirs ?= string_array_field(value, INCLUDE_DIRS_FIELD)

	Ok({
		c_code = c_code,
		link_flags = link_flags,
		include_dirs = include_dirs,
	})


pure func c_artifact_error_to_string(error: CArtifactJsonError) -> String:
	match error:
		ExpectedTopLevelObject:
			"C artifact JSON must be an object"
		MissingField(field_name):
			"missing C artifact field: " + field_name
		ExpectedStringField(field_name):
			"C artifact field `" + field_name + "` must be a string"
		ExpectedStringArrayField(field_name):
			"C artifact field `" + field_name + "` must be an array of strings"
