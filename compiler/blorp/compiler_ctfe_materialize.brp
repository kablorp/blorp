-- Rewrites evaluated CTFE values back into source-shaped and typed artifacts.
--
-- The global-var helper keeps parsed and typed initializer payloads coherent
-- when CTFE replaces a top-level constant initializer.
import:
	compiler_ctfe_value:
		CompilerCtfeConstructorInfo,
		CompilerCtfeValue,
		CompilerCtfeValueDesc(
			CompilerCtfeBoolValue,
			CompilerCtfeCharValue,
			CompilerCtfeConstructorValue,
			CompilerCtfeDictValue,
			CompilerCtfeFloatValue,
			CompilerCtfeFunctionReferenceValue,
			CompilerCtfeIntValue,
			CompilerCtfeListValue,
			CompilerCtfeRangeValue,
			CompilerCtfeRecordValue,
			CompilerCtfeStringValue,
			CompilerCtfeTupleValue,
			CompilerCtfeVectorValue,
			CompilerCtfeVoidValue,
		),
	compiler_env:
		CompilerPurity(CompilerPure),
		CompilerResourceArgPolicy(CompilerRejectResourceArgs),
	compiler_infer:
		CompilerCallableOrigin(CompilerCallableConstructor, CompilerCallableLocal),
		CompilerExprTypeOrigin(CompilerSynthesizedOrigin),
		CompilerResolvedCallInfo,
		CompilerResolvedCallTarget(CompilerResolvedDirectCall),
		CompilerTypedDictEntry,
		CompilerTypedExpr(
			CompilerTypedBoolLiteralExpr,
			CompilerTypedCallExpr,
			CompilerTypedCharLiteralExpr,
			CompilerTypedDictExpr,
			CompilerTypedFloatLiteralExpr,
			CompilerTypedIntLiteralExpr,
			CompilerTypedListExpr,
			CompilerTypedNameExpr,
			CompilerTypedRangeExpr,
			CompilerTypedRecordExpr,
			CompilerTypedStringLiteralExpr,
			CompilerTypedTupleExpr,
			CompilerTypedVectorExpr,
			CompilerTypedVoidExpr,
		),
		CompilerTypedExprInfo,
		CompilerTypedRecordField,
	compiler_parsed_ast:
		ParsedDictEntry,
		ParsedExpr(
			ParsedBoolLiteralExpr,
			ParsedCallExpr,
			ParsedCharLiteralExpr,
			ParsedDictExpr,
			ParsedFloatLiteralExpr,
			ParsedIntLiteralExpr,
			ParsedListExpr,
			ParsedNameExpr,
			ParsedRangeExpr,
			ParsedRecordExpr,
			ParsedStringLiteralExpr,
			ParsedTupleExpr,
			ParsedVectorExpr,
			ParsedVoidExpr,
		),
		ParsedRecordExprField,
		ParsedStringLiteralForm(ParsedPlainStringLiteral),
		ParsedVarDecl,
		parsed_identifier,
	compiler_refinement: compiler_unrefined_binding
	compiler_type: CompilerType(CompilerFunctionType), compiler_type_copy, compiler_type_void
	compiler_type_widening: CompilerTypeWideningDecision(CompilerTypeKeep)
	compiler_typecheck_decl: CompilerTypedGlobalVarInfo


private pure func compiler_ctfe_materialize_info(
	typ: CompilerType,
	resolved_call: Option[CompilerResolvedCallInfo],
) -> CompilerTypedExprInfo:
	{
		source_type = None,
		semantic_type = compiler_type_copy(typ),
		value_type = compiler_type_copy(typ),
		origin = CompilerSynthesizedOrigin("ctfe_materialize"),
		value_slot = {
			semantic_type = compiler_type_copy(typ),
			decision = CompilerTypeKeep(compiler_type_copy(typ))
		},
		proofs = compiler_unrefined_binding(),
		resolved_call = resolved_call,
		resource_dependencies = []
	}


private pure func compiler_ctfe_materialize_direct_constructor_call(
	name: String,
	info: CompilerCtfeConstructorInfo,
	params: List[CompilerType],
	return_type: CompilerType,
) -> Option[CompilerResolvedCallInfo]:
	match info.callable_id:
		Some(callable_id):
			Some({
				callee_name = name,
				source_name = name,
				purity = CompilerPure,
				target = CompilerResolvedDirectCall(
					callable_id,
					CompilerCallableConstructor(info.parent_type),
				),
				instantiated_params = params.map(compiler_type_copy),
				instantiated_return = compiler_type_copy(return_type),
				resource_args = CompilerRejectResourceArgs,
				dim_constraints = [],
			})
		None:
			None


private pure func compiler_ctfe_materialize_function_reference_params(
	typ: CompilerType,
) -> List[CompilerType]:
	match typ:
		CompilerFunctionType(_, params, _):
			params.map(compiler_type_copy)
		_:
			[]


private pure func compiler_ctfe_materialize_function_reference_return(
	typ: CompilerType,
) -> CompilerType:
	match typ:
		CompilerFunctionType(_, _, return_type):
			compiler_type_copy(return_type)
		_:
			compiler_type_void()


private pure func compiler_ctfe_materialize_exprs(
	values: List[CompilerCtfeValue],
) -> List[CompilerTypedExpr]:
	values.map(compiler_ctfe_materialize_value)


private pure func compiler_ctfe_materialize_record_fields(
	fields: List[(String, CompilerCtfeValue)],
) -> List[CompilerTypedRecordField]:
	var result: List[CompilerTypedRecordField] = []

	for (name, value) in fields:
		result = result.append({
			name = parsed_identifier(name, value.span),
			value = compiler_ctfe_materialize_value(value),
			span = value.span,
		})

	result


private pure func compiler_ctfe_materialize_dict_entries(
	entries: List[(CompilerCtfeValue, CompilerCtfeValue)],
) -> List[CompilerTypedDictEntry]:
	var result: List[CompilerTypedDictEntry] = []

	for (key, value) in entries:
		result = result.append({
			key = compiler_ctfe_materialize_value(key),
			value = compiler_ctfe_materialize_value(value),
		})

	result


private pure func compiler_ctfe_materialize_parsed_exprs(
	values: List[CompilerCtfeValue],
) -> List[ParsedExpr]:
	values.map(compiler_ctfe_materialize_parsed_expr)


private pure func compiler_ctfe_materialize_parsed_record_fields(
	fields: List[(String, CompilerCtfeValue)],
) -> List[ParsedRecordExprField]:
	var result: List[ParsedRecordExprField] = []

	for (name, value) in fields:
		result = result.append({
			name = parsed_identifier(name, value.span),
			value = compiler_ctfe_materialize_parsed_expr(value),
			span = value.span,
		})

	result


private pure func compiler_ctfe_materialize_parsed_dict_entries(
	entries: List[(CompilerCtfeValue, CompilerCtfeValue)],
) -> List[ParsedDictEntry]:
	var result: List[ParsedDictEntry] = []

	for (key, value) in entries:
		result = result.append({
			key = compiler_ctfe_materialize_parsed_expr(key),
			value = compiler_ctfe_materialize_parsed_expr(value),
			span = key.span,
		})

	result


private pure func compiler_ctfe_materialize_parsed_constructor_value(
	value: CompilerCtfeValue,
	name: String,
	args: List[CompilerCtfeValue],
) -> ParsedExpr:
	callee = ParsedNameExpr(parsed_identifier(name, value.span))

	if args.length() == 0:
		callee
	else:
		ParsedCallExpr(callee, compiler_ctfe_materialize_parsed_exprs(args), value.span)


private pure func compiler_ctfe_materialize_constructor_value(
	value: CompilerCtfeValue,
	name: String,
	args: List[CompilerCtfeValue],
	info: CompilerCtfeConstructorInfo,
) -> CompilerTypedExpr:
	arg_exprs = compiler_ctfe_materialize_exprs(args)

	if arg_exprs.length() == 0:
		CompilerTypedNameExpr(
			parsed_identifier(name, value.span),
			compiler_ctfe_materialize_info(value.typ, None),
		)
	else:
		params = args.map(func(arg): compiler_type_copy(arg.typ))
		resolved_call = compiler_ctfe_materialize_direct_constructor_call(
			name,
			info,
			params,
			value.typ,
		)
		callee_type = CompilerFunctionType(True, params, compiler_type_copy(value.typ))
		callee = CompilerTypedNameExpr(
			parsed_identifier(name, value.span),
			compiler_ctfe_materialize_info(callee_type, resolved_call),
		)
		CompilerTypedCallExpr(
			callee,
			arg_exprs,
			value.span,
			compiler_ctfe_materialize_info(value.typ, resolved_call),
		)


pure func compiler_ctfe_materialize_value(value: CompilerCtfeValue) -> CompilerTypedExpr:
	info = compiler_ctfe_materialize_info(value.typ, None)

	match value.desc:
		CompilerCtfeIntValue(raw):
			CompilerTypedIntLiteralExpr(raw.to_string(), value.span, info)
		CompilerCtfeFloatValue(raw):
			CompilerTypedFloatLiteralExpr(raw.to_string(), value.span, info)
		CompilerCtfeBoolValue(raw):
			CompilerTypedBoolLiteralExpr(raw, value.span, info)
		CompilerCtfeCharValue(raw):
			CompilerTypedCharLiteralExpr(to_int(raw), value.span, info)
		CompilerCtfeStringValue(raw):
			CompilerTypedStringLiteralExpr(raw, value.span, info)
		CompilerCtfeTupleValue(values):
			CompilerTypedTupleExpr(compiler_ctfe_materialize_exprs(values), value.span, info)
		CompilerCtfeListValue(values):
			CompilerTypedListExpr(compiler_ctfe_materialize_exprs(values), value.span, info)
		CompilerCtfeVectorValue(values):
			CompilerTypedVectorExpr(compiler_ctfe_materialize_exprs(values), value.span, info)
		CompilerCtfeDictValue(entries):
			CompilerTypedDictExpr(compiler_ctfe_materialize_dict_entries(entries), value.span, info)
		CompilerCtfeRecordValue(fields):
			CompilerTypedRecordExpr(
				compiler_ctfe_materialize_record_fields(fields),
				value.span,
				info,
			)
		CompilerCtfeRangeValue(start_value, end_value):
			CompilerTypedRangeExpr(
				compiler_ctfe_materialize_value(start_value),
				compiler_ctfe_materialize_value(end_value),
				value.span,
				info,
			)
		CompilerCtfeVoidValue:
			CompilerTypedVoidExpr(value.span, info)
		CompilerCtfeConstructorValue(payload):
			compiler_ctfe_materialize_constructor_value(
				value,
				payload.name,
				payload.args,
				payload.constructor_info,
			)
		CompilerCtfeFunctionReferenceValue(payload):
			resolved_call = Some({
				callee_name = payload.source_name,
				source_name = payload.source_name,
				purity = CompilerPure,
				target = CompilerResolvedDirectCall(payload.callable_id, CompilerCallableLocal),
				instantiated_params = compiler_ctfe_materialize_function_reference_params(
					value.typ,
				),
				instantiated_return = compiler_ctfe_materialize_function_reference_return(
					value.typ,
				),
				resource_args = CompilerRejectResourceArgs,
				dim_constraints = [],
			})
			CompilerTypedNameExpr(
				parsed_identifier(payload.source_name, value.span),
				compiler_ctfe_materialize_info(value.typ, resolved_call),
			)


pure func compiler_ctfe_materialize_parsed_expr(value: CompilerCtfeValue) -> ParsedExpr:
	match value.desc:
		CompilerCtfeIntValue(raw):
			ParsedIntLiteralExpr(raw.to_string(), value.span)
		CompilerCtfeFloatValue(raw):
			ParsedFloatLiteralExpr(raw.to_string(), value.span)
		CompilerCtfeBoolValue(raw):
			ParsedBoolLiteralExpr(raw, value.span)
		CompilerCtfeCharValue(raw):
			ParsedCharLiteralExpr(to_int(raw), value.span)
		CompilerCtfeStringValue(raw):
			ParsedStringLiteralExpr(raw, ParsedPlainStringLiteral, value.span)
		CompilerCtfeTupleValue(values):
			ParsedTupleExpr(compiler_ctfe_materialize_parsed_exprs(values), value.span)
		CompilerCtfeListValue(values):
			ParsedListExpr(compiler_ctfe_materialize_parsed_exprs(values), value.span)
		CompilerCtfeVectorValue(values):
			ParsedVectorExpr(compiler_ctfe_materialize_parsed_exprs(values), value.span)
		CompilerCtfeDictValue(entries):
			ParsedDictExpr(compiler_ctfe_materialize_parsed_dict_entries(entries), value.span)
		CompilerCtfeRecordValue(fields):
			ParsedRecordExpr(compiler_ctfe_materialize_parsed_record_fields(fields), value.span)
		CompilerCtfeRangeValue(start_value, end_value):
			ParsedRangeExpr(
				compiler_ctfe_materialize_parsed_expr(start_value),
				compiler_ctfe_materialize_parsed_expr(end_value),
				value.span,
			)
		CompilerCtfeVoidValue:
			ParsedVoidExpr(value.span)
		CompilerCtfeConstructorValue(payload):
			compiler_ctfe_materialize_parsed_constructor_value(value, payload.name, payload.args)
		CompilerCtfeFunctionReferenceValue(payload):
			ParsedNameExpr(parsed_identifier(payload.source_name, value.span))


pure func compiler_ctfe_materialize_global_var_info(
	info: CompilerTypedGlobalVarInfo,
	value: CompilerCtfeValue,
) -> CompilerTypedGlobalVarInfo:
	decl: ParsedVarDecl = { info.decl |
		value = compiler_ctfe_materialize_parsed_expr(value),
		is_mutable = False
	}

	{ info |
		decl = decl,
		value = compiler_ctfe_materialize_value(value)
	}
