pure func compiler_variant_field_type_canonical(
	context: CompilerTypeResolutionContext,
	source: CompilerType,
) -> CompilerType:
	compiler_variant_field_type(context, source).canonical


pure func compiler_type_alias_target(
	context: CompilerTypeResolutionContext,
	source: CompilerType,
) -> CompilerResolvedType:
	compiler_resolve_type_default(context, source)


pure func compiler_type_alias_target_canonical(
	context: CompilerTypeResolutionContext,
	source: CompilerType,
) -> CompilerType:
	compiler_type_alias_target(context, source).canonical
