-- Syntactic module surface extracted from a parsed source program.
--
-- This intentionally records source references by decoded legacy AST
-- declaration/method index so bridge consumers can map symbols back to parsed
-- AST declarations without guessing by name. That differs from raw parsed
-- declaration-group indexes because the current OCaml bridge expands import
-- and foreign blocks into multiple legacy AST declarations.
import:
	compiler_parsed_ast:
		ParsedDecl(
			BuiltinTypeParsedDecl,
			ForeignBlockParsedDecl,
			FunctionParsedDecl,
			ImplParsedDecl,
			ImportBlockParsedDecl,
			ParsedErrorDecl,
			PrivateParsedDecl,
			RecordParsedDecl,
			TraitParsedDecl,
			TypeAliasParsedDecl,
			UnionParsedDecl,
			VarParsedDecl,
		),
		ParsedForeignFunctionDecl,
		ParsedFunctionDecl,
		ParsedProgram,
		ParsedTraitMethodDecl,


enum ModuleSurfaceSymbolKind:
	FunctionSurfaceSymbol
	VariableSurfaceSymbol
	TypeSurfaceSymbol
	RecordSurfaceSymbol
	TypeAliasSurfaceSymbol
	TraitSurfaceSymbol
	TraitMethodSurfaceSymbol
	ImplMethodSurfaceSymbol


union ModuleSurfaceSymbolSource:
	DeclSurfaceSource(Int)
	TraitMethodSurfaceSource(Int, Int)
	ImplMethodSurfaceSource(Int, Int)
	PrivateDeclSurfaceSource(Int)
	PrivateTraitMethodSurfaceSource(Int, Int)
	PrivateImplMethodSurfaceSource(Int, Int)


record ModuleSurfaceSymbol {
	name: String,
	kind: ModuleSurfaceSymbolKind,
	source: ModuleSurfaceSymbolSource
}


record ModuleSurfaceImport {
	module_path: String
}


record ModuleSurface {
	module_name: String,
	imports: List[ModuleSurfaceImport],
	exports: List[ModuleSurfaceSymbol],
	private_names: List[ModuleSurfaceSymbol],
	private_traits: List[String]
}


enum ModuleSurfaceVisibility:
	PublicModuleSurfaceVisibility
	PrivateModuleSurfaceVisibility


private pure func copied_surface_string(text: String) -> String:
	text.substring(0, text.length())


pure func module_surface_symbol_kind_name(kind: ModuleSurfaceSymbolKind) -> String:
	match kind:
		FunctionSurfaceSymbol:
			"function"
		VariableSurfaceSymbol:
			"variable"
		TypeSurfaceSymbol:
			"type"
		RecordSurfaceSymbol:
			"record"
		TypeAliasSurfaceSymbol:
			"type_alias"
		TraitSurfaceSymbol:
			"trait"
		TraitMethodSurfaceSymbol:
			"trait_method"
		ImplMethodSurfaceSymbol:
			"impl_method"


pure func module_surface_symbol_source_kind(source: ModuleSurfaceSymbolSource) -> String:
	match source:
		DeclSurfaceSource(_):
			"decl"
		TraitMethodSurfaceSource(_, _):
			"trait_method"
		ImplMethodSurfaceSource(_, _):
			"impl_method"
		PrivateDeclSurfaceSource(_):
			"private_decl"
		PrivateTraitMethodSurfaceSource(_, _):
			"private_trait_method"
		PrivateImplMethodSurfaceSource(_, _):
			"private_impl_method"


private pure func decl_symbol_source(
	decl_index: Int,
	visibility: ModuleSurfaceVisibility,
) -> ModuleSurfaceSymbolSource:
	match visibility:
		PublicModuleSurfaceVisibility:
			DeclSurfaceSource(decl_index)
		PrivateModuleSurfaceVisibility:
			PrivateDeclSurfaceSource(decl_index)


private pure func trait_method_symbol_source(
	decl_index: Int,
	method_index: Int,
	visibility: ModuleSurfaceVisibility,
) -> ModuleSurfaceSymbolSource:
	match visibility:
		PublicModuleSurfaceVisibility:
			TraitMethodSurfaceSource(decl_index, method_index)
		PrivateModuleSurfaceVisibility:
			PrivateTraitMethodSurfaceSource(decl_index, method_index)


private pure func impl_method_symbol_source(
	decl_index: Int,
	method_index: Int,
	visibility: ModuleSurfaceVisibility,
) -> ModuleSurfaceSymbolSource:
	match visibility:
		PublicModuleSurfaceVisibility:
			ImplMethodSurfaceSource(decl_index, method_index)
		PrivateModuleSurfaceVisibility:
			PrivateImplMethodSurfaceSource(decl_index, method_index)


private pure func surface_symbol(
	name: String,
	kind: ModuleSurfaceSymbolKind,
	source: ModuleSurfaceSymbolSource,
) -> ModuleSurfaceSymbol:
	{
		name = copied_surface_string(name),
		kind = kind,
		source = source
	}


private pure func function_surface_symbol(
	function_decl: ParsedFunctionDecl,
	decl_index: Int,
	visibility: ModuleSurfaceVisibility,
) -> ModuleSurfaceSymbol:
	surface_symbol(
		function_decl.name.text,
		FunctionSurfaceSymbol,
		decl_symbol_source(decl_index, visibility),
	)


private pure func trait_method_surface_symbol(
	method_decl: ParsedTraitMethodDecl,
	decl_index: Int,
	method_index: Int,
	visibility: ModuleSurfaceVisibility,
) -> ModuleSurfaceSymbol:
	surface_symbol(
		method_decl.name.text,
		TraitMethodSurfaceSymbol,
		trait_method_symbol_source(decl_index, method_index, visibility),
	)


private pure func impl_method_surface_symbol(
	function_decl: ParsedFunctionDecl,
	decl_index: Int,
	method_index: Int,
	visibility: ModuleSurfaceVisibility,
) -> ModuleSurfaceSymbol:
	surface_symbol(
		function_decl.name.text,
		ImplMethodSurfaceSymbol,
		impl_method_symbol_source(decl_index, method_index, visibility),
	)


private pure func foreign_function_surface_symbol(
	function_decl: ParsedForeignFunctionDecl,
	decl_index: Int,
	visibility: ModuleSurfaceVisibility,
) -> ModuleSurfaceSymbol:
	surface_symbol(
		function_decl.name.text,
		FunctionSurfaceSymbol,
		decl_symbol_source(decl_index, visibility),
	)


private pure func decoded_decl_count(decl: ParsedDecl) -> Int:
	match decl:
		ImportBlockParsedDecl(imports, _):
			imports.length()
		ForeignBlockParsedDecl(_, functions, _):
			functions.length()
		_:
			1


private pure func foreign_function_export_symbols_at(
	functions: List[ParsedForeignFunctionDecl],
	decoded_start_index: Int,
	function_index: Int,
	result: List[ModuleSurfaceSymbol],
) -> List[ModuleSurfaceSymbol]:
	match functions.get(function_index):
		Some(function_decl):
			next_result: List[ModuleSurfaceSymbol] = if function_decl.is_private:
				result
			else:
				result.append(
					foreign_function_surface_symbol(
						function_decl,
						decoded_start_index + function_index,
						PublicModuleSurfaceVisibility,
					),
				)

			foreign_function_export_symbols_at(
				functions,
				decoded_start_index,
				function_index + 1,
				next_result,
			)
		None:
			result


private pure func foreign_function_private_symbols_at(
	functions: List[ParsedForeignFunctionDecl],
	decoded_start_index: Int,
	function_index: Int,
	result: List[ModuleSurfaceSymbol],
) -> List[ModuleSurfaceSymbol]:
	match functions.get(function_index):
		Some(function_decl):
			next_result: List[ModuleSurfaceSymbol] = if function_decl.is_private:
				result.append(
					foreign_function_surface_symbol(
						function_decl,
						decoded_start_index + function_index,
						PrivateModuleSurfaceVisibility,
					),
				)
			else:
				result

			foreign_function_private_symbols_at(
				functions,
				decoded_start_index,
				function_index + 1,
				next_result,
			)
		None:
			result


private pure func trait_method_symbols_at(
	methods: List[ParsedTraitMethodDecl],
	decl_index: Int,
	method_index: Int,
	visibility: ModuleSurfaceVisibility,
	result: List[ModuleSurfaceSymbol],
) -> List[ModuleSurfaceSymbol]:
	match methods.get(method_index):
		Some(method_decl):
			trait_method_symbols_at(
				methods,
				decl_index,
				method_index + 1,
				visibility,
				result.append(
					trait_method_surface_symbol(
						method_decl,
						decl_index,
						method_index,
						visibility,
					),
				),
			)
		None:
			result


private pure func impl_method_symbols_at(
	methods: List[ParsedFunctionDecl],
	decl_index: Int,
	method_index: Int,
	visibility: ModuleSurfaceVisibility,
	result: List[ModuleSurfaceSymbol],
) -> List[ModuleSurfaceSymbol]:
	match methods.get(method_index):
		Some(method_decl):
			impl_method_symbols_at(
				methods,
				decl_index,
				method_index + 1,
				visibility,
				result.append(
					impl_method_surface_symbol(
						method_decl,
						decl_index,
						method_index,
						visibility,
					),
				),
			)
		None:
			result


private pure func private_trait_name_from_decl(decl: ParsedDecl) -> Option[String]:
	match decl:
		PrivateParsedDecl(inner, _):
			match inner:
				TraitParsedDecl(trait_decl):
					Some(copied_surface_string(trait_decl.name.text))
				_:
					None
		_:
			None


pure func module_surface_imports(program: ParsedProgram) -> List[ModuleSurfaceImport]:
	var imports: List[ModuleSurfaceImport] = []

	for decl in program.decls:
		match decl:
			ImportBlockParsedDecl(import_decls, _):
				for import_decl in import_decls:
					imports = imports.append(
						{module_path = copied_surface_string(import_decl.module_path)},
					)
			_:
				void

	imports


pure func module_surface_private_trait_names(program: ParsedProgram) -> List[String]:
	var names: List[String] = []

	for decl in program.decls:
		match private_trait_name_from_decl(decl):
			Some(name):
				names = names.append(name)
			None:
				void

	names


pure func module_surface_symbols_from_decl(
	decl: ParsedDecl,
	decl_index: Int,
	private_traits: List[String],
	visibility: ModuleSurfaceVisibility,
) -> List[ModuleSurfaceSymbol]:
	match decl:
		FunctionParsedDecl(function_decl):
			[function_surface_symbol(function_decl, decl_index, visibility)]
		VarParsedDecl(var_decl):
			[surface_symbol(
					var_decl.name.text,
					VariableSurfaceSymbol,
					decl_symbol_source(decl_index, visibility),
				)]
		UnionParsedDecl(union_decl):
			[surface_symbol(
					union_decl.name.text,
					TypeSurfaceSymbol,
					decl_symbol_source(decl_index, visibility),
				)]
		RecordParsedDecl(record_decl):
			[surface_symbol(
					record_decl.name.text,
					RecordSurfaceSymbol,
					decl_symbol_source(decl_index, visibility),
				)]
		BuiltinTypeParsedDecl(type_decl):
			[surface_symbol(
					type_decl.name.text,
					TypeSurfaceSymbol,
					decl_symbol_source(decl_index, visibility),
				)]
		TypeAliasParsedDecl(type_alias_decl):
			[surface_symbol(
					type_alias_decl.name.text,
					TypeAliasSurfaceSymbol,
					decl_symbol_source(decl_index, visibility),
				)]
		TraitParsedDecl(trait_decl):
			[surface_symbol(
					trait_decl.name.text,
					TraitSurfaceSymbol,
					decl_symbol_source(decl_index, visibility),
				)] + trait_method_symbols_at(trait_decl.methods, decl_index, 0, visibility, [])
		ImplParsedDecl(impl_decl):
			if (
				visibility == PublicModuleSurfaceVisibility
				and private_traits.contains(impl_decl.trait_name.text)
			):
				[]
			else:
				impl_method_symbols_at(impl_decl.methods, decl_index, 0, visibility, [])
		ImportBlockParsedDecl(_, _):
			[]
		ForeignBlockParsedDecl(_, _, _):
			[]
		PrivateParsedDecl(_, _):
			[]
		ParsedErrorDecl(_):
			[]


private pure func module_surface_exports_at(
	decls: List[ParsedDecl],
	parsed_index: Int,
	decoded_index: Int,
	private_traits: List[String],
	result: List[ModuleSurfaceSymbol],
) -> List[ModuleSurfaceSymbol]:
	match decls.get(parsed_index):
		Some(decl):
			next_decoded_index: Int = decoded_index + decoded_decl_count(decl)

			match decl:
				PrivateParsedDecl(_, _):
					module_surface_exports_at(
						decls,
						parsed_index + 1,
						next_decoded_index,
						private_traits,
						result,
					)
				ForeignBlockParsedDecl(_, functions, _):
					module_surface_exports_at(
						decls,
						parsed_index + 1,
						next_decoded_index,
						private_traits,
						result + foreign_function_export_symbols_at(
							functions,
							decoded_index,
							0,
							[],
						),
					)
				_:
					module_surface_exports_at(
						decls,
						parsed_index + 1,
						next_decoded_index,
						private_traits,
						result + module_surface_symbols_from_decl(
							decl,
							decoded_index,
							private_traits,
							PublicModuleSurfaceVisibility,
						),
					)
		None:
			result


pure func module_surface_exports(program: ParsedProgram) -> List[ModuleSurfaceSymbol]:
	module_surface_exports_at(program.decls, 0, 0, module_surface_private_trait_names(program), [])


private pure func module_surface_private_names_at(
	decls: List[ParsedDecl],
	parsed_index: Int,
	decoded_index: Int,
	result: List[ModuleSurfaceSymbol],
) -> List[ModuleSurfaceSymbol]:
	match decls.get(parsed_index):
		Some(decl):
			next_decoded_index: Int = decoded_index + decoded_decl_count(decl)

			match decl:
				PrivateParsedDecl(inner, _):
					module_surface_private_names_at(
						decls,
						parsed_index + 1,
						next_decoded_index,
						result + module_surface_symbols_from_decl(
							inner,
							decoded_index,
							[],
							PrivateModuleSurfaceVisibility,
						),
					)
				ForeignBlockParsedDecl(_, functions, _):
					module_surface_private_names_at(
						decls,
						parsed_index + 1,
						next_decoded_index,
						result + foreign_function_private_symbols_at(
							functions,
							decoded_index,
							0,
							[],
						),
					)
				_:
					module_surface_private_names_at(
						decls,
						parsed_index + 1,
						next_decoded_index,
						result,
					)
		None:
			result


pure func module_surface_private_names(program: ParsedProgram) -> List[ModuleSurfaceSymbol]:
	module_surface_private_names_at(program.decls, 0, 0, [])


pure func module_surface_for_program(program: ParsedProgram) -> ModuleSurface:
	{
		module_name = copied_surface_string(program.source.module_name),
		imports = module_surface_imports(program),
		exports = module_surface_exports(program),
		private_names = module_surface_private_names(program),
		private_traits = module_surface_private_trait_names(program)
	}
