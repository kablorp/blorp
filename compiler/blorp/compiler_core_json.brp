		)
		Ok(RecordExpr(fields, typ, loc))
	else if tag == RECORD_CONSTRUCT_EXPR_TAG:
		type_name ?= string_field(value, path, "type_name")
		fields ?= decode_core_record_fields(value, path, "fields")
		type_json ?= object_field(value, path, "type")
