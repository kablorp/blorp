pure func core_list_construct_to_json(construct: CoreListConstruct) -> JsonValue:
	JsonObject([
		("layout", core_list_storage_layout_to_json(construct.layout)),
		("elements", core_boxed_storage_values_to_json(construct.elements)),
		("elem_needs_release", JsonBool(construct.elem_needs_release)),
	])


pure func decode_core_list_construct_json(
	value: JsonValue,
	path: String,
) -> Result[CoreListConstruct, CoreJsonError]:
	layout_json ?= object_field(value, path, "layout")
	layout ?= decode_core_list_storage_layout_json(
		layout_json,
		path_field(path, "layout"),
	)
	elements ?= decode_core_boxed_storage_values(value, path, "elements")
	elem_needs_release ?= bool_field(value, path, "elem_needs_release")

	Ok({
		layout = layout,
		elements = elements,
		elem_needs_release = elem_needs_release,
	})


