	)
	type_json ?= object_field(value, path, "type")
	typ ?= decode_core_type_json(
		type_json,
		path_field(path, "type"),
	)
	acquire_json ?= object_field(value, path, "acquire")
	acquire ?= decode_core_expr_json(
		acquire_json,
