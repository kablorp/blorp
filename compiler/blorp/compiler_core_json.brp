record CoreSourceSpan {
	file: String,
	line: Int,
	column: Int,
	end_line: Int,
	end_column: Int
}


union CoreSourceLoc:
	KnownSourceLoc(CoreSourceSpan)
	SyntheticSourceLoc


record CoreVar {
	name: String,
	uniq: Int,
	def_id: Option[Int]
}


union CoreType:
	VoidType
	NamedType(String, List[CoreType])
	StackResultType(CoreType, CoreType)
	BoxedResultType(CoreType, CoreType)
	EnumType(String)
	ValueRecordType(String)
	HeapRecordType(String)
	UnionType(String)
	RangeType
	TensorType
	TupleType(List[CoreType])


union CoreLiteral:
	IntLiteral(Int)
	WideIntLiteral(String)
	FloatLiteral(Float)
	FloatTextLiteral(String)
	FloatInfinityLiteral
	FloatNegInfinityLiteral
	FloatNanLiteral
	BoolLiteral(Bool)
	CharLiteral(Int)
	StringLiteral(String)


union CoreRuntimeUnionArg:
	RuntimeOwnedField(String)
	RuntimeIntField(String)


record CoreRuntimeUnionCase {
	runtime_tag: String,
	constructor_name: String,
	constructor_c_name: String,
	args: List[CoreRuntimeUnionArg]
}


union CoreRuntimeSuccessPayload:
	RuntimeNoPayload
	RuntimeField(String)
	RuntimeRecordFields(List[String])
	RuntimeUnionPayload(String, List[CoreRuntimeUnionCase])


record CoreOperationSuccessPayload {
	runtime_payload: CoreRuntimeSuccessPayload,
	release_mask: Int
}


record CoreOperationErrorCase {
	runtime_tag: String,
	constructor_name: String,
	constructor_c_name: String
}


record CoreOperationErrorMapping {
	none_tag: String,
	detail_field: String,
	other_constructor: String,
	other_constructor_c_name: String,
	cases: List[CoreOperationErrorCase]
}


union CoreOperationResultLayoutPolicy:
	DefaultResultLayoutPolicy
	BoxedResultOnlyPolicy(String)


enum CoreForeignCopyKind:
	ForeignStringCopy
	ForeignBytesCopy


union CoreForeignDefaultArgPolicy:
	ForeignScalarByValue
	ForeignDefensiveCopy(CoreForeignCopyKind)


union CoreForeignArgPassing:
	ForeignDefaultArgs(List[CoreForeignDefaultArgPolicy])
	ForeignBorrowArgs


record CoreOperationResultBridge {
	builtin_name: String,
	runtime_c_name: String,
	runtime_result_c_type: String,
	temp_prefix: String,
	result_layout_policy: CoreOperationResultLayoutPolicy,
	success: CoreOperationSuccessPayload,
	error: CoreOperationErrorMapping
}


record CoreFallibleStreamListPayload {
	storage_mode: String,
	elem_size: String
}


union CoreFallibleStreamTerminalPayload:
	FallibleStreamPayloadList(CoreFallibleStreamListPayload)
	FallibleStreamPayloadErased
	FallibleStreamPayloadInt
	FallibleStreamPayloadOption
	FallibleStreamPayloadBool


record CoreFallibleStreamErrorDomain {
	domain_tag: String,
	other_constructor: String,
	other_constructor_c_name: String,
	cases: List[CoreOperationErrorCase]
}


record CoreFallibleStreamTerminalBridge {
	builtin_name: String,
	runtime_c_name: String,
	runtime_result_c_type: String,
	payload: CoreFallibleStreamTerminalPayload,
	error_domain: CoreFallibleStreamErrorDomain
}


union CoreTensorParallelLayout:
	TensorParallelPointerLayout
	TensorParallelRawScalarLayout(CoreTensorRawScalarKind)
	TensorParallelInlineStructLayout(String)


union CoreCallKind:
	UserCall(String, Option[Int])
	ForeignCall(String, CoreForeignArgPassing)
	BuiltinCall(String)
	OperationResultCall(CoreOperationResultBridge)
	FallibleStreamTerminalCall(CoreFallibleStreamTerminalBridge)
	TensorParallelCall(String, CoreTensorParallelLayout)
	ListToStringCall(String)
	IntrinsicCall(String)
	ClosureCall


enum CoreBinaryOp:
	AddOp
	SubtractOp
	MultiplyOp
	DivideOp
	ModuloOp
	EqualOp
	NotEqualOp
	LessOp
	LessEqualOp
	GreaterOp
	GreaterEqualOp


enum CoreUnaryOp:
	NegateOp
	NotOp


enum CoreLogicalOp:
	AndOp
	OrOp


enum CoreLoopRangeDirection:
	RangeMayRunBackward
	RangeForwardOnly


enum CoreReleasePolicy:
	NoReleasePolicy
	ArcReleasePolicy
	ArcReleaseOnlyPolicy
	StackResultReleasePolicy


enum CoreRetainPolicy:
	NoRetainPolicy
	ArcRetainPolicy
	StackResultRetainPolicy


record CoreLoopBinder {
	variable: CoreVar,
	typ: CoreType,
	range_direction: CoreLoopRangeDirection
}


enum CoreTensorRawScalarKind:
	TensorFloat64Elements
	TensorFloat32Elements
	TensorInt64Elements


union CoreTensorLiteralShape:
	TensorVectorLength(Int)
	TensorStaticShape(List[Int])


record CoreTensorRawLiteral {
	raw_kind: CoreTensorRawScalarKind,
	elements: List[CoreExpr]
}


record CoreTensorInlineStructLiteral {
	struct_c_type: String,
	elements: List[CoreExpr]
}


union CoreTensorLiteralPayload:
	TensorRawLiteralPayload(CoreTensorRawLiteral)
	TensorInlineStructLiteralPayload(CoreTensorInlineStructLiteral)


record CoreTensorLiteral {
	shape: CoreTensorLiteralShape,
	payload: CoreTensorLiteralPayload
}


record CoreTensorPackedLiteral {
	shape: CoreTensorLiteralShape,
	elem_size: Int,
	elements: List[CoreExpr]
}


record CoreTupleConstruct {
	elements: List[CoreTupleElement],
	release_mask: Int,
	retain_mask: Int
}


record CoreClosureCapture {
	name: String,
	typ: CoreType
}


record CoreClosureAbi {
	c_name: String,
	params: List[CoreParam],
	captures: List[CoreClosureCapture],
	moved_captures: List[String],
	task_abi: Bool
}


record CoreClosureCreate {
	function_name: String,
	def_id: Int,
	c_name: String,
	static_name: String,
	captures: List[CoreClosureCapture]
}


union CoreExpr:
	LiteralExpr(CoreLiteral, CoreType, CoreSourceLoc)
	VarExpr(CoreVar, CoreType, CoreSourceLoc)
	VoidExpr(CoreType, CoreSourceLoc)
	CooperativeCheckpointExpr(CoreType, CoreSourceLoc)
	CallExpr(CoreCallKind, CoreExpr, List[CoreExpr], CoreType, CoreSourceLoc)
	BinaryExpr(CoreBinaryOp, CoreExpr, CoreExpr, CoreType, CoreSourceLoc)
	UnaryExpr(CoreUnaryOp, CoreExpr, CoreType, CoreSourceLoc)
	LogicalExpr(CoreLogicalOp, CoreExpr, CoreExpr, CoreType, CoreSourceLoc)
	AssignExpr(CoreVar, CoreExpr, CoreType, CoreSourceLoc)
	CastExpr(CoreExpr, CoreType, CoreSourceLoc)
	BoxExpr(CoreBoxOp, CoreType, CoreSourceLoc)
	UnboxExpr(CoreUnboxKind, CoreExpr, CoreType, CoreSourceLoc)
	FieldExpr(CoreExpr, String, CoreType, CoreSourceLoc)
	TupleFieldExpr(CoreExpr, Int, CoreType, CoreSourceLoc)
	TupleExpr(List[CoreExpr], CoreType, CoreSourceLoc)
	TupleConstructExpr(CoreTupleConstruct, CoreType, CoreSourceLoc)
	ClosureCreateExpr(CoreClosureCreate, CoreType, CoreSourceLoc)
	ListConstructExpr(CoreListConstruct, CoreType, CoreSourceLoc)
	ListAllocExpr(CoreListAlloc, CoreType, CoreSourceLoc)
	ListGetExpr(CoreListGet, CoreType, CoreSourceLoc)
	ListHandoffExpr(CoreListHandoff, CoreType, CoreSourceLoc)
	ListHandoffSetOwnedExpr(CoreListSet, CoreType, CoreSourceLoc)
	ListHandoffSetSourceSlotExpr(CoreListHandoffSetSourceSlot, CoreType, CoreSourceLoc)
	StringByteReadExpr(CoreStringByteRead, CoreType, CoreSourceLoc)
	StringByteWriteExpr(CoreStringByteWrite, CoreType, CoreSourceLoc)
	StringByteCopyExpr(CoreStringByteCopy, CoreType, CoreSourceLoc)
	StringSetLenExpr(CoreStringSetLen, CoreType, CoreSourceLoc)
	TensorLiteralExpr(CoreTensorLiteral, CoreType, CoreSourceLoc)
	TensorBoxedLiteralExpr(CoreTensorBoxedLiteral, CoreType, CoreSourceLoc)
	TensorPackedLiteralExpr(CoreTensorPackedLiteral, CoreType, CoreSourceLoc)
	TensorRawFillExpr(CoreTensorRawFill, CoreType, CoreSourceLoc)
	TensorRawReadExpr(CoreTensorRawRead, CoreType, CoreSourceLoc)
	TensorRawWriteExpr(CoreTensorRawWrite, CoreType, CoreSourceLoc)
	TensorRawViewLetExpr(CoreTensorRawViewBinding, CoreExpr, CoreType, CoreSourceLoc)
	DictConstructExpr(CoreDictConstruct, CoreType, CoreSourceLoc)
	SetAllocExpr(CoreSetAlloc, CoreType, CoreSourceLoc)
	ListRetainExpr(CoreListRetain, CoreType, CoreSourceLoc)
	ListSetExpr(CoreListSet, CoreType, CoreSourceLoc)
	RecordExpr(List[CoreRecordFieldValue], CoreType, CoreSourceLoc)
	RecordConstructExpr(String, List[CoreRecordFieldValue], CoreType, CoreSourceLoc)
	UnionConstructExpr(CoreUnionConstruct, CoreType, CoreSourceLoc)
	DupExpr(CoreVar, CoreType, CoreRetainPolicy, CoreExpr, CoreType, CoreSourceLoc)
	DropExpr(CoreVar, CoreType, CoreReleasePolicy, CoreExpr, CoreType, CoreSourceLoc)
	LetExpr(CoreVar, Bool, CoreType, CoreExpr, CoreExpr)
	SeqExpr(CoreExpr, CoreExpr)
	WhileExpr(CoreExpr, CoreExpr, CoreType, CoreSourceLoc)
	BreakExpr(CoreType, CoreSourceLoc)
	ContinueExpr(CoreType, CoreSourceLoc)
	ResourceScopeExpr(CoreResourceScope, CoreType, CoreSourceLoc)
	ResourceCleanupExitExpr(CoreResourceCleanupExit, CoreType, CoreSourceLoc)
	TailrecLoopExpr(List[CoreParam], CoreType, CoreExpr, CoreSourceLoc)
	TailrecRecurExpr(List[CoreExpr], CoreType, CoreSourceLoc)
	ForRangeExpr(CoreLoopBinder, CoreExpr, CoreExpr, CoreExpr, CoreType, CoreSourceLoc)
	ForChannelExpr(CoreForChannel, CoreType, CoreSourceLoc)
	ForListExpr(CoreForList, CoreType, CoreSourceLoc)
	ForStreamExpr(CoreForStream, CoreType, CoreSourceLoc)
	ForResourceSourceExpr(CoreForResourceSource, CoreType, CoreSourceLoc)
	ForTensorExpr(CoreForTensor, CoreType, CoreSourceLoc)
	RangeExpr(CoreExpr, CoreExpr, CoreType, CoreSourceLoc)
	LiteralMatchExpr(CoreExpr, List[CoreLiteralMatchCase], CoreLiteralMatchFallback, CoreType, CoreSourceLoc)
	AccessorLiteralMatchExpr(CoreExpr, CoreReleasePolicy, CoreConstructorLiteralMatch, CoreType, CoreSourceLoc)
	LengthMatchExpr(CoreExpr, CoreReleasePolicy, CoreConstructorLengthMatch, CoreType, CoreSourceLoc)
	ConstructorMatchExpr(CoreExpr, CoreReleasePolicy, List[CoreConstructorMatchCase], CoreConstructorMatchFallback, CoreType, CoreSourceLoc)
	IfExpr(CoreExpr, CoreExpr, CoreExpr, CoreType, CoreSourceLoc)


