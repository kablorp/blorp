	policy: CoreForeignDefaultArgPolicy,
) -> JsonValue:
	match policy:
		ForeignScalarByValue:
			JsonObject([(KIND_FIELD, JsonString(FOREIGN_SCALAR_BY_VALUE_TAG))])
		ForeignDefensiveCopy(copy_kind):
			JsonObject([
				(KIND_FIELD, JsonString(FOREIGN_DEFENSIVE_COPY_TAG)),
				("copy_kind", foreign_copy_kind_to_json(copy_kind)),
			])


private pure func foreign_default_arg_policies_to_json(
	policies: List[CoreForeignDefaultArgPolicy],
) -> JsonValue:
	var values: List[JsonValue] = []

	for policy in policies:
		values = values.append(foreign_default_arg_policy_to_json(policy))

