private pure func decode_foreign_default_arg_policy_json(
	value: JsonValue,
	path: String,
) -> Result[CoreForeignDefaultArgPolicy, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == FOREIGN_SCALAR_BY_VALUE_TAG:
		Ok(ForeignScalarByValue)
	else if tag == FOREIGN_DEFENSIVE_COPY_TAG:
		copy_kind_tag ?= string_field(value, path, "copy_kind")
		copy_kind ?= parse_foreign_copy_kind(
			copy_kind_tag,
			path_field(path, "copy_kind"),
		)
		Ok(ForeignDefensiveCopy(copy_kind))
	else:
		Err(CoreUnsupportedTag(path, tag))


private pure func decode_foreign_default_arg_policies(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreForeignDefaultArgPolicy], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreForeignDefaultArgPolicy] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_foreign_default_arg_policy_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(policy):
						result = result.append(policy)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


private pure func foreign_arg_passing_to_json(passing: CoreForeignArgPassing) -> JsonValue:
	match passing:
		ForeignDefaultArgs(policies):
			JsonObject([
				(KIND_FIELD, JsonString(FOREIGN_DEFAULT_ARGS_TAG)),
				("policies", foreign_default_arg_policies_to_json(policies)),
			])
		ForeignBorrowArgs:
			JsonObject([(KIND_FIELD, JsonString(FOREIGN_BORROW_ARGS_TAG))])


private pure func decode_foreign_arg_passing_json(
	value: JsonValue,
	path: String,
) -> Result[CoreForeignArgPassing, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == FOREIGN_DEFAULT_ARGS_TAG:
		policies ?= decode_foreign_default_arg_policies(value, path, "policies")
		Ok(ForeignDefaultArgs(policies))
	else if tag == FOREIGN_BORROW_ARGS_TAG:
		Ok(ForeignBorrowArgs)
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func tensor_parallel_layout_to_json(layout: CoreTensorParallelLayout) -> JsonValue:
	match layout:
		TensorParallelPointerLayout:
			JsonObject([(KIND_FIELD, JsonString(TENSOR_PARALLEL_POINTER_LAYOUT_TAG))])
		TensorParallelRawScalarLayout(raw_kind):
			JsonObject([
				(KIND_FIELD, JsonString(TENSOR_PARALLEL_RAW_SCALAR_LAYOUT_TAG)),
				("raw_kind", core_tensor_raw_scalar_kind_to_json(raw_kind)),
			])
		TensorParallelInlineStructLayout(c_type):
			JsonObject([
				(KIND_FIELD, JsonString(TENSOR_PARALLEL_INLINE_STRUCT_LAYOUT_TAG)),
				("c_type", JsonString(c_type)),
			])


pure func decode_tensor_parallel_layout_json(
	value: JsonValue,
	path: String,
) -> Result[CoreTensorParallelLayout, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == TENSOR_PARALLEL_POINTER_LAYOUT_TAG:
		Ok(TensorParallelPointerLayout)
	else if tag == TENSOR_PARALLEL_RAW_SCALAR_LAYOUT_TAG:
		raw_kind_json ?= required_field(value, path, "raw_kind")
		raw_kind ?= decode_core_tensor_raw_scalar_kind_json(
			raw_kind_json,
			path_field(path, "raw_kind"),
		)
		Ok(TensorParallelRawScalarLayout(raw_kind))
	else if tag == TENSOR_PARALLEL_INLINE_STRUCT_LAYOUT_TAG:
		c_type ?= string_field(value, path, "c_type")
		Ok(TensorParallelInlineStructLayout(c_type))
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_call_kind_to_json(kind: CoreCallKind) -> JsonValue:
	match kind:
		UserCall(name, def_id):
			JsonObject([
				(KIND_FIELD, JsonString(USER_CALL_TAG)),
				("name", JsonString(name)),
				("def_id", option_int_to_json(def_id)),
			])
		ForeignCall(name, arg_passing):
			JsonObject([
				(KIND_FIELD, JsonString(FOREIGN_CALL_TAG)),
				("name", JsonString(name)),
				("arg_passing", foreign_arg_passing_to_json(arg_passing)),
			])
		BuiltinCall(name):
			JsonObject([
				(KIND_FIELD, JsonString(BUILTIN_CALL_TAG)),
				("name", JsonString(name)),
			])
		OperationResultCall(bridge):
			JsonObject([
				(KIND_FIELD, JsonString(OPERATION_RESULT_CALL_TAG)),
				("bridge", operation_result_bridge_to_json(bridge)),
			])
		FallibleStreamTerminalCall(bridge):
			JsonObject([
				(KIND_FIELD, JsonString(FALLIBLE_STREAM_TERMINAL_CALL_TAG)),
				("bridge", fallible_stream_terminal_bridge_to_json(bridge)),
			])
		TensorParallelCall(name, layout):
			JsonObject([
				(KIND_FIELD, JsonString(TENSOR_PARALLEL_CALL_TAG)),
				("name", JsonString(name)),
				("layout", tensor_parallel_layout_to_json(layout)),
			])
		ListToStringCall(callback_name):
			JsonObject([
				(KIND_FIELD, JsonString(LIST_TO_STRING_CALL_TAG)),
				("callback_name", JsonString(callback_name)),
			])
		IntrinsicCall(name):
			JsonObject([
				(KIND_FIELD, JsonString(INTRINSIC_CALL_TAG)),
				("name", JsonString(name)),
			])
		ClosureCall:
			JsonObject([(KIND_FIELD, JsonString(CLOSURE_CALL_TAG))])


pure func decode_core_call_kind_json(
	value: JsonValue,
	path: String,
) -> Result[CoreCallKind, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == USER_CALL_TAG:
		name ?= string_field(value, path, "name")
		def_id ?= decode_optional_int(value, path, "def_id")
		Ok(UserCall(name, def_id))
	else if tag == FOREIGN_CALL_TAG:
		name ?= string_field(value, path, "name")
		arg_passing_json ?= object_field(value, path, "arg_passing")
		arg_passing ?= decode_foreign_arg_passing_json(
			arg_passing_json,
			path_field(path, "arg_passing"),
		)
		Ok(ForeignCall(name, arg_passing))
	else if tag == BUILTIN_CALL_TAG:
		name ?= string_field(value, path, "name")
		Ok(BuiltinCall(name))
	else if tag == OPERATION_RESULT_CALL_TAG:
		bridge_json ?= object_field(value, path, "bridge")
		bridge ?= decode_operation_result_bridge_json(
			bridge_json,
			path_field(path, "bridge"),
		)
		Ok(OperationResultCall(bridge))
	else if tag == FALLIBLE_STREAM_TERMINAL_CALL_TAG:
		bridge_json ?= object_field(value, path, "bridge")
		bridge ?= decode_fallible_stream_terminal_bridge_json(
			bridge_json,
			path_field(path, "bridge"),
		)
		Ok(FallibleStreamTerminalCall(bridge))
	else if tag == TENSOR_PARALLEL_CALL_TAG:
		name ?= string_field(value, path, "name")
		layout_json ?= object_field(value, path, "layout")
		layout ?= decode_tensor_parallel_layout_json(
			layout_json,
			path_field(path, "layout"),
		)
		Ok(TensorParallelCall(name, layout))
	else if tag == LIST_TO_STRING_CALL_TAG:
		callback_name ?= string_field(value, path, "callback_name")
		Ok(ListToStringCall(callback_name))
	else if tag == INTRINSIC_CALL_TAG:
		name ?= string_field(value, path, "name")
		Ok(IntrinsicCall(name))
	else if tag == CLOSURE_CALL_TAG:
		Ok(ClosureCall)
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_tuple_element_to_json(element: CoreTupleElement) -> JsonValue:
	match element:
		TuplePrimElement(value):
			JsonObject([
				(KIND_FIELD, JsonString(TUPLE_PRIM_ELEMENT_TAG)),
				("value", core_expr_to_json(value)),
			])
		TuplePointerElement(value):
			JsonObject([
				(KIND_FIELD, JsonString(TUPLE_POINTER_ELEMENT_TAG)),
				("value", core_expr_to_json(value)),
			])
		TupleStructElement(value, c_type):
			JsonObject([
				(KIND_FIELD, JsonString(TUPLE_STRUCT_ELEMENT_TAG)),
				("value", core_expr_to_json(value)),
				("c_type", JsonString(c_type)),
			])
		TupleVoidElement:
			JsonObject([(KIND_FIELD, JsonString(TUPLE_VOID_ELEMENT_TAG))])
		TupleFloatElement(value):
			JsonObject([
				(KIND_FIELD, JsonString(TUPLE_FLOAT_ELEMENT_TAG)),
				("value", core_expr_to_json(value)),
			])
		TupleFloat32Element(value):
			JsonObject([
				(KIND_FIELD, JsonString(TUPLE_FLOAT32_ELEMENT_TAG)),
				("value", core_expr_to_json(value)),
			])
		TupleFloat16Element(value):
			JsonObject([
				(KIND_FIELD, JsonString(TUPLE_FLOAT16_ELEMENT_TAG)),
				("value", core_expr_to_json(value)),
			])


pure func decode_core_tuple_element_json(
	value: JsonValue,
	path: String,
) -> Result[CoreTupleElement, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == TUPLE_PRIM_ELEMENT_TAG:
		value_json ?= object_field(value, path, "value")
		expr_value ?= decode_core_expr_json(
			value_json,
			path_field(path, "value"),
		)
		Ok(TuplePrimElement(expr_value))
	else if tag == TUPLE_POINTER_ELEMENT_TAG:
		value_json ?= object_field(value, path, "value")
		expr_value ?= decode_core_expr_json(
			value_json,
			path_field(path, "value"),
		)
		Ok(TuplePointerElement(expr_value))
	else if tag == TUPLE_STRUCT_ELEMENT_TAG:
		value_json ?= object_field(value, path, "value")
		expr_value ?= decode_core_expr_json(
			value_json,
			path_field(path, "value"),
		)
		c_type ?= string_field(value, path, "c_type")
		Ok(TupleStructElement(expr_value, c_type))
	else if tag == TUPLE_VOID_ELEMENT_TAG:
		Ok(TupleVoidElement)
	else if tag == TUPLE_FLOAT_ELEMENT_TAG:
		value_json ?= object_field(value, path, "value")
		expr_value ?= decode_core_expr_json(
			value_json,
			path_field(path, "value"),
		)
		Ok(TupleFloatElement(expr_value))
	else if tag == TUPLE_FLOAT32_ELEMENT_TAG:
		value_json ?= object_field(value, path, "value")
		expr_value ?= decode_core_expr_json(
			value_json,
			path_field(path, "value"),
		)
		Ok(TupleFloat32Element(expr_value))
	else if tag == TUPLE_FLOAT16_ELEMENT_TAG:
		value_json ?= object_field(value, path, "value")
		expr_value ?= decode_core_expr_json(
			value_json,
			path_field(path, "value"),
		)
		Ok(TupleFloat16Element(expr_value))
	else:
		Err(CoreUnsupportedTag(path, tag))


private pure func core_tuple_elements_to_json(elements: List[CoreTupleElement]) -> JsonValue:
	var values: List[JsonValue] = []

	for element in elements:
		values = values.append(core_tuple_element_to_json(element))

	JsonVector(values)


private pure func decode_core_tuple_elements(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreTupleElement], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreTupleElement] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_tuple_element_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(element):
						result = result.append(element)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func core_tuple_construct_to_json(construct: CoreTupleConstruct) -> JsonValue:
