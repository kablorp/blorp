		Ok(TupleConstructExpr(elements, typ, loc))
	else if tag == LIST_CONSTRUCT_EXPR_TAG:
		construct_json ?= object_field(value, path, "construct")
		construct ?= decode_core_list_construct_json(
			construct_json,
			path_field(path, "construct"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
