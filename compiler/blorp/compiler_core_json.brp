		iterable_json,
		path_field(path, "iterable"),
	)
	iterable_release_policy_tag ?= string_field(value, path, "iterable_release_policy")
	iterable_release_policy ?= parse_core_release_policy(
		iterable_release_policy_tag,
		path_field(path, "iterable_release_policy"),
	)
	body_json ?= object_field(value, path, "body")
	body ?= decode_core_expr_json(
		body_json,
		path_field(path, "body"),
	)

	Ok({
		binder = binder,
		iterable = iterable,
		iterable_release_policy = iterable_release_policy,
		body = body,
	})


pure func core_tensor_for_element_storage_to_json(
	storage: CoreTensorForElementStorage,
) -> JsonValue:
	match storage:
		TensorForInlineStructElement(c_type):
			JsonObject([
				(KIND_FIELD, JsonString(TENSOR_FOR_INLINE_STRUCT_ELEMENT_TAG)),
				("c_type", JsonString(c_type)),
			])
		TensorForRawScalarElement(raw_kind):
			JsonObject([
				(KIND_FIELD, JsonString(TENSOR_FOR_RAW_SCALAR_ELEMENT_TAG)),
				("raw_kind", core_tensor_raw_scalar_kind_to_json(raw_kind)),
			])
		TensorForRuntimeReadElement(runtime_read):
			JsonObject([
				(KIND_FIELD, JsonString(TENSOR_FOR_RUNTIME_READ_ELEMENT_TAG)),
				("value_c_type", JsonString(runtime_read.value_c_type)),
				(
					"helper",
					JsonString(core_tensor_runtime_read_helper_to_string(runtime_read.helper)),
				),
			])
		TensorForRowSliceElement(row_slice):
			JsonObject([
				(KIND_FIELD, JsonString(TENSOR_FOR_ROW_SLICE_ELEMENT_TAG)),
				("row_size", JsonString(row_slice.row_size)),
				("result_first_dim", JsonString(row_slice.result_first_dim)),
				("runtime_derived", JsonBool(row_slice.runtime_derived)),
			])
		TensorForBoxedElement(value_c_type):
			JsonObject([
				(KIND_FIELD, JsonString(TENSOR_FOR_BOXED_ELEMENT_TAG)),
				("value_c_type", JsonString(value_c_type)),
			])


pure func core_tensor_runtime_read_helper_to_string(helper: CoreTensorRuntimeReadHelper) -> String:
	match helper:
		TensorRuntimeReadI64:
			TENSOR_RUNTIME_READ_I64_TAG
		TensorRuntimeReadF64:
			TENSOR_RUNTIME_READ_F64_TAG
		TensorRuntimeReadF32:
			TENSOR_RUNTIME_READ_F32_TAG
		TensorRuntimeReadF16:
			TENSOR_RUNTIME_READ_F16_TAG


pure func parse_core_tensor_runtime_read_helper(
	tag: String,
	path: String,
) -> Result[CoreTensorRuntimeReadHelper, CoreJsonError]:
	if tag == TENSOR_RUNTIME_READ_I64_TAG:
		Ok(TensorRuntimeReadI64)
	else if tag == TENSOR_RUNTIME_READ_F64_TAG:
		Ok(TensorRuntimeReadF64)
	else if tag == TENSOR_RUNTIME_READ_F32_TAG:
		Ok(TensorRuntimeReadF32)
	else if tag == TENSOR_RUNTIME_READ_F16_TAG:
		Ok(TensorRuntimeReadF16)
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func decode_core_tensor_for_element_storage_json(
	value: JsonValue,
	path: String,
) -> Result[CoreTensorForElementStorage, CoreJsonError]:
	tag ?= string_field(value, path, KIND_FIELD)

	if tag == TENSOR_FOR_INLINE_STRUCT_ELEMENT_TAG:
		c_type ?= string_field(value, path, "c_type")
		Ok(TensorForInlineStructElement(c_type))
	else if tag == TENSOR_FOR_RAW_SCALAR_ELEMENT_TAG:
		raw_kind_json ?= required_field(value, path, "raw_kind")
		raw_kind ?= decode_core_tensor_raw_scalar_kind_json(
			raw_kind_json,
			path_field(path, "raw_kind"),
		)
		Ok(TensorForRawScalarElement(raw_kind))
	else if tag == TENSOR_FOR_RUNTIME_READ_ELEMENT_TAG:
		value_c_type ?= string_field(value, path, "value_c_type")
		helper_tag ?= string_field(value, path, "helper")
		helper ?= parse_core_tensor_runtime_read_helper(
			helper_tag,
			path_field(path, "helper"),
		)
		Ok(TensorForRuntimeReadElement({
			value_c_type = value_c_type,
			helper = helper,
		}))
	else if tag == TENSOR_FOR_ROW_SLICE_ELEMENT_TAG:
		row_size ?= string_field(value, path, "row_size")
		result_first_dim ?= string_field(value, path, "result_first_dim")
		runtime_derived ?= bool_field(value, path, "runtime_derived")
		Ok(TensorForRowSliceElement({
			row_size = row_size,
			result_first_dim = result_first_dim,
			runtime_derived = runtime_derived,
		}))
	else if tag == TENSOR_FOR_BOXED_ELEMENT_TAG:
		value_c_type ?= string_field(value, path, "value_c_type")
		Ok(TensorForBoxedElement(value_c_type))
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_for_tensor_to_json(for_tensor: CoreForTensor) -> JsonValue:
	JsonObject([
		("binder", core_loop_binder_to_json(for_tensor.binder)),
		("element_storage", core_tensor_for_element_storage_to_json(for_tensor.element_storage)),
		("iterable", core_expr_to_json(for_tensor.iterable)),
		(
			"iterable_release_policy",
			JsonString(core_release_policy_to_string(for_tensor.iterable_release_policy)),
		),
		("body", core_expr_to_json(for_tensor.body)),
	])


pure func decode_core_for_tensor_json(
	value: JsonValue,
	path: String,
) -> Result[CoreForTensor, CoreJsonError]:
	binder_json ?= object_field(value, path, "binder")
	binder ?= decode_core_loop_binder_json(
		binder_json,
		path_field(path, "binder"),
	)
	element_storage_json ?= object_field(value, path, "element_storage")
	element_storage ?= decode_core_tensor_for_element_storage_json(
		element_storage_json,
		path_field(path, "element_storage"),
	)
	iterable_json ?= object_field(value, path, "iterable")
	iterable ?= decode_core_expr_json(
		iterable_json,
		path_field(path, "iterable"),
	)
	iterable_release_policy_tag ?= string_field(value, path, "iterable_release_policy")
	iterable_release_policy ?= parse_core_release_policy(
		iterable_release_policy_tag,
		path_field(path, "iterable_release_policy"),
	)
	body_json ?= object_field(value, path, "body")
	body ?= decode_core_expr_json(
		body_json,
		path_field(path, "body"),
	)

	Ok({
		binder = binder,
		element_storage = element_storage,
		iterable = iterable,
		iterable_release_policy = iterable_release_policy,
		body = body,
	})


pure func core_resource_exit_to_string(exit: CoreResourceExit) -> String:
	match exit:
		ResourceBreakExit:
			RESOURCE_BREAK_EXIT_TAG
		ResourceContinueExit:
			RESOURCE_CONTINUE_EXIT_TAG


pure func parse_core_resource_exit(
	tag: String,
	path: String,
) -> Result[CoreResourceExit, CoreJsonError]:
	if tag == RESOURCE_BREAK_EXIT_TAG:
		Ok(ResourceBreakExit)
	else if tag == RESOURCE_CONTINUE_EXIT_TAG:
		Ok(ResourceContinueExit)
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_resource_scope_to_json(scope: CoreResourceScope) -> JsonValue:
	JsonObject([
		("var", core_var_to_json(scope.variable)),
		("type", core_type_to_json(scope.typ)),
		("acquire", core_expr_to_json(scope.acquire)),
		("body", core_expr_to_json(scope.body)),
		("cleanup", core_expr_to_json(scope.cleanup)),
	])


pure func decode_core_resource_scope_json(
	value: JsonValue,
	path: String,
) -> Result[CoreResourceScope, CoreJsonError]:
	var_json ?= object_field(value, path, "var")
	variable ?= decode_core_var_json(
		var_json,
		path_field(path, "var"),
	)
	type_json ?= object_field(value, path, "type")
	typ ?= decode_core_type_json(
		type_json,
		path_field(path, "type"),
	)
	acquire_json ?= object_field(value, path, "acquire")
	acquire ?= decode_core_expr_json(
		acquire_json,
		path_field(path, "acquire"),
	)
	body_json ?= object_field(value, path, "body")
	body ?= decode_core_expr_json(
		body_json,
		path_field(path, "body"),
	)
	cleanup_json ?= object_field(value, path, "cleanup")
	cleanup ?= decode_core_expr_json(
		cleanup_json,
		path_field(path, "cleanup"),
	)

	Ok({
		variable = variable,
		typ = typ,
		acquire = acquire,
		body = body,
		cleanup = cleanup,
	})


pure func core_resource_cleanup_exit_to_json(exit: CoreResourceCleanupExit) -> JsonValue:
	JsonObject([
		("cleanups", core_expr_list_to_json(exit.cleanups)),
		("exit", JsonString(core_resource_exit_to_string(exit.exit))),
	])


pure func decode_core_resource_cleanup_exit_json(
	value: JsonValue,
	path: String,
) -> Result[CoreResourceCleanupExit, CoreJsonError]:
	cleanups ?= decode_core_expr_list(value, path, "cleanups")
	exit_tag ?= string_field(value, path, "exit")
	exit ?= parse_core_resource_exit(
		exit_tag,
		path_field(path, "exit"),
	)

	Ok({
		cleanups = cleanups,
		exit = exit,
	})


pure func core_literal_match_case_to_json(match_case: CoreLiteralMatchCase) -> JsonValue:
	JsonObject([
		("literal", core_literal_to_json(match_case.literal)),
		("bindings", core_match_bindings_to_json(match_case.bindings)),
		("body", core_expr_to_json(match_case.body)),
	])


private pure func core_literal_match_cases_to_json(cases: List[CoreLiteralMatchCase]) -> JsonValue:
	var values: List[JsonValue] = []

	for match_case in cases:
		values = values.append(core_literal_match_case_to_json(match_case))

	JsonVector(values)


pure func core_literal_match_fallback_to_json(fallback: CoreLiteralMatchFallback) -> JsonValue:
	match fallback:
		LiteralMatchFallbackBody(body):
			JsonObject([
				(KIND_FIELD, JsonString(LITERAL_MATCH_FALLBACK_BODY_TAG)),
				("body", core_expr_to_json(body)),
			])
		LiteralMatchFallbackBindings(bindings, body):
			JsonObject([
				(KIND_FIELD, JsonString(LITERAL_MATCH_FALLBACK_BINDINGS_TAG)),
				("bindings", core_match_bindings_to_json(bindings)),
				("body", core_expr_to_json(body)),
			])
		LiteralMatchFallbackFail:
			JsonObject([(KIND_FIELD, JsonString(LITERAL_MATCH_FALLBACK_FAIL_TAG))])


pure func decode_core_literal_match_case_json(
	value: JsonValue,
	path: String,
) -> Result[CoreLiteralMatchCase, CoreJsonError]:
	literal_json ?= object_field(value, path, "literal")
	literal ?= decode_core_literal_json(
		literal_json,
		path_field(path, "literal"),
	)
	bindings ?= decode_core_match_bindings(value, path, "bindings")
	body_json ?= object_field(value, path, "body")
	body ?= decode_core_expr_json(
		body_json,
		path_field(path, "body"),
	)

	Ok({
		literal = literal,
		bindings = bindings,
		body = body,
	})


private pure func decode_core_literal_match_cases(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreLiteralMatchCase], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreLiteralMatchCase] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_literal_match_case_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(match_case):
						result = result.append(match_case)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func decode_core_literal_match_fallback_json(
	value: JsonValue,
	path: String,
) -> Result[CoreLiteralMatchFallback, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == LITERAL_MATCH_FALLBACK_BODY_TAG:
		body_json ?= object_field(value, path, "body")
		body ?= decode_core_expr_json(
			body_json,
			path_field(path, "body"),
		)
		Ok(LiteralMatchFallbackBody(body))
	else if tag == LITERAL_MATCH_FALLBACK_BINDINGS_TAG:
		bindings ?= decode_core_match_bindings(value, path, "bindings")
		body_json ?= object_field(value, path, "body")
		body ?= decode_core_expr_json(
			body_json,
			path_field(path, "body"),
		)
		Ok(LiteralMatchFallbackBindings(bindings, body))
	else if tag == LITERAL_MATCH_FALLBACK_FAIL_TAG:
		Ok(LiteralMatchFallbackFail)
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_constructor_match_test_to_json(test: CoreConstructorMatchTest) -> JsonValue:
	match test:
		EnumConstructorTest(c_name):
			JsonObject([
				(KIND_FIELD, JsonString(ENUM_CONSTRUCTOR_TEST_TAG)),
				("c_name", JsonString(c_name)),
			])
		UnionTagConstructorTest(tag_c_name, union_c_type):
			JsonObject([
				(KIND_FIELD, JsonString(UNION_TAG_CONSTRUCTOR_TEST_TAG)),
				("tag_c_name", JsonString(tag_c_name)),
				("union_c_type", JsonString(union_c_type)),
			])
		NullableOptionSomeConstructorTest:
			JsonObject([(KIND_FIELD, JsonString(NULLABLE_OPTION_SOME_CONSTRUCTOR_TEST_TAG))])
		NullableOptionNoneConstructorTest:
			JsonObject([(KIND_FIELD, JsonString(NULLABLE_OPTION_NONE_CONSTRUCTOR_TEST_TAG))])
		StackOptionSomeConstructorTest(option_type):
			JsonObject([
				(KIND_FIELD, JsonString(STACK_OPTION_SOME_CONSTRUCTOR_TEST_TAG)),
				("option_type", JsonString(option_type)),
			])
		StackOptionNoneConstructorTest(option_type):
			JsonObject([
				(KIND_FIELD, JsonString(STACK_OPTION_NONE_CONSTRUCTOR_TEST_TAG)),
				("option_type", JsonString(option_type)),
			])
		StackResultOkConstructorTest:
			JsonObject([(KIND_FIELD, JsonString(STACK_RESULT_OK_CONSTRUCTOR_TEST_TAG))])
		StackResultErrConstructorTest:
			JsonObject([(KIND_FIELD, JsonString(STACK_RESULT_ERR_CONSTRUCTOR_TEST_TAG))])
		BoxedResultOkConstructorTest:
			JsonObject([(KIND_FIELD, JsonString(BOXED_RESULT_OK_CONSTRUCTOR_TEST_TAG))])
		BoxedResultErrConstructorTest:
			JsonObject([(KIND_FIELD, JsonString(BOXED_RESULT_ERR_CONSTRUCTOR_TEST_TAG))])
		BoolTrueConstructorTest:
			JsonObject([(KIND_FIELD, JsonString(BOOL_TRUE_CONSTRUCTOR_TEST_TAG))])
		BoolFalseConstructorTest:
			JsonObject([(KIND_FIELD, JsonString(BOOL_FALSE_CONSTRUCTOR_TEST_TAG))])


pure func decode_core_constructor_match_test_json(
	value: JsonValue,
	path: String,
) -> Result[CoreConstructorMatchTest, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == ENUM_CONSTRUCTOR_TEST_TAG:
		c_name ?= string_field(value, path, "c_name")
		Ok(EnumConstructorTest(c_name))
	else if tag == UNION_TAG_CONSTRUCTOR_TEST_TAG:
		tag_c_name ?= string_field(value, path, "tag_c_name")
		union_c_type ?= string_field(value, path, "union_c_type")
		Ok(UnionTagConstructorTest(tag_c_name, union_c_type))
	else if tag == NULLABLE_OPTION_SOME_CONSTRUCTOR_TEST_TAG:
		Ok(NullableOptionSomeConstructorTest)
	else if tag == NULLABLE_OPTION_NONE_CONSTRUCTOR_TEST_TAG:
		Ok(NullableOptionNoneConstructorTest)
	else if tag == STACK_OPTION_SOME_CONSTRUCTOR_TEST_TAG:
		option_type ?= string_field(value, path, "option_type")
		Ok(StackOptionSomeConstructorTest(option_type))
	else if tag == STACK_OPTION_NONE_CONSTRUCTOR_TEST_TAG:
		option_type ?= string_field(value, path, "option_type")
		Ok(StackOptionNoneConstructorTest(option_type))
	else if tag == STACK_RESULT_OK_CONSTRUCTOR_TEST_TAG:
		Ok(StackResultOkConstructorTest)
	else if tag == STACK_RESULT_ERR_CONSTRUCTOR_TEST_TAG:
		Ok(StackResultErrConstructorTest)
	else if tag == BOXED_RESULT_OK_CONSTRUCTOR_TEST_TAG:
		Ok(BoxedResultOkConstructorTest)
	else if tag == BOXED_RESULT_ERR_CONSTRUCTOR_TEST_TAG:
		Ok(BoxedResultErrConstructorTest)
	else if tag == BOOL_TRUE_CONSTRUCTOR_TEST_TAG:
		Ok(BoolTrueConstructorTest)
	else if tag == BOOL_FALSE_CONSTRUCTOR_TEST_TAG:
		Ok(BoolFalseConstructorTest)
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_accessor_to_json(accessor: CoreAccessor) -> JsonValue:
	match accessor:
		RootAccessor:
			JsonObject([(KIND_FIELD, JsonString(ROOT_ACCESSOR_TAG))])
		VariantFieldAccessor(parent, union_c_type, constructor, field_index):
			JsonObject([
				(KIND_FIELD, JsonString(VARIANT_FIELD_ACCESSOR_TAG)),
				("parent", core_accessor_to_json(parent)),
				("union_c_type", JsonString(union_c_type)),
				("constructor", JsonString(constructor)),
				("field_index", json_int(field_index)),
			])
		ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index):
			JsonObject([
				(KIND_FIELD, JsonString(ERASED_VARIANT_FIELD_ACCESSOR_TAG)),
				("parent", core_accessor_to_json(parent)),
				("union_c_type", JsonString(union_c_type)),
				("constructor", JsonString(constructor)),
				("field_index", json_int(field_index)),
			])
		NullableOptionPayloadAccessor(parent):
			JsonObject([
				(KIND_FIELD, JsonString(NULLABLE_OPTION_PAYLOAD_ACCESSOR_TAG)),
				("parent", core_accessor_to_json(parent)),
			])
		StackOptionPayloadAccessor(parent):
			JsonObject([
				(KIND_FIELD, JsonString(STACK_OPTION_PAYLOAD_ACCESSOR_TAG)),
				("parent", core_accessor_to_json(parent)),
			])
		StackResultOkPayloadAccessor(parent):
			JsonObject([
				(KIND_FIELD, JsonString(STACK_RESULT_OK_PAYLOAD_ACCESSOR_TAG)),
				("parent", core_accessor_to_json(parent)),
			])
		StackResultErrPayloadAccessor(parent):
			JsonObject([
				(KIND_FIELD, JsonString(STACK_RESULT_ERR_PAYLOAD_ACCESSOR_TAG)),
				("parent", core_accessor_to_json(parent)),
			])
		BoxedResultOkPayloadAccessor(parent):
			JsonObject([
				(KIND_FIELD, JsonString(BOXED_RESULT_OK_PAYLOAD_ACCESSOR_TAG)),
				("parent", core_accessor_to_json(parent)),
			])
		BoxedResultErrPayloadAccessor(parent):
			JsonObject([
				(KIND_FIELD, JsonString(BOXED_RESULT_ERR_PAYLOAD_ACCESSOR_TAG)),
				("parent", core_accessor_to_json(parent)),
			])
		TupleFieldAccessor(parent, index, typ):
			JsonObject([
				(KIND_FIELD, JsonString(TUPLE_FIELD_ACCESSOR_TAG)),
				("parent", core_accessor_to_json(parent)),
				("index", json_int(index)),
				("type", core_type_to_json(typ)),
			])
		ListElementAccessor(parent, index):
			JsonObject([
				(KIND_FIELD, JsonString(LIST_ELEMENT_ACCESSOR_TAG)),
				("parent", core_accessor_to_json(parent)),
				("index", json_int(index)),
			])
		ListSpreadAccessor(parent, offset):
			JsonObject([
				(KIND_FIELD, JsonString(LIST_SPREAD_ACCESSOR_TAG)),
				("parent", core_accessor_to_json(parent)),
				("offset", json_int(offset)),
			])


pure func decode_core_accessor_json(
	value: JsonValue,
	path: String,
) -> Result[CoreAccessor, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == ROOT_ACCESSOR_TAG:
		Ok(RootAccessor)
	else if tag == VARIANT_FIELD_ACCESSOR_TAG:
		parent_json ?= object_field(value, path, "parent")
		parent ?= decode_core_accessor_json(
			parent_json,
			path_field(path, "parent"),
		)
		union_c_type ?= string_field(value, path, "union_c_type")
		constructor ?= string_field(value, path, "constructor")
		field_index ?= int_field(value, path, "field_index")
		Ok(VariantFieldAccessor(parent, union_c_type, constructor, field_index))
	else if tag == ERASED_VARIANT_FIELD_ACCESSOR_TAG:
		parent_json ?= object_field(value, path, "parent")
		parent ?= decode_core_accessor_json(
			parent_json,
			path_field(path, "parent"),
		)
		union_c_type ?= string_field(value, path, "union_c_type")
		constructor ?= string_field(value, path, "constructor")
		field_index ?= int_field(value, path, "field_index")
		Ok(ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index))
	else if tag == NULLABLE_OPTION_PAYLOAD_ACCESSOR_TAG:
		parent_json ?= object_field(value, path, "parent")
		parent ?= decode_core_accessor_json(
			parent_json,
			path_field(path, "parent"),
		)
		Ok(NullableOptionPayloadAccessor(parent))
	else if tag == STACK_OPTION_PAYLOAD_ACCESSOR_TAG:
		parent_json ?= object_field(value, path, "parent")
		parent ?= decode_core_accessor_json(
			parent_json,
			path_field(path, "parent"),
		)
		Ok(StackOptionPayloadAccessor(parent))
	else if tag == STACK_RESULT_OK_PAYLOAD_ACCESSOR_TAG:
		parent_json ?= object_field(value, path, "parent")
		parent ?= decode_core_accessor_json(
			parent_json,
			path_field(path, "parent"),
		)
		Ok(StackResultOkPayloadAccessor(parent))
	else if tag == STACK_RESULT_ERR_PAYLOAD_ACCESSOR_TAG:
		parent_json ?= object_field(value, path, "parent")
		parent ?= decode_core_accessor_json(
			parent_json,
			path_field(path, "parent"),
		)
		Ok(StackResultErrPayloadAccessor(parent))
	else if tag == BOXED_RESULT_OK_PAYLOAD_ACCESSOR_TAG:
		parent_json ?= object_field(value, path, "parent")
		parent ?= decode_core_accessor_json(
			parent_json,
			path_field(path, "parent"),
		)
		Ok(BoxedResultOkPayloadAccessor(parent))
	else if tag == BOXED_RESULT_ERR_PAYLOAD_ACCESSOR_TAG:
		parent_json ?= object_field(value, path, "parent")
		parent ?= decode_core_accessor_json(
			parent_json,
			path_field(path, "parent"),
		)
		Ok(BoxedResultErrPayloadAccessor(parent))
	else if tag == TUPLE_FIELD_ACCESSOR_TAG:
		parent_json ?= object_field(value, path, "parent")
		parent ?= decode_core_accessor_json(
			parent_json,
			path_field(path, "parent"),
		)
		index ?= int_field(value, path, "index")
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		Ok(TupleFieldAccessor(parent, index, typ))
	else if tag == LIST_ELEMENT_ACCESSOR_TAG:
		parent_json ?= object_field(value, path, "parent")
		parent ?= decode_core_accessor_json(
			parent_json,
			path_field(path, "parent"),
		)
		index ?= int_field(value, path, "index")
		Ok(ListElementAccessor(parent, index))
	else if tag == LIST_SPREAD_ACCESSOR_TAG:
		parent_json ?= object_field(value, path, "parent")
		parent ?= decode_core_accessor_json(
			parent_json,
			path_field(path, "parent"),
		)
		offset ?= int_field(value, path, "offset")
		Ok(ListSpreadAccessor(parent, offset))
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_match_binding_mode_to_json(mode: CoreMatchBindingMode) -> JsonValue:
	match mode:
		MatchBorrowBindingMode:
			JsonString(MATCH_BORROW_BINDING_MODE_TAG)
		MatchOwnBindingMode:
			JsonString(MATCH_OWN_BINDING_MODE_TAG)


pure func decode_core_match_binding_mode_json(
	value: JsonValue,
	path: String,
) -> Result[CoreMatchBindingMode, CoreJsonError]:
	match as_string(value):
		Some(tag):
			if tag == MATCH_BORROW_BINDING_MODE_TAG:
				Ok(MatchBorrowBindingMode)
			else if tag == MATCH_OWN_BINDING_MODE_TAG:
				Ok(MatchOwnBindingMode)
			else:
				Err(CoreUnsupportedTag(path, tag))
		None:
			Err(CoreExpectedStringField(path, "mode"))


pure func core_match_binding_to_json(binding: CoreMatchBinding) -> JsonValue:
	JsonObject([
		("variable", core_var_to_json(binding.variable)),
		("type", core_type_to_json(binding.typ)),
		("accessor", core_accessor_to_json(binding.accessor)),
		("mode", core_match_binding_mode_to_json(binding.mode)),
	])


private pure func core_match_bindings_to_json(bindings: List[CoreMatchBinding]) -> JsonValue:
	var values: List[JsonValue] = []

	for binding in bindings:
		values = values.append(core_match_binding_to_json(binding))

	JsonVector(values)


pure func decode_core_match_binding_json(
	value: JsonValue,
	path: String,
) -> Result[CoreMatchBinding, CoreJsonError]:
	variable_json ?= object_field(value, path, "variable")
	variable ?= decode_core_var_json(
		variable_json,
		path_field(path, "variable"),
	)
	type_json ?= object_field(value, path, "type")
	typ ?= decode_core_type_json(
		type_json,
		path_field(path, "type"),
	)
	accessor_json ?= object_field(value, path, "accessor")
	accessor ?= decode_core_accessor_json(
		accessor_json,
		path_field(path, "accessor"),
	)
	mode_json ?= required_field(value, path, "mode")
	mode ?= decode_core_match_binding_mode_json(
		mode_json,
		path_field(path, "mode"),
	)

	Ok({
		variable = variable,
		typ = typ,
		accessor = accessor,
		mode = mode,
	})


private pure func decode_core_match_bindings(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreMatchBinding], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreMatchBinding] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_match_binding_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(binding):
						result = result.append(binding)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func core_constructor_literal_match_to_json(
	match_expr: CoreConstructorLiteralMatch,
) -> JsonValue:
	JsonObject([
		("accessor", core_accessor_to_json(match_expr.accessor)),
		("scrutinee_type", core_type_to_json(match_expr.scrutinee_type)),
		("cases", core_literal_match_cases_to_json(match_expr.cases)),
		("fallback", core_literal_match_fallback_to_json(match_expr.fallback)),
		("type", core_type_to_json(match_expr.result_type)),
		("loc", source_loc_to_json(match_expr.loc)),
	])


pure func core_constructor_length_match_branch_to_json(
	branch: CoreConstructorLengthMatchBranch,
) -> JsonValue:
