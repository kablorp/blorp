pure func core_list_handoff_to_json(handoff: CoreListHandoff) -> JsonValue:
	JsonObject([
		("mode", core_list_handoff_mode_to_json(handoff.mode)),
		("layout", core_list_storage_layout_to_json(handoff.layout)),
		("elem_needs_release", JsonBool(handoff.elem_needs_release)),
		("source", core_expr_to_json(handoff.source)),
		("source_var", core_var_to_json(handoff.source_var)),
		("source_type", core_type_to_json(handoff.source_type)),
		("result_type", core_type_to_json(handoff.result_type)),
		("capacity", core_expr_to_json(handoff.capacity)),
		("result_var", core_var_to_json(handoff.result_var)),
		("len_var", core_var_to_json(handoff.len_var)),
		("out_var", core_var_to_json(handoff.out_var)),
		("body", core_expr_to_json(handoff.body)),
		("write_order", core_list_handoff_write_order_to_json(handoff.write_order)),
	])


pure func decode_core_list_handoff_json(
	value: JsonValue,
	path: String,
) -> Result[CoreListHandoff, CoreJsonError]:
	mode_json ?= required_field(value, path, "mode")
	mode ?= decode_core_list_handoff_mode_json(
		mode_json,
		path_field(path, "mode"),
	)
	layout_json ?= object_field(value, path, "layout")
	layout ?= decode_core_list_storage_layout_json(
		layout_json,
		path_field(path, "layout"),
	)
	elem_needs_release ?= bool_field(value, path, "elem_needs_release")
	source_json ?= object_field(value, path, "source")
	source ?= decode_core_expr_json(
		source_json,
		path_field(path, "source"),
	)
	source_var_json ?= object_field(value, path, "source_var")
	source_var ?= decode_core_var_json(
		source_var_json,
		path_field(path, "source_var"),
	)
	source_type_json ?= object_field(value, path, "source_type")
	source_type ?= decode_core_type_json(
		source_type_json,
		path_field(path, "source_type"),
	)
	result_type_json ?= object_field(value, path, "result_type")
	result_type ?= decode_core_type_json(
		result_type_json,
		path_field(path, "result_type"),
	)
	capacity_json ?= object_field(value, path, "capacity")
	capacity ?= decode_core_expr_json(
		capacity_json,
		path_field(path, "capacity"),
	)
	result_var_json ?= object_field(value, path, "result_var")
	result_var ?= decode_core_var_json(
		result_var_json,
		path_field(path, "result_var"),
	)
	len_var_json ?= object_field(value, path, "len_var")
	len_var ?= decode_core_var_json(
		len_var_json,
		path_field(path, "len_var"),
	)
	out_var_json ?= object_field(value, path, "out_var")
	out_var ?= decode_core_var_json(
		out_var_json,
		path_field(path, "out_var"),
	)
	body_json ?= object_field(value, path, "body")
	body ?= decode_core_expr_json(
		body_json,
		path_field(path, "body"),
	)
	write_order_json ?= required_field(value, path, "write_order")
	write_order ?= decode_core_list_handoff_write_order_json(
		write_order_json,
		path_field(path, "write_order"),
	)

	Ok({
		mode = mode,
		layout = layout,
		elem_needs_release = elem_needs_release,
		source = source,
		source_var = source_var,
		source_type = source_type,
		result_type = result_type,
		capacity = capacity,
		result_var = result_var,
		len_var = len_var,
		out_var = out_var,
		body = body,
		write_order = write_order,
	})


