	value: JsonValue,
	path: String,
) -> Result[CoreTensorRawViewBinding, CoreJsonError]:
	variable_json ?= object_field(value, path, "variable")
	variable ?= decode_core_var_json(
		variable_json,
		path_field(path, "variable"),
	)
	kind_json ?= required_field(value, path, "raw_kind")
	kind ?= decode_core_tensor_raw_scalar_kind_json(
		kind_json,
		path_field(path, "raw_kind"),
	)
	source_json ?= object_field(value, path, "source")
	source ?= decode_core_expr_json(
		source_json,
		path_field(path, "source"),
	)

	Ok({
		variable = variable,
		kind = kind,
		source = source,
	})


pure func core_list_set_to_json(set: CoreListSet) -> JsonValue:
