-- Typed JSON model for the Core subset that the Blorp compiler backend will
-- consume first.
--
-- This is deliberately not a string template protocol. JSON tags are decoded
-- once at the transfer boundary into Core-specific variants, so emission code
-- can make illegal states unrepresentable as the port expands.
import:
	json:
		JsonValue(JsonBool, JsonNull, JsonNumber, JsonObject, JsonString, JsonVector),
		as_array,
		as_bool,
		as_number,
		as_string,
		get_field,


private KIND_FIELD: String = "kind"

private PROGRAM_TAG: String = "program"

private FUNCTION_TAG: String = "function"

private KNOWN_LOC_TAG: String = "known"

private SYNTHETIC_LOC_TAG: String = "synthetic"

private VOID_TYPE_TAG: String = "void"

private NAMED_TYPE_TAG: String = "named"

private TUPLE_TYPE_TAG: String = "tuple"

private INT_LITERAL_TAG: String = "int"

private BOOL_LITERAL_TAG: String = "bool"

private STRING_LITERAL_TAG: String = "string"

private USER_CALL_TAG: String = "user"

private FOREIGN_CALL_TAG: String = "foreign"

private BUILTIN_CALL_TAG: String = "builtin"

private INTRINSIC_CALL_TAG: String = "intrinsic"

private CLOSURE_CALL_TAG: String = "closure"

private LITERAL_EXPR_TAG: String = "literal"

private VAR_EXPR_TAG: String = "var"

private VOID_EXPR_TAG: String = "void"

private CALL_EXPR_TAG: String = "call"

private SEQ_EXPR_TAG: String = "seq"

private IF_EXPR_TAG: String = "if"

private BINARY_EXPR_TAG: String = "binary"

private UNARY_EXPR_TAG: String = "unary"

private LOGICAL_EXPR_TAG: String = "logical"

private ASSIGN_EXPR_TAG: String = "assign"

private LET_EXPR_TAG: String = "let"

private ADD_OP_TAG: String = "add"

private SUBTRACT_OP_TAG: String = "subtract"

private MULTIPLY_OP_TAG: String = "multiply"

private DIVIDE_OP_TAG: String = "divide"

private EQUAL_OP_TAG: String = "equal"

private NOT_EQUAL_OP_TAG: String = "not_equal"

private LESS_OP_TAG: String = "less"

private LESS_EQUAL_OP_TAG: String = "less_equal"

private GREATER_OP_TAG: String = "greater"

private GREATER_EQUAL_OP_TAG: String = "greater_equal"

private NEGATE_OP_TAG: String = "negate"

private NOT_OP_TAG: String = "not"

private AND_OP_TAG: String = "and"

private OR_OP_TAG: String = "or"


record CoreSourceSpan {
	file: String,
	line: Int,
	column: Int,
	end_line: Int,
	end_column: Int
}


union CoreSourceLoc:
	KnownSourceLoc(CoreSourceSpan)
	SyntheticSourceLoc


record CoreVar {
	name: String,
	uniq: Int,
	def_id: Option[Int]
}


union CoreType:
	VoidType
	NamedType(String, List[CoreType])
	TupleType(List[CoreType])


union CoreLiteral:
	IntLiteral(Int)
	BoolLiteral(Bool)
	StringLiteral(String)


union CoreCallKind:
	UserCall(String, Option[Int])
	ForeignCall(String)
	BuiltinCall(String)
	IntrinsicCall(String)
	ClosureCall


enum CoreBinaryOp:
	AddOp
	SubtractOp
	MultiplyOp
	DivideOp
	EqualOp
	NotEqualOp
	LessOp
	LessEqualOp
	GreaterOp
	GreaterEqualOp


enum CoreUnaryOp:
	NegateOp
	NotOp


enum CoreLogicalOp:
	AndOp
	OrOp


union CoreExpr:
	LiteralExpr(CoreLiteral, CoreType, CoreSourceLoc)
	VarExpr(CoreVar, CoreType, CoreSourceLoc)
	VoidExpr(CoreType, CoreSourceLoc)
	CallExpr(CoreCallKind, CoreExpr, List[CoreExpr], CoreType, CoreSourceLoc)
	BinaryExpr(CoreBinaryOp, CoreExpr, CoreExpr, CoreType, CoreSourceLoc)
	UnaryExpr(CoreUnaryOp, CoreExpr, CoreType, CoreSourceLoc)
	LogicalExpr(CoreLogicalOp, CoreExpr, CoreExpr, CoreType, CoreSourceLoc)
	AssignExpr(CoreVar, CoreExpr, CoreType, CoreSourceLoc)
	LetExpr(CoreVar, Bool, CoreType, CoreExpr, CoreExpr)
	SeqExpr(CoreExpr, CoreExpr)
	IfExpr(CoreExpr, CoreExpr, CoreExpr, CoreType, CoreSourceLoc)


record CoreParam {
	name: CoreVar,
	typ: CoreType,
	loc: CoreSourceLoc
}


enum CoreFunctionKind:
	UserFunction
	BuiltinFunction
	ForeignFunction
	ClosureBodyFunction


record CoreFunction {
	name: String,
	source_module: Option[String],
	type_params: List[String],
	params: List[CoreParam],
	return_type: CoreType,
	body: Option[CoreExpr],
	is_pure: Bool,
	function_kind: CoreFunctionKind,
	def_id: Int,
	loc: CoreSourceLoc
}


union CoreDecl:
	FunctionDecl(CoreFunction)


record CoreProgram {
	decls: List[CoreDecl]
}


union CoreJsonError:
	CoreMissingField(String, String)
	CoreExpectedObject(String)
	CoreExpectedObjectField(String, String)
	CoreExpectedStringField(String, String)
	CoreExpectedIntField(String, String)
	CoreExpectedBoolField(String, String)
	CoreExpectedArrayField(String, String)
	CoreUnsupportedTag(String, String)


private pure func json_int(value: Int) -> JsonValue:
	JsonNumber(to_float(value))


private pure func option_int_to_json(value: Option[Int]) -> JsonValue:
	match value:
		Some(n):
			json_int(n)
		None:
			JsonNull


private pure func option_string_to_json(value: Option[String]) -> JsonValue:
	match value:
		Some(text):
			JsonString(text)
		None:
			JsonNull


private pure func strings_to_json(items: List[String]) -> JsonValue:
	var values: List[JsonValue] = []

	for item in items:
		values = values.append(JsonString(item))

	JsonVector(values)


private pure func path_field(path: String, field_name: String) -> String:
	if path == "":
		field_name
	else:
		path + "." + field_name


private pure func path_index(path: String, index: Int) -> String:
	path + "[" + index.to_string() + "]"


private pure func object_fields(
	value: JsonValue,
	path: String,
) -> Result[List[(String, JsonValue)], CoreJsonError]:
	match value:
		JsonObject(fields):
			Ok(fields)
		JsonNull:
			Err(CoreExpectedObject(path))
		JsonBool(flag):
			Err(CoreExpectedObject(path))
		JsonNumber(number):
			Err(CoreExpectedObject(path))
		JsonString(text):
			Err(CoreExpectedObject(path))
		JsonVector(items):
			Err(CoreExpectedObject(path))


private pure func required_field(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[JsonValue, CoreJsonError]:
	fields ?= object_fields(value, path)

	match get_field(JsonObject(fields), field_name):
		Some(field):
			Ok(field)
		None:
			Err(CoreMissingField(path, field_name))


private pure func string_field(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[String, CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match as_string(field):
		Some(text):
			Ok(text)
		None:
			Err(CoreExpectedStringField(path, field_name))


private pure func int_field(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[Int, CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match as_number(field):
		Some(number):
			Ok(to_int(number))
		None:
			Err(CoreExpectedIntField(path, field_name))


private pure func bool_field(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[Bool, CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match as_bool(field):
		Some(flag):
			Ok(flag)
		None:
			Err(CoreExpectedBoolField(path, field_name))


private pure func array_field(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[JsonValue], CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match as_array(field):
		Some(items):
			Ok(items)
		None:
			Err(CoreExpectedArrayField(path, field_name))


private pure func object_field(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[JsonValue, CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match field:
		JsonObject(fields):
			Ok(JsonObject(fields))
		JsonNull:
			Err(CoreExpectedObjectField(path, field_name))
		JsonBool(flag):
			Err(CoreExpectedObjectField(path, field_name))
		JsonNumber(number):
			Err(CoreExpectedObjectField(path, field_name))
		JsonString(text):
			Err(CoreExpectedObjectField(path, field_name))
		JsonVector(items):
			Err(CoreExpectedObjectField(path, field_name))


private pure func kind_field(value: JsonValue, path: String) -> Result[String, CoreJsonError]:
	string_field(value, path, KIND_FIELD)


private pure func decode_optional_string(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[Option[String], CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match field:
		JsonNull:
			Ok(None)
		JsonString(text):
			Ok(Some(text))
		JsonBool(flag):
			Err(CoreExpectedStringField(path, field_name))
		JsonNumber(number):
			Err(CoreExpectedStringField(path, field_name))
		JsonVector(items):
			Err(CoreExpectedStringField(path, field_name))
		JsonObject(fields):
			Err(CoreExpectedStringField(path, field_name))


private pure func decode_optional_int(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[Option[Int], CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match field:
		JsonNull:
			Ok(None)
		JsonNumber(number):
			Ok(Some(to_int(number)))
		JsonBool(flag):
			Err(CoreExpectedIntField(path, field_name))
		JsonString(text):
			Err(CoreExpectedIntField(path, field_name))
		JsonVector(items):
			Err(CoreExpectedIntField(path, field_name))
		JsonObject(fields):
			Err(CoreExpectedIntField(path, field_name))


private pure func decode_string_list(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[String], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[String] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match as_string(item):
					Some(text):
						result = result.append(text)
					None:
						error = Some(
							CoreExpectedStringField(
								path_index(
									path_field(path, field_name),
									index,
								),
								"",
							),
						)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func source_loc_to_json(loc: CoreSourceLoc) -> JsonValue:
	match loc:
		SyntheticSourceLoc:
			JsonObject([(KIND_FIELD, JsonString(SYNTHETIC_LOC_TAG))])
		KnownSourceLoc(span):
			JsonObject([
				(KIND_FIELD, JsonString(KNOWN_LOC_TAG)),
				("file", JsonString(span.file)),
				("line", json_int(span.line)),
				("column", json_int(span.column)),
				("end_line", json_int(span.end_line)),
				("end_column", json_int(span.end_column)),
			])


pure func decode_source_loc_json(
	value: JsonValue,
	path: String,
) -> Result[CoreSourceLoc, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == SYNTHETIC_LOC_TAG:
		Ok(SyntheticSourceLoc)
	else if tag == KNOWN_LOC_TAG:
		file ?= string_field(value, path, "file")
		line ?= int_field(value, path, "line")
		column ?= int_field(value, path, "column")
		end_line ?= int_field(value, path, "end_line")
		end_column ?= int_field(value, path, "end_column")
		Ok(KnownSourceLoc({
			file = file,
			line = line,
			column = column,
			end_line = end_line,
			end_column = end_column,
		}))
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_var_to_json(variable: CoreVar) -> JsonValue:
	JsonObject([
		("name", JsonString(variable.name)),
		("uniq", json_int(variable.uniq)),
		("def_id", option_int_to_json(variable.def_id)),
	])


pure func decode_core_var_json(value: JsonValue, path: String) -> Result[CoreVar, CoreJsonError]:
	name ?= string_field(value, path, "name")
	uniq ?= int_field(value, path, "uniq")
	def_id ?= decode_optional_int(value, path, "def_id")

	Ok({
		name = name,
		uniq = uniq,
		def_id = def_id,
	})


private pure func core_type_list_to_json(items: List[CoreType]) -> JsonValue:
	var values: List[JsonValue] = []

	for item in items:
		values = values.append(core_type_to_json(item))

	JsonVector(values)


pure func core_type_to_json(typ: CoreType) -> JsonValue:
	match typ:
		VoidType:
			JsonObject([(KIND_FIELD, JsonString(VOID_TYPE_TAG))])
		NamedType(name, args):
			JsonObject([
				(KIND_FIELD, JsonString(NAMED_TYPE_TAG)),
				("name", JsonString(name)),
				("args", core_type_list_to_json(args)),
			])
		TupleType(items):
			JsonObject([
				(KIND_FIELD, JsonString(TUPLE_TYPE_TAG)),
				("items", core_type_list_to_json(items)),
			])


private pure func decode_core_type_list(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreType], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreType] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_type_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(typ):
						result = result.append(typ)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func decode_core_type_json(value: JsonValue, path: String) -> Result[CoreType, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == VOID_TYPE_TAG:
		Ok(VoidType)
	else if tag == NAMED_TYPE_TAG:
		name ?= string_field(value, path, "name")
		args ?= decode_core_type_list(value, path, "args")
		Ok(NamedType(name, args))
	else if tag == TUPLE_TYPE_TAG:
		items ?= decode_core_type_list(value, path, "items")
		Ok(TupleType(items))
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_literal_to_json(literal: CoreLiteral) -> JsonValue:
	match literal:
		IntLiteral(value):
			JsonObject([
				(KIND_FIELD, JsonString(INT_LITERAL_TAG)),
				("value", json_int(value)),
			])
		BoolLiteral(value):
			JsonObject([
				(KIND_FIELD, JsonString(BOOL_LITERAL_TAG)),
				("value", JsonBool(value)),
			])
		StringLiteral(value):
			JsonObject([
				(KIND_FIELD, JsonString(STRING_LITERAL_TAG)),
				("value", JsonString(value)),
			])


pure func decode_core_literal_json(
	value: JsonValue,
	path: String,
) -> Result[CoreLiteral, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == INT_LITERAL_TAG:
		n ?= int_field(value, path, "value")
		Ok(IntLiteral(n))
	else if tag == BOOL_LITERAL_TAG:
		flag ?= bool_field(value, path, "value")
		Ok(BoolLiteral(flag))
	else if tag == STRING_LITERAL_TAG:
		text ?= string_field(value, path, "value")
		Ok(StringLiteral(text))
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_call_kind_to_json(kind: CoreCallKind) -> JsonValue:
	match kind:
		UserCall(name, def_id):
			JsonObject([
				(KIND_FIELD, JsonString(USER_CALL_TAG)),
				("name", JsonString(name)),
				("def_id", option_int_to_json(def_id)),
			])
		ForeignCall(name):
			JsonObject([
				(KIND_FIELD, JsonString(FOREIGN_CALL_TAG)),
				("name", JsonString(name)),
			])
		BuiltinCall(name):
			JsonObject([
				(KIND_FIELD, JsonString(BUILTIN_CALL_TAG)),
				("name", JsonString(name)),
			])
		IntrinsicCall(name):
			JsonObject([
				(KIND_FIELD, JsonString(INTRINSIC_CALL_TAG)),
				("name", JsonString(name)),
			])
		ClosureCall:
			JsonObject([(KIND_FIELD, JsonString(CLOSURE_CALL_TAG))])


pure func decode_core_call_kind_json(
	value: JsonValue,
	path: String,
) -> Result[CoreCallKind, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == USER_CALL_TAG:
		name ?= string_field(value, path, "name")
		def_id ?= decode_optional_int(value, path, "def_id")
		Ok(UserCall(name, def_id))
	else if tag == FOREIGN_CALL_TAG:
		name ?= string_field(value, path, "name")
		Ok(ForeignCall(name))
	else if tag == BUILTIN_CALL_TAG:
		name ?= string_field(value, path, "name")
		Ok(BuiltinCall(name))
	else if tag == INTRINSIC_CALL_TAG:
		name ?= string_field(value, path, "name")
		Ok(IntrinsicCall(name))
	else if tag == CLOSURE_CALL_TAG:
		Ok(ClosureCall)
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_binary_op_to_string(op: CoreBinaryOp) -> String:
	match op:
		AddOp:
			ADD_OP_TAG
		SubtractOp:
			SUBTRACT_OP_TAG
		MultiplyOp:
			MULTIPLY_OP_TAG
		DivideOp:
			DIVIDE_OP_TAG
		EqualOp:
			EQUAL_OP_TAG
		NotEqualOp:
			NOT_EQUAL_OP_TAG
		LessOp:
			LESS_OP_TAG
		LessEqualOp:
			LESS_EQUAL_OP_TAG
		GreaterOp:
			GREATER_OP_TAG
		GreaterEqualOp:
			GREATER_EQUAL_OP_TAG


pure func parse_core_binary_op(tag: String, path: String) -> Result[CoreBinaryOp, CoreJsonError]:
	if tag == ADD_OP_TAG:
		Ok(AddOp)
	else if tag == SUBTRACT_OP_TAG:
		Ok(SubtractOp)
	else if tag == MULTIPLY_OP_TAG:
		Ok(MultiplyOp)
	else if tag == DIVIDE_OP_TAG:
		Ok(DivideOp)
	else if tag == EQUAL_OP_TAG:
		Ok(EqualOp)
	else if tag == NOT_EQUAL_OP_TAG:
		Ok(NotEqualOp)
	else if tag == LESS_OP_TAG:
		Ok(LessOp)
	else if tag == LESS_EQUAL_OP_TAG:
		Ok(LessEqualOp)
	else if tag == GREATER_OP_TAG:
		Ok(GreaterOp)
	else if tag == GREATER_EQUAL_OP_TAG:
		Ok(GreaterEqualOp)
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_unary_op_to_string(op: CoreUnaryOp) -> String:
	match op:
		NegateOp:
			NEGATE_OP_TAG
		NotOp:
			NOT_OP_TAG


pure func parse_core_unary_op(tag: String, path: String) -> Result[CoreUnaryOp, CoreJsonError]:
	if tag == NEGATE_OP_TAG:
		Ok(NegateOp)
	else if tag == NOT_OP_TAG:
		Ok(NotOp)
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_logical_op_to_string(op: CoreLogicalOp) -> String:
	match op:
		AndOp:
			AND_OP_TAG
		OrOp:
			OR_OP_TAG


pure func parse_core_logical_op(tag: String, path: String) -> Result[CoreLogicalOp, CoreJsonError]:
	if tag == AND_OP_TAG:
		Ok(AndOp)
	else if tag == OR_OP_TAG:
		Ok(OrOp)
	else:
		Err(CoreUnsupportedTag(path, tag))


private pure func core_expr_list_to_json(items: List[CoreExpr]) -> JsonValue:
	var values: List[JsonValue] = []

	for item in items:
		values = values.append(core_expr_to_json(item))

	JsonVector(values)


pure func core_expr_to_json(expr: CoreExpr) -> JsonValue:
	match expr:
		LiteralExpr(literal, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(LITERAL_EXPR_TAG)),
				("literal", core_literal_to_json(literal)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		VarExpr(variable, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(VAR_EXPR_TAG)),
				("var", core_var_to_json(variable)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		VoidExpr(typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(VOID_EXPR_TAG)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		CallExpr(kind, callee, args, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(CALL_EXPR_TAG)),
				("call_kind", core_call_kind_to_json(kind)),
				("callee", core_expr_to_json(callee)),
				("args", core_expr_list_to_json(args)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		BinaryExpr(op, left, right, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(BINARY_EXPR_TAG)),
				("op", JsonString(core_binary_op_to_string(op))),
				("left", core_expr_to_json(left)),
				("right", core_expr_to_json(right)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		UnaryExpr(op, expr_value, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(UNARY_EXPR_TAG)),
				("op", JsonString(core_unary_op_to_string(op))),
				("expr", core_expr_to_json(expr_value)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		LogicalExpr(op, left, right, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(LOGICAL_EXPR_TAG)),
				("op", JsonString(core_logical_op_to_string(op))),
				("left", core_expr_to_json(left)),
				("right", core_expr_to_json(right)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		AssignExpr(variable, rhs, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(ASSIGN_EXPR_TAG)),
				("var", core_var_to_json(variable)),
				("rhs", core_expr_to_json(rhs)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		LetExpr(name, is_mutable, typ, rhs, body):
			JsonObject([
				(KIND_FIELD, JsonString(LET_EXPR_TAG)),
				("name", core_var_to_json(name)),
				("mutable", JsonBool(is_mutable)),
				("type", core_type_to_json(typ)),
				("rhs", core_expr_to_json(rhs)),
				("body", core_expr_to_json(body)),
			])
		SeqExpr(first, second):
			JsonObject([
				(KIND_FIELD, JsonString(SEQ_EXPR_TAG)),
				("first", core_expr_to_json(first)),
				("second", core_expr_to_json(second)),
			])
		IfExpr(cond, then_expr, else_expr, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(IF_EXPR_TAG)),
				("cond", core_expr_to_json(cond)),
				("then", core_expr_to_json(then_expr)),
				("else", core_expr_to_json(else_expr)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])


private pure func decode_core_expr_list(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreExpr], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreExpr] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_expr_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(expr):
						result = result.append(expr)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func decode_core_expr_json(value: JsonValue, path: String) -> Result[CoreExpr, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == LITERAL_EXPR_TAG:
		literal_json ?= object_field(value, path, "literal")
		literal ?= decode_core_literal_json(
			literal_json,
			path_field(path, "literal"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(LiteralExpr(literal, typ, loc))
	else if tag == VAR_EXPR_TAG:
		var_json ?= object_field(value, path, "var")
		variable ?= decode_core_var_json(
			var_json,
			path_field(path, "var"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(VarExpr(variable, typ, loc))
	else if tag == VOID_EXPR_TAG:
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(VoidExpr(typ, loc))
	else if tag == CALL_EXPR_TAG:
		call_kind_json ?= object_field(value, path, "call_kind")
		call_kind ?= decode_core_call_kind_json(
			call_kind_json,
			path_field(path, "call_kind"),
		)
		callee_json ?= object_field(value, path, "callee")
		callee ?= decode_core_expr_json(
			callee_json,
			path_field(path, "callee"),
		)
		args ?= decode_core_expr_list(value, path, "args")
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(CallExpr(call_kind, callee, args, typ, loc))
	else if tag == BINARY_EXPR_TAG:
		op_tag ?= string_field(value, path, "op")
		op ?= parse_core_binary_op(
			op_tag,
			path_field(path, "op"),
		)
		left_json ?= object_field(value, path, "left")
		left ?= decode_core_expr_json(
			left_json,
			path_field(path, "left"),
		)
		right_json ?= object_field(value, path, "right")
		right ?= decode_core_expr_json(
			right_json,
			path_field(path, "right"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(BinaryExpr(op, left, right, typ, loc))
	else if tag == UNARY_EXPR_TAG:
		op_tag ?= string_field(value, path, "op")
		op ?= parse_core_unary_op(
			op_tag,
			path_field(path, "op"),
		)
		expr_json ?= object_field(value, path, "expr")
		expr_value ?= decode_core_expr_json(
			expr_json,
			path_field(path, "expr"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(UnaryExpr(op, expr_value, typ, loc))
	else if tag == LOGICAL_EXPR_TAG:
		op_tag ?= string_field(value, path, "op")
		op ?= parse_core_logical_op(
			op_tag,
			path_field(path, "op"),
		)
		left_json ?= object_field(value, path, "left")
		left ?= decode_core_expr_json(
			left_json,
			path_field(path, "left"),
		)
		right_json ?= object_field(value, path, "right")
		right ?= decode_core_expr_json(
			right_json,
			path_field(path, "right"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(LogicalExpr(op, left, right, typ, loc))
	else if tag == ASSIGN_EXPR_TAG:
		var_json ?= object_field(value, path, "var")
		variable ?= decode_core_var_json(
			var_json,
			path_field(path, "var"),
		)
		rhs_json ?= object_field(value, path, "rhs")
		rhs ?= decode_core_expr_json(
			rhs_json,
			path_field(path, "rhs"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(AssignExpr(variable, rhs, typ, loc))
	else if tag == LET_EXPR_TAG:
		name_json ?= object_field(value, path, "name")
		name ?= decode_core_var_json(
			name_json,
			path_field(path, "name"),
		)
		is_mutable ?= bool_field(value, path, "mutable")
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		rhs_json ?= object_field(value, path, "rhs")
		rhs ?= decode_core_expr_json(
			rhs_json,
			path_field(path, "rhs"),
		)
		body_json ?= object_field(value, path, "body")
		body ?= decode_core_expr_json(
			body_json,
			path_field(path, "body"),
		)
		Ok(LetExpr(name, is_mutable, typ, rhs, body))
	else if tag == SEQ_EXPR_TAG:
		first_json ?= object_field(value, path, "first")
		first ?= decode_core_expr_json(
			first_json,
			path_field(path, "first"),
		)
		second_json ?= object_field(value, path, "second")
		second ?= decode_core_expr_json(
			second_json,
			path_field(path, "second"),
		)
		Ok(SeqExpr(first, second))
	else if tag == IF_EXPR_TAG:
		cond_json ?= object_field(value, path, "cond")
		cond ?= decode_core_expr_json(
			cond_json,
			path_field(path, "cond"),
		)
		then_json ?= object_field(value, path, "then")
		then_expr ?= decode_core_expr_json(
			then_json,
			path_field(path, "then"),
		)
		else_json ?= object_field(value, path, "else")
		else_expr ?= decode_core_expr_json(
			else_json,
			path_field(path, "else"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(IfExpr(cond, then_expr, else_expr, typ, loc))
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_param_to_json(param: CoreParam) -> JsonValue:
	JsonObject([
		("name", core_var_to_json(param.name)),
		("type", core_type_to_json(param.typ)),
		("loc", source_loc_to_json(param.loc)),
	])


pure func decode_core_param_json(
	value: JsonValue,
	path: String,
) -> Result[CoreParam, CoreJsonError]:
	name_json ?= object_field(value, path, "name")
	name ?= decode_core_var_json(
		name_json,
		path_field(path, "name"),
	)
	type_json ?= object_field(value, path, "type")
	typ ?= decode_core_type_json(
		type_json,
		path_field(path, "type"),
	)
	loc_json ?= object_field(value, path, "loc")
	loc ?= decode_source_loc_json(
		loc_json,
		path_field(path, "loc"),
	)

	Ok({
		name = name,
		typ = typ,
		loc = loc,
	})


private pure func core_params_to_json(params: List[CoreParam]) -> JsonValue:
	var values: List[JsonValue] = []

	for param in params:
		values = values.append(core_param_to_json(param))

	JsonVector(values)


private pure func decode_core_params(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreParam], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreParam] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_param_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(param):
						result = result.append(param)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func function_kind_to_string(kind: CoreFunctionKind) -> String:
	match kind:
		UserFunction:
			"user"
		BuiltinFunction:
			"builtin"
		ForeignFunction:
			"foreign"
		ClosureBodyFunction:
			"closure_body"


pure func parse_function_kind(tag: String, path: String) -> Result[CoreFunctionKind, CoreJsonError]:
	match tag:
		"user":
			Ok(UserFunction)
		"builtin":
			Ok(BuiltinFunction)
		"foreign":
			Ok(ForeignFunction)
		"closure_body":
			Ok(ClosureBodyFunction)
		_:
			Err(CoreUnsupportedTag(path_field(path, "function_kind"), tag))


private pure func option_expr_to_json(body: Option[CoreExpr]) -> JsonValue:
	match body:
		Some(expr):
			core_expr_to_json(expr)
		None:
			JsonNull


private pure func decode_optional_expr(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[Option[CoreExpr], CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match field:
		JsonNull:
			Ok(None)
		JsonObject(fields):
			expr ?= decode_core_expr_json(
				JsonObject(fields),
				path_field(path, field_name),
			)
			Ok(Some(expr))
		JsonBool(flag):
			Err(CoreExpectedObjectField(path, field_name))
		JsonNumber(number):
			Err(CoreExpectedObjectField(path, field_name))
		JsonString(text):
			Err(CoreExpectedObjectField(path, field_name))
		JsonVector(items):
			Err(CoreExpectedObjectField(path, field_name))


pure func core_function_to_json(core_func: CoreFunction) -> JsonValue:
	JsonObject([
		(KIND_FIELD, JsonString(FUNCTION_TAG)),
		("name", JsonString(core_func.name)),
		("module", option_string_to_json(core_func.source_module)),
		("type_params", strings_to_json(core_func.type_params)),
		("params", core_params_to_json(core_func.params)),
		("return_type", core_type_to_json(core_func.return_type)),
		("body", option_expr_to_json(core_func.body)),
		("pure", JsonBool(core_func.is_pure)),
		("function_kind", JsonString(function_kind_to_string(core_func.function_kind))),
		("def_id", json_int(core_func.def_id)),
		("loc", source_loc_to_json(core_func.loc)),
	])


pure func decode_core_function_json(
	value: JsonValue,
	path: String,
) -> Result[CoreFunction, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag != FUNCTION_TAG:
		Err(CoreUnsupportedTag(path, tag))
	else:
		name ?= string_field(value, path, "name")
		source_module ?= decode_optional_string(value, path, "module")
		type_params ?= decode_string_list(value, path, "type_params")
		params ?= decode_core_params(value, path, "params")
		return_type_json ?= object_field(value, path, "return_type")
		return_type ?= decode_core_type_json(
			return_type_json,
			path_field(path, "return_type"),
		)
		body ?= decode_optional_expr(value, path, "body")
		is_pure ?= bool_field(value, path, "pure")
		function_kind_tag ?= string_field(value, path, "function_kind")
		function_kind ?= parse_function_kind(function_kind_tag, path)
		def_id ?= int_field(value, path, "def_id")
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)

		Ok({
			name = name,
			source_module = source_module,
			type_params = type_params,
			params = params,
			return_type = return_type,
			body = body,
			is_pure = is_pure,
			function_kind = function_kind,
			def_id = def_id,
			loc = loc,
		})


pure func core_decl_to_json(decl: CoreDecl) -> JsonValue:
	match decl:
		FunctionDecl(core_func):
			core_function_to_json(core_func)


pure func decode_core_decl_json(value: JsonValue, path: String) -> Result[CoreDecl, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == FUNCTION_TAG:
		core_func ?= decode_core_function_json(value, path)
		Ok(FunctionDecl(core_func))
	else:
		Err(CoreUnsupportedTag(path, tag))


private pure func core_decls_to_json(decls: List[CoreDecl]) -> JsonValue:
	var values: List[JsonValue] = []

	for decl in decls:
		values = values.append(core_decl_to_json(decl))

	JsonVector(values)


private pure func decode_core_decls(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreDecl], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreDecl] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_decl_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(decl):
						result = result.append(decl)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func core_program_to_json(program: CoreProgram) -> JsonValue:
	JsonObject([
		(KIND_FIELD, JsonString(PROGRAM_TAG)),
		("decls", core_decls_to_json(program.decls)),
	])


pure func decode_core_program_json(value: JsonValue) -> Result[CoreProgram, CoreJsonError]:
	path: String = "program"
	tag ?= kind_field(value, path)

	if tag != PROGRAM_TAG:
		Err(CoreUnsupportedTag(path, tag))
	else:
		decls ?= decode_core_decls(value, path, "decls")
		Ok({decls = decls})


pure func core_json_error_to_string(error: CoreJsonError) -> String:
	match error:
		CoreMissingField(path, field_name):
			"missing Core JSON field at " + path + ": " + field_name
		CoreExpectedObject(path):
			"Core JSON value at " + path + " must be an object"
		CoreExpectedObjectField(path, field_name):
			"Core JSON field at " + path + " must be an object: " + field_name
		CoreExpectedStringField(path, field_name):
			"Core JSON field at " + path + " must be a string: " + field_name
		CoreExpectedIntField(path, field_name):
			"Core JSON field at " + path + " must be an integer: " + field_name
		CoreExpectedBoolField(path, field_name):
			"Core JSON field at " + path + " must be a boolean: " + field_name
		CoreExpectedArrayField(path, field_name):
			"Core JSON field at " + path + " must be an array: " + field_name
		CoreUnsupportedTag(path, tag):
			"unsupported Core JSON tag at " + path + ": " + tag
