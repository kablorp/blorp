pure func decode_core_resource_cleanup_exit_json(
	value: JsonValue,
	path: String,
) -> Result[CoreResourceCleanupExit, CoreJsonError]:
	cleanups ?= decode_core_expr_list(value, path, "cleanups")
	exit_tag ?= string_field(value, path, "exit")
	exit ?= parse_core_resource_exit(
		exit_tag,
		path_field(path, "exit"),
	)

	Ok({
		cleanups = cleanups,
		exit = exit,
	})


pure func core_literal_match_case_to_json(match_case: CoreLiteralMatchCase) -> JsonValue:
	JsonObject([
		("literal", core_literal_to_json(match_case.literal)),
		("body", core_expr_to_json(match_case.body)),
	])


private pure func core_literal_match_cases_to_json(cases: List[CoreLiteralMatchCase]) -> JsonValue:
	var values: List[JsonValue] = []

	for match_case in cases:
		values = values.append(core_literal_match_case_to_json(match_case))

	JsonVector(values)


pure func core_literal_match_fallback_to_json(fallback: CoreLiteralMatchFallback) -> JsonValue:
	match fallback:
		LiteralMatchFallbackBody(body):
			JsonObject([
				(KIND_FIELD, JsonString(LITERAL_MATCH_FALLBACK_BODY_TAG)),
				("body", core_expr_to_json(body)),
			])
		LiteralMatchFallbackFail:
			JsonObject([(KIND_FIELD, JsonString(LITERAL_MATCH_FALLBACK_FAIL_TAG))])


pure func decode_core_literal_match_case_json(
	value: JsonValue,
	path: String,
) -> Result[CoreLiteralMatchCase, CoreJsonError]:
	literal_json ?= object_field(value, path, "literal")
	literal ?= decode_core_literal_json(
		literal_json,
		path_field(path, "literal"),
	)
	body_json ?= object_field(value, path, "body")
	body ?= decode_core_expr_json(
		body_json,
		path_field(path, "body"),
	)

	Ok({
		literal = literal,
		body = body,
	})


private pure func decode_core_literal_match_cases(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreLiteralMatchCase], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreLiteralMatchCase] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_literal_match_case_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(match_case):
						result = result.append(match_case)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func decode_core_literal_match_fallback_json(
	value: JsonValue,
	path: String,
) -> Result[CoreLiteralMatchFallback, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == LITERAL_MATCH_FALLBACK_BODY_TAG:
		body_json ?= object_field(value, path, "body")
		body ?= decode_core_expr_json(
			body_json,
			path_field(path, "body"),
		)
		Ok(LiteralMatchFallbackBody(body))
	else if tag == LITERAL_MATCH_FALLBACK_FAIL_TAG:
		Ok(LiteralMatchFallbackFail)
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_constructor_match_test_to_json(test: CoreConstructorMatchTest) -> JsonValue:
	match test:
		EnumConstructorTest(c_name):
			JsonObject([
				(KIND_FIELD, JsonString(ENUM_CONSTRUCTOR_TEST_TAG)),
				("c_name", JsonString(c_name)),
			])
		UnionTagConstructorTest(tag_c_name):
			JsonObject([
				(KIND_FIELD, JsonString(UNION_TAG_CONSTRUCTOR_TEST_TAG)),
				("tag_c_name", JsonString(tag_c_name)),
			])
		NullableOptionSomeConstructorTest:
			JsonObject([(KIND_FIELD, JsonString(NULLABLE_OPTION_SOME_CONSTRUCTOR_TEST_TAG))])
		NullableOptionNoneConstructorTest:
			JsonObject([(KIND_FIELD, JsonString(NULLABLE_OPTION_NONE_CONSTRUCTOR_TEST_TAG))])
		StackOptionSomeConstructorTest:
			JsonObject([(KIND_FIELD, JsonString(STACK_OPTION_SOME_CONSTRUCTOR_TEST_TAG))])
		StackOptionNoneConstructorTest:
			JsonObject([(KIND_FIELD, JsonString(STACK_OPTION_NONE_CONSTRUCTOR_TEST_TAG))])


pure func decode_core_constructor_match_test_json(
	value: JsonValue,
	path: String,
) -> Result[CoreConstructorMatchTest, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == ENUM_CONSTRUCTOR_TEST_TAG:
		c_name ?= string_field(value, path, "c_name")
		Ok(EnumConstructorTest(c_name))
	else if tag == UNION_TAG_CONSTRUCTOR_TEST_TAG:
		tag_c_name ?= string_field(value, path, "tag_c_name")
		Ok(UnionTagConstructorTest(tag_c_name))
	else if tag == NULLABLE_OPTION_SOME_CONSTRUCTOR_TEST_TAG:
		Ok(NullableOptionSomeConstructorTest)
	else if tag == NULLABLE_OPTION_NONE_CONSTRUCTOR_TEST_TAG:
		Ok(NullableOptionNoneConstructorTest)
	else if tag == STACK_OPTION_SOME_CONSTRUCTOR_TEST_TAG:
		Ok(StackOptionSomeConstructorTest)
	else if tag == STACK_OPTION_NONE_CONSTRUCTOR_TEST_TAG:
		Ok(StackOptionNoneConstructorTest)
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_accessor_to_json(accessor: CoreAccessor) -> JsonValue:
	match accessor:
		RootAccessor:
			JsonObject([(KIND_FIELD, JsonString(ROOT_ACCESSOR_TAG))])
		VariantFieldAccessor(parent, constructor, field_index):
			JsonObject([
				(KIND_FIELD, JsonString(VARIANT_FIELD_ACCESSOR_TAG)),
				("parent", core_accessor_to_json(parent)),
				("constructor", JsonString(constructor)),
				("field_index", json_int(field_index)),
			])
		NullableOptionPayloadAccessor(parent):
			JsonObject([
				(KIND_FIELD, JsonString(NULLABLE_OPTION_PAYLOAD_ACCESSOR_TAG)),
				("parent", core_accessor_to_json(parent)),
			])
		StackOptionPayloadAccessor(parent):
			JsonObject([
				(KIND_FIELD, JsonString(STACK_OPTION_PAYLOAD_ACCESSOR_TAG)),
				("parent", core_accessor_to_json(parent)),
			])


pure func decode_core_accessor_json(
	value: JsonValue,
	path: String,
) -> Result[CoreAccessor, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == ROOT_ACCESSOR_TAG:
		Ok(RootAccessor)
	else if tag == VARIANT_FIELD_ACCESSOR_TAG:
		parent_json ?= object_field(value, path, "parent")
		parent ?= decode_core_accessor_json(
			parent_json,
			path_field(path, "parent"),
		)
		constructor ?= string_field(value, path, "constructor")
		field_index ?= int_field(value, path, "field_index")
		Ok(VariantFieldAccessor(parent, constructor, field_index))
	else if tag == NULLABLE_OPTION_PAYLOAD_ACCESSOR_TAG:
		parent_json ?= object_field(value, path, "parent")
		parent ?= decode_core_accessor_json(
			parent_json,
			path_field(path, "parent"),
		)
		Ok(NullableOptionPayloadAccessor(parent))
	else if tag == STACK_OPTION_PAYLOAD_ACCESSOR_TAG:
		parent_json ?= object_field(value, path, "parent")
		parent ?= decode_core_accessor_json(
			parent_json,
			path_field(path, "parent"),
		)
		Ok(StackOptionPayloadAccessor(parent))
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_match_binding_mode_to_json(mode: CoreMatchBindingMode) -> JsonValue:
	match mode:
		MatchBorrowBindingMode:
			JsonString(MATCH_BORROW_BINDING_MODE_TAG)
		MatchOwnBindingMode:
			JsonString(MATCH_OWN_BINDING_MODE_TAG)


pure func decode_core_match_binding_mode_json(
	value: JsonValue,
	path: String,
) -> Result[CoreMatchBindingMode, CoreJsonError]:
	match as_string(value):
		Some(tag):
			if tag == MATCH_BORROW_BINDING_MODE_TAG:
				Ok(MatchBorrowBindingMode)
			else if tag == MATCH_OWN_BINDING_MODE_TAG:
				Ok(MatchOwnBindingMode)
			else:
				Err(CoreUnsupportedTag(path, tag))
		None:
			Err(CoreExpectedStringField(path, "mode"))


pure func core_match_binding_to_json(binding: CoreMatchBinding) -> JsonValue:
	JsonObject([
		("variable", core_var_to_json(binding.variable)),
		("type", core_type_to_json(binding.typ)),
		("accessor", core_accessor_to_json(binding.accessor)),
		("mode", core_match_binding_mode_to_json(binding.mode)),
	])


private pure func core_match_bindings_to_json(bindings: List[CoreMatchBinding]) -> JsonValue:
	var values: List[JsonValue] = []

	for binding in bindings:
		values = values.append(core_match_binding_to_json(binding))

	JsonVector(values)


pure func decode_core_match_binding_json(
	value: JsonValue,
	path: String,
) -> Result[CoreMatchBinding, CoreJsonError]:
	variable_json ?= object_field(value, path, "variable")
	variable ?= decode_core_var_json(
		variable_json,
		path_field(path, "variable"),
	)
	type_json ?= object_field(value, path, "type")
	typ ?= decode_core_type_json(
		type_json,
		path_field(path, "type"),
	)
	accessor_json ?= object_field(value, path, "accessor")
	accessor ?= decode_core_accessor_json(
		accessor_json,
		path_field(path, "accessor"),
	)
	mode_json ?= required_field(value, path, "mode")
	mode ?= decode_core_match_binding_mode_json(
		mode_json,
		path_field(path, "mode"),
	)

	Ok({
		variable = variable,
		typ = typ,
		accessor = accessor,
		mode = mode,
	})


private pure func decode_core_match_bindings(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreMatchBinding], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreMatchBinding] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_match_binding_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(binding):
						result = result.append(binding)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func core_constructor_match_case_to_json(match_case: CoreConstructorMatchCase) -> JsonValue:
	JsonObject([
		("constructor", JsonString(match_case.constructor)),
		("test", core_constructor_match_test_to_json(match_case.test)),
		("bindings", core_match_bindings_to_json(match_case.bindings)),
		("body", core_expr_to_json(match_case.body)),
	])


private pure func core_constructor_match_cases_to_json(
	cases: List[CoreConstructorMatchCase],
) -> JsonValue:
	var values: List[JsonValue] = []

	for match_case in cases:
		values = values.append(core_constructor_match_case_to_json(match_case))

	JsonVector(values)


pure func core_constructor_match_fallback_to_json(
	fallback: CoreConstructorMatchFallback,
) -> JsonValue:
	match fallback:
		ConstructorMatchFallbackBody(body):
			JsonObject([
				(KIND_FIELD, JsonString(LITERAL_MATCH_FALLBACK_BODY_TAG)),
				("body", core_expr_to_json(body)),
			])
		ConstructorMatchFallbackFail:
			JsonObject([(KIND_FIELD, JsonString(LITERAL_MATCH_FALLBACK_FAIL_TAG))])


pure func decode_core_constructor_match_case_json(
	value: JsonValue,
	path: String,
) -> Result[CoreConstructorMatchCase, CoreJsonError]:
	constructor ?= string_field(value, path, "constructor")
	test_json ?= object_field(value, path, "test")
	test ?= decode_core_constructor_match_test_json(
		test_json,
		path_field(path, "test"),
	)
	bindings ?= decode_core_match_bindings(value, path, "bindings")
	body_json ?= object_field(value, path, "body")
	body ?= decode_core_expr_json(
		body_json,
		path_field(path, "body"),
	)

	Ok({
		constructor = constructor,
		test = test,
		bindings = bindings,
		body = body,
	})


private pure func decode_core_constructor_match_cases(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreConstructorMatchCase], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreConstructorMatchCase] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_constructor_match_case_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(match_case):
						result = result.append(match_case)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func decode_core_constructor_match_fallback_json(
	value: JsonValue,
	path: String,
) -> Result[CoreConstructorMatchFallback, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == LITERAL_MATCH_FALLBACK_BODY_TAG:
		body_json ?= object_field(value, path, "body")
		body ?= decode_core_expr_json(
			body_json,
			path_field(path, "body"),
		)
		Ok(ConstructorMatchFallbackBody(body))
	else if tag == LITERAL_MATCH_FALLBACK_FAIL_TAG:
		Ok(ConstructorMatchFallbackFail)
	else:
		Err(CoreUnsupportedTag(path, tag))


private pure func core_expr_list_to_json(items: List[CoreExpr]) -> JsonValue:
	var values: List[JsonValue] = []

	for item in items:
		values = values.append(core_expr_to_json(item))

	JsonVector(values)


pure func core_expr_to_json(expr: CoreExpr) -> JsonValue:
	match expr:
		LiteralExpr(literal, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(LITERAL_EXPR_TAG)),
				("literal", core_literal_to_json(literal)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		VarExpr(variable, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(VAR_EXPR_TAG)),
				("var", core_var_to_json(variable)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		VoidExpr(typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(VOID_EXPR_TAG)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		CooperativeCheckpointExpr(typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(COOPERATIVE_CHECKPOINT_EXPR_TAG)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		CallExpr(kind, callee, args, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(CALL_EXPR_TAG)),
				("call_kind", core_call_kind_to_json(kind)),
				("callee", core_expr_to_json(callee)),
				("args", core_expr_list_to_json(args)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		BinaryExpr(op, left, right, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(BINARY_EXPR_TAG)),
				("op", JsonString(core_binary_op_to_string(op))),
				("left", core_expr_to_json(left)),
				("right", core_expr_to_json(right)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		UnaryExpr(op, expr_value, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(UNARY_EXPR_TAG)),
				("op", JsonString(core_unary_op_to_string(op))),
				("expr", core_expr_to_json(expr_value)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		LogicalExpr(op, left, right, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(LOGICAL_EXPR_TAG)),
				("op", JsonString(core_logical_op_to_string(op))),
				("left", core_expr_to_json(left)),
				("right", core_expr_to_json(right)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		AssignExpr(variable, rhs, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(ASSIGN_EXPR_TAG)),
				("var", core_var_to_json(variable)),
				("rhs", core_expr_to_json(rhs)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		CastExpr(expr_value, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(CAST_EXPR_TAG)),
				("expr", core_expr_to_json(expr_value)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		BoxExpr(box, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(BOX_EXPR_TAG)),
				("box", core_box_op_to_json(box)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(UNBOX_EXPR_TAG)),
				("unbox_kind", core_unbox_kind_to_json(unbox_kind)),
				("expr", core_expr_to_json(expr_value)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		FieldExpr(expr_value, field_name, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(FIELD_EXPR_TAG)),
				("expr", core_expr_to_json(expr_value)),
				("field", JsonString(field_name)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		TupleFieldExpr(expr_value, field_index, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(TUPLE_FIELD_EXPR_TAG)),
