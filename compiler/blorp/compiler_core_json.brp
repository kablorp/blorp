		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(ForRangeExpr(binder, start, end_value, body, typ, loc))
	else if tag == RANGE_EXPR_TAG:
		start_json ?= object_field(value, path, "start")
		start ?= decode_core_expr_json(
			start_json,
			path_field(path, "start"),
		)
		end_json ?= object_field(value, path, "end")
		end_value ?= decode_core_expr_json(
			end_json,
			path_field(path, "end"),
		)
		type_json ?= object_field(value, path, "type")
