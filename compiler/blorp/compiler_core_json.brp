-- Typed JSON model for the Core subset that the Blorp compiler backend will
-- consume first.
--
-- This is deliberately not a string template protocol. JSON tags are decoded
-- once at the transfer boundary into Core-specific variants, so emission code
-- can make illegal states unrepresentable as the port expands.
import:
	json:
		JsonValue(JsonBool, JsonNull, JsonNumber, JsonObject, JsonString, JsonVector),
		as_array,
		as_bool,
		as_number,
		as_string,
		get_field,


private KIND_FIELD: String = "kind"

private PROGRAM_TAG: String = "program"

private FUNCTION_TAG: String = "function"

private GLOBAL_TAG: String = "global"

private ENUM_DECL_TAG: String = "enum"

private KNOWN_LOC_TAG: String = "known"

private SYNTHETIC_LOC_TAG: String = "synthetic"

private VOID_TYPE_TAG: String = "void"

private NAMED_TYPE_TAG: String = "named"

private ENUM_TYPE_TAG: String = "enum"

private TUPLE_TYPE_TAG: String = "tuple"

private INT_LITERAL_TAG: String = "int"

private FLOAT_LITERAL_TAG: String = "float"

private BOOL_LITERAL_TAG: String = "bool"

private CHAR_LITERAL_TAG: String = "char"

private STRING_LITERAL_TAG: String = "string"

private USER_CALL_TAG: String = "user"

private FOREIGN_CALL_TAG: String = "foreign"

private BUILTIN_CALL_TAG: String = "builtin"

private INTRINSIC_CALL_TAG: String = "intrinsic"

private CLOSURE_CALL_TAG: String = "closure"

private LITERAL_EXPR_TAG: String = "literal"

private VAR_EXPR_TAG: String = "var"

private VOID_EXPR_TAG: String = "void"

private COOPERATIVE_CHECKPOINT_EXPR_TAG: String = "cooperative_checkpoint"

private CALL_EXPR_TAG: String = "call"

private SEQ_EXPR_TAG: String = "seq"

private IF_EXPR_TAG: String = "if"

private BINARY_EXPR_TAG: String = "binary"

private UNARY_EXPR_TAG: String = "unary"

private LOGICAL_EXPR_TAG: String = "logical"

private ASSIGN_EXPR_TAG: String = "assign"

private CAST_EXPR_TAG: String = "cast"

private LET_EXPR_TAG: String = "let"

private WHILE_EXPR_TAG: String = "while"

private BREAK_EXPR_TAG: String = "break"

private CONTINUE_EXPR_TAG: String = "continue"

private TAILREC_LOOP_EXPR_TAG: String = "tailrec_loop"

private TAILREC_RECUR_EXPR_TAG: String = "tailrec_recur"

private FOR_RANGE_EXPR_TAG: String = "for_range"

private LITERAL_MATCH_EXPR_TAG: String = "literal_match"

private CONSTRUCTOR_MATCH_EXPR_TAG: String = "constructor_match"

private LITERAL_MATCH_FALLBACK_BODY_TAG: String = "body"

private LITERAL_MATCH_FALLBACK_FAIL_TAG: String = "fail"

private ADD_OP_TAG: String = "add"

private SUBTRACT_OP_TAG: String = "subtract"

private MULTIPLY_OP_TAG: String = "multiply"

private DIVIDE_OP_TAG: String = "divide"

private MODULO_OP_TAG: String = "modulo"

private EQUAL_OP_TAG: String = "equal"

private NOT_EQUAL_OP_TAG: String = "not_equal"

private LESS_OP_TAG: String = "less"

private LESS_EQUAL_OP_TAG: String = "less_equal"

private GREATER_OP_TAG: String = "greater"

private GREATER_EQUAL_OP_TAG: String = "greater_equal"

private NEGATE_OP_TAG: String = "negate"

private NOT_OP_TAG: String = "not"

private AND_OP_TAG: String = "and"

private OR_OP_TAG: String = "or"

private RANGE_MAY_RUN_BACKWARD_TAG: String = "may_run_backward"

private RANGE_FORWARD_ONLY_TAG: String = "forward_only"


record CoreSourceSpan {
	file: String,
	line: Int,
	column: Int,
	end_line: Int,
	end_column: Int
}


union CoreSourceLoc:
	KnownSourceLoc(CoreSourceSpan)
	SyntheticSourceLoc


record CoreVar {
	name: String,
	uniq: Int,
	def_id: Option[Int]
}


union CoreType:
	VoidType
	NamedType(String, List[CoreType])
	EnumType(String)
	TupleType(List[CoreType])


union CoreLiteral:
	IntLiteral(Int)
	FloatLiteral(Float)
	BoolLiteral(Bool)
	CharLiteral(Int)
	StringLiteral(String)


union CoreCallKind:
	UserCall(String, Option[Int])
	ForeignCall(String)
	BuiltinCall(String)
	IntrinsicCall(String)
	ClosureCall


enum CoreBinaryOp:
	AddOp
	SubtractOp
	MultiplyOp
	DivideOp
	ModuloOp
	EqualOp
	NotEqualOp
	LessOp
	LessEqualOp
	GreaterOp
	GreaterEqualOp


enum CoreUnaryOp:
	NegateOp
	NotOp


enum CoreLogicalOp:
	AndOp
	OrOp


enum CoreLoopRangeDirection:
	RangeMayRunBackward
	RangeForwardOnly


record CoreLoopBinder {
	variable: CoreVar,
	typ: CoreType,
	range_direction: CoreLoopRangeDirection
}


union CoreExpr:
	LiteralExpr(CoreLiteral, CoreType, CoreSourceLoc)
	VarExpr(CoreVar, CoreType, CoreSourceLoc)
	VoidExpr(CoreType, CoreSourceLoc)
	CooperativeCheckpointExpr(CoreType, CoreSourceLoc)
	CallExpr(CoreCallKind, CoreExpr, List[CoreExpr], CoreType, CoreSourceLoc)
	BinaryExpr(CoreBinaryOp, CoreExpr, CoreExpr, CoreType, CoreSourceLoc)
	UnaryExpr(CoreUnaryOp, CoreExpr, CoreType, CoreSourceLoc)
	LogicalExpr(CoreLogicalOp, CoreExpr, CoreExpr, CoreType, CoreSourceLoc)
	AssignExpr(CoreVar, CoreExpr, CoreType, CoreSourceLoc)
	CastExpr(CoreExpr, CoreType, CoreSourceLoc)
	LetExpr(CoreVar, Bool, CoreType, CoreExpr, CoreExpr)
	SeqExpr(CoreExpr, CoreExpr)
	WhileExpr(CoreExpr, CoreExpr, CoreType, CoreSourceLoc)
	BreakExpr(CoreType, CoreSourceLoc)
	ContinueExpr(CoreType, CoreSourceLoc)
	TailrecLoopExpr(List[CoreParam], CoreType, CoreExpr, CoreSourceLoc)
	TailrecRecurExpr(List[CoreExpr], CoreType, CoreSourceLoc)
	ForRangeExpr(CoreLoopBinder, CoreExpr, CoreExpr, CoreExpr, CoreType, CoreSourceLoc)
	LiteralMatchExpr(CoreExpr, List[CoreLiteralMatchCase], CoreLiteralMatchFallback, CoreType, CoreSourceLoc)
	ConstructorMatchExpr(CoreExpr, List[CoreConstructorMatchCase], CoreConstructorMatchFallback, CoreType, CoreSourceLoc)
	IfExpr(CoreExpr, CoreExpr, CoreExpr, CoreType, CoreSourceLoc)


record CoreLiteralMatchCase {
	literal: CoreLiteral,
	body: CoreExpr
}


union CoreLiteralMatchFallback:
	LiteralMatchFallbackBody(CoreExpr)
	LiteralMatchFallbackFail


record CoreConstructorMatchCase {
	constructor: String,
	constructor_c_name: String,
	body: CoreExpr
}


union CoreConstructorMatchFallback:
	ConstructorMatchFallbackBody(CoreExpr)
	ConstructorMatchFallbackFail


record CoreParam {
	name: CoreVar,
	typ: CoreType,
	loc: CoreSourceLoc
}


enum CoreFunctionKind:
	UserFunction
	BuiltinFunction
	ForeignFunction
	ClosureBodyFunction


record CoreFunction {
	name: String,
	source_module: Option[String],
	type_params: List[String],
	params: List[CoreParam],
	return_type: CoreType,
	body: Option[CoreExpr],
	is_pure: Bool,
	function_kind: CoreFunctionKind,
	def_id: Int,
	loc: CoreSourceLoc
}


record CoreGlobal {
	name: CoreVar,
	typ: CoreType,
	init: CoreExpr,
	is_mutable: Bool,
	is_const: Bool,
	def_id: Int,
	loc: CoreSourceLoc
}


record CoreEnumVariant {
	name: String,
	c_name: String,
	tag: Int,
	def_id: Option[Int]
}


record CoreEnumDecl {
	name: String,
	variants: List[CoreEnumVariant],
	loc: CoreSourceLoc
}


union CoreDecl:
	FunctionDecl(CoreFunction)
	GlobalDecl(CoreGlobal)
	EnumDecl(CoreEnumDecl)


record CoreProgram {
	decls: List[CoreDecl]
}


union CoreJsonError:
	CoreMissingField(String, String)
	CoreExpectedObject(String)
	CoreExpectedObjectField(String, String)
	CoreExpectedStringField(String, String)
	CoreExpectedIntField(String, String)
	CoreExpectedNumberField(String, String)
	CoreExpectedBoolField(String, String)
	CoreExpectedArrayField(String, String)
	CoreUnsupportedTag(String, String)


private pure func json_int(value: Int) -> JsonValue:
	JsonNumber(to_float(value))


private pure func option_int_to_json(value: Option[Int]) -> JsonValue:
	match value:
		Some(n):
			json_int(n)
		None:
			JsonNull


private pure func option_string_to_json(value: Option[String]) -> JsonValue:
	match value:
		Some(text):
			JsonString(text)
		None:
			JsonNull


private pure func strings_to_json(items: List[String]) -> JsonValue:
	var values: List[JsonValue] = []

	for item in items:
		values = values.append(JsonString(item))

	JsonVector(values)


private pure func path_field(path: String, field_name: String) -> String:
	if path == "":
		field_name
	else:
		path + "." + field_name


private pure func path_index(path: String, index: Int) -> String:
	path + "[" + index.to_string() + "]"


private pure func object_fields(
	value: JsonValue,
	path: String,
) -> Result[List[(String, JsonValue)], CoreJsonError]:
	match value:
		JsonObject(fields):
			Ok(fields)
		JsonNull:
			Err(CoreExpectedObject(path))
		JsonBool(flag):
			Err(CoreExpectedObject(path))
		JsonNumber(number):
			Err(CoreExpectedObject(path))
		JsonString(text):
			Err(CoreExpectedObject(path))
		JsonVector(items):
			Err(CoreExpectedObject(path))


private pure func required_field(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[JsonValue, CoreJsonError]:
	fields ?= object_fields(value, path)

	match get_field(JsonObject(fields), field_name):
		Some(field):
			Ok(field)
		None:
			Err(CoreMissingField(path, field_name))


private pure func string_field(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[String, CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match as_string(field):
		Some(text):
			Ok(text)
		None:
			Err(CoreExpectedStringField(path, field_name))


private pure func int_field(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[Int, CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match as_number(field):
		Some(number):
			Ok(to_int(number))
		None:
			Err(CoreExpectedIntField(path, field_name))


private pure func number_field(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[Float, CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match as_number(field):
		Some(number):
			Ok(number)
		None:
			Err(CoreExpectedNumberField(path, field_name))


private pure func bool_field(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[Bool, CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match as_bool(field):
		Some(flag):
			Ok(flag)
		None:
			Err(CoreExpectedBoolField(path, field_name))


private pure func array_field(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[JsonValue], CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match as_array(field):
		Some(items):
			Ok(items)
		None:
			Err(CoreExpectedArrayField(path, field_name))


private pure func object_field(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[JsonValue, CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match field:
		JsonObject(fields):
			Ok(JsonObject(fields))
		JsonNull:
			Err(CoreExpectedObjectField(path, field_name))
		JsonBool(flag):
			Err(CoreExpectedObjectField(path, field_name))
		JsonNumber(number):
			Err(CoreExpectedObjectField(path, field_name))
		JsonString(text):
			Err(CoreExpectedObjectField(path, field_name))
		JsonVector(items):
			Err(CoreExpectedObjectField(path, field_name))


private pure func kind_field(value: JsonValue, path: String) -> Result[String, CoreJsonError]:
	string_field(value, path, KIND_FIELD)


private pure func decode_optional_string(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[Option[String], CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match field:
		JsonNull:
			Ok(None)
		JsonString(text):
			Ok(Some(text))
		JsonBool(flag):
			Err(CoreExpectedStringField(path, field_name))
		JsonNumber(number):
			Err(CoreExpectedStringField(path, field_name))
		JsonVector(items):
			Err(CoreExpectedStringField(path, field_name))
		JsonObject(fields):
			Err(CoreExpectedStringField(path, field_name))


private pure func decode_optional_int(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[Option[Int], CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match field:
		JsonNull:
			Ok(None)
		JsonNumber(number):
			Ok(Some(to_int(number)))
		JsonBool(flag):
			Err(CoreExpectedIntField(path, field_name))
		JsonString(text):
			Err(CoreExpectedIntField(path, field_name))
		JsonVector(items):
			Err(CoreExpectedIntField(path, field_name))
		JsonObject(fields):
			Err(CoreExpectedIntField(path, field_name))


private pure func decode_string_list(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[String], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[String] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match as_string(item):
					Some(text):
						result = result.append(text)
					None:
						error = Some(
							CoreExpectedStringField(
								path_index(
									path_field(path, field_name),
									index,
								),
								"",
							),
						)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func source_loc_to_json(loc: CoreSourceLoc) -> JsonValue:
	match loc:
		SyntheticSourceLoc:
			JsonObject([(KIND_FIELD, JsonString(SYNTHETIC_LOC_TAG))])
		KnownSourceLoc(span):
			JsonObject([
				(KIND_FIELD, JsonString(KNOWN_LOC_TAG)),
				("file", JsonString(span.file)),
				("line", json_int(span.line)),
				("column", json_int(span.column)),
				("end_line", json_int(span.end_line)),
				("end_column", json_int(span.end_column)),
			])


pure func decode_source_loc_json(
	value: JsonValue,
	path: String,
) -> Result[CoreSourceLoc, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == SYNTHETIC_LOC_TAG:
		Ok(SyntheticSourceLoc)
	else if tag == KNOWN_LOC_TAG:
		file ?= string_field(value, path, "file")
		line ?= int_field(value, path, "line")
		column ?= int_field(value, path, "column")
		end_line ?= int_field(value, path, "end_line")
		end_column ?= int_field(value, path, "end_column")
		Ok(KnownSourceLoc({
			file = file,
			line = line,
			column = column,
			end_line = end_line,
			end_column = end_column,
		}))
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_var_to_json(variable: CoreVar) -> JsonValue:
	JsonObject([
		("name", JsonString(variable.name)),
		("uniq", json_int(variable.uniq)),
		("def_id", option_int_to_json(variable.def_id)),
	])


pure func decode_core_var_json(value: JsonValue, path: String) -> Result[CoreVar, CoreJsonError]:
	name ?= string_field(value, path, "name")
	uniq ?= int_field(value, path, "uniq")
	def_id ?= decode_optional_int(value, path, "def_id")

	Ok({
		name = name,
		uniq = uniq,
		def_id = def_id,
	})


private pure func core_type_list_to_json(items: List[CoreType]) -> JsonValue:
	var values: List[JsonValue] = []

	for item in items:
		values = values.append(core_type_to_json(item))

	JsonVector(values)


pure func core_type_to_json(typ: CoreType) -> JsonValue:
	match typ:
		VoidType:
			JsonObject([(KIND_FIELD, JsonString(VOID_TYPE_TAG))])
		NamedType(name, args):
			JsonObject([
				(KIND_FIELD, JsonString(NAMED_TYPE_TAG)),
				("name", JsonString(name)),
				("args", core_type_list_to_json(args)),
			])
		EnumType(name):
			JsonObject([
				(KIND_FIELD, JsonString(ENUM_TYPE_TAG)),
				("name", JsonString(name)),
			])
		TupleType(items):
			JsonObject([
				(KIND_FIELD, JsonString(TUPLE_TYPE_TAG)),
				("items", core_type_list_to_json(items)),
			])


private pure func decode_core_type_list(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreType], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreType] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_type_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(typ):
						result = result.append(typ)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func decode_core_type_json(value: JsonValue, path: String) -> Result[CoreType, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == VOID_TYPE_TAG:
		Ok(VoidType)
	else if tag == NAMED_TYPE_TAG:
		name ?= string_field(value, path, "name")
		args ?= decode_core_type_list(value, path, "args")
		Ok(NamedType(name, args))
	else if tag == ENUM_TYPE_TAG:
		name ?= string_field(value, path, "name")
		Ok(EnumType(name))
	else if tag == TUPLE_TYPE_TAG:
		items ?= decode_core_type_list(value, path, "items")
		Ok(TupleType(items))
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_literal_to_json(literal: CoreLiteral) -> JsonValue:
	match literal:
		IntLiteral(value):
			JsonObject([
				(KIND_FIELD, JsonString(INT_LITERAL_TAG)),
				("value", json_int(value)),
			])
		FloatLiteral(value):
			JsonObject([
				(KIND_FIELD, JsonString(FLOAT_LITERAL_TAG)),
				("value", JsonNumber(value)),
			])
		BoolLiteral(value):
			JsonObject([
				(KIND_FIELD, JsonString(BOOL_LITERAL_TAG)),
				("value", JsonBool(value)),
			])
		CharLiteral(value):
			JsonObject([
				(KIND_FIELD, JsonString(CHAR_LITERAL_TAG)),
				("value", json_int(value)),
			])
		StringLiteral(value):
			JsonObject([
				(KIND_FIELD, JsonString(STRING_LITERAL_TAG)),
				("value", JsonString(value)),
			])


pure func decode_core_literal_json(
	value: JsonValue,
	path: String,
) -> Result[CoreLiteral, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == INT_LITERAL_TAG:
		n ?= int_field(value, path, "value")
		Ok(IntLiteral(n))
	else if tag == FLOAT_LITERAL_TAG:
		number ?= number_field(value, path, "value")
		Ok(FloatLiteral(number))
	else if tag == BOOL_LITERAL_TAG:
		flag ?= bool_field(value, path, "value")
		Ok(BoolLiteral(flag))
	else if tag == CHAR_LITERAL_TAG:
		codepoint ?= int_field(value, path, "value")
		Ok(CharLiteral(codepoint))
	else if tag == STRING_LITERAL_TAG:
		text ?= string_field(value, path, "value")
		Ok(StringLiteral(text))
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_call_kind_to_json(kind: CoreCallKind) -> JsonValue:
	match kind:
		UserCall(name, def_id):
			JsonObject([
				(KIND_FIELD, JsonString(USER_CALL_TAG)),
				("name", JsonString(name)),
				("def_id", option_int_to_json(def_id)),
			])
		ForeignCall(name):
			JsonObject([
				(KIND_FIELD, JsonString(FOREIGN_CALL_TAG)),
				("name", JsonString(name)),
			])
		BuiltinCall(name):
			JsonObject([
				(KIND_FIELD, JsonString(BUILTIN_CALL_TAG)),
				("name", JsonString(name)),
			])
		IntrinsicCall(name):
			JsonObject([
				(KIND_FIELD, JsonString(INTRINSIC_CALL_TAG)),
				("name", JsonString(name)),
			])
		ClosureCall:
			JsonObject([(KIND_FIELD, JsonString(CLOSURE_CALL_TAG))])


pure func decode_core_call_kind_json(
	value: JsonValue,
	path: String,
) -> Result[CoreCallKind, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == USER_CALL_TAG:
		name ?= string_field(value, path, "name")
		def_id ?= decode_optional_int(value, path, "def_id")
		Ok(UserCall(name, def_id))
	else if tag == FOREIGN_CALL_TAG:
		name ?= string_field(value, path, "name")
		Ok(ForeignCall(name))
	else if tag == BUILTIN_CALL_TAG:
		name ?= string_field(value, path, "name")
		Ok(BuiltinCall(name))
	else if tag == INTRINSIC_CALL_TAG:
		name ?= string_field(value, path, "name")
		Ok(IntrinsicCall(name))
	else if tag == CLOSURE_CALL_TAG:
		Ok(ClosureCall)
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_binary_op_to_string(op: CoreBinaryOp) -> String:
	match op:
		AddOp:
			ADD_OP_TAG
		SubtractOp:
			SUBTRACT_OP_TAG
		MultiplyOp:
			MULTIPLY_OP_TAG
		DivideOp:
			DIVIDE_OP_TAG
		ModuloOp:
			MODULO_OP_TAG
		EqualOp:
			EQUAL_OP_TAG
		NotEqualOp:
			NOT_EQUAL_OP_TAG
		LessOp:
			LESS_OP_TAG
		LessEqualOp:
			LESS_EQUAL_OP_TAG
		GreaterOp:
			GREATER_OP_TAG
		GreaterEqualOp:
			GREATER_EQUAL_OP_TAG


pure func parse_core_binary_op(tag: String, path: String) -> Result[CoreBinaryOp, CoreJsonError]:
	if tag == ADD_OP_TAG:
		Ok(AddOp)
	else if tag == SUBTRACT_OP_TAG:
		Ok(SubtractOp)
	else if tag == MULTIPLY_OP_TAG:
		Ok(MultiplyOp)
	else if tag == DIVIDE_OP_TAG:
		Ok(DivideOp)
	else if tag == MODULO_OP_TAG:
		Ok(ModuloOp)
	else if tag == EQUAL_OP_TAG:
		Ok(EqualOp)
	else if tag == NOT_EQUAL_OP_TAG:
		Ok(NotEqualOp)
	else if tag == LESS_OP_TAG:
		Ok(LessOp)
	else if tag == LESS_EQUAL_OP_TAG:
		Ok(LessEqualOp)
	else if tag == GREATER_OP_TAG:
		Ok(GreaterOp)
	else if tag == GREATER_EQUAL_OP_TAG:
		Ok(GreaterEqualOp)
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_unary_op_to_string(op: CoreUnaryOp) -> String:
	match op:
		NegateOp:
			NEGATE_OP_TAG
		NotOp:
			NOT_OP_TAG


pure func parse_core_unary_op(tag: String, path: String) -> Result[CoreUnaryOp, CoreJsonError]:
	if tag == NEGATE_OP_TAG:
		Ok(NegateOp)
	else if tag == NOT_OP_TAG:
		Ok(NotOp)
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_logical_op_to_string(op: CoreLogicalOp) -> String:
	match op:
		AndOp:
			AND_OP_TAG
		OrOp:
			OR_OP_TAG


pure func parse_core_logical_op(tag: String, path: String) -> Result[CoreLogicalOp, CoreJsonError]:
	if tag == AND_OP_TAG:
		Ok(AndOp)
	else if tag == OR_OP_TAG:
		Ok(OrOp)
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_loop_range_direction_to_string(direction: CoreLoopRangeDirection) -> String:
	match direction:
		RangeMayRunBackward:
			RANGE_MAY_RUN_BACKWARD_TAG
		RangeForwardOnly:
			RANGE_FORWARD_ONLY_TAG


pure func parse_core_loop_range_direction(
	tag: String,
	path: String,
) -> Result[CoreLoopRangeDirection, CoreJsonError]:
	if tag == RANGE_MAY_RUN_BACKWARD_TAG:
		Ok(RangeMayRunBackward)
	else if tag == RANGE_FORWARD_ONLY_TAG:
		Ok(RangeForwardOnly)
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_loop_binder_to_json(binder: CoreLoopBinder) -> JsonValue:
	JsonObject([
		("var", core_var_to_json(binder.variable)),
		("type", core_type_to_json(binder.typ)),
		(
			"range_direction",
			JsonString(core_loop_range_direction_to_string(binder.range_direction)),
		),
	])


pure func decode_core_loop_binder_json(
	value: JsonValue,
	path: String,
) -> Result[CoreLoopBinder, CoreJsonError]:
	var_json ?= object_field(value, path, "var")
	variable ?= decode_core_var_json(
		var_json,
		path_field(path, "var"),
	)
	type_json ?= object_field(value, path, "type")
	typ ?= decode_core_type_json(
		type_json,
		path_field(path, "type"),
	)
	range_direction_tag ?= string_field(value, path, "range_direction")
	range_direction ?= parse_core_loop_range_direction(
		range_direction_tag,
		path_field(path, "range_direction"),
	)

	Ok({
		variable = variable,
		typ = typ,
		range_direction = range_direction,
	})


pure func core_literal_match_case_to_json(match_case: CoreLiteralMatchCase) -> JsonValue:
	JsonObject([
		("literal", core_literal_to_json(match_case.literal)),
		("body", core_expr_to_json(match_case.body)),
	])


private pure func core_literal_match_cases_to_json(cases: List[CoreLiteralMatchCase]) -> JsonValue:
	var values: List[JsonValue] = []

	for match_case in cases:
		values = values.append(core_literal_match_case_to_json(match_case))

	JsonVector(values)


pure func core_literal_match_fallback_to_json(fallback: CoreLiteralMatchFallback) -> JsonValue:
	match fallback:
		LiteralMatchFallbackBody(body):
			JsonObject([
				(KIND_FIELD, JsonString(LITERAL_MATCH_FALLBACK_BODY_TAG)),
				("body", core_expr_to_json(body)),
			])
		LiteralMatchFallbackFail:
			JsonObject([(KIND_FIELD, JsonString(LITERAL_MATCH_FALLBACK_FAIL_TAG))])


pure func decode_core_literal_match_case_json(
	value: JsonValue,
	path: String,
) -> Result[CoreLiteralMatchCase, CoreJsonError]:
	literal_json ?= object_field(value, path, "literal")
	literal ?= decode_core_literal_json(
		literal_json,
		path_field(path, "literal"),
	)
	body_json ?= object_field(value, path, "body")
	body ?= decode_core_expr_json(
		body_json,
		path_field(path, "body"),
	)

	Ok({
		literal = literal,
		body = body,
	})


private pure func decode_core_literal_match_cases(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreLiteralMatchCase], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreLiteralMatchCase] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_literal_match_case_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(match_case):
						result = result.append(match_case)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func decode_core_literal_match_fallback_json(
	value: JsonValue,
	path: String,
) -> Result[CoreLiteralMatchFallback, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == LITERAL_MATCH_FALLBACK_BODY_TAG:
		body_json ?= object_field(value, path, "body")
		body ?= decode_core_expr_json(
			body_json,
			path_field(path, "body"),
		)
		Ok(LiteralMatchFallbackBody(body))
	else if tag == LITERAL_MATCH_FALLBACK_FAIL_TAG:
		Ok(LiteralMatchFallbackFail)
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_constructor_match_case_to_json(match_case: CoreConstructorMatchCase) -> JsonValue:
	JsonObject([
		("constructor", JsonString(match_case.constructor)),
		("constructor_c_name", JsonString(match_case.constructor_c_name)),
		("body", core_expr_to_json(match_case.body)),
	])


private pure func core_constructor_match_cases_to_json(
	cases: List[CoreConstructorMatchCase],
) -> JsonValue:
	var values: List[JsonValue] = []

	for match_case in cases:
		values = values.append(core_constructor_match_case_to_json(match_case))

	JsonVector(values)


pure func core_constructor_match_fallback_to_json(
	fallback: CoreConstructorMatchFallback,
) -> JsonValue:
	match fallback:
		ConstructorMatchFallbackBody(body):
			JsonObject([
				(KIND_FIELD, JsonString(LITERAL_MATCH_FALLBACK_BODY_TAG)),
				("body", core_expr_to_json(body)),
			])
		ConstructorMatchFallbackFail:
			JsonObject([(KIND_FIELD, JsonString(LITERAL_MATCH_FALLBACK_FAIL_TAG))])


pure func decode_core_constructor_match_case_json(
	value: JsonValue,
	path: String,
) -> Result[CoreConstructorMatchCase, CoreJsonError]:
	constructor ?= string_field(value, path, "constructor")
	constructor_c_name ?= string_field(value, path, "constructor_c_name")
	body_json ?= object_field(value, path, "body")
	body ?= decode_core_expr_json(
		body_json,
		path_field(path, "body"),
	)

	Ok({
		constructor = constructor,
		constructor_c_name = constructor_c_name,
		body = body,
	})


private pure func decode_core_constructor_match_cases(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreConstructorMatchCase], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreConstructorMatchCase] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_constructor_match_case_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(match_case):
						result = result.append(match_case)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func decode_core_constructor_match_fallback_json(
	value: JsonValue,
	path: String,
) -> Result[CoreConstructorMatchFallback, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == LITERAL_MATCH_FALLBACK_BODY_TAG:
		body_json ?= object_field(value, path, "body")
		body ?= decode_core_expr_json(
			body_json,
			path_field(path, "body"),
		)
		Ok(ConstructorMatchFallbackBody(body))
	else if tag == LITERAL_MATCH_FALLBACK_FAIL_TAG:
		Ok(ConstructorMatchFallbackFail)
	else:
		Err(CoreUnsupportedTag(path, tag))


private pure func core_expr_list_to_json(items: List[CoreExpr]) -> JsonValue:
	var values: List[JsonValue] = []

	for item in items:
		values = values.append(core_expr_to_json(item))

	JsonVector(values)


pure func core_expr_to_json(expr: CoreExpr) -> JsonValue:
	match expr:
		LiteralExpr(literal, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(LITERAL_EXPR_TAG)),
				("literal", core_literal_to_json(literal)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		VarExpr(variable, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(VAR_EXPR_TAG)),
				("var", core_var_to_json(variable)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		VoidExpr(typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(VOID_EXPR_TAG)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		CooperativeCheckpointExpr(typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(COOPERATIVE_CHECKPOINT_EXPR_TAG)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		CallExpr(kind, callee, args, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(CALL_EXPR_TAG)),
				("call_kind", core_call_kind_to_json(kind)),
				("callee", core_expr_to_json(callee)),
				("args", core_expr_list_to_json(args)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		BinaryExpr(op, left, right, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(BINARY_EXPR_TAG)),
				("op", JsonString(core_binary_op_to_string(op))),
				("left", core_expr_to_json(left)),
				("right", core_expr_to_json(right)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		UnaryExpr(op, expr_value, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(UNARY_EXPR_TAG)),
				("op", JsonString(core_unary_op_to_string(op))),
				("expr", core_expr_to_json(expr_value)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		LogicalExpr(op, left, right, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(LOGICAL_EXPR_TAG)),
				("op", JsonString(core_logical_op_to_string(op))),
				("left", core_expr_to_json(left)),
				("right", core_expr_to_json(right)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		AssignExpr(variable, rhs, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(ASSIGN_EXPR_TAG)),
				("var", core_var_to_json(variable)),
				("rhs", core_expr_to_json(rhs)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		CastExpr(expr_value, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(CAST_EXPR_TAG)),
				("expr", core_expr_to_json(expr_value)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		LetExpr(name, is_mutable, typ, rhs, body):
			JsonObject([
				(KIND_FIELD, JsonString(LET_EXPR_TAG)),
				("name", core_var_to_json(name)),
				("mutable", JsonBool(is_mutable)),
				("type", core_type_to_json(typ)),
				("rhs", core_expr_to_json(rhs)),
				("body", core_expr_to_json(body)),
			])
		SeqExpr(first, second):
			JsonObject([
				(KIND_FIELD, JsonString(SEQ_EXPR_TAG)),
				("first", core_expr_to_json(first)),
				("second", core_expr_to_json(second)),
			])
		WhileExpr(cond, body, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(WHILE_EXPR_TAG)),
				("cond", core_expr_to_json(cond)),
				("body", core_expr_to_json(body)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		BreakExpr(typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(BREAK_EXPR_TAG)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		ContinueExpr(typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(CONTINUE_EXPR_TAG)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		TailrecLoopExpr(params, return_type, body, loc):
			JsonObject([
				(KIND_FIELD, JsonString(TAILREC_LOOP_EXPR_TAG)),
				("params", core_params_to_json(params)),
				("return_type", core_type_to_json(return_type)),
				("body", core_expr_to_json(body)),
				("loc", source_loc_to_json(loc)),
			])
		TailrecRecurExpr(args, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(TAILREC_RECUR_EXPR_TAG)),
				("args", core_expr_list_to_json(args)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(FOR_RANGE_EXPR_TAG)),
				("binder", core_loop_binder_to_json(binder)),
				("start", core_expr_to_json(start)),
				("end", core_expr_to_json(end_value)),
				("body", core_expr_to_json(body)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(LITERAL_MATCH_EXPR_TAG)),
				("scrutinee", core_expr_to_json(scrutinee)),
				("cases", core_literal_match_cases_to_json(cases)),
				("fallback", core_literal_match_fallback_to_json(fallback)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		ConstructorMatchExpr(scrutinee, cases, fallback, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(CONSTRUCTOR_MATCH_EXPR_TAG)),
				("scrutinee", core_expr_to_json(scrutinee)),
				("cases", core_constructor_match_cases_to_json(cases)),
				("fallback", core_constructor_match_fallback_to_json(fallback)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		IfExpr(cond, then_expr, else_expr, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(IF_EXPR_TAG)),
				("cond", core_expr_to_json(cond)),
				("then", core_expr_to_json(then_expr)),
				("else", core_expr_to_json(else_expr)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])


private pure func decode_core_expr_list(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreExpr], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreExpr] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_expr_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(expr):
						result = result.append(expr)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func decode_core_expr_json(value: JsonValue, path: String) -> Result[CoreExpr, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == LITERAL_EXPR_TAG:
		literal_json ?= object_field(value, path, "literal")
		literal ?= decode_core_literal_json(
			literal_json,
			path_field(path, "literal"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(LiteralExpr(literal, typ, loc))
	else if tag == VAR_EXPR_TAG:
		var_json ?= object_field(value, path, "var")
		variable ?= decode_core_var_json(
			var_json,
			path_field(path, "var"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(VarExpr(variable, typ, loc))
	else if tag == VOID_EXPR_TAG:
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(VoidExpr(typ, loc))
	else if tag == COOPERATIVE_CHECKPOINT_EXPR_TAG:
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(CooperativeCheckpointExpr(typ, loc))
	else if tag == CALL_EXPR_TAG:
		call_kind_json ?= object_field(value, path, "call_kind")
		call_kind ?= decode_core_call_kind_json(
			call_kind_json,
			path_field(path, "call_kind"),
		)
		callee_json ?= object_field(value, path, "callee")
		callee ?= decode_core_expr_json(
			callee_json,
			path_field(path, "callee"),
		)
		args ?= decode_core_expr_list(value, path, "args")
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(CallExpr(call_kind, callee, args, typ, loc))
	else if tag == BINARY_EXPR_TAG:
		op_tag ?= string_field(value, path, "op")
		op ?= parse_core_binary_op(
			op_tag,
			path_field(path, "op"),
		)
		left_json ?= object_field(value, path, "left")
		left ?= decode_core_expr_json(
			left_json,
			path_field(path, "left"),
		)
		right_json ?= object_field(value, path, "right")
		right ?= decode_core_expr_json(
			right_json,
			path_field(path, "right"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(BinaryExpr(op, left, right, typ, loc))
	else if tag == UNARY_EXPR_TAG:
		op_tag ?= string_field(value, path, "op")
		op ?= parse_core_unary_op(
			op_tag,
			path_field(path, "op"),
		)
		expr_json ?= object_field(value, path, "expr")
		expr_value ?= decode_core_expr_json(
			expr_json,
			path_field(path, "expr"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(UnaryExpr(op, expr_value, typ, loc))
	else if tag == LOGICAL_EXPR_TAG:
		op_tag ?= string_field(value, path, "op")
		op ?= parse_core_logical_op(
			op_tag,
			path_field(path, "op"),
		)
		left_json ?= object_field(value, path, "left")
		left ?= decode_core_expr_json(
			left_json,
			path_field(path, "left"),
		)
		right_json ?= object_field(value, path, "right")
		right ?= decode_core_expr_json(
			right_json,
			path_field(path, "right"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(LogicalExpr(op, left, right, typ, loc))
	else if tag == ASSIGN_EXPR_TAG:
		var_json ?= object_field(value, path, "var")
		variable ?= decode_core_var_json(
			var_json,
			path_field(path, "var"),
		)
		rhs_json ?= object_field(value, path, "rhs")
		rhs ?= decode_core_expr_json(
			rhs_json,
			path_field(path, "rhs"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(AssignExpr(variable, rhs, typ, loc))
	else if tag == CAST_EXPR_TAG:
		expr_json ?= object_field(value, path, "expr")
		expr_value ?= decode_core_expr_json(
			expr_json,
			path_field(path, "expr"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(CastExpr(expr_value, typ, loc))
	else if tag == LET_EXPR_TAG:
		name_json ?= object_field(value, path, "name")
		name ?= decode_core_var_json(
			name_json,
			path_field(path, "name"),
		)
		is_mutable ?= bool_field(value, path, "mutable")
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		rhs_json ?= object_field(value, path, "rhs")
		rhs ?= decode_core_expr_json(
			rhs_json,
			path_field(path, "rhs"),
		)
		body_json ?= object_field(value, path, "body")
		body ?= decode_core_expr_json(
			body_json,
			path_field(path, "body"),
		)
		Ok(LetExpr(name, is_mutable, typ, rhs, body))
	else if tag == SEQ_EXPR_TAG:
		first_json ?= object_field(value, path, "first")
		first ?= decode_core_expr_json(
			first_json,
			path_field(path, "first"),
		)
		second_json ?= object_field(value, path, "second")
		second ?= decode_core_expr_json(
			second_json,
			path_field(path, "second"),
		)
		Ok(SeqExpr(first, second))
	else if tag == WHILE_EXPR_TAG:
		cond_json ?= object_field(value, path, "cond")
		cond ?= decode_core_expr_json(
			cond_json,
			path_field(path, "cond"),
		)
		body_json ?= object_field(value, path, "body")
		body ?= decode_core_expr_json(
			body_json,
			path_field(path, "body"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(WhileExpr(cond, body, typ, loc))
	else if tag == BREAK_EXPR_TAG:
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(BreakExpr(typ, loc))
	else if tag == CONTINUE_EXPR_TAG:
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(ContinueExpr(typ, loc))
	else if tag == TAILREC_LOOP_EXPR_TAG:
		params ?= decode_core_params(value, path, "params")
		return_type_json ?= object_field(value, path, "return_type")
		return_type ?= decode_core_type_json(
			return_type_json,
			path_field(path, "return_type"),
		)
		body_json ?= object_field(value, path, "body")
		body ?= decode_core_expr_json(
			body_json,
			path_field(path, "body"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(TailrecLoopExpr(params, return_type, body, loc))
	else if tag == TAILREC_RECUR_EXPR_TAG:
		args ?= decode_core_expr_list(value, path, "args")
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(TailrecRecurExpr(args, typ, loc))
	else if tag == FOR_RANGE_EXPR_TAG:
		binder_json ?= object_field(value, path, "binder")
		binder ?= decode_core_loop_binder_json(
			binder_json,
			path_field(path, "binder"),
		)
		start_json ?= object_field(value, path, "start")
		start ?= decode_core_expr_json(
			start_json,
			path_field(path, "start"),
		)
		end_json ?= object_field(value, path, "end")
		end_value ?= decode_core_expr_json(
			end_json,
			path_field(path, "end"),
		)
		body_json ?= object_field(value, path, "body")
		body ?= decode_core_expr_json(
			body_json,
			path_field(path, "body"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(ForRangeExpr(binder, start, end_value, body, typ, loc))
	else if tag == LITERAL_MATCH_EXPR_TAG:
		scrutinee_json ?= object_field(value, path, "scrutinee")
		scrutinee ?= decode_core_expr_json(
			scrutinee_json,
			path_field(path, "scrutinee"),
		)
		cases ?= decode_core_literal_match_cases(value, path, "cases")
		fallback_json ?= object_field(value, path, "fallback")
		fallback ?= decode_core_literal_match_fallback_json(
			fallback_json,
			path_field(path, "fallback"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(LiteralMatchExpr(scrutinee, cases, fallback, typ, loc))
	else if tag == CONSTRUCTOR_MATCH_EXPR_TAG:
		scrutinee_json ?= object_field(value, path, "scrutinee")
		scrutinee ?= decode_core_expr_json(
			scrutinee_json,
			path_field(path, "scrutinee"),
		)
		cases ?= decode_core_constructor_match_cases(value, path, "cases")
		fallback_json ?= object_field(value, path, "fallback")
		fallback ?= decode_core_constructor_match_fallback_json(
			fallback_json,
			path_field(path, "fallback"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(ConstructorMatchExpr(scrutinee, cases, fallback, typ, loc))
	else if tag == IF_EXPR_TAG:
		cond_json ?= object_field(value, path, "cond")
		cond ?= decode_core_expr_json(
			cond_json,
			path_field(path, "cond"),
		)
		then_json ?= object_field(value, path, "then")
		then_expr ?= decode_core_expr_json(
			then_json,
			path_field(path, "then"),
		)
		else_json ?= object_field(value, path, "else")
		else_expr ?= decode_core_expr_json(
			else_json,
			path_field(path, "else"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(IfExpr(cond, then_expr, else_expr, typ, loc))
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_param_to_json(param: CoreParam) -> JsonValue:
	JsonObject([
		("name", core_var_to_json(param.name)),
		("type", core_type_to_json(param.typ)),
		("loc", source_loc_to_json(param.loc)),
	])


pure func decode_core_param_json(
	value: JsonValue,
	path: String,
) -> Result[CoreParam, CoreJsonError]:
	name_json ?= object_field(value, path, "name")
	name ?= decode_core_var_json(
		name_json,
		path_field(path, "name"),
	)
	type_json ?= object_field(value, path, "type")
	typ ?= decode_core_type_json(
		type_json,
		path_field(path, "type"),
	)
	loc_json ?= object_field(value, path, "loc")
	loc ?= decode_source_loc_json(
		loc_json,
		path_field(path, "loc"),
	)

	Ok({
		name = name,
		typ = typ,
		loc = loc,
	})


private pure func core_params_to_json(params: List[CoreParam]) -> JsonValue:
	var values: List[JsonValue] = []

	for param in params:
		values = values.append(core_param_to_json(param))

	JsonVector(values)


private pure func decode_core_params(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreParam], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreParam] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_param_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(param):
						result = result.append(param)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func function_kind_to_string(kind: CoreFunctionKind) -> String:
	match kind:
		UserFunction:
			"user"
		BuiltinFunction:
			"builtin"
		ForeignFunction:
			"foreign"
		ClosureBodyFunction:
			"closure_body"


pure func parse_function_kind(tag: String, path: String) -> Result[CoreFunctionKind, CoreJsonError]:
	match tag:
		"user":
			Ok(UserFunction)
		"builtin":
			Ok(BuiltinFunction)
		"foreign":
			Ok(ForeignFunction)
		"closure_body":
			Ok(ClosureBodyFunction)
		_:
			Err(CoreUnsupportedTag(path_field(path, "function_kind"), tag))


private pure func option_expr_to_json(body: Option[CoreExpr]) -> JsonValue:
	match body:
		Some(expr):
			core_expr_to_json(expr)
		None:
			JsonNull


private pure func decode_optional_expr(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[Option[CoreExpr], CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match field:
		JsonNull:
			Ok(None)
		JsonObject(fields):
			expr ?= decode_core_expr_json(
				JsonObject(fields),
				path_field(path, field_name),
			)
			Ok(Some(expr))
		JsonBool(flag):
			Err(CoreExpectedObjectField(path, field_name))
		JsonNumber(number):
			Err(CoreExpectedObjectField(path, field_name))
		JsonString(text):
			Err(CoreExpectedObjectField(path, field_name))
		JsonVector(items):
			Err(CoreExpectedObjectField(path, field_name))


pure func core_function_to_json(core_func: CoreFunction) -> JsonValue:
	JsonObject([
		(KIND_FIELD, JsonString(FUNCTION_TAG)),
		("name", JsonString(core_func.name)),
		("module", option_string_to_json(core_func.source_module)),
		("type_params", strings_to_json(core_func.type_params)),
		("params", core_params_to_json(core_func.params)),
		("return_type", core_type_to_json(core_func.return_type)),
		("body", option_expr_to_json(core_func.body)),
		("pure", JsonBool(core_func.is_pure)),
		("function_kind", JsonString(function_kind_to_string(core_func.function_kind))),
		("def_id", json_int(core_func.def_id)),
		("loc", source_loc_to_json(core_func.loc)),
	])


pure func decode_core_function_json(
	value: JsonValue,
	path: String,
) -> Result[CoreFunction, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag != FUNCTION_TAG:
		Err(CoreUnsupportedTag(path, tag))
	else:
		name ?= string_field(value, path, "name")
		source_module ?= decode_optional_string(value, path, "module")
		type_params ?= decode_string_list(value, path, "type_params")
		params ?= decode_core_params(value, path, "params")
		return_type_json ?= object_field(value, path, "return_type")
		return_type ?= decode_core_type_json(
			return_type_json,
			path_field(path, "return_type"),
		)
		body ?= decode_optional_expr(value, path, "body")
		is_pure ?= bool_field(value, path, "pure")
		function_kind_tag ?= string_field(value, path, "function_kind")
		function_kind ?= parse_function_kind(function_kind_tag, path)
		def_id ?= int_field(value, path, "def_id")
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)

		Ok({
			name = name,
			source_module = source_module,
			type_params = type_params,
			params = params,
			return_type = return_type,
			body = body,
			is_pure = is_pure,
			function_kind = function_kind,
			def_id = def_id,
			loc = loc,
		})


pure func core_global_to_json(global: CoreGlobal) -> JsonValue:
	JsonObject([
		(KIND_FIELD, JsonString(GLOBAL_TAG)),
		("name", core_var_to_json(global.name)),
		("type", core_type_to_json(global.typ)),
		("init", core_expr_to_json(global.init)),
		("mutable", JsonBool(global.is_mutable)),
		("const", JsonBool(global.is_const)),
		("def_id", json_int(global.def_id)),
		("loc", source_loc_to_json(global.loc)),
	])


pure func decode_core_global_json(
	value: JsonValue,
	path: String,
) -> Result[CoreGlobal, CoreJsonError]:
	name_json ?= object_field(value, path, "name")
	name ?= decode_core_var_json(
		name_json,
		path_field(path, "name"),
	)
	type_json ?= object_field(value, path, "type")
	typ ?= decode_core_type_json(
		type_json,
		path_field(path, "type"),
	)
	init_json ?= object_field(value, path, "init")
	init ?= decode_core_expr_json(
		init_json,
		path_field(path, "init"),
	)
	is_mutable ?= bool_field(value, path, "mutable")
	is_const ?= bool_field(value, path, "const")
	def_id ?= int_field(value, path, "def_id")
	loc_json ?= object_field(value, path, "loc")
	loc ?= decode_source_loc_json(
		loc_json,
		path_field(path, "loc"),
	)

	Ok({
		name = name,
		typ = typ,
		init = init,
		is_mutable = is_mutable,
		is_const = is_const,
		def_id = def_id,
		loc = loc,
	})


pure func core_enum_variant_to_json(variant: CoreEnumVariant) -> JsonValue:
	JsonObject([
		("name", JsonString(variant.name)),
		("c_name", JsonString(variant.c_name)),
		("tag", json_int(variant.tag)),
		("def_id", option_int_to_json(variant.def_id)),
	])


private pure func core_enum_variants_to_json(variants: List[CoreEnumVariant]) -> JsonValue:
	var values: List[JsonValue] = []

	for variant in variants:
		values = values.append(core_enum_variant_to_json(variant))

	JsonVector(values)


pure func decode_core_enum_variant_json(
	value: JsonValue,
	path: String,
) -> Result[CoreEnumVariant, CoreJsonError]:
	name ?= string_field(value, path, "name")
	c_name ?= string_field(value, path, "c_name")
	tag ?= int_field(value, path, "tag")
	def_id ?= decode_optional_int(value, path, "def_id")

	Ok({
		name = name,
		c_name = c_name,
		tag = tag,
		def_id = def_id,
	})


private pure func decode_core_enum_variants(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreEnumVariant], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreEnumVariant] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_enum_variant_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(variant):
						result = result.append(variant)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func core_enum_decl_to_json(enum_decl: CoreEnumDecl) -> JsonValue:
	JsonObject([
		(KIND_FIELD, JsonString(ENUM_DECL_TAG)),
		("name", JsonString(enum_decl.name)),
		("variants", core_enum_variants_to_json(enum_decl.variants)),
		("loc", source_loc_to_json(enum_decl.loc)),
	])


pure func decode_core_enum_decl_json(
	value: JsonValue,
	path: String,
) -> Result[CoreEnumDecl, CoreJsonError]:
	name ?= string_field(value, path, "name")
	variants ?= decode_core_enum_variants(value, path, "variants")
	loc_json ?= object_field(value, path, "loc")
	loc ?= decode_source_loc_json(
		loc_json,
		path_field(path, "loc"),
	)

	Ok({
		name = name,
		variants = variants,
		loc = loc,
	})


pure func core_decl_to_json(decl: CoreDecl) -> JsonValue:
	match decl:
		FunctionDecl(core_func):
			core_function_to_json(core_func)
		GlobalDecl(global):
			core_global_to_json(global)
		EnumDecl(enum_decl):
			core_enum_decl_to_json(enum_decl)


pure func decode_core_decl_json(value: JsonValue, path: String) -> Result[CoreDecl, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == FUNCTION_TAG:
		core_func ?= decode_core_function_json(value, path)
		Ok(FunctionDecl(core_func))
	else if tag == GLOBAL_TAG:
		global ?= decode_core_global_json(value, path)
		Ok(GlobalDecl(global))
	else if tag == ENUM_DECL_TAG:
		enum_decl ?= decode_core_enum_decl_json(value, path)
		Ok(EnumDecl(enum_decl))
	else:
		Err(CoreUnsupportedTag(path, tag))


private pure func core_decls_to_json(decls: List[CoreDecl]) -> JsonValue:
	var values: List[JsonValue] = []

	for decl in decls:
		values = values.append(core_decl_to_json(decl))

	JsonVector(values)


private pure func decode_core_decls(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreDecl], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreDecl] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_decl_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(decl):
						result = result.append(decl)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func core_program_to_json(program: CoreProgram) -> JsonValue:
	JsonObject([
		(KIND_FIELD, JsonString(PROGRAM_TAG)),
		("decls", core_decls_to_json(program.decls)),
	])


pure func decode_core_program_json(value: JsonValue) -> Result[CoreProgram, CoreJsonError]:
	path: String = "program"
	tag ?= kind_field(value, path)

	if tag != PROGRAM_TAG:
		Err(CoreUnsupportedTag(path, tag))
	else:
		decls ?= decode_core_decls(value, path, "decls")
		Ok({decls = decls})


pure func core_json_error_to_string(error: CoreJsonError) -> String:
	match error:
		CoreMissingField(path, field_name):
			"missing Core JSON field at " + path + ": " + field_name
		CoreExpectedObject(path):
			"Core JSON value at " + path + " must be an object"
		CoreExpectedObjectField(path, field_name):
			"Core JSON field at " + path + " must be an object: " + field_name
		CoreExpectedStringField(path, field_name):
			"Core JSON field at " + path + " must be a string: " + field_name
		CoreExpectedIntField(path, field_name):
			"Core JSON field at " + path + " must be an integer: " + field_name
		CoreExpectedNumberField(path, field_name):
			"Core JSON field at " + path + " must be a number: " + field_name
		CoreExpectedBoolField(path, field_name):
			"Core JSON field at " + path + " must be a boolean: " + field_name
		CoreExpectedArrayField(path, field_name):
			"Core JSON field at " + path + " must be an array: " + field_name
		CoreUnsupportedTag(path, tag):
			"unsupported Core JSON tag at " + path + ": " + tag
