	])


pure func decode_core_tuple_construct_json(
	value: JsonValue,
	path: String,
) -> Result[CoreTupleConstruct, CoreJsonError]:
	elements ?= decode_core_tuple_elements(value, path, "elements")
	release_mask ?= int_field(value, path, "release_mask")
	retain_mask ?= int_field(value, path, "retain_mask")

	Ok({
		elements = elements,
		release_mask = release_mask,
		retain_mask = retain_mask,
	})


