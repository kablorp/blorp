				void
			None:
				match decode_core_boxed_storage_value_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(boxed_value):
						result = result.append(boxed_value)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


