		("length", json_int(match_case.length)),
		("branch", core_constructor_length_match_branch_to_json(match_case.branch)),
	])


private pure func core_constructor_length_match_cases_to_json(
	cases: List[CoreConstructorLengthMatchCase],
) -> JsonValue:
	var values: List[JsonValue] = []

	for match_case in cases:
		values = values.append(core_constructor_length_match_case_to_json(match_case))

	JsonVector(values)


pure func core_constructor_length_match_geq_to_json(
	geq_case: CoreConstructorLengthMatchGeq,
) -> JsonValue:
	JsonObject([
		("minimum_length", json_int(geq_case.minimum_length)),
		("branch", core_constructor_length_match_branch_to_json(geq_case.branch)),
	])


pure func optional_constructor_length_match_geq_to_json(
	geq_case: Option[CoreConstructorLengthMatchGeq],
) -> JsonValue:
	match geq_case:
		Some(existing_case):
			core_constructor_length_match_geq_to_json(existing_case)
		None:
			JsonNull


pure func optional_constructor_length_match_branch_to_json(
	branch: Option[CoreConstructorLengthMatchBranch],
) -> JsonValue:
	match branch:
		Some(existing_branch):
			core_constructor_length_match_branch_to_json(existing_branch)
		None:
			JsonNull


pure func core_constructor_length_match_to_json(
	match_expr: CoreConstructorLengthMatch,
) -> JsonValue:
	JsonObject([
		("accessor", core_accessor_to_json(match_expr.accessor)),
		("cases", core_constructor_length_match_cases_to_json(match_expr.cases)),
		("geq", optional_constructor_length_match_geq_to_json(match_expr.geq)),
		("fallback", optional_constructor_length_match_branch_to_json(match_expr.fallback)),
		("type", core_type_to_json(match_expr.result_type)),
		("loc", source_loc_to_json(match_expr.loc)),
	])


pure func core_constructor_match_body_to_json(body: CoreConstructorMatchBody) -> JsonValue:
	match body:
		ConstructorMatchBodyExpr(expr):
			JsonObject([
				(KIND_FIELD, JsonString(CONSTRUCTOR_MATCH_BODY_EXPR_TAG)),
				("expr", core_expr_to_json(expr)),
			])
		ConstructorMatchBodyLiteral(match_expr):
			JsonObject([
				(KIND_FIELD, JsonString(CONSTRUCTOR_MATCH_BODY_LITERAL_TAG)),
				("match", core_constructor_literal_match_to_json(match_expr)),
			])
		ConstructorMatchBodyLength(match_expr):
			JsonObject([
				(KIND_FIELD, JsonString(CONSTRUCTOR_MATCH_BODY_LENGTH_TAG)),
				("match", core_constructor_length_match_to_json(match_expr)),
			])


pure func decode_core_constructor_literal_match_json(
	value: JsonValue,
	path: String,
) -> Result[CoreConstructorLiteralMatch, CoreJsonError]:
	accessor_json ?= object_field(value, path, "accessor")
	accessor ?= decode_core_accessor_json(
		accessor_json,
		path_field(path, "accessor"),
	)
	scrutinee_type_json ?= object_field(value, path, "scrutinee_type")
	scrutinee_type ?= decode_core_type_json(
		scrutinee_type_json,
		path_field(path, "scrutinee_type"),
	)
	cases ?= decode_core_literal_match_cases(value, path, "cases")
	fallback_json ?= object_field(value, path, "fallback")
	fallback ?= decode_core_literal_match_fallback_json(
		fallback_json,
		path_field(path, "fallback"),
	)
	type_json ?= object_field(value, path, "type")
	result_type ?= decode_core_type_json(
		type_json,
		path_field(path, "type"),
	)
	loc_json ?= object_field(value, path, "loc")
	loc ?= decode_source_loc_json(
		loc_json,
		path_field(path, "loc"),
	)

	Ok({
		accessor = accessor,
		scrutinee_type = scrutinee_type,
		cases = cases,
		fallback = fallback,
		result_type = result_type,
		loc = loc,
	})


pure func decode_core_constructor_length_match_branch_json(
	value: JsonValue,
	path: String,
) -> Result[CoreConstructorLengthMatchBranch, CoreJsonError]:
	bindings ?= decode_core_match_bindings(value, path, "bindings")
	body_json ?= object_field(value, path, "body")
	body ?= decode_core_constructor_match_body_json(
		body_json,
		path_field(path, "body"),
	)

	Ok({
		bindings = bindings,
		body = body,
	})


pure func decode_core_constructor_length_match_case_json(
	value: JsonValue,
	path: String,
) -> Result[CoreConstructorLengthMatchCase, CoreJsonError]:
	length ?= int_field(value, path, "length")
	branch_json ?= object_field(value, path, "branch")
	branch ?= decode_core_constructor_length_match_branch_json(
		branch_json,
		path_field(path, "branch"),
	)

	Ok({
		length = length,
		branch = branch,
	})


private pure func decode_core_constructor_length_match_cases(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreConstructorLengthMatchCase], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreConstructorLengthMatchCase] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_constructor_length_match_case_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(match_case):
						result = result.append(match_case)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func decode_core_constructor_length_match_geq_json(
	value: JsonValue,
	path: String,
) -> Result[CoreConstructorLengthMatchGeq, CoreJsonError]:
	minimum_length ?= int_field(value, path, "minimum_length")
	branch_json ?= object_field(value, path, "branch")
	branch ?= decode_core_constructor_length_match_branch_json(
		branch_json,
		path_field(path, "branch"),
	)

	Ok({
		minimum_length = minimum_length,
		branch = branch,
	})


pure func decode_optional_constructor_length_match_geq_json(
	value: JsonValue,
	path: String,
) -> Result[Option[CoreConstructorLengthMatchGeq], CoreJsonError]:
	match value:
		JsonNull:
			Ok(None)
		JsonBool(bool_value):
			Err(CoreExpectedObject(path))
		JsonNumber(number_value):
			Err(CoreExpectedObject(path))
		JsonString(string_value):
			Err(CoreExpectedObject(path))
		JsonVector(items):
			Err(CoreExpectedObject(path))
		JsonObject(fields):
			geq_case ?= decode_core_constructor_length_match_geq_json(value, path)
			Ok(Some(geq_case))


pure func decode_optional_constructor_length_match_branch_json(
	value: JsonValue,
	path: String,
) -> Result[Option[CoreConstructorLengthMatchBranch], CoreJsonError]:
	match value:
		JsonNull:
			Ok(None)
		JsonBool(bool_value):
			Err(CoreExpectedObject(path))
		JsonNumber(number_value):
			Err(CoreExpectedObject(path))
		JsonString(string_value):
			Err(CoreExpectedObject(path))
		JsonVector(items):
			Err(CoreExpectedObject(path))
		JsonObject(fields):
			branch ?= decode_core_constructor_length_match_branch_json(value, path)
			Ok(Some(branch))


pure func decode_core_constructor_length_match_json(
	value: JsonValue,
	path: String,
) -> Result[CoreConstructorLengthMatch, CoreJsonError]:
	accessor_json ?= object_field(value, path, "accessor")
	accessor ?= decode_core_accessor_json(
		accessor_json,
		path_field(path, "accessor"),
	)
	cases ?= decode_core_constructor_length_match_cases(value, path, "cases")
	geq_json ?= required_field(value, path, "geq")
	geq ?= decode_optional_constructor_length_match_geq_json(
		geq_json,
		path_field(path, "geq"),
	)
	fallback_json ?= required_field(value, path, "fallback")
	fallback ?= decode_optional_constructor_length_match_branch_json(
		fallback_json,
		path_field(path, "fallback"),
	)
	type_json ?= object_field(value, path, "type")
	result_type ?= decode_core_type_json(
		type_json,
		path_field(path, "type"),
	)
	loc_json ?= object_field(value, path, "loc")
	loc ?= decode_source_loc_json(
		loc_json,
		path_field(path, "loc"),
	)

	Ok({
		accessor = accessor,
		cases = cases,
		geq = geq,
		fallback = fallback,
		result_type = result_type,
		loc = loc,
	})


pure func decode_core_constructor_match_body_json(
	value: JsonValue,
	path: String,
) -> Result[CoreConstructorMatchBody, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == CONSTRUCTOR_MATCH_BODY_EXPR_TAG:
		expr_json ?= object_field(value, path, "expr")
		expr ?= decode_core_expr_json(
			expr_json,
			path_field(path, "expr"),
		)
		Ok(ConstructorMatchBodyExpr(expr))
	else if tag == CONSTRUCTOR_MATCH_BODY_LITERAL_TAG:
		match_json ?= object_field(value, path, "match")
		match_expr ?= decode_core_constructor_literal_match_json(
			match_json,
			path_field(path, "match"),
		)
		Ok(ConstructorMatchBodyLiteral(match_expr))
	else if tag == CONSTRUCTOR_MATCH_BODY_LENGTH_TAG:
		match_json ?= object_field(value, path, "match")
		match_expr ?= decode_core_constructor_length_match_json(
			match_json,
			path_field(path, "match"),
		)
		Ok(ConstructorMatchBodyLength(match_expr))
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_constructor_match_case_to_json(match_case: CoreConstructorMatchCase) -> JsonValue:
	JsonObject([
		("constructor", JsonString(match_case.constructor)),
		("accessor", core_accessor_to_json(match_case.accessor)),
		("test", core_constructor_match_test_to_json(match_case.test)),
		("bindings", core_match_bindings_to_json(match_case.bindings)),
		("body", core_constructor_match_body_to_json(match_case.body)),
	])


private pure func core_constructor_match_cases_to_json(
	cases: List[CoreConstructorMatchCase],
) -> JsonValue:
	var values: List[JsonValue] = []

	for match_case in cases:
		values = values.append(core_constructor_match_case_to_json(match_case))

	JsonVector(values)


pure func core_constructor_match_fallback_to_json(
	fallback: CoreConstructorMatchFallback,
) -> JsonValue:
	match fallback:
		ConstructorMatchFallbackBody(body):
			JsonObject([
				(KIND_FIELD, JsonString(LITERAL_MATCH_FALLBACK_BODY_TAG)),
				("body", core_expr_to_json(body)),
			])
		ConstructorMatchFallbackBindings(bindings, body):
			JsonObject([
				(KIND_FIELD, JsonString(LITERAL_MATCH_FALLBACK_BINDINGS_TAG)),
				("bindings", core_match_bindings_to_json(bindings)),
				("body", core_expr_to_json(body)),
			])
		ConstructorMatchFallbackFail:
			JsonObject([(KIND_FIELD, JsonString(LITERAL_MATCH_FALLBACK_FAIL_TAG))])


pure func decode_core_constructor_match_case_json(
	value: JsonValue,
	path: String,
) -> Result[CoreConstructorMatchCase, CoreJsonError]:
	constructor ?= string_field(value, path, "constructor")
	accessor_json ?= object_field(value, path, "accessor")
	accessor ?= decode_core_accessor_json(
		accessor_json,
		path_field(path, "accessor"),
	)
	test_json ?= object_field(value, path, "test")
	test ?= decode_core_constructor_match_test_json(
		test_json,
		path_field(path, "test"),
	)
	bindings ?= decode_core_match_bindings(value, path, "bindings")
	body_json ?= object_field(value, path, "body")
	body ?= decode_core_constructor_match_body_json(
		body_json,
		path_field(path, "body"),
	)

	Ok({
		constructor = constructor,
		accessor = accessor,
		test = test,
		bindings = bindings,
		body = body,
	})


private pure func decode_core_constructor_match_cases(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreConstructorMatchCase], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreConstructorMatchCase] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_constructor_match_case_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(match_case):
						result = result.append(match_case)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func decode_core_constructor_match_fallback_json(
	value: JsonValue,
	path: String,
) -> Result[CoreConstructorMatchFallback, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == LITERAL_MATCH_FALLBACK_BODY_TAG:
		body_json ?= object_field(value, path, "body")
		body ?= decode_core_expr_json(
			body_json,
			path_field(path, "body"),
		)
		Ok(ConstructorMatchFallbackBody(body))
	else if tag == LITERAL_MATCH_FALLBACK_BINDINGS_TAG:
		bindings ?= decode_core_match_bindings(value, path, "bindings")
		body_json ?= object_field(value, path, "body")
		body ?= decode_core_expr_json(
			body_json,
			path_field(path, "body"),
		)
		Ok(ConstructorMatchFallbackBindings(bindings, body))
	else if tag == LITERAL_MATCH_FALLBACK_FAIL_TAG:
		Ok(ConstructorMatchFallbackFail)
	else:
		Err(CoreUnsupportedTag(path, tag))


private pure func core_expr_list_to_json(items: List[CoreExpr]) -> JsonValue:
	var values: List[JsonValue] = []

	for item in items:
		values = values.append(core_expr_to_json(item))

	JsonVector(values)


pure func core_expr_to_json(expr: CoreExpr) -> JsonValue:
	match expr:
		LiteralExpr(literal, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(LITERAL_EXPR_TAG)),
				("literal", core_literal_to_json(literal)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		VarExpr(variable, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(VAR_EXPR_TAG)),
				("var", core_var_to_json(variable)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		VoidExpr(typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(VOID_EXPR_TAG)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		CooperativeCheckpointExpr(typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(COOPERATIVE_CHECKPOINT_EXPR_TAG)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		CallExpr(kind, callee, args, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(CALL_EXPR_TAG)),
				("call_kind", core_call_kind_to_json(kind)),
				("callee", core_expr_to_json(callee)),
				("args", core_expr_list_to_json(args)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		BinaryExpr(op, left, right, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(BINARY_EXPR_TAG)),
				("op", JsonString(core_binary_op_to_string(op))),
				("left", core_expr_to_json(left)),
				("right", core_expr_to_json(right)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		UnaryExpr(op, expr_value, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(UNARY_EXPR_TAG)),
				("op", JsonString(core_unary_op_to_string(op))),
				("expr", core_expr_to_json(expr_value)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		LogicalExpr(op, left, right, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(LOGICAL_EXPR_TAG)),
				("op", JsonString(core_logical_op_to_string(op))),
				("left", core_expr_to_json(left)),
				("right", core_expr_to_json(right)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		AssignExpr(variable, rhs, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(ASSIGN_EXPR_TAG)),
				("var", core_var_to_json(variable)),
				("rhs", core_expr_to_json(rhs)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		CastExpr(expr_value, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(CAST_EXPR_TAG)),
				("expr", core_expr_to_json(expr_value)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		BoxExpr(box, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(BOX_EXPR_TAG)),
				("box", core_box_op_to_json(box)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(UNBOX_EXPR_TAG)),
				("unbox_kind", core_unbox_kind_to_json(unbox_kind)),
				("expr", core_expr_to_json(expr_value)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		FieldExpr(expr_value, field_name, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(FIELD_EXPR_TAG)),
				("expr", core_expr_to_json(expr_value)),
				("field", JsonString(field_name)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		TupleFieldExpr(expr_value, field_index, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(TUPLE_FIELD_EXPR_TAG)),
				("expr", core_expr_to_json(expr_value)),
				("index", json_int(field_index)),
				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		TupleExpr(items, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(TUPLE_EXPR_TAG)),
				("items", core_expr_list_to_json(items)),
