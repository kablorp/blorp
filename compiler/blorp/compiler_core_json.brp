				("type", core_type_to_json(typ)),
				("loc", source_loc_to_json(loc)),
			])
		TupleConstructExpr(tuple_construct, typ, loc):
			JsonObject([
				(KIND_FIELD, JsonString(TUPLE_CONSTRUCT_EXPR_TAG)),
