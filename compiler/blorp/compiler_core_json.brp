		)
		Ok(DupExpr(variable, value_type, retain_policy, body, typ, loc))
	else if tag == DROP_EXPR_TAG:
		var_json ?= object_field(value, path, "var")
		variable ?= decode_core_var_json(
			var_json,
			path_field(path, "var"),
		)
		value_type_json ?= object_field(value, path, "value_type")
		value_type ?= decode_core_type_json(
			value_type_json,
			path_field(path, "value_type"),
		)
		release_policy_tag ?= string_field(value, path, "release_policy")
		release_policy ?= parse_core_release_policy(
			release_policy_tag,
			path_field(path, "release_policy"),
		)
		body_json ?= object_field(value, path, "body")
		body ?= decode_core_expr_json(
			body_json,
			path_field(path, "body"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
