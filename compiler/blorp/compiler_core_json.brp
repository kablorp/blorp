pure func core_union_representation_to_json(representation: CoreUnionRepresentation) -> JsonValue:
	match representation:
		GenericUnionRepresentation:
			JsonObject([(KIND_FIELD, JsonString(GENERIC_UNION_REPRESENTATION_TAG))])
		StackOptionRepresentation(info):
			JsonObject([
				(KIND_FIELD, JsonString(STACK_OPTION_UNION_REPRESENTATION_TAG)),
				("option_type", JsonString(info.option_type)),
				("tag", json_int(info.tag)),
				("none_value", JsonString(info.none_value)),
			])


pure func decode_core_union_representation_json(
	value: JsonValue,
	path: String,
) -> Result[CoreUnionRepresentation, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == GENERIC_UNION_REPRESENTATION_TAG:
		Ok(GenericUnionRepresentation)
	else if tag == STACK_OPTION_UNION_REPRESENTATION_TAG:
		option_type ?= string_field(value, path, "option_type")
		tag_value ?= int_field(value, path, "tag")
		none_value ?= string_field(value, path, "none_value")
		Ok(StackOptionRepresentation({
			option_type = option_type,
			tag = tag_value,
			none_value = none_value,
		}))
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_union_construct_to_json(construct: CoreUnionConstruct) -> JsonValue:
	JsonObject([
		("type_name", JsonString(construct.type_name)),
		("constructor_name", JsonString(construct.constructor_name)),
		("constructor_c_name", JsonString(construct.constructor_c_name)),
		("representation", core_union_representation_to_json(construct.representation)),
		("args", core_expr_list_to_json(construct.args)),
	])


pure func decode_core_union_construct_json(
	value: JsonValue,
	path: String,
) -> Result[CoreUnionConstruct, CoreJsonError]:
	type_name ?= string_field(value, path, "type_name")
	constructor_name ?= string_field(value, path, "constructor_name")
	constructor_c_name ?= string_field(value, path, "constructor_c_name")
	representation_json ?= object_field(value, path, "representation")
	representation ?= decode_core_union_representation_json(
		representation_json,
		path_field(path, "representation"),
	)
	args ?= decode_core_expr_list(value, path, "args")

	Ok({
		type_name = type_name,
		constructor_name = constructor_name,
		constructor_c_name = constructor_c_name,
		representation = representation,
		args = args,
	})


pure func core_binary_op_to_string(op: CoreBinaryOp) -> String:
	match op:
		AddOp:
			ADD_OP_TAG
		SubtractOp:
			SUBTRACT_OP_TAG
		MultiplyOp:
			MULTIPLY_OP_TAG
		DivideOp:
			DIVIDE_OP_TAG
		ModuloOp:
			MODULO_OP_TAG
		EqualOp:
			EQUAL_OP_TAG
		NotEqualOp:
			NOT_EQUAL_OP_TAG
		LessOp:
			LESS_OP_TAG
		LessEqualOp:
			LESS_EQUAL_OP_TAG
		GreaterOp:
			GREATER_OP_TAG
		GreaterEqualOp:
			GREATER_EQUAL_OP_TAG


pure func parse_core_binary_op(tag: String, path: String) -> Result[CoreBinaryOp, CoreJsonError]:
	if tag == ADD_OP_TAG:
		Ok(AddOp)
	else if tag == SUBTRACT_OP_TAG:
		Ok(SubtractOp)
	else if tag == MULTIPLY_OP_TAG:
		Ok(MultiplyOp)
	else if tag == DIVIDE_OP_TAG:
		Ok(DivideOp)
	else if tag == MODULO_OP_TAG:
		Ok(ModuloOp)
	else if tag == EQUAL_OP_TAG:
		Ok(EqualOp)
	else if tag == NOT_EQUAL_OP_TAG:
		Ok(NotEqualOp)
	else if tag == LESS_OP_TAG:
		Ok(LessOp)
	else if tag == LESS_EQUAL_OP_TAG:
		Ok(LessEqualOp)
	else if tag == GREATER_OP_TAG:
		Ok(GreaterOp)
	else if tag == GREATER_EQUAL_OP_TAG:
		Ok(GreaterEqualOp)
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_unary_op_to_string(op: CoreUnaryOp) -> String:
	match op:
		NegateOp:
			NEGATE_OP_TAG
		NotOp:
			NOT_OP_TAG


pure func parse_core_unary_op(tag: String, path: String) -> Result[CoreUnaryOp, CoreJsonError]:
	if tag == NEGATE_OP_TAG:
		Ok(NegateOp)
	else if tag == NOT_OP_TAG:
		Ok(NotOp)
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_logical_op_to_string(op: CoreLogicalOp) -> String:
