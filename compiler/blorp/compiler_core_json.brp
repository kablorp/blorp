		StructBox(c_type):
			JsonObject([
				(KIND_FIELD, JsonString(BOX_STRUCT_TAG)),
				("c_type", JsonString(c_type)),
			])


pure func decode_core_box_kind_json(
	value: JsonValue,
	path: String,
) -> Result[CoreBoxKind, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == BOX_PRIM_TAG:
		Ok(PrimBox)
	else if tag == BOX_POINTER_TAG:
		Ok(PointerBox)
	else if tag == BOX_VOID_TAG:
		Ok(VoidBox)
	else if tag == BOX_STRUCT_TAG:
		c_type ?= string_field(value, path, "c_type")
		Ok(StructBox(c_type))
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_boxed_storage_value_to_json(value: CoreBoxedStorageValue) -> JsonValue:
	JsonObject([
		("kind", core_box_kind_to_json(value.kind)),
		("value", core_expr_to_json(value.value)),
		("needs_release", JsonBool(value.needs_release)),
		("transfers_ownership", JsonBool(value.transfers_ownership)),
	])


pure func decode_core_boxed_storage_value_json(
	value: JsonValue,
	path: String,
) -> Result[CoreBoxedStorageValue, CoreJsonError]:
	kind_json ?= object_field(value, path, "kind")
	kind ?= decode_core_box_kind_json(
		kind_json,
		path_field(path, "kind"),
	)
	value_json ?= object_field(value, path, "value")
	expr_value ?= decode_core_expr_json(
		value_json,
		path_field(path, "value"),
	)
	needs_release ?= bool_field(value, path, "needs_release")
	transfers_ownership ?= bool_field(value, path, "transfers_ownership")

	Ok({
		kind = kind,
		value = expr_value,
		needs_release = needs_release,
		transfers_ownership = transfers_ownership,
	})


private pure func core_boxed_storage_values_to_json(
	values: List[CoreBoxedStorageValue],
) -> JsonValue:
	var items: List[JsonValue] = []

	for value in values:
		items = items.append(core_boxed_storage_value_to_json(value))

