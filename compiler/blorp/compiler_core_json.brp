union CoreJsonError:
	CoreMissingField(String, String)
	CoreExpectedObject(String)
	CoreExpectedObjectField(String, String)
	CoreExpectedStringField(String, String)
	CoreExpectedIntField(String, String)
	CoreExpectedNumberField(String, String)
	CoreExpectedBoolField(String, String)
	CoreExpectedArrayField(String, String)
	CoreUnsupportedTag(String, String)


private pure func json_int(value: Int) -> JsonValue:
	JsonNumber(to_float(value))


private pure func option_int_to_json(value: Option[Int]) -> JsonValue:
	match value:
		Some(n):
			json_int(n)
		None:
			JsonNull


private pure func option_string_to_json(value: Option[String]) -> JsonValue:
	match value:
		Some(text):
			JsonString(text)
		None:
			JsonNull


private pure func strings_to_json(items: List[String]) -> JsonValue:
	var values: List[JsonValue] = []

	for item in items:
		values = values.append(JsonString(item))

	JsonVector(values)


private pure func path_field(path: String, field_name: String) -> String:
	if path == "":
		field_name
	else:
		path + "." + field_name


private pure func path_index(path: String, index: Int) -> String:
	path + "[" + index.to_string() + "]"


private pure func object_fields(
	value: JsonValue,
	path: String,
) -> Result[List[(String, JsonValue)], CoreJsonError]:
	match value:
		JsonObject(fields):
			Ok(fields)
		JsonNull:
			Err(CoreExpectedObject(path))
		JsonBool(flag):
			Err(CoreExpectedObject(path))
		JsonNumber(number):
			Err(CoreExpectedObject(path))
		JsonString(text):
			Err(CoreExpectedObject(path))
		JsonVector(items):
			Err(CoreExpectedObject(path))


private pure func required_field(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[JsonValue, CoreJsonError]:
	fields ?= object_fields(value, path)

	match get_field(JsonObject(fields), field_name):
		Some(field):
			Ok(field)
		None:
			Err(CoreMissingField(path, field_name))


private pure func string_field(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[String, CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match as_string(field):
		Some(text):
			Ok(text)
		None:
			Err(CoreExpectedStringField(path, field_name))


private pure func int_field(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[Int, CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match as_number(field):
		Some(number):
			Ok(to_int(number))
		None:
			Err(CoreExpectedIntField(path, field_name))


private pure func number_field(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[Float, CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match as_number(field):
		Some(number):
			Ok(number)
		None:
			Err(CoreExpectedNumberField(path, field_name))


private pure func bool_field(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[Bool, CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match as_bool(field):
		Some(flag):
			Ok(flag)
		None:
			Err(CoreExpectedBoolField(path, field_name))


private pure func array_field(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[JsonValue], CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match as_array(field):
		Some(items):
			Ok(items)
		None:
			Err(CoreExpectedArrayField(path, field_name))


private pure func object_field(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[JsonValue, CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match field:
		JsonObject(fields):
			Ok(JsonObject(fields))
		JsonNull:
			Err(CoreExpectedObjectField(path, field_name))
		JsonBool(flag):
			Err(CoreExpectedObjectField(path, field_name))
		JsonNumber(number):
			Err(CoreExpectedObjectField(path, field_name))
		JsonString(text):
			Err(CoreExpectedObjectField(path, field_name))
		JsonVector(items):
			Err(CoreExpectedObjectField(path, field_name))


private pure func kind_field(value: JsonValue, path: String) -> Result[String, CoreJsonError]:
	string_field(value, path, KIND_FIELD)


private pure func decode_optional_string(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[Option[String], CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match field:
		JsonNull:
			Ok(None)
		JsonString(text):
			Ok(Some(text))
		JsonBool(flag):
			Err(CoreExpectedStringField(path, field_name))
		JsonNumber(number):
			Err(CoreExpectedStringField(path, field_name))
		JsonVector(items):
			Err(CoreExpectedStringField(path, field_name))
		JsonObject(fields):
			Err(CoreExpectedStringField(path, field_name))


private pure func decode_optional_int(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[Option[Int], CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match field:
		JsonNull:
			Ok(None)
		JsonNumber(number):
			Ok(Some(to_int(number)))
		JsonBool(flag):
			Err(CoreExpectedIntField(path, field_name))
		JsonString(text):
			Err(CoreExpectedIntField(path, field_name))
		JsonVector(items):
			Err(CoreExpectedIntField(path, field_name))
		JsonObject(fields):
			Err(CoreExpectedIntField(path, field_name))


private pure func decode_string_list(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[String], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[String] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match as_string(item):
					Some(text):
						result = result.append(text)
					None:
						error = Some(
							CoreExpectedStringField(
								path_index(
									path_field(path, field_name),
									index,
								),
								"",
							),
						)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func source_loc_to_json(loc: CoreSourceLoc) -> JsonValue:
	match loc:
		SyntheticSourceLoc:
			JsonObject([(KIND_FIELD, JsonString(SYNTHETIC_LOC_TAG))])
		KnownSourceLoc(span):
			JsonObject([
				(KIND_FIELD, JsonString(KNOWN_LOC_TAG)),
				("file", JsonString(span.file)),
				("line", json_int(span.line)),
				("column", json_int(span.column)),
				("end_line", json_int(span.end_line)),
				("end_column", json_int(span.end_column)),
			])


pure func decode_source_loc_json(
	value: JsonValue,
	path: String,
) -> Result[CoreSourceLoc, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == SYNTHETIC_LOC_TAG:
		Ok(SyntheticSourceLoc)
	else if tag == KNOWN_LOC_TAG:
		file ?= string_field(value, path, "file")
		line ?= int_field(value, path, "line")
		column ?= int_field(value, path, "column")
		end_line ?= int_field(value, path, "end_line")
		end_column ?= int_field(value, path, "end_column")
		Ok(KnownSourceLoc({
			file = file,
			line = line,
			column = column,
			end_line = end_line,
			end_column = end_column,
		}))
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_var_to_json(variable: CoreVar) -> JsonValue:
	JsonObject([
		("name", JsonString(variable.name)),
		("uniq", json_int(variable.uniq)),
		("def_id", option_int_to_json(variable.def_id)),
	])


pure func decode_core_var_json(value: JsonValue, path: String) -> Result[CoreVar, CoreJsonError]:
	name ?= string_field(value, path, "name")
	uniq ?= int_field(value, path, "uniq")
	def_id ?= decode_optional_int(value, path, "def_id")

	Ok({
		name = name,
		uniq = uniq,
		def_id = def_id,
	})


private pure func core_type_list_to_json(items: List[CoreType]) -> JsonValue:
	var values: List[JsonValue] = []

	for item in items:
		values = values.append(core_type_to_json(item))

	JsonVector(values)


pure func core_type_to_json(typ: CoreType) -> JsonValue:
	match typ:
		VoidType:
			JsonObject([(KIND_FIELD, JsonString(VOID_TYPE_TAG))])
		NamedType(name, args):
			JsonObject([
				(KIND_FIELD, JsonString(NAMED_TYPE_TAG)),
				("name", JsonString(name)),
				("args", core_type_list_to_json(args)),
			])
		EnumType(name):
			JsonObject([
				(KIND_FIELD, JsonString(ENUM_TYPE_TAG)),
				("name", JsonString(name)),
			])
		ValueRecordType(name):
			JsonObject([
				(KIND_FIELD, JsonString(VALUE_RECORD_TYPE_TAG)),
				("name", JsonString(name)),
			])
		HeapRecordType(name):
			JsonObject([
				(KIND_FIELD, JsonString(HEAP_RECORD_TYPE_TAG)),
				("name", JsonString(name)),
			])
		UnionType(name):
			JsonObject([
				(KIND_FIELD, JsonString(UNION_TYPE_TAG)),
				("name", JsonString(name)),
			])
		RangeType:
			JsonObject([(KIND_FIELD, JsonString(RANGE_TYPE_TAG))])
		TupleType(items):
			JsonObject([
				(KIND_FIELD, JsonString(TUPLE_TYPE_TAG)),
				("items", core_type_list_to_json(items)),
			])


private pure func decode_core_type_list(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreType], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreType] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_type_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(typ):
						result = result.append(typ)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func decode_core_type_json(value: JsonValue, path: String) -> Result[CoreType, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == VOID_TYPE_TAG:
		Ok(VoidType)
	else if tag == NAMED_TYPE_TAG:
		name ?= string_field(value, path, "name")
		args ?= decode_core_type_list(value, path, "args")
		Ok(NamedType(name, args))
	else if tag == ENUM_TYPE_TAG:
		name ?= string_field(value, path, "name")
		Ok(EnumType(name))
	else if tag == VALUE_RECORD_TYPE_TAG:
		name ?= string_field(value, path, "name")
		Ok(ValueRecordType(name))
	else if tag == HEAP_RECORD_TYPE_TAG:
		name ?= string_field(value, path, "name")
		Ok(HeapRecordType(name))
	else if tag == UNION_TYPE_TAG:
		name ?= string_field(value, path, "name")
		Ok(UnionType(name))
	else if tag == RANGE_TYPE_TAG:
		Ok(RangeType)
	else if tag == TUPLE_TYPE_TAG:
		items ?= decode_core_type_list(value, path, "items")
		Ok(TupleType(items))
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_literal_to_json(literal: CoreLiteral) -> JsonValue:
	match literal:
		IntLiteral(value):
			JsonObject([
				(KIND_FIELD, JsonString(INT_LITERAL_TAG)),
				("value", json_int(value)),
			])
		FloatLiteral(value):
			JsonObject([
				(KIND_FIELD, JsonString(FLOAT_LITERAL_TAG)),
				("value", JsonNumber(value)),
			])
		BoolLiteral(value):
			JsonObject([
				(KIND_FIELD, JsonString(BOOL_LITERAL_TAG)),
				("value", JsonBool(value)),
			])
		CharLiteral(value):
			JsonObject([
				(KIND_FIELD, JsonString(CHAR_LITERAL_TAG)),
				("value", json_int(value)),
			])
		StringLiteral(value):
			JsonObject([
				(KIND_FIELD, JsonString(STRING_LITERAL_TAG)),
				("value", JsonString(value)),
			])


pure func decode_core_literal_json(
	value: JsonValue,
	path: String,
) -> Result[CoreLiteral, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == INT_LITERAL_TAG:
		n ?= int_field(value, path, "value")
		Ok(IntLiteral(n))
	else if tag == FLOAT_LITERAL_TAG:
		number ?= number_field(value, path, "value")
		Ok(FloatLiteral(number))
	else if tag == BOOL_LITERAL_TAG:
		flag ?= bool_field(value, path, "value")
		Ok(BoolLiteral(flag))
	else if tag == CHAR_LITERAL_TAG:
		codepoint ?= int_field(value, path, "value")
		Ok(CharLiteral(codepoint))
	else if tag == STRING_LITERAL_TAG:
		text ?= string_field(value, path, "value")
		Ok(StringLiteral(text))
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_call_kind_to_json(kind: CoreCallKind) -> JsonValue:
	match kind:
		UserCall(name, def_id):
			JsonObject([
				(KIND_FIELD, JsonString(USER_CALL_TAG)),
				("name", JsonString(name)),
				("def_id", option_int_to_json(def_id)),
			])
		ForeignCall(name):
			JsonObject([
				(KIND_FIELD, JsonString(FOREIGN_CALL_TAG)),
				("name", JsonString(name)),
			])
		BuiltinCall(name):
			JsonObject([
				(KIND_FIELD, JsonString(BUILTIN_CALL_TAG)),
				("name", JsonString(name)),
			])
		IntrinsicCall(name):
			JsonObject([
				(KIND_FIELD, JsonString(INTRINSIC_CALL_TAG)),
				("name", JsonString(name)),
			])
		ClosureCall:
			JsonObject([(KIND_FIELD, JsonString(CLOSURE_CALL_TAG))])


pure func decode_core_call_kind_json(
	value: JsonValue,
	path: String,
) -> Result[CoreCallKind, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == USER_CALL_TAG:
		name ?= string_field(value, path, "name")
		def_id ?= decode_optional_int(value, path, "def_id")
		Ok(UserCall(name, def_id))
	else if tag == FOREIGN_CALL_TAG:
		name ?= string_field(value, path, "name")
		Ok(ForeignCall(name))
	else if tag == BUILTIN_CALL_TAG:
		name ?= string_field(value, path, "name")
		Ok(BuiltinCall(name))
	else if tag == INTRINSIC_CALL_TAG:
		name ?= string_field(value, path, "name")
		Ok(IntrinsicCall(name))
	else if tag == CLOSURE_CALL_TAG:
		Ok(ClosureCall)
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_tuple_element_to_json(element: CoreTupleElement) -> JsonValue:
	match element:
		TuplePrimElement(value):
			JsonObject([
				(KIND_FIELD, JsonString(TUPLE_PRIM_ELEMENT_TAG)),
				("value", core_expr_to_json(value)),
			])
		TuplePointerElement(value):
			JsonObject([
				(KIND_FIELD, JsonString(TUPLE_POINTER_ELEMENT_TAG)),
				("value", core_expr_to_json(value)),
			])
		TupleVoidElement:
			JsonObject([(KIND_FIELD, JsonString(TUPLE_VOID_ELEMENT_TAG))])


pure func decode_core_tuple_element_json(
	value: JsonValue,
	path: String,
) -> Result[CoreTupleElement, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == TUPLE_PRIM_ELEMENT_TAG:
		value_json ?= object_field(value, path, "value")
		expr_value ?= decode_core_expr_json(
			value_json,
			path_field(path, "value"),
		)
		Ok(TuplePrimElement(expr_value))
	else if tag == TUPLE_POINTER_ELEMENT_TAG:
		value_json ?= object_field(value, path, "value")
		expr_value ?= decode_core_expr_json(
			value_json,
			path_field(path, "value"),
		)
		Ok(TuplePointerElement(expr_value))
	else if tag == TUPLE_VOID_ELEMENT_TAG:
		Ok(TupleVoidElement)
	else:
		Err(CoreUnsupportedTag(path, tag))


private pure func core_tuple_elements_to_json(elements: List[CoreTupleElement]) -> JsonValue:
	var values: List[JsonValue] = []

	for element in elements:
		values = values.append(core_tuple_element_to_json(element))

	JsonVector(values)


private pure func decode_core_tuple_elements(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreTupleElement], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreTupleElement] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_tuple_element_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(element):
						result = result.append(element)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func core_tuple_construct_to_json(construct: CoreTupleConstruct) -> JsonValue:
	JsonObject([
		("elements", core_tuple_elements_to_json(construct.elements)),
		("release_mask", json_int(construct.release_mask)),
		("retain_mask", json_int(construct.retain_mask)),
	])


pure func decode_core_tuple_construct_json(
	value: JsonValue,
	path: String,
) -> Result[CoreTupleConstruct, CoreJsonError]:
	elements ?= decode_core_tuple_elements(value, path, "elements")
	release_mask ?= int_field(value, path, "release_mask")
	retain_mask ?= int_field(value, path, "retain_mask")

	Ok({
		elements = elements,
		release_mask = release_mask,
		retain_mask = retain_mask
	})


pure func core_box_kind_to_json(kind: CoreBoxKind) -> JsonValue:
	match kind:
		PrimBox:
			JsonObject([(KIND_FIELD, JsonString(BOX_PRIM_TAG))])
		PointerBox:
			JsonObject([(KIND_FIELD, JsonString(BOX_POINTER_TAG))])
		VoidBox:
			JsonObject([(KIND_FIELD, JsonString(BOX_VOID_TAG))])
		StructBox(c_type):
			JsonObject([
				(KIND_FIELD, JsonString(BOX_STRUCT_TAG)),
				("c_type", JsonString(c_type)),
			])


pure func decode_core_box_kind_json(
	value: JsonValue,
	path: String,
) -> Result[CoreBoxKind, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == BOX_PRIM_TAG:
		Ok(PrimBox)
	else if tag == BOX_POINTER_TAG:
		Ok(PointerBox)
	else if tag == BOX_VOID_TAG:
		Ok(VoidBox)
	else if tag == BOX_STRUCT_TAG:
		c_type ?= string_field(value, path, "c_type")
		Ok(StructBox(c_type))
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_box_op_to_json(box: CoreBoxOp) -> JsonValue:
	JsonObject([
		("kind", core_box_kind_to_json(box.kind)),
		("value", core_expr_to_json(box.value)),
		("source_type", core_type_to_json(box.source_type)),
	])


pure func decode_core_box_op_json(
	value: JsonValue,
	path: String,
) -> Result[CoreBoxOp, CoreJsonError]:
	kind_json ?= object_field(value, path, "kind")
	kind ?= decode_core_box_kind_json(
		kind_json,
		path_field(path, "kind"),
	)
	value_json ?= object_field(value, path, "value")
	expr_value ?= decode_core_expr_json(
		value_json,
		path_field(path, "value"),
	)
	source_type_json ?= object_field(value, path, "source_type")
	source_type ?= decode_core_type_json(
		source_type_json,
		path_field(path, "source_type"),
	)

	Ok({
		kind = kind,
		value = expr_value,
		source_type = source_type,
	})


pure func core_unbox_kind_to_json(kind: CoreUnboxKind) -> JsonValue:
	match kind:
		FloatUnbox:
			JsonObject([(KIND_FIELD, JsonString(UNBOX_FLOAT_TAG))])
		Float32Unbox:
			JsonObject([(KIND_FIELD, JsonString(UNBOX_FLOAT32_TAG))])
		Float16Unbox:
			JsonObject([(KIND_FIELD, JsonString(UNBOX_FLOAT16_TAG))])
		Int128Unbox:
			JsonObject([(KIND_FIELD, JsonString(UNBOX_INT128_TAG))])
		UInt128Unbox:
			JsonObject([(KIND_FIELD, JsonString(UNBOX_UINT128_TAG))])
		PointerUnbox:
			JsonObject([(KIND_FIELD, JsonString(UNBOX_POINTER_TAG))])
		PrimUnbox:
			JsonObject([(KIND_FIELD, JsonString(UNBOX_PRIM_TAG))])
		StructUnbox(c_type):
			JsonObject([
				(KIND_FIELD, JsonString(UNBOX_STRUCT_TAG)),
				("c_type", JsonString(c_type)),
			])


pure func decode_core_unbox_kind_json(
	value: JsonValue,
	path: String,
) -> Result[CoreUnboxKind, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == UNBOX_FLOAT_TAG:
		Ok(FloatUnbox)
	else if tag == UNBOX_FLOAT32_TAG:
		Ok(Float32Unbox)
	else if tag == UNBOX_FLOAT16_TAG:
		Ok(Float16Unbox)
	else if tag == UNBOX_INT128_TAG:
		Ok(Int128Unbox)
	else if tag == UNBOX_UINT128_TAG:
		Ok(UInt128Unbox)
	else if tag == UNBOX_POINTER_TAG:
		Ok(PointerUnbox)
	else if tag == UNBOX_PRIM_TAG:
		Ok(PrimUnbox)
	else if tag == UNBOX_STRUCT_TAG:
		c_type ?= string_field(value, path, "c_type")
		Ok(StructUnbox(c_type))
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_boxed_storage_value_to_json(value: CoreBoxedStorageValue) -> JsonValue:
	JsonObject([
		("kind", core_box_kind_to_json(value.kind)),
		("value", core_expr_to_json(value.value)),
		("needs_release", JsonBool(value.needs_release)),
		("transfers_ownership", JsonBool(value.transfers_ownership)),
	])


pure func decode_core_boxed_storage_value_json(
	value: JsonValue,
	path: String,
) -> Result[CoreBoxedStorageValue, CoreJsonError]:
	kind_json ?= object_field(value, path, "kind")
	kind ?= decode_core_box_kind_json(
		kind_json,
		path_field(path, "kind"),
	)
	value_json ?= object_field(value, path, "value")
	expr_value ?= decode_core_expr_json(
		value_json,
		path_field(path, "value"),
	)
	needs_release ?= bool_field(value, path, "needs_release")
	transfers_ownership ?= bool_field(value, path, "transfers_ownership")

	Ok({
		kind = kind,
		value = expr_value,
		needs_release = needs_release,
		transfers_ownership = transfers_ownership,
	})


private pure func core_boxed_storage_values_to_json(
	values: List[CoreBoxedStorageValue],
) -> JsonValue:
	var items: List[JsonValue] = []

	for value in values:
		items = items.append(core_boxed_storage_value_to_json(value))

	JsonVector(items)


private pure func decode_core_boxed_storage_values(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreBoxedStorageValue], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreBoxedStorageValue] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_boxed_storage_value_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(boxed_value):
						result = result.append(boxed_value)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func core_hash_container_constructor_to_json(
	constructor: CoreHashContainerConstructor,
) -> JsonValue:
	match constructor:
		GenericHashContainerConstructor:
			JsonObject([(KIND_FIELD, JsonString(HASH_CONTAINER_GENERIC_TAG))])
		StringHashContainerConstructor:
			JsonObject([(KIND_FIELD, JsonString(HASH_CONTAINER_STRING_TAG))])
		FloatHashContainerConstructor:
			JsonObject([(KIND_FIELD, JsonString(HASH_CONTAINER_FLOAT_TAG))])
		CustomHashContainerConstructor(hash_fn, equals_fn, elem_needs_release):
			JsonObject([
				(KIND_FIELD, JsonString(HASH_CONTAINER_CUSTOM_TAG)),
				("hash_fn", JsonString(hash_fn)),
				("equals_fn", JsonString(equals_fn)),
				("elem_needs_release", JsonBool(elem_needs_release)),
			])


pure func decode_core_hash_container_constructor_json(
	value: JsonValue,
	path: String,
) -> Result[CoreHashContainerConstructor, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == HASH_CONTAINER_GENERIC_TAG:
		Ok(GenericHashContainerConstructor)
	else if tag == HASH_CONTAINER_STRING_TAG:
		Ok(StringHashContainerConstructor)
	else if tag == HASH_CONTAINER_FLOAT_TAG:
		Ok(FloatHashContainerConstructor)
	else if tag == HASH_CONTAINER_CUSTOM_TAG:
		hash_fn ?= string_field(value, path, "hash_fn")
		equals_fn ?= string_field(value, path, "equals_fn")
		elem_needs_release ?= bool_field(value, path, "elem_needs_release")

		Ok(CustomHashContainerConstructor(hash_fn, equals_fn, elem_needs_release))
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_dict_entry_to_json(entry: CoreDictEntry) -> JsonValue:
	JsonObject([
		("key", core_boxed_storage_value_to_json(entry.key)),
		("value", core_boxed_storage_value_to_json(entry.value)),
	])


pure func decode_core_dict_entry_json(
	value: JsonValue,
	path: String,
) -> Result[CoreDictEntry, CoreJsonError]:
	key_json ?= object_field(value, path, "key")
	key ?= decode_core_boxed_storage_value_json(
		key_json,
		path_field(path, "key"),
	)
	value_json ?= object_field(value, path, "value")
	entry_value ?= decode_core_boxed_storage_value_json(
		value_json,
		path_field(path, "value"),
	)

	Ok({
		key = key,
		value = entry_value,
	})


private pure func core_dict_entries_to_json(entries: List[CoreDictEntry]) -> JsonValue:
	var items: List[JsonValue] = []

	for entry in entries:
		items = items.append(core_dict_entry_to_json(entry))

	JsonVector(items)


private pure func decode_core_dict_entries(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreDictEntry], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreDictEntry] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_dict_entry_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(entry):
						result = result.append(entry)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func core_dict_construct_to_json(construct: CoreDictConstruct) -> JsonValue:
	JsonObject([
		("constructor", core_hash_container_constructor_to_json(construct.constructor)),
		("entries", core_dict_entries_to_json(construct.entries)),
		("value_needs_release", JsonBool(construct.value_needs_release)),
	])


pure func decode_core_dict_construct_json(
	value: JsonValue,
	path: String,
) -> Result[CoreDictConstruct, CoreJsonError]:
	constructor_json ?= object_field(value, path, "constructor")
	constructor ?= decode_core_hash_container_constructor_json(
		constructor_json,
		path_field(path, "constructor"),
	)
	entries ?= decode_core_dict_entries(value, path, "entries")
	value_needs_release ?= bool_field(value, path, "value_needs_release")

	Ok({
		constructor = constructor,
		entries = entries,
		value_needs_release = value_needs_release,
	})


pure func core_set_alloc_to_json(alloc: CoreSetAlloc) -> JsonValue:
	JsonObject([("constructor", core_hash_container_constructor_to_json(alloc.constructor))])


pure func decode_core_set_alloc_json(
	value: JsonValue,
	path: String,
) -> Result[CoreSetAlloc, CoreJsonError]:
	constructor_json ?= object_field(value, path, "constructor")
	constructor ?= decode_core_hash_container_constructor_json(
		constructor_json,
		path_field(path, "constructor"),
	)

	Ok({constructor = constructor})


pure func core_list_storage_layout_to_json(layout: CoreListStorageLayout) -> JsonValue:
	match layout:
		PointerListStorage:
			JsonObject([(KIND_FIELD, JsonString(LIST_POINTER_STORAGE_TAG))])
		InlineListStorage(width_bytes):
			JsonObject([
				(KIND_FIELD, JsonString(LIST_INLINE_STORAGE_TAG)),
				("width_bytes", json_int(width_bytes)),
			])
		InlineStructListStorage(c_type):
			JsonObject([
				(KIND_FIELD, JsonString(LIST_INLINE_STRUCT_STORAGE_TAG)),
				("c_type", JsonString(c_type)),
			])


pure func decode_core_list_storage_layout_json(
	value: JsonValue,
	path: String,
) -> Result[CoreListStorageLayout, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == LIST_POINTER_STORAGE_TAG:
		Ok(PointerListStorage)
	else if tag == LIST_INLINE_STORAGE_TAG:
		width_bytes ?= int_field(value, path, "width_bytes")
		Ok(InlineListStorage(width_bytes))
	else if tag == LIST_INLINE_STRUCT_STORAGE_TAG:
		c_type ?= string_field(value, path, "c_type")
		Ok(InlineStructListStorage(c_type))
	else:
		Err(CoreUnsupportedTag(path, tag))


