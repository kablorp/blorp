pure func core_list_storage_layout_to_json(layout: CoreListStorageLayout) -> JsonValue:
	match layout:
		PointerListStorage:
			JsonObject([(KIND_FIELD, JsonString(LIST_POINTER_STORAGE_TAG))])
		InlineListStorage(width_bytes):
			JsonObject([
				(KIND_FIELD, JsonString(LIST_INLINE_STORAGE_TAG)),
				("width_bytes", json_int(width_bytes)),
			])
		InlineStructListStorage(c_type):
			JsonObject([
				(KIND_FIELD, JsonString(LIST_INLINE_STRUCT_STORAGE_TAG)),
				("c_type", JsonString(c_type)),
			])


pure func decode_core_list_storage_layout_json(
	value: JsonValue,
	path: String,
) -> Result[CoreListStorageLayout, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == LIST_POINTER_STORAGE_TAG:
		Ok(PointerListStorage)
	else if tag == LIST_INLINE_STORAGE_TAG:
		width_bytes ?= int_field(value, path, "width_bytes")
		Ok(InlineListStorage(width_bytes))
	else if tag == LIST_INLINE_STRUCT_STORAGE_TAG:
		c_type ?= string_field(value, path, "c_type")
		Ok(InlineStructListStorage(c_type))
	else:
		Err(CoreUnsupportedTag(path, tag))


