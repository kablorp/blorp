		release_policy_tag ?= string_field(value, path, "release_policy")
		release_policy ?= parse_core_release_policy(
			release_policy_tag,
			path_field(path, "release_policy"),
		)
		body_json ?= object_field(value, path, "body")
		body ?= decode_core_expr_json(
			body_json,
			path_field(path, "body"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(DropExpr(variable, value_type, release_policy, body, typ, loc))
	else if tag == LET_EXPR_TAG:
		name_json ?= object_field(value, path, "name")
		name ?= decode_core_var_json(
			name_json,
			path_field(path, "name"),
		)
		is_mutable ?= bool_field(value, path, "mutable")
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		rhs_json ?= object_field(value, path, "rhs")
		rhs ?= decode_core_expr_json(
			rhs_json,
			path_field(path, "rhs"),
		)
		body_json ?= object_field(value, path, "body")
		body ?= decode_core_expr_json(
			body_json,
			path_field(path, "body"),
		)
		Ok(LetExpr(name, is_mutable, typ, rhs, body))
	else if tag == SEQ_EXPR_TAG:
		first_json ?= object_field(value, path, "first")
		first ?= decode_core_expr_json(
			first_json,
			path_field(path, "first"),
		)
		second_json ?= object_field(value, path, "second")
		second ?= decode_core_expr_json(
			second_json,
			path_field(path, "second"),
		)
		Ok(SeqExpr(first, second))
	else if tag == WHILE_EXPR_TAG:
		cond_json ?= object_field(value, path, "cond")
		cond ?= decode_core_expr_json(
			cond_json,
			path_field(path, "cond"),
		)
		body_json ?= object_field(value, path, "body")
		body ?= decode_core_expr_json(
			body_json,
			path_field(path, "body"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(WhileExpr(cond, body, typ, loc))
	else if tag == BREAK_EXPR_TAG:
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(BreakExpr(typ, loc))
	else if tag == CONTINUE_EXPR_TAG:
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(ContinueExpr(typ, loc))
	else if tag == RESOURCE_SCOPE_EXPR_TAG:
		scope_json ?= object_field(value, path, "scope")
		scope ?= decode_core_resource_scope_json(
			scope_json,
			path_field(path, "scope"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(ResourceScopeExpr(scope, typ, loc))
	else if tag == RESOURCE_CLEANUP_EXIT_EXPR_TAG:
		cleanup_exit_json ?= object_field(value, path, "cleanup_exit")
		cleanup_exit ?= decode_core_resource_cleanup_exit_json(
			cleanup_exit_json,
			path_field(path, "cleanup_exit"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(ResourceCleanupExitExpr(cleanup_exit, typ, loc))
	else if tag == TAILREC_LOOP_EXPR_TAG:
		params ?= decode_core_params(value, path, "params")
		return_type_json ?= object_field(value, path, "return_type")
		return_type ?= decode_core_type_json(
			return_type_json,
			path_field(path, "return_type"),
		)
		body_json ?= object_field(value, path, "body")
		body ?= decode_core_expr_json(
			body_json,
			path_field(path, "body"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(TailrecLoopExpr(params, return_type, body, loc))
	else if tag == TAILREC_RECUR_EXPR_TAG:
		args ?= decode_core_expr_list(value, path, "args")
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(TailrecRecurExpr(args, typ, loc))
	else if tag == FOR_RANGE_EXPR_TAG:
		binder_json ?= object_field(value, path, "binder")
		binder ?= decode_core_loop_binder_json(
			binder_json,
			path_field(path, "binder"),
		)
		start_json ?= object_field(value, path, "start")
		start ?= decode_core_expr_json(
			start_json,
			path_field(path, "start"),
		)
		end_json ?= object_field(value, path, "end")
		end_value ?= decode_core_expr_json(
			end_json,
			path_field(path, "end"),
		)
		body_json ?= object_field(value, path, "body")
		body ?= decode_core_expr_json(
			body_json,
			path_field(path, "body"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(ForRangeExpr(binder, start, end_value, body, typ, loc))
	else if tag == FOR_CHANNEL_EXPR_TAG:
		for_channel_json ?= object_field(value, path, "for_channel")
		for_channel ?= decode_core_for_channel_json(
			for_channel_json,
			path_field(path, "for_channel"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(ForChannelExpr(for_channel, typ, loc))
	else if tag == FOR_LIST_EXPR_TAG:
		for_list_json ?= object_field(value, path, "for_list")
		for_list ?= decode_core_for_list_json(
			for_list_json,
			path_field(path, "for_list"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(ForListExpr(for_list, typ, loc))
	else if tag == FOR_STREAM_EXPR_TAG:
		for_stream_json ?= object_field(value, path, "for_stream")
		for_stream ?= decode_core_for_stream_json(
			for_stream_json,
			path_field(path, "for_stream"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(ForStreamExpr(for_stream, typ, loc))
	else if tag == FOR_RESOURCE_SOURCE_EXPR_TAG:
		for_resource_source_json ?= object_field(value, path, "for_resource_source")
		for_resource_source ?= decode_core_for_resource_source_json(
			for_resource_source_json,
			path_field(path, "for_resource_source"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(ForResourceSourceExpr(for_resource_source, typ, loc))
	else if tag == FOR_TENSOR_EXPR_TAG:
		for_tensor_json ?= object_field(value, path, "for_tensor")
		for_tensor ?= decode_core_for_tensor_json(
			for_tensor_json,
			path_field(path, "for_tensor"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(ForTensorExpr(for_tensor, typ, loc))
	else if tag == RANGE_EXPR_TAG:
		start_json ?= object_field(value, path, "start")
		start ?= decode_core_expr_json(
			start_json,
			path_field(path, "start"),
		)
		end_json ?= object_field(value, path, "end")
		end_value ?= decode_core_expr_json(
			end_json,
			path_field(path, "end"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(RangeExpr(start, end_value, typ, loc))
	else if tag == LITERAL_MATCH_EXPR_TAG:
		scrutinee_json ?= object_field(value, path, "scrutinee")
		scrutinee ?= decode_core_expr_json(
			scrutinee_json,
			path_field(path, "scrutinee"),
		)
		cases ?= decode_core_literal_match_cases(value, path, "cases")
		fallback_json ?= object_field(value, path, "fallback")
		fallback ?= decode_core_literal_match_fallback_json(
			fallback_json,
			path_field(path, "fallback"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(LiteralMatchExpr(scrutinee, cases, fallback, typ, loc))
	else if tag == ACCESSOR_LITERAL_MATCH_EXPR_TAG:
		scrutinee_json ?= object_field(value, path, "scrutinee")
		scrutinee ?= decode_core_expr_json(
			scrutinee_json,
			path_field(path, "scrutinee"),
		)
		scrutinee_release_policy_tag ?= string_field(value, path, "scrutinee_release_policy")
		scrutinee_release_policy ?= parse_core_release_policy(
			scrutinee_release_policy_tag,
			path_field(path, "scrutinee_release_policy"),
		)
		match_json ?= object_field(value, path, "match")
		match_expr ?= decode_core_constructor_literal_match_json(
			match_json,
			path_field(path, "match"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc))
	else if tag == LENGTH_MATCH_EXPR_TAG:
		scrutinee_json ?= object_field(value, path, "scrutinee")
		scrutinee ?= decode_core_expr_json(
			scrutinee_json,
			path_field(path, "scrutinee"),
		)
		scrutinee_release_policy_tag ?= string_field(value, path, "scrutinee_release_policy")
		scrutinee_release_policy ?= parse_core_release_policy(
			scrutinee_release_policy_tag,
			path_field(path, "scrutinee_release_policy"),
		)
		match_json ?= object_field(value, path, "match")
		match_expr ?= decode_core_constructor_length_match_json(
			match_json,
			path_field(path, "match"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc))
	else if tag == CONSTRUCTOR_MATCH_EXPR_TAG:
		scrutinee_json ?= object_field(value, path, "scrutinee")
		scrutinee ?= decode_core_expr_json(
			scrutinee_json,
			path_field(path, "scrutinee"),
		)
		scrutinee_release_policy_tag ?= string_field(value, path, "scrutinee_release_policy")
		scrutinee_release_policy ?= parse_core_release_policy(
			scrutinee_release_policy_tag,
			path_field(path, "scrutinee_release_policy"),
		)
		cases ?= decode_core_constructor_match_cases(value, path, "cases")
		fallback_json ?= object_field(value, path, "fallback")
		fallback ?= decode_core_constructor_match_fallback_json(
			fallback_json,
			path_field(path, "fallback"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, fallback, typ, loc))
	else if tag == IF_EXPR_TAG:
		cond_json ?= object_field(value, path, "cond")
		cond ?= decode_core_expr_json(
			cond_json,
			path_field(path, "cond"),
		)
		then_json ?= object_field(value, path, "then")
		then_expr ?= decode_core_expr_json(
			then_json,
			path_field(path, "then"),
		)
		else_json ?= object_field(value, path, "else")
		else_expr ?= decode_core_expr_json(
			else_json,
			path_field(path, "else"),
		)
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)
		Ok(IfExpr(cond, then_expr, else_expr, typ, loc))
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_param_to_json(param: CoreParam) -> JsonValue:
	JsonObject([
		("name", core_var_to_json(param.name)),
		("type", core_type_to_json(param.typ)),
		("loc", source_loc_to_json(param.loc)),
	])


pure func decode_core_param_json(
	value: JsonValue,
	path: String,
) -> Result[CoreParam, CoreJsonError]:
	name_json ?= object_field(value, path, "name")
	name ?= decode_core_var_json(
		name_json,
		path_field(path, "name"),
	)
	type_json ?= object_field(value, path, "type")
	typ ?= decode_core_type_json(
		type_json,
		path_field(path, "type"),
	)
	loc_json ?= object_field(value, path, "loc")
	loc ?= decode_source_loc_json(
		loc_json,
		path_field(path, "loc"),
	)

	Ok({
		name = name,
		typ = typ,
		loc = loc,
	})


private pure func core_params_to_json(params: List[CoreParam]) -> JsonValue:
	var values: List[JsonValue] = []

	for param in params:
		values = values.append(core_param_to_json(param))

	JsonVector(values)


private pure func decode_core_params(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreParam], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreParam] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_param_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(param):
						result = result.append(param)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func core_closure_capture_to_json(capture: CoreClosureCapture) -> JsonValue:
	JsonObject([
		("name", JsonString(capture.name)),
		("type", core_type_to_json(capture.typ)),
	])


pure func decode_core_closure_capture_json(
	value: JsonValue,
	path: String,
) -> Result[CoreClosureCapture, CoreJsonError]:
	name ?= string_field(value, path, "name")
	type_json ?= object_field(value, path, "type")
	typ ?= decode_core_type_json(
		type_json,
		path_field(path, "type"),
	)

	Ok({
		name = name,
		typ = typ,
	})


private pure func core_closure_captures_to_json(captures: List[CoreClosureCapture]) -> JsonValue:
	var values: List[JsonValue] = []

	for capture in captures:
		values = values.append(core_closure_capture_to_json(capture))

	JsonVector(values)


private pure func decode_core_closure_captures(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreClosureCapture], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreClosureCapture] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_closure_capture_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(capture):
						result = result.append(capture)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func core_closure_abi_to_json(abi: CoreClosureAbi) -> JsonValue:
	JsonObject([
		("c_name", JsonString(abi.c_name)),
		("params", core_params_to_json(abi.params)),
		("captures", core_closure_captures_to_json(abi.captures)),
		("moved_captures", strings_to_json(abi.moved_captures)),
		("task_abi", JsonBool(abi.task_abi)),
	])


pure func decode_core_closure_abi_json(
	value: JsonValue,
	path: String,
) -> Result[CoreClosureAbi, CoreJsonError]:
	c_name ?= string_field(value, path, "c_name")
	params ?= decode_core_params(value, path, "params")
	captures ?= decode_core_closure_captures(value, path, "captures")
	moved_captures ?= decode_string_list(value, path, "moved_captures")
	task_abi ?= bool_field(value, path, "task_abi")

	Ok({
		c_name = c_name,
		params = params,
		captures = captures,
		moved_captures = moved_captures,
		task_abi = task_abi,
	})


pure func core_closure_create_to_json(closure: CoreClosureCreate) -> JsonValue:
	JsonObject([
		("function_name", JsonString(closure.function_name)),
		("def_id", json_int(closure.def_id)),
		("c_name", JsonString(closure.c_name)),
		("static_name", JsonString(closure.static_name)),
		("captures", core_closure_captures_to_json(closure.captures)),
	])


pure func decode_core_closure_create_json(
	value: JsonValue,
	path: String,
) -> Result[CoreClosureCreate, CoreJsonError]:
	function_name ?= string_field(value, path, "function_name")
	def_id ?= int_field(value, path, "def_id")
	c_name ?= string_field(value, path, "c_name")
	static_name ?= string_field(value, path, "static_name")
	captures ?= decode_core_closure_captures(value, path, "captures")

	Ok({
		function_name = function_name,
		def_id = def_id,
		c_name = c_name,
		static_name = static_name,
		captures = captures,
	})


pure func function_kind_to_string(kind: CoreFunctionKind) -> String:
	match kind:
		UserFunction:
			USER_FUNCTION_KIND_TAG
		BuiltinFunction:
			BUILTIN_FUNCTION_KIND_TAG
		ForeignFunction:
			FOREIGN_FUNCTION_KIND_TAG
		ClosureBodyFunction(abi):
			CLOSURE_BODY_FUNCTION_KIND_TAG


pure func core_function_kind_to_json(kind: CoreFunctionKind) -> JsonValue:
	match kind:
		UserFunction:
			JsonObject([(KIND_FIELD, JsonString(USER_FUNCTION_KIND_TAG))])
		BuiltinFunction:
			JsonObject([(KIND_FIELD, JsonString(BUILTIN_FUNCTION_KIND_TAG))])
		ForeignFunction:
			JsonObject([(KIND_FIELD, JsonString(FOREIGN_FUNCTION_KIND_TAG))])
		ClosureBodyFunction(abi):
			JsonObject([
				(KIND_FIELD, JsonString(CLOSURE_BODY_FUNCTION_KIND_TAG)),
				("abi", core_closure_abi_to_json(abi)),
			])


pure func decode_core_function_kind_json(
	value: JsonValue,
	path: String,
) -> Result[CoreFunctionKind, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == USER_FUNCTION_KIND_TAG:
		Ok(UserFunction)
	else if tag == BUILTIN_FUNCTION_KIND_TAG:
		Ok(BuiltinFunction)
	else if tag == FOREIGN_FUNCTION_KIND_TAG:
		Ok(ForeignFunction)
	else if tag == CLOSURE_BODY_FUNCTION_KIND_TAG:
		abi_json ?= object_field(value, path, "abi")
		abi ?= decode_core_closure_abi_json(
			abi_json,
			path_field(path, "abi"),
		)
		Ok(ClosureBodyFunction(abi))
	else:
		Err(CoreUnsupportedTag(path, tag))


private pure func option_expr_to_json(body: Option[CoreExpr]) -> JsonValue:
	match body:
		Some(expr):
			core_expr_to_json(expr)
		None:
			JsonNull


private pure func decode_optional_expr(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[Option[CoreExpr], CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match field:
		JsonNull:
			Ok(None)
		JsonObject(fields):
			expr ?= decode_core_expr_json(
				JsonObject(fields),
				path_field(path, field_name),
			)
			Ok(Some(expr))
		JsonBool(flag):
			Err(CoreExpectedObjectField(path, field_name))
		JsonNumber(number):
			Err(CoreExpectedObjectField(path, field_name))
		JsonString(text):
			Err(CoreExpectedObjectField(path, field_name))
		JsonVector(items):
			Err(CoreExpectedObjectField(path, field_name))


pure func core_function_to_json(core_func: CoreFunction) -> JsonValue:
	JsonObject([
		(KIND_FIELD, JsonString(FUNCTION_TAG)),
		("name", JsonString(core_func.name)),
		("module", option_string_to_json(core_func.source_module)),
		("type_params", strings_to_json(core_func.type_params)),
		("params", core_params_to_json(core_func.params)),
		("return_type", core_type_to_json(core_func.return_type)),
		("body", option_expr_to_json(core_func.body)),
		("pure", JsonBool(core_func.is_pure)),
		("function_kind", core_function_kind_to_json(core_func.function_kind)),
		("def_id", json_int(core_func.def_id)),
		("loc", source_loc_to_json(core_func.loc)),
	])


pure func decode_core_function_json(
	value: JsonValue,
	path: String,
) -> Result[CoreFunction, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag != FUNCTION_TAG:
		Err(CoreUnsupportedTag(path, tag))
	else:
		name ?= string_field(value, path, "name")
		source_module ?= decode_optional_string(value, path, "module")
		type_params ?= decode_string_list(value, path, "type_params")
		params ?= decode_core_params(value, path, "params")
		return_type_json ?= object_field(value, path, "return_type")
		return_type ?= decode_core_type_json(
			return_type_json,
			path_field(path, "return_type"),
		)
		body ?= decode_optional_expr(value, path, "body")
		is_pure ?= bool_field(value, path, "pure")
		function_kind_json ?= object_field(value, path, "function_kind")
		function_kind ?= decode_core_function_kind_json(
			function_kind_json,
			path_field(path, "function_kind"),
		)
		def_id ?= int_field(value, path, "def_id")
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)

		Ok({
			name = name,
			source_module = source_module,
			type_params = type_params,
			params = params,
			return_type = return_type,
			body = body,
			is_pure = is_pure,
			function_kind = function_kind,
			def_id = def_id,
			loc = loc,
		})


pure func core_global_to_json(global: CoreGlobal) -> JsonValue:
	JsonObject([
		(KIND_FIELD, JsonString(GLOBAL_TAG)),
		("name", core_var_to_json(global.name)),
		("type", core_type_to_json(global.typ)),
		("init", core_expr_to_json(global.init)),
		("mutable", JsonBool(global.is_mutable)),
		("const", JsonBool(global.is_const)),
		("def_id", json_int(global.def_id)),
		("loc", source_loc_to_json(global.loc)),
	])


pure func decode_core_global_json(
	value: JsonValue,
	path: String,
) -> Result[CoreGlobal, CoreJsonError]:
	name_json ?= object_field(value, path, "name")
	name ?= decode_core_var_json(
		name_json,
		path_field(path, "name"),
	)
	type_json ?= object_field(value, path, "type")
	typ ?= decode_core_type_json(
		type_json,
		path_field(path, "type"),
	)
	init_json ?= object_field(value, path, "init")
	init ?= decode_core_expr_json(
		init_json,
		path_field(path, "init"),
	)
	is_mutable ?= bool_field(value, path, "mutable")
	is_const ?= bool_field(value, path, "const")
	def_id ?= int_field(value, path, "def_id")
	loc_json ?= object_field(value, path, "loc")
	loc ?= decode_source_loc_json(
		loc_json,
		path_field(path, "loc"),
	)

	Ok({
		name = name,
		typ = typ,
		init = init,
		is_mutable = is_mutable,
		is_const = is_const,
		def_id = def_id,
		loc = loc,
	})


