		)
		Ok(ListConstructExpr(construct, typ, loc))
	else if tag == RECORD_EXPR_TAG:
		fields ?= decode_core_record_fields(value, path, "fields")
		type_json ?= object_field(value, path, "type")
		typ ?= decode_core_type_json(
			type_json,
			path_field(path, "type"),
		)
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
