	var values: List[JsonValue] = []

	for variant in variants:
		values = values.append(core_enum_variant_to_json(variant))

	JsonVector(values)


pure func decode_core_enum_variant_json(
	value: JsonValue,
	path: String,
) -> Result[CoreEnumVariant, CoreJsonError]:
	name ?= string_field(value, path, "name")
	c_name ?= string_field(value, path, "c_name")
	tag ?= int_field(value, path, "tag")
	def_id ?= decode_optional_int(value, path, "def_id")

	Ok({
		name = name,
		c_name = c_name,
		tag = tag,
		def_id = def_id,
	})


private pure func decode_core_enum_variants(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreEnumVariant], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreEnumVariant] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_enum_variant_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(variant):
						result = result.append(variant)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


