-- JSON projection for Blorp-owned syntactic module surfaces.
import:
	compiler_module_surface:
		ModuleSurface,
		ModuleSurfaceImport,
		ModuleSurfaceSymbol,
		ModuleSurfaceSymbolKind,
		ModuleSurfaceSymbolSource(
			DeclSurfaceSource,
			ImplMethodSurfaceSource,
			PrivateDeclSurfaceSource,
			PrivateImplMethodSurfaceSource,
			PrivateTraitMethodSurfaceSource,
			TraitMethodSurfaceSource,
		),
		module_surface_symbol_kind_name,
		module_surface_symbol_source_kind
	json: JsonValue(JsonNumber, JsonObject, JsonString, JsonVector)


private pure func int_to_json(value: Int) -> JsonValue:
	JsonNumber(to_float(value))


private pure func strings_to_json(items: List[String]) -> JsonValue:
	var values: List[JsonValue] = []

	for item in items:
		values = values.append(JsonString(item))

	JsonVector(values)


pure func module_surface_symbol_kind_to_json(kind: ModuleSurfaceSymbolKind) -> JsonValue:
	JsonString(module_surface_symbol_kind_name(kind))


pure func module_surface_symbol_source_to_json(
	source: ModuleSurfaceSymbolSource,
) -> JsonValue:
	match source:
		DeclSurfaceSource(decl_index):
			JsonObject([
				("kind", JsonString(module_surface_symbol_source_kind(source))),
				("decl_index", int_to_json(decl_index)),
			])
		TraitMethodSurfaceSource(decl_index, method_index):
			JsonObject([
				("kind", JsonString(module_surface_symbol_source_kind(source))),
				("decl_index", int_to_json(decl_index)),
				("method_index", int_to_json(method_index)),
			])
		ImplMethodSurfaceSource(decl_index, method_index):
			JsonObject([
				("kind", JsonString(module_surface_symbol_source_kind(source))),
				("decl_index", int_to_json(decl_index)),
				("method_index", int_to_json(method_index)),
			])
		PrivateDeclSurfaceSource(decl_index):
			JsonObject([
				("kind", JsonString(module_surface_symbol_source_kind(source))),
				("decl_index", int_to_json(decl_index)),
			])
		PrivateTraitMethodSurfaceSource(decl_index, method_index):
			JsonObject([
				("kind", JsonString(module_surface_symbol_source_kind(source))),
				("decl_index", int_to_json(decl_index)),
				("method_index", int_to_json(method_index)),
			])
		PrivateImplMethodSurfaceSource(decl_index, method_index):
			JsonObject([
				("kind", JsonString(module_surface_symbol_source_kind(source))),
				("decl_index", int_to_json(decl_index)),
				("method_index", int_to_json(method_index)),
			])


pure func module_surface_symbol_to_json(symbol: ModuleSurfaceSymbol) -> JsonValue:
	JsonObject([
		("name", JsonString(symbol.name)),
		("kind", module_surface_symbol_kind_to_json(symbol.kind)),
		("source", module_surface_symbol_source_to_json(symbol.source)),
	])


private pure func module_surface_symbols_to_json(
	symbols: List[ModuleSurfaceSymbol],
) -> JsonValue:
	var values: List[JsonValue] = []

	for symbol in symbols:
		values = values.append(module_surface_symbol_to_json(symbol))

	JsonVector(values)


pure func module_surface_import_to_json(import_item: ModuleSurfaceImport) -> JsonValue:
	JsonObject([
		("module_path", JsonString(import_item.module_path)),
	])


private pure func module_surface_imports_to_json(
	imports: List[ModuleSurfaceImport],
) -> JsonValue:
	var values: List[JsonValue] = []

	for import_item in imports:
		values = values.append(module_surface_import_to_json(import_item))

	JsonVector(values)


pure func module_surface_to_json(surface: ModuleSurface) -> JsonValue:
	JsonObject([
		("kind", JsonString("module_surface")),
		("module", JsonString(surface.module_name)),
		("imports", module_surface_imports_to_json(surface.imports)),
		("exports", module_surface_symbols_to_json(surface.exports)),
		("private_names", module_surface_symbols_to_json(surface.private_names)),
		("private_traits", strings_to_json(surface.private_traits)),
	])
