import:
	compiler_type:
		CompilerType(CompilerArrayType, CompilerNamedType, CompilerTupleType),
		compiler_is_any_float_type,
		compiler_is_any_integer_type,
		compiler_is_dim_type,


enum CompilerRecursionStorage:
	CompilerInlineRecursion
	CompilerHeapIndirectedRecursion


enum CompilerConstructorSpace:
	CompilerOpenScalarSpace
	CompilerSequenceSpace
	CompilerClosedNominalSpace


pure func compiler_recursion_storage_of_name(name: String) -> CompilerRecursionStorage:
	match name:
		"Option":
			CompilerHeapIndirectedRecursion
		"List":
			CompilerHeapIndirectedRecursion
		"Dict":
			CompilerHeapIndirectedRecursion
		"Set":
			CompilerHeapIndirectedRecursion
		"Bytes":
			CompilerHeapIndirectedRecursion
		"Tensor":
			CompilerHeapIndirectedRecursion
		"Vector":
			CompilerHeapIndirectedRecursion
		"Matrix":
			CompilerHeapIndirectedRecursion
		"Channel":
			CompilerHeapIndirectedRecursion
		_:
			CompilerInlineRecursion


pure func compiler_is_stream_type_name(name: String) -> Bool:
	match name:
		"Stream":
			True
		"std_stream__Stream":
			True
		"std/stream::Stream":
			True
		_:
			False


pure func compiler_is_fallible_stream_type_name(name: String) -> Bool:
	match name:
		"FallibleStream":
			True
		"std_stream__FallibleStream":
			True
		"std/stream::FallibleStream":
			True
		_:
			False


pure func compiler_is_one_shot_stream_type_name(name: String) -> Bool:
	compiler_is_stream_type_name(name) or compiler_is_fallible_stream_type_name(name)


pure func compiler_is_resource_source_type_name(name: String) -> Bool:
	match name:
		"ResourceSource":
			True
		"std_stream__ResourceSource":
			True
		"std/stream::ResourceSource":
			True
		_:
			False


pure func compiler_is_heap_indirected_name(name: String) -> Bool:
	match compiler_recursion_storage_of_name(name):
		CompilerHeapIndirectedRecursion:
			True
		CompilerInlineRecursion:
			False


pure func compiler_primitive_home_for_name(name: String) -> Option[String]:
	match name:
		"Int":
			Some("std/int")
		"Int8":
			Some("std/int8")
		"Int16":
			Some("std/int16")
		"Int32":
			Some("std/int32")
		"Int64":
			Some("std/int64")
		"Int128":
			Some("std/int128")
		"UInt8":
			Some("std/uint8")
		"UInt16":
			Some("std/uint16")
		"UInt32":
			Some("std/uint32")
		"UInt64":
			Some("std/uint64")
		"UInt128":
			Some("std/uint128")
		"Float":
			Some("std/float")
		"Float32":
			Some("std/float32")
		"Float16":
			Some("std/float16")
		"Bool":
			Some("std/bool")
		"Char":
			Some("std/char")
		"String":
			Some("std/string")
		"StringSlice":
			Some("std/slice")
		"Bytes":
			Some("std/bytes")
		"Fixed":
			Some("std/fixed")
		"List":
			Some("std/list")
		"Dict":
			Some("std/dict")
		"Set":
			Some("std/set")
		"Tensor":
			Some("std/tensor")
		"Vector":
			Some("std/tensor")
		"Matrix":
			Some("std/tensor")
		"Option":
			Some("std/option")
		"Result":
			Some("std/result")
		_:
			empty: Option[String] = None
			empty


pure func compiler_primitive_home(typ: CompilerType) -> Option[String]:
	match typ:
		CompilerTupleType(_):
			Some("std/tuple")
		CompilerArrayType(_, _):
			Some("std/tensor")
		CompilerNamedType(name, _):
			compiler_primitive_home_for_name(name)
		_:
			result: Option[String] = None
			result


pure func compiler_is_struct_scalar_field_type(typ: CompilerType) -> Bool:
	match typ:
		CompilerNamedType(name, args):
			(
				(
					args.length() == 0
					and ((
						name == "Int"
						or name == "Float"
						or name == "Bool"
						or name == "Char"
						or name == "Ptr"
					))
				)
				or compiler_is_any_float_type(typ)
				or compiler_is_any_integer_type(typ)
			)
		_:
			False


private pure func compiler_has_native_operator_scalar_name(name: String) -> Bool:
	match name:
		"String":
			True
		"Bool":
			True
		"Char":
			True
		"Bytes":
			True
		"Fixed":
			True
		"Float":
			True
		"Float32":
			True
		"Float16":
			True
		_:
			False


private pure func compiler_has_builtin_to_string_scalar_name(name: String) -> Bool:
	match name:
		"String":
			True
		"Float":
			True
		"Float32":
			True
		"Float16":
			True
		"Bool":
			True
		"Char":
			True
		"Bytes":
			True
		"StringSlice":
			True
		"Url":
			True
		"Fixed":
			True
		_:
			False


private pure func compiler_is_open_scalar_name(name: String) -> Bool:
	match name:
		"Float":
			True
		"Float32":
			True
		"Float16":
			True
		"String":
			True
		"Char":
			True
		"Int":
			True
		"Int8":
			True
		"Int16":
			True
		"Int32":
			True
		"Int64":
			True
		"Int128":
			True
		"UInt8":
			True
		"UInt16":
			True
		"UInt32":
			True
		"UInt64":
			True
		"UInt128":
			True
		_:
			False


private pure func compiler_named_without_args_matches(
	predicate: pure (String) -> Bool,
	typ: CompilerType,
) -> Bool:
	match typ:
		CompilerNamedType(name, args):
			args.length() == 0 and predicate(name)
		_:
			False


private pure func compiler_is_tensor_storage_type(typ: CompilerType) -> Bool:
	match typ:
		CompilerArrayType(_, _):
			True
		CompilerNamedType(name, args):
			(name == "Tensor" or name == "Vector" or name == "Matrix") and args.length() >= 2
		_:
			False


private pure func compiler_is_list_type(typ: CompilerType) -> Bool:
	match typ:
		CompilerNamedType("List", _):
			True
		_:
			False


pure func compiler_has_native_operator_fast_path_type(typ: CompilerType) -> Bool:
	(
		compiler_is_tensor_storage_type(typ)
		or compiler_named_without_args_matches(compiler_has_native_operator_scalar_name, typ)
		or compiler_is_dim_type(typ)
		or compiler_is_any_integer_type(typ)
	)


pure func compiler_has_builtin_to_string_fallback_type(typ: CompilerType) -> Bool:
	(
		compiler_is_tensor_storage_type(typ)
		or compiler_named_without_args_matches(compiler_has_builtin_to_string_scalar_name, typ)
		or compiler_is_list_type(typ)
		or compiler_is_dim_type(typ)
		or compiler_is_any_integer_type(typ)
	)


pure func compiler_constructor_space_of_name(name: String) -> CompilerConstructorSpace:
	if name == "List":
		CompilerSequenceSpace
	else if compiler_is_open_scalar_name(name):
		CompilerOpenScalarSpace
	else:
		CompilerClosedNominalSpace


pure func compiler_is_open_exhaustiveness_scalar_name(name: String) -> Bool:
	match compiler_constructor_space_of_name(name):
		CompilerOpenScalarSpace:
			True
		CompilerSequenceSpace:
			False
		CompilerClosedNominalSpace:
			False
