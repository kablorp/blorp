import:
	compiler_type:
		CompilerType(CompilerArrayType, CompilerNamedType, CompilerTupleType),
		compiler_is_any_float_type,
		compiler_is_any_integer_type,
		compiler_is_dim_type,


enum CompilerRecursionStorage:
	CompilerInlineRecursion
	CompilerHeapIndirectedRecursion


enum CompilerConstructorSpace:
	CompilerOpenScalarSpace
	CompilerSequenceSpace
	CompilerClosedNominalSpace


private HEAP_INDIRECTED_NAMES: List[String] = [
	"Option",
	"List",
	"Dict",
	"Set",
	"Bytes",
	"Tensor",
	"Vector",
	"Matrix",
	"Channel",
]

private PRIMITIVE_HOMES: List[(String, String)] = [
	("Int", "std/int"),
	("Int8", "std/int8"),
	("Int16", "std/int16"),
	("Int32", "std/int32"),
	("Int64", "std/int64"),
	("Int128", "std/int128"),
	("UInt8", "std/uint8"),
	("UInt16", "std/uint16"),
	("UInt32", "std/uint32"),
	("UInt64", "std/uint64"),
	("UInt128", "std/uint128"),
	("Float", "std/float"),
	("Float32", "std/float32"),
	("Float16", "std/float16"),
	("Bool", "std/bool"),
	("Char", "std/char"),
	("String", "std/string"),
	("StringSlice", "std/slice"),
	("Bytes", "std/bytes"),
	("Fixed", "std/fixed"),
	("List", "std/list"),
	("Dict", "std/dict"),
	("Set", "std/set"),
	("Tensor", "std/tensor"),
	("Vector", "std/tensor"),
	("Matrix", "std/tensor"),
	("Option", "std/option"),
	("Result", "std/result"),
]

private NATIVE_OPERATOR_SCALAR_NAMES: List[String] = [
	"String",
	"Bool",
	"Char",
	"Bytes",
	"Fixed",
	"Float",
	"Float32",
	"Float16",
]

private BUILTIN_TO_STRING_SCALAR_NAMES: List[String] = [
	"String",
	"Float",
	"Float32",
	"Float16",
	"Bool",
	"Char",
	"Bytes",
	"StringSlice",
	"Url",
	"Fixed",
]

private OPEN_SCALAR_NAMES: List[String] = [
	"Float",
	"Float32",
	"Float16",
	"String",
	"Char",
	"Int",
	"Int8",
	"Int16",
	"Int32",
	"Int64",
	"Int128",
	"UInt8",
	"UInt16",
	"UInt32",
	"UInt64",
	"UInt128",
]


pure func compiler_recursion_storage_of_name(name: String) -> CompilerRecursionStorage:
	if HEAP_INDIRECTED_NAMES.contains(name):
		CompilerHeapIndirectedRecursion
	else:
		CompilerInlineRecursion


pure func compiler_is_heap_indirected_name(name: String) -> Bool:
	compiler_recursion_storage_of_name(name) == CompilerHeapIndirectedRecursion


pure func compiler_primitive_home_for_name(name: String) -> Option[String]:
	var result: Option[String] = None

	for entry in PRIMITIVE_HOMES:
		if entry[0] == name:
			result = Some(entry[1])
			break

	result


pure func compiler_primitive_home(typ: CompilerType) -> Option[String]:
	match typ:
		CompilerTupleType(_):
			Some("std/tuple")
		CompilerArrayType(_, _):
			Some("std/tensor")
		CompilerNamedType(name, _):
			compiler_primitive_home_for_name(name)
		_:
			None


pure func compiler_is_struct_scalar_field_type(typ: CompilerType) -> Bool:
	match typ:
		CompilerNamedType(name, args):
			(
				(
					args.length() == 0
					and ((
						name == "Int"
						or name == "Float"
						or name == "Bool"
						or name == "Char"
						or name == "Ptr"
					))
				)
				or compiler_is_any_float_type(typ)
				or compiler_is_any_integer_type(typ)
			)
		_:
			False


private pure func compiler_named_without_args_is(names: List[String], typ: CompilerType) -> Bool:
	match typ:
		CompilerNamedType(name, args):
			args.length() == 0 and names.contains(name)
		_:
			False


private pure func compiler_is_tensor_storage_type(typ: CompilerType) -> Bool:
	match typ:
		CompilerArrayType(_, _):
			True
		CompilerNamedType(name, args):
			(name == "Tensor" or name == "Vector" or name == "Matrix") and args.length() >= 2
		_:
			False


private pure func compiler_is_list_type(typ: CompilerType) -> Bool:
	match typ:
		CompilerNamedType("List", _):
			True
		_:
			False


pure func compiler_has_native_operator_fast_path_type(typ: CompilerType) -> Bool:
	(
		compiler_is_tensor_storage_type(typ)
		or compiler_named_without_args_is(NATIVE_OPERATOR_SCALAR_NAMES, typ)
		or compiler_is_dim_type(typ)
		or compiler_is_any_integer_type(typ)
	)


pure func compiler_has_builtin_to_string_fallback_type(typ: CompilerType) -> Bool:
	(
		compiler_is_tensor_storage_type(typ)
		or compiler_named_without_args_is(BUILTIN_TO_STRING_SCALAR_NAMES, typ)
		or compiler_is_list_type(typ)
		or compiler_is_dim_type(typ)
		or compiler_is_any_integer_type(typ)
	)


pure func compiler_constructor_space_of_name(name: String) -> CompilerConstructorSpace:
	if name == "List":
		CompilerSequenceSpace
	else if OPEN_SCALAR_NAMES.contains(name):
		CompilerOpenScalarSpace
	else:
		CompilerClosedNominalSpace


pure func compiler_is_open_exhaustiveness_scalar_name(name: String) -> Bool:
	compiler_constructor_space_of_name(name) == CompilerOpenScalarSpace
