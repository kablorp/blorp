-- Pure JSON protocol definitions for the OCaml-to-Blorp compiler bridge.
--
-- The command runner is intentionally not here. This module owns only the
-- stable envelope, action names, response shape, and validation helpers that
-- future Blorp-owned compiler stages will consume.
import:
	json:
		JsonValue(JsonBool, JsonNull, JsonNumber, JsonObject, JsonString, JsonVector),
		as_number,
		as_string,
		get_field,
		parse_json,


BRIDGE_SCHEMA_VERSION: Int = 1

BRIDGE_DOMAIN: String = "compiler"


enum BridgeAction:
	RenderAction
	RenderManyAction
	EmitCAction
	PrepareAndEmitCAction
	RunCorePipelineAction
	LowerAndCompileAction
	TypecheckAndCompileAction
	CompileSourceAction


record BridgeEnvelope {
	schema: Int,
	domain: String,
	action: BridgeAction,
	action_name: String,
	payload: JsonValue
}


union BridgeProtocolError:
	InvalidJson(String)
	MissingField(String)
	ExpectedField(String, String)
	UnsupportedSchema(Int)
	UnsupportedDomain(String)
	UnsupportedAction(String)


pure func bridge_action_name(action: BridgeAction) -> String:
	match action:
		RenderAction:
			"render"
		RenderManyAction:
			"render_many"
		EmitCAction:
			"emit_c"
		PrepareAndEmitCAction:
			"prepare_and_emit_c"
		RunCorePipelineAction:
			"run_core_pipeline"
		LowerAndCompileAction:
			"lower_and_compile"
		TypecheckAndCompileAction:
			"typecheck_and_compile"
		CompileSourceAction:
			"compile_source"


pure func parse_bridge_action(name: String) -> Result[BridgeAction, BridgeProtocolError]:
	match name:
		"render":
			Ok(RenderAction)
		"render_many":
			Ok(RenderManyAction)
		"emit_c":
			Ok(EmitCAction)
		"prepare_and_emit_c":
			Ok(PrepareAndEmitCAction)
		"run_core_pipeline":
			Ok(RunCorePipelineAction)
		"lower_and_compile":
			Ok(LowerAndCompileAction)
		"typecheck_and_compile":
			Ok(TypecheckAndCompileAction)
		"compile_source":
			Ok(CompileSourceAction)
		_:
			Err(UnsupportedAction(name))


private pure func field(value: JsonValue, key: String) -> Result[JsonValue, BridgeProtocolError]:
	match get_field(value, key):
		Some(child):
			Ok(child)
		None:
			Err(MissingField(key))


private pure func string_field(
	value: JsonValue,
	key: String,
) -> Result[String, BridgeProtocolError]:
	child ?= field(value, key)

	match as_string(child):
		Some(text):
			Ok(text)
		None:
			Err(ExpectedField(key, "a string"))


private pure func int_field(value: JsonValue, key: String) -> Result[Int, BridgeProtocolError]:
	child ?= field(value, key)

	match as_number(child):
		Some(number):
			Ok(to_int(number))
		None:
			Err(ExpectedField(key, "a number"))


private pure func payload_field(value: JsonValue) -> Result[JsonValue, BridgeProtocolError]:
	payload ?= field(value, "payload")

	match payload:
		JsonObject(fields):
			Ok(JsonObject(fields))
		JsonNull:
			Err(ExpectedField("payload", "an object"))
		JsonBool(flag):
			Err(ExpectedField("payload", "an object"))
		JsonNumber(number):
			Err(ExpectedField("payload", "an object"))
		JsonString(text):
			Err(ExpectedField("payload", "an object"))
		JsonVector(items):
			Err(ExpectedField("payload", "an object"))


pure func decode_bridge_envelope_value(
	value: JsonValue,
) -> Result[BridgeEnvelope, BridgeProtocolError]:
	schema ?= int_field(value, "schema")

	if schema != BRIDGE_SCHEMA_VERSION:
		Err(UnsupportedSchema(schema))
	else:
		domain ?= string_field(value, "domain")

		if domain != BRIDGE_DOMAIN:
			Err(UnsupportedDomain(domain))
		else:
			action_name ?= string_field(value, "action")
			action ?= parse_bridge_action(action_name)
			payload ?= payload_field(value)
			Ok({
				schema = schema,
				domain = domain,
				action = action,
				action_name = action_name,
				payload = payload,
			})


pure func decode_bridge_envelope(source: String) -> Result[BridgeEnvelope, BridgeProtocolError]:
	match parse_json(source):
		Ok(value):
			decode_bridge_envelope_value(value)
		Err(message):
			Err(InvalidJson(message))


pure func bridge_protocol_error_code(error: BridgeProtocolError) -> String:
	match error:
		InvalidJson(_):
			"invalid_json"
		MissingField(_):
			"invalid_request"
		ExpectedField(_, _):
			"invalid_request"
		UnsupportedSchema(_):
			"unsupported_schema"
		UnsupportedDomain(_):
			"unsupported_domain"
		UnsupportedAction(_):
			"unsupported_action"


pure func bridge_protocol_error_message(error: BridgeProtocolError) -> String:
	match error:
		InvalidJson(message):
			message
		MissingField(field_name):
			"missing bridge field: " + field_name
		ExpectedField(field_name, expected):
			"bridge field `" + field_name + "` must be " + expected
		UnsupportedSchema(schema):
			"unsupported Blorp bridge schema: " + schema.to_string()
		UnsupportedDomain(domain):
			"unsupported Blorp bridge domain: " + domain
		UnsupportedAction(action):
			"unsupported Blorp bridge action: " + action


private pure func schema_json() -> JsonValue:
	JsonNumber(to_float(BRIDGE_SCHEMA_VERSION))


pure func bridge_success_json(artifact: JsonValue) -> JsonValue:
	JsonObject([
		("schema", schema_json()),
		("ok", JsonBool(True)),
		("artifact", artifact),
	])


pure func bridge_error_json(error: BridgeProtocolError) -> JsonValue:
	JsonObject([("schema", schema_json()), ("ok", JsonBool(False)), ("error", JsonObject([
				("code", JsonString(bridge_protocol_error_code(error))),
				("message", JsonString(bridge_protocol_error_message(error))),
			]))])


pure func bridge_success_response(artifact: JsonValue) -> String:
	bridge_success_json(artifact).to_string()


pure func bridge_error_response(error: BridgeProtocolError) -> String:
	bridge_error_json(error).to_string()
