-- Blorp-owned `blorp format` command runner.
--
-- OCaml remains the process shell for now, but this module owns the format
-- command behavior: CLI parsing, file walking, parsing, comment collection,
-- rendering, check/diff output, and writes.
import:
	../../../../tools/formatter/declaration_documents: FormatterComment
	../stage_01_file_io/compiler_source: CompilerSourceFile, compiler_source_file
	../stage_02_lex/compiler_lexer: compiler_lex
	../stage_02_lex/compiler_token: CompilerToken, CompilerTrivia, CompilerTriviaKind(CommentTrivia)
	../stage_03_parse/compiler_parser: parse_compiler_source
	../stage_12_cli/compiler_cli_args:
		CliAction(CliError, CliFormat),
		CliFormatAction(CliFormatEmitProgramJson, CliFormatFiles, CliFormatHelp),
		CliFormatFilesArgs,
		CliFormatMode(CliFormatCheck, CliFormatCheckDiff, CliFormatWrite),
		parse_cli_args,
	compiler_format_projection: render_parsed_program
	fs:
		DirectoryEntry,
		message,
		open_dir,
		open_read,
		open_write,
		read_next_entries,
		read_text,
		write_text,
	path: join, stem
	system: is_directory


private DEFAULT_FORMAT_WIDTH: Int = 100

private DIRECTORY_READ_BATCH_SIZE: Int = 128

private MAX_DIFFS: Int = 5


record FormatCommandResult {
	status: Int,
	stdout: String,
	stderr: String
}


record FormatOneResult {
	status: Int,
	stdout: String
}


private FORMAT_USAGE: String =
	|Usage: blorp format [options] <file.brp|dir>
	|
	|Options:
	|  --check        Check if file is formatted (exit 1 if not)
	|  --diff         Show diff for unformatted files (implies --check)
	|
	|Accepts files or directories (recursively finds .brp files).


private pure func result(status: Int, stdout: String, stderr: String) -> FormatCommandResult:
	{
		status = status,
		stdout = stdout,
		stderr = stderr
	}


private pure func ok(stdout: String) -> FormatCommandResult:
	result(0, stdout, "")


private pure func error(message: String) -> FormatCommandResult:
	result(1, "", message + "\n")


private func read_text_file(path: String) -> Result[String, String]:
	with reader ?= open_read(path) on err => message(err):
		match reader.read_text():
			Ok(source):
				Ok(source)
			Err(err):
				Err(message(err))


private func write_text_file(path: String, content: String) -> Result[Void, String]:
	with writer ?= open_write(path) on err => message(err):
		match writer.write_text(content):
			Ok(_):
				Ok(void)
			Err(err):
				Err(message(err))


private pure func is_blorp_file(path: String) -> Bool:
	path.ends_with(".brp")


private func read_directory_entries(path: String) -> Result[List[DirectoryEntry], String]:
	with dir ?= open_dir(path) on err => message(err):
		var entries: List[DirectoryEntry] = []
		var done: Bool = False
		var read_error: Option[String] = None

		while not done:
			match read_next_entries(dir, DIRECTORY_READ_BATCH_SIZE):
				Ok(batch):
					if batch.length() == 0:
						done = True
					else:
						for entry in batch:
							entries = entries.append(entry)
				Err(err):
					read_error = Some(message(err))
					done = True

		match read_error:
			Some(msg):
				Err(msg)
			None:
				Ok(entries.sort_by(
					func(entry: DirectoryEntry): entry.name,
				))


private func collect_brp_files(path_value: String) -> Result[List[String], String]:
	if is_directory(path_value):
		entries ?= read_directory_entries(path_value)
		var files: List[String] = []
		var failed: Option[String] = None

		for entry in entries:
			if failed.is_none():
				full_path: String = path_value.join(entry.name)

				match collect_brp_files(full_path):
					Ok(child_files):
						for child in child_files:
							files = files.append(child)
					Err(message):
						failed = Some(message)

		match failed:
			Some(message):
				Err(message)
			None:
				Ok(files)
	else if is_blorp_file(path_value):
		Ok([path_value])
	else:
		Ok([])


private func collect_all_brp_files(paths: List[String]) -> Result[List[String], String]:
	var files: List[String] = []
	var failed: Option[String] = None

	for path_value in paths:
		if failed.is_none():
			match collect_brp_files(path_value):
				Ok(collected):
					for file in collected:
						files = files.append(file)
				Err(message):
					failed = Some(message)

	match failed:
		Some(message):
			Err(message)
		None:
			Ok(files)


private pure func formatter_comment(trivia: CompilerTrivia, trailing: Bool) -> FormatterComment:
	{
		text_value = trivia.text,
		line = trivia.span.start_line,
		column = trivia.span.start_column,
		trailing = trailing
	}


private pure func append_comment_trivia(
	comments: List[FormatterComment],
	trivia: List[CompilerTrivia],
	trailing: Bool,
) -> List[FormatterComment]:
	var result_comments: List[FormatterComment] = comments

	for item in trivia:
		if item.kind == CommentTrivia:
			result_comments = result_comments.append(formatter_comment(item, trailing))

	result_comments


private pure func token_comments(token: CompilerToken) -> List[FormatterComment]:
	append_comment_trivia(
		append_comment_trivia([], token.leading_trivia, False),
		token.trailing_trivia,
		True,
	)


private pure func source_comments(source: CompilerSourceFile) -> List[FormatterComment]:
	lex_result = compiler_lex(source)
	var comments: List[FormatterComment] = []

	for token in lex_result.tokens:
		for comment in token_comments(token):
			comments = comments.append(comment)

	comments


private pure func source_module_name(path_value: String) -> String:
	stem(path_value)


private pure func render_source(path_value: String, source: String) -> Result[String, String]:
	source_file: CompilerSourceFile = compiler_source_file(
		path_value,
		source_module_name(path_value),
		source,
	)
	program = parse_compiler_source(source_file)
	render_parsed_program(DEFAULT_FORMAT_WIDTH, program, source_comments(source_file))


private pure func pad4(value: Int) -> String:
	text: String = value.to_string()

	if text.length() >= 4:
		text
	else if text.length() == 3:
		" " + text
	else if text.length() == 2:
		"  " + text
	else:
		"   " + text


private pure func diff_line(line_number: Int, marker: String, text: String) -> String:
	"  " + pad4(line_number) + " | " + marker + text + "\n"


private pure func compute_diff(source: String, formatted: String) -> String:
	source_lines: List[String] = source.split("\n")
	formatted_lines: List[String] = formatted.split("\n")

	min_len: Int = if source_lines.length() < formatted_lines.length():
		source_lines.length()
	else:
		formatted_lines.length()

	var output: String = ""
	var diffs_shown: Int = 0
	var last_shown: Int = 0 - 10
	var i: Int = 0

	while i < min_len and diffs_shown < MAX_DIFFS:
		source_line: String = source_lines
			.get(i)
			.get_or("")
		formatted_line: String = formatted_lines
			.get(i)
			.get_or("")

		if source_line != formatted_line:
			if i > 0 and i - 1 > last_shown:
				output += diff_line(
					i,
					" ",
					source_lines
						.get(i - 1)
						.get_or(""),
				)

			output += diff_line(i + 1, "-", source_line)
			output += diff_line(i + 1, "+", formatted_line)
			last_shown = i
			diffs_shown += 1

		i += 1

	i = min_len

	while i < source_lines.length() and diffs_shown < MAX_DIFFS:
		output += diff_line(
			i + 1,
			"-",
			source_lines
				.get(i)
				.get_or(""),
		)
		diffs_shown += 1
		i += 1

	i = min_len

	while i < formatted_lines.length() and diffs_shown < MAX_DIFFS:
		output += diff_line(
			i + 1,
			"+",
			formatted_lines
				.get(i)
				.get_or(""),
		)
		diffs_shown += 1
		i += 1

	if diffs_shown >= MAX_DIFFS:
		output += "  ... (more differences)\n"

	output


private func format_one_file(
	path_value: String,
	mode: CliFormatMode,
) -> Result[FormatOneResult, String]:
	source ?= read_text_file(
		path_value,
	).map_err(
		func(message): path_value + ": File error: " + message,
	)
	rendered ?= render_source(path_value, source).map_err(func(message): message)

	if source == rendered:
		match mode:
			CliFormatWrite:
				Ok({
					status = 0,
					stdout = "",
				})
			CliFormatCheck:
				Ok({
					status = 0,
					stdout = path_value + ": ok\n",
				})
			CliFormatCheckDiff:
				Ok({
					status = 0,
					stdout = path_value + ": ok\n",
				})
	else:
		match mode:
			CliFormatWrite:
				match write_text_file(path_value, rendered):
					Ok(_):
						Ok({
							status = 0,
							stdout = "",
						})
					Err(message):
						Err(path_value + ": File error: " + message)
			CliFormatCheck:
				Ok({
					status = 1,
					stdout = path_value + ": needs formatting\n",
				})
			CliFormatCheckDiff:
				Ok({
					status = 1,
					stdout = path_value + ": needs formatting\n" + compute_diff(source, rendered),
				})


private func format_files(args: CliFormatFilesArgs) -> FormatCommandResult:
	match collect_all_brp_files(args.paths):
		Err(message):
			error(message)
		Ok(files):
			if files.length() == 0:
				error("Error: no .brp files found")
			else:
				var stdout: String = ""
				var status: Int = 0
				var failed: Option[String] = None

				for file in files:
					if failed.is_none():
						match format_one_file(file, args.mode):
							Ok(file_result):
								stdout += file_result.stdout

								if file_result.status != 0:
									status = file_result.status
							Err(message):
								failed = Some(message)

				match failed:
					Some(message):
						error(message)
					None:
						result(status, stdout, "")


func run_format_command(user_args: List[String]) -> FormatCommandResult:
	action: CliAction = parse_cli_args(["format"].concat(user_args))

	match action:
		CliError(message):
			error(message)
		CliFormat(format_action):
			match format_action:
				CliFormatHelp:
					ok("${FORMAT_USAGE}\n")
				CliFormatEmitProgramJson(_):
					error("--emit-program-json is no longer supported by the Blorp formatter")
				CliFormatFiles(args):
					format_files(args)
		_:
			error("Error: expected format command")
