private pure func type_param_name(param: ParsedTypeParamDecl) -> String:
	if param.bounds.length() == 0:
		param.name.text
	else:
		var bounds: List[String] = []

		for bound in param.bounds:
			bounds = bounds.append(bound.text)

		param.name.text + ":" + bounds.join("+")


private pure func type_param_names(params: List[ParsedTypeParamDecl]) -> List[String]:
	params.map(func(param): type_param_name(param))


private pure func option_type_expr(value: Option[ParsedTypeExpr]) -> Option[TypeExpression]:
	match value:
		Some(type_expr):
			Some(project_type_expr(type_expr))
		None:
			None


private pure func project_dim_op(op: ParsedDimBinaryOp) -> TypeDimensionOperator:
	match op:
		ParsedDimAddOp:
			TypeDimensionAdd
		ParsedDimSubtractOp:
			TypeDimensionSub
		ParsedDimMultiplyOp:
			TypeDimensionMul
		ParsedDimDivideOp:
			TypeDimensionDiv


pure func project_type_expr(type_expr: ParsedTypeExpr) -> TypeExpression:
	match type_expr:
		ParsedNamedType(name, args, _):
			var projected_args: List[TypeExpression] = []

			for arg in args:
				projected_args = projected_args.append(project_type_expr(arg))

			if name.text == "Self" and projected_args.length() == 0:
				SelfType
			else:
				NamedType(name.text, projected_args)
		ParsedQualifiedNamedType(module_name, name, args, _):
			var projected_args: List[TypeExpression] = []

			for arg in args:
				projected_args = projected_args.append(project_type_expr(arg))

			NamedType(module_name.text + "." + name.text, projected_args)
		ParsedBoundedType(name, bounds, _):
			var bound_names: List[String] = []

			for bound in bounds:
				bound_names = bound_names.append(bound.text)

			BoundVarType(name.text + ":" + bound_names.join("+"))
		ParsedDimNameType(name, is_variadic, _):
			if is_variadic:
				VarDimsType(name.text)
			else:
				VarType(name.text)
		ParsedDimLiteralType(value, _):
			ConstIntType(
				value
					.parse_int()
					.get_or(0),
			)
		ParsedDimBinaryType(op, left, right, _):
			DimensionOperationType(
				project_dim_op(op),
				project_type_expr(left),
				project_type_expr(right),
			)
		ParsedRangeType(limit, _):
			RangeType(project_type_expr(limit))
		ParsedTupleType(elems, _):
			var projected: List[TypeExpression] = []

			for elem in elems:
				projected = projected.append(project_type_expr(elem))

			TupleType(projected)
		ParsedFunctionType(is_pure, params, return_type, _):
			var projected_params: List[TypeExpression] = []

			for param in params:
				projected_params = projected_params.append(project_type_expr(param))

			FuncType(is_pure, projected_params, project_type_expr(return_type))
		ParsedArrayType(elem, dims, _):
			var projected_dims: List[TypeExpression] = []

			for dim in dims:
				projected_dims = projected_dims.append(project_type_expr(dim))

			ArrayType(project_type_expr(elem), projected_dims)
		ParsedMissingType(_):
			NamedType("?", [])


private pure func project_dim_constraint(constraint: ParsedDimConstraint) -> TypeConstraint:
	{
		left = project_type_expr(constraint.left),
		right = project_type_expr(constraint.right)
	}


private pure func project_dim_constraints(
	constraints: List[ParsedDimConstraint],
) -> List[TypeConstraint]:
	var projected: List[TypeConstraint] = []

	for constraint in constraints:
		projected = projected.append(project_dim_constraint(constraint))

	projected


private pure func string_flags(form: ParsedStringLiteralForm) -> StringFlags:
	match form:
		ParsedPlainStringLiteral:
			{
				raw = False,
				multiline = False
			}
		ParsedRawStringLiteral:
			{
				raw = True,
				multiline = False
			}
		ParsedPipeStringLiteral:
			{
				raw = False,
				multiline = True
			}
		ParsedRawPipeStringLiteral:
			{
				raw = True,
				multiline = True
			}


private pure func int_literal(raw: String) -> Literal:
	match raw.parse_int():
		Some(_):
			IntLiteral(raw)
		None:
			Int128Literal(raw)


private pure func project_literal_string(value: String, form: ParsedStringLiteralForm) -> Literal:
	StringLiteral(value, string_flags(form))


private pure func project_unary_op(op: ParsedUnaryOp) -> UnaryOp:
	match op:
		ParsedNegateOp:
			NegOp
		ParsedNotOp:
			NotOp


private pure func project_binary_op(op: ParsedBinaryOp) -> BinaryOp:
	match op:
		ParsedAddOp:
			AddOp
		ParsedSubtractOp:
			SubOp
		ParsedMultiplyOp:
			MulOp
		ParsedDivideOp:
			DivOp
		ParsedModuloOp:
			ModOp
		ParsedLessOp:
			LtOp
		ParsedGreaterOp:
			GtOp
		ParsedLessEqualOp:
			LeOp
		ParsedGreaterEqualOp:
			GeOp
		ParsedEqualOp:
			EqOp
		ParsedNotEqualOp:
			NeOp


private pure func project_compound_assign_op(op: ParsedCompoundAssignOp) -> BinaryOp:
	match op:
		ParsedAssignAddOp:
			AddOp
		ParsedAssignSubtractOp:
			SubOp
		ParsedAssignMultiplyOp:
			MulOp
		ParsedAssignDivideOp:
			DivOp


private pure func project_logical_op(op: ParsedLogicalOp) -> LogicalOp:
	match op:
		ParsedAndOp:
			AndOp
		ParsedOrOp:
			OrOp


private pure func project_pattern(pattern: ParsedPattern) -> Pattern:
	match pattern:
		ParsedWildcardPattern(_):
			WildcardPattern
		ParsedNamePattern(name):
			VarPattern(name.text)
		ParsedIntPattern(value, _):
			LiteralPattern(int_literal(value))
		ParsedFloatPattern(value, _):
			LiteralPattern(FloatLiteral(value))
		ParsedStringPattern(value, form, _):
			LiteralPattern(project_literal_string(value, form))
		ParsedCharPattern(value, _):
			LiteralPattern(CharLiteral(value))
		ParsedBoolPattern(value, _):
			LiteralPattern(BoolLiteral(value))
		ParsedConstructorPattern(name, args, _):
			var projected: List[Pattern] = []

			for arg in args:
				projected = projected.append(project_pattern(arg))

			ConstructorPattern(name.text, projected)
		ParsedQualifiedConstructorPattern(module_name, name, args, _):
			var projected: List[Pattern] = []

			for arg in args:
				projected = projected.append(project_pattern(arg))

			QualifiedPattern(module_name.text, name.text, projected)
		ParsedTuplePattern(items, _):
			var projected: List[Pattern] = []

			for item in items:
				projected = projected.append(project_pattern(item))

			TuplePattern(projected)
		ParsedListPattern(items, spread, _):
			var projected: List[Pattern] = []

			for item in items:
				projected = projected.append(project_pattern(item))

			match spread:
				Some(ParsedListSpreadName(name)):
					ListSpreadPattern(projected, VarPattern(name.text))
				Some(ParsedListSpreadWildcard(_)):
					ListSpreadPattern(projected, WildcardPattern)
				None:
					ListPattern(projected)
		ParsedOrPattern(items, _):
			var projected: List[Pattern] = []

			for item in items:
				projected = projected.append(project_pattern(item))

			OrPattern(projected)
		ParsedMissingPattern(_):
			WildcardPattern


private pure func project_param(param: ParsedParam) -> FunctionParameter:
	match (param.binder, param.type_expr):
		(ParsedParamNameBinder(name), Some(type_expr)):
			TypedNameParam(name.text, project_type_expr(type_expr))
		(ParsedParamNameBinder(name), None):
			NameParam(name.text)
		(ParsedParamWildcardBinder(_), Some(type_expr)):
			TypedNameParam("_", project_type_expr(type_expr))
		(ParsedParamWildcardBinder(_), None):
			NameParam("_")
		(ParsedParamTupleBinder(names, _), Some(type_expr)):
			var patterns: List[Pattern] = []

			for name in names:
				patterns = patterns.append(VarPattern(name.text))

			TypedPatternParam(TuplePattern(patterns), project_type_expr(type_expr))
		(ParsedParamTupleBinder(names, _), None):
			var patterns: List[Pattern] = []

			for name in names:
				patterns = patterns.append(VarPattern(name.text))

			PatternParam(TuplePattern(patterns))


private pure func project_params(params: List[ParsedParam]) -> List[FunctionParameter]:
	params.map(func(param): project_param(param))


private pure func project_lambda_param(param: ParsedLambdaParam) -> FunctionParameter:
	match param.type_expr:
		Some(type_expr):
			TypedNameParam(param.name.text, project_type_expr(type_expr))
		None:
			NameParam(param.name.text)


record BlockCommentCollect {
	items: List[BlockItem],
	previous_end: Int
}


private pure func append_leading_block_comments(
	items: List[BlockItem],
	comments: List[FormatterComment],
	previous_end: Int,
	before_line: Int,
	min_column: Int,
) -> BlockCommentCollect:
	var result: List[BlockItem] = items
	var last_line: Int = previous_end

	for comment in comments:
		if (
			not comment.trailing
			and comment.line >= last_line
			and comment.line <= before_line
			and comment.column >= min_column
		):
			result = result.append(
				BlockCommentItem(
					comment.line - last_line > 1,
					comment.text_value,
				),
			)
			last_line = comment.line

	{
		items = result,
		previous_end = last_line
	}


private pure func trailing_comment_on_line(
	comments: List[FormatterComment],
	line: Int,
) -> Option[String]:
	var result: Option[String] = None

	for comment in comments:
		if (
			result.is_none()
			and comment.trailing
			and comment.line == line
		):
			result = Some(comment.text_value)

	result


private pure func trailing_comment_for_expr(
	comments: List[FormatterComment],
	span: CompilerSourceSpan,
) -> Option[String]:
	if span.start_line == span.end_line:
		trailing_comment_on_line(comments, span.end_line)
	else:
		None


private pure func block_item_trailing_comment(
	expr: ParsedExpr,
	comments: List[FormatterComment],
) -> Option[String]:
	match expr:
		ParsedBlockExpr(_, _):
			None
		ParsedIfExpr(_, _, _, _):
			None
		ParsedMatchExpr(_, _, _):
			None
		ParsedSelectExpr(_, _):
			None
		ParsedWithExpr(_, _, _):
			None
		ParsedDebugBlockExpr(_, _):
			None
		ParsedFunctionDeclExpr(_):
			None
		ParsedWhileExpr(_, _, _):
			None
		ParsedForExpr(_, _, _, _):
			None
		ParsedConcurrentBlockExpr(_, _, _):
			None
		ParsedConcurrentForExpr(_, _, _, _, _):
			None
		_:
			trailing_comment_for_expr(comments, parsed_expr_span(expr))


private pure func block_has_comments(
	span: CompilerSourceSpan,
	comments: List[FormatterComment],
) -> Bool:
	var found: Bool = False

	for comment in comments:
		if comment.line >= span.start_line - 1 and comment.line <= span.end_line:
			found = True
			break

	found


private pure func block_comment_column(exprs: List[ParsedExpr]) -> Int:
	match exprs.get(0):
		Some(expr):
			parsed_expr_span(expr).start_column
		None:
			0


private pure func has_leading_comment_on_line(
	comments: List[FormatterComment],
	line: Int,
	min_column: Int,
) -> Bool:
	var found: Bool = False

	for comment in comments:
		if (
			not comment.trailing
			and comment.line == line
			and comment.column >= min_column
		):
			found = True
			break

	found


private pure func initial_block_previous_end(
	exprs: List[ParsedExpr],
	comments: List[FormatterComment],
	min_column: Int,
	span: CompilerSourceSpan,
) -> Int:
	first_line: Int = match exprs.get(0):
		Some(expr):
			parsed_expr_span(expr).start_line
		None:
			span.start_line

	var start_line: Int = first_line
	var scanning: Bool = True

	while scanning:
		if has_leading_comment_on_line(comments, start_line - 1, min_column):
			start_line -= 1
		else:
			scanning = False

	start_line - 1


private pure func parsed_block_items(exprs: List[ParsedExpr]) -> List[Expression]:
	exprs.map(func(expr): project_expr(expr))


private pure func span_end_line(span: CompilerSourceSpan) -> Int:
	if span.end_line > span.start_line:
		span.end_line
	else:
		span.start_line


private pure func expr_end_line(expr: ParsedExpr) -> Int:
	span_end_line(parsed_expr_span(expr))


private pure func block_blank_before(exprs: List[ParsedExpr]) -> List[Bool]:
	var flags: List[Bool] = []
	var previous_end: Option[Int] = None

	for expr in exprs:
		line: Int = parsed_expr_span(expr).start_line

		blank: Bool = match previous_end:
			Some(prev):
				line - prev > 1
			None:
				False

		flags = flags.append(blank)
		previous_end = Some(expr_end_line(expr))

	flags


private pure func any_true(values: List[Bool]) -> Bool:
	var found: Bool = False

	for value in values:
		if value:
			found = True
			break

	found


private pure func spaced_block_expr(exprs: List[ParsedExpr]) -> Expression:
	projected: List[Expression] = parsed_block_items(exprs)
	flags: List[Bool] = block_blank_before(exprs)

	if any_true(flags):
		var items: List[(Bool, Expression)] = []
		var index: Int = 0

		for expr in projected:
			items = items.append(
				(
					flags
						.get(index)
						.get_or(False),
					expr,
				),
			)
			index += 1

		SpacedBlockExpression(items)
	else:
		BlockExpression(projected)


private pure func commented_block_expr(
	exprs: List[ParsedExpr],
	comments: List[FormatterComment],
	span: CompilerSourceSpan,
) -> Expression:
	if not block_has_comments(span, comments):
		spaced_block_expr(exprs)
	else:
		var items: List[BlockItem] = []
		block_column: Int = block_comment_column(exprs)
		var previous_end: Int = initial_block_previous_end(exprs, comments, block_column, span)

		for expr in exprs:
			expr_span: CompilerSourceSpan = parsed_expr_span(expr)
			leading: BlockCommentCollect = append_leading_block_comments(
				items,
				comments,
				previous_end,
				expr_span.start_line,
				block_column,
			)
			items = leading.items
			previous_end = leading.previous_end

			items = items.append(
				BlockExpressionItem(
					expr_span.start_line - previous_end > 1,
					project_expr_with_comments(expr, comments),
					block_item_trailing_comment(expr, comments),
				),
			)
			previous_end = expr_end_line(expr)

		after_body: BlockCommentCollect = append_leading_block_comments(
			items,
			comments,
			previous_end,
			span.end_line,
			block_column,
		)
		ItemBlockExpression(after_body.items)


private pure func block_exprs_for_concurrent(
	body: ParsedExpr,
	comments: List[FormatterComment],
) -> List[Expression]:
	match body:
		ParsedBlockExpr(items, _):
			var projected: List[Expression] = []

			for item in items:
				projected = projected.append(project_expr_with_comments(item, comments))

			projected
		_:
			[project_expr_with_comments(body, comments)]


private pure func project_record_expr_fields(
	fields: List[ParsedRecordExprField],
) -> List[(String, Expression)]:
	var projected: List[(String, Expression)] = []

	for field in fields:
		projected = projected.append((field.name.text, project_expr(field.value)))

	projected


private pure func project_dict_entries(
	entries: List[ParsedDictEntry],
) -> List[(Expression, Expression)]:
	var projected: List[(Expression, Expression)] = []

	for entry in entries:
		projected = projected.append((project_expr(entry.key), project_expr(entry.value)))

	projected


private pure func project_match_cases(
	cases: List[ParsedMatchCase],
	comments: List[FormatterComment],
) -> List[MatchCase]:
	var projected: List[MatchCase] = []

	for case_value in cases:
		projected = projected.append(
			MatchCaseData(
				project_pattern(case_value.pattern),
				project_expr_with_comments(case_value.body, comments),
				None,
			),
		)

	projected


private pure func project_select_arm(
	arm: ParsedSelectArm,
	comments: List[FormatterComment],
) -> SelectArm:
	body: Expression = project_expr_with_comments(arm.body, comments)

	match arm.kind:
		ParsedSelectReceiveArm(name, channel):
			SelectRecvArm(
				name.text,
				project_expr_with_comments(channel, comments),
				body,
			)
		ParsedSelectAfterArm(timeout):
			SelectAfterArm(
				project_expr_with_comments(timeout, comments),
				body,
			)
		ParsedSelectSealedArm(channel):
			SelectSealedArm(
				project_expr_with_comments(channel, comments),
				body,
			)


private pure func project_select_arms(
	arms: List[ParsedSelectArm],
	comments: List[FormatterComment],
) -> List[SelectArm]:
	var projected: List[SelectArm] = []

	for arm in arms:
		projected = projected.append(project_select_arm(arm, comments))

	projected


private pure func project_for_binder_name(binder: ParsedForBinder) -> Option[String]:
	match binder:
		ParsedForNameBinder(name):
			Some(name.text)
		ParsedForTupleBinder(_, _):
			None


private pure func project_for_binder_names(binder: ParsedForBinder) -> List[String]:
	match binder:
		ParsedForNameBinder(name):
			[name.text]
		ParsedForTupleBinder(names, _):
			var projected: List[String] = []

			for name in names:
				projected = projected.append(name.text)

			projected


private pure func annotation_present(
	annotations: List[ParsedFunctionAnnotation],
	target: ParsedFunctionAnnotation,
) -> Bool:
	var found: Bool = False

	for annotation in annotations:
		if annotation == target:
			found = True
			break

	found


private pure func function_body(
	decl: ParsedFunctionDecl,
	comments: List[FormatterComment],
) -> FunctionBody:
	match decl.body:
		None:
			NoFunctionBody
		Some(ParsedBuiltinExpr(name, _)):
			BuiltinFunctionBody(name)
		Some(body):
			ExpressionFunctionBody(project_expr_with_comments(body, comments))


private pure func project_function_declaration_expr(
	decl: ParsedFunctionDecl,
	comments: List[FormatterComment],
) -> Expression:
	body: Expression = match decl.body:
		Some(expr):
			project_expr_with_comments(expr, comments)
		None:
			VoidExpression

	params: List[FunctionParameter] = project_params(decl.params)
	type_params: List[String] = type_param_names(decl.type_params)
	where_constraints: List[TypeConstraint] = project_dim_constraints(decl.dim_constraints)

	match decl.return_type:
		Some(return_type):
			TypedFunctionDeclarationExpression(
				decl.name.text,
				decl.is_pure,
				type_params,
				params,
				project_type_expr(return_type),
				where_constraints,
				body,
			)
		None:
			FunctionDeclarationExpression(
				decl.name.text,
				decl.is_pure,
				type_params,
				params,
				where_constraints,
				body,
			)


private pure func split_interpolation_text(
	source: CompilerSourceFile,
	span: CompilerSourceSpan,
	text: String,
) -> Result[List[StringInterpolationPart], String]:
	var parts: List[StringInterpolationPart] = []
	var literal: String = ""
	var i: Int = 0
	var error: Option[String] = None

	while i < text.length() and error.is_none():
		ch: Char = text
			.get(i)
			.get_or('\0')

		if ch == '\\' and i + 1 < text.length():
			next: Char = text
				.get(i + 1)
				.get_or('\0')

			match next:
				'n':
					literal += "\n"
					i += 2
				't':
					literal += "\t"
					i += 2
				'r':
					literal += "\r"
					i += 2
				'{':
					literal += "{"
					i += 2
				'}':
					literal += "}"
					i += 2
				_:
					literal = literal.append_char(ch)
					literal = literal.append_char(next)
					i += 2
		else if ch == '{':
			if literal.length() > 0:
				parts = parts.append(StringInterpolationTextPart(literal))
				literal = ""

			var depth: Int = 1
			var expr_text: String = ""
			var in_string: Bool = False
			i += 1

			while i < text.length() and depth > 0:
				current: Char = text
					.get(i)
					.get_or('\0')

				if current == '\\' and i + 1 < text.length():
					expr_text = expr_text.append_char(current)
					expr_text = expr_text.append_char(
						text
							.get(i + 1)
							.get_or('\0'),
					)
					i += 2
				else if current == '\"':
					in_string = not in_string
					expr_text = expr_text.append_char(current)
					i += 1
				else if not in_string and current == '{':
					depth += 1
					expr_text = expr_text.append_char(current)
					i += 1
				else if not in_string and current == '}':
					depth -= 1

					if depth > 0:
						expr_text = expr_text.append_char(current)

					i += 1
				else:
					expr_text = expr_text.append_char(current)
					i += 1

			if depth > 0:
				error = Some("Unclosed `" + "$" + "{` in string interpolation")
			else:
				match parse_interpolation_expr(source, span, expr_text):
					Ok(expr):
						parts = parts.append(StringInterpolationExpressionPart(expr))
					Err(message):
						error = Some(message)
		else:
			literal = literal.append_char(ch)
			i += 1

	if literal.length() > 0 and error.is_none():
		parts = parts.append(StringInterpolationTextPart(literal))

	match error:
		Some(message):
			Err(message)
		None:
			Ok(parts)


private pure func parse_interpolation_expr(
	source: CompilerSourceFile,
	span: CompilerSourceSpan,
	text: String,
) -> Result[Expression, String]:
	wrapper: String = "___interp_temp = " + text + "\n"
	wrapper_source: CompilerSourceFile = compiler_source_file(
		span.path,
		source.module_name,
		wrapper,
	)
	program: ParsedProgram = parse_compiler_source(wrapper_source)

	match first_parse_error(program.diagnostics):
		Some(message):
			Err("Parse error in interpolated expression: " + message)
		None:
			match program.decls:
				[VarParsedDecl(var_decl)]:
					Ok(project_expr(var_decl.value))
				_:
					Err("Failed to parse interpolated expression: " + text)


private pure func first_parse_error(diagnostics: List[CompilerParseDiagnostic]) -> Option[String]:
	var message: Option[String] = None

	for diagnostic in diagnostics:
		if message.is_none() and compiler_parse_diagnostic_is_error(diagnostic):
			message = Some(compiler_parse_diagnostic_to_string(diagnostic))

	message


private pure func project_parsed_string_interpolation_part(
	part: ParsedStringInterpolationPart,
) -> StringInterpolationPart:
	match part:
		ParsedInterpolationLiteral(value):
			StringInterpolationTextPart(value)
		ParsedInterpolationExpr(expr):
			StringInterpolationExpressionPart(project_expr(expr))


private pure func project_parsed_string_interpolation_parts(
	parts: List[ParsedStringInterpolationPart],
) -> List[StringInterpolationPart]:
	var projected: List[StringInterpolationPart] = []

	for part in parts:
		projected = projected.append(project_parsed_string_interpolation_part(part))

	projected


private pure func project_string_interpolation(
	source: CompilerSourceFile,
	value: String,
	is_multiline: Bool,
	span: CompilerSourceSpan,
) -> Expression:
	match split_interpolation_text(source, span, value):
		Ok(parts):
			StringInterpolationExpression(parts, is_multiline)
		Err(_):
			StringInterpolationExpression([StringInterpolationTextPart(value)], is_multiline)


private pure func project_expr_with_comments(
	expr: ParsedExpr,
	comments: List[FormatterComment],
) -> Expression:
	match expr:
		ParsedNameExpr(name):
			IdentifierExpression(name.text)
		ParsedIntLiteralExpr(value, _):
			LiteralExpression(int_literal(value))
		ParsedFloatLiteralExpr(value, _):
			LiteralExpression(FloatLiteral(value))
		ParsedStringLiteralExpr(value, form, _):
			LiteralExpression(project_literal_string(value, form))
		ParsedStringInterpolationExpr(value, is_multiline, span):
			project_string_interpolation(
				compiler_source_file(span.path, span.module_name, ""),
				value,
				is_multiline,
				span,
			)
		ParsedStringInterpolationPartsExpr(parts, is_multiline, _):
			StringInterpolationExpression(
				project_parsed_string_interpolation_parts(parts),
				is_multiline,
			)
		ParsedBoolLiteralExpr(value, _):
			LiteralExpression(BoolLiteral(value))
		ParsedCharLiteralExpr(value, _):
			LiteralExpression(CharLiteral(value))
		ParsedUnaryExpr(op, inner, _):
			UnaryExpression(
				project_unary_op(op),
				project_expr_with_comments(inner, comments),
			)
		ParsedBinaryExpr(op, left, right, _):
			BinaryExpression(
				project_binary_op(op),
				project_expr_with_comments(left, comments),
				project_expr_with_comments(right, comments),
			)
		ParsedLogicalExpr(op, left, right, _):
			LogicalExpression(
				project_logical_op(op),
				project_expr_with_comments(left, comments),
				project_expr_with_comments(right, comments),
			)
		ParsedAscriptionExpr(inner, type_expr, _):
			AscriptionExpression(
				project_expr_with_comments(inner, comments),
				project_type_expr(type_expr),
			)
		ParsedRangeExpr(start, finish, _):
			RangeExpression(
				project_expr_with_comments(start, comments),
				project_expr_with_comments(finish, comments),
			)
		ParsedCallExpr(callee, args, _):
			var projected_args: List[Expression] = []

			for arg in args:
				projected_args = projected_args.append(project_expr_with_comments(arg, comments))

			CallExpression(
				project_expr_with_comments(callee, comments),
				projected_args,
			)
		ParsedFieldAccessExpr(target, field_name, _):
			FieldAccessExpression(
				project_expr_with_comments(target, comments),
				field_name.text,
			)
		ParsedSubscriptExpr(target, indices, _):
			if indices.length() == 1:
				SubscriptExpression(
					project_expr_with_comments(
						target,
						comments,
					),
					project_expr_with_comments(
						indices
							.get(0)
							.get_or(ParsedVoidExpr(parsed_expr_span(target))),
						comments,
					),
				)
			else:
				var projected_indices: List[Expression] = []

				for index in indices:
					projected_indices = projected_indices.append(
						project_expr_with_comments(
							index,
							comments,
						),
					)

				MultiSubscriptExpression(
					project_expr_with_comments(target, comments),
					projected_indices,
				)
		ParsedListExpr(items, _):
			ListExpression(parsed_block_items(items))
		ParsedTupleExpr(items, _):
			TupleExpression(parsed_block_items(items))
		ParsedRecordExpr(fields, _):
			RecordExpression(project_record_expr_fields(fields))
		ParsedRecordUpdateExpr(base, fields, _):
			RecordUpdateExpression(
				project_expr_with_comments(base, comments),
				project_record_expr_fields(fields),
			)
		ParsedDictExpr(entries, _):
			DictionaryExpression(project_dict_entries(entries))
		ParsedVectorExpr(items, _):
			VectorExpression(parsed_block_items(items))
		ParsedOpaqueIntoExpr(type_expr, inner, _):
			OpaqueIntoExpression(
				project_type_expr(type_expr),
				project_expr_with_comments(inner, comments),
			)
		ParsedOpaqueFromExpr(type_expr, inner, _):
			OpaqueFromExpression(
				project_type_expr(type_expr),
				project_expr_with_comments(inner, comments),
			)
		ParsedBlockExpr(items, span):
			commented_block_expr(items, comments, span)
		ParsedIfExpr(cond, then_expr, else_expr, _):
			match else_expr:
				Some(value):
					IfElseExpression(
						project_expr_with_comments(cond, comments),
						project_expr_with_comments(then_expr, comments),
						project_expr_with_comments(value, comments),
					)
				None:
					IfExpression(
						project_expr_with_comments(cond, comments),
						project_expr_with_comments(then_expr, comments),
					)
		ParsedMatchExpr(value, cases, _):
			MatchExpression(
				project_expr_with_comments(value, comments),
				project_match_cases(cases, comments),
			)
		ParsedSelectExpr(arms, _):
			SelectExpression(project_select_arms(arms, comments))
		ParsedWithExpr(binding, body, _):
			project_with_expr(binding, body, comments)
		ParsedDebugBlockExpr(body, _):
			DebugBlockExpression(project_expr_with_comments(body, comments))
		ParsedLambdaExpr(is_pure, params, return_type, body, _):
			projected_params: List[FunctionParameter] = params.map(
				func(param): project_lambda_param(param),
			)

			match return_type:
				Some(type_expr):
					TypedLambdaExpression(
						is_pure,
						projected_params,
						project_type_expr(type_expr),
						project_expr_with_comments(body, comments),
					)
				None:
					LambdaExpression(
						is_pure,
						projected_params,
						project_expr_with_comments(body, comments),
					)
		ParsedFunctionDeclExpr(decl):
			project_function_declaration_expr(decl, comments)
		ParsedWhileExpr(cond, body, _):
			WhileExpression(
				project_expr_with_comments(cond, comments),
				project_expr_with_comments(body, comments),
			)
		ParsedForExpr(binder, iterable, body, _):
			match project_for_binder_name(binder):
				Some(name):
					ForExpression(
						name,
						project_expr_with_comments(iterable, comments),
						project_expr_with_comments(body, comments),
					)
				None:
					TupleForExpression(
						project_for_binder_names(binder),
						project_expr_with_comments(iterable, comments),
						project_expr_with_comments(body, comments),
					)
		ParsedConcurrentBlockExpr(params, body, _):
			project_concurrent_expr(params, body, comments)
		ParsedConcurrentForExpr(name, iterable, params, body, _):
			project_concurrently_loop_expr(name.text, iterable, params, body, comments)
		ParsedDetachExpr(body, _):
			DetachExpression(project_expr_with_comments(body, comments))
		ParsedBreakExpr(_):
			BreakExpression
		ParsedContinueExpr(_):
			ContinueExpression
		ParsedVoidExpr(_):
			VoidExpression
		ParsedBuiltinExpr(name, _):
			match name:
				Some(value):
					BuiltinRuntimeExpression(value)
				None:
					BuiltinExpression
		ParsedVarDeclExpr(name, type_expr, value, is_mutable, _):
			match type_expr:
				Some(type_value):
					TypedVariableDeclarationExpression(
						name.text,
						is_mutable,
						project_type_expr(type_value),
						project_expr_with_comments(value, comments),
					)
				None:
					VariableDeclarationExpression(
						name.text,
						is_mutable,
						project_expr_with_comments(value, comments),
					)
		ParsedAssignExpr(name, value, _):
			AssignmentExpression(
				name.text,
				project_expr_with_comments(value, comments),
			)
		ParsedCompoundAssignExpr(name, op, value, _):
			CompoundAssignmentExpression(
				name.text,
				project_compound_assign_op(op),
				project_expr_with_comments(value, comments),
			)
		ParsedSubscriptAssignExpr(target, indices, value, _):
			var projected_indices: List[Expression] = []

			for index in indices:
				projected_indices = projected_indices.append(
					project_expr_with_comments(
						index,
						comments,
					),
				)

			SubscriptAssignmentExpression(
				project_expr_with_comments(target, comments),
				projected_indices,
				project_expr_with_comments(value, comments),
			)
		ParsedTupleDestructExpr(names, value, _):
			var projected_names: List[String] = []

			for name in names:
				projected_names = projected_names.append(name.text)

			TupleDestructureExpression(
				projected_names,
				project_expr_with_comments(value, comments),
			)
		ParsedQuestionBindExpr(name, type_expr, value, _):
			match type_expr:
				Some(type_value):
					TypedQuestionBindExpression(
						name.text,
						project_type_expr(type_value),
						project_expr_with_comments(value, comments),
					)
				None:
					QuestionBindExpression(
						name.text,
						project_expr_with_comments(value, comments),
					)
		ParsedMissingExpr(_):
			VoidExpression


pure func project_expr(expr: ParsedExpr) -> Expression:
	project_expr_with_comments(expr, [])


private pure func project_with_expr(
	binding: ParsedWithBinding,
	body: ParsedExpr,
	comments: List[FormatterComment],
) -> Expression:
	is_try: Bool = binding.kind == ParsedWithTryBinding

	error_name: Option[String] = match binding.error_map:
		Some(error_map):
			Some(error_map.name.text)
		None:
			None

	error_value: Option[Expression] = match binding.error_map:
		Some(error_map):
			Some(project_expr_with_comments(error_map.value, comments))
		None:
			None

	WithExpression(
		binding.name.text,
		option_type_expr(binding.type_expr),
		is_try,
		project_expr_with_comments(binding.value, comments),
		error_name,
		error_value,
		project_expr_with_comments(body, comments),
	)


private pure func concurrent_param_expr(
	params: List[ParsedConcurrentParam],
	name: String,
	comments: List[FormatterComment],
) -> Option[Expression]:
	var result: Option[Expression] = None

	for param in params:
		if result.is_none() and param.name.text == name:
			result = Some(project_expr_with_comments(param.value, comments))

	result


private pure func concurrent_param_int(
	params: List[ParsedConcurrentParam],
	name: String,
) -> Option[Int]:
	var result: Option[Int] = None

	for param in params:
		if result.is_none() and param.name.text == name:
			match param.value:
				ParsedIntLiteralExpr(value, _):
					result = value.parse_int()
				_:
					result = None

	result


private pure func project_concurrent_expr(
	params: List[ParsedConcurrentParam],
	body: ParsedExpr,
	comments: List[FormatterComment],
) -> Expression:
	ConcurrentExpression(
		block_exprs_for_concurrent(body, comments),
		concurrent_param_expr(params, "timeout", comments),
		concurrent_param_int(params, "max_threads"),
	)


private pure func project_concurrently_loop_expr(
	name: String,
	iterable: ParsedExpr,
	params: List[ParsedConcurrentParam],
	body: ParsedExpr,
	comments: List[FormatterComment],
) -> Expression:
	ConcurrentlyLoopExpression(
		name,
		project_expr_with_comments(iterable, comments),
		project_expr_with_comments(body, comments),
		concurrent_param_expr(params, "timeout", comments),
		ConcurrentlyLoopLimit(concurrent_param_int(params, "limit").get_or(0)),
	)


private pure func option_doc(doc: Option[String], decl: Declaration) -> Declaration:
	match doc:
		Some(text):
			DocumentedDeclaration(PlainDeclarationDoc(text), decl)
		None:
			decl


private pure func project_import_symbol(symbol: ParsedImportSymbol) -> ImportSymbol:
	var ctors: List[String] = []

	for ctor in symbol.constructors:
		ctors = ctors.append(ctor.text)

	ctor_imports: Option[List[String]] = if ctors.length() == 0:
		None
	else:
		Some(ctors)

	{
		name = symbol.name.text,
		alias_name = symbol.symbol_alias.map(func(name): name.text),
		ctors = ctor_imports
	}


private pure func project_import_symbols(
	symbols: Option[List[ParsedImportSymbol]],
) -> Option[List[ImportSymbol]]:
	match symbols:
		Some(items):
			var projected: List[ImportSymbol] = []

			for item in items:
				projected = projected.append(project_import_symbol(item))

			Some(projected)
		None:
			None


private pure func project_import_item(item: ParsedImportDecl) -> ImportItem:
	{
		module_name = item.module_path,
		alias_name = item.module_alias.map(func(name): name.text),
		symbols = project_import_symbols(item.symbols)
	}


private pure func located_decl(
	span: CompilerSourceSpan,
	declaration: Declaration,
) -> LocatedDeclaration:
	{
		line = span.start_line,
		column = span.start_column,
		end_line = span_end_line(span),
		declaration = declaration
	}


private pure func project_type_variant(variant: ParsedVariantDecl) -> TypeVariant:
	var fields: List[TypeExpression] = []

	for field in variant.fields:
		fields = fields.append(project_type_expr(field))

	{
		name = variant.name.text,
		fields = fields
	}


private pure func project_field_decl(field: ParsedFieldDecl) -> DeclarationField:
	{
		name = field.name.text,
		field_type = project_type_expr(field.type_expr)
	}


private pure func resource_cleanup_name(type_decl: ParsedBuiltinTypeDecl) -> Option[String]:
	match type_decl.cleanup:
		Some(cleanup):
			Some(cleanup.builtin_name)
		None:
			None


private pure func project_function_decl(
	decl: ParsedFunctionDecl,
	is_private: Bool,
	comments: List[FormatterComment],
) -> Declaration:
	option_doc(
		decl.doc,
		FunctionDeclaration(
			is_private,
			decl.name.text,
			decl.is_pure,
			annotation_present(decl.annotations, ParsedTailRecursiveAnnotation),
			annotation_present(decl.annotations, ParsedDebugOnlyAnnotation),
			annotation_present(decl.annotations, ParsedNoCopyAnnotation),
			annotation_present(decl.annotations, ParsedResourceResultOrdinaryAnnotation),
			type_param_names(decl.type_params),
			project_params(decl.params),
			option_type_expr(decl.return_type),
			project_dim_constraints(decl.dim_constraints),
			function_body(decl, comments),
		),
	)


private pure func project_trait_method(
	method: ParsedTraitMethodDecl,
	comments: List[FormatterComment],
) -> TraitMethod:
	{
		name = method.name.text,
		is_pure = method.is_pure,
		params = project_params(method.params),
		return_type = option_type_expr(method.return_type),
		body = method.body.map(func(expr): project_expr_with_comments(expr, comments))
	}


private pure func project_trait_methods(
	methods: List[ParsedTraitMethodDecl],
	comments: List[FormatterComment],
) -> List[TraitMethod]:
	var projected: List[TraitMethod] = []

	for method in methods:
		projected = projected.append(project_trait_method(method, comments))

	projected


private pure func foreign_metadata(args: List[ParsedForeignBlockArg]) -> ForeignMetadata:
	var includes: List[String] = []
	var link_flags: List[ForeignLinkFlag] = []

	for arg in args:
		match arg.name.text:
			"include":
				includes = includes.append(arg.value)
			"link":
				link_flags = link_flags.append({
					platform = None,
					value = arg.value,
				})
			"link_linux":
				link_flags = link_flags.append({
					platform = Some("linux"),
					value = arg.value,
				})
			"link_macos":
				link_flags = link_flags.append({
					platform = Some("macos"),
					value = arg.value,
				})
			_:
				void

	{
		includes = includes,
		link_flags = link_flags
	}


private pure func project_foreign_function(
	metadata: ForeignMetadata,
	decl: ParsedForeignFunctionDecl,
) -> Declaration:
	FunctionDeclaration(
		decl.is_private,
		decl.name.text,
		decl.is_pure,
		annotation_present(decl.annotations, ParsedTailRecursiveAnnotation),
		annotation_present(decl.annotations, ParsedDebugOnlyAnnotation),
		annotation_present(decl.annotations, ParsedNoCopyAnnotation),
		annotation_present(decl.annotations, ParsedResourceResultOrdinaryAnnotation),
		[],
		project_params(decl.params),
		Some(project_type_expr(decl.return_type)),
		[],
		ForeignFunctionBody(
			decl.c_name.get_or(decl.name.text),
			metadata,
		),
	)


private pure func project_impl_method(
	method: ParsedFunctionDecl,
	comments: List[FormatterComment],
) -> ImplementationMethod:
	{
		name = method.name.text,
		is_pure = method.is_pure,
		is_tailrec = annotation_present(method.annotations, ParsedTailRecursiveAnnotation),
		is_debug_only = annotation_present(method.annotations, ParsedDebugOnlyAnnotation),
		no_copy = annotation_present(method.annotations, ParsedNoCopyAnnotation),
		resource_result_ordinary = annotation_present(
			method.annotations,
			ParsedResourceResultOrdinaryAnnotation,
		),
		type_params = type_param_names(method.type_params),
		params = project_params(method.params),
		return_type = option_type_expr(method.return_type),
		where_constraints = project_dim_constraints(method.dim_constraints),
		body = function_body(method, comments)
	}


private pure func project_impl_methods(
	methods: List[ParsedFunctionDecl],
	comments: List[FormatterComment],
) -> List[ImplementationMethod]:
	var projected: List[ImplementationMethod] = []

	for method in methods:
		projected = projected.append(project_impl_method(method, comments))

	projected


private pure func project_decl_to_located(
	decl: ParsedDecl,
	is_private: Bool,
	comments: List[FormatterComment],
) -> List[LocatedDeclaration]:
	match decl:
		FunctionParsedDecl(function_decl):
			[located_decl(
					function_decl.span,
					project_function_decl(function_decl, is_private, comments),
				)]
		VarParsedDecl(var_decl):
			[located_decl(
					var_decl.span,
					VariableDeclaration(
						is_private,
						Some(var_decl.name.text),
						None,
						var_decl.is_mutable,
						option_type_expr(var_decl.type_expr),
						project_expr_with_comments(var_decl.value, comments),
					),
				)]
		ImportBlockParsedDecl(items, _):
			var located: List[LocatedDeclaration] = []

			for item in items:
				located = located.append(
					located_decl(
						item.span,
						ImportDeclaration(project_import_item(item)),
					),
				)

			located
		ForeignBlockParsedDecl(args, functions, _):
			metadata: ForeignMetadata = foreign_metadata(args)
			var located: List[LocatedDeclaration] = []

			for function_decl in functions:
				located = located.append(
					located_decl(
						function_decl.span,
						project_foreign_function(metadata, function_decl),
					),
				)

			located
		RecordParsedDecl(record_decl):
			[located_decl(
					record_decl.span,
					option_doc(
						record_decl.doc,
						RecordDeclaration(
							is_private,
							record_decl.name.text,
							type_param_names(record_decl.type_params),
							record_decl.is_struct,
							False,
							record_decl.fields.map(func(field): project_field_decl(field)),
						),
					),
				)]
		UnionParsedDecl(union_decl):
			[located_decl(
					union_decl.span,
					option_doc(
						union_decl.doc,
						TypeDeclaration(
							is_private,
							union_decl.name.text,
							type_param_names(union_decl.type_params),
							union_decl.is_enum,
							False,
							False,
							None,
							union_decl.variants.map(func(variant): project_type_variant(variant)),
						),
					),
				)]
		BuiltinTypeParsedDecl(type_decl):
			[located_decl(
					type_decl.span,
					option_doc(
						type_decl.doc,
						TypeDeclaration(
							is_private,
							type_decl.name.text,
							type_param_names(type_decl.type_params),
							False,
							True,
							type_decl.is_resource,
							resource_cleanup_name(type_decl),
							[],
						),
					),
				)]
		TypeAliasParsedDecl(alias_decl):
			[located_decl(
					alias_decl.span,
					option_doc(
						alias_decl.doc,
						TypeAliasDeclaration(
							is_private,
							alias_decl.is_opaque,
							alias_decl.name.text,
							type_param_names(alias_decl.type_params),
							project_type_expr(alias_decl.target),
						),
					),
				)]
		TraitParsedDecl(trait_decl):
			var supertraits: List[String] = []

			for supertrait in trait_decl.supertraits:
				supertraits = supertraits.append(supertrait.text)

			[located_decl(
					trait_decl.span,
					option_doc(
						trait_decl.doc,
						TraitDeclaration(
							is_private,
							trait_decl.name.text,
							type_param_names(trait_decl.type_params),
							supertraits,
							project_trait_methods(trait_decl.methods, comments),
						),
					),
				)]
		ImplParsedDecl(impl_decl):
			[located_decl(
					impl_decl.span,
					option_doc(
						impl_decl.doc,
						ImplementationDeclaration(
							is_private,
							impl_decl.trait_name.text,
							project_type_expr(impl_decl.for_type),
							project_impl_methods(impl_decl.methods, comments),
						),
					),
				)]
		PrivateParsedDecl(inner, _):
			project_decl_to_located(inner, True, comments)
		ParsedErrorDecl(span):
			[located_decl(
					span,
					VariableDeclaration(
						True,
						Some("__parse_error"),
						None,
						False,
						None,
						VoidExpression,
					),
				)]


private pure func project_decls(
	decls: List[ParsedDecl],
	comments: List[FormatterComment],
) -> List[LocatedDeclaration]:
	var located: List[LocatedDeclaration] = []

	for decl in decls:
		for item in project_decl_to_located(decl, False, comments):
			located = located.append(item)

	located


pure func parsed_program_to_formatter_program(
	program: ParsedProgram,
	comments: List[FormatterComment],
) -> Result[Program, String]:
	match first_parse_error(program.diagnostics):
		Some(message):
			Err(message)
		None:
			Ok({
				declarations = project_decls(program.decls, comments),
				comments = comments,
			})


pure func render_parsed_program(
	width: Int,
	program: ParsedProgram,
	comments: List[FormatterComment],
) -> Result[String, String]:
	formatter_program ?= parsed_program_to_formatter_program(program, comments)
	Ok(width.layout(formatter_program.program_document()))
