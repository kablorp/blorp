enum SemanticDimOp:
	SemanticDimAdd
	SemanticDimSubtract
	SemanticDimMultiply
	SemanticDimDivide


-- Compiler types are immutable values. Phase boundaries share these trees and
-- rely on ARC to retain them; only a transformation that changes a node should
-- rebuild that node.
union SemanticType:
	SemanticNamedType(String, List[SemanticType])
	SemanticArrayType(SemanticType, List[SemanticType])
	SemanticFunctionType(Bool, List[SemanticType], SemanticType)
	SemanticTypeVar(String)
	SemanticConstIntType(Int)
	SemanticTupleType(List[SemanticType])
	SemanticSelfType
	SemanticVarDimsType(String)
	SemanticRangeType(SemanticType)
	SemanticDimOpType(SemanticDimOp, SemanticType, SemanticType)
	SemanticMetaType(Int)


record SemanticTypeSubstEntry {
	var_name: String,
	concrete_type: SemanticType
}


TYPE_NAME_INT: String = "Int"

TYPE_NAME_FLOAT: String = "Float"

TYPE_NAME_STRING: String = "String"

TYPE_NAME_BOOL: String = "Bool"

TYPE_NAME_CHAR: String = "Char"

TYPE_NAME_VOID: String = "Void"

TYPE_NAME_TENSOR: String = "Tensor"

TYPE_NAME_VECTOR: String = "Vector"

TYPE_NAME_MATRIX: String = "Matrix"

TYPE_NAME_TUPLE: String = "Tuple"

CANONICAL_MODULE_TYPE_SEPARATOR: String = "::"


pure func array_type(element: SemanticType, dims: List[SemanticType]) -> SemanticType:
	if dims.length() == 0:
		element
	else:
		SemanticArrayType(element, dims)


pure func semantic_function_type(
	is_pure: Bool,
	params: List[SemanticType],
	return_type: SemanticType,
) -> SemanticType:
	SemanticFunctionType(is_pure, params, return_type)


pure func type_int() -> SemanticType:
	SemanticNamedType(TYPE_NAME_INT, [])


pure func type_float() -> SemanticType:
	SemanticNamedType(TYPE_NAME_FLOAT, [])


pure func type_string() -> SemanticType:
	SemanticNamedType(TYPE_NAME_STRING, [])


pure func type_bool() -> SemanticType:
	SemanticNamedType(TYPE_NAME_BOOL, [])


pure func type_char() -> SemanticType:
	SemanticNamedType(TYPE_NAME_CHAR, [])


pure func type_void() -> SemanticType:
	SemanticNamedType(TYPE_NAME_VOID, [])


pure func type_list(element: SemanticType) -> SemanticType:
	SemanticNamedType("List", [element])


-- Parsed annotations retain source spelling, so an unbounded type parameter
-- initially has the same shape as an ordinary nominal type. Semantic phases
-- must make that identity explicit before nominal names and generic variables
-- require different layout or specialization behavior.
-- List.set clones shared storage on the first changed element, then updates
-- the unique clone in place. Fully unchanged lists allocate nothing.
private pure func type_instantiate_type_param_list_if_changed(
	type_params: List[String],
	types: List[SemanticType],
) -> Option[List[SemanticType]]:
	var instantiated: List[SemanticType] = types
	var changed: Bool = False
	var index: Int = 0

	for typ in types:
		item_changed: Bool = match type_instantiate_type_params_if_changed(type_params, typ):
			Some(instantiated_type):
				instantiated = instantiated.set(index, instantiated_type)
				True
			None:
				False

		changed = changed or item_changed
		index += 1

	if changed:
		Some(instantiated)
	else:
		None


private pure func type_instantiate_type_params_if_changed(
	type_params: List[String],
	typ: SemanticType,
) -> Option[SemanticType]:
	match typ:
		SemanticNamedType(name, args):
			if args.is_empty() and type_params.contains(name):
				Some(SemanticTypeVar(name))
			else:
				match type_instantiate_type_param_list_if_changed(type_params, args):
					Some(instantiated_args):
						Some(SemanticNamedType(name, instantiated_args))
					None:
						None
		SemanticArrayType(element, dims):
			element_result = type_instantiate_type_params_if_changed(type_params, element)
			dims_result = type_instantiate_type_param_list_if_changed(type_params, dims)

			match element_result:
				Some(instantiated_element):
					match dims_result:
						Some(instantiated_dims):
							Some(SemanticArrayType(instantiated_element, instantiated_dims))
						None:
							Some(SemanticArrayType(instantiated_element, dims))
				None:
					match dims_result:
						Some(instantiated_dims):
							Some(SemanticArrayType(element, instantiated_dims))
						None:
							None
		SemanticFunctionType(is_pure, params, return_type):
			params_result = type_instantiate_type_param_list_if_changed(type_params, params)
			return_result = type_instantiate_type_params_if_changed(type_params, return_type)

			match params_result:
				Some(instantiated_params):
					match return_result:
						Some(instantiated_return):
							Some(
								SemanticFunctionType(
									is_pure,
									instantiated_params,
									instantiated_return,
								),
							)
						None:
							Some(SemanticFunctionType(is_pure, instantiated_params, return_type))
				None:
					match return_result:
						Some(instantiated_return):
							Some(SemanticFunctionType(is_pure, params, instantiated_return))
						None:
							None
		SemanticTypeVar(_):
			None
		SemanticConstIntType(_):
			None
		SemanticTupleType(elements):
			match type_instantiate_type_param_list_if_changed(type_params, elements):
				Some(instantiated_elements):
					Some(SemanticTupleType(instantiated_elements))
				None:
					None
		SemanticSelfType:
			None
		SemanticVarDimsType(_):
			None
		SemanticRangeType(inner):
			match type_instantiate_type_params_if_changed(type_params, inner):
				Some(instantiated_inner):
					Some(SemanticRangeType(instantiated_inner))
				None:
					None
		SemanticDimOpType(op, left, right):
			left_result = type_instantiate_type_params_if_changed(type_params, left)
			right_result = type_instantiate_type_params_if_changed(type_params, right)

			match left_result:
				Some(instantiated_left):
					match right_result:
						Some(instantiated_right):
							Some(SemanticDimOpType(op, instantiated_left, instantiated_right))
						None:
							Some(SemanticDimOpType(op, instantiated_left, right))
				None:
					match right_result:
						Some(instantiated_right):
							Some(SemanticDimOpType(op, left, instantiated_right))
						None:
							None
		SemanticMetaType(_):
			None


pure func type_instantiate_type_params(
	type_params: List[String],
	typ: SemanticType,
) -> SemanticType:
	if type_params.is_empty():
		typ
	else:
		match type_instantiate_type_params_if_changed(type_params, typ):
			Some(instantiated):
				instantiated
			None:
				typ


pure func type_contains_meta(typ: SemanticType) -> Bool:
	match typ:
		SemanticNamedType(_, args):
			args.any(type_contains_meta)
		SemanticArrayType(element, dims):
			type_contains_meta(element) or dims.any(type_contains_meta)
		SemanticFunctionType(_, params, return_type):
			params.any(type_contains_meta) or type_contains_meta(return_type)
		SemanticTypeVar(_):
			False
		SemanticConstIntType(_):
			False
		SemanticTupleType(elements):
			elements.any(type_contains_meta)
		SemanticSelfType:
			False
		SemanticVarDimsType(_):
			False
		SemanticRangeType(inner):
			type_contains_meta(inner)
		SemanticDimOpType(_, left, right):
			type_contains_meta(left) or type_contains_meta(right)
		SemanticMetaType(_):
			True


pure func normalize_type_name(name: String) -> String:
	if name == TYPE_NAME_VECTOR or name == TYPE_NAME_MATRIX:
		TYPE_NAME_TENSOR
	else:
		name


pure func is_dim_var_name(name: String) -> Bool:
	name.length() > 0 and name.get_or(0, ' ') == '#'


pure func strip_type_param_bounds(name: String) -> String:
	bounds_index: Int = name.raw_index_of(":")

	if bounds_index < 0:
		name
	else:
		name.substring(0, bounds_index)


pure func is_legacy_single_letter_type_param(name: String) -> Bool:
	if name.length() != 1:
		False
	else:
		ch: Char = name.get_or(0, ' ')
		ch >= 'A' and ch <= 'Z'


pure func is_type_param_name(name: String) -> Bool:
	name.raw_index_of(":") >= 0 or is_legacy_single_letter_type_param(strip_type_param_bounds(name))


pure func type_subst_entry(var_name: String, concrete_type: SemanticType) -> SemanticTypeSubstEntry:
	{
		var_name = var_name,
		concrete_type = concrete_type
	}


private pure func lookup_subst_key(
	key: String,
	subst: List[SemanticTypeSubstEntry],
) -> Option[SemanticType]:
	var index: Int = 0
	var result: Option[SemanticType] = None

	while index < subst.length() and result.is_none():
		match subst.get(index):
			Some(entry):
				if entry.var_name == key:
					result = Some(entry.concrete_type)
			None:
				void

		index += 1

	result


pure func lookup_subst(name: String, subst: List[SemanticTypeSubstEntry]) -> Option[SemanticType]:
	match lookup_subst_key(name, subst):
		Some(replacement):
			Some(replacement)
		None:
			stripped: String = strip_type_param_bounds(name)

			if stripped != name:
				lookup_subst_key(stripped, subst)
			else:
				None


private pure func split_canonical_module_type_name(name: String) -> Option[(String, String)]:
	index: Int = name.raw_index_of(CANONICAL_MODULE_TYPE_SEPARATOR)

	if index < 0:
		None
	else:
		module_path: String = name.substring(0, index)
		type_name: String = name.substring(
			index + CANONICAL_MODULE_TYPE_SEPARATOR.length(),
			name.length() - index - CANONICAL_MODULE_TYPE_SEPARATOR.length(),
		)
		Some((module_path, type_name))


pure func canonical_module_type_name(module_path: String, type_name: String) -> String:
	if is_std_module_name(module_path) and is_global_abi_type_name(type_name):
		type_name
	else:
		module_path + CANONICAL_MODULE_TYPE_SEPARATOR + type_name


pure func is_std_module_name(module_path: String) -> Bool:
	module_path == "std" or module_path == "prelude" or module_path.starts_with("std/")


pure func is_global_abi_type_name(name: String) -> Bool:
	(
		name == "Any"
		or name == "Array"
		or name == "Bool"
		or name == "Bytes"
		or name == "Char"
		or name == "Dict"
		or name == "Error"
		or name == "Fixed"
		or name == "Float"
		or name == "Float16"
		or name == "Float32"
		or name == "Handle"
		or name == "Int"
		or name == "Int8"
		or name == "Int16"
		or name == "Int32"
		or name == "Int64"
		or name == "Int128"
		or name == "InterfaceScope"
		or name == "List"
		or name == "LiteralString"
		or name == "Matrix"
		or name == "Module"
		or name == "Range"
		or name == "Option"
		or name == "ParallelList"
		or name == "ParallelMatrix"
		or name == "ParallelVector"
		or name == "Ptr"
		or name == "ResourceToken"
		or name == "Result"
		or name == "Set"
		or name == "String"
		or name == "StringSlice"
		or name == "Tensor"
		or name == "Tuple"
		or name == "UInt8"
		or name == "UInt16"
		or name == "UInt32"
		or name == "UInt64"
		or name == "UInt128"
		or name == "Vector"
		or name == "Void"
		or name == "Builder"
		or name == "Slice"
		or name == "MemStats"
		or name == "SchedulerStats"
		or name == "Task"
		or name == "Channel"
		or name == "Stream"
		or name == "FallibleStream"
		or name == "FileReader"
		or name == "FileWriter"
		or name == "FileAppender"
		or name == "FileReadWriter"
		or name == "FileReadAppender"
		or name == "Directory"
		or name == "DirectoryEntry"
		or name == "TcpListener"
		or name == "TcpStream"
		or name == "IpAddress"
		or name == "DnsName"
		or name == "Port"
		or name == "UdpSocket"
		or name == "ConcurrencyError"
	)


private pure func should_qualify_module_local_type(
	module_path: String,
	local_type_names: List[String],
	name: String,
) -> Bool:
	(
		local_type_names.contains(name)
		and not (is_std_module_name(module_path) and is_global_abi_type_name(name))
	)


pure func qualify_module_local_types(
	module_path: String,
	local_type_names: List[String],
	typ: SemanticType,
) -> SemanticType:
	match typ:
		SemanticNamedType(name, args):
			next_name = if should_qualify_module_local_type(module_path, local_type_names, name):
				canonical_module_type_name(module_path, name)
			else:
				name

			SemanticNamedType(
				next_name,
				args.map(func(arg): qualify_module_local_types(module_path, local_type_names, arg)),
			)
		SemanticArrayType(element, dims):
			SemanticArrayType(
				qualify_module_local_types(module_path, local_type_names, element),
				dims.map(func(dim): qualify_module_local_types(module_path, local_type_names, dim)),
			)
		SemanticFunctionType(is_pure, params, return_type):
			SemanticFunctionType(
				is_pure,
				params.map(
					func(param): qualify_module_local_types(module_path, local_type_names, param),
				),
				qualify_module_local_types(module_path, local_type_names, return_type),
			)
		SemanticTupleType(elements):
			SemanticTupleType(elements.map(
				func(element): qualify_module_local_types(module_path, local_type_names, element),
			))
		SemanticRangeType(inner):
			SemanticRangeType(qualify_module_local_types(module_path, local_type_names, inner))
		SemanticDimOpType(op, left, right):
			SemanticDimOpType(
				op,
				qualify_module_local_types(module_path, local_type_names, left),
				qualify_module_local_types(module_path, local_type_names, right),
			)
		_:
			typ


pure func display_type_name(name: String) -> String:
	match split_canonical_module_type_name(name):
		Some((module_path, type_name)):
			module_path + "." + type_name
		None:
			name


private pure func dim_op_to_string(op: SemanticDimOp) -> String:
	match op:
		SemanticDimAdd:
			" + "
		SemanticDimSubtract:
			" - "
		SemanticDimMultiply:
			" * "
		SemanticDimDivide:
			" / "


private pure func type_list_to_string(types: List[SemanticType]) -> String:
	types
		.map(type_to_string)
		.join(", ")


pure func type_to_string(typ: SemanticType) -> String:
	match typ:
		SemanticNamedType(name, args):
			if args.length() == 0:
				display_type_name(name)
			else if name == TYPE_NAME_TUPLE and args.length() >= 2:
				"(" + type_list_to_string(args) + ")"
			else:
				display_type_name(name) + "[" + type_list_to_string(args) + "]"
		SemanticArrayType(element, dims):
			element_text: String = match element:
				SemanticFunctionType(_, _, _):
					"(" + type_to_string(element) + ")"
				_:
					type_to_string(element)

			element_text + "[" + type_list_to_string(dims) + "]"
		SemanticFunctionType(is_pure, params, return_type):
			prefix: String = if is_pure:
				"pure "
			else:
				""

			params_text: String = type_list_to_string(params)
			return_text: String = type_to_string(return_type)

			prefix + "(" + params_text + ") -> " + return_text
		SemanticTypeVar(name):
			name
		SemanticConstIntType(value):
			"#" + value.to_string()
		SemanticTupleType(elements):
			"(" + type_list_to_string(elements) + ")"
		SemanticSelfType:
			"Self"
		SemanticVarDimsType(name):
			name + "..."
		SemanticRangeType(inner):
			".." + type_to_string(inner)
		SemanticDimOpType(op, left, right):
			left_text: String = type_to_string(left)
			right_text: String = type_to_string(right)

			left_text + dim_op_to_string(op) + right_text
		SemanticMetaType(id):
			"?m" + id.to_string()


private pure func type_lists_equal(left: List[SemanticType], right: List[SemanticType]) -> Bool:
	if left.length() != right.length():
		False
	else:
		var index: Int = 0
		var equal: Bool = True

		while index < left.length() and equal:
			match (left.get(index), right.get(index)):
				(Some(left_item), Some(right_item)):
					equal = types_equal(left_item, right_item)
				_:
					equal = False

			index += 1

		equal


pure func array_type_parts(typ: SemanticType) -> Option[(SemanticType, List[SemanticType])]:
	match typ:
		SemanticArrayType(element, dims):
			Some((element, dims))
		SemanticNamedType(name, args):
			if (
				(name == TYPE_NAME_TENSOR or name == TYPE_NAME_VECTOR or name == TYPE_NAME_MATRIX)
				and args.length() >= 2
			):
				match args.get(0):
					Some(element):
						var dims: List[SemanticType] = []
						var index: Int = 1

						while index < args.length():
							match args.get(index):
								Some(dim):
									dims = dims.append(dim)
								None:
									void

							index += 1

						Some((element, dims))
					None:
						None
			else:
				None
		_:
			None


private pure func array_types_equal(left: SemanticType, right: SemanticType) -> Bool:
	match (array_type_parts(left), array_type_parts(right)):
		(Some(left_parts), Some(right_parts)):
			(
				types_equal(left_parts[0], right_parts[0])
				and type_lists_equal(left_parts[1], right_parts[1])
			)
		_:
			False


private pure func is_tensor_family_name(name: String) -> Bool:
	name == TYPE_NAME_TENSOR or name == TYPE_NAME_VECTOR or name == TYPE_NAME_MATRIX


private pure func zero_dim_tensor_element(typ: SemanticType) -> Option[SemanticType]:
	match typ:
		SemanticNamedType(name, args):
			if is_tensor_family_name(name) and args.length() == 1:
				args.get(0)
			else:
				None
		_:
			None


pure func types_equal(left: SemanticType, right: SemanticType) -> Bool:
	if array_types_equal(left, right):
		True
	else:
		match zero_dim_tensor_element(left):
			Some(element):
				types_equal(element, right)
			None:
				match zero_dim_tensor_element(right):
					Some(element):
						types_equal(left, element)
					None:
						match left:
							SemanticNamedType(left_name, left_args):
								match right:
									SemanticNamedType(right_name, right_args):
										(
											normalize_type_name(
												left_name,
											) == normalize_type_name(right_name)
											and type_lists_equal(left_args, right_args)
										)
									SemanticTupleType(right_elements):
										(
											left_name == TYPE_NAME_TUPLE
											and type_lists_equal(left_args, right_elements)
										)
									_:
										False
							SemanticTypeVar(left_name):
								match right:
									SemanticTypeVar(right_name):
										left_name == right_name
									_:
										False
							SemanticConstIntType(left_value):
								match right:
									SemanticConstIntType(right_value):
										left_value == right_value
									_:
										False
							SemanticTupleType(left_elements):
								match right:
									SemanticTupleType(right_elements):
										type_lists_equal(left_elements, right_elements)
									SemanticNamedType(right_name, right_elements):
										(
											right_name == TYPE_NAME_TUPLE
											and type_lists_equal(left_elements, right_elements)
										)
									_:
										False
							SemanticFunctionType(left_pure, left_params, left_return):
								match right:
									SemanticFunctionType(right_pure, right_params, right_return):
										(
											left_pure == right_pure
											and type_lists_equal(left_params, right_params)
											and types_equal(left_return, right_return)
										)
									_:
										False
							SemanticSelfType:
								match right:
									SemanticSelfType:
										True
									_:
										False
							SemanticVarDimsType(left_name):
								match right:
									SemanticVarDimsType(right_name):
										left_name == right_name
									_:
										False
							SemanticRangeType(left_inner):
								match right:
									SemanticRangeType(right_inner):
										types_equal(left_inner, right_inner)
									_:
										False
							SemanticDimOpType(left_op, left_a, left_b):
								match right:
									SemanticDimOpType(right_op, right_a, right_b):
										(
											left_op == right_op
											and types_equal(left_a, right_a)
											and types_equal(left_b, right_b)
										)
									_:
										False
							SemanticMetaType(left_id):
								match right:
									SemanticMetaType(right_id):
										left_id == right_id
									_:
										False
							SemanticArrayType(_, _):
								False


private pure func type_param_names_include(type_params: List[String], name: String) -> Bool:
	stripped_name: String = strip_type_param_bounds(name)
	var index: Int = 0
	var found: Bool = False

	while index < type_params.length() and not found:
		match type_params.get(index):
			Some(param):
				found = strip_type_param_bounds(param) == stripped_name
			None:
				void

		index += 1

	found


private pure func type_lists_compatible_with_params(
	type_params: List[String],
	expected: List[SemanticType],
	actual: List[SemanticType],
) -> Bool:
	has_trailing_var_dims = match expected.get(expected.length() - 1):
		Some(SemanticVarDimsType(_)):
			True
		_:
			False

	fixed_count = if has_trailing_var_dims:
		expected.length() - 1
	else:
		expected.length()

	if (
		has_trailing_var_dims and actual.length() < fixed_count
		or not has_trailing_var_dims and expected.length() != actual.length()
	):
		False
	else:
		var index: Int = 0
		var compatible: Bool = True

		while index < fixed_count and compatible:
			match (expected.get(index), actual.get(index)):
				(Some(expected_item), Some(actual_item)):
					compatible = types_compatible_with_params(
						type_params,
						expected_item,
						actual_item,
					)
				_:
					compatible = False

			index += 1

		compatible


pure func types_compatible_with_params(
	type_params: List[String],
	expected: SemanticType,
	actual: SemanticType,
) -> Bool:
	if types_equal(expected, actual):
		True
	else:
		match expected:
			SemanticTypeVar(name):
				name == "#_" or type_param_names_include(type_params, name)
			SemanticNamedType(expected_name, expected_args):
				if (
					expected_args.length() == 0
					and ((
						expected_name == "#_"
						or type_param_names_include(type_params, expected_name)
					))
				):
					True
				else:
					match actual:
						SemanticConstIntType(_):
							expected_name == TYPE_NAME_INT and expected_args.length() == 0
						SemanticTypeVar(actual_name):
							(
								expected_name == TYPE_NAME_INT
								and expected_args.length() == 0
								and is_dim_var_name(actual_name)
							)
						SemanticRangeType(_):
							expected_name == TYPE_NAME_INT and expected_args.length() == 0
						SemanticNamedType(actual_name, actual_args):
							(
								normalize_type_name(
									expected_name,
								) == normalize_type_name(actual_name)
								and type_lists_compatible_with_params(
									type_params,
									expected_args,
									actual_args,
								)
							)
						SemanticTupleType(actual_elements):
							(
								expected_name == TYPE_NAME_TUPLE
								and type_lists_compatible_with_params(
									type_params,
									expected_args,
									actual_elements,
								)
							)
						_:
							False
			SemanticArrayType(expected_element, expected_dims):
				match array_type_parts(actual):
					Some((actual_element, actual_dims)):
						(
							types_compatible_with_params(
								type_params,
								expected_element,
								actual_element,
							)
							and type_lists_compatible_with_params(
								type_params,
								expected_dims,
								actual_dims,
							)
						)
					None:
						False
			SemanticTupleType(expected_elements):
				match actual:
					SemanticTupleType(actual_elements):
						type_lists_compatible_with_params(
							type_params,
							expected_elements,
							actual_elements,
						)
					SemanticNamedType(actual_name, actual_elements):
						(
							actual_name == TYPE_NAME_TUPLE
							and type_lists_compatible_with_params(
								type_params,
								expected_elements,
								actual_elements,
							)
						)
					_:
						False
			SemanticFunctionType(expected_pure, expected_params, expected_return):
				match actual:
					SemanticFunctionType(actual_pure, actual_params, actual_return):
						(
							(not expected_pure or actual_pure)
							and type_lists_compatible_with_params(
								type_params,
								actual_params,
								expected_params,
							)
							and types_compatible_with_params(
								type_params,
								expected_return,
								actual_return,
							)
						)
					_:
						False
			SemanticRangeType(expected_inner):
				match actual:
					SemanticRangeType(actual_inner):
						types_compatible_with_params(type_params, expected_inner, actual_inner)
					SemanticConstIntType(value):
						match normalize_dim(expected_inner):
							SemanticConstIntType(bound):
								value >= 0 and value < bound
							_:
								False
					_:
						False
			SemanticVarDimsType(name):
				type_param_names_include(type_params, name)
			_:
				False


private pure func type_list_occurs_in(var_name: String, types: List[SemanticType]) -> Bool:
	var index: Int = 0
	var found: Bool = False

	while index < types.length() and not found:
		match types.get(index):
			Some(typ):
				found = occurs_in(var_name, typ)
			None:
				void

		index += 1

	found


pure func occurs_in(var_name: String, typ: SemanticType) -> Bool:
	stripped_var: String = strip_type_param_bounds(var_name)

	match typ:
		SemanticTypeVar(name):
			name == var_name or strip_type_param_bounds(name) == stripped_var
		SemanticNamedType(name, args):
			if args.length() == 0:
				name == var_name or strip_type_param_bounds(name) == stripped_var
			else:
				type_list_occurs_in(var_name, args)
		SemanticArrayType(element, dims):
			occurs_in(var_name, element) or type_list_occurs_in(var_name, dims)
		SemanticFunctionType(_, params, return_type):
			type_list_occurs_in(var_name, params) or occurs_in(var_name, return_type)
		SemanticTupleType(elements):
			type_list_occurs_in(var_name, elements)
		SemanticRangeType(inner):
			occurs_in(var_name, inner)
		SemanticDimOpType(_, left, right):
			occurs_in(var_name, left) or occurs_in(var_name, right)
		_:
			False


private pure func normalize_dim_op(
	op: SemanticDimOp,
	left: SemanticType,
	right: SemanticType,
) -> SemanticType:
	match (left, right):
		(SemanticConstIntType(left_value), SemanticConstIntType(right_value)):
			match op:
				SemanticDimAdd:
					SemanticConstIntType(left_value + right_value)
				SemanticDimSubtract:
					SemanticConstIntType(left_value - right_value)
				SemanticDimMultiply:
					SemanticConstIntType(left_value * right_value)
				SemanticDimDivide:
					if right_value > 0 and left_value % right_value == 0:
						SemanticConstIntType(left_value / right_value)
					else:
						SemanticDimOpType(op, left, right)
		_:
			match op:
				SemanticDimAdd:
					if types_equal(left, SemanticConstIntType(0)):
						right
					else if types_equal(right, SemanticConstIntType(0)):
						left
					else:
						SemanticDimOpType(op, left, right)
				SemanticDimSubtract:
					if types_equal(left, right):
						SemanticConstIntType(0)
					else if types_equal(right, SemanticConstIntType(0)):
						left
					else:
						SemanticDimOpType(op, left, right)
				SemanticDimMultiply:
					if (
						types_equal(left, SemanticConstIntType(0))
						or types_equal(right, SemanticConstIntType(0))
					):
						SemanticConstIntType(0)
					else if types_equal(left, SemanticConstIntType(1)):
						right
					else if types_equal(right, SemanticConstIntType(1)):
						left
					else:
						SemanticDimOpType(op, left, right)
				SemanticDimDivide:
					if types_equal(left, SemanticConstIntType(0)):
						SemanticConstIntType(0)
					else if types_equal(right, SemanticConstIntType(1)):
						left
					else:
						SemanticDimOpType(op, left, right)


pure func normalize_dim(typ: SemanticType) -> SemanticType:
	match typ:
		SemanticDimOpType(op, left, right):
			normalize_dim_op(op, normalize_dim(left), normalize_dim(right))
		_:
			typ


private pure func find_non_positive_dim_in_list(types: List[SemanticType]) -> Option[Int]:
	var index: Int = 0
	var result: Option[Int] = None

	while index < types.length() and result.is_none():
		match types.get(index):
			Some(typ):
				result = find_non_positive_dim(typ)
			None:
				void

		index += 1

	result


pure func find_non_positive_dim(typ: SemanticType) -> Option[Int]:
	match normalize_dim(typ):
		SemanticConstIntType(value):
			if value <= 0:
				Some(value)
			else:
				None
		SemanticNamedType(_, args):
			find_non_positive_dim_in_list(args)
		SemanticArrayType(element, dims):
			match find_non_positive_dim(element):
				Some(value):
					Some(value)
				None:
					find_non_positive_dim_in_list(dims)
		SemanticFunctionType(_, params, return_type):
			match find_non_positive_dim_in_list(params):
				Some(value):
					Some(value)
				None:
					find_non_positive_dim(return_type)
		SemanticTupleType(elements):
			find_non_positive_dim_in_list(elements)
		SemanticRangeType(inner):
			find_non_positive_dim(inner)
		SemanticDimOpType(_, left, right):
			match find_non_positive_dim(left):
				Some(value):
					Some(value)
				None:
					find_non_positive_dim(right)
		_:
			None


private pure func visit_subst_name(visited: List[String], name: String) -> List[String]:
	stripped: String = strip_type_param_bounds(name)
	with_name: List[String] = visited.append(name)

	if stripped != name:
		with_name.append(stripped)
	else:
		with_name


private pure func subst_visited_contains(visited: List[String], name: String) -> Bool:
	stripped: String = strip_type_param_bounds(name)
	visited.contains(name) or visited.contains(stripped)


private pure func try_apply_subst_name(
	subst: List[SemanticTypeSubstEntry],
	visited: List[String],
	name: String,
	original: SemanticType,
) -> SemanticType:
	if subst_visited_contains(visited, name):
		original
	else:
		match lookup_subst(name, subst):
			Some(replacement):
				stripped: String = strip_type_param_bounds(name)

				if occurs_in(name, replacement) or occurs_in(stripped, replacement):
					replacement
				else:
					apply_subst_with_visited(
						subst,
						visit_subst_name(visited, name),
						replacement,
					)
			None:
				original


private pure func apply_subst_list(
	subst: List[SemanticTypeSubstEntry],
	visited: List[String],
	types: List[SemanticType],
) -> List[SemanticType]:
	var result: List[SemanticType] = []

	for typ in types:
		result = result.append(apply_subst_with_visited(subst, visited, typ))

	result


private pure func apply_subst_with_visited(
	subst: List[SemanticTypeSubstEntry],
	visited: List[String],
	typ: SemanticType,
) -> SemanticType:
	match typ:
		SemanticTypeVar(name):
			try_apply_subst_name(subst, visited, name, typ)
		SemanticNamedType(name, args):
			if args.length() == 0:
				try_apply_subst_name(subst, visited, name, typ)
			else:
				SemanticNamedType(
					name,
					apply_subst_list(subst, visited, args),
				)
		SemanticArrayType(element, dims):
			SemanticArrayType(
				apply_subst_with_visited(subst, visited, element),
				apply_subst_list(subst, visited, dims),
			)
		SemanticFunctionType(is_pure, params, return_type):
			SemanticFunctionType(
				is_pure,
				apply_subst_list(subst, visited, params),
				apply_subst_with_visited(subst, visited, return_type),
			)
		SemanticTupleType(elements):
			SemanticTupleType(apply_subst_list(subst, visited, elements))
		SemanticSelfType:
			try_apply_subst_name(subst, visited, "Self", typ)
		SemanticRangeType(inner):
			SemanticRangeType(apply_subst_with_visited(subst, visited, inner))
		SemanticDimOpType(op, left, right):
			normalize_dim(
				SemanticDimOpType(
					op,
					apply_subst_with_visited(subst, visited, left),
					apply_subst_with_visited(subst, visited, right),
				),
			)
		_:
			typ


private pure func types_contain_dim_op(types: List[SemanticType]) -> Bool:
	var contains_dim_op: Bool = False

	for typ in types:
		if type_contains_dim_op(typ):
			contains_dim_op = True
			break

	contains_dim_op


private pure func type_contains_dim_op(typ: SemanticType) -> Bool:
	match typ:
		SemanticNamedType(_, args):
			types_contain_dim_op(args)
		SemanticArrayType(element, dims):
			type_contains_dim_op(element) or types_contain_dim_op(dims)
		SemanticFunctionType(_, params, return_type):
			types_contain_dim_op(params) or type_contains_dim_op(return_type)
		SemanticTupleType(elements):
			types_contain_dim_op(elements)
		SemanticRangeType(inner):
			type_contains_dim_op(inner)
		SemanticDimOpType(_, _, _):
			True
		_:
			False


pure func apply_subst(subst: List[SemanticTypeSubstEntry], typ: SemanticType) -> SemanticType:
	if subst.length() == 0 and not type_contains_dim_op(typ):
		typ
	else:
		apply_subst_with_visited(subst, [], typ)


private pure func is_signed_integer_type_name(name: String) -> Bool:
	(
		name == "Int"
		or name == "Int8"
		or name == "Int16"
		or name == "Int32"
		or name == "Int64"
		or name == "Int128"
	)


private pure func is_unsigned_integer_type_name(name: String) -> Bool:
	name == "UInt8" or name == "UInt16" or name == "UInt32" or name == "UInt64" or name == "UInt128"


private pure func is_float_type_name(name: String) -> Bool:
	name == "Float" or name == "Float32" or name == "Float16"


private pure func named_type_name(typ: SemanticType) -> Option[String]:
	match typ:
		SemanticNamedType(name, args):
			if args.length() == 0:
				Some(name)
			else:
				None
		_:
			None


pure func is_any_integer_type(typ: SemanticType) -> Bool:
	match named_type_name(typ):
		Some(name):
			is_signed_integer_type_name(name) or is_unsigned_integer_type_name(name)
		None:
			False


pure func is_signed_integer_type(typ: SemanticType) -> Bool:
	match named_type_name(typ):
		Some(name):
			is_signed_integer_type_name(name)
		None:
			False


pure func is_unsigned_integer_type(typ: SemanticType) -> Bool:
	match named_type_name(typ):
		Some(name):
			is_unsigned_integer_type_name(name)
		None:
			False


pure func is_any_float_type(typ: SemanticType) -> Bool:
	match named_type_name(typ):
		Some(name):
			is_float_type_name(name)
		None:
			False


private pure func type_params_include_dim_name(type_params: List[String], name: String) -> Bool:
	var index: Int = 0
	var found: Bool = False

	while index < type_params.length() and not found:
		match type_params.get(index):
			Some(param):
				stripped: String = strip_type_param_bounds(param)
				found = stripped == name and is_dim_var_name(stripped)
			None:
				void

		index += 1

	found


pure func is_dim_type_with_params(type_params: List[String], typ: SemanticType) -> Bool:
	match typ:
		SemanticConstIntType(_):
			True
		SemanticTypeVar(name):
			is_dim_var_name(name) or type_params_include_dim_name(type_params, name)
		SemanticNamedType(name, args):
			(
				args.length() == 0
				and (is_dim_var_name(name) or type_params_include_dim_name(type_params, name))
			)
		SemanticVarDimsType(_):
			True
		SemanticRangeType(_):
			True
		SemanticDimOpType(_, left, right):
			(
				is_dim_type_with_params(type_params, left)
				and is_dim_type_with_params(type_params, right)
			)
		_:
			False


pure func is_dim_type(typ: SemanticType) -> Bool:
	is_dim_type_with_params([], typ)


private pure func collect_type_vars_from_list(types: List[SemanticType]) -> List[String]:
	var result: List[String] = []

	for typ in types:
		result = result.concat(collect_type_vars(typ))

	result


pure func collect_type_vars(typ: SemanticType) -> List[String]:
	match typ:
		SemanticTypeVar(name):
			[name]
		SemanticVarDimsType(name):
			[name]
		SemanticNamedType(name, args):
			if args.length() == 0 and is_legacy_single_letter_type_param(name):
				[name]
			else:
				collect_type_vars_from_list(args)
		SemanticArrayType(element, dims):
			collect_type_vars(element).concat(collect_type_vars_from_list(dims))
		SemanticFunctionType(_, params, return_type):
			collect_type_vars_from_list(params).concat(collect_type_vars(return_type))
		SemanticTupleType(elements):
			collect_type_vars_from_list(elements)
		SemanticRangeType(inner):
			collect_type_vars(inner)
		SemanticDimOpType(_, left, right):
			collect_type_vars(left).concat(collect_type_vars(right))
		_:
			[]


pure func is_scalar_int_value_type(typ: SemanticType) -> Bool:
	match typ:
		SemanticRangeType(_):
			True
		SemanticConstIntType(_):
			True
		SemanticDimOpType(_, _, _):
			True
		SemanticTypeVar(name):
			is_dim_var_name(name)
		SemanticNamedType(name, args):
			args.length() == 0 and is_dim_var_name(name)
		_:
			False


pure func scalar_int_value_type(typ: SemanticType) -> SemanticType:
	if is_scalar_int_value_type(typ):
		type_int()
	else:
		typ


private pure func is_scalar_array_element_name(name: String) -> Bool:
	(
		is_signed_integer_type_name(name)
		or is_unsigned_integer_type_name(name)
		or is_float_type_name(name)
		or name == "Bool"
		or name == "Char"
		or name == "String"
		or name == "Fixed"
	)


private pure func is_variadic_dim(typ: SemanticType) -> Bool:
	match typ:
		SemanticVarDimsType(_):
			True
		_:
			False


private pure func first_invalid_dim(
	type_params: List[String],
	dims: List[SemanticType],
) -> Option[SemanticType]:
	var index: Int = 0
	var result: Option[SemanticType] = None

	while index < dims.length() and result.is_none():
		match dims.get(index):
			Some(dim):
				if not is_dim_type_with_params(type_params, dim):
					result = Some(dim)
			None:
				void

		index += 1

	result


private pure func variadic_dim_count(dims: List[SemanticType]) -> Int:
	var count: Int = 0

	for dim in dims:
		if is_variadic_dim(dim):
			count += 1

	count


private pure func has_variadic_dim(dims: List[SemanticType]) -> Bool:
	variadic_dim_count(dims) > 0


private pure func last_dim_is_variadic(dims: List[SemanticType]) -> Bool:
	if dims.length() == 0:
		False
	else:
		match dims.get(dims.length() - 1):
			Some(dim):
				is_variadic_dim(dim)
			None:
				False


private pure func dimension_error_prefix(type_name: String) -> String:
	if type_name.length() == 0:
		"Array"
	else:
		type_name


private pure func invalid_dim_message(type_name: String, bad: SemanticType) -> String:
	dimension_error_prefix(
		type_name,
	) + " dimension argument must be a dimension type (#N, #3, #Ds...), got " + type_to_string(bad)


private pure func validate_variadic_dims(
	type_name: String,
	dims: List[SemanticType],
) -> Option[String]:
	if (type_name == TYPE_NAME_VECTOR or type_name == TYPE_NAME_MATRIX) and has_variadic_dim(dims):
		Some(type_name + " does not support variadic dimensions (#N...). Use T[#Ds...] instead")
	else if variadic_dim_count(dims) > 1:
		if type_name.length() == 0:
			Some((
					"Array type cannot have multiple variadic dims - use a single #N... as the last "
					+ "dimension"
				))
		else:
			Some(
				type_name + " cannot have multiple variadic dims - use a single #N... as the last dimension",
			)
	else if has_variadic_dim(dims) and not last_dim_is_variadic(dims):
		if type_name.length() == 0:
			Some("Array type: variadic dimension (#N...) must be the last dimension argument")
		else:
			Some(type_name + ": variadic dimension (#N...) must be the last dimension argument")
	else:
		None


private pure func validate_dim_list(
	type_params: List[String],
	type_name: String,
	dims: List[SemanticType],
) -> Option[String]:
	match first_invalid_dim(type_params, dims):
		Some(bad):
			Some(invalid_dim_message(type_name, bad))
		None:
			validate_variadic_dims(type_name, dims)


pure func validate_array_dims(type_params: List[String], typ: SemanticType) -> Option[String]:
	match find_non_positive_dim(typ):
		Some(value):
			Some(
				"Dimension arithmetic produces non-positive result: " + value.to_string() + " (dimensions must be >= 1)",
			)
		None:
			match typ:
				SemanticNamedType(name, args):
					if is_scalar_array_element_name(name) and args.length() > 0:
						match args.get(0):
							Some(bad):
								Some(invalid_dim_message("", bad))
							None:
								None
					else if is_tensor_family_name(name) and args.length() > 1:
						var dims: List[SemanticType] = []
						var index: Int = 1

						while index < args.length():
							match args.get(index):
								Some(dim):
									dims = dims.append(dim)
								None:
									void

							index += 1

						validate_dim_list(type_params, name, dims)
					else:
						None
				SemanticArrayType(_, dims):
					validate_dim_list(type_params, "", dims)
				_:
					None
