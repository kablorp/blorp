-- Explicit per-compilation context for the Blorp-owned frontend.
--
-- The OCaml compiler still owns the mutable production session today. This
-- module models the Blorp side as an ordinary value so later typecheck/env
-- slices can thread state explicitly instead of growing another ambient
-- session.
import:
	../stage_04_modules/loaded_module:
		CompilerModuleOrigin(
			CompilerNativePackageModule,
			CompilerSourcePackageModule,
			CompilerStdlibModule,
			CompilerUserModule,
		),
	dim_solver:
		DimSolveResult(DimBindMeta, DimBindVar, DimContradiction, DimSolved, DimStuck),
		dim_solve,
	semantic_type:
		SemanticType(
			SemanticArrayType,
			SemanticConstIntType,
			SemanticDimOpType,
			SemanticFunctionType,
			SemanticMetaType,
			SemanticNamedType,
			SemanticRangeType,
			SemanticSelfType,
			SemanticTupleType,
			SemanticTypeVar,
			SemanticVarDimsType,
		),
		SemanticTypeSubstEntry,
		array_type_parts,
		is_dim_var_name,
		normalize_dim,
		normalize_type_name,
		occurs_in,
		strip_type_param_bounds,
		type_subst_entry,
		types_equal,


record SourcePackage {
	package_alias: String,
	package_name: String,
	package_root: String,
	source_dir: String,
	exports: List[String]
}


record TypeHomeEntry {
	type_name: String,
	modules: List[String]
}


record ResourceCleanupEntry {
	type_name: String,
	cleanup_function: String
}


record TraitHomeEntry {
	trait_name: String,
	module_name: String
}


record TraitHomeConflictInfo {
	trait_name: String,
	existing_module: String,
	new_module: String
}


record MetaBindingEntry {
	meta_id: Int,
	binding: SemanticType
}


record Context {
	search_paths: List[String],
	package_roots: List[String],
	source_packages: List[SourcePackage],
	type_homes: List[TypeHomeEntry],
	resource_cleanups: List[ResourceCleanupEntry],
	trait_homes: List[TraitHomeEntry],
	meta_origins: List[String],
	meta_bindings: List[MetaBindingEntry],
	def_id_counter: Int,
	fresh_meta_counter: Int,
	lower_destruct_counter: Int,
	lower_param_counter: Int,
	lower_question_bind_counter: Int,
	lower_resource_counter: Int,
	lower_task_scope_counter: Int,
	lower_current_task_scope_id: Int,
	desugar_counter: Int,
	ssa_mut_counter: Int
}


union RegisterTraitHomeResult:
	TraitHomeRegistered(Context)
	TraitHomeConflict(TraitHomeConflictInfo)


record DefIdStep {
	context: Context,
	def_id: Int
}


record FreshMetaStep {
	context: Context,
	meta_type: SemanticType
}


record UnifyStep {
	context: Context,
	subst: List[SemanticTypeSubstEntry]
}


private record UnifyOptions {
	symmetric: Bool,
	type_params: List[String],
	rigid_vars: List[String]
}


pure func context_empty() -> Context:
	{
		search_paths = [],
		package_roots = [],
		source_packages = [],
		type_homes = [],
		resource_cleanups = [],
		trait_homes = [],
		meta_origins = [],
		meta_bindings = [],
		def_id_counter = 0,
		fresh_meta_counter = 0,
		lower_destruct_counter = 0,
		lower_param_counter = 0,
		lower_question_bind_counter = 0,
		lower_resource_counter = 0,
		lower_task_scope_counter = 1,
		lower_current_task_scope_id = 0,
		desugar_counter = 0,
		ssa_mut_counter = 0
	}


pure func source_package_origin(name: String) -> Option[CompilerModuleOrigin]:
	trimmed: String = name.trim()

	if trimmed.length() == 0:
		None
	else:
		Some(CompilerSourcePackageModule(trimmed))


pure func native_package_origin(name: String) -> Option[CompilerModuleOrigin]:
	trimmed: String = name.trim()

	if trimmed.length() == 0:
		None
	else:
		Some(CompilerNativePackageModule(trimmed))


pure func module_origin_is_std(origin: CompilerModuleOrigin) -> Bool:
	match origin:
		CompilerStdlibModule:
			True
		_:
			False


pure func module_origin_is_package(origin: CompilerModuleOrigin) -> Bool:
	match origin:
		CompilerNativePackageModule(_):
			True
		CompilerSourcePackageModule(_):
			True
		_:
			False


pure func module_origin_allows_builtin(origin: CompilerModuleOrigin) -> Bool:
	match origin:
		CompilerStdlibModule:
			True
		_:
			False


pure func module_origin_allows_foreign(origin: CompilerModuleOrigin) -> Bool:
	match origin:
		CompilerNativePackageModule(_):
			True
		CompilerUserModule:
			True
		_:
			False


pure func module_origin_label(origin: CompilerModuleOrigin) -> String:
	match origin:
		CompilerStdlibModule:
			"standard library"
		CompilerUserModule:
			"user module"
		CompilerNativePackageModule(package_id):
			"native package '" + package_id + "'"
		CompilerSourcePackageModule(package_id):
			"source package '" + package_id + "'"


private pure func add_unique_sorted_string(values: List[String], value: String) -> List[String]:
	if values.contains(value):
		values
	else:
		values
			.append(value)
			.sort()


private pure func find_type_home_entry(
	context: Context,
	type_name: String,
) -> Option[TypeHomeEntry]:
	var result: Option[TypeHomeEntry] = None

	for entry in context.type_homes:
		if entry.type_name == type_name:
			result = Some(entry)
			break

	result


private pure func replace_type_home_entry(
	entries: List[TypeHomeEntry],
	replacement: TypeHomeEntry,
) -> List[TypeHomeEntry]:
	var result: List[TypeHomeEntry] = []
	var replaced: Bool = False

	for entry in entries:
		if entry.type_name == replacement.type_name:
			result = result.append(replacement)
			replaced = True
		else:
			result = result.append(entry)

	if replaced:
		result
	else:
		result.append(replacement)


pure func register_type_home(context: Context, type_name: String, module_name: String) -> Context:
	next_entry: TypeHomeEntry = match find_type_home_entry(context, type_name):
		Some(entry):
			{ entry | modules = add_unique_sorted_string(entry.modules, module_name) }
		None:
			{
				type_name = type_name,
				modules = [module_name]
			}

	{ context | type_homes = replace_type_home_entry(context.type_homes, next_entry) }


pure func find_type_homes(context: Context, type_name: String) -> List[String]:
	match find_type_home_entry(context, type_name):
		Some(entry):
			entry.modules
		None:
			[]


pure func find_type_home(context: Context, type_name: String) -> Option[String]:
	homes: List[String] = find_type_homes(context, type_name)

	if homes.length() == 1:
		homes.get(0)
	else:
		None


private pure func replace_resource_cleanup_entry(
	entries: List[ResourceCleanupEntry],
	replacement: ResourceCleanupEntry,
) -> List[ResourceCleanupEntry]:
	var result: List[ResourceCleanupEntry] = []
	var replaced: Bool = False

	for entry in entries:
		if entry.type_name == replacement.type_name:
			result = result.append(replacement)
			replaced = True
		else:
			result = result.append(entry)

	if replaced:
		result
	else:
		result.append(replacement)


pure func register_resource_cleanup(
	context: Context,
	type_name: String,
	cleanup_function: String,
) -> Context:
	entry: ResourceCleanupEntry = {
		type_name = type_name,
		cleanup_function = cleanup_function
	}
	{ context |
		resource_cleanups = replace_resource_cleanup_entry(context.resource_cleanups, entry)
	}


pure func find_resource_cleanup(context: Context, type_name: String) -> Option[String]:
	var result: Option[String] = None

	for entry in context.resource_cleanups:
		if entry.type_name == type_name:
			result = Some(entry.cleanup_function)
			break

	result


pure func find_trait_home(context: Context, trait_name: String) -> Option[String]:
	var result: Option[String] = None

	for entry in context.trait_homes:
		if entry.trait_name == trait_name:
			result = Some(entry.module_name)
			break

	result


pure func register_trait_home(
	context: Context,
	trait_name: String,
	module_name: String,
) -> RegisterTraitHomeResult:
	match find_trait_home(context, trait_name):
		Some(existing_module):
			if existing_module == module_name:
				TraitHomeRegistered(context)
			else:
				TraitHomeConflict({
					trait_name = trait_name,
					existing_module = existing_module,
					new_module = module_name,
				})
		None:
			entry: TraitHomeEntry = {
				trait_name = trait_name,
				module_name = module_name
			}
			TraitHomeRegistered({ context | trait_homes = context.trait_homes.append(entry) })


pure func meta_origin_name(context: Context, meta_id: Int) -> String:
	match context.meta_origins.get(meta_id):
		Some(origin):
			origin
		None:
			"?m" + meta_id.to_string()


private pure func find_meta_binding_entry(
	context: Context,
	meta_id: Int,
) -> Option[MetaBindingEntry]:
	var result: Option[MetaBindingEntry] = None

	for entry in context.meta_bindings:
		if entry.meta_id == meta_id:
			result = Some(entry)
			break

	result


pure func lookup_meta(context: Context, meta_id: Int) -> Option[SemanticType]:
	match find_meta_binding_entry(context, meta_id):
		Some(entry):
			Some(entry.binding)
		None:
			None


private pure func context_dim_meta_bindings(context: Context) -> List[(Int, SemanticType)]:
	context.meta_bindings.map(func(entry): (entry.meta_id, entry.binding))


private pure func replace_meta_binding_entry(
	entries: List[MetaBindingEntry],
	replacement: MetaBindingEntry,
) -> List[MetaBindingEntry]:
	var result: List[MetaBindingEntry] = []
	var replaced: Bool = False

	for entry in entries:
		if entry.meta_id == replacement.meta_id:
			result = result.append(replacement)
			replaced = True
		else:
			result = result.append(entry)

	if replaced:
		result
	else:
		result.append(replacement)


pure func bind_meta(context: Context, meta_id: Int, typ: SemanticType) -> Context:
	entry: MetaBindingEntry = {
		meta_id = meta_id,
		binding = typ
	}

	{ context | meta_bindings = replace_meta_binding_entry(context.meta_bindings, entry) }


private pure func head_resolve_seen(
	context: Context,
	seen: List[Int],
	typ: SemanticType,
) -> SemanticType:
	match typ:
		SemanticMetaType(meta_id):
			if seen.contains(meta_id):
				typ
			else:
				match lookup_meta(context, meta_id):
					Some(binding):
						head_resolve_seen(
							context,
							seen.append(meta_id),
							binding,
						)
					None:
						typ
		_:
			typ


pure func head_resolve(context: Context, typ: SemanticType) -> SemanticType:
	head_resolve_seen(context, [], typ)


private pure func occurs_meta_in_list(
	context: Context,
	target_meta_id: Int,
	seen: List[Int],
	types: List[SemanticType],
) -> Bool:
	var result: Bool = False

	for typ in types:
		if occurs_meta_seen(context, target_meta_id, seen, typ):
			result = True
			break

	result


private pure func occurs_meta_seen(
	context: Context,
	target_meta_id: Int,
	seen: List[Int],
	typ: SemanticType,
) -> Bool:
	match typ:
		SemanticMetaType(meta_id):
			if meta_id == target_meta_id:
				True
			else if seen.contains(meta_id):
				False
			else:
				match lookup_meta(context, meta_id):
					Some(binding):
						occurs_meta_seen(
							context,
							target_meta_id,
							seen.append(meta_id),
							binding,
						)
					None:
						False
		SemanticNamedType(_, args):
			occurs_meta_in_list(context, target_meta_id, seen, args)
		SemanticArrayType(element, dims):
			(
				occurs_meta_seen(context, target_meta_id, seen, element)
				or occurs_meta_in_list(context, target_meta_id, seen, dims)
			)
		SemanticFunctionType(_, params, return_type):
			(
				occurs_meta_in_list(context, target_meta_id, seen, params)
				or occurs_meta_seen(context, target_meta_id, seen, return_type)
			)
		SemanticTupleType(elements):
			occurs_meta_in_list(context, target_meta_id, seen, elements)
		SemanticRangeType(inner):
			occurs_meta_seen(context, target_meta_id, seen, inner)
		SemanticDimOpType(_, left, right):
			(
				occurs_meta_seen(context, target_meta_id, seen, left)
				or occurs_meta_seen(context, target_meta_id, seen, right)
			)
		_:
			False


pure func occurs_meta(context: Context, target_meta_id: Int, typ: SemanticType) -> Bool:
	occurs_meta_seen(context, target_meta_id, [], typ)


private pure func resolve_type_meta_list(
	context: Context,
	seen: List[Int],
	types: List[SemanticType],
	finalize_unbound: Bool,
) -> List[SemanticType]:
	var result: List[SemanticType] = []

	for typ in types:
		result = result.append(resolve_type_metas_seen(context, seen, typ, finalize_unbound))

	result


private pure func unbound_meta_type(
	context: Context,
	meta_id: Int,
	finalize_unbound: Bool,
) -> SemanticType:
	if finalize_unbound:
		SemanticTypeVar(meta_origin_name(context, meta_id))
	else:
		SemanticMetaType(meta_id)


private pure func resolve_type_metas_seen(
	context: Context,
	seen: List[Int],
	typ: SemanticType,
	finalize_unbound: Bool,
) -> SemanticType:
	match typ:
		SemanticMetaType(meta_id):
			if seen.contains(meta_id):
				unbound_meta_type(context, meta_id, finalize_unbound)
			else:
				match lookup_meta(context, meta_id):
					Some(binding):
						resolve_type_metas_seen(
							context,
							seen.append(meta_id),
							binding,
							finalize_unbound,
						)
					None:
						unbound_meta_type(context, meta_id, finalize_unbound)
		SemanticNamedType(name, args):
			SemanticNamedType(
				name,
				resolve_type_meta_list(context, seen, args, finalize_unbound),
			)
		SemanticArrayType(element, dims):
			SemanticArrayType(
				resolve_type_metas_seen(context, seen, element, finalize_unbound),
				resolve_type_meta_list(context, seen, dims, finalize_unbound),
			)
		SemanticFunctionType(is_pure, params, return_type):
			SemanticFunctionType(
				is_pure,
				resolve_type_meta_list(context, seen, params, finalize_unbound),
				resolve_type_metas_seen(context, seen, return_type, finalize_unbound),
			)
		SemanticTupleType(elements):
			SemanticTupleType(resolve_type_meta_list(context, seen, elements, finalize_unbound))
		SemanticRangeType(inner):
			SemanticRangeType(resolve_type_metas_seen(context, seen, inner, finalize_unbound))
		SemanticDimOpType(op, left, right):
			SemanticDimOpType(
				op,
				resolve_type_metas_seen(context, seen, left, finalize_unbound),
				resolve_type_metas_seen(context, seen, right, finalize_unbound),
			)
		_:
			typ


pure func resolve_type_metas(context: Context, typ: SemanticType) -> SemanticType:
	resolve_type_metas_seen(context, [], typ, False)


pure func zonk_type(context: Context, typ: SemanticType) -> SemanticType:
	resolve_type_metas_seen(context, [], typ, True)


private pure func unify_options(
	symmetric: Bool,
	type_params: List[String],
	rigid_vars: List[String],
) -> UnifyOptions:
	{
		symmetric = symmetric,
		type_params = type_params,
		rigid_vars = rigid_vars
	}


private pure func unify_subst_list_lookup(
	subst: List[SemanticTypeSubstEntry],
	name: String,
) -> Option[SemanticType]:
	var result: Option[SemanticType] = None

	for entry in subst:
		if entry.var_name == name:
			result = Some(entry.concrete_type)
			break

	result


pure func unify_subst_lookup(step: UnifyStep, name: String) -> Option[SemanticType]:
	unify_subst_list_lookup(step.subst, name)


private pure func unify_param_name_is_var(options: UnifyOptions, name: String) -> Bool:
	stripped_name: String = strip_type_param_bounds(name)
	var found: Bool = False

	for param in options.type_params:
		stripped_param: String = strip_type_param_bounds(param)

		if stripped_param == stripped_name:
			found = True
			break

	found


private pure func unify_name_is_rigid(options: UnifyOptions, name: String) -> Bool:
	stripped_name: String = strip_type_param_bounds(name)
	var found: Bool = False

	for rigid in options.rigid_vars:
		stripped_rigid: String = strip_type_param_bounds(rigid)

		if rigid == name or stripped_rigid == stripped_name:
			found = True
			break

	found


private pure func unify_is_int_type(typ: SemanticType) -> Bool:
	match typ:
		SemanticNamedType(name, args):
			name == "Int" and args.length() == 0
		_:
			False


private pure func unify_is_literal_string_type(typ: SemanticType) -> Bool:
	match typ:
		SemanticNamedType(name, args):
			name == "LiteralString" and args.length() == 0
		_:
			False


private pure func unify_is_string_type(typ: SemanticType) -> Bool:
	match typ:
		SemanticNamedType(name, args):
			name == "String" and args.length() == 0
		_:
			False


private pure func unify_is_variadic_dims(typ: SemanticType) -> Bool:
	match typ:
		SemanticVarDimsType(_):
			True
		_:
			False


private pure func unify_try_bind(
	step: UnifyStep,
	name: String,
	typ: SemanticType,
) -> Option[UnifyStep]:
	match unify_subst_list_lookup(step.subst, name):
		Some(existing):
			if types_equal(existing, typ):
				Some(step)
			else:
				None
		None:
			if occurs_in(name, typ):
				None
			else:
				Some({ step | subst = step.subst.append(type_subst_entry(name, typ)) })


private pure func unify_bind_meta(
	step: UnifyStep,
	meta_id: Int,
	typ: SemanticType,
) -> Option[UnifyStep]:
	if occurs_meta(step.context, meta_id, typ):
		None
	else:
		Some({ step | context = bind_meta(step.context, meta_id, typ) })


private pure func unify_args_at(
	options: UnifyOptions,
	step: UnifyStep,
	left_args: List[SemanticType],
	right_args: List[SemanticType],
	left_index: Int,
	right_index: Int,
) -> Option[UnifyStep]:
	if left_index == left_args.length() and right_index == right_args.length():
		Some(step)
	else if left_index < left_args.length():
		match left_args.get(left_index):
			Some(left):
				if unify_is_variadic_dims(left) and left_index == left_args.length() - 1:
					Some(step)
				else if right_index < right_args.length():
					match right_args.get(right_index):
						Some(right):
							if (
								options.symmetric
								and unify_is_variadic_dims(right)
								and right_index == right_args.length() - 1
							):
								Some(step)
							else:
								match unify_go(options, step, left, right):
									Some(next_step):
										unify_args_at(
											options,
											next_step,
											left_args,
											right_args,
											left_index + 1,
											right_index + 1,
										)
									None:
										None
						None:
							None
				else:
					None
			None:
				None
	else if options.symmetric and right_index < right_args.length():
		match right_args.get(right_index):
			Some(right):
				if unify_is_variadic_dims(right) and right_index == right_args.length() - 1:
					Some(step)
				else:
					None
			None:
				None
	else:
		None


private pure func unify_args(
	options: UnifyOptions,
	step: UnifyStep,
	left_args: List[SemanticType],
	right_args: List[SemanticType],
) -> Option[UnifyStep]:
	unify_args_at(options, step, left_args, right_args, 0, 0)


private pure func unify_arrays(
	options: UnifyOptions,
	step: UnifyStep,
	left: SemanticType,
	right: SemanticType,
) -> Option[UnifyStep]:
	match (array_type_parts(left), array_type_parts(right)):
		(Some(left_parts), Some(right_parts)):
			match unify_go(options, step, left_parts[0], right_parts[0]):
				Some(element_step):
					unify_args(options, element_step, left_parts[1], right_parts[1])
				None:
					None
		_:
			None


private pure func unify_range_types(
	options: UnifyOptions,
	step: UnifyStep,
	left: SemanticType,
	right: SemanticType,
) -> Option[UnifyStep]:
	match (left, right):
		(SemanticRangeType(SemanticConstIntType(left_value)), SemanticRangeType(SemanticConstIntType(right_value))):
			if right_value <= left_value:
				Some(step)
			else:
				None
		(SemanticRangeType(left_inner), SemanticRangeType(right_inner)):
			unify_go(options, step, left_inner, right_inner)
		_:
			None


private pure func unify_named_types(
	options: UnifyOptions,
	step: UnifyStep,
	left_name: String,
	left_args: List[SemanticType],
	right_name: String,
	right_args: List[SemanticType],
) -> Option[UnifyStep]:
	if normalize_type_name(left_name) != normalize_type_name(right_name):
		None
	else:
		unify_args(options, step, left_args, right_args)


private pure func unify_tuples(
	options: UnifyOptions,
	step: UnifyStep,
	left_elements: List[SemanticType],
	right_elements: List[SemanticType],
) -> Option[UnifyStep]:
	if left_elements.length() != right_elements.length():
		None
	else:
		unify_args(options, step, left_elements, right_elements)


private pure func unify_functions(
	options: UnifyOptions,
	step: UnifyStep,
	left_is_pure: Bool,
	left_params: List[SemanticType],
	left_return: SemanticType,
	right_is_pure: Bool,
	right_params: List[SemanticType],
	right_return: SemanticType,
) -> Option[UnifyStep]:
	if left_is_pure and not right_is_pure:
		None
	else if left_params.length() != right_params.length():
		None
	else:
		match unify_args(options, step, left_params, right_params):
			Some(params_step):
				unify_go(options, params_step, left_return, right_return)
			None:
				None


private pure func unify_dim_arithmetic(
	options: UnifyOptions,
	step: UnifyStep,
	left: SemanticType,
	right: SemanticType,
) -> Option[UnifyStep]:
	match dim_solve(context_dim_meta_bindings(step.context), left, right):
		DimSolved:
			Some(step)
		DimBindMeta(meta_id, value):
			unify_bind_meta(step, meta_id, value)
		DimBindVar(name, value):
			unify_try_bind(step, name, value)
		DimContradiction:
			None
		DimStuck:
			normalized_left: SemanticType = normalize_dim(left)
			normalized_right: SemanticType = normalize_dim(right)

			if types_equal(normalized_left, normalized_right):
				Some(step)
			else if (
				not types_equal(normalized_left, left)
				or not types_equal(normalized_right, right)
			):
				unify_go(options, step, normalized_left, normalized_right)
			else:
				None


private pure func unify_left_named(
	options: UnifyOptions,
	step: UnifyStep,
	left: SemanticType,
	left_name: String,
	left_args: List[SemanticType],
	other: SemanticType,
) -> Option[UnifyStep]:
	if left_args.length() == 0 and unify_param_name_is_var(options, left_name):
		unify_try_bind(step, left_name, other)
	else if left_args.length() == 0 and unify_name_is_rigid(options, left_name):
		None
	else:
		match other:
			SemanticNamedType(right_name, right_args):
				if (
					options.symmetric
					and right_args.length() == 0
					and unify_param_name_is_var(options, right_name)
				):
					unify_try_bind(step, right_name, left)
				else if right_args.length() == 0 and unify_name_is_rigid(options, right_name):
					None
				else:
					unify_named_types(options, step, left_name, left_args, right_name, right_args)
			SemanticTupleType(right_elements):
				if left_name == "Tuple":
					unify_tuples(options, step, left_args, right_elements)
				else:
					unify_arrays(options, step, left, other)
			SemanticRangeType(_):
				if unify_is_int_type(left):
					Some(step)
				else:
					unify_arrays(options, step, left, other)
			_:
				unify_arrays(options, step, left, other)


private pure func unify_right_named(
	options: UnifyOptions,
	step: UnifyStep,
	other: SemanticType,
	right: SemanticType,
	right_name: String,
	right_args: List[SemanticType],
) -> Option[UnifyStep]:
	if (
		options.symmetric
		and right_args.length() == 0
		and unify_param_name_is_var(options, right_name)
	):
		unify_try_bind(step, right_name, other)
	else if right_args.length() == 0 and unify_name_is_rigid(options, right_name):
		None
	else:
		match other:
			SemanticRangeType(_):
				if options.symmetric and unify_is_int_type(right):
					Some(step)
				else:
					unify_arrays(options, step, other, right)
			SemanticTupleType(left_elements):
				if right_name == "Tuple":
					unify_tuples(options, step, left_elements, right_args)
				else:
					unify_arrays(options, step, other, right)
			_:
				unify_arrays(options, step, other, right)


private pure func unify_structural(
	options: UnifyOptions,
	step: UnifyStep,
	left: SemanticType,
	right: SemanticType,
) -> Option[UnifyStep]:
	match left:
		SemanticNamedType(left_name, left_args):
			unify_left_named(options, step, left, left_name, left_args, right)
		_:
			match right:
				SemanticNamedType(right_name, right_args):
					unify_right_named(options, step, left, right, right_name, right_args)
				_:
					match (left, right):
						(SemanticArrayType(_, _), SemanticArrayType(_, _)):
							unify_arrays(options, step, left, right)
						(SemanticFunctionType(left_is_pure, left_params, left_return), SemanticFunctionType(right_is_pure, right_params, right_return)):
							unify_functions(
								options,
								step,
								left_is_pure,
								left_params,
								left_return,
								right_is_pure,
								right_params,
								right_return,
							)
						(SemanticTupleType(left_elements), SemanticTupleType(right_elements)):
							unify_tuples(options, step, left_elements, right_elements)
						(SemanticRangeType(_), SemanticRangeType(_)):
							unify_range_types(options, step, left, right)
						(_, SemanticRangeType(_)):
							if unify_is_int_type(left):
								Some(step)
							else:
								None
						(SemanticRangeType(_), _):
							if options.symmetric and unify_is_int_type(right):
								Some(step)
							else:
								None
						(SemanticSelfType, SemanticSelfType):
							Some(step)
						_:
							None


private pure func unify_right_or_structural(
	options: UnifyOptions,
	step: UnifyStep,
	left: SemanticType,
	right: SemanticType,
) -> Option[UnifyStep]:
	match right:
		SemanticMetaType(meta_id):
			unify_bind_meta(step, meta_id, left)
		SemanticTypeVar(name):
			if unify_name_is_rigid(options, name):
				if is_dim_var_name(name) and unify_is_int_type(left):
					Some(step)
				else:
					None
			else:
				if options.symmetric:
					unify_try_bind(step, name, left)
				else:
					None
		_:
			unify_structural(options, step, left, right)


private pure func unify_go(
	options: UnifyOptions,
	step: UnifyStep,
	raw_left: SemanticType,
	raw_right: SemanticType,
) -> Option[UnifyStep]:
	left: SemanticType = head_resolve(step.context, raw_left)
	right: SemanticType = head_resolve(step.context, raw_right)

	if types_equal(left, right):
		Some(step)
	else if unify_is_string_type(left) and unify_is_literal_string_type(right):
		Some(step)
	else if (
		options.symmetric
		and unify_is_literal_string_type(left)
		and unify_is_string_type(right)
	):
		Some(step)
	else if unify_is_int_type(left) and unify_is_dim_var_type(right):
		Some(step)
	else if (
		options.symmetric
		and unify_is_dim_var_type(left)
		and unify_is_int_type(right)
	):
		Some(step)
	else if unify_is_int_type(left) and unify_is_const_int_type(right):
		Some(step)
	else if (
		options.symmetric
		and unify_is_const_int_type(left)
		and unify_is_int_type(right)
	):
		Some(step)
	else if unify_is_dim_expr_type(left) or unify_is_dim_expr_type(right):
		unify_dim_arithmetic(options, step, left, right)
	else:
		match left:
			SemanticMetaType(meta_id):
				unify_bind_meta(step, meta_id, right)
			SemanticTypeVar(name):
				if unify_name_is_rigid(options, name):
					if is_dim_var_name(name) and unify_is_int_type(right):
						Some(step)
					else:
						None
				else:
					unify_try_bind(step, name, right)
			_:
				unify_right_or_structural(options, step, left, right)


private pure func unify_is_dim_var_type(typ: SemanticType) -> Bool:
	match typ:
		SemanticTypeVar(name):
			is_dim_var_name(name)
		SemanticNamedType(name, args):
			args.length() == 0 and is_dim_var_name(name)
		_:
			False


private pure func unify_is_const_int_type(typ: SemanticType) -> Bool:
	match typ:
		SemanticConstIntType(_):
			True
		_:
			False


private pure func unify_is_dim_expr_type(typ: SemanticType) -> Bool:
	match typ:
		SemanticDimOpType(_, _, _):
			True
		_:
			False


private pure func unify_with_options(
	context: Context,
	options: UnifyOptions,
	left: SemanticType,
	right: SemanticType,
) -> Option[UnifyStep]:
	unify_go(
		options,
		{
			context = context,
			subst = []
		},
		left,
		right,
	)


pure func unify(context: Context, left: SemanticType, right: SemanticType) -> Option[UnifyStep]:
	unify_with_options(
		context,
		unify_options(False, [], []),
		left,
		right,
	)


pure func unify_symmetric(
	context: Context,
	left: SemanticType,
	right: SemanticType,
) -> Option[UnifyStep]:
	unify_with_options(
		context,
		unify_options(True, [], []),
		left,
		right,
	)


pure func unify_with_type_params(
	context: Context,
	type_params: List[String],
	left: SemanticType,
	right: SemanticType,
) -> Option[UnifyStep]:
	unify_with_options(
		context,
		unify_options(False, type_params, []),
		left,
		right,
	)


pure func unify_symmetric_with_type_params(
	context: Context,
	type_params: List[String],
	left: SemanticType,
	right: SemanticType,
) -> Option[UnifyStep]:
	unify_with_options(
		context,
		unify_options(True, type_params, []),
		left,
		right,
	)


pure func types_compatible_in_context(
	context: Context,
	expected: SemanticType,
	actual: SemanticType,
) -> Bool:
	unify(context, expected, actual).is_some()


pure func types_compatible_with_params_in_context(
	context: Context,
	type_params: List[String],
	expected: SemanticType,
	actual: SemanticType,
) -> Bool:
	unify_with_type_params(context, type_params, expected, actual).is_some()


pure func types_bidirectional_in_context(
	context: Context,
	left: SemanticType,
	right: SemanticType,
) -> Bool:
	unify_symmetric(context, left, right).is_some()


pure func types_compatible_rigid_in_context(
	context: Context,
	rigid_vars: List[String],
	expected: SemanticType,
	actual: SemanticType,
) -> Bool:
	unify_with_options(
		context,
		unify_options(False, [], rigid_vars),
		expected,
		actual,
	).is_some()


pure func mint_def_id(context: Context) -> DefIdStep:
	{
		context = { context | def_id_counter = context.def_id_counter + 1 },
		def_id = context.def_id_counter
	}


pure func fresh_meta_with_origin(context: Context, origin: String) -> FreshMetaStep:
	meta_id: Int = context.fresh_meta_counter

	meta_origin: String = if origin.length() == 0:
		"?"
	else:
		origin

	{
		context = { context |
			fresh_meta_counter = meta_id + 1,
			meta_origins = context.meta_origins.append(meta_origin)
		},
		meta_type = SemanticMetaType(meta_id)
	}


pure func fresh_meta(context: Context) -> FreshMetaStep:
	fresh_meta_with_origin(context, "?")


pure func reset_meta(context: Context) -> Context:
	{ context |
		fresh_meta_counter = 0,
		meta_origins = [],
		meta_bindings = []
	}


pure func reset_core_counters(context: Context) -> Context:
	{ context |
		def_id_counter = 0,
		lower_destruct_counter = 0,
		lower_param_counter = 0,
		lower_question_bind_counter = 0,
		lower_resource_counter = 0,
		lower_task_scope_counter = 1,
		lower_current_task_scope_id = 0,
		desugar_counter = 0,
		ssa_mut_counter = 0
	}
