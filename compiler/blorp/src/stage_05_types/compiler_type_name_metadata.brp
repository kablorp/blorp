pure func compiler_is_stream_type_name(name: String) -> Bool:
	match name:
		"Stream":
			True
		"std_stream__Stream":
			True
		"std/stream::Stream":
			True
		_:
			False


pure func compiler_is_fallible_stream_type_name(name: String) -> Bool:
	match name:
		"FallibleStream":
			True
		"std_stream__FallibleStream":
			True
		"std/stream::FallibleStream":
			True
		_:
			False


pure func compiler_is_one_shot_stream_type_name(name: String) -> Bool:
	compiler_is_stream_type_name(name) or compiler_is_fallible_stream_type_name(name)


pure func compiler_is_resource_source_type_name(name: String) -> Bool:
	match name:
		"ResourceSource":
			True
		"std_stream__ResourceSource":
			True
		"std/stream::ResourceSource":
			True
		_:
			False
