	"alias",
	"where",
]


-- Nominal types imported by std/prelude that are not compiler primitives.
--
-- Their identity cannot depend on whether a compiler API happened to include
-- the providing std module's source. In particular, synthetic typecheck graph
-- requests still have the same prelude as ordinary source compilation. Keep
-- the provider, arity, and resource capability closed over this enum so later
-- phases never reconstruct those facts from strings.
enum CompilerPreludeType:
	CompilerPreludeDict
	CompilerPreludeDirectory
	CompilerPreludeDirectoryEntry
	CompilerPreludeDirectoryEntryKind
	CompilerPreludeFileAppender
	CompilerPreludeFileReadAppender
	CompilerPreludeFileReadWriter
	CompilerPreludeFileReader
	CompilerPreludeFileWriter
	CompilerPreludeIOError
	CompilerPreludeList
	CompilerPreludeParallelList
	CompilerPreludeParallelMatrix
	CompilerPreludeParallelVector
	CompilerPreludeRange
	CompilerPreludeSet


pure func compiler_prelude_type(name: String) -> Option[CompilerPreludeType]:
	match name:
		"Dict":
			Some(CompilerPreludeDict)
		"Directory":
			Some(CompilerPreludeDirectory)
		"DirectoryEntry":
			Some(CompilerPreludeDirectoryEntry)
		"DirectoryEntryKind":
			Some(CompilerPreludeDirectoryEntryKind)
		"FileAppender":
			Some(CompilerPreludeFileAppender)
		"FileReadAppender":
			Some(CompilerPreludeFileReadAppender)
		"FileReadWriter":
			Some(CompilerPreludeFileReadWriter)
		"FileReader":
			Some(CompilerPreludeFileReader)
		"FileWriter":
			Some(CompilerPreludeFileWriter)
		"IOError":
			Some(CompilerPreludeIOError)
		"List":
			Some(CompilerPreludeList)
		"ParallelList":
			Some(CompilerPreludeParallelList)
		"ParallelMatrix":
			Some(CompilerPreludeParallelMatrix)
		"ParallelVector":
			Some(CompilerPreludeParallelVector)
		"Range":
			Some(CompilerPreludeRange)
		"Set":
			Some(CompilerPreludeSet)
		_:
			None


pure func compiler_prelude_type_name(typ: CompilerPreludeType) -> String:
	match typ:
		CompilerPreludeDict:
			"Dict"
		CompilerPreludeDirectory:
			"Directory"
		CompilerPreludeDirectoryEntry:
			"DirectoryEntry"
		CompilerPreludeDirectoryEntryKind:
			"DirectoryEntryKind"
		CompilerPreludeFileAppender:
			"FileAppender"
		CompilerPreludeFileReadAppender:
			"FileReadAppender"
		CompilerPreludeFileReadWriter:
			"FileReadWriter"
		CompilerPreludeFileReader:
			"FileReader"
		CompilerPreludeFileWriter:
			"FileWriter"
		CompilerPreludeIOError:
			"IOError"
		CompilerPreludeList:
			"List"
		CompilerPreludeParallelList:
			"ParallelList"
		CompilerPreludeParallelMatrix:
			"ParallelMatrix"
		CompilerPreludeParallelVector:
			"ParallelVector"
		CompilerPreludeRange:
			"Range"
		CompilerPreludeSet:
			"Set"


pure func compiler_prelude_type_module_path(typ: CompilerPreludeType) -> String:
	match typ:
		CompilerPreludeDict:
			"dict"
		CompilerPreludeDirectory:
			"fs"
		CompilerPreludeDirectoryEntry:
			"fs"
		CompilerPreludeDirectoryEntryKind:
			"fs"
		CompilerPreludeFileAppender:
			"fs"
		CompilerPreludeFileReadAppender:
			"fs"
		CompilerPreludeFileReadWriter:
			"fs"
		CompilerPreludeFileReader:
			"fs"
		CompilerPreludeFileWriter:
			"fs"
		CompilerPreludeIOError:
			"fs"
		CompilerPreludeList:
			"list"
		CompilerPreludeParallelList:
			"list"
		CompilerPreludeParallelMatrix:
			"matrix"
		CompilerPreludeParallelVector:
			"vector"
		CompilerPreludeRange:
			"range"
		CompilerPreludeSet:
			"set"


pure func compiler_prelude_type_arity(typ: CompilerPreludeType) -> Int:
	match typ:
		CompilerPreludeDict:
			2
		CompilerPreludeList:
			1
		CompilerPreludeParallelList:
			1
		CompilerPreludeParallelMatrix:
			3
		CompilerPreludeParallelVector:
			2
		CompilerPreludeSet:
			1
		_:
			0


pure func compiler_prelude_type_is_resource(typ: CompilerPreludeType) -> Bool:
	match typ:
		CompilerPreludeDirectory:
			True
		CompilerPreludeFileAppender:
			True
		CompilerPreludeFileReadAppender:
			True
		CompilerPreludeFileReadWriter:
			True
		CompilerPreludeFileReader:
			True
		CompilerPreludeFileWriter:
			True
		_:
			False


-- Synthetic frontend graphs may resolve prelude names without loading their
-- declarations. Keep the inline-layout fact attached to the closed prelude
-- identity instead of recovering it from the source spelling.
pure func compiler_prelude_type_has_inline_value_storage(typ: CompilerPreludeType) -> Bool:
	match typ:
		CompilerPreludeDirectoryEntryKind | CompilerPreludeRange:
			True
		_:
			False


-- `builtin` declarations are compiler ABI boundaries. Their representation is
-- determined by the canonical std module and declaration name together; a
-- same-named declaration in another module does not inherit this storage.
enum CompilerBuiltinValueStorage:
	CompilerBuiltinInlineScalar
	CompilerBuiltinManagedReference
	CompilerBuiltinNoValue


private INLINE_SCALAR_BUILTIN_TYPES: List[(String, String)] = [
	("std/int", "Int"),
	("std/int8", "Int8"),
	("std/int16", "Int16"),
	("std/int32", "Int32"),
	("std/int128", "Int128"),
	("std/uint8", "UInt8"),
	("std/uint16", "UInt16"),
	("std/uint32", "UInt32"),
	("std/uint64", "UInt64"),
	("std/uint128", "UInt128"),
	("std/float", "Float"),
	("std/float16", "Float16"),
	("std/float32", "Float32"),
	("std/char", "Char"),
	("std/ptr", "Ptr"),
	("std/net/tcp", "Port"),
]

private MANAGED_REFERENCE_BUILTIN_TYPES: List[(String, String)] = [
	("std/bytes", "Bytes"),
	("std/channel", "Channel"),
	("std/dict", "Dict"),
	("std/fixed", "Fixed"),
	("std/list", "List"),
	("std/list", "ParallelList"),
	("std/matrix", "ParallelMatrix"),
	("std/net/tcp", "DnsName"),
	("std/net/tcp", "InterfaceScope"),
	("std/net/tcp", "IpAddress"),
	("std/set", "Set"),
	("std/slice", "StringSlice"),
	("std/stream", "FallibleStream"),
	("std/stream", "ResourceSource"),
	("std/stream", "Stream"),
	("std/string", "String"),
	("std/vector", "ParallelVector"),
]


pure func compiler_builtin_value_storage(
	module_name: String,
	type_name: String,
) -> Option[CompilerBuiltinValueStorage]:
	identity = (module_name, type_name)

	if INLINE_SCALAR_BUILTIN_TYPES.contains(identity):
		Some(CompilerBuiltinInlineScalar)
	else if MANAGED_REFERENCE_BUILTIN_TYPES.contains(identity):
		Some(CompilerBuiltinManagedReference)
	else if identity == ("std/void", "Void"):
		Some(CompilerBuiltinNoValue)
	else:
		None


-- Transitional projection consumed by the remaining OCaml tooling generator.
-- Semantic typechecking must use CompilerPreludeType above; this string table
-- can disappear with compiler/tools/gen_language_surface_data.ml.
PRELUDE_METHOD_TYPE_IMPORTS: List[(String, String)] = [
	("option", "Option"),
	("result", "Result"),
	("bool", "Bool"),
	("char", "Char"),
	("bytes", "Bytes"),
	("string", "String"),
	("list", "List"),
	("list", "ParallelList"),
	("parallel_list", "ParallelList"),
	("vector", "ParallelVector"),
	("parallel_vector", "ParallelVector"),
	("matrix", "ParallelMatrix"),
	("parallel_matrix", "ParallelMatrix"),
	("range", "Range"),
	("dict", "Dict"),
	("set", "Set"),
	("fs", "FileReader"),
	("fs", "FileWriter"),
	("fs", "FileAppender"),
	("fs", "FileReadWriter"),
	("fs", "FileReadAppender"),
]
