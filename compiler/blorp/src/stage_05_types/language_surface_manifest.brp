	"func",
	"pure",
	"var",
	"union",
	"record",
	"void",
	"while",
	"for",
	"in",
	"if",
	"else",
	"and",
	"or",
	"not",
	"match",
	"True",
	"False",
	"break",
	"continue",
	"debug",
	"struct",
	"enum",
	"with",
	"resource",
	"foreign",
	"private",
	"builtin",
	"concurrent",
	"concurrently",
	"detach",
	"select",
	"into",
	"from",
	"after",
	"sealed",
	"import",
	"as",
	"trait",
	"implements",
	"Self",
	"type",
	"alias",
	"where",
]


-- Nominal types imported by std/prelude that are not compiler primitives.
--
-- Their identity cannot depend on whether a compiler API happened to include
-- the providing std module's source. In particular, synthetic typecheck graph
-- requests still have the same prelude as ordinary source compilation. Keep
-- the provider, arity, and resource capability closed over this enum so later
-- phases never reconstruct those facts from strings.
enum CompilerPreludeType:
	CompilerPreludeDict
	CompilerPreludeDirectory
	CompilerPreludeDirectoryEntry
	CompilerPreludeDirectoryEntryKind
	CompilerPreludeFileAppender
	CompilerPreludeFileReadAppender
	CompilerPreludeFileReadWriter
	CompilerPreludeFileReader
	CompilerPreludeFileWriter
	CompilerPreludeIOError
	CompilerPreludeList
	CompilerPreludeParallelList
	CompilerPreludeParallelMatrix
	CompilerPreludeParallelVector
	CompilerPreludeRange
	CompilerPreludeSet


pure func compiler_prelude_type(name: String) -> Option[CompilerPreludeType]:
	match name:
		"Dict":
			Some(CompilerPreludeDict)
		"Directory":
			Some(CompilerPreludeDirectory)
		"DirectoryEntry":
			Some(CompilerPreludeDirectoryEntry)
		"DirectoryEntryKind":
			Some(CompilerPreludeDirectoryEntryKind)
		"FileAppender":
			Some(CompilerPreludeFileAppender)
		"FileReadAppender":
			Some(CompilerPreludeFileReadAppender)
		"FileReadWriter":
			Some(CompilerPreludeFileReadWriter)
		"FileReader":
			Some(CompilerPreludeFileReader)
		"FileWriter":
			Some(CompilerPreludeFileWriter)
		"IOError":
			Some(CompilerPreludeIOError)
		"List":
			Some(CompilerPreludeList)
		"ParallelList":
			Some(CompilerPreludeParallelList)
		"ParallelMatrix":
			Some(CompilerPreludeParallelMatrix)
		"ParallelVector":
			Some(CompilerPreludeParallelVector)
		"Range":
			Some(CompilerPreludeRange)
		"Set":
			Some(CompilerPreludeSet)
		_:
			None


pure func compiler_prelude_type_name(typ: CompilerPreludeType) -> String:
	match typ:
		CompilerPreludeDict:
			"Dict"
		CompilerPreludeDirectory:
			"Directory"
		CompilerPreludeDirectoryEntry:
			"DirectoryEntry"
		CompilerPreludeDirectoryEntryKind:
			"DirectoryEntryKind"
		CompilerPreludeFileAppender:
			"FileAppender"
		CompilerPreludeFileReadAppender:
			"FileReadAppender"
		CompilerPreludeFileReadWriter:
			"FileReadWriter"
		CompilerPreludeFileReader:
			"FileReader"
		CompilerPreludeFileWriter:
			"FileWriter"
		CompilerPreludeIOError:
			"IOError"
		CompilerPreludeList:
			"List"
		CompilerPreludeParallelList:
			"ParallelList"
		CompilerPreludeParallelMatrix:
			"ParallelMatrix"
		CompilerPreludeParallelVector:
			"ParallelVector"
		CompilerPreludeRange:
			"Range"
		CompilerPreludeSet:
			"Set"


pure func compiler_prelude_type_module_path(typ: CompilerPreludeType) -> String:
	match typ:
		CompilerPreludeDict:
			"dict"
		CompilerPreludeDirectory:
			"fs"
		CompilerPreludeDirectoryEntry:
			"fs"
		CompilerPreludeDirectoryEntryKind:
			"fs"
		CompilerPreludeFileAppender:
			"fs"
		CompilerPreludeFileReadAppender:
			"fs"
		CompilerPreludeFileReadWriter:
			"fs"
		CompilerPreludeFileReader:
			"fs"
		CompilerPreludeFileWriter:
			"fs"
		CompilerPreludeIOError:
			"fs"
		CompilerPreludeList:
			"list"
		CompilerPreludeParallelList:
			"list"
		CompilerPreludeParallelMatrix:
			"matrix"
		CompilerPreludeParallelVector:
			"vector"
		CompilerPreludeRange:
			"range"
		CompilerPreludeSet:
			"set"


pure func compiler_prelude_type_arity(typ: CompilerPreludeType) -> Int:
	match typ:
		CompilerPreludeDict:
			2
		CompilerPreludeList:
			1
		CompilerPreludeParallelList:
			1
		CompilerPreludeParallelMatrix:
			3
		CompilerPreludeParallelVector:
			2
		CompilerPreludeSet:
			1
		_:
			0


pure func compiler_prelude_type_is_resource(typ: CompilerPreludeType) -> Bool:
	match typ:
		CompilerPreludeDirectory:
			True
		CompilerPreludeFileAppender:
			True
		CompilerPreludeFileReadAppender:
			True
		CompilerPreludeFileReadWriter:
			True
		CompilerPreludeFileReader:
			True
		CompilerPreludeFileWriter:
			True
		_:
			False


-- Transitional projection consumed by the remaining OCaml tooling generator.
-- Semantic typechecking must use CompilerPreludeType above; this string table
-- can disappear with compiler/tools/gen_language_surface_data.ml.
PRELUDE_METHOD_TYPE_IMPORTS: List[(String, String)] = [
	("option", "Option"),
	("result", "Result"),
	("bool", "Bool"),
	("char", "Char"),
	("bytes", "Bytes"),
	("string", "String"),
	("list", "List"),
	("list", "ParallelList"),
	("parallel_list", "ParallelList"),
	("vector", "ParallelVector"),
	("parallel_vector", "ParallelVector"),
	("matrix", "ParallelMatrix"),
	("parallel_matrix", "ParallelMatrix"),
	("range", "Range"),
	("dict", "Dict"),
	("set", "Set"),
	("fs", "FileReader"),
	("fs", "FileWriter"),
	("fs", "FileAppender"),
	("fs", "FileReadWriter"),
	("fs", "FileReadAppender"),
]
