-- JSON projection for frontend CompilerType values.
--
-- Typed-AST handoff needs structured frontend types. Do not serialize these as
-- display strings; downstream phases need to preserve type identity, dimension
-- expressions, purity, and unresolved/meta diagnostics explicitly.
import:
	compiler_type:
		CompilerDimOp(CompilerDimAdd, CompilerDimDivide, CompilerDimMultiply, CompilerDimSubtract),
		CompilerType(
			CompilerArrayType,
			CompilerConstIntType,
			CompilerDimOpType,
			CompilerFunctionType,
			CompilerMetaType,
			CompilerNamedType,
			CompilerRangeType,
			CompilerSelfType,
			CompilerTupleType,
			CompilerTypeVar,
			CompilerVarDimsType,
		),
	json: JsonValue(JsonBool, JsonNull, JsonNumber, JsonObject, JsonString, JsonVector)


private KIND_FIELD: String = "kind"


private pure func json_int(value: Int) -> JsonValue:
	JsonNumber(to_float(value))


private pure func compiler_const_int_type_to_json(value: Int) -> JsonValue:
	-- Decimal text preserves Blorp's full Int range across JSON implementations
	-- that otherwise route numbers through an imprecise floating representation.
	JsonObject([
		(KIND_FIELD, JsonString("const_int")),
		("value", JsonString(value.to_string())),
	])


pure func compiler_dim_op_to_json(op: CompilerDimOp) -> JsonValue:
	match op:
		CompilerDimAdd:
			JsonString("add")
		CompilerDimSubtract:
			JsonString("subtract")
		CompilerDimMultiply:
			JsonString("multiply")
		CompilerDimDivide:
			JsonString("divide")


pure func compiler_type_list_to_json(types: List[CompilerType]) -> JsonValue:
	JsonVector(types.map(compiler_type_to_json))


pure func compiler_optional_type_to_json(typ: Option[CompilerType]) -> JsonValue:
	match typ:
		Some(value):
			compiler_type_to_json(value)
		None:
			JsonNull


pure func compiler_type_to_json(typ: CompilerType) -> JsonValue:
	match typ:
		CompilerNamedType(name, args):
			JsonObject([
				(KIND_FIELD, JsonString("named")),
				("name", JsonString(name)),
				("args", compiler_type_list_to_json(args)),
			])
		CompilerArrayType(element, dims):
			JsonObject([
				(KIND_FIELD, JsonString("array")),
				("element", compiler_type_to_json(element)),
				("dims", compiler_type_list_to_json(dims)),
			])
		CompilerFunctionType(is_pure, params, return_type):
			JsonObject([
				(KIND_FIELD, JsonString("function")),
				("pure", JsonBool(is_pure)),
				("params", compiler_type_list_to_json(params)),
				("return_type", compiler_type_to_json(return_type)),
			])
		CompilerTypeVar(name):
			JsonObject([
				(KIND_FIELD, JsonString("type_var")),
				("name", JsonString(name)),
			])
		CompilerConstIntType(value):
			compiler_const_int_type_to_json(value)
		CompilerTupleType(items):
			JsonObject([
				(KIND_FIELD, JsonString("tuple")),
				("items", compiler_type_list_to_json(items)),
			])
		CompilerSelfType:
			JsonObject([(KIND_FIELD, JsonString("self"))])
		CompilerVarDimsType(name):
			JsonObject([
				(KIND_FIELD, JsonString("var_dims")),
				("name", JsonString(name)),
			])
		CompilerRangeType(inner):
			JsonObject([
				(KIND_FIELD, JsonString("range")),
				("inner", compiler_type_to_json(inner)),
			])
		CompilerDimOpType(op, left, right):
			JsonObject([
				(KIND_FIELD, JsonString("dim_op")),
				("op", compiler_dim_op_to_json(op)),
				("left", compiler_type_to_json(left)),
				("right", compiler_type_to_json(right)),
			])
		CompilerMetaType(meta_id):
			JsonObject([
				(KIND_FIELD, JsonString("meta")),
				("id", json_int(meta_id)),
			])
