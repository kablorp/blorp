-- Explicit type widening decisions for frontend inference.
--
-- Widening changes the runtime value slot type, not the semantic type. Keeping
-- those two facts together lets later inference explain why singleton
-- dimensions, ranges, or target-typed literals were intentionally represented
-- by a broader runtime type.
import:
	compiler_context: CompilerContext, compiler_meta_origin_name
	../stage_03_parse/compiler_parsed_ast:
		ParsedBinaryOp(
			ParsedAddOp,
			ParsedDivideOp,
			ParsedEqualOp,
			ParsedGreaterEqualOp,
			ParsedGreaterOp,
			ParsedLessEqualOp,
			ParsedLessOp,
			ParsedModuloOp,
			ParsedMultiplyOp,
			ParsedNotEqualOp,
			ParsedSubtractOp,
		),
	compiler_type:
		CompilerType(
			CompilerConstIntType,
			CompilerMetaType,
			CompilerNamedType,
			CompilerRangeType,
			CompilerSelfType,
			CompilerTypeVar,
			CompilerVarDimsType,
		),
		TYPE_NAME_INT,
		compiler_collect_type_vars,
		compiler_is_dim_var_name,
		compiler_is_scalar_int_value_type as type_is_scalar_int_value_type,
		compiler_scalar_int_value_type as type_scalar_int_value_type,
		compiler_type_copy,
		compiler_types_equal,


enum CompilerCollectionKind:
	CompilerListLiteral
	CompilerVectorLiteral
	CompilerDictLiteral
	CompilerSetLiteral


union CompilerTypeWideningReason:
	CompilerMutableBinding
	CompilerArgumentSlot
	CompilerCollectionElement(CompilerCollectionKind)
	CompilerBitwiseOperator
	CompilerMethodReceiver
	CompilerRangeProofErasure
	CompilerTupleLiteral
	CompilerNumericOperator(ParsedBinaryOp)


union CompilerTypeWideningDecision:
	CompilerTypeKeep(CompilerType)
	CompilerTypeWiden(CompilerType, CompilerType, CompilerTypeWideningReason)


record CompilerValueSlot {
	semantic_type: CompilerType,
	decision: CompilerTypeWideningDecision
}


private pure func compiler_collection_kinds_equal(
	left: CompilerCollectionKind,
	right: CompilerCollectionKind,
) -> Bool:
	match left:
		CompilerListLiteral:
			match right:
				CompilerListLiteral:
					True
				_:
					False
		CompilerVectorLiteral:
			match right:
				CompilerVectorLiteral:
					True
				_:
					False
		CompilerDictLiteral:
			match right:
				CompilerDictLiteral:
					True
				_:
					False
		CompilerSetLiteral:
			match right:
				CompilerSetLiteral:
					True
				_:
					False


private pure func compiler_binary_ops_equal(left: ParsedBinaryOp, right: ParsedBinaryOp) -> Bool:
	match left:
		ParsedAddOp:
			match right:
				ParsedAddOp:
					True
				_:
					False
		ParsedSubtractOp:
			match right:
				ParsedSubtractOp:
					True
				_:
					False
		ParsedMultiplyOp:
			match right:
				ParsedMultiplyOp:
					True
				_:
					False
		ParsedDivideOp:
			match right:
				ParsedDivideOp:
					True
				_:
					False
		ParsedModuloOp:
			match right:
				ParsedModuloOp:
					True
				_:
					False
		ParsedEqualOp:
			match right:
				ParsedEqualOp:
					True
				_:
					False
		ParsedNotEqualOp:
			match right:
				ParsedNotEqualOp:
					True
				_:
					False
		ParsedLessOp:
			match right:
				ParsedLessOp:
					True
				_:
					False
		ParsedLessEqualOp:
			match right:
				ParsedLessEqualOp:
					True
				_:
					False
		ParsedGreaterOp:
			match right:
				ParsedGreaterOp:
					True
				_:
					False
		ParsedGreaterEqualOp:
			match right:
				ParsedGreaterEqualOp:
					True
				_:
					False


pure func compiler_widening_reasons_equal(
	left: CompilerTypeWideningReason,
	right: CompilerTypeWideningReason,
) -> Bool:
	match left:
		CompilerMutableBinding:
			match right:
				CompilerMutableBinding:
					True
				_:
					False
		CompilerArgumentSlot:
			match right:
				CompilerArgumentSlot:
					True
				_:
					False
		CompilerCollectionElement(left_kind):
			match right:
				CompilerCollectionElement(right_kind):
					compiler_collection_kinds_equal(left_kind, right_kind)
				_:
					False
		CompilerBitwiseOperator:
			match right:
				CompilerBitwiseOperator:
					True
				_:
					False
		CompilerMethodReceiver:
			match right:
				CompilerMethodReceiver:
					True
				_:
					False
		CompilerRangeProofErasure:
			match right:
				CompilerRangeProofErasure:
					True
				_:
					False
		CompilerTupleLiteral:
			match right:
				CompilerTupleLiteral:
					True
				_:
					False
		CompilerNumericOperator(left_op):
			match right:
				CompilerNumericOperator(right_op):
					compiler_binary_ops_equal(left_op, right_op)
				_:
					False


pure func compiler_widening_semantic_type(slot: CompilerValueSlot) -> CompilerType:
	slot.semantic_type


pure func compiler_widening_decision(slot: CompilerValueSlot) -> CompilerTypeWideningDecision:
	slot.decision


pure func compiler_widening_decision_value_type(
	decision: CompilerTypeWideningDecision,
) -> CompilerType:
	match decision:
		CompilerTypeKeep(typ):
			typ
		CompilerTypeWiden(_, to_type, _):
			to_type


pure func compiler_widening_decision_reason(
	decision: CompilerTypeWideningDecision,
) -> Option[CompilerTypeWideningReason]:
	match decision:
		CompilerTypeKeep(_):
			None
		CompilerTypeWiden(_, _, reason):
			Some(reason)


pure func compiler_widening_value_type(slot: CompilerValueSlot) -> CompilerType:
	compiler_widening_decision_value_type(slot.decision)


pure func compiler_widening_reason(slot: CompilerValueSlot) -> Option[CompilerTypeWideningReason]:
	compiler_widening_decision_reason(slot.decision)


pure func compiler_scalar_int_value_type(typ: CompilerType) -> CompilerType:
	type_scalar_int_value_type(typ)


pure func compiler_is_scalar_int_value_type(typ: CompilerType) -> Bool:
	type_is_scalar_int_value_type(typ)


private pure func compiler_keep_slot(semantic_type: CompilerType) -> CompilerValueSlot:
	{
		semantic_type = compiler_type_copy(semantic_type),
		decision = CompilerTypeKeep(compiler_type_copy(semantic_type))
	}


private pure func compiler_target_slot(
	reason: CompilerTypeWideningReason,
	semantic_type: CompilerType,
	value_type: CompilerType,
) -> CompilerValueSlot:
	if compiler_types_equal(semantic_type, value_type):
		compiler_keep_slot(semantic_type)
	else:
		{
			semantic_type = compiler_type_copy(semantic_type),
			decision = CompilerTypeWiden(
				compiler_type_copy(semantic_type),
				compiler_type_copy(value_type),
				reason,
			)
		}


private pure func compiler_singleton_int_slot(
	reason: CompilerTypeWideningReason,
	semantic_type: CompilerType,
) -> CompilerValueSlot:
	compiler_target_slot(
		reason,
		semantic_type,
		compiler_scalar_int_value_type(semantic_type),
	)


private pure func compiler_dim_operand_slot(
	reason: CompilerTypeWideningReason,
	semantic_type: CompilerType,
) -> CompilerValueSlot:
	compiler_target_slot(reason, semantic_type, compiler_scalar_int_value_type(semantic_type))


private pure func compiler_param_accepts_singleton_argument_widening(
	context: CompilerContext,
	param_type: CompilerType,
) -> Bool:
	match param_type:
		CompilerMetaType(meta_id):
			not compiler_is_dim_var_name(compiler_meta_origin_name(context, meta_id))
		CompilerSelfType:
			True
		_:
			False


private pure func compiler_can_use_concrete_argument_target(
	target_type: CompilerType,
	semantic_type: CompilerType,
) -> Bool:
	match target_type:
		CompilerNamedType(name, args):
			(
				name == TYPE_NAME_INT
				and args.length() == 0
				and compiler_is_scalar_int_value_type(semantic_type)
			)
		CompilerRangeType(bound):
			match semantic_type:
				CompilerConstIntType(value):
					if value < 0:
						False
					else:
						match bound:
							CompilerConstIntType(size):
								value < size
							CompilerTypeVar(name):
								compiler_is_dim_var_name(name) and value == 0
							_:
								False
				_:
					False
		_:
			False


private pure func compiler_target_keeps_semantic_slot(target_type: CompilerType) -> Bool:
	if compiler_collect_type_vars(target_type).length() != 0:
		True
	else if compiler_is_scalar_int_value_type(target_type):
		True
	else:
		match target_type:
			CompilerVarDimsType(_):
				True
			_:
				False


pure func compiler_mutable_binding_slot(semantic_type: CompilerType) -> CompilerValueSlot:
	compiler_singleton_int_slot(CompilerMutableBinding, semantic_type)


pure func compiler_argument_slot(
	context: CompilerContext,
	param_type: CompilerType,
	arg_type: CompilerType,
) -> CompilerValueSlot:
	if compiler_param_accepts_singleton_argument_widening(context, param_type):
		compiler_singleton_int_slot(CompilerArgumentSlot, arg_type)
	else:
		compiler_keep_slot(arg_type)


pure func compiler_argument_target_slot(
	context: CompilerContext,
	param_type: CompilerType,
	semantic_type: CompilerType,
) -> CompilerValueSlot:
	if compiler_param_accepts_singleton_argument_widening(context, param_type):
		compiler_singleton_int_slot(CompilerArgumentSlot, semantic_type)
	else if compiler_can_use_concrete_argument_target(param_type, semantic_type):
		compiler_target_slot(CompilerArgumentSlot, semantic_type, param_type)
	else if compiler_target_keeps_semantic_slot(param_type):
		compiler_keep_slot(semantic_type)
	else:
		compiler_keep_slot(semantic_type)


pure func compiler_collection_element_slot(
	kind: CompilerCollectionKind,
	semantic_type: CompilerType,
) -> CompilerValueSlot:
	compiler_singleton_int_slot(CompilerCollectionElement(kind), semantic_type)


pure func compiler_collection_element_target_slot(
	kind: CompilerCollectionKind,
	target_type: CompilerType,
	semantic_type: CompilerType,
) -> CompilerValueSlot:
	compiler_target_slot(CompilerCollectionElement(kind), semantic_type, target_type)


pure func compiler_bitwise_operand_slot(semantic_type: CompilerType) -> CompilerValueSlot:
	compiler_singleton_int_slot(CompilerBitwiseOperator, semantic_type)


pure func compiler_bitwise_operand_target_slot(
	target_type: CompilerType,
	semantic_type: CompilerType,
) -> CompilerValueSlot:
	compiler_target_slot(CompilerBitwiseOperator, semantic_type, target_type)


pure func compiler_method_receiver_slot(semantic_type: CompilerType) -> CompilerValueSlot:
	compiler_singleton_int_slot(CompilerMethodReceiver, semantic_type)


pure func compiler_range_proof_slot(semantic_type: CompilerType) -> CompilerValueSlot:
	compiler_target_slot(
		CompilerRangeProofErasure,
		semantic_type,
		compiler_scalar_int_value_type(semantic_type),
	)


pure func compiler_tuple_literal_slot(
	semantic_type: CompilerType,
	value_type: CompilerType,
) -> CompilerValueSlot:
	compiler_target_slot(CompilerTupleLiteral, semantic_type, value_type)


pure func compiler_numeric_operand_slot(
	op: ParsedBinaryOp,
	semantic_type: CompilerType,
) -> CompilerValueSlot:
	compiler_dim_operand_slot(CompilerNumericOperator(op), semantic_type)


pure func compiler_numeric_operand_type(op: ParsedBinaryOp, typ: CompilerType) -> CompilerType:
	compiler_widening_value_type(compiler_numeric_operand_slot(op, typ))
