import:
	compiler_generic_params:
		CompilerBoundTypeParam,
		CompilerTraitRef,
		compiler_bound_type_param_name,
		compiler_trait_ref,
		compiler_trait_ref_name,
	compiler_refinement: CompilerValueProofs, compiler_unrefined_binding
	compiler_type:
		CompilerDimOp(CompilerDimAdd, CompilerDimDivide, CompilerDimMultiply, CompilerDimSubtract),
		CompilerType(
			CompilerArrayType,
			CompilerConstIntType,
			CompilerDimOpType,
			CompilerFunctionType,
			CompilerMetaType,
			CompilerNamedType,
			CompilerRangeType,
			CompilerSelfType,
			CompilerTupleType,
			CompilerTypeVar,
			CompilerVarDimsType,
		),
		CompilerTypeSubstEntry,
		TYPE_NAME_TENSOR,
		compiler_apply_subst,
		compiler_is_dim_var_name,
		compiler_normalize_type_name,
		compiler_type_copy,
		compiler_type_subst_entry,
		compiler_types_compatible_with_params,
		compiler_types_equal,


enum CompilerVarMutability:
	CompilerImmutableBinding
	CompilerMutableBinding


pure func compiler_var_mutability_is_mutable(mutability: CompilerVarMutability) -> Bool:
	match mutability:
		CompilerImmutableBinding:
			False
		CompilerMutableBinding:
			True


pure func compiler_var_mutability(is_mutable: Bool) -> CompilerVarMutability:
	if is_mutable:
		CompilerMutableBinding
	else:
		CompilerImmutableBinding


union CompilerVarOrigin:
	CompilerLetBinding
	CompilerFuncParam
	CompilerForLoopVar
	CompilerMatchBinding
	CompilerScopedResource
	CompilerScopedResourceUnavailable(String)
	CompilerScopedResourceDerived
	CompilerOtherBinding


enum CompilerPurity:
	CompilerPure
	CompilerImpure


enum CompilerFuncOrigin:
	CompilerUserDefinedFunc
	CompilerBuiltinFunc
	CompilerForeignFunc


enum CompilerResourceResultPolicy:
	CompilerResourceResultDependent
	CompilerResourceResultIndependent
	CompilerResourceResultOrdinary


union CompilerResourceArgPolicy:
	CompilerRejectResourceArgs
	CompilerAllowResourceArgs(CompilerResourceResultPolicy)


pure func compiler_purities_equal(left: CompilerPurity, right: CompilerPurity) -> Bool:
	left == right


pure func compiler_resource_result_policies_equal(
	left: CompilerResourceResultPolicy,
	right: CompilerResourceResultPolicy,
) -> Bool:
	left == right


pure func compiler_resource_arg_policies_equal(
	left: CompilerResourceArgPolicy,
	right: CompilerResourceArgPolicy,
) -> Bool:
	match left:
		CompilerRejectResourceArgs:
			match right:
				CompilerRejectResourceArgs:
					True
				CompilerAllowResourceArgs(_):
					False
		CompilerAllowResourceArgs(left_result):
			match right:
				CompilerAllowResourceArgs(right_result):
					compiler_resource_result_policies_equal(left_result, right_result)
				CompilerRejectResourceArgs:
					False


enum CompilerLoopProducer:
	CompilerLoopProducerIndices
	CompilerLoopProducerEnumerate
	CompilerLoopProducerEnumerate2
	CompilerLoopProducerWindows


pure func compiler_loop_producer_is_windows(producer: CompilerLoopProducer) -> Bool:
	producer == CompilerLoopProducerWindows


pure func compiler_loop_producer_is_indices(producer: CompilerLoopProducer) -> Bool:
	producer == CompilerLoopProducerIndices


pure func compiler_loop_producer_is_enumerate(producer: CompilerLoopProducer) -> Bool:
	producer == CompilerLoopProducerEnumerate


pure func compiler_loop_producer_is_enumerate2(producer: CompilerLoopProducer) -> Bool:
	producer == CompilerLoopProducerEnumerate2


enum CompilerTypeKind:
	CompilerTypeUnion
	CompilerTypeEnum
	CompilerTypeBuiltin
	CompilerTypeResource


record CompilerFieldDecl {
	name: String,
	field_type: CompilerType
}


record CompilerVariantDef {
	name: String,
	fields: List[CompilerType],
	tag: Int
}


record CompilerVarSymbol {
	var_type: CompilerType,
	source_type: Option[CompilerType],
	mutability: CompilerVarMutability,
	origin: CompilerVarOrigin,
	refinement: CompilerValueProofs,
	module_path: Option[String]
}


record CompilerFuncSymbol {
	callable_id: Int,
	func_type: CompilerType,
	type_params: List[CompilerBoundTypeParam],
	param_names: List[Option[String]],
	purity: CompilerPurity,
	origin: CompilerFuncOrigin,
	resource_args: CompilerResourceArgPolicy,
	module_path: Option[String],
	dim_constraints: List[(CompilerType, CompilerType)],
	loop_producer: Option[CompilerLoopProducer],
	debug_only: Bool
}


record CompilerTypeSymbol {
	type_params: List[String],
	variants: List[CompilerVariantDef],
	type_kind: CompilerTypeKind,
	contains_resource: Bool
}


record CompilerRecordSymbol {
	type_params: List[String],
	fields: List[CompilerFieldDecl],
	is_value: Bool,
	contains_resource: Bool
}


record CompilerAliasSymbol {
	type_params: List[String],
	target: CompilerType
}


record CompilerOpaqueAliasSymbol {
	type_params: List[String],
	target: CompilerType,
	home_module: Option[String]
}


record CompilerConstructorSymbol {
	parent_type: String,
	constructor_id: Int,
	type_params: List[String],
	field_types: List[CompilerType],
	tag: Int
}


union CompilerSymbolKind:
	CompilerVarSymbolKind(CompilerVarSymbol)
	CompilerFuncSymbolKind(CompilerFuncSymbol)
	CompilerTypeSymbolKind(CompilerTypeSymbol)
	CompilerRecordSymbolKind(CompilerRecordSymbol)
	CompilerAliasSymbolKind(CompilerAliasSymbol)
	CompilerOpaqueAliasSymbolKind(CompilerOpaqueAliasSymbol)
	CompilerConstructorSymbolKind(CompilerConstructorSymbol)


record CompilerSymbol {
	name: String,
	kind: CompilerSymbolKind
}


record CompilerSymbolLookup {
	symbol: CompilerSymbol,
	scope_depth: Int
}


record CompilerScope {
	symbols: List[CompilerSymbol],
	symbols_by_name: Dict[String, List[Int]]
}


union CompilerTypeBinding:
	CompilerUnionTypeBinding(CompilerTypeSymbol)
	CompilerRecordTypeBinding(CompilerRecordSymbol)
	CompilerAliasTypeBinding(CompilerAliasSymbol)
	CompilerOpaqueAliasTypeBinding(CompilerOpaqueAliasSymbol)


record CompilerTraitObligation {
	obligation_type: CompilerType,
	obligation_trait: CompilerTraitRef
}


enum CompilerTraitObligationResolution:
	CompilerTraitObligationSatisfied
	CompilerTraitObligationUnsatisfied
	CompilerTraitObligationDeferred


record CompilerTraitMethodSig {
	name: String,
	params: List[CompilerType],
	return_type: CompilerType,
	is_pure: Bool,
	has_default: Bool,
	param_names: List[Option[String]]
}


record CompilerTraitDef {
	def_id: Int,
	name: String,
	type_params: List[String],
	supertraits: List[String],
	methods: List[CompilerTraitMethodSig],
	module_path: Option[String]
}


record CompilerImplMethodTarget {
	callable_id: Int,
	module_path: String
}


record CompilerImplMethodInfo {
	name: String,
	target: Option[CompilerImplMethodTarget],
	func_type: CompilerType,
	type_params: List[CompilerBoundTypeParam],
	param_names: List[Option[String]],
	purity: CompilerPurity,
	resource_args: CompilerResourceArgPolicy,
	dim_constraints: List[(CompilerType, CompilerType)],
	debug_only: Bool
}


record CompilerImplInstance {
	def_id: Int,
	trait_name: String,
	for_type: CompilerType,
	bounds: List[CompilerBoundTypeParam],
	methods: List[CompilerImplMethodInfo],
	is_builtin: Bool
}


record CompilerOverloadEntry {
	def_id: Int,
	func_type: CompilerType,
	type_params: List[CompilerBoundTypeParam],
	param_names: List[Option[String]],
	purity: CompilerPurity,
	origin: CompilerFuncOrigin,
	resource_args: CompilerResourceArgPolicy,
	module_path: Option[String],
	dim_constraints: List[(CompilerType, CompilerType)],
	loop_producer: Option[CompilerLoopProducer],
	debug_only: Bool
}


record CompilerOverloadSet {
	name: String,
	entries: List[CompilerOverloadEntry]
}


record CompilerEnv {
	scopes: List[CompilerScope],
	current_function: Option[String],
	current_function_pure: Bool,
	type_params_in_scope: List[String],
	type_param_bounds: List[CompilerBoundTypeParam],
	trait_functions: List[(String, String)],
	traits: List[CompilerTraitDef],
	impls: List[CompilerImplInstance],
	overloads: List[CompilerOverloadSet],
	ufcs_methods: List[CompilerOverloadSet],
	next_def_id: Int
}


private pure func compiler_empty_scope() -> CompilerScope:
	{
		symbols = [],
		symbols_by_name = {}
	}


private pure func compiler_env_copy_string(value: String) -> String:
	value.substring(0, value.length())


private pure func compiler_env_copy_strings(values: List[String]) -> List[String]:
	values.map(compiler_env_copy_string)


pure func compiler_string_lists_equal(left: List[String], right: List[String]) -> Bool:
	if left.length() != right.length():
		False
	else:
		var index: Int = 0
		var equal: Bool = True

		while index < left.length() and equal:
			equal = left.get_or(index, "") == right.get_or(index, "")
			index += 1

		equal


private pure func compiler_env_copy_optional_string(value: Option[String]) -> Option[String]:
	match value:
		Some(text):
			Some(compiler_env_copy_string(text))
		None:
			empty: Option[String] = None
			empty


pure func compiler_env_empty() -> CompilerEnv:
	{
		scopes = [compiler_empty_scope()],
		current_function = None,
		current_function_pure = False,
		type_params_in_scope = [],
		type_param_bounds = [],
		trait_functions = [],
		traits = [],
		impls = [],
		overloads = [],
		ufcs_methods = [],
		next_def_id = 0
	}


pure func compiler_env_push_scope(env: CompilerEnv) -> CompilerEnv:
	{ env | scopes = [compiler_empty_scope()].concat(env.scopes) }


pure func compiler_env_pop_scope(env: CompilerEnv) -> CompilerEnv:
	if env.scopes.length() <= 1:
		env
	else:
		var rest: List[CompilerScope] = []
		var index: Int = 1

		while index < env.scopes.length():
			match env.scopes.get(index):
				Some(scope):
					rest = rest.append(scope)
				None:
					void

			index += 1

		{ env | scopes = rest }


pure func compiler_env_mint_def_id(env: CompilerEnv) -> (CompilerEnv, Int):
	({ env | next_def_id = env.next_def_id + 1 }, env.next_def_id)


private pure func compiler_symbol_is_type_binding(
	symbol: CompilerSymbol,
) -> Option[CompilerTypeBinding]:
	match symbol.kind:
		CompilerTypeSymbolKind(type_symbol):
			Some(CompilerUnionTypeBinding(type_symbol))
		CompilerRecordSymbolKind(record_symbol):
			Some(CompilerRecordTypeBinding(record_symbol))
		CompilerAliasSymbolKind(alias_symbol):
			Some(CompilerAliasTypeBinding(alias_symbol))
		CompilerOpaqueAliasSymbolKind(alias_symbol):
			Some(CompilerOpaqueAliasTypeBinding(alias_symbol))
		_:
			None


private pure func compiler_scope_add_symbol(
	scope: CompilerScope,
	symbol: CompilerSymbol,
) -> CompilerScope:
	symbol_index = scope.symbols.length()
	name_candidates = scope.symbols_by_name
		.get(symbol.name)
		.get_or([])

	{ scope |
		symbols = scope.symbols.append(symbol),
		symbols_by_name = scope.symbols_by_name.set(
			symbol.name,
			[symbol_index].concat(name_candidates),
		)
	}


private pure func compiler_scope_symbols_named(
	scope: CompilerScope,
	name: String,
) -> List[CompilerSymbol]:
	var result: List[CompilerSymbol] = []

	for index in (
		scope.symbols_by_name
			.get(name)
			.get_or([])
	):
		match scope.symbols.get(index):
			Some(symbol):
				result = result.append(symbol)
			None:
				void

	result


private pure func compiler_scope_symbols_in_lookup_order(
	scope: CompilerScope,
) -> List[CompilerSymbol]:
	var result: List[CompilerSymbol] = []
	var index: Int = scope.symbols.length()

	while index > 0:
		index -= 1

		match scope.symbols.get(index):
			Some(symbol):
				result = result.append(symbol)
			None:
				void

	result


private pure func compiler_scope_lookup(
	scope: CompilerScope,
	name: String,
) -> Option[CompilerSymbol]:
	match (
		scope.symbols_by_name
			.get(name)
			.get_or([])
			.get(0)
	):
		Some(index):
			scope.symbols.get(index)
		None:
			None


pure func compiler_env_add_symbol(env: CompilerEnv, symbol: CompilerSymbol) -> CompilerEnv:
	match env.scopes.get(0):
		Some(current):
			var scopes: List[CompilerScope] = [compiler_scope_add_symbol(current, symbol)]
			var index: Int = 1

			while index < env.scopes.length():
				match env.scopes.get(index):
					Some(scope):
						scopes = scopes.append(scope)
					None:
						void

				index += 1

			{ env | scopes = scopes }
		None:
			{ env | scopes = [compiler_scope_add_symbol(compiler_empty_scope(), symbol)] }


pure func compiler_env_lookup_in_current_scope(
	env: CompilerEnv,
	name: String,
) -> Option[CompilerSymbol]:
	match env.scopes.get(0):
		Some(scope):
			compiler_scope_lookup(scope, name)
		None:
			None


pure func compiler_env_lookup(env: CompilerEnv, name: String) -> Option[CompilerSymbol]:
	var result: Option[CompilerSymbol] = None

	for scope in env.scopes:
		match compiler_scope_lookup(scope, name):
			Some(symbol):
				result = Some(symbol)
				break
			None:
				void

	result


pure func compiler_env_symbols_named(env: CompilerEnv, name: String) -> List[CompilerSymbol]:
	var result: List[CompilerSymbol] = []

	for scope in env.scopes:
		result = result.concat(compiler_scope_symbols_named(scope, name))

	result


pure func compiler_env_lookup_with_scope_depth(
	env: CompilerEnv,
	name: String,
) -> Option[CompilerSymbolLookup]:
	var result: Option[CompilerSymbolLookup] = None
	var depth: Int = 0

	for scope in env.scopes:
		match compiler_scope_lookup(scope, name):
			Some(symbol):
				result = Some({
					symbol = symbol,
					scope_depth = depth,
				})
				break
			None:
				depth += 1

	result


pure func compiler_env_lookup_is_outermost_scope(
	env: CompilerEnv,
	lookup: CompilerSymbolLookup,
) -> Bool:
	lookup.scope_depth == env.scopes.length() - 1


private pure func compiler_env_find_type_binding(
	env: CompilerEnv,
	name: String,
) -> Option[CompilerTypeBinding]:
	match compiler_env_lookup(env, name):
		Some(symbol):
			compiler_symbol_is_type_binding(symbol)
		None:
			None


pure func compiler_symbol_kind_label(symbol: CompilerSymbol) -> String:
	match symbol.kind:
		CompilerVarSymbolKind(_):
			"variable"
		CompilerFuncSymbolKind(_):
			"function"
		CompilerTypeSymbolKind(_):
			"type"
		CompilerRecordSymbolKind(_):
			"record"
		CompilerAliasSymbolKind(_):
			"type alias"
		CompilerOpaqueAliasSymbolKind(_):
			"opaque type"
		CompilerConstructorSymbolKind(_):
			"constructor"


private pure func compiler_env_copy_optional_type(
	typ: Option[CompilerType],
) -> Option[CompilerType]:
	match typ:
		Some(value):
			Some(compiler_env_copy_type(value))
		None:
			None


pure func compiler_env_add_var_with_module_details(
	env: CompilerEnv,
	name: String,
	var_type: CompilerType,
	source_type: Option[CompilerType],
	mutability: CompilerVarMutability,
	origin: CompilerVarOrigin,
	refinement: CompilerValueProofs,
	module_path: Option[String],
) -> CompilerEnv:
	compiler_env_add_symbol(
		env,
		{
			name = name,
			kind = CompilerVarSymbolKind({
				var_type = compiler_env_copy_type(var_type),
				source_type = compiler_env_copy_optional_type(source_type),
				mutability = mutability,
				origin = origin,
				refinement = refinement,
				module_path = module_path,
			})
		},
	)


pure func compiler_env_add_var_with_details(
	env: CompilerEnv,
	name: String,
	var_type: CompilerType,
	source_type: Option[CompilerType],
	mutability: CompilerVarMutability,
	origin: CompilerVarOrigin,
	refinement: CompilerValueProofs,
) -> CompilerEnv:
	compiler_env_add_var_with_module_details(
		env,
		name,
		var_type,
		source_type,
		mutability,
		origin,
		refinement,
		None,
	)


pure func compiler_env_add_var(
	env: CompilerEnv,
	name: String,
	var_type: CompilerType,
) -> CompilerEnv:
	compiler_env_add_var_with_details(
		env,
		name,
		var_type,
		None,
		CompilerImmutableBinding,
		CompilerLetBinding,
		compiler_unrefined_binding(),
	)


pure func compiler_env_get_var_type(env: CompilerEnv, name: String) -> Option[CompilerType]:
	match compiler_env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				CompilerVarSymbolKind(var_symbol):
					Some(var_symbol.var_type)
				CompilerFuncSymbolKind(func_symbol):
					Some(func_symbol.func_type)
				_:
					None
		None:
			None


pure func compiler_env_get_module_var_symbol(
	env: CompilerEnv,
	module_path: String,
	name: String,
) -> Option[CompilerVarSymbol]:
	var result: Option[CompilerVarSymbol] = None

	for scope in env.scopes:
		for symbol in compiler_scope_symbols_named(scope, name):
			match symbol.kind:
				CompilerVarSymbolKind(var_symbol):
					if var_symbol.module_path == Some(module_path):
						result = Some(var_symbol)
						break
				_:
					void

		if result.is_some():
			break

	result


pure func compiler_env_get_var_refinement(
	env: CompilerEnv,
	name: String,
) -> Option[CompilerValueProofs]:
	match compiler_env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				CompilerVarSymbolKind(var_symbol):
					Some(var_symbol.refinement)
				_:
					None
		None:
			None


pure func compiler_env_var_is_immutable(env: CompilerEnv, name: String) -> Bool:
	match compiler_env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				CompilerVarSymbolKind(var_symbol):
					not compiler_var_mutability_is_mutable(var_symbol.mutability)
				_:
					False
		None:
			False


pure func compiler_env_is_func_param(env: CompilerEnv, name: String) -> Bool:
	match compiler_env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				CompilerVarSymbolKind(var_symbol):
					match var_symbol.origin:
						CompilerFuncParam:
							True
						_:
							False
				_:
					False
		None:
			False


pure func compiler_env_is_scoped_resource_related_var(env: CompilerEnv, name: String) -> Bool:
	match compiler_env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				CompilerVarSymbolKind(var_symbol):
					match var_symbol.origin:
						CompilerScopedResource:
							True
						CompilerScopedResourceUnavailable(_):
							True
						CompilerScopedResourceDerived:
							True
						_:
							False
				_:
					False
		None:
			False


pure func compiler_env_get_var_origin(env: CompilerEnv, name: String) -> Option[CompilerVarOrigin]:
	match compiler_env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				CompilerVarSymbolKind(var_symbol):
					Some(var_symbol.origin)
				_:
					None
		None:
			None


pure func compiler_env_is_scoped_resource_var(env: CompilerEnv, name: String) -> Bool:
	match compiler_env_get_var_origin(env, name):
		Some(CompilerScopedResource):
			True
		_:
			False


pure func compiler_env_is_scoped_resource_derived_var(env: CompilerEnv, name: String) -> Bool:
	match compiler_env_get_var_origin(env, name):
		Some(CompilerScopedResourceDerived):
			True
		_:
			False


pure func compiler_env_scoped_resource_unavailable_owner(
	env: CompilerEnv,
	name: String,
) -> Option[String]:
	match compiler_env_get_var_origin(env, name):
		Some(CompilerScopedResourceUnavailable(owner)):
			Some(owner)
		_:
			None


private pure func compiler_env_dim_constraint_copy(
	constraint: (CompilerType, CompilerType),
) -> (CompilerType, CompilerType):
	(compiler_type_copy(constraint[0]), compiler_type_copy(constraint[1]))


private pure func compiler_env_trait_ref_copy(trait_ref: CompilerTraitRef) -> CompilerTraitRef:
	compiler_trait_ref(trait_ref.name)


private pure func compiler_env_bound_type_param_copy(
	param: CompilerBoundTypeParam,
) -> CompilerBoundTypeParam:
	{
		name = param.name,
		bounds = param.bounds.map(compiler_env_trait_ref_copy)
	}


private pure func compiler_env_bound_type_param_list_copy(
	params: List[CompilerBoundTypeParam],
) -> List[CompilerBoundTypeParam]:
	params.map(compiler_env_bound_type_param_copy)


private pure func compiler_env_optional_string_copy(value: Option[String]) -> Option[String]:
	match value:
		Some(text):
			Some(text)
		None:
			None


private pure func compiler_env_optional_param_name_copy(value: Option[String]) -> Option[String]:
	compiler_env_optional_string_copy(value)


pure func compiler_func_symbol(
	callable_id: Int,
	func_type: CompilerType,
	type_params: List[CompilerBoundTypeParam],
	param_names: List[Option[String]],
	purity: CompilerPurity,
	origin: CompilerFuncOrigin,
	resource_args: CompilerResourceArgPolicy,
	module_path: Option[String],
	dim_constraints: List[(CompilerType, CompilerType)],
	loop_producer: Option[CompilerLoopProducer],
	debug_only: Bool,
) -> CompilerFuncSymbol:
	{
		callable_id = callable_id,
		func_type = compiler_type_copy(func_type),
		type_params = type_params,
		param_names = param_names,
		purity = purity,
		origin = origin,
		resource_args = resource_args,
		module_path = module_path,
		dim_constraints = dim_constraints.map(compiler_env_dim_constraint_copy),
		loop_producer = loop_producer,
		debug_only = debug_only
	}


private pure func compiler_func_symbol_copy(info: CompilerFuncSymbol) -> CompilerFuncSymbol:
	compiler_func_symbol(
		info.callable_id,
		info.func_type,
		info.type_params.map(compiler_env_bound_type_param_copy),
		info.param_names.map(compiler_env_optional_param_name_copy),
		info.purity,
		info.origin,
		info.resource_args,
		compiler_env_optional_string_copy(info.module_path),
		info.dim_constraints.map(compiler_env_dim_constraint_copy),
		info.loop_producer,
		info.debug_only,
	)


pure func compiler_overload_entry_from_func_symbol(
	info: CompilerFuncSymbol,
) -> CompilerOverloadEntry:
	{
		def_id = info.callable_id,
		func_type = compiler_type_copy(info.func_type),
		type_params = info.type_params.map(compiler_env_bound_type_param_copy),
		param_names = info.param_names.map(compiler_env_optional_param_name_copy),
		purity = info.purity,
		origin = info.origin,
		resource_args = info.resource_args,
		module_path = compiler_env_optional_string_copy(info.module_path),
		dim_constraints = info.dim_constraints.map(compiler_env_dim_constraint_copy),
		loop_producer = info.loop_producer,
		debug_only = info.debug_only
	}


private pure func compiler_overload_entry_copy(
	entry: CompilerOverloadEntry,
) -> CompilerOverloadEntry:
	{
		def_id = entry.def_id,
		func_type = compiler_type_copy(entry.func_type),
		type_params = entry.type_params.map(compiler_env_bound_type_param_copy),
		param_names = entry.param_names.map(compiler_env_optional_param_name_copy),
		purity = entry.purity,
		origin = entry.origin,
		resource_args = entry.resource_args,
		module_path = compiler_env_optional_string_copy(entry.module_path),
		dim_constraints = entry.dim_constraints.map(compiler_env_dim_constraint_copy),
		loop_producer = entry.loop_producer,
		debug_only = entry.debug_only
	}


private pure func compiler_overload_entry_list_copy(
	entries: List[CompilerOverloadEntry],
) -> List[CompilerOverloadEntry]:
	entries.map(compiler_overload_entry_copy)


private pure func compiler_func_symbol_supports_ufcs(info: CompilerFuncSymbol) -> Bool:
	match info.func_type:
		CompilerFunctionType(_, params, _):
			params.length() > 0
		_:
			False


pure func compiler_env_add_func_with_info(
	env: CompilerEnv,
	name: String,
	info: CompilerFuncSymbol,
) -> CompilerEnv:
	compiler_env_add_symbol(
		env,
		{
			name = name,
			kind = CompilerFuncSymbolKind(compiler_func_symbol_copy(info))
		},
	)


pure func compiler_env_add_func(
	env: CompilerEnv,
	name: String,
	func_type: CompilerType,
	purity: CompilerPurity,
	origin: CompilerFuncOrigin,
) -> CompilerEnv:
	match compiler_env_mint_def_id(env):
		(next_env, def_id):
			compiler_env_add_func_with_info(
				next_env,
				name,
				compiler_func_symbol(
					def_id,
					func_type,
					[],
					[],
					purity,
					origin,
					CompilerRejectResourceArgs,
					None,
					[],
					None,
					False,
				),
			)


pure func compiler_env_get_func_info(
	env: CompilerEnv,
	name: String,
) -> Option[(CompilerType, List[CompilerBoundTypeParam], CompilerPurity)]:
	match compiler_env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				CompilerFuncSymbolKind(func_symbol):
					Some((func_symbol.func_type, func_symbol.type_params, func_symbol.purity))
				_:
					None
		None:
			None


pure func compiler_env_get_module_func_symbol(
	env: CompilerEnv,
	module_path: String,
	name: String,
) -> Option[CompilerFuncSymbol]:
	var result: Option[CompilerFuncSymbol] = None

	for scope in env.scopes:
		for symbol in compiler_scope_symbols_named(scope, name):
			match symbol.kind:
				CompilerFuncSymbolKind(func_symbol):
					if func_symbol.module_path == Some(module_path):
						result = Some(func_symbol)
						break
				_:
					void

		if result.is_some():
			break

	result


pure func compiler_env_get_func_callable_id(env: CompilerEnv, name: String) -> Option[Int]:
	match compiler_env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				CompilerFuncSymbolKind(func_symbol):
					Some(func_symbol.callable_id)
				_:
					None
		None:
			None


pure func compiler_env_is_builtin_func(env: CompilerEnv, name: String) -> Bool:
	match compiler_env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				CompilerFuncSymbolKind(func_symbol):
					func_symbol.origin == CompilerBuiltinFunc
				_:
					False
		None:
			False


pure func compiler_env_is_local_func(env: CompilerEnv, name: String) -> Bool:
	match compiler_env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				CompilerFuncSymbolKind(func_symbol):
					func_symbol.origin != CompilerBuiltinFunc and func_symbol.module_path.is_none()
				_:
					False
		None:
			False


pure func compiler_env_add_type_with_constructor_ids(
	env: CompilerEnv,
	name: String,
	type_params: List[String],
	variants: List[CompilerVariantDef],
	type_kind: CompilerTypeKind,
	contains_resource: Bool,
	with_ctors: Bool,
	constructor_ids: List[Option[Int]],
) -> CompilerEnv:
	type_env: CompilerEnv = compiler_env_add_symbol(
		env,
		{
			name = name,
			kind = CompilerTypeSymbolKind({
				type_params = type_params,
				variants = variants,
				type_kind = type_kind,
				contains_resource = contains_resource,
			})
		},
	)

	if not with_ctors:
		type_env
	else:
		var current_env: CompilerEnv = type_env
		var index: Int = 0

		for variant in variants:
			(next_env, def_id) = match constructor_ids.get(index):
				Some(Some(reserved_id)):
					(current_env, reserved_id)
				_:
					compiler_env_mint_def_id(current_env)

			current_env = compiler_env_add_symbol(
				next_env,
				{
					name = variant.name,
					kind = CompilerConstructorSymbolKind({
						parent_type = name,
						constructor_id = def_id,
						type_params = type_params,
						field_types = variant.fields,
						tag = variant.tag,
					})
				},
			)
			index += 1

		current_env


pure func compiler_env_add_type(
	env: CompilerEnv,
	name: String,
	type_params: List[String],
	variants: List[CompilerVariantDef],
	type_kind: CompilerTypeKind,
	contains_resource: Bool,
	with_ctors: Bool,
) -> CompilerEnv:
	compiler_env_add_type_with_constructor_ids(
		env,
		name,
		type_params,
		variants,
		type_kind,
		contains_resource,
		with_ctors,
		[],
	)


pure func compiler_env_add_record(
	env: CompilerEnv,
	name: String,
	type_params: List[String],
	fields: List[CompilerFieldDecl],
	is_value: Bool,
	contains_resource: Bool,
) -> CompilerEnv:
	compiler_env_add_symbol(
		env,
		{
			name = name,
			kind = CompilerRecordSymbolKind({
				type_params = type_params,
				fields = fields,
				is_value = is_value,
				contains_resource = contains_resource,
			})
		},
	)


pure func compiler_env_add_alias(
	env: CompilerEnv,
	name: String,
	type_params: List[String],
	target: CompilerType,
) -> CompilerEnv:
	compiler_env_add_symbol(
		env,
		{
			name = name,
			kind = CompilerAliasSymbolKind({
				type_params = type_params,
				target = compiler_env_copy_type(target),
			})
		},
	)


pure func compiler_env_add_opaque_alias(
	env: CompilerEnv,
	name: String,
	type_params: List[String],
	target: CompilerType,
	home_module: Option[String],
) -> CompilerEnv:
	compiler_env_add_symbol(
		env,
		{
			name = name,
			kind = CompilerOpaqueAliasSymbolKind({
				type_params = type_params,
				target = compiler_env_copy_type(target),
				home_module = home_module,
			})
		},
	)


pure func compiler_env_get_type_decl(
	env: CompilerEnv,
	name: String,
) -> Option[(List[String], List[CompilerVariantDef])]:
	match compiler_env_find_type_binding(env, name):
		Some(CompilerUnionTypeBinding(type_symbol)):
			Some((type_symbol.type_params, type_symbol.variants))
		_:
			None


pure func compiler_env_get_type_kind(env: CompilerEnv, name: String) -> Option[CompilerTypeKind]:
	match compiler_env_find_type_binding(env, name):
		Some(CompilerUnionTypeBinding(type_symbol)):
			Some(type_symbol.type_kind)
		_:
			None


pure func compiler_env_type_is_enum(env: CompilerEnv, name: String) -> Bool:
	match compiler_env_find_type_binding(env, name):
		Some(CompilerUnionTypeBinding(type_symbol)):
			match type_symbol.type_kind:
				CompilerTypeEnum:
					True
				_:
					False
		_:
			False


pure func compiler_env_type_is_resource(env: CompilerEnv, name: String) -> Bool:
	match compiler_env_find_type_binding(env, name):
		Some(CompilerUnionTypeBinding(type_symbol)):
			match type_symbol.type_kind:
				CompilerTypeResource:
					True
				_:
					False
		_:
			False


pure func compiler_env_get_type_contains_resource(env: CompilerEnv, name: String) -> Bool:
	match compiler_env_find_type_binding(env, name):
		Some(CompilerUnionTypeBinding(type_symbol)):
			type_symbol.contains_resource
		Some(CompilerRecordTypeBinding(record_symbol)):
			record_symbol.contains_resource
		_:
			False


pure func compiler_env_get_constructor(
	env: CompilerEnv,
	name: String,
) -> Option[CompilerConstructorSymbol]:
	match compiler_env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				CompilerConstructorSymbolKind(ctor):
					Some(ctor)
				_:
					None
		None:
			None


pure func compiler_env_get_constructors(
	env: CompilerEnv,
	name: String,
) -> List[CompilerConstructorSymbol]:
	var constructors: List[CompilerConstructorSymbol] = []

	for scope in env.scopes:
		for symbol in compiler_scope_symbols_named(scope, name):
			match symbol.kind:
				CompilerConstructorSymbolKind(ctor):
					constructors = constructors.append(ctor)
				_:
					void

	constructors


pure func compiler_env_get_constructor_for_parent(
	env: CompilerEnv,
	parent_type: String,
	name: String,
) -> Option[CompilerConstructorSymbol]:
	var result: Option[CompilerConstructorSymbol] = None

	for ctor in compiler_env_get_constructors(env, name):
		if result.is_none() and ctor.parent_type == parent_type:
			result = Some(ctor)

	result


pure func compiler_env_get_record(
	env: CompilerEnv,
	name: String,
) -> Option[(List[String], List[CompilerFieldDecl])]:
	match compiler_env_find_type_binding(env, name):
		Some(CompilerRecordTypeBinding(record_symbol)):
			Some((record_symbol.type_params, record_symbol.fields))
		_:
			None


pure func compiler_env_is_value_record(env: CompilerEnv, name: String) -> Bool:
	match compiler_env_find_type_binding(env, name):
		Some(CompilerRecordTypeBinding(record_symbol)):
			record_symbol.is_value
		_:
			False


pure func compiler_env_get_alias(
	env: CompilerEnv,
	name: String,
) -> Option[(List[String], CompilerType)]:
	match compiler_env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				CompilerAliasSymbolKind(alias_symbol):
					Some(
						(
							compiler_env_copy_strings(alias_symbol.type_params),
							compiler_env_copy_type(alias_symbol.target),
						),
					)
				_:
					empty: Option[(List[String], CompilerType)] = None
					empty
		_:
			empty: Option[(List[String], CompilerType)] = None
			empty


pure func compiler_env_get_opaque_alias(
	env: CompilerEnv,
	name: String,
) -> Option[(List[String], CompilerType, Option[String])]:
	match compiler_env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				CompilerOpaqueAliasSymbolKind(alias_symbol):
					Some(
						(
							compiler_env_copy_strings(alias_symbol.type_params),
							compiler_env_copy_type(alias_symbol.target),
							compiler_env_copy_optional_string(alias_symbol.home_module),
						),
					)
				_:
					empty: Option[(List[String], CompilerType, Option[String])] = None
					empty
		_:
			empty: Option[(List[String], CompilerType, Option[String])] = None
			empty


private pure func compiler_field_names_match(
	fields: List[CompilerFieldDecl],
	names: List[String],
) -> Bool:
	compiler_string_lists_equal(
		fields
			.map(func(field): field.name)
			.sort(),
		names.sort(),
	)


pure func compiler_env_find_records_with_fields(
	env: CompilerEnv,
	field_names: List[String],
) -> List[String]:
	var matches: List[String] = []

	for scope in env.scopes:
		for symbol in compiler_scope_symbols_in_lookup_order(scope):
			match symbol.kind:
				CompilerRecordSymbolKind(record_symbol):
					if (
						compiler_field_names_match(record_symbol.fields, field_names)
						and not matches.contains(symbol.name)
					):
						matches = matches.append(symbol.name)
				_:
					void

	matches


private pure func compiler_nominal_dim_params(
	env: CompilerEnv,
	name: String,
) -> Option[List[String]]:
	params: Option[List[String]] = match compiler_env_get_record(env, name):
		Some((type_params, _)):
			Some(type_params)
		None:
			match compiler_env_get_type_decl(env, name):
				Some((type_params, _)):
					Some(type_params)
				None:
					match compiler_env_get_alias(env, name):
						Some((type_params, _)):
							Some(type_params)
						None:
							match compiler_env_get_opaque_alias(env, name):
								Some((type_params, _, _)):
									Some(type_params)
								None:
									None

	match params:
		Some(type_params):
			if type_params.length() > 0 and type_params.all(compiler_is_dim_var_name):
				Some(type_params)
			else:
				None
		None:
			None


pure func compiler_env_disambiguate_nominal_dim_application(
	env: CompilerEnv,
	typ: CompilerType,
) -> CompilerType:
	match typ:
		CompilerArrayType(CompilerNamedType(name, args), dims):
			resolved_dims: List[CompilerType] = dims.map(
				func(dim): compiler_env_disambiguate_nominal_dim_application(env, dim),
			)

			if args.length() == 0:
				match compiler_nominal_dim_params(env, name):
					Some(params):
						if params.length() == resolved_dims.length():
							CompilerNamedType(name, resolved_dims)
						else:
							CompilerArrayType(
								CompilerNamedType(name, []),
								resolved_dims,
							)
					None:
						CompilerArrayType(
							CompilerNamedType(name, []),
							resolved_dims,
						)
			else:
				CompilerArrayType(
					CompilerNamedType(
						name,
						args.map(
							func(
								arg,
							): compiler_env_disambiguate_nominal_dim_application(env, arg),
						),
					),
					resolved_dims,
				)
		CompilerArrayType(element, dims):
			CompilerArrayType(
				compiler_env_disambiguate_nominal_dim_application(env, element),
				dims.map(func(dim): compiler_env_disambiguate_nominal_dim_application(env, dim)),
			)
		CompilerNamedType(name, args):
			CompilerNamedType(
				name,
				args.map(func(arg): compiler_env_disambiguate_nominal_dim_application(env, arg)),
			)
		CompilerFunctionType(is_pure, params, return_type):
			CompilerFunctionType(
				is_pure,
				params.map(
					func(param): compiler_env_disambiguate_nominal_dim_application(env, param),
				),
				compiler_env_disambiguate_nominal_dim_application(env, return_type),
			)
		CompilerTupleType(elements):
			CompilerTupleType(elements.map(
				func(element): compiler_env_disambiguate_nominal_dim_application(env, element),
			))
		CompilerRangeType(inner):
			CompilerRangeType(compiler_env_disambiguate_nominal_dim_application(env, inner))
		CompilerDimOpType(op, left, right):
			CompilerDimOpType(
				op,
				compiler_env_disambiguate_nominal_dim_application(env, left),
				compiler_env_disambiguate_nominal_dim_application(env, right),
			)
		_:
			typ


private pure func compiler_subst_for_params(
	type_params: List[String],
	args: List[CompilerType],
) -> List[CompilerTypeSubstEntry]:
	var subst: List[CompilerTypeSubstEntry] = []
	var index: Int = 0

	while index < type_params.length() and index < args.length():
		match (type_params.get(index), args.get(index)):
			(Some(type_param), Some(arg)):
				subst = subst.append(compiler_type_subst_entry(type_param, arg))
			_:
				void

		index += 1

	subst


private pure func compiler_env_copy_type(typ: CompilerType) -> CompilerType:
	match typ:
		CompilerNamedType(name, args):
			CompilerNamedType(
				name,
				args.map(compiler_env_copy_type),
			)
		CompilerArrayType(element, dims):
			CompilerArrayType(
				compiler_env_copy_type(element),
				dims.map(compiler_env_copy_type),
			)
		CompilerFunctionType(is_pure, params, return_type):
			CompilerFunctionType(
				is_pure,
				params.map(compiler_env_copy_type),
				compiler_env_copy_type(return_type),
			)
		CompilerTupleType(elements):
			CompilerTupleType(elements.map(compiler_env_copy_type))
		CompilerRangeType(inner):
			CompilerRangeType(compiler_env_copy_type(inner))
		CompilerDimOpType(op, left, right):
			CompilerDimOpType(op, compiler_env_copy_type(left), compiler_env_copy_type(right))
		_:
			typ


private pure func compiler_env_resolve_alias_seen(
	env: CompilerEnv,
	seen: String,
	typ: CompilerType,
) -> CompilerType:
	match typ:
		CompilerNamedType(name, args):
			seen_key: String = "|" + name + "|"

			if seen.contains(seen_key):
				compiler_env_copy_type(typ)
			else:
				resolved_args: List[CompilerType] = args.map(
					func(arg): compiler_env_resolve_alias_seen(env, seen, arg),
				)

				match compiler_env_get_alias(env, name):
					Some((type_params, target)):
						if type_params.length() == resolved_args.length():
							subst: List[CompilerTypeSubstEntry] = compiler_subst_for_params(
								type_params,
								resolved_args,
							)
							next_seen: String = seen + seen_key
							substituted: CompilerType = compiler_apply_subst(
								subst,
								compiler_env_copy_type(target),
							)
							compiler_env_resolve_alias_seen(env, next_seen, substituted)
						else:
							CompilerNamedType(name, resolved_args)
					None:
						CompilerNamedType(name, resolved_args)
		CompilerArrayType(element, dims):
			CompilerArrayType(
				compiler_env_resolve_alias_seen(env, seen, element),
				dims.map(func(dim): compiler_env_resolve_alias_seen(env, seen, dim)),
			)
		CompilerFunctionType(is_pure, params, return_type):
			CompilerFunctionType(
				is_pure,
				params.map(func(param): compiler_env_resolve_alias_seen(env, seen, param)),
				compiler_env_resolve_alias_seen(env, seen, return_type),
			)
		CompilerTupleType(elements):
			CompilerTupleType(elements.map(
				func(element): compiler_env_resolve_alias_seen(env, seen, element),
			))
		CompilerRangeType(inner):
			CompilerRangeType(compiler_env_resolve_alias_seen(env, seen, inner))
		CompilerDimOpType(op, left, right):
			CompilerDimOpType(
				op,
				compiler_env_resolve_alias_seen(env, seen, left),
				compiler_env_resolve_alias_seen(env, seen, right),
			)
		_:
			compiler_env_copy_type(typ)


pure func compiler_env_resolve_alias(env: CompilerEnv, typ: CompilerType) -> CompilerType:
	compiler_env_resolve_alias_seen(env, "", typ)


-- Shape traversals already visit every child. Expanding only the alias at the
-- current node avoids rebuilding the same nested type at every recursive step.
private pure func compiler_env_resolve_alias_head_seen(
	env: CompilerEnv,
	seen: List[String],
	typ: CompilerType,
) -> CompilerType:
	match typ:
		CompilerNamedType(name, args):
			if seen.contains(name):
				typ
			else:
				match compiler_env_get_alias(env, name):
					Some((type_params, target)):
						if type_params.length() == args.length():
							subst = compiler_subst_for_params(type_params, args)
							compiler_env_resolve_alias_head_seen(
								env,
								seen.append(name),
								compiler_apply_subst(subst, target),
							)
						else:
							typ
					None:
						typ
		_:
			typ


pure func compiler_env_resolve_alias_head(env: CompilerEnv, typ: CompilerType) -> CompilerType:
	compiler_env_resolve_alias_head_seen(env, [], typ)


pure func compiler_env_set_type_param_bounds(
	env: CompilerEnv,
	params: List[CompilerBoundTypeParam],
) -> CompilerEnv:
	{ env |
		type_params_in_scope = params.map(compiler_bound_type_param_name),
		type_param_bounds = params
	}


pure func compiler_env_extend_type_param_bounds(
	env: CompilerEnv,
	params: List[CompilerBoundTypeParam],
) -> CompilerEnv:
	if params.length() == 0:
		env
	else:
		compiler_env_set_type_param_bounds(
			env,
			env.type_param_bounds.concat(params),
		)


pure func compiler_env_get_type_params(env: CompilerEnv) -> List[String]:
	env.type_params_in_scope.map(func(name): name)


pure func compiler_env_get_type_param_bounds(env: CompilerEnv, param_name: String) -> List[String]:
	var result: List[String] = []

	for param in env.type_param_bounds:
		if param.name == param_name:
			result = param.bounds.map(compiler_trait_ref_name)
			break

	result


pure func compiler_env_has_trait_bound(
	env: CompilerEnv,
	param_name: String,
	trait_name: String,
) -> Bool:
	compiler_env_get_type_param_bounds(env, param_name).contains(trait_name)


pure func compiler_trait_method_sig(
	name: String,
	params: List[CompilerType],
	return_type: CompilerType,
	is_pure: Bool,
) -> CompilerTraitMethodSig:
	compiler_trait_method_sig_with_details(name, params, return_type, is_pure, False, [])


pure func compiler_trait_method_sig_with_details(
	name: String,
	params: List[CompilerType],
	return_type: CompilerType,
	is_pure: Bool,
	has_default: Bool,
	param_names: List[Option[String]],
) -> CompilerTraitMethodSig:
	{
		name = name,
		params = params,
		return_type = return_type,
		is_pure = is_pure,
		has_default = has_default,
		param_names = param_names
	}


pure func compiler_trait_def(
	def_id: Int,
	name: String,
	supertraits: List[String],
	methods: List[CompilerTraitMethodSig],
) -> CompilerTraitDef:
	compiler_trait_def_with_details(def_id, name, [], supertraits, methods, None)


pure func compiler_trait_def_with_details(
	def_id: Int,
	name: String,
	type_params: List[String],
	supertraits: List[String],
	methods: List[CompilerTraitMethodSig],
	module_path: Option[String],
) -> CompilerTraitDef:
	{
		def_id = def_id,
		name = name,
		type_params = type_params,
		supertraits = supertraits,
		methods = methods,
		module_path = module_path
	}


private pure func compiler_trait_method_sig_copy(
	method: CompilerTraitMethodSig,
) -> CompilerTraitMethodSig:
	compiler_trait_method_sig_with_details(
		method.name,
		method.params.map(compiler_type_copy),
		compiler_type_copy(method.return_type),
		method.is_pure,
		method.has_default,
		method.param_names.map(compiler_env_optional_param_name_copy),
	)


private pure func compiler_trait_def_copy(trait_def: CompilerTraitDef) -> CompilerTraitDef:
	compiler_trait_def_with_details(
		trait_def.def_id,
		trait_def.name,
		compiler_string_list_copy(trait_def.type_params),
		compiler_string_list_copy(trait_def.supertraits),
		trait_def.methods.map(compiler_trait_method_sig_copy),
		compiler_env_optional_string_copy(trait_def.module_path),
	)


pure func compiler_env_add_trait(env: CompilerEnv, trait_def: CompilerTraitDef) -> CompilerEnv:
	var traits: List[CompilerTraitDef] = []
	var replaced: Bool = False

	for existing in env.traits:
		if existing.name == trait_def.name:
			traits = traits.append(compiler_trait_def_copy(trait_def))
			replaced = True
		else:
			traits = traits.append(existing)

	if not replaced:
		traits = traits.append(compiler_trait_def_copy(trait_def))

	{ env | traits = traits }


pure func compiler_env_get_trait(env: CompilerEnv, name: String) -> Option[CompilerTraitDef]:
	var result: Option[CompilerTraitDef] = None

	for trait_def in env.traits:
		if trait_def.name == name:
			result = Some(compiler_trait_def_copy(trait_def))
			break

	result


private pure func compiler_trait_has_supertrait_seen(
	env: CompilerEnv,
	seen: List[String],
	trait_name: String,
	target: String,
) -> Bool:
	if trait_name == target:
		True
	else if seen.contains(trait_name):
		False
	else:
		match compiler_env_get_trait(env, trait_name):
			Some(trait_def):
				var found: Bool = False

				for supertrait in trait_def.supertraits:
					if compiler_trait_has_supertrait_seen(
						env,
						seen.append(trait_name),
						supertrait,
						target,
					):
						found = True
						break

				found
			None:
				False


pure func compiler_env_trait_has_supertrait(
	env: CompilerEnv,
	trait_name: String,
	target: String,
) -> Bool:
	if trait_name == target:
		False
	else:
		compiler_trait_has_supertrait_seen(env, [], trait_name, target)


private pure func compiler_append_unique_string(
	values: List[String],
	value: String,
) -> List[String]:
	if values.contains(value):
		values
	else:
		values.append(value)


private pure func compiler_trait_method_names_seen(
	env: CompilerEnv,
	seen: List[String],
	trait_name: String,
) -> List[String]:
	if seen.contains(trait_name):
		[]
	else:
		match compiler_env_get_trait(env, trait_name):
			Some(trait_def):
				var names: List[String] = []

				for method in trait_def.methods:
					names = compiler_append_unique_string(names, method.name)

				for supertrait in trait_def.supertraits:
					for name in compiler_trait_method_names_seen(
						env,
						seen.append(trait_name),
						supertrait,
					):
						names = compiler_append_unique_string(names, name)

				names
			None:
				[]


pure func compiler_env_trait_method_names_transitive(
	env: CompilerEnv,
	trait_name: String,
) -> List[String]:
	compiler_trait_method_names_seen(env, [], trait_name)


private pure func compiler_trait_methods_with_declaring_trait_seen(
	env: CompilerEnv,
	seen: List[String],
	trait_name: String,
) -> List[(String, String)]:
	if seen.contains(trait_name):
		[]
	else:
		match compiler_env_get_trait(env, trait_name):
			Some(trait_def):
				var pairs: List[(String, String)] = []

				for method in trait_def.methods:
					pairs = pairs.append((method.name, trait_name))

				for supertrait in trait_def.supertraits:
					for pair in compiler_trait_methods_with_declaring_trait_seen(
						env,
						seen.append(trait_name),
						supertrait,
					):
						pairs = pairs.append(pair)

				pairs
			None:
				[]


pure func compiler_env_trait_methods_with_declaring_trait(
	env: CompilerEnv,
	trait_name: String,
) -> List[(String, String)]:
	compiler_trait_methods_with_declaring_trait_seen(env, [], trait_name)


private pure func compiler_env_find_trait_method_seen(
	env: CompilerEnv,
	seen: List[String],
	trait_name: String,
	method_name: String,
) -> Option[(CompilerTraitMethodSig, String)]:
	if seen.contains(trait_name):
		None
	else:
		match compiler_env_get_trait(env, trait_name):
			Some(trait_def):
				var result: Option[(CompilerTraitMethodSig, String)] = None

				for method in trait_def.methods:
					if method.name == method_name:
						result = Some((compiler_trait_method_sig_copy(method), trait_name))
						break

				if result.is_none():
					for supertrait in trait_def.supertraits:
						match compiler_env_find_trait_method_seen(
							env,
							seen.append(trait_name),
							supertrait,
							method_name,
						):
							Some(found):
								result = Some(found)
								break
							None:
								void

				result
			None:
				None


pure func compiler_env_find_trait_method(
	env: CompilerEnv,
	trait_name: String,
	method_name: String,
) -> Option[(CompilerTraitMethodSig, String)]:
	compiler_env_find_trait_method_seen(env, [], trait_name, method_name)


pure func compiler_env_find_trait_method_for_param(
	env: CompilerEnv,
	param_name: String,
	method_name: String,
) -> Option[(CompilerTraitMethodSig, String)]:
	var result: Option[(CompilerTraitMethodSig, String)] = None

	for bound in compiler_env_get_type_param_bounds(env, param_name):
		match compiler_env_find_trait_method(env, bound, method_name):
			Some(found):
				result = Some(found)
				break
			None:
				void

	result


pure func compiler_env_has_trait_bound_transitive(
	env: CompilerEnv,
	param_name: String,
	trait_name: String,
) -> Bool:
	var result: Bool = False

	for bound in compiler_env_get_type_param_bounds(env, param_name):
		if bound == trait_name or compiler_env_trait_has_supertrait(env, bound, trait_name):
			result = True
			break

	result


pure func compiler_env_trait_function_collision(
	env: CompilerEnv,
	func_name: String,
	trait_name: String,
) -> Option[String]:
	var result: Option[String] = None

	for pair in env.trait_functions:
		if pair[0] == func_name and pair[1] != trait_name:
			result = Some(pair[1])
			break

	result


pure func compiler_env_add_trait_function(
	env: CompilerEnv,
	func_name: String,
	trait_name: String,
) -> CompilerEnv:
	var exists: Bool = False

	for pair in env.trait_functions:
		if pair[0] == func_name and pair[1] == trait_name:
			exists = True
			break

	if exists:
		env
	else:
		{ env | trait_functions = env.trait_functions.append((func_name, trait_name)) }


pure func compiler_env_get_function_trait(env: CompilerEnv, func_name: String) -> Option[String]:
	var result: Option[String] = None

	for pair in env.trait_functions:
		if pair[0] == func_name:
			result = Some(pair[1])
			break

	result


pure func compiler_trait_obligation(
	obligation_type: CompilerType,
	trait_name: String,
) -> CompilerTraitObligation:
	{
		obligation_type = obligation_type,
		obligation_trait = compiler_trait_ref(trait_name)
	}


pure func compiler_trait_obligations_for_bound_type_param(
	param: CompilerBoundTypeParam,
	concrete_type: CompilerType,
) -> List[CompilerTraitObligation]:
	param.bounds.map(func(bound): {
			obligation_type = concrete_type,
			obligation_trait = bound
		})


pure func compiler_impl_instance(
	def_id: Int,
	trait_name: String,
	for_type: CompilerType,
	bounds: List[CompilerBoundTypeParam],
	is_builtin: Bool,
) -> CompilerImplInstance:
	compiler_impl_instance_with_methods(def_id, trait_name, for_type, bounds, [], is_builtin)


pure func compiler_impl_method_info(
	name: String,
	target: Option[CompilerImplMethodTarget],
	func_type: CompilerType,
	type_params: List[CompilerBoundTypeParam],
	param_names: List[Option[String]],
	purity: CompilerPurity,
	resource_args: CompilerResourceArgPolicy,
	dim_constraints: List[(CompilerType, CompilerType)],
	debug_only: Bool,
) -> CompilerImplMethodInfo:
	{
		name = name,
		target = target,
		func_type = compiler_type_copy(func_type),
		type_params = type_params.map(compiler_env_bound_type_param_copy),
		param_names = param_names.map(compiler_env_optional_param_name_copy),
		purity = purity,
		resource_args = resource_args,
		dim_constraints = dim_constraints.map(compiler_env_dim_constraint_copy),
		debug_only = debug_only
	}


private pure func compiler_impl_method_info_copy(
	info: CompilerImplMethodInfo,
) -> CompilerImplMethodInfo:
	compiler_impl_method_info(
		info.name,
		info.target,
		info.func_type,
		info.type_params,
		info.param_names,
		info.purity,
		info.resource_args,
		info.dim_constraints,
		info.debug_only,
	)


pure func compiler_impl_instance_with_methods(
	def_id: Int,
	trait_name: String,
	for_type: CompilerType,
	bounds: List[CompilerBoundTypeParam],
	methods: List[CompilerImplMethodInfo],
	is_builtin: Bool,
) -> CompilerImplInstance:
	{
		def_id = def_id,
		trait_name = trait_name,
		for_type = compiler_type_copy(for_type),
		bounds = bounds.map(compiler_env_bound_type_param_copy),
		methods = methods.map(compiler_impl_method_info_copy),
		is_builtin = is_builtin
	}


pure func compiler_env_add_impl(env: CompilerEnv, impl: CompilerImplInstance) -> CompilerEnv:
	{ env | impls = env.impls.append(impl) }


pure func compiler_env_find_impl_method_info(
	env: CompilerEnv,
	trait_name: String,
	method_name: String,
	receiver_type: CompilerType,
) -> Option[CompilerImplMethodInfo]:
	var result: Option[CompilerImplMethodInfo] = None

	for impl in env.impls:
		if (
			compiler_impl_satisfies_trait(env, impl, trait_name)
			and compiler_impl_matches_type(env, impl, receiver_type)
		):
			for method in impl.methods:
				if method.name == method_name:
					result = Some(compiler_impl_method_info_copy(method))
					break

		if result.is_some():
			break

	result


private pure func compiler_impl_matches_type(
	env: CompilerEnv,
	impl: CompilerImplInstance,
	typ: CompilerType,
) -> Bool:
	type_params: List[String] = impl.bounds.map(compiler_bound_type_param_name)

	matches: Bool = (
		compiler_types_equal(impl.for_type, typ)
		or (
			type_params.length() > 0
			and compiler_types_compatible_with_params(type_params, impl.for_type, typ)
		)
	)

	matches and compiler_impl_bounds_satisfied(env, impl, typ)


private pure func compiler_impls_may_overlap(
	left: CompilerImplInstance,
	right: CompilerImplInstance,
) -> Bool:
	left_params: List[String] = left.bounds.map(compiler_bound_type_param_name)
	right_params: List[String] = right.bounds.map(compiler_bound_type_param_name)
	type_params: List[String] = left_params.concat(right_params)

	(
		compiler_types_equal(left.for_type, right.for_type)
		or (
			type_params.length() > 0
			and ((
				compiler_types_compatible_with_params(type_params, left.for_type, right.for_type)
				or compiler_types_compatible_with_params(type_params, right.for_type, left.for_type)
			))
		)
	)


private pure func compiler_impl_pattern_param_name(
	type_params: List[String],
	pattern: CompilerType,
) -> Option[String]:
	match pattern:
		CompilerTypeVar(name):
			if type_params.contains(name):
				Some(name)
			else:
				None
		CompilerNamedType(name, args):
			if args.length() == 0 and type_params.contains(name):
				Some(name)
			else:
				None
		CompilerVarDimsType(name):
			if type_params.contains(name):
				Some(name)
			else:
				None
		_:
			None


private pure func compiler_impl_subst_lookup(
	subst: List[CompilerTypeSubstEntry],
	name: String,
) -> Option[CompilerType]:
	var result: Option[CompilerType] = None

	for entry in subst:
		if entry.var_name == name:
			result = Some(entry.concrete_type)
			break

	result


private pure func compiler_impl_add_subst(
	subst: List[CompilerTypeSubstEntry],
	name: String,
	concrete_type: CompilerType,
) -> Option[List[CompilerTypeSubstEntry]]:
	match compiler_impl_subst_lookup(subst, name):
		Some(existing_type):
			if compiler_types_equal(existing_type, concrete_type):
				Some(subst)
			else:
				None
		None:
			Some(subst.append(compiler_type_subst_entry(name, concrete_type)))


private pure func compiler_impl_match_type_lists_with_subst(
	type_params: List[String],
	patterns: List[CompilerType],
	actuals: List[CompilerType],
	subst: List[CompilerTypeSubstEntry],
) -> Option[List[CompilerTypeSubstEntry]]:
	if patterns.length() != actuals.length():
		None
	else:
		var current: Option[List[CompilerTypeSubstEntry]] = Some(subst)
		var index: Int = 0

		while index < patterns.length() and current.is_some():
			match (current, patterns.get(index), actuals.get(index)):
				(Some(current_subst), Some(pattern), Some(actual)):
					current = compiler_impl_match_type_with_subst(
						type_params,
						pattern,
						actual,
						current_subst,
					)
				_:
					current = None

			index += 1

		current


private pure func compiler_impl_type_contains_param(
	type_params: List[String],
	typ: CompilerType,
) -> Bool:
	if compiler_impl_pattern_param_name(type_params, typ).is_some():
		True
	else:
		match typ:
			CompilerNamedType(_, args):
				args.any(func(arg): compiler_impl_type_contains_param(type_params, arg))
			CompilerArrayType(element, dims):
				(
					compiler_impl_type_contains_param(type_params, element)
					or dims.any(func(dim): compiler_impl_type_contains_param(type_params, dim))
				)
			CompilerFunctionType(_, params, return_type):
				(
					params.any(func(param): compiler_impl_type_contains_param(type_params, param))
					or compiler_impl_type_contains_param(type_params, return_type)
				)
			CompilerTupleType(elements):
				elements.any(func(element): compiler_impl_type_contains_param(type_params, element))
			CompilerRangeType(inner):
				compiler_impl_type_contains_param(type_params, inner)
			CompilerDimOpType(_, left, right):
				(
					compiler_impl_type_contains_param(type_params, left)
					or compiler_impl_type_contains_param(type_params, right)
				)
			_:
				False


private pure func compiler_dim_ops_equal(left: CompilerDimOp, right: CompilerDimOp) -> Bool:
	match left:
		CompilerDimAdd:
			match right:
				CompilerDimAdd:
					True
				_:
					False
		CompilerDimSubtract:
			match right:
				CompilerDimSubtract:
					True
				_:
					False
		CompilerDimMultiply:
			match right:
				CompilerDimMultiply:
					True
				_:
					False
		CompilerDimDivide:
			match right:
				CompilerDimDivide:
					True
				_:
					False


private pure func compiler_impl_match_type_with_subst(
	type_params: List[String],
	pattern: CompilerType,
	actual: CompilerType,
	subst: List[CompilerTypeSubstEntry],
) -> Option[List[CompilerTypeSubstEntry]]:
	match compiler_impl_pattern_param_name(type_params, pattern):
		Some(param_name):
			compiler_impl_add_subst(subst, param_name, actual)
		None:
			if (
				compiler_types_equal(pattern, actual)
				and not compiler_impl_type_contains_param(type_params, pattern)
			):
				Some(subst)
			else:
				match pattern:
					CompilerNamedType(pattern_name, pattern_args):
						match actual:
							CompilerNamedType(actual_name, actual_args):
								if compiler_normalize_type_name(
									pattern_name,
								) == compiler_normalize_type_name(actual_name):
									compiler_impl_match_type_lists_with_subst(
										type_params,
										pattern_args,
										actual_args,
										subst,
									)
								else:
									None
							CompilerConstIntType(_):
								if (
									pattern_args.length() == 0
									and compiler_normalize_type_name(pattern_name) == "Int"
								):
									Some(subst)
								else:
									None
							_:
								None
					CompilerArrayType(pattern_element, pattern_dims):
						match actual:
							CompilerArrayType(actual_element, actual_dims):
								match compiler_impl_match_type_with_subst(
									type_params,
									pattern_element,
									actual_element,
									subst,
								):
									Some(element_subst):
										compiler_impl_match_type_lists_with_subst(
											type_params,
											pattern_dims,
											actual_dims,
											element_subst,
										)
									None:
										None
							_:
								None
					CompilerFunctionType(pattern_pure, pattern_params, pattern_return):
						match actual:
							CompilerFunctionType(actual_pure, actual_params, actual_return):
								if pattern_pure and not actual_pure:
									None
								else:
									match compiler_impl_match_type_lists_with_subst(
										type_params,
										pattern_params,
										actual_params,
										subst,
									):
										Some(param_subst):
											compiler_impl_match_type_with_subst(
												type_params,
												pattern_return,
												actual_return,
												param_subst,
											)
										None:
											None
							_:
								None
					CompilerTupleType(pattern_elements):
						match actual:
							CompilerTupleType(actual_elements):
								compiler_impl_match_type_lists_with_subst(
									type_params,
									pattern_elements,
									actual_elements,
									subst,
								)
							CompilerNamedType(actual_name, actual_elements):
								if compiler_normalize_type_name(actual_name) == "Tuple":
									compiler_impl_match_type_lists_with_subst(
										type_params,
										pattern_elements,
										actual_elements,
										subst,
									)
								else:
									None
							_:
								None
					CompilerRangeType(pattern_inner):
						match actual:
							CompilerRangeType(actual_inner):
								compiler_impl_match_type_with_subst(
									type_params,
									pattern_inner,
									actual_inner,
									subst,
								)
							_:
								None
					CompilerDimOpType(pattern_op, pattern_left, pattern_right):
						match actual:
							CompilerDimOpType(actual_op, actual_left, actual_right):
								if compiler_dim_ops_equal(pattern_op, actual_op):
									match compiler_impl_match_type_with_subst(
										type_params,
										pattern_left,
										actual_left,
										subst,
									):
										Some(left_subst):
											compiler_impl_match_type_with_subst(
												type_params,
												pattern_right,
												actual_right,
												left_subst,
											)
										None:
											None
								else:
									None
							_:
								None
					_:
						None


private pure func compiler_impl_bound_satisfied(
	env: CompilerEnv,
	subst: List[CompilerTypeSubstEntry],
	bound: CompilerBoundTypeParam,
) -> Bool:
	match compiler_impl_subst_lookup(subst, bound.name):
		Some(concrete_type):
			var satisfied: Bool = True

			for trait_ref in bound.bounds:
				if compiler_env_resolve_trait_obligation(
					env,
					compiler_trait_obligation(concrete_type, trait_ref.name),
				) != CompilerTraitObligationSatisfied:
					satisfied = False
					break

			satisfied
		None:
			True


private pure func compiler_impl_bounds_satisfied(
	env: CompilerEnv,
	impl: CompilerImplInstance,
	typ: CompilerType,
) -> Bool:
	if impl.bounds.length() == 0:
		True
	else:
		type_params: List[String] = impl.bounds.map(compiler_bound_type_param_name)

		match compiler_impl_match_type_with_subst(type_params, impl.for_type, typ, []):
			Some(subst):
				var satisfied: Bool = True

				for bound in impl.bounds:
					if not compiler_impl_bound_satisfied(env, subst, bound):
						satisfied = False
						break

				satisfied
			None:
				False


pure func compiler_env_find_conflicting_impl(
	env: CompilerEnv,
	candidate: CompilerImplInstance,
) -> Option[CompilerImplInstance]:
	var result: Option[CompilerImplInstance] = None

	for existing in env.impls:
		if (
			not existing.is_builtin
			and not candidate.is_builtin
			and existing.trait_name == candidate.trait_name
			and compiler_impls_may_overlap(existing, candidate)
		):
			result = Some(existing)
			break

	result


private pure func compiler_impl_satisfies_trait(
	env: CompilerEnv,
	impl: CompilerImplInstance,
	trait_name: String,
) -> Bool:
	(
		impl.trait_name == trait_name
		or compiler_env_trait_has_supertrait(env, impl.trait_name, trait_name)
	)


private pure func compiler_env_has_exact_impl_for_trait(
	env: CompilerEnv,
	typ: CompilerType,
	trait_name: String,
) -> Bool:
	var result: Bool = False

	for impl in env.impls:
		if impl.trait_name == trait_name and compiler_impl_matches_type(env, impl, typ):
			result = True
			break

	result


pure func compiler_env_has_direct_trait_evidence(
	env: CompilerEnv,
	obligation: CompilerTraitObligation,
) -> Bool:
	-- Used while validating impl supertraits. The candidate subtrait impl may
	-- already be indexed, so subtrait impls cannot prove their own supertraits.
	match obligation.obligation_type:
		CompilerMetaType(_):
			False
		CompilerTypeVar(name):
			compiler_env_has_trait_bound_transitive(env, name, obligation.obligation_trait.name)
		CompilerNamedType(name, args):
			if (
				args.length() == 0
				and compiler_env_has_trait_bound_transitive(
					env,
					name,
					obligation.obligation_trait.name,
				)
			):
				True
			else:
				compiler_env_has_exact_impl_for_trait(
					env,
					obligation.obligation_type,
					obligation.obligation_trait.name,
				)
		CompilerArrayType(_, _):
			(
				obligation.obligation_trait.name == "HasLength"
				or obligation.obligation_trait.name == "Stringable"
				or compiler_env_has_exact_impl_for_trait(
					env,
					obligation.obligation_type,
					obligation.obligation_trait.name,
				)
			)
		_:
			compiler_env_has_exact_impl_for_trait(
				env,
				obligation.obligation_type,
				obligation.obligation_trait.name,
			)


pure func compiler_env_resolve_trait_obligation(
	env: CompilerEnv,
	obligation: CompilerTraitObligation,
) -> CompilerTraitObligationResolution:
	match obligation.obligation_type:
		CompilerMetaType(_):
			CompilerTraitObligationDeferred
		CompilerTypeVar(name):
			if compiler_env_has_trait_bound_transitive(env, name, obligation.obligation_trait.name):
				CompilerTraitObligationSatisfied
			else:
				CompilerTraitObligationUnsatisfied
		CompilerNamedType(name, args):
			if (
				args.length() == 0
				and compiler_env_has_trait_bound_transitive(
					env,
					name,
					obligation.obligation_trait.name,
				)
			):
				CompilerTraitObligationSatisfied
			else:
				var result: CompilerTraitObligationResolution = CompilerTraitObligationUnsatisfied

				for impl in env.impls:
					if (
						compiler_impl_satisfies_trait(env, impl, obligation.obligation_trait.name)
						and compiler_impl_matches_type(env, impl, obligation.obligation_type)
					):
						result = CompilerTraitObligationSatisfied
						break

				result
		CompilerArrayType(_, _):
			if (
				obligation.obligation_trait.name == "HasLength"
				or obligation.obligation_trait.name == "Stringable"
			):
				CompilerTraitObligationSatisfied
			else:
				var result: CompilerTraitObligationResolution = CompilerTraitObligationUnsatisfied

				for impl in env.impls:
					if (
						compiler_impl_satisfies_trait(env, impl, obligation.obligation_trait.name)
						and compiler_impl_matches_type(env, impl, obligation.obligation_type)
					):
						result = CompilerTraitObligationSatisfied
						break

				result
		_:
			var result: CompilerTraitObligationResolution = CompilerTraitObligationUnsatisfied

			for impl in env.impls:
				if (
					compiler_impl_satisfies_trait(env, impl, obligation.obligation_trait.name)
					and compiler_impl_matches_type(env, impl, obligation.obligation_type)
				):
					result = CompilerTraitObligationSatisfied
					break

			result


pure func compiler_env_find_unsatisfied_trait_obligation(
	env: CompilerEnv,
	obligations: List[CompilerTraitObligation],
) -> Option[CompilerTraitObligation]:
	var result: Option[CompilerTraitObligation] = None

	for obligation in obligations:
		match compiler_env_resolve_trait_obligation(env, obligation):
			CompilerTraitObligationUnsatisfied:
				result = Some(obligation)
				break
			_:
				void

	result


pure func compiler_resolve_self(concrete_type: CompilerType, typ: CompilerType) -> CompilerType:
	match typ:
		CompilerSelfType:
			compiler_type_copy(concrete_type)
		CompilerNamedType(name, args):
			CompilerNamedType(
				name,
				args.map(func(arg): compiler_resolve_self(compiler_type_copy(concrete_type), arg)),
			)
		CompilerArrayType(element, dims):
			CompilerArrayType(
				compiler_resolve_self(compiler_type_copy(concrete_type), element),
				dims.map(func(dim): compiler_resolve_self(compiler_type_copy(concrete_type), dim)),
			)
		CompilerFunctionType(is_pure, params, return_type):
			CompilerFunctionType(
				is_pure,
				params.map(
					func(param): compiler_resolve_self(compiler_type_copy(concrete_type), param),
				),
				compiler_resolve_self(compiler_type_copy(concrete_type), return_type),
			)
		CompilerTupleType(elements):
			CompilerTupleType(elements.map(
				func(element): compiler_resolve_self(compiler_type_copy(concrete_type), element),
			))
		CompilerRangeType(inner):
			CompilerRangeType(compiler_resolve_self(compiler_type_copy(concrete_type), inner))
		CompilerDimOpType(op, left, right):
			CompilerDimOpType(
				op,
				compiler_resolve_self(compiler_type_copy(concrete_type), left),
				compiler_resolve_self(compiler_type_copy(concrete_type), right),
			)
		_:
			compiler_type_copy(typ)


pure func compiler_env_resolve_trait_method_sig(
	method: CompilerTraitMethodSig,
	concrete_type: CompilerType,
) -> CompilerTraitMethodSig:
	compiler_trait_method_sig_with_details(
		method.name,
		method.params.map(func(param): compiler_resolve_self(concrete_type, param)),
		compiler_resolve_self(concrete_type, method.return_type),
		method.is_pure,
		method.has_default,
		method.param_names.map(compiler_env_optional_param_name_copy),
	)


pure func compiler_overload_type_param_names(entry: CompilerOverloadEntry) -> List[String]:
	entry.type_params.map(compiler_bound_type_param_name)


private pure func compiler_replace_overload_set(
	sets: List[CompilerOverloadSet],
	name: String,
	entries: List[CompilerOverloadEntry],
) -> List[CompilerOverloadSet]:
	var result: List[CompilerOverloadSet] = []
	var replaced: Bool = False

	for set in sets:
		if set.name == name:
			result = result.append({
				name = name,
				entries = entries,
			})
			replaced = True
		else:
			result = result.append(set)

	if replaced:
		result
	else:
		result.append({
			name = name,
			entries = entries,
		})


private pure func compiler_find_overload_set(
	sets: List[CompilerOverloadSet],
	name: String,
) -> Option[CompilerOverloadSet]:
	var result: Option[CompilerOverloadSet] = None

	for set in sets:
		if set.name == name:
			result = Some(set)
			break

	result


pure func compiler_env_add_overload(
	env: CompilerEnv,
	name: String,
	entry: CompilerOverloadEntry,
) -> CompilerEnv:
	entries: List[CompilerOverloadEntry] = match compiler_find_overload_set(env.overloads, name):
		Some(set):
			set.entries.append(compiler_overload_entry_copy(entry))
		None:
			[compiler_overload_entry_copy(entry)]

	{ env | overloads = compiler_replace_overload_set(env.overloads, name, entries) }


pure func compiler_env_get_overloads(env: CompilerEnv, name: String) -> List[CompilerOverloadEntry]:
	match compiler_find_overload_set(env.overloads, name):
		Some(set):
			compiler_overload_entry_list_copy(set.entries)
		None:
			[]


private pure func compiler_find_entry_by_def_id(
	sets: List[CompilerOverloadSet],
	def_id: Int,
) -> Option[CompilerOverloadEntry]:
	var result: Option[CompilerOverloadEntry] = None

	for set in sets:
		for entry in set.entries:
			if entry.def_id == def_id:
				result = Some(compiler_overload_entry_copy(entry))
				break

		if result.is_some():
			break

	result


pure func compiler_env_find_overload_by_def_id(
	env: CompilerEnv,
	def_id: Int,
) -> Option[CompilerOverloadEntry]:
	compiler_find_entry_by_def_id(env.overloads, def_id)


pure func compiler_env_find_ufcs_method_by_def_id(
	env: CompilerEnv,
	def_id: Int,
) -> Option[CompilerOverloadEntry]:
	match compiler_find_entry_by_def_id(env.ufcs_methods, def_id):
		Some(entry):
			Some(entry)
		None:
			match compiler_env_find_func_by_def_id(env, def_id):
				Some(func_symbol):
					if compiler_func_symbol_supports_ufcs(func_symbol):
						Some(compiler_overload_entry_from_func_symbol(func_symbol))
					else:
						None
				None:
					None


pure func compiler_env_find_func_by_def_id(
	env: CompilerEnv,
	def_id: Int,
) -> Option[CompilerFuncSymbol]:
	var result: Option[CompilerFuncSymbol] = None

	for scope in env.scopes:
		for symbol in compiler_scope_symbols_in_lookup_order(scope):
			match symbol.kind:
				CompilerFuncSymbolKind(func_symbol):
					if func_symbol.callable_id == def_id:
						result = Some(compiler_func_symbol_copy(func_symbol))
						break
				_:
					void

		if result.is_some():
			break

	result


private pure func compiler_find_overload_type_params_by_def_id(
	sets: List[CompilerOverloadSet],
	def_id: Int,
) -> Option[List[CompilerBoundTypeParam]]:
	var result: Option[List[CompilerBoundTypeParam]] = None

	for set in sets:
		for entry in set.entries:
			if entry.def_id == def_id:
				result = Some(compiler_env_bound_type_param_list_copy(entry.type_params))
				break

		if result.is_some():
			break

	result


pure func compiler_env_find_callable_type_params_by_def_id(
	env: CompilerEnv,
	def_id: Int,
) -> Option[List[CompilerBoundTypeParam]]:
	match compiler_find_overload_type_params_by_def_id(env.overloads, def_id):
		Some(params):
			Some(params)
		None:
			match compiler_find_overload_type_params_by_def_id(env.ufcs_methods, def_id):
				Some(params):
					Some(params)
				None:
					match compiler_env_find_func_by_def_id(env, def_id):
						Some(func_symbol):
							Some(compiler_env_bound_type_param_list_copy(func_symbol.type_params))
						None:
							None


private pure func compiler_find_overload_debug_only_by_def_id(
	sets: List[CompilerOverloadSet],
	def_id: Int,
) -> Option[Bool]:
	var result: Option[Bool] = None

	for set in sets:
		for entry in set.entries:
			if entry.def_id == def_id:
				result = Some(entry.debug_only)
				break

		if result.is_some():
			break

	result


private pure func compiler_find_overload_loop_producer_by_def_id(
	sets: List[CompilerOverloadSet],
	def_id: Int,
) -> Option[CompilerLoopProducer]:
	var result: Option[CompilerLoopProducer] = None

	for set in sets:
		for entry in set.entries:
			if entry.def_id == def_id:
				result = entry.loop_producer
				break

		if result.is_some():
			break

	result


pure func compiler_env_find_callable_loop_producer_by_def_id(
	env: CompilerEnv,
	def_id: Int,
) -> Option[CompilerLoopProducer]:
	match compiler_env_find_func_by_def_id(env, def_id):
		Some(func_symbol):
			func_symbol.loop_producer
		None:
			match compiler_find_overload_loop_producer_by_def_id(env.overloads, def_id):
				Some(producer):
					Some(producer)
				None:
					compiler_find_overload_loop_producer_by_def_id(env.ufcs_methods, def_id)


pure func compiler_env_find_callable_debug_only_by_def_id(
	env: CompilerEnv,
	def_id: Int,
) -> Option[Bool]:
	match compiler_env_find_func_by_def_id(env, def_id):
		Some(func_symbol):
			Some(func_symbol.debug_only)
		None:
			match compiler_find_overload_debug_only_by_def_id(env.overloads, def_id):
				Some(debug_only):
					Some(debug_only)
				None:
					compiler_find_overload_debug_only_by_def_id(env.ufcs_methods, def_id)


private pure func compiler_function_first_param_type(
	func_type: CompilerType,
) -> Option[CompilerType]:
	match func_type:
		CompilerFunctionType(_, params, _):
			params.get(0)
		_:
			None


private pure func compiler_function_param_types(
	func_type: CompilerType,
) -> Option[List[CompilerType]]:
	match func_type:
		CompilerFunctionType(_, params, _):
			Some(params)
		_:
			None


private pure func compiler_overload_first_param_matches(
	entry: CompilerOverloadEntry,
	first_arg_type: CompilerType,
) -> Bool:
	match compiler_function_first_param_type(entry.func_type):
		Some(param_type):
			type_params = compiler_overload_type_param_names(entry)

			(
				compiler_ufcs_receiver_families_match(type_params, param_type, first_arg_type)
				and compiler_types_compatible_with_params(type_params, param_type, first_arg_type)
			)
		None:
			False


private pure func compiler_ufcs_receiver_family(
	type_params: List[String],
	typ: CompilerType,
) -> Option[String]:
	match typ:
		CompilerNamedType(name, args):
			if args.length() == 0 and type_params.contains(name):
				None
			else:
				Some(compiler_normalize_type_name(name))
		CompilerArrayType(_, _):
			Some(TYPE_NAME_TENSOR)
		_:
			None


private pure func compiler_ufcs_receiver_families_match(
	type_params: List[String],
	param_type: CompilerType,
	receiver_type: CompilerType,
) -> Bool:
	match (
		compiler_ufcs_receiver_family(type_params, param_type),
		compiler_ufcs_receiver_family([], receiver_type),
	):
		(Some(param_family), Some(receiver_family)):
			param_family == receiver_family
		_:
			True


private pure func compiler_overload_type_patterns_match(
	type_params: List[String],
	param_type: CompilerType,
	arg_type: CompilerType,
) -> Bool:
	match (param_type, arg_type):
		(CompilerFunctionType(param_pure, param_params, param_return), CompilerFunctionType(arg_pure, arg_params, arg_return)):
			(
				(not param_pure or arg_pure)
				and compiler_overload_callback_param_patterns_match(
					type_params,
					param_params,
					arg_params,
				)
				and compiler_overload_type_patterns_match(type_params, param_return, arg_return)
			)
		_:
			compiler_types_compatible_with_params(type_params, param_type, arg_type)


private pure func compiler_overload_pattern_contains_type_param(
	type_params: List[String],
	typ: CompilerType,
) -> Bool:
	match typ:
		CompilerTypeVar(name):
			type_params.contains(name)
		CompilerNamedType(name, args):
			(
				args.length() == 0 and type_params.contains(name)
				or args.any(
					func(arg): compiler_overload_pattern_contains_type_param(type_params, arg),
				)
			)
		CompilerArrayType(element, dims):
			(
				compiler_overload_pattern_contains_type_param(type_params, element)
				or dims.any(
					func(dim): compiler_overload_pattern_contains_type_param(type_params, dim),
				)
			)
		CompilerFunctionType(_, params, return_type):
			(
				params.any(
					func(param): compiler_overload_pattern_contains_type_param(type_params, param),
				)
				or compiler_overload_pattern_contains_type_param(type_params, return_type)
			)
		CompilerTupleType(elements):
			elements.any(
				func(element): compiler_overload_pattern_contains_type_param(type_params, element),
			)
		CompilerRangeType(inner):
			compiler_overload_pattern_contains_type_param(type_params, inner)
		CompilerDimOpType(_, left, right):
			(
				compiler_overload_pattern_contains_type_param(type_params, left)
				or compiler_overload_pattern_contains_type_param(type_params, right)
			)
		CompilerVarDimsType(_):
			True
		_:
			False


private pure func compiler_overload_callback_param_patterns_match(
	type_params: List[String],
	param_types: List[CompilerType],
	arg_types: List[CompilerType],
) -> Bool:
	if param_types.length() != arg_types.length():
		False
	else:
		var index: Int = 0
		var matches: Bool = True

		while index < param_types.length() and matches:
			match (param_types.get(index), arg_types.get(index)):
				(Some(param_type), Some(arg_type)):
					matches = if compiler_overload_pattern_contains_type_param(
						type_params,
						param_type,
					):
						compiler_overload_type_patterns_match(type_params, param_type, arg_type)
					else:
						compiler_types_compatible_with_params([], arg_type, param_type)
				_:
					matches = False

			index += 1

		matches


private pure func compiler_overload_type_pattern_lists_match(
	type_params: List[String],
	param_types: List[CompilerType],
	arg_types: List[CompilerType],
) -> Bool:
	if param_types.length() != arg_types.length():
		False
	else:
		var index: Int = 0
		var matches: Bool = True

		while index < param_types.length() and matches:
			match (param_types.get(index), arg_types.get(index)):
				(Some(param_type), Some(arg_type)):
					matches = compiler_overload_type_patterns_match(
						type_params,
						param_type,
						arg_type,
					)
				_:
					matches = False

			index += 1

		matches


private pure func compiler_overload_arg_types_match(
	entry: CompilerOverloadEntry,
	arg_types: List[CompilerType],
) -> Bool:
	match compiler_function_param_types(entry.func_type):
		Some(param_types):
			compiler_overload_type_pattern_lists_match(
				compiler_overload_type_param_names(entry),
				param_types,
				arg_types,
			)
		None:
			False


private pure func compiler_overload_pure_function_param_count(entry: CompilerOverloadEntry) -> Int:
	match compiler_function_param_types(entry.func_type):
		Some(param_types):
			var count: Int = 0

			for param_type in param_types:
				match param_type:
					CompilerFunctionType(True, _, _):
						count += 1
					_:
						void

			count
		None:
			0


private pure func compiler_string_list_copy(values: List[String]) -> List[String]:
	var result: List[String] = []

	for value in values:
		result = result.append(value)

	result


private pure func compiler_type_mentions_any_param(
	type_params: List[String],
	typ: CompilerType,
) -> Bool:
	match typ:
		CompilerTypeVar(name):
			type_params.contains(name)
		CompilerVarDimsType(name):
			type_params.contains(name)
		CompilerNamedType(_, args):
			args.any(func(arg):
				compiler_type_mentions_any_param(compiler_string_list_copy(type_params), arg)
			)
		CompilerArrayType(element, dims):
			(
				compiler_type_mentions_any_param(compiler_string_list_copy(type_params), element)
				or dims.any(func(dim):
					compiler_type_mentions_any_param(compiler_string_list_copy(type_params), dim)
				)
			)
		CompilerFunctionType(_, params, return_type):
			params.any(func(param):
				compiler_type_mentions_any_param(compiler_string_list_copy(type_params), param)
			) or compiler_type_mentions_any_param(
				compiler_string_list_copy(type_params),
				return_type,
			)
		CompilerTupleType(elements):
			elements.any(func(element):
				compiler_type_mentions_any_param(compiler_string_list_copy(type_params), element)
			)
		CompilerRangeType(inner):
			compiler_type_mentions_any_param(compiler_string_list_copy(type_params), inner)
		CompilerDimOpType(_, left, right):
			(
				compiler_type_mentions_any_param(compiler_string_list_copy(type_params), left)
				or compiler_type_mentions_any_param(compiler_string_list_copy(type_params), right)
			)
		_:
			False


private pure func compiler_overload_param_specificity_score(
	type_params: List[String],
	param_type: CompilerType,
	arg_type: CompilerType,
) -> Int:
	if compiler_types_equal(param_type, arg_type):
		4
	else if compiler_type_mentions_any_param(compiler_string_list_copy(type_params), param_type):
		1
	else:
		3


private pure func compiler_overload_arg_specificity_score(
	entry: CompilerOverloadEntry,
	arg_types: List[CompilerType],
) -> Int:
	match compiler_function_param_types(entry.func_type):
		Some(param_types):
			type_params = compiler_overload_type_param_names(entry)
			var score: Int = 0
			var index: Int = 0

			while index < param_types.length():
				match (param_types.get(index), arg_types.get(index)):
					(Some(param_type), Some(arg_type)):
						score += compiler_overload_param_specificity_score(
							compiler_string_list_copy(type_params),
							param_type,
							arg_type,
						)
					_:
						void

				index += 1

			score
		None:
			0


private pure func compiler_overload_selection_score(
	entry: CompilerOverloadEntry,
	arg_types: List[CompilerType],
) -> Int:
	compiler_overload_arg_specificity_score(
		entry,
		arg_types,
	) * 100 + compiler_overload_pure_function_param_count(entry)


private pure func compiler_select_unique_best_overload(
	entries: List[CompilerOverloadEntry],
	arg_types: List[CompilerType],
) -> Option[CompilerOverloadEntry]:
	var best: Option[CompilerOverloadEntry] = None
	var best_score: Int = -1
	var tied: Bool = False

	for entry in entries:
		score = compiler_overload_selection_score(entry, arg_types)

		if score > best_score:
			best = Some(compiler_overload_entry_copy(entry))
			best_score = score
			tied = False
		else if score == best_score:
			tied = True

	if tied:
		None
	else:
		best


pure func compiler_env_select_overload_for_args(
	entries: List[CompilerOverloadEntry],
	arg_types: List[CompilerType],
) -> Option[CompilerOverloadEntry]:
	var matches: List[CompilerOverloadEntry] = []

	for entry in entries:
		if compiler_overload_arg_types_match(entry, arg_types):
			matches = matches.append(compiler_overload_entry_copy(entry))

	compiler_select_unique_best_overload(matches, arg_types)


pure func compiler_env_resolve_overload(
	env: CompilerEnv,
	name: String,
	first_arg_type: CompilerType,
) -> Option[CompilerOverloadEntry]:
	var matches: List[CompilerOverloadEntry] = []

	for entry in compiler_env_get_overloads(env, name):
		if compiler_overload_first_param_matches(entry, first_arg_type):
			matches = matches.append(compiler_overload_entry_copy(entry))

	if matches.length() == 1:
		matches.get(0)
	else:
		compiler_select_unique_best_overload(matches, [first_arg_type])


pure func compiler_env_add_ufcs_method(
	env: CompilerEnv,
	name: String,
	entry: CompilerOverloadEntry,
) -> CompilerEnv:
	entries: List[CompilerOverloadEntry] = match compiler_find_overload_set(env.ufcs_methods, name):
		Some(set):
			set.entries.append(compiler_overload_entry_copy(entry))
		None:
			[compiler_overload_entry_copy(entry)]

	{ env | ufcs_methods = compiler_replace_overload_set(env.ufcs_methods, name, entries) }


private pure func compiler_env_lookup_function_ufcs_methods(
	env: CompilerEnv,
	name: String,
	first_arg_type: CompilerType,
) -> List[CompilerOverloadEntry]:
	var result: List[CompilerOverloadEntry] = []

	for scope in env.scopes:
		for symbol in compiler_scope_symbols_named(scope, name):
			match symbol.kind:
				CompilerFuncSymbolKind(func_symbol):
					if compiler_func_symbol_supports_ufcs(func_symbol):
						entry = compiler_overload_entry_from_func_symbol(func_symbol)

						if compiler_overload_first_param_matches(entry, first_arg_type):
							result = result.append(entry)
				_:
					void

	result


private pure func compiler_env_lookup_module_function_ufcs_methods(
	env: CompilerEnv,
	module_path: String,
	name: String,
	first_arg_type: CompilerType,
) -> List[CompilerOverloadEntry]:
	var result: List[CompilerOverloadEntry] = []

	for scope in env.scopes:
		for symbol in compiler_scope_symbols_named(scope, name):
			match symbol.kind:
				CompilerFuncSymbolKind(func_symbol):
					if (
						func_symbol.module_path == Some(module_path)
						and compiler_func_symbol_supports_ufcs(func_symbol)
					):
						entry = compiler_overload_entry_from_func_symbol(func_symbol)

						if compiler_overload_first_param_matches(entry, first_arg_type):
							result = result.append(entry)
				_:
					void

	result


pure func compiler_env_lookup_ufcs_methods(
	env: CompilerEnv,
	name: String,
	first_arg_type: CompilerType,
) -> List[CompilerOverloadEntry]:
	var result: List[CompilerOverloadEntry] = compiler_env_lookup_function_ufcs_methods(
		env,
		name,
		first_arg_type,
	)

	match compiler_find_overload_set(env.ufcs_methods, name):
		Some(set):
			for entry in set.entries:
				if compiler_overload_first_param_matches(entry, first_arg_type):
					result = result.append(entry)
		None:
			void

	result


pure func compiler_env_lookup_module_ufcs_methods(
	env: CompilerEnv,
	module_path: String,
	name: String,
	first_arg_type: CompilerType,
) -> List[CompilerOverloadEntry]:
	var result: List[CompilerOverloadEntry] = compiler_env_lookup_module_function_ufcs_methods(
		env,
		module_path,
		name,
		first_arg_type,
	)

	match compiler_find_overload_set(env.ufcs_methods, name):
		Some(set):
			for entry in set.entries:
				if (
					entry.module_path == Some(module_path)
					and compiler_overload_first_param_matches(entry, first_arg_type)
				):
					result = result.append(entry)
		None:
			void

	result


pure func compiler_env_select_ufcs_method(
	matches: List[CompilerOverloadEntry],
	receiver_type: CompilerType,
) -> Option[CompilerOverloadEntry]:
	if matches.length() == 1:
		matches.get(0)
	else:
		compiler_select_unique_best_overload(matches, [receiver_type])


pure func compiler_env_resolve_ufcs_method(
	env: CompilerEnv,
	name: String,
	receiver_type: CompilerType,
) -> Option[CompilerOverloadEntry]:
	compiler_env_select_ufcs_method(
		compiler_env_lookup_ufcs_methods(env, name, receiver_type),
		receiver_type,
	)


pure func compiler_env_resolve_module_ufcs_method(
	env: CompilerEnv,
	module_path: String,
	name: String,
	receiver_type: CompilerType,
) -> Option[CompilerOverloadEntry]:
	compiler_env_select_ufcs_method(
		compiler_env_lookup_module_ufcs_methods(env, module_path, name, receiver_type),
		receiver_type,
	)


pure func compiler_env_has_ufcs_method(env: CompilerEnv, name: String) -> Bool:
	match compiler_find_overload_set(env.ufcs_methods, name):
		Some(set):
			set.entries.length() > 0
		None:
			var found: Bool = False

			for scope in env.scopes:
				for symbol in compiler_scope_symbols_named(scope, name):
					match symbol.kind:
						CompilerFuncSymbolKind(func_symbol):
							if compiler_func_symbol_supports_ufcs(func_symbol):
								found = True
								break
						_:
							void

				if found:
					break

			found


pure func compiler_env_find_similar(env: CompilerEnv, name: String) -> Option[String]:
	var result: Option[String] = None

	for scope in env.scopes:
		for symbol in compiler_scope_symbols_in_lookup_order(scope):
			if symbol.name.starts_with(name) or name.starts_with(symbol.name):
				result = Some(symbol.name)
				break

		if result.is_some():
			break

	result
