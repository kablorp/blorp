import:
	compiler_generic_params: BoundTypeParam, bound_type_param_name
	compiler_refinement: ValueProofs, unrefined_binding
	compiler_type:
		CompilerDimOp(CompilerDimAdd, CompilerDimDivide, CompilerDimMultiply, CompilerDimSubtract),
		CompilerType(
			CompilerArrayType,
			CompilerConstIntType,
			CompilerDimOpType,
			CompilerFunctionType,
			CompilerMetaType,
			CompilerNamedType,
			CompilerRangeType,
			CompilerSelfType,
			CompilerTupleType,
			CompilerTypeVar,
			CompilerVarDimsType,
		),
		CompilerTypeSubstEntry,
		TYPE_NAME_TENSOR,
		compiler_apply_subst,
		compiler_is_dim_var_name,
		compiler_normalize_type_name,
		compiler_type_subst_entry,
		compiler_types_compatible_with_params,
		compiler_types_equal,
	compiler_type_name_metadata:
		compiler_is_one_shot_stream_type_name,
		compiler_is_resource_source_type_name,


enum VarMutability:
	ImmutableBinding
	MutableBinding


pure func var_mutability_is_mutable(mutability: VarMutability) -> Bool:
	match mutability:
		ImmutableBinding:
			False
		MutableBinding:
			True


pure func var_mutability(is_mutable: Bool) -> VarMutability:
	if is_mutable:
		MutableBinding
	else:
		ImmutableBinding


union VarOrigin:
	LetBinding
	FuncParam
	ForLoopVar
	MatchBinding
	ScopedResource
	ScopedResourceUnavailable(String)
	ScopedResourceDerived
	OtherBinding


enum Purity:
	Pure
	Impure


enum FuncOrigin:
	UserDefinedFunc
	BuiltinFunc
	ForeignFunc


enum ResourceResultPolicy:
	ResourceResultDependent
	ResourceResultIndependent
	ResourceResultOrdinary


union ResourceArgPolicy:
	RejectResourceArgs
	AllowResourceArgs(ResourceResultPolicy)


pure func purities_equal(left: Purity, right: Purity) -> Bool:
	left == right


pure func resource_result_policies_equal(
	left: ResourceResultPolicy,
	right: ResourceResultPolicy,
) -> Bool:
	left == right


pure func resource_arg_policies_equal(left: ResourceArgPolicy, right: ResourceArgPolicy) -> Bool:
	match left:
		RejectResourceArgs:
			match right:
				RejectResourceArgs:
					True
				AllowResourceArgs(_):
					False
		AllowResourceArgs(left_result):
			match right:
				AllowResourceArgs(right_result):
					resource_result_policies_equal(left_result, right_result)
				RejectResourceArgs:
					False


enum LoopProducer:
	LoopProducerIndices
	LoopProducerEnumerate
	LoopProducerEnumerate2
	LoopProducerWindows


pure func loop_producer_is_windows(producer: LoopProducer) -> Bool:
	producer == LoopProducerWindows


pure func loop_producer_is_indices(producer: LoopProducer) -> Bool:
	producer == LoopProducerIndices


pure func loop_producer_is_enumerate(producer: LoopProducer) -> Bool:
	producer == LoopProducerEnumerate


pure func loop_producer_is_enumerate2(producer: LoopProducer) -> Bool:
	producer == LoopProducerEnumerate2


enum TypeKind:
	TypeUnion
	TypeEnum
	TypeBuiltin
	TypeResource


private struct TypeContainmentSummary {
	may_contain_function: Bool,
	may_contain_one_shot_stream: Bool,
	may_contain_resource_source: Bool
}


record FieldDecl {
	name: String,
	field_type: CompilerType
}


record VariantDef {
	name: String,
	fields: List[CompilerType],
	tag: Int
}


record VarSymbol {
	var_type: CompilerType,
	source_type: Option[CompilerType],
	mutability: VarMutability,
	origin: VarOrigin,
	refinement: ValueProofs,
	module_path: Option[String]
}


record FuncSymbol {
	callable_id: Int,
	func_type: CompilerType,
	type_params: List[BoundTypeParam],
	param_names: List[Option[String]],
	purity: Purity,
	origin: FuncOrigin,
	resource_args: ResourceArgPolicy,
	module_path: Option[String],
	dim_constraints: List[(CompilerType, CompilerType)],
	loop_producer: Option[LoopProducer],
	debug_only: Bool
}


record TypeSymbol {
	type_params: List[String],
	variants: List[VariantDef],
	type_kind: TypeKind,
	contains_resource: Bool,
	may_contain_function: Bool,
	may_contain_one_shot_stream: Bool,
	may_contain_resource_source: Bool
}


record RecordSymbol {
	type_params: List[String],
	fields: List[FieldDecl],
	is_value: Bool,
	contains_resource: Bool,
	may_contain_function: Bool,
	may_contain_one_shot_stream: Bool,
	may_contain_resource_source: Bool
}


record AliasSymbol {
	type_params: List[String],
	target: CompilerType
}


record OpaqueAliasSymbol {
	type_params: List[String],
	target: CompilerType,
	home_module: Option[String]
}


record ConstructorSymbol {
	parent_type: String,
	constructor_id: Int,
	type_params: List[String],
	field_types: List[CompilerType],
	tag: Int
}


union SymbolKind:
	VarSymbolKind(VarSymbol)
	FuncSymbolKind(FuncSymbol)
	TypeSymbolKind(TypeSymbol)
	RecordSymbolKind(RecordSymbol)
	AliasSymbolKind(AliasSymbol)
	OpaqueAliasSymbolKind(OpaqueAliasSymbol)
	ConstructorSymbolKind(ConstructorSymbol)


record Symbol {
	name: String,
	kind: SymbolKind
}


record SymbolLookup {
	symbol: Symbol,
	scope_depth: Int
}


private record Scope {
	symbols: List[Symbol],
	symbols_by_name: Dict[String, List[Int]],
	function_indexes_by_callable_id: Dict[Int, Int]
}


union TypeBinding:
	UnionTypeBinding(TypeSymbol)
	RecordTypeBinding(RecordSymbol)
	AliasTypeBinding(AliasSymbol)
	OpaqueAliasTypeBinding(OpaqueAliasSymbol)


record TraitObligation {
	obligation_type: CompilerType,
	trait_name: String
}


enum TraitObligationResolution:
	TraitObligationSatisfied
	TraitObligationUnsatisfied
	TraitObligationDeferred


record TraitMethodSig {
	name: String,
	params: List[CompilerType],
	return_type: CompilerType,
	is_pure: Bool,
	has_default: Bool,
	param_names: List[Option[String]]
}


record TraitDef {
	def_id: Int,
	name: String,
	type_params: List[String],
	supertraits: List[String],
	methods: List[TraitMethodSig],
	module_path: Option[String]
}


record ImplMethodTarget {
	callable_id: Int,
	module_path: String
}


record ImplMethodInfo {
	name: String,
	target: Option[ImplMethodTarget],
	func_type: CompilerType,
	type_params: List[BoundTypeParam],
	param_names: List[Option[String]],
	purity: Purity,
	resource_args: ResourceArgPolicy,
	dim_constraints: List[(CompilerType, CompilerType)],
	debug_only: Bool
}


record ImplInstance {
	def_id: Int,
	trait_name: String,
	for_type: CompilerType,
	bounds: List[BoundTypeParam],
	methods: List[ImplMethodInfo],
	is_builtin: Bool
}


record OverloadEntry {
	def_id: Int,
	func_type: CompilerType,
	type_params: List[BoundTypeParam],
	param_names: List[Option[String]],
	purity: Purity,
	origin: FuncOrigin,
	resource_args: ResourceArgPolicy,
	module_path: Option[String],
	dim_constraints: List[(CompilerType, CompilerType)],
	loop_producer: Option[LoopProducer],
	debug_only: Bool
}


record OverloadSet {
	name: String,
	entries: List[OverloadEntry]
}


record Env {
	scopes: List[Scope],
	current_function: Option[String],
	current_function_pure: Bool,
	type_params_in_scope: List[String],
	type_param_bounds: List[BoundTypeParam],
	trait_functions: List[(String, String)],
	traits: List[TraitDef],
	impls: List[ImplInstance],
	overloads: List[OverloadSet],
	ufcs_methods: List[OverloadSet],
	next_def_id: Int,
	type_containment_summaries_valid: Bool
}


private pure func empty_scope() -> Scope:
	{
		symbols = [],
		symbols_by_name = {},
		function_indexes_by_callable_id = {}
	}


pure func string_lists_equal(left: List[String], right: List[String]) -> Bool:
	if left.length() != right.length():
		False
	else:
		var index: Int = 0
		var equal: Bool = True

		while index < left.length() and equal:
			equal = left.get_or(index, "") == right.get_or(index, "")
			index += 1

		equal


pure func env_empty() -> Env:
	{
		scopes = [empty_scope()],
		current_function = None,
		current_function_pure = False,
		type_params_in_scope = [],
		type_param_bounds = [],
		trait_functions = [],
		traits = [],
		impls = [],
		overloads = [],
		ufcs_methods = [],
		next_def_id = 0,
		type_containment_summaries_valid = True
	}


pure func env_push_scope(env: Env) -> Env:
	{ env | scopes = [empty_scope()].concat(env.scopes) }


pure func env_pop_scope(env: Env) -> Env:
	if env.scopes.length() <= 1:
		env
	else:
		var rest: List[Scope] = []
		var index: Int = 1

		while index < env.scopes.length():
			match env.scopes.get(index):
				Some(scope):
					rest = rest.append(scope)
				None:
					void

			index += 1

		{ env | scopes = rest }


pure func env_mint_def_id(env: Env) -> (Env, Int):
	({ env | next_def_id = env.next_def_id + 1 }, env.next_def_id)


private pure func symbol_is_type_binding(symbol: Symbol) -> Option[TypeBinding]:
	match symbol.kind:
		TypeSymbolKind(type_symbol):
			Some(UnionTypeBinding(type_symbol))
		RecordSymbolKind(record_symbol):
			Some(RecordTypeBinding(record_symbol))
		AliasSymbolKind(alias_symbol):
			Some(AliasTypeBinding(alias_symbol))
		OpaqueAliasSymbolKind(alias_symbol):
			Some(OpaqueAliasTypeBinding(alias_symbol))
		_:
			None


private pure func scope_add_symbol(scope: Scope, symbol: Symbol) -> Scope:
	symbol_index = scope.symbols.length()
	name_candidates = scope.symbols_by_name
		.get(symbol.name)
		.get_or([])

	function_indexes = match symbol.kind:
		FuncSymbolKind(func_symbol):
			scope.function_indexes_by_callable_id.set(func_symbol.callable_id, symbol_index)
		_:
			scope.function_indexes_by_callable_id

	{ scope |
		symbols = scope.symbols.append(symbol),
		symbols_by_name = scope.symbols_by_name.set(
			symbol.name,
			[symbol_index].concat(name_candidates),
		),
		function_indexes_by_callable_id = function_indexes
	}


private pure func scope_symbols_named(scope: Scope, name: String) -> List[Symbol]:
	var result: List[Symbol] = []

	for index in (
		scope.symbols_by_name
			.get(name)
			.get_or([])
	):
		match scope.symbols.get(index):
			Some(symbol):
				result = result.append(symbol)
			None:
				void

	result


private pure func scope_symbols_in_lookup_order(scope: Scope) -> List[Symbol]:
	var result: List[Symbol] = []
	var index: Int = scope.symbols.length()

	while index > 0:
		index -= 1

		match scope.symbols.get(index):
			Some(symbol):
				result = result.append(symbol)
			None:
				void

	result


private pure func scope_lookup(scope: Scope, name: String) -> Option[Symbol]:
	match (
		scope.symbols_by_name
			.get(name)
			.get_or([])
			.get(0)
	):
		Some(index):
			scope.symbols.get(index)
		None:
			None


pure func env_add_symbol(env: Env, symbol: Symbol) -> Env:
	shadows_type_binding = match symbol_is_type_binding(symbol):
		Some(_):
			env_lookup(env, symbol.name).is_some()
		None:
			False

	next_env = if shadows_type_binding:
		{ env | type_containment_summaries_valid = False }
	else:
		env

	match next_env.scopes.get(0):
		Some(current):
			var scopes: List[Scope] = [scope_add_symbol(current, symbol)]
			var index: Int = 1

			while index < next_env.scopes.length():
				match next_env.scopes.get(index):
					Some(scope):
						scopes = scopes.append(scope)
					None:
						void

				index += 1

			{ next_env | scopes = scopes }
		None:
			{ next_env | scopes = [scope_add_symbol(empty_scope(), symbol)] }


pure func env_lookup_in_current_scope(env: Env, name: String) -> Option[Symbol]:
	match env.scopes.get(0):
		Some(scope):
			scope_lookup(scope, name)
		None:
			None


pure func env_lookup(env: Env, name: String) -> Option[Symbol]:
	var result: Option[Symbol] = None

	for scope in env.scopes:
		match scope_lookup(scope, name):
			Some(symbol):
				result = Some(symbol)
				break
			None:
				void

	result


pure func env_symbols_named(env: Env, name: String) -> List[Symbol]:
	var result: List[Symbol] = []

	for scope in env.scopes:
		result = result.concat(scope_symbols_named(scope, name))

	result


pure func env_lookup_with_scope_depth(env: Env, name: String) -> Option[SymbolLookup]:
	var result: Option[SymbolLookup] = None
	var depth: Int = 0

	for scope in env.scopes:
		match scope_lookup(scope, name):
			Some(symbol):
				result = Some({
					symbol = symbol,
					scope_depth = depth,
				})
				break
			None:
				depth += 1

	result


pure func env_lookup_is_outermost_scope(env: Env, lookup: SymbolLookup) -> Bool:
	lookup.scope_depth == env.scopes.length() - 1


private pure func env_find_type_binding(env: Env, name: String) -> Option[TypeBinding]:
	match env_lookup(env, name):
		Some(symbol):
			symbol_is_type_binding(symbol)
		None:
			None


pure func symbol_kind_label(symbol: Symbol) -> String:
	match symbol.kind:
		VarSymbolKind(_):
			"variable"
		FuncSymbolKind(_):
			"function"
		TypeSymbolKind(_):
			"type"
		RecordSymbolKind(_):
			"record"
		AliasSymbolKind(_):
			"type alias"
		OpaqueAliasSymbolKind(_):
			"opaque type"
		ConstructorSymbolKind(_):
			"constructor"


pure func env_add_var_with_module_details(
	env: Env,
	name: String,
	var_type: CompilerType,
	source_type: Option[CompilerType],
	mutability: VarMutability,
	origin: VarOrigin,
	refinement: ValueProofs,
	module_path: Option[String],
) -> Env:
	env_add_symbol(
		env,
		{
			name = name,
			kind = VarSymbolKind({
				var_type = var_type,
				source_type = source_type,
				mutability = mutability,
				origin = origin,
				refinement = refinement,
				module_path = module_path,
			})
		},
	)


pure func env_add_var_with_details(
	env: Env,
	name: String,
	var_type: CompilerType,
	source_type: Option[CompilerType],
	mutability: VarMutability,
	origin: VarOrigin,
	refinement: ValueProofs,
) -> Env:
	env_add_var_with_module_details(
		env,
		name,
		var_type,
		source_type,
		mutability,
		origin,
		refinement,
		None,
	)


pure func env_add_var(env: Env, name: String, var_type: CompilerType) -> Env:
	env_add_var_with_details(
		env,
		name,
		var_type,
		None,
		ImmutableBinding,
		LetBinding,
		unrefined_binding(),
	)


pure func env_get_var_type(env: Env, name: String) -> Option[CompilerType]:
	match env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				VarSymbolKind(var_symbol):
					Some(var_symbol.var_type)
				FuncSymbolKind(func_symbol):
					Some(func_symbol.func_type)
				_:
					None
		None:
			None


pure func env_get_module_var_symbol(
	env: Env,
	module_path: String,
	name: String,
) -> Option[VarSymbol]:
	var result: Option[VarSymbol] = None

	for scope in env.scopes:
		for symbol in scope_symbols_named(scope, name):
			match symbol.kind:
				VarSymbolKind(var_symbol):
					if var_symbol.module_path == Some(module_path):
						result = Some(var_symbol)
						break
				_:
					void

		if result.is_some():
			break

	result


pure func env_get_var_refinement(env: Env, name: String) -> Option[ValueProofs]:
	match env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				VarSymbolKind(var_symbol):
					Some(var_symbol.refinement)
				_:
					None
		None:
			None


pure func env_var_is_immutable(env: Env, name: String) -> Bool:
	match env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				VarSymbolKind(var_symbol):
					not var_mutability_is_mutable(var_symbol.mutability)
				_:
					False
		None:
			False


pure func env_is_func_param(env: Env, name: String) -> Bool:
	match env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				VarSymbolKind(var_symbol):
					match var_symbol.origin:
						FuncParam:
							True
						_:
							False
				_:
					False
		None:
			False


pure func env_is_scoped_resource_related_var(env: Env, name: String) -> Bool:
	match env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				VarSymbolKind(var_symbol):
					match var_symbol.origin:
						ScopedResource:
							True
						ScopedResourceUnavailable(_):
							True
						ScopedResourceDerived:
							True
						_:
							False
				_:
					False
		None:
			False


pure func env_get_var_origin(env: Env, name: String) -> Option[VarOrigin]:
	match env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				VarSymbolKind(var_symbol):
					Some(var_symbol.origin)
				_:
					None
		None:
			None


pure func env_is_scoped_resource_var(env: Env, name: String) -> Bool:
	match env_get_var_origin(env, name):
		Some(ScopedResource):
			True
		_:
			False


pure func env_is_scoped_resource_derived_var(env: Env, name: String) -> Bool:
	match env_get_var_origin(env, name):
		Some(ScopedResourceDerived):
			True
		_:
			False


pure func env_scoped_resource_unavailable_owner(env: Env, name: String) -> Option[String]:
	match env_get_var_origin(env, name):
		Some(ScopedResourceUnavailable(owner)):
			Some(owner)
		_:
			None


pure func func_symbol(
	callable_id: Int,
	func_type: CompilerType,
	type_params: List[BoundTypeParam],
	param_names: List[Option[String]],
	purity: Purity,
	origin: FuncOrigin,
	resource_args: ResourceArgPolicy,
	module_path: Option[String],
	dim_constraints: List[(CompilerType, CompilerType)],
	loop_producer: Option[LoopProducer],
	debug_only: Bool,
) -> FuncSymbol:
	-- Environment metadata is immutable. Sharing nested types and lists avoids
	-- rebuilding identical trees; later updates use value semantics and COW.
	{
		callable_id = callable_id,
		func_type = func_type,
		type_params = type_params,
		param_names = param_names,
		purity = purity,
		origin = origin,
		resource_args = resource_args,
		module_path = module_path,
		dim_constraints = dim_constraints,
		loop_producer = loop_producer,
		debug_only = debug_only
	}


pure func overload_entry_from_func_symbol(info: FuncSymbol) -> OverloadEntry:
	{
		def_id = info.callable_id,
		func_type = info.func_type,
		type_params = info.type_params,
		param_names = info.param_names,
		purity = info.purity,
		origin = info.origin,
		resource_args = info.resource_args,
		module_path = info.module_path,
		dim_constraints = info.dim_constraints,
		loop_producer = info.loop_producer,
		debug_only = info.debug_only
	}


private pure func func_symbol_supports_ufcs(info: FuncSymbol) -> Bool:
	match info.func_type:
		CompilerFunctionType(_, params, _):
			params.length() > 0
		_:
			False


pure func env_add_func_with_info(env: Env, name: String, info: FuncSymbol) -> Env:
	env_add_symbol(
		env,
		{
			name = name,
			kind = FuncSymbolKind(info)
		},
	)


pure func env_add_func(
	env: Env,
	name: String,
	func_type: CompilerType,
	purity: Purity,
	origin: FuncOrigin,
) -> Env:
	match env_mint_def_id(env):
		(next_env, def_id):
			env_add_func_with_info(
				next_env,
				name,
				func_symbol(
					def_id,
					func_type,
					[],
					[],
					purity,
					origin,
					RejectResourceArgs,
					None,
					[],
					None,
					False,
				),
			)


pure func env_get_func_info(
	env: Env,
	name: String,
) -> Option[(CompilerType, List[BoundTypeParam], Purity)]:
	match env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				FuncSymbolKind(func_symbol):
					Some((func_symbol.func_type, func_symbol.type_params, func_symbol.purity))
				_:
					None
		None:
			None


pure func env_get_module_func_symbol(
	env: Env,
	module_path: String,
	name: String,
) -> Option[FuncSymbol]:
	var result: Option[FuncSymbol] = None

	for scope in env.scopes:
		for symbol in scope_symbols_named(scope, name):
			match symbol.kind:
				FuncSymbolKind(func_symbol):
					if func_symbol.module_path == Some(module_path):
						result = Some(func_symbol)
						break
				_:
					void

		if result.is_some():
			break

	result


pure func env_find_func_named_by_def_id(env: Env, name: String, def_id: Int) -> Option[FuncSymbol]:
	var result: Option[FuncSymbol] = None

	for scope in env.scopes:
		for index in (
			scope.symbols_by_name
				.get(name)
				.get_or([])
		):
			match scope.symbols.get(index):
				Some(symbol):
					match symbol.kind:
						FuncSymbolKind(func_symbol):
							if func_symbol.callable_id == def_id:
								result = Some(func_symbol)
								break
						_:
							void
				None:
					void

		if result.is_some():
			break

	result


pure func env_get_func_callable_id(env: Env, name: String) -> Option[Int]:
	match env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				FuncSymbolKind(func_symbol):
					Some(func_symbol.callable_id)
				_:
					None
		None:
			None


pure func env_is_builtin_func(env: Env, name: String) -> Bool:
	match env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				FuncSymbolKind(func_symbol):
					func_symbol.origin == BuiltinFunc
				_:
					False
		None:
			False


pure func env_is_local_func(env: Env, name: String) -> Bool:
	match env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				FuncSymbolKind(func_symbol):
					func_symbol.origin != BuiltinFunc and func_symbol.module_path.is_none()
				_:
					False
		None:
			False


private pure func type_containment_summary_empty() -> TypeContainmentSummary:
	{
		may_contain_function = False,
		may_contain_one_shot_stream = False,
		may_contain_resource_source = False
	}


private pure func type_containment_summary_unknown() -> TypeContainmentSummary:
	-- Only a proven-false summary can skip a recursive scan.
	{
		may_contain_function = True,
		may_contain_one_shot_stream = True,
		may_contain_resource_source = True
	}


private pure func type_containment_summary_for_name(name: String) -> TypeContainmentSummary:
	{
		may_contain_function = False,
		may_contain_one_shot_stream = compiler_is_one_shot_stream_type_name(name),
		may_contain_resource_source = compiler_is_resource_source_type_name(name)
	}


private pure func type_containment_summary_merge(
	left: TypeContainmentSummary,
	right: TypeContainmentSummary,
) -> TypeContainmentSummary:
	{
		may_contain_function = left.may_contain_function or right.may_contain_function,
		may_contain_one_shot_stream = (
			left.may_contain_one_shot_stream
			or right.may_contain_one_shot_stream
		),
		may_contain_resource_source = (
			left.may_contain_resource_source
			or right.may_contain_resource_source
		)
	}


private pure func type_containment_summary_is_complete(summary: TypeContainmentSummary) -> Bool:
	(
		summary.may_contain_function
		and summary.may_contain_one_shot_stream
		and summary.may_contain_resource_source
	)


private pure func type_symbol_containment_summary(symbol: TypeSymbol) -> TypeContainmentSummary:
	{
		may_contain_function = symbol.may_contain_function,
		may_contain_one_shot_stream = symbol.may_contain_one_shot_stream,
		may_contain_resource_source = symbol.may_contain_resource_source
	}


private pure func record_symbol_containment_summary(symbol: RecordSymbol) -> TypeContainmentSummary:
	{
		may_contain_function = symbol.may_contain_function,
		may_contain_one_shot_stream = symbol.may_contain_one_shot_stream,
		may_contain_resource_source = symbol.may_contain_resource_source
	}


private pure func types_containment_summary_seen(
	env: Env,
	rigid_type_params: List[String],
	visited: List[String],
	types: List[CompilerType],
) -> TypeContainmentSummary:
	var summary = type_containment_summary_empty()

	for typ in types:
		summary = type_containment_summary_merge(
			summary,
			type_containment_summary_seen(env, rigid_type_params, visited, typ),
		)

		if type_containment_summary_is_complete(summary):
			break

	summary


private pure func type_containment_summary_seen(
	env: Env,
	rigid_type_params: List[String],
	visited: List[String],
	typ: CompilerType,
) -> TypeContainmentSummary:
	match typ:
		CompilerFunctionType(_, _, _):
			{ type_containment_summary_empty() | may_contain_function = True }
		CompilerNamedType(name, args):
			direct = type_containment_summary_for_name(name)

			if rigid_type_params.contains(name) or visited.contains(name):
				type_containment_summary_unknown()
			else:
				next_visited = visited.append(name)
				args_summary = types_containment_summary_seen(
					env,
					rigid_type_params,
					next_visited,
					args,
				)

				binding_summary = match env_find_type_binding(env, name):
					Some(UnionTypeBinding(type_symbol)):
						type_symbol_containment_summary(type_symbol)
					Some(RecordTypeBinding(record_symbol)):
						record_symbol_containment_summary(record_symbol)
					Some(AliasTypeBinding(alias_symbol)):
						type_containment_summary_seen(
							env,
							rigid_type_params,
							next_visited,
							alias_symbol.target,
						)
					Some(OpaqueAliasTypeBinding(alias_symbol)):
						type_containment_summary_seen(
							env,
							rigid_type_params,
							next_visited,
							alias_symbol.target,
						)
					None:
						type_containment_summary_unknown()

				type_containment_summary_merge(
					direct,
					type_containment_summary_merge(args_summary, binding_summary),
				)
		CompilerArrayType(element, dims):
			type_containment_summary_merge(
				type_containment_summary_seen(env, rigid_type_params, visited, element),
				types_containment_summary_seen(env, rigid_type_params, visited, dims),
			)
		CompilerTupleType(elements):
			types_containment_summary_seen(env, rigid_type_params, visited, elements)
		CompilerRangeType(inner):
			type_containment_summary_seen(env, rigid_type_params, visited, inner)
		CompilerDimOpType(_, left, right):
			type_containment_summary_merge(
				type_containment_summary_seen(env, rigid_type_params, visited, left),
				type_containment_summary_seen(env, rigid_type_params, visited, right),
			)
		CompilerTypeVar(_):
			type_containment_summary_unknown()
		CompilerMetaType(_):
			type_containment_summary_unknown()
		CompilerSelfType:
			type_containment_summary_unknown()
		CompilerVarDimsType(_):
			type_containment_summary_unknown()
		_:
			type_containment_summary_empty()


private pure func type_containment_summary(
	env: Env,
	rigid_type_params: List[String],
	typ: CompilerType,
) -> TypeContainmentSummary:
	type_containment_summary_seen(env, rigid_type_params, [], typ)


private pure func variants_containment_summary(
	env: Env,
	rigid_type_params: List[String],
	variants: List[VariantDef],
) -> TypeContainmentSummary:
	var summary = type_containment_summary_empty()

	for variant in variants:
		summary = type_containment_summary_merge(
			summary,
			types_containment_summary_seen(env, rigid_type_params, [], variant.fields),
		)

		if type_containment_summary_is_complete(summary):
			break

	summary


private pure func fields_containment_summary(
	env: Env,
	rigid_type_params: List[String],
	fields: List[FieldDecl],
) -> TypeContainmentSummary:
	var summary = type_containment_summary_empty()

	for field in fields:
		summary = type_containment_summary_merge(
			summary,
			type_containment_summary(env, rigid_type_params, field.field_type),
		)

		if type_containment_summary_is_complete(summary):
			break

	summary


pure func env_add_type_with_constructor_ids(
	env: Env,
	name: String,
	type_params: List[String],
	variants: List[VariantDef],
	type_kind: TypeKind,
	contains_resource: Bool,
	with_ctors: Bool,
	constructor_ids: List[Option[Int]],
) -> Env:
	containment = type_containment_summary_merge(
		type_containment_summary_for_name(name),
		variants_containment_summary(env, type_params, variants),
	)
	type_env: Env = env_add_symbol(
		env,
		{
			name = name,
			kind = TypeSymbolKind({
				type_params = type_params,
				variants = variants,
				type_kind = type_kind,
				contains_resource = contains_resource,
				may_contain_function = containment.may_contain_function,
				may_contain_one_shot_stream = containment.may_contain_one_shot_stream,
				may_contain_resource_source = containment.may_contain_resource_source,
			})
		},
	)

	if not with_ctors:
		type_env
	else:
		var current_env: Env = type_env
		var index: Int = 0

		for variant in variants:
			(next_env, def_id) = match constructor_ids.get(index):
				Some(Some(reserved_id)):
					(current_env, reserved_id)
				_:
					env_mint_def_id(current_env)

			current_env = env_add_symbol(
				next_env,
				{
					name = variant.name,
					kind = ConstructorSymbolKind({
						parent_type = name,
						constructor_id = def_id,
						type_params = type_params,
						field_types = variant.fields,
						tag = variant.tag,
					})
				},
			)
			index += 1

		current_env


pure func env_add_type(
	env: Env,
	name: String,
	type_params: List[String],
	variants: List[VariantDef],
	type_kind: TypeKind,
	contains_resource: Bool,
	with_ctors: Bool,
) -> Env:
	env_add_type_with_constructor_ids(
		env,
		name,
		type_params,
		variants,
		type_kind,
		contains_resource,
		with_ctors,
		[],
	)


pure func env_add_record(
	env: Env,
	name: String,
	type_params: List[String],
	fields: List[FieldDecl],
	is_value: Bool,
	contains_resource: Bool,
) -> Env:
	containment = type_containment_summary_merge(
		type_containment_summary_for_name(name),
		fields_containment_summary(env, type_params, fields),
	)
	env_add_symbol(
		env,
		{
			name = name,
			kind = RecordSymbolKind({
				type_params = type_params,
				fields = fields,
				is_value = is_value,
				contains_resource = contains_resource,
				may_contain_function = containment.may_contain_function,
				may_contain_one_shot_stream = containment.may_contain_one_shot_stream,
				may_contain_resource_source = containment.may_contain_resource_source,
			})
		},
	)


pure func env_add_alias(
	env: Env,
	name: String,
	type_params: List[String],
	target: CompilerType,
) -> Env:
	env_add_symbol(
		env,
		{
			name = name,
			kind = AliasSymbolKind({
				type_params = type_params,
				target = target,
			})
		},
	)


pure func env_add_opaque_alias(
	env: Env,
	name: String,
	type_params: List[String],
	target: CompilerType,
	home_module: Option[String],
) -> Env:
	env_add_symbol(
		env,
		{
			name = name,
			kind = OpaqueAliasSymbolKind({
				type_params = type_params,
				target = target,
				home_module = home_module,
			})
		},
	)


pure func env_get_type_decl(env: Env, name: String) -> Option[(List[String], List[VariantDef])]:
	match env_find_type_binding(env, name):
		Some(UnionTypeBinding(type_symbol)):
			Some((type_symbol.type_params, type_symbol.variants))
		_:
			None


pure func env_get_type_kind(env: Env, name: String) -> Option[TypeKind]:
	match env_find_type_binding(env, name):
		Some(UnionTypeBinding(type_symbol)):
			Some(type_symbol.type_kind)
		_:
			None


pure func env_type_is_enum(env: Env, name: String) -> Bool:
	match env_find_type_binding(env, name):
		Some(UnionTypeBinding(type_symbol)):
			match type_symbol.type_kind:
				TypeEnum:
					True
				_:
					False
		_:
			False


pure func env_type_is_resource(env: Env, name: String) -> Bool:
	match env_find_type_binding(env, name):
		Some(UnionTypeBinding(type_symbol)):
			match type_symbol.type_kind:
				TypeResource:
					True
				_:
					False
		_:
			False


pure func env_get_type_contains_resource(env: Env, name: String) -> Bool:
	match env_find_type_binding(env, name):
		Some(UnionTypeBinding(type_symbol)):
			type_symbol.contains_resource
		Some(RecordTypeBinding(record_symbol)):
			record_symbol.contains_resource
		_:
			False


pure func env_type_resource_scan_is_proven_unnecessary(env: Env, name: String) -> Bool:
	if not env.type_containment_summaries_valid:
		False
	else:
		match env_find_type_binding(env, name):
			Some(UnionTypeBinding(type_symbol)):
				(
					not type_symbol.may_contain_function
					and not type_symbol.may_contain_one_shot_stream
					and not type_symbol.may_contain_resource_source
				)
			Some(RecordTypeBinding(record_symbol)):
				(
					not record_symbol.may_contain_function
					and not record_symbol.may_contain_one_shot_stream
					and not record_symbol.may_contain_resource_source
				)
			_:
				False


pure func env_type_may_contain_function(env: Env, name: String) -> Option[Bool]:
	if not env.type_containment_summaries_valid:
		None
	else:
		match env_find_type_binding(env, name):
			Some(UnionTypeBinding(type_symbol)):
				Some(type_symbol.may_contain_function)
			Some(RecordTypeBinding(record_symbol)):
				Some(record_symbol.may_contain_function)
			_:
				None


pure func env_type_may_contain_one_shot_stream(env: Env, name: String) -> Option[Bool]:
	if not env.type_containment_summaries_valid:
		None
	else:
		match env_find_type_binding(env, name):
			Some(UnionTypeBinding(type_symbol)):
				Some(type_symbol.may_contain_one_shot_stream)
			Some(RecordTypeBinding(record_symbol)):
				Some(record_symbol.may_contain_one_shot_stream)
			_:
				None


pure func env_type_may_contain_resource_source(env: Env, name: String) -> Option[Bool]:
	if not env.type_containment_summaries_valid:
		None
	else:
		match env_find_type_binding(env, name):
			Some(UnionTypeBinding(type_symbol)):
				Some(type_symbol.may_contain_resource_source)
			Some(RecordTypeBinding(record_symbol)):
				Some(record_symbol.may_contain_resource_source)
			_:
				None


pure func env_get_constructor(env: Env, name: String) -> Option[ConstructorSymbol]:
	match env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				ConstructorSymbolKind(ctor):
					Some(ctor)
				_:
					None
		None:
			None


pure func env_get_constructors(env: Env, name: String) -> List[ConstructorSymbol]:
	var constructors: List[ConstructorSymbol] = []

	for scope in env.scopes:
		for symbol in scope_symbols_named(scope, name):
			match symbol.kind:
				ConstructorSymbolKind(ctor):
					constructors = constructors.append(ctor)
				_:
					void

	constructors


pure func env_get_constructor_for_parent(
	env: Env,
	parent_type: String,
	name: String,
) -> Option[ConstructorSymbol]:
	var result: Option[ConstructorSymbol] = None

	for ctor in env_get_constructors(env, name):
		if result.is_none() and ctor.parent_type == parent_type:
			result = Some(ctor)

	result


pure func env_get_record(env: Env, name: String) -> Option[(List[String], List[FieldDecl])]:
	match env_find_type_binding(env, name):
		Some(RecordTypeBinding(record_symbol)):
			Some((record_symbol.type_params, record_symbol.fields))
		_:
			None


pure func env_is_value_record(env: Env, name: String) -> Bool:
	match env_find_type_binding(env, name):
		Some(RecordTypeBinding(record_symbol)):
			record_symbol.is_value
		_:
			False


pure func env_get_alias(env: Env, name: String) -> Option[(List[String], CompilerType)]:
	match env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				AliasSymbolKind(alias_symbol):
					Some((alias_symbol.type_params, alias_symbol.target))
				_:
					empty: Option[(List[String], CompilerType)] = None
					empty
		_:
			empty: Option[(List[String], CompilerType)] = None
			empty


pure func env_get_opaque_alias(
	env: Env,
	name: String,
) -> Option[(List[String], CompilerType, Option[String])]:
	match env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				OpaqueAliasSymbolKind(alias_symbol):
					Some((alias_symbol.type_params, alias_symbol.target, alias_symbol.home_module))
				_:
					empty: Option[(List[String], CompilerType, Option[String])] = None
					empty
		_:
			empty: Option[(List[String], CompilerType, Option[String])] = None
			empty


private pure func field_names_match(fields: List[FieldDecl], names: List[String]) -> Bool:
	string_lists_equal(
		fields
			.map(func(field): field.name)
			.sort(),
		names.sort(),
	)


pure func env_find_records_with_fields(env: Env, field_names: List[String]) -> List[String]:
	var matches: List[String] = []

	for scope in env.scopes:
		for symbol in scope_symbols_in_lookup_order(scope):
			match symbol.kind:
				RecordSymbolKind(record_symbol):
					if (
						field_names_match(record_symbol.fields, field_names)
						and not matches.contains(symbol.name)
					):
						matches = matches.append(symbol.name)
				_:
					void

	matches


private pure func nominal_dim_params(env: Env, name: String) -> Option[List[String]]:
	params: Option[List[String]] = match env_get_record(env, name):
		Some((type_params, _)):
			Some(type_params)
		None:
			match env_get_type_decl(env, name):
				Some((type_params, _)):
					Some(type_params)
				None:
					match env_get_alias(env, name):
						Some((type_params, _)):
							Some(type_params)
						None:
							match env_get_opaque_alias(env, name):
								Some((type_params, _, _)):
									Some(type_params)
								None:
									None

	match params:
		Some(type_params):
			if type_params.length() > 0 and type_params.all(compiler_is_dim_var_name):
				Some(type_params)
			else:
				None
		None:
			None


pure func env_disambiguate_nominal_dim_application(env: Env, typ: CompilerType) -> CompilerType:
	match typ:
		CompilerArrayType(CompilerNamedType(name, args), dims):
			resolved_dims: List[CompilerType] = dims.map(
				func(dim): env_disambiguate_nominal_dim_application(env, dim),
			)

			if args.length() == 0:
				match nominal_dim_params(env, name):
					Some(params):
						if params.length() == resolved_dims.length():
							CompilerNamedType(name, resolved_dims)
						else:
							CompilerArrayType(
								CompilerNamedType(name, []),
								resolved_dims,
							)
					None:
						CompilerArrayType(
							CompilerNamedType(name, []),
							resolved_dims,
						)
			else:
				CompilerArrayType(
					CompilerNamedType(
						name,
						args.map(func(arg): env_disambiguate_nominal_dim_application(env, arg)),
					),
					resolved_dims,
				)
		CompilerArrayType(element, dims):
			CompilerArrayType(
				env_disambiguate_nominal_dim_application(env, element),
				dims.map(func(dim): env_disambiguate_nominal_dim_application(env, dim)),
			)
		CompilerNamedType(name, args):
			CompilerNamedType(
				name,
				args.map(func(arg): env_disambiguate_nominal_dim_application(env, arg)),
			)
		CompilerFunctionType(is_pure, params, return_type):
			CompilerFunctionType(
				is_pure,
				params.map(func(param): env_disambiguate_nominal_dim_application(env, param)),
				env_disambiguate_nominal_dim_application(env, return_type),
			)
		CompilerTupleType(elements):
			CompilerTupleType(elements.map(
				func(element): env_disambiguate_nominal_dim_application(env, element),
			))
		CompilerRangeType(inner):
			CompilerRangeType(env_disambiguate_nominal_dim_application(env, inner))
		CompilerDimOpType(op, left, right):
			CompilerDimOpType(
				op,
				env_disambiguate_nominal_dim_application(env, left),
				env_disambiguate_nominal_dim_application(env, right),
			)
		_:
			typ


private pure func subst_for_params(
	type_params: List[String],
	args: List[CompilerType],
) -> List[CompilerTypeSubstEntry]:
	var subst: List[CompilerTypeSubstEntry] = []
	var index: Int = 0

	while index < type_params.length() and index < args.length():
		match (type_params.get(index), args.get(index)):
			(Some(type_param), Some(arg)):
				subst = subst.append(compiler_type_subst_entry(type_param, arg))
			_:
				void

		index += 1

	subst


private pure func env_resolve_aliases_seen(
	env: Env,
	seen: List[String],
	types: List[CompilerType],
) -> List[CompilerType]:
	var resolved: List[CompilerType] = []

	for typ in types:
		resolved = resolved.append(env_resolve_alias_seen(env, seen, typ))

	resolved


private pure func env_resolve_alias_seen(
	env: Env,
	seen: List[String],
	typ: CompilerType,
) -> CompilerType:
	match typ:
		CompilerNamedType(name, args):
			if seen.contains(name):
				typ
			else:
				resolved_args = env_resolve_aliases_seen(env, seen, args)

				match env_get_alias(env, name):
					Some((type_params, target)):
						if type_params.length() == resolved_args.length():
							subst: List[CompilerTypeSubstEntry] = subst_for_params(
								type_params,
								resolved_args,
							)
							substituted: CompilerType = compiler_apply_subst(subst, target)
							env_resolve_alias_seen(
								env,
								seen.append(name),
								substituted,
							)
						else:
							CompilerNamedType(name, resolved_args)
					None:
						CompilerNamedType(name, resolved_args)
		CompilerArrayType(element, dims):
			CompilerArrayType(
				env_resolve_alias_seen(env, seen, element),
				env_resolve_aliases_seen(env, seen, dims),
			)
		CompilerFunctionType(is_pure, params, return_type):
			CompilerFunctionType(
				is_pure,
				env_resolve_aliases_seen(env, seen, params),
				env_resolve_alias_seen(env, seen, return_type),
			)
		CompilerTupleType(elements):
			CompilerTupleType(env_resolve_aliases_seen(env, seen, elements))
		CompilerRangeType(inner):
			CompilerRangeType(env_resolve_alias_seen(env, seen, inner))
		CompilerDimOpType(op, left, right):
			CompilerDimOpType(
				op,
				env_resolve_alias_seen(env, seen, left),
				env_resolve_alias_seen(env, seen, right),
			)
		_:
			typ


pure func env_resolve_alias(env: Env, typ: CompilerType) -> CompilerType:
	env_resolve_alias_seen(env, [], typ)


-- Shape traversals already visit every child. Expanding only the alias at the
-- current node avoids rebuilding the same nested type at every recursive step.
private pure func env_resolve_alias_head_seen(
	env: Env,
	seen: List[String],
	typ: CompilerType,
) -> CompilerType:
	match typ:
		CompilerNamedType(name, args):
			if seen.contains(name):
				typ
			else:
				match env_get_alias(env, name):
					Some((type_params, target)):
						if type_params.length() == args.length():
							subst = subst_for_params(type_params, args)
							env_resolve_alias_head_seen(
								env,
								seen.append(name),
								compiler_apply_subst(subst, target),
							)
						else:
							typ
					None:
						typ
		_:
			typ


pure func env_resolve_alias_head(env: Env, typ: CompilerType) -> CompilerType:
	env_resolve_alias_head_seen(env, [], typ)


pure func env_set_type_param_bounds(env: Env, params: List[BoundTypeParam]) -> Env:
	{ env |
		type_params_in_scope = params.map(bound_type_param_name),
		type_param_bounds = params
	}


pure func env_extend_type_param_bounds(env: Env, params: List[BoundTypeParam]) -> Env:
	if params.length() == 0:
		env
	else:
		env_set_type_param_bounds(
			env,
			env.type_param_bounds.concat(params),
		)


pure func env_get_type_params(env: Env) -> List[String]:
	env.type_params_in_scope


pure func env_get_type_param_bounds(env: Env, param_name: String) -> List[String]:
	var result: List[String] = []

	for param in env.type_param_bounds:
		if param.name == param_name:
			result = param.bounds
			break

	result


pure func env_has_trait_bound(env: Env, param_name: String, trait_name: String) -> Bool:
	env_get_type_param_bounds(env, param_name).contains(trait_name)


pure func trait_method_sig(
	name: String,
	params: List[CompilerType],
	return_type: CompilerType,
	is_pure: Bool,
) -> TraitMethodSig:
	trait_method_sig_with_details(name, params, return_type, is_pure, False, [])


pure func trait_method_sig_with_details(
	name: String,
	params: List[CompilerType],
	return_type: CompilerType,
	is_pure: Bool,
	has_default: Bool,
	param_names: List[Option[String]],
) -> TraitMethodSig:
	{
		name = name,
		params = params,
		return_type = return_type,
		is_pure = is_pure,
		has_default = has_default,
		param_names = param_names
	}


pure func trait_def(
	def_id: Int,
	name: String,
	supertraits: List[String],
	methods: List[TraitMethodSig],
) -> TraitDef:
	trait_def_with_details(def_id, name, [], supertraits, methods, None)


pure func trait_def_with_details(
	def_id: Int,
	name: String,
	type_params: List[String],
	supertraits: List[String],
	methods: List[TraitMethodSig],
	module_path: Option[String],
) -> TraitDef:
	{
		def_id = def_id,
		name = name,
		type_params = type_params,
		supertraits = supertraits,
		methods = methods,
		module_path = module_path
	}


pure func env_add_trait(env: Env, trait_def: TraitDef) -> Env:
	var traits: List[TraitDef] = []
	var replaced: Bool = False

	for existing in env.traits:
		if existing.name == trait_def.name:
			traits = traits.append(trait_def)
			replaced = True
		else:
			traits = traits.append(existing)

	if not replaced:
		traits = traits.append(trait_def)

	{ env | traits = traits }


pure func env_get_trait(env: Env, name: String) -> Option[TraitDef]:
	var result: Option[TraitDef] = None

	for trait_def in env.traits:
		if trait_def.name == name:
			result = Some(trait_def)
			break

	result


private pure func trait_has_supertrait_seen(
	env: Env,
	seen: List[String],
	trait_name: String,
	target: String,
) -> Bool:
	if trait_name == target:
		True
	else if seen.contains(trait_name):
		False
	else:
		match env_get_trait(env, trait_name):
			Some(trait_def):
				var found: Bool = False

				for supertrait in trait_def.supertraits:
					if trait_has_supertrait_seen(
						env,
						seen.append(trait_name),
						supertrait,
						target,
					):
						found = True
						break

				found
			None:
				False


pure func env_trait_has_supertrait(env: Env, trait_name: String, target: String) -> Bool:
	if trait_name == target:
		False
	else:
		trait_has_supertrait_seen(env, [], trait_name, target)


private pure func append_unique_string(values: List[String], value: String) -> List[String]:
	if values.contains(value):
		values
	else:
		values.append(value)


private pure func trait_method_names_seen(
	env: Env,
	seen: List[String],
	trait_name: String,
) -> List[String]:
	if seen.contains(trait_name):
		[]
	else:
		match env_get_trait(env, trait_name):
			Some(trait_def):
				var names: List[String] = []

				for method in trait_def.methods:
					names = append_unique_string(names, method.name)

				for supertrait in trait_def.supertraits:
					for name in trait_method_names_seen(
						env,
						seen.append(trait_name),
						supertrait,
					):
						names = append_unique_string(names, name)

				names
			None:
				[]


pure func env_trait_method_names_transitive(env: Env, trait_name: String) -> List[String]:
	trait_method_names_seen(env, [], trait_name)


private pure func trait_methods_with_declaring_trait_seen(
	env: Env,
	seen: List[String],
	trait_name: String,
) -> List[(String, String)]:
	if seen.contains(trait_name):
		[]
	else:
		match env_get_trait(env, trait_name):
			Some(trait_def):
				var pairs: List[(String, String)] = []

				for method in trait_def.methods:
					pairs = pairs.append((method.name, trait_name))

				for supertrait in trait_def.supertraits:
					for pair in trait_methods_with_declaring_trait_seen(
						env,
						seen.append(trait_name),
						supertrait,
					):
						pairs = pairs.append(pair)

				pairs
			None:
				[]


pure func env_trait_methods_with_declaring_trait(
	env: Env,
	trait_name: String,
) -> List[(String, String)]:
	trait_methods_with_declaring_trait_seen(env, [], trait_name)


private pure func env_find_trait_method_seen(
	env: Env,
	seen: List[String],
	trait_name: String,
	method_name: String,
) -> Option[(TraitMethodSig, String)]:
	if seen.contains(trait_name):
		None
	else:
		match env_get_trait(env, trait_name):
			Some(trait_def):
				var result: Option[(TraitMethodSig, String)] = None

				for method in trait_def.methods:
					if method.name == method_name:
						result = Some((method, trait_name))
						break

				if result.is_none():
					for supertrait in trait_def.supertraits:
						match env_find_trait_method_seen(
							env,
							seen.append(trait_name),
							supertrait,
							method_name,
						):
							Some(found):
								result = Some(found)
								break
							None:
								void

				result
			None:
				None


pure func env_find_trait_method(
	env: Env,
	trait_name: String,
	method_name: String,
) -> Option[(TraitMethodSig, String)]:
	env_find_trait_method_seen(env, [], trait_name, method_name)


pure func env_find_trait_method_for_param(
	env: Env,
	param_name: String,
	method_name: String,
) -> Option[(TraitMethodSig, String)]:
	var result: Option[(TraitMethodSig, String)] = None

	for bound in env_get_type_param_bounds(env, param_name):
		match env_find_trait_method(env, bound, method_name):
			Some(found):
				result = Some(found)
				break
			None:
				void

	result


pure func env_has_trait_bound_transitive(env: Env, param_name: String, trait_name: String) -> Bool:
	var result: Bool = False

	for bound in env_get_type_param_bounds(env, param_name):
		if bound == trait_name or env_trait_has_supertrait(env, bound, trait_name):
			result = True
			break

	result


pure func env_trait_function_collision(
	env: Env,
	func_name: String,
	trait_name: String,
) -> Option[String]:
	var result: Option[String] = None

	for pair in env.trait_functions:
		if pair[0] == func_name and pair[1] != trait_name:
			result = Some(pair[1])
			break

	result


pure func env_add_trait_function(env: Env, func_name: String, trait_name: String) -> Env:
	var exists: Bool = False

	for pair in env.trait_functions:
		if pair[0] == func_name and pair[1] == trait_name:
			exists = True
			break

	if exists:
		env
	else:
		{ env | trait_functions = env.trait_functions.append((func_name, trait_name)) }


pure func env_get_function_trait(env: Env, func_name: String) -> Option[String]:
	var result: Option[String] = None

	for pair in env.trait_functions:
		if pair[0] == func_name:
			result = Some(pair[1])
			break

	result


pure func trait_obligation(obligation_type: CompilerType, trait_name: String) -> TraitObligation:
	{
		obligation_type = obligation_type,
		trait_name = trait_name
	}


pure func trait_obligations_for_bound_type_param(
	param: BoundTypeParam,
	concrete_type: CompilerType,
) -> List[TraitObligation]:
	param.bounds.map(func(bound): {
			obligation_type = concrete_type,
			trait_name = bound
		})


pure func impl_instance(
	def_id: Int,
	trait_name: String,
	for_type: CompilerType,
	bounds: List[BoundTypeParam],
	is_builtin: Bool,
) -> ImplInstance:
	impl_instance_with_methods(def_id, trait_name, for_type, bounds, [], is_builtin)


pure func impl_method_info(
	name: String,
	target: Option[ImplMethodTarget],
	func_type: CompilerType,
	type_params: List[BoundTypeParam],
	param_names: List[Option[String]],
	purity: Purity,
	resource_args: ResourceArgPolicy,
	dim_constraints: List[(CompilerType, CompilerType)],
	debug_only: Bool,
) -> ImplMethodInfo:
	{
		name = name,
		target = target,
		func_type = func_type,
		type_params = type_params,
		param_names = param_names,
		purity = purity,
		resource_args = resource_args,
		dim_constraints = dim_constraints,
		debug_only = debug_only
	}


pure func impl_instance_with_methods(
	def_id: Int,
	trait_name: String,
	for_type: CompilerType,
	bounds: List[BoundTypeParam],
	methods: List[ImplMethodInfo],
	is_builtin: Bool,
) -> ImplInstance:
	{
		def_id = def_id,
		trait_name = trait_name,
		for_type = for_type,
		bounds = bounds,
		methods = methods,
		is_builtin = is_builtin
	}


pure func env_add_impl(env: Env, impl: ImplInstance) -> Env:
	{ env | impls = env.impls.append(impl) }


pure func env_find_impl_method_info(
	env: Env,
	trait_name: String,
	method_name: String,
	receiver_type: CompilerType,
) -> Option[ImplMethodInfo]:
	var result: Option[ImplMethodInfo] = None

	for impl in env.impls:
		if (
			impl_satisfies_trait(env, impl, trait_name)
			and impl_matches_type(env, impl, receiver_type)
		):
			for method in impl.methods:
				if method.name == method_name:
					result = Some(method)
					break

		if result.is_some():
			break

	result


private pure func impl_matches_type(env: Env, impl: ImplInstance, typ: CompilerType) -> Bool:
	type_params: List[String] = impl.bounds.map(bound_type_param_name)

	matches: Bool = (
		compiler_types_equal(impl.for_type, typ)
		or (
			type_params.length() > 0
			and compiler_types_compatible_with_params(type_params, impl.for_type, typ)
		)
	)

	matches and impl_bounds_satisfied(env, impl, typ)


private pure func impls_may_overlap(left: ImplInstance, right: ImplInstance) -> Bool:
	left_params: List[String] = left.bounds.map(bound_type_param_name)
	right_params: List[String] = right.bounds.map(bound_type_param_name)
	type_params: List[String] = left_params.concat(right_params)

	(
		compiler_types_equal(left.for_type, right.for_type)
		or (
			type_params.length() > 0
			and ((
				compiler_types_compatible_with_params(type_params, left.for_type, right.for_type)
				or compiler_types_compatible_with_params(type_params, right.for_type, left.for_type)
			))
		)
	)


private pure func impl_pattern_param_name(
	type_params: List[String],
	pattern: CompilerType,
) -> Option[String]:
	match pattern:
		CompilerTypeVar(name):
			if type_params.contains(name):
				Some(name)
			else:
				None
		CompilerNamedType(name, args):
			if args.length() == 0 and type_params.contains(name):
				Some(name)
			else:
				None
		CompilerVarDimsType(name):
			if type_params.contains(name):
				Some(name)
			else:
				None
		_:
			None


private pure func impl_subst_lookup(
	subst: List[CompilerTypeSubstEntry],
	name: String,
) -> Option[CompilerType]:
	var result: Option[CompilerType] = None

	for entry in subst:
		if entry.var_name == name:
			result = Some(entry.concrete_type)
			break

	result


private pure func impl_add_subst(
	subst: List[CompilerTypeSubstEntry],
	name: String,
	concrete_type: CompilerType,
) -> Option[List[CompilerTypeSubstEntry]]:
	match impl_subst_lookup(subst, name):
		Some(existing_type):
			if compiler_types_equal(existing_type, concrete_type):
				Some(subst)
			else:
				None
		None:
			Some(subst.append(compiler_type_subst_entry(name, concrete_type)))


private pure func impl_match_type_lists_with_subst(
	type_params: List[String],
	patterns: List[CompilerType],
	actuals: List[CompilerType],
	subst: List[CompilerTypeSubstEntry],
) -> Option[List[CompilerTypeSubstEntry]]:
	if patterns.length() != actuals.length():
		None
	else:
		var current: Option[List[CompilerTypeSubstEntry]] = Some(subst)
		var index: Int = 0

		while index < patterns.length() and current.is_some():
			match (current, patterns.get(index), actuals.get(index)):
				(Some(current_subst), Some(pattern), Some(actual)):
					current = impl_match_type_with_subst(
						type_params,
						pattern,
						actual,
						current_subst,
					)
				_:
					current = None

			index += 1

		current


private pure func impl_type_contains_param(type_params: List[String], typ: CompilerType) -> Bool:
	if impl_pattern_param_name(type_params, typ).is_some():
		True
	else:
		match typ:
			CompilerNamedType(_, args):
				args.any(func(arg): impl_type_contains_param(type_params, arg))
			CompilerArrayType(element, dims):
				(
					impl_type_contains_param(type_params, element)
					or dims.any(func(dim): impl_type_contains_param(type_params, dim))
				)
			CompilerFunctionType(_, params, return_type):
				(
					params.any(func(param): impl_type_contains_param(type_params, param))
					or impl_type_contains_param(type_params, return_type)
				)
			CompilerTupleType(elements):
				elements.any(func(element): impl_type_contains_param(type_params, element))
			CompilerRangeType(inner):
				impl_type_contains_param(type_params, inner)
			CompilerDimOpType(_, left, right):
				(
					impl_type_contains_param(type_params, left)
					or impl_type_contains_param(type_params, right)
				)
			_:
				False


private pure func dim_ops_equal(left: CompilerDimOp, right: CompilerDimOp) -> Bool:
	match left:
		CompilerDimAdd:
			match right:
				CompilerDimAdd:
					True
				_:
					False
		CompilerDimSubtract:
			match right:
				CompilerDimSubtract:
					True
				_:
					False
		CompilerDimMultiply:
			match right:
				CompilerDimMultiply:
					True
				_:
					False
		CompilerDimDivide:
			match right:
				CompilerDimDivide:
					True
				_:
					False


private pure func impl_match_type_with_subst(
	type_params: List[String],
	pattern: CompilerType,
	actual: CompilerType,
	subst: List[CompilerTypeSubstEntry],
) -> Option[List[CompilerTypeSubstEntry]]:
	match impl_pattern_param_name(type_params, pattern):
		Some(param_name):
			impl_add_subst(subst, param_name, actual)
		None:
			if (
				compiler_types_equal(pattern, actual)
				and not impl_type_contains_param(type_params, pattern)
			):
				Some(subst)
			else:
				match pattern:
					CompilerNamedType(pattern_name, pattern_args):
						match actual:
							CompilerNamedType(actual_name, actual_args):
								if compiler_normalize_type_name(
									pattern_name,
								) == compiler_normalize_type_name(actual_name):
									impl_match_type_lists_with_subst(
										type_params,
										pattern_args,
										actual_args,
										subst,
									)
								else:
									None
							CompilerConstIntType(_):
								if (
									pattern_args.length() == 0
									and compiler_normalize_type_name(pattern_name) == "Int"
								):
									Some(subst)
								else:
									None
							_:
								None
					CompilerArrayType(pattern_element, pattern_dims):
						match actual:
							CompilerArrayType(actual_element, actual_dims):
								match impl_match_type_with_subst(
									type_params,
									pattern_element,
									actual_element,
									subst,
								):
									Some(element_subst):
										impl_match_type_lists_with_subst(
											type_params,
											pattern_dims,
											actual_dims,
											element_subst,
										)
									None:
										None
							_:
								None
					CompilerFunctionType(pattern_pure, pattern_params, pattern_return):
						match actual:
							CompilerFunctionType(actual_pure, actual_params, actual_return):
								if pattern_pure and not actual_pure:
									None
								else:
									match impl_match_type_lists_with_subst(
										type_params,
										pattern_params,
										actual_params,
										subst,
									):
										Some(param_subst):
											impl_match_type_with_subst(
												type_params,
												pattern_return,
												actual_return,
												param_subst,
											)
										None:
											None
							_:
								None
					CompilerTupleType(pattern_elements):
						match actual:
							CompilerTupleType(actual_elements):
								impl_match_type_lists_with_subst(
									type_params,
									pattern_elements,
									actual_elements,
									subst,
								)
							CompilerNamedType(actual_name, actual_elements):
								if compiler_normalize_type_name(actual_name) == "Tuple":
									impl_match_type_lists_with_subst(
										type_params,
										pattern_elements,
										actual_elements,
										subst,
									)
								else:
									None
							_:
								None
					CompilerRangeType(pattern_inner):
						match actual:
							CompilerRangeType(actual_inner):
								impl_match_type_with_subst(
									type_params,
									pattern_inner,
									actual_inner,
									subst,
								)
							_:
								None
					CompilerDimOpType(pattern_op, pattern_left, pattern_right):
						match actual:
							CompilerDimOpType(actual_op, actual_left, actual_right):
								if dim_ops_equal(pattern_op, actual_op):
									match impl_match_type_with_subst(
										type_params,
										pattern_left,
										actual_left,
										subst,
									):
										Some(left_subst):
											impl_match_type_with_subst(
												type_params,
												pattern_right,
												actual_right,
												left_subst,
											)
										None:
											None
								else:
									None
							_:
								None
					_:
						None


private pure func impl_bound_satisfied(
	env: Env,
	subst: List[CompilerTypeSubstEntry],
	bound: BoundTypeParam,
) -> Bool:
	match impl_subst_lookup(subst, bound.name):
		Some(concrete_type):
			var satisfied: Bool = True

			for trait_ref in bound.bounds:
				if env_resolve_trait_obligation(
					env,
					trait_obligation(concrete_type, trait_ref),
				) != TraitObligationSatisfied:
					satisfied = False
					break

			satisfied
		None:
			True


private pure func impl_bounds_satisfied(env: Env, impl: ImplInstance, typ: CompilerType) -> Bool:
	if impl.bounds.length() == 0:
		True
	else:
		type_params: List[String] = impl.bounds.map(bound_type_param_name)

		match impl_match_type_with_subst(type_params, impl.for_type, typ, []):
			Some(subst):
				var satisfied: Bool = True

				for bound in impl.bounds:
					if not impl_bound_satisfied(env, subst, bound):
						satisfied = False
						break

				satisfied
			None:
				False


pure func env_find_conflicting_impl(env: Env, candidate: ImplInstance) -> Option[ImplInstance]:
	var result: Option[ImplInstance] = None

	for existing in env.impls:
		if (
			not existing.is_builtin
			and not candidate.is_builtin
			and existing.trait_name == candidate.trait_name
			and impls_may_overlap(existing, candidate)
		):
			result = Some(existing)
			break

	result


private pure func impl_satisfies_trait(env: Env, impl: ImplInstance, trait_name: String) -> Bool:
	impl.trait_name == trait_name or env_trait_has_supertrait(env, impl.trait_name, trait_name)


private pure func env_has_exact_impl_for_trait(
	env: Env,
	typ: CompilerType,
	trait_name: String,
) -> Bool:
	var result: Bool = False

	for impl in env.impls:
		if impl.trait_name == trait_name and impl_matches_type(env, impl, typ):
			result = True
			break

	result


pure func env_has_direct_trait_evidence(env: Env, obligation: TraitObligation) -> Bool:
	-- Used while validating impl supertraits. The candidate subtrait impl may
	-- already be indexed, so subtrait impls cannot prove their own supertraits.
	match obligation.obligation_type:
		CompilerMetaType(_):
			False
		CompilerTypeVar(name):
			env_has_trait_bound_transitive(env, name, obligation.trait_name)
		CompilerNamedType(name, args):
			if (
				args.length() == 0
				and env_has_trait_bound_transitive(env, name, obligation.trait_name)
			):
				True
			else:
				env_has_exact_impl_for_trait(env, obligation.obligation_type, obligation.trait_name)
		CompilerArrayType(_, _):
			(
				obligation.trait_name == "HasLength"
				or obligation.trait_name == "Stringable"
				or env_has_exact_impl_for_trait(
					env,
					obligation.obligation_type,
					obligation.trait_name,
				)
			)
		_:
			env_has_exact_impl_for_trait(env, obligation.obligation_type, obligation.trait_name)


pure func env_resolve_trait_obligation(
	env: Env,
	obligation: TraitObligation,
) -> TraitObligationResolution:
	match obligation.obligation_type:
		CompilerMetaType(_):
			TraitObligationDeferred
		CompilerTypeVar(name):
			if env_has_trait_bound_transitive(env, name, obligation.trait_name):
				TraitObligationSatisfied
			else:
				TraitObligationUnsatisfied
		CompilerNamedType(name, args):
			if (
				args.length() == 0
				and env_has_trait_bound_transitive(env, name, obligation.trait_name)
			):
				TraitObligationSatisfied
			else:
				var result: TraitObligationResolution = TraitObligationUnsatisfied

				for impl in env.impls:
					if (
						impl_satisfies_trait(env, impl, obligation.trait_name)
						and impl_matches_type(env, impl, obligation.obligation_type)
					):
						result = TraitObligationSatisfied
						break

				result
		CompilerArrayType(_, _):
			if obligation.trait_name == "HasLength" or obligation.trait_name == "Stringable":
				TraitObligationSatisfied
			else:
				var result: TraitObligationResolution = TraitObligationUnsatisfied

				for impl in env.impls:
					if (
						impl_satisfies_trait(env, impl, obligation.trait_name)
						and impl_matches_type(env, impl, obligation.obligation_type)
					):
						result = TraitObligationSatisfied
						break

				result
		_:
			var result: TraitObligationResolution = TraitObligationUnsatisfied

			for impl in env.impls:
				if (
					impl_satisfies_trait(env, impl, obligation.trait_name)
					and impl_matches_type(env, impl, obligation.obligation_type)
				):
					result = TraitObligationSatisfied
					break

			result


pure func env_find_unsatisfied_trait_obligation(
	env: Env,
	obligations: List[TraitObligation],
) -> Option[TraitObligation]:
	var result: Option[TraitObligation] = None

	for obligation in obligations:
		match env_resolve_trait_obligation(env, obligation):
			TraitObligationUnsatisfied:
				result = Some(obligation)
				break
			_:
				void

	result


pure func resolve_self(concrete_type: CompilerType, typ: CompilerType) -> CompilerType:
	match typ:
		CompilerSelfType:
			concrete_type
		CompilerNamedType(name, args):
			CompilerNamedType(
				name,
				args.map(func(arg): resolve_self(concrete_type, arg)),
			)
		CompilerArrayType(element, dims):
			CompilerArrayType(
				resolve_self(concrete_type, element),
				dims.map(func(dim): resolve_self(concrete_type, dim)),
			)
		CompilerFunctionType(is_pure, params, return_type):
			CompilerFunctionType(
				is_pure,
				params.map(func(param): resolve_self(concrete_type, param)),
				resolve_self(concrete_type, return_type),
			)
		CompilerTupleType(elements):
			CompilerTupleType(elements.map(
				func(element): resolve_self(concrete_type, element),
			))
		CompilerRangeType(inner):
			CompilerRangeType(resolve_self(concrete_type, inner))
		CompilerDimOpType(op, left, right):
			CompilerDimOpType(
				op,
				resolve_self(concrete_type, left),
				resolve_self(concrete_type, right),
			)
		_:
			typ


pure func env_resolve_trait_method_sig(
	method: TraitMethodSig,
	concrete_type: CompilerType,
) -> TraitMethodSig:
	trait_method_sig_with_details(
		method.name,
		method.params.map(func(param): resolve_self(concrete_type, param)),
		resolve_self(concrete_type, method.return_type),
		method.is_pure,
		method.has_default,
		method.param_names,
	)


pure func overload_type_param_names(entry: OverloadEntry) -> List[String]:
	entry.type_params.map(bound_type_param_name)


private pure func replace_overload_set(
	sets: List[OverloadSet],
	name: String,
	entries: List[OverloadEntry],
) -> List[OverloadSet]:
	var result: List[OverloadSet] = []
	var replaced: Bool = False

	for set in sets:
		if set.name == name:
			result = result.append({
				name = name,
				entries = entries,
			})
			replaced = True
		else:
			result = result.append(set)

	if replaced:
		result
	else:
		result.append({
			name = name,
			entries = entries,
		})


private pure func find_overload_set(sets: List[OverloadSet], name: String) -> Option[OverloadSet]:
	var result: Option[OverloadSet] = None

	for set in sets:
		if set.name == name:
			result = Some(set)
			break

	result


pure func env_add_overload(env: Env, name: String, entry: OverloadEntry) -> Env:
	entries: List[OverloadEntry] = match find_overload_set(env.overloads, name):
		Some(set):
			set.entries.append(entry)
		None:
			[entry]

	{ env | overloads = replace_overload_set(env.overloads, name, entries) }


pure func env_get_overloads(env: Env, name: String) -> List[OverloadEntry]:
	match find_overload_set(env.overloads, name):
		Some(set):
			set.entries
		None:
			[]


private pure func find_entry_by_def_id(
	sets: List[OverloadSet],
	def_id: Int,
) -> Option[OverloadEntry]:
	var result: Option[OverloadEntry] = None

	for set in sets:
		for entry in set.entries:
			if entry.def_id == def_id:
				result = Some(entry)
				break

		if result.is_some():
			break

	result


pure func env_find_overload_by_def_id(env: Env, def_id: Int) -> Option[OverloadEntry]:
	find_entry_by_def_id(env.overloads, def_id)


pure func env_find_ufcs_method_by_def_id(env: Env, def_id: Int) -> Option[OverloadEntry]:
	match find_entry_by_def_id(env.ufcs_methods, def_id):
		Some(entry):
			Some(entry)
		None:
			match env_find_func_by_def_id(env, def_id):
				Some(func_symbol):
					if func_symbol_supports_ufcs(func_symbol):
						Some(overload_entry_from_func_symbol(func_symbol))
					else:
						None
				None:
					None


private pure func scope_find_func_by_def_id(scope: Scope, def_id: Int) -> Option[FuncSymbol]:
	match scope.function_indexes_by_callable_id.get(def_id):
		Some(index):
			match scope.symbols.get(index):
				Some(symbol):
					match symbol.kind:
						FuncSymbolKind(func_symbol):
							if func_symbol.callable_id == def_id:
								Some(func_symbol)
							else:
								None
						_:
							None
				None:
					None
		None:
			None


pure func env_find_func_by_def_id(env: Env, def_id: Int) -> Option[FuncSymbol]:
	var result: Option[FuncSymbol] = None

	for scope in env.scopes:
		match scope_find_func_by_def_id(scope, def_id):
			Some(func_symbol):
				result = Some(func_symbol)
				break
			None:
				void

	result


pure func env_find_impl_method_by_def_id(env: Env, def_id: Int) -> Option[ImplMethodInfo]:
	var result: Option[ImplMethodInfo] = None

	for impl in env.impls:
		for method in impl.methods:
			match method.target:
				Some(target):
					if target.callable_id == def_id:
						result = Some(method)
						break
				None:
					void

		if result.is_some():
			break

	result


private pure func find_overload_type_params_by_def_id(
	sets: List[OverloadSet],
	def_id: Int,
) -> Option[List[BoundTypeParam]]:
	var result: Option[List[BoundTypeParam]] = None

	for set in sets:
		for entry in set.entries:
			if entry.def_id == def_id:
				result = Some(entry.type_params)
				break

		if result.is_some():
			break

	result


pure func env_find_callable_type_params_by_def_id(
	env: Env,
	def_id: Int,
) -> Option[List[BoundTypeParam]]:
	match find_overload_type_params_by_def_id(env.overloads, def_id):
		Some(params):
			Some(params)
		None:
			match find_overload_type_params_by_def_id(env.ufcs_methods, def_id):
				Some(params):
					Some(params)
				None:
					match env_find_func_by_def_id(env, def_id):
						Some(func_symbol):
							Some(func_symbol.type_params)
						None:
							match env_find_impl_method_by_def_id(env, def_id):
								Some(method):
									Some(method.type_params)
								None:
									None


private pure func find_overload_debug_only_by_def_id(
	sets: List[OverloadSet],
	def_id: Int,
) -> Option[Bool]:
	var result: Option[Bool] = None

	for set in sets:
		for entry in set.entries:
			if entry.def_id == def_id:
				result = Some(entry.debug_only)
				break

		if result.is_some():
			break

	result


private pure func find_overload_loop_producer_by_def_id(
	sets: List[OverloadSet],
	def_id: Int,
) -> Option[LoopProducer]:
	var result: Option[LoopProducer] = None

	for set in sets:
		for entry in set.entries:
			if entry.def_id == def_id:
				result = entry.loop_producer
				break

		if result.is_some():
			break

	result


pure func env_find_callable_loop_producer_by_def_id(env: Env, def_id: Int) -> Option[LoopProducer]:
	match env_find_func_by_def_id(env, def_id):
		Some(func_symbol):
			func_symbol.loop_producer
		None:
			match find_overload_loop_producer_by_def_id(env.overloads, def_id):
				Some(producer):
					Some(producer)
				None:
					find_overload_loop_producer_by_def_id(env.ufcs_methods, def_id)


pure func env_find_callable_debug_only_by_def_id(env: Env, def_id: Int) -> Option[Bool]:
	match env_find_func_by_def_id(env, def_id):
		Some(func_symbol):
			Some(func_symbol.debug_only)
		None:
			match find_overload_debug_only_by_def_id(env.overloads, def_id):
				Some(debug_only):
					Some(debug_only)
				None:
					match find_overload_debug_only_by_def_id(env.ufcs_methods, def_id):
						Some(debug_only):
							Some(debug_only)
						None:
							env_find_impl_method_by_def_id(
								env,
								def_id,
							).map(
								func(method): method.debug_only,
							)


private pure func function_first_param_type(func_type: CompilerType) -> Option[CompilerType]:
	match func_type:
		CompilerFunctionType(_, params, _):
			params.get(0)
		_:
			None


private pure func function_param_types(func_type: CompilerType) -> Option[List[CompilerType]]:
	match func_type:
		CompilerFunctionType(_, params, _):
			Some(params)
		_:
			None


private pure func overload_first_param_matches(
	entry: OverloadEntry,
	first_arg_type: CompilerType,
) -> Bool:
	match function_first_param_type(entry.func_type):
		Some(param_type):
			type_params = overload_type_param_names(entry)

			(
				ufcs_receiver_families_match(type_params, param_type, first_arg_type)
				and compiler_types_compatible_with_params(type_params, param_type, first_arg_type)
			)
		None:
			False


private pure func ufcs_receiver_family(
	type_params: List[String],
	typ: CompilerType,
) -> Option[String]:
	match typ:
		CompilerNamedType(name, args):
			if args.length() == 0 and type_params.contains(name):
				None
			else:
				Some(compiler_normalize_type_name(name))
		CompilerArrayType(_, _):
			Some(TYPE_NAME_TENSOR)
		_:
			None


private pure func ufcs_receiver_families_match(
	type_params: List[String],
	param_type: CompilerType,
	receiver_type: CompilerType,
) -> Bool:
	match (ufcs_receiver_family(type_params, param_type), ufcs_receiver_family([], receiver_type)):
		(Some(param_family), Some(receiver_family)):
			param_family == receiver_family
		_:
			True


private pure func overload_type_patterns_match(
	type_params: List[String],
	param_type: CompilerType,
	arg_type: CompilerType,
) -> Bool:
	match (param_type, arg_type):
		(CompilerFunctionType(param_pure, param_params, param_return), CompilerFunctionType(arg_pure, arg_params, arg_return)):
			(
				(not param_pure or arg_pure)
				and overload_callback_param_patterns_match(type_params, param_params, arg_params)
				and overload_type_patterns_match(type_params, param_return, arg_return)
			)
		_:
			compiler_types_compatible_with_params(type_params, param_type, arg_type)


private pure func overload_pattern_contains_type_param(
	type_params: List[String],
	typ: CompilerType,
) -> Bool:
	match typ:
		CompilerTypeVar(name):
			type_params.contains(name)
		CompilerNamedType(name, args):
			(
				args.length() == 0 and type_params.contains(name)
				or args.any(func(arg): overload_pattern_contains_type_param(type_params, arg))
			)
		CompilerArrayType(element, dims):
			(
				overload_pattern_contains_type_param(type_params, element)
				or dims.any(func(dim): overload_pattern_contains_type_param(type_params, dim))
			)
		CompilerFunctionType(_, params, return_type):
			(
				params.any(func(param): overload_pattern_contains_type_param(type_params, param))
				or overload_pattern_contains_type_param(type_params, return_type)
			)
		CompilerTupleType(elements):
			elements.any(func(element): overload_pattern_contains_type_param(type_params, element))
		CompilerRangeType(inner):
			overload_pattern_contains_type_param(type_params, inner)
		CompilerDimOpType(_, left, right):
			(
				overload_pattern_contains_type_param(type_params, left)
				or overload_pattern_contains_type_param(type_params, right)
			)
		CompilerVarDimsType(_):
			True
		_:
			False


private pure func overload_callback_param_patterns_match(
	type_params: List[String],
	param_types: List[CompilerType],
	arg_types: List[CompilerType],
) -> Bool:
	if param_types.length() != arg_types.length():
		False
	else:
		var index: Int = 0
		var matches: Bool = True

		while index < param_types.length() and matches:
			match (param_types.get(index), arg_types.get(index)):
				(Some(param_type), Some(arg_type)):
					matches = if overload_pattern_contains_type_param(type_params, param_type):
						overload_type_patterns_match(type_params, param_type, arg_type)
					else:
						compiler_types_compatible_with_params([], arg_type, param_type)
				_:
					matches = False

			index += 1

		matches


private pure func overload_type_pattern_lists_match(
	type_params: List[String],
	param_types: List[CompilerType],
	arg_types: List[CompilerType],
) -> Bool:
	if param_types.length() != arg_types.length():
		False
	else:
		var index: Int = 0
		var matches: Bool = True

		while index < param_types.length() and matches:
			match (param_types.get(index), arg_types.get(index)):
				(Some(param_type), Some(arg_type)):
					matches = overload_type_patterns_match(type_params, param_type, arg_type)
				_:
					matches = False

			index += 1

		matches


private pure func overload_arg_types_match(
	entry: OverloadEntry,
	arg_types: List[CompilerType],
) -> Bool:
	match function_param_types(entry.func_type):
		Some(param_types):
			overload_type_pattern_lists_match(
				overload_type_param_names(entry),
				param_types,
				arg_types,
			)
		None:
			False


private pure func overload_pure_function_param_count(entry: OverloadEntry) -> Int:
	match function_param_types(entry.func_type):
		Some(param_types):
			var count: Int = 0

			for param_type in param_types:
				match param_type:
					CompilerFunctionType(True, _, _):
						count += 1
					_:
						void

			count
		None:
			0


private pure func type_mentions_any_param(type_params: List[String], typ: CompilerType) -> Bool:
	match typ:
		CompilerTypeVar(name):
			type_params.contains(name)
		CompilerVarDimsType(name):
			type_params.contains(name)
		CompilerNamedType(_, args):
			args.any(func(arg):
				type_mentions_any_param(type_params, arg)
			)
		CompilerArrayType(element, dims):
			type_mentions_any_param(type_params, element) or dims.any(func(dim):
				type_mentions_any_param(type_params, dim)
			)
		CompilerFunctionType(_, params, return_type):
			params.any(func(param):
				type_mentions_any_param(type_params, param)
			) or type_mentions_any_param(type_params, return_type)
		CompilerTupleType(elements):
			elements.any(func(element):
				type_mentions_any_param(type_params, element)
			)
		CompilerRangeType(inner):
			type_mentions_any_param(type_params, inner)
		CompilerDimOpType(_, left, right):
			(
				type_mentions_any_param(type_params, left)
				or type_mentions_any_param(type_params, right)
			)
		_:
			False


private pure func overload_param_specificity_score(
	type_params: List[String],
	param_type: CompilerType,
	arg_type: CompilerType,
) -> Int:
	if compiler_types_equal(param_type, arg_type):
		4
	else if type_mentions_any_param(type_params, param_type):
		1
	else:
		3


private pure func overload_arg_specificity_score(
	entry: OverloadEntry,
	arg_types: List[CompilerType],
) -> Int:
	match function_param_types(entry.func_type):
		Some(param_types):
			type_params = overload_type_param_names(entry)
			var score: Int = 0
			var index: Int = 0

			while index < param_types.length():
				match (param_types.get(index), arg_types.get(index)):
					(Some(param_type), Some(arg_type)):
						score += overload_param_specificity_score(type_params, param_type, arg_type)
					_:
						void

				index += 1

			score
		None:
			0


private pure func overload_selection_score(
	entry: OverloadEntry,
	arg_types: List[CompilerType],
) -> Int:
	overload_arg_specificity_score(
		entry,
		arg_types,
	) * 100 + overload_pure_function_param_count(entry)


private pure func select_unique_best_overload(
	entries: List[OverloadEntry],
	arg_types: List[CompilerType],
) -> Option[OverloadEntry]:
	var best: Option[OverloadEntry] = None
	var best_score: Int = -1
	var tied: Bool = False

	for entry in entries:
		score = overload_selection_score(entry, arg_types)

		if score > best_score:
			best = Some(entry)
			best_score = score
			tied = False
		else if score == best_score:
			tied = True

	if tied:
		None
	else:
		best


pure func env_select_overload_for_args(
	entries: List[OverloadEntry],
	arg_types: List[CompilerType],
) -> Option[OverloadEntry]:
	var matches: List[OverloadEntry] = []

	for entry in entries:
		if overload_arg_types_match(entry, arg_types):
			matches = matches.append(entry)

	select_unique_best_overload(matches, arg_types)


pure func env_resolve_overload(
	env: Env,
	name: String,
	first_arg_type: CompilerType,
) -> Option[OverloadEntry]:
	var matches: List[OverloadEntry] = []

	for entry in env_get_overloads(env, name):
		if overload_first_param_matches(entry, first_arg_type):
			matches = matches.append(entry)

	if matches.length() == 1:
		matches.get(0)
	else:
		select_unique_best_overload(matches, [first_arg_type])


pure func env_add_ufcs_method(env: Env, name: String, entry: OverloadEntry) -> Env:
	entries: List[OverloadEntry] = match find_overload_set(env.ufcs_methods, name):
		Some(set):
			set.entries.append(entry)
		None:
			[entry]

	{ env | ufcs_methods = replace_overload_set(env.ufcs_methods, name, entries) }


private pure func env_lookup_function_ufcs_methods(
	env: Env,
	name: String,
	first_arg_type: CompilerType,
) -> List[OverloadEntry]:
	var result: List[OverloadEntry] = []

	for scope in env.scopes:
		for symbol in scope_symbols_named(scope, name):
			match symbol.kind:
				FuncSymbolKind(func_symbol):
					if func_symbol_supports_ufcs(func_symbol):
						entry = overload_entry_from_func_symbol(func_symbol)

						if overload_first_param_matches(entry, first_arg_type):
							result = result.append(entry)
				_:
					void

	result


private pure func env_lookup_module_function_ufcs_methods(
	env: Env,
	module_path: String,
	name: String,
	first_arg_type: CompilerType,
) -> List[OverloadEntry]:
	var result: List[OverloadEntry] = []

	for scope in env.scopes:
		for symbol in scope_symbols_named(scope, name):
			match symbol.kind:
				FuncSymbolKind(func_symbol):
					if (
						func_symbol.module_path == Some(module_path)
						and func_symbol_supports_ufcs(func_symbol)
					):
						entry = overload_entry_from_func_symbol(func_symbol)

						if overload_first_param_matches(entry, first_arg_type):
							result = result.append(entry)
				_:
					void

	result


pure func env_lookup_ufcs_methods(
	env: Env,
	name: String,
	first_arg_type: CompilerType,
) -> List[OverloadEntry]:
	var result: List[OverloadEntry] = env_lookup_function_ufcs_methods(env, name, first_arg_type)

	match find_overload_set(env.ufcs_methods, name):
		Some(set):
			for entry in set.entries:
				if overload_first_param_matches(entry, first_arg_type):
					result = result.append(entry)
		None:
			void

	result


pure func env_lookup_module_ufcs_methods(
	env: Env,
	module_path: String,
	name: String,
	first_arg_type: CompilerType,
) -> List[OverloadEntry]:
	var result: List[OverloadEntry] = env_lookup_module_function_ufcs_methods(
		env,
		module_path,
		name,
		first_arg_type,
	)

	match find_overload_set(env.ufcs_methods, name):
		Some(set):
			for entry in set.entries:
				if (
					entry.module_path == Some(module_path)
					and overload_first_param_matches(entry, first_arg_type)
				):
					result = result.append(entry)
		None:
			void

	result


pure func env_select_ufcs_method(
	matches: List[OverloadEntry],
	receiver_type: CompilerType,
) -> Option[OverloadEntry]:
	if matches.length() == 1:
		matches.get(0)
	else:
		select_unique_best_overload(matches, [receiver_type])


pure func env_resolve_ufcs_method(
	env: Env,
	name: String,
	receiver_type: CompilerType,
) -> Option[OverloadEntry]:
	env_select_ufcs_method(
		env_lookup_ufcs_methods(env, name, receiver_type),
		receiver_type,
	)


pure func env_resolve_module_ufcs_method(
	env: Env,
	module_path: String,
	name: String,
	receiver_type: CompilerType,
) -> Option[OverloadEntry]:
	env_select_ufcs_method(
		env_lookup_module_ufcs_methods(env, module_path, name, receiver_type),
		receiver_type,
	)


pure func env_has_ufcs_method(env: Env, name: String) -> Bool:
	match find_overload_set(env.ufcs_methods, name):
		Some(set):
			set.entries.length() > 0
		None:
			var found: Bool = False

			for scope in env.scopes:
				for symbol in scope_symbols_named(scope, name):
					match symbol.kind:
						FuncSymbolKind(func_symbol):
							if func_symbol_supports_ufcs(func_symbol):
								found = True
								break
						_:
							void

				if found:
					break

			found


pure func env_find_similar(env: Env, name: String) -> Option[String]:
	var result: Option[String] = None

	for scope in env.scopes:
		for symbol in scope_symbols_in_lookup_order(scope):
			if symbol.name.starts_with(name) or name.starts_with(symbol.name):
				result = Some(symbol.name)
				break

		if result.is_some():
			break

	result
