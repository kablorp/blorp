	[
		compiler_parallel_boundary_descriptor("parallel"),
		compiler_special_descriptor("checked_get", CompilerCheckedGetInference),
		compiler_special_descriptor("checked_set", CompilerCheckedSetInference),
		compiler_special_descriptor("checked_slice", CompilerCheckedSliceInference),
		compiler_special_descriptor("matrix_checked_get", CompilerMatrixCheckedGetInference),
		compiler_special_descriptor("matrix_checked_set", CompilerMatrixCheckedSetInference),
		compiler_special_descriptor("tensor3_checked_get", CompilerTensorCheckedGetInference(3)),
		compiler_special_descriptor("tensor4_checked_get", CompilerTensorCheckedGetInference(4)),
		compiler_special_descriptor("tensor5_checked_get", CompilerTensorCheckedGetInference(5)),
		compiler_special_descriptor("tensor3_checked_set", CompilerTensorCheckedSetInference(3)),
		compiler_special_descriptor("tensor4_checked_set", CompilerTensorCheckedSetInference(4)),
		compiler_special_descriptor("tensor5_checked_set", CompilerTensorCheckedSetInference(5)),
		compiler_special_descriptor("assert_shape", CompilerAssertShapeInference),
		compiler_special_descriptor("length", CompilerLengthRefinedInference),
		compiler_special_descriptor("vector_length", CompilerLengthRefinedInference),
		compiler_special_descriptor("type_name", CompilerTypeNameInference),
		compiler_special_descriptor("is_heap", CompilerIsHeapInference),
		compiler_special_descriptor("vector", CompilerVectorCtorInference),
		compiler_special_descriptor("matrix", CompilerMatrixCtorInference),
		compiler_special_descriptor("tensor3", CompilerTensorCtorInference(3)),
		compiler_special_descriptor("tensor4", CompilerTensorCtorInference(4)),
		compiler_special_descriptor("tensor5", CompilerTensorCtorInference(5)),
		compiler_special_descriptor("bit_and", CompilerBitwiseInference),
		compiler_special_descriptor("bit_or", CompilerBitwiseInference),
		compiler_special_descriptor("bit_xor", CompilerBitwiseInference),
		compiler_special_descriptor("bit_not", CompilerBitwiseInference),
		compiler_special_descriptor("shift_left", CompilerBitwiseInference),
		compiler_special_descriptor("shift_right", CompilerBitwiseInference),
	]


pure func compiler_builtin_descriptors() -> List[CompilerBuiltinDescriptor]:
	compiler_impure_names()
		.map(compiler_impure_descriptor)
		.concat(compiler_fiber_parking_names().map(compiler_fiber_parking_descriptor))
		.concat(compiler_cancellation_names().map(compiler_cancellation_descriptor))
		.concat(compiler_os_worker_blocking_names().map(compiler_os_worker_blocking_descriptor))
		.concat(compiler_special_descriptors())


pure func compiler_builtin_duplicate_names() -> List[String]:
	var seen: List[String] = []
	var duplicates: List[String] = []

	for descriptor in compiler_builtin_descriptors():
		if seen.contains(descriptor.name):
			if not duplicates.contains(descriptor.name):
				duplicates = duplicates.append(descriptor.name)
		else:
			seen = seen.append(descriptor.name)

	duplicates.sort()


private pure func compiler_descriptor_is_inert(descriptor: CompilerBuiltinDescriptor) -> Bool:
	(
		descriptor.runtime_effect == CompilerPureMetadata
		and not descriptor.parallel_boundary
		and descriptor.special_inference.is_none()
	)


pure func compiler_builtin_inert_descriptor_names() -> List[String]:
	var result: List[String] = []

	for descriptor in compiler_builtin_descriptors():
		if compiler_descriptor_is_inert(descriptor):
			result = result.append(descriptor.name)

	result.sort()


pure func compiler_builtin_find(name: String) -> Option[CompilerBuiltinDescriptor]:
	var result: Option[CompilerBuiltinDescriptor] = None

	for descriptor in compiler_builtin_descriptors():
		if descriptor.name == name:
			result = Some(descriptor)
			break

	result


pure func compiler_builtin_is_registered(name: String) -> Bool:
	compiler_builtin_find(name).is_some()


pure func compiler_builtin_has_effect(name: String, effect: CompilerBuiltinEffect) -> Bool:
	match compiler_builtin_find(name):
		Some(descriptor):
			match effect:
				CompilerBuiltinImpure:
					descriptor.runtime_effect != CompilerPureMetadata
				CompilerBuiltinParallelBoundary:
					descriptor.parallel_boundary
				CompilerBuiltinCancellationPoint:
					(
						descriptor.runtime_effect == CompilerCancellationCheckpoint
						or descriptor.runtime_effect == CompilerFiberParkingWait
					)
				CompilerBuiltinFiberParking:
					descriptor.runtime_effect == CompilerFiberParkingWait
				CompilerBuiltinOsWorkerBlocking:
					descriptor.runtime_effect == CompilerOsWorkerBlockingWait
		None:
			False


pure func compiler_builtin_is_impure(name: String) -> Bool:
	compiler_builtin_has_effect(name, CompilerBuiltinImpure)


pure func compiler_builtin_is_parallel_boundary(name: String) -> Bool:
	compiler_builtin_has_effect(name, CompilerBuiltinParallelBoundary)


pure func compiler_builtin_is_cancellation_point(name: String) -> Bool:
	compiler_builtin_has_effect(name, CompilerBuiltinCancellationPoint)


pure func compiler_builtin_may_park_fiber(name: String) -> Bool:
	compiler_builtin_has_effect(name, CompilerBuiltinFiberParking)


pure func compiler_builtin_is_os_worker_blocking(name: String) -> Bool:
	compiler_builtin_has_effect(name, CompilerBuiltinOsWorkerBlocking)


pure func compiler_builtin_special_inference(name: String) -> Option[CompilerSpecialInference]:
	match compiler_builtin_find(name):
		Some(descriptor):
			descriptor.special_inference
		None:
			None


private pure func builtin_purity(name: String) -> CompilerPurity:
	if compiler_builtin_is_impure(name):
		CompilerImpure
	else:
		CompilerPure


private pure func fn_type(params: List[CompilerType], return_type: CompilerType) -> CompilerType:
	CompilerFunctionType(True, params, return_type)


private pure func impure_fn_type(
	params: List[CompilerType],
	return_type: CompilerType,
) -> CompilerType:
	CompilerFunctionType(False, params, return_type)


private pure func compiler_add_builtin_func(
	env: CompilerEnv,
	name: String,
	func_type: CompilerType,
) -> CompilerEnv:
	compiler_add_builtin_generic_func(env, name, [], func_type)


private pure func compiler_add_builtin_generic_func(
	env: CompilerEnv,
	name: String,
	type_params: List[String],
	func_type: CompilerType,
) -> CompilerEnv:
	match compiler_env_mint_def_id(env):
		(next_env, def_id):
			compiler_env_add_func_with_info(
				next_env,
				name,
				compiler_func_symbol(
					def_id,
					func_type,
					type_params.map(func(param): compiler_make_bound_type_param(param, [])),
					[],
					builtin_purity(name),
					CompilerBuiltinFunc,
					CompilerRejectResourceArgs,
					None,
					[],
					None,
					False,
				),
			)


private pure func compiler_add_loop_producer_builtin(
	env: CompilerEnv,
	name: String,
	type_params: List[String],
	func_type: CompilerType,
	loop_producer: CompilerLoopProducer,
) -> CompilerEnv:
	match compiler_env_mint_def_id(env):
		(next_env, def_id):
			compiler_env_add_func_with_info(
				next_env,
				name,
				compiler_func_symbol(
					def_id,
					func_type,
					type_params.map(func(param): compiler_make_bound_type_param(param, [])),
					[],
					builtin_purity(name),
					CompilerBuiltinFunc,
					CompilerRejectResourceArgs,
					None,
					[],
					Some(loop_producer),
					False,
				),
			)


private pure func compiler_add_scalar_conversion_builtin(
	env: CompilerEnv,
	name: String,
	result_type: CompilerType,
) -> CompilerEnv:
	compiler_add_builtin_generic_func(
		env,
		name,
		["T"],
		fn_type([CompilerTypeVar("T")], result_type),
	)


private pure func compiler_add_tensor_constructor_builtin(
	env: CompilerEnv,
	name: String,
	dim_names: List[String],
) -> CompilerEnv:
	dims = dim_names.map(func(dim_name): CompilerTypeVar(dim_name))
	compiler_add_builtin_generic_func(
		env,
		name,
		["T"].concat(dim_names),
		fn_type(
			[CompilerTypeVar("T")].concat(dim_names.map(
				func(_): compiler_type_int(),
			)),
			CompilerArrayType(CompilerTypeVar("T"), dims),
		),
	)


private pure func compiler_add_checked_read_builtin(
	env: CompilerEnv,
	name: String,
	index_count: Int,
) -> CompilerEnv:
	var params: List[CompilerType] = [CompilerTypeVar("T")]

	for _ in 0..index_count:
		params = params.append(compiler_type_int())

	compiler_add_builtin_generic_func(
		env,
		name,
		["T"],
		fn_type(params, CompilerTypeVar("T")),
	)


private pure func compiler_add_checked_write_builtin(
	env: CompilerEnv,
	name: String,
	index_count: Int,
) -> CompilerEnv:
	var params: List[CompilerType] = [CompilerTypeVar("T")]

	for _ in 0..index_count:
		params = params.append(compiler_type_int())

	params = params.append(CompilerTypeVar("T"))
	compiler_add_builtin_generic_func(
		env,
		name,
		["T"],
		fn_type(params, CompilerTypeVar("T")),
	)


private pure func compiler_add_resource_builtin_generic_func(
	env: CompilerEnv,
	name: String,
	type_params: List[String],
	func_type: CompilerType,
	resource_result: CompilerResourceResultPolicy,
) -> CompilerEnv:
	match compiler_env_mint_def_id(env):
		(next_env, def_id):
			compiler_env_add_func_with_info(
				next_env,
				name,
				compiler_func_symbol(
					def_id,
					func_type,
					type_params.map(func(param): compiler_make_bound_type_param(param, [])),
					[],
					builtin_purity(name),
					CompilerBuiltinFunc,
					CompilerAllowResourceArgs(resource_result),
					None,
					[],
					None,
					False,
				),
			)


private pure func compiler_add_builtin_impl(
	env: CompilerEnv,
	trait_name: String,
	for_type: CompilerType,
) -> CompilerEnv:
	match compiler_env_mint_def_id(env):
		(next_env, def_id):
			compiler_env_add_impl(
				next_env,
				compiler_impl_instance(def_id, trait_name, for_type, [], True),
			)


private pure func add_core_builtin_types(env: CompilerEnv) -> CompilerEnv:
	var result: CompilerEnv = env

	for name in [
		"Int",
		"Float",
		"Bool",
		"String",
		"Char",
		"Void",
		"Bytes",
		"Ptr",
		"Fixed",
		"Int8",
		"Int16",
		"Int32",
		"Int128",
		"UInt8",
		"UInt16",
		"UInt32",
		"UInt64",
		"UInt128",
		"Float32",
		"Float16",
	]:
		result = compiler_env_add_type(result, name, [], [], CompilerTypeBuiltin, False, False)

	result = compiler_env_add_type(result, "Tensor", ["T"], [], CompilerTypeBuiltin, False, False)
	result = compiler_env_add_alias(result, "Int64", [], compiler_type_int())
	result = compiler_env_add_type(
		result,
		"Option",
		["T"],
		[
			{
				name = "Some",
				fields = [CompilerTypeVar("T")],
				tag = 0
			},
			{
				name = "None",
				fields = [],
				tag = 1
			},
		],
		CompilerTypeBuiltin,
		False,
		True,
	)
	result = compiler_env_add_type(
		result,
		"Result",
		["T", "E"],
		[
			{
				name = "Ok",
				fields = [CompilerTypeVar("T")],
				tag = 0
			},
			{
				name = "Err",
				fields = [CompilerTypeVar("E")],
				tag = 1
			},
		],
		CompilerTypeBuiltin,
		False,
		True,
	)
	result = compiler_env_add_type(
		result,
		"ConcurrencyError",
		[],
		[
			{
				name = "Timeout",
				fields = [],
				tag = 0
			},
			{
				name = "TaskFailed",
				fields = [compiler_type_string()],
				tag = 1
			},
			{
				name = "Cancelled",
				fields = [],
				tag = 2
			},
		],
		CompilerTypeBuiltin,
		False,
		True,
	)
	result = compiler_env_add_alias(
		result,
		"TaskResult",
		["T"],
		CompilerNamedType(
			"Result",
			[CompilerTypeVar("T"), CompilerNamedType("ConcurrencyError", [])],
		),
	)
	result


pure func compiler_builtin_trait_is_prelude(trait_name: String) -> Bool:
	-- These traits own callable names installed directly into the compiler
	-- prelude below. Source loading may replace their declarations with the
	-- equivalent std/traits definitions, so module ownership is not a stable
	-- way to identify prelude visibility.
	match trait_name:
		"Absolute":
			True
		"Bounded":
			True
		"Equatable":
			True
		"FixedPoint":
			True
		"FloatingPoint":
			True
		"HasLength":
			True
		"Integer":
			True
		"Orderable":
			True
		"Stringable":
			True
		"ToFloat":
			True
		"ToInt":
			True
		_:
			False


private pure func builtin_unary_self_method(
	name: String,
	return_type: CompilerType,
) -> CompilerTraitMethodSig:
	compiler_trait_method_sig(name, [CompilerSelfType], return_type, True)


private pure func builtin_binary_self_method(
	name: String,
	return_type: CompilerType,
) -> CompilerTraitMethodSig:
	compiler_trait_method_sig(
		name,
		[CompilerSelfType, CompilerSelfType],
		return_type,
		True,
	)


private pure func add_core_builtin_traits(env: CompilerEnv) -> CompilerEnv:
	var result: CompilerEnv = env
	option_self = CompilerNamedType("Option", [CompilerSelfType])
	fixed_type = CompilerNamedType("Fixed", [])

	result = compiler_env_add_trait(
		result,
		compiler_trait_def(
			100,
			"Stringable",
			[],
			[builtin_unary_self_method("to_string", compiler_type_string())],
		),
	)
	result = compiler_env_add_trait(
		result,
		compiler_trait_def(
			101,
			"Equatable",
			[],
			[builtin_binary_self_method("equals", compiler_type_bool())],
		),
	)
	result = compiler_env_add_trait(
		result,
		compiler_trait_def(
			102,
			"Orderable",
			["Equatable"],
			[builtin_binary_self_method("less_than", compiler_type_bool())],
		),
	)
	result = compiler_env_add_trait(
		result,
		compiler_trait_def(
			103,
			"HasLength",
			[],
			[builtin_unary_self_method("length", compiler_type_int())],
		),
	)
	result = compiler_env_add_trait(
		result,
		compiler_trait_def(
			104,
			"Integer",
			[
				"Addable",
				"Subtractable",
				"Multipliable",
				"Divisible",
				"Modulable",
				"Orderable",
				"HasZero",
				"HasOne",
				"Stringable",
				"Absolute",
				"Bounded",
				"ToInt",
			],
			[
				builtin_binary_self_method("checked_div", option_self),
				builtin_binary_self_method("checked_mod", option_self),
				builtin_binary_self_method("bit_and", CompilerSelfType),
				builtin_binary_self_method("bit_or", CompilerSelfType),
				builtin_binary_self_method("bit_xor", CompilerSelfType),
				builtin_unary_self_method("bit_not", CompilerSelfType),
				compiler_trait_method_sig(
					"shift_left",
					[CompilerSelfType, compiler_type_int()],
					CompilerSelfType,
					True,
				),
				compiler_trait_method_sig(
					"shift_right",
					[CompilerSelfType, compiler_type_int()],
					CompilerSelfType,
					True,
				),
			],
		),
	)
	result = compiler_env_add_trait(
		result,
		compiler_trait_def(
			105,
			"FloatingPoint",
			[
				"Addable",
				"Subtractable",
				"Multipliable",
				"Divisible",
				"Negatable",
				"Orderable",
				"HasZero",
				"HasOne",
				"Stringable",
				"Absolute",
				"Bounded",
				"ToFloat",
			],
			[
				builtin_unary_self_method("floor", CompilerSelfType),
				builtin_unary_self_method("ceil", CompilerSelfType),
				builtin_unary_self_method("round", CompilerSelfType),
				builtin_unary_self_method("trunc", CompilerSelfType),
				builtin_unary_self_method("sqrt", CompilerSelfType),
				builtin_unary_self_method("sin", CompilerSelfType),
				builtin_unary_self_method("cos", CompilerSelfType),
				builtin_unary_self_method("tan", CompilerSelfType),
				builtin_unary_self_method("exp", CompilerSelfType),
				builtin_unary_self_method("log", CompilerSelfType),
				builtin_binary_self_method("pow", CompilerSelfType),
				builtin_unary_self_method("is_nan", compiler_type_bool()),
				builtin_unary_self_method("is_inf", compiler_type_bool()),
				builtin_unary_self_method("is_finite", compiler_type_bool()),
			],
		),
	)

	result = compiler_env_add_trait(
		result,
		compiler_trait_def(
			106,
			"Addable",
			[],
			[builtin_binary_self_method("add", CompilerSelfType)],
		),
	)
	result = compiler_env_add_trait(
		result,
		compiler_trait_def(
			107,
			"Subtractable",
			[],
			[builtin_binary_self_method("subtract", CompilerSelfType)],
		),
	)
	result = compiler_env_add_trait(
		result,
		compiler_trait_def(
			108,
			"Multipliable",
			[],
			[builtin_binary_self_method("multiply", CompilerSelfType)],
		),
	)
	result = compiler_env_add_trait(
		result,
		compiler_trait_def(
			109,
			"Divisible",
			[],
			[builtin_binary_self_method("divide", CompilerSelfType)],
		),
	)
	result = compiler_env_add_trait(
		result,
		compiler_trait_def(
			110,
			"Modulable",
			[],
			[builtin_binary_self_method("remainder", CompilerSelfType)],
		),
	)
	result = compiler_env_add_trait(
		result,
		compiler_trait_def(
			111,
			"Negatable",
			[],
			[builtin_unary_self_method("negate", CompilerSelfType)],
		),
	)
	result = compiler_env_add_trait(
		result,
		compiler_trait_def(
			112,
			"HasZero",
			[],
			[compiler_trait_method_sig("zero", [], CompilerSelfType, True)],
		),
	)
	result = compiler_env_add_trait(
		result,
		compiler_trait_def(
			113,
			"HasOne",
			[],
			[compiler_trait_method_sig("one", [], CompilerSelfType, True)],
		),
	)
	result = compiler_env_add_trait(
		result,
		compiler_trait_def(
			114,
			"Absolute",
			[],
			[builtin_unary_self_method("abs", CompilerSelfType)],
		),
	)
	result = compiler_env_add_trait(
		result,
		compiler_trait_def(
			115,
			"Bounded",
			[],
			[
				builtin_binary_self_method("min", CompilerSelfType),
				builtin_binary_self_method("max", CompilerSelfType),
			],
		),
	)
	result = compiler_env_add_trait(
		result,
		compiler_trait_def(
			116,
			"Hashable",
			["Equatable"],
			[builtin_unary_self_method("hash", compiler_type_int())],
		),
	)
	result = compiler_env_add_trait(
		result,
		compiler_trait_def(
			117,
			"ToBool",
			[],
			[builtin_unary_self_method("to_bool", compiler_type_bool())],
		),
	)
	result = compiler_env_add_trait(
		result,
		compiler_trait_def(
			118,
			"Logical",
			[],
			[
				builtin_binary_self_method("logical_and", CompilerSelfType),
				builtin_binary_self_method("logical_or", CompilerSelfType),
				builtin_unary_self_method("logical_not", CompilerSelfType),
			],
		),
	)
	result = compiler_env_add_trait(
		result,
		compiler_trait_def(
			119,
			"ToInt",
			[],
			[builtin_unary_self_method("to_int", compiler_type_int())],
		),
	)
	result = compiler_env_add_trait(
		result,
		compiler_trait_def(
			120,
			"ToFloat",
			[],
			[builtin_unary_self_method("to_float", compiler_type_float())],
		),
	)
	result = compiler_env_add_trait(
		result,
		compiler_trait_def(121, "ToFixed", [], [builtin_unary_self_method("to_fixed", fixed_type)]),
	)
	result = compiler_env_add_trait(
		result,
		compiler_trait_def(
			122,
			"ToChar",
			[],
			[builtin_unary_self_method("to_char", compiler_type_char())],
		),
	)
	result = compiler_env_add_trait(
		result,
		compiler_trait_def(
			123,
			"SignedInteger",
			["Integer", "Negatable"],
			[],
		),
	)
	result = compiler_env_add_trait(
		result,
		compiler_trait_def(124, "UnsignedInteger", ["Integer"], []),
	)
	result = compiler_env_add_trait(
		result,
		compiler_trait_def(
			125,
			"Numeric",
			["Addable", "Multipliable", "HasZero"],
			[],
		),
	)
	result = compiler_env_add_trait(
		result,
		compiler_trait_def(
			126,
			"FixedPoint",
			[
				"Addable",
				"Subtractable",
				"Multipliable",
				"Divisible",
				"Orderable",
				"HasZero",
				"Stringable",
				"Absolute",
				"Bounded",
			],
			[
				builtin_unary_self_method("get_scale", compiler_type_int()),
				compiler_trait_method_sig(
					"round_to",
					[CompilerSelfType, compiler_type_int()],
					CompilerSelfType,
					True,
				),
			],
		),
	)
	result = compiler_env_add_trait(
		result,
		compiler_trait_def(
			127,
			"Copyable",
			[],
			[builtin_unary_self_method("copy", CompilerSelfType)],
		),
	)
	result = compiler_env_add_trait(
		result,
		compiler_trait_def(
			128,
			"Cloneable",
			[],
			[compiler_trait_method_sig("clone", [CompilerSelfType], CompilerSelfType, False)],
		),
	)

	for name in [
		"checked_div",
		"checked_mod",
		"bit_and",
		"bit_or",
		"bit_xor",
		"bit_not",
		"shift_left",
		"shift_right",
	]:
		result = compiler_env_add_trait_function(result, name, "Integer")

	for name in [
		"floor",
		"ceil",
		"round",
		"trunc",
		"sqrt",
		"sin",
		"cos",
		"tan",
		"exp",
		"log",
		"pow",
		"is_nan",
		"is_inf",
		"is_finite",
	]:
		result = compiler_env_add_trait_function(result, name, "FloatingPoint")

	result = compiler_env_add_trait_function(result, "to_string", "Stringable")
	result = compiler_env_add_trait_function(result, "equals", "Equatable")
	result = compiler_env_add_trait_function(result, "less_than", "Orderable")
	result = compiler_env_add_trait_function(result, "length", "HasLength")
	result = compiler_env_add_trait_function(result, "to_int", "ToInt")
	result = compiler_env_add_trait_function(result, "to_float", "ToFloat")
	result = compiler_env_add_trait_function(result, "abs", "Absolute")
	result = compiler_env_add_trait_function(result, "min", "Bounded")
	result = compiler_env_add_trait_function(result, "max", "Bounded")
	result = compiler_env_add_trait_function(result, "get_scale", "FixedPoint")
	result = compiler_env_add_trait_function(result, "round_to", "FixedPoint")
	result = compiler_add_builtin_impl(result, "Integer", compiler_type_int())
	result = compiler_add_builtin_impl(result, "SignedInteger", compiler_type_int())

	for name in ["Int8", "Int16", "Int32", "Int128"]:
		typ = CompilerNamedType(name, [])
		result = compiler_add_builtin_impl(result, "Integer", typ)
		result = compiler_add_builtin_impl(result, "SignedInteger", typ)

	for name in ["UInt8", "UInt16", "UInt32", "UInt64", "UInt128"]:
		typ = CompilerNamedType(name, [])
		result = compiler_add_builtin_impl(result, "Integer", typ)
		result = compiler_add_builtin_impl(result, "UnsignedInteger", typ)

	for name in ["Float", "Float32", "Float16"]:
		result = compiler_add_builtin_impl(
			result,
			"FloatingPoint",
			CompilerNamedType(name, []),
		)

	result = compiler_add_builtin_impl(result, "FixedPoint", fixed_type)
	result = compiler_add_builtin_impl(result, "Stringable", compiler_type_string())
	result = compiler_add_builtin_impl(result, "Equatable", compiler_type_string())
	result = compiler_add_builtin_impl(result, "Equatable", compiler_type_bool())
	result = compiler_add_builtin_impl(result, "Orderable", compiler_type_string())
	result = compiler_add_builtin_impl(result, "Orderable", compiler_type_int())
	result = compiler_add_builtin_impl(result, "Orderable", compiler_type_float())
	result = compiler_add_builtin_impl(result, "Orderable", compiler_type_char())
	result


private pure func add_core_builtin_functions(env: CompilerEnv) -> CompilerEnv:
	var result: CompilerEnv = env
	list_of_t: CompilerType = CompilerNamedType("List", [CompilerTypeVar("T")])
	channel_of_t: CompilerType = CompilerNamedType("Channel", [CompilerTypeVar("T")])
	option_of_t: CompilerType = CompilerNamedType("Option", [CompilerTypeVar("T")])
	char_type: CompilerType = compiler_type_char()
	fixed_type: CompilerType = CompilerNamedType("Fixed", [])

	result = compiler_add_builtin_generic_func(
		result,
		"to_string",
		["T"],
		fn_type([CompilerTypeVar("T")], compiler_type_string()),
	)
	result = compiler_add_builtin_generic_func(
		result,
		"to_int",
		["T"],
		fn_type([CompilerTypeVar("T")], compiler_type_int()),
	)
	result = compiler_add_builtin_generic_func(
		result,
		"to_float",
		["T"],
		fn_type([CompilerTypeVar("T")], compiler_type_float()),
	)
	result = compiler_add_builtin_generic_func(
		result,
		"to_bool",
		["T"],
		fn_type([CompilerTypeVar("T")], compiler_type_bool()),
	)
	result = compiler_add_builtin_generic_func(
		result,
		"to_char",
		["T"],
		fn_type([CompilerTypeVar("T")], compiler_type_char()),
	)
	result = compiler_add_builtin_func(
		result,
		"from_char",
		fn_type([char_type], compiler_type_string()),
	)
	result = compiler_add_builtin_func(
		result,
		"from_chars",
		fn_type([CompilerNamedType("List", [char_type])], compiler_type_string()),
	)
	result = compiler_add_builtin_func(
		result,
		"fixed",
		fn_type(
			[compiler_type_float(), compiler_type_int()],
			fixed_type,
		),
	)

	for (name, result_type) in [
		("to_int8", CompilerNamedType("Int8", [])),
		("to_int16", CompilerNamedType("Int16", [])),
		("to_int32", CompilerNamedType("Int32", [])),
		("to_int128", CompilerNamedType("Int128", [])),
		("to_uint8", CompilerNamedType("UInt8", [])),
		("to_uint16", CompilerNamedType("UInt16", [])),
		("to_uint32", CompilerNamedType("UInt32", [])),
		("to_uint64", CompilerNamedType("UInt64", [])),
		("to_uint128", CompilerNamedType("UInt128", [])),
		("to_float16", CompilerNamedType("Float16", [])),
		("to_float32", CompilerNamedType("Float32", [])),
	]:
		result = compiler_add_scalar_conversion_builtin(result, name, result_type)

	result = compiler_add_builtin_generic_func(
		result,
		"equals",
		["T"],
		fn_type(
			[CompilerTypeVar("T"), CompilerTypeVar("T")],
			compiler_type_bool(),
		),
	)
	result = compiler_add_builtin_generic_func(
		result,
		"length",
		["T"],
		fn_type([list_of_t], compiler_type_int()),
	)
	result = compiler_add_builtin_func(
		result,
		"print",
		impure_fn_type([compiler_type_string()], compiler_type_void()),
	)
	result = compiler_add_builtin_func(
		result,
		"sleep",
		impure_fn_type([compiler_type_int()], compiler_type_void()),
	)
	result = compiler_add_builtin_func(
		result,
		"yield_now",
		impure_fn_type([], compiler_type_void()),
	)
	result = compiler_add_builtin_generic_func(
		result,
		"parallel",
		["T"],
		fn_type([list_of_t], list_of_t),
	)

	for name in ["bit_and", "bit_or", "bit_xor"]:
		result = compiler_add_builtin_generic_func(
			result,
			name,
			["T"],
			fn_type(
				[CompilerTypeVar("T"), CompilerTypeVar("T")],
				CompilerTypeVar("T"),
			),
		)

	result = compiler_add_builtin_generic_func(
		result,
		"bit_not",
		["T"],
		fn_type([CompilerTypeVar("T")], CompilerTypeVar("T")),
	)

	for name in ["shift_left", "shift_right"]:
		result = compiler_add_builtin_generic_func(
			result,
			name,
			["T"],
			fn_type(
				[CompilerTypeVar("T"), compiler_type_int()],
				CompilerTypeVar("T"),
			),
		)

	for name in ["checked_div", "checked_mod"]:
		result = compiler_add_builtin_func(
			result,
			name,
			fn_type(
				[compiler_type_int(), compiler_type_int()],
				CompilerNamedType(
					"Option",
					[compiler_type_int()],
				),
			),
		)

	result = compiler_add_tensor_constructor_builtin(result, "vector", ["#N"])
	result = compiler_add_tensor_constructor_builtin(
		result,
		"matrix",
		["#N", "#M"],
	)

	result = compiler_add_tensor_constructor_builtin(
		result,
		"tensor3",
		["#X", "#Y", "#Z"],
	)
	result = compiler_add_tensor_constructor_builtin(
		result,
		"tensor4",
		["#A", "#B", "#C", "#D"],
	)
	result = compiler_add_tensor_constructor_builtin(
		result,
		"tensor5",
		["#A", "#B", "#C", "#D", "#E"],
	)

	result = compiler_add_builtin_generic_func(
		result,
		"checked_get",
		["T"],
		fn_type(
			[list_of_t, compiler_type_int()],
			CompilerNamedType(
				"Option",
				[CompilerTypeVar("T")],
			),
		),
	)

	result = compiler_add_builtin_generic_func(
		result,
		"tensor_peel",
		["T"],
		fn_type(
			[CompilerTypeVar("T"), compiler_type_int()],
			CompilerTypeVar("T"),
		),
	)
	result = compiler_add_checked_write_builtin(result, "checked_set", 1)
	result = compiler_add_builtin_generic_func(
		result,
		"checked_slice",
		["T"],
		fn_type(
			[CompilerTypeVar("T"), compiler_type_int(), compiler_type_int()],
			CompilerTypeVar("T"),
		),
	)
	result = compiler_add_checked_read_builtin(result, "matrix_checked_get", 2)
	result = compiler_add_checked_write_builtin(result, "matrix_checked_set", 2)
	result = compiler_add_checked_read_builtin(result, "tensor3_checked_get", 3)
	result = compiler_add_checked_write_builtin(result, "tensor3_checked_set", 3)
	result = compiler_add_checked_read_builtin(result, "tensor4_checked_get", 4)
	result = compiler_add_checked_write_builtin(result, "tensor4_checked_set", 4)
	result = compiler_add_checked_read_builtin(result, "tensor5_checked_get", 5)
	result = compiler_add_checked_write_builtin(result, "tensor5_checked_set", 5)

	result = compiler_add_builtin_generic_func(
		result,
		"assert_shape",
		["T"],
		fn_type([list_of_t], compiler_type_bool()),
	)
	result = compiler_add_builtin_generic_func(
		result,
		"channel",
		["T"],
		impure_fn_type([compiler_type_int()], channel_of_t),
	)
	result = compiler_add_resource_builtin_generic_func(
		result,
		"send",
		["T"],
		impure_fn_type(
			[channel_of_t, CompilerTypeVar("T")],
			compiler_type_bool(),
		),
		CompilerResourceResultOrdinary,
	)
	result = compiler_add_resource_builtin_generic_func(
		result,
		"recv",
		["T"],
		impure_fn_type([channel_of_t], option_of_t),
		CompilerResourceResultDependent,
	)
	result = compiler_add_resource_builtin_generic_func(
		result,
		"try_send",
		["T"],
		impure_fn_type(
			[channel_of_t, CompilerTypeVar("T")],
			compiler_type_bool(),
		),
		CompilerResourceResultOrdinary,
	)
	result = compiler_add_resource_builtin_generic_func(
		result,
		"try_recv",
		["T"],
		impure_fn_type([channel_of_t], option_of_t),
		CompilerResourceResultDependent,
	)
	result = compiler_add_resource_builtin_generic_func(
		result,
		"recv_timeout",
		["T"],
		impure_fn_type(
			[channel_of_t, compiler_type_int()],
			option_of_t,
		),
		CompilerResourceResultDependent,
	)
	result = compiler_add_resource_builtin_generic_func(
		result,
		"send_timeout",
		["T"],
		impure_fn_type(
			[channel_of_t, CompilerTypeVar("T"), compiler_type_int()],
			compiler_type_bool(),
		),
		CompilerResourceResultOrdinary,
	)
	result = compiler_add_resource_builtin_generic_func(
		result,
		"seal",
		["T"],
		impure_fn_type([channel_of_t], compiler_type_void()),
		CompilerResourceResultOrdinary,
	)
	result = compiler_add_builtin_func(
		result,
		"max_threads",
		fn_type([], compiler_type_int()),
	)

	matrix_of_t: CompilerType = CompilerArrayType(
		CompilerTypeVar("T"),
		[CompilerTypeVar("#M"), CompilerTypeVar("#N")],
	)
	result = compiler_add_loop_producer_builtin(
		result,
		"enumerate2",
		["T", "#M", "#N"],
		fn_type(
			[matrix_of_t],
			CompilerNamedType("List", [CompilerTupleType([
						compiler_type_int(),
						compiler_type_int(),
						CompilerTypeVar("T"),
					])]),
		),
		CompilerLoopProducerEnumerate2,
	)
	result = compiler_add_builtin_generic_func(
		result,
		"zip",
		["T", "U", "#N"],
		fn_type(
			[
				CompilerArrayType(CompilerTypeVar("T"), [CompilerTypeVar("#N")]),
				CompilerArrayType(CompilerTypeVar("U"), [CompilerTypeVar("#N")]),
			],
			CompilerArrayType(
				CompilerTupleType([CompilerTypeVar("T"), CompilerTypeVar("U")]),
				[CompilerTypeVar("#N")],
			),
		),
	)

	compiler_add_loop_producer_builtin(
		result,
		"windows",
		["T"],
		fn_type(
			[list_of_t, compiler_type_int()],
			list_of_t,
		),
		CompilerLoopProducerWindows,
	)


pure func compiler_env_with_builtins(env: CompilerEnv) -> CompilerEnv:
	env
		.add_core_builtin_types()
		.add_core_builtin_traits()
		.add_core_builtin_functions()
