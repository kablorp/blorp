import:
	../stage_04_modules/compiler_loaded_module: CompilerModuleOrigin(CompilerStdlibModule)
	compiler_env:
		Env,
		FuncOrigin(BuiltinFunc),
		LoopProducer(LoopProducerEnumerate2, LoopProducerIndices, LoopProducerWindows),
		Purity(Impure, Pure),
		ResourceArgPolicy(AllowResourceArgs, RejectResourceArgs),
		ResourceResultPolicy(
			ResourceResultDependent,
			ResourceResultIndependent,
			ResourceResultOrdinary,
		),
		TraitMethodSig,
		TypeKind(TypeBuiltin),
		env_add_alias,
		env_add_func_with_info,
		env_add_impl,
		env_add_trait,
		env_add_trait_function,
		env_add_type,
		env_mint_def_id,
		func_symbol,
		impl_instance,
		trait_def,
		trait_method_sig,
	compiler_generic_params: make_bound_type_param
	compiler_type:
		SemanticType(
			SemanticArrayType,
			SemanticFunctionType,
			SemanticNamedType,
			SemanticSelfType,
			SemanticTupleType,
			SemanticTypeVar,
			SemanticVarDimsType,
		),
		type_bool,
		type_char,
		type_float,
		type_int,
		type_string,
		type_void,


enum BuiltinEffect:
	BuiltinImpure
	BuiltinParallelBoundary
	BuiltinCancellationPoint
	BuiltinFiberParking
	BuiltinOsWorkerBlocking


private PRELUDE_TRAITS_MODULE_PATH: String = "std/traits"

private PRELUDE_TRAITS_MODULE_NAME: String = "traits"


private enum RuntimeEffect:
	NoRuntimeEffect
	ImpureNonWaiting
	CancellationCheckpoint
	FiberParkingWait
	OsWorkerBlockingWait


union SpecialInference:
	CheckedGetInference
	CheckedSetInference
	CheckedSliceInference
	MatrixCheckedGetInference
	MatrixCheckedSetInference
	TensorCheckedGetInference(Int)
	TensorCheckedSetInference(Int)
	AssertShapeInference
	LengthRefinedInference
	TypeNameInference
	IsHeapInference
	VectorCtorInference
	MatrixCtorInference
	TensorCtorInference(Int)
	BitwiseInference


pure func builtin_is_elementwise_tensor_function(name: String) -> Bool:
	["sqrt", "abs", "exp", "log"].contains(name)


-- Resource-producing builtins borrow their resource argument by default. Keep
-- the exceptional ownership contracts beside the other builtin metadata.
pure func builtin_resource_result_policy(name: String) -> ResourceResultPolicy:
	match name:
		"blorp_tcp_accept_raw":
			ResourceResultIndependent
		_:
			ResourceResultDependent


