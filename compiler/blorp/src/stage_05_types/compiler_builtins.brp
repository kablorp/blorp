pure func builtin_is_registered(name: String) -> Bool:
	(
		builtin_runtime_effect(name) != NoRuntimeEffect
		or builtin_is_parallel_boundary(name)
		or builtin_special_inference(name).is_some()
	)


pure func builtin_has_effect(name: String, effect: BuiltinEffect) -> Bool:
	runtime_effect = builtin_runtime_effect(name)

	match effect:
		BuiltinImpure:
			runtime_effect != NoRuntimeEffect
		BuiltinParallelBoundary:
			builtin_is_parallel_boundary(name)
		BuiltinCancellationPoint:
			runtime_effect == CancellationCheckpoint or runtime_effect == FiberParkingWait
		BuiltinFiberParking:
			runtime_effect == FiberParkingWait
		BuiltinOsWorkerBlocking:
			runtime_effect == OsWorkerBlockingWait


pure func builtin_is_impure(name: String) -> Bool:
	builtin_runtime_effect(name) != NoRuntimeEffect


pure func builtin_is_parallel_boundary(name: String) -> Bool:
	name == "parallel"


pure func builtin_is_cancellation_point(name: String) -> Bool:
	builtin_has_effect(name, BuiltinCancellationPoint)


pure func builtin_may_park_fiber(name: String) -> Bool:
	builtin_has_effect(name, BuiltinFiberParking)


pure func builtin_is_os_worker_blocking(name: String) -> Bool:
	builtin_has_effect(name, BuiltinOsWorkerBlocking)


pure func builtin_special_inference(name: String) -> Option[SpecialInference]:
	match name:
		"checked_get":
			Some(CheckedGetInference)
		"checked_set":
			Some(CheckedSetInference)
		"checked_slice":
			Some(CheckedSliceInference)
		"matrix_checked_get":
			Some(MatrixCheckedGetInference)
		"matrix_checked_set":
			Some(MatrixCheckedSetInference)
		"tensor3_checked_get":
			Some(TensorCheckedGetInference(3))
		"tensor4_checked_get":
			Some(TensorCheckedGetInference(4))
		"tensor5_checked_get":
			Some(TensorCheckedGetInference(5))
		"tensor3_checked_set":
			Some(TensorCheckedSetInference(3))
		"tensor4_checked_set":
			Some(TensorCheckedSetInference(4))
		"tensor5_checked_set":
			Some(TensorCheckedSetInference(5))
		"assert_shape":
			Some(AssertShapeInference)
		"length":
			Some(LengthRefinedInference)
		"vector_length":
			Some(LengthRefinedInference)
		"type_name":
			Some(TypeNameInference)
		"is_heap":
			Some(IsHeapInference)
		"vector":
			Some(VectorCtorInference)
		"matrix":
			Some(MatrixCtorInference)
		"tensor3":
			Some(TensorCtorInference(3))
		"tensor4":
			Some(TensorCtorInference(4))
		"tensor5":
			Some(TensorCtorInference(5))
		"bit_and":
			Some(BitwiseInference)
		"bit_or":
			Some(BitwiseInference)
		"bit_xor":
			Some(BitwiseInference)
		"bit_not":
			Some(BitwiseInference)
		"shift_left":
			Some(BitwiseInference)
		"shift_right":
			Some(BitwiseInference)
		_:
			None


private pure func builtin_purity(name: String) -> Purity:
	if builtin_is_impure(name):
		Impure
	else:
		Pure


private pure func fn_type(params: List[SemanticType], return_type: SemanticType) -> SemanticType:
	SemanticFunctionType(True, params, return_type)


private pure func impure_fn_type(
	params: List[SemanticType],
	return_type: SemanticType,
) -> SemanticType:
	SemanticFunctionType(False, params, return_type)


private pure func add_builtin_func(env: Env, name: String, func_type: SemanticType) -> Env:
	add_builtin_generic_func(env, name, [], func_type)


private pure func add_builtin_generic_func(
	env: Env,
	name: String,
	type_params: List[String],
	func_type: SemanticType,
) -> Env:
	match env_mint_def_id(env):
		(next_env, def_id):
			env_add_func_with_info(
				next_env,
				name,
				func_symbol(
					def_id,
					func_type,
					type_params.map(func(param): make_bound_type_param(param, [])),
					[],
					builtin_purity(name),
					BuiltinFunc,
					RejectResourceArgs,
					None,
					[],
					None,
					False,
				),
			)


private pure func add_loop_producer_builtin(
	env: Env,
	name: String,
	type_params: List[String],
	func_type: SemanticType,
	loop_producer: LoopProducer,
) -> Env:
	match env_mint_def_id(env):
		(next_env, def_id):
			env_add_func_with_info(
				next_env,
				name,
				func_symbol(
					def_id,
					func_type,
					type_params.map(func(param): make_bound_type_param(param, [])),
					[],
					builtin_purity(name),
					BuiltinFunc,
					RejectResourceArgs,
					None,
					[],
					Some(loop_producer),
					False,
				),
			)


private pure func add_scalar_conversion_builtin(
	env: Env,
	name: String,
	result_type: SemanticType,
) -> Env:
	add_builtin_generic_func(
		env,
		name,
		["T"],
		fn_type([SemanticTypeVar("T")], result_type),
	)


private pure func add_tensor_constructor_builtin(
	env: Env,
	name: String,
	dim_names: List[String],
) -> Env:
	dims = dim_names.map(func(dim_name): SemanticTypeVar(dim_name))
	add_builtin_generic_func(
		env,
		name,
		["T"].concat(dim_names),
		fn_type(
			[SemanticTypeVar("T")].concat(dim_names.map(
				func(_): type_int(),
			)),
			SemanticArrayType(SemanticTypeVar("T"), dims),
		),
	)


private pure func add_checked_read_builtin(env: Env, name: String, index_count: Int) -> Env:
	var params: List[SemanticType] = [SemanticTypeVar("T")]

	for _ in 0..index_count:
		params = params.append(type_int())

	add_builtin_generic_func(
		env,
		name,
		["T"],
		fn_type(params, SemanticTypeVar("T")),
	)


private pure func add_checked_write_builtin(env: Env, name: String, index_count: Int) -> Env:
	var params: List[SemanticType] = [SemanticTypeVar("T")]

	for _ in 0..index_count:
		params = params.append(type_int())

	params = params.append(SemanticTypeVar("T"))
	add_builtin_generic_func(
		env,
		name,
		["T"],
		fn_type(params, SemanticTypeVar("T")),
	)


private pure func add_resource_builtin_generic_func(
	env: Env,
	name: String,
	type_params: List[String],
	func_type: SemanticType,
	resource_result: ResourceResultPolicy,
) -> Env:
	match env_mint_def_id(env):
		(next_env, def_id):
			env_add_func_with_info(
				next_env,
				name,
				func_symbol(
					def_id,
					func_type,
					type_params.map(func(param): make_bound_type_param(param, [])),
					[],
					builtin_purity(name),
					BuiltinFunc,
					AllowResourceArgs(resource_result),
					None,
					[],
					None,
					False,
				),
			)


private pure func add_builtin_impl(env: Env, trait_name: String, for_type: SemanticType) -> Env:
	match env_mint_def_id(env):
		(next_env, def_id):
			env_add_impl(
				next_env,
				impl_instance(def_id, trait_name, for_type, [], True),
			)


private pure func add_core_builtin_types(env: Env) -> Env:
	var result: Env = env

	for name in [
		"Int",
		"Float",
		"Bool",
		"String",
		"Char",
		"Void",
		"Bytes",
		"Ptr",
		"Fixed",
		"Int8",
		"Int16",
		"Int32",
		"Int128",
		"UInt8",
		"UInt16",
		"UInt32",
		"UInt64",
		"UInt128",
		"Float32",
		"Float16",
	]:
		result = env_add_type(result, name, [], [], TypeBuiltin, False, False)

	result = env_add_type(result, "Tensor", ["T"], [], TypeBuiltin, False, False)
	result = env_add_alias(result, "Int64", [], type_int())
	result = env_add_type(
		result,
		"Option",
		["T"],
		[
			{
				name = "Some",
				fields = [SemanticTypeVar("T")],
				tag = 0
			},
			{
				name = "None",
				fields = [],
				tag = 1
			},
		],
		TypeBuiltin,
		False,
		True,
	)
	result = env_add_type(
		result,
		"Result",
		["T", "E"],
		[
			{
				name = "Ok",
				fields = [SemanticTypeVar("T")],
				tag = 0
			},
			{
				name = "Err",
				fields = [SemanticTypeVar("E")],
				tag = 1
			},
		],
		TypeBuiltin,
		False,
		True,
	)
	result = env_add_type(
		result,
		"ConcurrencyError",
		[],
		[
			{
				name = "Timeout",
				fields = [],
				tag = 0
			},
			{
				name = "TaskFailed",
				fields = [type_string()],
				tag = 1
			},
			{
				name = "Cancelled",
				fields = [],
				tag = 2
			},
		],
		TypeBuiltin,
		False,
		True,
	)
	result = env_add_alias(
		result,
		"TaskResult",
		["T"],
		SemanticNamedType(
			"Result",
			[SemanticTypeVar("T"), SemanticNamedType("ConcurrencyError", [])],
		),
	)
	result


pure func builtin_trait_is_prelude(trait_name: String) -> Bool:
	-- These traits own callable names installed directly into the compiler
	-- prelude below. Source loading may replace their declarations with the
	-- equivalent std/traits definitions, so module ownership is not a stable
	-- way to identify prelude visibility.
	match trait_name:
		"Absolute":
			True
		"Bounded":
			True
		"Equatable":
			True
		"FixedPoint":
			True
		"FloatingPoint":
			True
		"Hashable":
			True
		"HasLength":
			True
		"Integer":
			True
		"Orderable":
			True
		"Stringable":
			True
		"ToBool":
			True
		"ToFloat":
			True
		"ToInt":
			True
		_:
			False


-- Module loading may retain either the canonical std path or the source module
-- name. Keep the accepted prelude-traits identities centralized so indexing
-- and implementation materialization cannot disagree.
pure func prelude_traits_module_matches(
	origin: CompilerModuleOrigin,
	canonical_path: String,
	source_module_name: String,
) -> Bool:
	match origin:
		CompilerStdlibModule:
			(
				canonical_path == PRELUDE_TRAITS_MODULE_PATH
				or canonical_path == PRELUDE_TRAITS_MODULE_NAME
				or source_module_name == PRELUDE_TRAITS_MODULE_PATH
				or source_module_name == PRELUDE_TRAITS_MODULE_NAME
			)
		_:
			False


private pure func builtin_unary_self_method(
	name: String,
	return_type: SemanticType,
) -> TraitMethodSig:
	trait_method_sig(name, [SemanticSelfType], return_type, True)


private pure func builtin_binary_self_method(
	name: String,
	return_type: SemanticType,
) -> TraitMethodSig:
	trait_method_sig(
		name,
		[SemanticSelfType, SemanticSelfType],
		return_type,
		True,
	)


private pure func add_core_builtin_traits(env: Env) -> Env:
	var result: Env = env
	option_self = SemanticNamedType("Option", [SemanticSelfType])
	fixed_type = SemanticNamedType("Fixed", [])

	result = env_add_trait(
		result,
		trait_def(100, "Stringable", [], [builtin_unary_self_method("to_string", type_string())]),
	)
	result = env_add_trait(
		result,
		trait_def(101, "Equatable", [], [builtin_binary_self_method("equals", type_bool())]),
	)
	result = env_add_trait(
		result,
		trait_def(
			102,
			"Orderable",
			["Equatable"],
			[builtin_binary_self_method("less_than", type_bool())],
		),
	)
	result = env_add_trait(
		result,
		trait_def(103, "HasLength", [], [builtin_unary_self_method("length", type_int())]),
	)
	result = env_add_trait(
		result,
		trait_def(
			104,
			"Integer",
			[
				"Addable",
				"Subtractable",
				"Multipliable",
				"Divisible",
				"Modulable",
				"Orderable",
				"HasZero",
				"HasOne",
				"Stringable",
				"Absolute",
				"Bounded",
				"ToInt",
			],
			[
				builtin_binary_self_method("checked_div", option_self),
				builtin_binary_self_method("checked_mod", option_self),
				builtin_binary_self_method("bit_and", SemanticSelfType),
				builtin_binary_self_method("bit_or", SemanticSelfType),
				builtin_binary_self_method("bit_xor", SemanticSelfType),
				builtin_unary_self_method("bit_not", SemanticSelfType),
				trait_method_sig(
					"shift_left",
					[SemanticSelfType, type_int()],
					SemanticSelfType,
					True,
				),
				trait_method_sig(
					"shift_right",
					[SemanticSelfType, type_int()],
					SemanticSelfType,
					True,
				),
			],
		),
	)
	result = env_add_trait(
		result,
		trait_def(
			105,
			"FloatingPoint",
			[
				"Addable",
				"Subtractable",
				"Multipliable",
				"Divisible",
				"Negatable",
				"Orderable",
				"HasZero",
				"HasOne",
				"Stringable",
				"Absolute",
				"Bounded",
				"ToFloat",
			],
			[
				builtin_unary_self_method("floor", SemanticSelfType),
				builtin_unary_self_method("ceil", SemanticSelfType),
				builtin_unary_self_method("round", SemanticSelfType),
				builtin_unary_self_method("trunc", SemanticSelfType),
				builtin_unary_self_method("sqrt", SemanticSelfType),
				builtin_unary_self_method("sin", SemanticSelfType),
				builtin_unary_self_method("cos", SemanticSelfType),
				builtin_unary_self_method("tan", SemanticSelfType),
				builtin_unary_self_method("asin", SemanticSelfType),
				builtin_unary_self_method("acos", SemanticSelfType),
				builtin_unary_self_method("atan", SemanticSelfType),
				builtin_binary_self_method("atan2", SemanticSelfType),
				builtin_unary_self_method("sinh", SemanticSelfType),
				builtin_unary_self_method("cosh", SemanticSelfType),
				builtin_unary_self_method("tanh", SemanticSelfType),
				builtin_unary_self_method("asinh", SemanticSelfType),
				builtin_unary_self_method("acosh", SemanticSelfType),
				builtin_unary_self_method("atanh", SemanticSelfType),
				builtin_unary_self_method("exp", SemanticSelfType),
				builtin_unary_self_method("exp2", SemanticSelfType),
				builtin_unary_self_method("expm1", SemanticSelfType),
				builtin_unary_self_method("log", SemanticSelfType),
				builtin_unary_self_method("log2", SemanticSelfType),
				builtin_unary_self_method("log10", SemanticSelfType),
				builtin_unary_self_method("log1p", SemanticSelfType),
				builtin_binary_self_method("pow", SemanticSelfType),
				builtin_unary_self_method("cbrt", SemanticSelfType),
				builtin_binary_self_method("hypot", SemanticSelfType),
				builtin_binary_self_method("fmod", SemanticSelfType),
				builtin_binary_self_method("copysign", SemanticSelfType),
				trait_method_sig(
					"fma",
					[SemanticSelfType, SemanticSelfType, SemanticSelfType],
					SemanticSelfType,
					True,
				),
				builtin_unary_self_method("is_nan", type_bool()),
				builtin_unary_self_method("is_inf", type_bool()),
				builtin_unary_self_method("is_finite", type_bool()),
			],
		),
	)

	result = env_add_trait(
		result,
		trait_def(106, "Addable", [], [builtin_binary_self_method("add", SemanticSelfType)]),
	)
	result = env_add_trait(
		result,
		trait_def(
			107,
			"Subtractable",
			[],
			[builtin_binary_self_method("subtract", SemanticSelfType)],
		),
	)
	result = env_add_trait(
		result,
		trait_def(
			108,
			"Multipliable",
			[],
			[builtin_binary_self_method("multiply", SemanticSelfType)],
		),
	)
	result = env_add_trait(
		result,
		trait_def(109, "Divisible", [], [builtin_binary_self_method("divide", SemanticSelfType)]),
	)
	result = env_add_trait(
		result,
		trait_def(
			110,
			"Modulable",
			[],
			[builtin_binary_self_method("remainder", SemanticSelfType)],
		),
	)
	result = env_add_trait(
		result,
		trait_def(111, "Negatable", [], [builtin_unary_self_method("negate", SemanticSelfType)]),
	)
	result = env_add_trait(
		result,
		trait_def(112, "HasZero", [], [trait_method_sig("zero", [], SemanticSelfType, True)]),
	)
	result = env_add_trait(
		result,
		trait_def(113, "HasOne", [], [trait_method_sig("one", [], SemanticSelfType, True)]),
	)
	result = env_add_trait(
		result,
		trait_def(114, "Absolute", [], [builtin_unary_self_method("abs", SemanticSelfType)]),
	)
	result = env_add_trait(
		result,
		trait_def(
			115,
			"Bounded",
			[],
			[
				builtin_binary_self_method("min", SemanticSelfType),
				builtin_binary_self_method("max", SemanticSelfType),
			],
		),
	)
	result = env_add_trait(
		result,
		trait_def(116, "Hashable", ["Equatable"], [builtin_unary_self_method("hash", type_int())]),
	)
	result = env_add_trait(
		result,
		trait_def(117, "ToBool", [], [builtin_unary_self_method("to_bool", type_bool())]),
	)
	result = env_add_trait(
		result,
		trait_def(
			118,
			"Logical",
			[],
			[
				builtin_binary_self_method("logical_and", SemanticSelfType),
				builtin_binary_self_method("logical_or", SemanticSelfType),
				builtin_unary_self_method("logical_not", SemanticSelfType),
			],
		),
	)
	result = env_add_trait(
		result,
		trait_def(119, "ToInt", [], [builtin_unary_self_method("to_int", type_int())]),
	)
	result = env_add_trait(
		result,
		trait_def(120, "ToFloat", [], [builtin_unary_self_method("to_float", type_float())]),
	)
	result = env_add_trait(
		result,
		trait_def(121, "ToFixed", [], [builtin_unary_self_method("to_fixed", fixed_type)]),
	)
	result = env_add_trait(
		result,
		trait_def(122, "ToChar", [], [builtin_unary_self_method("to_char", type_char())]),
	)
	result = env_add_trait(
		result,
		trait_def(
			123,
			"SignedInteger",
			["Integer", "Negatable"],
			[],
		),
	)
	result = env_add_trait(
		result,
		trait_def(124, "UnsignedInteger", ["Integer"], []),
	)
	result = env_add_trait(
		result,
		trait_def(
			125,
			"Numeric",
			["Addable", "Multipliable", "HasZero"],
			[],
		),
	)
	result = env_add_trait(
		result,
		trait_def(
			126,
			"FixedPoint",
			[
				"Addable",
				"Subtractable",
				"Multipliable",
				"Divisible",
				"Orderable",
				"HasZero",
				"Stringable",
				"Absolute",
				"Bounded",
			],
			[
				builtin_unary_self_method("get_scale", type_int()),
				trait_method_sig(
					"round_to",
					[SemanticSelfType, type_int()],
					SemanticSelfType,
					True,
				),
			],
		),
	)
	result = env_add_trait(
		result,
		trait_def(127, "Copyable", [], [builtin_unary_self_method("copy", SemanticSelfType)]),
	)
	result = env_add_trait(
		result,
		trait_def(
			128,
			"Cloneable",
			[],
			[trait_method_sig("clone", [SemanticSelfType], SemanticSelfType, False)],
		),
	)

	for name in [
		"checked_div",
		"checked_mod",
		"bit_and",
		"bit_or",
		"bit_xor",
		"bit_not",
		"shift_left",
		"shift_right",
	]:
		result = env_add_trait_function(result, name, "Integer")

	for name in [
		"floor",
		"ceil",
		"round",
		"trunc",
		"sqrt",
		"sin",
		"cos",
		"tan",
		"asin",
		"acos",
		"atan",
		"atan2",
		"sinh",
		"cosh",
		"tanh",
		"asinh",
		"acosh",
		"atanh",
		"exp",
		"exp2",
		"expm1",
		"log",
		"log2",
		"log10",
		"log1p",
		"pow",
		"cbrt",
		"hypot",
		"fmod",
		"copysign",
		"fma",
		"is_nan",
		"is_inf",
		"is_finite",
	]:
		result = env_add_trait_function(result, name, "FloatingPoint")

	result = env_add_trait_function(result, "to_string", "Stringable")
	result = env_add_trait_function(result, "equals", "Equatable")
	result = env_add_trait_function(result, "less_than", "Orderable")
	result = env_add_trait_function(result, "length", "HasLength")
	result = env_add_trait_function(result, "to_bool", "ToBool")
	result = env_add_trait_function(result, "to_int", "ToInt")
	result = env_add_trait_function(result, "to_float", "ToFloat")
	result = env_add_trait_function(result, "abs", "Absolute")
	result = env_add_trait_function(result, "min", "Bounded")
	result = env_add_trait_function(result, "max", "Bounded")
	result = env_add_trait_function(result, "get_scale", "FixedPoint")
	result = env_add_trait_function(result, "round_to", "FixedPoint")
	result = env_add_trait_function(result, "hash", "Hashable")
	result = add_builtin_impl(result, "Integer", type_int())
	result = add_builtin_impl(result, "SignedInteger", type_int())

	for name in ["Int8", "Int16", "Int32", "Int128"]:
		typ = SemanticNamedType(name, [])
		result = add_builtin_impl(result, "Integer", typ)
		result = add_builtin_impl(result, "SignedInteger", typ)

	for name in ["UInt8", "UInt16", "UInt32", "UInt64", "UInt128"]:
		typ = SemanticNamedType(name, [])
		result = add_builtin_impl(result, "Integer", typ)
		result = add_builtin_impl(result, "UnsignedInteger", typ)

	for name in ["Float", "Float32", "Float16"]:
		result = add_builtin_impl(
			result,
			"FloatingPoint",
			SemanticNamedType(name, []),
		)

	result = add_builtin_impl(result, "FixedPoint", fixed_type)
	result = add_builtin_impl(result, "Stringable", type_string())
	result = add_builtin_impl(result, "Equatable", type_string())
	result = add_builtin_impl(result, "Equatable", type_bool())

	for name in [
		"Int",
		"Int8",
		"Int16",
		"Int32",
		"Int64",
		"Int128",
		"UInt8",
		"UInt16",
		"UInt32",
		"UInt64",
		"UInt128",
		"Float",
		"Float32",
		"Float16",
		"Bool",
		"Char",
		"String",
	]:
		result = add_builtin_impl(
			result,
			"Hashable",
			SemanticNamedType(name, []),
		)

	result = add_builtin_impl(result, "Orderable", type_string())
	result = add_builtin_impl(result, "Orderable", type_int())
	result = add_builtin_impl(result, "Orderable", type_float())
	result = add_builtin_impl(result, "Orderable", type_char())
	result


private pure func add_core_builtin_functions(env: Env) -> Env:
	var result: Env = env
	list_of_t: SemanticType = SemanticNamedType("List", [SemanticTypeVar("T")])
	channel_of_t: SemanticType = SemanticNamedType("Channel", [SemanticTypeVar("T")])
	option_of_t: SemanticType = SemanticNamedType("Option", [SemanticTypeVar("T")])
	variadic_tensor_of_t: SemanticType = SemanticArrayType(
		SemanticTypeVar("T"),
		[SemanticVarDimsType("#Ds")],
	)
	char_type: SemanticType = type_char()
	fixed_type: SemanticType = SemanticNamedType("Fixed", [])
	any_type: SemanticType = SemanticNamedType("Any", [])

	result = add_builtin_func(
		result,
		"hash",
		fn_type([any_type], type_int()),
	)
	result = add_builtin_func(
		result,
		"hash_combine",
		fn_type(
			[type_int(), type_int()],
			type_int(),
		),
	)

	result = add_builtin_generic_func(
		result,
		"to_string",
		["T"],
		fn_type([SemanticTypeVar("T")], type_string()),
	)
	result = add_builtin_generic_func(
		result,
		"to_int",
		["T"],
		fn_type([SemanticTypeVar("T")], type_int()),
	)
	result = add_builtin_generic_func(
		result,
		"to_float",
		["T"],
		fn_type([SemanticTypeVar("T")], type_float()),
	)
	result = add_builtin_generic_func(
		result,
		"to_bool",
		["T"],
		fn_type([SemanticTypeVar("T")], type_bool()),
	)
	result = add_builtin_generic_func(
		result,
		"to_char",
		["T"],
		fn_type([SemanticTypeVar("T")], type_char()),
	)
	result = add_builtin_func(
		result,
		"from_char",
		fn_type([char_type], type_string()),
	)
	result = add_builtin_func(
		result,
		"from_chars",
		fn_type([SemanticNamedType("List", [char_type])], type_string()),
	)
	result = add_builtin_func(
		result,
		"fixed",
		fn_type(
			[type_float(), type_int()],
			fixed_type,
		),
	)

	for (name, result_type) in [
		("to_int8", SemanticNamedType("Int8", [])),
		("to_int16", SemanticNamedType("Int16", [])),
		("to_int32", SemanticNamedType("Int32", [])),
		("to_int128", SemanticNamedType("Int128", [])),
		("to_uint8", SemanticNamedType("UInt8", [])),
		("to_uint16", SemanticNamedType("UInt16", [])),
		("to_uint32", SemanticNamedType("UInt32", [])),
		("to_uint64", SemanticNamedType("UInt64", [])),
		("to_uint128", SemanticNamedType("UInt128", [])),
		("to_float16", SemanticNamedType("Float16", [])),
		("to_float32", SemanticNamedType("Float32", [])),
	]:
		result = add_scalar_conversion_builtin(result, name, result_type)

	result = add_builtin_generic_func(
		result,
		"equals",
		["T"],
		fn_type(
			[SemanticTypeVar("T"), SemanticTypeVar("T")],
			type_bool(),
		),
	)
	result = add_builtin_generic_func(
		result,
		"length",
		["T"],
		fn_type([list_of_t], type_int()),
	)
	result = add_builtin_func(
		result,
		"print",
		impure_fn_type([type_string()], type_void()),
	)
	result = add_builtin_func(
		result,
		"sleep",
		impure_fn_type([type_int()], type_void()),
	)
	result = add_builtin_func(
		result,
		"yield_now",
		impure_fn_type([], type_void()),
	)
	result = add_builtin_generic_func(
		result,
		"parallel",
		["T"],
		fn_type([list_of_t], list_of_t),
	)

	for name in ["bit_and", "bit_or", "bit_xor"]:
		result = add_builtin_generic_func(
			result,
			name,
			["T"],
			fn_type(
				[SemanticTypeVar("T"), SemanticTypeVar("T")],
				SemanticTypeVar("T"),
			),
		)

	result = add_builtin_generic_func(
		result,
		"bit_not",
		["T"],
		fn_type([SemanticTypeVar("T")], SemanticTypeVar("T")),
	)

	for name in ["shift_left", "shift_right"]:
		result = add_builtin_generic_func(
			result,
			name,
			["T"],
			fn_type(
				[SemanticTypeVar("T"), type_int()],
				SemanticTypeVar("T"),
			),
		)

	for name in ["checked_div", "checked_mod"]:
		result = add_builtin_func(
			result,
			name,
			fn_type(
				[type_int(), type_int()],
				SemanticNamedType(
					"Option",
					[type_int()],
				),
			),
		)

	result = add_tensor_constructor_builtin(result, "vector", ["#N"])
	result = add_tensor_constructor_builtin(
		result,
		"matrix",
		["#N", "#M"],
	)

	result = add_tensor_constructor_builtin(
		result,
		"tensor3",
		["#X", "#Y", "#Z"],
	)
	result = add_tensor_constructor_builtin(
		result,
		"tensor4",
		["#A", "#B", "#C", "#D"],
	)
	result = add_tensor_constructor_builtin(
		result,
		"tensor5",
		["#A", "#B", "#C", "#D", "#E"],
	)

	result = add_builtin_generic_func(
		result,
		"checked_get",
		["T"],
		fn_type(
			[list_of_t, type_int()],
			SemanticNamedType(
				"Option",
				[SemanticTypeVar("T")],
			),
		),
	)

	result = add_builtin_generic_func(
		result,
		"tensor_peel",
		["T"],
		fn_type(
			[SemanticTypeVar("T"), type_int()],
			SemanticTypeVar("T"),
		),
	)
	result = add_checked_write_builtin(result, "checked_set", 1)
	result = add_builtin_generic_func(
		result,
		"checked_slice",
		["T"],
		fn_type(
			[SemanticTypeVar("T"), type_int(), type_int()],
			SemanticTypeVar("T"),
		),
	)
	result = add_checked_read_builtin(result, "matrix_checked_get", 2)
	result = add_checked_write_builtin(result, "matrix_checked_set", 2)
	result = add_checked_read_builtin(result, "tensor3_checked_get", 3)
	result = add_checked_write_builtin(result, "tensor3_checked_set", 3)
	result = add_checked_read_builtin(result, "tensor4_checked_get", 4)
	result = add_checked_write_builtin(result, "tensor4_checked_set", 4)
	result = add_checked_read_builtin(result, "tensor5_checked_get", 5)
	result = add_checked_write_builtin(result, "tensor5_checked_set", 5)

	result = add_builtin_generic_func(
		result,
		"assert_shape",
		["T"],
		fn_type(
			[variadic_tensor_of_t, type_int()],
			SemanticNamedType(
				"Option",
				[variadic_tensor_of_t],
			),
		),
	)
	result = add_builtin_generic_func(
		result,
		"channel",
		["T"],
		impure_fn_type([type_int()], channel_of_t),
	)
	result = add_resource_builtin_generic_func(
		result,
		"send",
		["T"],
		impure_fn_type(
			[channel_of_t, SemanticTypeVar("T")],
			type_bool(),
		),
		ResourceResultOrdinary,
	)
	result = add_resource_builtin_generic_func(
		result,
		"recv",
		["T"],
		impure_fn_type([channel_of_t], option_of_t),
		ResourceResultDependent,
	)
	result = add_resource_builtin_generic_func(
		result,
		"try_send",
		["T"],
		impure_fn_type(
			[channel_of_t, SemanticTypeVar("T")],
			type_bool(),
		),
		ResourceResultOrdinary,
	)
	result = add_resource_builtin_generic_func(
		result,
		"try_recv",
		["T"],
		impure_fn_type([channel_of_t], option_of_t),
		ResourceResultDependent,
	)
	result = add_resource_builtin_generic_func(
		result,
		"recv_timeout",
		["T"],
		impure_fn_type(
			[channel_of_t, type_int()],
			option_of_t,
		),
		ResourceResultDependent,
	)
	result = add_resource_builtin_generic_func(
		result,
		"send_timeout",
		["T"],
		impure_fn_type(
			[channel_of_t, SemanticTypeVar("T"), type_int()],
			type_bool(),
		),
		ResourceResultOrdinary,
	)
	result = add_resource_builtin_generic_func(
		result,
		"seal",
		["T"],
		impure_fn_type([channel_of_t], type_void()),
		ResourceResultOrdinary,
	)
	result = add_builtin_func(
		result,
		"max_threads",
		fn_type([], type_int()),
	)

	matrix_of_t: SemanticType = SemanticArrayType(
		SemanticTypeVar("T"),
		[SemanticTypeVar("#M"), SemanticTypeVar("#N")],
	)
	result = add_loop_producer_builtin(
		result,
		"enumerate2",
		["T", "#M", "#N"],
		fn_type(
			[matrix_of_t],
			SemanticNamedType(
				"List",
				[SemanticTupleType([type_int(), type_int(), SemanticTypeVar("T")])],
			),
		),
		LoopProducerEnumerate2,
	)
	result = add_builtin_generic_func(
		result,
		"zip",
		["T", "U", "#N"],
		fn_type(
			[
				SemanticArrayType(SemanticTypeVar("T"), [SemanticTypeVar("#N")]),
				SemanticArrayType(SemanticTypeVar("U"), [SemanticTypeVar("#N")]),
			],
			SemanticArrayType(
				SemanticTupleType([SemanticTypeVar("T"), SemanticTypeVar("U")]),
				[SemanticTypeVar("#N")],
			),
		),
	)

	add_loop_producer_builtin(
		result,
		"windows",
		["T"],
		fn_type(
			[list_of_t, type_int()],
			list_of_t,
		),
		LoopProducerWindows,
	)


pure func env_with_builtins(env: Env) -> Env:
	env
		.add_core_builtin_types()
		.add_core_builtin_traits()
		.add_core_builtin_functions()
