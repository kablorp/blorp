import:
	compiler_env:
		CompilerEnv,
		CompilerFuncOrigin(CompilerBuiltinFunc),
		CompilerLoopProducer(
			CompilerLoopProducerEnumerate2,
			CompilerLoopProducerIndices,
			CompilerLoopProducerWindows,
		),
		CompilerPurity(CompilerImpure, CompilerPure),
		CompilerResourceArgPolicy(CompilerAllowResourceArgs, CompilerRejectResourceArgs),
		CompilerResourceResultPolicy(
			CompilerResourceResultDependent,
			CompilerResourceResultOrdinary,
		),
		CompilerTraitMethodSig,
		CompilerTypeKind(CompilerTypeBuiltin),
		compiler_env_add_alias,
		compiler_env_add_func_with_info,
		compiler_env_add_impl,
		compiler_env_add_trait,
		compiler_env_add_trait_function,
		compiler_env_add_type,
		compiler_env_mint_def_id,
		compiler_func_symbol,
		compiler_impl_instance,
		compiler_trait_def,
		compiler_trait_method_sig,
	compiler_generic_params: compiler_make_bound_type_param
	compiler_type:
		CompilerType(
			CompilerArrayType,
			CompilerFunctionType,
			CompilerNamedType,
			CompilerSelfType,
			CompilerTupleType,
			CompilerTypeVar,
		),
		compiler_type_bool,
		compiler_type_char,
		compiler_type_float,
		compiler_type_int,
		compiler_type_string,
		compiler_type_void,


enum CompilerBuiltinEffect:
	CompilerBuiltinImpure
	CompilerBuiltinParallelBoundary
	CompilerBuiltinCancellationPoint
	CompilerBuiltinFiberParking
	CompilerBuiltinOsWorkerBlocking


enum CompilerRuntimeEffect:
	CompilerPureMetadata
	CompilerImpureNonWaiting
	CompilerCancellationCheckpoint
	CompilerFiberParkingWait
	CompilerOsWorkerBlockingWait


union CompilerSpecialInference:
	CompilerCheckedGetInference
	CompilerCheckedSetInference
	CompilerCheckedSliceInference
	CompilerMatrixCheckedGetInference
	CompilerMatrixCheckedSetInference
	CompilerTensorCheckedGetInference(Int)
	CompilerTensorCheckedSetInference(Int)
	CompilerAssertShapeInference
	CompilerLengthRefinedInference
	CompilerTypeNameInference
	CompilerIsHeapInference
	CompilerVectorCtorInference
	CompilerMatrixCtorInference
	CompilerTensorCtorInference(Int)
	CompilerBitwiseInference


record CompilerBuiltinDescriptor {
	name: String,
	runtime_effect: CompilerRuntimeEffect,
	parallel_boundary: Bool,
	special_inference: Option[CompilerSpecialInference]
}


private pure func compiler_impure_descriptor(name: String) -> CompilerBuiltinDescriptor:
	{
		name = name,
		runtime_effect = CompilerImpureNonWaiting,
		parallel_boundary = False,
		special_inference = None
	}


private pure func compiler_cancellation_descriptor(name: String) -> CompilerBuiltinDescriptor:
	{
		name = name,
		runtime_effect = CompilerCancellationCheckpoint,
		parallel_boundary = False,
		special_inference = None
	}


private pure func compiler_fiber_parking_descriptor(name: String) -> CompilerBuiltinDescriptor:
	{
		name = name,
		runtime_effect = CompilerFiberParkingWait,
		parallel_boundary = False,
		special_inference = None
	}


private pure func compiler_os_worker_blocking_descriptor(name: String) -> CompilerBuiltinDescriptor:
	{
		name = name,
		runtime_effect = CompilerOsWorkerBlockingWait,
		parallel_boundary = False,
		special_inference = None
	}


private pure func compiler_parallel_boundary_descriptor(name: String) -> CompilerBuiltinDescriptor:
	{
		name = name,
		runtime_effect = CompilerPureMetadata,
		parallel_boundary = True,
		special_inference = None
	}


private pure func compiler_special_descriptor(
	name: String,
	special_inference: CompilerSpecialInference,
) -> CompilerBuiltinDescriptor:
	{
		name = name,
		runtime_effect = CompilerPureMetadata,
		parallel_boundary = False,
		special_inference = Some(special_inference)
	}


