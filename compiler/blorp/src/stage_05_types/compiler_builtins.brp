enum CompilerBuiltinEffect:
	CompilerBuiltinImpure
	CompilerBuiltinParallelBoundary
	CompilerBuiltinCancellationPoint
	CompilerBuiltinFiberParking
	CompilerBuiltinOsWorkerBlocking


private COMPILER_PRELUDE_TRAITS_MODULE_PATH: String = "std/traits"

private COMPILER_PRELUDE_TRAITS_MODULE_NAME: String = "traits"


private enum CompilerRuntimeEffect:
	CompilerNoRuntimeEffect
	CompilerImpureNonWaiting
	CompilerCancellationCheckpoint
	CompilerFiberParkingWait
	CompilerOsWorkerBlockingWait


union CompilerSpecialInference:
	CompilerCheckedGetInference
	CompilerCheckedSetInference
	CompilerCheckedSliceInference
	CompilerMatrixCheckedGetInference
	CompilerMatrixCheckedSetInference
	CompilerTensorCheckedGetInference(Int)
	CompilerTensorCheckedSetInference(Int)
	CompilerAssertShapeInference
	CompilerLengthRefinedInference
	CompilerTypeNameInference
	CompilerIsHeapInference
	CompilerVectorCtorInference
	CompilerMatrixCtorInference
	CompilerTensorCtorInference(Int)
	CompilerBitwiseInference


pure func compiler_builtin_is_elementwise_tensor_function(name: String) -> Bool:
	["sqrt", "abs", "exp", "log"].contains(name)


-- Resource-producing builtins borrow their resource argument by default. Keep
-- the exceptional ownership contracts beside the other builtin metadata.
pure func compiler_builtin_resource_result_policy(name: String) -> CompilerResourceResultPolicy:
	match name:
		"blorp_tcp_accept_raw":
			CompilerResourceResultIndependent
		_:
			CompilerResourceResultDependent


