import:
	compiler_env:
		CompilerEnv,
		compiler_env_disambiguate_nominal_dim_application,
		compiler_env_resolve_alias,
	compiler_type:
		CompilerType(
			CompilerArrayType,
			CompilerConstIntType,
			CompilerDimOpType,
			CompilerFunctionType,
			CompilerMetaType,
			CompilerNamedType,
			CompilerRangeType,
			CompilerSelfType,
			CompilerTupleType,
			CompilerTypeVar,
			CompilerVarDimsType,
		),
		compiler_canonical_module_type_name,


enum AliasPolicy:
	ExpandAliases
	PreserveAliasSource


record TypeResolutionContext {
	env: CompilerEnv,
	module_aliases: List[(String, String)],
	alias_policy: AliasPolicy
}


record ResolvedType {
	source: CompilerType,
	canonical: CompilerType
}


pure func type_resolution_context(
	env: CompilerEnv,
	module_aliases: List[(String, String)],
) -> TypeResolutionContext:
	{
		env = env,
		module_aliases = module_aliases,
		alias_policy = ExpandAliases
	}


pure func type_resolution_context_with_alias_policy(
	env: CompilerEnv,
	module_aliases: List[(String, String)],
	alias_policy: AliasPolicy,
) -> TypeResolutionContext:
	{
		env = env,
		module_aliases = module_aliases,
		alias_policy = alias_policy
	}


private pure func find_module_alias(
	module_aliases: List[(String, String)],
	alias_name: String,
) -> Option[String]:
	var result: Option[String] = None

	for pair in module_aliases:
		if pair[0] == alias_name:
			result = Some(pair[1])
			break

	result


private pure func resolve_qualified_type_name_if_changed(
	module_aliases: List[(String, String)],
	name: String,
) -> Option[String]:
	dot_index: Int = name.raw_index_of(".")

	if dot_index < 0:
		None
	else:
		alias_name: String = name.substring(0, dot_index)
		local_name: String = name.substring(dot_index + 1, name.length() - dot_index - 1)

		match find_module_alias(module_aliases, alias_name):
			Some(module_path):
				Some(compiler_canonical_module_type_name(module_path, local_name))
			None:
				None


-- List.set clones shared storage on the first changed element, then updates
-- that unique list in place. A fully unchanged list retains its original tree.
private pure func resolve_qualified_type_list_if_changed(
	module_aliases: List[(String, String)],
	types: List[CompilerType],
) -> Option[List[CompilerType]]:
	var resolved: List[CompilerType] = types
	var changed: Bool = False
	var index: Int = 0

	for typ in types:
		match resolve_qualified_type_names_if_changed(module_aliases, typ):
			Some(resolved_type):
				resolved = resolved.set(index, resolved_type)
				changed = True
			None:
				void

		index += 1

	if changed:
		Some(resolved)
	else:
		None


private pure func resolve_qualified_type_names_if_changed(
	module_aliases: List[(String, String)],
	typ: CompilerType,
) -> Option[CompilerType]:
	match typ:
		CompilerNamedType(name, args):
			name_result = resolve_qualified_type_name_if_changed(module_aliases, name)
			args_result = resolve_qualified_type_list_if_changed(module_aliases, args)

			if name_result.is_some() or args_result.is_some():
				Some(CompilerNamedType(name_result.get_or(name), args_result.get_or(args)))
			else:
				None
		CompilerArrayType(element, dims):
			element_result = resolve_qualified_type_names_if_changed(module_aliases, element)
			dims_result = resolve_qualified_type_list_if_changed(module_aliases, dims)

			if element_result.is_some() or dims_result.is_some():
				Some(CompilerArrayType(element_result.get_or(element), dims_result.get_or(dims)))
			else:
				None
		CompilerFunctionType(is_pure, params, return_type):
			params_result = resolve_qualified_type_list_if_changed(module_aliases, params)
			return_result = resolve_qualified_type_names_if_changed(module_aliases, return_type)

			if params_result.is_some() or return_result.is_some():
				Some(
					CompilerFunctionType(
						is_pure,
						params_result.get_or(params),
						return_result.get_or(return_type),
					),
				)
			else:
				None
		CompilerTupleType(elements):
			match resolve_qualified_type_list_if_changed(module_aliases, elements):
				Some(resolved_elements):
					Some(CompilerTupleType(resolved_elements))
				None:
					None
		CompilerRangeType(inner):
			match resolve_qualified_type_names_if_changed(module_aliases, inner):
				Some(resolved_inner):
					Some(CompilerRangeType(resolved_inner))
				None:
					None
		CompilerDimOpType(op, left, right):
			left_result = resolve_qualified_type_names_if_changed(module_aliases, left)
			right_result = resolve_qualified_type_names_if_changed(module_aliases, right)

			if left_result.is_some() or right_result.is_some():
				Some(CompilerDimOpType(op, left_result.get_or(left), right_result.get_or(right)))
			else:
				None
		CompilerTypeVar(_):
			None
		CompilerConstIntType(_):
			None
		CompilerSelfType:
			None
		CompilerVarDimsType(_):
			None
		CompilerMetaType(_):
			None


pure func resolve_qualified_type_names(
	module_aliases: List[(String, String)],
	typ: CompilerType,
) -> CompilerType:
	if module_aliases.is_empty():
		typ
	else:
		match resolve_qualified_type_names_if_changed(module_aliases, typ):
			Some(resolved):
				resolved
			None:
				typ


private pure func apply_alias_policy(
	context: TypeResolutionContext,
	typ: CompilerType,
) -> CompilerType:
	match context.alias_policy:
		ExpandAliases:
			compiler_env_resolve_alias(context.env, typ)
		PreserveAliasSource:
			typ


private pure func identity_type(typ: CompilerType) -> CompilerType:
	typ


pure func resolve_type(
	context: TypeResolutionContext,
	source: CompilerType,
	qualify_owner: pure (CompilerType) -> CompilerType,
) -> ResolvedType:
	qualified: CompilerType = resolve_qualified_type_names(context.module_aliases, source)
	owned: CompilerType = qualify_owner(qualified)
	nominal: CompilerType = compiler_env_disambiguate_nominal_dim_application(context.env, owned)
	aliased: CompilerType = apply_alias_policy(context, nominal)
	canonical: CompilerType = resolve_qualified_type_names(context.module_aliases, aliased)

	{
		source = source,
		canonical = canonical
	}


pure func resolve_type_default(
	context: TypeResolutionContext,
	source: CompilerType,
) -> ResolvedType:
	resolve_type(context, source, identity_type)


pure func resolved_type_source(resolved: ResolvedType) -> CompilerType:
	resolved.source


pure func resolved_type_canonical(resolved: ResolvedType) -> CompilerType:
	resolved.canonical


pure func annotation(context: TypeResolutionContext, source: CompilerType) -> ResolvedType:
	resolve_type_default(context, source)


pure func value_ascription(context: TypeResolutionContext, source: CompilerType) -> ResolvedType:
	resolve_type_default(context, source)


pure func local_binding_annotation(
	context: TypeResolutionContext,
	source: CompilerType,
) -> ResolvedType:
	resolve_type_default(context, source)


pure func function_parameter_annotation(
	context: TypeResolutionContext,
	source: CompilerType,
	qualify_owner: pure (CompilerType) -> CompilerType,
) -> ResolvedType:
	resolve_type(context, source, qualify_owner)


pure func function_return_annotation(
	context: TypeResolutionContext,
	source: CompilerType,
	qualify_owner: pure (CompilerType) -> CompilerType,
) -> ResolvedType:
	resolve_type(context, source, qualify_owner)


pure func imported_signature(context: TypeResolutionContext, source: CompilerType) -> ResolvedType:
	resolve_type_default(context, source)


pure func imported_signature_canonical(
	context: TypeResolutionContext,
	source: CompilerType,
) -> CompilerType:
	imported_signature(context, source).canonical


pure func record_field_type(context: TypeResolutionContext, source: CompilerType) -> ResolvedType:
	resolve_type_default(context, source)


pure func record_field_type_canonical(
	context: TypeResolutionContext,
	source: CompilerType,
) -> CompilerType:
	record_field_type(context, source).canonical


pure func variant_field_type(context: TypeResolutionContext, source: CompilerType) -> ResolvedType:
	resolve_type_default(context, source)


pure func type_alias_target(context: TypeResolutionContext, source: CompilerType) -> ResolvedType:
	resolve_type_default(context, source)
