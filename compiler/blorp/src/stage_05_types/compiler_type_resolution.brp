import:
	compiler_env:
		CompilerEnv,
		compiler_env_disambiguate_nominal_dim_application,
		compiler_env_resolve_alias,
	compiler_type:
		CompilerType(
			CompilerArrayType,
			CompilerConstIntType,
			CompilerDimOpType,
			CompilerFunctionType,
			CompilerMetaType,
			CompilerNamedType,
			CompilerRangeType,
			CompilerSelfType,
			CompilerTupleType,
			CompilerTypeVar,
			CompilerVarDimsType,
		),
		compiler_canonical_module_type_name,


enum CompilerAliasPolicy:
	CompilerExpandAliases
	CompilerPreserveAliasSource


record CompilerTypeResolutionContext {
	env: CompilerEnv,
	module_aliases: List[(String, String)],
	alias_policy: CompilerAliasPolicy
}


record CompilerResolvedType {
	source: CompilerType,
	canonical: CompilerType
}


pure func compiler_type_resolution_context(
	env: CompilerEnv,
	module_aliases: List[(String, String)],
) -> CompilerTypeResolutionContext:
	{
		env = env,
		module_aliases = module_aliases,
		alias_policy = CompilerExpandAliases
	}


pure func compiler_type_resolution_context_with_alias_policy(
	env: CompilerEnv,
	module_aliases: List[(String, String)],
	alias_policy: CompilerAliasPolicy,
) -> CompilerTypeResolutionContext:
	{
		env = env,
		module_aliases = module_aliases,
		alias_policy = alias_policy
	}


private pure func compiler_find_module_alias(
	module_aliases: List[(String, String)],
	alias_name: String,
) -> Option[String]:
	var result: Option[String] = None

	for pair in module_aliases:
		if pair[0] == alias_name:
			result = Some(pair[1])
			break

	result


private pure func compiler_resolve_qualified_type_name_if_changed(
	module_aliases: List[(String, String)],
	name: String,
) -> Option[String]:
	dot_index: Int = name.raw_index_of(".")

	if dot_index < 0:
		None
	else:
		alias_name: String = name.substring(0, dot_index)
		local_name: String = name.substring(dot_index + 1, name.length() - dot_index - 1)

		match compiler_find_module_alias(module_aliases, alias_name):
			Some(module_path):
				Some(compiler_canonical_module_type_name(module_path, local_name))
			None:
				None


-- List.set clones shared storage on the first changed element, then updates
-- that unique list in place. A fully unchanged list retains its original tree.
private pure func compiler_resolve_qualified_type_list_if_changed(
	module_aliases: List[(String, String)],
	types: List[CompilerType],
) -> Option[List[CompilerType]]:
	var resolved: List[CompilerType] = types
	var changed: Bool = False
	var index: Int = 0

	for typ in types:
		match compiler_resolve_qualified_type_names_if_changed(module_aliases, typ):
			Some(resolved_type):
				resolved = resolved.set(index, resolved_type)
				changed = True
			None:
				void

		index += 1

	if changed:
		Some(resolved)
	else:
		None


private pure func compiler_resolve_qualified_type_names_if_changed(
	module_aliases: List[(String, String)],
	typ: CompilerType,
) -> Option[CompilerType]:
	match typ:
		CompilerNamedType(name, args):
			name_result = compiler_resolve_qualified_type_name_if_changed(module_aliases, name)
			args_result = compiler_resolve_qualified_type_list_if_changed(module_aliases, args)

			if name_result.is_some() or args_result.is_some():
				Some(CompilerNamedType(name_result.get_or(name), args_result.get_or(args)))
			else:
				None
		CompilerArrayType(element, dims):
			element_result = compiler_resolve_qualified_type_names_if_changed(
				module_aliases,
				element,
			)
			dims_result = compiler_resolve_qualified_type_list_if_changed(module_aliases, dims)

			if element_result.is_some() or dims_result.is_some():
				Some(CompilerArrayType(element_result.get_or(element), dims_result.get_or(dims)))
			else:
				None
		CompilerFunctionType(is_pure, params, return_type):
			params_result = compiler_resolve_qualified_type_list_if_changed(module_aliases, params)
			return_result = compiler_resolve_qualified_type_names_if_changed(
				module_aliases,
				return_type,
			)

			if params_result.is_some() or return_result.is_some():
				Some(
					CompilerFunctionType(
						is_pure,
						params_result.get_or(params),
						return_result.get_or(return_type),
					),
				)
			else:
				None
		CompilerTupleType(elements):
			match compiler_resolve_qualified_type_list_if_changed(module_aliases, elements):
				Some(resolved_elements):
					Some(CompilerTupleType(resolved_elements))
				None:
					None
		CompilerRangeType(inner):
			match compiler_resolve_qualified_type_names_if_changed(module_aliases, inner):
				Some(resolved_inner):
					Some(CompilerRangeType(resolved_inner))
				None:
					None
		CompilerDimOpType(op, left, right):
			left_result = compiler_resolve_qualified_type_names_if_changed(module_aliases, left)
			right_result = compiler_resolve_qualified_type_names_if_changed(module_aliases, right)

			if left_result.is_some() or right_result.is_some():
				Some(CompilerDimOpType(op, left_result.get_or(left), right_result.get_or(right)))
			else:
				None
		CompilerTypeVar(_):
			None
		CompilerConstIntType(_):
			None
		CompilerSelfType:
			None
		CompilerVarDimsType(_):
			None
		CompilerMetaType(_):
			None


pure func compiler_resolve_qualified_type_names(
	module_aliases: List[(String, String)],
	typ: CompilerType,
) -> CompilerType:
	if module_aliases.is_empty():
		typ
	else:
		match compiler_resolve_qualified_type_names_if_changed(module_aliases, typ):
			Some(resolved):
				resolved
			None:
				typ


private pure func compiler_apply_alias_policy(
	context: CompilerTypeResolutionContext,
	typ: CompilerType,
) -> CompilerType:
	match context.alias_policy:
		CompilerExpandAliases:
			compiler_env_resolve_alias(context.env, typ)
		CompilerPreserveAliasSource:
			typ


private pure func compiler_identity_type(typ: CompilerType) -> CompilerType:
	typ


pure func compiler_resolve_type(
	context: CompilerTypeResolutionContext,
	source: CompilerType,
	qualify_owner: pure (CompilerType) -> CompilerType,
) -> CompilerResolvedType:
	qualified: CompilerType = compiler_resolve_qualified_type_names(context.module_aliases, source)
	owned: CompilerType = qualify_owner(qualified)
	nominal: CompilerType = compiler_env_disambiguate_nominal_dim_application(context.env, owned)
	aliased: CompilerType = compiler_apply_alias_policy(context, nominal)
	canonical: CompilerType = compiler_resolve_qualified_type_names(context.module_aliases, aliased)

	{
		source = source,
		canonical = canonical
	}


pure func compiler_resolve_type_default(
	context: CompilerTypeResolutionContext,
	source: CompilerType,
) -> CompilerResolvedType:
	compiler_resolve_type(context, source, compiler_identity_type)


pure func compiler_resolved_type_source(resolved: CompilerResolvedType) -> CompilerType:
	resolved.source


pure func compiler_resolved_type_canonical(resolved: CompilerResolvedType) -> CompilerType:
	resolved.canonical


pure func compiler_annotation(
	context: CompilerTypeResolutionContext,
	source: CompilerType,
) -> CompilerResolvedType:
	compiler_resolve_type_default(context, source)


pure func compiler_value_ascription(
	context: CompilerTypeResolutionContext,
	source: CompilerType,
) -> CompilerResolvedType:
	compiler_resolve_type_default(context, source)


pure func compiler_local_binding_annotation(
	context: CompilerTypeResolutionContext,
	source: CompilerType,
) -> CompilerResolvedType:
	compiler_resolve_type_default(context, source)


pure func compiler_function_parameter_annotation(
	context: CompilerTypeResolutionContext,
	source: CompilerType,
	qualify_owner: pure (CompilerType) -> CompilerType,
) -> CompilerResolvedType:
	compiler_resolve_type(context, source, qualify_owner)


pure func compiler_function_return_annotation(
	context: CompilerTypeResolutionContext,
	source: CompilerType,
	qualify_owner: pure (CompilerType) -> CompilerType,
) -> CompilerResolvedType:
	compiler_resolve_type(context, source, qualify_owner)


pure func compiler_imported_signature(
	context: CompilerTypeResolutionContext,
	source: CompilerType,
) -> CompilerResolvedType:
	compiler_resolve_type_default(context, source)


pure func compiler_imported_signature_canonical(
	context: CompilerTypeResolutionContext,
	source: CompilerType,
) -> CompilerType:
	compiler_imported_signature(context, source).canonical


pure func compiler_record_field_type(
	context: CompilerTypeResolutionContext,
	source: CompilerType,
) -> CompilerResolvedType:
	compiler_resolve_type_default(context, source)


pure func compiler_record_field_type_canonical(
	context: CompilerTypeResolutionContext,
	source: CompilerType,
) -> CompilerType:
	compiler_record_field_type(context, source).canonical


pure func compiler_variant_field_type(
	context: CompilerTypeResolutionContext,
	source: CompilerType,
) -> CompilerResolvedType:
	compiler_resolve_type_default(context, source)


pure func compiler_type_alias_target(
	context: CompilerTypeResolutionContext,
	source: CompilerType,
) -> CompilerResolvedType:
	compiler_resolve_type_default(context, source)
