-- JSON projection for frontend SemanticType values.
--
-- Typed-AST handoff needs structured frontend types. Do not serialize these as
-- display strings; downstream phases need to preserve type identity, dimension
-- expressions, purity, and unresolved/meta diagnostics explicitly.
import:
	semantic_type:
		SemanticDimOp(SemanticDimAdd, SemanticDimDivide, SemanticDimMultiply, SemanticDimSubtract),
		SemanticType(
			SemanticArrayType,
			SemanticConstIntType,
			SemanticDimOpType,
			SemanticFunctionType,
			SemanticMetaType,
			SemanticNamedType,
			SemanticRangeType,
			SemanticSelfType,
			SemanticTupleType,
			SemanticTypeVar,
			SemanticVarDimsType,
		),
	json: JsonValue(JsonBool, JsonNull, JsonNumber, JsonObject, JsonString, JsonVector)


private KIND_FIELD: String = "kind"


private pure func json_int(value: Int) -> JsonValue:
	JsonNumber(to_float(value))


private pure func const_int_type_to_json(value: Int) -> JsonValue:
	-- Decimal text preserves Blorp's full Int range across JSON implementations
	-- that otherwise route numbers through an imprecise floating representation.
	JsonObject([
		(KIND_FIELD, JsonString("const_int")),
		("value", JsonString(value.to_string())),
	])


pure func dim_op_to_json(op: SemanticDimOp) -> JsonValue:
	match op:
		SemanticDimAdd:
			JsonString("add")
		SemanticDimSubtract:
			JsonString("subtract")
		SemanticDimMultiply:
			JsonString("multiply")
		SemanticDimDivide:
			JsonString("divide")


pure func type_list_to_json(types: List[SemanticType]) -> JsonValue:
	JsonVector(types.map(type_to_json))


pure func optional_type_to_json(typ: Option[SemanticType]) -> JsonValue:
	match typ:
		Some(value):
			type_to_json(value)
		None:
			JsonNull


pure func type_to_json(typ: SemanticType) -> JsonValue:
	match typ:
		SemanticNamedType(name, args):
			JsonObject([
				(KIND_FIELD, JsonString("named")),
				("name", JsonString(name)),
				("args", type_list_to_json(args)),
			])
		SemanticArrayType(element, dims):
			JsonObject([
				(KIND_FIELD, JsonString("array")),
				("element", type_to_json(element)),
				("dims", type_list_to_json(dims)),
			])
		SemanticFunctionType(is_pure, params, return_type):
			JsonObject([
				(KIND_FIELD, JsonString("function")),
				("pure", JsonBool(is_pure)),
				("params", type_list_to_json(params)),
				("return_type", type_to_json(return_type)),
			])
		SemanticTypeVar(name):
			JsonObject([
				(KIND_FIELD, JsonString("type_var")),
				("name", JsonString(name)),
			])
		SemanticConstIntType(value):
			const_int_type_to_json(value)
		SemanticTupleType(items):
			JsonObject([
				(KIND_FIELD, JsonString("tuple")),
				("items", type_list_to_json(items)),
			])
		SemanticSelfType:
			JsonObject([(KIND_FIELD, JsonString("self"))])
		SemanticVarDimsType(name):
			JsonObject([
				(KIND_FIELD, JsonString("var_dims")),
				("name", JsonString(name)),
			])
		SemanticRangeType(inner):
			JsonObject([
				(KIND_FIELD, JsonString("range")),
				("inner", type_to_json(inner)),
			])
		SemanticDimOpType(op, left, right):
			JsonObject([
				(KIND_FIELD, JsonString("dim_op")),
				("op", dim_op_to_json(op)),
				("left", type_to_json(left)),
				("right", type_to_json(right)),
			])
		SemanticMetaType(meta_id):
			JsonObject([
				(KIND_FIELD, JsonString("meta")),
				("id", json_int(meta_id)),
			])
