-- Range/subscript proof metadata for the Blorp-owned frontend.
--
-- These types keep proof facts explicit and separate from ordinary type data.
-- Inference can attach the facts to binding or expression metadata without
-- relying on ambient proof-env lookups after the fact.
import:
	string: string


-- Proof identities are zero-cost opaque types so collection and dimension
-- namespaces cannot be mixed after validation.
opaque type CollectionIdentity = String

opaque type DimensionIdentity = String


pure func collection_identity_name(identity: CollectionIdentity) -> String:
	from CollectionIdentity(identity)


pure func dimension_identity_name(identity: DimensionIdentity) -> String:
	from DimensionIdentity(identity)


implements Equatable for CollectionIdentity:
	pure func equals(left: CollectionIdentity, right: CollectionIdentity) -> Bool:
		collection_identity_name(left) == collection_identity_name(right)


implements Equatable for DimensionIdentity:
	pure func equals(left: DimensionIdentity, right: DimensionIdentity) -> Bool:
		dimension_identity_name(left) == dimension_identity_name(right)


union ProvenCollection:
	CollVar(CollectionIdentity)
	CollSubscript(ProvenCollection, CollectionIdentity)
	CollDim(Int)


union RangeUpper:
	RangeUpperLit(Int)
	RangeUpperDimension(DimensionIdentity)
	RangeUpperLengthMinus(CollectionIdentity, Int)
	RangeUpperAtMostLength(CollectionIdentity)


enum ProofSource:
	ProofSourceUnknown
	ProofSourceLoopRange
	ProofSourceLoopIndices
	ProofSourceLoopEnumerate
	ProofSourceCondition
	ProofSourceRangeTypeFallback


record RangeProof {
	range_start: Int,
	range_upper: RangeUpper,
	range_source: ProofSource
}


record SubscriptProof {
	subscript_collection: ProvenCollection,
	subscript_source: ProofSource
}


union ValueProofs:
	NoValueProofs
	RangeValueProofs(RangeProof)
	SubscriptValueProofs(SubscriptProof)
	RangeAndSubscriptValueProofs(RangeProof, SubscriptProof)


union SubscriptBound:
	ConstantDim(Int)
	DimensionBound(DimensionIdentity)
	CollectionLength(CollectionIdentity)


record SubscriptBounds {
	constant_dims: List[Int],
	dimension_bounds: List[DimensionIdentity],
	collection_lengths: List[CollectionIdentity]
}


union OffsetRejection:
	OffsetNoMatchingBound
	OffsetOutOfBounds(String)


union OffsetSubscriptProof:
	OffsetProven
	OffsetRejected(OffsetRejection)


record IndexSpan {
	min_index: Int,
	max_index: Int
}


record ProofEnv {
	subscript_proofs: List[(CollectionIdentity, SubscriptProof)],
	range_proofs: List[(CollectionIdentity, RangeProof)]
}


union NarrowedSubject:
	NarrowedBinding(CollectionIdentity)
	NarrowedAlias(CollectionIdentity, CollectionIdentity)


union BranchSubject:
	ImmutableSubject(NarrowedSubject)
	MutableSubject(CollectionIdentity)


record BranchRangeProof {
	subject: NarrowedSubject,
	proof: RangeProof
}


enum BranchProofRejection:
	MutableSubjectCannotNarrow
	InvalidRangeBounds


pure func proof_sources_equal(left: ProofSource, right: ProofSource) -> Bool:
	match left:
		ProofSourceUnknown:
			match right:
				ProofSourceUnknown:
					True
				_:
					False
		ProofSourceLoopRange:
			match right:
				ProofSourceLoopRange:
					True
				_:
					False
		ProofSourceLoopIndices:
			match right:
				ProofSourceLoopIndices:
					True
				_:
					False
		ProofSourceLoopEnumerate:
			match right:
				ProofSourceLoopEnumerate:
					True
				_:
					False
		ProofSourceCondition:
			match right:
				ProofSourceCondition:
					True
				_:
					False
		ProofSourceRangeTypeFallback:
			match right:
				ProofSourceRangeTypeFallback:
					True
				_:
					False


pure func proven_collections_equal(left: ProvenCollection, right: ProvenCollection) -> Bool:
	match left:
		CollVar(left_id):
			match right:
				CollVar(right_id):
					left_id == right_id
				_:
					False
		CollSubscript(left_collection, left_index):
			match right:
				CollSubscript(right_collection, right_index):
					(
						left_index == right_index
						and proven_collections_equal(left_collection, right_collection)
					)
				_:
					False
		CollDim(left_dim):
			match right:
				CollDim(right_dim):
					left_dim == right_dim
				_:
					False


private pure func valid_identity(name: String) -> Bool:
	name.trim() == name and name.length() > 0


private pure func is_dim_var_name(name: String) -> Bool:
	name.length() > 0 and name.get_or(0, ' ') == '#'


pure func collection_identity(name: String) -> Option[CollectionIdentity]:
	if valid_identity(name):
		Some(into CollectionIdentity(name))
	else:
		None


pure func dimension_identity(name: String) -> Option[DimensionIdentity]:
	if is_dim_var_name(name):
		Some(into DimensionIdentity(name))
	else:
		None


pure func collection_var(identity: CollectionIdentity) -> ProvenCollection:
	CollVar(identity)


pure func collection_subscript(
	collection: ProvenCollection,
	index: CollectionIdentity,
) -> ProvenCollection:
	CollSubscript(collection, index)


pure func collection_dim(dim: Int) -> Option[ProvenCollection]:
	if dim < 0:
		None
	else:
		Some(CollDim(dim))


pure func direct_collection_var(collection: ProvenCollection) -> Option[CollectionIdentity]:
	match collection:
		CollVar(identity):
			Some(identity)
		_:
			None


pure func collection_dim_at_most(collection: ProvenCollection, size: Int) -> Bool:
	match collection:
		CollDim(dim):
			size >= 0 and dim <= size
		_:
			False


pure func range_upper_lit(upper: Int) -> Option[RangeUpper]:
	if upper < 0:
		None
	else:
		Some(RangeUpperLit(upper))


pure func range_upper_dimension(dim: DimensionIdentity) -> RangeUpper:
	RangeUpperDimension(dim)


pure func range_upper_length_minus(coll: CollectionIdentity, end_offset: Int) -> Option[RangeUpper]:
	if end_offset < 0:
		None
	else:
		Some(RangeUpperLengthMinus(coll, end_offset))


pure func range_upper_at_most_length(coll: CollectionIdentity) -> RangeUpper:
	RangeUpperAtMostLength(coll)


private pure func valid_upper(range_start: Int, upper: RangeUpper) -> Bool:
	match upper:
		RangeUpperLit(value):
			value >= 0 and value >= range_start
		RangeUpperDimension(_):
			range_start >= 0
		RangeUpperLengthMinus(_, end_offset):
			end_offset >= 0
		RangeUpperAtMostLength(_):
			True


pure func make_range_proof_with_source(
	range_start: Int,
	range_upper: RangeUpper,
	source: ProofSource,
) -> Option[RangeProof]:
	if range_start < 0 or not valid_upper(range_start, range_upper):
		None
	else:
		Some({
			range_start = range_start,
			range_upper = range_upper,
			range_source = source,
		})


pure func make_range_proof(range_start: Int, range_upper: RangeUpper) -> Option[RangeProof]:
	make_range_proof_with_source(range_start, range_upper, ProofSourceUnknown)


pure func range_proof_source(proof: RangeProof) -> ProofSource:
	proof.range_source


pure func make_subscript_proof(collection: ProvenCollection, source: ProofSource) -> SubscriptProof:
	{
		subscript_collection = collection,
		subscript_source = source
	}


pure func subscript_proof_collection(proof: SubscriptProof) -> ProvenCollection:
	proof.subscript_collection


pure func subscript_proof_source(proof: SubscriptProof) -> ProofSource:
	proof.subscript_source


pure func no_proofs() -> ValueProofs:
	NoValueProofs


pure func unrefined_binding() -> ValueProofs:
	no_proofs()


pure func unproven_expr() -> ValueProofs:
	no_proofs()


pure func expr_proofs_of_binding(binding: ValueProofs) -> ValueProofs:
	binding


pure func binding_refinement_of_expr_proofs(proofs: ValueProofs) -> ValueProofs:
	proofs


pure func range_binding(proof: RangeProof) -> ValueProofs:
	RangeValueProofs(proof)


pure func binding_add_range_proof(binding: ValueProofs, proof: RangeProof) -> ValueProofs:
	match binding:
		NoValueProofs:
			RangeValueProofs(proof)
		RangeValueProofs(_):
			RangeValueProofs(proof)
		SubscriptValueProofs(subscript):
			RangeAndSubscriptValueProofs(proof, subscript)
		RangeAndSubscriptValueProofs(_, subscript):
			RangeAndSubscriptValueProofs(proof, subscript)


pure func binding_add_subscript_proof(
	binding: ValueProofs,
	collection: ProvenCollection,
	source: ProofSource,
) -> ValueProofs:
	proof = make_subscript_proof(collection, source)

	match binding:
		NoValueProofs:
			SubscriptValueProofs(proof)
		RangeValueProofs(range):
			RangeAndSubscriptValueProofs(range, proof)
		SubscriptValueProofs(_):
			SubscriptValueProofs(proof)
		RangeAndSubscriptValueProofs(range, _):
			RangeAndSubscriptValueProofs(range, proof)


pure func binding_range_proof(binding: ValueProofs) -> Option[RangeProof]:
	match binding:
		RangeValueProofs(proof):
			Some(proof)
		RangeAndSubscriptValueProofs(proof, _):
			Some(proof)
		_:
			None


pure func binding_subscript_proof(binding: ValueProofs) -> Option[SubscriptProof]:
	match binding:
		SubscriptValueProofs(proof):
			Some(proof)
		RangeAndSubscriptValueProofs(_, proof):
			Some(proof)
		_:
			None


pure func binding_proves_subscript(binding: ValueProofs, collection: ProvenCollection) -> Bool:
	match binding_subscript_proof(binding):
		Some(proof):
			proven_collections_equal(proof.subscript_collection, collection)
		None:
			False


pure func binding_proves_dim_at_most(binding: ValueProofs, size: Int) -> Bool:
	match binding_subscript_proof(binding):
		Some(proof):
			collection_dim_at_most(proof.subscript_collection, size)
		None:
			False


pure func binding_direct_collection_vars(binding: ValueProofs) -> List[CollectionIdentity]:
	match binding_subscript_proof(binding):
		Some(proof):
			match direct_collection_var(proof.subscript_collection):
				Some(identity):
					[identity]
				None:
					[]
		None:
			[]


pure func constant_dim_bound(dim: Int) -> Option[SubscriptBound]:
	if dim < 0:
		None
	else:
		Some(ConstantDim(dim))


pure func dimension_bound(dim: DimensionIdentity) -> SubscriptBound:
	DimensionBound(dim)


pure func collection_length_bound(coll: CollectionIdentity) -> SubscriptBound:
	CollectionLength(coll)


pure func empty_subscript_bounds() -> SubscriptBounds:
	{
		constant_dims = [],
		dimension_bounds = [],
		collection_lengths = []
	}


private pure func add_subscript_bound(
	bounds: SubscriptBounds,
	bound: SubscriptBound,
) -> SubscriptBounds:
	match bound:
		ConstantDim(dim):
			{ bounds | constant_dims = bounds.constant_dims.append(dim) }
		DimensionBound(dim):
			{ bounds | dimension_bounds = bounds.dimension_bounds.append(dim) }
		CollectionLength(coll):
			{ bounds | collection_lengths = bounds.collection_lengths.append(coll) }


pure func subscript_bounds(bounds: List[SubscriptBound]) -> SubscriptBounds:
	var result: SubscriptBounds = empty_subscript_bounds()

	for bound in bounds:
		result = add_subscript_bound(result, bound)

	result


pure func covers_const_dim(proof: RangeProof, dim: Int) -> Bool:
	match proof.range_upper:
		RangeUpperLit(upper):
			proof.range_start >= 0 and upper <= dim
		_:
			False


pure func covers_dimension(proof: RangeProof, dim: DimensionIdentity) -> Bool:
	match proof.range_upper:
		RangeUpperDimension(bounded_dim):
			proof.range_start >= 0 and bounded_dim == dim
		_:
			False


pure func covers_same_collection(proof: RangeProof, coll: CollectionIdentity) -> Bool:
	match proof.range_upper:
		RangeUpperLengthMinus(bounded_coll, _):
			proof.range_start >= 0 and bounded_coll == coll
		RangeUpperAtMostLength(bounded_coll):
			proof.range_start >= 0 and bounded_coll == coll
		_:
			False


private pure func literal_offset_span(
	proof: RangeProof,
	upper: Int,
	offset: Int,
) -> Option[IndexSpan]:
	if upper <= proof.range_start:
		None
	else:
		Some({
			min_index = proof.range_start + offset,
			max_index = upper - 1 + offset,
		})


private pure func offset_span_fits(dim: Int, span: IndexSpan) -> Bool:
	span.min_index >= 0 and span.max_index >= 0 and span.max_index < dim


private pure func offset_span_error(dim: Int, span: IndexSpan) -> String:
	var message: String = string(128)
	message += "index range ["
	message = message.append_int(span.min_index)
	message += ", "
	message = message.append_int(span.max_index)
	message += "] exceeds dimension of size "
	message = message.append_int(dim)
	message += ". Adjust loop bounds to ensure all accesses are in [0, "
	message = message.append_int(dim)
	message += ")"

	message


pure func covers_const_dim_with_offset(
	proof: RangeProof,
	dim: Int,
	offset: Int,
) -> Result[Void, String]:
	match proof.range_upper:
		RangeUpperLit(upper):
			match literal_offset_span(proof, upper, offset):
				None:
					Ok(void)
				Some(span):
					if offset_span_fits(dim, span):
						Ok(void)
					else:
						Err(offset_span_error(dim, span))
		_:
			Err("")


pure func covers_same_collection_with_offset(
	proof: RangeProof,
	coll: CollectionIdentity,
	offset: Int,
) -> Bool:
	match proof.range_upper:
		RangeUpperLengthMinus(bounded_coll, end_offset):
			bounded_coll == coll and proof.range_start + offset >= 0 and offset <= end_offset
		_:
			False


pure func proves_direct_subscript_with_bounds(proof: RangeProof, bounds: SubscriptBounds) -> Bool:
	match proof.range_upper:
		RangeUpperLit(_):
			var proven: Bool = False

			for dim in bounds.constant_dims:
				if covers_const_dim(proof, dim):
					proven = True
					break

			proven
		RangeUpperDimension(_):
			var proven: Bool = False

			for dim in bounds.dimension_bounds:
				if covers_dimension(proof, dim):
					proven = True
					break

			proven
		RangeUpperLengthMinus(_, _):
			var proven: Bool = False

			for coll in bounds.collection_lengths:
				if covers_same_collection(proof, coll):
					proven = True
					break

			proven
		RangeUpperAtMostLength(_):
			var proven: Bool = False

			for coll in bounds.collection_lengths:
				if covers_same_collection(proof, coll):
					proven = True
					break

			proven


pure func proves_direct_subscript(proof: RangeProof, bounds: List[SubscriptBound]) -> Bool:
	proves_direct_subscript_with_bounds(proof, subscript_bounds(bounds))


private pure func preserve_first_offset_error(
	current: OffsetRejection,
	message: String,
) -> OffsetRejection:
	if message.length() == 0:
		current
	else:
		match current:
			OffsetOutOfBounds(_):
				current
			OffsetNoMatchingBound:
				OffsetOutOfBounds(message)


private pure func proves_literal_offset_subscript(
	proof: RangeProof,
	dims: List[Int],
	offset: Int,
) -> OffsetSubscriptProof:
	var result: OffsetSubscriptProof = OffsetRejected(OffsetNoMatchingBound)
	var first_error: OffsetRejection = OffsetNoMatchingBound

	for dim in dims:
		match result:
			OffsetProven:
				void
			OffsetRejected(_):
				match covers_const_dim_with_offset(proof, dim, offset):
					Ok(_):
						result = OffsetProven
					Err(message):
						first_error = preserve_first_offset_error(first_error, message)

	match result:
		OffsetProven:
			OffsetProven
		OffsetRejected(_):
			OffsetRejected(first_error)


pure func proves_offset_subscript_with_bounds(
	proof: RangeProof,
	bounds: SubscriptBounds,
	offset: Int,
) -> OffsetSubscriptProof:
	match proof.range_upper:
		RangeUpperLit(_):
			proves_literal_offset_subscript(proof, bounds.constant_dims, offset)
		RangeUpperDimension(_):
			OffsetRejected(OffsetNoMatchingBound)
		RangeUpperLengthMinus(_, _):
			var proven: Bool = False

			for coll in bounds.collection_lengths:
				if covers_same_collection_with_offset(proof, coll, offset):
					proven = True
					break

			if proven:
				OffsetProven
			else:
				OffsetRejected(OffsetNoMatchingBound)
		RangeUpperAtMostLength(_):
			OffsetRejected(OffsetNoMatchingBound)


pure func proves_offset_subscript(
	proof: RangeProof,
	bounds: List[SubscriptBound],
	offset: Int,
) -> OffsetSubscriptProof:
	proves_offset_subscript_with_bounds(proof, subscript_bounds(bounds), offset)


pure func binding_proves_direct_range(binding: ValueProofs, bounds: List[SubscriptBound]) -> Bool:
	match binding_range_proof(binding):
		Some(proof):
			proves_direct_subscript(proof, bounds)
		None:
			False


pure func binding_proves_offset_range(
	binding: ValueProofs,
	bounds: List[SubscriptBound],
	offset: Int,
) -> OffsetSubscriptProof:
	match binding_range_proof(binding):
		Some(proof):
			proves_offset_subscript(proof, bounds, offset)
		None:
			offset_no_matching_bound()


pure func offset_no_matching_bound() -> OffsetSubscriptProof:
	OffsetRejected(OffsetNoMatchingBound)


pure func empty_proof_env() -> ProofEnv:
	{
		subscript_proofs = [],
		range_proofs = []
	}


private pure func remove_subscript_proofs_for_var(
	var_id: CollectionIdentity,
	proofs: List[(CollectionIdentity, SubscriptProof)],
) -> List[(CollectionIdentity, SubscriptProof)]:
	var result: List[(CollectionIdentity, SubscriptProof)] = []

	for entry in proofs:
		if entry[0] != var_id:
			result = result.append(entry)

	result


private pure func remove_range_proofs_for_var(
	var_id: CollectionIdentity,
	proofs: List[(CollectionIdentity, RangeProof)],
) -> List[(CollectionIdentity, RangeProof)]:
	var result: List[(CollectionIdentity, RangeProof)] = []

	for entry in proofs:
		if entry[0] != var_id:
			result = result.append(entry)

	result


private pure func find_subscript_proof_for_var(
	var_id: CollectionIdentity,
	proofs: List[(CollectionIdentity, SubscriptProof)],
) -> Option[SubscriptProof]:
	var result: Option[SubscriptProof] = None

	for entry in proofs:
		if entry[0] == var_id:
			result = Some(entry[1])
			break

	result


private pure func find_range_proof_for_var(
	var_id: CollectionIdentity,
	proofs: List[(CollectionIdentity, RangeProof)],
) -> Option[RangeProof]:
	var result: Option[RangeProof] = None

	for entry in proofs:
		if entry[0] == var_id:
			result = Some(entry[1])
			break

	result


pure func proof_env_without_subscript(env: ProofEnv, var_id: CollectionIdentity) -> ProofEnv:
	{ env | subscript_proofs = remove_subscript_proofs_for_var(var_id, env.subscript_proofs) }


pure func proof_env_without_range(env: ProofEnv, var_id: CollectionIdentity) -> ProofEnv:
	{ env | range_proofs = remove_range_proofs_for_var(var_id, env.range_proofs) }


pure func proof_env_add_subscript(
	env: ProofEnv,
	var_id: CollectionIdentity,
	collection: ProvenCollection,
	source: ProofSource,
) -> ProofEnv:
	{ env |
		subscript_proofs = remove_subscript_proofs_for_var(
			var_id,
			env.subscript_proofs,
		).append((var_id, make_subscript_proof(collection, source)))
	}


pure func proof_env_apply_subscript_to_binding(
	env: ProofEnv,
	var_id: CollectionIdentity,
	binding: ValueProofs,
) -> ValueProofs:
	match find_subscript_proof_for_var(var_id, env.subscript_proofs):
		Some(proof):
			binding_add_subscript_proof(binding, proof.subscript_collection, proof.subscript_source)
		None:
			binding


private pure func proof_env_add_range_proof(
	env: ProofEnv,
	var_id: CollectionIdentity,
	proof: RangeProof,
) -> ProofEnv:
	{ env |
		range_proofs = remove_range_proofs_for_var(var_id, env.range_proofs).append((var_id, proof))
	}


pure func proof_env_add_range_bounds(
	env: ProofEnv,
	var_id: CollectionIdentity,
	range_start: Int,
	range_upper: RangeUpper,
	source: ProofSource,
) -> ProofEnv:
	match make_range_proof_with_source(range_start, range_upper, source):
		Some(proof):
			proof_env_add_range_proof(env, var_id, proof)
		None:
			proof_env_without_range(env, var_id)


pure func proof_env_find_range(env: ProofEnv, var_id: CollectionIdentity) -> Option[RangeProof]:
	find_range_proof_for_var(var_id, env.range_proofs)


pure func immutable_subject(name: String) -> Option[BranchSubject]:
	match collection_identity(name):
		Some(identity):
			Some(ImmutableSubject(NarrowedBinding(identity)))
		None:
			None


pure func immutable_alias_subject(alias_name: String, target_name: String) -> Option[BranchSubject]:
	match (collection_identity(alias_name), collection_identity(target_name)):
		(Some(alias_id), Some(target_id)):
			if alias_id == target_id:
				None
			else:
				Some(ImmutableSubject(NarrowedAlias(alias_id, target_id)))
		_:
			None


pure func mutable_subject(name: String) -> Option[BranchSubject]:
	match collection_identity(name):
		Some(identity):
			Some(MutableSubject(identity))
		None:
			None


pure func make_branch_range_proof(
	subject: BranchSubject,
	range_start: Int,
	range_upper: RangeUpper,
) -> Result[BranchRangeProof, BranchProofRejection]:
	match subject:
		MutableSubject(_):
			Err(MutableSubjectCannotNarrow)
		ImmutableSubject(narrowed_subject):
			match make_range_proof_with_source(range_start, range_upper, ProofSourceCondition):
				Some(proof):
					Ok({
						subject = narrowed_subject,
						proof = proof,
					})
				None:
					Err(InvalidRangeBounds)


pure func branch_range_subject(proof: BranchRangeProof) -> NarrowedSubject:
	proof.subject


pure func branch_range_proof(proof: BranchRangeProof) -> RangeProof:
	proof.proof
