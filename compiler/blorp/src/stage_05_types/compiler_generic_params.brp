record CompilerTraitRef {
	name: String
}


record CompilerBoundTypeParam {
	name: String,
	bounds: List[CompilerTraitRef]
}


pure func compiler_trait_ref(name: String) -> CompilerTraitRef:
	{name = name}


pure func compiler_trait_ref_name(trait_ref: CompilerTraitRef) -> String:
	trait_ref.name


pure func compiler_trait_ref_names(trait_refs: List[CompilerTraitRef]) -> List[String]:
	trait_refs.map(compiler_trait_ref_name)


pure func compiler_bound_type_param_name(param: CompilerBoundTypeParam) -> String:
	param.name


pure func compiler_make_bound_type_param(
	name: String,
	bounds: List[String],
) -> CompilerBoundTypeParam:
	{
		name = name,
		bounds = bounds.map(compiler_trait_ref)
	}


pure func compiler_bound_type_param_to_parser_string(param: CompilerBoundTypeParam) -> String:
	if param.bounds.length() == 0:
		param.name
	else:
		param.name + ":" + compiler_trait_ref_names(param.bounds).join("+")


pure func compiler_param_names(params: List[CompilerBoundTypeParam]) -> List[String]:
	params.map(compiler_bound_type_param_name)
