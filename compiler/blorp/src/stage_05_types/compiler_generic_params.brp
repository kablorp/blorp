type alias TraitRef = String


record BoundTypeParam {
	name: String,
	bounds: List[TraitRef]
}


pure func bound_type_param_name(param: BoundTypeParam) -> String:
	param.name


pure func make_bound_type_param(name: String, bounds: List[String]) -> BoundTypeParam:
	{
		name = name,
		bounds = bounds
	}


pure func bound_type_param_to_parser_string(param: BoundTypeParam) -> String:
	if param.bounds.length() == 0:
		param.name
	else:
		param.name + ":" + param.bounds.join("+")
