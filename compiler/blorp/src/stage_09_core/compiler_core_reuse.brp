private pure func consume_handoff_rhs(
	dropped_var: CoreVar,
	dropped_type: CoreType,
	bind_rhs: CoreExpr,
) -> Option[CoreExpr]:
	match bind_rhs:
		ListHandoffExpr(handoff, typ, loc):
			if (
				handoff.mode == BorrowFreshHandoff
				and core_expr_is_var(handoff.source, dropped_var)
				and reuse_type_compatible(dropped_type, handoff.source_type)
				and reuse_type_compatible(dropped_type, handoff.result_type)
				and not owner_touched(dropped_var, handoff.capacity)
				and not owner_touched(dropped_var, handoff.body)
			):
				Some(ListHandoffExpr({ handoff | mode = ConsumeReuseHandoff }, typ, loc))
			else:
				None
		RawMatchExpr(scrutinee, cases, typ, loc):
			None
		LiteralExpr(literal, typ, loc):
