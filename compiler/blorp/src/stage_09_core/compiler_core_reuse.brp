-- Reuse analysis and rewrites for the Blorp-owned Core tail.
--
-- The normal post-Perceus pass consumes explicit drops around compatible fresh
-- collection allocations or producer handoffs. The prepared-union pass rewrites
-- a prepared match result that immediately drops its source into a union reuse
-- construct, but only when every managed source field has been moved out and the
-- new payload cannot alias the source.
import:
	compiler_core_json:
		CoreAccessor(
			BoxedResultErrPayloadAccessor,
			BoxedResultOkPayloadAccessor,
			BoxedStackResultErrPayloadAccessor,
			BoxedStackResultOkPayloadAccessor,
			ErasedVariantFieldAccessor,
			ListElementAccessor,
			ListSpreadAccessor,
			NullableOptionPayloadAccessor,
			RootAccessor,
			StackOptionPayloadAccessor,
			StackResultErrPayloadAccessor,
			StackResultOkPayloadAccessor,
			TupleFieldAccessor,
			VariantFieldAccessor,
		),
		CoreBoxedStorageValue,
		CoreCallKind(
			BuiltinCall,
			ClosureCall,
			DictWithCapacityCall,
			DirectRuntimeCall,
			FallibleStreamTerminalCall,
			ForeignCall,
			IntrinsicCall,
			ListToStringCall,
			OperationResultCall,
			SelectedDirectCall,
			TensorParallelCall,
			UnknownCall,
			UserCall,
		),
		CoreConstructorLengthMatch,
		CoreConstructorLengthMatchBranch,
		CoreConstructorLengthMatchCase,
		CoreConstructorLengthMatchGeq,
		CoreConstructorLiteralMatch,
		CoreConstructorMatchBody(
			ConstructorMatchBodyExpr,
			ConstructorMatchBodyLength,
			ConstructorMatchBodyLiteral,
		),
		CoreConstructorMatchCase,
		CoreConstructorMatchFallback(
			ConstructorMatchFallbackBindings,
			ConstructorMatchFallbackBody,
			ConstructorMatchFallbackFail,
		),
		CoreDecl(
			EnumDecl,
			FunctionDecl,
			GlobalDecl,
			HeapRecordDecl,
			ImplDecl,
			TraitDecl,
			TypeAliasDecl,
			UnionDecl,
			ValueRecordDecl,
		),
		CoreDictEntry,
		CoreDictLiteralEntry,
		CoreDimOp(DimAdd, DimDivide, DimMultiply, DimSubtract),
		CoreExpr(
			AccessorLiteralMatchExpr,
			AssignExpr,
			BinaryExpr,
			BorrowLetExpr,
			BoxExpr,
			BreakExpr,
			CastExpr,
			CallExpr,
			ClosureCreateExpr,
			ConcurrentExpr,
			ConcurrentlyLoopExpr,
			ConstructorMatchExpr,
			ContinueExpr,
			CooperativeCheckpointExpr,
			DebugBlockExpr,
			DetachExpr,
			DictConstructExpr,
