		ListSetExpr(set, typ, loc):
			None
		ListSwapExpr(swap, typ, loc):
			None
		RecordExpr(fields, typ, loc):
			None
		RecordConstructExpr(type_name, fields, typ, loc):
			None
		UnionConstructExpr(construct, typ, loc):
			None
		UnionReuseConstructExpr(construct, typ, loc):
			None
		DetachExpr(detached, typ, loc):
			None
		DupExpr(dup_var, dup_type, retain_policy, dup_body, typ, loc):
			None
		LetExpr(inner_var, inner_mutable, inner_type, inner_rhs, inner_body):
			None
		BorrowLetExpr(inner_var, inner_type, inner_rhs, inner_body):
			None
		SeqExpr(first, second):
			None
		WhileExpr(cond, while_body, typ, loc):
			None
		BreakExpr(typ, loc):
			None
		ContinueExpr(typ, loc):
			None
		ResourceScopeExpr(scope, typ, loc):
			None
		ResourceCleanupExitExpr(exit, typ, loc):
			None
		TailrecLoopExpr(params, return_type, tailrec_body, loc):
			None
		TailrecRecurExpr(args, typ, loc):
			None
		TailrecListSpreadLoopExpr(loop, loc):
			None
		TailrecListSpreadRecurExpr(rebinds, spread_index, typ, loc):
			None
		ForRangeExpr(binder, start, end, step, typ, loc):
			None
		ForChannelExpr(loop, typ, loc):
			None
		ForListExpr(loop, typ, loc):
			None
		ForStringExpr(loop, typ, loc):
			None
		ForDictExpr(loop, typ, loc):
			None
		ForSetExpr(loop, typ, loc):
			None
		ForStreamExpr(loop, typ, loc):
			None
		ForResourceSourceExpr(loop, typ, loc):
			None
		ForTensorExpr(loop, typ, loc):
			None
		ConcurrentlyLoopExpr(loop, typ, loc):
			None
		ConcurrentExpr(block, typ, loc):
			None
		SelectExpr(selection, typ, loc):
			None
		RangeExpr(start, end, typ, loc):
			None
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			None
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			None
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			None
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			None
		IfExpr(cond, then_expr, else_expr, typ, loc):
			None


pure func rewrite_prepared_expr(decls: List[CoreDecl], expr: CoreExpr) -> CoreExpr:
	match expr:
		RawMatchExpr(scrutinee, cases, typ, loc):
			RawMatchExpr(
				rewrite_prepared_expr(decls, scrutinee),
				cases.map(func(case): { case | body = rewrite_prepared_expr(decls, case.body) }),
				typ,
				loc,
			)
		LetExpr(variable, is_mutable, value_type, rhs, body):
			rewritten_rhs: CoreExpr = rewrite_prepared_expr(decls, rhs)
			rewritten_body: CoreExpr = rewrite_prepared_expr(decls, body)

			match rewrite_prepared_let_drop(decls, variable, rewritten_rhs, rewritten_body):
				Some(rewritten):
					rewritten
				None:
					LetExpr(variable, is_mutable, value_type, rewritten_rhs, rewritten_body)
		BorrowLetExpr(variable, value_type, rhs, body):
			BorrowLetExpr(
				variable,
				value_type,
				rewrite_prepared_expr(decls, rhs),
				rewrite_prepared_expr(decls, body),
			)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			DropExpr(
				variable,
				value_type,
				release_policy,
				rewrite_prepared_expr(decls, body),
				typ,
				loc,
			)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			DupExpr(
				variable,
				value_type,
				retain_policy,
				rewrite_prepared_expr(decls, body),
				typ,
				loc,
			)
		SeqExpr(first, second):
			SeqExpr(
				rewrite_prepared_expr(decls, first),
				rewrite_prepared_expr(decls, second),
			)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			IfExpr(
				rewrite_prepared_expr(decls, cond),
				rewrite_prepared_expr(decls, then_expr),
				rewrite_prepared_expr(decls, else_expr),
				typ,
				loc,
			)
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, fallback, typ, loc):
			ConstructorMatchExpr(
				rewrite_prepared_expr(decls, scrutinee),
				scrutinee_release_policy,
				rewrite_child_constructor_match_cases(decls, cases),
				rewrite_child_constructor_match_fallback(decls, fallback),
				typ,
				loc,
			)
		LiteralExpr(literal, typ, loc):
			expr
		VarExpr(variable, typ, loc):
			expr
		VoidExpr(typ, loc):
			expr
		DebugBlockExpr(body, typ, loc):
			DebugBlockExpr(
				rewrite_prepared_expr(decls, body),
				typ,
				loc,
			)
		CooperativeCheckpointExpr(typ, loc):
			expr
		CallExpr(kind, callee, args, typ, loc):
			expr
		BinaryExpr(op, left, right, typ, loc):
			expr
		UnaryExpr(op, inner, typ, loc):
			expr
		LogicalExpr(op, left, right, typ, loc):
			expr
		AssignExpr(variable, rhs, typ, loc):
			expr
		CastExpr(inner, typ, loc):
			expr
		BoxExpr(box, typ, loc):
			expr
		UnboxExpr(unbox_kind, inner, typ, loc):
			expr
		FieldExpr(inner, field, typ, loc):
			expr
		TupleFieldExpr(inner, index, typ, loc):
			expr
		TupleExpr(items, typ, loc):
			expr
		TupleConstructExpr(construct, typ, loc):
			expr
		VectorExpr(items, typ, loc):
			expr
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			expr
		ClosureCreateExpr(closure, typ, loc):
			expr
		ListConstructExpr(construct, typ, loc):
			expr
		ListAllocExpr(alloc, typ, loc):
			expr
		ListGetExpr(get, typ, loc):
			expr
		ListHandoffExpr(handoff, typ, loc):
			expr
		ListHandoffSetOwnedExpr(set, typ, loc):
			expr
		ListHandoffSetSourceSlotExpr(set, typ, loc):
			expr
		StringByteReadExpr(read, typ, loc):
			expr
		StringByteWriteExpr(write, typ, loc):
			expr
		StringByteCopyExpr(copy, typ, loc):
			expr
		StringSetLenExpr(set_len, typ, loc):
			expr
		TensorLiteralExpr(literal, typ, loc):
			expr
		TensorBoxedLiteralExpr(literal, typ, loc):
			expr
		TensorPackedLiteralExpr(literal, typ, loc):
			expr
		TensorRawFillExpr(fill, typ, loc):
			expr
		TensorRawReadExpr(read, typ, loc):
			expr
		TensorRawWriteExpr(write, typ, loc):
			expr
		TensorRawViewLetExpr(binding, body, typ, loc):
			expr
		DictConstructExpr(construct, typ, loc):
			expr
		DictExpr(entries, typ, loc):
			expr
		SetAllocExpr(alloc, typ, loc):
			expr
		ListRetainExpr(retain, typ, loc):
			expr
		ListSetExpr(set, typ, loc):
			expr
		ListSwapExpr(swap, typ, loc):
			expr
		RecordExpr(fields, typ, loc):
			expr
		RecordConstructExpr(type_name, fields, typ, loc):
			expr
		UnionConstructExpr(construct, typ, loc):
			expr
		UnionReuseConstructExpr(construct, typ, loc):
			expr
		PreClosureDetachExpr(detached, typ, loc):
			expr
		DetachExpr(detached, typ, loc):
			expr
		WhileExpr(cond, body, typ, loc):
			expr
		BreakExpr(typ, loc):
			expr
		ContinueExpr(typ, loc):
			expr
		ResourceScopeExpr(scope, typ, loc):
			expr
		ResourceCleanupExitExpr(exit, typ, loc):
			expr
		TailrecLoopExpr(params, return_type, body, loc):
			expr
		TailrecRecurExpr(args, typ, loc):
			expr
		TailrecListSpreadLoopExpr(loop, loc):
			expr
		TailrecListSpreadRecurExpr(rebinds, spread_index, typ, loc):
			expr
		ForRangeExpr(binder, start, end, step, typ, loc):
			expr
		ForChannelExpr(loop, typ, loc):
			expr
		ForListExpr(loop, typ, loc):
			expr
		ForStringExpr(loop, typ, loc):
			expr
		ForDictExpr(loop, typ, loc):
			expr
		ForSetExpr(loop, typ, loc):
			expr
		ForStreamExpr(loop, typ, loc):
			expr
		ForResourceSourceExpr(loop, typ, loc):
			expr
		ForTensorExpr(loop, typ, loc):
			expr
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			expr
		ConcurrentlyLoopExpr(loop, typ, loc):
			expr
		PreClosureConcurrentExpr(block, typ, loc):
			expr
		ConcurrentExpr(block, typ, loc):
			expr
		SelectExpr(selection, typ, loc):
			expr
		RangeExpr(start, end, typ, loc):
			expr
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			expr
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			expr
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			expr


pure func rewrite_child_constructor_match_body(
	decls: List[CoreDecl],
	body: CoreConstructorMatchBody,
) -> CoreConstructorMatchBody:
	match body:
		ConstructorMatchBodyExpr(expr):
			ConstructorMatchBodyExpr(rewrite_prepared_expr(decls, expr))
		ConstructorMatchBodyLiteral(match_expr):
			ConstructorMatchBodyLiteral({ match_expr |
					cases = rewrite_child_literal_match_cases(decls, match_expr.cases),
					fallback = rewrite_child_literal_match_fallback(decls, match_expr.fallback)
				})
		ConstructorMatchBodyLength(match_expr):
			ConstructorMatchBodyLength({ match_expr |
					cases = rewrite_child_length_match_cases(decls, match_expr.cases),
					geq = rewrite_child_length_match_geq(decls, match_expr.geq),
					fallback = rewrite_child_length_match_fallback(decls, match_expr.fallback)
				})


pure func rewrite_child_constructor_match_case(
	decls: List[CoreDecl],
	match_case: CoreConstructorMatchCase,
) -> CoreConstructorMatchCase:
	{ match_case | body = rewrite_child_constructor_match_body(decls, match_case.body) }


pure func rewrite_child_constructor_match_cases(
	decls: List[CoreDecl],
	cases: List[CoreConstructorMatchCase],
) -> List[CoreConstructorMatchCase]:
	cases.map(func(match_case): rewrite_child_constructor_match_case(decls, match_case))


pure func rewrite_child_constructor_match_fallback(
	decls: List[CoreDecl],
	fallback: CoreConstructorMatchFallback,
) -> CoreConstructorMatchFallback:
	match fallback:
		ConstructorMatchFallbackBody(body):
			ConstructorMatchFallbackBody(rewrite_prepared_expr(decls, body))
		ConstructorMatchFallbackBindings(bindings, body):
			ConstructorMatchFallbackBindings(
				bindings,
				rewrite_prepared_expr(decls, body),
			)
		ConstructorMatchFallbackFail:
			ConstructorMatchFallbackFail


pure func rewrite_child_literal_match_cases(
	decls: List[CoreDecl],
	cases: List[CoreLiteralMatchCase],
) -> List[CoreLiteralMatchCase]:
	cases.map(
		func(match_case): { match_case | body = rewrite_prepared_expr(decls, match_case.body) },
	)


pure func rewrite_child_literal_match_fallback(
	decls: List[CoreDecl],
	fallback: CoreLiteralMatchFallback,
) -> CoreLiteralMatchFallback:
	match fallback:
		LiteralMatchFallbackBody(body):
			LiteralMatchFallbackBody(rewrite_prepared_expr(decls, body))
		LiteralMatchFallbackBindings(bindings, body):
			LiteralMatchFallbackBindings(
				bindings,
				rewrite_prepared_expr(decls, body),
			)
		LiteralMatchFallbackFail:
			LiteralMatchFallbackFail


pure func rewrite_child_length_branch(
	decls: List[CoreDecl],
	branch: CoreConstructorLengthMatchBranch,
) -> CoreConstructorLengthMatchBranch:
	{ branch | body = rewrite_child_constructor_match_body(decls, branch.body) }


pure func rewrite_child_length_match_cases(
	decls: List[CoreDecl],
	cases: List[CoreConstructorLengthMatchCase],
) -> List[CoreConstructorLengthMatchCase]:
	cases.map(
		func(
			match_case,
		): { match_case | branch = rewrite_child_length_branch(decls, match_case.branch) },
	)


pure func rewrite_child_length_match_geq(
	decls: List[CoreDecl],
	geq: Option[CoreConstructorLengthMatchGeq],
) -> Option[CoreConstructorLengthMatchGeq]:
	match geq:
		Some(value):
			Some({ value | branch = rewrite_child_length_branch(decls, value.branch) })
		None:
			None


pure func rewrite_child_length_match_fallback(
	decls: List[CoreDecl],
	fallback: Option[CoreConstructorLengthMatchBranch],
) -> Option[CoreConstructorLengthMatchBranch]:
	match fallback:
		Some(branch):
			Some(rewrite_child_length_branch(decls, branch))
		None:
			None


pure func rewrite_prepared_function(decls: List[CoreDecl], func_info: CoreFunction) -> CoreFunction:
	match func_info.body:
		Some(body):
			{ func_info | body = Some(rewrite_prepared_expr(decls, body)) }
		None:
			func_info


pure func rewrite_prepared_global(decls: List[CoreDecl], global: CoreGlobal) -> CoreGlobal:
	{ global | init = rewrite_prepared_expr(decls, global.init) }


pure func rewrite_prepared_decl(decls: List[CoreDecl], decl: CoreDecl) -> CoreDecl:
	match decl:
		FunctionDecl(func_info):
			FunctionDecl(rewrite_prepared_function(decls, func_info))
		GlobalDecl(global):
			GlobalDecl(rewrite_prepared_global(decls, global))
		UnionDecl(union_decl):
			decl
		EnumDecl(enum_decl):
			decl
		ValueRecordDecl(record_decl):
			decl
		HeapRecordDecl(record_decl):
			decl
		TypeAliasDecl(alias_decl):
			decl
		TraitDecl(trait_decl):
			decl
		ImplDecl(impl_decl):
			ImplDecl(
				{ impl_decl |
					methods = impl_decl.methods.map(
						pure func(method): rewrite_prepared_function(decls, method),
					)
				},
			)


pure func rewrite_prepared_program(program: CoreProgram) -> CoreProgram:
	var decls: List[CoreDecl] = []

	for decl in program.decls:
		decls = decls.append(rewrite_prepared_decl(program.decls, decl))

	{ program | decls = decls }
