-- Project semantic decision trees onto the backend's typed match forms.
--
-- Core keeps constructor names and structural accessors semantic until type
-- specialization fixes their runtime layout. Before DCE and ownership
-- accounting, resolve those facts into ordinary typed match nodes so every
-- remaining Core pass sees the complete expression tree. C emission applies
-- this projection again as an idempotent final ownership normalization.
import:
	compiler_core_c_type_layout: c_type_name, stack_option_c_type
	compiler_core_json:
		CoreAccessor(
			BoxedResultErrPayloadAccessor,
			BoxedResultOkPayloadAccessor,
			BoxedStackResultErrPayloadAccessor,
			BoxedStackResultOkPayloadAccessor,
			ErasedVariantFieldAccessor,
			ListElementAccessor,
			ListSpreadAccessor,
			NullableOptionPayloadAccessor,
			RootAccessor,
			StackOptionPayloadAccessor,
			StackResultErrPayloadAccessor,
			StackResultOkPayloadAccessor,
			TupleFieldAccessor,
			VariantFieldAccessor,
		),
		CoreCallKind(
			DeferredTraitCall,
			IntrinsicCall,
			SelectedDirectCall,
			SelectedTraitCall,
			UnknownCall,
		),
		CoreConstructorLengthMatch,
		CoreConstructorLengthMatchBranch,
		CoreConstructorLengthMatchCase,
		CoreConstructorLengthMatchGeq,
		CoreConstructorLiteralMatch,
		CoreConstructorMatchBody(
			ConstructorMatchBodyExpr,
			ConstructorMatchBodyLength,
			ConstructorMatchBodyLiteral,
		),
		CoreConstructorMatchCase,
		CoreConstructorMatchFallback(
			ConstructorMatchFallbackBindings,
			ConstructorMatchFallbackBody,
			ConstructorMatchFallbackFail,
		),
		CoreConstructorMatchTest(
			BoolFalseConstructorTest,
			BoolTrueConstructorTest,
			BoxedResultErrConstructorTest,
			BoxedResultOkConstructorTest,
			EnumConstructorTest,
			NullableOptionNoneConstructorTest,
			NullableOptionSomeConstructorTest,
			StackOptionNoneConstructorTest,
			StackOptionSomeConstructorTest,
			StackResultErrConstructorTest,
			StackResultOkConstructorTest,
			UnionTagConstructorTest,
		),
		CoreDecl(EnumDecl, FunctionDecl, GlobalDecl, UnionDecl),
		CoreEnumVariant,
		CoreExpr(
			AccessorLiteralMatchExpr,
			CallExpr,
			CastExpr,
			ConstructorMatchExpr,
			DropExpr,
			DupExpr,
			FieldExpr,
			LetExpr,
			LengthMatchExpr,
			LiteralMatchExpr,
			SemanticMatchExpr,
			SeqExpr,
			TupleFieldExpr,
			UnboxExpr,
			VarExpr,
		),
		CoreFunction,
		CoreGlobal,
		CoreLiteral,
		CoreLiteralMatchFallback(
			LiteralMatchFallbackBindings,
			LiteralMatchFallbackBody,
			LiteralMatchFallbackFail,
		),
		CoreMatchBinding,
		CoreMatchBindingMode(MatchBorrowBindingMode, MatchOwnBindingMode),
		CoreProgram,
		CoreReleasePolicy(NoReleasePolicy),
		CoreRetainPolicy(NoRetainPolicy),
		CoreSemanticConstructorMatchCase,
		CoreSemanticLengthMatchCase,
		CoreSemanticLengthMatchGeq,
		CoreSemanticMatchAccessor(
			ListElementSemanticMatchAccessor,
			ListSpreadSemanticMatchAccessor,
			RootSemanticMatchAccessor,
			TupleFieldSemanticMatchAccessor,
			VariantFieldSemanticMatchAccessor,
		),
		CoreSemanticMatchBinding,
		CoreSemanticMatchTree(
			SemanticConstructorMatch,
			SemanticLengthMatch,
			SemanticLiteralMatch,
			SemanticMatchFail,
			SemanticMatchLeaf,
		),
		CoreSourceLoc(KnownSourceLoc, SyntheticSourceLoc),
		CoreType(BoxedResultType, EnumType, NamedType, StackResultType, TupleType, UnionType),
		CoreUnionDecl,
		CoreUnionPayloadStorage(TypedUnionPayloadStorage),
		CoreUnionVariant,
		CoreVar,
		core_expr_type,
		core_literal_match_case,
	compiler_core_mono:
		CoreMonoSubstitution,
		CoreMonoSubstitutionValue(TypeSubstitution),
		apply_type_substitution,
	compiler_core_ownership: OwnershipResultMode(ReturnOwned)
	compiler_core_perceus: PerceusEnv, build_env, contract_for_call
	compiler_core_semantic_literal_view:
		SemanticLiteralMatchCaseView,
		semantic_literal_match_case_views,
	compiler_core_specialize_layout:
		CoreOptionRuntimeLayout(NullableManagedOptionLayout),
		CoreSpecializeLayout,
		build_specialize_layout,
		option_runtime_layout,
		resolve_specialize_type,
		single_named_type_argument,
	compiler_core_traverse as CoreTraverse
	compiler_core_type_policy: cleanup_release_policy_for_type


record LoweredSemanticLiteralMatchCase {
	literal_value: CoreLiteral,
	bindings_value: List[CoreMatchBinding],
	body_expr: CoreExpr
}


union LoweredLengthGeq:
	LoweredLengthGeqValue(CoreConstructorLengthMatchGeq)
	LoweredLengthGeqAbsent


union LoweredLengthFallback:
	LoweredLengthFallbackValue(CoreConstructorLengthMatchBranch)
	LoweredLengthFallbackAbsent


private pure func find_union_decl(program: CoreProgram, name: String) -> Option[CoreUnionDecl]:
	var result: Option[CoreUnionDecl] = None

	for decl in program.decls:
		match decl:
			UnionDecl(union_decl):
				if union_decl.name == name:
					result = Some(union_decl)
					break
			_:
				void

	result


private pure func find_union_variant(
	program: CoreProgram,
	type_name: String,
	constructor: String,
) -> Option[CoreUnionVariant]:
	union_decl ?= find_union_decl(program, type_name)
	var result: Option[CoreUnionVariant] = None

	for variant in union_decl.variants:
		if variant.name == constructor:
			result = Some(variant)
			break

	result


private pure func find_enum_variant(
	program: CoreProgram,
	type_name: String,
	constructor: String,
) -> Option[CoreEnumVariant]:
	var result: Option[CoreEnumVariant] = None

	for decl in program.decls:
		match decl:
			EnumDecl(enum_decl):
				if enum_decl.name == type_name:
					for variant in enum_decl.variants:
						if variant.name == constructor:
							result = Some(variant)
							break
			_:
				void

		if result.is_some():
			break

	result


private pure func constructor_variable_matches(
	variable: CoreVar,
	name: String,
	def_id: Option[Int],
) -> Bool:
	variable.def_id == def_id or variable.def_id.is_none() and variable.name == name


private pure func singleton_constructor_value(
	layout: CoreSpecializeLayout,
	variable: CoreVar,
	typ: CoreType,
) -> Bool:
	match resolve_specialize_type(layout, typ):
		NamedType("Option", args):
			args.length() == 1 and variable.name == "None"
		EnumType(type_name):
			match find_enum_variant(layout.program, type_name, variable.name):
				Some(variant):
					constructor_variable_matches(variable, variant.name, variant.def_id)
				None:
					False
		UnionType(type_name) | NamedType(type_name, _):
			match find_union_variant(layout.program, type_name, variable.name):
				Some(variant):
					(
						variant.fields.is_empty()
						and constructor_variable_matches(variable, variant.name, variant.def_id)
					)
				None:
					False
		_:
			False


private pure func semantic_accessor_is_root(accessor: CoreSemanticMatchAccessor) -> Bool:
	match accessor:
		RootSemanticMatchAccessor:
			True
		_:
			False


private pure func union_type_substitution(
	type_params: List[String],
	args: List[CoreType],
) -> CoreMonoSubstitution:
	var substitution: CoreMonoSubstitution = []
	var index: Int = 0

	while index < type_params.length():
		match type_params.get(index):
			Some(type_param):
				match args.get(index):
					Some(arg):
						substitution = substitution.append((type_param, TypeSubstitution(arg)))
					None:
						break
			None:
				break

		index += 1

	substitution


private pure func instantiate_union_variant_field_type(
	layout: CoreSpecializeLayout,
	type_name: String,
	args: List[CoreType],
	constructor: String,
	field_index: Int,
) -> Option[CoreType]:
	union_decl ?= find_union_decl(layout.program, type_name)
	variant ?= find_union_variant(layout.program, type_name, constructor)
	field ?= variant.fields.get(field_index)

	Some(
		resolve_specialize_type(
			layout,
			apply_type_substitution(
				union_type_substitution(union_decl.type_params, args),
				field.typ,
			),
		),
	)


private pure func union_variant_field_type(
	layout: CoreSpecializeLayout,
	parent_type: CoreType,
	constructor: String,
	field_index: Int,
) -> Option[CoreType]:
	match resolve_specialize_type(layout, parent_type):
		NamedType(type_name, args):
			instantiate_union_variant_field_type(layout, type_name, args, constructor, field_index)
		UnionType(type_name):
			instantiate_union_variant_field_type(layout, type_name, [], constructor, field_index)
		_:
			None


private pure func semantic_accessor_type(
	layout: CoreSpecializeLayout,
	root_type: CoreType,
	accessor: CoreSemanticMatchAccessor,
) -> Option[CoreType]:
	match accessor:
		RootSemanticMatchAccessor:
			Some(resolve_specialize_type(layout, root_type))
		TupleFieldSemanticMatchAccessor(parent, index):
			parent_type ?= semantic_accessor_type(layout, root_type, parent)

			match resolve_specialize_type(layout, parent_type):
				TupleType(items):
					items.get(index)
				_:
					None
		ListElementSemanticMatchAccessor(parent, _):
			parent_type ?= semantic_accessor_type(layout, root_type, parent)
			single_named_type_argument(layout, parent_type, "List")
		ListSpreadSemanticMatchAccessor(parent, _):
			semantic_accessor_type(layout, root_type, parent)
		VariantFieldSemanticMatchAccessor(parent, constructor, field_index):
			parent_type ?= semantic_accessor_type(layout, root_type, parent)
			resolved_parent: CoreType = resolve_specialize_type(layout, parent_type)

			match resolved_parent:
				NamedType("Option", _):
					if constructor == "Some" and field_index == 0:
						single_named_type_argument(layout, resolved_parent, "Option")
					else:
						None
				StackResultType(ok_type, error_type) | BoxedResultType(ok_type, error_type):
					if field_index != 0:
						None
					else if constructor == "Ok":
						Some(ok_type)
					else if constructor == "Err":
						Some(error_type)
					else:
						None
				UnionType(type_name) | NamedType(type_name, _):
					union_variant_field_type(layout, resolved_parent, constructor, field_index)
				_:
					None


private pure func lower_generic_variant_accessor(
	layout: CoreSpecializeLayout,
	parent: CoreAccessor,
	parent_type: CoreType,
	constructor: String,
	field_index: Int,
) -> Option[CoreAccessor]:
	type_name ?= match resolve_specialize_type(layout, parent_type):
		UnionType(name) | NamedType(name, _):
			Some(name)
		_:
			None

	union_decl ?= find_union_decl(layout.program, type_name)

	match union_decl.payload_storage:
		TypedUnionPayloadStorage:
			Some(VariantFieldAccessor(parent, type_name, constructor, field_index))
		_:
			Some(ErasedVariantFieldAccessor(parent, type_name, constructor, field_index))


private pure func lower_accessor(
	layout: CoreSpecializeLayout,
	root_type: CoreType,
	accessor: CoreSemanticMatchAccessor,
) -> Option[CoreAccessor]:
	match accessor:
		RootSemanticMatchAccessor:
			Some(RootAccessor)
		TupleFieldSemanticMatchAccessor(parent, index):
			lowered_parent ?= lower_accessor(layout, root_type, parent)
			field_type ?= semantic_accessor_type(layout, root_type, accessor)
			Some(TupleFieldAccessor(lowered_parent, index, field_type))
		ListElementSemanticMatchAccessor(parent, index):
			lowered_parent ?= lower_accessor(layout, root_type, parent)
			Some(ListElementAccessor(lowered_parent, index))
		ListSpreadSemanticMatchAccessor(parent, offset):
			lowered_parent ?= lower_accessor(layout, root_type, parent)
			Some(ListSpreadAccessor(lowered_parent, offset))
		VariantFieldSemanticMatchAccessor(parent, constructor, field_index):
			lowered_parent ?= lower_accessor(layout, root_type, parent)
			parent_type ?= semantic_accessor_type(layout, root_type, parent)
			resolved_parent: CoreType = resolve_specialize_type(layout, parent_type)

			match resolved_parent:
				NamedType("Option", _):
					if constructor != "Some" or field_index != 0:
						None
					else:
						payload ?= single_named_type_argument(layout, resolved_parent, "Option")

						match stack_option_c_type(payload):
							Some(_):
								Some(StackOptionPayloadAccessor(lowered_parent))
							None:
								match option_runtime_layout(layout, resolved_parent):
									Some(NullableManagedOptionLayout):
										Some(NullableOptionPayloadAccessor(lowered_parent))
									_:
										lower_generic_variant_accessor(
											layout,
											lowered_parent,
											resolved_parent,
											constructor,
											field_index,
										)
				StackResultType(_, _):
					if field_index != 0:
						None
					else if constructor == "Ok":
						if semantic_accessor_is_root(parent):
							Some(StackResultOkPayloadAccessor(lowered_parent))
						else:
							Some(
								BoxedStackResultOkPayloadAccessor(
									lowered_parent,
									c_type_name(resolved_parent),
								),
							)
					else if constructor == "Err":
						if semantic_accessor_is_root(parent):
							Some(StackResultErrPayloadAccessor(lowered_parent))
						else:
							Some(
								BoxedStackResultErrPayloadAccessor(
									lowered_parent,
									c_type_name(resolved_parent),
								),
							)
					else:
						None
				BoxedResultType(_, _):
					if constructor == "Ok" and field_index == 0:
						Some(BoxedResultOkPayloadAccessor(lowered_parent))
					else if constructor == "Err" and field_index == 0:
						Some(BoxedResultErrPayloadAccessor(lowered_parent))
					else:
						None
				_:
					lower_generic_variant_accessor(
						layout,
						lowered_parent,
						resolved_parent,
						constructor,
						field_index,
					)


private pure func constructor_test(
	layout: CoreSpecializeLayout,
	root_type: CoreType,
	accessor: CoreSemanticMatchAccessor,
	constructor: String,
) -> Option[CoreConstructorMatchTest]:
	scrutinee_type ?= semantic_accessor_type(layout, root_type, accessor)
	resolved_type: CoreType = resolve_specialize_type(layout, scrutinee_type)

	match resolved_type:
		NamedType("Option", _):
			payload ?= single_named_type_argument(layout, resolved_type, "Option")

			match stack_option_c_type(payload):
				Some(option_c_type):
					if constructor == "Some":
						Some(StackOptionSomeConstructorTest(option_c_type))
					else if constructor == "None":
						Some(StackOptionNoneConstructorTest(option_c_type))
					else:
						None
				None:
					match option_runtime_layout(layout, resolved_type):
						Some(NullableManagedOptionLayout):
							if constructor == "Some":
								Some(NullableOptionSomeConstructorTest)
							else if constructor == "None":
								Some(NullableOptionNoneConstructorTest)
							else:
								None
						_:
							variant ?= find_union_variant(layout.program, "Option", constructor)
							Some(UnionTagConstructorTest(variant.tag_c_name, "Option"))
		StackResultType(_, _):
			if constructor == "Ok":
				Some(StackResultOkConstructorTest(c_type_name(resolved_type)))
			else if constructor == "Err":
				Some(StackResultErrConstructorTest(c_type_name(resolved_type)))
			else:
				None
		BoxedResultType(_, _):
			if constructor == "Ok":
				Some(BoxedResultOkConstructorTest)
			else if constructor == "Err":
				Some(BoxedResultErrConstructorTest)
			else:
				None
		EnumType("Bool") | NamedType("Bool", _):
			if constructor == "True":
				Some(BoolTrueConstructorTest)
			else if constructor == "False":
				Some(BoolFalseConstructorTest)
			else:
				None
		EnumType(type_name):
			variant ?= find_enum_variant(layout.program, type_name, constructor)
			Some(EnumConstructorTest(variant.c_name))
		UnionType(type_name) | NamedType(type_name, _):
			variant ?= find_union_variant(layout.program, type_name, constructor)
			Some(UnionTagConstructorTest(variant.tag_c_name, type_name))
		_:
			None


private pure func lower_binding(
	layout: CoreSpecializeLayout,
	root_type: CoreType,
	binding: CoreSemanticMatchBinding,
) -> Option[CoreMatchBinding]:
	typ ?= semantic_accessor_type(layout, root_type, binding.accessor)
	accessor ?= lower_accessor(layout, root_type, binding.accessor)

	mode: CoreMatchBindingMode = match binding.mode:
		MatchBorrowBindingMode:
			MatchBorrowBindingMode
		MatchOwnBindingMode:
			MatchOwnBindingMode

	Some({
		variable = binding.variable,
		typ = typ,
		accessor = accessor,
		mode = mode,
	})


private pure func lower_bindings(
	layout: CoreSpecializeLayout,
	root_type: CoreType,
	bindings: List[CoreSemanticMatchBinding],
) -> Option[List[CoreMatchBinding]]:
	var lowered: List[CoreMatchBinding] = []
	var failed: Bool = False

	for binding in bindings:
		match lower_binding(layout, root_type, binding):
			Some(value):
				lowered = lowered.append(value)
			None:
				failed = True
				break

	if failed:
		None
	else:
		Some(lowered)


private pure func lower_literal_case(
	layout: CoreSpecializeLayout,
	root: CoreExpr,
	result_type: CoreType,
	loc: CoreSourceLoc,
	match_case: SemanticLiteralMatchCaseView,
) -> Option[LoweredSemanticLiteralMatchCase]:
	root_type: CoreType = core_expr_type(root)

	match match_case.semantic_body:
		SemanticMatchLeaf(bindings, body):
			lowered_bindings ?= lower_bindings(layout, root_type, bindings)
			Some({
				literal_value = match_case.semantic_literal,
				bindings_value = lowered_bindings,
				body_expr = body,
			})
		SemanticMatchFail:
			None
		_:
			body ?= lower_tree_expr(layout, root, match_case.semantic_body, result_type, loc)
			Some({
				literal_value = match_case.semantic_literal,
				bindings_value = [],
				body_expr = body,
			})


private pure func lower_literal_cases(
	layout: CoreSpecializeLayout,
	root: CoreExpr,
	result_type: CoreType,
	loc: CoreSourceLoc,
	cases: List[SemanticLiteralMatchCaseView],
) -> Option[List[LoweredSemanticLiteralMatchCase]]:
	var lowered: List[LoweredSemanticLiteralMatchCase] = []
	var failed: Bool = False

	for match_case in cases:
		match lower_literal_case(layout, root, result_type, loc, match_case):
			Some(value):
				lowered = lowered.append(value)
			None:
				failed = True
				break

	if failed:
		None
	else:
		Some(lowered)


private pure func lower_literal_fallback(
	layout: CoreSpecializeLayout,
	root: CoreExpr,
	tree: CoreSemanticMatchTree,
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreLiteralMatchFallback]:
	match tree:
		SemanticMatchFail:
			Some(LiteralMatchFallbackFail)
		SemanticMatchLeaf(bindings, body):
			if bindings.is_empty():
				Some(LiteralMatchFallbackBody(body))
			else:
				lowered_bindings ?= lower_bindings(layout, core_expr_type(root), bindings)
				Some(LiteralMatchFallbackBindings(lowered_bindings, body))
		_:
			body ?= lower_tree_expr(layout, root, tree, result_type, loc)
			Some(LiteralMatchFallbackBody(body))


private pure func lower_constructor_literal_match(
	layout: CoreSpecializeLayout,
	root: CoreExpr,
	accessor: CoreSemanticMatchAccessor,
	cases: List[SemanticLiteralMatchCaseView],
	fallback: CoreSemanticMatchTree,
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreConstructorLiteralMatch]:
	root_type: CoreType = core_expr_type(root)
	lowered_accessor ?= lower_accessor(layout, root_type, accessor)
	scrutinee_type ?= semantic_accessor_type(layout, root_type, accessor)
	lowered_cases ?= lower_literal_cases(layout, root, result_type, loc, cases)
	lowered_fallback ?= lower_literal_fallback(layout, root, fallback, result_type, loc)

	Some({
		accessor = lowered_accessor,
		scrutinee_type = scrutinee_type,
		cases = lowered_cases.map(
			func(
				match_case,
			): core_literal_match_case(
				match_case.literal_value,
				match_case.bindings_value,
				match_case.body_expr,
			),
		),
		fallback = lowered_fallback,
		result_type = result_type,
		loc = loc,
	})


private pure func lower_length_branch(
	layout: CoreSpecializeLayout,
	root: CoreExpr,
	tree: CoreSemanticMatchTree,
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreConstructorLengthMatchBranch]:
	match tree:
		SemanticMatchLeaf(bindings, body):
			lowered_bindings ?= lower_bindings(layout, core_expr_type(root), bindings)
			Some({
				bindings = lowered_bindings,
				body = ConstructorMatchBodyExpr(body),
			})
		SemanticMatchFail:
			None
		_:
			body ?= lower_constructor_body(layout, root, tree, result_type, loc)
			Some({
				bindings = [],
				body = body,
			})


private pure func lower_length_cases(
	layout: CoreSpecializeLayout,
	root: CoreExpr,
	cases: List[CoreSemanticLengthMatchCase],
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Option[List[CoreConstructorLengthMatchCase]]:
	var lowered: List[CoreConstructorLengthMatchCase] = []
	var failed: Bool = False

	for match_case in cases:
		match lower_length_branch(layout, root, match_case.body, result_type, loc):
			Some(branch):
				lowered = lowered.append({
					length = match_case.length,
					branch = branch,
				})
			None:
				failed = True
				break

	if failed:
		None
	else:
		Some(lowered)


private pure func lower_length_geq(
	layout: CoreSpecializeLayout,
	root: CoreExpr,
	geq: Option[CoreSemanticLengthMatchGeq],
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Option[LoweredLengthGeq]:
	match geq:
		Some(value):
			branch ?= lower_length_branch(layout, root, value.body, result_type, loc)
			Some(LoweredLengthGeqValue({
				minimum_length = value.minimum_length,
				branch = branch,
			}))
		None:
			Some(LoweredLengthGeqAbsent)


private pure func lower_optional_length_branch(
	layout: CoreSpecializeLayout,
	root: CoreExpr,
	tree: Option[CoreSemanticMatchTree],
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Option[LoweredLengthFallback]:
	match tree:
		Some(SemanticMatchFail):
			Some(LoweredLengthFallbackAbsent)
		Some(value):
			branch ?= lower_length_branch(layout, root, value, result_type, loc)
			Some(LoweredLengthFallbackValue(branch))
		None:
			Some(LoweredLengthFallbackAbsent)


private pure func lower_constructor_length_match(
	layout: CoreSpecializeLayout,
	root: CoreExpr,
	accessor: CoreSemanticMatchAccessor,
	cases: List[CoreSemanticLengthMatchCase],
	geq: Option[CoreSemanticLengthMatchGeq],
	fallback: Option[CoreSemanticMatchTree],
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreConstructorLengthMatch]:
	lowered_accessor ?= lower_accessor(layout, core_expr_type(root), accessor)
	lowered_cases ?= lower_length_cases(layout, root, cases, result_type, loc)
	geq_projection ?= lower_length_geq(layout, root, geq, result_type, loc)
	fallback_projection ?= lower_optional_length_branch(layout, root, fallback, result_type, loc)

	lowered_geq: Option[CoreConstructorLengthMatchGeq] = match geq_projection:
		LoweredLengthGeqValue(value):
			Some(value)
		LoweredLengthGeqAbsent:
			None

	lowered_fallback: Option[CoreConstructorLengthMatchBranch] = match fallback_projection:
		LoweredLengthFallbackValue(value):
			Some(value)
		LoweredLengthFallbackAbsent:
			None

	Some({
		accessor = lowered_accessor,
		cases = lowered_cases,
		geq = lowered_geq,
		fallback = lowered_fallback,
		result_type = result_type,
		loc = loc,
	})


private pure func lower_constructor_body(
	layout: CoreSpecializeLayout,
	root: CoreExpr,
	tree: CoreSemanticMatchTree,
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreConstructorMatchBody]:
	match tree:
		SemanticMatchLeaf(_, body):
			Some(ConstructorMatchBodyExpr(body))
		SemanticConstructorMatch(accessor, cases, fallback):
			body ?= lower_constructor_expr(
				layout,
				root,
				accessor,
				cases,
				fallback,
				result_type,
				loc,
			)
			Some(ConstructorMatchBodyExpr(body))
		SemanticLiteralMatch(accessor, cases, fallback):
			match_info ?= lower_constructor_literal_match(
				layout,
				root,
				accessor,
				semantic_literal_match_case_views(cases),
				fallback,
				result_type,
				loc,
			)
			Some(ConstructorMatchBodyLiteral(match_info))
		SemanticLengthMatch(accessor, cases, geq, fallback):
			match_info ?= lower_constructor_length_match(
				layout,
				root,
				accessor,
				cases,
				geq,
				fallback,
				result_type,
				loc,
			)
			Some(ConstructorMatchBodyLength(match_info))
		SemanticMatchFail:
			None


private pure func lower_constructor_case(
	layout: CoreSpecializeLayout,
	root: CoreExpr,
	accessor: CoreSemanticMatchAccessor,
	match_case: CoreSemanticConstructorMatchCase,
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreConstructorMatchCase]:
	root_type: CoreType = core_expr_type(root)
	lowered_accessor ?= lower_accessor(layout, root_type, accessor)
	test ?= constructor_test(layout, root_type, accessor, match_case.constructor)

	match match_case.body:
		SemanticMatchLeaf(bindings, body):
			lowered_bindings ?= lower_bindings(layout, root_type, bindings)
			Some({
				constructor = match_case.constructor,
				accessor = lowered_accessor,
				test = test,
				bindings = lowered_bindings,
				body = ConstructorMatchBodyExpr(body),
			})
		SemanticMatchFail:
			None
		_:
			body ?= lower_constructor_body(layout, root, match_case.body, result_type, loc)
			Some({
				constructor = match_case.constructor,
				accessor = lowered_accessor,
				test = test,
				bindings = [],
				body = body,
			})


private pure func lower_constructor_cases(
	layout: CoreSpecializeLayout,
	root: CoreExpr,
	accessor: CoreSemanticMatchAccessor,
	cases: List[CoreSemanticConstructorMatchCase],
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Option[List[CoreConstructorMatchCase]]:
	var lowered: List[CoreConstructorMatchCase] = []
	var failed: Bool = False

	for match_case in cases:
		match lower_constructor_case(layout, root, accessor, match_case, result_type, loc):
			Some(value):
				lowered = lowered.append(value)
			None:
				failed = True
				break

	if failed:
		None
	else:
		Some(lowered)


private pure func lower_constructor_fallback(
	layout: CoreSpecializeLayout,
	root: CoreExpr,
	fallback: Option[CoreSemanticMatchTree],
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreConstructorMatchFallback]:
	match fallback:
		None | Some(SemanticMatchFail):
			Some(ConstructorMatchFallbackFail)
		Some(SemanticMatchLeaf(bindings, body)):
			if bindings.is_empty():
				Some(ConstructorMatchFallbackBody(body))
			else:
				lowered_bindings ?= lower_bindings(layout, core_expr_type(root), bindings)
				Some(ConstructorMatchFallbackBindings(lowered_bindings, body))
		Some(tree):
			body ?= lower_tree_expr(layout, root, tree, result_type, loc)
			Some(ConstructorMatchFallbackBody(body))


private pure func lower_constructor_expr(
	layout: CoreSpecializeLayout,
	root: CoreExpr,
	accessor: CoreSemanticMatchAccessor,
	cases: List[CoreSemanticConstructorMatchCase],
	fallback: Option[CoreSemanticMatchTree],
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreExpr]:
	lowered_cases ?= lower_constructor_cases(layout, root, accessor, cases, result_type, loc)
	lowered_fallback ?= lower_constructor_fallback(layout, root, fallback, result_type, loc)

	Some(
		ConstructorMatchExpr(
			root,
			NoReleasePolicy,
			lowered_cases,
			lowered_fallback,
			result_type,
			loc,
		),
	)


private pure func lower_tree_expr(
	layout: CoreSpecializeLayout,
	root: CoreExpr,
	tree: CoreSemanticMatchTree,
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreExpr]:
	match tree:
		SemanticMatchLeaf(bindings, body):
			lowered_bindings ?= lower_bindings(layout, core_expr_type(root), bindings)

			leaf_fallback: CoreLiteralMatchFallback = if lowered_bindings.is_empty():
				LiteralMatchFallbackBody(body)
			else:
				LiteralMatchFallbackBindings(lowered_bindings, body)

			match_info: CoreConstructorLiteralMatch = {
				accessor = RootAccessor,
				scrutinee_type = core_expr_type(root),
				cases = [],
				fallback = leaf_fallback,
				result_type = result_type,
				loc = loc
			}
			Some(AccessorLiteralMatchExpr(root, NoReleasePolicy, match_info, result_type, loc))
		SemanticConstructorMatch(accessor, cases, fallback):
			lower_constructor_expr(layout, root, accessor, cases, fallback, result_type, loc)
		SemanticLiteralMatch(accessor, cases, fallback):
			match_info ?= lower_constructor_literal_match(
				layout,
				root,
				accessor,
				semantic_literal_match_case_views(cases),
				fallback,
				result_type,
				loc,
			)

			match accessor:
				RootSemanticMatchAccessor:
					Some(
						LiteralMatchExpr(
							root,
							match_info.cases,
							match_info.fallback,
							result_type,
							loc,
						),
					)
				_:
					Some(
						AccessorLiteralMatchExpr(
							root,
							NoReleasePolicy,
							match_info,
							result_type,
							loc,
						),
					)
		SemanticLengthMatch(accessor, cases, geq, fallback):
			match_info ?= lower_constructor_length_match(
				layout,
				root,
				accessor,
				cases,
				geq,
				fallback,
				result_type,
				loc,
			)
			Some(LengthMatchExpr(root, NoReleasePolicy, match_info, result_type, loc))
		SemanticMatchFail:
			None


private pure func match_temp_var(owner_def_id: Int, loc: CoreSourceLoc) -> Option[CoreVar]:
	match loc:
		KnownSourceLoc(span):
			Some({
				name = "$blorp$match_scrut$${owner_def_id}$${span.line}$${span.column}$${span.end_line}$${span.end_column}",
				uniq = 0,
				def_id = None,
			})
		SyntheticSourceLoc:
			None


private pure func call_without_contract_returns_owned(kind: CoreCallKind) -> Bool:
	match kind:
		UnknownCall:
			False
		DeferredTraitCall(_, _):
			False
		SelectedTraitCall(_, _, _, _):
			False
		SelectedDirectCall(_):
			False
		IntrinsicCall(_):
			False
		_:
			True


private pure func match_scrutinee_needs_release(
	layout: CoreSpecializeLayout,
	ownership: PerceusEnv,
	scrutinee: CoreExpr,
) -> Bool:
	match scrutinee:
		VarExpr(_, _, _) | FieldExpr(_, _, _, _) | TupleFieldExpr(_, _, _, _):
			False
		CastExpr(inner, _, _) | UnboxExpr(_, inner, _, _):
			match_scrutinee_needs_release(layout, ownership, inner)
		_:
			policy: CoreReleasePolicy = cleanup_release_policy_for_type(
				resolve_specialize_type(
					layout,
					core_expr_type(scrutinee),
				),
			)

			match policy:
				NoReleasePolicy:
					False
				_:
					match scrutinee:
						CallExpr(kind, _, args, return_type, _):
							match contract_for_call(ownership, kind, args.length(), return_type):
								Some(contract):
									match contract.result:
										ReturnOwned:
											True
										_:
											False
								None:
									call_without_contract_returns_owned(kind)
						_:
							True


private pure func match_scrutinee_release_policy(
	layout: CoreSpecializeLayout,
	ownership: PerceusEnv,
	scrutinee: CoreExpr,
) -> CoreReleasePolicy:
	if match_scrutinee_needs_release(layout, ownership, scrutinee):
		cleanup_release_policy_for_type(resolve_specialize_type(layout, core_expr_type(scrutinee)))
	else:
		NoReleasePolicy


private pure func apply_root_match_release_policy(
	expr: CoreExpr,
	policy: CoreReleasePolicy,
) -> CoreExpr:
	match expr:
		AccessorLiteralMatchExpr(scrutinee, _, match_info, typ, loc):
			AccessorLiteralMatchExpr(scrutinee, policy, match_info, typ, loc)
		LengthMatchExpr(scrutinee, _, match_info, typ, loc):
			LengthMatchExpr(scrutinee, policy, match_info, typ, loc)
		ConstructorMatchExpr(scrutinee, _, cases, fallback, typ, loc):
			ConstructorMatchExpr(scrutinee, policy, cases, fallback, typ, loc)
		_:
			expr


private pure func lower_semantic_match(
	layout: CoreSpecializeLayout,
	ownership: PerceusEnv,
	owner_def_id: Int,
	scrutinee: CoreExpr,
	tree: CoreSemanticMatchTree,
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreExpr]:
	release_policy: CoreReleasePolicy = match_scrutinee_release_policy(layout, ownership, scrutinee)

	match scrutinee:
		VarExpr(_, _, _):
			lowered ?= lower_tree_expr(layout, scrutinee, tree, result_type, loc)
			Some(apply_root_match_release_policy(lowered, release_policy))
		_:
			temp_var ?= match_temp_var(owner_def_id, loc)
			temp_type: CoreType = core_expr_type(scrutinee)
			temp_expr: CoreExpr = VarExpr(temp_var, temp_type, loc)
			lowered_body ?= lower_tree_expr(layout, temp_expr, tree, result_type, loc)
			body: CoreExpr = apply_root_match_release_policy(lowered_body, release_policy)
			Some(LetExpr(temp_var, False, temp_type, scrutinee, body))


private pure func typed_accessor_to_semantic(
	accessor: CoreAccessor,
) -> Option[CoreSemanticMatchAccessor]:
	match accessor:
		RootAccessor:
			Some(RootSemanticMatchAccessor)
		TupleFieldAccessor(parent, index, _):
			lowered_parent ?= typed_accessor_to_semantic(parent)
			Some(TupleFieldSemanticMatchAccessor(lowered_parent, index))
		ListElementAccessor(parent, index):
			lowered_parent ?= typed_accessor_to_semantic(parent)
			Some(ListElementSemanticMatchAccessor(lowered_parent, index))
		ListSpreadAccessor(parent, offset):
			lowered_parent ?= typed_accessor_to_semantic(parent)
			Some(ListSpreadSemanticMatchAccessor(lowered_parent, offset))
		VariantFieldAccessor(parent, _, constructor, field_index) | ErasedVariantFieldAccessor(parent, _, constructor, field_index):
			lowered_parent ?= typed_accessor_to_semantic(parent)
			Some(VariantFieldSemanticMatchAccessor(lowered_parent, constructor, field_index))
		StackOptionPayloadAccessor(parent) | NullableOptionPayloadAccessor(parent):
			lowered_parent ?= typed_accessor_to_semantic(parent)
			Some(VariantFieldSemanticMatchAccessor(lowered_parent, "Some", 0))
		StackResultOkPayloadAccessor(parent) | BoxedStackResultOkPayloadAccessor(parent, _) | BoxedResultOkPayloadAccessor(parent):
			lowered_parent ?= typed_accessor_to_semantic(parent)
			Some(VariantFieldSemanticMatchAccessor(lowered_parent, "Ok", 0))
		StackResultErrPayloadAccessor(parent) | BoxedStackResultErrPayloadAccessor(parent, _) | BoxedResultErrPayloadAccessor(parent):
			lowered_parent ?= typed_accessor_to_semantic(parent)
			Some(VariantFieldSemanticMatchAccessor(lowered_parent, "Err", 0))


private pure func reproject_typed_match_binding(
	layout: CoreSpecializeLayout,
	root_type: CoreType,
	binding: CoreMatchBinding,
) -> CoreMatchBinding:
	match typed_accessor_to_semantic(binding.accessor):
		Some(semantic_accessor):
			match semantic_accessor_type(layout, root_type, semantic_accessor):
				Some(typ):
					match lower_accessor(layout, root_type, semantic_accessor):
						Some(accessor):
							{ binding |
								typ = typ,
								accessor = accessor
							}
						None:
							binding
				None:
					binding
		None:
			binding


private pure func reproject_typed_match_case(
	layout: CoreSpecializeLayout,
	root_type: CoreType,
	match_case: CoreConstructorMatchCase,
) -> CoreConstructorMatchCase:
	test: CoreConstructorMatchTest = match match_case.accessor:
		RootAccessor:
			constructor_test(
				layout,
				root_type,
				RootSemanticMatchAccessor,
				match_case.constructor,
			).get_or(match_case.test)
		_:
			match_case.test

	{ match_case |
		test = test,
		bindings = match_case.bindings.map(
			func(binding): reproject_typed_match_binding(layout, root_type, binding),
		)
	}


private pure func project_expr(
	layout: CoreSpecializeLayout,
	ownership: PerceusEnv,
	owner_def_id: Int,
	expr: CoreExpr,
) -> CoreExpr:
	children_projected: CoreExpr = match expr:
		SeqExpr(_, _):
			spine = CoreTraverse.split_core_sequence(expr)
			CoreTraverse.rebuild_core_sequence({
				preceding_items = spine.preceding_items.map(
					func(item): project_expr(layout, ownership, owner_def_id, item),
				),
				final_item = project_expr(layout, ownership, owner_def_id, spine.final_item),
			})
		_:
			CoreTraverse.map_core_expr_children(
				expr,
				func(child): project_expr(layout, ownership, owner_def_id, child),
			)

	match children_projected:
		DupExpr(variable, value_type, _, body, typ, loc):
			if singleton_constructor_value(layout, variable, value_type):
				DupExpr(variable, value_type, NoRetainPolicy, body, typ, loc)
			else:
				children_projected
		DropExpr(variable, value_type, _, body, typ, loc):
			if singleton_constructor_value(layout, variable, value_type):
				DropExpr(variable, value_type, NoReleasePolicy, body, typ, loc)
			else:
				children_projected
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			root_type: CoreType = core_expr_type(scrutinee)
			ConstructorMatchExpr(
				scrutinee,
				release_policy,
				cases.map(
					func(match_case): reproject_typed_match_case(layout, root_type, match_case),
				),
				fallback,
				typ,
				loc,
			)
		SemanticMatchExpr(scrutinee, tree, result_type, loc):
			lower_semantic_match(
				layout,
				ownership,
				owner_def_id,
				scrutinee,
				tree,
				result_type,
				loc,
			).get_or(children_projected)
		_:
			children_projected


private pure func project_function(
	layout: CoreSpecializeLayout,
	ownership: PerceusEnv,
	function_info: CoreFunction,
) -> CoreFunction:
	{ function_info |
		body = function_info.body.map(
			func(body): project_expr(layout, ownership, function_info.def_id, body),
		)
	}


private pure func project_global(
	layout: CoreSpecializeLayout,
	ownership: PerceusEnv,
	global: CoreGlobal,
) -> CoreGlobal:
	{ global | init = project_expr(layout, ownership, global.def_id, global.init) }


private pure func project_decl(
	layout: CoreSpecializeLayout,
	ownership: PerceusEnv,
	decl: CoreDecl,
) -> CoreDecl:
	match decl:
		FunctionDecl(function_info):
			FunctionDecl(project_function(layout, ownership, function_info))
		GlobalDecl(global):
			GlobalDecl(project_global(layout, ownership, global))
		_:
			decl


pure func project_backend_matches(program: CoreProgram) -> CoreProgram:
	layout: CoreSpecializeLayout = build_specialize_layout(program)
	ownership: PerceusEnv = build_env(program)
	{ program | decls = program.decls.map(func(decl): project_decl(layout, ownership, decl)) }
