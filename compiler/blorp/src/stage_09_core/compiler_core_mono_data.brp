-- Generic record and union specialization for Core.
--
-- Requests are discovered from the same canonical type roots used by Core
-- reachability: declaration-owned types and every expression result type.
-- Rewriting itself uses the exhaustive Core mapper, which also updates
-- metadata-only type slots without maintaining a second expression walker.
import:
	../stage_05_types/compiler_type: compiler_is_global_abi_type_name
	compiler_core_json:
		CoreClosureCapture,
		CoreDecl(
			EnumDecl,
			FunctionDecl,
			GlobalDecl,
			HeapRecordDecl,
			ImplDecl,
			TraitDecl,
			TypeAliasDecl,
			UnionDecl,
			ValueRecordDecl,
		),
		CoreExpr(SeqExpr),
		CoreFunction,
		CoreFunctionKind(ClosureBodyFunction),
		CoreHeapRecordDecl,
		CoreHeapRecordField,
		CoreImplDecl,
		CoreParam,
		CoreProgram,
		CoreReleasePolicy(ArcReleasePolicy, NoReleasePolicy),
		CoreTraitMethod,
		CoreType(
			BoxedResultType,
			EnumType,
			FunctionType,
			HeapRecordType,
			NamedType,
			RangeType,
			SelfType,
			StackResultType,
			TensorType,
			TupleType,
			TypeParameterType,
			UnionType,
			ValueRecordType,
			VoidType,
		),
		CoreTypeAliasDecl,
		CoreUnionDecl,
		CoreUnionField,
		CoreUnionPayloadStorage(ErasedUnionPayloadStorage, TypedUnionPayloadStorage),
		CoreUnionVariant,
		CoreValueRecordDecl,
		CoreValueRecordField,
		core_expr_type,
	compiler_core_mono:
		CoreMonoSubstitution,
		CoreMonoSubstitutionValue(TypeSubstitution),
		apply_type_substitution,
		core_type_contains_parameter,
		mangle_generic_data_name,
	compiler_core_traverse as CoreTraverse
	compiler_core_type_policy as CoreTypePolicy


record CoreMonoDataSpecialization {
	program: CoreProgram,
	next_def_id: Int
}


private union CoreMonoDataTemplate:
	MonoValueRecordTemplate(CoreValueRecordDecl)
	MonoHeapRecordTemplate(CoreHeapRecordDecl)
	MonoUnionTemplate(CoreUnionDecl)


private record CoreMonoDataRequest {
	source_name: String,
	args: List[CoreType],
	concrete_name: String
}


private record CoreMonoDataTypeRewrite {
	typ: CoreType,
	requests: List[CoreMonoDataRequest]
}


private record CoreMonoDataTypeListRewrite {
	types: List[CoreType],
	requests: List[CoreMonoDataRequest]
}


private record CoreMonoDataRewriteContext {
	templates: List[CoreMonoDataTemplate],
	aliases: List[CoreTypeAliasDecl],
	active_aliases: List[String],
	unresolved_type_params: List[String]
}


private record CoreMonoDataMaterializationState {
	requests: List[CoreMonoDataRequest],
	generated: List[CoreDecl],
	next_def_id: Int
}


private record CoreMonoDataOrderState {
	ordered: List[CoreDecl],
	active_names: List[String],
	complete_names: List[String]
}


private pure func template_name(template: CoreMonoDataTemplate) -> String:
	match template:
		MonoValueRecordTemplate(record_decl):
			record_decl.name
		MonoHeapRecordTemplate(record_decl):
			record_decl.name
		MonoUnionTemplate(union_decl):
			union_decl.name


private pure func template_type_params(template: CoreMonoDataTemplate) -> List[String]:
	match template:
		MonoValueRecordTemplate(record_decl):
			record_decl.type_params
		MonoHeapRecordTemplate(record_decl):
			record_decl.type_params
		MonoUnionTemplate(union_decl):
			union_decl.type_params


private pure func collect_generic_data_templates(
	program: CoreProgram,
) -> List[CoreMonoDataTemplate]:
	var templates: List[CoreMonoDataTemplate] = []

	for decl in program.decls:
		match decl:
			ValueRecordDecl(record_decl):
				if (
					not record_decl.type_params.is_empty()
					and not compiler_is_global_abi_type_name(record_decl.name)
				):
					templates = templates.append(MonoValueRecordTemplate(record_decl))
			HeapRecordDecl(record_decl):
				if (
					not record_decl.type_params.is_empty()
					and not compiler_is_global_abi_type_name(record_decl.name)
				):
					templates = templates.append(MonoHeapRecordTemplate(record_decl))
			UnionDecl(union_decl):
				if (
					not union_decl.type_params.is_empty()
					and not compiler_is_global_abi_type_name(union_decl.name)
				):
					templates = templates.append(MonoUnionTemplate(union_decl))
			_:
				void

	templates


private pure func collect_type_aliases(program: CoreProgram) -> List[CoreTypeAliasDecl]:
	var aliases: List[CoreTypeAliasDecl] = []

	for decl in program.decls:
		match decl:
			TypeAliasDecl(alias_decl):
				aliases = aliases.append(alias_decl)
			_:
				void

	aliases


private pure func rewrite_context(
	templates: List[CoreMonoDataTemplate],
	aliases: List[CoreTypeAliasDecl],
	unresolved_type_params: List[String],
) -> CoreMonoDataRewriteContext:
	{
		templates = templates,
		aliases = aliases,
		active_aliases = [],
		unresolved_type_params = unresolved_type_params
	}


private pure func find_template(
	templates: List[CoreMonoDataTemplate],
	name: String,
) -> Option[CoreMonoDataTemplate]:
	var found: Option[CoreMonoDataTemplate] = None

	for template in templates:
		if template_name(template) == name:
			found = Some(template)
			break

	found


private pure func find_transparent_alias(
	aliases: List[CoreTypeAliasDecl],
	name: String,
) -> Option[CoreTypeAliasDecl]:
	var found: Option[CoreTypeAliasDecl] = None

	for alias_decl in aliases:
		if alias_decl.name == name and not alias_decl.is_opaque:
			found = Some(alias_decl)
			break

	found


private pure func request_exists(
	requests: List[CoreMonoDataRequest],
	concrete_name: String,
) -> Bool:
	var found: Bool = False

	for request in requests:
		if request.concrete_name == concrete_name:
			found = True
			break

	found


private pure func append_request(
	requests: List[CoreMonoDataRequest],
	source_name: String,
	args: List[CoreType],
	concrete_name: String,
) -> List[CoreMonoDataRequest]:
	if request_exists(requests, concrete_name):
		requests
	else:
		requests.append({
			source_name = source_name,
			args = args,
			concrete_name = concrete_name,
		})


private pure func types_are_concrete(
	unresolved_type_params: List[String],
	types: List[CoreType],
) -> Bool:
	var concrete: Bool = True

	for typ in types:
		if core_type_contains_parameter(unresolved_type_params, typ):
			concrete = False
			break

	concrete


private pure func rewrite_type_list(
	context: CoreMonoDataRewriteContext,
	requests: List[CoreMonoDataRequest],
	types: List[CoreType],
) -> CoreMonoDataTypeListRewrite:
	var rewritten: List[CoreType] = []
	var current_requests: List[CoreMonoDataRequest] = requests

	for typ in types:
		result: CoreMonoDataTypeRewrite = rewrite_data_type(context, current_requests, typ)
		rewritten = rewritten.append(result.typ)
		current_requests = result.requests

	{
		types = rewritten,
		requests = current_requests
	}


private pure func rewrite_data_type(
	context: CoreMonoDataRewriteContext,
	requests: List[CoreMonoDataRequest],
	typ: CoreType,
) -> CoreMonoDataTypeRewrite:
	match typ:
		TypeParameterType(_) | SelfType:
			{
				typ = typ,
				requests = requests
			}
		NamedType(name, args):
			args_result: CoreMonoDataTypeListRewrite = rewrite_type_list(context, requests, args)

			match find_transparent_alias(context.aliases, name):
				Some(alias_decl):
					if (
						not context.active_aliases.contains(name)
						and alias_decl.type_params.length() == args_result.types.length()
					):
						substitution: CoreMonoSubstitution = type_param_substitution(
							alias_decl.type_params,
							args_result.types,
						)
						rewrite_data_type(
							{ context | active_aliases = context.active_aliases.append(name) },
							args_result.requests,
							apply_type_substitution(substitution, alias_decl.target),
						)
					else:
						{
							typ = NamedType(name, args_result.types),
							requests = args_result.requests
						}
				None:
					match find_template(context.templates, name):
						Some(template):
							if (
								not args_result.types.is_empty()
								and template_type_params(
									template,
								).length() == args_result.types.length()
								and types_are_concrete(
									context.unresolved_type_params,
									args_result.types,
								)
							):
								match mangle_generic_data_name(name, args_result.types):
									Some(concrete_name):
										{
											typ = NamedType(concrete_name, []),
											requests = append_request(
												args_result.requests,
												name,
												args_result.types,
												concrete_name,
											)
										}
									None:
										{
											typ = NamedType(name, args_result.types),
											requests = args_result.requests
										}
							else:
								{
									typ = NamedType(name, args_result.types),
									requests = args_result.requests
								}
						None:
							{
								typ = NamedType(name, args_result.types),
								requests = args_result.requests
							}
		FunctionType(is_pure, params, return_type):
			params_result: CoreMonoDataTypeListRewrite = rewrite_type_list(
				context,
				requests,
				params,
			)
			return_result: CoreMonoDataTypeRewrite = rewrite_data_type(
				context,
				params_result.requests,
				return_type,
			)
			{
				typ = FunctionType(is_pure, params_result.types, return_result.typ),
				requests = return_result.requests
			}
		StackResultType(value_type, error_type):
			value_result: CoreMonoDataTypeRewrite = rewrite_data_type(context, requests, value_type)
			error_result: CoreMonoDataTypeRewrite = rewrite_data_type(
				context,
				value_result.requests,
				error_type,
			)
			{
				typ = StackResultType(value_result.typ, error_result.typ),
				requests = error_result.requests
			}
		BoxedResultType(value_type, error_type):
			value_result: CoreMonoDataTypeRewrite = rewrite_data_type(context, requests, value_type)
			error_result: CoreMonoDataTypeRewrite = rewrite_data_type(
				context,
				value_result.requests,
				error_type,
			)
			{
				typ = BoxedResultType(value_result.typ, error_result.typ),
				requests = error_result.requests
			}
		TensorType(info):
			element_result: CoreMonoDataTypeRewrite = rewrite_data_type(
				context,
				requests,
				info.element_type,
			)
			{
				typ = TensorType({ info | element_type = element_result.typ }),
				requests = element_result.requests
			}
		TupleType(items):
			items_result: CoreMonoDataTypeListRewrite = rewrite_type_list(context, requests, items)
			{
				typ = TupleType(items_result.types),
				requests = items_result.requests
			}
		VoidType | EnumType(_) | ValueRecordType(_) | HeapRecordType(_) | UnionType(_) | RangeType:
			{
				typ = typ,
				requests = requests
			}


private pure func collect_type_request(
	context: CoreMonoDataRewriteContext,
	requests: List[CoreMonoDataRequest],
	typ: CoreType,
) -> List[CoreMonoDataRequest]:
	rewrite_data_type(context, requests, typ).requests


private pure func collect_param_requests(
	context: CoreMonoDataRewriteContext,
	requests: List[CoreMonoDataRequest],
	params: List[CoreParam],
) -> List[CoreMonoDataRequest]:
	var current: List[CoreMonoDataRequest] = requests

	for param in params:
		current = collect_type_request(context, current, param.typ)

	current


private pure func collect_capture_requests(
	context: CoreMonoDataRewriteContext,
	requests: List[CoreMonoDataRequest],
	captures: List[CoreClosureCapture],
) -> List[CoreMonoDataRequest]:
	var current: List[CoreMonoDataRequest] = requests

	for capture in captures:
		current = collect_type_request(context, current, capture.typ)

	current


private pure func collect_function_kind_requests(
	context: CoreMonoDataRewriteContext,
	requests: List[CoreMonoDataRequest],
	function_kind: CoreFunctionKind,
) -> List[CoreMonoDataRequest]:
	match function_kind:
		ClosureBodyFunction(abi):
			collect_capture_requests(
				context,
				collect_param_requests(context, requests, abi.params),
				abi.captures,
			)
		_:
			requests


-- Use an explicit worklist so large right-associated SeqExpr blocks do not
-- recurse through the compiler stack.
private pure func collect_expr_requests(
	context: CoreMonoDataRewriteContext,
	requests: List[CoreMonoDataRequest],
	root: CoreExpr,
) -> List[CoreMonoDataRequest]:
	var pending: List[CoreExpr] = [root]
	var index: Int = 0
	var current: List[CoreMonoDataRequest] = requests

	while index < pending.length():
		match pending.get(index):
			Some(expr):
				current = collect_type_request(context, current, core_expr_type(expr))
				pending = pending.concat(CoreTraverse.immediate_core_expr_children(expr))
			None:
				break

		index += 1

	current


private pure func collect_optional_expr_requests(
	context: CoreMonoDataRewriteContext,
	requests: List[CoreMonoDataRequest],
	body: Option[CoreExpr],
) -> List[CoreMonoDataRequest]:
	match body:
		Some(expr):
			collect_expr_requests(context, requests, expr)
		None:
			requests


private pure func collect_function_requests(
	templates: List[CoreMonoDataTemplate],
	aliases: List[CoreTypeAliasDecl],
	requests: List[CoreMonoDataRequest],
	function: CoreFunction,
) -> List[CoreMonoDataRequest]:
	context: CoreMonoDataRewriteContext = rewrite_context(templates, aliases, function.type_params)
	var current: List[CoreMonoDataRequest] = collect_param_requests(
		context,
		requests,
		function.params,
	)
	current = collect_type_request(context, current, function.return_type)
	current = collect_function_kind_requests(context, current, function.function_kind)
	collect_optional_expr_requests(context, current, function.body)


private pure func collect_union_requests(
	context: CoreMonoDataRewriteContext,
	requests: List[CoreMonoDataRequest],
	variants: List[CoreUnionVariant],
) -> List[CoreMonoDataRequest]:
	var current: List[CoreMonoDataRequest] = requests

	for variant in variants:
		for field in variant.fields:
			current = collect_type_request(context, current, field.typ)

	current


private pure func collect_value_record_requests(
	context: CoreMonoDataRewriteContext,
	requests: List[CoreMonoDataRequest],
	fields: List[CoreValueRecordField],
) -> List[CoreMonoDataRequest]:
	var current: List[CoreMonoDataRequest] = requests

	for field in fields:
		current = collect_type_request(context, current, field.typ)

	current


private pure func collect_heap_record_requests(
	context: CoreMonoDataRewriteContext,
	requests: List[CoreMonoDataRequest],
	fields: List[CoreHeapRecordField],
) -> List[CoreMonoDataRequest]:
	var current: List[CoreMonoDataRequest] = requests

	for field in fields:
		current = collect_type_request(context, current, field.typ)

	current


private pure func collect_trait_method_requests(
	context: CoreMonoDataRewriteContext,
	requests: List[CoreMonoDataRequest],
	methods: List[CoreTraitMethod],
) -> List[CoreMonoDataRequest]:
	var current: List[CoreMonoDataRequest] = requests

	for method in methods:
		current = collect_param_requests(context, current, method.params)
		current = collect_type_request(context, current, method.return_type)

	current


private pure func collect_impl_requests(
	templates: List[CoreMonoDataTemplate],
	aliases: List[CoreTypeAliasDecl],
	requests: List[CoreMonoDataRequest],
	impl: CoreImplDecl,
) -> List[CoreMonoDataRequest]:
	context: CoreMonoDataRewriteContext = rewrite_context(
		templates,
		aliases,
		impl.type_params.map(pure func(param): param.name),
	)
	var current: List[CoreMonoDataRequest] = collect_type_request(context, requests, impl.for_type)

	for method in impl.methods:
		current = collect_function_requests(templates, aliases, current, method)

	current


private pure func collect_decl_requests(
	templates: List[CoreMonoDataTemplate],
	aliases: List[CoreTypeAliasDecl],
	requests: List[CoreMonoDataRequest],
	decl: CoreDecl,
) -> List[CoreMonoDataRequest]:
	match decl:
		FunctionDecl(function):
			collect_function_requests(templates, aliases, requests, function)
		GlobalDecl(global):
			context: CoreMonoDataRewriteContext = rewrite_context(templates, aliases, [])
			collect_expr_requests(
				context,
				collect_type_request(context, requests, global.typ),
				global.init,
			)
		EnumDecl(_):
			requests
		UnionDecl(union_decl):
			context: CoreMonoDataRewriteContext = rewrite_context(
				templates,
				aliases,
				union_decl.type_params,
			)
			collect_union_requests(context, requests, union_decl.variants)
		ValueRecordDecl(record_decl):
			context: CoreMonoDataRewriteContext = rewrite_context(
				templates,
				aliases,
				record_decl.type_params,
			)
			collect_value_record_requests(context, requests, record_decl.fields)
		HeapRecordDecl(record_decl):
			context: CoreMonoDataRewriteContext = rewrite_context(
				templates,
				aliases,
				record_decl.type_params,
			)
			collect_heap_record_requests(context, requests, record_decl.fields)
		TypeAliasDecl(alias_decl):
			collect_type_request(
				rewrite_context(templates, aliases, alias_decl.type_params),
				requests,
				alias_decl.target,
			)
		TraitDecl(trait_decl):
			collect_trait_method_requests(
				rewrite_context(templates, aliases, trait_decl.type_params),
				requests,
				trait_decl.methods,
			)
		ImplDecl(impl):
			collect_impl_requests(templates, aliases, requests, impl)


private pure func collect_program_requests(
	templates: List[CoreMonoDataTemplate],
	aliases: List[CoreTypeAliasDecl],
	program: CoreProgram,
) -> List[CoreMonoDataRequest]:
	var requests: List[CoreMonoDataRequest] = []

	for decl in program.decls:
		requests = collect_decl_requests(templates, aliases, requests, decl)

	requests


private pure func type_param_substitution(
	type_params: List[String],
	args: List[CoreType],
) -> CoreMonoSubstitution:
	var substitution: CoreMonoSubstitution = []
	var index: Int = 0

	while index < type_params.length():
		match (type_params.get(index), args.get(index)):
			(Some(type_param), Some(arg)):
				substitution = substitution.append((type_param, TypeSubstitution(arg)))
			_:
				break

		index += 1

	substitution


private pure func request_source_name_for_concrete_name(
	requests: List[CoreMonoDataRequest],
	concrete_name: String,
) -> Option[String]:
	var source_name: Option[String] = None

	for request in requests:
		if request.concrete_name == concrete_name:
			source_name = Some(request.source_name)
			break

	source_name


private pure func materialized_data_release_policy(
	templates: List[CoreMonoDataTemplate],
	requests: List[CoreMonoDataRequest],
	typ: CoreType,
) -> CoreReleasePolicy:
	match typ:
		NamedType(concrete_name, args):
			if args.is_empty():
				match request_source_name_for_concrete_name(requests, concrete_name):
					Some(source_name):
						match find_template(templates, source_name):
							Some(MonoHeapRecordTemplate(_)) | Some(MonoUnionTemplate(_)):
								ArcReleasePolicy
							Some(MonoValueRecordTemplate(_)):
								NoReleasePolicy
							None:
								CoreTypePolicy.cleanup_release_policy_for_type(typ)
					None:
						CoreTypePolicy.cleanup_release_policy_for_type(typ)
			else:
				CoreTypePolicy.cleanup_release_policy_for_type(typ)
		_:
			CoreTypePolicy.cleanup_release_policy_for_type(typ)


private pure func materialize_value_record(
	templates: List[CoreMonoDataTemplate],
	aliases: List[CoreTypeAliasDecl],
	state: CoreMonoDataMaterializationState,
	request: CoreMonoDataRequest,
	record_decl: CoreValueRecordDecl,
) -> CoreMonoDataMaterializationState:
	substitution: CoreMonoSubstitution = type_param_substitution(
		record_decl.type_params,
		request.args,
	)
	context: CoreMonoDataRewriteContext = rewrite_context(templates, aliases, [])
	var fields: List[CoreValueRecordField] = []
	var requests: List[CoreMonoDataRequest] = state.requests

	for field in record_decl.fields:
		substituted: CoreType = apply_type_substitution(substitution, field.typ)
		result: CoreMonoDataTypeRewrite = rewrite_data_type(context, requests, substituted)
		fields = fields.append({ field | typ = result.typ })
		requests = result.requests

	{
		requests = requests,
		generated = state.generated.append(ValueRecordDecl({ record_decl |
					name = request.concrete_name,
					type_params = [],
					fields = fields
				})),
		next_def_id = state.next_def_id
	}


private pure func materialize_heap_record(
	templates: List[CoreMonoDataTemplate],
	aliases: List[CoreTypeAliasDecl],
	state: CoreMonoDataMaterializationState,
	request: CoreMonoDataRequest,
	record_decl: CoreHeapRecordDecl,
) -> CoreMonoDataMaterializationState:
	substitution: CoreMonoSubstitution = type_param_substitution(
		record_decl.type_params,
		request.args,
	)
	context: CoreMonoDataRewriteContext = rewrite_context(templates, aliases, [])
	var fields: List[CoreHeapRecordField] = []
	var requests: List[CoreMonoDataRequest] = state.requests

	for field in record_decl.fields:
		substituted: CoreType = apply_type_substitution(substitution, field.typ)
		result: CoreMonoDataTypeRewrite = rewrite_data_type(context, requests, substituted)
		fields = fields.append({ field |
				typ = result.typ,
				release_policy = materialized_data_release_policy(
					templates,
					result.requests,
					result.typ,
				)
			})
		requests = result.requests

	{
		requests = requests,
		generated = state.generated.append(HeapRecordDecl({ record_decl |
					name = request.concrete_name,
					type_params = [],
					fields = fields
				})),
		next_def_id = state.next_def_id
	}


private pure func materialize_union_fields(
	context: CoreMonoDataRewriteContext,
	substitution: CoreMonoSubstitution,
	requests: List[CoreMonoDataRequest],
	fields: List[CoreUnionField],
) -> (List[CoreUnionField], List[CoreMonoDataRequest]):
	var concrete_fields: List[CoreUnionField] = []
	var current_requests: List[CoreMonoDataRequest] = requests

	for field in fields:
		substituted: CoreType = apply_type_substitution(substitution, field.typ)
		result: CoreMonoDataTypeRewrite = rewrite_data_type(context, current_requests, substituted)
		concrete_fields = concrete_fields.append({ field |
				typ = result.typ,
				release_policy = materialized_data_release_policy(
					context.templates,
					result.requests,
					result.typ,
				)
			})
		current_requests = result.requests

	(concrete_fields, current_requests)


private pure func materialize_union(
	templates: List[CoreMonoDataTemplate],
	aliases: List[CoreTypeAliasDecl],
	state: CoreMonoDataMaterializationState,
	request: CoreMonoDataRequest,
	union_decl: CoreUnionDecl,
) -> CoreMonoDataMaterializationState:
	substitution: CoreMonoSubstitution = type_param_substitution(
		union_decl.type_params,
		request.args,
	)
	context: CoreMonoDataRewriteContext = rewrite_context(templates, aliases, [])
	var variants: List[CoreUnionVariant] = []
	var requests: List[CoreMonoDataRequest] = state.requests
	var next_def_id: Int = state.next_def_id

	for variant in union_decl.variants:
		(fields, next_requests) = materialize_union_fields(
			context,
			substitution,
			requests,
			variant.fields,
		)
		variants = variants.append({ variant |
				c_name = "__def_${next_def_id}_${variant.name}",
				tag_c_name = "TAG_${request.concrete_name}_${variant.name}",
				fields = fields,
				def_id = Some(next_def_id)
			})
		requests = next_requests
		next_def_id += 1

	payload_storage: CoreUnionPayloadStorage = if CoreTypePolicy.is_runtime_erased_union_payload_type_name(
		union_decl.name,
	):
		ErasedUnionPayloadStorage
	else:
		TypedUnionPayloadStorage

	{
		requests = requests,
		generated = state.generated.append(UnionDecl({ union_decl |
					name = request.concrete_name,
					type_params = [],
					payload_storage = payload_storage,
					variants = variants
				})),
		next_def_id = next_def_id
	}


private pure func materialize_request(
	templates: List[CoreMonoDataTemplate],
	aliases: List[CoreTypeAliasDecl],
	state: CoreMonoDataMaterializationState,
	request: CoreMonoDataRequest,
) -> CoreMonoDataMaterializationState:
	match find_template(templates, request.source_name):
		Some(MonoValueRecordTemplate(record_decl)):
			materialize_value_record(templates, aliases, state, request, record_decl)
		Some(MonoHeapRecordTemplate(record_decl)):
			materialize_heap_record(templates, aliases, state, request, record_decl)
		Some(MonoUnionTemplate(union_decl)):
			materialize_union(templates, aliases, state, request, union_decl)
		None:
			state


private pure func materialize_requests(
	templates: List[CoreMonoDataTemplate],
	aliases: List[CoreTypeAliasDecl],
	requests: List[CoreMonoDataRequest],
	next_def_id: Int,
) -> CoreMonoDataMaterializationState:
	var state: CoreMonoDataMaterializationState = {
		requests = requests,
		generated = [],
		next_def_id = next_def_id
	}
	var index: Int = 0

	while index < state.requests.length():
		match state.requests.get(index):
			Some(request):
				state = materialize_request(templates, aliases, state, request)
			None:
				break

		index += 1

	state


private pure func generated_data_name(decl: CoreDecl) -> Option[String]:
	match decl:
		ValueRecordDecl(record_decl):
			Some(record_decl.name)
		HeapRecordDecl(record_decl):
			Some(record_decl.name)
		UnionDecl(union_decl):
			Some(union_decl.name)
		_:
			None


private pure func find_generated_data_decl(
	generated: List[CoreDecl],
	name: String,
) -> Option[CoreDecl]:
	var found: Option[CoreDecl] = None

	for decl in generated:
		match generated_data_name(decl):
			Some(decl_name):
				if decl_name == name:
					found = Some(decl)
					break
			None:
				void

	found


private pure func append_type_dependency_names(names: List[String], typ: CoreType) -> List[String]:
	match typ:
		NamedType(name, args):
			var result: List[String] = if names.contains(name):
				names
			else:
				names.append(name)

			for arg in args:
				result = append_type_dependency_names(result, arg)

			result
		FunctionType(_, params, return_type):
			var result: List[String] = names

			for param in params:
				result = append_type_dependency_names(result, param)

			append_type_dependency_names(result, return_type)
		StackResultType(value_type, error_type) | BoxedResultType(value_type, error_type):
			append_type_dependency_names(
				append_type_dependency_names(names, value_type),
				error_type,
			)
		TensorType(info):
			append_type_dependency_names(names, info.element_type)
		TupleType(items):
			var result: List[String] = names

			for item in items:
				result = append_type_dependency_names(result, item)

			result
		ValueRecordType(name) | HeapRecordType(name) | UnionType(name):
			if names.contains(name):
				names
			else:
				names.append(name)
		VoidType | TypeParameterType(_) | SelfType | EnumType(_) | RangeType:
			names


private pure func generated_data_dependencies(decl: CoreDecl) -> List[String]:
	var names: List[String] = []

	match decl:
		ValueRecordDecl(record_decl):
			for field in record_decl.fields:
				names = append_type_dependency_names(names, field.typ)
		HeapRecordDecl(record_decl):
			for field in record_decl.fields:
				names = append_type_dependency_names(names, field.typ)
		UnionDecl(union_decl):
			for variant in union_decl.variants:
				for field in variant.fields:
					names = append_type_dependency_names(names, field.typ)
		_:
			void

	names


private pure func names_without(names: List[String], removed: String) -> List[String]:
	var remaining: List[String] = []

	for name in names:
		if name != removed:
			remaining = remaining.append(name)

	remaining


private pure func order_generated_data_decl(
	generated: List[CoreDecl],
	state: CoreMonoDataOrderState,
	decl: CoreDecl,
) -> CoreMonoDataOrderState:
	match generated_data_name(decl):
		Some(name):
			if state.complete_names.contains(name) or state.active_names.contains(name):
				state
			else:
				var current: CoreMonoDataOrderState = {
					ordered = state.ordered,
					active_names = state.active_names.append(name),
					complete_names = state.complete_names
				}

				for dependency_name in generated_data_dependencies(decl):
					match find_generated_data_decl(generated, dependency_name):
						Some(dependency):
							current = order_generated_data_decl(generated, current, dependency)
						None:
							void

				{
					ordered = current.ordered.append(decl),
					active_names = names_without(current.active_names, name),
					complete_names = current.complete_names.append(name)
				}
		None:
			state


private pure func order_generated_data_declarations(generated: List[CoreDecl]) -> List[CoreDecl]:
	var state: CoreMonoDataOrderState = {
		ordered = [],
		active_names = [],
		complete_names = []
	}

	for decl in generated:
		state = order_generated_data_decl(generated, state, decl)

	state.ordered


private pure func rewrite_type_without_requests(
	context: CoreMonoDataRewriteContext,
	typ: CoreType,
) -> CoreType:
	rewrite_data_type(context, [], typ).typ


private pure func rewrite_sequence_types(
	context: CoreMonoDataRewriteContext,
	expr: CoreExpr,
) -> CoreExpr:
	spine = CoreTraverse.split_core_sequence(expr)
	var preceding_items: List[CoreExpr] = []

	for item in spine.preceding_items:
		preceding_items = preceding_items.append(rewrite_expr_types(context, item))

	CoreTraverse.rebuild_core_sequence(
		{
			preceding_items = preceding_items,
			final_item = rewrite_expr_types(context, spine.final_item)
		},
	)


private pure func rewrite_expr_types(
	context: CoreMonoDataRewriteContext,
	expr: CoreExpr,
) -> CoreExpr:
	match expr:
		SeqExpr(_, _):
			rewrite_sequence_types(context, expr)
		_:
			CoreTraverse.map_core_expr_children_and_types_with_context(
				expr,
				context,
				rewrite_expr_types,
				rewrite_type_without_requests,
			)


private pure func rewrite_params(
	context: CoreMonoDataRewriteContext,
	params: List[CoreParam],
) -> List[CoreParam]:
	var rewritten: List[CoreParam] = []

	for param in params:
		rewritten = rewritten.append(
			{ param | typ = rewrite_type_without_requests(context, param.typ) },
		)

	rewritten


private pure func rewrite_captures(
	context: CoreMonoDataRewriteContext,
	captures: List[CoreClosureCapture],
) -> List[CoreClosureCapture]:
	var rewritten: List[CoreClosureCapture] = []

	for capture in captures:
		rewritten = rewritten.append(
			{ capture | typ = rewrite_type_without_requests(context, capture.typ) },
		)

	rewritten


private pure func rewrite_function_kind(
	context: CoreMonoDataRewriteContext,
	function_kind: CoreFunctionKind,
) -> CoreFunctionKind:
	match function_kind:
		ClosureBodyFunction(abi):
			ClosureBodyFunction({ abi |
					params = rewrite_params(context, abi.params),
					captures = rewrite_captures(context, abi.captures)
				})
		_:
			function_kind


private pure func rewrite_optional_body(
	context: CoreMonoDataRewriteContext,
	body: Option[CoreExpr],
) -> Option[CoreExpr]:
	match body:
		Some(expr):
			Some(rewrite_expr_types(context, expr))
		None:
			None


private pure func rewrite_function(
	templates: List[CoreMonoDataTemplate],
	aliases: List[CoreTypeAliasDecl],
	function: CoreFunction,
) -> CoreFunction:
	context: CoreMonoDataRewriteContext = rewrite_context(templates, aliases, function.type_params)
	params: List[CoreParam] = rewrite_params(context, function.params)
	return_type: CoreType = rewrite_type_without_requests(context, function.return_type)
	function_kind: CoreFunctionKind = rewrite_function_kind(context, function.function_kind)
	body: Option[CoreExpr] = rewrite_optional_body(context, function.body)

	{ function |
		params = params,
		return_type = return_type,
		function_kind = function_kind,
		body = body
	}


private pure func rewrite_union_variants(
	context: CoreMonoDataRewriteContext,
	variants: List[CoreUnionVariant],
) -> List[CoreUnionVariant]:
	var rewritten: List[CoreUnionVariant] = []

	for variant in variants:
		var fields: List[CoreUnionField] = []

		for field in variant.fields:
			fields = fields.append(
				{ field | typ = rewrite_type_without_requests(context, field.typ) },
			)

		rewritten = rewritten.append({ variant | fields = fields })

	rewritten


private pure func rewrite_value_record_fields(
	context: CoreMonoDataRewriteContext,
	fields: List[CoreValueRecordField],
) -> List[CoreValueRecordField]:
	var rewritten: List[CoreValueRecordField] = []

	for field in fields:
		rewritten = rewritten.append(
			{ field | typ = rewrite_type_without_requests(context, field.typ) },
		)

	rewritten


private pure func rewrite_heap_record_fields(
	context: CoreMonoDataRewriteContext,
	fields: List[CoreHeapRecordField],
) -> List[CoreHeapRecordField]:
	var rewritten: List[CoreHeapRecordField] = []

	for field in fields:
		rewritten = rewritten.append(
			{ field | typ = rewrite_type_without_requests(context, field.typ) },
		)

	rewritten


private pure func rewrite_trait_methods(
	context: CoreMonoDataRewriteContext,
	methods: List[CoreTraitMethod],
) -> List[CoreTraitMethod]:
	var rewritten: List[CoreTraitMethod] = []

	for method in methods:
		rewritten = rewritten.append({ method |
				params = rewrite_params(context, method.params),
				return_type = rewrite_type_without_requests(context, method.return_type)
			})

	rewritten


private pure func rewrite_impl_methods(
	templates: List[CoreMonoDataTemplate],
	aliases: List[CoreTypeAliasDecl],
	methods: List[CoreFunction],
) -> List[CoreFunction]:
	var rewritten: List[CoreFunction] = []

	for method in methods:
		rewritten = rewritten.append(rewrite_function(templates, aliases, method))

	rewritten


private pure func rewrite_decl(
	templates: List[CoreMonoDataTemplate],
	aliases: List[CoreTypeAliasDecl],
	decl: CoreDecl,
) -> CoreDecl:
	match decl:
		FunctionDecl(function):
			FunctionDecl(rewrite_function(templates, aliases, function))
		GlobalDecl(global):
			context: CoreMonoDataRewriteContext = rewrite_context(templates, aliases, [])
			typ: CoreType = rewrite_type_without_requests(context, global.typ)
			init: CoreExpr = rewrite_expr_types(context, global.init)
			GlobalDecl({ global |
					typ = typ,
					init = init
				})
		EnumDecl(enum_decl):
			EnumDecl(enum_decl)
		UnionDecl(union_decl):
			context: CoreMonoDataRewriteContext = rewrite_context(
				templates,
				aliases,
				union_decl.type_params,
			)
			UnionDecl(
				{ union_decl | variants = rewrite_union_variants(context, union_decl.variants) },
			)
		ValueRecordDecl(record_decl):
			context: CoreMonoDataRewriteContext = rewrite_context(
				templates,
				aliases,
				record_decl.type_params,
			)
			ValueRecordDecl(
				{ record_decl |
					fields = rewrite_value_record_fields(context, record_decl.fields)
				},
			)
		HeapRecordDecl(record_decl):
			context: CoreMonoDataRewriteContext = rewrite_context(
				templates,
				aliases,
				record_decl.type_params,
			)
			HeapRecordDecl(
				{ record_decl | fields = rewrite_heap_record_fields(context, record_decl.fields) },
			)
		TypeAliasDecl(alias_decl):
			context: CoreMonoDataRewriteContext = rewrite_context(
				templates,
				aliases,
				alias_decl.type_params,
			)
			TypeAliasDecl(
				{ alias_decl |
					target = rewrite_type_without_requests(context, alias_decl.target)
				},
			)
		TraitDecl(trait_decl):
			context: CoreMonoDataRewriteContext = rewrite_context(
				templates,
				aliases,
				trait_decl.type_params,
			)
			TraitDecl({ trait_decl | methods = rewrite_trait_methods(context, trait_decl.methods) })
		ImplDecl(impl):
			context: CoreMonoDataRewriteContext = rewrite_context(
				templates,
				aliases,
				impl.type_params.map(pure func(param): param.name),
			)
			ImplDecl({ impl |
					for_type = rewrite_type_without_requests(context, impl.for_type),
					methods = rewrite_impl_methods(templates, aliases, impl.methods)
				})


private pure func rewrite_program(
	templates: List[CoreMonoDataTemplate],
	aliases: List[CoreTypeAliasDecl],
	program: CoreProgram,
) -> CoreProgram:
	var decls: List[CoreDecl] = []

	for decl in program.decls:
		decls = decls.append(rewrite_decl(templates, aliases, decl))

	{ program | decls = decls }


pure func specialize_generic_data(
	program: CoreProgram,
	next_def_id: Int,
) -> CoreMonoDataSpecialization:
	templates: List[CoreMonoDataTemplate] = collect_generic_data_templates(program)
	aliases: List[CoreTypeAliasDecl] = collect_type_aliases(program)

	if templates.is_empty():
		{
			program = program,
			next_def_id = next_def_id
		}
	else:
		requests: List[CoreMonoDataRequest] = collect_program_requests(templates, aliases, program)
		state: CoreMonoDataMaterializationState = materialize_requests(
			templates,
			aliases,
			requests,
			next_def_id,
		)
		ordered_generated: List[CoreDecl] = order_generated_data_declarations(state.generated)
		combined: CoreProgram = {
			program | decls = program.decls.concat(ordered_generated)
		}

		{
			program = rewrite_program(templates, aliases, combined),
			next_def_id = state.next_def_id
		}
