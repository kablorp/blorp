-- Isolate semantic literal-case field access from backend literal-case types.
--
-- Both phase-specific records intentionally use `literal` and `body` fields.
-- Keeping their inspection in separate modules avoids ambiguous record labels
-- while preserving precise semantic and backend IR types.
import:
	compiler_core_json: CoreLiteral, CoreSemanticLiteralMatchCase, CoreSemanticMatchTree


record SemanticLiteralMatchCaseView {
	semantic_literal: CoreLiteral,
	semantic_body: CoreSemanticMatchTree
}


pure func semantic_literal_match_case_views(
	cases: List[CoreSemanticLiteralMatchCase],
) -> List[SemanticLiteralMatchCaseView]:
	cases.map(func(match_case):
		{
			semantic_literal = match_case.literal,
			semantic_body = match_case.body
		}
	)
