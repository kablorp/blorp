-- Blorp-owned Core-to-Core pipeline slices.
--
-- This module is the home for contiguous IR stage ownership after the OCaml
-- handoff. The bridge should decode protocol JSON and call these pure
-- functions; pass ordering should live here instead of in the dispatcher or C
-- emitter.
import:
	../stage_08_core_lower/compiler_core_list_layout as CoreListLayout
	compiler_core_closure as CoreClosure
	compiler_core_consume_specialize as CoreConsumeSpecialize
	compiler_core_dce as CoreDce
	compiler_core_fairness: insert_cooperative_checkpoints
	compiler_core_json: CoreProgram
	compiler_core_perceus as CorePerceus
	compiler_core_pipeline_stage:
		CorePipelineStage(
			ClosureStage,
			ConsumeSpecializeStage,
			DceStage,
			FinalStage,
			ListLayoutStage,
			PerceusStage,
			PostClosureTailStage,
			PostDceTailStage,
			PostPerceusTailStage,
			PreClosureTailStage,
			PreDceTailStage,
			ReuseStage,
			SpecializeStage,
		),
	compiler_core_prepare as CorePrepare
	compiler_core_resolve as CoreResolve
	compiler_core_resource: rewrite_resource_program
	compiler_core_reuse as CoreReuse
	compiler_core_specialize as CoreSpecialize


-- Backend-ready phase value produced after the complete late ownership tail.
record PreparedCoreProgram {
	program: CoreProgram
}


pure func run_reuse_stage(program: CoreProgram) -> CoreProgram:
	CoreReuse.rewrite_post_perceus_program(program)


pure func run_list_layout_stage(program: CoreProgram) -> CoreProgram:
	CoreListLayout.annotate_list_layouts(program)


pure func run_closure_stage(program: CoreProgram) -> CoreProgram:
	CoreClosure.convert_program(run_reuse_stage(program))


pure func run_post_closure_tail(program: CoreProgram) -> CoreProgram:
	resource_program: CoreProgram = rewrite_resource_program(program)
	checked_program: CoreProgram = insert_cooperative_checkpoints(resource_program)
	prepared_program: CoreProgram = CorePrepare.prepare_program(checked_program)

	CoreReuse.rewrite_prepared_program(prepared_program)


pure func run_pre_closure_tail(program: CoreProgram) -> CoreProgram:
	run_post_closure_tail(CoreClosure.convert_program(program))


pure func run_post_perceus_tail(program: CoreProgram) -> CoreProgram:
	run_pre_closure_tail(run_reuse_stage(program))


pure func run_consume_specialize_stage(program: CoreProgram) -> CoreProgram:
	CoreConsumeSpecialize.rewrite_program(program)


pure func run_dce_stage(program: CoreProgram) -> CoreProgram:
	CoreDce.prune_program(program)


pure func run_specialize_stage(program: CoreProgram) -> CoreProgram:
	CoreClosure.adapt_function_refs_program(CoreSpecialize.specialize_program(program))


pure func run_perceus_stage(program: CoreProgram) -> CoreProgram:
	consumed_program: CoreProgram = run_consume_specialize_stage(program)
	ownership_ready_program: CoreProgram = CorePrepare.prepare_dict_literals_for_ownership(
		consumed_program,
	)

	CorePerceus.insert_drops_program(ownership_ready_program)


pure func run_post_dce_tail(program: CoreProgram) -> CoreProgram:
	run_post_perceus_tail(run_perceus_stage(program))


pure func run_pre_dce_tail(program: CoreProgram) -> PreparedCoreProgram:
	function_refs_adapted: CoreProgram = run_specialize_stage(program)
	resolved_program: CoreProgram = CoreResolve.resolve_callable_id_calls(function_refs_adapted)
	{program = run_post_dce_tail(run_dce_stage(resolved_program))}


pure func run_core_pipeline_stage(stage: CorePipelineStage, program: CoreProgram) -> CoreProgram:
	match stage:
		ListLayoutStage:
			run_list_layout_stage(program)
		SpecializeStage:
			run_specialize_stage(program)
		PreDceTailStage:
			run_pre_dce_tail(program).program
		PostDceTailStage:
			run_post_dce_tail(program)
		PostPerceusTailStage:
			run_post_perceus_tail(program)
		PreClosureTailStage:
			run_pre_closure_tail(program)
		PostClosureTailStage:
			run_post_closure_tail(program)
		ConsumeSpecializeStage:
			run_consume_specialize_stage(run_dce_stage(program))
		DceStage:
			run_dce_stage(program)
		PerceusStage:
			run_perceus_stage(run_dce_stage(program))
		ReuseStage:
			run_reuse_stage(run_perceus_stage(run_dce_stage(program)))
		ClosureStage:
			run_closure_stage(run_perceus_stage(run_dce_stage(program)))
		FinalStage:
			run_pre_dce_tail(program).program
