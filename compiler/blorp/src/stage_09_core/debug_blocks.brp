-- Debug-block lowering for the Blorp-owned Core pipeline.
--
-- Debug blocks remain explicit through Core lowering. This is the Blorp
-- implementation of the Core debug-stage contract: normal builds erase each
-- block to Void at the block's source location, while debug builds splice in
-- the recursively lowered body.
import:
	ir:
		CoreDecl(FunctionDecl, GlobalDecl, ImplDecl),
		CoreExpr(DebugBlockExpr, SeqExpr, VoidExpr),
		CoreFunction,
		CoreProgram,
		CoreType(VoidType),
	traverse as CoreTraverse


private pure func lower_debug_node(enabled: Bool, expr: CoreExpr) -> CoreExpr:
	match expr:
		DebugBlockExpr(body, _, loc):
			if enabled:
				body
			else:
				VoidExpr(VoidType, loc)
		_:
			expr


private pure func lower_sequence(enabled: Bool, expr: CoreExpr) -> CoreExpr:
	spine = CoreTraverse.split_core_sequence(expr)
	var preceding_items: List[CoreExpr] = []

	for item in spine.preceding_items:
		preceding_items = preceding_items.append(lower_expr(enabled, item))

	CoreTraverse.rebuild_core_sequence({
		preceding_items = preceding_items,
		final_item = lower_expr(enabled, spine.final_item),
	})


pure func lower_expr(enabled: Bool, expr: CoreExpr) -> CoreExpr:
	match expr:
		SeqExpr(_, _):
			lower_sequence(enabled, expr)
		_:
			children_lowered = CoreTraverse.map_core_expr_children_with_context(
				expr,
				enabled,
				lower_expr,
			)
			lower_debug_node(enabled, children_lowered)


private pure func lower_function(enabled: Bool, function: CoreFunction) -> CoreFunction:
	match function.body:
		Some(body):
			{ function | body = Some(lower_expr(enabled, body)) }
		None:
			function


private pure func lower_decl(enabled: Bool, decl: CoreDecl) -> CoreDecl:
	match decl:
		FunctionDecl(function):
			FunctionDecl(lower_function(enabled, function))
		GlobalDecl(global):
			GlobalDecl({ global | init = lower_expr(enabled, global.init) })
		ImplDecl(impl_decl):
			ImplDecl(
				{ impl_decl |
					methods = impl_decl.methods.map(func(method): lower_function(enabled, method))
				},
			)
		_:
			decl


pure func lower_program(enabled: Bool, program: CoreProgram) -> CoreProgram:
	{
		decls = program.decls.map(func(decl): lower_decl(enabled, decl)),
		foreign_includes = program.foreign_includes
	}
