-- Resolve explicit Core trait dispatch after monomorphization.
--
-- The typed frontend preserves trait and method identity in CoreCallKind.
-- Keeping that identity until this pass means ordinary functions never need
-- to be rediscovered from names or import tables. Concrete impls are indexed
-- once, then calls and overloadable operators are rewritten to the same
-- mangled names consumed by ordinary callable resolution.
import:
	../stage_08_core_lower/compiler_core_identity: core_ufcs_function_name
	compiler_core_builtin_registry: core_builtin_name
	compiler_core_json:
		CoreCallKind(
			BuiltinCall,
			DeferredTraitCall,
			SelectedDirectCall,
			SelectedTraitCall,
			UnknownCall,
		),
		CoreDecl(FunctionDecl, GlobalDecl, ImplDecl, TraitDecl),
		CoreDimOp(DimAdd, DimDivide, DimMultiply, DimSubtract),
		CoreExpr(BinaryExpr, CallExpr, ResourceScopeExpr, SeqExpr, UnaryExpr, VarExpr),
		CoreFunction,
		CoreFunctionKind(UnresolvedBuiltinFunction),
		CoreImplDecl,
		CoreProgram,
		CoreSourceLoc,
		CoreTensorDim(TensorDimOperation, TensorRuntimeDim, TensorStaticDim, TensorVariadicDim),
		CoreTraitDecl,
		CoreType(
			BoxedResultType,
			EnumType,
			FunctionType,
			HeapRecordType,
			NamedType,
			RangeType,
			SelfType,
			StackResultType,
			TensorType,
			TupleType,
			TypeParameterType,
			UnionType,
			ValueRecordType,
			VoidType,
		),
		CoreVar,
		core_expr_type,
	compiler_core_trait_dispatch:
		CoreTraitMethodIdentity,
		core_binary_trait_method,
		core_builtin_trait_method,
		core_trait_method_builtin_fallback_name,
		core_unary_trait_method,
	compiler_core_traverse:
		immediate_core_expr_children,
		map_core_expr_children,
		map_core_expr_children_with_context,
		map_core_sequence_items,
	compiler_core_type_policy as CoreTypePolicy
	core_trait_resolve_diagnostics: render_core_trait_no_impl_hint


record CoreTraitMissingImplDiagnostic {
	loc: CoreSourceLoc,
	trait_name: String,
	method_name: String,
	type_name: String,
	candidates: List[String]
}


record CoreTraitSelectedTargetDiagnostic {
	loc: CoreSourceLoc,
	trait_name: String,
	method_name: String,
	module_name: String,
	def_id: Int
}


union CoreTraitResolveDiagnostic:
	MissingTraitImpl(CoreTraitMissingImplDiagnostic)
	MissingSelectedTraitTarget(CoreTraitSelectedTargetDiagnostic)


private record CoreTraitImplTarget {
	trait_name: String,
	method_name: String,
	type_name: String,
	mangled_name: String
}


private record CoreGenericBuiltinTarget {
	trait_name: String,
	method_name: String,
	module_name: String,
	def_id: Int
}


private pure func generic_builtin_target_matches(
	left: CoreGenericBuiltinTarget,
	right: CoreGenericBuiltinTarget,
) -> Bool:
	(
		left.trait_name == right.trait_name
		and left.method_name == right.method_name
		and left.module_name == right.module_name
		and left.def_id == right.def_id
	)


private pure func has_generic_builtin_target(
	targets: List[CoreGenericBuiltinTarget],
	target: CoreGenericBuiltinTarget,
) -> Bool:
	targets.any(pure func(candidate): generic_builtin_target_matches(candidate, target))


private record CoreTraitResolveRegistry {
	targets: Dict[String, CoreTraitImplTarget],
	generic_builtin_targets: List[CoreGenericBuiltinTarget],
	types_by_method: Dict[String, List[String]],
	static_self_methods: Dict[String, Bool]
}


private record CoreTraitResolveContext {
	registry: CoreTraitResolveRegistry,
	in_function: Option[String],
	shadowed_names: List[String]
}


private record CoreTraitDiagnosticWork {
	expr: CoreExpr,
	shadowed_names: List[String]
}


pure func core_trait_resolve_diagnostic_message(diagnostic: CoreTraitResolveDiagnostic) -> String:
	match diagnostic:
		MissingTraitImpl(missing):
			"no impl of `${missing.method_name}` for type `${missing.type_name}` in scope"
		MissingSelectedTraitTarget(selected):
			"selected trait target `${selected.trait_name}.${selected.method_name}` " + "was not available after monomorphization"


pure func core_trait_resolve_diagnostic_hint(diagnostic: CoreTraitResolveDiagnostic) -> String:
	match diagnostic:
		MissingTraitImpl(missing):
			render_core_trait_no_impl_hint(
				missing.method_name,
				missing.type_name,
				missing.candidates,
			)
		MissingSelectedTraitTarget(selected):
			"compiler-selected target `${selected.module_name}` definition " + selected.def_id.to_string() + " was lost; report this as a compiler bug"


private pure func core_dim_op_equal(left: CoreDimOp, right: CoreDimOp) -> Bool:
	match (left, right):
		(DimAdd, DimAdd) | (DimSubtract, DimSubtract) | (DimMultiply, DimMultiply) | (DimDivide, DimDivide):
			True
		_:
			False


-- Trait resolution receives normalized post-monomorphization dimensions, so
-- structural equality is sufficient for the remaining X - X fold.
private pure func core_tensor_dim_equal(left: CoreTensorDim, right: CoreTensorDim) -> Bool:
	match (left, right):
		(TensorStaticDim(left_value), TensorStaticDim(right_value)):
			left_value == right_value
		(TensorRuntimeDim(left_name), TensorRuntimeDim(right_name)):
			left_name == right_name
		(TensorVariadicDim(left_name), TensorVariadicDim(right_name)):
			left_name == right_name
		(TensorDimOperation(left_op, left_left, left_right), TensorDimOperation(right_op, right_left, right_right)):
			(
				core_dim_op_equal(left_op, right_op)
				and core_tensor_dim_equal(left_left, right_left)
				and core_tensor_dim_equal(left_right, right_right)
			)
		_:
			False


private pure func static_dim_value(dim: CoreTensorDim) -> Option[Int]:
	match dim:
		TensorStaticDim(value):
			Some(value)
		TensorRuntimeDim(_) | TensorVariadicDim(_):
			None
		TensorDimOperation(op, left, right):
			match op:
				DimAdd:
					left_value ?= static_dim_value(left)
					right_value ?= static_dim_value(right)
					Some(left_value + right_value)
				DimSubtract:
					if core_tensor_dim_equal(left, right):
						Some(0)
					else:
						left_value ?= static_dim_value(left)
						right_value ?= static_dim_value(right)
						Some(left_value - right_value)
				DimMultiply:
					match (static_dim_value(left), static_dim_value(right)):
						(Some(left_value), Some(right_value)):
							Some(left_value * right_value)
						(Some(0), _) | (_, Some(0)):
							Some(0)
						_:
							None
				DimDivide:
					left_value ?= static_dim_value(left)

					if left_value == 0:
						Some(0)
					else:
						right_value ?= static_dim_value(right)

						if right_value > 0 and left_value % right_value == 0:
							Some(left_value / right_value)
						else:
							None


private pure func concrete_type_keys(types: List[CoreType]) -> Option[List[String]]:
	var keys: List[String] = []
	var concrete: Bool = True

	for typ in types:
		match core_trait_impl_type_key(typ):
			Some(key):
				keys = keys.append(key)
			None:
				concrete = False
				break

	if concrete:
		Some(keys)
	else:
		None


private pure func tensor_dim_keys(dims: List[CoreTensorDim]) -> Option[List[String]]:
	var keys: List[String] = []
	var concrete: Bool = True

	for dim in dims:
		match static_dim_value(dim):
			Some(value):
				keys = keys.append(value.to_string())
			None:
				concrete = False
				break

	if concrete:
		Some(keys)
	else:
		None


-- Include concrete arguments so distinct specialized impls cannot collide.
-- Fully concrete arguments are retained so parameterized impls cannot collide.
pure func core_trait_impl_type_key(typ: CoreType) -> Option[String]:
	match typ:
		NamedType(name, args):
			if args.is_empty():
				Some(name)
			else:
				keys ?= concrete_type_keys(args)
				Some(
					[name]
						.concat(keys)
						.join("_"),
				)
		StackResultType(ok_type, err_type) | BoxedResultType(ok_type, err_type):
			keys ?= concrete_type_keys([ok_type, err_type])
			Some(
				["Result"]
					.concat(keys)
					.join("_"),
			)
		EnumType(name) | ValueRecordType(name) | HeapRecordType(name) | UnionType(name):
			Some(name)
		RangeType:
			None
		TensorType(info):
			element_key ?= core_trait_impl_type_key(info.element_type)
			dim_keys ?= tensor_dim_keys(info.dims)
			Some(
				["__Array", element_key]
					.concat(dim_keys)
					.join("_"),
			)
		TupleType(items):
			keys ?= concrete_type_keys(items)
			Some("Tuple" + items
					.length()
					.to_string() + "_" + keys.join("_"))
		VoidType:
			Some("Void")
		TypeParameterType(_) | SelfType | FunctionType(_, _, _):
			None


private pure func method_key(trait_name: String, method_name: String) -> String:
	-- Length-prefixing keeps the composite key collision-free without relying
	-- on a delimiter being absent from source identifiers.
	trait_name
		.length()
		.to_string() + ":" + trait_name + method_name


private pure func target_key(trait_name: String, method_name: String, type_name: String) -> String:
	method_key(trait_name, method_name) + type_name
		.length()
		.to_string() + ":" + type_name


private pure func append_unique(items: List[String], item: String) -> List[String]:
	if items.contains(item):
		items
	else:
		items.append(item)


private pure func add_impl_target(
	registry: CoreTraitResolveRegistry,
	implementation: CoreImplDecl,
	type_name: String,
	method: CoreFunction,
) -> CoreTraitResolveRegistry:
	target: CoreTraitImplTarget = {
		trait_name = implementation.trait_name,
		method_name = method.name,
		type_name = type_name,
		mangled_name = "${implementation.trait_name}_${method.name}_${type_name}"
	}
	key: String = method_key(implementation.trait_name, method.name)
	types: List[String] = registry.types_by_method
		.get(key)
		.get_or([])

	{
		targets = registry.targets.set(
			target_key(implementation.trait_name, method.name, type_name),
			target,
		),
		generic_builtin_targets = registry.generic_builtin_targets,
		types_by_method = registry.types_by_method.set(
			key,
			append_unique(types, type_name),
		),
		static_self_methods = registry.static_self_methods
	}


private pure func collect_generic_impl(
	registry: CoreTraitResolveRegistry,
	implementation: CoreImplDecl,
) -> CoreTraitResolveRegistry:
	var targets: List[CoreGenericBuiltinTarget] = registry.generic_builtin_targets

	for method in implementation.methods:
		match method.function_kind:
			UnresolvedBuiltinFunction:
				match method.source_module:
					Some(module_name):
						target: CoreGenericBuiltinTarget = {
							trait_name = implementation.trait_name,
							method_name = method.name,
							module_name = module_name,
							def_id = method.def_id
						}

						if not has_generic_builtin_target(targets, target):
							targets = targets.append(target)
						else:
							void
					None:
						void
			_:
				void

	{ registry | generic_builtin_targets = targets }


private pure func collect_impl(
	registry: CoreTraitResolveRegistry,
	implementation: CoreImplDecl,
) -> CoreTraitResolveRegistry:
	if CoreTypePolicy.core_impl_is_generic(implementation):
		collect_generic_impl(registry, implementation)
	else:
		match core_trait_impl_type_key(implementation.for_type):
			None:
				registry
			Some(type_name):
				var updated: CoreTraitResolveRegistry = registry

				for method in implementation.methods:
					updated = add_impl_target(updated, implementation, type_name, method)

				updated


private pure func collect_trait(
	registry: CoreTraitResolveRegistry,
	trait_info: CoreTraitDecl,
) -> CoreTraitResolveRegistry:
	var static_self_methods: Dict[String, Bool] = registry.static_self_methods

	for method in trait_info.methods:
		if method.params.is_empty():
			match method.return_type:
				SelfType:
					static_self_methods = static_self_methods.set(
						method_key(trait_info.name, method.name),
						True,
					)
				_:
					void
		else:
			void

	{ registry | static_self_methods = static_self_methods }


private pure func collect_registry(program: CoreProgram) -> CoreTraitResolveRegistry:
	var registry: CoreTraitResolveRegistry = {
		targets = {},
		generic_builtin_targets = [],
		types_by_method = {},
		static_self_methods = {}
	}

	for decl in program.decls:
		registry = match decl:
			ImplDecl(implementation):
				collect_impl(registry, implementation)
			TraitDecl(trait_info):
				collect_trait(registry, trait_info)
			_:
				registry

	registry


private pure func is_integer_type_name(name: String) -> Bool:
	match name:
		"Int" | "Int8" | "Int16" | "Int32" | "Int64" | "Int128":
			True
		"UInt8" | "UInt16" | "UInt32" | "UInt64" | "UInt128":
			True
		_:
			False


private pure func has_native_operator_fast_path(typ: CoreType) -> Bool:
	match typ:
		TensorType(_) | RangeType:
			True
		NamedType(name, args):
			(
				args.is_empty()
				and ((
					is_integer_type_name(name)
					or name == "String"
					or name == "Bool"
					or name == "Char"
					or name == "Bytes"
					or name == "Fixed"
					or name == "Float"
					or name == "Float32"
					or name == "Float16"
				))
			)
		_:
			False


private pure func has_builtin_to_string_fallback(typ: CoreType) -> Bool:
	match typ:
		TensorType(_) | RangeType:
			True
		NamedType(name, args):
			(
				is_integer_type_name(name)
				or name == "List" and not args.is_empty()
				or (
					args.is_empty()
					and ((
						name == "String"
						or name == "Float"
						or name == "Float32"
						or name == "Float16"
						or name == "Bool"
						or name == "Char"
						or name == "Bytes"
						or name == "Fixed"
					))
				)
			)
		_:
			False


private pure func dispatch_type(
	registry: CoreTraitResolveRegistry,
	identity: CoreTraitMethodIdentity,
	args: List[CoreExpr],
	return_type: CoreType,
) -> Option[CoreType]:
	match args.get(0):
		Some(receiver):
			Some(core_expr_type(receiver))
		None:
			if (
				registry.static_self_methods
					.get(method_key(identity.trait_name, identity.method_name))
					.get_or(False)
			):
				Some(return_type)
			else:
				None


private pure func target_for_dispatch(
	registry: CoreTraitResolveRegistry,
	identity: CoreTraitMethodIdentity,
	dispatch: CoreType,
) -> Option[CoreTraitImplTarget]:
	type_name ?= core_trait_impl_type_key(dispatch)
	registry.targets.get(target_key(identity.trait_name, identity.method_name, type_name))


private pure func unresolved_trait_call_kind(
	registry: CoreTraitResolveRegistry,
	original_kind: CoreCallKind,
	callee: CoreExpr,
) -> CoreCallKind:
	match original_kind:
		SelectedTraitCall(trait_name, method_name, module_name, def_id):
			match callee:
				VarExpr(variable, _, _):
					target: CoreGenericBuiltinTarget = {
						trait_name = trait_name,
						method_name = method_name,
						module_name = module_name,
						def_id = def_id
					}

					if (
						has_generic_builtin_target(registry.generic_builtin_targets, target)
						and variable.name == core_ufcs_function_name(module_name, method_name)
					):
						SelectedDirectCall(def_id)
					else:
						original_kind
				_:
					original_kind
		_:
			original_kind


private pure func rewrite_callee(
	callee: CoreExpr,
	mangled_name: String,
	fallback_loc: CoreSourceLoc,
) -> CoreExpr:
	match callee:
		VarExpr(variable, typ, loc):
			VarExpr(
				{ variable |
					name = mangled_name,
					def_id = None
				},
				typ,
				loc,
			)
		_:
			VarExpr(
				{
					name = mangled_name,
					uniq = 0,
					def_id = None
				},
				NamedType(
					"",
					[],
				),
				fallback_loc,
			)


-- Prelude builtins are type-dispatched sentinels handled by later Core
-- stages. A trait lookup miss must preserve that path instead of reporting a
-- missing user impl. Explicit trait policy wins where the runtime sentinel's
-- canonical source name differs from the call-site name.
private pure func trait_builtin_fallback_name(identity: CoreTraitMethodIdentity) -> Option[String]:
	match core_trait_method_builtin_fallback_name(identity):
		Some(name):
			Some(name)
		None:
			core_builtin_name("", identity.method_name).map(func(_): identity.method_name)


private pure func rewrite_unresolved_trait_call(
	registry: CoreTraitResolveRegistry,
	identity: CoreTraitMethodIdentity,
	original_kind: CoreCallKind,
	callee: CoreExpr,
	args: List[CoreExpr],
	return_type: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	kind: CoreCallKind = unresolved_trait_call_kind(registry, original_kind, callee)

	fallback_callee: CoreExpr = match kind:
		DeferredTraitCall(_, _):
			match trait_builtin_fallback_name(identity):
				Some(name):
					rewrite_callee(callee, name, loc)
				None:
					callee
		_:
			callee

	CallExpr(kind, fallback_callee, args, return_type, loc)


private pure func rewrite_trait_call(
	context: CoreTraitResolveContext,
	identity: CoreTraitMethodIdentity,
	original_kind: CoreCallKind,
	callee: CoreExpr,
	args: List[CoreExpr],
	return_type: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	shadowed: Bool = match callee:
		VarExpr(variable, _, _):
			context.shadowed_names.contains(variable.name)
		_:
			False

	if shadowed:
		CallExpr(UnknownCall, callee, args, return_type, loc)
	else:
		match dispatch_type(context.registry, identity, args, return_type):
			Some(dispatch):
				match target_for_dispatch(context.registry, identity, dispatch):
					Some(target):
						primitive_self_call: Bool = (
							context.in_function == Some(target.mangled_name)
							and has_native_operator_fast_path(dispatch)
						)

						if primitive_self_call:
							CallExpr(UnknownCall, callee, args, return_type, loc)
						else:
							CallExpr(
								UnknownCall,
								rewrite_callee(callee, target.mangled_name, loc),
								args,
								return_type,
								loc,
							)
					None:
						rewrite_unresolved_trait_call(
							context.registry,
							identity,
							original_kind,
							callee,
							args,
							return_type,
							loc,
						)
			None:
				rewrite_unresolved_trait_call(
					context.registry,
					identity,
					original_kind,
					callee,
					args,
					return_type,
					loc,
				)


private pure func rewrite_operator(
	context: CoreTraitResolveContext,
	identity: CoreTraitMethodIdentity,
	operands: List[CoreExpr],
	return_type: CoreType,
	loc: CoreSourceLoc,
	original: CoreExpr,
) -> CoreExpr:
	match operands.get(0):
		Some(first):
			dispatch: CoreType = core_expr_type(first)

			if has_native_operator_fast_path(dispatch):
				original
			else:
				match target_for_dispatch(context.registry, identity, dispatch):
					Some(target):
						CallExpr(
							UnknownCall,
							VarExpr(
								{
									name = target.mangled_name,
									uniq = 0,
									def_id = None
								},
								NamedType(
									"",
									[],
								),
								loc,
							),
							operands,
							return_type,
							loc,
						)
					None:
						original
		None:
			original


private pure func rewrite_expr(context: CoreTraitResolveContext, expr: CoreExpr) -> CoreExpr:
	children_rewritten: CoreExpr = match expr:
		ResourceScopeExpr(scope, typ, loc):
			shadowed_context: CoreTraitResolveContext = { context |
				shadowed_names = append_unique(context.shadowed_names, scope.variable.name)
			}
			ResourceScopeExpr(
				{ scope |
					acquire = rewrite_expr(context, scope.acquire),
					body = rewrite_expr(shadowed_context, scope.body),
					cleanup = rewrite_expr(shadowed_context, scope.cleanup)
				},
				typ,
				loc,
			)
		SeqExpr(_, _):
			map_core_sequence_items(expr, pure func(item): rewrite_expr(context, item))
		_:
			map_core_expr_children_with_context(expr, context, rewrite_expr)

	match children_rewritten:
		CallExpr(DeferredTraitCall(trait_name, method_name), callee, args, return_type, loc):
			rewrite_trait_call(
				context,
				{
					trait_name = trait_name,
					method_name = method_name
				},
				DeferredTraitCall(
					trait_name,
					method_name,
				),
				callee,
				args,
				return_type,
				loc,
			)
		CallExpr(SelectedTraitCall(trait_name, method_name, module_name, def_id), callee, args, return_type, loc):
			rewrite_trait_call(
				context,
				{
					trait_name = trait_name,
					method_name = method_name
				},
				SelectedTraitCall(
					trait_name,
					method_name,
					module_name,
					def_id,
				),
				callee,
				args,
				return_type,
				loc,
			)
		CallExpr(BuiltinCall(name), callee, args, return_type, loc):
			match core_builtin_trait_method(name):
				Some(identity):
					match args.get(0):
						Some(arg):
							if has_builtin_to_string_fallback(core_expr_type(arg)):
								children_rewritten
							else:
								rewrite_trait_call(
									context,
									identity,
									DeferredTraitCall(identity.trait_name, identity.method_name),
									callee,
									args,
									return_type,
									loc,
								)
						None:
							children_rewritten
				None:
					children_rewritten
		BinaryExpr(op, left, right, return_type, loc):
			rewrite_operator(
				context,
				core_binary_trait_method(op),
				[left, right],
				return_type,
				loc,
				children_rewritten,
			)
		UnaryExpr(op, operand, return_type, loc):
			match core_unary_trait_method(op):
				Some(identity):
					rewrite_operator(
						context,
						identity,
						[operand],
						return_type,
						loc,
						children_rewritten,
					)
				None:
					children_rewritten
		_:
			children_rewritten


private pure func rewrite_function(
	registry: CoreTraitResolveRegistry,
	function_info: CoreFunction,
	in_function: String,
) -> CoreFunction:
	if not function_info.type_params.is_empty():
		function_info
	else:
		match function_info.body:
			Some(body):
				{ function_info | body = Some(
						rewrite_expr(
							{
								registry = registry,
								in_function = Some(in_function),
								shadowed_names = []
							},
							body,
						),
					) }
			None:
				function_info


private pure func rewrite_impl(
	registry: CoreTraitResolveRegistry,
	implementation: CoreImplDecl,
) -> CoreImplDecl:
	if CoreTypePolicy.core_impl_is_generic(implementation):
		implementation
	else:
		match core_trait_impl_type_key(implementation.for_type):
			Some(type_name):
				var methods: List[CoreFunction] = []

				for method in implementation.methods:
					methods = methods.append(
						rewrite_function(
							registry,
							method,
							"${implementation.trait_name}_${method.name}_${type_name}",
						),
					)

				{ implementation | methods = methods }
			None:
				implementation


private pure func rewrite_program(
	program: CoreProgram,
	registry: CoreTraitResolveRegistry,
) -> CoreProgram:
	var decls: List[CoreDecl] = []

	for decl in program.decls:
		rewritten: CoreDecl = match decl:
			FunctionDecl(function_info):
				FunctionDecl(rewrite_function(registry, function_info, function_info.name))
			GlobalDecl(global):
				GlobalDecl(
					{ global | init = rewrite_expr(
							{
								registry = registry,
								in_function = None,
								shadowed_names = []
							},
							global.init,
						) },
				)
			ImplDecl(implementation):
				ImplDecl(rewrite_impl(registry, implementation))
			_:
				decl

		decls = decls.append(rewritten)

	{ program | decls = decls }


private pure func missing_impl_diagnostic(
	registry: CoreTraitResolveRegistry,
	identity: CoreTraitMethodIdentity,
	args: List[CoreExpr],
	return_type: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreTraitResolveDiagnostic]:
	dispatch ?= dispatch_type(registry, identity, args, return_type)
	type_name ?= core_trait_impl_type_key(dispatch)
	candidates: List[String] = registry.types_by_method
		.get(method_key(identity.trait_name, identity.method_name))
		.get_or([])

	if (
		candidates.is_empty()
		or target_for_dispatch(registry, identity, dispatch).is_some()
		or trait_builtin_fallback_name(identity).is_some()
	):
		None
	else if has_native_operator_fast_path(dispatch):
		None
	else:
		Some(MissingTraitImpl({
			loc = loc,
			trait_name = identity.trait_name,
			method_name = identity.method_name,
			type_name = type_name,
			candidates = candidates,
		}))


private pure func selected_target_diagnostic(
	trait_name: String,
	method_name: String,
	module_name: String,
	def_id: Int,
	loc: CoreSourceLoc,
) -> CoreTraitResolveDiagnostic:
	MissingSelectedTraitTarget({
		loc = loc,
		trait_name = trait_name,
		method_name = method_name,
		module_name = module_name,
		def_id = def_id,
	})


private pure func diagnostic_children(
	work: CoreTraitDiagnosticWork,
) -> List[CoreTraitDiagnosticWork]:
	match work.expr:
		ResourceScopeExpr(scope, _, _):
			shadowed: List[String] = append_unique(work.shadowed_names, scope.variable.name)
			[
				{
					expr = scope.acquire,
					shadowed_names = work.shadowed_names
				},
				{
					expr = scope.body,
					shadowed_names = shadowed
				},
				{
					expr = scope.cleanup,
					shadowed_names = shadowed
				},
			]
		_:
			immediate_core_expr_children(work.expr).map(pure func(child):
				{
					expr = child,
					shadowed_names = work.shadowed_names
				}
			)


private pure func first_expr_diagnostic(
	registry: CoreTraitResolveRegistry,
	root: CoreExpr,
) -> Option[CoreTraitResolveDiagnostic]:
	var pending: List[CoreTraitDiagnosticWork] = [
		{
			expr = root,
			shadowed_names = []
		},
	]
	var found: Option[CoreTraitResolveDiagnostic] = None
	var index: Int = 0

	while index < pending.length() and found.is_none():
		match pending.get(index):
			Some(work):
				index += 1

				match work.expr:
					CallExpr(SelectedTraitCall(trait_name, method_name, module_name, def_id), _, _, _, loc):
						found = Some(
							selected_target_diagnostic(
								trait_name,
								method_name,
								module_name,
								def_id,
								loc,
							),
						)
					CallExpr(DeferredTraitCall(trait_name, method_name), VarExpr(variable, _, _), args, return_type, loc):
						if (
							not work.shadowed_names.contains(variable.name)
							and variable.def_id.is_none()
						):
							found = missing_impl_diagnostic(
								registry,
								{
									trait_name = trait_name,
									method_name = method_name
								},
								args,
								return_type,
								loc,
							)
						else:
							void
					_:
						void

				if found.is_none():
					for child in diagnostic_children(work):
						pending = pending.append(child)
				else:
					void
			None:
				break

	found


private pure func function_diagnostic_roots(function_info: CoreFunction) -> List[CoreExpr]:
	if not function_info.type_params.is_empty():
		[]
	else:
		match function_info.body:
			Some(body):
				[body]
			None:
				[]


private pure func decl_diagnostic_roots(decl: CoreDecl) -> List[CoreExpr]:
	match decl:
		FunctionDecl(function_info):
			function_diagnostic_roots(function_info)
		GlobalDecl(global):
			[global.init]
		ImplDecl(implementation):
			if CoreTypePolicy.core_impl_is_generic(implementation):
				[]
			else:
				implementation.methods.flat_map(function_diagnostic_roots)
		_:
			[]


private pure func first_program_diagnostic(
	program: CoreProgram,
	registry: CoreTraitResolveRegistry,
) -> Option[CoreTraitResolveDiagnostic]:
	var found: Option[CoreTraitResolveDiagnostic] = None

	for decl in program.decls:
		for root in decl_diagnostic_roots(decl):
			if found.is_none():
				found = first_expr_diagnostic(registry, root)
			else:
				break

		if found.is_some():
			break
		else:
			void

	found


private pure func normalize_unresolved_trait_expr(expr: CoreExpr) -> CoreExpr:
	children_normalized: CoreExpr = match expr:
		SeqExpr(_, _):
			map_core_sequence_items(expr, normalize_unresolved_trait_expr)
		_:
			map_core_expr_children(expr, normalize_unresolved_trait_expr)

	match children_normalized:
		CallExpr(kind, callee, args, return_type, loc):
			match kind:
				DeferredTraitCall(_, _):
					CallExpr(UnknownCall, callee, args, return_type, loc)
				_:
					children_normalized
		_:
			children_normalized


private pure func normalize_unresolved_trait_function(function_info: CoreFunction) -> CoreFunction:
	if not function_info.type_params.is_empty():
		function_info
	else:
		match function_info.body:
			Some(body):
				{ function_info | body = Some(normalize_unresolved_trait_expr(body)) }
			None:
				function_info


private pure func normalize_unresolved_trait_decl(decl: CoreDecl) -> CoreDecl:
	match decl:
		FunctionDecl(function_info):
			FunctionDecl(normalize_unresolved_trait_function(function_info))
		GlobalDecl(global):
			GlobalDecl({ global | init = normalize_unresolved_trait_expr(global.init) })
		ImplDecl(implementation):
			if CoreTypePolicy.core_impl_is_generic(implementation):
				decl
			else:
				ImplDecl(
					{ implementation |
						methods = implementation.methods.map(normalize_unresolved_trait_function)
					},
				)
		_:
			decl


private pure func normalize_unresolved_trait_calls(program: CoreProgram) -> CoreProgram:
	{ program | decls = program.decls.map(normalize_unresolved_trait_decl) }


pure func resolve_core_traits(
	program: CoreProgram,
) -> Result[CoreProgram, CoreTraitResolveDiagnostic]:
	registry: CoreTraitResolveRegistry = collect_registry(program)
	rewritten: CoreProgram = rewrite_program(program, registry)

	match first_program_diagnostic(rewritten, registry):
		Some(diagnostic):
			Err(diagnostic)
		None:
			Ok(normalize_unresolved_trait_calls(rewritten))
