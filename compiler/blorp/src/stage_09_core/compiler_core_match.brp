-- Raw Core pattern-match compilation.
--
-- Direct constructor matches can be eliminated without constructing a decision tree:
-- constructor arguments are already evaluated values, so a matching arm only
-- needs to sequence discarded arguments and bind named arguments. General
-- matches are compiled by the decision-tree portion of this module.
import:
	compiler_core_json:
		CoreDecl(EnumDecl, FunctionDecl, GlobalDecl, ImplDecl, UnionDecl),
		CoreExpr(
			AssignExpr,
			BorrowLetExpr,
			CallExpr,
			ConcurrentExpr,
			ConcurrentlyLoopExpr,
			DropExpr,
			DupExpr,
			FieldExpr,
			ForChannelExpr,
			ForDictExpr,
			ForListExpr,
			ForRangeExpr,
			ForResourceSourceExpr,
			ForSetExpr,
			ForStreamExpr,
			ForStringExpr,
			ForTensorExpr,
			LambdaExpr,
			LetExpr,
			ListHandoffExpr,
			PreClosureConcurrentExpr,
			PreClosureConcurrentlyLoopExpr,
			RawMatchExpr,
			ResourceScopeExpr,
			SemanticMatchExpr,
			SelectExpr,
			SeqExpr,
			TailrecListSpreadLoopExpr,
			TailrecLoopExpr,
			TensorRawViewLetExpr,
			VarExpr,
		),
		CoreFunction,
		CoreGlobal,
		CoreImplDecl,
		CoreLiteral(
			BoolLiteral,
			CharLiteral,
			FloatInfinityLiteral,
			FloatLiteral,
			FloatNanLiteral,
			FloatNegInfinityLiteral,
			FloatTextLiteral,
			IntLiteral,
			StringLiteral,
			WideIntLiteral,
		),
		CoreMatchBindingMode(MatchBorrowBindingMode, MatchOwnBindingMode),
		CoreParam,
		CorePattern(
			ConstructorPattern,
			ListPattern,
			NamePattern,
			OrPattern,
			QualifiedConstructorPattern,
			TuplePattern,
			WildcardPattern,
		),
		CoreProgram,
		CoreRawMatchCase,
		CoreSelectArmKind(SelectAfterArm, SelectRecvArm, SelectSealedArm),
		CoreSemanticConstructorMatchCase,
		CoreSemanticLengthMatchCase,
		CoreSemanticLengthMatchGeq,
		CoreSemanticLiteralMatchCase,
		CoreSemanticMatchAccessor(
			ListElementSemanticMatchAccessor,
			ListSpreadSemanticMatchAccessor,
			RootSemanticMatchAccessor,
			TupleFieldSemanticMatchAccessor,
			VariantFieldSemanticMatchAccessor,
		),
		CoreSemanticMatchBinding,
		CoreSemanticMatchTree(
			SemanticConstructorMatch,
			SemanticLengthMatch,
			SemanticLiteralMatch,
			SemanticMatchFail,
			SemanticMatchLeaf,
		),
		CoreVar,
		core_expr_type,
	compiler_core_traverse as CoreTraverse
	set as Sets


private BUILTIN_CONSTRUCTOR_NAMES: List[String] = [
	"Some",
	"None",
	"Ok",
	"Err",
	"True",
	"False",
	"Timeout",
	"TaskFailed",
	"Cancelled",
]


private union DirectConstructorPayload:
	DiscardDirectConstructorPayload
	BindDirectConstructorPayload(String)


private enum MatchCaseShape:
	CatchallMatchCases
	LiteralMatchCases
	ConstructorMatchCases
	TupleMatchCases
	ListMatchCases
	UnsupportedMatchCases


private enum PatternMatrixAccessorKind:
	TuplePatternMatrixAccessors
	ListPatternMatrixAccessors


private record ConstructorCaseArm {
	patterns: List[CorePattern],
	body: CoreExpr
}


private record ConstructorCaseGroup {
	constructor: String,
	arms: List[ConstructorCaseArm]
}


private record NestedConstructorCaseArm {
	patterns: List[CorePattern],
	outer_bindings: List[CoreSemanticMatchBinding],
	body: CoreExpr
}


private record NestedConstructorCaseGroup {
	constructor: String,
	arms: List[NestedConstructorCaseArm]
}


private record PatternMatrixArm {
	patterns: List[CorePattern],
	bindings: List[CoreSemanticMatchBinding],
	body: CoreSemanticMatchTree
}


private union ListPatternSequenceArm:
	ExactListPatternArm(PatternMatrixArm)
	SpreadListPatternArm(PatternMatrixArm)
	CatchallListPatternArm(List[CoreSemanticMatchBinding], CoreSemanticMatchTree)


private record ScopedCoreExpr {
	expr: CoreExpr,
	target_shadowed: Bool
}


private record SplitMatchCases {
	tested: List[CoreRawMatchCase],
	fallback: Option[CoreRawMatchCase]
}


private pure func core_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


pure func collect_match_constructor_names(program: CoreProgram) -> Set[String]:
	var names: Set[String] = Sets.from_list(BUILTIN_CONSTRUCTOR_NAMES)

	for decl in program.decls:
		match decl:
			EnumDecl(enum_decl):
				for variant in enum_decl.variants:
					names = Sets.add(names, variant.name)
			UnionDecl(union_decl):
				for variant in union_decl.variants:
					names = Sets.add(names, variant.name)
			_:
				void

	names


pure func normalize_match_pattern(constructors: Set[String], pattern: CorePattern) -> CorePattern:
	match pattern:
		NamePattern(name):
			if Sets.contains(constructors, name):
				ConstructorPattern(name, [])
			else:
				pattern
		ConstructorPattern(name, args):
			ConstructorPattern(
				name,
				args.map(func(arg): normalize_match_pattern(constructors, arg)),
			)
		QualifiedConstructorPattern(module_name, name, args):
			QualifiedConstructorPattern(
				module_name,
				name,
				args.map(func(arg): normalize_match_pattern(constructors, arg)),
			)
		TuplePattern(items):
			TuplePattern(items.map(
				func(item): normalize_match_pattern(constructors, item),
			))
		ListPattern(items, spread):
			ListPattern(
				items.map(func(item): normalize_match_pattern(constructors, item)),
				spread.map(func(item): normalize_match_pattern(constructors, item)),
			)
		OrPattern(items):
			OrPattern(items.map(
				func(item): normalize_match_pattern(constructors, item),
			))
		_:
			pattern


pure func normalize_match_cases(
	constructors: Set[String],
	cases: List[CoreRawMatchCase],
) -> List[CoreRawMatchCase]:
	cases.map(
		func(
			match_case,
		): { match_case | pattern = normalize_match_pattern(constructors, match_case.pattern) },
	)


private pure func expand_or_match_case(match_case: CoreRawMatchCase) -> List[CoreRawMatchCase]:
	match match_case.pattern:
		OrPattern(patterns):
			patterns.map(func(pattern): {
					pattern = pattern,
					body = match_case.body
				})
		_:
			[match_case]


private pure func expand_or_match_cases(cases: List[CoreRawMatchCase]) -> List[CoreRawMatchCase]:
	cases.flat_map(expand_or_match_case)


private pure func constructor_name_of_callee(
	constructors: Set[String],
	callee: CoreExpr,
) -> Option[String]:
	match callee:
		VarExpr(variable, _, _):
			if Sets.contains(constructors, variable.name):
				Some(variable.name)
			else:
				None
		FieldExpr(_, field_name, _, _):
			if Sets.contains(constructors, field_name):
				Some(field_name)
			else:
				None
		_:
			None


private pure func direct_constructor_scrutinee(
	constructors: Set[String],
	scrutinee: CoreExpr,
) -> Option[(String, List[CoreExpr])]:
	match scrutinee:
		CallExpr(_kind, callee, args, _typ, _loc):
			name ?= constructor_name_of_callee(constructors, callee)
			Some((name, args))
		_:
			None


private pure func direct_constructor_payload(
	pattern: CorePattern,
) -> Option[DirectConstructorPayload]:
	match pattern:
		NamePattern("_") | WildcardPattern:
			Some(DiscardDirectConstructorPayload)
		NamePattern(name):
			Some(BindDirectConstructorPayload(name))
		_:
			None


private pure func simple_constructor_payloads(
	constructor_name: String,
	args: List[CoreExpr],
	pattern: CorePattern,
) -> Option[List[DirectConstructorPayload]]:
	var patterns: List[CorePattern] = []
	var matching_constructor: Bool = False

	match pattern:
		ConstructorPattern(name, payload_patterns) | QualifiedConstructorPattern(_, name, payload_patterns):
			if name == constructor_name:
				patterns = payload_patterns
				matching_constructor = True
		_:
			void

	if not matching_constructor or patterns.length() != args.length():
		None
	else:
		var payloads: List[DirectConstructorPayload] = []
		var failed: Bool = False

		for payload_pattern in patterns:
			match direct_constructor_payload(payload_pattern):
				Some(payload):
					payloads = payloads.append(payload)
				None:
					failed = True
					break

		if failed:
			None
		else:
			Some(payloads)


private pure func sequence_constructor_args(
	args: List[CoreExpr],
	body: CoreExpr,
) -> Option[CoreExpr]:
	var result: CoreExpr = body
	var index: Int = args.length()
	var failed: Bool = False

	while index > 0:
		index -= 1

		match args.get(index):
			Some(arg):
				result = SeqExpr(arg, result)
			None:
				failed = True
				break

	if failed:
		None
	else:
		Some(result)


private pure func bind_constructor_payloads(
	payloads: List[DirectConstructorPayload],
	args: List[CoreExpr],
	body: CoreExpr,
) -> Option[CoreExpr]:
	if payloads.length() != args.length():
		None
	else:
		var result: CoreExpr = body
		var index: Int = args.length()
		var failed: Bool = False

		while index > 0:
			index -= 1

			match (payloads.get(index), args.get(index)):
				(Some(payload), Some(arg)):
					match payload:
						DiscardDirectConstructorPayload:
							result = SeqExpr(arg, result)
						BindDirectConstructorPayload(name):
							result = LetExpr(
								core_var(name),
								False,
								core_expr_type(arg),
								arg,
								result,
							)
				_:
					failed = True
					break

		if failed:
			None
		else:
			Some(result)


private pure func pattern_constructor_name(pattern: CorePattern) -> Option[String]:
	match pattern:
		ConstructorPattern(name, _) | QualifiedConstructorPattern(_, name, _):
			Some(name)
		_:
			None


pure func try_fuse_direct_constructor_match(
	constructors: Set[String],
	scrutinee: CoreExpr,
	cases: List[CoreRawMatchCase],
) -> Option[CoreExpr]:
	scrutinee_info ?= direct_constructor_scrutinee(constructors, scrutinee)
	constructor_name: String = scrutinee_info[0]
	args: List[CoreExpr] = scrutinee_info[1]

	var result: Option[CoreExpr] = None
	var decided: Bool = False

	for match_case in expand_or_match_cases(cases):
		if not decided:
			match simple_constructor_payloads(constructor_name, args, match_case.pattern):
				Some(payloads):
					result = bind_constructor_payloads(payloads, args, match_case.body)
					decided = True
				None:
					match pattern_constructor_name(match_case.pattern):
						Some(name):
							if name == constructor_name:
								decided = True
						None:
							match match_case.pattern:
								WildcardPattern:
									result = sequence_constructor_args(args, match_case.body)
									decided = True
								_:
									void

	result


private pure func is_catchall_pattern(pattern: CorePattern) -> Bool:
	match pattern:
		NamePattern(_) | WildcardPattern:
			True
		_:
			False


private pure func catchall_binding(
	pattern: CorePattern,
	accessor: CoreSemanticMatchAccessor,
) -> List[CoreSemanticMatchBinding]:
	match pattern:
		NamePattern(name):
			[
				{
					variable = core_var(name),
					accessor = accessor,
					mode = MatchBorrowBindingMode
				},
			]
		_:
			[]


private pure func catchall_leaf(pattern: CorePattern, body: CoreExpr) -> CoreSemanticMatchTree:
	SemanticMatchLeaf(
		catchall_binding(pattern, RootSemanticMatchAccessor),
		body,
	)


private pure func semantic_binding(
	name: String,
	accessor: CoreSemanticMatchAccessor,
) -> CoreSemanticMatchBinding:
	mode: CoreMatchBindingMode = match accessor:
		ListSpreadSemanticMatchAccessor(_, _):
			MatchOwnBindingMode
		_:
			MatchBorrowBindingMode

	{
		variable = core_var(name),
		accessor = accessor,
		mode = mode
	}


private pure func collect_pattern_bindings(
	accessor: CoreSemanticMatchAccessor,
	pattern: CorePattern,
) -> List[CoreSemanticMatchBinding]:
	match pattern:
		NamePattern(name):
			[semantic_binding(name, accessor)]
		ConstructorPattern(constructor, patterns) | QualifiedConstructorPattern(_, constructor, patterns):
			var bindings: List[CoreSemanticMatchBinding] = []
			var index: Int = 0

			for nested_pattern in patterns:
				bindings = bindings.concat(
					collect_pattern_bindings(
						VariantFieldSemanticMatchAccessor(accessor, constructor, index),
						nested_pattern,
					),
				)
				index += 1

			bindings
		TuplePattern(patterns):
			var bindings: List[CoreSemanticMatchBinding] = []
			var index: Int = 0

			for nested_pattern in patterns:
				bindings = bindings.concat(
					collect_pattern_bindings(
						TupleFieldSemanticMatchAccessor(accessor, index),
						nested_pattern,
					),
				)
				index += 1

			bindings
		ListPattern(patterns, spread):
			var bindings: List[CoreSemanticMatchBinding] = []
			var index: Int = 0

			for nested_pattern in patterns:
				bindings = bindings.concat(
					collect_pattern_bindings(
						ListElementSemanticMatchAccessor(accessor, index),
						nested_pattern,
					),
				)
				index += 1

			match spread:
				Some(NamePattern(name)):
					bindings.append(
						semantic_binding(
							name,
							ListSpreadSemanticMatchAccessor(accessor, patterns.length()),
						),
					)
				_:
					bindings
		WildcardPattern | LiteralPattern(_) | OrPattern(_):
			[]


private pure func constructor_pattern_bindings(
	base: CoreSemanticMatchAccessor,
	constructor: String,
	patterns: List[CorePattern],
) -> List[CoreSemanticMatchBinding]:
	var bindings: List[CoreSemanticMatchBinding] = []
	var index: Int = 0

	for pattern in patterns:
		bindings = bindings.concat(
			collect_pattern_bindings(
				VariantFieldSemanticMatchAccessor(base, constructor, index),
				pattern,
			),
		)
		index += 1

	bindings


private pure func semantic_accessors_equal(
	left: CoreSemanticMatchAccessor,
	right: CoreSemanticMatchAccessor,
) -> Bool:
	match left:
		RootSemanticMatchAccessor:
			match right:
				RootSemanticMatchAccessor:
					True
				_:
					False
		VariantFieldSemanticMatchAccessor(left_parent, left_constructor, left_index):
			match right:
				VariantFieldSemanticMatchAccessor(right_parent, right_constructor, right_index):
					(
						left_constructor == right_constructor
						and left_index == right_index
						and semantic_accessors_equal(left_parent, right_parent)
					)
				_:
					False
		TupleFieldSemanticMatchAccessor(left_parent, left_index):
			match right:
				TupleFieldSemanticMatchAccessor(right_parent, right_index):
					(
						left_index == right_index
						and semantic_accessors_equal(left_parent, right_parent)
					)
				_:
					False
		ListElementSemanticMatchAccessor(left_parent, left_index):
			match right:
				ListElementSemanticMatchAccessor(right_parent, right_index):
					(
						left_index == right_index
						and semantic_accessors_equal(left_parent, right_parent)
					)
				_:
					False
		ListSpreadSemanticMatchAccessor(left_parent, left_index):
			match right:
				ListSpreadSemanticMatchAccessor(right_parent, right_index):
					(
						left_index == right_index
						and semantic_accessors_equal(left_parent, right_parent)
					)
				_:
					False


private pure func semantic_accessor_starts_with(
	prefix: CoreSemanticMatchAccessor,
	accessor: CoreSemanticMatchAccessor,
) -> Bool:
	if semantic_accessors_equal(prefix, accessor):
		True
	else:
		match accessor:
			VariantFieldSemanticMatchAccessor(parent, _, _):
				semantic_accessor_starts_with(prefix, parent)
			TupleFieldSemanticMatchAccessor(parent, _):
				semantic_accessor_starts_with(prefix, parent)
			ListElementSemanticMatchAccessor(parent, _):
				semantic_accessor_starts_with(prefix, parent)
			ListSpreadSemanticMatchAccessor(parent, _):
				semantic_accessor_starts_with(prefix, parent)
			RootSemanticMatchAccessor:
				False


private pure func prepend_semantic_bindings(
	tree: CoreSemanticMatchTree,
	bindings: List[CoreSemanticMatchBinding],
) -> CoreSemanticMatchTree:
	if bindings.is_empty():
		tree
	else:
		match tree:
			SemanticMatchLeaf(existing, body):
				SemanticMatchLeaf(
					bindings.concat(existing),
					body,
				)
			SemanticMatchFail:
				SemanticMatchFail
			SemanticConstructorMatch(accessor, cases, fallback):
				SemanticConstructorMatch(
					accessor,
					cases.map(
						func(
							match_case,
						): { match_case |
							body = prepend_semantic_bindings(match_case.body, bindings)
						},
					),
					fallback.map(func(found): prepend_semantic_bindings(found, bindings)),
				)
			SemanticLiteralMatch(accessor, cases, fallback):
				SemanticLiteralMatch(
					accessor,
					cases.map(
						func(
							match_case,
						): { match_case |
							body = prepend_semantic_bindings(match_case.body, bindings)
						},
					),
					prepend_semantic_bindings(fallback, bindings),
				)
			SemanticLengthMatch(accessor, cases, geq, fallback):
				SemanticLengthMatch(
					accessor,
					cases.map(
						func(
							match_case,
						): { match_case |
							body = prepend_semantic_bindings(match_case.body, bindings)
						},
					),
					geq.map(
						func(
							found,
						): { found | body = prepend_semantic_bindings(found.body, bindings) },
					),
					fallback.map(func(found): prepend_semantic_bindings(found, bindings)),
				)


private pure func replace_semantic_match_fail(
	tree: CoreSemanticMatchTree,
	fallback: CoreSemanticMatchTree,
) -> CoreSemanticMatchTree:
	match tree:
		SemanticMatchLeaf(_, _):
			tree
		SemanticMatchFail:
			fallback
		SemanticConstructorMatch(accessor, cases, existing_fallback):
			SemanticConstructorMatch(
				accessor,
				cases.map(
					func(
						match_case,
					): { match_case |
						body = replace_semantic_match_fail(match_case.body, fallback)
					},
				),
				Some(
					existing_fallback
						.map(func(found): replace_semantic_match_fail(found, fallback))
						.get_or(fallback),
				),
			)
		SemanticLiteralMatch(accessor, cases, existing_fallback):
			SemanticLiteralMatch(
				accessor,
				cases.map(
					func(
						match_case,
					): { match_case |
						body = replace_semantic_match_fail(match_case.body, fallback)
					},
				),
				replace_semantic_match_fail(existing_fallback, fallback),
			)
		SemanticLengthMatch(accessor, cases, geq, existing_fallback):
			SemanticLengthMatch(
				accessor,
				cases.map(
					func(
						match_case,
					): { match_case |
						body = replace_semantic_match_fail(match_case.body, fallback)
					},
				),
				geq.map(
					func(
						found,
					): { found | body = replace_semantic_match_fail(found.body, fallback) },
				),
				Some(
					existing_fallback
						.map(func(found): replace_semantic_match_fail(found, fallback))
						.get_or(fallback),
				),
			)


private pure func semantic_match_tree_name_may_occur_free(
	tree: CoreSemanticMatchTree,
	name: String,
) -> Bool:
	match tree:
		SemanticMatchLeaf(bindings, body):
			if bindings.any(func(binding): binding.variable.name == name):
				False
			else:
				core_name_may_occur_free(name, body)
		SemanticMatchFail:
			False
		SemanticConstructorMatch(_, cases, fallback):
			(
				cases.any(
					func(
						match_case,
					): semantic_match_tree_name_may_occur_free(match_case.body, name),
				)
				or fallback
					.map(func(found): semantic_match_tree_name_may_occur_free(found, name))
					.get_or(False)
			)
		SemanticLiteralMatch(_, cases, fallback):
			(
				cases.any(
					func(
						match_case,
					): semantic_match_tree_name_may_occur_free(match_case.body, name),
				)
				or semantic_match_tree_name_may_occur_free(fallback, name)
			)
		SemanticLengthMatch(_, cases, geq, fallback):
			(
				cases.any(
					func(
						match_case,
					): semantic_match_tree_name_may_occur_free(match_case.body, name),
				)
				or geq
					.map(func(found): semantic_match_tree_name_may_occur_free(found.body, name))
					.get_or(False)
				or fallback
					.map(func(found): semantic_match_tree_name_may_occur_free(found, name))
					.get_or(False)
			)


private pure func first_non_catchall_index(patterns: List[CorePattern]) -> Option[Int]:
	var result: Option[Int] = None
	var index: Int = 0

	for pattern in patterns:
		if not is_catchall_pattern(pattern):
			result = Some(index)
			break

		index += 1

	result


private pure func constructor_group_split_index(arms: List[ConstructorCaseArm]) -> Option[Int]:
	match arms.get(0):
		Some(first_arm):
			var result: Option[Int] = None
			var index: Int = 0

			while index < first_arm.patterns.length():
				var non_trivial: Bool = False

				for arm in arms:
					match arm.patterns.get(index):
						Some(pattern):
							if not is_catchall_pattern(pattern):
								non_trivial = True
								break
						None:
							void

				if non_trivial:
					result = Some(index)
					break

				index += 1

			result
		None:
			None


private pure func literal_subpattern_tree(
	base: CoreSemanticMatchAccessor,
	constructor: String,
	position: Int,
	arms: List[ConstructorCaseArm],
	fallback: CoreSemanticMatchTree,
) -> Option[CoreSemanticMatchTree]:
	accessor: CoreSemanticMatchAccessor = VariantFieldSemanticMatchAccessor(
		base,
		constructor,
		position,
	)
	var literal_cases: List[CoreSemanticLiteralMatchCase] = []
	var default: Option[CoreSemanticMatchTree] = None
	var failed: Bool = False

	for arm in arms:
		match arm.patterns.get(position):
			Some(LiteralPattern(literal)):
				literal_cases = literal_cases.append({
					literal = literal,
					body = SemanticMatchLeaf(
						constructor_pattern_bindings(base, constructor, arm.patterns),
						arm.body,
					),
				})
			Some(pattern):
				if is_catchall_pattern(pattern):
					if default.is_none():
						default = Some(
							SemanticMatchLeaf(
								constructor_pattern_bindings(base, constructor, arm.patterns),
								arm.body,
							),
						)
				else:
					failed = True
					break
			None:
				failed = True
				break

	if failed or literal_cases.is_empty():
		None
	else:
		Some(SemanticLiteralMatch(accessor, literal_cases, default.get_or(fallback)))


private pure func match_case_shape(cases: List[CoreRawMatchCase]) -> MatchCaseShape:
	if cases.is_empty():
		UnsupportedMatchCases
	else:
		var single_catchall: Bool = False

		if cases.length() == 1:
			match cases.get(0):
				Some(match_case):
					single_catchall = is_catchall_pattern(match_case.pattern)
				None:
					void

		if single_catchall:
			CatchallMatchCases
		else:
			var tested_count: Int = cases.length()

			match cases.get(cases.length() - 1):
				Some(last_case):
					if is_catchall_pattern(last_case.pattern):
						tested_count -= 1
				None:
					void

			var all_literals: Bool = tested_count > 0
			var all_constructors: Bool = tested_count > 0
			var all_tuples: Bool = tested_count > 0
			var all_lists: Bool = tested_count > 0
			var index: Int = 0

			while index < tested_count:
				match cases.get(index):
					Some(match_case):
						match match_case.pattern:
							LiteralPattern(_):
								all_constructors = False
								all_tuples = False
								all_lists = False
							ConstructorPattern(_, _) | QualifiedConstructorPattern(_, _, _):
								all_literals = False
								all_tuples = False
								all_lists = False
							TuplePattern(_):
								all_literals = False
								all_constructors = False
								all_lists = False
							ListPattern(_, _):
								all_literals = False
								all_constructors = False
								all_tuples = False
							_:
								all_literals = False
								all_constructors = False
								all_tuples = False
								all_lists = False
					None:
						all_literals = False
						all_constructors = False
						all_tuples = False
						all_lists = False

				index += 1

			if all_literals:
				LiteralMatchCases
			else if all_constructors:
				ConstructorMatchCases
			else if all_tuples:
				TupleMatchCases
			else if all_lists:
				ListMatchCases
			else:
				UnsupportedMatchCases


private pure func split_trailing_catchall(cases: List[CoreRawMatchCase]) -> SplitMatchCases:
	if cases.is_empty():
		{
			tested = [],
			fallback = None
		}
	else:
		match cases.get(cases.length() - 1):
			Some(last_case):
				if is_catchall_pattern(last_case.pattern):
					{
						tested = cases.take(cases.length() - 1),
						fallback = Some(last_case)
					}
				else:
					{
						tested = cases,
						fallback = None
					}
			None:
				{
					tested = cases,
					fallback = None
				}


private pure func constructor_pattern_parts(
	pattern: CorePattern,
) -> Option[(String, List[CorePattern])]:
	match pattern:
		ConstructorPattern(name, patterns) | QualifiedConstructorPattern(_, name, patterns):
			Some((name, patterns))
		_:
			None


private pure func find_constructor_group_index(
	groups: List[ConstructorCaseGroup],
	constructor: String,
) -> Option[Int]:
	var found: Option[Int] = None
	var index: Int = 0

	while index < groups.length():
		match groups.get(index):
			Some(group):
				if group.constructor == constructor:
					found = Some(index)
					break
			None:
				void

		index += 1

	found


private pure func find_nested_constructor_group_index(
	groups: List[NestedConstructorCaseGroup],
	constructor: String,
) -> Option[Int]:
	var found: Option[Int] = None
	var index: Int = 0

	while index < groups.length():
		match groups.get(index):
			Some(group):
				if group.constructor == constructor:
					found = Some(index)
					break
			None:
				void

		index += 1

	found


private pure func group_constructor_cases(
	cases: List[CoreRawMatchCase],
) -> Option[List[ConstructorCaseGroup]]:
	var groups: List[ConstructorCaseGroup] = []
	var failed: Bool = False

	for match_case in cases:
		match constructor_pattern_parts(match_case.pattern):
			Some(parts):
				constructor: String = parts[0]
				arm: ConstructorCaseArm = {
					patterns = parts[1],
					body = match_case.body
				}

				match find_constructor_group_index(groups, constructor):
					Some(index):
						match groups.get(index):
							Some(group):
								groups = groups.set(
									index,
									{ group | arms = group.arms.append(arm) },
								)
							None:
								failed = True
								break
					None:
						groups = groups.append({
							constructor = constructor,
							arms = [arm],
						})
			None:
				failed = True
				break

	if failed:
		None
	else:
		Some(groups)


private pure func nested_constructor_subpattern_tree(
	base: CoreSemanticMatchAccessor,
	constructor: String,
	position: Int,
	arms: List[ConstructorCaseArm],
	fallback: CoreSemanticMatchTree,
) -> Option[CoreSemanticMatchTree]:
	accessor: CoreSemanticMatchAccessor = VariantFieldSemanticMatchAccessor(
		base,
		constructor,
		position,
	)
	var groups: List[NestedConstructorCaseGroup] = []
	var default: Option[CoreSemanticMatchTree] = None
	var failed: Bool = False

	for arm in arms:
		match arm.patterns.get(position):
			Some(pattern):
				match constructor_pattern_parts(pattern):
					Some(parts):
						nested_constructor: String = parts[0]
						outer_bindings: List[CoreSemanticMatchBinding] = constructor_pattern_bindings(
							base,
							constructor,
							arm.patterns,
						).filter(
							func(
								binding,
							): not semantic_accessor_starts_with(accessor, binding.accessor),
						)
						nested_arm: NestedConstructorCaseArm = {
							patterns = parts[1],
							outer_bindings = outer_bindings,
							body = arm.body
						}

						match find_nested_constructor_group_index(groups, nested_constructor):
							Some(index):
								match groups.get(index):
									Some(group):
										groups = groups.set(
											index,
											{ group | arms = group.arms.append(nested_arm) },
										)
									None:
										failed = True
										break
							None:
								groups = groups.append({
									constructor = nested_constructor,
									arms = [nested_arm],
								})
					None:
						if is_catchall_pattern(pattern):
							if default.is_none():
								default = Some(
									SemanticMatchLeaf(
										constructor_pattern_bindings(
											base,
											constructor,
											arm.patterns,
										),
										arm.body,
									),
								)
						else:
							failed = True
							break
			None:
				failed = True
				break

	if failed or groups.is_empty():
		None
	else:
		var cases: List[CoreSemanticConstructorMatchCase] = []

		for group in groups:
			match group.arms.get(0):
				Some(first_arm):
					core_arms: List[ConstructorCaseArm] = group.arms.map(func(arm): {
							patterns = arm.patterns,
							body = arm.body
						})

					match compile_constructor_group_tree(
						accessor,
						group.constructor,
						core_arms,
						Some(fallback),
					):
						Some(body):
							cases = cases.append({
								constructor = group.constructor,
								body = prepend_semantic_bindings(body, first_arm.outer_bindings),
							})
						None:
							failed = True
							break
				None:
					failed = True
					break

		if failed:
			None
		else:
			Some(SemanticConstructorMatch(accessor, cases, Some(default.get_or(fallback))))


private pure func wildcard_patterns(count: Int) -> List[CorePattern]:
	var patterns: List[CorePattern] = []
	var index: Int = 0

	while index < count:
		patterns = patterns.append(WildcardPattern)
		index += 1

	patterns


private pure func tuple_subpattern_width(
	arms: List[ConstructorCaseArm],
	position: Int,
) -> Option[Int]:
	var width: Option[Int] = None
	var failed: Bool = False

	for arm in arms:
		match arm.patterns.get(position):
			Some(TuplePattern(patterns)):
				match width:
					Some(expected):
						if patterns.length() != expected:
							failed = True
							break
					None:
						width = Some(patterns.length())
			Some(pattern):
				if not is_catchall_pattern(pattern):
					failed = True
					break
			None:
				failed = True
				break

	if failed:
		None
	else:
		width


private pure func tuple_subpattern_tree(
	base: CoreSemanticMatchAccessor,
	constructor: String,
	position: Int,
	arms: List[ConstructorCaseArm],
	fallback: CoreSemanticMatchTree,
) -> Option[CoreSemanticMatchTree]:
	width ?= tuple_subpattern_width(arms, position)
	accessor: CoreSemanticMatchAccessor = VariantFieldSemanticMatchAccessor(
		base,
		constructor,
		position,
	)
	var matrix_arms: List[PatternMatrixArm] = []
	var failed: Bool = False

	for arm in arms:
		match arm.patterns.get(position):
			Some(TuplePattern(patterns)):
				matrix_arms = matrix_arms.append({
					patterns = patterns,
					bindings = constructor_pattern_bindings(
						base,
						constructor,
						arm.patterns,
					).filter(
						func(
							binding,
						): not semantic_accessor_starts_with(accessor, binding.accessor),
					),
					body = SemanticMatchLeaf([], arm.body),
				})
			Some(pattern):
				if is_catchall_pattern(pattern):
					matrix_arms = matrix_arms.append({
						patterns = wildcard_patterns(width),
						bindings = constructor_pattern_bindings(base, constructor, arm.patterns),
						body = SemanticMatchLeaf([], arm.body),
					})
				else:
					failed = True
					break
			None:
				failed = True
				break

	if failed:
		None
	else:
		compile_pattern_matrix(TuplePatternMatrixAccessors, accessor, matrix_arms, fallback)


private pure func list_subpattern_tree(
	base: CoreSemanticMatchAccessor,
	constructor: String,
	position: Int,
	arms: List[ConstructorCaseArm],
	fallback: CoreSemanticMatchTree,
) -> Option[CoreSemanticMatchTree]:
	accessor: CoreSemanticMatchAccessor = VariantFieldSemanticMatchAccessor(
		base,
		constructor,
		position,
	)
	var sequence: List[ListPatternSequenceArm] = []
	var failed: Bool = False

	for arm in arms:
		match arm.patterns.get(position):
			Some(ListPattern(patterns, spread)):
				outer_bindings: List[CoreSemanticMatchBinding] = constructor_pattern_bindings(
					base,
					constructor,
					arm.patterns,
				).filter(
					func(binding): not semantic_accessor_starts_with(accessor, binding.accessor),
				)
				matrix_arm: PatternMatrixArm = {
					patterns = patterns,
					bindings = outer_bindings.concat(
						list_spread_binding(
							accessor,
							patterns.length(),
							spread,
							arm.body,
						),
					),
					body = SemanticMatchLeaf([], arm.body)
				}

				if spread.is_some():
					sequence = sequence.append(SpreadListPatternArm(matrix_arm))
				else:
					sequence = sequence.append(ExactListPatternArm(matrix_arm))
			Some(pattern):
				if is_catchall_pattern(pattern):
					sequence = sequence.append(
						CatchallListPatternArm(
							constructor_pattern_bindings(base, constructor, arm.patterns),
							SemanticMatchLeaf([], arm.body),
						),
					)
				else:
					failed = True
					break
			None:
				failed = True
				break

	if failed:
		None
	else:
		compile_list_pattern_sequence(accessor, sequence, fallback)


private pure func compile_constructor_group_tree(
	base: CoreSemanticMatchAccessor,
	constructor: String,
	arms: List[ConstructorCaseArm],
	fallback: Option[CoreSemanticMatchTree],
) -> Option[CoreSemanticMatchTree]:
	match arms.get(0):
		Some(arm):
			if arm.patterns.all(is_catchall_pattern):
				Some(
					SemanticMatchLeaf(
						constructor_pattern_bindings(base, constructor, arm.patterns),
						arm.body,
					),
				)
			else if arm.patterns.is_empty():
				Some(SemanticMatchLeaf([], arm.body))
			else:
				match constructor_group_split_index(arms):
					Some(position):
						match arm.patterns.get(position):
							Some(LiteralPattern(_)):
								literal_subpattern_tree(
									base,
									constructor,
									position,
									arms,
									fallback.get_or(SemanticMatchFail),
								)
							Some(ConstructorPattern(_, _)) | Some(QualifiedConstructorPattern(_, _, _)):
								nested_constructor_subpattern_tree(
									base,
									constructor,
									position,
									arms,
									fallback.get_or(SemanticMatchFail),
								)
							Some(TuplePattern(_)):
								tuple_subpattern_tree(
									base,
									constructor,
									position,
									arms,
									fallback.get_or(SemanticMatchFail),
								)
							Some(ListPattern(_, _)):
								list_subpattern_tree(
									base,
									constructor,
									position,
									arms,
									fallback.get_or(SemanticMatchFail),
								)
							_:
								None
					None:
						Some(
							SemanticMatchLeaf(
								constructor_pattern_bindings(base, constructor, arm.patterns),
								arm.body,
							),
						)
		None:
			fallback


private pure func core_match_literals_equal(left: CoreLiteral, right: CoreLiteral) -> Bool:
	match left:
		IntLiteral(left_value):
			match right:
				IntLiteral(right_value):
					left_value == right_value
				_:
					False
		WideIntLiteral(left_value):
			match right:
				WideIntLiteral(right_value):
					left_value == right_value
				_:
					False
		FloatLiteral(left_value):
			match right:
				FloatLiteral(right_value):
					left_value == right_value
				_:
					False
		FloatTextLiteral(left_value):
			match right:
				FloatTextLiteral(right_value):
					left_value == right_value
				_:
					False
		FloatInfinityLiteral:
			match right:
				FloatInfinityLiteral:
					True
				_:
					False
		FloatNegInfinityLiteral:
			match right:
				FloatNegInfinityLiteral:
					True
				_:
					False
		FloatNanLiteral:
			match right:
				FloatNanLiteral:
					True
				_:
					False
		BoolLiteral(left_value):
			match right:
				BoolLiteral(right_value):
					left_value == right_value
				_:
					False
		CharLiteral(left_value):
			match right:
				CharLiteral(right_value):
					left_value == right_value
				_:
					False
		StringLiteral(left_value):
			match right:
				StringLiteral(right_value):
					left_value == right_value
				_:
					False


private pure func pattern_matrix_accessor(
	kind: PatternMatrixAccessorKind,
	base: CoreSemanticMatchAccessor,
	position: Int,
) -> CoreSemanticMatchAccessor:
	match kind:
		TuplePatternMatrixAccessors:
			TupleFieldSemanticMatchAccessor(base, position)
		ListPatternMatrixAccessors:
			ListElementSemanticMatchAccessor(base, position)


private pure func pattern_matrix_bindings(
	kind: PatternMatrixAccessorKind,
	base: CoreSemanticMatchAccessor,
	patterns: List[CorePattern],
) -> List[CoreSemanticMatchBinding]:
	var bindings: List[CoreSemanticMatchBinding] = []
	var index: Int = 0

	for pattern in patterns:
		bindings = bindings.concat(
			collect_pattern_bindings(
				pattern_matrix_accessor(kind, base, index),
				pattern,
			),
		)
		index += 1

	bindings


private pure func pattern_matrix_split_index(arms: List[PatternMatrixArm]) -> Option[Int]:
	match arms.get(0):
		Some(first_arm):
			var result: Option[Int] = None
			var index: Int = 0

			while index < first_arm.patterns.length():
				var non_trivial: Bool = False

				for arm in arms:
					match arm.patterns.get(index):
						Some(pattern):
							if not is_catchall_pattern(pattern):
								non_trivial = True
								break
						None:
							void

				if non_trivial:
					result = Some(index)
					break

				index += 1

			result
		None:
			None


private pure func catchall_pattern_matrix_arms(
	arms: List[PatternMatrixArm],
	position: Int,
) -> List[PatternMatrixArm]:
	var result: List[PatternMatrixArm] = []

	for arm in arms:
		match arm.patterns.get(position):
			Some(pattern):
				if is_catchall_pattern(pattern):
					result = result.append(arm)
			None:
				void

	result


private pure func distinct_literal_patterns(
	arms: List[PatternMatrixArm],
	position: Int,
) -> List[CoreLiteral]:
	var literals: List[CoreLiteral] = []

	for arm in arms:
		match arm.patterns.get(position):
			Some(LiteralPattern(literal)):
				if not literals.any(func(existing): core_match_literals_equal(existing, literal)):
					literals = literals.append(literal)
			_:
				void

	literals


private pure func distinct_constructor_patterns(
	arms: List[PatternMatrixArm],
	position: Int,
) -> List[String]:
	var constructors: List[String] = []

	for arm in arms:
		match arm.patterns.get(position):
			Some(ConstructorPattern(constructor, _)) | Some(QualifiedConstructorPattern(_, constructor, _)):
				if not constructors.contains(constructor):
					constructors = constructors.append(constructor)
			_:
				void

	constructors


private pure func pattern_matrix_arms_for_literal(
	arms: List[PatternMatrixArm],
	position: Int,
	literal: CoreLiteral,
) -> List[PatternMatrixArm]:
	var specialized: List[PatternMatrixArm] = []

	for arm in arms:
		match arm.patterns.get(position):
			Some(LiteralPattern(found)):
				if core_match_literals_equal(found, literal):
					specialized = specialized.append(
						{ arm | patterns = arm.patterns.set(position, WildcardPattern) },
					)
			Some(pattern):
				if is_catchall_pattern(pattern):
					specialized = specialized.append(arm)
			None:
				void

	specialized


private pure func constructor_pattern_bindings_at(
	accessor: CoreSemanticMatchAccessor,
	constructor: String,
	patterns: List[CorePattern],
) -> List[CoreSemanticMatchBinding]:
	var bindings: List[CoreSemanticMatchBinding] = []
	var index: Int = 0

	for pattern in patterns:
		bindings = bindings.concat(
			collect_pattern_bindings(
				VariantFieldSemanticMatchAccessor(accessor, constructor, index),
				pattern,
			),
		)
		index += 1

	bindings


private pure func pattern_matrix_arms_for_constructor(
	arms: List[PatternMatrixArm],
	position: Int,
	accessor: CoreSemanticMatchAccessor,
	constructor: String,
) -> List[PatternMatrixArm]:
	var specialized: List[PatternMatrixArm] = []

	for arm in arms:
		match arm.patterns.get(position):
			Some(ConstructorPattern(found, patterns)) | Some(QualifiedConstructorPattern(_, found, patterns)):
				if found == constructor:
					specialized = specialized.append({ arm |
							patterns = arm.patterns.set(position, WildcardPattern),
							bindings = arm.bindings.concat(
								constructor_pattern_bindings_at(
									accessor,
									constructor,
									patterns,
								),
							)
						})
			Some(pattern):
				if is_catchall_pattern(pattern):
					specialized = specialized.append(arm)
			None:
				void

	specialized


private pure func pattern_matrix_column_has_literal(
	arms: List[PatternMatrixArm],
	position: Int,
) -> Bool:
	var found: Bool = False

	for arm in arms:
		match arm.patterns.get(position):
			Some(LiteralPattern(_)):
				found = True
				break
			_:
				void

	found


private pure func pattern_matrix_column_has_constructor(
	arms: List[PatternMatrixArm],
	position: Int,
) -> Bool:
	var found: Bool = False

	for arm in arms:
		match arm.patterns.get(position):
			Some(ConstructorPattern(_, _)) | Some(QualifiedConstructorPattern(_, _, _)):
				found = True
				break
			_:
				void

	found


private pure func pattern_matrix_column_has_tuple(
	arms: List[PatternMatrixArm],
	position: Int,
) -> Bool:
	var found: Bool = False

	for arm in arms:
		match arm.patterns.get(position):
			Some(TuplePattern(_)):
				found = True
				break
			_:
				void

	found


private pure func pattern_matrix_column_has_list(
	arms: List[PatternMatrixArm],
	position: Int,
) -> Bool:
	var found: Bool = False

	for arm in arms:
		match arm.patterns.get(position):
			Some(ListPattern(_, _)):
				found = True
				break
			_:
				void

	found


private pure func compile_pattern_matrix_literal_column(
	kind: PatternMatrixAccessorKind,
	base: CoreSemanticMatchAccessor,
	arms: List[PatternMatrixArm],
	position: Int,
	fallback: CoreSemanticMatchTree,
) -> Option[CoreSemanticMatchTree]:
	accessor: CoreSemanticMatchAccessor = pattern_matrix_accessor(kind, base, position)
	default_arms: List[PatternMatrixArm] = catchall_pattern_matrix_arms(arms, position)
	var default_tree: CoreSemanticMatchTree = fallback
	var failed: Bool = False

	if not default_arms.is_empty():
		match compile_pattern_matrix(kind, base, default_arms, fallback):
			Some(found):
				default_tree = found
			None:
				failed = True

	var cases: List[CoreSemanticLiteralMatchCase] = []

	if not failed:
		for literal in distinct_literal_patterns(arms, position):
			specialized: List[PatternMatrixArm] = pattern_matrix_arms_for_literal(
				arms,
				position,
				literal,
			)

			match compile_pattern_matrix(kind, base, specialized, fallback):
				Some(body):
					cases = cases.append({
						literal = literal,
						body = body,
					})
				None:
					failed = True
					break

	if failed:
		None
	else:
		Some(SemanticLiteralMatch(accessor, cases, default_tree))


private pure func compile_pattern_matrix_constructor_column(
	kind: PatternMatrixAccessorKind,
	base: CoreSemanticMatchAccessor,
	arms: List[PatternMatrixArm],
	position: Int,
	fallback: CoreSemanticMatchTree,
) -> Option[CoreSemanticMatchTree]:
	accessor: CoreSemanticMatchAccessor = pattern_matrix_accessor(kind, base, position)
	default_arms: List[PatternMatrixArm] = catchall_pattern_matrix_arms(arms, position)
	var default_tree: CoreSemanticMatchTree = fallback
	var failed: Bool = False

	if not default_arms.is_empty():
		match compile_pattern_matrix(kind, base, default_arms, fallback):
			Some(found):
				default_tree = found
			None:
				failed = True

	var cases: List[CoreSemanticConstructorMatchCase] = []

	if not failed:
		for constructor in distinct_constructor_patterns(arms, position):
			specialized: List[PatternMatrixArm] = pattern_matrix_arms_for_constructor(
				arms,
				position,
				accessor,
				constructor,
			)

			match compile_pattern_matrix(kind, base, specialized, fallback):
				Some(body):
					cases = cases.append({
						constructor = constructor,
						body = body,
					})
				None:
					failed = True
					break

	if failed:
		None
	else:
		Some(SemanticConstructorMatch(accessor, cases, Some(default_tree)))


private pure func compile_pattern_matrix_tuple_column(
	kind: PatternMatrixAccessorKind,
	base: CoreSemanticMatchAccessor,
	arms: List[PatternMatrixArm],
	position: Int,
	fallback: CoreSemanticMatchTree,
) -> Option[CoreSemanticMatchTree]:
	accessor: CoreSemanticMatchAccessor = pattern_matrix_accessor(kind, base, position)
	var result: CoreSemanticMatchTree = fallback
	var index: Int = arms.length()
	var failed: Bool = False

	while index > 0:
		index -= 1

		match arms.get(index):
			Some(arm):
				match arm.patterns.get(position):
					Some(TuplePattern(patterns)):
						outer_arm: PatternMatrixArm = { arm |
							patterns = arm.patterns.set(position, WildcardPattern)
						}

						match compile_pattern_matrix(kind, base, [outer_arm], SemanticMatchFail):
							Some(continuation):
								tuple_arm: PatternMatrixArm = {
									patterns = patterns,
									bindings = [],
									body = continuation
								}

								match compile_pattern_matrix(
									TuplePatternMatrixAccessors,
									accessor,
									[tuple_arm],
									SemanticMatchFail,
								):
									Some(arm_tree):
										result = replace_semantic_match_fail(arm_tree, result)
									None:
										failed = True
										break
							None:
								failed = True
								break
					Some(pattern):
						if is_catchall_pattern(pattern):
							outer_arm: PatternMatrixArm = { arm |
								patterns = arm.patterns.set(position, WildcardPattern),
								bindings = arm.bindings.concat(
									collect_pattern_bindings(
										accessor,
										pattern,
									),
								)
							}

							match compile_pattern_matrix(
								kind,
								base,
								[outer_arm],
								SemanticMatchFail,
							):
								Some(arm_tree):
									result = replace_semantic_match_fail(arm_tree, result)
								None:
									failed = True
									break
						else:
							failed = True
							break
					None:
						failed = True
						break
			None:
				failed = True
				break

	if failed:
		None
	else:
		Some(result)


private pure func list_spread_tree_binding(
	base: CoreSemanticMatchAccessor,
	fixed_length: Int,
	spread: Option[CorePattern],
	body: CoreSemanticMatchTree,
) -> List[CoreSemanticMatchBinding]:
	match spread:
		Some(NamePattern(name)):
			if semantic_match_tree_name_may_occur_free(body, name):
				[semantic_binding(
						name,
						ListSpreadSemanticMatchAccessor(base, fixed_length),
					)]
			else:
				[]
		_:
			[]


private pure func compile_pattern_matrix_list_column(
	kind: PatternMatrixAccessorKind,
	base: CoreSemanticMatchAccessor,
	arms: List[PatternMatrixArm],
	position: Int,
	fallback: CoreSemanticMatchTree,
) -> Option[CoreSemanticMatchTree]:
	accessor: CoreSemanticMatchAccessor = pattern_matrix_accessor(kind, base, position)
	var result: CoreSemanticMatchTree = fallback
	var index: Int = arms.length()
	var failed: Bool = False

	while index > 0:
		index -= 1

		match arms.get(index):
			Some(arm):
				match arm.patterns.get(position):
					Some(ListPattern(patterns, spread)):
						outer_arm: PatternMatrixArm = { arm |
							patterns = arm.patterns.set(position, WildcardPattern)
						}

						match compile_pattern_matrix(kind, base, [outer_arm], SemanticMatchFail):
							Some(continuation):
								list_arm: PatternMatrixArm = {
									patterns = patterns,
									bindings = list_spread_tree_binding(
										accessor,
										patterns.length(),
										spread,
										continuation,
									),
									body = continuation
								}

								match compile_pattern_matrix(
									ListPatternMatrixAccessors,
									accessor,
									[list_arm],
									SemanticMatchFail,
								):
									Some(body):
										arm_tree: CoreSemanticMatchTree = if spread.is_some():
											SemanticLengthMatch(accessor, [], Some({
													minimum_length = patterns.length(),
													body = body,
												}), Some(SemanticMatchFail))
										else:
											SemanticLengthMatch(
												accessor,
												[
													{
														length = patterns.length(),
														body = body
													},
												],
												None,
												Some(SemanticMatchFail),
											)

										result = replace_semantic_match_fail(arm_tree, result)
									None:
										failed = True
										break
							None:
								failed = True
								break
					Some(pattern):
						if is_catchall_pattern(pattern):
							outer_arm: PatternMatrixArm = { arm |
								patterns = arm.patterns.set(position, WildcardPattern),
								bindings = arm.bindings.concat(
									collect_pattern_bindings(
										accessor,
										pattern,
									),
								)
							}

							match compile_pattern_matrix(
								kind,
								base,
								[outer_arm],
								SemanticMatchFail,
							):
								Some(arm_tree):
									result = replace_semantic_match_fail(arm_tree, result)
								None:
									failed = True
									break
						else:
							failed = True
							break
					None:
						failed = True
						break
			None:
				failed = True
				break

	if failed:
		None
	else:
		Some(result)


private pure func compile_pattern_matrix(
	kind: PatternMatrixAccessorKind,
	base: CoreSemanticMatchAccessor,
	arms: List[PatternMatrixArm],
	fallback: CoreSemanticMatchTree,
) -> Option[CoreSemanticMatchTree]:
	match arms.get(0):
		Some(first_arm):
			match pattern_matrix_split_index(arms):
				Some(position):
					if pattern_matrix_column_has_literal(arms, position):
						compile_pattern_matrix_literal_column(kind, base, arms, position, fallback)
					else if pattern_matrix_column_has_constructor(arms, position):
						compile_pattern_matrix_constructor_column(
							kind,
							base,
							arms,
							position,
							fallback,
						)
					else if pattern_matrix_column_has_tuple(arms, position):
						compile_pattern_matrix_tuple_column(kind, base, arms, position, fallback)
					else if pattern_matrix_column_has_list(arms, position):
						compile_pattern_matrix_list_column(kind, base, arms, position, fallback)
					else:
						None
				None:
					Some(
						prepend_semantic_bindings(
							first_arm.body,
							first_arm.bindings.concat(
								pattern_matrix_bindings(
									kind,
									base,
									first_arm.patterns,
								),
							),
						),
					)
		None:
			Some(fallback)


private pure func compile_tuple_match_cases(
	cases: List[CoreRawMatchCase],
) -> Option[CoreSemanticMatchTree]:
	split: SplitMatchCases = split_trailing_catchall(cases)

	fallback: CoreSemanticMatchTree = match split.fallback:
		Some(fallback_case):
			catchall_leaf(fallback_case.pattern, fallback_case.body)
		None:
			SemanticMatchFail

	var arms: List[PatternMatrixArm] = []
	var failed: Bool = False

	for match_case in split.tested:
		match match_case.pattern:
			TuplePattern(patterns):
				arms = arms.append({
					patterns = patterns,
					bindings = [],
					body = SemanticMatchLeaf([], match_case.body),
				})
			_:
				failed = True
				break

	if failed:
		None
	else:
		compile_pattern_matrix(
			TuplePatternMatrixAccessors,
			RootSemanticMatchAccessor,
			arms,
			fallback,
		)


private pure func params_shadow_name(params: List[CoreParam], name: String) -> Bool:
	var shadows: Bool = False

	for param in params:
		if param.name.name == name:
			shadows = True
			break

	shadows


private pure func append_scoped_core_exprs(
	work: List[ScopedCoreExpr],
	exprs: List[CoreExpr],
	target_shadowed: Bool,
) -> List[ScopedCoreExpr]:
	var result: List[ScopedCoreExpr] = work

	for expr in exprs:
		result = result.append({
			expr = expr,
			target_shadowed = target_shadowed,
		})

	result


-- This is deliberately conservative for already-compiled match forms: those
-- forms cannot appear at the post-synth input to this pass, and treating their
-- bindings as uses can only retain an otherwise avoidable spread allocation.
private pure func core_name_may_occur_free(name: String, root: CoreExpr) -> Bool:
	var work: List[ScopedCoreExpr] = [
		{
			expr = root,
			target_shadowed = False
		},
	]
	var work_index: Int = 0
	var found: Bool = False

	while work_index < work.length():
		match work.get(work_index):
			Some(item):
				work_index += 1

				match item.expr:
					VarExpr(variable, _, _):
						if not item.target_shadowed and variable.name == name:
							found = True
					AssignExpr(variable, rhs, _, _):
						if not item.target_shadowed and variable.name == name:
							found = True
						else:
							work = work.append({
								expr = rhs,
								target_shadowed = item.target_shadowed,
							})
					DupExpr(variable, _, _, body, _, _) | DropExpr(variable, _, _, body, _, _):
						if not item.target_shadowed and variable.name == name:
							found = True
						else:
							work = work.append({
								expr = body,
								target_shadowed = item.target_shadowed,
							})
					LetExpr(variable, _, _, rhs, body) | BorrowLetExpr(variable, _, rhs, body):
						work = work.append({
							expr = rhs,
							target_shadowed = item.target_shadowed,
						})
						work = work.append({
							expr = body,
							target_shadowed = item.target_shadowed or variable.name == name,
						})
					LambdaExpr(params, _, body, _, _, _):
						work = work.append({
							expr = body,
							target_shadowed = (
								item.target_shadowed
								or params_shadow_name(params, name)
							),
						})
					TensorRawViewLetExpr(binding, body, _, _):
						work = work.append({
							expr = binding.source,
							target_shadowed = item.target_shadowed,
						})
						work = work.append({
							expr = body,
							target_shadowed = item.target_shadowed or binding.variable.name == name,
						})
					ListHandoffExpr(handoff, _, _):
						work = work.append({
							expr = handoff.source,
							target_shadowed = item.target_shadowed,
						})
						work = work.append({
							expr = handoff.capacity,
							target_shadowed = item.target_shadowed,
						})
						handoff_shadows: Bool = (
							handoff.source_var.name == name
							or handoff.result_var.name == name
							or handoff.len_var.name == name
							or handoff.out_var.name == name
						)

						work = work.append({
							expr = handoff.body,
							target_shadowed = item.target_shadowed or handoff_shadows,
						})
					ResourceScopeExpr(scope, _, _):
						work = work.append({
							expr = scope.acquire,
							target_shadowed = item.target_shadowed,
						})
						scoped_shadowed: Bool = item.target_shadowed or scope.variable.name == name

						work = work.append({
							expr = scope.body,
							target_shadowed = scoped_shadowed,
						})
						work = work.append({
							expr = scope.cleanup,
							target_shadowed = scoped_shadowed,
						})
					TailrecLoopExpr(params, _, body, _):
						work = work.append({
							expr = body,
							target_shadowed = (
								item.target_shadowed
								or params_shadow_name(params, name)
							),
						})
					TailrecListSpreadLoopExpr(loop, _):
						work = work.append({
							expr = loop.body,
							target_shadowed = (
								item.target_shadowed
								or params_shadow_name(loop.params, name)
								or loop.cursor.name == name
							),
						})
					ForRangeExpr(binder, start, end_value, body, _, _):
						work = append_scoped_core_exprs(
							work,
							[start, end_value],
							item.target_shadowed,
						)
						work = work.append({
							expr = body,
							target_shadowed = item.target_shadowed or binder.variable.name == name,
						})
					ForChannelExpr(loop, _, _):
						work = work.append({
							expr = loop.iterable,
							target_shadowed = item.target_shadowed,
						})
						work = work.append({
							expr = loop.body,
							target_shadowed = (
								item.target_shadowed
								or loop.binder.variable.name == name
							),
						})
					ForListExpr(loop, _, _):
						work = work.append({
							expr = loop.iterable,
							target_shadowed = item.target_shadowed,
						})
						work = work.append({
							expr = loop.body,
							target_shadowed = (
								item.target_shadowed
								or loop.binder.variable.name == name
							),
						})
					ForStringExpr(loop, _, _):
						work = work.append({
							expr = loop.iterable,
							target_shadowed = item.target_shadowed,
						})
						work = work.append({
							expr = loop.body,
							target_shadowed = (
								item.target_shadowed
								or loop.binder.variable.name == name
							),
						})
					ForDictExpr(loop, _, _):
						work = work.append({
							expr = loop.iterable,
							target_shadowed = item.target_shadowed,
						})
						work = work.append({
							expr = loop.body,
							target_shadowed = (
								item.target_shadowed
								or loop.binder.variable.name == name
							),
						})
					ForSetExpr(loop, _, _):
						work = work.append({
							expr = loop.iterable,
							target_shadowed = item.target_shadowed,
						})
						work = work.append({
							expr = loop.body,
							target_shadowed = (
								item.target_shadowed
								or loop.binder.variable.name == name
							),
						})
					ForStreamExpr(loop, _, _):
						work = work.append({
							expr = loop.iterable,
							target_shadowed = item.target_shadowed,
						})
						work = work.append({
							expr = loop.body,
							target_shadowed = (
								item.target_shadowed
								or loop.binder.variable.name == name
							),
						})
					ForResourceSourceExpr(loop, _, _):
						work = work.append({
							expr = loop.iterable,
							target_shadowed = item.target_shadowed,
						})
						work = work.append({
							expr = loop.body,
							target_shadowed = (
								item.target_shadowed
								or loop.binder.variable.name == name
							),
						})
					ForTensorExpr(loop, _, _):
						work = work.append({
							expr = loop.iterable,
							target_shadowed = item.target_shadowed,
						})
						work = work.append({
							expr = loop.body,
							target_shadowed = (
								item.target_shadowed
								or loop.binder.variable.name == name
							),
						})
					PreClosureConcurrentlyLoopExpr(loop, _, _):
						work = append_scoped_core_exprs(
							work,
							[loop.iterable, loop.limit],
							item.target_shadowed,
						)

						match loop.timeout:
							Some(timeout):
								work = work.append({
									expr = timeout,
									target_shadowed = item.target_shadowed,
								})
							None:
								void

						work = work.append({
							expr = loop.body,
							target_shadowed = item.target_shadowed or loop.variable.name == name,
						})
					ConcurrentlyLoopExpr(loop, _, _):
						work = append_scoped_core_exprs(
							work,
							[loop.iterable, loop.limit],
							item.target_shadowed,
						)

						match loop.timeout:
							Some(timeout):
								work = work.append({
									expr = timeout,
									target_shadowed = item.target_shadowed,
								})
							None:
								void

						work = work.append({
							expr = loop.body,
							target_shadowed = item.target_shadowed or loop.variable.name == name,
						})
					PreClosureConcurrentExpr(block, _, _):
						var body_shadowed: Bool = item.target_shadowed

						for binding in block.bindings:
							work = work.append({
								expr = binding.rhs,
								target_shadowed = item.target_shadowed,
							})

							if binding.variable.name == name:
								body_shadowed = True

						work = work.append({
							expr = block.body,
							target_shadowed = body_shadowed,
						})

						match block.timeout:
							Some(timeout):
								work = work.append({
									expr = timeout,
									target_shadowed = item.target_shadowed,
								})
							None:
								void
					ConcurrentExpr(block, _, _):
						var body_shadowed: Bool = item.target_shadowed

						for binding in block.bindings:
							work = work.append({
								expr = binding.rhs,
								target_shadowed = item.target_shadowed,
							})

							if binding.variable.name == name:
								body_shadowed = True

						work = work.append({
							expr = block.body,
							target_shadowed = body_shadowed,
						})

						match block.timeout:
							Some(timeout):
								work = work.append({
									expr = timeout,
									target_shadowed = item.target_shadowed,
								})
							None:
								void
					SelectExpr(arms, _, _):
						for arm in arms:
							match arm.kind:
								SelectRecvArm(recv):
									work = work.append({
										expr = recv.channel,
										target_shadowed = item.target_shadowed,
									})
									work = work.append({
										expr = arm.body,
										target_shadowed = (
											item.target_shadowed
											or recv.binder.name == name
										),
									})
								SelectSealedArm(channel):
									work = append_scoped_core_exprs(
										work,
										[channel, arm.body],
										item.target_shadowed,
									)
								SelectAfterArm(timeout):
									work = append_scoped_core_exprs(
										work,
										[timeout, arm.body],
										item.target_shadowed,
									)
					RawMatchExpr(scrutinee, cases, _, _):
						work = work.append({
							expr = scrutinee,
							target_shadowed = item.target_shadowed,
						})

						for match_case in cases:
							work = work.append({
								expr = match_case.body,
								target_shadowed = (
									item.target_shadowed
									or CoreTraverse
										.core_pattern_bound_names(match_case.pattern)
										.contains(name)
								),
							})
					_:
						work = append_scoped_core_exprs(
							work,
							CoreTraverse.immediate_core_expr_children(item.expr),
							item.target_shadowed,
						)
			None:
				break

		if found:
			break

	found


private pure func list_spread_binding(
	base: CoreSemanticMatchAccessor,
	fixed_length: Int,
	spread: Option[CorePattern],
	body: CoreExpr,
) -> List[CoreSemanticMatchBinding]:
	match spread:
		Some(NamePattern(name)):
			if core_name_may_occur_free(name, body):
				[semantic_binding(
						name,
						ListSpreadSemanticMatchAccessor(base, fixed_length),
					)]
			else:
				[]
		_:
			[]


private pure func compile_list_pattern_sequence(
	base: CoreSemanticMatchAccessor,
	arms: List[ListPatternSequenceArm],
	fallback: CoreSemanticMatchTree,
) -> Option[CoreSemanticMatchTree]:
	var result: CoreSemanticMatchTree = fallback
	var index: Int = arms.length()
	var failed: Bool = False

	while index > 0:
		index -= 1

		match arms.get(index):
			Some(ExactListPatternArm(arm)):
				match compile_pattern_matrix(ListPatternMatrixAccessors, base, [arm], result):
					Some(body):
						result = SemanticLengthMatch(
							base,
							[
								{
									length = arm.patterns.length(),
									body = body
								},
							],
							None,
							Some(result),
						)
					None:
						failed = True
						break
			Some(SpreadListPatternArm(arm)):
				match compile_pattern_matrix(ListPatternMatrixAccessors, base, [arm], result):
					Some(body):
						result = SemanticLengthMatch(base, [], Some({
								minimum_length = arm.patterns.length(),
								body = body,
							}), Some(result))
					None:
						failed = True
						break
			Some(CatchallListPatternArm(bindings, body)):
				result = prepend_semantic_bindings(body, bindings)
			None:
				failed = True
				break

	if failed:
		None
	else:
		Some(result)


private pure func compile_list_match_cases(
	cases: List[CoreRawMatchCase],
) -> Option[CoreSemanticMatchTree]:
	split: SplitMatchCases = split_trailing_catchall(cases)

	fallback: CoreSemanticMatchTree = match split.fallback:
		Some(fallback_case):
			catchall_leaf(fallback_case.pattern, fallback_case.body)
		None:
			SemanticMatchFail

	var arms: List[ListPatternSequenceArm] = []
	var failed: Bool = False

	for match_case in split.tested:
		match match_case.pattern:
			ListPattern(patterns, None):
				arms = arms.append(ExactListPatternArm({
					patterns = patterns,
					bindings = [],
					body = SemanticMatchLeaf([], match_case.body),
				}))
			ListPattern(patterns, spread):
				arms = arms.append(SpreadListPatternArm({
					patterns = patterns,
					bindings = list_spread_binding(
						RootSemanticMatchAccessor,
						patterns.length(),
						spread,
						match_case.body,
					),
					body = SemanticMatchLeaf([], match_case.body),
				}))
			_:
				failed = True
				break

	if failed:
		None
	else:
		compile_list_pattern_sequence(RootSemanticMatchAccessor, arms, fallback)


private pure func compile_literal_match_cases(
	cases: List[CoreRawMatchCase],
) -> Option[CoreSemanticMatchTree]:
	split: SplitMatchCases = split_trailing_catchall(cases)

	fallback: CoreSemanticMatchTree = match split.fallback:
		Some(fallback_case):
			catchall_leaf(fallback_case.pattern, fallback_case.body)
		None:
			SemanticMatchFail

	var literal_cases: List[CoreSemanticLiteralMatchCase] = []
	var failed: Bool = False

	for match_case in split.tested:
		match match_case.pattern:
			LiteralPattern(literal):
				literal_cases = literal_cases.append({
					literal = literal,
					body = SemanticMatchLeaf([], match_case.body),
				})
			_:
				failed = True
				break

	if failed:
		None
	else:
		Some(SemanticLiteralMatch(RootSemanticMatchAccessor, literal_cases, fallback))


private pure func compile_constructor_match_cases(
	cases: List[CoreRawMatchCase],
) -> Option[CoreSemanticMatchTree]:
	split: SplitMatchCases = split_trailing_catchall(cases)
	fallback: Option[CoreSemanticMatchTree] = split.fallback.map(
		func(fallback_case): catchall_leaf(fallback_case.pattern, fallback_case.body),
	)
	groups ?= group_constructor_cases(split.tested)
	var constructor_cases: List[CoreSemanticConstructorMatchCase] = []
	var failed: Bool = False

	for group in groups:
		match compile_constructor_group_tree(
			RootSemanticMatchAccessor,
			group.constructor,
			group.arms,
			fallback,
		):
			Some(body):
				constructor_cases = constructor_cases.append({
					constructor = group.constructor,
					body = body,
				})
			None:
				failed = True
				break

	if failed:
		None
	else:
		Some(SemanticConstructorMatch(RootSemanticMatchAccessor, constructor_cases, fallback))


pure func compile_match_cases(
	constructors: Set[String],
	cases: List[CoreRawMatchCase],
) -> Option[CoreSemanticMatchTree]:
	normalized_cases: List[CoreRawMatchCase] = expand_or_match_cases(
		normalize_match_cases(
			constructors,
			cases,
		),
	)

	match match_case_shape(normalized_cases):
		CatchallMatchCases:
			match normalized_cases.get(0):
				Some(match_case):
					Some(catchall_leaf(match_case.pattern, match_case.body))
				None:
					None
		LiteralMatchCases:
			compile_literal_match_cases(normalized_cases)
		ConstructorMatchCases:
			compile_constructor_match_cases(normalized_cases)
		TupleMatchCases:
			compile_tuple_match_cases(normalized_cases)
		ListMatchCases:
			compile_list_match_cases(normalized_cases)
		UnsupportedMatchCases:
			None


private pure func compile_expr(constructors: Set[String], expr: CoreExpr) -> CoreExpr:
	mapped_expr: CoreExpr = CoreTraverse.map_core_expr_children(
		expr,
		func(child): compile_expr(constructors, child),
	)

	match mapped_expr:
		RawMatchExpr(scrutinee, cases, typ, loc):
			normalized_cases: List[CoreRawMatchCase] = normalize_match_cases(constructors, cases)

			match try_fuse_direct_constructor_match(constructors, scrutinee, normalized_cases):
				Some(fused):
					fused
				None:
					match compile_match_cases(constructors, normalized_cases):
						Some(tree):
							SemanticMatchExpr(scrutinee, tree, typ, loc)
						None:
							RawMatchExpr(scrutinee, normalized_cases, typ, loc)
		_:
			mapped_expr


private pure func compile_function(
	constructors: Set[String],
	function_info: CoreFunction,
) -> CoreFunction:
	{ function_info | body = function_info.body.map(func(body): compile_expr(constructors, body)) }


private pure func compile_global(constructors: Set[String], global: CoreGlobal) -> CoreGlobal:
	{ global | init = compile_expr(constructors, global.init) }


private pure func compile_impl(constructors: Set[String], impl: CoreImplDecl) -> CoreImplDecl:
	{ impl | methods = impl.methods.map(func(method): compile_function(constructors, method)) }


private pure func compile_decl(constructors: Set[String], decl: CoreDecl) -> CoreDecl:
	match decl:
		FunctionDecl(function_info):
			FunctionDecl(compile_function(constructors, function_info))
		GlobalDecl(global):
			GlobalDecl(compile_global(constructors, global))
		ImplDecl(impl):
			ImplDecl(compile_impl(constructors, impl))
		_:
			decl


pure func compile_program(program: CoreProgram) -> CoreProgram:
	constructors: Set[String] = collect_match_constructor_names(program)

	{ program | decls = program.decls.map(func(decl): compile_decl(constructors, decl)) }
