pure func is_primitive_tuple_slot_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			if args.length() != 0:
				False
			else if name == "Int":
				True
			else if name == "Int8":
				True
			else if name == "Int16":
				True
			else if name == "Int32":
				True
			else if name == "Int64":
				True
			else if name == "UInt8":
				True
			else if name == "UInt16":
				True
			else if name == "UInt32":
				True
			else if name == "UInt64":
				True
			else if name == "Bool":
				True
			else:
				name == "Char"
		TypeParameterType(_) | SelfType:
			False
		VoidType:
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		HeapRecordType(name):
			False
		UnionType(name):
			False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			False
		FunctionType(_, _, _):
			False
		RangeType:
			True
		TensorType(info):
			False
		TupleType(items):
			False


private pure func is_managed_pointer_tuple_slot_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			if name == "Option":
				match args:
					[payload]:
						match stack_option_c_type(payload):
							Some(option_type):
								False
							None:
								True
					[]:
						False
					[first, second, ...rest]:
						False
			else if name == "String" and args.length() == 0:
				True
			else if name == "Bytes" and args.length() == 0:
				True
			else if name == "Fixed" and args.length() == 0:
				True
			else if name == "Closure" and args.length() == 0:
				True
			else if name == "List" and args.length() == 1:
				True
			else if name == "Dict" and args.length() == 2:
				True
			else:
				name == "Set" and args.length() == 1
		TypeParameterType(_) | SelfType:
			False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			True
		FunctionType(_, _, _):
			True
		HeapRecordType(name):
			False
		UnionType(name):
			False
		TupleType(items):
			True
		VoidType:
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		RangeType:
			False
		TensorType(info):
			True


private pure func is_unmanaged_pointer_tuple_slot_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			name == "Ptr" and args.length() == 0
		TypeParameterType(_) | SelfType:
			False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			False
		FunctionType(_, _, _):
			False
		HeapRecordType(name):
			False
		UnionType(name):
			False
		TupleType(items):
			False
		VoidType:
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		RangeType:
			False
		TensorType(info):
			False


private pure func is_pointer_tuple_slot_type(typ: CoreType) -> Bool:
	is_managed_pointer_tuple_slot_type(typ) or is_unmanaged_pointer_tuple_slot_type(typ)


private pure func tuple_slot_needs_release(typ: CoreType) -> Bool:
	is_managed_pointer_tuple_slot_type(typ)


private pure func stack_option_tuple_slot_c_type(typ: CoreType) -> Option[String]:
	match typ:
		NamedType(name, args):
			if name == "Option":
				match args:
					[payload]:
						stack_option_c_type(payload)
					[]:
						None
					[first, second, ...rest]:
						None
			else:
				None
		TypeParameterType(_) | SelfType:
			None
		VoidType:
			None
		EnumType(name):
			None
		ValueRecordType(name):
			None
		HeapRecordType(name):
			None
		UnionType(name):
			None
		StackResultType(ok_type, err_type):
			None
		BoxedResultType(ok_type, err_type):
			None
		FunctionType(_, _, _):
			None
		RangeType:
			None
		TensorType(info):
			None
		TupleType(items):
			None


private pure func is_nullable_option_payload_type(payload: CoreType) -> Bool:
	match payload:
		NamedType(name, args):
			if name == "Option" and args.length() == 1:
				False
			else:
				pointer_box_storage_needs_release_type(payload)
		TypeParameterType(_) | SelfType:
			False
		BoxedResultType(ok_type, err_type):
			True
		FunctionType(_, _, _):
			True
		HeapRecordType(name):
			True
		UnionType(name):
			True
		TupleType(items):
			True
		TensorType(info):
			True
		StackResultType(ok_type, err_type):
			False
		VoidType:
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		RangeType:
			False


private pure func float_tuple_element(item: CoreExpr, typ: CoreType) -> Option[CoreTupleElement]:
	match typ:
		NamedType(name, args):
			if args.length() != 0:
				None
			else if name == "Float":
				Some(TupleFloatElement(item))
			else if name == "Float32":
				Some(TupleFloat32Element(item))
			else if name == "Float16":
				Some(TupleFloat16Element(item))
			else:
				None
		TypeParameterType(_) | SelfType:
			None
		VoidType:
			None
		EnumType(name):
			None
		ValueRecordType(name):
			None
		HeapRecordType(name):
			None
		UnionType(name):
			None
		StackResultType(ok_type, err_type):
			None
		BoxedResultType(ok_type, err_type):
			None
		FunctionType(_, _, _):
			None
		RangeType:
			None
		TensorType(info):
			None
		TupleType(items):
			None


private pure func release_policy_requires_release(policy: CoreReleasePolicy) -> Bool:
	match policy:
		NoReleasePolicy:
			False
		ArcReleasePolicy:
			True
		ArcReleaseOnlyPolicy:
			True
		StackResultReleasePolicy:
			True


private pure func union_field_requires_release(field: CoreUnionField) -> Bool:
	release_policy_requires_release(field.release_policy)


private pure func union_variant_uses_release_mask(
	payload_storage: CoreUnionPayloadStorage,
	variant: CoreUnionVariant,
) -> Bool:
	match payload_storage:
		TypedUnionPayloadStorage:
			False
		ErasedUnionPayloadStorage:
			var needs_release: Bool = False

			for field in variant.fields:
				if union_field_requires_release(field):
					needs_release = True
					break

			needs_release


private pure func release_mask_for_boxed_args(args: List[CoreBoxedStorageValue]) -> Int:
	var release_mask: Int = 0
	var index: Int = 0

	for arg in args:
		if arg.needs_release:
			release_mask += int_power_of_two(index)

		index += 1

	release_mask


private pure func int_power_of_two(exponent: Int) -> Int:
	var result: Int = 1
	var index: Int = 0

	while index < exponent:
		result *= 2
		index += 1

	result


private pure func core_vars_equal(left: CoreVar, right: CoreVar) -> Bool:
	left.name == right.name and left.uniq == right.uniq and left.def_id == right.def_id


record TensorStorageBinding {
	variable: CoreVar,
	raw_kind: CoreTensorRawScalarKind
}


private pure func tensor_storage_env_without(
	env: List[TensorStorageBinding],
	variable: CoreVar,
) -> List[TensorStorageBinding]:
	var result: List[TensorStorageBinding] = []

	for binding in env:
		if not core_vars_equal(binding.variable, variable):
			result = result.append(binding)

	result


private pure func tensor_storage_env_lookup(
	env: List[TensorStorageBinding],
	variable: CoreVar,
) -> Option[CoreTensorRawScalarKind]:
	var result: Option[CoreTensorRawScalarKind] = None

	for binding in env:
		if core_vars_equal(binding.variable, variable):
			result = Some(binding.raw_kind)

	result


private pure func tensor_storage_env_add(
	env: List[TensorStorageBinding],
	variable: CoreVar,
	raw_kind: CoreTensorRawScalarKind,
) -> List[TensorStorageBinding]:
	[
		{
			variable = variable,
			raw_kind = raw_kind
		},
	].concat(tensor_storage_env_without(env, variable))


private pure func tensor_fill_raw_kind(name: String) -> Option[CoreTensorRawScalarKind]:
	if name == "blorp_vector_new_fill_f64":
		Some(TensorFloat64Elements)
	else if name == "blorp_vector_new_fill_f32":
		Some(TensorFloat32Elements)
	else if name == "blorp_vector_new_fill_i64":
		Some(TensorInt64Elements)
	else:
		None


private pure func tensor_expr_raw_kind(
	env: List[TensorStorageBinding],
	expr: CoreExpr,
) -> Option[CoreTensorRawScalarKind]:
	match expr:
		VarExpr(variable, typ, loc):
			tensor_storage_env_lookup(env, variable)
		TensorLiteralExpr(literal, typ, loc):
			match literal.payload:
				TensorRawLiteralPayload(raw):
					Some(raw.raw_kind)
				TensorInlineStructLiteralPayload(inline_struct):
					None
		TensorRawFillExpr(fill, typ, loc):
			Some(fill.raw_kind)
		CallExpr(BuiltinCall(name), callee, args, typ, loc):
			tensor_fill_raw_kind(name)
		CallExpr(DirectRuntimeCall(call), callee, args, typ, loc):
			tensor_fill_raw_kind(call.name)
		_:
			None


private pure func tensor_storage_guard_matches(
	intrinsic_name: String,
	raw_kind: CoreTensorRawScalarKind,
) -> Bool:
	match raw_kind:
		TensorFloat64Elements:
			intrinsic_name == "tensor_is_f64_storage"
		TensorFloat32Elements:
			intrinsic_name == "tensor_is_f32_storage"
		TensorInt64Elements:
			intrinsic_name == "tensor_is_i64_storage"


private pure func tensor_storage_guard_proven(
	env: List[TensorStorageBinding],
	cond: CoreExpr,
) -> Bool:
	match cond:
		CallExpr(IntrinsicCall(intrinsic_name), callee, args, typ, loc):
			match args:
				[source]:
					match tensor_expr_raw_kind(env, source):
						Some(raw_kind):
							tensor_storage_guard_matches(intrinsic_name, raw_kind)
						None:
							False
				[]:
					False
				[first, second, ...rest]:
					False
		_:
			False


private pure func tensor_storage_env_after_binding(
	env: List[TensorStorageBinding],
	variable: CoreVar,
	is_mutable: Bool,
	value_type: CoreType,
	rhs: CoreExpr,
) -> List[TensorStorageBinding]:
	if is_mutable:
		tensor_storage_env_without(env, variable)
	else:
		match tensor_expr_raw_kind(env, rhs):
			Some(raw_kind):
				tensor_storage_env_add(env, variable, raw_kind)
			None:
				tensor_storage_env_without(env, variable)


private pure func raw_scalar_tensor_element_storage_or(
	env: List[TensorStorageBinding],
	iterable: CoreExpr,
	fallback: CoreTensorForElementStorage,
) -> CoreTensorForElementStorage:
	match tensor_expr_raw_kind(env, iterable):
		Some(raw_kind):
			TensorForRawScalarElement(raw_kind)
		None:
			clone_tensor_for_element_storage(fallback)


private pure func tensor_for_element_storage_after_raw_proof(
	env: List[TensorStorageBinding],
	iterable: CoreExpr,
	storage: CoreTensorForElementStorage,
) -> CoreTensorForElementStorage:
	match storage:
		TensorForRowSliceElement(row_slice):
			TensorForRowSliceElement({
				row_size = row_slice.row_size,
				result_first_dim = row_slice.result_first_dim,
				runtime_derived = row_slice.runtime_derived,
			})
		TensorForInlineStructElement(c_type):
			raw_scalar_tensor_element_storage_or(env, iterable, storage)
		TensorForRawScalarElement(raw_kind):
			raw_scalar_tensor_element_storage_or(env, iterable, storage)
		TensorForRuntimeReadElement(runtime_read):
			raw_scalar_tensor_element_storage_or(env, iterable, storage)
		TensorForBoxedElement(value_c_type):
			raw_scalar_tensor_element_storage_or(env, iterable, storage)


private pure func annotate_tensor_storage_expr(
	env: List[TensorStorageBinding],
	expr: CoreExpr,
) -> CoreExpr:
	match expr:
		LetExpr(variable, is_mutable, value_type, rhs, body):
			annotated_rhs: CoreExpr = annotate_tensor_storage_expr(env, rhs)

			match body:
				IfExpr(guard, then_expr, else_expr, typ, loc):
					match guard:
						VarExpr(guard_var, guard_type, guard_loc):
							if (
								core_vars_equal(variable, guard_var)
								and tensor_storage_guard_proven(env, annotated_rhs)
							):
								annotate_tensor_storage_expr(env, then_expr)
							else:
								next_env: List[TensorStorageBinding] = tensor_storage_env_after_binding(
									env,
									variable,
									is_mutable,
									value_type,
									annotated_rhs,
								)
								LetExpr(
									variable,
									is_mutable,
									value_type,
									annotated_rhs,
									annotate_tensor_storage_expr(next_env, body),
								)
						_:
							next_env: List[TensorStorageBinding] = tensor_storage_env_after_binding(
								env,
								variable,
								is_mutable,
								value_type,
								annotated_rhs,
							)
							LetExpr(
								variable,
								is_mutable,
								value_type,
								annotated_rhs,
								annotate_tensor_storage_expr(next_env, body),
							)
				_:
					next_env: List[TensorStorageBinding] = tensor_storage_env_after_binding(
						env,
						variable,
						is_mutable,
						value_type,
						annotated_rhs,
					)
					LetExpr(
						variable,
						is_mutable,
						value_type,
						annotated_rhs,
						annotate_tensor_storage_expr(next_env, body),
					)
		BorrowLetExpr(variable, value_type, rhs, body):
			annotated_rhs: CoreExpr = annotate_tensor_storage_expr(env, rhs)
			next_env: List[TensorStorageBinding] = tensor_storage_env_after_binding(
				env,
				variable,
				False,
				value_type,
				annotated_rhs,
			)
			BorrowLetExpr(
				variable,
				value_type,
				annotated_rhs,
				annotate_tensor_storage_expr(next_env, body),
			)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			DropExpr(
				variable,
				value_type,
				release_policy,
				annotate_tensor_storage_expr(
					tensor_storage_env_without(env, variable),
					body,
				),
				typ,
				loc,
			)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			DupExpr(
				variable,
				value_type,
				retain_policy,
				annotate_tensor_storage_expr(env, body),
				typ,
				loc,
			)
		SeqExpr(first, second):
			SeqExpr(
				annotate_tensor_storage_expr(env, first),
				annotate_tensor_storage_expr(env, second),
			)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			annotated_cond: CoreExpr = annotate_tensor_storage_expr(env, cond)

			if tensor_storage_guard_proven(env, annotated_cond):
				annotate_tensor_storage_expr(env, then_expr)
			else:
				IfExpr(
					annotated_cond,
					annotate_tensor_storage_expr(env, then_expr),
					annotate_tensor_storage_expr(env, else_expr),
					typ,
					loc,
				)
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			ForRangeExpr(
				binder,
				annotate_tensor_storage_expr(env, start),
				annotate_tensor_storage_expr(env, end_value),
				annotate_tensor_storage_expr(
					tensor_storage_env_without(env, binder.variable),
					body,
				),
				typ,
				loc,
			)
		ForTensorExpr(for_tensor, typ, loc):
			annotated_iterable: CoreExpr = annotate_tensor_storage_expr(env, for_tensor.iterable)
			element_storage: CoreTensorForElementStorage = tensor_for_element_storage_after_raw_proof(
				env,
				annotated_iterable,
				for_tensor.element_storage,
			)

			ForTensorExpr(
				{
					binder = for_tensor.binder,
					element_storage = element_storage,
					iterable = annotated_iterable,
					iterable_release_policy = for_tensor.iterable_release_policy,
					body = annotate_tensor_storage_expr(
						tensor_storage_env_without(env, for_tensor.binder.variable),
						for_tensor.body,
					)
				},
				typ,
				loc,
			)
		TensorRawViewLetExpr(binding, body, typ, loc):
			TensorRawViewLetExpr(
				{
					variable = binding.variable,
					kind = binding.kind,
					source = annotate_tensor_storage_expr(env, binding.source)
				},
				annotate_tensor_storage_expr(
					tensor_storage_env_without(env, binding.variable),
					body,
				),
				typ,
				loc,
			)
		WhileExpr(cond, body, typ, loc):
			WhileExpr(
				annotate_tensor_storage_expr(env, cond),
				annotate_tensor_storage_expr(env, body),
				typ,
				loc,
			)
		_:
			expr


private pure func tuple_pointer_expr_needs_retain(expr: CoreExpr) -> Bool:
	match expr:
		LiteralExpr(literal, typ, loc):
			match literal:
				StringLiteral(value):
					False
				IntLiteral(value):
					False
				WideIntLiteral(value):
					False
				FloatLiteral(value):
					False
				FloatTextLiteral(value):
					False
				FloatInfinityLiteral:
					False
				FloatNegInfinityLiteral:
					False
				FloatNanLiteral:
					False
				BoolLiteral(value):
					False
				CharLiteral(value):
					False
		VarExpr(variable, typ, loc):
			False
		FieldExpr(expr_value, field_name, typ, loc):
			True
		TupleFieldExpr(expr_value, field_index, typ, loc):
			True
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			True
		ListGetExpr(get, typ, loc):
			True
		CooperativeCheckpointExpr(typ, loc):
			False
		VoidExpr(typ, loc):
			False
		DebugBlockExpr(body, typ, loc):
			False
		CallExpr(kind, callee, args, typ, loc):
			False
		BinaryExpr(op, left, right, typ, loc):
			False
		UnaryExpr(op, expr_value, typ, loc):
			False
		LogicalExpr(op, left, right, typ, loc):
			False
		AssignExpr(variable, rhs, typ, loc):
			False
		CastExpr(expr_value, typ, loc):
			False
		BoxExpr(box, typ, loc):
			False
		TupleExpr(items, typ, loc):
			False
		TupleConstructExpr(tuple_construct, typ, loc):
			False
		VectorExpr(items, typ, loc):
			False
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			False
		ClosureCreateExpr(closure, typ, loc):
			False
		ListConstructExpr(construct, typ, loc):
			False
		ListAllocExpr(alloc, typ, loc):
			False
		ListHandoffExpr(handoff, typ, loc):
			False
		ListHandoffSetOwnedExpr(set, typ, loc):
			False
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			False
		ListRetainExpr(retain, typ, loc):
			False
		ListSetExpr(set, typ, loc):
			False
		ListSwapExpr(swap, typ, loc):
			False
		StringByteReadExpr(read, typ, loc):
			False
		StringByteWriteExpr(write, typ, loc):
			False
		StringByteCopyExpr(copy, typ, loc):
			False
		StringSetLenExpr(set_len, typ, loc):
			False
		TensorLiteralExpr(literal, typ, loc):
			False
		TensorBoxedLiteralExpr(literal, typ, loc):
			False
		TensorPackedLiteralExpr(literal, typ, loc):
			False
		TensorRawFillExpr(fill, typ, loc):
			False
		TensorRawReadExpr(read, typ, loc):
			False
		TensorRawWriteExpr(write, typ, loc):
			False
		TensorRawViewLetExpr(binding, body, typ, loc):
			False
		DictExpr(entries, typ, loc):
			False
		DictConstructExpr(construct, typ, loc):
			False
		SetAllocExpr(alloc, typ, loc):
			False
		RecordExpr(fields, typ, loc):
			False
		RecordConstructExpr(type_name, fields, typ, loc):
			False
		UnionConstructExpr(construct, typ, loc):
			False
		UnionReuseConstructExpr(construct, typ, loc):
			False
		PreClosureDetachExpr(detached, typ, loc):
			False
		DetachExpr(detached, typ, loc):
			False
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			False
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			False
		LetExpr(name, is_mutable, typ, rhs, body):
			False
		BorrowLetExpr(name, typ, rhs, body):
			False
		SeqExpr(first, second):
			False
		IfExpr(cond, then_expr, else_expr, typ, loc):
			False
		WhileExpr(cond, body, typ, loc):
			False
		ForRangeExpr(binder, start, end, body, typ, loc):
			False
		ForChannelExpr(loop, typ, loc):
			False
		ForListExpr(loop, typ, loc):
			False
		ForStringExpr(loop, typ, loc):
			False
		ForDictExpr(loop, typ, loc):
			False
		ForSetExpr(loop, typ, loc):
			False
		ForResourceSourceExpr(loop, typ, loc):
			False
		ForStreamExpr(loop, typ, loc):
			False
		ForTensorExpr(loop, typ, loc):
			False
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			False
		DetachExpr(detached, typ, loc):
			False
		ConcurrentlyLoopExpr(loop, typ, loc):
			False
		PreClosureConcurrentExpr(block, typ, loc):
			False
		ConcurrentExpr(block, typ, loc):
			False
		SelectExpr(select_expr, typ, loc):
			False
		BreakExpr(typ, loc):
			False
		ContinueExpr(typ, loc):
			False
		RangeExpr(start, end, typ, loc):
			False
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			False
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			False
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			False
		RawMatchExpr(scrutinee, cases, typ, loc):
			False
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			False
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, fallback, typ, loc):
			False
		ResourceScopeExpr(scope, typ, loc):
			False
		ResourceCleanupExitExpr(exit, typ, loc):
			False
		TailrecLoopExpr(params, return_type, body, loc):
			False
		TailrecRecurExpr(args, typ, loc):
			False
		TailrecListSpreadLoopExpr(loop, loc):
			False
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			False


private pure func prepared_tuple_literal(
	items: List[CoreExpr],
	item_types: List[CoreType],
) -> Option[PreparedTupleLiteral]:
	var elements: List[CoreTupleElement] = []
	var release_mask: Int = 0
	var retain_mask: Int = 0
	var failed: Bool = False
	var index: Int = 0

	for item in items:
		if not failed:
			match item_types.get(index):
				Some(item_type):
					match item_type:
						VoidType:
							elements = elements.append(TupleVoidElement)
						TypeParameterType(_) | SelfType:
							failed = True
							break
						NamedType(name, args):
							if is_primitive_tuple_slot_type(item_type):
								elements = elements.append(TuplePrimElement(item))
							else:
								match stack_option_tuple_slot_c_type(item_type):
									Some(c_type):
										elements = elements.append(TupleStructElement(item, c_type))
										release_mask += int_power_of_two(index)
									None:
										match float_tuple_element(item, item_type):
											Some(tuple_element):
												elements = elements.append(tuple_element)
											None:
												if is_pointer_tuple_slot_type(item_type):
													elements = elements.append(
														TuplePointerElement(item),
													)

													if tuple_slot_needs_release(item_type):
														release_mask += int_power_of_two(index)

														if tuple_pointer_expr_needs_retain(item):
															retain_mask += int_power_of_two(index)
												else:
													failed = True
													break
						TupleType(items):
							if is_pointer_tuple_slot_type(item_type):
								elements = elements.append(TuplePointerElement(item))

								if tuple_slot_needs_release(item_type):
									release_mask += int_power_of_two(index)

									if tuple_pointer_expr_needs_retain(item):
										retain_mask += int_power_of_two(index)
							else:
								failed = True
								break
						BoxedResultType(ok_type, err_type):
							elements = elements.append(TuplePointerElement(item))
							release_mask += int_power_of_two(index)

							if tuple_pointer_expr_needs_retain(item):
								retain_mask += int_power_of_two(index)
						FunctionType(_, _, _):
							elements = elements.append(TuplePointerElement(item))
							release_mask += int_power_of_two(index)

							if tuple_pointer_expr_needs_retain(item):
								retain_mask += int_power_of_two(index)
						TensorType(info):
							elements = elements.append(TuplePointerElement(item))
							release_mask += int_power_of_two(index)

							if tuple_pointer_expr_needs_retain(item):
								retain_mask += int_power_of_two(index)
						StackResultType(ok_type, err_type):
							failed = True
							break
						HeapRecordType(name):
							elements = elements.append(TuplePointerElement(item))
							release_mask += int_power_of_two(index)

							if tuple_pointer_expr_needs_retain(item):
								retain_mask += int_power_of_two(index)
						UnionType(name):
							elements = elements.append(TuplePointerElement(item))
							release_mask += int_power_of_two(index)

							if tuple_pointer_expr_needs_retain(item):
								retain_mask += int_power_of_two(index)
						EnumType(name):
							elements = elements.append(TuplePrimElement(item))
						ValueRecordType(name):
							elements = elements.append(TupleStructElement(item, name))
							release_mask += int_power_of_two(index)
						RangeType:
							elements = elements.append(TuplePrimElement(item))
				None:
					failed = True
					break

		index += 1

	if failed or index != item_types.length():
		None
	else:
		Some({
			elements = elements,
			release_mask = release_mask,
			retain_mask = retain_mask,
		})


private pure func prepare_tuple_expr(
	decls: List[CoreDecl],
	items: List[CoreExpr],
	typ: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	prepared_items: List[CoreExpr] = prepare_exprs(decls, items)

	match typ:
		TupleType(item_types):
			match prepared_tuple_literal(prepared_items, item_types):
				Some(prepared):
					TupleConstructExpr(
						{
							elements = prepared.elements,
							release_mask = prepared.release_mask,
							retain_mask = prepared.retain_mask
						},
						clone_core_type(typ),
						clone_core_source_loc(loc),
					)
				None:
					TupleExpr(prepared_items, clone_core_type(typ), clone_core_source_loc(loc))
		NamedType(name, args):
			TupleExpr(prepared_items, typ, loc)
		TypeParameterType(_) | SelfType:
			TupleExpr(prepared_items, typ, loc)
		StackResultType(ok_type, err_type):
			TupleExpr(prepared_items, typ, loc)
		BoxedResultType(ok_type, err_type):
			TupleExpr(prepared_items, typ, loc)
		FunctionType(_, _, _):
			TupleExpr(prepared_items, typ, loc)
		EnumType(name):
			TupleExpr(prepared_items, typ, loc)
		ValueRecordType(name):
			TupleExpr(prepared_items, typ, loc)
		HeapRecordType(name):
			TupleExpr(prepared_items, typ, loc)
		UnionType(name):
			TupleExpr(prepared_items, typ, loc)
		RangeType:
			TupleExpr(prepared_items, typ, loc)
		TensorType(info):
			TupleExpr(prepared_items, typ, loc)
		VoidType:
			TupleExpr(prepared_items, typ, loc)


private pure func vector_element_type(typ: CoreType) -> Option[CoreType]:
	match typ:
		TensorType(info):
			Some(info.element_type)
		NamedType(name, args):
			if name == "Vector" or name == "Tensor":
				match args:
					[elem_type]:
						Some(elem_type)
					[elem_type, ...dims]:
						Some(elem_type)
					[]:
						None
			else:
				None
		_:
			None


private pure func vector_literal_element_type(
	typ: CoreType,
	items: List[CoreExpr],
) -> Option[CoreType]:
	vector_element_type(typ)


private pure func static_tensor_dims(dims: List[CoreTensorDim]) -> Option[List[Int]]:
	var values: List[Int] = []
	var all_static: Bool = True

	for dim in dims:
		match dim:
			TensorStaticDim(value):
				values = values.append(value)
			TensorRuntimeDim(_) | TensorVariadicDim(_) | TensorDimOperation(_, _, _):
				all_static = False
				break

	if all_static:
		Some(values)
	else:
		None


private pure func tensor_static_shape_from_dims(dims: List[Int]) -> CoreTensorLiteralShape:
	match dims:
		[length]:
			TensorVectorLength(length)
		_:
			TensorStaticShape(dims)


private pure func vector_literal_shape(
	typ: CoreType,
	flattened_items: FlattenedVectorItems,
) -> CoreTensorLiteralShape:
	match typ:
		TensorType(info):
			match static_tensor_dims(info.dims):
				Some(dims):
					tensor_static_shape_from_dims(dims)
				None:
					flattened_items.shape
		_:
			flattened_items.shape


private pure func raw_scalar_kind_for_tensor_element_type(
	elem_type: CoreType,
) -> Option[CoreTensorRawScalarKind]:
	match elem_type:
		NamedType(name, args):
			if name == "Float" and args.length() == 0:
				Some(TensorFloat64Elements)
			else if name == "Float32" and args.length() == 0:
				Some(TensorFloat32Elements)
			else if name == "Int" and args.length() == 0:
				Some(TensorInt64Elements)
			else:
				None
		_:
			None


private pure func boxed_values_need_release(values: List[CoreBoxedStorageValue]) -> Bool:
	var result: Bool = False

	for value in values:
		if value.needs_release:
			result = True
			break

	result


private record TensorLiteralRow {
	elements: List[CoreExpr],
	length: Int
}


private record FlattenedVectorItems {
	elements: List[CoreExpr],
	shape: CoreTensorLiteralShape
}


private pure func int_product_from_first(first: Int, rest: List[Int]) -> Int:
	var total: Int = first

	for value in rest:
		total *= value

	total


private pure func tensor_literal_shape_total_length(shape: CoreTensorLiteralShape) -> Option[Int]:
	match shape:
		TensorVectorLength(length):
			Some(length)
		TensorStaticShape(dims):
			match dims:
				[]:
					Some(0)
				[first, ...rest]:
					Some(int_product_from_first(first, rest))


private pure func boxed_storage_value_exprs(values: List[CoreBoxedStorageValue]) -> List[CoreExpr]:
	var result: List[CoreExpr] = []

	for value in values:
		result = result.append(value.value)

	result


private pure func tensor_literal_row(expr: CoreExpr) -> Option[TensorLiteralRow]:
	match expr:
		TensorLiteralExpr(literal, typ, loc):
			length ?= tensor_literal_shape_total_length(literal.shape)

			match literal.payload:
				TensorRawLiteralPayload(raw):
					Some({
						elements = raw.elements,
						length = length,
					})
				TensorInlineStructLiteralPayload(inline_struct):
					Some({
						elements = inline_struct.elements,
						length = length,
					})
		TensorBoxedLiteralExpr(literal, typ, loc):
			length ?= tensor_literal_shape_total_length(literal.shape)

			Some({
				elements = boxed_storage_value_exprs(literal.elements),
				length = length,
			})
		TensorPackedLiteralExpr(literal, typ, loc):
			length ?= tensor_literal_shape_total_length(literal.shape)

			Some({
				elements = literal.elements,
				length = length,
			})
		_:
			None


private pure func append_exprs(target: List[CoreExpr], values: List[CoreExpr]) -> List[CoreExpr]:
	var result: List[CoreExpr] = target

	for value in values:
		result = result.append(value)

	result


private pure func flatten_vector_literal_items(items: List[CoreExpr]) -> FlattenedVectorItems:
	var flattened: List[CoreExpr] = []
	var expected_row_length: Option[Int] = None
	var is_ranked: Bool = items.length() > 0

	for item in items:
		if is_ranked:
			match tensor_literal_row(item):
				Some(row):
					match expected_row_length:
						Some(length):
							if length == row.length:
								flattened = append_exprs(flattened, row.elements)
							else:
								is_ranked = False
						None:
							expected_row_length = Some(row.length)
							flattened = append_exprs(flattened, row.elements)
				None:
					is_ranked = False

	if is_ranked:
		match expected_row_length:
			Some(row_length):
				{
					elements = flattened,
					shape = TensorStaticShape([items.length(), row_length])
				}
			None:
				{
					elements = items,
					shape = TensorVectorLength(items.length())
				}
	else:
		{
			elements = items,
			shape = TensorVectorLength(items.length())
		}


private pure func prepare_vector_expr(
	decls: List[CoreDecl],
	items: List[CoreExpr],
	typ: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	prepared_items: List[CoreExpr] = prepare_exprs(decls, items)
	flattened_items: FlattenedVectorItems = flatten_vector_literal_items(prepared_items)
	literal_shape: CoreTensorLiteralShape = vector_literal_shape(typ, flattened_items)

	match vector_literal_element_type(typ, flattened_items.elements):
		Some(elem_type):
			match raw_scalar_kind_for_tensor_element_type(elem_type):
				Some(raw_kind):
					TensorLiteralExpr(
						{
							shape = literal_shape,
							payload = TensorRawLiteralPayload({
								raw_kind = raw_kind,
								elements = flattened_items.elements,
							})
						},
						typ,
						loc,
					)
				None:
					match elem_type:
						NamedType(name, args):
							if name == "Bool" and args.length() == 0:
								TensorPackedLiteralExpr(
									{
										shape = literal_shape,
										elem_size = 1,
										elements = flattened_items.elements
									},
									typ,
									loc,
								)
							else:
								boxed_values: List[CoreBoxedStorageValue] = boxed_storage_values_for_exprs(
									flattened_items.elements,
								)
								TensorBoxedLiteralExpr(
									{
										shape = literal_shape,
										elements = boxed_values,
										elem_needs_release = boxed_values_need_release(boxed_values)
									},
									typ,
									loc,
								)
						ValueRecordType(name):
							TensorLiteralExpr(
								{
									shape = literal_shape,
									payload = TensorInlineStructLiteralPayload({
										struct_c_type = name,
										elements = flattened_items.elements,
									})
								},
								typ,
								loc,
							)
						_:
							boxed_values: List[CoreBoxedStorageValue] = boxed_storage_values_for_exprs(
								flattened_items.elements,
							)
							TensorBoxedLiteralExpr(
								{
									shape = literal_shape,
									elements = boxed_values,
									elem_needs_release = boxed_values_need_release(boxed_values)
								},
								typ,
								loc,
							)
		None:
			VectorExpr(prepared_items, typ, loc)


private record DictKeyValueTypes {
	key_type: CoreType,
	value_type: CoreType
}


private pure func dict_key_value_types(typ: CoreType) -> Option[DictKeyValueTypes]:
	match typ:
		NamedType(name, args):
			if name == "Dict":
				match args:
					[key_type, value_type]:
						Some({
							key_type = key_type,
							value_type = value_type,
						})
					_:
						None
			else:
				None
		_:
			None


private pure func generic_hash_container_type_name(name: String) -> Bool:
	match name:
		"Int":
			True
		"Int8":
			True
		"Int16":
			True
		"Int32":
			True
		"Int64":
			True
		"Int128":
			True
		"UInt8":
			True
		"UInt16":
			True
		"UInt32":
			True
		"UInt64":
			True
		"UInt128":
			True
		"Bool":
			True
		"Char":
			True
		"Option":
			True
		"Result":
			True
		"List":
			True
		"Dict":
			True
		"Set":
			True
		"Tensor":
			True
		"Vector":
			True
		"Matrix":
			True
		"Bytes":
			True
		"Tuple2":
			True
		"Tuple3":
			True
		"Tuple4":
			True
		"LiteralString":
			True
		"StringSlice":
			True
		_:
			False


private pure func enum_decl_name_matches(decl: CoreDecl, name: String) -> Bool:
	match decl:
		EnumDecl(enum_decl):
			enum_decl.name == name
		_:
			False


private pure func has_enum_decl(decls: List[CoreDecl], name: String) -> Bool:
	var result: Bool = False

	for decl in decls:
		if enum_decl_name_matches(decl, name):
			result = True
			break

	result


private pure func hash_container_constructor_for_key_type(
	decls: List[CoreDecl],
	key_type: CoreType,
) -> CoreHashContainerConstructor:
	match key_type:
		NamedType(name, args):
			if name == "String" and args.length() == 0:
				StringHashContainerConstructor
			else if (
				(name == "Float" or name == "Float32" or name == "Float16")
				and args.length() == 0
			):
				FloatHashContainerConstructor
			else if has_enum_decl(decls, name) or generic_hash_container_type_name(name):
				GenericHashContainerConstructor
			else:
				CustomHashContainerConstructor(
					"Hashable_hash_" + name,
					"Equatable_equals_" + name,
					pointer_box_storage_needs_release_type(key_type),
				)
		EnumType(name):
			GenericHashContainerConstructor
		ValueRecordType(name):
			CustomHashContainerConstructor(
				"Hashable_hash_" + name,
				"Equatable_equals_" + name,
				False,
			)
		_:
			GenericHashContainerConstructor


private pure func box_dict_literal_entry(entry: CoreDictLiteralEntry) -> CoreDictEntry:
	{
		key = boxed_storage_value_for_expr(entry.key),
		value = boxed_storage_value_for_expr(entry.value)
	}


private pure func box_dict_literal_entries(
	entries: List[CoreDictLiteralEntry],
) -> List[CoreDictEntry]:
	entries.map(box_dict_literal_entry)


private pure func lower_dict_literal_expr(
	decls: List[CoreDecl],
	entries: List[CoreDictLiteralEntry],
	typ: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	match dict_key_value_types(typ):
		Some(types):
			value_kind: CoreBoxKind = boxed_kind_for_type(types.value_type)
			DictConstructExpr(
				{
					constructor = hash_container_constructor_for_key_type(decls, types.key_type),
					entries = box_dict_literal_entries(entries),
					value_needs_release = boxed_storage_type_needs_release(
						types.value_type,
						value_kind,
					)
				},
				typ,
				loc,
			)
		None:
			DictExpr(entries, typ, loc)


private pure func prepare_dict_literal_entry(
	decls: List[CoreDecl],
	entry: CoreDictLiteralEntry,
) -> CoreDictLiteralEntry:
	{
		key = prepare_expr(decls, entry.key),
		value = prepare_expr(decls, entry.value)
	}


private pure func prepare_dict_expr(
	decls: List[CoreDecl],
	entries: List[CoreDictLiteralEntry],
	typ: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	prepared_entries: List[CoreDictLiteralEntry] = entries.map(
		func(entry): prepare_dict_literal_entry(decls, entry),
	)

	lower_dict_literal_expr(decls, prepared_entries, typ, loc)


private pure func prepare_record_fields(
	decls: List[CoreDecl],
	fields: List[CoreRecordFieldValue],
) -> List[CoreRecordFieldValue]:
	fields.map(func(field):
		{
			name = field.name,
			value = prepare_expr(decls, field.value)
		}
	)


private pure func prepare_record_expr(
	decls: List[CoreDecl],
	fields: List[CoreRecordFieldValue],
	typ: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	prepared_fields: List[CoreRecordFieldValue] = prepare_record_fields(decls, fields)

	match typ:
		ValueRecordType(name):
			match find_value_record_decl(decls, name):
				Some(record_decl):
					match order_value_record_fields(record_decl, prepared_fields):
						Some(ordered_fields):
							RecordConstructExpr(name, ordered_fields, typ, loc)
						None:
							RecordExpr(prepared_fields, typ, loc)
				None:
					RecordExpr(prepared_fields, typ, loc)
		NamedType(name, args):
			RecordExpr(prepared_fields, typ, loc)
		TypeParameterType(_) | SelfType:
			RecordExpr(prepared_fields, typ, loc)
		StackResultType(ok_type, err_type):
			RecordExpr(prepared_fields, typ, loc)
		BoxedResultType(ok_type, err_type):
			RecordExpr(prepared_fields, typ, loc)
		FunctionType(_, _, _):
			RecordExpr(prepared_fields, typ, loc)
		HeapRecordType(name):
			match find_heap_record_decl(decls, name):
				Some(record_decl):
					match order_heap_record_fields(record_decl, prepared_fields):
						Some(ordered_fields):
							RecordConstructExpr(name, ordered_fields, typ, loc)
						None:
							RecordExpr(prepared_fields, typ, loc)
				None:
					RecordExpr(prepared_fields, typ, loc)
		EnumType(name):
			RecordExpr(prepared_fields, typ, loc)
		UnionType(name):
			RecordExpr(prepared_fields, typ, loc)
		RangeType:
			RecordExpr(prepared_fields, typ, loc)
		TensorType(info):
			RecordExpr(prepared_fields, typ, loc)
		VoidType:
			RecordExpr(prepared_fields, typ, loc)
		TupleType(items):
			RecordExpr(prepared_fields, typ, loc)


private pure func prepare_record_construct_expr(
	decls: List[CoreDecl],
	type_name: String,
	fields: List[CoreRecordFieldValue],
	typ: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	prepared_fields: List[CoreRecordFieldValue] = prepare_record_fields(decls, fields)

	match typ:
		ValueRecordType(name):
			match find_value_record_decl(decls, name):
				Some(record_decl):
					match order_value_record_fields(record_decl, prepared_fields):
						Some(ordered_fields):
							RecordConstructExpr(type_name, ordered_fields, typ, loc)
						None:
							RecordConstructExpr(type_name, prepared_fields, typ, loc)
				None:
					RecordConstructExpr(type_name, prepared_fields, typ, loc)
		HeapRecordType(name):
			match find_heap_record_decl(decls, name):
				Some(record_decl):
					match order_heap_record_fields(record_decl, prepared_fields):
						Some(ordered_fields):
							RecordConstructExpr(type_name, ordered_fields, typ, loc)
						None:
							RecordConstructExpr(type_name, prepared_fields, typ, loc)
				None:
					RecordConstructExpr(type_name, prepared_fields, typ, loc)
		NamedType(name, args):
			RecordConstructExpr(type_name, prepared_fields, typ, loc)
		TypeParameterType(_) | SelfType:
			RecordConstructExpr(type_name, prepared_fields, typ, loc)
		StackResultType(ok_type, err_type):
			RecordConstructExpr(type_name, prepared_fields, typ, loc)
		BoxedResultType(ok_type, err_type):
			RecordConstructExpr(type_name, prepared_fields, typ, loc)
		FunctionType(_, _, _):
			RecordConstructExpr(type_name, prepared_fields, typ, loc)
		EnumType(name):
			RecordConstructExpr(type_name, prepared_fields, typ, loc)
		UnionType(name):
			RecordConstructExpr(type_name, prepared_fields, typ, loc)
		RangeType:
			RecordConstructExpr(type_name, prepared_fields, typ, loc)
		TensorType(info):
			RecordConstructExpr(type_name, prepared_fields, typ, loc)
		VoidType:
			RecordConstructExpr(type_name, prepared_fields, typ, loc)
		TupleType(items):
			RecordConstructExpr(type_name, prepared_fields, typ, loc)


private pure func stack_option_c_type(payload: CoreType) -> Option[String]:
	match payload:
		VoidType:
			Some("blorp_StackOption_Void")
		NamedType(name, args):
			match args:
				[]:
					if name == "Int":
						Some("blorp_StackOption_Int")
					else if name == "Int8":
						Some("blorp_StackOption_Int8")
					else if name == "Int16":
						Some("blorp_StackOption_Int16")
					else if name == "Int32":
						Some("blorp_StackOption_Int32")
					else if name == "Int64":
						Some("blorp_StackOption_Int64")
					else if name == "UInt8":
						Some("blorp_StackOption_UInt8")
					else if name == "UInt16":
						Some("blorp_StackOption_UInt16")
					else if name == "UInt32":
						Some("blorp_StackOption_UInt32")
					else if name == "UInt64":
						Some("blorp_StackOption_UInt64")
					else if name == "Float":
						Some("blorp_StackOption_Float")
					else if name == "Float32":
						Some("blorp_StackOption_Float32")
					else if name == "Float16":
						Some("blorp_StackOption_Float16")
					else if name == "Bool":
						Some("blorp_StackOption_Bool")
					else if name == "Char":
						Some("blorp_StackOption_Char")
					else if name == "Int128":
						Some("blorp_StackOption_Int128")
					else if name == "UInt128":
						Some("blorp_StackOption_UInt128")
					else:
						None
				[first, ...rest]:
					None
		TypeParameterType(_) | SelfType:
			None
		EnumType(name):
			Some("blorp_StackOption_" + name)
		ValueRecordType(name):
			if name == "Range":
				Some("blorp_StackOption_RangeValue")
			else:
				Some("blorp_StackOption_" + name)
		HeapRecordType(name):
			None
		UnionType(name):
			None
		StackResultType(ok_type, err_type):
			None
		FunctionType(_, _, _):
			None
		BoxedResultType(ok_type, err_type):
			None
		RangeType:
			Some("blorp_StackOption_Range")
		TensorType(info):
			None
		TupleType(items):
			None


private pure func stack_option_none_value(payload: CoreType) -> String:
	match payload:
		NamedType(name, args):
			match args:
				[]:
					if name == "Int":
						"0L"
					else:
						"0"
				[first, ...rest]:
					"0"
		TypeParameterType(_) | SelfType:
			"0"
		VoidType:
			"0"
		EnumType(name):
			"0"
		ValueRecordType(name):
			"{0}"
		HeapRecordType(name):
			"0"
		UnionType(name):
			"0"
		StackResultType(ok_type, err_type):
			"{0}"
		BoxedResultType(ok_type, err_type):
			"0"
		FunctionType(_, _, _):
			"0"
		RangeType:
			"0"
		TensorType(info):
			"0"
		TupleType(items):
			"0"


private pure func stack_option_representation(
	payload: CoreType,
	tag: Int,
) -> Option[CoreStackOptionRepresentation]:
	match stack_option_c_type(payload):
		Some(option_type):
			Some({
				option_type = option_type,
				tag = tag,
				none_value = stack_option_none_value(payload),
			})
		None:
			None


private pure func constructor_c_name(name: String, def_id: Option[Int]) -> String:
	match def_id:
		Some(id):
			"__def_" + id.to_string() + "_" + name
		None:
			name


private pure func prepare_stack_option_construct(
	kind: CoreCallKind,
	args: List[CoreExpr],
	payload: CoreType,
) -> Option[CoreUnionConstruct]:
	match kind:
		UserCall(constructor_name, def_id, consumed_args):
			if constructor_name == "Some" and args.length() == 1:
				match stack_option_representation(payload, STACK_OPTION_SOME_TAG):
					Some(representation):
						Some({
							type_name = "Option",
							constructor_name = "Some",
							constructor_c_name = "Some",
							representation = StackOptionRepresentation(representation),
							payload_storage = TypedUnionPayloadStorage,
							uses_release_mask = False,
							release_mask = 0,
							args = boxed_storage_values_for_exprs(args),
						})
					None:
						if is_nullable_option_payload_type(payload):
							Some({
								type_name = "Option",
								constructor_name = "Some",
								constructor_c_name = "Some",
								representation = NullableOptionRepresentation,
								payload_storage = TypedUnionPayloadStorage,
								uses_release_mask = False,
								release_mask = 0,
								args = boxed_storage_values_for_exprs(args),
							})
						else:
							boxed_args: List[CoreBoxedStorageValue] = boxed_storage_values_for_exprs(
								args,
							)

							Some({
								type_name = "Option",
								constructor_name = "Some",
								constructor_c_name = constructor_c_name(constructor_name, def_id),
								representation = BoxedOptionRepresentation,
								payload_storage = ErasedUnionPayloadStorage,
								uses_release_mask = True,
								release_mask = release_mask_for_boxed_args(boxed_args),
								args = boxed_args,
							})
			else if constructor_name == "None" and args.length() == 0:
				match stack_option_representation(payload, STACK_OPTION_NONE_TAG):
					Some(representation):
						Some({
							type_name = "Option",
							constructor_name = "None",
							constructor_c_name = "None",
							representation = StackOptionRepresentation(representation),
							payload_storage = TypedUnionPayloadStorage,
							uses_release_mask = False,
							release_mask = 0,
							args = [],
						})
					None:
						if is_nullable_option_payload_type(payload):
							Some({
								type_name = "Option",
								constructor_name = "None",
								constructor_c_name = "None",
								representation = NullableOptionRepresentation,
								payload_storage = TypedUnionPayloadStorage,
								uses_release_mask = False,
								release_mask = 0,
								args = [],
							})
						else:
							Some({
								type_name = "Option",
								constructor_name = "None",
								constructor_c_name = constructor_c_name(constructor_name, def_id),
								representation = BoxedOptionRepresentation,
								payload_storage = TypedUnionPayloadStorage,
								uses_release_mask = False,
								release_mask = 0,
								args = [],
							})
			else:
				None
		BuiltinCall(name):
			if name == "blorp_option_some":
				prepare_stack_option_construct(
					UserCall("Some", None, []),
					args,
					payload,
				)
			else if name == "blorp_option_none":
				prepare_stack_option_construct(
					UserCall("None", None, []),
					args,
					payload,
				)
			else:
				None
		ForeignCall(name, arg_passing):
			None
		DirectRuntimeCall(call):
			None
		TensorParallelCall(name, layout):
			None
		DictWithCapacityCall(constructor):
			None
		IntrinsicCall(name):
			None
		OperationResultCall(bridge):
			None
		FallibleStreamTerminalCall(bridge):
			None
		ListToStringCall(callback_name):
			None
		ClosureCall:
			None
		UnknownCall:
			None
		DeferredTraitCall(trait_name, method_name):
			None
		SelectedTraitCall(trait_name, method_name, module_path, def_id):
			None
		SelectedDirectCall(def_id):
			None


private pure func stack_result_tag(constructor_name: String) -> Option[Int]:
	match constructor_name:
		"Ok":
			Some(STACK_RESULT_OK_TAG)
		"Err":
			Some(STACK_RESULT_ERR_TAG)
		_:
			None


private pure func result_type_payloads(typ: CoreType) -> Option[(CoreType, CoreType)]:
	match typ:
		NamedType(name, args):
			if name == "Result":
				match args:
					[ok_type, err_type]:
						Some((ok_type, err_type))
					_:
						None
			else:
				None
		StackResultType(ok_type, err_type):
			Some((ok_type, err_type))
		BoxedResultType(ok_type, err_type):
			Some((ok_type, err_type))
		_:
			None


private pure func stack_result_payload_type(
	constructor_name: String,
	typ: CoreType,
) -> Option[CoreType]:
	payloads ?= result_type_payloads(typ)

	match constructor_name:
		"Ok":
			Some(payloads[0])
		"Err":
			Some(payloads[1])
		_:
			None


private pure func stack_result_payload_has_erased_storage(payload: CoreType) -> Bool:
	match payload:
		TypeParameterType(_) | SelfType:
			True
		NamedType(name, args):
			True
		ValueRecordType(name):
			True
		TupleType(items):
			True
		VoidType:
			True
		EnumType(name):
			True
		HeapRecordType(name):
			True
		UnionType(name):
			True
		RangeType:
			True
		TensorType(info):
			True
		StackResultType(ok_type, err_type):
			True
		BoxedResultType(ok_type, err_type):
			True
		FunctionType(_, _, _):
			True


private pure func prepare_stack_result_construct(
	kind: CoreCallKind,
	args: List[CoreExpr],
	typ: CoreType,
) -> Option[CoreUnionConstruct]:
	match kind:
		UserCall(constructor_name, def_id, consumed_args):
			tag ?= stack_result_tag(constructor_name)
			payload_type ?= stack_result_payload_type(constructor_name, typ)

			if args.length() == 1 and stack_result_payload_has_erased_storage(payload_type):
				boxed_args: List[CoreBoxedStorageValue] = boxed_storage_values_for_exprs(args)

				release_mask: Int = match boxed_args:
					[payload]:
						if payload.needs_release:
							1
						else:
							0
					_:
						0

				Some({
					type_name = "Result",
					constructor_name = constructor_name,
					constructor_c_name = constructor_name,
					representation = StackResultRepresentation({
						result_type = "blorp_StackResult",
						tag = tag,
						release_mask = release_mask,
					}),
					payload_storage = TypedUnionPayloadStorage,
					uses_release_mask = False,
					release_mask = release_mask,
					args = boxed_args,
				})
			else:
				None
		BuiltinCall(name):
			if name == "blorp_result_ok":
				prepare_stack_result_construct(
					UserCall("Ok", None, []),
					args,
					typ,
				)
			else if name == "blorp_result_err":
				prepare_stack_result_construct(
					UserCall("Err", None, []),
					args,
					typ,
				)
			else:
				None
		ForeignCall(name, arg_passing):
			None
		DirectRuntimeCall(call):
			None
		TensorParallelCall(name, layout):
			None
		DictWithCapacityCall(constructor):
			None
		IntrinsicCall(name):
			None
		OperationResultCall(bridge):
			None
		FallibleStreamTerminalCall(bridge):
			None
		ListToStringCall(callback_name):
			None
		ClosureCall:
			None
		UnknownCall:
			None
		DeferredTraitCall(trait_name, method_name):
			None
		SelectedTraitCall(trait_name, method_name, module_path, def_id):
			None
		SelectedDirectCall(def_id):
			None


private pure func boxed_result_constructor_c_name(constructor_name: String) -> Option[String]:
	match constructor_name:
		"Ok":
			Some("blorp_result_ok")
		"Err":
			Some("blorp_result_err")
		_:
			None


private pure func prepare_boxed_result_construct(
	kind: CoreCallKind,
	args: List[CoreExpr],
) -> Option[CoreUnionConstruct]:
	match kind:
		UserCall(constructor_name, def_id, consumed_args):
			constructor_c_name ?= boxed_result_constructor_c_name(constructor_name)

			if args.length() == 1:
				boxed_args: List[CoreBoxedStorageValue] = boxed_storage_values_for_exprs(args)

				Some({
					type_name = "Result",
					constructor_name = constructor_name,
					constructor_c_name = constructor_c_name,
					representation = GenericUnionRepresentation,
					payload_storage = ErasedUnionPayloadStorage,
					uses_release_mask = False,
					release_mask = release_mask_for_boxed_args(boxed_args),
					args = boxed_args,
				})
			else:
				None
		BuiltinCall(name):
			if name == "blorp_result_ok":
				prepare_boxed_result_construct(
					UserCall("Ok", None, []),
					args,
				)
			else if name == "blorp_result_err":
				prepare_boxed_result_construct(
					UserCall("Err", None, []),
					args,
				)
			else:
				None
		ForeignCall(name, arg_passing):
			None
		DirectRuntimeCall(call):
			None
		TensorParallelCall(name, layout):
			None
		DictWithCapacityCall(constructor):
			None
		IntrinsicCall(name):
			None
		OperationResultCall(bridge):
			None
		FallibleStreamTerminalCall(bridge):
			None
		ListToStringCall(callback_name):
			None
		ClosureCall:
			None
		UnknownCall:
			None
		DeferredTraitCall(trait_name, method_name):
			None
		SelectedTraitCall(trait_name, method_name, module_path, def_id):
			None
		SelectedDirectCall(def_id):
			None


private pure func prepare_union_construct(
	decls: List[CoreDecl],
	kind: CoreCallKind,
	args: List[CoreExpr],
	typ: CoreType,
) -> Option[CoreUnionConstruct]:
	match typ:
		UnionType(type_name):
			match kind:
				UserCall(constructor_name, def_id, consumed_args):
					match find_union_decl(decls, type_name):
						Some(union_decl):
							match find_union_variant(union_decl, constructor_name):
								Some(variant):
									if variant.fields.length() == args.length():
										boxed_args: List[CoreBoxedStorageValue] = boxed_storage_values_for_exprs(
											args,
										)
										uses_release_mask: Bool = union_variant_uses_release_mask(
											union_decl.payload_storage,
											variant,
										)

										release_mask: Int = if uses_release_mask:
											release_mask_for_boxed_args(boxed_args)
										else:
											0

										Some({
											type_name = type_name,
											constructor_name = constructor_name,
											constructor_c_name = variant.c_name,
											representation = GenericUnionRepresentation,
											payload_storage = union_decl.payload_storage,
											uses_release_mask = uses_release_mask,
											release_mask = release_mask,
											args = boxed_args,
										})
									else:
										None
								None:
									None
						None:
							None
				ForeignCall(name, arg_passing):
					None
				BuiltinCall(name):
					None
				DirectRuntimeCall(call):
					None
				TensorParallelCall(name, layout):
					None
				DictWithCapacityCall(constructor):
					None
				IntrinsicCall(name):
					None
				OperationResultCall(bridge):
					None
				FallibleStreamTerminalCall(bridge):
					None
				ListToStringCall(callback_name):
					None
				ClosureCall:
					None
				UnknownCall:
					None
				DeferredTraitCall(trait_name, method_name):
					None
				SelectedTraitCall(trait_name, method_name, module_path, def_id):
					None
				SelectedDirectCall(def_id):
					None
		NamedType(name, type_args):
			if name == "Option":
				match type_args:
					[payload]:
						prepare_stack_option_construct(kind, args, payload)
					[]:
						None
					[first, second, ...rest]:
						None
			else if name == "Result":
				match type_args:
					[ok_type, err_type]:
						prepare_stack_result_construct(kind, args, typ)
					[]:
						None
					[only]:
						None
					[first, second, third, ...rest]:
						None
			else:
				None
		TypeParameterType(_) | SelfType:
			None
		StackResultType(ok_type, err_type):
			prepare_stack_result_construct(kind, args, typ)
		BoxedResultType(ok_type, err_type):
			prepare_boxed_result_construct(kind, args)
		FunctionType(_, _, _):
			None
		EnumType(name):
			None
		ValueRecordType(name):
			None
		HeapRecordType(name):
			None
		RangeType:
			None
		TensorType(info):
			None
		TupleType(items):
			None
		VoidType:
			None


private pure func prepare_literal_match_cases(
	decls: List[CoreDecl],
	cases: List[CoreLiteralMatchCase],
) -> List[CoreLiteralMatchCase]:
	cases.map(func(match_case):
		{
			literal = match_case.literal,
			bindings = match_case.bindings,
			body = prepare_expr(decls, match_case.body)
		}
	)


private pure func prepare_literal_match_fallback(
	decls: List[CoreDecl],
	fallback: CoreLiteralMatchFallback,
) -> CoreLiteralMatchFallback:
	match fallback:
		LiteralMatchFallbackBody(body):
			LiteralMatchFallbackBody(prepare_expr(decls, body))
		LiteralMatchFallbackBindings(bindings, body):
			LiteralMatchFallbackBindings(
				bindings,
				prepare_expr(decls, body),
			)
		LiteralMatchFallbackFail:
			LiteralMatchFallbackFail


private pure func prepare_constructor_literal_match(
	decls: List[CoreDecl],
	match_expr: CoreConstructorLiteralMatch,
) -> CoreConstructorLiteralMatch:
	{
		accessor = match_expr.accessor,
		scrutinee_type = match_expr.scrutinee_type,
		cases = prepare_literal_match_cases(decls, match_expr.cases),
		fallback = prepare_literal_match_fallback(decls, match_expr.fallback),
		result_type = match_expr.result_type,
		loc = match_expr.loc
	}


private pure func prepare_constructor_length_match_branch(
	decls: List[CoreDecl],
	branch: CoreConstructorLengthMatchBranch,
) -> CoreConstructorLengthMatchBranch:
	{
		bindings = branch.bindings,
		body = prepare_constructor_match_body(decls, branch.body)
	}


private pure func prepare_constructor_length_match_cases(
	decls: List[CoreDecl],
	cases: List[CoreConstructorLengthMatchCase],
) -> List[CoreConstructorLengthMatchCase]:
	cases.map(func(match_case):
		{
			length = match_case.length,
			branch = prepare_constructor_length_match_branch(decls, match_case.branch)
		}
	)


private pure func prepare_constructor_length_match_geq(
	decls: List[CoreDecl],
	geq_case: Option[CoreConstructorLengthMatchGeq],
) -> Option[CoreConstructorLengthMatchGeq]:
	match geq_case:
		Some(existing_case):
			Some({
				minimum_length = existing_case.minimum_length,
				branch = prepare_constructor_length_match_branch(decls, existing_case.branch),
			})
		None:
			None


private pure func prepare_constructor_length_match_fallback(
	decls: List[CoreDecl],
	fallback: Option[CoreConstructorLengthMatchBranch],
) -> Option[CoreConstructorLengthMatchBranch]:
	match fallback:
		Some(branch):
			Some(prepare_constructor_length_match_branch(decls, branch))
		None:
			None


private pure func prepare_constructor_length_match(
	decls: List[CoreDecl],
	match_expr: CoreConstructorLengthMatch,
) -> CoreConstructorLengthMatch:
	{
		accessor = match_expr.accessor,
		cases = prepare_constructor_length_match_cases(decls, match_expr.cases),
		geq = prepare_constructor_length_match_geq(decls, match_expr.geq),
		fallback = prepare_constructor_length_match_fallback(decls, match_expr.fallback),
		result_type = match_expr.result_type,
		loc = match_expr.loc
	}


private pure func prepare_constructor_match_body(
	decls: List[CoreDecl],
	body: CoreConstructorMatchBody,
) -> CoreConstructorMatchBody:
	match body:
		ConstructorMatchBodyExpr(expr):
			ConstructorMatchBodyExpr(prepare_expr(decls, expr))
		ConstructorMatchBodyLiteral(match_expr):
			ConstructorMatchBodyLiteral(prepare_constructor_literal_match(decls, match_expr))
		ConstructorMatchBodyLength(match_expr):
			ConstructorMatchBodyLength(prepare_constructor_length_match(decls, match_expr))


private pure func prepare_constructor_match_cases(
	decls: List[CoreDecl],
	cases: List[CoreConstructorMatchCase],
) -> List[CoreConstructorMatchCase]:
	cases.map(func(match_case):
		{
			constructor = match_case.constructor,
			accessor = match_case.accessor,
			test = match_case.test,
			bindings = match_case.bindings,
			body = prepare_constructor_match_body(decls, match_case.body)
		}
	)


private pure func prepare_constructor_match_fallback(
	decls: List[CoreDecl],
	fallback: CoreConstructorMatchFallback,
) -> CoreConstructorMatchFallback:
	match fallback:
		ConstructorMatchFallbackBody(body):
			ConstructorMatchFallbackBody(prepare_expr(decls, body))
		ConstructorMatchFallbackBindings(bindings, body):
			ConstructorMatchFallbackBindings(
				bindings,
				prepare_expr(decls, body),
			)
		ConstructorMatchFallbackFail:
			ConstructorMatchFallbackFail


private pure func clone_core_var_expr(
	variable: CoreVar,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	VarExpr(clone_core_var(variable), clone_core_type(typ), clone_core_source_loc(loc))


private pure func prepare_expr(decls: List[CoreDecl], expr: CoreExpr) -> CoreExpr:
	match expr:
		LiteralExpr(literal, typ, loc):
			LiteralExpr(
				clone_core_literal(literal),
				clone_core_type(typ),
				clone_core_source_loc(loc),
			)
		VarExpr(variable, typ, loc):
			match typ:
				NamedType(name, type_args):
					if name == "Option":
						match type_args:
							[payload]:
								if variable.name == "None":
									match prepare_stack_option_construct(
										UserCall("None", None, []),
										[],
										payload,
									):
										Some(construct):
											UnionConstructExpr(
												construct,
												clone_core_type(typ),
												clone_core_source_loc(loc),
											)
										None:
											clone_core_var_expr(variable, typ, loc)
								else:
									clone_core_var_expr(variable, typ, loc)
							[]:
								clone_core_var_expr(variable, typ, loc)
							[first, second, ...rest]:
								clone_core_var_expr(variable, typ, loc)
					else:
						clone_core_var_expr(variable, typ, loc)
				_:
					clone_core_var_expr(variable, typ, loc)
		VoidExpr(typ, loc):
			VoidExpr(clone_core_type(typ), clone_core_source_loc(loc))
		DebugBlockExpr(body, typ, loc):
			DebugBlockExpr(
				prepare_expr(decls, body),
				clone_core_type(typ),
				clone_core_source_loc(loc),
			)
		CooperativeCheckpointExpr(typ, loc):
			CooperativeCheckpointExpr(clone_core_type(typ), clone_core_source_loc(loc))
		CallExpr(kind, callee, args, typ, loc):
			prepared_callee: CoreExpr = prepare_expr(decls, callee)
			prepared_args: List[CoreExpr] = prepare_exprs(decls, args)

			match prepare_union_construct(decls, kind, prepared_args, typ):
				Some(construct):
					UnionConstructExpr(construct, clone_core_type(typ), clone_core_source_loc(loc))
				None:
					CallExpr(kind, prepared_callee, prepared_args, typ, loc)
		BinaryExpr(op, left, right, typ, loc):
			BinaryExpr(
				op,
				prepare_expr(decls, left),
				prepare_expr(decls, right),
				typ,
				loc,
			)
		UnaryExpr(op, expr_value, typ, loc):
			UnaryExpr(
				op,
				prepare_expr(decls, expr_value),
				typ,
				loc,
			)
		LogicalExpr(op, left, right, typ, loc):
			LogicalExpr(
				op,
				prepare_expr(decls, left),
				prepare_expr(decls, right),
				typ,
				loc,
			)
		AssignExpr(variable, rhs, typ, loc):
			AssignExpr(
				variable,
				prepare_expr(decls, rhs),
				typ,
				loc,
			)
		CastExpr(expr_value, typ, loc):
			CastExpr(
				prepare_expr(decls, expr_value),
				typ,
				loc,
			)
		BoxExpr(box, typ, loc):
			BoxExpr(
				prepare_box_op(decls, box),
				typ,
				loc,
			)
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			UnboxExpr(
				unbox_kind,
				prepare_expr(decls, expr_value),
				typ,
				loc,
			)
		FieldExpr(expr_value, field_name, typ, loc):
			FieldExpr(
				prepare_expr(decls, expr_value),
				field_name,
				typ,
				loc,
			)
		TupleFieldExpr(expr_value, field_index, typ, loc):
			TupleFieldExpr(
				prepare_expr(decls, expr_value),
				field_index,
				typ,
				loc,
			)
		TupleExpr(items, typ, loc):
			prepare_tuple_expr(decls, items, typ, loc)
		TupleConstructExpr(tuple_construct, typ, loc):
			TupleConstructExpr(
				{
					elements = prepare_tuple_elements(decls, tuple_construct.elements),
					release_mask = tuple_construct.release_mask,
					retain_mask = tuple_construct.retain_mask
				},
				typ,
				loc,
			)
		VectorExpr(items, typ, loc):
			prepare_vector_expr(decls, items, typ, loc)
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			LambdaExpr(
				lambda_params,
				lambda_return_type,
				prepare_expr(decls, lambda_body),
				lambda_is_pure,
				typ,
				loc,
			)
		ClosureCreateExpr(closure, typ, loc):
			ClosureCreateExpr(closure, typ, loc)
		ListConstructExpr(construct, typ, loc):
			ListConstructExpr(
				prepare_list_construct(decls, construct),
				typ,
				loc,
			)
		ListAllocExpr(alloc, typ, loc):
			ListAllocExpr(
				prepare_list_alloc(decls, alloc),
				typ,
				loc,
			)
		ListGetExpr(get, typ, loc):
			ListGetExpr(
				prepare_list_get(decls, get),
				typ,
				loc,
			)
		ListHandoffExpr(handoff, typ, loc):
			ListHandoffExpr(
				prepare_list_handoff(decls, handoff),
				typ,
				loc,
			)
		ListHandoffSetOwnedExpr(set, typ, loc):
			ListHandoffSetOwnedExpr(
				prepare_list_set(decls, set),
				typ,
				loc,
			)
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			ListHandoffSetSourceSlotExpr(
				prepare_list_handoff_set_source_slot(decls, slot),
				typ,
				loc,
			)
		StringByteReadExpr(read, typ, loc):
			StringByteReadExpr(
				prepare_string_byte_read(decls, read),
				typ,
				loc,
			)
		StringByteWriteExpr(write, typ, loc):
			StringByteWriteExpr(
				prepare_string_byte_write(decls, write),
				typ,
				loc,
			)
		StringByteCopyExpr(copy, typ, loc):
			StringByteCopyExpr(
				prepare_string_byte_copy(decls, copy),
				typ,
				loc,
			)
		StringSetLenExpr(set_len, typ, loc):
			StringSetLenExpr(
				prepare_string_set_len(decls, set_len),
				typ,
				loc,
			)
		TensorLiteralExpr(literal, typ, loc):
			TensorLiteralExpr(
				prepare_tensor_literal(decls, literal),
				typ,
				loc,
			)
		TensorBoxedLiteralExpr(literal, typ, loc):
			TensorBoxedLiteralExpr(
				prepare_tensor_boxed_literal(decls, literal),
				typ,
				loc,
			)
		TensorPackedLiteralExpr(literal, typ, loc):
			TensorPackedLiteralExpr(
				prepare_tensor_packed_literal(decls, literal),
				typ,
				loc,
			)
		TensorRawFillExpr(fill, typ, loc):
			TensorRawFillExpr(
				prepare_tensor_raw_fill(decls, fill),
				typ,
				loc,
			)
		TensorRawReadExpr(read, typ, loc):
			TensorRawReadExpr(
				prepare_tensor_raw_read(decls, read),
				typ,
				loc,
			)
		TensorRawWriteExpr(write, typ, loc):
			TensorRawWriteExpr(
				prepare_tensor_raw_write(decls, write),
				typ,
				loc,
			)
		TensorRawViewLetExpr(binding, body, typ, loc):
			TensorRawViewLetExpr(
				prepare_tensor_raw_view_binding(decls, binding),
				prepare_expr(decls, body),
				typ,
				loc,
			)
		DictExpr(entries, typ, loc):
			prepare_dict_expr(decls, entries, typ, loc)
		DictConstructExpr(construct, typ, loc):
			DictConstructExpr(
				prepare_dict_construct(decls, construct),
				typ,
				loc,
			)
		SetAllocExpr(alloc, typ, loc):
			expr
		ListRetainExpr(retain, typ, loc):
			ListRetainExpr(
				prepare_list_retain(decls, retain),
				typ,
				loc,
			)
		ListSetExpr(set, typ, loc):
			ListSetExpr(
				prepare_list_set(decls, set),
				typ,
				loc,
			)
		ListSwapExpr(swap, typ, loc):
			ListSwapExpr(
				prepare_list_swap(decls, swap),
				typ,
				loc,
			)
		RecordExpr(fields, typ, loc):
			prepare_record_expr(decls, fields, typ, loc)
		RecordConstructExpr(type_name, fields, typ, loc):
			prepare_record_construct_expr(decls, type_name, fields, typ, loc)
		UnionConstructExpr(construct, typ, loc):
			UnionConstructExpr(
				{
					type_name = construct.type_name,
					constructor_name = construct.constructor_name,
					constructor_c_name = construct.constructor_c_name,
					representation = construct.representation,
					payload_storage = construct.payload_storage,
					uses_release_mask = construct.uses_release_mask,
					release_mask = construct.release_mask,
					args = prepare_boxed_storage_values(decls, construct.args)
				},
				typ,
				loc,
			)
		UnionReuseConstructExpr(construct, typ, loc):
			UnionReuseConstructExpr(
				{
					source = prepare_expr(decls, construct.source),
					type_name = construct.type_name,
					constructor_name = construct.constructor_name,
					constructor_c_name = construct.constructor_c_name,
					reuse_constructor_c_name = construct.reuse_constructor_c_name,
					representation = construct.representation,
					payload_storage = construct.payload_storage,
					uses_release_mask = construct.uses_release_mask,
					release_mask = construct.release_mask,
					args = prepare_boxed_storage_values(decls, construct.args)
				},
				typ,
				loc,
			)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			DupExpr(
				variable,
				value_type,
				retain_policy,
				prepare_expr(decls, body),
				typ,
				loc,
			)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			DropExpr(
				variable,
				value_type,
				release_policy,
				prepare_expr(decls, body),
				typ,
				loc,
			)
		LetExpr(name, is_mutable, typ, rhs, body):
			LetExpr(
				name,
				is_mutable,
				typ,
				prepare_expr(decls, rhs),
				prepare_expr(decls, body),
			)
		BorrowLetExpr(name, typ, rhs, body):
			BorrowLetExpr(
				name,
				typ,
				prepare_expr(decls, rhs),
				prepare_expr(decls, body),
			)
		SeqExpr(first, second):
			SeqExpr(
				prepare_expr(decls, first),
				prepare_expr(decls, second),
			)
		WhileExpr(cond, body, typ, loc):
			WhileExpr(
				prepare_expr(decls, cond),
				prepare_expr(decls, body),
				typ,
				loc,
			)
		BreakExpr(typ, loc):
			BreakExpr(clone_core_type(typ), clone_core_source_loc(loc))
		ContinueExpr(typ, loc):
			ContinueExpr(clone_core_type(typ), clone_core_source_loc(loc))
		ResourceScopeExpr(scope, typ, loc):
			ResourceScopeExpr(
				{
					variable = scope.variable,
					typ = scope.typ,
					acquire = prepare_expr(decls, scope.acquire),
					body = prepare_expr(decls, scope.body),
					cleanup = prepare_expr(decls, scope.cleanup)
				},
				typ,
				loc,
			)
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			ResourceCleanupExitExpr(
				{
					cleanups = prepare_exprs(decls, cleanup_exit.cleanups),
					exit = cleanup_exit.exit
				},
				typ,
				loc,
			)
		TailrecLoopExpr(params, return_type, body, loc):
			TailrecLoopExpr(
				params,
				return_type,
				prepare_expr(decls, body),
				loc,
			)
		TailrecRecurExpr(args, typ, loc):
			TailrecRecurExpr(
				prepare_exprs(decls, args),
				typ,
				loc,
			)
		TailrecListSpreadLoopExpr(loop, loc):
			TailrecListSpreadLoopExpr(
				prepare_tailrec_list_spread_loop(decls, loop),
				loc,
			)
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			TailrecListSpreadRecurExpr(
				prepare_tailrec_list_spread_rebinds(decls, rebinds),
				cursor_advance,
				typ,
				loc,
			)
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			ForRangeExpr(
				binder,
				prepare_expr(decls, start),
				prepare_expr(decls, end_value),
				prepare_expr(decls, body),
				typ,
				loc,
			)
		ForChannelExpr(for_channel, typ, loc):
			ForChannelExpr(
				{
					binder = for_channel.binder,
					iterable = prepare_expr(decls, for_channel.iterable),
					body = prepare_expr(decls, for_channel.body)
				},
				typ,
				loc,
			)
		ForListExpr(for_list, typ, loc):
			ForListExpr(
				{
					binder = for_list.binder,
					layout = for_list.layout,
					iterable = prepare_expr(decls, for_list.iterable),
					iterable_release_policy = for_list.iterable_release_policy,
					body = prepare_expr(decls, for_list.body)
				},
				typ,
				loc,
			)
		ForStringExpr(for_string, typ, loc):
			ForStringExpr(
				{
					binder = for_string.binder,
					iterable = prepare_expr(decls, for_string.iterable),
					iterable_release_policy = for_string.iterable_release_policy,
					body = prepare_expr(decls, for_string.body)
				},
				typ,
				loc,
			)
		ForDictExpr(for_dict, typ, loc):
			ForDictExpr(
				{
					binder = for_dict.binder,
					iterable = prepare_expr(decls, for_dict.iterable),
					iterable_release_policy = for_dict.iterable_release_policy,
					body = prepare_expr(decls, for_dict.body)
				},
				typ,
				loc,
			)
		ForSetExpr(for_set, typ, loc):
			ForSetExpr(
				{
					binder = for_set.binder,
					iterable = prepare_expr(decls, for_set.iterable),
					iterable_release_policy = for_set.iterable_release_policy,
					body = prepare_expr(decls, for_set.body)
				},
				typ,
				loc,
			)
		ForResourceSourceExpr(for_resource_source, typ, loc):
			ForResourceSourceExpr(
				{
					binder = for_resource_source.binder,
					iterable = prepare_expr(decls, for_resource_source.iterable),
					iterable_release_policy = for_resource_source.iterable_release_policy,
					body = prepare_expr(decls, for_resource_source.body)
				},
				typ,
				loc,
			)
		ForStreamExpr(for_stream, typ, loc):
			ForStreamExpr(
				{
					binder = for_stream.binder,
					iterable = prepare_expr(decls, for_stream.iterable),
					iterable_release_policy = for_stream.iterable_release_policy,
					body = prepare_expr(decls, for_stream.body)
				},
				typ,
				loc,
			)
		ForTensorExpr(for_tensor, typ, loc):
			ForTensorExpr(
				{
					binder = for_tensor.binder,
					element_storage = clone_tensor_for_element_storage(for_tensor.element_storage),
					iterable = prepare_expr(decls, for_tensor.iterable),
					iterable_release_policy = for_tensor.iterable_release_policy,
					body = prepare_expr(decls, for_tensor.body)
				},
				typ,
				loc,
			)
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			PreClosureConcurrentlyLoopExpr(
				{
					variable = loop.variable,
					item_type = loop.item_type,
					item_mode = loop.item_mode,
					iterable = prepare_expr(decls, loop.iterable),
					body = prepare_expr(decls, loop.body),
					timeout = prepare_optional_expr(decls, loop.timeout),
					limit = prepare_expr(decls, loop.limit),
					output = loop.output
				},
				typ,
				loc,
			)
		PreClosureDetachExpr(detached, typ, loc):
			PreClosureDetachExpr(
				prepare_expr(decls, detached),
				typ,
				loc,
			)
		DetachExpr(detached, typ, loc):
			expr
		ConcurrentlyLoopExpr(loop, typ, loc):
			ConcurrentlyLoopExpr(
				prepare_concurrently_loop(decls, loop),
				typ,
				loc,
			)
		PreClosureConcurrentExpr(block, typ, loc):
			PreClosureConcurrentExpr(
				{
					bindings = block.bindings,
					body = prepare_expr(decls, block.body),
					timeout = prepare_optional_expr(decls, block.timeout),
					max_threads = block.max_threads
				},
				typ,
				loc,
			)
		ConcurrentExpr(block, typ, loc):
			ConcurrentExpr(
				prepare_concurrent_block(decls, block),
				typ,
				loc,
			)
		SelectExpr(select_expr, typ, loc):
			SelectExpr(
				prepare_select_arms(decls, select_expr),
				typ,
				loc,
			)
		RangeExpr(start, end_value, typ, loc):
			RangeExpr(
				prepare_expr(decls, start),
				prepare_expr(decls, end_value),
				typ,
				loc,
			)
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			AccessorLiteralMatchExpr(
				prepare_expr(decls, scrutinee),
				scrutinee_release_policy,
				prepare_constructor_literal_match(decls, match_expr),
				typ,
				loc,
			)
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			LengthMatchExpr(
				prepare_expr(decls, scrutinee),
				scrutinee_release_policy,
				prepare_constructor_length_match(decls, match_expr),
				typ,
				loc,
			)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			LiteralMatchExpr(
				prepare_expr(decls, scrutinee),
				prepare_literal_match_cases(decls, cases),
				prepare_literal_match_fallback(decls, fallback),
				typ,
				loc,
			)
		RawMatchExpr(scrutinee, cases, typ, loc):
			RawMatchExpr(
				prepare_expr(decls, scrutinee),
				cases.map(func(case): { case | body = prepare_expr(decls, case.body) }),
				typ,
				loc,
			)
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			CoreTraverse.map_core_expr_children_with_context(expr, decls, prepare_expr)
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, fallback, typ, loc):
			ConstructorMatchExpr(
				prepare_expr(decls, scrutinee),
				scrutinee_release_policy,
				prepare_constructor_match_cases(decls, cases),
				prepare_constructor_match_fallback(decls, fallback),
				typ,
				loc,
			)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			IfExpr(
				prepare_expr(decls, cond),
				prepare_expr(decls, then_expr),
				prepare_expr(decls, else_expr),
				typ,
				loc,
			)


private pure func prepare_dict_literal_entry_for_ownership(
	decls: List[CoreDecl],
	entry: CoreDictLiteralEntry,
) -> CoreDictLiteralEntry:
	{
		key = prepare_dict_literals_for_ownership_expr(decls, entry.key),
		value = prepare_dict_literals_for_ownership_expr(decls, entry.value)
	}


private pure func prepare_dict_literals_for_ownership_expr(
	decls: List[CoreDecl],
	expr: CoreExpr,
) -> CoreExpr:
	match expr:
		DictExpr(entries, typ, loc):
			prepared_entries: List[CoreDictLiteralEntry] = entries.map(
				func(entry): prepare_dict_literal_entry_for_ownership(decls, entry),
			)

			lower_dict_literal_expr(decls, prepared_entries, typ, loc)
		_:
			CoreTraverse.map_core_expr_children_with_context(
				expr,
				decls,
				prepare_dict_literals_for_ownership_expr,
			)


private pure func prepare_dict_literals_for_ownership_function(
	decls: List[CoreDecl],
	func_info: CoreFunction,
) -> CoreFunction:
	match func_info.body:
		Some(body):
			{ func_info | body = Some(prepare_dict_literals_for_ownership_expr(decls, body)) }
		None:
			func_info


private pure func prepare_dict_literals_for_ownership_decl(
	decls: List[CoreDecl],
	decl: CoreDecl,
) -> CoreDecl:
	match decl:
		FunctionDecl(func_info):
			FunctionDecl(prepare_dict_literals_for_ownership_function(decls, func_info))
		GlobalDecl(global):
			GlobalDecl(
				{ global | init = prepare_dict_literals_for_ownership_expr(decls, global.init) },
			)
		ImplDecl(impl_decl):
			ImplDecl(
				{ impl_decl |
					methods = impl_decl.methods.map(
						func(method): prepare_dict_literals_for_ownership_function(decls, method),
					)
				},
			)
		_:
			decl


pure func prepare_dict_literals_for_ownership(program: CoreProgram) -> CoreProgram:
	{ program |
		decls = program.decls.map(
			func(decl): prepare_dict_literals_for_ownership_decl(program.decls, decl),
		)
	}


private pure func prepare_function(decls: List[CoreDecl], func_info: CoreFunction) -> CoreFunction:
	match func_info.body:
		Some(body):
			prepared_body: CoreExpr = prepare_expr(decls, body)
			{ func_info | body = Some(annotate_tensor_storage_expr([], prepared_body)) }
		None:
			func_info


private pure func prepare_global(decls: List[CoreDecl], global: CoreGlobal) -> CoreGlobal:
	prepared_init: CoreExpr = prepare_expr(decls, global.init)
	{ global | init = annotate_tensor_storage_expr([], prepared_init) }


private pure func prepare_decl(decls: List[CoreDecl], decl: CoreDecl) -> CoreDecl:
	match decl:
		FunctionDecl(func_info):
			FunctionDecl(prepare_function(decls, func_info))
		GlobalDecl(global):
			GlobalDecl(prepare_global(decls, global))
		EnumDecl(enum_decl):
			EnumDecl(enum_decl)
		UnionDecl(union_decl):
			UnionDecl(union_decl)
		ValueRecordDecl(record_decl):
			ValueRecordDecl(record_decl)
		HeapRecordDecl(record_decl):
			HeapRecordDecl(record_decl)
		TypeAliasDecl(alias_decl):
			TypeAliasDecl(alias_decl)
		TraitDecl(trait_decl):
			TraitDecl(trait_decl)
		ImplDecl(impl_decl):
			ImplDecl(
				{ impl_decl |
					methods = impl_decl.methods.map(func(method): prepare_function(decls, method))
				},
			)


pure func prepare_program(program: CoreProgram) -> CoreProgram:
	var decls: List[CoreDecl] = []

	for decl in program.decls:
		decls = decls.append(prepare_decl(program.decls, decl))

	{
		decls = decls,
		foreign_includes = program.foreign_includes
	}
