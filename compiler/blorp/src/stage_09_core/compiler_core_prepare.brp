	{
		constructor = construct.constructor,
		entries = prepare_dict_entries(decls, construct.entries),
		value_needs_release = construct.value_needs_release
	}


private pure func prepare_list_construct(
	decls: List[CoreDecl],
	construct: CoreListConstruct,
) -> CoreListConstruct:
	prepared_elements: List[CoreBoxedStorageValue] = prepare_boxed_storage_values(
		decls,
		construct.elements,
	)

	{
		layout = construct.layout,
		elements = prepared_elements.map(
			func(value): prepare_list_storage_value(construct.layout, value),
		),
		elem_needs_release = construct.elem_needs_release
	}


