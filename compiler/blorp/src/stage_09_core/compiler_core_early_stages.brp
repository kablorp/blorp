-- Shared transforms for the contiguous Core prefix. Keep these operations
-- independent of the late pipeline so frontend ownership does not pull in
-- closure conversion, Perceus, preparation, or backend-only modules.
import:
	../stage_08_core_lower/compiler_core_list_layout as CoreListLayout
	compiler_core_debug as CoreDebug
	compiler_core_desugar as CoreDesugar
	compiler_core_json: CoreProgram
	compiler_core_ssa as CoreSsa


pure func run_debug_stage(program: CoreProgram, enabled: Bool) -> CoreProgram:
	CoreDebug.lower_program(enabled, program)


pure func run_desugar_stage(program: CoreProgram) -> CoreProgram:
	CoreSsa.desugar_program(CoreDesugar.desugar_program(program))


pure func run_list_layout_stage(program: CoreProgram) -> CoreProgram:
	CoreListLayout.annotate_list_layouts(program)
