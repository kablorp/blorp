-- Canonical source-trait identities for Core operations that do not carry an
-- explicit DeferredTraitCall. Generic impl materialization and Core trait
-- resolution must share this table.
import:
	core_json:
		CoreBinaryOp(
			AddOp,
			DivideOp,
			EqualOp,
			GreaterEqualOp,
			GreaterOp,
			LessEqualOp,
			LessOp,
			ModuloOp,
			MultiplyOp,
			NotEqualOp,
			SubtractOp,
		),
		CoreUnaryOp(NegateOp, NotOp),


record CoreTraitMethodIdentity {
	trait_name: String,
	method_name: String
}


pure func core_binary_trait_method(op: CoreBinaryOp) -> CoreTraitMethodIdentity:
	match op:
		AddOp:
			{
				trait_name = "Addable",
				method_name = "add"
			}
		SubtractOp:
			{
				trait_name = "Subtractable",
				method_name = "subtract"
			}
		MultiplyOp:
			{
				trait_name = "Multipliable",
				method_name = "multiply"
			}
		DivideOp:
			{
				trait_name = "Divisible",
				method_name = "divide"
			}
		ModuloOp:
			{
				trait_name = "Modulable",
				method_name = "remainder"
			}
		EqualOp:
			{
				trait_name = "Equatable",
				method_name = "equals"
			}
		NotEqualOp:
			{
				trait_name = "Equatable",
				method_name = "not_equals"
			}
		LessOp:
			{
				trait_name = "Orderable",
				method_name = "less_than"
			}
		GreaterOp:
			{
				trait_name = "Orderable",
				method_name = "greater_than"
			}
		LessEqualOp:
			{
				trait_name = "Orderable",
				method_name = "less_than_or_equal"
			}
		GreaterEqualOp:
			{
				trait_name = "Orderable",
				method_name = "greater_than_or_equal"
			}


pure func core_unary_trait_method(op: CoreUnaryOp) -> Option[CoreTraitMethodIdentity]:
	match op:
		NegateOp:
			Some({
				trait_name = "Negatable",
				method_name = "negate",
			})
		NotOp:
			None


pure func core_builtin_trait_method(name: String) -> Option[CoreTraitMethodIdentity]:
	if name == "blorp_to_string":
		Some({
			trait_name = "Stringable",
			method_name = "to_string",
		})
	else:
		None


-- compiler_core_resolve maps bare equals calls to blorp_eq_dispatch, and
-- Core specialization lowers that sentinel to representation-aware equality.
-- Returning the canonical source name keeps aliases from bypassing that
-- downstream sentinel while preventing structural equality from being
-- mistaken for a missing user impl.
pure func core_trait_method_builtin_fallback_name(
	identity: CoreTraitMethodIdentity,
) -> Option[String]:
	if identity.trait_name == "Equatable" and identity.method_name == "equals":
		Some("equals")
	else:
		None
