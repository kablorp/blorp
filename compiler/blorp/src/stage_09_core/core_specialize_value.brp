-- Value-oriented post-resolve specialization.
--
-- This module rewrites only the current Core node. The production
-- specialization orchestrator owns recursion so independent builtin families
-- can be composed without traversing the tree more than once.
import:
	core_json:
		CoreBinaryOp(EqualOp, NotEqualOp),
		CoreBoxOp,
		CoreCallKind(BuiltinCall),
		CoreExpr(BinaryExpr, BoxExpr, CallExpr, CastExpr, LiteralExpr, UnaryExpr, VoidExpr),
		CoreLiteral(StringLiteral),
		CoreSourceLoc,
		CoreType(EnumType, FunctionType, NamedType, RangeType, TensorType, VoidType),
		CoreUnaryOp(NotOp),
		core_expr_type,
	core_specialize_layout:
		CoreOptionRuntimeLayout(
			BoxedOptionLayout,
			NullableManagedOptionLayout,
			PrimitiveStackOptionLayout,
			UnspecializedOptionLayout,
		),
		CoreSpecializeLayout,
		option_payload_runtime_layout,
		resolve_specialize_type,
		single_named_type_argument,
		specialize_type_is_pointer,
		tensor_type_info,
	core_type_policy: core_type_has_unresolved_mono_parameters
	string: string


private pure func named_type(name: String) -> CoreType:
	NamedType(name, [])


private pure func named_type_is(typ: CoreType, expected: String) -> Bool:
	match typ:
		NamedType(name, args):
			name == expected and args.is_empty()
		_:
			False


private pure func bool_type_is(typ: CoreType) -> Bool:
	match typ:
		NamedType("Bool", args):
			args.is_empty()
		EnumType("Bool"):
			True
		_:
			False


private pure func integer_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			(
				args.is_empty()
				and ((
					name == "Int"
					or name == "Int8"
					or name == "Int16"
					or name == "Int32"
					or name == "Int64"
					or name == "Int128"
					or name == "UInt8"
					or name == "UInt16"
					or name == "UInt32"
					or name == "UInt64"
					or name == "UInt128"
				))
			)
		_:
			False


private pure func builtin_call(
	name: String,
	callee: CoreExpr,
	args: List[CoreExpr],
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	CallExpr(BuiltinCall(name), callee, args, result_type, loc)


private pure func is_c_identifier_char(ch: Char) -> Bool:
	ch >= 'a' and ch <= 'z' or ch >= 'A' and ch <= 'Z' or ch >= '0' and ch <= '9' or ch == '_'


private pure func sanitize_c_identifier(name: String) -> String:
	var result: String = string(name.length())

	for ch in name:
		result = if is_c_identifier_char(ch):
			result.append_char(ch)
		else:
			result.append_char('_')

	result


private pure func tensor_to_string_builtin(
	layout: CoreSpecializeLayout,
	typ: CoreType,
	debug_mode: Bool,
) -> Option[String]:
	info ?= tensor_type_info(layout, typ)
	element_type: CoreType = resolve_specialize_type(layout, info.element_type)

	if named_type_is(element_type, "Float32"):
		Some("blorp_vector_to_string_float32")
	else if named_type_is(element_type, "Float16"):
		Some("blorp_vector_to_string_float16")
	else if named_type_is(element_type, "Float"):
		Some("blorp_vector_to_string_float")
	else if not debug_mode and bool_type_is(element_type):
		Some("blorp_vector_to_string_bool")
	else if not debug_mode:
		match element_type:
			EnumType(name):
				Some("blorp_vector_to_string_" + sanitize_c_identifier(name))
			_:
				Some("blorp_vector_to_string_int")
	else:
		Some("blorp_vector_to_string_int")


private pure func list_element_type(
	layout: CoreSpecializeLayout,
	typ: CoreType,
) -> Option[CoreType]:
	element_type ?= single_named_type_argument(layout, typ, "List")
	Some(resolve_specialize_type(layout, element_type))


private pure func to_string_list_builtin(element_type: CoreType) -> String:
	if integer_type(element_type):
		"blorp_list_to_string_int"
	else if named_type_is(element_type, "Float"):
		"blorp_list_to_string_float"
	else if named_type_is(element_type, "Float32"):
		"blorp_list_to_string_float32"
	else if named_type_is(element_type, "Float16"):
		"blorp_list_to_string_float16"
	else if named_type_is(element_type, "String"):
		"blorp_list_to_string_string"
	else if bool_type_is(element_type):
		"blorp_list_to_string_bool"
	else:
		"blorp_list_to_string_cb"


private pure func debug_string_list_builtin(element_type: CoreType) -> String:
	if named_type_is(element_type, "Float"):
		"blorp_list_to_string_float"
	else if named_type_is(element_type, "Float32"):
		"blorp_list_to_string_float32"
	else if named_type_is(element_type, "Float16"):
		"blorp_list_to_string_float16"
	else if named_type_is(element_type, "String"):
		"blorp_list_to_string_string"
	else if bool_type_is(element_type):
		"blorp_list_to_string_bool"
	else:
		"blorp_list_to_string_int"


private pure func to_string_builtin_for_type(
	layout: CoreSpecializeLayout,
	typ: CoreType,
) -> Option[String]:
	resolved: CoreType = resolve_specialize_type(layout, typ)

	if named_type_is(resolved, "Int128"):
		Some("blorp_int128_to_string")
	else if named_type_is(resolved, "UInt128"):
		Some("blorp_uint128_to_string")
	else if integer_type(resolved):
		Some("blorp_to_string")
	else if named_type_is(resolved, "Float"):
		Some("blorp_float_to_string")
	else if named_type_is(resolved, "Float32"):
		Some("blorp_float32_to_string")
	else if named_type_is(resolved, "Float16"):
		Some("blorp_float16_to_string")
	else if bool_type_is(resolved):
		Some("blorp_bool_to_string")
	else if named_type_is(resolved, "Char"):
		Some("blorp_from_char")
	else if named_type_is(resolved, "Bytes"):
		Some("blorp_bytes_to_string")
	else if named_type_is(resolved, "Fixed"):
		Some("blorp_fixed_to_string")
	else:
		match resolved:
			RangeType:
				Some("blorp_to_string")
			TensorType(_):
				tensor_to_string_builtin(layout, resolved, False)
			_:
				match list_element_type(layout, resolved):
					Some(element_type):
						Some(to_string_list_builtin(element_type))
					None:
						None


private pure func specialize_to_string(
	layout: CoreSpecializeLayout,
	original: CoreExpr,
	callee: CoreExpr,
	arg: CoreExpr,
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	resolved: CoreType = resolve_specialize_type(layout, core_expr_type(arg))

	if named_type_is(resolved, "String"):
		arg
	else:
		match to_string_builtin_for_type(layout, resolved):
			Some(name):
				builtin_call(name, callee, [arg], result_type, loc)
			None:
				original


private pure func debug_string_builtin_for_type(
	layout: CoreSpecializeLayout,
	typ: CoreType,
) -> Option[String]:
	resolved: CoreType = resolve_specialize_type(layout, typ)

	if named_type_is(resolved, "Int128"):
		Some("blorp_int128_to_string")
	else if named_type_is(resolved, "UInt128"):
		Some("blorp_uint128_to_string")
	else if integer_type(resolved):
		Some("blorp_to_string")
	else if named_type_is(resolved, "Float"):
		Some("blorp_float_to_string")
	else if named_type_is(resolved, "Float32"):
		Some("blorp_float32_to_string")
	else if named_type_is(resolved, "Float16"):
		Some("blorp_float16_to_string")
	else if bool_type_is(resolved):
		Some("blorp_bool_to_string")
	else if named_type_is(resolved, "Char"):
		Some("blorp_from_char")
	else if named_type_is(resolved, "Bytes"):
		Some("blorp_bytes_to_string")
	else if named_type_is(resolved, "StringSlice"):
		Some("Stringable_to_string_StringSlice")
	else if named_type_is(resolved, "Url"):
		Some("Stringable_to_string_Url")
	else if named_type_is(resolved, "Fixed"):
		Some("blorp_fixed_to_string")
	else:
		match resolved:
			RangeType:
				Some("blorp_to_string")
			TensorType(_):
				tensor_to_string_builtin(layout, resolved, True)
			_:
				match list_element_type(layout, resolved):
					Some(element_type):
						Some(debug_string_list_builtin(element_type))
					None:
						None


private pure func debug_placeholder(typ: CoreType) -> Option[String]:
	match typ:
		VoidType | NamedType("Void", []):
			Some("()")
		FunctionType(_, _, _):
			Some("<fn>")
		NamedType("Channel", _):
			Some("<channel>")
		NamedType("Ptr", _):
			Some("<ptr>")
		_:
			None


private pure func specialize_debug_string(
	layout: CoreSpecializeLayout,
	original: CoreExpr,
	callee: CoreExpr,
	arg: CoreExpr,
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	resolved: CoreType = resolve_specialize_type(layout, core_expr_type(arg))

	if named_type_is(resolved, "String"):
		arg
	else:
		match debug_string_builtin_for_type(layout, resolved):
			Some(name):
				builtin_call(name, callee, [arg], result_type, loc)
			None:
				match debug_placeholder(resolved):
					Some(value):
						LiteralExpr(StringLiteral(value), named_type("String"), loc)
					None:
						original


private pure func string_type(typ: CoreType) -> Bool:
	match typ:
		NamedType("String", _) | NamedType("LiteralString", _):
			True
		_:
			False


private pure func option_element_type(
	layout: CoreSpecializeLayout,
	typ: CoreType,
) -> Option[CoreType]:
	element_type ?= single_named_type_argument(layout, typ, "Option")
	Some(resolve_specialize_type(layout, element_type))


private pure func option_equality_builtin(
	layout: CoreSpecializeLayout,
	element_type: CoreType,
) -> Option[String]:
	resolved: CoreType = resolve_specialize_type(layout, element_type)

	match option_payload_runtime_layout(layout, resolved):
		PrimitiveStackOptionLayout(_):
			Some("__blorp_option_eq_layout")
		NullableManagedOptionLayout:
			if string_type(resolved):
				Some("__blorp_option_eq_layout")
			else:
				None
		BoxedOptionLayout:
			if string_type(resolved):
				Some("blorp_option_eq_string")
			else if named_type_is(resolved, "Float"):
				Some("blorp_option_eq_float")
			else:
				Some("blorp_option_eq")
		UnspecializedOptionLayout:
			None


private pure func bool_builtin_call(
	name: String,
	args: List[CoreExpr],
	loc: CoreSourceLoc,
) -> CoreExpr:
	builtin_call(
		name,
		VoidExpr(VoidType, loc),
		args,
		named_type("Bool"),
		loc,
	)


private pure func list_equality_builtin(element_type: CoreType) -> String:
	if named_type_is(element_type, "String"):
		"blorp_list_eq_string"
	else if named_type_is(element_type, "Float"):
		"blorp_list_eq_float"
	else:
		"blorp_list_eq"


private pure func specialize_option_equality_dispatch(
	layout: CoreSpecializeLayout,
	original: CoreExpr,
	left: CoreExpr,
	right: CoreExpr,
	loc: CoreSourceLoc,
) -> CoreExpr:
	match option_element_type(layout, core_expr_type(left)):
		Some(element_type):
			match option_equality_builtin(layout, element_type):
				Some(name):
					bool_builtin_call(
						name,
						[left, right],
						loc,
					)
				None:
					original
		None:
			match option_element_type(layout, core_expr_type(right)):
				Some(element_type):
					match option_equality_builtin(layout, element_type):
						Some(name):
							bool_builtin_call(
								name,
								[left, right],
								loc,
							)
						None:
							original
				None:
					BinaryExpr(EqualOp, left, right, named_type("Bool"), loc)


private pure func specialize_equality_dispatch(
	layout: CoreSpecializeLayout,
	original: CoreExpr,
	left: CoreExpr,
	right: CoreExpr,
	loc: CoreSourceLoc,
) -> CoreExpr:
	left_type: CoreType = resolve_specialize_type(layout, core_expr_type(left))
	right_type: CoreType = resolve_specialize_type(layout, core_expr_type(right))

	if string_type(left_type) or string_type(right_type):
		bool_builtin_call(
			"blorp_string_eq",
			[left, right],
			loc,
		)
	else:
		match list_element_type(layout, left_type):
			Some(element_type):
				bool_builtin_call(
					list_equality_builtin(element_type),
					[left, right],
					loc,
				)
			None:
				match list_element_type(layout, right_type):
					Some(element_type):
						bool_builtin_call(
							list_equality_builtin(element_type),
							[left, right],
							loc,
						)
					None:
						specialize_option_equality_dispatch(layout, original, left, right, loc)


private pure func specialize_plain_option_equality(
	layout: CoreSpecializeLayout,
	original: CoreExpr,
	op: CoreBinaryOp,
	left: CoreExpr,
	right: CoreExpr,
	loc: CoreSourceLoc,
) -> CoreExpr:
	match option_element_type(layout, core_expr_type(left)):
		Some(element_type):
			match option_equality_builtin(layout, element_type):
				Some(name):
					equality: CoreExpr = bool_builtin_call(
						name,
						[left, right],
						loc,
					)

					match op:
						NotEqualOp:
							UnaryExpr(NotOp, equality, named_type("Bool"), loc)
						_:
							equality
				None:
					original
		None:
			original


private pure func specialize_box(
	layout: CoreSpecializeLayout,
	original: CoreExpr,
	box: CoreBoxOp,
	loc: CoreSourceLoc,
) -> CoreExpr:
	source_type: CoreType = if core_type_has_unresolved_mono_parameters(box.source_type):
		core_expr_type(box.value)
	else:
		box.source_type

	if (
		not core_type_has_unresolved_mono_parameters(source_type)
		and specialize_type_is_pointer(layout, source_type)
	):
		CastExpr(box.value, named_type("Ptr"), loc)
	else:
		original


private pure func specialize_value_call(
	layout: CoreSpecializeLayout,
	original: CoreExpr,
	name: String,
	callee: CoreExpr,
	args: List[CoreExpr],
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	if name == "blorp_to_string" and args.length() == 1:
		arg: CoreExpr = args.get_or(0, callee)
		specialize_to_string(layout, original, callee, arg, result_type, loc)
	else if name == "blorp_debug_string" and args.length() == 1:
		arg: CoreExpr = args.get_or(0, callee)
		specialize_debug_string(layout, original, callee, arg, result_type, loc)
	else if name == "blorp_eq_dispatch" and args.length() == 2:
		left: CoreExpr = args.get_or(0, callee)
		right: CoreExpr = args.get_or(1, callee)
		specialize_equality_dispatch(layout, original, left, right, loc)
	else:
		original


pure func specialize_value_expr(layout: CoreSpecializeLayout, expr: CoreExpr) -> CoreExpr:
	match expr:
		BoxExpr(box, _, loc):
			specialize_box(layout, expr, box, loc)
		CallExpr(BuiltinCall(name), callee, args, typ, loc):
			specialize_value_call(layout, expr, name, callee, args, typ, loc)
		BinaryExpr(EqualOp, left, right, _, loc):
			specialize_plain_option_equality(layout, expr, EqualOp, left, right, loc)
		BinaryExpr(NotEqualOp, left, right, _, loc):
			specialize_plain_option_equality(layout, expr, NotEqualOp, left, right, loc)
		_:
			expr
