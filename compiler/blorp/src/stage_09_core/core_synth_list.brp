		),
	)


private pure func synthesize_binary_search(
	list_type: CoreType,
	element_type: CoreType,
	return_type: CoreType,
	self: CoreExpr,
	target: CoreExpr,
	comparator: Option[CoreExpr],
) -> CoreExpr:
	comparison: CoreExpr = match comparator:
		Some(callback):
			closure_call(
				variable(
					"__compare",
					core_expr_type(callback),
				),
				[variable("__elem", element_type), variable("__target", element_type)],
				INT_TYPE,
			)
		None:
			int_literal(0)

	equal_condition: CoreExpr = match comparator:
		Some(_):
			binary(
				EqualOp,
				variable("__comparison", INT_TYPE),
				int_literal(0),
				BOOL_TYPE,
			)
		None:
			binary(
				EqualOp,
				variable("__elem", element_type),
				variable("__target", element_type),
				BOOL_TYPE,
			)

	less_condition: CoreExpr = match comparator:
		Some(_):
			binary(
				LessOp,
				variable("__comparison", INT_TYPE),
				int_literal(0),
				BOOL_TYPE,
			)
		None:
			binary(
				LessOp,
				variable("__elem", element_type),
				variable("__target", element_type),
				BOOL_TYPE,
			)

	adjust: CoreExpr = if_expr(
		less_condition,
		assignment(
			"__lo",
			binary(
				AddOp,
				variable("__mid", INT_TYPE),
				int_literal(1),
				INT_TYPE,
			),
		),
		assignment(
			"__hi",
			binary(
				SubtractOp,
				variable("__mid", INT_TYPE),
				int_literal(1),
				INT_TYPE,
			),
		),
		VoidType,
	)
	probe_body: CoreExpr = immutable_let(
		"__elem",
		element_type,
		list_value(
			variable("__self", list_type),
			variable("__mid", INT_TYPE),
			element_type,
		),
		immutable_let(
			"__comparison",
			INT_TYPE,
			comparison,
			if_expr(
				equal_condition,
				SeqExpr(
					assignment(
						"__result",
						option_some(
							variable("__mid", INT_TYPE),
							return_type,
						),
					),
					BREAK_EXPR,
				),
				adjust,
				VoidType,
			),
		),
	)
	loop_body: CoreExpr = immutable_let(
		"__mid",
		INT_TYPE,
		binary(
			AddOp,
			variable("__lo", INT_TYPE),
			binary(
				DivideOp,
				binary(
					SubtractOp,
					variable("__hi", INT_TYPE),
					variable("__lo", INT_TYPE),
					INT_TYPE,
				),
				int_literal(2),
				INT_TYPE,
			),
			INT_TYPE,
		),
		probe_body,
	)
	search: CoreExpr = immutable_let(
		"__n",
		INT_TYPE,
		intrinsic_call("list_len", [variable("__self", list_type)], INT_TYPE),
		mutable_let(
			"__lo",
			INT_TYPE,
			int_literal(0),
			mutable_let(
				"__hi",
				INT_TYPE,
				binary(
					SubtractOp,
					variable("__n", INT_TYPE),
					int_literal(1),
					INT_TYPE,
				),
				mutable_let(
					"__result",
					return_type,
					option_none(return_type),
					SeqExpr(
						while_expr(
							binary(
								LessEqualOp,
								variable("__lo", INT_TYPE),
								variable("__hi", INT_TYPE),
								BOOL_TYPE,
							),
							loop_body,
						),
						variable("__result", return_type),
					),
				),
			),
		),
	)

	with_comparator: CoreExpr = match comparator:
		Some(callback):
			immutable_let("__compare", core_expr_type(callback), callback, search)
		None:
			search

	borrow_let(
		"__self",
		list_type,
		self,
		immutable_let("__target", element_type, target, with_comparator),
	)


private pure func synthesize_min_max_by(
	list_type: CoreType,
	element_type: CoreType,
	key_type: CoreType,
	return_type: CoreType,
	self: CoreExpr,
	callback: CoreExpr,
	find_maximum: Bool,
) -> CoreExpr:
	better: CoreExpr = if find_maximum:
		binary(
			GreaterOp,
			variable("__score", key_type),
			variable("__best_value", key_type),
			BOOL_TYPE,
		)
	else:
		binary(
			LessOp,
			variable("__score", key_type),
			variable("__best_value", key_type),
			BOOL_TYPE,
		)

	loop_body: CoreExpr = immutable_let(
		"__elem",
		element_type,
		list_value(
			variable("__self", list_type),
			variable("__i", INT_TYPE),
			element_type,
		),
		immutable_let(
			"__score",
			key_type,
			closure_call(
				variable("__callback", core_expr_type(callback)),
				[variable("__elem", element_type)],
				key_type,
			),
			if_expr(
				better,
				SeqExpr(
					assignment(
						"__best_i",
						variable("__i", INT_TYPE),
					),
					assignment(
						"__best_value",
						variable("__score", key_type),
					),
				),
				VOID_EXPR,
				VoidType,
			),
		),
	)
	selected: CoreExpr = immutable_let(
		"__best_elem",
		element_type,
		list_value(
			variable("__self", list_type),
			variable("__best_i", INT_TYPE),
			element_type,
		),
		SeqExpr(
			intrinsic_call(
				"list_retain_for",
				[variable("__self", list_type), variable("__best_elem", element_type)],
				VoidType,
			),
			option_some(
				variable("__best_elem", element_type),
				return_type,
			),
		),
	)

	borrow_let(
		"__self",
		list_type,
		self,
		immutable_let(
			"__callback",
			core_expr_type(callback),
			callback,
			immutable_let(
				"__n",
				INT_TYPE,
				intrinsic_call("list_len", [variable("__self", list_type)], INT_TYPE),
				if_expr(
					binary(
						EqualOp,
						variable("__n", INT_TYPE),
						int_literal(0),
						BOOL_TYPE,
					),
					option_none(return_type),
					immutable_let(
						"__first",
						element_type,
						list_value(
							variable("__self", list_type),
							int_literal(0),
							element_type,
						),
						mutable_let(
							"__best_i",
							INT_TYPE,
							int_literal(0),
							mutable_let(
								"__best_value",
								key_type,
								closure_call(
									variable("__callback", core_expr_type(callback)),
									[variable("__first", element_type)],
									key_type,
								),
								SeqExpr(
									for_range(
										"__i",
										int_literal(1),
										variable("__n", INT_TYPE),
										loop_body,
									),
									selected,
								),
							),
						),
					),
					return_type,
				),
			),
		),
	)


private pure func synthesize_scan(
	list_type: CoreType,
	element_type: CoreType,
	result_type: CoreType,
	accumulator_type: CoreType,
	self: CoreExpr,
	initial: CoreExpr,
	callback: CoreExpr,
) -> CoreExpr:
	loop_body: CoreExpr = immutable_let(
		"__previous",
		accumulator_type,
		list_value(
			variable("__result", result_type),
			variable("__i", INT_TYPE),
			accumulator_type,
		),
		immutable_let(
			"__elem",
			element_type,
			list_value(
				variable("__self", list_type),
				variable("__i", INT_TYPE),
				element_type,
			),
			immutable_let(
				"__next",
				accumulator_type,
				closure_call(
					variable(
						"__callback",
						core_expr_type(callback),
					),
					[variable("__previous", accumulator_type), variable("__elem", element_type)],
					accumulator_type,
				),
				immutable_let(
					"__out_i",
					INT_TYPE,
					binary(
						AddOp,
						variable("__i", INT_TYPE),
						int_literal(1),
						INT_TYPE,
					),
					SeqExpr(
						intrinsic_call(
							"list_set_owned",
							[
								variable("__result", result_type),
								variable("__out_i", INT_TYPE),
								variable("__next", accumulator_type),
							],
							VoidType,
						),
						intrinsic_call(
							"list_set_len",
							[variable("__result", result_type), binary(
									AddOp,
									variable("__out_i", INT_TYPE),
									int_literal(1),
									INT_TYPE,
								)],
							VoidType,
						),
					),
				),
			),
		),
	)

	borrow_let(
		"__self",
		list_type,
		self,
		immutable_let(
			"__callback",
			core_expr_type(callback),
			callback,
			immutable_let(
				"__n",
				INT_TYPE,
				intrinsic_call(
					"list_len",
					[variable("__self", list_type)],
					INT_TYPE,
				),
				immutable_let(
					"__initial",
					accumulator_type,
					initial,
					immutable_let(
						"__result",
						result_type,
						intrinsic_call(
							"list_alloc",
							[binary(
									AddOp,
									variable("__n", INT_TYPE),
									int_literal(1),
									INT_TYPE,
								)],
							result_type,
						),
						SeqExpr(
							intrinsic_call(
								"list_set_owned",
								[
									variable("__result", result_type),
									int_literal(0),
									variable("__initial", accumulator_type),
								],
								VoidType,
							),
							SeqExpr(
								intrinsic_call(
									"list_set_len",
									[variable("__result", result_type), int_literal(1)],
									VoidType,
								),
								SeqExpr(
									for_range(
										"__i",
										int_literal(0),
										variable("__n", INT_TYPE),
										loop_body,
									),
									variable("__result", result_type),
								),
							),
						),
					),
				),
			),
		),
	)


private pure func synthesize_enumerate(
	list_type: CoreType,
	element_type: CoreType,
	result_type: CoreType,
	pair_type: CoreType,
	self: CoreExpr,
) -> CoreExpr:
	loop_body: CoreExpr = immutable_let(
		"__elem",
		element_type,
		list_value(
			variable("__self", list_type),
			variable("__i", INT_TYPE),
			element_type,
		),
		immutable_let(
			"__pair",
			pair_type,
			TupleExpr(
				[variable("__i", INT_TYPE), variable("__elem", element_type)],
				pair_type,
				SyntheticSourceLoc,
			),
			intrinsic_call(
				"list_set_owned",
				[
					variable("__result", result_type),
					variable("__i", INT_TYPE),
					variable("__pair", pair_type),
				],
				VoidType,
			),
		),
	)

	borrow_let(
		"__self",
		list_type,
		self,
		immutable_let(
			"__n",
			INT_TYPE,
			intrinsic_call(
				"list_len",
				[variable("__self", list_type)],
				INT_TYPE,
			),
			immutable_let(
				"__result",
				result_type,
				intrinsic_call(
					"list_alloc",
					[variable("__n", INT_TYPE)],
					result_type,
				),
				SeqExpr(
					for_range(
						"__i",
						int_literal(0),
						variable("__n", INT_TYPE),
						loop_body,
					),
					SeqExpr(
						intrinsic_call(
							"list_set_len",
							[variable("__result", result_type), variable("__n", INT_TYPE)],
							VoidType,
						),
						variable(
							"__result",
							result_type,
						),
					),
				),
			),
		),
	)


private pure func synthesize_zip(
	left_type: CoreType,
	left_element_type: CoreType,
	right_type: CoreType,
	right_element_type: CoreType,
	result_type: CoreType,
	result_element_type: CoreType,
	left: CoreExpr,
	right: CoreExpr,
	callback: Option[CoreExpr],
) -> CoreExpr:
	left_value: CoreExpr = list_value(
		variable("__left", left_type),
		variable("__i", INT_TYPE),
		left_element_type,
	)
	right_value: CoreExpr = list_value(
		variable("__right", right_type),
		variable("__i", INT_TYPE),
		right_element_type,
	)

	produced: CoreExpr = match callback:
		Some(function_value):
			closure_call(
				variable(
					"__callback",
					core_expr_type(function_value),
				),
				[left_value, right_value],
				result_element_type,
			)
		None:
			TupleExpr(
				[left_value, right_value],
				result_element_type,
				SyntheticSourceLoc,
			)

	loop_body: CoreExpr = immutable_let(
		"__produced",
		result_element_type,
		produced,
		intrinsic_call(
			"list_set_owned",
			[
				variable("__result", result_type),
				variable("__i", INT_TYPE),
				variable("__produced", result_element_type),
			],
			VoidType,
		),
	)
	fill: CoreExpr = immutable_let(
		"__left_n",
		INT_TYPE,
		intrinsic_call(
			"list_len",
			[variable("__left", left_type)],
			INT_TYPE,
		),
		immutable_let(
			"__right_n",
			INT_TYPE,
			intrinsic_call(
				"list_len",
				[variable("__right", right_type)],
				INT_TYPE,
			),
			immutable_let(
				"__n",
				INT_TYPE,
				min_int(
					variable("__left_n", INT_TYPE),
					variable("__right_n", INT_TYPE),
				),
				immutable_let(
					"__result",
					result_type,
					intrinsic_call(
						"list_alloc",
						[variable("__n", INT_TYPE)],
						result_type,
					),
					SeqExpr(
						for_range(
							"__i",
							int_literal(0),
							variable("__n", INT_TYPE),
							loop_body,
						),
						SeqExpr(
							intrinsic_call(
								"list_set_len",
								[variable("__result", result_type), variable("__n", INT_TYPE)],
								VoidType,
							),
							variable(
								"__result",
								result_type,
							),
						),
					),
				),
			),
		),
	)

	with_callback: CoreExpr = match callback:
		Some(function_value):
			immutable_let("__callback", core_expr_type(function_value), function_value, fill)
		None:
			fill

	borrow_let(
		"__left",
		left_type,
		left,
		borrow_let("__right", right_type, right, with_callback),
	)


private pure func synthesize_unzip(
	list_type: CoreType,
	pair_type: CoreType,
	first_type: CoreType,
	second_type: CoreType,
	firsts_type: CoreType,
	seconds_type: CoreType,
	return_type: CoreType,
	self: CoreExpr,
) -> CoreExpr:
	loop_body: CoreExpr = immutable_let(
		"__pair",
		pair_type,
		list_value(
			variable("__self", list_type),
			variable("__i", INT_TYPE),
			pair_type,
		),
		immutable_let(
			"__first",
			first_type,
			TupleFieldExpr(
				variable("__pair", pair_type),
				0,
				first_type,
				SyntheticSourceLoc,
			),
			immutable_let(
				"__second",
				second_type,
				TupleFieldExpr(
					variable("__pair", pair_type),
					1,
					second_type,
					SyntheticSourceLoc,
				),
				SeqExpr(
					intrinsic_call(
						"list_retain_for",
						[variable("__firsts", firsts_type), variable("__first", first_type)],
						VoidType,
					),
					SeqExpr(
						intrinsic_call(
							"list_set",
							[
								variable("__firsts", firsts_type),
								variable("__i", INT_TYPE),
								variable("__first", first_type),
							],
							VoidType,
						),
						SeqExpr(
							intrinsic_call(
								"list_retain_for",
								[
									variable("__seconds", seconds_type),
									variable("__second", second_type),
								],
								VoidType,
							),
							intrinsic_call(
								"list_set",
								[
									variable("__seconds", seconds_type),
									variable("__i", INT_TYPE),
									variable("__second", second_type),
								],
								VoidType,
							),
						),
					),
				),
			),
		),
	)

	borrow_let(
		"__self",
		list_type,
		self,
		immutable_let(
			"__n",
			INT_TYPE,
			intrinsic_call(
				"list_len",
				[variable("__self", list_type)],
				INT_TYPE,
			),
			immutable_let(
				"__firsts",
				firsts_type,
				intrinsic_call(
					"list_alloc",
					[variable("__n", INT_TYPE)],
					firsts_type,
				),
				immutable_let(
					"__seconds",
					seconds_type,
					intrinsic_call(
						"list_alloc",
						[variable("__n", INT_TYPE)],
						seconds_type,
					),
					SeqExpr(
						for_range(
							"__i",
							int_literal(0),
							variable("__n", INT_TYPE),
							loop_body,
						),
						SeqExpr(
							intrinsic_call(
								"list_set_len",
								[variable("__firsts", firsts_type), variable("__n", INT_TYPE)],
								VoidType,
							),
							SeqExpr(
								intrinsic_call(
									"list_set_len",
									[
										variable("__seconds", seconds_type),
										variable("__n", INT_TYPE),
									],
									VoidType,
								),
								TupleExpr(
									[
										variable("__firsts", firsts_type),
										variable("__seconds", seconds_type),
									],
									return_type,
									SyntheticSourceLoc,
								),
							),
						),
					),
				),
			),
		),
	)


private pure func sort_index_value(buffer_name: String, index: CoreExpr) -> CoreExpr:
	unchecked_list_value(
		variable(
			buffer_name,
			NamedType("List", [INT_TYPE]),
		),
		index,
		INT_TYPE,
	)


private pure func move_sort_index(
	source_name: String,
	destination_name: String,
	source_index: CoreExpr,
) -> CoreExpr:
	intrinsic_call(
		"list_set",
		[variable(
				destination_name,
				NamedType("List", [INT_TYPE]),
			), variable("__out", INT_TYPE), sort_index_value(source_name, source_index)],
		VoidType,
	)


private pure func sort_value_for_index(
	index_name: String,
	list_type: CoreType,
	element_type: CoreType,
	key_list_type: Option[CoreType],
	key_type: CoreType,
) -> CoreExpr:
	match key_list_type:
		Some(keys_type):
			unchecked_list_value(
				variable("__keys", keys_type),
				variable(index_name, INT_TYPE),
				key_type,
			)
		None:
			unchecked_list_value(
				variable("__self", list_type),
				variable(index_name, INT_TYPE),
				element_type,
			)


private pure func sort_take_left(
	source_name: String,
	list_type: CoreType,
	element_type: CoreType,
	key_list_type: Option[CoreType],
	key_type: CoreType,
	descending: Bool,
) -> CoreExpr:
	left_value: CoreExpr = sort_value_for_index(
		"__left_index",
		list_type,
		element_type,
		key_list_type,
		key_type,
	)
	right_value: CoreExpr = sort_value_for_index(
		"__right_index",
		list_type,
		element_type,
		key_list_type,
		key_type,
	)

	comparison: CoreExpr = if descending:
		binary(GreaterEqualOp, left_value, right_value, BOOL_TYPE)
	else:
		binary(LessEqualOp, left_value, right_value, BOOL_TYPE)

	immutable_let(
		"__left_index",
		INT_TYPE,
		sort_index_value(
			source_name,
			variable("__i", INT_TYPE),
		),
		immutable_let(
			"__right_index",
			INT_TYPE,
			sort_index_value(
				source_name,
				variable("__j", INT_TYPE),
			),
			comparison,
		),
	)


private pure func sort_merge_step(
	source_name: String,
	destination_name: String,
	list_type: CoreType,
	element_type: CoreType,
	key_list_type: Option[CoreType],
	key_type: CoreType,
	descending: Bool,
) -> CoreExpr:
	move_left: CoreExpr = SeqExpr(
		move_sort_index(
			source_name,
			destination_name,
			variable("__i", INT_TYPE),
		),
		assignment(
			"__i",
			binary(
				AddOp,
				variable("__i", INT_TYPE),
				int_literal(1),
				INT_TYPE,
			),
		),
	)
	move_right: CoreExpr = SeqExpr(
		move_sort_index(
			source_name,
			destination_name,
			variable("__j", INT_TYPE),
		),
		assignment(
			"__j",
			binary(
				AddOp,
				variable("__j", INT_TYPE),
				int_literal(1),
				INT_TYPE,
			),
		),
	)

	SeqExpr(
		if_expr(
			sort_take_left(
				source_name,
				list_type,
				element_type,
				key_list_type,
				key_type,
				descending,
			),
			move_left,
			move_right,
			VoidType,
		),
		assignment(
			"__out",
			binary(
				AddOp,
				variable("__out", INT_TYPE),
				int_literal(1),
				INT_TYPE,
			),
		),
	)


private pure func sort_drain(
	source_name: String,
	destination_name: String,
	index_name: String,
	end_name: String,
) -> CoreExpr:
	while_expr(
		binary(
			LessOp,
			variable(index_name, INT_TYPE),
			variable(end_name, INT_TYPE),
			BOOL_TYPE,
		),
		SeqExpr(
			move_sort_index(
				source_name,
				destination_name,
				variable(index_name, INT_TYPE),
			),
			SeqExpr(
				assignment(
					index_name,
					binary(
						AddOp,
						variable(index_name, INT_TYPE),
						int_literal(1),
						INT_TYPE,
					),
				),
				assignment(
					"__out",
					binary(
						AddOp,
						variable("__out", INT_TYPE),
						int_literal(1),
						INT_TYPE,
					),
				),
			),
		),
	)


private pure func sort_merge_run(
	source_name: String,
	destination_name: String,
	list_type: CoreType,
	element_type: CoreType,
	key_list_type: Option[CoreType],
	key_type: CoreType,
	descending: Bool,
) -> CoreExpr:
	immutable_let(
		"__mid",
		INT_TYPE,
		min_int(
			binary(
				AddOp,
				variable("__left", INT_TYPE),
				variable("__width", INT_TYPE),
				INT_TYPE,
			),
			variable("__n", INT_TYPE),
		),
		immutable_let(
			"__right",
			INT_TYPE,
			min_int(
				binary(
					AddOp,
					variable("__left", INT_TYPE),
					binary(
						MultiplyOp,
						variable("__width", INT_TYPE),
						int_literal(2),
						INT_TYPE,
					),
					INT_TYPE,
				),
				variable("__n", INT_TYPE),
			),
			mutable_let(
				"__i",
				INT_TYPE,
				variable("__left", INT_TYPE),
				mutable_let(
					"__j",
					INT_TYPE,
					variable("__mid", INT_TYPE),
					mutable_let(
						"__out",
						INT_TYPE,
						variable("__left", INT_TYPE),
						SeqExpr(
							while_expr(
								logical_and(
									binary(
										LessOp,
										variable("__i", INT_TYPE),
										variable("__mid", INT_TYPE),
										BOOL_TYPE,
									),
									binary(
										LessOp,
										variable("__j", INT_TYPE),
										variable("__right", INT_TYPE),
										BOOL_TYPE,
									),
								),
								sort_merge_step(
									source_name,
									destination_name,
									list_type,
									element_type,
									key_list_type,
									key_type,
									descending,
								),
							),
							SeqExpr(
								sort_drain(source_name, destination_name, "__i", "__mid"),
								SeqExpr(
									sort_drain(source_name, destination_name, "__j", "__right"),
									assignment(
										"__left",
										binary(
											AddOp,
											variable("__left", INT_TYPE),
											binary(
												MultiplyOp,
												variable("__width", INT_TYPE),
												int_literal(2),
												INT_TYPE,
											),
											INT_TYPE,
										),
									),
								),
							),
						),
					),
				),
			),
		),
	)


private pure func sort_merge_pass(
	source_name: String,
	destination_name: String,
	list_type: CoreType,
	element_type: CoreType,
	key_list_type: Option[CoreType],
	key_type: CoreType,
	descending: Bool,
) -> CoreExpr:
	mutable_let(
		"__left",
		INT_TYPE,
		int_literal(0),
		SeqExpr(
			while_expr(
				binary(
					LessOp,
					variable("__left", INT_TYPE),
					variable("__n", INT_TYPE),
					BOOL_TYPE,
				),
				sort_merge_run(
					source_name,
					destination_name,
					list_type,
					element_type,
					key_list_type,
					key_type,
					descending,
				),
			),
			SeqExpr(
				intrinsic_call(
					"list_set_len",
					[variable(
							destination_name,
							NamedType("List", [INT_TYPE]),
						), variable("__n", INT_TYPE)],
					VoidType,
				),
				SeqExpr(
					assignment(
						"__from_a",
						if_expr(
							variable("__from_a", BOOL_TYPE),
							bool_literal(False),
							bool_literal(True),
							BOOL_TYPE,
						),
					),
					assignment(
						"__width",
						binary(
							MultiplyOp,
							variable("__width", INT_TYPE),
							int_literal(2),
							INT_TYPE,
						),
					),
				),
			),
		),
	)


private pure func sort_fill_result(
	source_name: String,
	list_type: CoreType,
	element_type: CoreType,
) -> CoreExpr:
	immutable_let(
		"__sorted_index",
		INT_TYPE,
		sort_index_value(
			source_name,
			variable("__i", INT_TYPE),
		),
		copy_borrowed_to(
			"__result",
			list_type,
			element_type,
			variable("__self", list_type),
			variable("__sorted_index", INT_TYPE),
			variable("__i", INT_TYPE),
		),
	)


private pure func sort_body(
	list_type: CoreType,
	element_type: CoreType,
	key_list_type: Option[CoreType],
	key_type: CoreType,
	descending: Bool,
) -> CoreExpr:
	sort_loop: CoreExpr = while_expr(
		binary(
			LessOp,
			variable("__width", INT_TYPE),
			variable("__n", INT_TYPE),
			BOOL_TYPE,
		),
		if_expr(
			variable("__from_a", BOOL_TYPE),
			sort_merge_pass(
				"__indexes_a",
				"__indexes_b",
				list_type,
				element_type,
				key_list_type,
				key_type,
				descending,
			),
			sort_merge_pass(
				"__indexes_b",
				"__indexes_a",
				list_type,
				element_type,
				key_list_type,
				key_type,
				descending,
			),
			VoidType,
		),
	)
	finish: CoreExpr = immutable_let(
		"__result",
		list_type,
		intrinsic_call(
			"list_alloc",
			[variable("__n", INT_TYPE)],
			list_type,
		),
		SeqExpr(
			if_expr(
				variable("__from_a", BOOL_TYPE),
				for_range(
					"__i",
					int_literal(0),
					variable("__n", INT_TYPE),
					sort_fill_result("__indexes_a", list_type, element_type),
				),
				for_range(
					"__i",
					int_literal(0),
					variable("__n", INT_TYPE),
					sort_fill_result("__indexes_b", list_type, element_type),
				),
				VoidType,
			),
			SeqExpr(
				intrinsic_call(
					"list_set_len",
					[variable("__result", list_type), variable("__n", INT_TYPE)],
					VoidType,
				),
				variable(
					"__result",
					list_type,
				),
			),
		),
	)

	mutable_let(
		"__width",
		INT_TYPE,
		int_literal(1),
		mutable_let(
			"__from_a",
			BOOL_TYPE,
			bool_literal(True),
			SeqExpr(sort_loop, finish),
		),
	)


private pure func synthesize_sort(
	list_type: CoreType,
	element_type: CoreType,
	self: CoreExpr,
	callback: Option[CoreExpr],
	key_type: CoreType,
	descending: Bool,
) -> CoreExpr:
	index_list_type: CoreType = NamedType("List", [INT_TYPE])

	key_list_type: Option[CoreType] = match callback:
		Some(_):
			Some(NamedType("List", [key_type]))
		None:
			None

	preload_index: CoreExpr = intrinsic_call(
		"list_set",
		[
			variable("__indexes_a", index_list_type),
			variable("__i", INT_TYPE),
			variable("__i", INT_TYPE),
		],
		VoidType,
	)

	preload: CoreExpr = match callback:
		Some(function_value):
			keys_type: CoreType = NamedType("List", [key_type])
			immutable_let(
				"__elem",
				element_type,
				list_value(
					variable("__self", list_type),
					variable("__i", INT_TYPE),
					element_type,
				),
				immutable_let(
					"__key",
					key_type,
					closure_call(
						variable("__callback", core_expr_type(function_value)),
						[variable("__elem", element_type)],
						key_type,
					),
					SeqExpr(
						preload_index,
						intrinsic_call(
							"list_set_owned",
							[
								variable("__keys", keys_type),
								variable("__i", INT_TYPE),
								variable("__key", key_type),
							],
							VoidType,
						),
					),
				),
			)
		None:
			preload_index

	initialize_lengths: CoreExpr = match key_list_type:
		Some(keys_type):
			SeqExpr(
				intrinsic_call(
					"list_set_len",
					[variable("__keys", keys_type), variable("__n", INT_TYPE)],
					VoidType,
				),
				intrinsic_call(
					"list_set_len",
					[variable("__indexes_a", index_list_type), variable("__n", INT_TYPE)],
					VoidType,
				),
			)
		None:
			intrinsic_call(
				"list_set_len",
				[variable("__indexes_a", index_list_type), variable("__n", INT_TYPE)],
				VoidType,
			)

	base_body: CoreExpr = sort_body(list_type, element_type, key_list_type, key_type, descending)

	with_preload: CoreExpr = match key_list_type:
		Some(keys_type):
			mutable_let(
				"__keys",
				keys_type,
				intrinsic_call("list_alloc", [variable("__n", INT_TYPE)], keys_type),
				SeqExpr(
					for_range(
						"__i",
						int_literal(0),
						variable("__n", INT_TYPE),
						preload,
					),
					SeqExpr(initialize_lengths, base_body),
				),
			)
		None:
			SeqExpr(
				for_range(
					"__i",
					int_literal(0),
					variable("__n", INT_TYPE),
					preload,
				),
				SeqExpr(initialize_lengths, base_body),
			)

	with_callback: CoreExpr = match callback:
		Some(function_value):
			immutable_let(
				"__callback",
				core_expr_type(function_value),
				function_value,
				with_preload,
			)
		None:
			with_preload

	borrow_let(
		"__self",
		list_type,
		self,
		immutable_let(
			"__n",
			INT_TYPE,
			intrinsic_call("list_len", [variable("__self", list_type)], INT_TYPE),
			mutable_let(
				"__indexes_a",
				index_list_type,
				intrinsic_call("list_alloc", [variable("__n", INT_TYPE)], index_list_type),
				mutable_let(
					"__indexes_b",
					index_list_type,
					intrinsic_call("list_alloc", [variable("__n", INT_TYPE)], index_list_type),
					with_callback,
				),
			),
		),
	)


private pure func concurrent_result_ok_type(typ: CoreType) -> Option[CoreType]:
	list_element ?= list_element_type(typ)

	match list_element:
		NamedType(name, args):
			match args:
				[ok_type, error_type]:
					if name == "Result" and (core_mono_type_equal(
						error_type,
						NamedType("ConcurrencyError", []),
					) or core_mono_type_equal(error_type, UnionType("ConcurrencyError"))):
						Some(ok_type)
					else:
						None
				_:
					None
		_:
			None


private pure func tuple_pair_types(typ: CoreType) -> Option[(CoreType, CoreType)]:
	match typ:
		TupleType(elements):
			match elements:
				[first, second]:
					Some((first, second))
				_:
					None
		_:
			None


private pure func synthesize_named_body(
	name: String,
	params: List[CoreParam],
	return_type: CoreType,
) -> Option[CoreExpr]:
	if not all_types_concrete(params, return_type):
		None
	else if name == "parallel" and params.length() == 2:
		self_param ?= params.get(0)
		body_param ?= params.get(1)
		element_type ?= list_element_type(self_param.typ)
		result_element_type ?= list_element_type(return_type)

		if function_matches(
			body_param.typ,
			[NamedType("ParallelList", [element_type])],
			NamedType("ParallelList", [result_element_type]),
		):
			Some(synthesize_parallel(self_param, body_param, element_type, return_type))
		else:
			None
	else if name == "length" and params.length() == 1:
		self_param ?= params.get(0)
		element_type ?= list_element_type(self_param.typ)

		if type_is_concrete(element_type) and core_mono_type_equal(return_type, INT_TYPE):
			Some(intrinsic_call("list_len", [parameter_value(self_param)], INT_TYPE))
		else:
			None
	else if name == "append" and params.length() == 2:
		self_param ?= params.get(0)
		element_param ?= params.get(1)
		element_type ?= list_element_type(self_param.typ)

		if (
			core_mono_type_equal(element_param.typ, element_type)
			and core_mono_type_equal(return_type, self_param.typ)
		):
			Some(
				synthesize_append(
					self_param.typ,
					parameter_value(self_param),
					parameter_value(element_param),
				),
			)
		else:
			None
	else if name == "get" and params.length() == 2:
		self_param ?= params.get(0)
		index_param ?= params.get(1)
		element_type ?= list_element_type(self_param.typ)
		option_type ?= option_element_type(return_type)

		if (
			core_mono_type_equal(index_param.typ, INT_TYPE)
			and core_mono_type_equal(option_type, element_type)
		):
			Some(
				synthesize_get(
					element_type,
					parameter_value(self_param),
					parameter_value(index_param),
					return_type,
				),
			)
		else:
			None
	else if name == "__unsafe_list_set_index" and params.length() == 3:
		self_param ?= params.get(0)
		index_param ?= params.get(1)
		element_param ?= params.get(2)
		element_type ?= list_element_type(self_param.typ)

		if (
			core_mono_type_equal(index_param.typ, INT_TYPE)
			and core_mono_type_equal(element_param.typ, element_type)
			and core_mono_type_equal(return_type, self_param.typ)
		):
			Some(
				synthesize_set_index(
					self_param.typ,
					parameter_value(self_param),
					parameter_value(index_param),
					parameter_value(element_param),
				),
			)
		else:
			None
	else if name == "get_or" and params.length() == 3:
		self_param ?= params.get(0)
		index_param ?= params.get(1)
		default_param ?= params.get(2)
		element_type ?= list_element_type(self_param.typ)

		if (
			core_mono_type_equal(index_param.typ, INT_TYPE)
			and core_mono_type_equal(default_param.typ, element_type)
			and core_mono_type_equal(return_type, element_type)
		):
			Some(
				synthesize_get_or(
					element_type,
					parameter_value(self_param),
					parameter_value(index_param),
					parameter_value(default_param),
				),
			)
		else:
			None
	else if name == "set" and params.length() == 3:
		self_param ?= params.get(0)
		index_param ?= params.get(1)
		element_param ?= params.get(2)
		element_type ?= list_element_type(self_param.typ)

		if (
			core_mono_type_equal(index_param.typ, INT_TYPE)
			and core_mono_type_equal(element_param.typ, element_type)
			and core_mono_type_equal(return_type, self_param.typ)
		):
			Some(
				synthesize_set(
					self_param.typ,
					parameter_value(self_param),
					parameter_value(index_param),
					parameter_value(element_param),
				),
			)
		else:
			None
	else if name == "__unsafe_list_swap" and params.length() == 3:
		self_param ?= params.get(0)
		left_param ?= params.get(1)
		right_param ?= params.get(2)
		element_type ?= list_element_type(self_param.typ)

		if (
			type_is_concrete(element_type)
			and core_mono_type_equal(left_param.typ, INT_TYPE)
			and core_mono_type_equal(right_param.typ, INT_TYPE)
			and core_mono_type_equal(return_type, self_param.typ)
		):
			Some(
				synthesize_swap(
					self_param.typ,
					parameter_value(self_param),
					parameter_value(left_param),
					parameter_value(right_param),
				),
			)
		else:
			None
	else if name == "__unsafe_list_remove" and params.length() == 2:
		self_param ?= params.get(0)
		index_param ?= params.get(1)
		element_type ?= list_element_type(self_param.typ)

		if (
			type_is_concrete(element_type)
			and core_mono_type_equal(index_param.typ, INT_TYPE)
			and core_mono_type_equal(return_type, self_param.typ)
		):
			Some(
				synthesize_remove(
					self_param.typ,
					parameter_value(self_param),
					parameter_value(index_param),
				),
			)
		else:
			None
	else if name == "__unsafe_list_insert" and params.length() == 3:
		self_param ?= params.get(0)
		index_param ?= params.get(1)
		element_param ?= params.get(2)
		element_type ?= list_element_type(self_param.typ)

		if (
			core_mono_type_equal(index_param.typ, INT_TYPE)
			and core_mono_type_equal(element_param.typ, element_type)
			and core_mono_type_equal(return_type, self_param.typ)
		):
			Some(
				synthesize_insert(
					self_param.typ,
					parameter_value(self_param),
					parameter_value(index_param),
					parameter_value(element_param),
				),
			)
		else:
			None
	else if name == "__unsafe_list_tail" and params.length() == 1:
		self_param ?= params.get(0)
		element_type ?= list_element_type(self_param.typ)

		if type_is_concrete(element_type) and core_mono_type_equal(return_type, self_param.typ):
			Some(synthesize_tail(self_param.typ, parameter_value(self_param)))
		else:
			None
	else if name == "reverse" and params.length() == 1:
		self_param ?= params.get(0)
		element_type ?= list_element_type(self_param.typ)

		if type_is_concrete(element_type) and core_mono_type_equal(return_type, self_param.typ):
			Some(intrinsic_call("list_reverse_owned", [parameter_value(self_param)], return_type))
		else:
			None
	else if name == "concat" and params.length() == 2:
		left_param ?= params.get(0)
		right_param ?= params.get(1)
		element_type ?= list_element_type(left_param.typ)

		if (
			type_is_concrete(element_type)
			and core_mono_type_equal(right_param.typ, left_param.typ)
			and core_mono_type_equal(return_type, left_param.typ)
		):
			Some(
				synthesize_concat(
					left_param.typ,
					parameter_value(left_param),
					parameter_value(right_param),
				),
			)
		else:
			None
	else if (name == "take" or name == "drop") and params.length() == 2:
		self_param ?= params.get(0)
		count_param ?= params.get(1)
		element_type ?= list_element_type(self_param.typ)

		if (
			not core_mono_type_equal(count_param.typ, INT_TYPE)
			or not core_mono_type_equal(return_type, self_param.typ)
		):
			None
		else if name == "take":
			Some(
				synthesize_take(
					self_param.typ,
					element_type,
					parameter_value(self_param),
					parameter_value(count_param),
				),
			)
		else:
			Some(
				synthesize_drop(
					self_param.typ,
					element_type,
					parameter_value(self_param),
					parameter_value(count_param),
				),
			)
	else if name == "flatten" and params.length() == 1:
		self_param ?= params.get(0)
		inner_type ?= list_element_type(self_param.typ)
		element_type ?= list_element_type(inner_type)

		if core_mono_type_equal(return_type, inner_type):
			Some(
				synthesize_flatten(
					self_param.typ,
					inner_type,
					element_type,
					return_type,
					parameter_value(self_param),
				),
			)
		else:
			None
	else if name == "map" and params.length() == 2:
		self_param ?= params.get(0)
		callback_param ?= params.get(1)
		element_type ?= list_element_type(self_param.typ)
		result_element_type ?= list_element_type(return_type)

		if function_matches(callback_param.typ, [element_type], result_element_type):
			Some(
				synthesize_map(
					self_param.typ,
					element_type,
					return_type,
					result_element_type,
					parameter_value(self_param),
					parameter_value(callback_param),
					False,
				),
			)
		else:
			None
	else if (
		name == "concurrent" and params.length() == 3
		or name == "__concurrent_timeout_ms" and params.length() == 4
	):
		self_param ?= params.get(0)
		limit_param ?= params.get(1)
		element_type ?= list_element_type(self_param.typ)
		result_element_type ?= concurrent_result_ok_type(return_type)

		callback_index: Int = if name == "concurrent":
			2
		else:
			3

		callback_param ?= params.get(callback_index)

		timeout: Option[CoreExpr] = if name == "__concurrent_timeout_ms":
			timeout_param ?= params.get(2)

			if core_mono_type_equal(timeout_param.typ, INT_TYPE):
				Some(parameter_value(timeout_param))
			else:
				None
		else:
			None

		if (
			core_mono_type_equal(limit_param.typ, INT_TYPE)
			and (name == "concurrent" or timeout.is_some())
			and function_matches(callback_param.typ, [element_type], result_element_type)
		):
			Some(
				synthesize_concurrent(
					element_type,
					return_type,
					result_element_type,
					parameter_value(self_param),
					parameter_value(limit_param),
					timeout,
					parameter_value(callback_param),
				),
			)
		else:
			None
	else if name == "map_indexed" and params.length() == 2:
		self_param ?= params.get(0)
		callback_param ?= params.get(1)
		element_type ?= list_element_type(self_param.typ)
		result_element_type ?= list_element_type(return_type)

		if (
			function_matches(
				callback_param.typ,
				[INT_TYPE, element_type],
				result_element_type,
			)
		):
			Some(
				synthesize_map(
					self_param.typ,
					element_type,
					return_type,
					result_element_type,
					parameter_value(self_param),
					parameter_value(callback_param),
					True,
				),
			)
		else:
			None
	else if (
		(name == "filter" or name == "take_while" or name == "drop_while")
		and params.length() == 2
	):
		self_param ?= params.get(0)
		predicate_param ?= params.get(1)
		element_type ?= list_element_type(self_param.typ)

		if (
			not core_mono_type_equal(return_type, self_param.typ)
			or not function_matches(predicate_param.typ, [element_type], BOOL_TYPE)
		):
			None
		else if name == "drop_while":
			Some(
				synthesize_drop_while(
					self_param.typ,
					element_type,
					parameter_value(self_param),
					parameter_value(predicate_param),
				),
			)
		else:
			Some(
				synthesize_filter_like(
					self_param.typ,
					element_type,
					parameter_value(self_param),
					parameter_value(predicate_param),
					name == "take_while",
				),
			)
	else if name == "partition" and params.length() == 2:
		self_param ?= params.get(0)
		predicate_param ?= params.get(1)
		element_type ?= list_element_type(self_param.typ)
		return_parts ?= tuple_pair_types(return_type)

		if (
			core_mono_type_equal(return_parts[0], self_param.typ)
			and core_mono_type_equal(return_parts[1], self_param.typ)
			and function_matches(predicate_param.typ, [element_type], BOOL_TYPE)
		):
			Some(
				synthesize_partition(
					self_param.typ,
					element_type,
					return_type,
					parameter_value(self_param),
					parameter_value(predicate_param),
				),
			)
		else:
			None
	else if name == "flat_map" and params.length() == 2:
		self_param ?= params.get(0)
		callback_param ?= params.get(1)
		element_type ?= list_element_type(self_param.typ)
		result_element_type ?= list_element_type(return_type)

		if function_matches(callback_param.typ, [element_type], return_type):
			Some(
				synthesize_flat_map(
					self_param.typ,
					element_type,
					return_type,
					result_element_type,
					parameter_value(self_param),
					parameter_value(callback_param),
				),
			)
		else:
			None
	else if name == "filter_map" and params.length() == 2:
		self_param ?= params.get(0)
		callback_param ?= params.get(1)
		element_type ?= list_element_type(self_param.typ)
		result_element_type ?= list_element_type(return_type)
		callback_return ?= function_return_type(callback_param.typ)
		option_type ?= option_element_type(callback_return)

		if (
			core_mono_type_equal(option_type, result_element_type)
			and function_matches(callback_param.typ, [element_type], callback_return)
		):
			Some(
				synthesize_filter_map(
					self_param.typ,
					element_type,
					return_type,
					result_element_type,
					callback_return,
					parameter_value(self_param),
					parameter_value(callback_param),
				),
			)
		else:
			None
	else if (name == "fold_left" or name == "fold_right") and params.length() == 3:
		self_param ?= params.get(0)
		initial_param ?= params.get(1)
		callback_param ?= params.get(2)
		element_type ?= list_element_type(self_param.typ)

		expected_callback_params: List[CoreType] = if name == "fold_right":
			[element_type, initial_param.typ]
		else:
			[initial_param.typ, element_type]

		if (
			core_mono_type_equal(return_type, initial_param.typ)
			and function_matches(callback_param.typ, expected_callback_params, initial_param.typ)
		):
			Some(
				synthesize_fold(
					self_param.typ,
					element_type,
					initial_param.typ,
					parameter_value(self_param),
					parameter_value(initial_param),
					parameter_value(callback_param),
					name == "fold_right",
				),
			)
		else:
			None
	else if (name == "all" or name == "any") and params.length() == 2:
		self_param ?= params.get(0)
		predicate_param ?= params.get(1)
		element_type ?= list_element_type(self_param.typ)

		if (
			core_mono_type_equal(return_type, BOOL_TYPE)
			and function_matches(predicate_param.typ, [element_type], BOOL_TYPE)
		):
			Some(
				synthesize_all_or_any(
					self_param.typ,
					element_type,
					parameter_value(self_param),
					parameter_value(predicate_param),
					name == "all",
				),
			)
		else:
			None
	else if name == "count" and params.length() == 2:
		self_param ?= params.get(0)
		predicate_param ?= params.get(1)
		element_type ?= list_element_type(self_param.typ)

		if (
			core_mono_type_equal(return_type, INT_TYPE)
			and function_matches(predicate_param.typ, [element_type], BOOL_TYPE)
		):
			Some(
				synthesize_count(
					self_param.typ,
					element_type,
					parameter_value(self_param),
					parameter_value(predicate_param),
				),
			)
		else:
			None
	else if name == "for_each" and params.length() == 2:
		self_param ?= params.get(0)
		callback_param ?= params.get(1)
		element_type ?= list_element_type(self_param.typ)

		if (
			core_mono_type_equal(return_type, VoidType)
			and function_matches(callback_param.typ, [element_type], VoidType)
		):
			Some(
				synthesize_for_each(
					self_param.typ,
					element_type,
					parameter_value(self_param),
					parameter_value(callback_param),
				),
			)
		else:
			None
	else if (name == "find_index" or name == "find") and params.length() == 2:
		self_param ?= params.get(0)
		predicate_param ?= params.get(1)
		element_type ?= list_element_type(self_param.typ)
		option_type ?= option_element_type(return_type)

		if not function_matches(predicate_param.typ, [element_type], BOOL_TYPE):
			None
		else if name == "find_index" and core_mono_type_equal(option_type, INT_TYPE):
			Some(
				synthesize_find_index(
					self_param.typ,
					element_type,
					return_type,
					parameter_value(self_param),
					parameter_value(predicate_param),
				),
			)
		else if name == "find" and core_mono_type_equal(option_type, element_type):
			Some(
				synthesize_find(
					self_param.typ,
					element_type,
					return_type,
					parameter_value(self_param),
					parameter_value(predicate_param),
				),
			)
		else:
			None
	else if (
		name == "binary_search" and params.length() == 2
		or name == "binary_search_by" and params.length() == 3
	):
		self_param ?= params.get(0)
		target_param ?= params.get(1)
		element_type ?= list_element_type(self_param.typ)
		option_type ?= option_element_type(return_type)

		comparator: Option[CoreExpr] = if name == "binary_search_by":
			comparator_param ?= params.get(2)

			if (
				function_matches(
					comparator_param.typ,
					[element_type, element_type],
					INT_TYPE,
				)
			):
				Some(parameter_value(comparator_param))
			else:
				None
		else:
			None

		if (
			not core_mono_type_equal(target_param.typ, element_type)
			or not core_mono_type_equal(option_type, INT_TYPE)
		):
			None
		else if name == "binary_search_by" and comparator.is_none():
			None
		else:
			Some(
				synthesize_binary_search(
					self_param.typ,
					element_type,
					return_type,
					parameter_value(self_param),
					parameter_value(target_param),
					comparator,
				),
			)
	else if (name == "min_by" or name == "max_by") and params.length() == 2:
		self_param ?= params.get(0)
		callback_param ?= params.get(1)
		element_type ?= list_element_type(self_param.typ)
		option_type ?= option_element_type(return_type)
		key_type ?= function_return_type(callback_param.typ)

		if (
			core_mono_type_equal(option_type, element_type)
			and function_matches(callback_param.typ, [element_type], key_type)
		):
			Some(
				synthesize_min_max_by(
					self_param.typ,
					element_type,
					key_type,
					return_type,
					parameter_value(self_param),
					parameter_value(callback_param),
					name == "max_by",
				),
			)
		else:
			None
	else if name == "sort" and params.length() == 1:
		self_param ?= params.get(0)
		element_type ?= list_element_type(self_param.typ)

		if core_mono_type_equal(return_type, self_param.typ):
			Some(
				synthesize_sort(
					self_param.typ,
					element_type,
					parameter_value(self_param),
					None,
					element_type,
					False,
				),
			)
		else:
			None
	else if (name == "sort_by" or name == "sort_desc_by") and params.length() == 2:
		self_param ?= params.get(0)
		callback_param ?= params.get(1)
		element_type ?= list_element_type(self_param.typ)
		key_type ?= function_return_type(callback_param.typ)

		if (
			core_mono_type_equal(return_type, self_param.typ)
			and function_matches(callback_param.typ, [element_type], key_type)
		):
			Some(
				synthesize_sort(
					self_param.typ,
					element_type,
					parameter_value(self_param),
					Some(parameter_value(callback_param)),
					key_type,
					name == "sort_desc_by",
				),
			)
		else:
			None
	else if name == "scan" and params.length() == 3:
		self_param ?= params.get(0)
		initial_param ?= params.get(1)
		callback_param ?= params.get(2)
		element_type ?= list_element_type(self_param.typ)
		result_element_type ?= list_element_type(return_type)

		if (
			core_mono_type_equal(initial_param.typ, result_element_type)
			and function_matches(
				callback_param.typ,
				[result_element_type, element_type],
				result_element_type,
			)
		):
			Some(
				synthesize_scan(
					self_param.typ,
					element_type,
					return_type,
					result_element_type,
					parameter_value(self_param),
					parameter_value(initial_param),
					parameter_value(callback_param),
				),
			)
		else:
			None
	else if name == "enumerate" and params.length() == 1:
		self_param ?= params.get(0)
		element_type ?= list_element_type(self_param.typ)
		pair_type ?= list_element_type(return_type)
		pair_parts ?= tuple_pair_types(pair_type)

		if (
			core_mono_type_equal(pair_parts[0], INT_TYPE)
			and core_mono_type_equal(pair_parts[1], element_type)
		):
			Some(
				synthesize_enumerate(
					self_param.typ,
					element_type,
					return_type,
					pair_type,
					parameter_value(self_param),
				),
			)
		else:
			None
	else if (
		(name == "zip" or name == "zip_with")
		and (name == "zip" and params.length() == 2 or name == "zip_with" and params.length() == 3)
	):
		left_param ?= params.get(0)
		right_param ?= params.get(1)
		left_element_type ?= list_element_type(left_param.typ)
		right_element_type ?= list_element_type(right_param.typ)
		result_element_type ?= list_element_type(return_type)

		if name == "zip":
			pair_parts ?= tuple_pair_types(result_element_type)

			if (
				core_mono_type_equal(pair_parts[0], left_element_type)
				and core_mono_type_equal(pair_parts[1], right_element_type)
			):
				Some(
					synthesize_zip(
						left_param.typ,
						left_element_type,
						right_param.typ,
						right_element_type,
						return_type,
						result_element_type,
						parameter_value(left_param),
						parameter_value(right_param),
						None,
					),
				)
			else:
				None
		else:
			callback_param ?= params.get(2)

			if (
				function_matches(
					callback_param.typ,
					[left_element_type, right_element_type],
					result_element_type,
				)
			):
				Some(
					synthesize_zip(
						left_param.typ,
						left_element_type,
						right_param.typ,
						right_element_type,
						return_type,
						result_element_type,
						parameter_value(left_param),
						parameter_value(right_param),
						Some(parameter_value(callback_param)),
					),
				)
			else:
				None
	else if name == "unzip" and params.length() == 1:
		self_param ?= params.get(0)
		pair_type ?= list_element_type(self_param.typ)
		pair_parts ?= tuple_pair_types(pair_type)
		return_parts ?= tuple_pair_types(return_type)
		first_element_type ?= list_element_type(return_parts[0])
		second_element_type ?= list_element_type(return_parts[1])

		if (
			core_mono_type_equal(first_element_type, pair_parts[0])
			and core_mono_type_equal(second_element_type, pair_parts[1])
		):
			Some(
				synthesize_unzip(
					self_param.typ,
					pair_type,
					pair_parts[0],
					pair_parts[1],
					return_parts[0],
					return_parts[1],
					return_type,
					parameter_value(self_param),
				),
			)
		else:
			None
	else if name == "repeat" and params.length() == 2:
		element_param ?= params.get(0)
		count_param ?= params.get(1)
		element_type ?= list_element_type(return_type)

		if (
			core_mono_type_equal(element_param.typ, element_type)
			and core_mono_type_equal(count_param.typ, INT_TYPE)
		):
			Some(
				synthesize_repeat(
					return_type,
					element_type,
					parameter_value(element_param),
					parameter_value(count_param),
				),
			)
		else:
			None
	else if name == "intersperse" and params.length() == 2:
		self_param ?= params.get(0)
		separator_param ?= params.get(1)
		element_type ?= list_element_type(self_param.typ)

		if (
			core_mono_type_equal(separator_param.typ, element_type)
			and core_mono_type_equal(return_type, self_param.typ)
		):
			Some(
				synthesize_intersperse(
					self_param.typ,
					element_type,
					parameter_value(self_param),
					parameter_value(separator_param),
				),
			)
		else:
			None
	else if (name == "windows" or name == "chunks") and params.length() == 2:
		self_param ?= params.get(0)
		count_param ?= params.get(1)
		element_type ?= list_element_type(self_param.typ)
		inner_type ?= list_element_type(return_type)

		if (
			not core_mono_type_equal(count_param.typ, INT_TYPE)
			or not core_mono_type_equal(inner_type, self_param.typ)
		):
			None
		else if name == "windows":
			Some(
				synthesize_windows(
					self_param.typ,
					element_type,
					return_type,
					inner_type,
					parameter_value(self_param),
					parameter_value(count_param),
				),
			)
		else:
			Some(
				synthesize_chunks(
					self_param.typ,
					element_type,
					return_type,
					inner_type,
					parameter_value(self_param),
					parameter_value(count_param),
				),
			)
	else if name == "range" and params.length() == 2:
		start_param ?= params.get(0)
		stop_param ?= params.get(1)

		if (
			core_mono_type_equal(start_param.typ, INT_TYPE)
			and core_mono_type_equal(stop_param.typ, INT_TYPE)
			and core_mono_type_equal(
				return_type,
				NamedType("List", [INT_TYPE]),
			)
		):
			Some(synthesize_range(parameter_value(start_param), parameter_value(stop_param)))
		else:
			None
	else if name == "unique" and params.length() == 1:
		self_param ?= params.get(0)
		element_type ?= list_element_type(self_param.typ)

		if core_mono_type_equal(return_type, self_param.typ):
			Some(synthesize_unique(self_param.typ, element_type, parameter_value(self_param)))
		else:
			None
	else if name == "string_append" and params.length() == 2:
		self_param ?= params.get(0)
		other_param ?= params.get(1)

		if (
			core_mono_type_equal(self_param.typ, STRING_TYPE)
			and core_mono_type_equal(other_param.typ, STRING_TYPE)
			and core_mono_type_equal(return_type, STRING_TYPE)
		):
			Some(
				synthesize_string_append(
					parameter_value(self_param),
					parameter_value(other_param),
				),
			)
		else:
			None
	else:
		None


pure func synthesize_list_body(function_info: CoreFunction) -> Option[CoreExpr]:
	if (
		not is_synthesis_candidate(function_info)
		or function_info.source_module != Some(LIST_MODULE)
	):
		None
	else:
		name ?= synthesis_source_name(function_info)
		synthesize_named_body(name, function_info.params, function_info.return_type)
