private pure func synthesize_find(
	list_type: CoreType,
	element_type: CoreType,
	return_type: CoreType,
	self: CoreExpr,
	predicate: CoreExpr,
) -> CoreExpr:
	found: CoreExpr = SeqExpr(
		assignment(
			"__result",
			option_some(
				variable("__elem", element_type),
				return_type,
			),
		),
		BREAK_EXPR,
	)
	loop_body: CoreExpr = immutable_let(
		"__elem",
		element_type,
		list_value(
			variable("__self", list_type),
			variable("__i", INT_TYPE),
			element_type,
		),
		if_expr(
			closure_call(
				variable("__predicate", core_expr_type(predicate)),
				[variable("__elem", element_type)],
				BOOL_TYPE,
			),
			found,
			VOID_EXPR,
			VoidType,
		),
	)

	borrow_let(
		"__self",
		list_type,
		self,
		immutable_let(
			"__predicate",
			core_expr_type(predicate),
			predicate,
			immutable_let(
				"__n",
				INT_TYPE,
				intrinsic_call("list_len", [variable("__self", list_type)], INT_TYPE),
				mutable_let(
					"__result",
					return_type,
					option_none(return_type),
					SeqExpr(
						for_range(
							"__i",
							int_literal(0),
