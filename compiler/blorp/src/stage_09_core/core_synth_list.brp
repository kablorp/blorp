private pure func synthesize_concat(
	list_type: CoreType,
	left: CoreExpr,
	right: CoreExpr,
) -> CoreExpr:
	immutable_let(
		"__left",
		list_type,
		left,
		immutable_let(
			"__right",
			list_type,
			right,
			immutable_let(
				"__left_n",
				INT_TYPE,
				intrinsic_call(
					"list_len",
					[variable("__left", list_type)],
					INT_TYPE,
