				),
				SeqExpr(
					intrinsic_call(
						"list_release_elem",
						[variable("__result", list_type), int_literal(0)],
						VoidType,
					),
					SeqExpr(
						for_range(
							"__i",
							int_literal(1),
							variable(
								"__n",
								INT_TYPE,
							),
							intrinsic_call(
								"list_set",
								[
									variable("__result", list_type),
									binary(
										SubtractOp,
