-- Post-monomorphization Core body synthesis for current std/list builtins.
--
-- Collection ownership, callback calls, bounds policy, and result
-- materialization stay in ordinary Core so the later match, trait, ownership,
-- and reuse stages retain one coherent view of list behavior.
import:
	core_json:
		CoreBinaryOp(
			AddOp,
			DivideOp,
			EqualOp,
			GreaterEqualOp,
			GreaterOp,
			LessEqualOp,
			LessOp,
			MultiplyOp,
			SubtractOp,
		),
		CoreCallKind(ClosureCall, IntrinsicCall, UnknownCall),
		CoreConcurrentlyLoopItemMode(ConcurrentlyLoopCopyItem),
		CoreConcurrentlyLoopOutput(ConcurrentlyLoopCollect),
		CoreExpr(
			AssignExpr,
			BinaryExpr,
			BorrowLetExpr,
			BreakExpr,
			CallExpr,
			ForRangeExpr,
			IfExpr,
			LetExpr,
			LiteralExpr,
			LogicalExpr,
			PreClosureConcurrentlyLoopExpr,
			RawMatchExpr,
			SeqExpr,
			TupleExpr,
			TupleFieldExpr,
			UnboxExpr,
			VarExpr,
			VoidExpr,
			WhileExpr,
		),
		CoreFunction,
		CoreLiteral(BoolLiteral, IntLiteral),
		CoreLogicalOp(AndOp, OrOp),
		CoreLoopBinder,
		CoreLoopRangeDirection(RangeForwardOnly),
		CoreParam,
		CorePattern(ConstructorPattern, NamePattern),
		CorePreClosureConcurrentlyLoop,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(
			BoxedResultType,
			EnumType,
			FunctionType,
			HeapRecordType,
			NamedType,
			RangeType,
			SelfType,
			StackResultType,
			TensorType,
			TupleType,
			TypeParameterType,
			UnionType,
			ValueRecordType,
			VoidType,
		),
		CoreUnboxKind(
			Float16Unbox,
			Float32Unbox,
			FloatUnbox,
			Int128Unbox,
			PointerUnbox,
			PrimUnbox,
			StructUnbox,
			UInt128Unbox,
		),
		CoreVar,
		core_expr_type,
	core_mono: core_mono_type_equal
	core_synth_name: is_synthesis_candidate, synthesis_source_name


private LIST_MODULE: String = "std/list"

private INT_TYPE: CoreType = NamedType("Int", [])

private BOOL_TYPE: CoreType = NamedType("Bool", [])

private STRING_TYPE: CoreType = NamedType("String", [])

private POINTER_TYPE: CoreType = NamedType("Ptr", [])


private pure func core_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


private pure func variable(name: String, typ: CoreType) -> CoreExpr:
	VarExpr(core_var(name), typ, SyntheticSourceLoc)


private pure func parameter_value(param: CoreParam) -> CoreExpr:
	VarExpr(param.name, param.typ, SyntheticSourceLoc)


private pure func int_literal(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), INT_TYPE, SyntheticSourceLoc)


private pure func bool_literal(value: Bool) -> CoreExpr:
	LiteralExpr(BoolLiteral(value), BOOL_TYPE, SyntheticSourceLoc)


private VOID_EXPR: CoreExpr = VoidExpr(VoidType, SyntheticSourceLoc)


private pure func intrinsic_call(
	name: String,
	args: List[CoreExpr],
	return_type: CoreType,
) -> CoreExpr:
	CallExpr(IntrinsicCall(name), VOID_EXPR, args, return_type, SyntheticSourceLoc)


private pure func closure_call(
	callee: CoreExpr,
	args: List[CoreExpr],
	return_type: CoreType,
) -> CoreExpr:
	CallExpr(ClosureCall, callee, args, return_type, SyntheticSourceLoc)


private pure func unknown_call(
	name: String,
	args: List[CoreExpr],
	return_type: CoreType,
) -> CoreExpr:
	CallExpr(
		UnknownCall,
		variable(name, VoidType),
		args,
		return_type,
		SyntheticSourceLoc,
	)


private pure func binary(
	op: CoreBinaryOp,
	left: CoreExpr,
	right: CoreExpr,
	return_type: CoreType,
) -> CoreExpr:
	BinaryExpr(op, left, right, return_type, SyntheticSourceLoc)


private pure func logical_and(left: CoreExpr, right: CoreExpr) -> CoreExpr:
	LogicalExpr(AndOp, left, right, BOOL_TYPE, SyntheticSourceLoc)


private pure func logical_or(left: CoreExpr, right: CoreExpr) -> CoreExpr:
	LogicalExpr(OrOp, left, right, BOOL_TYPE, SyntheticSourceLoc)


private pure func if_expr(
	condition: CoreExpr,
	then_expr: CoreExpr,
	else_expr: CoreExpr,
	return_type: CoreType,
) -> CoreExpr:
	IfExpr(condition, then_expr, else_expr, return_type, SyntheticSourceLoc)


private pure func let_expr(
	name: String,
	is_mutable: Bool,
	typ: CoreType,
	rhs: CoreExpr,
	body: CoreExpr,
) -> CoreExpr:
	LetExpr(core_var(name), is_mutable, typ, rhs, body)


private pure func immutable_let(
	name: String,
	typ: CoreType,
	rhs: CoreExpr,
	body: CoreExpr,
) -> CoreExpr:
	let_expr(name, False, typ, rhs, body)


private pure func mutable_let(
	name: String,
	typ: CoreType,
	rhs: CoreExpr,
	body: CoreExpr,
) -> CoreExpr:
	let_expr(name, True, typ, rhs, body)


private pure func borrow_let(
	name: String,
	typ: CoreType,
	rhs: CoreExpr,
	body: CoreExpr,
) -> CoreExpr:
	BorrowLetExpr(core_var(name), typ, rhs, body)


private pure func assignment(name: String, value: CoreExpr) -> CoreExpr:
	AssignExpr(core_var(name), value, VoidType, SyntheticSourceLoc)


private pure func loop_binder(name: String) -> CoreLoopBinder:
	{
		variable = core_var(name),
		typ = INT_TYPE,
		range_direction = RangeForwardOnly
	}


private pure func for_range(
	name: String,
	start: CoreExpr,
	end_value: CoreExpr,
	body: CoreExpr,
) -> CoreExpr:
	ForRangeExpr(loop_binder(name), start, end_value, body, VoidType, SyntheticSourceLoc)


private pure func while_expr(condition: CoreExpr, body: CoreExpr) -> CoreExpr:
	WhileExpr(condition, body, VoidType, SyntheticSourceLoc)


private BREAK_EXPR: CoreExpr = BreakExpr(VoidType, SyntheticSourceLoc)


private pure func option_none(option_type: CoreType) -> CoreExpr:
	variable("None", option_type)


private pure func option_some(value: CoreExpr, option_type: CoreType) -> CoreExpr:
	unknown_call("Some", [value], option_type)


private pure func type_is_concrete(typ: CoreType) -> Bool:
	match typ:
		TypeParameterType(_) | SelfType:
			False
		NamedType(_, args):
			args.all(type_is_concrete)
		FunctionType(_, params, return_type):
			params.all(type_is_concrete) and type_is_concrete(return_type)
		StackResultType(ok_type, error_type) | BoxedResultType(ok_type, error_type):
			type_is_concrete(ok_type) and type_is_concrete(error_type)
		TensorType(info):
			type_is_concrete(info.element_type)
		TupleType(elements):
			elements.all(type_is_concrete)
		VoidType | EnumType(_) | ValueRecordType(_) | HeapRecordType(_) | UnionType(_) | RangeType:
			True


private pure func list_element_type(typ: CoreType) -> Option[CoreType]:
	match typ:
		NamedType(name, args):
			match args:
				[element_type]:
					if name == "List":
						Some(element_type)
					else:
						None
				_:
					None
		_:
			None


private pure func option_element_type(typ: CoreType) -> Option[CoreType]:
	match typ:
		NamedType(name, args):
			match args:
				[element_type]:
					if name == "Option":
						Some(element_type)
					else:
						None
				_:
					None
		_:
			None


private pure func function_matches(
	typ: CoreType,
	param_types: List[CoreType],
	return_type: CoreType,
) -> Bool:
	match typ:
		FunctionType(_, actual_params, actual_return):
			(
				same_types(actual_params, param_types)
				and core_mono_type_equal(actual_return, return_type)
			)
		_:
			False


private pure func same_types(left: List[CoreType], right: List[CoreType]) -> Bool:
	match left:
		[]:
			right.is_empty()
		[left_head, ...left_tail]:
			match right:
				[right_head, ...right_tail]:
					(
						core_mono_type_equal(left_head, right_head)
						and same_types(left_tail, right_tail)
					)
				[]:
					False


private pure func function_return_type(typ: CoreType) -> Option[CoreType]:
	match typ:
		FunctionType(_, _, return_type):
			Some(return_type)
		_:
			None


private pure func all_types_concrete(params: List[CoreParam], return_type: CoreType) -> Bool:
	type_is_concrete(return_type) and params.all(func(param: CoreParam):
		type_is_concrete(param.typ)
	)


private pure func primitive_integer_type(name: String) -> Bool:
	(
		name == "Int"
		or name == "Int8"
		or name == "Int16"
		or name == "Int32"
		or name == "Int64"
		or name == "UInt8"
		or name == "UInt16"
		or name == "UInt32"
		or name == "UInt64"
		or name == "Bool"
		or name == "Char"
	)


private pure func stack_option_c_type(payload: CoreType) -> Option[String]:
	match payload:
		VoidType:
			Some("blorp_StackOption_Void")
		NamedType(name, args):
			if not args.is_empty():
				None
			else if (
				name == "Int"
				or name == "Int8"
				or name == "Int16"
				or name == "Int32"
				or name == "Int64"
				or name == "UInt8"
				or name == "UInt16"
				or name == "UInt32"
				or name == "UInt64"
				or name == "Float"
				or name == "Float32"
				or name == "Float16"
				or name == "Bool"
				or name == "Char"
				or name == "Int128"
				or name == "UInt128"
			):
				Some("blorp_StackOption_" + name)
			else:
				None
		EnumType(name) | ValueRecordType(name):
			Some("blorp_StackOption_" + name)
		RangeType:
			Some("blorp_StackOption_Range")
		_:
			None


private pure func unbox_kind_for_type(typ: CoreType) -> CoreUnboxKind:
	match typ:
		NamedType(name, args):
			if name == "Float":
				FloatUnbox
			else if name == "Float32":
				Float32Unbox
			else if name == "Float16":
				Float16Unbox
			else if name == "Int128":
				Int128Unbox
			else if name == "UInt128":
				UInt128Unbox
			else if primitive_integer_type(name):
				PrimUnbox
			else if name == "Option":
				match args:
					[payload]:
						match stack_option_c_type(payload):
							Some(c_type):
								StructUnbox(c_type)
							None:
								PointerUnbox
					_:
						PointerUnbox
			else:
				PointerUnbox
		EnumType(_):
			PrimUnbox
		ValueRecordType(name):
			StructUnbox(name)
		StackResultType(_, _):
			StructUnbox("blorp_StackResult")
		VoidType | RangeType:
			PrimUnbox
		_:
			PointerUnbox


private pure func list_value(list: CoreExpr, index: CoreExpr, element_type: CoreType) -> CoreExpr:
	UnboxExpr(
		unbox_kind_for_type(element_type),
		intrinsic_call(
			"list_get",
			[list, index],
			POINTER_TYPE,
		),
		element_type,
		SyntheticSourceLoc,
	)


private pure func unchecked_list_value(
	list: CoreExpr,
	index: CoreExpr,
	element_type: CoreType,
) -> CoreExpr:
	UnboxExpr(
		unbox_kind_for_type(element_type),
		intrinsic_call(
			"list_get_unchecked",
			[list, index],
			POINTER_TYPE,
		),
		element_type,
		SyntheticSourceLoc,
	)


private pure func list_in_bounds(list: CoreExpr, index: CoreExpr) -> CoreExpr:
	logical_and(
		binary(GreaterEqualOp, index, int_literal(0), BOOL_TYPE),
		binary(
			LessOp,
			index,
			intrinsic_call("list_len", [list], INT_TYPE),
			BOOL_TYPE,
		),
	)


private pure func nonnegative_count(value: CoreExpr) -> CoreExpr:
	if_expr(
		binary(LessEqualOp, value, int_literal(0), BOOL_TYPE),
		int_literal(0),
		value,
		INT_TYPE,
	)


private pure func clamp_count_to_length(value: CoreExpr, length: CoreExpr) -> CoreExpr:
	if_expr(
		binary(LessEqualOp, value, int_literal(0), BOOL_TYPE),
		int_literal(0),
		if_expr(
			binary(LessOp, value, length, BOOL_TYPE),
			value,
			length,
			INT_TYPE,
		),
		INT_TYPE,
	)


private pure func min_int(left: CoreExpr, right: CoreExpr) -> CoreExpr:
	if_expr(
		binary(LessOp, left, right, BOOL_TYPE),
		left,
		right,
		INT_TYPE,
	)


private pure func copy_borrowed_to(
	result_name: String,
	result_type: CoreType,
	element_type: CoreType,
	source: CoreExpr,
	source_index: CoreExpr,
	destination_index: CoreExpr,
) -> CoreExpr:
	borrow_let(
		"__copy_elem",
		element_type,
		list_value(
			source,
			source_index,
			element_type,
		),
		SeqExpr(
			intrinsic_call(
				"list_retain_for",
				[variable(result_name, result_type), variable("__copy_elem", element_type)],
				VoidType,
			),
			intrinsic_call(
				"list_set_owned",
				[
					variable(result_name, result_type),
					destination_index,
					variable("__copy_elem", element_type),
				],
				VoidType,
			),
		),
	)


private pure func synthesize_append(
	list_type: CoreType,
	self: CoreExpr,
	element: CoreExpr,
) -> CoreExpr:
	immutable_let(
		"__n",
		INT_TYPE,
		intrinsic_call(
			"list_len",
			[self],
			INT_TYPE,
		),
		immutable_let(
			"__result",
			list_type,
			intrinsic_call(
				"list_ensure_capacity",
				[self, binary(
						AddOp,
						variable("__n", INT_TYPE),
						int_literal(1),
						INT_TYPE,
					)],
				list_type,
			),
			SeqExpr(
				intrinsic_call(
					"list_retain_for",
					[variable("__result", list_type), element],
					VoidType,
				),
				SeqExpr(
					intrinsic_call(
						"list_set",
						[variable("__result", list_type), variable("__n", INT_TYPE), element],
						VoidType,
					),
					SeqExpr(
						intrinsic_call(
							"list_set_len",
							[variable("__result", list_type), binary(
									AddOp,
									variable("__n", INT_TYPE),
									int_literal(1),
									INT_TYPE,
								)],
							VoidType,
						),
						variable(
							"__result",
							list_type,
						),
					),
				),
			),
		),
	)


private pure func synthesize_get(
	element_type: CoreType,
	self: CoreExpr,
	index: CoreExpr,
	return_type: CoreType,
) -> CoreExpr:
	if_expr(
		list_in_bounds(
			self,
			index,
		),
		borrow_let(
			"__elem",
			element_type,
			unchecked_list_value(
				self,
				index,
				element_type,
			),
			SeqExpr(
				intrinsic_call(
					"list_retain_for",
					[self, variable("__elem", element_type)],
					VoidType,
				),
				option_some(
					variable("__elem", element_type),
					return_type,
				),
			),
		),
		option_none(return_type),
		return_type,
	)


private pure func synthesize_get_or(
	element_type: CoreType,
	self: CoreExpr,
	index: CoreExpr,
	default: CoreExpr,
) -> CoreExpr:
	if_expr(
		list_in_bounds(
			self,
			index,
		),
		borrow_let(
			"__elem",
			element_type,
			unchecked_list_value(
				self,
				index,
				element_type,
			),
			SeqExpr(
				intrinsic_call(
					"list_retain_for",
					[self, variable("__elem", element_type)],
					VoidType,
				),
				variable(
					"__elem",
					element_type,
				),
			),
		),
		default,
		element_type,
	)


private pure func synthesize_set_index(
	list_type: CoreType,
	self: CoreExpr,
	index: CoreExpr,
	element: CoreExpr,
) -> CoreExpr:
	immutable_let(
		"__result",
		list_type,
		intrinsic_call(
			"list_ensure_unique",
			[self],
			list_type,
		),
		SeqExpr(
			intrinsic_call(
				"list_release_elem",
				[variable("__result", list_type), index],
				VoidType,
			),
			SeqExpr(
				intrinsic_call(
					"list_retain_for",
					[variable("__result", list_type), element],
					VoidType,
				),
				SeqExpr(
					intrinsic_call(
						"list_set",
						[variable("__result", list_type), index, element],
						VoidType,
					),
					variable(
						"__result",
						list_type,
					),
				),
			),
		),
	)


private pure func synthesize_set(
	list_type: CoreType,
	self: CoreExpr,
	index: CoreExpr,
	element: CoreExpr,
) -> CoreExpr:
	if_expr(
		list_in_bounds(self, index),
		synthesize_set_index(list_type, self, index, element),
		self,
		list_type,
	)


private pure func synthesize_swap(
	list_type: CoreType,
	self: CoreExpr,
	left_index: CoreExpr,
	right_index: CoreExpr,
) -> CoreExpr:
	immutable_let(
		"__result",
		list_type,
		intrinsic_call(
			"list_ensure_unique",
			[self],
			list_type,
		),
		SeqExpr(
			intrinsic_call(
				"list_swap_slots",
				[variable("__result", list_type), left_index, right_index],
				VoidType,
			),
			variable(
				"__result",
				list_type,
			),
		),
	)


private pure func synthesize_remove(
	list_type: CoreType,
	self: CoreExpr,
	index: CoreExpr,
) -> CoreExpr:
	immutable_let(
		"__n",
		INT_TYPE,
		intrinsic_call(
			"list_len",
			[self],
			INT_TYPE,
		),
		immutable_let(
			"__result",
			list_type,
			intrinsic_call(
				"list_ensure_unique",
				[self],
				list_type,
			),
			SeqExpr(
				intrinsic_call(
					"list_release_elem",
					[variable("__result", list_type), index],
					VoidType,
				),
				SeqExpr(
					for_range(
						"__i",
						binary(
							AddOp,
							index,
							int_literal(1),
							INT_TYPE,
						),
						variable(
							"__n",
							INT_TYPE,
						),
						intrinsic_call(
							"list_set",
							[
								variable("__result", list_type),
								binary(
									SubtractOp,
									variable("__i", INT_TYPE),
									int_literal(1),
									INT_TYPE,
								),
								intrinsic_call(
									"list_get",
									[variable("__result", list_type), variable("__i", INT_TYPE)],
									POINTER_TYPE,
								),
							],
							VoidType,
						),
					),
					SeqExpr(
						intrinsic_call(
							"list_set_len",
							[variable("__result", list_type), binary(
									SubtractOp,
									variable("__n", INT_TYPE),
									int_literal(1),
									INT_TYPE,
								)],
							VoidType,
						),
						variable(
							"__result",
							list_type,
						),
					),
				),
			),
		),
	)


private pure func synthesize_insert(
	list_type: CoreType,
	self: CoreExpr,
	index: CoreExpr,
	element: CoreExpr,
) -> CoreExpr:
	immutable_let(
		"__n",
		INT_TYPE,
		intrinsic_call(
			"list_len",
			[self],
			INT_TYPE,
		),
		immutable_let(
			"__result",
			list_type,
			intrinsic_call(
				"list_ensure_capacity",
				[self, binary(
						AddOp,
						variable("__n", INT_TYPE),
						int_literal(1),
						INT_TYPE,
					)],
				list_type,
			),
			SeqExpr(
				for_range(
					"__i",
					int_literal(0),
					variable(
						"__n",
						INT_TYPE,
					),
					immutable_let(
						"__j",
						INT_TYPE,
						binary(
							SubtractOp,
							binary(
								SubtractOp,
								variable("__n", INT_TYPE),
								int_literal(1),
								INT_TYPE,
							),
							variable("__i", INT_TYPE),
							INT_TYPE,
						),
						if_expr(
							binary(
								GreaterEqualOp,
								variable("__j", INT_TYPE),
								index,
								BOOL_TYPE,
							),
							intrinsic_call(
								"list_set",
								[
									variable("__result", list_type),
									binary(
										AddOp,
										variable("__j", INT_TYPE),
										int_literal(1),
										INT_TYPE,
									),
									intrinsic_call(
										"list_get",
										[
											variable("__result", list_type),
											variable("__j", INT_TYPE),
										],
										POINTER_TYPE,
									),
								],
								VoidType,
							),
							VOID_EXPR,
							VoidType,
						),
					),
				),
				SeqExpr(
					intrinsic_call(
						"list_retain_for",
						[variable("__result", list_type), element],
						VoidType,
					),
					SeqExpr(
						intrinsic_call(
							"list_set",
							[variable("__result", list_type), index, element],
							VoidType,
						),
						SeqExpr(
							intrinsic_call(
								"list_set_len",
								[variable("__result", list_type), binary(
										AddOp,
										variable("__n", INT_TYPE),
										int_literal(1),
										INT_TYPE,
									)],
								VoidType,
							),
							variable(
								"__result",
								list_type,
							),
						),
					),
				),
			),
		),
	)


private pure func synthesize_tail(list_type: CoreType, self: CoreExpr) -> CoreExpr:
	immutable_let(
		"__n",
		INT_TYPE,
		intrinsic_call(
			"list_len",
			[self],
			INT_TYPE,
		),
		if_expr(
			binary(
				EqualOp,
				variable("__n", INT_TYPE),
				int_literal(0),
				BOOL_TYPE,
			),
			self,
			immutable_let(
				"__result",
				list_type,
