private pure func synthesize_flatten(
	outer_type: CoreType,
	inner_type: CoreType,
	element_type: CoreType,
	return_type: CoreType,
	lists: CoreExpr,
) -> CoreExpr:
	inner_value: CoreExpr = list_value(
		variable("__lists", outer_type),
		variable("__outer_i", INT_TYPE),
		inner_type,
	)
	prescan: CoreExpr = immutable_let(
		"__inner",
		inner_type,
		inner_value,
		assignment(
			"__total",
			binary(
				AddOp,
				variable("__total", INT_TYPE),
				intrinsic_call("list_len", [variable("__inner", inner_type)], INT_TYPE),
				INT_TYPE,
			),
		),
	)
	copy_inner: CoreExpr = immutable_let(
		"__elem",
		element_type,
		list_value(
			variable("__inner", inner_type),
			variable("__inner_i", INT_TYPE),
			element_type,
		),
		SeqExpr(
			intrinsic_call(
				"list_retain_for",
				[variable("__result", return_type), variable("__elem", element_type)],
				VoidType,
			),
			SeqExpr(
				intrinsic_call(
					"list_set_owned",
					[
						variable("__result", return_type),
						variable("__out", INT_TYPE),
						variable("__elem", element_type),
					],
					VoidType,
				),
				assignment(
					"__out",
					binary(
						AddOp,
						variable("__out", INT_TYPE),
						int_literal(1),
						INT_TYPE,
					),
				),
			),
		),
	)
	copy_outer: CoreExpr = immutable_let(
		"__inner",
		inner_type,
		inner_value,
		immutable_let(
			"__inner_n",
			INT_TYPE,
			intrinsic_call("list_len", [variable("__inner", inner_type)], INT_TYPE),
			for_range(
				"__inner_i",
				int_literal(0),
				variable("__inner_n", INT_TYPE),
				copy_inner,
			),
		),
	)

	borrow_let(
		"__lists",
		outer_type,
		lists,
		immutable_let(
			"__outer_n",
			INT_TYPE,
			intrinsic_call(
				"list_len",
				[variable("__lists", outer_type)],
				INT_TYPE,
			),
			mutable_let(
				"__total",
				INT_TYPE,
				int_literal(0),
				SeqExpr(
					for_range(
						"__outer_i",
						int_literal(0),
						variable("__outer_n", INT_TYPE),
						prescan,
					),
					immutable_let(
						"__result",
						return_type,
						intrinsic_call(
							"list_alloc",
							[variable("__total", INT_TYPE)],
							return_type,
						),
						mutable_let(
							"__out",
							INT_TYPE,
							int_literal(0),
							SeqExpr(
								for_range(
									"__outer_i",
									int_literal(0),
									variable("__outer_n", INT_TYPE),
									copy_outer,
								),
								SeqExpr(
									intrinsic_call(
										"list_set_len",
										[
											variable("__result", return_type),
											variable("__total", INT_TYPE),
										],
										VoidType,
									),
									variable(
										"__result",
										return_type,
									),
								),
							),
						),
					),
				),
			),
		),
	)


private pure func synthesize_repeat(
	return_type: CoreType,
	element_type: CoreType,
	element: CoreExpr,
	count: CoreExpr,
) -> CoreExpr:
	immutable_let(
		"__elem",
		element_type,
		element,
		immutable_let(
			"__out_n",
			INT_TYPE,
			nonnegative_count(count),
			immutable_let(
				"__result",
				return_type,
				intrinsic_call(
					"list_alloc",
					[variable("__out_n", INT_TYPE)],
					return_type,
				),
				SeqExpr(
					for_range(
						"__i",
						int_literal(0),
						variable(
							"__out_n",
							INT_TYPE,
						),
						SeqExpr(
							intrinsic_call(
								"list_retain_for",
								[
									variable("__result", return_type),
									variable("__elem", element_type),
								],
								VoidType,
							),
							intrinsic_call(
								"list_set",
								[
									variable("__result", return_type),
									variable("__i", INT_TYPE),
									variable("__elem", element_type),
								],
								VoidType,
							),
						),
					),
					SeqExpr(
						intrinsic_call(
							"list_set_len",
							[variable("__result", return_type), variable("__out_n", INT_TYPE)],
							VoidType,
						),
						variable(
							"__result",
							return_type,
						),
					),
				),
			),
		),
	)


private pure func synthesize_intersperse(
	list_type: CoreType,
	element_type: CoreType,
	self: CoreExpr,
	separator: CoreExpr,
) -> CoreExpr:
	out_count: CoreExpr = if_expr(
		binary(
			LessEqualOp,
			variable("__n", INT_TYPE),
			int_literal(1),
			BOOL_TYPE,
		),
		variable("__n", INT_TYPE),
		binary(
			SubtractOp,
			binary(
				MultiplyOp,
				variable("__n", INT_TYPE),
				int_literal(2),
				INT_TYPE,
			),
			int_literal(1),
			INT_TYPE,
		),
		INT_TYPE,
	)
	loop_body: CoreExpr = immutable_let(
		"__out",
		INT_TYPE,
		binary(
			MultiplyOp,
			variable("__i", INT_TYPE),
			int_literal(2),
			INT_TYPE,
		),
		SeqExpr(
			if_expr(
				binary(
					GreaterOp,
					variable("__i", INT_TYPE),
					int_literal(0),
					BOOL_TYPE,
				),
				SeqExpr(
					intrinsic_call(
						"list_retain_for",
						[variable("__result", list_type), variable("__separator", element_type)],
						VoidType,
					),
					intrinsic_call(
						"list_set",
						[variable("__result", list_type), binary(
								SubtractOp,
								variable("__out", INT_TYPE),
								int_literal(1),
								INT_TYPE,
							), variable("__separator", element_type)],
						VoidType,
					),
				),
				VOID_EXPR,
				VoidType,
			),
			copy_borrowed_to(
				"__result",
				list_type,
				element_type,
				variable("__self", list_type),
				variable("__i", INT_TYPE),
				variable("__out", INT_TYPE),
			),
		),
	)

	borrow_let(
		"__self",
		list_type,
		self,
		immutable_let(
			"__separator",
			element_type,
			separator,
			immutable_let(
				"__n",
				INT_TYPE,
				intrinsic_call(
					"list_len",
					[variable("__self", list_type)],
					INT_TYPE,
				),
				immutable_let(
					"__out_n",
					INT_TYPE,
					out_count,
					immutable_let(
						"__result",
						list_type,
						intrinsic_call(
							"list_alloc",
							[variable("__out_n", INT_TYPE)],
							list_type,
						),
						SeqExpr(
							for_range(
								"__i",
								int_literal(0),
								variable("__n", INT_TYPE),
								loop_body,
							),
							SeqExpr(
								intrinsic_call(
									"list_set_len",
									[
										variable("__result", list_type),
										variable("__out_n", INT_TYPE),
									],
									VoidType,
								),
								variable(
									"__result",
									list_type,
								),
							),
						),
					),
				),
			),
		),
	)


private pure func synthesize_windows(
	list_type: CoreType,
	element_type: CoreType,
	return_type: CoreType,
	inner_type: CoreType,
	self: CoreExpr,
	count: CoreExpr,
) -> CoreExpr:
	out_count: CoreExpr = if_expr(
		logical_or(
			binary(
				LessEqualOp,
				variable("__requested", INT_TYPE),
				int_literal(0),
				BOOL_TYPE,
			),
			binary(
				GreaterOp,
				variable("__requested", INT_TYPE),
				variable("__len", INT_TYPE),
				BOOL_TYPE,
			),
		),
		int_literal(0),
		binary(
			AddOp,
			binary(
				SubtractOp,
				variable("__len", INT_TYPE),
				variable("__requested", INT_TYPE),
				INT_TYPE,
			),
			int_literal(1),
			INT_TYPE,
		),
		INT_TYPE,
	)
	build_window: CoreExpr = immutable_let(
		"__window",
		inner_type,
		intrinsic_call(
			"list_alloc",
			[variable("__requested", INT_TYPE)],
			inner_type,
		),
		SeqExpr(
			for_range(
				"__inner_i",
				int_literal(0),
				variable("__requested", INT_TYPE),
				copy_borrowed_to(
					"__window",
					inner_type,
					element_type,
					variable("__self", list_type),
					binary(
						AddOp,
						variable("__outer_i", INT_TYPE),
						variable("__inner_i", INT_TYPE),
						INT_TYPE,
					),
					variable("__inner_i", INT_TYPE),
				),
			),
			SeqExpr(
				intrinsic_call(
					"list_set_len",
					[variable("__window", inner_type), variable("__requested", INT_TYPE)],
					VoidType,
				),
				intrinsic_call(
					"list_set_owned",
					[
						variable("__result", return_type),
						variable("__outer_i", INT_TYPE),
						variable("__window", inner_type),
					],
					VoidType,
				),
			),
		),
	)

	borrow_let(
		"__self",
		list_type,
		self,
		immutable_let(
			"__requested",
			INT_TYPE,
			count,
			immutable_let(
				"__len",
				INT_TYPE,
				intrinsic_call(
					"list_len",
					[variable("__self", list_type)],
					INT_TYPE,
				),
				immutable_let(
					"__out_n",
					INT_TYPE,
					out_count,
					immutable_let(
						"__result",
						return_type,
						intrinsic_call(
							"list_alloc",
							[variable("__out_n", INT_TYPE)],
							return_type,
						),
						SeqExpr(
							for_range(
								"__outer_i",
								int_literal(0),
								variable("__out_n", INT_TYPE),
								build_window,
							),
							SeqExpr(
								intrinsic_call(
									"list_set_len",
									[
										variable("__result", return_type),
										variable("__out_n", INT_TYPE),
									],
									VoidType,
								),
								variable(
									"__result",
									return_type,
								),
							),
						),
					),
				),
			),
		),
	)


private pure func synthesize_chunks(
	list_type: CoreType,
	element_type: CoreType,
	return_type: CoreType,
	inner_type: CoreType,
	self: CoreExpr,
	count: CoreExpr,
) -> CoreExpr:
	out_count: CoreExpr = if_expr(
		logical_or(
			binary(
				LessEqualOp,
				variable("__requested", INT_TYPE),
				int_literal(0),
				BOOL_TYPE,
			),
			binary(
				LessEqualOp,
				variable("__len", INT_TYPE),
				int_literal(0),
				BOOL_TYPE,
			),
		),
		int_literal(0),
		binary(
			DivideOp,
			binary(
				AddOp,
				binary(
					SubtractOp,
					variable("__len", INT_TYPE),
					int_literal(1),
					INT_TYPE,
				),
				variable("__requested", INT_TYPE),
				INT_TYPE,
			),
			variable("__requested", INT_TYPE),
			INT_TYPE,
		),
		INT_TYPE,
	)
	build_chunk: CoreExpr = immutable_let(
		"__start",
		INT_TYPE,
		binary(
			MultiplyOp,
			variable("__outer_i", INT_TYPE),
			variable("__requested", INT_TYPE),
			INT_TYPE,
		),
		immutable_let(
			"__remaining",
			INT_TYPE,
			binary(
				SubtractOp,
				variable("__len", INT_TYPE),
				variable("__start", INT_TYPE),
				INT_TYPE,
			),
			immutable_let(
				"__chunk_n",
				INT_TYPE,
				min_int(
					variable("__remaining", INT_TYPE),
					variable("__requested", INT_TYPE),
				),
				immutable_let(
					"__chunk",
					inner_type,
					intrinsic_call(
						"list_alloc",
						[variable("__chunk_n", INT_TYPE)],
						inner_type,
					),
					SeqExpr(
						for_range(
							"__inner_i",
							int_literal(0),
							variable("__chunk_n", INT_TYPE),
							copy_borrowed_to(
								"__chunk",
								inner_type,
								element_type,
								variable("__self", list_type),
								binary(
									AddOp,
									variable("__start", INT_TYPE),
									variable("__inner_i", INT_TYPE),
									INT_TYPE,
								),
								variable("__inner_i", INT_TYPE),
							),
						),
						SeqExpr(
							intrinsic_call(
								"list_set_len",
								[variable("__chunk", inner_type), variable("__chunk_n", INT_TYPE)],
								VoidType,
							),
							intrinsic_call(
								"list_set_owned",
								[
									variable("__result", return_type),
									variable("__outer_i", INT_TYPE),
									variable("__chunk", inner_type),
								],
								VoidType,
							),
						),
					),
				),
			),
		),
	)

	borrow_let(
		"__self",
		list_type,
		self,
		immutable_let(
			"__requested",
			INT_TYPE,
			count,
			immutable_let(
				"__len",
				INT_TYPE,
				intrinsic_call(
					"list_len",
					[variable("__self", list_type)],
					INT_TYPE,
				),
				immutable_let(
					"__out_n",
					INT_TYPE,
					out_count,
					immutable_let(
						"__result",
						return_type,
						intrinsic_call(
							"list_alloc",
							[variable("__out_n", INT_TYPE)],
							return_type,
						),
						SeqExpr(
							for_range(
								"__outer_i",
								int_literal(0),
								variable("__out_n", INT_TYPE),
								build_chunk,
							),
							SeqExpr(
								intrinsic_call(
									"list_set_len",
									[
										variable("__result", return_type),
										variable("__out_n", INT_TYPE),
									],
									VoidType,
								),
								variable(
									"__result",
									return_type,
								),
							),
						),
					),
				),
			),
		),
	)


private pure func synthesize_range(start: CoreExpr, stop: CoreExpr) -> CoreExpr:
	immutable_let(
		"__start",
		INT_TYPE,
		start,
		immutable_let(
			"__stop",
			INT_TYPE,
			stop,
			immutable_let(
				"__out_n",
				INT_TYPE,
				if_expr(
					binary(
						LessEqualOp,
						variable("__stop", INT_TYPE),
						variable("__start", INT_TYPE),
						BOOL_TYPE,
					),
					int_literal(0),
					binary(
						SubtractOp,
						variable("__stop", INT_TYPE),
						variable("__start", INT_TYPE),
						INT_TYPE,
					),
					INT_TYPE,
				),
				immutable_let(
					"__result",
					NamedType(
						"List",
						[INT_TYPE],
					),
					intrinsic_call(
						"list_alloc",
						[variable("__out_n", INT_TYPE)],
						NamedType("List", [INT_TYPE]),
					),
					SeqExpr(
						for_range(
							"__i",
							int_literal(0),
							variable(
								"__out_n",
								INT_TYPE,
							),
							intrinsic_call(
								"list_set",
								[variable(
										"__result",
										NamedType("List", [INT_TYPE]),
									), variable("__i", INT_TYPE), binary(
										AddOp,
										variable("__start", INT_TYPE),
										variable("__i", INT_TYPE),
										INT_TYPE,
									)],
								VoidType,
							),
						),
						SeqExpr(
							intrinsic_call(
								"list_set_len",
								[variable(
										"__result",
										NamedType("List", [INT_TYPE]),
									), variable("__out_n", INT_TYPE)],
								VoidType,
							),
							variable(
								"__result",
								NamedType("List", [INT_TYPE]),
							),
						),
					),
				),
			),
		),
	)


private pure func synthesize_unique(
	list_type: CoreType,
	element_type: CoreType,
	self: CoreExpr,
) -> CoreExpr:
	prior: CoreExpr = list_value(
		variable("__result", list_type),
		variable("__scan_i", INT_TYPE),
		element_type,
	)
	scan_body: CoreExpr = if_expr(
		binary(
			EqualOp,
			prior,
			variable("__elem", element_type),
			BOOL_TYPE,
		),
		SeqExpr(
			assignment("__seen", bool_literal(True)),
			BREAK_EXPR,
		),
		VOID_EXPR,
		VoidType,
	)
	store: CoreExpr = SeqExpr(
		intrinsic_call(
			"list_retain_for",
			[variable("__result", list_type), variable("__elem", element_type)],
			VoidType,
		),
		SeqExpr(
			intrinsic_call(
				"list_set_owned",
				[
					variable("__result", list_type),
					variable("__out", INT_TYPE),
					variable("__elem", element_type),
				],
				VoidType,
			),
			SeqExpr(
				assignment(
					"__out",
					binary(
						AddOp,
						variable("__out", INT_TYPE),
						int_literal(1),
						INT_TYPE,
					),
				),
				intrinsic_call(
					"list_set_len",
					[variable("__result", list_type), variable("__out", INT_TYPE)],
					VoidType,
				),
			),
		),
	)
	loop_body: CoreExpr = immutable_let(
		"__elem",
		element_type,
		list_value(
			variable("__self", list_type),
			variable("__i", INT_TYPE),
			element_type,
		),
		mutable_let(
			"__seen",
			BOOL_TYPE,
			bool_literal(False),
			SeqExpr(
				for_range(
					"__scan_i",
					int_literal(0),
					variable("__out", INT_TYPE),
					scan_body,
				),
				if_expr(
					binary(
						EqualOp,
						variable("__seen", BOOL_TYPE),
						bool_literal(False),
						BOOL_TYPE,
					),
					store,
					VOID_EXPR,
					VoidType,
				),
			),
		),
	)

	borrow_let(
		"__self",
		list_type,
		self,
		immutable_let(
			"__n",
			INT_TYPE,
			intrinsic_call(
				"list_len",
				[variable("__self", list_type)],
				INT_TYPE,
			),
			immutable_let(
				"__result",
				list_type,
				intrinsic_call(
					"list_alloc",
					[variable("__n", INT_TYPE)],
					list_type,
				),
				mutable_let(
					"__out",
					INT_TYPE,
					int_literal(0),
					SeqExpr(
						for_range(
							"__i",
							int_literal(0),
							variable("__n", INT_TYPE),
							loop_body,
						),
						SeqExpr(
							intrinsic_call(
								"list_set_len",
								[variable("__result", list_type), variable("__out", INT_TYPE)],
								VoidType,
							),
							variable(
								"__result",
								list_type,
							),
						),
					),
				),
			),
		),
	)


private pure func synthesize_string_append(self: CoreExpr, other: CoreExpr) -> CoreExpr:
	immutable_let(
		"__self_n",
		INT_TYPE,
		intrinsic_call(
			"string_len",
			[self],
			INT_TYPE,
		),
		immutable_let(
			"__other_n",
			INT_TYPE,
			intrinsic_call(
				"string_len",
				[other],
				INT_TYPE,
			),
			if_expr(
				binary(
					EqualOp,
					variable("__other_n", INT_TYPE),
					int_literal(0),
					BOOL_TYPE,
				),
				self,
				immutable_let(
					"__new_n",
					INT_TYPE,
					binary(
						AddOp,
						variable("__self_n", INT_TYPE),
						variable("__other_n", INT_TYPE),
						INT_TYPE,
					),
					immutable_let(
						"__result",
						STRING_TYPE,
						intrinsic_call(
							"string_ensure_capacity",
							[self, variable("__new_n", INT_TYPE)],
							STRING_TYPE,
						),
						SeqExpr(
							for_range(
								"__i",
								int_literal(0),
								variable(
									"__other_n",
									INT_TYPE,
								),
								intrinsic_call(
									"string_set_byte",
									[
										variable("__result", STRING_TYPE),
										binary(
											AddOp,
											variable("__self_n", INT_TYPE),
											variable("__i", INT_TYPE),
											INT_TYPE,
										),
										intrinsic_call(
											"string_get_byte",
											[other, variable("__i", INT_TYPE)],
											INT_TYPE,
										),
									],
									VoidType,
								),
							),
							SeqExpr(
								intrinsic_call(
									"string_set_len",
									[
										variable("__result", STRING_TYPE),
										variable("__new_n", INT_TYPE),
									],
									VoidType,
								),
								variable(
									"__result",
									STRING_TYPE,
								),
							),
						),
					),
				),
				STRING_TYPE,
			),
		),
	)


private pure func synthesize_parallel(
	self_param: CoreParam,
	body_param: CoreParam,
	element_type: CoreType,
	result_type: CoreType,
) -> CoreExpr:
	view_type: CoreType = NamedType("ParallelList", [element_type])
	closure_call(
		parameter_value(body_param),
		[VarExpr(self_param.name, view_type, SyntheticSourceLoc)],
		result_type,
	)


private pure func synthesize_map(
	list_type: CoreType,
	element_type: CoreType,
	result_type: CoreType,
	result_element_type: CoreType,
	self: CoreExpr,
	callback: CoreExpr,
	indexed: Bool,
) -> CoreExpr:
	callback_args: List[CoreExpr] = if indexed:
		[variable("__i", INT_TYPE), list_value(
				variable("__self", list_type),
				variable("__i", INT_TYPE),
				element_type,
			)]
	else:
		[list_value(
				variable("__self", list_type),
				variable("__i", INT_TYPE),
				element_type,
			)]

	loop_body: CoreExpr = immutable_let(
		"__mapped",
		result_element_type,
		closure_call(
			variable("__callback", core_expr_type(callback)),
			callback_args,
			result_element_type,
		),
		intrinsic_call(
			"list_set_owned",
			[
				variable("__result", result_type),
				variable("__i", INT_TYPE),
				variable("__mapped", result_element_type),
			],
			VoidType,
		),
	)

	borrow_let(
		"__self",
		list_type,
		self,
		immutable_let(
			"__callback",
			core_expr_type(callback),
			callback,
			immutable_let(
				"__n",
				INT_TYPE,
				intrinsic_call(
					"list_len",
					[variable("__self", list_type)],
					INT_TYPE,
				),
				immutable_let(
					"__result",
					result_type,
					intrinsic_call(
						"list_alloc",
						[variable("__n", INT_TYPE)],
						result_type,
					),
					SeqExpr(
						for_range(
							"__i",
							int_literal(0),
							variable("__n", INT_TYPE),
							loop_body,
						),
						SeqExpr(
							intrinsic_call(
								"list_set_len",
								[variable("__result", result_type), variable("__n", INT_TYPE)],
								VoidType,
							),
							variable(
								"__result",
								result_type,
							),
						),
					),
				),
			),
		),
	)


private pure func synthesize_concurrent(
	element_type: CoreType,
	result_type: CoreType,
	result_element_type: CoreType,
	self: CoreExpr,
	limit: CoreExpr,
	timeout: Option[CoreExpr],
	callback: CoreExpr,
) -> CoreExpr:
	item_var: CoreVar = core_var("__item")
	loop: CorePreClosureConcurrentlyLoop = {
		variable = item_var,
		item_type = element_type,
		item_mode = ConcurrentlyLoopCopyItem,
		iterable = self,
		body = closure_call(
			callback,
			[VarExpr(item_var, element_type, SyntheticSourceLoc)],
			result_element_type,
		),
		timeout = timeout,
		limit = limit,
		output = ConcurrentlyLoopCollect
	}
	PreClosureConcurrentlyLoopExpr(loop, result_type, SyntheticSourceLoc)


private pure func synthesize_filter_like(
	list_type: CoreType,
	element_type: CoreType,
	self: CoreExpr,
	predicate: CoreExpr,
	stop_on_miss: Bool,
) -> CoreExpr:
	element: CoreExpr = variable("__elem", element_type)
	keep: CoreExpr = SeqExpr(
		intrinsic_call(
			"list_set_owned",
			[variable("__result", list_type), variable("__out", INT_TYPE), element],
			VoidType,
		),
		assignment(
			"__out",
			binary(
				AddOp,
				variable("__out", INT_TYPE),
				int_literal(1),
				INT_TYPE,
			),
		),
	)

	miss: CoreExpr = if stop_on_miss:
		BREAK_EXPR
	else:
		VOID_EXPR

	loop_body: CoreExpr = immutable_let(
		"__elem",
		element_type,
		list_value(
			variable("__self", list_type),
			variable("__i", INT_TYPE),
			element_type,
		),
		if_expr(
			closure_call(
				variable("__predicate", core_expr_type(predicate)),
				[element],
				BOOL_TYPE,
			),
			keep,
			miss,
			VoidType,
		),
	)

	borrow_let(
		"__self",
		list_type,
		self,
		immutable_let(
			"__predicate",
			core_expr_type(predicate),
			predicate,
			immutable_let(
				"__n",
				INT_TYPE,
				intrinsic_call(
					"list_len",
					[variable("__self", list_type)],
					INT_TYPE,
				),
				immutable_let(
					"__result",
					list_type,
					intrinsic_call(
						"list_alloc",
						[variable("__n", INT_TYPE)],
						list_type,
					),
					mutable_let(
						"__out",
						INT_TYPE,
						int_literal(0),
						SeqExpr(
							for_range(
								"__i",
								int_literal(0),
								variable("__n", INT_TYPE),
								loop_body,
							),
							SeqExpr(
								intrinsic_call(
									"list_set_len",
									[variable("__result", list_type), variable("__out", INT_TYPE)],
									VoidType,
								),
								variable(
									"__result",
									list_type,
								),
							),
						),
					),
				),
			),
		),
	)


private pure func synthesize_drop_while(
	list_type: CoreType,
	element_type: CoreType,
	self: CoreExpr,
	predicate: CoreExpr,
) -> CoreExpr:
	scan_body: CoreExpr = immutable_let(
		"__elem",
		element_type,
		list_value(
			variable("__self", list_type),
			variable("__i", INT_TYPE),
			element_type,
		),
		if_expr(
			closure_call(
				variable("__predicate", core_expr_type(predicate)),
				[variable("__elem", element_type)],
				BOOL_TYPE,
			),
			assignment(
				"__start",
				binary(
					AddOp,
					variable("__i", INT_TYPE),
					int_literal(1),
					INT_TYPE,
				),
			),
			BREAK_EXPR,
			VoidType,
		),
	)
	copy_body: CoreExpr = copy_borrowed_to(
		"__result",
		list_type,
		element_type,
		variable("__self", list_type),
		binary(
			AddOp,
			variable("__start", INT_TYPE),
			variable("__i", INT_TYPE),
			INT_TYPE,
		),
		variable("__i", INT_TYPE),
	)

	borrow_let(
		"__self",
		list_type,
		self,
		immutable_let(
			"__predicate",
			core_expr_type(predicate),
			predicate,
			immutable_let(
				"__n",
				INT_TYPE,
				intrinsic_call(
					"list_len",
					[variable("__self", list_type)],
					INT_TYPE,
				),
				mutable_let(
					"__start",
					INT_TYPE,
					int_literal(0),
					SeqExpr(
						for_range(
							"__i",
							int_literal(0),
							variable("__n", INT_TYPE),
							scan_body,
						),
						immutable_let(
							"__out_n",
							INT_TYPE,
							binary(
								SubtractOp,
								variable("__n", INT_TYPE),
								variable("__start", INT_TYPE),
								INT_TYPE,
							),
							immutable_let(
								"__result",
								list_type,
								intrinsic_call(
									"list_alloc",
									[variable("__out_n", INT_TYPE)],
									list_type,
								),
								SeqExpr(
									for_range(
										"__i",
										int_literal(0),
										variable("__out_n", INT_TYPE),
										copy_body,
									),
									SeqExpr(
										intrinsic_call(
											"list_set_len",
											[
												variable("__result", list_type),
												variable("__out_n", INT_TYPE),
											],
											VoidType,
										),
										variable(
											"__result",
											list_type,
										),
									),
								),
							),
						),
					),
				),
			),
		),
	)


private pure func partition_push(
	list_name: String,
	out_name: String,
	list_type: CoreType,
	element_type: CoreType,
) -> CoreExpr:
	SeqExpr(
		intrinsic_call(
			"list_retain_for",
			[variable(list_name, list_type), variable("__elem", element_type)],
			VoidType,
		),
		SeqExpr(
			intrinsic_call(
				"list_set_owned",
				[
					variable(list_name, list_type),
					variable(out_name, INT_TYPE),
					variable("__elem", element_type),
				],
				VoidType,
			),
			assignment(
				out_name,
				binary(
					AddOp,
					variable(out_name, INT_TYPE),
					int_literal(1),
					INT_TYPE,
				),
			),
		),
	)


private pure func synthesize_partition(
	list_type: CoreType,
	element_type: CoreType,
	return_type: CoreType,
	self: CoreExpr,
	predicate: CoreExpr,
) -> CoreExpr:
	loop_body: CoreExpr = immutable_let(
		"__elem",
		element_type,
		list_value(
			variable("__self", list_type),
			variable("__i", INT_TYPE),
			element_type,
		),
		if_expr(
			closure_call(
				variable("__predicate", core_expr_type(predicate)),
				[variable("__elem", element_type)],
				BOOL_TYPE,
			),
			partition_push("__yes", "__yes_out", list_type, element_type),
			partition_push("__no", "__no_out", list_type, element_type),
			VoidType,
		),
	)

	borrow_let(
		"__self",
		list_type,
		self,
		immutable_let(
			"__predicate",
			core_expr_type(predicate),
			predicate,
			immutable_let(
				"__n",
				INT_TYPE,
				intrinsic_call(
					"list_len",
					[variable("__self", list_type)],
					INT_TYPE,
				),
				immutable_let(
					"__yes",
					list_type,
					intrinsic_call(
						"list_alloc",
						[variable("__n", INT_TYPE)],
						list_type,
					),
					immutable_let(
						"__no",
						list_type,
						intrinsic_call(
							"list_alloc",
							[variable("__n", INT_TYPE)],
							list_type,
						),
						mutable_let(
							"__yes_out",
							INT_TYPE,
							int_literal(0),
							mutable_let(
								"__no_out",
								INT_TYPE,
								int_literal(0),
								SeqExpr(
									for_range(
										"__i",
										int_literal(0),
										variable("__n", INT_TYPE),
										loop_body,
									),
									SeqExpr(
										intrinsic_call(
											"list_set_len",
											[
												variable("__yes", list_type),
												variable("__yes_out", INT_TYPE),
											],
											VoidType,
										),
										SeqExpr(
											intrinsic_call(
												"list_set_len",
												[
													variable("__no", list_type),
													variable("__no_out", INT_TYPE),
												],
												VoidType,
											),
											TupleExpr(
												[
													variable("__yes", list_type),
													variable("__no", list_type),
												],
												return_type,
												SyntheticSourceLoc,
											),
										),
									),
								),
							),
						),
					),
				),
			),
		),
	)


private pure func synthesize_flat_map(
	list_type: CoreType,
	element_type: CoreType,
	result_type: CoreType,
	result_element_type: CoreType,
	self: CoreExpr,
	callback: CoreExpr,
) -> CoreExpr:
	inner_loop: CoreExpr = immutable_let(
		"__inner_elem",
		result_element_type,
		list_value(
			variable("__inner", result_type),
			variable("__inner_i", INT_TYPE),
			result_element_type,
		),
		SeqExpr(
			intrinsic_call(
				"list_set_owned",
				[
					variable("__result", result_type),
					variable("__out", INT_TYPE),
					variable("__inner_elem", result_element_type),
				],
				VoidType,
			),
			assignment(
				"__out",
				binary(
					AddOp,
					variable("__out", INT_TYPE),
					int_literal(1),
					INT_TYPE,
				),
			),
		),
	)
	outer_loop: CoreExpr = immutable_let(
		"__outer_elem",
		element_type,
		list_value(
			variable("__self", list_type),
			variable("__outer_i", INT_TYPE),
			element_type,
		),
		immutable_let(
			"__inner",
			result_type,
			closure_call(
				variable("__callback", core_expr_type(callback)),
				[variable("__outer_elem", element_type)],
				result_type,
			),
			immutable_let(
				"__inner_n",
				INT_TYPE,
				intrinsic_call(
					"list_len",
					[variable("__inner", result_type)],
					INT_TYPE,
				),
				SeqExpr(
					assignment(
						"__result",
						intrinsic_call(
							"list_ensure_capacity",
							[variable("__result", result_type), binary(
									AddOp,
									variable("__out", INT_TYPE),
									variable("__inner_n", INT_TYPE),
									INT_TYPE,
								)],
							result_type,
						),
					),
					SeqExpr(
						for_range(
							"__inner_i",
							int_literal(0),
							variable("__inner_n", INT_TYPE),
							inner_loop,
						),
						intrinsic_call(
							"list_set_len",
							[variable("__result", result_type), variable("__out", INT_TYPE)],
							VoidType,
						),
					),
				),
			),
		),
	)

	borrow_let(
		"__self",
		list_type,
		self,
		immutable_let(
			"__callback",
			core_expr_type(callback),
			callback,
			immutable_let(
				"__n",
				INT_TYPE,
				intrinsic_call("list_len", [variable("__self", list_type)], INT_TYPE),
				mutable_let(
					"__result",
					result_type,
					intrinsic_call("list_alloc", [int_literal(0)], result_type),
					mutable_let(
						"__out",
						INT_TYPE,
						int_literal(0),
						SeqExpr(
							for_range(
								"__outer_i",
								int_literal(0),
								variable("__n", INT_TYPE),
								outer_loop,
							),
							variable("__result", result_type),
						),
					),
				),
			),
		),
	)


private pure func synthesize_filter_map(
	list_type: CoreType,
	element_type: CoreType,
	result_type: CoreType,
	result_element_type: CoreType,
	option_type: CoreType,
	self: CoreExpr,
	callback: CoreExpr,
) -> CoreExpr:
	keep: CoreExpr = SeqExpr(
		intrinsic_call(
			"list_set_owned",
			[
				variable("__result", result_type),
				variable("__out", INT_TYPE),
				variable("__value", result_element_type),
			],
			VoidType,
		),
		assignment(
			"__out",
			binary(
				AddOp,
				variable("__out", INT_TYPE),
				int_literal(1),
				INT_TYPE,
			),
		),
	)
	match_mapped: CoreExpr = RawMatchExpr(
		variable(
			"__mapped",
			option_type,
		),
		[
			{
				pattern = ConstructorPattern("Some", [NamePattern("__value")]),
				body = keep
			},
			{
				pattern = ConstructorPattern("None", []),
				body = VOID_EXPR
			},
		],
		VoidType,
		SyntheticSourceLoc,
	)
	loop_body: CoreExpr = immutable_let(
		"__elem",
		element_type,
		list_value(
			variable("__self", list_type),
			variable("__i", INT_TYPE),
			element_type,
		),
		immutable_let(
			"__mapped",
			option_type,
			closure_call(
				variable("__callback", core_expr_type(callback)),
				[variable("__elem", element_type)],
				option_type,
			),
			match_mapped,
		),
	)

	borrow_let(
		"__self",
		list_type,
		self,
		immutable_let(
			"__callback",
			core_expr_type(callback),
			callback,
			immutable_let(
				"__n",
				INT_TYPE,
				intrinsic_call(
					"list_len",
					[variable("__self", list_type)],
					INT_TYPE,
				),
				immutable_let(
					"__result",
					result_type,
					intrinsic_call(
						"list_alloc",
						[variable("__n", INT_TYPE)],
						result_type,
					),
					mutable_let(
						"__out",
						INT_TYPE,
						int_literal(0),
						SeqExpr(
							for_range(
								"__i",
								int_literal(0),
								variable("__n", INT_TYPE),
								loop_body,
							),
							SeqExpr(
								intrinsic_call(
									"list_set_len",
									[
										variable("__result", result_type),
										variable("__out", INT_TYPE),
									],
									VoidType,
								),
								variable(
									"__result",
									result_type,
								),
							),
						),
					),
				),
			),
		),
	)


private pure func synthesize_fold(
	list_type: CoreType,
	element_type: CoreType,
	accumulator_type: CoreType,
	self: CoreExpr,
	initial: CoreExpr,
	callback: CoreExpr,
	right_to_left: Bool,
) -> CoreExpr:
	index: CoreExpr = if right_to_left:
		binary(
			SubtractOp,
			binary(
				SubtractOp,
				variable("__n", INT_TYPE),
				variable("__offset", INT_TYPE),
				INT_TYPE,
			),
			int_literal(1),
			INT_TYPE,
		)
	else:
		variable("__offset", INT_TYPE)

	element: CoreExpr = list_value(
		variable("__self", list_type),
		index,
		element_type,
	)

	args: List[CoreExpr] = if right_to_left:
		[element, variable("__acc", accumulator_type)]
	else:
		[variable("__acc", accumulator_type), element]

	step: CoreExpr = immutable_let(
		"__next",
		accumulator_type,
		closure_call(
			variable("__callback", core_expr_type(callback)),
			args,
			accumulator_type,
		),
		assignment(
			"__acc",
			variable("__next", accumulator_type),
		),
	)

	borrow_let(
		"__self",
		list_type,
		self,
		immutable_let(
			"__callback",
			core_expr_type(callback),
			callback,
			immutable_let(
				"__n",
				INT_TYPE,
				intrinsic_call("list_len", [variable("__self", list_type)], INT_TYPE),
				mutable_let(
					"__acc",
					accumulator_type,
					initial,
					SeqExpr(
						for_range(
							"__offset",
							int_literal(0),
							variable("__n", INT_TYPE),
							step,
						),
						variable("__acc", accumulator_type),
					),
				),
			),
		),
	)


private pure func synthesize_all_or_any(
	list_type: CoreType,
	element_type: CoreType,
	self: CoreExpr,
	predicate: CoreExpr,
	is_all: Bool,
) -> CoreExpr:
	initial: Bool = is_all
	terminal: Bool = not is_all
	predicate_value: CoreExpr = closure_call(
		variable("__predicate", core_expr_type(predicate)),
		[variable("__elem", element_type)],
		BOOL_TYPE,
	)

	condition: CoreExpr = if is_all:
		binary(EqualOp, predicate_value, bool_literal(False), BOOL_TYPE)
	else:
		predicate_value

	loop_body: CoreExpr = immutable_let(
		"__elem",
		element_type,
		list_value(
			variable("__self", list_type),
			variable("__i", INT_TYPE),
			element_type,
		),
		if_expr(
			condition,
			SeqExpr(
				assignment("__result", bool_literal(terminal)),
				BREAK_EXPR,
			),
			VOID_EXPR,
			VoidType,
		),
	)

	borrow_let(
		"__self",
		list_type,
		self,
		immutable_let(
			"__predicate",
			core_expr_type(predicate),
			predicate,
			immutable_let(
				"__n",
				INT_TYPE,
				intrinsic_call("list_len", [variable("__self", list_type)], INT_TYPE),
				mutable_let(
					"__result",
					BOOL_TYPE,
					bool_literal(initial),
					SeqExpr(
						for_range(
							"__i",
							int_literal(0),
							variable("__n", INT_TYPE),
							loop_body,
						),
						variable("__result", BOOL_TYPE),
					),
				),
			),
		),
	)


private pure func synthesize_count(
	list_type: CoreType,
	element_type: CoreType,
