-- Core body synthesis for non-forwarding std/fixed operations.
--
-- Constructors and conversions that are single runtime calls live in
-- compiler_core_synth_forward. This module owns the operations whose behavior
-- is expressed as ordinary Core so later ownership and optimization passes can
-- reason about it.
import:
	compiler_core_json:
		CoreBinaryOp(AddOp, DivideOp, GreaterEqualOp, GreaterOp, LessOp, MultiplyOp, SubtractOp),
		CoreCallKind(IntrinsicCall),
		CoreExpr(BinaryExpr, CallExpr, IfExpr, LetExpr, LiteralExpr, VarExpr, VoidExpr),
		CoreFunction,
		CoreLiteral(IntLiteral),
		CoreParam,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType, VoidType),
		CoreVar,
	compiler_core_synth_name: is_synthesis_candidate, synthesis_source_name


private FIXED_MODULE: String = "std/fixed"

private INT_TYPE: CoreType = NamedType("Int", [])

private BOOL_TYPE: CoreType = NamedType("Bool", [])

private FIXED_TYPE: CoreType = NamedType("Fixed", [])


private pure func core_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


private pure func variable(name: String, typ: CoreType) -> CoreExpr:
	VarExpr(core_var(name), typ, SyntheticSourceLoc)


private pure func int_literal(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), INT_TYPE, SyntheticSourceLoc)


private pure func intrinsic_call(
	name: String,
	args: List[CoreExpr],
	return_type: CoreType,
) -> CoreExpr:
	CallExpr(
		IntrinsicCall(name),
		VoidExpr(VoidType, SyntheticSourceLoc),
		args,
		return_type,
		SyntheticSourceLoc,
	)


private pure func binary(
	op: CoreBinaryOp,
	left: CoreExpr,
	right: CoreExpr,
	return_type: CoreType,
) -> CoreExpr:
	BinaryExpr(op, left, right, return_type, SyntheticSourceLoc)


private pure func let_expr(
	name: String,
	typ: CoreType,
	rhs: CoreExpr,
	body: CoreExpr,
) -> CoreExpr:
	LetExpr(core_var(name), False, typ, rhs, body)


private pure func if_expr(
	condition: CoreExpr,
	then_expr: CoreExpr,
	else_expr: CoreExpr,
	return_type: CoreType,
) -> CoreExpr:
	IfExpr(condition, then_expr, else_expr, return_type, SyntheticSourceLoc)


private pure func type_is_named(typ: CoreType, expected: String) -> Bool:
	match typ:
		NamedType(name, args):
			name == expected and args.is_empty()
		_:
			False


private pure func param_is_named(params: List[CoreParam], index: Int, expected: String) -> Bool:
	match params.get(index):
		Some(param):
			type_is_named(param.typ, expected)
		None:
			False


private pure func parameter_value(param: CoreParam) -> CoreExpr:
	VarExpr(param.name, param.typ, SyntheticSourceLoc)


private pure func synthesize_to_int(value: CoreExpr) -> CoreExpr:
	let_expr(
		"__val",
		INT_TYPE,
		intrinsic_call("fixed_value", [value], INT_TYPE),
		let_expr(
			"__scale",
			INT_TYPE,
			intrinsic_call("fixed_scale", [value], INT_TYPE),
			if_expr(
				binary(
					GreaterEqualOp,
					variable("__scale", INT_TYPE),
					int_literal(0),
					BOOL_TYPE,
				),
				binary(
					DivideOp,
					variable("__val", INT_TYPE),
					intrinsic_call("fixed_pow10", [variable("__scale", INT_TYPE)], INT_TYPE),
					INT_TYPE,
				),
				binary(
					MultiplyOp,
					variable("__val", INT_TYPE),
					intrinsic_call("fixed_pow10", [binary(
								SubtractOp,
								int_literal(0),
								variable("__scale", INT_TYPE),
								INT_TYPE,
							)], INT_TYPE),
					INT_TYPE,
				),
				INT_TYPE,
			),
		),
	)


private pure func synthesize_neg(value: CoreExpr) -> CoreExpr:
	intrinsic_call(
		"fixed_alloc",
		[binary(
				SubtractOp,
				int_literal(0),
				intrinsic_call("fixed_value", [value], INT_TYPE),
				INT_TYPE,
			), intrinsic_call(
				"fixed_scale",
				[value],
				INT_TYPE,
			), intrinsic_call("fixed_precision", [value], INT_TYPE)],
		FIXED_TYPE,
	)


private pure func rounded_value(diff: CoreExpr) -> CoreExpr:
	if_expr(
		binary(GreaterOp, diff, int_literal(0), BOOL_TYPE),
		binary(
			MultiplyOp,
			variable("__val", INT_TYPE),
			intrinsic_call("fixed_pow10", [diff], INT_TYPE),
			INT_TYPE,
		),
		if_expr(
			binary(LessOp, diff, int_literal(0), BOOL_TYPE),
			let_expr(
				"__div",
				INT_TYPE,
				intrinsic_call(
					"fixed_pow10",
					[binary(SubtractOp, int_literal(0), diff, INT_TYPE)],
					INT_TYPE,
				),
				binary(
					DivideOp,
					binary(
						AddOp,
						variable("__val", INT_TYPE),
						binary(
							DivideOp,
							variable("__div", INT_TYPE),
							int_literal(2),
							INT_TYPE,
						),
						INT_TYPE,
					),
					variable("__div", INT_TYPE),
					INT_TYPE,
				),
			),
			variable("__val", INT_TYPE),
			INT_TYPE,
		),
		INT_TYPE,
	)


private pure func synthesize_round_to(value: CoreExpr, target_scale: CoreExpr) -> CoreExpr:
	let_expr(
		"__val",
		INT_TYPE,
		intrinsic_call(
			"fixed_value",
			[value],
			INT_TYPE,
		),
		let_expr(
			"__scale",
			INT_TYPE,
			intrinsic_call(
				"fixed_scale",
				[value],
				INT_TYPE,
			),
			let_expr(
				"__prec",
				INT_TYPE,
				intrinsic_call(
					"fixed_precision",
					[value],
					INT_TYPE,
				),
				let_expr(
					"__diff",
					INT_TYPE,
					binary(
						SubtractOp,
						target_scale,
						variable("__scale", INT_TYPE),
						INT_TYPE,
					),
					let_expr(
						"__new_val",
						INT_TYPE,
						rounded_value(variable("__diff", INT_TYPE)),
						intrinsic_call(
							"fixed_alloc",
							[
								variable("__new_val", INT_TYPE),
								target_scale,
								variable("__prec", INT_TYPE),
							],
							FIXED_TYPE,
						),
					),
				),
			),
		),
	)


private pure func synthesize_named_body(
	name: String,
	params: List[CoreParam],
	return_type: CoreType,
) -> Option[CoreExpr]:
	if (
		name == "get_scale"
		and params.length() == 1
		and param_is_named(params, 0, "Fixed")
		and type_is_named(return_type, "Int")
	):
		param ?= params.get(0)
		Some(intrinsic_call("fixed_scale", [parameter_value(param)], INT_TYPE))
	else if (
		name == "get_precision"
		and params.length() == 1
		and param_is_named(params, 0, "Fixed")
		and type_is_named(return_type, "Int")
	):
		param ?= params.get(0)
		Some(intrinsic_call("fixed_precision", [parameter_value(param)], INT_TYPE))
	else if (
		name == "to_int"
		and params.length() == 1
		and param_is_named(params, 0, "Fixed")
		and type_is_named(return_type, "Int")
	):
		param ?= params.get(0)
		Some(synthesize_to_int(parameter_value(param)))
	else if (
		name == "neg"
		and params.length() == 1
		and param_is_named(params, 0, "Fixed")
		and type_is_named(return_type, "Fixed")
	):
		param ?= params.get(0)
		Some(synthesize_neg(parameter_value(param)))
	else if (
		name == "round_to"
		and params.length() == 2
		and param_is_named(params, 0, "Fixed")
		and param_is_named(params, 1, "Int")
		and type_is_named(return_type, "Fixed")
	):
		value ?= params.get(0)
		scale ?= params.get(1)
		Some(synthesize_round_to(parameter_value(value), parameter_value(scale)))
	else:
		None


pure func synthesize_fixed_body(function_info: CoreFunction) -> Option[CoreExpr]:
	if (
		not is_synthesis_candidate(function_info)
		or function_info.source_module != Some(FIXED_MODULE)
	):
		None
	else:
		name ?= synthesis_source_name(function_info)
		synthesize_named_body(name, function_info.params, function_info.return_type)
