-- Blorp-owned formatting for compiler phase profiling output.
--
-- OCaml still owns wall-clock timing and stage callbacks. This module owns the
-- rendered table shown to users when compiler phase profiling is enabled.
import:
	../stage_10_backend/codegen_template_registry: render_template_arity_error, render_unsupported_template_error
	float: format_float


enum CoreProfileTemplate:
	FormatTemplate


record CoreProfileTemplateInfo {
	template: CoreProfileTemplate,
	name: String,
	arity: Int
}


enum ProfilePhaseKind:
	CorePhase
	LabelPhase


record ProfileEntry {
	phase_kind: ProfilePhaseKind,
	label: String,
	ms: Float
}


union CoreProfileRenderError:
	WrongArity(CoreProfileTemplateInfo, Int)
	UnsupportedCoreProfileTemplate(String)


private pure func templates_by_name(
	templates: List[CoreProfileTemplateInfo],
) -> Dict[String, CoreProfileTemplateInfo]:
	var dict: Dict[String, CoreProfileTemplateInfo] = {}

	for info in templates:
		dict = dict.set(info.name, info)

	dict


ALL_TEMPLATES: List[CoreProfileTemplateInfo] = [
	{
		template = FormatTemplate,
		name = "core_profile_format",
		arity = 1
	},
]

private TEMPLATES_BY_NAME: Dict[String, CoreProfileTemplateInfo] = templates_by_name(ALL_TEMPLATES)


pure func core_profile_template_name(info: CoreProfileTemplateInfo) -> String:
	info.name


pure func core_profile_template_arity(info: CoreProfileTemplateInfo) -> Int:
	info.arity


pure func parse_core_profile_template(name: String) -> Option[CoreProfileTemplateInfo]:
	TEMPLATES_BY_NAME.get(name)


private pure func wrong_arity_for_args(
	info: CoreProfileTemplateInfo,
	args: List[String],
) -> CoreProfileRenderError:
	WrongArity(info, args.length())


pure func render_error_to_string(error: CoreProfileRenderError) -> String:
	match error:
		WrongArity(info, actual):
			render_template_arity_error(
				"core profile template",
				core_profile_template_name(info),
				core_profile_template_arity(info),
				actual,
			)
		UnsupportedCoreProfileTemplate(name):
			render_unsupported_template_error("core profile template", name)


private pure func parse_phase_kind(kind: String) -> Option[ProfilePhaseKind]:
	match kind:
		"core":
			Some(CorePhase)
		"label":
			Some(LabelPhase)
		unknown:
			None


private pure func parse_ms(text: String) -> Float:
	match text.parse_float():
		Some(ms):
			ms
		None:
			0.0


private pure func parse_profile_entry(line: String) -> Option[ProfileEntry]:
	match line.split("\t"):
		[kind_text, label, ms_text]:
			match parse_phase_kind(kind_text):
				Some(kind):
					Some({
						phase_kind = kind,
						label = label,
						ms = parse_ms(ms_text),
					})
				None:
					None
		[]:
			None
		[first]:
			None
		[first, second]:
			None
		[first, second, third, ...rest]:
			None


private pure func parse_profile_entries(text: String) -> List[ProfileEntry]:
	if text == "":
		[]
	else:
		var entries: List[ProfileEntry] = []

		for line in text.split("\n"):
			match parse_profile_entry(line):
				Some(entry):
					entries = entries.append(entry)
				None:
					void

		entries


private pure func parse_profile_entries_arg(
	info: CoreProfileTemplateInfo,
	args: List[String],
) -> Result[List[ProfileEntry], CoreProfileRenderError]:
	match args:
		[]:
			Err(wrong_arity_for_args(info, args))
		[entries_text]:
			Ok(parse_profile_entries(entries_text))
		[entries_text, extra]:
			Err(wrong_arity_for_args(info, args))
		[entries_text, extra, third]:
			Err(wrong_arity_for_args(info, args))
		[entries_text, extra, third, ...rest]:
			Err(wrong_arity_for_args(info, args))


pure func build_core_profile_entries(
	info: CoreProfileTemplateInfo,
	args: List[String],
) -> Result[List[ProfileEntry], CoreProfileRenderError]:
	match info.template:
		FormatTemplate:
			parse_profile_entries_arg(info, args)


private pure func has_label_entries(entries: List[ProfileEntry]) -> Bool:
	var found: Bool = False

	for entry in entries:
		match entry.phase_kind:
			LabelPhase:
				found = True
				break
			CorePhase:
				void

	found


private pure func row_label(has_labels: Bool, index: Int, entry: ProfileEntry) -> String:
	if index == 0 and not has_labels:
		entry.label + "*"
	else:
		entry.label


private pure func profile_row_labels(entries: List[ProfileEntry]) -> List[String]:
	has_labels: Bool = has_label_entries(entries)
	var labels: List[String] = []
	var index: Int = 0

	for entry in entries:
		labels = labels.append(row_label(has_labels, index, entry))
		index += 1

	labels


private pure func max_int(left: Int, right: Int) -> Int:
	if left > right:
		left
	else:
		right


private pure func label_width(labels: List[String]) -> Int:
	var width: Int = max_int("phase".length(), "total".length())

	for label in labels:
		width = max_int(width, label.length())

	width


private pure func total_duration(entries: List[ProfileEntry]) -> Float:
	var total: Float = 0.0

	for entry in entries:
		total += entry.ms

	total


private pure func row_percent(total_ms: Float, ms: Float) -> Float:
	if total_ms > 0.0:
		ms / total_ms * 100.0
	else:
		0.0


private pure func padded_ms(ms: Float) -> String:
	format_float(ms, 1).pad_left(6, ' ')


private pure func padded_percent(percent: Float) -> String:
	format_float(percent, 1).pad_left(5, ' ')


private pure func render_header(width: Int) -> String:
	"phase".pad_right(width, ' ') + " " + "ms".pad_left(6, ' ') + "  " + "%".pad_left(5, ' ') + "\n"


private pure func render_row(
	width: Int,
	total_ms: Float,
	label: String,
	ms: Float,
) -> String:
	label.pad_right(
		width,
		' ',
	) + " " + padded_ms(ms) + "  " + padded_percent(row_percent(total_ms, ms)) + "\n"


private pure func render_rows(
	width: Int,
	total_ms: Float,
	entries: List[ProfileEntry],
	labels: List[String],
) -> String:
	var rendered: String = ""
	var index: Int = 0

	for entry in entries:
		label: String = labels.get_or(index, entry.label)
		rendered += render_row(width, total_ms, label, entry.ms)
		index += 1

	rendered


private pure func render_total(width: Int, total_ms: Float) -> String:
	"total".pad_right(width, ' ') + " " + padded_ms(total_ms) + "  100.0\n"


private pure func render_profile(entries: List[ProfileEntry]) -> String:
	labels: List[String] = profile_row_labels(entries)
	width: Int = label_width(labels)
	total_ms: Float = total_duration(entries)
	separator: String = "-".repeat(width + 14) + "\n"
	var result: String = render_header(width)
	result += separator
	result += render_rows(width, total_ms, entries, labels)
	result += separator
	result += render_total(width, total_ms)

	if entries.length() > 0 and not has_label_entries(entries):
		result += "* first entry includes work before the first stage callback\n"

	result


pure func render_core_profile(
	name: String,
	args: List[String],
) -> Result[String, CoreProfileRenderError]:
	match parse_core_profile_template(name):
		Some(info):
			match build_core_profile_entries(info, args):
				Ok(entries):
					Ok(render_profile(entries))
				Err(error):
					Err(error)
		None:
			Err(UnsupportedCoreProfileTemplate(name))
