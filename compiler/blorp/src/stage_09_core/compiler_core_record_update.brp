-- Preserve record-update intent until the ownership boundary, then classify
-- it immediately before ownership analysis. Mutable self-updates transfer the
-- target's old owner into RecordReuseExpr. Nested self-update chains stage
-- their field values before that transfer so the intermediate record
-- allocations can be removed without exposing partial mutation. Branch
-- updates transfer the owner only when every path independently qualifies.
-- Every other update recovers the existing fresh-construction form.
import:
	compiler_core_json:
		CoreConstructorLiteralMatch,
		CoreConstructorMatchBody(
			ConstructorMatchBodyExpr,
			ConstructorMatchBodyLength,
			ConstructorMatchBodyLiteral,
		),
		CoreConstructorMatchCase,
		CoreConstructorMatchFallback(
			ConstructorMatchFallbackBindings,
			ConstructorMatchFallbackBody,
			ConstructorMatchFallbackFail,
		),
		CoreDecl(FunctionDecl, GlobalDecl, HeapRecordDecl, ImplDecl),
		CoreExpr(
			AssignExpr,
			ConstructorMatchExpr,
			FieldExpr,
			IfExpr,
			LetExpr,
			RecordExpr,
			RecordReuseExpr,
			RecordUpdateExpr,
			SeqExpr,
			VarExpr,
			LiteralMatchExpr,
		),
		CoreFunction,
		CoreLiteralMatchCase,
		CoreLiteralMatchFallback(
			LiteralMatchFallbackBindings,
			LiteralMatchFallbackBody,
			LiteralMatchFallbackFail,
		),
		CoreProgram,
		CoreRecordFieldValue,
		CoreReleasePolicy,
		CoreSourceLoc,
		CoreType(HeapRecordType),
		CoreVar,
		core_expr_type,
	compiler_core_traverse as CoreTraverse


private COMPILER_LOCAL_PREFIX: String = "$blorp$record_update$"


record RecordUpdateLayer {
	base: CoreVar,
	binding_type: CoreType,
	fields: List[CoreRecordFieldValue],
	result_type: CoreType,
	loc: CoreSourceLoc
}


record RecordUpdateChain {
	source: CoreVar,
	source_type: CoreType,
	source_loc: CoreSourceLoc,
	layers: List[RecordUpdateLayer]
}


record RecordFieldEvaluation {
	variable: CoreVar,
	typ: CoreType,
	rhs: CoreExpr
}


record StagedRecordLayer {
	evaluations: List[RecordFieldEvaluation],
	fields: List[CoreRecordFieldValue]
}


private pure func same_var(left: CoreVar, right: CoreVar) -> Bool:
	left.name == right.name and left.uniq == right.uniq and left.def_id == right.def_id


private pure func same_heap_record_type(left: CoreType, right: CoreType) -> Bool:
	match (left, right):
		(HeapRecordType(left_name), HeapRecordType(right_name)):
			left_name == right_name
		_:
			False


private pure func replace_var(expr: CoreExpr, source: CoreVar, replacement: CoreVar) -> CoreExpr:
	match expr:
		SeqExpr(_, _):
			CoreTraverse.map_core_sequence_items(
				expr,
				func(item): replace_var(item, source, replacement),
			)
		_:
			mapped: CoreExpr = CoreTraverse.map_core_expr_children(
				expr,
				func(child): replace_var(child, source, replacement),
			)

			match mapped:
				VarExpr(variable, typ, loc):
					if same_var(variable, source):
						VarExpr(replacement, typ, loc)
					else:
						mapped
				_:
					mapped


private pure func replace_record_field_var(
	field: CoreRecordFieldValue,
	source: CoreVar,
	replacement: CoreVar,
) -> CoreRecordFieldValue:
	{ field | value = replace_var(field.value, source, replacement) }


private pure func expr_assigns_var(expr: CoreExpr, target: CoreVar) -> Bool:
	match expr:
		AssignExpr(variable, _, _, _):
			if same_var(variable, target):
				True
			else:
				CoreTraverse
					.immediate_core_expr_children(expr)
					.any(func(child): expr_assigns_var(child, target))
		SeqExpr(_, _):
			spine = CoreTraverse.split_core_sequence(expr)

			(
				spine.preceding_items.any(func(item): expr_assigns_var(item, target))
				or expr_assigns_var(spine.final_item, target)
			)
		_:
			CoreTraverse
				.immediate_core_expr_children(expr)
				.any(func(child): expr_assigns_var(child, target))


private pure func record_fields_assign_var(
	fields: List[CoreRecordFieldValue],
	target: CoreVar,
) -> Bool:
	fields.any(func(field): expr_assigns_var(field.value, target))


private pure func expr_touches_var(expr: CoreExpr, target: CoreVar) -> Bool:
	match expr:
		VarExpr(variable, typ, loc):
			same_var(variable, target)
		SeqExpr(_, _):
			spine = CoreTraverse.split_core_sequence(expr)

			(
				spine.preceding_items.any(func(item): expr_touches_var(item, target))
				or expr_touches_var(spine.final_item, target)
			)
		_:
			CoreTraverse
				.immediate_core_expr_children(expr)
				.any(func(child): expr_touches_var(child, target))


private pure func record_fields_assign_target(
	layers: List[RecordUpdateLayer],
	target: CoreVar,
) -> Bool:
	layers.any(func(layer): record_fields_assign_var(layer.fields, target))


private pure func declared_heap_record_names(decls: List[CoreDecl]) -> List[String]:
	var names: List[String] = []

	for decl in decls:
		match decl:
			HeapRecordDecl(record_decl):
				names = names.append(record_decl.name)
			_:
				void

	names


private pure func declared_heap_record_type(record_names: List[String], typ: CoreType) -> Bool:
	match typ:
		HeapRecordType(name):
			record_names.contains(name)
		_:
			False


private pure func materialize_record_update(expr: CoreExpr) -> CoreExpr:
	match expr:
		RecordUpdateExpr(base, fields, typ, loc):
			RecordExpr(fields, typ, loc)
		_:
			expr


private pure func materialize_mapped_record_update(
	record_names: List[String],
	expr: CoreExpr,
) -> CoreExpr:
	materialize_record_update(CoreTraverse.map_core_expr_children(
			expr,
			func(child): prepare_record_update_expr(record_names, child),
		))


private pure func record_update_chain(expr: CoreExpr) -> Option[RecordUpdateChain]:
	match expr:
		LetExpr(base, False, binding_type, initial, body):
			match body:
				RecordUpdateExpr(carrier, fields, result_type, loc):
					match carrier:
						VarExpr(carrier_base, carrier_type, _):
							if (
								same_var(base, carrier_base)
								and same_heap_record_type(binding_type, carrier_type)
								and same_heap_record_type(binding_type, result_type)
							):
								layer: RecordUpdateLayer = {
									base = base,
									binding_type = binding_type,
									fields = fields,
									result_type = result_type,
									loc = loc
								}

								match initial:
									VarExpr(source, source_type, source_loc):
										if same_heap_record_type(source_type, binding_type):
											Some({
												source = source,
												source_type = source_type,
												source_loc = source_loc,
												layers = [layer],
											})
										else:
											None
									_:
										match record_update_chain(initial):
											Some(chain):
												match chain.layers.last():
													Some(previous_layer):
														if same_heap_record_type(
															previous_layer.result_type,
															binding_type,
														):
															Some(
																{ chain |
																	layers = chain.layers.append(
																		layer,
																	)
																},
															)
														else:
															None
													None:
														None
											None:
												None
							else:
								None
						_:
							None
				_:
					None
		_:
			None


private pure func chain_uses_declared_heap_record(
	record_names: List[String],
	chain: RecordUpdateChain,
) -> Bool:
	(
		declared_heap_record_type(record_names, chain.source_type)
		and chain.layers.all(
			func(
				layer,
			): (
				same_heap_record_type(chain.source_type, layer.binding_type)
				and same_heap_record_type(chain.source_type, layer.result_type)
			),
		)
	)


private pure func inherited_record_field(field: CoreRecordFieldValue, base: CoreVar) -> Bool:
	match field.value:
		FieldExpr(VarExpr(variable, owner_type, owner_loc), projected_field, field_type, field_loc):
			same_var(variable, base) and projected_field == field.name
		_:
			False


private pure func staged_field_variable(base: CoreVar, field_index: Int) -> CoreVar:
	{
		name = COMPILER_LOCAL_PREFIX + "field$" + base.name + "$" + base.uniq.to_string() + "$" + field_index.to_string(),
		uniq = base.uniq,
		def_id = None
	}


private pure func staged_field_with_value(
	layer: RecordUpdateLayer,
	field: CoreRecordFieldValue,
	field_index: Int,
	value: CoreExpr,
) -> StagedRecordLayer:
	field_type: CoreType = core_expr_type(value)
	variable: CoreVar = staged_field_variable(layer.base, field_index)
	{
		evaluations = [
			{
				variable = variable,
				typ = field_type,
				rhs = value
			},
		],
		fields = [
			{
				name = field.name,
				value = VarExpr(variable, field_type, layer.loc)
			},
		]
	}


private pure func previous_staged_field(
	fields: List[CoreRecordFieldValue],
	name: String,
) -> Option[CoreExpr]:
	fields
		.find(func(field): field.name == name)
		.map(func(field): field.value)


private pure func resolve_staged_field(
	record_names: List[String],
	target: CoreVar,
	layer: RecordUpdateLayer,
	previous_fields: Option[List[CoreRecordFieldValue]],
	field: CoreRecordFieldValue,
) -> Option[CoreExpr]:
	match previous_fields:
		None:
			Some(
				replace_var(
					prepare_record_update_expr(record_names, field.value),
					layer.base,
					target,
				),
			)
		Some(fields):
			if inherited_record_field(field, layer.base):
				previous_staged_field(fields, field.name)
			else:
				prepared: CoreExpr = prepare_record_update_expr(record_names, field.value)

				if expr_touches_var(prepared, layer.base):
					None
				else:
					Some(prepared)


private pure func stage_record_layer(
	record_names: List[String],
	target: CoreVar,
	layer: RecordUpdateLayer,
	previous_fields: Option[List[CoreRecordFieldValue]],
) -> Option[StagedRecordLayer]:
	var evaluations: List[RecordFieldEvaluation] = []
	var staged_fields: List[CoreRecordFieldValue] = []
	var failed: Bool = False
	var field_index: Int = 0

	for field in layer.fields:
		match resolve_staged_field(record_names, target, layer, previous_fields, field):
			Some(value):
				staged: StagedRecordLayer = staged_field_with_value(
					layer,
					field,
					field_index,
					value,
				)
				evaluations = evaluations.concat(staged.evaluations)
				staged_fields = staged_fields.concat(staged.fields)
			None:
				failed = True
				break

		field_index += 1

	if failed:
		None
	else:
		Some({
			evaluations = evaluations,
			fields = staged_fields,
		})


private pure func wrap_record_field_evaluations(
	evaluations: List[RecordFieldEvaluation],
	body: CoreExpr,
) -> CoreExpr:
	var wrapped: CoreExpr = body

	for evaluation in evaluations.reverse():
		wrapped = LetExpr(evaluation.variable, False, evaluation.typ, evaluation.rhs, wrapped)

	wrapped


private pure func prepare_nested_record_reuse_value(
	record_names: List[String],
	target: CoreVar,
	rhs: CoreExpr,
) -> Option[CoreExpr]:
	match record_update_chain(rhs):
		Some(chain):
			if (
				chain.layers.length() > 1
				and same_var(target, chain.source)
				and chain_uses_declared_heap_record(record_names, chain)
				and not record_fields_assign_target(chain.layers, target)
			):
				var evaluations: List[RecordFieldEvaluation] = []
				var previous_fields: Option[List[CoreRecordFieldValue]] = None
				var final_type: CoreType = chain.source_type
				var final_loc: CoreSourceLoc = chain.source_loc
				var failed: Bool = False

				for layer in chain.layers:
					match stage_record_layer(record_names, target, layer, previous_fields):
						Some(staged):
							evaluations = evaluations.concat(staged.evaluations)
							previous_fields = Some(staged.fields)
							final_type = layer.result_type
							final_loc = layer.loc
						None:
							failed = True
							break

				if failed:
					None
				else:
					match previous_fields:
						Some(fields):
							reuse: CoreExpr = RecordReuseExpr(
								VarExpr(target, chain.source_type, chain.source_loc),
								fields,
								final_type,
								final_loc,
							)
							Some(wrap_record_field_evaluations(evaluations, reuse))
						None:
							None
			else:
				None
		None:
			None


private pure func prepare_canonical_record_reuse_value(
	record_names: List[String],
	target: CoreVar,
	update_base: CoreVar,
	binding_type: CoreType,
	source: CoreVar,
	source_type: CoreType,
	source_loc: CoreSourceLoc,
	body: CoreExpr,
) -> Option[CoreExpr]:
	match body:
		RecordUpdateExpr(base, fields, result_type, update_loc):
			match base:
				VarExpr(carrier_base, carrier_base_type, _):
					if (
						same_var(target, source)
						and same_var(update_base, carrier_base)
						and same_heap_record_type(binding_type, source_type)
						and same_heap_record_type(binding_type, carrier_base_type)
						and same_heap_record_type(binding_type, result_type)
						and declared_heap_record_type(record_names, result_type)
						and not record_fields_assign_var(fields, target)
					):
						prepared_fields: List[CoreRecordFieldValue] = fields.map(
							func(
								field,
							): { field |
								value = prepare_record_update_expr(record_names, field.value)
							},
						)
						reused_fields: List[CoreRecordFieldValue] = prepared_fields.map(
							func(field): replace_record_field_var(field, update_base, target),
						)

						Some(
							RecordReuseExpr(
								VarExpr(target, source_type, source_loc),
								reused_fields,
								result_type,
								update_loc,
							),
						)
					else:
						None
				_:
					None
		_:
			None


private pure func prepare_typed_record_reuse_value(
	record_names: List[String],
	target: CoreVar,
	expected_type: CoreType,
	result: CoreExpr,
) -> Option[CoreExpr]:
	match prepare_record_reuse_value(record_names, target, result):
		Some(prepared):
			if same_heap_record_type(expected_type, core_expr_type(prepared)):
				Some(prepared)
			else:
				None
		None:
			None


private pure func prepare_constructor_match_body_reuse(
	record_names: List[String],
	target: CoreVar,
	expected_type: CoreType,
	body: CoreConstructorMatchBody,
) -> Option[CoreConstructorMatchBody]:
	match body:
		ConstructorMatchBodyExpr(result):
			prepare_typed_record_reuse_value(
				record_names,
				target,
				expected_type,
				result,
			).map(
				func(prepared): ConstructorMatchBodyExpr(prepared),
			)
		ConstructorMatchBodyLiteral(match_expr):
			if same_heap_record_type(expected_type, match_expr.result_type):
				prepare_constructor_literal_match_reuse(
					record_names,
					target,
					match_expr,
				).map(
					func(prepared): ConstructorMatchBodyLiteral(prepared),
				)
			else:
				None
		ConstructorMatchBodyLength(_):
			None


private pure func prepare_constructor_match_cases_reuse(
	record_names: List[String],
	target: CoreVar,
	expected_type: CoreType,
	cases: List[CoreConstructorMatchCase],
) -> Option[List[CoreConstructorMatchCase]]:
	var prepared_cases: List[CoreConstructorMatchCase] = []
	var failed: Bool = False

	for match_case in cases:
		match prepare_constructor_match_body_reuse(
			record_names,
			target,
			expected_type,
			match_case.body,
		):
			Some(body):
				prepared_cases = prepared_cases.append({ match_case | body = body })
			None:
				failed = True
				break

	if failed:
		None
	else:
		Some(prepared_cases)


private pure func prepare_constructor_match_fallback_reuse(
	record_names: List[String],
	target: CoreVar,
	expected_type: CoreType,
	fallback: CoreConstructorMatchFallback,
) -> Option[CoreConstructorMatchFallback]:
	match fallback:
		ConstructorMatchFallbackBody(body):
			prepare_typed_record_reuse_value(
				record_names,
				target,
				expected_type,
				body,
			).map(
				func(prepared): ConstructorMatchFallbackBody(prepared),
			)
		ConstructorMatchFallbackBindings(bindings, body):
			prepare_typed_record_reuse_value(
				record_names,
				target,
				expected_type,
				body,
			).map(
				func(prepared): ConstructorMatchFallbackBindings(bindings, prepared),
			)
		ConstructorMatchFallbackFail:
			Some(ConstructorMatchFallbackFail)


private pure func prepare_constructor_match_reuse_value(
	record_names: List[String],
	target: CoreVar,
	scrutinee: CoreExpr,
	release_policy: CoreReleasePolicy,
	cases: List[CoreConstructorMatchCase],
	fallback: CoreConstructorMatchFallback,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreExpr]:
	if expr_touches_var(scrutinee, target):
		None
	else:
		match (
			prepare_constructor_match_cases_reuse(record_names, target, typ, cases),
			prepare_constructor_match_fallback_reuse(record_names, target, typ, fallback),
		):
			(Some(prepared_cases), Some(prepared_fallback)):
				Some(
					ConstructorMatchExpr(
						prepare_record_update_expr(record_names, scrutinee),
						release_policy,
						prepared_cases,
						prepared_fallback,
						typ,
						loc,
					),
				)
			_:
				None


private pure func prepare_literal_match_cases_reuse(
	record_names: List[String],
	target: CoreVar,
	expected_type: CoreType,
	cases: List[CoreLiteralMatchCase],
) -> Option[List[CoreLiteralMatchCase]]:
	var prepared_cases: List[CoreLiteralMatchCase] = []
	var failed: Bool = False

	for match_case in cases:
		match prepare_typed_record_reuse_value(
			record_names,
			target,
			expected_type,
			match_case.body,
		):
			Some(body):
				prepared_cases = prepared_cases.append({ match_case | body = body })
			None:
				failed = True
				break

	if failed:
		None
	else:
		Some(prepared_cases)


private pure func prepare_literal_match_fallback_reuse(
	record_names: List[String],
	target: CoreVar,
	expected_type: CoreType,
	fallback: CoreLiteralMatchFallback,
) -> Option[CoreLiteralMatchFallback]:
	match fallback:
		LiteralMatchFallbackBody(body):
			prepare_typed_record_reuse_value(
				record_names,
				target,
				expected_type,
				body,
			).map(
				func(prepared): LiteralMatchFallbackBody(prepared),
			)
		LiteralMatchFallbackBindings(bindings, body):
			prepare_typed_record_reuse_value(
				record_names,
				target,
				expected_type,
				body,
			).map(
				func(prepared): LiteralMatchFallbackBindings(bindings, prepared),
			)
		LiteralMatchFallbackFail:
			Some(LiteralMatchFallbackFail)


private pure func prepare_constructor_literal_match_reuse(
	record_names: List[String],
	target: CoreVar,
	match_expr: CoreConstructorLiteralMatch,
) -> Option[CoreConstructorLiteralMatch]:
	match (
		prepare_literal_match_cases_reuse(
			record_names,
			target,
			match_expr.result_type,
			match_expr.cases,
		),
		prepare_literal_match_fallback_reuse(
			record_names,
			target,
			match_expr.result_type,
			match_expr.fallback,
		),
	):
		(Some(prepared_cases), Some(prepared_fallback)):
			Some({ match_expr |
					cases = prepared_cases,
					fallback = prepared_fallback
				})
		_:
			None


private pure func prepare_literal_match_reuse_value(
	record_names: List[String],
	target: CoreVar,
	scrutinee: CoreExpr,
	cases: List[CoreLiteralMatchCase],
	fallback: CoreLiteralMatchFallback,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreExpr]:
	if expr_touches_var(scrutinee, target):
		None
	else:
		match (
			prepare_literal_match_cases_reuse(record_names, target, typ, cases),
			prepare_literal_match_fallback_reuse(record_names, target, typ, fallback),
		):
			(Some(prepared_cases), Some(prepared_fallback)):
				Some(
					LiteralMatchExpr(
						prepare_record_update_expr(record_names, scrutinee),
						prepared_cases,
						prepared_fallback,
						typ,
						loc,
					),
				)
			_:
				None


private pure func prepare_immutable_let_reuse_value(
	record_names: List[String],
	target: CoreVar,
	variable: CoreVar,
	binding_type: CoreType,
	initial: CoreExpr,
	body: CoreExpr,
) -> Option[CoreExpr]:
	canonical: Option[CoreExpr] = match initial:
		VarExpr(source, source_type, source_loc):
			prepare_canonical_record_reuse_value(
				record_names,
				target,
				variable,
				binding_type,
				source,
				source_type,
				source_loc,
				body,
			)
		_:
			None

	match canonical:
		Some(prepared):
			Some(prepared)
		None:
			if same_var(variable, target) or expr_touches_var(initial, target):
				None
			else:
				prepare_record_reuse_value(
					record_names,
					target,
					body,
				).map(
					func(prepared_body): LetExpr(
						variable,
						False,
						binding_type,
						prepare_record_update_expr(record_names, initial),
						prepared_body,
					),
				)


private pure func prepare_record_reuse_value(
	record_names: List[String],
	target: CoreVar,
	rhs: CoreExpr,
) -> Option[CoreExpr]:
	match rhs:
		IfExpr(cond, then_expr, else_expr, typ, loc):
			if expr_assigns_var(cond, target):
				None
			else:
				match (
					prepare_record_reuse_value(record_names, target, then_expr),
					prepare_record_reuse_value(record_names, target, else_expr),
				):
					(Some(prepared_then), Some(prepared_else)):
						if (
							same_heap_record_type(typ, core_expr_type(prepared_then))
							and same_heap_record_type(typ, core_expr_type(prepared_else))
						):
							Some(
								IfExpr(
									prepare_record_update_expr(record_names, cond),
									prepared_then,
									prepared_else,
									typ,
									loc,
								),
							)
						else:
							None
					_:
						None
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			prepare_constructor_match_reuse_value(
				record_names,
				target,
				scrutinee,
				release_policy,
				cases,
				fallback,
				typ,
				loc,
			)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			prepare_literal_match_reuse_value(
				record_names,
				target,
				scrutinee,
				cases,
				fallback,
				typ,
				loc,
			)
		_:
			match prepare_nested_record_reuse_value(record_names, target, rhs):
				Some(prepared):
					Some(prepared)
				None:
					match rhs:
						LetExpr(update_base, False, binding_type, initial, body):
							prepare_immutable_let_reuse_value(
								record_names,
								target,
								update_base,
								binding_type,
								initial,
								body,
							)
						_:
							None


private pure func prepare_record_update_expr(
	record_names: List[String],
	expr: CoreExpr,
) -> CoreExpr:
	match expr:
		SeqExpr(_, _):
			CoreTraverse.map_core_sequence_items(
				expr,
				func(item): prepare_record_update_expr(record_names, item),
			)
		AssignExpr(target, rhs, typ, loc):
			match prepare_record_reuse_value(record_names, target, rhs):
				Some(prepared_rhs):
					AssignExpr(target, prepared_rhs, typ, loc)
				None:
					materialize_mapped_record_update(record_names, expr)
		_:
			materialize_mapped_record_update(record_names, expr)


private pure func lower_record_update_function(
	record_names: List[String],
	function_info: CoreFunction,
) -> CoreFunction:
	body: Option[CoreExpr] = match function_info.body:
		Some(expr):
			Some(prepare_record_update_expr(record_names, expr))
		None:
			None

	{ function_info | body = body }


private pure func lower_record_update_decl(record_names: List[String], decl: CoreDecl) -> CoreDecl:
	match decl:
		FunctionDecl(function_info):
			FunctionDecl(lower_record_update_function(record_names, function_info))
		GlobalDecl(global):
			GlobalDecl({ global | init = prepare_record_update_expr(record_names, global.init) })
		ImplDecl(impl):
			ImplDecl(
				{ impl |
					methods = impl.methods.map(
						func(method): lower_record_update_function(record_names, method),
					)
				},
			)
		_:
			decl


pure func lower_record_updates_for_ownership(program: CoreProgram) -> CoreProgram:
	record_names: List[String] = declared_heap_record_names(program.decls)
	{ program |
		decls = program.decls.map(func(decl): lower_record_update_decl(record_names, decl))
	}


private pure func expr_contains_record_update(expr: CoreExpr) -> Bool:
	match expr:
		RecordUpdateExpr(_, _, _, _):
			True
		SeqExpr(_, _):
			spine = CoreTraverse.split_core_sequence(expr)

			(
				spine.preceding_items.any(expr_contains_record_update)
				or expr_contains_record_update(spine.final_item)
			)
		_:
			CoreTraverse
				.immediate_core_expr_children(expr)
				.any(expr_contains_record_update)


private pure func function_contains_record_update(function_info: CoreFunction) -> Bool:
	match function_info.body:
		Some(body):
			expr_contains_record_update(body)
		None:
			False


private pure func decl_contains_record_update(decl: CoreDecl) -> Bool:
	match decl:
		FunctionDecl(function_info):
			function_contains_record_update(function_info)
		GlobalDecl(global):
			expr_contains_record_update(global.init)
		ImplDecl(impl):
			impl.methods.any(function_contains_record_update)
		_:
			False


pure func record_update_carrier_survives(program: CoreProgram) -> Bool:
	program.decls.any(decl_contains_record_update)
