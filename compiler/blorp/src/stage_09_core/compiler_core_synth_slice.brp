-- Core body synthesis for std/slice.
--
-- StringSlice operations stay in ordinary Core so bounds handling, loops, and
-- Option construction remain visible to the ownership and optimization passes.
import:
	compiler_core_json:
		CoreBinaryOp(AddOp, GreaterEqualOp, GreaterOp, LessOp, NotEqualOp, SubtractOp),
		CoreBoxKind(PrimBox),
		CoreCallKind(BuiltinCall, IntrinsicCall),
		CoreExpr(
			AssignExpr,
			BinaryExpr,
			BoxExpr,
			BreakExpr,
			CallExpr,
			ForRangeExpr,
			IfExpr,
			LetExpr,
			LiteralExpr,
			LogicalExpr,
			SeqExpr,
			VarExpr,
			VoidExpr,
		),
		CoreFunction,
		CoreLiteral(BoolLiteral, IntLiteral),
		CoreLogicalOp(OrOp),
		CoreLoopBinder,
		CoreLoopRangeDirection(RangeForwardOnly),
		CoreParam,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType, VoidType),
		CoreVar,
	compiler_core_synth_name: is_synthesis_candidate, synthesis_source_name


private SLICE_MODULE: String = "std/slice"

private INT_TYPE: CoreType = NamedType("Int", [])

private BOOL_TYPE: CoreType = NamedType("Bool", [])

private STRING_TYPE: CoreType = NamedType("String", [])

private SLICE_TYPE: CoreType = NamedType("StringSlice", [])

private CHAR_TYPE: CoreType = NamedType("Char", [])

private POINTER_TYPE: CoreType = NamedType("Ptr", [])


private pure func core_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


private pure func variable(name: String, typ: CoreType) -> CoreExpr:
	VarExpr(core_var(name), typ, SyntheticSourceLoc)


private pure func int_literal(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), INT_TYPE, SyntheticSourceLoc)


private pure func bool_literal(value: Bool) -> CoreExpr:
	LiteralExpr(BoolLiteral(value), BOOL_TYPE, SyntheticSourceLoc)


private pure func intrinsic_call(
	name: String,
	args: List[CoreExpr],
	return_type: CoreType,
) -> CoreExpr:
	CallExpr(
		IntrinsicCall(name),
		VoidExpr(VoidType, SyntheticSourceLoc),
		args,
		return_type,
		SyntheticSourceLoc,
	)


private pure func builtin_call(
	name: String,
	args: List[CoreExpr],
	return_type: CoreType,
) -> CoreExpr:
	CallExpr(
		BuiltinCall(name),
		VoidExpr(VoidType, SyntheticSourceLoc),
		args,
		return_type,
		SyntheticSourceLoc,
	)


private pure func binary(
	op: CoreBinaryOp,
	left: CoreExpr,
	right: CoreExpr,
	return_type: CoreType,
) -> CoreExpr:
	BinaryExpr(op, left, right, return_type, SyntheticSourceLoc)


private pure func logical_or(left: CoreExpr, right: CoreExpr) -> CoreExpr:
	LogicalExpr(OrOp, left, right, BOOL_TYPE, SyntheticSourceLoc)


private pure func let_expr(
	name: String,
	is_mutable: Bool,
	typ: CoreType,
	rhs: CoreExpr,
	body: CoreExpr,
) -> CoreExpr:
	LetExpr(core_var(name), is_mutable, typ, rhs, body)


private pure func sequence(first: CoreExpr, second: CoreExpr) -> CoreExpr:
	SeqExpr(first, second)


private pure func if_expr(
	condition: CoreExpr,
	then_expr: CoreExpr,
	else_expr: CoreExpr,
	return_type: CoreType,
) -> CoreExpr:
	IfExpr(condition, then_expr, else_expr, return_type, SyntheticSourceLoc)


private pure func assignment(name: String, value: CoreExpr) -> CoreExpr:
	AssignExpr(core_var(name), value, VoidType, SyntheticSourceLoc)


private pure func loop_binder(name: String) -> CoreLoopBinder:
	{
		variable = core_var(name),
		typ = INT_TYPE,
		range_direction = RangeForwardOnly
	}


private pure func for_range(
	name: String,
	start: CoreExpr,
	end_value: CoreExpr,
	body: CoreExpr,
) -> CoreExpr:
	ForRangeExpr(loop_binder(name), start, end_value, body, VoidType, SyntheticSourceLoc)


private pure func type_is_named(typ: CoreType, expected: String) -> Bool:
	match typ:
		NamedType(name, args):
			name == expected and args.is_empty()
		_:
			False


private pure func type_is_option_char(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			match args:
				[inner]:
					name == "Option" and type_is_named(inner, "Char")
				_:
					False
		_:
			False


private pure func param_is_named(params: List[CoreParam], index: Int, expected: String) -> Bool:
	match params.get(index):
		Some(param):
			type_is_named(param.typ, expected)
		None:
			False


private pure func parameter_value(param: CoreParam) -> CoreExpr:
	VarExpr(param.name, param.typ, SyntheticSourceLoc)


private pure func synthesize_from_string(source: CoreExpr) -> CoreExpr:
	intrinsic_call(
		"slice_alloc",
		[source, int_literal(0), intrinsic_call("string_len", [source], INT_TYPE)],
		SLICE_TYPE,
	)


private pure func synthesize_to_string(slice: CoreExpr) -> CoreExpr:
	let_expr(
		"__src",
		False,
		STRING_TYPE,
		intrinsic_call(
			"slice_source",
			[slice],
			STRING_TYPE,
		),
		let_expr(
			"__off",
			False,
			INT_TYPE,
			intrinsic_call(
				"slice_start",
				[slice],
				INT_TYPE,
			),
			let_expr(
				"__slen",
				False,
				INT_TYPE,
				intrinsic_call(
					"slice_len",
					[slice],
					INT_TYPE,
				),
				let_expr(
					"__result",
					False,
					STRING_TYPE,
					intrinsic_call(
						"string_alloc",
						[variable("__slen", INT_TYPE)],
						STRING_TYPE,
					),
					sequence(
						for_range(
							"__i",
							int_literal(0),
							variable(
								"__slen",
								INT_TYPE,
							),
							intrinsic_call(
								"string_set_byte",
								[
									variable("__result", STRING_TYPE),
									variable("__i", INT_TYPE),
									intrinsic_call(
										"string_get_byte",
										[variable("__src", STRING_TYPE), binary(
												AddOp,
												variable("__off", INT_TYPE),
												variable("__i", INT_TYPE),
												INT_TYPE,
											)],
										INT_TYPE,
									),
								],
								VoidType,
							),
						),
						sequence(
							intrinsic_call(
								"string_set_len",
								[variable("__result", STRING_TYPE), variable("__slen", INT_TYPE)],
								VoidType,
							),
							variable(
								"__result",
								STRING_TYPE,
							),
						),
					),
				),
			),
		),
	)


private pure func clamped_start(start: CoreExpr) -> CoreExpr:
	if_expr(
		binary(LessOp, start, int_literal(0), BOOL_TYPE),
		int_literal(0),
		if_expr(
			binary(
				GreaterOp,
				start,
				variable("__total", INT_TYPE),
				BOOL_TYPE,
			),
			variable("__total", INT_TYPE),
			start,
			INT_TYPE,
		),
		INT_TYPE,
	)


private pure func clamped_length(length: CoreExpr) -> CoreExpr:
	max_length: CoreExpr = binary(
		SubtractOp,
		variable("__total", INT_TYPE),
		variable("__start", INT_TYPE),
		INT_TYPE,
	)

	if_expr(
		binary(LessOp, length, int_literal(0), BOOL_TYPE),
		int_literal(0),
		if_expr(
			binary(GreaterOp, length, max_length, BOOL_TYPE),
			max_length,
			length,
			INT_TYPE,
		),
		INT_TYPE,
	)


private pure func synthesize_substring(
	slice: CoreExpr,
	start: CoreExpr,
	length: CoreExpr,
) -> CoreExpr:
	let_expr(
		"__src",
		False,
		STRING_TYPE,
		intrinsic_call(
			"slice_source",
			[slice],
			STRING_TYPE,
		),
		let_expr(
			"__base",
			False,
			INT_TYPE,
			intrinsic_call(
				"slice_start",
				[slice],
				INT_TYPE,
			),
			let_expr(
				"__total",
				False,
				INT_TYPE,
				intrinsic_call(
					"slice_len",
					[slice],
					INT_TYPE,
				),
				let_expr(
					"__start",
					False,
					INT_TYPE,
					clamped_start(start),
					let_expr(
						"__length",
						False,
						INT_TYPE,
						clamped_length(length),
						intrinsic_call(
							"slice_alloc",
							[variable("__src", STRING_TYPE), binary(
									AddOp,
									variable("__base", INT_TYPE),
									variable("__start", INT_TYPE),
									INT_TYPE,
								), variable("__length", INT_TYPE)],
							SLICE_TYPE,
						),
					),
				),
			),
		),
	)


private pure func starts_with_loop_body(
	source: CoreExpr,
	offset: CoreExpr,
	prefix: CoreExpr,
	index: CoreExpr,
) -> CoreExpr:
	slice_byte: CoreExpr = intrinsic_call(
		"string_get_byte",
		[source, binary(AddOp, offset, index, INT_TYPE)],
		INT_TYPE,
	)
	prefix_byte: CoreExpr = intrinsic_call(
		"string_get_byte",
		[prefix, index],
		INT_TYPE,
	)

	if_expr(
		binary(NotEqualOp, slice_byte, prefix_byte, BOOL_TYPE),
		sequence(
			assignment("__matches", bool_literal(False)),
			BreakExpr(VoidType, SyntheticSourceLoc),
		),
		VoidExpr(VoidType, SyntheticSourceLoc),
		VoidType,
	)


private pure func synthesize_starts_with(slice: CoreExpr, prefix: CoreExpr) -> CoreExpr:
	let_expr(
		"__prefix_len",
		False,
		INT_TYPE,
		intrinsic_call("string_len", [prefix], INT_TYPE),
		let_expr(
			"__slice_len",
			False,
			INT_TYPE,
			intrinsic_call("slice_len", [slice], INT_TYPE),
			if_expr(
				binary(
					GreaterOp,
					variable("__prefix_len", INT_TYPE),
					variable("__slice_len", INT_TYPE),
					BOOL_TYPE,
				),
				bool_literal(False),
				let_expr(
					"__src",
					False,
					STRING_TYPE,
					intrinsic_call("slice_source", [slice], STRING_TYPE),
					let_expr(
						"__off",
						False,
						INT_TYPE,
						intrinsic_call("slice_start", [slice], INT_TYPE),
						let_expr(
							"__matches",
							True,
							BOOL_TYPE,
							bool_literal(True),
							sequence(
								for_range(
									"__i",
									int_literal(0),
									variable("__prefix_len", INT_TYPE),
									starts_with_loop_body(
										variable("__src", STRING_TYPE),
										variable("__off", INT_TYPE),
										prefix,
										variable("__i", INT_TYPE),
									),
								),
								variable("__matches", BOOL_TYPE),
							),
						),
					),
				),
				BOOL_TYPE,
			),
		),
	)


private pure func option_none(return_type: CoreType) -> CoreExpr:
	builtin_call("blorp_option_none", [], return_type)


private pure func option_some_char(value: CoreExpr, return_type: CoreType) -> CoreExpr:
	boxed: CoreExpr = BoxExpr(
		{
			kind = PrimBox,
			value = value,
			source_type = INT_TYPE
		},
		POINTER_TYPE,
		SyntheticSourceLoc,
	)
	builtin_call("blorp_option_some", [boxed], return_type)


private pure func synthesize_get(
	slice: CoreExpr,
	index: CoreExpr,
	return_type: CoreType,
) -> CoreExpr:
	let_expr(
		"__slice_len",
		False,
		INT_TYPE,
		intrinsic_call(
			"slice_len",
			[slice],
			INT_TYPE,
		),
		if_expr(
			logical_or(
				binary(LessOp, index, int_literal(0), BOOL_TYPE),
				binary(
					GreaterEqualOp,
					index,
					variable("__slice_len", INT_TYPE),
					BOOL_TYPE,
				),
			),
			option_none(return_type),
			let_expr(
				"__src",
				False,
				STRING_TYPE,
				intrinsic_call(
					"slice_source",
					[slice],
					STRING_TYPE,
				),
				let_expr(
					"__byte",
					False,
					INT_TYPE,
					intrinsic_call(
						"string_get_byte",
						[variable("__src", STRING_TYPE), binary(
								AddOp,
								intrinsic_call("slice_start", [slice], INT_TYPE),
								index,
								INT_TYPE,
							)],
						INT_TYPE,
					),
					option_some_char(
						variable("__byte", INT_TYPE),
						return_type,
					),
				),
			),
			return_type,
		),
	)


private pure func synthesize_named_body(
	name: String,
	params: List[CoreParam],
	return_type: CoreType,
) -> Option[CoreExpr]:
	if (
		name == "from_string"
		and params.length() == 1
		and param_is_named(params, 0, "String")
		and type_is_named(return_type, "StringSlice")
	):
		source ?= params.get(0)
		Some(synthesize_from_string(parameter_value(source)))
	else if (
		name == "length"
		and params.length() == 1
		and param_is_named(params, 0, "StringSlice")
		and type_is_named(return_type, "Int")
	):
		slice ?= params.get(0)
		Some(intrinsic_call("slice_len", [parameter_value(slice)], INT_TYPE))
	else if (
		name == "to_string"
		and params.length() == 1
		and param_is_named(params, 0, "StringSlice")
		and type_is_named(return_type, "String")
	):
		slice ?= params.get(0)
		Some(synthesize_to_string(parameter_value(slice)))
	else if (
		name == "substring"
		and params.length() == 3
		and param_is_named(params, 0, "StringSlice")
		and param_is_named(params, 1, "Int")
		and param_is_named(params, 2, "Int")
		and type_is_named(return_type, "StringSlice")
	):
		slice ?= params.get(0)
		start ?= params.get(1)
		length ?= params.get(2)
		Some(
			synthesize_substring(
				parameter_value(slice),
				parameter_value(start),
				parameter_value(length),
			),
		)
	else if (
		name == "starts_with"
		and params.length() == 2
		and param_is_named(params, 0, "StringSlice")
		and param_is_named(params, 1, "String")
		and type_is_named(return_type, "Bool")
	):
		slice ?= params.get(0)
		prefix ?= params.get(1)
		Some(synthesize_starts_with(parameter_value(slice), parameter_value(prefix)))
	else if (
		name == "get"
		and params.length() == 2
		and param_is_named(params, 0, "StringSlice")
		and param_is_named(params, 1, "Int")
		and type_is_option_char(return_type)
	):
		slice ?= params.get(0)
		index ?= params.get(1)
		Some(synthesize_get(parameter_value(slice), parameter_value(index), return_type))
	else:
		None


pure func synthesize_slice_body(function_info: CoreFunction) -> Option[CoreExpr]:
	if (
		not is_synthesis_candidate(function_info)
		or function_info.source_module != Some(SLICE_MODULE)
	):
		None
	else:
		name ?= synthesis_source_name(function_info)
		synthesize_named_body(name, function_info.params, function_info.return_type)
