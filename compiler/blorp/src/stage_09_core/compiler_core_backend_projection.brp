-- Project semantic Core calls onto the concrete backend ABI.
--
-- Specialization decides which runtime operation a call needs. This pass
-- records how that operation crosses the C boundary. Keeping the projection
-- before DCE and ownership analysis lets those passes reason about callback
-- references and the same ownership contract that emission will use.
import:
	compiler_core_json:
		CoreCallKind(
			BuiltinCall,
			DictWithCapacityCall,
			DirectRuntimeCall,
			IntrinsicCall,
			ListToStringCall,
			TensorParallelCall,
		),
		CoreDecl(EnumDecl, FunctionDecl, GlobalDecl, UnionDecl),
		CoreDirectRuntimeArgs(
			DirectRuntimeArgsAppendListParallelLayout,
			DirectRuntimeArgsAsWritten,
		),
		CoreDirectRuntimeResult(
			DirectRuntimeResultAsWritten,
			DirectRuntimeResultCast,
			DirectRuntimeResultStackResultFromBoxed,
		),
		CoreExpr(
			BoxExpr,
			CallExpr,
			DictConstructExpr,
			DictExpr,
			ListAllocExpr,
			ListGetExpr,
			ListHandoffSetOwnedExpr,
			ListHandoffSetSourceSlotExpr,
			ListRetainExpr,
			ListSetExpr,
			ListSwapExpr,
			SeqExpr,
			SetAllocExpr,
			StringByteCopyExpr,
			StringByteReadExpr,
			StringByteWriteExpr,
			StringSetLenExpr,
			TensorRawFillExpr,
			VarExpr,
		),
		CoreFunction,
		CoreHashContainerConstructor(
			CustomHashContainerConstructor,
			FloatHashContainerConstructor,
			GenericHashContainerConstructor,
			StringHashContainerConstructor,
		),
		CoreListAccessBounds(CheckedListAccess, ProvenListAccess),
		CoreListStorageLayout(InlineListStorage, InlineStructListStorage, PointerListStorage),
		CoreProgram,
		CoreSourceLoc,
		CoreTensorParallelLayout(
			TensorParallelInlineStructLayout,
			TensorParallelPointerLayout,
			TensorParallelRawScalarLayout,
		),
		CoreTensorRawScalarKind(TensorFloat32Elements, TensorFloat64Elements, TensorInt64Elements),
		CoreType(
			BoxedResultType,
			EnumType,
			NamedType,
			StackResultType,
			TensorType,
			UnionType,
			ValueRecordType,
			VoidType,
		),
		CoreVar,
		core_expr_type,
	compiler_core_operation_metadata:
		fallible_stream_terminal_builtin,
		fallible_stream_terminal_call_kind,
		operation_result_builtin,
		operation_result_call_kind,
	compiler_core_ownership:
		builtin_contract,
		runtime_builtin_has_erased_arguments,
		runtime_builtin_uses_erased_argument,
	compiler_core_specialize_layout:
		CoreOptionRuntimeLayout(BoxedOptionLayout),
		CoreSpecializeLayout,
		boxed_storage_kind,
		boxed_storage_needs_release,
		boxed_storage_value,
		build_specialize_layout,
		generic_hash_container_type_name,
		list_retain_storage_value,
		named_type_arguments,
		option_runtime_layout,
		resolve_specialize_type,
		single_named_type_argument,
		specialize_list_element_needs_release,
		specialize_list_layout,
		specialize_type_is_pointer,
	compiler_core_trait_resolve: core_trait_impl_type_key
	compiler_core_traverse as CoreTraverse


private LIST_STORAGE_POINTER: String = "BLORP_LIST_STORAGE_POINTER"

private LIST_STORAGE_INLINE: String = "BLORP_LIST_STORAGE_INLINE"

private LIST_CALLBACK_BITS: String = "BLORP_LIST_CALLBACK_BITS"

private LIST_CALLBACK_BOXED_STRUCT: String = "BLORP_LIST_CALLBACK_BOXED_STRUCT"

private POINTER_TYPE: CoreType = NamedType("Ptr", [])


private pure func function_names(program: CoreProgram) -> List[String]:
	var names: List[String] = []

	for decl in program.decls:
		match decl:
			FunctionDecl(function_info):
				names = names.append(function_info.name)
			_:
				void

	names


private pure func find_function_name(names: List[String], expected: String) -> Option[String]:
	var result: Option[String] = None
	suffix: String = "_" + expected

	for name in names:
		if name == expected or name.ends_with(suffix):
			result = Some(name)
			break

	result


private pure func result_is_option(layout: CoreSpecializeLayout, typ: CoreType) -> Bool:
	match resolve_specialize_type(layout, typ):
		NamedType("Option", args):
			args.length() == 1
		_:
			False


private pure func result_is_result(layout: CoreSpecializeLayout, typ: CoreType) -> Bool:
	match resolve_specialize_type(layout, typ):
		NamedType("Result", args):
			args.length() == 2
		StackResultType(_, _) | BoxedResultType(_, _):
			True
		_:
			False


private pure func semantic_builtin(
	layout: CoreSpecializeLayout,
	name: String,
	result_type: CoreType,
) -> Bool:
	if name == "blorp_dict_get":
		result_is_option(layout, result_type)
	else if name == "blorp_option_some" or name == "blorp_option_none":
		result_is_option(layout, result_type)
	else if name == "blorp_result_ok" or name == "blorp_result_err":
		result_is_result(layout, result_type)
	else if (
		name == "blorp_vector_get_opt"
		or name == "blorp_matrix_get_opt"
		or name == "blorp_channel_new"
		or name == "blorp_channel_send"
		or name == "blorp_channel_try_send"
		or name == "blorp_channel_try_send_status"
		or name == "blorp_channel_send_timeout"
		or name == "blorp_channel_send_timeout_status"
		or name == "blorp_channel_try_send_attempt"
		or name == "blorp_channel_send_timeout_attempt"
		or name == "blorp_channel_try_recv_attempt"
		or name == "blorp_channel_recv_timeout_attempt"
	):
		True
	else:
		False


private pure func list_parallel_builtin(name: String) -> Bool:
	(
		name == "blorp_filter_parallel"
		or name == "blorp_filter_parallel_with"
		or name == "blorp_map_parallel"
		or name == "blorp_map_parallel_with"
		or name == "blorp_zip_parallel"
		or name == "blorp_zip_parallel_with"
		or name.starts_with("blorp_filter_map_parallel")
	)


private pure func list_parallel_arity(name: String) -> Option[(Int, Int)]:
	if name == "blorp_map_parallel":
		Some((3, 6))
	else if name == "blorp_zip_parallel":
		Some((4, 7))
	else if name == "blorp_map_parallel_with":
		Some((4, 7))
	else if name == "blorp_zip_parallel_with":
		Some((5, 8))
	else if name.starts_with("blorp_filter_map_parallel"):
		Some((3, 6))
	else:
		None


private pure func list_parallel_args(
	layout: CoreSpecializeLayout,
	name: String,
	result_type: CoreType,
) -> CoreDirectRuntimeArgs:
	match list_parallel_arity(name):
		Some((semantic_arity, runtime_arity)):
			match specialize_list_layout(layout, result_type):
				PointerListStorage:
					DirectRuntimeArgsAppendListParallelLayout({
						semantic_arity = semantic_arity,
						runtime_arity = runtime_arity,
						storage_mode = LIST_STORAGE_POINTER,
						elem_size = "sizeof(void*)",
						value_encoding = LIST_CALLBACK_BITS,
					})
				InlineListStorage(width):
					DirectRuntimeArgsAppendListParallelLayout({
						semantic_arity = semantic_arity,
						runtime_arity = runtime_arity,
						storage_mode = LIST_STORAGE_INLINE,
						elem_size = width.to_string(),
						value_encoding = LIST_CALLBACK_BITS,
					})
				InlineStructListStorage(c_type):
					DirectRuntimeArgsAppendListParallelLayout({
						semantic_arity = semantic_arity,
						runtime_arity = runtime_arity,
						storage_mode = LIST_STORAGE_INLINE,
						elem_size = "sizeof(${c_type})",
						value_encoding = LIST_CALLBACK_BOXED_STRUCT,
					})
		None:
			DirectRuntimeArgsAsWritten


private pure func direct_runtime_result(
	name: String,
	result_type: CoreType,
) -> CoreDirectRuntimeResult:
	match result_type:
		StackResultType(_, _):
			DirectRuntimeResultStackResultFromBoxed
		_:
			if list_parallel_builtin(name):
				DirectRuntimeResultCast("blorp_List*")
			else if (
				name == "blorp_tensor_add_scaled_f64_cow"
				or name == "blorp_tensor_add_scaled_f32_cow"
			):
				DirectRuntimeResultCast("blorp_Vector*")
			else:
				DirectRuntimeResultAsWritten


private pure func direct_runtime_call(
	layout: CoreSpecializeLayout,
	name: String,
	result_type: CoreType,
) -> CoreCallKind:
	DirectRuntimeCall({
		name = name,
		args = list_parallel_args(layout, name, result_type),
		result = direct_runtime_result(name, result_type),
	})


private pure func tensor_parallel_builtin(name: String) -> Bool:
	(
		name == "blorp_matrix_map"
		or name == "blorp_matrix_map_indexed"
		or name == "blorp_matrix_zip_map"
		or name == "blorp_mmap_flat_indexed_parallel"
		or name == "blorp_mmap_indexed_parallel"
		or name == "blorp_mmap_parallel"
		or name == "blorp_mzip_indexed_parallel"
		or name == "blorp_mzip_parallel"
		or name == "blorp_vmap_parallel"
		or name == "blorp_vmap_indexed_parallel"
		or name == "blorp_vzip_parallel"
	)


private pure func tensor_parallel_layout(
	layout: CoreSpecializeLayout,
	result_type: CoreType,
) -> CoreTensorParallelLayout:
	match resolve_specialize_type(layout, result_type):
		TensorType(info):
			match resolve_specialize_type(layout, info.element_type):
				NamedType("Float", []):
					TensorParallelRawScalarLayout(TensorFloat64Elements)
				NamedType("Float32", []):
					TensorParallelRawScalarLayout(TensorFloat32Elements)
				NamedType("Int", []):
					TensorParallelRawScalarLayout(TensorInt64Elements)
				ValueRecordType(name):
					TensorParallelInlineStructLayout(name)
				_:
					TensorParallelPointerLayout
		_:
			TensorParallelPointerLayout


private pure func ranked_tensor_fill(name: String) -> Bool:
	name == "blorp_tensor3_new" or name == "blorp_tensor4_new" or name == "blorp_tensor5_new"


private pure func tensor_raw_fill_kind(
	layout: CoreSpecializeLayout,
	result_type: CoreType,
) -> Option[CoreTensorRawScalarKind]:
	match resolve_specialize_type(layout, result_type):
		TensorType(info):
			match resolve_specialize_type(layout, info.element_type):
				NamedType("Int", []):
					Some(TensorInt64Elements)
				NamedType("Float", []):
					Some(TensorFloat64Elements)
				NamedType("Float32", []):
					Some(TensorFloat32Elements)
				_:
					None
		_:
			None


private pure func project_ranked_tensor_fill(
	layout: CoreSpecializeLayout,
	name: String,
	args: List[CoreExpr],
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreExpr]:
	if not ranked_tensor_fill(name):
		None
	else:
		match args:
			[value, ...dims]:
				raw_kind ?= tensor_raw_fill_kind(layout, result_type)
				Some(
					TensorRawFillExpr(
						{
							raw_kind = raw_kind,
							value = value,
							dims = dims
						},
						result_type,
						loc,
					),
				)
			[]:
				None


private pure func list_callback_call_kind(
	layout: CoreSpecializeLayout,
	names: List[String],
	args: List[CoreExpr],
) -> Option[CoreCallKind]:
	if args.length() != 1:
		None
	else:
		list_arg ?= args.get(0)

		element_type ?= match resolve_specialize_type(layout, core_expr_type(list_arg)):
			NamedType("List", element_types):
				if element_types.length() == 1:
					element_types.get(0)
				else:
					None
			_:
				None

		element_key ?= core_trait_impl_type_key(element_type)
		callback ?= find_function_name(names, "Stringable_to_string_" + element_key)
		Some(ListToStringCall(callback))


private pure func custom_hash_container_constructor(
	layout: CoreSpecializeLayout,
	names: List[String],
	key_type: CoreType,
) -> Option[CoreHashContainerConstructor]:
	key: CoreType = resolve_specialize_type(layout, key_type)
	key_name ?= core_trait_impl_type_key(key)
	hash_fn ?= find_function_name(names, "Hashable_hash_" + key_name)
	equals_fn ?= find_function_name(names, "Equatable_equals_" + key_name)

	Some(
		CustomHashContainerConstructor(
			hash_fn,
			equals_fn,
			boxed_storage_needs_release(layout, key),
		),
	)


private pure func custom_dict_constructor(
	layout: CoreSpecializeLayout,
	names: List[String],
	result_type: CoreType,
) -> Option[CoreHashContainerConstructor]:
	dict_types ?= named_type_arguments(layout, result_type, "Dict")

	key_type ?= if dict_types.length() == 2:
		dict_types.get(0)
	else:
		None

	custom_hash_container_constructor(layout, names, key_type)


private pure func custom_set_constructor(
	layout: CoreSpecializeLayout,
	names: List[String],
	result_type: CoreType,
) -> Option[CoreHashContainerConstructor]:
	set_types ?= named_type_arguments(layout, result_type, "Set")

	element_type ?= if set_types.length() == 1:
		set_types.get(0)
	else:
		None

	custom_hash_container_constructor(layout, names, element_type)


private pure func hash_container_constructor(
	layout: CoreSpecializeLayout,
	names: List[String],
	key_type: CoreType,
) -> Option[CoreHashContainerConstructor]:
	key: CoreType = resolve_specialize_type(layout, key_type)

	match key:
		NamedType(name, args):
			if name == "String" and args.is_empty():
				Some(StringHashContainerConstructor)
			else if (name == "Float" or name == "Float32" or name == "Float16") and args.is_empty():
				Some(FloatHashContainerConstructor)
			else if generic_hash_container_type_name(name):
				Some(GenericHashContainerConstructor)
			else:
				custom_hash_container_constructor(layout, names, key)
		EnumType(_):
			Some(GenericHashContainerConstructor)
		_:
			custom_hash_container_constructor(layout, names, key)


private pure func set_constructor(
	layout: CoreSpecializeLayout,
	names: List[String],
	result_type: CoreType,
) -> Option[CoreHashContainerConstructor]:
	set_types ?= named_type_arguments(layout, result_type, "Set")

	element_type ?= if set_types.length() == 1:
		set_types.get(0)
	else:
		None

	hash_container_constructor(layout, names, element_type)


private pure func custom_dict_call_kind(
	layout: CoreSpecializeLayout,
	names: List[String],
	result_type: CoreType,
) -> Option[CoreCallKind]:
	constructor ?= custom_dict_constructor(layout, names, result_type)
	Some(DictWithCapacityCall(constructor))


private pure func project_empty_custom_dict(
	layout: CoreSpecializeLayout,
	names: List[String],
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreExpr]:
	dict_types ?= named_type_arguments(layout, result_type, "Dict")

	value_type ?= if dict_types.length() == 2:
		dict_types.get(1)
	else:
		None

	constructor ?= custom_dict_constructor(layout, names, result_type)

	Some(
		DictConstructExpr(
			{
				constructor = constructor,
				entries = [],
				value_needs_release = boxed_storage_needs_release(
					layout,
					resolve_specialize_type(layout, value_type),
				)
			},
			result_type,
			loc,
		),
	)


private pure func project_empty_custom_set(
	layout: CoreSpecializeLayout,
	names: List[String],
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreExpr]:
	constructor ?= custom_set_constructor(layout, names, result_type)
	Some(SetAllocExpr(constructor, result_type, loc))


private pure func project_empty_set(
	layout: CoreSpecializeLayout,
	names: List[String],
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreExpr]:
	constructor ?= set_constructor(layout, names, result_type)
	Some(SetAllocExpr(constructor, result_type, loc))


private pure func project_call_kind(
	layout: CoreSpecializeLayout,
	names: List[String],
	name: String,
	args: List[CoreExpr],
	result_type: CoreType,
) -> CoreCallKind:
	memory_intrinsic: Option[String] = match args:
		[arg]:
			storage: String = if boxed_storage_needs_release(layout, core_expr_type(arg)):
				"heap"
			else:
				"stack"

			if name == "blorp_is_unique":
				Some("memory_is_unique_${storage}")
			else if name == "blorp_refcount":
				Some("memory_refcount_${storage}")
			else if name == "blorp_size_of":
				Some("memory_size_of_${storage}")
			else:
				None
		_:
			None

	if memory_intrinsic.is_some():
		IntrinsicCall(memory_intrinsic.get_or(""))
	else if operation_result_builtin(name):
		operation_result_call_kind(layout, name, result_type).get_or(BuiltinCall(name))
	else if fallible_stream_terminal_builtin(name):
		fallible_stream_terminal_call_kind(layout, name, result_type).get_or(BuiltinCall(name))
	else if name == "blorp_list_to_string_cb":
		list_callback_call_kind(layout, names, args).get_or(BuiltinCall(name))
	else if name == "blorp_dict_with_capacity_custom":
		custom_dict_call_kind(layout, names, result_type).get_or(BuiltinCall(name))
	else if tensor_parallel_builtin(name):
		TensorParallelCall(
			name,
			tensor_parallel_layout(layout, result_type),
		)
	else if semantic_builtin(layout, name, result_type):
		BuiltinCall(name)
	else if builtin_contract(name, args.length()).is_some():
		direct_runtime_call(layout, name, result_type)
	else:
		BuiltinCall(name)


private pure func explicit_box(expr: CoreExpr) -> Bool:
	match expr:
		BoxExpr(_, _, _):
			True
		_:
			False


private pure func project_erased_runtime_argument(
	layout: CoreSpecializeLayout,
	arg: CoreExpr,
	loc: CoreSourceLoc,
) -> CoreExpr:
	source_type: CoreType = core_expr_type(arg)

	if explicit_box(arg) or specialize_type_is_pointer(layout, source_type):
		arg
	else:
		BoxExpr(
			{
				kind = boxed_storage_kind(layout, source_type),
				value = arg,
				source_type = source_type
			},
			POINTER_TYPE,
			loc,
		)


private pure func project_runtime_arguments(
	layout: CoreSpecializeLayout,
	name: String,
	args: List[CoreExpr],
	loc: CoreSourceLoc,
) -> List[CoreExpr]:
	if not runtime_builtin_has_erased_arguments(name):
		args
	else:
		var projected: List[CoreExpr] = []
		var index: Int = 0

		-- Indexed traversal keeps the borrowed argument list live under the
		-- pinned bootstrap without allocating an independent iterator list.
		while index < args.length():
			match args.get(index):
				Some(arg):
					projected = projected.append(
						if runtime_builtin_uses_erased_argument(name, index):
							project_erased_runtime_argument(layout, arg, loc)
						else:
							arg
					)
				None:
					void

			index += 1

		projected


private pure func constructor_union_type_name(
	layout: CoreSpecializeLayout,
	typ: CoreType,
) -> Option[String]:
	match typ:
		UnionType(name):
			Some(name)
		NamedType(name, args):
			match option_runtime_layout(layout, typ):
				Some(BoxedOptionLayout):
					Some("Option")
				_:
					None
		_:
			None


private pure func variable_references_definition(
	variable: CoreVar,
	definition_name: String,
	definition_c_name: String,
	definition_id: Option[Int],
) -> Bool:
	match (variable.def_id, definition_id):
		(Some(variable_id), Some(expected_id)):
			(
				(variable.name == definition_name or variable.name == definition_c_name)
				and variable_id == expected_id
			)
		_:
			False


private pure func constructor_c_name(
	layout: CoreSpecializeLayout,
	variable: CoreVar,
	typ: CoreType,
) -> Option[String]:
	var result: Option[String] = None

	for decl in layout.program.decls:
		match decl:
			EnumDecl(enum_decl):
				match typ:
					EnumType(type_name):
						if enum_decl.name == type_name:
							for variant in enum_decl.variants:
								if variable_references_definition(
									variable,
									variant.name,
									variant.c_name,
									variant.def_id,
								):
									result = Some(variant.c_name)
									break
					_:
						void
			UnionDecl(union_decl):
				match constructor_union_type_name(layout, typ):
					Some(type_name):
						if union_decl.name == type_name:
							for variant in union_decl.variants:
								if (
									variant.fields.is_empty()
									and variable_references_definition(
										variable,
										variant.name,
										variant.c_name,
										variant.def_id,
									)
								):
									result = Some(variant.c_name)
									break
					None:
						void
			_:
				void

		if result.is_some():
			break

	result


private pure func is_stack_result(layout: CoreSpecializeLayout, typ: CoreType) -> Bool:
	match resolve_specialize_type(layout, typ):
		StackResultType(_, _):
			True
		_:
			False


private pure func project_list_alloc(
	layout: CoreSpecializeLayout,
	capacity: CoreExpr,
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreExpr]:
	element_type ?= match resolve_specialize_type(layout, result_type):
		NamedType(name, args):
			if (name == "List" or name == "ParallelList") and args.length() == 1:
				args.get(0)
			else:
				None
		_:
			None

	Some(
		ListAllocExpr(
			{
				layout = specialize_list_layout(layout, result_type),
				capacity = capacity,
				elem_needs_release = specialize_list_element_needs_release(layout, element_type)
			},
			result_type,
			loc,
		),
	)


private pure func tensor_alloc_runtime_name(
	layout: CoreSpecializeLayout,
	result_type: CoreType,
) -> Option[String]:
	match resolve_specialize_type(layout, result_type):
		TensorType(info):
			match resolve_specialize_type(layout, info.element_type):
				NamedType(name, args):
					if not args.is_empty():
						None
					else if name == "Int":
						Some("blorp_vector_new_i64")
					else if name == "Float":
						Some("blorp_vector_new_f64")
					else if name == "Float32":
						Some("blorp_vector_new_f32")
					else:
						None
				_:
					None
		_:
			None


private pure func project_tensor_alloc(
	layout: CoreSpecializeLayout,
	capacity: CoreExpr,
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreExpr]:
	runtime_name ?= tensor_alloc_runtime_name(layout, result_type)
	Some(
		CallExpr(
			direct_runtime_call(layout, runtime_name, result_type),
			VoidExpr(VoidType, loc),
			[capacity],
			result_type,
			loc,
		),
	)


private pure func project_list_get(
	layout: CoreSpecializeLayout,
	list: CoreExpr,
	index: CoreExpr,
	bounds: CoreListAccessBounds,
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	ListGetExpr(
		{
			layout = specialize_list_layout(layout, core_expr_type(list)),
			list = list,
			index = index,
			bounds = bounds
		},
		result_type,
		loc,
	)


private pure func project_list_set(
	layout: CoreSpecializeLayout,
	list: CoreExpr,
	index: CoreExpr,
	value: CoreExpr,
	transfers_ownership: Bool,
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	ListSetExpr(
		{
			layout = specialize_list_layout(layout, core_expr_type(list)),
			list = list,
			index = index,
			value = boxed_storage_value(layout, value, transfers_ownership),
			value_is_stack_result = is_stack_result(layout, core_expr_type(value))
		},
		result_type,
		loc,
	)


private pure func project_intrinsic_expr(
	layout: CoreSpecializeLayout,
	name: String,
	args: List[CoreExpr],
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreExpr]:
	if name == "list_retain_for":
		match args:
			[list, value]:
				Some(
					ListRetainExpr(
						{
							list = list,
							value = list_retain_storage_value(layout, value)
						},
						result_type,
						loc,
					),
				)
			_:
				None
	else if name == "list_set" or name == "list_set_owned":
		match args:
			[list, index, value]:
				Some(
					project_list_set(
						layout,
						list,
						index,
						value,
						name == "list_set_owned",
						result_type,
						loc,
					),
				)
			_:
				None
	else if name == "list_handoff_set_owned":
		match args:
			[list, index, value]:
				match project_list_set(layout, list, index, value, True, result_type, loc):
					ListSetExpr(set, _, _):
						Some(ListHandoffSetOwnedExpr(set, result_type, loc))
					_:
						None
			_:
				None
	else if name == "list_handoff_set_source_slot":
		match args:
			[result, out_index, source, source_index]:
				Some(
					ListHandoffSetSourceSlotExpr(
						{
							result = result,
							out_index = out_index,
							source = source,
							source_index = source_index
						},
						result_type,
						loc,
					),
				)
			_:
				None
	else if name == "list_swap_slots":
		match args:
			[list, left_index, right_index]:
				Some(
					ListSwapExpr(
						{
							layout = specialize_list_layout(layout, core_expr_type(list)),
							list = list,
							left_index = left_index,
							right_index = right_index
						},
						result_type,
						loc,
					),
				)
			_:
				None
	else if name == "list_alloc":
		match args:
			[capacity]:
				project_list_alloc(layout, capacity, result_type, loc)
			_:
				None
	else if name == "tensor_alloc":
		match args:
			[capacity]:
				project_tensor_alloc(layout, capacity, result_type, loc)
			_:
				None
	else if name == "list_get" or name == "list_get_unchecked":
		match args:
			[list, index]:
				bounds: CoreListAccessBounds = if name == "list_get":
					CheckedListAccess
				else:
					ProvenListAccess

				Some(project_list_get(layout, list, index, bounds, result_type, loc))
			_:
				None
	else if name == "string_get_byte":
		match args:
			[source, index]:
				Some(
					StringByteReadExpr(
						{
							source = source,
							index = index
						},
						result_type,
						loc,
					),
				)
			_:
				None
	else if name == "string_set_byte":
		match args:
			[target, index, byte]:
				Some(
					StringByteWriteExpr(
						{
							target = target,
							index = index,
							byte = byte
						},
						result_type,
						loc,
					),
				)
			_:
				None
	else if name == "string_copy_bytes":
		match args:
			[dst, dst_pos, src, src_pos, len]:
				Some(
					StringByteCopyExpr(
						{
							dst = dst,
							dst_pos = dst_pos,
							src = src,
							src_pos = src_pos,
							len = len
						},
						result_type,
						loc,
					),
				)
			_:
				None
	else if name == "string_set_len":
		match args:
			[target, len]:
				Some(
					StringSetLenExpr(
						{
							target = target,
							len = len
						},
						result_type,
						loc,
					),
				)
			_:
				None
	else:
		None


private pure func project_expr(
	layout: CoreSpecializeLayout,
	names: List[String],
	expr: CoreExpr,
) -> CoreExpr:
	children_projected: CoreExpr = match expr:
		SeqExpr(_, _):
			CoreTraverse.map_core_sequence_items(
				expr,
				func(item): project_expr(layout, names, item),
			)
		_:
			CoreTraverse.map_core_expr_children(
				expr,
				func(child): project_expr(layout, names, child),
			)

	match children_projected:
		CallExpr(IntrinsicCall(name), _, args, result_type, loc):
			project_intrinsic_expr(layout, name, args, result_type, loc).get_or(children_projected)
		CallExpr(BuiltinCall(name), callee, args, result_type, loc):
			projected_args: List[CoreExpr] = project_runtime_arguments(layout, name, args, loc)

			match project_ranked_tensor_fill(layout, name, args, result_type, loc):
				Some(projected):
					projected
				None:
					if name == "blorp_list_new":
						match args:
							[capacity]:
								project_list_alloc(
									layout,
									capacity,
									result_type,
									loc,
								).get_or(children_projected)
							_:
								children_projected
					else if name == "blorp_dict_new_custom" and args.is_empty():
						project_empty_custom_dict(
							layout,
							names,
							result_type,
							loc,
						).get_or(children_projected)
					else if name == "blorp_set_new_custom" and args.is_empty():
						project_empty_custom_set(
							layout,
							names,
							result_type,
							loc,
						).get_or(children_projected)
					else:
						CallExpr(
							project_call_kind(layout, names, name, projected_args, result_type),
							callee,
							projected_args,
							result_type,
							loc,
						)
		DictExpr(entries, typ, loc):
			if entries.is_empty():
				project_empty_set(layout, names, typ, loc).get_or(children_projected)
			else:
				children_projected
		VarExpr(variable, typ, loc):
			match constructor_c_name(layout, variable, typ):
				Some(c_name):
					VarExpr({ variable | name = c_name }, typ, loc)
				None:
					children_projected
		_:
			children_projected


private pure func project_function(
	layout: CoreSpecializeLayout,
	names: List[String],
	function_info: CoreFunction,
) -> CoreFunction:
	{ function_info | body = function_info.body.map(func(body): project_expr(layout, names, body)) }


private pure func project_decl(
	layout: CoreSpecializeLayout,
	names: List[String],
	decl: CoreDecl,
) -> CoreDecl:
	match decl:
		FunctionDecl(function_info):
			FunctionDecl(project_function(layout, names, function_info))
		GlobalDecl(global):
			GlobalDecl({ global | init = project_expr(layout, names, global.init) })
		_:
			decl


pure func project_backend_calls(program: CoreProgram) -> CoreProgram:
	layout: CoreSpecializeLayout = build_specialize_layout(program)
	names: List[String] = function_names(program)

	{ program | decls = program.decls.map(func(decl): project_decl(layout, names, decl)) }
