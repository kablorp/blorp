-- Closure conversion for the Blorp-owned Core tail.
--
-- This is a direct port of the production OCaml closure pass with
-- first-class function-reference wrapping intentionally left on the OCaml side
-- for now. The input boundary is post-reuse/pre-closure Core; this pass hoists
-- raw lambdas and task bodies into closure-body functions.
import:
	../stage_10_backend/compiler_core_emit_type_layout as TypeLayout
	compiler_core_json:
		CoreBoxedStorageValue,
		CoreCallKind(
			BuiltinCall,
			ClosureCall,
			DictWithCapacityCall,
			DirectRuntimeCall,
			FallibleStreamTerminalCall,
			ForeignCall,
			IntrinsicCall,
			ListToStringCall,
			OperationResultCall,
			TensorParallelCall,
			UserCall,
		),
		CoreClosureAbi,
		CoreClosureCapture,
		CoreClosureCreate,
		CoreConcurrentBinding,
		CoreConcurrentlyLoopItemMode(ConcurrentlyLoopCopyItem, ConcurrentlyLoopMoveResourceItem),
		CoreConstructorLengthMatch,
		CoreConstructorLengthMatchBranch,
		CoreConstructorLengthMatchCase,
		CoreConstructorLengthMatchGeq,
		CoreConstructorLiteralMatch,
		CoreConstructorMatchBody(
			ConstructorMatchBodyExpr,
			ConstructorMatchBodyLength,
			ConstructorMatchBodyLiteral,
		),
		CoreConstructorMatchCase,
		CoreConstructorMatchFallback(
			ConstructorMatchFallbackBindings,
			ConstructorMatchFallbackBody,
			ConstructorMatchFallbackFail,
		),
		CoreDecl(EnumDecl, FunctionDecl, GlobalDecl, HeapRecordDecl, UnionDecl, ValueRecordDecl),
		CoreDictEntry,
		CoreDictLiteralEntry,
		CoreExpr(
			AccessorLiteralMatchExpr,
			AssignExpr,
			BinaryExpr,
			BoxExpr,
			BreakExpr,
			BorrowLetExpr,
			CastExpr,
			CallExpr,
			ClosureCreateExpr,
			ConcurrentExpr,
			ConcurrentlyLoopExpr,
			ConstructorMatchExpr,
			ContinueExpr,
			CooperativeCheckpointExpr,
			DetachExpr,
			DictConstructExpr,
			DictExpr,
			DropExpr,
			DupExpr,
			FieldExpr,
			ForChannelExpr,
			ForDictExpr,
			ForListExpr,
			ForRangeExpr,
			ForResourceSourceExpr,
			ForSetExpr,
			ForStreamExpr,
			ForStringExpr,
			ForTensorExpr,
			IfExpr,
			LambdaExpr,
			LengthMatchExpr,
			LetExpr,
			ListAllocExpr,
			ListConstructExpr,
			ListGetExpr,
			ListHandoffExpr,
			ListHandoffSetOwnedExpr,
			ListHandoffSetSourceSlotExpr,
			ListRetainExpr,
			ListSetExpr,
			ListSwapExpr,
			LiteralExpr,
			LiteralMatchExpr,
			LogicalExpr,
			RangeExpr,
			RecordConstructExpr,
			RecordExpr,
			PreClosureConcurrentExpr,
			PreClosureConcurrentlyLoopExpr,
			PreClosureDetachExpr,
			ResourceCleanupExitExpr,
			ResourceScopeExpr,
			SelectExpr,
			SeqExpr,
			SetAllocExpr,
			StringByteCopyExpr,
			StringByteReadExpr,
			StringByteWriteExpr,
			StringSetLenExpr,
			TailrecListSpreadLoopExpr,
			TailrecListSpreadRecurExpr,
			TailrecLoopExpr,
			TailrecRecurExpr,
			TensorBoxedLiteralExpr,
			TensorLiteralExpr,
			TensorPackedLiteralExpr,
			TensorRawFillExpr,
			TensorRawReadExpr,
			TensorRawViewLetExpr,
			TensorRawWriteExpr,
			TupleConstructExpr,
			TupleExpr,
			TupleFieldExpr,
			UnaryExpr,
			UnionConstructExpr,
			UnionReuseConstructExpr,
			UnboxExpr,
			VarExpr,
			VectorExpr,
			VoidExpr,
			WhileExpr,
		),
		CoreFunction,
		CoreFunctionKind(ClosureBodyFunction, UserFunction, BuiltinFunction, ForeignFunction),
		CoreGlobal,
		CoreLiteralMatchCase,
		CoreLiteralMatchFallback(
			LiteralMatchFallbackBindings,
			LiteralMatchFallbackBody,
			LiteralMatchFallbackFail,
		),
		CoreMatchBinding,
		CoreParam,
		CorePreClosureConcurrentBinding,
		CoreProgram,
		CoreRecordFieldValue,
		CoreReleasePolicy,
		CoreSelectArm,
		CoreSelectArmKind(SelectAfterArm, SelectRecvArm, SelectSealedArm),
		CoreSourceLoc,
		CoreTailrecListSpreadRebind,
		CoreTaskCapture,
		CoreTaskCaptureKind(TaskCopyCapture, TaskMoveResourceItem, TaskStructuredTaskBorrow),
		CoreTaskClosure,
		CoreTensorLiteralPayload(TensorInlineStructLiteralPayload, TensorRawLiteralPayload),
		CoreTupleElement(
			TupleFloat16Element,
			TupleFloat32Element,
			TupleFloatElement,
			TuplePointerElement,
			TuplePrimElement,
			TupleStructElement,
			TupleVoidElement,
		),
		CoreType,
		CoreVar,


LAMBDA_NAME_PREFIX: String = "_blorp_clambda_"

TASK_NAME_PREFIX: String = "_blorp_task_"

MANGLED_DEF_ID_PREFIX: String = "__def_"

STATIC_CLOSURE_PREFIX: String = "__sc_"

CLOSURE_TYPE_NAME: String = "Closure"

VOID_TYPE_NAME: String = "Void"


record FreeVar {
	name: String,
	typ: CoreType
}


private pure func call_kind_uses_runtime_callee(kind: CoreCallKind) -> Bool:
	match kind:
		ClosureCall:
			True
		UserCall(name, def_id, consumed_args):
			False
		ForeignCall(name, arg_passing):
			False
		BuiltinCall(name):
			False
		DirectRuntimeCall(call):
			False
		OperationResultCall(bridge):
			False
		FallibleStreamTerminalCall(bridge):
			False
		TensorParallelCall(name, layout):
			False
		DictWithCapacityCall(constructor):
			False
		ListToStringCall(callback_name):
			False
		IntrinsicCall(name):
			False


record ClosureState {
	next_lambda_index: Int,
	next_task_index: Int,
	next_def_id: Int,
	current_module: Option[String],
	function_names: List[String],
	constructor_names: List[String],
	hoisted: List[CoreDecl]
}


record ConvertedExpr {
	state: ClosureState,
	expr: CoreExpr
}


record ConvertedExprs {
	state: ClosureState,
	exprs: List[CoreExpr]
}


record ConvertedOptionalExpr {
	state: ClosureState,
	expr: Option[CoreExpr]
}


record ConvertedBoxedStorageValue {
	state: ClosureState,
	value: CoreBoxedStorageValue
}


record ConvertedBoxedStorageValues {
	state: ClosureState,
	values: List[CoreBoxedStorageValue]
}


record ConvertedTupleElement {
	state: ClosureState,
	element: CoreTupleElement
}


record ConvertedTupleElements {
	state: ClosureState,
	elements: List[CoreTupleElement]
}


record ConvertedRecordFields {
	state: ClosureState,
	fields: List[CoreRecordFieldValue]
}


record ConvertedDictEntries {
	state: ClosureState,
	entries: List[CoreDictEntry]
}


record ConvertedDictLiteralEntries {
	state: ClosureState,
	entries: List[CoreDictLiteralEntry]
}


record ConvertedLiteralMatchCases {
	state: ClosureState,
	cases: List[CoreLiteralMatchCase]
}


record ConvertedLiteralMatchFallback {
	state: ClosureState,
	fallback: CoreLiteralMatchFallback
}


record ConvertedConstructorMatchBody {
	state: ClosureState,
	body: CoreConstructorMatchBody
}


record ConvertedConstructorMatchCases {
	state: ClosureState,
	cases: List[CoreConstructorMatchCase]
}


record ConvertedConstructorMatchFallback {
	state: ClosureState,
	fallback: CoreConstructorMatchFallback
}


record ConvertedConstructorLengthBranch {
	state: ClosureState,
	branch: CoreConstructorLengthMatchBranch
}


record ConvertedConstructorLengthCases {
	state: ClosureState,
	cases: List[CoreConstructorLengthMatchCase]
}


record ConvertedConstructorLengthGeq {
	state: ClosureState,
	geq: Option[CoreConstructorLengthMatchGeq]
}


record ConvertedConstructorLengthFallback {
	state: ClosureState,
	fallback: Option[CoreConstructorLengthMatchBranch]
}


record ConvertedSelectArmKind {
	state: ClosureState,
	kind: CoreSelectArmKind
}


record ConvertedSelectArms {
	state: ClosureState,
	arms: List[CoreSelectArm]
}


record ConvertedDecl {
	state: ClosureState,
	decl: CoreDecl
}


record ConvertedDecls {
	state: ClosureState,
	decls: List[CoreDecl]
}


record FreshHoistedName {
	state: ClosureState,
	name: String,
	def_id: Int,
	c_name: String,
	static_name: String
}


record HoistedClosureCreate {
	state: ClosureState,
	create: CoreClosureCreate
}


record HoistedTaskClosure {
	state: ClosureState,
	task: CoreTaskClosure
}


private pure func max_int(left: Int, right: Int) -> Int:
	if left > right:
		left
	else:
		right


private pure func max_optional_int(current: Int, value: Option[Int]) -> Int:
	match value:
		Some(found):
			max_int(current, found)
		None:
			current


private pure func max_var_def_id(current: Int, variable: CoreVar) -> Int:
	max_optional_int(current, variable.def_id)


private pure func mangle_by_def_id(def_id: Int, name: String) -> String:
	MANGLED_DEF_ID_PREFIX + def_id.to_string() + "_" + name


private pure func static_closure_name(c_name: String) -> String:
	STATIC_CLOSURE_PREFIX + c_name


private pure func closure_type() -> CoreType:
	NamedType(CLOSURE_TYPE_NAME, [])


private pure func void_type() -> CoreType:
	VoidType


private pure func var_from_name(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


private pure func task_capture_moves_env_slot(capture: CoreTaskCapture) -> Bool:
	match capture.kind:
		TaskCopyCapture:
			True
		TaskMoveResourceItem:
			True
		TaskStructuredTaskBorrow:
			False


private pure func task_moved_captures(captures: List[CoreTaskCapture]) -> List[String]:
	var moved: List[String] = []

	for capture in captures:
		if task_capture_moves_env_slot(capture):
			moved = moved.append(capture.name)
		else:
			void

	moved


private pure func closure_capture_from_task_capture(capture: CoreTaskCapture) -> CoreClosureCapture:
	{
		name = capture.name,
		typ = capture.typ
	}


private pure func closure_captures_from_task_captures(
	captures: List[CoreTaskCapture],
) -> List[CoreClosureCapture]:
	captures.map(closure_capture_from_task_capture)


private pure func contains_name(names: List[String], name: String) -> Bool:
	names.contains(name)


private pure func copy_names(names: List[String]) -> List[String]:
	names


private pure func add_bound_name(bound: List[String], name: String) -> List[String]:
	result: List[String] = copy_names(bound)

	if contains_name(result, name):
		result
	else:
		result.append(name)


private pure func add_bound_var(bound: List[String], variable: CoreVar) -> List[String]:
	add_bound_name(bound, variable.name)


private pure func add_bound_param(bound: List[String], param: CoreParam) -> List[String]:
	add_bound_var(bound, param.name)


private pure func add_bound_params(bound: List[String], params: List[CoreParam]) -> List[String]:
	var result: List[String] = copy_names(bound)

	for param in params:
		result = add_bound_param(result, param)

	result


private pure func add_bound_match_bindings(
	bound: List[String],
	bindings: List[CoreMatchBinding],
) -> List[String]:
	var result: List[String] = copy_names(bound)

	for binding in bindings:
		result = add_bound_var(result, binding.variable)

	result


private pure func max_exprs_def_id(current: Int, exprs: List[CoreExpr]) -> Int:
	var result: Int = current

	for expr in exprs:
		result = max_expr_def_id(result, expr)

	result


private pure func max_boxed_storage_value_def_id(current: Int, value: CoreBoxedStorageValue) -> Int:
	max_expr_def_id(current, value.value)


private pure func max_boxed_storage_values_def_id(
	current: Int,
	values: List[CoreBoxedStorageValue],
) -> Int:
	var result: Int = current

	for value in values:
		result = max_boxed_storage_value_def_id(result, value)

	result


private pure func max_tuple_element_def_id(current: Int, element: CoreTupleElement) -> Int:
	match element:
		TuplePrimElement(expr):
			max_expr_def_id(current, expr)
		TuplePointerElement(expr):
			max_expr_def_id(current, expr)
		TupleStructElement(expr, c_type):
			max_expr_def_id(current, expr)
		TupleVoidElement:
			current
		TupleFloatElement(expr):
			max_expr_def_id(current, expr)
		TupleFloat32Element(expr):
			max_expr_def_id(current, expr)
		TupleFloat16Element(expr):
			max_expr_def_id(current, expr)


private pure func max_tuple_elements_def_id(current: Int, elements: List[CoreTupleElement]) -> Int:
	var result: Int = current

	for element in elements:
		result = max_tuple_element_def_id(result, element)

	result


private pure func max_record_fields_def_id(current: Int, fields: List[CoreRecordFieldValue]) -> Int:
	var result: Int = current

	for field in fields:
		result = max_expr_def_id(result, field.value)

	result


private pure func max_dict_entries_def_id(current: Int, entries: List[CoreDictEntry]) -> Int:
	var result: Int = current

	for entry in entries:
		result = max_boxed_storage_value_def_id(result, entry.key)
		result = max_boxed_storage_value_def_id(result, entry.value)

	result


private pure func max_tensor_literal_payload_def_id(
	current: Int,
	payload: CoreTensorLiteralPayload,
) -> Int:
	match payload:
		TensorRawLiteralPayload(raw):
			max_exprs_def_id(current, raw.elements)
		TensorInlineStructLiteralPayload(inline_struct):
			max_exprs_def_id(current, inline_struct.elements)


private pure func max_literal_match_cases_def_id(
	current: Int,
	cases: List[CoreLiteralMatchCase],
) -> Int:
	var result: Int = current

	for match_case in cases:
		result = max_expr_def_id(result, match_case.body)

	result


private pure func max_literal_match_fallback_def_id(
	current: Int,
	fallback: CoreLiteralMatchFallback,
) -> Int:
	match fallback:
		LiteralMatchFallbackBody(body):
			max_expr_def_id(current, body)
		LiteralMatchFallbackBindings(bindings, body):
			max_expr_def_id(current, body)
		LiteralMatchFallbackFail:
			current


private pure func max_constructor_match_body_def_id(
	current: Int,
	body: CoreConstructorMatchBody,
) -> Int:
	match body:
		ConstructorMatchBodyExpr(expr):
			max_expr_def_id(current, expr)
		ConstructorMatchBodyLiteral(literal_match):
			max_constructor_literal_match_def_id(current, literal_match)
		ConstructorMatchBodyLength(length_match):
			max_constructor_length_match_def_id(current, length_match)


private pure func max_constructor_match_cases_def_id(
	current: Int,
	cases: List[CoreConstructorMatchCase],
) -> Int:
	var result: Int = current

	for match_case in cases:
		result = max_constructor_match_body_def_id(result, match_case.body)

	result


private pure func max_constructor_match_fallback_def_id(
	current: Int,
	fallback: CoreConstructorMatchFallback,
) -> Int:
	match fallback:
		ConstructorMatchFallbackBody(body):
			max_expr_def_id(current, body)
		ConstructorMatchFallbackBindings(bindings, body):
			max_expr_def_id(current, body)
		ConstructorMatchFallbackFail:
			current


private pure func max_constructor_literal_match_def_id(
	current: Int,
	match_expr: CoreConstructorLiteralMatch,
) -> Int:
	var result: Int = max_literal_match_cases_def_id(current, match_expr.cases)
	max_literal_match_fallback_def_id(result, match_expr.fallback)


private pure func max_constructor_length_branch_def_id(
	current: Int,
	branch: CoreConstructorLengthMatchBranch,
) -> Int:
	max_constructor_match_body_def_id(current, branch.body)


private pure func max_constructor_length_cases_def_id(
	current: Int,
	cases: List[CoreConstructorLengthMatchCase],
) -> Int:
	var result: Int = current

	for match_case in cases:
		result = max_constructor_length_branch_def_id(result, match_case.branch)

	result


private pure func max_constructor_length_geq_def_id(
	current: Int,
	geq: Option[CoreConstructorLengthMatchGeq],
) -> Int:
	match geq:
		Some(found):
			max_constructor_length_branch_def_id(current, found.branch)
		None:
			current


private pure func max_constructor_length_fallback_def_id(
	current: Int,
	fallback: Option[CoreConstructorLengthMatchBranch],
) -> Int:
	match fallback:
		Some(branch):
			max_constructor_length_branch_def_id(current, branch)
		None:
			current


private pure func max_constructor_length_match_def_id(
	current: Int,
	match_expr: CoreConstructorLengthMatch,
) -> Int:
	var result: Int = max_constructor_length_cases_def_id(current, match_expr.cases)
	result = max_constructor_length_geq_def_id(result, match_expr.geq)
	max_constructor_length_fallback_def_id(result, match_expr.fallback)


private pure func max_select_arm_kind_def_id(current: Int, kind: CoreSelectArmKind) -> Int:
	match kind:
		SelectRecvArm(recv):
			max_expr_def_id(current, recv.channel)
		SelectSealedArm(channel):
			max_expr_def_id(current, channel)
		SelectAfterArm(timeout):
			max_expr_def_id(current, timeout)


private pure func max_select_arms_def_id(current: Int, arms: List[CoreSelectArm]) -> Int:
	var result: Int = current

	for arm in arms:
		result = max_select_arm_kind_def_id(result, arm.kind)
		result = max_expr_def_id(result, arm.body)

	result


private pure func max_optional_expr_def_id(current: Int, expr: Option[CoreExpr]) -> Int:
	match expr:
		Some(found):
			max_expr_def_id(current, found)
		None:
			current


private pure func max_dict_literal_entry_def_id(current: Int, entry: CoreDictLiteralEntry) -> Int:
	max_expr_def_id(
		max_expr_def_id(current, entry.key),
		entry.value,
	)


private pure func max_dict_literal_entries_def_id(
	current: Int,
	entries: List[CoreDictLiteralEntry],
) -> Int:
	var result: Int = current

	for entry in entries:
		result = max_dict_literal_entry_def_id(result, entry)

	result


private pure func max_expr_def_id(current: Int, expr: CoreExpr) -> Int:
	match expr:
		LiteralExpr(literal, typ, loc):
			current
		VarExpr(variable, typ, loc):
			max_var_def_id(current, variable)
		VoidExpr(typ, loc):
			current
		CooperativeCheckpointExpr(typ, loc):
			current
		CallExpr(kind, callee, args, typ, loc):
			max_exprs_def_id(
				max_expr_def_id(current, callee),
				args,
			)
		BinaryExpr(op, left, right, typ, loc):
			max_expr_def_id(
				max_expr_def_id(current, left),
				right,
			)
		UnaryExpr(op, expr_value, typ, loc):
			max_expr_def_id(current, expr_value)
		LogicalExpr(op, left, right, typ, loc):
			max_expr_def_id(
				max_expr_def_id(current, left),
				right,
			)
		AssignExpr(variable, rhs, typ, loc):
			max_expr_def_id(
				max_var_def_id(current, variable),
				rhs,
			)
		CastExpr(expr_value, typ, loc):
			max_expr_def_id(current, expr_value)
		BoxExpr(box, typ, loc):
			max_expr_def_id(current, box.value)
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			max_expr_def_id(current, expr_value)
		FieldExpr(expr_value, field_name, typ, loc):
			max_expr_def_id(current, expr_value)
		TupleFieldExpr(expr_value, field_index, typ, loc):
			max_expr_def_id(current, expr_value)
		TupleExpr(items, typ, loc):
			max_exprs_def_id(current, items)
		TupleConstructExpr(tuple_construct, typ, loc):
			max_tuple_elements_def_id(current, tuple_construct.elements)
		VectorExpr(items, typ, loc):
			max_exprs_def_id(current, items)
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			max_expr_def_id(current, lambda_body)
		ClosureCreateExpr(closure, typ, loc):
			max_int(current, closure.def_id)
		ListConstructExpr(construct, typ, loc):
			max_boxed_storage_values_def_id(current, construct.elements)
		ListAllocExpr(alloc, typ, loc):
			max_expr_def_id(current, alloc.capacity)
		ListGetExpr(get, typ, loc):
			max_expr_def_id(
				max_expr_def_id(current, get.list),
				get.index,
			)
		ListHandoffExpr(handoff, typ, loc):
			var result: Int = max_expr_def_id(current, handoff.source)
			result = max_var_def_id(result, handoff.source_var)
			result = max_expr_def_id(result, handoff.capacity)
			result = max_var_def_id(result, handoff.result_var)
			result = max_var_def_id(result, handoff.len_var)
			result = max_var_def_id(result, handoff.out_var)
			max_expr_def_id(result, handoff.body)
		ListHandoffSetOwnedExpr(set, typ, loc):
			var result: Int = max_expr_def_id(current, set.list)
			result = max_expr_def_id(result, set.index)
			max_boxed_storage_value_def_id(result, set.value)
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			var result: Int = max_expr_def_id(current, slot.result)
			result = max_expr_def_id(result, slot.out_index)
			result = max_expr_def_id(result, slot.source)
			max_expr_def_id(result, slot.source_index)
		StringByteReadExpr(read, typ, loc):
			max_expr_def_id(
				max_expr_def_id(current, read.source),
				read.index,
			)
		StringByteWriteExpr(write, typ, loc):
			var result: Int = max_expr_def_id(current, write.target)
			result = max_expr_def_id(result, write.index)
			max_expr_def_id(result, write.byte)
		StringByteCopyExpr(copy, typ, loc):
			var result: Int = max_expr_def_id(current, copy.dst)
			result = max_expr_def_id(result, copy.dst_pos)
			result = max_expr_def_id(result, copy.src)
			result = max_expr_def_id(result, copy.src_pos)
			max_expr_def_id(result, copy.len)
		StringSetLenExpr(set_len, typ, loc):
			max_expr_def_id(
				max_expr_def_id(current, set_len.target),
				set_len.len,
			)
		TensorLiteralExpr(literal, typ, loc):
			max_tensor_literal_payload_def_id(current, literal.payload)
		TensorBoxedLiteralExpr(literal, typ, loc):
			max_boxed_storage_values_def_id(current, literal.elements)
		TensorPackedLiteralExpr(literal, typ, loc):
			current
		TensorRawFillExpr(fill, typ, loc):
			max_exprs_def_id(
				max_expr_def_id(current, fill.value),
				fill.dims,
			)
		TensorRawReadExpr(read, typ, loc):
			max_expr_def_id(
				max_var_def_id(current, read.view),
				read.index,
			)
		TensorRawWriteExpr(write, typ, loc):
			var result: Int = max_var_def_id(current, write.view)
			result = max_expr_def_id(result, write.index)
			max_expr_def_id(result, write.value)
		TensorRawViewLetExpr(binding, body, typ, loc):
			var result: Int = max_var_def_id(current, binding.variable)
			result = max_expr_def_id(result, binding.source)
			max_expr_def_id(result, body)
		DictExpr(entries, typ, loc):
			max_dict_literal_entries_def_id(current, entries)
		DictConstructExpr(construct, typ, loc):
			max_dict_entries_def_id(current, construct.entries)
		SetAllocExpr(alloc, typ, loc):
			current
		ListRetainExpr(retain, typ, loc):
			var result: Int = max_expr_def_id(current, retain.list)
			max_boxed_storage_value_def_id(result, retain.value)
		ListSetExpr(set, typ, loc):
			var result: Int = max_expr_def_id(current, set.list)
			result = max_expr_def_id(result, set.index)
			max_boxed_storage_value_def_id(result, set.value)
		ListSwapExpr(swap, typ, loc):
			var result: Int = max_expr_def_id(current, swap.list)
			result = max_expr_def_id(result, swap.left_index)
			max_expr_def_id(result, swap.right_index)
		RecordExpr(fields, typ, loc):
			max_record_fields_def_id(current, fields)
		RecordConstructExpr(name, fields, typ, loc):
			max_record_fields_def_id(current, fields)
		UnionConstructExpr(construct, typ, loc):
			max_boxed_storage_values_def_id(current, construct.args)
		UnionReuseConstructExpr(construct, typ, loc):
			var result: Int = max_expr_def_id(current, construct.source)
			max_boxed_storage_values_def_id(result, construct.args)
		PreClosureDetachExpr(detached, typ, loc):
			max_expr_def_id(current, detached.body)
		DetachExpr(detached, typ, loc):
			max_int(current, detached.task.def_id)
		DupExpr(variable, var_type, retain_policy, body, typ, loc):
			max_expr_def_id(
				max_var_def_id(current, variable),
				body,
			)
		DropExpr(variable, var_type, release_policy, body, typ, loc):
			max_expr_def_id(
				max_var_def_id(current, variable),
				body,
			)
		LetExpr(variable, is_mutable, var_type, rhs, body):
			var result: Int = max_var_def_id(current, variable)
			result = max_expr_def_id(result, rhs)
			max_expr_def_id(result, body)
		BorrowLetExpr(variable, var_type, rhs, body):
			var result: Int = max_var_def_id(current, variable)
			result = max_expr_def_id(result, rhs)
			max_expr_def_id(result, body)
		SeqExpr(first, second):
			max_expr_def_id(
				max_expr_def_id(current, first),
				second,
			)
		WhileExpr(cond, body, typ, loc):
			max_expr_def_id(
				max_expr_def_id(current, cond),
				body,
			)
		BreakExpr(typ, loc):
			current
		ContinueExpr(typ, loc):
			current
		ResourceScopeExpr(scope, typ, loc):
			var result: Int = max_var_def_id(current, scope.variable)
			result = max_expr_def_id(result, scope.acquire)
			result = max_expr_def_id(result, scope.body)
			max_expr_def_id(result, scope.cleanup)
		ResourceCleanupExitExpr(exit, typ, loc):
			max_exprs_def_id(current, exit.cleanups)
		TailrecLoopExpr(params, return_type, body, loc):
			max_expr_def_id(current, body)
		TailrecRecurExpr(args, typ, loc):
			max_exprs_def_id(current, args)
		TailrecListSpreadLoopExpr(loop, loc):
			var result: Int = max_var_def_id(current, loop.list_param.name)
			result = max_var_def_id(result, loop.cursor)
			max_expr_def_id(result, loop.body)
		TailrecListSpreadRecurExpr(rebinds, list_index, typ, loc):
			var result: Int = current

			for rebind in rebinds:
				result = max_expr_def_id(result, rebind.value)

			result
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			var result: Int = max_var_def_id(current, binder.variable)
			result = max_expr_def_id(result, start)
			result = max_expr_def_id(result, end_value)
			max_expr_def_id(result, body)
		ForChannelExpr(for_channel, typ, loc):
			var result: Int = max_var_def_id(current, for_channel.binder.variable)
			result = max_expr_def_id(result, for_channel.iterable)
			max_expr_def_id(result, for_channel.body)
		ForListExpr(for_list, typ, loc):
			var result: Int = max_var_def_id(current, for_list.binder.variable)
			result = max_expr_def_id(result, for_list.iterable)
			max_expr_def_id(result, for_list.body)
		ForStringExpr(for_string, typ, loc):
			var result: Int = max_var_def_id(current, for_string.binder.variable)
			result = max_expr_def_id(result, for_string.iterable)
			max_expr_def_id(result, for_string.body)
		ForDictExpr(for_dict, typ, loc):
			var result: Int = max_var_def_id(current, for_dict.binder.variable)
			result = max_expr_def_id(result, for_dict.iterable)
			max_expr_def_id(result, for_dict.body)
		ForSetExpr(for_set, typ, loc):
			var result: Int = max_var_def_id(current, for_set.binder.variable)
			result = max_expr_def_id(result, for_set.iterable)
			max_expr_def_id(result, for_set.body)
		ForStreamExpr(for_stream, typ, loc):
			var result: Int = max_var_def_id(current, for_stream.binder.variable)
			result = max_expr_def_id(result, for_stream.iterable)
			max_expr_def_id(result, for_stream.body)
		ForResourceSourceExpr(for_resource_source, typ, loc):
			var result: Int = max_var_def_id(current, for_resource_source.binder.variable)
			result = max_expr_def_id(result, for_resource_source.iterable)
			max_expr_def_id(result, for_resource_source.body)
		ForTensorExpr(for_tensor, typ, loc):
			var result: Int = max_var_def_id(current, for_tensor.binder.variable)
			result = max_expr_def_id(result, for_tensor.iterable)
			max_expr_def_id(result, for_tensor.body)
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			var result: Int = max_var_def_id(current, loop.variable)
			result = max_expr_def_id(result, loop.iterable)
			result = max_expr_def_id(result, loop.body)
			result = max_optional_expr_def_id(result, loop.timeout)
			max_expr_def_id(result, loop.limit)
		ConcurrentlyLoopExpr(loop, typ, loc):
			var result: Int = max_var_def_id(current, loop.variable)
			result = max_expr_def_id(result, loop.iterable)
			result = max_expr_def_id(result, loop.body)
			result = max_optional_expr_def_id(result, loop.timeout)
			result = max_expr_def_id(result, loop.limit)
			max_int(result, loop.task.def_id)
		PreClosureConcurrentExpr(block, typ, loc):
			var result: Int = current

			for binding in block.bindings:
				result = max_var_def_id(result, binding.variable)
				result = max_expr_def_id(result, binding.rhs)

			result = max_expr_def_id(result, block.body)
			max_optional_expr_def_id(result, block.timeout)
		ConcurrentExpr(block, typ, loc):
			var result: Int = current

			for binding in block.bindings:
				result = max_var_def_id(result, binding.variable)
				result = max_expr_def_id(result, binding.rhs)
				result = max_int(result, binding.task.def_id)

			result = max_expr_def_id(result, block.body)
			max_optional_expr_def_id(result, block.timeout)
		SelectExpr(select_expr, typ, loc):
			max_select_arms_def_id(current, select_expr.arms)
		RangeExpr(start, end_value, typ, loc):
			max_expr_def_id(
				max_expr_def_id(current, start),
				end_value,
			)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			var result: Int = max_expr_def_id(current, scrutinee)
			result = max_literal_match_cases_def_id(result, cases)
			max_literal_match_fallback_def_id(result, fallback)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			var result: Int = max_expr_def_id(current, scrutinee)
			max_constructor_literal_match_def_id(result, match_expr)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			var result: Int = max_expr_def_id(current, scrutinee)
			max_constructor_length_match_def_id(result, match_expr)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			var result: Int = max_expr_def_id(current, scrutinee)
			result = max_constructor_match_cases_def_id(result, cases)
			max_constructor_match_fallback_def_id(result, fallback)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			var result: Int = max_expr_def_id(current, cond)
			result = max_expr_def_id(result, then_expr)
			max_expr_def_id(result, else_expr)


private pure func add_free_var(vars: List[FreeVar], name: String, typ: CoreType) -> List[FreeVar]:
	var exists: Bool = False

	for existing in vars:
		if existing.name == name:
			exists = True
			break
		else:
			void

	if exists:
		vars
	else:
		vars.append({
			name = name,
			typ = typ,
		})


private pure func merge_free_vars(left: List[FreeVar], right: List[FreeVar]) -> List[FreeVar]:
	var result: List[FreeVar] = left

	for item in right:
		result = add_free_var(result, item.name, item.typ)

	result


private pure func free_vars_exprs(
	state: ClosureState,
	bound: List[String],
	exprs: List[CoreExpr],
) -> List[FreeVar]:
	var result: List[FreeVar] = []

	for expr in exprs:
		result = merge_free_vars(
			result,
			free_vars_expr(state, bound, expr),
		)

	result


private pure func free_vars_boxed_storage_value(
	state: ClosureState,
	bound: List[String],
	value: CoreBoxedStorageValue,
) -> List[FreeVar]:
	free_vars_expr(state, bound, value.value)


private pure func free_vars_boxed_storage_values(
	state: ClosureState,
	bound: List[String],
	values: List[CoreBoxedStorageValue],
) -> List[FreeVar]:
	var result: List[FreeVar] = []

	for value in values:
		result = merge_free_vars(
			result,
			free_vars_boxed_storage_value(state, bound, value),
		)

	result


private pure func free_vars_tuple_element(
	state: ClosureState,
	bound: List[String],
	element: CoreTupleElement,
) -> List[FreeVar]:
	match element:
		TuplePrimElement(expr):
			free_vars_expr(state, bound, expr)
		TuplePointerElement(expr):
			free_vars_expr(state, bound, expr)
		TupleStructElement(expr, c_type):
			free_vars_expr(state, bound, expr)
		TupleVoidElement:
			[]
		TupleFloatElement(expr):
			free_vars_expr(state, bound, expr)
		TupleFloat32Element(expr):
			free_vars_expr(state, bound, expr)
		TupleFloat16Element(expr):
			free_vars_expr(state, bound, expr)


private pure func free_vars_tuple_elements(
	state: ClosureState,
	bound: List[String],
	elements: List[CoreTupleElement],
) -> List[FreeVar]:
	var result: List[FreeVar] = []

	for element in elements:
		result = merge_free_vars(
			result,
			free_vars_tuple_element(state, bound, element),
		)

	result


private pure func free_vars_record_fields(
	state: ClosureState,
	bound: List[String],
	fields: List[CoreRecordFieldValue],
) -> List[FreeVar]:
	var result: List[FreeVar] = []

	for field in fields:
		result = merge_free_vars(
			result,
			free_vars_expr(state, bound, field.value),
		)

	result


private pure func free_vars_dict_entries(
	state: ClosureState,
	bound: List[String],
	entries: List[CoreDictEntry],
) -> List[FreeVar]:
	var result: List[FreeVar] = []

	for entry in entries:
		result = merge_free_vars(
			result,
			free_vars_boxed_storage_value(state, bound, entry.key),
		)
		result = merge_free_vars(
			result,
			free_vars_boxed_storage_value(state, bound, entry.value),
		)

	result


private pure func free_vars_dict_literal_entries(
	state: ClosureState,
	bound: List[String],
	entries: List[CoreDictLiteralEntry],
) -> List[FreeVar]:
	var result: List[FreeVar] = []

	for entry in entries:
		result = merge_free_vars(
			result,
			free_vars_expr(state, bound, entry.key),
		)
		result = merge_free_vars(
			result,
			free_vars_expr(state, bound, entry.value),
		)

	result


private pure func free_vars_tensor_payload(
	state: ClosureState,
	bound: List[String],
	payload: CoreTensorLiteralPayload,
) -> List[FreeVar]:
	match payload:
		TensorRawLiteralPayload(raw):
			free_vars_exprs(state, bound, raw.elements)
		TensorInlineStructLiteralPayload(inline_struct):
			free_vars_exprs(state, bound, inline_struct.elements)


private pure func free_vars_optional_expr(
	state: ClosureState,
	bound: List[String],
	expr: Option[CoreExpr],
) -> List[FreeVar]:
	match expr:
		Some(found):
			free_vars_expr(state, bound, found)
		None:
			[]


private pure func free_vars_literal_match_cases(
	state: ClosureState,
	bound: List[String],
	cases: List[CoreLiteralMatchCase],
) -> List[FreeVar]:
	var result: List[FreeVar] = []

	for match_case in cases:
		case_bound: List[String] = add_bound_match_bindings(bound, match_case.bindings)
		result = merge_free_vars(
			result,
			free_vars_expr(state, case_bound, match_case.body),
		)

	result


private pure func free_vars_literal_match_fallback(
	state: ClosureState,
	bound: List[String],
	fallback: CoreLiteralMatchFallback,
) -> List[FreeVar]:
	match fallback:
		LiteralMatchFallbackBody(body):
			free_vars_expr(state, bound, body)
		LiteralMatchFallbackBindings(bindings, body):
			free_vars_expr(
				state,
				add_bound_match_bindings(bound, bindings),
				body,
			)
		LiteralMatchFallbackFail:
			[]


private pure func free_vars_constructor_match_body(
	state: ClosureState,
	bound: List[String],
	body: CoreConstructorMatchBody,
) -> List[FreeVar]:
	match body:
		ConstructorMatchBodyExpr(expr):
			free_vars_expr(state, bound, expr)
		ConstructorMatchBodyLiteral(literal_match):
			free_vars_constructor_literal_match(state, bound, literal_match)
		ConstructorMatchBodyLength(length_match):
			free_vars_constructor_length_match(state, bound, length_match)


private pure func free_vars_constructor_match_cases(
	state: ClosureState,
	bound: List[String],
	cases: List[CoreConstructorMatchCase],
) -> List[FreeVar]:
	var result: List[FreeVar] = []

	for match_case in cases:
		case_bound: List[String] = add_bound_match_bindings(bound, match_case.bindings)
		result = merge_free_vars(
			result,
			free_vars_constructor_match_body(state, case_bound, match_case.body),
		)

	result


private pure func free_vars_constructor_match_fallback(
	state: ClosureState,
	bound: List[String],
	fallback: CoreConstructorMatchFallback,
) -> List[FreeVar]:
	match fallback:
		ConstructorMatchFallbackBody(body):
			free_vars_expr(state, bound, body)
		ConstructorMatchFallbackBindings(bindings, body):
			free_vars_expr(
				state,
				add_bound_match_bindings(bound, bindings),
				body,
			)
		ConstructorMatchFallbackFail:
			[]


private pure func free_vars_constructor_literal_match(
	state: ClosureState,
	bound: List[String],
	match_expr: CoreConstructorLiteralMatch,
) -> List[FreeVar]:
	var result: List[FreeVar] = free_vars_literal_match_cases(state, bound, match_expr.cases)
	merge_free_vars(
		result,
		free_vars_literal_match_fallback(state, bound, match_expr.fallback),
	)


private pure func free_vars_constructor_length_branch(
	state: ClosureState,
	bound: List[String],
	branch: CoreConstructorLengthMatchBranch,
) -> List[FreeVar]:
	free_vars_constructor_match_body(
		state,
		add_bound_match_bindings(bound, branch.bindings),
		branch.body,
	)


private pure func free_vars_constructor_length_cases(
	state: ClosureState,
	bound: List[String],
	cases: List[CoreConstructorLengthMatchCase],
) -> List[FreeVar]:
	var result: List[FreeVar] = []

	for match_case in cases:
		result = merge_free_vars(
			result,
			free_vars_constructor_length_branch(state, bound, match_case.branch),
		)

	result


private pure func free_vars_constructor_length_geq(
	state: ClosureState,
	bound: List[String],
	geq: Option[CoreConstructorLengthMatchGeq],
) -> List[FreeVar]:
	match geq:
		Some(found):
			free_vars_constructor_length_branch(state, bound, found.branch)
		None:
			[]


private pure func free_vars_constructor_length_fallback(
	state: ClosureState,
	bound: List[String],
	fallback: Option[CoreConstructorLengthMatchBranch],
) -> List[FreeVar]:
	match fallback:
		Some(branch):
			free_vars_constructor_length_branch(state, bound, branch)
		None:
			[]


private pure func free_vars_constructor_length_match(
	state: ClosureState,
	bound: List[String],
	match_expr: CoreConstructorLengthMatch,
) -> List[FreeVar]:
	var result: List[FreeVar] = free_vars_constructor_length_cases(state, bound, match_expr.cases)
	result = merge_free_vars(
		result,
		free_vars_constructor_length_geq(state, bound, match_expr.geq),
	)
	merge_free_vars(
		result,
		free_vars_constructor_length_fallback(state, bound, match_expr.fallback),
	)


private pure func free_vars_select_arm_kind(
	state: ClosureState,
	bound: List[String],
	kind: CoreSelectArmKind,
) -> List[FreeVar]:
	match kind:
		SelectRecvArm(recv):
			free_vars_expr(state, bound, recv.channel)
		SelectSealedArm(channel):
			free_vars_expr(state, bound, channel)
		SelectAfterArm(timeout):
			free_vars_expr(state, bound, timeout)


private pure func free_vars_select_arm(
	state: ClosureState,
	bound: List[String],
	arm: CoreSelectArm,
) -> List[FreeVar]:
	arm_bound: List[String] = match arm.kind:
		SelectRecvArm(recv):
			add_bound_var(bound, recv.binder)
		SelectSealedArm(channel):
			bound
		SelectAfterArm(timeout):
			bound

	merge_free_vars(
		free_vars_select_arm_kind(state, bound, arm.kind),
		free_vars_expr(state, arm_bound, arm.body),
	)


private pure func free_vars_select_arms(
	state: ClosureState,
	bound: List[String],
	arms: List[CoreSelectArm],
) -> List[FreeVar]:
	var result: List[FreeVar] = []

	for arm in arms:
		result = merge_free_vars(
			result,
			free_vars_select_arm(state, bound, arm),
		)

	result


private pure func free_vars_expr(
	state: ClosureState,
	bound: List[String],
	expr: CoreExpr,
) -> List[FreeVar]:
	match expr:
		VarExpr(variable, typ, loc):
			if contains_name(bound, variable.name):
				[]
			else if contains_name(state.constructor_names, variable.name):
				[]
			else if contains_name(state.function_names, variable.name):
				[]
			else:
				[
					{
						name = variable.name,
						typ = typ
					},
				]
		LiteralExpr(literal, typ, loc):
			[]
		VoidExpr(typ, loc):
			[]
		CooperativeCheckpointExpr(typ, loc):
			[]
		CallExpr(kind, callee, args, typ, loc):
			callee_free_vars: List[FreeVar] = if call_kind_uses_runtime_callee(kind):
				free_vars_expr(state, bound, callee)
			else:
				[]

			merge_free_vars(
				callee_free_vars,
				free_vars_exprs(state, bound, args),
			)
		BinaryExpr(op, left, right, typ, loc):
			merge_free_vars(
				free_vars_expr(state, bound, left),
				free_vars_expr(state, bound, right),
			)
		UnaryExpr(op, expr_value, typ, loc):
			free_vars_expr(state, bound, expr_value)
		LogicalExpr(op, left, right, typ, loc):
			merge_free_vars(
				free_vars_expr(state, bound, left),
				free_vars_expr(state, bound, right),
			)
		AssignExpr(variable, rhs, typ, loc):
			free_vars_expr(state, bound, rhs)
		CastExpr(expr_value, typ, loc):
			free_vars_expr(state, bound, expr_value)
		BoxExpr(box, typ, loc):
			free_vars_expr(state, bound, box.value)
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			free_vars_expr(state, bound, expr_value)
		FieldExpr(expr_value, field_name, typ, loc):
			free_vars_expr(state, bound, expr_value)
		TupleFieldExpr(expr_value, field_index, typ, loc):
			free_vars_expr(state, bound, expr_value)
		TupleExpr(items, typ, loc):
			free_vars_exprs(state, bound, items)
		TupleConstructExpr(tuple_construct, typ, loc):
			free_vars_tuple_elements(state, bound, tuple_construct.elements)
		VectorExpr(items, typ, loc):
			free_vars_exprs(state, bound, items)
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			free_vars_expr(
				state,
				add_bound_params(bound, lambda_params),
				lambda_body,
			)
		ClosureCreateExpr(closure, typ, loc):
			var result: List[FreeVar] = []

			for capture in closure.captures:
				if contains_name(bound, capture.name):
					void
				else:
					result = add_free_var(result, capture.name, capture.typ)

			result
		ListConstructExpr(construct, typ, loc):
			free_vars_boxed_storage_values(state, bound, construct.elements)
		ListAllocExpr(alloc, typ, loc):
			free_vars_expr(state, bound, alloc.capacity)
		ListGetExpr(get, typ, loc):
			merge_free_vars(
				free_vars_expr(state, bound, get.list),
				free_vars_expr(state, bound, get.index),
			)
		ListHandoffExpr(handoff, typ, loc):
			var result: List[FreeVar] = free_vars_expr(state, bound, handoff.source)
			result = merge_free_vars(
				result,
				free_vars_expr(state, bound, handoff.capacity),
			)
			inner_bound: List[String] = bound
				.add_bound_var(handoff.source_var)
				.add_bound_var(handoff.result_var)
				.add_bound_var(handoff.len_var)
				.add_bound_var(handoff.out_var)
			merge_free_vars(
				result,
				free_vars_expr(state, inner_bound, handoff.body),
			)
		ListHandoffSetOwnedExpr(set, typ, loc):
			var result: List[FreeVar] = free_vars_expr(state, bound, set.list)
			result = merge_free_vars(
				result,
				free_vars_expr(state, bound, set.index),
			)
			merge_free_vars(
				result,
				free_vars_boxed_storage_value(state, bound, set.value),
			)
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			var result: List[FreeVar] = free_vars_expr(state, bound, slot.result)
			result = merge_free_vars(
				result,
				free_vars_expr(state, bound, slot.out_index),
			)
			result = merge_free_vars(
				result,
				free_vars_expr(state, bound, slot.source),
			)
			merge_free_vars(
				result,
				free_vars_expr(state, bound, slot.source_index),
			)
		StringByteReadExpr(read, typ, loc):
			merge_free_vars(
				free_vars_expr(state, bound, read.source),
				free_vars_expr(state, bound, read.index),
			)
		StringByteWriteExpr(write, typ, loc):
			var result: List[FreeVar] = free_vars_expr(state, bound, write.target)
			result = merge_free_vars(
				result,
				free_vars_expr(state, bound, write.index),
			)
			merge_free_vars(
				result,
				free_vars_expr(state, bound, write.byte),
			)
		StringByteCopyExpr(copy, typ, loc):
			var result: List[FreeVar] = free_vars_expr(state, bound, copy.dst)
			result = merge_free_vars(
				result,
				free_vars_expr(state, bound, copy.dst_pos),
			)
			result = merge_free_vars(
				result,
				free_vars_expr(state, bound, copy.src),
			)
			result = merge_free_vars(
				result,
				free_vars_expr(state, bound, copy.src_pos),
			)
			merge_free_vars(
				result,
				free_vars_expr(state, bound, copy.len),
			)
		StringSetLenExpr(set_len, typ, loc):
			merge_free_vars(
				free_vars_expr(state, bound, set_len.target),
				free_vars_expr(state, bound, set_len.len),
			)
		TensorLiteralExpr(literal, typ, loc):
			free_vars_tensor_payload(state, bound, literal.payload)
		TensorBoxedLiteralExpr(literal, typ, loc):
			free_vars_boxed_storage_values(state, bound, literal.elements)
		TensorPackedLiteralExpr(literal, typ, loc):
			[]
		TensorRawFillExpr(fill, typ, loc):
			merge_free_vars(
				free_vars_expr(state, bound, fill.value),
				free_vars_exprs(state, bound, fill.dims),
			)
		TensorRawReadExpr(read, typ, loc):
			free_vars_expr(state, bound, read.index)
		TensorRawWriteExpr(write, typ, loc):
			merge_free_vars(
				free_vars_expr(state, bound, write.index),
				free_vars_expr(state, bound, write.value),
			)
		TensorRawViewLetExpr(binding, body, typ, loc):
			var result: List[FreeVar] = free_vars_expr(state, bound, binding.source)
			merge_free_vars(
				result,
				free_vars_expr(
					state,
					add_bound_var(bound, binding.variable),
					body,
				),
			)
		DictExpr(entries, typ, loc):
			free_vars_dict_literal_entries(state, bound, entries)
		DictConstructExpr(construct, typ, loc):
			free_vars_dict_entries(state, bound, construct.entries)
		SetAllocExpr(alloc, typ, loc):
			[]
		ListRetainExpr(retain, typ, loc):
			var result: List[FreeVar] = free_vars_expr(state, bound, retain.list)
			merge_free_vars(
				result,
				free_vars_boxed_storage_value(state, bound, retain.value),
			)
		ListSetExpr(set, typ, loc):
			var result: List[FreeVar] = free_vars_expr(state, bound, set.list)
			result = merge_free_vars(
				result,
				free_vars_expr(state, bound, set.index),
			)
			merge_free_vars(
				result,
				free_vars_boxed_storage_value(state, bound, set.value),
			)
		ListSwapExpr(swap, typ, loc):
			var result: List[FreeVar] = free_vars_expr(state, bound, swap.list)
			result = merge_free_vars(
				result,
				free_vars_expr(state, bound, swap.left_index),
			)
			merge_free_vars(
				result,
				free_vars_expr(state, bound, swap.right_index),
			)
		RecordExpr(fields, typ, loc):
			free_vars_record_fields(state, bound, fields)
		RecordConstructExpr(type_name, fields, typ, loc):
			free_vars_record_fields(state, bound, fields)
		UnionConstructExpr(construct, typ, loc):
			free_vars_boxed_storage_values(state, bound, construct.args)
		UnionReuseConstructExpr(construct, typ, loc):
			var result: List[FreeVar] = free_vars_expr(state, bound, construct.source)
			merge_free_vars(
				result,
				free_vars_boxed_storage_values(state, bound, construct.args),
			)
		PreClosureDetachExpr(detached, typ, loc):
			free_vars_expr(state, bound, detached.body)
		DetachExpr(detached, typ, loc):
			var result: List[FreeVar] = []

			for capture in detached.task.captures:
				if contains_name(bound, capture.name):
					void
				else:
					result = add_free_var(result, capture.name, capture.typ)

			result
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			free_vars_expr(state, bound, body)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			free_vars_expr(state, bound, body)
		LetExpr(variable, is_mutable, value_type, rhs, body):
			var result: List[FreeVar] = free_vars_expr(state, bound, rhs)
			merge_free_vars(
				result,
				free_vars_expr(
					state,
					add_bound_var(bound, variable),
					body,
				),
			)
		BorrowLetExpr(variable, value_type, rhs, body):
			var result: List[FreeVar] = free_vars_expr(state, bound, rhs)
			merge_free_vars(
				result,
				free_vars_expr(
					state,
					add_bound_var(bound, variable),
					body,
				),
			)
		SeqExpr(first, second):
			merge_free_vars(
				free_vars_expr(state, bound, first),
				free_vars_expr(state, bound, second),
			)
		WhileExpr(cond, body, typ, loc):
			merge_free_vars(
				free_vars_expr(state, bound, cond),
				free_vars_expr(state, bound, body),
			)
		BreakExpr(typ, loc):
			[]
		ContinueExpr(typ, loc):
			[]
		ResourceScopeExpr(scope, typ, loc):
			var result: List[FreeVar] = free_vars_expr(state, bound, scope.acquire)
			scoped_bound: List[String] = add_bound_var(bound, scope.variable)
			result = merge_free_vars(
				result,
				free_vars_expr(state, scoped_bound, scope.body),
			)
			merge_free_vars(
				result,
				free_vars_expr(state, scoped_bound, scope.cleanup),
			)
		ResourceCleanupExitExpr(exit, typ, loc):
			free_vars_exprs(state, bound, exit.cleanups)
		TailrecLoopExpr(params, return_type, body, loc):
			free_vars_expr(
				state,
				add_bound_params(bound, params),
				body,
			)
		TailrecRecurExpr(args, typ, loc):
			free_vars_exprs(state, bound, args)
		TailrecListSpreadLoopExpr(loop, loc):
			loop_bound: List[String] = bound
				.add_bound_param(loop.list_param)
				.add_bound_var(loop.cursor)
			free_vars_expr(state, loop_bound, loop.body)
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			var result: List[FreeVar] = []

			for rebind in rebinds:
				result = merge_free_vars(
					result,
					free_vars_expr(state, bound, rebind.value),
				)

			result
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			var result: List[FreeVar] = free_vars_expr(state, bound, start)
			result = merge_free_vars(
				result,
				free_vars_expr(state, bound, end_value),
			)
			merge_free_vars(
				result,
				free_vars_expr(
					state,
					add_bound_var(bound, binder.variable),
					body,
				),
			)
		ForChannelExpr(for_channel, typ, loc):
			var result: List[FreeVar] = free_vars_expr(state, bound, for_channel.iterable)
			merge_free_vars(
				result,
				free_vars_expr(
					state,
					add_bound_var(bound, for_channel.binder.variable),
					for_channel.body,
				),
			)
		ForListExpr(for_list, typ, loc):
			var result: List[FreeVar] = free_vars_expr(state, bound, for_list.iterable)
			merge_free_vars(
				result,
				free_vars_expr(
					state,
					add_bound_var(bound, for_list.binder.variable),
					for_list.body,
				),
			)
		ForStringExpr(for_string, typ, loc):
			var result: List[FreeVar] = free_vars_expr(state, bound, for_string.iterable)
			merge_free_vars(
				result,
				free_vars_expr(
					state,
					add_bound_var(bound, for_string.binder.variable),
					for_string.body,
				),
			)
		ForDictExpr(for_dict, typ, loc):
			var result: List[FreeVar] = free_vars_expr(state, bound, for_dict.iterable)
			merge_free_vars(
				result,
				free_vars_expr(
					state,
					add_bound_var(bound, for_dict.binder.variable),
					for_dict.body,
				),
			)
		ForSetExpr(for_set, typ, loc):
			var result: List[FreeVar] = free_vars_expr(state, bound, for_set.iterable)
			merge_free_vars(
				result,
				free_vars_expr(
					state,
					add_bound_var(bound, for_set.binder.variable),
					for_set.body,
				),
			)
		ForStreamExpr(for_stream, typ, loc):
			var result: List[FreeVar] = free_vars_expr(state, bound, for_stream.iterable)
			merge_free_vars(
				result,
				free_vars_expr(
					state,
					add_bound_var(bound, for_stream.binder.variable),
					for_stream.body,
				),
			)
		ForResourceSourceExpr(for_resource_source, typ, loc):
			var result: List[FreeVar] = free_vars_expr(state, bound, for_resource_source.iterable)
			merge_free_vars(
				result,
				free_vars_expr(
					state,
					add_bound_var(bound, for_resource_source.binder.variable),
					for_resource_source.body,
				),
			)
		ForTensorExpr(for_tensor, typ, loc):
			var result: List[FreeVar] = free_vars_expr(state, bound, for_tensor.iterable)
			merge_free_vars(
				result,
				free_vars_expr(
					state,
					add_bound_var(bound, for_tensor.binder.variable),
					for_tensor.body,
				),
			)
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			var result: List[FreeVar] = free_vars_expr(state, bound, loop.iterable)
			body_bound: List[String] = add_bound_var(bound, loop.variable)
			result = merge_free_vars(
				result,
				free_vars_expr(state, body_bound, loop.body),
			)
			result = merge_free_vars(
				result,
				free_vars_optional_expr(state, bound, loop.timeout),
			)
			merge_free_vars(
				result,
				free_vars_expr(state, bound, loop.limit),
			)
		ConcurrentlyLoopExpr(loop, typ, loc):
			var result: List[FreeVar] = free_vars_expr(state, bound, loop.iterable)
			body_bound: List[String] = add_bound_var(bound, loop.variable)
			result = merge_free_vars(
				result,
				free_vars_expr(state, body_bound, loop.body),
			)
			result = merge_free_vars(
				result,
				free_vars_optional_expr(state, bound, loop.timeout),
			)
			merge_free_vars(
				result,
				free_vars_expr(state, bound, loop.limit),
			)
		PreClosureConcurrentExpr(block, typ, loc):
			var result: List[FreeVar] = []

			for binding in block.bindings:
				result = merge_free_vars(
					result,
					free_vars_expr(state, bound, binding.rhs),
				)

			var body_bound: List[String] = bound

			for binding in block.bindings:
				body_bound = add_bound_var(body_bound, binding.variable)

			result = merge_free_vars(
				result,
				free_vars_expr(state, body_bound, block.body),
			)
			merge_free_vars(
				result,
				free_vars_optional_expr(state, bound, block.timeout),
			)
		ConcurrentExpr(block, typ, loc):
			var result: List[FreeVar] = []

			for binding in block.bindings:
				result = merge_free_vars(
					result,
					free_vars_expr(state, bound, binding.rhs),
				)

			var body_bound: List[String] = bound

			for binding in block.bindings:
				body_bound = add_bound_var(body_bound, binding.variable)

			result = merge_free_vars(
				result,
				free_vars_expr(state, body_bound, block.body),
			)
			merge_free_vars(
				result,
				free_vars_optional_expr(state, bound, block.timeout),
			)
		SelectExpr(select_expr, typ, loc):
			free_vars_select_arms(state, bound, select_expr.arms)
		RangeExpr(start, end_value, typ, loc):
			merge_free_vars(
				free_vars_expr(state, bound, start),
				free_vars_expr(state, bound, end_value),
			)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			var result: List[FreeVar] = free_vars_expr(state, bound, scrutinee)
			result = merge_free_vars(
				result,
				free_vars_literal_match_cases(state, bound, cases),
			)
			merge_free_vars(
				result,
				free_vars_literal_match_fallback(state, bound, fallback),
			)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			var result: List[FreeVar] = free_vars_expr(state, bound, scrutinee)
			merge_free_vars(
				result,
				free_vars_constructor_literal_match(state, bound, match_expr),
			)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			var result: List[FreeVar] = free_vars_expr(state, bound, scrutinee)
			merge_free_vars(
				result,
				free_vars_constructor_length_match(state, bound, match_expr),
			)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			var result: List[FreeVar] = free_vars_expr(state, bound, scrutinee)
			result = merge_free_vars(
				result,
				free_vars_constructor_match_cases(state, bound, cases),
			)
			merge_free_vars(
				result,
				free_vars_constructor_match_fallback(state, bound, fallback),
			)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			var result: List[FreeVar] = free_vars_expr(state, bound, cond)
			result = merge_free_vars(
				result,
				free_vars_expr(state, bound, then_expr),
			)
			merge_free_vars(
				result,
				free_vars_expr(state, bound, else_expr),
			)


private pure func next_lambda_name(state: ClosureState) -> FreshHoistedName:
	name: String = LAMBDA_NAME_PREFIX + state.next_lambda_index.to_string()
	def_id: Int = state.next_def_id
	c_name: String = mangle_by_def_id(def_id, name)
	new_state: ClosureState = { state |
		next_lambda_index = state.next_lambda_index + 1,
		next_def_id = state.next_def_id + 1
	}
	{
		state = new_state,
		name = name,
		def_id = def_id,
		c_name = c_name,
		static_name = static_closure_name(c_name)
	}


private pure func next_task_name(state: ClosureState) -> FreshHoistedName:
	name: String = TASK_NAME_PREFIX + state.next_task_index.to_string()
	def_id: Int = state.next_def_id
	c_name: String = mangle_by_def_id(def_id, name)
	new_state: ClosureState = { state |
		next_task_index = state.next_task_index + 1,
		next_def_id = state.next_def_id + 1
	}
	{
		state = new_state,
		name = name,
		def_id = def_id,
		c_name = c_name,
		static_name = static_closure_name(c_name)
	}


private pure func capture_is_allowed(
	state: ClosureState,
	capturable: List[String],
	name: String,
) -> Bool:
	(
		not contains_name(state.constructor_names, name)
		and not contains_name(state.function_names, name)
	)


private pure func captures_from_body(
	state: ClosureState,
	capturable: List[String],
	local_bound: List[String],
	body: CoreExpr,
) -> List[FreeVar]:
	var result: List[FreeVar] = []

	for free_var in free_vars_expr(state, local_bound, body):
		if capture_is_allowed(state, capturable, free_var.name):
			result = add_free_var(result, free_var.name, free_var.typ)
		else:
			void

	result


pure func lambda_runtime_captures(
	function_names: List[String],
	constructor_names: List[String],
	params: List[CoreParam],
	body: CoreExpr,
) -> List[CoreClosureCapture]:
	state: ClosureState = {
		next_lambda_index = 0,
		next_task_index = 0,
		next_def_id = 0,
		current_module = None,
		function_names = function_names,
		constructor_names = constructor_names,
		hoisted = []
	}

	closure_captures_from_free_vars(
		captures_from_body(
			state,
			[],
			add_bound_params([], params),
			body,
		),
	)


pure func lambda_has_runtime_captures(
	function_names: List[String],
	constructor_names: List[String],
	params: List[CoreParam],
	body: CoreExpr,
) -> Bool:
	lambda_runtime_captures(function_names, constructor_names, params, body).length() > 0


private pure func core_expr_type(expr: CoreExpr) -> CoreType:
	match expr:
		LiteralExpr(literal, typ, loc):
			typ
		VarExpr(variable, typ, loc):
			typ
		VoidExpr(typ, loc):
			typ
		CooperativeCheckpointExpr(typ, loc):
			typ
		CallExpr(kind, callee, args, typ, loc):
			typ
		BinaryExpr(op, left, right, typ, loc):
			typ
		UnaryExpr(op, expr_value, typ, loc):
			typ
		LogicalExpr(op, left, right, typ, loc):
			typ
		AssignExpr(variable, rhs, typ, loc):
			typ
		CastExpr(expr_value, typ, loc):
			typ
		BoxExpr(box, typ, loc):
			typ
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			typ
		FieldExpr(expr_value, field_name, typ, loc):
			typ
		TupleFieldExpr(expr_value, field_index, typ, loc):
			typ
		TupleExpr(items, typ, loc):
			typ
		TupleConstructExpr(tuple_construct, typ, loc):
			typ
		VectorExpr(items, typ, loc):
			typ
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			typ
		ClosureCreateExpr(closure, typ, loc):
			typ
		ListConstructExpr(construct, typ, loc):
			typ
		ListAllocExpr(alloc, typ, loc):
			typ
		ListGetExpr(get, typ, loc):
			typ
		ListHandoffExpr(handoff, typ, loc):
			typ
		ListHandoffSetOwnedExpr(set, typ, loc):
			typ
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			typ
		StringByteReadExpr(read, typ, loc):
			typ
		StringByteWriteExpr(write, typ, loc):
			typ
		StringByteCopyExpr(copy, typ, loc):
			typ
		StringSetLenExpr(set_len, typ, loc):
			typ
		TensorLiteralExpr(literal, typ, loc):
			typ
		TensorBoxedLiteralExpr(literal, typ, loc):
			typ
		TensorPackedLiteralExpr(literal, typ, loc):
			typ
		TensorRawFillExpr(fill, typ, loc):
			typ
		TensorRawReadExpr(read, typ, loc):
			typ
		TensorRawWriteExpr(write, typ, loc):
			typ
		TensorRawViewLetExpr(binding, body, typ, loc):
			typ
		DictExpr(entries, typ, loc):
			typ
		DictConstructExpr(construct, typ, loc):
			typ
		SetAllocExpr(alloc, typ, loc):
			typ
		ListRetainExpr(retain, typ, loc):
			typ
		ListSetExpr(set, typ, loc):
			typ
		ListSwapExpr(swap, typ, loc):
			typ
		RecordExpr(fields, typ, loc):
			typ
		RecordConstructExpr(type_name, fields, typ, loc):
			typ
		UnionConstructExpr(construct, typ, loc):
			typ
		UnionReuseConstructExpr(construct, typ, loc):
			typ
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			typ
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			typ
		LetExpr(name, is_mutable, typ, rhs, body):
			core_expr_type(body)
		BorrowLetExpr(name, typ, rhs, body):
			core_expr_type(body)
		SeqExpr(first, second):
			core_expr_type(second)
		WhileExpr(cond, body, typ, loc):
			typ
		BreakExpr(typ, loc):
			typ
		ContinueExpr(typ, loc):
			typ
		ResourceScopeExpr(scope, typ, loc):
			typ
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			typ
		TailrecLoopExpr(params, return_type, body, loc):
			return_type
		TailrecRecurExpr(args, typ, loc):
			typ
		TailrecListSpreadLoopExpr(loop, loc):
			loop.return_type
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			typ
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			typ
		ForChannelExpr(for_channel, typ, loc):
			typ
		ForListExpr(for_list, typ, loc):
			typ
		ForStringExpr(for_string, typ, loc):
			typ
		ForDictExpr(for_dict, typ, loc):
			typ
		ForSetExpr(for_set, typ, loc):
			typ
		ForResourceSourceExpr(for_resource_source, typ, loc):
			typ
		ForStreamExpr(for_stream, typ, loc):
			typ
		ForTensorExpr(for_tensor, typ, loc):
			typ
		PreClosureDetachExpr(detached, typ, loc):
			typ
		DetachExpr(detached, typ, loc):
			typ
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			typ
		ConcurrentlyLoopExpr(loop, typ, loc):
			typ
		PreClosureConcurrentExpr(block, typ, loc):
			typ
		ConcurrentExpr(block, typ, loc):
			typ
		SelectExpr(select_expr, typ, loc):
			typ
		RangeExpr(start, end_value, typ, loc):
			typ
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			typ
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			typ
		LiteralMatchExpr(scrutinee, cases, default_body, typ, loc):
			typ
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, default_body, typ, loc):
			typ
		IfExpr(cond, then_expr, else_expr, typ, loc):
			typ


private pure func closure_capture_from_free_var(free_var: FreeVar) -> CoreClosureCapture:
	{
		name = free_var.name,
		typ = free_var.typ
	}


private pure func closure_captures_from_free_vars(
	free_vars: List[FreeVar],
) -> List[CoreClosureCapture]:
	free_vars.map(closure_capture_from_free_var)


private pure func task_capture_from_free_var(
	free_var: FreeVar,
	kind: CoreTaskCaptureKind,
) -> CoreTaskCapture:
	{
		name = free_var.name,
		typ = free_var.typ,
		kind = kind
	}


private pure func task_captures_from_free_vars(
	free_vars: List[FreeVar],
	default_kind: CoreTaskCaptureKind,
) -> List[CoreTaskCapture]:
	free_vars.map(func(free_var): task_capture_from_free_var(free_var, default_kind))


private pure func task_captures_for_loop(
	free_vars: List[FreeVar],
	loop_variable: CoreVar,
	item_mode: CoreConcurrentlyLoopItemMode,
) -> List[CoreTaskCapture]:
	var result: List[CoreTaskCapture] = []

	for free_var in free_vars:
		kind: CoreTaskCaptureKind = match item_mode:
			ConcurrentlyLoopMoveResourceItem(move_item):
				if free_var.name == loop_variable.name:
					TaskMoveResourceItem
				else:
					TaskCopyCapture
			ConcurrentlyLoopCopyItem:
				TaskCopyCapture

		result = result.append(task_capture_from_free_var(free_var, kind))

	result


private pure func same_var_name(left: CoreVar, right: CoreVar) -> Bool:
	left.name == right.name


private pure func expr_is_var_ref(expr: CoreExpr, variable: CoreVar) -> Bool:
	match expr:
		VarExpr(candidate, typ, loc):
			same_var_name(candidate, variable)
		LiteralExpr(literal, typ, loc):
			False
		VoidExpr(typ, loc):
			False
		CooperativeCheckpointExpr(typ, loc):
			False
		CallExpr(kind, callee, args, typ, loc):
			False
		BinaryExpr(op, left, right, typ, loc):
			False
		UnaryExpr(op, expr_value, typ, loc):
			False
		LogicalExpr(op, left, right, typ, loc):
			False
		AssignExpr(assign_var, rhs, typ, loc):
			False
		CastExpr(expr_value, typ, loc):
			False
		BoxExpr(box, typ, loc):
			False
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			False
		FieldExpr(expr_value, field_name, typ, loc):
			False
		TupleFieldExpr(expr_value, field_index, typ, loc):
			False
		TupleExpr(items, typ, loc):
			False
		TupleConstructExpr(tuple_construct, typ, loc):
			False
		VectorExpr(items, typ, loc):
			False
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			False
		ClosureCreateExpr(closure, typ, loc):
			False
		ListConstructExpr(construct, typ, loc):
			False
		ListAllocExpr(alloc, typ, loc):
			False
		ListGetExpr(get, typ, loc):
			False
		ListHandoffExpr(handoff, typ, loc):
			False
		ListHandoffSetOwnedExpr(set, typ, loc):
			False
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			False
		ListRetainExpr(retain, typ, loc):
			False
		ListSetExpr(set, typ, loc):
			False
		ListSwapExpr(swap, typ, loc):
			False
		StringByteReadExpr(read, typ, loc):
			False
		StringByteWriteExpr(write, typ, loc):
			False
		StringByteCopyExpr(copy, typ, loc):
			False
		StringSetLenExpr(set_len, typ, loc):
			False
		TensorLiteralExpr(literal, typ, loc):
			False
		TensorBoxedLiteralExpr(literal, typ, loc):
			False
		TensorPackedLiteralExpr(literal, typ, loc):
			False
		TensorRawFillExpr(fill, typ, loc):
			False
		TensorRawReadExpr(read, typ, loc):
			False
		TensorRawWriteExpr(write, typ, loc):
			False
		TensorRawViewLetExpr(binding, body, typ, loc):
			False
		DictExpr(entries, typ, loc):
			False
		DictConstructExpr(construct, typ, loc):
			False
		SetAllocExpr(alloc, typ, loc):
			False
		RecordExpr(fields, typ, loc):
			False
		RecordConstructExpr(type_name, fields, typ, loc):
			False
		UnionConstructExpr(construct, typ, loc):
			False
		UnionReuseConstructExpr(construct, typ, loc):
			False
		PreClosureDetachExpr(detached, typ, loc):
			False
		DetachExpr(detached, typ, loc):
			False
		DupExpr(dup_var, value_type, retain_policy, body, typ, loc):
			False
		DropExpr(drop_var, value_type, release_policy, body, typ, loc):
			False
		LetExpr(name, is_mutable, typ, rhs, body):
			False
		BorrowLetExpr(name, typ, rhs, body):
			False
		SeqExpr(first, second):
			False
		WhileExpr(cond, body, typ, loc):
			False
		BreakExpr(typ, loc):
			False
		ContinueExpr(typ, loc):
			False
		ResourceScopeExpr(scope, typ, loc):
			False
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			False
		TailrecLoopExpr(params, return_type, body, loc):
			False
		TailrecRecurExpr(args, typ, loc):
			False
		TailrecListSpreadLoopExpr(loop, loc):
			False
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			False
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			False
		ForChannelExpr(for_channel, typ, loc):
			False
		ForListExpr(for_list, typ, loc):
			False
		ForStringExpr(for_string, typ, loc):
			False
		ForDictExpr(for_dict, typ, loc):
			False
		ForSetExpr(for_set, typ, loc):
			False
		ForResourceSourceExpr(for_resource_source, typ, loc):
			False
		ForStreamExpr(for_stream, typ, loc):
			False
		ForTensorExpr(for_tensor, typ, loc):
			False
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			False
		ConcurrentlyLoopExpr(loop, typ, loc):
			False
		PreClosureConcurrentExpr(block, typ, loc):
			False
		ConcurrentExpr(block, typ, loc):
			False
		SelectExpr(select_expr, typ, loc):
			False
		RangeExpr(start, end_value, typ, loc):
			False
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			False
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			False
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			False
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			False
		IfExpr(cond, then_expr, else_expr, typ, loc):
			False


private pure func consumed_arg_refs_var(
	consumed_args: List[Int],
	args: List[CoreExpr],
	variable: CoreVar,
) -> Bool:
	var found: Bool = False
	var index: Int = 0

	for arg in args:
		if consumed_args.contains(index) and expr_is_var_ref(arg, variable):
			found = True
			break
		else:
			void

		index += 1

	found


private pure func call_consumes_var(
	kind: CoreCallKind,
	args: List[CoreExpr],
	variable: CoreVar,
) -> Bool:
	match kind:
		UserCall(name, def_id, consumed_args):
			consumed_arg_refs_var(consumed_args, args, variable)
		ClosureCall:
			False
		ForeignCall(name, arg_passing):
			False
		BuiltinCall(name):
			False
		DirectRuntimeCall(call):
			False
		OperationResultCall(bridge):
			False
		FallibleStreamTerminalCall(bridge):
			False
		TensorParallelCall(name, layout):
			False
		DictWithCapacityCall(constructor):
			False
		ListToStringCall(callback_name):
			False
		IntrinsicCall(name):
			False


private pure func exprs_consume_var(exprs: List[CoreExpr], variable: CoreVar) -> Bool:
	var found: Bool = False

	for expr in exprs:
		if expr_consumes_var(expr, variable):
			found = True
			break
		else:
			void

	found


private pure func boxed_storage_value_consumes_var(
	value: CoreBoxedStorageValue,
	variable: CoreVar,
) -> Bool:
	expr_consumes_var(value.value, variable)


private pure func boxed_storage_values_consume_var(
	values: List[CoreBoxedStorageValue],
	variable: CoreVar,
) -> Bool:
	var found: Bool = False

	for value in values:
		if boxed_storage_value_consumes_var(value, variable):
			found = True
			break
		else:
			void

	found


private pure func tuple_element_consumes_var(element: CoreTupleElement, variable: CoreVar) -> Bool:
	match element:
		TuplePrimElement(expr):
			expr_consumes_var(expr, variable)
		TuplePointerElement(expr):
			expr_consumes_var(expr, variable)
		TupleStructElement(expr, c_type):
			expr_consumes_var(expr, variable)
		TupleVoidElement:
			False
		TupleFloatElement(expr):
			expr_consumes_var(expr, variable)
		TupleFloat32Element(expr):
			expr_consumes_var(expr, variable)
		TupleFloat16Element(expr):
			expr_consumes_var(expr, variable)


private pure func tuple_elements_consume_var(
	elements: List[CoreTupleElement],
	variable: CoreVar,
) -> Bool:
	var found: Bool = False

	for element in elements:
		if tuple_element_consumes_var(element, variable):
			found = True
			break
		else:
			void

	found


private pure func record_fields_consume_var(
	fields: List[CoreRecordFieldValue],
	variable: CoreVar,
) -> Bool:
	var found: Bool = False

	for field in fields:
		if expr_consumes_var(field.value, variable):
			found = True
			break
		else:
			void

	found


private pure func dict_entries_consume_var(entries: List[CoreDictEntry], variable: CoreVar) -> Bool:
	var found: Bool = False

	for entry in entries:
		if boxed_storage_value_consumes_var(entry.key, variable):
			found = True
			break
		else if boxed_storage_value_consumes_var(entry.value, variable):
			found = True
			break
		else:
			void

	found


private pure func dict_literal_entries_consume_var(
	entries: List[CoreDictLiteralEntry],
	variable: CoreVar,
) -> Bool:
	var found: Bool = False

	for entry in entries:
		if expr_consumes_var(entry.key, variable):
			found = True
			break
		else if expr_consumes_var(entry.value, variable):
			found = True
			break
		else:
			void

	found


private pure func tensor_payload_consumes_var(
	payload: CoreTensorLiteralPayload,
	variable: CoreVar,
) -> Bool:
	match payload:
		TensorRawLiteralPayload(raw):
			exprs_consume_var(raw.elements, variable)
		TensorInlineStructLiteralPayload(inline_struct):
			exprs_consume_var(inline_struct.elements, variable)


private pure func optional_expr_consumes_var(expr: Option[CoreExpr], variable: CoreVar) -> Bool:
	match expr:
		Some(found):
			expr_consumes_var(found, variable)
		None:
			False


private pure func core_type_is_void(typ: CoreType) -> Bool:
	match typ:
		VoidType:
			True
		NamedType(name, args):
			False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		HeapRecordType(name):
			False
		UnionType(name):
			False
		RangeType:
			False
		TensorType(info):
			False
		TupleType(items):
			False


private pure func match_bindings_shadow_var(
	bindings: List[CoreMatchBinding],
	variable: CoreVar,
) -> Bool:
	var found: Bool = False

	for binding in bindings:
		if same_var_name(binding.variable, variable):
			found = True
			break
		else:
			void

	found


private pure func literal_match_cases_consume_var(
	cases: List[CoreLiteralMatchCase],
	variable: CoreVar,
) -> Bool:
	var found: Bool = False

	for match_case in cases:
		if match_bindings_shadow_var(match_case.bindings, variable):
			void
		else if expr_consumes_var(match_case.body, variable):
			found = True
			break
		else:
			void

	found


private pure func literal_match_fallback_consumes_var(
	fallback: CoreLiteralMatchFallback,
	variable: CoreVar,
) -> Bool:
	match fallback:
		LiteralMatchFallbackBody(body):
			expr_consumes_var(body, variable)
		LiteralMatchFallbackBindings(bindings, body):
			if match_bindings_shadow_var(bindings, variable):
				False
			else:
				expr_consumes_var(body, variable)
		LiteralMatchFallbackFail:
			False


private pure func constructor_match_body_consumes_var(
	body: CoreConstructorMatchBody,
	variable: CoreVar,
) -> Bool:
	match body:
		ConstructorMatchBodyExpr(expr):
			expr_consumes_var(expr, variable)
		ConstructorMatchBodyLiteral(literal_match):
			constructor_literal_match_consumes_var(literal_match, variable)
		ConstructorMatchBodyLength(length_match):
			constructor_length_match_consumes_var(length_match, variable)


private pure func constructor_match_cases_consume_var(
	cases: List[CoreConstructorMatchCase],
	variable: CoreVar,
) -> Bool:
	var found: Bool = False

	for match_case in cases:
		if match_bindings_shadow_var(match_case.bindings, variable):
			void
		else if constructor_match_body_consumes_var(match_case.body, variable):
			found = True
			break
		else:
			void

	found


private pure func constructor_match_fallback_consumes_var(
	fallback: CoreConstructorMatchFallback,
	variable: CoreVar,
) -> Bool:
	match fallback:
		ConstructorMatchFallbackBody(body):
			expr_consumes_var(body, variable)
		ConstructorMatchFallbackBindings(bindings, body):
			if match_bindings_shadow_var(bindings, variable):
				False
			else:
				expr_consumes_var(body, variable)
		ConstructorMatchFallbackFail:
			False


private pure func constructor_literal_match_consumes_var(
	match_expr: CoreConstructorLiteralMatch,
	variable: CoreVar,
) -> Bool:
	(
		literal_match_cases_consume_var(match_expr.cases, variable)
		or literal_match_fallback_consumes_var(match_expr.fallback, variable)
	)


private pure func constructor_length_branch_consumes_var(
	branch: CoreConstructorLengthMatchBranch,
	variable: CoreVar,
) -> Bool:
	if match_bindings_shadow_var(branch.bindings, variable):
		False
	else:
		constructor_match_body_consumes_var(branch.body, variable)


private pure func constructor_length_cases_consume_var(
	cases: List[CoreConstructorLengthMatchCase],
	variable: CoreVar,
) -> Bool:
	var found: Bool = False

	for match_case in cases:
		if constructor_length_branch_consumes_var(match_case.branch, variable):
			found = True
			break
		else:
			void

	found


private pure func constructor_length_geq_consumes_var(
	geq: Option[CoreConstructorLengthMatchGeq],
	variable: CoreVar,
) -> Bool:
	match geq:
		Some(found):
			constructor_length_branch_consumes_var(found.branch, variable)
		None:
			False


private pure func constructor_length_fallback_consumes_var(
	fallback: Option[CoreConstructorLengthMatchBranch],
	variable: CoreVar,
) -> Bool:
	match fallback:
		Some(branch):
			constructor_length_branch_consumes_var(branch, variable)
		None:
			False


private pure func constructor_length_match_consumes_var(
	match_expr: CoreConstructorLengthMatch,
	variable: CoreVar,
) -> Bool:
	(
		constructor_length_cases_consume_var(match_expr.cases, variable)
		or constructor_length_geq_consumes_var(match_expr.geq, variable)
		or constructor_length_fallback_consumes_var(match_expr.fallback, variable)
	)


private pure func select_arm_kind_consumes_var(kind: CoreSelectArmKind, variable: CoreVar) -> Bool:
	match kind:
		SelectRecvArm(recv):
			expr_consumes_var(recv.channel, variable)
		SelectSealedArm(channel):
			expr_consumes_var(channel, variable)
		SelectAfterArm(timeout):
			expr_consumes_var(timeout, variable)


private pure func select_arm_consumes_var(arm: CoreSelectArm, variable: CoreVar) -> Bool:
	if select_arm_kind_consumes_var(arm.kind, variable):
		True
	else:
		match arm.kind:
			SelectRecvArm(recv):
				if same_var_name(recv.binder, variable):
					False
				else:
					expr_consumes_var(arm.body, variable)
			SelectSealedArm(channel):
				expr_consumes_var(arm.body, variable)
			SelectAfterArm(timeout):
				expr_consumes_var(arm.body, variable)


private pure func select_arms_consume_var(arms: List[CoreSelectArm], variable: CoreVar) -> Bool:
	var found: Bool = False

	for arm in arms:
		if select_arm_consumes_var(arm, variable):
			found = True
			break
		else:
			void

	found


private pure func pre_closure_concurrent_bindings_consume_var(
	bindings: List[CorePreClosureConcurrentBinding],
	variable: CoreVar,
) -> Bool:
	var found: Bool = False

	for binding in bindings:
		if expr_consumes_var(binding.rhs, variable):
			found = True
			break
		else:
			void

	found


private pure func concurrent_bindings_consume_var(
	bindings: List[CoreConcurrentBinding],
	variable: CoreVar,
) -> Bool:
	var found: Bool = False

	for binding in bindings:
		if expr_consumes_var(binding.rhs, variable):
			found = True
			break
		else:
			void

	found


private pure func pre_closure_concurrent_bindings_shadow_var(
	bindings: List[CorePreClosureConcurrentBinding],
	variable: CoreVar,
) -> Bool:
	var found: Bool = False

	for binding in bindings:
		if same_var_name(binding.variable, variable):
			found = True
			break
		else:
			void

	found


private pure func concurrent_bindings_shadow_var(
	bindings: List[CoreConcurrentBinding],
	variable: CoreVar,
) -> Bool:
	var found: Bool = False

	for binding in bindings:
		if same_var_name(binding.variable, variable):
			found = True
			break
		else:
			void

	found


private pure func pre_closure_concurrent_consumes_var(
	bindings: List[CorePreClosureConcurrentBinding],
	body: CoreExpr,
	timeout: Option[CoreExpr],
	variable: CoreVar,
) -> Bool:
	if pre_closure_concurrent_bindings_consume_var(bindings, variable):
		True
	else if optional_expr_consumes_var(timeout, variable):
		True
	else if pre_closure_concurrent_bindings_shadow_var(bindings, variable):
		False
	else:
		expr_consumes_var(body, variable)


private pure func concurrent_consumes_var(
	bindings: List[CoreConcurrentBinding],
	body: CoreExpr,
	timeout: Option[CoreExpr],
	variable: CoreVar,
) -> Bool:
	if concurrent_bindings_consume_var(bindings, variable):
		True
	else if optional_expr_consumes_var(timeout, variable):
		True
	else if concurrent_bindings_shadow_var(bindings, variable):
		False
	else:
		expr_consumes_var(body, variable)


private pure func expr_consumes_var(expr: CoreExpr, variable: CoreVar) -> Bool:
	match expr:
		CallExpr(kind, callee, args, typ, loc):
			call_consumes_var(kind, args, variable) or exprs_consume_var(args, variable)
		DropExpr(drop_var, value_type, release_policy, body, typ, loc):
			if same_var_name(drop_var, variable):
				True
			else:
				expr_consumes_var(body, variable)
		DupExpr(dup_var, value_type, retain_policy, body, typ, loc):
			expr_consumes_var(body, variable)
		LetExpr(name, is_mutable, typ, rhs, body):
			if expr_consumes_var(rhs, variable):
				True
			else if same_var_name(name, variable):
				False
			else:
				expr_consumes_var(body, variable)
		BorrowLetExpr(name, typ, rhs, body):
			if expr_consumes_var(rhs, variable):
				True
			else if same_var_name(name, variable):
				False
			else:
				expr_consumes_var(body, variable)
		SeqExpr(first, second):
			expr_consumes_var(first, variable) or expr_consumes_var(second, variable)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			(
				expr_consumes_var(cond, variable)
				or expr_consumes_var(then_expr, variable)
				or expr_consumes_var(else_expr, variable)
			)
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			if contains_name(
				add_bound_params([], lambda_params),
				variable.name,
			):
				False
			else:
				expr_consumes_var(lambda_body, variable)
		ListHandoffExpr(handoff, typ, loc):
			if expr_consumes_var(handoff.source, variable):
				True
			else if expr_consumes_var(handoff.capacity, variable):
				True
			else if (
				same_var_name(handoff.source_var, variable)
				or same_var_name(handoff.result_var, variable)
				or same_var_name(handoff.len_var, variable)
				or same_var_name(handoff.out_var, variable)
			):
				False
			else:
				expr_consumes_var(handoff.body, variable)
		TensorRawViewLetExpr(binding, body, typ, loc):
			if expr_consumes_var(binding.source, variable):
				True
			else if same_var_name(binding.variable, variable):
				False
			else:
				expr_consumes_var(body, variable)
		WhileExpr(cond, body, typ, loc):
			expr_consumes_var(cond, variable) or expr_consumes_var(body, variable)
		ResourceScopeExpr(scope, typ, loc):
			if expr_consumes_var(scope.acquire, variable):
				True
			else if same_var_name(scope.variable, variable):
				False
			else:
				(
					expr_consumes_var(scope.body, variable)
					or expr_consumes_var(scope.cleanup, variable)
				)
		ResourceCleanupExitExpr(exit, typ, loc):
			exprs_consume_var(exit.cleanups, variable)
		TailrecLoopExpr(params, return_type, body, loc):
			if contains_name(
				add_bound_params([], params),
				variable.name,
			):
				False
			else:
				expr_consumes_var(body, variable)
		TailrecRecurExpr(args, typ, loc):
			exprs_consume_var(args, variable)
		TailrecListSpreadLoopExpr(loop, loc):
			if (
				same_var_name(loop.list_param.name, variable)
				or same_var_name(loop.cursor, variable)
			):
				False
			else:
				expr_consumes_var(loop.body, variable)
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			var found: Bool = False

			for rebind in rebinds:
				if expr_consumes_var(rebind.value, variable):
					found = True
					break
				else:
					void

			found
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			if expr_consumes_var(start, variable) or expr_consumes_var(end_value, variable):
				True
			else if same_var_name(binder.variable, variable):
				False
			else:
				expr_consumes_var(body, variable)
		ForChannelExpr(for_channel, typ, loc):
			if expr_consumes_var(for_channel.iterable, variable):
				True
			else if same_var_name(for_channel.binder.variable, variable):
				False
			else:
				expr_consumes_var(for_channel.body, variable)
		ForListExpr(for_list, typ, loc):
			if expr_consumes_var(for_list.iterable, variable):
				True
			else if same_var_name(for_list.binder.variable, variable):
				False
			else:
				expr_consumes_var(for_list.body, variable)
		ForStringExpr(for_string, typ, loc):
			if expr_consumes_var(for_string.iterable, variable):
				True
			else if same_var_name(for_string.binder.variable, variable):
				False
			else:
				expr_consumes_var(for_string.body, variable)
		ForDictExpr(for_dict, typ, loc):
			if expr_consumes_var(for_dict.iterable, variable):
				True
			else if same_var_name(for_dict.binder.variable, variable):
				False
			else:
				expr_consumes_var(for_dict.body, variable)
		ForSetExpr(for_set, typ, loc):
			if expr_consumes_var(for_set.iterable, variable):
				True
			else if same_var_name(for_set.binder.variable, variable):
				False
			else:
				expr_consumes_var(for_set.body, variable)
		ForResourceSourceExpr(for_resource_source, typ, loc):
			if expr_consumes_var(for_resource_source.iterable, variable):
				True
			else if same_var_name(for_resource_source.binder.variable, variable):
				False
			else:
				expr_consumes_var(for_resource_source.body, variable)
		ForStreamExpr(for_stream, typ, loc):
			if expr_consumes_var(for_stream.iterable, variable):
				True
			else if same_var_name(for_stream.binder.variable, variable):
				False
			else:
				expr_consumes_var(for_stream.body, variable)
		ForTensorExpr(for_tensor, typ, loc):
			if expr_consumes_var(for_tensor.iterable, variable):
				True
			else if same_var_name(for_tensor.binder.variable, variable):
				False
			else:
				expr_consumes_var(for_tensor.body, variable)
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			if expr_consumes_var(loop.iterable, variable):
				True
			else if same_var_name(loop.variable, variable):
				False
			else:
				(
					expr_consumes_var(loop.body, variable)
					or optional_expr_consumes_var(loop.timeout, variable)
					or expr_consumes_var(loop.limit, variable)
				)
		ConcurrentlyLoopExpr(loop, typ, loc):
			if expr_consumes_var(loop.iterable, variable):
				True
			else if same_var_name(loop.variable, variable):
				False
			else:
				(
					expr_consumes_var(loop.body, variable)
					or optional_expr_consumes_var(loop.timeout, variable)
					or expr_consumes_var(loop.limit, variable)
				)
		PreClosureConcurrentExpr(block, typ, loc):
			pre_closure_concurrent_consumes_var(block.bindings, block.body, block.timeout, variable)
		ConcurrentExpr(block, typ, loc):
			concurrent_consumes_var(block.bindings, block.body, block.timeout, variable)
		SelectExpr(select_expr, typ, loc):
			select_arms_consume_var(select_expr.arms, variable)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			(
				expr_consumes_var(scrutinee, variable)
				or literal_match_cases_consume_var(cases, variable)
				or literal_match_fallback_consumes_var(fallback, variable)
			)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			(
				expr_consumes_var(scrutinee, variable)
				or constructor_literal_match_consumes_var(match_expr, variable)
			)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			(
				expr_consumes_var(scrutinee, variable)
				or constructor_length_match_consumes_var(match_expr, variable)
			)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			(
				expr_consumes_var(scrutinee, variable)
				or constructor_match_cases_consume_var(cases, variable)
				or constructor_match_fallback_consumes_var(fallback, variable)
			)
		LiteralExpr(literal, typ, loc):
			False
		VarExpr(found, typ, loc):
			False
		VoidExpr(typ, loc):
			False
		CooperativeCheckpointExpr(typ, loc):
			False
		BinaryExpr(op, left, right, typ, loc):
			expr_consumes_var(left, variable) or expr_consumes_var(right, variable)
		UnaryExpr(op, expr_value, typ, loc):
			expr_consumes_var(expr_value, variable)
		LogicalExpr(op, left, right, typ, loc):
			expr_consumes_var(left, variable) or expr_consumes_var(right, variable)
		AssignExpr(assign_var, rhs, typ, loc):
			expr_consumes_var(rhs, variable)
		CastExpr(expr_value, typ, loc):
			expr_consumes_var(expr_value, variable)
		BoxExpr(box, typ, loc):
			expr_consumes_var(box.value, variable)
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			expr_consumes_var(expr_value, variable)
		FieldExpr(expr_value, field_name, typ, loc):
			expr_consumes_var(expr_value, variable)
		TupleFieldExpr(expr_value, field_index, typ, loc):
			expr_consumes_var(expr_value, variable)
		TupleExpr(items, typ, loc):
			exprs_consume_var(items, variable)
		TupleConstructExpr(tuple_construct, typ, loc):
			tuple_elements_consume_var(tuple_construct.elements, variable)
		VectorExpr(items, typ, loc):
			exprs_consume_var(items, variable)
		ClosureCreateExpr(closure, typ, loc):
			False
		ListConstructExpr(construct, typ, loc):
			boxed_storage_values_consume_var(construct.elements, variable)
		ListAllocExpr(alloc, typ, loc):
			expr_consumes_var(alloc.capacity, variable)
		ListGetExpr(get, typ, loc):
			expr_consumes_var(get.list, variable) or expr_consumes_var(get.index, variable)
		ListHandoffSetOwnedExpr(set, typ, loc):
			(
				expr_consumes_var(set.list, variable)
				or expr_consumes_var(set.index, variable)
				or boxed_storage_value_consumes_var(set.value, variable)
			)
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			(
				expr_consumes_var(slot.result, variable)
				or expr_consumes_var(slot.out_index, variable)
				or expr_consumes_var(slot.source, variable)
				or expr_consumes_var(slot.source_index, variable)
			)
		ListRetainExpr(retain, typ, loc):
			(
				expr_consumes_var(retain.list, variable)
				or boxed_storage_value_consumes_var(retain.value, variable)
			)
		ListSetExpr(set, typ, loc):
			(
				expr_consumes_var(set.list, variable)
				or expr_consumes_var(set.index, variable)
				or boxed_storage_value_consumes_var(set.value, variable)
			)
		ListSwapExpr(swap, typ, loc):
			(
				expr_consumes_var(swap.list, variable)
				or expr_consumes_var(swap.left_index, variable)
				or expr_consumes_var(swap.right_index, variable)
			)
		StringByteReadExpr(read, typ, loc):
			expr_consumes_var(read.source, variable) or expr_consumes_var(read.index, variable)
		StringByteWriteExpr(write, typ, loc):
			(
				expr_consumes_var(write.target, variable)
				or expr_consumes_var(write.index, variable)
				or expr_consumes_var(write.byte, variable)
			)
		StringByteCopyExpr(copy, typ, loc):
			(
				expr_consumes_var(copy.dst, variable)
				or expr_consumes_var(copy.dst_pos, variable)
				or expr_consumes_var(copy.src, variable)
				or expr_consumes_var(copy.src_pos, variable)
				or expr_consumes_var(copy.len, variable)
			)
		StringSetLenExpr(set_len, typ, loc):
			expr_consumes_var(set_len.target, variable) or expr_consumes_var(set_len.len, variable)
		TensorLiteralExpr(literal, typ, loc):
			tensor_payload_consumes_var(literal.payload, variable)
		TensorBoxedLiteralExpr(literal, typ, loc):
			boxed_storage_values_consume_var(literal.elements, variable)
		TensorPackedLiteralExpr(literal, typ, loc):
			False
		TensorRawFillExpr(fill, typ, loc):
			expr_consumes_var(fill.value, variable) or exprs_consume_var(fill.dims, variable)
		TensorRawReadExpr(read, typ, loc):
			expr_consumes_var(read.index, variable)
		TensorRawWriteExpr(write, typ, loc):
			expr_consumes_var(write.index, variable) or expr_consumes_var(write.value, variable)
		DictExpr(entries, typ, loc):
			dict_literal_entries_consume_var(entries, variable)
		DictConstructExpr(construct, typ, loc):
			dict_entries_consume_var(construct.entries, variable)
		SetAllocExpr(alloc, typ, loc):
			False
		RecordExpr(fields, typ, loc):
			record_fields_consume_var(fields, variable)
		RecordConstructExpr(type_name, fields, typ, loc):
			record_fields_consume_var(fields, variable)
		UnionConstructExpr(construct, typ, loc):
			boxed_storage_values_consume_var(construct.args, variable)
		UnionReuseConstructExpr(construct, typ, loc):
			(
				expr_consumes_var(construct.source, variable)
				or boxed_storage_values_consume_var(construct.args, variable)
			)
		PreClosureDetachExpr(detached, typ, loc):
			expr_consumes_var(detached.body, variable)
		DetachExpr(detached, typ, loc):
			False
		BreakExpr(typ, loc):
			False
		ContinueExpr(typ, loc):
			False
		RangeExpr(start, end_value, typ, loc):
			expr_consumes_var(start, variable) or expr_consumes_var(end_value, variable)


private pure func drop_after_body(
	variable: CoreVar,
	value_type: CoreType,
	body: CoreExpr,
	loc: CoreSourceLoc,
) -> CoreExpr:
	release_policy: CoreReleasePolicy = TypeLayout.cleanup_release_policy_for_type(value_type)

	if core_type_is_void(core_expr_type(body)):
		SeqExpr(
			body,
			DropExpr(
				variable,
				value_type,
				release_policy,
				VoidExpr(VoidType, loc),
				VoidType,
				loc,
			),
		)
	else:
		result_var: CoreVar = var_from_name("__cdrop_" + variable.name)
		result_type: CoreType = core_expr_type(body)
		LetExpr(
			result_var,
			False,
			result_type,
			body,
			DropExpr(
				variable,
				value_type,
				release_policy,
				VarExpr(result_var, result_type, loc),
				result_type,
				loc,
			),
		)


private pure func balance_task_copy_capture(
	body: CoreExpr,
	capture: CoreTaskCapture,
	loc: CoreSourceLoc,
) -> CoreExpr:
	match capture.kind:
		TaskCopyCapture:
			variable: CoreVar = var_from_name(capture.name)

			if expr_consumes_var(body, variable):
				body
			else:
				drop_after_body(variable, capture.typ, body, loc)
		TaskMoveResourceItem:
			body
		TaskStructuredTaskBorrow:
			body


private pure func balance_task_copy_captures(
	captures: List[CoreTaskCapture],
	body: CoreExpr,
	loc: CoreSourceLoc,
) -> CoreExpr:
	var balanced: CoreExpr = body
	var index: Int = captures.length() - 1

	while index >= 0:
		match captures.get(index):
			Some(capture):
				balanced = balance_task_copy_capture(balanced, capture, loc)
			None:
				void

		index -= 1

	balanced


private pure func add_hoisted_function(
	state: ClosureState,
	func_info: CoreFunction,
) -> ClosureState:
	{ state | hoisted = state.hoisted.append(FunctionDecl(func_info)) }


private pure func hoist_lambda(
	state: ClosureState,
	capturable: List[String],
	params: List[CoreParam],
	return_type: CoreType,
	body: CoreExpr,
	is_pure: Bool,
	loc: CoreSourceLoc,
) -> HoistedClosureCreate:
	free_vars: List[FreeVar] = captures_from_body(
		state,
		capturable,
		add_bound_params([], params),
		body,
	)
	captures: List[CoreClosureCapture] = closure_captures_from_free_vars(free_vars)
	fresh: FreshHoistedName = next_lambda_name(state)
	abi: CoreClosureAbi = {
		c_name = fresh.c_name,
		params = params,
		captures = captures,
		moved_captures = [],
		task_abi = False
	}
	func_info: CoreFunction = {
		name = fresh.name,
		source_module = fresh.state.current_module,
		type_params = [],
		params = [],
		return_type = return_type,
		body = Some(body),
		is_pure = is_pure,
		function_kind = ClosureBodyFunction(abi),
		def_id = fresh.def_id,
		loc = loc
	}
	final_state: ClosureState = add_hoisted_function(fresh.state, func_info)
	{
		state = final_state,
		create = {
			function_name = fresh.name,
			def_id = fresh.def_id,
			c_name = fresh.c_name,
			static_name = fresh.static_name,
			captures = captures
		}
	}


private pure func hoist_task(
	state: ClosureState,
	capturable: List[String],
	local_bound: List[String],
	body: CoreExpr,
	return_type: CoreType,
	captures: List[CoreTaskCapture],
	loc: CoreSourceLoc,
) -> HoistedTaskClosure:
	closure_captures: List[CoreClosureCapture] = closure_captures_from_task_captures(captures)
	balanced_body: CoreExpr = balance_task_copy_captures(captures, body, loc)
	fresh: FreshHoistedName = next_task_name(state)
	abi: CoreClosureAbi = {
		c_name = fresh.c_name,
		params = [],
		captures = closure_captures,
		moved_captures = task_moved_captures(captures),
		task_abi = True
	}
	func_info: CoreFunction = {
		name = fresh.name,
		source_module = fresh.state.current_module,
		type_params = [],
		params = [],
		return_type = return_type,
		body = Some(balanced_body),
		is_pure = False,
		function_kind = ClosureBodyFunction(abi),
		def_id = fresh.def_id,
		loc = loc
	}
	final_state: ClosureState = add_hoisted_function(fresh.state, func_info)
	{
		state = final_state,
		task = {
			function_name = fresh.name,
			def_id = fresh.def_id,
			c_name = fresh.c_name,
			static_name = fresh.static_name,
			captures = captures,
			return_type = return_type
		}
	}


private pure func hoist_copy_task(
	state: ClosureState,
	capturable: List[String],
	local_bound: List[String],
	body: CoreExpr,
	return_type: CoreType,
	loc: CoreSourceLoc,
) -> HoistedTaskClosure:
	free_vars: List[FreeVar] = captures_from_body(state, capturable, local_bound, body)
	captures: List[CoreTaskCapture] = task_captures_from_free_vars(free_vars, TaskCopyCapture)
	hoist_task(state, capturable, local_bound, body, return_type, captures, loc)


private pure func hoist_loop_task(
	state: ClosureState,
	capturable: List[String],
	local_bound: List[String],
	loop_variable: CoreVar,
	item_mode: CoreConcurrentlyLoopItemMode,
	body: CoreExpr,
	return_type: CoreType,
	loc: CoreSourceLoc,
) -> HoistedTaskClosure:
	free_vars: List[FreeVar] = captures_from_body(state, capturable, local_bound, body)
	captures: List[CoreTaskCapture] = task_captures_for_loop(free_vars, loop_variable, item_mode)
	hoist_task(state, capturable, local_bound, body, return_type, captures, loc)


private pure func convert_optional_expr(
	state: ClosureState,
	bound: List[String],
	expr: Option[CoreExpr],
) -> ConvertedOptionalExpr:
	match expr:
		Some(found):
			converted: ConvertedExpr = convert_expr(state, bound, found)
			{
				state = converted.state,
				expr = Some(converted.expr)
			}
		None:
			{
				state = state,
				expr = None
			}


private pure func convert_exprs(
	state: ClosureState,
	bound: List[String],
	exprs: List[CoreExpr],
) -> ConvertedExprs:
	var current: ClosureState = state
	var result: List[CoreExpr] = []

	for expr in exprs:
		converted: ConvertedExpr = convert_expr(current, bound, expr)
		current = converted.state
		result = result.append(converted.expr)

	{
		state = current,
		exprs = result
	}


private pure func convert_boxed_storage_value(
	state: ClosureState,
	bound: List[String],
	value: CoreBoxedStorageValue,
) -> ConvertedBoxedStorageValue:
	converted: ConvertedExpr = convert_expr(state, bound, value.value)
	{
		state = converted.state,
		value = { value | value = converted.expr }
	}


private pure func convert_boxed_storage_values(
	state: ClosureState,
	bound: List[String],
	values: List[CoreBoxedStorageValue],
) -> ConvertedBoxedStorageValues:
	var current: ClosureState = state
	var result: List[CoreBoxedStorageValue] = []

	for value in values:
		converted: ConvertedBoxedStorageValue = convert_boxed_storage_value(current, bound, value)
		current = converted.state
		result = result.append(converted.value)

	{
		state = current,
		values = result
	}


private pure func convert_tuple_element(
	state: ClosureState,
	bound: List[String],
	element: CoreTupleElement,
) -> ConvertedTupleElement:
	match element:
		TuplePrimElement(expr):
			converted: ConvertedExpr = convert_expr(state, bound, expr)
			{
				state = converted.state,
				element = TuplePrimElement(converted.expr)
			}
		TuplePointerElement(expr):
			converted: ConvertedExpr = convert_expr(state, bound, expr)
			{
				state = converted.state,
				element = TuplePointerElement(converted.expr)
			}
		TupleStructElement(expr, c_type):
			converted: ConvertedExpr = convert_expr(state, bound, expr)
			{
				state = converted.state,
				element = TupleStructElement(converted.expr, c_type)
			}
		TupleVoidElement:
			{
				state = state,
				element = TupleVoidElement
			}
		TupleFloatElement(expr):
			converted: ConvertedExpr = convert_expr(state, bound, expr)
			{
				state = converted.state,
				element = TupleFloatElement(converted.expr)
			}
		TupleFloat32Element(expr):
			converted: ConvertedExpr = convert_expr(state, bound, expr)
			{
				state = converted.state,
				element = TupleFloat32Element(converted.expr)
			}
		TupleFloat16Element(expr):
			converted: ConvertedExpr = convert_expr(state, bound, expr)
			{
				state = converted.state,
				element = TupleFloat16Element(converted.expr)
			}


private pure func convert_tuple_elements(
	state: ClosureState,
	bound: List[String],
	elements: List[CoreTupleElement],
) -> ConvertedTupleElements:
	var current: ClosureState = state
	var result: List[CoreTupleElement] = []

	for element in elements:
		converted: ConvertedTupleElement = convert_tuple_element(current, bound, element)
		current = converted.state
		result = result.append(converted.element)

	{
		state = current,
		elements = result
	}


private pure func convert_record_fields(
	state: ClosureState,
	bound: List[String],
	fields: List[CoreRecordFieldValue],
) -> ConvertedRecordFields:
	var current: ClosureState = state
	var result: List[CoreRecordFieldValue] = []

	for field in fields:
		converted: ConvertedExpr = convert_expr(current, bound, field.value)
		current = converted.state
		result = result.append({ field | value = converted.expr })

	{
		state = current,
		fields = result
	}


private pure func convert_dict_entries(
	state: ClosureState,
	bound: List[String],
	entries: List[CoreDictEntry],
) -> ConvertedDictEntries:
	var current: ClosureState = state
	var result: List[CoreDictEntry] = []

	for entry in entries:
		key: ConvertedBoxedStorageValue = convert_boxed_storage_value(current, bound, entry.key)
		value: ConvertedBoxedStorageValue = convert_boxed_storage_value(
			key.state,
			bound,
			entry.value,
		)
		current = value.state
		result = result.append({
			key = key.value,
			value = value.value,
		})

	{
		state = current,
		entries = result
	}


private pure func convert_dict_literal_entries(
	state: ClosureState,
	bound: List[String],
	entries: List[CoreDictLiteralEntry],
) -> ConvertedDictLiteralEntries:
	var current: ClosureState = state
	var result: List[CoreDictLiteralEntry] = []

	for entry in entries:
		key: ConvertedExpr = convert_expr(current, bound, entry.key)
		value: ConvertedExpr = convert_expr(key.state, bound, entry.value)
		current = value.state
		result = result.append({
			key = key.expr,
			value = value.expr,
		})

	{
		state = current,
		entries = result
	}


private pure func convert_literal_match_cases(
	state: ClosureState,
	bound: List[String],
	cases: List[CoreLiteralMatchCase],
) -> ConvertedLiteralMatchCases:
	var current: ClosureState = state
	var result: List[CoreLiteralMatchCase] = []

	for match_case in cases:
		case_bound: List[String] = add_bound_match_bindings(bound, match_case.bindings)
		converted: ConvertedExpr = convert_expr(current, case_bound, match_case.body)
		current = converted.state
		result = result.append({ match_case | body = converted.expr })

	{
		state = current,
		cases = result
	}


private pure func convert_literal_match_fallback(
	state: ClosureState,
	bound: List[String],
	fallback: CoreLiteralMatchFallback,
) -> ConvertedLiteralMatchFallback:
	match fallback:
		LiteralMatchFallbackBody(body):
			converted: ConvertedExpr = convert_expr(state, bound, body)
			{
				state = converted.state,
				fallback = LiteralMatchFallbackBody(converted.expr)
			}
		LiteralMatchFallbackBindings(bindings, body):
			converted: ConvertedExpr = convert_expr(
				state,
				add_bound_match_bindings(bound, bindings),
				body,
			)
			{
				state = converted.state,
				fallback = LiteralMatchFallbackBindings(bindings, converted.expr)
			}
		LiteralMatchFallbackFail:
			{
				state = state,
				fallback = LiteralMatchFallbackFail
			}


private pure func convert_constructor_match_body(
	state: ClosureState,
	bound: List[String],
	body: CoreConstructorMatchBody,
) -> ConvertedConstructorMatchBody:
	match body:
		ConstructorMatchBodyExpr(expr):
			converted: ConvertedExpr = convert_expr(state, bound, expr)
			{
				state = converted.state,
				body = ConstructorMatchBodyExpr(converted.expr)
			}
		ConstructorMatchBodyLiteral(match_expr):
			converted: ConvertedConstructorLiteralMatch = convert_constructor_literal_match(
				state,
				bound,
				match_expr,
			)
			{
				state = converted.state,
				body = ConstructorMatchBodyLiteral(converted.match_expr)
			}
		ConstructorMatchBodyLength(match_expr):
			converted: ConvertedConstructorLengthMatch = convert_constructor_length_match(
				state,
				bound,
				match_expr,
			)
			{
				state = converted.state,
				body = ConstructorMatchBodyLength(converted.match_expr)
			}


record ConvertedConstructorLiteralMatch {
	state: ClosureState,
	match_expr: CoreConstructorLiteralMatch
}


record ConvertedConstructorLengthMatch {
	state: ClosureState,
	match_expr: CoreConstructorLengthMatch
}


private pure func convert_constructor_match_cases(
	state: ClosureState,
	bound: List[String],
	cases: List[CoreConstructorMatchCase],
) -> ConvertedConstructorMatchCases:
	var current: ClosureState = state
	var result: List[CoreConstructorMatchCase] = []

	for match_case in cases:
		case_bound: List[String] = add_bound_match_bindings(bound, match_case.bindings)
		converted: ConvertedConstructorMatchBody = convert_constructor_match_body(
			current,
			case_bound,
			match_case.body,
		)
		current = converted.state
		result = result.append({ match_case | body = converted.body })

	{
		state = current,
		cases = result
	}


private pure func convert_constructor_match_fallback(
	state: ClosureState,
	bound: List[String],
	fallback: CoreConstructorMatchFallback,
) -> ConvertedConstructorMatchFallback:
	match fallback:
		ConstructorMatchFallbackBody(body):
			converted: ConvertedExpr = convert_expr(state, bound, body)
			{
				state = converted.state,
				fallback = ConstructorMatchFallbackBody(converted.expr)
			}
		ConstructorMatchFallbackBindings(bindings, body):
			converted: ConvertedExpr = convert_expr(
				state,
				add_bound_match_bindings(bound, bindings),
				body,
			)
			{
				state = converted.state,
				fallback = ConstructorMatchFallbackBindings(bindings, converted.expr)
			}
		ConstructorMatchFallbackFail:
			{
				state = state,
				fallback = ConstructorMatchFallbackFail
			}


private pure func convert_constructor_literal_match(
	state: ClosureState,
	bound: List[String],
	match_expr: CoreConstructorLiteralMatch,
) -> ConvertedConstructorLiteralMatch:
	cases: ConvertedLiteralMatchCases = convert_literal_match_cases(state, bound, match_expr.cases)
	fallback: ConvertedLiteralMatchFallback = convert_literal_match_fallback(
		cases.state,
		bound,
		match_expr.fallback,
	)
	{
		state = fallback.state,
		match_expr = { match_expr |
			cases = cases.cases,
			fallback = fallback.fallback
		}
	}


private pure func convert_constructor_length_branch(
	state: ClosureState,
	bound: List[String],
	branch: CoreConstructorLengthMatchBranch,
) -> ConvertedConstructorLengthBranch:
	branch_bound: List[String] = add_bound_match_bindings(bound, branch.bindings)
	converted: ConvertedConstructorMatchBody = convert_constructor_match_body(
		state,
		branch_bound,
		branch.body,
	)
	{
		state = converted.state,
		branch = { branch | body = converted.body }
	}


private pure func convert_constructor_length_cases(
	state: ClosureState,
	bound: List[String],
	cases: List[CoreConstructorLengthMatchCase],
) -> ConvertedConstructorLengthCases:
	var current: ClosureState = state
	var result: List[CoreConstructorLengthMatchCase] = []

	for match_case in cases:
		converted: ConvertedConstructorLengthBranch = convert_constructor_length_branch(
			current,
			bound,
			match_case.branch,
		)
		current = converted.state
		result = result.append({ match_case | branch = converted.branch })

	{
		state = current,
		cases = result
	}


private pure func convert_constructor_length_geq(
	state: ClosureState,
	bound: List[String],
	geq: Option[CoreConstructorLengthMatchGeq],
) -> ConvertedConstructorLengthGeq:
	match geq:
		Some(found):
			converted: ConvertedConstructorLengthBranch = convert_constructor_length_branch(
				state,
				bound,
				found.branch,
			)
			{
				state = converted.state,
				geq = Some({ found | branch = converted.branch })
			}
		None:
			{
				state = state,
				geq = None
			}


private pure func convert_constructor_length_fallback(
	state: ClosureState,
	bound: List[String],
	fallback: Option[CoreConstructorLengthMatchBranch],
) -> ConvertedConstructorLengthFallback:
	match fallback:
		Some(branch):
			converted: ConvertedConstructorLengthBranch = convert_constructor_length_branch(
				state,
				bound,
				branch,
			)
			{
				state = converted.state,
				fallback = Some(converted.branch)
			}
		None:
			{
				state = state,
				fallback = None
			}


private pure func convert_constructor_length_match(
	state: ClosureState,
	bound: List[String],
	match_expr: CoreConstructorLengthMatch,
) -> ConvertedConstructorLengthMatch:
	cases: ConvertedConstructorLengthCases = convert_constructor_length_cases(
		state,
		bound,
		match_expr.cases,
	)
	geq: ConvertedConstructorLengthGeq = convert_constructor_length_geq(
		cases.state,
		bound,
		match_expr.geq,
	)
	fallback: ConvertedConstructorLengthFallback = convert_constructor_length_fallback(
		geq.state,
		bound,
		match_expr.fallback,
	)
	{
		state = fallback.state,
		match_expr = { match_expr |
			cases = cases.cases,
			geq = geq.geq,
			fallback = fallback.fallback
		}
	}


private pure func convert_select_arm_kind(
	state: ClosureState,
	bound: List[String],
	kind: CoreSelectArmKind,
) -> ConvertedSelectArmKind:
	match kind:
		SelectRecvArm(recv):
			converted: ConvertedExpr = convert_expr(state, bound, recv.channel)
			{
				state = converted.state,
				kind = SelectRecvArm({ recv | channel = converted.expr })
			}
		SelectSealedArm(channel):
			converted: ConvertedExpr = convert_expr(state, bound, channel)
			{
				state = converted.state,
				kind = SelectSealedArm(converted.expr)
			}
		SelectAfterArm(timeout):
			converted: ConvertedExpr = convert_expr(state, bound, timeout)
			{
				state = converted.state,
				kind = SelectAfterArm(converted.expr)
			}


private pure func convert_select_arms(
	state: ClosureState,
	bound: List[String],
	arms: List[CoreSelectArm],
) -> ConvertedSelectArms:
	var current: ClosureState = state
	var result: List[CoreSelectArm] = []

	for arm in arms:
		kind: ConvertedSelectArmKind = convert_select_arm_kind(current, bound, arm.kind)
		body: ConvertedExpr = convert_expr(kind.state, bound, arm.body)
		current = body.state
		result = result.append({
			kind = kind.kind,
			body = body.expr,
			loc = arm.loc,
		})

	{
		state = current,
		arms = result
	}


private pure func convert_expr(
	state: ClosureState,
	bound: List[String],
	expr: CoreExpr,
) -> ConvertedExpr:
	match expr:
		LiteralExpr(literal, typ, loc):
			{
				state = state,
				expr = expr
			}
		VarExpr(variable, typ, loc):
			{
				state = state,
				expr = expr
			}
		VoidExpr(typ, loc):
			{
				state = state,
				expr = expr
			}
		CooperativeCheckpointExpr(typ, loc):
			{
				state = state,
				expr = expr
			}
		CallExpr(kind, callee, args, typ, loc):
			callee_converted: ConvertedExpr = convert_expr(state, bound, callee)
			args_converted: ConvertedExprs = convert_exprs(callee_converted.state, bound, args)
			{
				state = args_converted.state,
				expr = CallExpr(kind, callee_converted.expr, args_converted.exprs, typ, loc)
			}
		BinaryExpr(op, left, right, typ, loc):
			left_converted: ConvertedExpr = convert_expr(state, bound, left)
			right_converted: ConvertedExpr = convert_expr(left_converted.state, bound, right)
			{
				state = right_converted.state,
				expr = BinaryExpr(op, left_converted.expr, right_converted.expr, typ, loc)
			}
		UnaryExpr(op, expr_value, typ, loc):
			converted: ConvertedExpr = convert_expr(state, bound, expr_value)
			{
				state = converted.state,
				expr = UnaryExpr(op, converted.expr, typ, loc)
			}
		LogicalExpr(op, left, right, typ, loc):
			left_converted: ConvertedExpr = convert_expr(state, bound, left)
			right_converted: ConvertedExpr = convert_expr(left_converted.state, bound, right)
			{
				state = right_converted.state,
				expr = LogicalExpr(op, left_converted.expr, right_converted.expr, typ, loc)
			}
		AssignExpr(variable, rhs, typ, loc):
			converted: ConvertedExpr = convert_expr(state, bound, rhs)
			{
				state = converted.state,
				expr = AssignExpr(variable, converted.expr, typ, loc)
			}
		CastExpr(expr_value, typ, loc):
			converted: ConvertedExpr = convert_expr(state, bound, expr_value)
			{
				state = converted.state,
				expr = CastExpr(converted.expr, typ, loc)
			}
		BoxExpr(box, typ, loc):
			converted: ConvertedExpr = convert_expr(state, bound, box.value)
			{
				state = converted.state,
				expr = BoxExpr({ box | value = converted.expr }, typ, loc)
			}
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			converted: ConvertedExpr = convert_expr(state, bound, expr_value)
			{
				state = converted.state,
				expr = UnboxExpr(unbox_kind, converted.expr, typ, loc)
			}
		FieldExpr(expr_value, field_name, typ, loc):
			converted: ConvertedExpr = convert_expr(state, bound, expr_value)
			{
				state = converted.state,
				expr = FieldExpr(converted.expr, field_name, typ, loc)
			}
		TupleFieldExpr(expr_value, field_index, typ, loc):
			converted: ConvertedExpr = convert_expr(state, bound, expr_value)
			{
				state = converted.state,
				expr = TupleFieldExpr(converted.expr, field_index, typ, loc)
			}
		TupleExpr(items, typ, loc):
			converted: ConvertedExprs = convert_exprs(state, bound, items)
			{
				state = converted.state,
				expr = TupleExpr(converted.exprs, typ, loc)
			}
		TupleConstructExpr(tuple_construct, typ, loc):
			converted: ConvertedTupleElements = convert_tuple_elements(
				state,
				bound,
				tuple_construct.elements,
			)
			{
				state = converted.state,
				expr = TupleConstructExpr(
					{ tuple_construct | elements = converted.elements },
					typ,
					loc,
				)
			}
		VectorExpr(items, typ, loc):
			converted: ConvertedExprs = convert_exprs(state, bound, items)
			{
				state = converted.state,
				expr = VectorExpr(converted.exprs, typ, loc)
			}
		LambdaExpr(params, return_type, body, is_pure, typ, loc):
			body_bound: List[String] = add_bound_params(bound, params)
			body_converted: ConvertedExpr = convert_expr(state, body_bound, body)
			hoisted: HoistedClosureCreate = hoist_lambda(
				body_converted.state,
				bound,
				params,
				return_type,
				body_converted.expr,
				is_pure,
				loc,
			)
			{
				state = hoisted.state,
				expr = ClosureCreateExpr(hoisted.create, typ, loc)
			}
		ClosureCreateExpr(closure, typ, loc):
			{
				state = state,
				expr = expr
			}
		ListConstructExpr(construct, typ, loc):
			converted: ConvertedBoxedStorageValues = convert_boxed_storage_values(
				state,
				bound,
				construct.elements,
			)
			{
				state = converted.state,
				expr = ListConstructExpr({ construct | elements = converted.values }, typ, loc)
			}
		ListAllocExpr(alloc, typ, loc):
			converted: ConvertedExpr = convert_expr(state, bound, alloc.capacity)
			{
				state = converted.state,
				expr = ListAllocExpr({ alloc | capacity = converted.expr }, typ, loc)
			}
		ListGetExpr(get, typ, loc):
			list_converted: ConvertedExpr = convert_expr(state, copy_names(bound), get.list)
			index_converted: ConvertedExpr = convert_expr(
				list_converted.state,
				copy_names(bound),
				get.index,
			)
			{
				state = index_converted.state,
				expr = ListGetExpr(
					{ get |
						list = list_converted.expr,
						index = index_converted.expr
					},
					typ,
					loc,
				)
			}
		ListHandoffExpr(handoff, typ, loc):
			source: ConvertedExpr = convert_expr(state, copy_names(bound), handoff.source)
			capacity: ConvertedExpr = convert_expr(
				source.state,
				copy_names(bound),
				handoff.capacity,
			)
			body_bound: List[String] = copy_names(bound)
				.add_bound_var(handoff.source_var)
				.add_bound_var(handoff.result_var)
				.add_bound_var(handoff.len_var)
				.add_bound_var(handoff.out_var)
			body: ConvertedExpr = convert_expr(capacity.state, body_bound, handoff.body)
			{
				state = body.state,
				expr = ListHandoffExpr(
					{ handoff |
						source = source.expr,
						capacity = capacity.expr,
						body = body.expr
					},
					typ,
					loc,
				)
			}
		ListHandoffSetOwnedExpr(set, typ, loc):
			list: ConvertedExpr = convert_expr(state, bound, set.list)
			index: ConvertedExpr = convert_expr(list.state, bound, set.index)
			value: ConvertedBoxedStorageValue = convert_boxed_storage_value(
				index.state,
				bound,
				set.value,
			)
			{
				state = value.state,
				expr = ListHandoffSetOwnedExpr(
					{ set |
						list = list.expr,
						index = index.expr,
						value = value.value
					},
					typ,
					loc,
				)
			}
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			result: ConvertedExpr = convert_expr(state, bound, slot.result)
			out_index: ConvertedExpr = convert_expr(result.state, bound, slot.out_index)
			source: ConvertedExpr = convert_expr(out_index.state, bound, slot.source)
			source_index: ConvertedExpr = convert_expr(source.state, bound, slot.source_index)
			{
				state = source_index.state,
				expr = ListHandoffSetSourceSlotExpr(
					{ slot |
						result = result.expr,
						out_index = out_index.expr,
						source = source.expr,
						source_index = source_index.expr
					},
					typ,
					loc,
				)
			}
		StringByteReadExpr(read, typ, loc):
			source: ConvertedExpr = convert_expr(state, bound, read.source)
			index: ConvertedExpr = convert_expr(source.state, bound, read.index)
			{
				state = index.state,
				expr = StringByteReadExpr(
					{ read |
						source = source.expr,
						index = index.expr
					},
					typ,
					loc,
				)
			}
		StringByteWriteExpr(write, typ, loc):
			target: ConvertedExpr = convert_expr(state, bound, write.target)
			index: ConvertedExpr = convert_expr(target.state, bound, write.index)
			byte: ConvertedExpr = convert_expr(index.state, bound, write.byte)
			{
				state = byte.state,
				expr = StringByteWriteExpr(
					{ write |
						target = target.expr,
						index = index.expr,
						byte = byte.expr
					},
					typ,
					loc,
				)
			}
		StringByteCopyExpr(copy, typ, loc):
			dst: ConvertedExpr = convert_expr(state, bound, copy.dst)
			dst_pos: ConvertedExpr = convert_expr(dst.state, bound, copy.dst_pos)
			src: ConvertedExpr = convert_expr(dst_pos.state, bound, copy.src)
			src_pos: ConvertedExpr = convert_expr(src.state, bound, copy.src_pos)
			len: ConvertedExpr = convert_expr(src_pos.state, bound, copy.len)
			{
				state = len.state,
				expr = StringByteCopyExpr(
					{ copy |
						dst = dst.expr,
						dst_pos = dst_pos.expr,
						src = src.expr,
						src_pos = src_pos.expr,
						len = len.expr
					},
					typ,
					loc,
				)
			}
		StringSetLenExpr(set_len, typ, loc):
			target: ConvertedExpr = convert_expr(state, bound, set_len.target)
			len: ConvertedExpr = convert_expr(target.state, bound, set_len.len)
			{
				state = len.state,
				expr = StringSetLenExpr(
					{ set_len |
						target = target.expr,
						len = len.expr
					},
					typ,
					loc,
				)
			}
		TensorLiteralExpr(literal, typ, loc):
			match literal.payload:
				TensorRawLiteralPayload(raw):
					converted: ConvertedExprs = convert_exprs(state, bound, raw.elements)
					{
						state = converted.state,
						expr = TensorLiteralExpr(
							{ literal |
								payload = TensorRawLiteralPayload(
									{ raw | elements = converted.exprs },
								)
							},
							typ,
							loc,
						)
					}
				TensorInlineStructLiteralPayload(inline_struct):
					converted: ConvertedExprs = convert_exprs(state, bound, inline_struct.elements)
					{
						state = converted.state,
						expr = TensorLiteralExpr(
							{ literal |
								payload = TensorInlineStructLiteralPayload(
									{ inline_struct | elements = converted.exprs },
								)
							},
							typ,
							loc,
						)
					}
		TensorBoxedLiteralExpr(literal, typ, loc):
			converted: ConvertedBoxedStorageValues = convert_boxed_storage_values(
				state,
				bound,
				literal.elements,
			)
			{
				state = converted.state,
				expr = TensorBoxedLiteralExpr({ literal | elements = converted.values }, typ, loc)
			}
		TensorPackedLiteralExpr(literal, typ, loc):
			converted: ConvertedExprs = convert_exprs(state, bound, literal.elements)
			{
				state = converted.state,
				expr = TensorPackedLiteralExpr({ literal | elements = converted.exprs }, typ, loc)
			}
		TensorRawFillExpr(fill, typ, loc):
			value: ConvertedExpr = convert_expr(state, bound, fill.value)
			dims: ConvertedExprs = convert_exprs(value.state, bound, fill.dims)
			{
				state = dims.state,
				expr = TensorRawFillExpr(
					{ fill |
						value = value.expr,
						dims = dims.exprs
					},
					typ,
					loc,
				)
			}
		TensorRawReadExpr(read, typ, loc):
			index: ConvertedExpr = convert_expr(state, bound, read.index)
			{
				state = index.state,
				expr = TensorRawReadExpr({ read | index = index.expr }, typ, loc)
			}
		TensorRawWriteExpr(write, typ, loc):
			index: ConvertedExpr = convert_expr(state, copy_names(bound), write.index)
			value: ConvertedExpr = convert_expr(index.state, copy_names(bound), write.value)
			{
				state = value.state,
				expr = TensorRawWriteExpr(
					{ write |
						index = index.expr,
						value = value.expr
					},
					typ,
					loc,
				)
			}
		TensorRawViewLetExpr(binding, body, typ, loc):
			source: ConvertedExpr = convert_expr(state, copy_names(bound), binding.source)
			body_bound: List[String] = add_bound_var(copy_names(bound), binding.variable)
			body_converted: ConvertedExpr = convert_expr(source.state, body_bound, body)
			{
				state = body_converted.state,
				expr = TensorRawViewLetExpr(
					{ binding | source = source.expr },
					body_converted.expr,
					typ,
					loc,
				)
			}
		DictConstructExpr(construct, typ, loc):
			converted: ConvertedDictEntries = convert_dict_entries(state, bound, construct.entries)
			{
				state = converted.state,
				expr = DictConstructExpr({ construct | entries = converted.entries }, typ, loc)
			}
		DictExpr(entries, typ, loc):
			converted: ConvertedDictLiteralEntries = convert_dict_literal_entries(
				state,
				bound,
				entries,
			)
			{
				state = converted.state,
				expr = DictExpr(converted.entries, typ, loc)
			}
		SetAllocExpr(alloc, typ, loc):
			{
				state = state,
				expr = expr
			}
		ListRetainExpr(retain, typ, loc):
			list: ConvertedExpr = convert_expr(state, bound, retain.list)
			value: ConvertedBoxedStorageValue = convert_boxed_storage_value(
				list.state,
				bound,
				retain.value,
			)
			{
				state = value.state,
				expr = ListRetainExpr(
					{ retain |
						list = list.expr,
						value = value.value
					},
					typ,
					loc,
				)
			}
		ListSetExpr(set, typ, loc):
			list: ConvertedExpr = convert_expr(state, bound, set.list)
			index: ConvertedExpr = convert_expr(list.state, bound, set.index)
			value: ConvertedBoxedStorageValue = convert_boxed_storage_value(
				index.state,
				bound,
				set.value,
			)
			{
				state = value.state,
				expr = ListSetExpr(
					{ set |
						list = list.expr,
						index = index.expr,
						value = value.value
					},
					typ,
					loc,
				)
			}
		ListSwapExpr(swap, typ, loc):
			list: ConvertedExpr = convert_expr(state, bound, swap.list)
			left_index: ConvertedExpr = convert_expr(list.state, bound, swap.left_index)
			right_index: ConvertedExpr = convert_expr(left_index.state, bound, swap.right_index)
			{
				state = right_index.state,
				expr = ListSwapExpr(
					{ swap |
						list = list.expr,
						left_index = left_index.expr,
						right_index = right_index.expr
					},
					typ,
					loc,
				)
			}
		RecordExpr(fields, typ, loc):
			converted: ConvertedRecordFields = convert_record_fields(state, bound, fields)
			{
				state = converted.state,
				expr = RecordExpr(converted.fields, typ, loc)
			}
		RecordConstructExpr(type_name, fields, typ, loc):
			converted: ConvertedRecordFields = convert_record_fields(state, bound, fields)
			{
				state = converted.state,
				expr = RecordConstructExpr(type_name, converted.fields, typ, loc)
			}
		UnionConstructExpr(construct, typ, loc):
			converted: ConvertedBoxedStorageValues = convert_boxed_storage_values(
				state,
				bound,
				construct.args,
			)
			{
				state = converted.state,
				expr = UnionConstructExpr({ construct | args = converted.values }, typ, loc)
			}
		UnionReuseConstructExpr(construct, typ, loc):
			source: ConvertedExpr = convert_expr(state, bound, construct.source)
			args: ConvertedBoxedStorageValues = convert_boxed_storage_values(
				source.state,
				bound,
				construct.args,
			)
			{
				state = args.state,
				expr = UnionReuseConstructExpr(
					{ construct |
						source = source.expr,
						args = args.values
					},
					typ,
					loc,
				)
			}
		PreClosureDetachExpr(detached, typ, loc):
			body: ConvertedExpr = convert_expr(state, bound, detached.body)
			task: HoistedTaskClosure = hoist_copy_task(
				body.state,
				bound,
				[],
				body.expr,
				void_type(),
				loc,
			)
			{
				state = task.state,
				expr = DetachExpr({task = task.task}, typ, loc)
			}
		DetachExpr(detached, typ, loc):
			{
				state = state,
				expr = expr
			}
		DupExpr(variable, var_type, retain_policy, body, typ, loc):
			body_converted: ConvertedExpr = convert_expr(state, bound, body)
			{
				state = body_converted.state,
				expr = DupExpr(variable, var_type, retain_policy, body_converted.expr, typ, loc)
			}
		DropExpr(variable, var_type, release_policy, body, typ, loc):
			body_converted: ConvertedExpr = convert_expr(state, bound, body)
			{
				state = body_converted.state,
				expr = DropExpr(variable, var_type, release_policy, body_converted.expr, typ, loc)
			}
		LetExpr(variable, is_mutable, var_type, rhs, body):
			rhs_converted: ConvertedExpr = convert_expr(state, copy_names(bound), rhs)
			body_bound: List[String] = add_bound_var(copy_names(bound), variable)
			body_converted: ConvertedExpr = convert_expr(rhs_converted.state, body_bound, body)
			{
				state = body_converted.state,
				expr = LetExpr(
					variable,
					is_mutable,
					var_type,
					rhs_converted.expr,
					body_converted.expr,
				)
			}
		BorrowLetExpr(variable, var_type, rhs, body):
			rhs_converted: ConvertedExpr = convert_expr(state, copy_names(bound), rhs)
			body_bound: List[String] = add_bound_var(copy_names(bound), variable)
			body_converted: ConvertedExpr = convert_expr(rhs_converted.state, body_bound, body)
			{
				state = body_converted.state,
				expr = BorrowLetExpr(variable, var_type, rhs_converted.expr, body_converted.expr)
			}
		SeqExpr(first, second):
			first_converted: ConvertedExpr = convert_expr(state, bound, first)
			second_converted: ConvertedExpr = convert_expr(first_converted.state, bound, second)
			{
				state = second_converted.state,
				expr = SeqExpr(first_converted.expr, second_converted.expr)
			}
		WhileExpr(cond, body, typ, loc):
			cond_converted: ConvertedExpr = convert_expr(state, bound, cond)
			body_converted: ConvertedExpr = convert_expr(cond_converted.state, bound, body)
			{
				state = body_converted.state,
				expr = WhileExpr(cond_converted.expr, body_converted.expr, typ, loc)
			}
		BreakExpr(typ, loc):
			{
				state = state,
				expr = expr
			}
		ContinueExpr(typ, loc):
			{
				state = state,
				expr = expr
			}
		ResourceScopeExpr(scope, typ, loc):
			acquire: ConvertedExpr = convert_expr(state, bound, scope.acquire)
			scope_bound: List[String] = add_bound_var(bound, scope.variable)
			body: ConvertedExpr = convert_expr(acquire.state, scope_bound, scope.body)
			cleanup: ConvertedExpr = convert_expr(body.state, scope_bound, scope.cleanup)
			{
				state = cleanup.state,
				expr = ResourceScopeExpr(
					{ scope |
						acquire = acquire.expr,
						body = body.expr,
						cleanup = cleanup.expr
					},
					typ,
					loc,
				)
			}
		ResourceCleanupExitExpr(exit, typ, loc):
			cleanups: ConvertedExprs = convert_exprs(state, bound, exit.cleanups)
			{
				state = cleanups.state,
				expr = ResourceCleanupExitExpr({ exit | cleanups = cleanups.exprs }, typ, loc)
			}
		TailrecLoopExpr(params, return_type, body, loc):
			body_converted: ConvertedExpr = convert_expr(
				state,
				add_bound_params(bound, params),
				body,
			)
			{
				state = body_converted.state,
				expr = TailrecLoopExpr(params, return_type, body_converted.expr, loc)
			}
		TailrecRecurExpr(args, typ, loc):
			converted: ConvertedExprs = convert_exprs(state, bound, args)
			{
				state = converted.state,
				expr = TailrecRecurExpr(converted.exprs, typ, loc)
			}
		TailrecListSpreadLoopExpr(loop, loc):
			body_bound: List[String] = add_bound_params(
				add_bound_var(bound, loop.cursor),
				loop.params,
			)
			body_converted: ConvertedExpr = convert_expr(state, body_bound, loop.body)
			{
				state = body_converted.state,
				expr = TailrecListSpreadLoopExpr({ loop | body = body_converted.expr }, loc)
			}
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			var current: ClosureState = state
			var converted_rebinds: List[CoreTailrecListSpreadRebind] = []

			for rebind in rebinds:
				value: ConvertedExpr = convert_expr(current, bound, rebind.value)
				current = value.state
				converted_rebinds = converted_rebinds.append({ rebind | value = value.expr })

			{
				state = current,
				expr = TailrecListSpreadRecurExpr(converted_rebinds, cursor_advance, typ, loc)
			}
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			start_converted: ConvertedExpr = convert_expr(state, bound, start)
			end_converted: ConvertedExpr = convert_expr(start_converted.state, bound, end_value)
			body_converted: ConvertedExpr = convert_expr(
				end_converted.state,
				add_bound_var(bound, binder.variable),
				body,
			)
			{
				state = body_converted.state,
				expr = ForRangeExpr(
					binder,
					start_converted.expr,
					end_converted.expr,
					body_converted.expr,
					typ,
					loc,
				)
			}
		ForChannelExpr(for_channel, typ, loc):
			iterable: ConvertedExpr = convert_expr(state, bound, for_channel.iterable)
			body: ConvertedExpr = convert_expr(
				iterable.state,
				add_bound_var(bound, for_channel.binder.variable),
				for_channel.body,
			)
			{
				state = body.state,
				expr = ForChannelExpr(
					{ for_channel |
						iterable = iterable.expr,
						body = body.expr
					},
					typ,
					loc,
				)
			}
		ForListExpr(for_list, typ, loc):
			iterable: ConvertedExpr = convert_expr(state, bound, for_list.iterable)
			body: ConvertedExpr = convert_expr(
				iterable.state,
				add_bound_var(bound, for_list.binder.variable),
				for_list.body,
			)
			{
				state = body.state,
				expr = ForListExpr(
					{ for_list |
						iterable = iterable.expr,
						body = body.expr
					},
					typ,
					loc,
				)
			}
		ForStringExpr(for_string, typ, loc):
			iterable: ConvertedExpr = convert_expr(state, bound, for_string.iterable)
			body: ConvertedExpr = convert_expr(
				iterable.state,
				add_bound_var(bound, for_string.binder.variable),
				for_string.body,
			)
			{
				state = body.state,
				expr = ForStringExpr(
					{ for_string |
						iterable = iterable.expr,
						body = body.expr
					},
					typ,
					loc,
				)
			}
		ForDictExpr(for_dict, typ, loc):
			iterable: ConvertedExpr = convert_expr(state, bound, for_dict.iterable)
			body: ConvertedExpr = convert_expr(
				iterable.state,
				add_bound_var(bound, for_dict.binder.variable),
				for_dict.body,
			)
			{
				state = body.state,
				expr = ForDictExpr(
					{ for_dict |
						iterable = iterable.expr,
						body = body.expr
					},
					typ,
					loc,
				)
			}
		ForSetExpr(for_set, typ, loc):
			iterable: ConvertedExpr = convert_expr(state, bound, for_set.iterable)
			body: ConvertedExpr = convert_expr(
				iterable.state,
				add_bound_var(bound, for_set.binder.variable),
				for_set.body,
			)
			{
				state = body.state,
				expr = ForSetExpr(
					{ for_set |
						iterable = iterable.expr,
						body = body.expr
					},
					typ,
					loc,
				)
			}
		ForResourceSourceExpr(for_resource_source, typ, loc):
			iterable: ConvertedExpr = convert_expr(state, bound, for_resource_source.iterable)
			body: ConvertedExpr = convert_expr(
				iterable.state,
				add_bound_var(bound, for_resource_source.binder.variable),
				for_resource_source.body,
			)
			{
				state = body.state,
				expr = ForResourceSourceExpr(
					{ for_resource_source |
						iterable = iterable.expr,
						body = body.expr
					},
					typ,
					loc,
				)
			}
		ForStreamExpr(for_stream, typ, loc):
			iterable: ConvertedExpr = convert_expr(state, bound, for_stream.iterable)
			body: ConvertedExpr = convert_expr(
				iterable.state,
				add_bound_var(bound, for_stream.binder.variable),
				for_stream.body,
			)
			{
				state = body.state,
				expr = ForStreamExpr(
					{ for_stream |
						iterable = iterable.expr,
						body = body.expr
					},
					typ,
					loc,
				)
			}
		ForTensorExpr(for_tensor, typ, loc):
			iterable: ConvertedExpr = convert_expr(state, bound, for_tensor.iterable)
			body: ConvertedExpr = convert_expr(
				iterable.state,
				add_bound_var(bound, for_tensor.binder.variable),
				for_tensor.body,
			)
			{
				state = body.state,
				expr = ForTensorExpr(
					{ for_tensor |
						iterable = iterable.expr,
						body = body.expr
					},
					typ,
					loc,
				)
			}
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			iterable: ConvertedExpr = convert_expr(state, bound, loop.iterable)
			body_bound: List[String] = add_bound_var(bound, loop.variable)
			body: ConvertedExpr = convert_expr(iterable.state, body_bound, loop.body)
			timeout: ConvertedOptionalExpr = convert_optional_expr(body.state, bound, loop.timeout)
			limit: ConvertedExpr = convert_expr(timeout.state, bound, loop.limit)
			task: HoistedTaskClosure = hoist_loop_task(
				limit.state,
				body_bound,
				[],
				loop.variable,
				loop.item_mode,
				body.expr,
				core_expr_type(body.expr),
				loc,
			)
			{
				state = task.state,
				expr = ConcurrentlyLoopExpr(
					{
						variable = loop.variable,
						item_type = loop.item_type,
						item_mode = loop.item_mode,
						iterable = iterable.expr,
						body = body.expr,
						timeout = timeout.expr,
						limit = limit.expr,
						output = loop.output,
						task = task.task
					},
					typ,
					loc,
				)
			}
		ConcurrentlyLoopExpr(loop, typ, loc):
			iterable: ConvertedExpr = convert_expr(state, bound, loop.iterable)
			body_bound: List[String] = add_bound_var(bound, loop.variable)
			body: ConvertedExpr = convert_expr(iterable.state, body_bound, loop.body)
			timeout: ConvertedOptionalExpr = convert_optional_expr(body.state, bound, loop.timeout)
			limit: ConvertedExpr = convert_expr(timeout.state, bound, loop.limit)
			{
				state = limit.state,
				expr = ConcurrentlyLoopExpr(
					{ loop |
						iterable = iterable.expr,
						body = body.expr,
						timeout = timeout.expr,
						limit = limit.expr
					},
					typ,
					loc,
				)
			}
		PreClosureConcurrentExpr(block, typ, loc):
			var current: ClosureState = state
			var bindings: List[CoreConcurrentBinding] = []

			for binding in block.bindings:
				rhs: ConvertedExpr = convert_expr(current, copy_names(bound), binding.rhs)
				task: HoistedTaskClosure = hoist_copy_task(
					rhs.state,
					copy_names(bound),
					[],
					rhs.expr,
					core_expr_type(rhs.expr),
					loc,
				)
				current = task.state
				bindings = bindings.append({
					variable = binding.variable,
					typ = binding.typ,
					rhs = rhs.expr,
					task = task.task,
				})

			var body_bound: List[String] = copy_names(bound)

			for binding in block.bindings:
				body_bound = add_bound_var(body_bound, binding.variable)

			body: ConvertedExpr = convert_expr(current, body_bound, block.body)
			timeout: ConvertedOptionalExpr = convert_optional_expr(
				body.state,
				copy_names(bound),
				block.timeout,
			)
			{
				state = timeout.state,
				expr = ConcurrentExpr(
					{
						bindings = bindings,
						body = body.expr,
						timeout = timeout.expr,
						max_threads = block.max_threads
					},
					typ,
					loc,
				)
			}
		ConcurrentExpr(block, typ, loc):
			var current: ClosureState = state
			var bindings: List[CoreConcurrentBinding] = []

			for binding in block.bindings:
				rhs: ConvertedExpr = convert_expr(current, copy_names(bound), binding.rhs)
				current = rhs.state
				bindings = bindings.append({ binding | rhs = rhs.expr })

			var body_bound: List[String] = copy_names(bound)

			for binding in block.bindings:
				body_bound = add_bound_var(body_bound, binding.variable)

			body: ConvertedExpr = convert_expr(current, body_bound, block.body)
			timeout: ConvertedOptionalExpr = convert_optional_expr(
				body.state,
				copy_names(bound),
				block.timeout,
			)
			{
				state = timeout.state,
				expr = ConcurrentExpr(
					{ block |
						bindings = bindings,
						body = body.expr,
						timeout = timeout.expr
					},
					typ,
					loc,
				)
			}
		SelectExpr(select_expr, typ, loc):
			arms: ConvertedSelectArms = convert_select_arms(state, bound, select_expr.arms)
			{
				state = arms.state,
				expr = SelectExpr({ select_expr | arms = arms.arms }, typ, loc)
			}
		RangeExpr(start, end_value, typ, loc):
			start_converted: ConvertedExpr = convert_expr(state, bound, start)
			end_converted: ConvertedExpr = convert_expr(start_converted.state, bound, end_value)
			{
				state = end_converted.state,
				expr = RangeExpr(start_converted.expr, end_converted.expr, typ, loc)
			}
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			scrutinee_converted: ConvertedExpr = convert_expr(state, bound, scrutinee)
			cases_converted: ConvertedLiteralMatchCases = convert_literal_match_cases(
				scrutinee_converted.state,
				bound,
				cases,
			)
			fallback_converted: ConvertedLiteralMatchFallback = convert_literal_match_fallback(
				cases_converted.state,
				bound,
				fallback,
			)
			{
				state = fallback_converted.state,
				expr = LiteralMatchExpr(
					scrutinee_converted.expr,
					cases_converted.cases,
					fallback_converted.fallback,
					typ,
					loc,
				)
			}
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			scrutinee_converted: ConvertedExpr = convert_expr(state, bound, scrutinee)
			match_converted: ConvertedConstructorLiteralMatch = convert_constructor_literal_match(
				scrutinee_converted.state,
				bound,
				match_expr,
			)
			{
				state = match_converted.state,
				expr = AccessorLiteralMatchExpr(
					scrutinee_converted.expr,
					release_policy,
					match_converted.match_expr,
					typ,
					loc,
				)
			}
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			scrutinee_converted: ConvertedExpr = convert_expr(state, bound, scrutinee)
			match_converted: ConvertedConstructorLengthMatch = convert_constructor_length_match(
				scrutinee_converted.state,
				bound,
				match_expr,
			)
			{
				state = match_converted.state,
				expr = LengthMatchExpr(
					scrutinee_converted.expr,
					release_policy,
					match_converted.match_expr,
					typ,
					loc,
				)
			}
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			scrutinee_converted: ConvertedExpr = convert_expr(state, bound, scrutinee)
			cases_converted: ConvertedConstructorMatchCases = convert_constructor_match_cases(
				scrutinee_converted.state,
				bound,
				cases,
			)
			fallback_converted: ConvertedConstructorMatchFallback = convert_constructor_match_fallback(
				cases_converted.state,
				bound,
				fallback,
			)
			{
				state = fallback_converted.state,
				expr = ConstructorMatchExpr(
					scrutinee_converted.expr,
					release_policy,
					cases_converted.cases,
					fallback_converted.fallback,
					typ,
					loc,
				)
			}
		IfExpr(cond, then_expr, else_expr, typ, loc):
			cond_converted: ConvertedExpr = convert_expr(state, bound, cond)
			then_converted: ConvertedExpr = convert_expr(cond_converted.state, bound, then_expr)
			else_converted: ConvertedExpr = convert_expr(then_converted.state, bound, else_expr)
			{
				state = else_converted.state,
				expr = IfExpr(
					cond_converted.expr,
					then_converted.expr,
					else_converted.expr,
					typ,
					loc,
				)
			}


private pure func max_enum_decl_def_id(current: Int, enum_decl: CoreEnumDecl) -> Int:
	var result: Int = current

	for variant in enum_decl.variants:
		result = max_optional_int(result, variant.def_id)

	result


private pure func max_union_decl_def_id(current: Int, union_decl: CoreUnionDecl) -> Int:
	var result: Int = current

	for variant in union_decl.variants:
		result = max_optional_int(result, variant.def_id)

	result


private pure func max_function_def_id(current: Int, func_info: CoreFunction) -> Int:
	var result: Int = max_int(current, func_info.def_id)

	match func_info.body:
		Some(body):
			max_expr_def_id(result, body)
		None:
			result


private pure func max_global_def_id(current: Int, global: CoreGlobal) -> Int:
	max_expr_def_id(
		max_int(current, global.def_id),
		global.init,
	)


private pure func max_decl_def_id(current: Int, decl: CoreDecl) -> Int:
	match decl:
		FunctionDecl(func_info):
			max_function_def_id(current, func_info)
		GlobalDecl(global):
			max_global_def_id(current, global)
		EnumDecl(enum_decl):
			max_enum_decl_def_id(current, enum_decl)
		UnionDecl(union_decl):
			max_union_decl_def_id(current, union_decl)
		ValueRecordDecl(record_decl):
			current
		HeapRecordDecl(record_decl):
			current


private pure func max_program_def_id(program: CoreProgram) -> Int:
	var result: Int = 0

	for decl in program.decls:
		result = max_decl_def_id(result, decl)

	result


private pure func add_name_once(names: List[String], name: String) -> List[String]:
	if contains_name(names, name):
		names
	else:
		names.append(name)


private pure func builtin_constructor_names() -> List[String]:
	["Some", "None", "Ok", "Err", "True", "False", "Timeout", "TaskFailed", "Cancelled", "NULL"]


pure func capture_constructor_names(program: CoreProgram) -> List[String]:
	var names: List[String] = builtin_constructor_names()

	for decl in program.decls:
		match decl:
			EnumDecl(enum_decl):
				for variant in enum_decl.variants:
					names = add_name_once(names, variant.name)
					names = add_name_once(names, variant.c_name)
			UnionDecl(union_decl):
				for variant in union_decl.variants:
					names = add_name_once(names, variant.name)
					names = add_name_once(names, variant.c_name)
					names = add_name_once(names, variant.tag_c_name)
			FunctionDecl(func_info):
				void
			GlobalDecl(global):
				void
			ValueRecordDecl(record_decl):
				void
			HeapRecordDecl(record_decl):
				void

	names


pure func capture_function_names(program: CoreProgram) -> List[String]:
	var names: List[String] = []

	for decl in program.decls:
		match decl:
			FunctionDecl(func_info):
				names = add_name_once(names, func_info.name)
			GlobalDecl(global):
				void
			EnumDecl(enum_decl):
				void
			UnionDecl(union_decl):
				void
			ValueRecordDecl(record_decl):
				void
			HeapRecordDecl(record_decl):
				void

	names


private pure func initial_state(program: CoreProgram) -> ClosureState:
	{
		next_lambda_index = 0,
		next_task_index = 0,
		next_def_id = max_program_def_id(program) + 1,
		current_module = None,
		function_names = capture_function_names(program),
		constructor_names = capture_constructor_names(program),
		hoisted = []
	}


private pure func convert_function(state: ClosureState, func_info: CoreFunction) -> ConvertedDecl:
	match func_info.body:
		Some(body):
			state_with_module: ClosureState = { state | current_module = func_info.source_module }
			body_bound: List[String] = add_bound_params([], func_info.params)
			converted: ConvertedExpr = convert_expr(state_with_module, body_bound, body)
			final_state: ClosureState = { converted.state | current_module = state.current_module }
			{
				state = final_state,
				decl = FunctionDecl({ func_info | body = Some(converted.expr) })
			}
		None:
			{
				state = state,
				decl = FunctionDecl(func_info)
			}


private pure func convert_global(state: ClosureState, global: CoreGlobal) -> ConvertedDecl:
	converted: ConvertedExpr = convert_expr(state, [], global.init)
	{
		state = converted.state,
		decl = GlobalDecl({ global | init = converted.expr })
	}


private pure func convert_decl(state: ClosureState, decl: CoreDecl) -> ConvertedDecls:
	match decl:
		FunctionDecl(func_info):
			if func_info.type_params.length() == 0:
				converted: ConvertedDecl = convert_function(state, func_info)
				{
					state = converted.state,
					decls = [converted.decl]
				}
			else:
				{
					state = state,
					decls = []
				}
		GlobalDecl(global):
			converted: ConvertedDecl = convert_global(state, global)
			{
				state = converted.state,
				decls = [converted.decl]
			}
		EnumDecl(enum_decl):
			{
				state = state,
				decls = [decl]
			}
		UnionDecl(union_decl):
			{
				state = state,
				decls = [decl]
			}
		ValueRecordDecl(record_decl):
			{
				state = state,
				decls = [decl]
			}
		HeapRecordDecl(record_decl):
			{
				state = state,
				decls = [decl]
			}


private pure func convert_decls(state: ClosureState, decls: List[CoreDecl]) -> ConvertedDecls:
	var current: ClosureState = state
	var converted_decls: List[CoreDecl] = []

	for decl in decls:
		converted: ConvertedDecls = convert_decl(current, decl)
		current = converted.state
		converted_decls = converted_decls.concat(converted.decls)

	{
		state = current,
		decls = converted_decls
	}


pure func convert_program(program: CoreProgram) -> CoreProgram:
	converted: ConvertedDecls = convert_decls(initial_state(program), program.decls)
	{
		decls = converted.decls.concat(converted.state.hoisted),
		foreign_includes = program.foreign_includes
	}
