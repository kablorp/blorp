-- Dead emitted-function elimination for the projected Core boundary.
--
-- Earlier Core stages have already removed generic templates, aliases, traits,
-- imports, and impl containers. Impl methods are represented as
-- ordinary functions. This pass therefore reasons about emitted function
-- identities and the projected type graph. Backend artifacts are derived from
-- retained data declarations rather than modeled as separate DCE nodes.
-- Missing entrypoints, duplicate function identities, and unresolved user
-- calls all fail closed by returning the input program unchanged.
import:
	ir:
		CoreBoxedStorageValue,
		CoreCallKind(
			BuiltinCall,
			ClosureCall,
			DeferredTraitCall,
			DictWithCapacityCall,
			DirectRuntimeCall,
			FallibleStreamTerminalCall,
			ForeignCall,
			IntrinsicCall,
			ListToStringCall,
			OperationResultCall,
			SelectedDirectCall,
			SelectedTraitCall,
			TensorParallelCall,
			UnknownCall,
			UserCall,
		),
		CoreConstructorLengthMatch,
		CoreConstructorLiteralMatch,
		CoreConstructorMatchBody(
			ConstructorMatchBodyExpr,
			ConstructorMatchBodyLength,
			ConstructorMatchBodyLiteral,
		),
		CoreConstructorMatchFallback(
			ConstructorMatchFallbackBindings,
			ConstructorMatchFallbackBody,
			ConstructorMatchFallbackFail,
		),
		CoreDecl(
			EnumDecl,
			FunctionDecl,
			GlobalDecl,
			HeapRecordDecl,
			ImplDecl,
			TraitDecl,
			TypeAliasDecl,
			UnionDecl,
			ValueRecordDecl,
		),
		CoreExpr(
			AccessorLiteralMatchExpr,
			AssignExpr,
			BinaryExpr,
			BorrowLetExpr,
			BoxExpr,
			BreakExpr,
			CallExpr,
			CastExpr,
			ClosureCreateExpr,
			ConcurrentExpr,
			ConcurrentlyLoopExpr,
			ConstructorMatchExpr,
			ContinueExpr,
			CooperativeCheckpointExpr,
			DebugBlockExpr,
			DetachExpr,
			DictConstructExpr,
			DictExpr,
			DropExpr,
			DupExpr,
			FieldExpr,
			ForChannelExpr,
			ForDictExpr,
			ForListExpr,
			ForRangeExpr,
			ForResourceSourceExpr,
			ForSetExpr,
			ForStreamExpr,
			ForStringExpr,
			ForTensorExpr,
			IfExpr,
			LambdaExpr,
			LengthMatchExpr,
			LetExpr,
			ListAllocExpr,
			ListConstructExpr,
			ListGetExpr,
			ListHandoffExpr,
			ListHandoffSetOwnedExpr,
			ListHandoffSetSourceSlotExpr,
			ListRetainExpr,
			ListSetExpr,
			ListSwapExpr,
			LiteralExpr,
			LiteralMatchExpr,
			LogicalExpr,
			PreClosureConcurrentExpr,
			PreClosureConcurrentlyLoopExpr,
			PreClosureDetachExpr,
			RawMatchExpr,
			SemanticMatchExpr,
			RangeExpr,
			RecordConstructExpr,
			RecordExpr,
			RecordReuseExpr,
			RecordUpdateExpr,
			ResourceCleanupExitExpr,
			ResourceScopeExpr,
			SelectExpr,
			SeqExpr,
			SetAllocExpr,
			StringByteCopyExpr,
			StringByteReadExpr,
			StringByteWriteExpr,
			StringSetLenExpr,
			TailrecListSpreadLoopExpr,
			TailrecListSpreadRecurExpr,
			TailrecLoopExpr,
			TailrecRecurExpr,
			TensorBoxedLiteralExpr,
			TensorLiteralExpr,
			TensorPackedLiteralExpr,
			TensorRawFillExpr,
			TensorRawReadExpr,
			TensorRawViewLetExpr,
			TensorRawWriteExpr,
			TupleConstructExpr,
			TupleExpr,
			TupleFieldExpr,
			UnaryExpr,
			UnboxExpr,
			UnionConstructExpr,
			UnionReuseConstructExpr,
			VarExpr,
			VectorExpr,
			VoidExpr,
			WhileExpr,
		),
		CoreFunction,
		CoreFunctionKind(
			BuiltinFunction,
			ClosureBodyFunction,
			ForeignFunction,
			UnresolvedBuiltinFunction,
			UserFunction,
		),
		CoreGlobal,
		CoreHashContainerConstructor(
			CustomHashContainerConstructor,
			FloatHashContainerConstructor,
			GenericHashContainerConstructor,
			StringHashContainerConstructor,
		),
		CoreLiteralMatchCase,
		CoreLiteralMatchFallback(
			LiteralMatchFallbackBindings,
			LiteralMatchFallbackBody,
			LiteralMatchFallbackFail,
		),
		CoreProgram,
		CoreRecordFieldValue,
		CoreSelectArmKind(SelectAfterArm, SelectRecvArm, SelectSealedArm),
		CoreTensorLiteralPayload(TensorInlineStructLiteralPayload, TensorRawLiteralPayload),
		CoreTupleElement(
			TupleFloat16Element,
			TupleFloat32Element,
			TupleFloatElement,
			TuplePointerElement,
			TuplePrimElement,
			TupleStackResultElement,
			TupleStructElement,
			TupleVoidElement,
		),
		CoreType(
			BoxedResultType,
			EnumType,
			FunctionType,
			HeapRecordType,
			NamedType,
			RangeType,
			SelfType,
			StackResultType,
			TensorType,
			TupleType,
			TypeParameterType,
			UnionType,
			ValueRecordType,
			VoidType,
		),
		CoreVar,
		core_expr_type,
	set as Sets
	traverse as CoreTraverse


private enum DceFactCollectionMode:
	CollectReachabilityFacts
	CollectValueReferences


private record DceConstructorReference {
	name: String,
	def_id: Int
}


private record DceConstructorIdentity {
	parent_type_name: String,
	def_id: Int
}


record DceFacts {
	mode: DceFactCollectionMode,
	function_ids: List[Int],
	function_names: List[String],
	constructor_references: List[DceConstructorReference],
	global_names: List[String],
	global_names_seen: Dict[String, Bool],
	value_reads: List[CoreVar],
	value_read_def_ids_by_uniq_by_name: Dict[String, Dict[Int, Dict[Int, Bool]]],
	value_invalidations: List[CoreVar],
	value_invalidation_def_ids_by_uniq_by_name: Dict[String, Dict[Int, Dict[Int, Bool]]],
	value_reference_occurrences: List[CoreVar],
	type_names: List[String],
	fail_closed: Bool
}


record CoreValueReferences {
	names: List[String],
	resolved_reads: List[CoreVar],
	resolved_invalidations: List[CoreVar],
	resolved_occurrences: List[CoreVar]
}


private union DceExprStack:
	NoDceExpr
	MoreDceExpr(CoreExpr, DceExprStack)


private pure func add_function_id(facts: DceFacts, def_id: Int) -> DceFacts:
	match facts.mode:
		CollectReachabilityFacts:
			if facts.function_ids.contains(def_id):
				facts
			else:
				{ facts | function_ids = facts.function_ids.append(def_id) }
		CollectValueReferences:
			facts


private pure func add_function_name(facts: DceFacts, name: String) -> DceFacts:
	match facts.mode:
		CollectReachabilityFacts:
			if facts.function_names.contains(name):
				facts
			else:
				{ facts | function_names = facts.function_names.append(name) }
		CollectValueReferences:
			facts


private pure func add_global_name(facts: DceFacts, name: String) -> DceFacts:
	if facts.global_names_seen.contains(name):
		facts
	else:
		{ facts |
			global_names = facts.global_names.append(name),
			global_names_seen = facts.global_names_seen.set(name, True)
		}


private pure func resolved_value_index_contains(
	index: Dict[String, Dict[Int, Dict[Int, Bool]]],
	variable: CoreVar,
) -> Bool:
	match (variable.def_id, index.get(variable.name)):
		(Some(def_id), Some(def_ids_by_uniq)):
			match def_ids_by_uniq.get(variable.uniq):
				Some(def_ids):
					def_ids.contains(def_id)
				None:
					False
		_:
			False


private pure func add_resolved_value_to_index(
	index: Dict[String, Dict[Int, Dict[Int, Bool]]],
	variable: CoreVar,
) -> Dict[String, Dict[Int, Dict[Int, Bool]]]:
	match variable.def_id:
		Some(def_id):
			def_ids_by_uniq: Dict[Int, Dict[Int, Bool]] = index.get_or(variable.name, {})
			def_ids: Dict[Int, Bool] = def_ids_by_uniq.get_or(variable.uniq, {})

			index.set(
				variable.name,
				def_ids_by_uniq.set(
					variable.uniq,
					def_ids.set(def_id, True),
				),
			)
		None:
			index


private pure func add_value_read(facts: DceFacts, variable: CoreVar) -> DceFacts:
	referenced: DceFacts = add_global_name(facts, variable.name)

	match referenced.mode:
		CollectReachabilityFacts:
			referenced
		CollectValueReferences:
			match variable.def_id:
				Some(def_id):
					with_occurrence: DceFacts = { referenced |
						value_reference_occurrences = referenced.value_reference_occurrences.append(
							variable,
						)
					}

					if resolved_value_index_contains(
						with_occurrence.value_read_def_ids_by_uniq_by_name,
						variable,
					):
						with_occurrence
					else:
						{ with_occurrence |
							value_reads = with_occurrence.value_reads.append(variable),
							value_read_def_ids_by_uniq_by_name = add_resolved_value_to_index(
								with_occurrence.value_read_def_ids_by_uniq_by_name,
								variable,
							)
						}
				None:
					referenced


private pure func add_variable_reference(
	facts: DceFacts,
	variable: CoreVar,
	typ: CoreType,
) -> DceFacts:
	match (facts.mode, typ, variable.def_id):
		(CollectReachabilityFacts, FunctionType(_, _, _), Some(def_id)):
			add_function_id(facts, def_id)
		_:
			add_value_read(facts, variable)


private pure func add_value_invalidation(facts: DceFacts, variable: CoreVar) -> DceFacts:
	match facts.mode:
		CollectReachabilityFacts:
			facts
		CollectValueReferences:
			match variable.def_id:
				Some(def_id):
					with_occurrence: DceFacts = { facts |
						value_reference_occurrences = facts.value_reference_occurrences.append(
							variable,
						)
					}

					if resolved_value_index_contains(
						with_occurrence.value_invalidation_def_ids_by_uniq_by_name,
						variable,
					):
						with_occurrence
					else:
						{ with_occurrence |
							value_invalidations = with_occurrence.value_invalidations.append(
								variable,
							),
							value_invalidation_def_ids_by_uniq_by_name = add_resolved_value_to_index(
								with_occurrence.value_invalidation_def_ids_by_uniq_by_name,
								variable,
							)
						}
				None:
					facts


private pure func add_type_name(facts: DceFacts, name: String) -> DceFacts:
	match facts.mode:
		CollectReachabilityFacts:
			if facts.type_names.contains(name):
				facts
			else:
				{ facts | type_names = facts.type_names.append(name) }
		CollectValueReferences:
			facts


private pure func collect_types(facts: DceFacts, types: List[CoreType]) -> DceFacts:
	var result: DceFacts = facts

	for typ in types:
		result = collect_type(result, typ)

	result


private pure func collect_type(facts: DceFacts, typ: CoreType) -> DceFacts:
	match typ:
		VoidType:
			facts
		NamedType(name, args):
			collect_types(
				add_type_name(facts, name),
				args,
			)
		TypeParameterType(_) | SelfType:
			facts
		StackResultType(ok_type, error_type):
			collect_type(
				collect_type(facts, ok_type),
				error_type,
			)
		BoxedResultType(ok_type, error_type):
			collect_type(
				collect_type(facts, ok_type),
				error_type,
			)
		FunctionType(_, params, return_type):
			collect_type(
				collect_types(facts, params),
				return_type,
			)
		EnumType(name):
			add_type_name(facts, name)
		ValueRecordType(name):
			add_type_name(facts, name)
		HeapRecordType(name):
			add_type_name(facts, name)
		UnionType(name):
			add_type_name(facts, name)
		RangeType:
			facts
		TensorType(info):
			collect_type(facts, info.element_type)
		TupleType(items):
			collect_types(facts, items)


private pure func collect_hash_constructor(
	facts: DceFacts,
	constructor: CoreHashContainerConstructor,
) -> DceFacts:
	match constructor:
		CustomHashContainerConstructor(hash_name, equals_name, needs_release):
			add_function_name(
				add_function_name(facts, hash_name),
				equals_name,
			)
		GenericHashContainerConstructor:
			facts
		StringHashContainerConstructor:
			facts
		FloatHashContainerConstructor:
			facts


private pure func collect_call_kind(facts: DceFacts, kind: CoreCallKind) -> DceFacts:
	match kind:
		UnknownCall:
			-- Dynamic closure calls do not name a top-level target. Reachability for
			-- their code comes from ClosureCreateExpr and task-closure metadata.
			facts
		DeferredTraitCall(trait_name, method_name):
			-- Trait resolution owns the concrete target. If this state survives
			-- into DCE, retaining the full program is safer than pruning a needed
			-- impl method based on an unresolved dispatch.
			{ facts | fail_closed = True }
		SelectedTraitCall(trait_name, method_name, module_path, def_id):
			{ facts | fail_closed = True }
		SelectedDirectCall(def_id):
			add_function_id(facts, def_id)
		UserCall(name, Some(def_id), consumed_args):
			referenced = add_function_id(facts, def_id)

			match referenced.mode:
				CollectReachabilityFacts:
					{ referenced |
						constructor_references = referenced.constructor_references.append({
							name = name,
							def_id = def_id,
						})
					}
				CollectValueReferences:
					referenced
		UserCall(name, None, consumed_args):
			{ facts | fail_closed = True }
		DictWithCapacityCall(constructor):
			collect_hash_constructor(facts, constructor)
		ListToStringCall(callback_name):
			add_function_name(facts, callback_name)
		BuiltinCall(name):
			facts
		ClosureCall:
			facts
		DirectRuntimeCall(call):
			facts
		FallibleStreamTerminalCall(bridge):
			facts
		ForeignCall(name, arg_passing):
			facts
		IntrinsicCall(name):
			facts
		OperationResultCall(bridge):
			facts
		TensorParallelCall(name, layout):
			facts


private pure func collect_exprs(facts: DceFacts, exprs: List[CoreExpr]) -> DceFacts:
	var result: DceFacts = facts

	for expr in exprs:
		result = collect_expr(result, expr)

	result


private pure func collect_boxed_values(
	facts: DceFacts,
	values: List[CoreBoxedStorageValue],
) -> DceFacts:
	var result: DceFacts = facts

	for value in values:
		result = collect_expr(result, value.value)

	result


private pure func collect_tuple_elements(
	facts: DceFacts,
	elements: List[CoreTupleElement],
) -> DceFacts:
	var result: DceFacts = facts

	for element in elements:
		result = match element:
			TuplePrimElement(expr):
				collect_expr(result, expr)
			TuplePointerElement(expr):
				collect_expr(result, expr)
			TupleStructElement(expr, c_type):
				collect_expr(result, expr)
			TupleStackResultElement(expr):
				collect_expr(result, expr)
			TupleVoidElement:
				result
			TupleFloatElement(expr):
				collect_expr(result, expr)
			TupleFloat32Element(expr):
				collect_expr(result, expr)
			TupleFloat16Element(expr):
				collect_expr(result, expr)

	result


private pure func collect_record_fields(
	facts: DceFacts,
	fields: List[CoreRecordFieldValue],
) -> DceFacts:
	var result: DceFacts = facts

	for field in fields:
		result = collect_expr(result, field.value)

	result


private pure func collect_literal_match_cases(
	facts: DceFacts,
	cases: List[CoreLiteralMatchCase],
) -> DceFacts:
	var result: DceFacts = facts

	for match_case in cases:
		result = collect_expr(result, match_case.body)

	result


private pure func collect_literal_match_fallback(
	facts: DceFacts,
	fallback: CoreLiteralMatchFallback,
) -> DceFacts:
	match fallback:
		LiteralMatchFallbackBody(body):
			collect_expr(facts, body)
		LiteralMatchFallbackBindings(bindings, body):
			collect_expr(facts, body)
		LiteralMatchFallbackFail:
			facts


private pure func collect_constructor_match_body(
	facts: DceFacts,
	body: CoreConstructorMatchBody,
) -> DceFacts:
	match body:
		ConstructorMatchBodyExpr(expr):
			collect_expr(facts, expr)
		ConstructorMatchBodyLiteral(literal_match):
			collect_constructor_literal_match(facts, literal_match)
		ConstructorMatchBodyLength(length_match):
			collect_constructor_length_match(facts, length_match)


private pure func collect_constructor_literal_match(
	facts: DceFacts,
	match_expr: CoreConstructorLiteralMatch,
) -> DceFacts:
	collect_literal_match_fallback(
		collect_literal_match_cases(facts, match_expr.cases),
		match_expr.fallback,
	)


private pure func collect_constructor_length_match(
	facts: DceFacts,
	match_expr: CoreConstructorLengthMatch,
) -> DceFacts:
	var result: DceFacts = facts

	for match_case in match_expr.cases:
		result = collect_constructor_match_body(result, match_case.branch.body)

	match match_expr.geq:
		Some(found):
			result = collect_constructor_match_body(result, found.branch.body)
		None:
			void

	match match_expr.fallback:
		Some(branch):
			result = collect_constructor_match_body(result, branch.body)
		None:
			void

	result


private pure func collect_optional_expr(facts: DceFacts, expr: Option[CoreExpr]) -> DceFacts:
	match expr:
		Some(found):
			collect_expr(facts, found)
		None:
			facts


private pure func collect_expr(facts: DceFacts, expr: CoreExpr) -> DceFacts:
	-- Source blocks become long right-associated binding chains. Keep those
	-- chains off the C stack even when they appear below a non-binding wrapper.
	var pending: DceExprStack = MoreDceExpr(expr, NoDceExpr)
	var result: DceFacts = facts
	var complete: Bool = False

	while not complete:
		match pending:
			NoDceExpr:
				complete = True
			MoreDceExpr(current, remaining):
				pending = remaining

				typed_facts: DceFacts = match result.mode:
					CollectReachabilityFacts:
						collect_type(result, core_expr_type(current))
					CollectValueReferences:
						-- Reference collection depends only on exact CoreVar identities.
						-- Walking reused type metadata here adds depth-proportional work
						-- while intentionally discarding every collected type fact. It
						-- also updates the loop-owned facts directly: a fresh record shell
						-- per expression adds ownership churn without protecting any
						-- reachability collection.
						result

				match current:
					LetExpr(variable, is_mutable, value_type, rhs, body):
						pending = MoreDceExpr(
							rhs,
							MoreDceExpr(body, pending),
						)
						result = typed_facts
					BorrowLetExpr(variable, value_type, rhs, body):
						pending = MoreDceExpr(
							rhs,
							MoreDceExpr(body, pending),
						)
						result = typed_facts
					SeqExpr(first, second):
						pending = MoreDceExpr(
							first,
							MoreDceExpr(second, pending),
						)
						result = typed_facts
					AssignExpr(variable, rhs, typ, loc):
						result = add_value_invalidation(
							add_global_name(typed_facts, variable.name),
							variable,
						)
						pending = MoreDceExpr(rhs, pending)
					_:
						result = collect_expr_children(typed_facts, current)

	result


private pure func collect_expr_children(facts: DceFacts, expr: CoreExpr) -> DceFacts:
	match expr:
		LiteralExpr(literal, typ, loc):
			facts
		VarExpr(variable, typ, loc):
			add_variable_reference(facts, variable, typ)
		VoidExpr(typ, loc):
			facts
		DebugBlockExpr(body, typ, loc):
			collect_expr(facts, body)
		CooperativeCheckpointExpr(typ, loc):
			facts
		RawMatchExpr(scrutinee, cases, typ, loc):
			var result: DceFacts = collect_expr(facts, scrutinee)

			for case in cases:
				result = collect_expr(result, case.body)

			result
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			collect_exprs(
				facts,
				CoreTraverse.immediate_core_expr_children(expr),
			)
		CallExpr(kind, callee, args, typ, loc):
			collect_exprs(
				collect_expr(
					collect_call_kind(facts, kind),
					callee,
				),
				args,
			)
		BinaryExpr(op, left, right, typ, loc):
			collect_expr(
				collect_expr(facts, left),
				right,
			)
		UnaryExpr(op, value, typ, loc):
			collect_expr(facts, value)
		LogicalExpr(op, left, right, typ, loc):
			collect_expr(
				collect_expr(facts, left),
				right,
			)
		AssignExpr(variable, rhs, typ, loc):
			collect_expr(
				add_value_invalidation(
					add_global_name(facts, variable.name),
					variable,
				),
				rhs,
			)
		CastExpr(value, typ, loc):
			collect_expr(facts, value)
		BoxExpr(box, typ, loc):
			collect_expr(facts, box.value)
		UnboxExpr(kind, value, typ, loc):
			collect_expr(facts, value)
		FieldExpr(value, field_name, typ, loc):
			collect_expr(facts, value)
		TupleFieldExpr(value, field_index, typ, loc):
			collect_expr(facts, value)
		TupleExpr(items, typ, loc):
			collect_exprs(facts, items)
		TupleConstructExpr(construct, typ, loc):
			collect_tuple_elements(facts, construct.elements)
		VectorExpr(items, typ, loc):
			collect_exprs(facts, items)
		LambdaExpr(params, return_type, body, is_pure, typ, loc):
			collect_expr(facts, body)
		ClosureCreateExpr(closure, typ, loc):
			add_function_id(facts, closure.def_id)
		ListConstructExpr(construct, typ, loc):
			collect_boxed_values(facts, construct.elements)
		ListAllocExpr(alloc, typ, loc):
			collect_expr(facts, alloc.capacity)
		ListGetExpr(get, typ, loc):
			collect_expr(
				collect_expr(facts, get.list),
				get.index,
			)
		ListHandoffExpr(handoff, typ, loc):
			var result: DceFacts = collect_expr(facts, handoff.source)
			result = collect_expr(result, handoff.capacity)
			collect_expr(result, handoff.body)
		ListHandoffSetOwnedExpr(set, typ, loc):
			collect_expr(
				collect_expr(
					collect_expr(facts, set.list),
					set.index,
				),
				set.value.value,
			)
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			var result: DceFacts = collect_expr(facts, slot.result)
			result = collect_expr(result, slot.out_index)
			result = collect_expr(result, slot.source)
			collect_expr(result, slot.source_index)
		StringByteReadExpr(read, typ, loc):
			collect_expr(
				collect_expr(facts, read.source),
				read.index,
			)
		StringByteWriteExpr(write, typ, loc):
			collect_expr(
				collect_expr(
					collect_expr(facts, write.target),
					write.index,
				),
				write.byte,
			)
		StringByteCopyExpr(copy, typ, loc):
			var result: DceFacts = collect_expr(facts, copy.dst)
			result = collect_expr(result, copy.dst_pos)
			result = collect_expr(result, copy.src)
			result = collect_expr(result, copy.src_pos)
			collect_expr(result, copy.len)
		StringSetLenExpr(set_len, typ, loc):
			collect_expr(
				collect_expr(facts, set_len.target),
				set_len.len,
			)
		TensorLiteralExpr(literal, typ, loc):
			match literal.payload:
				TensorRawLiteralPayload(raw):
					collect_exprs(facts, raw.elements)
				TensorInlineStructLiteralPayload(inline_struct):
					collect_exprs(facts, inline_struct.elements)
		TensorBoxedLiteralExpr(literal, typ, loc):
			collect_boxed_values(facts, literal.elements)
		TensorPackedLiteralExpr(literal, typ, loc):
			collect_exprs(facts, literal.elements)
		TensorRawFillExpr(fill, typ, loc):
			collect_exprs(
				collect_expr(facts, fill.value),
				fill.dims,
			)
		TensorRawReadExpr(read, typ, loc):
			collect_expr(
				add_value_read(facts, read.view),
				read.index,
			)
		TensorRawWriteExpr(write, typ, loc):
			collect_expr(
				collect_expr(
					add_value_read(facts, write.view),
					write.index,
				),
				write.value,
			)
		TensorRawViewLetExpr(binding, body, typ, loc):
			collect_expr(
				collect_expr(facts, binding.source),
				body,
			)
		DictExpr(entries, typ, loc):
			var result: DceFacts = facts

			for entry in entries:
				result = collect_expr(result, entry.key)
				result = collect_expr(result, entry.value)

			result
		DictConstructExpr(construct, typ, loc):
			var result: DceFacts = collect_hash_constructor(facts, construct.constructor)

			for entry in construct.entries:
				result = collect_expr(result, entry.key.value)
				result = collect_expr(result, entry.value.value)

			result
		SetAllocExpr(alloc, typ, loc):
			collect_hash_constructor(facts, alloc)
		ListRetainExpr(retain, typ, loc):
			collect_expr(
				collect_expr(facts, retain.list),
				retain.value.value,
			)
		ListSetExpr(set, typ, loc):
			collect_expr(
				collect_expr(
					collect_expr(facts, set.list),
					set.index,
				),
				set.value.value,
			)
		ListSwapExpr(swap, typ, loc):
			collect_expr(
				collect_expr(
					collect_expr(facts, swap.list),
					swap.left_index,
				),
				swap.right_index,
			)
		RecordExpr(fields, typ, loc):
			collect_record_fields(facts, fields)
		RecordUpdateExpr(base, fields, typ, loc):
			collect_record_fields(
				collect_expr(facts, base),
				fields,
			)
		RecordReuseExpr(source, fields, typ, loc):
			collect_record_fields(
				collect_expr(facts, source),
				fields,
			)
		RecordConstructExpr(name, fields, typ, loc):
			collect_record_fields(facts, fields)
		UnionConstructExpr(construct, typ, loc):
			collect_boxed_values(facts, construct.args)
		UnionReuseConstructExpr(construct, typ, loc):
			collect_boxed_values(
				collect_expr(facts, construct.source),
				construct.args,
			)
		PreClosureDetachExpr(detached, typ, loc):
			collect_expr(facts, detached)
		DetachExpr(detached, typ, loc):
			add_function_id(facts, detached.def_id)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			collect_expr(
				add_variable_reference(facts, variable, value_type),
				body,
			)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			collect_expr(
				add_value_invalidation(facts, variable),
				body,
			)
		LetExpr(variable, is_mutable, value_type, rhs, body):
			collect_expr(
				collect_expr(facts, rhs),
				body,
			)
		BorrowLetExpr(variable, value_type, rhs, body):
			collect_expr(
				collect_expr(facts, rhs),
				body,
			)
		SeqExpr(first, second):
			collect_expr(
				collect_expr(facts, first),
				second,
			)
		WhileExpr(cond, body, typ, loc):
			collect_expr(
				collect_expr(facts, cond),
				body,
			)
		BreakExpr(typ, loc):
			facts
		ContinueExpr(typ, loc):
			facts
		ResourceScopeExpr(scope, typ, loc):
			var result: DceFacts = collect_expr(facts, scope.acquire)
			result = collect_expr(result, scope.body)
			collect_expr(result, scope.cleanup)
		ResourceCleanupExitExpr(exit, typ, loc):
			collect_exprs(facts, exit.cleanups)
		TailrecLoopExpr(params, return_type, body, loc):
			collect_expr(facts, body)
		TailrecRecurExpr(args, typ, loc):
			collect_exprs(facts, args)
		TailrecListSpreadLoopExpr(loop, loc):
			collect_expr(facts, loop.body)
		TailrecListSpreadRecurExpr(rebinds, list_index, typ, loc):
			var result: DceFacts = facts

			for rebind in rebinds:
				result = collect_expr(result, rebind.value)

			result
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			collect_expr(
				collect_expr(
					collect_expr(facts, start),
					end_value,
				),
				body,
			)
		ForChannelExpr(loop, typ, loc):
			collect_expr(
				collect_expr(facts, loop.iterable),
				loop.body,
			)
		ForListExpr(loop, typ, loc):
			collect_expr(
				collect_expr(facts, loop.iterable),
				loop.body,
			)
		ForStringExpr(loop, typ, loc):
			collect_expr(
				collect_expr(facts, loop.iterable),
				loop.body,
			)
		ForDictExpr(loop, typ, loc):
			collect_expr(
				collect_expr(facts, loop.iterable),
				loop.body,
			)
		ForSetExpr(loop, typ, loc):
			collect_expr(
				collect_expr(facts, loop.iterable),
				loop.body,
			)
		ForStreamExpr(loop, typ, loc):
			collect_expr(
				collect_expr(facts, loop.iterable),
				loop.body,
			)
		ForResourceSourceExpr(loop, typ, loc):
			collect_expr(
				collect_expr(facts, loop.iterable),
				loop.body,
			)
		ForTensorExpr(loop, typ, loc):
			collect_expr(
				collect_expr(facts, loop.iterable),
				loop.body,
			)
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			var result: DceFacts = collect_expr(facts, loop.iterable)
			result = collect_expr(result, loop.body)
			result = collect_optional_expr(result, loop.timeout)
			collect_expr(result, loop.limit)
		ConcurrentlyLoopExpr(loop, typ, loc):
			var result: DceFacts = add_function_id(facts, loop.task.def_id)
			result = collect_expr(result, loop.iterable)
			result = collect_expr(result, loop.body)
			result = collect_optional_expr(result, loop.timeout)
			collect_expr(result, loop.limit)
		PreClosureConcurrentExpr(block, typ, loc):
			var result: DceFacts = facts

			for binding in block.bindings:
				result = collect_expr(result, binding.rhs)

			result = collect_expr(result, block.body)
			collect_optional_expr(result, block.timeout)
		ConcurrentExpr(block, typ, loc):
			var result: DceFacts = facts

			for binding in block.bindings:
				result = add_function_id(result, binding.task.def_id)
				result = collect_expr(result, binding.rhs)

			result = collect_expr(result, block.body)
			collect_optional_expr(result, block.timeout)
		SelectExpr(select_expr, typ, loc):
			var result: DceFacts = facts

			for arm in select_expr:
				result = match arm.kind:
					SelectRecvArm(recv):
						collect_expr(result, recv.channel)
					SelectSealedArm(channel):
						collect_expr(result, channel)
					SelectAfterArm(timeout):
						collect_expr(result, timeout)

				result = collect_expr(result, arm.body)

			result
		RangeExpr(start, end_value, typ, loc):
			collect_expr(
				collect_expr(facts, start),
				end_value,
			)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			collect_literal_match_fallback(
				collect_literal_match_cases(
					collect_expr(facts, scrutinee),
					cases,
				),
				fallback,
			)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			collect_constructor_literal_match(
				collect_expr(facts, scrutinee),
				match_expr,
			)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			collect_constructor_length_match(
				collect_expr(facts, scrutinee),
				match_expr,
			)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			var result: DceFacts = collect_expr(facts, scrutinee)

			for match_case in cases:
				result = collect_constructor_match_body(result, match_case.body)

			match fallback:
				ConstructorMatchFallbackBody(body):
					collect_expr(result, body)
				ConstructorMatchFallbackBindings(bindings, body):
					collect_expr(result, body)
				ConstructorMatchFallbackFail:
					result
		IfExpr(cond, then_expr, else_expr, typ, loc):
			collect_expr(
				collect_expr(
					collect_expr(facts, cond),
					then_expr,
				),
				else_expr,
			)


private pure func append_resolved_value_occurrence(
	occurrences: List[CoreVar],
	variable: CoreVar,
) -> List[CoreVar]:
	if variable.def_id.is_some():
		occurrences.append(variable)
	else:
		occurrences


private pure func push_value_occurrence_children(
	pending: DceExprStack,
	expr: CoreExpr,
) -> DceExprStack:
	match expr:
		LiteralExpr(_, _, _) | VarExpr(_, _, _) | VoidExpr(_, _) | CooperativeCheckpointExpr(_, _) | ClosureCreateExpr(_, _, _) | DetachExpr(_, _, _) | BreakExpr(_, _) | ContinueExpr(_, _) | SetAllocExpr(_, _, _):
			pending
		DebugBlockExpr(body, _, _) | UnaryExpr(_, body, _, _) | CastExpr(body, _, _) | UnboxExpr(_, body, _, _) | FieldExpr(body, _, _, _) | TupleFieldExpr(body, _, _, _) | PreClosureDetachExpr(body, _, _):
			MoreDceExpr(body, pending)
		BinaryExpr(_, left, right, _, _) | LogicalExpr(_, left, right, _, _) | SeqExpr(left, right):
			MoreDceExpr(
				left,
				MoreDceExpr(right, pending),
			)
		LetExpr(_, _, _, rhs, body) | BorrowLetExpr(_, _, rhs, body):
			MoreDceExpr(
				rhs,
				MoreDceExpr(body, pending),
			)
		AssignExpr(_, rhs, _, _):
			MoreDceExpr(rhs, pending)
		DupExpr(_, _, _, body, _, _) | DropExpr(_, _, _, body, _, _):
			MoreDceExpr(body, pending)
		_:
			children: List[CoreExpr] = CoreTraverse.immediate_core_expr_children(expr)
			var updated: DceExprStack = pending
			var index: Int = children.length() - 1

			while index >= 0:
				match children.get(index):
					Some(child):
						updated = MoreDceExpr(child, updated)
					None:
						void

				index -= 1

			updated


-- Perceus needs every exact occurrence, including effects, but not DCE's
-- deduplicated read sets or reachability facts. Keeping that narrower contract
-- explicit avoids allocating the full facts record and identity indexes while
-- preserving source-order occurrence counts.
pure func resolved_value_occurrences(expr: CoreExpr) -> List[CoreVar]:
	var pending: DceExprStack = MoreDceExpr(expr, NoDceExpr)
	var occurrences: List[CoreVar] = []
	var complete: Bool = False

	while not complete:
		match pending:
			NoDceExpr:
				complete = True
			MoreDceExpr(current, remaining):
				pending = remaining

				occurrences = match current:
					VarExpr(variable, _, _):
						append_resolved_value_occurrence(occurrences, variable)
					AssignExpr(variable, _, _, _):
						append_resolved_value_occurrence(occurrences, variable)
					TensorRawReadExpr(read, _, _):
						append_resolved_value_occurrence(occurrences, read.view)
					TensorRawWriteExpr(write, _, _):
						append_resolved_value_occurrence(occurrences, write.view)
					DupExpr(variable, _, _, _, _, _):
						append_resolved_value_occurrence(occurrences, variable)
					DropExpr(variable, _, _, _, _, _):
						append_resolved_value_occurrence(occurrences, variable)
					_:
						occurrences

				pending = push_value_occurrence_children(pending, current)

	occurrences


pure func value_references(expr: CoreExpr) -> CoreValueReferences:
	facts: DceFacts = collect_expr(
		{
			mode = CollectValueReferences,
			function_ids = [],
			function_names = [],
			constructor_references = [],
			global_names = [],
			global_names_seen = {},
			value_reads = [],
			value_read_def_ids_by_uniq_by_name = {},
			value_invalidations = [],
			value_invalidation_def_ids_by_uniq_by_name = {},
			value_reference_occurrences = [],
			type_names = [],
			fail_closed = False
		},
		expr,
	)

	{
		names = facts.global_names,
		resolved_reads = facts.value_reads,
		resolved_invalidations = facts.value_invalidations,
		resolved_occurrences = facts.value_reference_occurrences
	}


private pure func function_is_prunable(function_info: CoreFunction) -> Bool:
	match function_info.function_kind:
		UserFunction:
			True
		ClosureBodyFunction(abi):
			True
		BuiltinFunction(c_name):
			False
		UnresolvedBuiltinFunction:
			False
		ForeignFunction(_):
			False


record DceReachabilityIndex {
	functions_by_id: Dict[Int, List[CoreFunction]],
	function_ids_by_name: Dict[String, List[Int]],
	constructors_by_name: Dict[String, List[DceConstructorIdentity]],
	globals_by_name: Dict[String, CoreGlobal],
	type_decls_by_name: Dict[String, List[CoreDecl]]
}


private pure func function_facts_for_id(
	index: DceReachabilityIndex,
	def_id: Int,
) -> Option[DceFacts]:
	var facts: DceFacts = {
		mode = CollectReachabilityFacts,
		function_ids = [],
		function_names = [],
		constructor_references = [],
		global_names = [],
		global_names_seen = {},
		value_reads = [],
		value_read_def_ids_by_uniq_by_name = {},
		value_invalidations = [],
		value_invalidation_def_ids_by_uniq_by_name = {},
		value_reference_occurrences = [],
		type_names = [],
		fail_closed = False
	}

	for function_info in (
		index.functions_by_id
			.get(def_id)
			.get_or([])
	):
		match function_info.body:
			Some(body):
				facts = collect_expr(facts, body)
			None:
				void

	if index.functions_by_id.contains(def_id):
		Some(facts)
	else:
		None


private pure func compiler_core_dce_type_decl_name(decl: CoreDecl) -> Option[String]:
	match decl:
		EnumDecl(enum_info):
			Some(enum_info.name)
		UnionDecl(union_info):
			Some(union_info.name)
		ValueRecordDecl(record_info):
			Some(record_info.name)
		HeapRecordDecl(record_info):
			Some(record_info.name)
		TypeAliasDecl(alias_info):
			Some(alias_info.name)
		_:
			None


private pure func add_constructor_identity(
	constructors_by_name: Dict[String, List[DceConstructorIdentity]],
	name: String,
	parent_type_name: String,
	def_id: Int,
) -> Dict[String, List[DceConstructorIdentity]]:
	constructors_by_name.set(
		name,
		constructors_by_name
			.get(name)
			.get_or([])
			.append({
				parent_type_name = parent_type_name,
				def_id = def_id,
			}),
	)


private pure func add_type_decl(
	type_decls_by_name: Dict[String, List[CoreDecl]],
	decl: CoreDecl,
) -> Dict[String, List[CoreDecl]]:
	match compiler_core_dce_type_decl_name(decl):
		Some(name):
			type_decls_by_name.set(
				name,
				type_decls_by_name
					.get(name)
					.get_or([])
					.append(decl),
			)
		None:
			type_decls_by_name


private pure func build_reachability_index(program_value: CoreProgram) -> DceReachabilityIndex:
	var functions_by_id: Dict[Int, List[CoreFunction]] = {}
	var function_ids_by_name: Dict[String, List[Int]] = {}
	var constructors_by_name: Dict[String, List[DceConstructorIdentity]] = {}
	var globals_by_name: Dict[String, CoreGlobal] = {}
	var type_decls_by_name: Dict[String, List[CoreDecl]] = {}

	for decl in program_value.decls:
		match decl:
			FunctionDecl(function_info):
				functions_by_id = functions_by_id.set(
					function_info.def_id,
					functions_by_id
						.get(function_info.def_id)
						.get_or([])
						.append(function_info),
				)
				function_ids_by_name = function_ids_by_name.set(
					function_info.name,
					function_ids_by_name
						.get(function_info.name)
						.get_or([])
						.append(function_info.def_id),
				)
			GlobalDecl(global):
				-- Preserve the original first-declaration lookup behavior.
				if not globals_by_name.contains(global.name.name):
					globals_by_name = globals_by_name.set(global.name.name, global)
			EnumDecl(enum_info):
				for variant in enum_info.variants:
					match variant.def_id:
						Some(def_id):
							constructors_by_name = add_constructor_identity(
								constructors_by_name,
								variant.name,
								enum_info.name,
								def_id,
							)
						None:
							void

				type_decls_by_name = add_type_decl(type_decls_by_name, decl)
			UnionDecl(union_info):
				for variant in union_info.variants:
					match variant.def_id:
						Some(def_id):
							constructors_by_name = add_constructor_identity(
								constructors_by_name,
								variant.name,
								union_info.name,
								def_id,
							)
						None:
							void

				type_decls_by_name = add_type_decl(type_decls_by_name, decl)
			_:
				type_decls_by_name = add_type_decl(type_decls_by_name, decl)

	{
		functions_by_id = functions_by_id,
		function_ids_by_name = function_ids_by_name,
		constructors_by_name = constructors_by_name,
		globals_by_name = globals_by_name,
		type_decls_by_name = type_decls_by_name
	}


record DceRoots {
	reachable: List[Int],
	reachable_globals: List[String],
	fail_closed: Bool,
	saw_main: Bool
}


private pure func collect_roots(
	program_value: CoreProgram,
	functions: List[CoreFunction],
) -> DceRoots:
	var reachable: List[Int] = []
	var reachable_globals: List[String] = []
	var fail_closed: Bool = False
	var saw_main: Bool = False
	var globals: List[CoreGlobal] = []

	for decl in program_value.decls:
		match decl:
			GlobalDecl(global):
				globals = globals.append(global)
			_:
				void

	for function_info in functions:
		if function_info.name == "main" and function_info.source_module.is_none():
			saw_main = True

			if not reachable.contains(function_info.def_id):
				reachable = reachable.append(function_info.def_id)
		else if not function_is_prunable(function_info):
			if not reachable.contains(function_info.def_id):
				reachable = reachable.append(function_info.def_id)

	for global in globals:
		if not global.is_private and not reachable_globals.contains(global.name.name):
			reachable_globals = reachable_globals.append(global.name.name)

	{
		reachable = reachable,
		reachable_globals = reachable_globals,
		fail_closed = fail_closed,
		saw_main = saw_main
	}


record DceClosure {
	reachable: List[Int],
	reachable_globals: List[String],
	reachable_types: List[String],
	fail_closed: Bool
}


record DceClosureState {
	reachable: List[Int],
	reachable_set: Set[Int],
	reachable_globals: List[String],
	reachable_global_set: Set[String],
	reachable_types: List[String],
	reachable_type_set: Set[String],
	fail_closed: Bool
}


private pure func apply_reachability_facts(
	index: DceReachabilityIndex,
	state: DceClosureState,
	facts: DceFacts,
) -> DceClosureState:
	if facts.fail_closed:
		{ state | fail_closed = True }
	else:
		var reachable = state.reachable
		var reachable_set = state.reachable_set
		var reachable_globals = state.reachable_globals
		var reachable_global_set = state.reachable_global_set
		var reachable_types = state.reachable_types
		var reachable_type_set = state.reachable_type_set

		for def_id in facts.function_ids:
			if not Sets.contains(reachable_set, def_id):
				reachable = reachable.append(def_id)
				reachable_set = Sets.add(reachable_set, def_id)

		for name in facts.function_names:
			for def_id in (
				index.function_ids_by_name
					.get(name)
					.get_or([])
			):
				if not Sets.contains(reachable_set, def_id):
					reachable = reachable.append(def_id)
					reachable_set = Sets.add(reachable_set, def_id)

		for reference in facts.constructor_references:
			for constructor in (
				index.constructors_by_name
					.get(reference.name)
					.get_or([])
			):
				if (
					constructor.def_id == reference.def_id
					and not Sets.contains(reachable_type_set, constructor.parent_type_name)
				):
					reachable_types = reachable_types.append(constructor.parent_type_name)
					reachable_type_set = Sets.add(reachable_type_set, constructor.parent_type_name)
				else:
					void

		for name in facts.global_names:
			if (
				index.globals_by_name.contains(name)
				and not Sets.contains(reachable_global_set, name)
			):
				reachable_globals = reachable_globals.append(name)
				reachable_global_set = Sets.add(reachable_global_set, name)

		for name in facts.type_names:
			if not Sets.contains(reachable_type_set, name):
				reachable_types = reachable_types.append(name)
				reachable_type_set = Sets.add(reachable_type_set, name)

		{
			reachable = reachable,
			reachable_set = reachable_set,
			reachable_globals = reachable_globals,
			reachable_global_set = reachable_global_set,
			reachable_types = reachable_types,
			reachable_type_set = reachable_type_set,
			fail_closed = False
		}


private pure func close_reachability(index: DceReachabilityIndex, roots: DceRoots) -> DceClosure:
	var state: DceClosureState = {
		reachable = roots.reachable,
		reachable_set = Sets.from_list(roots.reachable),
		reachable_globals = roots.reachable_globals,
		reachable_global_set = Sets.from_list(roots.reachable_globals),
		reachable_types = [],
		reachable_type_set = Sets.set(),
		fail_closed = False
	}
	var next_function_index: Int = 0
	var next_global_index: Int = 0

	while (
		not state.fail_closed
		and ((
			next_function_index < state.reachable.length()
			or next_global_index < state.reachable_globals.length()
		))
	):
		if next_function_index < state.reachable.length():
			match state.reachable.get(next_function_index):
				Some(def_id):
					next_function_index += 1

					match function_facts_for_id(index, def_id):
						Some(facts):
							state = apply_reachability_facts(index, state, facts)
						None:
							void
				None:
					next_function_index += 1
		else:
			match state.reachable_globals.get(next_global_index):
				Some(name):
					next_global_index += 1

					match index.globals_by_name.get(name):
						Some(global):
							facts: DceFacts = collect_expr(
								{
									mode = CollectReachabilityFacts,
									function_ids = [],
									function_names = [],
									constructor_references = [],
									global_names = [],
									global_names_seen = {},
									value_reads = [],
									value_read_def_ids_by_uniq_by_name = {},
									value_invalidations = [],
									value_invalidation_def_ids_by_uniq_by_name = {},
									value_reference_occurrences = [],
									type_names = [],
									fail_closed = False
								},
								global.init,
							)
							state = apply_reachability_facts(index, state, facts)
						None:
							void
				None:
					next_global_index += 1

	{
		reachable = state.reachable,
		reachable_globals = state.reachable_globals,
		reachable_types = state.reachable_types,
		fail_closed = state.fail_closed
	}


private pure func function_is_kept(reachable: Set[Int], function_info: CoreFunction) -> Bool:
	not function_is_prunable(function_info) or Sets.contains(reachable, function_info.def_id)


private pure func collect_type_root_facts(
	program_value: CoreProgram,
	reachable: Set[Int],
	reachable_globals: Set[String],
	body_type_names: List[String],
) -> DceFacts:
	var facts: DceFacts = {
		mode = CollectReachabilityFacts,
		function_ids = [],
		function_names = [],
		constructor_references = [],
		global_names = [],
		global_names_seen = {},
		value_reads = [],
		value_read_def_ids_by_uniq_by_name = {},
		value_invalidations = [],
		value_invalidation_def_ids_by_uniq_by_name = {},
		value_reference_occurrences = [],
		type_names = body_type_names,
		fail_closed = False
	}

	for decl in program_value.decls:
		match decl:
			FunctionDecl(function_info):
				if function_is_kept(reachable, function_info):
					facts = collect_type(facts, function_info.return_type)

					for param in function_info.params:
						facts = collect_type(facts, param.typ)
			GlobalDecl(global):
				if not global.is_private or Sets.contains(reachable_globals, global.name.name):
					facts = collect_type(facts, global.typ)
			_:
				void

	facts


private pure func collect_decl_type_dependencies(facts: DceFacts, decl: CoreDecl) -> DceFacts:
	match decl:
		UnionDecl(union_info):
			var result: DceFacts = facts

			for variant in union_info.variants:
				for field in variant.fields:
					result = collect_type(result, field.typ)

			result
		ValueRecordDecl(record_info):
			var result: DceFacts = facts

			for field in record_info.fields:
				result = collect_type(result, field.typ)

			result
		HeapRecordDecl(record_info):
			var result: DceFacts = facts

			for field in record_info.fields:
				result = collect_type(result, field.typ)

			result
		TypeAliasDecl(alias_info):
			collect_type(facts, alias_info.target)
		_:
			facts


private pure func close_type_reachability(
	index: DceReachabilityIndex,
	reachable: List[String],
) -> List[String]:
	var result = reachable
	var reachable_set: Set[String] = Sets.from_list(reachable)
	var next_index: Int = 0

	while next_index < result.length():
		match result.get(next_index):
			Some(name):
				next_index += 1
				var facts: DceFacts = {
					mode = CollectReachabilityFacts,
					function_ids = [],
					function_names = [],
					constructor_references = [],
					global_names = [],
					global_names_seen = {},
					value_reads = [],
					value_read_def_ids_by_uniq_by_name = {},
					value_invalidations = [],
					value_invalidation_def_ids_by_uniq_by_name = {},
					value_reference_occurrences = [],
					type_names = [],
					fail_closed = False
				}

				for decl in (
					index.type_decls_by_name
						.get(name)
						.get_or([])
				):
					facts = collect_decl_type_dependencies(facts, decl)

				for dependency in facts.type_names:
					if not Sets.contains(reachable_set, dependency):
						result = result.append(dependency)
						reachable_set = Sets.add(reachable_set, dependency)
			None:
				next_index += 1

	result


private pure func keep_decl(
	reachable_functions: Set[Int],
	reachable_globals: Set[String],
	reachable_types: Set[String],
	decl: CoreDecl,
) -> Bool:
	match decl:
		FunctionDecl(function_info):
			function_is_kept(reachable_functions, function_info)
		GlobalDecl(global):
			not global.is_private or Sets.contains(reachable_globals, global.name.name)
		EnumDecl(enum_info):
			Sets.contains(reachable_types, enum_info.name)
		UnionDecl(union_info):
			Sets.contains(reachable_types, union_info.name)
		ValueRecordDecl(record_info):
			Sets.contains(reachable_types, record_info.name)
		HeapRecordDecl(record_info):
			Sets.contains(reachable_types, record_info.name)
		TypeAliasDecl(alias_decl):
			True
		TraitDecl(trait_decl):
			True
		ImplDecl(impl_decl):
			True


pure func prune_program(program_value: CoreProgram) -> CoreProgram:
	functions: List[CoreFunction] = program_value.decls.filter_map(func(decl):
		match decl:
			FunctionDecl(function_info):
				Some(function_info)
			_:
				None
	)
	roots: DceRoots = collect_roots(program_value, functions)

	if roots.fail_closed or not roots.saw_main:
		program_value
	else:
		index = build_reachability_index(program_value)
		closure: DceClosure = close_reachability(index, roots)

		if closure.fail_closed:
			program_value
		else:
			reachable_functions: Set[Int] = Sets.from_list(closure.reachable)
			reachable_globals: Set[String] = Sets.from_list(closure.reachable_globals)
			type_facts: DceFacts = collect_type_root_facts(
				program_value,
				reachable_functions,
				reachable_globals,
				closure.reachable_types,
			)
			reachable_types: List[String] = close_type_reachability(index, type_facts.type_names)
			reachable_type_set: Set[String] = Sets.from_list(reachable_types)
			{ program_value |
				decls = program_value.decls.filter(
					func(
						decl,
					): keep_decl(reachable_functions, reachable_globals, reachable_type_set, decl),
				)
			}
