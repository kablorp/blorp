-- Post-monomorphization Core body synthesis for std/string.
--
-- String algorithms remain ordinary Core so ownership insertion and later
-- optimizations see their bounds checks, loops, allocation, and mutation.
import:
	core_json:
		CoreBinaryOp(
			AddOp,
			DivideOp,
			EqualOp,
			GreaterEqualOp,
			GreaterOp,
			LessEqualOp,
			LessOp,
			MultiplyOp,
			NotEqualOp,
			SubtractOp,
		),
		CoreCallKind(IntrinsicCall),
		CoreExpr(
			AssignExpr,
			BinaryExpr,
			BreakExpr,
			CallExpr,
			ForRangeExpr,
			IfExpr,
			LetExpr,
			LiteralExpr,
			LogicalExpr,
			SeqExpr,
			VarExpr,
			VoidExpr,
			WhileExpr,
		),
		CoreFunction,
		CoreLiteral(BoolLiteral, IntLiteral),
		CoreLogicalOp(AndOp, OrOp),
		CoreLoopBinder,
		CoreLoopRangeDirection(RangeForwardOnly),
		CoreParam,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType, VoidType),
		CoreVar,
	core_synth_name: is_synthesis_candidate, synthesis_source_name


private STRING_MODULE: String = "std/string"

private INT_TYPE: CoreType = NamedType("Int", [])

private BOOL_TYPE: CoreType = NamedType("Bool", [])

private STRING_TYPE: CoreType = NamedType("String", [])

private SPLIT_SINGLE_BYTE_FIND_MIN_LENGTH: Int = 256


private pure func core_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


private pure func variable(name: String, typ: CoreType) -> CoreExpr:
	VarExpr(core_var(name), typ, SyntheticSourceLoc)


private pure func parameter_value(parameter: CoreParam) -> CoreExpr:
	VarExpr(parameter.name, parameter.typ, SyntheticSourceLoc)


private pure func int_literal(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), INT_TYPE, SyntheticSourceLoc)


private pure func bool_literal(value: Bool) -> CoreExpr:
	LiteralExpr(BoolLiteral(value), BOOL_TYPE, SyntheticSourceLoc)


private VOID_EXPR: CoreExpr = VoidExpr(VoidType, SyntheticSourceLoc)


private pure func intrinsic_call(
	name: String,
	args: List[CoreExpr],
	return_type: CoreType,
) -> CoreExpr:
	CallExpr(IntrinsicCall(name), VOID_EXPR, args, return_type, SyntheticSourceLoc)


private pure func binary(
	op: CoreBinaryOp,
	left: CoreExpr,
	right: CoreExpr,
	return_type: CoreType,
) -> CoreExpr:
	BinaryExpr(op, left, right, return_type, SyntheticSourceLoc)


private pure func logical(op: CoreLogicalOp, left: CoreExpr, right: CoreExpr) -> CoreExpr:
	LogicalExpr(op, left, right, BOOL_TYPE, SyntheticSourceLoc)


private pure func let_expr(
	name: String,
	is_mutable: Bool,
	typ: CoreType,
	rhs: CoreExpr,
	body: CoreExpr,
) -> CoreExpr:
	LetExpr(core_var(name), is_mutable, typ, rhs, body)


private pure func if_expr(
	condition: CoreExpr,
	then_expr: CoreExpr,
	else_expr: CoreExpr,
	return_type: CoreType,
) -> CoreExpr:
	IfExpr(condition, then_expr, else_expr, return_type, SyntheticSourceLoc)


private pure func assignment(name: String, value: CoreExpr) -> CoreExpr:
	AssignExpr(core_var(name), value, VoidType, SyntheticSourceLoc)


private pure func while_loop(condition: CoreExpr, body: CoreExpr) -> CoreExpr:
	WhileExpr(condition, body, VoidType, SyntheticSourceLoc)


private pure func loop_binder(name: String) -> CoreLoopBinder:
	{
		variable = core_var(name),
		typ = INT_TYPE,
		range_direction = RangeForwardOnly
	}


private pure func for_range(
	name: String,
	start: CoreExpr,
	end_value: CoreExpr,
	body: CoreExpr,
) -> CoreExpr:
	ForRangeExpr(loop_binder(name), start, end_value, body, VoidType, SyntheticSourceLoc)


private pure func type_is_named(typ: CoreType, expected: String) -> Bool:
	match typ:
		NamedType(name, args):
			name == expected and args.is_empty()
		_:
			False


private pure func type_is_list_string(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			match args:
				[inner]:
					name == "List" and type_is_named(inner, "String")
				_:
					False
		_:
			False


private pure func param_is_named(params: List[CoreParam], index: Int, expected: String) -> Bool:
	match params.get(index):
		Some(parameter):
			type_is_named(parameter.typ, expected)
		None:
			False


private pure func string_length(value: CoreExpr) -> CoreExpr:
	intrinsic_call("string_len", [value], INT_TYPE)


private pure func string_byte(value: CoreExpr, index: CoreExpr) -> CoreExpr:
	intrinsic_call(
		"string_get_byte",
		[value, index],
		INT_TYPE,
	)


private pure func set_string_byte(
	result_name: String,
	index: CoreExpr,
	value: CoreExpr,
) -> CoreExpr:
	intrinsic_call(
		"string_set_byte",
		[variable(result_name, STRING_TYPE), index, value],
		VoidType,
	)


private pure func set_string_length(result_name: String, length: CoreExpr) -> CoreExpr:
	intrinsic_call(
		"string_set_len",
		[variable(result_name, STRING_TYPE), length],
		VoidType,
	)


private pure func copy_string_bytes(
	result_name: String,
	result_offset: CoreExpr,
	source: CoreExpr,
	source_offset: CoreExpr,
	length: CoreExpr,
) -> CoreExpr:
	intrinsic_call(
		"string_copy_bytes",
		[variable(result_name, STRING_TYPE), result_offset, source, source_offset, length],
		VoidType,
	)


private pure func copied_string(
	result_name: String,
	source: CoreExpr,
	start: CoreExpr,
	length: CoreExpr,
) -> CoreExpr:
	let_expr(
		result_name,
		False,
		STRING_TYPE,
		intrinsic_call("string_alloc", [length], STRING_TYPE),
		SeqExpr(
			copy_string_bytes(result_name, int_literal(0), source, start, length),
			SeqExpr(
				set_string_length(result_name, length),
				variable(result_name, STRING_TYPE),
			),
		),
	)


private pure func min_int(left: CoreExpr, right: CoreExpr) -> CoreExpr:
	if_expr(
		binary(LessOp, left, right, BOOL_TYPE),
		left,
		right,
		INT_TYPE,
	)


private pure func clamp_to_length(value: CoreExpr, length: CoreExpr) -> CoreExpr:
	if_expr(
		binary(LessOp, value, int_literal(0), BOOL_TYPE),
		int_literal(0),
		if_expr(
			binary(GreaterOp, value, length, BOOL_TYPE),
			length,
			value,
			INT_TYPE,
		),
		INT_TYPE,
	)


private pure func ascii_whitespace(value: CoreExpr) -> CoreExpr:
	logical(
		OrOp,
		logical(
			OrOp,
			binary(EqualOp, value, int_literal(32), BOOL_TYPE),
			binary(EqualOp, value, int_literal(9), BOOL_TYPE),
		),
		logical(
			OrOp,
			binary(EqualOp, value, int_literal(10), BOOL_TYPE),
			binary(EqualOp, value, int_literal(13), BOOL_TYPE),
		),
	)


private pure func ascii_lower(value: CoreExpr) -> CoreExpr:
	logical(
		AndOp,
		binary(GreaterEqualOp, value, int_literal(97), BOOL_TYPE),
		binary(LessEqualOp, value, int_literal(122), BOOL_TYPE),
	)


private pure func ascii_upper(value: CoreExpr) -> CoreExpr:
	logical(
		AndOp,
		binary(GreaterEqualOp, value, int_literal(65), BOOL_TYPE),
		binary(LessEqualOp, value, int_literal(90), BOOL_TYPE),
	)


private pure func compare_needle_at(
	source: CoreExpr,
	needle: CoreExpr,
	position: CoreExpr,
	needle_length: CoreExpr,
	prefix: String,
) -> CoreExpr:
	match_name: String = prefix + "_match"
	index_name: String = prefix + "_j"

	let_expr(
		match_name,
		True,
		BOOL_TYPE,
		bool_literal(True),
		SeqExpr(
			for_range(
				index_name,
				int_literal(0),
				needle_length,
				if_expr(
					binary(
						NotEqualOp,
						string_byte(
							source,
							binary(
								AddOp,
								position,
								variable(index_name, INT_TYPE),
								INT_TYPE,
							),
						),
						string_byte(
							needle,
							variable(index_name, INT_TYPE),
						),
						BOOL_TYPE,
					),
					SeqExpr(
						assignment(match_name, bool_literal(False)),
						BreakExpr(VoidType, SyntheticSourceLoc),
					),
					VOID_EXPR,
					VoidType,
				),
			),
			variable(match_name, BOOL_TYPE),
		),
	)


private pure func synthesize_substring(
	source: CoreExpr,
	start: CoreExpr,
	requested_length: CoreExpr,
) -> CoreExpr:
	let_expr(
		"__substring_slen",
		False,
		INT_TYPE,
		string_length(source),
		let_expr(
			"__substring_start",
			False,
			INT_TYPE,
			clamp_to_length(
				start,
				variable("__substring_slen", INT_TYPE),
			),
			let_expr(
				"__substring_len",
				False,
				INT_TYPE,
				if_expr(
					binary(LessEqualOp, requested_length, int_literal(0), BOOL_TYPE),
					int_literal(0),
					if_expr(
						binary(
							GreaterOp,
							binary(
								AddOp,
								variable("__substring_start", INT_TYPE),
								requested_length,
								INT_TYPE,
							),
							variable("__substring_slen", INT_TYPE),
							BOOL_TYPE,
						),
						binary(
							SubtractOp,
							variable("__substring_slen", INT_TYPE),
							variable("__substring_start", INT_TYPE),
							INT_TYPE,
						),
						requested_length,
						INT_TYPE,
					),
					INT_TYPE,
				),
				copied_string(
					"__substring_result",
					source,
					variable("__substring_start", INT_TYPE),
					variable("__substring_len", INT_TYPE),
				),
			),
		),
	)


private pure func synthesize_starts_with(source: CoreExpr, prefix: CoreExpr) -> CoreExpr:
	let_expr(
		"__starts_source_len",
		False,
		INT_TYPE,
		string_length(source),
		let_expr(
			"__starts_prefix_len",
			False,
			INT_TYPE,
			string_length(prefix),
			if_expr(
				binary(
					GreaterOp,
					variable("__starts_prefix_len", INT_TYPE),
					variable("__starts_source_len", INT_TYPE),
					BOOL_TYPE,
				),
				bool_literal(False),
				compare_needle_at(
					source,
					prefix,
					int_literal(0),
					variable("__starts_prefix_len", INT_TYPE),
					"__starts",
				),
				BOOL_TYPE,
			),
		),
	)


private pure func synthesize_ends_with(source: CoreExpr, suffix: CoreExpr) -> CoreExpr:
	let_expr(
		"__ends_source_len",
		False,
		INT_TYPE,
		string_length(source),
		let_expr(
			"__ends_suffix_len",
			False,
			INT_TYPE,
			string_length(suffix),
			if_expr(
				binary(
					GreaterOp,
					variable("__ends_suffix_len", INT_TYPE),
					variable("__ends_source_len", INT_TYPE),
					BOOL_TYPE,
				),
				bool_literal(False),
				compare_needle_at(
					source,
					suffix,
					binary(
						SubtractOp,
						variable("__ends_source_len", INT_TYPE),
						variable("__ends_suffix_len", INT_TYPE),
						INT_TYPE,
					),
					variable("__ends_suffix_len", INT_TYPE),
					"__ends",
				),
				BOOL_TYPE,
			),
		),
	)


private pure func synthesize_contains(source: CoreExpr, needle: CoreExpr) -> CoreExpr:
	let_expr(
		"__contains_slen",
		False,
		INT_TYPE,
		string_length(source),
		let_expr(
			"__contains_nlen",
			False,
			INT_TYPE,
			string_length(needle),
			if_expr(
				binary(
					EqualOp,
					variable("__contains_nlen", INT_TYPE),
					int_literal(0),
					BOOL_TYPE,
				),
				bool_literal(True),
				if_expr(
					binary(
						GreaterOp,
						variable("__contains_nlen", INT_TYPE),
						variable("__contains_slen", INT_TYPE),
						BOOL_TYPE,
					),
					bool_literal(False),
					let_expr(
						"__contains_found",
						True,
						BOOL_TYPE,
						bool_literal(False),
						SeqExpr(
							for_range(
								"__contains_i",
								int_literal(0),
								binary(
									AddOp,
									binary(
										SubtractOp,
										variable("__contains_slen", INT_TYPE),
										variable("__contains_nlen", INT_TYPE),
										INT_TYPE,
									),
									int_literal(1),
									INT_TYPE,
								),
								if_expr(
									compare_needle_at(
										source,
										needle,
										variable("__contains_i", INT_TYPE),
										variable("__contains_nlen", INT_TYPE),
										"__contains_at",
									),
									SeqExpr(
										assignment("__contains_found", bool_literal(True)),
										BreakExpr(VoidType, SyntheticSourceLoc),
									),
									VOID_EXPR,
									VoidType,
								),
							),
							variable("__contains_found", BOOL_TYPE),
						),
					),
					BOOL_TYPE,
				),
				BOOL_TYPE,
			),
		),
	)


private pure func synthesize_raw_index_of(source: CoreExpr, needle: CoreExpr) -> CoreExpr:
	let_expr(
		"__index_slen",
		False,
		INT_TYPE,
		string_length(source),
		let_expr(
			"__index_nlen",
			False,
			INT_TYPE,
			string_length(needle),
			if_expr(
				binary(
					EqualOp,
					variable("__index_nlen", INT_TYPE),
					int_literal(0),
					BOOL_TYPE,
				),
				int_literal(0),
				if_expr(
					binary(
						GreaterOp,
						variable("__index_nlen", INT_TYPE),
						variable("__index_slen", INT_TYPE),
						BOOL_TYPE,
					),
					int_literal(-1),
					let_expr(
						"__index_position",
						True,
						INT_TYPE,
						int_literal(-1),
						SeqExpr(
							for_range(
								"__index_i",
								int_literal(0),
								binary(
									AddOp,
									binary(
										SubtractOp,
										variable("__index_slen", INT_TYPE),
										variable("__index_nlen", INT_TYPE),
										INT_TYPE,
									),
									int_literal(1),
									INT_TYPE,
								),
								if_expr(
									compare_needle_at(
										source,
										needle,
										variable("__index_i", INT_TYPE),
										variable("__index_nlen", INT_TYPE),
										"__index_at",
									),
									SeqExpr(
										assignment(
											"__index_position",
											variable("__index_i", INT_TYPE),
										),
										BreakExpr(VoidType, SyntheticSourceLoc),
									),
									VOID_EXPR,
									VoidType,
								),
							),
							variable("__index_position", INT_TYPE),
						),
					),
					INT_TYPE,
				),
				INT_TYPE,
			),
		),
	)


private pure func synthesize_raw_last_index_of(source: CoreExpr, needle: CoreExpr) -> CoreExpr:
	let_expr(
		"__last_slen",
		False,
		INT_TYPE,
		string_length(source),
		let_expr(
			"__last_nlen",
			False,
			INT_TYPE,
			string_length(needle),
			if_expr(
				binary(
					EqualOp,
					variable("__last_nlen", INT_TYPE),
					int_literal(0),
					BOOL_TYPE,
				),
				variable("__last_slen", INT_TYPE),
				if_expr(
					binary(
						GreaterOp,
						variable("__last_nlen", INT_TYPE),
						variable("__last_slen", INT_TYPE),
						BOOL_TYPE,
					),
					int_literal(-1),
					let_expr(
						"__last_position",
						True,
						INT_TYPE,
						binary(
							SubtractOp,
							variable("__last_slen", INT_TYPE),
							variable("__last_nlen", INT_TYPE),
							INT_TYPE,
						),
						let_expr(
							"__last_result",
							True,
							INT_TYPE,
							int_literal(-1),
							SeqExpr(
								while_loop(
									binary(
										GreaterEqualOp,
										variable("__last_position", INT_TYPE),
										int_literal(0),
										BOOL_TYPE,
									),
									if_expr(
										compare_needle_at(
											source,
											needle,
											variable("__last_position", INT_TYPE),
											variable("__last_nlen", INT_TYPE),
											"__last_at",
										),
										SeqExpr(
											assignment(
												"__last_result",
												variable("__last_position", INT_TYPE),
											),
											BreakExpr(VoidType, SyntheticSourceLoc),
										),
										assignment(
											"__last_position",
											binary(
												SubtractOp,
												variable("__last_position", INT_TYPE),
												int_literal(1),
												INT_TYPE,
											),
										),
										VoidType,
									),
								),
								variable("__last_result", INT_TYPE),
							),
						),
					),
					INT_TYPE,
				),
				INT_TYPE,
			),
		),
	)


private pure func synthesize_count(source: CoreExpr, needle: CoreExpr) -> CoreExpr:
	let_expr(
		"__count_slen",
		False,
		INT_TYPE,
		string_length(source),
		let_expr(
			"__count_nlen",
			False,
			INT_TYPE,
			string_length(needle),
			if_expr(
				logical(
					OrOp,
					binary(
						EqualOp,
						variable("__count_nlen", INT_TYPE),
						int_literal(0),
						BOOL_TYPE,
					),
					binary(
						GreaterOp,
						variable("__count_nlen", INT_TYPE),
						variable("__count_slen", INT_TYPE),
						BOOL_TYPE,
					),
				),
				int_literal(0),
				let_expr(
					"__count_result",
					True,
					INT_TYPE,
					int_literal(0),
					let_expr(
						"__count_position",
						True,
						INT_TYPE,
						int_literal(0),
						SeqExpr(
							while_loop(
								binary(
									LessEqualOp,
									binary(
										AddOp,
										variable("__count_position", INT_TYPE),
										variable("__count_nlen", INT_TYPE),
										INT_TYPE,
									),
									variable("__count_slen", INT_TYPE),
									BOOL_TYPE,
								),
								if_expr(
									compare_needle_at(
										source,
										needle,
										variable("__count_position", INT_TYPE),
										variable("__count_nlen", INT_TYPE),
										"__count_at",
									),
									SeqExpr(
										assignment(
											"__count_result",
											binary(
												AddOp,
												variable("__count_result", INT_TYPE),
												int_literal(1),
												INT_TYPE,
											),
										),
										assignment(
											"__count_position",
											binary(
												AddOp,
												variable("__count_position", INT_TYPE),
												variable("__count_nlen", INT_TYPE),
												INT_TYPE,
											),
										),
									),
									assignment(
										"__count_position",
										binary(
											AddOp,
											variable("__count_position", INT_TYPE),
											int_literal(1),
											INT_TYPE,
										),
									),
									VoidType,
								),
							),
							variable("__count_result", INT_TYPE),
						),
					),
				),
				INT_TYPE,
			),
		),
	)


private pure func synthesize_replace(
	source: CoreExpr,
	old: CoreExpr,
	replacement: CoreExpr,
) -> CoreExpr:
	-- Count non-overlapping matches before allocating the exact output size.
	-- The fill pass then writes either a replacement or one unmatched byte.
	let_expr(
		"__replace_slen",
		False,
		INT_TYPE,
		string_length(source),
		let_expr(
			"__replace_old_len",
			False,
			INT_TYPE,
			string_length(old),
			if_expr(
				binary(
					EqualOp,
					variable("__replace_old_len", INT_TYPE),
					int_literal(0),
					BOOL_TYPE,
				),
				source,
				let_expr(
					"__replace_new_len",
					False,
					INT_TYPE,
					string_length(replacement),
					let_expr(
						"__replace_match_count",
						True,
						INT_TYPE,
						int_literal(0),
						let_expr(
							"__replace_count_pos",
							True,
							INT_TYPE,
							int_literal(0),
							SeqExpr(
								while_loop(
									binary(
										LessEqualOp,
										binary(
											AddOp,
											variable("__replace_count_pos", INT_TYPE),
											variable("__replace_old_len", INT_TYPE),
											INT_TYPE,
										),
										variable("__replace_slen", INT_TYPE),
										BOOL_TYPE,
									),
									if_expr(
										compare_needle_at(
											source,
											old,
											variable("__replace_count_pos", INT_TYPE),
											variable("__replace_old_len", INT_TYPE),
											"__replace_count",
										),
										SeqExpr(
											assignment(
												"__replace_match_count",
												binary(
													AddOp,
													variable("__replace_match_count", INT_TYPE),
													int_literal(1),
													INT_TYPE,
												),
											),
											assignment(
												"__replace_count_pos",
												binary(
													AddOp,
													variable("__replace_count_pos", INT_TYPE),
													variable("__replace_old_len", INT_TYPE),
													INT_TYPE,
												),
											),
										),
										assignment(
											"__replace_count_pos",
											binary(
												AddOp,
												variable("__replace_count_pos", INT_TYPE),
												int_literal(1),
												INT_TYPE,
											),
										),
										VoidType,
									),
								),
								if_expr(
									binary(
										EqualOp,
										variable("__replace_match_count", INT_TYPE),
										int_literal(0),
										BOOL_TYPE,
									),
									source,
									let_expr(
										"__replace_out_len",
										False,
										INT_TYPE,
										binary(
											AddOp,
											variable("__replace_slen", INT_TYPE),
											binary(
												MultiplyOp,
												variable("__replace_match_count", INT_TYPE),
												binary(
													SubtractOp,
													variable("__replace_new_len", INT_TYPE),
													variable("__replace_old_len", INT_TYPE),
													INT_TYPE,
												),
												INT_TYPE,
											),
											INT_TYPE,
										),
										let_expr(
											"__replace_result",
											False,
											STRING_TYPE,
											intrinsic_call(
												"string_alloc",
												[variable("__replace_out_len", INT_TYPE)],
												STRING_TYPE,
											),
											let_expr(
												"__replace_in_pos",
												True,
												INT_TYPE,
												int_literal(0),
												let_expr(
													"__replace_out_pos",
													True,
													INT_TYPE,
													int_literal(0),
													SeqExpr(
														while_loop(
															binary(
																LessOp,
																variable(
																	"__replace_in_pos",
																	INT_TYPE,
																),
																variable(
																	"__replace_slen",
																	INT_TYPE,
																),
																BOOL_TYPE,
															),
															if_expr(
																logical(
																	AndOp,
																	binary(
																		LessEqualOp,
																		binary(
																			AddOp,
																			variable(
																				"__replace_in_pos",
																				INT_TYPE,
																			),
																			variable(
																				"__replace_old_len",
																				INT_TYPE,
																			),
																			INT_TYPE,
																		),
																		variable(
																			"__replace_slen",
																			INT_TYPE,
																		),
																		BOOL_TYPE,
																	),
																	compare_needle_at(
																		source,
																		old,
																		variable(
																			"__replace_in_pos",
																			INT_TYPE,
																		),
																		variable(
																			"__replace_old_len",
																			INT_TYPE,
																		),
																		"__replace_fill",
																	),
																),
																SeqExpr(
																	copy_string_bytes(
																		"__replace_result",
																		variable(
																			"__replace_out_pos",
																			INT_TYPE,
																		),
																		replacement,
																		int_literal(0),
																		variable(
																			"__replace_new_len",
																			INT_TYPE,
																		),
																	),
																	SeqExpr(
																		assignment(
																			"__replace_in_pos",
																			binary(
																				AddOp,
																				variable(
																					"__replace_in_pos",
																					INT_TYPE,
																				),
																				variable(
																					"__replace_old_len",
																					INT_TYPE,
																				),
																				INT_TYPE,
																			),
																		),
																		assignment(
																			"__replace_out_pos",
																			binary(
																				AddOp,
																				variable(
																					"__replace_out_pos",
																					INT_TYPE,
																				),
																				variable(
																					"__replace_new_len",
																					INT_TYPE,
																				),
																				INT_TYPE,
																			),
																		),
																	),
																),
																SeqExpr(
																	set_string_byte(
																		"__replace_result",
																		variable(
																			"__replace_out_pos",
																			INT_TYPE,
																		),
																		string_byte(
																			source,
																			variable(
																				"__replace_in_pos",
																				INT_TYPE,
																			),
																		),
																	),
																	SeqExpr(
																		assignment(
																			"__replace_in_pos",
																			binary(
																				AddOp,
																				variable(
																					"__replace_in_pos",
																					INT_TYPE,
																				),
																				int_literal(1),
																				INT_TYPE,
																			),
																		),
																		assignment(
																			"__replace_out_pos",
																			binary(
																				AddOp,
																				variable(
																					"__replace_out_pos",
																					INT_TYPE,
																				),
																				int_literal(1),
																				INT_TYPE,
																			),
																		),
																	),
																),
																VoidType,
															),
														),
														SeqExpr(
															set_string_length(
																"__replace_result",
																variable(
																	"__replace_out_len",
																	INT_TYPE,
																),
															),
															variable(
																"__replace_result",
																STRING_TYPE,
															),
														),
													),
												),
											),
										),
									),
									STRING_TYPE,
								),
							),
						),
					),
				),
				STRING_TYPE,
			),
		),
	)


private pure func store_split_segment(
	source: CoreExpr,
	start: CoreExpr,
	length: CoreExpr,
	index: CoreExpr,
	result_type: CoreType,
	name: String,
) -> CoreExpr:
	intrinsic_call(
		"list_set_owned",
		[
			variable("__split_result", result_type),
			index,
			copied_string(name, source, start, length),
		],
		VoidType,
	)


private pure func split_delimiter_fits(position: CoreExpr) -> CoreExpr:
	binary(
		LessEqualOp,
		binary(
			AddOp,
			position,
			variable("__split_dlen", INT_TYPE),
			INT_TYPE,
		),
		variable("__split_slen", INT_TYPE),
		BOOL_TYPE,
	)


private pure func increment_split_variable(name: String, amount: CoreExpr) -> CoreExpr:
	assignment(
		name,
		binary(
			AddOp,
			variable(name, INT_TYPE),
			amount,
			INT_TYPE,
		),
	)


private pure func split_general_count_loop(source: CoreExpr, delimiter: CoreExpr) -> CoreExpr:
	while_loop(
		split_delimiter_fits(variable("__split_count_pos", INT_TYPE)),
		if_expr(
			compare_needle_at(
				source,
				delimiter,
				variable("__split_count_pos", INT_TYPE),
				variable("__split_dlen", INT_TYPE),
				"__split_count",
			),
			SeqExpr(
				increment_split_variable("__split_part_count", int_literal(1)),
				increment_split_variable(
					"__split_count_pos",
					variable("__split_dlen", INT_TYPE),
				),
			),
			increment_split_variable("__split_count_pos", int_literal(1)),
			VoidType,
		),
	)


private pure func split_single_byte_find_count_loop(source: CoreExpr) -> CoreExpr:
	while_loop(
		binary(
			LessOp,
			variable("__split_count_pos", INT_TYPE),
			variable("__split_slen", INT_TYPE),
			BOOL_TYPE,
		),
		let_expr(
			"__split_found_pos",
			False,
			INT_TYPE,
			intrinsic_call(
				"string_find_byte_from",
				[
					source,
					variable("__split_delim_byte", INT_TYPE),
					variable("__split_count_pos", INT_TYPE),
				],
				INT_TYPE,
			),
			if_expr(
				binary(
					LessOp,
					variable("__split_found_pos", INT_TYPE),
					int_literal(0),
					BOOL_TYPE,
				),
				assignment(
					"__split_count_pos",
					variable("__split_slen", INT_TYPE),
				),
				SeqExpr(
					increment_split_variable("__split_part_count", int_literal(1)),
					assignment(
						"__split_count_pos",
						binary(
							AddOp,
							variable("__split_found_pos", INT_TYPE),
							int_literal(1),
							INT_TYPE,
						),
					),
				),
				VoidType,
			),
		),
	)


private pure func split_single_byte_linear_count_loop(source: CoreExpr) -> CoreExpr:
	while_loop(
		binary(
			LessOp,
			variable("__split_count_pos", INT_TYPE),
			variable("__split_slen", INT_TYPE),
			BOOL_TYPE,
		),
		if_expr(
			binary(
				EqualOp,
				string_byte(
					source,
					variable("__split_count_pos", INT_TYPE),
				),
				variable("__split_delim_byte", INT_TYPE),
				BOOL_TYPE,
			),
			SeqExpr(
				increment_split_variable("__split_part_count", int_literal(1)),
				increment_split_variable("__split_count_pos", int_literal(1)),
			),
			increment_split_variable("__split_count_pos", int_literal(1)),
			VoidType,
		),
	)


private pure func split_count_loop(source: CoreExpr, delimiter: CoreExpr) -> CoreExpr:
	if_expr(
		binary(
			EqualOp,
			variable("__split_dlen", INT_TYPE),
			int_literal(1),
			BOOL_TYPE,
		),
		let_expr(
			"__split_delim_byte",
			False,
			INT_TYPE,
			string_byte(delimiter, int_literal(0)),
			if_expr(
				binary(
					GreaterOp,
					variable("__split_slen", INT_TYPE),
					int_literal(SPLIT_SINGLE_BYTE_FIND_MIN_LENGTH),
					BOOL_TYPE,
				),
				split_single_byte_find_count_loop(source),
				split_single_byte_linear_count_loop(source),
				VoidType,
			),
		),
		split_general_count_loop(source, delimiter),
		VoidType,
	)


private pure func append_current_split_segment(source: CoreExpr, return_type: CoreType) -> CoreExpr:
	let_expr(
		"__split_segment_len",
		False,
		INT_TYPE,
		binary(
			SubtractOp,
			variable("__split_fill_pos", INT_TYPE),
			variable("__split_segment_start", INT_TYPE),
			INT_TYPE,
		),
		SeqExpr(
			store_split_segment(
				source,
				variable("__split_segment_start", INT_TYPE),
				variable("__split_segment_len", INT_TYPE),
				variable("__split_out_index", INT_TYPE),
				return_type,
				"__split_segment",
			),
			SeqExpr(
				increment_split_variable("__split_out_index", int_literal(1)),
				SeqExpr(
					assignment(
						"__split_segment_start",
						binary(
							AddOp,
							variable("__split_fill_pos", INT_TYPE),
							variable("__split_dlen", INT_TYPE),
							INT_TYPE,
						),
					),
					increment_split_variable(
						"__split_fill_pos",
						variable("__split_dlen", INT_TYPE),
					),
				),
			),
		),
	)


private pure func split_single_byte_find_fill_loop(
	source: CoreExpr,
	return_type: CoreType,
) -> CoreExpr:
	while_loop(
		binary(
			LessOp,
			variable("__split_fill_pos", INT_TYPE),
			variable("__split_slen", INT_TYPE),
			BOOL_TYPE,
		),
		let_expr(
			"__split_found_pos",
			False,
			INT_TYPE,
			intrinsic_call(
				"string_find_byte_from",
				[
					source,
					variable("__split_delim_byte", INT_TYPE),
					variable("__split_fill_pos", INT_TYPE),
				],
				INT_TYPE,
			),
			if_expr(
				binary(
					LessOp,
					variable("__split_found_pos", INT_TYPE),
					int_literal(0),
					BOOL_TYPE,
				),
				assignment(
					"__split_fill_pos",
					variable("__split_slen", INT_TYPE),
				),
				SeqExpr(
					assignment(
						"__split_fill_pos",
						variable("__split_found_pos", INT_TYPE),
					),
					append_current_split_segment(source, return_type),
				),
				VoidType,
			),
		),
	)


private pure func split_single_byte_linear_fill_loop(
	source: CoreExpr,
	return_type: CoreType,
) -> CoreExpr:
	while_loop(
		binary(
			LessOp,
			variable("__split_fill_pos", INT_TYPE),
			variable("__split_slen", INT_TYPE),
			BOOL_TYPE,
		),
		if_expr(
			binary(
				EqualOp,
				string_byte(
					source,
					variable("__split_fill_pos", INT_TYPE),
				),
				variable("__split_delim_byte", INT_TYPE),
				BOOL_TYPE,
			),
			append_current_split_segment(source, return_type),
			increment_split_variable("__split_fill_pos", int_literal(1)),
			VoidType,
		),
	)


private pure func split_single_byte_fill_loop(
	source: CoreExpr,
	delimiter: CoreExpr,
	return_type: CoreType,
) -> CoreExpr:
	if_expr(
		binary(
			EqualOp,
			variable("__split_dlen", INT_TYPE),
			int_literal(1),
			BOOL_TYPE,
		),
		let_expr(
			"__split_delim_byte",
			False,
			INT_TYPE,
			string_byte(delimiter, int_literal(0)),
			if_expr(
				binary(
					GreaterOp,
					variable("__split_slen", INT_TYPE),
					int_literal(SPLIT_SINGLE_BYTE_FIND_MIN_LENGTH),
					BOOL_TYPE,
				),
				split_single_byte_find_fill_loop(source, return_type),
				split_single_byte_linear_fill_loop(source, return_type),
				VoidType,
			),
		),
		VOID_EXPR,
		VoidType,
	)


private pure func synthesize_split(
	source: CoreExpr,
	delimiter: CoreExpr,
	return_type: CoreType,
) -> CoreExpr:
	-- Count non-overlapping delimiters before allocating the concrete result
	-- list, then materialize each owned segment directly into its final slot.
	let_expr(
		"__split_slen",
		False,
		INT_TYPE,
		string_length(source),
		let_expr(
			"__split_dlen",
			False,
			INT_TYPE,
			string_length(delimiter),
			if_expr(
				binary(
					EqualOp,
					variable("__split_dlen", INT_TYPE),
					int_literal(0),
					BOOL_TYPE,
				),
				let_expr(
					"__split_result",
					False,
					return_type,
					intrinsic_call(
						"list_alloc",
						[int_literal(1)],
						return_type,
					),
					SeqExpr(
						intrinsic_call(
							"list_retain_for",
							[variable("__split_result", return_type), source],
							VoidType,
						),
						SeqExpr(
							intrinsic_call(
								"list_set",
								[variable("__split_result", return_type), int_literal(0), source],
								VoidType,
							),
							SeqExpr(
								intrinsic_call(
									"list_set_len",
									[variable("__split_result", return_type), int_literal(1)],
									VoidType,
								),
								variable(
									"__split_result",
									return_type,
								),
							),
						),
					),
				),
				let_expr(
					"__split_part_count",
					True,
					INT_TYPE,
					int_literal(1),
					let_expr(
						"__split_count_pos",
						True,
						INT_TYPE,
						int_literal(0),
						SeqExpr(
							split_count_loop(
								source,
								delimiter,
							),
							let_expr(
								"__split_result",
								False,
								return_type,
								intrinsic_call(
									"list_alloc",
									[variable("__split_part_count", INT_TYPE)],
									return_type,
								),
								let_expr(
									"__split_fill_pos",
									True,
									INT_TYPE,
									int_literal(0),
									let_expr(
										"__split_segment_start",
										True,
										INT_TYPE,
										int_literal(0),
										let_expr(
											"__split_out_index",
											True,
											INT_TYPE,
											int_literal(0),
											SeqExpr(
												SeqExpr(
													split_single_byte_fill_loop(
														source,
														delimiter,
														return_type,
													),
													while_loop(
														logical(
															AndOp,
															binary(
																NotEqualOp,
																variable("__split_dlen", INT_TYPE),
																int_literal(1),
																BOOL_TYPE,
															),
															split_delimiter_fits(
																variable(
																	"__split_fill_pos",
																	INT_TYPE,
																),
															),
														),
														if_expr(
															compare_needle_at(
																source,
																delimiter,
																variable(
																	"__split_fill_pos",
																	INT_TYPE,
																),
																variable("__split_dlen", INT_TYPE),
																"__split_fill",
															),
															let_expr(
																"__split_segment_len",
																False,
																INT_TYPE,
																binary(
																	SubtractOp,
																	variable(
																		"__split_fill_pos",
																		INT_TYPE,
																	),
																	variable(
																		"__split_segment_start",
																		INT_TYPE,
																	),
																	INT_TYPE,
																),
																SeqExpr(
																	store_split_segment(
																		source,
																		variable(
																			"__split_segment_start",
																			INT_TYPE,
																		),
																		variable(
																			"__split_segment_len",
																			INT_TYPE,
																		),
																		variable(
																			"__split_out_index",
																			INT_TYPE,
																		),
																		return_type,
																		"__split_segment",
																	),
																	SeqExpr(
																		assignment(
																			"__split_out_index",
																			binary(
																				AddOp,
																				variable(
																					"__split_out_index",
																					INT_TYPE,
																				),
																				int_literal(1),
																				INT_TYPE,
																			),
																		),
																		SeqExpr(
																			assignment(
																				"__split_fill_pos",
																				binary(
																					AddOp,
																					variable(
																						"__split_fill_pos",
																						INT_TYPE,
																					),
																					variable(
																						"__split_dlen",
																						INT_TYPE,
																					),
																					INT_TYPE,
																				),
																			),
																			assignment(
																				"__split_segment_start",
																				variable(
																					"__split_fill_pos",
																					INT_TYPE,
																				),
																			),
																		),
																	),
																),
															),
															assignment(
																"__split_fill_pos",
																binary(
																	AddOp,
																	variable(
																		"__split_fill_pos",
																		INT_TYPE,
																	),
																	int_literal(1),
																	INT_TYPE,
																),
															),
															VoidType,
														),
													),
												),
												let_expr(
													"__split_final_len",
													False,
													INT_TYPE,
													binary(
														SubtractOp,
														variable("__split_slen", INT_TYPE),
														variable("__split_segment_start", INT_TYPE),
														INT_TYPE,
													),
													SeqExpr(
														store_split_segment(
															source,
															variable(
																"__split_segment_start",
																INT_TYPE,
															),
															variable("__split_final_len", INT_TYPE),
															variable("__split_out_index", INT_TYPE),
															return_type,
															"__split_final_segment",
														),
														SeqExpr(
															intrinsic_call(
																"list_set_len",
																[
																	variable(
																		"__split_result",
																		return_type,
																	),
																	variable(
																		"__split_part_count",
																		INT_TYPE,
																	),
																],
																VoidType,
															),
															variable(
																"__split_result",
																return_type,
															),
														),
													),
												),
											),
										),
									),
								),
							),
						),
					),
				),
				return_type,
			),
		),
	)


private pure func synthesize_repeat(source: CoreExpr, count: CoreExpr) -> CoreExpr:
	let_expr(
		"__repeat_slen",
		False,
		INT_TYPE,
		string_length(source),
		if_expr(
			logical(
				OrOp,
				binary(LessEqualOp, count, int_literal(0), BOOL_TYPE),
				binary(
					EqualOp,
					variable("__repeat_slen", INT_TYPE),
					int_literal(0),
					BOOL_TYPE,
				),
			),
			intrinsic_call("string_alloc", [int_literal(0)], STRING_TYPE),
			let_expr(
				"__repeat_total",
				False,
				INT_TYPE,
				binary(
					MultiplyOp,
					variable("__repeat_slen", INT_TYPE),
					count,
					INT_TYPE,
				),
				let_expr(
					"__repeat_result",
					False,
					STRING_TYPE,
					intrinsic_call(
						"string_alloc",
						[variable("__repeat_total", INT_TYPE)],
						STRING_TYPE,
					),
					SeqExpr(
						for_range(
							"__repeat_index",
							int_literal(0),
							count,
							copy_string_bytes(
								"__repeat_result",
								binary(
									MultiplyOp,
									variable("__repeat_index", INT_TYPE),
									variable("__repeat_slen", INT_TYPE),
									INT_TYPE,
								),
								source,
								int_literal(0),
								variable("__repeat_slen", INT_TYPE),
							),
						),
						SeqExpr(
							set_string_length(
								"__repeat_result",
								variable("__repeat_total", INT_TYPE),
							),
							variable("__repeat_result", STRING_TYPE),
						),
					),
				),
			),
			STRING_TYPE,
		),
	)


private pure func synthesize_reverse(source: CoreExpr) -> CoreExpr:
	let_expr(
		"__reverse_slen",
		False,
		INT_TYPE,
		string_length(source),
		if_expr(
			binary(
				LessEqualOp,
				variable("__reverse_slen", INT_TYPE),
				int_literal(1),
				BOOL_TYPE,
			),
			source,
			let_expr(
				"__reverse_result",
				False,
				STRING_TYPE,
				intrinsic_call("string_alloc", [variable("__reverse_slen", INT_TYPE)], STRING_TYPE),
				SeqExpr(
					for_range(
						"__reverse_i",
						int_literal(0),
						variable("__reverse_slen", INT_TYPE),
						set_string_byte(
							"__reverse_result",
							variable("__reverse_i", INT_TYPE),
							string_byte(
								source,
								binary(
									SubtractOp,
									binary(
										SubtractOp,
										variable("__reverse_slen", INT_TYPE),
										int_literal(1),
										INT_TYPE,
									),
									variable("__reverse_i", INT_TYPE),
									INT_TYPE,
								),
							),
						),
					),
					SeqExpr(
						set_string_length(
							"__reverse_result",
							variable("__reverse_slen", INT_TYPE),
						),
						variable("__reverse_result", STRING_TYPE),
					),
				),
			),
			STRING_TYPE,
		),
	)


