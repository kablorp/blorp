private pure func synthesize_trim(source: CoreExpr, trim_left: Bool, trim_right: Bool) -> CoreExpr:
	left_scan: CoreExpr = if trim_left:
		while_loop(
			logical(
				AndOp,
				binary(
					LessOp,
					variable("__trim_start", INT_TYPE),
					variable("__trim_slen", INT_TYPE),
					BOOL_TYPE,
				),
				ascii_whitespace(string_byte(source, variable("__trim_start", INT_TYPE))),
			),
			assignment(
				"__trim_start",
				binary(
					AddOp,
					variable("__trim_start", INT_TYPE),
					int_literal(1),
					INT_TYPE,
				),
			),
		)
	else:
		VOID_EXPR

	right_scan: CoreExpr = if trim_right:
		while_loop(
			logical(
				AndOp,
				binary(
					GreaterOp,
					variable("__trim_end", INT_TYPE),
					variable("__trim_start", INT_TYPE),
					BOOL_TYPE,
				),
				ascii_whitespace(
					string_byte(
						source,
						binary(
							SubtractOp,
							variable("__trim_end", INT_TYPE),
							int_literal(1),
							INT_TYPE,
						),
					),
				),
			),
			assignment(
				"__trim_end",
				binary(
					SubtractOp,
					variable("__trim_end", INT_TYPE),
					int_literal(1),
					INT_TYPE,
				),
			),
		)
	else:
		VOID_EXPR

	let_expr(
		"__trim_slen",
		False,
		INT_TYPE,
		string_length(source),
		let_expr(
			"__trim_start",
			True,
			INT_TYPE,
			int_literal(0),
			SeqExpr(
				left_scan,
				let_expr(
					"__trim_end",
					True,
					INT_TYPE,
					variable("__trim_slen", INT_TYPE),
					SeqExpr(
						right_scan,
						let_expr(
							"__trim_len",
							False,
							INT_TYPE,
							binary(
								SubtractOp,
								variable("__trim_end", INT_TYPE),
								variable("__trim_start", INT_TYPE),
								INT_TYPE,
							),
							copied_string(
								"__trim_result",
								source,
								variable("__trim_start", INT_TYPE),
								variable("__trim_len", INT_TYPE),
							),
						),
					),
				),
			),
		),
	)


private pure func byte_in_characters(
	value: CoreExpr,
	characters: CoreExpr,
	character_length: CoreExpr,
	prefix: String,
) -> CoreExpr:
	found_name: String = prefix + "_found"
	index_name: String = prefix + "_j"

	let_expr(
		found_name,
		True,
		BOOL_TYPE,
		bool_literal(False),
		SeqExpr(
			for_range(
				index_name,
				int_literal(0),
				character_length,
				if_expr(
					binary(
						EqualOp,
						value,
						string_byte(
							characters,
							variable(index_name, INT_TYPE),
						),
						BOOL_TYPE,
					),
					SeqExpr(
						assignment(found_name, bool_literal(True)),
						BreakExpr(VoidType, SyntheticSourceLoc),
					),
					VOID_EXPR,
					VoidType,
				),
			),
			variable(found_name, BOOL_TYPE),
		),
	)


private pure func synthesize_trim_chars(source: CoreExpr, characters: CoreExpr) -> CoreExpr:
	let_expr(
		"__trim_chars_slen",
		False,
		INT_TYPE,
		string_length(source),
		let_expr(
			"__trim_chars_clen",
			False,
			INT_TYPE,
			string_length(characters),
			let_expr(
				"__trim_chars_start",
				True,
				INT_TYPE,
				int_literal(0),
				SeqExpr(
					while_loop(
						binary(
							LessOp,
							variable("__trim_chars_start", INT_TYPE),
							variable("__trim_chars_slen", INT_TYPE),
							BOOL_TYPE,
						),
						if_expr(
							byte_in_characters(
								string_byte(
									source,
									variable("__trim_chars_start", INT_TYPE),
								),
								characters,
								variable("__trim_chars_clen", INT_TYPE),
								"__trim_chars_left",
							),
							assignment(
								"__trim_chars_start",
								binary(
									AddOp,
									variable("__trim_chars_start", INT_TYPE),
									int_literal(1),
									INT_TYPE,
								),
							),
							BreakExpr(VoidType, SyntheticSourceLoc),
							VoidType,
						),
					),
					let_expr(
						"__trim_chars_end",
						True,
						INT_TYPE,
						variable("__trim_chars_slen", INT_TYPE),
						SeqExpr(
							while_loop(
								binary(
									GreaterOp,
									variable("__trim_chars_end", INT_TYPE),
									variable("__trim_chars_start", INT_TYPE),
									BOOL_TYPE,
								),
								if_expr(
									byte_in_characters(
										string_byte(
											source,
											binary(
												SubtractOp,
												variable("__trim_chars_end", INT_TYPE),
												int_literal(1),
												INT_TYPE,
											),
										),
										characters,
										variable("__trim_chars_clen", INT_TYPE),
										"__trim_chars_right",
									),
									assignment(
										"__trim_chars_end",
										binary(
											SubtractOp,
											variable("__trim_chars_end", INT_TYPE),
											int_literal(1),
											INT_TYPE,
										),
									),
									BreakExpr(VoidType, SyntheticSourceLoc),
									VoidType,
								),
							),
							let_expr(
								"__trim_chars_len",
								False,
								INT_TYPE,
								binary(
									SubtractOp,
									variable("__trim_chars_end", INT_TYPE),
									variable("__trim_chars_start", INT_TYPE),
									INT_TYPE,
								),
								copied_string(
									"__trim_chars_result",
									source,
									variable("__trim_chars_start", INT_TYPE),
									variable("__trim_chars_len", INT_TYPE),
								),
							),
						),
					),
				),
			),
		),
	)


private pure func fill_string_range(
	result_name: String,
	start: CoreExpr,
	end_value: CoreExpr,
	fill: CoreExpr,
	index_name: String,
) -> CoreExpr:
	for_range(
		index_name,
		start,
		end_value,
		set_string_byte(
			result_name,
			variable(index_name, INT_TYPE),
			fill,
		),
	)


private pure func synthesize_pad(
	source: CoreExpr,
	width: CoreExpr,
	fill: CoreExpr,
	left: Bool,
) -> CoreExpr:
	prefix: String = if left:
		"__pad_left"
	else:
		"__pad_right"

	result_name: String = prefix + "_result"
	padding_name: String = prefix + "_padding"

	fill_body: CoreExpr = if left:
		fill_string_range(
			result_name,
			int_literal(0),
			variable(padding_name, INT_TYPE),
			fill,
			prefix + "_i",
		)
	else:
		fill_string_range(
			result_name,
			variable(prefix + "_slen", INT_TYPE),
			width,
			fill,
			prefix + "_i",
		)

	result_offset: CoreExpr = if left:
		variable(padding_name, INT_TYPE)
	else:
		int_literal(0)

	let_expr(
		prefix + "_slen",
		False,
		INT_TYPE,
		string_length(source),
		if_expr(
			binary(
				LessEqualOp,
				width,
				variable(prefix + "_slen", INT_TYPE),
				BOOL_TYPE,
			),
			source,
			let_expr(
				padding_name,
				False,
				INT_TYPE,
				binary(
					SubtractOp,
					width,
					variable(prefix + "_slen", INT_TYPE),
					INT_TYPE,
				),
				let_expr(
					result_name,
					False,
					STRING_TYPE,
					intrinsic_call("string_alloc", [width], STRING_TYPE),
					SeqExpr(
						fill_body,
						SeqExpr(
							copy_string_bytes(
								result_name,
								result_offset,
								source,
								int_literal(0),
								variable(prefix + "_slen", INT_TYPE),
							),
							SeqExpr(
								set_string_length(result_name, width),
								variable(result_name, STRING_TYPE),
							),
						),
					),
				),
			),
			STRING_TYPE,
		),
	)


private pure func synthesize_center(source: CoreExpr, width: CoreExpr, fill: CoreExpr) -> CoreExpr:
	let_expr(
		"__center_slen",
		False,
		INT_TYPE,
		string_length(source),
		if_expr(
			binary(
				LessEqualOp,
				width,
				variable("__center_slen", INT_TYPE),
				BOOL_TYPE,
			),
			source,
			let_expr(
				"__center_padding",
				False,
				INT_TYPE,
				binary(
					SubtractOp,
					width,
					variable("__center_slen", INT_TYPE),
					INT_TYPE,
				),
				let_expr(
					"__center_left",
					False,
					INT_TYPE,
					binary(
						DivideOp,
						variable("__center_padding", INT_TYPE),
						int_literal(2),
						INT_TYPE,
					),
					let_expr(
						"__center_result",
						False,
						STRING_TYPE,
						intrinsic_call("string_alloc", [width], STRING_TYPE),
						SeqExpr(
							fill_string_range(
								"__center_result",
								int_literal(0),
								variable("__center_left", INT_TYPE),
								fill,
								"__center_left_i",
							),
							SeqExpr(
								copy_string_bytes(
									"__center_result",
									variable("__center_left", INT_TYPE),
									source,
									int_literal(0),
									variable("__center_slen", INT_TYPE),
								),
								SeqExpr(
									fill_string_range(
										"__center_result",
										binary(
											AddOp,
											variable("__center_left", INT_TYPE),
											variable("__center_slen", INT_TYPE),
											INT_TYPE,
										),
										width,
										fill,
										"__center_right_i",
									),
									SeqExpr(
										set_string_length("__center_result", width),
										variable("__center_result", STRING_TYPE),
									),
								),
							),
						),
					),
				),
			),
			STRING_TYPE,
		),
	)


private pure func synthesize_capitalize(source: CoreExpr) -> CoreExpr:
	let_expr(
		"__capitalize_slen",
		False,
		INT_TYPE,
		string_length(source),
		if_expr(
			binary(
				EqualOp,
				variable("__capitalize_slen", INT_TYPE),
				int_literal(0),
				BOOL_TYPE,
			),
			intrinsic_call("string_alloc", [int_literal(0)], STRING_TYPE),
			let_expr(
				"__capitalize_result",
				False,
				STRING_TYPE,
				intrinsic_call(
					"string_alloc",
					[variable("__capitalize_slen", INT_TYPE)],
					STRING_TYPE,
				),
				let_expr(
					"__capitalize_first_done",
					True,
					BOOL_TYPE,
					bool_literal(False),
					SeqExpr(
						for_range(
							"__capitalize_i",
							int_literal(0),
							variable("__capitalize_slen", INT_TYPE),
							let_expr(
								"__capitalize_byte",
								False,
								INT_TYPE,
								string_byte(
									source,
									variable("__capitalize_i", INT_TYPE),
								),
								if_expr(
									variable("__capitalize_first_done", BOOL_TYPE),
									set_string_byte(
										"__capitalize_result",
										variable("__capitalize_i", INT_TYPE),
										if_expr(
											ascii_upper(variable("__capitalize_byte", INT_TYPE)),
											binary(
												AddOp,
												variable("__capitalize_byte", INT_TYPE),
												int_literal(32),
												INT_TYPE,
											),
											variable("__capitalize_byte", INT_TYPE),
											INT_TYPE,
										),
									),
									if_expr(
										ascii_lower(variable("__capitalize_byte", INT_TYPE)),
										SeqExpr(
											set_string_byte(
												"__capitalize_result",
												variable("__capitalize_i", INT_TYPE),
												binary(
													SubtractOp,
													variable("__capitalize_byte", INT_TYPE),
													int_literal(32),
													INT_TYPE,
												),
											),
											assignment(
												"__capitalize_first_done",
												bool_literal(True),
											),
										),
										if_expr(
											ascii_upper(variable("__capitalize_byte", INT_TYPE)),
											SeqExpr(
												set_string_byte(
													"__capitalize_result",
													variable("__capitalize_i", INT_TYPE),
													variable("__capitalize_byte", INT_TYPE),
												),
												assignment(
													"__capitalize_first_done",
													bool_literal(True),
												),
											),
											set_string_byte(
												"__capitalize_result",
												variable("__capitalize_i", INT_TYPE),
												variable("__capitalize_byte", INT_TYPE),
											),
											VoidType,
										),
										VoidType,
									),
									VoidType,
								),
							),
						),
						SeqExpr(
							set_string_length(
								"__capitalize_result",
								variable("__capitalize_slen", INT_TYPE),
							),
							variable("__capitalize_result", STRING_TYPE),
						),
					),
				),
			),
			STRING_TYPE,
		),
	)


