private union ByteClassification:
	NumericClassification
	AsciiClassification
	BlankClassification


private pure func classification_failure(
	classification: ByteClassification,
	value: CoreExpr,
) -> CoreExpr:
	match classification:
		NumericClassification:
			logical(
				OrOp,
				binary(LessOp, value, int_literal(48), BOOL_TYPE),
				binary(GreaterOp, value, int_literal(57), BOOL_TYPE),
			)
		AsciiClassification:
			binary(GreaterOp, value, int_literal(127), BOOL_TYPE)
		BlankClassification:
			logical(
				AndOp,
				logical(
					AndOp,
					binary(NotEqualOp, value, int_literal(32), BOOL_TYPE),
					binary(NotEqualOp, value, int_literal(9), BOOL_TYPE),
				),
				logical(
					AndOp,
					binary(NotEqualOp, value, int_literal(10), BOOL_TYPE),
					binary(NotEqualOp, value, int_literal(13), BOOL_TYPE),
				),
			)


private pure func synthesize_all_bytes_check(
	source: CoreExpr,
	classification: ByteClassification,
	default_empty: Bool,
) -> CoreExpr:
	let_expr(
		"__classify_len",
		False,
		INT_TYPE,
		string_length(source),
		if_expr(
			binary(
				EqualOp,
				variable("__classify_len", INT_TYPE),
				int_literal(0),
				BOOL_TYPE,
			),
			bool_literal(default_empty),
			let_expr(
				"__classify_ok",
				True,
				BOOL_TYPE,
				bool_literal(True),
				SeqExpr(
					for_range(
						"__classify_i",
						int_literal(0),
						variable("__classify_len", INT_TYPE),
						if_expr(
							classification_failure(
								classification,
								string_byte(
									source,
									variable("__classify_i", INT_TYPE),
								),
							),
							SeqExpr(
								assignment("__classify_ok", bool_literal(False)),
								BreakExpr(VoidType, SyntheticSourceLoc),
							),
							VOID_EXPR,
							VoidType,
						),
					),
					variable("__classify_ok", BOOL_TYPE),
				),
			),
			BOOL_TYPE,
		),
	)


private pure func synthesize_letter_case(source: CoreExpr, expect_lower: Bool) -> CoreExpr:
	wrong_case: CoreExpr = if expect_lower:
		ascii_upper(variable("__letter_byte", INT_TYPE))
	else:
		ascii_lower(variable("__letter_byte", INT_TYPE))

	expected_case: CoreExpr = if expect_lower:
		ascii_lower(variable("__letter_byte", INT_TYPE))
	else:
		ascii_upper(variable("__letter_byte", INT_TYPE))

	let_expr(
		"__letter_len",
		False,
		INT_TYPE,
		string_length(source),
		if_expr(
			binary(
				EqualOp,
				variable("__letter_len", INT_TYPE),
				int_literal(0),
				BOOL_TYPE,
			),
			bool_literal(False),
			let_expr(
				"__letter_has_letter",
				True,
				BOOL_TYPE,
				bool_literal(False),
				let_expr(
					"__letter_ok",
					True,
					BOOL_TYPE,
					bool_literal(True),
					SeqExpr(
						for_range(
							"__letter_i",
							int_literal(0),
							variable("__letter_len", INT_TYPE),
							let_expr(
								"__letter_byte",
								False,
								INT_TYPE,
								string_byte(
									source,
									variable("__letter_i", INT_TYPE),
								),
								if_expr(
									wrong_case,
									SeqExpr(
										assignment("__letter_ok", bool_literal(False)),
										BreakExpr(VoidType, SyntheticSourceLoc),
									),
									if_expr(
										expected_case,
										assignment("__letter_has_letter", bool_literal(True)),
										VOID_EXPR,
										VoidType,
									),
									VoidType,
								),
							),
						),
						logical(
							AndOp,
							variable("__letter_ok", BOOL_TYPE),
							variable("__letter_has_letter", BOOL_TYPE),
						),
					),
				),
			),
			BOOL_TYPE,
		),
	)


private pure func synthesize_longest_common_prefix(left: CoreExpr, right: CoreExpr) -> CoreExpr:
	let_expr(
		"__prefix_left_len",
		False,
		INT_TYPE,
		string_length(left),
		let_expr(
			"__prefix_right_len",
			False,
			INT_TYPE,
			string_length(right),
			let_expr(
				"__prefix_limit",
				False,
				INT_TYPE,
				min_int(
					variable("__prefix_left_len", INT_TYPE),
					variable("__prefix_right_len", INT_TYPE),
				),
				let_expr(
					"__prefix_len",
					True,
					INT_TYPE,
					int_literal(0),
					SeqExpr(
						while_loop(
							logical(
								AndOp,
								binary(
									LessOp,
									variable("__prefix_len", INT_TYPE),
									variable("__prefix_limit", INT_TYPE),
									BOOL_TYPE,
								),
								binary(
									EqualOp,
									string_byte(
										left,
										variable("__prefix_len", INT_TYPE),
									),
									string_byte(
										right,
										variable("__prefix_len", INT_TYPE),
									),
									BOOL_TYPE,
								),
							),
							assignment(
								"__prefix_len",
								binary(
									AddOp,
									variable("__prefix_len", INT_TYPE),
									int_literal(1),
									INT_TYPE,
								),
							),
						),
						copied_string(
							"__prefix_result",
							left,
							int_literal(0),
							variable("__prefix_len", INT_TYPE),
						),
					),
				),
			),
		),
	)


private pure func synthesize_hamming_distance(left: CoreExpr, right: CoreExpr) -> CoreExpr:
	let_expr(
		"__hamming_left_len",
		False,
		INT_TYPE,
		string_length(left),
		let_expr(
			"__hamming_right_len",
			False,
			INT_TYPE,
			string_length(right),
			if_expr(
				binary(
					NotEqualOp,
					variable("__hamming_left_len", INT_TYPE),
					variable("__hamming_right_len", INT_TYPE),
					BOOL_TYPE,
				),
				int_literal(-1),
				let_expr(
					"__hamming_distance",
					True,
					INT_TYPE,
					int_literal(0),
					SeqExpr(
						for_range(
							"__hamming_i",
							int_literal(0),
							variable("__hamming_left_len", INT_TYPE),
							if_expr(
								binary(
									NotEqualOp,
									string_byte(
										left,
										variable("__hamming_i", INT_TYPE),
									),
									string_byte(
										right,
										variable("__hamming_i", INT_TYPE),
									),
									BOOL_TYPE,
								),
								assignment(
									"__hamming_distance",
									binary(
										AddOp,
										variable("__hamming_distance", INT_TYPE),
										int_literal(1),
										INT_TYPE,
									),
								),
								VOID_EXPR,
								VoidType,
							),
						),
						variable("__hamming_distance", INT_TYPE),
					),
				),
				INT_TYPE,
			),
		),
	)


private pure func shift_right(value: CoreExpr, bits: Int) -> CoreExpr:
	intrinsic_call(
		"shift_right",
		[value, int_literal(bits)],
		INT_TYPE,
	)


private pure func bit_and(value: CoreExpr, mask: Int) -> CoreExpr:
	intrinsic_call(
		"bit_and",
		[value, int_literal(mask)],
		INT_TYPE,
	)


private pure func bit_or(left: CoreExpr, right: CoreExpr) -> CoreExpr:
	intrinsic_call(
		"bit_or",
		[left, right],
		INT_TYPE,
	)


private pure func prefixed_byte(prefix: Int, value: CoreExpr) -> CoreExpr:
	bit_or(int_literal(prefix), value)


private pure func continuation_byte(value: CoreExpr) -> CoreExpr:
	prefixed_byte(
		128,
		bit_and(value, 63),
	)


private pure func append_char_byte(offset: Int, value: CoreExpr) -> CoreExpr:
	set_string_byte(
		"__append_char_result",
		binary(
			AddOp,
			variable("__append_char_slen", INT_TYPE),
			int_literal(offset),
			INT_TYPE,
		),
		value,
	)


-- Keep this as a factory: evaluating it as a global calls `int_literal`, whose
-- indirect `INT_TYPE` dependency is unavailable during module CTFE setup.
private pure func append_replacement_character() -> CoreExpr:
	SeqExpr(
		append_char_byte(0, int_literal(239)),
		SeqExpr(
			append_char_byte(1, int_literal(191)),
			append_char_byte(2, int_literal(189)),
		),
	)


private pure func synthesize_append_char(source: CoreExpr, character: CoreExpr) -> CoreExpr:
	-- Encode the codepoint integer into newly reserved capacity. Values outside
	-- the supported range use the replacement character, matching OCaml.
	character_length: CoreExpr = if_expr(
		binary(LessOp, character, int_literal(0), BOOL_TYPE),
		int_literal(3),
		if_expr(
			binary(LessEqualOp, character, int_literal(127), BOOL_TYPE),
			int_literal(1),
			if_expr(
				binary(LessEqualOp, character, int_literal(2047), BOOL_TYPE),
				int_literal(2),
				if_expr(
					binary(LessEqualOp, character, int_literal(65535), BOOL_TYPE),
					int_literal(3),
					if_expr(
						binary(LessEqualOp, character, int_literal(1114111), BOOL_TYPE),
						int_literal(4),
						int_literal(3),
						INT_TYPE,
					),
					INT_TYPE,
				),
				INT_TYPE,
			),
			INT_TYPE,
		),
		INT_TYPE,
	)

	write_character: CoreExpr = if_expr(
		binary(LessOp, character, int_literal(0), BOOL_TYPE),
		append_replacement_character(),
		if_expr(
			binary(LessEqualOp, character, int_literal(127), BOOL_TYPE),
			append_char_byte(0, character),
			if_expr(
				binary(LessEqualOp, character, int_literal(2047), BOOL_TYPE),
				SeqExpr(
					append_char_byte(
						0,
						prefixed_byte(
							192,
							shift_right(character, 6),
						),
					),
					append_char_byte(1, continuation_byte(character)),
				),
				if_expr(
					binary(LessEqualOp, character, int_literal(65535), BOOL_TYPE),
					SeqExpr(
						append_char_byte(
							0,
							prefixed_byte(
								224,
								shift_right(character, 12),
							),
						),
						SeqExpr(
							append_char_byte(1, continuation_byte(shift_right(character, 6))),
							append_char_byte(2, continuation_byte(character)),
						),
					),
					if_expr(
						binary(LessEqualOp, character, int_literal(1114111), BOOL_TYPE),
						SeqExpr(
							append_char_byte(
								0,
								prefixed_byte(
									240,
									shift_right(character, 18),
								),
							),
							SeqExpr(
								append_char_byte(1, continuation_byte(shift_right(character, 12))),
								SeqExpr(
									append_char_byte(
										2,
										continuation_byte(shift_right(character, 6)),
									),
									append_char_byte(3, continuation_byte(character)),
								),
							),
						),
						append_replacement_character(),
						VoidType,
					),
					VoidType,
				),
				VoidType,
			),
			VoidType,
		),
		VoidType,
	)

	let_expr(
		"__append_char_slen",
		False,
		INT_TYPE,
		string_length(source),
		let_expr(
			"__append_char_len",
			False,
			INT_TYPE,
			character_length,
			let_expr(
				"__append_char_new_len",
				False,
				INT_TYPE,
				binary(
					AddOp,
					variable("__append_char_slen", INT_TYPE),
					variable("__append_char_len", INT_TYPE),
					INT_TYPE,
				),
				let_expr(
					"__append_char_result",
					False,
					STRING_TYPE,
					intrinsic_call(
						"string_ensure_capacity",
						[source, variable("__append_char_new_len", INT_TYPE)],
						STRING_TYPE,
					),
					SeqExpr(
						write_character,
						SeqExpr(
							set_string_length(
								"__append_char_result",
								variable("__append_char_new_len", INT_TYPE),
							),
							variable("__append_char_result", STRING_TYPE),
						),
					),
				),
			),
		),
	)


private pure func synthesize_named_body(
	name: String,
	params: List[CoreParam],
	return_type: CoreType,
) -> Option[CoreExpr]:
	if (
		(name == "string" or name == "string_with_capacity")
		and params.length() == 1
		and param_is_named(params, 0, "Int")
		and type_is_named(return_type, "String")
	):
		capacity ?= params.get(0)
		Some(intrinsic_call("string_alloc", [parameter_value(capacity)], STRING_TYPE))
	else if (
		name == "reserve"
		and params.length() == 2
		and param_is_named(params, 0, "String")
		and param_is_named(params, 1, "Int")
		and type_is_named(return_type, "String")
	):
		source ?= params.get(0)
		capacity ?= params.get(1)
		Some(
			intrinsic_call(
				"string_ensure_capacity",
				[parameter_value(source), parameter_value(capacity)],
				STRING_TYPE,
			),
		)
	else if (
		(name == "append_char" or name == "string_append_char")
		and params.length() == 2
		and param_is_named(params, 0, "String")
		and param_is_named(params, 1, "Char")
		and type_is_named(return_type, "String")
	):
		source ?= params.get(0)
		character ?= params.get(1)
		Some(synthesize_append_char(parameter_value(source), parameter_value(character)))
	else if (
		name == "length"
		and params.length() == 1
		and param_is_named(params, 0, "String")
		and type_is_named(return_type, "Int")
	):
		source ?= params.get(0)
		Some(string_length(parameter_value(source)))
	else if (
		name == "substring"
		and params.length() == 3
		and param_is_named(params, 0, "String")
		and param_is_named(params, 1, "Int")
		and param_is_named(params, 2, "Int")
		and type_is_named(return_type, "String")
	):
		source ?= params.get(0)
		start ?= params.get(1)
		length ?= params.get(2)
		Some(
			synthesize_substring(
				parameter_value(source),
				parameter_value(start),
				parameter_value(length),
			),
		)
	else if (
		name == "starts_with"
		and params.length() == 2
		and param_is_named(params, 0, "String")
		and param_is_named(params, 1, "String")
		and type_is_named(return_type, "Bool")
	):
		source ?= params.get(0)
		prefix ?= params.get(1)
		Some(synthesize_starts_with(parameter_value(source), parameter_value(prefix)))
	else if (
		name == "ends_with"
		and params.length() == 2
		and param_is_named(params, 0, "String")
		and param_is_named(params, 1, "String")
		and type_is_named(return_type, "Bool")
	):
		source ?= params.get(0)
		suffix ?= params.get(1)
		Some(synthesize_ends_with(parameter_value(source), parameter_value(suffix)))
	else if (
		name == "contains"
		and params.length() == 2
		and param_is_named(params, 0, "String")
		and param_is_named(params, 1, "String")
		and type_is_named(return_type, "Bool")
	):
		source ?= params.get(0)
		needle ?= params.get(1)
		Some(synthesize_contains(parameter_value(source), parameter_value(needle)))
	else if (
		name == "raw_index_of"
		and params.length() == 2
		and param_is_named(params, 0, "String")
		and param_is_named(params, 1, "String")
		and type_is_named(return_type, "Int")
	):
		source ?= params.get(0)
		needle ?= params.get(1)
		Some(synthesize_raw_index_of(parameter_value(source), parameter_value(needle)))
	else if (
		name == "raw_last_index_of"
		and params.length() == 2
		and param_is_named(params, 0, "String")
		and param_is_named(params, 1, "String")
		and type_is_named(return_type, "Int")
	):
		source ?= params.get(0)
		needle ?= params.get(1)
		Some(synthesize_raw_last_index_of(parameter_value(source), parameter_value(needle)))
	else if (
		name == "count"
		and params.length() == 2
		and param_is_named(params, 0, "String")
		and param_is_named(params, 1, "String")
		and type_is_named(return_type, "Int")
	):
		source ?= params.get(0)
		needle ?= params.get(1)
		Some(synthesize_count(parameter_value(source), parameter_value(needle)))
	else if (
		name == "split"
		and params.length() == 2
		and param_is_named(params, 0, "String")
		and param_is_named(params, 1, "String")
		and type_is_list_string(return_type)
	):
		source ?= params.get(0)
		delimiter ?= params.get(1)
		Some(synthesize_split(parameter_value(source), parameter_value(delimiter), return_type))
	else if (
		name == "replace"
		and params.length() == 3
		and param_is_named(params, 0, "String")
		and param_is_named(params, 1, "String")
		and param_is_named(params, 2, "String")
		and type_is_named(return_type, "String")
	):
		source ?= params.get(0)
		old ?= params.get(1)
		replacement ?= params.get(2)
		Some(
			synthesize_replace(
				parameter_value(source),
				parameter_value(old),
				parameter_value(replacement),
			),
		)
	else if (
		name == "repeat"
		and params.length() == 2
		and param_is_named(params, 0, "String")
		and param_is_named(params, 1, "Int")
		and type_is_named(return_type, "String")
	):
		source ?= params.get(0)
		count ?= params.get(1)
		Some(synthesize_repeat(parameter_value(source), parameter_value(count)))
	else if (
		name == "reverse"
		and params.length() == 1
		and param_is_named(params, 0, "String")
		and type_is_named(return_type, "String")
	):
		source ?= params.get(0)
		Some(synthesize_reverse(parameter_value(source)))
	else if (
		name == "drop_left"
		and params.length() == 2
		and param_is_named(params, 0, "String")
		and param_is_named(params, 1, "Int")
		and type_is_named(return_type, "String")
	):
		source ?= params.get(0)
		count ?= params.get(1)
		Some(synthesize_drop_left(parameter_value(source), parameter_value(count)))
	else if (
		name == "take_left"
		and params.length() == 2
		and param_is_named(params, 0, "String")
		and param_is_named(params, 1, "Int")
		and type_is_named(return_type, "String")
	):
		source ?= params.get(0)
		count ?= params.get(1)
		Some(synthesize_take_left(parameter_value(source), parameter_value(count)))
	else if (
		name == "take_right"
		and params.length() == 2
		and param_is_named(params, 0, "String")
		and param_is_named(params, 1, "Int")
		and type_is_named(return_type, "String")
	):
		source ?= params.get(0)
		count ?= params.get(1)
		Some(synthesize_take_right(parameter_value(source), parameter_value(count)))
	else if (
		name == "drop_right"
		and params.length() == 2
		and param_is_named(params, 0, "String")
		and param_is_named(params, 1, "Int")
		and type_is_named(return_type, "String")
	):
		source ?= params.get(0)
		count ?= params.get(1)
		Some(synthesize_drop_right(parameter_value(source), parameter_value(count)))
	else if (
		name == "trim_left"
		and params.length() == 1
		and param_is_named(params, 0, "String")
		and type_is_named(return_type, "String")
	):
		source ?= params.get(0)
		Some(synthesize_trim(parameter_value(source), True, False))
	else if (
		name == "trim_right"
		and params.length() == 1
		and param_is_named(params, 0, "String")
		and type_is_named(return_type, "String")
	):
		source ?= params.get(0)
		Some(synthesize_trim(parameter_value(source), False, True))
	else if (
		name == "trim"
		and params.length() == 1
		and param_is_named(params, 0, "String")
		and type_is_named(return_type, "String")
	):
		source ?= params.get(0)
		Some(synthesize_trim(parameter_value(source), True, True))
	else if (
		name == "trim_chars"
		and params.length() == 2
		and param_is_named(params, 0, "String")
		and param_is_named(params, 1, "String")
		and type_is_named(return_type, "String")
	):
		source ?= params.get(0)
		characters ?= params.get(1)
		Some(synthesize_trim_chars(parameter_value(source), parameter_value(characters)))
	else if (
		name == "pad_left"
		and params.length() == 3
		and param_is_named(params, 0, "String")
		and param_is_named(params, 1, "Int")
		and param_is_named(params, 2, "Char")
		and type_is_named(return_type, "String")
	):
		source ?= params.get(0)
		width ?= params.get(1)
		fill ?= params.get(2)
		Some(
			synthesize_pad(
				parameter_value(source),
				parameter_value(width),
				parameter_value(fill),
				True,
			),
		)
	else if (
		name == "pad_right"
		and params.length() == 3
		and param_is_named(params, 0, "String")
		and param_is_named(params, 1, "Int")
		and param_is_named(params, 2, "Char")
		and type_is_named(return_type, "String")
	):
		source ?= params.get(0)
		width ?= params.get(1)
		fill ?= params.get(2)
		Some(
			synthesize_pad(
				parameter_value(source),
				parameter_value(width),
				parameter_value(fill),
				False,
			),
		)
	else if (
		name == "center"
		and params.length() == 3
		and param_is_named(params, 0, "String")
		and param_is_named(params, 1, "Int")
		and param_is_named(params, 2, "Char")
		and type_is_named(return_type, "String")
	):
		source ?= params.get(0)
		width ?= params.get(1)
		fill ?= params.get(2)
		Some(
			synthesize_center(
				parameter_value(source),
				parameter_value(width),
				parameter_value(fill),
			),
		)
	else if (
		name == "capitalize"
		and params.length() == 1
		and param_is_named(params, 0, "String")
		and type_is_named(return_type, "String")
	):
		source ?= params.get(0)
		Some(synthesize_capitalize(parameter_value(source)))
	else if (
		name == "title_case"
		and params.length() == 1
		and param_is_named(params, 0, "String")
		and type_is_named(return_type, "String")
	):
		source ?= params.get(0)
		Some(synthesize_title_case(parameter_value(source)))
	else if (
		name == "is_numeric"
		and params.length() == 1
		and param_is_named(params, 0, "String")
		and type_is_named(return_type, "Bool")
	):
		source ?= params.get(0)
		Some(synthesize_all_bytes_check(parameter_value(source), NumericClassification, False))
	else if (
		name == "is_ascii"
		and params.length() == 1
		and param_is_named(params, 0, "String")
		and type_is_named(return_type, "Bool")
	):
		source ?= params.get(0)
		Some(synthesize_all_bytes_check(parameter_value(source), AsciiClassification, True))
	else if (
		name == "is_blank"
		and params.length() == 1
		and param_is_named(params, 0, "String")
		and type_is_named(return_type, "Bool")
	):
		source ?= params.get(0)
		Some(synthesize_all_bytes_check(parameter_value(source), BlankClassification, True))
	else if (
		name == "is_lower"
		and params.length() == 1
		and param_is_named(params, 0, "String")
		and type_is_named(return_type, "Bool")
	):
		source ?= params.get(0)
		Some(synthesize_letter_case(parameter_value(source), True))
	else if (
		name == "is_upper"
		and params.length() == 1
		and param_is_named(params, 0, "String")
		and type_is_named(return_type, "Bool")
	):
		source ?= params.get(0)
		Some(synthesize_letter_case(parameter_value(source), False))
	else if (
		name == "longest_common_prefix"
		and params.length() == 2
		and param_is_named(params, 0, "String")
		and param_is_named(params, 1, "String")
		and type_is_named(return_type, "String")
	):
		left ?= params.get(0)
		right ?= params.get(1)
		Some(synthesize_longest_common_prefix(parameter_value(left), parameter_value(right)))
	else if (
		name == "hamming_distance_raw"
		and params.length() == 2
		and param_is_named(params, 0, "String")
		and param_is_named(params, 1, "String")
		and type_is_named(return_type, "Int")
	):
		left ?= params.get(0)
		right ?= params.get(1)
		Some(synthesize_hamming_distance(parameter_value(left), parameter_value(right)))
	else:
		None


pure func synthesize_string_body(function_info: CoreFunction) -> Option[CoreExpr]:
	if (
		not is_synthesis_candidate(function_info)
		or function_info.source_module != Some(STRING_MODULE)
	):
		None
	else:
		name ?= synthesis_source_name(function_info)
		synthesize_named_body(name, function_info.params, function_info.return_type)
