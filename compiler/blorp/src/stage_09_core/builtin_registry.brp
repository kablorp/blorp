-- Runtime-backed and compiler-owned call targets that cannot be recovered
-- solely from Core declarations. Most builtins carry BuiltinFunction metadata
-- and are indexed directly by core_resolve; this registry covers
-- prelude sentinels and bodyless std declarations.
private pure func prelude_builtin_name(name: String) -> Option[String]:
	match name:
		"to_string":
			Some("blorp_to_string")
		"hash":
			Some("blorp_hash")
		"hash_combine":
			Some("blorp_hash_combine")
		"to_int":
			Some("blorp_to_int")
		"to_float":
			Some("blorp_to_float")
		"to_bool":
			Some("blorp_to_bool")
		"to_char":
			Some("blorp_to_char")
		"from_char":
			Some("blorp_from_char")
		"from_chars":
			Some("blorp_from_chars")
		"to_int8":
			Some("blorp_to_int8")
		"to_int16":
			Some("blorp_to_int16")
		"to_int32":
			Some("blorp_to_int32")
		"to_int128":
			Some("blorp_to_int128")
		"to_uint8":
			Some("blorp_to_uint8")
		"to_uint16":
			Some("blorp_to_uint16")
		"to_uint32":
			Some("blorp_to_uint32")
		"to_uint64":
			Some("blorp_to_uint64")
		"to_uint128":
			Some("blorp_to_uint128")
		"to_float32":
			Some("blorp_to_float32")
		"to_float16":
			Some("blorp_to_float16")
		"min":
			Some("blorp_min")
		"max":
			Some("blorp_max")
		"length":
			Some("blorp_length")
		"round":
			Some("blorp_round")
		"checked_div":
			Some("blorp_option_div_int")
		"checked_mod":
			Some("blorp_option_mod_int")
		"assert_shape":
			Some("blorp_assert_shape")
		"checked_get":
			Some("blorp_checked_get")
		"tensor_peel":
			Some("blorp_tensor_peel")
		"checked_set":
			Some("blorp_checked_set")
		"checked_slice":
			Some("blorp_checked_slice")
		"matrix_checked_get":
			Some("blorp_matrix_checked_get")
		"matrix_checked_set":
			Some("blorp_matrix_checked_set")
		"tensor3_checked_get":
			Some("blorp_tensor3_checked_get")
		"tensor3_checked_set":
			Some("blorp_tensor3_checked_set")
		"tensor4_checked_get":
			Some("blorp_tensor4_checked_get")
		"tensor4_checked_set":
			Some("blorp_tensor4_checked_set")
		"tensor5_checked_get":
			Some("blorp_tensor5_checked_get")
		"tensor5_checked_set":
			Some("blorp_tensor5_checked_set")
		"vector":
			Some("blorp_vector_new_fill")
		"matrix":
			Some("blorp_matrix_new_fill")
		"tensor3":
			Some("blorp_tensor3_new")
		"tensor4":
			Some("blorp_tensor4_new")
		"tensor5":
			Some("blorp_tensor5_new")
		"equals":
			Some("blorp_eq_dispatch")
		"sleep":
			Some("blorp_sleep")
		"yield_now":
			Some("blorp_yield_now")
		"max_threads":
			Some("blorp_max_threads")
		"channel":
			Some("blorp_channel_new")
		"send":
			Some("blorp_channel_send")
		"recv":
			Some("blorp_channel_recv")
		"try_send":
			Some("blorp_channel_try_send")
		"try_recv":
			Some("blorp_channel_try_recv")
		"recv_timeout":
			Some("blorp_channel_recv_timeout")
		"send_timeout":
			Some("blorp_channel_send_timeout")
		"seal":
			Some("blorp_channel_seal")
		_:
			None


private pure func math_builtin_name(name: String) -> Option[String]:
	passthrough: List[String] = [
		"sqrt",
		"sin",
		"cos",
		"tan",
		"floor",
		"ceil",
		"pow",
		"asin",
		"acos",
		"atan",
		"atan2",
		"sinh",
		"cosh",
		"tanh",
		"asinh",
		"acosh",
		"atanh",
		"exp",
		"exp2",
		"log",
		"log2",
		"log10",
		"log1p",
		"expm1",
		"cbrt",
		"hypot",
		"trunc",
		"fmod",
		"copysign",
		"fma",
	]
	prefixed: List[String] = [
		"is_nan",
		"is_inf",
		"is_finite",
		"infinity",
		"neg_infinity",
		"nan_value",
	]

	if passthrough.contains(name):
		Some(name)
	else if prefixed.contains(name):
		Some("blorp_" + name)
	else:
		None


private pure func matrix_builtin_name(name: String) -> Option[String]:
	match name:
		"multiply":
			Some("blorp_tensor_matrix_multiply")
		"transpose":
			Some("blorp_tensor_transpose")
		"multiply_vector":
			Some("blorp_tensor_matrix_vector_multiply")
		"multiply_transposed_vector":
			Some("blorp_tensor_transposed_matrix_vector_multiply")
		"outer":
			Some("blorp_tensor_outer")
		"get":
			Some("blorp_matrix_get_opt")
		"set_cell":
			Some("blorp_matrix_checked_set")
		"matrix_checked_get":
			Some("blorp_matrix_checked_get")
		"matrix_checked_set":
			Some("blorp_matrix_checked_set")
		_:
			None


