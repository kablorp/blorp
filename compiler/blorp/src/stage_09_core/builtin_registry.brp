			Some("blorp_channel_new")
		"send" | "recv" | "try_send" | "try_recv" | "recv_timeout" | "send_timeout" | "seal":
			Some("blorp_channel_" + name)
		_:
			None


private pure func raylib_builtin_name(name: String) -> Option[String]:
	match name:
		"init_window" | "close_window" | "window_should_close" | "set_target_fps" | "get_fps" | "begin_drawing" | "end_drawing" | "clear_background" | "draw_rectangle" | "draw_rectangle_rec" | "draw_rectangle_rounded" | "draw_circle" | "draw_line" | "draw_line_thick" | "draw_text" | "set_config_flags" | "is_key_pressed" | "is_key_down" | "get_mouse_x" | "get_mouse_y" | "is_mouse_button_pressed" | "is_mouse_button_down" | "get_frame_time" | "get_time" | "init_audio" | "close_audio" | "play_click" | "set_click_kit" | "get_num_click_kits":
			Some("blorp_raylib_" + name)
		_:
			None


pure func core_builtin_name(module_path: String, name: String) -> Option[String]:
	if module_path == "":
		match prelude_builtin_name(name):
			Some(runtime_name):
				Some(runtime_name)
			None:
				math_builtin_name(name)
	else:
		match module_path:
			"std/vector":
				match name:
					"clear":
						Some("blorp_vector_clear")
					"zip":
						Some("blorp_vector_zip")
					"max":
						Some("blorp_max")
					"min":
						Some("blorp_min")
					"norm":
						Some("blorp_vector_norm")
					"cross":
						Some("blorp_vector_cross_float")
					"exp" | "log" | "sqrt" | "map":
						Some("blorp_vector_" + name)
					_:
						None
			"std/tensor":
				match prelude_builtin_name(name):
					Some(runtime_name):
						Some(runtime_name)
					None:
						match name:
							"length":
								Some("blorp_vector_len")
							"get":
								Some("blorp_vector_get_opt")
							"set_index":
								Some("blorp_vector_set_cow")
							_:
								None
			"std/list":
				if name == "list":
					Some("blorp_list_new")
				else:
					None
			"std/math":
				math_builtin_name(name)
			"std/matrix":
				matrix_builtin_name(name)
			"std/string":
				string_builtin_name(name)
			"std/regex":
				regex_builtin_name(name)
			"std/dict":
				dict_builtin_name(name)
			"std/set":
				set_builtin_name(name)
			"std/stream":
				stream_builtin_name(name)
			"std/bytes":
				bytes_builtin_name(name)
			"std/net/dns":
				if name == "resolve":
					Some("blorp_dns_resolve_raw")
				else:
					None
			"std/net/tcp":
				tcp_builtin_name(name)
			"std/net/tls":
				tls_builtin_name(name)
			"std/net/udp":
				udp_builtin_name(name)
			"std/net/websocket":
				websocket_builtin_name(name)
			"std/channel":
				channel_builtin_name(name)
			"./raylib" | "../games/raylib" | "./games/raylib":
				raylib_builtin_name(name)
			_:
				None


pure func core_bitwise_intrinsic_name(name: String, arity: Int) -> Option[String]:
	if (
		(name == "bit_and" or name == "bit_or" or name == "bit_xor") and arity == 2
		or name == "bit_not" and arity == 1
		or (name == "shift_left" or name == "shift_right") and arity == 2
	):
		Some(name)
	else:
		None


pure func core_debug_intrinsic_name(
	module_path: Option[String],
	name: String,
	arity: Int,
) -> Option[String]:
	if arity != 1 or name != "type_name" and name != "is_heap":
		None
	else:
		match module_path:
			None:
				Some(name)
			Some("std/debug"):
				Some(name)
			Some(_):
				None


pure func core_structural_length_intrinsic(
	module_path: String,
	name: String,
	receiver_name: String,
	arity: Int,
) -> Option[String]:
	if name != "length" or arity != 1:
		None
	else:
		match (module_path, receiver_name):
			("std/list", "List"):
				Some("list_len")
			("std/string", "String"):
				Some("string_len")
			("std/bytes", "Bytes"):
				Some("bytes_len")
			("std/dict", "Dict"):
				Some("dict_len")
			("std/set", "Set"):
				Some("set_len")
			_:
				None
