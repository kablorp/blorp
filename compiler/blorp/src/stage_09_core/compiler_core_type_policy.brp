-- Shared semantic type policy for Core stages.
--
-- These classifications affect lowering and ownership before backend
-- rendering, so they must not live in an emitter module.
import:
	../stage_05_types/compiler_type_name_metadata:
		compiler_is_resource_source_type_name,
		compiler_is_runtime_erased_union_payload_type_name,
	compiler_core_json:
		CoreReleasePolicy(
			ArcReleaseOnlyPolicy,
			ArcReleasePolicy,
			NoReleasePolicy,
			StackResultReleasePolicy,
		),
		CoreType(
			BoxedResultType,
			EnumType,
			FunctionType,
			HeapRecordType,
			NamedType,
			RangeType,
			SelfType,
			StackResultType,
			TensorType,
			TupleType,
			TypeParameterType,
			UnionType,
			ValueRecordType,
			VoidType,
		),


pure func is_runtime_erased_union_payload_type_name(name: String) -> Bool:
	compiler_is_runtime_erased_union_payload_type_name(name)


pure func is_resource_source_type_name(name: String) -> Bool:
	compiler_is_resource_source_type_name(name)


pure func is_stack_result_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			name == "Result" and args.length() == 2
		TypeParameterType(_) | SelfType:
			False
		StackResultType(_, _):
			True
		BoxedResultType(_, _):
			False
		FunctionType(_, _, _):
			False
		VoidType:
			False
		EnumType(_):
			False
		ValueRecordType(_):
			False
		HeapRecordType(_):
			False
		UnionType(_):
			False
		RangeType:
			False
		TensorType(_):
			False
		TupleType(_):
			False


pure func cleanup_release_policy_for_type(typ: CoreType) -> CoreReleasePolicy:
	if is_stack_result_type(typ):
		StackResultReleasePolicy
	else:
		match typ:
			NamedType(name, args):
				if (
					((
						name == "String"
						or name == "LiteralString"
						or name == "Bytes"
						or name == "Fixed"
					))
					and args.is_empty()
				):
					ArcReleaseOnlyPolicy
				else if (
					name == "List" and args.length() == 1
					or name == "Dict" and args.length() == 2
					or name == "Set" and args.length() == 1
					or name == "Channel" and args.length() == 1
					or name == "Closure" and args.is_empty()
					or is_resource_source_type_name(name)
					or (
						((
							name == "Stream"
							or name == "std/stream::Stream"
							or name == "std_stream__Stream"
						))
						and args.length() == 1
					)
					or (
						((
							name == "FallibleStream"
							or name == "std/stream::FallibleStream"
							or name == "std_stream__FallibleStream"
						))
						and args.length() == 2
					)
					or (
						((
							name == "TcpListener"
							or name == "TcpStream"
							or name == "TlsSession"
							or name == "WebSocketSession"
						))
						and args.is_empty()
					)
				):
					ArcReleasePolicy
				else:
					NoReleasePolicy
			TypeParameterType(_) | SelfType:
				NoReleasePolicy
			StackResultType(_, _):
				StackResultReleasePolicy
			BoxedResultType(_, _):
				ArcReleasePolicy
			FunctionType(_, _, _):
				ArcReleasePolicy
			HeapRecordType(_):
				ArcReleasePolicy
			UnionType(_):
				ArcReleasePolicy
			TensorType(_):
				ArcReleasePolicy
			TupleType(_):
				ArcReleasePolicy
			VoidType:
				NoReleasePolicy
			EnumType(_):
				NoReleasePolicy
			ValueRecordType(_):
				NoReleasePolicy
			RangeType:
				NoReleasePolicy
