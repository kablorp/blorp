-- Cooperative-fairness checkpoint insertion for the Blorp-owned Core tail.
--
-- Loop bodies must reach the runtime scheduler at bounded intervals. This pass
-- inserts an explicit checkpoint at the start of loop bodies unless one is
-- already present.
import:
	compiler_core_json:
		CoreBoxedStorageValue,
		CoreConcurrentBinding,
		CoreConcurrentBlock,
		CoreConcurrentlyLoop,
		CoreConstructorLengthMatch,
		CoreConstructorLengthMatchBranch,
		CoreConstructorLengthMatchCase,
		CoreConstructorLengthMatchGeq,
		CoreConstructorLiteralMatch,
		CoreConstructorMatchBody(
			ConstructorMatchBodyExpr,
			ConstructorMatchBodyLength,
			ConstructorMatchBodyLiteral,
		),
		CoreConstructorMatchCase,
		CoreConstructorMatchFallback(
			ConstructorMatchFallbackBindings,
			ConstructorMatchFallbackBody,
			ConstructorMatchFallbackFail,
		),
		CoreDecl(
			EnumDecl,
			FunctionDecl,
			GlobalDecl,
			HeapRecordDecl,
			ImplDecl,
			TraitDecl,
			TypeAliasDecl,
			UnionDecl,
			ValueRecordDecl,
		),
		CoreDictConstruct,
		CoreDictEntry,
		CoreDictLiteralEntry,
		CoreExpr(
			AccessorLiteralMatchExpr,
			AssignExpr,
			BinaryExpr,
			BoxExpr,
			BreakExpr,
			BorrowLetExpr,
			CastExpr,
			CallExpr,
			ClosureCreateExpr,
			ConcurrentlyLoopExpr,
			ConcurrentExpr,
			ConstructorMatchExpr,
			ContinueExpr,
			CooperativeCheckpointExpr,
			DebugBlockExpr,
			DetachExpr,
			DictConstructExpr,
			DictExpr,
			DupExpr,
			DropExpr,
			FieldExpr,
			ForChannelExpr,
			ForDictExpr,
			ForListExpr,
			ForRangeExpr,
			ForResourceSourceExpr,
			ForSetExpr,
			ForStreamExpr,
			ForStringExpr,
			ForTensorExpr,
			IfExpr,
			LambdaExpr,
			LetExpr,
			ListAllocExpr,
			ListConstructExpr,
			ListGetExpr,
			ListHandoffExpr,
			ListHandoffSetOwnedExpr,
			ListHandoffSetSourceSlotExpr,
			ListRetainExpr,
			ListSetExpr,
			ListSwapExpr,
			LengthMatchExpr,
			LiteralExpr,
			LiteralMatchExpr,
			LogicalExpr,
			RangeExpr,
			RecordExpr,
			RecordConstructExpr,
			PreClosureConcurrentExpr,
			PreClosureConcurrentlyLoopExpr,
			PreClosureDetachExpr,
			RawMatchExpr,
			ResourceCleanupExitExpr,
			ResourceScopeExpr,
			SelectExpr,
			SeqExpr,
			SetAllocExpr,
			StringByteCopyExpr,
			StringByteReadExpr,
			StringByteWriteExpr,
			StringSetLenExpr,
			TailrecListSpreadLoopExpr,
			TailrecListSpreadRecurExpr,
			TailrecLoopExpr,
			TailrecRecurExpr,
			TensorBoxedLiteralExpr,
			TensorLiteralExpr,
			TensorPackedLiteralExpr,
			TensorRawFillExpr,
			TensorRawReadExpr,
			TensorRawViewLetExpr,
			TensorRawWriteExpr,
			TupleExpr,
			TupleConstructExpr,
			TupleFieldExpr,
			UnaryExpr,
			UnionConstructExpr,
			UnionReuseConstructExpr,
			VarExpr,
			VectorExpr,
			VoidExpr,
			WhileExpr,
		),
		CoreFunction,
		CoreGlobal,
		CoreListAlloc,
		CoreListConstruct,
		CoreListGet,
		CoreListHandoff,
		CoreListHandoffSetSourceSlot,
		CoreListRetain,
		CoreListSet,
		CoreListSwap,
		CoreLiteralMatchCase,
		CoreLiteralMatchFallback(
			LiteralMatchFallbackBindings,
			LiteralMatchFallbackBody,
			LiteralMatchFallbackFail,
		),
		CoreProgram,
		CoreRecordFieldValue,
		CoreSelectArm,
		CoreSelectArmKind(SelectAfterArm, SelectRecvArm, SelectSealedArm),
		CoreSelectRecvArm,
		CoreSourceLoc,
		CoreStringByteCopy,
		CoreStringByteRead,
		CoreStringByteWrite,
		CoreStringSetLen,
		CoreTailrecListSpreadLoop,
		CoreTailrecListSpreadRebind,
		CoreTensorLiteralPayload(TensorInlineStructLiteralPayload, TensorRawLiteralPayload),
		CoreTensorRawRead,
		CoreTensorRawViewBinding,
		CoreTensorRawWrite,
		CoreTupleElement(
			TupleFloat32Element,
			TupleFloat16Element,
			TupleFloatElement,
			TuplePointerElement,
			TuplePrimElement,
			TupleStructElement,
			TupleVoidElement,
		),
		CoreType(VoidType),
		clone_tensor_for_element_storage,
	compiler_core_traverse as CoreTraverse


private pure func checkpoint(loc: CoreSourceLoc) -> CoreExpr:
	CooperativeCheckpointExpr(VoidType, loc)


private pure func is_checkpoint_expr(expr: CoreExpr) -> Bool:
	match expr:
		CooperativeCheckpointExpr(typ, loc):
			True
		RawMatchExpr(scrutinee, cases, typ, loc):
			False
		LiteralExpr(literal, typ, loc):
			False
		VarExpr(variable, typ, loc):
			False
		VoidExpr(typ, loc):
			False
		DebugBlockExpr(body, typ, loc):
			False
		CallExpr(kind, callee, args, typ, loc):
			False
		BinaryExpr(op, left, right, typ, loc):
			False
		UnaryExpr(op, expr_value, typ, loc):
			False
		LogicalExpr(op, left, right, typ, loc):
			False
		AssignExpr(variable, rhs, typ, loc):
			False
		CastExpr(expr_value, typ, loc):
			False
		BoxExpr(box, typ, loc):
			False
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			False
		FieldExpr(expr_value, field_name, typ, loc):
			False
		TupleFieldExpr(expr_value, field_index, typ, loc):
			False
		TupleExpr(items, typ, loc):
			False
		TupleConstructExpr(tuple_construct, typ, loc):
			False
		VectorExpr(items, typ, loc):
			False
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			False
		ClosureCreateExpr(closure, typ, loc):
			False
		ListConstructExpr(construct, typ, loc):
			False
		ListAllocExpr(alloc, typ, loc):
			False
		ListGetExpr(get, typ, loc):
			False
		ListHandoffExpr(handoff, typ, loc):
			False
		ListHandoffSetOwnedExpr(set, typ, loc):
			False
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			False
		StringByteReadExpr(read, typ, loc):
			False
		StringByteWriteExpr(write, typ, loc):
			False
		StringByteCopyExpr(copy, typ, loc):
			False
		StringSetLenExpr(set_len, typ, loc):
			False
		TensorLiteralExpr(literal, typ, loc):
			False
		TensorBoxedLiteralExpr(literal, typ, loc):
			False
		TensorPackedLiteralExpr(literal, typ, loc):
			False
		TensorRawFillExpr(fill, typ, loc):
			False
		TensorRawReadExpr(read, typ, loc):
			False
		TensorRawWriteExpr(write, typ, loc):
			False
		TensorRawViewLetExpr(binding, body, typ, loc):
			False
		DictExpr(entries, typ, loc):
			False
		DictConstructExpr(construct, typ, loc):
			False
		SetAllocExpr(alloc, typ, loc):
			False
		ListRetainExpr(retain, typ, loc):
			False
		ListSetExpr(set, typ, loc):
			False
		ListSwapExpr(swap, typ, loc):
			False
		RecordExpr(fields, typ, loc):
			False
		RecordConstructExpr(type_name, fields, typ, loc):
			False
		UnionConstructExpr(construct, typ, loc):
			False
		UnionReuseConstructExpr(construct, typ, loc):
			False
		PreClosureDetachExpr(detached, typ, loc):
			False
		DetachExpr(detached, typ, loc):
			False
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			False
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			False
		LetExpr(name, is_mutable, typ, rhs, body):
			False
		BorrowLetExpr(name, typ, rhs, body):
			False
		SeqExpr(first, second):
			False
		WhileExpr(cond, body, typ, loc):
			False
		BreakExpr(typ, loc):
			False
		ContinueExpr(typ, loc):
			False
		ResourceScopeExpr(scope, typ, loc):
			False
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			False
		TailrecLoopExpr(params, return_type, body, loc):
			False
		TailrecRecurExpr(args, typ, loc):
			False
		TailrecListSpreadLoopExpr(loop, loc):
			False
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			False
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			False
		ForChannelExpr(for_channel, typ, loc):
			False
		ForListExpr(for_list, typ, loc):
			False
		ForStringExpr(for_string, typ, loc):
			False
		ForDictExpr(for_dict, typ, loc):
			False
		ForSetExpr(for_set, typ, loc):
			False
		ForResourceSourceExpr(for_resource_source, typ, loc):
			False
		ForStreamExpr(for_stream, typ, loc):
			False
		ForTensorExpr(for_tensor, typ, loc):
			False
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			False
		DetachExpr(detached, typ, loc):
			False
		ConcurrentlyLoopExpr(loop, typ, loc):
			False
		PreClosureConcurrentExpr(block, typ, loc):
			False
		ConcurrentExpr(block, typ, loc):
			False
		SelectExpr(select_expr, typ, loc):
			False
		RangeExpr(start, end_value, typ, loc):
			False
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			False
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			False
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			False
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, fallback, typ, loc):
			False
		IfExpr(cond, then_expr, else_expr, typ, loc):
			False


private pure func body_starts_with_checkpoint(body: CoreExpr) -> Bool:
	match body:
		CooperativeCheckpointExpr(typ, loc):
			True
		RawMatchExpr(scrutinee, cases, typ, loc):
			False
		SeqExpr(first, second):
			is_checkpoint_expr(first)
		LiteralExpr(literal, typ, loc):
			False
		VarExpr(variable, typ, loc):
			False
		VoidExpr(typ, loc):
			False
		DebugBlockExpr(body, typ, loc):
			False
		CallExpr(kind, callee, args, typ, loc):
			False
		BinaryExpr(op, left, right, typ, loc):
			False
		UnaryExpr(op, expr_value, typ, loc):
			False
		LogicalExpr(op, left, right, typ, loc):
			False
		AssignExpr(variable, rhs, typ, loc):
			False
		CastExpr(expr_value, typ, loc):
			False
		BoxExpr(box, typ, loc):
			False
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			False
		FieldExpr(expr_value, field_name, typ, loc):
			False
		TupleFieldExpr(expr_value, field_index, typ, loc):
			False
		TupleExpr(items, typ, loc):
			False
		TupleConstructExpr(tuple_construct, typ, loc):
			False
		VectorExpr(items, typ, loc):
			False
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			False
		ClosureCreateExpr(closure, typ, loc):
			False
		ListConstructExpr(construct, typ, loc):
			False
		ListAllocExpr(alloc, typ, loc):
			False
		ListGetExpr(get, typ, loc):
			False
		ListHandoffExpr(handoff, typ, loc):
			False
		ListHandoffSetOwnedExpr(set, typ, loc):
			False
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			False
		StringByteReadExpr(read, typ, loc):
			False
		StringByteWriteExpr(write, typ, loc):
			False
		StringByteCopyExpr(copy, typ, loc):
			False
		StringSetLenExpr(set_len, typ, loc):
			False
		TensorLiteralExpr(literal, typ, loc):
			False
		TensorBoxedLiteralExpr(literal, typ, loc):
			False
		TensorPackedLiteralExpr(literal, typ, loc):
			False
		TensorRawFillExpr(fill, typ, loc):
			False
		TensorRawReadExpr(read, typ, loc):
			False
		TensorRawWriteExpr(write, typ, loc):
			False
		TensorRawViewLetExpr(binding, body, typ, loc):
			False
		DictExpr(entries, typ, loc):
			False
		DictConstructExpr(construct, typ, loc):
			False
		SetAllocExpr(alloc, typ, loc):
			False
		ListRetainExpr(retain, typ, loc):
			False
		ListSetExpr(set, typ, loc):
			False
		ListSwapExpr(swap, typ, loc):
			False
		RecordExpr(fields, typ, loc):
			False
		RecordConstructExpr(type_name, fields, typ, loc):
			False
		UnionConstructExpr(construct, typ, loc):
			False
		UnionReuseConstructExpr(construct, typ, loc):
			False
		PreClosureDetachExpr(detached, typ, loc):
			False
		DetachExpr(detached, typ, loc):
			False
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			False
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			False
		LetExpr(name, is_mutable, typ, rhs, body):
			False
		BorrowLetExpr(name, typ, rhs, body):
			False
		WhileExpr(cond, body, typ, loc):
			False
		BreakExpr(typ, loc):
			False
		ContinueExpr(typ, loc):
			False
		ResourceScopeExpr(scope, typ, loc):
			False
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			False
		TailrecLoopExpr(params, return_type, body, loc):
			False
		TailrecRecurExpr(args, typ, loc):
			False
		TailrecListSpreadLoopExpr(loop, loc):
			False
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			False
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			False
		ForChannelExpr(for_channel, typ, loc):
			False
		ForListExpr(for_list, typ, loc):
			False
		ForStringExpr(for_string, typ, loc):
			False
		ForDictExpr(for_dict, typ, loc):
			False
		ForSetExpr(for_set, typ, loc):
			False
		ForResourceSourceExpr(for_resource_source, typ, loc):
			False
		ForStreamExpr(for_stream, typ, loc):
			False
		ForTensorExpr(for_tensor, typ, loc):
			False
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			False
		DetachExpr(detached, typ, loc):
			False
		ConcurrentlyLoopExpr(loop, typ, loc):
			False
		PreClosureConcurrentExpr(block, typ, loc):
			False
		ConcurrentExpr(block, typ, loc):
			False
		SelectExpr(select_expr, typ, loc):
			False
		RangeExpr(start, end_value, typ, loc):
			False
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			False
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			False
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			False
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, fallback, typ, loc):
			False
		IfExpr(cond, then_expr, else_expr, typ, loc):
			False


private pure func checkpoint_loop_body(loop_loc: CoreSourceLoc, body: CoreExpr) -> CoreExpr:
	if body_starts_with_checkpoint(body):
		body
	else:
		SeqExpr(checkpoint(loop_loc), body)


private pure func insert_exprs(exprs: List[CoreExpr]) -> List[CoreExpr]:
	CoreTraverse.map_core_exprs(exprs, insert_cooperative_checkpoints_expr)


private pure func insert_dict_literal_entries(
	entries: List[CoreDictLiteralEntry],
) -> List[CoreDictLiteralEntry]:
	CoreTraverse.map_core_dict_literal_entries(entries, insert_cooperative_checkpoints_expr)


private pure func insert_tailrec_list_spread_rebind_checkpoints(
	rebind: CoreTailrecListSpreadRebind,
) -> CoreTailrecListSpreadRebind:
	{
		param_index = rebind.param_index,
		value = insert_cooperative_checkpoints_expr(rebind.value)
	}


private pure func insert_tailrec_list_spread_rebinds(
	rebinds: List[CoreTailrecListSpreadRebind],
) -> List[CoreTailrecListSpreadRebind]:
	rebinds.map(insert_tailrec_list_spread_rebind_checkpoints)


private pure func insert_tailrec_list_spread_loop_checkpoints(
	loop: CoreTailrecListSpreadLoop,
	loc: CoreSourceLoc,
) -> CoreTailrecListSpreadLoop:
	{
		params = loop.params,
		return_type = loop.return_type,
		list_index = loop.list_index,
		list_param = loop.list_param,
		cursor = loop.cursor,
		layout = loop.layout,
		body = checkpoint_loop_body(loc, insert_cooperative_checkpoints_expr(loop.body))
	}


private pure func insert_tuple_elements(elements: List[CoreTupleElement]) -> List[CoreTupleElement]:
	var result: List[CoreTupleElement] = []

	for element in elements:
		match element:
			TuplePrimElement(value):
				result = result.append(TuplePrimElement(insert_cooperative_checkpoints_expr(value)))
			TuplePointerElement(value):
				result = result.append(
					TuplePointerElement(insert_cooperative_checkpoints_expr(value)),
				)
			TupleStructElement(value, c_type):
				result = result.append(
					TupleStructElement(
						insert_cooperative_checkpoints_expr(value),
						c_type,
					),
				)
			TupleVoidElement:
				result = result.append(TupleVoidElement)
			TupleFloatElement(value):
				result = result.append(
					TupleFloatElement(insert_cooperative_checkpoints_expr(value)),
				)
			TupleFloat32Element(value):
				result = result.append(
					TupleFloat32Element(insert_cooperative_checkpoints_expr(value)),
				)
			TupleFloat16Element(value):
				result = result.append(
					TupleFloat16Element(insert_cooperative_checkpoints_expr(value)),
				)

	result


private pure func insert_boxed_storage_value(value: CoreBoxedStorageValue) -> CoreBoxedStorageValue:
	{
		kind = value.kind,
		value = insert_cooperative_checkpoints_expr(value.value),
		needs_release = value.needs_release,
		transfers_ownership = value.transfers_ownership
	}


private pure func insert_boxed_storage_values(
	values: List[CoreBoxedStorageValue],
) -> List[CoreBoxedStorageValue]:
	values.map(insert_boxed_storage_value)


private pure func insert_tensor_literal_payload(
	payload: CoreTensorLiteralPayload,
) -> CoreTensorLiteralPayload:
	match payload:
		TensorRawLiteralPayload(raw):
			TensorRawLiteralPayload({
				raw_kind = raw.raw_kind,
				elements = insert_exprs(raw.elements),
			})
		TensorInlineStructLiteralPayload(inline_struct):
			TensorInlineStructLiteralPayload({
				struct_c_type = inline_struct.struct_c_type,
				elements = insert_exprs(inline_struct.elements),
			})


private pure func insert_dict_entry(entry: CoreDictEntry) -> CoreDictEntry:
	{
		key = insert_boxed_storage_value(entry.key),
		value = insert_boxed_storage_value(entry.value)
	}


private pure func insert_dict_entries(entries: List[CoreDictEntry]) -> List[CoreDictEntry]:
	entries.map(insert_dict_entry)


private pure func insert_dict_construct(construct: CoreDictConstruct) -> CoreDictConstruct:
	{
		constructor = construct.constructor,
		entries = insert_dict_entries(construct.entries),
		value_needs_release = construct.value_needs_release
	}


private pure func insert_list_construct(construct: CoreListConstruct) -> CoreListConstruct:
	{
		layout = construct.layout,
		elements = insert_boxed_storage_values(construct.elements),
		elem_needs_release = construct.elem_needs_release
	}


private pure func insert_list_alloc(alloc: CoreListAlloc) -> CoreListAlloc:
	{
		layout = alloc.layout,
		capacity = insert_cooperative_checkpoints_expr(alloc.capacity),
		elem_needs_release = alloc.elem_needs_release
	}


private pure func insert_list_get(get: CoreListGet) -> CoreListGet:
	{
		layout = get.layout,
		list = insert_cooperative_checkpoints_expr(get.list),
		index = insert_cooperative_checkpoints_expr(get.index),
		bounds = get.bounds
	}


private pure func insert_list_handoff(handoff: CoreListHandoff) -> CoreListHandoff:
	{
		mode = handoff.mode,
		layout = handoff.layout,
		elem_needs_release = handoff.elem_needs_release,
		source = insert_cooperative_checkpoints_expr(handoff.source),
		source_var = handoff.source_var,
		source_type = handoff.source_type,
		result_type = handoff.result_type,
		capacity = insert_cooperative_checkpoints_expr(handoff.capacity),
		result_var = handoff.result_var,
		len_var = handoff.len_var,
		out_var = handoff.out_var,
		body = insert_cooperative_checkpoints_expr(handoff.body),
		write_order = handoff.write_order
	}


private pure func insert_list_handoff_set_source_slot(
	slot: CoreListHandoffSetSourceSlot,
) -> CoreListHandoffSetSourceSlot:
	{
		result = insert_cooperative_checkpoints_expr(slot.result),
		out_index = insert_cooperative_checkpoints_expr(slot.out_index),
		source = insert_cooperative_checkpoints_expr(slot.source),
		source_index = insert_cooperative_checkpoints_expr(slot.source_index)
	}


private pure func insert_string_byte_read(read: CoreStringByteRead) -> CoreStringByteRead:
	{
		source = insert_cooperative_checkpoints_expr(read.source),
		index = insert_cooperative_checkpoints_expr(read.index)
	}


private pure func insert_string_byte_write(write: CoreStringByteWrite) -> CoreStringByteWrite:
	{
		target = insert_cooperative_checkpoints_expr(write.target),
		index = insert_cooperative_checkpoints_expr(write.index),
		byte = insert_cooperative_checkpoints_expr(write.byte)
	}


private pure func insert_string_byte_copy(copy: CoreStringByteCopy) -> CoreStringByteCopy:
	{
		dst = insert_cooperative_checkpoints_expr(copy.dst),
		dst_pos = insert_cooperative_checkpoints_expr(copy.dst_pos),
		src = insert_cooperative_checkpoints_expr(copy.src),
		src_pos = insert_cooperative_checkpoints_expr(copy.src_pos),
		len = insert_cooperative_checkpoints_expr(copy.len)
	}


private pure func insert_string_set_len(set_len: CoreStringSetLen) -> CoreStringSetLen:
	{
		target = insert_cooperative_checkpoints_expr(set_len.target),
		len = insert_cooperative_checkpoints_expr(set_len.len)
	}


private pure func insert_tensor_raw_read(read: CoreTensorRawRead) -> CoreTensorRawRead:
	{
		view = read.view,
		kind = read.kind,
		index = insert_cooperative_checkpoints_expr(read.index)
	}


private pure func insert_tensor_raw_write(write: CoreTensorRawWrite) -> CoreTensorRawWrite:
	{
		view = write.view,
		kind = write.kind,
		index = insert_cooperative_checkpoints_expr(write.index),
		value = insert_cooperative_checkpoints_expr(write.value)
	}


private pure func insert_tensor_raw_view_binding(
	binding: CoreTensorRawViewBinding,
) -> CoreTensorRawViewBinding:
	{
		variable = binding.variable,
		kind = binding.kind,
		source = insert_cooperative_checkpoints_expr(binding.source)
	}


private pure func insert_list_set(set: CoreListSet) -> CoreListSet:
	{
		layout = set.layout,
		list = insert_cooperative_checkpoints_expr(set.list),
		index = insert_cooperative_checkpoints_expr(set.index),
		value = insert_boxed_storage_value(set.value),
		value_is_stack_result = set.value_is_stack_result
	}


private pure func insert_list_swap(swap: CoreListSwap) -> CoreListSwap:
	{
		layout = swap.layout,
		list = insert_cooperative_checkpoints_expr(swap.list),
		left_index = insert_cooperative_checkpoints_expr(swap.left_index),
		right_index = insert_cooperative_checkpoints_expr(swap.right_index)
	}


private pure func insert_list_retain(retain: CoreListRetain) -> CoreListRetain:
	{
		list = insert_cooperative_checkpoints_expr(retain.list),
		value = insert_boxed_storage_value(retain.value)
	}


private pure func insert_record_fields(
	fields: List[CoreRecordFieldValue],
) -> List[CoreRecordFieldValue]:
	fields.map(func(field):
		{
			name = field.name,
			value = insert_cooperative_checkpoints_expr(field.value)
		}
	)


private pure func insert_concurrent_binding_checkpoints(
	binding: CoreConcurrentBinding,
) -> CoreConcurrentBinding:
	{
		variable = binding.variable,
		typ = binding.typ,
		rhs = insert_cooperative_checkpoints_expr(binding.rhs),
		task = binding.task
	}


private pure func insert_concurrent_bindings_checkpoints(
	bindings: List[CoreConcurrentBinding],
) -> List[CoreConcurrentBinding]:
	bindings.map(insert_concurrent_binding_checkpoints)


private pure func insert_optional_checkpoints(expr: Option[CoreExpr]) -> Option[CoreExpr]:
	CoreTraverse.map_core_optional_expr(expr, insert_cooperative_checkpoints_expr)


private pure func insert_concurrently_loop_checkpoints(
	loop: CoreConcurrentlyLoop,
	loc: CoreSourceLoc,
) -> CoreConcurrentlyLoop:
	{
		variable = loop.variable,
		item_type = loop.item_type,
		item_mode = loop.item_mode,
		iterable = insert_cooperative_checkpoints_expr(loop.iterable),
		body = checkpoint_loop_body(loc, insert_cooperative_checkpoints_expr(loop.body)),
		timeout = insert_optional_checkpoints(loop.timeout),
		limit = insert_cooperative_checkpoints_expr(loop.limit),
		output = loop.output,
		task = loop.task
	}


private pure func insert_concurrent_block_checkpoints(
	block: CoreConcurrentBlock,
) -> CoreConcurrentBlock:
	{
		bindings = insert_concurrent_bindings_checkpoints(block.bindings),
		body = insert_cooperative_checkpoints_expr(block.body),
		timeout = insert_optional_checkpoints(block.timeout),
		max_threads = block.max_threads
	}


private pure func insert_select_recv_arm(recv: CoreSelectRecvArm) -> CoreSelectRecvArm:
	{
		binder = recv.binder,
		elem_type = recv.elem_type,
		channel = insert_cooperative_checkpoints_expr(recv.channel)
	}


private pure func insert_select_arm_kind(kind: CoreSelectArmKind) -> CoreSelectArmKind:
	match kind:
		SelectRecvArm(recv):
			SelectRecvArm(insert_select_recv_arm(recv))
		SelectSealedArm(channel):
			SelectSealedArm(insert_cooperative_checkpoints_expr(channel))
		SelectAfterArm(timeout):
			SelectAfterArm(insert_cooperative_checkpoints_expr(timeout))


private pure func insert_select_arm(select_loc: CoreSourceLoc, arm: CoreSelectArm) -> CoreSelectArm:
	{
		kind = insert_select_arm_kind(arm.kind),
		body = checkpoint_loop_body(select_loc, insert_cooperative_checkpoints_expr(arm.body)),
		loc = arm.loc
	}


private pure func insert_select_arms(
	select_loc: CoreSourceLoc,
	arms: List[CoreSelectArm],
) -> List[CoreSelectArm]:
	arms.map(func(arm): insert_select_arm(select_loc, arm))


private pure func insert_literal_match_cases(
	cases: List[CoreLiteralMatchCase],
) -> List[CoreLiteralMatchCase]:
	cases.map(func(match_case):
		{
			literal = match_case.literal,
			bindings = match_case.bindings,
			body = insert_cooperative_checkpoints_expr(match_case.body)
		}
	)


private pure func insert_literal_match_fallback(
	fallback: CoreLiteralMatchFallback,
) -> CoreLiteralMatchFallback:
	match fallback:
		LiteralMatchFallbackBody(body):
			LiteralMatchFallbackBody(insert_cooperative_checkpoints_expr(body))
		LiteralMatchFallbackBindings(bindings, body):
			LiteralMatchFallbackBindings(bindings, insert_cooperative_checkpoints_expr(body))
		LiteralMatchFallbackFail:
			LiteralMatchFallbackFail


private pure func insert_constructor_literal_match(
	match_expr: CoreConstructorLiteralMatch,
) -> CoreConstructorLiteralMatch:
	{
		accessor = match_expr.accessor,
		scrutinee_type = match_expr.scrutinee_type,
		cases = insert_literal_match_cases(match_expr.cases),
		fallback = insert_literal_match_fallback(match_expr.fallback),
		result_type = match_expr.result_type,
		loc = match_expr.loc
	}


private pure func insert_constructor_length_match_branch(
	branch: CoreConstructorLengthMatchBranch,
) -> CoreConstructorLengthMatchBranch:
	{
		bindings = branch.bindings,
		body = insert_constructor_match_body(branch.body)
	}


private pure func insert_constructor_length_match_cases(
	cases: List[CoreConstructorLengthMatchCase],
) -> List[CoreConstructorLengthMatchCase]:
	cases.map(func(match_case):
		{
			length = match_case.length,
			branch = insert_constructor_length_match_branch(match_case.branch)
		}
	)


private pure func insert_constructor_length_match_geq(
	geq_case: Option[CoreConstructorLengthMatchGeq],
) -> Option[CoreConstructorLengthMatchGeq]:
	match geq_case:
		Some(existing_case):
			Some({
				minimum_length = existing_case.minimum_length,
				branch = insert_constructor_length_match_branch(existing_case.branch),
			})
		None:
			None


private pure func insert_constructor_length_match_fallback(
	fallback: Option[CoreConstructorLengthMatchBranch],
) -> Option[CoreConstructorLengthMatchBranch]:
	match fallback:
		Some(branch):
			Some(insert_constructor_length_match_branch(branch))
		None:
			None


private pure func insert_constructor_length_match(
	match_expr: CoreConstructorLengthMatch,
) -> CoreConstructorLengthMatch:
	{
		accessor = match_expr.accessor,
		cases = insert_constructor_length_match_cases(match_expr.cases),
		geq = insert_constructor_length_match_geq(match_expr.geq),
		fallback = insert_constructor_length_match_fallback(match_expr.fallback),
		result_type = match_expr.result_type,
		loc = match_expr.loc
	}


private pure func insert_constructor_match_body(
	body: CoreConstructorMatchBody,
) -> CoreConstructorMatchBody:
	match body:
		ConstructorMatchBodyExpr(expr):
			ConstructorMatchBodyExpr(insert_cooperative_checkpoints_expr(expr))
		ConstructorMatchBodyLiteral(match_expr):
			ConstructorMatchBodyLiteral(insert_constructor_literal_match(match_expr))
		ConstructorMatchBodyLength(match_expr):
			ConstructorMatchBodyLength(insert_constructor_length_match(match_expr))


private pure func insert_constructor_match_cases(
	cases: List[CoreConstructorMatchCase],
) -> List[CoreConstructorMatchCase]:
	cases.map(func(match_case):
		{
			constructor = match_case.constructor,
			accessor = match_case.accessor,
			test = match_case.test,
			bindings = match_case.bindings,
			body = insert_constructor_match_body(match_case.body)
		}
	)


private pure func insert_constructor_match_fallback(
	fallback: CoreConstructorMatchFallback,
) -> CoreConstructorMatchFallback:
	match fallback:
		ConstructorMatchFallbackBody(body):
			ConstructorMatchFallbackBody(insert_cooperative_checkpoints_expr(body))
		ConstructorMatchFallbackBindings(bindings, body):
			ConstructorMatchFallbackBindings(bindings, insert_cooperative_checkpoints_expr(body))
		ConstructorMatchFallbackFail:
			ConstructorMatchFallbackFail


pure func insert_cooperative_checkpoints_expr(expr: CoreExpr) -> CoreExpr:
	match expr:
		LiteralExpr(literal, typ, loc):
			expr
		VarExpr(variable, typ, loc):
			expr
		VoidExpr(typ, loc):
			expr
		DebugBlockExpr(body, typ, loc):
			DebugBlockExpr(insert_cooperative_checkpoints_expr(body), typ, loc)
		CooperativeCheckpointExpr(typ, loc):
			expr
		CallExpr(kind, callee, args, typ, loc):
			CallExpr(
				kind,
				insert_cooperative_checkpoints_expr(callee),
				insert_exprs(args),
				typ,
				loc,
			)
		BinaryExpr(op, left, right, typ, loc):
			BinaryExpr(
				op,
				insert_cooperative_checkpoints_expr(left),
				insert_cooperative_checkpoints_expr(right),
				typ,
				loc,
			)
		UnaryExpr(op, expr_value, typ, loc):
			UnaryExpr(op, insert_cooperative_checkpoints_expr(expr_value), typ, loc)
		LogicalExpr(op, left, right, typ, loc):
			LogicalExpr(
				op,
				insert_cooperative_checkpoints_expr(left),
				insert_cooperative_checkpoints_expr(right),
				typ,
				loc,
			)
		AssignExpr(variable, rhs, typ, loc):
			AssignExpr(variable, insert_cooperative_checkpoints_expr(rhs), typ, loc)
		CastExpr(expr_value, typ, loc):
			CastExpr(insert_cooperative_checkpoints_expr(expr_value), typ, loc)
		BoxExpr(box, typ, loc):
			BoxExpr(
				{
					kind = box.kind,
					value = insert_cooperative_checkpoints_expr(box.value),
					source_type = box.source_type
				},
				typ,
				loc,
			)
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			UnboxExpr(unbox_kind, insert_cooperative_checkpoints_expr(expr_value), typ, loc)
		FieldExpr(expr_value, field_name, typ, loc):
			FieldExpr(insert_cooperative_checkpoints_expr(expr_value), field_name, typ, loc)
		TupleFieldExpr(expr_value, field_index, typ, loc):
			TupleFieldExpr(insert_cooperative_checkpoints_expr(expr_value), field_index, typ, loc)
		TupleExpr(items, typ, loc):
			TupleExpr(insert_exprs(items), typ, loc)
		TupleConstructExpr(tuple_construct, typ, loc):
			TupleConstructExpr(
				{
					elements = insert_tuple_elements(tuple_construct.elements),
					release_mask = tuple_construct.release_mask,
					retain_mask = tuple_construct.retain_mask
				},
				typ,
				loc,
			)
		VectorExpr(items, typ, loc):
			VectorExpr(insert_exprs(items), typ, loc)
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			LambdaExpr(
				lambda_params,
				lambda_return_type,
				insert_cooperative_checkpoints_expr(lambda_body),
				lambda_is_pure,
				typ,
				loc,
			)
		ClosureCreateExpr(closure, typ, loc):
			ClosureCreateExpr(closure, typ, loc)
		ListConstructExpr(construct, typ, loc):
			ListConstructExpr(insert_list_construct(construct), typ, loc)
		ListAllocExpr(alloc, typ, loc):
			ListAllocExpr(insert_list_alloc(alloc), typ, loc)
		ListGetExpr(get, typ, loc):
			ListGetExpr(insert_list_get(get), typ, loc)
		ListHandoffExpr(handoff, typ, loc):
			ListHandoffExpr(insert_list_handoff(handoff), typ, loc)
		ListHandoffSetOwnedExpr(set, typ, loc):
			ListHandoffSetOwnedExpr(insert_list_set(set), typ, loc)
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			ListHandoffSetSourceSlotExpr(insert_list_handoff_set_source_slot(slot), typ, loc)
		StringByteReadExpr(read, typ, loc):
			StringByteReadExpr(insert_string_byte_read(read), typ, loc)
		StringByteWriteExpr(write, typ, loc):
			StringByteWriteExpr(insert_string_byte_write(write), typ, loc)
		StringByteCopyExpr(copy, typ, loc):
			StringByteCopyExpr(insert_string_byte_copy(copy), typ, loc)
		StringSetLenExpr(set_len, typ, loc):
			StringSetLenExpr(insert_string_set_len(set_len), typ, loc)
		TensorLiteralExpr(literal, typ, loc):
			TensorLiteralExpr(
				{
					shape = literal.shape,
					payload = insert_tensor_literal_payload(literal.payload)
				},
				typ,
				loc,
			)
		TensorBoxedLiteralExpr(literal, typ, loc):
			TensorBoxedLiteralExpr(
				{
					shape = literal.shape,
					elements = insert_boxed_storage_values(literal.elements),
					elem_needs_release = literal.elem_needs_release
				},
				typ,
				loc,
			)
		TensorPackedLiteralExpr(literal, typ, loc):
			TensorPackedLiteralExpr(
				{
					shape = literal.shape,
					elem_size = literal.elem_size,
					elements = insert_exprs(literal.elements)
				},
				typ,
				loc,
			)
		TensorRawFillExpr(fill, typ, loc):
			TensorRawFillExpr(
				{
					raw_kind = fill.raw_kind,
					value = insert_cooperative_checkpoints_expr(fill.value),
					dims = insert_exprs(fill.dims)
				},
				typ,
				loc,
			)
		TensorRawReadExpr(read, typ, loc):
			TensorRawReadExpr(insert_tensor_raw_read(read), typ, loc)
		TensorRawWriteExpr(write, typ, loc):
			TensorRawWriteExpr(insert_tensor_raw_write(write), typ, loc)
		TensorRawViewLetExpr(binding, body, typ, loc):
			TensorRawViewLetExpr(
				insert_tensor_raw_view_binding(binding),
				insert_cooperative_checkpoints_expr(body),
				typ,
				loc,
			)
		DictExpr(entries, typ, loc):
			DictExpr(insert_dict_literal_entries(entries), typ, loc)
		DictConstructExpr(construct, typ, loc):
			DictConstructExpr(insert_dict_construct(construct), typ, loc)
		SetAllocExpr(alloc, typ, loc):
			expr
		ListRetainExpr(retain, typ, loc):
			ListRetainExpr(insert_list_retain(retain), typ, loc)
		ListSetExpr(set, typ, loc):
			ListSetExpr(insert_list_set(set), typ, loc)
		ListSwapExpr(swap, typ, loc):
			ListSwapExpr(insert_list_swap(swap), typ, loc)
		RecordExpr(fields, typ, loc):
			RecordExpr(insert_record_fields(fields), typ, loc)
		RecordConstructExpr(type_name, fields, typ, loc):
			RecordConstructExpr(type_name, insert_record_fields(fields), typ, loc)
		UnionConstructExpr(construct, typ, loc):
			UnionConstructExpr(
				{
					type_name = construct.type_name,
					constructor_name = construct.constructor_name,
					constructor_c_name = construct.constructor_c_name,
					representation = construct.representation,
					payload_storage = construct.payload_storage,
					uses_release_mask = construct.uses_release_mask,
					release_mask = construct.release_mask,
					args = insert_boxed_storage_values(construct.args)
				},
				typ,
				loc,
			)
		UnionReuseConstructExpr(construct, typ, loc):
			UnionReuseConstructExpr(
				{
					source = insert_cooperative_checkpoints_expr(construct.source),
					type_name = construct.type_name,
					constructor_name = construct.constructor_name,
					constructor_c_name = construct.constructor_c_name,
					reuse_constructor_c_name = construct.reuse_constructor_c_name,
					representation = construct.representation,
					payload_storage = construct.payload_storage,
					uses_release_mask = construct.uses_release_mask,
					release_mask = construct.release_mask,
					args = insert_boxed_storage_values(construct.args)
				},
				typ,
				loc,
			)
		PreClosureDetachExpr(detached, typ, loc):
			PreClosureDetachExpr(insert_cooperative_checkpoints_expr(detached), typ, loc)
		DetachExpr(detached, typ, loc):
			expr
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			DupExpr(
				variable,
				value_type,
				retain_policy,
				insert_cooperative_checkpoints_expr(body),
				typ,
				loc,
			)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			DropExpr(
				variable,
				value_type,
				release_policy,
				insert_cooperative_checkpoints_expr(body),
				typ,
				loc,
			)
		LetExpr(name, is_mutable, typ, rhs, body):
			LetExpr(
				name,
				is_mutable,
				typ,
				insert_cooperative_checkpoints_expr(rhs),
				insert_cooperative_checkpoints_expr(body),
			)
		BorrowLetExpr(name, typ, rhs, body):
			BorrowLetExpr(
				name,
				typ,
				insert_cooperative_checkpoints_expr(rhs),
				insert_cooperative_checkpoints_expr(body),
			)
		SeqExpr(first, second):
			SeqExpr(
				insert_cooperative_checkpoints_expr(first),
				insert_cooperative_checkpoints_expr(second),
			)
		WhileExpr(cond, body, typ, loc):
			checked_body: CoreExpr = checkpoint_loop_body(
				loc,
				insert_cooperative_checkpoints_expr(body),
			)
			WhileExpr(insert_cooperative_checkpoints_expr(cond), checked_body, typ, loc)
		BreakExpr(typ, loc):
			expr
		ContinueExpr(typ, loc):
			expr
		ResourceScopeExpr(scope, typ, loc):
			ResourceScopeExpr(
				{
					variable = scope.variable,
					typ = scope.typ,
					acquire = insert_cooperative_checkpoints_expr(scope.acquire),
					body = insert_cooperative_checkpoints_expr(scope.body),
					cleanup = insert_cooperative_checkpoints_expr(scope.cleanup)
				},
				typ,
				loc,
			)
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			ResourceCleanupExitExpr(
				{
					cleanups = insert_exprs(cleanup_exit.cleanups),
					exit = cleanup_exit.exit
				},
				typ,
				loc,
			)
		TailrecLoopExpr(params, return_type, body, loc):
			checked_body: CoreExpr = checkpoint_loop_body(
				loc,
				insert_cooperative_checkpoints_expr(body),
			)
			TailrecLoopExpr(params, return_type, checked_body, loc)
		TailrecRecurExpr(args, typ, loc):
			TailrecRecurExpr(insert_exprs(args), typ, loc)
		TailrecListSpreadLoopExpr(loop, loc):
			TailrecListSpreadLoopExpr(
				insert_tailrec_list_spread_loop_checkpoints(loop, loc),
				loc,
			)
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			TailrecListSpreadRecurExpr(
				insert_tailrec_list_spread_rebinds(rebinds),
				cursor_advance,
				typ,
				loc,
			)
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			checked_body: CoreExpr = checkpoint_loop_body(
				loc,
				insert_cooperative_checkpoints_expr(body),
			)
			ForRangeExpr(
				binder,
				insert_cooperative_checkpoints_expr(start),
				insert_cooperative_checkpoints_expr(end_value),
				checked_body,
				typ,
				loc,
			)
		ForChannelExpr(for_channel, typ, loc):
			checked_body: CoreExpr = checkpoint_loop_body(
				loc,
				insert_cooperative_checkpoints_expr(for_channel.body),
			)
			ForChannelExpr(
				{
					binder = for_channel.binder,
					iterable = insert_cooperative_checkpoints_expr(for_channel.iterable),
					body = checked_body
				},
				typ,
				loc,
			)
		ForListExpr(for_list, typ, loc):
			checked_body: CoreExpr = checkpoint_loop_body(
				loc,
				insert_cooperative_checkpoints_expr(for_list.body),
			)
			ForListExpr(
				{
					binder = for_list.binder,
					layout = for_list.layout,
					iterable = insert_cooperative_checkpoints_expr(for_list.iterable),
					iterable_release_policy = for_list.iterable_release_policy,
					body = checked_body
				},
				typ,
				loc,
			)
		ForStringExpr(for_string, typ, loc):
			checked_body: CoreExpr = checkpoint_loop_body(
				loc,
				insert_cooperative_checkpoints_expr(for_string.body),
			)
			ForStringExpr(
				{
					binder = for_string.binder,
					iterable = insert_cooperative_checkpoints_expr(for_string.iterable),
					iterable_release_policy = for_string.iterable_release_policy,
					body = checked_body
				},
				typ,
				loc,
			)
		ForDictExpr(for_dict, typ, loc):
			checked_body: CoreExpr = checkpoint_loop_body(
				loc,
				insert_cooperative_checkpoints_expr(for_dict.body),
			)
			ForDictExpr(
				{
					binder = for_dict.binder,
					iterable = insert_cooperative_checkpoints_expr(for_dict.iterable),
					iterable_release_policy = for_dict.iterable_release_policy,
					body = checked_body
				},
				typ,
				loc,
			)
		ForSetExpr(for_set, typ, loc):
			checked_body: CoreExpr = checkpoint_loop_body(
				loc,
				insert_cooperative_checkpoints_expr(for_set.body),
			)
			ForSetExpr(
				{
					binder = for_set.binder,
					iterable = insert_cooperative_checkpoints_expr(for_set.iterable),
					iterable_release_policy = for_set.iterable_release_policy,
					body = checked_body
				},
				typ,
				loc,
			)
		ForResourceSourceExpr(for_resource_source, typ, loc):
			checked_body: CoreExpr = checkpoint_loop_body(
				loc,
				insert_cooperative_checkpoints_expr(for_resource_source.body),
			)
			ForResourceSourceExpr(
				{
					binder = for_resource_source.binder,
					iterable = insert_cooperative_checkpoints_expr(for_resource_source.iterable),
					iterable_release_policy = for_resource_source.iterable_release_policy,
					body = checked_body
				},
				typ,
				loc,
			)
		ForStreamExpr(for_stream, typ, loc):
			checked_body: CoreExpr = checkpoint_loop_body(
				loc,
				insert_cooperative_checkpoints_expr(for_stream.body),
			)
			ForStreamExpr(
				{
					binder = for_stream.binder,
					iterable = insert_cooperative_checkpoints_expr(for_stream.iterable),
					iterable_release_policy = for_stream.iterable_release_policy,
					body = checked_body
				},
				typ,
				loc,
			)
		ForTensorExpr(for_tensor, typ, loc):
			checked_body: CoreExpr = checkpoint_loop_body(
				loc,
				insert_cooperative_checkpoints_expr(for_tensor.body),
			)
			ForTensorExpr(
				{
					binder = for_tensor.binder,
					element_storage = clone_tensor_for_element_storage(for_tensor.element_storage),
					iterable = insert_cooperative_checkpoints_expr(for_tensor.iterable),
					iterable_release_policy = for_tensor.iterable_release_policy,
					body = checked_body
				},
				typ,
				loc,
			)
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			PreClosureConcurrentlyLoopExpr(
				{
					variable = loop.variable,
					item_type = loop.item_type,
					item_mode = loop.item_mode,
					iterable = insert_cooperative_checkpoints_expr(loop.iterable),
					body = checkpoint_loop_body(
						loc,
						insert_cooperative_checkpoints_expr(loop.body),
					),
					timeout = insert_optional_checkpoints(loop.timeout),
					limit = insert_cooperative_checkpoints_expr(loop.limit),
					output = loop.output
				},
				typ,
				loc,
			)
		DetachExpr(detached, typ, loc):
			expr
		ConcurrentlyLoopExpr(loop, typ, loc):
			ConcurrentlyLoopExpr(
				insert_concurrently_loop_checkpoints(loop, loc),
				typ,
				loc,
			)
		PreClosureConcurrentExpr(block, typ, loc):
			PreClosureConcurrentExpr(
				{
					bindings = block.bindings,
					body = insert_cooperative_checkpoints_expr(block.body),
					timeout = insert_optional_checkpoints(block.timeout),
					max_threads = block.max_threads
				},
				typ,
				loc,
			)
		ConcurrentExpr(block, typ, loc):
			ConcurrentExpr(insert_concurrent_block_checkpoints(block), typ, loc)
		SelectExpr(select_expr, typ, loc):
			SelectExpr(
				insert_select_arms(loc, select_expr),
				typ,
				loc,
			)
		RangeExpr(start, end_value, typ, loc):
			RangeExpr(
				insert_cooperative_checkpoints_expr(start),
				insert_cooperative_checkpoints_expr(end_value),
				typ,
				loc,
			)
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			AccessorLiteralMatchExpr(
				insert_cooperative_checkpoints_expr(scrutinee),
				scrutinee_release_policy,
				insert_constructor_literal_match(match_expr),
				typ,
				loc,
			)
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			LengthMatchExpr(
				insert_cooperative_checkpoints_expr(scrutinee),
				scrutinee_release_policy,
				insert_constructor_length_match(match_expr),
				typ,
				loc,
			)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			LiteralMatchExpr(
				insert_cooperative_checkpoints_expr(scrutinee),
				insert_literal_match_cases(cases),
				insert_literal_match_fallback(fallback),
				typ,
				loc,
			)
		RawMatchExpr(scrutinee, cases, typ, loc):
			RawMatchExpr(
				insert_cooperative_checkpoints_expr(scrutinee),
				cases.map(
					func(case): { case | body = insert_cooperative_checkpoints_expr(case.body) },
				),
				typ,
				loc,
			)
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, fallback, typ, loc):
			ConstructorMatchExpr(
				insert_cooperative_checkpoints_expr(scrutinee),
				scrutinee_release_policy,
				insert_constructor_match_cases(cases),
				insert_constructor_match_fallback(fallback),
				typ,
				loc,
			)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			IfExpr(
				insert_cooperative_checkpoints_expr(cond),
				insert_cooperative_checkpoints_expr(then_expr),
				insert_cooperative_checkpoints_expr(else_expr),
				typ,
				loc,
			)


private pure func insert_function(func_info: CoreFunction) -> CoreFunction:
	match func_info.body:
		Some(body):
			{ func_info | body = Some(insert_cooperative_checkpoints_expr(body)) }
		None:
			func_info


private pure func insert_global(global: CoreGlobal) -> CoreGlobal:
	{ global | init = insert_cooperative_checkpoints_expr(global.init) }


private pure func insert_decl(decl: CoreDecl) -> CoreDecl:
	match decl:
		FunctionDecl(func_info):
			FunctionDecl(insert_function(func_info))
		GlobalDecl(global):
			GlobalDecl(insert_global(global))
		EnumDecl(enum_decl):
			EnumDecl(enum_decl)
		UnionDecl(union_decl):
			UnionDecl(union_decl)
		ValueRecordDecl(record_decl):
			ValueRecordDecl(record_decl)
		HeapRecordDecl(record_decl):
			HeapRecordDecl(record_decl)
		TypeAliasDecl(alias_decl):
			TypeAliasDecl(alias_decl)
		TraitDecl(trait_decl):
			TraitDecl(trait_decl)
		ImplDecl(impl_decl):
			ImplDecl({ impl_decl | methods = impl_decl.methods.map(insert_function) })


pure func insert_cooperative_checkpoints(program: CoreProgram) -> CoreProgram:
	var decls: List[CoreDecl] = []

	for decl in program.decls:
		decls = decls.append(insert_decl(decl))

	{
		decls = decls,
		foreign_includes = program.foreign_includes
	}
