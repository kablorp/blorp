-- Runtime-declaration projection for the temporary semantic-middle boundary.
--
-- Monomorphization retains generic templates as specialization sources. The
-- remaining OCaml middle operates only on runtime declarations, except for the
-- global Option/Result ABI templates that specialization still requires.
import:
	compiler_core_json:
		CoreDecl(EnumDecl, FunctionDecl, HeapRecordDecl, ImplDecl, UnionDecl, ValueRecordDecl),
		CoreProgram,
		CoreType(TypeParameterType),
		CoreUnionDecl,
		CoreUnionField,
		CoreUnionPayloadStorage(ErasedUnionPayloadStorage),
		CoreUnionVariant,
	compiler_core_type_policy: core_impl_is_generic


private pure func abi_payload_matches(
	fields: List[CoreUnionField],
	expected_type_parameter: Option[String],
) -> Bool:
	match expected_type_parameter:
		Some(expected):
			if fields.length() != 1:
				False
			else:
				match fields.get(0):
					Some(field):
						match field.typ:
							TypeParameterType(name):
								name == expected
							_:
								False
					None:
						False
		None:
			fields.is_empty()


private pure func abi_variant_matches(
	variant: CoreUnionVariant,
	expected_name: String,
	expected_tag: Int,
	expected_type_parameter: Option[String],
) -> Bool:
	(
		variant.name == expected_name
		and variant.tag == expected_tag
		and abi_payload_matches(variant.fields, expected_type_parameter)
	)


private pure func is_global_abi_union_template(union_decl: CoreUnionDecl) -> Bool:
	has_erased_payload: Bool = match union_decl.payload_storage:
		ErasedUnionPayloadStorage:
			True
		_:
			False

	if not has_erased_payload:
		False
	else if union_decl.name == "Option":
		if union_decl.type_params != ["T"] or union_decl.variants.length() != 2:
			False
		else:
			match union_decl.variants.get(0):
				Some(some_variant):
					match union_decl.variants.get(1):
						Some(none_variant):
							(
								abi_variant_matches(some_variant, "Some", 0, Some("T"))
								and abi_variant_matches(none_variant, "None", 1, None)
							)
						None:
							False
				None:
					False
	else if union_decl.name == "Result":
		if union_decl.type_params != ["T", "E"] or union_decl.variants.length() != 2:
			False
		else:
			match union_decl.variants.get(0):
				Some(ok_variant):
					match union_decl.variants.get(1):
						Some(error_variant):
							(
								abi_variant_matches(ok_variant, "Ok", 0, Some("T"))
								and abi_variant_matches(error_variant, "Err", 1, Some("E"))
							)
						None:
							False
				None:
					False
	else:
		False


union SemanticMiddleProjectionError:
	SemanticMiddleMalformedRuntimeAbiUnion(String)


pure func semantic_middle_projection_error_message(error: SemanticMiddleProjectionError) -> String:
	match error:
		SemanticMiddleMalformedRuntimeAbiUnion(name):
			"reserved runtime ABI union `${name}` does not match its required " + "type parameters, variant order, tags, payloads, and erased storage"


private pure func project_semantic_middle_decl(
	decl: CoreDecl,
) -> Result[Option[CoreDecl], SemanticMiddleProjectionError]:
	match decl:
		FunctionDecl(function_info):
			if function_info.type_params.is_empty():
				Ok(Some(decl))
			else:
				Ok(None)
		EnumDecl(enum_decl):
			if enum_decl.type_params.is_empty():
				Ok(Some(decl))
			else:
				Ok(None)
		UnionDecl(union_decl):
			if union_decl.type_params.is_empty():
				Ok(Some(decl))
			else if union_decl.name == "Option" or union_decl.name == "Result":
				if is_global_abi_union_template(union_decl):
					Ok(Some(decl))
				else:
					Err(SemanticMiddleMalformedRuntimeAbiUnion(union_decl.name))
			else:
				Ok(None)
		ValueRecordDecl(record_decl):
			if record_decl.type_params.is_empty():
				Ok(Some(decl))
			else:
				Ok(None)
		HeapRecordDecl(record_decl):
			if record_decl.type_params.is_empty():
				Ok(Some(decl))
			else:
				Ok(None)
		ImplDecl(impl_decl):
			if core_impl_is_generic(impl_decl):
				Ok(None)
			else:
				Ok(Some(decl))
		_:
			Ok(Some(decl))


pure func project_semantic_middle_program(
	program: CoreProgram,
) -> Result[CoreProgram, SemanticMiddleProjectionError]:
	var decls: List[CoreDecl] = []
	var failure: Option[SemanticMiddleProjectionError] = None

	for decl in program.decls:
		match project_semantic_middle_decl(decl):
			Ok(Some(runtime_decl)):
				decls = decls.append(runtime_decl)
			Ok(None):
				void
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({
				decls = decls,
				foreign_includes = program.foreign_includes,
			})
