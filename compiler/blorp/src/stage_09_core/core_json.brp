		body = body,
		loc = loc,
	})


private pure func decode_core_select_arms(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreSelectArm], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreSelectArm] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_select_arm_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(arm):
						result = result.append(arm)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


