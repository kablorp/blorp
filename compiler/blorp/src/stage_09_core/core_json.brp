		("fields", JsonVector(variant.fields.map(core_union_field_to_json))),
		("def_id", option_int_to_json(variant.def_id)),
	])


pure func decode_core_union_variant_json(
	value: JsonValue,
	path: String,
) -> Result[CoreUnionVariant, CoreJsonError]:
	name ?= string_field(value, path, "name")
	c_name ?= string_field(value, path, "c_name")
	tag_c_name ?= string_field(value, path, "tag_c_name")
	tag ?= int_field(value, path, "tag")
	fields ?= decode_core_union_variant_fields(value, path, "fields")
	def_id ?= decode_optional_int(value, path, "def_id")

	Ok({
		name = name,
		c_name = c_name,
		tag_c_name = tag_c_name,
		tag = tag,
		fields = fields,
		def_id = def_id,
	})


private pure func decode_core_union_variants(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreUnionVariant], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreUnionVariant] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_union_variant_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(variant):
						result = result.append(variant)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


