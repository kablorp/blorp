private pure func core_pattern_to_json(pattern: CorePattern) -> JsonValue:
	match pattern:
		WildcardPattern:
			JsonObject([(KIND_FIELD, JsonString("wildcard"))])
		NamePattern(name):
			JsonObject([
				(KIND_FIELD, JsonString("name")),
				("name", JsonString(name)),
			])
		LiteralPattern(literal):
			JsonObject([
				(KIND_FIELD, JsonString("literal")),
				("literal", core_literal_to_json(literal)),
			])
		ConstructorPattern(name, args):
			JsonObject([
				(KIND_FIELD, JsonString("constructor")),
				("name", JsonString(name)),
				("args", JsonVector(args.map(core_pattern_to_json))),
			])
		QualifiedConstructorPattern(module_name, name, args):
			JsonObject([
				(KIND_FIELD, JsonString("qualified_constructor")),
				("module", JsonString(module_name)),
				("name", JsonString(name)),
				("args", JsonVector(args.map(core_pattern_to_json))),
			])
		TuplePattern(items):
			JsonObject([
				(KIND_FIELD, JsonString("tuple")),
				("items", JsonVector(items.map(core_pattern_to_json))),
			])
		ListPattern(items, spread):
			spread_json = match spread:
				Some(pattern):
					core_pattern_to_json(pattern)
				None:
					JsonNull

			JsonObject([
				(KIND_FIELD, JsonString("list")),
				("items", JsonVector(items.map(core_pattern_to_json))),
				("spread", spread_json),
			])
		OrPattern(items):
			JsonObject([
				(KIND_FIELD, JsonString("or")),
				("items", JsonVector(items.map(core_pattern_to_json))),
			])


private pure func core_raw_match_case_to_json(match_case: CoreRawMatchCase) -> JsonValue:
	JsonObject([
		("pattern", core_pattern_to_json(match_case.pattern)),
		("body", core_expr_to_json(match_case.body)),
	])


pure func core_semantic_match_accessor_to_json(accessor: CoreSemanticMatchAccessor) -> JsonValue:
	match accessor:
		RootSemanticMatchAccessor:
			JsonObject([(KIND_FIELD, JsonString(ROOT_ACCESSOR_TAG))])
		VariantFieldSemanticMatchAccessor(parent, constructor, field_index):
			JsonObject([
				(KIND_FIELD, JsonString(VARIANT_FIELD_ACCESSOR_TAG)),
				("parent", core_semantic_match_accessor_to_json(parent)),
				("constructor", JsonString(constructor)),
				("field_index", json_int(field_index)),
			])
		TupleFieldSemanticMatchAccessor(parent, index):
			JsonObject([
				(KIND_FIELD, JsonString(TUPLE_FIELD_ACCESSOR_TAG)),
				("parent", core_semantic_match_accessor_to_json(parent)),
				("index", json_int(index)),
			])
		ListElementSemanticMatchAccessor(parent, index):
			JsonObject([
				(KIND_FIELD, JsonString(LIST_ELEMENT_ACCESSOR_TAG)),
				("parent", core_semantic_match_accessor_to_json(parent)),
				("index", json_int(index)),
			])
		ListSpreadSemanticMatchAccessor(parent, offset):
			JsonObject([
				(KIND_FIELD, JsonString(LIST_SPREAD_ACCESSOR_TAG)),
				("parent", core_semantic_match_accessor_to_json(parent)),
				("offset", json_int(offset)),
			])


private pure func core_semantic_match_binding_to_json(
	binding: CoreSemanticMatchBinding,
) -> JsonValue:
	JsonObject([
		("variable", core_var_to_json(binding.variable)),
		("accessor", core_semantic_match_accessor_to_json(binding.accessor)),
		("mode", core_match_binding_mode_to_json(binding.mode)),
	])


private pure func optional_core_semantic_match_tree_to_json(
	tree: Option[CoreSemanticMatchTree],
) -> JsonValue:
	match tree:
		Some(existing_tree):
			core_semantic_match_tree_to_json(existing_tree)
		None:
			JsonNull


pure func core_semantic_match_tree_to_json(tree: CoreSemanticMatchTree) -> JsonValue:
	match tree:
		SemanticMatchLeaf(bindings, body):
			JsonObject([
				(KIND_FIELD, JsonString(SEMANTIC_MATCH_LEAF_TAG)),
				("bindings", JsonVector(bindings.map(core_semantic_match_binding_to_json))),
				("body", core_expr_to_json(body)),
			])
		SemanticMatchFail:
			JsonObject([(KIND_FIELD, JsonString(SEMANTIC_MATCH_FAIL_TAG))])
		SemanticConstructorMatch(accessor, cases, fallback):
			JsonObject([
				(KIND_FIELD, JsonString(SEMANTIC_MATCH_CONSTRUCTOR_TAG)),
				("accessor", core_semantic_match_accessor_to_json(accessor)),
				("cases", JsonVector(cases.map(
						func(match_case): JsonObject([
							("constructor", JsonString(match_case.constructor)),
							("body", core_semantic_match_tree_to_json(match_case.body)),
						]),
					))),
				("fallback", optional_core_semantic_match_tree_to_json(fallback)),
			])
		SemanticLiteralMatch(accessor, cases, fallback):
			JsonObject([
				(KIND_FIELD, JsonString(SEMANTIC_MATCH_LITERAL_TAG)),
				("accessor", core_semantic_match_accessor_to_json(accessor)),
				("cases", JsonVector(cases.map(
						func(match_case): JsonObject([
							("literal", core_literal_to_json(match_case.literal)),
							("body", core_semantic_match_tree_to_json(match_case.body)),
						]),
					))),
				("fallback", core_semantic_match_tree_to_json(fallback)),
			])
		SemanticLengthMatch(accessor, cases, geq, fallback):
			geq_json: JsonValue = match geq:
				Some(geq_case):
					JsonObject([
						("minimum_length", json_int(geq_case.minimum_length)),
						("body", core_semantic_match_tree_to_json(geq_case.body)),
					])
				None:
					JsonNull

			JsonObject([
				(KIND_FIELD, JsonString(SEMANTIC_MATCH_LENGTH_TAG)),
				("accessor", core_semantic_match_accessor_to_json(accessor)),
				("cases", JsonVector(cases.map(
						func(match_case): JsonObject([
							("length", json_int(match_case.length)),
							("body", core_semantic_match_tree_to_json(match_case.body)),
						]),
					))),
				("geq", geq_json),
				("fallback", optional_core_semantic_match_tree_to_json(fallback)),
			])


private pure func core_expr_raw_match_to_json(
	scrutinee: CoreExpr,
