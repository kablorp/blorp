	def_id ?= int_field(value, path, "def_id")
	c_name ?= string_field(value, path, "c_name")
	static_name ?= string_field(value, path, "static_name")
	captures ?= decode_core_closure_captures(value, path, "captures")

	Ok({
		function_name = function_name,
		def_id = def_id,
		c_name = c_name,
		static_name = static_name,
		captures = captures,
	})


private pure func foreign_link_platform_to_json(platform: CoreForeignLinkPlatform) -> JsonValue:
	match platform:
		CoreForeignLinux:
			JsonString(FOREIGN_LINK_LINUX_TAG)
		CoreForeignMacos:
			JsonString(FOREIGN_LINK_MACOS_TAG)


private pure func optional_foreign_link_platform_to_json(
	platform: Option[CoreForeignLinkPlatform],
) -> JsonValue:
	match platform:
		Some(value):
			foreign_link_platform_to_json(value)
		None:
			JsonNull


private pure func foreign_link_flag_to_json(link_flag: CoreForeignLinkFlag) -> JsonValue:
	JsonObject([
		("platform", optional_foreign_link_platform_to_json(link_flag.platform)),
		("flag", JsonString(link_flag.flag)),
	])


private pure func decode_foreign_link_platform(
	tag: String,
	path: String,
) -> Result[CoreForeignLinkPlatform, CoreJsonError]:
	if tag == FOREIGN_LINK_LINUX_TAG:
		Ok(CoreForeignLinux)
	else if tag == FOREIGN_LINK_MACOS_TAG:
		Ok(CoreForeignMacos)
	else:
		Err(CoreUnsupportedTag(path, tag))


private pure func decode_optional_foreign_link_platform(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[Option[CoreForeignLinkPlatform], CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match field:
		JsonNull:
			Ok(None)
		JsonString(tag):
			decode_foreign_link_platform(
				tag,
				path_field(path, field_name),
			).map(func(platform): Some(platform))
		_:
			Err(CoreExpectedStringField(path, field_name))


private pure func decode_foreign_link_flag_json(
	value: JsonValue,
	path: String,
) -> Result[CoreForeignLinkFlag, CoreJsonError]:
	platform ?= decode_optional_foreign_link_platform(value, path, "platform")
	flag ?= string_field(value, path, "flag")
	Ok({
		platform = platform,
		flag = flag,
	})


private pure func decode_foreign_link_flags(
	value: JsonValue,
	path: String,
) -> Result[List[CoreForeignLinkFlag], CoreJsonError]:
	items ?= array_field(value, path, "link_flags")
	var result: List[CoreForeignLinkFlag] = []
	var failure: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		if failure.is_none():
			match decode_foreign_link_flag_json(
				item,
				path_index(
					path_field(path, "link_flags"),
					index,
				),
			):
				Ok(link_flag):
					result = result.append(link_flag)
				Err(error):
					failure = Some(error)

		index += 1

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(result)


pure func core_function_kind_to_json(kind: CoreFunctionKind) -> JsonValue:
	match kind:
		UserFunction:
			JsonObject([(KIND_FIELD, JsonString(USER_FUNCTION_KIND_TAG))])
		UnresolvedBuiltinFunction:
			JsonObject([(KIND_FIELD, JsonString(UNRESOLVED_BUILTIN_FUNCTION_KIND_TAG))])
		BuiltinFunction(c_name):
			JsonObject([
				(KIND_FIELD, JsonString(BUILTIN_FUNCTION_KIND_TAG)),
				("c_name", JsonString(c_name)),
			])
		ForeignFunction(foreign_info):
			JsonObject([
				(KIND_FIELD, JsonString(FOREIGN_FUNCTION_KIND_TAG)),
				("c_name", JsonString(foreign_info.c_name)),
				("includes", strings_to_json(foreign_info.includes)),
				("link_flags", JsonVector(foreign_info.link_flags.map(foreign_link_flag_to_json))),
				("arg_passing", foreign_arg_passing_to_json(foreign_info.arg_passing)),
			])
		ClosureBodyFunction(abi):
			JsonObject([
				(KIND_FIELD, JsonString(CLOSURE_BODY_FUNCTION_KIND_TAG)),
				("abi", core_closure_abi_to_json(abi)),
			])


pure func decode_core_function_kind_json(
	value: JsonValue,
	path: String,
) -> Result[CoreFunctionKind, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == USER_FUNCTION_KIND_TAG:
		Ok(UserFunction)
	else if tag == UNRESOLVED_BUILTIN_FUNCTION_KIND_TAG:
		Ok(UnresolvedBuiltinFunction)
	else if tag == BUILTIN_FUNCTION_KIND_TAG:
		c_name ?= string_field(value, path, "c_name")
		Ok(BuiltinFunction(c_name))
	else if tag == FOREIGN_FUNCTION_KIND_TAG:
		c_name ?= string_field(value, path, "c_name")
		includes ?= decode_string_list(value, path, "includes")
		link_flags ?= decode_foreign_link_flags(value, path)
		arg_passing_json ?= object_field(value, path, "arg_passing")
		arg_passing ?= decode_foreign_arg_passing_json(
			arg_passing_json,
			path_field(path, "arg_passing"),
		)
		Ok(ForeignFunction({
			c_name = c_name,
			includes = includes,
			link_flags = link_flags,
			arg_passing = arg_passing,
		}))
	else if tag == CLOSURE_BODY_FUNCTION_KIND_TAG:
		abi_json ?= object_field(value, path, "abi")
		abi ?= decode_core_closure_abi_json(
			abi_json,
			path_field(path, "abi"),
		)
		Ok(ClosureBodyFunction(abi))
	else:
		Err(CoreUnsupportedTag(path, tag))


private pure func option_expr_to_json(body: Option[CoreExpr]) -> JsonValue:
	match body:
		Some(expr):
			core_expr_to_json(expr)
		None:
			JsonNull


private pure func decode_optional_expr(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[Option[CoreExpr], CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match field:
		JsonNull:
			Ok(None)
		JsonObject(fields):
			expr ?= decode_core_expr_json(
				JsonObject(fields),
				path_field(path, field_name),
			)
			Ok(Some(expr))
		JsonBool(flag):
			Err(CoreExpectedObjectField(path, field_name))
		JsonNumber(number):
			Err(CoreExpectedObjectField(path, field_name))
		JsonString(text):
			Err(CoreExpectedObjectField(path, field_name))
		JsonVector(items):
			Err(CoreExpectedObjectField(path, field_name))


pure func core_function_to_json(core_func: CoreFunction) -> JsonValue:
	JsonObject([
		(KIND_FIELD, JsonString(FUNCTION_TAG)),
		("name", JsonString(core_func.name)),
		("module", option_string_to_json(core_func.source_module)),
		("type_params", strings_to_json(core_func.type_params)),
		("params", core_params_to_json(core_func.params)),
		("return_type", core_type_to_json(core_func.return_type)),
		("body", option_expr_to_json(core_func.body)),
		("pure", JsonBool(core_func.is_pure)),
		("function_kind", core_function_kind_to_json(core_func.function_kind)),
		("def_id", json_int(core_func.def_id)),
		("loc", source_loc_to_json(core_func.loc)),
	])


pure func decode_core_function_json(
	value: JsonValue,
	path: String,
) -> Result[CoreFunction, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag != FUNCTION_TAG:
		Err(CoreUnsupportedTag(path, tag))
	else:
		name ?= string_field(value, path, "name")
		source_module ?= decode_optional_string(value, path, "module")
		type_params ?= decode_string_list(value, path, "type_params")
		params ?= decode_core_params(value, path, "params")
		return_type_json ?= object_field(value, path, "return_type")
		return_type ?= decode_core_type_json(
			return_type_json,
			path_field(path, "return_type"),
		)
		body ?= decode_optional_expr(value, path, "body")
		is_pure ?= bool_field(value, path, "pure")
		function_kind_json ?= object_field(value, path, "function_kind")
		function_kind ?= decode_core_function_kind_json(
			function_kind_json,
			path_field(path, "function_kind"),
		)
		def_id ?= int_field(value, path, "def_id")
		loc_json ?= object_field(value, path, "loc")
		loc ?= decode_source_loc_json(
			loc_json,
			path_field(path, "loc"),
		)

		Ok({
			name = name,
			source_module = source_module,
			type_params = type_params,
			params = params,
			return_type = return_type,
			body = body,
			is_pure = is_pure,
			function_kind = function_kind,
			def_id = def_id,
			loc = loc,
		})


private pure func decode_core_functions(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreFunction], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreFunction] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		if error.is_none():
			match decode_core_function_json(
				item,
				path_index(
					path_field(path, field_name),
					index,
				),
			):
				Ok(core_func):
					result = result.append(core_func)
				Err(err):
					error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func core_global_to_json(global: CoreGlobal) -> JsonValue:
	JsonObject([
		(KIND_FIELD, JsonString(GLOBAL_TAG)),
		("name", core_var_to_json(global.name)),
		("source_module", option_string_to_json(global.source_module)),
		("type", core_type_to_json(global.typ)),
		("init", core_expr_to_json(global.init)),
		("mutable", JsonBool(global.is_mutable)),
		("const", JsonBool(global.is_const)),
		("private", JsonBool(global.is_private)),
		("def_id", json_int(global.def_id)),
		("loc", source_loc_to_json(global.loc)),
	])


pure func decode_core_global_json(
	value: JsonValue,
	path: String,
) -> Result[CoreGlobal, CoreJsonError]:
	name_json ?= object_field(value, path, "name")
	name ?= decode_core_var_json(
		name_json,
		path_field(path, "name"),
	)
	source_module ?= decode_optional_string(value, path, "source_module")
	type_json ?= object_field(value, path, "type")
	typ ?= decode_core_type_json(
		type_json,
		path_field(path, "type"),
	)
	init_json ?= object_field(value, path, "init")
	init ?= decode_core_expr_json(
		init_json,
		path_field(path, "init"),
	)
	is_mutable ?= bool_field(value, path, "mutable")
	is_const ?= bool_field(value, path, "const")
	is_private ?= bool_field(value, path, "private")
	def_id ?= int_field(value, path, "def_id")
	loc_json ?= object_field(value, path, "loc")
	loc ?= decode_source_loc_json(
		loc_json,
		path_field(path, "loc"),
	)

	Ok({
		name = name,
		source_module = source_module,
		typ = typ,
		init = init,
		is_mutable = is_mutable,
		is_const = is_const,
		is_private = is_private,
		def_id = def_id,
		loc = loc,
	})


