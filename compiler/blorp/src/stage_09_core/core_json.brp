private pure func decode_core_concurrent_bindings(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreConcurrentBinding], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreConcurrentBinding] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_concurrent_binding_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(binding):
						result = result.append(binding)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


private pure func decode_core_pre_closure_concurrent_bindings(
	value: JsonValue,
