record CoreRawMatchCase {
	pattern: CorePattern,
	body: CoreExpr
}


union CoreSemanticMatchAccessor:
	RootSemanticMatchAccessor
	VariantFieldSemanticMatchAccessor(CoreSemanticMatchAccessor, String, Int)
	TupleFieldSemanticMatchAccessor(CoreSemanticMatchAccessor, Int)
	ListElementSemanticMatchAccessor(CoreSemanticMatchAccessor, Int)
	ListSpreadSemanticMatchAccessor(CoreSemanticMatchAccessor, Int)


record CoreSemanticMatchBinding {
	variable: CoreVar,
	accessor: CoreSemanticMatchAccessor,
	mode: CoreMatchBindingMode
}


record CoreSemanticConstructorMatchCase {
	constructor: String,
	body: CoreSemanticMatchTree
}


