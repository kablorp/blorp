	else if tag == TUPLE_CONSTRUCT_EXPR_TAG:
		decode_core_expr_tuple_construct_from_json(value, path)
	else if tag == VECTOR_EXPR_TAG:
		decode_core_expr_vector_from_json(value, path)
	else if tag == LAMBDA_EXPR_TAG:
		decode_core_expr_lambda_from_json(value, path)
	else if tag == CLOSURE_CREATE_EXPR_TAG:
