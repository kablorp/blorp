private pure func decode_core_pattern_list_json(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CorePattern], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var patterns: List[CorePattern] = []
	var failure: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		if failure.is_none():
			match decode_core_pattern_json(
				item,
				path_index(
					path_field(path, field_name),
					index,
				),
			):
				Ok(pattern):
					patterns = patterns.append(pattern)
				Err(error):
					failure = Some(error)

		index += 1

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(patterns)


private pure func decode_optional_core_pattern_json(
	value: JsonValue,
	path: String,
) -> Result[Option[CorePattern], CoreJsonError]:
	match value:
		JsonNull:
			Ok(None)
		_:
			match decode_core_pattern_json(value, path):
				Ok(pattern):
					Ok(Some(pattern))
				Err(error):
					Err(error)


private pure func decode_core_pattern_json(
	value: JsonValue,
	path: String,
) -> Result[CorePattern, CoreJsonError]:
	tag ?= kind_field(value, path)

	match tag:
		"wildcard":
			Ok(WildcardPattern)
		"name":
			name ?= string_field(value, path, "name")
			Ok(NamePattern(name))
		"literal":
			literal_json ?= object_field(value, path, "literal")
			literal ?= decode_core_literal_json(
				literal_json,
				path_field(path, "literal"),
			)
			Ok(LiteralPattern(literal))
		"constructor":
			name ?= string_field(value, path, "name")
			args ?= decode_core_pattern_list_json(value, path, "args")
			Ok(ConstructorPattern(name, args))
		"qualified_constructor":
			module_name ?= string_field(value, path, "module")
			name ?= string_field(value, path, "name")
			args ?= decode_core_pattern_list_json(value, path, "args")
			Ok(QualifiedConstructorPattern(module_name, name, args))
		"tuple":
			items ?= decode_core_pattern_list_json(value, path, "items")
			Ok(TuplePattern(items))
		"list":
			items ?= decode_core_pattern_list_json(value, path, "items")
			spread_json ?= object_field(value, path, "spread")
			spread ?= decode_optional_core_pattern_json(
				spread_json,
				path_field(path, "spread"),
			)

			Ok(ListPattern(items, spread))
		"or":
			items ?= decode_core_pattern_list_json(value, path, "items")
			Ok(OrPattern(items))
		_:
			Err(CoreUnsupportedTag(path, tag))


private pure func decode_core_raw_match_cases(
	value: JsonValue,
	path: String,
) -> Result[List[CoreRawMatchCase], CoreJsonError]:
	items ?= array_field(value, path, "cases")
	var cases: List[CoreRawMatchCase] = []
	var failure: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		if failure.is_none():
			item_path = path_index(
				path_field(path, "cases"),
				index,
			)

			pattern_result = match object_field(item, item_path, "pattern"):
				Ok(pattern_json):
					decode_core_pattern_json(
						pattern_json,
						path_field(item_path, "pattern"),
					)
				Err(error):
					Err(error)

			match pattern_result:
				Ok(pattern):
					match object_field(item, item_path, "body"):
						Ok(body_json):
							match decode_core_expr_json(
								body_json,
								path_field(item_path, "body"),
							):
								Ok(body):
									cases = cases.append({
										pattern = pattern,
										body = body,
									})
								Err(error):
									failure = Some(error)
						Err(error):
							failure = Some(error)
				Err(error):
					failure = Some(error)

		index += 1

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(cases)


private pure func decode_core_semantic_match_accessor_parent(
