private pure func decode_optional_core_semantic_match_tree_json(
	value: JsonValue,
	path: String,
) -> Result[Option[CoreSemanticMatchTree], CoreJsonError]:
	match value:
		JsonNull:
			Ok(None)
		_:
			tree ?= decode_core_semantic_match_tree_json(value, path)
			Ok(Some(tree))


private pure func decode_optional_core_semantic_length_match_geq_json(
	value: JsonValue,
	path: String,
) -> Result[Option[CoreSemanticLengthMatchGeq], CoreJsonError]:
	match value:
		JsonNull:
			Ok(None)
		_:
			minimum_length ?= int_field(value, path, "minimum_length")
			body_json ?= object_field(value, path, "body")
			body ?= decode_core_semantic_match_tree_json(
				body_json,
				path_field(path, "body"),
			)
			Ok(Some({
				minimum_length = minimum_length,
				body = body,
			}))


pure func decode_core_semantic_match_tree_json(
	value: JsonValue,
	path: String,
) -> Result[CoreSemanticMatchTree, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == SEMANTIC_MATCH_LEAF_TAG:
		bindings ?= decode_json_array_field(
			value,
			path,
			"bindings",
			decode_core_semantic_match_binding_json,
		)
		body_json ?= object_field(value, path, "body")
		body ?= decode_core_expr_json(
			body_json,
			path_field(path, "body"),
		)
		Ok(SemanticMatchLeaf(bindings, body))
	else if tag == SEMANTIC_MATCH_FAIL_TAG:
		Ok(SemanticMatchFail)
	else if tag == SEMANTIC_MATCH_CONSTRUCTOR_TAG:
		accessor_json ?= object_field(value, path, "accessor")
		accessor ?= decode_core_semantic_match_accessor_json(
			accessor_json,
			path_field(path, "accessor"),
		)
		cases ?= decode_json_array_field(
			value,
			path,
			"cases",
			decode_core_semantic_constructor_match_case_json,
		)
		fallback_json ?= required_field(value, path, "fallback")
		fallback ?= decode_optional_core_semantic_match_tree_json(
			fallback_json,
			path_field(path, "fallback"),
		)
		Ok(SemanticConstructorMatch(accessor, cases, fallback))
	else if tag == SEMANTIC_MATCH_LITERAL_TAG:
		accessor_json ?= object_field(value, path, "accessor")
		accessor ?= decode_core_semantic_match_accessor_json(
			accessor_json,
			path_field(path, "accessor"),
		)
		cases ?= decode_json_array_field(
			value,
			path,
			"cases",
			decode_core_semantic_literal_match_case_json,
		)
		fallback_json ?= object_field(value, path, "fallback")
		fallback ?= decode_core_semantic_match_tree_json(
			fallback_json,
			path_field(path, "fallback"),
		)
		Ok(SemanticLiteralMatch(accessor, cases, fallback))
	else if tag == SEMANTIC_MATCH_LENGTH_TAG:
		accessor_json ?= object_field(value, path, "accessor")
		accessor ?= decode_core_semantic_match_accessor_json(
			accessor_json,
			path_field(path, "accessor"),
		)
		cases ?= decode_json_array_field(
			value,
			path,
			"cases",
			decode_core_semantic_length_match_case_json,
		)
		geq_json ?= required_field(value, path, "geq")
		geq ?= decode_optional_core_semantic_length_match_geq_json(
			geq_json,
			path_field(path, "geq"),
		)
		fallback_json ?= required_field(value, path, "fallback")
		fallback ?= decode_optional_core_semantic_match_tree_json(
			fallback_json,
			path_field(path, "fallback"),
		)
		Ok(SemanticLengthMatch(accessor, cases, geq, fallback))
	else:
		Err(CoreUnsupportedTag(path, tag))


private pure func decode_core_expr_raw_match_from_json(
	value: JsonValue,
	path: String,
) -> Result[CoreExpr, CoreJsonError]:
	scrutinee_json ?= object_field(value, path, "scrutinee")
	scrutinee ?= decode_core_expr_json(
		scrutinee_json,
		path_field(path, "scrutinee"),
	)
	cases ?= decode_core_raw_match_cases(value, path)
	type_json ?= object_field(value, path, "type")
	typ ?= decode_core_type_json(
		type_json,
		path_field(path, "type"),
	)
	loc_json ?= object_field(value, path, "loc")
	loc ?= decode_source_loc_json(
		loc_json,
		path_field(path, "loc"),
	)

	Ok(RawMatchExpr(scrutinee, cases, typ, loc))


