pure func core_tensor_raw_scalar_kind_to_json(kind: CoreTensorRawScalarKind) -> JsonValue:
	match kind:
		TensorFloat64Elements:
			JsonString(TENSOR_RAW_FLOAT64_TAG)
		TensorFloat32Elements:
			JsonString(TENSOR_RAW_FLOAT32_TAG)
		TensorInt64Elements:
			JsonString(TENSOR_RAW_INT64_TAG)


pure func decode_core_tensor_raw_scalar_kind_json(
	value: JsonValue,
	path: String,
) -> Result[CoreTensorRawScalarKind, CoreJsonError]:
	match as_string(value):
		Some(tag):
			if tag == TENSOR_RAW_FLOAT64_TAG:
				Ok(TensorFloat64Elements)
			else if tag == TENSOR_RAW_FLOAT32_TAG:
				Ok(TensorFloat32Elements)
			else if tag == TENSOR_RAW_INT64_TAG:
				Ok(TensorInt64Elements)
			else:
				Err(CoreUnsupportedTag(path, tag))
		None:
			Err(CoreExpectedStringField(path, "kind"))


pure func core_tensor_literal_shape_to_json(shape: CoreTensorLiteralShape) -> JsonValue:
	match shape:
		TensorVectorLength(length):
			JsonObject([
				(KIND_FIELD, JsonString(TENSOR_LITERAL_VECTOR_SHAPE_TAG)),
				("length", json_int(length)),
			])
		TensorStaticShape(dims):
			JsonObject([
				(KIND_FIELD, JsonString(TENSOR_LITERAL_STATIC_SHAPE_TAG)),
				("dims", ints_to_json(dims)),
			])


pure func decode_core_tensor_literal_shape_json(
	value: JsonValue,
	path: String,
) -> Result[CoreTensorLiteralShape, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == TENSOR_LITERAL_VECTOR_SHAPE_TAG:
		length ?= int_field(value, path, "length")
		Ok(TensorVectorLength(length))
	else if tag == TENSOR_LITERAL_STATIC_SHAPE_TAG:
		dims ?= decode_int_list(value, path, "dims")
		Ok(TensorStaticShape(dims))
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_tensor_literal_to_json(literal: CoreTensorLiteral) -> JsonValue:
	JsonObject([
		("shape", core_tensor_literal_shape_to_json(literal.shape)),
		("payload", core_tensor_literal_payload_to_json(literal.payload)),
	])


pure func core_tensor_literal_payload_to_json(payload: CoreTensorLiteralPayload) -> JsonValue:
	match payload:
		TensorRawLiteralPayload(raw):
			JsonObject([
				(KIND_FIELD, JsonString(TENSOR_LITERAL_RAW_PAYLOAD_TAG)),
				("raw_kind", core_tensor_raw_scalar_kind_to_json(raw.raw_kind)),
				("elements", core_expr_list_to_json(raw.elements)),
			])
		TensorInlineStructLiteralPayload(inline_struct):
			JsonObject([
				(KIND_FIELD, JsonString(TENSOR_LITERAL_INLINE_STRUCT_PAYLOAD_TAG)),
				("struct_c_type", JsonString(inline_struct.struct_c_type)),
				("elements", core_expr_list_to_json(inline_struct.elements)),
			])


pure func decode_core_tensor_literal_json(
	value: JsonValue,
	path: String,
) -> Result[CoreTensorLiteral, CoreJsonError]:
	shape_json ?= object_field(value, path, "shape")
	shape ?= decode_core_tensor_literal_shape_json(
		shape_json,
		path_field(path, "shape"),
	)
	payload_json ?= object_field(value, path, "payload")
	payload ?= decode_core_tensor_literal_payload_json(
		payload_json,
		path_field(path, "payload"),
	)

	Ok({
		shape = shape,
		payload = payload,
	})


pure func decode_core_tensor_literal_payload_json(
	value: JsonValue,
	path: String,
) -> Result[CoreTensorLiteralPayload, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == TENSOR_LITERAL_RAW_PAYLOAD_TAG:
		raw_kind_json ?= required_field(value, path, "raw_kind")
		raw_kind ?= decode_core_tensor_raw_scalar_kind_json(
			raw_kind_json,
			path_field(path, "raw_kind"),
		)
		elements ?= decode_core_expr_list(value, path, "elements")

		Ok(TensorRawLiteralPayload({
			raw_kind = raw_kind,
			elements = elements,
		}))
	else if tag == TENSOR_LITERAL_INLINE_STRUCT_PAYLOAD_TAG:
		struct_c_type ?= string_field(value, path, "struct_c_type")
		elements ?= decode_core_expr_list(value, path, "elements")

		Ok(TensorInlineStructLiteralPayload({
			struct_c_type = struct_c_type,
			elements = elements,
		}))
	else:
		Err(CoreUnsupportedTag(path, tag))


