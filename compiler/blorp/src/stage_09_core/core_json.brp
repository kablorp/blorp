pure func core_decl_to_json(decl: CoreDecl) -> JsonValue:
	match decl:
		FunctionDecl(core_func):
			core_function_to_json(core_func)
		GlobalDecl(global):
			core_global_to_json(global)
		EnumDecl(enum_decl):
			core_enum_decl_to_json(enum_decl)
		UnionDecl(union_decl):
			core_union_decl_to_json(union_decl)
		ValueRecordDecl(record_decl):
			core_value_record_decl_to_json(record_decl)
		HeapRecordDecl(record_decl):
			core_heap_record_decl_to_json(record_decl)
		TypeAliasDecl(alias_decl):
			core_type_alias_decl_to_json(alias_decl)
		TraitDecl(trait_decl):
			core_trait_decl_to_json(trait_decl)
		ImplDecl(impl_decl):
			core_impl_decl_to_json(impl_decl)


pure func decode_core_decl_json(value: JsonValue, path: String) -> Result[CoreDecl, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == FUNCTION_TAG:
		core_func ?= decode_core_function_json(value, path)
		Ok(FunctionDecl(core_func))
	else if tag == GLOBAL_TAG:
		global ?= decode_core_global_json(value, path)
		Ok(GlobalDecl(global))
	else if tag == ENUM_DECL_TAG:
		enum_decl ?= decode_core_enum_decl_json(value, path)
		Ok(EnumDecl(enum_decl))
	else if tag == UNION_DECL_TAG:
		union_decl ?= decode_core_union_decl_json(value, path)
		Ok(UnionDecl(union_decl))
	else if tag == VALUE_RECORD_DECL_TAG:
		record_decl ?= decode_core_value_record_decl_json(value, path)
		Ok(ValueRecordDecl(record_decl))
	else if tag == HEAP_RECORD_DECL_TAG:
		record_decl ?= decode_core_heap_record_decl_json(value, path)
		Ok(HeapRecordDecl(record_decl))
	else if tag == TYPE_ALIAS_DECL_TAG:
		alias_decl ?= decode_core_type_alias_decl_json(value, path)
		Ok(TypeAliasDecl(alias_decl))
	else if tag == TRAIT_DECL_TAG:
		trait_decl ?= decode_core_trait_decl_json(value, path)
		Ok(TraitDecl(trait_decl))
	else if tag == IMPL_DECL_TAG:
		impl_decl ?= decode_core_impl_decl_json(value, path)
		Ok(ImplDecl(impl_decl))
	else:
		Err(CoreUnsupportedTag(path, tag))


private pure func decode_core_decls(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreDecl], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreDecl] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_decl_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(decl):
						result = result.append(decl)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func core_program_to_json(program: CoreProgram) -> JsonValue:
	JsonObject([
		(KIND_FIELD, JsonString(PROGRAM_TAG)),
		("decls", JsonVector(program.decls.map(core_decl_to_json))),
		("foreign_includes", strings_to_json(program.foreign_includes)),
	])


private union CoreJsonRecordStorage:
	JsonValueRecordStorage
	JsonHeapRecordStorage


private record CoreJsonRecordShape {
	name: String,
	storage: CoreJsonRecordStorage,
	field_names: List[String]
}


private pure func core_json_record_shapes(decls: List[CoreDecl]) -> List[CoreJsonRecordShape]:
	var shapes: List[CoreJsonRecordShape] = []

	for decl in decls:
		match decl:
			ValueRecordDecl(record_decl):
				shapes = shapes.append({
					name = record_decl.name,
					storage = JsonValueRecordStorage,
					field_names = record_decl.fields.map(func(field): field.name),
				})
			HeapRecordDecl(record_decl):
				shapes = shapes.append({
					name = record_decl.name,
					storage = JsonHeapRecordStorage,
					field_names = record_decl.fields.map(func(field): field.name),
				})
			_:
				void

	shapes


private pure func optional_json_object_kind(fields: List[(String, JsonValue)]) -> Option[String]:
	var result: Option[String] = None

	for (name, value) in fields:
		if name == KIND_FIELD:
			match value:
				JsonString(kind):
					result = Some(kind)
				_:
					void

			break

	result


private pure func string_lists_equal(left: List[String], right: List[String]) -> Bool:
	match (left, right):
		([], []):
			True
		([left_head, ...left_tail], [right_head, ...right_tail]):
			left_head == right_head and string_lists_equal(left_tail, right_tail)
		_:
			False


private pure func same_record_storage(
	left: CoreJsonRecordStorage,
	right: CoreJsonRecordStorage,
) -> Bool:
	match (left, right):
		(JsonValueRecordStorage, JsonValueRecordStorage):
			True
		(JsonHeapRecordStorage, JsonHeapRecordStorage):
			True
		_:
			False


private pure func record_shape_matches(
	shape: CoreJsonRecordShape,
	record_name: String,
	storage: CoreJsonRecordStorage,
) -> Bool:
	shape.name == record_name and same_record_storage(shape.storage, storage)


private pure func record_update_field_names(
	value: JsonValue,
	path: String,
) -> Result[List[String], CoreJsonError]:
	field_values ?= array_field(value, path, "fields")
	var names: List[String] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for field_value in field_values:
		match error:
			Some(_):
				void
			None:
				match string_field(
					field_value,
					path_index(
						path_field(path, "fields"),
						index,
					),
					"name",
				):
					Ok(name):
						names = names.append(name)
					Err(field_error):
						error = Some(field_error)

		index += 1

	match error:
		Some(field_error):
			Err(field_error)
		None:
			Ok(names)


private pure func validate_record_update_json_shape(
	value: JsonValue,
	path: String,
	shapes: List[CoreJsonRecordShape],
) -> Result[Void, CoreJsonError]:
	type_value ?= object_field(value, path, "type")
	type_path: String = path_field(path, "type")
	type_tag ?= kind_field(type_value, type_path)

	if type_tag != VALUE_RECORD_TYPE_TAG and type_tag != HEAP_RECORD_TYPE_TAG:
		Err(CoreInvalidRecordUpdateShape(path, "record update type must be a value or heap record"))
	else:
		record_name ?= string_field(type_value, type_path, "name")
		actual_names ?= record_update_field_names(value, path)

		expected_storage: CoreJsonRecordStorage = if type_tag == HEAP_RECORD_TYPE_TAG:
			JsonHeapRecordStorage
		else:
			JsonValueRecordStorage

		match shapes.find(func(shape): record_shape_matches(shape, record_name, expected_storage)):
			Some(shape):
				if string_lists_equal(actual_names, shape.field_names):
					Ok(void)
				else:
					Err(
						CoreInvalidRecordUpdateShape(
							path_field(path, "fields"),
							"record update for `${record_name}` must contain every declared field exactly once in declaration order",
						),
					)
			None:
				missing_detail: String = if type_tag == HEAP_RECORD_TYPE_TAG:
					"record update type `${record_name}` has no matching heap-record declaration"
				else:
					"record update type `${record_name}` has no matching value-record declaration"

				Err(CoreInvalidRecordUpdateShape(path_field(path, "type"), missing_detail))


private pure func validate_record_reuse_json_shape(
	value: JsonValue,
	path: String,
	shapes: List[CoreJsonRecordShape],
) -> Result[Void, CoreJsonError]:
	type_value ?= object_field(value, path, "type")
	type_path: String = path_field(path, "type")
	type_tag ?= kind_field(type_value, type_path)

	if type_tag != HEAP_RECORD_TYPE_TAG:
		Err(CoreInvalidRecordUpdateShape(type_path, "record reuse type must be a heap record"))
	else:
		validate_record_update_json_shape(value, path, shapes)


private pure func validate_record_update_json_tree(
	value: JsonValue,
	path: String,
	shapes: List[CoreJsonRecordShape],
) -> Result[Void, CoreJsonError]:
	match value:
		JsonObject(fields):
			current_valid ?= match optional_json_object_kind(fields):
				Some(kind):
					if kind == RECORD_UPDATE_EXPR_TAG:
						validate_record_update_json_shape(value, path, shapes)
					else if kind == RECORD_REUSE_EXPR_TAG:
						validate_record_reuse_json_shape(value, path, shapes)
					else:
						Ok(void)
				None:
					Ok(void)

			var error: Option[CoreJsonError] = None

			for (name, child) in fields:
				match error:
					Some(_):
						void
					None:
						match validate_record_update_json_tree(
							child,
							path_field(path, name),
							shapes,
						):
							Ok(_):
								void
							Err(child_error):
								error = Some(child_error)

			match error:
				Some(child_error):
					Err(child_error)
				None:
					Ok(void)
		JsonVector(items):
			var error: Option[CoreJsonError] = None
			var index: Int = 0

			for child in items:
				match error:
					Some(_):
						void
					None:
						match validate_record_update_json_tree(
							child,
							path_index(path, index),
							shapes,
						):
							Ok(_):
								void
							Err(child_error):
								error = Some(child_error)

				index += 1

			match error:
				Some(child_error):
					Err(child_error)
				None:
					Ok(void)
		_:
			Ok(void)


pure func decode_core_program_json(value: JsonValue) -> Result[CoreProgram, CoreJsonError]:
	path: String = "program"
	tag ?= kind_field(value, path)

	if tag != PROGRAM_TAG:
		Err(CoreUnsupportedTag(path, tag))
	else:
		decls ?= decode_core_decls(value, path, "decls")
		foreign_includes ?= decode_string_list(value, path, "foreign_includes")
		record_updates_valid ?= validate_record_update_json_tree(
			value,
			path,
			core_json_record_shapes(decls),
		)
		Ok({
			decls = decls,
			foreign_includes = foreign_includes,
		})


pure func core_json_error_to_string(error: CoreJsonError) -> String:
	match error:
		CoreMissingField(path, field_name):
			"missing Core JSON field at ${path}: ${field_name}"
		CoreExpectedObject(path):
			"Core JSON value at ${path} must be an object"
		CoreExpectedVariableExpr(path):
			"Core JSON value at ${path} must be a variable expression"
		CoreInvalidRecordUpdateShape(path, detail):
			"invalid Core record update at ${path}: ${detail}"
		CoreExpectedObjectField(path, field_name):
			"Core JSON field at ${path} must be an object: ${field_name}"
		CoreExpectedStringField(path, field_name):
			"Core JSON field at ${path} must be a string: ${field_name}"
		CoreExpectedIntField(path, field_name):
			"Core JSON field at ${path} must be an integer: ${field_name}"
		CoreExpectedNumberField(path, field_name):
			"Core JSON field at ${path} must be a number: ${field_name}"
		CoreExpectedBoolField(path, field_name):
			"Core JSON field at ${path} must be a boolean: ${field_name}"
		CoreExpectedArrayField(path, field_name):
			"Core JSON field at ${path} must be an array: ${field_name}"
		CoreUnsupportedTag(path, tag):
			"unsupported Core JSON tag at ${path}: ${tag}"
