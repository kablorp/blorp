		("list_index", json_int(loop.list_index)),
		("list_param", core_param_to_json(loop.list_param)),
		("cursor", core_var_to_json(loop.cursor)),
		("layout", core_list_storage_layout_to_json(loop.layout)),
		("body", core_expr_to_json(loop.body)),
	])


pure func decode_core_tailrec_list_spread_loop_json(
	value: JsonValue,
	path: String,
) -> Result[CoreTailrecListSpreadLoop, CoreJsonError]:
	params ?= decode_core_params(value, path, "params")
	return_type_json ?= object_field(value, path, "return_type")
	return_type ?= decode_core_type_json(
		return_type_json,
		path_field(path, "return_type"),
	)
	list_index ?= int_field(value, path, "list_index")
	list_param_json ?= object_field(value, path, "list_param")
	list_param ?= decode_core_param_json(
		list_param_json,
		path_field(path, "list_param"),
	)
	cursor_json ?= object_field(value, path, "cursor")
	cursor ?= decode_core_var_json(
		cursor_json,
		path_field(path, "cursor"),
	)
	layout_json ?= object_field(value, path, "layout")
	layout ?= decode_core_list_storage_layout_json(
		layout_json,
		path_field(path, "layout"),
	)
	body_json ?= object_field(value, path, "body")
	body ?= decode_core_expr_json(
		body_json,
		path_field(path, "body"),
	)

	Ok({
		params = params,
		return_type = return_type,
		list_index = list_index,
		list_param = list_param,
		cursor = cursor,
		layout = layout,
		body = body,
	})


-- Keep CoreExpr JSON variants outlined instead of folding them into the public
-- dispatchers. The self-hosted bridge emits these functions to C; a single
-- recursive match over every variant gives C compilers huge stack frames at -O0.
private pure func core_expr_literal_to_json(
	literal: CoreLiteral,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> JsonValue:
	JsonObject([
		(KIND_FIELD, JsonString(LITERAL_EXPR_TAG)),
		("literal", core_literal_to_json(literal)),
		("type", core_type_to_json(typ)),
		("loc", source_loc_to_json(loc)),
	])


