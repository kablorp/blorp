union CoreExpr:
	LiteralExpr(CoreLiteral, CoreType, CoreSourceLoc)
	VarExpr(CoreVar, CoreType, CoreSourceLoc)
	VoidExpr(CoreType, CoreSourceLoc)
	DebugBlockExpr(CoreExpr, CoreType, CoreSourceLoc)
	CooperativeCheckpointExpr(CoreType, CoreSourceLoc)
	CallExpr(CoreCallKind, CoreExpr, List[CoreExpr], CoreType, CoreSourceLoc)
	BinaryExpr(CoreBinaryOp, CoreExpr, CoreExpr, CoreType, CoreSourceLoc)
	UnaryExpr(CoreUnaryOp, CoreExpr, CoreType, CoreSourceLoc)
	LogicalExpr(CoreLogicalOp, CoreExpr, CoreExpr, CoreType, CoreSourceLoc)
	AssignExpr(CoreVar, CoreExpr, CoreType, CoreSourceLoc)
	CastExpr(CoreExpr, CoreType, CoreSourceLoc)
	BoxExpr(CoreBoxOp, CoreType, CoreSourceLoc)
	UnboxExpr(CoreUnboxKind, CoreExpr, CoreType, CoreSourceLoc)
	FieldExpr(CoreExpr, String, CoreType, CoreSourceLoc)
	TupleFieldExpr(CoreExpr, Int, CoreType, CoreSourceLoc)
	TupleExpr(List[CoreExpr], CoreType, CoreSourceLoc)
	TupleConstructExpr(CoreTupleConstruct, CoreType, CoreSourceLoc)
	VectorExpr(List[CoreExpr], CoreType, CoreSourceLoc)
	LambdaExpr(List[CoreParam], CoreType, CoreExpr, Bool, CoreType, CoreSourceLoc)
	ClosureCreateExpr(CoreClosureCreate, CoreType, CoreSourceLoc)
	ListConstructExpr(CoreListConstruct, CoreType, CoreSourceLoc)
	ListAllocExpr(CoreListAlloc, CoreType, CoreSourceLoc)
	ListGetExpr(CoreListGet, CoreType, CoreSourceLoc)
	ListHandoffExpr(CoreListHandoff, CoreType, CoreSourceLoc)
	ListHandoffSetOwnedExpr(CoreListSet, CoreType, CoreSourceLoc)
	ListHandoffSetSourceSlotExpr(CoreListHandoffSetSourceSlot, CoreType, CoreSourceLoc)
	StringByteReadExpr(CoreStringByteRead, CoreType, CoreSourceLoc)
	StringByteWriteExpr(CoreStringByteWrite, CoreType, CoreSourceLoc)
	StringByteCopyExpr(CoreStringByteCopy, CoreType, CoreSourceLoc)
	StringSetLenExpr(CoreStringSetLen, CoreType, CoreSourceLoc)
	TensorLiteralExpr(CoreTensorLiteral, CoreType, CoreSourceLoc)
	TensorBoxedLiteralExpr(CoreTensorBoxedLiteral, CoreType, CoreSourceLoc)
	TensorPackedLiteralExpr(CoreTensorPackedLiteral, CoreType, CoreSourceLoc)
	TensorRawFillExpr(CoreTensorRawFill, CoreType, CoreSourceLoc)
	TensorRawReadExpr(CoreTensorRawRead, CoreType, CoreSourceLoc)
	TensorRawWriteExpr(CoreTensorRawWrite, CoreType, CoreSourceLoc)
	TensorRawViewLetExpr(CoreTensorRawViewBinding, CoreExpr, CoreType, CoreSourceLoc)
	DictExpr(List[CoreDictLiteralEntry], CoreType, CoreSourceLoc)
	DictConstructExpr(CoreDictConstruct, CoreType, CoreSourceLoc)
	SetAllocExpr(CoreHashContainerConstructor, CoreType, CoreSourceLoc)
	ListRetainExpr(CoreListRetain, CoreType, CoreSourceLoc)
	ListSetExpr(CoreListSet, CoreType, CoreSourceLoc)
	ListSwapExpr(CoreListSwap, CoreType, CoreSourceLoc)
	RecordExpr(List[CoreRecordFieldValue], CoreType, CoreSourceLoc)
	RecordUpdateExpr(CoreExpr, List[CoreRecordFieldValue], CoreType, CoreSourceLoc)
	RecordReuseExpr(CoreExpr, List[CoreRecordFieldValue], CoreType, CoreSourceLoc)
	RecordConstructExpr(String, List[CoreRecordFieldValue], CoreType, CoreSourceLoc)
	UnionConstructExpr(CoreUnionConstruct, CoreType, CoreSourceLoc)
	UnionReuseConstructExpr(CoreUnionReuseConstruct, CoreType, CoreSourceLoc)
	DetachExpr(CoreTaskClosure, CoreType, CoreSourceLoc)
	DupExpr(CoreVar, CoreType, CoreRetainPolicy, CoreExpr, CoreType, CoreSourceLoc)
	DropExpr(CoreVar, CoreType, CoreReleasePolicy, CoreExpr, CoreType, CoreSourceLoc)
	LetExpr(CoreVar, Bool, CoreType, CoreExpr, CoreExpr)
	BorrowLetExpr(CoreVar, CoreType, CoreExpr, CoreExpr)
	SeqExpr(CoreExpr, CoreExpr)
	WhileExpr(CoreExpr, CoreExpr, CoreType, CoreSourceLoc)
	BreakExpr(CoreType, CoreSourceLoc)
	ContinueExpr(CoreType, CoreSourceLoc)
	ResourceScopeExpr(CoreResourceScope, CoreType, CoreSourceLoc)
	ResourceCleanupExitExpr(CoreResourceCleanupExit, CoreType, CoreSourceLoc)
	TailrecLoopExpr(List[CoreParam], CoreType, CoreExpr, CoreSourceLoc)
	TailrecRecurExpr(List[CoreExpr], CoreType, CoreSourceLoc)
	TailrecListSpreadLoopExpr(CoreTailrecListSpreadLoop, CoreSourceLoc)
	TailrecListSpreadRecurExpr(List[CoreTailrecListSpreadRebind], Int, CoreType, CoreSourceLoc)
	ForRangeExpr(CoreLoopBinder, CoreExpr, CoreExpr, CoreExpr, CoreType, CoreSourceLoc)
	ForChannelExpr(CoreForChannel, CoreType, CoreSourceLoc)
	ForListExpr(CoreForList, CoreType, CoreSourceLoc)
	ForStringExpr(CoreForString, CoreType, CoreSourceLoc)
	ForDictExpr(CoreForDict, CoreType, CoreSourceLoc)
	ForSetExpr(CoreForSet, CoreType, CoreSourceLoc)
	ForStreamExpr(CoreForStream, CoreType, CoreSourceLoc)
	ForResourceSourceExpr(CoreForResourceSource, CoreType, CoreSourceLoc)
	ForTensorExpr(CoreForTensor, CoreType, CoreSourceLoc)
