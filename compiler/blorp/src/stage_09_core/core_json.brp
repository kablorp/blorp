union CoreJsonError:
	CoreMissingField(String, String)
	CoreExpectedObject(String)
	CoreExpectedVariableExpr(String)
	CoreInvalidRecordUpdateShape(String, String)
	CoreExpectedObjectField(String, String)
	CoreExpectedStringField(String, String)
	CoreExpectedIntField(String, String)
	CoreExpectedNumberField(String, String)
	CoreExpectedBoolField(String, String)
	CoreExpectedArrayField(String, String)
	CoreUnsupportedTag(String, String)


private pure func json_int(value: Int) -> JsonValue:
	JsonNumber(to_float(value))


private pure func option_int_to_json(value: Option[Int]) -> JsonValue:
	match value:
		Some(n):
			json_int(n)
		None:
			JsonNull


private pure func option_string_to_json(value: Option[String]) -> JsonValue:
	match value:
		Some(text):
			JsonString(text)
		None:
			JsonNull


private pure func strings_to_json(items: List[String]) -> JsonValue:
	JsonVector(items.map(
		func(item: String): JsonString(item),
	))


private pure func ints_to_json(items: List[Int]) -> JsonValue:
	JsonVector(items.map(json_int))


private pure func path_field(path: String, field_name: String) -> String:
	if path == "":
		field_name
	else:
		"${path}.${field_name}"


private pure func path_index(path: String, index: Int) -> String:
	"${path}[${index.to_string()}]"


private pure func object_fields(
	value: JsonValue,
	path: String,
) -> Result[List[(String, JsonValue)], CoreJsonError]:
	match value:
		JsonObject(fields):
			Ok(fields)
		JsonNull:
			Err(CoreExpectedObject(path))
		JsonBool(flag):
			Err(CoreExpectedObject(path))
		JsonNumber(number):
			Err(CoreExpectedObject(path))
		JsonString(text):
			Err(CoreExpectedObject(path))
		JsonVector(items):
			Err(CoreExpectedObject(path))


private pure func required_field_at(
	fields: List[(String, JsonValue)],
	path: String,
	field_name: String,
	index: Int,
) -> Result[JsonValue, CoreJsonError]:
	match fields.get(index):
		Some((name, field)):
			if name == field_name:
				Ok(field)
			else:
				required_field_at(fields, path, field_name, index + 1)
		None:
			Err(CoreMissingField(path, field_name))


private pure func required_field(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[JsonValue, CoreJsonError]:
	fields ?= object_fields(value, path)
	required_field_at(fields, path, field_name, 0)


private pure func string_field(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[String, CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match as_string(field):
		Some(text):
			Ok(text)
		None:
			Err(CoreExpectedStringField(path, field_name))


private pure func int_field(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[Int, CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match as_number(field):
		Some(number):
			Ok(to_int(number))
		None:
			Err(CoreExpectedIntField(path, field_name))


private pure func exact_int_field(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[Int, CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match field:
		JsonString(text):
			match text.parse_int():
				Some(parsed):
					Ok(parsed)
				None:
					Err(CoreExpectedIntField(path, field_name))
		JsonNumber(number):
			Ok(to_int(number))
		_:
			Err(CoreExpectedIntField(path, field_name))


private pure func number_field(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[Float, CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match as_number(field):
		Some(number):
			Ok(number)
		None:
			Err(CoreExpectedNumberField(path, field_name))


private pure func bool_field(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[Bool, CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match as_bool(field):
		Some(flag):
			Ok(flag)
		None:
			Err(CoreExpectedBoolField(path, field_name))


private pure func array_field(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[JsonValue], CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match as_array(field):
		Some(items):
			Ok(items)
		None:
			Err(CoreExpectedArrayField(path, field_name))


private pure func object_field(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[JsonValue, CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match field:
		JsonObject(fields):
			Ok(JsonObject(fields))
		JsonNull:
			Err(CoreExpectedObjectField(path, field_name))
		JsonBool(flag):
			Err(CoreExpectedObjectField(path, field_name))
		JsonNumber(number):
			Err(CoreExpectedObjectField(path, field_name))
		JsonString(text):
			Err(CoreExpectedObjectField(path, field_name))
		JsonVector(items):
			Err(CoreExpectedObjectField(path, field_name))


private pure func kind_field(value: JsonValue, path: String) -> Result[String, CoreJsonError]:
	string_field(value, path, KIND_FIELD)


private pure func decode_json_array_field[T](
	value: JsonValue,
	path: String,
	field_name: String,
	decoder: pure (JsonValue, String) -> Result[T, CoreJsonError],
) -> Result[List[T], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[T] = []
	var failure: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		if failure.is_none():
			item_path: String = path_index(
				path_field(path, field_name),
				index,
			)

			match decoder(item, item_path):
				Ok(decoded):
					result = result.append(decoded)
				Err(error):
					failure = Some(error)

		index += 1

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(result)


private pure func decode_optional_string(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[Option[String], CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match field:
		JsonNull:
			Ok(None)
		JsonString(text):
			Ok(Some(text))
		JsonBool(flag):
			Err(CoreExpectedStringField(path, field_name))
		JsonNumber(number):
			Err(CoreExpectedStringField(path, field_name))
		JsonVector(items):
			Err(CoreExpectedStringField(path, field_name))
		JsonObject(fields):
			Err(CoreExpectedStringField(path, field_name))


private pure func decode_optional_int(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[Option[Int], CoreJsonError]:
	field ?= required_field(value, path, field_name)

	match field:
		JsonNull:
			Ok(None)
		JsonNumber(number):
			Ok(Some(to_int(number)))
		JsonBool(flag):
			Err(CoreExpectedIntField(path, field_name))
		JsonString(text):
			Err(CoreExpectedIntField(path, field_name))
		JsonVector(items):
			Err(CoreExpectedIntField(path, field_name))
		JsonObject(fields):
			Err(CoreExpectedIntField(path, field_name))


private pure func decode_string_list(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[String], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[String] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match as_string(item):
					Some(text):
						result = result.append(text)
					None:
						error = Some(
							CoreExpectedStringField(
								path_index(
									path_field(path, field_name),
									index,
								),
								"",
							),
						)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


private pure func decode_int_list(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[Int], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[Int] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match as_number(item):
					Some(number):
						result = result.append(to_int(number))
					None:
						error = Some(
							CoreExpectedIntField(
								path_index(
									path_field(path, field_name),
									index,
								),
								"",
							),
						)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func source_loc_to_json(loc: CoreSourceLoc) -> JsonValue:
	match loc:
		SyntheticSourceLoc:
			JsonObject([(KIND_FIELD, JsonString(SYNTHETIC_LOC_TAG))])
		KnownSourceLoc(file, line, column, end_line, end_column):
			JsonObject([
				(KIND_FIELD, JsonString(KNOWN_LOC_TAG)),
				("file", JsonString(file)),
				("line", json_int(line)),
				("column", json_int(column)),
				("end_line", json_int(end_line)),
				("end_column", json_int(end_column)),
			])


pure func decode_source_loc_json(
	value: JsonValue,
	path: String,
) -> Result[CoreSourceLoc, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == SYNTHETIC_LOC_TAG:
		Ok(SyntheticSourceLoc)
	else if tag == KNOWN_LOC_TAG:
		file ?= string_field(value, path, "file")
		line ?= int_field(value, path, "line")
		column ?= int_field(value, path, "column")
		end_line ?= int_field(value, path, "end_line")
		end_column ?= int_field(value, path, "end_column")
		Ok(KnownSourceLoc(file, line, column, end_line, end_column))
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_var_to_json(variable: CoreVar) -> JsonValue:
	JsonObject([
		("name", JsonString(variable.name)),
		("uniq", json_int(variable.uniq)),
		("def_id", option_int_to_json(variable.def_id)),
	])


pure func decode_core_var_json(value: JsonValue, path: String) -> Result[CoreVar, CoreJsonError]:
	name ?= string_field(value, path, "name")
	uniq ?= int_field(value, path, "uniq")
	def_id ?= decode_optional_int(value, path, "def_id")

	Ok({
		name = name,
		uniq = uniq,
		def_id = def_id,
	})


private pure func core_type_list_to_json(items: List[CoreType]) -> JsonValue:
	JsonVector(items.map(core_type_to_json))


private pure func core_dim_op_name(op: CoreDimOp) -> String:
	match op:
		DimAdd:
			"add"
		DimSubtract:
			"subtract"
		DimMultiply:
			"multiply"
		DimDivide:
			"divide"


private pure func core_tensor_dim_to_json(dim: CoreTensorDim) -> JsonValue:
	match dim:
		TensorStaticDim(value):
			JsonObject([
				(KIND_FIELD, JsonString(TENSOR_STATIC_DIM_TAG)),
				("value", json_int(value)),
			])
		TensorRuntimeDim(name):
			JsonObject([
				(KIND_FIELD, JsonString(TENSOR_RUNTIME_DIM_TAG)),
				("name", JsonString(name)),
			])
		TensorVariadicDim(name):
			JsonObject([
				(KIND_FIELD, JsonString(TENSOR_VARIADIC_DIM_TAG)),
				("name", JsonString(name)),
			])
		TensorDimOperation(op, left, right):
			JsonObject([
				(KIND_FIELD, JsonString(TENSOR_DIM_OPERATION_TAG)),
				("op", JsonString(core_dim_op_name(op))),
				("left", core_tensor_dim_to_json(left)),
				("right", core_tensor_dim_to_json(right)),
			])


private pure func core_tensor_type_info_to_json(info: CoreTensorTypeInfo) -> JsonValue:
	JsonObject([
		("element_type", core_type_to_json(info.element_type)),
		("dims", JsonVector(info.dims.map(core_tensor_dim_to_json))),
	])


pure func core_type_to_json(typ: CoreType) -> JsonValue:
	match typ:
		VoidType:
			JsonObject([(KIND_FIELD, JsonString(VOID_TYPE_TAG))])
		NamedType(name, args):
			JsonObject([
				(KIND_FIELD, JsonString(NAMED_TYPE_TAG)),
				("name", JsonString(name)),
				("args", core_type_list_to_json(args)),
			])
		TypeParameterType(name):
			JsonObject([
				(KIND_FIELD, JsonString(TYPE_PARAMETER_TYPE_TAG)),
				("name", JsonString(name)),
			])
		SelfType:
			JsonObject([(KIND_FIELD, JsonString(SELF_TYPE_TAG))])
		FunctionType(is_pure, params, return_type):
			JsonObject([
				(KIND_FIELD, JsonString(FUNCTION_TYPE_TAG)),
				("pure", JsonBool(is_pure)),
				("params", core_type_list_to_json(params)),
				("return_type", core_type_to_json(return_type)),
			])
		StackResultType(ok_type, err_type):
			JsonObject([
				(KIND_FIELD, JsonString(STACK_RESULT_TYPE_TAG)),
				("ok_type", core_type_to_json(ok_type)),
				("err_type", core_type_to_json(err_type)),
			])
		BoxedResultType(ok_type, err_type):
			JsonObject([
				(KIND_FIELD, JsonString(BOXED_RESULT_TYPE_TAG)),
				("ok_type", core_type_to_json(ok_type)),
				("err_type", core_type_to_json(err_type)),
			])
		EnumType(name):
			JsonObject([
				(KIND_FIELD, JsonString(ENUM_TYPE_TAG)),
				("name", JsonString(name)),
			])
		ValueRecordType(name):
			JsonObject([
				(KIND_FIELD, JsonString(VALUE_RECORD_TYPE_TAG)),
				("name", JsonString(name)),
			])
		HeapRecordType(name):
			JsonObject([
				(KIND_FIELD, JsonString(HEAP_RECORD_TYPE_TAG)),
				("name", JsonString(name)),
			])
		UnionType(name):
			JsonObject([
				(KIND_FIELD, JsonString(UNION_TYPE_TAG)),
				("name", JsonString(name)),
			])
		RangeType:
			JsonObject([(KIND_FIELD, JsonString(RANGE_TYPE_TAG))])
		TensorType(info):
			JsonObject([
				(KIND_FIELD, JsonString(TENSOR_TYPE_TAG)),
				("info", core_tensor_type_info_to_json(info)),
			])
		TupleType(items):
			JsonObject([
				(KIND_FIELD, JsonString(TUPLE_TYPE_TAG)),
				("items", core_type_list_to_json(items)),
			])


private pure func decode_core_type_list(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreType], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreType] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_type_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(typ):
						result = result.append(typ)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


private pure func parse_core_dim_op(name: String, path: String) -> Result[CoreDimOp, CoreJsonError]:
	match name:
		"add":
			Ok(DimAdd)
		"subtract":
			Ok(DimSubtract)
		"multiply":
			Ok(DimMultiply)
		"divide":
			Ok(DimDivide)
		_:
			Err(CoreUnsupportedTag(path, name))


private pure func decode_core_tensor_dim_json(
	value: JsonValue,
	path: String,
) -> Result[CoreTensorDim, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == TENSOR_STATIC_DIM_TAG:
		dim_value ?= int_field(value, path, "value")
		Ok(TensorStaticDim(dim_value))
	else if tag == TENSOR_RUNTIME_DIM_TAG:
		name ?= string_field(value, path, "name")
		Ok(TensorRuntimeDim(name))
	else if tag == TENSOR_VARIADIC_DIM_TAG:
		name ?= string_field(value, path, "name")
		Ok(TensorVariadicDim(name))
	else if tag == TENSOR_DIM_OPERATION_TAG:
		op_name ?= string_field(value, path, "op")
		op ?= parse_core_dim_op(
			op_name,
			path_field(path, "op"),
		)
		left_json ?= object_field(value, path, "left")
		left ?= decode_core_tensor_dim_json(
			left_json,
			path_field(path, "left"),
		)
		right_json ?= object_field(value, path, "right")
		right ?= decode_core_tensor_dim_json(
			right_json,
			path_field(path, "right"),
		)
		Ok(TensorDimOperation(op, left, right))
	else:
		Err(CoreUnsupportedTag(path, tag))


private pure func decode_core_tensor_dims_json(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreTensorDim], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreTensorDim] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_tensor_dim_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(dim):
						result = result.append(dim)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


private pure func decode_core_tensor_type_info_json(
	value: JsonValue,
	path: String,
) -> Result[CoreTensorTypeInfo, CoreJsonError]:
	element_type_json ?= object_field(value, path, "element_type")
	element_type ?= decode_core_type_json(
		element_type_json,
		path_field(path, "element_type"),
	)
	dims ?= decode_core_tensor_dims_json(value, path, "dims")

	Ok({
		element_type = element_type,
		dims = dims,
	})


pure func decode_core_type_json(value: JsonValue, path: String) -> Result[CoreType, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == VOID_TYPE_TAG:
		Ok(VoidType)
	else if tag == NAMED_TYPE_TAG:
		name ?= string_field(value, path, "name")
		args ?= decode_core_type_list(value, path, "args")
		Ok(NamedType(name, args))
	else if tag == TYPE_PARAMETER_TYPE_TAG:
		name ?= string_field(value, path, "name")
		Ok(TypeParameterType(name))
	else if tag == SELF_TYPE_TAG:
		Ok(SelfType)
	else if tag == FUNCTION_TYPE_TAG:
		is_pure ?= bool_field(value, path, "pure")
		params ?= decode_core_type_list(value, path, "params")
		return_json ?= object_field(value, path, "return_type")
		return_type ?= decode_core_type_json(
			return_json,
			path_field(path, "return_type"),
		)
		Ok(FunctionType(is_pure, params, return_type))
	else if tag == STACK_RESULT_TYPE_TAG:
		ok_json ?= object_field(value, path, "ok_type")
		err_json ?= object_field(value, path, "err_type")
		ok_type ?= decode_core_type_json(
			ok_json,
			path_field(path, "ok_type"),
		)
		err_type ?= decode_core_type_json(
			err_json,
			path_field(path, "err_type"),
		)
		Ok(StackResultType(ok_type, err_type))
	else if tag == BOXED_RESULT_TYPE_TAG:
		ok_json ?= object_field(value, path, "ok_type")
		err_json ?= object_field(value, path, "err_type")
		ok_type ?= decode_core_type_json(
			ok_json,
			path_field(path, "ok_type"),
		)
		err_type ?= decode_core_type_json(
			err_json,
			path_field(path, "err_type"),
		)
		Ok(BoxedResultType(ok_type, err_type))
	else if tag == ENUM_TYPE_TAG:
		name ?= string_field(value, path, "name")
		Ok(EnumType(name))
	else if tag == VALUE_RECORD_TYPE_TAG:
		name ?= string_field(value, path, "name")
		Ok(ValueRecordType(name))
	else if tag == HEAP_RECORD_TYPE_TAG:
		name ?= string_field(value, path, "name")
		Ok(HeapRecordType(name))
	else if tag == UNION_TYPE_TAG:
		name ?= string_field(value, path, "name")
		Ok(UnionType(name))
	else if tag == RANGE_TYPE_TAG:
		Ok(RangeType)
	else if tag == TENSOR_TYPE_TAG:
		info_json ?= object_field(value, path, "info")
		info ?= decode_core_tensor_type_info_json(
			info_json,
			path_field(path, "info"),
		)
		Ok(TensorType(info))
	else if tag == TUPLE_TYPE_TAG:
		items ?= decode_core_type_list(value, path, "items")
		Ok(TupleType(items))
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_literal_to_json(literal: CoreLiteral) -> JsonValue:
	match literal:
		IntLiteral(value):
			JsonObject([
				(KIND_FIELD, JsonString(INT_LITERAL_TAG)),
				("value", JsonString(value.to_string())),
			])
		WideIntLiteral(value):
			JsonObject([
				(KIND_FIELD, JsonString(WIDE_INT_LITERAL_TAG)),
				("value", JsonString(value)),
			])
		FloatLiteral(value):
			JsonObject([
				(KIND_FIELD, JsonString(FLOAT_LITERAL_TAG)),
				("value", JsonNumber(value)),
			])
		FloatTextLiteral(value):
			JsonObject([
				(KIND_FIELD, JsonString(FLOAT_TEXT_LITERAL_TAG)),
				("value", JsonString(value)),
			])
		FloatInfinityLiteral:
			JsonObject([(KIND_FIELD, JsonString(FLOAT_INFINITY_LITERAL_TAG))])
		FloatNegInfinityLiteral:
			JsonObject([(KIND_FIELD, JsonString(FLOAT_NEG_INFINITY_LITERAL_TAG))])
		FloatNanLiteral:
			JsonObject([(KIND_FIELD, JsonString(FLOAT_NAN_LITERAL_TAG))])
		BoolLiteral(value):
			JsonObject([
				(KIND_FIELD, JsonString(BOOL_LITERAL_TAG)),
				("value", JsonBool(value)),
			])
		CharLiteral(value):
			JsonObject([
				(KIND_FIELD, JsonString(CHAR_LITERAL_TAG)),
				("value", json_int(value)),
			])
		StringLiteral(value):
			JsonObject([
				(KIND_FIELD, JsonString(STRING_LITERAL_TAG)),
				("value", JsonString(value)),
			])


pure func decode_core_literal_json(
	value: JsonValue,
	path: String,
) -> Result[CoreLiteral, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == INT_LITERAL_TAG:
		n ?= exact_int_field(value, path, "value")
		Ok(IntLiteral(n))
	else if tag == WIDE_INT_LITERAL_TAG:
		text ?= string_field(value, path, "value")
		Ok(WideIntLiteral(text))
	else if tag == FLOAT_LITERAL_TAG:
		number ?= number_field(value, path, "value")
		Ok(FloatLiteral(number))
	else if tag == FLOAT_TEXT_LITERAL_TAG:
		text ?= string_field(value, path, "value")
		Ok(FloatTextLiteral(text))
	else if tag == FLOAT_INFINITY_LITERAL_TAG:
		Ok(FloatInfinityLiteral)
	else if tag == FLOAT_NEG_INFINITY_LITERAL_TAG:
		Ok(FloatNegInfinityLiteral)
	else if tag == FLOAT_NAN_LITERAL_TAG:
		Ok(FloatNanLiteral)
	else if tag == BOOL_LITERAL_TAG:
		flag ?= bool_field(value, path, "value")
		Ok(BoolLiteral(flag))
	else if tag == CHAR_LITERAL_TAG:
		codepoint ?= int_field(value, path, "value")
		Ok(CharLiteral(codepoint))
	else if tag == STRING_LITERAL_TAG:
		text ?= string_field(value, path, "value")
		Ok(StringLiteral(text))
	else:
		Err(CoreUnsupportedTag(path, tag))


private pure func runtime_union_arg_to_json(arg: CoreRuntimeUnionArg) -> JsonValue:
	match arg:
		RuntimeOwnedField(field):
			JsonObject([
				(KIND_FIELD, JsonString(RUNTIME_OWNED_FIELD_TAG)),
				("field", JsonString(field)),
			])
		RuntimeIntField(field):
			JsonObject([
				(KIND_FIELD, JsonString(RUNTIME_INT_FIELD_TAG)),
				("field", JsonString(field)),
			])
		RuntimeTypedIntField(field):
			JsonObject([
				(KIND_FIELD, JsonString(RUNTIME_TYPED_INT_FIELD_TAG)),
				("field", JsonString(field)),
			])


private pure func decode_runtime_union_arg_json(
	value: JsonValue,
	path: String,
) -> Result[CoreRuntimeUnionArg, CoreJsonError]:
	tag ?= kind_field(value, path)
	field ?= string_field(value, path, "field")

	if tag == RUNTIME_OWNED_FIELD_TAG:
		Ok(RuntimeOwnedField(field))
	else if tag == RUNTIME_INT_FIELD_TAG:
		Ok(RuntimeIntField(field))
	else if tag == RUNTIME_TYPED_INT_FIELD_TAG:
		Ok(RuntimeTypedIntField(field))
	else:
		Err(CoreUnsupportedTag(path, tag))


private pure func decode_runtime_union_args(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreRuntimeUnionArg], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreRuntimeUnionArg] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_runtime_union_arg_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(arg):
						result = result.append(arg)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


private pure func runtime_union_case_to_json(case: CoreRuntimeUnionCase) -> JsonValue:
	JsonObject([
		("runtime_tag", JsonString(case.runtime_tag)),
		("constructor_name", JsonString(case.constructor_name)),
		("constructor_c_name", JsonString(case.constructor_c_name)),
		("args", JsonVector(case.args.map(runtime_union_arg_to_json))),
	])


private pure func decode_runtime_union_case_json(
	value: JsonValue,
	path: String,
) -> Result[CoreRuntimeUnionCase, CoreJsonError]:
	runtime_tag ?= string_field(value, path, "runtime_tag")
	constructor_name ?= string_field(value, path, "constructor_name")
	constructor_c_name ?= string_field(value, path, "constructor_c_name")
	args ?= decode_runtime_union_args(value, path, "args")

	Ok({
		runtime_tag = runtime_tag,
		constructor_name = constructor_name,
		constructor_c_name = constructor_c_name,
		args = args,
	})


private pure func decode_runtime_union_cases(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreRuntimeUnionCase], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreRuntimeUnionCase] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_runtime_union_case_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(case):
						result = result.append(case)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


private pure func runtime_success_payload_to_json(payload: CoreRuntimeSuccessPayload) -> JsonValue:
	match payload:
		RuntimeNoPayload:
			JsonObject([(KIND_FIELD, JsonString(RUNTIME_NO_PAYLOAD_TAG))])
		RuntimeField(field):
			JsonObject([
				(KIND_FIELD, JsonString(RUNTIME_FIELD_PAYLOAD_TAG)),
				("field", JsonString(field)),
			])
		RuntimeRecordFields(fields):
			JsonObject([
				(KIND_FIELD, JsonString(RUNTIME_RECORD_FIELDS_PAYLOAD_TAG)),
				("fields", strings_to_json(fields)),
			])
		RuntimeUnionPayload(runtime_tag_field, cases):
			JsonObject([
				(KIND_FIELD, JsonString(RUNTIME_UNION_PAYLOAD_TAG)),
				("runtime_tag_field", JsonString(runtime_tag_field)),
				("cases", JsonVector(cases.map(runtime_union_case_to_json))),
			])


private pure func decode_runtime_success_payload_json(
	value: JsonValue,
	path: String,
) -> Result[CoreRuntimeSuccessPayload, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == RUNTIME_NO_PAYLOAD_TAG:
		Ok(RuntimeNoPayload)
	else if tag == RUNTIME_FIELD_PAYLOAD_TAG:
		field ?= string_field(value, path, "field")
		Ok(RuntimeField(field))
	else if tag == RUNTIME_RECORD_FIELDS_PAYLOAD_TAG:
		fields ?= decode_string_list(value, path, "fields")
		Ok(RuntimeRecordFields(fields))
	else if tag == RUNTIME_UNION_PAYLOAD_TAG:
		runtime_tag_field ?= string_field(value, path, "runtime_tag_field")
		cases ?= decode_runtime_union_cases(value, path, "cases")
		Ok(RuntimeUnionPayload(runtime_tag_field, cases))
	else:
		Err(CoreUnsupportedTag(path, tag))


private pure func operation_success_payload_to_json(
	success: CoreOperationSuccessPayload,
) -> JsonValue:
	JsonObject([
		("runtime_payload", runtime_success_payload_to_json(success.runtime_payload)),
		("release_mask", json_int(success.release_mask)),
	])


private pure func decode_operation_success_payload_json(
	value: JsonValue,
	path: String,
) -> Result[CoreOperationSuccessPayload, CoreJsonError]:
	payload_json ?= object_field(value, path, "runtime_payload")
	runtime_payload ?= decode_runtime_success_payload_json(
		payload_json,
		path_field(path, "runtime_payload"),
	)
	release_mask ?= int_field(value, path, "release_mask")

	Ok({
		runtime_payload = runtime_payload,
		release_mask = release_mask,
	})


