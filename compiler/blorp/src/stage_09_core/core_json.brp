	helper: CoreTensorRuntimeReadHelper
}


record CoreTensorRowSliceElement {
	row_size: String,
	result_first_dim: String,
	runtime_derived: Bool
}


union CoreTensorForElementStorage:
	TensorForInlineStructElement(String)
	TensorForRawScalarElement(CoreTensorRawScalarKind)
	TensorForRuntimeReadElement(CoreTensorRuntimeReadElement)
	TensorForRowSliceElement(CoreTensorRowSliceElement)
	TensorForBoxedElement(String)


pure func clone_tensor_for_element_storage(
	storage: CoreTensorForElementStorage,
) -> CoreTensorForElementStorage:
	match storage:
		TensorForInlineStructElement(c_type):
			TensorForInlineStructElement(c_type)
		TensorForRawScalarElement(raw_kind):
			TensorForRawScalarElement(raw_kind)
		TensorForRuntimeReadElement(runtime_read):
			TensorForRuntimeReadElement({
				value_c_type = runtime_read.value_c_type,
				helper = runtime_read.helper,
			})
		TensorForRowSliceElement(row_slice):
			TensorForRowSliceElement({
				row_size = row_slice.row_size,
				result_first_dim = row_slice.result_first_dim,
				runtime_derived = row_slice.runtime_derived,
			})
		TensorForBoxedElement(value_c_type):
			TensorForBoxedElement(value_c_type)


record CoreForTensor {
	binder: CoreLoopBinder,
	element_storage: CoreTensorForElementStorage,
