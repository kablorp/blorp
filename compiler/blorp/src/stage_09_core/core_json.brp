	JsonObject([
		("binder", core_var_to_json(recv.binder)),
		("elem_type", core_type_to_json(recv.elem_type)),
		("channel", core_expr_to_json(recv.channel)),
	])


private pure func decode_core_select_recv_arm_json(
	value: JsonValue,
	path: String,
) -> Result[CoreSelectRecvArm, CoreJsonError]:
	binder_json ?= object_field(value, path, "binder")
	binder ?= decode_core_var_json(
		binder_json,
		path_field(path, "binder"),
	)
	elem_type_json ?= object_field(value, path, "elem_type")
	elem_type ?= decode_core_type_json(
		elem_type_json,
		path_field(path, "elem_type"),
	)
	channel_json ?= object_field(value, path, "channel")
	channel ?= decode_core_expr_json(
		channel_json,
		path_field(path, "channel"),
	)

	Ok({
		binder = binder,
		elem_type = elem_type,
		channel = channel,
	})


private pure func core_select_arm_kind_to_json(kind: CoreSelectArmKind) -> JsonValue:
	match kind:
		SelectRecvArm(recv):
			JsonObject([
				(KIND_FIELD, JsonString(SELECT_RECV_ARM_TAG)),
				("recv", core_select_recv_arm_to_json(recv)),
			])
		SelectSealedArm(channel):
			JsonObject([
				(KIND_FIELD, JsonString(SELECT_SEALED_ARM_TAG)),
				("channel", core_expr_to_json(channel)),
			])
		SelectAfterArm(timeout):
			JsonObject([
				(KIND_FIELD, JsonString(SELECT_AFTER_ARM_TAG)),
				("timeout", core_expr_to_json(timeout)),
			])


private pure func decode_core_select_arm_kind_json(
	value: JsonValue,
	path: String,
) -> Result[CoreSelectArmKind, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == SELECT_RECV_ARM_TAG:
		recv_json ?= object_field(value, path, "recv")
		recv ?= decode_core_select_recv_arm_json(
			recv_json,
			path_field(path, "recv"),
		)
		Ok(SelectRecvArm(recv))
	else if tag == SELECT_SEALED_ARM_TAG:
		channel_json ?= object_field(value, path, "channel")
		channel ?= decode_core_expr_json(
			channel_json,
			path_field(path, "channel"),
		)
		Ok(SelectSealedArm(channel))
	else if tag == SELECT_AFTER_ARM_TAG:
		timeout_json ?= object_field(value, path, "timeout")
		timeout ?= decode_core_expr_json(
			timeout_json,
			path_field(path, "timeout"),
		)
		Ok(SelectAfterArm(timeout))
	else:
		Err(CoreUnsupportedTag(path, tag))


