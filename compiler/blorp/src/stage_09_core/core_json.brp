	])


pure func core_expr_to_json(expr: CoreExpr) -> JsonValue:
	match expr:
		LiteralExpr(literal, typ, loc):
			core_expr_literal_to_json(literal, typ, loc)
		VarExpr(variable, typ, loc):
			core_expr_var_to_json(variable, typ, loc)
		VoidExpr(typ, loc):
			core_expr_void_to_json(typ, loc)
		DebugBlockExpr(body, typ, loc):
			core_expr_debug_block_to_json(body, typ, loc)
		CooperativeCheckpointExpr(typ, loc):
			core_expr_cooperative_checkpoint_to_json(typ, loc)
		CallExpr(kind, callee, args, typ, loc):
			core_expr_call_to_json(kind, callee, args, typ, loc)
		BinaryExpr(op, left, right, typ, loc):
			core_expr_binary_to_json(op, left, right, typ, loc)
		UnaryExpr(op, expr_value, typ, loc):
			core_expr_unary_to_json(op, expr_value, typ, loc)
		LogicalExpr(op, left, right, typ, loc):
			core_expr_logical_to_json(op, left, right, typ, loc)
		AssignExpr(variable, rhs, typ, loc):
			core_expr_assign_to_json(variable, rhs, typ, loc)
		CastExpr(expr_value, typ, loc):
			core_expr_cast_to_json(expr_value, typ, loc)
		BoxExpr(box, typ, loc):
			core_expr_box_to_json(box, typ, loc)
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			core_expr_unbox_to_json(unbox_kind, expr_value, typ, loc)
		FieldExpr(expr_value, field_name, typ, loc):
			core_expr_field_to_json(expr_value, field_name, typ, loc)
		TupleFieldExpr(expr_value, field_index, typ, loc):
			core_expr_tuple_field_to_json(expr_value, field_index, typ, loc)
		TupleExpr(items, typ, loc):
			core_expr_tuple_to_json(items, typ, loc)
		TupleConstructExpr(tuple_construct, typ, loc):
			core_expr_tuple_construct_to_json(tuple_construct, typ, loc)
		VectorExpr(items, typ, loc):
			core_expr_vector_to_json(items, typ, loc)
		LambdaExpr(params, return_type, body, is_pure, typ, loc):
			core_expr_lambda_to_json(params, return_type, body, is_pure, typ, loc)
		ClosureCreateExpr(closure, typ, loc):
			core_expr_closure_create_to_json(closure, typ, loc)
		ListConstructExpr(construct, typ, loc):
			core_expr_list_construct_to_json(construct, typ, loc)
		ListAllocExpr(alloc, typ, loc):
			core_expr_list_alloc_to_json(alloc, typ, loc)
		ListGetExpr(get, typ, loc):
			core_expr_list_get_to_json(get, typ, loc)
		ListHandoffExpr(handoff, typ, loc):
			core_expr_list_handoff_to_json(handoff, typ, loc)
		ListHandoffSetOwnedExpr(set, typ, loc):
			core_expr_list_handoff_set_owned_to_json(set, typ, loc)
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			core_expr_list_handoff_set_source_slot_to_json(slot, typ, loc)
		StringByteReadExpr(read, typ, loc):
			core_expr_string_byte_read_to_json(read, typ, loc)
		StringByteWriteExpr(write, typ, loc):
			core_expr_string_byte_write_to_json(write, typ, loc)
		StringByteCopyExpr(copy, typ, loc):
			core_expr_string_byte_copy_to_json(copy, typ, loc)
		StringSetLenExpr(set_len, typ, loc):
			core_expr_string_set_len_to_json(set_len, typ, loc)
		TensorLiteralExpr(literal, typ, loc):
			core_expr_tensor_literal_to_json(literal, typ, loc)
		TensorBoxedLiteralExpr(literal, typ, loc):
			core_expr_tensor_boxed_literal_to_json(literal, typ, loc)
		TensorPackedLiteralExpr(literal, typ, loc):
			core_expr_tensor_packed_literal_to_json(literal, typ, loc)
		TensorRawFillExpr(fill, typ, loc):
			core_expr_tensor_raw_fill_to_json(fill, typ, loc)
		TensorRawReadExpr(read, typ, loc):
			core_expr_tensor_raw_read_to_json(read, typ, loc)
		TensorRawWriteExpr(write, typ, loc):
			core_expr_tensor_raw_write_to_json(write, typ, loc)
		TensorRawViewLetExpr(binding, body, typ, loc):
			core_expr_tensor_raw_view_let_to_json(binding, body, typ, loc)
		DictExpr(entries, typ, loc):
			core_expr_dict_to_json(entries, typ, loc)
		DictConstructExpr(construct, typ, loc):
			core_expr_dict_construct_to_json(construct, typ, loc)
		SetAllocExpr(alloc, typ, loc):
			core_expr_set_alloc_to_json(alloc, typ, loc)
		ListRetainExpr(retain, typ, loc):
			core_expr_list_retain_to_json(retain, typ, loc)
		ListSetExpr(set, typ, loc):
			core_expr_list_set_to_json(set, typ, loc)
		ListSwapExpr(swap, typ, loc):
			core_expr_list_swap_to_json(swap, typ, loc)
		RecordExpr(fields, typ, loc):
			core_expr_record_to_json(fields, typ, loc)
		RecordUpdateExpr(base, fields, typ, loc):
			core_expr_record_update_to_json(base, fields, typ, loc)
		RecordReuseExpr(source, fields, typ, loc):
			core_expr_record_reuse_to_json(source, fields, typ, loc)
		RecordConstructExpr(type_name, fields, typ, loc):
			core_expr_record_construct_to_json(type_name, fields, typ, loc)
		UnionConstructExpr(construct, typ, loc):
			core_expr_union_construct_to_json(construct, typ, loc)
		UnionReuseConstructExpr(construct, typ, loc):
			core_expr_union_reuse_construct_to_json(construct, typ, loc)
		DetachExpr(detached, typ, loc):
			core_expr_detach_to_json(detached, typ, loc)
		PreClosureDetachExpr(detached, typ, loc):
			core_expr_pre_closure_detach_to_json(detached, typ, loc)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			core_expr_dup_to_json(variable, value_type, retain_policy, body, typ, loc)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			core_expr_drop_to_json(variable, value_type, release_policy, body, typ, loc)
		LetExpr(name, is_mutable, typ, rhs, body):
			core_expr_let_to_json(name, is_mutable, typ, rhs, body)
		BorrowLetExpr(name, typ, rhs, body):
			core_expr_borrow_let_to_json(name, typ, rhs, body)
		SeqExpr(first, second):
			core_expr_seq_to_json(first, second)
		WhileExpr(cond, body, typ, loc):
			core_expr_while_to_json(cond, body, typ, loc)
		BreakExpr(typ, loc):
			core_expr_break_to_json(typ, loc)
		ContinueExpr(typ, loc):
			core_expr_continue_to_json(typ, loc)
		ResourceScopeExpr(scope, typ, loc):
			core_expr_resource_scope_to_json(scope, typ, loc)
		ResourceCleanupExitExpr(exit, typ, loc):
			core_expr_resource_cleanup_exit_to_json(exit, typ, loc)
		TailrecLoopExpr(params, return_type, body, loc):
			core_expr_tailrec_loop_to_json(params, return_type, body, loc)
		TailrecRecurExpr(args, typ, loc):
			core_expr_tailrec_recur_to_json(args, typ, loc)
		TailrecListSpreadLoopExpr(loop, loc):
			core_expr_tailrec_list_spread_loop_to_json(loop, loc)
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			core_expr_tailrec_list_spread_recur_to_json(rebinds, cursor_advance, typ, loc)
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			core_expr_for_range_to_json(binder, start, end_value, body, typ, loc)
		ForChannelExpr(for_channel, typ, loc):
			core_expr_for_channel_to_json(for_channel, typ, loc)
		ForListExpr(for_list, typ, loc):
			core_expr_for_list_to_json(for_list, typ, loc)
		ForStringExpr(for_string, typ, loc):
			core_expr_for_string_to_json(for_string, typ, loc)
		ForDictExpr(for_dict, typ, loc):
			core_expr_for_dict_to_json(for_dict, typ, loc)
		ForSetExpr(for_set, typ, loc):
			core_expr_for_set_to_json(for_set, typ, loc)
		ForStreamExpr(for_stream, typ, loc):
			core_expr_for_stream_to_json(for_stream, typ, loc)
		ForResourceSourceExpr(for_resource_source, typ, loc):
			core_expr_for_resource_source_to_json(for_resource_source, typ, loc)
		ForTensorExpr(for_tensor, typ, loc):
			core_expr_for_tensor_to_json(for_tensor, typ, loc)
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			core_expr_pre_closure_concurrently_loop_to_json(loop, typ, loc)
		ConcurrentlyLoopExpr(loop, typ, loc):
			core_expr_concurrently_loop_to_json(loop, typ, loc)
		PreClosureConcurrentExpr(block, typ, loc):
			core_expr_pre_closure_concurrent_to_json(block, typ, loc)
		ConcurrentExpr(block, typ, loc):
			core_expr_concurrent_to_json(block, typ, loc)
		SelectExpr(select_expr, typ, loc):
			core_expr_select_to_json(select_expr, typ, loc)
		RangeExpr(start, end_value, typ, loc):
			core_expr_range_to_json(start, end_value, typ, loc)
		RawMatchExpr(scrutinee, cases, typ, loc):
			core_expr_raw_match_to_json(scrutinee, cases, typ, loc)
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			core_expr_semantic_match_to_json(scrutinee, tree, typ, loc)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			core_expr_literal_match_to_json(scrutinee, cases, fallback, typ, loc)
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			core_expr_accessor_literal_match_to_json(
				scrutinee,
				scrutinee_release_policy,
				match_expr,
				typ,
				loc,
			)
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			core_expr_length_match_to_json(
				scrutinee,
				scrutinee_release_policy,
				match_expr,
				typ,
				loc,
			)
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, fallback, typ, loc):
			core_expr_constructor_match_to_json(
				scrutinee,
				scrutinee_release_policy,
				cases,
				fallback,
				typ,
				loc,
			)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			core_expr_if_to_json(cond, then_expr, else_expr, typ, loc)


private pure func decode_core_expr_list(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreExpr], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreExpr] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_expr_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(expr):
						result = result.append(expr)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


-- Keep decode helpers outlined for the same stack-frame reason as
-- core_expr_to_json. Recursive parser combinators hit this path deeply.
private pure func decode_core_expr_literal_from_json(
	value: JsonValue,
	path: String,
) -> Result[CoreExpr, CoreJsonError]:
	literal_json ?= object_field(value, path, "literal")
	literal ?= decode_core_literal_json(
		literal_json,
		path_field(path, "literal"),
	)
	type_json ?= object_field(value, path, "type")
	typ ?= decode_core_type_json(
		type_json,
		path_field(path, "type"),
	)
	loc_json ?= object_field(value, path, "loc")
	loc ?= decode_source_loc_json(
		loc_json,
		path_field(path, "loc"),
	)
	Ok(LiteralExpr(literal, typ, loc))


