private pure func decode_core_dict_literal_entry_json(
	value: JsonValue,
	path: String,
) -> Result[CoreDictLiteralEntry, CoreJsonError]:
	key_json ?= object_field(value, path, "key")
	key ?= decode_core_expr_json(
		key_json,
		path_field(path, "key"),
	)
	value_json ?= object_field(value, path, "value")
	entry_value ?= decode_core_expr_json(
		value_json,
		path_field(path, "value"),
	)
	Ok({
		key = key,
		value = entry_value,
	})


private pure func decode_core_dict_literal_entries(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreDictLiteralEntry], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreDictLiteralEntry] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(_):
				void
			None:
				match decode_core_dict_literal_entry_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(entry):
						result = result.append(entry)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(err):
			Err(err)
		None:
			Ok(result)


private pure func decode_core_expr_dict_from_json(
