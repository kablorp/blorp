private pure func decode_core_concurrently_loop_output_tag(
	tag: String,
	path: String,
) -> Result[CoreConcurrentlyLoopOutput, CoreJsonError]:
	if tag == CONCURRENTLY_LOOP_COLLECT_TAG:
		Ok(ConcurrentlyLoopCollect)
	else if tag == CONCURRENTLY_LOOP_DISCARD_TAG:
		Ok(ConcurrentlyLoopDiscard)
	else:
		Err(CoreUnsupportedTag(path, tag))


private pure func core_concurrently_loop_item_mode_to_json(
	item_mode: CoreConcurrentlyLoopItemMode,
) -> JsonValue:
	match item_mode:
		ConcurrentlyLoopCopyItem:
			JsonObject([(KIND_FIELD, JsonString(CONCURRENTLY_LOOP_COPY_ITEM_TAG))])
		ConcurrentlyLoopMoveResourceItem(move_item):
			JsonObject([
				(KIND_FIELD, JsonString(CONCURRENTLY_LOOP_MOVE_RESOURCE_ITEM_TAG)),
				("resource_type", core_type_to_json(move_item.resource_type)),
				("error_type", core_type_to_json(move_item.error_type)),
			])


private pure func decode_core_concurrently_loop_item_mode_json(
	value: JsonValue,
	path: String,
) -> Result[CoreConcurrentlyLoopItemMode, CoreJsonError]:
	tag ?= string_field(value, path, KIND_FIELD)

	if tag == CONCURRENTLY_LOOP_COPY_ITEM_TAG:
		Ok(ConcurrentlyLoopCopyItem)
	else if tag == CONCURRENTLY_LOOP_MOVE_RESOURCE_ITEM_TAG:
		resource_type_json ?= object_field(value, path, "resource_type")
		resource_type ?= decode_core_type_json(
			resource_type_json,
			path_field(path, "resource_type"),
		)
		error_type_json ?= object_field(value, path, "error_type")
		error_type ?= decode_core_type_json(
			error_type_json,
			path_field(path, "error_type"),
		)

		Ok(ConcurrentlyLoopMoveResourceItem({
			resource_type = resource_type,
			error_type = error_type,
		}))
	else:
		Err(CoreUnsupportedTag(path_field(path, KIND_FIELD), tag))


