	value: JsonValue,
	path: String,
) -> Result[List[CoreTraitMethod], CoreJsonError]:
	items ?= array_field(value, path, "methods")
	var methods: List[CoreTraitMethod] = []
	var failure: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		if failure.is_none():
			match decode_core_trait_method_json(
				item,
				path_index(
					path_field(path, "methods"),
					index,
				),
			):
				Ok(method):
					methods = methods.append(method)
				Err(error):
					failure = Some(error)

		index += 1

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(methods)


