	range_direction_tag ?= string_field(value, path, "range_direction")
	range_direction ?= parse_core_loop_range_direction(
		range_direction_tag,
		path_field(path, "range_direction"),
	)

	Ok({
		variable = variable,
		typ = typ,
		range_direction = range_direction,
	})


