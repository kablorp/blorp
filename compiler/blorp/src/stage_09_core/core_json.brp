	other_constructor_c_name ?= string_field(value, path, "other_constructor_c_name")
	cases ?= decode_operation_error_cases(value, path, "cases")

	Ok({
		none_tag = none_tag,
		detail_field = detail_field,
		other_constructor = other_constructor,
		other_constructor_c_name = other_constructor_c_name,
		cases = cases,
	})


private pure func result_layout_policy_to_json(
	policy: CoreOperationResultLayoutPolicy,
) -> JsonValue:
	match policy:
		DefaultResultLayoutPolicy:
			JsonObject([(KIND_FIELD, JsonString(DEFAULT_RESULT_LAYOUT_POLICY_TAG))])
		BoxedResultOnlyPolicy(hint):
			JsonObject([
				(KIND_FIELD, JsonString(BOXED_RESULT_ONLY_POLICY_TAG)),
				("hint", JsonString(hint)),
			])


private pure func decode_result_layout_policy_json(
	value: JsonValue,
	path: String,
) -> Result[CoreOperationResultLayoutPolicy, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == DEFAULT_RESULT_LAYOUT_POLICY_TAG:
		Ok(DefaultResultLayoutPolicy)
	else if tag == BOXED_RESULT_ONLY_POLICY_TAG:
		hint ?= string_field(value, path, "hint")
		Ok(BoxedResultOnlyPolicy(hint))
	else:
		Err(CoreUnsupportedTag(path, tag))


private pure func operation_result_bridge_to_json(bridge: CoreOperationResultBridge) -> JsonValue:
	JsonObject([
		("builtin_name", JsonString(bridge.builtin_name)),
		("runtime_c_name", JsonString(bridge.runtime_c_name)),
		("runtime_result_c_type", JsonString(bridge.runtime_result_c_type)),
		("temp_prefix", JsonString(bridge.temp_prefix)),
		("result_layout_policy", result_layout_policy_to_json(bridge.result_layout_policy)),
		("success", operation_success_payload_to_json(bridge.success)),
		("error", operation_error_mapping_to_json(bridge.error)),
	])


private pure func decode_operation_result_bridge_json(
	value: JsonValue,
	path: String,
) -> Result[CoreOperationResultBridge, CoreJsonError]:
	builtin_name ?= string_field(value, path, "builtin_name")
	runtime_c_name ?= string_field(value, path, "runtime_c_name")
	runtime_result_c_type ?= string_field(value, path, "runtime_result_c_type")
	temp_prefix ?= string_field(value, path, "temp_prefix")
	policy_json ?= object_field(value, path, "result_layout_policy")
	result_layout_policy ?= decode_result_layout_policy_json(
		policy_json,
		path_field(path, "result_layout_policy"),
	)
	success_json ?= object_field(value, path, "success")
	success ?= decode_operation_success_payload_json(
		success_json,
		path_field(path, "success"),
	)
	error_json ?= object_field(value, path, "error")
	error ?= decode_operation_error_mapping_json(
		error_json,
		path_field(path, "error"),
	)

	Ok({
		builtin_name = builtin_name,
		runtime_c_name = runtime_c_name,
		runtime_result_c_type = runtime_result_c_type,
		temp_prefix = temp_prefix,
		result_layout_policy = result_layout_policy,
		success = success,
		error = error,
	})


private pure func fallible_stream_terminal_payload_to_json(
	payload: CoreFallibleStreamTerminalPayload,
) -> JsonValue:
	match payload:
		FallibleStreamPayloadList(list_payload):
			JsonObject([
				(KIND_FIELD, JsonString(FALLIBLE_STREAM_PAYLOAD_LIST_TAG)),
				("storage_mode", JsonString(list_payload.storage_mode)),
				("elem_size", JsonString(list_payload.elem_size)),
			])
		FallibleStreamPayloadErased:
			JsonObject([(KIND_FIELD, JsonString(FALLIBLE_STREAM_PAYLOAD_ERASED_TAG))])
		FallibleStreamPayloadInt:
			JsonObject([(KIND_FIELD, JsonString(FALLIBLE_STREAM_PAYLOAD_INT_TAG))])
		FallibleStreamPayloadOption:
			JsonObject([(KIND_FIELD, JsonString(FALLIBLE_STREAM_PAYLOAD_OPTION_TAG))])
		FallibleStreamPayloadBool:
			JsonObject([(KIND_FIELD, JsonString(FALLIBLE_STREAM_PAYLOAD_BOOL_TAG))])


private pure func decode_fallible_stream_terminal_payload_json(
	value: JsonValue,
	path: String,
) -> Result[CoreFallibleStreamTerminalPayload, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == FALLIBLE_STREAM_PAYLOAD_LIST_TAG:
		storage_mode ?= string_field(value, path, "storage_mode")
		elem_size ?= string_field(value, path, "elem_size")
		Ok(FallibleStreamPayloadList({
			storage_mode = storage_mode,
			elem_size = elem_size,
		}))
	else if tag == FALLIBLE_STREAM_PAYLOAD_ERASED_TAG:
		Ok(FallibleStreamPayloadErased)
	else if tag == FALLIBLE_STREAM_PAYLOAD_INT_TAG:
		Ok(FallibleStreamPayloadInt)
	else if tag == FALLIBLE_STREAM_PAYLOAD_OPTION_TAG:
		Ok(FallibleStreamPayloadOption)
	else if tag == FALLIBLE_STREAM_PAYLOAD_BOOL_TAG:
		Ok(FallibleStreamPayloadBool)
	else:
		Err(CoreUnsupportedTag(path, tag))


