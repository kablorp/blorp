union CoreSourceLoc:
	KnownSourceLoc(String, Int, Int, Int, Int)
	SyntheticSourceLoc


record CoreVar {
	name: String,
	uniq: Int,
	def_id: Option[Int]
}


-- Definition ids are module-local, so a resolved definition is identified by
-- both its qualified name and id.
record CoreDefinitionIdentity {
	name: String,
	def_id: Int
}


-- Callable definition identity is metadata. Local variable identity remains
-- the source name plus the hygiene tag, matching Core.Var.equal in the host.
pure func core_var_equal(left: CoreVar, right: CoreVar) -> Bool:
	left.name == right.name and left.uniq == right.uniq


pure func core_vars_have_same_definition(left: CoreVar, right: CoreVar) -> Bool:
	if left.name != right.name:
		False
	else:
		match (left.def_id, right.def_id):
			(Some(left_id), Some(right_id)):
				left_id == right_id
			_:
				False


union CoreType:
	VoidType
	NamedType(String, List[CoreType])
	TypeParameterType(String)
	SelfType
	FunctionType(Bool, List[CoreType], CoreType)
	StackResultType(CoreType, CoreType)
	BoxedResultType(CoreType, CoreType)
	EnumType(String)
	ValueRecordType(String)
	HeapRecordType(String)
	UnionType(String)
	RangeType
	TensorType(CoreTensorTypeInfo)
	TupleType(List[CoreType])


enum CoreDimOp:
	DimAdd
	DimSubtract
	DimMultiply
	DimDivide


union CoreTensorDim:
	TensorStaticDim(Int)
	TensorRuntimeDim(String)
	TensorVariadicDim(String)
	TensorDimOperation(CoreDimOp, CoreTensorDim, CoreTensorDim)


record CoreTensorTypeInfo {
	element_type: CoreType,
	dims: List[CoreTensorDim]
}


union CoreLiteral:
	IntLiteral(Int)
	WideIntLiteral(String)
	FloatLiteral(Float)
	FloatTextLiteral(String)
	FloatInfinityLiteral
	FloatNegInfinityLiteral
	FloatNanLiteral
	BoolLiteral(Bool)
	CharLiteral(Int)
	StringLiteral(String)


-- Source patterns remain explicit until the middle Core match pass compiles
-- them into decision trees. This is a Core phase type, not a typed-AST
-- passthrough: source spans and inferred binder types have already served
-- their purpose by this boundary.
union CorePattern:
	WildcardPattern
	NamePattern(String)
	LiteralPattern(CoreLiteral)
	ConstructorPattern(String, List[CorePattern])
	QualifiedConstructorPattern(String, String, List[CorePattern])
	TuplePattern(List[CorePattern])
	ListPattern(List[CorePattern], Option[CorePattern])
	OrPattern(List[CorePattern])


-- RuntimeIntField is encoded through an erased-union pointer payload.
-- RuntimeTypedIntField is passed directly to a typed-union constructor.
union CoreRuntimeUnionArg:
	RuntimeOwnedField(String)
	RuntimeIntField(String)
	RuntimeTypedIntField(String)


record CoreRuntimeUnionCase {
	runtime_tag: String,
	constructor_name: String,
	constructor_c_name: String,
	args: List[CoreRuntimeUnionArg]
}


union CoreRuntimeSuccessPayload:
	RuntimeNoPayload
	RuntimeField(String)
	RuntimeRecordFields(List[String])
	RuntimeUnionPayload(String, List[CoreRuntimeUnionCase])


record CoreOperationSuccessPayload {
	runtime_payload: CoreRuntimeSuccessPayload,
	release_mask: Int
}


record CoreOperationErrorCase {
	runtime_tag: String,
	constructor_name: String,
	constructor_c_name: String
}


record CoreOperationErrorMapping {
	none_tag: String,
	detail_field: String,
	other_constructor: String,
	other_constructor_c_name: String,
	cases: List[CoreOperationErrorCase]
}


union CoreOperationResultLayoutPolicy:
	DefaultResultLayoutPolicy
	BoxedResultOnlyPolicy(String)


enum CoreForeignCopyKind:
	ForeignStringCopy
	ForeignBytesCopy


union CoreForeignDefaultArgPolicy:
	ForeignScalarByValue
	ForeignDefensiveCopy(CoreForeignCopyKind)


union CoreForeignArgPassing:
	ForeignDefaultArgs(List[CoreForeignDefaultArgPolicy])
	ForeignBorrowArgs


record CoreOperationResultBridge {
	builtin_name: String,
	runtime_c_name: String,
	runtime_result_c_type: String,
	temp_prefix: String,
	result_layout_policy: CoreOperationResultLayoutPolicy,
	success: CoreOperationSuccessPayload,
	error: CoreOperationErrorMapping
}


record CoreFallibleStreamListPayload {
	storage_mode: String,
	elem_size: String
}


union CoreFallibleStreamTerminalPayload:
	FallibleStreamPayloadList(CoreFallibleStreamListPayload)
	FallibleStreamPayloadErased
	FallibleStreamPayloadInt
	FallibleStreamPayloadOption
	FallibleStreamPayloadBool


record CoreFallibleStreamErrorDomain {
	domain_tag: String,
	other_constructor: String,
