private pure func core_task_capture_kind_to_json(kind: CoreTaskCaptureKind) -> JsonValue:
	match kind:
		TaskCopyCapture:
			JsonString(TASK_COPY_CAPTURE_TAG)
		TaskMoveResourceItem:
			JsonString(TASK_MOVE_RESOURCE_ITEM_CAPTURE_TAG)
		TaskStructuredTaskBorrow:
			JsonString(TASK_STRUCTURED_TASK_BORROW_CAPTURE_TAG)


private pure func decode_core_task_capture_kind_tag(
	tag: String,
	path: String,
) -> Result[CoreTaskCaptureKind, CoreJsonError]:
	if tag == TASK_COPY_CAPTURE_TAG:
		Ok(TaskCopyCapture)
	else if tag == TASK_MOVE_RESOURCE_ITEM_CAPTURE_TAG:
		Ok(TaskMoveResourceItem)
	else if tag == TASK_STRUCTURED_TASK_BORROW_CAPTURE_TAG:
		Ok(TaskStructuredTaskBorrow)
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_task_capture_to_json(capture: CoreTaskCapture) -> JsonValue:
	JsonObject([
		("name", JsonString(capture.name)),
		("type", core_type_to_json(capture.typ)),
		("kind", core_task_capture_kind_to_json(capture.kind)),
	])


pure func decode_core_task_capture_json(
	value: JsonValue,
	path: String,
) -> Result[CoreTaskCapture, CoreJsonError]:
	name ?= string_field(value, path, "name")
	type_json ?= object_field(value, path, "type")
	typ ?= decode_core_type_json(
		type_json,
		path_field(path, "type"),
	)
	kind_tag ?= string_field(value, path, "kind")
	kind ?= decode_core_task_capture_kind_tag(
		kind_tag,
		path_field(path, "kind"),
	)

	Ok({
		name = name,
		typ = typ,
		kind = kind,
	})


private pure func decode_core_task_captures(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreTaskCapture], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreTaskCapture] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_task_capture_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(capture):
						result = result.append(capture)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


private pure func core_task_closure_to_json(task: CoreTaskClosure) -> JsonValue:
	JsonObject([
		("function_name", JsonString(task.function_name)),
		("def_id", json_int(task.def_id)),
		("c_name", JsonString(task.c_name)),
		("static_name", JsonString(task.static_name)),
		("captures", JsonVector(task.captures.map(core_task_capture_to_json))),
		("return_type", core_type_to_json(task.return_type)),
	])


private pure func decode_core_task_closure_json(
	value: JsonValue,
	path: String,
) -> Result[CoreTaskClosure, CoreJsonError]:
	function_name ?= string_field(value, path, "function_name")
	def_id ?= int_field(value, path, "def_id")
	c_name ?= string_field(value, path, "c_name")
	static_name ?= string_field(value, path, "static_name")
	captures ?= decode_core_task_captures(value, path, "captures")
	return_type_json ?= object_field(value, path, "return_type")
	return_type ?= decode_core_type_json(
		return_type_json,
		path_field(path, "return_type"),
	)

	Ok({
		function_name = function_name,
		def_id = def_id,
		c_name = c_name,
		static_name = static_name,
		captures = captures,
		return_type = return_type,
	})


private pure func decode_core_detach_json(
	value: JsonValue,
	path: String,
) -> Result[CoreTaskClosure, CoreJsonError]:
	task_json ?= object_field(value, path, "task")
	task ?= decode_core_task_closure_json(
		task_json,
		path_field(path, "task"),
	)

	Ok(task)


