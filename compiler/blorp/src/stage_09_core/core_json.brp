		value = expr_value,
	})


private pure func core_record_fields_to_json(fields: List[CoreRecordFieldValue]) -> JsonValue:
	JsonVector(fields.map(core_record_field_value_to_json))


private pure func decode_core_record_fields(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreRecordFieldValue], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreRecordFieldValue] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_record_field_value_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(field):
						result = result.append(field)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func core_union_representation_to_json(representation: CoreUnionRepresentation) -> JsonValue:
	match representation:
		GenericUnionRepresentation:
			JsonObject([(KIND_FIELD, JsonString(GENERIC_UNION_REPRESENTATION_TAG))])
		BoxedOptionRepresentation:
			JsonObject([(KIND_FIELD, JsonString(BOXED_OPTION_UNION_REPRESENTATION_TAG))])
		StackOptionRepresentation(info):
			JsonObject([
				(KIND_FIELD, JsonString(STACK_OPTION_UNION_REPRESENTATION_TAG)),
				("option_type", JsonString(info.option_type)),
				("tag", json_int(info.tag)),
				("none_value", JsonString(info.none_value)),
			])
		StackResultRepresentation(info):
			JsonObject([
				(KIND_FIELD, JsonString(STACK_RESULT_UNION_REPRESENTATION_TAG)),
				("result_type", JsonString(info.result_type)),
				("tag", json_int(info.tag)),
				("release_mask", json_int(info.release_mask)),
			])
		NullableOptionRepresentation:
			JsonObject([(KIND_FIELD, JsonString(NULLABLE_OPTION_UNION_REPRESENTATION_TAG))])


pure func decode_core_union_representation_json(
	value: JsonValue,
	path: String,
) -> Result[CoreUnionRepresentation, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == GENERIC_UNION_REPRESENTATION_TAG:
		Ok(GenericUnionRepresentation)
	else if tag == BOXED_OPTION_UNION_REPRESENTATION_TAG:
		Ok(BoxedOptionRepresentation)
	else if tag == STACK_OPTION_UNION_REPRESENTATION_TAG:
		option_type ?= string_field(value, path, "option_type")
		tag_value ?= int_field(value, path, "tag")
		none_value ?= string_field(value, path, "none_value")
		Ok(StackOptionRepresentation({
			option_type = option_type,
			tag = tag_value,
			none_value = none_value,
		}))
	else if tag == STACK_RESULT_UNION_REPRESENTATION_TAG:
		result_type ?= string_field(value, path, "result_type")
		tag_value ?= int_field(value, path, "tag")
		release_mask ?= int_field(value, path, "release_mask")
		Ok(StackResultRepresentation({
			result_type = result_type,
			tag = tag_value,
			release_mask = release_mask,
		}))
	else if tag == NULLABLE_OPTION_UNION_REPRESENTATION_TAG:
		Ok(NullableOptionRepresentation)
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_union_payload_storage_to_json(storage: CoreUnionPayloadStorage) -> JsonValue:
	match storage:
		TypedUnionPayloadStorage:
			JsonString(TYPED_UNION_PAYLOAD_STORAGE_TAG)
		ErasedUnionPayloadStorage:
			JsonString(ERASED_UNION_PAYLOAD_STORAGE_TAG)


pure func decode_core_union_payload_storage_json(
	value: JsonValue,
	path: String,
) -> Result[CoreUnionPayloadStorage, CoreJsonError]:
	match as_string(value):
		Some(tag):
			if tag == TYPED_UNION_PAYLOAD_STORAGE_TAG:
				Ok(TypedUnionPayloadStorage)
			else if tag == ERASED_UNION_PAYLOAD_STORAGE_TAG:
				Ok(ErasedUnionPayloadStorage)
			else:
				Err(CoreUnsupportedTag(path, tag))
		None:
			Err(CoreExpectedStringField(path, "payload_storage"))


pure func core_union_construct_to_json(construct: CoreUnionConstruct) -> JsonValue:
	JsonObject([
		("type_name", JsonString(construct.type_name)),
		("constructor_name", JsonString(construct.constructor_name)),
		("constructor_c_name", JsonString(construct.constructor_c_name)),
		("representation", core_union_representation_to_json(construct.representation)),
		("payload_storage", core_union_payload_storage_to_json(construct.payload_storage)),
		("uses_release_mask", JsonBool(construct.uses_release_mask)),
		("release_mask", json_int(construct.release_mask)),
		("args", core_boxed_storage_values_to_json(construct.args)),
	])


pure func decode_core_union_construct_json(
	value: JsonValue,
	path: String,
) -> Result[CoreUnionConstruct, CoreJsonError]:
	type_name ?= string_field(value, path, "type_name")
	constructor_name ?= string_field(value, path, "constructor_name")
	constructor_c_name ?= string_field(value, path, "constructor_c_name")
	representation_json ?= object_field(value, path, "representation")
	representation ?= decode_core_union_representation_json(
		representation_json,
		path_field(path, "representation"),
	)
	payload_storage_value ?= required_field(value, path, "payload_storage")
	payload_storage ?= decode_core_union_payload_storage_json(
		payload_storage_value,
		path_field(path, "payload_storage"),
	)
	uses_release_mask ?= bool_field(value, path, "uses_release_mask")
	release_mask ?= int_field(value, path, "release_mask")
	args ?= decode_core_boxed_storage_values(value, path, "args")

	Ok({
		type_name = type_name,
		constructor_name = constructor_name,
		constructor_c_name = constructor_c_name,
		representation = representation,
		payload_storage = payload_storage,
		uses_release_mask = uses_release_mask,
		release_mask = release_mask,
		args = args,
	})


pure func core_union_reuse_construct_to_json(construct: CoreUnionReuseConstruct) -> JsonValue:
	JsonObject([
		("source", core_expr_to_json(construct.source)),
		("type_name", JsonString(construct.type_name)),
		("constructor_name", JsonString(construct.constructor_name)),
		("constructor_c_name", JsonString(construct.constructor_c_name)),
		("reuse_constructor_c_name", JsonString(construct.reuse_constructor_c_name)),
		("representation", core_union_representation_to_json(construct.representation)),
		("payload_storage", core_union_payload_storage_to_json(construct.payload_storage)),
		("uses_release_mask", JsonBool(construct.uses_release_mask)),
		("release_mask", json_int(construct.release_mask)),
		("args", core_boxed_storage_values_to_json(construct.args)),
	])


pure func decode_core_union_reuse_construct_json(
	value: JsonValue,
	path: String,
) -> Result[CoreUnionReuseConstruct, CoreJsonError]:
	source_json ?= object_field(value, path, "source")
	source ?= decode_core_expr_json(
		source_json,
		path_field(path, "source"),
	)
	type_name ?= string_field(value, path, "type_name")
	constructor_name ?= string_field(value, path, "constructor_name")
	constructor_c_name ?= string_field(value, path, "constructor_c_name")
	reuse_constructor_c_name ?= string_field(value, path, "reuse_constructor_c_name")
	representation_json ?= object_field(value, path, "representation")
	representation ?= decode_core_union_representation_json(
		representation_json,
		path_field(path, "representation"),
	)
	payload_storage_value ?= required_field(value, path, "payload_storage")
	payload_storage ?= decode_core_union_payload_storage_json(
		payload_storage_value,
		path_field(path, "payload_storage"),
	)
	uses_release_mask ?= bool_field(value, path, "uses_release_mask")
	release_mask ?= int_field(value, path, "release_mask")
	args ?= decode_core_boxed_storage_values(value, path, "args")

	Ok({
		source = source,
		type_name = type_name,
		constructor_name = constructor_name,
		constructor_c_name = constructor_c_name,
		reuse_constructor_c_name = reuse_constructor_c_name,
		representation = representation,
		payload_storage = payload_storage,
		uses_release_mask = uses_release_mask,
		release_mask = release_mask,
		args = args,
	})


pure func core_binary_op_to_string(op: CoreBinaryOp) -> String:
	match op:
		AddOp:
			ADD_OP_TAG
		SubtractOp:
			SUBTRACT_OP_TAG
		MultiplyOp:
			MULTIPLY_OP_TAG
		DivideOp:
			DIVIDE_OP_TAG
		ModuloOp:
			MODULO_OP_TAG
		EqualOp:
			EQUAL_OP_TAG
		NotEqualOp:
			NOT_EQUAL_OP_TAG
		LessOp:
			LESS_OP_TAG
		LessEqualOp:
			LESS_EQUAL_OP_TAG
		GreaterOp:
			GREATER_OP_TAG
		GreaterEqualOp:
			GREATER_EQUAL_OP_TAG


pure func parse_core_binary_op(tag: String, path: String) -> Result[CoreBinaryOp, CoreJsonError]:
	if tag == ADD_OP_TAG:
		Ok(AddOp)
	else if tag == SUBTRACT_OP_TAG:
		Ok(SubtractOp)
	else if tag == MULTIPLY_OP_TAG:
		Ok(MultiplyOp)
	else if tag == DIVIDE_OP_TAG:
		Ok(DivideOp)
	else if tag == MODULO_OP_TAG:
		Ok(ModuloOp)
	else if tag == EQUAL_OP_TAG:
		Ok(EqualOp)
	else if tag == NOT_EQUAL_OP_TAG:
		Ok(NotEqualOp)
	else if tag == LESS_OP_TAG:
		Ok(LessOp)
	else if tag == LESS_EQUAL_OP_TAG:
		Ok(LessEqualOp)
	else if tag == GREATER_OP_TAG:
		Ok(GreaterOp)
	else if tag == GREATER_EQUAL_OP_TAG:
		Ok(GreaterEqualOp)
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_unary_op_to_string(op: CoreUnaryOp) -> String:
	match op:
		NegateOp:
			NEGATE_OP_TAG
		NotOp:
			NOT_OP_TAG


pure func parse_core_unary_op(tag: String, path: String) -> Result[CoreUnaryOp, CoreJsonError]:
	if tag == NEGATE_OP_TAG:
		Ok(NegateOp)
	else if tag == NOT_OP_TAG:
		Ok(NotOp)
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_logical_op_to_string(op: CoreLogicalOp) -> String:
