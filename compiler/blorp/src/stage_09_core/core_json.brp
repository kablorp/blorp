		("params", core_params_to_json(abi.params)),
		("captures", core_closure_captures_to_json(abi.captures)),
		("moved_captures", strings_to_json(abi.moved_captures)),
		("task_abi", JsonBool(abi.task_abi)),
	])


pure func decode_core_closure_abi_json(
	value: JsonValue,
	path: String,
) -> Result[CoreClosureAbi, CoreJsonError]:
	c_name ?= string_field(value, path, "c_name")
	params ?= decode_core_params(value, path, "params")
	captures ?= decode_core_closure_captures(value, path, "captures")
	moved_captures ?= decode_string_list(value, path, "moved_captures")
	task_abi ?= bool_field(value, path, "task_abi")

	Ok({
		c_name = c_name,
		params = params,
		captures = captures,
		moved_captures = moved_captures,
		task_abi = task_abi,
	})


