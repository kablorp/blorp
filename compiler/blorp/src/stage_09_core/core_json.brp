private pure func decode_core_expr_record_update_from_json(
	value: JsonValue,
	path: String,
) -> Result[CoreExpr, CoreJsonError]:
	base_json ?= object_field(value, path, "base")
	base ?= decode_core_expr_json(
		base_json,
		path_field(path, "base"),
	)
	fields ?= decode_core_record_fields(value, path, "fields")
	type_json ?= object_field(value, path, "type")
	typ ?= decode_core_type_json(
		type_json,
		path_field(path, "type"),
	)
	loc_json ?= object_field(value, path, "loc")
	loc ?= decode_source_loc_json(
		loc_json,
		path_field(path, "loc"),
	)

	match base:
		VarExpr(_, base_type, _):
			match (base_type, typ):
				(ValueRecordType(base_name), ValueRecordType(result_name)):
					if base_name == result_name:
						Ok(RecordUpdateExpr(base, fields, typ, loc))
					else:
						Err(
							CoreInvalidRecordUpdateShape(
								path_field(
									path_field(path, "base"),
									"type",
								),
								"record update base and result must have the same record type",
							),
						)
				(HeapRecordType(base_name), HeapRecordType(result_name)):
					if base_name == result_name:
						Ok(RecordUpdateExpr(base, fields, typ, loc))
					else:
						Err(
							CoreInvalidRecordUpdateShape(
								path_field(
									path_field(path, "base"),
									"type",
								),
								"record update base and result must have the same record type",
							),
						)
				(_, ValueRecordType(_)):
					Err(
						CoreInvalidRecordUpdateShape(
							path_field(
								path_field(path, "base"),
								"type",
							),
							"record update base and result must have the same record type and storage",
						),
					)
				(_, HeapRecordType(_)):
					Err(
						CoreInvalidRecordUpdateShape(
							path_field(
								path_field(path, "base"),
								"type",
							),
							"record update base and result must have the same record type and storage",
						),
					)
				_:
					Err(
						CoreInvalidRecordUpdateShape(
							path_field(path, "type"),
							"record update type must be a value or heap record",
						),
					)
		_:
			Err(CoreExpectedVariableExpr(path_field(path, "base")))


private pure func decode_core_expr_record_reuse_from_json(
	value: JsonValue,
	path: String,
) -> Result[CoreExpr, CoreJsonError]:
	source_json ?= object_field(value, path, "source")
	source ?= decode_core_expr_json(
		source_json,
		path_field(path, "source"),
	)
	fields ?= decode_core_record_fields(value, path, "fields")
	type_json ?= object_field(value, path, "type")
	typ ?= decode_core_type_json(
		type_json,
		path_field(path, "type"),
	)
	loc_json ?= object_field(value, path, "loc")
	loc ?= decode_source_loc_json(
		loc_json,
		path_field(path, "loc"),
	)

	match source:
		VarExpr(_, source_type, _):
			match typ:
				HeapRecordType(result_name):
					match source_type:
						HeapRecordType(source_name):
							if source_name == result_name:
								Ok(RecordReuseExpr(source, fields, typ, loc))
							else:
								Err(
									CoreInvalidRecordUpdateShape(
										path_field(
											path_field(path, "source"),
											"type",
										),
										"record reuse source and result must have the same heap-record type",
									),
								)
						_:
							Err(
								CoreInvalidRecordUpdateShape(
									path_field(
										path_field(path, "source"),
										"type",
									),
									"record reuse source type must be a heap record",
								),
							)
				_:
					Err(
						CoreInvalidRecordUpdateShape(
							path_field(path, "type"),
							"record reuse type must be a heap record",
						),
					)
		_:
			Err(CoreExpectedVariableExpr(path_field(path, "source")))


