		path_field(path, "for_type"),
	)
	type_params ?= decode_core_type_params(value, path)
	methods ?= decode_core_functions(value, path, "methods")
	loc_json ?= object_field(value, path, "loc")
	loc ?= decode_source_loc_json(
		loc_json,
		path_field(path, "loc"),
