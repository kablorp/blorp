		path_field(path, "parent"),
	)


pure func decode_core_semantic_match_accessor_json(
	value: JsonValue,
	path: String,
) -> Result[CoreSemanticMatchAccessor, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == ROOT_ACCESSOR_TAG:
		Ok(RootSemanticMatchAccessor)
	else if tag == VARIANT_FIELD_ACCESSOR_TAG:
		parent ?= decode_core_semantic_match_accessor_parent(value, path)
		constructor ?= string_field(value, path, "constructor")
		field_index ?= int_field(value, path, "field_index")
		Ok(VariantFieldSemanticMatchAccessor(parent, constructor, field_index))
	else if tag == TUPLE_FIELD_ACCESSOR_TAG:
		parent ?= decode_core_semantic_match_accessor_parent(value, path)
		index ?= int_field(value, path, "index")
		Ok(TupleFieldSemanticMatchAccessor(parent, index))
	else if tag == LIST_ELEMENT_ACCESSOR_TAG:
		parent ?= decode_core_semantic_match_accessor_parent(value, path)
		index ?= int_field(value, path, "index")
		Ok(ListElementSemanticMatchAccessor(parent, index))
	else if tag == LIST_SPREAD_ACCESSOR_TAG:
		parent ?= decode_core_semantic_match_accessor_parent(value, path)
		offset ?= int_field(value, path, "offset")
		Ok(ListSpreadSemanticMatchAccessor(parent, offset))
	else:
		Err(CoreUnsupportedTag(path, tag))


private pure func decode_core_semantic_match_binding_json(
	value: JsonValue,
	path: String,
) -> Result[CoreSemanticMatchBinding, CoreJsonError]:
	variable_json ?= object_field(value, path, "variable")
	variable ?= decode_core_var_json(
		variable_json,
		path_field(path, "variable"),
	)
	accessor_json ?= object_field(value, path, "accessor")
	accessor ?= decode_core_semantic_match_accessor_json(
		accessor_json,
		path_field(path, "accessor"),
	)
	mode_json ?= required_field(value, path, "mode")
	mode ?= decode_core_match_binding_mode_json(
		mode_json,
		path_field(path, "mode"),
	)

	Ok({
		variable = variable,
		accessor = accessor,
		mode = mode,
	})


private pure func decode_core_semantic_constructor_match_case_json(
	value: JsonValue,
