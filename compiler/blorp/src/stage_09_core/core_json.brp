	else if tag == LIST_HANDOFF_SET_SOURCE_SLOT_EXPR_TAG:
		decode_core_expr_list_handoff_set_source_slot_from_json(value, path)
	else if tag == STRING_BYTE_READ_EXPR_TAG:
		decode_core_expr_string_byte_read_from_json(value, path)
	else if tag == STRING_BYTE_WRITE_EXPR_TAG:
