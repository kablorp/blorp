	else if tag == FOR_TENSOR_EXPR_TAG:
		decode_core_expr_for_tensor_from_json(value, path)
	else if tag == PRE_CLOSURE_CONCURRENTLY_LOOP_EXPR_TAG:
		decode_core_expr_pre_closure_concurrently_loop_from_json(value, path)
	else if tag == CONCURRENTLY_LOOP_EXPR_TAG:
		decode_core_expr_concurrently_loop_from_json(value, path)
	else if tag == PRE_CLOSURE_CONCURRENT_EXPR_TAG:
		decode_core_expr_pre_closure_concurrent_from_json(value, path)
	else if tag == CONCURRENT_EXPR_TAG:
		decode_core_expr_concurrent_from_json(value, path)
	else if tag == SELECT_EXPR_TAG:
		decode_core_expr_select_from_json(value, path)
	else if tag == RANGE_EXPR_TAG:
		decode_core_expr_range_from_json(value, path)
	else if tag == RAW_MATCH_EXPR_TAG:
		decode_core_expr_raw_match_from_json(value, path)
	else if tag == SEMANTIC_MATCH_EXPR_TAG:
		decode_core_expr_semantic_match_from_json(value, path)
	else if tag == LITERAL_MATCH_EXPR_TAG:
		decode_core_expr_literal_match_from_json(value, path)
	else if tag == ACCESSOR_LITERAL_MATCH_EXPR_TAG:
		decode_core_expr_accessor_literal_match_from_json(value, path)
	else if tag == LENGTH_MATCH_EXPR_TAG:
		decode_core_expr_length_match_from_json(value, path)
	else if tag == CONSTRUCTOR_MATCH_EXPR_TAG:
		decode_core_expr_constructor_match_from_json(value, path)
	else if tag == IF_EXPR_TAG:
		decode_core_expr_if_from_json(value, path)
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_param_to_json(param: CoreParam) -> JsonValue:
	JsonObject([
		("name", core_var_to_json(param.name)),
		("type", core_type_to_json(param.typ)),
		("loc", source_loc_to_json(param.loc)),
	])


pure func decode_core_param_json(
	value: JsonValue,
	path: String,
) -> Result[CoreParam, CoreJsonError]:
	name_json ?= object_field(value, path, "name")
	name ?= decode_core_var_json(
		name_json,
		path_field(path, "name"),
	)
	type_json ?= object_field(value, path, "type")
	typ ?= decode_core_type_json(
		type_json,
		path_field(path, "type"),
	)
	loc_json ?= object_field(value, path, "loc")
	loc ?= decode_source_loc_json(
		loc_json,
		path_field(path, "loc"),
	)

	Ok({
		name = name,
		typ = typ,
		loc = loc,
	})


private pure func core_params_to_json(params: List[CoreParam]) -> JsonValue:
	JsonVector(params.map(core_param_to_json))


private pure func decode_core_params(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreParam], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreParam] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_param_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(param):
						result = result.append(param)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


