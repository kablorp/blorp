	])


private pure func decode_fallible_stream_error_domain_json(
	value: JsonValue,
	path: String,
) -> Result[CoreFallibleStreamErrorDomain, CoreJsonError]:
	domain_tag ?= string_field(value, path, "domain_tag")
	other_constructor ?= string_field(value, path, "other_constructor")
	other_constructor_c_name ?= string_field(value, path, "other_constructor_c_name")
	cases ?= decode_operation_error_cases(value, path, "cases")

	Ok({
		domain_tag = domain_tag,
		other_constructor = other_constructor,
		other_constructor_c_name = other_constructor_c_name,
		cases = cases,
	})


private pure func fallible_stream_terminal_bridge_to_json(
	bridge: CoreFallibleStreamTerminalBridge,
) -> JsonValue:
	JsonObject([
		("builtin_name", JsonString(bridge.builtin_name)),
		("runtime_c_name", JsonString(bridge.runtime_c_name)),
		("runtime_result_c_type", JsonString(bridge.runtime_result_c_type)),
		("payload", fallible_stream_terminal_payload_to_json(bridge.payload)),
		("error_domain", fallible_stream_error_domain_to_json(bridge.error_domain)),
	])


private pure func decode_fallible_stream_terminal_bridge_json(
	value: JsonValue,
	path: String,
) -> Result[CoreFallibleStreamTerminalBridge, CoreJsonError]:
	builtin_name ?= string_field(value, path, "builtin_name")
	runtime_c_name ?= string_field(value, path, "runtime_c_name")
	runtime_result_c_type ?= string_field(value, path, "runtime_result_c_type")
	payload_json ?= object_field(value, path, "payload")
	payload ?= decode_fallible_stream_terminal_payload_json(
		payload_json,
		path_field(path, "payload"),
	)
	error_domain_json ?= object_field(value, path, "error_domain")
	error_domain ?= decode_fallible_stream_error_domain_json(
		error_domain_json,
		path_field(path, "error_domain"),
	)

	Ok({
		builtin_name = builtin_name,
		runtime_c_name = runtime_c_name,
		runtime_result_c_type = runtime_result_c_type,
		payload = payload,
		error_domain = error_domain,
	})


private pure func foreign_copy_kind_to_json(kind: CoreForeignCopyKind) -> JsonValue:
	match kind:
		ForeignStringCopy:
			JsonString(FOREIGN_STRING_COPY_TAG)
		ForeignBytesCopy:
			JsonString(FOREIGN_BYTES_COPY_TAG)


private pure func parse_foreign_copy_kind(
	tag: String,
	path: String,
) -> Result[CoreForeignCopyKind, CoreJsonError]:
	if tag == FOREIGN_STRING_COPY_TAG:
		Ok(ForeignStringCopy)
	else if tag == FOREIGN_BYTES_COPY_TAG:
		Ok(ForeignBytesCopy)
	else:
		Err(CoreUnsupportedTag(path, tag))


private pure func foreign_default_arg_policy_to_json(
	policy: CoreForeignDefaultArgPolicy,
) -> JsonValue:
	match policy:
		ForeignScalarByValue:
			JsonObject([(KIND_FIELD, JsonString(FOREIGN_SCALAR_BY_VALUE_TAG))])
		ForeignDefensiveCopy(copy_kind):
			JsonObject([
				(KIND_FIELD, JsonString(FOREIGN_DEFENSIVE_COPY_TAG)),
				("copy_kind", foreign_copy_kind_to_json(copy_kind)),
			])


private pure func decode_foreign_default_arg_policy_json(
	value: JsonValue,
	path: String,
) -> Result[CoreForeignDefaultArgPolicy, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == FOREIGN_SCALAR_BY_VALUE_TAG:
		Ok(ForeignScalarByValue)
	else if tag == FOREIGN_DEFENSIVE_COPY_TAG:
		copy_kind_tag ?= string_field(value, path, "copy_kind")
		copy_kind ?= parse_foreign_copy_kind(
			copy_kind_tag,
			path_field(path, "copy_kind"),
		)
		Ok(ForeignDefensiveCopy(copy_kind))
	else:
		Err(CoreUnsupportedTag(path, tag))


private pure func decode_foreign_default_arg_policies(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreForeignDefaultArgPolicy], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreForeignDefaultArgPolicy] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_foreign_default_arg_policy_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(policy):
						result = result.append(policy)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


private pure func foreign_arg_passing_to_json(passing: CoreForeignArgPassing) -> JsonValue:
	match passing:
		ForeignDefaultArgs(policies):
			JsonObject([
				(KIND_FIELD, JsonString(FOREIGN_DEFAULT_ARGS_TAG)),
				("policies", JsonVector(policies.map(foreign_default_arg_policy_to_json))),
			])
		ForeignBorrowArgs:
			JsonObject([(KIND_FIELD, JsonString(FOREIGN_BORROW_ARGS_TAG))])


private pure func decode_foreign_arg_passing_json(
	value: JsonValue,
	path: String,
) -> Result[CoreForeignArgPassing, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == FOREIGN_DEFAULT_ARGS_TAG:
		policies ?= decode_foreign_default_arg_policies(value, path, "policies")
		Ok(ForeignDefaultArgs(policies))
	else if tag == FOREIGN_BORROW_ARGS_TAG:
		Ok(ForeignBorrowArgs)
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func tensor_parallel_layout_to_json(layout: CoreTensorParallelLayout) -> JsonValue:
	match layout:
		TensorParallelPointerLayout:
			JsonObject([(KIND_FIELD, JsonString(TENSOR_PARALLEL_POINTER_LAYOUT_TAG))])
		TensorParallelRawScalarLayout(raw_kind):
			JsonObject([
				(KIND_FIELD, JsonString(TENSOR_PARALLEL_RAW_SCALAR_LAYOUT_TAG)),
				("raw_kind", core_tensor_raw_scalar_kind_to_json(raw_kind)),
			])
		TensorParallelInlineStructLayout(c_type):
			JsonObject([
				(KIND_FIELD, JsonString(TENSOR_PARALLEL_INLINE_STRUCT_LAYOUT_TAG)),
				("c_type", JsonString(c_type)),
			])


pure func decode_tensor_parallel_layout_json(
	value: JsonValue,
	path: String,
) -> Result[CoreTensorParallelLayout, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == TENSOR_PARALLEL_POINTER_LAYOUT_TAG:
		Ok(TensorParallelPointerLayout)
	else if tag == TENSOR_PARALLEL_RAW_SCALAR_LAYOUT_TAG:
		raw_kind_json ?= required_field(value, path, "raw_kind")
		raw_kind ?= decode_core_tensor_raw_scalar_kind_json(
			raw_kind_json,
			path_field(path, "raw_kind"),
		)
		Ok(TensorParallelRawScalarLayout(raw_kind))
	else if tag == TENSOR_PARALLEL_INLINE_STRUCT_LAYOUT_TAG:
		c_type ?= string_field(value, path, "c_type")
		Ok(TensorParallelInlineStructLayout(c_type))
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func direct_runtime_args_to_json(args: CoreDirectRuntimeArgs) -> JsonValue:
	match args:
		DirectRuntimeArgsAsWritten:
			JsonObject([(KIND_FIELD, JsonString(DIRECT_RUNTIME_ARGS_AS_WRITTEN_TAG))])
		DirectRuntimeArgsAppendListParallelLayout(layout):
			JsonObject([
				(KIND_FIELD, JsonString(DIRECT_RUNTIME_ARGS_LIST_PARALLEL_LAYOUT_TAG)),
				("semantic_arity", JsonNumber(to_float(layout.semantic_arity))),
				("layout", core_list_storage_layout_to_json(layout.layout)),
			])


pure func decode_direct_runtime_args_json(
	value: JsonValue,
	path: String,
) -> Result[CoreDirectRuntimeArgs, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == DIRECT_RUNTIME_ARGS_AS_WRITTEN_TAG:
		Ok(DirectRuntimeArgsAsWritten)
	else if tag == DIRECT_RUNTIME_ARGS_LIST_PARALLEL_LAYOUT_TAG:
		semantic_arity ?= int_field(value, path, "semantic_arity")
		layout_json ?= object_field(value, path, "layout")
		layout ?= decode_core_list_storage_layout_json(
			layout_json,
			path_field(path, "layout"),
		)
		Ok(DirectRuntimeArgsAppendListParallelLayout({
			semantic_arity = semantic_arity,
			layout = layout,
		}))
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func direct_runtime_result_to_json(result: CoreDirectRuntimeResult) -> JsonValue:
	match result:
		DirectRuntimeResultAsWritten:
			JsonObject([(KIND_FIELD, JsonString(DIRECT_RUNTIME_RESULT_AS_WRITTEN_TAG))])
		DirectRuntimeResultCast(c_type):
			JsonObject([
				(KIND_FIELD, JsonString(DIRECT_RUNTIME_RESULT_CAST_TAG)),
				("c_type", JsonString(c_type)),
			])
		DirectRuntimeResultStackResultFromBoxed:
			JsonObject(
				[(KIND_FIELD, JsonString(DIRECT_RUNTIME_RESULT_STACK_RESULT_FROM_BOXED_TAG))],
			)


pure func decode_direct_runtime_result_json(
	value: JsonValue,
	path: String,
) -> Result[CoreDirectRuntimeResult, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == DIRECT_RUNTIME_RESULT_AS_WRITTEN_TAG:
		Ok(DirectRuntimeResultAsWritten)
	else if tag == DIRECT_RUNTIME_RESULT_CAST_TAG:
		c_type ?= string_field(value, path, "c_type")
		Ok(DirectRuntimeResultCast(c_type))
	else if tag == DIRECT_RUNTIME_RESULT_STACK_RESULT_FROM_BOXED_TAG:
		Ok(DirectRuntimeResultStackResultFromBoxed)
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func direct_runtime_call_to_json(call: CoreDirectRuntimeCall) -> JsonValue:
	JsonObject([
		("name", JsonString(call.name)),
		("args", direct_runtime_args_to_json(call.args)),
		("result", direct_runtime_result_to_json(call.result)),
	])


pure func decode_direct_runtime_call_json(
	value: JsonValue,
	path: String,
) -> Result[CoreDirectRuntimeCall, CoreJsonError]:
	name ?= string_field(value, path, "name")
	args_json ?= object_field(value, path, "args")
	args ?= decode_direct_runtime_args_json(
		args_json,
		path_field(path, "args"),
	)
	result_json ?= object_field(value, path, "result")
	result ?= decode_direct_runtime_result_json(
		result_json,
		path_field(path, "result"),
	)

	Ok({
		name = name,
		args = args,
		result = result,
	})


pure func core_call_kind_to_json(kind: CoreCallKind) -> JsonValue:
	match kind:
		UnknownCall:
			JsonObject([(KIND_FIELD, JsonString(UNKNOWN_CALL_TAG))])
		SelectedDirectCall(def_id):
			JsonObject([
				(KIND_FIELD, JsonString(SELECTED_DIRECT_CALL_TAG)),
				("def_id", json_int(def_id)),
			])
		DeferredTraitCall(trait_name, method_name):
			JsonObject([
				(KIND_FIELD, JsonString(DEFERRED_TRAIT_CALL_TAG)),
				("trait_name", JsonString(trait_name)),
				("method_name", JsonString(method_name)),
			])
		SelectedTraitCall(trait_name, method_name, module_path, def_id):
			JsonObject([
				(KIND_FIELD, JsonString(SELECTED_TRAIT_CALL_TAG)),
				("trait_name", JsonString(trait_name)),
				("method_name", JsonString(method_name)),
				("module_path", JsonString(module_path)),
				("def_id", json_int(def_id)),
			])
		UserCall(name, def_id, consumed_args):
			JsonObject([
				(KIND_FIELD, JsonString(USER_CALL_TAG)),
				("name", JsonString(name)),
				("def_id", option_int_to_json(def_id)),
				("consumed_args", ints_to_json(consumed_args)),
			])
		ForeignCall(name, arg_passing):
			JsonObject([
				(KIND_FIELD, JsonString(FOREIGN_CALL_TAG)),
				("name", JsonString(name)),
				("arg_passing", foreign_arg_passing_to_json(arg_passing)),
			])
		BuiltinCall(name):
			JsonObject([
				(KIND_FIELD, JsonString(BUILTIN_CALL_TAG)),
				("name", JsonString(name)),
			])
		DirectRuntimeCall(call):
			JsonObject([
				(KIND_FIELD, JsonString(DIRECT_RUNTIME_CALL_TAG)),
				("call", direct_runtime_call_to_json(call)),
			])
		OperationResultCall(bridge):
			JsonObject([
				(KIND_FIELD, JsonString(OPERATION_RESULT_CALL_TAG)),
				("bridge", operation_result_bridge_to_json(bridge)),
			])
		FallibleStreamTerminalCall(bridge):
			JsonObject([
				(KIND_FIELD, JsonString(FALLIBLE_STREAM_TERMINAL_CALL_TAG)),
				("bridge", fallible_stream_terminal_bridge_to_json(bridge)),
			])
		TensorParallelCall(name, layout):
			JsonObject([
				(KIND_FIELD, JsonString(TENSOR_PARALLEL_CALL_TAG)),
				("name", JsonString(name)),
				("layout", tensor_parallel_layout_to_json(layout)),
			])
		DictWithCapacityCall(constructor):
			JsonObject([
				(KIND_FIELD, JsonString(DICT_WITH_CAPACITY_CALL_TAG)),
				("constructor", core_hash_container_constructor_to_json(constructor)),
			])
		ListToStringCall(callback_name):
			JsonObject([
				(KIND_FIELD, JsonString(LIST_TO_STRING_CALL_TAG)),
				("callback_name", JsonString(callback_name)),
			])
		IntrinsicCall(name):
			JsonObject([
				(KIND_FIELD, JsonString(INTRINSIC_CALL_TAG)),
				("name", JsonString(name)),
			])
		ClosureCall:
			JsonObject([(KIND_FIELD, JsonString(CLOSURE_CALL_TAG))])


pure func decode_core_call_kind_json(
	value: JsonValue,
	path: String,
) -> Result[CoreCallKind, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == UNKNOWN_CALL_TAG:
		Ok(UnknownCall)
	else if tag == SELECTED_DIRECT_CALL_TAG:
		def_id ?= int_field(value, path, "def_id")
		Ok(SelectedDirectCall(def_id))
	else if tag == DEFERRED_TRAIT_CALL_TAG:
		trait_name ?= string_field(value, path, "trait_name")
		method_name ?= string_field(value, path, "method_name")
		Ok(DeferredTraitCall(trait_name, method_name))
	else if tag == SELECTED_TRAIT_CALL_TAG:
		trait_name ?= string_field(value, path, "trait_name")
		method_name ?= string_field(value, path, "method_name")
		module_path ?= string_field(value, path, "module_path")
		def_id ?= int_field(value, path, "def_id")
		Ok(SelectedTraitCall(trait_name, method_name, module_path, def_id))
	else if tag == USER_CALL_TAG:
		name ?= string_field(value, path, "name")
		def_id ?= decode_optional_int(value, path, "def_id")
		consumed_args ?= decode_int_list(value, path, "consumed_args")
		Ok(UserCall(name, def_id, consumed_args))
	else if tag == FOREIGN_CALL_TAG:
		name ?= string_field(value, path, "name")
		arg_passing_json ?= object_field(value, path, "arg_passing")
		arg_passing ?= decode_foreign_arg_passing_json(
			arg_passing_json,
			path_field(path, "arg_passing"),
		)
		Ok(ForeignCall(name, arg_passing))
	else if tag == BUILTIN_CALL_TAG:
		name ?= string_field(value, path, "name")
		Ok(BuiltinCall(name))
	else if tag == DIRECT_RUNTIME_CALL_TAG:
		call_json ?= object_field(value, path, "call")
		call ?= decode_direct_runtime_call_json(
			call_json,
			path_field(path, "call"),
		)
		Ok(DirectRuntimeCall(call))
	else if tag == OPERATION_RESULT_CALL_TAG:
		bridge_json ?= object_field(value, path, "bridge")
		bridge ?= decode_operation_result_bridge_json(
			bridge_json,
			path_field(path, "bridge"),
		)
		Ok(OperationResultCall(bridge))
	else if tag == FALLIBLE_STREAM_TERMINAL_CALL_TAG:
		bridge_json ?= object_field(value, path, "bridge")
		bridge ?= decode_fallible_stream_terminal_bridge_json(
			bridge_json,
			path_field(path, "bridge"),
		)
		Ok(FallibleStreamTerminalCall(bridge))
	else if tag == TENSOR_PARALLEL_CALL_TAG:
		name ?= string_field(value, path, "name")
		layout_json ?= object_field(value, path, "layout")
		layout ?= decode_tensor_parallel_layout_json(
			layout_json,
			path_field(path, "layout"),
		)
		Ok(TensorParallelCall(name, layout))
	else if tag == DICT_WITH_CAPACITY_CALL_TAG:
		constructor_json ?= object_field(value, path, "constructor")
		constructor ?= decode_core_hash_container_constructor_json(
			constructor_json,
			path_field(path, "constructor"),
		)
		Ok(DictWithCapacityCall(constructor))
	else if tag == LIST_TO_STRING_CALL_TAG:
		callback_name ?= string_field(value, path, "callback_name")
		Ok(ListToStringCall(callback_name))
	else if tag == INTRINSIC_CALL_TAG:
		name ?= string_field(value, path, "name")
		Ok(IntrinsicCall(name))
	else if tag == CLOSURE_CALL_TAG:
		Ok(ClosureCall)
	else:
		Err(CoreUnsupportedTag(path, tag))


pure func core_tuple_element_to_json(element: CoreTupleElement) -> JsonValue:
	match element:
		TuplePrimElement(value):
			JsonObject([
				(KIND_FIELD, JsonString(TUPLE_PRIM_ELEMENT_TAG)),
				("value", core_expr_to_json(value)),
			])
		TuplePointerElement(value):
			JsonObject([
				(KIND_FIELD, JsonString(TUPLE_POINTER_ELEMENT_TAG)),
				("value", core_expr_to_json(value)),
			])
		TupleStructElement(value, c_type):
			JsonObject([
				(KIND_FIELD, JsonString(TUPLE_STRUCT_ELEMENT_TAG)),
				("value", core_expr_to_json(value)),
				("c_type", JsonString(c_type)),
			])
		TupleStackResultElement(value):
			JsonObject([
				(KIND_FIELD, JsonString(TUPLE_STACK_RESULT_ELEMENT_TAG)),
				("value", core_expr_to_json(value)),
			])
		TupleVoidElement:
			JsonObject([(KIND_FIELD, JsonString(TUPLE_VOID_ELEMENT_TAG))])
		TupleFloatElement(value):
			JsonObject([
				(KIND_FIELD, JsonString(TUPLE_FLOAT_ELEMENT_TAG)),
				("value", core_expr_to_json(value)),
			])
		TupleFloat32Element(value):
			JsonObject([
				(KIND_FIELD, JsonString(TUPLE_FLOAT32_ELEMENT_TAG)),
				("value", core_expr_to_json(value)),
			])
		TupleFloat16Element(value):
			JsonObject([
				(KIND_FIELD, JsonString(TUPLE_FLOAT16_ELEMENT_TAG)),
				("value", core_expr_to_json(value)),
			])


pure func decode_core_tuple_element_json(
	value: JsonValue,
	path: String,
) -> Result[CoreTupleElement, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == TUPLE_PRIM_ELEMENT_TAG:
		value_json ?= object_field(value, path, "value")
		expr_value ?= decode_core_expr_json(
			value_json,
			path_field(path, "value"),
		)
		Ok(TuplePrimElement(expr_value))
	else if tag == TUPLE_POINTER_ELEMENT_TAG:
		value_json ?= object_field(value, path, "value")
		expr_value ?= decode_core_expr_json(
			value_json,
			path_field(path, "value"),
		)
		Ok(TuplePointerElement(expr_value))
	else if tag == TUPLE_STRUCT_ELEMENT_TAG:
		value_json ?= object_field(value, path, "value")
		expr_value ?= decode_core_expr_json(
			value_json,
			path_field(path, "value"),
		)
		c_type ?= string_field(value, path, "c_type")
		Ok(TupleStructElement(expr_value, c_type))
	else if tag == TUPLE_STACK_RESULT_ELEMENT_TAG:
		value_json ?= object_field(value, path, "value")
		expr_value ?= decode_core_expr_json(
			value_json,
			path_field(path, "value"),
		)
		Ok(TupleStackResultElement(expr_value))
	else if tag == TUPLE_VOID_ELEMENT_TAG:
		Ok(TupleVoidElement)
	else if tag == TUPLE_FLOAT_ELEMENT_TAG:
		value_json ?= object_field(value, path, "value")
		expr_value ?= decode_core_expr_json(
			value_json,
			path_field(path, "value"),
		)
		Ok(TupleFloatElement(expr_value))
	else if tag == TUPLE_FLOAT32_ELEMENT_TAG:
		value_json ?= object_field(value, path, "value")
		expr_value ?= decode_core_expr_json(
			value_json,
			path_field(path, "value"),
		)
		Ok(TupleFloat32Element(expr_value))
	else if tag == TUPLE_FLOAT16_ELEMENT_TAG:
		value_json ?= object_field(value, path, "value")
		expr_value ?= decode_core_expr_json(
			value_json,
			path_field(path, "value"),
		)
		Ok(TupleFloat16Element(expr_value))
	else:
		Err(CoreUnsupportedTag(path, tag))


private pure func decode_core_tuple_elements(
	value: JsonValue,
	path: String,
	field_name: String,
) -> Result[List[CoreTupleElement], CoreJsonError]:
	items ?= array_field(value, path, field_name)
	var result: List[CoreTupleElement] = []
	var error: Option[CoreJsonError] = None
	var index: Int = 0

	for item in items:
		match error:
			Some(existing_error):
				void
			None:
				match decode_core_tuple_element_json(
					item,
					path_index(
						path_field(path, field_name),
						index,
					),
				):
					Ok(element):
						result = result.append(element)
					Err(err):
						error = Some(err)

		index += 1

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			Ok(result)


pure func core_tuple_construct_to_json(construct: CoreTupleConstruct) -> JsonValue:
	JsonObject([
		("elements", JsonVector(construct.elements.map(core_tuple_element_to_json))),
		("release_mask", json_int(construct.release_mask)),
		("retain_mask", json_int(construct.retain_mask)),
	])


pure func decode_core_tuple_construct_json(
	value: JsonValue,
	path: String,
) -> Result[CoreTupleConstruct, CoreJsonError]:
	elements ?= decode_core_tuple_elements(value, path, "elements")
	release_mask ?= int_field(value, path, "release_mask")
	retain_mask ?= int_field(value, path, "retain_mask")

	Ok({
		elements = elements,
		release_mask = release_mask,
		retain_mask = retain_mask,
	})


pure func core_box_kind_to_json(kind: CoreBoxKind) -> JsonValue:
	match kind:
		PrimBox:
			JsonObject([(KIND_FIELD, JsonString(BOX_PRIM_TAG))])
		PointerBox:
			JsonObject([(KIND_FIELD, JsonString(BOX_POINTER_TAG))])
		VoidBox:
			JsonObject([(KIND_FIELD, JsonString(BOX_VOID_TAG))])
		FloatBox:
			JsonObject([(KIND_FIELD, JsonString(BOX_FLOAT_TAG))])
		Float32Box:
			JsonObject([(KIND_FIELD, JsonString(BOX_FLOAT32_TAG))])
		Float16Box:
			JsonObject([(KIND_FIELD, JsonString(BOX_FLOAT16_TAG))])
		Int128Box:
			JsonObject([(KIND_FIELD, JsonString(BOX_INT128_TAG))])
		UInt128Box:
			JsonObject([(KIND_FIELD, JsonString(BOX_UINT128_TAG))])
		StructBox(c_type):
			JsonObject([
				(KIND_FIELD, JsonString(BOX_STRUCT_TAG)),
				("c_type", JsonString(c_type)),
			])


pure func decode_core_box_kind_json(
	value: JsonValue,
	path: String,
) -> Result[CoreBoxKind, CoreJsonError]:
	tag ?= kind_field(value, path)

	if tag == BOX_PRIM_TAG:
		Ok(PrimBox)
	else if tag == BOX_POINTER_TAG:
		Ok(PointerBox)
	else if tag == BOX_VOID_TAG:
		Ok(VoidBox)
	else if tag == BOX_FLOAT_TAG:
		Ok(FloatBox)
	else if tag == BOX_FLOAT32_TAG:
		Ok(Float32Box)
	else if tag == BOX_FLOAT16_TAG:
		Ok(Float16Box)
	else if tag == BOX_INT128_TAG:
		Ok(Int128Box)
	else if tag == BOX_UINT128_TAG:
		Ok(UInt128Box)
	else if tag == BOX_STRUCT_TAG:
		c_type ?= string_field(value, path, "c_type")
		Ok(StructBox(c_type))
	else:
		Err(CoreUnsupportedTag(path, tag))


