private pure func decode_core_concurrently_loop_json(
	value: JsonValue,
	path: String,
) -> Result[CoreConcurrentlyLoop, CoreJsonError]:
	var_json ?= object_field(value, path, "var")
	variable ?= decode_core_var_json(
		var_json,
		path_field(path, "var"),
	)
	item_type_json ?= object_field(value, path, "item_type")
	item_type ?= decode_core_type_json(
		item_type_json,
		path_field(path, "item_type"),
	)
	item_mode_json ?= object_field(value, path, "item_mode")
	item_mode ?= decode_core_concurrently_loop_item_mode_json(
		item_mode_json,
		path_field(path, "item_mode"),
	)
	iterable_json ?= object_field(value, path, "iterable")
	iterable ?= decode_core_expr_json(
		iterable_json,
		path_field(path, "iterable"),
	)
	body_json ?= object_field(value, path, "body")
	body ?= decode_core_expr_json(
		body_json,
		path_field(path, "body"),
	)
	timeout ?= decode_optional_expr(value, path, "timeout")
	limit_json ?= object_field(value, path, "limit")
	limit ?= decode_core_expr_json(
		limit_json,
		path_field(path, "limit"),
	)
	output_tag ?= string_field(value, path, "output")
	output ?= decode_core_concurrently_loop_output_tag(
		output_tag,
		path_field(path, "output"),
	)
	task_json ?= object_field(value, path, "task")
	task ?= decode_core_task_closure_json(
		task_json,
		path_field(path, "task"),
	)

	Ok({
		variable = variable,
		item_type = item_type,
		item_mode = item_mode,
		iterable = iterable,
		body = body,
		timeout = timeout,
		limit = limit,
		output = output,
		task = task,
	})


