-- Post-monomorphization Core body synthesis for std/bytes.
--
-- Bounds checks, clamping, COW, and copy loops remain ordinary Core so later
-- ownership and optimization passes see the same semantics as the source API.
import:
	ir:
		CoreBinaryOp(AddOp, EqualOp, GreaterEqualOp, GreaterOp, LessEqualOp, LessOp, SubtractOp),
		CoreBoxKind(PrimBox),
		CoreCallKind(BuiltinCall, IntrinsicCall),
		CoreExpr(
			AssignExpr,
			BinaryExpr,
			BoxExpr,
			BreakExpr,
			CallExpr,
			ForRangeExpr,
			IfExpr,
			LetExpr,
			LiteralExpr,
			LogicalExpr,
			SeqExpr,
			VarExpr,
			VoidExpr,
		),
		CoreFunction,
		CoreLiteral(BoolLiteral, IntLiteral),
		CoreLogicalOp(OrOp),
		CoreLoopBinder,
		CoreLoopRangeDirection(RangeForwardOnly),
		CoreParam,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType, VoidType),
		CoreVar,
	synth_name: is_synthesis_candidate, synthesis_source_name


private BYTES_MODULE: String = "std/bytes"

private INT_TYPE: CoreType = NamedType("Int", [])

private BOOL_TYPE: CoreType = NamedType("Bool", [])

private BYTES_TYPE: CoreType = NamedType("Bytes", [])

private POINTER_TYPE: CoreType = NamedType("Ptr", [])


private pure func core_var(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


private pure func variable(name: String, typ: CoreType) -> CoreExpr:
	VarExpr(core_var(name), typ, SyntheticSourceLoc)


private pure func parameter_value(param: CoreParam) -> CoreExpr:
	VarExpr(param.name, param.typ, SyntheticSourceLoc)


private pure func int_literal(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), INT_TYPE, SyntheticSourceLoc)


private pure func intrinsic_call(
	name: String,
	args: List[CoreExpr],
	return_type: CoreType,
) -> CoreExpr:
	CallExpr(
		IntrinsicCall(name),
		VoidExpr(VoidType, SyntheticSourceLoc),
		args,
		return_type,
		SyntheticSourceLoc,
	)


private pure func builtin_call(
	name: String,
	args: List[CoreExpr],
	return_type: CoreType,
) -> CoreExpr:
	CallExpr(
		BuiltinCall(name),
		VoidExpr(VoidType, SyntheticSourceLoc),
		args,
		return_type,
		SyntheticSourceLoc,
	)


private pure func binary(
	op: CoreBinaryOp,
	left: CoreExpr,
	right: CoreExpr,
	return_type: CoreType,
) -> CoreExpr:
	BinaryExpr(op, left, right, return_type, SyntheticSourceLoc)


private pure func logical_or(left: CoreExpr, right: CoreExpr) -> CoreExpr:
	LogicalExpr(OrOp, left, right, BOOL_TYPE, SyntheticSourceLoc)


private pure func if_expr(
	condition: CoreExpr,
	then_expr: CoreExpr,
	else_expr: CoreExpr,
	return_type: CoreType,
) -> CoreExpr:
	IfExpr(condition, then_expr, else_expr, return_type, SyntheticSourceLoc)


private pure func let_expr(
	name: String,
	is_mutable: Bool,
	typ: CoreType,
	rhs: CoreExpr,
	body: CoreExpr,
) -> CoreExpr:
	LetExpr(core_var(name), is_mutable, typ, rhs, body)


private pure func assignment(name: String, value: CoreExpr) -> CoreExpr:
	AssignExpr(core_var(name), value, VoidType, SyntheticSourceLoc)


private pure func loop_binder(name: String) -> CoreLoopBinder:
	{
		variable = core_var(name),
		typ = INT_TYPE,
		range_direction = RangeForwardOnly
	}


private pure func for_range(
	name: String,
	start: CoreExpr,
	end_value: CoreExpr,
	body: CoreExpr,
) -> CoreExpr:
	ForRangeExpr(loop_binder(name), start, end_value, body, VoidType, SyntheticSourceLoc)


private pure func type_is_named(typ: CoreType, expected: String) -> Bool:
	match typ:
		NamedType(name, args):
			name == expected and args.is_empty()
		_:
			False


private pure func type_is_option_int(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			match args:
				[inner]:
					name == "Option" and type_is_named(inner, "Int")
				_:
					False
		_:
			False


private pure func param_is_named(params: List[CoreParam], index: Int, expected: String) -> Bool:
	match params.get(index):
		Some(param):
			type_is_named(param.typ, expected)
		None:
			False


private pure func clamp_lower_zero(value: CoreExpr) -> CoreExpr:
	if_expr(
		binary(LessOp, value, int_literal(0), BOOL_TYPE),
		int_literal(0),
		value,
		INT_TYPE,
	)


private pure func clamp_to_length(value: CoreExpr, length: CoreExpr) -> CoreExpr:
	if_expr(
		binary(LessOp, value, int_literal(0), BOOL_TYPE),
		int_literal(0),
		if_expr(
			binary(GreaterOp, value, length, BOOL_TYPE),
			length,
			value,
			INT_TYPE,
		),
		INT_TYPE,
	)


private pure func min_int(left: CoreExpr, right: CoreExpr) -> CoreExpr:
	if_expr(
		binary(LessOp, left, right, BOOL_TYPE),
		left,
		right,
		INT_TYPE,
	)


private pure func index_out_of_bounds(bytes: CoreExpr, index: CoreExpr) -> CoreExpr:
	logical_or(
		binary(LessOp, index, int_literal(0), BOOL_TYPE),
		binary(
			GreaterEqualOp,
			index,
			intrinsic_call("bytes_len", [bytes], INT_TYPE),
			BOOL_TYPE,
		),
	)


private pure func option_none(return_type: CoreType) -> CoreExpr:
	builtin_call("blorp_option_none", [], return_type)


private pure func option_some_int(value: CoreExpr, return_type: CoreType) -> CoreExpr:
	boxed: CoreExpr = BoxExpr(
		{
			kind = PrimBox,
			value = value,
			source_type = INT_TYPE
		},
		POINTER_TYPE,
		SyntheticSourceLoc,
	)
	builtin_call("blorp_option_some", [boxed], return_type)


private pure func synthesize_new(size: CoreExpr) -> CoreExpr:
	let_expr(
		"__size",
		False,
		INT_TYPE,
		clamp_lower_zero(size),
		let_expr(
			"__r",
			False,
			BYTES_TYPE,
			intrinsic_call(
				"bytes_alloc",
				[variable("__size", INT_TYPE)],
				BYTES_TYPE,
			),
			SeqExpr(
				for_range(
					"__i",
					int_literal(0),
					variable(
						"__size",
						INT_TYPE,
					),
					intrinsic_call(
						"bytes_set",
						[variable("__r", BYTES_TYPE), variable("__i", INT_TYPE), int_literal(0)],
						VoidType,
					),
				),
				SeqExpr(
					intrinsic_call(
						"bytes_set_len",
						[variable("__r", BYTES_TYPE), variable("__size", INT_TYPE)],
						VoidType,
					),
					variable(
						"__r",
						BYTES_TYPE,
					),
				),
			),
		),
	)


private pure func synthesize_get(
	bytes: CoreExpr,
	index: CoreExpr,
	return_type: CoreType,
) -> CoreExpr:
	if_expr(
		index_out_of_bounds(
			bytes,
			index,
		),
		option_none(return_type),
		option_some_int(
			intrinsic_call(
				"bytes_get",
				[bytes, index],
				INT_TYPE,
			),
			return_type,
		),
		return_type,
	)


private pure func clamp_byte(value: CoreExpr) -> CoreExpr:
	if_expr(
		binary(LessOp, value, int_literal(0), BOOL_TYPE),
		int_literal(0),
		if_expr(
			binary(GreaterOp, value, int_literal(255), BOOL_TYPE),
			int_literal(255),
			value,
			INT_TYPE,
		),
		INT_TYPE,
	)


private pure func synthesize_set_index(
	bytes: CoreExpr,
	index: CoreExpr,
	value: CoreExpr,
) -> CoreExpr:
	if_expr(
		index_out_of_bounds(
			bytes,
			index,
		),
		bytes,
		let_expr(
			"__cval",
			False,
			INT_TYPE,
			clamp_byte(value),
			let_expr(
				"__r",
				False,
				BYTES_TYPE,
				intrinsic_call(
					"bytes_cow",
					[bytes],
					BYTES_TYPE,
				),
				SeqExpr(
					intrinsic_call(
						"bytes_set",
						[variable("__r", BYTES_TYPE), index, variable("__cval", INT_TYPE)],
						VoidType,
					),
					variable(
						"__r",
						BYTES_TYPE,
					),
				),
			),
		),
		BYTES_TYPE,
	)


private pure func synthesize_slice(
	bytes: CoreExpr,
	start: CoreExpr,
	requested_length: CoreExpr,
) -> CoreExpr:
	let_expr(
		"__blen",
		False,
		INT_TYPE,
		intrinsic_call(
			"bytes_len",
			[bytes],
			INT_TYPE,
		),
		let_expr(
			"__start",
			False,
			INT_TYPE,
			clamp_to_length(
				start,
				variable("__blen", INT_TYPE),
			),
			let_expr(
				"__len",
				False,
				INT_TYPE,
				if_expr(
					binary(LessEqualOp, requested_length, int_literal(0), BOOL_TYPE),
					int_literal(0),
					if_expr(
						binary(
							GreaterOp,
							binary(
								AddOp,
								variable("__start", INT_TYPE),
								requested_length,
								INT_TYPE,
							),
							variable("__blen", INT_TYPE),
							BOOL_TYPE,
						),
						binary(
							SubtractOp,
							variable("__blen", INT_TYPE),
							variable("__start", INT_TYPE),
							INT_TYPE,
						),
						requested_length,
						INT_TYPE,
					),
					INT_TYPE,
				),
				let_expr(
					"__r",
					False,
					BYTES_TYPE,
					intrinsic_call(
						"bytes_alloc",
						[variable("__len", INT_TYPE)],
						BYTES_TYPE,
					),
					SeqExpr(
						for_range(
							"__i",
							int_literal(0),
							variable(
								"__len",
								INT_TYPE,
							),
							intrinsic_call(
								"bytes_set",
								[
									variable("__r", BYTES_TYPE),
									variable("__i", INT_TYPE),
									intrinsic_call(
										"bytes_get",
										[bytes, binary(
												AddOp,
												variable("__start", INT_TYPE),
												variable("__i", INT_TYPE),
												INT_TYPE,
											)],
										INT_TYPE,
									),
								],
								VoidType,
							),
						),
						SeqExpr(
							intrinsic_call(
								"bytes_set_len",
								[variable("__r", BYTES_TYPE), variable("__len", INT_TYPE)],
								VoidType,
							),
							variable(
								"__r",
								BYTES_TYPE,
							),
						),
					),
				),
			),
		),
	)


private pure func copy_bytes_loop(
	source: CoreExpr,
	result_offset: CoreExpr,
	length: CoreExpr,
) -> CoreExpr:
	for_range(
		"__i",
		int_literal(0),
		length,
		intrinsic_call(
			"bytes_set",
			[
				variable("__r", BYTES_TYPE),
				binary(
					AddOp,
					result_offset,
					variable("__i", INT_TYPE),
					INT_TYPE,
				),
				intrinsic_call(
					"bytes_get",
					[source, variable("__i", INT_TYPE)],
					INT_TYPE,
				),
			],
			VoidType,
		),
	)


private pure func synthesize_append(left: CoreExpr, right: CoreExpr) -> CoreExpr:
	let_expr(
		"__alen",
		False,
		INT_TYPE,
		intrinsic_call(
			"bytes_len",
			[left],
			INT_TYPE,
		),
		let_expr(
			"__blen",
			False,
			INT_TYPE,
			intrinsic_call(
				"bytes_len",
				[right],
				INT_TYPE,
			),
			let_expr(
				"__total",
				False,
				INT_TYPE,
				binary(
					AddOp,
					variable("__alen", INT_TYPE),
					variable("__blen", INT_TYPE),
					INT_TYPE,
				),
				let_expr(
					"__r",
					False,
					BYTES_TYPE,
					intrinsic_call(
						"bytes_alloc",
						[variable("__total", INT_TYPE)],
						BYTES_TYPE,
					),
					SeqExpr(
						copy_bytes_loop(
							left,
							int_literal(0),
							variable("__alen", INT_TYPE),
						),
						SeqExpr(
							copy_bytes_loop(
								right,
								variable("__alen", INT_TYPE),
								variable("__blen", INT_TYPE),
							),
							SeqExpr(
								intrinsic_call(
									"bytes_set_len",
									[variable("__r", BYTES_TYPE), variable("__total", INT_TYPE)],
									VoidType,
								),
								variable(
									"__r",
									BYTES_TYPE,
								),
							),
						),
					),
				),
			),
		),
	)


private pure func synthesize_fill(bytes: CoreExpr, value: CoreExpr) -> CoreExpr:
	let_expr(
		"__r",
		False,
		BYTES_TYPE,
		intrinsic_call(
			"bytes_cow",
			[bytes],
			BYTES_TYPE,
		),
		let_expr(
			"__len",
			False,
			INT_TYPE,
			intrinsic_call(
				"bytes_len",
				[variable("__r", BYTES_TYPE)],
				INT_TYPE,
			),
			SeqExpr(
				for_range(
					"__i",
					int_literal(0),
					variable(
						"__len",
						INT_TYPE,
					),
					intrinsic_call(
						"bytes_set",
						[variable("__r", BYTES_TYPE), variable("__i", INT_TYPE), value],
						VoidType,
					),
				),
				variable(
					"__r",
					BYTES_TYPE,
				),
			),
		),
	)


private pure func synthesize_index_of(
	bytes: CoreExpr,
	value: CoreExpr,
	start: CoreExpr,
	return_type: CoreType,
) -> CoreExpr:
	let_expr(
		"__blen",
		False,
		INT_TYPE,
		intrinsic_call(
			"bytes_len",
			[bytes],
			INT_TYPE,
		),
		let_expr(
			"__start",
			False,
			INT_TYPE,
			clamp_to_length(
				start,
				variable("__blen", INT_TYPE),
			),
			let_expr(
				"__pos",
				True,
				INT_TYPE,
				int_literal(-1),
				SeqExpr(
					for_range(
						"__i",
						variable(
							"__start",
							INT_TYPE,
						),
						variable(
							"__blen",
							INT_TYPE,
						),
						if_expr(
							binary(
								EqualOp,
								intrinsic_call(
									"bytes_get",
									[bytes, variable("__i", INT_TYPE)],
									INT_TYPE,
								),
								value,
								BOOL_TYPE,
							),
							SeqExpr(
								assignment(
									"__pos",
									variable("__i", INT_TYPE),
								),
								BreakExpr(VoidType, SyntheticSourceLoc),
							),
							VoidExpr(
								VoidType,
								SyntheticSourceLoc,
							),
							VoidType,
						),
					),
					if_expr(
						binary(
							GreaterEqualOp,
							variable("__pos", INT_TYPE),
							int_literal(0),
							BOOL_TYPE,
						),
						option_some_int(
							variable("__pos", INT_TYPE),
							return_type,
						),
						option_none(return_type),
						return_type,
					),
				),
			),
		),
	)


private pure func synthesize_blit(
	destination: CoreExpr,
	destination_offset: CoreExpr,
	source: CoreExpr,
	source_offset: CoreExpr,
	length: CoreExpr,
) -> CoreExpr:
	let_expr(
		"__r",
		False,
		BYTES_TYPE,
		intrinsic_call(
			"bytes_cow",
			[destination],
			BYTES_TYPE,
		),
		let_expr(
			"__src_len",
			False,
			INT_TYPE,
			intrinsic_call(
				"bytes_len",
				[source],
				INT_TYPE,
			),
			let_expr(
				"__dst_len",
				False,
				INT_TYPE,
				intrinsic_call(
					"bytes_len",
					[variable("__r", BYTES_TYPE)],
					INT_TYPE,
				),
				let_expr(
					"__do",
					False,
					INT_TYPE,
					clamp_to_length(
						destination_offset,
						variable("__dst_len", INT_TYPE),
					),
					let_expr(
						"__so",
						False,
						INT_TYPE,
						clamp_to_length(
							source_offset,
							variable("__src_len", INT_TYPE),
						),
						let_expr(
							"__src_avail",
							False,
							INT_TYPE,
							binary(
								SubtractOp,
								variable("__src_len", INT_TYPE),
								variable("__so", INT_TYPE),
								INT_TYPE,
							),
							let_expr(
								"__dst_avail",
								False,
								INT_TYPE,
								binary(
									SubtractOp,
									variable("__dst_len", INT_TYPE),
									variable("__do", INT_TYPE),
									INT_TYPE,
								),
								let_expr(
									"__requested",
									False,
									INT_TYPE,
									if_expr(
										binary(LessEqualOp, length, int_literal(0), BOOL_TYPE),
										int_literal(0),
										length,
										INT_TYPE,
									),
									let_expr(
										"__clen",
										False,
										INT_TYPE,
										min_int(
											variable("__requested", INT_TYPE),
											min_int(
												variable("__src_avail", INT_TYPE),
												variable("__dst_avail", INT_TYPE),
											),
										),
										SeqExpr(
											for_range(
												"__i",
												int_literal(0),
												variable(
													"__clen",
													INT_TYPE,
												),
												intrinsic_call(
													"bytes_set",
													[
														variable("__r", BYTES_TYPE),
														binary(
															AddOp,
															variable("__do", INT_TYPE),
															variable("__i", INT_TYPE),
															INT_TYPE,
														),
														intrinsic_call(
															"bytes_get",
															[source, binary(
																	AddOp,
																	variable("__so", INT_TYPE),
																	variable("__i", INT_TYPE),
																	INT_TYPE,
																)],
															INT_TYPE,
														),
													],
													VoidType,
												),
											),
											variable(
												"__r",
												BYTES_TYPE,
											),
										),
									),
								),
							),
						),
					),
				),
			),
		),
	)


private pure func synthesize_named_body(
	name: String,
	params: List[CoreParam],
	return_type: CoreType,
) -> Option[CoreExpr]:
	if (
		name == "bytes"
		and params.length() == 1
		and param_is_named(params, 0, "Int")
		and type_is_named(return_type, "Bytes")
	):
		size ?= params.get(0)
		Some(synthesize_new(parameter_value(size)))
	else if (
		name == "length"
		and params.length() == 1
		and param_is_named(params, 0, "Bytes")
		and type_is_named(return_type, "Int")
	):
		bytes ?= params.get(0)
		Some(intrinsic_call("bytes_len", [parameter_value(bytes)], INT_TYPE))
	else if (
		name == "get"
		and params.length() == 2
		and param_is_named(params, 0, "Bytes")
		and param_is_named(params, 1, "Int")
		and type_is_option_int(return_type)
	):
		bytes ?= params.get(0)
		index ?= params.get(1)
		Some(synthesize_get(parameter_value(bytes), parameter_value(index), return_type))
	else if (
		name == "set_index"
		and params.length() == 3
		and param_is_named(params, 0, "Bytes")
		and param_is_named(params, 1, "Int")
		and param_is_named(params, 2, "Int")
		and type_is_named(return_type, "Bytes")
	):
		bytes ?= params.get(0)
		index ?= params.get(1)
		value ?= params.get(2)
		Some(
			synthesize_set_index(
				parameter_value(bytes),
				parameter_value(index),
				parameter_value(value),
			),
		)
	else if (
		name == "slice"
		and params.length() == 3
		and param_is_named(params, 0, "Bytes")
		and param_is_named(params, 1, "Int")
		and param_is_named(params, 2, "Int")
		and type_is_named(return_type, "Bytes")
	):
		bytes ?= params.get(0)
		start ?= params.get(1)
		length ?= params.get(2)
		Some(
			synthesize_slice(
				parameter_value(bytes),
				parameter_value(start),
				parameter_value(length),
			),
		)
	else if (
		name == "append"
		and params.length() == 2
		and param_is_named(params, 0, "Bytes")
		and param_is_named(params, 1, "Bytes")
		and type_is_named(return_type, "Bytes")
	):
		left ?= params.get(0)
		right ?= params.get(1)
		Some(synthesize_append(parameter_value(left), parameter_value(right)))
	else if (
		name == "fill"
		and params.length() == 2
		and param_is_named(params, 0, "Bytes")
		and param_is_named(params, 1, "Int")
		and type_is_named(return_type, "Bytes")
	):
		bytes ?= params.get(0)
		value ?= params.get(1)
		Some(synthesize_fill(parameter_value(bytes), parameter_value(value)))
	else if (
		name == "index_of"
		and params.length() == 3
		and param_is_named(params, 0, "Bytes")
		and param_is_named(params, 1, "Int")
		and param_is_named(params, 2, "Int")
		and type_is_option_int(return_type)
	):
		bytes ?= params.get(0)
		value ?= params.get(1)
		start ?= params.get(2)
		Some(
			synthesize_index_of(
				parameter_value(bytes),
				parameter_value(value),
				parameter_value(start),
				return_type,
			),
		)
	else if (
		name == "blit"
		and params.length() == 5
		and param_is_named(params, 0, "Bytes")
		and param_is_named(params, 1, "Int")
		and param_is_named(params, 2, "Bytes")
		and param_is_named(params, 3, "Int")
		and param_is_named(params, 4, "Int")
		and type_is_named(return_type, "Bytes")
	):
		destination ?= params.get(0)
		destination_offset ?= params.get(1)
		source ?= params.get(2)
		source_offset ?= params.get(3)
		length ?= params.get(4)
		Some(
			synthesize_blit(
				parameter_value(destination),
				parameter_value(destination_offset),
				parameter_value(source),
				parameter_value(source_offset),
				parameter_value(length),
			),
		)
	else:
		None


pure func synthesize_bytes_body(function_info: CoreFunction) -> Option[CoreExpr]:
	if (
		not is_synthesis_candidate(function_info)
		or function_info.source_module != Some(BYTES_MODULE)
	):
		None
	else:
		name ?= synthesis_source_name(function_info)
		synthesize_named_body(name, function_info.params, function_info.return_type)
