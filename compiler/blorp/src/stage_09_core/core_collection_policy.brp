-- Typed ownership and storage policy for collection pipeline lowering.
--
-- This is a structural port of Core_collection_producer. Decisions are based
-- on declaration-derived Core layout facts and fail closed when a named type
-- cannot be classified.
import:
	../stage_08_core_lower/core_list_layout:
		CoreLayoutTypeIndex,
		build_layout_type_index,
		resolve_layout_type_with_index,
	core_collection_plan: collection_list_element_type
	core_json:
		CoreProgram,
		CoreType(
			BoxedResultType,
			EnumType,
			FunctionType,
			HeapRecordType,
			NamedType,
			RangeType,
			StackResultType,
			TensorType,
			TupleType,
			UnionType,
			ValueRecordType,
			VoidType,
		),
	core_mono: core_mono_type_equal
	core_type_policy: is_managed_type, managed_type_names


union CoreCollectionSourceAccess:
	CollectionBindUnboxedValue
	CollectionBorrowManagedAlias


enum CoreCollectionFilterMapPayloadPolicy:
	CollectionNoFilterMapPayload
	CollectionBorrowedPayloadAliasFromOwnedOption


record CoreCollectionCollectPolicy {
	source_access: CoreCollectionSourceAccess,
	result_element_type: CoreType,
	filter_map_payload_policy: CoreCollectionFilterMapPayloadPolicy
}


record CoreCollectionSourceAccessPolicy {
	source_access: CoreCollectionSourceAccess,
	element_type: CoreType
}


record CoreCollectionPipelineModel {
	layout_types: CoreLayoutTypeIndex,
	managed_names: List[String]
}


union CoreCollectionIneligibleReason:
	CollectionTypesDiffer
	CollectionArcBoxedScalarStorage
	CollectionUnknownLayout(String)
	CollectionInvalidValueType(String)


union CoreCollectionEligibility[T]:
	CollectionEligible(T)
	CollectionIneligible(CoreCollectionIneligibleReason)


pure func collection_pipeline_model(program: CoreProgram) -> CoreCollectionPipelineModel:
	{
		layout_types = build_layout_type_index(program),
		managed_names = managed_type_names(program)
	}


pure func collection_canonical_type(model: CoreCollectionPipelineModel, typ: CoreType) -> CoreType:
	resolve_layout_type_with_index(model.layout_types, typ)


private pure func scalar_name_is_collection_eligible(name: String) -> Bool:
	match name:
		"Int" | "Int8" | "Int16" | "Int32" | "Int64" | "UInt8" | "UInt16" | "UInt32" | "UInt64" | "Bool" | "Char" | "Float" | "Float32" | "Float16":
			True
		_:
			False


pure func collection_type_is_unboxed_scalar(
	model: CoreCollectionPipelineModel,
	typ: CoreType,
) -> Bool:
	match collection_canonical_type(model, typ):
		NamedType(name, args):
			args.is_empty() and scalar_name_is_collection_eligible(name)
		RangeType:
			True
		_:
			False


private pure func collection_types_equal(
	model: CoreCollectionPipelineModel,
	left: CoreType,
	right: CoreType,
) -> Bool:
	core_mono_type_equal(
		collection_canonical_type(model, left),
		collection_canonical_type(model, right),
	)


private pure func collection_type_is_arc_boxed_scalar(
	model: CoreCollectionPipelineModel,
	typ: CoreType,
) -> Bool:
	match collection_canonical_type(model, typ):
		NamedType(name, args):
			args.is_empty() and (name == "Int128" or name == "UInt128")
		_:
			False


private pure func known_unmanaged_named_type(name: String, args: List[CoreType]) -> Bool:
	if args.is_empty():
		match name:
			"Int" | "Int8" | "Int16" | "Int32" | "Int64" | "Int128" | "UInt8" | "UInt16" | "UInt32" | "UInt64" | "UInt128" | "Bool" | "Char" | "Float" | "Float32" | "Float16" | "Ptr":
				True
			_:
				False
	else:
		name == "Option" or name == "Result"


private pure func classify_collection_source_access(
	model: CoreCollectionPipelineModel,
	typ: CoreType,
) -> CoreCollectionEligibility[CoreCollectionSourceAccess]:
	canonical: CoreType = collection_canonical_type(model, typ)

	if is_managed_type(model.managed_names, canonical):
		CollectionEligible(CollectionBorrowManagedAlias)
	else:
		match canonical:
			NamedType(name, args):
				if known_unmanaged_named_type(name, args):
					CollectionEligible(CollectionBindUnboxedValue)
				else:
					CollectionIneligible(CollectionUnknownLayout(name))
			RangeType | EnumType(_) | ValueRecordType(_) | VoidType:
				CollectionEligible(CollectionBindUnboxedValue)
			HeapRecordType(_) | UnionType(_) | BoxedResultType(_, _) | FunctionType(_, _, _) | TensorType(_) | TupleType(_):
				CollectionEligible(CollectionBorrowManagedAlias)
			StackResultType(_, _):
				CollectionEligible(CollectionBindUnboxedValue)
			_:
				CollectionIneligible(
					CollectionInvalidValueType("unresolved collection element type"),
				)


private pure func collection_stage_types_match_source(
	model: CoreCollectionPipelineModel,
	source_element_type: CoreType,
	stage_value_types: List[CoreType],
) -> Bool:
	stage_value_types.all(func(stage_type):
		collection_types_equal(model, source_element_type, stage_type)
	)


pure func collection_same_type_source_access_policy(
	model: CoreCollectionPipelineModel,
	source_element_type: CoreType,
	stage_value_types: List[CoreType],
) -> CoreCollectionEligibility[CoreCollectionSourceAccessPolicy]:
	if not collection_stage_types_match_source(model, source_element_type, stage_value_types):
		CollectionIneligible(CollectionTypesDiffer)
	else if collection_type_is_arc_boxed_scalar(model, source_element_type):
		CollectionIneligible(CollectionArcBoxedScalarStorage)
	else:
		match classify_collection_source_access(model, source_element_type):
			CollectionEligible(source_access):
				CollectionEligible({
					source_access = source_access,
					element_type = source_element_type,
				})
			CollectionIneligible(reason):
				CollectionIneligible(reason)


pure func collection_same_type_collect_policy_for_stages(
	model: CoreCollectionPipelineModel,
	filter_map_payload_policy: CoreCollectionFilterMapPayloadPolicy,
	source_element_type: CoreType,
	stage_value_types: List[CoreType],
	result_type: CoreType,
) -> CoreCollectionEligibility[CoreCollectionCollectPolicy]:
	match collection_same_type_source_access_policy(model, source_element_type, stage_value_types):
		CollectionIneligible(reason):
			CollectionIneligible(reason)
		CollectionEligible(source_policy):
			match collection_list_element_type(result_type):
				Some(result_element_type):
					if collection_types_equal(model, source_element_type, result_element_type):
						CollectionEligible({
							source_access = source_policy.source_access,
							result_element_type = result_element_type,
							filter_map_payload_policy = filter_map_payload_policy,
						})
					else:
						CollectionIneligible(CollectionTypesDiffer)
				None:
					CollectionIneligible(CollectionTypesDiffer)
