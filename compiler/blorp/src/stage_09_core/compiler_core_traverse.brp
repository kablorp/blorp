-- Shared shallow traversal helpers for Core expression containers.
--
-- Passes still own their phase-specific traversal rules. These helpers keep
-- the complete shallow child mapping and recurring container mapping in one
-- place. Context-aware variants pass managed state as ordinary arguments;
-- non-context mappers adapt to the same canonical implementations.
import:
	compiler_core_json:
		CoreBoxedStorageValue,
		CoreConcurrentBinding,
		CoreConstructorLengthMatch,
		CoreConstructorLengthMatchBranch,
		CoreConstructorLengthMatchCase,
		CoreConstructorLengthMatchGeq,
		CoreConstructorLiteralMatch,
		CoreConstructorMatchBody(
			ConstructorMatchBodyExpr,
			ConstructorMatchBodyLength,
			ConstructorMatchBodyLiteral,
		),
		CoreConstructorMatchCase,
		CoreConstructorMatchFallback(
			ConstructorMatchFallbackBindings,
			ConstructorMatchFallbackBody,
			ConstructorMatchFallbackFail,
		),
		CoreDictEntry,
		CoreDictLiteralEntry,
		CoreExpr(
			AccessorLiteralMatchExpr,
			AssignExpr,
			BinaryExpr,
			BorrowLetExpr,
			BoxExpr,
			BreakExpr,
			CallExpr,
			CastExpr,
			ClosureCreateExpr,
			ConcurrentExpr,
			ConcurrentlyLoopExpr,
			ConstructorMatchExpr,
			ContinueExpr,
			CooperativeCheckpointExpr,
			DebugBlockExpr,
			DetachExpr,
			DictConstructExpr,
			DictExpr,
			DropExpr,
			DupExpr,
			FieldExpr,
			ForChannelExpr,
			ForDictExpr,
			ForListExpr,
			ForRangeExpr,
			ForResourceSourceExpr,
			ForSetExpr,
			ForStreamExpr,
			ForStringExpr,
			ForTensorExpr,
			IfExpr,
			LambdaExpr,
			LengthMatchExpr,
			LetExpr,
			ListAllocExpr,
			ListConstructExpr,
			ListGetExpr,
			ListHandoffExpr,
			ListHandoffSetOwnedExpr,
			ListHandoffSetSourceSlotExpr,
			ListRetainExpr,
			ListSetExpr,
			ListSwapExpr,
			LiteralExpr,
			LiteralMatchExpr,
			LogicalExpr,
			PreClosureConcurrentExpr,
			PreClosureConcurrentlyLoopExpr,
			PreClosureDetachExpr,
			RangeExpr,
			RawMatchExpr,
			RecordConstructExpr,
			RecordExpr,
			ResourceCleanupExitExpr,
			ResourceScopeExpr,
			SelectExpr,
			SeqExpr,
			SetAllocExpr,
			StringByteCopyExpr,
			StringByteReadExpr,
			StringByteWriteExpr,
			StringSetLenExpr,
			TailrecListSpreadLoopExpr,
			TailrecListSpreadRecurExpr,
			TailrecLoopExpr,
			TailrecRecurExpr,
			TensorBoxedLiteralExpr,
			TensorLiteralExpr,
			TensorPackedLiteralExpr,
			TensorRawFillExpr,
			TensorRawReadExpr,
			TensorRawViewLetExpr,
			TensorRawWriteExpr,
			TupleConstructExpr,
			TupleExpr,
			TupleFieldExpr,
			UnaryExpr,
			UnboxExpr,
			UnionConstructExpr,
			UnionReuseConstructExpr,
			VarExpr,
			VectorExpr,
			VoidExpr,
			WhileExpr,
		),
		CoreLiteralMatchCase,
		CoreLiteralMatchFallback(
			LiteralMatchFallbackBindings,
			LiteralMatchFallbackBody,
			LiteralMatchFallbackFail,
		),
		CoreMatchBinding,
		CorePattern(
			ConstructorPattern,
			ListPattern,
			LiteralPattern,
			NamePattern,
			OrPattern,
			QualifiedConstructorPattern,
			TuplePattern,
			WildcardPattern,
		),
		CorePreClosureConcurrentBinding,
		CoreRawMatchCase,
		CoreRecordFieldValue,
		CoreSelectArm,
		CoreSelectArmKind(SelectAfterArm, SelectRecvArm, SelectSealedArm),
		CoreTailrecListSpreadRebind,
		CoreTensorLiteralPayload(TensorInlineStructLiteralPayload, TensorRawLiteralPayload),
		CoreTupleElement(
			TupleFloat16Element,
			TupleFloat32Element,
			TupleFloatElement,
			TuplePointerElement,
			TuplePrimElement,
			TupleStructElement,
			TupleVoidElement,
		),


pure func core_pattern_bound_names(pattern: CorePattern) -> List[String]:
	match pattern:
		NamePattern(name):
			[name]
		ConstructorPattern(_, args) | QualifiedConstructorPattern(_, _, args):
			args.flat_map(core_pattern_bound_names)
		TuplePattern(items) | OrPattern(items):
			items.flat_map(core_pattern_bound_names)
		ListPattern(items, spread):
			spread_names: List[String] = match spread:
				Some(spread_pattern):
					core_pattern_bound_names(spread_pattern)
				None:
					[]

			items
				.flat_map(core_pattern_bound_names)
				.concat(spread_names)
		WildcardPattern | LiteralPattern(_):
			[]


private record CoreExprMapContext[C] {
	state: C,
	mapper: pure (C, CoreExpr) -> CoreExpr
}


private pure func map_context_expr[C](context: CoreExprMapContext[C], expr: CoreExpr) -> CoreExpr:
	context.mapper(context.state, expr)


private pure func map_context_exprs[C](
	items: List[CoreExpr],
	context: CoreExprMapContext[C],
) -> List[CoreExpr]:
	var mapped: List[CoreExpr] = []

	for item in items:
		mapped = mapped.append(map_context_expr(context, item))

	mapped


private pure func map_context_raw_match_cases[C](
	cases: List[CoreRawMatchCase],
	context: CoreExprMapContext[C],
) -> List[CoreRawMatchCase]:
	cases.map(func(match_case): {
			pattern = match_case.pattern,
			body = map_context_expr(context, match_case.body)
		})


private pure func map_context_optional_expr[C](
	value: Option[CoreExpr],
	context: CoreExprMapContext[C],
) -> Option[CoreExpr]:
	match value:
		Some(expr):
			Some(map_context_expr(context, expr))
		None:
			None


private pure func map_context_dict_literal_entry[C](
	context: CoreExprMapContext[C],
	entry: CoreDictLiteralEntry,
) -> CoreDictLiteralEntry:
	{
		key = map_context_expr(context, entry.key),
		value = map_context_expr(context, entry.value)
	}


private pure func map_context_boxed_storage_value[C](
	context: CoreExprMapContext[C],
	value: CoreBoxedStorageValue,
) -> CoreBoxedStorageValue:
	{ value | value = map_context_expr(context, value.value) }


private pure func map_context_dict_entry[C](
	context: CoreExprMapContext[C],
	entry: CoreDictEntry,
) -> CoreDictEntry:
	{ entry |
		key = map_context_boxed_storage_value(context, entry.key),
		value = map_context_boxed_storage_value(context, entry.value)
	}


private pure func map_context_tuple_element[C](
	context: CoreExprMapContext[C],
	element: CoreTupleElement,
) -> CoreTupleElement:
	match element:
		TuplePrimElement(value):
			TuplePrimElement(map_context_expr(context, value))
		TuplePointerElement(value):
			TuplePointerElement(map_context_expr(context, value))
		TupleStructElement(value, c_type):
			TupleStructElement(
				map_context_expr(context, value),
				c_type,
			)
		TupleVoidElement:
			TupleVoidElement
		TupleFloatElement(value):
			TupleFloatElement(map_context_expr(context, value))
		TupleFloat32Element(value):
			TupleFloat32Element(map_context_expr(context, value))
		TupleFloat16Element(value):
			TupleFloat16Element(map_context_expr(context, value))


private pure func map_context_literal_match_case[C](
	context: CoreExprMapContext[C],
	match_case: CoreLiteralMatchCase,
) -> CoreLiteralMatchCase:
	{ match_case | body = map_context_expr(context, match_case.body) }


private pure func map_context_literal_match_fallback[C](
	fallback: CoreLiteralMatchFallback,
	context: CoreExprMapContext[C],
) -> CoreLiteralMatchFallback:
	match fallback:
		LiteralMatchFallbackBody(body):
			LiteralMatchFallbackBody(map_context_expr(context, body))
		LiteralMatchFallbackBindings(bindings, body):
			LiteralMatchFallbackBindings(
				bindings,
				map_context_expr(context, body),
			)
		LiteralMatchFallbackFail:
			LiteralMatchFallbackFail


private pure func map_context_constructor_literal_match[C](
	match_expr: CoreConstructorLiteralMatch,
	context: CoreExprMapContext[C],
) -> CoreConstructorLiteralMatch:
	{ match_expr |
		cases = map_context_literal_match_cases(match_expr.cases, context),
		fallback = map_context_literal_match_fallback(match_expr.fallback, context)
	}


private pure func map_context_constructor_match_body[C](
	body: CoreConstructorMatchBody,
	context: CoreExprMapContext[C],
) -> CoreConstructorMatchBody:
	match body:
		ConstructorMatchBodyExpr(expr):
			ConstructorMatchBodyExpr(map_context_expr(context, expr))
		ConstructorMatchBodyLiteral(match_expr):
			ConstructorMatchBodyLiteral(map_context_constructor_literal_match(match_expr, context))
		ConstructorMatchBodyLength(match_expr):
			ConstructorMatchBodyLength(map_context_constructor_length_match(match_expr, context))


private pure func map_context_constructor_length_branch[C](
	context: CoreExprMapContext[C],
	branch: CoreConstructorLengthMatchBranch,
) -> CoreConstructorLengthMatchBranch:
	{ branch | body = map_context_constructor_match_body(branch.body, context) }


private pure func map_context_constructor_length_case[C](
	context: CoreExprMapContext[C],
	match_case: CoreConstructorLengthMatchCase,
) -> CoreConstructorLengthMatchCase:
	{ match_case | branch = map_context_constructor_length_branch(context, match_case.branch) }


private pure func map_context_constructor_length_match[C](
	match_expr: CoreConstructorLengthMatch,
	context: CoreExprMapContext[C],
) -> CoreConstructorLengthMatch:
	mapped_geq: Option[CoreConstructorLengthMatchGeq] = match match_expr.geq:
		Some(geq):
			Some({ geq | branch = map_context_constructor_length_branch(context, geq.branch) })
		None:
			None

	mapped_fallback: Option[CoreConstructorLengthMatchBranch] = match match_expr.fallback:
		Some(branch):
			Some(map_context_constructor_length_branch(context, branch))
		None:
			None

	{ match_expr |
		cases = map_context_constructor_length_cases(match_expr.cases, context),
		geq = mapped_geq,
		fallback = mapped_fallback
	}


private pure func map_context_constructor_match_case[C](
	context: CoreExprMapContext[C],
	match_case: CoreConstructorMatchCase,
) -> CoreConstructorMatchCase:
	{ match_case | body = map_context_constructor_match_body(match_case.body, context) }


private pure func map_context_constructor_match_fallback[C](
	fallback: CoreConstructorMatchFallback,
	context: CoreExprMapContext[C],
) -> CoreConstructorMatchFallback:
	match fallback:
		ConstructorMatchFallbackBody(body):
			ConstructorMatchFallbackBody(map_context_expr(context, body))
		ConstructorMatchFallbackBindings(bindings, body):
			ConstructorMatchFallbackBindings(
				bindings,
				map_context_expr(context, body),
			)
		ConstructorMatchFallbackFail:
			ConstructorMatchFallbackFail


private pure func map_context_record_field[C](
	context: CoreExprMapContext[C],
	field: CoreRecordFieldValue,
) -> CoreRecordFieldValue:
	{ field | value = map_context_expr(context, field.value) }


private pure func map_context_tailrec_rebind[C](
	context: CoreExprMapContext[C],
	rebind: CoreTailrecListSpreadRebind,
) -> CoreTailrecListSpreadRebind:
	{ rebind | value = map_context_expr(context, rebind.value) }


private pure func map_context_concurrent_binding[C](
	context: CoreExprMapContext[C],
	binding: CoreConcurrentBinding,
) -> CoreConcurrentBinding:
	{ binding | rhs = map_context_expr(context, binding.rhs) }


private pure func map_context_pre_closure_concurrent_binding[C](
	context: CoreExprMapContext[C],
	binding: CorePreClosureConcurrentBinding,
) -> CorePreClosureConcurrentBinding:
	{ binding | rhs = map_context_expr(context, binding.rhs) }


private pure func map_context_select_arm_kind[C](
	kind: CoreSelectArmKind,
	context: CoreExprMapContext[C],
) -> CoreSelectArmKind:
	match kind:
		SelectRecvArm(recv):
			SelectRecvArm({ recv | channel = map_context_expr(context, recv.channel) })
		SelectSealedArm(channel):
			SelectSealedArm(map_context_expr(context, channel))
		SelectAfterArm(timeout):
			SelectAfterArm(map_context_expr(context, timeout))


private pure func map_context_select_arm[C](
	context: CoreExprMapContext[C],
	arm: CoreSelectArm,
) -> CoreSelectArm:
	{ arm |
		kind = map_context_select_arm_kind(arm.kind, context),
		body = map_context_expr(context, arm.body)
	}


private pure func map_context_dict_literal_entries[C](
	entries: List[CoreDictLiteralEntry],
	context: CoreExprMapContext[C],
) -> List[CoreDictLiteralEntry]:
	var mapped: List[CoreDictLiteralEntry] = []

	for entry in entries:
		mapped = mapped.append(map_context_dict_literal_entry(context, entry))

	mapped


private pure func map_context_boxed_storage_values[C](
	values: List[CoreBoxedStorageValue],
	context: CoreExprMapContext[C],
) -> List[CoreBoxedStorageValue]:
	var mapped: List[CoreBoxedStorageValue] = []

	for value in values:
		mapped = mapped.append(map_context_boxed_storage_value(context, value))

	mapped


private pure func map_context_dict_entries[C](
	entries: List[CoreDictEntry],
	context: CoreExprMapContext[C],
) -> List[CoreDictEntry]:
	var mapped: List[CoreDictEntry] = []

	for entry in entries:
		mapped = mapped.append(map_context_dict_entry(context, entry))

	mapped


private pure func map_context_tuple_elements[C](
	elements: List[CoreTupleElement],
	context: CoreExprMapContext[C],
) -> List[CoreTupleElement]:
	var mapped: List[CoreTupleElement] = []

	for element in elements:
		mapped = mapped.append(map_context_tuple_element(context, element))

	mapped


private pure func map_context_literal_match_cases[C](
	cases: List[CoreLiteralMatchCase],
	context: CoreExprMapContext[C],
) -> List[CoreLiteralMatchCase]:
	var mapped: List[CoreLiteralMatchCase] = []

	for match_case in cases:
		mapped = mapped.append(map_context_literal_match_case(context, match_case))

	mapped


private pure func map_context_constructor_length_cases[C](
	cases: List[CoreConstructorLengthMatchCase],
	context: CoreExprMapContext[C],
) -> List[CoreConstructorLengthMatchCase]:
	var mapped: List[CoreConstructorLengthMatchCase] = []

	for match_case in cases:
		mapped = mapped.append(map_context_constructor_length_case(context, match_case))

	mapped


private pure func map_context_constructor_match_cases[C](
	cases: List[CoreConstructorMatchCase],
	context: CoreExprMapContext[C],
) -> List[CoreConstructorMatchCase]:
	var mapped: List[CoreConstructorMatchCase] = []

	for match_case in cases:
		mapped = mapped.append(map_context_constructor_match_case(context, match_case))

	mapped


private pure func map_context_record_fields[C](
	fields: List[CoreRecordFieldValue],
	context: CoreExprMapContext[C],
) -> List[CoreRecordFieldValue]:
	var mapped: List[CoreRecordFieldValue] = []

	for field in fields:
		mapped = mapped.append(map_context_record_field(context, field))

	mapped


private pure func map_context_tailrec_rebinds[C](
	rebinds: List[CoreTailrecListSpreadRebind],
	context: CoreExprMapContext[C],
) -> List[CoreTailrecListSpreadRebind]:
	var mapped: List[CoreTailrecListSpreadRebind] = []

	for rebind in rebinds:
		mapped = mapped.append(map_context_tailrec_rebind(context, rebind))

	mapped


private pure func map_context_concurrent_bindings[C](
	bindings: List[CoreConcurrentBinding],
	context: CoreExprMapContext[C],
) -> List[CoreConcurrentBinding]:
	var mapped: List[CoreConcurrentBinding] = []

	for binding in bindings:
		mapped = mapped.append(map_context_concurrent_binding(context, binding))

	mapped


private pure func map_context_pre_closure_concurrent_bindings[C](
	bindings: List[CorePreClosureConcurrentBinding],
	context: CoreExprMapContext[C],
) -> List[CorePreClosureConcurrentBinding]:
	var mapped: List[CorePreClosureConcurrentBinding] = []

	for binding in bindings:
		mapped = mapped.append(map_context_pre_closure_concurrent_binding(context, binding))

	mapped


private pure func map_context_select_arms[C](
	arms: List[CoreSelectArm],
	context: CoreExprMapContext[C],
) -> List[CoreSelectArm]:
	var mapped: List[CoreSelectArm] = []

	for arm in arms:
		mapped = mapped.append(map_context_select_arm(context, arm))

	mapped


pure func map_core_exprs(
	items: List[CoreExpr],
	mapper: pure (CoreExpr) -> CoreExpr,
) -> List[CoreExpr]:
	items.map(mapper)


pure func map_core_exprs_with_context[C](
	items: List[CoreExpr],
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
) -> List[CoreExpr]:
	map_context: CoreExprMapContext[C] = {
		state = context,
		mapper = mapper
	}
	map_context_exprs(items, map_context)


pure func map_core_optional_expr(
	value: Option[CoreExpr],
	mapper: pure (CoreExpr) -> CoreExpr,
) -> Option[CoreExpr]:
	match value:
		Some(expr):
			Some(mapper(expr))
		None:
			None


pure func map_core_dict_literal_entry(
	entry: CoreDictLiteralEntry,
	mapper: pure (CoreExpr) -> CoreExpr,
) -> CoreDictLiteralEntry:
	{
		key = mapper(entry.key),
		value = mapper(entry.value)
	}


pure func map_core_dict_literal_entries(
	entries: List[CoreDictLiteralEntry],
	mapper: pure (CoreExpr) -> CoreExpr,
) -> List[CoreDictLiteralEntry]:
	entries.map(func(entry): map_core_dict_literal_entry(entry, mapper))


private pure func map_boxed_storage_value(
	value: CoreBoxedStorageValue,
	mapper: pure (CoreExpr) -> CoreExpr,
) -> CoreBoxedStorageValue:
	{ value | value = mapper(value.value) }


private pure func map_boxed_storage_values(
	values: List[CoreBoxedStorageValue],
	mapper: pure (CoreExpr) -> CoreExpr,
) -> List[CoreBoxedStorageValue]:
	values.map(func(value): map_boxed_storage_value(value, mapper))


private pure func map_dict_entry(
	entry: CoreDictEntry,
	mapper: pure (CoreExpr) -> CoreExpr,
) -> CoreDictEntry:
	{ entry |
		key = map_boxed_storage_value(entry.key, mapper),
		value = map_boxed_storage_value(entry.value, mapper)
	}


private pure func map_tuple_element(
	element: CoreTupleElement,
	mapper: pure (CoreExpr) -> CoreExpr,
) -> CoreTupleElement:
	match element:
		TuplePrimElement(value):
			TuplePrimElement(mapper(value))
		TuplePointerElement(value):
			TuplePointerElement(mapper(value))
		TupleStructElement(value, c_type):
			TupleStructElement(mapper(value), c_type)
		TupleVoidElement:
			TupleVoidElement
		TupleFloatElement(value):
			TupleFloatElement(mapper(value))
		TupleFloat32Element(value):
			TupleFloat32Element(mapper(value))
		TupleFloat16Element(value):
			TupleFloat16Element(mapper(value))


private pure func map_literal_match_case(
	match_case: CoreLiteralMatchCase,
	mapper: pure (CoreExpr) -> CoreExpr,
) -> CoreLiteralMatchCase:
	{ match_case | body = mapper(match_case.body) }


private pure func map_literal_match_cases(
	cases: List[CoreLiteralMatchCase],
	mapper: pure (CoreExpr) -> CoreExpr,
) -> List[CoreLiteralMatchCase]:
	var mapped: List[CoreLiteralMatchCase] = []

	for match_case in cases:
		mapped = mapped.append(map_literal_match_case(match_case, mapper))

	mapped


private pure func map_literal_match_fallback(
	fallback: CoreLiteralMatchFallback,
	mapper: pure (CoreExpr) -> CoreExpr,
) -> CoreLiteralMatchFallback:
	match fallback:
		LiteralMatchFallbackBody(body):
			LiteralMatchFallbackBody(mapper(body))
		LiteralMatchFallbackBindings(bindings, body):
			LiteralMatchFallbackBindings(bindings, mapper(body))
		LiteralMatchFallbackFail:
			LiteralMatchFallbackFail


private pure func map_constructor_literal_match(
	match_expr: CoreConstructorLiteralMatch,
	mapper: pure (CoreExpr) -> CoreExpr,
) -> CoreConstructorLiteralMatch:
	{ match_expr |
		cases = map_literal_match_cases(match_expr.cases, mapper),
		fallback = map_literal_match_fallback(match_expr.fallback, mapper)
	}


private pure func map_constructor_match_body(
	body: CoreConstructorMatchBody,
	mapper: pure (CoreExpr) -> CoreExpr,
) -> CoreConstructorMatchBody:
	match body:
		ConstructorMatchBodyExpr(expr):
			ConstructorMatchBodyExpr(mapper(expr))
		ConstructorMatchBodyLiteral(match_expr):
			ConstructorMatchBodyLiteral(map_constructor_literal_match(match_expr, mapper))
		ConstructorMatchBodyLength(match_expr):
			ConstructorMatchBodyLength(map_constructor_length_match(match_expr, mapper))


private pure func map_constructor_length_branch(
	branch: CoreConstructorLengthMatchBranch,
	mapper: pure (CoreExpr) -> CoreExpr,
) -> CoreConstructorLengthMatchBranch:
	{ branch | body = map_constructor_match_body(branch.body, mapper) }


private pure func map_constructor_length_cases(
	cases: List[CoreConstructorLengthMatchCase],
	mapper: pure (CoreExpr) -> CoreExpr,
) -> List[CoreConstructorLengthMatchCase]:
	var mapped: List[CoreConstructorLengthMatchCase] = []

	for match_case in cases:
		mapped = mapped.append(
			{ match_case | branch = map_constructor_length_branch(match_case.branch, mapper) },
		)

	mapped


private pure func map_constructor_length_match(
	match_expr: CoreConstructorLengthMatch,
	mapper: pure (CoreExpr) -> CoreExpr,
) -> CoreConstructorLengthMatch:
	rewritten_geq: Option[CoreConstructorLengthMatchGeq] = match match_expr.geq:
		Some(geq):
			Some({ geq | branch = map_constructor_length_branch(geq.branch, mapper) })
		None:
			None

	rewritten_fallback: Option[CoreConstructorLengthMatchBranch] = match match_expr.fallback:
		Some(branch):
			Some(map_constructor_length_branch(branch, mapper))
		None:
			None

	{ match_expr |
		cases = map_constructor_length_cases(match_expr.cases, mapper),
		geq = rewritten_geq,
		fallback = rewritten_fallback
	}


private pure func map_constructor_match_case(
	match_case: CoreConstructorMatchCase,
	mapper: pure (CoreExpr) -> CoreExpr,
) -> CoreConstructorMatchCase:
	{ match_case | body = map_constructor_match_body(match_case.body, mapper) }


pure func map_core_constructor_match_cases(
	cases: List[CoreConstructorMatchCase],
	mapper: pure (CoreExpr) -> CoreExpr,
) -> List[CoreConstructorMatchCase]:
	var mapped: List[CoreConstructorMatchCase] = []

	for match_case in cases:
		mapped = mapped.append(map_constructor_match_case(match_case, mapper))

	mapped


pure func map_core_constructor_match_fallback(
	fallback: CoreConstructorMatchFallback,
	mapper: pure (CoreExpr) -> CoreExpr,
) -> CoreConstructorMatchFallback:
	match fallback:
		ConstructorMatchFallbackBody(body):
			ConstructorMatchFallbackBody(mapper(body))
		ConstructorMatchFallbackBindings(bindings, body):
			ConstructorMatchFallbackBindings(bindings, mapper(body))
		ConstructorMatchFallbackFail:
			ConstructorMatchFallbackFail


private record CoreMatchResultMapContext[C] {
	state: C,
	mapper: pure (C, List[CoreMatchBinding], CoreExpr) -> CoreExpr
}


private record ScopedCoreMatchResultMapContext[C] {
	result_context: CoreMatchResultMapContext[C],
	bindings: List[CoreMatchBinding]
}


private pure func map_context_match_result[C](
	context: CoreMatchResultMapContext[C],
	bindings: List[CoreMatchBinding],
	expr: CoreExpr,
) -> CoreExpr:
	context.mapper(context.state, bindings, expr)


private pure func map_context_scoped_literal_match_case[C](
	context: ScopedCoreMatchResultMapContext[C],
	match_case: CoreLiteralMatchCase,
) -> CoreLiteralMatchCase:
	scoped_bindings: List[CoreMatchBinding] = context.bindings + match_case.bindings
	{ match_case |
		body = map_context_match_result(context.result_context, scoped_bindings, match_case.body)
	}


private pure func map_context_scoped_literal_match_cases[C](
	cases: List[CoreLiteralMatchCase],
	context: ScopedCoreMatchResultMapContext[C],
) -> List[CoreLiteralMatchCase]:
	var mapped: List[CoreLiteralMatchCase] = []

	for match_case in cases:
		mapped = mapped.append(map_context_scoped_literal_match_case(context, match_case))

	mapped


private pure func map_context_scoped_literal_match_fallback[C](
	fallback: CoreLiteralMatchFallback,
	context: ScopedCoreMatchResultMapContext[C],
) -> CoreLiteralMatchFallback:
	match fallback:
		LiteralMatchFallbackBody(body):
			LiteralMatchFallbackBody(
				map_context_match_result(
					context.result_context,
					context.bindings,
					body,
				),
			)
		LiteralMatchFallbackBindings(fallback_bindings, body):
			LiteralMatchFallbackBindings(
				fallback_bindings,
				map_context_match_result(
					context.result_context,
					context.bindings + fallback_bindings,
					body,
				),
			)
		LiteralMatchFallbackFail:
			LiteralMatchFallbackFail


private pure func map_context_scoped_constructor_literal_match[C](
	match_expr: CoreConstructorLiteralMatch,
	context: ScopedCoreMatchResultMapContext[C],
) -> CoreConstructorLiteralMatch:
	{ match_expr |
		cases = map_context_scoped_literal_match_cases(match_expr.cases, context),
		fallback = map_context_scoped_literal_match_fallback(match_expr.fallback, context)
	}


private pure func map_context_scoped_constructor_match_body[C](
	body: CoreConstructorMatchBody,
	context: ScopedCoreMatchResultMapContext[C],
) -> CoreConstructorMatchBody:
	match body:
		ConstructorMatchBodyExpr(expr):
			ConstructorMatchBodyExpr(
				map_context_match_result(
					context.result_context,
					context.bindings,
					expr,
				),
			)
		ConstructorMatchBodyLiteral(match_expr):
			ConstructorMatchBodyLiteral(
				map_context_scoped_constructor_literal_match(
					match_expr,
					context,
				),
			)
		ConstructorMatchBodyLength(match_expr):
			ConstructorMatchBodyLength(
				map_context_scoped_constructor_length_match(
					match_expr,
					context,
				),
			)


private pure func map_context_scoped_constructor_length_branch[C](
	context: ScopedCoreMatchResultMapContext[C],
	branch: CoreConstructorLengthMatchBranch,
) -> CoreConstructorLengthMatchBranch:
	scoped_context: ScopedCoreMatchResultMapContext[C] = {
		result_context = context.result_context,
		bindings = context.bindings + branch.bindings
	}
	{ branch | body = map_context_scoped_constructor_match_body(branch.body, scoped_context) }


private pure func map_context_scoped_constructor_length_case[C](
	context: ScopedCoreMatchResultMapContext[C],
	match_case: CoreConstructorLengthMatchCase,
) -> CoreConstructorLengthMatchCase:
	{ match_case |
		branch = map_context_scoped_constructor_length_branch(context, match_case.branch)
	}


private pure func map_context_scoped_constructor_length_cases[C](
	cases: List[CoreConstructorLengthMatchCase],
	context: ScopedCoreMatchResultMapContext[C],
) -> List[CoreConstructorLengthMatchCase]:
	var mapped: List[CoreConstructorLengthMatchCase] = []

	for match_case in cases:
		mapped = mapped.append(map_context_scoped_constructor_length_case(context, match_case))

	mapped


private pure func map_context_scoped_constructor_length_match[C](
	match_expr: CoreConstructorLengthMatch,
	context: ScopedCoreMatchResultMapContext[C],
) -> CoreConstructorLengthMatch:
	mapped_geq: Option[CoreConstructorLengthMatchGeq] = match match_expr.geq:
		Some(geq):
			Some(
				{ geq |
					branch = map_context_scoped_constructor_length_branch(context, geq.branch)
				},
			)
		None:
			None

	mapped_fallback: Option[CoreConstructorLengthMatchBranch] = match match_expr.fallback:
		Some(branch):
			Some(map_context_scoped_constructor_length_branch(context, branch))
		None:
			None

	{ match_expr |
		cases = map_context_scoped_constructor_length_cases(match_expr.cases, context),
		geq = mapped_geq,
		fallback = mapped_fallback
	}


private pure func map_context_scoped_constructor_match_case[C](
	context: ScopedCoreMatchResultMapContext[C],
	match_case: CoreConstructorMatchCase,
) -> CoreConstructorMatchCase:
	scoped_context: ScopedCoreMatchResultMapContext[C] = {
		result_context = context.result_context,
		bindings = context.bindings + match_case.bindings
	}
	{ match_case |
		body = map_context_scoped_constructor_match_body(match_case.body, scoped_context)
	}


private pure func map_context_scoped_constructor_match_cases[C](
	cases: List[CoreConstructorMatchCase],
	context: ScopedCoreMatchResultMapContext[C],
) -> List[CoreConstructorMatchCase]:
	var mapped: List[CoreConstructorMatchCase] = []

	for match_case in cases:
		mapped = mapped.append(map_context_scoped_constructor_match_case(context, match_case))

	mapped


private pure func map_context_scoped_constructor_match_fallback[C](
	fallback: CoreConstructorMatchFallback,
	context: ScopedCoreMatchResultMapContext[C],
) -> CoreConstructorMatchFallback:
	match fallback:
		ConstructorMatchFallbackBody(body):
			ConstructorMatchFallbackBody(
				map_context_match_result(
					context.result_context,
					context.bindings,
					body,
				),
			)
		ConstructorMatchFallbackBindings(fallback_bindings, body):
			ConstructorMatchFallbackBindings(
				fallback_bindings,
				map_context_match_result(
					context.result_context,
					context.bindings + fallback_bindings,
					body,
				),
			)
		ConstructorMatchFallbackFail:
			ConstructorMatchFallbackFail


pure func map_core_match_results_with_context[C](
	expr: CoreExpr,
	context: C,
	mapper: pure (C, List[CoreMatchBinding], CoreExpr) -> CoreExpr,
) -> CoreExpr:
	result_context: CoreMatchResultMapContext[C] = {
		state = context,
		mapper = mapper
	}
	scoped_context: ScopedCoreMatchResultMapContext[C] = {
		result_context = result_context,
		bindings = []
	}

	match expr:
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			LiteralMatchExpr(
				scrutinee,
				map_context_scoped_literal_match_cases(cases, scoped_context),
				map_context_scoped_literal_match_fallback(fallback, scoped_context),
				typ,
				loc,
			)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			AccessorLiteralMatchExpr(
				scrutinee,
				release_policy,
				map_context_scoped_constructor_literal_match(match_expr, scoped_context),
				typ,
				loc,
			)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			LengthMatchExpr(
				scrutinee,
				release_policy,
				map_context_scoped_constructor_length_match(match_expr, scoped_context),
				typ,
				loc,
			)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			ConstructorMatchExpr(
				scrutinee,
				release_policy,
				map_context_scoped_constructor_match_cases(cases, scoped_context),
				map_context_scoped_constructor_match_fallback(fallback, scoped_context),
				typ,
				loc,
			)
		_:
			expr


private pure func apply_core_match_result_mapper(
	mapper: pure (List[CoreMatchBinding], CoreExpr) -> CoreExpr,
	bindings: List[CoreMatchBinding],
	expr: CoreExpr,
) -> CoreExpr:
	mapper(bindings, expr)


pure func map_core_match_results(
	expr: CoreExpr,
	mapper: pure (List[CoreMatchBinding], CoreExpr) -> CoreExpr,
) -> CoreExpr:
	map_core_match_results_with_context(expr, mapper, apply_core_match_result_mapper)


private pure func map_core_expr_children_with_map_context[C](
	expr: CoreExpr,
	context: CoreExprMapContext[C],
) -> CoreExpr:
	match expr:
		LiteralExpr(literal, typ, loc):
			expr
		VarExpr(variable, typ, loc):
			expr
		VoidExpr(typ, loc):
			expr
		DebugBlockExpr(body, typ, loc):
			DebugBlockExpr(
				map_context_expr(context, body),
				typ,
				loc,
			)
		CooperativeCheckpointExpr(typ, loc):
			expr
		CallExpr(kind, callee, args, typ, loc):
			CallExpr(
				kind,
				map_context_expr(context, callee),
				map_context_exprs(args, context),
				typ,
				loc,
			)
		BinaryExpr(op, left, right, typ, loc):
			BinaryExpr(
				op,
				map_context_expr(context, left),
				map_context_expr(context, right),
				typ,
				loc,
			)
		UnaryExpr(op, value, typ, loc):
			UnaryExpr(
				op,
				map_context_expr(context, value),
				typ,
				loc,
			)
		LogicalExpr(op, left, right, typ, loc):
			LogicalExpr(
				op,
				map_context_expr(context, left),
				map_context_expr(context, right),
				typ,
				loc,
			)
		AssignExpr(variable, rhs, typ, loc):
			AssignExpr(
				variable,
				map_context_expr(context, rhs),
				typ,
				loc,
			)
		CastExpr(value, typ, loc):
			CastExpr(
				map_context_expr(context, value),
				typ,
				loc,
			)
		BoxExpr(box, typ, loc):
			BoxExpr({ box | value = map_context_expr(context, box.value) }, typ, loc)
		UnboxExpr(kind, value, typ, loc):
			UnboxExpr(
				kind,
				map_context_expr(context, value),
				typ,
				loc,
			)
		FieldExpr(value, field_name, typ, loc):
			FieldExpr(
				map_context_expr(context, value),
				field_name,
				typ,
				loc,
			)
		TupleFieldExpr(value, field_index, typ, loc):
			TupleFieldExpr(
				map_context_expr(context, value),
				field_index,
				typ,
				loc,
			)
		TupleExpr(items, typ, loc):
			TupleExpr(
				map_context_exprs(items, context),
				typ,
				loc,
			)
		TupleConstructExpr(construct, typ, loc):
			TupleConstructExpr(
				{ construct | elements = map_context_tuple_elements(construct.elements, context) },
				typ,
				loc,
			)
		VectorExpr(items, typ, loc):
			VectorExpr(
				map_context_exprs(items, context),
				typ,
				loc,
			)
		LambdaExpr(params, return_type, body, is_pure, typ, loc):
			LambdaExpr(
				params,
				return_type,
				map_context_expr(context, body),
				is_pure,
				typ,
				loc,
			)
		ClosureCreateExpr(closure, typ, loc):
			expr
		ListConstructExpr(construct, typ, loc):
			ListConstructExpr(
				{ construct |
					elements = map_context_boxed_storage_values(construct.elements, context)
				},
				typ,
				loc,
			)
		ListAllocExpr(alloc, typ, loc):
			ListAllocExpr(
				{ alloc | capacity = map_context_expr(context, alloc.capacity) },
				typ,
				loc,
			)
		ListGetExpr(get, typ, loc):
			ListGetExpr(
				{ get |
					list = map_context_expr(context, get.list),
					index = map_context_expr(context, get.index)
				},
				typ,
				loc,
			)
		ListHandoffExpr(handoff, typ, loc):
			ListHandoffExpr(
				{ handoff |
					source = map_context_expr(context, handoff.source),
					capacity = map_context_expr(context, handoff.capacity),
					body = map_context_expr(context, handoff.body)
				},
				typ,
				loc,
			)
		ListHandoffSetOwnedExpr(set, typ, loc):
			ListHandoffSetOwnedExpr(
				{ set |
					list = map_context_expr(context, set.list),
					index = map_context_expr(context, set.index),
					value = map_context_boxed_storage_value(context, set.value)
				},
				typ,
				loc,
			)
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			ListHandoffSetSourceSlotExpr(
				{ slot |
					result = map_context_expr(context, slot.result),
					out_index = map_context_expr(context, slot.out_index),
					source = map_context_expr(context, slot.source),
					source_index = map_context_expr(context, slot.source_index)
				},
				typ,
				loc,
			)
		StringByteReadExpr(read, typ, loc):
			StringByteReadExpr(
				{ read |
					source = map_context_expr(context, read.source),
					index = map_context_expr(context, read.index)
				},
				typ,
				loc,
			)
		StringByteWriteExpr(write, typ, loc):
			StringByteWriteExpr(
				{ write |
					target = map_context_expr(context, write.target),
					index = map_context_expr(context, write.index),
					byte = map_context_expr(context, write.byte)
				},
				typ,
				loc,
			)
		StringByteCopyExpr(copy, typ, loc):
			StringByteCopyExpr(
				{ copy |
					dst = map_context_expr(context, copy.dst),
					dst_pos = map_context_expr(context, copy.dst_pos),
					src = map_context_expr(context, copy.src),
					src_pos = map_context_expr(context, copy.src_pos),
					len = map_context_expr(context, copy.len)
				},
				typ,
				loc,
			)
		StringSetLenExpr(set_len, typ, loc):
			StringSetLenExpr(
				{ set_len |
					target = map_context_expr(context, set_len.target),
					len = map_context_expr(context, set_len.len)
				},
				typ,
				loc,
			)
		TensorLiteralExpr(literal, typ, loc):
			mapped_payload: CoreTensorLiteralPayload = match literal.payload:
				TensorRawLiteralPayload(raw):
					TensorRawLiteralPayload(
						{ raw | elements = map_context_exprs(raw.elements, context) },
					)
				TensorInlineStructLiteralPayload(inline_struct):
					TensorInlineStructLiteralPayload(
						{ inline_struct |
							elements = map_context_exprs(inline_struct.elements, context)
						},
					)

			TensorLiteralExpr({ literal | payload = mapped_payload }, typ, loc)
		TensorBoxedLiteralExpr(literal, typ, loc):
			TensorBoxedLiteralExpr(
				{ literal |
					elements = map_context_boxed_storage_values(literal.elements, context)
				},
				typ,
				loc,
			)
		TensorPackedLiteralExpr(literal, typ, loc):
			TensorPackedLiteralExpr(
				{ literal | elements = map_context_exprs(literal.elements, context) },
				typ,
				loc,
			)
		TensorRawFillExpr(fill, typ, loc):
			TensorRawFillExpr(
				{ fill |
					value = map_context_expr(context, fill.value),
					dims = map_context_exprs(fill.dims, context)
				},
				typ,
				loc,
			)
		TensorRawReadExpr(read, typ, loc):
			TensorRawReadExpr({ read | index = map_context_expr(context, read.index) }, typ, loc)
		TensorRawWriteExpr(write, typ, loc):
			TensorRawWriteExpr(
				{ write |
					index = map_context_expr(context, write.index),
					value = map_context_expr(context, write.value)
				},
				typ,
				loc,
			)
		TensorRawViewLetExpr(binding, body, typ, loc):
			TensorRawViewLetExpr(
				{ binding | source = map_context_expr(context, binding.source) },
				map_context_expr(context, body),
				typ,
				loc,
			)
		DictExpr(entries, typ, loc):
			DictExpr(
				map_context_dict_literal_entries(entries, context),
				typ,
				loc,
			)
		DictConstructExpr(construct, typ, loc):
			DictConstructExpr(
				{ construct | entries = map_context_dict_entries(construct.entries, context) },
				typ,
				loc,
			)
		SetAllocExpr(alloc, typ, loc):
			expr
		ListRetainExpr(retain, typ, loc):
			ListRetainExpr(
				{ retain |
					list = map_context_expr(context, retain.list),
					value = map_context_boxed_storage_value(context, retain.value)
				},
				typ,
				loc,
			)
		ListSetExpr(set, typ, loc):
			ListSetExpr(
				{ set |
					list = map_context_expr(context, set.list),
					index = map_context_expr(context, set.index),
					value = map_context_boxed_storage_value(context, set.value)
				},
				typ,
				loc,
			)
		ListSwapExpr(swap, typ, loc):
			ListSwapExpr(
				{ swap |
					list = map_context_expr(context, swap.list),
					left_index = map_context_expr(context, swap.left_index),
					right_index = map_context_expr(context, swap.right_index)
				},
				typ,
				loc,
			)
		RecordExpr(fields, typ, loc):
			RecordExpr(
				map_context_record_fields(fields, context),
				typ,
				loc,
			)
		RecordConstructExpr(type_name, fields, typ, loc):
			RecordConstructExpr(
				type_name,
				map_context_record_fields(fields, context),
				typ,
				loc,
			)
		UnionConstructExpr(construct, typ, loc):
			UnionConstructExpr(
				{ construct | args = map_context_boxed_storage_values(construct.args, context) },
				typ,
				loc,
			)
		UnionReuseConstructExpr(construct, typ, loc):
			UnionReuseConstructExpr(
				{ construct |
					source = map_context_expr(context, construct.source),
					args = map_context_boxed_storage_values(construct.args, context)
				},
				typ,
				loc,
			)
		PreClosureDetachExpr(detached, typ, loc):
			PreClosureDetachExpr(
				map_context_expr(context, detached),
				typ,
				loc,
			)
		DetachExpr(detached, typ, loc):
			expr
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			DupExpr(
				variable,
				value_type,
				retain_policy,
				map_context_expr(context, body),
				typ,
				loc,
			)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			DropExpr(
				variable,
				value_type,
				release_policy,
				map_context_expr(context, body),
				typ,
				loc,
			)
		LetExpr(variable, is_mutable, typ, rhs, body):
			LetExpr(
				variable,
				is_mutable,
				typ,
				map_context_expr(context, rhs),
				map_context_expr(context, body),
			)
		BorrowLetExpr(variable, typ, rhs, body):
			BorrowLetExpr(
				variable,
				typ,
				map_context_expr(context, rhs),
				map_context_expr(context, body),
			)
		SeqExpr(first, second):
			SeqExpr(
				map_context_expr(context, first),
				map_context_expr(context, second),
			)
		WhileExpr(cond, body, typ, loc):
			WhileExpr(
				map_context_expr(context, cond),
				map_context_expr(context, body),
				typ,
				loc,
			)
		BreakExpr(typ, loc):
			expr
		ContinueExpr(typ, loc):
			expr
		ResourceScopeExpr(scope, typ, loc):
			ResourceScopeExpr(
				{ scope |
					acquire = map_context_expr(context, scope.acquire),
					body = map_context_expr(context, scope.body),
					cleanup = map_context_expr(context, scope.cleanup)
				},
				typ,
				loc,
			)
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			ResourceCleanupExitExpr(
				{ cleanup_exit | cleanups = map_context_exprs(cleanup_exit.cleanups, context) },
				typ,
				loc,
			)
		TailrecLoopExpr(params, return_type, body, loc):
			TailrecLoopExpr(
				params,
				return_type,
				map_context_expr(context, body),
				loc,
			)
		TailrecRecurExpr(args, typ, loc):
			TailrecRecurExpr(
				map_context_exprs(args, context),
				typ,
				loc,
			)
		TailrecListSpreadLoopExpr(loop, loc):
			TailrecListSpreadLoopExpr({ loop | body = map_context_expr(context, loop.body) }, loc)
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			TailrecListSpreadRecurExpr(
				map_context_tailrec_rebinds(rebinds, context),
				cursor_advance,
				typ,
				loc,
			)
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			ForRangeExpr(
				binder,
				map_context_expr(context, start),
				map_context_expr(context, end_value),
				map_context_expr(context, body),
				typ,
				loc,
			)
		ForChannelExpr(loop, typ, loc):
			ForChannelExpr(
				{ loop |
					iterable = map_context_expr(context, loop.iterable),
					body = map_context_expr(context, loop.body)
				},
				typ,
				loc,
			)
		ForListExpr(loop, typ, loc):
			ForListExpr(
				{ loop |
					iterable = map_context_expr(context, loop.iterable),
					body = map_context_expr(context, loop.body)
				},
				typ,
				loc,
			)
		ForStringExpr(loop, typ, loc):
			ForStringExpr(
				{ loop |
					iterable = map_context_expr(context, loop.iterable),
					body = map_context_expr(context, loop.body)
				},
				typ,
				loc,
			)
		ForDictExpr(loop, typ, loc):
			ForDictExpr(
				{ loop |
					iterable = map_context_expr(context, loop.iterable),
					body = map_context_expr(context, loop.body)
				},
				typ,
				loc,
			)
		ForSetExpr(loop, typ, loc):
			ForSetExpr(
				{ loop |
					iterable = map_context_expr(context, loop.iterable),
					body = map_context_expr(context, loop.body)
				},
				typ,
				loc,
			)
		ForStreamExpr(loop, typ, loc):
			ForStreamExpr(
				{ loop |
					iterable = map_context_expr(context, loop.iterable),
					body = map_context_expr(context, loop.body)
				},
				typ,
				loc,
			)
		ForResourceSourceExpr(loop, typ, loc):
			ForResourceSourceExpr(
				{ loop |
					iterable = map_context_expr(context, loop.iterable),
					body = map_context_expr(context, loop.body)
				},
				typ,
				loc,
			)
		ForTensorExpr(loop, typ, loc):
			ForTensorExpr(
				{ loop |
					iterable = map_context_expr(context, loop.iterable),
					body = map_context_expr(context, loop.body)
				},
				typ,
				loc,
			)
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			PreClosureConcurrentlyLoopExpr(
				{ loop |
					iterable = map_context_expr(context, loop.iterable),
					body = map_context_expr(context, loop.body),
					timeout = map_context_optional_expr(loop.timeout, context),
					limit = map_context_expr(context, loop.limit)
				},
				typ,
				loc,
			)
		ConcurrentlyLoopExpr(loop, typ, loc):
			ConcurrentlyLoopExpr(
				{ loop |
					iterable = map_context_expr(context, loop.iterable),
					body = map_context_expr(context, loop.body),
					timeout = map_context_optional_expr(loop.timeout, context),
					limit = map_context_expr(context, loop.limit)
				},
				typ,
				loc,
			)
		PreClosureConcurrentExpr(block, typ, loc):
			PreClosureConcurrentExpr(
				{ block |
					bindings = map_context_pre_closure_concurrent_bindings(block.bindings, context),
					body = map_context_expr(context, block.body),
					timeout = map_context_optional_expr(block.timeout, context)
				},
				typ,
				loc,
			)
		ConcurrentExpr(block, typ, loc):
			ConcurrentExpr(
				{ block |
					bindings = map_context_concurrent_bindings(block.bindings, context),
					body = map_context_expr(context, block.body),
					timeout = map_context_optional_expr(block.timeout, context)
				},
				typ,
				loc,
			)
		SelectExpr(select_expr, typ, loc):
			SelectExpr(
				map_context_select_arms(select_expr, context),
				typ,
				loc,
			)
		RangeExpr(start, end_value, typ, loc):
			RangeExpr(
				map_context_expr(context, start),
				map_context_expr(context, end_value),
				typ,
				loc,
			)
		RawMatchExpr(scrutinee, cases, typ, loc):
			RawMatchExpr(
				map_context_expr(context, scrutinee),
				map_context_raw_match_cases(cases, context),
				typ,
				loc,
			)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			LiteralMatchExpr(
				map_context_expr(context, scrutinee),
				map_context_literal_match_cases(cases, context),
				map_context_literal_match_fallback(fallback, context),
				typ,
				loc,
			)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			AccessorLiteralMatchExpr(
				map_context_expr(context, scrutinee),
				release_policy,
				map_context_constructor_literal_match(match_expr, context),
				typ,
				loc,
			)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			LengthMatchExpr(
				map_context_expr(context, scrutinee),
				release_policy,
				map_context_constructor_length_match(match_expr, context),
				typ,
				loc,
			)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			ConstructorMatchExpr(
				map_context_expr(context, scrutinee),
				release_policy,
				map_context_constructor_match_cases(cases, context),
				map_context_constructor_match_fallback(fallback, context),
				typ,
				loc,
			)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			IfExpr(
				map_context_expr(context, cond),
				map_context_expr(context, then_expr),
				map_context_expr(context, else_expr),
				typ,
				loc,
			)


pure func map_core_expr_children_with_context[C](
	expr: CoreExpr,
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
) -> CoreExpr:
	map_context: CoreExprMapContext[C] = {
		state = context,
		mapper = mapper
	}
	map_core_expr_children_with_map_context(expr, map_context)


private pure func apply_core_expr_mapper(
	mapper: pure (CoreExpr) -> CoreExpr,
	expr: CoreExpr,
) -> CoreExpr:
	mapper(expr)


pure func map_core_expr_children(
	expr: CoreExpr,
	mapper: pure (CoreExpr) -> CoreExpr,
) -> CoreExpr:
	map_core_expr_children_with_context(expr, mapper, apply_core_expr_mapper)


-- Core statement blocks lower to right-associated SeqExpr chains. Mapping the
-- chain recursively can exhaust the compiler stack on large generated suites,
-- so preserve its exact shape while mapping each item iteratively.
pure func map_core_sequence_items_with_context[C](
	expr: CoreExpr,
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
) -> CoreExpr:
	var preceding_items: List[CoreExpr] = []
	var final_item: CoreExpr = expr

	while True:
		match final_item:
			SeqExpr(first, second):
				preceding_items = preceding_items.append(first)
				final_item = second
			_:
				break

	var mapped: CoreExpr = mapper(context, final_item)
	var index: Int = preceding_items.length() - 1

	while index >= 0:
		match preceding_items.get(index):
			Some(item):
				mapped = SeqExpr(
					mapper(context, item),
					mapped,
				)
			None:
				void

		index -= 1

	mapped


pure func map_core_sequence_items(
	expr: CoreExpr,
	mapper: pure (CoreExpr) -> CoreExpr,
) -> CoreExpr:
	map_core_sequence_items_with_context(expr, mapper, apply_core_expr_mapper)


pure func any_core_expr(
	items: List[CoreExpr],
	predicate: pure (CoreExpr) -> Bool,
) -> Bool:
	var found: Bool = False

	for item in items:
		if predicate(item):
			found = True
			break

	found


pure func any_core_optional_expr(
	value: Option[CoreExpr],
	predicate: pure (CoreExpr) -> Bool,
) -> Bool:
	match value:
		Some(expr):
			predicate(expr)
		None:
			False


private pure func optional_expr_items(value: Option[CoreExpr]) -> List[CoreExpr]:
	match value:
		Some(expr):
			[expr]
		None:
			[]


private pure func boxed_storage_value_items(value: CoreBoxedStorageValue) -> List[CoreExpr]:
	[value.value]


private pure func dict_entry_items(entry: CoreDictEntry) -> List[CoreExpr]:
	[entry.key.value, entry.value.value]


private pure func tuple_element_items(element: CoreTupleElement) -> List[CoreExpr]:
	match element:
		TuplePrimElement(value):
			[value]
		TuplePointerElement(value):
			[value]
		TupleStructElement(value, _):
			[value]
		TupleVoidElement:
			[]
		TupleFloatElement(value):
			[value]
		TupleFloat32Element(value):
			[value]
		TupleFloat16Element(value):
			[value]


private pure func literal_match_fallback_items(
	fallback: CoreLiteralMatchFallback,
) -> List[CoreExpr]:
	match fallback:
		LiteralMatchFallbackBody(body):
			[body]
		LiteralMatchFallbackBindings(_, body):
			[body]
		LiteralMatchFallbackFail:
			[]


private pure func constructor_match_body_items(body: CoreConstructorMatchBody) -> List[CoreExpr]:
	match body:
		ConstructorMatchBodyExpr(expr):
			[expr]
		ConstructorMatchBodyLiteral(match_expr):
			constructor_literal_match_items(match_expr)
		ConstructorMatchBodyLength(match_expr):
			constructor_length_match_items(match_expr)


private pure func constructor_literal_match_items(
	match_expr: CoreConstructorLiteralMatch,
) -> List[CoreExpr]:
	match_expr.cases.flat_map(
		func(match_case): [match_case.body],
	) + literal_match_fallback_items(match_expr.fallback)


private pure func constructor_length_branch_items(
	branch: CoreConstructorLengthMatchBranch,
) -> List[CoreExpr]:
	constructor_match_body_items(branch.body)


private pure func constructor_length_match_items(
	match_expr: CoreConstructorLengthMatch,
) -> List[CoreExpr]:
	case_items: List[CoreExpr] = match_expr.cases.flat_map(
		func(match_case): constructor_length_branch_items(match_case.branch),
	)

	geq_items: List[CoreExpr] = match match_expr.geq:
		Some(geq):
			constructor_length_branch_items(geq.branch)
		None:
			[]

	fallback_items: List[CoreExpr] = match match_expr.fallback:
		Some(branch):
			constructor_length_branch_items(branch)
		None:
			[]

	case_items + geq_items + fallback_items


private pure func constructor_match_fallback_items(
	fallback: CoreConstructorMatchFallback,
) -> List[CoreExpr]:
	match fallback:
		ConstructorMatchFallbackBody(body):
			[body]
		ConstructorMatchFallbackBindings(_, body):
			[body]
		ConstructorMatchFallbackFail:
			[]


private pure func select_arm_kind_items(kind: CoreSelectArmKind) -> List[CoreExpr]:
	match kind:
		SelectRecvArm(recv):
			[recv.channel]
		SelectSealedArm(channel):
			[channel]
		SelectAfterArm(timeout):
			[timeout]


-- Returns the direct expression children in source/evaluation order. Analyses
-- that need to aggregate facts should use this instead of reimplementing a
-- partial Core traversal beside the canonical child mapper above.
pure func immediate_core_expr_children(expr: CoreExpr) -> List[CoreExpr]:
	match expr:
		LiteralExpr(_, _, _):
			[]
		VarExpr(_, _, _):
			[]
		VoidExpr(_, _):
			[]
		DebugBlockExpr(body, _, _):
			[body]
		CooperativeCheckpointExpr(_, _):
			[]
		CallExpr(_, callee, args, _, _):
			[callee] + args
		BinaryExpr(_, left, right, _, _):
			[left, right]
		UnaryExpr(_, value, _, _):
			[value]
		LogicalExpr(_, left, right, _, _):
			[left, right]
		AssignExpr(_, rhs, _, _):
			[rhs]
		CastExpr(value, _, _):
			[value]
		BoxExpr(box, _, _):
			[box.value]
		UnboxExpr(_, value, _, _):
			[value]
		FieldExpr(value, _, _, _):
			[value]
		TupleFieldExpr(value, _, _, _):
			[value]
		TupleExpr(items, _, _):
			items
		TupleConstructExpr(construct, _, _):
			construct.elements.flat_map(tuple_element_items)
		VectorExpr(items, _, _):
			items
		LambdaExpr(_, _, body, _, _, _):
			[body]
		ClosureCreateExpr(_, _, _):
			[]
		ListConstructExpr(construct, _, _):
			construct.elements.flat_map(boxed_storage_value_items)
		ListAllocExpr(alloc, _, _):
			[alloc.capacity]
		ListGetExpr(get, _, _):
			[get.list, get.index]
		ListHandoffExpr(handoff, _, _):
			[handoff.source, handoff.capacity, handoff.body]
		ListHandoffSetOwnedExpr(set, _, _):
			[set.list, set.index, set.value.value]
		ListHandoffSetSourceSlotExpr(slot, _, _):
			[slot.result, slot.out_index, slot.source, slot.source_index]
		StringByteReadExpr(read, _, _):
			[read.source, read.index]
		StringByteWriteExpr(write, _, _):
			[write.target, write.index, write.byte]
		StringByteCopyExpr(copy, _, _):
			[copy.dst, copy.dst_pos, copy.src, copy.src_pos, copy.len]
		StringSetLenExpr(set_len, _, _):
			[set_len.target, set_len.len]
		TensorLiteralExpr(literal, _, _):
			match literal.payload:
				TensorRawLiteralPayload(raw):
					raw.elements
				TensorInlineStructLiteralPayload(inline_struct):
					inline_struct.elements
		TensorBoxedLiteralExpr(literal, _, _):
			literal.elements.flat_map(boxed_storage_value_items)
		TensorPackedLiteralExpr(literal, _, _):
			literal.elements
		TensorRawFillExpr(fill, _, _):
			[fill.value] + fill.dims
		TensorRawReadExpr(read, _, _):
			[read.index]
		TensorRawWriteExpr(write, _, _):
			[write.index, write.value]
		TensorRawViewLetExpr(binding, body, _, _):
			[binding.source, body]
		DictExpr(entries, _, _):
			entries.flat_map(func(entry): [entry.key, entry.value])
		DictConstructExpr(construct, _, _):
			construct.entries.flat_map(dict_entry_items)
		SetAllocExpr(_, _, _):
			[]
		ListRetainExpr(retain, _, _):
			[retain.list, retain.value.value]
		ListSetExpr(set, _, _):
			[set.list, set.index, set.value.value]
		ListSwapExpr(swap, _, _):
			[swap.list, swap.left_index, swap.right_index]
		RecordExpr(fields, _, _):
			fields.map(func(field): field.value)
		RecordConstructExpr(_, fields, _, _):
			fields.map(func(field): field.value)
		UnionConstructExpr(construct, _, _):
			construct.args.flat_map(boxed_storage_value_items)
		UnionReuseConstructExpr(construct, _, _):
			[construct.source] + construct.args.flat_map(boxed_storage_value_items)
		PreClosureDetachExpr(detached, _, _):
			[detached]
		DetachExpr(_, _, _):
			[]
		DupExpr(_, _, _, body, _, _):
			[body]
		DropExpr(_, _, _, body, _, _):
			[body]
		LetExpr(_, _, _, rhs, body):
			[rhs, body]
		BorrowLetExpr(_, _, rhs, body):
			[rhs, body]
		SeqExpr(first, second):
			[first, second]
		WhileExpr(cond, body, _, _):
			[cond, body]
		BreakExpr(_, _):
			[]
		ContinueExpr(_, _):
			[]
		ResourceScopeExpr(scope, _, _):
			[scope.acquire, scope.body, scope.cleanup]
		ResourceCleanupExitExpr(cleanup_exit, _, _):
			cleanup_exit.cleanups
		TailrecLoopExpr(_, _, body, _):
			[body]
		TailrecRecurExpr(args, _, _):
			args
		TailrecListSpreadLoopExpr(loop, _):
			[loop.body]
		TailrecListSpreadRecurExpr(rebinds, _, _, _):
			rebinds.map(func(rebind): rebind.value)
		ForRangeExpr(_, start, end_value, body, _, _):
			[start, end_value, body]
		ForChannelExpr(loop, _, _):
			[loop.iterable, loop.body]
		ForListExpr(loop, _, _):
			[loop.iterable, loop.body]
		ForStringExpr(loop, _, _):
			[loop.iterable, loop.body]
		ForDictExpr(loop, _, _):
			[loop.iterable, loop.body]
		ForSetExpr(loop, _, _):
			[loop.iterable, loop.body]
		ForStreamExpr(loop, _, _):
			[loop.iterable, loop.body]
		ForResourceSourceExpr(loop, _, _):
			[loop.iterable, loop.body]
		ForTensorExpr(loop, _, _):
			[loop.iterable, loop.body]
		PreClosureConcurrentlyLoopExpr(loop, _, _):
			[loop.iterable, loop.body] + optional_expr_items(loop.timeout) + [loop.limit]
		ConcurrentlyLoopExpr(loop, _, _):
			[loop.iterable, loop.body] + optional_expr_items(loop.timeout) + [loop.limit]
		PreClosureConcurrentExpr(block, _, _):
			block.bindings.map(
				func(binding): binding.rhs,
			) + [block.body] + optional_expr_items(block.timeout)
		ConcurrentExpr(block, _, _):
			block.bindings.map(
				func(binding): binding.rhs,
			) + [block.body] + optional_expr_items(block.timeout)
		SelectExpr(select_expr, _, _):
			select_expr.flat_map(func(arm): select_arm_kind_items(arm.kind) + [arm.body])
		RangeExpr(start, end_value, _, _):
			[start, end_value]
		RawMatchExpr(scrutinee, cases, _, _):
			[scrutinee] + cases.map(func(match_case): match_case.body)
		LiteralMatchExpr(scrutinee, cases, fallback, _, _):
			[
				scrutinee,
			] + cases.map(
				func(match_case): match_case.body,
			) + literal_match_fallback_items(fallback)
		AccessorLiteralMatchExpr(scrutinee, _, match_expr, _, _):
			[scrutinee] + constructor_literal_match_items(match_expr)
		LengthMatchExpr(scrutinee, _, match_expr, _, _):
			[scrutinee] + constructor_length_match_items(match_expr)
		ConstructorMatchExpr(scrutinee, _, cases, fallback, _, _):
			[
				scrutinee,
			] + cases.flat_map(
				func(
					match_case,
				): constructor_match_body_items(
					match_case.body,
				),
			) + constructor_match_fallback_items(fallback)
		IfExpr(cond, then_expr, else_expr, _, _):
			[cond, then_expr, else_expr]


pure func any_core_dict_literal_entry_expr(
	entry: CoreDictLiteralEntry,
	predicate: pure (CoreExpr) -> Bool,
) -> Bool:
	predicate(entry.key) or predicate(entry.value)


pure func any_core_dict_literal_entry_exprs(
	entries: List[CoreDictLiteralEntry],
	predicate: pure (CoreExpr) -> Bool,
) -> Bool:
	var found: Bool = False

	for entry in entries:
		if any_core_dict_literal_entry_expr(entry, predicate):
			found = True
			break

	found
