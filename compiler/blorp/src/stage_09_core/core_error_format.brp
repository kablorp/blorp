-- Blorp-owned formatting for Core_error display strings.
--
-- OCaml still owns the exception type and source location records. This module
-- owns the user-facing string form once those structured fields cross the
-- compiler bridge.
import:
	../stage_10_backend/codegen_template_registry: render_template_arity_error, render_unsupported_template_error


enum CoreErrorTemplate:
	FormatTemplate


record CoreErrorTemplateInfo {
	template: CoreErrorTemplate,
	name: String,
	arity: Int
}


union CoreErrorHint:
	NoHint
	HintText(String)


record CoreErrorFormatArgs {
	phase: String,
	message: String,
	line: Int,
	column: Int,
	hint: CoreErrorHint
}


union CoreErrorRenderError:
	WrongArity(CoreErrorTemplateInfo, Int)
	UnsupportedCoreErrorTemplate(String)
	InvalidHintKind(String)
	InvalidIntField(String, String)


private pure func templates_by_name(
	templates: List[CoreErrorTemplateInfo],
) -> Dict[String, CoreErrorTemplateInfo]:
	var dict: Dict[String, CoreErrorTemplateInfo] = {}

	for info in templates:
		dict = dict.set(info.name, info)

	dict


ALL_TEMPLATES: List[CoreErrorTemplateInfo] = [
	{
		template = FormatTemplate,
		name = "core_error_format",
		arity = 6
	},
]

private TEMPLATES_BY_NAME: Dict[String, CoreErrorTemplateInfo] = templates_by_name(ALL_TEMPLATES)


pure func core_error_template_name(info: CoreErrorTemplateInfo) -> String:
	info.name


pure func core_error_template_arity(info: CoreErrorTemplateInfo) -> Int:
	info.arity


pure func parse_core_error_template(name: String) -> Option[CoreErrorTemplateInfo]:
	TEMPLATES_BY_NAME.get(name)


private pure func wrong_arity_for_args(
	info: CoreErrorTemplateInfo,
	args: List[String],
) -> CoreErrorRenderError:
	WrongArity(info, args.length())


pure func render_error_to_string(error: CoreErrorRenderError) -> String:
	match error:
		WrongArity(info, actual):
			render_template_arity_error(
				"core error template",
				core_error_template_name(info),
				core_error_template_arity(info),
				actual,
			)
		UnsupportedCoreErrorTemplate(name):
			render_unsupported_template_error("core error template", name)
		InvalidHintKind(kind):
			"invalid core error hint kind: ${kind}"
		InvalidIntField(field_name, value):
			"invalid core error ${field_name}: ${value}"


private pure func parse_int_field(
	field_name: String,
	value: String,
) -> Result[Int, CoreErrorRenderError]:
	match value.parse_int():
		Some(parsed):
			Ok(parsed)
		None:
			Err(InvalidIntField(field_name, value))


private pure func parse_hint(
	kind: String,
	text: String,
) -> Result[CoreErrorHint, CoreErrorRenderError]:
	match kind:
		"none":
			Ok(NoHint)
		"some":
			Ok(HintText(text))
		other_kind:
			Err(InvalidHintKind(other_kind))


private pure func parse_core_error_format_args(
	info: CoreErrorTemplateInfo,
	args: List[String],
) -> Result[CoreErrorFormatArgs, CoreErrorRenderError]:
	match args:
		[phase, message, line_text, column_text, hint_kind, hint_text]:
			line ?= parse_int_field("line", line_text)
			column ?= parse_int_field("column", column_text)
			hint ?= parse_hint(hint_kind, hint_text)

			Ok({
				phase = phase,
				message = message,
				line = line,
				column = column,
				hint = hint,
			})
		other_args:
			Err(wrong_arity_for_args(info, other_args))


pure func build_core_error_format_args(
	info: CoreErrorTemplateInfo,
	args: List[String],
) -> Result[CoreErrorFormatArgs, CoreErrorRenderError]:
	match info.template:
		FormatTemplate:
			parse_core_error_format_args(info, args)


private pure func render_formatted_error(args: CoreErrorFormatArgs) -> String:
	base: String = "${args.phase}: ${args.message} at ${args.line}:${args.column}"

	match args.hint:
		NoHint:
			base
		HintText(hint):
			base + "\n  hint: " + hint


pure func render_core_error(
	name: String,
	args: List[String],
) -> Result[String, CoreErrorRenderError]:
	match parse_core_error_template(name):
		Some(info):
			match build_core_error_format_args(info, args):
				Ok(format_args):
					Ok(render_formatted_error(format_args))
				Err(error):
					Err(error)
		None:
			Err(UnsupportedCoreErrorTemplate(name))
