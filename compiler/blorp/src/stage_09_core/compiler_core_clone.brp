-- Explicit deep cloning for compiler-owned Core values.
--
-- The self-hosted compiler currently avoids sharing managed Core aggregates
-- between owning output positions. Keep that policy centralized here so pass
-- code states ownership intent and new Core variants produce exhaustive-match
-- failures instead of silently retaining an identity fallback.
import:
	compiler_core_json:
		CoreAccessor(
			BoxedResultErrPayloadAccessor,
			BoxedResultOkPayloadAccessor,
			BoxedStackResultErrPayloadAccessor,
			BoxedStackResultOkPayloadAccessor,
			ErasedVariantFieldAccessor,
			ListElementAccessor,
			ListSpreadAccessor,
			NullableOptionPayloadAccessor,
			RootAccessor,
			StackOptionPayloadAccessor,
			StackResultErrPayloadAccessor,
			StackResultOkPayloadAccessor,
			TupleFieldAccessor,
			VariantFieldAccessor,
		),
		CoreLiteral(
			BoolLiteral,
			CharLiteral,
			FloatInfinityLiteral,
			FloatLiteral,
			FloatNanLiteral,
			FloatNegInfinityLiteral,
			FloatTextLiteral,
			IntLiteral,
			StringLiteral,
			WideIntLiteral,
		),
		CoreSourceLoc(KnownSourceLoc, SyntheticSourceLoc),
		CoreTensorDim(TensorDimOperation, TensorRuntimeDim, TensorStaticDim, TensorVariadicDim),
		CoreType(
			BoxedResultType,
			EnumType,
			FunctionType,
			HeapRecordType,
			NamedType,
			RangeType,
			SelfType,
			StackResultType,
			TensorType,
			TupleType,
			TypeParameterType,
			UnionType,
			ValueRecordType,
			VoidType,
		),
		CoreVar,


private pure func clone_optional_int(value: Option[Int]) -> Option[Int]:
	match value:
		Some(item):
			Some(item)
		None:
			None


pure func clone_core_var(variable: CoreVar) -> CoreVar:
	{
		name = variable.name,
		uniq = variable.uniq,
		def_id = clone_optional_int(variable.def_id)
	}


pure func clone_core_source_loc(loc: CoreSourceLoc) -> CoreSourceLoc:
	match loc:
		KnownSourceLoc(span):
			KnownSourceLoc({
				file = span.file,
				line = span.line,
				column = span.column,
				end_line = span.end_line,
				end_column = span.end_column,
			})
		SyntheticSourceLoc:
			SyntheticSourceLoc


pure func clone_core_literal(literal: CoreLiteral) -> CoreLiteral:
	match literal:
		IntLiteral(value):
			IntLiteral(value)
		WideIntLiteral(value):
			WideIntLiteral(value)
		FloatLiteral(value):
			FloatLiteral(value)
		FloatTextLiteral(value):
			FloatTextLiteral(value)
		FloatInfinityLiteral:
			FloatInfinityLiteral
		FloatNegInfinityLiteral:
			FloatNegInfinityLiteral
		FloatNanLiteral:
			FloatNanLiteral
		BoolLiteral(value):
			BoolLiteral(value)
		CharLiteral(value):
			CharLiteral(value)
		StringLiteral(value):
			StringLiteral(value)


pure func clone_core_tensor_dim(dim: CoreTensorDim) -> CoreTensorDim:
	match dim:
		TensorStaticDim(value):
			TensorStaticDim(value)
		TensorRuntimeDim(name):
			TensorRuntimeDim(name)
		TensorVariadicDim(name):
			TensorVariadicDim(name)
		TensorDimOperation(op, left, right):
			TensorDimOperation(op, clone_core_tensor_dim(left), clone_core_tensor_dim(right))


pure func clone_core_accessor(accessor: CoreAccessor) -> CoreAccessor:
	match accessor:
		RootAccessor:
			RootAccessor
		VariantFieldAccessor(parent, union_c_type, constructor, field_index):
			VariantFieldAccessor(
				clone_core_accessor(parent),
				union_c_type,
				constructor,
				field_index,
			)
		ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index):
			ErasedVariantFieldAccessor(
				clone_core_accessor(parent),
				union_c_type,
				constructor,
				field_index,
			)
		NullableOptionPayloadAccessor(parent):
			NullableOptionPayloadAccessor(clone_core_accessor(parent))
		StackOptionPayloadAccessor(parent):
			StackOptionPayloadAccessor(clone_core_accessor(parent))
		StackResultOkPayloadAccessor(parent):
			StackResultOkPayloadAccessor(clone_core_accessor(parent))
		StackResultErrPayloadAccessor(parent):
			StackResultErrPayloadAccessor(clone_core_accessor(parent))
		BoxedStackResultOkPayloadAccessor(parent, c_type):
			BoxedStackResultOkPayloadAccessor(clone_core_accessor(parent), c_type)
		BoxedStackResultErrPayloadAccessor(parent, c_type):
			BoxedStackResultErrPayloadAccessor(clone_core_accessor(parent), c_type)
		BoxedResultOkPayloadAccessor(parent):
			BoxedResultOkPayloadAccessor(clone_core_accessor(parent))
		BoxedResultErrPayloadAccessor(parent):
			BoxedResultErrPayloadAccessor(clone_core_accessor(parent))
		TupleFieldAccessor(parent, index, typ):
			TupleFieldAccessor(clone_core_accessor(parent), index, clone_core_type(typ))
		ListElementAccessor(parent, index):
			ListElementAccessor(clone_core_accessor(parent), index)
		ListSpreadAccessor(parent, offset):
			ListSpreadAccessor(clone_core_accessor(parent), offset)


pure func clone_core_type(typ: CoreType) -> CoreType:
	match typ:
		VoidType:
			VoidType
		NamedType(name, args):
			NamedType(
				name,
				args.map(clone_core_type),
			)
		TypeParameterType(name):
			TypeParameterType(name)
		SelfType:
			SelfType
		StackResultType(ok_type, err_type):
			StackResultType(clone_core_type(ok_type), clone_core_type(err_type))
		BoxedResultType(ok_type, err_type):
			BoxedResultType(clone_core_type(ok_type), clone_core_type(err_type))
		FunctionType(is_pure, params, return_type):
			FunctionType(
				is_pure,
				params.map(clone_core_type),
				clone_core_type(return_type),
			)
		EnumType(name):
			EnumType(name)
		ValueRecordType(name):
			ValueRecordType(name)
		HeapRecordType(name):
			HeapRecordType(name)
		UnionType(name):
			UnionType(name)
		RangeType:
			RangeType
		TensorType(info):
			TensorType({
				element_type = clone_core_type(info.element_type),
				dims = info.dims.map(clone_core_tensor_dim),
			})
		TupleType(items):
			TupleType(items.map(clone_core_type))
