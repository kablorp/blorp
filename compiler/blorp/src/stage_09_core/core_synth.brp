-- Single post-monomorphization Core synthesis orchestrator.
--
-- Family modules only construct bodies. This module alone walks declarations
-- and assigns a successfully synthesized declaration its concrete callable
-- identity, keeping the stage transition explicit and testable.
import:
	../stage_08_core_lower/core_identity: core_module_member_name
	core_builtin_registry: core_builtin_name
	core_json:
		CoreDecl(FunctionDecl, ImplDecl),
		CoreExpr,
		CoreFunction,
		CoreFunctionKind(BuiltinFunction, UserFunction),
		CoreProgram,
	core_synth_bytes: synthesize_bytes_body
	core_synth_context: CoreSynthContext, core_synth_context
	core_synth_error: CoreSynthError
	core_synth_fixed: synthesize_fixed_body
	core_synth_float: synthesize_float_body
	core_synth_forward: synthesize_forward_body
	core_synth_hash_collections: synthesize_hash_collection_body
	core_synth_list: synthesize_list_body
	core_synth_name: synthesis_source_name
	core_synth_parallel_tensor: synthesize_parallel_tensor_body
	core_synth_slice: synthesize_slice_body
	core_synth_string: synthesize_string_body
	core_synth_tensor: synthesize_tensor_body


private pure func synthesize_infallible_body(function_info: CoreFunction) -> Option[CoreExpr]:
	var body: Option[CoreExpr] = synthesize_bytes_body(function_info)

	if body.is_none():
		body = synthesize_fixed_body(function_info)

	if body.is_none():
		body = synthesize_float_body(function_info)

	if body.is_none():
		body = synthesize_forward_body(function_info)

	if body.is_none():
		body = synthesize_slice_body(function_info)

	if body.is_none():
		body = synthesize_string_body(function_info)

	if body.is_none():
		body = synthesize_list_body(function_info)

	if body.is_none():
		body = synthesize_parallel_tensor_body(function_info)

	body


private pure func synthesized_function_kind(function_info: CoreFunction) -> CoreFunctionKind:
	match (function_info.source_module, synthesis_source_name(function_info)):
		(Some(module_name), Some(source_name)):
			match core_builtin_name(module_name, source_name):
				Some(runtime_name):
					BuiltinFunction(runtime_name)
				None:
					UserFunction
		_:
			UserFunction


private pure func synthesize_function(
	context: CoreSynthContext,
	function_info: CoreFunction,
) -> Result[CoreFunction, CoreSynthError]:
	hash_collection_body ?= synthesize_hash_collection_body(context, function_info)
	tensor_body ?= synthesize_tensor_body(function_info)
	var body: Option[CoreExpr] = hash_collection_body

	if body.is_none():
		body = tensor_body

	if body.is_none():
		body = synthesize_infallible_body(function_info)

	match body:
		Some(synthesized):
			Ok({ function_info |
					body = Some(synthesized),
					function_kind = synthesized_function_kind(function_info)
				})
		None:
			Ok(function_info)


private pure func qualify_impl_method_for_synthesis(function_info: CoreFunction) -> CoreFunction:
	match function_info.source_module:
		Some(module_name):
			prefix: String = core_module_member_name(module_name, "")

			if function_info.name.starts_with(prefix):
				function_info
			else:
				{ function_info | name = core_module_member_name(module_name, function_info.name) }
		None:
			function_info


private pure func synthesize_impl_method(
	context: CoreSynthContext,
	function_info: CoreFunction,
) -> Result[CoreFunction, CoreSynthError]:
	candidate: CoreFunction = qualify_impl_method_for_synthesis(function_info)
	synthesized ?= synthesize_function(context, candidate)
	Ok({ synthesized | name = function_info.name })


private pure func synthesize_impl_methods(
	context: CoreSynthContext,
	methods: List[CoreFunction],
) -> Result[List[CoreFunction], CoreSynthError]:
	var synthesized_methods: List[CoreFunction] = []
	var failure: Option[CoreSynthError] = None

	for method in methods:
		match synthesize_impl_method(context, method):
			Ok(synthesized):
				synthesized_methods = synthesized_methods.append(synthesized)
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(synthesized_methods)


private pure func synthesize_decl(
	context: CoreSynthContext,
	decl: CoreDecl,
) -> Result[CoreDecl, CoreSynthError]:
	match decl:
		FunctionDecl(function_info):
			synthesized ?= synthesize_function(context, function_info)
			Ok(FunctionDecl(synthesized))
		ImplDecl(impl_info):
			methods ?= synthesize_impl_methods(context, impl_info.methods)
			Ok(ImplDecl({ impl_info | methods = methods }))
		_:
			Ok(decl)


pure func synthesize_program(program: CoreProgram) -> Result[CoreProgram, CoreSynthError]:
	context: CoreSynthContext = core_synth_context(program)
	var decls: List[CoreDecl] = []
	var failure: Option[CoreSynthError] = None

	for decl in program.decls:
		match synthesize_decl(context, decl):
			Ok(synthesized):
				decls = decls.append(synthesized)
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({
				decls = decls,
				foreign_includes = program.foreign_includes,
			})
