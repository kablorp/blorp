private DEFAULT_MANAGED_TYPE_NAMES: List[String] = [
	"String",
	"Bytes",
	"List",
	"Dict",
	"Set",
	"Channel",
	"Fixed",
	"Tensor",
	"StringSlice",
	"MemoryStats",
	"SchedulerStats",
	"Closure",
	"Regex",
	"Deque",
	"Heap",
	"Stream",
	"FallibleStream",
	"ResourceSource",
]


record ConstructorCallContract {
	parent_type_name: String,
	name: String,
	def_id: Option[Int],
	contract: OwnershipCallContract
}


record PerceusGlobal {
	value: CoreParam,
	is_mutable: Bool
}


record PerceusEnv {
	managed_type_names: List[String],
	constructor_contracts_by_name: Dict[String, List[ConstructorCallContract]],
	constructor_contracts_by_def_id: Dict[Int, List[ConstructorCallContract]],
	constructor_contracts_by_parent_name: Dict[String, List[ConstructorCallContract]],
	global_values: List[PerceusGlobal],
	function_names: List[String],
	constructor_names: List[String],
	direct_user_call_contracts_by_name: Dict[String, List[Int]],
	user_call_contracts_by_name: Dict[String, List[Int]],
	user_call_contract_layers_by_name: List[Dict[String, List[Int]]],
	infer_unresolved_user_calls_as_borrow: Bool,
	balance_nested_matches: Bool,
	transferable_result_vars: List[CoreVar]
}


record InferredUserContract {
	consumed_args: List[Int],
	dependencies: List[String]
}


record InitialUserContractAnalysis {
	user_call_contracts_by_name: Dict[String, List[Int]],
	reverse_callers_by_name: Dict[String, List[String]],
	function_indices_by_name: Dict[String, Int],
	consuming_function_names: List[String]
}


record UserContractWave {
	env: PerceusEnv,
	changed_function_names: List[String]
}


private union TemporaryBindingContractPlan:
	BalancedTemporaryBindingContract(OwnershipCallContract)
	ExplicitDropTemporaryBindingContract(OwnershipCallContract)


pure func empty_env() -> PerceusEnv:
	{
		managed_type_names = DEFAULT_MANAGED_TYPE_NAMES,
		constructor_contracts_by_name = {},
		constructor_contracts_by_def_id = {},
		constructor_contracts_by_parent_name = {},
		global_values = [],
		function_names = [],
		constructor_names = [],
		direct_user_call_contracts_by_name = {},
		user_call_contracts_by_name = {},
		user_call_contract_layers_by_name = [],
		infer_unresolved_user_calls_as_borrow = False,
		balance_nested_matches = False,
		transferable_result_vars = []
	}


private pure func list_contains_string(items: List[String], value: String) -> Bool:
	var found: Bool = False

	for item in items:
		if item == value:
			found = True
			break
		else:
			void

	found


private pure func transfer_args(arity: Int) -> List[OwnershipArgMode]:
	var args: List[OwnershipArgMode] = []
	var index: Int = 0

	while index < arity:
		args = args.append(TransferArg)
		index += 1

	args


private pure func borrow_args(arity: Int) -> List[OwnershipArgMode]:
	var args: List[OwnershipArgMode] = []
	var index: Int = 0

	while index < arity:
		args = args.append(BorrowArg)
		index += 1

	args


private pure func consumed_user_call_contract(
	env: PerceusEnv,
	consumed_args: List[Int],
	arg_count: Int,
	return_type: CoreType,
) -> Option[OwnershipCallContract]:
	if consumed_args.length() == 0:
		None
	else:
		var args: List[OwnershipArgMode] = []
		var index: Int = 0

		while index < arg_count:
			if consumed_args.contains(index):
				args = args.append(TransferArg)
			else:
				args = args.append(BorrowArg)

			index += 1

		Some({
			args = args,
			result = result_mode_for_type(env, return_type),
		})


private pure func user_call_contract_from_consumed_args(
	env: PerceusEnv,
	consumed_args: List[Int],
	arg_count: Int,
	return_type: CoreType,
) -> OwnershipCallContract:
	var args: List[OwnershipArgMode] = []
	var index: Int = 0

	while index < arg_count:
		if consumed_args.contains(index):
			args = args.append(TransferArg)
		else:
			args = args.append(BorrowArg)

		index += 1

	{
		args = args,
		result = result_mode_for_type(env, return_type)
	}


private pure func args_forward_params_in_order(
	args: List[CoreExpr],
	params: List[CoreParam],
) -> Bool:
	if args.length() != params.length():
		False
	else:
		var forwards: Bool = True
		var index: Int = 0

		while forwards and index < args.length():
			match args.get(index):
				Some(VarExpr(variable, typ, loc)):
					match params.get(index):
						Some(param):
							forwards = (
								variable.name == param.name.name
								and variable.uniq == param.name.uniq
							)
						None:
							forwards = False
				Some(arg):
					forwards = False
				None:
					forwards = False

			index += 1

		forwards


private pure func consumed_arg_indices(contract: OwnershipCallContract) -> List[Int]:
	var consumed: List[Int] = []
	var index: Int = 0

	for mode in contract.args:
		if arg_consumes_caller(mode):
			consumed = consumed.append(index)
		else:
			void

		index += 1

	consumed


private pure func direct_builtin_wrapper_consumed_args(
	func_info: CoreFunction,
) -> Option[List[Int]]:
	match func_info.body:
		Some(body):
			match body:
				CallExpr(kind, callee, args, typ, loc):
					match kind:
						BuiltinCall(name):
							if args_forward_params_in_order(args, func_info.params):
								match builtin_contract(name, args.length()):
									Some(contract):
										Some(consumed_arg_indices(contract))
									None:
										None
							else:
								None
						_:
							None
				_:
					None
		None:
			None


private pure func lookup_layered_user_call_consumed_args(
	env: PerceusEnv,
	name: String,
) -> Option[List[Int]]:
	var found: Option[List[Int]] = None
	var index: Int = env.user_call_contract_layers_by_name.length() - 1

	while index >= 0:
		candidate: Option[List[Int]] = match env.user_call_contract_layers_by_name.get(index):
			Some(layer):
				layer.get(name)
			None:
				None

		match candidate:
			Some(args):
				found = Some(args)
				break
			None:
				index -= 1

	found


private pure func lookup_user_call_contract(
	env: PerceusEnv,
	name: String,
	arg_count: Int,
	return_type: CoreType,
) -> Option[OwnershipCallContract]:
	consumed_args: Option[List[Int]] = match lookup_layered_user_call_consumed_args(env, name):
		Some(args):
			Some(args)
		None:
			env.user_call_contracts_by_name.get(name)

	match consumed_args:
		Some(args):
			Some(user_call_contract_from_consumed_args(env, args, arg_count, return_type))
		None:
			None


private pure func lookup_direct_user_call_contract(
	env: PerceusEnv,
	name: String,
	arg_count: Int,
	return_type: CoreType,
) -> Option[OwnershipCallContract]:
	match env.direct_user_call_contracts_by_name.get(name):
		Some(consumed_args):
			Some(user_call_contract_from_consumed_args(env, consumed_args, arg_count, return_type))
		None:
			None


pure func build_env(program: CoreProgram) -> PerceusEnv:
	var managed_type_names: List[String] = DEFAULT_MANAGED_TYPE_NAMES
	var constructor_contracts_by_name: Dict[String, List[ConstructorCallContract]] = {}
	var constructor_contracts_by_def_id: Dict[Int, List[ConstructorCallContract]] = {}
	var constructor_contracts_by_parent_name: Dict[String, List[ConstructorCallContract]] = {}
	var direct_user_call_contracts_by_name: Dict[String, List[Int]] = {}
	var global_values: List[PerceusGlobal] = []

	for decl in program.decls:
		match decl:
			UnionDecl(union_decl):
				if not list_contains_string(managed_type_names, union_decl.name):
					managed_type_names = managed_type_names.append(union_decl.name)
				else:
					void

				for variant in union_decl.variants:
					arity: Int = variant.fields.length()

					if arity > 0:
						entry: ConstructorCallContract = {
							parent_type_name = union_decl.name,
							name = variant.name,
							def_id = variant.def_id,
							contract = {
								args = transfer_args(arity),
								result = ReturnOwned
							}
						}

						contracts_with_name: List[ConstructorCallContract] = match constructor_contracts_by_name.get(
							entry.name,
						):
							Some(contracts):
								contracts
							None:
								[]

						constructor_contracts_by_name = constructor_contracts_by_name.set(
							entry.name,
							contracts_with_name.append(entry),
						)

						contracts_with_parent: List[ConstructorCallContract] = match constructor_contracts_by_parent_name.get(
							entry.parent_type_name,
						):
							Some(contracts):
								contracts
							None:
								[]

						constructor_contracts_by_parent_name = constructor_contracts_by_parent_name.set(
							entry.parent_type_name,
							contracts_with_parent.append(entry),
						)

						match entry.def_id:
							Some(def_id):
								contracts_with_def_id: List[ConstructorCallContract] = match constructor_contracts_by_def_id.get(
									def_id,
								):
									Some(contracts):
										contracts
									None:
										[]

								constructor_contracts_by_def_id = constructor_contracts_by_def_id.set(
									def_id,
									contracts_with_def_id.append(entry),
								)
							None:
								void
					else:
						void
			HeapRecordDecl(record_decl):
				if not list_contains_string(managed_type_names, record_decl.name):
					managed_type_names = managed_type_names.append(record_decl.name)
				else:
					void
			FunctionDecl(func_info):
				match direct_builtin_wrapper_consumed_args(func_info):
					Some(consumed_args):
						direct_user_call_contracts_by_name = direct_user_call_contracts_by_name.set(
							func_info.name,
							consumed_args,
						)
					None:
						void
			GlobalDecl(global):
				perceus_global: PerceusGlobal = {
					value = {
						name = { global.name | def_id = Some(global.def_id) },
						typ = global.typ,
						loc = global.loc
					},
					is_mutable = global.is_mutable
				}
				global_values = global_values.append(perceus_global)
			_:
				void

	{
		managed_type_names = managed_type_names,
		constructor_contracts_by_name = constructor_contracts_by_name,
		constructor_contracts_by_def_id = constructor_contracts_by_def_id,
		constructor_contracts_by_parent_name = constructor_contracts_by_parent_name,
		global_values = global_values,
		function_names = CoreClosure.capture_function_names(program),
		constructor_names = CoreClosure.capture_constructor_names(program),
		direct_user_call_contracts_by_name = direct_user_call_contracts_by_name,
		user_call_contracts_by_name = {},
		user_call_contract_layers_by_name = [],
		infer_unresolved_user_calls_as_borrow = False,
		balance_nested_matches = False,
		transferable_result_vars = []
	}


pure func is_managed_type(env: PerceusEnv, typ: CoreType) -> Bool:
	match typ:
		NamedType("Option", [payload_type]):
			match payload_type:
				NamedType("Option", nested_args):
					True
				StackResultType(ok_type, err_type):
					True
				BoxedResultType(ok_type, err_type):
					True
				_:
					is_managed_type(env, payload_type)
		NamedType(name, args):
			(
				list_contains_string(env.managed_type_names, name)
				or compiler_is_one_shot_stream_type_name(name)
				or compiler_is_resource_source_type_name(name)
			)
		HeapRecordType(name):
			True
		UnionType(name):
			True
		BoxedResultType(ok_type, err_type):
			True
		StackResultType(ok_type, err_type):
			is_managed_type(env, ok_type) or is_managed_type(env, err_type)
		TupleType(items):
			True
		VoidType:
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		RangeType:
			False
		TensorType(info):
			True


private pure func retain_policy_for_type(typ: CoreType) -> CoreRetainPolicy:
	match typ:
		StackResultType(ok_type, err_type):
			StackResultRetainPolicy
		_:
			ArcRetainPolicy


private pure func release_policy_for_type(typ: CoreType) -> CoreReleasePolicy:
	match typ:
		StackResultType(ok_type, err_type):
			StackResultReleasePolicy
		_:
			ArcReleasePolicy


pure func result_mode_for_type(env: PerceusEnv, typ: CoreType) -> OwnershipResultMode:
	match typ:
		VoidType:
			ReturnVoid
		_:
			if is_managed_type(env, typ):
				ReturnOwned
			else:
				ReturnPrimitive


pure func borrow_contract_for_signature(
	env: PerceusEnv,
	arg_count: Int,
	return_type: CoreType,
) -> OwnershipCallContract:
	{
		args = borrow_args(arg_count),
		result = result_mode_for_type(env, return_type)
	}


private pure func contract_matches_arity(contract: OwnershipCallContract, arg_count: Int) -> Bool:
	contract.args.length() == arg_count


private pure func optional_constructor_parent_name(typ: CoreType) -> Option[String]:
	match typ:
		NamedType(name, args):
			Some(name)
		UnionType(name):
			Some(name)
		_:
			None


private pure func constructor_parent_is_known(env: PerceusEnv, parent_type_name: String) -> Bool:
	env.constructor_contracts_by_parent_name.contains(parent_type_name)


private pure func constructor_contract_by_def_id(
	env: PerceusEnv,
	def_id: Int,
	arg_count: Int,
) -> Option[OwnershipCallContract]:
	var found: Option[OwnershipCallContract] = None

	entries: List[ConstructorCallContract] = match env.constructor_contracts_by_def_id.get(def_id):
		Some(contracts):
			contracts
		None:
			[]

	-- Unscoped lookup preserves the historical last matching declaration.
	for entry in entries:
		if contract_matches_arity(entry.contract, arg_count):
			found = Some(entry.contract)
		else:
			void

	found


private pure func constructor_contract_by_name(
	env: PerceusEnv,
	name: String,
	arg_count: Int,
) -> Option[OwnershipCallContract]:
	var found: Option[OwnershipCallContract] = None

	entries: List[ConstructorCallContract] = match env.constructor_contracts_by_name.get(name):
		Some(contracts):
			contracts
		None:
			[]

	-- Unscoped lookup preserves the historical last matching declaration.
	for entry in entries:
		if contract_matches_arity(entry.contract, arg_count):
			found = Some(entry.contract)
		else:
			void

	found


private pure func constructor_contract_by_return_type(
	env: PerceusEnv,
	parent_type_name: String,
	name: String,
	def_id: Option[Int],
	arg_count: Int,
) -> Option[OwnershipCallContract]:
	var by_def_id: Option[OwnershipCallContract] = None

	entries: List[ConstructorCallContract] = match env.constructor_contracts_by_parent_name.get(
		parent_type_name,
	):
		Some(contracts):
			contracts
		None:
			[]

	-- Parent buckets retain program order for the scoped first-match behavior.
	match def_id:
		Some(value):
			for entry in entries:
				if (
					entry.def_id == Some(value)
					and contract_matches_arity(entry.contract, arg_count)
				):
					by_def_id = Some(entry.contract)
					break
				else:
					void
		None:
			void

	match by_def_id:
		Some(contract):
			Some(contract)
		None:
			var by_name: Option[OwnershipCallContract] = None

			for entry in entries:
				if entry.name == name and contract_matches_arity(entry.contract, arg_count):
					by_name = Some(entry.contract)
					break
				else:
					void

			by_name


private pure func lookup_return_type_constructor_call_contract(
	env: PerceusEnv,
	name: String,
	def_id: Option[Int],
	arg_count: Int,
	return_type: CoreType,
) -> Option[OwnershipCallContract]:
	match return_type:
		StackResultType(_, _):
			result_constructor_contract(env, name, arg_count, return_type)
		BoxedResultType(_, _):
			result_constructor_contract(env, name, arg_count, return_type)
		_:
			match optional_constructor_parent_name(return_type):
				Some(parent_type_name):
					constructor_contract_by_return_type(
						env,
						parent_type_name,
						name,
						def_id,
						arg_count,
					)
				None:
					None


private pure func result_constructor_contract(
	env: PerceusEnv,
	name: String,
	arg_count: Int,
	return_type: CoreType,
) -> Option[OwnershipCallContract]:
	if arg_count == 1 and env.constructor_names.contains(name):
		Some({
			args = transfer_args(arg_count),
			result = result_mode_for_type(env, return_type),
		})
	else:
		None


private pure func return_type_has_known_constructor_parent(
	env: PerceusEnv,
	return_type: CoreType,
) -> Bool:
	match optional_constructor_parent_name(return_type):
		Some(parent_type_name):
			constructor_parent_is_known(env, parent_type_name)
		None:
			False


pure func lookup_constructor_call_contract(
	env: PerceusEnv,
	name: String,
	def_id: Option[Int],
	arg_count: Int,
) -> Option[OwnershipCallContract]:
	match def_id:
		Some(value):
			match constructor_contract_by_def_id(env, value, arg_count):
				Some(contract):
					Some(contract)
				None:
					constructor_contract_by_name(env, name, arg_count)
		None:
			constructor_contract_by_name(env, name, arg_count)


private pure func projected_or_unresolved_user_call_contract(
	env: PerceusEnv,
	consumed_args: List[Int],
	arg_count: Int,
	return_type: CoreType,
) -> Option[OwnershipCallContract]:
	match consumed_user_call_contract(env, consumed_args, arg_count, return_type):
		Some(contract):
			Some(contract)
		None:
			if env.infer_unresolved_user_calls_as_borrow:
				Some(borrow_contract_for_signature(env, arg_count, return_type))
			else:
				None


private pure func unresolved_user_call_contract(
	env: PerceusEnv,
	name: String,
	def_id: Option[Int],
	consumed_args: List[Int],
	arg_count: Int,
	return_type: CoreType,
) -> Option[OwnershipCallContract]:
	if return_type_has_known_constructor_parent(env, return_type):
		projected_or_unresolved_user_call_contract(env, consumed_args, arg_count, return_type)
	else:
		match lookup_constructor_call_contract(env, name, def_id, arg_count):
			Some(contract):
				Some(contract)
			None:
				match lookup_user_call_contract(env, name, arg_count, return_type):
					Some(contract):
						Some(contract)
					None:
						projected_or_unresolved_user_call_contract(
							env,
							consumed_args,
							arg_count,
							return_type,
						)


pure func contract_for_call(
	env: PerceusEnv,
	kind: CoreCallKind,
	arg_count: Int,
	return_type: CoreType,
) -> Option[OwnershipCallContract]:
	match kind:
		UnknownCall:
			None
		SelectedDirectCall(def_id):
			None
		IntrinsicCall(name):
			intrinsic_contract(name, arg_count)
		BuiltinCall(name):
			builtin_contract(name, arg_count)
		UserCall(name, def_id, consumed_args):
			-- Constructor calls also arrive as UserCall. Exact constructor identity
			-- wins; otherwise a registered specialization is stronger evidence than
			-- merely returning a known union type.
			match lookup_return_type_constructor_call_contract(
				env,
				name,
				def_id,
				arg_count,
				return_type,
			):
				Some(contract):
					Some(contract)
				None:
					match lookup_direct_user_call_contract(env, name, arg_count, return_type):
						Some(contract):
							Some(contract)
						None:
							if (
								env.infer_unresolved_user_calls_as_borrow
								or not is_managed_type(env, return_type)
							):
								match lookup_user_call_contract(env, name, arg_count, return_type):
									Some(contract):
										Some(contract)
									None:
										unresolved_user_call_contract(
											env,
											name,
											def_id,
											consumed_args,
											arg_count,
											return_type,
										)
							else:
								unresolved_user_call_contract(
									env,
									name,
									def_id,
									consumed_args,
									arg_count,
									return_type,
								)
		ForeignCall(name, arg_passing):
			Some(borrow_contract_for_signature(env, arg_count, return_type))
		ClosureCall:
			Some(borrow_contract_for_signature(env, arg_count, return_type))
		DirectRuntimeCall(call):
			builtin_contract(call.name, arg_count)
		OperationResultCall(bridge):
			builtin_contract(bridge.builtin_name, arg_count)
		FallibleStreamTerminalCall(bridge):
			builtin_contract(bridge.builtin_name, arg_count)
		TensorParallelCall(name, layout):
			builtin_contract(name, arg_count)
		DictWithCapacityCall(constructor):
			builtin_contract("blorp_dict_with_capacity_custom", arg_count)
		ListToStringCall(name):
			builtin_contract("blorp_list_to_string_cb", arg_count)


record OwnershipUseSummary {
	required_refs: Int,
	consumed_refs: Int,
	touched: Bool,
	returns_alias: Bool,
	user_call_dependencies: List[String]
}


private record MutableAssignmentRewrite {
	expr: CoreExpr,
	next_temp: Int
}


private record MutableConstructorMatchBodyRewrite {
	body: CoreConstructorMatchBody,
	next_temp: Int
}


private record MutableLiteralMatchFallbackRewrite {
	fallback: CoreLiteralMatchFallback,
	next_temp: Int
}


private record MutableConstructorLiteralMatchRewrite {
	match_expr: CoreConstructorLiteralMatch,
	next_temp: Int
}


private record MutableConstructorLengthBranchRewrite {
	branch: CoreConstructorLengthMatchBranch,
	next_temp: Int
}


private record MutableConstructorLengthMatchRewrite {
	match_expr: CoreConstructorLengthMatch,
	next_temp: Int
}


private record MutableConstructorMatchFallbackRewrite {
	fallback: CoreConstructorMatchFallback,
	next_temp: Int
}


private record MutableConstructorMatchRewrite {
	cases: List[CoreConstructorMatchCase],
	fallback: CoreConstructorMatchFallback,
	next_temp: Int
}


private record FreshenedConstructorMatchBindingBody {
	bindings: List[CoreMatchBinding],
	body: CoreConstructorMatchBody
}


private record SyntheticOwnershipBinding {
	variable: CoreVar,
	typ: CoreType,
	rhs: CoreExpr
}


private record PreparedTemporaryCall {
	bindings: List[SyntheticOwnershipBinding],
	call: CoreExpr
}


private NO_OWNERSHIP_USES: OwnershipUseSummary = {
	required_refs = 0,
	consumed_refs = 0,
	touched = False,
	returns_alias = False,
	user_call_dependencies = []
}

private CONSUME_OWNERSHIP_USE: OwnershipUseSummary = {
	required_refs = 1,
	consumed_refs = 1,
	touched = True,
	returns_alias = False,
	user_call_dependencies = []
}

private BORROW_OWNERSHIP_USE: OwnershipUseSummary = {
	required_refs = 1,
	consumed_refs = 0,
	touched = True,
	returns_alias = False,
	user_call_dependencies = []
}


private pure func merge_user_call_dependencies(
	left: List[String],
	right: List[String],
) -> List[String]:
	var merged: List[String] = left

	for name in right:
		if not merged.contains(name):
			merged = merged.append(name)
		else:
			void

	merged


private pure func ownership_uses_from_legacy_count(count: Int) -> OwnershipUseSummary:
	if count <= 0:
		NO_OWNERSHIP_USES
	else:
		{
			required_refs = count,
			consumed_refs = count,
			touched = True,
			returns_alias = False,
			user_call_dependencies = []
		}


private pure func seq_ownership_uses(
	first: OwnershipUseSummary,
	second: OwnershipUseSummary,
) -> OwnershipUseSummary:
	{
		required_refs = max_int(first.required_refs, first.consumed_refs + second.required_refs),
		consumed_refs = first.consumed_refs + second.consumed_refs,
		touched = first.touched or second.touched,
		returns_alias = second.returns_alias,
		user_call_dependencies = merge_user_call_dependencies(
			first.user_call_dependencies,
			second.user_call_dependencies,
		)
	}


private pure func ownership_uses_with_returns_alias(
	uses: OwnershipUseSummary,
	returns_alias: Bool,
) -> OwnershipUseSummary:
	{
		required_refs = uses.required_refs,
		consumed_refs = uses.consumed_refs,
		touched = uses.touched,
		returns_alias = returns_alias,
		user_call_dependencies = uses.user_call_dependencies
	}


private pure func aggregate_ownership_uses(items: List[OwnershipUseSummary]) -> OwnershipUseSummary:
	var summary: OwnershipUseSummary = NO_OWNERSHIP_USES
	var returns_alias: Bool = False

	for item in items:
		summary = seq_ownership_uses(summary, item)

		if item.returns_alias:
			returns_alias = True
		else:
			void

	ownership_uses_with_returns_alias(summary, returns_alias)


private pure func sum_ownership_uses(items: List[OwnershipUseSummary]) -> OwnershipUseSummary:
	var required_refs: Int = 0
	var consumed_refs: Int = 0
	var touched: Bool = False
	var returns_alias: Bool = False
	var user_call_dependencies: List[String] = []

	for item in items:
		required_refs += item.required_refs
		consumed_refs += item.consumed_refs
		touched = touched or item.touched
		returns_alias = returns_alias or item.returns_alias
		user_call_dependencies = merge_user_call_dependencies(
			user_call_dependencies,
			item.user_call_dependencies,
		)

	{
		required_refs = required_refs,
		consumed_refs = consumed_refs,
		touched = touched,
		returns_alias = returns_alias,
		user_call_dependencies = user_call_dependencies
	}


private pure func branch_ownership_uses(items: List[OwnershipUseSummary]) -> OwnershipUseSummary:
	var required_refs: Int = 0
	var consumed_refs: Int = 0
	var touched: Bool = False
	var returns_alias: Bool = False
	var user_call_dependencies: List[String] = []

	for item in items:
		required_refs = max_int(required_refs, item.required_refs)
		consumed_refs = max_int(consumed_refs, item.consumed_refs)
		touched = touched or item.touched
		returns_alias = returns_alias or item.returns_alias
		user_call_dependencies = merge_user_call_dependencies(
			user_call_dependencies,
			item.user_call_dependencies,
		)

	{
		required_refs = required_refs,
		consumed_refs = consumed_refs,
		touched = touched,
		returns_alias = returns_alias,
		user_call_dependencies = user_call_dependencies
	}


private pure func direct_aliases_name(name: String, expr: CoreExpr) -> Bool:
	match expr:
		VarExpr(variable, typ, loc):
			variable.name == name
		FieldExpr(owner, field, typ, loc):
			direct_aliases_name(name, owner)
		TupleFieldExpr(owner, field_index, typ, loc):
			direct_aliases_name(name, owner)
		CastExpr(inner, typ, loc):
			direct_aliases_name(name, inner)
		UnboxExpr(kind, inner, typ, loc):
			direct_aliases_name(name, inner)
		_:
			False


private pure func copy_core_var(variable: CoreVar) -> CoreVar:
	{
		name = variable.name,
		uniq = variable.uniq,
		def_id = variable.def_id
	}


private pure func copy_core_types(types: List[CoreType]) -> List[CoreType]:
	var copied: List[CoreType] = []

	for typ in types:
		copied = copied.append(copy_core_type(typ))

	copied


private pure func copy_core_type(typ: CoreType) -> CoreType:
	match typ:
		VoidType:
			VoidType
		NamedType(name, args):
			NamedType(name, copy_core_types(args))
		StackResultType(ok_type, err_type):
			StackResultType(copy_core_type(ok_type), copy_core_type(err_type))
		BoxedResultType(ok_type, err_type):
			BoxedResultType(copy_core_type(ok_type), copy_core_type(err_type))
		EnumType(name):
			EnumType(name)
		ValueRecordType(name):
			ValueRecordType(name)
		HeapRecordType(name):
			HeapRecordType(name)
		UnionType(name):
			UnionType(name)
		RangeType:
			RangeType
		TensorType(info):
			TensorType({
				element_type = copy_core_type(info.element_type),
				dims = info.dims,
			})
		TupleType(items):
			TupleType(copy_core_types(items))


private pure func copy_core_param(param: CoreParam) -> CoreParam:
	{
		name = copy_core_var(param.name),
		typ = copy_core_type(param.typ),
		loc = param.loc
	}


private pure func copy_core_params(params: List[CoreParam]) -> List[CoreParam]:
	var copied: List[CoreParam] = []

	for param in params:
		copied = copied.append(copy_core_param(param))

	copied


private pure func copy_core_call_kind(kind: CoreCallKind) -> CoreCallKind:
	kind


private pure func copy_exprs(exprs: List[CoreExpr]) -> List[CoreExpr]:
	var copied: List[CoreExpr] = []

	for expr in exprs:
		copied = copied.append(copy_expr(expr))

	copied


private pure func copy_boxed_values(
	values: List[CoreBoxedStorageValue],
) -> List[CoreBoxedStorageValue]:
	var copied: List[CoreBoxedStorageValue] = []

	for value in values:
		copied = copied.append({
			kind = value.kind,
			value = copy_expr(value.value),
			needs_release = value.needs_release,
			transfers_ownership = value.transfers_ownership,
		})

	copied


private pure func copy_record_fields(
	fields: List[CoreRecordFieldValue],
) -> List[CoreRecordFieldValue]:
	var copied: List[CoreRecordFieldValue] = []

	for field in fields:
		copied = copied.append({
			name = field.name,
			value = copy_expr(field.value),
		})

	copied


private pure func copy_dict_entries(entries: List[CoreDictEntry]) -> List[CoreDictEntry]:
	var copied: List[CoreDictEntry] = []

	for entry in entries:
		copied = copied.append({
			key = {
				kind = entry.key.kind,
				value = copy_expr(entry.key.value),
				needs_release = entry.key.needs_release,
				transfers_ownership = entry.key.transfers_ownership
			},
			value = {
				kind = entry.value.kind,
				value = copy_expr(entry.value.value),
				needs_release = entry.value.needs_release,
				transfers_ownership = entry.value.transfers_ownership
			},
		})

	copied


private pure func copy_expr(expr: CoreExpr) -> CoreExpr:
	match expr:
		LiteralExpr(literal, typ, loc):
			LiteralExpr(literal, copy_core_type(typ), loc)
		VarExpr(variable, typ, loc):
			VarExpr(copy_core_var(variable), copy_core_type(typ), loc)
		VoidExpr(typ, loc):
			VoidExpr(copy_core_type(typ), loc)
		CallExpr(kind, callee, args, typ, loc):
			CallExpr(
				copy_core_call_kind(kind),
				copy_expr(callee),
				copy_exprs(args),
				copy_core_type(typ),
				loc,
			)
		BinaryExpr(op, left, right, typ, loc):
			BinaryExpr(op, copy_expr(left), copy_expr(right), copy_core_type(typ), loc)
		UnaryExpr(op, inner, typ, loc):
			UnaryExpr(op, copy_expr(inner), copy_core_type(typ), loc)
		LogicalExpr(op, left, right, typ, loc):
			LogicalExpr(op, copy_expr(left), copy_expr(right), copy_core_type(typ), loc)
		AssignExpr(variable, rhs, typ, loc):
			AssignExpr(copy_core_var(variable), copy_expr(rhs), copy_core_type(typ), loc)
		CastExpr(inner, typ, loc):
			CastExpr(copy_expr(inner), copy_core_type(typ), loc)
		BoxExpr(box_op, typ, loc):
			BoxExpr(
				{ box_op |
					value = copy_expr(box_op.value),
					source_type = copy_core_type(box_op.source_type)
				},
				copy_core_type(typ),
				loc,
			)
		UnboxExpr(kind, inner, typ, loc):
			UnboxExpr(kind, copy_expr(inner), copy_core_type(typ), loc)
		FieldExpr(owner, field, typ, loc):
			FieldExpr(copy_expr(owner), field, copy_core_type(typ), loc)
		TupleExpr(items, typ, loc):
			TupleExpr(copy_exprs(items), copy_core_type(typ), loc)
		VectorExpr(items, typ, loc):
			VectorExpr(copy_exprs(items), copy_core_type(typ), loc)
		RecordExpr(fields, typ, loc):
			RecordExpr(copy_record_fields(fields), copy_core_type(typ), loc)
		RecordConstructExpr(type_name, fields, typ, loc):
			RecordConstructExpr(type_name, copy_record_fields(fields), copy_core_type(typ), loc)
		ListConstructExpr(construct, typ, loc):
			ListConstructExpr(
				{ construct | elements = copy_boxed_values(construct.elements) },
				copy_core_type(typ),
				loc,
			)
		TensorBoxedLiteralExpr(literal, typ, loc):
			TensorBoxedLiteralExpr(
				{ literal | elements = copy_boxed_values(literal.elements) },
				copy_core_type(typ),
				loc,
			)
		DictConstructExpr(construct, typ, loc):
			DictConstructExpr(
				{ construct | entries = copy_dict_entries(construct.entries) },
				copy_core_type(typ),
				loc,
			)
		UnionConstructExpr(construct, typ, loc):
			UnionConstructExpr(
				{ construct | args = copy_boxed_values(construct.args) },
				copy_core_type(typ),
				loc,
			)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			DupExpr(
				copy_core_var(variable),
				copy_core_type(value_type),
				retain_policy,
				copy_expr(body),
				copy_core_type(typ),
				loc,
			)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			DropExpr(
				copy_core_var(variable),
				copy_core_type(value_type),
				release_policy,
				copy_expr(body),
				copy_core_type(typ),
				loc,
			)
		LetExpr(variable, is_mutable, typ, rhs, body):
			LetExpr(
				copy_core_var(variable),
				is_mutable,
				copy_core_type(typ),
				copy_expr(rhs),
				copy_expr(body),
			)
		BorrowLetExpr(variable, typ, rhs, body):
			BorrowLetExpr(
				copy_core_var(variable),
				copy_core_type(typ),
				copy_expr(rhs),
				copy_expr(body),
			)
		SeqExpr(first, second):
			SeqExpr(copy_expr(first), copy_expr(second))
		IfExpr(cond, then_expr, else_expr, typ, loc):
			IfExpr(
				copy_expr(cond),
				copy_expr(then_expr),
				copy_expr(else_expr),
				copy_core_type(typ),
				loc,
			)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			CoreTraverse.map_core_expr_children(expr, copy_expr)
		WhileExpr(cond, body, typ, loc):
			WhileExpr(copy_expr(cond), copy_expr(body), copy_core_type(typ), loc)
		_:
			CoreTraverse.map_core_expr_children(expr, copy_expr)


private pure func expr_result_type(expr: CoreExpr) -> CoreType:
	core_expr_type(expr)


private pure func count_uses_in_exprs(name: String, exprs: List[CoreExpr]) -> Int:
	var total: Int = 0

	for expr in exprs:
		total += count_uses(name, expr)

	total


private pure func count_uses_in_boxed_values(
	name: String,
	values: List[CoreBoxedStorageValue],
) -> Int:
	var total: Int = 0

	for value in values:
		total += count_uses(name, value.value)

	total


private pure func count_uses_in_record_fields(
	name: String,
	fields: List[CoreRecordFieldValue],
) -> Int:
	var total: Int = 0

	for field in fields:
		total += count_uses(name, field.value)

	total


private pure func count_uses_in_dict_entries(name: String, entries: List[CoreDictEntry]) -> Int:
	var total: Int = 0

	for entry in entries:
		total += count_uses(name, entry.key.value)
		total += count_uses(name, entry.value.value)

	total


private pure func match_bindings_shadow(name: String, bindings: List[CoreMatchBinding]) -> Bool:
	var shadowed: Bool = False

	for binding in bindings:
		if binding.variable.name == name:
			shadowed = True
			break
		else:
			void

	shadowed


private pure func max_int(left: Int, right: Int) -> Int:
	if left > right:
		left
	else:
		right


private pure func count_uses_in_constructor_match_body(
	name: String,
	body: CoreConstructorMatchBody,
) -> Int:
	match body:
		ConstructorMatchBodyExpr(expr):
			count_uses(name, expr)
		ConstructorMatchBodyLiteral(match_expr):
			count_uses_in_constructor_literal_match(name, match_expr)
		ConstructorMatchBodyLength(match_expr):
			count_uses_in_constructor_length_match(name, match_expr)


private pure func count_uses_in_constructor_match_case(
	name: String,
	match_case: CoreConstructorMatchCase,
) -> Int:
	if match_bindings_shadow(name, match_case.bindings):
		0
	else:
		count_uses_in_constructor_match_body(name, match_case.body)


private pure func count_uses_in_constructor_match_cases(
	name: String,
	cases: List[CoreConstructorMatchCase],
) -> Int:
	var max_uses: Int = 0

	for match_case in cases:
		max_uses = max_int(
			max_uses,
			count_uses_in_constructor_match_case(name, match_case),
		)

	max_uses


private pure func count_uses_in_constructor_match_fallback(
	name: String,
	fallback: CoreConstructorMatchFallback,
) -> Int:
	match fallback:
		ConstructorMatchFallbackBody(body):
			count_uses(name, body)
		ConstructorMatchFallbackBindings(bindings, body):
			if match_bindings_shadow(name, bindings):
				0
			else:
				count_uses(name, body)
		ConstructorMatchFallbackFail:
			0


private pure func count_uses_in_literal_match_case(
	name: String,
	match_case: CoreLiteralMatchCase,
) -> Int:
	if match_bindings_shadow(name, match_case.bindings):
		0
	else:
		count_uses(name, match_case.body)


private pure func count_uses_in_literal_match_cases(
	name: String,
	cases: List[CoreLiteralMatchCase],
) -> Int:
	var max_uses: Int = 0

	for match_case in cases:
		max_uses = max_int(
			max_uses,
			count_uses_in_literal_match_case(name, match_case),
		)

	max_uses


private pure func count_uses_in_literal_match_fallback(
	name: String,
	fallback: CoreLiteralMatchFallback,
) -> Int:
	match fallback:
		LiteralMatchFallbackBody(body):
			count_uses(name, body)
		LiteralMatchFallbackBindings(bindings, body):
			if match_bindings_shadow(name, bindings):
				0
			else:
				count_uses(name, body)
		LiteralMatchFallbackFail:
			0


private pure func count_uses_in_constructor_literal_match(
	name: String,
	match_expr: CoreConstructorLiteralMatch,
) -> Int:
	max_int(
		count_uses_in_literal_match_cases(name, match_expr.cases),
		count_uses_in_literal_match_fallback(name, match_expr.fallback),
	)


private pure func count_uses_in_constructor_length_branch(
	name: String,
	branch: CoreConstructorLengthMatchBranch,
) -> Int:
	if match_bindings_shadow(name, branch.bindings):
		0
	else:
		count_uses_in_constructor_match_body(name, branch.body)


private pure func count_uses_in_constructor_length_cases(
	name: String,
	cases: List[CoreConstructorLengthMatchCase],
) -> Int:
	var max_uses: Int = 0

	for match_case in cases:
		max_uses = max_int(
			max_uses,
			count_uses_in_constructor_length_branch(name, match_case.branch),
		)

	max_uses


private pure func count_uses_in_constructor_length_geq(
	name: String,
	geq: Option[CoreConstructorLengthMatchGeq],
) -> Int:
	match geq:
		Some(value):
			count_uses_in_constructor_length_branch(name, value.branch)
		None:
			0


private pure func count_uses_in_constructor_length_fallback(
	name: String,
	fallback: Option[CoreConstructorLengthMatchBranch],
) -> Int:
	match fallback:
		Some(branch):
			count_uses_in_constructor_length_branch(name, branch)
		None:
			0


private pure func count_uses_in_constructor_length_match(
	name: String,
	match_expr: CoreConstructorLengthMatch,
) -> Int:
	max_int(
		count_uses_in_constructor_length_cases(name, match_expr.cases),
		max_int(
			count_uses_in_constructor_length_geq(name, match_expr.geq),
			count_uses_in_constructor_length_fallback(name, match_expr.fallback),
		),
	)


private pure func summarize_boxed_storage_uses(
	env: PerceusEnv,
	name: String,
	value: CoreBoxedStorageValue,
) -> OwnershipUseSummary:
	if value.transfers_ownership:
		summarize_linear_ownership_uses(env, name, value.value)
	else:
		summarize_linear_borrow(env, name, value.value)


private pure func summarize_boxed_storage_values(
	env: PerceusEnv,
	name: String,
	values: List[CoreBoxedStorageValue],
) -> OwnershipUseSummary:
	var summaries: List[OwnershipUseSummary] = []

	for value in values:
		summaries = summaries.append(summarize_boxed_storage_uses(env, name, value))

	aggregate_ownership_uses(summaries)


private pure func summarize_exprs(
	env: PerceusEnv,
	name: String,
	exprs: List[CoreExpr],
) -> OwnershipUseSummary:
	var summaries: List[OwnershipUseSummary] = []

	for expr in exprs:
		summaries = summaries.append(summarize_linear_ownership_uses(env, name, expr))

	aggregate_ownership_uses(summaries)


private pure func summarize_borrowed_exprs(
	env: PerceusEnv,
	name: String,
	exprs: List[CoreExpr],
) -> OwnershipUseSummary:
	var summaries: List[OwnershipUseSummary] = []

	for expr in exprs:
		summaries = summaries.append(summarize_linear_borrow(env, name, expr))

	aggregate_ownership_uses(summaries)


private pure func summarize_record_fields(
	env: PerceusEnv,
	name: String,
	fields: List[CoreRecordFieldValue],
) -> OwnershipUseSummary:
	var summaries: List[OwnershipUseSummary] = []

	for field in fields:
		summaries = summaries.append(summarize_linear_ownership_uses(env, name, field.value))

	aggregate_ownership_uses(summaries)


private pure func summarize_dict_entries(
	env: PerceusEnv,
	name: String,
	entries: List[CoreDictEntry],
) -> OwnershipUseSummary:
	var summaries: List[OwnershipUseSummary] = []

	for entry in entries:
		summaries = summaries.append(summarize_boxed_storage_uses(env, name, entry.key))
		summaries = summaries.append(summarize_boxed_storage_uses(env, name, entry.value))

	aggregate_ownership_uses(summaries)


private pure func summarize_call_args(
	env: PerceusEnv,
	name: String,
	modes: List[OwnershipArgMode],
	args: List[CoreExpr],
) -> List[OwnershipUseSummary]:
	match modes:
		[]:
			[]
		[mode, ...mode_tail]:
			match args:
				[]:
					[]
				[arg, ...arg_tail]:
					var summaries: List[OwnershipUseSummary] = [
						summarize_linear_call_arg(env, name, mode, arg),
					]

					for summary in summarize_call_args(env, name, mode_tail, arg_tail):
						summaries = summaries.append(summary)

					summaries


private pure func call_result_aliases_from_borrowed_args(
	env: PerceusEnv,
	name: String,
	modes: List[OwnershipArgMode],
	args: List[CoreExpr],
) -> Bool:
	match modes:
		[]:
			False
		[mode, ...mode_tail]:
			match args:
				[]:
					False
				[arg, ...arg_tail]:
					this_arg_aliases: Bool = (
						arg_allows_borrowed_result_alias(mode)
						and borrow_expr_aliases_target(env, name, arg)
					)

					(
						this_arg_aliases
						or call_result_aliases_from_borrowed_args(env, name, mode_tail, arg_tail)
					)


private pure func call_result_aliases_target(
	env: PerceusEnv,
	name: String,
	contract: OwnershipCallContract,
	args: List[CoreExpr],
	arg_uses: List[OwnershipUseSummary],
) -> Bool:
	match contract.result:
		ReturnAliasOfArg(index):
			match args.get(index):
				Some(arg):
					match arg_uses.get(index):
						Some(uses):
							uses.returns_alias or borrow_expr_aliases_target(env, name, arg)
						None:
							False
				None:
					False
		ReturnBorrowed:
			call_result_aliases_from_borrowed_args(env, name, contract.args, args)
		ReturnVoid:
			False
		ReturnPrimitive:
			False
		ReturnOwned:
			False


private pure func ownership_uses_with_user_call_dependency(
	env: PerceusEnv,
	kind: CoreCallKind,
	uses: OwnershipUseSummary,
) -> OwnershipUseSummary:
	if env.infer_unresolved_user_calls_as_borrow and uses.touched:
		match kind:
			UserCall(call_name, def_id, consumed_args):
				{ uses |
					user_call_dependencies = merge_user_call_dependencies(
						uses.user_call_dependencies,
						[call_name],
					)
				}
			_:
				uses
	else:
		uses


private pure func summarize_linear_call(
	env: PerceusEnv,
	name: String,
	return_type: CoreType,
	kind: CoreCallKind,
	callee: CoreExpr,
	args: List[CoreExpr],
) -> OwnershipUseSummary:
	match contract_for_call(env, kind, args.length(), return_type):
		Some(contract):
			arg_uses: List[OwnershipUseSummary] = summarize_call_args(
				env,
				name,
				contract.args,
				args,
			)

			summaries: List[OwnershipUseSummary] = match kind:
				UnknownCall:
					arg_uses
				SelectedDirectCall(def_id):
					arg_uses
				ClosureCall:
					[summarize_linear_borrow(env, name, callee)] + arg_uses
				BuiltinCall(call_name):
					arg_uses
				IntrinsicCall(call_name):
					arg_uses
				UserCall(call_name, def_id, consumed_args):
					arg_uses
				ForeignCall(call_name, arg_passing):
					arg_uses
				DirectRuntimeCall(call):
					arg_uses
				OperationResultCall(bridge):
					arg_uses
				FallibleStreamTerminalCall(bridge):
					arg_uses
				TensorParallelCall(call_name, layout):
					arg_uses
				DictWithCapacityCall(constructor):
					arg_uses
				ListToStringCall(call_name):
					arg_uses

			uses: OwnershipUseSummary = aggregate_ownership_uses(summaries)

			ownership_uses_with_user_call_dependency(
				env,
				kind,
				ownership_uses_with_returns_alias(
					uses,
					call_result_aliases_target(env, name, contract, args, arg_uses),
				),
			)
		None:
			var summaries: List[OwnershipUseSummary] = [
				summarize_linear_ownership_uses(env, name, callee),
			]

			for summary in ownership_summaries_for_args(env, name, args):
				summaries = summaries.append(summary)

			aggregate_ownership_uses(summaries)


private pure func summarize_linear_call_arg(
	env: PerceusEnv,
	name: String,
	mode: OwnershipArgMode,
	arg: CoreExpr,
) -> OwnershipUseSummary:
	if arg_consumes_caller(mode):
		summarize_linear_ownership_uses(env, name, arg)
	else:
		summarize_linear_borrow(env, name, arg)


private pure func ownership_summaries_for_args(
	env: PerceusEnv,
	name: String,
	args: List[CoreExpr],
) -> List[OwnershipUseSummary]:
	args.map(func(arg): summarize_linear_ownership_uses(env, name, arg))


private pure func summarize_linear_borrow(
	env: PerceusEnv,
	name: String,
	expr: CoreExpr,
) -> OwnershipUseSummary:
	match expr:
		VarExpr(variable, typ, loc):
			if variable.name == name:
				BORROW_OWNERSHIP_USE
			else:
				NO_OWNERSHIP_USES
		FieldExpr(owner, field, typ, loc):
			summarize_linear_borrow(env, name, owner)
		TupleFieldExpr(owner, field_index, typ, loc):
			summarize_linear_borrow(env, name, owner)
		CastExpr(inner, typ, loc):
			summarize_linear_borrow(env, name, inner)
		UnboxExpr(kind, inner, typ, loc):
			summarize_linear_borrow(env, name, inner)
		_:
			summarize_linear_ownership_uses(env, name, expr)


private pure func summarize_match_ownership_uses(
	env: PerceusEnv,
	name: String,
	scrutinee: CoreExpr,
	branch_uses: OwnershipUseSummary,
) -> OwnershipUseSummary:
	scrutinee_aliases_owner: Bool = borrow_expr_aliases_target(env, name, scrutinee)

	scrutinee_uses: OwnershipUseSummary = if scrutinee_aliases_owner:
		summarize_linear_borrow(env, name, scrutinee)
	else:
		summarize_linear_ownership_uses(env, name, scrutinee)

	balanced_branch_uses: OwnershipUseSummary = if scrutinee_aliases_owner:
		seq_ownership_uses(BORROW_OWNERSHIP_USE, branch_uses)
	else:
		branch_uses

	seq_ownership_uses(scrutinee_uses, balanced_branch_uses)


private pure func borrow_expr_aliases_target(env: PerceusEnv, name: String, expr: CoreExpr) -> Bool:
	match expr:
		VarExpr(variable, typ, loc):
			variable.name == name
		FieldExpr(owner, field, typ, loc):
			borrow_expr_aliases_target(env, name, owner)
		TupleFieldExpr(owner, field_index, typ, loc):
			borrow_expr_aliases_target(env, name, owner)
		CastExpr(inner, typ, loc):
			borrow_expr_aliases_target(env, name, inner)
		UnboxExpr(kind, inner, typ, loc):
			borrow_expr_aliases_target(env, name, inner)
		_:
			summarize_linear_ownership_uses(env, name, expr).returns_alias


-- Keep this phase-local while the pinned bootstrap cannot safely pass CoreVar
-- records through an imported helper call during the self-host build.
private pure func core_vars_have_same_definition(left: CoreVar, right: CoreVar) -> Bool:
	if left.name != right.name:
		False
	else:
		match (left.def_id, right.def_id):
			(Some(left_id), Some(right_id)):
				left_id == right_id
			_:
				False


private pure func core_var_matches_param(variable: CoreVar, param: CoreParam) -> Bool:
	match param.name.def_id:
		Some(_):
			core_vars_have_same_definition(variable, param.name)
		None:
			variable.name == param.name.name


private pure func match_bindings_shadow_param(
	bindings: List[CoreMatchBinding],
	param: CoreParam,
) -> Bool:
	bindings.any(func(binding): core_var_matches_param(binding.variable, param))


private pure func call_args_return_borrowed_definition(
	env: PerceusEnv,
	target_name: String,
	target_def_id: Int,
	modes: List[OwnershipArgMode],
	args: List[CoreExpr],
) -> Bool:
	var found: Bool = False
	var index: Int = 0

	for arg in args:
		match modes.get(index):
			Some(mode):
				if (
					arg_allows_borrowed_result_alias(mode)
					and borrow_expr_aliases_definition(env, target_name, target_def_id, arg)
				):
					found = True
					break
				else:
					void
			None:
				void

		index += 1

	found


private pure func call_result_aliases_definition(
	env: PerceusEnv,
	target_name: String,
	target_def_id: Int,
	contract: OwnershipCallContract,
	args: List[CoreExpr],
) -> Bool:
	match contract.result:
		ReturnAliasOfArg(index):
			match args.get(index):
				Some(arg):
					borrow_expr_aliases_definition(env, target_name, target_def_id, arg)
				None:
					False
		ReturnBorrowed:
			call_args_return_borrowed_definition(
				env,
				target_name,
				target_def_id,
				contract.args,
				args,
			)
		ReturnVoid:
			False
		ReturnPrimitive:
			False
		ReturnOwned:
			False


private pure func binding_body_aliases_definition(
	env: PerceusEnv,
	target_name: String,
	target_def_id: Int,
	variable: CoreVar,
	is_mutable: Bool,
	typ: CoreType,
	rhs: CoreExpr,
	body: CoreExpr,
) -> Bool:
	binding_shadows_target: Bool = (
		variable.name == target_name
		and variable.def_id == Some(target_def_id)
	)

	if (
		not binding_shadows_target
		and borrow_expr_aliases_definition(env, target_name, target_def_id, body)
	):
		True
	else if (
		not is_mutable
		and is_managed_type(env, typ)
		and borrow_expr_aliases_definition(env, target_name, target_def_id, rhs)
	):
		match variable.def_id:
			Some(binding_def_id):
				borrow_expr_aliases_definition(env, variable.name, binding_def_id, body)
			None:
				False
	else:
		False


-- Resolved parameters require definition-aware result traversal. Keep this
-- separate from the name-based use summary: branches inspect only values that
-- can become the expression result, and borrowed match bindings propagate an
-- alias only when their own resolved identity is returned.
private pure func match_bindings_shadow_definition(
	bindings: List[CoreMatchBinding],
	target_name: String,
	target_def_id: Int,
) -> Bool:
	bindings.any(func(binding):
		binding.variable.name == target_name and binding.variable.def_id == Some(target_def_id)
	)


private pure func borrowed_match_bindings_alias_expr_result(
	env: PerceusEnv,
	bindings: List[CoreMatchBinding],
	body: CoreExpr,
) -> Bool:
	var aliases: Bool = False

	for binding in bindings:
		match binding.variable.def_id:
			Some(binding_def_id):
				if (
					binding.mode == MatchBorrowBindingMode
					and is_managed_type(env, binding.typ)
					and borrow_expr_aliases_definition(
						env,
						binding.variable.name,
						binding_def_id,
						body,
					)
				):
					aliases = True
					break
				else:
					void
			None:
				void

	aliases


private pure func match_expr_branch_aliases_definition(
	env: PerceusEnv,
	target_name: String,
	target_def_id: Int,
	source_aliases_target: Bool,
	bindings: List[CoreMatchBinding],
	body: CoreExpr,
) -> Bool:
	direct_alias: Bool = (
		not match_bindings_shadow_definition(bindings, target_name, target_def_id)
		and borrow_expr_aliases_definition(env, target_name, target_def_id, body)
	)

	borrowed_binding_alias: Bool = (
		source_aliases_target
		and borrowed_match_bindings_alias_expr_result(env, bindings, body)
	)

	direct_alias or borrowed_binding_alias


private pure func literal_match_aliases_definition(
	env: PerceusEnv,
	target_name: String,
	target_def_id: Int,
	source_aliases_target: Bool,
	cases: List[CoreLiteralMatchCase],
	fallback: CoreLiteralMatchFallback,
) -> Bool:
	var aliases: Bool = False

	for match_case in cases:
		if match_expr_branch_aliases_definition(
			env,
			target_name,
			target_def_id,
			source_aliases_target,
			match_case.bindings,
			match_case.body,
		):
			aliases = True
			break
		else:
			void

	if aliases:
		True
	else:
		match fallback:
			LiteralMatchFallbackBody(body):
				borrow_expr_aliases_definition(env, target_name, target_def_id, body)
			LiteralMatchFallbackBindings(bindings, body):
				match_expr_branch_aliases_definition(
					env,
					target_name,
					target_def_id,
					source_aliases_target,
					bindings,
					body,
				)
			LiteralMatchFallbackFail:
				False


private pure func constructor_match_body_aliases_definition(
	env: PerceusEnv,
	target_name: String,
	target_def_id: Int,
	source_aliases_target: Bool,
	body: CoreConstructorMatchBody,
) -> Bool:
	match body:
		ConstructorMatchBodyExpr(expr):
			borrow_expr_aliases_definition(env, target_name, target_def_id, expr)
		ConstructorMatchBodyLiteral(match_expr):
			literal_match_aliases_definition(
				env,
				target_name,
				target_def_id,
				source_aliases_target,
				match_expr.cases,
				match_expr.fallback,
			)
		ConstructorMatchBodyLength(match_expr):
			constructor_length_match_aliases_definition(
				env,
				target_name,
				target_def_id,
				source_aliases_target,
				match_expr,
			)


private pure func borrowed_match_bindings_alias_constructor_result(
	env: PerceusEnv,
	bindings: List[CoreMatchBinding],
	body: CoreConstructorMatchBody,
) -> Bool:
	var aliases: Bool = False

	for binding in bindings:
		match binding.variable.def_id:
			Some(binding_def_id):
				if (
					binding.mode == MatchBorrowBindingMode
					and is_managed_type(env, binding.typ)
					and constructor_match_body_aliases_definition(
						env,
						binding.variable.name,
						binding_def_id,
						True,
						body,
					)
				):
					aliases = True
					break
				else:
					void
			None:
				void

	aliases


private pure func match_constructor_branch_aliases_definition(
	env: PerceusEnv,
	target_name: String,
	target_def_id: Int,
	source_aliases_target: Bool,
	bindings: List[CoreMatchBinding],
	body: CoreConstructorMatchBody,
) -> Bool:
	direct_alias: Bool = (
		not match_bindings_shadow_definition(bindings, target_name, target_def_id)
		and constructor_match_body_aliases_definition(
			env,
			target_name,
			target_def_id,
			source_aliases_target,
			body,
		)
	)

	borrowed_binding_alias: Bool = (
		source_aliases_target
		and borrowed_match_bindings_alias_constructor_result(env, bindings, body)
	)

	direct_alias or borrowed_binding_alias


private pure func constructor_length_branch_aliases_definition(
	env: PerceusEnv,
	target_name: String,
	target_def_id: Int,
	source_aliases_target: Bool,
	branch: CoreConstructorLengthMatchBranch,
) -> Bool:
	match_constructor_branch_aliases_definition(
		env,
		target_name,
		target_def_id,
		source_aliases_target,
		branch.bindings,
		branch.body,
	)


private pure func constructor_length_match_aliases_definition(
	env: PerceusEnv,
	target_name: String,
	target_def_id: Int,
	source_aliases_target: Bool,
	match_expr: CoreConstructorLengthMatch,
) -> Bool:
	var aliases: Bool = False

	for match_case in match_expr.cases:
		if constructor_length_branch_aliases_definition(
			env,
			target_name,
			target_def_id,
			source_aliases_target,
			match_case.branch,
		):
			aliases = True
			break
		else:
			void

	if not aliases:
		match match_expr.geq:
			Some(match_case):
				aliases = constructor_length_branch_aliases_definition(
					env,
					target_name,
					target_def_id,
					source_aliases_target,
					match_case.branch,
				)
			None:
				void
	else:
		void

	if not aliases:
		match match_expr.fallback:
			Some(branch):
				aliases = constructor_length_branch_aliases_definition(
					env,
					target_name,
					target_def_id,
					source_aliases_target,
					branch,
				)
			None:
				void
	else:
		void

	aliases


private pure func constructor_match_aliases_definition(
	env: PerceusEnv,
	target_name: String,
	target_def_id: Int,
	source_aliases_target: Bool,
	cases: List[CoreConstructorMatchCase],
	fallback: CoreConstructorMatchFallback,
) -> Bool:
	var aliases: Bool = False

	for match_case in cases:
		if match_constructor_branch_aliases_definition(
			env,
			target_name,
			target_def_id,
			source_aliases_target,
			match_case.bindings,
			match_case.body,
		):
			aliases = True
			break
		else:
			void

	if aliases:
		True
	else:
		match fallback:
			ConstructorMatchFallbackBody(body):
				borrow_expr_aliases_definition(env, target_name, target_def_id, body)
			ConstructorMatchFallbackBindings(bindings, body):
				match_expr_branch_aliases_definition(
					env,
					target_name,
					target_def_id,
					source_aliases_target,
					bindings,
					body,
				)
			ConstructorMatchFallbackFail:
				False


-- Prove that a Dup already owns every alias returned through transparent
-- wrappers. Unsupported shapes conservatively return False and retain through
-- the ordinary borrowed-result path.
private pure func expr_references_definition(
	target_name: String,
	target_def_id: Int,
	expr: CoreExpr,
) -> Bool:
	CoreDce.value_references(expr).resolved_reads.any(func(variable):
		variable.name == target_name and variable.def_id == Some(target_def_id)
	)


private pure func expr_invalidates_definition(
	target_name: String,
	target_def_id: Int,
	expr: CoreExpr,
) -> Bool:
	CoreDce.value_references(expr).resolved_invalidations.any(func(variable):
		variable.name == target_name and variable.def_id == Some(target_def_id)
	)


private pure func constructor_literal_match_references_definition(
	target_name: String,
	target_def_id: Int,
	match_expr: CoreConstructorLiteralMatch,
) -> Bool:
	var references_target: Bool = False

	for match_case in match_expr.cases:
		if (
			not match_bindings_shadow_definition(match_case.bindings, target_name, target_def_id)
			and expr_references_definition(target_name, target_def_id, match_case.body)
		):
			references_target = True
			break
		else:
			void

	if not references_target:
		match match_expr.fallback:
			LiteralMatchFallbackBody(body):
				references_target = expr_references_definition(target_name, target_def_id, body)
			LiteralMatchFallbackBindings(bindings, body):
				references_target = (
					not match_bindings_shadow_definition(bindings, target_name, target_def_id)
					and expr_references_definition(target_name, target_def_id, body)
				)
			LiteralMatchFallbackFail:
				void
	else:
		void

	references_target


private pure func constructor_match_body_references_definition(
	target_name: String,
	target_def_id: Int,
	body: CoreConstructorMatchBody,
) -> Bool:
	match body:
		ConstructorMatchBodyExpr(expr):
			expr_references_definition(target_name, target_def_id, expr)
		ConstructorMatchBodyLiteral(match_expr):
			constructor_literal_match_references_definition(target_name, target_def_id, match_expr)
		ConstructorMatchBodyLength(match_expr):
			constructor_length_match_references_definition(target_name, target_def_id, match_expr)


private pure func constructor_length_branch_references_definition(
	target_name: String,
	target_def_id: Int,
	branch: CoreConstructorLengthMatchBranch,
) -> Bool:
	(
		not match_bindings_shadow_definition(branch.bindings, target_name, target_def_id)
		and constructor_match_body_references_definition(target_name, target_def_id, branch.body)
	)


private pure func constructor_length_match_references_definition(
	target_name: String,
	target_def_id: Int,
	match_expr: CoreConstructorLengthMatch,
) -> Bool:
	var references_target: Bool = False

	for match_case in match_expr.cases:
		if constructor_length_branch_references_definition(
			target_name,
			target_def_id,
			match_case.branch,
		):
			references_target = True
			break
		else:
			void

	if not references_target:
		match match_expr.geq:
			Some(match_case):
				references_target = constructor_length_branch_references_definition(
					target_name,
					target_def_id,
					match_case.branch,
				)
			None:
				void
	else:
		void

	if not references_target:
		match match_expr.fallback:
			Some(branch):
				references_target = constructor_length_branch_references_definition(
					target_name,
					target_def_id,
					branch,
				)
			None:
				void
	else:
		void

	references_target


private pure func binding_body_returns_only_exact_definition_alias(
	env: PerceusEnv,
	target_name: String,
	target_def_id: Int,
	variable: CoreVar,
	is_mutable: Bool,
	typ: CoreType,
	rhs: CoreExpr,
	body: CoreExpr,
) -> Bool:
	binding_shadows_target: Bool = (
		variable.name == target_name
		and variable.def_id == Some(target_def_id)
	)

	direct_exact_alias: Bool = (
		not binding_shadows_target
		and not expr_invalidates_definition(target_name, target_def_id, rhs)
		and returns_only_exact_definition_alias(env, target_name, target_def_id, body)
	)

	bound_exact_alias: Bool = if (
		not is_mutable
		and is_managed_type(env, typ)
		and returns_only_exact_definition_alias(env, target_name, target_def_id, rhs)
	):
		match variable.def_id:
			Some(binding_def_id):
				returns_only_exact_definition_alias(env, variable.name, binding_def_id, body)
			None:
				False
	else:
		False

	direct_exact_alias or bound_exact_alias


private pure func expr_result_is_exact_or_unrelated(
	env: PerceusEnv,
	target_name: String,
	target_def_id: Int,
	expr: CoreExpr,
) -> Bool:
	(
		returns_only_exact_definition_alias(env, target_name, target_def_id, expr)
		or not expr_references_definition(target_name, target_def_id, expr)
	)


private pure func literal_match_returns_only_exact_definition_alias(
	env: PerceusEnv,
	target_name: String,
	target_def_id: Int,
	cases: List[CoreLiteralMatchCase],
	fallback: CoreLiteralMatchFallback,
) -> Bool:
	var has_exact_result: Bool = False
	var every_result_is_safe: Bool = True

	for match_case in cases:
		if match_bindings_shadow_definition(match_case.bindings, target_name, target_def_id):
			void
		else:
			case_is_exact: Bool = returns_only_exact_definition_alias(
				env,
				target_name,
				target_def_id,
				match_case.body,
			)
			has_exact_result = has_exact_result or case_is_exact
			every_result_is_safe = (
				every_result_is_safe
				and ((
					case_is_exact
					or not expr_references_definition(target_name, target_def_id, match_case.body)
				))
			)

	match fallback:
		LiteralMatchFallbackBody(body):
			fallback_is_exact: Bool = returns_only_exact_definition_alias(
				env,
				target_name,
				target_def_id,
				body,
			)
			has_exact_result = has_exact_result or fallback_is_exact
			every_result_is_safe = (
				every_result_is_safe
				and expr_result_is_exact_or_unrelated(env, target_name, target_def_id, body)
			)
		LiteralMatchFallbackBindings(bindings, body):
			if match_bindings_shadow_definition(bindings, target_name, target_def_id):
				void
			else:
				fallback_is_exact: Bool = returns_only_exact_definition_alias(
					env,
					target_name,
					target_def_id,
					body,
				)
				has_exact_result = has_exact_result or fallback_is_exact
				every_result_is_safe = (
					every_result_is_safe
					and expr_result_is_exact_or_unrelated(env, target_name, target_def_id, body)
				)
		LiteralMatchFallbackFail:
			void

	has_exact_result and every_result_is_safe


private pure func constructor_match_body_returns_only_exact_definition_alias(
	env: PerceusEnv,
	target_name: String,
	target_def_id: Int,
	body: CoreConstructorMatchBody,
) -> Bool:
	match body:
		ConstructorMatchBodyExpr(expr):
			returns_only_exact_definition_alias(env, target_name, target_def_id, expr)
		ConstructorMatchBodyLiteral(match_expr):
			literal_match_returns_only_exact_definition_alias(
				env,
				target_name,
				target_def_id,
				match_expr.cases,
				match_expr.fallback,
			)
		ConstructorMatchBodyLength(match_expr):
			constructor_length_match_returns_only_exact_definition_alias(
				env,
				target_name,
				target_def_id,
				match_expr,
			)


private pure func constructor_match_body_is_exact_or_unrelated(
	env: PerceusEnv,
	target_name: String,
	target_def_id: Int,
	body: CoreConstructorMatchBody,
) -> Bool:
	match body:
		ConstructorMatchBodyExpr(expr):
			expr_result_is_exact_or_unrelated(env, target_name, target_def_id, expr)
		ConstructorMatchBodyLiteral(match_expr):
			(
				literal_match_returns_only_exact_definition_alias(
					env,
					target_name,
					target_def_id,
					match_expr.cases,
					match_expr.fallback,
				)
				or not constructor_literal_match_references_definition(
					target_name,
					target_def_id,
					match_expr,
				)
			)
		ConstructorMatchBodyLength(match_expr):
			(
				constructor_length_match_returns_only_exact_definition_alias(
					env,
					target_name,
					target_def_id,
					match_expr,
				)
				or not constructor_length_match_references_definition(
					target_name,
					target_def_id,
					match_expr,
				)
			)


private pure func constructor_length_branch_returns_only_exact_definition_alias(
	env: PerceusEnv,
	target_name: String,
	target_def_id: Int,
	branch: CoreConstructorLengthMatchBranch,
) -> Bool:
	(
		not match_bindings_shadow_definition(branch.bindings, target_name, target_def_id)
		and constructor_match_body_returns_only_exact_definition_alias(
			env,
			target_name,
			target_def_id,
			branch.body,
		)
	)


private pure func constructor_length_branch_is_exact_or_unrelated(
	env: PerceusEnv,
	target_name: String,
	target_def_id: Int,
	branch: CoreConstructorLengthMatchBranch,
) -> Bool:
	(
		match_bindings_shadow_definition(branch.bindings, target_name, target_def_id)
		or constructor_match_body_is_exact_or_unrelated(
			env,
			target_name,
			target_def_id,
			branch.body,
		)
	)


private pure func constructor_length_match_returns_only_exact_definition_alias(
	env: PerceusEnv,
	target_name: String,
	target_def_id: Int,
	match_expr: CoreConstructorLengthMatch,
) -> Bool:
	var has_exact_result: Bool = False
	var every_result_is_safe: Bool = True

	for match_case in match_expr.cases:
		case_is_exact: Bool = constructor_length_branch_returns_only_exact_definition_alias(
			env,
			target_name,
			target_def_id,
			match_case.branch,
		)
		has_exact_result = has_exact_result or case_is_exact
		every_result_is_safe = (
			every_result_is_safe
			and constructor_length_branch_is_exact_or_unrelated(
				env,
				target_name,
				target_def_id,
				match_case.branch,
			)
		)

	match match_expr.geq:
		Some(match_case):
			case_is_exact: Bool = constructor_length_branch_returns_only_exact_definition_alias(
				env,
				target_name,
				target_def_id,
				match_case.branch,
			)
			has_exact_result = has_exact_result or case_is_exact
			every_result_is_safe = (
				every_result_is_safe
				and constructor_length_branch_is_exact_or_unrelated(
					env,
					target_name,
					target_def_id,
					match_case.branch,
				)
			)
		None:
			void

	match match_expr.fallback:
		Some(branch):
			fallback_is_exact: Bool = constructor_length_branch_returns_only_exact_definition_alias(
				env,
				target_name,
				target_def_id,
				branch,
			)
			has_exact_result = has_exact_result or fallback_is_exact
			every_result_is_safe = (
				every_result_is_safe
				and constructor_length_branch_is_exact_or_unrelated(
					env,
					target_name,
					target_def_id,
					branch,
				)
			)
		None:
			void

	has_exact_result and every_result_is_safe


private pure func constructor_match_returns_only_exact_definition_alias(
	env: PerceusEnv,
	target_name: String,
	target_def_id: Int,
	cases: List[CoreConstructorMatchCase],
	fallback: CoreConstructorMatchFallback,
) -> Bool:
	var has_exact_result: Bool = False
	var every_result_is_safe: Bool = True

	for match_case in cases:
		if match_bindings_shadow_definition(match_case.bindings, target_name, target_def_id):
			void
		else:
			case_is_exact: Bool = constructor_match_body_returns_only_exact_definition_alias(
				env,
				target_name,
				target_def_id,
				match_case.body,
			)
			has_exact_result = has_exact_result or case_is_exact
			every_result_is_safe = (
				every_result_is_safe
				and constructor_match_body_is_exact_or_unrelated(
					env,
					target_name,
					target_def_id,
					match_case.body,
				)
			)

	match fallback:
		ConstructorMatchFallbackBody(body):
			fallback_is_exact: Bool = returns_only_exact_definition_alias(
				env,
				target_name,
				target_def_id,
				body,
			)
			has_exact_result = has_exact_result or fallback_is_exact
			every_result_is_safe = (
				every_result_is_safe
				and expr_result_is_exact_or_unrelated(env, target_name, target_def_id, body)
			)
		ConstructorMatchFallbackBindings(bindings, body):
			if match_bindings_shadow_definition(bindings, target_name, target_def_id):
				void
			else:
				fallback_is_exact: Bool = returns_only_exact_definition_alias(
					env,
					target_name,
					target_def_id,
					body,
				)
				has_exact_result = has_exact_result or fallback_is_exact
				every_result_is_safe = (
					every_result_is_safe
					and expr_result_is_exact_or_unrelated(env, target_name, target_def_id, body)
				)
		ConstructorMatchFallbackFail:
			void

	has_exact_result and every_result_is_safe


private pure func returns_only_exact_definition_alias(
	env: PerceusEnv,
	target_name: String,
	target_def_id: Int,
	expr: CoreExpr,
) -> Bool:
	match expr:
		VarExpr(variable, typ, loc):
			variable.name == target_name and variable.def_id == Some(target_def_id)
		LetExpr(variable, is_mutable, typ, rhs, body):
			binding_body_returns_only_exact_definition_alias(
				env,
				target_name,
				target_def_id,
				variable,
				is_mutable,
				typ,
				rhs,
				body,
			)
		BorrowLetExpr(variable, typ, rhs, body):
			binding_body_returns_only_exact_definition_alias(
				env,
				target_name,
				target_def_id,
				variable,
				False,
				typ,
				rhs,
				body,
			)
		SeqExpr(first, second):
			(
				not expr_invalidates_definition(target_name, target_def_id, first)
				and returns_only_exact_definition_alias(env, target_name, target_def_id, second)
			)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			(
				not (variable.name == target_name and variable.def_id == Some(target_def_id))
				and returns_only_exact_definition_alias(env, target_name, target_def_id, body)
			)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			then_returns_exact: Bool = returns_only_exact_definition_alias(
				env,
				target_name,
				target_def_id,
				then_expr,
			)
			else_returns_exact: Bool = returns_only_exact_definition_alias(
				env,
				target_name,
				target_def_id,
				else_expr,
			)

			(
				not expr_invalidates_definition(target_name, target_def_id, cond)
				and (then_returns_exact or else_returns_exact)
				and ((
					then_returns_exact
					or not expr_references_definition(target_name, target_def_id, then_expr)
				))
				and ((
					else_returns_exact
					or not expr_references_definition(target_name, target_def_id, else_expr)
				))
			)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			(
				not expr_references_definition(target_name, target_def_id, scrutinee)
				and not expr_invalidates_definition(target_name, target_def_id, scrutinee)
				and literal_match_returns_only_exact_definition_alias(
					env,
					target_name,
					target_def_id,
					cases,
					fallback,
				)
			)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			(
				not expr_references_definition(target_name, target_def_id, scrutinee)
				and not expr_invalidates_definition(target_name, target_def_id, scrutinee)
				and literal_match_returns_only_exact_definition_alias(
					env,
					target_name,
					target_def_id,
					match_expr.cases,
					match_expr.fallback,
				)
			)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			(
				not expr_references_definition(target_name, target_def_id, scrutinee)
				and not expr_invalidates_definition(target_name, target_def_id, scrutinee)
				and constructor_length_match_returns_only_exact_definition_alias(
					env,
					target_name,
					target_def_id,
					match_expr,
				)
			)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			(
				not expr_references_definition(target_name, target_def_id, scrutinee)
				and not expr_invalidates_definition(target_name, target_def_id, scrutinee)
				and constructor_match_returns_only_exact_definition_alias(
					env,
					target_name,
					target_def_id,
					cases,
					fallback,
				)
			)
		ResourceScopeExpr(scope, typ, loc):
			(
				not expr_references_definition(target_name, target_def_id, scope.acquire)
				and not expr_invalidates_definition(target_name, target_def_id, scope.acquire)
				and not ((
					scope.variable.name == target_name
					and scope.variable.def_id == Some(target_def_id)
				))
				and returns_only_exact_definition_alias(env, target_name, target_def_id, scope.body)
				and not expr_references_definition(target_name, target_def_id, scope.cleanup)
				and not expr_invalidates_definition(target_name, target_def_id, scope.cleanup)
			)
		_:
			False


private pure func borrow_expr_aliases_definition(
	env: PerceusEnv,
	target_name: String,
	target_def_id: Int,
	expr: CoreExpr,
) -> Bool:
	match expr:
		VarExpr(variable, typ, loc):
			variable.name == target_name and variable.def_id == Some(target_def_id)
		FieldExpr(owner, field, typ, loc):
			borrow_expr_aliases_definition(env, target_name, target_def_id, owner)
		TupleFieldExpr(owner, field_index, typ, loc):
			borrow_expr_aliases_definition(env, target_name, target_def_id, owner)
		ListGetExpr(get, typ, loc):
			borrow_expr_aliases_definition(env, target_name, target_def_id, get.list)
		CallExpr(kind, callee, args, typ, loc):
			match contract_for_call(env, kind, args.length(), typ):
				Some(contract):
					call_result_aliases_definition(env, target_name, target_def_id, contract, args)
				None:
					False
		CastExpr(inner, typ, loc):
			borrow_expr_aliases_definition(env, target_name, target_def_id, inner)
		UnboxExpr(kind, inner, typ, loc):
			borrow_expr_aliases_definition(env, target_name, target_def_id, inner)
		LetExpr(variable, is_mutable, typ, rhs, body):
			binding_body_aliases_definition(
				env,
				target_name,
				target_def_id,
				variable,
				is_mutable,
				typ,
				rhs,
				body,
			)
		BorrowLetExpr(variable, typ, rhs, body):
			binding_body_aliases_definition(
				env,
				target_name,
				target_def_id,
				variable,
				False,
				typ,
				rhs,
				body,
			)
		SeqExpr(first, second):
			borrow_expr_aliases_definition(env, target_name, target_def_id, second)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			if (
				variable.name == target_name
				and variable.def_id == Some(target_def_id)
				and returns_only_exact_definition_alias(env, target_name, target_def_id, body)
			):
				False
			else:
				borrow_expr_aliases_definition(env, target_name, target_def_id, body)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			borrow_expr_aliases_definition(env, target_name, target_def_id, body)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			(
				borrow_expr_aliases_definition(env, target_name, target_def_id, then_expr)
				or borrow_expr_aliases_definition(env, target_name, target_def_id, else_expr)
			)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			literal_match_aliases_definition(
				env,
				target_name,
				target_def_id,
				borrow_expr_aliases_definition(env, target_name, target_def_id, scrutinee),
				cases,
				fallback,
			)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			literal_match_aliases_definition(
				env,
				target_name,
				target_def_id,
				borrow_expr_aliases_definition(env, target_name, target_def_id, scrutinee),
				match_expr.cases,
				match_expr.fallback,
			)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			constructor_length_match_aliases_definition(
				env,
				target_name,
				target_def_id,
				borrow_expr_aliases_definition(env, target_name, target_def_id, scrutinee),
				match_expr,
			)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			constructor_match_aliases_definition(
				env,
				target_name,
				target_def_id,
				borrow_expr_aliases_definition(env, target_name, target_def_id, scrutinee),
				cases,
				fallback,
			)
		ResourceScopeExpr(scope, typ, loc):
			binding_body_aliases_definition(
				env,
				target_name,
				target_def_id,
				scope.variable,
				False,
				scope.typ,
				scope.acquire,
				scope.body,
			)
		_:
			False


private pure func borrow_expr_aliases_param(
	env: PerceusEnv,
	param: CoreParam,
	expr: CoreExpr,
) -> Bool:
	match param.name.def_id:
		Some(def_id):
			borrow_expr_aliases_definition(env, param.name.name, def_id, expr)
		None:
			borrow_expr_aliases_target(env, param.name.name, expr)


pure func borrowed_result_aliases_param(env: PerceusEnv, param: CoreParam, expr: CoreExpr) -> Bool:
	borrow_expr_aliases_param(env, param, expr)


private pure func core_params_shadow(name: String, params: List[CoreParam]) -> Bool:
	params.any(func(param): param.name.name == name)


private pure func count_optional_use(name: String, expr: Option[CoreExpr]) -> Int:
	match expr:
		Some(value):
			count_uses(name, value)
		None:
			0


private pure func count_loop_uses(
	name: String,
	binder: CoreLoopBinder,
	iterable: CoreExpr,
	body: CoreExpr,
) -> Int:
	count_uses(name, iterable) + if binder.variable.name == name:
		0
	else:
		count_uses(name, body)


private pure func task_capture_ownership_use(name: String, body: CoreExpr) -> OwnershipUseSummary:
	if count_uses(name, body) > 0:
		BORROW_OWNERSHIP_USE
	else:
		NO_OWNERSHIP_USES


private pure func summarize_optional_ownership_use(
	env: PerceusEnv,
	name: String,
	expr: Option[CoreExpr],
) -> OwnershipUseSummary:
	match expr:
		Some(value):
			summarize_linear_ownership_uses(env, name, value)
		None:
			NO_OWNERSHIP_USES


private pure func summarize_repeated_body_uses(
	env: PerceusEnv,
	name: String,
	prefix_uses: OwnershipUseSummary,
	body: CoreExpr,
	body_shadowed: Bool,
	whole_expr: CoreExpr,
) -> OwnershipUseSummary:
	body_uses: OwnershipUseSummary = if body_shadowed:
		NO_OWNERSHIP_USES
	else:
		summarize_linear_ownership_uses(env, name, body)

	if body_uses.consumed_refs > 0:
		ownership_uses_from_legacy_count(count_uses(name, whole_expr))
	else:
		seq_ownership_uses(
			prefix_uses,
			ownership_uses_with_returns_alias(body_uses, False),
		)


private pure func summarize_constructor_literal_match_uses(
	env: PerceusEnv,
	name: String,
	match_expr: CoreConstructorLiteralMatch,
) -> OwnershipUseSummary:
	var branch_uses: List[OwnershipUseSummary] = []

	for match_case in match_expr.cases:
		if match_bindings_shadow(name, match_case.bindings):
			branch_uses = branch_uses.append(NO_OWNERSHIP_USES)
		else:
			branch_uses = branch_uses.append(
				summarize_linear_ownership_uses(
					env,
					name,
					match_case.body,
				),
			)

	match match_expr.fallback:
		LiteralMatchFallbackBody(body):
			branch_uses = branch_uses.append(summarize_linear_ownership_uses(env, name, body))
		LiteralMatchFallbackBindings(bindings, body):
			if match_bindings_shadow(name, bindings):
				branch_uses = branch_uses.append(NO_OWNERSHIP_USES)
			else:
				branch_uses = branch_uses.append(summarize_linear_ownership_uses(env, name, body))
		LiteralMatchFallbackFail:
			branch_uses = branch_uses.append(NO_OWNERSHIP_USES)

	branch_ownership_uses(branch_uses)


private pure func summarize_constructor_match_body_uses(
	env: PerceusEnv,
	name: String,
	body: CoreConstructorMatchBody,
) -> OwnershipUseSummary:
	match body:
		ConstructorMatchBodyExpr(expr):
			summarize_linear_ownership_uses(env, name, expr)
		ConstructorMatchBodyLiteral(match_expr):
			summarize_constructor_literal_match_uses(env, name, match_expr)
		ConstructorMatchBodyLength(match_expr):
			summarize_constructor_length_match_uses(env, name, match_expr)


private pure func summarize_constructor_length_branch_uses(
	env: PerceusEnv,
	name: String,
	branch: CoreConstructorLengthMatchBranch,
) -> OwnershipUseSummary:
	if match_bindings_shadow(name, branch.bindings):
		NO_OWNERSHIP_USES
	else:
		summarize_constructor_match_body_uses(env, name, branch.body)


private pure func summarize_constructor_length_match_uses(
	env: PerceusEnv,
	name: String,
	match_expr: CoreConstructorLengthMatch,
) -> OwnershipUseSummary:
	var branch_uses: List[OwnershipUseSummary] = []

	for match_case in match_expr.cases:
		branch_uses = branch_uses.append(
			summarize_constructor_length_branch_uses(
				env,
				name,
				match_case.branch,
			),
		)

	match match_expr.geq:
		Some(match_case):
			branch_uses = branch_uses.append(
				summarize_constructor_length_branch_uses(
					env,
					name,
					match_case.branch,
				),
			)
		None:
			void

	match match_expr.fallback:
		Some(branch):
			branch_uses = branch_uses.append(
				summarize_constructor_length_branch_uses(
					env,
					name,
					branch,
				),
			)
		None:
			branch_uses = branch_uses.append(NO_OWNERSHIP_USES)

	branch_ownership_uses(branch_uses)


private pure func summarize_constructor_match_case_uses(
	env: PerceusEnv,
	name: String,
	scrutinee_aliases_owner: Bool,
	match_case: CoreConstructorMatchCase,
) -> OwnershipUseSummary:
	if match_bindings_shadow(name, match_case.bindings):
		NO_OWNERSHIP_USES
	else:
		body_uses: OwnershipUseSummary = summarize_constructor_match_body_uses(
			env,
			name,
			match_case.body,
		)
		uses_borrowed_binding: Bool = (
			scrutinee_aliases_owner
			and constructor_match_body_uses_borrowed_binding(match_case.bindings, match_case.body)
		)

		if uses_borrowed_binding:
			ownership_uses_with_returns_alias(
				seq_ownership_uses(body_uses, BORROW_OWNERSHIP_USE),
				body_uses.returns_alias,
			)
		else:
			body_uses


private pure func summarize_constructor_match_branch_uses(
	env: PerceusEnv,
	name: String,
	scrutinee_aliases_owner: Bool,
	cases: List[CoreConstructorMatchCase],
	fallback: CoreConstructorMatchFallback,
) -> OwnershipUseSummary:
	var branch_uses: List[OwnershipUseSummary] = []

	for match_case in cases:
		branch_uses = branch_uses.append(
			summarize_constructor_match_case_uses(
				env,
				name,
				scrutinee_aliases_owner,
				match_case,
			),
		)

	match fallback:
		ConstructorMatchFallbackBody(body):
			branch_uses = branch_uses.append(summarize_linear_ownership_uses(env, name, body))
		ConstructorMatchFallbackBindings(bindings, body):
			if match_bindings_shadow(name, bindings):
				branch_uses = branch_uses.append(NO_OWNERSHIP_USES)
			else:
				body_uses: OwnershipUseSummary = summarize_linear_ownership_uses(env, name, body)
				uses_borrowed_binding: Bool = (
					scrutinee_aliases_owner
					and match_branch_uses_borrowed_binding(bindings, body)
				)

				branch_uses = branch_uses.append(
					if uses_borrowed_binding:
						ownership_uses_with_returns_alias(
							seq_ownership_uses(body_uses, BORROW_OWNERSHIP_USE),
							body_uses.returns_alias,
						)
					else:
						body_uses
				)
		ConstructorMatchFallbackFail:
			branch_uses = branch_uses.append(NO_OWNERSHIP_USES)

	branch_ownership_uses(branch_uses)


private pure func summarize_linear_ownership_uses(
	env: PerceusEnv,
	name: String,
	expr: CoreExpr,
) -> OwnershipUseSummary:
	match expr:
		VarExpr(variable, typ, loc):
			if variable.name == name:
				CONSUME_OWNERSHIP_USE
			else:
				NO_OWNERSHIP_USES
		LiteralExpr(literal, typ, loc):
			NO_OWNERSHIP_USES
		VoidExpr(typ, loc):
			NO_OWNERSHIP_USES
		CallExpr(kind, callee, args, typ, loc):
			summarize_linear_call(env, name, typ, kind, callee, args)
		BinaryExpr(op, left, right, typ, loc):
			seq_ownership_uses(
				summarize_linear_ownership_uses(env, name, left),
				summarize_linear_ownership_uses(env, name, right),
			)
		UnaryExpr(op, inner, typ, loc):
			summarize_linear_ownership_uses(env, name, inner)
		LogicalExpr(op, left, right, typ, loc):
			seq_ownership_uses(
				summarize_linear_ownership_uses(env, name, left),
				summarize_linear_ownership_uses(env, name, right),
			)
		AssignExpr(variable, rhs, typ, loc):
			if variable.name == name:
				NO_OWNERSHIP_USES
			else:
				summarize_linear_ownership_uses(env, name, rhs)
		CastExpr(inner, typ, loc):
			summarize_linear_borrow(env, name, inner)
		BoxExpr(box_op, typ, loc):
			summarize_linear_borrow(env, name, box_op.value)
		UnboxExpr(kind, inner, typ, loc):
			summarize_linear_borrow(env, name, inner)
		FieldExpr(owner, field, typ, loc):
			uses: OwnershipUseSummary = summarize_linear_borrow(env, name, owner)

			if uses.touched and is_managed_type(env, typ):
				ownership_uses_with_returns_alias(uses, True)
			else:
				uses
		TupleFieldExpr(owner, field_index, typ, loc):
			uses: OwnershipUseSummary = summarize_linear_borrow(env, name, owner)

			if uses.touched and is_managed_type(env, typ):
				ownership_uses_with_returns_alias(uses, True)
			else:
				uses
		LambdaExpr(params, return_type, body, is_pure, typ, loc):
			if core_params_shadow(name, params):
				NO_OWNERSHIP_USES
			else:
				task_capture_ownership_use(name, body)
		ClosureCreateExpr(closure, typ, loc):
			if closure.captures.any(func(capture): capture.name == name):
				BORROW_OWNERSHIP_USE
			else:
				NO_OWNERSHIP_USES
		TupleExpr(items, typ, loc):
			summarize_exprs(env, name, items)
		VectorExpr(items, typ, loc):
			summarize_exprs(env, name, items)
		RecordExpr(fields, typ, loc):
			summarize_record_fields(env, name, fields)
		RecordConstructExpr(type_name, fields, typ, loc):
			summarize_record_fields(env, name, fields)
		ListConstructExpr(construct, typ, loc):
			summarize_boxed_storage_values(env, name, construct.elements)
		ListAllocExpr(alloc, typ, loc):
			summarize_linear_ownership_uses(env, name, alloc.capacity)
		ListGetExpr(get, typ, loc):
			uses: OwnershipUseSummary = seq_ownership_uses(
				summarize_linear_borrow(env, name, get.list),
				summarize_linear_ownership_uses(env, name, get.index),
			)

			if uses.touched and is_managed_type(env, typ):
				ownership_uses_with_returns_alias(uses, True)
			else:
				uses
		ListHandoffSetOwnedExpr(set, typ, loc):
			seq_ownership_uses(
				summarize_linear_borrow(env, name, set.list),
				seq_ownership_uses(
					summarize_linear_ownership_uses(env, name, set.index),
					summarize_linear_ownership_uses(env, name, set.value.value),
				),
			)
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			summarize_borrowed_exprs(
				env,
				name,
				[slot.result, slot.out_index, slot.source, slot.source_index],
			)
		ListRetainExpr(retain, typ, loc):
			seq_ownership_uses(
				summarize_linear_borrow(env, name, retain.list),
				summarize_linear_borrow(env, name, retain.value.value),
			)
		ListSetExpr(set, typ, loc):
			seq_ownership_uses(
				summarize_linear_borrow(env, name, set.list),
				seq_ownership_uses(
					summarize_linear_ownership_uses(env, name, set.index),
					summarize_boxed_storage_uses(env, name, set.value),
				),
			)
		StringByteReadExpr(read, typ, loc):
			seq_ownership_uses(
				summarize_linear_borrow(env, name, read.source),
				summarize_linear_ownership_uses(env, name, read.index),
			)
		StringByteWriteExpr(write, typ, loc):
			summarize_borrowed_exprs(
				env,
				name,
				[write.target, write.index, write.byte],
			)
		StringByteCopyExpr(copy, typ, loc):
			summarize_borrowed_exprs(
				env,
				name,
				[copy.dst, copy.dst_pos, copy.src, copy.src_pos, copy.len],
			)
		StringSetLenExpr(set_len, typ, loc):
			summarize_borrowed_exprs(
				env,
				name,
				[set_len.target, set_len.len],
			)
		TensorBoxedLiteralExpr(literal, typ, loc):
			summarize_boxed_storage_values(env, name, literal.elements)
		DictConstructExpr(construct, typ, loc):
			summarize_dict_entries(env, name, construct.entries)
		UnionConstructExpr(construct, typ, loc):
			summarize_boxed_storage_values(env, name, construct.args)
		LetExpr(variable, is_mutable, typ, rhs, body):
			rhs_uses: OwnershipUseSummary = if (
				is_managed_type(env, typ)
				and direct_aliases_name(name, rhs)
			):
				summarize_linear_borrow(env, name, rhs)
			else:
				summarize_linear_ownership_uses(env, name, rhs)

			body_uses: OwnershipUseSummary = if variable.name == name:
				NO_OWNERSHIP_USES
			else:
				summarize_linear_ownership_uses(env, name, body)

			seq_ownership_uses(rhs_uses, body_uses)
		BorrowLetExpr(variable, typ, rhs, body):
			rhs_uses: OwnershipUseSummary = summarize_linear_borrow(env, name, rhs)

			body_uses: OwnershipUseSummary = if variable.name == name:
				NO_OWNERSHIP_USES
			else:
				summarize_linear_ownership_uses(env, name, body)

			seq_ownership_uses(rhs_uses, body_uses)
		SeqExpr(first, second):
			seq_ownership_uses(
				summarize_linear_ownership_uses(env, name, first),
				summarize_linear_ownership_uses(env, name, second),
			)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			if variable.name == name:
				uses: OwnershipUseSummary = summarize_linear_ownership_uses(env, name, body)

				{
					required_refs = max_int(1, uses.required_refs - 1),
					consumed_refs = max_int(0, uses.consumed_refs - 1),
					touched = True,
					returns_alias = uses.returns_alias,
					user_call_dependencies = uses.user_call_dependencies
				}
			else:
				summarize_linear_ownership_uses(env, name, body)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			if variable.name == name:
				seq_ownership_uses(
					CONSUME_OWNERSHIP_USE,
					summarize_linear_ownership_uses(env, name, body),
				)
			else:
				summarize_linear_ownership_uses(env, name, body)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			seq_ownership_uses(
				summarize_linear_ownership_uses(env, name, cond),
				branch_ownership_uses([
					summarize_linear_ownership_uses(env, name, then_expr),
					summarize_linear_ownership_uses(env, name, else_expr),
				]),
			)
		WhileExpr(cond, body, typ, loc):
			cond_uses: OwnershipUseSummary = summarize_linear_ownership_uses(env, name, cond)
			body_uses: OwnershipUseSummary = summarize_linear_ownership_uses(env, name, body)

			if cond_uses.consumed_refs > 0 or body_uses.consumed_refs > 0:
				ownership_uses_from_legacy_count(count_uses(name, expr))
			else:
				seq_ownership_uses(
					cond_uses,
					ownership_uses_with_returns_alias(body_uses, False),
				)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			scrutinee_aliases_owner: Bool = borrow_expr_aliases_target(env, name, scrutinee)
			summarize_match_ownership_uses(
				env,
				name,
				scrutinee,
				summarize_constructor_match_branch_uses(
					env,
					name,
					scrutinee_aliases_owner,
					cases,
					fallback,
				),
			)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			summarize_match_ownership_uses(
				env,
				name,
				scrutinee,
				summarize_constructor_literal_match_uses(
					env,
					name,
					{
						accessor = RootAccessor,
						scrutinee_type = core_expr_type(scrutinee),
						cases = cases,
						fallback = fallback,
						result_type = typ,
						loc = loc
					},
				),
			)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			summarize_match_ownership_uses(
				env,
				name,
				scrutinee,
				summarize_constructor_literal_match_uses(env, name, match_expr),
			)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			summarize_match_ownership_uses(
				env,
				name,
				scrutinee,
				summarize_constructor_length_match_uses(env, name, match_expr),
			)
		BreakExpr(typ, loc):
			NO_OWNERSHIP_USES
		ResourceScopeExpr(scope, typ, loc):
			acquire_uses: OwnershipUseSummary = summarize_linear_ownership_uses(
				env,
				name,
				scope.acquire,
			)

			scoped_uses: OwnershipUseSummary = if scope.variable.name == name:
				NO_OWNERSHIP_USES
			else:
				seq_ownership_uses(
					summarize_linear_ownership_uses(env, name, scope.body),
					summarize_linear_ownership_uses(env, name, scope.cleanup),
				)

			seq_ownership_uses(acquire_uses, scoped_uses)
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			summarize_exprs(env, name, cleanup_exit.cleanups)
		PreClosureDetachExpr(detached, typ, loc):
			task_capture_ownership_use(name, detached.body)
		DetachExpr(detached, typ, loc):
			if detached.task.captures.any(func(capture): capture.name == name):
				BORROW_OWNERSHIP_USE
			else:
				NO_OWNERSHIP_USES
		ListHandoffExpr(handoff, typ, loc):
			source_uses: OwnershipUseSummary = if handoff.mode == BorrowFreshHandoff:
				summarize_linear_borrow(env, name, handoff.source)
			else:
				summarize_linear_ownership_uses(env, name, handoff.source)

			body_shadowed: Bool = (
				handoff.source_var.name == name
				or handoff.result_var.name == name
				or handoff.len_var.name == name
				or handoff.out_var.name == name
			)

			body_uses: OwnershipUseSummary = if body_shadowed:
				NO_OWNERSHIP_USES
			else:
				summarize_linear_ownership_uses(env, name, handoff.body)

			seq_ownership_uses(
				source_uses,
				seq_ownership_uses(
					summarize_linear_ownership_uses(env, name, handoff.capacity),
					body_uses,
				),
			)
		TailrecLoopExpr(params, return_type, body, loc):
			if core_params_shadow(name, params):
				NO_OWNERSHIP_USES
			else:
				summarize_linear_ownership_uses(env, name, body)
		TailrecRecurExpr(args, typ, loc):
			sum_ownership_uses(args.map(
				func(arg): summarize_linear_ownership_uses(env, name, arg),
			))
		TailrecListSpreadLoopExpr(loop, loc):
			if loop.list_param.name.name == name or core_params_shadow(name, loop.params):
				NO_OWNERSHIP_USES
			else:
				summarize_linear_ownership_uses(env, name, loop.body)
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			sum_ownership_uses(rebinds.map(
				func(rebind): summarize_linear_ownership_uses(env, name, rebind.value),
			))
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			summarize_repeated_body_uses(
				env,
				name,
				seq_ownership_uses(
					summarize_linear_ownership_uses(env, name, start),
					summarize_linear_ownership_uses(env, name, end_value),
				),
				body,
				binder.variable.name == name,
				expr,
			)
		ForChannelExpr(loop, typ, loc):
			summarize_repeated_body_uses(
				env,
				name,
				summarize_linear_borrow(env, name, loop.iterable),
				loop.body,
				loop.binder.variable.name == name,
				expr,
			)
		ForListExpr(loop, typ, loc):
			summarize_repeated_body_uses(
				env,
				name,
				summarize_linear_borrow(env, name, loop.iterable),
				loop.body,
				loop.binder.variable.name == name,
				expr,
			)
		ForStringExpr(loop, typ, loc):
			summarize_repeated_body_uses(
				env,
				name,
				summarize_linear_borrow(env, name, loop.iterable),
				loop.body,
				loop.binder.variable.name == name,
				expr,
			)
		ForDictExpr(loop, typ, loc):
			summarize_repeated_body_uses(
				env,
				name,
				summarize_linear_borrow(env, name, loop.iterable),
				loop.body,
				loop.binder.variable.name == name,
				expr,
			)
		ForSetExpr(loop, typ, loc):
			summarize_repeated_body_uses(
				env,
				name,
				summarize_linear_borrow(env, name, loop.iterable),
				loop.body,
				loop.binder.variable.name == name,
				expr,
			)
		ForStreamExpr(loop, typ, loc):
			summarize_repeated_body_uses(
				env,
				name,
				summarize_linear_borrow(env, name, loop.iterable),
				loop.body,
				loop.binder.variable.name == name,
				expr,
			)
		ForResourceSourceExpr(loop, typ, loc):
			summarize_repeated_body_uses(
				env,
				name,
				summarize_linear_borrow(env, name, loop.iterable),
				loop.body,
				loop.binder.variable.name == name,
				expr,
			)
		ForTensorExpr(loop, typ, loc):
			summarize_repeated_body_uses(
				env,
				name,
				summarize_linear_borrow(env, name, loop.iterable),
				loop.body,
				loop.binder.variable.name == name,
				expr,
			)
		PreClosureConcurrentExpr(block, typ, loc):
			var task_summaries: List[OwnershipUseSummary] = []
			var shadowed: Bool = False

			for binding in block.bindings:
				task_summaries = task_summaries.append(
					task_capture_ownership_use(
						name,
						binding.rhs,
					),
				)

				if binding.variable.name == name:
					shadowed = True
				else:
					void

			body_uses: OwnershipUseSummary = if shadowed:
				NO_OWNERSHIP_USES
			else:
				summarize_linear_ownership_uses(env, name, block.body)

			seq_ownership_uses(
				summarize_optional_ownership_use(env, name, block.timeout),
				seq_ownership_uses(sum_ownership_uses(task_summaries), body_uses),
			)
		ConcurrentExpr(block, typ, loc):
			var task_summaries: List[OwnershipUseSummary] = []
			var shadowed: Bool = False

			for binding in block.bindings:
				task_summaries = task_summaries.append(
					task_capture_ownership_use(
						name,
						binding.rhs,
					),
				)

				if binding.variable.name == name:
					shadowed = True
				else:
					void

			body_uses: OwnershipUseSummary = if shadowed:
				NO_OWNERSHIP_USES
			else:
				summarize_linear_ownership_uses(env, name, block.body)

			seq_ownership_uses(
				summarize_optional_ownership_use(env, name, block.timeout),
				seq_ownership_uses(sum_ownership_uses(task_summaries), body_uses),
			)
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			iter_uses: OwnershipUseSummary = summarize_linear_borrow(env, name, loop.iterable)

			task_uses: OwnershipUseSummary = if loop.variable.name == name:
				NO_OWNERSHIP_USES
			else:
				task_capture_ownership_use(name, loop.body)

			aggregate_ownership_uses([
				summarize_optional_ownership_use(env, name, loop.timeout),
				iter_uses,
				summarize_linear_ownership_uses(env, name, loop.limit),
				task_uses,
			])
		ConcurrentlyLoopExpr(loop, typ, loc):
			iter_uses: OwnershipUseSummary = summarize_linear_borrow(env, name, loop.iterable)

			task_uses: OwnershipUseSummary = if loop.variable.name == name:
				NO_OWNERSHIP_USES
			else:
				task_capture_ownership_use(name, loop.body)

			aggregate_ownership_uses([
				summarize_optional_ownership_use(env, name, loop.timeout),
				iter_uses,
				summarize_linear_ownership_uses(env, name, loop.limit),
				task_uses,
			])
		SelectExpr(select_expr, typ, loc):
			var wait_summaries: List[OwnershipUseSummary] = []
			var branch_summaries: List[OwnershipUseSummary] = []

			for arm in select_expr.arms:
				arm_shadows: Bool = match arm.kind:
					SelectRecvArm(recv):
						wait_summaries = wait_summaries.append(
							summarize_linear_borrow(
								env,
								name,
								recv.channel,
							),
						)
						recv.binder.name == name
					SelectSealedArm(channel):
						wait_summaries = wait_summaries.append(
							summarize_linear_borrow(
								env,
								name,
								channel,
							),
						)
						False
					SelectAfterArm(timeout):
						wait_summaries = wait_summaries.append(
							summarize_linear_ownership_uses(
								env,
								name,
								timeout,
							),
						)
						False

				branch_summaries = branch_summaries.append(
					if arm_shadows:
						NO_OWNERSHIP_USES
					else:
						summarize_linear_ownership_uses(env, name, arm.body)
				)

			seq_ownership_uses(
				aggregate_ownership_uses(wait_summaries),
				branch_ownership_uses(branch_summaries),
			)
		_:
			ownership_uses_from_legacy_count(count_uses(name, expr))


pure func count_uses(name: String, expr: CoreExpr) -> Int:
	match expr:
		VarExpr(variable, typ, loc):
			if variable.name == name:
				1
			else:
				0
		LiteralExpr(literal, typ, loc):
			0
		VoidExpr(typ, loc):
			0
		CallExpr(kind, callee, args, typ, loc):
			count_uses(name, callee) + count_uses_in_exprs(name, args)
		BinaryExpr(op, left, right, typ, loc):
			count_uses(name, left) + count_uses(name, right)
		UnaryExpr(op, inner, typ, loc):
			count_uses(name, inner)
		LogicalExpr(op, left, right, typ, loc):
			count_uses(name, left) + count_uses(name, right)
		AssignExpr(variable, rhs, typ, loc):
			count_uses(name, rhs)
		CastExpr(inner, typ, loc):
			count_uses(name, inner)
		BoxExpr(box_op, typ, loc):
			count_uses(name, box_op.value)
		UnboxExpr(kind, inner, typ, loc):
			count_uses(name, inner)
		FieldExpr(owner, field, typ, loc):
			count_uses(name, owner)
		TupleFieldExpr(owner, field_index, typ, loc):
			count_uses(name, owner)
		LambdaExpr(params, return_type, body, is_pure, typ, loc):
			if core_params_shadow(name, params):
				0
			else if count_uses(name, body) > 0:
				1
			else:
				0
		ClosureCreateExpr(closure, typ, loc):
			if closure.captures.any(func(capture): capture.name == name):
				1
			else:
				0
		TupleExpr(items, typ, loc):
			count_uses_in_exprs(name, items)
		VectorExpr(items, typ, loc):
			count_uses_in_exprs(name, items)
		RecordExpr(fields, typ, loc):
			count_uses_in_record_fields(name, fields)
		RecordConstructExpr(type_name, fields, typ, loc):
			count_uses_in_record_fields(name, fields)
		ListConstructExpr(construct, typ, loc):
			count_uses_in_boxed_values(name, construct.elements)
		ListAllocExpr(alloc, typ, loc):
			count_uses(name, alloc.capacity)
		ListGetExpr(get, typ, loc):
			count_uses(name, get.list) + count_uses(name, get.index)
		ListHandoffSetOwnedExpr(set, typ, loc):
			count_uses(
				name,
				set.list,
			) + count_uses(name, set.index) + count_uses(name, set.value.value)
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			count_uses(
				name,
				slot.result,
			) + count_uses(
				name,
				slot.out_index,
			) + count_uses(name, slot.source) + count_uses(name, slot.source_index)
		ListRetainExpr(retain, typ, loc):
			count_uses(name, retain.list) + count_uses(name, retain.value.value)
		ListSetExpr(set, typ, loc):
			count_uses(
				name,
				set.list,
			) + count_uses(name, set.index) + count_uses(name, set.value.value)
		StringByteReadExpr(read, typ, loc):
			count_uses(name, read.source) + count_uses(name, read.index)
		StringByteWriteExpr(write, typ, loc):
			count_uses(
				name,
				write.target,
			) + count_uses(name, write.index) + count_uses(name, write.byte)
		StringByteCopyExpr(copy, typ, loc):
			count_uses(
				name,
				copy.dst,
			) + count_uses(
				name,
				copy.dst_pos,
			) + count_uses(
				name,
				copy.src,
			) + count_uses(name, copy.src_pos) + count_uses(name, copy.len)
		StringSetLenExpr(set_len, typ, loc):
			count_uses(name, set_len.target) + count_uses(name, set_len.len)
		TensorBoxedLiteralExpr(literal, typ, loc):
			count_uses_in_boxed_values(name, literal.elements)
		DictConstructExpr(construct, typ, loc):
			count_uses_in_dict_entries(name, construct.entries)
		UnionConstructExpr(construct, typ, loc):
			count_uses_in_boxed_values(name, construct.args)
		LetExpr(variable, is_mutable, typ, rhs, body):
			rhs_uses: Int = count_uses(name, rhs)

			if variable.name == name:
				rhs_uses
			else:
				rhs_uses + count_uses(name, body)
		BorrowLetExpr(variable, typ, rhs, body):
			rhs_uses: Int = count_uses(name, rhs)

			if variable.name == name:
				rhs_uses
			else:
				rhs_uses + count_uses(name, body)
		SeqExpr(first, second):
			count_uses(name, first) + count_uses(name, second)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			count_uses(name, body)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			count_uses(name, body)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			count_uses(name, cond) + max_int(
				count_uses(name, then_expr),
				count_uses(name, else_expr),
			)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			count_uses(name, scrutinee) + max_int(
				count_uses_in_constructor_match_cases(name, cases),
				count_uses_in_constructor_match_fallback(name, fallback),
			)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			count_uses(name, scrutinee) + max_int(
				count_uses_in_literal_match_cases(name, cases),
				count_uses_in_literal_match_fallback(name, fallback),
			)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			count_uses(name, scrutinee) + count_uses_in_constructor_literal_match(name, match_expr)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			count_uses(name, scrutinee) + count_uses_in_constructor_length_match(name, match_expr)
		BreakExpr(typ, loc):
			0
		WhileExpr(cond, body, typ, loc):
			count_uses(name, cond) + count_uses(name, body)
		ResourceScopeExpr(scope, typ, loc):
			scoped_uses: Int = if scope.variable.name == name:
				0
			else:
				count_uses(name, scope.body) + count_uses(name, scope.cleanup)

			count_uses(name, scope.acquire) + scoped_uses
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			count_uses_in_exprs(name, cleanup_exit.cleanups)
		TailrecLoopExpr(params, return_type, body, loc):
			if core_params_shadow(name, params):
				0
			else:
				count_uses(name, body)
		TailrecRecurExpr(args, typ, loc):
			count_uses_in_exprs(name, args)
		TailrecListSpreadLoopExpr(loop, loc):
			if loop.list_param.name.name == name or core_params_shadow(name, loop.params):
				0
			else:
				count_uses(name, loop.body)
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			var total: Int = 0

			for rebind in rebinds:
				total += count_uses(name, rebind.value)

			total
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			count_uses(name, start) + count_loop_uses(name, binder, end_value, body)
		ForChannelExpr(loop, typ, loc):
			count_loop_uses(name, loop.binder, loop.iterable, loop.body)
		ForListExpr(loop, typ, loc):
			count_loop_uses(name, loop.binder, loop.iterable, loop.body)
		ForStringExpr(loop, typ, loc):
			count_loop_uses(name, loop.binder, loop.iterable, loop.body)
		ForDictExpr(loop, typ, loc):
			count_loop_uses(name, loop.binder, loop.iterable, loop.body)
		ForSetExpr(loop, typ, loc):
			count_loop_uses(name, loop.binder, loop.iterable, loop.body)
		ForStreamExpr(loop, typ, loc):
			count_loop_uses(name, loop.binder, loop.iterable, loop.body)
		ForResourceSourceExpr(loop, typ, loc):
			count_loop_uses(name, loop.binder, loop.iterable, loop.body)
		ForTensorExpr(loop, typ, loc):
			count_loop_uses(name, loop.binder, loop.iterable, loop.body)
		PreClosureDetachExpr(detached, typ, loc):
			count_uses(name, detached.body)
		DetachExpr(detached, typ, loc):
			if detached.task.captures.any(func(capture): capture.name == name):
				1
			else:
				0
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			body_uses: Int = if loop.variable.name == name:
				0
			else:
				count_uses(name, loop.body)

			count_uses(
				name,
				loop.iterable,
			) + body_uses + count_optional_use(name, loop.timeout) + count_uses(name, loop.limit)
		ConcurrentlyLoopExpr(loop, typ, loc):
			body_uses: Int = if loop.variable.name == name:
				0
			else:
				count_uses(name, loop.body)

			count_uses(
				name,
				loop.iterable,
			) + body_uses + count_optional_use(name, loop.timeout) + count_uses(name, loop.limit)
		PreClosureConcurrentExpr(block, typ, loc):
			var rhs_uses: Int = 0
			var shadowed: Bool = False

			for binding in block.bindings:
				rhs_uses += count_uses(name, binding.rhs)

				if binding.variable.name == name:
					shadowed = True
				else:
					void

			body_uses: Int = if shadowed:
				0
			else:
				count_uses(name, block.body)

			rhs_uses + body_uses + count_optional_use(name, block.timeout)
		ConcurrentExpr(block, typ, loc):
			var rhs_uses: Int = 0
			var shadowed: Bool = False

			for binding in block.bindings:
				rhs_uses += count_uses(name, binding.rhs)

				if binding.variable.name == name:
					shadowed = True
				else:
					void

			body_uses: Int = if shadowed:
				0
			else:
				count_uses(name, block.body)

			rhs_uses + body_uses + count_optional_use(name, block.timeout)
		SelectExpr(select_expr, typ, loc):
			var wait_uses: Int = 0
			var branch_uses: Int = 0

			for arm in select_expr.arms:
				arm_shadows: Bool = match arm.kind:
					SelectRecvArm(recv):
						wait_uses += count_uses(name, recv.channel)
						recv.binder.name == name
					SelectSealedArm(channel):
						wait_uses += count_uses(name, channel)
						False
					SelectAfterArm(timeout):
						wait_uses += count_uses(name, timeout)
						False

				if not arm_shadows:
					branch_uses = max_int(
						branch_uses,
						count_uses(name, arm.body),
					)
				else:
					void

			wait_uses + branch_uses
		ListHandoffExpr(handoff, typ, loc):
			body_shadowed: Bool = (
				handoff.source_var.name == name
				or handoff.result_var.name == name
				or handoff.len_var.name == name
				or handoff.out_var.name == name
			)

			body_uses: Int = if body_shadowed:
				0
			else:
				count_uses(name, handoff.body)

			count_uses(name, handoff.source) + count_uses(name, handoff.capacity) + body_uses
		_:
			0


private pure func exprs_are_linear(exprs: List[CoreExpr]) -> Bool:
	var linear: Bool = True

	for expr in exprs:
		if not is_linear(expr):
			linear = False
			break
		else:
			void

	linear


private pure func boxed_values_are_linear(values: List[CoreBoxedStorageValue]) -> Bool:
	var linear: Bool = True

	for value in values:
		if not is_linear(value.value):
			linear = False
			break
		else:
			void

	linear


private pure func record_fields_are_linear(fields: List[CoreRecordFieldValue]) -> Bool:
	fields.all(func(field): is_linear(field.value))


private pure func dict_entries_are_linear(entries: List[CoreDictEntry]) -> Bool:
	entries.all(func(entry): is_linear(entry.key.value) and is_linear(entry.value.value))


pure func is_linear(expr: CoreExpr) -> Bool:
	match expr:
		IfExpr(cond, then_expr, else_expr, typ, loc):
			False
		WhileExpr(cond, body, typ, loc):
			False
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			False
		LiteralExpr(literal, typ, loc):
			True
		VarExpr(variable, typ, loc):
			True
		VoidExpr(typ, loc):
			True
		CallExpr(kind, callee, args, typ, loc):
			is_linear(callee) and exprs_are_linear(args)
		BinaryExpr(op, left, right, typ, loc):
			is_linear(left) and is_linear(right)
		UnaryExpr(op, inner, typ, loc):
			is_linear(inner)
		LogicalExpr(op, left, right, typ, loc):
			is_linear(left) and is_linear(right)
		AssignExpr(variable, rhs, typ, loc):
			is_linear(rhs)
		CastExpr(inner, typ, loc):
			is_linear(inner)
		BoxExpr(box_op, typ, loc):
			is_linear(box_op.value)
		UnboxExpr(kind, inner, typ, loc):
			is_linear(inner)
		FieldExpr(owner, field, typ, loc):
			is_linear(owner)
		TupleExpr(items, typ, loc):
			exprs_are_linear(items)
		VectorExpr(items, typ, loc):
			exprs_are_linear(items)
		RecordExpr(fields, typ, loc):
			record_fields_are_linear(fields)
		RecordConstructExpr(type_name, fields, typ, loc):
			record_fields_are_linear(fields)
		ListConstructExpr(construct, typ, loc):
			boxed_values_are_linear(construct.elements)
		TensorBoxedLiteralExpr(literal, typ, loc):
			boxed_values_are_linear(literal.elements)
		DictConstructExpr(construct, typ, loc):
			dict_entries_are_linear(construct.entries)
		UnionConstructExpr(construct, typ, loc):
			boxed_values_are_linear(construct.args)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			is_linear(body)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			is_linear(body)
		LetExpr(variable, is_mutable, typ, rhs, body):
			is_linear(rhs) and is_linear(body)
		BorrowLetExpr(variable, typ, rhs, body):
			is_linear(rhs) and is_linear(body)
		SeqExpr(first, second):
			is_linear(first) and is_linear(second)
		_:
			False


private pure func prepend_dups(
	count: Int,
	variable: CoreVar,
	value_type: CoreType,
	body: CoreExpr,
) -> CoreExpr:
	var result: CoreExpr = body
	var remaining: Int = count

	while remaining > 0:
		result_type: CoreType = expr_result_type(result)
		result = DupExpr(
			copy_core_var(variable),
			copy_core_type(value_type),
			retain_policy_for_type(value_type),
			result,
			result_type,
			SyntheticSourceLoc,
		)
		remaining -= 1

	result


private pure func prepend_drops(
	count: Int,
	variable: CoreVar,
	value_type: CoreType,
	body: CoreExpr,
) -> CoreExpr:
	var result: CoreExpr = body
	var remaining: Int = count

	while remaining > 0:
		result_type: CoreType = expr_result_type(result)
		result = DropExpr(
			copy_core_var(variable),
			copy_core_type(value_type),
			release_policy_for_type(value_type),
			result,
			result_type,
			SyntheticSourceLoc,
		)
		remaining -= 1

	result


private pure func is_void_core_type(typ: CoreType) -> Bool:
	match typ:
		VoidType:
			True
		NamedType(name, args):
			False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		HeapRecordType(name):
			False
		UnionType(name):
			False
		RangeType:
			False
		TensorType(info):
			False
		TupleType(items):
			False


private pure func drop_temp_var(variable: CoreVar) -> CoreVar:
	{
		name = "__cdrop_${variable.name}",
		uniq = 0,
		def_id = None
	}


private pure func drop_after_body(
	count: Int,
	variable: CoreVar,
	value_type: CoreType,
	body: CoreExpr,
) -> CoreExpr:
	if count <= 0:
		body
	else:
		body_type: CoreType = expr_result_type(body)

		if is_void_core_type(body_type):
			SeqExpr(
				body,
				prepend_drops(
					count,
					variable,
					value_type,
					VoidExpr(VoidType, SyntheticSourceLoc),
				),
			)
		else:
			tmp_var: CoreVar = drop_temp_var(variable)
			tmp_ref: CoreExpr = VarExpr(
				copy_core_var(tmp_var),
				copy_core_type(body_type),
				SyntheticSourceLoc,
			)
			drop_then_return: CoreExpr = prepend_drops(count, variable, value_type, tmp_ref)

			LetExpr(tmp_var, False, copy_core_type(body_type), body, drop_then_return)


private pure func constructor_match_has_divergent_use_counts(
	name: String,
	cases: List[CoreConstructorMatchCase],
	fallback: CoreConstructorMatchFallback,
) -> Bool:
	var baseline: Option[Int] = None
	var divergent: Bool = False
	var analyzable: Bool = True

	for match_case in cases:
		match match_case.body:
			ConstructorMatchBodyExpr(body):
				uses: Int = if match_bindings_shadow(name, match_case.bindings):
					0
				else:
					count_uses(name, body)

				match baseline:
					Some(reference):
						if reference != uses:
							divergent = True
							break
						else:
							void
					None:
						baseline = Some(uses)
			_:
				analyzable = False
				break

	if analyzable and not divergent:
		fallback_uses: Option[Int] = match fallback:
			ConstructorMatchFallbackBody(body):
				Some(count_uses(name, body))
			ConstructorMatchFallbackBindings(bindings, body):
				if match_bindings_shadow(name, bindings):
					Some(0)
				else:
					Some(count_uses(name, body))
			ConstructorMatchFallbackFail:
				None

		match fallback_uses:
			Some(uses):
				match baseline:
					Some(reference):
						divergent = reference != uses
					None:
						void
			None:
				void

	analyzable and divergent


private pure func balanced_path_has_divergent_constructor_match(
	name: String,
	expr: CoreExpr,
) -> Bool:
	match expr:
		SeqExpr(first, second):
			balanced_path_has_divergent_constructor_match(name, second)
		LetExpr(variable, is_mutable, typ, rhs, body):
			variable.name != name and balanced_path_has_divergent_constructor_match(name, body)
		BorrowLetExpr(variable, typ, rhs, body):
			variable.name != name and balanced_path_has_divergent_constructor_match(name, body)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			balanced_path_has_divergent_constructor_match(name, body)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			balanced_path_has_divergent_constructor_match(name, body)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			(
				balanced_path_has_divergent_constructor_match(name, then_expr)
				or balanced_path_has_divergent_constructor_match(name, else_expr)
			)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			constructor_match_has_divergent_use_counts(name, cases, fallback)
		_:
			False


private pure func balance_terminal_branch_body(
	variable: CoreVar,
	value_type: CoreType,
	available_refs: Int,
	uses: OwnershipUseSummary,
	body: CoreExpr,
) -> CoreExpr:
	pre_drops: Int = max_int(0, available_refs - uses.required_refs)

	if uses.returns_alias:
		prepend_drops(pre_drops, variable, value_type, body)
	else:
		post_drops: Int = max_int(0, uses.required_refs - uses.consumed_refs)
		balanced_body: CoreExpr = drop_after_body(post_drops, variable, value_type, body)

		prepend_drops(pre_drops, variable, value_type, balanced_body)


private pure func match_branch_uses_borrowed_binding(
	bindings: List[CoreMatchBinding],
	body: CoreExpr,
) -> Bool:
	var uses_borrowed_binding: Bool = False

	for binding in bindings:
		if binding.mode == MatchBorrowBindingMode and count_uses(binding.variable.name, body) > 0:
			uses_borrowed_binding = True
			break
		else:
			void

	uses_borrowed_binding


private pure func constructor_match_body_uses_borrowed_binding(
	bindings: List[CoreMatchBinding],
	body: CoreConstructorMatchBody,
) -> Bool:
	var uses_borrowed_binding: Bool = False

	for binding in bindings:
		if (
			binding.mode == MatchBorrowBindingMode
			and count_uses_in_constructor_match_body(binding.variable.name, body) > 0
		):
			uses_borrowed_binding = True
			break
		else:
			void

	uses_borrowed_binding


-- A borrowed payload aliases the matched owner until the payload is retained.
-- Model that dependency at the end of the branch so an earlier owner consume
-- reserves a second reference, and keep balancing from moving the final owner
-- drop inside control flow ahead of the payload use.
private pure func balance_borrowed_match_branch_body(
	env: PerceusEnv,
	variable: CoreVar,
	value_type: CoreType,
	available_refs: Int,
	uses_borrowed_binding: Bool,
	body: CoreExpr,
) -> CoreExpr:
	body_uses: OwnershipUseSummary = summarize_linear_ownership_uses(env, variable.name, body)

	if uses_borrowed_binding:
		branch_uses: OwnershipUseSummary = ownership_uses_with_returns_alias(
			seq_ownership_uses(body_uses, BORROW_OWNERSHIP_USE),
			body_uses.returns_alias,
		)

		balance_terminal_branch_body(variable, value_type, available_refs, branch_uses, body)
	else:
		balance_branch_body(env, variable, value_type, available_refs, body_uses, body)


private pure func balance_terminal_constructor_match(
	env: PerceusEnv,
	variable: CoreVar,
	value_type: CoreType,
	available_refs: Int,
	scrutinee: CoreExpr,
	release_policy: CoreReleasePolicy,
	cases: List[CoreConstructorMatchCase],
	fallback: CoreConstructorMatchFallback,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreExpr]:
	var can_balance: Bool = True

	for match_case in cases:
		if match_bindings_shadow(variable.name, match_case.bindings):
			can_balance = False
			break
		else:
			match match_case.body:
				ConstructorMatchBodyExpr(leaf):
					void
				_:
					can_balance = False
					break

	if can_balance:
		match fallback:
			ConstructorMatchFallbackBindings(bindings, leaf):
				if match_bindings_shadow(variable.name, bindings):
					can_balance = False
				else:
					void
			_:
				void

	if not can_balance:
		None
	else:
		scrutinee_is_direct_alias: Bool = direct_aliases_name(variable.name, scrutinee)

		scrutinee_consumed_refs: Int = if scrutinee_is_direct_alias:
			0
		else:
			summarize_linear_ownership_uses(env, variable.name, scrutinee).consumed_refs

		available_after_scrutinee: Int = max_int(0, available_refs - scrutinee_consumed_refs)
		var balanced_cases: List[CoreConstructorMatchCase] = []

		for match_case in cases:
			match match_case.body:
				ConstructorMatchBodyExpr(leaf):
					uses_borrowed_binding: Bool = (
						scrutinee_is_direct_alias
						and match_branch_uses_borrowed_binding(match_case.bindings, leaf)
					)

					balanced_cases = balanced_cases.append(
						{ match_case |
							body = ConstructorMatchBodyExpr(
								balance_borrowed_match_branch_body(
									env,
									copy_core_var(variable),
									copy_core_type(value_type),
									available_after_scrutinee,
									uses_borrowed_binding,
									leaf,
								),
							)
						},
					)
				_:
					balanced_cases = balanced_cases.append(match_case)

		balanced_fallback: CoreConstructorMatchFallback = match fallback:
			ConstructorMatchFallbackBody(leaf):
				leaf_uses: OwnershipUseSummary = summarize_linear_ownership_uses(
					env,
					variable.name,
					leaf,
				)

				ConstructorMatchFallbackBody(
					balance_branch_body(
						env,
						copy_core_var(variable),
						copy_core_type(value_type),
						available_after_scrutinee,
						leaf_uses,
						leaf,
					),
				)
			ConstructorMatchFallbackBindings(bindings, leaf):
				uses_borrowed_binding: Bool = (
					scrutinee_is_direct_alias
					and match_branch_uses_borrowed_binding(bindings, leaf)
				)

				ConstructorMatchFallbackBindings(
					bindings,
					balance_borrowed_match_branch_body(
						env,
						copy_core_var(variable),
						copy_core_type(value_type),
						available_after_scrutinee,
						uses_borrowed_binding,
						leaf,
					),
				)
			ConstructorMatchFallbackFail:
				ConstructorMatchFallbackFail

		Some(
			ConstructorMatchExpr(
				scrutinee,
				release_policy,
				balanced_cases,
				balanced_fallback,
				copy_core_type(typ),
				loc,
			),
		)


private pure func balance_branch_body(
	env: PerceusEnv,
	variable: CoreVar,
	value_type: CoreType,
	available_refs: Int,
	uses: OwnershipUseSummary,
	body: CoreExpr,
) -> CoreExpr:
	pre_drops: Int = max_int(0, available_refs - uses.required_refs)
	live_refs: Int = max_int(0, available_refs - pre_drops)

	match balance_nested_branch_body(
		env,
		copy_core_var(variable),
		copy_core_type(value_type),
		live_refs,
		body,
	):
		Some(balanced_body):
			prepend_drops(pre_drops, variable, value_type, copy_expr(balanced_body))
		None:
			balance_terminal_branch_body(variable, value_type, available_refs, uses, body)


private pure func balance_nested_branch_body(
	env: PerceusEnv,
	variable: CoreVar,
	value_type: CoreType,
	available_refs: Int,
	body: CoreExpr,
) -> Option[CoreExpr]:
	match body:
		SeqExpr(first, second):
			first_uses: OwnershipUseSummary = summarize_linear_ownership_uses(
				env,
				variable.name,
				first,
			)
			available_after_first: Int = max_int(0, available_refs - first_uses.consumed_refs)

			match balance_nested_branch_body(
				env,
				variable,
				value_type,
				available_after_first,
				second,
			):
				Some(balanced_second):
					Some(SeqExpr(first, balanced_second))
				None:
					None
		LetExpr(inner_var, is_mutable, inner_type, rhs, inner_body):
			if inner_var.name == variable.name:
				None
			else:
				rhs_uses: OwnershipUseSummary = summarize_linear_ownership_uses(
					env,
					variable.name,
					rhs,
				)
				available_after_rhs: Int = max_int(0, available_refs - rhs_uses.consumed_refs)

				match balance_nested_branch_body(
					env,
					variable,
					value_type,
					available_after_rhs,
					inner_body,
				):
					Some(balanced_body):
						Some(LetExpr(inner_var, is_mutable, inner_type, rhs, balanced_body))
					None:
						None
		BorrowLetExpr(inner_var, inner_type, rhs, inner_body):
			if inner_var.name == variable.name:
				None
			else:
				rhs_uses: OwnershipUseSummary = summarize_linear_ownership_uses(
					env,
					variable.name,
					rhs,
				)
				available_after_rhs: Int = max_int(0, available_refs - rhs_uses.consumed_refs)

				match balance_nested_branch_body(
					env,
					variable,
					value_type,
					available_after_rhs,
					inner_body,
				):
					Some(balanced_body):
						Some(BorrowLetExpr(inner_var, inner_type, rhs, balanced_body))
					None:
						None
		DupExpr(inner_var, inner_type, retain_policy, inner_body, typ, loc):
			next_available: Int = if inner_var.name == variable.name:
				available_refs + 1
			else:
				available_refs

			match balance_nested_branch_body(env, variable, value_type, next_available, inner_body):
				Some(balanced_body):
					Some(
						DupExpr(
							inner_var,
							inner_type,
							retain_policy,
							balanced_body,
							copy_core_type(typ),
							loc,
						),
					)
				None:
					None
		DropExpr(inner_var, inner_type, release_policy, inner_body, typ, loc):
			next_available: Int = if inner_var.name == variable.name:
				max_int(0, available_refs - 1)
			else:
				available_refs

			match balance_nested_branch_body(env, variable, value_type, next_available, inner_body):
				Some(balanced_body):
					Some(
						DropExpr(
							inner_var,
							inner_type,
							release_policy,
							balanced_body,
							copy_core_type(typ),
							loc,
						),
					)
				None:
					None
		IfExpr(cond, then_expr, else_expr, typ, loc):
			cond_uses: OwnershipUseSummary = summarize_linear_ownership_uses(
				env,
				variable.name,
				cond,
			)
			then_uses: OwnershipUseSummary = summarize_linear_ownership_uses(
				env,
				variable.name,
				then_expr,
			)
			else_uses: OwnershipUseSummary = summarize_linear_ownership_uses(
				env,
				variable.name,
				else_expr,
			)
			available_after_cond: Int = max_int(0, available_refs - cond_uses.consumed_refs)

			Some(
				IfExpr(
					cond,
					balance_branch_body(
						env,
						copy_core_var(variable),
						copy_core_type(value_type),
						available_after_cond,
						then_uses,
						then_expr,
					),
					balance_branch_body(
						env,
						copy_core_var(variable),
						copy_core_type(value_type),
						available_after_cond,
						else_uses,
						else_expr,
					),
					copy_core_type(typ),
					loc,
				),
			)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			if (
				env.balance_nested_matches
				and literal_match_cases_can_balance(variable.name, cases)
				and literal_match_fallback_can_balance(variable.name, fallback)
			):
				scrutinee_uses: OwnershipUseSummary = summarize_linear_ownership_uses(
					env,
					variable.name,
					scrutinee,
				)
				available_after_scrutinee: Int = max_int(
					0,
					available_refs - scrutinee_uses.consumed_refs,
				)

				Some(
					LiteralMatchExpr(
						scrutinee,
						balance_literal_match_cases(
							env,
							copy_core_var(variable),
							copy_core_type(value_type),
							available_after_scrutinee,
							cases,
						),
						balance_literal_match_fallback(
							env,
							copy_core_var(variable),
							copy_core_type(value_type),
							available_after_scrutinee,
							fallback,
						),
						copy_core_type(typ),
						loc,
					),
				)
			else:
				None
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			if (
				env.balance_nested_matches
				and constructor_literal_match_can_balance(variable.name, match_expr)
			):
				scrutinee_uses: OwnershipUseSummary = summarize_linear_ownership_uses(
					env,
					variable.name,
					scrutinee,
				)
				available_after_scrutinee: Int = max_int(
					0,
					available_refs - scrutinee_uses.consumed_refs,
				)

				Some(
					AccessorLiteralMatchExpr(
						scrutinee,
						release_policy,
						balance_constructor_literal_match(
							env,
							copy_core_var(variable),
							copy_core_type(value_type),
							available_after_scrutinee,
							match_expr,
						),
						copy_core_type(typ),
						loc,
					),
				)
			else:
				None
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			if (
				env.balance_nested_matches
				and constructor_length_match_can_balance(variable.name, match_expr)
			):
				scrutinee_uses: OwnershipUseSummary = summarize_linear_ownership_uses(
					env,
					variable.name,
					scrutinee,
				)
				available_after_scrutinee: Int = max_int(
					0,
					available_refs - scrutinee_uses.consumed_refs,
				)

				Some(
					LengthMatchExpr(
						scrutinee,
						release_policy,
						balance_constructor_length_match(
							env,
							copy_core_var(variable),
							copy_core_type(value_type),
							available_after_scrutinee,
							match_expr,
						),
						copy_core_type(typ),
						loc,
					),
				)
			else:
				None
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			if env.balance_nested_matches:
				balance_terminal_constructor_match(
					env,
					variable,
					value_type,
					available_refs,
					scrutinee,
					release_policy,
					cases,
					fallback,
					typ,
					loc,
				)
			else:
				None
		_:
			None


private pure func transform_let_if_body(
	env: PerceusEnv,
	variable: CoreVar,
	value_type: CoreType,
	cond: CoreExpr,
	then_expr: CoreExpr,
	else_expr: CoreExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	cond_uses: OwnershipUseSummary = summarize_linear_ownership_uses(env, variable.name, cond)
	then_uses: OwnershipUseSummary = summarize_linear_ownership_uses(env, variable.name, then_expr)
	else_uses: OwnershipUseSummary = summarize_linear_ownership_uses(env, variable.name, else_expr)
	max_branch_required: Int = max_int(then_uses.required_refs, else_uses.required_refs)
	total_needed: Int = max_int(
		cond_uses.required_refs,
		cond_uses.consumed_refs + max_branch_required,
	)
	if_node: CoreExpr = IfExpr(cond, then_expr, else_expr, copy_core_type(typ), loc)

	if total_needed == 0:
		prepend_drops(1, variable, value_type, if_node)
	else:
		dups_count: Int = max_int(0, total_needed - 1)
		available_after_cond: Int = 1 + dups_count - cond_uses.consumed_refs
		balanced_if: CoreExpr = IfExpr(
			cond,
			balance_branch_body(
				env,
				copy_core_var(variable),
				copy_core_type(value_type),
				available_after_cond,
				then_uses,
				then_expr,
			),
			balance_branch_body(
				env,
				copy_core_var(variable),
				copy_core_type(value_type),
				available_after_cond,
				else_uses,
				else_expr,
			),
			copy_core_type(typ),
			loc,
		)
		prepend_dups(dups_count, variable, value_type, balanced_if)


private pure func perceus_shadow_var(
	target: CoreVar,
	binding: CoreMatchBinding,
	branch_index: Int,
	binding_index: Int,
) -> CoreVar:
	{
		name = "__perceus_shadow_${target.name}_${target.uniq}_${branch_index}_${binding_index}",
		uniq = binding.variable.uniq,
		def_id = binding.variable.def_id
	}


private pure func rename_shadow_var_refs_in_literal_case(
	old_name: String,
	new_var: CoreVar,
	match_case: CoreLiteralMatchCase,
) -> CoreLiteralMatchCase:
	if match_bindings_shadow(old_name, match_case.bindings):
		match_case
	else:
		{ match_case | body = rename_shadow_var_refs(old_name, new_var, match_case.body) }


private pure func rename_shadow_var_refs_in_literal_cases(
	old_name: String,
	new_var: CoreVar,
	cases: List[CoreLiteralMatchCase],
) -> List[CoreLiteralMatchCase]:
	var renamed: List[CoreLiteralMatchCase] = []

	for match_case in cases:
		renamed = renamed.append(
			rename_shadow_var_refs_in_literal_case(
				old_name,
				new_var,
				match_case,
			),
		)

	renamed


private pure func rename_shadow_var_refs_in_literal_fallback(
	old_name: String,
	new_var: CoreVar,
	fallback: CoreLiteralMatchFallback,
) -> CoreLiteralMatchFallback:
	match fallback:
		LiteralMatchFallbackBody(body):
			LiteralMatchFallbackBody(rename_shadow_var_refs(old_name, new_var, body))
		LiteralMatchFallbackBindings(bindings, body):
			if match_bindings_shadow(old_name, bindings):
				fallback
			else:
				LiteralMatchFallbackBindings(
					bindings,
					rename_shadow_var_refs(old_name, new_var, body),
				)
		LiteralMatchFallbackFail:
			LiteralMatchFallbackFail


private pure func rename_shadow_var_refs_in_literal_match(
	old_name: String,
	new_var: CoreVar,
	match_expr: CoreConstructorLiteralMatch,
) -> CoreConstructorLiteralMatch:
	{ match_expr |
		cases = rename_shadow_var_refs_in_literal_cases(old_name, new_var, match_expr.cases),
		fallback = rename_shadow_var_refs_in_literal_fallback(
			old_name,
			new_var,
			match_expr.fallback,
		)
	}


private pure func rename_shadow_var_refs_in_constructor_body(
	old_name: String,
	new_var: CoreVar,
	body: CoreConstructorMatchBody,
) -> CoreConstructorMatchBody:
	match body:
		ConstructorMatchBodyExpr(expr):
			ConstructorMatchBodyExpr(rename_shadow_var_refs(old_name, new_var, expr))
		ConstructorMatchBodyLiteral(match_expr):
			ConstructorMatchBodyLiteral(
				rename_shadow_var_refs_in_literal_match(
					old_name,
					new_var,
					match_expr,
				),
			)
		ConstructorMatchBodyLength(match_expr):
			ConstructorMatchBodyLength(
				rename_shadow_var_refs_in_length_match(
					old_name,
					new_var,
					match_expr,
				),
			)


private pure func rename_shadow_var_refs_in_length_branch(
	old_name: String,
	new_var: CoreVar,
	branch: CoreConstructorLengthMatchBranch,
) -> CoreConstructorLengthMatchBranch:
	if match_bindings_shadow(old_name, branch.bindings):
		branch
	else:
		{ branch |
			body = rename_shadow_var_refs_in_constructor_body(old_name, new_var, branch.body)
		}


private pure func rename_shadow_var_refs_in_length_match(
	old_name: String,
	new_var: CoreVar,
	match_expr: CoreConstructorLengthMatch,
) -> CoreConstructorLengthMatch:
	var renamed_cases: List[CoreConstructorLengthMatchCase] = []

	for match_case in match_expr.cases:
		renamed_cases = renamed_cases.append(
			{ match_case |
				branch = rename_shadow_var_refs_in_length_branch(
					old_name,
					new_var,
					match_case.branch,
				)
			},
		)

	renamed_geq: Option[CoreConstructorLengthMatchGeq] = match match_expr.geq:
		Some(match_case):
			Some(
				{ match_case |
					branch = rename_shadow_var_refs_in_length_branch(
						old_name,
						new_var,
						match_case.branch,
					)
				},
			)
		None:
			None

	renamed_fallback: Option[CoreConstructorLengthMatchBranch] = match match_expr.fallback:
		Some(branch):
			Some(rename_shadow_var_refs_in_length_branch(old_name, new_var, branch))
		None:
			None

	{ match_expr |
		cases = renamed_cases,
		geq = renamed_geq,
		fallback = renamed_fallback
	}


private pure func rename_shadow_var_refs_in_constructor_case(
	old_name: String,
	new_var: CoreVar,
	match_case: CoreConstructorMatchCase,
) -> CoreConstructorMatchCase:
	if match_bindings_shadow(old_name, match_case.bindings):
		match_case
	else:
		{ match_case |
			body = rename_shadow_var_refs_in_constructor_body(old_name, new_var, match_case.body)
		}


private pure func rename_shadow_var_refs_in_constructor_cases(
	old_name: String,
	new_var: CoreVar,
	cases: List[CoreConstructorMatchCase],
) -> List[CoreConstructorMatchCase]:
	var renamed: List[CoreConstructorMatchCase] = []

	for match_case in cases:
		renamed = renamed.append(
			rename_shadow_var_refs_in_constructor_case(
				old_name,
				new_var,
				match_case,
			),
		)

	renamed


private pure func rename_shadow_var_refs_in_constructor_fallback(
	old_name: String,
	new_var: CoreVar,
	fallback: CoreConstructorMatchFallback,
) -> CoreConstructorMatchFallback:
	match fallback:
		ConstructorMatchFallbackBody(body):
			ConstructorMatchFallbackBody(rename_shadow_var_refs(old_name, new_var, body))
		ConstructorMatchFallbackBindings(bindings, body):
			if match_bindings_shadow(old_name, bindings):
				fallback
			else:
				ConstructorMatchFallbackBindings(
					bindings,
					rename_shadow_var_refs(old_name, new_var, body),
				)
		ConstructorMatchFallbackFail:
			ConstructorMatchFallbackFail


private pure func rename_shadow_var_refs_in_optional_expr(
	old_name: String,
	new_var: CoreVar,
	expr: Option[CoreExpr],
) -> Option[CoreExpr]:
	match expr:
		Some(value):
			Some(rename_shadow_var_refs(old_name, new_var, value))
		None:
			None


private pure func rename_shadow_var_refs_in_loop_body(
	old_name: String,
	new_var: CoreVar,
	binder: CoreLoopBinder,
	body: CoreExpr,
) -> CoreExpr:
	if binder.variable.name == old_name:
		body
	else:
		rename_shadow_var_refs(old_name, new_var, body)


private pure func rename_shadow_var_refs_in_select_arm(
	old_name: String,
	new_var: CoreVar,
	arm: CoreSelectArm,
) -> CoreSelectArm:
	match arm.kind:
		SelectRecvArm(recv):
			renamed_body: CoreExpr = if recv.binder.name == old_name:
				arm.body
			else:
				rename_shadow_var_refs(old_name, new_var, arm.body)

			{ arm |
				kind = SelectRecvArm(
					{ recv | channel = rename_shadow_var_refs(old_name, new_var, recv.channel) },
				),
				body = renamed_body
			}
		SelectSealedArm(channel):
			{ arm |
				kind = SelectSealedArm(rename_shadow_var_refs(old_name, new_var, channel)),
				body = rename_shadow_var_refs(old_name, new_var, arm.body)
			}
		SelectAfterArm(timeout):
			{ arm |
				kind = SelectAfterArm(rename_shadow_var_refs(old_name, new_var, timeout)),
				body = rename_shadow_var_refs(old_name, new_var, arm.body)
			}


-- Keep recursive rewrite state in ordinary parameters. The pinned bootstrap
-- can release a captured CoreVar before a sibling record field is rewritten.
private pure func pre_closure_concurrent_bindings_shadow(
	old_name: String,
	bindings: List[CorePreClosureConcurrentBinding],
) -> Bool:
	var shadows: Bool = False

	for binding in bindings:
		if binding.variable.name == old_name:
			shadows = True
			break
		else:
			void

	shadows


private pure func concurrent_bindings_shadow(
	old_name: String,
	bindings: List[CoreConcurrentBinding],
) -> Bool:
	var shadows: Bool = False

	for binding in bindings:
		if binding.variable.name == old_name:
			shadows = True
			break
		else:
			void

	shadows


private pure func rename_shadow_var_refs_in_pre_closure_concurrent_bindings(
	old_name: String,
	new_var: CoreVar,
	bindings: List[CorePreClosureConcurrentBinding],
) -> List[CorePreClosureConcurrentBinding]:
	var renamed: List[CorePreClosureConcurrentBinding] = []

	for binding in bindings:
		renamed = renamed.append(
			{ binding | rhs = rename_shadow_var_refs(old_name, new_var, binding.rhs) },
		)

	renamed


private pure func rename_shadow_var_refs_in_concurrent_bindings(
	old_name: String,
	new_var: CoreVar,
	bindings: List[CoreConcurrentBinding],
) -> List[CoreConcurrentBinding]:
	var renamed: List[CoreConcurrentBinding] = []

	for binding in bindings:
		renamed = renamed.append(
			{ binding | rhs = rename_shadow_var_refs(old_name, new_var, binding.rhs) },
		)

	renamed


private pure func rename_shadow_var_refs_in_select_arms(
	old_name: String,
	new_var: CoreVar,
	arms: List[CoreSelectArm],
) -> List[CoreSelectArm]:
	var renamed: List[CoreSelectArm] = []

	for arm in arms:
		renamed = renamed.append(rename_shadow_var_refs_in_select_arm(old_name, new_var, arm))

	renamed


private pure func rename_shadow_var_refs(
	old_name: String,
	new_var: CoreVar,
	expr: CoreExpr,
) -> CoreExpr:
	match expr:
		VarExpr(variable, typ, loc):
			if variable.name == old_name:
				VarExpr(copy_core_var(new_var), copy_core_type(typ), loc)
			else:
				expr
		AssignExpr(variable, rhs, typ, loc):
			renamed_variable: CoreVar = if variable.name == old_name:
				copy_core_var(new_var)
			else:
				copy_core_var(variable)

			AssignExpr(
				renamed_variable,
				rename_shadow_var_refs(old_name, new_var, rhs),
				copy_core_type(typ),
				loc,
			)
		LetExpr(variable, is_mutable, typ, rhs, body):
			renamed_body: CoreExpr = if variable.name == old_name:
				body
			else:
				rename_shadow_var_refs(old_name, new_var, body)

			LetExpr(
				copy_core_var(variable),
				is_mutable,
				copy_core_type(typ),
				rename_shadow_var_refs(old_name, new_var, rhs),
				renamed_body,
			)
		BorrowLetExpr(variable, typ, rhs, body):
			renamed_body: CoreExpr = if variable.name == old_name:
				body
			else:
				rename_shadow_var_refs(old_name, new_var, body)

			BorrowLetExpr(
				copy_core_var(variable),
				copy_core_type(typ),
				rename_shadow_var_refs(old_name, new_var, rhs),
				renamed_body,
			)
		LambdaExpr(params, return_type, body, is_pure, typ, loc):
			if core_params_shadow(old_name, params):
				expr
			else:
				LambdaExpr(
					params,
					copy_core_type(return_type),
					rename_shadow_var_refs(old_name, new_var, body),
					is_pure,
					copy_core_type(typ),
					loc,
				)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			renamed_variable: CoreVar = if variable.name == old_name:
				copy_core_var(new_var)
			else:
				copy_core_var(variable)

			DupExpr(
				renamed_variable,
				copy_core_type(value_type),
				retain_policy,
				rename_shadow_var_refs(old_name, new_var, body),
				copy_core_type(typ),
				loc,
			)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			renamed_variable: CoreVar = if variable.name == old_name:
				copy_core_var(new_var)
			else:
				copy_core_var(variable)

			DropExpr(
				renamed_variable,
				copy_core_type(value_type),
				release_policy,
				rename_shadow_var_refs(old_name, new_var, body),
				copy_core_type(typ),
				loc,
			)
		TensorRawReadExpr(read, typ, loc):
			renamed_view: CoreVar = if read.view.name == old_name:
				copy_core_var(new_var)
			else:
				copy_core_var(read.view)

			TensorRawReadExpr(
				{ read |
					view = renamed_view,
					index = rename_shadow_var_refs(old_name, new_var, read.index)
				},
				copy_core_type(typ),
				loc,
			)
		TensorRawWriteExpr(write, typ, loc):
			renamed_view: CoreVar = if write.view.name == old_name:
				copy_core_var(new_var)
			else:
				copy_core_var(write.view)

			TensorRawWriteExpr(
				{ write |
					view = renamed_view,
					index = rename_shadow_var_refs(old_name, new_var, write.index),
					value = rename_shadow_var_refs(old_name, new_var, write.value)
				},
				copy_core_type(typ),
				loc,
			)
		TensorRawViewLetExpr(binding, body, typ, loc):
			renamed_body: CoreExpr = if binding.variable.name == old_name:
				body
			else:
				rename_shadow_var_refs(old_name, new_var, body)

			TensorRawViewLetExpr(
				{ binding | source = rename_shadow_var_refs(old_name, new_var, binding.source) },
				renamed_body,
				copy_core_type(typ),
				loc,
			)
		ListHandoffExpr(handoff, typ, loc):
			body_is_shadowed: Bool = (
				handoff.source_var.name == old_name
				or handoff.result_var.name == old_name
				or handoff.len_var.name == old_name
				or handoff.out_var.name == old_name
			)

			renamed_body: CoreExpr = if body_is_shadowed:
				handoff.body
			else:
				rename_shadow_var_refs(old_name, new_var, handoff.body)

			ListHandoffExpr(
				{ handoff |
					source = rename_shadow_var_refs(old_name, new_var, handoff.source),
					capacity = rename_shadow_var_refs(old_name, new_var, handoff.capacity),
					body = renamed_body
				},
				copy_core_type(typ),
				loc,
			)
		TailrecLoopExpr(params, return_type, body, loc):
			if core_params_shadow(old_name, params):
				expr
			else:
				TailrecLoopExpr(
					params,
					copy_core_type(return_type),
					rename_shadow_var_refs(old_name, new_var, body),
					loc,
				)
		TailrecListSpreadLoopExpr(loop, loc):
			body_is_shadowed: Bool = (
				core_params_shadow(old_name, loop.params)
				or loop.list_param.name.name == old_name
				or loop.cursor.name == old_name
			)

			if body_is_shadowed:
				expr
			else:
				TailrecListSpreadLoopExpr(
					{ loop | body = rename_shadow_var_refs(old_name, new_var, loop.body) },
					loc,
				)
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			ForRangeExpr(
				binder,
				rename_shadow_var_refs(old_name, new_var, start),
				rename_shadow_var_refs(old_name, new_var, end_value),
				rename_shadow_var_refs_in_loop_body(old_name, new_var, binder, body),
				copy_core_type(typ),
				loc,
			)
		ForChannelExpr(loop, typ, loc):
			ForChannelExpr(
				{ loop |
					iterable = rename_shadow_var_refs(old_name, new_var, loop.iterable),
					body = rename_shadow_var_refs_in_loop_body(
						old_name,
						new_var,
						loop.binder,
						loop.body,
					)
				},
				copy_core_type(typ),
				loc,
			)
		ForListExpr(loop, typ, loc):
			ForListExpr(
				{ loop |
					iterable = rename_shadow_var_refs(old_name, new_var, loop.iterable),
					body = rename_shadow_var_refs_in_loop_body(
						old_name,
						new_var,
						loop.binder,
						loop.body,
					)
				},
				copy_core_type(typ),
				loc,
			)
		ForStringExpr(loop, typ, loc):
			ForStringExpr(
				{ loop |
					iterable = rename_shadow_var_refs(old_name, new_var, loop.iterable),
					body = rename_shadow_var_refs_in_loop_body(
						old_name,
						new_var,
						loop.binder,
						loop.body,
					)
				},
				copy_core_type(typ),
				loc,
			)
		ForDictExpr(loop, typ, loc):
			ForDictExpr(
				{ loop |
					iterable = rename_shadow_var_refs(old_name, new_var, loop.iterable),
					body = rename_shadow_var_refs_in_loop_body(
						old_name,
						new_var,
						loop.binder,
						loop.body,
					)
				},
				copy_core_type(typ),
				loc,
			)
		ForSetExpr(loop, typ, loc):
			ForSetExpr(
				{ loop |
					iterable = rename_shadow_var_refs(old_name, new_var, loop.iterable),
					body = rename_shadow_var_refs_in_loop_body(
						old_name,
						new_var,
						loop.binder,
						loop.body,
					)
				},
				copy_core_type(typ),
				loc,
			)
		ForStreamExpr(loop, typ, loc):
			ForStreamExpr(
				{ loop |
					iterable = rename_shadow_var_refs(old_name, new_var, loop.iterable),
					body = rename_shadow_var_refs_in_loop_body(
						old_name,
						new_var,
						loop.binder,
						loop.body,
					)
				},
				copy_core_type(typ),
				loc,
			)
		ForResourceSourceExpr(loop, typ, loc):
			ForResourceSourceExpr(
				{ loop |
					iterable = rename_shadow_var_refs(old_name, new_var, loop.iterable),
					body = rename_shadow_var_refs_in_loop_body(
						old_name,
						new_var,
						loop.binder,
						loop.body,
					)
				},
				copy_core_type(typ),
				loc,
			)
		ForTensorExpr(loop, typ, loc):
			ForTensorExpr(
				{ loop |
					iterable = rename_shadow_var_refs(old_name, new_var, loop.iterable),
					body = rename_shadow_var_refs_in_loop_body(
						old_name,
						new_var,
						loop.binder,
						loop.body,
					)
				},
				copy_core_type(typ),
				loc,
			)
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			renamed_body: CoreExpr = if loop.variable.name == old_name:
				loop.body
			else:
				rename_shadow_var_refs(old_name, new_var, loop.body)

			PreClosureConcurrentlyLoopExpr(
				{ loop |
					iterable = rename_shadow_var_refs(old_name, new_var, loop.iterable),
					body = renamed_body,
					timeout = rename_shadow_var_refs_in_optional_expr(
						old_name,
						new_var,
						loop.timeout,
					),
					limit = rename_shadow_var_refs(old_name, new_var, loop.limit)
				},
				copy_core_type(typ),
				loc,
			)
		ConcurrentlyLoopExpr(loop, typ, loc):
			renamed_body: CoreExpr = if loop.variable.name == old_name:
				loop.body
			else:
				rename_shadow_var_refs(old_name, new_var, loop.body)

			ConcurrentlyLoopExpr(
				{ loop |
					iterable = rename_shadow_var_refs(old_name, new_var, loop.iterable),
					body = renamed_body,
					timeout = rename_shadow_var_refs_in_optional_expr(
						old_name,
						new_var,
						loop.timeout,
					),
					limit = rename_shadow_var_refs(old_name, new_var, loop.limit)
				},
				copy_core_type(typ),
				loc,
			)
		PreClosureConcurrentExpr(block, typ, loc):
			body_is_shadowed: Bool = pre_closure_concurrent_bindings_shadow(
				old_name,
				block.bindings,
			)

			renamed_body: CoreExpr = if body_is_shadowed:
				block.body
			else:
				rename_shadow_var_refs(old_name, new_var, block.body)

			PreClosureConcurrentExpr(
				{ block |
					bindings = rename_shadow_var_refs_in_pre_closure_concurrent_bindings(
						old_name,
						new_var,
						block.bindings,
					),
					body = renamed_body,
					timeout = rename_shadow_var_refs_in_optional_expr(
						old_name,
						new_var,
						block.timeout,
					)
				},
				copy_core_type(typ),
				loc,
			)
		ConcurrentExpr(block, typ, loc):
			body_is_shadowed: Bool = concurrent_bindings_shadow(old_name, block.bindings)

			renamed_body: CoreExpr = if body_is_shadowed:
				block.body
			else:
				rename_shadow_var_refs(old_name, new_var, block.body)

			ConcurrentExpr(
				{ block |
					bindings = rename_shadow_var_refs_in_concurrent_bindings(
						old_name,
						new_var,
						block.bindings,
					),
					body = renamed_body,
					timeout = rename_shadow_var_refs_in_optional_expr(
						old_name,
						new_var,
						block.timeout,
					)
				},
				copy_core_type(typ),
				loc,
			)
		SelectExpr(select_expr, typ, loc):
			SelectExpr(
				{ select_expr |
					arms = rename_shadow_var_refs_in_select_arms(
						old_name,
						new_var,
						select_expr.arms,
					)
				},
				copy_core_type(typ),
				loc,
			)
		ResourceScopeExpr(scope, typ, loc):
			renamed_body: CoreExpr = if scope.variable.name == old_name:
				scope.body
			else:
				rename_shadow_var_refs(old_name, new_var, scope.body)

			renamed_cleanup: CoreExpr = if scope.variable.name == old_name:
				scope.cleanup
			else:
				rename_shadow_var_refs(old_name, new_var, scope.cleanup)

			ResourceScopeExpr(
				{ scope |
					acquire = rename_shadow_var_refs(old_name, new_var, scope.acquire),
					body = renamed_body,
					cleanup = renamed_cleanup
				},
				copy_core_type(typ),
				loc,
			)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			LiteralMatchExpr(
				rename_shadow_var_refs(old_name, new_var, scrutinee),
				rename_shadow_var_refs_in_literal_cases(old_name, new_var, cases),
				rename_shadow_var_refs_in_literal_fallback(old_name, new_var, fallback),
				copy_core_type(typ),
				loc,
			)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			AccessorLiteralMatchExpr(
				rename_shadow_var_refs(old_name, new_var, scrutinee),
				release_policy,
				rename_shadow_var_refs_in_literal_match(old_name, new_var, match_expr),
				copy_core_type(typ),
				loc,
			)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			LengthMatchExpr(
				rename_shadow_var_refs(old_name, new_var, scrutinee),
				release_policy,
				rename_shadow_var_refs_in_length_match(old_name, new_var, match_expr),
				copy_core_type(typ),
				loc,
			)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			ConstructorMatchExpr(
				rename_shadow_var_refs(old_name, new_var, scrutinee),
				release_policy,
				rename_shadow_var_refs_in_constructor_cases(old_name, new_var, cases),
				rename_shadow_var_refs_in_constructor_fallback(old_name, new_var, fallback),
				copy_core_type(typ),
				loc,
			)
		_:
			CoreTraverse.map_core_expr_children(expr, pure func(child): rename_shadow_var_refs(
					old_name.substring(0, old_name.length()),
					copy_core_var(new_var),
					child,
				))


private pure func freshen_match_bindings_in_constructor_body(
	target: CoreVar,
	bindings: List[CoreMatchBinding],
	body: CoreConstructorMatchBody,
	branch_index: Int,
) -> FreshenedConstructorMatchBindingBody:
	var freshened_bindings: List[CoreMatchBinding] = []
	var freshened_body: CoreConstructorMatchBody = body
	var binding_index: Int = 0

	for binding in bindings:
		if binding.variable.name == target.name:
			shadow: CoreVar = perceus_shadow_var(target, binding, branch_index, binding_index)
			freshened_bindings = freshened_bindings.append({ binding | variable = shadow })
			freshened_body = rename_shadow_var_refs_in_constructor_body(
				target.name,
				shadow,
				freshened_body,
			)
		else:
			freshened_bindings = freshened_bindings.append(binding)

		binding_index += 1

	{
		bindings = freshened_bindings,
		body = freshened_body
	}


private pure func freshen_constructor_match_case_shadow(
	target: CoreVar,
	match_case: CoreConstructorMatchCase,
	branch_index: Int,
) -> CoreConstructorMatchCase:
	freshened: FreshenedConstructorMatchBindingBody = freshen_match_bindings_in_constructor_body(
		target,
		match_case.bindings,
		match_case.body,
		branch_index,
	)

	{ match_case |
		bindings = freshened.bindings,
		body = freshen_shadowed_match_bindings_in_constructor_body(target, freshened.body)
	}


private pure func freshen_constructor_match_case_shadows(
	target: CoreVar,
	cases: List[CoreConstructorMatchCase],
) -> List[CoreConstructorMatchCase]:
	var freshened: List[CoreConstructorMatchCase] = []
	var branch_index: Int = 0

	for match_case in cases:
		freshened = freshened.append(
			freshen_constructor_match_case_shadow(
				target,
				match_case,
				branch_index,
			),
		)
		branch_index += 1

	freshened


private pure func freshen_constructor_match_fallback_shadow(
	target: CoreVar,
	branch_index: Int,
	fallback: CoreConstructorMatchFallback,
) -> CoreConstructorMatchFallback:
	match fallback:
		ConstructorMatchFallbackBody(body):
			ConstructorMatchFallbackBody(freshen_shadowed_match_bindings(target, body))
		ConstructorMatchFallbackBindings(bindings, body):
			var freshened_bindings: List[CoreMatchBinding] = []
			var freshened_body: CoreExpr = body
			var binding_index: Int = 0

			for binding in bindings:
				if binding.variable.name == target.name:
					shadow: CoreVar = perceus_shadow_var(
						target,
						binding,
						branch_index,
						binding_index,
					)
					freshened_bindings = freshened_bindings.append({ binding | variable = shadow })
					freshened_body = rename_shadow_var_refs(target.name, shadow, freshened_body)
				else:
					freshened_bindings = freshened_bindings.append(binding)

				binding_index += 1

			ConstructorMatchFallbackBindings(
				freshened_bindings,
				freshen_shadowed_match_bindings(target, freshened_body),
			)
		ConstructorMatchFallbackFail:
			ConstructorMatchFallbackFail


private pure func freshen_shadowed_match_bindings_in_constructor_body(
	target: CoreVar,
	body: CoreConstructorMatchBody,
) -> CoreConstructorMatchBody:
	match body:
		ConstructorMatchBodyExpr(expr):
			ConstructorMatchBodyExpr(freshen_shadowed_match_bindings(target, expr))
		ConstructorMatchBodyLiteral(match_expr):
			ConstructorMatchBodyLiteral(match_expr)
		ConstructorMatchBodyLength(match_expr):
			ConstructorMatchBodyLength(match_expr)


private pure func freshen_shadowed_match_bindings(target: CoreVar, expr: CoreExpr) -> CoreExpr:
	match expr:
		LetExpr(variable, is_mutable, typ, rhs, body):
			freshened_body: CoreExpr = if variable.name == target.name:
				body
			else:
				freshen_shadowed_match_bindings(target, body)

			LetExpr(
				copy_core_var(variable),
				is_mutable,
				copy_core_type(typ),
				freshen_shadowed_match_bindings(target, rhs),
				freshened_body,
			)
		BorrowLetExpr(variable, typ, rhs, body):
			freshened_body: CoreExpr = if variable.name == target.name:
				body
			else:
				freshen_shadowed_match_bindings(target, body)

			BorrowLetExpr(
				copy_core_var(variable),
				copy_core_type(typ),
				freshen_shadowed_match_bindings(target, rhs),
				freshened_body,
			)
		LambdaExpr(params, return_type, body, is_pure, typ, loc):
			if core_params_shadow(target.name, params):
				expr
			else:
				LambdaExpr(
					params,
					copy_core_type(return_type),
					freshen_shadowed_match_bindings(target, body),
					is_pure,
					copy_core_type(typ),
					loc,
				)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			ConstructorMatchExpr(
				freshen_shadowed_match_bindings(target, scrutinee),
				release_policy,
				freshen_constructor_match_case_shadows(target, cases),
				freshen_constructor_match_fallback_shadow(target, cases.length(), fallback),
				copy_core_type(typ),
				loc,
			)
		_:
			CoreTraverse.map_core_expr_children(
				expr,
				pure func(child): freshen_shadowed_match_bindings(copy_core_var(target), child),
			)


private pure func literal_match_case_can_balance(
	name: String,
	match_case: CoreLiteralMatchCase,
) -> Bool:
	not match_bindings_shadow(name, match_case.bindings)


private pure func literal_match_cases_can_balance(
	name: String,
	cases: List[CoreLiteralMatchCase],
) -> Bool:
	cases.all(func(match_case): literal_match_case_can_balance(name, match_case))


private pure func literal_match_fallback_can_balance(
	name: String,
	fallback: CoreLiteralMatchFallback,
) -> Bool:
	match fallback:
		LiteralMatchFallbackBody(body):
			True
		LiteralMatchFallbackBindings(bindings, body):
			not match_bindings_shadow(name, bindings)
		LiteralMatchFallbackFail:
			True


private pure func constructor_literal_match_can_balance(
	name: String,
	match_expr: CoreConstructorLiteralMatch,
) -> Bool:
	(
		literal_match_cases_can_balance(name, match_expr.cases)
		and literal_match_fallback_can_balance(name, match_expr.fallback)
	)


private pure func literal_match_case_required(
	env: PerceusEnv,
	name: String,
	match_case: CoreLiteralMatchCase,
) -> Int:
	if match_bindings_shadow(name, match_case.bindings):
		0
	else:
		summarize_linear_ownership_uses(env, name, match_case.body).required_refs


private pure func literal_match_cases_max_required(
	env: PerceusEnv,
	name: String,
	cases: List[CoreLiteralMatchCase],
) -> Int:
	var required: Int = 0

	for match_case in cases:
		required = max_int(
			required,
			literal_match_case_required(env, name, match_case),
		)

	required


private pure func literal_match_fallback_required(
	env: PerceusEnv,
	name: String,
	fallback: CoreLiteralMatchFallback,
) -> Int:
	match fallback:
		LiteralMatchFallbackBody(body):
			summarize_linear_ownership_uses(env, name, body).required_refs
		LiteralMatchFallbackBindings(bindings, body):
			if match_bindings_shadow(name, bindings):
				0
			else:
				summarize_linear_ownership_uses(env, name, body).required_refs
		LiteralMatchFallbackFail:
			0


private pure func constructor_literal_match_required(
	env: PerceusEnv,
	name: String,
	match_expr: CoreConstructorLiteralMatch,
) -> Int:
	max_int(
		literal_match_cases_max_required(env, name, match_expr.cases),
		literal_match_fallback_required(env, name, match_expr.fallback),
	)


private pure func balance_literal_match_case(
	env: PerceusEnv,
	variable: CoreVar,
	value_type: CoreType,
	available_refs: Int,
	match_case: CoreLiteralMatchCase,
) -> CoreLiteralMatchCase:
	uses: OwnershipUseSummary = summarize_linear_ownership_uses(env, variable.name, match_case.body)

	{ match_case |
		body = balance_branch_body(env, variable, value_type, available_refs, uses, match_case.body)
	}


private pure func balance_literal_match_cases(
	env: PerceusEnv,
	variable: CoreVar,
	value_type: CoreType,
	available_refs: Int,
	cases: List[CoreLiteralMatchCase],
) -> List[CoreLiteralMatchCase]:
	var balanced: List[CoreLiteralMatchCase] = []

	for match_case in cases:
		balanced = balanced.append(
			balance_literal_match_case(
				env,
				copy_core_var(variable),
				copy_core_type(value_type),
				available_refs,
				match_case,
			),
		)

	balanced


private pure func balance_literal_match_fallback(
	env: PerceusEnv,
	variable: CoreVar,
	value_type: CoreType,
	available_refs: Int,
	fallback: CoreLiteralMatchFallback,
) -> CoreLiteralMatchFallback:
	match fallback:
		LiteralMatchFallbackBody(body):
			uses: OwnershipUseSummary = summarize_linear_ownership_uses(env, variable.name, body)
			LiteralMatchFallbackBody(
				balance_branch_body(
					env,
					variable,
					value_type,
					available_refs,
					uses,
					body,
				),
			)
		LiteralMatchFallbackBindings(bindings, body):
			uses: OwnershipUseSummary = summarize_linear_ownership_uses(env, variable.name, body)
			LiteralMatchFallbackBindings(
				bindings,
				balance_branch_body(env, variable, value_type, available_refs, uses, body),
			)
		LiteralMatchFallbackFail:
			LiteralMatchFallbackFail


private pure func balance_constructor_literal_match(
	env: PerceusEnv,
	variable: CoreVar,
	value_type: CoreType,
	available_refs: Int,
	match_expr: CoreConstructorLiteralMatch,
) -> CoreConstructorLiteralMatch:
	{ match_expr |
		cases = balance_literal_match_cases(
			env,
			copy_core_var(variable),
			copy_core_type(value_type),
			available_refs,
			match_expr.cases,
		),
		fallback = balance_literal_match_fallback(
			env,
			copy_core_var(variable),
			copy_core_type(value_type),
			available_refs,
			match_expr.fallback,
		)
	}


private pure func constructor_match_body_can_balance(
	name: String,
	body: CoreConstructorMatchBody,
) -> Bool:
	match body:
		ConstructorMatchBodyExpr(expr):
			True
		ConstructorMatchBodyLiteral(match_expr):
			constructor_literal_match_can_balance(name, match_expr)
		ConstructorMatchBodyLength(match_expr):
			constructor_length_match_can_balance(name, match_expr)


private pure func constructor_length_branch_can_balance(
	name: String,
	branch: CoreConstructorLengthMatchBranch,
) -> Bool:
	(
		not match_bindings_shadow(name, branch.bindings)
		and constructor_match_body_can_balance(name, branch.body)
	)


private pure func constructor_length_cases_can_balance(
	name: String,
	cases: List[CoreConstructorLengthMatchCase],
) -> Bool:
	cases.all(func(match_case): constructor_length_branch_can_balance(name, match_case.branch))


private pure func constructor_length_geq_can_balance(
	name: String,
	geq: Option[CoreConstructorLengthMatchGeq],
) -> Bool:
	match geq:
		Some(match_case):
			constructor_length_branch_can_balance(name, match_case.branch)
		None:
			True


private pure func constructor_length_fallback_can_balance(
	name: String,
	fallback: Option[CoreConstructorLengthMatchBranch],
) -> Bool:
	match fallback:
		Some(branch):
			constructor_length_branch_can_balance(name, branch)
		None:
			True


private pure func constructor_length_match_can_balance(
	name: String,
	match_expr: CoreConstructorLengthMatch,
) -> Bool:
	(
		constructor_length_cases_can_balance(name, match_expr.cases)
		and constructor_length_geq_can_balance(name, match_expr.geq)
		and constructor_length_fallback_can_balance(name, match_expr.fallback)
	)


private pure func constructor_match_case_can_balance(
	name: String,
	match_case: CoreConstructorMatchCase,
) -> Bool:
	if match_bindings_shadow(name, match_case.bindings):
		False
	else:
		constructor_match_body_can_balance(name, match_case.body)


private pure func constructor_match_cases_can_balance(
	name: String,
	cases: List[CoreConstructorMatchCase],
) -> Bool:
	cases.all(func(match_case): constructor_match_case_can_balance(name, match_case))


private pure func constructor_match_fallback_can_balance(
	name: String,
	fallback: CoreConstructorMatchFallback,
) -> Bool:
	match fallback:
		ConstructorMatchFallbackBody(body):
			True
		ConstructorMatchFallbackBindings(bindings, body):
			not match_bindings_shadow(name, bindings)
		ConstructorMatchFallbackFail:
			True


private pure func constructor_match_case_required(
	env: PerceusEnv,
	name: String,
	match_case: CoreConstructorMatchCase,
) -> Int:
	if match_bindings_shadow(name, match_case.bindings):
		0
	else:
		constructor_match_body_required(env, name, match_case.body)


private pure func constructor_match_body_required(
	env: PerceusEnv,
	name: String,
	body: CoreConstructorMatchBody,
) -> Int:
	match body:
		ConstructorMatchBodyExpr(expr):
			summarize_linear_ownership_uses(env, name, expr).required_refs
		ConstructorMatchBodyLiteral(match_expr):
			constructor_literal_match_required(env, name, match_expr)
		ConstructorMatchBodyLength(match_expr):
			constructor_length_match_required(env, name, match_expr)


private pure func constructor_length_branch_required(
	env: PerceusEnv,
	name: String,
	branch: CoreConstructorLengthMatchBranch,
) -> Int:
	if match_bindings_shadow(name, branch.bindings):
		0
	else:
		constructor_match_body_required(env, name, branch.body)


private pure func constructor_length_cases_max_required(
	env: PerceusEnv,
	name: String,
	cases: List[CoreConstructorLengthMatchCase],
) -> Int:
	var required: Int = 0

	for match_case in cases:
		required = max_int(
			required,
			constructor_length_branch_required(env, name, match_case.branch),
		)

	required


private pure func constructor_length_geq_required(
	env: PerceusEnv,
	name: String,
	geq: Option[CoreConstructorLengthMatchGeq],
) -> Int:
	match geq:
		Some(match_case):
			constructor_length_branch_required(env, name, match_case.branch)
		None:
			0


private pure func constructor_length_fallback_required(
	env: PerceusEnv,
	name: String,
	fallback: Option[CoreConstructorLengthMatchBranch],
) -> Int:
	match fallback:
		Some(branch):
			constructor_length_branch_required(env, name, branch)
		None:
			0


private pure func constructor_length_match_required(
	env: PerceusEnv,
	name: String,
	match_expr: CoreConstructorLengthMatch,
) -> Int:
	max_int(
		constructor_length_cases_max_required(env, name, match_expr.cases),
		max_int(
			constructor_length_geq_required(env, name, match_expr.geq),
			constructor_length_fallback_required(env, name, match_expr.fallback),
		),
	)


private pure func summarize_constructor_match_fallback(
	env: PerceusEnv,
	name: String,
	fallback: CoreConstructorMatchFallback,
) -> OwnershipUseSummary:
	match fallback:
		ConstructorMatchFallbackBody(body):
			summarize_linear_ownership_uses(env, name, body)
		ConstructorMatchFallbackBindings(bindings, body):
			if match_bindings_shadow(name, bindings):
				NO_OWNERSHIP_USES
			else:
				summarize_linear_ownership_uses(env, name, body)
		ConstructorMatchFallbackFail:
			NO_OWNERSHIP_USES


private pure func constructor_match_cases_max_required(
	env: PerceusEnv,
	name: String,
	cases: List[CoreConstructorMatchCase],
) -> Int:
	var required: Int = 0

	for match_case in cases:
		required = max_int(
			required,
			constructor_match_case_required(env, name, match_case),
		)

	required


private pure func constructor_match_fallback_required(
	env: PerceusEnv,
	name: String,
	fallback: CoreConstructorMatchFallback,
) -> Int:
	summarize_constructor_match_fallback(env, name, fallback).required_refs


private pure func balance_constructor_match_body(
	env: PerceusEnv,
	variable: CoreVar,
	value_type: CoreType,
	available_refs: Int,
	body: CoreConstructorMatchBody,
) -> CoreConstructorMatchBody:
	match body:
		ConstructorMatchBodyExpr(expr):
			uses: OwnershipUseSummary = summarize_linear_ownership_uses(env, variable.name, expr)
			ConstructorMatchBodyExpr(
				balance_branch_body(
					env,
					variable,
					value_type,
					available_refs,
					uses,
					expr,
				),
			)
		ConstructorMatchBodyLiteral(match_expr):
			ConstructorMatchBodyLiteral(
				balance_constructor_literal_match(
					env,
					variable,
					value_type,
					available_refs,
					match_expr,
				),
			)
		ConstructorMatchBodyLength(match_expr):
			ConstructorMatchBodyLength(
				balance_constructor_length_match(
					env,
					variable,
					value_type,
					available_refs,
					match_expr,
				),
			)


private pure func balance_constructor_length_branch(
	env: PerceusEnv,
	variable: CoreVar,
	value_type: CoreType,
	available_refs: Int,
	branch: CoreConstructorLengthMatchBranch,
) -> CoreConstructorLengthMatchBranch:
	{ branch |
		body = balance_constructor_match_body(
			env,
			variable,
			value_type,
			available_refs,
			branch.body,
		)
	}


private pure func balance_constructor_length_case(
	env: PerceusEnv,
	variable: CoreVar,
	value_type: CoreType,
	available_refs: Int,
	match_case: CoreConstructorLengthMatchCase,
) -> CoreConstructorLengthMatchCase:
	{ match_case |
		branch = balance_constructor_length_branch(
			env,
			variable,
			value_type,
			available_refs,
			match_case.branch,
		)
	}


private pure func balance_constructor_length_cases(
	env: PerceusEnv,
	variable: CoreVar,
	value_type: CoreType,
	available_refs: Int,
	cases: List[CoreConstructorLengthMatchCase],
) -> List[CoreConstructorLengthMatchCase]:
	var balanced: List[CoreConstructorLengthMatchCase] = []

	for match_case in cases:
		balanced = balanced.append(
			balance_constructor_length_case(
				env,
				copy_core_var(variable),
				copy_core_type(value_type),
				available_refs,
				match_case,
			),
		)

	balanced


private pure func balance_constructor_length_geq(
	env: PerceusEnv,
	variable: CoreVar,
	value_type: CoreType,
	available_refs: Int,
	geq: Option[CoreConstructorLengthMatchGeq],
) -> Option[CoreConstructorLengthMatchGeq]:
	match geq:
		Some(match_case):
			Some(
				{ match_case |
					branch = balance_constructor_length_branch(
						env,
						variable,
						value_type,
						available_refs,
						match_case.branch,
					)
				},
			)
		None:
			None


private pure func balance_constructor_length_fallback(
	env: PerceusEnv,
	variable: CoreVar,
	value_type: CoreType,
	available_refs: Int,
	fallback: Option[CoreConstructorLengthMatchBranch],
) -> Option[CoreConstructorLengthMatchBranch]:
	match fallback:
		Some(branch):
			Some(
				balance_constructor_length_branch(
					env,
					variable,
					value_type,
					available_refs,
					branch,
				),
			)
		None:
			None


private pure func balance_constructor_length_match(
	env: PerceusEnv,
	variable: CoreVar,
	value_type: CoreType,
	available_refs: Int,
	match_expr: CoreConstructorLengthMatch,
) -> CoreConstructorLengthMatch:
	{ match_expr |
		cases = balance_constructor_length_cases(
			env,
			copy_core_var(variable),
			copy_core_type(value_type),
			available_refs,
			match_expr.cases,
		),
		geq = balance_constructor_length_geq(
			env,
			copy_core_var(variable),
			copy_core_type(value_type),
			available_refs,
			match_expr.geq,
		),
		fallback = balance_constructor_length_fallback(
			env,
			copy_core_var(variable),
			copy_core_type(value_type),
			available_refs,
			match_expr.fallback,
		)
	}


private pure func balance_constructor_match_case(
	env: PerceusEnv,
	variable: CoreVar,
	value_type: CoreType,
	available_refs: Int,
	match_case: CoreConstructorMatchCase,
) -> CoreConstructorMatchCase:
	{ match_case |
		body = balance_constructor_match_body(
			env,
			variable,
			value_type,
			available_refs,
			match_case.body,
		)
	}


private pure func balance_constructor_match_cases(
	env: PerceusEnv,
	variable: CoreVar,
	value_type: CoreType,
	available_refs: Int,
	cases: List[CoreConstructorMatchCase],
) -> List[CoreConstructorMatchCase]:
	var balanced: List[CoreConstructorMatchCase] = []

	for match_case in cases:
		balanced = balanced.append(
			balance_constructor_match_case(
				env,
				copy_core_var(variable),
				copy_core_type(value_type),
				available_refs,
				match_case,
			),
		)

	balanced


private pure func balance_constructor_match_fallback(
	env: PerceusEnv,
	variable: CoreVar,
	value_type: CoreType,
	available_refs: Int,
	fallback: CoreConstructorMatchFallback,
) -> CoreConstructorMatchFallback:
	match fallback:
		ConstructorMatchFallbackBody(body):
			uses: OwnershipUseSummary = summarize_linear_ownership_uses(env, variable.name, body)
			ConstructorMatchFallbackBody(
				balance_branch_body(
					env,
					variable,
					value_type,
					available_refs,
					uses,
					body,
				),
			)
		ConstructorMatchFallbackBindings(bindings, body):
			uses: OwnershipUseSummary = summarize_linear_ownership_uses(env, variable.name, body)
			ConstructorMatchFallbackBindings(
				bindings,
				balance_branch_body(env, variable, value_type, available_refs, uses, body),
			)
		ConstructorMatchFallbackFail:
			ConstructorMatchFallbackFail


private pure func ownership_summary_preserves_owner(uses: OwnershipUseSummary) -> Bool:
	uses.consumed_refs == 0 and not uses.returns_alias


private pure func constructor_match_body_preserves_owner(
	env: PerceusEnv,
	name: String,
	body: CoreConstructorMatchBody,
) -> Bool:
	match body:
		ConstructorMatchBodyExpr(expr):
			ownership_summary_preserves_owner(summarize_linear_ownership_uses(env, name, expr))
		ConstructorMatchBodyLiteral(match_expr):
			(
				literal_match_cases_preserve_owner(env, name, match_expr.cases)
				and literal_match_fallback_preserves_owner(env, name, match_expr.fallback)
			)
		ConstructorMatchBodyLength(match_expr):
			constructor_length_match_preserves_owner(env, name, match_expr)


private pure func literal_match_cases_preserve_owner(
	env: PerceusEnv,
	name: String,
	cases: List[CoreLiteralMatchCase],
) -> Bool:
	var preserves: Bool = True

	for match_case in cases:
		if (
			not match_bindings_shadow(name, match_case.bindings)
			and not ownership_summary_preserves_owner(
				summarize_linear_ownership_uses(
					env,
					name,
					match_case.body,
				),
			)
		):
			preserves = False
			break
		else:
			void

	preserves


private pure func literal_match_fallback_preserves_owner(
	env: PerceusEnv,
	name: String,
	fallback: CoreLiteralMatchFallback,
) -> Bool:
	match fallback:
		LiteralMatchFallbackBody(body):
			ownership_summary_preserves_owner(summarize_linear_ownership_uses(env, name, body))
		LiteralMatchFallbackBindings(bindings, body):
			(
				match_bindings_shadow(name, bindings)
				or ownership_summary_preserves_owner(
					summarize_linear_ownership_uses(
						env,
						name,
						body,
					),
				)
			)
		LiteralMatchFallbackFail:
			True


private pure func constructor_length_branch_preserves_owner(
	env: PerceusEnv,
	name: String,
	branch: CoreConstructorLengthMatchBranch,
) -> Bool:
	(
		match_bindings_shadow(name, branch.bindings)
		or constructor_match_body_preserves_owner(env, name, branch.body)
	)


private pure func constructor_length_match_preserves_owner(
	env: PerceusEnv,
	name: String,
	match_expr: CoreConstructorLengthMatch,
) -> Bool:
	var preserves: Bool = True

	for match_case in match_expr.cases:
		if not constructor_length_branch_preserves_owner(env, name, match_case.branch):
			preserves = False
			break
		else:
			void

	if preserves:
		match match_expr.geq:
			Some(match_case):
				preserves = constructor_length_branch_preserves_owner(env, name, match_case.branch)
			None:
				void
	else:
		void

	if preserves:
		match match_expr.fallback:
			Some(branch):
				preserves = constructor_length_branch_preserves_owner(env, name, branch)
			None:
				void
	else:
		void

	preserves


private pure func constructor_match_cases_preserve_owner(
	env: PerceusEnv,
	name: String,
	cases: List[CoreConstructorMatchCase],
) -> Bool:
	var preserves: Bool = True

	for match_case in cases:
		if (
			not match_bindings_shadow(name, match_case.bindings)
			and not constructor_match_body_preserves_owner(env, name, match_case.body)
		):
			preserves = False
			break
		else:
			void

	preserves


private pure func constructor_match_fallback_preserves_owner(
	env: PerceusEnv,
	name: String,
	fallback: CoreConstructorMatchFallback,
) -> Bool:
	match fallback:
		ConstructorMatchFallbackBody(body):
			ownership_summary_preserves_owner(summarize_linear_ownership_uses(env, name, body))
		ConstructorMatchFallbackBindings(bindings, body):
			(
				match_bindings_shadow(name, bindings)
				or ownership_summary_preserves_owner(
					summarize_linear_ownership_uses(
						env,
						name,
						body,
					),
				)
			)
		ConstructorMatchFallbackFail:
			True


private pure func transform_let_constructor_match_body(
	env: PerceusEnv,
	variable: CoreVar,
	value_type: CoreType,
	scrutinee: CoreExpr,
	release_policy: CoreReleasePolicy,
	cases: List[CoreConstructorMatchCase],
	fallback: CoreConstructorMatchFallback,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreExpr]:
	freshened_cases: List[CoreConstructorMatchCase] = freshen_constructor_match_case_shadows(
		variable,
		cases,
	)
	freshened_fallback: CoreConstructorMatchFallback = freshen_constructor_match_fallback_shadow(
		variable,
		cases.length(),
		fallback,
	)
	match_node: CoreExpr = ConstructorMatchExpr(
		scrutinee,
		release_policy,
		freshened_cases,
		freshened_fallback,
		copy_core_type(typ),
		loc,
	)

	if (
		borrow_expr_aliases_target(env, variable.name, scrutinee)
		and release_policy == NoReleasePolicy
	):
		if (
			constructor_match_cases_preserve_owner(env, variable.name, freshened_cases)
			and constructor_match_fallback_preserves_owner(env, variable.name, freshened_fallback)
		):
			Some(drop_after_body(1, variable, value_type, match_node))
		else:
			None
	else if (
		not constructor_match_cases_can_balance(variable.name, freshened_cases)
		or not constructor_match_fallback_can_balance(variable.name, freshened_fallback)
	):
		None
	else:
		scrutinee_uses: OwnershipUseSummary = summarize_linear_ownership_uses(
			env,
			variable.name,
			scrutinee,
		)
		max_branch_required: Int = max_int(
			constructor_match_cases_max_required(env, variable.name, freshened_cases),
			constructor_match_fallback_required(env, variable.name, freshened_fallback),
		)
		total_needed: Int = max_int(
			scrutinee_uses.required_refs,
			scrutinee_uses.consumed_refs + max_branch_required,
		)

		if total_needed == 0:
			Some(prepend_drops(1, variable, value_type, match_node))
		else:
			dups_count: Int = max_int(0, total_needed - 1)
			available_after_scrutinee: Int = 1 + dups_count - scrutinee_uses.consumed_refs
			balanced_match: CoreExpr = ConstructorMatchExpr(
				scrutinee,
				release_policy,
				balance_constructor_match_cases(
					env,
					copy_core_var(variable),
					copy_core_type(value_type),
					available_after_scrutinee,
					freshened_cases,
				),
				balance_constructor_match_fallback(
					env,
					copy_core_var(variable),
					copy_core_type(value_type),
					available_after_scrutinee,
					freshened_fallback,
				),
				copy_core_type(typ),
				loc,
			)
			Some(prepend_dups(dups_count, variable, value_type, balanced_match))


private pure func balance_let_body_legacy(
	env: PerceusEnv,
	variable: CoreVar,
	bind_type: CoreType,
	body: CoreExpr,
) -> CoreExpr:
	uses: OwnershipUseSummary = summarize_linear_ownership_uses(env, variable.name, body)

	if not uses.touched:
		prepend_drops(1, variable, bind_type, body)
	else:
		dups_count: Int = max_int(0, uses.required_refs - 1)
		owned_refs: Int = 1 + dups_count

		if env.balance_nested_matches:
			prepend_dups(
				dups_count,
				variable,
				bind_type,
				balance_branch_body(
					env,
					copy_core_var(variable),
					copy_core_type(bind_type),
					owned_refs,
					uses,
					body,
				),
			)
		else:
			post_drops: Int = if uses.returns_alias:
				0
			else:
				max_int(0, owned_refs - uses.consumed_refs)

			body_with_dups: CoreExpr = prepend_dups(dups_count, variable, bind_type, body)

			drop_after_body(post_drops, variable, bind_type, body_with_dups)


private pure func mutable_assignment_temp_var(target: CoreVar, index: Int) -> CoreVar:
	{
		name = "__assign_${target.name}_${target.uniq}_${index}",
		uniq = target.uniq,
		def_id = None
	}


private pure func assignment_result_returns_alias(
	env: PerceusEnv,
	local_aliases: Dict[String, Bool],
	expr: CoreExpr,
) -> Bool:
	match expr:
		VarExpr(variable, typ, loc):
			match local_aliases.get(variable.name):
				Some(aliases):
					aliases
				None:
					is_managed_type(env, typ)
		FieldExpr(owner, field, typ, loc):
			is_managed_type(env, typ)
		TupleFieldExpr(owner, field_index, typ, loc):
			is_managed_type(env, typ)
		CastExpr(inner, typ, loc):
			assignment_result_returns_alias(env, local_aliases, inner)
		UnboxExpr(kind, inner, typ, loc):
			(
				managed_pointer_unbox_alias(env, kind, typ)
				or assignment_result_returns_alias(env, local_aliases, inner)
			)
		CallExpr(kind, callee, args, typ, loc):
			match contract_for_call(env, kind, args.length(), typ):
				Some(contract):
					match contract.result:
						ReturnBorrowed:
							True
						ReturnAliasOfArg(index):
							True
						_:
							False
				None:
					False
		LetExpr(variable, is_mutable, typ, rhs, body):
			binding_aliases: Bool = (
				is_managed_type(env, typ)
				and assignment_result_returns_alias(env, local_aliases, rhs)
			)

			assignment_result_returns_alias(
				env,
				local_aliases.set(variable.name, binding_aliases),
				body,
			)
		BorrowLetExpr(variable, typ, rhs, body):
			assignment_result_returns_alias(
				env,
				local_aliases.set(
					variable.name,
					is_managed_type(env, typ),
				),
				body,
			)
		SeqExpr(first, second):
			assignment_result_returns_alias(env, local_aliases, second)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			match body:
				VarExpr(returned, return_type, return_loc):
					if variable.name == returned.name and variable.uniq == returned.uniq:
						False
					else:
						assignment_result_returns_alias(env, local_aliases, body)
				_:
					assignment_result_returns_alias(env, local_aliases, body)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			assignment_result_returns_alias(env, local_aliases, body)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			(
				assignment_result_returns_alias(env, local_aliases, then_expr)
				or assignment_result_returns_alias(env, local_aliases, else_expr)
			)
		_:
			False


private pure func assignment_rhs_returns_alias(env: PerceusEnv, rhs: CoreExpr) -> Bool:
	assignment_result_returns_alias(env, {}, rhs)


private pure func rewrite_direct_mutable_assignment(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	rhs: CoreExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
	temp_index: Int,
	skip_old_release: Bool,
) -> MutableAssignmentRewrite:
	uses: OwnershipUseSummary = summarize_linear_ownership_uses(env, target.name, rhs)
	protected_rhs: CoreExpr = prepend_dups(
		max_int(0, uses.consumed_refs - 1),
		target,
		target_type,
		rhs,
	)

	if skip_old_release or uses.consumed_refs > 0:
		{
			expr = AssignExpr(copy_core_var(target), protected_rhs, copy_core_type(typ), loc),
			next_temp = temp_index
		}
	else:
		rhs_type: CoreType = expr_result_type(rhs)
		temp: CoreVar = mutable_assignment_temp_var(target, temp_index)
		drop_old: CoreExpr = DropExpr(
			copy_core_var(target),
			copy_core_type(target_type),
			release_policy_for_type(target_type),
			VoidExpr(VoidType, loc),
			VoidType,
			loc,
		)
		assign_new: CoreExpr = AssignExpr(
			copy_core_var(target),
			VarExpr(copy_core_var(temp), copy_core_type(rhs_type), loc),
			copy_core_type(typ),
			loc,
		)
		install_new: CoreExpr = SeqExpr(drop_old, assign_new)

		retained_install: CoreExpr = if assignment_rhs_returns_alias(env, rhs):
			DupExpr(
				copy_core_var(temp),
				copy_core_type(rhs_type),
				retain_policy_for_type(rhs_type),
				install_new,
				copy_core_type(typ),
				loc,
			)
		else:
			install_new

		{
			expr = LetExpr(
				copy_core_var(temp),
				False,
				copy_core_type(rhs_type),
				protected_rhs,
				retained_install,
			),
			next_temp = temp_index + 1
		}


private pure func expr_assigns_mutable_target(target: CoreVar, expr: CoreExpr) -> Bool:
	match expr:
		AssignExpr(variable, rhs, typ, loc):
			variable.name == target.name or expr_assigns_mutable_target(target, rhs)
		LetExpr(variable, is_mutable, typ, rhs, body):
			(
				expr_assigns_mutable_target(target, rhs)
				or variable.name != target.name and expr_assigns_mutable_target(target, body)
			)
		BorrowLetExpr(variable, typ, rhs, body):
			(
				expr_assigns_mutable_target(target, rhs)
				or variable.name != target.name and expr_assigns_mutable_target(target, body)
			)
		SeqExpr(first, second):
			(
				expr_assigns_mutable_target(target, first)
				or expr_assigns_mutable_target(target, second)
			)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			(
				expr_assigns_mutable_target(target, cond)
				or expr_assigns_mutable_target(target, then_expr)
				or expr_assigns_mutable_target(target, else_expr)
			)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			expr_assigns_mutable_target(target, body)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			expr_assigns_mutable_target(target, body)
		_:
			False


private pure func rewrite_mutable_constructor_match_body(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	body: CoreConstructorMatchBody,
	temp_index: Int,
	skip_old_release: Bool,
) -> MutableConstructorMatchBodyRewrite:
	match body:
		ConstructorMatchBodyExpr(expr):
			result: MutableAssignmentRewrite = rewrite_mutable_assignments(
				env,
				target,
				target_type,
				expr,
				temp_index,
				skip_old_release,
			)
			{
				body = ConstructorMatchBodyExpr(result.expr),
				next_temp = result.next_temp
			}
		ConstructorMatchBodyLiteral(match_expr):
			result: MutableConstructorLiteralMatchRewrite = rewrite_mutable_constructor_literal_match(
				env,
				target,
				target_type,
				match_expr,
				temp_index,
				skip_old_release,
			)
			{
				body = ConstructorMatchBodyLiteral(result.match_expr),
				next_temp = result.next_temp
			}
		ConstructorMatchBodyLength(match_expr):
			result: MutableConstructorLengthMatchRewrite = rewrite_mutable_constructor_length_match(
				env,
				target,
				target_type,
				match_expr,
				temp_index,
				skip_old_release,
			)
			{
				body = ConstructorMatchBodyLength(result.match_expr),
				next_temp = result.next_temp
			}


private pure func rewrite_mutable_literal_match_fallback(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	fallback: CoreLiteralMatchFallback,
	temp_index: Int,
	skip_old_release: Bool,
) -> MutableLiteralMatchFallbackRewrite:
	match fallback:
		LiteralMatchFallbackBody(body):
			result: MutableAssignmentRewrite = rewrite_mutable_assignments(
				env,
				target,
				target_type,
				body,
				temp_index,
				skip_old_release,
			)
			{
				fallback = LiteralMatchFallbackBody(result.expr),
				next_temp = result.next_temp
			}
		LiteralMatchFallbackBindings(bindings, body):
			if match_bindings_shadow(target.name, bindings):
				{
					fallback = fallback,
					next_temp = temp_index
				}
			else:
				result: MutableAssignmentRewrite = rewrite_mutable_assignments(
					env,
					target,
					target_type,
					body,
					temp_index,
					skip_old_release,
				)
				{
					fallback = LiteralMatchFallbackBindings(bindings, result.expr),
					next_temp = result.next_temp
				}
		LiteralMatchFallbackFail:
			{
				fallback = LiteralMatchFallbackFail,
				next_temp = temp_index
			}


private pure func rewrite_mutable_constructor_literal_match(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	match_expr: CoreConstructorLiteralMatch,
	temp_index: Int,
	skip_old_release: Bool,
) -> MutableConstructorLiteralMatchRewrite:
	var rewritten_cases: List[CoreLiteralMatchCase] = []
	var next_temp: Int = temp_index

	for match_case in match_expr.cases:
		if match_bindings_shadow(target.name, match_case.bindings):
			rewritten_cases = rewritten_cases.append(match_case)
		else:
			result: MutableAssignmentRewrite = rewrite_mutable_assignments(
				env,
				target,
				target_type,
				match_case.body,
				next_temp,
				skip_old_release,
			)
			rewritten_cases = rewritten_cases.append({ match_case | body = result.expr })
			next_temp = result.next_temp

	fallback_result: MutableLiteralMatchFallbackRewrite = rewrite_mutable_literal_match_fallback(
		env,
		target,
		target_type,
		match_expr.fallback,
		next_temp,
		skip_old_release,
	)

	{
		match_expr = { match_expr |
			cases = rewritten_cases,
			fallback = fallback_result.fallback
		},
		next_temp = fallback_result.next_temp
	}


private pure func rewrite_mutable_constructor_length_branch(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	branch: CoreConstructorLengthMatchBranch,
	temp_index: Int,
	skip_old_release: Bool,
) -> MutableConstructorLengthBranchRewrite:
	if match_bindings_shadow(target.name, branch.bindings):
		{
			branch = branch,
			next_temp = temp_index
		}
	else:
		result: MutableConstructorMatchBodyRewrite = rewrite_mutable_constructor_match_body(
			env,
			target,
			target_type,
			branch.body,
			temp_index,
			skip_old_release,
		)
		{
			branch = { branch | body = result.body },
			next_temp = result.next_temp
		}


private pure func rewrite_mutable_constructor_length_match(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	match_expr: CoreConstructorLengthMatch,
	temp_index: Int,
	skip_old_release: Bool,
) -> MutableConstructorLengthMatchRewrite:
	var rewritten_cases: List[CoreConstructorLengthMatchCase] = []
	var next_temp: Int = temp_index

	for match_case in match_expr.cases:
		result: MutableConstructorLengthBranchRewrite = rewrite_mutable_constructor_length_branch(
			env,
			target,
			target_type,
			match_case.branch,
			next_temp,
			skip_old_release,
		)
		rewritten_cases = rewritten_cases.append({ match_case | branch = result.branch })
		next_temp = result.next_temp

	var rewritten_geq: Option[CoreConstructorLengthMatchGeq] = None
	var geq_temp: Int = next_temp

	match match_expr.geq:
		Some(geq):
			result: MutableConstructorLengthBranchRewrite = rewrite_mutable_constructor_length_branch(
				env,
				target,
				target_type,
				geq.branch,
				next_temp,
				skip_old_release,
			)
			rewritten_geq = Some({ geq | branch = result.branch })
			geq_temp = result.next_temp
		None:
			void

	var rewritten_fallback: Option[CoreConstructorLengthMatchBranch] = None
	var final_temp: Int = geq_temp

	match match_expr.fallback:
		Some(branch):
			result: MutableConstructorLengthBranchRewrite = rewrite_mutable_constructor_length_branch(
				env,
				target,
				target_type,
				branch,
				geq_temp,
				skip_old_release,
			)
			rewritten_fallback = Some(result.branch)
			final_temp = result.next_temp
		None:
			void

	{
		match_expr = { match_expr |
			cases = rewritten_cases,
			geq = rewritten_geq,
			fallback = rewritten_fallback
		},
		next_temp = final_temp
	}


private pure func rewrite_mutable_constructor_match_fallback(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	fallback: CoreConstructorMatchFallback,
	temp_index: Int,
	skip_old_release: Bool,
) -> MutableConstructorMatchFallbackRewrite:
	match fallback:
		ConstructorMatchFallbackBody(body):
			result: MutableAssignmentRewrite = rewrite_mutable_assignments(
				env,
				target,
				target_type,
				body,
				temp_index,
				skip_old_release,
			)
			{
				fallback = ConstructorMatchFallbackBody(result.expr),
				next_temp = result.next_temp
			}
		ConstructorMatchFallbackBindings(bindings, body):
			if match_bindings_shadow(target.name, bindings):
				{
					fallback = fallback,
					next_temp = temp_index
				}
			else:
				result: MutableAssignmentRewrite = rewrite_mutable_assignments(
					env,
					target,
					target_type,
					body,
					temp_index,
					skip_old_release,
				)
				{
					fallback = ConstructorMatchFallbackBindings(bindings, result.expr),
					next_temp = result.next_temp
				}
		ConstructorMatchFallbackFail:
			{
				fallback = ConstructorMatchFallbackFail,
				next_temp = temp_index
			}


private pure func rewrite_mutable_constructor_match(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	cases: List[CoreConstructorMatchCase],
	fallback: CoreConstructorMatchFallback,
	temp_index: Int,
	skip_old_release: Bool,
) -> MutableConstructorMatchRewrite:
	var rewritten_cases: List[CoreConstructorMatchCase] = []
	var next_temp: Int = temp_index

	for match_case in cases:
		if match_bindings_shadow(target.name, match_case.bindings):
			rewritten_cases = rewritten_cases.append(match_case)
		else:
			result: MutableConstructorMatchBodyRewrite = rewrite_mutable_constructor_match_body(
				env,
				target,
				target_type,
				match_case.body,
				next_temp,
				skip_old_release,
			)
			rewritten_cases = rewritten_cases.append({ match_case | body = result.body })
			next_temp = result.next_temp

	fallback_result: MutableConstructorMatchFallbackRewrite = rewrite_mutable_constructor_match_fallback(
		env,
		target,
		target_type,
		fallback,
		next_temp,
		skip_old_release,
	)
	{
		cases = rewritten_cases,
		fallback = fallback_result.fallback,
		next_temp = fallback_result.next_temp
	}


private pure func rewrite_mutable_bound_loop_body(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	binder: CoreLoopBinder,
	body: CoreExpr,
	temp_index: Int,
	skip_old_release: Bool,
) -> MutableAssignmentRewrite:
	if binder.variable.name == target.name:
		{
			expr = body,
			next_temp = temp_index
		}
	else:
		rewrite_mutable_assignments(env, target, target_type, body, temp_index, skip_old_release)


private pure func rewrite_mutable_assignments(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	expr: CoreExpr,
	temp_index: Int,
	skip_old_release: Bool,
) -> MutableAssignmentRewrite:
	match expr:
		AssignExpr(variable, rhs, typ, loc):
			rhs_result: MutableAssignmentRewrite = rewrite_mutable_assignments(
				env,
				target,
				target_type,
				rhs,
				temp_index,
				False,
			)

			if variable.name == target.name:
				rewrite_direct_mutable_assignment(
					env,
					target,
					target_type,
					rhs_result.expr,
					typ,
					loc,
					rhs_result.next_temp,
					skip_old_release,
				)
			else:
				{
					expr = AssignExpr(
						copy_core_var(variable),
						rhs_result.expr,
						copy_core_type(typ),
						loc,
					),
					next_temp = rhs_result.next_temp
				}
		LetExpr(variable, is_mutable, typ, rhs, body):
			rhs_result: MutableAssignmentRewrite = rewrite_mutable_assignments(
				env,
				target,
				target_type,
				rhs,
				temp_index,
				False,
			)
			body_skips_old_release: Bool = (
				skip_old_release
				and not expr_assigns_mutable_target(target, rhs)
			)

			body_result: MutableAssignmentRewrite = if variable.name == target.name:
				{
					expr = body,
					next_temp = rhs_result.next_temp
				}
			else:
				rewrite_mutable_assignments(
					env,
					target,
					target_type,
					body,
					rhs_result.next_temp,
					body_skips_old_release,
				)

			{
				expr = LetExpr(
					copy_core_var(variable),
					is_mutable,
					copy_core_type(typ),
					rhs_result.expr,
					body_result.expr,
				),
				next_temp = body_result.next_temp
			}
		BorrowLetExpr(variable, typ, rhs, body):
			rhs_result: MutableAssignmentRewrite = rewrite_mutable_assignments(
				env,
				target,
				target_type,
				rhs,
				temp_index,
				False,
			)
			body_skips_old_release: Bool = (
				skip_old_release
				and not expr_assigns_mutable_target(target, rhs)
			)

			body_result: MutableAssignmentRewrite = if variable.name == target.name:
				{
					expr = body,
					next_temp = rhs_result.next_temp
				}
			else:
				rewrite_mutable_assignments(
					env,
					target,
					target_type,
					body,
					rhs_result.next_temp,
					body_skips_old_release,
				)

			{
				expr = BorrowLetExpr(
					copy_core_var(variable),
					copy_core_type(typ),
					rhs_result.expr,
					body_result.expr,
				),
				next_temp = body_result.next_temp
			}
		SeqExpr(first, second):
			first_result: MutableAssignmentRewrite = rewrite_mutable_assignments(
				env,
				target,
				target_type,
				first,
				temp_index,
				skip_old_release,
			)
			second_skips_old_release: Bool = (
				((
					skip_old_release
					or summarize_linear_ownership_uses(env, target.name, first).consumed_refs > 0
				))
				and not expr_assigns_mutable_target(target, first)
			)

			second_result: MutableAssignmentRewrite = rewrite_mutable_assignments(
				env,
				target,
				target_type,
				second,
				first_result.next_temp,
				second_skips_old_release,
			)
			{
				expr = SeqExpr(first_result.expr, second_result.expr),
				next_temp = second_result.next_temp
			}
		IfExpr(cond, then_expr, else_expr, typ, loc):
			cond_result: MutableAssignmentRewrite = rewrite_mutable_assignments(
				env,
				target,
				target_type,
				cond,
				temp_index,
				skip_old_release,
			)
			then_result: MutableAssignmentRewrite = rewrite_mutable_assignments(
				env,
				target,
				target_type,
				then_expr,
				cond_result.next_temp,
				skip_old_release,
			)
			else_result: MutableAssignmentRewrite = rewrite_mutable_assignments(
				env,
				target,
				target_type,
				else_expr,
				then_result.next_temp,
				skip_old_release,
			)
			{
				expr = IfExpr(
					cond_result.expr,
					then_result.expr,
					else_result.expr,
					copy_core_type(typ),
					loc,
				),
				next_temp = else_result.next_temp
			}
		WhileExpr(cond, body, typ, loc):
			cond_result: MutableAssignmentRewrite = rewrite_mutable_assignments(
				env,
				target,
				target_type,
				cond,
				temp_index,
				skip_old_release,
			)
			body_result: MutableAssignmentRewrite = rewrite_mutable_assignments(
				env,
				target,
				target_type,
				body,
				cond_result.next_temp,
				skip_old_release,
			)
			{
				expr = WhileExpr(cond_result.expr, body_result.expr, copy_core_type(typ), loc),
				next_temp = body_result.next_temp
			}
		ForListExpr(loop, typ, loc):
			iterable_result: MutableAssignmentRewrite = rewrite_mutable_assignments(
				env,
				target,
				target_type,
				loop.iterable,
				temp_index,
				skip_old_release,
			)
			body_result: MutableAssignmentRewrite = rewrite_mutable_bound_loop_body(
				env,
				target,
				target_type,
				loop.binder,
				loop.body,
				iterable_result.next_temp,
				skip_old_release,
			)
			{
				expr = ForListExpr(
					{ loop |
						iterable = iterable_result.expr,
						body = body_result.expr
					},
					copy_core_type(typ),
					loc,
				),
				next_temp = body_result.next_temp
			}
		ForStringExpr(loop, typ, loc):
			iterable_result: MutableAssignmentRewrite = rewrite_mutable_assignments(
				env,
				target,
				target_type,
				loop.iterable,
				temp_index,
				skip_old_release,
			)
			body_result: MutableAssignmentRewrite = rewrite_mutable_bound_loop_body(
				env,
				target,
				target_type,
				loop.binder,
				loop.body,
				iterable_result.next_temp,
				skip_old_release,
			)
			{
				expr = ForStringExpr(
					{ loop |
						iterable = iterable_result.expr,
						body = body_result.expr
					},
					copy_core_type(typ),
					loc,
				),
				next_temp = body_result.next_temp
			}
		ForDictExpr(loop, typ, loc):
			iterable_result: MutableAssignmentRewrite = rewrite_mutable_assignments(
				env,
				target,
				target_type,
				loop.iterable,
				temp_index,
				skip_old_release,
			)
			body_result: MutableAssignmentRewrite = rewrite_mutable_bound_loop_body(
				env,
				target,
				target_type,
				loop.binder,
				loop.body,
				iterable_result.next_temp,
				skip_old_release,
			)
			{
				expr = ForDictExpr(
					{ loop |
						iterable = iterable_result.expr,
						body = body_result.expr
					},
					copy_core_type(typ),
					loc,
				),
				next_temp = body_result.next_temp
			}
		ForSetExpr(loop, typ, loc):
			iterable_result: MutableAssignmentRewrite = rewrite_mutable_assignments(
				env,
				target,
				target_type,
				loop.iterable,
				temp_index,
				skip_old_release,
			)
			body_result: MutableAssignmentRewrite = rewrite_mutable_bound_loop_body(
				env,
				target,
				target_type,
				loop.binder,
				loop.body,
				iterable_result.next_temp,
				skip_old_release,
			)
			{
				expr = ForSetExpr(
					{ loop |
						iterable = iterable_result.expr,
						body = body_result.expr
					},
					copy_core_type(typ),
					loc,
				),
				next_temp = body_result.next_temp
			}
		ForStreamExpr(loop, typ, loc):
			iterable_result: MutableAssignmentRewrite = rewrite_mutable_assignments(
				env,
				target,
				target_type,
				loop.iterable,
				temp_index,
				skip_old_release,
			)
			body_result: MutableAssignmentRewrite = rewrite_mutable_bound_loop_body(
				env,
				target,
				target_type,
				loop.binder,
				loop.body,
				iterable_result.next_temp,
				skip_old_release,
			)
			{
				expr = ForStreamExpr(
					{ loop |
						iterable = iterable_result.expr,
						body = body_result.expr
					},
					copy_core_type(typ),
					loc,
				),
				next_temp = body_result.next_temp
			}
		ForResourceSourceExpr(loop, typ, loc):
			iterable_result: MutableAssignmentRewrite = rewrite_mutable_assignments(
				env,
				target,
				target_type,
				loop.iterable,
				temp_index,
				skip_old_release,
			)
			body_result: MutableAssignmentRewrite = rewrite_mutable_bound_loop_body(
				env,
				target,
				target_type,
				loop.binder,
				loop.body,
				iterable_result.next_temp,
				skip_old_release,
			)
			{
				expr = ForResourceSourceExpr(
					{ loop |
						iterable = iterable_result.expr,
						body = body_result.expr
					},
					copy_core_type(typ),
					loc,
				),
				next_temp = body_result.next_temp
			}
		ForChannelExpr(loop, typ, loc):
			iterable_result: MutableAssignmentRewrite = rewrite_mutable_assignments(
				env,
				target,
				target_type,
				loop.iterable,
				temp_index,
				skip_old_release,
			)
			body_result: MutableAssignmentRewrite = rewrite_mutable_bound_loop_body(
				env,
				target,
				target_type,
				loop.binder,
				loop.body,
				iterable_result.next_temp,
				skip_old_release,
			)
			{
				expr = ForChannelExpr(
					{ loop |
						iterable = iterable_result.expr,
						body = body_result.expr
					},
					copy_core_type(typ),
					loc,
				),
				next_temp = body_result.next_temp
			}
		ForTensorExpr(loop, typ, loc):
			iterable_result: MutableAssignmentRewrite = rewrite_mutable_assignments(
				env,
				target,
				target_type,
				loop.iterable,
				temp_index,
				skip_old_release,
			)
			body_result: MutableAssignmentRewrite = rewrite_mutable_bound_loop_body(
				env,
				target,
				target_type,
				loop.binder,
				loop.body,
				iterable_result.next_temp,
				skip_old_release,
			)
			{
				expr = ForTensorExpr(
					{ loop |
						iterable = iterable_result.expr,
						body = body_result.expr
					},
					copy_core_type(typ),
					loc,
				),
				next_temp = body_result.next_temp
			}
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			start_result: MutableAssignmentRewrite = rewrite_mutable_assignments(
				env,
				target,
				target_type,
				start,
				temp_index,
				skip_old_release,
			)
			end_result: MutableAssignmentRewrite = rewrite_mutable_assignments(
				env,
				target,
				target_type,
				end_value,
				start_result.next_temp,
				skip_old_release,
			)
			body_result: MutableAssignmentRewrite = rewrite_mutable_bound_loop_body(
				env,
				target,
				target_type,
				binder,
				body,
				end_result.next_temp,
				skip_old_release,
			)
			{
				expr = ForRangeExpr(
					binder,
					start_result.expr,
					end_result.expr,
					body_result.expr,
					copy_core_type(typ),
					loc,
				),
				next_temp = body_result.next_temp
			}
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			scrutinee_result: MutableAssignmentRewrite = rewrite_mutable_assignments(
				env,
				target,
				target_type,
				scrutinee,
				temp_index,
				False,
			)
			branches_skip_old_release: Bool = (
				skip_old_release
				or summarize_linear_ownership_uses(env, target.name, scrutinee).consumed_refs > 0
			)

			match_result: MutableConstructorMatchRewrite = rewrite_mutable_constructor_match(
				env,
				target,
				target_type,
				cases,
				fallback,
				scrutinee_result.next_temp,
				branches_skip_old_release,
			)
			{
				expr = ConstructorMatchExpr(
					scrutinee_result.expr,
					release_policy,
					match_result.cases,
					match_result.fallback,
					copy_core_type(typ),
					loc,
				),
				next_temp = match_result.next_temp
			}
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			body_result: MutableAssignmentRewrite = rewrite_mutable_assignments(
				env,
				target,
				target_type,
				body,
				temp_index,
				skip_old_release,
			)
			{
				expr = DupExpr(
					copy_core_var(variable),
					copy_core_type(value_type),
					retain_policy,
					body_result.expr,
					copy_core_type(typ),
					loc,
				),
				next_temp = body_result.next_temp
			}
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			body_result: MutableAssignmentRewrite = rewrite_mutable_assignments(
				env,
				target,
				target_type,
				body,
				temp_index,
				skip_old_release,
			)
			{
				expr = DropExpr(
					copy_core_var(variable),
					copy_core_type(value_type),
					release_policy,
					body_result.expr,
					copy_core_type(typ),
					loc,
				),
				next_temp = body_result.next_temp
			}
		_:
			{
				expr = expr,
				next_temp = temp_index
			}


private pure func directly_returns_var(name: String, expr: CoreExpr) -> Bool:
	match expr:
		VarExpr(variable, typ, loc):
			variable.name == name
		LetExpr(variable, is_mutable, typ, rhs, body):
			if variable.name == name:
				False
			else if directly_returns_var(name, body):
				True
			else:
				match body:
					DropExpr(dropped, value_type, release_policy, drop_body, drop_type, loc):
						(
							dropped.name != name
							and directly_returns_var(variable.name, drop_body)
							and directly_returns_var(name, rhs)
						)
					_:
						False
		BorrowLetExpr(variable, typ, rhs, body):
			variable.name != name and directly_returns_var(name, body)
		SeqExpr(first, second):
			directly_returns_var(name, second)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			directly_returns_var(name, then_expr) and directly_returns_var(name, else_expr)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			directly_returns_var(name, body)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			directly_returns_var(name, body)
		_:
			False


private pure func rewrite_mutable_let_body(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	body: CoreExpr,
) -> CoreExpr:
	-- A mutable slot owns its current value until assignment replaces it or the
	-- scope exits. Preserve that owner across outward transfers; this gives the
	-- assignment rewriter one stable invariant instead of path-dependent moves.
	target_param: CoreParam = {
		name = copy_core_var(target),
		typ = copy_core_type(target_type),
		loc = SyntheticSourceLoc
	}
	transfer_safe_body: CoreExpr = protect_repeated_consumes(env, target, target_type, body, True)

	if directly_returns_var(target.name, transfer_safe_body):
		-- Moving the slot itself out of scope transfers its final owner. Retaining
		-- and then dropping that same owner creates an unnecessary and fragile
		-- handoff for later reuse/codegen passes.
		rewrite_mutable_assignments(env, target, target_type, transfer_safe_body, 0, False).expr
	else:
		result_safe_body: CoreExpr = retain_borrowed_param_result(
			env,
			target_param,
			transfer_safe_body,
		)
		rewritten_body: CoreExpr = rewrite_mutable_assignments(
			env,
			target,
			target_type,
			result_safe_body,
			0,
			False,
		).expr

		drop_after_body(1, target, target_type, rewritten_body)


private pure func protect_repeated_exprs(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	exprs: List[CoreExpr],
	in_repeated_context: Bool,
) -> List[CoreExpr]:
	var protected: List[CoreExpr] = []

	for expr in exprs:
		protected = protected.append(
			protect_repeated_consumes(
				env,
				target,
				target_type,
				expr,
				in_repeated_context,
			),
		)

	protected


private pure func protect_repeated_aggregate_value(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	value: CoreExpr,
	in_repeated_context: Bool,
) -> CoreExpr:
	protected: CoreExpr = protect_repeated_consumes(
		env,
		target,
		target_type,
		value,
		in_repeated_context,
	)

	if in_repeated_context:
		retain_borrowed_aggregate_value(
			env,
			{
				name = copy_core_var(target),
				typ = copy_core_type(target_type),
				loc = SyntheticSourceLoc
			},
			protected,
		)
	else:
		protected


private pure func protect_repeated_aggregate_exprs(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	exprs: List[CoreExpr],
	in_repeated_context: Bool,
) -> List[CoreExpr]:
	var protected: List[CoreExpr] = []

	for expr in exprs:
		protected = protected.append(
			protect_repeated_aggregate_value(
				env,
				target,
				target_type,
				expr,
				in_repeated_context,
			),
		)

	protected


private pure func protect_repeated_record_fields(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	fields: List[CoreRecordFieldValue],
	in_repeated_context: Bool,
) -> List[CoreRecordFieldValue]:
	var protected: List[CoreRecordFieldValue] = []

	for field in fields:
		name: String = field.name
		value: CoreExpr = field.value
		protected = protected.append({
			name = name,
			value = protect_repeated_aggregate_value(
				env,
				target,
				target_type,
				value,
				in_repeated_context,
			),
		})

	protected


private pure func protect_repeated_boxed_value(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	value: CoreBoxedStorageValue,
	in_repeated_context: Bool,
) -> CoreBoxedStorageValue:
	protected_expr: CoreExpr = if value.transfers_ownership:
		protect_repeated_aggregate_value(env, target, target_type, value.value, in_repeated_context)
	else:
		protect_repeated_consumes(env, target, target_type, value.value, in_repeated_context)

	{
		kind = value.kind,
		value = protected_expr,
		needs_release = value.needs_release,
		transfers_ownership = value.transfers_ownership
	}


private pure func protect_repeated_boxed_values(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	values: List[CoreBoxedStorageValue],
	in_repeated_context: Bool,
) -> List[CoreBoxedStorageValue]:
	var protected: List[CoreBoxedStorageValue] = []

	for value in values:
		protected = protected.append(
			protect_repeated_boxed_value(
				env,
				target,
				target_type,
				value,
				in_repeated_context,
			),
		)

	protected


private pure func protect_repeated_dict_entries(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	entries: List[CoreDictEntry],
	in_repeated_context: Bool,
) -> List[CoreDictEntry]:
	var protected: List[CoreDictEntry] = []

	for entry in entries:
		protected = protected.append({
			key = protect_repeated_boxed_value(
				env,
				target,
				target_type,
				entry.key,
				in_repeated_context,
			),
			value = protect_repeated_boxed_value(
				env,
				target,
				target_type,
				entry.value,
				in_repeated_context,
			),
		})

	protected


private pure func protect_repeated_literal_match_cases(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	cases: List[CoreLiteralMatchCase],
	in_repeated_context: Bool,
) -> List[CoreLiteralMatchCase]:
	var protected: List[CoreLiteralMatchCase] = []

	for match_case in cases:
		protected = protected.append(
			protect_repeated_literal_match_case(
				env,
				target,
				target_type,
				match_case,
				in_repeated_context,
			),
		)

	protected


private pure func protect_repeated_constructor_length_cases(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	cases: List[CoreConstructorLengthMatchCase],
	in_repeated_context: Bool,
) -> List[CoreConstructorLengthMatchCase]:
	var protected: List[CoreConstructorLengthMatchCase] = []

	for match_case in cases:
		protected = protected.append(
			protect_repeated_constructor_length_case(
				env,
				target,
				target_type,
				match_case,
				in_repeated_context,
			),
		)

	protected


private pure func protect_repeated_constructor_match_cases(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	cases: List[CoreConstructorMatchCase],
	in_repeated_context: Bool,
) -> List[CoreConstructorMatchCase]:
	var protected: List[CoreConstructorMatchCase] = []

	for match_case in cases:
		protected = protected.append(
			protect_repeated_constructor_match_case(
				env,
				target,
				target_type,
				match_case,
				in_repeated_context,
			),
		)

	protected


private pure func protect_repeated_constructor_match_body(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	body: CoreConstructorMatchBody,
	in_repeated_context: Bool,
) -> CoreConstructorMatchBody:
	match body:
		ConstructorMatchBodyExpr(expr):
			ConstructorMatchBodyExpr(
				protect_repeated_consumes(
					env,
					target,
					target_type,
					expr,
					in_repeated_context,
				),
			)
		ConstructorMatchBodyLiteral(match_expr):
			accessor = match_expr.accessor
			scrutinee_type: CoreType = match_expr.scrutinee_type
			cases: List[CoreLiteralMatchCase] = match_expr.cases
			fallback: CoreLiteralMatchFallback = match_expr.fallback
			result_type: CoreType = match_expr.result_type
			loc: CoreSourceLoc = match_expr.loc
			protected_cases: List[CoreLiteralMatchCase] = protect_repeated_literal_match_cases(
				env,
				target,
				target_type,
				cases,
				in_repeated_context,
			)
			protected_fallback: CoreLiteralMatchFallback = protect_repeated_literal_match_fallback(
				env,
				target,
				target_type,
				fallback,
				in_repeated_context,
			)

			ConstructorMatchBodyLiteral({
				accessor = accessor,
				scrutinee_type = scrutinee_type,
				cases = protected_cases,
				fallback = protected_fallback,
				result_type = result_type,
				loc = loc,
			})
		ConstructorMatchBodyLength(match_expr):
			ConstructorMatchBodyLength(
				protect_repeated_constructor_length_match(
					env,
					target,
					target_type,
					match_expr,
					in_repeated_context,
				),
			)


private pure func protect_repeated_literal_match_case(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	match_case: CoreLiteralMatchCase,
	in_repeated_context: Bool,
) -> CoreLiteralMatchCase:
	literal: CoreLiteral = match_case.literal
	bindings: List[CoreMatchBinding] = match_case.bindings
	body: CoreExpr = match_case.body

	if match_bindings_shadow(target.name, bindings):
		{
			literal = literal,
			bindings = bindings,
			body = copy_expr(body)
		}
	else:
		{
			literal = literal,
			bindings = bindings,
			body = protect_repeated_consumes(env, target, target_type, body, in_repeated_context)
		}


private pure func protect_repeated_literal_match_fallback(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	fallback: CoreLiteralMatchFallback,
	in_repeated_context: Bool,
) -> CoreLiteralMatchFallback:
	match fallback:
		LiteralMatchFallbackBody(body):
			LiteralMatchFallbackBody(
				protect_repeated_consumes(
					env,
					target,
					target_type,
					body,
					in_repeated_context,
				),
			)
		LiteralMatchFallbackBindings(bindings, body):
			if match_bindings_shadow(target.name, bindings):
				fallback
			else:
				LiteralMatchFallbackBindings(
					bindings,
					protect_repeated_consumes(env, target, target_type, body, in_repeated_context),
				)
		LiteralMatchFallbackFail:
			LiteralMatchFallbackFail


private pure func protect_repeated_constructor_length_branch(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	branch: CoreConstructorLengthMatchBranch,
	in_repeated_context: Bool,
) -> CoreConstructorLengthMatchBranch:
	bindings: List[CoreMatchBinding] = branch.bindings
	body: CoreConstructorMatchBody = branch.body

	if match_bindings_shadow(target.name, bindings):
		{
			bindings = bindings,
			body = body
		}
	else:
		{
			bindings = bindings,
			body = protect_repeated_constructor_match_body(
				env,
				target,
				target_type,
				body,
				in_repeated_context,
			)
		}


private pure func protect_repeated_constructor_length_match(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	match_expr: CoreConstructorLengthMatch,
	in_repeated_context: Bool,
) -> CoreConstructorLengthMatch:
	accessor = match_expr.accessor
	cases: List[CoreConstructorLengthMatchCase] = match_expr.cases
	geq: Option[CoreConstructorLengthMatchGeq] = match_expr.geq
	fallback: Option[CoreConstructorLengthMatchBranch] = match_expr.fallback
	result_type: CoreType = match_expr.result_type
	loc: CoreSourceLoc = match_expr.loc
	protected_cases: List[CoreConstructorLengthMatchCase] = protect_repeated_constructor_length_cases(
		env,
		target,
		target_type,
		cases,
		in_repeated_context,
	)

	protected_geq: Option[CoreConstructorLengthMatchGeq] = match geq:
		Some(match_case):
			Some(
				protect_repeated_constructor_length_geq(
					env,
					target,
					target_type,
					match_case,
					in_repeated_context,
				),
			)
		None:
			None

	protected_fallback: Option[CoreConstructorLengthMatchBranch] = match fallback:
		Some(branch):
			Some(
				protect_repeated_constructor_length_branch(
					env,
					target,
					target_type,
					branch,
					in_repeated_context,
				),
			)
		None:
			None

	{
		accessor = accessor,
		cases = protected_cases,
		geq = protected_geq,
		fallback = protected_fallback,
		result_type = result_type,
		loc = loc
	}


private pure func protect_repeated_constructor_length_case(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	match_case: CoreConstructorLengthMatchCase,
	in_repeated_context: Bool,
) -> CoreConstructorLengthMatchCase:
	length: Int = match_case.length
	branch: CoreConstructorLengthMatchBranch = match_case.branch

	{
		length = length,
		branch = protect_repeated_constructor_length_branch(
			env,
			target,
			target_type,
			branch,
			in_repeated_context,
		)
	}


private pure func protect_repeated_constructor_length_geq(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	match_case: CoreConstructorLengthMatchGeq,
	in_repeated_context: Bool,
) -> CoreConstructorLengthMatchGeq:
	minimum_length: Int = match_case.minimum_length
	branch: CoreConstructorLengthMatchBranch = match_case.branch

	{
		minimum_length = minimum_length,
		branch = protect_repeated_constructor_length_branch(
			env,
			target,
			target_type,
			branch,
			in_repeated_context,
		)
	}


private pure func protect_repeated_constructor_match_case(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	match_case: CoreConstructorMatchCase,
	in_repeated_context: Bool,
) -> CoreConstructorMatchCase:
	constructor: String = match_case.constructor
	accessor: CoreAccessor = match_case.accessor
	test: CoreConstructorMatchTest = match_case.test
	bindings: List[CoreMatchBinding] = match_case.bindings
	body: CoreConstructorMatchBody = match_case.body

	if match_bindings_shadow(target.name, bindings):
		{
			constructor = constructor,
			accessor = accessor,
			test = test,
			bindings = bindings,
			body = body
		}
	else:
		{
			constructor = constructor,
			accessor = accessor,
			test = test,
			bindings = bindings,
			body = protect_repeated_constructor_match_body(
				env,
				target,
				target_type,
				body,
				in_repeated_context,
			)
		}


private pure func protect_repeated_constructor_match_fallback(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	fallback: CoreConstructorMatchFallback,
	in_repeated_context: Bool,
) -> CoreConstructorMatchFallback:
	match fallback:
		ConstructorMatchFallbackBody(body):
			ConstructorMatchFallbackBody(
				protect_repeated_consumes(
					env,
					target,
					target_type,
					body,
					in_repeated_context,
				),
			)
		ConstructorMatchFallbackBindings(bindings, body):
			if match_bindings_shadow(target.name, bindings):
				fallback
			else:
				ConstructorMatchFallbackBindings(
					bindings,
					protect_repeated_consumes(env, target, target_type, body, in_repeated_context),
				)
		ConstructorMatchFallbackFail:
			ConstructorMatchFallbackFail


private pure func protect_repeated_consumes(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	expr: CoreExpr,
	in_repeated_context: Bool,
) -> CoreExpr:
	match expr:
		CallExpr(kind, callee, args, typ, loc):
			protected_callee: CoreExpr = protect_repeated_consumes(
				env,
				target,
				target_type,
				callee,
				in_repeated_context,
			)
			protected_args: List[CoreExpr] = protect_repeated_exprs(
				env,
				target,
				target_type,
				args,
				in_repeated_context,
			)
			call: CoreExpr = CallExpr(
				copy_core_call_kind(kind),
				protected_callee,
				protected_args,
				copy_core_type(typ),
				loc,
			)

			if in_repeated_context:
				uses: OwnershipUseSummary = summarize_linear_call(
					env,
					target.name,
					typ,
					kind,
					protected_callee,
					protected_args,
				)
				prepend_dups(uses.consumed_refs, target, target_type, call)
			else:
				call
		BinaryExpr(op, left, right, typ, loc):
			protected_left: CoreExpr = protect_repeated_consumes(
				env,
				target,
				target_type,
				left,
				in_repeated_context,
			)
			protected_right: CoreExpr = protect_repeated_consumes(
				env,
				target,
				target_type,
				right,
				in_repeated_context,
			)
			binary: CoreExpr = BinaryExpr(
				op,
				protected_left,
				protected_right,
				copy_core_type(typ),
				loc,
			)

			if in_repeated_context and is_consuming_collection_equality(op, left, right):
				uses: OwnershipUseSummary = summarize_linear_ownership_uses(
					env,
					target.name,
					binary,
				)
				prepend_dups(uses.consumed_refs, target, target_type, binary)
			else:
				binary
		UnaryExpr(op, inner, typ, loc):
			UnaryExpr(
				op,
				protect_repeated_consumes(env, target, target_type, inner, in_repeated_context),
				copy_core_type(typ),
				loc,
			)
		LogicalExpr(op, left, right, typ, loc):
			LogicalExpr(
				op,
				protect_repeated_consumes(env, target, target_type, left, in_repeated_context),
				protect_repeated_consumes(env, target, target_type, right, in_repeated_context),
				copy_core_type(typ),
				loc,
			)
		CastExpr(inner, typ, loc):
			CastExpr(
				protect_repeated_consumes(env, target, target_type, inner, in_repeated_context),
				copy_core_type(typ),
				loc,
			)
		BoxExpr(box, typ, loc):
			BoxExpr(
				{ box |
					value = protect_repeated_consumes(
						env,
						target,
						target_type,
						box.value,
						in_repeated_context,
					),
					source_type = copy_core_type(box.source_type)
				},
				copy_core_type(typ),
				loc,
			)
		UnboxExpr(kind, inner, typ, loc):
			UnboxExpr(
				kind,
				protect_repeated_consumes(env, target, target_type, inner, in_repeated_context),
				copy_core_type(typ),
				loc,
			)
		FieldExpr(owner, field, typ, loc):
			FieldExpr(
				protect_repeated_consumes(env, target, target_type, owner, in_repeated_context),
				field,
				copy_core_type(typ),
				loc,
			)
		TupleFieldExpr(owner, field_index, typ, loc):
			TupleFieldExpr(
				protect_repeated_consumes(env, target, target_type, owner, in_repeated_context),
				field_index,
				copy_core_type(typ),
				loc,
			)
		TupleExpr(items, typ, loc):
			TupleExpr(
				protect_repeated_aggregate_exprs(
					env,
					target,
					target_type,
					items,
					in_repeated_context,
				),
				copy_core_type(typ),
				loc,
			)
		VectorExpr(items, typ, loc):
			VectorExpr(
				protect_repeated_aggregate_exprs(
					env,
					target,
					target_type,
					items,
					in_repeated_context,
				),
				copy_core_type(typ),
				loc,
			)
		RecordExpr(fields, typ, loc):
			RecordExpr(
				protect_repeated_record_fields(
					env,
					target,
					target_type,
					fields,
					in_repeated_context,
				),
				copy_core_type(typ),
				loc,
			)
		RecordConstructExpr(type_name, fields, typ, loc):
			RecordConstructExpr(
				type_name,
				protect_repeated_record_fields(
					env,
					target,
					target_type,
					fields,
					in_repeated_context,
				),
				copy_core_type(typ),
				loc,
			)
		ListConstructExpr(construct, typ, loc):
			layout = construct.layout
			elements: List[CoreBoxedStorageValue] = construct.elements
			elem_needs_release: Bool = construct.elem_needs_release
			ListConstructExpr(
				{
					layout = layout,
					elements = protect_repeated_boxed_values(
						env,
						target,
						target_type,
						elements,
						in_repeated_context,
					),
					elem_needs_release = elem_needs_release
				},
				copy_core_type(typ),
				loc,
			)
		TensorBoxedLiteralExpr(literal, typ, loc):
			shape = literal.shape
			elements: List[CoreBoxedStorageValue] = literal.elements
			elem_needs_release: Bool = literal.elem_needs_release
			TensorBoxedLiteralExpr(
				{
					shape = shape,
					elements = protect_repeated_boxed_values(
						env,
						target,
						target_type,
						elements,
						in_repeated_context,
					),
					elem_needs_release = elem_needs_release
				},
				copy_core_type(typ),
				loc,
			)
		DictConstructExpr(construct, typ, loc):
			DictConstructExpr(
				{ construct |
					entries = protect_repeated_dict_entries(
						env,
						target,
						target_type,
						construct.entries,
						in_repeated_context,
					)
				},
				copy_core_type(typ),
				loc,
			)
		UnionConstructExpr(construct, typ, loc):
			UnionConstructExpr(
				{ construct |
					args = protect_repeated_boxed_values(
						env,
						target,
						target_type,
						construct.args,
						in_repeated_context,
					)
				},
				copy_core_type(typ),
				loc,
			)
		LetExpr(variable, is_mutable, typ, rhs, body):
			protected_body: CoreExpr = if variable.name == target.name:
				copy_expr(body)
			else:
				protect_repeated_consumes(env, target, target_type, body, in_repeated_context)

			LetExpr(
				copy_core_var(variable),
				is_mutable,
				copy_core_type(typ),
				protect_repeated_consumes(env, target, target_type, rhs, in_repeated_context),
				protected_body,
			)
		BorrowLetExpr(variable, typ, rhs, body):
			protected_body: CoreExpr = if variable.name == target.name:
				copy_expr(body)
			else:
				protect_repeated_consumes(env, target, target_type, body, in_repeated_context)

			BorrowLetExpr(
				copy_core_var(variable),
				copy_core_type(typ),
				protect_repeated_consumes(env, target, target_type, rhs, in_repeated_context),
				protected_body,
			)
		SeqExpr(first, second):
			SeqExpr(
				protect_repeated_consumes(env, target, target_type, first, in_repeated_context),
				protect_repeated_consumes(env, target, target_type, second, in_repeated_context),
			)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			IfExpr(
				protect_repeated_consumes(env, target, target_type, cond, in_repeated_context),
				protect_repeated_consumes(env, target, target_type, then_expr, in_repeated_context),
				protect_repeated_consumes(env, target, target_type, else_expr, in_repeated_context),
				copy_core_type(typ),
				loc,
			)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			ConstructorMatchExpr(
				protect_repeated_consumes(env, target, target_type, scrutinee, in_repeated_context),
				release_policy,
				protect_repeated_constructor_match_cases(
					env,
					target,
					target_type,
					cases,
					in_repeated_context,
				),
				protect_repeated_constructor_match_fallback(
					env,
					target,
					target_type,
					fallback,
					in_repeated_context,
				),
				copy_core_type(typ),
				loc,
			)
		WhileExpr(cond, body, typ, loc):
			WhileExpr(
				protect_repeated_consumes(env, target, target_type, cond, True),
				protect_repeated_consumes(env, target, target_type, body, True),
				copy_core_type(typ),
				loc,
			)
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			protected_body: CoreExpr = if binder.variable.name == target.name:
				body
			else:
				protect_repeated_consumes(env, target, target_type, body, True)

			ForRangeExpr(
				binder,
				protect_repeated_consumes(env, target, target_type, start, in_repeated_context),
				protect_repeated_consumes(env, target, target_type, end_value, in_repeated_context),
				protected_body,
				copy_core_type(typ),
				loc,
			)
		ForChannelExpr(loop, typ, loc):
			protected_body: CoreExpr = if loop.binder.variable.name == target.name:
				loop.body
			else:
				protect_repeated_consumes(env, target, target_type, loop.body, True)

			ForChannelExpr(
				{ loop |
					iterable = protect_repeated_consumes(
						env,
						target,
						target_type,
						loop.iterable,
						in_repeated_context,
					),
					body = protected_body
				},
				copy_core_type(typ),
				loc,
			)
		ForListExpr(loop, typ, loc):
			protected_body: CoreExpr = if loop.binder.variable.name == target.name:
				loop.body
			else:
				protect_repeated_consumes(env, target, target_type, loop.body, True)

			ForListExpr(
				{ loop |
					iterable = protect_repeated_consumes(
						env,
						target,
						target_type,
						loop.iterable,
						in_repeated_context,
					),
					body = protected_body
				},
				copy_core_type(typ),
				loc,
			)
		ForStringExpr(loop, typ, loc):
			protected_body: CoreExpr = if loop.binder.variable.name == target.name:
				loop.body
			else:
				protect_repeated_consumes(env, target, target_type, loop.body, True)

			ForStringExpr(
				{ loop |
					iterable = protect_repeated_consumes(
						env,
						target,
						target_type,
						loop.iterable,
						in_repeated_context,
					),
					body = protected_body
				},
				copy_core_type(typ),
				loc,
			)
		ForDictExpr(loop, typ, loc):
			protected_body: CoreExpr = if loop.binder.variable.name == target.name:
				loop.body
			else:
				protect_repeated_consumes(env, target, target_type, loop.body, True)

			ForDictExpr(
				{ loop |
					iterable = protect_repeated_consumes(
						env,
						target,
						target_type,
						loop.iterable,
						in_repeated_context,
					),
					body = protected_body
				},
				copy_core_type(typ),
				loc,
			)
		ForSetExpr(loop, typ, loc):
			protected_body: CoreExpr = if loop.binder.variable.name == target.name:
				loop.body
			else:
				protect_repeated_consumes(env, target, target_type, loop.body, True)

			ForSetExpr(
				{ loop |
					iterable = protect_repeated_consumes(
						env,
						target,
						target_type,
						loop.iterable,
						in_repeated_context,
					),
					body = protected_body
				},
				copy_core_type(typ),
				loc,
			)
		ForStreamExpr(loop, typ, loc):
			protected_body: CoreExpr = if loop.binder.variable.name == target.name:
				loop.body
			else:
				protect_repeated_consumes(env, target, target_type, loop.body, True)

			ForStreamExpr(
				{ loop |
					iterable = protect_repeated_consumes(
						env,
						target,
						target_type,
						loop.iterable,
						in_repeated_context,
					),
					body = protected_body
				},
				copy_core_type(typ),
				loc,
			)
		ForResourceSourceExpr(loop, typ, loc):
			protected_body: CoreExpr = if loop.binder.variable.name == target.name:
				loop.body
			else:
				protect_repeated_consumes(env, target, target_type, loop.body, True)

			ForResourceSourceExpr(
				{ loop |
					iterable = protect_repeated_consumes(
						env,
						target,
						target_type,
						loop.iterable,
						in_repeated_context,
					),
					body = protected_body
				},
				copy_core_type(typ),
				loc,
			)
		ForTensorExpr(loop, typ, loc):
			protected_body: CoreExpr = if loop.binder.variable.name == target.name:
				loop.body
			else:
				protect_repeated_consumes(env, target, target_type, loop.body, True)

			ForTensorExpr(
				{ loop |
					iterable = protect_repeated_consumes(
						env,
						target,
						target_type,
						loop.iterable,
						in_repeated_context,
					),
					body = protected_body
				},
				copy_core_type(typ),
				loc,
			)
		AssignExpr(variable, rhs, typ, loc):
			if variable.name == target.name:
				expr
			else:
				AssignExpr(
					copy_core_var(variable),
					protect_repeated_consumes(env, target, target_type, rhs, in_repeated_context),
					copy_core_type(typ),
					loc,
				)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			if variable.name == target.name:
				expr
			else:
				DupExpr(
					copy_core_var(variable),
					copy_core_type(value_type),
					retain_policy,
					protect_repeated_consumes(env, target, target_type, body, in_repeated_context),
					copy_core_type(typ),
					loc,
				)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			DropExpr(
				copy_core_var(variable),
				copy_core_type(value_type),
				release_policy,
				protect_repeated_consumes(env, target, target_type, body, in_repeated_context),
				copy_core_type(typ),
				loc,
			)
		ResourceScopeExpr(scope, typ, loc):
			ResourceScopeExpr(
				{ scope |
					acquire = protect_repeated_consumes(
						env,
						target,
						target_type,
						scope.acquire,
						in_repeated_context,
					),
					body = protect_repeated_consumes(
						env,
						target,
						target_type,
						scope.body,
						in_repeated_context,
					),
					cleanup = protect_repeated_consumes(
						env,
						target,
						target_type,
						scope.cleanup,
						in_repeated_context,
					)
				},
				copy_core_type(typ),
				loc,
			)
		_:
			expr


private pure func direct_field_alias(expr: CoreExpr) -> Bool:
	match expr:
		FieldExpr(VarExpr(variable, owner_type, owner_loc), field, typ, loc):
			True
		FieldExpr(owner, field, typ, loc):
			direct_field_alias(owner)
		TupleFieldExpr(VarExpr(variable, owner_type, owner_loc), field_index, typ, loc):
			True
		TupleFieldExpr(owner, field_index, typ, loc):
			direct_field_alias(owner)
		_:
			False


private pure func synthetic_binding_var(prefix: String, index: Int, loc: CoreSourceLoc) -> CoreVar:
	location_suffix: String = match loc:
		KnownSourceLoc(span):
			"_${span.line}_${span.column}"
		SyntheticSourceLoc:
			""

	{
		name = "__${prefix}${location_suffix}_${index}",
		uniq = index,
		def_id = None
	}


private pure func wrap_synthetic_bindings(
	bindings: List[SyntheticOwnershipBinding],
	body: CoreExpr,
) -> CoreExpr:
	var result: CoreExpr = body
	var index: Int = bindings.length() - 1

	while index >= 0:
		match bindings.get(index):
			Some(binding):
				result = LetExpr(
					copy_core_var(binding.variable),
					False,
					copy_core_type(binding.typ),
					binding.rhs,
					result,
				)
			None:
				void

		index -= 1

	result


private pure func wrap_borrowed_owned_temporary_bindings(
	bindings: List[SyntheticOwnershipBinding],
	body: CoreExpr,
) -> CoreExpr:
	var result: CoreExpr = body
	var index: Int = bindings.length() - 1

	while index >= 0:
		match bindings.get(index):
			Some(binding):
				borrowed_view: CoreVar = {
					name = "${binding.variable.name}_view",
					uniq = binding.variable.uniq,
					def_id = None
				}
				dropped_result: CoreExpr = drop_after_body(1, binding.variable, binding.typ, result)
				borrowed_scope: CoreExpr = BorrowLetExpr(
					borrowed_view,
					copy_core_type(binding.typ),
					VarExpr(
						copy_core_var(binding.variable),
						copy_core_type(binding.typ),
						SyntheticSourceLoc,
					),
					dropped_result,
				)
				result = LetExpr(
					copy_core_var(binding.variable),
					False,
					copy_core_type(binding.typ),
					binding.rhs,
					borrowed_scope,
				)
			None:
				void

		index -= 1

	result


private pure func is_collection_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			name == "List" or name == "Dict" or name == "Set"
		_:
			False


private pure func is_consuming_collection_equality(
	op: CoreBinaryOp,
	left: CoreExpr,
	right: CoreExpr,
) -> Bool:
	match op:
		EqualOp:
			(
				is_collection_type(expr_result_type(left))
				or is_collection_type(expr_result_type(right))
			)
		NotEqualOp:
			(
				is_collection_type(expr_result_type(left))
				or is_collection_type(expr_result_type(right))
			)
		_:
			False


private pure func protect_consuming_field_aliases(env: PerceusEnv, expr: CoreExpr) -> CoreExpr:
	match expr:
		CallExpr(kind, callee, args, typ, loc):
			match contract_for_call(env, kind, args.length(), typ):
				Some(contract):
					var bindings: List[SyntheticOwnershipBinding] = []
					var rewritten_args: List[CoreExpr] = []
					var index: Int = 0

					for arg in args:
						match contract.args.get(index):
							Some(mode):
								arg_type: CoreType = expr_result_type(arg)

								if (
									arg_consumes_caller(mode)
									and is_managed_type(env, arg_type)
									and direct_field_alias(arg)
								):
									temp: CoreVar = synthetic_binding_var("cow_arg", index, loc)
									bindings = bindings.append({
										variable = temp,
										typ = arg_type,
										rhs = arg,
									})
									rewritten_args = rewritten_args.append(
										VarExpr(
											temp,
											copy_core_type(arg_type),
											loc,
										),
									)
								else:
									rewritten_args = rewritten_args.append(arg)
							None:
								rewritten_args = rewritten_args.append(arg)

						index += 1

					wrap_synthetic_bindings(
						bindings,
						CallExpr(kind, callee, rewritten_args, typ, loc),
					)
				None:
					expr
		BinaryExpr(op, left, right, typ, loc):
			if is_consuming_collection_equality(op, left, right):
				var bindings: List[SyntheticOwnershipBinding] = []
				var rewritten_args: List[CoreExpr] = []
				var index: Int = 0

				for arg in [left, right]:
					arg_type: CoreType = expr_result_type(arg)

					if is_managed_type(env, arg_type) and direct_field_alias(arg):
						temp: CoreVar = synthetic_binding_var("equality_arg", index, loc)
						bindings = bindings.append({
							variable = temp,
							typ = arg_type,
							rhs = arg,
						})
						rewritten_args = rewritten_args.append(
							VarExpr(
								temp,
								copy_core_type(arg_type),
								loc,
							),
						)
					else:
						rewritten_args = rewritten_args.append(arg)

					index += 1

				match rewritten_args:
					[rewritten_left, rewritten_right]:
						wrap_synthetic_bindings(
							bindings,
							BinaryExpr(op, rewritten_left, rewritten_right, typ, loc),
						)
					_:
						expr
			else:
				expr
		_:
			expr


private pure func call_result_is_owned(
	env: PerceusEnv,
	kind: CoreCallKind,
	args: List[CoreExpr],
	return_type: CoreType,
) -> Bool:
	match contract_for_call(env, kind, args.length(), return_type):
		Some(contract):
			match contract.result:
				ReturnOwned:
					True
				_:
					False
		None:
			is_managed_type(env, return_type)


private pure func is_closure_call(kind: CoreCallKind) -> Bool:
	match kind:
		ClosureCall:
			True
		_:
			False


private pure func owned_names_add(owned: List[String], name: String) -> List[String]:
	if owned.contains(name):
		owned
	else:
		owned.append(name)


private pure func owned_names_remove(owned: List[String], name: String) -> List[String]:
	var remaining: List[String] = []

	for item in owned:
		if item != name:
			remaining = remaining.append(item)
		else:
			void

	remaining


private pure func retained_var_from_effect(expr: CoreExpr) -> Option[String]:
	match expr:
		ListRetainExpr(retain, typ, loc):
			if retain.value.needs_release:
				match retain.value.value:
					VarExpr(value, value_type, value_loc):
						Some(value.name)
					_:
						None
			else:
				None
		CallExpr(IntrinsicCall(name), callee, args, return_type, call_loc):
			match args.get(1):
				Some(VarExpr(value, typ, loc)):
					if (
						name == "list_retain_for"
						or name == "dict_retain_key_for"
						or name == "dict_retain_value_for"
						or name == "set_retain_key_for"
					):
						Some(value.name)
					else:
						None
				_:
					None
		_:
			None


private pure func is_owned_temporary_with_names(
	env: PerceusEnv,
	owned: List[String],
	expr: CoreExpr,
) -> Bool:
	typ: CoreType = expr_result_type(expr)

	var_is_owned: Bool = match expr:
		VarExpr(variable, var_type, loc):
			owned.contains(variable.name)
		_:
			False

	if var_is_owned:
		True
	else if not is_managed_type(env, typ):
		False
	else:
		match expr:
			VarExpr(variable, var_type, loc):
				False
			LiteralExpr(StringLiteral(value), literal_type, loc):
				True
			CallExpr(kind, callee, args, return_type, loc):
				call_result_is_owned(env, kind, args, return_type)
			CastExpr(inner, cast_type, loc):
				match inner:
					CallExpr(kind, callee, args, return_type, call_loc):
						(
							call_result_is_owned(env, kind, args, cast_type)
							or is_owned_temporary_with_names(env, owned, inner)
						)
					_:
						is_owned_temporary_with_names(env, owned, inner)
			UnboxExpr(kind, inner, unbox_type, loc):
				match inner:
					CallExpr(call_kind, callee, args, return_type, call_loc):
						(
							call_result_is_owned(env, call_kind, args, unbox_type)
							or is_owned_temporary_with_names(env, owned, inner)
						)
					_:
						is_owned_temporary_with_names(env, owned, inner)
			LetExpr(variable, is_mutable, bind_type, rhs, body):
				next_owned: List[String] = if not is_mutable and is_managed_type(env, bind_type):
					owned_names_add(owned, variable.name)
				else:
					owned_names_remove(owned, variable.name)

				is_owned_temporary_with_names(env, next_owned, body)
			BorrowLetExpr(variable, bind_type, rhs, body):
				is_owned_temporary_with_names(
					env,
					owned_names_remove(owned, variable.name),
					body,
				)
			SeqExpr(first, second):
				next_owned: List[String] = match retained_var_from_effect(first):
					Some(name):
						owned_names_add(owned, name)
					None:
						owned

				is_owned_temporary_with_names(env, next_owned, second)
			IfExpr(cond, then_expr, else_expr, result_type, loc):
				(
					is_owned_temporary_with_names(env, owned, then_expr)
					and is_owned_temporary_with_names(env, owned, else_expr)
				)
			DupExpr(variable, value_type, retain_policy, body, result_type, loc):
				next_owned: List[String] = if is_managed_type(env, value_type):
					owned_names_add(owned, variable.name)
				else:
					owned

				is_owned_temporary_with_names(env, next_owned, body)
			DropExpr(variable, value_type, release_policy, body, result_type, loc):
				is_owned_temporary_with_names(
					env,
					owned_names_remove(owned, variable.name),
					body,
				)
			ListConstructExpr(construct, result_type, loc):
				True
			TensorBoxedLiteralExpr(literal, result_type, loc):
				True
			DictConstructExpr(construct, result_type, loc):
				True
			TupleExpr(items, result_type, loc):
				True
			VectorExpr(items, result_type, loc):
				True
			RecordExpr(fields, result_type, loc):
				True
			RecordConstructExpr(type_name, fields, result_type, loc):
				True
			UnionConstructExpr(construct, result_type, loc):
				True
			ListHandoffExpr(handoff, result_type, loc):
				True
			LambdaExpr(params, return_type, body, is_pure, result_type, loc):
				CoreClosure.lambda_has_runtime_captures(
					env.function_names,
					env.constructor_names,
					params,
					body,
				)
			ClosureCreateExpr(closure, result_type, loc):
				closure.captures.length() > 0
			_:
				False


private pure func is_owned_temporary_expr(env: PerceusEnv, expr: CoreExpr) -> Bool:
	is_owned_temporary_with_names(env, [], expr)


private pure func is_immortal_closure_expr(env: PerceusEnv, expr: CoreExpr) -> Bool:
	match expr:
		LambdaExpr(params, return_type, body, is_pure, typ, loc):
			not CoreClosure.lambda_has_runtime_captures(
				env.function_names,
				env.constructor_names,
				params,
				body,
			)
		ClosureCreateExpr(closure, typ, loc):
			closure.captures.length() == 0
		_:
			False


private pure func contract_for_temporary_binding(
	env: PerceusEnv,
	kind: CoreCallKind,
	arg_count: Int,
	return_type: CoreType,
) -> Option[TemporaryBindingContractPlan]:
	match contract_for_call(env, kind, arg_count, return_type):
		Some(contract):
			Some(BalancedTemporaryBindingContract(contract))
		None:
			match kind:
				UserCall(name, def_id, consumed_args):
					match lookup_user_call_contract(env, name, arg_count, return_type):
						Some(contract):
							Some(ExplicitDropTemporaryBindingContract(contract))
						None:
							None
				_:
					None


private pure func temporary_binding_plan_contract(
	plan: TemporaryBindingContractPlan,
) -> OwnershipCallContract:
	match plan:
		BalancedTemporaryBindingContract(contract):
			contract
		ExplicitDropTemporaryBindingContract(contract):
			contract


private pure func temporary_binding_plan_uses_explicit_drop(
	plan: TemporaryBindingContractPlan,
) -> Bool:
	match plan:
		BalancedTemporaryBindingContract(contract):
			False
		ExplicitDropTemporaryBindingContract(contract):
			True


private pure func borrowed_temporary_view_var(variable: CoreVar) -> CoreVar:
	{
		name = "${variable.name}_view",
		uniq = variable.uniq,
		def_id = None
	}


private pure func temporary_call_var(variable: CoreVar, use_borrowed_views: Bool) -> CoreVar:
	if use_borrowed_views:
		borrowed_temporary_view_var(variable)
	else:
		copy_core_var(variable)


private pure func prepare_borrowed_owned_temporary_call(
	env: PerceusEnv,
	kind: CoreCallKind,
	callee: CoreExpr,
	args: List[CoreExpr],
	typ: CoreType,
	loc: CoreSourceLoc,
	contract: OwnershipCallContract,
	use_borrowed_views: Bool,
) -> PreparedTemporaryCall:
	var bindings: List[SyntheticOwnershipBinding] = []
	var rewritten_args: List[CoreExpr] = []
	var index: Int = 0

	rewritten_callee: CoreExpr = if is_closure_call(kind) and is_owned_temporary_expr(env, callee):
		temp: CoreVar = synthetic_binding_var("borrow_callee", 0, loc)
		callee_type: CoreType = expr_result_type(callee)
		bindings = bindings.append({
			variable = temp,
			typ = callee_type,
			rhs = callee,
		})
		VarExpr(
			temporary_call_var(temp, use_borrowed_views),
			copy_core_type(callee_type),
			loc,
		)
	else:
		callee

	for arg in args:
		match contract.args.get(index):
			Some(mode):
				if arg_preserves_caller(mode) and is_owned_temporary_expr(env, arg):
					temp: CoreVar = synthetic_binding_var("borrow_arg", index, loc)
					arg_type: CoreType = expr_result_type(arg)
					bindings = bindings.append({
						variable = temp,
						typ = arg_type,
						rhs = arg,
					})
					rewritten_args = rewritten_args.append(
						VarExpr(
							temporary_call_var(temp, use_borrowed_views),
							copy_core_type(arg_type),
							loc,
						),
					)
				else:
					rewritten_args = rewritten_args.append(arg)
			None:
				rewritten_args = rewritten_args.append(arg)

		index += 1

	{
		bindings = bindings,
		call = CallExpr(kind, rewritten_callee, rewritten_args, typ, loc)
	}


private pure func bind_borrowed_owned_temporary_args_at_call(
	env: PerceusEnv,
	expr: CoreExpr,
) -> CoreExpr:
	match expr:
		CallExpr(kind, callee, args, typ, loc):
			match contract_for_temporary_binding(env, kind, args.length(), typ):
				Some(plan):
					explicit_drop: Bool = temporary_binding_plan_uses_explicit_drop(plan)
					prepared: PreparedTemporaryCall = prepare_borrowed_owned_temporary_call(
						env,
						kind,
						callee,
						args,
						typ,
						loc,
						temporary_binding_plan_contract(plan),
						explicit_drop,
					)

					if explicit_drop:
						wrap_borrowed_owned_temporary_bindings(prepared.bindings, prepared.call)
					else:
						wrap_synthetic_bindings(prepared.bindings, prepared.call)
				None:
					expr
		_:
			expr


private pure func unbox_copies_alias(kind: CoreUnboxKind) -> Bool:
	match kind:
		PointerUnbox:
			False
		_:
			True


private pure func result_mode_may_alias_argument(mode: OwnershipResultMode) -> Bool:
	match mode:
		ReturnAliasOfArg(index):
			True
		ReturnBorrowed:
			True
		_:
			False


private pure func bind_borrowed_owned_temporary_args_through_unbox(
	env: PerceusEnv,
	expr: CoreExpr,
) -> CoreExpr:
	match expr:
		UnboxExpr(unbox_kind, CallExpr(kind, callee, args, call_type, call_loc), typ, loc):
			match contract_for_call(env, kind, args.length(), call_type):
				Some(contract):
					if (
						unbox_copies_alias(unbox_kind)
						and result_mode_may_alias_argument(contract.result)
					):
						prepared: PreparedTemporaryCall = prepare_borrowed_owned_temporary_call(
							env,
							kind,
							callee,
							args,
							call_type,
							call_loc,
							contract,
							True,
						)
						unboxed: CoreExpr = UnboxExpr(
							unbox_kind,
							prepared.call,
							copy_core_type(typ),
							loc,
						)
						wrap_borrowed_owned_temporary_bindings(prepared.bindings, unboxed)
					else:
						expr
				None:
					expr
		_:
			expr


private pure func retain_alias_as_owned(expr: CoreExpr) -> CoreExpr:
	typ: CoreType = expr_result_type(expr)
	temp: CoreVar = {
		name = "__owned_result",
		uniq = 0,
		def_id = None
	}

	loc: CoreSourceLoc = match expr:
		VarExpr(variable, value_type, value_loc):
			value_loc
		FieldExpr(owner, field, value_type, value_loc):
			value_loc
		TupleFieldExpr(owner, field_index, value_type, value_loc):
			value_loc
		ListGetExpr(get, value_type, value_loc):
			value_loc
		CallExpr(kind, callee, args, value_type, value_loc):
			value_loc
		CastExpr(inner, value_type, value_loc):
			value_loc
		UnboxExpr(kind, inner, value_type, value_loc):
			value_loc
		_:
			SyntheticSourceLoc

	BorrowLetExpr(
		copy_core_var(temp),
		copy_core_type(typ),
		expr,
		DupExpr(
			copy_core_var(temp),
			copy_core_type(typ),
			retain_policy_for_type(typ),
			VarExpr(copy_core_var(temp), copy_core_type(typ), loc),
			copy_core_type(typ),
			loc,
		),
	)


private pure func managed_pointer_unbox_alias(
	env: PerceusEnv,
	kind: CoreUnboxKind,
	typ: CoreType,
) -> Bool:
	match kind:
		PointerUnbox:
			is_managed_type(env, typ)
		_:
			False


private pure func owned_result_is_alias(env: PerceusEnv, expr: CoreExpr) -> Bool:
	match expr:
		FieldExpr(owner, field, typ, loc):
			True
		TupleFieldExpr(owner, field_index, typ, loc):
			True
		ListGetExpr(get, typ, loc):
			True
		CastExpr(inner, typ, loc):
			owned_result_is_alias(env, inner)
		UnboxExpr(kind, inner, typ, loc):
			managed_pointer_unbox_alias(env, kind, typ) or owned_result_is_alias(env, inner)
		CallExpr(kind, callee, args, typ, loc):
			match contract_for_call(env, kind, args.length(), typ):
				Some(contract):
					match contract.result:
						ReturnBorrowed:
							True
						ReturnAliasOfArg(index):
							True
						_:
							False
				None:
					False
		_:
			False


private pure func same_core_var(left: CoreVar, right: CoreVar) -> Bool:
	left.name == right.name and left.uniq == right.uniq and left.def_id == right.def_id


private pure func add_transferable_result_var(
	variables: List[CoreVar],
	variable: CoreVar,
) -> List[CoreVar]:
	if variables.any(func(candidate): same_core_var(candidate, variable)):
		variables
	else:
		variables.append(copy_core_var(variable))


private pure func remove_transferable_result_var(
	variables: List[CoreVar],
	variable: CoreVar,
) -> List[CoreVar]:
	variables.filter(func(candidate): not same_core_var(candidate, variable))


private pure func result_transfers_existing_owner(env: PerceusEnv, expr: CoreExpr) -> Bool:
	match expr:
		VarExpr(variable, typ, loc):
			env.transferable_result_vars.any(
				func(transferable): same_core_var(transferable, variable),
			)
		_:
			False


private pure func normalize_owned_result_literal_case(
	env: PerceusEnv,
	match_case: CoreLiteralMatchCase,
) -> CoreLiteralMatchCase:
	{ match_case | body = normalize_owned_result_aliases(env, match_case.body) }


private pure func normalize_owned_result_literal_cases(
	env: PerceusEnv,
	cases: List[CoreLiteralMatchCase],
) -> List[CoreLiteralMatchCase]:
	var normalized: List[CoreLiteralMatchCase] = []

	for match_case in cases:
		normalized = normalized.append(normalize_owned_result_literal_case(env, match_case))

	normalized


private pure func normalize_owned_result_literal_fallback(
	env: PerceusEnv,
	fallback: CoreLiteralMatchFallback,
) -> CoreLiteralMatchFallback:
	match fallback:
		LiteralMatchFallbackBody(body):
			LiteralMatchFallbackBody(normalize_owned_result_aliases(env, body))
		LiteralMatchFallbackBindings(bindings, body):
			LiteralMatchFallbackBindings(
				bindings,
				normalize_owned_result_aliases(env, body),
			)
		LiteralMatchFallbackFail:
			LiteralMatchFallbackFail


private pure func normalize_owned_result_literal_match(
	env: PerceusEnv,
	match_expr: CoreConstructorLiteralMatch,
) -> CoreConstructorLiteralMatch:
	{ match_expr |
		cases = normalize_owned_result_literal_cases(env, match_expr.cases),
		fallback = normalize_owned_result_literal_fallback(env, match_expr.fallback)
	}


private pure func normalize_owned_result_constructor_body(
	env: PerceusEnv,
	body: CoreConstructorMatchBody,
) -> CoreConstructorMatchBody:
	match body:
		ConstructorMatchBodyExpr(expr):
			ConstructorMatchBodyExpr(normalize_owned_result_aliases(env, expr))
		ConstructorMatchBodyLiteral(match_expr):
			ConstructorMatchBodyLiteral(normalize_owned_result_literal_match(env, match_expr))
		ConstructorMatchBodyLength(match_expr):
			ConstructorMatchBodyLength(normalize_owned_result_length_match(env, match_expr))


private pure func normalize_owned_result_length_branch(
	env: PerceusEnv,
	branch: CoreConstructorLengthMatchBranch,
) -> CoreConstructorLengthMatchBranch:
	{ branch | body = normalize_owned_result_constructor_body(env, branch.body) }


private pure func normalize_owned_result_length_cases(
	env: PerceusEnv,
	cases: List[CoreConstructorLengthMatchCase],
) -> List[CoreConstructorLengthMatchCase]:
	var normalized: List[CoreConstructorLengthMatchCase] = []

	for match_case in cases:
		normalized = normalized.append(
			{ match_case | branch = normalize_owned_result_length_branch(env, match_case.branch) },
		)

	normalized


private pure func normalize_owned_result_length_geq(
	env: PerceusEnv,
	geq: Option[CoreConstructorLengthMatchGeq],
) -> Option[CoreConstructorLengthMatchGeq]:
	match geq:
		Some(match_case):
			Some(
				{ match_case |
					branch = normalize_owned_result_length_branch(env, match_case.branch)
				},
			)
		None:
			None


private pure func normalize_owned_result_length_fallback(
	env: PerceusEnv,
	fallback: Option[CoreConstructorLengthMatchBranch],
) -> Option[CoreConstructorLengthMatchBranch]:
	match fallback:
		Some(branch):
			Some(normalize_owned_result_length_branch(env, branch))
		None:
			None


private pure func normalize_owned_result_length_match(
	env: PerceusEnv,
	match_expr: CoreConstructorLengthMatch,
) -> CoreConstructorLengthMatch:
	{ match_expr |
		cases = normalize_owned_result_length_cases(env, match_expr.cases),
		geq = normalize_owned_result_length_geq(env, match_expr.geq),
		fallback = normalize_owned_result_length_fallback(env, match_expr.fallback)
	}


private pure func normalize_owned_result_constructor_cases(
	env: PerceusEnv,
	cases: List[CoreConstructorMatchCase],
) -> List[CoreConstructorMatchCase]:
	var normalized: List[CoreConstructorMatchCase] = []

	for match_case in cases:
		normalized = normalized.append(
			{ match_case | body = normalize_owned_result_constructor_body(env, match_case.body) },
		)

	normalized


private pure func normalize_owned_result_constructor_fallback(
	env: PerceusEnv,
	fallback: CoreConstructorMatchFallback,
) -> CoreConstructorMatchFallback:
	match fallback:
		ConstructorMatchFallbackBody(body):
			ConstructorMatchFallbackBody(normalize_owned_result_aliases(env, body))
		ConstructorMatchFallbackBindings(bindings, body):
			ConstructorMatchFallbackBindings(
				bindings,
				normalize_owned_result_aliases(env, body),
			)
		ConstructorMatchFallbackFail:
			ConstructorMatchFallbackFail


private pure func normalize_owned_result_aliases(env: PerceusEnv, expr: CoreExpr) -> CoreExpr:
	if result_transfers_existing_owner(env, expr):
		expr
	else if is_owned_temporary_expr(env, expr):
		expr
	else if is_managed_type(env, expr_result_type(expr)) and owned_result_is_alias(env, expr):
		retain_alias_as_owned(expr)
	else:
		match expr:
			IfExpr(cond, then_expr, else_expr, typ, loc):
				IfExpr(
					cond,
					normalize_owned_result_aliases(env, then_expr),
					normalize_owned_result_aliases(env, else_expr),
					copy_core_type(typ),
					loc,
				)
			LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
				LiteralMatchExpr(
					scrutinee,
					normalize_owned_result_literal_cases(env, cases),
					normalize_owned_result_literal_fallback(env, fallback),
					copy_core_type(typ),
					loc,
				)
			AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
				AccessorLiteralMatchExpr(
					scrutinee,
					release_policy,
					normalize_owned_result_literal_match(env, match_expr),
					copy_core_type(typ),
					loc,
				)
			LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
				LengthMatchExpr(
					scrutinee,
					release_policy,
					normalize_owned_result_length_match(env, match_expr),
					copy_core_type(typ),
					loc,
				)
			ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
				ConstructorMatchExpr(
					scrutinee,
					release_policy,
					normalize_owned_result_constructor_cases(env, cases),
					normalize_owned_result_constructor_fallback(env, fallback),
					copy_core_type(typ),
					loc,
				)
			LetExpr(variable, is_mutable, typ, rhs, body):
				body_env: PerceusEnv = if is_managed_type(env, typ):
					{ env |
						transferable_result_vars = add_transferable_result_var(
							env.transferable_result_vars,
							variable,
						)
					}
				else:
					env

				LetExpr(
					copy_core_var(variable),
					is_mutable,
					copy_core_type(typ),
					rhs,
					normalize_owned_result_aliases(body_env, body),
				)
			BorrowLetExpr(variable, typ, rhs, body):
				body_env: PerceusEnv = { env |
					transferable_result_vars = remove_transferable_result_var(
						env.transferable_result_vars,
						variable,
					)
				}
				BorrowLetExpr(
					copy_core_var(variable),
					copy_core_type(typ),
					rhs,
					normalize_owned_result_aliases(body_env, body),
				)
			SeqExpr(first, second):
				SeqExpr(
					first,
					normalize_owned_result_aliases(env, second),
				)
			DupExpr(variable, value_type, retain_policy, body, typ, loc):
				DupExpr(
					copy_core_var(variable),
					copy_core_type(value_type),
					retain_policy,
					normalize_owned_result_aliases(env, body),
					copy_core_type(typ),
					loc,
				)
			DropExpr(variable, value_type, release_policy, body, typ, loc):
				DropExpr(
					copy_core_var(variable),
					copy_core_type(value_type),
					release_policy,
					normalize_owned_result_aliases(env, body),
					copy_core_type(typ),
					loc,
				)
			ResourceScopeExpr(scope, typ, loc):
				ResourceScopeExpr(
					{ scope | body = normalize_owned_result_aliases(env, scope.body) },
					copy_core_type(typ),
					loc,
				)
			TensorRawViewLetExpr(binding, body, typ, loc):
				TensorRawViewLetExpr(
					binding,
					normalize_owned_result_aliases(env, body),
					copy_core_type(typ),
					loc,
				)
			ListHandoffExpr(handoff, typ, loc):
				ListHandoffExpr(
					{ handoff | body = normalize_owned_result_aliases(env, handoff.body) },
					copy_core_type(typ),
					loc,
				)
			_:
				expr


private pure func retain_assignment_alias_rhs(env: PerceusEnv, expr: CoreExpr) -> CoreExpr:
	match expr:
		AssignExpr(variable, rhs, typ, loc):
			if (
				variable.name != "_"
				and is_managed_type(env, expr_result_type(rhs))
				and assignment_rhs_returns_alias(env, rhs)
			):
				AssignExpr(variable, retain_alias_as_owned(rhs), typ, loc)
			else:
				expr
		_:
			expr


private pure func normalize_binding_alias_match_results(
	env: PerceusEnv,
	bindings: List[CoreMatchBinding],
	expr: CoreExpr,
) -> CoreExpr:
	CoreTraverse.map_core_match_results(
		expr,
		func(
			nested_bindings,
			result,
		): normalize_scoped_binding_alias_result(env, bindings + nested_bindings, result),
	)


private pure func normalize_scoped_binding_alias_result(
	env: PerceusEnv,
	bindings: List[CoreMatchBinding],
	expr: CoreExpr,
) -> CoreExpr:
	if is_owned_temporary_expr(env, expr):
		expr
	else:
		match expr:
			IfExpr(cond, then_expr, else_expr, typ, loc):
				IfExpr(
					cond,
					normalize_scoped_binding_alias_result(env, bindings, then_expr),
					normalize_scoped_binding_alias_result(env, bindings, else_expr),
					copy_core_type(typ),
					loc,
				)
			LetExpr(variable, is_mutable, typ, rhs, body):
				LetExpr(
					copy_core_var(variable),
					is_mutable,
					copy_core_type(typ),
					rhs,
					normalize_scoped_binding_alias_result(env, bindings, body),
				)
			BorrowLetExpr(variable, typ, rhs, body):
				BorrowLetExpr(
					copy_core_var(variable),
					copy_core_type(typ),
					rhs,
					normalize_scoped_binding_alias_result(env, bindings, body),
				)
			SeqExpr(first, second):
				SeqExpr(
					first,
					normalize_scoped_binding_alias_result(env, bindings, second),
				)
			LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
				normalize_binding_alias_match_results(env, bindings, expr)
			AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
				normalize_binding_alias_match_results(env, bindings, expr)
			LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
				normalize_binding_alias_match_results(env, bindings, expr)
			ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
				normalize_binding_alias_match_results(env, bindings, expr)
			_:
				shadowed_match_binding: Bool = match expr:
					VarExpr(variable, typ, loc):
						match_bindings_shadow(variable.name, bindings)
					_:
						False

				if (
					not shadowed_match_binding
					and is_managed_type(env, expr_result_type(expr))
					and assignment_rhs_returns_alias(env, expr)
				):
					retain_alias_as_owned(expr)
				else:
					expr


private pure func normalize_binding_alias_result(env: PerceusEnv, expr: CoreExpr) -> CoreExpr:
	normalize_scoped_binding_alias_result(env, [], expr)


private pure func normalize_binding_alias_rhs(
	env: PerceusEnv,
	bind_type: CoreType,
	rhs: CoreExpr,
) -> CoreExpr:
	if not is_managed_type(env, bind_type):
		rhs
	else:
		match rhs:
			VarExpr(variable, typ, loc):
				DupExpr(
					copy_core_var(variable),
					copy_core_type(bind_type),
					retain_policy_for_type(bind_type),
					rhs,
					copy_core_type(bind_type),
					loc,
				)
			FieldExpr(owner, field, typ, loc):
				retain_alias_as_owned(rhs)
			TupleFieldExpr(owner, field_index, typ, loc):
				retain_alias_as_owned(rhs)
			_:
				normalize_binding_alias_result(env, rhs)


private pure func body_starts_with_dup(name: String, body: CoreExpr) -> Bool:
	match body:
		DupExpr(variable, value_type, retain_policy, inner, typ, loc):
			variable.name == name
		_:
			False


private pure func retain_alias_source_in_body(
	env: PerceusEnv,
	variable: CoreVar,
	bind_type: CoreType,
	rhs: CoreExpr,
	body: CoreExpr,
) -> CoreExpr:
	if not is_managed_type(env, bind_type) or body_starts_with_dup(variable.name, body):
		body
	else:
		body_type: CoreType = expr_result_type(body)

		match rhs:
			VarExpr(source, source_type, source_loc):
				body
			FieldExpr(owner, field, field_type, field_loc):
				body
			TupleFieldExpr(owner, field_index, field_type, field_loc):
				body
			_:
				body


private pure func balance_concurrent_binding_body(
	env: PerceusEnv,
	variable: CoreVar,
	typ: CoreType,
	body: CoreExpr,
) -> CoreExpr:
	if not is_managed_type(env, typ):
		body
	else:
		balance_let_body_legacy(env, variable, typ, body)


private pure func retain_direct_field_alias_value(env: PerceusEnv, value: CoreExpr) -> CoreExpr:
	match value:
		FieldExpr(owner, field, typ, loc):
			if is_managed_type(env, typ) and direct_field_alias(value):
				temp: CoreVar = synthetic_binding_var("aggregate_field", 0, loc)
				BorrowLetExpr(
					copy_core_var(temp),
					copy_core_type(typ),
					copy_expr(value),
					DupExpr(
						copy_core_var(temp),
						copy_core_type(typ),
						retain_policy_for_type(typ),
						VarExpr(copy_core_var(temp), copy_core_type(typ), loc),
						copy_core_type(typ),
						loc,
					),
				)
			else:
				copy_expr(value)
		TupleFieldExpr(owner, field_index, typ, loc):
			if is_managed_type(env, typ) and direct_field_alias(value):
				temp: CoreVar = synthetic_binding_var("aggregate_field", 0, loc)
				BorrowLetExpr(
					copy_core_var(temp),
					copy_core_type(typ),
					copy_expr(value),
					DupExpr(
						copy_core_var(temp),
						copy_core_type(typ),
						retain_policy_for_type(typ),
						VarExpr(copy_core_var(temp), copy_core_type(typ), loc),
						copy_core_type(typ),
						loc,
					),
				)
			else:
				copy_expr(value)
		_:
			copy_expr(value)


private pure func retain_direct_field_alias_exprs(
	env: PerceusEnv,
	values: List[CoreExpr],
) -> List[CoreExpr]:
	var retained: List[CoreExpr] = []

	for value in values:
		owned_value: CoreExpr = retain_direct_field_alias_value(env, value)
		rewritten_value: CoreExpr = insert_drops_expr_inner(env, owned_value)
		retained = retained.append(rewritten_value)

	retained


private pure func retain_direct_field_alias_record_fields(
	env: PerceusEnv,
	fields: List[CoreRecordFieldValue],
) -> List[CoreRecordFieldValue]:
	var retained: List[CoreRecordFieldValue] = []

	for field in fields:
		field_name: String = field.name
		owned_value: CoreExpr = retain_direct_field_alias_value(env, field.value)
		rewritten_value: CoreExpr = insert_drops_expr_inner(env, owned_value)
		retained = retained.append({
			name = field_name,
			value = rewritten_value,
		})

	retained


private pure func retain_direct_field_alias_boxed_value(
	env: PerceusEnv,
	value: CoreBoxedStorageValue,
) -> CoreBoxedStorageValue:
	kind = value.kind
	needs_release: Bool = value.needs_release
	transfers_ownership: Bool = (
		value.transfers_ownership
		or needs_release and is_owned_temporary_expr(env, value.value)
	)

	owned_value: CoreExpr = if transfers_ownership:
		retain_direct_field_alias_value(env, value.value)
	else:
		copy_expr(value.value)

	rewritten_value: CoreExpr = insert_drops_expr_inner(env, owned_value)
	{
		kind = kind,
		value = rewritten_value,
		needs_release = needs_release,
		transfers_ownership = transfers_ownership
	}


private pure func retain_direct_field_alias_boxed_values(
	env: PerceusEnv,
	values: List[CoreBoxedStorageValue],
) -> List[CoreBoxedStorageValue]:
	var retained: List[CoreBoxedStorageValue] = []

	for value in values:
		retained = retained.append(retain_direct_field_alias_boxed_value(env, value))

	retained


private pure func retain_direct_field_alias_dict_entries(
	env: PerceusEnv,
	entries: List[CoreDictEntry],
) -> List[CoreDictEntry]:
	var retained: List[CoreDictEntry] = []

	for entry in entries:
		key = entry.key
		value = entry.value
		retained = retained.append({
			key = retain_direct_field_alias_boxed_value(env, key),
			value = retain_direct_field_alias_boxed_value(env, value),
		})

	retained


private pure func rewrite_aggregate_with_owned_field_aliases(
	env: PerceusEnv,
	expr: CoreExpr,
) -> CoreExpr:
	match expr:
		TupleExpr(items, typ, loc):
			owned_type: CoreType = copy_core_type(typ)
			rewritten_items: List[CoreExpr] = retain_direct_field_alias_exprs(env, items)
			TupleExpr(rewritten_items, owned_type, loc)
		VectorExpr(items, typ, loc):
			owned_type: CoreType = copy_core_type(typ)
			rewritten_items: List[CoreExpr] = retain_direct_field_alias_exprs(env, items)
			VectorExpr(rewritten_items, owned_type, loc)
		RecordExpr(fields, typ, loc):
			owned_type: CoreType = copy_core_type(typ)
			rewritten_fields: List[CoreRecordFieldValue] = retain_direct_field_alias_record_fields(
				env,
				fields,
			)
			RecordExpr(rewritten_fields, owned_type, loc)
		RecordConstructExpr(type_name, fields, typ, loc):
			owned_type_name: String = type_name
			owned_type: CoreType = copy_core_type(typ)
			rewritten_fields: List[CoreRecordFieldValue] = retain_direct_field_alias_record_fields(
				env,
				fields,
			)
			RecordConstructExpr(owned_type_name, rewritten_fields, owned_type, loc)
		ListConstructExpr(construct, typ, loc):
			elements: List[CoreBoxedStorageValue] = construct.elements
			owned_construct = { construct | elements = [] }
			owned_type: CoreType = copy_core_type(typ)
			rewritten_elements: List[CoreBoxedStorageValue] = retain_direct_field_alias_boxed_values(
				env,
				elements,
			)
			ListConstructExpr({ owned_construct | elements = rewritten_elements }, owned_type, loc)
		TensorBoxedLiteralExpr(literal, typ, loc):
			elements: List[CoreBoxedStorageValue] = literal.elements
			owned_literal = { literal | elements = [] }
			owned_type: CoreType = copy_core_type(typ)
			rewritten_elements: List[CoreBoxedStorageValue] = retain_direct_field_alias_boxed_values(
				env,
				elements,
			)
			TensorBoxedLiteralExpr(
				{ owned_literal | elements = rewritten_elements },
				owned_type,
				loc,
			)
		DictConstructExpr(construct, typ, loc):
			entries: List[CoreDictEntry] = construct.entries
			owned_construct = { construct | entries = [] }
			owned_type: CoreType = copy_core_type(typ)
			rewritten_entries: List[CoreDictEntry] = retain_direct_field_alias_dict_entries(
				env,
				entries,
			)
			DictConstructExpr({ owned_construct | entries = rewritten_entries }, owned_type, loc)
		UnionConstructExpr(construct, typ, loc):
			args: List[CoreBoxedStorageValue] = construct.args
			owned_construct = { construct | args = [] }
			owned_type: CoreType = copy_core_type(typ)
			rewritten_args: List[CoreBoxedStorageValue] = retain_direct_field_alias_boxed_values(
				env,
				args,
			)
			UnionConstructExpr({ owned_construct | args = rewritten_args }, owned_type, loc)
		_:
			expr


private pure func normalize_ownership_node(env: PerceusEnv, expr: CoreExpr) -> CoreExpr:
	match expr:
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			retain_borrowed_match_binding_results(env, expr)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			retain_borrowed_match_binding_results(env, expr)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			retain_borrowed_match_binding_results(env, expr)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			retain_borrowed_match_binding_results(env, expr)
		CallExpr(kind, callee, args, typ, loc):
			field_safe: CoreExpr = protect_consuming_field_aliases(env, expr)
			bind_borrowed_owned_temporary_args_at_call(env, field_safe)
		UnboxExpr(kind, inner, typ, loc):
			bind_borrowed_owned_temporary_args_through_unbox(env, expr)
		BinaryExpr(op, left, right, typ, loc):
			protect_consuming_field_aliases(env, expr)
		_:
			expr


-- Match cleanup can forward a branch result through a temporary, hiding the
-- fact that one branch returns a mutable slot directly. Retain those branch
-- results while the source result-position structure is still explicit.
private pure func retain_mutable_match_branch_results(
	env: PerceusEnv,
	param: CoreParam,
	expr: CoreExpr,
) -> CoreExpr:
	match expr:
		SeqExpr(first, second):
			SeqExpr(
				first,
				retain_mutable_match_branch_results(env, param, second),
			)
		LetExpr(variable, is_mutable, typ, rhs, body):
			if core_var_matches_param(variable, param):
				LetExpr(variable, is_mutable, typ, rhs, body)
			else:
				LetExpr(
					variable,
					is_mutable,
					typ,
					rhs,
					retain_mutable_match_branch_results(env, param, body),
				)
		BorrowLetExpr(variable, typ, rhs, body):
			if core_var_matches_param(variable, param):
				BorrowLetExpr(variable, typ, rhs, body)
			else:
				BorrowLetExpr(
					variable,
					typ,
					rhs,
					retain_mutable_match_branch_results(env, param, body),
				)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			IfExpr(
				cond,
				retain_mutable_match_branch_results(env, param, then_expr),
				retain_mutable_match_branch_results(env, param, else_expr),
				typ,
				loc,
			)
		LiteralMatchExpr(_, _, _, _, _):
			retain_borrowed_param_result(env, param, expr)
		AccessorLiteralMatchExpr(_, _, _, _, _):
			retain_borrowed_param_result(env, param, expr)
		LengthMatchExpr(_, _, _, _, _):
			retain_borrowed_param_result(env, param, expr)
		ConstructorMatchExpr(_, _, _, _, _, _):
			retain_borrowed_param_result(env, param, expr)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			DupExpr(
				variable,
				value_type,
				retain_policy,
				retain_mutable_match_branch_results(env, param, body),
				typ,
				loc,
			)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			DropExpr(
				variable,
				value_type,
				release_policy,
				retain_mutable_match_branch_results(env, param, body),
				typ,
				loc,
			)
		_:
			expr


private pure func rewrite_managed_let(
	env: PerceusEnv,
	variable: CoreVar,
	is_mutable: Bool,
	bind_type: CoreType,
	rhs: CoreExpr,
	body: CoreExpr,
) -> CoreExpr:
	owned_rhs: CoreExpr = normalize_binding_alias_rhs(env, bind_type, rhs)
	rewritten_rhs: CoreExpr = insert_drops_expr_inner(env, owned_rhs)

	branch_safe_body: CoreExpr = if is_mutable:
		retain_mutable_match_branch_results(
			env,
			{
				name = copy_core_var(variable),
				typ = copy_core_type(bind_type),
				loc = SyntheticSourceLoc
			},
			body,
		)
	else:
		body

	rewritten_body: CoreExpr = insert_drops_expr_inner(env, branch_safe_body)
	managed_binding: Bool = not is_immortal_closure_expr(env, owned_rhs)

	balances_nested_matches: Bool = (
		managed_binding
		and balanced_path_has_divergent_constructor_match(variable.name, rewritten_body)
	)

	balance_env: PerceusEnv = { env | balance_nested_matches = balances_nested_matches }

	ownership_body: CoreExpr = if managed_binding:
		freshen_shadowed_match_bindings(variable, rewritten_body)
	else:
		rewritten_body

	if not managed_binding:
		LetExpr(
			copy_core_var(variable),
			is_mutable,
			copy_core_type(bind_type),
			rewritten_rhs,
			rewritten_body,
		)
	else if is_mutable:
		mutable_body: CoreExpr = rewrite_mutable_let_body(env, variable, bind_type, ownership_body)
		LetExpr(
			copy_core_var(variable),
			True,
			copy_core_type(bind_type),
			rewritten_rhs,
			retain_alias_source_in_body(env, variable, bind_type, rhs, mutable_body),
		)
	else:
		protected_body: CoreExpr = protect_repeated_consumes(
			env,
			variable,
			bind_type,
			ownership_body,
			False,
		)

		balanced_body: CoreExpr = match protected_body:
			IfExpr(cond, then_expr, else_expr, typ, loc):
				transform_let_if_body(
					balance_env,
					variable,
					bind_type,
					cond,
					then_expr,
					else_expr,
					typ,
					loc,
				)
			ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
				match transform_let_constructor_match_body(
					balance_env,
					variable,
					bind_type,
					copy_expr(scrutinee),
					release_policy,
					CoreTraverse.map_core_constructor_match_cases(cases, copy_expr),
					CoreTraverse.map_core_constructor_match_fallback(fallback, copy_expr),
					copy_core_type(typ),
					loc,
				):
					Some(balanced_match):
						copy_expr(balanced_match)
					None:
						balance_let_body_legacy(balance_env, variable, bind_type, protected_body)
			_:
				balance_let_body_legacy(balance_env, variable, bind_type, protected_body)

		alias_retained_body: CoreExpr = if body_starts_with_dup(variable.name, body):
			balanced_body
		else:
			retain_alias_source_in_body(env, variable, bind_type, rhs, balanced_body)

		LetExpr(
			copy_core_var(variable),
			False,
			copy_core_type(bind_type),
			rewritten_rhs,
			alias_retained_body,
		)


private pure func rewrite_constructor_literal_match_case(
	env: PerceusEnv,
	match_case: CoreLiteralMatchCase,
) -> CoreLiteralMatchCase:
	{ match_case | body = insert_drops_expr_inner(env, match_case.body) }


private pure func rewrite_constructor_literal_match_cases(
	env: PerceusEnv,
	cases: List[CoreLiteralMatchCase],
) -> List[CoreLiteralMatchCase]:
	var rewritten: List[CoreLiteralMatchCase] = []

	for match_case in cases:
		rewritten = rewritten.append(rewrite_constructor_literal_match_case(env, match_case))

	rewritten


private pure func rewrite_constructor_literal_match_fallback(
	env: PerceusEnv,
	fallback: CoreLiteralMatchFallback,
) -> CoreLiteralMatchFallback:
	match fallback:
		LiteralMatchFallbackBody(body):
			LiteralMatchFallbackBody(insert_drops_expr_inner(env, body))
		LiteralMatchFallbackBindings(bindings, body):
			LiteralMatchFallbackBindings(
				bindings,
				insert_drops_expr_inner(env, body),
			)
		LiteralMatchFallbackFail:
			LiteralMatchFallbackFail


private pure func rewrite_constructor_literal_match(
	env: PerceusEnv,
	match_expr: CoreConstructorLiteralMatch,
) -> CoreConstructorLiteralMatch:
	{ match_expr |
		cases = rewrite_constructor_literal_match_cases(env, match_expr.cases),
		fallback = rewrite_constructor_literal_match_fallback(env, match_expr.fallback)
	}


private pure func rewrite_constructor_match_body(
	env: PerceusEnv,
	body: CoreConstructorMatchBody,
) -> CoreConstructorMatchBody:
	match body:
		ConstructorMatchBodyExpr(expr):
			ConstructorMatchBodyExpr(insert_drops_expr_inner(env, expr))
		ConstructorMatchBodyLiteral(match_expr):
			ConstructorMatchBodyLiteral(rewrite_constructor_literal_match(env, match_expr))
		ConstructorMatchBodyLength(match_expr):
			ConstructorMatchBodyLength(rewrite_constructor_length_match(env, match_expr))


private pure func rewrite_constructor_length_branch(
	env: PerceusEnv,
	branch: CoreConstructorLengthMatchBranch,
) -> CoreConstructorLengthMatchBranch:
	{ branch | body = rewrite_constructor_match_body(env, branch.body) }


private pure func rewrite_constructor_length_case(
	env: PerceusEnv,
	match_case: CoreConstructorLengthMatchCase,
) -> CoreConstructorLengthMatchCase:
	{ match_case | branch = rewrite_constructor_length_branch(env, match_case.branch) }


private pure func rewrite_constructor_length_cases(
	env: PerceusEnv,
	cases: List[CoreConstructorLengthMatchCase],
) -> List[CoreConstructorLengthMatchCase]:
	var rewritten: List[CoreConstructorLengthMatchCase] = []

	for match_case in cases:
		rewritten = rewritten.append(rewrite_constructor_length_case(env, match_case))

	rewritten


private pure func rewrite_constructor_length_geq(
	env: PerceusEnv,
	geq: Option[CoreConstructorLengthMatchGeq],
) -> Option[CoreConstructorLengthMatchGeq]:
	match geq:
		Some(value):
			Some({ value | branch = rewrite_constructor_length_branch(env, value.branch) })
		None:
			None


private pure func rewrite_constructor_length_fallback(
	env: PerceusEnv,
	fallback: Option[CoreConstructorLengthMatchBranch],
) -> Option[CoreConstructorLengthMatchBranch]:
	match fallback:
		Some(branch):
			Some(rewrite_constructor_length_branch(env, branch))
		None:
			None


private pure func rewrite_constructor_length_match(
	env: PerceusEnv,
	match_expr: CoreConstructorLengthMatch,
) -> CoreConstructorLengthMatch:
	{ match_expr |
		cases = rewrite_constructor_length_cases(env, match_expr.cases),
		geq = rewrite_constructor_length_geq(env, match_expr.geq),
		fallback = rewrite_constructor_length_fallback(env, match_expr.fallback)
	}


private pure func rewrite_constructor_match_case(
	env: PerceusEnv,
	match_case: CoreConstructorMatchCase,
) -> CoreConstructorMatchCase:
	{ match_case | body = rewrite_constructor_match_body(env, match_case.body) }


private pure func rewrite_constructor_match_cases(
	env: PerceusEnv,
	cases: List[CoreConstructorMatchCase],
) -> List[CoreConstructorMatchCase]:
	var rewritten: List[CoreConstructorMatchCase] = []

	for match_case in cases:
		rewritten = rewritten.append(rewrite_constructor_match_case(env, match_case))

	rewritten


private pure func rewrite_constructor_match_fallback(
	env: PerceusEnv,
	fallback: CoreConstructorMatchFallback,
) -> CoreConstructorMatchFallback:
	match fallback:
		ConstructorMatchFallbackBody(body):
			ConstructorMatchFallbackBody(insert_drops_expr_inner(env, body))
		ConstructorMatchFallbackBindings(bindings, body):
			ConstructorMatchFallbackBindings(
				bindings,
				insert_drops_expr_inner(env, body),
			)
		ConstructorMatchFallbackFail:
			ConstructorMatchFallbackFail


private pure func rewrite_boxed_values(
	env: PerceusEnv,
	values: List[CoreBoxedStorageValue],
) -> List[CoreBoxedStorageValue]:
	var rewritten: List[CoreBoxedStorageValue] = []

	for value in values:
		rewritten = rewritten.append({ value | value = insert_drops_expr_inner(env, value.value) })

	rewritten


private pure func rewrite_record_fields(
	env: PerceusEnv,
	fields: List[CoreRecordFieldValue],
) -> List[CoreRecordFieldValue]:
	var rewritten: List[CoreRecordFieldValue] = []

	for field in fields:
		rewritten = rewritten.append({ field | value = insert_drops_expr_inner(env, field.value) })

	rewritten


private pure func rewrite_dict_entries(
	env: PerceusEnv,
	entries: List[CoreDictEntry],
) -> List[CoreDictEntry]:
	var rewritten: List[CoreDictEntry] = []

	for entry in entries:
		rewritten = rewritten.append({ entry |
				key = { entry.key | value = insert_drops_expr_inner(env, entry.key.value) },
				value = { entry.value | value = insert_drops_expr_inner(env, entry.value.value) }
			})

	rewritten


private pure func rewrite_pre_closure_concurrent_bindings(
	env: PerceusEnv,
	bindings: List[CorePreClosureConcurrentBinding],
) -> List[CorePreClosureConcurrentBinding]:
	var rewritten: List[CorePreClosureConcurrentBinding] = []

	for binding in bindings:
		rewritten = rewritten.append({ binding | rhs = insert_drops_expr_inner(env, binding.rhs) })

	rewritten


private pure func retain_borrowed_loop_body(
	env: PerceusEnv,
	binder: CoreLoopBinder,
	body: CoreExpr,
) -> CoreExpr:
	if is_managed_type(env, binder.typ):
		retain_borrowed_owned_uses(
			env,
			{
				name = copy_core_var(binder.variable),
				typ = copy_core_type(binder.typ),
				loc = SyntheticSourceLoc
			},
			body,
		)
	else:
		body


private pure func rewrite_loop_body(
	env: PerceusEnv,
	binder: CoreLoopBinder,
	body: CoreExpr,
) -> CoreExpr:
	retained_body: CoreExpr = retain_borrowed_loop_body(env, binder, body)
	insert_drops_expr_inner(env, retained_body)


private pure func insert_drops_ownership_node(env: PerceusEnv, expr: CoreExpr) -> CoreExpr:
	normalized: CoreExpr = normalize_ownership_node(env, expr)
	insert_drops_normalized_expr(env, normalized)


private pure func insert_drops_expr_inner(env: PerceusEnv, expr: CoreExpr) -> CoreExpr:
	match expr:
		LetExpr(variable, is_mutable, bind_type, rhs, body):
			if is_managed_type(env, bind_type):
				rewrite_managed_let(env, variable, is_mutable, bind_type, rhs, body)
			else:
				rewritten_rhs: CoreExpr = insert_drops_expr_inner(env, rhs)
				rewritten_body: CoreExpr = insert_drops_expr_inner(env, body)
				owned_variable: CoreVar = copy_core_var(variable)
				owned_bind_type: CoreType = copy_core_type(bind_type)
				LetExpr(owned_variable, is_mutable, owned_bind_type, rewritten_rhs, rewritten_body)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			insert_drops_ownership_node(env, expr)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			insert_drops_ownership_node(env, expr)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			insert_drops_ownership_node(env, expr)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			insert_drops_ownership_node(env, expr)
		TupleExpr(items, typ, loc):
			rewrite_aggregate_with_owned_field_aliases(env, expr)
		VectorExpr(items, typ, loc):
			rewrite_aggregate_with_owned_field_aliases(env, expr)
		RecordExpr(fields, typ, loc):
			rewrite_aggregate_with_owned_field_aliases(env, expr)
		RecordConstructExpr(type_name, fields, typ, loc):
			rewrite_aggregate_with_owned_field_aliases(env, expr)
		ListConstructExpr(construct, typ, loc):
			rewrite_aggregate_with_owned_field_aliases(env, expr)
		TensorBoxedLiteralExpr(literal, typ, loc):
			rewrite_aggregate_with_owned_field_aliases(env, expr)
		DictConstructExpr(construct, typ, loc):
			rewrite_aggregate_with_owned_field_aliases(env, expr)
		UnionConstructExpr(construct, typ, loc):
			rewrite_aggregate_with_owned_field_aliases(env, expr)
		CallExpr(kind, callee, args, typ, loc):
			insert_drops_ownership_node(env, expr)
		UnboxExpr(kind, inner, typ, loc):
			insert_drops_ownership_node(env, expr)
		BinaryExpr(op, left, right, typ, loc):
			insert_drops_ownership_node(env, expr)
		_:
			insert_drops_normalized_expr(env, expr)


private pure func insert_drops_normalized_expr(env: PerceusEnv, expr: CoreExpr) -> CoreExpr:
	match expr:
		LetExpr(variable, is_mutable, bind_type, rhs, body):
			if is_managed_type(env, bind_type):
				rewrite_managed_let(env, variable, is_mutable, bind_type, rhs, body)
			else:
				rewritten_rhs: CoreExpr = insert_drops_expr_inner(env, rhs)
				rewritten_body: CoreExpr = insert_drops_expr_inner(env, body)
				owned_variable: CoreVar = copy_core_var(variable)
				owned_bind_type: CoreType = copy_core_type(bind_type)
				LetExpr(owned_variable, is_mutable, owned_bind_type, rewritten_rhs, rewritten_body)
		BorrowLetExpr(variable, bind_type, rhs, body):
			BorrowLetExpr(
				copy_core_var(variable),
				copy_core_type(bind_type),
				insert_drops_expr_inner(env, rhs),
				insert_drops_expr_inner(env, body),
			)
		SeqExpr(first, second):
			SeqExpr(
				insert_drops_expr_inner(env, first),
				insert_drops_expr_inner(env, second),
			)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			IfExpr(
				insert_drops_expr_inner(env, cond),
				insert_drops_expr_inner(env, then_expr),
				insert_drops_expr_inner(env, else_expr),
				copy_core_type(typ),
				loc,
			)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			ConstructorMatchExpr(
				insert_drops_expr_inner(env, scrutinee),
				release_policy,
				rewrite_constructor_match_cases(env, cases),
				rewrite_constructor_match_fallback(env, fallback),
				copy_core_type(typ),
				loc,
			)
		CallExpr(kind, callee, args, typ, loc):
			CallExpr(
				copy_core_call_kind(kind),
				insert_drops_expr_inner(env, callee),
				rewrite_exprs(env, args),
				copy_core_type(typ),
				loc,
			)
		BinaryExpr(op, left, right, typ, loc):
			BinaryExpr(
				op,
				insert_drops_expr_inner(env, left),
				insert_drops_expr_inner(env, right),
				copy_core_type(typ),
				loc,
			)
		TupleExpr(items, typ, loc):
			TupleExpr(
				rewrite_exprs(env, items),
				copy_core_type(typ),
				loc,
			)
		VectorExpr(items, typ, loc):
			VectorExpr(
				rewrite_exprs(env, items),
				copy_core_type(typ),
				loc,
			)
		RecordExpr(fields, typ, loc):
			RecordExpr(
				rewrite_record_fields(env, fields),
				copy_core_type(typ),
				loc,
			)
		RecordConstructExpr(type_name, fields, typ, loc):
			RecordConstructExpr(
				type_name,
				rewrite_record_fields(env, fields),
				copy_core_type(typ),
				loc,
			)
		ListConstructExpr(construct, typ, loc):
			ListConstructExpr(
				{ construct | elements = rewrite_boxed_values(env, construct.elements) },
				copy_core_type(typ),
				loc,
			)
		TensorBoxedLiteralExpr(literal, typ, loc):
			TensorBoxedLiteralExpr(
				{ literal | elements = rewrite_boxed_values(env, literal.elements) },
				copy_core_type(typ),
				loc,
			)
		DictConstructExpr(construct, typ, loc):
			DictConstructExpr(
				{ construct | entries = rewrite_dict_entries(env, construct.entries) },
				copy_core_type(typ),
				loc,
			)
		AssignExpr(variable, rhs, typ, loc):
			rewritten_rhs: CoreExpr = insert_drops_expr_inner(env, rhs)

			match mutable_managed_global_for_target(env, variable):
				Some(global):
					rewrite_direct_mutable_assignment(
						env,
						global.name,
						global.typ,
						rewritten_rhs,
						typ,
						loc,
						0,
						False,
					).expr
				None:
					retain_assignment_alias_rhs(
						env,
						AssignExpr(
							copy_core_var(variable),
							rewritten_rhs,
							copy_core_type(typ),
							loc,
						),
					)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			DupExpr(
				copy_core_var(variable),
				copy_core_type(value_type),
				retain_policy,
				insert_drops_expr_inner(env, body),
				copy_core_type(typ),
				loc,
			)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			DropExpr(
				copy_core_var(variable),
				copy_core_type(value_type),
				release_policy,
				insert_drops_expr_inner(env, body),
				copy_core_type(typ),
				loc,
			)
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			ForRangeExpr(
				binder,
				insert_drops_expr_inner(env, start),
				insert_drops_expr_inner(env, end_value),
				rewrite_loop_body(env, binder, body),
				copy_core_type(typ),
				loc,
			)
		ForChannelExpr(loop, typ, loc):
			ForChannelExpr(
				{ loop |
					iterable = insert_drops_expr_inner(env, loop.iterable),
					body = rewrite_loop_body(env, loop.binder, loop.body)
				},
				copy_core_type(typ),
				loc,
			)
		ForListExpr(loop, typ, loc):
			ForListExpr(
				{ loop |
					iterable = insert_drops_expr_inner(env, loop.iterable),
					body = rewrite_loop_body(env, loop.binder, loop.body)
				},
				copy_core_type(typ),
				loc,
			)
		ForStringExpr(loop, typ, loc):
			ForStringExpr(
				{ loop |
					iterable = insert_drops_expr_inner(env, loop.iterable),
					body = rewrite_loop_body(env, loop.binder, loop.body)
				},
				copy_core_type(typ),
				loc,
			)
		ForDictExpr(loop, typ, loc):
			ForDictExpr(
				{ loop |
					iterable = insert_drops_expr_inner(env, loop.iterable),
					body = rewrite_loop_body(env, loop.binder, loop.body)
				},
				copy_core_type(typ),
				loc,
			)
		ForSetExpr(loop, typ, loc):
			ForSetExpr(
				{ loop |
					iterable = insert_drops_expr_inner(env, loop.iterable),
					body = rewrite_loop_body(env, loop.binder, loop.body)
				},
				copy_core_type(typ),
				loc,
			)
		ForStreamExpr(loop, typ, loc):
			ForStreamExpr(
				{ loop |
					iterable = insert_drops_expr_inner(env, loop.iterable),
					body = rewrite_loop_body(env, loop.binder, loop.body)
				},
				copy_core_type(typ),
				loc,
			)
		ForResourceSourceExpr(loop, typ, loc):
			ForResourceSourceExpr(
				{ loop |
					iterable = insert_drops_expr_inner(env, loop.iterable),
					body = rewrite_loop_body(env, loop.binder, loop.body)
				},
				copy_core_type(typ),
				loc,
			)
		ForTensorExpr(loop, typ, loc):
			ForTensorExpr(
				{ loop |
					iterable = insert_drops_expr_inner(env, loop.iterable),
					body = rewrite_loop_body(env, loop.binder, loop.body)
				},
				copy_core_type(typ),
				loc,
			)
		PreClosureConcurrentExpr(block, typ, loc):
			rewritten_body: CoreExpr = insert_drops_expr_inner(env, block.body)
			var balanced_body: CoreExpr = rewritten_body

			for binding in block.bindings:
				balanced_body = balance_concurrent_binding_body(
					env,
					binding.variable,
					binding.typ,
					balanced_body,
				)

			rewritten_timeout: Option[CoreExpr] = match block.timeout:
				Some(timeout):
					Some(insert_drops_expr_inner(env, timeout))
				None:
					None

			PreClosureConcurrentExpr(
				{ block |
					bindings = rewrite_pre_closure_concurrent_bindings(env, block.bindings),
					body = balanced_body,
					timeout = rewritten_timeout
				},
				copy_core_type(typ),
				loc,
			)
		_:
			CoreTraverse.map_core_expr_children_with_context(expr, env, insert_drops_expr_inner)


pure func insert_drops_expr(env: PerceusEnv, expr: CoreExpr) -> CoreExpr:
	normalized: CoreExpr = normalize_lambda_result_aliases(env, expr)
	insert_drops_expr_inner(env, normalized)


private pure func rewrite_exprs(env: PerceusEnv, exprs: List[CoreExpr]) -> List[CoreExpr]:
	var rewritten: List[CoreExpr] = []

	for expr in exprs:
		rewritten = rewritten.append(insert_drops_expr_inner(env, expr))

	rewritten


private pure func int_list_contains(items: List[Int], value: Int) -> Bool:
	items.any(func(item): item == value)


private pure func int_lists_equal(left: List[Int], right: List[Int]) -> Bool:
	if left.length() != right.length():
		False
	else:
		var equal: Bool = True
		var index: Int = 0

		while equal and index < left.length():
			equal = left.get(index) == right.get(index)
			index += 1

		equal


private pure func merge_consumed_args(left: List[Int], right: List[Int]) -> List[Int]:
	var merged: List[Int] = left

	for index in right:
		if not int_list_contains(merged, index):
			merged = merged.append(index)
		else:
			void

	merged


private pure func summarize_function_return_literal_match_uses(
	env: PerceusEnv,
	name: String,
	return_type: CoreType,
	match_expr: CoreConstructorLiteralMatch,
) -> OwnershipUseSummary:
	var branch_uses: List[OwnershipUseSummary] = []

	for match_case in match_expr.cases:
		if match_bindings_shadow(name, match_case.bindings):
			branch_uses = branch_uses.append(NO_OWNERSHIP_USES)
		else:
			branch_uses = branch_uses.append(
				summarize_function_return_ownership_uses(
					env,
					name,
					return_type,
					match_case.body,
				),
			)

	match match_expr.fallback:
		LiteralMatchFallbackBody(body):
			branch_uses = branch_uses.append(
				summarize_function_return_ownership_uses(
					env,
					name,
					return_type,
					body,
				),
			)
		LiteralMatchFallbackBindings(bindings, body):
			if match_bindings_shadow(name, bindings):
				branch_uses = branch_uses.append(NO_OWNERSHIP_USES)
			else:
				branch_uses = branch_uses.append(
					summarize_function_return_ownership_uses(
						env,
						name,
						return_type,
						body,
					),
				)
		LiteralMatchFallbackFail:
			branch_uses = branch_uses.append(NO_OWNERSHIP_USES)

	branch_ownership_uses(branch_uses)


private pure func summarize_function_return_match_body_uses(
	env: PerceusEnv,
	name: String,
	return_type: CoreType,
	body: CoreConstructorMatchBody,
) -> OwnershipUseSummary:
	match body:
		ConstructorMatchBodyExpr(expr):
			summarize_function_return_ownership_uses(env, name, return_type, expr)
		ConstructorMatchBodyLiteral(match_expr):
			summarize_function_return_literal_match_uses(env, name, return_type, match_expr)
		ConstructorMatchBodyLength(match_expr):
			summarize_function_return_length_match_uses(env, name, return_type, match_expr)


private pure func summarize_function_return_length_branch_uses(
	env: PerceusEnv,
	name: String,
	return_type: CoreType,
	branch: CoreConstructorLengthMatchBranch,
) -> OwnershipUseSummary:
	if match_bindings_shadow(name, branch.bindings):
		NO_OWNERSHIP_USES
	else:
		summarize_function_return_match_body_uses(env, name, return_type, branch.body)


private pure func summarize_function_return_length_match_uses(
	env: PerceusEnv,
	name: String,
	return_type: CoreType,
	match_expr: CoreConstructorLengthMatch,
) -> OwnershipUseSummary:
	var branch_uses: List[OwnershipUseSummary] = []

	for match_case in match_expr.cases:
		branch_uses = branch_uses.append(
			summarize_function_return_length_branch_uses(
				env,
				name,
				return_type,
				match_case.branch,
			),
		)

	match match_expr.geq:
		Some(match_case):
			branch_uses = branch_uses.append(
				summarize_function_return_length_branch_uses(
					env,
					name,
					return_type,
					match_case.branch,
				),
			)
		None:
			void

	match match_expr.fallback:
		Some(branch):
			branch_uses = branch_uses.append(
				summarize_function_return_length_branch_uses(
					env,
					name,
					return_type,
					branch,
				),
			)
		None:
			branch_uses = branch_uses.append(NO_OWNERSHIP_USES)

	branch_ownership_uses(branch_uses)


private pure func summarize_function_return_match_case_uses(
	env: PerceusEnv,
	name: String,
	return_type: CoreType,
	match_case: CoreConstructorMatchCase,
) -> OwnershipUseSummary:
	if match_bindings_shadow(name, match_case.bindings):
		NO_OWNERSHIP_USES
	else:
		summarize_function_return_match_body_uses(env, name, return_type, match_case.body)


private pure func summarize_function_return_match_branch_uses(
	env: PerceusEnv,
	name: String,
	return_type: CoreType,
	cases: List[CoreConstructorMatchCase],
	fallback: CoreConstructorMatchFallback,
) -> OwnershipUseSummary:
	var branch_uses: List[OwnershipUseSummary] = []

	for match_case in cases:
		branch_uses = branch_uses.append(
			summarize_function_return_match_case_uses(
				env,
				name,
				return_type,
				match_case,
			),
		)

	match fallback:
		ConstructorMatchFallbackBody(body):
			branch_uses = branch_uses.append(
				summarize_function_return_ownership_uses(
					env,
					name,
					return_type,
					body,
				),
			)
		ConstructorMatchFallbackBindings(bindings, body):
			if match_bindings_shadow(name, bindings):
				branch_uses = branch_uses.append(NO_OWNERSHIP_USES)
			else:
				branch_uses = branch_uses.append(
					summarize_function_return_ownership_uses(
						env,
						name,
						return_type,
						body,
					),
				)
		ConstructorMatchFallbackFail:
			branch_uses = branch_uses.append(NO_OWNERSHIP_USES)

	branch_ownership_uses(branch_uses)


private pure func summarize_function_return_ownership_uses(
	env: PerceusEnv,
	name: String,
	return_type: CoreType,
	expr: CoreExpr,
) -> OwnershipUseSummary:
	match expr:
		IfExpr(cond, then_expr, else_expr, typ, loc):
			seq_ownership_uses(
				summarize_linear_ownership_uses(env, name, cond),
				branch_ownership_uses([
					summarize_function_return_ownership_uses(env, name, return_type, then_expr),
					summarize_function_return_ownership_uses(env, name, return_type, else_expr),
				]),
			)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			summarize_match_ownership_uses(
				env,
				name,
				scrutinee,
				summarize_function_return_match_branch_uses(
					env,
					name,
					return_type,
					cases,
					fallback,
				),
			)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			summarize_match_ownership_uses(
				env,
				name,
				scrutinee,
				summarize_function_return_literal_match_uses(
					env,
					name,
					return_type,
					{
						accessor = RootAccessor,
						scrutinee_type = core_expr_type(scrutinee),
						cases = cases,
						fallback = fallback,
						result_type = typ,
						loc = loc
					},
				),
			)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			summarize_match_ownership_uses(
				env,
				name,
				scrutinee,
				summarize_function_return_literal_match_uses(env, name, return_type, match_expr),
			)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			summarize_match_ownership_uses(
				env,
				name,
				scrutinee,
				summarize_function_return_length_match_uses(env, name, return_type, match_expr),
			)
		LetExpr(variable, is_mutable, bind_type, rhs, body):
			rhs_uses: OwnershipUseSummary = if (
				is_managed_type(env, bind_type)
				and direct_aliases_name(name, rhs)
			):
				summarize_linear_borrow(env, name, rhs)
			else:
				summarize_linear_ownership_uses(env, name, rhs)

			body_uses: OwnershipUseSummary = if variable.name == name:
				NO_OWNERSHIP_USES
			else:
				summarize_function_return_ownership_uses(env, name, return_type, body)

			seq_ownership_uses(rhs_uses, body_uses)
		BorrowLetExpr(variable, bind_type, rhs, body):
			rhs_uses: OwnershipUseSummary = summarize_linear_borrow(env, name, rhs)

			body_uses: OwnershipUseSummary = if variable.name == name:
				NO_OWNERSHIP_USES
			else:
				summarize_function_return_ownership_uses(env, name, return_type, body)

			seq_ownership_uses(rhs_uses, body_uses)
		SeqExpr(first, second):
			seq_ownership_uses(
				summarize_linear_ownership_uses(env, name, first),
				summarize_function_return_ownership_uses(env, name, return_type, second),
			)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			summarize_function_return_ownership_uses(env, name, return_type, body)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			if variable.name == name:
				seq_ownership_uses(
					CONSUME_OWNERSHIP_USE,
					summarize_function_return_ownership_uses(env, name, return_type, body),
				)
			else:
				summarize_function_return_ownership_uses(env, name, return_type, body)
		ResourceScopeExpr(scope, typ, loc):
			seq_ownership_uses(
				summarize_linear_ownership_uses(env, name, scope.acquire),
				summarize_function_return_ownership_uses(env, name, return_type, scope.body),
			)
		_:
			aliases_managed_result: Bool = match expr:
				VarExpr(variable, typ, loc):
					variable.name == name
				FieldExpr(owner, field, typ, loc):
					borrow_expr_aliases_target(env, name, expr)
				CallExpr(kind, callee, args, typ, loc):
					borrow_expr_aliases_target(env, name, expr)
				CastExpr(inner, typ, loc):
					borrow_expr_aliases_target(env, name, expr)
				UnboxExpr(kind, inner, typ, loc):
					borrow_expr_aliases_target(env, name, expr)
				_:
					False

			if is_managed_type(env, return_type) and aliases_managed_result:
				summarize_linear_borrow(env, name, expr)
			else:
				summarize_linear_ownership_uses(env, name, expr)


private pure func initial_consumed_param_indices(
	env: PerceusEnv,
	func_info: CoreFunction,
) -> List[Int]:
	match func_info.function_kind:
		ClosureBodyFunction(abi):
			[]
		_:
			var consumed: List[Int] = []
			var index: Int = 0

			for param in func_info.params:
				if is_managed_type(env, param.typ):
					consumed = consumed.append(index)
				else:
					void

				index += 1

			consumed


private pure func infer_user_contract(
	env: PerceusEnv,
	func_info: CoreFunction,
) -> InferredUserContract:
	match func_info.function_kind:
		ClosureBodyFunction(abi):
			{
				consumed_args = [],
				dependencies = []
			}
		_:
			match func_info.body:
				Some(body):
					var consumed: List[Int] = []
					var dependencies: List[String] = []
					var index: Int = 0

					for param in func_info.params:
						if is_managed_type(env, param.typ):
							uses: OwnershipUseSummary = summarize_function_return_ownership_uses(
								env,
								param.name.name,
								func_info.return_type,
								body,
							)
							dependencies = merge_user_call_dependencies(
								dependencies,
								uses.user_call_dependencies,
							)

							if uses.consumed_refs > 0:
								consumed = consumed.append(index)
							else:
								void
						else:
							void

						index += 1

					{
						consumed_args = consumed,
						dependencies = dependencies
					}
				None:
					{
						consumed_args = initial_consumed_param_indices(env, func_info),
						dependencies = []
					}


private USER_CONTRACT_LAYER_COMPACTION_THRESHOLD: Int = 32


private pure func append_unique_string(items: List[String], value: String) -> List[String]:
	if items.contains(value):
		items
	else:
		items.append(value)


private pure func callers_for_changed_functions(
	reverse_callers_by_name: Dict[String, List[String]],
	changed_function_names: List[String],
) -> List[String]:
	var callers: List[String] = []

	for function_name in changed_function_names:
		for caller_name in (
			reverse_callers_by_name
				.get(function_name)
				.get_or([])
		):
			callers = append_unique_string(callers, caller_name)

	callers


private pure func flatten_user_call_contracts(
	program: CoreProgram,
	env: PerceusEnv,
) -> Dict[String, List[Int]]:
	var contracts_by_name: Dict[String, List[Int]] = {}

	for decl in program.decls:
		match decl:
			FunctionDecl(func_info):
				match func_info.body:
					Some(body):
						consumed_args: List[Int] = match lookup_layered_user_call_consumed_args(
							env,
							func_info.name,
						):
							Some(args):
								args
							None:
								env.user_call_contracts_by_name
									.get(func_info.name)
									.get_or([])

						contracts_by_name = contracts_by_name.set(func_info.name, consumed_args)
					None:
						void
			_:
				void

	contracts_by_name


private pure func analyze_initial_user_contracts(
	program: CoreProgram,
	env: PerceusEnv,
) -> InitialUserContractAnalysis:
	var contracts_by_name: Dict[String, List[Int]] = {}
	var reverse_callers_by_name: Dict[String, List[String]] = {}
	var function_indices_by_name: Dict[String, Int] = {}
	var consuming_function_names: List[String] = []
	var index: Int = 0

	while index < program.decls.length():
		match program.decls.get(index):
			Some(FunctionDecl(func_info)):
				match func_info.body:
					Some(body):
						inferred: InferredUserContract = infer_user_contract(env, func_info)
						contracts_by_name = contracts_by_name.set(
							func_info.name,
							inferred.consumed_args,
						)
						function_indices_by_name = function_indices_by_name.set(
							func_info.name,
							index,
						)

						if inferred.consumed_args.length() > 0:
							consuming_function_names = consuming_function_names.append(
								func_info.name,
							)
						else:
							void

						for dependency_name in inferred.dependencies:
							callers: List[String] = reverse_callers_by_name
								.get(dependency_name)
								.get_or([])
							reverse_callers_by_name = reverse_callers_by_name.set(
								dependency_name,
								append_unique_string(callers, func_info.name),
							)
					None:
						void
			Some(decl):
				void
			None:
				void

		index += 1

	{
		user_call_contracts_by_name = contracts_by_name,
		reverse_callers_by_name = reverse_callers_by_name,
		function_indices_by_name = function_indices_by_name,
		consuming_function_names = consuming_function_names
	}


private pure func analyze_user_contract_wave(
	program: CoreProgram,
	function_indices_by_name: Dict[String, Int],
	env: PerceusEnv,
	function_names: List[String],
) -> UserContractWave:
	var contracts_by_name: Dict[String, List[Int]] = {}
	var changed_function_names: List[String] = []

	for function_name in function_names:
		match function_indices_by_name.get(function_name):
			Some(index):
				match program.decls.get(index):
					Some(FunctionDecl(func_info)):
						inferred: InferredUserContract = infer_user_contract(env, func_info)

						current: List[Int] = match lookup_layered_user_call_consumed_args(
							env,
							func_info.name,
						):
							Some(args):
								args
							None:
								env.user_call_contracts_by_name
									.get(func_info.name)
									.get_or([])

						next: List[Int] = merge_consumed_args(current, inferred.consumed_args)

						if not int_lists_equal(current, next):
							contracts_by_name = contracts_by_name.set(func_info.name, next)
							changed_function_names = changed_function_names.append(func_info.name)
						else:
							void
					Some(decl):
						void
					None:
						void
			None:
				void

	next_env: PerceusEnv = if changed_function_names.length() == 0:
		env
	else:
		{ env |
			user_call_contract_layers_by_name = env.user_call_contract_layers_by_name.append(
				contracts_by_name,
			)
		}

	compacted_env: PerceusEnv = if next_env.user_call_contract_layers_by_name.length() >= USER_CONTRACT_LAYER_COMPACTION_THRESHOLD:
		flattened_contracts: Dict[String, List[Int]] = flatten_user_call_contracts(
			program,
			next_env,
		)
		{ next_env |
			user_call_contracts_by_name = flattened_contracts,
			user_call_contract_layers_by_name = []
		}
	else:
		next_env

	{
		env = compacted_env,
		changed_function_names = changed_function_names
	}


private pure func infer_user_call_contracts(program: CoreProgram, env: PerceusEnv) -> PerceusEnv:
	-- Consumption is a derived fact: start unresolved user calls as borrowing,
	-- then use the dependency worklist to revisit only callers of contracts that
	-- gain consuming parameters. Monotonic union makes termination structural:
	-- each function parameter can enter its contract at most once.
	inference_env: PerceusEnv = { env | infer_unresolved_user_calls_as_borrow = True }
	initial: InitialUserContractAnalysis = analyze_initial_user_contracts(program, inference_env)
	var current_env: PerceusEnv = { inference_env |
		user_call_contracts_by_name = initial.user_call_contracts_by_name
	}
	var pending_function_names: List[String] = callers_for_changed_functions(
		initial.reverse_callers_by_name,
		initial.consuming_function_names,
	)

	while pending_function_names.length() > 0:
		wave: UserContractWave = analyze_user_contract_wave(
			program,
			initial.function_indices_by_name,
			current_env,
			pending_function_names,
		)
		current_env = wave.env
		pending_function_names = callers_for_changed_functions(
			initial.reverse_callers_by_name,
			wave.changed_function_names,
		)

	if current_env.user_call_contract_layers_by_name.length() > 0:
		flattened_contracts: Dict[String, List[Int]] = flatten_user_call_contracts(
			program,
			current_env,
		)
		installed_env: PerceusEnv = { current_env |
			user_call_contracts_by_name = flattened_contracts,
			user_call_contract_layers_by_name = []
		}
		{ installed_env | infer_unresolved_user_calls_as_borrow = False }
	else:
		{ current_env | infer_unresolved_user_calls_as_borrow = False }


private pure func function_consumed_param_indices(
	env: PerceusEnv,
	func_info: CoreFunction,
) -> List[Int]:
	env.user_call_contracts_by_name
		.get(func_info.name)
		.get_or([])


private pure func consumed_param_vars(
	func_info: CoreFunction,
	consumed_params: List[Int],
) -> List[CoreVar]:
	var variables: List[CoreVar] = []
	var index: Int = 0

	for param in func_info.params:
		if consumed_params.contains(index):
			variables = variables.append(copy_core_var(param.name))
		else:
			void

		index += 1

	variables


private pure func inferred_user_call_consumed_args(
	env: PerceusEnv,
	name: String,
	def_id: Option[Int],
	arg_count: Int,
	return_type: CoreType,
	fallback: List[Int],
) -> List[Int]:
	match lookup_return_type_constructor_call_contract(env, name, def_id, arg_count, return_type):
		Some(contract):
			fallback
		None:
			match env.user_call_contracts_by_name.get(name):
				Some(inferred):
					merge_consumed_args(fallback, inferred)
				None:
					fallback


private pure func annotate_user_call_contracts(env: PerceusEnv, expr: CoreExpr) -> CoreExpr:
	rewritten: CoreExpr = CoreTraverse.map_core_expr_children_with_context(
		expr,
		env,
		annotate_user_call_contracts,
	)

	match rewritten:
		CallExpr(UserCall(name, def_id, consumed_args), callee, args, typ, loc):
			CallExpr(
				UserCall(
					name,
					def_id,
					inferred_user_call_consumed_args(
						env,
						name,
						def_id,
						args.length(),
						typ,
						consumed_args,
					),
				),
				callee,
				args,
				typ,
				loc,
			)
		_:
			rewritten


private pure func borrowed_alias_result_loc(expr: CoreExpr) -> CoreSourceLoc:
	match expr:
		FieldExpr(owner, field, field_type, field_loc):
			field_loc
		TupleFieldExpr(owner, field_index, field_type, field_loc):
			field_loc
		CallExpr(kind, callee, args, call_type, call_loc):
			call_loc
		CastExpr(inner, cast_type, cast_loc):
			cast_loc
		UnboxExpr(kind, inner, unbox_type, unbox_loc):
			unbox_loc
		_:
			SyntheticSourceLoc


private pure func retain_borrowed_alias_result_with_temp(expr: CoreExpr, temp: CoreVar) -> CoreExpr:
	typ: CoreType = expr_result_type(expr)
	loc: CoreSourceLoc = borrowed_alias_result_loc(expr)

	BorrowLetExpr(
		copy_core_var(temp),
		copy_core_type(typ),
		expr,
		DupExpr(
			copy_core_var(temp),
			copy_core_type(typ),
			retain_policy_for_type(typ),
			VarExpr(copy_core_var(temp), copy_core_type(typ), loc),
			copy_core_type(typ),
			loc,
		),
	)


private pure func retain_borrowed_alias_result(param: CoreParam, expr: CoreExpr) -> CoreExpr:
	temp: CoreVar = synthetic_binding_var(
		"borrowed_result_${param.name.name}",
		param.name.uniq,
		borrowed_alias_result_loc(expr),
	)

	retain_borrowed_alias_result_with_temp(expr, temp)


private pure func match_binding_as_param(binding: CoreMatchBinding) -> CoreParam:
	{
		name = copy_core_var(binding.variable),
		typ = copy_core_type(binding.typ),
		loc = SyntheticSourceLoc
	}


-- Direct owned union fields transfer storage from their scrutinee and are
-- finalized by reuse/emission. A list spread instead materializes a fresh list
-- value at the match boundary, so Perceus must balance its lifetime normally.
private pure func match_binding_materializes_owned_value(binding: CoreMatchBinding) -> Bool:
	match binding.mode:
		MatchBorrowBindingMode:
			False
		MatchOwnBindingMode:
			match binding.accessor:
				ListSpreadAccessor(parent, offset):
					True
				_:
					False


private pure func retain_borrowed_owned_uses(
	env: PerceusEnv,
	param: CoreParam,
	expr: CoreExpr,
) -> CoreExpr:
	call_safe: CoreExpr = protect_borrowed_param_calls(env, param, expr)

	retain_borrowed_param_aggregate_members(env, param, call_safe)


private pure func retain_borrowed_binding_results_in_constructor_body(
	env: PerceusEnv,
	bindings: List[CoreMatchBinding],
	body: CoreConstructorMatchBody,
) -> CoreConstructorMatchBody:
	var result: CoreConstructorMatchBody = body

	for binding in bindings:
		if is_managed_type(env, binding.typ):
			if binding.mode == MatchBorrowBindingMode:
				param: CoreParam = match_binding_as_param(binding)
				result = retain_borrowed_param_result_in_constructor_body(env, param, True, result)
			else:
				result = protect_repeated_constructor_match_body(
					env,
					copy_core_var(binding.variable),
					copy_core_type(binding.typ),
					result,
					False,
				)

				if match_binding_materializes_owned_value(binding):
					result = balance_constructor_match_body(
						env,
						copy_core_var(binding.variable),
						copy_core_type(binding.typ),
						1,
						result,
					)
				else:
					void
		else:
			void

	result


private pure func retain_borrowed_param_result_in_literal_case(
	env: PerceusEnv,
	param: CoreParam,
	allow_param: Bool,
	match_case: CoreLiteralMatchCase,
) -> CoreLiteralMatchCase:
	literal: CoreLiteral = match_case.literal
	bindings: List[CoreMatchBinding] = match_case.bindings
	body: CoreExpr = match_case.body

	param_body: CoreExpr = if allow_param and not match_bindings_shadow_param(bindings, param):
		retain_borrowed_param_result(
			env,
			param,
			retain_borrowed_owned_uses(env, param, body),
		)
	else:
		body

	{
		literal = literal,
		bindings = bindings,
		body = param_body
	}


private pure func retain_borrowed_param_result_in_literal_fallback(
	env: PerceusEnv,
	param: CoreParam,
	allow_param: Bool,
	fallback: CoreLiteralMatchFallback,
) -> CoreLiteralMatchFallback:
	match fallback:
		LiteralMatchFallbackBody(body):
			if allow_param:
				LiteralMatchFallbackBody(
					retain_borrowed_param_result(
						env,
						param,
						retain_borrowed_owned_uses(env, param, body),
					),
				)
			else:
				fallback
		LiteralMatchFallbackBindings(bindings, body):
			param_body: CoreExpr = if (
				allow_param
				and not match_bindings_shadow_param(bindings, param)
			):
				retain_borrowed_param_result(
					env,
					param,
					retain_borrowed_owned_uses(env, param, body),
				)
			else:
				body

			LiteralMatchFallbackBindings(bindings, param_body)
		LiteralMatchFallbackFail:
			LiteralMatchFallbackFail


private pure func retain_borrowed_param_result_in_length_branch(
	env: PerceusEnv,
	param: CoreParam,
	allow_param: Bool,
	branch: CoreConstructorLengthMatchBranch,
) -> CoreConstructorLengthMatchBranch:
	bindings: List[CoreMatchBinding] = branch.bindings
	body: CoreConstructorMatchBody = branch.body
	param_body: CoreConstructorMatchBody = retain_borrowed_param_result_in_constructor_body(
		env,
		param,
		allow_param and not match_bindings_shadow_param(bindings, param),
		body,
	)
	{
		bindings = bindings,
		body = param_body
	}


private pure func retain_borrowed_param_result_in_length_case(
	env: PerceusEnv,
	param: CoreParam,
	allow_param: Bool,
	match_case: CoreConstructorLengthMatchCase,
) -> CoreConstructorLengthMatchCase:
	length: Int = match_case.length
	branch: CoreConstructorLengthMatchBranch = match_case.branch

	{
		length = length,
		branch = retain_borrowed_param_result_in_length_branch(env, param, allow_param, branch)
	}


private pure func retain_borrowed_param_result_in_length_cases(
	env: PerceusEnv,
	param: CoreParam,
	allow_param: Bool,
	cases: List[CoreConstructorLengthMatchCase],
) -> List[CoreConstructorLengthMatchCase]:
	var retained: List[CoreConstructorLengthMatchCase] = []

	for match_case in cases:
		retained = retained.append(
			retain_borrowed_param_result_in_length_case(
				env,
				param,
				allow_param,
				match_case,
			),
		)

	retained


private pure func retain_borrowed_param_result_in_length_match(
	env: PerceusEnv,
	param: CoreParam,
	allow_param: Bool,
	match_expr: CoreConstructorLengthMatch,
) -> CoreConstructorLengthMatch:
	accessor = match_expr.accessor
	cases: List[CoreConstructorLengthMatchCase] = match_expr.cases
	geq: Option[CoreConstructorLengthMatchGeq] = match_expr.geq
	fallback: Option[CoreConstructorLengthMatchBranch] = match_expr.fallback
	result_type: CoreType = match_expr.result_type
	loc: CoreSourceLoc = match_expr.loc
	retained_cases: List[CoreConstructorLengthMatchCase] = retain_borrowed_param_result_in_length_cases(
		env,
		param,
		allow_param,
		cases,
	)

	retained_geq: Option[CoreConstructorLengthMatchGeq] = match geq:
		Some(match_case):
			minimum_length: Int = match_case.minimum_length
			branch: CoreConstructorLengthMatchBranch = match_case.branch
			Some({
				minimum_length = minimum_length,
				branch = retain_borrowed_param_result_in_length_branch(
					env,
					param,
					allow_param,
					branch,
				),
			})
		None:
			None

	retained_fallback: Option[CoreConstructorLengthMatchBranch] = match fallback:
		Some(branch):
			Some(retain_borrowed_param_result_in_length_branch(env, param, allow_param, branch))
		None:
			None

	{
		accessor = accessor,
		cases = retained_cases,
		geq = retained_geq,
		fallback = retained_fallback,
		result_type = result_type,
		loc = loc
	}


private pure func retain_borrowed_param_result_in_literal_cases(
	env: PerceusEnv,
	param: CoreParam,
	allow_param: Bool,
	cases: List[CoreLiteralMatchCase],
) -> List[CoreLiteralMatchCase]:
	var retained: List[CoreLiteralMatchCase] = []

	for match_case in cases:
		retained = retained.append(
			retain_borrowed_param_result_in_literal_case(
				env,
				param,
				allow_param,
				match_case,
			),
		)

	retained


private pure func retain_borrowed_param_result_in_constructor_body(
	env: PerceusEnv,
	param: CoreParam,
	allow_param: Bool,
	body: CoreConstructorMatchBody,
) -> CoreConstructorMatchBody:
	match body:
		ConstructorMatchBodyExpr(expr):
			if allow_param:
				ConstructorMatchBodyExpr(
					retain_borrowed_param_result(
						env,
						param,
						retain_borrowed_owned_uses(env, param, expr),
					),
				)
			else:
				body
		ConstructorMatchBodyLiteral(match_expr):
			accessor = match_expr.accessor
			scrutinee_type: CoreType = match_expr.scrutinee_type
			cases: List[CoreLiteralMatchCase] = match_expr.cases
			fallback: CoreLiteralMatchFallback = match_expr.fallback
			result_type: CoreType = match_expr.result_type
			loc: CoreSourceLoc = match_expr.loc
			retained_cases: List[CoreLiteralMatchCase] = retain_borrowed_param_result_in_literal_cases(
				env,
				param,
				allow_param,
				cases,
			)
			ConstructorMatchBodyLiteral({
				accessor = accessor,
				scrutinee_type = scrutinee_type,
				cases = retained_cases,
				fallback = retain_borrowed_param_result_in_literal_fallback(
					env,
					param,
					allow_param,
					fallback,
				),
				result_type = result_type,
				loc = loc,
			})
		ConstructorMatchBodyLength(match_expr):
			ConstructorMatchBodyLength(
				retain_borrowed_param_result_in_length_match(
					env,
					param,
					allow_param,
					match_expr,
				),
			)


private pure func retain_borrowed_binding_results(
	env: PerceusEnv,
	bindings: List[CoreMatchBinding],
	body: CoreExpr,
) -> CoreExpr:
	var result: CoreExpr = body

	for binding in bindings:
		if is_managed_type(env, binding.typ):
			if binding.mode == MatchBorrowBindingMode:
				param: CoreParam = match_binding_as_param(binding)
				result = retain_borrowed_param_result(
					env,
					param,
					retain_borrowed_owned_uses(env, param, result),
				)
			else:
				result = protect_repeated_consumes(
					env,
					copy_core_var(binding.variable),
					copy_core_type(binding.typ),
					result,
					False,
				)

				if match_binding_materializes_owned_value(binding):
					uses: OwnershipUseSummary = summarize_linear_ownership_uses(
						env,
						binding.variable.name,
						result,
					)
					result = balance_branch_body(
						env,
						binding.variable,
						binding.typ,
						1,
						uses,
						result,
					)
				else:
					void
		else:
			void

	result


private pure func retain_borrowed_param_result_in_constructor_case(
	env: PerceusEnv,
	param: CoreParam,
	match_case: CoreConstructorMatchCase,
) -> CoreConstructorMatchCase:
	constructor: String = match_case.constructor
	accessor: CoreAccessor = match_case.accessor
	test: CoreConstructorMatchTest = match_case.test
	bindings: List[CoreMatchBinding] = match_case.bindings
	body: CoreConstructorMatchBody = match_case.body
	param_body: CoreConstructorMatchBody = retain_borrowed_param_result_in_constructor_body(
		env,
		param,
		not match_bindings_shadow_param(bindings, param),
		body,
	)
	{
		constructor = constructor,
		accessor = accessor,
		test = test,
		bindings = bindings,
		body = param_body
	}


private pure func retain_borrowed_param_result_in_constructor_fallback(
	env: PerceusEnv,
	param: CoreParam,
	fallback: CoreConstructorMatchFallback,
) -> CoreConstructorMatchFallback:
	match fallback:
		ConstructorMatchFallbackBody(body):
			ConstructorMatchFallbackBody(
				retain_borrowed_param_result(
					env,
					param,
					retain_borrowed_owned_uses(env, param, body),
				),
			)
		ConstructorMatchFallbackBindings(bindings, body):
			param_body: CoreExpr = if match_bindings_shadow_param(bindings, param):
				body
			else:
				retain_borrowed_param_result(
					env,
					param,
					retain_borrowed_owned_uses(env, param, body),
				)

			ConstructorMatchFallbackBindings(bindings, param_body)
		ConstructorMatchFallbackFail:
			ConstructorMatchFallbackFail


private pure func retain_borrowed_param_result_in_constructor_cases(
	env: PerceusEnv,
	param: CoreParam,
	cases: List[CoreConstructorMatchCase],
) -> List[CoreConstructorMatchCase]:
	var retained: List[CoreConstructorMatchCase] = []

	for match_case in cases:
		retained = retained.append(
			retain_borrowed_param_result_in_constructor_case(
				env,
				param,
				match_case,
			),
		)

	retained


private pure func retain_borrowed_param_result(
	env: PerceusEnv,
	param: CoreParam,
	expr: CoreExpr,
) -> CoreExpr:
	match expr:
		VarExpr(variable, typ, loc):
			stable_variable: CoreVar = copy_core_var(variable)
			stable_type: CoreType = copy_core_type(typ)
			is_borrowed_managed_result: Bool = (
				core_var_matches_param(stable_variable, param)
				and is_managed_type(env, stable_type)
			)

			if is_borrowed_managed_result:
				retain_policy: CoreRetainPolicy = retain_policy_for_type(stable_type)
				retained_body: CoreExpr = VarExpr(
					copy_core_var(stable_variable),
					copy_core_type(stable_type),
					loc,
				)
				result_type: CoreType = copy_core_type(stable_type)

				DupExpr(
					stable_variable,
					stable_type,
					retain_policy,
					retained_body,
					result_type,
					loc,
				)
			else:
				VarExpr(stable_variable, stable_type, loc)
		FieldExpr(owner, field, typ, loc):
			if is_managed_type(env, typ) and borrow_expr_aliases_param(env, param, expr):
				retain_borrowed_alias_result(param, expr)
			else:
				expr
		TupleFieldExpr(owner, field_index, typ, loc):
			if is_managed_type(env, typ) and borrow_expr_aliases_param(env, param, expr):
				retain_borrowed_alias_result(param, expr)
			else:
				expr
		CallExpr(kind, callee, args, typ, loc):
			if is_managed_type(env, typ) and borrow_expr_aliases_param(env, param, expr):
				retain_borrowed_alias_result(param, expr)
			else:
				expr
		CastExpr(inner, typ, loc):
			if is_managed_type(env, typ) and borrow_expr_aliases_param(env, param, expr):
				retain_borrowed_alias_result(param, expr)
			else:
				expr
		UnboxExpr(kind, inner, typ, loc):
			if is_managed_type(env, typ) and borrow_expr_aliases_param(env, param, expr):
				retain_borrowed_alias_result(param, expr)
			else:
				expr
		LetExpr(variable, is_mutable, typ, rhs, body):
			stable_body: CoreExpr = copy_expr(body)
			stable_rhs: CoreExpr = copy_expr(rhs)
			stable_variable: CoreVar = copy_core_var(variable)
			stable_type: CoreType = copy_core_type(typ)

			if core_var_matches_param(stable_variable, param):
				LetExpr(stable_variable, is_mutable, stable_type, stable_rhs, stable_body)
			else:
				LetExpr(
					stable_variable,
					is_mutable,
					stable_type,
					stable_rhs,
					retain_borrowed_param_result(env, param, stable_body),
				)
		BorrowLetExpr(variable, typ, rhs, body):
			if core_var_matches_param(variable, param):
				expr
			else:
				BorrowLetExpr(
					copy_core_var(variable),
					copy_core_type(typ),
					rhs,
					retain_borrowed_param_result(env, param, body),
				)
		SeqExpr(first, second):
			SeqExpr(
				copy_expr(first),
				retain_borrowed_param_result(env, param, copy_expr(second)),
			)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			IfExpr(
				cond,
				retain_borrowed_param_result(env, param, then_expr),
				retain_borrowed_param_result(env, param, else_expr),
				copy_core_type(typ),
				loc,
			)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			LiteralMatchExpr(
				scrutinee,
				retain_borrowed_param_result_in_literal_cases(env, param, True, cases),
				retain_borrowed_param_result_in_literal_fallback(env, param, True, fallback),
				copy_core_type(typ),
				loc,
			)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			AccessorLiteralMatchExpr(
				scrutinee,
				release_policy,
				{ match_expr |
					cases = retain_borrowed_param_result_in_literal_cases(
						env,
						param,
						True,
						match_expr.cases,
					),
					fallback = retain_borrowed_param_result_in_literal_fallback(
						env,
						param,
						True,
						match_expr.fallback,
					)
				},
				copy_core_type(typ),
				loc,
			)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			LengthMatchExpr(
				scrutinee,
				release_policy,
				retain_borrowed_param_result_in_length_match(env, param, True, match_expr),
				copy_core_type(typ),
				loc,
			)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			ConstructorMatchExpr(
				scrutinee,
				release_policy,
				retain_borrowed_param_result_in_constructor_cases(env, param, cases),
				retain_borrowed_param_result_in_constructor_fallback(env, param, fallback),
				copy_core_type(typ),
				loc,
			)
		AssignExpr(variable, rhs, typ, loc):
			AssignExpr(
				copy_core_var(variable),
				retain_borrowed_param_result(env, param, rhs),
				copy_core_type(typ),
				loc,
			)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			if core_var_matches_param(variable, param):
				expr
			else:
				DupExpr(
					copy_core_var(variable),
					copy_core_type(value_type),
					retain_policy,
					retain_borrowed_param_result(env, param, body),
					copy_core_type(typ),
					loc,
				)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			DropExpr(
				copy_core_var(variable),
				copy_core_type(value_type),
				release_policy,
				retain_borrowed_param_result(env, param, body),
				copy_core_type(typ),
				loc,
			)
		ResourceScopeExpr(scope, typ, loc):
			if core_var_matches_param(scope.variable, param):
				expr
			else:
				ResourceScopeExpr(
					{ scope | body = retain_borrowed_param_result(env, param, scope.body) },
					copy_core_type(typ),
					loc,
				)
		_:
			expr


private pure func retain_borrowed_param_results(
	env: PerceusEnv,
	func_info: CoreFunction,
	consumed_params: List[Int],
	body: CoreExpr,
) -> CoreExpr:
	if not is_managed_type(env, func_info.return_type):
		body
	else:
		var result: CoreExpr = body
		var index: Int = 0

		for param in func_info.params:
			if is_managed_type(env, param.typ) and not consumed_params.contains(index):
				result = retain_borrowed_param_result(env, param, result)
			else:
				void

			index += 1

		result


private pure func retain_match_binding_literal_case_results(
	env: PerceusEnv,
	match_case: CoreLiteralMatchCase,
) -> CoreLiteralMatchCase:
	{ match_case |
		body = retain_borrowed_binding_results(env, match_case.bindings, match_case.body)
	}


private pure func retain_match_binding_literal_cases_results(
	env: PerceusEnv,
	cases: List[CoreLiteralMatchCase],
) -> List[CoreLiteralMatchCase]:
	var retained: List[CoreLiteralMatchCase] = []

	for match_case in cases:
		retained = retained.append(retain_match_binding_literal_case_results(env, match_case))

	retained


private pure func retain_match_binding_literal_fallback_results(
	env: PerceusEnv,
	fallback: CoreLiteralMatchFallback,
) -> CoreLiteralMatchFallback:
	match fallback:
		LiteralMatchFallbackBody(body):
			LiteralMatchFallbackBody(body)
		LiteralMatchFallbackBindings(bindings, body):
			LiteralMatchFallbackBindings(
				bindings,
				retain_borrowed_binding_results(env, bindings, body),
			)
		LiteralMatchFallbackFail:
			LiteralMatchFallbackFail


private pure func retain_match_binding_length_branch_results(
	env: PerceusEnv,
	branch: CoreConstructorLengthMatchBranch,
) -> CoreConstructorLengthMatchBranch:
	nested_body: CoreConstructorMatchBody = retain_match_binding_constructor_body_results(
		env,
		branch.body,
	)

	{ branch |
		body = retain_borrowed_binding_results_in_constructor_body(
			env,
			branch.bindings,
			nested_body,
		)
	}


private pure func retain_match_binding_length_case_results(
	env: PerceusEnv,
	match_case: CoreConstructorLengthMatchCase,
) -> CoreConstructorLengthMatchCase:
	{ match_case | branch = retain_match_binding_length_branch_results(env, match_case.branch) }


private pure func retain_match_binding_length_cases_results(
	env: PerceusEnv,
	cases: List[CoreConstructorLengthMatchCase],
) -> List[CoreConstructorLengthMatchCase]:
	var retained: List[CoreConstructorLengthMatchCase] = []

	for match_case in cases:
		retained = retained.append(retain_match_binding_length_case_results(env, match_case))

	retained


private pure func retain_match_binding_length_match_results(
	env: PerceusEnv,
	match_expr: CoreConstructorLengthMatch,
) -> CoreConstructorLengthMatch:
	retained_geq: Option[CoreConstructorLengthMatchGeq] = match match_expr.geq:
		Some(match_case):
			Some(
				{ match_case |
					branch = retain_match_binding_length_branch_results(env, match_case.branch)
				},
			)
		None:
			None

	retained_fallback: Option[CoreConstructorLengthMatchBranch] = match match_expr.fallback:
		Some(branch):
			Some(retain_match_binding_length_branch_results(env, branch))
		None:
			None

	{ match_expr |
		cases = retain_match_binding_length_cases_results(env, match_expr.cases),
		geq = retained_geq,
		fallback = retained_fallback
	}


private pure func retain_match_binding_constructor_body_results(
	env: PerceusEnv,
	body: CoreConstructorMatchBody,
) -> CoreConstructorMatchBody:
	match body:
		ConstructorMatchBodyExpr(expr):
			ConstructorMatchBodyExpr(expr)
		ConstructorMatchBodyLiteral(match_expr):
			ConstructorMatchBodyLiteral({ match_expr |
					cases = retain_match_binding_literal_cases_results(env, match_expr.cases),
					fallback = retain_match_binding_literal_fallback_results(
						env,
						match_expr.fallback,
					)
				})
		ConstructorMatchBodyLength(match_expr):
			ConstructorMatchBodyLength(retain_match_binding_length_match_results(env, match_expr))


private pure func retain_match_binding_constructor_case_results(
	env: PerceusEnv,
	match_case: CoreConstructorMatchCase,
) -> CoreConstructorMatchCase:
	{ match_case | body = retain_borrowed_binding_results_in_constructor_body(
			env,
			match_case.bindings,
			retain_match_binding_constructor_body_results(env, match_case.body),
		) }


private pure func retain_match_binding_constructor_cases_results(
	env: PerceusEnv,
	cases: List[CoreConstructorMatchCase],
) -> List[CoreConstructorMatchCase]:
	var retained: List[CoreConstructorMatchCase] = []

	for match_case in cases:
		retained = retained.append(retain_match_binding_constructor_case_results(env, match_case))

	retained


private pure func retain_match_binding_constructor_fallback_results(
	env: PerceusEnv,
	fallback: CoreConstructorMatchFallback,
) -> CoreConstructorMatchFallback:
	match fallback:
		ConstructorMatchFallbackBody(body):
			ConstructorMatchFallbackBody(body)
		ConstructorMatchFallbackBindings(bindings, body):
			ConstructorMatchFallbackBindings(
				bindings,
				retain_borrowed_binding_results(env, bindings, body),
			)
		ConstructorMatchFallbackFail:
			ConstructorMatchFallbackFail


private pure func retain_borrowed_match_binding_results(
	env: PerceusEnv,
	expr: CoreExpr,
) -> CoreExpr:
	match expr:
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			LiteralMatchExpr(
				scrutinee,
				retain_match_binding_literal_cases_results(env, cases),
				retain_match_binding_literal_fallback_results(env, fallback),
				copy_core_type(typ),
				loc,
			)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			AccessorLiteralMatchExpr(
				scrutinee,
				release_policy,
				{ match_expr |
					cases = retain_match_binding_literal_cases_results(env, match_expr.cases),
					fallback = retain_match_binding_literal_fallback_results(
						env,
						match_expr.fallback,
					)
				},
				copy_core_type(typ),
				loc,
			)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			LengthMatchExpr(
				scrutinee,
				release_policy,
				retain_match_binding_length_match_results(env, match_expr),
				copy_core_type(typ),
				loc,
			)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			ConstructorMatchExpr(
				scrutinee,
				release_policy,
				retain_match_binding_constructor_cases_results(env, cases),
				retain_match_binding_constructor_fallback_results(env, fallback),
				copy_core_type(typ),
				loc,
			)
		_:
			expr


private pure func retain_borrowed_aggregate_value_with_temp(
	env: PerceusEnv,
	param: CoreParam,
	value: CoreExpr,
	temp: Option[CoreVar],
) -> CoreExpr:
	nested_safe_value: CoreExpr = retain_borrowed_param_aggregate_members(env, param, value)

	match nested_safe_value:
		VarExpr(variable, typ, loc):
			if core_var_matches_param(variable, param) and is_managed_type(env, typ):
				DupExpr(
					copy_core_var(variable),
					copy_core_type(typ),
					retain_policy_for_type(typ),
					nested_safe_value,
					copy_core_type(typ),
					loc,
				)
			else:
				nested_safe_value
		TupleExpr(items, typ, loc):
			nested_safe_value
		VectorExpr(items, typ, loc):
			nested_safe_value
		RecordExpr(fields, typ, loc):
			nested_safe_value
		RecordConstructExpr(type_name, fields, typ, loc):
			nested_safe_value
		ListConstructExpr(construct, typ, loc):
			nested_safe_value
		TensorBoxedLiteralExpr(literal, typ, loc):
			nested_safe_value
		DictConstructExpr(construct, typ, loc):
			nested_safe_value
		UnionConstructExpr(construct, typ, loc):
			nested_safe_value
		_:
			if (
				is_managed_type(env, expr_result_type(nested_safe_value))
				and borrow_expr_aliases_param(env, param, nested_safe_value)
			):
				match temp:
					Some(variable):
						retain_borrowed_alias_result_with_temp(nested_safe_value, variable)
					None:
						retain_borrowed_alias_result(param, nested_safe_value)
			else:
				nested_safe_value


private pure func retain_borrowed_aggregate_value(
	env: PerceusEnv,
	param: CoreParam,
	value: CoreExpr,
) -> CoreExpr:
	retain_borrowed_aggregate_value_with_temp(env, param, value, None)


private pure func protect_borrowed_param_call_args(
	env: PerceusEnv,
	param: CoreParam,
	kind: CoreCallKind,
	args: List[CoreExpr],
	return_type: CoreType,
	call_loc: CoreSourceLoc,
) -> List[CoreExpr]:
	match contract_for_call(env, kind, args.length(), return_type):
		Some(contract):
			var protected: List[CoreExpr] = []
			var index: Int = 0

			for arg in args:
				match contract.args.get(index):
					Some(mode):
						if arg_consumes_caller(mode) and borrow_expr_aliases_param(env, param, arg):
							temp: CoreVar = synthetic_binding_var(
								"borrowed_result_${param.name.name}_call_arg",
								index,
								call_loc,
							)
							protected = protected.append(
								retain_borrowed_aggregate_value_with_temp(
									env,
									param,
									arg,
									Some(temp),
								),
							)
						else:
							protected = protected.append(arg)
					None:
						protected = protected.append(arg)

				index += 1

			protected
		None:
			args


private pure func protect_borrowed_param_equality_arg(
	env: PerceusEnv,
	param: CoreParam,
	arg: CoreExpr,
	index: Int,
	loc: CoreSourceLoc,
) -> CoreExpr:
	if borrow_expr_aliases_param(env, param, arg):
		temp: CoreVar = synthetic_binding_var(
			"borrowed_result_${param.name.name}_equality_arg",
			index,
			loc,
		)
		retain_borrowed_aggregate_value_with_temp(env, param, arg, Some(temp))
	else:
		arg


private pure func protect_borrowed_param_call_exprs(
	env: PerceusEnv,
	param: CoreParam,
	items: List[CoreExpr],
) -> List[CoreExpr]:
	var protected: List[CoreExpr] = []

	for item in items:
		protected = protected.append(protect_borrowed_param_calls(env, param, item))

	protected


private pure func protect_borrowed_param_call_record_fields(
	env: PerceusEnv,
	param: CoreParam,
	fields: List[CoreRecordFieldValue],
) -> List[CoreRecordFieldValue]:
	var protected: List[CoreRecordFieldValue] = []

	for field in fields:
		protected = protected.append({
			name = field.name,
			value = protect_borrowed_param_calls(env, param, field.value),
		})

	protected


private pure func protect_borrowed_param_call_boxed_value(
	env: PerceusEnv,
	param: CoreParam,
	value: CoreBoxedStorageValue,
) -> CoreBoxedStorageValue:
	{ value | value = protect_borrowed_param_calls(env, param, value.value) }


private pure func protect_borrowed_param_list_set(
	env: PerceusEnv,
	param: CoreParam,
	set: CoreListSet,
) -> CoreListSet:
	protected_value: CoreExpr = protect_borrowed_param_calls(env, param, set.value.value)

	stored_value: CoreExpr = if set.value.transfers_ownership:
		retain_borrowed_aggregate_value(env, param, protected_value)
	else:
		protected_value

	{ set |
		list = protect_borrowed_param_calls(env, param, set.list),
		index = protect_borrowed_param_calls(env, param, set.index),
		value = { set.value | value = stored_value }
	}


private pure func protect_borrowed_param_call_boxed_values(
	env: PerceusEnv,
	param: CoreParam,
	values: List[CoreBoxedStorageValue],
) -> List[CoreBoxedStorageValue]:
	values.map(func(value): protect_borrowed_param_call_boxed_value(env, param, value))


private pure func protect_borrowed_param_call_dict_entries(
	env: PerceusEnv,
	param: CoreParam,
	entries: List[CoreDictEntry],
) -> List[CoreDictEntry]:
	entries.map(func(entry):
		protected: CoreDictEntry = {
			key = protect_borrowed_param_call_boxed_value(env, param, entry.key),
			value = protect_borrowed_param_call_boxed_value(env, param, entry.value)
		}
		protected
	)


private pure func map_borrowed_param_literal_case(
	env: PerceusEnv,
	param: CoreParam,
	match_case: CoreLiteralMatchCase,
	mapper: pure (PerceusEnv, CoreParam, CoreExpr) -> CoreExpr,
) -> CoreLiteralMatchCase:
	if match_bindings_shadow_param(match_case.bindings, param):
		match_case
	else:
		{ match_case | body = mapper(env, param, match_case.body) }


private pure func map_borrowed_param_literal_fallback(
	env: PerceusEnv,
	param: CoreParam,
	fallback: CoreLiteralMatchFallback,
	mapper: pure (PerceusEnv, CoreParam, CoreExpr) -> CoreExpr,
) -> CoreLiteralMatchFallback:
	match fallback:
		LiteralMatchFallbackBody(body):
			LiteralMatchFallbackBody(mapper(env, param, body))
		LiteralMatchFallbackBindings(bindings, body):
			if match_bindings_shadow_param(bindings, param):
				fallback
			else:
				LiteralMatchFallbackBindings(
					bindings,
					mapper(env, param, body),
				)
		LiteralMatchFallbackFail:
			LiteralMatchFallbackFail


private pure func map_borrowed_param_literal_cases(
	env: PerceusEnv,
	param: CoreParam,
	cases: List[CoreLiteralMatchCase],
	mapper: pure (PerceusEnv, CoreParam, CoreExpr) -> CoreExpr,
) -> List[CoreLiteralMatchCase]:
	cases.map(func(match_case): map_borrowed_param_literal_case(env, param, match_case, mapper))


private pure func map_borrowed_param_literal_match(
	env: PerceusEnv,
	param: CoreParam,
	match_expr: CoreConstructorLiteralMatch,
	mapper: pure (PerceusEnv, CoreParam, CoreExpr) -> CoreExpr,
) -> CoreConstructorLiteralMatch:
	{ match_expr |
		cases = map_borrowed_param_literal_cases(env, param, match_expr.cases, mapper),
		fallback = map_borrowed_param_literal_fallback(env, param, match_expr.fallback, mapper)
	}


private pure func map_borrowed_param_constructor_body(
	env: PerceusEnv,
	param: CoreParam,
	body: CoreConstructorMatchBody,
	mapper: pure (PerceusEnv, CoreParam, CoreExpr) -> CoreExpr,
) -> CoreConstructorMatchBody:
	match body:
		ConstructorMatchBodyExpr(expr):
			ConstructorMatchBodyExpr(mapper(env, param, expr))
		ConstructorMatchBodyLiteral(match_expr):
			ConstructorMatchBodyLiteral(
				map_borrowed_param_literal_match(
					env,
					param,
					match_expr,
					mapper,
				),
			)
		ConstructorMatchBodyLength(match_expr):
			ConstructorMatchBodyLength(
				map_borrowed_param_length_match(
					env,
					param,
					match_expr,
					mapper,
				),
			)


private pure func map_borrowed_param_length_branch(
	env: PerceusEnv,
	param: CoreParam,
	branch: CoreConstructorLengthMatchBranch,
	mapper: pure (PerceusEnv, CoreParam, CoreExpr) -> CoreExpr,
) -> CoreConstructorLengthMatchBranch:
	if match_bindings_shadow_param(branch.bindings, param):
		branch
	else:
		{ branch | body = map_borrowed_param_constructor_body(env, param, branch.body, mapper) }


private pure func map_borrowed_param_length_match(
	env: PerceusEnv,
	param: CoreParam,
	match_expr: CoreConstructorLengthMatch,
	mapper: pure (PerceusEnv, CoreParam, CoreExpr) -> CoreExpr,
) -> CoreConstructorLengthMatch:
	mapped_cases: List[CoreConstructorLengthMatchCase] = match_expr.cases.map(func(match_case):
		{ match_case |
			branch = map_borrowed_param_length_branch(env, param, match_case.branch, mapper)
		}
	)

	mapped_geq: Option[CoreConstructorLengthMatchGeq] = match match_expr.geq:
		Some(geq):
			Some(
				{ geq |
					branch = map_borrowed_param_length_branch(env, param, geq.branch, mapper)
				},
			)
		None:
			None

	mapped_fallback: Option[CoreConstructorLengthMatchBranch] = match match_expr.fallback:
		Some(branch):
			Some(map_borrowed_param_length_branch(env, param, branch, mapper))
		None:
			None

	{ match_expr |
		cases = mapped_cases,
		geq = mapped_geq,
		fallback = mapped_fallback
	}


private pure func map_borrowed_param_constructor_case(
	env: PerceusEnv,
	param: CoreParam,
	match_case: CoreConstructorMatchCase,
	mapper: pure (PerceusEnv, CoreParam, CoreExpr) -> CoreExpr,
) -> CoreConstructorMatchCase:
	if match_bindings_shadow_param(match_case.bindings, param):
		match_case
	else:
		{ match_case |
			body = map_borrowed_param_constructor_body(env, param, match_case.body, mapper)
		}


private pure func map_borrowed_param_constructor_fallback(
	env: PerceusEnv,
	param: CoreParam,
	fallback: CoreConstructorMatchFallback,
	mapper: pure (PerceusEnv, CoreParam, CoreExpr) -> CoreExpr,
) -> CoreConstructorMatchFallback:
	match fallback:
		ConstructorMatchFallbackBody(body):
			ConstructorMatchFallbackBody(mapper(env, param, body))
		ConstructorMatchFallbackBindings(bindings, body):
			if match_bindings_shadow_param(bindings, param):
				fallback
			else:
				ConstructorMatchFallbackBindings(
					bindings,
					mapper(env, param, body),
				)
		ConstructorMatchFallbackFail:
			ConstructorMatchFallbackFail


private pure func map_borrowed_param_constructor_cases(
	env: PerceusEnv,
	param: CoreParam,
	cases: List[CoreConstructorMatchCase],
	mapper: pure (PerceusEnv, CoreParam, CoreExpr) -> CoreExpr,
) -> List[CoreConstructorMatchCase]:
	cases.map(func(match_case): map_borrowed_param_constructor_case(env, param, match_case, mapper))


private pure func protect_borrowed_param_calls(
	env: PerceusEnv,
	param: CoreParam,
	expr: CoreExpr,
) -> CoreExpr:
	match expr:
		CallExpr(kind, callee, args, typ, loc):
			protected_callee: CoreExpr = protect_borrowed_param_calls(env, param, callee)
			var protected_args: List[CoreExpr] = []

			for arg in args:
				protected_args = protected_args.append(
					protect_borrowed_param_calls(
						env,
						param,
						arg,
					),
				)

			CallExpr(
				copy_core_call_kind(kind),
				protected_callee,
				protect_borrowed_param_call_args(env, param, kind, protected_args, typ, loc),
				copy_core_type(typ),
				loc,
			)
		BinaryExpr(op, left, right, typ, loc):
			protected_left: CoreExpr = protect_borrowed_param_calls(env, param, left)
			protected_right: CoreExpr = protect_borrowed_param_calls(env, param, right)

			if is_consuming_collection_equality(op, protected_left, protected_right):
				BinaryExpr(
					op,
					protect_borrowed_param_equality_arg(env, param, protected_left, 0, loc),
					protect_borrowed_param_equality_arg(env, param, protected_right, 1, loc),
					copy_core_type(typ),
					loc,
				)
			else:
				BinaryExpr(op, protected_left, protected_right, copy_core_type(typ), loc)
		BoxExpr(box, typ, loc):
			BoxExpr(
				{ box | value = protect_borrowed_param_calls(env, param, box.value) },
				copy_core_type(typ),
				loc,
			)
		CastExpr(inner, typ, loc):
			CastExpr(
				protect_borrowed_param_calls(env, param, inner),
				copy_core_type(typ),
				loc,
			)
		DictConstructExpr(construct, typ, loc):
			DictConstructExpr(
				{ construct |
					entries = protect_borrowed_param_call_dict_entries(
						env,
						param,
						construct.entries,
					)
				},
				copy_core_type(typ),
				loc,
			)
		FieldExpr(owner, field, typ, loc):
			FieldExpr(
				protect_borrowed_param_calls(env, param, owner),
				field,
				copy_core_type(typ),
				loc,
			)
		ListConstructExpr(construct, typ, loc):
			ListConstructExpr(
				{ construct |
					elements = protect_borrowed_param_call_boxed_values(
						env,
						param,
						construct.elements,
					)
				},
				copy_core_type(typ),
				loc,
			)
		ListHandoffSetOwnedExpr(set, typ, loc):
			ListHandoffSetOwnedExpr(
				protect_borrowed_param_list_set(env, param, set),
				copy_core_type(typ),
				loc,
			)
		ListSetExpr(set, typ, loc):
			ListSetExpr(
				protect_borrowed_param_list_set(env, param, set),
				copy_core_type(typ),
				loc,
			)
		LogicalExpr(op, left, right, typ, loc):
			LogicalExpr(
				op,
				protect_borrowed_param_calls(env, param, left),
				protect_borrowed_param_calls(env, param, right),
				copy_core_type(typ),
				loc,
			)
		RecordConstructExpr(type_name, fields, typ, loc):
			RecordConstructExpr(
				type_name,
				protect_borrowed_param_call_record_fields(env, param, fields),
				copy_core_type(typ),
				loc,
			)
		RecordExpr(fields, typ, loc):
			RecordExpr(
				protect_borrowed_param_call_record_fields(env, param, fields),
				copy_core_type(typ),
				loc,
			)
		TensorBoxedLiteralExpr(literal, typ, loc):
			TensorBoxedLiteralExpr(
				{ literal |
					elements = protect_borrowed_param_call_boxed_values(
						env,
						param,
						literal.elements,
					)
				},
				copy_core_type(typ),
				loc,
			)
		TupleExpr(items, typ, loc):
			TupleExpr(
				protect_borrowed_param_call_exprs(env, param, items),
				copy_core_type(typ),
				loc,
			)
		TupleFieldExpr(owner, field_index, typ, loc):
			TupleFieldExpr(
				protect_borrowed_param_calls(env, param, owner),
				field_index,
				copy_core_type(typ),
				loc,
			)
		UnaryExpr(op, inner, typ, loc):
			UnaryExpr(
				op,
				protect_borrowed_param_calls(env, param, inner),
				copy_core_type(typ),
				loc,
			)
		UnboxExpr(kind, inner, typ, loc):
			UnboxExpr(
				kind,
				protect_borrowed_param_calls(env, param, inner),
				copy_core_type(typ),
				loc,
			)
		UnionConstructExpr(construct, typ, loc):
			UnionConstructExpr(
				{ construct |
					args = protect_borrowed_param_call_boxed_values(env, param, construct.args)
				},
				copy_core_type(typ),
				loc,
			)
		VectorExpr(items, typ, loc):
			VectorExpr(
				protect_borrowed_param_call_exprs(env, param, items),
				copy_core_type(typ),
				loc,
			)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			LiteralMatchExpr(
				protect_borrowed_param_calls(env, param, scrutinee),
				map_borrowed_param_literal_cases(env, param, cases, protect_borrowed_param_calls),
				map_borrowed_param_literal_fallback(
					env,
					param,
					fallback,
					protect_borrowed_param_calls,
				),
				copy_core_type(typ),
				loc,
			)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			AccessorLiteralMatchExpr(
				protect_borrowed_param_calls(env, param, scrutinee),
				release_policy,
				map_borrowed_param_literal_match(
					env,
					param,
					match_expr,
					protect_borrowed_param_calls,
				),
				copy_core_type(typ),
				loc,
			)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			LengthMatchExpr(
				protect_borrowed_param_calls(env, param, scrutinee),
				release_policy,
				map_borrowed_param_length_match(
					env,
					param,
					match_expr,
					protect_borrowed_param_calls,
				),
				copy_core_type(typ),
				loc,
			)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			ConstructorMatchExpr(
				protect_borrowed_param_calls(env, param, scrutinee),
				release_policy,
				map_borrowed_param_constructor_cases(
					env,
					param,
					cases,
					protect_borrowed_param_calls,
				),
				map_borrowed_param_constructor_fallback(
					env,
					param,
					fallback,
					protect_borrowed_param_calls,
				),
				copy_core_type(typ),
				loc,
			)
		LetExpr(variable, is_mutable, typ, rhs, body):
			protected_body: CoreExpr = if core_var_matches_param(variable, param):
				body
			else:
				protect_borrowed_param_calls(env, param, body)

			LetExpr(
				copy_core_var(variable),
				is_mutable,
				copy_core_type(typ),
				protect_borrowed_param_calls(env, param, rhs),
				protected_body,
			)
		BorrowLetExpr(variable, typ, rhs, body):
			protected_body: CoreExpr = if core_var_matches_param(variable, param):
				body
			else:
				protect_borrowed_param_calls(env, param, body)

			BorrowLetExpr(
				copy_core_var(variable),
				copy_core_type(typ),
				protect_borrowed_param_calls(env, param, rhs),
				protected_body,
			)
		SeqExpr(first, second):
			SeqExpr(
				protect_borrowed_param_calls(env, param, first),
				protect_borrowed_param_calls(env, param, second),
			)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			IfExpr(
				protect_borrowed_param_calls(env, param, cond),
				protect_borrowed_param_calls(env, param, then_expr),
				protect_borrowed_param_calls(env, param, else_expr),
				copy_core_type(typ),
				loc,
			)
		AssignExpr(variable, rhs, typ, loc):
			AssignExpr(
				copy_core_var(variable),
				protect_borrowed_param_calls(env, param, rhs),
				copy_core_type(typ),
				loc,
			)
		WhileExpr(cond, body, typ, loc):
			WhileExpr(
				protect_borrowed_param_calls(env, param, cond),
				protect_borrowed_param_calls(env, param, body),
				copy_core_type(typ),
				loc,
			)
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			ForRangeExpr(
				binder,
				protect_borrowed_param_calls(env, param, start),
				protect_borrowed_param_calls(env, param, end_value),
				protect_borrowed_param_loop_body(env, param, binder, body),
				copy_core_type(typ),
				loc,
			)
		ForChannelExpr(loop, typ, loc):
			ForChannelExpr(
				{ loop |
					iterable = protect_borrowed_param_calls(env, param, loop.iterable),
					body = protect_borrowed_param_loop_body(env, param, loop.binder, loop.body)
				},
				copy_core_type(typ),
				loc,
			)
		ForListExpr(loop, typ, loc):
			ForListExpr(
				{ loop |
					iterable = protect_borrowed_param_calls(env, param, loop.iterable),
					body = protect_borrowed_param_loop_body(env, param, loop.binder, loop.body)
				},
				copy_core_type(typ),
				loc,
			)
		ForStringExpr(loop, typ, loc):
			ForStringExpr(
				{ loop |
					iterable = protect_borrowed_param_calls(env, param, loop.iterable),
					body = protect_borrowed_param_loop_body(env, param, loop.binder, loop.body)
				},
				copy_core_type(typ),
				loc,
			)
		ForDictExpr(loop, typ, loc):
			ForDictExpr(
				{ loop |
					iterable = protect_borrowed_param_calls(env, param, loop.iterable),
					body = protect_borrowed_param_loop_body(env, param, loop.binder, loop.body)
				},
				copy_core_type(typ),
				loc,
			)
		ForSetExpr(loop, typ, loc):
			ForSetExpr(
				{ loop |
					iterable = protect_borrowed_param_calls(env, param, loop.iterable),
					body = protect_borrowed_param_loop_body(env, param, loop.binder, loop.body)
				},
				copy_core_type(typ),
				loc,
			)
		ForStreamExpr(loop, typ, loc):
			ForStreamExpr(
				{ loop |
					iterable = protect_borrowed_param_calls(env, param, loop.iterable),
					body = protect_borrowed_param_loop_body(env, param, loop.binder, loop.body)
				},
				copy_core_type(typ),
				loc,
			)
		ForResourceSourceExpr(loop, typ, loc):
			ForResourceSourceExpr(
				{ loop |
					iterable = protect_borrowed_param_calls(env, param, loop.iterable),
					body = protect_borrowed_param_loop_body(env, param, loop.binder, loop.body)
				},
				copy_core_type(typ),
				loc,
			)
		ForTensorExpr(loop, typ, loc):
			ForTensorExpr(
				{ loop |
					iterable = protect_borrowed_param_calls(env, param, loop.iterable),
					body = protect_borrowed_param_loop_body(env, param, loop.binder, loop.body)
				},
				copy_core_type(typ),
				loc,
			)
		ResourceScopeExpr(scope, typ, loc):
			scope_shadows_param: Bool = core_var_matches_param(scope.variable, param)

			protected_body: CoreExpr = if scope_shadows_param:
				scope.body
			else:
				protect_borrowed_param_calls(env, param, scope.body)

			protected_cleanup: CoreExpr = if scope_shadows_param:
				scope.cleanup
			else:
				protect_borrowed_param_calls(env, param, scope.cleanup)

			ResourceScopeExpr(
				{ scope |
					acquire = protect_borrowed_param_calls(env, param, scope.acquire),
					body = protected_body,
					cleanup = protected_cleanup
				},
				copy_core_type(typ),
				loc,
			)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			DupExpr(
				copy_core_var(variable),
				copy_core_type(value_type),
				retain_policy,
				protect_borrowed_param_calls(env, param, body),
				copy_core_type(typ),
				loc,
			)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			DropExpr(
				copy_core_var(variable),
				copy_core_type(value_type),
				release_policy,
				protect_borrowed_param_calls(env, param, body),
				copy_core_type(typ),
				loc,
			)
		_:
			expr


private pure func protect_borrowed_param_loop_body(
	env: PerceusEnv,
	param: CoreParam,
	binder: CoreLoopBinder,
	body: CoreExpr,
) -> CoreExpr:
	if core_var_matches_param(binder.variable, param):
		body
	else:
		protect_borrowed_param_calls(env, param, body)


private pure func protect_borrowed_param_calls_for_function(
	env: PerceusEnv,
	func_info: CoreFunction,
	consumed_params: List[Int],
	body: CoreExpr,
) -> CoreExpr:
	var result: CoreExpr = body
	var index: Int = 0

	for param in func_info.params:
		if is_managed_type(env, param.typ) and not int_list_contains(consumed_params, index):
			result = protect_borrowed_param_calls(env, param, result)
		else:
			void

		index += 1

	result


private pure func retain_borrowed_aggregate_boxed_value(
	env: PerceusEnv,
	param: CoreParam,
	value: CoreBoxedStorageValue,
) -> CoreBoxedStorageValue:
	if value.needs_release:
		{
			kind = value.kind,
			value = retain_borrowed_aggregate_value(env, param, value.value),
			needs_release = value.needs_release,
			transfers_ownership = value.transfers_ownership
		}
	else:
		value


private pure func retain_borrowed_aggregate_exprs(
	env: PerceusEnv,
	param: CoreParam,
	items: List[CoreExpr],
) -> List[CoreExpr]:
	var retained: List[CoreExpr] = []

	for item in items:
		retained = retained.append(retain_borrowed_aggregate_value(env, param, item))

	retained


private pure func retain_borrowed_aggregate_record_fields(
	env: PerceusEnv,
	param: CoreParam,
	fields: List[CoreRecordFieldValue],
) -> List[CoreRecordFieldValue]:
	var retained: List[CoreRecordFieldValue] = []

	for field in fields:
		retained = retained.append({
			name = field.name,
			value = retain_borrowed_aggregate_value(env, param, field.value),
		})

	retained


private pure func retain_borrowed_aggregate_boxed_values(
	env: PerceusEnv,
	param: CoreParam,
	values: List[CoreBoxedStorageValue],
) -> List[CoreBoxedStorageValue]:
	var retained: List[CoreBoxedStorageValue] = []

	for value in values:
		retained = retained.append(retain_borrowed_aggregate_boxed_value(env, param, value))

	retained


private pure func retain_borrowed_aggregate_dict_entries(
	env: PerceusEnv,
	param: CoreParam,
	entries: List[CoreDictEntry],
) -> List[CoreDictEntry]:
	var retained: List[CoreDictEntry] = []

	for entry in entries:
		retained = retained.append({
			key = retain_borrowed_aggregate_boxed_value(env, param, entry.key),
			value = retain_borrowed_aggregate_boxed_value(env, param, entry.value),
		})

	retained


private pure func retain_borrowed_param_aggregate_members(
	env: PerceusEnv,
	param: CoreParam,
	expr: CoreExpr,
) -> CoreExpr:
	match expr:
		CallExpr(kind, callee, args, typ, loc):
			var retained_args: List[CoreExpr] = []

			for arg in args:
				retained_args = retained_args.append(
					retain_borrowed_param_aggregate_members(
						env,
						param,
						arg,
					),
				)

			CallExpr(copy_core_call_kind(kind), callee, retained_args, copy_core_type(typ), loc)
		TupleExpr(items, typ, loc):
			TupleExpr(
				retain_borrowed_aggregate_exprs(env, param, items),
				copy_core_type(typ),
				loc,
			)
		VectorExpr(items, typ, loc):
			VectorExpr(
				retain_borrowed_aggregate_exprs(env, param, items),
				copy_core_type(typ),
				loc,
			)
		RecordExpr(fields, typ, loc):
			RecordExpr(
				retain_borrowed_aggregate_record_fields(env, param, fields),
				copy_core_type(typ),
				loc,
			)
		RecordConstructExpr(type_name, fields, typ, loc):
			RecordConstructExpr(
				type_name,
				retain_borrowed_aggregate_record_fields(env, param, fields),
				copy_core_type(typ),
				loc,
			)
		ListConstructExpr(construct, typ, loc):
			ListConstructExpr(
				{ construct |
					elements = retain_borrowed_aggregate_boxed_values(
						env,
						param,
						construct.elements,
					)
				},
				copy_core_type(typ),
				loc,
			)
		TensorBoxedLiteralExpr(literal, typ, loc):
			TensorBoxedLiteralExpr(
				{ literal |
					elements = retain_borrowed_aggregate_boxed_values(env, param, literal.elements)
				},
				copy_core_type(typ),
				loc,
			)
		DictConstructExpr(construct, typ, loc):
			DictConstructExpr(
				{ construct |
					entries = retain_borrowed_aggregate_dict_entries(env, param, construct.entries)
				},
				copy_core_type(typ),
				loc,
			)
		UnionConstructExpr(construct, typ, loc):
			UnionConstructExpr(
				{ construct |
					args = retain_borrowed_aggregate_boxed_values(env, param, construct.args)
				},
				copy_core_type(typ),
				loc,
			)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			LiteralMatchExpr(
				retain_borrowed_param_aggregate_members(env, param, scrutinee),
				map_borrowed_param_literal_cases(
					env,
					param,
					cases,
					retain_borrowed_param_aggregate_members,
				),
				map_borrowed_param_literal_fallback(
					env,
					param,
					fallback,
					retain_borrowed_param_aggregate_members,
				),
				copy_core_type(typ),
				loc,
			)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			AccessorLiteralMatchExpr(
				retain_borrowed_param_aggregate_members(env, param, scrutinee),
				release_policy,
				map_borrowed_param_literal_match(
					env,
					param,
					match_expr,
					retain_borrowed_param_aggregate_members,
				),
				copy_core_type(typ),
				loc,
			)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			LengthMatchExpr(
				retain_borrowed_param_aggregate_members(env, param, scrutinee),
				release_policy,
				map_borrowed_param_length_match(
					env,
					param,
					match_expr,
					retain_borrowed_param_aggregate_members,
				),
				copy_core_type(typ),
				loc,
			)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			ConstructorMatchExpr(
				retain_borrowed_param_aggregate_members(env, param, scrutinee),
				release_policy,
				map_borrowed_param_constructor_cases(
					env,
					param,
					cases,
					retain_borrowed_param_aggregate_members,
				),
				map_borrowed_param_constructor_fallback(
					env,
					param,
					fallback,
					retain_borrowed_param_aggregate_members,
				),
				copy_core_type(typ),
				loc,
			)
		LetExpr(variable, is_mutable, typ, rhs, body):
			retained_body: CoreExpr = if core_var_matches_param(variable, param):
				body
			else:
				retain_borrowed_param_aggregate_members(env, param, body)

			LetExpr(
				copy_core_var(variable),
				is_mutable,
				copy_core_type(typ),
				retain_borrowed_param_aggregate_members(env, param, rhs),
				retained_body,
			)
		BorrowLetExpr(variable, typ, rhs, body):
			retained_body: CoreExpr = if core_var_matches_param(variable, param):
				body
			else:
				retain_borrowed_param_aggregate_members(env, param, body)

			BorrowLetExpr(
				copy_core_var(variable),
				copy_core_type(typ),
				retain_borrowed_param_aggregate_members(env, param, rhs),
				retained_body,
			)
		SeqExpr(first, second):
			SeqExpr(
				retain_borrowed_param_aggregate_members(env, param, first),
				retain_borrowed_param_aggregate_members(env, param, second),
			)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			IfExpr(
				retain_borrowed_param_aggregate_members(env, param, cond),
				retain_borrowed_param_aggregate_members(env, param, then_expr),
				retain_borrowed_param_aggregate_members(env, param, else_expr),
				copy_core_type(typ),
				loc,
			)
		AssignExpr(variable, rhs, typ, loc):
			AssignExpr(
				copy_core_var(variable),
				retain_borrowed_param_aggregate_members(env, param, rhs),
				copy_core_type(typ),
				loc,
			)
		WhileExpr(cond, body, typ, loc):
			WhileExpr(
				retain_borrowed_param_aggregate_members(env, param, cond),
				retain_borrowed_param_aggregate_members(env, param, body),
				copy_core_type(typ),
				loc,
			)
		ResourceScopeExpr(scope, typ, loc):
			scope_shadows_param: Bool = core_var_matches_param(scope.variable, param)

			retained_body: CoreExpr = if scope_shadows_param:
				scope.body
			else:
				retain_borrowed_param_aggregate_members(env, param, scope.body)

			retained_cleanup: CoreExpr = if scope_shadows_param:
				scope.cleanup
			else:
				retain_borrowed_param_aggregate_members(env, param, scope.cleanup)

			ResourceScopeExpr(
				{ scope |
					acquire = retain_borrowed_param_aggregate_members(env, param, scope.acquire),
					body = retained_body,
					cleanup = retained_cleanup
				},
				copy_core_type(typ),
				loc,
			)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			DupExpr(
				copy_core_var(variable),
				copy_core_type(value_type),
				retain_policy,
				retain_borrowed_param_aggregate_members(env, param, body),
				copy_core_type(typ),
				loc,
			)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			DropExpr(
				copy_core_var(variable),
				copy_core_type(value_type),
				release_policy,
				retain_borrowed_param_aggregate_members(env, param, body),
				copy_core_type(typ),
				loc,
			)
		_:
			expr


private pure func retain_borrowed_param_aggregates(
	env: PerceusEnv,
	func_info: CoreFunction,
	consumed_params: List[Int],
	body: CoreExpr,
) -> CoreExpr:
	var result: CoreExpr = body
	var index: Int = 0

	for param in func_info.params:
		if is_managed_type(env, param.typ) and not int_list_contains(consumed_params, index):
			result = retain_borrowed_param_aggregate_members(env, param, result)
		else:
			void

		index += 1

	result


private pure func retain_borrowed_values(
	env: PerceusEnv,
	borrowed_values: List[CoreParam],
	return_type: CoreType,
	body: CoreExpr,
) -> CoreExpr:
	managed_result: Bool = is_managed_type(env, return_type)
	var result: CoreExpr = body

	for value in borrowed_values:
		if is_managed_type(env, value.typ):
			result = protect_borrowed_param_calls(env, value, result)
			result = retain_borrowed_param_aggregate_members(env, value, result)

			if managed_result:
				result = retain_borrowed_param_result(env, value, result)
			else:
				void
		else:
			void

	result


private pure func global_is_unshadowed(
	shadowing_values: List[CoreParam],
	global: PerceusGlobal,
) -> Bool:
	not shadowing_values.any(
		func(param): core_vars_have_same_definition(param.name, global.value.name),
	)


private pure func global_is_referenced(value_reads: List[CoreVar], global: PerceusGlobal) -> Bool:
	match global.value.name.def_id:
		Some(_):
			value_reads.any(
				func(variable): core_vars_have_same_definition(variable, global.value.name),
			)
		None:
			False


private pure func unshadowed_global_values(
	env: PerceusEnv,
	shadowing_values: List[CoreParam],
	body: CoreExpr,
) -> List[CoreParam]:
	value_reads: List[CoreVar] = CoreDce.value_references(body).resolved_reads
	var result: List[CoreParam] = []

	for global in env.global_values:
		already_selected: Bool = result.any(
			func(value): core_vars_have_same_definition(value.name, global.value.name),
		)

		if (
			global_is_referenced(value_reads, global)
			and global_is_unshadowed(shadowing_values, global)
			and not already_selected
		):
			result = result.append(global.value)
		else:
			void

	result


private pure func mutable_managed_global_for_target(
	env: PerceusEnv,
	target: CoreVar,
) -> Option[CoreParam]:
	var result: Option[CoreParam] = None

	for global in env.global_values:
		if (
			global.is_mutable
			and is_managed_type(env, global.value.typ)
			and core_vars_have_same_definition(target, global.value.name)
		):
			result = Some(global.value)
			break
		else:
			void

	result


private pure func normalize_lambda_body_ownership(
	env: PerceusEnv,
	borrowed_values: List[CoreParam],
	return_type: CoreType,
	body: CoreExpr,
) -> CoreExpr:
	lambda_env: PerceusEnv = { env | transferable_result_vars = [] }
	managed_result: Bool = is_managed_type(lambda_env, return_type)
	global_values: List[CoreParam] = unshadowed_global_values(lambda_env, borrowed_values, body)
	all_borrowed_values: List[CoreParam] = borrowed_values + global_values
	result: CoreExpr = retain_borrowed_values(lambda_env, all_borrowed_values, return_type, body)

	if managed_result:
		normalize_owned_result_aliases(lambda_env, result)
	else:
		result


private pure func lambda_capture_param(capture: CoreClosureCapture) -> CoreParam:
	{
		name = {
			name = capture.name,
			uniq = 0,
			def_id = None
		},
		typ = copy_core_type(capture.typ),
		loc = SyntheticSourceLoc
	}


private pure func normalize_lambda_expr(
	env: PerceusEnv,
	params: List[CoreParam],
	return_type: CoreType,
	body: CoreExpr,
	is_pure: Bool,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	nested_body: CoreExpr = normalize_lambda_result_aliases(env, body)
	captures: List[CoreClosureCapture] = CoreClosure.lambda_runtime_captures(
		env.function_names,
		env.constructor_names,
		params,
		nested_body,
	)
	borrowed_values: List[CoreParam] = params + captures.map(lambda_capture_param)
	normalized_body: CoreExpr = normalize_lambda_body_ownership(
		env,
		borrowed_values,
		return_type,
		nested_body,
	)

	LambdaExpr(
		params,
		copy_core_type(return_type),
		normalized_body,
		is_pure,
		copy_core_type(typ),
		loc,
	)


private pure func normalize_lambda_result_aliases(env: PerceusEnv, expr: CoreExpr) -> CoreExpr:
	match expr:
		LambdaExpr(params, return_type, body, is_pure, typ, loc):
			normalize_lambda_expr(env, params, return_type, body, is_pure, typ, loc)
		ClosureCreateExpr(closure, typ, loc):
			expr
		_:
			CoreTraverse.map_core_expr_children_with_context(
				expr,
				env,
				normalize_lambda_result_aliases,
			)


private pure func balance_consumed_param_body(
	env: PerceusEnv,
	param: CoreParam,
	body: CoreExpr,
) -> CoreExpr:
	variable: CoreVar = copy_core_var(param.name)
	value_type: CoreType = copy_core_type(param.typ)
	protected: CoreExpr = protect_repeated_consumes(
		env,
		copy_core_var(variable),
		copy_core_type(value_type),
		body,
		False,
	)
	balance_env: PerceusEnv = { env | balance_nested_matches = True }
	uses: OwnershipUseSummary = summarize_linear_ownership_uses(
		balance_env,
		variable.name,
		protected,
	)
	owned_refs: Int = max_int(1, uses.required_refs)
	balanced: CoreExpr = balance_branch_body(
		balance_env,
		copy_core_var(variable),
		copy_core_type(value_type),
		owned_refs,
		uses,
		protected,
	)

	prepend_dups(owned_refs - 1, variable, value_type, balanced)


private pure func balance_consumed_param_bodies(
	env: PerceusEnv,
	func_info: CoreFunction,
	consumed_params: List[Int],
	body: CoreExpr,
) -> CoreExpr:
	var result: CoreExpr = body
	var index: Int = func_info.params.length() - 1

	while index >= 0:
		match func_info.params.get(index):
			Some(param):
				if is_managed_type(env, param.typ) and int_list_contains(consumed_params, index):
					result = balance_consumed_param_body(env, param, result)
				else:
					void
			None:
				void

		index -= 1

	result


private pure func rewrite_function(env: PerceusEnv, func_info: CoreFunction) -> CoreFunction:
	name: String = func_info.name
	source_module: Option[String] = func_info.source_module
	type_params: List[String] = func_info.type_params
	params: List[CoreParam] = copy_core_params(func_info.params)
	return_type: CoreType = copy_core_type(func_info.return_type)
	body: Option[CoreExpr] = func_info.body
	is_pure: Bool = func_info.is_pure
	function_kind = func_info.function_kind
	def_id: Int = func_info.def_id
	loc: CoreSourceLoc = func_info.loc

	match body:
		Some(body):
			analysis_function: CoreFunction = {
				name = name,
				source_module = source_module,
				type_params = type_params,
				params = copy_core_params(params),
				return_type = copy_core_type(return_type),
				body = None,
				is_pure = is_pure,
				function_kind = function_kind,
				def_id = def_id,
				loc = loc
			}
			contract_body: CoreExpr = annotate_user_call_contracts(env, body)
			consumed_params: List[Int] = function_consumed_param_indices(env, analysis_function)
			result_env: PerceusEnv = { env |
				transferable_result_vars = consumed_param_vars(analysis_function, consumed_params)
			}
			call_body: CoreExpr = protect_borrowed_param_calls_for_function(
				env,
				analysis_function,
				consumed_params,
				contract_body,
			)
			aggregate_body: CoreExpr = retain_borrowed_param_aggregates(
				env,
				analysis_function,
				consumed_params,
				call_body,
			)
			retained_body: CoreExpr = retain_borrowed_param_results(
				env,
				analysis_function,
				consumed_params,
				aggregate_body,
			)
			global_values: List[CoreParam] = unshadowed_global_values(env, params, retained_body)
			global_safe_body: CoreExpr = retain_borrowed_values(
				env,
				global_values,
				return_type,
				retained_body,
			)

			owned_result_body: CoreExpr = if is_managed_type(env, return_type):
				normalize_owned_result_aliases(result_env, global_safe_body)
			else:
				global_safe_body

			rewritten_body: CoreExpr = insert_drops_expr(env, owned_result_body)
			balanced_body: CoreExpr = balance_consumed_param_bodies(
				env,
				analysis_function,
				consumed_params,
				rewritten_body,
			)

			{
				name = name,
				source_module = source_module,
				type_params = type_params,
				params = params,
				return_type = return_type,
				body = Some(balanced_body),
				is_pure = is_pure,
				function_kind = function_kind,
				def_id = def_id,
				loc = loc
			}
		None:
			{
				name = name,
				source_module = source_module,
				type_params = type_params,
				params = params,
				return_type = return_type,
				body = None,
				is_pure = is_pure,
				function_kind = function_kind,
				def_id = def_id,
				loc = loc
			}


private pure func rewrite_global(env: PerceusEnv, global: CoreGlobal) -> CoreGlobal:
	name: CoreVar = copy_core_var(global.name)
	typ: CoreType = copy_core_type(global.typ)
	init: CoreExpr = global.init
	is_mutable: Bool = global.is_mutable
	is_const: Bool = global.is_const
	is_private: Bool = global.is_private
	def_id: Int = global.def_id
	loc: CoreSourceLoc = global.loc
	contract_init: CoreExpr = annotate_user_call_contracts(env, init)
	global_value: CoreParam = {
		name = { name | def_id = Some(def_id) },
		typ = typ,
		loc = loc
	}
	global_values: List[CoreParam] = unshadowed_global_values(env, [global_value], contract_init)
	owned_init: CoreExpr = retain_borrowed_values(env, global_values, typ, contract_init)
	rewritten_init: CoreExpr = insert_drops_expr(env, owned_init)

	{
		name = name,
		typ = typ,
		init = rewritten_init,
		is_mutable = is_mutable,
		is_const = is_const,
		is_private = is_private,
		def_id = def_id,
		loc = loc
	}


private pure func rewrite_decl(env: PerceusEnv, decl: CoreDecl) -> CoreDecl:
	match decl:
		FunctionDecl(func_info):
			FunctionDecl(rewrite_function(env, func_info))
		GlobalDecl(global):
			GlobalDecl(rewrite_global(env, global))
		UnionDecl(union_decl):
			decl
		HeapRecordDecl(record_decl):
			decl
		_:
			decl


pure func insert_drops_program(program: CoreProgram) -> CoreProgram:
	resolved_program: CoreProgram = CoreResolve.resolve_global_value_refs(program)
	foreign_includes: List[String] = resolved_program.foreign_includes
	env: PerceusEnv = infer_user_call_contracts(resolved_program, build_env(resolved_program))
	var decls: List[CoreDecl] = []

	for decl in resolved_program.decls:
		decls = decls.append(rewrite_decl(env, decl))

	{
		decls = decls,
		foreign_includes = foreign_includes
	}
