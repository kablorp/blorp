-- Perceus-style explicit reference-count insertion for Core JSON.
--
-- The port owns contract inference, branch and compiled-match balancing,
-- repeated-context protection, mutable reassignment, borrowed return and
-- aggregate retention, consumed-parameter balancing, and recursive final-drop
-- insertion. Production compilation enters Blorp after Core DCE and runs this
-- pass before reuse, closure conversion, resource lowering, and C emission.
import:
	../stage_05_types/compiler_type_name_metadata:
		compiler_is_one_shot_stream_type_name,
		compiler_is_resource_source_type_name,
	compiler_core_closure as CoreClosure
	compiler_core_dce as CoreDce
	compiler_core_json:
		CoreAccessor(ListSpreadAccessor, RootAccessor),
		CoreBinaryOp(EqualOp, NotEqualOp),
		CoreBoxedStorageValue,
		CoreCallKind(
			BuiltinCall,
			ClosureCall,
			DictWithCapacityCall,
			DirectRuntimeCall,
			FallibleStreamTerminalCall,
			ForeignCall,
			IntrinsicCall,
			ListToStringCall,
			OperationResultCall,
			SelectedDirectCall,
			TensorParallelCall,
			UnknownCall,
			UserCall,
		),
		CoreClosureCapture,
		CoreConcurrentBinding,
		CoreConstructorLengthMatch,
		CoreConstructorLengthMatchBranch,
		CoreConstructorLengthMatchCase,
		CoreConstructorLengthMatchGeq,
		CoreConstructorLiteralMatch,
		CoreConstructorMatchBody(
			ConstructorMatchBodyExpr,
			ConstructorMatchBodyLength,
			ConstructorMatchBodyLiteral,
		),
		CoreConstructorMatchCase,
		CoreConstructorMatchFallback(
			ConstructorMatchFallbackBindings,
			ConstructorMatchFallbackBody,
			ConstructorMatchFallbackFail,
		),
		CoreConstructorMatchTest,
		CoreDecl(FunctionDecl, GlobalDecl, HeapRecordDecl, ImplDecl, UnionDecl),
		CoreDictEntry,
		CoreExpr(
			AccessorLiteralMatchExpr,
			AssignExpr,
			BinaryExpr,
			BorrowLetExpr,
			BoxExpr,
			BreakExpr,
			CallExpr,
			CastExpr,
			ClosureCreateExpr,
			ConcurrentExpr,
			ConcurrentlyLoopExpr,
			ConstructorMatchExpr,
			DetachExpr,
			DictConstructExpr,
			DropExpr,
			DupExpr,
			FieldExpr,
			ForChannelExpr,
			ForDictExpr,
			ForListExpr,
			ForRangeExpr,
			ForResourceSourceExpr,
			ForSetExpr,
			ForStreamExpr,
			ForStringExpr,
			ForTensorExpr,
			IfExpr,
			LambdaExpr,
			LetExpr,
			ListConstructExpr,
			ListAllocExpr,
			ListGetExpr,
			ListHandoffExpr,
			ListHandoffSetOwnedExpr,
			ListHandoffSetSourceSlotExpr,
			ListRetainExpr,
			ListSetExpr,
			LiteralExpr,
			LogicalExpr,
			PreClosureConcurrentExpr,
			PreClosureConcurrentlyLoopExpr,
			PreClosureDetachExpr,
			RecordConstructExpr,
			RecordExpr,
			ResourceCleanupExitExpr,
			ResourceScopeExpr,
			SelectExpr,
			SeqExpr,
			StringByteCopyExpr,
			StringByteReadExpr,
			StringByteWriteExpr,
			StringSetLenExpr,
			TailrecListSpreadLoopExpr,
			TailrecListSpreadRecurExpr,
			TailrecLoopExpr,
			TailrecRecurExpr,
			TensorBoxedLiteralExpr,
			TensorRawReadExpr,
			TensorRawViewLetExpr,
			TensorRawWriteExpr,
			TupleExpr,
			TupleFieldExpr,
			UnaryExpr,
			UnboxExpr,
			UnionConstructExpr,
			VarExpr,
			VectorExpr,
			VoidExpr,
			WhileExpr,
			LiteralMatchExpr,
			LengthMatchExpr,
		),
		CoreFunction,
