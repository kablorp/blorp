-- Pure orchestration for early Core stages. Stage state, diagnostics,
-- observations, and stops remain explicit so every pass has one owner.
import:
	collection_pipeline: fuse_collection_program
	early_invariants:
		CoreEarlyInvariantViolation,
		check_debug_invariants,
		check_desugar_invariants,
		check_match_invariants,
		check_mono_invariants,
		check_resolve_invariants,
		check_std_inline_invariants,
		check_synth_invariants,
		core_early_invariant_hint,
		core_early_invariant_message,
	early_stages as CoreEarlyStages
	ir: CoreProgram, core_program_to_json
	match_lowering: compile_program
	mono_specialize: CoreMonoDiagnostic, core_mono_diagnostic_hint, core_mono_diagnostic_message
	monomorphize: monomorphize_program
	parallel_tensor_pipeline: fuse_parallel_tensor_program
	resolve: CoreResolveImportBinding, CoreResolveModuleImports, resolve_core_program
	std_inline: inline_std_wrappers
	string_pipeline: fuse_string_program
	synth: synthesize_program
	synth_error: CoreSynthError, core_synth_error_hint, core_synth_error_message
	tailrec: lower_tailrec_program
	tensor_fusion: fuse_tensor_update_program
	trait_resolve:
		CoreTraitResolveDiagnostic,
		core_trait_resolve_diagnostic_hint,
		core_trait_resolve_diagnostic_message,
		resolve_core_traits,
	tuple_sroa: rewrite_tuple_sroa_program


enum CoreEarlyPipelineStage:
	CoreEarlyLowerStage
	CoreEarlyDebugStage
	CoreEarlyDesugarStage
	CoreEarlyMonoStage
	CoreEarlySynthStage
	CoreEarlyMatchStage
	CoreEarlyTraitResolveStage
	CoreEarlyResolveStage
	CoreEarlyStdInlineStage
	CoreEarlyTailrecStage
	CoreEarlyFusionStage


record CoreEarlyPipelineConfiguration {
	debug: Bool,
	check_invariants: Bool,
	observations: List[CoreEarlyPipelineStage],
	stop_after: Option[CoreEarlyPipelineStage]
}


record CoreEarlyPipelineInput {
	program: CoreProgram,
	next_def_id: Int
}


record CoreEarlyPipelineObservation {
	stage: CoreEarlyPipelineStage,
	rendered: String
}


record CoreEarlyPipelineOutput {
	program: CoreProgram,
	next_def_id: Int,
	observations: List[CoreEarlyPipelineObservation]
}


union CoreEarlyPipelineDiagnostic:
	CoreEarlyInvariantDiagnostic(CoreEarlyInvariantViolation)
	CoreEarlyMonoDiagnostic(CoreMonoDiagnostic)
	CoreEarlySynthDiagnostic(CoreSynthError)
	CoreEarlyTraitResolveDiagnostic(CoreTraitResolveDiagnostic)


pure func core_early_pipeline_diagnostic_message(diagnostic: CoreEarlyPipelineDiagnostic) -> String:
	match diagnostic:
		CoreEarlyInvariantDiagnostic(violation):
			core_early_invariant_message(violation)
		CoreEarlyMonoDiagnostic(mono_diagnostic):
			core_mono_diagnostic_message(mono_diagnostic)
		CoreEarlySynthDiagnostic(synth_error):
			core_synth_error_message(synth_error)
		CoreEarlyTraitResolveDiagnostic(trait_diagnostic):
			core_trait_resolve_diagnostic_message(trait_diagnostic)


pure func core_early_pipeline_diagnostic_hint(
	diagnostic: CoreEarlyPipelineDiagnostic,
) -> Option[String]:
	match diagnostic:
		CoreEarlyInvariantDiagnostic(violation):
			core_early_invariant_hint(violation)
		CoreEarlyMonoDiagnostic(mono_diagnostic):
			core_mono_diagnostic_hint(mono_diagnostic)
		CoreEarlySynthDiagnostic(synth_error):
			core_synth_error_hint(synth_error)
		CoreEarlyTraitResolveDiagnostic(trait_diagnostic):
			Some(core_trait_resolve_diagnostic_hint(trait_diagnostic))


union CoreEarlyPipelineExecution:
	CoreEarlyPipelineCompleted(CoreEarlyPipelineOutput)
	CoreEarlyPipelineStopped(CoreEarlyPipelineStage, String, List[CoreEarlyPipelineObservation])
	CoreEarlyPipelineFailed(CoreEarlyPipelineDiagnostic)


private record CoreEarlyPipelineState {
	program: CoreProgram,
	next_def_id: Int,
	observations: List[CoreEarlyPipelineObservation]
}


private union CoreEarlyStageExecution:
	CoreEarlyStageContinues(CoreEarlyPipelineState)
	CoreEarlyStageStops(CoreEarlyPipelineStage, String, List[CoreEarlyPipelineObservation])
	CoreEarlyStageFails(CoreEarlyInvariantViolation)


pure func core_early_pipeline_stage_name(stage: CoreEarlyPipelineStage) -> String:
	match stage:
		CoreEarlyLowerStage:
			"lower"
		CoreEarlyDebugStage:
			"debug"
		CoreEarlyDesugarStage:
			"desugar"
		CoreEarlyMonoStage:
			"mono"
		CoreEarlySynthStage:
			"synth"
		CoreEarlyMatchStage:
			"match"
		CoreEarlyTraitResolveStage:
			"trait_resolve"
		CoreEarlyResolveStage:
			"resolve"
		CoreEarlyStdInlineStage:
			"std_inline"
		CoreEarlyTailrecStage:
			"tailrec"
		CoreEarlyFusionStage:
			"fusion"


pure func parse_core_early_pipeline_stage(name: String) -> Option[CoreEarlyPipelineStage]:
	match name:
		"lower":
			Some(CoreEarlyLowerStage)
		"debug":
			Some(CoreEarlyDebugStage)
		"desugar":
			Some(CoreEarlyDesugarStage)
		"mono":
			Some(CoreEarlyMonoStage)
		"synth":
			Some(CoreEarlySynthStage)
		"match":
			Some(CoreEarlyMatchStage)
		"trait_resolve":
			Some(CoreEarlyTraitResolveStage)
		"resolve":
			Some(CoreEarlyResolveStage)
		"std_inline":
			Some(CoreEarlyStdInlineStage)
		"tailrec":
			Some(CoreEarlyTailrecStage)
		"fusion":
			Some(CoreEarlyFusionStage)
		_:
			None


pure func core_early_pipeline_stages_equal(
	left: CoreEarlyPipelineStage,
	right: CoreEarlyPipelineStage,
) -> Bool:
	match left:
		CoreEarlyLowerStage:
			match right:
				CoreEarlyLowerStage:
					True
				_:
					False
		CoreEarlyDebugStage:
			match right:
				CoreEarlyDebugStage:
					True
				_:
					False
		CoreEarlyDesugarStage:
			match right:
				CoreEarlyDesugarStage:
					True
				_:
					False
		CoreEarlyMonoStage:
			match right:
				CoreEarlyMonoStage:
					True
				_:
					False
		CoreEarlySynthStage:
			match right:
				CoreEarlySynthStage:
					True
				_:
					False
		CoreEarlyMatchStage:
			match right:
				CoreEarlyMatchStage:
					True
				_:
					False
		CoreEarlyTraitResolveStage:
			match right:
				CoreEarlyTraitResolveStage:
					True
				_:
					False
		CoreEarlyResolveStage:
			match right:
				CoreEarlyResolveStage:
					True
				_:
					False
		CoreEarlyStdInlineStage:
			match right:
				CoreEarlyStdInlineStage:
					True
				_:
					False
		CoreEarlyTailrecStage:
			match right:
				CoreEarlyTailrecStage:
					True
				_:
					False
		CoreEarlyFusionStage:
			match right:
				CoreEarlyFusionStage:
					True
				_:
					False


private pure func stops_after_stage(
	stop_after: Option[CoreEarlyPipelineStage],
	stage: CoreEarlyPipelineStage,
) -> Bool:
	match stop_after:
		Some(target):
			core_early_pipeline_stages_equal(target, stage)
		None:
			False


private pure func stage_invariant_violations(
	stage: CoreEarlyPipelineStage,
	program: CoreProgram,
) -> List[CoreEarlyInvariantViolation]:
	match stage:
		CoreEarlyLowerStage:
			[]
		CoreEarlyDebugStage:
			check_debug_invariants(program)
		CoreEarlyDesugarStage:
			check_desugar_invariants(program)
		CoreEarlyMonoStage:
			check_mono_invariants(program)
		CoreEarlySynthStage:
			check_synth_invariants(program)
		CoreEarlyMatchStage:
			check_match_invariants(program)
		CoreEarlyTraitResolveStage:
			check_match_invariants(program)
		CoreEarlyResolveStage:
			check_resolve_invariants(program)
		CoreEarlyStdInlineStage:
			check_resolve_invariants(program).concat(check_std_inline_invariants(program))
		CoreEarlyTailrecStage:
			check_resolve_invariants(program).concat(check_std_inline_invariants(program))
		CoreEarlyFusionStage:
			check_resolve_invariants(program).concat(check_std_inline_invariants(program))


private pure func finish_stage(
	stage: CoreEarlyPipelineStage,
	state: CoreEarlyPipelineState,
	configuration: CoreEarlyPipelineConfiguration,
) -> CoreEarlyStageExecution:
	violations: List[CoreEarlyInvariantViolation] = if configuration.check_invariants:
		stage_invariant_violations(stage, state.program)
	else:
		match stage:
			CoreEarlyResolveStage:
				check_resolve_invariants(state.program)
			CoreEarlyStdInlineStage:
				check_resolve_invariants(
					state.program,
				).concat(check_std_inline_invariants(state.program))
			CoreEarlyTailrecStage:
				check_resolve_invariants(
					state.program,
				).concat(check_std_inline_invariants(state.program))
			CoreEarlyFusionStage:
				check_resolve_invariants(
					state.program,
				).concat(check_std_inline_invariants(state.program))
			_:
				[]

	match violations.get(0):
		Some(violation):
			CoreEarlyStageFails(violation)
		None:
			observed: Bool = configuration.observations.any(
				pure func(observation): core_early_pipeline_stages_equal(observation, stage),
			)
			stopped: Bool = stops_after_stage(configuration.stop_after, stage)

			if observed or stopped:
				rendered: String = core_program_to_json(state.program).to_string()

				updated_observations: List[CoreEarlyPipelineObservation] = if observed:
					state.observations.append({
						stage = stage,
						rendered = rendered,
					})
				else:
					state.observations

				if stopped:
					CoreEarlyStageStops(stage, rendered, updated_observations)
				else:
					CoreEarlyStageContinues({ state | observations = updated_observations })
			else:
				CoreEarlyStageContinues(state)


private pure func run_mono_stage(
	state: CoreEarlyPipelineState,
	configuration: CoreEarlyPipelineConfiguration,
) -> CoreEarlyPipelineExecution:
	match monomorphize_program(state.program, state.next_def_id):
		Err(diagnostic):
			CoreEarlyPipelineFailed(CoreEarlyMonoDiagnostic(diagnostic))
		Ok(specialized):
			mono_state: CoreEarlyPipelineState = {
				program = CoreEarlyStages.run_list_layout_stage(specialized.program),
				next_def_id = specialized.next_def_id,
				observations = state.observations
			}

			match finish_stage(CoreEarlyMonoStage, mono_state, configuration):
				CoreEarlyStageContinues(completed):
					match synthesize_program(completed.program):
						Err(error):
							CoreEarlyPipelineFailed(CoreEarlySynthDiagnostic(error))
						Ok(synthesized):
							match finish_stage(
								CoreEarlySynthStage,
								{ completed | program = synthesized },
								configuration,
							):
								CoreEarlyStageContinues(finished):
									run_match_stage(finished, configuration)
								CoreEarlyStageStops(stage, rendered, observations):
									CoreEarlyPipelineStopped(stage, rendered, observations)
								CoreEarlyStageFails(violation):
									CoreEarlyPipelineFailed(CoreEarlyInvariantDiagnostic(violation))
				CoreEarlyStageStops(stage, rendered, observations):
					CoreEarlyPipelineStopped(stage, rendered, observations)
				CoreEarlyStageFails(violation):
					CoreEarlyPipelineFailed(CoreEarlyInvariantDiagnostic(violation))


private pure func run_match_stage(
	state: CoreEarlyPipelineState,
	configuration: CoreEarlyPipelineConfiguration,
) -> CoreEarlyPipelineExecution:
	match finish_stage(
		CoreEarlyMatchStage,
		{ state | program = compile_program(state.program) },
		configuration,
	):
		CoreEarlyStageContinues(finished):
			run_trait_resolve_stage(finished, configuration)
		CoreEarlyStageStops(stage, rendered, observations):
			CoreEarlyPipelineStopped(stage, rendered, observations)
		CoreEarlyStageFails(violation):
			CoreEarlyPipelineFailed(CoreEarlyInvariantDiagnostic(violation))


private pure func run_trait_resolve_stage(
	state: CoreEarlyPipelineState,
	configuration: CoreEarlyPipelineConfiguration,
) -> CoreEarlyPipelineExecution:
	match resolve_core_traits(state.program):
		Err(diagnostic):
			CoreEarlyPipelineFailed(CoreEarlyTraitResolveDiagnostic(diagnostic))
		Ok(resolved):
			match finish_stage(
				CoreEarlyTraitResolveStage,
				{ state | program = resolved },
				configuration,
			):
				CoreEarlyStageContinues(finished):
					CoreEarlyPipelineCompleted({
						program = finished.program,
						next_def_id = finished.next_def_id,
						observations = finished.observations,
					})
				CoreEarlyStageStops(stage, rendered, observations):
					CoreEarlyPipelineStopped(stage, rendered, observations)
				CoreEarlyStageFails(violation):
					CoreEarlyPipelineFailed(CoreEarlyInvariantDiagnostic(violation))


private pure func run_desugar_stage(
	state: CoreEarlyPipelineState,
	configuration: CoreEarlyPipelineConfiguration,
) -> CoreEarlyPipelineExecution:
	desugar: CoreEarlyStageExecution = finish_stage(
		CoreEarlyDesugarStage,
		{ state | program = CoreEarlyStages.run_desugar_stage(state.program) },
		configuration,
	)

	match desugar:
		CoreEarlyStageContinues(next_state):
			run_mono_stage(next_state, configuration)
		CoreEarlyStageStops(stage, rendered, observations):
			CoreEarlyPipelineStopped(stage, rendered, observations)
		CoreEarlyStageFails(violation):
			CoreEarlyPipelineFailed(CoreEarlyInvariantDiagnostic(violation))


private pure func run_debug_stage(
	state: CoreEarlyPipelineState,
	configuration: CoreEarlyPipelineConfiguration,
) -> CoreEarlyPipelineExecution:
	debug_execution: CoreEarlyStageExecution = finish_stage(
		CoreEarlyDebugStage,
		{ state | program = CoreEarlyStages.run_debug_stage(state.program, configuration.debug) },
		configuration,
	)

	match debug_execution:
		CoreEarlyStageContinues(next_state):
			run_desugar_stage(next_state, configuration)
		CoreEarlyStageStops(stage, rendered, observations):
			CoreEarlyPipelineStopped(stage, rendered, observations)
		CoreEarlyStageFails(violation):
			CoreEarlyPipelineFailed(CoreEarlyInvariantDiagnostic(violation))


pure func run_early_core_pipeline(
	input: CoreEarlyPipelineInput,
	configuration: CoreEarlyPipelineConfiguration,
) -> CoreEarlyPipelineExecution:
	lower: CoreEarlyStageExecution = finish_stage(
		CoreEarlyLowerStage,
		{
			program = input.program,
			next_def_id = input.next_def_id,
			observations = []
		},
		configuration,
	)

	match lower:
		CoreEarlyStageContinues(state):
			run_debug_stage(state, configuration)
		CoreEarlyStageStops(stage, rendered, observations):
			CoreEarlyPipelineStopped(stage, rendered, observations)
		CoreEarlyStageFails(violation):
			CoreEarlyPipelineFailed(CoreEarlyInvariantDiagnostic(violation))


-- Generic templates are projected out between tensor fusion and tuple SROA.
-- Keeping this continuation explicit prevents the user-visible Fusion snapshot
-- from observing a different declaration set than later Core stages receive.
pure func finish_early_core_pipeline_after_projection(
	output: CoreEarlyPipelineOutput,
	configuration: CoreEarlyPipelineConfiguration,
) -> CoreEarlyPipelineExecution:
	state: CoreEarlyPipelineState = {
		program = rewrite_tuple_sroa_program(output.program),
		next_def_id = output.next_def_id,
		observations = output.observations
	}

	match finish_stage(CoreEarlyFusionStage, state, configuration):
		CoreEarlyStageContinues(completed):
			CoreEarlyPipelineCompleted({
				program = completed.program,
				next_def_id = completed.next_def_id,
				observations = completed.observations,
			})
		CoreEarlyStageStops(stage, rendered, observations):
			CoreEarlyPipelineStopped(stage, rendered, observations)
		CoreEarlyStageFails(violation):
			CoreEarlyPipelineFailed(CoreEarlyInvariantDiagnostic(violation))


pure func run_early_core_pipeline_to_runtime_projection(
	input: CoreEarlyPipelineInput,
	configuration: CoreEarlyPipelineConfiguration,
	import_bindings: List[CoreResolveImportBinding],
	module_imports: List[CoreResolveModuleImports],
) -> CoreEarlyPipelineExecution:
	match run_early_core_pipeline(input, configuration):
		CoreEarlyPipelineCompleted(output):
			state: CoreEarlyPipelineState = {
				program = resolve_core_program(output.program, import_bindings, module_imports),
				next_def_id = output.next_def_id,
				observations = output.observations
			}

			match finish_stage(CoreEarlyResolveStage, state, configuration):
				CoreEarlyStageContinues(finished):
					match finish_stage(
						CoreEarlyStdInlineStage,
						{ finished | program = inline_std_wrappers(finished.program) },
						configuration,
					):
						CoreEarlyStageContinues(inlined):
							match finish_stage(
								CoreEarlyTailrecStage,
								{ inlined | program = lower_tailrec_program(inlined.program) },
								configuration,
							):
								CoreEarlyStageContinues(completed):
									CoreEarlyPipelineCompleted({
										program = completed.program
											.fuse_string_program()
											.fuse_collection_program()
											.fuse_parallel_tensor_program()
											.fuse_tensor_update_program(),
										next_def_id = completed.next_def_id,
										observations = completed.observations,
									})
								CoreEarlyStageStops(stage, rendered, observations):
									CoreEarlyPipelineStopped(stage, rendered, observations)
								CoreEarlyStageFails(violation):
									CoreEarlyPipelineFailed(CoreEarlyInvariantDiagnostic(violation))
						CoreEarlyStageStops(stage, rendered, observations):
							CoreEarlyPipelineStopped(stage, rendered, observations)
						CoreEarlyStageFails(violation):
							CoreEarlyPipelineFailed(CoreEarlyInvariantDiagnostic(violation))
				CoreEarlyStageStops(stage, rendered, observations):
					CoreEarlyPipelineStopped(stage, rendered, observations)
				CoreEarlyStageFails(violation):
					CoreEarlyPipelineFailed(CoreEarlyInvariantDiagnostic(violation))
		CoreEarlyPipelineStopped(stage, rendered, observations):
			CoreEarlyPipelineStopped(stage, rendered, observations)
		CoreEarlyPipelineFailed(diagnostic):
			CoreEarlyPipelineFailed(diagnostic)
