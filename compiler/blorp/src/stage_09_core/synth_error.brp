-- Errors produced while synthesizing post-monomorphization Core bodies.
--
-- Family modules share this phase-level contract so callers do not need to
-- know which module owns a particular synthesized builtin.
import:
	ir: CoreSourceLoc, CoreType


union CoreSynthError:
	UnsupportedTensorReductionElement(String, CoreType, CoreSourceLoc)
	HashCollectionLayoutUnavailable(String, CoreType, CoreSourceLoc)
	HashCollectionInvalidValueType(String, CoreType, CoreSourceLoc)


pure func core_synth_error_message(error: CoreSynthError) -> String:
	match error:
		UnsupportedTensorReductionElement(operation, _, _):
			"Cannot synthesize tensor reduction '${operation}' for this element type"
		HashCollectionLayoutUnavailable(operation, _, _):
			"Cannot synthesize hash collection operation '${operation}' without a concrete layout"
		HashCollectionInvalidValueType(operation, _, _):
			"Cannot synthesize hash collection operation '${operation}' for this value type"


pure func core_synth_error_hint(error: CoreSynthError) -> Option[String]:
	match error:
		UnsupportedTensorReductionElement(_, _, _):
			Some("supported tensor reduction element types are Int, Float, Float32, and Float16")
		HashCollectionLayoutUnavailable(_, _, _):
			Some((
					"post-monomorphization synthesis requires every concrete named type to have a "
					+ "declaration-derived layout"
				))
		HashCollectionInvalidValueType(_, _, _):
			Some("use a concrete value type supported by the hash collection runtime layout")
