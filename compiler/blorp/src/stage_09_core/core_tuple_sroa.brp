				next_fresh = cases_result.next_fresh
			}
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			scrutinee_result: TupleSroaRewrite = rewrite_tuple_sroa_expr_from(
				context,
				scrutinee,
				next_fresh,
			)
			tree_result: TupleSroaTreeRewrite = rewrite_tuple_sroa_semantic_tree(
				context,
				tree,
				scrutinee_result.next_fresh,
			)
			{
				expr = SemanticMatchExpr(scrutinee_result.expr, tree_result.tree, typ, loc),
				next_fresh = tree_result.next_fresh
			}
		IfExpr(cond, then_expr, else_expr, typ, loc):
			cond_result: TupleSroaRewrite = rewrite_tuple_sroa_expr_from(context, cond, next_fresh)
			then_result: TupleSroaRewrite = rewrite_tuple_sroa_expr_from(
				context,
				then_expr,
				cond_result.next_fresh,
			)
			else_result: TupleSroaRewrite = rewrite_tuple_sroa_expr_from(
				context,
				else_expr,
				then_result.next_fresh,
			)
			{
				expr = IfExpr(cond_result.expr, then_result.expr, else_result.expr, typ, loc),
				next_fresh = else_result.next_fresh
			}
		_:
			{
				expr = expr,
				next_fresh = next_fresh
			}

	scalar_replace_tuple_node(context, children.expr, children.next_fresh)


private record TupleSroaFunctionRewrite {
	function_info: CoreFunction,
	next_fresh: Int
}


private pure func rewrite_tuple_sroa_function(
	context: TupleSroaContext,
	function_info: CoreFunction,
	next_fresh: Int,
) -> TupleSroaFunctionRewrite:
	if not function_info.type_params.is_empty():
		{
			function_info = function_info,
			next_fresh = next_fresh
		}
	else:
		match function_info.body:
			Some(body):
				result: TupleSroaRewrite = rewrite_tuple_sroa_expr_from(context, body, next_fresh)
				{
					function_info = { function_info | body = Some(result.expr) },
					next_fresh = result.next_fresh
				}
			None:
				{
					function_info = function_info,
					next_fresh = next_fresh
				}


pure func rewrite_tuple_sroa_expr(expr: CoreExpr) -> CoreExpr:
	empty_program: CoreProgram = {
		decls = [],
		foreign_includes = []
	}
	context: TupleSroaContext = {
		layout_types = build_layout_type_index(empty_program),
		summaries = {}
	}
	rewrite_tuple_sroa_expr_from(context, expr, 0).expr


pure func rewrite_tuple_sroa_program(program: CoreProgram) -> CoreProgram:
	layout_types: CoreLayoutTypeIndex = build_layout_type_index(program)
	context: TupleSroaContext = {
		layout_types = layout_types,
		summaries = build_tuple_return_summaries(layout_types, program)
	}
	var decls: List[CoreDecl] = []
	var next_fresh: Int = 0

	for decl in program.decls:
		match decl:
			FunctionDecl(function_info):
				result: TupleSroaFunctionRewrite = rewrite_tuple_sroa_function(
					context,
					function_info,
					next_fresh,
				)
				decls = decls.append(FunctionDecl(result.function_info))
				next_fresh = result.next_fresh
			GlobalDecl(global):
				result: TupleSroaRewrite = rewrite_tuple_sroa_expr_from(
					context,
					global.init,
					next_fresh,
				)
				decls = decls.append(GlobalDecl({ global | init = result.expr }))
				next_fresh = result.next_fresh
			ImplDecl(implementation):
				if implementation.type_params.is_empty():
					var methods: List[CoreFunction] = []

					for method in implementation.methods:
						result: TupleSroaFunctionRewrite = rewrite_tuple_sroa_function(
							context,
							method,
							next_fresh,
						)
						methods = methods.append(result.function_info)
						next_fresh = result.next_fresh

					decls = decls.append(ImplDecl({ implementation | methods = methods }))
				else:
					decls = decls.append(decl)
			_:
				decls = decls.append(decl)

	{
		decls = decls,
		foreign_includes = program.foreign_includes
	}
