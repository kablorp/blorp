-- Strict JSON codecs for raw C emission and the complete build artifact.
import:
	compiler_build_artifact:
		BuildArtifact,
		BuildCompatibility,
		BuildLinkArgument,
		BuildNativeFeature(BuildRaylib, BuildTls),
		BuildOptimization(BuildFast, BuildRelease),
		BuildPlatform(BuildLinux, BuildMacos),
		BuildRuntimeRequirement(BuildEmbeddedRuntime, BuildExternalRuntime),
		BuildSanitizer(BuildAddressUndefinedSanitizer, BuildNoSanitizer, BuildUndefinedSanitizer),
		BuildSourceIdentity,
		CArtifact,
	json:
		JsonValue(JsonBool, JsonNull, JsonNumber, JsonObject, JsonString, JsonVector),
		as_array,
		as_bool,
		as_number,
		as_string,
		get_field,


private C_CODE_FIELD: String = "c_code"

private LINK_FLAGS_FIELD: String = "link_flags"

private INCLUDE_DIRS_FIELD: String = "include_dirs"


private pure func strings_to_json(items: List[String]) -> JsonValue:
	JsonVector(items.map(
		func(item: String): JsonString(item),
	))


pure func c_artifact_to_json(artifact: CArtifact) -> JsonValue:
	JsonObject([
		(C_CODE_FIELD, JsonString(artifact.c_code)),
		(LINK_FLAGS_FIELD, strings_to_json(artifact.link_flags)),
		(INCLUDE_DIRS_FIELD, strings_to_json(artifact.include_dirs)),
	])


BUILD_ARTIFACT_SCHEMA_VERSION: Int = 1

private BUILD_ARTIFACT_KIND: String = "build_artifact"


union BuildArtifactJsonError:
	BuildArtifactMissingField(String)
	BuildArtifactExpectedField(String, String)
	BuildArtifactUnsupportedSchema(Int)
	BuildArtifactUnsupportedKind(String)
	BuildArtifactUnsupportedPlatform(String)
	BuildArtifactUnsupportedRuntimeRequirement(String)
	BuildArtifactUnsupportedNativeFeature(String)
	BuildArtifactUnsupportedOptimization(String)
	BuildArtifactUnsupportedSanitizer(String)


private pure func platform_name(platform: BuildPlatform) -> String:
	match platform:
		BuildLinux:
			"linux"
		BuildMacos:
			"macos"


private pure func platform_json(platform: Option[BuildPlatform]) -> JsonValue:
	match platform:
		Some(value):
			JsonString(platform_name(value))
		None:
			JsonNull


private pure func link_argument_json(argument: BuildLinkArgument) -> JsonValue:
	JsonObject([
		("platform", platform_json(argument.platform)),
		("value", JsonString(argument.value)),
	])


private pure func runtime_requirement_name(requirement: BuildRuntimeRequirement) -> String:
	match requirement:
		BuildEmbeddedRuntime:
			"embedded"
		BuildExternalRuntime:
			"external"


private pure func native_feature_name(feature: BuildNativeFeature) -> String:
	match feature:
		BuildRaylib:
			"raylib"
		BuildTls:
			"tls"


private pure func optimization_name(optimization: BuildOptimization) -> String:
	match optimization:
		BuildFast:
			"fast"
		BuildRelease:
			"release"


private pure func sanitizer_name(sanitizer: BuildSanitizer) -> String:
	match sanitizer:
		BuildNoSanitizer:
			"off"
		BuildAddressUndefinedSanitizer:
			"address_undefined"
		BuildUndefinedSanitizer:
			"undefined"


private pure func source_json(source: BuildSourceIdentity) -> JsonValue:
	JsonObject([
		("path", JsonString(source.path)),
		("module_name", JsonString(source.module_name)),
	])


private pure func compatibility_json(compatibility: BuildCompatibility) -> JsonValue:
	JsonObject([
		("debug", JsonBool(compatibility.debug)),
		("profile", JsonBool(compatibility.profile)),
		("optimization", JsonString(optimization_name(compatibility.optimization))),
		("sanitizer", JsonString(sanitizer_name(compatibility.sanitizer))),
		("leak_check", JsonBool(compatibility.leak_check)),
	])


pure func build_artifact_to_json(artifact: BuildArtifact) -> JsonValue:
	JsonObject([
		("schema", JsonNumber(to_float(BUILD_ARTIFACT_SCHEMA_VERSION))),
		("kind", JsonString(BUILD_ARTIFACT_KIND)),
		("c_code", JsonString(artifact.c_code)),
		("link_arguments", JsonVector(artifact.link_arguments.map(link_argument_json))),
		("include_dirs", strings_to_json(artifact.include_dirs)),
		("runtime_requirement", JsonString(runtime_requirement_name(artifact.runtime_requirement))),
		("native_features", JsonVector(artifact.native_features.map(
				func(feature): JsonString(native_feature_name(feature)),
			))),
		("source", source_json(artifact.source)),
		("compatibility", compatibility_json(artifact.compatibility)),
	])


private pure func required_field(
	value: JsonValue,
	name: String,
) -> Result[JsonValue, BuildArtifactJsonError]:
	get_field(value, name).to_result(BuildArtifactMissingField(name))


private pure func string_field(
	value: JsonValue,
	name: String,
) -> Result[String, BuildArtifactJsonError]:
	field ?= required_field(value, name)
	as_string(field).to_result(BuildArtifactExpectedField(name, "a string"))


private pure func bool_field(
	value: JsonValue,
	name: String,
) -> Result[Bool, BuildArtifactJsonError]:
	field ?= required_field(value, name)
	as_bool(field).to_result(BuildArtifactExpectedField(name, "a boolean"))


private pure func array_field(
	value: JsonValue,
	name: String,
) -> Result[List[JsonValue], BuildArtifactJsonError]:
	field ?= required_field(value, name)
	as_array(field).to_result(BuildArtifactExpectedField(name, "an array"))


private pure func int_field(value: JsonValue, name: String) -> Result[Int, BuildArtifactJsonError]:
	field ?= required_field(value, name)
	number ?= as_number(field).to_result(BuildArtifactExpectedField(name, "a number"))
	integer: Int = to_int(number)

	if to_float(integer) == number:
		Ok(integer)
	else:
		Err(BuildArtifactExpectedField(name, "an integer"))


private pure func decode_string_list(
	value: JsonValue,
	name: String,
) -> Result[List[String], BuildArtifactJsonError]:
	items ?= array_field(value, name)
	decode_string_items(items, name, [])


private pure func decode_string_items(
	items: List[JsonValue],
	field_name: String,
	result: List[String],
) -> Result[List[String], BuildArtifactJsonError]:
	match items:
		[]:
			Ok(result)
		[item, ...remaining]:
			text ?= as_string(
				item,
			).to_result(BuildArtifactExpectedField(field_name, "an array of strings"))
			decode_string_items(
				remaining,
				field_name,
				result.append(text),
			)


private pure func decode_platform(
	value: JsonValue,
) -> Result[Option[BuildPlatform], BuildArtifactJsonError]:
	match value:
		JsonNull:
			Ok(None)
		JsonString(name):
			match name:
				"linux":
					Ok(Some(BuildLinux))
				"macos":
					Ok(Some(BuildMacos))
				_:
					Err(BuildArtifactUnsupportedPlatform(name))
		_:
			Err(BuildArtifactExpectedField("link_arguments.platform", "null or a platform string"))


private pure func decode_link_argument(
	value: JsonValue,
) -> Result[BuildLinkArgument, BuildArtifactJsonError]:
	platform_value ?= required_field(value, "platform")
	platform ?= decode_platform(platform_value)
	argument ?= string_field(value, "value")
	Ok({
		platform = platform,
		value = argument,
	})


private pure func decode_link_arguments(
	value: JsonValue,
) -> Result[List[BuildLinkArgument], BuildArtifactJsonError]:
	items ?= array_field(value, "link_arguments")
	decode_link_argument_items(items, [])


private pure func decode_link_argument_items(
	items: List[JsonValue],
	result: List[BuildLinkArgument],
) -> Result[List[BuildLinkArgument], BuildArtifactJsonError]:
	match items:
		[]:
			Ok(result)
		[item, ...remaining]:
			argument ?= decode_link_argument(item)
			decode_link_argument_items(
				remaining,
				result.append(argument),
			)


private pure func decode_runtime_requirement(
	name: String,
) -> Result[BuildRuntimeRequirement, BuildArtifactJsonError]:
	match name:
		"embedded":
			Ok(BuildEmbeddedRuntime)
		"external":
			Ok(BuildExternalRuntime)
		_:
			Err(BuildArtifactUnsupportedRuntimeRequirement(name))


private pure func decode_native_feature(
	name: String,
) -> Result[BuildNativeFeature, BuildArtifactJsonError]:
	match name:
		"raylib":
			Ok(BuildRaylib)
		"tls":
			Ok(BuildTls)
		_:
			Err(BuildArtifactUnsupportedNativeFeature(name))


private pure func decode_native_features(
	value: JsonValue,
) -> Result[List[BuildNativeFeature], BuildArtifactJsonError]:
	names ?= decode_string_list(value, "native_features")
	decode_native_feature_names(names, [])


private pure func decode_native_feature_names(
	names: List[String],
	result: List[BuildNativeFeature],
) -> Result[List[BuildNativeFeature], BuildArtifactJsonError]:
	match names:
		[]:
			Ok(result)
		[name, ...remaining]:
			feature ?= decode_native_feature(name)
			decode_native_feature_names(
				remaining,
				result.append(feature),
			)


private pure func decode_source(
	value: JsonValue,
) -> Result[BuildSourceIdentity, BuildArtifactJsonError]:
	source ?= required_field(value, "source")
	path ?= string_field(source, "path")
	module_name ?= string_field(source, "module_name")
	Ok({
		path = path,
		module_name = module_name,
	})


private pure func decode_optimization(
	name: String,
) -> Result[BuildOptimization, BuildArtifactJsonError]:
	match name:
		"fast":
			Ok(BuildFast)
		"release":
			Ok(BuildRelease)
		_:
			Err(BuildArtifactUnsupportedOptimization(name))


private pure func decode_sanitizer(name: String) -> Result[BuildSanitizer, BuildArtifactJsonError]:
	match name:
		"off":
			Ok(BuildNoSanitizer)
		"address_undefined":
			Ok(BuildAddressUndefinedSanitizer)
		"undefined":
			Ok(BuildUndefinedSanitizer)
		_:
			Err(BuildArtifactUnsupportedSanitizer(name))


private pure func decode_compatibility(
	value: JsonValue,
) -> Result[BuildCompatibility, BuildArtifactJsonError]:
	compatibility ?= required_field(value, "compatibility")
	debug_enabled ?= bool_field(compatibility, "debug")
	profile_enabled ?= bool_field(compatibility, "profile")
	optimization_name_value ?= string_field(compatibility, "optimization")
	optimization ?= decode_optimization(optimization_name_value)
	sanitizer_name_value ?= string_field(compatibility, "sanitizer")
	sanitizer ?= decode_sanitizer(sanitizer_name_value)
	leak_check ?= bool_field(compatibility, "leak_check")

	Ok({
		debug = debug_enabled,
		profile = profile_enabled,
		optimization = optimization,
		sanitizer = sanitizer,
		leak_check = leak_check,
	})


pure func decode_build_artifact_json(
	value: JsonValue,
) -> Result[BuildArtifact, BuildArtifactJsonError]:
	schema ?= int_field(value, "schema")

	if schema != BUILD_ARTIFACT_SCHEMA_VERSION:
		Err(BuildArtifactUnsupportedSchema(schema))
	else:
		kind ?= string_field(value, "kind")

		if kind != BUILD_ARTIFACT_KIND:
			Err(BuildArtifactUnsupportedKind(kind))
		else:
			c_code ?= string_field(value, "c_code")
			link_arguments ?= decode_link_arguments(value)
			include_dirs ?= decode_string_list(value, "include_dirs")
			runtime_name ?= string_field(value, "runtime_requirement")
			runtime_requirement ?= decode_runtime_requirement(runtime_name)
			native_features ?= decode_native_features(value)
			source ?= decode_source(value)
			compatibility ?= decode_compatibility(value)

			Ok({
				c_code = c_code,
				link_arguments = link_arguments,
				include_dirs = include_dirs,
				runtime_requirement = runtime_requirement,
				native_features = native_features,
				source = source,
				compatibility = compatibility,
			})
