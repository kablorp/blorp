-- Blorp-authored library for the first self-hosted code-emission slice.
--
-- This module owns intrinsic C expression templates at the snippet/template
-- boundary. Core traversal and subexpression emission remain in the main
-- backend emitter.
import:
	codegen_template_registry: render_template_arity_error, render_unsupported_template_error


