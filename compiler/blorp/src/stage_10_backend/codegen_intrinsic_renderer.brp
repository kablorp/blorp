	TensorGetI64RawUnchecked
	TensorGetF64
	TensorGetF32
	TensorGetF16
	TensorGetI64


enum ThreeArgIntrinsic:
	MathFma
	StringSetByte
	StringFindByteFrom
	BytesSet
	SetSetBucket
	SetEq
	DictSetKeyAt
	DictSetValueAt
	DictMetaSet
	DictOrderSet
	DictOrderIndexSet
	DictEq
	SliceAlloc
	TensorSetF64
	TensorSetF32
	TensorSetF16
	TensorSetI64
	FixedAlloc


union Intrinsic:
	NoArgs(NoArgIntrinsic)
	OneArg(OneArgIntrinsic)
	TwoArgs(TwoArgIntrinsic)
	ThreeArgs(ThreeArgIntrinsic)


record IntrinsicSpec {
	name: String,
	intrinsic: Intrinsic
}


union RenderError:
	WrongArity(Intrinsic, Int, Int)
	UnsupportedIntrinsic(String)


pure func intrinsic_arity(intrinsic: Intrinsic) -> Int:
	match intrinsic:
		NoArgs(no_arg):
			0
		OneArg(one_arg):
			1
		TwoArgs(two_args):
			2
		ThreeArgs(three_args):
			3


private pure func intrinsic_spec(name: String, intrinsic: Intrinsic) -> IntrinsicSpec:
	{
		name = name,
		intrinsic = intrinsic
	}


private pure func specs_to_intrinsic_dict(specs: List[IntrinsicSpec]) -> Dict[String, Intrinsic]:
	var dict: Dict[String, Intrinsic] = {}

	for spec in specs:
		dict = dict.set(spec.name, spec.intrinsic)

	dict


private pure func specs_to_no_arg_name_dict(
	specs: List[IntrinsicSpec],
) -> Dict[NoArgIntrinsic, String]:
	var dict: Dict[NoArgIntrinsic, String] = {}

	for spec in specs:
		match spec.intrinsic:
			NoArgs(intrinsic):
				dict = dict.set(intrinsic, spec.name)
			OneArg(intrinsic):
				void
			TwoArgs(intrinsic):
				void
			ThreeArgs(intrinsic):
				void

	dict


private pure func specs_to_one_arg_name_dict(
	specs: List[IntrinsicSpec],
) -> Dict[OneArgIntrinsic, String]:
	var dict: Dict[OneArgIntrinsic, String] = {}

	for spec in specs:
		match spec.intrinsic:
			NoArgs(intrinsic):
				void
			OneArg(intrinsic):
				dict = dict.set(intrinsic, spec.name)
			TwoArgs(intrinsic):
				void
			ThreeArgs(intrinsic):
				void

	dict


private pure func specs_to_two_arg_name_dict(
	specs: List[IntrinsicSpec],
) -> Dict[TwoArgIntrinsic, String]:
	var dict: Dict[TwoArgIntrinsic, String] = {}

	for spec in specs:
		match spec.intrinsic:
			NoArgs(intrinsic):
				void
			OneArg(intrinsic):
				void
			TwoArgs(intrinsic):
				dict = dict.set(intrinsic, spec.name)
			ThreeArgs(intrinsic):
				void

	dict


private pure func specs_to_three_arg_name_dict(
	specs: List[IntrinsicSpec],
) -> Dict[ThreeArgIntrinsic, String]:
	var dict: Dict[ThreeArgIntrinsic, String] = {}

	for spec in specs:
		match spec.intrinsic:
			NoArgs(intrinsic):
				void
			OneArg(intrinsic):
				void
			TwoArgs(intrinsic):
				void
			ThreeArgs(intrinsic):
				dict = dict.set(intrinsic, spec.name)

	dict


