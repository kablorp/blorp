private pure func emit_vector_get_stack_option_payload(
	tensor: String,
	index: String,
	result_type: CoreType,
	payload_type: CoreType,
) -> Option[String]:
	match payload_type:
		ValueRecordType(name):
			args: StackOptionVectorValueRecordGetArgs = {
				tensor = tensor,
				index = index,
				temp_seed = TENSOR_STACK_OPTION_GET_TEMP_SEED,
				option_c_type = c_type_name(result_type),
				payload_c_type = c_type_name(payload_type),
				none_value = stack_option_none_value_for_type(result_type)
			}
			Some(render_prepared_tensor_op(StackOptionVectorValueRecordGet(args)))
		RangeType:
			args: StackOptionVectorScalarGetArgs = stack_option_vector_scalar_get_args(
				tensor,
				index,
				result_type,
			)
			Some(render_prepared_tensor_op(StackOptionVectorLongGet(args)))
		EnumType(name):
			args: StackOptionVectorScalarGetArgs = stack_option_vector_scalar_get_args(
				tensor,
				index,
				result_type,
			)
			Some(render_prepared_tensor_op(StackOptionVectorLongGet(args)))
		NamedType(name, type_args):
			if type_args.length() == 0 and name == "Int128":
				args: StackOptionVectorScalarGetArgs = stack_option_vector_scalar_get_args(
					tensor,
					index,
					result_type,
				)
				Some(render_prepared_tensor_op(StackOptionVectorInt128Get(args)))
			else if type_args.length() == 0 and name == "UInt128":
				args: StackOptionVectorScalarGetArgs = stack_option_vector_scalar_get_args(
					tensor,
					index,
					result_type,
				)
				Some(render_prepared_tensor_op(StackOptionVectorUInt128Get(args)))
			else:
				None
		TypeParameterType(_) | SelfType:
			None
		VoidType:
			None
		StackResultType(ok_type, err_type):
			None
		BoxedResultType(ok_type, err_type):
			None
		FunctionType(is_pure, param_types, return_type):
			None
		HeapRecordType(name):
			None
		UnionType(name):
			None
		TensorType(info):
			None
		TupleType(items):
			None


