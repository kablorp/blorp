private pure func constructor_match_test_target(
	source_c: String,
	test: CoreConstructorMatchTest,
) -> String:
	match test:
		UnionTagConstructorTest(tag_c_name, union_c_type):
			"((" + union_c_type + "*)" + source_c + ")"
		EnumConstructorTest(c_name):
			source_c
		NullableOptionSomeConstructorTest:
			source_c
		NullableOptionNoneConstructorTest:
			source_c
		StackOptionSomeConstructorTest(option_type):
			source_c
		StackOptionNoneConstructorTest(option_type):
			source_c
		StackResultOkConstructorTest(result_type):
			source_c
		StackResultErrConstructorTest(result_type):
			source_c
		BoxedResultOkConstructorTest:
			source_c
		BoxedResultErrConstructorTest:
			source_c
		BoolTrueConstructorTest:
			source_c
		BoolFalseConstructorTest:
			source_c


private pure func accessor_reads_boxed_struct_value(accessor: CoreAccessor) -> Bool:
	match accessor:
		RootAccessor:
			False
		VariantFieldAccessor(parent, union_c_type, constructor, field_index):
			False
		ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index):
			True
		NullableOptionPayloadAccessor(parent):
			False
		StackOptionPayloadAccessor(parent):
			False
		StackResultOkPayloadAccessor(parent):
			True
		StackResultErrPayloadAccessor(parent):
			True
		BoxedStackResultOkPayloadAccessor(parent, result_type):
			True
		BoxedStackResultErrPayloadAccessor(parent, result_type):
			True
		BoxedResultOkPayloadAccessor(parent):
			True
		BoxedResultErrPayloadAccessor(parent):
			True
		TupleFieldAccessor(parent, index, typ):
			False
		ListElementAccessor(parent, index):
			True
		ListSpreadAccessor(parent, offset):
			False


private pure func stack_option_match_source(
	source_c: String,
	accessor: CoreAccessor,
	option_type: String,
) -> String:
	if accessor_reads_boxed_struct_value(accessor):
		boxed_struct_value_source(option_type, source_c)
	else:
		source_c + ""


private pure func stack_result_match_source(
	source_c: String,
	accessor: CoreAccessor,
	result_type: String,
) -> String:
	match accessor:
		VariantFieldAccessor(parent, union_c_type, constructor, field_index):
			boxed_struct_value_source(result_type, source_c)
		_:
			if accessor_reads_boxed_struct_value(accessor):
				boxed_struct_value_source(result_type, source_c)
			else:
				source_c + ""


private pure func emit_match_accessor_for_constructor_case(
	scrutinee_temp: String,
	case_accessor: CoreAccessor,
	case_test: CoreConstructorMatchTest,
	accessor: CoreAccessor,
) -> Option[String]:
	match accessor:
		RootAccessor:
			Some(scrutinee_temp)
		VariantFieldAccessor(parent, union_c_type, constructor, field_index):
			parent_c ?= emit_match_accessor_for_constructor_case(
				scrutinee_temp,
				case_accessor,
				case_test,
				parent,
			)
			Some(
				union_pointer_source(
					union_c_type,
					parent_c,
				) + "->data." + constructor + ".field" + field_index.to_string(),
			)
		ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index):
			parent_c ?= emit_match_accessor_for_constructor_case(
				scrutinee_temp,
				case_accessor,
				case_test,
				parent,
			)
			Some(
				union_pointer_source(
					union_c_type,
					parent_c,
				) + "->data." + constructor + ".field" + field_index.to_string(),
			)
		NullableOptionPayloadAccessor(parent):
			emit_match_accessor_for_constructor_case(
				scrutinee_temp,
				case_accessor,
				case_test,
				parent,
			)
		StackOptionPayloadAccessor(parent):
			parent_c ?= emit_match_accessor(scrutinee_temp, parent)

			if accessors_equal(parent, case_accessor):
				match case_test:
					StackOptionSomeConstructorTest(option_type):
						Some(stack_option_match_source(parent_c, parent, option_type) + ".value")
					StackOptionNoneConstructorTest(option_type):
						Some(stack_option_match_source(parent_c, parent, option_type) + ".value")
					EnumConstructorTest(c_name):
						None
					UnionTagConstructorTest(tag_c_name, union_c_type):
						None
					NullableOptionSomeConstructorTest:
						None
					NullableOptionNoneConstructorTest:
						None
					StackResultOkConstructorTest(result_type):
						None
					StackResultErrConstructorTest(result_type):
						None
					BoxedResultOkConstructorTest:
						None
					BoxedResultErrConstructorTest:
						None
					BoolTrueConstructorTest:
						None
					BoolFalseConstructorTest:
						None
			else:
				Some(parent_c + ".value")
		StackResultOkPayloadAccessor(parent):
			parent_c ?= emit_match_accessor_for_constructor_case(
				scrutinee_temp,
				case_accessor,
				case_test,
				parent,
			)
			Some(parent_c + ".data.Ok.field0")
		StackResultErrPayloadAccessor(parent):
			parent_c ?= emit_match_accessor_for_constructor_case(
				scrutinee_temp,
				case_accessor,
				case_test,
				parent,
			)
			Some(parent_c + ".data.Err.field0")
		BoxedStackResultOkPayloadAccessor(parent, result_type):
			parent_c ?= emit_match_accessor_for_constructor_case(
				scrutinee_temp,
				case_accessor,
				case_test,
				parent,
			)
			Some(boxed_struct_value_source(result_type, parent_c) + ".data.Ok.field0")
		BoxedStackResultErrPayloadAccessor(parent, result_type):
			parent_c ?= emit_match_accessor_for_constructor_case(
				scrutinee_temp,
				case_accessor,
				case_test,
				parent,
			)
			Some(boxed_struct_value_source(result_type, parent_c) + ".data.Err.field0")
		BoxedResultOkPayloadAccessor(parent):
			parent_c ?= emit_match_accessor_for_constructor_case(
				scrutinee_temp,
				case_accessor,
				case_test,
				parent,
			)
			Some(parent_c + "->data.Ok.field0")
		BoxedResultErrPayloadAccessor(parent):
			parent_c ?= emit_match_accessor_for_constructor_case(
				scrutinee_temp,
				case_accessor,
				case_test,
				parent,
			)
			Some(parent_c + "->data.Err.field0")
		TupleFieldAccessor(parent, index, typ):
			parent_c ?= emit_match_accessor_for_constructor_case(
				scrutinee_temp,
				case_accessor,
				case_test,
				parent,
			)
			raw_value: String = render_prepared_tuple_op(TupleFieldElement({
				tuple = parent_c,
				field = index.to_string(),
			}))
			boxed_storage_value_source(raw_value, typ)
		ListElementAccessor(parent, index):
			parent_c ?= emit_match_accessor_for_constructor_case(
				scrutinee_temp,
				case_accessor,
				case_test,
				parent,
			)
			Some("blorp_list_get((blorp_List*)" + parent_c + ", " + index.to_string() + ")")
		ListSpreadAccessor(parent, offset):
			parent_c ?= emit_match_accessor_for_constructor_case(
				scrutinee_temp,
				case_accessor,
				case_test,
				parent,
			)
			Some("blorp_list_drop((blorp_List*)" + parent_c + ", " + offset.to_string() + ")")


private pure func constructor_case_binding_source(
	scrutinee_temp: String,
	match_case: CoreConstructorMatchCase,
	binding: CoreMatchBinding,
) -> Option[String]:
	raw_source ?= emit_match_accessor_for_constructor_case(
		scrutinee_temp,
		match_case.accessor,
		match_case.test,
		binding.accessor,
	)
	match_accessor_value_source(raw_source, binding.accessor, binding.typ)


private pure func emit_constructor_case_match_binding(
	scrutinee_temp: String,
	match_case: CoreConstructorMatchCase,
	owned_unique_name: Option[String],
	binding: CoreMatchBinding,
) -> Option[String]:
	match binding.mode:
		MatchBorrowBindingMode:
			source_c ?= constructor_case_binding_source(scrutinee_temp, match_case, binding)
			Some(emit_match_binding_declaration(binding, source_c))
		MatchOwnBindingMode:
			unique_name ?= owned_unique_name
			source_c ?= constructor_case_binding_source(scrutinee_temp, match_case, binding)
			emit_owned_match_binding_statement(scrutinee_temp, unique_name, binding, source_c)


private pure func match_binding_is_owned(binding: CoreMatchBinding) -> Bool:
	match binding.mode:
		MatchBorrowBindingMode:
			False
		MatchOwnBindingMode:
			True


private pure func match_bindings_have_owned(bindings: List[CoreMatchBinding]) -> Bool:
	var found: Bool = False

	for binding in bindings:
		if match_binding_is_owned(binding):
			found = True
			break

	found


private pure func emit_constructor_case_match_bindings(
	scrutinee_temp: String,
	match_case: CoreConstructorMatchCase,
	owned_unique_name: Option[String],
) -> Option[String]:
	var statements: String = ""
	var failed: Bool = False

	for binding in match_case.bindings:
		if not failed:
			match emit_constructor_case_match_binding(
				scrutinee_temp,
				match_case,
				owned_unique_name,
				binding,
			):
				Some(statement):
					statements += statement
				None:
					failed = True
					break

	if failed:
		None
	else:
		Some(statements)


private pure func emit_constructor_literal_match_body(
	outer_scrutinee_temp: String,
	result_name: Option[String],
	match_expr: CoreConstructorLiteralMatch,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	raw_scrutinee_value ?= emit_match_accessor(outer_scrutinee_temp, match_expr.accessor)
	scrutinee_value ?= match_accessor_value_source(
		raw_scrutinee_value,
		match_expr.accessor,
		match_expr.scrutinee_type,
	)
	scrutinee_temp: String = temp_name("match_scrut", next_temp)

	emit_constructor_literal_match_statement(
		"",
		outer_scrutinee_temp,
		scrutinee_temp,
		scrutinee_value,
		match_expr.scrutinee_type,
		result_name,
		match_expr.cases,
		match_expr.fallback,
		next_temp + 1,
	)


private pure func emit_constructor_case_literal_match_body(
	outer_scrutinee_temp: String,
	result_name: Option[String],
	match_case: CoreConstructorMatchCase,
	match_expr: CoreConstructorLiteralMatch,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	raw_scrutinee_value ?= emit_match_accessor_for_constructor_case(
		outer_scrutinee_temp,
		match_case.accessor,
		match_case.test,
		match_expr.accessor,
	)
	scrutinee_value ?= match_accessor_value_source(
		raw_scrutinee_value,
		match_expr.accessor,
		match_expr.scrutinee_type,
	)
	scrutinee_temp: String = temp_name("match_scrut", next_temp)

	emit_constructor_literal_match_statement(
		"",
		outer_scrutinee_temp,
		scrutinee_temp,
		scrutinee_value,
		match_expr.scrutinee_type,
		result_name,
		match_expr.cases,
		match_expr.fallback,
		next_temp + 1,
	)


private pure func emit_constructor_literal_match_fallback(
	outer_scrutinee_temp: String,
	result_name: Option[String],
	fallback: CoreLiteralMatchFallback,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match fallback:
		LiteralMatchFallbackBody(AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc)):
			emit_constructor_literal_match_body(
				outer_scrutinee_temp,
				result_name,
				match_expr,
				next_temp,
			)
		LiteralMatchFallbackBody(LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc)):
			emit_constructor_length_match_body(
				outer_scrutinee_temp,
				result_name,
				match_expr,
				next_temp,
			)
		LiteralMatchFallbackBody(body):
			emit_literal_match_branch_body(result_name, body, next_temp)
		LiteralMatchFallbackBindings(bindings, AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc)):
			bindings_c ?= emit_match_bindings(outer_scrutinee_temp, bindings)
			body_c ?= emit_constructor_literal_match_body(
				outer_scrutinee_temp,
				result_name,
				match_expr,
				next_temp,
			)
			Some({
				statements = bindings_c + body_c.statements,
				value = body_c.value,
				next_temp = body_c.next_temp,
				returns = body_c.returns,
			})
		LiteralMatchFallbackBindings(bindings, LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc)):
			bindings_c ?= emit_match_bindings(outer_scrutinee_temp, bindings)
			body_c ?= emit_constructor_length_match_body(
				outer_scrutinee_temp,
				result_name,
				match_expr,
				next_temp,
			)
			Some({
				statements = bindings_c + body_c.statements,
				value = body_c.value,
				next_temp = body_c.next_temp,
				returns = body_c.returns,
			})
		LiteralMatchFallbackBindings(bindings, body):
			bindings_c ?= emit_match_bindings(outer_scrutinee_temp, bindings)
			body_c ?= emit_literal_match_branch_body(result_name, body, next_temp)
			Some({
				statements = bindings_c + body_c.statements,
				value = body_c.value,
				next_temp = body_c.next_temp,
				returns = body_c.returns,
			})
		LiteralMatchFallbackFail:
			Some(emit_literal_match_failure(next_temp))


private pure func emit_constructor_literal_match_statement(
	prefix_statements: String,
	outer_scrutinee_temp: String,
	scrutinee_temp: String,
	scrutinee_value: String,
	scrutinee_type: CoreType,
	result_name: Option[String],
	cases: List[CoreLiteralMatchCase],
	fallback: CoreLiteralMatchFallback,
	branch_next_temp_start: Int,
) -> Option[FunctionBodyC]:
	var branch_next_temp: Int = branch_next_temp_start
	var branch_statements: String = ""
	var failed: Bool = False
	var has_case: Bool = False

	for match_case in cases:
		if not failed:
			match c_literal_match_test(scrutinee_temp, match_case.literal):
				Some(test):
					match emit_literal_match_case_body(
						outer_scrutinee_temp,
						result_name,
						match_case,
						branch_next_temp,
					):
						Some(case_c):
							if has_case:
								branch_statements += "  } else if (" + test + ") {\n"
							else:
								branch_statements += "  if (" + test + ") {\n"

							branch_statements += indent_statements(case_c.statements)
							branch_next_temp = case_c.next_temp
							has_case = True
						None:
							failed = True
							break
				None:
					failed = True
					break

	if failed:
		None
	else:
		fallback_c ?= emit_constructor_literal_match_fallback(
			outer_scrutinee_temp,
			result_name,
			fallback,
			branch_next_temp,
		)
		prefix: String = prefix_statements + "  " + c_type_name(
			scrutinee_type,
		) + " " + scrutinee_temp + " = " + scrutinee_value + ";\n"

		var match_statements: String = fallback_c.statements

		if has_case:
			match_statements = branch_statements + "  } else {\n" + indent_statements(
				fallback_c.statements,
			) + "  }\n"

		Some({
			statements = prefix + match_statements,
			value = "",
			next_temp = fallback_c.next_temp,
			returns = False,
		})


private pure func emit_constructor_expr_match_body(
	outer_scrutinee_temp: String,
	result_name: Option[String],
	expr: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match expr:
		RawMatchExpr(scrutinee, cases, typ, loc):
			None
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			None
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			emit_literal_match_branch_body(result_name, expr, next_temp)
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			emit_literal_match_branch_body(result_name, expr, next_temp)
		LiteralExpr(literal, typ, loc):
			emit_literal_match_branch_body(result_name, expr, next_temp)
