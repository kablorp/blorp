	definitions: String,
	value: String
}


record StaticInlineListStorage {
	c_type: String,
	elem_size: Int
}


private struct PositiveBinaryFloat {
	exponent: Int,
	significand: Float
}


private pure func owned_static_fragment(text: String) -> String:
	"" + text


private pure func static_list_storage_name(path_c: String) -> String:
	"__blorp_static_list_" + path_c


private pure func static_record_storage_name(path_c: String) -> String:
