private pure func emit_tensor_stack_option_get_call(
	name: String,
	args: List[String],
	typ: CoreType,
) -> Option[String]:
	match typ:
		NamedType(type_name, type_args):
			if type_name == "Option":
				match type_args:
					[payload_type]:
						if name == "blorp_vector_get_opt":
							match args:
								[tensor, index]:
									emit_vector_get_stack_option_payload(
										tensor,
										index,
										typ,
										payload_type,
									)
								[]:
									None
								[first]:
									None
								[first, second, third, ...rest]:
									None
						else if name == "blorp_matrix_get_opt":
							match args:
								[tensor, row, col]:
									emit_matrix_get_stack_option_payload(
										tensor,
										row,
										col,
										typ,
										payload_type,
									)
								[]:
									None
								[first]:
									None
								[first, second]:
									None
								[first, second, third, fourth, ...rest]:
									None
						else:
							None
					[]:
						None
					[first, second, ...rest]:
						None
			else:
				None
		TypeParameterType(_) | SelfType:
			None
		VoidType:
			None
		StackResultType(ok_type, err_type):
			None
		BoxedResultType(ok_type, err_type):
			None
		FunctionType(is_pure, param_types, return_type):
			None
		EnumType(type_name):
			None
		ValueRecordType(type_name):
			None
		HeapRecordType(type_name):
			None
		UnionType(type_name):
			None
		RangeType:
			None
		TensorType(info):
			None
		TupleType(items):
			None


private pure func emit_prepared_channel_builtin_call(
	name: String,
	args: List[String],
	typ: CoreType,
) -> Option[String]:
	if name == "blorp_channel_new":
		elem_type ?= channel_element_type(typ)

		if boxed_value_needs_release_type(elem_type):
			match args:
				[capacity]:
					render_args: ChannelWithElemReleaseArgs = {
						capacity = capacity,
						temp_seed = CHANNEL_ALLOC_TEMP_SEED
					}
					Some(render_prepared_backend_op(BackendChannelWithElemRelease(render_args)))
				[]:
					None
				[first, second, ...rest]:
					None
		else:
			None
	else:
		None


private pure func emit_retaining_channel_send_value(
	name: String,
	args: ChannelRetainingSendArgs,
) -> Option[String]:
	if name == "blorp_channel_send":
		Some(render_prepared_backend_op(BackendChannelRetainingSend(args, ChannelSendRuntime)))
	else if name == "blorp_channel_try_send":
		Some(render_prepared_backend_op(BackendChannelRetainingSend(args, ChannelTrySendRuntime)))
	else if name == "blorp_channel_try_send_status":
		Some(
			render_prepared_backend_op(
				BackendChannelRetainingSend(
					args,
					ChannelTrySendStatusRuntime,
				),
			),
		)
	else:
		None


