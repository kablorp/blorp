private pure func call_args_transfer_cleanup_pop_statements(
	consumed_args: List[Int],
	args: List[CoreExpr],
) -> String:
	var statements: String = ""
	var index: Int = 0

	for arg in args:
		if consumed_args.contains(index):
			statements += call_arg_transfer_cleanup_pop_statement(arg)

		index += 1

	statements


private pure func call_transfer_cleanup_pop_statements(
	kind: CoreCallKind,
	args: List[CoreExpr],
) -> String:
	match kind:
		UserCall(name, def_id, consumed_args):
			if name == "Some" or name == "None":
				""
			else:
				call_args_transfer_cleanup_pop_statements(
					call_kind_consumed_arg_indices(kind, args.length()),
					args,
				)
		_:
			call_args_transfer_cleanup_pop_statements(
				call_kind_consumed_arg_indices(kind, args.length()),
				args,
			)


private pure func match_scrutinee_consumes_var(
	scrutinee: CoreExpr,
	release_policy: CoreReleasePolicy,
	variable: CoreVar,
) -> Bool:
	release_policy_requires_cleanup(release_policy) and expr_is_var_reference(scrutinee, variable)


private pure func exprs_consume_var_before_suspension(
	exprs: List[CoreExpr],
	variable: CoreVar,
) -> Bool:
	var found: Bool = False

	for expr in exprs:
		if body_consumes_var_before_suspension(expr, variable):
			found = True
			break

	found


private pure func dict_literal_entries_consume_var_before_suspension(
	entries: List[CoreDictLiteralEntry],
	variable: CoreVar,
) -> Bool:
	var found: Bool = False

	for entry in entries:
		if (
			body_consumes_var_before_suspension(entry.key, variable)
			or body_consumes_var_before_suspension(entry.value, variable)
		):
			found = True
			break

	found


private pure func body_consumes_var_before_suspension(expr: CoreExpr, variable: CoreVar) -> Bool:
	match expr:
		RawMatchExpr(scrutinee, cases, typ, loc):
			if body_consumes_var_before_suspension(scrutinee, variable):
				True
			else:
				cases.any(func(case): body_consumes_var_before_suspension(case.body, variable))
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			CoreTraverse.any_core_expr(
				CoreTraverse.immediate_core_expr_children(expr),
				func(child): body_consumes_var_before_suspension(child, variable),
			)
		CallExpr(kind, callee, args, typ, loc):
			call_consumes_var_before_suspension(kind, args, variable)
		DupExpr(dup_var, value_type, retain_policy, body, typ, loc):
			body_consumes_var_before_suspension(body, variable)
		DropExpr(drop_var, value_type, release_policy, body, typ, loc):
			if core_vars_equal(drop_var, variable):
				True
			else:
				body_consumes_var_before_suspension(body, variable)
		LetExpr(name, is_mutable, typ, rhs, body):
			if body_consumes_var_before_suspension(rhs, variable):
				True
			else:
				(
					transfer_prefix_is_non_suspending(rhs)
					and body_consumes_var_before_suspension(body, variable)
				)
		BorrowLetExpr(name, typ, rhs, body):
			if body_consumes_var_before_suspension(rhs, variable):
				True
			else if core_vars_equal(name, variable):
				False
			else:
				(
					transfer_prefix_is_non_suspending(rhs)
					and body_consumes_var_before_suspension(body, variable)
				)
		SeqExpr(first, second):
			if body_consumes_var_before_suspension(first, variable):
				True
			else:
				(
					transfer_prefix_is_non_suspending(first)
					and body_consumes_var_before_suspension(second, variable)
				)
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			match_scrutinee_consumes_var(scrutinee, scrutinee_release_policy, variable)
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			match_scrutinee_consumes_var(scrutinee, scrutinee_release_policy, variable)
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, fallback, typ, loc):
			match_scrutinee_consumes_var(scrutinee, scrutinee_release_policy, variable)
		VarExpr(returned, typ, loc):
			False
		LiteralExpr(literal, typ, loc):
			False
		VoidExpr(typ, loc):
			False
		DebugBlockExpr(body, typ, loc):
			body_consumes_var_before_suspension(body, variable)
		CooperativeCheckpointExpr(typ, loc):
			False
		BinaryExpr(op, left, right, typ, loc):
			collection_equality_consumes_var(op, left, right, variable)
		UnaryExpr(op, expr_value, typ, loc):
			False
		LogicalExpr(op, left, right, typ, loc):
			False
		AssignExpr(assign_var, rhs, typ, loc):
			expr_is_var_reference(rhs, variable)
		CastExpr(expr_value, typ, loc):
			False
		BoxExpr(box, typ, loc):
			False
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			False
		FieldExpr(expr_value, field_name, typ, loc):
			False
		TupleFieldExpr(expr_value, field_index, typ, loc):
			False
		TupleExpr(items, typ, loc):
			exprs_consume_var_before_suspension(items, variable)
		TupleConstructExpr(tuple_construct, typ, loc):
			False
		VectorExpr(items, typ, loc):
			exprs_consume_var_before_suspension(items, variable)
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			False
		ClosureCreateExpr(closure, typ, loc):
			False
		ListConstructExpr(construct, typ, loc):
			False
		ListAllocExpr(alloc, typ, loc):
			False
		ListGetExpr(get, typ, loc):
			False
		ListHandoffExpr(handoff, typ, loc):
			False
		ListHandoffSetOwnedExpr(set, typ, loc):
			False
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			False
		ListRetainExpr(retain, typ, loc):
			False
		ListSetExpr(set, typ, loc):
			False
		ListSwapExpr(swap, typ, loc):
			False
		StringByteReadExpr(read, typ, loc):
			False
		StringByteWriteExpr(write, typ, loc):
			False
		StringByteCopyExpr(copy, typ, loc):
			False
		StringSetLenExpr(set_len, typ, loc):
			False
		TensorLiteralExpr(literal, typ, loc):
			False
		TensorBoxedLiteralExpr(literal, typ, loc):
			False
		TensorPackedLiteralExpr(literal, typ, loc):
			False
		TensorRawFillExpr(fill, typ, loc):
			False
		TensorRawReadExpr(read, typ, loc):
			False
		TensorRawWriteExpr(write, typ, loc):
			False
		TensorRawViewLetExpr(binding, body, typ, loc):
			False
		DictExpr(entries, typ, loc):
			dict_literal_entries_consume_var_before_suspension(entries, variable)
		DictConstructExpr(construct, typ, loc):
			False
		SetAllocExpr(alloc, typ, loc):
			False
		RecordExpr(fields, typ, loc):
			False
		RecordUpdateExpr(base, fields, typ, loc):
			False
		RecordReuseExpr(source, fields, typ, loc):
			False
		RecordConstructExpr(type_name, fields, typ, loc):
			False
		UnionConstructExpr(construct, typ, loc):
			False
		UnionReuseConstructExpr(construct, typ, loc):
			False
		PreClosureDetachExpr(detached, typ, loc):
			False
		WhileExpr(cond, body, typ, loc):
			False
		BreakExpr(typ, loc):
			False
		ContinueExpr(typ, loc):
			False
		ResourceScopeExpr(scope, typ, loc):
			False
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			False
		TailrecLoopExpr(params, return_type, body, loc):
			False
		TailrecRecurExpr(args, typ, loc):
			False
		TailrecListSpreadLoopExpr(loop, loc):
			False
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			False
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			False
		ForChannelExpr(for_channel, typ, loc):
			False
		ForListExpr(for_list, typ, loc):
			False
		ForStringExpr(for_string, typ, loc):
			False
		ForDictExpr(for_dict, typ, loc):
			False
		ForSetExpr(for_set, typ, loc):
			False
		ForResourceSourceExpr(for_resource_source, typ, loc):
			False
		ForStreamExpr(for_stream, typ, loc):
			False
		ForTensorExpr(for_tensor, typ, loc):
			False
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			False
		DetachExpr(detached, typ, loc):
			False
		ConcurrentlyLoopExpr(loop, typ, loc):
			False
		PreClosureConcurrentExpr(block, typ, loc):
			False
		ConcurrentExpr(block, typ, loc):
			False
		SelectExpr(select_expr, typ, loc):
			False
		RangeExpr(start, end_value, typ, loc):
			False
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			False
		IfExpr(cond, then_expr, else_expr, typ, loc):
			if body_consumes_var(cond, variable):
				True
			else if body_consumes_var(then_expr, variable):
				True
			else:
				body_consumes_var(else_expr, variable)


private pure func let_body_takes_cleanup_ownership(body: CoreExpr, variable: CoreVar) -> Bool:
	directly_returns_var(body, variable) or body_consumes_var_before_suspension(body, variable)


private pure func exprs_consume_var(exprs: List[CoreExpr], variable: CoreVar) -> Bool:
	var found: Bool = False

	for expr in exprs:
		if body_consumes_var(expr, variable):
			found = True
			break

	found


private pure func dict_literal_entries_consume_var(
	entries: List[CoreDictLiteralEntry],
	variable: CoreVar,
) -> Bool:
	var found: Bool = False

	for entry in entries:
		if body_consumes_var(entry.key, variable) or body_consumes_var(entry.value, variable):
			found = True
			break

	found


private pure func let_normal_cleanup_statement(variable: CoreVar) -> String:
	cancellation_cleanup_pop_statement(variable)


private pure func apply_let_cleanup_to_body(
	body_expr: CoreExpr,
	body_c: FunctionBodyC,
	cleanup: String,
) -> FunctionBodyC:
	if cleanup == "":
		body_c
	else if is_void_type(core_expr_type(body_expr)):
		{
			statements = body_c.statements + cleanup,
			value = body_c.value,
			next_temp = body_c.next_temp,
			returns = body_c.returns
		}
	else if body_c.value == "" or body_c.returns:
		{
			statements = body_c.statements + cleanup,
			value = body_c.value,
			next_temp = body_c.next_temp,
			returns = body_c.returns
		}
	else:
		result_name: String = temp_name("let_result", body_c.next_temp)
		{
			statements = body_c.statements + "  " + c_type_name(
				core_expr_type(
					body_expr,
				),
			) + " " + result_name + " = " + body_c.value + ";\n" + cleanup,
			value = result_name,
			next_temp = body_c.next_temp + 1,
			returns = False
		}


private pure func body_consumes_var(expr: CoreExpr, variable: CoreVar) -> Bool:
	match expr:
		RawMatchExpr(scrutinee, cases, typ, loc):
			(
				body_consumes_var(scrutinee, variable)
				or cases.any(func(case): body_consumes_var(case.body, variable))
			)
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			CoreTraverse.any_core_expr(
				CoreTraverse.immediate_core_expr_children(expr),
				func(child): body_consumes_var(child, variable),
			)
		CallExpr(kind, callee, args, typ, loc):
			call_consumes_var(kind, args, variable)
		DupExpr(dup_var, value_type, retain_policy, body, typ, loc):
			body_consumes_var(body, variable)
		DropExpr(drop_var, value_type, release_policy, body, typ, loc):
			if core_vars_equal(drop_var, variable):
				True
			else:
				body_consumes_var(body, variable)
		LetExpr(name, is_mutable, typ, rhs, body):
			if body_consumes_var(rhs, variable):
				True
			else if core_vars_equal(name, variable):
				False
			else:
				body_consumes_var(body, variable)
		BorrowLetExpr(name, typ, rhs, body):
			if body_consumes_var(rhs, variable):
				True
			else if core_vars_equal(name, variable):
				False
			else:
				body_consumes_var(body, variable)
		SeqExpr(first, second):
			body_consumes_var(first, variable) or body_consumes_var(second, variable)
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			match_scrutinee_consumes_var(scrutinee, scrutinee_release_policy, variable)
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			match_scrutinee_consumes_var(scrutinee, scrutinee_release_policy, variable)
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, fallback, typ, loc):
			match_scrutinee_consumes_var(scrutinee, scrutinee_release_policy, variable)
		AssignExpr(assign_var, rhs, typ, loc):
			expr_is_var_reference(rhs, variable)
		VarExpr(returned, typ, loc):
