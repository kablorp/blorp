				channel = channel,
				value = value,
				timeout = timeout,
				temp_seed = CHANNEL_SEND_TEMP_SEED
			}
			emit_retaining_channel_timeout_send_value(name, args)
		[]:
			None
		[first]:
			None
		[first, second]:
			None
		[first, second, third, fourth, ...rest]:
