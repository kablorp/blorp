private union ClosureAbiValue:
	ClosureAbiVoid
	ClosureAbiPointer
	ClosureAbiPrim
	ClosureAbiFloat
	ClosureAbiFloat32
	ClosureAbiFloat16
	ClosureAbiInt128
	ClosureAbiUInt128
	ClosureAbiStruct(String)


private record ClosureArgBinding {
	name: String,
	statement: String,
	needs_release: Bool
}


private pure func function_kind_label(kind: CoreFunctionKind) -> String:
	match kind:
		UserFunction:
			"user"
		BuiltinFunction(c_name):
			"builtin"
		UnresolvedBuiltinFunction:
			"unresolved_builtin"
		ForeignFunction(_):
			"foreign"
		ClosureBodyFunction(abi):
			"closure_body"


private pure func emit_function_inventory(func_info: CoreFunction) -> String:
	"/* function " + func_info.name + " kind=" + function_kind_label(
		func_info.function_kind,
	) + " def_id=" + func_info.def_id.to_string() + " */\n"


private pure func emit_unsupported_function_error(func_info: CoreFunction) -> String:
	"/* unsupported function " + func_info.name + " kind=" + function_kind_label(
		func_info.function_kind,
	) + " def_id=" + func_info.def_id.to_string() + " child_path=" + func_info.body
		.map(unsupported_expr_child_path)
		.get_or("") + " child_kind=" + func_info.body
		.map(unsupported_expr_child_kind)
		.get_or(
			"",
		) + " */\n#error \"Blorp backend could not emit function body: " + func_info.name + "\"\n"


private ENTRYPOINT_FUNCTION_NAME: String = "main"


private pure func runtime_backed_heap_record_c_type(name: String) -> Option[String]:
	TypeLayout.runtime_backed_heap_record_c_type(name)


private pure func stack_option_c_type(payload: CoreType) -> Option[String]:
	TypeLayout.stack_option_c_type(payload)


private pure func generated_stack_option_c_type_name(payload_name: String) -> String:
	TypeLayout.generated_stack_option_c_type_name(payload_name)


private pure func runtime_owned_stack_option_payload_name(name: String) -> Bool:
	TypeLayout.runtime_owned_stack_option_payload_name(name)


private pure func is_closure_abi_prim_name(name: String) -> Bool:
	TypeLayout.is_closure_abi_prim_name(name)


private pure func closure_abi_value_for_named_type(
	name: String,
	args: List[CoreType],
) -> Option[ClosureAbiValue]:
	if name == "Void" and args.length() == 0:
		Some(ClosureAbiVoid)
	else if is_closure_abi_prim_name(name) and args.length() == 0:
		Some(ClosureAbiPrim)
	else if name == "Float" and args.length() == 0:
		Some(ClosureAbiFloat)
	else if name == "Float32" and args.length() == 0:
		Some(ClosureAbiFloat32)
	else if name == "Float16" and args.length() == 0:
		Some(ClosureAbiFloat16)
	else if name == "Int128" and args.length() == 0:
		Some(ClosureAbiInt128)
	else if name == "UInt128" and args.length() == 0:
		Some(ClosureAbiUInt128)
	else if name == "Option":
		match args:
			[payload]:
				match stack_option_c_type(payload):
					Some(c_type):
						Some(ClosureAbiStruct(c_type))
					None:
						Some(ClosureAbiPointer)
			[]:
				None
			[first, second, ...rest]:
				None
	else if name == "Result":
		None
	else:
		Some(ClosureAbiPointer)


private pure func closure_abi_value_for_type(typ: CoreType) -> Option[ClosureAbiValue]:
	match typ:
		VoidType:
			Some(ClosureAbiVoid)
		NamedType(name, args):
			closure_abi_value_for_named_type(name, args)
		TypeParameterType(_) | SelfType:
			None
		StackResultType(ok_type, err_type):
			Some(ClosureAbiStruct("blorp_StackResult"))
		BoxedResultType(ok_type, err_type):
			Some(ClosureAbiPointer)
		FunctionType(_, _, _):
			Some(ClosureAbiPointer)
		EnumType(name):
			Some(ClosureAbiPrim)
		ValueRecordType(name):
			Some(ClosureAbiStruct(name))
		HeapRecordType(name):
			Some(ClosureAbiPointer)
		UnionType(name):
			Some(ClosureAbiPointer)
		RangeType:
			Some(ClosureAbiPrim)
		TensorType(info):
			Some(ClosureAbiPointer)
		TupleType(items):
			Some(ClosureAbiPointer)


private pure func is_resource_source_type_name(name: String) -> Bool:
	CoreTypePolicy.is_resource_source_type_name(name)


private pure func c_type_name(typ: CoreType) -> String:
	TypeLayout.c_type_name(typ)


private pure func c_return_type(func_info: CoreFunction) -> String:
	if func_info.name == ENTRYPOINT_FUNCTION_NAME and func_info.source_module.is_none():
		"int"
	else:
		c_type_name(func_info.return_type)


private pure func c_function_name(func_info: CoreFunction) -> String:
	if func_info.name == ENTRYPOINT_FUNCTION_NAME and func_info.source_module.is_none():
		ENTRYPOINT_FUNCTION_NAME
	else:
		c_identifier(func_info.name)


private pure func c_function_signature(func_info: CoreFunction) -> String:
	if entrypoint_has_source_args(func_info):
		c_return_type(func_info) + " " + c_function_name(func_info) + "(int argc, char** argv)"
	else:
		c_return_type(
			func_info,
		) + " " + c_function_name(func_info) + "(" + c_param_list(func_info.params) + ")"


private pure func c_identifier(name: String) -> String:
	if C_RESERVED_IDENTIFIERS.contains(name):
		name + "_"
	else:
		name


private COMPILER_LOCAL_PREFIX: String = "$blorp$"

private COMPILER_LOCAL_C_PREFIX: String = "__blorp_internal_"

private ESCAPED_SOURCE_LOCAL_C_PREFIX: String = "__blorp_source_"


private pure func c_local_name(name: String) -> String:
	-- Later Core passes may derive a local from another compiler-owned local
	-- (for example, a drop-result temporary). Preserve the compiler namespace
	-- even when the marker is no longer at the beginning of the derived name.
	if name.contains(COMPILER_LOCAL_PREFIX):
		COMPILER_LOCAL_C_PREFIX + name
			.replace(COMPILER_LOCAL_PREFIX, "")
			.replace("$", "_")
	else if (
		name.starts_with(COMPILER_LOCAL_C_PREFIX)
		or name.starts_with(ESCAPED_SOURCE_LOCAL_C_PREFIX)
	):
		-- Length-prefixing makes this mapping injective, including for source
		-- names that already begin with the escape namespace.
		ESCAPED_SOURCE_LOCAL_C_PREFIX + name
			.length()
			.to_string() + "_" + name
	else:
		c_identifier(name)


private pure func c_var_name(variable: CoreVar) -> String:
	c_local_name(variable.name)


private pure func entrypoint_has_source_args(func_info: CoreFunction) -> Bool:
	(
		func_info.name == ENTRYPOINT_FUNCTION_NAME
		and func_info.source_module.is_none()
		and func_info.params.length() > 0
	)


private pure func entrypoint_arg_name(func_info: CoreFunction) -> String:
	match func_info.params:
		[]:
			"args"
		[param, ...rest]:
			c_var_name(param.name)


private pure func entrypoint_arg_prelude(func_info: CoreFunction) -> String:
	if entrypoint_has_source_args(func_info):
		arg_name: String = entrypoint_arg_name(func_info)

		"  blorp_List* " + arg_name + " = blorp_list_new(argc);\n" + "  blorp_list_init_elem_release(" + arg_name + ", blorp_elem_release_fn);\n" + "  for (int __i = 0; __i < argc; __i++) " + arg_name + " = blorp_list_append_owned(" + arg_name + ", (void*)blorp_string_create(argv[__i]));\n"
	else:
		""


private pure func entrypoint_arg_cleanup(func_info: CoreFunction) -> String:
	if entrypoint_has_source_args(func_info):
		"  blorp_release(" + entrypoint_arg_name(func_info) + ");\n"
	else:
		""


private pure func emit_profile_runtime_setup(profile_enabled: Bool) -> String:
	if profile_enabled:
		"  blorp_profile_enable();\n  atexit(blorp_profile_report);\n"
	else:
		""


private pure func emit_profile_start(profile_enabled: Bool, name: String) -> String:
	if profile_enabled:
		"  blorp_profile_start(" + c_string_literal(name) + ");\n"
	else:
		""


private pure func emit_profile_end(profile_enabled: Bool, name: String) -> String:
	if profile_enabled:
		"  blorp_profile_end(" + c_string_literal(name) + ");\n"
	else:
		""


private pure func c_param(param: CoreParam) -> String:
	c_type_name(param.typ) + " " + c_var_name(param.name)


private pure func c_param_list(params: List[CoreParam]) -> String:
	if params.length() == 0:
		"void"
	else:
		var result: String = ""
		var index: Int = 0

		for param in params:
			if index > 0:
				result += ", "

			result += c_param(param)
			index += 1

		result


private pure func is_void_type(typ: CoreType) -> Bool:
	TypeLayout.is_void_type(typ)


private pure func is_stack_result_type(typ: CoreType) -> Bool:
	CoreTypePolicy.is_stack_result_type(typ)


private pure func is_void_expr(expr: CoreExpr) -> Bool:
	match expr:
		LiteralExpr(literal, typ, loc):
			False
		VarExpr(variable, typ, loc):
			False
		VoidExpr(typ, loc):
			True
		DebugBlockExpr(body, typ, loc):
			False
		RawMatchExpr(scrutinee, cases, typ, loc):
			False
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			False
		CooperativeCheckpointExpr(typ, loc):
			False
		CallExpr(kind, callee, args, typ, loc):
			False
		BinaryExpr(op, left, right, typ, loc):
			False
		UnaryExpr(op, expr_value, typ, loc):
			False
		LogicalExpr(op, left, right, typ, loc):
			False
		AssignExpr(variable, rhs, typ, loc):
			False
		CastExpr(expr_value, typ, loc):
			False
		BoxExpr(box, typ, loc):
			False
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			False
		FieldExpr(expr_value, field_name, typ, loc):
			False
		TupleFieldExpr(expr_value, field_index, typ, loc):
			False
		TupleExpr(items, typ, loc):
			False
		TupleConstructExpr(tuple_construct, typ, loc):
			False
		VectorExpr(items, typ, loc):
			False
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			False
		ClosureCreateExpr(closure, typ, loc):
			False
		ListConstructExpr(construct, typ, loc):
			False
		ListAllocExpr(alloc, typ, loc):
			False
		ListGetExpr(get, typ, loc):
			False
		ListHandoffExpr(handoff, typ, loc):
			False
		ListHandoffSetOwnedExpr(set, typ, loc):
			False
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			False
		StringByteReadExpr(read, typ, loc):
			False
		StringByteWriteExpr(write, typ, loc):
			False
		StringByteCopyExpr(copy, typ, loc):
			False
		StringSetLenExpr(set_len, typ, loc):
			False
		TensorLiteralExpr(literal, typ, loc):
			False
		TensorBoxedLiteralExpr(literal, typ, loc):
			False
		TensorPackedLiteralExpr(literal, typ, loc):
			False
		TensorRawFillExpr(fill, typ, loc):
			False
		TensorRawReadExpr(read, typ, loc):
			False
		TensorRawWriteExpr(write, typ, loc):
			False
		TensorRawViewLetExpr(binding, body, typ, loc):
			False
		DictExpr(entries, typ, loc):
			False
		DictConstructExpr(construct, typ, loc):
			False
		SetAllocExpr(alloc, typ, loc):
			False
		ListRetainExpr(retain, typ, loc):
			False
		ListSetExpr(set, typ, loc):
			False
		ListSwapExpr(swap, typ, loc):
			False
		RecordExpr(fields, typ, loc):
			False
		RecordUpdateExpr(base, fields, typ, loc):
			False
		RecordReuseExpr(source, fields, typ, loc):
			False
		RecordConstructExpr(type_name, fields, typ, loc):
			False
		UnionConstructExpr(construct, typ, loc):
			False
		UnionReuseConstructExpr(construct, typ, loc):
			False
		PreClosureDetachExpr(detached, typ, loc):
			False
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			False
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			False
		LetExpr(name, is_mutable, typ, rhs, body):
			False
		BorrowLetExpr(name, typ, rhs, body):
			False
		SeqExpr(first, second):
			False
		WhileExpr(cond, body, typ, loc):
			False
		BreakExpr(typ, loc):
			False
		ContinueExpr(typ, loc):
			False
		ResourceScopeExpr(scope, typ, loc):
			False
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			False
		TailrecLoopExpr(params, return_type, body, loc):
			False
		TailrecRecurExpr(args, typ, loc):
			False
		TailrecListSpreadLoopExpr(loop, loc):
			False
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			False
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			False
		ForChannelExpr(for_channel, typ, loc):
			False
		ForListExpr(for_list, typ, loc):
			False
		ForStringExpr(for_string, typ, loc):
			False
		ForDictExpr(for_dict, typ, loc):
			False
		ForSetExpr(for_set, typ, loc):
			False
		ForResourceSourceExpr(for_resource_source, typ, loc):
			False
		ForStreamExpr(for_stream, typ, loc):
			False
		ForTensorExpr(for_tensor, typ, loc):
			False
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			False
		DetachExpr(detached, typ, loc):
			False
		ConcurrentlyLoopExpr(loop, typ, loc):
			False
		PreClosureConcurrentExpr(block, typ, loc):
			False
		ConcurrentExpr(block, typ, loc):
			False
		SelectExpr(select_expr, typ, loc):
			False
		RangeExpr(start, end_value, typ, loc):
			False
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			False
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			False
		LiteralMatchExpr(scrutinee, cases, default_body, typ, loc):
			False
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, default_body, typ, loc):
			False
		IfExpr(cond, then_expr, else_expr, typ, loc):
			False


private pure func body_value(value: String, next_temp: Int) -> FunctionBodyC:
	{
		statements = "",
		value = value,
		next_temp = next_temp,
		returns = False
	}


private pure func discard_body(body: FunctionBodyC) -> String:
	if body.value == "":
		body.statements
	else:
		body.statements + "  (void)(" + body.value + ");\n"


private pure func type_requires_release(typ: CoreType) -> Bool:
	TypeLayout.type_requires_release(typ)


private pure func boxed_value_needs_release_type(typ: CoreType) -> Bool:
	TypeLayout.boxed_value_needs_release_type(typ)


private pure func dict_stored_value_needs_release_type(typ: CoreType) -> Bool:
	TypeLayout.dict_stored_value_needs_release_type(typ)


private pure func dict_value_needs_release_type(typ: CoreType) -> Bool:
	TypeLayout.dict_value_needs_release_type(typ)


private pure func type_is_value_record(typ: CoreType) -> Bool:
	TypeLayout.type_is_value_record(typ)


private pure func ownership_result_transfers_ownership(result: OwnershipResultMode) -> Bool:
	match result:
		ReturnOwned:
			True
		_:
			False


private pure func call_result_transfers_ownership(kind: CoreCallKind, arg_count: Int) -> Bool:
	match call_kind_ownership_contract(kind, arg_count):
		Some(contract):
			ownership_result_transfers_ownership(contract.result)
		None:
			-- User, closure, foreign, and unresolved calls follow the Core ABI:
			-- managed results are caller-owned unless a runtime contract says otherwise.
			True


private pure func expr_source_transfers_ownership(expr: CoreExpr) -> Bool:
	match expr:
		CallExpr(kind, callee, args, typ, loc):
			call_result_transfers_ownership(kind, args.length())
		CastExpr(expr_value, typ, loc):
			expr_source_transfers_ownership(expr_value)
		_:
			expr_transfers_ownership(expr)


private pure func expr_transfers_ownership(expr: CoreExpr) -> Bool:
	match expr:
		BoxExpr(box, typ, loc):
			boxed_value_needs_release_type(box.source_type)
		VarExpr(variable, typ, loc):
			type_is_value_record(typ)
		FieldExpr(expr_value, field_name, typ, loc):
			type_is_value_record(typ)
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			type_is_value_record(typ)
		LiteralExpr(literal, typ, loc):
			match literal:
				StringLiteral(value):
					True
				IntLiteral(value):
					boxed_value_needs_release_type(typ)
				WideIntLiteral(value):
					boxed_value_needs_release_type(typ)
				FloatLiteral(value):
					boxed_value_needs_release_type(typ)
				FloatTextLiteral(value):
					boxed_value_needs_release_type(typ)
				FloatInfinityLiteral:
					boxed_value_needs_release_type(typ)
				FloatNegInfinityLiteral:
					boxed_value_needs_release_type(typ)
				FloatNanLiteral:
					boxed_value_needs_release_type(typ)
				BoolLiteral(value):
					boxed_value_needs_release_type(typ)
				CharLiteral(value):
					boxed_value_needs_release_type(typ)
		VoidExpr(typ, loc):
			boxed_value_needs_release_type(typ)
		DebugBlockExpr(body, typ, loc):
			boxed_value_needs_release_type(typ)
		CooperativeCheckpointExpr(typ, loc):
			boxed_value_needs_release_type(typ)
		CallExpr(kind, callee, args, typ, loc):
			(
				boxed_value_needs_release_type(typ)
				and call_result_transfers_ownership(kind, args.length())
			)
		BinaryExpr(op, left, right, typ, loc):
			boxed_value_needs_release_type(typ)
		UnaryExpr(op, expr_value, typ, loc):
			boxed_value_needs_release_type(typ)
		LogicalExpr(op, left, right, typ, loc):
			boxed_value_needs_release_type(typ)
		AssignExpr(variable, rhs, typ, loc):
			boxed_value_needs_release_type(typ)
		CastExpr(expr_value, typ, loc):
			boxed_value_needs_release_type(typ) and expr_source_transfers_ownership(expr_value)
		TupleFieldExpr(expr_value, field_index, typ, loc):
			boxed_value_needs_release_type(typ)
		TupleExpr(items, typ, loc):
			boxed_value_needs_release_type(typ)
		TupleConstructExpr(tuple_construct, typ, loc):
			boxed_value_needs_release_type(typ)
		VectorExpr(items, typ, loc):
			boxed_value_needs_release_type(typ)
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			boxed_value_needs_release_type(typ)
		ClosureCreateExpr(closure, typ, loc):
			boxed_value_needs_release_type(typ)
		ListConstructExpr(construct, typ, loc):
			boxed_value_needs_release_type(typ)
		ListAllocExpr(alloc, typ, loc):
			boxed_value_needs_release_type(typ)
		ListGetExpr(get, typ, loc):
			boxed_value_needs_release_type(typ)
		ListHandoffExpr(handoff, typ, loc):
			boxed_value_needs_release_type(typ)
		ListHandoffSetOwnedExpr(set, typ, loc):
			boxed_value_needs_release_type(typ)
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			boxed_value_needs_release_type(typ)
		StringByteReadExpr(read, typ, loc):
			boxed_value_needs_release_type(typ)
		StringByteWriteExpr(write, typ, loc):
			boxed_value_needs_release_type(typ)
		StringByteCopyExpr(copy, typ, loc):
			boxed_value_needs_release_type(typ)
		StringSetLenExpr(set_len, typ, loc):
			boxed_value_needs_release_type(typ)
		TensorLiteralExpr(literal, typ, loc):
			boxed_value_needs_release_type(typ)
		TensorBoxedLiteralExpr(literal, typ, loc):
			boxed_value_needs_release_type(typ)
		TensorPackedLiteralExpr(literal, typ, loc):
			boxed_value_needs_release_type(typ)
		TensorRawFillExpr(fill, typ, loc):
			boxed_value_needs_release_type(typ)
		TensorRawReadExpr(read, typ, loc):
			boxed_value_needs_release_type(typ)
		TensorRawWriteExpr(write, typ, loc):
			boxed_value_needs_release_type(typ)
		TensorRawViewLetExpr(binding, body, typ, loc):
			boxed_value_needs_release_type(typ)
		DictExpr(entries, typ, loc):
			boxed_value_needs_release_type(typ)
		DictConstructExpr(construct, typ, loc):
			boxed_value_needs_release_type(typ)
		SetAllocExpr(alloc, typ, loc):
			boxed_value_needs_release_type(typ)
		ListRetainExpr(retain, typ, loc):
			boxed_value_needs_release_type(typ)
		ListSetExpr(set, typ, loc):
			boxed_value_needs_release_type(typ)
		ListSwapExpr(swap, typ, loc):
			boxed_value_needs_release_type(typ)
		RecordExpr(fields, typ, loc):
			boxed_value_needs_release_type(typ)
		RecordUpdateExpr(base, fields, typ, loc):
			boxed_value_needs_release_type(typ)
		RecordReuseExpr(source, fields, typ, loc):
			boxed_value_needs_release_type(typ)
		RecordConstructExpr(type_name, fields, typ, loc):
			boxed_value_needs_release_type(typ)
		UnionConstructExpr(construct, typ, loc):
			boxed_value_needs_release_type(typ)
		UnionReuseConstructExpr(construct, typ, loc):
			boxed_value_needs_release_type(typ)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			boxed_value_needs_release_type(typ)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			boxed_value_needs_release_type(typ)
		LetExpr(name, is_mutable, typ, rhs, body):
			boxed_value_needs_release_type(core_expr_type(body))
		BorrowLetExpr(name, typ, rhs, body):
			boxed_value_needs_release_type(core_expr_type(body))
		SeqExpr(first, second):
			boxed_value_needs_release_type(core_expr_type(second))
		WhileExpr(cond, body, typ, loc):
			boxed_value_needs_release_type(typ)
		BreakExpr(typ, loc):
			boxed_value_needs_release_type(typ)
		ContinueExpr(typ, loc):
			boxed_value_needs_release_type(typ)
		ResourceScopeExpr(scope, typ, loc):
			boxed_value_needs_release_type(typ)
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			boxed_value_needs_release_type(typ)
		TailrecLoopExpr(params, return_type, body, loc):
			boxed_value_needs_release_type(return_type)
		TailrecRecurExpr(args, typ, loc):
			boxed_value_needs_release_type(typ)
		TailrecListSpreadLoopExpr(loop, loc):
			boxed_value_needs_release_type(loop.return_type)
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			boxed_value_needs_release_type(typ)
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			boxed_value_needs_release_type(typ)
		ForChannelExpr(for_channel, typ, loc):
			boxed_value_needs_release_type(typ)
		ForListExpr(for_list, typ, loc):
			boxed_value_needs_release_type(typ)
		ForStringExpr(for_string, typ, loc):
			boxed_value_needs_release_type(typ)
		ForDictExpr(for_dict, typ, loc):
			boxed_value_needs_release_type(typ)
		ForSetExpr(for_set, typ, loc):
			boxed_value_needs_release_type(typ)
		ForResourceSourceExpr(for_resource_source, typ, loc):
			boxed_value_needs_release_type(typ)
		ForStreamExpr(for_stream, typ, loc):
			boxed_value_needs_release_type(typ)
		ForTensorExpr(for_tensor, typ, loc):
			boxed_value_needs_release_type(typ)
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			boxed_value_needs_release_type(typ)
		PreClosureDetachExpr(detached, typ, loc):
			boxed_value_needs_release_type(typ)
		DetachExpr(detached, typ, loc):
			boxed_value_needs_release_type(typ)
		ConcurrentlyLoopExpr(loop, typ, loc):
			boxed_value_needs_release_type(typ)
		PreClosureConcurrentExpr(block, typ, loc):
			boxed_value_needs_release_type(typ)
		ConcurrentExpr(block, typ, loc):
			boxed_value_needs_release_type(typ)
		SelectExpr(select_expr, typ, loc):
			boxed_value_needs_release_type(typ)
		RangeExpr(start, end_value, typ, loc):
			boxed_value_needs_release_type(typ)
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			boxed_value_needs_release_type(typ)
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			boxed_value_needs_release_type(typ)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			boxed_value_needs_release_type(typ)
		RawMatchExpr(scrutinee, cases, typ, loc):
			boxed_value_needs_release_type(typ)
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			boxed_value_needs_release_type(typ)
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, fallback, typ, loc):
			boxed_value_needs_release_type(typ)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			boxed_value_needs_release_type(core_expr_type(expr))


private pure func channel_element_type(typ: CoreType) -> Option[CoreType]:
	TypeLayout.channel_element_type(typ)


private pure func discard_expr_body(expr: CoreExpr, body: FunctionBodyC) -> String:
	if body.value == "":
		body.statements
	else if type_requires_release(core_expr_type(expr)):
		body.statements + "  blorp_release(" + body.value + ");\n"
	else:
		discard_body(body)


private pure func consume_discard_expr_body(expr: CoreExpr, body: FunctionBodyC) -> String:
	if body.value == "":
		body.statements
	else:
		release_statement: String = emit_release_statement(
			body.value,
			cleanup_release_policy_for_type(core_expr_type(expr)),
		)

		if release_statement == "":
			discard_body(body)
		else:
			body.statements + release_statement


private pure func scoped_discard_expr_body(expr: CoreExpr, body: FunctionBodyC) -> String:
	discarded: String = discard_expr_body(expr, body)

	if discarded == "":
		""
	else:
		"  {\n" + indent_statements(discarded) + "  }\n"


private pure func statement_body(expr: CoreExpr, body: FunctionBodyC) -> String:
	if is_void_expr(expr):
		body.statements
	else:
		discard_expr_body(expr, body)


private pure func required_body_value(body: FunctionBodyC) -> Option[String]:
	if body.value == "":
		None
	else:
		Some(body.value)


private pure func statement_expression(statements: String, value: String) -> String:
	"({\n" + indent_statements(statements) + "  " + value + ";\n})"


private pure func emit_condition(cond: CoreExpr, next_temp: Int) -> Option[ConditionC]:
	match emit_simple_expr(cond):
		Some(cond_c):
			Some({
				statements = "",
				value = cond_c,
				next_temp = next_temp,
			})
		None:
			cond_body ?= emit_function_body(cond, next_temp)
			cond_value ?= required_body_value(cond_body)
			cond_temp: String = temp_name("cond", cond_body.next_temp)
			Some({
				statements = cond_body.statements + "  bool " + cond_temp + " = " + cond_value + ";\n",
				value = cond_temp,
				next_temp = cond_body.next_temp + 1,
			})


private pure func indent_statements(statements: String) -> String:
	if statements == "":
		""
	else:
		var result: String = ""

		for line in statements.split("\n"):
			if line.length() > 0:
				result += "  " + line + "\n"

		result


private pure func temp_name(prefix: String, index: Int) -> String:
	"__" + prefix + "_" + index.to_string()


private pure func core_vars_equal(left: CoreVar, right: CoreVar) -> Bool:
	left.name == right.name and left.uniq == right.uniq and left.def_id == right.def_id


private pure func emit_temp_value_body(
	prefix: String,
	value_type: CoreType,
	statements: String,
	value: String,
	next_temp: Int,
) -> FunctionBodyC:
	temp: String = temp_name(prefix, next_temp)
	{
		statements = statements + "  " + c_type_name(
			value_type,
		) + " " + temp + " = " + value + ";\n",
		value = temp,
		next_temp = next_temp + 1,
		returns = False
	}


private pure func emit_scoped_operand_body(
	prefix: String,
	expr: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	body ?= emit_function_body(expr, next_temp)
	value ?= required_body_value(body)

	if body.statements == "":
		Some(body)
	else:
		Some(
			emit_temp_value_body(
				prefix,
				core_expr_type(expr),
				"",
				statement_expression(body.statements, value),
				body.next_temp,
			),
		)


private pure func emit_binary_body(
	op: CoreBinaryOp,
	left: CoreExpr,
	right: CoreExpr,
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	left_c ?= emit_scoped_operand_body("bin_left", left, next_temp)
	left_value ?= required_body_value(left_c)
	right_c ?= emit_scoped_operand_body("bin_right", right, left_c.next_temp)
	right_value ?= required_body_value(right_c)
	value ?= c_binary_expr(op, left, right, left_value, right_value)

	Some(
		emit_temp_value_body(
			"bin_result",
			typ,
			left_c.statements + right_c.statements,
			value,
			right_c.next_temp,
		),
	)


private pure func emit_unary_body(
	op: CoreUnaryOp,
	expr_value: CoreExpr,
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	expr_c ?= emit_function_body(expr_value, next_temp)
	value ?= required_body_value(expr_c)

	Some(
		emit_temp_value_body(
			"unary_result",
			typ,
			expr_c.statements,
			c_unary_expr(op, expr_value, value),
			expr_c.next_temp,
		),
	)


private pure func emit_cast_body(
	expr_value: CoreExpr,
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	expr_c ?= emit_function_body(expr_value, next_temp)
	value ?= required_body_value(expr_c)

	Some(
		emit_temp_value_body(
			"cast_result",
			typ,
			expr_c.statements,
			"((" + c_type_name(typ) + ")" + value + ")",
			expr_c.next_temp,
		),
	)


private pure func emit_logical_body(
	op: CoreLogicalOp,
	left: CoreExpr,
	right: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	left_c ?= emit_condition(left, next_temp)
	result_name: String = temp_name("logical_result", left_c.next_temp)
	right_c ?= emit_condition(right, left_c.next_temp + 1)
	var statements: String = left_c.statements + "  int " + result_name + ";\n"

	match op:
		AndOp:
			statements += "  if (" + left_c.value + ") {\n" + indent_statements(
				right_c.statements + "  " + result_name + " = " + right_c.value + ";\n",
			) + "  } else {\n    " + result_name + " = 0;\n  }\n"
		OrOp:
			statements += "  if (" + left_c.value + ") {\n    " + result_name + " = 1;\n  } else {\n" + indent_statements(
				right_c.statements + "  " + result_name + " = " + right_c.value + ";\n",
			) + "  }\n"

	Some({
		statements = statements,
		value = result_name,
		next_temp = right_c.next_temp,
		returns = False,
	})


private pure func cancellation_cleanup_pop_statement(variable: CoreVar) -> String:
	"  blorp_task_cleanup_pop_slot(&" + c_var_name(variable) + ");\n"


private pure func cleanup_frame_name(variable: CoreVar) -> String:
	"__blorp_cleanup_" + c_var_name(variable)


private pure func cleanup_release_fn(kind: CoreCallKind) -> Option[String]:
	match kind:
		UnknownCall | DeferredTraitCall(_, _) | SelectedTraitCall(_, _, _, _):
			None
		SelectedDirectCall(def_id):
			None
		UserCall(name, def_id, consumed_args):
			Some(c_identifier(name))
		BuiltinCall(name):
			Some(name)
		DirectRuntimeCall(call):
			Some(call.name)
		TensorParallelCall(name, layout):
			Some(name)
		DictWithCapacityCall(constructor):
			None
		ForeignCall(name, arg_passing):
			Some(name)
		IntrinsicCall(name):
			None
		OperationResultCall(bridge):
			None
		FallibleStreamTerminalCall(bridge):
			None
		ListToStringCall(callback_name):
			None
		ClosureCall:
			None


private pure func resource_cleanup_hook(cleanup: CoreExpr) -> Option[ResourceCleanupHook]:
	match cleanup:
		CallExpr(kind, callee, args, typ, loc):
			resource_cleanup_hook_for_args(kind, args)
		LiteralExpr(literal, typ, loc):
			None
		VarExpr(variable, typ, loc):
			None
		VoidExpr(typ, loc):
			None
		DebugBlockExpr(body, typ, loc):
			None
		CooperativeCheckpointExpr(typ, loc):
			None
		RawMatchExpr(scrutinee, cases, typ, loc):
			None
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			None
		BinaryExpr(op, left, right, typ, loc):
			None
		UnaryExpr(op, expr_value, typ, loc):
			None
		LogicalExpr(op, left, right, typ, loc):
			None
		AssignExpr(variable, rhs, typ, loc):
			None
		CastExpr(expr_value, typ, loc):
			None
		BoxExpr(box, typ, loc):
			None
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			None
		FieldExpr(expr_value, field_name, typ, loc):
			None
		TupleFieldExpr(expr_value, field_index, typ, loc):
			None
		TupleExpr(items, typ, loc):
			None
		TupleConstructExpr(tuple_construct, typ, loc):
			None
		VectorExpr(items, typ, loc):
			None
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			None
		ClosureCreateExpr(closure, typ, loc):
			None
		ListConstructExpr(construct, typ, loc):
			None
		ListAllocExpr(alloc, typ, loc):
			None
		ListGetExpr(get, typ, loc):
			None
		ListHandoffExpr(handoff, typ, loc):
			None
		ListHandoffSetOwnedExpr(set, typ, loc):
			None
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			None
		StringByteReadExpr(read, typ, loc):
			None
		StringByteWriteExpr(write, typ, loc):
			None
		StringByteCopyExpr(copy, typ, loc):
			None
		StringSetLenExpr(set_len, typ, loc):
			None
		TensorLiteralExpr(literal, typ, loc):
			None
		TensorBoxedLiteralExpr(literal, typ, loc):
			None
		TensorPackedLiteralExpr(literal, typ, loc):
			None
		TensorRawFillExpr(fill, typ, loc):
			None
		TensorRawReadExpr(read, typ, loc):
			None
		TensorRawWriteExpr(write, typ, loc):
			None
		TensorRawViewLetExpr(binding, body, typ, loc):
			None
		DictExpr(entries, typ, loc):
			None
		DictConstructExpr(construct, typ, loc):
			None
		SetAllocExpr(alloc, typ, loc):
			None
		ListRetainExpr(retain, typ, loc):
			None
		ListSetExpr(set, typ, loc):
			None
		ListSwapExpr(swap, typ, loc):
			None
		RecordExpr(fields, typ, loc):
			None
		RecordUpdateExpr(base, fields, typ, loc):
			None
		RecordReuseExpr(source, fields, typ, loc):
			None
		RecordConstructExpr(type_name, fields, typ, loc):
			None
		UnionConstructExpr(construct, typ, loc):
			None
		UnionReuseConstructExpr(construct, typ, loc):
			None
		PreClosureDetachExpr(detached, typ, loc):
			None
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			None
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			None
		LetExpr(name, is_mutable, typ, rhs, body):
			None
		BorrowLetExpr(name, typ, rhs, body):
			None
		SeqExpr(first, second):
			None
		WhileExpr(cond, body, typ, loc):
			None
		BreakExpr(typ, loc):
			None
		ContinueExpr(typ, loc):
			None
		ResourceScopeExpr(scope, typ, loc):
			None
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			None
		TailrecLoopExpr(params, return_type, body, loc):
			None
		TailrecRecurExpr(args, typ, loc):
			None
		TailrecListSpreadLoopExpr(loop, loc):
			None
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			None
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			None
		ForChannelExpr(for_channel, typ, loc):
			None
		ForListExpr(for_list, typ, loc):
			None
		ForStringExpr(for_string, typ, loc):
			None
		ForDictExpr(for_dict, typ, loc):
			None
		ForSetExpr(for_set, typ, loc):
			None
		ForResourceSourceExpr(for_resource_source, typ, loc):
			None
		ForStreamExpr(for_stream, typ, loc):
			None
		ForTensorExpr(for_tensor, typ, loc):
			None
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			None
		DetachExpr(detached, typ, loc):
			None
		ConcurrentlyLoopExpr(loop, typ, loc):
			None
		PreClosureConcurrentExpr(block, typ, loc):
			None
		ConcurrentExpr(block, typ, loc):
			None
		SelectExpr(select_expr, typ, loc):
			None
		RangeExpr(start, end_value, typ, loc):
			None
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			None
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			None
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			None
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, fallback, typ, loc):
