private pure func directly_returns_var(expr: CoreExpr, variable: CoreVar) -> Bool:
	match expr:
		RawMatchExpr(scrutinee, cases, typ, loc):
			False
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			False
		VarExpr(returned, typ, loc):
			core_vars_equal(returned, variable)
		LiteralExpr(literal, typ, loc):
			False
		VoidExpr(typ, loc):
			False
		DebugBlockExpr(body, typ, loc):
			False
		CooperativeCheckpointExpr(typ, loc):
			False
		CallExpr(kind, callee, args, typ, loc):
			False
		BinaryExpr(op, left, right, typ, loc):
			False
		UnaryExpr(op, expr_value, typ, loc):
			False
		LogicalExpr(op, left, right, typ, loc):
			False
		AssignExpr(assign_var, rhs, typ, loc):
			False
		CastExpr(expr_value, typ, loc):
			False
		BoxExpr(box, typ, loc):
			False
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			False
		FieldExpr(expr_value, field_name, typ, loc):
			False
		TupleFieldExpr(expr_value, field_index, typ, loc):
			False
		TupleExpr(items, typ, loc):
			False
		TupleConstructExpr(tuple_construct, typ, loc):
			False
		VectorExpr(items, typ, loc):
			False
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			False
		ClosureCreateExpr(closure, typ, loc):
			False
		ListConstructExpr(construct, typ, loc):
			False
		ListAllocExpr(alloc, typ, loc):
			False
		ListGetExpr(get, typ, loc):
			False
		ListHandoffExpr(handoff, typ, loc):
			False
		ListHandoffSetOwnedExpr(set, typ, loc):
			False
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			False
		ListRetainExpr(retain, typ, loc):
			False
		ListSetExpr(set, typ, loc):
			False
		ListSwapExpr(swap, typ, loc):
			False
		StringByteReadExpr(read, typ, loc):
			False
		StringByteWriteExpr(write, typ, loc):
			False
		StringByteCopyExpr(copy, typ, loc):
			False
		StringSetLenExpr(set_len, typ, loc):
			False
		TensorLiteralExpr(literal, typ, loc):
			False
		TensorBoxedLiteralExpr(literal, typ, loc):
			False
		TensorPackedLiteralExpr(literal, typ, loc):
			False
		TensorRawFillExpr(fill, typ, loc):
			False
		TensorRawReadExpr(read, typ, loc):
			False
		TensorRawWriteExpr(write, typ, loc):
			False
		TensorRawViewLetExpr(binding, body, typ, loc):
			False
		DictConstructExpr(construct, typ, loc):
			False
		DictExpr(entries, typ, loc):
			False
		SetAllocExpr(alloc, typ, loc):
			False
		RecordExpr(fields, typ, loc):
			False
		RecordUpdateExpr(base, fields, typ, loc):
			False
		RecordReuseExpr(source, fields, typ, loc):
			False
		RecordConstructExpr(type_name, fields, typ, loc):
			False
		UnionConstructExpr(construct, typ, loc):
			False
		UnionReuseConstructExpr(construct, typ, loc):
			False
		DupExpr(dup_var, value_type, retain_policy, body, typ, loc):
			directly_returns_var(body, variable)
		DropExpr(drop_var, value_type, release_policy, body, typ, loc):
			directly_returns_var(body, variable)
		LetExpr(name, is_mutable, typ, rhs, body):
			False
		BorrowLetExpr(name, typ, rhs, body):
			False
		SeqExpr(first, second):
			transfer_prefix_is_non_suspending(first) and directly_returns_var(second, variable)
		WhileExpr(cond, body, typ, loc):
			False
		BreakExpr(typ, loc):
			False
		ContinueExpr(typ, loc):
			False
		ResourceScopeExpr(scope, typ, loc):
			False
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			False
		TailrecLoopExpr(params, return_type, body, loc):
			False
		TailrecRecurExpr(args, typ, loc):
			False
		TailrecListSpreadLoopExpr(loop, loc):
			False
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			False
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			False
		ForChannelExpr(for_channel, typ, loc):
			False
		ForListExpr(for_list, typ, loc):
			False
		ForStringExpr(for_string, typ, loc):
			False
		ForDictExpr(for_dict, typ, loc):
			False
		ForSetExpr(for_set, typ, loc):
			False
		ForResourceSourceExpr(for_resource_source, typ, loc):
			False
		ForStreamExpr(for_stream, typ, loc):
			False
		ForTensorExpr(for_tensor, typ, loc):
			False
		PreClosureDetachExpr(detached, typ, loc):
			False
		DetachExpr(detached, typ, loc):
			False
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			False
		ConcurrentlyLoopExpr(loop, typ, loc):
			False
		PreClosureConcurrentExpr(block, typ, loc):
			False
		ConcurrentExpr(block, typ, loc):
			False
		SelectExpr(select_expr, typ, loc):
			False
		RangeExpr(start, end_value, typ, loc):
			False
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			False
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			False
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			False
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, fallback, typ, loc):
			False
		IfExpr(cond, then_expr, else_expr, typ, loc):
			False


private pure func emit_dup_statement(variable: CoreVar, retain_policy: CoreRetainPolicy) -> String:
	match retain_policy:
		NoRetainPolicy:
			""
		ArcRetainPolicy:
			"  blorp_retain(" + c_var_name(variable) + ");\n"
		StackResultRetainPolicy:
			"  blorp_stack_result_retain(" + c_var_name(variable) + ");\n"


private pure func statement_expr(statement: String, value: String) -> String:
	if statement.length() == 0:
		value
	else:
		"({ " + statement + " " + value + "; })"


private pure func emit_simple_expr(expr: CoreExpr) -> Option[String]:
	match expr:
		RawMatchExpr(scrutinee, cases, typ, loc):
			None
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			None
		LiteralExpr(literal, typ, loc):
			emit_literal_expr(literal)
		VarExpr(variable, typ, loc):
			if variable.name == "None":
				stack_option_none_expr_for_type(typ)
			else:
				Some(c_var_name(variable))
		VoidExpr(typ, loc):
			Some("(void)0")
		DebugBlockExpr(body, typ, loc):
			None
		CooperativeCheckpointExpr(typ, loc):
			None
		CallExpr(kind, callee, args, typ, loc):
			if call_transfer_cleanup_pop_statements(kind, args) != "":
				None
			else:
				match kind:
					IntrinsicCall(name):
						match emit_raw_scalar_tensor_get_unchecked(name, args, typ):
							Some(rendered):
								Some(rendered)
							None:
								match emit_value_record_tensor_get_unchecked(name, args, typ):
									Some(rendered):
										Some(rendered)
									None:
										emit_intrinsic_call(name, args)
					UserCall(name, def_id, consumed_args):
						if name == "Some" or name == "None":
							None
						else:
							args_c ?= emit_simple_expr_args(args)
							Some(c_identifier(name) + "(" + args_c + ")")
					ForeignCall(name, arg_passing):
						None
					ListToStringCall(callback_name):
						arg_values ?= emit_simple_expr_arg_values(args)
						emit_call_value_from_args(kind, arg_values, typ)
					BuiltinCall(name):
						match emit_tensor_fill_packed_call(name, args):
							Some(rendered):
								Some(rendered)
							None:
								match emit_tensor_fill_inline_struct_call(name, args):
									Some(rendered):
										Some(rendered)
									None:
										match emit_boxed_tensor_fill_call(name, args):
											Some(rendered):
												Some(rendered)
											None:
												match emit_boxed_tensor_set_call(name, args, typ):
													Some(rendered):
														Some(rendered)
													None:
														arg_values ?= emit_simple_expr_arg_values(
															args,
														)

														match emit_direct_nonboxed_tensor_call_from_values(
															name,
															args,
															arg_values,
															typ,
														):
															Some(rendered):
																Some(rendered)
															None:
																match emit_ranked_tensor_checked_get_call_from_values(
																	name,
																	args,
																	arg_values,
																):
																	Some(rendered):
																		Some(rendered)
																	None:
																		if (
																			name == "blorp_vector_new_fill"
																			or name == "blorp_matrix_new_fill"
																			or name == "blorp_vector_new_fill_packed"
																			or name == "blorp_matrix_new_fill_packed"
																			or name == "blorp_checked_set"
																			or name == "blorp_matrix_checked_set"
																			or is_ranked_tensor_checked_get_name(
																				name,
																			)
																		):
																			None
																		else:
																			match emit_channel_send_call_with_retained_temp(
																				name,
																				arg_values,
																				args,
																				typ,
																			):
																				Some(rendered):
																					Some(rendered)
																				None:
																					emit_call_value_from_args(
																						kind,
																						arg_values,
																						typ,
																					)
					DirectRuntimeCall(call):
						match emit_typed_direct_tensor_call(call, args, typ):
							Some(rendered):
								Some(rendered)
							None:
								arg_values ?= emit_simple_expr_arg_values(args)

								match emit_direct_runtime_tensor_call_from_values(
									call,
									args,
									arg_values,
									typ,
								):
									Some(rendered):
										Some(rendered)
									None:
										emit_call_value_from_args(kind, arg_values, typ)
					TensorParallelCall(name, layout):
						arg_values ?= emit_simple_expr_arg_values(args)
						emit_call_value_from_args(kind, arg_values, typ)
					DictWithCapacityCall(constructor):
						arg_values ?= emit_simple_expr_arg_values(args)
						emit_call_value_from_args(kind, arg_values, typ)
					OperationResultCall(bridge):
						None
					FallibleStreamTerminalCall(bridge):
						None
					ListToStringCall(callback_name):
						arg_values ?= emit_simple_expr_arg_values(args)
						emit_call_value_from_args(kind, arg_values, typ)
					ClosureCall:
						emit_closure_call(callee, args, typ)
					UnknownCall | DeferredTraitCall(_, _) | SelectedTraitCall(_, _, _, _):
						None
					SelectedDirectCall(def_id):
						None
		BinaryExpr(op, left, right, typ, loc):
			left_c ?= emit_simple_expr(left)
			right_c ?= emit_simple_expr(right)
			c_binary_expr(op, left, right, left_c, right_c)
		UnaryExpr(op, expr_value, typ, loc):
			expr_c ?= emit_simple_expr(expr_value)
			Some(c_unary_expr(op, expr_value, expr_c))
		LogicalExpr(op, left, right, typ, loc):
			left_c ?= emit_simple_expr(left)
			right_c ?= emit_simple_expr(right)
			Some("(" + left_c + " " + c_logical_operator(op) + " " + right_c + ")")
		AssignExpr(variable, rhs, typ, loc):
			None
		CastExpr(expr_value, typ, loc):
			if expr_transfers_ownership(expr):
				None
			else:
				expr_c ?= emit_simple_expr(expr_value)
				Some("((" + c_type_name(typ) + ")" + expr_c + ")")
		BoxExpr(box, typ, loc):
			emit_box_expr(box)
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			emit_unbox_expr(unbox_kind, expr_value, typ)
		FieldExpr(expr_value, field_name, typ, loc):
			emit_field_access(expr_value, field_name)
		TupleFieldExpr(expr_value, field_index, typ, loc):
			emit_tuple_field_access(expr_value, field_index, typ)
		TupleExpr(items, typ, loc):
			None
		TupleConstructExpr(tuple_construct, typ, loc):
			emit_tuple_construct(tuple_construct)
		VectorExpr(items, typ, loc):
			None
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			None
		ClosureCreateExpr(closure, typ, loc):
			emit_closure_create(closure)
		ListConstructExpr(construct, typ, loc):
			emit_list_construct(construct)
		ListAllocExpr(alloc, typ, loc):
			emit_list_alloc(alloc)
		ListGetExpr(get, typ, loc):
			emit_list_get(get)
		ListHandoffExpr(handoff, typ, loc):
			emit_list_handoff(handoff)
		ListHandoffSetOwnedExpr(set, typ, loc):
			emit_list_handoff_set_owned(set)
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			emit_list_handoff_set_source_slot(slot)
		StringByteReadExpr(read, typ, loc):
			emit_string_byte_read(read)
		StringByteWriteExpr(write, typ, loc):
			emit_string_byte_write(write)
		StringByteCopyExpr(copy, typ, loc):
			emit_string_byte_copy(copy)
		StringSetLenExpr(set_len, typ, loc):
			emit_string_set_len(set_len)
		TensorLiteralExpr(literal, typ, loc):
			None
		TensorBoxedLiteralExpr(literal, typ, loc):
			None
		TensorPackedLiteralExpr(literal, typ, loc):
			None
		TensorRawFillExpr(fill, typ, loc):
			None
		TensorRawReadExpr(read, typ, loc):
			emit_tensor_raw_read(read)
		TensorRawWriteExpr(write, typ, loc):
			emit_tensor_raw_write(write)
		TensorRawViewLetExpr(binding, body, typ, loc):
			decl ?= tensor_raw_view_decl(binding)
			body_c ?= emit_simple_expr(body)
			Some(statement_expr(decl + ";", body_c))
		DictConstructExpr(construct, typ, loc):
			emit_dict_construct(construct)
		DictExpr(entries, typ, loc):
			None
		SetAllocExpr(alloc, typ, loc):
			emit_set_alloc(alloc)
		ListRetainExpr(retain, typ, loc):
			emit_list_retain(retain)
		ListSetExpr(set, typ, loc):
			emit_list_set(set)
		ListSwapExpr(swap, typ, loc):
			emit_list_swap(swap)
		RecordExpr(fields, typ, loc):
			None
		RecordUpdateExpr(base, fields, typ, loc):
			None
		RecordReuseExpr(source, fields, typ, loc):
			None
		RecordConstructExpr(type_name, fields, typ, loc):
			emit_record_construct(type_name, fields)
		UnionConstructExpr(construct, typ, loc):
			emit_union_construct(construct)
		UnionReuseConstructExpr(construct, typ, loc):
			emit_union_reuse_construct(construct)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			body_c ?= emit_simple_expr(body)
			Some(statement_expr(emit_dup_statement(variable, retain_policy), body_c))
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			body_c ?= emit_simple_expr(body)
			Some(statement_expr(emit_drop_statement(variable, release_policy), body_c))
		LetExpr(name, is_mutable, typ, rhs, body):
			None
		BorrowLetExpr(name, typ, rhs, body):
			None
		SeqExpr(first, second):
			None
		WhileExpr(cond, body, typ, loc):
			None
		BreakExpr(typ, loc):
			None
		ContinueExpr(typ, loc):
			None
		ResourceScopeExpr(scope, typ, loc):
			None
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			None
		TailrecLoopExpr(params, return_type, body, loc):
			None
		TailrecRecurExpr(args, typ, loc):
			None
		TailrecListSpreadLoopExpr(loop, loc):
			None
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			None
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			None
		ForChannelExpr(for_channel, typ, loc):
			None
		ForListExpr(for_list, typ, loc):
			None
		ForStringExpr(for_string, typ, loc):
			None
		ForDictExpr(for_dict, typ, loc):
			None
		ForSetExpr(for_set, typ, loc):
			None
		ForResourceSourceExpr(for_resource_source, typ, loc):
			None
		ForStreamExpr(for_stream, typ, loc):
			None
		ForTensorExpr(for_tensor, typ, loc):
			None
		PreClosureDetachExpr(detached, typ, loc):
			None
		DetachExpr(detached, typ, loc):
			None
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			None
		ConcurrentlyLoopExpr(loop, typ, loc):
			None
		PreClosureConcurrentExpr(block, typ, loc):
			None
		ConcurrentExpr(block, typ, loc):
			None
		SelectExpr(select_expr, typ, loc):
			None
		RangeExpr(start, end_value, typ, loc):
			start_c ?= emit_simple_expr(start)
			end_c ?= emit_simple_expr(end_value)
			Some("({ Range __range_value = { " + start_c + ", " + end_c + " }; __range_value; })")
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			None
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			None
		LiteralMatchExpr(scrutinee, cases, default_body, typ, loc):
			None
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, default_body, typ, loc):
			None
		IfExpr(cond, then_expr, else_expr, typ, loc):
			cond_c ?= emit_simple_expr(cond)
			then_c ?= emit_simple_expr(then_expr)
			else_c ?= emit_simple_expr(else_expr)
			Some("(" + cond_c + " ? " + then_c + " : " + else_c + ")")


private pure func terminal_body(statements: String, next_temp: Int) -> FunctionBodyC:
	{
		statements = statements,
		value = "",
		next_temp = next_temp,
		returns = True
	}


private pure func emit_tailrec_recur(
	params: List[CoreParam],
	args: List[CoreExpr],
	next_temp: Int,
) -> Option[FunctionBodyC]:
	if params.length() != args.length():
		None
	else:
		var declarations: String = ""
		var assignments: String = ""
		var index: Int = 0
		var temp_index: Int = next_temp
		var failed: Bool = False

		for arg in args:
			if not failed:
				match params.get(index):
					Some(param):
						match emit_simple_expr(arg):
							Some(arg_c):
								temp: String = temp_name(
									"tailrec_arg_" + index.to_string(),
									temp_index,
								)

								declarations += "  " + c_type_name(
									param.typ,
								) + " " + temp + " = " + arg_c + ";\n"
								assignments += "  " + c_var_name(param.name) + " = " + temp + ";\n"
								index += 1
								temp_index += 1
							None:
								failed = True
								break
					None:
						failed = True
						break

		if failed:
			None
		else:
			Some(terminal_body(declarations + assignments + "  continue;\n", temp_index))


private pure func emit_tailrec_tail(
	params: List[CoreParam],
	return_type: CoreType,
	expr: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match expr:
		RawMatchExpr(scrutinee, cases, typ, loc):
			None
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			None
		TailrecRecurExpr(args, typ, loc):
			emit_tailrec_recur(params, args, next_temp)
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			None
		LetExpr(name, is_mutable, typ, rhs, body):
			if is_void_type(typ):
				rhs_c ?= emit_function_body(rhs, next_temp)
				body_c ?= emit_tailrec_tail(params, return_type, body, rhs_c.next_temp)
				Some(
					terminal_body(
						scoped_discard_expr_body(rhs, rhs_c) + body_c.statements,
						body_c.next_temp,
					),
				)
			else if name.name == "_":
				rhs_c ?= emit_function_body(rhs, next_temp)
				body_c ?= emit_tailrec_tail(params, return_type, body, rhs_c.next_temp)
				Some(
					terminal_body(
						scoped_discard_expr_body(rhs, rhs_c) + body_c.statements,
						body_c.next_temp,
					),
				)
			else:
				rhs_c ?= emit_simple_expr(rhs)
				body_c ?= emit_tailrec_tail(params, return_type, body, next_temp)
				Some(
					terminal_body(
						"  " + c_type_name(
							typ,
						) + " " + c_var_name(name) + " = " + rhs_c + ";\n" + body_c.statements,
						body_c.next_temp,
					),
				)
		BorrowLetExpr(name, typ, rhs, body):
			if is_void_type(typ):
				rhs_c ?= emit_function_body(rhs, next_temp)
				body_c ?= emit_tailrec_tail(params, return_type, body, rhs_c.next_temp)
				Some(
					terminal_body(
						scoped_discard_expr_body(rhs, rhs_c) + body_c.statements,
						body_c.next_temp,
					),
				)
			else if name.name == "_":
				rhs_c ?= emit_function_body(rhs, next_temp)
				body_c ?= emit_tailrec_tail(params, return_type, body, rhs_c.next_temp)
				Some(
					terminal_body(
						scoped_discard_expr_body(rhs, rhs_c) + body_c.statements,
						body_c.next_temp,
					),
				)
			else:
				rhs_c ?= emit_simple_expr(rhs)
				body_c ?= emit_tailrec_tail(params, return_type, body, next_temp)
				Some(
					terminal_body(
						"  " + c_type_name(
							typ,
						) + " " + c_var_name(name) + " = " + rhs_c + ";\n" + body_c.statements,
						body_c.next_temp,
					),
				)
		SeqExpr(first, second):
			first_c ?= emit_function_body(first, next_temp)
			second_c ?= emit_tailrec_tail(params, return_type, second, first_c.next_temp)
			Some(
				terminal_body(
					scoped_discard_expr_body(first, first_c) + second_c.statements,
					second_c.next_temp,
				),
			)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			cond_c ?= emit_simple_expr(cond)
			then_c ?= emit_tailrec_tail(params, return_type, then_expr, next_temp)
			else_c ?= emit_tailrec_tail(params, return_type, else_expr, then_c.next_temp)
			Some(
				terminal_body(
					"  if (" + cond_c + ") {\n" + indent_statements(
						then_c.statements,
					) + "  } else {\n" + indent_statements(else_c.statements) + "  }\n",
					else_c.next_temp,
				),
			)
		LiteralExpr(literal, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		VarExpr(variable, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		VoidExpr(typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		DebugBlockExpr(body, typ, loc):
			None
		CooperativeCheckpointExpr(typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		CallExpr(kind, callee, args, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		BinaryExpr(op, left, right, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		UnaryExpr(op, expr_value, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		LogicalExpr(op, left, right, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		AssignExpr(variable, rhs, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		CastExpr(expr_value, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		BoxExpr(box, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		FieldExpr(expr_value, field_name, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		TupleFieldExpr(expr_value, field_index, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		TupleExpr(items, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		TupleConstructExpr(tuple_construct, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		VectorExpr(items, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			None
		ClosureCreateExpr(closure, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ListConstructExpr(construct, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ListAllocExpr(alloc, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ListGetExpr(get, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ListHandoffExpr(handoff, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ListHandoffSetOwnedExpr(set, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		StringByteReadExpr(read, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		StringByteWriteExpr(write, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		StringByteCopyExpr(copy, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		StringSetLenExpr(set_len, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		TensorLiteralExpr(literal, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		TensorBoxedLiteralExpr(literal, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		TensorPackedLiteralExpr(literal, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		TensorRawFillExpr(fill, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		TensorRawReadExpr(read, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		TensorRawWriteExpr(write, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		TensorRawViewLetExpr(binding, body, typ, loc):
			decl ?= tensor_raw_view_decl(binding)
			body_c ?= emit_tailrec_tail(params, return_type, body, next_temp)
			Some(terminal_body("  " + decl + ";\n" + body_c.statements, body_c.next_temp))
		DictConstructExpr(construct, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		DictExpr(entries, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		SetAllocExpr(alloc, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ListRetainExpr(retain, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ListSetExpr(set, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ListSwapExpr(swap, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		RecordExpr(fields, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		RecordUpdateExpr(base, fields, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		RecordReuseExpr(source, fields, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		RecordConstructExpr(type_name, fields, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		UnionConstructExpr(construct, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		UnionReuseConstructExpr(construct, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			retain_statement: String = emit_dup_statement(variable, retain_policy)
			body_c ?= emit_tailrec_tail(params, return_type, body, next_temp)
			Some(terminal_body(retain_statement + body_c.statements, body_c.next_temp))
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			drop_statement: String = emit_drop_statement(variable, release_policy)
			body_c ?= emit_tailrec_tail(params, return_type, body, next_temp)
			Some(terminal_body(drop_statement + body_c.statements, body_c.next_temp))
		WhileExpr(cond, body, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		BreakExpr(typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ContinueExpr(typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ResourceScopeExpr(scope, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		TailrecLoopExpr(loop_params, loop_return_type, body, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		TailrecListSpreadLoopExpr(loop, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			None
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ForChannelExpr(for_channel, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ForListExpr(for_list, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ForStringExpr(for_string, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ForDictExpr(for_dict, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ForSetExpr(for_set, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ForResourceSourceExpr(for_resource_source, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ForStreamExpr(for_stream, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		ForTensorExpr(for_tensor, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		PreClosureDetachExpr(detached, typ, loc):
			None
		DetachExpr(detached, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			None
		ConcurrentlyLoopExpr(loop, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		PreClosureConcurrentExpr(block, typ, loc):
			None
		ConcurrentExpr(block, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		SelectExpr(select_expr, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		RangeExpr(start, end_value, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)
		LiteralMatchExpr(scrutinee, cases, default_body, typ, loc):
			emit_tailrec_literal_match(
				params,
				return_type,
				scrutinee,
				cases,
				default_body,
				next_temp,
			)
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, default_body, typ, loc):
			emit_tailrec_return(return_type, expr, next_temp)


private pure func emit_tailrec_return(
	return_type: CoreType,
	expr: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	body_c ?= emit_function_body(expr, next_temp)

	if is_void_type(return_type):
		Some(terminal_body(discard_expr_body(expr, body_c) + "  return;\n", body_c.next_temp))
	else:
		return_value ?= required_body_value(body_c)
		Some(
			terminal_body(
				body_c.statements + "  return " + return_value + ";\n",
				body_c.next_temp,
			),
		)


private pure func emit_tailrec_loop(
	params: List[CoreParam],
	return_type: CoreType,
	body: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	body_c ?= emit_tailrec_tail(params, return_type, body, next_temp)
	Some(
		terminal_body(
			"  while (1) {\n" + indent_statements(body_c.statements) + "  }\n",
			body_c.next_temp,
		),
	)


private pure func tailrec_cursor_index_expr(cursor_name: String, offset: Int) -> String:
	if offset == 0:
		cursor_name
	else:
		"(" + cursor_name + " + " + offset.to_string() + "L)"


private pure func tailrec_match_binding_binder(binding: CoreMatchBinding) -> CoreLoopBinder:
	{
		variable = binding.variable,
		typ = binding.typ,
		range_direction = RangeForwardOnly
	}


private pure func tailrec_inline_scalar_list_binding(
	binding: CoreMatchBinding,
	list_name: String,
	index_expr: String,
	width_bytes: Int,
	next_temp: Int,
) -> Option[TailrecBindingC]:
	match binding.mode:
		MatchBorrowBindingMode:
			binding_name: String = c_var_name(binding.variable)
			bits_tmp: String = temp_name("tailrec_bits", next_temp)
			load_args: InlineBitsLoadArgs = {
				list_tmp = "((blorp_List*)" + list_name + ")",
				index_tmp = index_expr,
				bits_tmp = bits_tmp,
				width_bytes = width_bytes.to_string()
			}
			value ?= boxed_storage_value_source("(void*)" + bits_tmp, binding.typ)

			Some({
				statements = render_prepared_list_op(
					InlineBitsLoad(
						load_args,
					),
				) + "\n" + c_type_name(binding.typ) + " " + binding_name + " = " + value + ";\n",
				next_temp = next_temp + 1,
			})
		MatchOwnBindingMode:
			None


private pure func tailrec_list_element_binding(
	loop: CoreTailrecListSpreadLoop,
	binding: CoreMatchBinding,
	index_offset: Int,
	next_temp: Int,
) -> Option[TailrecBindingC]:
	list_name: String = c_var_name(loop.list_param.name)
	index_expr: String = tailrec_cursor_index_expr(c_var_name(loop.cursor), index_offset)
	binder: CoreLoopBinder = tailrec_match_binding_binder(binding)

	match loop.layout:
		PointerListStorage:
			statement ?= pointer_list_loop_binding(
				binder,
				"((blorp_List*)" + list_name + ")",
				index_expr,
			)
			Some({
				statements = statement,
				next_temp = next_temp,
			})
		InlineListStorage(width_bytes):
			tailrec_inline_scalar_list_binding(
				binding,
				list_name,
				index_expr,
				width_bytes,
				next_temp,
			)
		InlineStructListStorage(c_type):
			Some({
				statements = inline_struct_list_loop_binding(
					binder,
					"((blorp_List*)" + list_name + ")",
					index_expr,
					next_temp.to_string(),
					c_type,
				),
				next_temp = next_temp + 1,
			})


private pure func tailrec_list_spread_binding(
	loop: CoreTailrecListSpreadLoop,
	binding: CoreMatchBinding,
	offset: Int,
	next_temp: Int,
) -> Option[TailrecBindingC]:
	list_name: String = c_var_name(loop.list_param.name)
	index_expr: String = tailrec_cursor_index_expr(c_var_name(loop.cursor), offset)
	raw_source: String = "blorp_list_drop((blorp_List*)" + list_name + ", " + index_expr + ")"
	source ?= match_accessor_value_source(raw_source, binding.accessor, binding.typ)

	Some({
		statements = emit_match_binding_declaration(binding, source),
		next_temp = next_temp,
	})


private pure func emit_tailrec_list_binding(
	loop: CoreTailrecListSpreadLoop,
	binding: CoreMatchBinding,
	skip_root_spread: Bool,
	next_temp: Int,
) -> Option[TailrecBindingC]:
	match binding.accessor:
		ListElementAccessor(parent, index):
			match parent:
				RootAccessor:
					tailrec_list_element_binding(loop, binding, index, next_temp)
				VariantFieldAccessor(parent_parent, union_c_type, constructor, field_index):
					None
				ErasedVariantFieldAccessor(parent_parent, union_c_type, constructor, field_index):
					None
				NullableOptionPayloadAccessor(parent_parent):
					None
				StackOptionPayloadAccessor(parent_parent):
					None
				StackResultOkPayloadAccessor(parent_parent):
					None
				BoxedStackResultOkPayloadAccessor(parent_parent, result_type):
					None
				BoxedStackResultErrPayloadAccessor(parent_parent, result_type):
					None
				StackResultErrPayloadAccessor(parent_parent):
					None
				BoxedResultOkPayloadAccessor(parent_parent):
					None
				BoxedResultErrPayloadAccessor(parent_parent):
					None
				TupleFieldAccessor(parent_parent, field_index, field_type):
					None
				ListElementAccessor(parent_parent, parent_index):
					None
				ListSpreadAccessor(parent_parent, parent_offset):
					None
		ListSpreadAccessor(parent, offset):
			match parent:
				RootAccessor:
					if skip_root_spread:
						Some({
							statements = "",
							next_temp = next_temp,
						})
					else:
						tailrec_list_spread_binding(loop, binding, offset, next_temp)
				VariantFieldAccessor(parent_parent, union_c_type, constructor, field_index):
					None
				ErasedVariantFieldAccessor(parent_parent, union_c_type, constructor, field_index):
					None
				NullableOptionPayloadAccessor(parent_parent):
					None
				StackOptionPayloadAccessor(parent_parent):
					None
				StackResultOkPayloadAccessor(parent_parent):
					None
				BoxedStackResultOkPayloadAccessor(parent_parent, result_type):
					None
				BoxedStackResultErrPayloadAccessor(parent_parent, result_type):
					None
				StackResultErrPayloadAccessor(parent_parent):
					None
				BoxedResultOkPayloadAccessor(parent_parent):
					None
				BoxedResultErrPayloadAccessor(parent_parent):
					None
				TupleFieldAccessor(parent_parent, field_index, field_type):
					None
				ListElementAccessor(parent_parent, parent_index):
					None
				ListSpreadAccessor(parent_parent, parent_offset):
					None
		RootAccessor:
			None
		VariantFieldAccessor(parent, union_c_type, constructor, field_index):
			None
		ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index):
			None
		NullableOptionPayloadAccessor(parent):
			None
		StackOptionPayloadAccessor(parent):
			None
		StackResultOkPayloadAccessor(parent):
			None
		StackResultErrPayloadAccessor(parent):
			None
		BoxedStackResultOkPayloadAccessor(parent, result_type):
			None
		BoxedStackResultErrPayloadAccessor(parent, result_type):
			None
		BoxedResultOkPayloadAccessor(parent):
			None
		BoxedResultErrPayloadAccessor(parent):
			None
		TupleFieldAccessor(parent, field_index, field_type):
			None


private pure func constructor_body_is_direct_tailrec_list_recur(
	body: CoreConstructorMatchBody,
) -> Bool:
	match body:
		ConstructorMatchBodyExpr(TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc)):
			True
		ConstructorMatchBodyExpr(expr):
			False
		ConstructorMatchBodyLiteral(match_expr):
			False
		ConstructorMatchBodyLength(match_expr):
			False


private pure func emit_tailrec_list_bindings(
	loop: CoreTailrecListSpreadLoop,
	branch: CoreConstructorLengthMatchBranch,
	next_temp: Int,
) -> Option[TailrecBindingC]:
	var statements: String = ""
	var temp_index: Int = next_temp
	var failed: Bool = False
	skip_root_spread: Bool = constructor_body_is_direct_tailrec_list_recur(branch.body)

	for binding in branch.bindings:
		if not failed:
			match emit_tailrec_list_binding(loop, binding, skip_root_spread, temp_index):
				Some(binding_c):
					statements += binding_c.statements
					temp_index = binding_c.next_temp
				None:
					failed = True
					break

	if failed:
		None
	else:
		Some({
			statements = statements,
			next_temp = temp_index,
		})


private pure func tailrec_list_spread_rebind_param(
	params: List[CoreParam],
	rebind: CoreTailrecListSpreadRebind,
) -> Option[CoreParam]:
	if rebind.param_index < 0:
		None
	else:
		params.get(rebind.param_index)


private pure func emit_tailrec_list_spread_recur(
	loop: CoreTailrecListSpreadLoop,
	rebinds: List[CoreTailrecListSpreadRebind],
	cursor_advance: Int,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	var declarations: String = ""
	var assignments: String = ""
	var temp_index: Int = next_temp
	var failed: Bool = False

	for rebind in rebinds:
		if not failed:
			match tailrec_list_spread_rebind_param(loop.params, rebind):
				Some(param):
					match emit_simple_expr(rebind.value):
						Some(value):
							temp: String = temp_name(
								"tailrec_arg_" + rebind.param_index.to_string(),
								temp_index,
							)
							declarations += "  " + c_type_name(
								param.typ,
							) + " " + temp + " = " + value + ";\n"
							assignments += "  " + c_var_name(param.name) + " = " + temp + ";\n"
							temp_index += 1
						None:
							failed = True
							break
				None:
					failed = True
					break

	if failed:
		None
	else:
		cursor_statement: String = if cursor_advance == 0:
			""
		else:
			"  " + c_var_name(loop.cursor) + " += " + cursor_advance.to_string() + "L;\n"

		Some(
			terminal_body(
				declarations + assignments + cursor_statement + "  continue;\n",
				temp_index,
			),
		)


private pure func emit_tailrec_list_branch_body(
	loop: CoreTailrecListSpreadLoop,
	body: CoreConstructorMatchBody,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match body:
		ConstructorMatchBodyExpr(expr):
			emit_tailrec_list_spread_tail(loop, expr, next_temp)
		ConstructorMatchBodyLiteral(match_expr):
			None
		ConstructorMatchBodyLength(match_expr):
			emit_tailrec_list_length_match(loop, match_expr, next_temp)


private pure func emit_tailrec_list_length_branch(
	loop: CoreTailrecListSpreadLoop,
	branch: CoreConstructorLengthMatchBranch,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	bindings_c ?= emit_tailrec_list_bindings(loop, branch, next_temp)
	body_c ?= emit_tailrec_list_branch_body(loop, branch.body, bindings_c.next_temp)

	Some(terminal_body(bindings_c.statements + body_c.statements, body_c.next_temp))


private pure func emit_tailrec_list_length_fallback(
	loop: CoreTailrecListSpreadLoop,
	fallback: Option[CoreConstructorLengthMatchBranch],
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match fallback:
		Some(branch):
			emit_tailrec_list_length_branch(loop, branch, next_temp)
		None:
			Some(emit_literal_match_failure(next_temp))


private pure func tailrec_list_length_case_test(
	len_name: String,
	cursor_name: String,
	length: Int,
) -> String:
	len_name + " == " + tailrec_cursor_index_expr(cursor_name, length)


private pure func tailrec_list_length_geq_test(
	len_name: String,
	cursor_name: String,
	minimum_length: Int,
) -> String:
	len_name + " >= " + tailrec_cursor_index_expr(cursor_name, minimum_length)


private pure func emit_tailrec_list_length_match(
	loop: CoreTailrecListSpreadLoop,
	match_expr: CoreConstructorLengthMatch,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match match_expr.accessor:
		RootAccessor:
			len_name: String = temp_name("tailrec_list_len", next_temp)
			cursor_name: String = c_var_name(loop.cursor)
			var branch_next_temp: Int = next_temp + 1
			var branch_statements: String = ""
			var failed: Bool = False
			var has_case: Bool = False

			for match_case in match_expr.cases:
				if not failed:
					match emit_tailrec_list_length_branch(
						loop,
						match_case.branch,
						branch_next_temp,
					):
						Some(case_c):
							test: String = tailrec_list_length_case_test(
								len_name,
								cursor_name,
								match_case.length,
							)

							if has_case:
								branch_statements += "  } else if (" + test + ") {\n"
							else:
								branch_statements += "  if (" + test + ") {\n"

							branch_statements += indent_statements(case_c.statements)
							branch_next_temp = case_c.next_temp
							has_case = True
						None:
							failed = True
							break

			match match_expr.geq:
				Some(geq_case):
					if not failed:
						match emit_tailrec_list_length_branch(
							loop,
							geq_case.branch,
							branch_next_temp,
						):
							Some(case_c):
								test: String = tailrec_list_length_geq_test(
									len_name,
									cursor_name,
									geq_case.minimum_length,
								)

								if has_case:
									branch_statements += "  } else if (" + test + ") {\n"
								else:
									branch_statements += "  if (" + test + ") {\n"

								branch_statements += indent_statements(case_c.statements)
								branch_next_temp = case_c.next_temp
								has_case = True
							None:
								failed = True
				None:
					void

			if failed:
				None
			else:
				fallback_c ?= emit_tailrec_list_length_fallback(
					loop,
					match_expr.fallback,
					branch_next_temp,
				)

				list_name: String = c_var_name(loop.list_param.name)
				prefix: String = "  long " + len_name + " = ((blorp_List*)" + list_name + ")->len;\n"

				var match_statements: String = fallback_c.statements

				if has_case:
					match_statements = branch_statements + "  } else {\n" + indent_statements(
						fallback_c.statements,
					) + "  }\n"

				Some(terminal_body(prefix + match_statements, fallback_c.next_temp))
		VariantFieldAccessor(parent, union_c_type, constructor, field_index):
			None
		ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index):
			None
		NullableOptionPayloadAccessor(parent):
			None
		StackOptionPayloadAccessor(parent):
			None
		StackResultOkPayloadAccessor(parent):
			None
		StackResultErrPayloadAccessor(parent):
			None
		BoxedStackResultOkPayloadAccessor(parent, result_type):
			None
		BoxedStackResultErrPayloadAccessor(parent, result_type):
			None
		BoxedResultOkPayloadAccessor(parent):
			None
		BoxedResultErrPayloadAccessor(parent):
			None
		TupleFieldAccessor(parent, field_index, field_type):
			None
		ListElementAccessor(parent, index):
			None
		ListSpreadAccessor(parent, offset):
			None


private pure func emit_tailrec_list_spread_tail(
	loop: CoreTailrecListSpreadLoop,
	expr: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match expr:
		RawMatchExpr(scrutinee, cases, typ, loc):
			None
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			None
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			emit_tailrec_list_spread_recur(loop, rebinds, cursor_advance, next_temp)
		LetExpr(name, is_mutable, typ, rhs, body):
			if is_void_type(typ):
				rhs_c ?= emit_function_body(rhs, next_temp)
				body_c ?= emit_tailrec_list_spread_tail(loop, body, rhs_c.next_temp)
				Some(
					terminal_body(
						scoped_discard_expr_body(rhs, rhs_c) + body_c.statements,
						body_c.next_temp,
					),
				)
			else:
				value ?= emit_simple_expr(rhs)
				decl: String = c_type_name(typ) + " " + c_var_name(name) + " = " + value
				body_c ?= emit_tailrec_list_spread_tail(loop, body, next_temp)
				Some(terminal_body("  " + decl + ";\n" + body_c.statements, body_c.next_temp))
		BorrowLetExpr(name, typ, rhs, body):
			if is_void_type(typ):
				rhs_c ?= emit_function_body(rhs, next_temp)
				body_c ?= emit_tailrec_list_spread_tail(loop, body, rhs_c.next_temp)
				Some(
					terminal_body(
						scoped_discard_expr_body(rhs, rhs_c) + body_c.statements,
						body_c.next_temp,
					),
				)
			else:
				value ?= emit_simple_expr(rhs)
				decl: String = c_type_name(typ) + " " + c_var_name(name) + " = " + value
				body_c ?= emit_tailrec_list_spread_tail(loop, body, next_temp)
				Some(terminal_body("  " + decl + ";\n" + body_c.statements, body_c.next_temp))
		SeqExpr(first, second):
			first_c ?= emit_function_body(first, next_temp)
			second_c ?= emit_tailrec_list_spread_tail(loop, second, first_c.next_temp)
			Some(
				terminal_body(
					scoped_discard_expr_body(first, first_c) + second_c.statements,
					second_c.next_temp,
				),
			)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			retain_statement: String = emit_dup_statement(variable, retain_policy)
			body_c ?= emit_tailrec_list_spread_tail(loop, body, next_temp)
			Some(terminal_body(retain_statement + body_c.statements, body_c.next_temp))
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			drop_statement: String = emit_drop_statement(variable, release_policy)
			body_c ?= emit_tailrec_list_spread_tail(loop, body, next_temp)
			Some(terminal_body(drop_statement + body_c.statements, body_c.next_temp))
		IfExpr(cond, then_expr, else_expr, typ, loc):
			condition ?= emit_condition(cond, next_temp)
			then_c ?= emit_tailrec_list_spread_tail(loop, then_expr, condition.next_temp)
			else_c ?= emit_tailrec_list_spread_tail(loop, else_expr, then_c.next_temp)
			Some(
				terminal_body(
					condition.statements + "  if (" + condition.value + ") {\n" + indent_statements(
						then_c.statements,
					) + "  } else {\n" + indent_statements(else_c.statements) + "  }\n",
					else_c.next_temp,
				),
			)
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			emit_tailrec_list_length_match(loop, match_expr, next_temp)
		TailrecLoopExpr(params, return_type, body, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		TailrecRecurExpr(args, typ, loc):
			None
		TailrecListSpreadLoopExpr(inner_loop, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		LiteralExpr(literal, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		VarExpr(variable, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		VoidExpr(typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		DebugBlockExpr(body, typ, loc):
			None
		CooperativeCheckpointExpr(typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		CallExpr(kind, callee, args, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		BinaryExpr(op, left, right, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		UnaryExpr(op, expr_value, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		LogicalExpr(op, left, right, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		AssignExpr(variable, rhs, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		CastExpr(expr_value, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		BoxExpr(box, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		FieldExpr(expr_value, field_name, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		TupleFieldExpr(expr_value, field_index, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		TupleExpr(items, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		TupleConstructExpr(tuple_construct, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		VectorExpr(items, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			None
		ClosureCreateExpr(closure, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		ListConstructExpr(construct, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		ListAllocExpr(alloc, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		ListGetExpr(get, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		ListHandoffExpr(handoff, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		ListHandoffSetOwnedExpr(set, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		StringByteReadExpr(read, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		StringByteWriteExpr(write, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		StringByteCopyExpr(copy, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		StringSetLenExpr(set_len, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		TensorLiteralExpr(literal, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		TensorBoxedLiteralExpr(literal, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		TensorPackedLiteralExpr(literal, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		TensorRawFillExpr(fill, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		TensorRawReadExpr(read, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		TensorRawWriteExpr(write, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		TensorRawViewLetExpr(binding, body, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		DictConstructExpr(construct, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		DictExpr(entries, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		SetAllocExpr(alloc, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		ListRetainExpr(retain, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		ListSetExpr(set, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		ListSwapExpr(swap, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		RecordExpr(fields, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		RecordUpdateExpr(base, fields, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		RecordReuseExpr(source, fields, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		RecordConstructExpr(type_name, fields, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		UnionConstructExpr(construct, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		UnionReuseConstructExpr(construct, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		WhileExpr(cond, body, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		BreakExpr(typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		ContinueExpr(typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		ResourceScopeExpr(scope, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		ForChannelExpr(for_channel, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		ForListExpr(for_list, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		ForStringExpr(for_string, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		ForDictExpr(for_dict, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		ForSetExpr(for_set, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		ForResourceSourceExpr(for_resource_source, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		ForStreamExpr(for_stream, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		ForTensorExpr(for_tensor, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		PreClosureDetachExpr(detached, typ, loc):
			None
		DetachExpr(detached, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		PreClosureConcurrentlyLoopExpr(concurrent_loop, typ, loc):
			None
		ConcurrentlyLoopExpr(concurrent_loop, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		PreClosureConcurrentExpr(block, typ, loc):
			None
		ConcurrentExpr(block, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		SelectExpr(select_expr, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		RangeExpr(start, end_value, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		LiteralMatchExpr(scrutinee, cases, default_body, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, default_body, typ, loc):
			emit_tailrec_return(loop.return_type, expr, next_temp)


private pure func emit_tailrec_list_spread_loop(
	loop: CoreTailrecListSpreadLoop,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	body_c ?= emit_tailrec_list_spread_tail(loop, loop.body, next_temp)
	cursor_name: String = c_var_name(loop.cursor)

	Some(
		terminal_body(
			"  long " + cursor_name + " = 0L;\n" + "  while (1) {\n" + indent_statements(
				body_c.statements,
			) + "  }\n",
			body_c.next_temp,
		),
	)


private pure func static_int_literal(expr: CoreExpr) -> Option[Int]:
	match expr:
		RawMatchExpr(scrutinee, cases, typ, loc):
			None
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			None
		LiteralExpr(literal, typ, loc):
			match literal:
				IntLiteral(value):
					Some(value)
				WideIntLiteral(value):
					None
				FloatLiteral(value):
					None
				FloatTextLiteral(value):
					None
				FloatInfinityLiteral:
					None
				FloatNegInfinityLiteral:
					None
				FloatNanLiteral:
