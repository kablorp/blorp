	name: String,
	rendered_args: List[String],
	source_args: List[CoreExpr],
	typ: CoreType,
) -> Option[String]:
	match source_args:
		[channel_source, value_source, timeout_source]:
			if boxed_expr_temp_needs_release(value_source):
				emit_channel_send_timeout_retained_value_for_rendered_args(name, rendered_args, typ)
			else:
				None
		[]:
			None
		[first]:
			None
		[first, second]:
			None
		[first, second, third, fourth, ...rest]:
			None


private pure func emit_channel_send_call_with_retained_temp(
	name: String,
	rendered_args: List[String],
	source_args: List[CoreExpr],
	typ: CoreType,
) -> Option[String]:
	if (
		name == "blorp_channel_send"
		or name == "blorp_channel_try_send"
		or name == "blorp_channel_try_send_status"
	):
		emit_channel_send_retained_value_for_source_args(name, rendered_args, source_args, typ)
	else if name == "blorp_channel_send_timeout" or name == "blorp_channel_send_timeout_status":
		emit_channel_send_timeout_retained_value_for_source_args(
			name,
			rendered_args,
			source_args,
			typ,
		)
	else:
		None


private pure func direct_runtime_call_is_dict_constructor(name: String) -> Bool:
	match name:
		"blorp_dict_new":
			True
		"blorp_dict_new_string":
			True
		"blorp_dict_new_float":
			True
		"blorp_dict_new_custom":
			True
		"blorp_dict_with_capacity":
			True
		"blorp_dict_with_capacity_string":
			True
		"blorp_dict_with_capacity_float":
			True
		"blorp_dict_with_capacity_custom":
			True
		other_name:
			False


private pure func emit_release_aware_direct_dict_constructor_call(
	call: CoreDirectRuntimeCall,
	args: List[String],
	typ: CoreType,
) -> Option[String]:
	if dict_value_needs_release_type(typ) and direct_runtime_call_is_dict_constructor(call.name):
		ctor_c ?= emit_direct_runtime_call(call, args)
		Some(emit_dict_construct_result(ctor_c, typ))
	else:
		None


private pure func emit_release_aware_builtin_dict_constructor_call(
	name: String,
	args: List[String],
	typ: CoreType,
) -> Option[String]:
	if dict_value_needs_release_type(typ) and direct_runtime_call_is_dict_constructor(name):
		Some(emit_dict_construct_result(name + "(" + args.join(", ") + ")", typ))
	else:
		None


private pure func emit_call_value_from_args(
	kind: CoreCallKind,
	args: List[String],
	typ: CoreType,
) -> Option[String]:
	args_c: String = args.join(", ")

	match kind:
		IntrinsicCall(name):
			emit_intrinsic_call_from_values(name, args)
		UserCall(name, def_id, consumed_args):
			if name == "Some" or name == "None":
				None
			else:
				Some(c_identifier(name) + "(" + args_c + ")")
		ForeignCall(name, arg_passing):
			None
		ListToStringCall(callback_name):
			match args:
				[list_value]:
					Some(
						"blorp_list_to_string_cb(" + list_value + ", (blorp_String* (*)(void*))" + c_identifier(
							callback_name,
						) + ")",
					)
				[]:
					None
				[first, second, ...rest]:
					None
		TensorParallelCall(name, layout):
			emit_tensor_parallel_runtime_call(name, layout, args, typ)
		DictWithCapacityCall(constructor):
			emit_dict_with_capacity_call(constructor, args, typ)
		DirectRuntimeCall(call):
			match emit_release_aware_direct_dict_constructor_call(call, args, typ):
				Some(rendered):
					Some(rendered)
				None:
					emit_direct_runtime_call(call, args)
		BuiltinCall(name):
			match emit_tensor_stack_option_get_call(name, args, typ):
				Some(rendered):
					Some(rendered)
				None:
					match emit_release_aware_builtin_dict_constructor_call(name, args, typ):
						Some(rendered):
							Some(rendered)
						None:
							match emit_tensor_fill_packed_from_values(name, args):
								Some(rendered):
									Some(rendered)
								None:
									match emit_prepared_dict_builtin_call(name, args, typ):
										Some(rendered):
											Some(rendered)
										None:
											match emit_prepared_channel_builtin_call(
												name,
												args,
												typ,
											):
												Some(rendered):
													Some(rendered)
												None:
													emit_channel_semantic_runtime_call(name, args)
		OperationResultCall(bridge):
			None
		FallibleStreamTerminalCall(bridge):
			None
		ListToStringCall(callback_name):
			None
		ClosureCall:
			None
		UnknownCall | DeferredTraitCall(_, _) | SelectedTraitCall(_, _, _, _):
			None
		SelectedDirectCall(def_id):
			None


private pure func emit_call_body(
	kind: CoreCallKind,
	args: List[CoreExpr],
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match kind:
		ForeignCall(name, arg_passing):
			emit_foreign_call_body(name, arg_passing, args, typ, next_temp)
		UserCall(name, def_id, consumed_args):
			args_body ?= emit_call_args_body(args, next_temp)
			value ?= emit_call_value_from_args(kind, args_body.args, typ)
			transfer_cleanup_pop: String = call_transfer_cleanup_pop_statements(kind, args)
			Some(call_body_from_value(args_body, transfer_cleanup_pop, value, typ))
		DirectRuntimeCall(call):
			transfer_cleanup_pop: String = call_transfer_cleanup_pop_statements(kind, args)

			match emit_typed_direct_tensor_call(call, args, typ):
				Some(value):
					Some({
						statements = transfer_cleanup_pop,
						value = value,
						next_temp = next_temp,
						returns = False,
					})
				None:
					args_body ?= emit_direct_runtime_call_args_body(call, args, next_temp)

					match emit_direct_runtime_tensor_call_from_values(
						call,
						args,
						args_body.args,
						typ,
					):
						Some(value):
							Some(call_body_from_value(args_body, transfer_cleanup_pop, value, typ))
						None:
							value ?= emit_call_value_from_args(
								DirectRuntimeCall(call),
								args_body.args,
								typ,
							)
							Some(call_body_from_value(args_body, transfer_cleanup_pop, value, typ))
		BuiltinCall(name):
			transfer_cleanup_pop: String = call_transfer_cleanup_pop_statements(kind, args)

			match emit_boxed_tensor_set_call(name, args, typ):
				Some(value):
					Some({
						statements = transfer_cleanup_pop,
						value = value,
						next_temp = next_temp,
						returns = False,
					})
				None:
					args_body ?= emit_call_args_body(args, next_temp)

					match emit_channel_send_call_with_retained_temp(
						name,
						args_body.args,
						args,
						typ,
					):
						Some(value):
							Some(call_body_from_value(args_body, transfer_cleanup_pop, value, typ))
						None:
							match emit_ranked_tensor_checked_get_call_from_values(
								name,
								args,
								args_body.args,
							):
								Some(value):
									Some(
										call_body_from_value(
											args_body,
											transfer_cleanup_pop,
											value,
											typ,
										),
									)
								None:
									if is_ranked_tensor_checked_get_name(name):
										None
									else:
										match emit_direct_nonboxed_tensor_call_from_values(
											name,
											args,
											args_body.args,
											typ,
										):
											Some(value):
												Some(
													call_body_from_value(
														args_body,
														transfer_cleanup_pop,
														value,
														typ,
													),
												)
											None:
												value ?= emit_call_value_from_args(
													kind,
													args_body.args,
													typ,
												)
												Some(
													call_body_from_value(
														args_body,
														transfer_cleanup_pop,
														value,
														typ,
													),
												)
		TensorParallelCall(name, layout):
			args_body ?= emit_call_args_body(args, next_temp)
			value ?= emit_call_value_from_args(kind, args_body.args, typ)
			Some(call_body_from_value(args_body, "", value, typ))
		DictWithCapacityCall(constructor):
			args_body ?= emit_call_args_body(args, next_temp)
			value ?= emit_call_value_from_args(kind, args_body.args, typ)
			Some(call_body_from_value(args_body, "", value, typ))
		IntrinsicCall(name):
			if name == "list_retain_for":
				emit_list_retain_intrinsic_body(args, next_temp)
			else:
				args_body ?= emit_call_args_body(args, next_temp)
				value ?= emit_call_value_from_args(kind, args_body.args, typ)
				transfer_cleanup_pop: String = call_transfer_cleanup_pop_statements(kind, args)
				Some(call_body_from_value(args_body, transfer_cleanup_pop, value, typ))
		OperationResultCall(bridge):
			None
		FallibleStreamTerminalCall(bridge):
			None
		ListToStringCall(callback_name):
			args_body ?= emit_call_args_body(args, next_temp)
			value ?= emit_call_value_from_args(kind, args_body.args, typ)
			Some(call_body_from_value(args_body, "", value, typ))
		ClosureCall:
			None
		UnknownCall | DeferredTraitCall(_, _) | SelectedTraitCall(_, _, _, _):
			None
		SelectedDirectCall(def_id):
			None


private pure func emit_tuple_element_box(element: CoreTupleElement) -> Option[String]:
	match element:
		TuplePrimElement(value):
			value_c ?= emit_simple_expr(value)
			Some("(void*)(long)(" + value_c + ")")
		TuplePointerElement(value):
			value_c ?= emit_simple_expr(value)
			Some("(void*)" + value_c)
		TupleStructElement(value, c_type):
			value_c ?= emit_simple_expr(value)
			Some(
				"({ " + c_type + " __box_struct_value = " + value_c + "; blorp_box_struct(&__box_struct_value, sizeof(" + c_type + ")); })",
			)
		TupleStackResultElement(value):
			value_c ?= emit_simple_expr(value)
			Some("blorp_box_stack_result(blorp_stack_result_retain_value(" + value_c + "))")
		TupleVoidElement:
			Some("(void*)0")
		TupleFloatElement(value):
			value_c ?= emit_simple_expr(value)
			Some("blorp_box_float(" + value_c + ")")
		TupleFloat32Element(value):
			value_c ?= emit_simple_expr(value)
			Some("blorp_box_float32(" + value_c + ")")
		TupleFloat16Element(value):
			value_c ?= emit_simple_expr(value)
			Some("blorp_box_float16(" + value_c + ")")


private pure func tuple_call_args_suffix(values: List[String]) -> String:
	if values.length() == 0:
		""
	else:
		", " + values.join(", ")


private pure func tuple_element_box_args(elements: List[CoreTupleElement]) -> Option[String]:
	var values: List[String] = []
	var failed: Bool = False

	for element in elements:
		if not failed:
			match emit_tuple_element_box(element):
				Some(value):
					values = values.append(value)
				None:
					failed = True
					break

	if failed:
		None
	else:
		Some(tuple_call_args_suffix(values))


private pure func int_power_of_two(exponent: Int) -> Int:
	var result: Int = 1
	var index: Int = 0

	while index < exponent:
		result *= 2
		index += 1

	result


private pure func mask_contains_bit(mask: Int, index: Int) -> Bool:
	bit: Int = int_power_of_two(index)
	mask / bit % 2 == 1


private pure func tuple_retain_statements(
	tuple_construct: CoreTupleConstruct,
	tuple_name: String,
) -> String:
	var statements: List[String] = []
	var index: Int = 0

	for element in tuple_construct.elements:
		if mask_contains_bit(tuple_construct.retain_mask, index):
			args: TupleRetainElemArgs = {
				tuple = tuple_name,
				index = index.to_string()
			}
			statements = statements.append(render_prepared_tuple_op(TupleRetainElem(args)))

		index += 1

	statements.join(" ")


private pure func render_tuple_construct_from_args(
	tuple_construct: CoreTupleConstruct,
	args_c: String,
) -> String:
	arity: String = tuple_construct.elements
		.length()
		.to_string()

	if tuple_construct.release_mask == 0:
		args: TupleConstructArgs = {
			arity = arity,
			args = args_c
		}

		render_prepared_tuple_op(TupleConstruct(args))
	else:
		tuple_name: String = render_prepared_tuple_op(TupleName(TUPLE_RC_TEMP_SEED))
		args: TupleConstructWithRcArgs = {
			tuple = tuple_name,
			arity = arity,
			args = args_c,
			retain_statements = tuple_retain_statements(tuple_construct, tuple_name),
			release_mask = tuple_construct.release_mask.to_string()
		}

		render_prepared_tuple_op(TupleConstructWithRc(args))


private pure func emit_tuple_construct(tuple_construct: CoreTupleConstruct) -> Option[String]:
	args_c ?= tuple_element_box_args(tuple_construct.elements)
	Some(render_tuple_construct_from_args(tuple_construct, args_c))


private pure func emit_tuple_element_box_body(
	element: CoreTupleElement,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match element:
		TuplePrimElement(value):
			value_body ?= emit_function_body(value, next_temp)

			if value_body.returns:
				None
			else:
				value_c ?= required_body_value(value_body)
				Some({
					statements = value_body.statements,
					value = "(void*)(long)(" + value_c + ")",
					next_temp = value_body.next_temp,
					returns = False,
				})
		TuplePointerElement(value):
			value_body ?= emit_function_body(value, next_temp)

			if value_body.returns:
				None
			else:
				value_c ?= required_body_value(value_body)
				Some({
					statements = value_body.statements,
					value = "(void*)" + value_c,
					next_temp = value_body.next_temp,
					returns = False,
				})
		TupleStructElement(value, c_type):
			value_body ?= emit_function_body(value, next_temp)

			if value_body.returns:
				None
			else:
				value_c ?= required_body_value(value_body)
				struct_tmp: String = temp_name("tuple_struct", value_body.next_temp)
				Some({
					statements = value_body.statements + "  " + c_type + " " + struct_tmp + " = " + value_c + ";\n",
					value = "blorp_box_struct(&" + struct_tmp + ", sizeof(" + c_type + "))",
					next_temp = value_body.next_temp + 1,
					returns = False,
				})
		TupleStackResultElement(value):
			value_body ?= emit_function_body(value, next_temp)

			if value_body.returns:
				None
			else:
				value_c ?= required_body_value(value_body)
				Some({
					statements = value_body.statements,
					value = "blorp_box_stack_result(blorp_stack_result_retain_value(" + value_c + "))",
					next_temp = value_body.next_temp,
					returns = False,
				})
		TupleVoidElement:
			Some(body_value("(void*)0", next_temp))
		TupleFloatElement(value):
			value_body ?= emit_function_body(value, next_temp)

			if value_body.returns:
				None
			else:
				value_c ?= required_body_value(value_body)
				Some({
					statements = value_body.statements,
					value = "blorp_box_float(" + value_c + ")",
					next_temp = value_body.next_temp,
					returns = False,
				})
		TupleFloat32Element(value):
			value_body ?= emit_function_body(value, next_temp)

			if value_body.returns:
				None
			else:
				value_c ?= required_body_value(value_body)
				Some({
					statements = value_body.statements,
					value = "blorp_box_float32(" + value_c + ")",
					next_temp = value_body.next_temp,
					returns = False,
				})
		TupleFloat16Element(value):
			value_body ?= emit_function_body(value, next_temp)

			if value_body.returns:
				None
			else:
				value_c ?= required_body_value(value_body)
				Some({
					statements = value_body.statements,
					value = "blorp_box_float16(" + value_c + ")",
					next_temp = value_body.next_temp,
					returns = False,
				})


private pure func emit_tuple_construct_args_body(
	elements: List[CoreTupleElement],
	next_temp: Int,
) -> Option[CallArgsBody]:
	var statements: String = ""
	var values: List[String] = []
	var failed: Bool = False
	var temp_index: Int = next_temp

	for element in elements:
		if not failed:
			match emit_tuple_element_box_body(element, temp_index):
				Some(element_body):
					match required_body_value(element_body):
						Some(element_value):
							if element_body.statements == "":
								values = values.append(element_value)
								temp_index = element_body.next_temp
							else:
								arg_temp: String = temp_name("tuple_arg", element_body.next_temp)
								statements += "  void* " + arg_temp + ";\n  {\n" + indent_statements(
									element_body.statements + "  " + arg_temp + " = " + element_value + ";\n",
								) + "  }\n"
								values = values.append(arg_temp)
								temp_index = element_body.next_temp + 1
						None:
							failed = True
							break
				None:
					failed = True
					break

	if failed:
		None
	else:
		Some({
			statements = statements,
			args = values,
			cleanup_slots = [],
			next_temp = temp_index,
		})


private pure func emit_tuple_construct_body(
	tuple_construct: CoreTupleConstruct,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	args_body ?= emit_tuple_construct_args_body(tuple_construct.elements, next_temp)
	Some({
		statements = args_body.statements,
		value = render_tuple_construct_from_args(
			tuple_construct,
			tuple_call_args_suffix(args_body.args),
		),
		next_temp = args_body.next_temp,
		returns = False,
	})


private pure func list_alloc_call(layout: CoreListStorageLayout, capacity: String) -> String:
	match layout:
		PointerListStorage:
			"blorp_list_new(" + capacity + ")"
		InlineListStorage(width_bytes):
			"blorp_list_new_inline(" + capacity + ", " + width_bytes.to_string() + ")"
		InlineStructListStorage(c_type):
			"blorp_list_new_inline(" + capacity + ", sizeof(" + c_type + "))"


private pure func list_construct_alloc(layout: CoreListStorageLayout, len: Int) -> String:
	list_alloc_call(layout, len.to_string())


private pure func boxed_pointer_value_from_c(
	kind: CoreBoxKind,
	source_type: CoreType,
	value_c: String,
	source_already_retained: Bool,
) -> Option[String]:
	match kind:
		PrimBox:
			Some("(void*)(long)(" + value_c + ")")
		PointerBox:
			Some("(void*)" + value_c)
		VoidBox:
			Some("(void*)0")
		FloatBox:
			Some("blorp_box_float(" + value_c + ")")
		Float32Box:
			Some("blorp_box_float32(" + value_c + ")")
		Float16Box:
			Some("blorp_box_float16(" + value_c + ")")
		Int128Box:
			Some("blorp_box_int128(" + value_c + ")")
		UInt128Box:
			Some("blorp_box_uint128(" + value_c + ")")
		StructBox(c_type):
			if is_stack_result_type(source_type):
				Some(emit_stack_result_box(value_c, source_already_retained))
			else:
				Some(
					"({ " + c_type + " __box_struct_value = " + value_c + "; blorp_box_struct(&__box_struct_value, sizeof(" + c_type + ")); })",
				)


private pure func emit_boxed_pointer_value(value: CoreBoxedStorageValue) -> Option[String]:
	value_c ?= emit_simple_expr(value.value)
	boxed_pointer_value_from_c(
		value.kind,
		core_expr_type(value.value),
		value_c,
		expr_retains_stack_result(value.value),
	)


private pure func expr_retains_stack_result(expr: CoreExpr) -> Bool:
	match expr:
		DupExpr(variable, value_type, StackResultRetainPolicy, body, typ, loc):
			match body:
				VarExpr(returned, return_type, return_loc):
					core_vars_equal(variable, returned)
				_:
					False
		_:
			False


private pure func emit_stack_result_box(value_c: String, source_already_retained: Bool) -> String:
	retained_value: String = if source_already_retained:
		value_c
	else:
		"blorp_stack_result_retain_value(" + value_c + ")"

	"blorp_box_stack_result(" + retained_value + ")"


private pure func emit_boxed_pointer_body(
	value: CoreBoxedStorageValue,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match emit_boxed_pointer_value(value):
		Some(value_c):
			Some(body_value(value_c, next_temp))
		None:
			value_body ?= emit_function_body(value.value, next_temp)

			if value_body.returns:
				None
			else:
				match value.kind:
					VoidBox:
						Some({
							statements = discard_expr_body(value.value, value_body),
							value = "(void*)0",
							next_temp = value_body.next_temp,
							returns = False,
						})
					PrimBox:
						value_c ?= required_body_value(value_body)
						Some({
							statements = value_body.statements,
							value = "(void*)(long)(" + value_c + ")",
							next_temp = value_body.next_temp,
							returns = False,
						})
					PointerBox:
						value_c ?= required_body_value(value_body)
						Some({
							statements = value_body.statements,
							value = "(void*)" + value_c,
							next_temp = value_body.next_temp,
							returns = False,
						})
					FloatBox:
						value_c ?= required_body_value(value_body)
						Some({
							statements = value_body.statements,
							value = "blorp_box_float(" + value_c + ")",
							next_temp = value_body.next_temp,
							returns = False,
						})
					Float32Box:
						value_c ?= required_body_value(value_body)
						Some({
							statements = value_body.statements,
							value = "blorp_box_float32(" + value_c + ")",
							next_temp = value_body.next_temp,
							returns = False,
						})
					Float16Box:
						value_c ?= required_body_value(value_body)
						Some({
							statements = value_body.statements,
							value = "blorp_box_float16(" + value_c + ")",
							next_temp = value_body.next_temp,
							returns = False,
						})
					Int128Box:
						value_c ?= required_body_value(value_body)
						Some({
							statements = value_body.statements,
							value = "blorp_box_int128(" + value_c + ")",
							next_temp = value_body.next_temp,
							returns = False,
						})
					UInt128Box:
						value_c ?= required_body_value(value_body)
						Some({
							statements = value_body.statements,
							value = "blorp_box_uint128(" + value_c + ")",
							next_temp = value_body.next_temp,
							returns = False,
						})
					StructBox(c_type):
						value_c ?= required_body_value(value_body)

						value_expr: String = if is_stack_result_type(core_expr_type(value.value)):
							emit_stack_result_box(
								value_c,
								expr_retains_stack_result(value.value),
							)
						else:
							"({ " + c_type + " __box_struct_value = " + value_c + "; blorp_box_struct(&__box_struct_value, sizeof(" + c_type + ")); })"

						Some({
							statements = value_body.statements,
							value = value_expr,
							next_temp = value_body.next_temp,
							returns = False,
						})


private pure func render_list_construct_append_body(
	list_name: String,
	value: CoreBoxedStorageValue,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	value_body ?= emit_boxed_pointer_body(value, next_temp)
	scoped_value: FunctionBodyC = scoped_c_value("list_elem", "void*", value_body)
	value_c ?= required_body_value(scoped_value)

	append_statement: String = if value.transfers_ownership:
		"  " + list_name + " = blorp_list_append_owned(" + list_name + ", " + value_c + ");\n"
	else:
		"  " + list_name + " = blorp_list_append(" + list_name + ", " + value_c + ");\n"

	Some({
		statements = scoped_value.statements + append_statement,
		value = "",
		next_temp = scoped_value.next_temp,
		returns = False,
	})


private pure func render_inline_struct_list_write(
	list_name: String,
	index: Int,
	c_type: String,
	value: CoreBoxedStorageValue,
) -> Option[String]:
	value_c ?= emit_simple_expr(value.value)
	elem_name: String = "__lst_elem_" + index.to_string()

	Some(
		"  { " + c_type + " " + elem_name + " = " + value_c + "; blorp_list_set_raw_copy(" + list_name + ", " + index.to_string() + ", &" + elem_name + "); }\n",
	)


private pure func emit_list_construct(construct: CoreListConstruct) -> Option[String]:
	list_name: String = "__lst"
	len: Int = construct.elements.length()
	var statements: String = "({\n  blorp_List* " + list_name + " = " + list_construct_alloc(
		construct.layout,
		len,
	) + ";\n"
	var failed: Bool = False
	var index: Int = 0
	var temp_index: Int = 0

	if construct.elem_needs_release:
		statements += "  blorp_list_init_elem_release(" + list_name + ", blorp_elem_release_fn);\n"

	match construct.layout:
		InlineStructListStorage(c_type):
			for value in construct.elements:
				if not failed:
					match render_inline_struct_list_write(list_name, index, c_type, value):
						Some(statement):
							statements += statement
						None:
							failed = True
							break

				index += 1
		PointerListStorage:
			for value in construct.elements:
				if not failed:
					match render_list_construct_append_body(list_name, value, temp_index):
						Some(value_body):
							statements += value_body.statements
							temp_index = value_body.next_temp
						None:
							failed = True
							break
		InlineListStorage(width_bytes):
			for value in construct.elements:
				if not failed:
					match render_list_construct_append_body(list_name, value, temp_index):
						Some(value_body):
							statements += value_body.statements
							temp_index = value_body.next_temp
						None:
							failed = True
							break

	if failed:
		None
	else:
		statements += "  " + list_name + "->len = " + len.to_string() + ";\n  " + list_name + ";\n})"
		Some(statements)


private pure func emit_list_construct_body(
	construct: CoreListConstruct,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	list_name: String = temp_name("lst", next_temp)
	len: Int = construct.elements.length()
	var statements: String = "  blorp_List* " + list_name + " = " + list_construct_alloc(
		construct.layout,
		len,
	) + ";\n"
	var failed: Bool = False
	var index: Int = 0
	var temp_index: Int = next_temp + 1

	if construct.elem_needs_release:
		statements += "  blorp_list_init_elem_release(" + list_name + ", blorp_elem_release_fn);\n"

	match construct.layout:
		InlineStructListStorage(c_type):
			for value in construct.elements:
				if not failed:
					match render_inline_struct_list_write(list_name, index, c_type, value):
						Some(statement):
							statements += statement
						None:
							failed = True
							break

				index += 1
		PointerListStorage:
			for value in construct.elements:
				if not failed:
					match render_list_construct_append_body(list_name, value, temp_index):
						Some(value_body):
							statements += value_body.statements
							temp_index = value_body.next_temp
						None:
							failed = True
							break
		InlineListStorage(width_bytes):
			for value in construct.elements:
				if not failed:
					match render_list_construct_append_body(list_name, value, temp_index):
						Some(value_body):
							statements += value_body.statements
							temp_index = value_body.next_temp
						None:
							failed = True
							break

	if failed:
		None
	else:
		statements += "  " + list_name + "->len = " + len.to_string() + ";\n"
		Some({
			statements = statements,
			value = list_name,
			next_temp = temp_index,
			returns = False,
		})


private pure func emit_list_alloc(alloc: CoreListAlloc) -> Option[String]:
	capacity_c ?= emit_simple_expr(alloc.capacity)
	alloc_c: String = list_alloc_call(alloc.layout, capacity_c)

	if alloc.elem_needs_release:
		Some("({ blorp_List* __list_alloc = " + alloc_c + ((
				"; blorp_list_init_elem_release(__list_alloc, blorp_elem_release_fn); "
				+ "__list_alloc; })"
			)))
	else:
		Some(alloc_c)


private pure func inline_list_load_result(bounds: CoreListAccessBounds, load_c: String) -> String:
	match bounds:
		CheckedListAccess:
			(
				"(__builtin_expect(!__lg_list || __lg_idx < 0 || __lg_idx >= __lg_list->len, 0) "
				+ "? NULL : "
			) + load_c + ")"
		ProvenListAccess:
			load_c


private pure func emit_inline_scalar_list_unbox_get(
	get: CoreListGet,
	typ: CoreType,
	width_bytes: Int,
) -> Option[String]:
	list_c ?= emit_simple_expr(get.list)
	index_c ?= emit_simple_expr(get.index)
	c_type: String = c_type_name(typ)
	width_c: String = width_bytes.to_string()
	load_c: String = "memcpy(&__lg_value, (char*)__lg_list->data + __lg_idx * " + width_c + ", " + width_c + ");"

	bounds_c: String = match get.bounds:
		CheckedListAccess:
			(
				"if (__builtin_expect(!__lg_list || __lg_idx < 0 || __lg_idx >= __lg_list->len, "
				+ "0)) { } else { "
			) + load_c + " } "
		ProvenListAccess:
			load_c + " "

	Some(
		"({ blorp_List* __lg_list = (blorp_List*)" + list_c + "; long __lg_idx = " + index_c + "; " + c_type + " __lg_value = 0; " + bounds_c + "__lg_value; })",
	)


private pure func emit_inline_list_get(get: CoreListGet, width_bytes: Int) -> Option[String]:
	list_c ?= emit_simple_expr(get.list)
	index_c ?= emit_simple_expr(get.index)
	width_c: String = width_bytes.to_string()
	load_c: String = (
		"({ uintptr_t __lg_bits = 0; memcpy(&__lg_bits, (char*)__lg_list->data + "
		+ "__lg_idx * "
	) + width_c + ", " + width_c + "); (void*)__lg_bits; })"

	Some(
		"({ blorp_List* __lg_list = (blorp_List*)" + list_c + "; long __lg_idx = " + index_c + "; " + inline_list_load_result(
			get.bounds,
			load_c,
		) + "; })",
	)


private pure func emit_runtime_list_get(get: CoreListGet) -> Option[String]:
	list_c ?= emit_simple_expr(get.list)
	index_c ?= emit_simple_expr(get.index)
	Some("blorp_list_get((blorp_List*)" + list_c + ", " + index_c + ")")


private pure func inline_struct_list_load_op(
	bounds: CoreListAccessBounds,
	args: InlineStructLoadArgs,
) -> PreparedListOp:
	match bounds:
		CheckedListAccess:
			InlineStructLoadChecked(args)
		ProvenListAccess:
			InlineStructLoadProven(args)


private pure func emit_inline_struct_list_unbox_get(
	get: CoreListGet,
	c_type: String,
) -> Option[String]:
	list_c ?= emit_simple_expr(get.list)
	index_c ?= emit_simple_expr(get.index)
	list_tmp: String = render_prepared_list_op(
		ListInlineStructUnboxListName(LIST_INLINE_STRUCT_LOAD_TEMP_SEED),
	)
	index_tmp: String = render_prepared_list_op(
		ListInlineStructUnboxIndexName(LIST_INLINE_STRUCT_LOAD_TEMP_SEED),
	)
	out_tmp: String = render_prepared_list_op(
		ListInlineStructUnboxOutName(LIST_INLINE_STRUCT_LOAD_TEMP_SEED),
	)
	open_args: ListInlineStructUnboxOpenArgs = {
		list = list_tmp,
		list_expr = list_c,
		index = index_tmp,
		index_expr = index_c,
		struct_ty = c_type,
		out = out_tmp
	}
	load_args: InlineStructLoadArgs = {
		list_tmp = list_tmp,
		index_tmp = index_tmp,
		out_tmp = out_tmp,
		temp_seed = LIST_INLINE_STRUCT_LOAD_TEMP_SEED,
		struct_ty = c_type
	}

	Some(
		render_prepared_list_op(
			ListInlineStructUnboxOpen(
				open_args,
			),
		) + " " + render_prepared_list_op(
			inline_struct_list_load_op(
				get.bounds,
				load_args,
			),
		) + " " + render_prepared_list_op(ListInlineStructUnboxClose(out_tmp)),
	)


private pure func emit_inline_struct_tensor_get_unchecked(
	args: List[CoreExpr],
	c_type: String,
) -> Option[String]:
	arg_values ?= emit_simple_expr_arg_values(args)

	match arg_values:
		[tensor, index]:
			get_args: InlineStructGetArgs = {
				tensor = tensor,
				index = index,
				temp_seed = TENSOR_INLINE_STRUCT_GET_TEMP_SEED,
				struct_ty = c_type
			}

			Some(render_prepared_tensor_op(InlineStructGetUnchecked(get_args)))
		[]:
			None
		[first]:
			None
		[first, second, third, ...rest]:
			None


private pure func emit_inline_struct_tensor_get_checked(
	args: List[CoreExpr],
	c_type: String,
) -> Option[String]:
	arg_values ?= emit_simple_expr_arg_values(args)

	match arg_values:
		[tensor, index]:
			get_args: InlineStructGetArgs = {
				tensor = tensor,
				index = index,
				temp_seed = TENSOR_INLINE_STRUCT_CHECKED_GET_TEMP_SEED,
				struct_ty = c_type
			}

			Some(render_prepared_tensor_op(InlineStructGetChecked(get_args)))
		[]:
			None
		[first]:
			None
		[first, second, third, ...rest]:
			None


private pure func ranked_tensor_checked_get_rank(name: String) -> Option[Int]:
	if name == "blorp_tensor3_checked_get":
		Some(3)
	else if name == "blorp_tensor3_checked_get_shape":
		Some(3)
	else if name == "blorp_tensor3_checked_get_shape_f64":
		Some(3)
	else if name == "blorp_tensor3_checked_get_shape_f32":
		Some(3)
	else if name == "blorp_tensor4_checked_get":
		Some(4)
	else if name == "blorp_tensor4_checked_get_shape":
		Some(4)
	else if name == "blorp_tensor4_checked_get_shape_f64":
		Some(4)
	else if name == "blorp_tensor4_checked_get_shape_f32":
		Some(4)
	else if name == "blorp_tensor5_checked_get":
		Some(5)
	else if name == "blorp_tensor5_checked_get_shape":
		Some(5)
	else if name == "blorp_tensor5_checked_get_shape_f64":
		Some(5)
	else if name == "blorp_tensor5_checked_get_shape_f32":
		Some(5)
	else:
		None


private pure func ranked_tensor_checked_get_has_shape_args(name: String) -> Bool:
	if name == "blorp_tensor3_checked_get_shape":
		True
	else if name == "blorp_tensor3_checked_get_shape_f64":
		True
	else if name == "blorp_tensor3_checked_get_shape_f32":
		True
	else if name == "blorp_tensor4_checked_get_shape":
		True
	else if name == "blorp_tensor4_checked_get_shape_f64":
		True
	else if name == "blorp_tensor4_checked_get_shape_f32":
		True
	else if name == "blorp_tensor5_checked_get_shape":
		True
	else if name == "blorp_tensor5_checked_get_shape_f64":
		True
	else if name == "blorp_tensor5_checked_get_shape_f32":
		True
	else:
		False


private pure func is_ranked_tensor_checked_get_name(name: String) -> Bool:
	match ranked_tensor_checked_get_rank(name):
		Some(_):
			True
		None:
			False


private pure func static_tensor_dim_value(dim: CoreTensorDim) -> Option[Int]:
	match dim:
		TensorStaticDim(value):
			Some(value)
		TensorRuntimeDim(name):
			None
		TensorVariadicDim(_):
			None
		TensorDimOperation(_, _, _):
			None


private pure func static_tensor_dims(dims: List[CoreTensorDim]) -> Option[List[Int]]:
	var result: List[Int] = []
	var failed: Bool = False

	for dim in dims:
		if not failed:
			match static_tensor_dim_value(dim):
				Some(value):
					result = result.append(value)
				None:
					failed = True
					break

	if failed:
		None
	else:
		Some(result)


private pure func static_tensor_dims_for_rank(tensor: CoreExpr, rank: Int) -> Option[List[Int]]:
	match core_expr_type(tensor):
		TensorType(info):
			if info.dims.length() == rank:
				static_tensor_dims(info.dims)
			else:
				None
		_:
			None


private pure func ranked_tensor_checked_get_parts(
	name: String,
	args: List[CoreExpr],
	arg_values: List[String],
) -> Option[RankedTensorCheckedGet]:
	rank ?= ranked_tensor_checked_get_rank(name)

	expected_arg_count: Int = if ranked_tensor_checked_get_has_shape_args(name):
		rank * 2 + 1
	else:
		rank + 1

	if args.length() != expected_arg_count or arg_values.length() != expected_arg_count:
		None
	else:
		tensor_expr ?= args.get(0)
		tensor ?= arg_values.get(0)
		dims ?= static_tensor_dims_for_rank(tensor_expr, rank)

		indices: List[String] = if ranked_tensor_checked_get_has_shape_args(name):
			arg_values.drop(rank + 1)
		else:
			arg_values.drop(1)

		if indices.length() == rank and dims.length() == rank:
			Some({
				tensor_expr = tensor_expr,
				tensor = tensor,
				indices = indices,
				dims = dims,
			})
		else:
			None


private pure func ranked_tensor_checked_get_vector_tmp(temp_seed: String) -> String:
	"__tgnd_vec_" + temp_seed


private pure func ranked_tensor_checked_get_index_tmp(temp_seed: String, index: Int) -> String:
	"__tgnd_i" + index.to_string() + "_" + temp_seed


private pure func ranked_tensor_checked_get_flat_tmp(temp_seed: String) -> String:
	"__tgnd_flat_" + temp_seed


private pure func ranked_tensor_checked_get_value_tmp(temp_seed: String) -> String:
	"__tgnd_value_" + temp_seed


private pure func ranked_tensor_checked_get_raw_tmp(temp_seed: String) -> String:
	"__tgnd_raw_" + temp_seed


private pure func ranked_tensor_checked_get_index_temps(
	count: Int,
	temp_seed: String,
) -> List[String]:
	var temps: List[String] = []
	var index: Int = 0

	while index < count:
		temps = temps.append(ranked_tensor_checked_get_index_tmp(temp_seed, index))
		index += 1

	temps


private pure func ranked_tensor_checked_get_index_bindings(
	indices: List[String],
	dims: List[Int],
	temp_seed: String,
) -> String:
	var statements: String = ""
	var index: Int = 0

	for index_value in indices:
		index_tmp: String = ranked_tensor_checked_get_index_tmp(temp_seed, index)
		dim: Int = dims.get_or(index, 0)
		statements += " long " + index_tmp + " = " + index_value + ";"
		statements += " if (" + index_tmp + " < 0) " + index_tmp + " += " + dim.to_string() + ";"
		index += 1

	statements


private pure func ranked_tensor_checked_get_flat_index_expr(
	index_temps: List[String],
	dims: List[Int],
) -> Option[String]:
	match index_temps:
		[]:
			None
		[first, ...rest]:
			var flat: String = first
			var dim_index: Int = 1

			for index_tmp in rest:
				dim: Int = dims.get_or(dim_index, 0)
				flat = "((" + flat + ") * " + dim.to_string() + " + " + index_tmp + ")"
				dim_index += 1

			Some(flat)


private pure func ranked_tensor_checked_get_conditions(
	vector_tmp: String,
	index_temps: List[String],
	dims: List[Int],
	flat_tmp: String,
) -> String:
	var conditions: List[String] = [vector_tmp]
	var index: Int = 0

	for index_tmp in index_temps:
		dim: Int = dims.get_or(index, 0)
		conditions = conditions.append(index_tmp + " >= 0")
		conditions = conditions.append(index_tmp + " < " + dim.to_string())

		if index == 0:
			conditions = conditions.append(index_tmp + " < " + vector_tmp + "->len")

		index += 1

	conditions = conditions.append(flat_tmp + " >= 0")
	conditions = conditions.append(flat_tmp + " < " + vector_tmp + "->capacity")
	conditions.join(" && ")


private pure func ranked_tensor_checked_get_prelude(
	get: RankedTensorCheckedGet,
	temp_seed: String,
) -> Option[RankedTensorCheckedGetPrelude]:
	vector_tmp: String = ranked_tensor_checked_get_vector_tmp(temp_seed)
	flat_tmp: String = ranked_tensor_checked_get_flat_tmp(temp_seed)
	index_temps: List[String] = ranked_tensor_checked_get_index_temps(
		get.indices.length(),
		temp_seed,
	)
	flat_expr ?= ranked_tensor_checked_get_flat_index_expr(index_temps, get.dims)
	vector_bind: String = "blorp_Vector* " + vector_tmp + " = (blorp_Vector*)" + get.tensor + ";"
	index_bindings: String = ranked_tensor_checked_get_index_bindings(
		get.indices,
		get.dims,
		temp_seed,
	)
	flat_bind: String = " long " + flat_tmp + " = " + flat_expr + ";"
	condition: String = ranked_tensor_checked_get_conditions(
		vector_tmp,
		index_temps,
		get.dims,
		flat_tmp,
	)

	Some({
		statements = vector_bind + index_bindings + flat_bind,
		condition = condition,
		flat = flat_tmp,
	})


private pure func render_ranked_tensor_checked_get_erased(
	get: RankedTensorCheckedGet,
	temp_seed: String,
) -> Option[String]:
	prelude ?= ranked_tensor_checked_get_prelude(get, temp_seed)
	vector_tmp: String = ranked_tensor_checked_get_vector_tmp(temp_seed)
	value_tmp: String = ranked_tensor_checked_get_value_tmp(temp_seed)

	read_body: String = "if (blorp_vector_is_i64_raw(" + vector_tmp + ")) { " + value_tmp + " = (void*)(intptr_t)((long*)" + vector_tmp + "->data)[" + prelude.flat + "]; } else if (" + vector_tmp + "->storage_mode == BLORP_VECTOR_STORAGE_PACKED) { " + value_tmp + " = (void*)(intptr_t)blorp_packed_get(" + vector_tmp + ", " + prelude.flat + "); } else if (" + vector_tmp + "->storage_mode == BLORP_VECTOR_STORAGE_F64) { " + value_tmp + " = blorp_box_float(blorp_vector_read_f64(" + vector_tmp + ", " + prelude.flat + ")); } else if (" + vector_tmp + "->storage_mode == BLORP_VECTOR_STORAGE_F32) { " + value_tmp + " = blorp_box_float32(blorp_vector_read_f32(" + vector_tmp + ", " + prelude.flat + ")); } else if (" + vector_tmp + "->storage_mode == BLORP_VECTOR_STORAGE_INLINE) { " + value_tmp + " = blorp_alloc(sizeof(blorp_Object) + " + vector_tmp + "->elem_size); memcpy((char*)" + value_tmp + " + sizeof(blorp_Object), (char*)" + vector_tmp + "->data + " + prelude.flat + " * " + vector_tmp + "->elem_size, " + vector_tmp + "->elem_size); } else { " + value_tmp + " = " + vector_tmp + "->data[" + prelude.flat + "]; }"

	Some(
		"({ " + prelude.statements + " void* " + value_tmp + " = (void*)0; if (__builtin_expect(" + prelude.condition + ", 1)) { " + read_body + " } " + value_tmp + "; })",
	)


private pure func emit_ranked_tensor_checked_get_call_from_values(
	name: String,
	args: List[CoreExpr],
	arg_values: List[String],
) -> Option[String]:
	get ?= ranked_tensor_checked_get_parts(name, args, arg_values)

	if name.ends_with("_f64"):
		render_ranked_tensor_checked_get_scalar(
			get,
			TENSOR_RANKED_CHECKED_GET_TEMP_SEED,
			"double",
			"0.0",
			"blorp_vector_read_f64",
		)
	else if name.ends_with("_f32"):
		render_ranked_tensor_checked_get_scalar(
			get,
			TENSOR_RANKED_CHECKED_GET_TEMP_SEED,
			"float",
			"0.0f",
			"blorp_vector_read_f32",
		)
	else:
		render_ranked_tensor_checked_get_erased(get, TENSOR_RANKED_CHECKED_GET_TEMP_SEED)


private pure func render_ranked_tensor_checked_get_scalar(
	get: RankedTensorCheckedGet,
	temp_seed: String,
	c_type: String,
	zero_value: String,
	read_helper: String,
) -> Option[String]:
	prelude ?= ranked_tensor_checked_get_prelude(get, temp_seed)
	vector_tmp: String = ranked_tensor_checked_get_vector_tmp(temp_seed)
	value_tmp: String = ranked_tensor_checked_get_value_tmp(temp_seed)

	Some(
		"({ " + prelude.statements + " " + c_type + " " + value_tmp + " = " + zero_value + "; if (__builtin_expect(" + prelude.condition + ", 1)) { " + value_tmp + " = " + read_helper + "(" + vector_tmp + ", " + prelude.flat + "); } " + value_tmp + "; })",
	)


private pure func emit_ranked_tensor_checked_get_scalar_unbox(
	name: String,
	args: List[CoreExpr],
	unbox_kind: CoreUnboxKind,
) -> Option[String]:
	arg_values ?= emit_simple_expr_arg_values(args)
	get ?= ranked_tensor_checked_get_parts(name, args, arg_values)

	match unbox_kind:
		FloatUnbox:
			render_ranked_tensor_checked_get_scalar(
				get,
				TENSOR_RANKED_CHECKED_GET_TEMP_SEED,
				"double",
				"0.0",
				"blorp_vector_read_f64",
			)
		Float32Unbox:
			render_ranked_tensor_checked_get_scalar(
				get,
				TENSOR_RANKED_CHECKED_GET_TEMP_SEED,
				"float",
				"0.0f",
				"blorp_vector_read_f32",
			)
		Float16Unbox:
			render_ranked_tensor_checked_get_scalar(
				get,
				TENSOR_RANKED_CHECKED_GET_TEMP_SEED,
				"_Float16",
				"(_Float16)0.0",
				"blorp_vector_read_f16",
			)
		_:
			None


private pure func emit_ranked_tensor_checked_get_unbox_expr(
	unbox_kind: CoreUnboxKind,
	expr_value: CoreExpr,
) -> Option[String]:
	match expr_value:
		CallExpr(BuiltinCall(name), callee, args, call_type, loc):
			emit_ranked_tensor_checked_get_scalar_unbox(name, args, unbox_kind)
		_:
			None


private pure func render_ranked_inline_struct_tensor_get_checked(
	get: RankedTensorCheckedGet,
	temp_seed: String,
	c_type: String,
) -> Option[String]:
	prelude ?= ranked_tensor_checked_get_prelude(get, temp_seed)
	vector_tmp: String = ranked_tensor_checked_get_vector_tmp(temp_seed)
	out_tmp: String = ranked_tensor_checked_get_value_tmp(temp_seed)
	raw_tmp: String = ranked_tensor_checked_get_raw_tmp(temp_seed)
	load_body: String = "if (__builtin_expect(" + vector_tmp + "->storage_mode == BLORP_VECTOR_STORAGE_INLINE && " + vector_tmp + "->elem_size == sizeof(" + c_type + "), 1)) { memcpy(&" + out_tmp + ", (char*)" + vector_tmp + "->data + " + prelude.flat + " * sizeof(" + c_type + "), sizeof(" + c_type + ")); } else { void* " + raw_tmp + " = " + vector_tmp + "->data[" + prelude.flat + "]; " + out_tmp + " = blorp_unbox_struct(" + raw_tmp + ", " + c_type + "); }"

	Some(
		"({ " + prelude.statements + " " + c_type + " " + out_tmp + " = {0}; if (__builtin_expect(" + prelude.condition + ", 1)) { " + load_body + " } " + out_tmp + "; })",
	)


private pure func emit_ranked_inline_struct_tensor_get_checked(
	name: String,
	args: List[CoreExpr],
	c_type: String,
) -> Option[String]:
	arg_values ?= emit_simple_expr_arg_values(args)
	get ?= ranked_tensor_checked_get_parts(name, args, arg_values)
	render_ranked_inline_struct_tensor_get_checked(get, TENSOR_RANKED_CHECKED_GET_TEMP_SEED, c_type)


private pure func emit_value_record_tensor_get_unchecked(
	name: String,
	args: List[CoreExpr],
	typ: CoreType,
) -> Option[String]:
	if name == "tensor_get_unchecked":
		match typ:
			ValueRecordType(type_name):
				emit_inline_struct_tensor_get_unchecked(args, c_type_name(typ))
			NamedType(type_name, type_args):
				None
			TypeParameterType(_) | SelfType:
				None
			HeapRecordType(type_name):
				None
			UnionType(type_name):
				None
			EnumType(type_name):
				None
			StackResultType(ok_type, err_type):
				None
			BoxedResultType(ok_type, err_type):
				None
			FunctionType(is_pure, param_types, return_type):
				None
			RangeType:
				None
			TensorType(info):
				None
			TupleType(items):
				None
			VoidType:
				None
	else:
		None


private pure func tensor_raw_scalar_kind_for_type(typ: CoreType) -> Option[CoreTensorRawScalarKind]:
	match typ:
		NamedType(name, args):
			if args.length() != 0:
				None
			else if name == "Int" or name == "Int64":
				Some(TensorInt64Elements)
			else if name == "Float":
				Some(TensorFloat64Elements)
			else if name == "Float32":
				Some(TensorFloat32Elements)
			else:
				None
		TypeParameterType(_) | SelfType:
			None
		VoidType:
			None
		StackResultType(ok_type, err_type):
			None
		BoxedResultType(ok_type, err_type):
			None
		FunctionType(is_pure, param_types, return_type):
			None
		EnumType(type_name):
			None
		ValueRecordType(type_name):
			None
		HeapRecordType(type_name):
			None
		UnionType(type_name):
			None
		RangeType:
			None
		TensorType(info):
			None
		TupleType(items):
			None


private pure func emit_raw_scalar_tensor_get_unchecked(
	name: String,
	args: List[CoreExpr],
	typ: CoreType,
) -> Option[String]:
	if name == "tensor_get_unchecked":
		kind ?= tensor_raw_scalar_kind_for_type(typ)
		arg_values ?= emit_simple_expr_arg_values(args)

		match arg_values:
			[tensor, index]:
				Some(
					"((" + tensor_raw_pointer_c_type(
						kind,
					) + ")((blorp_Vector*)" + tensor + ")->data)[" + index + "]",
				)
			[]:
				None
			[first]:
				None
			[first, second, third, ...rest]:
				None
	else:
		None


private pure func emit_list_get(get: CoreListGet) -> Option[String]:
	match get.layout:
		PointerListStorage:
			emit_runtime_list_get(get)
		InlineListStorage(width_bytes):
			emit_inline_list_get(get, width_bytes)
		InlineStructListStorage(c_type):
			emit_runtime_list_get(get)


private pure func list_handoff_storage_mode(layout: CoreListStorageLayout) -> String:
	match layout:
		PointerListStorage:
			render_prepared_list_op(ListStorageModePointer)
		InlineListStorage(width_bytes):
			render_prepared_list_op(ListStorageModeInline)
		InlineStructListStorage(c_type):
			render_prepared_list_op(ListStorageModeInline)


private pure func list_handoff_element_size(layout: CoreListStorageLayout) -> String:
	match layout:
		PointerListStorage:
			render_prepared_list_op(ListElementSizePointer)
		InlineListStorage(width_bytes):
			width_bytes.to_string()
		InlineStructListStorage(c_type):
			render_prepared_list_op(ListElementSizeInlineStruct(c_type))


private pure func list_handoff_release_fn(handoff: CoreListHandoff) -> String:
	if handoff.elem_needs_release:
		render_prepared_list_op(ListElementReleaseFn)
	else:
		render_prepared_list_op(ListElementReleaseNone)


private pure func list_handoff_emit_mode(mode: CoreListHandoffMode) -> Option[ListHandoffEmitMode]:
	if mode == BorrowFreshHandoff:
		Some(EmitBorrowFreshHandoff)
	else if mode == ConsumeReuseHandoff:
		Some(EmitConsumeReuseHandoff)
	else:
		None


private pure func list_handoff_write_order_is_supported(order: CoreListHandoffWriteOrder) -> Bool:
	order == ForwardCompactingHandoff


private pure func list_handoff_prefix(
	handoff: CoreListHandoff,
	mode: ListHandoffEmitMode,
	source_c: String,
	capacity_c: String,
) -> String:
	args: ListHandoffPrefixArgs = {
		source_ty = c_type_name(handoff.source_type),
		source = c_var_name(handoff.source_var),
		source_expr = source_c,
		capacity_expr = capacity_c,
		length = c_var_name(handoff.len_var),
		release_fn = list_handoff_release_fn(handoff),
		result_ty = c_type_name(handoff.result_type),
		result = c_var_name(handoff.result_var),
		storage_mode = list_handoff_storage_mode(handoff.layout),
		elem_size = list_handoff_element_size(handoff.layout),
		out = c_var_name(handoff.out_var),
		temp_seed = LIST_HANDOFF_TEMP_SEED
	}

	match mode:
		EmitBorrowFreshHandoff:
			render_prepared_list_op(ListHandoffBorrowPrefix(args))
		EmitConsumeReuseHandoff:
			render_prepared_list_op(ListHandoffReusePrefix(args))


private pure func list_handoff_suffix(
	handoff: CoreListHandoff,
	mode: ListHandoffEmitMode,
) -> String:
	match mode:
		EmitBorrowFreshHandoff:
			args: ListHandoffBorrowSuffixArgs = {
				result = c_var_name(handoff.result_var),
				out = c_var_name(handoff.out_var),
				length = c_var_name(handoff.len_var)
			}
			render_prepared_list_op(ListHandoffBorrowSuffix(args))
		EmitConsumeReuseHandoff:
			args: ListHandoffReuseSuffixArgs = {
				result = c_var_name(handoff.result_var),
				out = c_var_name(handoff.out_var),
				length = c_var_name(handoff.len_var),
				source = c_var_name(handoff.source_var),
				temp_seed = LIST_HANDOFF_TEMP_SEED
			}
			render_prepared_list_op(ListHandoffReuseSuffix(args))


private pure func emit_list_handoff(handoff: CoreListHandoff) -> Option[String]:
	mode ?= list_handoff_emit_mode(handoff.mode)

	if list_handoff_write_order_is_supported(handoff.write_order):
		source_c ?= emit_simple_expr(handoff.source)
		capacity_c ?= emit_simple_expr(handoff.capacity)
		body_c ?= emit_function_body(handoff.body, 0)
		body_statements: String = statement_body(handoff.body, body_c)

		Some(
			list_handoff_prefix(
				handoff,
				mode,
				source_c,
				capacity_c,
			) + "\n" + body_statements + list_handoff_suffix(handoff, mode),
		)
	else:
		None


private pure func emit_string_byte_read(read: CoreStringByteRead) -> Option[String]:
	source_c ?= emit_simple_expr(read.source)
	index_c ?= emit_simple_expr(read.index)
	Some("(long)(unsigned char)((blorp_String*)" + source_c + ")->data[" + index_c + "]")


private pure func emit_string_byte_write(write: CoreStringByteWrite) -> Option[String]:
	target_c ?= emit_simple_expr(write.target)
	index_c ?= emit_simple_expr(write.index)
	byte_c ?= emit_simple_expr(write.byte)

	Some("(((blorp_String*)" + target_c + ")->data[" + index_c + "] = (char)" + byte_c + ")")


private pure func emit_string_byte_copy(copy: CoreStringByteCopy) -> Option[String]:
	dst_c ?= emit_simple_expr(copy.dst)
	dst_pos_c ?= emit_simple_expr(copy.dst_pos)
	src_c ?= emit_simple_expr(copy.src)
	src_pos_c ?= emit_simple_expr(copy.src_pos)
	len_c ?= emit_simple_expr(copy.len)
	bind_dst: String = "blorp_String* __string_copy_dst = (blorp_String*)" + dst_c + ";"
	bind_dst_pos: String = "long __string_copy_dst_pos = " + dst_pos_c + ";"
	bind_src: String = "blorp_String* __string_copy_src = (blorp_String*)" + src_c + ";"
	bind_src_pos: String = "long __string_copy_src_pos = " + src_pos_c + ";"
	bind_len: String = "long __string_copy_len = " + len_c + ";"
	copy_statement: String = (
		"if (__string_copy_len > 0) { memcpy(__string_copy_dst->data + "
		+ "__string_copy_dst_pos, __string_copy_src->data + __string_copy_src_pos, "
		+ "(size_t)__string_copy_len); }"
	)

	Some(
		"({ " + bind_dst + " " + bind_dst_pos + " " + bind_src + " " + bind_src_pos + " " + bind_len + " " + copy_statement + " (void)0; })",
	)


private pure func emit_string_set_len(set_len: CoreStringSetLen) -> Option[String]:
	target_c ?= emit_simple_expr(set_len.target)
	len_c ?= emit_simple_expr(set_len.len)
	body: String = "blorp_String* __string_set_len_target = (blorp_String*)" + target_c + "; long __string_set_len_value = " + len_c + "; __string_set_len_target->len = __string_set_len_value; __string_set_len_target->data[__string_set_len_value] = '\\0'; (void)0;"

	Some("({ " + body + " })")


private pure func tensor_raw_scalar_supported(kind: CoreTensorRawScalarKind) -> Bool:
	if kind == TensorFloat64Elements:
		True
	else if kind == TensorFloat32Elements:
		True
	else if kind == TensorInt64Elements:
		True
	else:
		False


private pure func tensor_raw_pointer_c_type(kind: CoreTensorRawScalarKind) -> String:
	match kind:
		TensorFloat64Elements:
			"double*"
		TensorFloat32Elements:
			"float*"
		TensorInt64Elements:
			"long*"


private pure func tensor_raw_view_decl(binding: CoreTensorRawViewBinding) -> Option[String]:
	source_c ?= emit_simple_expr(binding.source)
	args: RawViewDeclArgs = {
		pointer_c_type = tensor_raw_pointer_c_type(binding.kind),
		view = binding.variable.name,
		source = source_c
	}

	Some(render_prepared_tensor_op(RawViewDecl(args)))


private pure func emit_tensor_raw_read(read: CoreTensorRawRead) -> Option[String]:
	index_c ?= emit_simple_expr(read.index)

	if tensor_raw_scalar_supported(read.kind):
		Some(render_prepared_tensor_op(RawRead(read.view.name, index_c)))
	else:
		None


private pure func emit_tensor_raw_write(write: CoreTensorRawWrite) -> Option[String]:
	index_c ?= emit_simple_expr(write.index)
	value_c ?= emit_simple_expr(write.value)
	args: RawWriteArgs = {
		view = write.view.name,
		index = index_c,
		value = value_c
	}

	if tensor_raw_scalar_supported(write.kind):
		Some(render_prepared_tensor_op(RawWriteExpr(args)))
	else:
		None


private union TensorLiteralAllocShape:
	TensorFlatAlloc(String)
	TensorRankedAlloc(String, String)


private pure func int_product_from_first(first: Int, rest: List[Int]) -> Int:
	var total: Int = first

	for value in rest:
		total *= value

	total


private pure func tensor_literal_alloc_shape(
	shape: CoreTensorLiteralShape,
) -> TensorLiteralAllocShape:
	match shape:
		TensorVectorLength(length):
			TensorFlatAlloc(length.to_string())
		TensorStaticShape(dims):
			match dims:
				[]:
					TensorFlatAlloc("0")
				[first, ...rest]:
					TensorRankedAlloc(
						first.to_string(),
						int_product_from_first(first, rest).to_string(),
					)


private pure func tensor_literal_alloc_op(
	kind: CoreTensorRawScalarKind,
	shape: CoreTensorLiteralShape,
) -> PreparedTensorOp:
	match tensor_literal_alloc_shape(shape):
		TensorFlatAlloc(size):
			match kind:
				TensorFloat64Elements:
					TensorAllocF64(size)
				TensorFloat32Elements:
					TensorAllocF32(size)
				TensorInt64Elements:
					TensorAllocI64(size)
		TensorRankedAlloc(first_dim, total_dim):
			args: TensorRankedAllocArgs = {
				first_dim = first_dim,
				total_dim = total_dim
			}

			match kind:
				TensorFloat64Elements:
					TensorRankedAllocF64(args)
				TensorFloat32Elements:
					TensorRankedAllocF32(args)
				TensorInt64Elements:
					TensorRankedAllocI64(args)


private pure func tensor_literal_write_statement(
	tensor: String,
	kind: CoreTensorRawScalarKind,
	index: Int,
	value: CoreExpr,
) -> Option[String]:
	value_c ?= emit_simple_expr(value)
	args: TensorLiteralWriteArgs = {
		tensor = tensor,
		index = index.to_string(),
		value = value_c
	}

	match kind:
		TensorFloat64Elements:
			Some(render_prepared_tensor_op(TensorLiteralF64Write(args)))
		TensorFloat32Elements:
			Some(render_prepared_tensor_op(TensorLiteralF32Write(args)))
		TensorInt64Elements:
			Some(render_prepared_tensor_op(TensorLiteralI64Write(args)))


private pure func tensor_literal_write_statements(
	tensor: String,
	raw: CoreTensorRawLiteral,
) -> Option[String]:
	var statements: String = ""
	var failed: Bool = False
	var index: Int = 0

	for element in raw.elements:
		if not failed:
			match tensor_literal_write_statement(tensor, raw.raw_kind, index, element):
				Some(statement):
					statements += statement + " "
				None:
					failed = True
					break

		index += 1

	if failed:
		None
	else:
		Some(statements)


private pure func tensor_inline_struct_literal_alloc_op(
	shape: CoreTensorLiteralShape,
	struct_c_type: String,
) -> PreparedTensorOp:
	match tensor_literal_alloc_shape(shape):
		TensorFlatAlloc(size):
			TensorAllocSized({
				size = size,
				struct_ty = struct_c_type,
			})
		TensorRankedAlloc(first_dim, total_dim):
			TensorRankedAllocSized({
				first_dim = first_dim,
				total_dim = total_dim,
				struct_ty = struct_c_type,
			})


private pure func tensor_inline_struct_literal_write_statement(
	tensor: String,
	index: Int,
	value: CoreExpr,
	temp_seed: String,
	struct_c_type: String,
) -> Option[String]:
	value_c ?= emit_simple_expr(value)
	args: TensorLiteralInlineStructWriteArgs = {
		tensor = tensor,
		index = index.to_string(),
		value = value_c,
		temp_seed = temp_seed + "_" + index.to_string(),
		struct_ty = struct_c_type
	}

	Some(render_prepared_tensor_op(TensorLiteralInlineStructWrite(args)))


private pure func tensor_inline_struct_literal_write_statements(
	tensor: String,
	inline_struct: CoreTensorInlineStructLiteral,
	temp_seed: String,
) -> Option[String]:
	var statements: String = ""
	var failed: Bool = False
	var index: Int = 0

	for element in inline_struct.elements:
		if not failed:
			match tensor_inline_struct_literal_write_statement(
				tensor,
				index,
				element,
				temp_seed,
				inline_struct.struct_c_type,
			):
				Some(statement):
					statements += statement + " "
				None:
					failed = True
					break

		index += 1

	if failed:
		None
	else:
		Some(statements)


private pure func emit_tensor_literal_payload(
	shape: CoreTensorLiteralShape,
	payload: CoreTensorLiteralPayload,
	temp_seed: String,
	tensor: String,
) -> Option[(String, String)]:
	match payload:
		TensorRawLiteralPayload(raw):
			alloc_expr: String = render_prepared_tensor_op(
				tensor_literal_alloc_op(
					raw.raw_kind,
					shape,
				),
			)
			statements ?= tensor_literal_write_statements(tensor, raw)
			Some((alloc_expr, statements))
		TensorInlineStructLiteralPayload(inline_struct):
			alloc_expr: String = render_prepared_tensor_op(
				tensor_inline_struct_literal_alloc_op(
					shape,
					inline_struct.struct_c_type,
				),
			)
			statements ?= tensor_inline_struct_literal_write_statements(
				tensor,
				inline_struct,
				temp_seed,
			)
			Some((alloc_expr, statements))


private pure func emit_tensor_literal(
	literal: CoreTensorLiteral,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	temp_seed: String = next_temp.to_string()
	tensor: String = render_prepared_tensor_op(TensorLiteralName(temp_seed))
	payload_result ?= emit_tensor_literal_payload(literal.shape, literal.payload, temp_seed, tensor)
	(alloc_expr, statements) = payload_result
	construct_args: TensorLiteralConstructArgs = {
		tensor = tensor,
		alloc_expr = alloc_expr,
		statements = statements
	}

	Some({
		statements = "",
		value = render_prepared_tensor_op(TensorLiteralConstruct(construct_args)),
		next_temp = next_temp + 1,
		returns = False,
	})


private pure func tensor_raw_fill_value_c_type(kind: CoreTensorRawScalarKind) -> String:
	match kind:
		TensorFloat64Elements:
			"double"
		TensorFloat32Elements:
			"float"
		TensorInt64Elements:
			"long"


private pure func tensor_raw_fill_alloc_op(
	kind: CoreTensorRawScalarKind,
	first_dim: String,
	total_dim: String,
) -> PreparedTensorOp:
	args: TensorRankedAllocArgs = {
		first_dim = first_dim,
		total_dim = total_dim
	}

	match kind:
		TensorFloat64Elements:
			TensorRankedAllocF64(args)
		TensorFloat32Elements:
			TensorRankedAllocF32(args)
		TensorInt64Elements:
			TensorRankedAllocI64(args)


private pure func tensor_raw_fill_dim_name(temp_seed: String, index: Int) -> String:
	render_prepared_tensor_op(TensorFillDimName({
		temp_seed = temp_seed,
		dim_index = index.to_string(),
	}))


private pure func tensor_raw_fill_dim_names(
	temp_seed: String,
	dims: List[CoreExpr],
) -> List[String]:
	var names: List[String] = []
	var index: Int = 0

	for dim in dims:
		names = names.append(tensor_raw_fill_dim_name(temp_seed, index))
		index += 1

	names


private pure func tensor_raw_fill_dim_bindings(
	temp_seed: String,
	dims: List[CoreExpr],
) -> Option[String]:
	var statements: String = ""
	var failed: Bool = False
	var index: Int = 0

	for dim in dims:
		if not failed:
			match emit_simple_expr(dim):
				Some(dim_value):
					args: TensorFillDimBindArgs = {
						temp_seed = temp_seed,
						dim_index = index.to_string(),
						dim_value = dim_value
					}
					statements += render_prepared_tensor_op(TensorFillDimBind(args)) + " "
				None:
					failed = True
					break

		index += 1

	if failed:
		None
	else:
		Some(statements)


private pure func tensor_raw_fill_total_expr(dim_names: List[String]) -> String:
	var total_expr: String = ""

	for dim_name in dim_names:
		if total_expr == "":
			total_expr = dim_name
		else:
			total_expr = render_prepared_tensor_op(TensorFillProductExpr(total_expr, dim_name))

	if total_expr == "":
		"0"
	else:
		total_expr


private pure func tensor_raw_fill_value_expr(value: CoreExpr) -> CoreExpr:
	match value:
		BoxExpr(box, box_type, box_loc):
			box.value
		other:
			other


private pure func emit_tensor_raw_fill(
	fill: CoreTensorRawFill,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match fill.dims:
		[]:
			None
		[first_dim_expr, ...rest_dims]:
			temp_seed: String = next_temp.to_string()
			dim_bindings ?= tensor_raw_fill_dim_bindings(temp_seed, fill.dims)
			dim_names: List[String] = tensor_raw_fill_dim_names(temp_seed, fill.dims)
			first_dim: String = tensor_raw_fill_dim_name(temp_seed, 0)
			total_expr: String = tensor_raw_fill_total_expr(dim_names)
			total_dim: String = render_prepared_tensor_op(TensorFillTotalName(temp_seed))
			value ?= emit_simple_expr(tensor_raw_fill_value_expr(fill.value))
			alloc_expr: String = render_prepared_tensor_op(
				tensor_raw_fill_alloc_op(
					fill.raw_kind,
					first_dim,
					total_dim,
				),
			)
			args: TensorFillRawScalarArgs = {
				dim_bindings = dim_bindings,
				total_expr = total_expr,
				value_c_type = tensor_raw_fill_value_c_type(fill.raw_kind),
				value = value,
				alloc_expr = alloc_expr,
				temp_seed = temp_seed
			}

			Some({
				statements = "",
				value = render_prepared_tensor_op(TensorFillRawScalar(args)),
				next_temp = next_temp + 1,
				returns = False,
			})


private pure func tensor_boxed_literal_alloc_op(shape: CoreTensorLiteralShape) -> PreparedTensorOp:
	match tensor_literal_alloc_shape(shape):
		TensorFlatAlloc(size):
			TensorAllocPointer(size)
		TensorRankedAlloc(first_dim, total_dim):
			TensorRankedAllocPointer({
				first_dim = first_dim,
				total_dim = total_dim,
			})


private pure func tensor_boxed_literal_write_statement(
	tensor: String,
	elem_needs_release: Bool,
	index: Int,
	value: CoreBoxedStorageValue,
	temp_seed: String,
) -> Option[String]:
	value_c ?= emit_boxed_pointer_value(value)

	if elem_needs_release:
		args: TensorLiteralBoxedSeededWriteArgs = {
			tensor = tensor,
			index = index.to_string(),
			value = value_c,
			temp_seed = temp_seed + "_" + index.to_string()
		}

		if value.transfers_ownership:
			Some(render_prepared_tensor_op(TensorLiteralBoxedOwnedWrite(args)))
		else:
			Some(render_prepared_tensor_op(TensorLiteralBoxedBorrowedWrite(args)))
	else:
		args: TensorLiteralWriteArgs = {
			tensor = tensor,
			index = index.to_string(),
			value = value_c
		}

		Some(render_prepared_tensor_op(TensorLiteralBoxedWrite(args)))


private pure func tensor_boxed_literal_write_statements(
	tensor: String,
	literal: CoreTensorBoxedLiteral,
	temp_seed: String,
) -> Option[String]:
	var statements: String = if literal.elem_needs_release:
		render_prepared_tensor_op(TensorInitElemRelease(tensor)) + " "
	else:
		""

	var failed: Bool = False
	var index: Int = 0

	for element in literal.elements:
		if not failed:
			match tensor_boxed_literal_write_statement(
				tensor,
				literal.elem_needs_release,
				index,
				element,
				temp_seed,
			):
				Some(statement):
					statements += statement + " "
				None:
					failed = True
					break

		index += 1

	if failed:
		None
	else:
		Some(statements)


private pure func emit_tensor_boxed_literal(
	literal: CoreTensorBoxedLiteral,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	temp_seed: String = next_temp.to_string()
	tensor: String = render_prepared_tensor_op(TensorLiteralName(temp_seed))
	alloc_expr: String = render_prepared_tensor_op(tensor_boxed_literal_alloc_op(literal.shape))
	statements ?= tensor_boxed_literal_write_statements(tensor, literal, temp_seed)
	construct_args: TensorLiteralConstructArgs = {
		tensor = tensor,
		alloc_expr = alloc_expr,
		statements = statements
	}

	Some({
		statements = "",
		value = render_prepared_tensor_op(TensorLiteralConstruct(construct_args)),
		next_temp = next_temp + 1,
		returns = False,
	})


private pure func tensor_packed_literal_alloc_op(
	literal: CoreTensorPackedLiteral,
) -> PreparedTensorOp:
	elem_size: String = literal.elem_size.to_string()

	match tensor_literal_alloc_shape(literal.shape):
		TensorFlatAlloc(size):
			TensorAllocPacked({
				size = size,
				elem_size = elem_size,
			})
		TensorRankedAlloc(first_dim, total_dim):
			TensorRankedAllocPacked({
				first_dim = first_dim,
				total_dim = total_dim,
				elem_size = elem_size,
			})


private pure func tensor_packed_literal_write_statement(
	tensor: String,
	index: Int,
	value: CoreExpr,
) -> Option[String]:
	value_c ?= emit_simple_expr(value)
	args: TensorLiteralWriteArgs = {
		tensor = tensor,
		index = index.to_string(),
		value = value_c
	}

	Some(render_prepared_tensor_op(TensorLiteralPackedWrite(args)))


private pure func tensor_packed_literal_write_statements(
	tensor: String,
	literal: CoreTensorPackedLiteral,
) -> Option[String]:
	var statements: String = ""
	var failed: Bool = False
	var index: Int = 0

	for element in literal.elements:
		if not failed:
			match tensor_packed_literal_write_statement(tensor, index, element):
				Some(statement):
					statements += statement + " "
				None:
					failed = True
					break

		index += 1

	if failed:
		None
	else:
		Some(statements)


private pure func emit_tensor_packed_literal(
	literal: CoreTensorPackedLiteral,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	temp_seed: String = next_temp.to_string()
	tensor: String = render_prepared_tensor_op(TensorLiteralName(temp_seed))
	alloc_expr: String = render_prepared_tensor_op(tensor_packed_literal_alloc_op(literal))
	statements ?= tensor_packed_literal_write_statements(tensor, literal)
	construct_args: TensorLiteralConstructArgs = {
		tensor = tensor,
		alloc_expr = alloc_expr,
		statements = statements
	}

	Some({
		statements = "",
		value = render_prepared_tensor_op(TensorLiteralConstruct(construct_args)),
		next_temp = next_temp + 1,
		returns = False,
	})


private pure func hash_container_release_arg(needs_release: Bool) -> ElemReleaseArg:
	if needs_release:
		ElemReleaseFn
	else:
		NoElemRelease


private pure func custom_ctor_args(hash_fn: String, equals_fn: String) -> CustomCtorArgs:
	{
		hash_fn = hash_fn,
		equals_fn = equals_fn
	}


private pure func emit_dict_constructor(constructor: CoreHashContainerConstructor) -> String:
	match constructor:
		GenericHashContainerConstructor:
			render_prepared_backend_op(BackendDictCtorGeneric)
		StringHashContainerConstructor:
			render_prepared_backend_op(BackendDictCtorString)
		FloatHashContainerConstructor:
			render_prepared_backend_op(BackendDictCtorFloat)
		CustomHashContainerConstructor(hash_fn, equals_fn, elem_needs_release):
			render_prepared_backend_op(
				BackendDictCtorCustom(
					custom_ctor_args(hash_fn, equals_fn),
					hash_container_release_arg(elem_needs_release),
				),
			)


private pure func emit_dict_construct_result(ctor_c: String, typ: CoreType) -> String:
	if dict_value_needs_release_type(typ):
		release_init: String = render_prepared_backend_op(
			BackendDictValueReleaseInit(DICT_CONSTRUCT_TEMP_SEED),
		)
		args: DictConstructWithBodyArgs = {
			ctor = ctor_c,
			temp_seed = DICT_CONSTRUCT_TEMP_SEED,
			release_init = release_init,
			insert_statements = ""
		}

		render_prepared_backend_op(BackendDictConstructWithBody(args))
	else:
		ctor_c


private pure func capacity_custom_ctor_args(
	capacity: String,
	hash_fn: String,
	equals_fn: String,
) -> CapacityCustomCtorArgs:
	{
		capacity = capacity,
		hash_fn = hash_fn,
		equals_fn = equals_fn
	}


private pure func emit_dict_with_capacity_constructor(
	constructor: CoreHashContainerConstructor,
	capacity: String,
) -> String:
	match constructor:
		GenericHashContainerConstructor:
			render_prepared_backend_op(BackendDictWithCapacityGeneric(capacity))
		StringHashContainerConstructor:
			render_prepared_backend_op(BackendDictWithCapacityString(capacity))
		FloatHashContainerConstructor:
			render_prepared_backend_op(BackendDictWithCapacityFloat(capacity))
		CustomHashContainerConstructor(hash_fn, equals_fn, elem_needs_release):
			render_prepared_backend_op(
				BackendDictWithCapacityCustom(
					capacity_custom_ctor_args(capacity, hash_fn, equals_fn),
					hash_container_release_arg(elem_needs_release),
				),
			)


private pure func emit_dict_with_capacity_call(
	constructor: CoreHashContainerConstructor,
	args: List[String],
	typ: CoreType,
) -> Option[String]:
	match args:
		[capacity]:
			Some(
				emit_dict_construct_result(
					emit_dict_with_capacity_constructor(constructor, capacity),
					typ,
				),
			)
		[]:
			None
		[first, second, ...rest]:
			None


private pure func emit_set_constructor(constructor: CoreHashContainerConstructor) -> String:
	match constructor:
		GenericHashContainerConstructor:
			render_prepared_backend_op(BackendSetCtorGeneric)
		StringHashContainerConstructor:
			render_prepared_backend_op(BackendSetCtorString)
		FloatHashContainerConstructor:
			render_prepared_backend_op(BackendSetCtorFloat)
		CustomHashContainerConstructor(hash_fn, equals_fn, elem_needs_release):
			render_prepared_backend_op(
				BackendSetCtorCustom(
					custom_ctor_args(hash_fn, equals_fn),
					hash_container_release_arg(elem_needs_release),
				),
			)


private pure func emit_dict_insert_statement(entry: CoreDictEntry) -> Option[String]:
	key_c ?= emit_boxed_pointer_value(entry.key)
	value_c ?= emit_boxed_pointer_value(entry.value)

	Some(render_prepared_backend_op(BackendDictInsert({
		temp_seed = DICT_CONSTRUCT_TEMP_SEED,
		key = key_c,
		value = value_c,
		key_transfers_ownership = entry.key.transfers_ownership,
		value_transfers_ownership = entry.value.transfers_ownership,
	})))


private pure func emit_dict_insert_statements(entries: List[CoreDictEntry]) -> Option[String]:
	var statements: String = ""
	var failed: Bool = False

	for entry in entries:
		if failed:
			void
		else:
			match emit_dict_insert_statement(entry):
				Some(statement):
					statements += statement
				None:
					failed = True
					break

	if failed:
		None
	else:
		Some(statements)


private pure func emit_dict_construct(construct: CoreDictConstruct) -> Option[String]:
	ctor_c: String = emit_dict_constructor(construct.constructor)

	if construct.entries.length() == 0 and not construct.value_needs_release:
		Some(render_prepared_backend_op(BackendDictConstructEmpty(ctor_c)))
	else:
		insert_statements ?= emit_dict_insert_statements(construct.entries)

		release_init: String = if construct.value_needs_release:
			render_prepared_backend_op(BackendDictValueReleaseInit(DICT_CONSTRUCT_TEMP_SEED))
		else:
			""

		args: DictConstructWithBodyArgs = {
			ctor = ctor_c,
			temp_seed = DICT_CONSTRUCT_TEMP_SEED,
			release_init = release_init,
			insert_statements = insert_statements
		}

		Some(render_prepared_backend_op(BackendDictConstructWithBody(args)))


private pure func emit_set_alloc(constructor: CoreHashContainerConstructor) -> Option[String]:
	Some(emit_set_constructor(constructor))


private enum ListStoreMode:
	StandardListStore
	HandoffOwnedListStore


private pure func emit_inline_struct_list_set(set: CoreListSet, c_type: String) -> Option[String]:
	list_c ?= emit_simple_expr(set.list)
	index_c ?= emit_simple_expr(set.index)
	value_c ?= emit_simple_expr(set.value.value)

	boxed_fallback: String = if set.value_is_stack_result:
		"blorp_box_stack_result(__list_elem)"
	else:
		"blorp_box_struct(&__list_elem, sizeof(" + c_type + "))"

	Some(
		"({ blorp_List* __list_store = (blorp_List*)" + list_c + "; long __list_store_idx = " + index_c + "; " + c_type + " __list_elem = " + value_c + ((
			"; if (__list_store && __list_store->storage_mode == BLORP_LIST_STORAGE_INLINE "
			+ "&& __list_store->elem_size == (int16_t)sizeof("
		)) + c_type + ((
			")) { blorp_list_set_raw_copy(__list_store, __list_store_idx, &__list_elem); } "
			+ "else { blorp_list_set_raw((blorp_List*)__list_store, __list_store_idx, (void*)"
		)) + boxed_fallback + "); } })",
	)


private pure func emit_pointer_list_set(set: CoreListSet) -> Option[String]:
	list_c ?= emit_simple_expr(set.list)
	index_c ?= emit_simple_expr(set.index)
	value_c ?= emit_boxed_pointer_value(set.value)

	Some("({ blorp_list_set_raw((blorp_List*)" + list_c + ", " + index_c + ", " + value_c + "); })")


private pure func emit_pointer_list_set_body(
	set: CoreListSet,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	list_c ?= emit_simple_expr(set.list)
	index_c ?= emit_simple_expr(set.index)
	value_body ?= emit_boxed_pointer_body(set.value, next_temp)
	value ?= required_body_value(value_body)

	Some({
		statements = value_body.statements + "  blorp_list_set_raw((blorp_List*)" + list_c + ", " + index_c + ", " + value + ");\n",
		value = "",
		next_temp = value_body.next_temp,
		returns = False,
	})


private pure func emit_inline_scalar_list_store(
	set: CoreListSet,
	width_c: String,
) -> Option[String]:
	list_c ?= emit_simple_expr(set.list)
	index_c ?= emit_simple_expr(set.index)
	value_c ?= emit_simple_expr(set.value.value)
	c_type: String = c_type_name(core_expr_type(set.value.value))

	Some(
		"({ blorp_List* __list_store_inline_set = (blorp_List*)" + list_c + "; long __list_store_idx_inline_set = " + index_c + "; " + c_type + " __list_store_value_inline_set = " + value_c + ((
			"; if (__list_store_inline_set && __list_store_idx_inline_set >= 0 && "
			+ "__list_store_idx_inline_set < __list_store_inline_set->capacity) { "
			+ "memcpy((char*)__list_store_inline_set->data + __list_store_idx_inline_set * "
		)) + width_c + ", &__list_store_value_inline_set, " + width_c + "); } })",
	)


private pure func emit_inline_list_set(set: CoreListSet, width_bytes: Int) -> Option[String]:
	emit_inline_scalar_list_store(set, width_bytes.to_string())


private pure func emit_list_store(mode: ListStoreMode, set: CoreListSet) -> Option[String]:
	match set.layout:
		InlineStructListStorage(c_type):
			match mode:
				StandardListStore:
					emit_inline_struct_list_set(set, c_type)
				HandoffOwnedListStore:
					emit_inline_struct_list_handoff_set_owned(set, c_type)
		PointerListStorage:
			match mode:
				StandardListStore:
					emit_pointer_list_set(set)
				HandoffOwnedListStore:
					emit_pointer_list_handoff_set_owned(set)
		InlineListStorage(width_bytes):
			match mode:
				StandardListStore:
					emit_inline_list_set(set, width_bytes)
				HandoffOwnedListStore:
					emit_inline_list_handoff_set_owned(set)


private pure func emit_list_set(set: CoreListSet) -> Option[String]:
	emit_list_store(StandardListStore, set)


private pure func emit_list_store_body(
	mode: ListStoreMode,
	set: CoreListSet,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match set.layout:
		InlineStructListStorage(c_type):
			value ?= match mode:
				StandardListStore:
					emit_inline_struct_list_set(set, c_type)
				HandoffOwnedListStore:
					emit_inline_struct_list_handoff_set_owned(set, c_type)

			Some(body_value(value, next_temp))
		PointerListStorage:
			match mode:
				StandardListStore:
					emit_pointer_list_set_body(set, next_temp)
				HandoffOwnedListStore:
					emit_pointer_list_handoff_set_owned_body(set, next_temp)
		InlineListStorage(width_bytes):
			value ?= match mode:
				StandardListStore:
					emit_inline_list_set(set, width_bytes)
				HandoffOwnedListStore:
					emit_inline_list_handoff_set_owned(set)

			Some(body_value(value, next_temp))


private pure func emit_list_set_body(set: CoreListSet, next_temp: Int) -> Option[FunctionBodyC]:
	emit_list_store_body(StandardListStore, set, next_temp)


private pure func emit_pointer_list_swap(swap: CoreListSwap) -> Option[String]:
	list_c ?= emit_simple_expr(swap.list)
	left_index_c ?= emit_simple_expr(swap.left_index)
	right_index_c ?= emit_simple_expr(swap.right_index)
	args: PointerSwapArgs = {
		list = list_c,
		left_index = left_index_c,
		right_index = right_index_c,
		temp_seed = LIST_SWAP_TEMP_SEED
	}

	Some(render_prepared_list_op(PointerSwap(args)))


private pure func emit_inline_list_swap(swap: CoreListSwap, width_bytes: Int) -> Option[String]:
	list_c ?= emit_simple_expr(swap.list)
	left_index_c ?= emit_simple_expr(swap.left_index)
	right_index_c ?= emit_simple_expr(swap.right_index)
	args: InlineBitsSwapArgs = {
		list = list_c,
		left_index = left_index_c,
		right_index = right_index_c,
		temp_seed = LIST_SWAP_TEMP_SEED,
		width_bytes = width_bytes.to_string()
	}

	Some(render_prepared_list_op(InlineBitsSwap(args)))


private pure func emit_inline_struct_list_swap(swap: CoreListSwap) -> Option[String]:
	list_c ?= emit_simple_expr(swap.list)
	left_index_c ?= emit_simple_expr(swap.left_index)
	right_index_c ?= emit_simple_expr(swap.right_index)
	args: InlineStructSwapArgs = {
		list = list_c,
		left_index = left_index_c,
		right_index = right_index_c,
		temp_seed = LIST_SWAP_TEMP_SEED
	}

	Some(render_prepared_list_op(InlineStructSwap(args)))


private pure func emit_list_swap(swap: CoreListSwap) -> Option[String]:
	match swap.layout:
		PointerListStorage:
			emit_pointer_list_swap(swap)
		InlineListStorage(width_bytes):
			emit_inline_list_swap(swap, width_bytes)
		InlineStructListStorage(c_type):
			emit_inline_struct_list_swap(swap)


private pure func emit_pointer_list_handoff_set_owned(set: CoreListSet) -> Option[String]:
	list_c ?= emit_simple_expr(set.list)
	index_c ?= emit_simple_expr(set.index)
	value_c ?= emit_boxed_pointer_value(set.value)
	args: PointerStoreArgs = {
		list = list_c,
		index = index_c,
		value = value_c
	}

	Some(render_prepared_list_op(PointerHandoffSetOwnedStore(args)))


private pure func emit_inline_list_handoff_set_owned(set: CoreListSet) -> Option[String]:
	emit_inline_scalar_list_store(set, "__list_store_inline_set->elem_size")


private pure func emit_pointer_list_handoff_set_owned_body(
	set: CoreListSet,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	emit_pointer_list_set_body(set, next_temp)


private pure func emit_inline_struct_list_handoff_set_owned(
	set: CoreListSet,
	c_type: String,
) -> Option[String]:
	list_c ?= emit_simple_expr(set.list)
	index_c ?= emit_simple_expr(set.index)
	value_c ?= emit_simple_expr(set.value.value)

	boxing: InlineStructStoreBoxing = if set.value_is_stack_result:
		StackResultBoxing
	else:
		StructAddressBoxing

	args: InlineStructStoreArgs = {
		list = list_c,
		index = index_c,
		value = value_c,
		boxing = boxing,
		temp_seed = LIST_HANDOFF_STORE_TEMP_SEED,
		struct_ty = c_type
	}

	Some(render_prepared_list_op(InlineStructHandoffSetOwnedStore(args)))


private pure func emit_list_handoff_set_owned(set: CoreListSet) -> Option[String]:
	emit_list_store(HandoffOwnedListStore, set)


private pure func emit_list_handoff_set_owned_body(
	set: CoreListSet,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	emit_list_store_body(HandoffOwnedListStore, set, next_temp)


private pure func emit_list_handoff_set_source_slot(
	slot: CoreListHandoffSetSourceSlot,
) -> Option[String]:
	result_c ?= emit_simple_expr(slot.result)
	out_index_c ?= emit_simple_expr(slot.out_index)
	source_c ?= emit_simple_expr(slot.source)
	source_index_c ?= emit_simple_expr(slot.source_index)
	args: SourceSlotHandoffArgs = {
		result = result_c,
		out_index = out_index_c,
		source = source_c,
		source_index = source_index_c
	}

	Some(render_prepared_list_op(HandoffSetSourceSlot(args)))


private pure func emit_list_retain(retain: CoreListRetain) -> Option[String]:
	if not retain.value.needs_release:
		Some("(void)0")
	else:
		list_c ?= emit_simple_expr(retain.list)

		if is_stack_result_type(core_expr_type(retain.value.value)):
			value_c ?= emit_simple_expr(retain.value.value)
			Some("blorp_stack_result_retain(" + value_c + ")")
		else:
			value_c ?= emit_boxed_pointer_value(retain.value)

			Some("blorp_list_retain_for((blorp_List*)" + list_c + ", " + value_c + ")")


private pure func boxed_storage_kind_for_retain_value(typ: CoreType) -> CoreBoxKind:
	if is_stack_result_type(typ):
		StructBox("blorp_StackResult")
	else:
		match closure_abi_value_for_type(typ):
			Some(ClosureAbiVoid):
				VoidBox
			Some(ClosureAbiPointer):
				PointerBox
			Some(ClosureAbiPrim):
				PrimBox
			Some(ClosureAbiFloat):
				FloatBox
			Some(ClosureAbiFloat32):
				Float32Box
			Some(ClosureAbiFloat16):
				Float16Box
			Some(ClosureAbiInt128):
				Int128Box
			Some(ClosureAbiUInt128):
				UInt128Box
			Some(ClosureAbiStruct(c_type)):
				StructBox(c_type)
			None:
				PointerBox


private pure func boxed_storage_value_for_retain_intrinsic(
	value: CoreExpr,
) -> CoreBoxedStorageValue:
	value_type: CoreType = core_expr_type(value)
	kind: CoreBoxKind = boxed_storage_kind_for_retain_value(value_type)

	needs_release: Bool = match kind:
		PointerBox:
			True
		StructBox(_):
			is_stack_result_type(value_type)
		PrimBox:
			False
		VoidBox:
			False
		FloatBox:
			False
		Float32Box:
			False
		Float16Box:
			False
		Int128Box:
			False
		UInt128Box:
			False

	{
		kind = kind,
		value = value,
		needs_release = needs_release,
		transfers_ownership = False
	}


private pure func emit_list_retain_body(
	retain: CoreListRetain,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	if not retain.value.needs_release:
		Some(body_value("(void)0", next_temp))
	else:
		list_c ?= emit_simple_expr(retain.list)

		if is_stack_result_type(core_expr_type(retain.value.value)):
			value_body ?= emit_function_body(retain.value.value, next_temp)
			value_c ?= required_body_value(value_body)
			Some({
				statements = value_body.statements,
				value = "blorp_stack_result_retain(" + value_c + ")",
				next_temp = value_body.next_temp,
				returns = False,
			})
		else:
			value_body ?= emit_boxed_pointer_body(retain.value, next_temp)
			value_c ?= required_body_value(value_body)
			Some({
				statements = value_body.statements,
				value = "blorp_list_retain_for((blorp_List*)" + list_c + ", " + value_c + ")",
				next_temp = value_body.next_temp,
				returns = False,
			})


private pure func emit_list_retain_intrinsic_body(
	args: List[CoreExpr],
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match args:
		[list_expr, value_expr]:
			emit_list_retain_body(
				{
					list = list_expr,
					value = boxed_storage_value_for_retain_intrinsic(value_expr)
				},
				next_temp,
			)
		[]:
			None
		[first]:
			None
		[first, second, third, ...rest]:
			None


private pure func emit_record_construct(
	type_name: String,
	fields: List[CoreRecordFieldValue],
) -> Option[String]:
	var values: List[String] = []
	var failed: Bool = False

	for field in fields:
		if not failed:
			match emit_simple_expr(field.value):
				Some(value):
					values = values.append(value)
				None:
					failed = True
					break

	if failed:
		None
	else:
		Some(type_name + "_make(" + values.join(", ") + ")")


private pure func emit_record_construct_args_body(
	fields: List[CoreRecordFieldValue],
	next_temp: Int,
) -> Option[CallArgsBody]:
	var statements: String = ""
	var values: List[String] = []
	var failed: Bool = False
	var temp_index: Int = next_temp

	for field in fields:
		if not failed:
			match emit_function_body(field.value, temp_index):
				Some(field_body):
					if field_body.returns:
						failed = True
						break
					else:
						match required_body_value(field_body):
							Some(field_value):
								scoped_field: FunctionBodyC = scoped_body_value(
									"record_field",
									core_expr_type(field.value),
									field_body,
								)
								statements += scoped_field.statements
								values = values.append(scoped_field.value)
								temp_index = scoped_field.next_temp
							None:
								failed = True
								break
				None:
					failed = True
					break

	if failed:
		None
	else:
		Some({
			statements = statements,
			args = values,
			cleanup_slots = [],
			next_temp = temp_index,
		})


private pure func emit_record_construct_body(
	type_name: String,
	fields: List[CoreRecordFieldValue],
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	args_body ?= emit_record_construct_args_body(fields, next_temp)

	Some(
		emit_temp_value_body(
			"record_result",
			typ,
			args_body.statements,
			type_name + "_make(" + args_body.args.join(", ") + ")",
			args_body.next_temp,
		),
	)


private pure func record_reuse_c_name(type_name: String) -> String:
	"__blorp_reuse_record_" + type_name


private pure func emit_record_reuse_body(
	source: CoreExpr,
	fields: List[CoreRecordFieldValue],
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match typ:
		HeapRecordType(type_name):
			match source:
				VarExpr(_, source_type, _):
					match source_type:
						HeapRecordType(source_type_name):
							if source_type_name == type_name:
								source_c ?= emit_simple_expr(source)
								args_body ?= emit_record_construct_args_body(fields, next_temp)

								Some(
									emit_temp_value_body(
										"record_reuse_result",
										typ,
										args_body.statements,
										record_reuse_c_name(type_name) + "(" + [source_c]
											.concat(args_body.args)
											.join(", ") + ")",
										args_body.next_temp,
									),
								)
							else:
								None
						_:
							None
				_:
					None
		_:
			None


private pure func emit_generic_union_arg(
	payload_storage: CoreUnionPayloadStorage,
	arg: CoreBoxedStorageValue,
) -> Option[String]:
	match payload_storage:
		TypedUnionPayloadStorage:
			emit_simple_expr(arg.value)
		ErasedUnionPayloadStorage:
			emit_boxed_pointer_value(arg)


private pure func emit_generic_union_args(construct: CoreUnionConstruct) -> Option[List[String]]:
	var args: List[String] = []
	var failed: Bool = False

	for arg in construct.args:
		if not failed:
			match emit_generic_union_arg(construct.payload_storage, arg):
				Some(arg_c):
					args = args.append(arg_c)
				None:
					failed = True
					break

	if failed:
		None
	else:
		Some(args)


private pure func emit_generic_union_reuse_args(
	payload_storage: CoreUnionPayloadStorage,
	args: List[CoreBoxedStorageValue],
) -> Option[List[String]]:
	var values: List[String] = []
	var failed: Bool = False

	for arg in args:
		if not failed:
			match emit_generic_union_arg(payload_storage, arg):
				Some(arg_c):
					values = values.append(arg_c)
				None:
					failed = True
					break

	if failed:
		None
	else:
		Some(values)


private pure func emit_union_payload_arg_body(
	payload_storage: CoreUnionPayloadStorage,
	arg: CoreBoxedStorageValue,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match payload_storage:
		TypedUnionPayloadStorage:
			body ?= emit_function_body(arg.value, next_temp)

			if body.returns:
				None
			else:
				Some(scoped_body_value("union_arg", core_expr_type(arg.value), body))
		ErasedUnionPayloadStorage:
			body ?= emit_boxed_pointer_body(arg, next_temp)

			if body.returns:
				None
			else:
				Some(scoped_c_value("union_arg", "void*", body))


private pure func emit_stack_option_args(construct: CoreUnionConstruct) -> Option[List[String]]:
	var args: List[String] = []
	var failed: Bool = False

	for arg in construct.args:
		if not failed:
			match emit_simple_expr(arg.value):
				Some(arg_c):
					args = args.append(arg_c)
				None:
					failed = True
					break

	if failed:
		None
	else:
		Some(args)


private pure func stack_option_payload_expr(payload: CoreBoxedStorageValue) -> CoreExpr:
	match payload.value:
		BoxExpr(box, typ, loc):
			box.value
		_:
			payload.value


private pure func emit_stack_option_value(
	info: CoreStackOptionRepresentation,
	payload: CoreBoxedStorageValue,
) -> Option[String]:
	value_expr: CoreExpr = stack_option_payload_expr(payload)

	if is_void_type(core_expr_type(value_expr)):
		statement ?= emit_simple_expr(value_expr)
		args: StackOptionVoidStatementArgs = {
			option_type = info.option_type,
			tag = info.tag.to_string(),
			statement = statement + ";"
		}
		Some(render_prepared_constructor_op(StackOptionVoidStatement(args)))
	else:
		value ?= emit_simple_expr(value_expr)
		args: StackOptionValueArgs = {
			option_type = info.option_type,
			tag = info.tag.to_string(),
			value = value
		}
		Some(render_prepared_constructor_op(StackOptionValue(args)))


private pure func emit_stack_option_none(info: CoreStackOptionRepresentation) -> String:
	args: StackOptionNoneArgs = {
		option_type = info.option_type,
		tag = info.tag.to_string(),
		none_value = info.none_value
	}
	render_prepared_constructor_op(StackOptionNone(args))


private pure func emit_stack_option_construct(
	info: CoreStackOptionRepresentation,
	args: List[CoreBoxedStorageValue],
) -> Option[String]:
	match args:
		[]:
			Some(emit_stack_option_none(info))
		[payload]:
			emit_stack_option_value(info, payload)
		[first, second, ...rest]:
			None


private pure func emit_stack_result_construct(
	construct: CoreUnionConstruct,
	info: CoreStackResultRepresentation,
) -> Option[String]:
	match construct.args:
		[payload]:
			payload_c ?= emit_boxed_pointer_value(payload)
			render_args: StackResultTaggedPayloadArgs = {
				result_type = info.result_type,
				tag = info.tag.to_string(),
				field = construct.constructor_name,
				payload = payload_c,
				release_mask = info.release_mask.to_string()
			}

			Some(render_prepared_backend_op(BackendStackResultTaggedPayload(render_args)))
		[]:
			None
		[first, second, ...rest]:
			None


private pure func emit_nullable_option_construct(construct: CoreUnionConstruct) -> Option[String]:
	args ?= emit_stack_option_args(construct)

	match args:
		[]:
			Some("NULL")
		[payload]:
			Some(payload)
		[first, second, ...rest]:
			None


private pure func is_boxed_result_construct(construct: CoreUnionConstruct) -> Bool:
	construct.type_name == BOXED_RESULT_TYPE_NAME


private pure func boxed_result_runtime_constructor(constructor_name: String) -> Option[String]:
	if constructor_name == BOXED_RESULT_OK_CONSTRUCTOR_NAME:
		Some(BOXED_RESULT_OK_RUNTIME_CONSTRUCTOR)
	else if constructor_name == BOXED_RESULT_ERR_CONSTRUCTOR_NAME:
		Some(BOXED_RESULT_ERR_RUNTIME_CONSTRUCTOR)
	else:
		None


private pure func boxed_result_construct_value(
	constructor_name: String,
	payload_c: String,
	release_mask: Int,
) -> Option[String]:
	runtime_constructor ?= boxed_result_runtime_constructor(constructor_name)
	value: String = runtime_constructor + "(" + payload_c + ")"

	if release_mask == 0:
		Some(value)
	else:
		Some(
			"({ blorp_Result* " + BOXED_RESULT_RELEASE_MASK_TEMP + " = " + value + "; " + BOXED_RESULT_RELEASE_MASK_TEMP + "->release_mask = " + release_mask.to_string() + "UL; " + BOXED_RESULT_RELEASE_MASK_TEMP + "; })",
		)


private pure func emit_boxed_result_construct(construct: CoreUnionConstruct) -> Option[String]:
	match construct.args:
		[payload]:
			payload_c ?= emit_boxed_pointer_value(payload)
			boxed_result_construct_value(
				construct.constructor_name,
				payload_c,
				construct.release_mask,
			)
		[]:
			None
		[first, second, ...rest]:
			None


private pure func emit_generic_union_construct_call(
	construct: CoreUnionConstruct,
) -> Option[String]:
	initial_args ?= emit_generic_union_args(construct)
	var args: List[String] = initial_args

	if args.length() == 0:
		Some(construct.constructor_c_name)
	else:
		Some(
			construct.constructor_c_name + "(" + call_args_text(
				args,
				construct.uses_release_mask,
				construct.release_mask,
			) + ")",
		)


private pure func call_args_text(
	args: List[String],
	uses_release_mask: Bool,
	release_mask: Int,
) -> String:
	arg_text: String = args.join(", ")

	if not uses_release_mask:
		arg_text
	else:
		release_mask_arg: String = release_mask.to_string() + "UL"

		if arg_text == "":
			release_mask_arg
		else:
			arg_text + ", " + release_mask_arg


private pure func emit_union_reuse_construct(construct: CoreUnionReuseConstruct) -> Option[String]:
	match construct.representation:
		GenericUnionRepresentation:
			source_c ?= emit_simple_expr(construct.source)
			payload_args ?= emit_generic_union_reuse_args(construct.payload_storage, construct.args)
			var args: List[String] = [source_c]

			for payload_arg in payload_args:
				args = args.append(payload_arg)

			Some(
				construct.reuse_constructor_c_name + "(" + call_args_text(
					args,
					construct.uses_release_mask,
					construct.release_mask,
				) + ")",
			)
		BoxedOptionRepresentation:
			None
		StackOptionRepresentation(info):
			None
		StackResultRepresentation(info):
			None
		NullableOptionRepresentation:
			None


private pure func emit_union_construct(construct: CoreUnionConstruct) -> Option[String]:
	match construct.representation:
		BoxedOptionRepresentation:
			emit_generic_union_construct_call(construct)
		GenericUnionRepresentation:
			if is_boxed_result_construct(construct):
				emit_boxed_result_construct(construct)
			else:
				emit_generic_union_construct_call(construct)
		StackOptionRepresentation(info):
			emit_stack_option_construct(info, construct.args)
		StackResultRepresentation(info):
			emit_stack_result_construct(construct, info)
		NullableOptionRepresentation:
			emit_nullable_option_construct(construct)


private pure func emit_generic_union_construct_body(
	construct: CoreUnionConstruct,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	var statements: String = ""
	var args: List[String] = []
	var failed: Bool = False
	var temp_index: Int = next_temp

	for arg in construct.args:
		if not failed:
			match emit_union_payload_arg_body(construct.payload_storage, arg, temp_index):
				Some(arg_body):
					match required_body_value(arg_body):
						Some(arg_c):
							statements += arg_body.statements
							args = args.append(arg_c)
							temp_index = arg_body.next_temp
						None:
							failed = True
							break
				None:
					failed = True
					break

	if failed:
		None
	else if args.length() == 0:
		Some({
			statements = statements,
			value = construct.constructor_c_name,
			next_temp = temp_index,
			returns = False,
		})
	else:
		constructor_value: String = construct.constructor_c_name + "(" + call_args_text(
			args,
			construct.uses_release_mask,
			construct.release_mask,
		) + ")"

		Some(
			emit_temp_value_body(
				"union_result",
				UnionType(construct.type_name),
				statements,
				constructor_value,
				temp_index,
			),
		)


private pure func emit_generic_union_reuse_construct_body(
	construct: CoreUnionReuseConstruct,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	source_body ?= emit_function_body(construct.source, next_temp)

	if source_body.returns:
		None
	else:
		source_c ?= required_body_value(source_body)
		var statements: String = source_body.statements
		var args: List[String] = [source_c]
		var failed: Bool = False
		var temp_index: Int = source_body.next_temp

		for arg in construct.args:
			if not failed:
				match emit_union_payload_arg_body(construct.payload_storage, arg, temp_index):
					Some(arg_body):
						match required_body_value(arg_body):
							Some(arg_c):
								statements += arg_body.statements
								args = args.append(arg_c)
								temp_index = arg_body.next_temp
							None:
								failed = True
								break
					None:
						failed = True
						break

		if failed:
			None
		else:
			constructor_value: String = construct.reuse_constructor_c_name + "(" + call_args_text(
				args,
				construct.uses_release_mask,
				construct.release_mask,
			) + ")"

			Some(
				emit_temp_value_body(
					"union_result",
					UnionType(construct.type_name),
					statements,
					constructor_value,
					temp_index,
				),
			)


private pure func emit_stack_result_construct_body(
	construct: CoreUnionConstruct,
	info: CoreStackResultRepresentation,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match construct.args:
		[payload]:
			payload_body ?= emit_boxed_pointer_body(payload, next_temp)
			payload_c ?= required_body_value(payload_body)
			render_args: StackResultTaggedPayloadArgs = {
				result_type = info.result_type,
				tag = info.tag.to_string(),
				field = construct.constructor_name,
				payload = payload_c,
				release_mask = info.release_mask.to_string()
			}
			Some({
				statements = payload_body.statements,
				value = render_prepared_backend_op(BackendStackResultTaggedPayload(render_args)),
				next_temp = payload_body.next_temp,
				returns = False,
			})
		[]:
			None
		[first, second, ...rest]:
			None


private pure func emit_stack_option_construct_body(
	info: CoreStackOptionRepresentation,
	args: List[CoreBoxedStorageValue],
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match args:
		[]:
			Some(body_value(emit_stack_option_none(info), next_temp))
		[payload]:
			value_expr: CoreExpr = stack_option_payload_expr(payload)
			payload_body ?= emit_function_body(value_expr, next_temp)

			if payload_body.returns:
				None
			else if is_void_type(core_expr_type(value_expr)):
				render_args: StackOptionVoidStatementArgs = {
					option_type = info.option_type,
					tag = info.tag.to_string(),
					statement = payload_body.statements
				}
				Some({
					statements = "",
					value = render_prepared_constructor_op(StackOptionVoidStatement(render_args)),
					next_temp = payload_body.next_temp,
					returns = False,
				})
			else:
				payload_c ?= required_body_value(payload_body)
				render_args: StackOptionValueArgs = {
					option_type = info.option_type,
					tag = info.tag.to_string(),
					value = payload_c
				}
				Some({
					statements = payload_body.statements,
					value = render_prepared_constructor_op(StackOptionValue(render_args)),
					next_temp = payload_body.next_temp,
					returns = False,
				})
		[first, second, ...rest]:
			None


private pure func emit_nullable_option_construct_body(
	construct: CoreUnionConstruct,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match construct.args:
		[]:
			Some(body_value("NULL", next_temp))
		[payload]:
			emit_boxed_pointer_body(payload, next_temp)
		[first, second, ...rest]:
			None


private pure func emit_boxed_result_construct_body(
	construct: CoreUnionConstruct,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match construct.args:
		[payload]:
			payload_body ?= emit_boxed_pointer_body(payload, next_temp)
			payload_c ?= required_body_value(payload_body)
			value ?= boxed_result_construct_value(
				construct.constructor_name,
				payload_c,
				construct.release_mask,
			)
			Some({
				statements = payload_body.statements,
				value = value,
				next_temp = payload_body.next_temp,
				returns = False,
			})
		[]:
			None
		[first, second, ...rest]:
			None


private pure func emit_union_construct_body(
	construct: CoreUnionConstruct,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match construct.representation:
		BoxedOptionRepresentation:
			emit_generic_union_construct_body(construct, next_temp)
		GenericUnionRepresentation:
			if is_boxed_result_construct(construct):
				emit_boxed_result_construct_body(construct, next_temp)
			else:
				emit_generic_union_construct_body(construct, next_temp)
		StackOptionRepresentation(info):
			emit_stack_option_construct_body(info, construct.args, next_temp)
		StackResultRepresentation(info):
			emit_stack_result_construct_body(construct, info, next_temp)
		NullableOptionRepresentation:
			emit_nullable_option_construct_body(construct, next_temp)


private pure func emit_union_reuse_construct_body(
	construct: CoreUnionReuseConstruct,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match construct.representation:
		GenericUnionRepresentation:
			emit_generic_union_reuse_construct_body(construct, next_temp)
		BoxedOptionRepresentation:
			None
		StackOptionRepresentation(info):
			None
		StackResultRepresentation(info):
			None
		NullableOptionRepresentation:
			None


private pure func is_named_pointer_tuple_slot_type(name: String, args: List[CoreType]) -> Bool:
	(
		name == "String"
		or name == "Bytes"
		or name == "Fixed"
		or name == "Closure"
		or name == "List"
		or name == "Dict"
		or name == "Set"
		or name == "Channel"
		or name == "Ptr"
	)


private pure func is_pointer_tuple_slot_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			is_named_pointer_tuple_slot_type(name, args)
		TypeParameterType(_) | SelfType:
			False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			True
		FunctionType(is_pure, param_types, return_type):
			True
		HeapRecordType(name):
			True
		UnionType(name):
			True
		TupleType(items):
			True
		TensorType(info):
			True
		VoidType:
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		RangeType:
			False


private pure func emit_float_tuple_field_access(element_c: String, typ: CoreType) -> Option[String]:
	match typ:
		NamedType(name, args):
			if args.length() != 0:
				None
			else if name == "Float":
				Some("blorp_unbox_float(" + element_c + ")")
			else if name == "Float32":
				Some("blorp_unbox_float32(" + element_c + ")")
			else if name == "Float16":
				Some("blorp_unbox_float16(" + element_c + ")")
			else:
				None
		TypeParameterType(_) | SelfType:
			None
		StackResultType(ok_type, err_type):
			None
		BoxedResultType(ok_type, err_type):
			None
		FunctionType(is_pure, param_types, return_type):
			None
		HeapRecordType(name):
			None
		UnionType(name):
			None
		TupleType(items):
			None
		TensorType(info):
			None
		VoidType:
			None
		EnumType(name):
			None
		ValueRecordType(name):
			None
		RangeType:
			None


private pure func emit_tuple_field_access(
	expr_value: CoreExpr,
	field_index: Int,
	typ: CoreType,
) -> Option[String]:
	tuple_c ?= emit_simple_expr(expr_value)
	element_c: String = "((blorp_Tuple*)" + tuple_c + ")->elem[" + field_index.to_string() + "]"

	match emit_float_tuple_field_access(element_c, typ):
		Some(float_access):
			Some(float_access)
		None:
			if CorePrepare.is_primitive_tuple_slot_type(typ):
				field_type: String = c_type_name(typ)

				if field_type == "long":
					Some("((long)" + element_c + ")")
				else:
					Some("((" + field_type + ")(long)" + element_c + ")")
			else if is_pointer_tuple_slot_type(typ):
				Some("((" + c_type_name(typ) + ")" + element_c + ")")
			else:
				match typ:
					ValueRecordType(name):
						Some(boxed_struct_value_source(c_type_name(typ), element_c))
					NamedType(name, args):
						if name == "Option":
							boxed_storage_value_source(element_c, typ)
						else:
							None
					TypeParameterType(_) | SelfType:
						None
					StackResultType(ok_type, err_type):
						boxed_storage_value_source(element_c, typ)
					BoxedResultType(ok_type, err_type):
						None
					FunctionType(is_pure, param_types, return_type):
						None
					HeapRecordType(name):
						None
					UnionType(name):
						None
					TupleType(items):
						None
					TensorType(info):
						None
					VoidType:
						None
					EnumType(name):
						None
					RangeType:
						None


private pure func c_field_access_value(
	expr_value: CoreExpr,
	field_name: String,
	expr_c: String,
) -> Option[String]:
	field_c: String = c_identifier(field_name)

	match core_expr_type(expr_value):
		HeapRecordType(name):
			Some(expr_c + "->" + field_c)
		ValueRecordType(name):
			Some(expr_c + "." + field_c)
		RangeType:
			Some(expr_c + "." + field_c)
		VoidType:
			None
		NamedType(name, args):
			None
		TypeParameterType(_) | SelfType:
			None
		StackResultType(ok_type, err_type):
			None
		BoxedResultType(ok_type, err_type):
			None
		FunctionType(is_pure, param_types, return_type):
			None
		EnumType(name):
			None
		UnionType(name):
			None
		TensorType(info):
			None
		TupleType(items):
			None


private pure func emit_field_access(expr_value: CoreExpr, field_name: String) -> Option[String]:
	expr_c ?= emit_simple_expr(expr_value)
	c_field_access_value(expr_value, field_name, expr_c)


private pure func emit_field_access_body(
	expr_value: CoreExpr,
	field_name: String,
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	expr_body ?= emit_function_body(expr_value, next_temp)
	expr_c ?= required_body_value(expr_body)
	value ?= c_field_access_value(expr_value, field_name, expr_c)

	Some(
		emit_temp_value_body(
			"field_result",
			typ,
			expr_body.statements,
			value,
			expr_body.next_temp,
		),
	)


private pure func emit_struct_unbox_from_pointer_expr(
	expr_value: CoreExpr,
	c_type: String,
) -> Option[String]:
	value_c ?= emit_simple_expr(expr_value)
	Some("blorp_unbox_struct(${value_c}, ${c_type})")


private pure func c_unbox_value(
	unbox_kind: CoreUnboxKind,
	typ: CoreType,
	value_c: String,
) -> String:
	match unbox_kind:
		FloatUnbox:
			"blorp_unbox_float(${value_c})"
		Float32Unbox:
			"blorp_unbox_float32(${value_c})"
		Float16Unbox:
			"blorp_unbox_float16(${value_c})"
		Int128Unbox:
			"blorp_unbox_int128(${value_c})"
		UInt128Unbox:
			"blorp_unbox_uint128(${value_c})"
		PrimUnbox:
			"((${c_type_name(typ)})(long)${value_c})"
		PointerUnbox:
			"((${c_type_name(typ)})${value_c})"
		StructUnbox(c_type):
			"blorp_unbox_struct(${value_c}, ${c_type})"


private pure func emit_scalar_unbox_expr(
	unbox_kind: CoreUnboxKind,
	expr_value: CoreExpr,
	typ: CoreType,
) -> Option[String]:
	value_c ?= emit_simple_expr(expr_value)
	Some(c_unbox_value(unbox_kind, typ, value_c))


private pure func emit_inline_scalar_list_unbox_expr(
	expr_value: CoreExpr,
	typ: CoreType,
) -> Option[String]:
	match expr_value:
		ListGetExpr(get, list_get_type, loc):
			match get.layout:
				InlineListStorage(width_bytes):
					emit_inline_scalar_list_unbox_get(get, typ, width_bytes)
				PointerListStorage:
					None
				InlineStructListStorage(c_type):
					None
		_:
			None


private pure func emit_inline_scalar_or_erased_unbox_expr(
	unbox_kind: CoreUnboxKind,
	expr_value: CoreExpr,
	typ: CoreType,
) -> Option[String]:
	match emit_inline_scalar_list_unbox_expr(expr_value, typ):
		Some(value):
			Some(value)
		None:
			emit_scalar_unbox_expr(unbox_kind, expr_value, typ)


private pure func emit_unbox_expr(
	unbox_kind: CoreUnboxKind,
	expr_value: CoreExpr,
	typ: CoreType,
) -> Option[String]:
	match unbox_kind:
		FloatUnbox:
			match emit_ranked_tensor_checked_get_unbox_expr(unbox_kind, expr_value):
				Some(rendered):
					Some(rendered)
				None:
					emit_inline_scalar_or_erased_unbox_expr(unbox_kind, expr_value, typ)
		Float32Unbox:
			match emit_ranked_tensor_checked_get_unbox_expr(unbox_kind, expr_value):
				Some(rendered):
					Some(rendered)
				None:
					emit_inline_scalar_or_erased_unbox_expr(unbox_kind, expr_value, typ)
		Float16Unbox:
			match emit_ranked_tensor_checked_get_unbox_expr(unbox_kind, expr_value):
				Some(rendered):
					Some(rendered)
				None:
					emit_inline_scalar_or_erased_unbox_expr(unbox_kind, expr_value, typ)
		Int128Unbox:
			emit_scalar_unbox_expr(unbox_kind, expr_value, typ)
		UInt128Unbox:
			emit_scalar_unbox_expr(unbox_kind, expr_value, typ)
		PrimUnbox:
			emit_inline_scalar_or_erased_unbox_expr(unbox_kind, expr_value, typ)
		PointerUnbox:
			emit_scalar_unbox_expr(unbox_kind, expr_value, typ)
		StructUnbox(c_type):
			match expr_value:
				ListGetExpr(get, list_get_type, loc):
					match get.layout:
						InlineStructListStorage(list_c_type):
							if list_c_type == c_type:
								emit_inline_struct_list_unbox_get(get, c_type)
							else:
								emit_struct_unbox_from_pointer_expr(expr_value, c_type)
						PointerListStorage:
							emit_struct_unbox_from_pointer_expr(expr_value, c_type)
						InlineListStorage(width_bytes):
							emit_struct_unbox_from_pointer_expr(expr_value, c_type)
				CallExpr(kind, callee, args, call_type, loc):
					match kind:
						IntrinsicCall(name):
							if name == "tensor_get_unchecked":
								emit_inline_struct_tensor_get_unchecked(args, c_type)
							else:
								emit_struct_unbox_from_pointer_expr(expr_value, c_type)
						UserCall(name, def_id, consumed_args):
							emit_struct_unbox_from_pointer_expr(expr_value, c_type)
						ForeignCall(name, arg_passing):
							emit_struct_unbox_from_pointer_expr(expr_value, c_type)
						BuiltinCall(name):
							if is_ranked_tensor_checked_get_name(name):
								match emit_ranked_inline_struct_tensor_get_checked(
									name,
									args,
									c_type,
								):
									Some(rendered):
										Some(rendered)
									None:
										None
							else if name == "blorp_checked_get":
								emit_inline_struct_tensor_get_checked(args, c_type)
							else:
								emit_struct_unbox_from_pointer_expr(expr_value, c_type)
						DirectRuntimeCall(call):
							emit_struct_unbox_from_pointer_expr(expr_value, c_type)
						TensorParallelCall(name, layout):
							emit_struct_unbox_from_pointer_expr(expr_value, c_type)
						DictWithCapacityCall(constructor):
							emit_struct_unbox_from_pointer_expr(expr_value, c_type)
						OperationResultCall(bridge):
							emit_struct_unbox_from_pointer_expr(expr_value, c_type)
						FallibleStreamTerminalCall(bridge):
							emit_struct_unbox_from_pointer_expr(expr_value, c_type)
						ListToStringCall(callback_name):
							emit_struct_unbox_from_pointer_expr(expr_value, c_type)
						ClosureCall:
							emit_struct_unbox_from_pointer_expr(expr_value, c_type)
						UnknownCall | DeferredTraitCall(_, _) | SelectedTraitCall(_, _, _, _):
							emit_struct_unbox_from_pointer_expr(expr_value, c_type)
						SelectedDirectCall(def_id):
							emit_struct_unbox_from_pointer_expr(expr_value, c_type)
				_:
					emit_struct_unbox_from_pointer_expr(expr_value, c_type)


private pure func emit_unbox_body(
	unbox_kind: CoreUnboxKind,
	expr_value: CoreExpr,
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	expr_c ?= emit_function_body(expr_value, next_temp)
	value ?= required_body_value(expr_c)

	Some(
		emit_temp_value_body(
			"unbox_result",
			typ,
			expr_c.statements,
			c_unbox_value(unbox_kind, typ, value),
			expr_c.next_temp,
		),
	)


private pure func emit_box_expr(box: CoreBoxOp) -> Option[String]:
	value_c ?= emit_simple_expr(box.value)

	match box.kind:
		VoidBox:
			Some("({ " + value_c + "; (void*)0; })")
		FloatBox:
			Some("blorp_box_float(" + value_c + ")")
		Float32Box:
			Some("blorp_box_float32(" + value_c + ")")
		Float16Box:
			Some("blorp_box_float16(" + value_c + ")")
		Int128Box:
			Some("blorp_box_int128(" + value_c + ")")
		UInt128Box:
			Some("blorp_box_uint128(" + value_c + ")")
		PrimBox:
			Some("(void*)(long)(" + value_c + ")")
		PointerBox:
			Some("(void*)" + value_c)
		StructBox(c_type):
			if is_stack_result_type(box.source_type):
				Some(
					emit_stack_result_box(
						value_c,
						expr_retains_stack_result(box.value),
					),
				)
			else:
				Some(
					"({ " + c_type + " __box = " + value_c + "; blorp_box_struct(&__box, sizeof(" + c_type + ")); })",
				)


private pure func closure_arg_needs_release(value: ClosureAbiValue) -> Bool:
	match value:
		ClosureAbiVoid:
			False
		ClosureAbiPointer:
			False
		ClosureAbiPrim:
			False
		ClosureAbiFloat:
			False
		ClosureAbiFloat32:
			False
		ClosureAbiFloat16:
			False
		ClosureAbiInt128:
			True
		ClosureAbiUInt128:
			True
		ClosureAbiStruct(c_type):
			True


private pure func closure_arg_value_expr(value: ClosureAbiValue, value_c: String) -> String:
	match value:
		ClosureAbiVoid:
			"({ " + value_c + "; (void*)0; })"
		ClosureAbiPointer:
			"(void*)" + value_c
		ClosureAbiPrim:
			"(void*)(long)(" + value_c + ")"
		ClosureAbiFloat:
			"blorp_box_float(" + value_c + ")"
		ClosureAbiFloat32:
			"blorp_box_float32(" + value_c + ")"
		ClosureAbiFloat16:
			"blorp_box_float16(" + value_c + ")"
		ClosureAbiInt128:
			"blorp_box_int128(" + value_c + ")"
		ClosureAbiUInt128:
			"blorp_box_uint128(" + value_c + ")"
		ClosureAbiStruct(c_type):
			""


private pure func is_managed_pointer_capture_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			if name == "String" and args.length() == 0:
				True
			else if name == "Bytes" and args.length() == 0:
				True
			else if name == "Fixed" and args.length() == 0:
				True
			else if name == "Closure" and args.length() == 0:
				True
			else if name == "List" and args.length() == 1:
				True
			else if name == "Dict" and args.length() == 2:
				True
			else if name == "Set" and args.length() == 1:
				True
			else if name == "Channel" and args.length() == 1:
				True
			else:
				False
		TypeParameterType(_) | SelfType:
			False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			True
		FunctionType(is_pure, param_types, return_type):
			True
		HeapRecordType(name):
			True
		UnionType(name):
			True
		TupleType(items):
			False
		TensorType(info):
			True
		VoidType:
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		RangeType:
			False


private pure func is_unmanaged_pointer_capture_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			name == "Ptr" and args.length() == 0
		TypeParameterType(_) | SelfType:
			False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			False
		FunctionType(is_pure, param_types, return_type):
			False
		HeapRecordType(name):
			False
		UnionType(name):
			False
		TupleType(items):
			False
		TensorType(info):
			False
		VoidType:
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		RangeType:
			False


private pure func closure_simple_arg_binding(
	abi_value: ClosureAbiValue,
	arg_name: String,
	arg_c: String,
) -> ClosureArgBinding:
	{
		name = arg_name,
		statement = "; void* " + arg_name + " = " + closure_arg_value_expr(abi_value, arg_c),
		needs_release = closure_arg_needs_release(abi_value)
	}


private pure func closure_arg_binding(arg: CoreExpr, index: Int) -> Option[ClosureArgBinding]:
	abi_value ?= closure_abi_value_for_type(core_expr_type(arg))
	arg_c ?= emit_simple_expr(arg)
	arg_name: String = "__cl_arg_" + index.to_string()

	match abi_value:
		ClosureAbiStruct(c_type):
			value_name: String = "__cl_arg_value_" + index.to_string()
			Some({
				name = arg_name,
				statement = "; " + c_type + " " + value_name + " = " + arg_c + "; void* " + arg_name + " = blorp_box_struct(&" + value_name + ", sizeof(" + c_type + "))",
				needs_release = True,
			})
		ClosureAbiVoid:
			Some(closure_simple_arg_binding(abi_value, arg_name, arg_c))
		ClosureAbiPointer:
			Some(closure_simple_arg_binding(abi_value, arg_name, arg_c))
		ClosureAbiPrim:
			Some(closure_simple_arg_binding(abi_value, arg_name, arg_c))
		ClosureAbiFloat:
			Some(closure_simple_arg_binding(abi_value, arg_name, arg_c))
		ClosureAbiFloat32:
			Some(closure_simple_arg_binding(abi_value, arg_name, arg_c))
		ClosureAbiFloat16:
			Some(closure_simple_arg_binding(abi_value, arg_name, arg_c))
		ClosureAbiInt128:
			Some(closure_simple_arg_binding(abi_value, arg_name, arg_c))
		ClosureAbiUInt128:
			Some(closure_simple_arg_binding(abi_value, arg_name, arg_c))


private pure func closure_arg_bindings(args: List[CoreExpr]) -> Option[List[ClosureArgBinding]]:
	var result: List[ClosureArgBinding] = []
	var failed: Bool = False
	var index: Int = 0

	for arg in args:
		if not failed:
			match closure_arg_binding(arg, index):
				Some(binding):
					result = result.append(binding)
				None:
					failed = True
					break

		index += 1

	if failed:
		None
	else:
		Some(result)


private pure func closure_arg_declarations(bindings: List[ClosureArgBinding]) -> String:
	var result: String = ""

	for binding in bindings:
		result += binding.statement

	result


private pure func closure_call_arg_list(bindings: List[ClosureArgBinding]) -> String:
	var args: List[String] = []

	for binding in bindings:
		args = args.append(binding.name)

	if args.length() == 0:
		""
	else:
		", " + args.join(", ")


private pure func closure_arg_release_statements(bindings: List[ClosureArgBinding]) -> String:
	var result: String = ""

	for binding in bindings:
		if binding.needs_release:
			result += "; blorp_release(" + binding.name + ")"

	result


private pure func closure_call_signature(arg_count: Int, return_c: String) -> String:
	var arg_types: List[String] = ["void*"]
	var index: Int = 0

	while index < arg_count:
		arg_types = arg_types.append("void*")
		index += 1

	return_c + " (*)(" + arg_types.join(", ") + ")"


private pure func closure_return_expr(result_name: String, return_type: CoreType) -> Option[String]:
	abi_value ?= closure_abi_value_for_type(return_type)

	match abi_value:
		ClosureAbiVoid:
			Some("(void)0")
		ClosureAbiPointer:
			Some("((" + c_type_name(return_type) + ")" + result_name + ")")
		ClosureAbiPrim:
			Some("((" + c_type_name(return_type) + ")(long)" + result_name + ")")
		ClosureAbiFloat:
			Some("blorp_unbox_float(" + result_name + ")")
		ClosureAbiFloat32:
			Some("blorp_unbox_float32(" + result_name + ")")
		ClosureAbiFloat16:
			Some("blorp_unbox_float16(" + result_name + ")")
		ClosureAbiInt128:
			Some("__cl_unboxed")
		ClosureAbiUInt128:
			Some("__cl_unboxed")
		ClosureAbiStruct(c_type):
			Some("__cl_unboxed")


private pure func closure_return_unbox_prelude(
	result_name: String,
	return_type: CoreType,
) -> Option[String]:
	abi_value ?= closure_abi_value_for_type(return_type)

	match abi_value:
		ClosureAbiVoid:
			Some("")
		ClosureAbiPointer:
			Some("")
		ClosureAbiPrim:
			Some("")
		ClosureAbiFloat:
			Some("")
		ClosureAbiFloat32:
			Some("")
		ClosureAbiFloat16:
			Some("")
		ClosureAbiInt128:
			Some(
				"; __int128 __cl_unboxed = blorp_unbox_int128(" + result_name + "); blorp_release(" + result_name + ")",
			)
		ClosureAbiUInt128:
			Some(
				"; unsigned __int128 __cl_unboxed = blorp_unbox_uint128(" + result_name + "); blorp_release(" + result_name + ")",
			)
		ClosureAbiStruct(c_type):
			if is_stack_result_type(return_type):
				Some(
					"; " + c_type + " __cl_unboxed = (*(" + c_type + "*)((char*)" + result_name + ((
						" + sizeof(blorp_Object))); blorp_stack_result_retain(__cl_unboxed); "
						+ "blorp_release("
					)) + result_name + ")",
				)
			else:
				Some(
					"; " + c_type + " __cl_unboxed = (*(" + c_type + "*)((char*)" + result_name + " + sizeof(blorp_Object))); blorp_release(" + result_name + ")",
				)


private pure func emit_closure_call(
	callee: CoreExpr,
	args: List[CoreExpr],
	return_type: CoreType,
) -> Option[String]:
	callee_c ?= emit_simple_expr(callee)
	bindings ?= closure_arg_bindings(args)
	arg_declarations: String = closure_arg_declarations(bindings)
	call_args: String = closure_call_arg_list(bindings)
	arg_releases: String = closure_arg_release_statements(bindings)

	if is_void_type(return_type):
		call_signature: String = closure_call_signature(args.length(), "void")
		Some(
			"({ blorp_Closure* __cl = (blorp_Closure*)" + callee_c + arg_declarations + "; ((" + call_signature + ")(__cl->func))(__cl->env" + call_args + ")" + arg_releases + "; (void)0; })",
		)
	else:
		return_expr ?= closure_return_expr("__cl_r", return_type)
		unbox_prelude ?= closure_return_unbox_prelude("__cl_r", return_type)
		call_signature: String = closure_call_signature(args.length(), "void*")
		Some(
			"({ blorp_Closure* __cl = (blorp_Closure*)" + callee_c + arg_declarations + "; void* __cl_r = ((" + call_signature + ")(__cl->func))(__cl->env" + call_args + ")" + arg_releases + unbox_prelude + "; " + return_expr + "; })",
		)


private pure func closure_capture_box_expr(capture: CoreClosureCapture) -> Option[String]:
	abi_value ?= closure_abi_value_for_type(capture.typ)
	capture_c: String = c_local_name(capture.name)

	match abi_value:
		ClosureAbiVoid:
			Some("(void*)0")
		ClosureAbiPointer:
			if is_managed_pointer_capture_type(capture.typ):
				Some("(void*)blorp_retain((blorp_Object*)" + capture_c + ")")
			else if is_unmanaged_pointer_capture_type(capture.typ):
				Some("(void*)" + capture_c)
			else:
				None
		ClosureAbiPrim:
			Some("(void*)(long)(" + capture_c + ")")
		ClosureAbiFloat:
			Some("blorp_box_float(" + capture_c + ")")
		ClosureAbiFloat32:
			Some("blorp_box_float32(" + capture_c + ")")
		ClosureAbiFloat16:
			Some("blorp_box_float16(" + capture_c + ")")
		ClosureAbiInt128:
			None
		ClosureAbiUInt128:
			None
		ClosureAbiStruct(c_type):
			Some(
				"({ " + c_type + " __cl_capture = " + capture_c + "; blorp_box_struct(&__cl_capture, sizeof(" + c_type + ")); })",
			)


private pure func closure_capture_needs_release(capture: CoreClosureCapture) -> Option[Bool]:
	abi_value ?= closure_abi_value_for_type(capture.typ)

	match abi_value:
		ClosureAbiVoid:
			Some(False)
		ClosureAbiPointer:
			if is_managed_pointer_capture_type(capture.typ):
				Some(True)
			else if is_unmanaged_pointer_capture_type(capture.typ):
				Some(False)
			else:
				None
		ClosureAbiPrim:
			Some(False)
		ClosureAbiFloat:
			Some(False)
		ClosureAbiFloat32:
			Some(False)
		ClosureAbiFloat16:
			Some(False)
		ClosureAbiInt128:
			None
		ClosureAbiUInt128:
			None
		ClosureAbiStruct(c_type):
			Some(True)


private pure func closure_capture_assignments(captures: List[CoreClosureCapture]) -> Option[String]:
	var result: String = ""
	var failed: Bool = False
	var index: Int = 0

	for capture in captures:
		if not failed:
			match closure_capture_box_expr(capture):
				Some(boxed):
					result += " ((void**)__cl_new->env)[" + index.to_string() + "] = " + boxed + ";"
				None:
					failed = True
					break

		index += 1

	if failed:
		None
	else:
		Some(result)


private pure func closure_capture_release_mask(captures: List[CoreClosureCapture]) -> Option[Int]:
	var mask: Int = 0
	var failed: Bool = False
	var index: Int = 0

	for capture in captures:
		if not failed:
			match closure_capture_needs_release(capture):
				Some(needs_release):
					if needs_release:
						mask += int_power_of_two(index)
				None:
					failed = True
					break

		index += 1

	if failed:
		None
	else:
		Some(mask)


private pure func emit_closure_create(closure: CoreClosureCreate) -> Option[String]:
	if closure.captures.length() == 0:
		Some("((void*)&" + c_identifier(closure.static_name) + ")")
	else:
		assignments ?= closure_capture_assignments(closure.captures)
		release_mask ?= closure_capture_release_mask(closure.captures)

		Some(
			"({ blorp_Closure* __cl_new = blorp_closure_new_inline((void*)" + c_identifier(
				closure.c_name,
			) + ", " + closure.captures
				.length()
				.to_string() + ");" + assignments + " __cl_new->env_release_mask = " + release_mask.to_string() + "UL; (void*)__cl_new; })",
		)


private pure func closure_slot_decl(typ: CoreType, name: String, source: String) -> Option[String]:
	abi_value ?= closure_abi_value_for_type(typ)
	param_type: String = c_type_name(typ)
	param_name: String = c_local_name(name)

	match abi_value:
		ClosureAbiVoid:
			None
		ClosureAbiPointer:
			Some("  " + param_type + " " + param_name + " = (" + param_type + ")" + source + ";\n")
		ClosureAbiPrim:
			Some(
				"  " + param_type + " " + param_name + " = (" + param_type + ")(long)" + source + ";\n",
			)
		ClosureAbiFloat:
			Some("  double " + param_name + " = blorp_unbox_float(" + source + ");\n")
		ClosureAbiFloat32:
			Some("  float " + param_name + " = blorp_unbox_float32(" + source + ");\n")
		ClosureAbiFloat16:
			Some("  _Float16 " + param_name + " = blorp_unbox_float16(" + source + ");\n")
		ClosureAbiInt128:
			Some("  __int128 " + param_name + " = blorp_unbox_int128(" + source + ");\n")
		ClosureAbiUInt128:
			Some("  unsigned __int128 " + param_name + " = blorp_unbox_uint128(" + source + ");\n")
		ClosureAbiStruct(c_type):
			Some(
				"  " + c_type + " " + param_name + " = *(" + c_type + "*)((char*)" + source + " + sizeof(blorp_Object));\n",
			)


private pure func closure_param_decl(param: CoreParam, index: Int) -> Option[String]:
	closure_slot_decl(param.typ, param.name.name, "__arg" + index.to_string())


private pure func closure_param_decls(params: List[CoreParam]) -> Option[String]:
	var result: String = ""
	var failed: Bool = False
	var index: Int = 0

	for param in params:
		if not failed:
			match closure_param_decl(param, index):
				Some(decl):
					result += decl
				None:
					failed = True
					break

		index += 1

	if failed:
		None
	else:
		Some(result)


private pure func closure_capture_decl(
	capture: CoreClosureCapture,
	index: Int,
	moved_captures: List[String],
) -> Option[String]:
	decl ?= closure_slot_decl(capture.typ, capture.name, "__e[" + index.to_string() + "]")

	if moved_captures.contains(capture.name):
		capture_var: CoreVar = {
			name = capture.name,
			uniq = 0,
			def_id = None
		}
		Some(
			decl + "  __e[" + index.to_string() + "] = NULL;\n" + cancellation_cleanup_push_statement(
				capture_var,
				cleanup_release_policy_for_type(capture.typ),
			),
		)
	else:
		Some(decl)


private pure func closure_capture_decls(
	captures: List[CoreClosureCapture],
	moved_captures: List[String],
) -> Option[String]:
	var result: String = ""
	var failed: Bool = False
	var index: Int = 0

	for capture in captures:
		if not failed:
			match closure_capture_decl(capture, index, moved_captures):
				Some(decl):
					result += decl
				None:
					failed = True
					break

		index += 1

	if failed:
		None
	else:
		Some(result)


private pure func closure_env_prelude(abi: CoreClosureAbi) -> Option[String]:
	if abi.captures.length() == 0:
		Some("  (void)__env;\n")
	else:
		capture_decls ?= closure_capture_decls(abi.captures, abi.moved_captures)
		Some("  void** __e = (void**)__env;\n" + capture_decls)


private pure func closure_body_suffix(abi: CoreClosureAbi) -> String:
	if abi.captures.length() == 0:
		emit_static_closure_definition(abi)
	else:
		""


private pure func closure_return_value(return_type: CoreType, value_c: String) -> Option[String]:
	abi_value ?= closure_abi_value_for_type(return_type)

	match abi_value:
		ClosureAbiVoid:
			Some("(void*)0")
		ClosureAbiPointer:
			Some("(void*)" + value_c)
		ClosureAbiPrim:
			Some("(void*)(long)(" + value_c + ")")
		ClosureAbiFloat:
			Some("blorp_box_float(" + value_c + ")")
		ClosureAbiFloat32:
			Some("blorp_box_float32(" + value_c + ")")
		ClosureAbiFloat16:
			Some("blorp_box_float16(" + value_c + ")")
		ClosureAbiInt128:
			Some("blorp_box_int128(" + value_c + ")")
		ClosureAbiUInt128:
			Some("blorp_box_uint128(" + value_c + ")")
		ClosureAbiStruct(c_type):
			if is_stack_result_type(return_type):
				Some(
					"({ " + c_type + " __cl_ret = " + value_c + "; blorp_box_stack_result(__cl_ret); })",
				)
			else:
				Some(
					"({ " + c_type + " __cl_ret = " + value_c + "; blorp_box_struct(&__cl_ret, sizeof(" + c_type + ")); })",
				)


private pure func closure_body_return_type(abi: CoreClosureAbi, return_type: CoreType) -> String:
	if is_void_type(return_type) and not abi.task_abi:
		"void"
	else:
		"void*"


private pure func closure_body_signature(func_info: CoreFunction, abi: CoreClosureAbi) -> String:
	var params: String = "void* __env"
	var index: Int = 0

	for param in abi.params:
		params += ", void* __arg" + index.to_string()
		index += 1

	closure_body_return_type(
		abi,
		func_info.return_type,
	) + " " + c_identifier(abi.c_name) + "(" + params + ")"


private pure func static_closure_name(c_name: String) -> String:
	"__sc_" + c_identifier(c_name)


private pure func emit_static_closure_definition(abi: CoreClosureAbi) -> String:
	static_name: String = static_closure_name(abi.c_name)
	function_name: String = c_identifier(abi.c_name)

	"static blorp_Closure " + static_name + " = { { BLORP_IMMORTAL_REFCOUNT, BLORP_ALLOC_CLASS_DIRECT, 0 }, (void*)" + function_name + ", NULL, 0, 0 };\n"


private pure func emit_closure_body_function(
	func_info: CoreFunction,
	abi: CoreClosureAbi,
) -> Option[String]:
	match func_info.body:
		Some(body):
			param_decls ?= closure_param_decls(abi.params)
			env_prelude ?= closure_env_prelude(abi)
			body_c ?= emit_function_body(body, 0)
			prefix: String = closure_body_signature(
				func_info,
				abi,
			) + " {\n" + env_prelude + param_decls
			suffix: String = closure_body_suffix(abi)

			if is_void_type(func_info.return_type):
				if abi.task_abi:
					Some(prefix + discard_body(body_c) + "  return (void*)0;\n}\n" + suffix)
				else:
					Some(prefix + discard_body(body_c) + "}\n" + suffix)
			else if body_c.returns:
				None
			else:
				return_value ?= required_body_value(body_c)
				boxed_return ?= closure_return_value(func_info.return_type, return_value)
				Some(prefix + body_c.statements + "  return " + boxed_return + ";\n}\n" + suffix)
		None:
			None


private pure func emit_drop_statement(
	variable: CoreVar,
	release_policy: CoreReleasePolicy,
) -> String:
	owned_temp_cleanup_pop_statement(
		c_var_name(variable),
		release_policy,
	) + emit_release_statement(c_var_name(variable), release_policy)


private pure func emit_release_statement(
	value: String,
	release_policy: CoreReleasePolicy,
) -> String:
	match release_policy:
		NoReleasePolicy:
			""
		ArcReleasePolicy:
			"  blorp_release(" + value + ");\n"
		ArcReleaseOnlyPolicy:
			"  blorp_release_arc_only(" + value + ");\n"
		StackResultReleasePolicy:
			"  blorp_stack_result_release(" + value + ");\n"


private pure func is_generated_temp_value(value: String) -> Bool:
	if not value.starts_with("__"):
		False
	else if value.contains(" "):
		False
	else if value.contains("("):
		False
	else if value.contains(")"):
		False
	else if value.contains("["):
		False
	else if value.contains("]"):
		False
	else if value.contains("."):
		False
	else if value.contains("->"):
		False
	else:
		True


private pure func body_value_can_be_cleanup_slot(body: FunctionBodyC) -> Bool:
	body.statements != "" and body.value != "" and is_generated_temp_value(body.value)


private pure func owned_body_value_cleanup(body: FunctionBodyC, typ: CoreType) -> String:
	if not body_value_can_be_cleanup_slot(body):
		""
	else:
		policy: CoreReleasePolicy = cleanup_release_policy_for_type(typ)
		owned_temp_cleanup_pop_statement(
			body.value,
			policy,
		) + emit_release_statement(body.value, policy)


private pure func transferred_body_value_cleanup_pop(body: FunctionBodyC, typ: CoreType) -> String:
	if not body_value_can_be_cleanup_slot(body):
		""
	else:
		owned_temp_cleanup_pop_statement(body.value, cleanup_release_policy_for_type(typ))


private pure func transferred_body_value_release_after_match(
	body: FunctionBodyC,
	typ: CoreType,
	scrutinee_temp: String,
	scrutinee_release_policy: CoreReleasePolicy,
) -> String:
	if not body_value_can_be_cleanup_slot(body):
		""
	else:
		match owned_temp_cleanup_release_fn(scrutinee_release_policy):
			Some(release_fn):
				""
			None:
				emit_release_statement(scrutinee_temp, cleanup_release_policy_for_type(typ))


private pure func owned_temp_cleanup_frame_name(slot: String) -> String:
	"__blorp_owned_cleanup_" + slot


private pure func owned_temp_cleanup_release_fn(policy: CoreReleasePolicy) -> Option[String]:
	match policy:
		NoReleasePolicy:
			None
		ArcReleasePolicy:
			Some("blorp_cleanup_release_arc_value")
		ArcReleaseOnlyPolicy:
			Some("blorp_cleanup_release_arc_only_value")
		StackResultReleasePolicy:
			Some("blorp_cleanup_stack_result_value")


private pure func owned_temp_cleanup_value_arg(slot: String, policy: CoreReleasePolicy) -> String:
	match policy:
		NoReleasePolicy:
			"(void*)0"
		ArcReleasePolicy:
			"(void*)" + slot
		ArcReleaseOnlyPolicy:
			"(void*)" + slot
		StackResultReleasePolicy:
			"(void*)&" + slot


private pure func owned_temp_cleanup_push_statement(
	slot: String,
	policy: CoreReleasePolicy,
) -> String:
	match owned_temp_cleanup_release_fn(policy):
		Some(release_fn):
			frame_name: String = owned_temp_cleanup_frame_name(slot)
			value_arg: String = owned_temp_cleanup_value_arg(slot, policy)
			"  blorp_CancelCleanupFrame " + frame_name + ";\n  blorp_task_cleanup_push(&" + frame_name + ", &" + slot + ", " + value_arg + ", " + release_fn + ");\n"
		None:
			""


private pure func owned_temp_cleanup_pop_statement(
	slot: String,
	policy: CoreReleasePolicy,
) -> String:
	match owned_temp_cleanup_release_fn(policy):
		Some(release_fn):
			"  blorp_task_cleanup_pop_slot(&" + slot + ");\n"
		None:
			""


private pure func cleanup_release_policy_for_type(typ: CoreType) -> CoreReleasePolicy:
	CoreTypePolicy.cleanup_release_policy_for_type(typ)


private pure func let_cleanup_policy(
	variable: CoreVar,
	is_mutable: Bool,
	typ: CoreType,
) -> CoreReleasePolicy:
	if variable.name == "_":
		NoReleasePolicy
	else if is_mutable:
		NoReleasePolicy
	else:
		cleanup_release_policy_for_type(typ)


private pure func let_tracks_cleanup(
	cleanup_policy: CoreReleasePolicy,
	body: CoreExpr,
	variable: CoreVar,
) -> Bool:
	(
		release_policy_requires_cleanup(cleanup_policy)
		and not let_body_takes_cleanup_ownership(body, variable)
	)


private pure func cancellation_cleanup_push_statement(
	variable: CoreVar,
	policy: CoreReleasePolicy,
) -> String:
	match owned_temp_cleanup_release_fn(policy):
		Some(release_fn):
			var_name: String = c_var_name(variable)
			frame_name: String = cleanup_frame_name(variable)
			value_arg: String = owned_temp_cleanup_value_arg(var_name, policy)
			"  blorp_CancelCleanupFrame " + frame_name + ";\n  blorp_task_cleanup_push(&" + frame_name + ", &" + var_name + ", " + value_arg + ", " + release_fn + ");\n"
		None:
			""


private pure func consuming_handoff_intrinsic(name: String) -> Bool:
	(
		name == "list_cow"
		or name == "list_ensure_unique"
		or name == "list_ensure_capacity"
		or name == "string_cow"
		or name == "string_ensure_capacity"
		or name == "bytes_cow"
		or name == "dict_cow"
		or name == "set_cow"
	)


private pure func handoff_source_cleanup_pop_statement(rhs: CoreExpr) -> String:
	match rhs:
		CallExpr(kind, callee, args, typ, loc):
			match kind:
				IntrinsicCall(name):
					if consuming_handoff_intrinsic(name):
						match args:
							[VarExpr(source, source_type, source_loc), ...rest]:
								cancellation_cleanup_pop_statement(source)
							[]:
								""
							[first, ...rest]:
								""
					else:
						""
				UserCall(name, def_id, consumed_args):
					""
				BuiltinCall(name):
					""
				DirectRuntimeCall(call):
					""
				TensorParallelCall(name, layout):
					""
				DictWithCapacityCall(constructor):
					""
				ForeignCall(name, arg_passing):
					""
				OperationResultCall(bridge):
					""
				FallibleStreamTerminalCall(bridge):
					""
				ListToStringCall(callback_name):
					""
				ClosureCall:
					""
				UnknownCall | DeferredTraitCall(_, _) | SelectedTraitCall(_, _, _, _):
					""
				SelectedDirectCall(def_id):
					""
		LiteralExpr(literal, typ, loc):
			""
		VarExpr(variable, typ, loc):
			""
		VoidExpr(typ, loc):
			""
		DebugBlockExpr(body, typ, loc):
			""
		CooperativeCheckpointExpr(typ, loc):
			""
		RawMatchExpr(scrutinee, cases, typ, loc):
			""
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			""
		BinaryExpr(op, left, right, typ, loc):
			""
		UnaryExpr(op, expr_value, typ, loc):
			""
		LogicalExpr(op, left, right, typ, loc):
			""
		AssignExpr(assign_var, assign_rhs, typ, loc):
			""
		CastExpr(expr_value, typ, loc):
			""
		BoxExpr(box, typ, loc):
			""
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			""
		FieldExpr(expr_value, field_name, typ, loc):
			""
		TupleFieldExpr(expr_value, field_index, typ, loc):
			""
		TupleExpr(items, typ, loc):
			""
		TupleConstructExpr(tuple_construct, typ, loc):
			""
		VectorExpr(items, typ, loc):
			""
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			""
		ClosureCreateExpr(closure, typ, loc):
			""
		ListConstructExpr(construct, typ, loc):
			""
		ListAllocExpr(alloc, typ, loc):
			""
		ListGetExpr(get, typ, loc):
			""
		ListHandoffExpr(handoff, typ, loc):
			""
		ListHandoffSetOwnedExpr(set, typ, loc):
			""
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			""
		ListRetainExpr(retain, typ, loc):
			""
		ListSetExpr(set, typ, loc):
			""
		ListSwapExpr(swap, typ, loc):
			""
		StringByteReadExpr(read, typ, loc):
			""
		StringByteWriteExpr(write, typ, loc):
			""
		StringByteCopyExpr(copy, typ, loc):
			""
		StringSetLenExpr(set_len, typ, loc):
			""
		TensorLiteralExpr(literal, typ, loc):
			""
		TensorBoxedLiteralExpr(literal, typ, loc):
			""
		TensorPackedLiteralExpr(literal, typ, loc):
			""
		TensorRawFillExpr(fill, typ, loc):
			""
		TensorRawReadExpr(read, typ, loc):
			""
		TensorRawWriteExpr(write, typ, loc):
			""
		TensorRawViewLetExpr(binding, body, typ, loc):
			""
		DictExpr(entries, typ, loc):
			""
		DictConstructExpr(construct, typ, loc):
			""
		SetAllocExpr(alloc, typ, loc):
			""
		RecordExpr(fields, typ, loc):
			""
		RecordUpdateExpr(base, fields, typ, loc):
			""
		RecordReuseExpr(source, fields, typ, loc):
			""
		RecordConstructExpr(type_name, fields, typ, loc):
			""
		UnionConstructExpr(construct, typ, loc):
			""
		UnionReuseConstructExpr(construct, typ, loc):
			""
		PreClosureDetachExpr(detached, typ, loc):
			""
		DupExpr(dup_var, value_type, retain_policy, body, typ, loc):
			""
		DropExpr(drop_var, value_type, release_policy, body, typ, loc):
			""
		LetExpr(name, is_mutable, typ, let_rhs, body):
			""
		BorrowLetExpr(name, typ, rhs, body):
			""
		SeqExpr(first, second):
			""
		WhileExpr(cond, body, typ, loc):
			""
		BreakExpr(typ, loc):
			""
		ContinueExpr(typ, loc):
			""
		ResourceScopeExpr(scope, typ, loc):
			""
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			""
		TailrecLoopExpr(params, return_type, body, loc):
			""
		TailrecRecurExpr(args, typ, loc):
			""
		TailrecListSpreadLoopExpr(loop, loc):
			""
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
