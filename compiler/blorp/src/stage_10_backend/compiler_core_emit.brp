pure func core_emit_error_message(error: CoreEmitError) -> String:
	match error:
		UnsupportedGlobalInitializer(global_name):
			"unsupported global initializer for `${global_name}`"


private DEFAULT_PROFILE_ENABLED: Bool = False

private MANGLED_DEF_ID_PREFIX: String = "__def_"


