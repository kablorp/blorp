private pure func emit_channel_send_retained_value_for_rendered_args(
	name: String,
	rendered_args: List[String],
	typ: CoreType,
) -> Option[String]:
	match rendered_args:
		[channel, value]:
			args: ChannelRetainingSendArgs = {
				result_type = c_type_name(typ),
				channel = channel,
				value = value,
				temp_seed = CHANNEL_SEND_TEMP_SEED
			}
			emit_retaining_channel_send_value(name, args)
		[]:
			None
		[first]:
			None
		[first, second, third, ...rest]:
			None


private pure func emit_channel_send_retained_value_for_source_args(
	name: String,
	rendered_args: List[String],
	source_args: List[CoreExpr],
	typ: CoreType,
) -> Option[String]:
	match source_args:
		[channel_source, value_source]:
			if boxed_expr_temp_needs_release(value_source):
				emit_channel_send_retained_value_for_rendered_args(name, rendered_args, typ)
			else:
				None
		[]:
			None
		[first]:
			None
		[first, second, third, ...rest]:
			None


