	if name == "blorp_vector_set_cow_nullable" or name == "blorp_checked_set":
		match args:
			[tensor_expr, index_expr, BoxExpr(box, box_type, box_loc)]:
				match box.kind:
					StructBox(c_type):
						emit_boxed_tensor_set_call_with_prefix(
							name,
							[tensor_expr, index_expr],
							box,
							typ,
						)
					VoidBox:
						None
					FloatBox:
						None
					Float32Box:
						None
					Float16Box:
						None
					Int128Box:
						None
					UInt128Box:
						None
					PrimBox:
						None
					PointerBox:
						None
			[]:
				None
			[first]:
				None
			[first, second]:
				None
			[first, second, third, ...rest]:
				None
	else if name == "blorp_matrix_checked_set":
		match args:
			[tensor_expr, row_expr, col_expr, BoxExpr(box, box_type, box_loc)]:
				match box.kind:
					StructBox(c_type):
						emit_boxed_tensor_set_call_with_prefix(
							name,
							[tensor_expr, row_expr, col_expr],
							box,
							typ,
						)
					VoidBox:
						None
					FloatBox:
						None
					Float32Box:
						None
					Float16Box:
						None
					Int128Box:
						None
					UInt128Box:
						None
					PrimBox:
						None
					PointerBox:
						None
			[]:
				None
			[first]:
				None
			[first, second]:
				None
			[first, second, third]:
				None
			[first, second, third, fourth, ...rest]:
				None
	else:
		None


private pure func emit_typed_direct_tensor_call(
	call: CoreDirectRuntimeCall,
	args: List[CoreExpr],
	typ: CoreType,
) -> Option[String]:
	match emit_tensor_fill_packed_call(call.name, args):
		Some(rendered):
			Some(rendered)
		None:
			match emit_tensor_fill_inline_struct_call(call.name, args):
				Some(rendered):
					Some(rendered)
				None:
					emit_struct_boxed_tensor_set_call(call.name, args, typ)


private pure func is_box_expr(expr: CoreExpr) -> Bool:
	match expr:
		BoxExpr(box, typ, loc):
			True
		other:
			False


private union DirectNonboxedTensorCall:
	DirectVectorFillCall(CoreExpr, String, String)
	DirectMatrixFillCall(CoreExpr, String, String, String)
	DirectCheckedSetCall(CoreExpr, String, String, String)
	DirectVectorSetCowNullableCall(CoreExpr, String, String, String)
	DirectMatrixCheckedSetCall(CoreExpr, String, String, String, String)


private pure func parse_direct_nonboxed_tensor_call(
	name: String,
	args: List[CoreExpr],
	arg_values: List[String],
) -> Option[DirectNonboxedTensorCall]:
	match (name, args, arg_values):
		("blorp_vector_new_fill", [value_expr, size_expr], [value_c, size_c]):
			Some(DirectVectorFillCall(value_expr, value_c, size_c))
		("blorp_matrix_new_fill", [value_expr, rows_expr, cols_expr], [value_c, rows_c, cols_c]):
			Some(DirectMatrixFillCall(value_expr, value_c, rows_c, cols_c))
		("blorp_checked_set", [tensor_expr, index_expr, value_expr], [tensor_c, index_c, value_c]):
			Some(DirectCheckedSetCall(value_expr, tensor_c, index_c, value_c))
		("blorp_vector_set_cow_nullable", [tensor_expr, index_expr, value_expr], [tensor_c, index_c, value_c]):
			Some(DirectVectorSetCowNullableCall(value_expr, tensor_c, index_c, value_c))
		("blorp_matrix_checked_set", [tensor_expr, row_expr, col_expr, value_expr], [tensor_c, row_c, col_c, value_c]):
			Some(DirectMatrixCheckedSetCall(value_expr, tensor_c, row_c, col_c, value_c))
		_:
			None


private pure func emit_direct_nonboxed_runtime_call(
	value_expr: CoreExpr,
	name: String,
	args: List[String],
	typ: CoreType,
) -> Option[String]:
	if is_box_expr(value_expr):
		None
	else:
		emit_direct_runtime_call(
			{
				name = name,
				args = DirectRuntimeArgsAsWritten,
				result = DirectRuntimeResultAsWritten
			},
			args,
		)


private pure func emit_managed_pointer_vector_fill_call(
	value_expr: CoreExpr,
	value_c: String,
	size_c: String,
) -> Option[String]:
	if boxed_value_needs_release_type(core_expr_type(value_expr)):
		value_type: String = c_type_name(core_expr_type(value_expr))
		value_name: String = "__fill_value_" + TENSOR_FILL_TEMP_SEED
		size_name: String = "__fill_size_" + TENSOR_FILL_TEMP_SEED
		vector_name: String = "__fill_vector_" + TENSOR_FILL_TEMP_SEED
		index_name: String = "__fill_index_" + TENSOR_FILL_TEMP_SEED

		Some(
			"({ " + value_type + " " + value_name + " = " + value_c + "; long " + size_name + " = " + size_c + "; blorp_Vector* " + vector_name + " = blorp_vector_new(" + size_name + "); blorp_vector_init_elem_release(" + vector_name + ", blorp_elem_release_fn); for (long " + index_name + " = 0; " + index_name + " < " + size_name + "; " + index_name + "++) { " + vector_name + "->data[" + index_name + "] = (void*)" + value_name + "; if (" + value_name + ") blorp_retain(" + value_name + "); } " + vector_name + "; })",
		)
	else:
		None


private pure func emit_managed_pointer_matrix_fill_call(
	value_expr: CoreExpr,
	value_c: String,
	rows_c: String,
	cols_c: String,
) -> Option[String]:
	if boxed_value_needs_release_type(core_expr_type(value_expr)):
		value_type: String = c_type_name(core_expr_type(value_expr))
		value_name: String = "__fill_value_" + TENSOR_FILL_TEMP_SEED
		rows_name: String = "__fill_rows_" + TENSOR_FILL_TEMP_SEED
		cols_name: String = "__fill_cols_" + TENSOR_FILL_TEMP_SEED
		total_name: String = "__fill_total_" + TENSOR_FILL_TEMP_SEED
		matrix_name: String = "__fill_matrix_" + TENSOR_FILL_TEMP_SEED
		index_name: String = "__fill_index_" + TENSOR_FILL_TEMP_SEED

		Some(
			"({ " + value_type + " " + value_name + " = " + value_c + "; long " + rows_name + " = " + rows_c + "; long " + cols_name + " = " + cols_c + "; long " + total_name + " = ((" + rows_name + " < 0 || " + cols_name + " < 0) ? 0 : (" + rows_name + " * " + cols_name + ")); blorp_Vector* " + matrix_name + " = blorp_tensor_new(" + rows_name + ", " + total_name + "); blorp_vector_init_elem_release(" + matrix_name + ", blorp_elem_release_fn); for (long " + index_name + " = 0; " + index_name + " < " + total_name + "; " + index_name + "++) { " + matrix_name + "->data[" + index_name + "] = (void*)" + value_name + "; if (" + value_name + ") blorp_retain(" + value_name + "); } " + matrix_name + "; })",
		)
	else:
		None


private pure func emit_direct_nonboxed_tensor_call(
	call: DirectNonboxedTensorCall,
	typ: CoreType,
) -> Option[String]:
	match call:
		DirectVectorFillCall(value_expr, value_c, size_c):
			match emit_managed_pointer_vector_fill_call(value_expr, value_c, size_c):
				Some(rendered):
					Some(rendered)
				None:
					emit_direct_nonboxed_runtime_call(
						value_expr,
						"blorp_vector_new_fill",
						[value_c, size_c],
						typ,
					)
		DirectMatrixFillCall(value_expr, value_c, rows_c, cols_c):
			match emit_managed_pointer_matrix_fill_call(value_expr, value_c, rows_c, cols_c):
				Some(rendered):
					Some(rendered)
				None:
					emit_direct_nonboxed_runtime_call(
						value_expr,
						"blorp_matrix_new_fill",
						[value_c, rows_c, cols_c],
						typ,
					)
		DirectCheckedSetCall(value_expr, tensor_c, index_c, value_c):
			emit_direct_nonboxed_runtime_call(
				value_expr,
				"blorp_checked_set",
				[tensor_c, index_c, value_c],
				typ,
			)
		DirectVectorSetCowNullableCall(value_expr, tensor_c, index_c, value_c):
			emit_direct_nonboxed_runtime_call(
				value_expr,
				"blorp_vector_set_cow_nullable",
				[tensor_c, index_c, value_c],
				typ,
			)
		DirectMatrixCheckedSetCall(value_expr, tensor_c, row_c, col_c, value_c):
			emit_direct_nonboxed_runtime_call(
				value_expr,
				"blorp_matrix_checked_set",
				[tensor_c, row_c, col_c, value_c],
				typ,
			)


private pure func emit_direct_nonboxed_tensor_call_from_values(
	name: String,
	args: List[CoreExpr],
	arg_values: List[String],
	typ: CoreType,
) -> Option[String]:
	call ?= parse_direct_nonboxed_tensor_call(name, args, arg_values)
	emit_direct_nonboxed_tensor_call(call, typ)


private pure func is_specific_float_vector_scalar_call(name: String) -> Bool:
	(
		name == "blorp_vector_scalar_add_f64"
		or name == "blorp_vector_scalar_sub_f64"
		or name == "blorp_vector_scalar_mul_f64"
		or name == "blorp_vector_scalar_div_f64"
		or name == "blorp_vector_scalar_rev_sub_f64"
		or name == "blorp_vector_scalar_rev_div_f64"
		or name == "blorp_vector_scalar_add_f32"
		or name == "blorp_vector_scalar_sub_f32"
		or name == "blorp_vector_scalar_mul_f32"
		or name == "blorp_vector_scalar_div_f32"
		or name == "blorp_vector_scalar_rev_sub_f32"
		or name == "blorp_vector_scalar_rev_div_f32"
	)


private pure func typed_float_scalar_arg(expr: CoreExpr, rendered: String) -> String:
	match expr:
		LiteralExpr(FloatLiteral(value), typ, loc):
			value.to_string()
		LiteralExpr(FloatTextLiteral(value), typ, loc):
			value
		other:
			rendered


private pure func emit_specific_float_vector_scalar_call(
	call: CoreDirectRuntimeCall,
	args: List[CoreExpr],
	arg_values: List[String],
) -> Option[String]:
	if is_specific_float_vector_scalar_call(call.name):
		match (args, arg_values):
			([vector_expr, scalar_expr], [vector_c, scalar_c]):
				emit_direct_runtime_call(
					call,
					[vector_c, typed_float_scalar_arg(scalar_expr, scalar_c)],
				)
			_:
				None
	else:
		None


private pure func emit_direct_runtime_tensor_call_from_values(
	call: CoreDirectRuntimeCall,
	args: List[CoreExpr],
	arg_values: List[String],
	typ: CoreType,
) -> Option[String]:
	match emit_specific_float_vector_scalar_call(call, args, arg_values):
		Some(rendered):
			Some(rendered)
		None:
			match call.args:
				DirectRuntimeArgsAsWritten:
					match call.result:
						DirectRuntimeResultAsWritten:
							emit_direct_nonboxed_tensor_call_from_values(
								call.name,
								args,
								arg_values,
								typ,
							)
						DirectRuntimeResultCast(c_type):
							None
						DirectRuntimeResultStackResultFromBoxed:
							None
				DirectRuntimeArgsAppendListParallelLayout(layout):
					None


private pure func emit_intrinsic_call(name: String, args: List[CoreExpr]) -> Option[String]:
	arg_values ?= emit_simple_expr_arg_values(args)
	emit_intrinsic_call_from_values(name, arg_values)


private pure func emit_intrinsic_call_from_values(
	name: String,
	arg_values: List[String],
) -> Option[String]:
	match emit_prepared_list_intrinsic_call(name, arg_values):
		Some(rendered):
			Some(rendered)
		None:
			match emit_prepared_tensor_intrinsic_call(name, arg_values):
				Some(rendered):
					Some(rendered)
				None:
					match Intrinsic.render_intrinsic(name, arg_values):
						Ok(rendered):
							Some(rendered)
						Err(error):
							None


private pure func emit_call_args_body(args: List[CoreExpr], next_temp: Int) -> Option[CallArgsBody]:
	var statements: String = ""
	var values: List[String] = []
	var failed: Bool = False
	var temp_index: Int = next_temp

	for arg in args:
		if not failed:
			match emit_function_body(arg, temp_index):
				Some(arg_body):
					if arg_body.returns:
						failed = True
						break
					else:
						match required_body_value(arg_body):
							Some(arg_value):
								scoped_arg: FunctionBodyC = scoped_body_value(
									"call_arg",
									core_expr_type(arg),
									arg_body,
								)
								statements += scoped_arg.statements
								values = values.append(scoped_arg.value)
								temp_index = scoped_arg.next_temp
							None:
								failed = True
								break
				None:
					failed = True
					break

	if failed:
		None
	else:
		Some({
			statements = statements,
			args = values,
			cleanup_slots = [],
			next_temp = temp_index,
		})


private pure func runtime_call_consumes_tensor_receiver(name: String) -> Bool:
	TENSOR_RECEIVER_CONSUMING_RUNTIME_CALLS.contains(name)


private pure func contract_consumed_arg_indices(contract: OwnershipCallContract) -> List[Int]:
	var consumed: List[Int] = []
	var index: Int = 0

	for mode in contract.args:
		if arg_consumes_caller(mode):
			consumed = consumed.append(index)
		else:
			void

		index += 1

	consumed


private pure func call_kind_ownership_contract(
	kind: CoreCallKind,
	arg_count: Int,
) -> Option[OwnershipCallContract]:
	match kind:
		IntrinsicCall(name):
			intrinsic_contract(name, arg_count)
		BuiltinCall(name):
			builtin_contract(name, arg_count)
		DirectRuntimeCall(call):
			builtin_contract(call.name, arg_count)
		OperationResultCall(bridge):
			builtin_contract(bridge.builtin_name, arg_count)
		FallibleStreamTerminalCall(bridge):
			builtin_contract(bridge.builtin_name, arg_count)
		TensorParallelCall(name, layout):
			builtin_contract(name, arg_count)
		DictWithCapacityCall(constructor):
			builtin_contract("blorp_dict_with_capacity_custom", arg_count)
		ListToStringCall(callback_name):
			builtin_contract("blorp_list_to_string_cb", arg_count)
		UserCall(name, def_id, consumed_args):
			None
		ForeignCall(name, arg_passing):
			None
		ClosureCall:
			None
		UnknownCall | DeferredTraitCall(_, _) | SelectedTraitCall(_, _, _, _):
			None
		SelectedDirectCall(def_id):
			None


private pure func fallback_call_consumed_arg_indices(kind: CoreCallKind) -> List[Int]:
	match kind:
		IntrinsicCall(name):
			if consuming_handoff_intrinsic(name):
				[0]
			else:
				[]
		BuiltinCall(name):
			if runtime_call_consumes_tensor_receiver(name):
				[0]
			else:
				[]
		DirectRuntimeCall(call):
			if runtime_call_consumes_tensor_receiver(call.name):
				[0]
			else if call.name == "blorp_stream_fold":
				[1]
			else:
				[]
		UserCall(name, def_id, consumed_args):
			consumed_args
		TensorParallelCall(name, layout):
			[]
		DictWithCapacityCall(constructor):
			[]
		ForeignCall(name, arg_passing):
			[]
		OperationResultCall(bridge):
			[]
		FallibleStreamTerminalCall(bridge):
			[]
		ListToStringCall(callback_name):
			[]
		ClosureCall:
			[]
		UnknownCall | DeferredTraitCall(_, _) | SelectedTraitCall(_, _, _, _):
			[]
		SelectedDirectCall(def_id):
			[]


private pure func call_kind_consumed_arg_indices(kind: CoreCallKind, arg_count: Int) -> List[Int]:
	match kind:
		UserCall(name, def_id, consumed_args):
			consumed_args
		_:
			match call_kind_ownership_contract(kind, arg_count):
				Some(contract):
					contract_consumed_arg_indices(contract)
				None:
					fallback_call_consumed_arg_indices(kind)


private pure func call_kind_consumes_arg(kind: CoreCallKind, arg_count: Int, index: Int) -> Bool:
	call_kind_consumed_arg_indices(kind, arg_count).contains(index)


private pure func direct_runtime_call_arg_ownership(
	call: CoreDirectRuntimeCall,
	arg_count: Int,
	index: Int,
) -> CallArgOwnership:
	if call_kind_consumes_arg(DirectRuntimeCall(call), arg_count, index):
		CallConsumesArg
	else:
		CallBorrowsArg


private pure func call_arg_needs_cleanup(arg: CoreExpr) -> Bool:
	policy: CoreReleasePolicy = cleanup_release_policy_for_type(core_expr_type(arg))
	expr_transfers_ownership(arg) and release_policy_requires_cleanup(policy)


private pure func materialized_call_arg_value(arg: CoreExpr, body: FunctionBodyC) -> FunctionBodyC:
	if call_arg_needs_cleanup(arg):
		result_name: String = temp_name("call_arg", body.next_temp)
		{
			statements = body.statements + "  " + c_type_name(
				core_expr_type(arg),
			) + " " + result_name + " = " + body.value + ";\n",
			value = result_name,
			next_temp = body.next_temp + 1,
			returns = False
		}
	else:
		scoped_body_value("call_arg", core_expr_type(arg), body)


private pure func emit_direct_runtime_call_args_body(
	call: CoreDirectRuntimeCall,
	args: List[CoreExpr],
	next_temp: Int,
) -> Option[CallArgsBody]:
	var statements: String = ""
	var values: List[String] = []
	var cleanup_slots: List[CallArgCleanupSlot] = []
	var failed: Bool = False
	var temp_index: Int = next_temp
	var index: Int = 0

	for arg in args:
		if not failed:
			match emit_function_body(arg, temp_index):
				Some(arg_body):
					if arg_body.returns:
						failed = True
						break
					else:
						match required_body_value(arg_body):
							Some(arg_value):
								scoped_arg: FunctionBodyC = materialized_call_arg_value(
									arg,
									arg_body,
								)
								ownership: CallArgOwnership = direct_runtime_call_arg_ownership(
									call,
									args.length(),
									index,
								)
								policy: CoreReleasePolicy = cleanup_release_policy_for_type(
									core_expr_type(arg),
								)
								needs_cleanup: Bool = call_arg_needs_cleanup(arg)
								statements += scoped_arg.statements

								if needs_cleanup:
									statements += owned_temp_cleanup_push_statement(
										scoped_arg.value,
										policy,
									)
									cleanup_slots = cleanup_slots.append({
										slot_name = scoped_arg.value,
										policy = policy,
										call_ownership = ownership,
									})

								values = values.append(scoped_arg.value)
								temp_index = scoped_arg.next_temp
							None:
								failed = True
								break
				None:
					failed = True
					break

		index += 1

	if failed:
		None
	else:
		Some({
			statements = statements,
			args = values,
			cleanup_slots = cleanup_slots,
			next_temp = temp_index,
		})


private pure func call_arg_cleanup_pop_statement(cleanup: CallArgCleanupSlot) -> String:
	owned_temp_cleanup_pop_statement(cleanup.slot_name, cleanup.policy)


private pure func call_arg_cleanup_before_call(cleanup_slots: List[CallArgCleanupSlot]) -> String:
	var statements: String = ""

	for cleanup in cleanup_slots:
		match cleanup.call_ownership:
			CallConsumesArg:
				statements += call_arg_cleanup_pop_statement(cleanup)
			CallBorrowsArg:
				void

	statements


private pure func call_arg_cleanup_after_call(cleanup_slots: List[CallArgCleanupSlot]) -> String:
	var statements: String = ""

	for cleanup in cleanup_slots:
		match cleanup.call_ownership:
			CallBorrowsArg:
				statements += call_arg_cleanup_pop_statement(
					cleanup,
				) + emit_release_statement(cleanup.slot_name, cleanup.policy)
			CallConsumesArg:
				void

	statements


private pure func call_body_from_value(
	args_body: CallArgsBody,
	before_call: String,
	value: String,
	typ: CoreType,
) -> FunctionBodyC:
	call_prefix: String = args_body.statements + before_call + call_arg_cleanup_before_call(
		args_body.cleanup_slots,
	)
	call_suffix: String = call_arg_cleanup_after_call(args_body.cleanup_slots)

	if call_suffix == "":
		{
			statements = call_prefix,
			value = value,
			next_temp = args_body.next_temp,
			returns = False
		}
	else if is_void_type(typ):
		{
			statements = call_prefix + "  " + value + ";\n" + call_suffix,
			value = "",
			next_temp = args_body.next_temp,
			returns = False
		}
	else:
		result_name: String = temp_name("call_result", args_body.next_temp)
		{
			statements = call_prefix + "  " + c_type_name(
				typ,
			) + " " + result_name + " = " + value + ";\n" + call_suffix,
			value = result_name,
			next_temp = args_body.next_temp + 1,
			returns = False
		}


private pure func foreign_copy_c_type(copy_kind: CoreForeignCopyKind) -> String:
	match copy_kind:
		ForeignStringCopy:
			"blorp_String*"
		ForeignBytesCopy:
			"blorp_Bytes*"


private pure func foreign_copy_fn(copy_kind: CoreForeignCopyKind) -> String:
	match copy_kind:
		ForeignStringCopy:
			"blorp_string_copy_ffi"
		ForeignBytesCopy:
			"blorp_bytes_copy_ffi"


private pure func foreign_copy_temp_prefix(copy_kind: CoreForeignCopyKind) -> String:
	match copy_kind:
		ForeignStringCopy:
			"ffi_string_copy"
		ForeignBytesCopy:
			"ffi_bytes_copy"


private pure func foreign_copy_call_arg_value(
	copy_kind: CoreForeignCopyKind,
	temp: String,
) -> String:
	match copy_kind:
		ForeignStringCopy:
			"(const char*)((" + temp + ")->data)"
		ForeignBytesCopy:
			temp


private pure func is_foreign_string_arg(arg: CoreExpr) -> Bool:
	match core_expr_type(arg):
		NamedType(name, args):
			name == "String" or name == "LiteralString"
		TypeParameterType(_) | SelfType:
			False
		VoidType:
			False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			False
		FunctionType(is_pure, param_types, return_type):
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		HeapRecordType(name):
			False
		UnionType(name):
			False
		RangeType:
			False
		TensorType(info):
			False
		TupleType(items):
			False


private pure func foreign_borrow_arg_value(arg: CoreExpr, value: String) -> String:
	if is_foreign_string_arg(arg):
		"(const char*)((" + value + ")->data)"
	else:
		value


private pure func foreign_arg_may_have_compact_scalar_field(arg: CoreExpr) -> Bool:
	match arg:
		FieldExpr(_, _, typ, _):
			if c_value_record_field_type_is_boolean(typ):
				True
			else:
				match typ:
					EnumType(_):
						True
					_:
						False
		_:
			False


private pure func materialize_foreign_compact_scalar_field_args(
	args: List[CoreExpr],
	args_body: CallArgsBody,
) -> Option[CallArgsBody]:
	if args.length() != args_body.args.length():
		None
	else:
		var statements: String = args_body.statements
		var values: List[String] = []
		var temp_index: Int = args_body.next_temp
		var failed: Bool = False
		var index: Int = 0

		for arg in args:
			if not failed:
				match args_body.args.get(index):
					Some(arg_value):
						if foreign_arg_may_have_compact_scalar_field(arg):
							temp: String = temp_name("ffi_scalar_arg", temp_index)
							statements += "  " + c_type_name(
								core_expr_type(arg),
							) + " " + temp + " = " + arg_value + ";\n"
							values = values.append(temp)
							temp_index += 1
						else:
							values = values.append(arg_value)
					None:
						failed = True
						break

			index += 1

		if failed:
			None
		else:
			Some({
				statements = statements,
				args = values,
				cleanup_slots = args_body.cleanup_slots,
				next_temp = temp_index,
			})


private pure func emit_foreign_borrow_args_body(
	args: List[CoreExpr],
	args_body: CallArgsBody,
) -> Option[ForeignCallArgsBody]:
	var values: List[String] = []
	var failed: Bool = False
	var index: Int = 0

	for arg in args:
		if not failed:
			match args_body.args.get(index):
				Some(arg_value):
					values = values.append(foreign_borrow_arg_value(arg, arg_value))
				None:
					failed = True
					break

		index += 1

	if failed:
		None
	else:
		Some({
			statements = args_body.statements,
			args = values,
			release_statements = "",
			next_temp = args_body.next_temp,
		})


private pure func emit_foreign_default_args_body(
	args: List[CoreExpr],
	policies: List[CoreForeignDefaultArgPolicy],
	args_body: CallArgsBody,
) -> Option[ForeignCallArgsBody]:
	if policies.length() != args.length() or args_body.args.length() != args.length():
		None
	else:
		var statements: String = args_body.statements
		var values: List[String] = []
		var release_statements: String = ""
		var temp_index: Int = args_body.next_temp
		var failed: Bool = False
		var index: Int = 0

		for arg in args:
			if not failed:
				match args_body.args.get(index):
					Some(arg_value):
						match policies.get(index):
							Some(ForeignScalarByValue):
								values = values.append(arg_value)
							Some(ForeignDefensiveCopy(copy_kind)):
								copy_temp: String = temp_name(
									foreign_copy_temp_prefix(copy_kind),
									temp_index,
								)
								temp_index += 1
								statements += "  " + foreign_copy_c_type(
									copy_kind,
								) + " " + copy_temp + " = " + foreign_copy_fn(
									copy_kind,
								) + "(" + arg_value + ");\n"
								values = values.append(
									foreign_copy_call_arg_value(
										copy_kind,
										copy_temp,
									),
								)
								release_statements += "  blorp_release(" + copy_temp + ");\n"
							None:
								failed = True
								break
					None:
						failed = True
						break

			index += 1

		if failed:
			None
		else:
			Some({
				statements = statements,
				args = values,
				release_statements = release_statements,
				next_temp = temp_index,
			})


private pure func emit_foreign_call_args_body(
	arg_passing: CoreForeignArgPassing,
	args: List[CoreExpr],
	next_temp: Int,
) -> Option[ForeignCallArgsBody]:
	args_body ?= emit_call_args_body(args, next_temp)
	materialized_args ?= materialize_foreign_compact_scalar_field_args(args, args_body)

	match arg_passing:
		ForeignBorrowArgs:
			emit_foreign_borrow_args_body(args, materialized_args)
		ForeignDefaultArgs(policies):
			emit_foreign_default_args_body(args, policies, materialized_args)


private pure func emit_foreign_call_body(
	name: String,
	arg_passing: CoreForeignArgPassing,
	args: List[CoreExpr],
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	foreign_args ?= emit_foreign_call_args_body(arg_passing, args, next_temp)
	call_value: String = adapt_direct_call_result(
		direct_runtime_result_for_type(typ),
		name + "(" + foreign_args.args.join(", ") + ")",
	)

	if is_void_type(typ):
		Some({
			statements = foreign_args.statements + "  " + call_value + ";\n" + foreign_args.release_statements,
			value = "",
			next_temp = foreign_args.next_temp,
			returns = False,
		})
	else:
		result_temp: String = temp_name("ffi_result", foreign_args.next_temp)
		Some({
			statements = foreign_args.statements + "  " + c_type_name(
				typ,
			) + " " + result_temp + " = " + call_value + ";\n" + foreign_args.release_statements,
			value = result_temp,
			next_temp = foreign_args.next_temp + 1,
			returns = False,
		})


private pure func scoped_c_value(
	prefix: String,
	c_type: String,
	body: FunctionBodyC,
) -> FunctionBodyC:
	if body.statements == "":
		body
	else:
		result_name: String = temp_name(prefix, body.next_temp)
		{
			statements = "  " + c_type + " " + result_name + ";\n  {\n" + indent_statements(
				body.statements + "  " + result_name + " = " + body.value + ";\n",
			) + "  }\n",
			value = result_name,
			next_temp = body.next_temp + 1,
			returns = False
		}


private pure func scoped_body_value(
	prefix: String,
	typ: CoreType,
	body: FunctionBodyC,
) -> FunctionBodyC:
	scoped_c_value(prefix, c_type_name(typ), body)


private pure func emit_scoped_expr_value(
	prefix: String,
	expr: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	body ?= emit_function_body(expr, next_temp)

	if body.returns:
		None
	else if body.value == "":
		None
	else:
		Some(scoped_body_value(prefix, core_expr_type(expr), body))


private pure func stack_option_none_value_for_type(typ: CoreType) -> String:
	match typ:
		NamedType(name, args):
			if name == "Option":
				match args:
					[ValueRecordType(record_name)]:
						"{0}"
					[payload]:
						"0"
					[]:
						"0"
					[first, second, ...rest]:
						"0"
			else:
				"0"
		TypeParameterType(_) | SelfType:
			"0"
		VoidType:
			"0"
		StackResultType(ok_type, err_type):
			"0"
		BoxedResultType(ok_type, err_type):
			"0"
		FunctionType(is_pure, param_types, return_type):
			"0"
		EnumType(name):
			"0"
		ValueRecordType(name):
			"{0}"
		HeapRecordType(name):
			"0"
		UnionType(name):
			"0"
		RangeType:
			"0"
		TensorType(info):
			"0"
		TupleType(items):
			"0"


private pure func stack_option_none_expr_for_type(typ: CoreType) -> Option[String]:
	match typ:
		NamedType(name, args):
			if name == "Option":
				match args:
					[payload]:
						match stack_option_c_type(payload):
							Some(option_type):
								render_args: StackOptionNoneArgs = {
									option_type = option_type,
									tag = "0",
									none_value = stack_option_none_value_for_type(typ)
								}
								Some(render_prepared_constructor_op(StackOptionNone(render_args)))
							None:
								None
					[]:
						None
					[first, second, ...rest]:
						None
			else:
				None
		TypeParameterType(_) | SelfType:
			None
		VoidType:
			None
		StackResultType(ok_type, err_type):
			None
		BoxedResultType(ok_type, err_type):
			None
		FunctionType(is_pure, param_types, return_type):
			None
		EnumType(name):
			None
		ValueRecordType(name):
			None
		HeapRecordType(name):
			None
		UnionType(name):
			None
		RangeType:
			None
		TensorType(info):
			None
		TupleType(items):
			None


private pure func stack_option_scalar_get_args(
	dict: String,
	key: String,
	typ: CoreType,
) -> StackOptionScalarGetArgs:
	{
		dict = dict,
		key = key,
		temp_seed = DICT_GET_TEMP_SEED,
		option_c_type = c_type_name(typ),
		none_value = stack_option_none_value_for_type(typ)
	}


private pure func emit_dict_get_stack_option_payload(
	dict: String,
	key: String,
	result_type: CoreType,
	payload_type: CoreType,
) -> Option[String]:
	match payload_type:
		ValueRecordType(name):
			args: StackOptionValueRecordGetArgs = {
				dict = dict,
				key = key,
				temp_seed = DICT_GET_TEMP_SEED,
				option_c_type = c_type_name(result_type),
				payload_c_type = c_type_name(payload_type),
				none_value = stack_option_none_value_for_type(result_type)
			}
			Some(
				render_prepared_backend_op(
					BackendDictStackOptionValueRecordGet(
						args,
						DictKeepKey,
					),
				),
			)
		RangeType:
			args: StackOptionScalarGetArgs = stack_option_scalar_get_args(dict, key, result_type)
			Some(render_prepared_backend_op(BackendDictStackOptionLongGet(args, DictKeepKey)))
		EnumType(name):
			args: StackOptionScalarGetArgs = stack_option_scalar_get_args(dict, key, result_type)
			Some(render_prepared_backend_op(BackendDictStackOptionLongGet(args, DictKeepKey)))
		NamedType(name, type_args):
			if type_args.length() == 0 and name == "Int128":
				args: StackOptionScalarGetArgs = stack_option_scalar_get_args(
					dict,
					key,
					result_type,
				)
				Some(render_prepared_backend_op(BackendDictStackOptionInt128Get(args, DictKeepKey)))
			else if type_args.length() == 0 and name == "UInt128":
				args: StackOptionScalarGetArgs = stack_option_scalar_get_args(
					dict,
					key,
					result_type,
				)
				Some(
					render_prepared_backend_op(
						BackendDictStackOptionUInt128Get(
							args,
							DictKeepKey,
						),
					),
				)
			else if type_args.length() == 0 and (name == "Int" or name == "Bool" or name == "Char"):
				args: StackOptionScalarGetArgs = stack_option_scalar_get_args(
					dict,
					key,
					result_type,
				)
				Some(render_prepared_backend_op(BackendDictStackOptionLongGet(args, DictKeepKey)))
			else:
				None
		TypeParameterType(_) | SelfType:
			None
		VoidType:
			None
		StackResultType(ok_type, err_type):
			None
		BoxedResultType(ok_type, err_type):
			None
		FunctionType(is_pure, param_types, return_type):
			None
		HeapRecordType(name):
			None
		UnionType(name):
			None
		TensorType(info):
			None
		TupleType(items):
			None


private pure func emit_prepared_dict_builtin_call(
	name: String,
	args: List[String],
	typ: CoreType,
) -> Option[String]:
	if name == "blorp_dict_get":
		match args:
			[dict, key]:
				match typ:
					NamedType(type_name, type_args):
						if type_name == "Option":
							match type_args:
								[payload_type]:
									emit_dict_get_stack_option_payload(dict, key, typ, payload_type)
								[]:
									None
								[first, second, ...rest]:
									None
						else:
							None
					TypeParameterType(_) | SelfType:
						None
					VoidType:
						None
					StackResultType(ok_type, err_type):
						None
					BoxedResultType(ok_type, err_type):
						None
					FunctionType(is_pure, param_types, return_type):
						None
					EnumType(type_name):
						None
					ValueRecordType(type_name):
						None
					HeapRecordType(type_name):
						None
					UnionType(type_name):
						None
					RangeType:
						None
					TensorType(info):
						None
					TupleType(items):
						None
			[]:
				None
			[first]:
				None
			[first, second, third, ...rest]:
				None
	else:
		None


