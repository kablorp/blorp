		ForStreamExpr(for_stream, typ, loc):
			None
		ForTensorExpr(for_tensor, typ, loc):
			None
		PreClosureDetachExpr(detached, typ, loc):
			None
		DetachExpr(detached, typ, loc):
			None
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			None
		ConcurrentlyLoopExpr(loop, typ, loc):
			None
		PreClosureConcurrentExpr(block, typ, loc):
			None
		ConcurrentExpr(block, typ, loc):
			None
		SelectExpr(select_expr, typ, loc):
			None
		RangeExpr(start, end_value, typ, loc):
			None
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			None
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			None
		LiteralMatchExpr(scrutinee, cases, default_body, typ, loc):
			None
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, default_body, typ, loc):
			None
		IfExpr(cond, then_expr, else_expr, typ, loc):
			None


private pure func range_is_forward_proven(
	direction: CoreLoopRangeDirection,
	start: CoreExpr,
	end_value: CoreExpr,
) -> Bool:
	match direction:
		RangeMayRunBackward:
			match static_int_literal(start):
				Some(start_value):
					match static_int_literal(end_value):
						Some(end_int):
							start_value <= end_int
						None:
							False
				None:
					False
		RangeForwardOnly:
			True


private pure func emit_for_range(
	binder: CoreLoopBinder,
	start: CoreExpr,
	end_value: CoreExpr,
	body: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	start_c ?= emit_simple_expr(start)
	end_c ?= emit_simple_expr(end_value)
	body_c ?= emit_function_body(body, next_temp + 1)
	start_tmp: String = temp_name("range_start", next_temp)
	end_tmp: String = temp_name("range_end", next_temp)
	step_tmp: String = temp_name("range_step", next_temp)
	loop_type: String = c_type_name(binder.typ)
	prefix: String = "  " + loop_type + " " + start_tmp + " = " + start_c + ";\n  " + loop_type + " " + end_tmp + " = " + end_c + ";\n"

	if range_is_forward_proven(binder.range_direction, start, end_value):
		Some({
			statements = prefix + "  for (" + loop_type + " " + c_var_name(
				binder.variable,
			) + " = " + start_tmp + "; " + c_var_name(
				binder.variable,
			) + " < " + end_tmp + "; " + c_var_name(
				binder.variable,
			) + "++) {\n" + indent_statements(statement_body(body, body_c)) + "  }\n",
			value = "",
			next_temp = body_c.next_temp,
			returns = False,
		})
	else:
		Some({
			statements = prefix + "  " + loop_type + " " + step_tmp + " = (" + start_tmp + " <= " + end_tmp + ") ? 1 : -1;\n  for (" + loop_type + " " + c_var_name(
				binder.variable,
			) + " = " + start_tmp + "; " + c_var_name(
				binder.variable,
			) + " != " + end_tmp + "; " + c_var_name(
				binder.variable,
			) + " += " + step_tmp + ") {\n" + indent_statements(
				statement_body(
					body,
					body_c,
				),
			) + "  }\n",
			value = "",
			next_temp = body_c.next_temp,
			returns = False,
		})


private pure func pointer_list_loop_binding(
	binder: CoreLoopBinder,
	iter_tmp: String,
	index_tmp: String,
) -> Option[String]:
	value_c: String = "blorp_list_get(" + iter_tmp + ", " + index_tmp + ")"
	borrowed_erased_value_unbox_decl(binder, value_c)


private pure func inline_struct_list_loop_binding(
	binder: CoreLoopBinder,
	iter_tmp: String,
	index_tmp: String,
	temp_seed: String,
	c_type: String,
) -> String:
	binding_name: String = c_var_name(binder.variable)
	load_args: InlineStructLoadArgs = {
		list_tmp = iter_tmp,
		index_tmp = index_tmp,
		out_tmp = binding_name,
		temp_seed = temp_seed,
		struct_ty = c_type
	}

	c_type + " " + binding_name + ";\n" + render_prepared_list_op(
		InlineStructLoadProven(load_args),
	) + "\n"


private pure func inline_scalar_list_loop_binding(
	binder: CoreLoopBinder,
	iter_tmp: String,
	index_tmp: String,
	width_bytes: Int,
	next_temp: Int,
) -> Option[String]:
	binding_name: String = c_var_name(binder.variable)
	bits_tmp: String = temp_name("iter_bits", next_temp)
	load_args: InlineBitsLoadArgs = {
		list_tmp = iter_tmp,
		index_tmp = index_tmp,
		bits_tmp = bits_tmp,
		width_bytes = width_bytes.to_string()
	}
	value ?= boxed_storage_value_source("(void*)" + bits_tmp, binder.typ)

	Some(
		render_prepared_list_op(
			InlineBitsLoad(
				load_args,
			),
		) + "\n" + c_type_name(binder.typ) + " " + binding_name + " = " + value + ";\n",
	)


private pure func owned_erased_value_unbox_decl(
	binder: CoreLoopBinder,
	raw_value: String,
) -> Option[String]:
	binding_name: String = c_var_name(binder.variable)

	owned_erased_value_unbox_named_decl(binding_name, binder.typ, raw_value)


private pure func owned_erased_value_unbox_named_decl(
	binding_name: String,
	typ: CoreType,
	raw_value: String,
) -> Option[String]:
	if is_stack_result_type(typ):
		Some(
			c_type_name(
				typ,
			) + " " + binding_name + " = blorp_stack_result_from_boxed((blorp_Result*)" + raw_value + ");\n",
		)
	else:
		value ?= boxed_storage_value_source(raw_value, typ)
		Some(c_type_name(typ) + " " + binding_name + " = " + value + ";\n")


private pure func borrowed_erased_value_unbox_decl(
	binder: CoreLoopBinder,
	raw_value: String,
) -> Option[String]:
	binding_name: String = c_var_name(binder.variable)

	borrowed_erased_value_unbox_named_decl(binding_name, binder.typ, raw_value)


private pure func borrowed_erased_value_unbox_named_decl(
	binding_name: String,
	typ: CoreType,
	raw_value: String,
) -> Option[String]:
	if is_stack_result_type(typ):
		Some(
			c_type_name(
				typ,
			) + " " + binding_name + " = blorp_stack_result_borrow_from_boxed((const blorp_Result*)" + raw_value + ");\n",
		)
	else:
		value ?= boxed_storage_value_source(raw_value, typ)
		Some(c_type_name(typ) + " " + binding_name + " = " + value + ";\n")


private pure func concurrent_window_capacity(binding_count: Int, max_threads: Option[Int]) -> Int:
	if binding_count <= 0:
		1
	else:
		match max_threads:
			Some(limit):
				if limit <= 1:
					1
				else if limit < binding_count:
					limit
				else:
					binding_count
			None:
				binding_count


private pure func concurrent_window_name(base_temp: Int) -> String:
	"__conc_task_window_" + base_temp.to_string()


private pure func concurrent_window_cleanup_name(base_temp: Int) -> String:
	"__blorp_task_window_cleanup_" + base_temp.to_string()


private pure func concurrent_deadline_name(base_temp: Int) -> String:
	"__conc_deadline_" + base_temp.to_string()


private pure func concurrent_remaining_name(base_temp: Int, binding_index: Int) -> String:
	"__conc_rem_" + base_temp.to_string() + "_" + binding_index.to_string()


private pure func concurrent_task_function_name(base_temp: Int, binding_index: Int) -> String:
	"__conc_fn_" + base_temp.to_string() + "_" + binding_index.to_string()


private record ConcurrentTimeoutSetup {
	statements: String,
	deadline: Option[String],
	next_temp: Int
}


private pure func task_copy_capture_to_closure_capture(
	capture: CoreTaskCapture,
) -> Option[CoreClosureCapture]:
	kind: CoreTaskCaptureKind = capture.kind

	match kind:
		TaskCopyCapture:
			Some({
				name = capture.name,
				typ = capture.typ,
			})
		TaskMoveResourceItem:
			None
		TaskStructuredTaskBorrow:
			None


private pure func task_copy_captures_to_closure_captures(
	captures: List[CoreTaskCapture],
) -> Option[List[CoreClosureCapture]]:
	var result: List[CoreClosureCapture] = []
	var failed: Bool = False

	for capture in captures:
		if not failed:
			match task_copy_capture_to_closure_capture(capture):
				Some(closure_capture):
					result = result.append(closure_capture)
				None:
					failed = True
					break

	if failed:
		None
	else:
		Some(result)


private pure func task_as_copy_closure_create(task: CoreTaskClosure) -> Option[CoreClosureCreate]:
	captures ?= task_copy_captures_to_closure_captures(task.captures)

	Some({
		function_name = task.function_name,
		def_id = task.def_id,
		c_name = task.c_name,
		static_name = task.static_name,
		captures = captures,
	})


private pure func emit_copy_concurrent_task_closure(
	task: CoreTaskClosure,
	base_temp: Int,
	binding_index: Int,
) -> Option[String]:
	fn_name: String = concurrent_task_function_name(base_temp, binding_index)
	closure ?= task_as_copy_closure_create(task)
	closure_value ?= emit_closure_create(closure)

	Some("  blorp_Closure* " + fn_name + " = (blorp_Closure*)" + closure_value + ";\n")


private pure func task_capture_box_expr(capture: CoreTaskCapture) -> Option[String]:
	kind: CoreTaskCaptureKind = capture.kind

	match kind:
		TaskCopyCapture:
			closure_capture_box_expr({
				name = capture.name,
				typ = capture.typ,
			})
		TaskMoveResourceItem:
			Some("(void*)" + c_local_name(capture.name))
		TaskStructuredTaskBorrow:
			None


private pure func task_capture_needs_release(capture: CoreTaskCapture) -> Option[Bool]:
	kind: CoreTaskCaptureKind = capture.kind

	match kind:
		TaskCopyCapture:
			closure_capture_needs_release({
				name = capture.name,
				typ = capture.typ,
			})
		TaskMoveResourceItem:
			Some(boxed_value_needs_release_type(capture.typ))
		TaskStructuredTaskBorrow:
			None


private pure func task_capture_assignments(captures: List[CoreTaskCapture]) -> Option[String]:
	var result: String = ""
	var failed: Bool = False
	var index: Int = 0

	for capture in captures:
		if not failed:
			match task_capture_box_expr(capture):
				Some(boxed):
					result += " ((void**)__cl_new->env)[" + index.to_string() + "] = " + boxed + ";"
				None:
					failed = True
					break

		index += 1

	if failed:
		None
	else:
		Some(result)


private pure func task_capture_release_mask(captures: List[CoreTaskCapture]) -> Option[Int]:
	var mask: Int = 0
	var failed: Bool = False
	var index: Int = 0

	for capture in captures:
		if not failed:
			match task_capture_needs_release(capture):
				Some(needs_release):
					if needs_release:
						mask += int_power_of_two(index)
				None:
					failed = True
					break

		index += 1

	if failed:
		None
	else:
		Some(mask)


private pure func emit_task_closure_create(task: CoreTaskClosure) -> Option[String]:
	if task.captures.length() == 0:
		Some("((void*)&" + c_identifier(task.static_name) + ")")
	else:
		assignments ?= task_capture_assignments(task.captures)
		release_mask ?= task_capture_release_mask(task.captures)

		Some(
			"({ blorp_Closure* __cl_new = blorp_closure_new_inline((void*)" + c_identifier(
				task.c_name,
			) + ", " + task.captures
				.length()
				.to_string() + ");" + assignments + " __cl_new->env_release_mask = " + release_mask.to_string() + "UL; __cl_new; })",
		)


private pure func emit_resource_concurrent_task_closure(
	task: CoreTaskClosure,
	base_temp: Int,
) -> Option[String]:
	fn_name: String = concurrent_task_function_name(base_temp, 0)
	closure_value ?= emit_task_closure_create(task)

	Some("  blorp_Closure* " + fn_name + " = (blorp_Closure*)" + closure_value + ";\n")


private pure func emit_detach(task: CoreTaskClosure, next_temp: Int) -> Option[FunctionBodyC]:
	fn_name: String = concurrent_task_function_name(next_temp, 0)
	closure_statement ?= emit_copy_concurrent_task_closure(task, next_temp, 0)

	Some({
		statements = closure_statement + "  blorp_detach(" + fn_name + ");\n",
		value = "(void)0",
		next_temp = next_temp + 1,
		returns = False,
	})


private pure func emit_concurrent_spawn(
	binding: CoreConcurrentBinding,
	slot: Int,
	base_temp: Int,
	binding_index: Int,
	window_name: String,
) -> Option[String]:
	closure_statement ?= emit_copy_concurrent_task_closure(binding.task, base_temp, binding_index)

	spawn_helper: String = if boxed_value_needs_release_type(binding.task.return_type):
		"blorp_concurrent_task_window_spawn_owned_rc"
	else:
		"blorp_concurrent_task_window_spawn_owned"

	fn_name: String = concurrent_task_function_name(base_temp, binding_index)

	Some(
		closure_statement + "  " + spawn_helper + "(&" + window_name + ", " + slot.to_string() + ", " + fn_name + ", BLORP_CONCURRENT_TASK_FLUSH_PERIODIC);\n",
	)


private pure func concurrent_timeout_arg_statements(
	deadline: Option[String],
	base_temp: Int,
	binding_index: Int,
) -> String:
	match deadline:
		Some(deadline_name):
			remaining_name: String = concurrent_remaining_name(base_temp, binding_index)
			"  long " + remaining_name + " = blorp_concurrent_remaining_ms(" + deadline_name + ");\n"
		None:
			""


private pure func concurrent_timeout_arg(
	deadline: Option[String],
	base_temp: Int,
	binding_index: Int,
) -> String:
	match deadline:
		Some(deadline_name):
			concurrent_remaining_name(base_temp, binding_index)
		None:
			"-1"


private pure func emit_concurrent_join_binding(
	binding: CoreConcurrentBinding,
	slot: Int,
	base_temp: Int,
	binding_index: Int,
	window_name: String,
	deadline: Option[String],
) -> Option[String]:
	binding_name: String = c_var_name(binding.variable)
	join_call: String = "blorp_concurrent_task_window_join_release(&" + window_name + ", " + slot.to_string() + ", " + concurrent_timeout_arg(
		deadline,
		base_temp,
		binding_index,
	) + ")"
	binding_decl ?= owned_erased_value_unbox_named_decl(binding_name, binding.typ, join_call)

	Some(
		concurrent_timeout_arg_statements(
			deadline,
			base_temp,
			binding_index,
		) + "  " + binding_decl,
	)


private pure func emit_concurrent_chunk(
	chunk: List[CoreConcurrentBinding],
	start_index: Int,
	base_temp: Int,
	window_name: String,
	deadline: Option[String],
) -> Option[String]:
	var statements: String = ""
	var failed: Bool = False
	var slot: Int = 0

	for binding in chunk:
		if not failed:
			match emit_concurrent_spawn(binding, slot, base_temp, start_index + slot, window_name):
				Some(spawn):
					statements += spawn
				None:
					failed = True
					break

		slot += 1

	slot = 0

	for binding in chunk:
		if not failed:
			match emit_concurrent_join_binding(
				binding,
				slot,
				base_temp,
				start_index + slot,
				window_name,
				deadline,
			):
				Some(join_statement):
					statements += join_statement
				None:
					failed = True
					break

		slot += 1

	if failed:
		None
	else:
		Some(statements)


private pure func emit_concurrent_chunks(
	bindings: List[CoreConcurrentBinding],
	capacity: Int,
	base_temp: Int,
	window_name: String,
	deadline: Option[String],
) -> Option[String]:
	var statements: String = ""
	var chunk: List[CoreConcurrentBinding] = []
	var chunk_start: Int = 0
	var current_index: Int = 0
	var failed: Bool = False

	for binding in bindings:
		if not failed:
			chunk = chunk.append(binding)

			if chunk.length() == capacity:
				match emit_concurrent_chunk(chunk, chunk_start, base_temp, window_name, deadline):
					Some(chunk_statements):
						statements += chunk_statements
					None:
						failed = True
						break

				chunk = []
				chunk_start = current_index + 1

		current_index += 1

	if not failed and chunk.length() > 0:
		match emit_concurrent_chunk(chunk, chunk_start, base_temp, window_name, deadline):
			Some(chunk_statements):
				statements += chunk_statements
			None:
				failed = True

	if failed:
		None
	else:
		Some(statements)


private pure func emit_concurrent_timeout_setup(
	timeout: Option[CoreExpr],
	base_temp: Int,
	next_temp: Int,
) -> Option[ConcurrentTimeoutSetup]:
	match timeout:
		Some(timeout_expr):
			timeout_body ?= emit_function_body(timeout_expr, next_temp)

			if timeout_body.returns:
				None
			else:
				timeout_value ?= required_body_value(timeout_body)
				deadline_name: String = concurrent_deadline_name(base_temp)
				Some({
					statements = timeout_body.statements + "  long " + deadline_name + " = blorp_concurrent_deadline_us(" + timeout_value + ");\n",
					deadline = Some(deadline_name),
					next_temp = timeout_body.next_temp,
				})
		None:
			Some({
				statements = "",
				deadline = None,
				next_temp = next_temp,
			})


private pure func emit_concurrent_block(
	block: CoreConcurrentBlock,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	base_temp: Int = next_temp
	window_name: String = concurrent_window_name(base_temp)
	cleanup_name: String = concurrent_window_cleanup_name(base_temp)
	capacity: Int = concurrent_window_capacity(block.bindings.length(), block.max_threads)
	var statements: String = "  blorp_thread_pool_ensure_initialized();\n"
	statements += "  blorp_ConcurrentTaskWindow " + window_name + " = {0};\n"
	statements += "  blorp_CancelCleanupFrame " + cleanup_name + ";\n"
	statements += "  blorp_concurrent_task_window_begin(&" + window_name + ", &" + cleanup_name + ", " + capacity.to_string() + ");\n"
	var current_temp: Int = next_temp + 1
	timeout_setup ?= emit_concurrent_timeout_setup(block.timeout, base_temp, current_temp)
	statements += timeout_setup.statements
	current_temp = timeout_setup.next_temp

	chunks ?= emit_concurrent_chunks(
		block.bindings,
		capacity,
		base_temp,
		window_name,
		timeout_setup.deadline,
	)
	body_c ?= emit_function_body(block.body, current_temp)

	Some({
		statements = statements + chunks + "  blorp_concurrent_task_window_end(&" + window_name + ");\n" + body_c.statements,
		value = body_c.value,
		next_temp = body_c.next_temp,
		returns = body_c.returns,
	})


private pure func concurrently_loop_result_list_name(base_temp: Int) -> String:
	"__conc_results_" + base_temp.to_string()


private pure func emit_concurrently_loop_limit_setup(
	limit: CoreExpr,
	limit_name: String,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	limit_body ?= emit_function_body(limit, next_temp)
	limit_value ?= required_body_value(limit_body)

	Some({
		statements = limit_body.statements + "  long " + limit_name + " = blorp_concurrent_normalize_limit(" + limit_value + ");\n",
		value = "",
		next_temp = limit_body.next_temp,
		returns = False,
	})


private pure func emit_concurrently_loop_item_binding(
	loop: CoreConcurrentlyLoop,
	list_name: String,
	index_name: String,
) -> Option[String]:
	item_value ?= boxed_storage_value_source(
		"blorp_list_get(" + list_name + ", " + index_name + ")",
		loop.item_type,
	)

	Some(
		"  " + c_type_name(
			loop.item_type,
		) + " " + c_var_name(loop.variable) + " = " + item_value + ";\n",
	)


private pure func emit_concurrently_loop_spawn(
	loop: CoreConcurrentlyLoop,
	base_temp: Int,
	window_name: String,
	slot_name: String,
	index_name: String,
	list_name: String,
) -> Option[String]:
	item_binding ?= emit_concurrently_loop_item_binding(loop, list_name, index_name)
	closure_statement ?= emit_copy_concurrent_task_closure(loop.task, base_temp, 0)

	spawn_helper: String = if boxed_value_needs_release_type(loop.task.return_type):
		"blorp_concurrent_task_window_spawn_owned_rc"
	else:
		"blorp_concurrent_task_window_spawn_owned"

	fn_name: String = concurrent_task_function_name(base_temp, 0)

	Some(
		item_binding + closure_statement + "  " + spawn_helper + "(&" + window_name + ", " + slot_name + ", " + fn_name + ", BLORP_CONCURRENT_TASK_FLUSH_PERIODIC);\n",
	)


private pure func concurrently_loop_join_call(
	window_name: String,
	slot_name: String,
	timeout_arg: String,
) -> String:
	"blorp_concurrent_task_window_join_release(&" + window_name + ", " + slot_name + ", " + timeout_arg + ")"


private pure func emit_concurrently_loop_join(
	output: CoreConcurrentlyLoopOutput,
	window_name: String,
	slot_name: String,
	index_name: String,
	results_name: String,
	timeout_arg: String,
) -> String:
	join_call: String = concurrently_loop_join_call(window_name, slot_name, timeout_arg)

	match output:
		ConcurrentlyLoopCollect:
			"  blorp_list_set_raw(" + results_name + ", " + index_name + ", (void*)(" + join_call + "));\n  " + results_name + "->len = " + index_name + " + 1;\n"
		ConcurrentlyLoopDiscard:
			"  blorp_release((blorp_Object*)(" + join_call + "));\n"


private pure func emit_concurrently_copy_item_loop(
	loop: CoreConcurrentlyLoop,
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	base_temp: Int = next_temp
	limit_name: String = "__conc_limit_" + base_temp.to_string()
	list_name: String = "__conc_list_" + base_temp.to_string()
	len_name: String = "__conc_len_" + base_temp.to_string()
	window_name: String = concurrent_window_name(base_temp)
	window_cleanup_name: String = concurrent_window_cleanup_name(base_temp)
	start_name: String = "__conc_start_" + base_temp.to_string()
	window_end_name: String = "__conc_window_end_" + base_temp.to_string()
	index_name: String = "__conc_i_" + base_temp.to_string()
	slot_name: String = "__conc_slot_" + base_temp.to_string()
	results_name: String = concurrently_loop_result_list_name(base_temp)

	limit_setup ?= emit_concurrently_loop_limit_setup(loop.limit, limit_name, next_temp + 1)
	iterable_body ?= emit_function_body(loop.iterable, limit_setup.next_temp)
	iterable_value ?= required_body_value(iterable_body)
	timeout_setup ?= emit_concurrent_timeout_setup(loop.timeout, base_temp, iterable_body.next_temp)
	spawn_statement ?= emit_concurrently_loop_spawn(
		loop,
		base_temp,
		window_name,
		slot_name,
		index_name,
		list_name,
	)
	timeout_arg: String = concurrent_timeout_arg(timeout_setup.deadline, base_temp, 0)
	timeout_arg_statements: String = concurrent_timeout_arg_statements(
		timeout_setup.deadline,
		base_temp,
		0,
	)
	join_statement: String = emit_concurrently_loop_join(
		loop.output,
		window_name,
		slot_name,
		index_name,
		results_name,
		timeout_arg,
	)
	iterable_policy: CoreReleasePolicy = cleanup_release_policy_for_type(
		core_expr_type(loop.iterable),
	)
	iterable_transfers: Bool = expr_transfers_ownership(loop.iterable)

	iterable_cleanup_push: String = if iterable_transfers:
		owned_temp_cleanup_push_statement(list_name, iterable_policy)
	else:
		""

	iterable_cleanup_pop: String = if iterable_transfers:
		owned_temp_cleanup_pop_statement(list_name, iterable_policy)
	else:
		""

	iterable_release: String = if iterable_transfers:
		emit_release_statement(list_name, iterable_policy)
	else:
		""

	result_setup: String = match loop.output:
		ConcurrentlyLoopCollect:
			"  blorp_List* " + results_name + " = blorp_list_new(" + len_name + ");\n  blorp_list_init_elem_release(" + results_name + ", blorp_elem_release_fn);\n" + owned_temp_cleanup_push_statement(
				results_name,
				ArcReleasePolicy,
			)
		ConcurrentlyLoopDiscard:
			""

	result_finish: String = match loop.output:
		ConcurrentlyLoopCollect:
			"  " + results_name + "->len = " + len_name + ";\n" + owned_temp_cleanup_pop_statement(
				results_name,
				ArcReleasePolicy,
			)
		ConcurrentlyLoopDiscard:
			""

	result_value: String = match loop.output:
		ConcurrentlyLoopCollect:
			results_name
		ConcurrentlyLoopDiscard:
			""

	spawn_loop: String = "  for (long " + index_name + " = " + start_name + "; " + index_name + " < " + window_end_name + "; " + index_name + "++) {\n" + indent_statements(
		"  long " + slot_name + " = " + index_name + " - " + start_name + ";\n" + spawn_statement,
	) + "  }\n"
	join_loop: String = "  for (long " + index_name + " = " + start_name + "; " + index_name + " < " + window_end_name + "; " + index_name + "++) {\n" + indent_statements(
		"  long " + slot_name + " = " + index_name + " - " + start_name + ";\n" + timeout_arg_statements + join_statement,
	) + "  }\n"
	outer_loop: String = "  for (long " + start_name + " = 0; " + start_name + " < " + len_name + "; " + start_name + " += " + limit_name + ") {\n" + indent_statements(
		"  long " + window_end_name + " = " + start_name + " + " + limit_name + ";\n  if (" + window_end_name + " > " + len_name + ") " + window_end_name + " = " + len_name + ";\n" + spawn_loop + join_loop,
	) + "  }\n"

	Some({
		statements = limit_setup.statements + "  blorp_thread_pool_ensure_initialized();\n" + iterable_body.statements + "  blorp_List* " + list_name + " = (blorp_List*)" + iterable_value + ";\n" + iterable_cleanup_push + "  long " + len_name + " = " + list_name + "->len;\n  blorp_ConcurrentTaskWindow " + window_name + " = {0};\n  blorp_CancelCleanupFrame " + window_cleanup_name + ";\n  blorp_concurrent_task_window_begin(&" + window_name + ", &" + window_cleanup_name + ", " + limit_name + ");\n" + result_setup + timeout_setup.statements + outer_loop + "  blorp_concurrent_task_window_end(&" + window_name + ");\n" + result_finish + iterable_cleanup_pop + iterable_release,
		value = result_value,
		next_temp = timeout_setup.next_temp,
		returns = False,
	})


private pure func emit_concurrently_resource_source_spawn(
	loop: CoreConcurrentlyLoop,
	base_temp: Int,
	window_name: String,
	slot_name: String,
) -> Option[String]:
	closure_statement ?= emit_resource_concurrent_task_closure(loop.task, base_temp)

	spawn_helper: String = if boxed_value_needs_release_type(loop.task.return_type):
		"blorp_concurrent_task_window_spawn_owned_rc"
	else:
		"blorp_concurrent_task_window_spawn_owned"

	fn_name: String = concurrent_task_function_name(base_temp, 0)

	Some(
		closure_statement + "  " + spawn_helper + "(&" + window_name + ", " + slot_name + ", " + fn_name + ", BLORP_CONCURRENT_TASK_FLUSH_IMMEDIATE);\n",
	)


private pure func emit_concurrently_resource_source_loop(
	loop: CoreConcurrentlyLoop,
	move_item: CoreConcurrentlyLoopMoveResourceItem,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match loop.output:
		ConcurrentlyLoopCollect:
			None
		ConcurrentlyLoopDiscard:
			base_temp: Int = next_temp
			limit_name: String = "__conc_limit_" + base_temp.to_string()
			source_name: String = "__conc_resource_source_" + base_temp.to_string()
			raw_name: String = "__conc_resource_raw_" + base_temp.to_string()
			count_name: String = "__conc_count_" + base_temp.to_string()
			slot_name: String = "__conc_slot_" + base_temp.to_string()
			done_name: String = "__conc_source_done_" + base_temp.to_string()
			window_name: String = concurrent_window_name(base_temp)
			window_cleanup_name: String = concurrent_window_cleanup_name(base_temp)
			resource_type_name: String = c_type_name(move_item.resource_type)
			var_name: String = c_var_name(loop.variable)

			limit_setup ?= emit_concurrently_loop_limit_setup(loop.limit, limit_name, next_temp + 1)
			iterable_body ?= emit_function_body(loop.iterable, limit_setup.next_temp)
			iterable_value ?= required_body_value(iterable_body)
			timeout_setup ?= emit_concurrent_timeout_setup(
				loop.timeout,
				base_temp,
				iterable_body.next_temp,
			)
			timeout_arg: String = concurrent_timeout_arg(timeout_setup.deadline, base_temp, 0)
			timeout_arg_statements: String = concurrent_timeout_arg_statements(
				timeout_setup.deadline,
				base_temp,
				0,
			)
			spawn_statement ?= emit_concurrently_resource_source_spawn(
				loop,
				base_temp,
				window_name,
				slot_name,
			)
			join_statement: String = "  blorp_release((blorp_Object*)(" + concurrently_loop_join_call(
				window_name,
				slot_name,
				timeout_arg,
			) + "));\n"
			iterable_policy: CoreReleasePolicy = cleanup_release_policy_for_type(
				core_expr_type(loop.iterable),
			)
			iterable_transfers: Bool = expr_transfers_ownership(loop.iterable)

			iterable_cleanup_push: String = if iterable_transfers:
				owned_temp_cleanup_push_statement(source_name, iterable_policy)
			else:
				""

			iterable_cleanup_pop: String = if iterable_transfers:
				owned_temp_cleanup_pop_statement(source_name, iterable_policy)
			else:
				""

			iterable_release: String = if iterable_transfers:
				emit_release_statement(source_name, iterable_policy)
			else:
				""

			pull_loop: String = "  while (" + count_name + " < " + limit_name + ") {\n" + indent_statements(
				"  void* " + raw_name + " = NULL;\n  if (!blorp_resource_source_next_raw(" + source_name + ", &" + raw_name + ")) {\n" + indent_statements(
					"  " + done_name + " = true;\n  break;\n",
				) + "  }\n  " + resource_type_name + " " + var_name + " = (" + resource_type_name + ")" + raw_name + ";\n  " + raw_name + " = NULL;\n  long " + slot_name + " = " + count_name + ";\n" + spawn_statement + "  " + count_name + "++;\n",
			) + "  }\n"
			join_loop: String = "  for (long " + slot_name + " = 0; " + slot_name + " < " + count_name + "; " + slot_name + "++) {\n" + indent_statements(
				timeout_arg_statements + join_statement,
			) + "  }\n"
			outer_loop: String = "  while (!" + done_name + ") {\n" + indent_statements(
				"  long " + count_name + " = 0;\n" + pull_loop + join_loop,
			) + "  }\n"

			Some({
				statements = limit_setup.statements + "  blorp_thread_pool_ensure_initialized();\n" + iterable_body.statements + "  blorp_ResourceSource* " + source_name + " = " + iterable_value + ";\n" + iterable_cleanup_push + "  blorp_ConcurrentTaskWindow " + window_name + " = {0};\n  blorp_CancelCleanupFrame " + window_cleanup_name + ";\n  blorp_concurrent_task_window_begin(&" + window_name + ", &" + window_cleanup_name + ", " + limit_name + ");\n" + timeout_setup.statements + "  bool " + done_name + " = false;\n" + outer_loop + "  blorp_concurrent_task_window_end(&" + window_name + ");\n" + iterable_cleanup_pop + iterable_release,
				value = "",
				next_temp = timeout_setup.next_temp,
				returns = False,
			})


private pure func emit_concurrently_loop(
	loop: CoreConcurrentlyLoop,
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match loop.item_mode:
		ConcurrentlyLoopCopyItem:
			emit_concurrently_copy_item_loop(loop, typ, next_temp)
		ConcurrentlyLoopMoveResourceItem(move_item):
			emit_concurrently_resource_source_loop(loop, move_item, next_temp)


private pure func release_policy_requires_cleanup(policy: CoreReleasePolicy) -> Bool:
	match policy:
		NoReleasePolicy:
			False
		ArcReleasePolicy:
			True
		ArcReleaseOnlyPolicy:
			True
		StackResultReleasePolicy:
			True


private pure func render_select_backend_op(op: PreparedBackendOp) -> String:
	"  " + render_prepared_backend_op(op) + "\n"


private pure func select_ignored_value_name(select_index: Int, arm_index: Int) -> String:
	"__select_ignored_" + select_index.to_string() + "_" + arm_index.to_string()


private pure func select_cleanup_push_statement(
	frame_name: String,
	slot: String,
	policy: CoreReleasePolicy,
) -> String:
	match owned_temp_cleanup_release_fn(policy):
		Some(release_fn):
			value_arg: String = owned_temp_cleanup_value_arg(slot, policy)
			render_select_backend_op(
				BackendSelectCleanupFrameDecl(
					frame_name,
				),
			) + render_select_backend_op(BackendSelectCleanupPush({
				cleanup_frame = frame_name,
				value_slot = slot,
				cleanup_value = value_arg,
				release_fn = release_fn,
			}))
		None:
			""


private pure func select_cleanup_pop_statement(slot: String, policy: CoreReleasePolicy) -> String:
	if release_policy_requires_cleanup(policy):
		render_select_backend_op(BackendSelectCleanupPop(slot))
	else:
		""


private pure func emit_select_arm_setup(
	arms_name: String,
	arm_index: Int,
	kind: CoreSelectArmKind,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match kind:
		SelectRecvArm(recv):
			channel_body ?= emit_scoped_expr_value("select_channel", recv.channel, next_temp)
			channel_value ?= required_body_value(channel_body)
			Some({
				statements = channel_body.statements + render_select_backend_op(BackendSelectRecvArm({
					arms = arms_name,
					index = arm_index.to_string(),
					channel = channel_value,
				})),
				value = "",
				next_temp = channel_body.next_temp,
				returns = False,
			})
		SelectSealedArm(channel):
			channel_body ?= emit_scoped_expr_value("select_channel", channel, next_temp)
			channel_value ?= required_body_value(channel_body)
			Some({
				statements = channel_body.statements + render_select_backend_op(BackendSelectSealedArm({
					arms = arms_name,
					index = arm_index.to_string(),
					channel = channel_value,
				})),
				value = "",
				next_temp = channel_body.next_temp,
				returns = False,
			})
		SelectAfterArm(timeout):
			timeout_body ?= emit_scoped_expr_value("select_timeout", timeout, next_temp)
			timeout_value ?= required_body_value(timeout_body)
			Some({
				statements = timeout_body.statements + render_select_backend_op(BackendSelectAfterArm({
					arms = arms_name,
					index = arm_index.to_string(),
					timeout = timeout_value,
				})),
				value = "",
				next_temp = timeout_body.next_temp,
				returns = False,
			})


private pure func select_receive_binding_statement(
	recv: CoreSelectRecvArm,
	result_name: String,
	select_index: Int,
	arm_index: Int,
) -> Option[String]:
	binding_name: String = c_var_name(recv.binder)

	received_value: String = if recv.binder.name == "_":
		select_ignored_value_name(select_index, arm_index)
	else:
		binding_name

	if recv.binder.name != "_":
		owned_erased_value_unbox_named_decl(binding_name, recv.elem_type, result_name + ".value")
	else if is_stack_result_type(recv.elem_type):
		owned_erased_value_unbox_named_decl(received_value, recv.elem_type, result_name + ".value")
	else if release_policy_requires_cleanup(cleanup_release_policy_for_type(recv.elem_type)):
		Some(render_select_backend_op(BackendSelectReceivedValueBinding({
			binding = received_value,
			result = result_name,
		})))
	else:
		Some("")


private pure func select_received_value_name(
	recv: CoreSelectRecvArm,
	select_index: Int,
	arm_index: Int,
) -> String:
	if recv.binder.name == "_":
		select_ignored_value_name(select_index, arm_index)
	else:
		c_var_name(recv.binder)


private pure func emit_select_recv_branch_body(
	recv: CoreSelectRecvArm,
	arm_body: CoreExpr,
	result_name: String,
	select_index: Int,
	arm_index: Int,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	body_c ?= emit_function_body(arm_body, next_temp)
	binding_statement ?= select_receive_binding_statement(
		recv,
		result_name,
		select_index,
		arm_index,
	)
	policy: CoreReleasePolicy = cleanup_release_policy_for_type(recv.elem_type)
	received_value: String = select_received_value_name(recv, select_index, arm_index)
	frame_name: String = "__select_cleanup_" + select_index.to_string() + "_" + arm_index.to_string()

	release_value: String = if recv.binder.name == "_":
		received_value
	else:
		c_var_name(recv.binder)

	Some({
		statements = binding_statement + select_cleanup_push_statement(
			frame_name,
			received_value,
			policy,
		) + statement_body(
			arm_body,
			body_c,
		) + select_cleanup_pop_statement(
			received_value,
			policy,
		) + emit_release_statement(release_value, policy),
		value = "",
		next_temp = body_c.next_temp,
		returns = False,
	})


private pure func emit_select_branch_body(
	arm: CoreSelectArm,
	result_name: String,
	select_index: Int,
	arm_index: Int,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match arm.kind:
		SelectRecvArm(recv):
			emit_select_recv_branch_body(
				recv,
				arm.body,
				result_name,
				select_index,
				arm_index,
				next_temp,
			)
		SelectSealedArm(channel):
			body_c ?= emit_function_body(arm.body, next_temp)
			Some({
				statements = statement_body(arm.body, body_c),
				value = "",
				next_temp = body_c.next_temp,
				returns = False,
			})
		SelectAfterArm(timeout):
			body_c ?= emit_function_body(arm.body, next_temp)
			Some({
				statements = statement_body(arm.body, body_c),
				value = "",
				next_temp = body_c.next_temp,
				returns = False,
			})


private pure func emit_select_branch(
	arm: CoreSelectArm,
	result_name: String,
	select_index: Int,
	arm_index: Int,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	branch_body ?= emit_select_branch_body(arm, result_name, select_index, arm_index, next_temp)

	open_op: PreparedBackendOp = if arm_index == 0:
		BackendSelectFirstBranchOpen({
			result = result_name,
			index = arm_index.to_string(),
		})
	else:
		BackendSelectNextBranchOpen({
			result = result_name,
			index = arm_index.to_string(),
		})

	Some({
		statements = render_select_backend_op(
			open_op,
		) + indent_statements(branch_body.statements) + "  }\n",
		value = "",
		next_temp = branch_body.next_temp,
		returns = False,
	})


private pure func emit_select(
	select_expr: List[CoreSelectArm],
	next_temp: Int,
) -> Option[FunctionBodyC]:
	select_index: Int = next_temp
	arms_name: String = temp_name("select_arms", select_index)
	result_name: String = temp_name("select_result", select_index)
	var current_temp: Int = next_temp + 1
	var inner: String = render_select_backend_op(BackendSelectArmsDecl({
		arms = arms_name,
		arm_count = select_expr
			.length()
			.to_string(),
	}))
	var arm_index: Int = 0
	var failed: Bool = False

	for arm in select_expr:
		if not failed:
			match emit_select_arm_setup(arms_name, arm_index, arm.kind, current_temp):
				Some(setup):
					inner += setup.statements
					current_temp = setup.next_temp
					arm_index += 1
				None:
					failed = True
					break

	if failed:
		None
	else:
		inner += render_select_backend_op(BackendSelectWait({
			result = result_name,
			arms = arms_name,
			arm_count = select_expr
				.length()
				.to_string(),
		}))
		arm_index = 0

		for arm in select_expr:
			if not failed:
				match emit_select_branch(arm, result_name, select_index, arm_index, current_temp):
					Some(branch):
						inner += branch.statements
						current_temp = branch.next_temp
						arm_index += 1
					None:
						failed = True
						break

		if failed:
			None
		else:
			Some({
				statements = "  {\n" + indent_statements(inner) + "  }\n",
				value = "",
				next_temp = current_temp,
				returns = False,
			})


private pure func channel_loop_value_release(binder: CoreLoopBinder) -> String:
	binding_name: String = c_var_name(binder.variable)

	emit_release_statement(binding_name, cleanup_release_policy_for_type(binder.typ))


private pure func emit_for_channel(
	for_channel: CoreForChannel,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	iterable_body ?= emit_scoped_expr_value("channel_iterable", for_channel.iterable, next_temp)
	iterable_c ?= required_body_value(iterable_body)
	temp_index: Int = iterable_body.next_temp
	iter_tmp: String = temp_name("chan_iter", temp_index)
	raw_tmp: String = temp_name("chan_val", temp_index)
	body_c ?= emit_function_body(for_channel.body, temp_index + 1)
	loop_binding ?= owned_erased_value_unbox_decl(for_channel.binder, raw_tmp)
	loop_release: String = channel_loop_value_release(for_channel.binder)
	header: String = render_prepared_backend_op(BackendChannelIterHeader({
		channel = iter_tmp,
		source = iterable_c,
		value = raw_tmp,
	}))

	Some({
		statements = iterable_body.statements + indent_statements(
			header,
		) + indent_statements(
			loop_binding + statement_body(for_channel.body, body_c) + loop_release,
		) + "  }\n",
		value = "",
		next_temp = body_c.next_temp,
		returns = False,
	})


private pure func emit_for_list(for_list: CoreForList, next_temp: Int) -> Option[FunctionBodyC]:
	match for_list.layout:
		PointerListStorage:
			iterable_body ?= emit_scoped_expr_value("iterable", for_list.iterable, next_temp)
			iterable_c ?= required_body_value(iterable_body)
			temp_index: Int = iterable_body.next_temp
			iter_tmp: String = temp_name("iter", temp_index)
			len_tmp: String = temp_name("len", temp_index)
			index_tmp: String = temp_name("i", temp_index)
			body_c ?= emit_function_body(for_list.body, temp_index + 1)
			source_binding: String = render_prepared_backend_op(BackendFlatIterSourceBinding({
				iter_c_type = "blorp_List*",
				iter = iter_tmp,
				source = iterable_c,
			}))
			loop_header: String = render_prepared_backend_op(BackendFlatIterLoopHeader({
				length = len_tmp,
				iter = iter_tmp,
				index = index_tmp,
			}))
			loop_binding ?= pointer_list_loop_binding(for_list.binder, iter_tmp, index_tmp)
			loop_body: String = loop_binding + statement_body(for_list.body, body_c)
			cleanup_push: String = owned_temp_cleanup_push_statement(
				iter_tmp,
				for_list.iterable_release_policy,
			)
			cleanup_pop: String = owned_temp_cleanup_pop_statement(
				iter_tmp,
				for_list.iterable_release_policy,
			)
			iterable_release: String = emit_release_statement(
				iter_tmp,
				for_list.iterable_release_policy,
			)

			Some({
				statements = iterable_body.statements + indent_statements(
					source_binding + "\n" + cleanup_push + loop_header,
				) + indent_statements(loop_body) + "  }\n" + cleanup_pop + iterable_release,
				value = "",
				next_temp = body_c.next_temp,
				returns = False,
			})
		InlineListStorage(width_bytes):
			iterable_body ?= emit_scoped_expr_value("iterable", for_list.iterable, next_temp)
			iterable_c ?= required_body_value(iterable_body)
			temp_index: Int = iterable_body.next_temp
			iter_tmp: String = temp_name("iter", temp_index)
			len_tmp: String = temp_name("len", temp_index)
			index_tmp: String = temp_name("i", temp_index)
			body_c ?= emit_function_body(for_list.body, temp_index + 1)
			source_binding: String = render_prepared_backend_op(BackendFlatIterSourceBinding({
				iter_c_type = "blorp_List*",
				iter = iter_tmp,
				source = iterable_c,
			}))
			loop_header: String = render_prepared_backend_op(BackendFlatIterLoopHeader({
				length = len_tmp,
				iter = iter_tmp,
				index = index_tmp,
			}))
			loop_binding ?= inline_scalar_list_loop_binding(
				for_list.binder,
				iter_tmp,
				index_tmp,
				width_bytes,
				temp_index,
			)
			loop_body: String = loop_binding + statement_body(for_list.body, body_c)
			cleanup_push: String = owned_temp_cleanup_push_statement(
				iter_tmp,
				for_list.iterable_release_policy,
			)
			cleanup_pop: String = owned_temp_cleanup_pop_statement(
				iter_tmp,
				for_list.iterable_release_policy,
			)
			iterable_release: String = emit_release_statement(
				iter_tmp,
				for_list.iterable_release_policy,
			)

			Some({
				statements = iterable_body.statements + indent_statements(
					source_binding + "\n" + cleanup_push + loop_header,
				) + indent_statements(loop_body) + "  }\n" + cleanup_pop + iterable_release,
				value = "",
				next_temp = body_c.next_temp,
				returns = False,
			})
		InlineStructListStorage(c_type):
			iterable_body ?= emit_scoped_expr_value("iterable", for_list.iterable, next_temp)
			iterable_c ?= required_body_value(iterable_body)
			temp_index: Int = iterable_body.next_temp
			iter_tmp: String = temp_name("iter", temp_index)
			len_tmp: String = temp_name("len", temp_index)
			index_tmp: String = temp_name("i", temp_index)
			body_c ?= emit_function_body(for_list.body, temp_index + 1)
			source_binding: String = render_prepared_backend_op(BackendFlatIterSourceBinding({
				iter_c_type = "blorp_List*",
				iter = iter_tmp,
				source = iterable_c,
			}))
			loop_header: String = render_prepared_backend_op(BackendFlatIterLoopHeader({
				length = len_tmp,
				iter = iter_tmp,
				index = index_tmp,
			}))
			loop_body: String = inline_struct_list_loop_binding(
				for_list.binder,
				iter_tmp,
				index_tmp,
				temp_index.to_string(),
				c_type,
			) + statement_body(for_list.body, body_c)
			cleanup_push: String = owned_temp_cleanup_push_statement(
				iter_tmp,
				for_list.iterable_release_policy,
			)
			cleanup_pop: String = owned_temp_cleanup_pop_statement(
				iter_tmp,
				for_list.iterable_release_policy,
			)
			iterable_release: String = emit_release_statement(
				iter_tmp,
				for_list.iterable_release_policy,
			)

			Some({
				statements = iterable_body.statements + indent_statements(
					source_binding + "\n" + cleanup_push + loop_header,
				) + indent_statements(loop_body) + "  }\n" + cleanup_pop + iterable_release,
				value = "",
				next_temp = body_c.next_temp,
				returns = False,
			})


private pure func emit_for_string(
	for_string: CoreForString,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	iterable_body ?= emit_scoped_expr_value("string_iterable", for_string.iterable, next_temp)
	iterable_c ?= required_body_value(iterable_body)
	temp_index: Int = iterable_body.next_temp
	iter_tmp: String = temp_name("str_iter", temp_index)
	index_tmp: String = temp_name("si", temp_index)
	body_c ?= emit_function_body(for_string.body, temp_index + 1)
	source_binding: String = render_prepared_backend_op(BackendStringIterSourceBinding({
		iter = iter_tmp,
		source = iterable_c,
	}))
	loop_header: String = render_prepared_backend_op(BackendStringIterLoopOpen({
		index = index_tmp,
		iter = iter_tmp,
	}))
	loop_binding: String = render_prepared_backend_op(BackendStringIterCodepointBinding({
		binding = c_var_name(for_string.binder.variable),
		iter = iter_tmp,
		index = index_tmp,
	}))
	cleanup_push: String = owned_temp_cleanup_push_statement(
		iter_tmp,
		for_string.iterable_release_policy,
	)
	cleanup_pop: String = owned_temp_cleanup_pop_statement(
		iter_tmp,
		for_string.iterable_release_policy,
	)
	iterable_release: String = emit_release_statement(iter_tmp, for_string.iterable_release_policy)

	Some({
		statements = iterable_body.statements + indent_statements(
			source_binding + "\n" + cleanup_push + loop_header,
		) + indent_statements(
			loop_binding + "\n" + statement_body(
				for_string.body,
				body_c,
			),
		) + "  }\n" + cleanup_pop + iterable_release,
		value = "",
		next_temp = body_c.next_temp,
		returns = False,
	})


private pure func dict_loop_binding(
	for_dict: CoreForDict,
	iter_tmp: String,
	slot_tmp: String,
) -> Option[String]:
	binding_name: String = c_var_name(for_dict.binder.variable)

	match for_dict.binder.typ:
		TupleType(items):
			dict_tuple_loop_binding(binding_name, iter_tmp, slot_tmp, items)
		VoidType:
			None
		NamedType(name, args):
			Some(render_prepared_backend_op(BackendDictIterKeyBinding({
				key_c_type = c_type_name(for_dict.binder.typ),
				binding = binding_name,
				dict = iter_tmp,
				slot = slot_tmp,
			})) + "\n")
		TypeParameterType(_) | SelfType:
			None
		StackResultType(ok_type, err_type):
			None
		BoxedResultType(ok_type, err_type):
			None
		FunctionType(is_pure, param_types, return_type):
			None
		EnumType(name):
			Some(render_prepared_backend_op(BackendDictIterKeyBinding({
				key_c_type = c_type_name(for_dict.binder.typ),
				binding = binding_name,
				dict = iter_tmp,
				slot = slot_tmp,
			})) + "\n")
		ValueRecordType(name):
			Some(render_prepared_backend_op(BackendDictIterKeyBinding({
				key_c_type = c_type_name(for_dict.binder.typ),
				binding = binding_name,
				dict = iter_tmp,
				slot = slot_tmp,
			})) + "\n")
		HeapRecordType(name):
			Some(render_prepared_backend_op(BackendDictIterKeyBinding({
				key_c_type = c_type_name(for_dict.binder.typ),
				binding = binding_name,
				dict = iter_tmp,
				slot = slot_tmp,
			})) + "\n")
		UnionType(name):
			Some(render_prepared_backend_op(BackendDictIterKeyBinding({
				key_c_type = c_type_name(for_dict.binder.typ),
				binding = binding_name,
				dict = iter_tmp,
				slot = slot_tmp,
			})) + "\n")
		RangeType:
			Some(render_prepared_backend_op(BackendDictIterKeyBinding({
				key_c_type = c_type_name(for_dict.binder.typ),
				binding = binding_name,
				dict = iter_tmp,
				slot = slot_tmp,
			})) + "\n")
		TensorType(info):
			None


private pure func dict_tuple_loop_binding(
	binding_name: String,
	iter_tmp: String,
	slot_tmp: String,
	items: List[CoreType],
) -> Option[String]:
	match items:
		[]:
			None
		[first]:
			None
		[key_type, value_type]:
			Some(render_prepared_backend_op(BackendDictIterPairBinding({
				entry = binding_name,
				dict = iter_tmp,
				slot = slot_tmp,
			})) + "\n")
		[first, second, third, ...rest]:
			None


private pure func dict_loop_binding_release(for_dict: CoreForDict) -> String:
	if type_requires_release(for_dict.binder.typ):
		emit_release_statement(c_var_name(for_dict.binder.variable), ArcReleasePolicy)
	else:
		""


private pure func emit_for_dict(for_dict: CoreForDict, next_temp: Int) -> Option[FunctionBodyC]:
	iterable_body ?= emit_scoped_expr_value("dict_iterable", for_dict.iterable, next_temp)
	iterable_c ?= required_body_value(iterable_body)
	temp_index: Int = iterable_body.next_temp
	iter_tmp: String = temp_name("dict_iter", temp_index)
	index_tmp: String = temp_name("di", temp_index)
	slot_tmp: String = temp_name("dslot", temp_index)
	body_c ?= emit_function_body(for_dict.body, temp_index + 1)
	source_binding: String = render_prepared_backend_op(BackendDictIterSourceBinding({
		dict = iter_tmp,
		source = iterable_c,
	}))
	loop_header: String = render_prepared_backend_op(BackendDictIterLoopOpen({
		index = index_tmp,
		dict = iter_tmp,
	}))
	slot_binding: String = render_prepared_backend_op(BackendDictIterSlotBinding({
		slot = slot_tmp,
		dict = iter_tmp,
		index = index_tmp,
	}))
	deleted_slot_guard: String = render_prepared_backend_op(
		BackendDictIterDeletedSlotGuard(slot_tmp),
	)
	loop_binding ?= dict_loop_binding(for_dict, iter_tmp, slot_tmp)
	loop_release: String = dict_loop_binding_release(for_dict)
	cleanup_push: String = owned_temp_cleanup_push_statement(
		iter_tmp,
		for_dict.iterable_release_policy,
	)
	cleanup_pop: String = owned_temp_cleanup_pop_statement(
		iter_tmp,
		for_dict.iterable_release_policy,
	)
	iterable_release: String = emit_release_statement(iter_tmp, for_dict.iterable_release_policy)

	Some({
		statements = iterable_body.statements + indent_statements(
			source_binding + "\n" + cleanup_push + loop_header,
		) + indent_statements(
			slot_binding + "\n" + deleted_slot_guard + "\n" + loop_binding + statement_body(
				for_dict.body,
				body_c,
			) + loop_release,
		) + "  }\n" + cleanup_pop + iterable_release,
		value = "",
		next_temp = body_c.next_temp,
		returns = False,
	})


private pure func emit_for_set(for_set: CoreForSet, next_temp: Int) -> Option[FunctionBodyC]:
	iterable_body ?= emit_scoped_expr_value("set_iterable", for_set.iterable, next_temp)
	iterable_c ?= required_body_value(iterable_body)
	temp_index: Int = iterable_body.next_temp
	iter_tmp: String = temp_name("set_iter", temp_index)
	entry_tmp: String = temp_name("set_entry", temp_index)
	body_c ?= emit_function_body(for_set.body, temp_index + 1)
	source_binding: String = render_prepared_backend_op(BackendSetIterSourceBinding({
		set = iter_tmp,
		source = iterable_c,
	}))
	retain_iterable: String = render_prepared_backend_op(BackendSetIterRetain(iter_tmp))
	loop_header: String = render_prepared_backend_op(BackendSetIterLoopOpen({
		entry = entry_tmp,
		set = iter_tmp,
	}))
	raw_key: String = render_prepared_backend_op(BackendSetIterEntryKey(entry_tmp))
	loop_binding ?= borrowed_erased_value_unbox_decl(for_set.binder, raw_key)
	iter_retain_release: String = render_prepared_backend_op(BackendSetIterRelease(iter_tmp)) + "\n"
	cleanup_push: String = owned_temp_cleanup_push_statement(
		iter_tmp,
		for_set.iterable_release_policy,
	)
	cleanup_pop: String = owned_temp_cleanup_pop_statement(
		iter_tmp,
		for_set.iterable_release_policy,
	)
	iterable_release: String = emit_release_statement(iter_tmp, for_set.iterable_release_policy)

	Some({
		statements = iterable_body.statements + indent_statements(
			source_binding + "\n" + cleanup_push + retain_iterable + "\n" + loop_header,
		) + indent_statements(
			loop_binding + statement_body(
				for_set.body,
				body_c,
			),
		) + "  }\n" + indent_statements(iter_retain_release) + cleanup_pop + iterable_release,
		value = "",
		next_temp = body_c.next_temp,
		returns = False,
	})


private pure func stream_loop_binding(binder: CoreLoopBinder, value_tmp: String) -> Option[String]:
	value ?= boxed_storage_value_source(value_tmp, binder.typ)

	Some(c_type_name(binder.typ) + " " + c_var_name(binder.variable) + " = " + value + ";\n")


private pure func resource_source_loop_binding(binder: CoreLoopBinder, raw_tmp: String) -> String:
	binding_type: String = c_type_name(binder.typ)

	binding_type + " " + c_var_name(
		binder.variable,
	) + " = (" + binding_type + ")" + raw_tmp + ";\n" + raw_tmp + " = NULL;\n"


private pure func emit_for_resource_source(
	for_resource_source: CoreForResourceSource,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	iterable_body ?= emit_scoped_expr_value(
		"resource_source_iterable",
		for_resource_source.iterable,
		next_temp,
	)
	iterable_c ?= required_body_value(iterable_body)
	temp_index: Int = iterable_body.next_temp
	iter_tmp: String = temp_name("resource_source_iter", temp_index)
	raw_tmp: String = temp_name("resource_source_value", temp_index)
	body_c ?= emit_function_body(for_resource_source.body, temp_index + 1)
	loop_binding: String = resource_source_loop_binding(for_resource_source.binder, raw_tmp)
	cleanup_push: String = owned_temp_cleanup_push_statement(
		iter_tmp,
		for_resource_source.iterable_release_policy,
	)
	cleanup_pop: String = owned_temp_cleanup_pop_statement(
		iter_tmp,
		for_resource_source.iterable_release_policy,
	)
	iterable_release: String = emit_release_statement(
		iter_tmp,
		for_resource_source.iterable_release_policy,
	)

	Some({
		statements = iterable_body.statements + "  blorp_ResourceSource* " + iter_tmp + " = " + iterable_c + ";\n" + cleanup_push + "  void* " + raw_tmp + " = NULL;\n  while (blorp_resource_source_next_raw(" + iter_tmp + ", &" + raw_tmp + ")) {\n" + indent_statements(
			loop_binding + statement_body(
				for_resource_source.body,
				body_c,
			),
		) + "  }\n  " + raw_tmp + " = NULL;\n" + cleanup_pop + iterable_release,
		value = "",
		next_temp = body_c.next_temp,
		returns = False,
	})


private pure func emit_for_stream(
	for_stream: CoreForStream,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	iterable_body ?= emit_scoped_expr_value("stream_iterable", for_stream.iterable, next_temp)
	iterable_c ?= required_body_value(iterable_body)
	temp_index: Int = iterable_body.next_temp
	iter_tmp: String = temp_name("stream_iter", temp_index)
	value_tmp: String = temp_name("stream_value", temp_index)
	body_c ?= emit_function_body(for_stream.body, temp_index + 1)
	loop_binding ?= stream_loop_binding(for_stream.binder, value_tmp)
	cleanup_push: String = owned_temp_cleanup_push_statement(
		iter_tmp,
		for_stream.iterable_release_policy,
	)
	cleanup_pop: String = owned_temp_cleanup_pop_statement(
		iter_tmp,
		for_stream.iterable_release_policy,
	)
	iterable_release: String = emit_release_statement(iter_tmp, for_stream.iterable_release_policy)

	Some({
		statements = iterable_body.statements + "  blorp_Stream* " + iter_tmp + " = (blorp_Stream*)" + iterable_c + ";\n" + cleanup_push + "  void* " + value_tmp + " = NULL;\n  for (; blorp_stream_next_raw(" + iter_tmp + ", &" + value_tmp + "); blorp_stream_release_pulled_if_owned(" + iter_tmp + ", " + value_tmp + "), " + value_tmp + " = NULL) {\n" + indent_statements(
			loop_binding + statement_body(
				for_stream.body,
				body_c,
			),
		) + "  }\n  if (" + value_tmp + " != NULL) blorp_stream_release_pulled_if_owned(" + iter_tmp + ", " + value_tmp + ");\n" + cleanup_pop + iterable_release,
		value = "",
		next_temp = body_c.next_temp,
		returns = False,
	})


private pure func emit_for_tensor(
	for_tensor: CoreForTensor,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	iterable_c ?= emit_simple_expr(for_tensor.iterable)
	iter_tmp: String = temp_name("iter", next_temp)
	len_tmp: String = temp_name("len", next_temp)
	index_tmp: String = temp_name("i", next_temp)
	body_c ?= emit_function_body(for_tensor.body, next_temp + 1)
	source_binding: String = render_prepared_backend_op(BackendFlatIterSourceBinding({
		iter_c_type = "blorp_Vector*",
		iter = iter_tmp,
		source = iterable_c,
	}))
	loop_header: String = render_prepared_backend_op(BackendFlatIterLoopHeader({
		length = len_tmp,
		iter = iter_tmp,
		index = index_tmp,
	}))
	cleanup_push: String = owned_temp_cleanup_push_statement(
		iter_tmp,
		for_tensor.iterable_release_policy,
	)
	cleanup_pop: String = owned_temp_cleanup_pop_statement(
		iter_tmp,
		for_tensor.iterable_release_policy,
	)
	iterable_release: String = emit_release_statement(iter_tmp, for_tensor.iterable_release_policy)

	match for_tensor.element_storage:
		TensorForInlineStructElement(c_type):
			element_decl: String = render_prepared_tensor_op(InlineStructElementDecl({
				binding = c_var_name(for_tensor.binder.variable),
				tensor = iter_tmp,
				index = index_tmp,
				temp_seed = next_temp.to_string(),
				struct_ty = c_type,
			}))
			loop_body: String = element_decl + "\n" + statement_body(for_tensor.body, body_c)

			Some({
				statements = indent_statements(
					source_binding + "\n" + cleanup_push + loop_header,
				) + indent_statements(loop_body) + "  }\n" + cleanup_pop + iterable_release,
				value = "",
				next_temp = body_c.next_temp,
				returns = False,
			})
		TensorForRawScalarElement(raw_kind):
			raw_tmp: String = temp_name("iter_raw", next_temp)
			raw_binding: String = render_prepared_backend_op(BackendFlatIterRawDataBinding({
				pointer_c_type = tensor_raw_pointer_c_type(raw_kind),
				raw = raw_tmp,
				iter = iter_tmp,
			}))
			element_decl: String = render_prepared_backend_op(BackendFlatIterRawValueBinding({
				value_c_type = c_type_name(for_tensor.binder.typ),
				binding = c_var_name(for_tensor.binder.variable),
				raw = raw_tmp,
				index = index_tmp,
			}))
			loop_body: String = element_decl + "\n" + statement_body(for_tensor.body, body_c)

			Some({
				statements = indent_statements(
					source_binding + "\n" + cleanup_push + raw_binding + "\n" + loop_header,
				) + indent_statements(loop_body) + "  }\n" + cleanup_pop + iterable_release,
				value = "",
				next_temp = body_c.next_temp,
				returns = False,
			})
		TensorForRuntimeReadElement(runtime_read):
			element_decl: String = runtime_read.value_c_type + " " + c_var_name(
				for_tensor.binder.variable,
			) + " = (" + runtime_read.value_c_type + ")" + tensor_runtime_read_helper_name(
				runtime_read.helper,
			) + "(" + iter_tmp + ", " + index_tmp + ");"
			loop_body: String = element_decl + "\n" + statement_body(for_tensor.body, body_c)

			Some({
				statements = indent_statements(
					source_binding + "\n" + cleanup_push + loop_header,
				) + indent_statements(loop_body) + "  }\n" + cleanup_pop + iterable_release,
				value = "",
				next_temp = body_c.next_temp,
				returns = False,
			})
		TensorForBoxedElement(value_c_type):
			element_decl: String = value_c_type + " " + c_var_name(
				for_tensor.binder.variable,
			) + " = (" + value_c_type + ")" + iter_tmp + "->data[" + index_tmp + "];"
			loop_body: String = element_decl + "\n" + statement_body(for_tensor.body, body_c)

			Some({
				statements = indent_statements(
					source_binding + "\n" + cleanup_push + loop_header,
				) + indent_statements(loop_body) + "  }\n" + cleanup_pop + iterable_release,
				value = "",
				next_temp = body_c.next_temp,
				returns = False,
			})
		TensorForRowSliceElement(row_slice):
			binding_name: String = c_var_name(for_tensor.binder.variable)
			binding_type: String = c_type_name(for_tensor.binder.typ)
			derived_dim: String = "(" + iter_tmp + "->capacity / " + iter_tmp + "->len)"

			row_size: String = if row_slice.runtime_derived:
				derived_dim
			else:
				row_slice.row_size

			result_first_dim: String = if row_slice.runtime_derived:
				derived_dim
			else:
				row_slice.result_first_dim

			element_decl: String = binding_type + " " + binding_name + " = (" + binding_type + ")blorp_tensor_slice_row(" + iter_tmp + ", " + index_tmp + ", " + row_size + ", " + result_first_dim + ");"
			loop_body: String = element_decl + "\n" + statement_body(
				for_tensor.body,
				body_c,
			) + "blorp_release(" + binding_name + ");\n"

			Some({
				statements = indent_statements(
					source_binding + "\n" + cleanup_push + loop_header,
				) + indent_statements(loop_body) + "  }\n" + cleanup_pop + iterable_release,
				value = "",
				next_temp = body_c.next_temp,
				returns = False,
			})


private pure func tensor_runtime_read_helper_name(helper: CoreTensorRuntimeReadHelper) -> String:
	match helper:
		TensorRuntimeReadI64:
			"blorp_vector_read_i64"
		TensorRuntimeReadF64:
			"blorp_vector_read_f64"
		TensorRuntimeReadF32:
			"blorp_vector_read_f32"
		TensorRuntimeReadF16:
			"blorp_vector_read_f16"


private pure func core_expr_type(expr: CoreExpr) -> CoreType:
	match expr:
		RawMatchExpr(scrutinee, cases, typ, loc):
			typ
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			typ
		LiteralExpr(literal, typ, loc):
			typ
		VarExpr(variable, typ, loc):
			typ
		VoidExpr(typ, loc):
			typ
		DebugBlockExpr(body, typ, loc):
			typ
		CooperativeCheckpointExpr(typ, loc):
			typ
		CallExpr(kind, callee, args, typ, loc):
			typ
		BinaryExpr(op, left, right, typ, loc):
			typ
		UnaryExpr(op, expr_value, typ, loc):
			typ
		LogicalExpr(op, left, right, typ, loc):
			typ
		AssignExpr(variable, rhs, typ, loc):
			typ
		CastExpr(expr_value, typ, loc):
			typ
		BoxExpr(box, typ, loc):
			typ
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			typ
		FieldExpr(expr_value, field_name, typ, loc):
			typ
		TupleFieldExpr(expr_value, field_index, typ, loc):
			typ
		TupleExpr(items, typ, loc):
			typ
		TupleConstructExpr(tuple_construct, typ, loc):
			typ
		VectorExpr(items, typ, loc):
			typ
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			typ
		ClosureCreateExpr(closure, typ, loc):
			typ
		ListConstructExpr(construct, typ, loc):
			typ
		ListAllocExpr(alloc, typ, loc):
			typ
		ListGetExpr(get, typ, loc):
			typ
		ListHandoffExpr(handoff, typ, loc):
			typ
		ListHandoffSetOwnedExpr(set, typ, loc):
			typ
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			typ
		StringByteReadExpr(read, typ, loc):
			typ
		StringByteWriteExpr(write, typ, loc):
			typ
		StringByteCopyExpr(copy, typ, loc):
			typ
		StringSetLenExpr(set_len, typ, loc):
			typ
		TensorLiteralExpr(literal, typ, loc):
			typ
		TensorBoxedLiteralExpr(literal, typ, loc):
			typ
		TensorPackedLiteralExpr(literal, typ, loc):
			typ
		TensorRawFillExpr(fill, typ, loc):
			typ
		TensorRawReadExpr(read, typ, loc):
			typ
		TensorRawWriteExpr(write, typ, loc):
			typ
		TensorRawViewLetExpr(binding, body, typ, loc):
			typ
		DictExpr(entries, typ, loc):
			typ
		DictConstructExpr(construct, typ, loc):
			typ
		SetAllocExpr(alloc, typ, loc):
			typ
		ListRetainExpr(retain, typ, loc):
			typ
		ListSetExpr(set, typ, loc):
			typ
		ListSwapExpr(swap, typ, loc):
			typ
		RecordExpr(fields, typ, loc):
			typ
		RecordUpdateExpr(base, fields, typ, loc):
			typ
		RecordReuseExpr(source, fields, typ, loc):
			typ
		RecordConstructExpr(type_name, fields, typ, loc):
			typ
		UnionConstructExpr(construct, typ, loc):
			typ
		UnionReuseConstructExpr(construct, typ, loc):
			typ
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			typ
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			typ
		LetExpr(name, is_mutable, typ, rhs, body):
			core_expr_type(body)
		BorrowLetExpr(name, typ, rhs, body):
			core_expr_type(body)
		SeqExpr(first, second):
			core_expr_type(second)
		WhileExpr(cond, body, typ, loc):
			typ
		BreakExpr(typ, loc):
			typ
		ContinueExpr(typ, loc):
			typ
		ResourceScopeExpr(scope, typ, loc):
			typ
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			typ
		TailrecLoopExpr(params, return_type, body, loc):
			return_type
		TailrecRecurExpr(args, typ, loc):
			typ
		TailrecListSpreadLoopExpr(loop, loc):
			loop.return_type
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			typ
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			typ
		ForChannelExpr(for_channel, typ, loc):
			typ
		ForListExpr(for_list, typ, loc):
			typ
		ForStringExpr(for_string, typ, loc):
			typ
		ForDictExpr(for_dict, typ, loc):
			typ
		ForSetExpr(for_set, typ, loc):
			typ
		ForResourceSourceExpr(for_resource_source, typ, loc):
			typ
		ForStreamExpr(for_stream, typ, loc):
			typ
		ForTensorExpr(for_tensor, typ, loc):
			typ
		PreClosureDetachExpr(detached, typ, loc):
			typ
		DetachExpr(detached, typ, loc):
			typ
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			typ
		ConcurrentlyLoopExpr(loop, typ, loc):
			typ
		PreClosureConcurrentExpr(block, typ, loc):
			typ
		ConcurrentExpr(block, typ, loc):
			typ
		SelectExpr(select_expr, typ, loc):
			typ
		RangeExpr(start, end_value, typ, loc):
			typ
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			typ
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			typ
		LiteralMatchExpr(scrutinee, cases, default_body, typ, loc):
			typ
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, default_body, typ, loc):
			typ
		IfExpr(cond, then_expr, else_expr, typ, loc):
			typ


private pure func c_literal_match_test(scrutinee: String, literal: CoreLiteral) -> Option[String]:
	match literal:
		IntLiteral(value):
			Some(scrutinee + " == " + c_int_literal(value))
		WideIntLiteral(value):
			Some(scrutinee + " == " + c_wide_int_literal(value))
		FloatLiteral(value):
			Some(scrutinee + " == " + c_float_literal(value))
		FloatTextLiteral(value):
			Some(scrutinee + " == " + value)
		FloatInfinityLiteral:
			Some(scrutinee + " == INFINITY")
		FloatNegInfinityLiteral:
			Some(scrutinee + " == -INFINITY")
		FloatNanLiteral:
			Some("isnan(" + scrutinee + ")")
		BoolLiteral(value):
			if value:
				Some(scrutinee + " == 1")
			else:
				Some(scrutinee + " == 0")
		CharLiteral(value):
			Some(scrutinee + " == " + value.to_string())
		StringLiteral(value):
			Some(emit_string_literal_comparison(scrutinee, value) + " == 0")


private pure func emit_literal_match_branch_body(
	result_name: Option[String],
	body: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	body_c ?= emit_function_body(body, next_temp)

	match result_name:
		Some(name):
			value ?= required_body_value(body_c)
			Some({
				statements = body_c.statements + "  " + name + " = " + value + ";\n",
				value = "",
				next_temp = body_c.next_temp,
				returns = False,
			})
		None:
			Some({
				statements = statement_body(body, body_c),
				value = "",
				next_temp = body_c.next_temp,
				returns = False,
			})


private pure func emit_literal_match_case_body(
	binding_scrutinee_temp: String,
	result_name: Option[String],
	match_case: CoreLiteralMatchCase,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	bindings_c ?= emit_match_bindings(binding_scrutinee_temp, match_case.bindings)
	body_c ?= emit_literal_match_branch_body(result_name, match_case.body, next_temp)

	Some({
		statements = bindings_c + body_c.statements,
		value = body_c.value,
		next_temp = body_c.next_temp,
		returns = body_c.returns,
	})


private pure func emit_tailrec_literal_match_case_body(
	params: List[CoreParam],
	return_type: CoreType,
	binding_scrutinee_temp: String,
	match_case: CoreLiteralMatchCase,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	bindings_c ?= emit_match_bindings(binding_scrutinee_temp, match_case.bindings)
	body_c ?= emit_tailrec_tail(params, return_type, match_case.body, next_temp)

	Some(terminal_body(bindings_c + body_c.statements, body_c.next_temp))


private pure func emit_constructor_match_test(
	scrutinee_temp: String,
	accessor: CoreAccessor,
	test: CoreConstructorMatchTest,
) -> String:
	match test:
		EnumConstructorTest(c_name):
			scrutinee_temp + " == " + c_name
		UnionTagConstructorTest(tag_c_name, union_c_type):
			constructor_match_test_target(scrutinee_temp, test) + "->tag == " + tag_c_name
		NullableOptionSomeConstructorTest:
			scrutinee_temp + " != NULL"
		NullableOptionNoneConstructorTest:
			scrutinee_temp + " == NULL"
		StackOptionSomeConstructorTest(option_type):
			stack_option_match_source(
				scrutinee_temp,
				accessor,
				option_type,
			) + ".tag == BLORP_TAG_SOME"
		StackOptionNoneConstructorTest(option_type):
			stack_option_match_source(
				scrutinee_temp,
				accessor,
				option_type,
			) + ".tag == BLORP_TAG_NONE"
		StackResultOkConstructorTest(result_type):
			stack_result_match_source(
				scrutinee_temp,
				accessor,
				result_type,
			) + ".tag == BLORP_TAG_OK"
		StackResultErrConstructorTest(result_type):
			stack_result_match_source(
				scrutinee_temp,
				accessor,
				result_type,
			) + ".tag == BLORP_TAG_ERR"
		BoxedResultOkConstructorTest:
			scrutinee_temp + "->tag == BLORP_TAG_OK"
		BoxedResultErrConstructorTest:
			scrutinee_temp + "->tag == BLORP_TAG_ERR"
		BoolTrueConstructorTest:
			scrutinee_temp + " != 0"
		BoolFalseConstructorTest:
			scrutinee_temp + " == 0"


private pure func constructor_match_union_scrutinee_type(
	cases: List[CoreConstructorMatchCase],
) -> Option[String]:
	var result: Option[String] = None
	var has_non_root_union_test: Bool = False

	for match_case in cases:
		match match_case.test:
			UnionTagConstructorTest(tag_c_name, union_c_type):
				if accessors_equal(match_case.accessor, RootAccessor):
					match result:
						Some(c_type):
							void
						None:
							result = Some(union_c_type + "*")
				else:
					has_non_root_union_test = True
					break
			EnumConstructorTest(c_name):
				void
			NullableOptionSomeConstructorTest:
				void
			NullableOptionNoneConstructorTest:
				void
			StackOptionSomeConstructorTest(option_type):
				void
			StackOptionNoneConstructorTest(option_type):
				void
			StackResultOkConstructorTest(result_type):
				void
			StackResultErrConstructorTest(result_type):
				void
			BoxedResultOkConstructorTest:
				void
			BoxedResultErrConstructorTest:
				void
			BoolTrueConstructorTest:
				void
			BoolFalseConstructorTest:
				void

	if has_non_root_union_test:
		None
	else:
		result


private pure func constructor_match_scrutinee_c_type(
	scrutinee: CoreExpr,
	cases: List[CoreConstructorMatchCase],
) -> String:
	match constructor_match_union_scrutinee_type(cases):
		Some(c_type):
			c_type
		None:
			c_type_name(core_expr_type(scrutinee))


private pure func boxed_storage_value_source(raw_value: String, typ: CoreType) -> Option[String]:
	abi_value ?= closure_abi_value_for_type(typ)

	match abi_value:
		ClosureAbiVoid:
			Some("(void)0")
		ClosureAbiPointer:
			Some("((" + c_type_name(typ) + ")" + raw_value + ")")
		ClosureAbiPrim:
			Some("((" + c_type_name(typ) + ")(long)" + raw_value + ")")
		ClosureAbiFloat:
			Some("blorp_unbox_float(" + raw_value + ")")
		ClosureAbiFloat32:
			Some("blorp_unbox_float32(" + raw_value + ")")
		ClosureAbiFloat16:
			Some("blorp_unbox_float16(" + raw_value + ")")
		ClosureAbiInt128:
			Some("blorp_unbox_int128(" + raw_value + ")")
		ClosureAbiUInt128:
			Some("blorp_unbox_uint128(" + raw_value + ")")
		ClosureAbiStruct(c_type):
			Some(boxed_struct_value_source(c_type, raw_value))


private pure func boxed_struct_value_source(c_type: String, raw_value: String) -> String:
	"(*(" + c_type + "*)((char*)(" + raw_value + ") + sizeof(blorp_Object)))"


private pure func union_pointer_source(union_c_type: String, raw_value: String) -> String:
	"((" + union_c_type + "*)" + raw_value + ")"


private pure func emit_match_accessor(
	scrutinee_temp: String,
	accessor: CoreAccessor,
) -> Option[String]:
	match accessor:
		RootAccessor:
			Some(scrutinee_temp)
		VariantFieldAccessor(parent, union_c_type, constructor, field_index):
			parent_c ?= emit_match_accessor(scrutinee_temp, parent)
			Some(
				union_pointer_source(
					union_c_type,
					parent_c,
				) + "->data." + constructor + ".field" + field_index.to_string(),
			)
		ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index):
			parent_c ?= emit_match_accessor(scrutinee_temp, parent)
			Some(
				union_pointer_source(
					union_c_type,
					parent_c,
				) + "->data." + constructor + ".field" + field_index.to_string(),
			)
		NullableOptionPayloadAccessor(parent):
			emit_match_accessor(scrutinee_temp, parent)
		StackOptionPayloadAccessor(parent):
			parent_c ?= emit_match_accessor(scrutinee_temp, parent)
			Some(parent_c + ".value")
		StackResultOkPayloadAccessor(parent):
			parent_c ?= emit_match_accessor(scrutinee_temp, parent)
			Some(parent_c + ".data.Ok.field0")
		StackResultErrPayloadAccessor(parent):
			parent_c ?= emit_match_accessor(scrutinee_temp, parent)
			Some(parent_c + ".data.Err.field0")
		BoxedStackResultOkPayloadAccessor(parent, result_type):
			parent_c ?= emit_match_accessor(scrutinee_temp, parent)
			Some(boxed_struct_value_source(result_type, parent_c) + ".data.Ok.field0")
		BoxedStackResultErrPayloadAccessor(parent, result_type):
			parent_c ?= emit_match_accessor(scrutinee_temp, parent)
			Some(boxed_struct_value_source(result_type, parent_c) + ".data.Err.field0")
		BoxedResultOkPayloadAccessor(parent):
			parent_c ?= emit_match_accessor(scrutinee_temp, parent)
			Some(parent_c + "->data.Ok.field0")
		BoxedResultErrPayloadAccessor(parent):
			parent_c ?= emit_match_accessor(scrutinee_temp, parent)
			Some(parent_c + "->data.Err.field0")
		TupleFieldAccessor(parent, index, typ):
			parent_c ?= emit_match_accessor(scrutinee_temp, parent)
			raw_value: String = render_prepared_tuple_op(TupleFieldElement({
				tuple = parent_c,
				field = index.to_string(),
			}))
			boxed_storage_value_source(raw_value, typ)
		ListElementAccessor(parent, index):
			parent_c ?= emit_match_accessor(scrutinee_temp, parent)
			Some("blorp_list_get((blorp_List*)" + parent_c + ", " + index.to_string() + ")")
		ListSpreadAccessor(parent, offset):
			parent_c ?= emit_match_accessor(scrutinee_temp, parent)
			Some("blorp_list_drop((blorp_List*)" + parent_c + ", " + offset.to_string() + ")")


private pure func boxed_payload_binding_source(
	raw_payload: String,
	typ: CoreType,
) -> Option[String]:
	boxed_storage_value_source(raw_payload, typ)


private pure func match_accessor_value_source(
	raw_source: String,
	accessor: CoreAccessor,
	typ: CoreType,
) -> Option[String]:
	match accessor:
		StackResultOkPayloadAccessor(parent):
			boxed_payload_binding_source(raw_source, typ)
		StackResultErrPayloadAccessor(parent):
			boxed_payload_binding_source(raw_source, typ)
		BoxedStackResultOkPayloadAccessor(parent, result_type):
			boxed_payload_binding_source(raw_source, typ)
		BoxedStackResultErrPayloadAccessor(parent, result_type):
			boxed_payload_binding_source(raw_source, typ)
		BoxedResultOkPayloadAccessor(parent):
			boxed_payload_binding_source(raw_source, typ)
		BoxedResultErrPayloadAccessor(parent):
			boxed_payload_binding_source(raw_source, typ)
		ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index):
			boxed_payload_binding_source(raw_source, typ)
		ListElementAccessor(parent, index):
			boxed_payload_binding_source(raw_source, typ)
		ListSpreadAccessor(parent, offset):
			Some(raw_source)
		TupleFieldAccessor(parent, index, field_type):
			Some(raw_source)
		RootAccessor:
			Some(raw_source)
		VariantFieldAccessor(parent, union_c_type, constructor, field_index):
			Some(raw_source)
		NullableOptionPayloadAccessor(parent):
			Some(raw_source)
		StackOptionPayloadAccessor(parent):
			Some(raw_source)


private pure func match_binding_source(
	scrutinee_temp: String,
	binding: CoreMatchBinding,
) -> Option[String]:
	raw_source ?= emit_match_accessor(scrutinee_temp, binding.accessor)
	match_accessor_value_source(raw_source, binding.accessor, binding.typ)


private pure func emit_match_binding_declaration(
	binding: CoreMatchBinding,
	source_c: String,
) -> String:
	if is_void_type(binding.typ):
		"  " + source_c + ";\n"
	else:
		"  " + c_type_name(
			binding.typ,
		) + " " + c_var_name(binding.variable) + " = " + source_c + ";\n"


private pure func direct_owned_variant_field_index(accessor: CoreAccessor) -> Option[Int]:
	match accessor:
		VariantFieldAccessor(RootAccessor, union_c_type, constructor, field_index):
			Some(field_index)
		ErasedVariantFieldAccessor(RootAccessor, union_c_type, constructor, field_index):
			Some(field_index)
		RootAccessor:
			None
		VariantFieldAccessor(parent, union_c_type, constructor, field_index):
			None
		ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index):
			None
		NullableOptionPayloadAccessor(parent):
			None
		StackOptionPayloadAccessor(parent):
			None
		StackResultOkPayloadAccessor(parent):
			None
		StackResultErrPayloadAccessor(parent):
			None
		BoxedStackResultOkPayloadAccessor(parent, result_type):
			None
		BoxedStackResultErrPayloadAccessor(parent, result_type):
			None
		BoxedResultOkPayloadAccessor(parent):
			None
		BoxedResultErrPayloadAccessor(parent):
			None
		TupleFieldAccessor(parent, index, typ):
			None
		ListElementAccessor(parent, index):
			None
		ListSpreadAccessor(parent, offset):
			None


private pure func emit_owned_match_binding_statement(
	scrutinee_temp: String,
	unique_name: String,
	binding: CoreMatchBinding,
	source_c: String,
) -> Option[String]:
	decl: String = emit_match_binding_declaration(binding, source_c)

	if not type_requires_release(binding.typ):
		Some(decl)
	else:
		field_index ?= direct_owned_variant_field_index(binding.accessor)
		bit: String = "(1UL << " + field_index.to_string() + ")"
		binding_name: String = c_var_name(binding.variable)
		Some(
			decl + "  if (" + binding_name + ") { if (" + unique_name + " && ((" + scrutinee_temp + "->release_mask & " + bit + ") != 0UL)) { " + scrutinee_temp + "->release_mask &= ~" + bit + "; } else { blorp_retain(" + binding_name + "); } }\n",
		)


private pure func emit_match_binding(
	scrutinee_temp: String,
	binding: CoreMatchBinding,
) -> Option[String]:
	mode: CoreMatchBindingMode = binding.mode

	match mode:
		MatchBorrowBindingMode:
			source_c ?= match_binding_source(scrutinee_temp, binding)
			Some(emit_match_binding_declaration(binding, source_c))
		MatchOwnBindingMode:
			match binding.accessor:
				ListSpreadAccessor(parent, offset):
					source_c ?= match_binding_source(scrutinee_temp, binding)
					Some(emit_match_binding_declaration(binding, source_c))
				_:
					None


private pure func emit_match_bindings(
	scrutinee_temp: String,
	bindings: List[CoreMatchBinding],
) -> Option[String]:
	var statements: String = ""
	var failed: Bool = False

	for binding in bindings:
		if not failed:
			match emit_match_binding(scrutinee_temp, binding):
				Some(statement):
					statements += statement
				None:
					failed = True
					break

	if failed:
		None
	else:
		Some(statements)


private pure func accessors_equal(left: CoreAccessor, right: CoreAccessor) -> Bool:
	match left:
		RootAccessor:
			match right:
				RootAccessor:
					True
				VariantFieldAccessor(parent, union_c_type, constructor, field_index):
					False
				ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index):
					False
				NullableOptionPayloadAccessor(parent):
					False
				StackOptionPayloadAccessor(parent):
					False
				StackResultOkPayloadAccessor(parent):
					False
				StackResultErrPayloadAccessor(parent):
					False
				BoxedStackResultOkPayloadAccessor(parent, result_type):
					False
				BoxedStackResultErrPayloadAccessor(parent, result_type):
					False
				BoxedResultOkPayloadAccessor(parent):
					False
				BoxedResultErrPayloadAccessor(parent):
					False
				TupleFieldAccessor(parent, index, typ):
					False
				ListElementAccessor(parent, index):
					False
				ListSpreadAccessor(parent, offset):
					False
		VariantFieldAccessor(left_parent, left_union_c_type, left_constructor, left_field_index):
			match right:
				RootAccessor:
					False
				VariantFieldAccessor(right_parent, right_union_c_type, right_constructor, right_field_index):
					(
						accessors_equal(left_parent, right_parent)
						and left_union_c_type == right_union_c_type
						and left_constructor == right_constructor
						and left_field_index == right_field_index
					)
				ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index):
					False
				NullableOptionPayloadAccessor(parent):
					False
				StackOptionPayloadAccessor(parent):
					False
				StackResultOkPayloadAccessor(parent):
					False
				StackResultErrPayloadAccessor(parent):
					False
				BoxedStackResultOkPayloadAccessor(parent, result_type):
					False
				BoxedStackResultErrPayloadAccessor(parent, result_type):
					False
				BoxedResultOkPayloadAccessor(parent):
					False
				BoxedResultErrPayloadAccessor(parent):
					False
				TupleFieldAccessor(parent, index, typ):
					False
				ListElementAccessor(parent, index):
					False
				ListSpreadAccessor(parent, offset):
					False
		ErasedVariantFieldAccessor(left_parent, left_union_c_type, left_constructor, left_field_index):
			match right:
				RootAccessor:
					False
				VariantFieldAccessor(parent, union_c_type, constructor, field_index):
					False
				ErasedVariantFieldAccessor(right_parent, right_union_c_type, right_constructor, right_field_index):
					(
						accessors_equal(left_parent, right_parent)
						and left_union_c_type == right_union_c_type
						and left_constructor == right_constructor
						and left_field_index == right_field_index
					)
				NullableOptionPayloadAccessor(parent):
					False
				StackOptionPayloadAccessor(parent):
					False
				StackResultOkPayloadAccessor(parent):
					False
				StackResultErrPayloadAccessor(parent):
					False
				BoxedStackResultOkPayloadAccessor(parent, result_type):
					False
				BoxedStackResultErrPayloadAccessor(parent, result_type):
					False
				BoxedResultOkPayloadAccessor(parent):
					False
				BoxedResultErrPayloadAccessor(parent):
					False
				TupleFieldAccessor(parent, index, typ):
					False
				ListElementAccessor(parent, index):
					False
				ListSpreadAccessor(parent, offset):
					False
		NullableOptionPayloadAccessor(left_parent):
			match right:
				RootAccessor:
					False
				VariantFieldAccessor(parent, union_c_type, constructor, field_index):
					False
				ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index):
					False
				NullableOptionPayloadAccessor(right_parent):
					accessors_equal(left_parent, right_parent)
				StackOptionPayloadAccessor(parent):
					False
				StackResultOkPayloadAccessor(parent):
					False
				StackResultErrPayloadAccessor(parent):
					False
				BoxedStackResultOkPayloadAccessor(parent, result_type):
					False
				BoxedStackResultErrPayloadAccessor(parent, result_type):
					False
				BoxedResultOkPayloadAccessor(parent):
					False
				BoxedResultErrPayloadAccessor(parent):
					False
				TupleFieldAccessor(parent, index, typ):
					False
				ListElementAccessor(parent, index):
					False
				ListSpreadAccessor(parent, offset):
					False
		StackOptionPayloadAccessor(left_parent):
			match right:
				RootAccessor:
					False
				VariantFieldAccessor(parent, union_c_type, constructor, field_index):
					False
				ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index):
					False
				NullableOptionPayloadAccessor(parent):
					False
				StackOptionPayloadAccessor(right_parent):
					accessors_equal(left_parent, right_parent)
				StackResultOkPayloadAccessor(parent):
					False
				StackResultErrPayloadAccessor(parent):
					False
				BoxedStackResultOkPayloadAccessor(parent, result_type):
					False
				BoxedStackResultErrPayloadAccessor(parent, result_type):
					False
				BoxedResultOkPayloadAccessor(parent):
					False
				BoxedResultErrPayloadAccessor(parent):
					False
				TupleFieldAccessor(parent, index, typ):
					False
				ListElementAccessor(parent, index):
					False
				ListSpreadAccessor(parent, offset):
					False
		StackResultOkPayloadAccessor(left_parent):
			match right:
				RootAccessor:
					False
				VariantFieldAccessor(parent, union_c_type, constructor, field_index):
					False
				ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index):
					False
				NullableOptionPayloadAccessor(parent):
					False
				StackOptionPayloadAccessor(parent):
					False
				StackResultOkPayloadAccessor(right_parent):
					accessors_equal(left_parent, right_parent)
				StackResultErrPayloadAccessor(parent):
					False
				BoxedStackResultOkPayloadAccessor(parent, result_type):
					False
				BoxedStackResultErrPayloadAccessor(parent, result_type):
					False
				BoxedResultOkPayloadAccessor(parent):
					False
				BoxedResultErrPayloadAccessor(parent):
					False
				TupleFieldAccessor(parent, index, typ):
					False
				ListElementAccessor(parent, index):
					False
				ListSpreadAccessor(parent, offset):
					False
		StackResultErrPayloadAccessor(left_parent):
			match right:
				RootAccessor:
					False
				VariantFieldAccessor(parent, union_c_type, constructor, field_index):
					False
				ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index):
					False
				NullableOptionPayloadAccessor(parent):
					False
				StackOptionPayloadAccessor(parent):
					False
				StackResultOkPayloadAccessor(parent):
					False
				StackResultErrPayloadAccessor(right_parent):
					accessors_equal(left_parent, right_parent)
				BoxedStackResultOkPayloadAccessor(parent, result_type):
					False
				BoxedStackResultErrPayloadAccessor(parent, result_type):
					False
				BoxedResultOkPayloadAccessor(parent):
					False
				BoxedResultErrPayloadAccessor(parent):
					False
				TupleFieldAccessor(parent, index, typ):
					False
				ListElementAccessor(parent, index):
					False
				ListSpreadAccessor(parent, offset):
					False
		BoxedStackResultOkPayloadAccessor(left_parent, left_result_type):
			match right:
				RootAccessor:
					False
				VariantFieldAccessor(parent, union_c_type, constructor, field_index):
					False
				ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index):
					False
				NullableOptionPayloadAccessor(parent):
					False
				StackOptionPayloadAccessor(parent):
					False
				StackResultOkPayloadAccessor(parent):
					False
				StackResultErrPayloadAccessor(parent):
					False
				BoxedStackResultOkPayloadAccessor(right_parent, right_result_type):
					(
						accessors_equal(left_parent, right_parent)
						and left_result_type == right_result_type
					)
				BoxedStackResultErrPayloadAccessor(parent, result_type):
					False
				BoxedResultOkPayloadAccessor(parent):
					False
				BoxedResultErrPayloadAccessor(parent):
					False
				TupleFieldAccessor(parent, index, typ):
					False
				ListElementAccessor(parent, index):
					False
				ListSpreadAccessor(parent, offset):
					False
		BoxedStackResultErrPayloadAccessor(left_parent, left_result_type):
			match right:
				RootAccessor:
					False
				VariantFieldAccessor(parent, union_c_type, constructor, field_index):
					False
				ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index):
					False
				NullableOptionPayloadAccessor(parent):
					False
				StackOptionPayloadAccessor(parent):
					False
				StackResultOkPayloadAccessor(parent):
					False
				StackResultErrPayloadAccessor(parent):
					False
				BoxedStackResultOkPayloadAccessor(parent, result_type):
					False
				BoxedStackResultErrPayloadAccessor(right_parent, right_result_type):
					(
						accessors_equal(left_parent, right_parent)
						and left_result_type == right_result_type
					)
				BoxedResultOkPayloadAccessor(parent):
					False
				BoxedResultErrPayloadAccessor(parent):
					False
				TupleFieldAccessor(parent, index, typ):
					False
				ListElementAccessor(parent, index):
					False
				ListSpreadAccessor(parent, offset):
					False
		BoxedResultOkPayloadAccessor(left_parent):
			match right:
				RootAccessor:
					False
				VariantFieldAccessor(parent, union_c_type, constructor, field_index):
					False
				ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index):
					False
				NullableOptionPayloadAccessor(parent):
					False
				StackOptionPayloadAccessor(parent):
					False
				StackResultOkPayloadAccessor(parent):
					False
				StackResultErrPayloadAccessor(parent):
					False
				BoxedStackResultOkPayloadAccessor(parent, result_type):
					False
				BoxedStackResultErrPayloadAccessor(parent, result_type):
					False
				BoxedResultOkPayloadAccessor(right_parent):
					accessors_equal(left_parent, right_parent)
				BoxedResultErrPayloadAccessor(parent):
					False
				TupleFieldAccessor(parent, index, typ):
					False
				ListElementAccessor(parent, index):
					False
				ListSpreadAccessor(parent, offset):
					False
		BoxedResultErrPayloadAccessor(left_parent):
			match right:
				RootAccessor:
					False
				VariantFieldAccessor(parent, union_c_type, constructor, field_index):
					False
				ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index):
					False
				NullableOptionPayloadAccessor(parent):
					False
				StackOptionPayloadAccessor(parent):
					False
				StackResultOkPayloadAccessor(parent):
					False
				StackResultErrPayloadAccessor(parent):
					False
				BoxedStackResultOkPayloadAccessor(parent, result_type):
					False
				BoxedStackResultErrPayloadAccessor(parent, result_type):
					False
				BoxedResultOkPayloadAccessor(parent):
					False
				BoxedResultErrPayloadAccessor(right_parent):
					accessors_equal(left_parent, right_parent)
				TupleFieldAccessor(parent, index, typ):
					False
				ListElementAccessor(parent, index):
					False
				ListSpreadAccessor(parent, offset):
					False
		TupleFieldAccessor(left_parent, left_index, left_typ):
			match right:
				RootAccessor:
					False
				VariantFieldAccessor(parent, union_c_type, constructor, field_index):
					False
				ErasedVariantFieldAccessor(parent, union_c_type, constructor, field_index):
					False
				NullableOptionPayloadAccessor(parent):
					False
				StackOptionPayloadAccessor(parent):
					False
				StackResultOkPayloadAccessor(parent):
