private pure func emit_constructor_length_match_branch(
	outer_scrutinee_temp: String,
	result_name: Option[String],
	branch: CoreConstructorLengthMatchBranch,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	bindings_c ?= emit_match_bindings(outer_scrutinee_temp, branch.bindings)
	body_c ?= emit_constructor_match_body(outer_scrutinee_temp, result_name, branch.body, next_temp)

	Some({
		statements = bindings_c + body_c.statements,
		value = body_c.value,
		next_temp = body_c.next_temp,
		returns = body_c.returns,
	})


private pure func emit_constructor_length_match_fallback(
	match_root_value: String,
	result_name: Option[String],
	fallback: Option[CoreConstructorLengthMatchBranch],
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match fallback:
		Some(branch):
			emit_constructor_length_match_branch(match_root_value, result_name, branch, next_temp)
		None:
			Some(emit_literal_match_failure(next_temp))


private pure func emit_constructor_length_match_body_from_list_value(
	outer_scrutinee_temp: String,
	list_value: String,
	result_name: Option[String],
	match_expr: CoreConstructorLengthMatch,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	len_temp: String = temp_name("match_len", next_temp)
	var branch_next_temp: Int = next_temp + 1
	var branch_statements: String = ""
	var failed: Bool = False
	var has_case: Bool = False

	for match_case in match_expr.cases:
		if not failed:
			match emit_constructor_length_match_branch(
				outer_scrutinee_temp,
				result_name,
				match_case.branch,
				branch_next_temp,
			):
				Some(case_c):
					test: String = len_temp + " == " + match_case.length.to_string()

					if has_case:
						branch_statements += "  } else if (" + test + ") {\n"
					else:
						branch_statements += "  if (" + test + ") {\n"

					branch_statements += indent_statements(case_c.statements)
					branch_next_temp = case_c.next_temp
					has_case = True
				None:
					failed = True
					break

	match match_expr.geq:
		Some(geq_case):
			if not failed:
				match emit_constructor_length_match_branch(
					outer_scrutinee_temp,
					result_name,
					geq_case.branch,
					branch_next_temp,
				):
					Some(case_c):
						test: String = len_temp + " >= " + geq_case.minimum_length.to_string()

						if has_case:
							branch_statements += "  } else if (" + test + ") {\n"
						else:
							branch_statements += "  if (" + test + ") {\n"

						branch_statements += indent_statements(case_c.statements)
						branch_next_temp = case_c.next_temp
						has_case = True
					None:
						failed = True
		None:
			void

	if failed:
		None
	else:
		fallback_c ?= emit_constructor_length_match_fallback(
			outer_scrutinee_temp,
			result_name,
			match_expr.fallback,
			branch_next_temp,
		)
		prefix: String = "  long " + len_temp + " = ((blorp_List*)" + list_value + ")->len;\n"

		var match_statements: String = fallback_c.statements

		if has_case:
			match_statements = branch_statements + "  } else {\n" + indent_statements(
				fallback_c.statements,
			) + "  }\n"

		Some({
			statements = prefix + match_statements,
			value = "",
			next_temp = fallback_c.next_temp,
			returns = False,
		})


private pure func emit_constructor_length_match_body(
	outer_scrutinee_temp: String,
	result_name: Option[String],
	match_expr: CoreConstructorLengthMatch,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	list_value ?= emit_match_accessor(outer_scrutinee_temp, match_expr.accessor)
	emit_constructor_length_match_body_from_list_value(
		outer_scrutinee_temp,
		list_value,
		result_name,
		match_expr,
		next_temp,
	)


private pure func emit_constructor_case_length_match_body(
	outer_scrutinee_temp: String,
	result_name: Option[String],
	match_case: CoreConstructorMatchCase,
	match_expr: CoreConstructorLengthMatch,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	list_value ?= constructor_case_length_match_list_value(
		outer_scrutinee_temp,
		match_case,
		match_expr,
	)
	emit_constructor_length_match_body_from_list_value(
		outer_scrutinee_temp,
		list_value,
		result_name,
		match_expr,
		next_temp,
	)


private pure func list_payload_binding(binding: CoreMatchBinding) -> Option[CoreMatchBinding]:
	match binding.typ:
		NamedType(name, args):
			if name == "List" and args.length() == 1:
				Some(binding)
			else:
				None
		TypeParameterType(_) | SelfType:
			None
		VoidType:
			None
		StackResultType(ok_type, err_type):
			None
		BoxedResultType(ok_type, err_type):
			None
		FunctionType(is_pure, param_types, return_type):
			None
		EnumType(name):
			None
		ValueRecordType(name):
			None
		HeapRecordType(name):
			None
		UnionType(name):
			None
		RangeType:
			None
		TensorType(info):
			None
		TupleType(items):
			None


private pure func constructor_case_root_list_binding(
	match_case: CoreConstructorMatchCase,
) -> Option[CoreMatchBinding]:
	match match_case.bindings:
		[]:
			None
		[binding]:
			list_payload_binding(binding)
		[first, second]:
			None
		[first, second, third]:
			None
		[first, second, third, ...rest]:
			None


private pure func constructor_case_length_match_list_value(
	outer_scrutinee_temp: String,
	match_case: CoreConstructorMatchCase,
	match_expr: CoreConstructorLengthMatch,
) -> Option[String]:
	if accessors_equal(match_expr.accessor, RootAccessor):
		match constructor_case_root_list_binding(match_case):
			Some(binding):
				Some(c_var_name(binding.variable))
			None:
				emit_match_accessor_for_constructor_case(
					outer_scrutinee_temp,
					match_case.accessor,
					match_case.test,
					match_expr.accessor,
				)
	else:
		emit_match_accessor_for_constructor_case(
			outer_scrutinee_temp,
			match_case.accessor,
			match_case.test,
			match_expr.accessor,
		)


private pure func emit_constructor_match_body(
	outer_scrutinee_temp: String,
	result_name: Option[String],
	body: CoreConstructorMatchBody,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match body:
		ConstructorMatchBodyExpr(expr):
			emit_constructor_expr_match_body(outer_scrutinee_temp, result_name, expr, next_temp)
		ConstructorMatchBodyLiteral(match_expr):
			emit_constructor_literal_match_body(
				outer_scrutinee_temp,
				result_name,
				match_expr,
				next_temp,
			)
		ConstructorMatchBodyLength(match_expr):
			emit_constructor_length_match_body(
				outer_scrutinee_temp,
				result_name,
				match_expr,
				next_temp,
			)


private pure func emit_constructor_match_branch_body(
	scrutinee_temp: String,
	result_name: Option[String],
	match_case: CoreConstructorMatchCase,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	has_owned_binding: Bool = match_bindings_have_owned(match_case.bindings)

	owned_unique_name: Option[String] = if has_owned_binding:
		Some(temp_name("match_owned_unique", next_temp))
	else:
		None

	body_next_temp: Int = if has_owned_binding:
		next_temp + 1
	else:
		next_temp

	bindings_c ?= emit_constructor_case_match_bindings(
		scrutinee_temp,
		match_case,
		owned_unique_name,
	)

	body_c ?= match match_case.body:
		ConstructorMatchBodyExpr(expr):
			emit_constructor_expr_match_body(scrutinee_temp, result_name, expr, body_next_temp)
		ConstructorMatchBodyLiteral(match_expr):
			emit_constructor_case_literal_match_body(
				scrutinee_temp,
				result_name,
				match_case,
				match_expr,
				body_next_temp,
			)
		ConstructorMatchBodyLength(match_expr):
			emit_constructor_case_length_match_body(
				scrutinee_temp,
				result_name,
				match_case,
				match_expr,
				body_next_temp,
			)

	owned_unique_c: String = match owned_unique_name:
		Some(name):
			"  bool " + name + " = " + scrutinee_temp + " && blorp_is_unique(" + scrutinee_temp + ");\n"
		None:
			""

	Some({
		statements = owned_unique_c + bindings_c + body_c.statements,
		value = body_c.value,
		next_temp = body_c.next_temp,
		returns = body_c.returns,
	})


private pure func emit_literal_match_failure(next_temp: Int) -> FunctionBodyC:
	terminal_body("  fprintf(stderr, \"blorp: non-exhaustive match\\n\");\n  abort();\n", next_temp)


private pure func emit_literal_match_fallback(
	scrutinee_temp: String,
	result_name: Option[String],
	fallback: CoreLiteralMatchFallback,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match fallback:
		LiteralMatchFallbackBody(body):
			emit_literal_match_branch_body(result_name, body, next_temp)
		LiteralMatchFallbackBindings(bindings, body):
			bindings_c ?= emit_match_bindings(scrutinee_temp, bindings)
			body_c ?= emit_literal_match_branch_body(result_name, body, next_temp)
			Some({
				statements = bindings_c + body_c.statements,
				value = body_c.value,
				next_temp = body_c.next_temp,
				returns = body_c.returns,
			})
		LiteralMatchFallbackFail:
			Some(emit_literal_match_failure(next_temp))


private pure func emit_tailrec_literal_match_fallback(
	params: List[CoreParam],
	return_type: CoreType,
	scrutinee_temp: String,
	fallback: CoreLiteralMatchFallback,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match fallback:
		LiteralMatchFallbackBody(body):
			emit_tailrec_tail(params, return_type, body, next_temp)
		LiteralMatchFallbackBindings(bindings, body):
			bindings_c ?= emit_match_bindings(scrutinee_temp, bindings)
			body_c ?= emit_tailrec_tail(params, return_type, body, next_temp)
			Some(terminal_body(bindings_c + body_c.statements, body_c.next_temp))
		LiteralMatchFallbackFail:
			Some(emit_literal_match_failure(next_temp))


private pure func emit_literal_match_statement(
	prefix_statements: String,
	scrutinee_temp: String,
	scrutinee_value: String,
	scrutinee_type: CoreType,
	fallback_binding_scrutinee_temp: Option[String],
	result_name: Option[String],
	cases: List[CoreLiteralMatchCase],
	fallback: CoreLiteralMatchFallback,
	branch_next_temp_start: Int,
) -> Option[FunctionBodyC]:
	var branch_next_temp: Int = branch_next_temp_start
	var branch_statements: String = ""
	var failed: Bool = False
	var has_case: Bool = False

	binding_scrutinee_temp: String = match fallback_binding_scrutinee_temp:
		Some(name):
			name
		None:
			scrutinee_temp

	for match_case in cases:
		if not failed:
			match c_literal_match_test(scrutinee_temp, match_case.literal):
				Some(test):
					match emit_literal_match_case_body(
						binding_scrutinee_temp,
						result_name,
						match_case,
						branch_next_temp,
					):
						Some(case_c):
							if has_case:
								branch_statements += "  } else if (" + test + ") {\n"
							else:
								branch_statements += "  if (" + test + ") {\n"

							branch_statements += indent_statements(case_c.statements)
							branch_next_temp = case_c.next_temp
							has_case = True
						None:
							failed = True
							break
				None:
					failed = True
					break

	if failed:
		None
	else:
		fallback_c ?= emit_literal_match_fallback(
			binding_scrutinee_temp,
			result_name,
			fallback,
			branch_next_temp,
		)
		prefix: String = prefix_statements + "  " + c_type_name(
			scrutinee_type,
		) + " " + scrutinee_temp + " = " + scrutinee_value + ";\n"

		var match_statements: String = fallback_c.statements

		if has_case:
			match_statements = branch_statements + "  } else {\n" + indent_statements(
				fallback_c.statements,
			) + "  }\n"

		Some({
			statements = prefix + match_statements,
			value = "",
			next_temp = fallback_c.next_temp,
			returns = False,
		})


private pure func emit_tailrec_literal_match_statement(
	params: List[CoreParam],
	return_type: CoreType,
	prefix_statements: String,
	scrutinee_temp: String,
	scrutinee_value: String,
	scrutinee_type: CoreType,
	fallback_binding_scrutinee_temp: Option[String],
	cases: List[CoreLiteralMatchCase],
	fallback: CoreLiteralMatchFallback,
	branch_next_temp_start: Int,
) -> Option[FunctionBodyC]:
	var branch_next_temp: Int = branch_next_temp_start
	var branch_statements: String = ""
	var failed: Bool = False
	var has_case: Bool = False

	binding_scrutinee_temp: String = match fallback_binding_scrutinee_temp:
		Some(name):
			name
		None:
			scrutinee_temp

	for match_case in cases:
		if not failed:
			match c_literal_match_test(scrutinee_temp, match_case.literal):
				Some(test):
					match emit_tailrec_literal_match_case_body(
						params,
						return_type,
						binding_scrutinee_temp,
						match_case,
						branch_next_temp,
					):
						Some(case_c):
							if has_case:
								branch_statements += "  } else if (" + test + ") {\n"
							else:
								branch_statements += "  if (" + test + ") {\n"

							branch_statements += indent_statements(case_c.statements)
							branch_next_temp = case_c.next_temp
							has_case = True
						None:
							failed = True
							break
				None:
					failed = True
					break

	if failed:
		None
	else:
		fallback_c ?= emit_tailrec_literal_match_fallback(
			params,
			return_type,
			binding_scrutinee_temp,
			fallback,
			branch_next_temp,
		)
		prefix: String = prefix_statements + "  " + c_type_name(
			scrutinee_type,
		) + " " + scrutinee_temp + " = " + scrutinee_value + ";\n"

		var match_statements: String = fallback_c.statements

		if has_case:
			match_statements = branch_statements + "  } else {\n" + indent_statements(
				fallback_c.statements,
			) + "  }\n"

		Some(terminal_body(prefix + match_statements, fallback_c.next_temp))


private pure func emit_literal_match(
	scrutinee: CoreExpr,
	cases: List[CoreLiteralMatchCase],
	fallback: CoreLiteralMatchFallback,
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	scrutinee_c ?= emit_function_body(scrutinee, next_temp)
	scrutinee_value ?= required_body_value(scrutinee_c)
	scrutinee_temp: String = temp_name("match_scrut", scrutinee_c.next_temp)
	result_temp: String = temp_name("match_result", scrutinee_c.next_temp + 1)
	has_result: Bool = not is_void_type(typ)

	var branch_next_temp: Int = scrutinee_c.next_temp + 1
	var result_decl: String = ""
	var result_value: String = ""

	result_name: Option[String] = if has_result:
		branch_next_temp = scrutinee_c.next_temp + 2
		result_decl = "  " + c_type_name(typ) + " " + result_temp + ";\n"
		result_value = result_temp
		Some(result_temp)
	else:
		None

	match_c ?= emit_literal_match_statement(
		scrutinee_c.statements + result_decl,
		scrutinee_temp,
		scrutinee_value,
		core_expr_type(scrutinee),
		None,
		result_name,
		cases,
		fallback,
		branch_next_temp,
	)

	Some({
		statements = match_c.statements + owned_body_value_cleanup(
			scrutinee_c,
			core_expr_type(scrutinee),
		),
		value = result_value,
		next_temp = match_c.next_temp,
		returns = False,
	})


private pure func emit_tailrec_literal_match(
	params: List[CoreParam],
	return_type: CoreType,
	scrutinee: CoreExpr,
	cases: List[CoreLiteralMatchCase],
	fallback: CoreLiteralMatchFallback,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	scrutinee_c ?= emit_function_body(scrutinee, next_temp)
	scrutinee_value ?= required_body_value(scrutinee_c)
	scrutinee_temp: String = temp_name("match_scrut", scrutinee_c.next_temp)

	emit_tailrec_literal_match_statement(
		params,
		return_type,
		scrutinee_c.statements,
		scrutinee_temp,
		scrutinee_value,
		core_expr_type(scrutinee),
		None,
		cases,
		fallback,
		scrutinee_c.next_temp + 1,
	)


private pure func emit_accessor_literal_match(
	scrutinee: CoreExpr,
	scrutinee_release_policy: CoreReleasePolicy,
	match_expr: CoreConstructorLiteralMatch,
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	scrutinee_c ?= emit_function_body(scrutinee, next_temp)
	scrutinee_value ?= required_body_value(scrutinee_c)
	scrutinee_temp: String = temp_name("match_scrut", scrutinee_c.next_temp)
	result_temp: String = temp_name("match_result", scrutinee_c.next_temp + 1)
	has_result: Bool = not is_void_type(typ)

	var branch_next_temp: Int = scrutinee_c.next_temp + 1
	var result_decl: String = ""
	var result_value: String = ""

	result_name: Option[String] = if has_result:
		branch_next_temp = scrutinee_c.next_temp + 2
		result_decl = "  " + c_type_name(typ) + " " + result_temp + ";\n"
		result_value = result_temp
		Some(result_temp)
	else:
		None

	match_c ?= emit_constructor_literal_match_body(
		scrutinee_temp,
		result_name,
		match_expr,
		branch_next_temp,
	)
	prefix: String = scrutinee_c.statements + "  " + c_type_name(
		core_expr_type(
			scrutinee,
		),
	) + " " + scrutinee_temp + " = " + scrutinee_value + ";\n" + transferred_body_value_cleanup_pop(
		scrutinee_c,
		core_expr_type(
			scrutinee,
		),
	) + owned_temp_cleanup_push_statement(scrutinee_temp, scrutinee_release_policy) + result_decl

	Some({
		statements = prefix + match_c.statements + owned_temp_cleanup_pop_statement(
			scrutinee_temp,
			scrutinee_release_policy,
		) + emit_release_statement(
			scrutinee_temp,
			scrutinee_release_policy,
		) + transferred_body_value_release_after_match(
			scrutinee_c,
			core_expr_type(scrutinee),
			scrutinee_temp,
			scrutinee_release_policy,
		),
		value = result_value,
		next_temp = match_c.next_temp,
		returns = False,
	})


private pure func emit_length_match(
	scrutinee: CoreExpr,
	scrutinee_release_policy: CoreReleasePolicy,
	match_expr: CoreConstructorLengthMatch,
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	scrutinee_c ?= emit_function_body(scrutinee, next_temp)
	scrutinee_value ?= required_body_value(scrutinee_c)
	scrutinee_temp: String = temp_name("match_scrut", scrutinee_c.next_temp)
	result_temp: String = temp_name("match_result", scrutinee_c.next_temp + 1)
	has_result: Bool = not is_void_type(typ)

	var branch_next_temp: Int = scrutinee_c.next_temp + 1
	var result_decl: String = ""
	var result_value: String = ""

	result_name: Option[String] = if has_result:
		branch_next_temp = scrutinee_c.next_temp + 2
		result_decl = "  " + c_type_name(typ) + " " + result_temp + ";\n"
		result_value = result_temp
		Some(result_temp)
	else:
		None

	match_c ?= emit_constructor_length_match_body(
		scrutinee_temp,
		result_name,
		match_expr,
		branch_next_temp,
	)
	prefix: String = scrutinee_c.statements + "  " + c_type_name(
		core_expr_type(
			scrutinee,
		),
	) + " " + scrutinee_temp + " = " + scrutinee_value + ";\n" + transferred_body_value_cleanup_pop(
		scrutinee_c,
		core_expr_type(
			scrutinee,
		),
	) + owned_temp_cleanup_push_statement(scrutinee_temp, scrutinee_release_policy) + result_decl

	Some({
		statements = prefix + match_c.statements + owned_temp_cleanup_pop_statement(
			scrutinee_temp,
			scrutinee_release_policy,
		) + emit_release_statement(
			scrutinee_temp,
			scrutinee_release_policy,
		) + transferred_body_value_release_after_match(
			scrutinee_c,
			core_expr_type(scrutinee),
			scrutinee_temp,
			scrutinee_release_policy,
		),
		value = result_value,
		next_temp = match_c.next_temp,
		returns = False,
	})


private pure func emit_constructor_match_fallback(
	scrutinee_temp: String,
	result_name: Option[String],
	fallback: CoreConstructorMatchFallback,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match fallback:
		ConstructorMatchFallbackBody(body):
			emit_literal_match_branch_body(result_name, body, next_temp)
		ConstructorMatchFallbackBindings(bindings, body):
			bindings_c ?= emit_match_bindings(scrutinee_temp, bindings)
			body_c ?= emit_literal_match_branch_body(result_name, body, next_temp)
			Some({
				statements = bindings_c + body_c.statements,
				value = body_c.value,
				next_temp = body_c.next_temp,
				returns = body_c.returns,
			})
		ConstructorMatchFallbackFail:
			Some(emit_literal_match_failure(next_temp))


private pure func emit_constructor_match(
	scrutinee: CoreExpr,
	scrutinee_release_policy: CoreReleasePolicy,
	cases: List[CoreConstructorMatchCase],
	fallback: CoreConstructorMatchFallback,
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	scrutinee_c ?= emit_function_body(scrutinee, next_temp)
	scrutinee_value ?= required_body_value(scrutinee_c)
	scrutinee_temp: String = temp_name("match_scrut", scrutinee_c.next_temp)
	result_temp: String = temp_name("match_result", scrutinee_c.next_temp + 1)
	has_result: Bool = not is_void_type(typ)

	var branch_next_temp: Int = scrutinee_c.next_temp + 1

	if has_result:
		branch_next_temp = scrutinee_c.next_temp + 2

	result_name: Option[String] = if has_result:
		Some(result_temp)
	else:
		None

	var branch_statements: String = ""
	var failed: Bool = False
	var has_case: Bool = False

	for match_case in cases:
		if not failed:
			match emit_match_accessor(scrutinee_temp, match_case.accessor):
				Some(test_target):
					test: String = emit_constructor_match_test(
						test_target,
						match_case.accessor,
						match_case.test,
					)

					match emit_constructor_match_branch_body(
						scrutinee_temp,
						result_name,
						match_case,
						branch_next_temp,
					):
						Some(case_c):
							if has_case:
								branch_statements += "  } else if (" + test + ") {\n"
							else:
								branch_statements += "  if (" + test + ") {\n"

							branch_statements += indent_statements(case_c.statements)
							branch_next_temp = case_c.next_temp
							has_case = True
						None:
							failed = True
							break
				None:
					failed = True
					break

	if failed:
		None
	else:
		fallback_c ?= emit_constructor_match_fallback(
			scrutinee_temp,
			result_name,
			fallback,
			branch_next_temp,
		)
		scrutinee_type: String = constructor_match_scrutinee_c_type(scrutinee, cases)
		prefix: String = scrutinee_c.statements + "  " + scrutinee_type + " " + scrutinee_temp + " = " + scrutinee_value + ";\n" + transferred_body_value_cleanup_pop(
			scrutinee_c,
			core_expr_type(
				scrutinee,
			),
		) + owned_temp_cleanup_push_statement(scrutinee_temp, scrutinee_release_policy)
		var result_decl: String = ""

		if has_result:
			result_decl = "  " + c_type_name(typ) + " " + result_temp + ";\n"

		var match_statements: String = fallback_c.statements

		if has_case:
			match_statements = branch_statements + "  } else {\n" + indent_statements(
				fallback_c.statements,
			) + "  }\n"

		var result_value: String = ""

		if has_result:
			result_value = result_temp

		Some({
			statements = prefix + result_decl + match_statements + owned_temp_cleanup_pop_statement(
				scrutinee_temp,
				scrutinee_release_policy,
			) + emit_release_statement(
				scrutinee_temp,
				scrutinee_release_policy,
			) + transferred_body_value_release_after_match(
				scrutinee_c,
				core_expr_type(scrutinee),
				scrutinee_temp,
				scrutinee_release_policy,
			),
			value = result_value,
			next_temp = fallback_c.next_temp,
			returns = False,
		})


private pure func emit_resource_cleanups(
	cleanups: List[CoreExpr],
	next_temp: Int,
) -> Option[FunctionBodyC]:
	var statements: String = ""
	var current_temp: Int = next_temp
	var failed: Bool = False

	for cleanup in cleanups:
		if not failed:
			match resource_cleanup_hook(cleanup):
				Some(hook):
					statements += cancellation_cleanup_pop_statement(hook.variable)
				None:
					statements = statements

			match emit_function_body(cleanup, current_temp):
				Some(cleanup_c):
					statements += discard_expr_body(cleanup, cleanup_c)
					current_temp = cleanup_c.next_temp
				None:
					failed = True
					break

	if failed:
		None
	else:
		Some({
			statements = statements,
			value = "",
			next_temp = current_temp,
			returns = False,
		})


private pure func resource_exit_statement(exit: CoreResourceExit) -> String:
	match exit:
		ResourceBreakExit:
			"  break;\n"
		ResourceContinueExit:
			"  continue;\n"


private pure func emit_resource_cleanup_exit(
	cleanup_exit: CoreResourceCleanupExit,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	cleanups_c ?= emit_resource_cleanups(cleanup_exit.cleanups, next_temp)

	Some({
		statements = cleanups_c.statements + resource_exit_statement(cleanup_exit.exit),
		value = "",
		next_temp = cleanups_c.next_temp,
		returns = False,
	})


private pure func emit_resource_scope(
	scope: CoreResourceScope,
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	acquire_c ?= emit_simple_expr(scope.acquire)
	push_statement ?= resource_cleanup_push_statement(scope)
	resource_declaration: String = "  " + c_type_name(
		scope.typ,
	) + " " + c_var_name(scope.variable) + " = " + acquire_c + ";\n"
	pop_statement: String = cancellation_cleanup_pop_statement(scope.variable)

	if is_void_type(typ):
		body_c ?= emit_function_body(scope.body, next_temp)
		cleanup_c ?= emit_function_body(scope.cleanup, body_c.next_temp)
		inner: String = resource_declaration + push_statement + statement_body(
			scope.body,
			body_c,
		) + pop_statement + discard_expr_body(scope.cleanup, cleanup_c)

		Some({
			statements = "  {\n" + indent_statements(inner) + "  }\n",
			value = "",
			next_temp = cleanup_c.next_temp,
			returns = False,
		})
	else:
		result_name: String = temp_name("resource_result", next_temp)
		body_c ?= emit_function_body(scope.body, next_temp + 1)
		body_value ?= required_body_value(body_c)
		cleanup_c ?= emit_function_body(scope.cleanup, body_c.next_temp)
		inner: String = resource_declaration + push_statement + body_c.statements + "  " + result_name + " = " + body_value + ";\n" + pop_statement + discard_expr_body(
			scope.cleanup,
			cleanup_c,
		)

		Some({
			statements = "  " + c_type_name(
				typ,
			) + " " + result_name + ";\n  {\n" + indent_statements(inner) + "  }\n",
			value = result_name,
			next_temp = cleanup_c.next_temp,
			returns = False,
		})


private pure func emit_discarded_binding_body(
	rhs: CoreExpr,
	body: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	rhs_c ?= emit_function_body(rhs, next_temp)
	body_c ?= emit_function_body(body, rhs_c.next_temp)
	Some({
		statements = scoped_discard_expr_body(rhs, rhs_c) + body_c.statements,
		value = body_c.value,
		next_temp = body_c.next_temp,
		returns = body_c.returns,
	})


private pure func emit_bound_let_body(
	name: CoreVar,
	is_mutable: Bool,
	typ: CoreType,
	rhs: CoreExpr,
	rendered_rhs: String,
	body: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	body_c ?= emit_function_body(body, next_temp)
	cleanup_policy: CoreReleasePolicy = let_cleanup_policy(name, is_mutable, typ)
	tracks_cleanup: Bool = let_tracks_cleanup(cleanup_policy, body, name)

	cleanup_push: String = if tracks_cleanup:
		cancellation_cleanup_push_statement(name, cleanup_policy)
	else:
		""

	cleanup_pop: String = if tracks_cleanup:
		let_normal_cleanup_statement(name)
	else:
		""

	handoff_pop: String = handoff_source_cleanup_pop_statement(rhs)
	cleaned_body: FunctionBodyC = apply_let_cleanup_to_body(body, body_c, cleanup_pop)

	Some({
		statements = "  " + c_type_name(
			typ,
		) + " " + c_var_name(
			name,
		) + " = " + rendered_rhs + ";\n" + handoff_pop + cleanup_push + cleaned_body.statements,
		value = cleaned_body.value,
		next_temp = cleaned_body.next_temp,
		returns = cleaned_body.returns,
	})


private pure func emit_let_body(
	name: CoreVar,
	is_mutable: Bool,
	typ: CoreType,
	rhs: CoreExpr,
	body: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	if is_void_type(typ) or name.name == "_":
		emit_discarded_binding_body(rhs, body, next_temp)
	else:
		match emit_simple_expr(rhs):
			Some(rhs_c):
				emit_bound_let_body(name, is_mutable, typ, rhs, rhs_c, body, next_temp)
			None:
				rhs_body ?= emit_function_body(rhs, next_temp)
				rhs_value ?= required_body_value(rhs_body)
				emit_bound_let_body(
					name,
					is_mutable,
					typ,
					rhs,
					statement_expression(rhs_body.statements, rhs_value),
					body,
					rhs_body.next_temp,
				)


private pure func emit_bound_borrow_let_body(
	name: CoreVar,
	typ: CoreType,
	rendered_rhs: String,
	body: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	body_c ?= emit_function_body(body, next_temp)

	Some({
		statements = "  " + c_type_name(
			typ,
		) + " " + c_var_name(name) + " = " + rendered_rhs + ";\n" + body_c.statements,
		value = body_c.value,
		next_temp = body_c.next_temp,
		returns = body_c.returns,
	})


private pure func emit_borrow_let_body(
	name: CoreVar,
	typ: CoreType,
	rhs: CoreExpr,
	body: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	if is_void_type(typ) or name.name == "_":
		emit_discarded_binding_body(rhs, body, next_temp)
	else:
		match emit_simple_expr(rhs):
			Some(rhs_c):
				emit_bound_borrow_let_body(name, typ, rhs_c, body, next_temp)
			None:
				rhs_body ?= emit_function_body(rhs, next_temp)
				rhs_value ?= required_body_value(rhs_body)
				emit_bound_borrow_let_body(
					name,
					typ,
					statement_expression(rhs_body.statements, rhs_value),
					body,
					rhs_body.next_temp,
				)


private pure func emit_simple_or_call_body(
	expr: CoreExpr,
	kind: CoreCallKind,
	args: List[CoreExpr],
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match emit_simple_expr(expr):
		Some(value):
			Some(body_value(value, next_temp))
		None:
			emit_call_body(kind, args, typ, next_temp)


private pure func emit_dispatched_call_body(
	expr: CoreExpr,
	kind: CoreCallKind,
	args: List[CoreExpr],
	typ: CoreType,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match kind:
		OperationResultCall(bridge):
			emit_operation_result_bridge_body(bridge, args, typ, next_temp)
		FallibleStreamTerminalCall(bridge):
			emit_fallible_stream_terminal_bridge_body(bridge, args, typ, next_temp)
		UserCall(_, _, _):
			if call_transfer_cleanup_pop_statements(kind, args) == "":
				emit_simple_or_call_body(expr, kind, args, typ, next_temp)
			else:
				emit_call_body(kind, args, typ, next_temp)
		IntrinsicCall(name):
			if name == "list_retain_for" or call_transfer_cleanup_pop_statements(kind, args) != "":
				emit_call_body(kind, args, typ, next_temp)
			else:
				emit_simple_or_call_body(expr, kind, args, typ, next_temp)
		ForeignCall(_, _) | BuiltinCall(_) | DirectRuntimeCall(_) | TensorParallelCall(_, _) | DictWithCapacityCall(_) | ListToStringCall(_):
			emit_simple_or_call_body(expr, kind, args, typ, next_temp)
		ClosureCall:
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		UnknownCall | DeferredTraitCall(_, _) | SelectedTraitCall(_, _, _, _) | SelectedDirectCall(_):
			None


private pure func emit_while_body(
	cond: CoreExpr,
	body: CoreExpr,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	condition ?= emit_condition(cond, next_temp)
	body_c ?= emit_function_body(body, condition.next_temp)
	rendered_body: String = statement_body(body, body_c)

	if condition.statements == "":
		Some({
			statements = "  while (" + condition.value + ") {\n" + indent_statements(
				rendered_body,
			) + "  }\n",
			value = "",
			next_temp = body_c.next_temp,
			returns = False,
		})
	else:
		Some({
			statements = "  while (1) {\n" + indent_statements(
				condition.statements + "  if (!(" + condition.value + ")) {\n    break;\n  }\n" + rendered_body,
			) + "  }\n",
			value = "",
			next_temp = body_c.next_temp,
			returns = False,
		})


private pure func emit_if_body(
	cond: CoreExpr,
	then_expr: CoreExpr,
	else_expr: CoreExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
	next_temp: Int,
) -> Option[FunctionBodyC]:
	match emit_simple_expr(IfExpr(cond, then_expr, else_expr, typ, loc)):
		Some(value):
			Some(body_value(value, next_temp))
		None:
			condition ?= emit_condition(cond, next_temp)

			if is_void_type(typ):
				then_c ?= emit_function_body(then_expr, condition.next_temp)
				else_c ?= emit_function_body(else_expr, then_c.next_temp)
				else_statements: String = statement_body(else_expr, else_c)

				if else_statements == "":
					Some({
						statements = condition.statements + "  if (" + condition.value + ") {\n" + indent_statements(
							statement_body(
								then_expr,
								then_c,
							),
						) + "  }\n",
						value = "",
						next_temp = else_c.next_temp,
						returns = False,
					})
				else:
					Some({
						statements = condition.statements + "  if (" + condition.value + ") {\n" + indent_statements(
							statement_body(
								then_expr,
								then_c,
							),
						) + "  } else {\n" + indent_statements(else_statements) + "  }\n",
						value = "",
						next_temp = else_c.next_temp,
						returns = False,
					})
			else:
				temp: String = temp_name("if_result", condition.next_temp)
				then_c ?= emit_function_body(then_expr, condition.next_temp + 1)
				else_c ?= emit_function_body(else_expr, then_c.next_temp)
				then_value ?= required_body_value(then_c)
				else_value ?= required_body_value(else_c)
				Some({
					statements = "  " + c_type_name(
						typ,
					) + " " + temp + ";\n" + condition.statements + "  if (" + condition.value + ") {\n" + indent_statements(
						then_c.statements,
					) + "    " + temp + " = " + then_value + ";\n  } else {\n" + indent_statements(
						else_c.statements,
					) + "    " + temp + " = " + else_value + ";\n  }\n",
					value = temp,
					next_temp = else_c.next_temp,
					returns = False,
				})


private pure func emit_function_body(expr: CoreExpr, next_temp: Int) -> Option[FunctionBodyC]:
	match expr:
		RawMatchExpr(scrutinee, cases, typ, loc):
			None
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			None
		LetExpr(name, is_mutable, typ, rhs, body):
			emit_let_body(name, is_mutable, typ, rhs, body, next_temp)
		BorrowLetExpr(name, typ, rhs, body):
			emit_borrow_let_body(name, typ, rhs, body, next_temp)
		LiteralExpr(literal, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		VarExpr(variable, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		VoidExpr(typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		DebugBlockExpr(body, typ, loc):
			None
		CooperativeCheckpointExpr(typ, loc):
			Some({
				statements = "  blorp_cooperative_checkpoint();\n",
				value = "",
				next_temp = next_temp,
				returns = False,
			})
		CallExpr(kind, callee, args, typ, loc):
			emit_dispatched_call_body(expr, kind, args, typ, next_temp)
		BinaryExpr(op, left, right, typ, loc):
			match emit_simple_expr(expr):
				Some(value):
					Some(body_value(value, next_temp))
				None:
					emit_binary_body(op, left, right, typ, next_temp)
		UnaryExpr(op, expr_value, typ, loc):
			match emit_simple_expr(expr):
				Some(value):
					Some(body_value(value, next_temp))
				None:
					emit_unary_body(op, expr_value, typ, next_temp)
		LogicalExpr(op, left, right, typ, loc):
			match emit_simple_expr(expr):
				Some(value):
					Some(body_value(value, next_temp))
				None:
					emit_logical_body(op, left, right, next_temp)
		AssignExpr(variable, rhs, typ, loc):
			rhs_c ?= emit_function_body(rhs, next_temp)

			if variable.name == "_":
				Some({
					statements = consume_discard_expr_body(rhs, rhs_c),
					value = "",
					next_temp = rhs_c.next_temp,
					returns = False,
				})
			else:
				Some({
					statements = rhs_c.statements + "  " + c_var_name(
						variable,
					) + " = " + rhs_c.value + ";\n",
					value = "",
					next_temp = rhs_c.next_temp,
					returns = False,
				})
		CastExpr(expr_value, typ, loc):
			match emit_simple_expr(expr):
				Some(value):
					Some(body_value(value, next_temp))
				None:
					emit_cast_body(expr_value, typ, next_temp)
		BoxExpr(box, typ, loc):
			match emit_simple_expr(expr):
				Some(value):
					Some(body_value(value, next_temp))
				None:
					emit_boxed_pointer_body(
						{
							kind = box.kind,
							value = box.value,
							needs_release = boxed_value_needs_release_type(box.source_type),
							transfers_ownership = False
						},
						next_temp,
					)
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			match emit_simple_expr(expr):
				Some(value):
					Some(body_value(value, next_temp))
				None:
					emit_unbox_body(unbox_kind, expr_value, typ, next_temp)
		FieldExpr(expr_value, field_name, typ, loc):
			match emit_simple_expr(expr):
				Some(value):
					Some(body_value(value, next_temp))
				None:
					emit_field_access_body(expr_value, field_name, typ, next_temp)
		TupleFieldExpr(expr_value, field_index, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		TupleExpr(items, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		TupleConstructExpr(tuple_construct, typ, loc):
			match emit_simple_expr(expr):
				Some(value):
					Some(body_value(value, next_temp))
				None:
					emit_tuple_construct_body(tuple_construct, next_temp)
		VectorExpr(items, typ, loc):
			None
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			None
		ClosureCreateExpr(closure, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		ListConstructExpr(construct, typ, loc):
			match emit_simple_expr(expr):
				Some(value):
					Some(body_value(value, next_temp))
				None:
					emit_list_construct_body(construct, next_temp)
		ListAllocExpr(alloc, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		ListGetExpr(get, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		ListHandoffExpr(handoff, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		ListHandoffSetOwnedExpr(set, typ, loc):
			match emit_simple_expr(expr):
				Some(value):
					Some(body_value(value, next_temp))
				None:
					emit_list_handoff_set_owned_body(set, next_temp)
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		StringByteReadExpr(read, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		StringByteWriteExpr(write, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		StringByteCopyExpr(copy, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		StringSetLenExpr(set_len, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		TensorLiteralExpr(literal, typ, loc):
			emit_tensor_literal(literal, next_temp)
		TensorBoxedLiteralExpr(literal, typ, loc):
			emit_tensor_boxed_literal(literal, next_temp)
		TensorPackedLiteralExpr(literal, typ, loc):
			emit_tensor_packed_literal(literal, next_temp)
		TensorRawFillExpr(fill, typ, loc):
			emit_tensor_raw_fill(fill, next_temp)
		TensorRawReadExpr(read, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		TensorRawWriteExpr(write, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		TensorRawViewLetExpr(binding, body, typ, loc):
			decl ?= tensor_raw_view_decl(binding)
			body_c ?= emit_function_body(body, next_temp)
			Some({
				statements = "  " + decl + ";\n" + body_c.statements,
				value = body_c.value,
				next_temp = body_c.next_temp,
				returns = body_c.returns,
			})
		DictConstructExpr(construct, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		DictExpr(entries, typ, loc):
			None
		SetAllocExpr(alloc, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		ListRetainExpr(retain, typ, loc):
			emit_list_retain_body(retain, next_temp)
		ListSetExpr(set, typ, loc):
			match emit_simple_expr(expr):
				Some(value):
					Some(body_value(value, next_temp))
				None:
					emit_list_set_body(set, next_temp)
		ListSwapExpr(swap, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		RecordExpr(fields, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		RecordUpdateExpr(base, fields, typ, loc):
			None
		RecordReuseExpr(source, fields, typ, loc):
			emit_record_reuse_body(source, fields, typ, next_temp)
		RecordConstructExpr(type_name, fields, typ, loc):
			match emit_simple_expr(expr):
				Some(value):
					Some(body_value(value, next_temp))
				None:
					emit_record_construct_body(type_name, fields, typ, next_temp)
		UnionConstructExpr(construct, typ, loc):
			match emit_simple_expr(expr):
				Some(value):
					Some(body_value(value, next_temp))
				None:
					emit_union_construct_body(construct, next_temp)
		UnionReuseConstructExpr(construct, typ, loc):
			match emit_simple_expr(expr):
				Some(value):
					Some(body_value(value, next_temp))
				None:
					emit_union_reuse_construct_body(construct, next_temp)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			retain_statement: String = emit_dup_statement(variable, retain_policy)
			body_c ?= emit_function_body(body, next_temp)
			Some({
				statements = retain_statement + body_c.statements,
				value = body_c.value,
				next_temp = body_c.next_temp,
				returns = body_c.returns,
			})
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			drop_statement: String = emit_drop_statement(variable, release_policy)
			body_c ?= emit_function_body(body, next_temp)
			Some({
				statements = drop_statement + body_c.statements,
				value = body_c.value,
				next_temp = body_c.next_temp,
				returns = body_c.returns,
			})
		SeqExpr(first, second):
			first_c ?= emit_function_body(first, next_temp)
			second_c ?= emit_function_body(second, first_c.next_temp)
			Some({
				statements = scoped_discard_expr_body(first, first_c) + second_c.statements,
				value = second_c.value,
				next_temp = second_c.next_temp,
				returns = second_c.returns,
			})
		WhileExpr(cond, body, typ, loc):
			emit_while_body(cond, body, next_temp)
		BreakExpr(typ, loc):
			Some({
				statements = "  break;\n",
				value = "",
				next_temp = next_temp,
				returns = False,
			})
		ContinueExpr(typ, loc):
			Some({
				statements = "  continue;\n",
				value = "",
				next_temp = next_temp,
				returns = False,
			})
		ResourceScopeExpr(scope, typ, loc):
			emit_resource_scope(scope, typ, next_temp)
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			emit_resource_cleanup_exit(cleanup_exit, next_temp)
		TailrecLoopExpr(params, return_type, body, loc):
			emit_tailrec_loop(params, return_type, body, next_temp)
		TailrecRecurExpr(args, typ, loc):
			None
		TailrecListSpreadLoopExpr(loop, loc):
			emit_tailrec_list_spread_loop(loop, next_temp)
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			None
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			emit_for_range(binder, start, end_value, body, next_temp)
		ForChannelExpr(for_channel, typ, loc):
			emit_for_channel(for_channel, next_temp)
		ForListExpr(for_list, typ, loc):
			emit_for_list(for_list, next_temp)
		ForStringExpr(for_string, typ, loc):
			emit_for_string(for_string, next_temp)
		ForDictExpr(for_dict, typ, loc):
			emit_for_dict(for_dict, next_temp)
		ForSetExpr(for_set, typ, loc):
			emit_for_set(for_set, next_temp)
		ForResourceSourceExpr(for_resource_source, typ, loc):
			emit_for_resource_source(for_resource_source, next_temp)
		ForStreamExpr(for_stream, typ, loc):
			emit_for_stream(for_stream, next_temp)
		ForTensorExpr(for_tensor, typ, loc):
			emit_for_tensor(for_tensor, next_temp)
		PreClosureDetachExpr(detached, typ, loc):
			None
		DetachExpr(detached, typ, loc):
			emit_detach(detached, next_temp)
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			None
		ConcurrentlyLoopExpr(loop, typ, loc):
			emit_concurrently_loop(loop, typ, next_temp)
		PreClosureConcurrentExpr(block, typ, loc):
			None
		ConcurrentExpr(block, typ, loc):
			emit_concurrent_block(block, next_temp)
		SelectExpr(select_expr, typ, loc):
			emit_select(select_expr, next_temp)
		RangeExpr(start, end_value, typ, loc):
			value ?= emit_simple_expr(expr)
			Some(body_value(value, next_temp))
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			emit_accessor_literal_match(
				scrutinee,
				scrutinee_release_policy,
				match_expr,
				typ,
				next_temp,
			)
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			emit_length_match(scrutinee, scrutinee_release_policy, match_expr, typ, next_temp)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			emit_literal_match(scrutinee, cases, fallback, typ, next_temp)
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, fallback, typ, loc):
			emit_constructor_match(
				scrutinee,
				scrutinee_release_policy,
				cases,
				fallback,
				typ,
				next_temp,
			)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			emit_if_body(cond, then_expr, else_expr, typ, loc, next_temp)


private pure func unsupported_expr_child_path(expr: CoreExpr) -> String:
	children: List[CoreExpr] = CoreTraverse.immediate_core_expr_children(expr)
	var child_index: Int = 0
	var path: String = ""

	for child in children:
		if path.is_empty() and emit_function_body(child, 0).is_none():
			child_path: String = unsupported_expr_child_path(child)

			path = if child_path.is_empty():
				child_index.to_string()
			else:
				child_index.to_string() + "." + child_path

		child_index += 1

	path


private pure func unsupported_expr_child_kind(expr: CoreExpr) -> String:
	children: List[CoreExpr] = CoreTraverse.immediate_core_expr_children(expr)
	var kind: String = ""

	for child in children:
		if kind.is_empty() and emit_function_body(child, 0).is_none():
			kind = unsupported_expr_child_kind(child)
		else:
			void

	match kind:
		"":
			match expr:
				RawMatchExpr(_, _, _, _):
					"raw_match"
				SemanticMatchExpr(_, _, _, _):
					"semantic_match"
				DebugBlockExpr(_, _, _):
					"debug_block"
				VectorExpr(_, _, _):
					"vector"
				LambdaExpr(_, _, _, _, _, _):
					"lambda"
				DictExpr(_, _, _):
					"dict"
				RecordUpdateExpr(_, _, _, _):
					"record_update"
				TailrecRecurExpr(_, _, _):
					"tailrec_recur"
				TailrecListSpreadRecurExpr(_, _, _, _):
					"tailrec_list_spread_recur"
				PreClosureDetachExpr(_, _, _):
					"pre_closure_detach"
				PreClosureConcurrentlyLoopExpr(_, _, _):
					"pre_closure_concurrently_loop"
				PreClosureConcurrentExpr(_, _, _):
					"pre_closure_concurrent"
				_:
					"nested_emission"
		found:
			found


private pure func union_type_name(typ: CoreType) -> Option[String]:
	match typ:
		UnionType(name):
			Some(name)
		NamedType(name, args):
			None
		TypeParameterType(_) | SelfType:
			None
		StackResultType(ok_type, err_type):
			None
		BoxedResultType(ok_type, err_type):
			None
		FunctionType(is_pure, param_types, return_type):
			None
		HeapRecordType(name):
			None
		TupleType(items):
			None
		TensorType(info):
			None
		VoidType:
			None
		EnumType(name):
			None
		ValueRecordType(name):
			None
		RangeType:
			None


private pure func find_union_decl(
	decls: List[CoreDecl],
	type_name: String,
) -> Option[CoreUnionDecl]:
	var found: Option[CoreUnionDecl] = None

	for decl in decls:
		match decl:
			UnionDecl(union_decl):
				if union_decl.name == type_name:
					found = Some(union_decl)
			FunctionDecl(func_info):
				void
			TypeAliasDecl(alias_decl):
				void
			TraitDecl(trait_decl):
				void
			ImplDecl(impl_decl):
				void
			EnumDecl(enum_decl):
				void
			HeapRecordDecl(record_decl):
				void
			ValueRecordDecl(record_decl):
				void
			GlobalDecl(global):
				void

	found


private pure func find_union_variant(
	union_decl: CoreUnionDecl,
	variant_name: String,
) -> Option[CoreUnionVariant]:
	var found: Option[CoreUnionVariant] = None

	for variant in union_decl.variants:
		if variant.name == variant_name:
			found = Some(variant)

	found


private pure func union_variant_c_name(
	union_decl: CoreUnionDecl,
	variant_name: String,
) -> Option[String]:
	variant ?= find_union_variant(union_decl, variant_name)
	Some(variant.c_name)


private pure func channel_attempt_constructors(
	union_decl: CoreUnionDecl,
) -> ChannelAttemptConstructors:
	recv_value_variant: Option[CoreUnionVariant] = find_union_variant(union_decl, "RecvValue")

	recv_value_uses_release_mask: Bool = match recv_value_variant:
		Some(variant):
			union_variant_uses_release_mask(union_decl, variant)
		None:
			False

	{
		recv_value = union_variant_c_name(union_decl, "RecvValue"),
		recv_would_block = union_variant_c_name(union_decl, "RecvWouldBlock"),
		recv_sealed = union_variant_c_name(union_decl, "RecvSealed"),
		recv_timed_out = union_variant_c_name(union_decl, "RecvTimedOut"),
		send_accepted = union_variant_c_name(union_decl, "SendAccepted"),
		send_would_block = union_variant_c_name(union_decl, "SendWouldBlock"),
		send_sealed = union_variant_c_name(union_decl, "SendSealed"),
		send_timed_out = union_variant_c_name(union_decl, "SendTimedOut"),
		recv_value_uses_release_mask = recv_value_uses_release_mask
	}


private pure func channel_send_attempt_constructors(
	constructors: ChannelAttemptConstructors,
) -> Option[ChannelSendAttemptConstructors]:
	accepted ?= constructors.send_accepted
	would_block ?= constructors.send_would_block
	sealed ?= constructors.send_sealed
	timed_out ?= constructors.send_timed_out

	Some({
		accepted = accepted,
		would_block = would_block,
		sealed = sealed,
		timed_out = timed_out,
	})


private pure func channel_recv_attempt_constructors(
	constructors: ChannelAttemptConstructors,
	empty: Option[String],
) -> Option[ChannelRecvAttemptConstructors]:
	value ?= constructors.recv_value
	sealed ?= constructors.recv_sealed
	empty_ctor ?= empty

	Some({
		value = value,
		sealed = sealed,
		empty = empty_ctor,
	})


private pure func emit_channel_send_attempt_value(
	result_type: String,
	channel: String,
	value: String,
	timeout: Option[String],
	temp_seed: String,
	constructors: ChannelSendAttemptConstructors,
	retained_value: Bool,
) -> String:
	match timeout:
		Some(timeout_value):
			args: ChannelSendTimeoutAttemptArgs = {
				result_type = result_type,
				channel = channel,
				value = value,
				timeout = timeout_value,
				temp_seed = temp_seed,
				constructors = constructors
			}

			if retained_value:
				render_prepared_backend_op(BackendChannelSendTimeoutAttemptRetainedValue(args))
			else:
				render_prepared_backend_op(BackendChannelSendTimeoutAttempt(args))
		None:
			args: ChannelTrySendAttemptArgs = {
				result_type = result_type,
				channel = channel,
				value = value,
				temp_seed = temp_seed,
				constructors = constructors
			}

			if retained_value:
				render_prepared_backend_op(BackendChannelTrySendAttemptRetainedValue(args))
			else:
				render_prepared_backend_op(BackendChannelTrySendAttempt(args))


private pure func boxed_expr_temp_needs_release(expr: CoreExpr) -> Bool:
	match expr:
		BoxExpr(box, typ, loc):
			match box.kind:
				Int128Box:
					True
				UInt128Box:
					True
				StructBox(c_type):
					True
				PrimBox:
					False
				PointerBox:
					False
				VoidBox:
					False
				FloatBox:
					False
				Float32Box:
					False
				Float16Box:
					False
		other:
			False


private pure func emit_channel_recv_attempt_value(
	result_type: String,
	channel: String,
	timeout: Option[String],
	temp_seed: String,
	release_policy: ChannelRecvReleasePolicy,
	constructors: ChannelRecvAttemptConstructors,
	value_constructor_uses_release_mask: Bool,
) -> String:
	match timeout:
		Some(timeout_value):
			if value_constructor_uses_release_mask:
				args: ChannelRecvTimeoutAttemptArgs = {
					result_type = result_type,
					channel = channel,
					timeout = timeout_value,
					temp_seed = temp_seed,
					release_policy = release_policy,
					constructors = constructors
				}
				render_prepared_backend_op(BackendChannelRecvTimeoutAttempt(args))
			else:
				args: ChannelRecvTimeoutAttemptNoReleaseMaskArgs = {
					result_type = result_type,
					channel = channel,
					timeout = timeout_value,
					temp_seed = temp_seed,
					constructors = constructors
				}
				render_prepared_backend_op(BackendChannelRecvTimeoutAttemptNoReleaseMask(args))
		None:
			if value_constructor_uses_release_mask:
				args: ChannelTryRecvAttemptArgs = {
					result_type = result_type,
					channel = channel,
					temp_seed = temp_seed,
					release_policy = release_policy,
					constructors = constructors
				}
				render_prepared_backend_op(BackendChannelTryRecvAttempt(args))
			else:
				args: ChannelTryRecvAttemptNoReleaseMaskArgs = {
					result_type = result_type,
					channel = channel,
					temp_seed = temp_seed,
					constructors = constructors
				}
				render_prepared_backend_op(BackendChannelTryRecvAttemptNoReleaseMask(args))


private pure func emit_channel_attempt_return_function(
	func_info: CoreFunction,
	value: String,
) -> String:
	c_function_signature(func_info) + " {\n  return " + value + ";\n}\n"


private pure func emit_channel_send_timeout_attempt_for_values(
	func_info: CoreFunction,
	constructors: ChannelAttemptConstructors,
	temp_seed: String,
	value_expr: CoreExpr,
	arg_values: List[String],
) -> Option[String]:
	match arg_values:
		[channel, value, timeout]:
			send_constructors ?= channel_send_attempt_constructors(constructors)
			rendered: String = emit_channel_send_attempt_value(
				c_type_name(func_info.return_type),
				channel,
				value,
				Some(timeout),
				temp_seed,
				send_constructors,
				boxed_expr_temp_needs_release(value_expr),
			)
			Some(emit_channel_attempt_return_function(func_info, rendered))
		[]:
			None
		[first]:
			None
		[first, second]:
			None
		[first, second, third, fourth, ...rest]:
			None


private pure func emit_channel_try_send_attempt_for_values(
	func_info: CoreFunction,
	constructors: ChannelAttemptConstructors,
	temp_seed: String,
	value_expr: CoreExpr,
	arg_values: List[String],
) -> Option[String]:
	match arg_values:
		[channel, value]:
			send_constructors ?= channel_send_attempt_constructors(constructors)
			rendered: String = emit_channel_send_attempt_value(
				c_type_name(func_info.return_type),
				channel,
				value,
				None,
				temp_seed,
				send_constructors,
				boxed_expr_temp_needs_release(value_expr),
			)
			Some(emit_channel_attempt_return_function(func_info, rendered))
		[]:
			None
		[first]:
			None
		[first, second, third, ...rest]:
			None


private pure func emit_channel_recv_timeout_attempt_for_values(
	func_info: CoreFunction,
	constructors: ChannelAttemptConstructors,
	temp_seed: String,
	channel_expr: CoreExpr,
	arg_values: List[String],
) -> Option[String]:
	match arg_values:
		[channel, timeout]:
			elem_type ?= channel_element_type(core_expr_type(channel_expr))
			recv_constructors ?= channel_recv_attempt_constructors(
				constructors,
				constructors.recv_timed_out,
			)

			release_policy: ChannelRecvReleasePolicy = if boxed_value_needs_release_type(elem_type):
				ReleaseChannelRecvValue
			else:
				KeepChannelRecvValue

			rendered: String = emit_channel_recv_attempt_value(
				c_type_name(func_info.return_type),
				channel,
				Some(timeout),
				temp_seed,
				release_policy,
				recv_constructors,
				constructors.recv_value_uses_release_mask,
			)
			Some(emit_channel_attempt_return_function(func_info, rendered))
		[]:
			None
		[first]:
			None
		[first, second, third, ...rest]:
			None


private pure func emit_channel_try_recv_attempt_for_values(
	func_info: CoreFunction,
	constructors: ChannelAttemptConstructors,
	temp_seed: String,
	channel_expr: CoreExpr,
	arg_values: List[String],
) -> Option[String]:
	match arg_values:
		[channel]:
			elem_type ?= channel_element_type(core_expr_type(channel_expr))
			recv_constructors ?= channel_recv_attempt_constructors(
				constructors,
				constructors.recv_would_block,
			)

			release_policy: ChannelRecvReleasePolicy = if boxed_value_needs_release_type(elem_type):
				ReleaseChannelRecvValue
			else:
				KeepChannelRecvValue

			rendered: String = emit_channel_recv_attempt_value(
				c_type_name(func_info.return_type),
				channel,
				None,
				temp_seed,
				release_policy,
				recv_constructors,
				constructors.recv_value_uses_release_mask,
			)
			Some(emit_channel_attempt_return_function(func_info, rendered))
		[]:
			None
		[first, second, ...rest]:
			None


private pure func emit_channel_attempt_user_function(
	decls: List[CoreDecl],
	func_info: CoreFunction,
) -> Option[String]:
	body ?= func_info.body
	type_name ?= union_type_name(func_info.return_type)
	union_decl ?= find_union_decl(decls, type_name)
	constructors: ChannelAttemptConstructors = channel_attempt_constructors(union_decl)
	temp_seed: String = func_info.def_id.to_string()

	match body:
		RawMatchExpr(scrutinee, cases, typ, loc):
			None
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			None
		CallExpr(BuiltinCall(name), callee, args, typ, loc):
			arg_values ?= emit_simple_expr_arg_values(args)

			if name == "blorp_channel_send_timeout_attempt":
				match args:
					[channel_expr, value_expr, timeout_expr]:
						emit_channel_send_timeout_attempt_for_values(
							func_info,
							constructors,
							temp_seed,
							value_expr,
							arg_values,
						)
					[]:
						None
					[first]:
						None
					[first, second]:
						None
					[first, second, third, fourth, ...rest]:
						None
			else if name == "blorp_channel_try_send_attempt":
				match args:
					[channel_expr, value_expr]:
						emit_channel_try_send_attempt_for_values(
							func_info,
							constructors,
							temp_seed,
							value_expr,
							arg_values,
						)
					[]:
						None
					[first]:
						None
					[first, second, third, ...rest]:
						None
			else if name == "blorp_channel_recv_timeout_attempt":
				match args:
					[channel_expr, timeout_expr]:
						emit_channel_recv_timeout_attempt_for_values(
							func_info,
							constructors,
							temp_seed,
							channel_expr,
							arg_values,
						)
					[]:
						None
					[first]:
						None
					[first, second, third, ...rest]:
						None
			else if name == "blorp_channel_try_recv_attempt":
				match args:
					[channel_expr]:
						emit_channel_try_recv_attempt_for_values(
							func_info,
							constructors,
							temp_seed,
							channel_expr,
							arg_values,
						)
					[]:
						None
					[first, second, ...rest]:
						None
			else:
				None
		CallExpr(kind, callee, args, typ, loc):
			None
		LiteralExpr(literal, typ, loc):
			None
		VarExpr(variable, typ, loc):
			None
		VoidExpr(typ, loc):
			None
		DebugBlockExpr(body, typ, loc):
			None
		CooperativeCheckpointExpr(typ, loc):
			None
		BinaryExpr(op, left, right, typ, loc):
			None
		UnaryExpr(op, expr_value, typ, loc):
			None
		LogicalExpr(op, left, right, typ, loc):
			None
		AssignExpr(variable, rhs, typ, loc):
			None
		CastExpr(expr_value, typ, loc):
			None
		BoxExpr(box, typ, loc):
			None
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			None
		FieldExpr(expr_value, field_name, typ, loc):
			None
		TupleFieldExpr(expr_value, field_index, typ, loc):
			None
		TupleExpr(items, typ, loc):
			None
		TupleConstructExpr(tuple_construct, typ, loc):
			None
		VectorExpr(items, typ, loc):
			None
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			None
		ClosureCreateExpr(closure, typ, loc):
			None
		ListConstructExpr(construct, typ, loc):
			None
		ListAllocExpr(alloc, typ, loc):
			None
		ListGetExpr(get, typ, loc):
			None
		ListHandoffExpr(handoff, typ, loc):
			None
		ListHandoffSetOwnedExpr(set, typ, loc):
			None
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			None
		StringByteReadExpr(read, typ, loc):
			None
		StringByteWriteExpr(write, typ, loc):
			None
		StringByteCopyExpr(copy, typ, loc):
			None
		StringSetLenExpr(set_len, typ, loc):
			None
		TensorLiteralExpr(literal, typ, loc):
			None
		TensorBoxedLiteralExpr(literal, typ, loc):
			None
		TensorPackedLiteralExpr(literal, typ, loc):
			None
		TensorRawFillExpr(fill, typ, loc):
			None
		TensorRawReadExpr(read, typ, loc):
			None
		TensorRawWriteExpr(write, typ, loc):
			None
		TensorRawViewLetExpr(binding, body, typ, loc):
			None
		DictConstructExpr(construct, typ, loc):
			None
		DictExpr(entries, typ, loc):
			None
		SetAllocExpr(alloc, typ, loc):
			None
		ListRetainExpr(retain, typ, loc):
			None
		ListSetExpr(set, typ, loc):
			None
		ListSwapExpr(swap, typ, loc):
			None
		RecordExpr(fields, typ, loc):
			None
		RecordUpdateExpr(base, fields, typ, loc):
			None
		RecordReuseExpr(source, fields, typ, loc):
			None
		RecordConstructExpr(type_name, fields, typ, loc):
			None
		UnionConstructExpr(construct, typ, loc):
			None
		UnionReuseConstructExpr(construct, typ, loc):
			None
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			None
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			None
		LetExpr(name, is_mutable, typ, rhs, body):
			None
		BorrowLetExpr(name, typ, rhs, body):
			None
		SeqExpr(first, second):
			None
		WhileExpr(cond, body, typ, loc):
			None
		BreakExpr(typ, loc):
			None
		ContinueExpr(typ, loc):
			None
		ResourceScopeExpr(scope, typ, loc):
			None
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			None
		TailrecLoopExpr(params, return_type, body, loc):
			None
		TailrecRecurExpr(args, typ, loc):
			None
		TailrecListSpreadLoopExpr(loop, loc):
			None
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			None
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			None
		ForChannelExpr(for_channel, typ, loc):
			None
		ForListExpr(for_list, typ, loc):
			None
		ForStringExpr(for_string, typ, loc):
			None
		ForDictExpr(for_dict, typ, loc):
			None
		ForSetExpr(for_set, typ, loc):
			None
		ForResourceSourceExpr(for_resource_source, typ, loc):
			None
		ForStreamExpr(for_stream, typ, loc):
			None
		ForTensorExpr(for_tensor, typ, loc):
			None
		PreClosureDetachExpr(detached, typ, loc):
			None
		DetachExpr(detached, typ, loc):
			None
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			None
		ConcurrentlyLoopExpr(loop, typ, loc):
