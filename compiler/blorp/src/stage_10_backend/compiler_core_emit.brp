private enum ListHandoffEmitMode:
	EmitBorrowFreshHandoff
	EmitConsumeReuseHandoff


private union FixedBinaryRuntime:
	FixedBinaryCall(String)
	FixedBinaryNegatedCall(String)


private record RankedTensorCheckedGet {
	tensor_expr: CoreExpr,
	tensor: String,
	indices: List[String],
	dims: List[Int]
}


private record RankedTensorCheckedGetPrelude {
	statements: String,
	condition: String,
	flat: String
}


private record FloatModuloRuntime {
	c_type: String,
	zero_value: String,
	function_name: String,
	cast_via_double: Bool
}


private C_ARTIFACT_HEADER_BODY: String =
	|/* Blorp final Core C artifact */
	|#include <math.h>
	|#include <stdint.h>
	|#include <stdio.h>
	|#include <stdlib.h>
	|#include <string.h>

private C_ARTIFACT_HEADER: String = C_ARTIFACT_HEADER_BODY + "\n\n"


private pure func emit_foreign_include(header: String) -> String:
	"#include \"" + header + "\"\n"


private pure func emit_foreign_includes(headers: List[String]) -> String:
	if headers.length() == 0:
		""
	else:
		var rendered: String = ""

		for header in headers:
			rendered += emit_foreign_include(header)

		rendered + "\n"


