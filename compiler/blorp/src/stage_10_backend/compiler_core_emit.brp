private pure func call_args_consume_var_before_suspension(
	consumed_args: List[Int],
	args: List[CoreExpr],
	variable: CoreVar,
) -> Bool:
	var prefix_is_non_suspending: Bool = True
	var found: Bool = False
	var index: Int = 0

	for arg in args:
		if not found:
			if (
				prefix_is_non_suspending
				and consumed_args.contains(index)
				and expr_is_var_reference(arg, variable)
			):
				found = True
				break
			else:
				prefix_is_non_suspending = (
					prefix_is_non_suspending
					and transfer_prefix_is_non_suspending(arg)
				)

		index += 1

	found


private pure func call_consumes_var_before_suspension(
	kind: CoreCallKind,
	args: List[CoreExpr],
	variable: CoreVar,
) -> Bool:
	call_args_consume_var_before_suspension(
		call_kind_consumed_arg_indices(kind, args.length()),
		args,
		variable,
	)


private pure func call_consumes_var(
	kind: CoreCallKind,
	args: List[CoreExpr],
	variable: CoreVar,
) -> Bool:
	consumed_args: List[Int] = call_kind_consumed_arg_indices(kind, args.length())
	var found: Bool = False
	var index: Int = 0

	for arg in args:
		if consumed_args.contains(index) and expr_is_var_reference(arg, variable):
			found = True
			break

		index += 1

	found


private pure func variable_has_cleanup_slot(variable: CoreVar) -> Bool:
	match variable.def_id:
		Some(def_id):
			False
		None:
			-- Mangled definition symbols are constructor/function values projected as C rvalues,
			-- not locals with stable stack slots. Replace this with an explicit JSON bit.
			not variable.name.starts_with(MANGLED_DEF_ID_PREFIX)


