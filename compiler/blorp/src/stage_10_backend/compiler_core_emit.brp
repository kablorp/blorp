private pure func emit_generated_stack_option_typedef(
	payload_c_type: String,
	option_c_type: String,
) -> String:
	"typedef struct { int tag; " + payload_c_type + " value; } " + option_c_type + ";\n"


private BUILTIN_GENERATED_STACK_OPTION_TYPEDEFS: String = emit_generated_stack_option_typedef(
	"__int128",
	"blorp_StackOption_Int128",
) + emit_generated_stack_option_typedef(
	"unsigned __int128",
	"blorp_StackOption_UInt128",
) + emit_generated_stack_option_typedef("long", "blorp_StackOption_Range")


private pure func emit_decl_generated_stack_option_typedef(decl: CoreDecl) -> String:
	match decl:
		ValueRecordDecl(record_decl):
			if runtime_owned_stack_option_payload_name(record_decl.name):
				""
			else:
				emit_generated_stack_option_typedef(
					record_decl.name,
					generated_stack_option_c_type_name(record_decl.name),
				)
		EnumDecl(enum_decl):
			if runtime_owned_stack_option_payload_name(enum_decl.name):
				""
			else:
				emit_generated_stack_option_typedef(
					"long",
					generated_stack_option_c_type_name(enum_decl.name),
				)
		HeapRecordDecl(record_decl):
			""
		UnionDecl(union_decl):
			""
		FunctionDecl(func_info):
			""
		GlobalDecl(global):
			""
		TypeAliasDecl(alias_decl):
			""
		TraitDecl(trait_decl):
			""
		ImplDecl(impl_decl):
			""


private pure func emit_generated_stack_option_typedefs(decls: List[CoreDecl]) -> String:
	var c_code: String = BUILTIN_GENERATED_STACK_OPTION_TYPEDEFS

	for decl in decls:
		c_code = append_emitted_c(c_code, emit_decl_generated_stack_option_typedef(decl))

	if c_code == "":
		""
	else:
		c_code + "\n"


private pure func emit_global_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = make_string(0)

	for decl in decls:
		match decl:
			GlobalDecl(global):
				c_code = append_emitted_c(c_code, emit_global_decl(global))
			EnumDecl(enum_decl):
				void
			HeapRecordDecl(record_decl):
				void
			ValueRecordDecl(record_decl):
				void
			UnionDecl(union_decl):
				void
			FunctionDecl(func_info):
				void
			TypeAliasDecl(alias_decl):
				void
			TraitDecl(trait_decl):
				void
			ImplDecl(impl_decl):
				void

	c_code


private pure func emit_global_cleanup_statement(global: CoreGlobal) -> String:
	if not global_needs_runtime_init(global):
		""
	else:
		policy: CoreReleasePolicy = cleanup_release_policy_for_type(global.typ)

		if release_policy_requires_cleanup(policy):
			emit_release_statement(c_var_name(global.name), policy)
		else:
			""


private pure func emit_global_cleanup_statements(decls: List[CoreDecl]) -> String:
	var statements: String = ""

	for decl in decls:
		match decl:
			GlobalDecl(global):
				-- Global initializers may refer to earlier globals, so release roots in reverse order.
				statements = emit_global_cleanup_statement(global) + statements
			_:
				void

	statements


private pure func emit_global_init_function(decls: List[CoreDecl]) -> Result[String, CoreEmitError]:
	var statements: String = make_string(0)
	var error: Option[CoreEmitError] = None
	var temp_index: Int = 0

	for decl in decls:
		match error:
			Some(existing_error):
				void
			None:
				match decl:
					GlobalDecl(global):
						if global_needs_runtime_init(global):
							match emit_global_runtime_init_body(global, temp_index):
								Some(init_body):
									statements = append_emitted_c(statements, init_body.statements)
									temp_index = init_body.next_temp
								None:
									error = Some(UnsupportedGlobalInitializer(global.name.name))
						else:
							void
					EnumDecl(enum_decl):
						void
					HeapRecordDecl(record_decl):
						void
					ValueRecordDecl(record_decl):
						void
					UnionDecl(union_decl):
						void
					FunctionDecl(func_info):
						void
					TypeAliasDecl(alias_decl):
						void
					TraitDecl(trait_decl):
						void
					ImplDecl(impl_decl):
						void

	match error:
		Some(existing_error):
			Err(existing_error)
		None:
			cleanup_statements: String = emit_global_cleanup_statements(decls)

			cleanup_function: String = if cleanup_statements == "":
				""
			else:
				"static void __blorp_drop_globals(void) {\n" + cleanup_statements + "}\n\n"

			cleanup_registration: String = if cleanup_statements == "":
				""
			else:
				"  blorp_register_global_cleanup(__blorp_drop_globals);\n"

			Ok(
				cleanup_function + "void __blorp_init_globals(void) {\n" + statements + cleanup_registration + "}\n\n",
			)


private pure func emit_function_decls(decls: List[CoreDecl], profile_enabled: Bool) -> String:
	var c_code: String = make_string(0)

	for decl in decls:
		match decl:
			FunctionDecl(func_info):
				c_code = append_emitted_c(
					c_code,
					emit_function(decls, func_info, profile_enabled),
				)
			EnumDecl(enum_decl):
				void
			HeapRecordDecl(record_decl):
				void
			ValueRecordDecl(record_decl):
				void
			UnionDecl(union_decl):
				void
			GlobalDecl(global):
				void
			TypeAliasDecl(alias_decl):
				void
			TraitDecl(trait_decl):
				void
			ImplDecl(impl_decl):
				void

	c_code


private pure func emit_function_forward_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = make_string(0)

	for decl in decls:
		match decl:
			FunctionDecl(func_info):
				c_code = append_emitted_c(c_code, emit_function_forward_decl(func_info))
			EnumDecl(enum_decl):
				void
			HeapRecordDecl(record_decl):
				void
			ValueRecordDecl(record_decl):
				void
			UnionDecl(union_decl):
				void
			GlobalDecl(global):
				void
			TypeAliasDecl(alias_decl):
				void
			TraitDecl(trait_decl):
				void
			ImplDecl(impl_decl):
				void

	if c_code == "":
		""
	else:
		c_code + "\n"


private pure func emit_static_closure_forward_decls(decls: List[CoreDecl]) -> String:
	var c_code: String = make_string(0)

	for decl in decls:
		match decl:
			FunctionDecl(func_info):
				c_code = append_emitted_c(c_code, emit_static_closure_forward_decl(func_info))
			EnumDecl(enum_decl):
				void
			HeapRecordDecl(record_decl):
				void
			ValueRecordDecl(record_decl):
				void
			UnionDecl(union_decl):
				void
			GlobalDecl(global):
				void
			TypeAliasDecl(alias_decl):
				void
			TraitDecl(trait_decl):
				void
			ImplDecl(impl_decl):
				void

	if c_code == "":
		""
	else:
		c_code + "\n"


private pure func emit_decls(
	program: CoreProgram,
	profile_enabled: Bool,
) -> Result[String, CoreEmitError]:
	decls: List[CoreDecl] = program.decls
	layouts: CompilerCRecordLayoutRegistry = classify_c_record_layouts(program)
	global_init ?= emit_global_init_function(decls)
	var c_code: String = make_string(0)
	c_code = append_emitted_c(c_code, emit_heap_record_and_union_forward_decls(decls))
	c_code = append_emitted_c(
		c_code,
		emit_value_record_decls(decls, layouts),
	)
	c_code = append_emitted_c(c_code, emit_enum_decls(decls))
	c_code = append_emitted_c(c_code, emit_generated_stack_option_typedefs(decls))
	c_code = append_emitted_c(c_code, emit_union_decls(decls))
	c_code = append_emitted_c(
		c_code,
		emit_heap_record_decls(decls, layouts),
	)
	c_code = append_emitted_c(c_code, emit_static_closure_forward_decls(decls))
	c_code = append_emitted_c(c_code, emit_function_forward_decls(decls))
	c_code = append_emitted_c(c_code, emit_global_decls(decls))
	c_code = append_emitted_c(c_code, global_init)
	c_code = append_emitted_c(
		c_code,
		emit_function_decls(decls, profile_enabled),
	)
	Ok(c_code)


private pure func error_artifact(error: CoreEmitError) -> CArtifact:
	{
		c_code = C_ARTIFACT_HEADER + "#error " + c_string_literal(
			core_emit_error_message(error),
		) + "\n",
		link_flags = [],
		include_dirs = []
	}


pure func try_emit_prepared_core_program_c_artifact_with_profile(
	prepared: PreparedCoreProgram,
	profile_enabled: Bool,
) -> Result[CArtifact, CoreEmitError]:
	match prepared:
		PreparedCore(program):
			decls_c ?= emit_decls(program, profile_enabled)
			Ok({
				c_code = C_ARTIFACT_HEADER + emit_foreign_includes(
					program.foreign_includes,
				) + decls_c,
				link_flags = [],
				include_dirs = [],
			})


pure func emit_core_program_c_artifact_with_profile(
	program: CoreProgram,
	profile_enabled: Bool,
) -> CArtifact:
	match try_emit_core_program_c_artifact_with_profile(program, profile_enabled):
		Ok(artifact):
			artifact
		Err(error):
			error_artifact(error)


pure func try_emit_core_program_c_artifact_with_profile(
	program: CoreProgram,
	profile_enabled: Bool,
) -> Result[CArtifact, CoreEmitError]:
	prepared_program: PreparedCoreProgram = run_pre_dce_tail(program)

	try_emit_prepared_core_program_c_artifact_with_profile(prepared_program, profile_enabled)


pure func emit_core_program_c_artifact(program: CoreProgram) -> CArtifact:
	emit_core_program_c_artifact_with_profile(program, DEFAULT_PROFILE_ENABLED)
