private pure func emit_supported_user_function(
	decls: List[CoreDecl],
	func_info: CoreFunction,
	profile_enabled: Bool,
) -> Option[String]:
	if profile_enabled:
		emit_general_supported_user_function(profile_enabled, func_info)
	else:
		match emit_channel_attempt_user_function(decls, func_info):
			Some(c_code):
				Some(c_code)
			None:
				emit_general_supported_user_function(profile_enabled, func_info)


private pure func emit_general_supported_user_function(
	profile_enabled: Bool,
	func_info: CoreFunction,
) -> Option[String]:
	match func_info.body:
		Some(body):
			match emit_function_body(body, 0):
				Some(body_c):
					prefix: String = c_function_signature(func_info) + " {\n"
					body_prelude: String = entrypoint_arg_prelude(func_info)
					body_cleanup: String = entrypoint_arg_cleanup(func_info)
					profile_name: String = func_info.name
					is_entrypoint_function: Bool = (
						func_info.name == ENTRYPOINT_FUNCTION_NAME
						and func_info.source_module.is_none()
					)

					global_init: String = if is_entrypoint_function:
						"  __blorp_init_globals();\n"
					else:
						""

					profile_runtime_setup: String = if is_entrypoint_function:
						emit_profile_runtime_setup(profile_enabled)
					else:
						""

					body_prefix: String = prefix + global_init + profile_runtime_setup + body_prelude + emit_profile_start(
						profile_enabled,
						profile_name,
					)

					if is_void_type(func_info.return_type):
						if is_entrypoint_function:
							Some(
								body_prefix + discard_body(
									body_c,
								) + emit_profile_end(
									profile_enabled,
									profile_name,
								) + body_cleanup + "  return 0;\n}\n",
							)
						else:
							Some(
								body_prefix + discard_body(
									body_c,
								) + emit_profile_end(profile_enabled, profile_name) + "}\n",
							)
					else:
						match required_body_value(body_c):
							Some(return_value):
								if (
									is_entrypoint_function
									and (entrypoint_has_source_args(func_info) or profile_enabled)
								):
									Some(
										body_prefix + body_c.statements + "  long __blorp_main_result = (long)" + return_value + ";\n" + emit_profile_end(
											profile_enabled,
											profile_name,
										) + body_cleanup + "  return (int)__blorp_main_result;\n}\n",
									)
								else if profile_enabled:
									Some(
										body_prefix + body_c.statements + "  " + c_return_type(
											func_info,
										) + " __blorp_profile_result = " + return_value + ";\n" + emit_profile_end(
											profile_enabled,
											profile_name,
										) + "  return __blorp_profile_result;\n}\n",
									)
								else:
									Some(
										body_prefix + body_c.statements + "  return " + return_value + ";\n}\n",
									)
							None:
								if body_c.returns:
									Some(body_prefix + body_c.statements + "}\n")
								else:
									None
				None:
					None
		None:
			None


private pure func emit_function(
	decls: List[CoreDecl],
	func_info: CoreFunction,
	profile_enabled: Bool,
) -> String:
	match func_info.function_kind:
		UserFunction:
			match func_info.body:
				Some(body):
					match emit_supported_user_function(decls, func_info, profile_enabled):
						Some(c_code):
							c_code
						None:
							emit_unsupported_function_error(func_info)
				None:
					emit_function_inventory(func_info)
		BuiltinFunction(c_name):
			emit_function_inventory(func_info)
		UnresolvedBuiltinFunction:
			emit_function_inventory(func_info)
		ForeignFunction(_):
			emit_function_inventory(func_info)
		ClosureBodyFunction(abi):
			match emit_closure_body_function(func_info, abi):
				Some(c_code):
					c_code
				None:
					emit_function_inventory(func_info)


private pure func emit_function_forward_decl(func_info: CoreFunction) -> String:
	match func_info.function_kind:
		UserFunction:
			match func_info.body:
				Some(body):
					if (
						func_info.name == ENTRYPOINT_FUNCTION_NAME
						and func_info.source_module.is_none()
					):
						""
					else:
						c_function_signature(func_info) + ";\n"
				None:
					""
		BuiltinFunction(c_name):
			""
		UnresolvedBuiltinFunction:
			""
		ForeignFunction(_):
			""
		ClosureBodyFunction(abi):
			match func_info.body:
				Some(body):
					closure_body_signature(func_info, abi) + ";\n"
				None:
					""


private pure func emit_static_closure_forward_decl(func_info: CoreFunction) -> String:
	match func_info.function_kind:
		ClosureBodyFunction(abi):
			if abi.captures.length() == 0:
				"static blorp_Closure " + static_closure_name(abi.c_name) + ";\n"
			else:
				""
		UserFunction:
			""
		BuiltinFunction(c_name):
			""
		UnresolvedBuiltinFunction:
			""
		ForeignFunction(_):
			""


private pure func emit_enum_variant(variant: CoreEnumVariant) -> String:
	"#define " + variant.c_name + " " + variant.tag.to_string() + "L\n"


private pure func enum_to_string_function_name(enum_decl: CoreEnumDecl) -> String:
	"__blorp_enum_to_string_" + c_identifier(enum_decl.name)


private pure func enum_vector_to_string_function_name(enum_decl: CoreEnumDecl) -> String:
	"blorp_vector_to_string_" + c_identifier(enum_decl.name)


private pure func emit_enum_to_string_case(variant: CoreEnumVariant) -> String:
	"    case " + variant.c_name + ": return blorp_string_create(" + c_string_literal(
		variant.name,
	) + ");\n"


private pure func emit_enum_to_string_function(enum_decl: CoreEnumDecl) -> String:
	function_name: String = enum_to_string_function_name(enum_decl)
	var c_code: String = "static blorp_String* " + function_name + "(long v) {\n"
	c_code += "    switch (v) {\n"

	for variant in enum_decl.variants:
		c_code += emit_enum_to_string_case(variant)

	c_code += "    default: return blorp_to_string(v);\n"
	c_code += "    }\n"
	c_code += "}\n"
	c_code


private pure func emit_enum_vector_to_string_function(enum_decl: CoreEnumDecl) -> String:
	function_name: String = enum_vector_to_string_function_name(enum_decl)
	enum_to_string_name: String = enum_to_string_function_name(enum_decl)
	"blorp_String* " + function_name + "(blorp_Vector* v) {\n" + "    return blorp_vector_to_string_packed_enum(v, " + enum_to_string_name + ");\n" + "}\n"


private pure func emit_enum_decl(enum_decl: CoreEnumDecl) -> String:
	var c_code: String = ""

	for variant in enum_decl.variants:
		c_code += emit_enum_variant(variant)

	c_code += emit_enum_to_string_function(enum_decl)
	c_code += emit_enum_vector_to_string_function(enum_decl)
	c_code += "\n"

	c_code


private STATIC_LIST_MIN_CAPACITY: Int = 1

private STATIC_LIST_RUNTIME_PADDING_BYTES: Int = 5

private STATIC_TUPLE_MIN_STORAGE_SLOTS: Int = 1

private STATIC_FLOAT_NORMALIZE_MAX_STEPS: Int = 4096

private FLOAT64_EXPONENT_BIAS: Int = 1023

private FLOAT64_MAX_BIASED_EXPONENT: Int = 2046

private FLOAT64_FRACTION_BITS: Int = 52

private FLOAT32_EXPONENT_BIAS: Int = 127

private FLOAT32_MAX_BIASED_EXPONENT: Int = 254

private FLOAT32_FRACTION_BITS: Int = 23

private FLOAT16_EXPONENT_BIAS: Int = 15

private FLOAT16_MAX_BIASED_EXPONENT: Int = 30

private FLOAT16_FRACTION_BITS: Int = 10


