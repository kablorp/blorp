-- Classify record layouts before C emission.
--
-- Foreign ABI exposure is transitive: changing an embedded value record also
-- changes the containing foreign parameter or result. Keep that distinction
-- explicit so storage optimizations cannot depend on naming conventions.
import:
	../stage_08_core_lower/core_list_layout:
		CoreLayoutTypeIndex,
		build_layout_type_index,
		resolve_layout_type_with_index,
	../stage_09_core/core_c_type_layout: c_type_name, runtime_backed_heap_record_c_type
	../stage_09_core/core_json:
		CoreCallKind(ForeignCall),
		CoreDecl(FunctionDecl, GlobalDecl, HeapRecordDecl, ImplDecl, UnionDecl, ValueRecordDecl),
		CoreEnumDecl,
		CoreExpr(CallExpr),
		CoreFunction,
		CoreFunctionKind(ForeignFunction),
		CoreHeapRecordDecl,
		CoreProgram,
		CoreType(
			BoxedResultType,
			EnumType,
			FunctionType,
			HeapRecordType,
			NamedType,
			RangeType,
			SelfType,
			StackResultType,
			TensorType,
			TupleType,
			TypeParameterType,
			UnionType,
			ValueRecordType,
			VoidType,
		),
		CoreUnionDecl,
		CoreValueRecordDecl,
		core_expr_type,
	../stage_09_core/core_traverse: immediate_core_expr_children
	set as Sets


union CompilerCRecordLayout:
	InternalLayout
	ForeignAbiLayout


union CompilerCValueRecordFieldStorage:
	OrdinaryCValueRecordField(String)
	PackedBooleanCValueRecordField


union CompilerCHeapRecordFieldStorage:
	OrdinaryCHeapRecordField(String)
	PackedBooleanCHeapRecordField


MAX_BYTE_ENUM_TAG: Int = 255


pure func c_value_record_field_type_is_boolean(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			name == "Bool" and args.length() == 0
		EnumType(name):
			name == "Bool"
		_:
			False


pure func c_heap_record_field_storage(
	registry: CompilerCRecordLayoutRegistry,
	record_name: String,
	layout: CompilerCRecordLayout,
	typ: CoreType,
	has_boolean_neighbor: Bool,
) -> CompilerCHeapRecordFieldStorage:
	match layout:
		InternalLayout:
			if c_value_record_field_type_is_boolean(typ):
				if has_boolean_neighbor:
					PackedBooleanCHeapRecordField
				else:
					OrdinaryCHeapRecordField("_Bool")
			else:
				match typ:
					EnumType(name):
						match runtime_backed_heap_record_c_type(record_name):
							Some(_):
								OrdinaryCHeapRecordField(c_type_name(typ))
							None:
								if Sets.contains(registry.byte_sized_enum_names, name):
									OrdinaryCHeapRecordField("uint8_t")
								else:
									OrdinaryCHeapRecordField(c_type_name(typ))
					_:
						OrdinaryCHeapRecordField(c_type_name(typ))
		ForeignAbiLayout:
			OrdinaryCHeapRecordField(c_type_name(typ))


pure func c_value_record_field_storage(
	layout: CompilerCRecordLayout,
	typ: CoreType,
	has_boolean_neighbor: Bool,
) -> CompilerCValueRecordFieldStorage:
	match layout:
		InternalLayout:
			if c_value_record_field_type_is_boolean(typ):
				if has_boolean_neighbor:
					PackedBooleanCValueRecordField
				else:
					OrdinaryCValueRecordField("_Bool")
			else:
				OrdinaryCValueRecordField(c_type_name(typ))
		ForeignAbiLayout:
			OrdinaryCValueRecordField(c_type_name(typ))


record CompilerCRecordLayoutRegistry {
	foreign_abi_value_record_names: Set[String],
	foreign_abi_heap_record_names: Set[String],
	byte_sized_enum_names: Set[String]
}


private record CompilerCRecordDeclIndex {
	layout_types: CoreLayoutTypeIndex,
	value_records: Dict[String, CoreValueRecordDecl],
	heap_records: Dict[String, CoreHeapRecordDecl],
	unions: Dict[String, CoreUnionDecl]
}


private pure func build_record_decl_index(program: CoreProgram) -> CompilerCRecordDeclIndex:
	var value_records: Dict[String, CoreValueRecordDecl] = {}
	var heap_records: Dict[String, CoreHeapRecordDecl] = {}
	var unions: Dict[String, CoreUnionDecl] = {}

	for decl in program.decls:
		match decl:
			ValueRecordDecl(record_decl):
				if not value_records.contains(record_decl.name):
					value_records = value_records.set(record_decl.name, record_decl)
			HeapRecordDecl(record_decl):
				if not heap_records.contains(record_decl.name):
					heap_records = heap_records.set(record_decl.name, record_decl)
			UnionDecl(union_decl):
				if not unions.contains(union_decl.name):
					unions = unions.set(union_decl.name, union_decl)
			_:
				void

	{
		layout_types = build_layout_type_index(program),
		value_records = value_records,
		heap_records = heap_records,
		unions = unions
	}


pure func c_record_layout(
	registry: CompilerCRecordLayoutRegistry,
	record_name: String,
) -> CompilerCRecordLayout:
	if Sets.contains(registry.foreign_abi_value_record_names, record_name):
		ForeignAbiLayout
	else:
		InternalLayout


pure func c_heap_record_layout(
	registry: CompilerCRecordLayoutRegistry,
	record_name: String,
) -> CompilerCRecordLayout:
	if Sets.contains(registry.foreign_abi_heap_record_names, record_name):
		ForeignAbiLayout
	else:
		InternalLayout


private pure func foreign_signature_types_for_function(
	function_info: CoreFunction,
) -> List[CoreType]:
	match function_info.function_kind:
		ForeignFunction(_):
			var types: List[CoreType] = []

			for param in function_info.params:
				types = types.append(param.typ)

			types.append(function_info.return_type)
		_:
			[]


private pure func foreign_call_types(root: CoreExpr) -> List[CoreType]:
	var types: List[CoreType] = []
	var pending: List[CoreExpr] = [root]

	while pending.length() > 0:
		last_index: Int = pending.length() - 1

		match pending.get(last_index):
			Some(expr):
				-- Retain only the unvisited frontier, not the full function body.
				pending = pending
					.remove(last_index)
					.get_or([])

				match expr:
					CallExpr(ForeignCall(_, _), _, args, return_type, _):
						for arg in args:
							types = types.append(core_expr_type(arg))

						types = types.append(return_type)
					_:
						void

				pending = pending.concat(immediate_core_expr_children(expr))
			None:
				void

	types


private pure func foreign_call_types_for_function(function_info: CoreFunction) -> List[CoreType]:
	match function_info.body:
		Some(body):
			foreign_call_types(body)
		None:
			[]


private pure func foreign_boundary_types(program: CoreProgram) -> List[CoreType]:
	var types: List[CoreType] = []

	for decl in program.decls:
		match decl:
			FunctionDecl(function_info):
				types = types.concat(foreign_signature_types_for_function(function_info))
				types = types.concat(foreign_call_types_for_function(function_info))
			GlobalDecl(global):
				types = types.concat(foreign_call_types(global.init))
			ImplDecl(impl_info):
				for method in impl_info.methods:
					types = types.concat(foreign_signature_types_for_function(method))
					types = types.concat(foreign_call_types_for_function(method))
			_:
				void

	types


private pure func append_nested_types(pending: List[CoreType], typ: CoreType) -> List[CoreType]:
	match typ:
		NamedType(_, args):
			pending.concat(args)
		StackResultType(ok_type, err_type) | BoxedResultType(ok_type, err_type):
			pending
				.append(ok_type)
				.append(err_type)
		FunctionType(_, params, return_type):
			pending
				.concat(params)
				.append(return_type)
		TensorType(info):
			pending.append(info.element_type)
		TupleType(items):
			pending.concat(items)
		VoidType | EnumType(_) | HeapRecordType(_) | RangeType | TypeParameterType(_) | SelfType | UnionType(_) | ValueRecordType(_):
			pending


private pure func enum_decl_uses_byte_tags(enum_decl: CoreEnumDecl) -> Bool:
	var uses_byte_tags: Bool = enum_decl.variants.length() > 0

	for variant in enum_decl.variants:
		if variant.tag < 0 or variant.tag > MAX_BYTE_ENUM_TAG:
			uses_byte_tags = False
			break

	uses_byte_tags


pure func classify_c_record_layouts(program: CoreProgram) -> CompilerCRecordLayoutRegistry:
	decl_index: CompilerCRecordDeclIndex = build_record_decl_index(program)
	var foreign_names: Set[String] = Sets.set()
	var foreign_heap_names: Set[String] = Sets.set()
	var byte_sized_enum_names: Set[String] = Sets.set()
	var visited_union_names: Set[String] = Sets.set()
	var pending: List[CoreType] = foreign_boundary_types(program)
	var index: Int = 0

	for decl in program.decls:
		match decl:
			EnumDecl(enum_decl):
				if enum_decl_uses_byte_tags(enum_decl):
					byte_sized_enum_names = Sets.add(byte_sized_enum_names, enum_decl.name)
			_:
				void

	while index < pending.length():
		match pending.get(index):
			Some(typ):
				resolved: CoreType = resolve_layout_type_with_index(decl_index.layout_types, typ)

				match resolved:
					ValueRecordType(record_name):
						if not Sets.contains(foreign_names, record_name):
							foreign_names = Sets.add(foreign_names, record_name)

							match decl_index.value_records.get(record_name):
								Some(record_decl):
									for field in record_decl.fields:
										pending = pending.append(field.typ)
								None:
									void
					HeapRecordType(record_name):
						if not Sets.contains(foreign_heap_names, record_name):
							foreign_heap_names = Sets.add(foreign_heap_names, record_name)

							match decl_index.heap_records.get(record_name):
								Some(record_decl):
									for field in record_decl.fields:
										pending = pending.append(field.typ)
								None:
									void
					UnionType(union_name):
						if not Sets.contains(visited_union_names, union_name):
							visited_union_names = Sets.add(visited_union_names, union_name)

							match decl_index.unions.get(union_name):
								Some(union_decl):
									for variant in union_decl.variants:
										for field in variant.fields:
											pending = pending.append(field.typ)
								None:
									void
					_:
						pending = append_nested_types(pending, resolved)
			None:
				void

		index += 1

	{
		foreign_abi_value_record_names = foreign_names,
		foreign_abi_heap_record_names = foreign_heap_names,
		byte_sized_enum_names = byte_sized_enum_names
	}
