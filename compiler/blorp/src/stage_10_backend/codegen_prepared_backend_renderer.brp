-- C renderer helpers for the prepared backend facade.
--
-- `core_emit.brp` owns Core traversal and child expression emission. This
-- module owns the final C snippet shape emitted through the prepared backend
-- facade.
enum ElemReleaseArg:
	NoElemRelease
	ElemReleaseFn


enum DictKeyReleasePolicy:
	DictKeepKey
	DictReleaseKey


enum ChannelRetainingSendRuntime:
	ChannelSendRuntime
	ChannelTrySendRuntime
	ChannelTrySendStatusRuntime


enum ChannelRetainingSendTimeoutRuntime:
	ChannelSendTimeoutRuntime
	ChannelSendTimeoutStatusRuntime


enum ChannelRecvReleasePolicy:
	KeepChannelRecvValue
	ReleaseChannelRecvValue


enum SelectChannelArmKind:
	SelectRecvArmKind
	SelectSealedArmKind


-- Typed operation model.
record CustomCtorArgs {
	hash_fn: String,
	equals_fn: String
}


record CapacityCustomCtorArgs {
	capacity: String,
	hash_fn: String,
	equals_fn: String
}


record StackOptionValueRecordGetArgs {
	dict: String,
	key: String,
	temp_seed: String,
	option_c_type: String,
	payload_c_type: String,
	none_value: String
}


record StackOptionScalarGetArgs {
	dict: String,
	key: String,
	temp_seed: String,
	option_c_type: String,
	none_value: String
}


record DictInsertArgs {
	temp_seed: String,
	key: String,
	value: String,
	key_transfers_ownership: Bool,
	value_transfers_ownership: Bool
}


record DictIterSourceBindingArgs {
	dict: String,
	source: String
}


record DictIterLoopOpenArgs {
	index: String,
	dict: String
}


record DictIterHeaderArgs {
	dict: String,
	source: String,
	index: String
}


record DictIterSlotBindingArgs {
	slot: String,
	dict: String,
	index: String
}


record DictIterKeyBindingArgs {
	key_c_type: String,
	binding: String,
	dict: String,
	slot: String
}


record DictIterPairBindingArgs {
	entry: String,
	dict: String,
	slot: String
}


record DictConstructWithBodyArgs {
	ctor: String,
	temp_seed: String,
	release_init: String,
	insert_statements: String
}


record SetIterSourceBindingArgs {
	set: String,
	source: String
}


record SetIterLoopOpenArgs {
	entry: String,
	set: String
}


record SetIterHeaderArgs {
	set: String,
	source: String,
	entry: String
}


record StringFindByteFromArgs {
	source: String,
	byte: String,
	start: String,
	temp_seed: String
}


record StringByteCopyArgs {
	dst: String,
	dst_pos: String,
	src: String,
	src_pos: String,
	len: String,
	temp_seed: String
}


record StringIterSourceBindingArgs {
	iter: String,
	source: String
}


record StringIterLoopOpenArgs {
	index: String,
	iter: String
}


record StringIterCodepointBindingArgs {
	binding: String,
	iter: String,
	index: String
}


record StringIterHeaderArgs {
	iter: String,
	source: String,
	index: String
}


record FlatIterSourceBindingArgs {
	iter_c_type: String,
	iter: String,
	source: String
}


record FlatIterLengthBindingArgs {
	length: String,
	iter: String
}


record FlatIterLoopOpenArgs {
	index: String,
	length: String
}


record FlatIterLoopHeaderArgs {
	length: String,
	iter: String,
	index: String
}


record FlatIterRawDataBindingArgs {
	pointer_c_type: String,
	raw: String,
	iter: String
}


record FlatIterRawValueBindingArgs {
	value_c_type: String,
	binding: String,
	raw: String,
	index: String
}


record ChannelWithElemReleaseArgs {
	capacity: String,
	temp_seed: String
}


record ChannelRetainingSendArgs {
	result_type: String,
	channel: String,
	value: String,
	temp_seed: String
}


record ChannelRetainingSendWithTimeoutArgs {
	result_type: String,
	channel: String,
	value: String,
	timeout: String,
	temp_seed: String
}


record ChannelSendAttemptConstructors {
	accepted: String,
	would_block: String,
	sealed: String,
	timed_out: String
}


record ChannelTrySendAttemptArgs {
	result_type: String,
	channel: String,
	value: String,
	temp_seed: String,
	constructors: ChannelSendAttemptConstructors
}


record ChannelSendTimeoutAttemptArgs {
	result_type: String,
	channel: String,
	value: String,
	timeout: String,
	temp_seed: String,
	constructors: ChannelSendAttemptConstructors
}


record ChannelRecvAttemptConstructors {
	value: String,
	sealed: String,
	empty: String
}


record ChannelTryRecvAttemptArgs {
	result_type: String,
	channel: String,
	temp_seed: String,
	release_policy: ChannelRecvReleasePolicy,
	constructors: ChannelRecvAttemptConstructors
}


record ChannelTryRecvAttemptNoReleaseMaskArgs {
	result_type: String,
	channel: String,
	temp_seed: String,
	constructors: ChannelRecvAttemptConstructors
}


record ChannelRecvTimeoutAttemptArgs {
	result_type: String,
	channel: String,
	timeout: String,
	temp_seed: String,
	release_policy: ChannelRecvReleasePolicy,
	constructors: ChannelRecvAttemptConstructors
}


record ChannelRecvTimeoutAttemptNoReleaseMaskArgs {
	result_type: String,
	channel: String,
	timeout: String,
	temp_seed: String,
	constructors: ChannelRecvAttemptConstructors
}


record StackOptionSomeValueArgs {
	option_type: String,
	value: String
}


record StackOptionSomeVoidStatementArgs {
	option_type: String,
	statement: String
}


record StackOptionNoneArgs {
	option_type: String,
	none_value: String
}


record StackOptionTaggedValueArgs {
	option_type: String,
	tag: String,
	value: String
}


record StackOptionTaggedVoidStatementArgs {
	option_type: String,
	tag: String,
	statement: String
}


record StackOptionTaggedNoneArgs {
	option_type: String,
	tag: String,
	none_value: String
}


record StackResultConstructorArgs {
	result_type: String,
	payload: String,
	release_mask: String
}


record StackResultTaggedPayloadArgs {
	result_type: String,
	tag: String,
	field: String,
	payload: String,
	release_mask: String
}


record ChannelIterSourceBindingArgs {
	channel: String,
	source: String
}


record ChannelIterLoopOpenArgs {
	channel: String,
	value: String
}


record ChannelIterHeaderArgs {
	channel: String,
	source: String,
	value: String
}


record SelectArmsDeclArgs {
	arms: String,
	arm_count: String
}


record SelectChannelArmArgs {
	arms: String,
	index: String,
	channel: String
}


record SelectAfterArmArgs {
	arms: String,
	index: String,
	timeout: String
}


record SelectWaitArgs {
	result: String,
	arms: String,
	arm_count: String
}


record SelectBranchArgs {
	result: String,
	index: String
}


record SelectCleanupPushArgs {
	cleanup_frame: String,
	value_slot: String,
	cleanup_value: String,
	release_fn: String
}


record SelectReceivedValueBindingArgs {
	binding: String,
	result: String
}


union PreparedBackendOp:
	BackendDictCtorGeneric
	BackendDictCtorString
	BackendDictCtorFloat
	BackendDictCtorCustom(CustomCtorArgs, ElemReleaseArg)
	BackendDictStackOptionValueRecordGet(StackOptionValueRecordGetArgs, DictKeyReleasePolicy)
	BackendDictStackOptionLongGet(StackOptionScalarGetArgs, DictKeyReleasePolicy)
	BackendDictStackOptionInt128Get(StackOptionScalarGetArgs, DictKeyReleasePolicy)
	BackendDictStackOptionUInt128Get(StackOptionScalarGetArgs, DictKeyReleasePolicy)
	BackendDictConstructEmpty(String)
	BackendDictValueReleaseInit(String)
	BackendDictInsert(DictInsertArgs)
	BackendDictIterSourceBinding(DictIterSourceBindingArgs)
	BackendDictIterLoopOpen(DictIterLoopOpenArgs)
	BackendDictIterHeader(DictIterHeaderArgs)
	BackendDictIterSlotBinding(DictIterSlotBindingArgs)
	BackendDictIterDeletedSlotGuard(String)
	BackendDictIterKeyBinding(DictIterKeyBindingArgs)
	BackendDictIterPairBinding(DictIterPairBindingArgs)
	BackendDictConstructWithBody(DictConstructWithBodyArgs)
	BackendSetCtorGeneric
	BackendSetCtorString
	BackendSetCtorFloat
	BackendSetCtorCustom(CustomCtorArgs, ElemReleaseArg)
	BackendSetIterSourceBinding(SetIterSourceBindingArgs)
	BackendSetIterRetain(String)
	BackendSetIterLoopOpen(SetIterLoopOpenArgs)
	BackendSetIterEntryKey(String)
	BackendSetIterRelease(String)
	BackendSetIterHeader(SetIterHeaderArgs)
	BackendStringFindByteFrom(StringFindByteFromArgs)
	BackendStringByteRead(String, String)
	BackendStringByteWrite(String, String, String)
	BackendStringByteCopy(StringByteCopyArgs)
	BackendStringSetLen(String, String)
	BackendStringIterSourceBinding(StringIterSourceBindingArgs)
	BackendStringIterLoopOpen(StringIterLoopOpenArgs)
	BackendStringIterCodepointBinding(StringIterCodepointBindingArgs)
	BackendStringIterHeader(StringIterHeaderArgs)
	BackendFlatIterSourceBinding(FlatIterSourceBindingArgs)
	BackendFlatIterLengthBinding(FlatIterLengthBindingArgs)
	BackendFlatIterLoopOpen(FlatIterLoopOpenArgs)
	BackendFlatIterLoopHeader(FlatIterLoopHeaderArgs)
	BackendFlatIterRawDataBinding(FlatIterRawDataBindingArgs)
	BackendFlatIterRawValueBinding(FlatIterRawValueBindingArgs)
	BackendDictWithCapacityGeneric(String)
	BackendDictWithCapacityString(String)
	BackendDictWithCapacityFloat(String)
	BackendDictWithCapacityCustom(CapacityCustomCtorArgs, ElemReleaseArg)
	BackendChannelWithElemRelease(ChannelWithElemReleaseArgs)
	BackendChannelRetainingSend(ChannelRetainingSendArgs, ChannelRetainingSendRuntime)
	BackendChannelRetainingSendWithTimeout(ChannelRetainingSendWithTimeoutArgs, ChannelRetainingSendTimeoutRuntime)
	BackendChannelTrySendAttempt(ChannelTrySendAttemptArgs)
	BackendChannelTrySendAttemptRetainedValue(ChannelTrySendAttemptArgs)
	BackendChannelSendTimeoutAttempt(ChannelSendTimeoutAttemptArgs)
	BackendChannelSendTimeoutAttemptRetainedValue(ChannelSendTimeoutAttemptArgs)
	BackendChannelTryRecvAttempt(ChannelTryRecvAttemptArgs)
	BackendChannelRecvTimeoutAttempt(ChannelRecvTimeoutAttemptArgs)
	BackendChannelTryRecvAttemptNoReleaseMask(ChannelTryRecvAttemptNoReleaseMaskArgs)
	BackendChannelRecvTimeoutAttemptNoReleaseMask(ChannelRecvTimeoutAttemptNoReleaseMaskArgs)
	BackendStackOptionSomeValue(StackOptionSomeValueArgs)
	BackendStackOptionSomeVoidStatement(StackOptionSomeVoidStatementArgs)
	BackendStackOptionNone(StackOptionNoneArgs)
	BackendStackOptionTaggedValue(StackOptionTaggedValueArgs)
	BackendStackOptionTaggedVoidStatement(StackOptionTaggedVoidStatementArgs)
	BackendStackOptionTaggedNone(StackOptionTaggedNoneArgs)
	BackendStackResultOk(StackResultConstructorArgs)
	BackendStackResultErr(StackResultConstructorArgs)
	BackendStackResultTaggedPayload(StackResultTaggedPayloadArgs)
	BackendChannelIterSourceBinding(ChannelIterSourceBindingArgs)
	BackendChannelIterValueInit(String)
	BackendChannelIterLoopOpen(ChannelIterLoopOpenArgs)
	BackendChannelIterReleaseObject(String)
	BackendChannelIterHeader(ChannelIterHeaderArgs)
	BackendSelectArmsDecl(SelectArmsDeclArgs)
	BackendSelectRecvArm(SelectChannelArmArgs)
	BackendSelectSealedArm(SelectChannelArmArgs)
	BackendSelectAfterArm(SelectAfterArmArgs)
	BackendSelectWait(SelectWaitArgs)
	BackendSelectFirstBranchOpen(SelectBranchArgs)
	BackendSelectNextBranchOpen(SelectBranchArgs)
	BackendSelectCleanupFrameDecl(String)
	BackendSelectCleanupPush(SelectCleanupPushArgs)
	BackendSelectCleanupPop(String)
	BackendSelectReceivedValueBinding(SelectReceivedValueBindingArgs)


-- C snippet rendering helpers.
private pure func render_elem_release_arg(arg: ElemReleaseArg) -> String:
	match arg:
		NoElemRelease:
			"NULL"
		ElemReleaseFn:
			"blorp_elem_release_fn"


private pure func render_custom_ctor(
	function_name: String,
	args: CustomCtorArgs,
	elem_release: ElemReleaseArg,
) -> String:
	release_arg: String = render_elem_release_arg(elem_release)

	"${function_name}((unsigned long (*)(void*))${args.hash_fn}, " + "(bool (*)(void*, void*))${args.equals_fn}, ${release_arg})"


private pure func render_capacity_custom_ctor(
	function_name: String,
	args: CapacityCustomCtorArgs,
	elem_release: ElemReleaseArg,
) -> String:
	release_arg: String = render_elem_release_arg(elem_release)

	"${function_name}(${args.capacity}, (unsigned long (*)(void*))${args.hash_fn}, " + "(bool (*)(void*, void*))${args.equals_fn}, ${release_arg})"


private pure func c_block(body: String) -> String:
	"{ " + body + " }"


private pure func c_statement_expr(body: String) -> String:
	"(" + c_block(body) + ")"


private pure func c_one_line(text: String) -> String:
	text.replace("\n", " ")


private pure func stack_option_raw_tmp(temp_seed: String) -> String:
	"__gso_raw_${temp_seed}"


private pure func dict_construct_tmp(temp_seed: String) -> String:
	"__dict_${temp_seed}"


private pure func render_stack_option_none_assignment(
	result_tmp: String,
	option_c_type: String,
	none_value: String,
) -> String:
	"${result_tmp} = ((${option_c_type}){ .tag = BLORP_TAG_NONE, .value = ${none_value} });"


private pure func render_stack_option_some_assignment(
	result_tmp: String,
	option_c_type: String,
	payload_expr: String,
) -> String:
	"${result_tmp} = ((${option_c_type}){ .tag = BLORP_TAG_SOME, .value = ${payload_expr} });"


private pure func render_key_release_tail(
	policy: DictKeyReleasePolicy,
	key_tmp: String,
	result_tmp: String,
) -> String:
	match policy:
		DictKeepKey:
			"${result_tmp};"
		DictReleaseKey:
			"blorp_release(${key_tmp}); ${result_tmp};"


private pure func render_stack_option_dict_shell(
	dict: String,
	key: String,
	temp_seed: String,
	option_c_type: String,
	none_value: String,
	payload_expr: String,
	key_policy: DictKeyReleasePolicy,
) -> String:
	dict_tmp: String = "__gso_dict_${temp_seed}"
	key_tmp: String = "__gso_key_${temp_seed}"
	found_tmp: String = "__gso_found_${temp_seed}"
	raw_tmp: String = stack_option_raw_tmp(temp_seed)
	result_tmp: String = "__gso_result_${temp_seed}"
	dict_bind: String = "blorp_Dict* ${dict_tmp} = (blorp_Dict*)${dict};"
	key_bind: String = "void* ${key_tmp} = ${key};"
	raw_decl: String = "void* ${raw_tmp} = NULL;"
	found_bind: String = "bool ${found_tmp} = blorp_dict_get_raw(${dict_tmp}, ${key_tmp}, &${raw_tmp});"
	result_decl: String = "${option_c_type} ${result_tmp};"
	found_condition: String = "if (${found_tmp}) "
	some_body: String = render_stack_option_some_assignment(result_tmp, option_c_type, payload_expr)
	none_body: String = render_stack_option_none_assignment(result_tmp, option_c_type, none_value)
	tail: String = render_key_release_tail(key_policy, key_tmp, result_tmp)

	c_statement_expr(
		dict_bind + " " + key_bind + " " + raw_decl + " " + found_bind + " " + result_decl + " " + found_condition + c_block(
			some_body,
		) + " else " + c_block(none_body) + " " + tail,
	)


private pure func render_stack_option_value_record_get(
	args: StackOptionValueRecordGetArgs,
	key_policy: DictKeyReleasePolicy,
) -> String:
	raw_tmp: String = stack_option_raw_tmp(args.temp_seed)
	payload_expr: String = "blorp_unbox_struct(${raw_tmp}, ${args.payload_c_type})"
	render_stack_option_dict_shell(
		args.dict,
		args.key,
		args.temp_seed,
		args.option_c_type,
		args.none_value,
		payload_expr,
		key_policy,
	)


private pure func render_stack_option_long_get(
	args: StackOptionScalarGetArgs,
	key_policy: DictKeyReleasePolicy,
) -> String:
	raw_tmp: String = stack_option_raw_tmp(args.temp_seed)
	payload_expr: String = "(long)${raw_tmp}"
	render_stack_option_dict_shell(
		args.dict,
		args.key,
		args.temp_seed,
		args.option_c_type,
		args.none_value,
		payload_expr,
		key_policy,
	)


private pure func render_stack_option_erased_get(
	args: StackOptionScalarGetArgs,
	key_policy: DictKeyReleasePolicy,
	unbox_fn: String,
) -> String:
	raw_tmp: String = stack_option_raw_tmp(args.temp_seed)
	payload_expr: String = "${unbox_fn}(${raw_tmp})"
	render_stack_option_dict_shell(
		args.dict,
		args.key,
		args.temp_seed,
		args.option_c_type,
		args.none_value,
		payload_expr,
		key_policy,
	)


private pure func render_dict_value_release_init(temp_seed: String) -> String:
	dict_tmp: String = dict_construct_tmp(temp_seed)
	" blorp_dict_set_value_release(${dict_tmp}, blorp_elem_release_fn);"


private pure func render_transferred_value_release(
	value_name: String,
	transfers_ownership: Bool,
) -> String:
	if transfers_ownership:
		" blorp_release(" + value_name + ");"
	else:
		""


private pure func render_dict_insert(args: DictInsertArgs) -> String:
	dict_tmp: String = dict_construct_tmp(args.temp_seed)

	if args.key_transfers_ownership or args.value_transfers_ownership:
		key_tmp: String = "__dict_key_" + args.temp_seed
		value_tmp: String = "__dict_value_" + args.temp_seed
		key_release_statement: String = render_transferred_value_release(
			key_tmp,
			args.key_transfers_ownership,
		)
		value_release_statement: String = render_transferred_value_release(
			value_tmp,
			args.value_transfers_ownership,
		)

		" { void* " + key_tmp + " = " + args.key + "; void* " + value_tmp + " = " + args.value + "; " + dict_tmp + " = blorp_dict_insert(" + dict_tmp + ", " + key_tmp + ", " + value_tmp + ");" + key_release_statement + value_release_statement + " }"
	else:
		" ${dict_tmp} = blorp_dict_insert(${dict_tmp}, ${args.key}, ${args.value});"


private pure func render_dict_iter_header(args: DictIterHeaderArgs) -> String:
	render_prepared_backend_op_sequence([BackendDictIterSourceBinding({
			dict = args.dict,
			source = args.source,
		}), BackendDictIterLoopOpen({
			index = args.index,
			dict = args.dict,
		})])


private pure func render_dict_construct_with_body(args: DictConstructWithBodyArgs) -> String:
	dict_tmp: String = dict_construct_tmp(args.temp_seed)
	c_statement_expr(
		"blorp_Dict* ${dict_tmp} = ${args.ctor};${args.release_init}${args.insert_statements} ${dict_tmp};",
	)


private pure func render_set_iter_header(args: SetIterHeaderArgs) -> String:
	render_prepared_backend_op_sequence([BackendSetIterSourceBinding({
			set = args.set,
			source = args.source,
		}), BackendSetIterRetain(args.set), BackendSetIterLoopOpen({
			entry = args.entry,
			set = args.set,
		})])


private pure func render_string_byte_read(source: String, index: String) -> String:
	"(long)(unsigned char)((blorp_String*)" + source + ")->data[" + index + "]"


private pure func render_string_byte_write(target: String, index: String, byte: String) -> String:
	"(((blorp_String*)" + target + ")->data[" + index + "] = (char)" + byte + ")"


private pure func render_string_find_byte_from(args: StringFindByteFromArgs) -> String:
	source_tmp: String = "__string_find_src_" + args.temp_seed
	byte_tmp: String = "__string_find_byte_" + args.temp_seed
	start_tmp: String = "__string_find_start_" + args.temp_seed
	bind_source: String = "blorp_String* " + source_tmp + " = (blorp_String*)" + args.source + ";"
	bind_byte: String = "long " + byte_tmp + " = " + args.byte + ";"
	bind_start: String = "long " + start_tmp + " = " + args.start + ";"
	call: String = "blorp_string_find_byte_from(" + source_tmp + ", " + byte_tmp + ", " + start_tmp + ");"
	body: String = bind_source + " " + bind_byte + " " + bind_start + " " + call
	"({ " + body + " })"


private pure func render_string_byte_copy(args: StringByteCopyArgs) -> String:
	dst_tmp: String = "__string_copy_dst_" + args.temp_seed
	dst_pos_tmp: String = "__string_copy_dst_pos_" + args.temp_seed
	src_tmp: String = "__string_copy_src_" + args.temp_seed
	src_pos_tmp: String = "__string_copy_src_pos_" + args.temp_seed
	len_tmp: String = "__string_copy_len_" + args.temp_seed
	bind_dst: String = "blorp_String* " + dst_tmp + " = (blorp_String*)" + args.dst + ";"
	bind_dst_pos: String = "long " + dst_pos_tmp + " = " + args.dst_pos + ";"
	bind_src: String = "blorp_String* " + src_tmp + " = (blorp_String*)" + args.src + ";"
	bind_src_pos: String = "long " + src_pos_tmp + " = " + args.src_pos + ";"
	bind_len: String = "long " + len_tmp + " = " + args.len + ";"
	copy_template: String = raw
		|if (@LEN@ > 0) { memcpy(@DST@->data + @DST_POS@,
		|@SRC@->data + @SRC_POS@, (size_t)@LEN@); }
	copy: String = c_one_line(copy_template)
		.replace("@LEN@", len_tmp)
		.replace("@DST@", dst_tmp)
		.replace("@DST_POS@", dst_pos_tmp)
		.replace("@SRC@", src_tmp)
		.replace("@SRC_POS@", src_pos_tmp)
	body: String = bind_dst + " " + bind_dst_pos + " " + bind_src + " " + bind_src_pos + " " + bind_len + " " + copy + " (void)0;"
	"({ " + body + " })"


private pure func render_string_set_len(target: String, len: String) -> String:
	body: String = "blorp_String* __sl = (blorp_String*)" + target + "; long __sn = " + len + "; __sl->len = __sn; __sl->data[__sn] = '\\0'; (void)0;"
	"({ " + body + " })"


private pure func render_channel_with_elem_release(args: ChannelWithElemReleaseArgs) -> String:
	channel_tmp: String = "__ch_" + args.temp_seed
	capacity: String = args.capacity
	statements: List[String] = [
		"blorp_Channel* " + channel_tmp + " = blorp_channel_new(" + capacity + ");",
		"blorp_channel_init_elem_release(" + channel_tmp + ", blorp_elem_release_fn);",
		channel_tmp + ";",
	]

	"({ " + statements.join(" ") + " })"


private pure func channel_retaining_send_runtime_name(
	runtime: ChannelRetainingSendRuntime,
) -> String:
	match runtime:
		ChannelSendRuntime:
			"blorp_channel_send"
		ChannelTrySendRuntime:
			"blorp_channel_try_send"
		ChannelTrySendStatusRuntime:
			"blorp_channel_try_send_status"


private pure func channel_retaining_send_timeout_runtime_name(
	runtime: ChannelRetainingSendTimeoutRuntime,
) -> String:
	match runtime:
		ChannelSendTimeoutRuntime:
			"blorp_channel_send_timeout"
		ChannelSendTimeoutStatusRuntime:
			"blorp_channel_send_timeout_status"


private pure func render_channel_retaining_send_base(
	function_name: String,
	result_type: String,
	channel: String,
	value: String,
	timeout_suffix: String,
	temp_seed: String,
) -> String:
	value_tmp: String = "__chan_send_value_" + temp_seed
	cleanup_tmp: String = "__chan_send_cleanup_" + temp_seed
	result_tmp: String = "__chan_send_result_" + temp_seed
	cleanup_push: String =
		|blorp_task_cleanup_push(&${cleanup_tmp}, &${value_tmp},
		|(void*)${value_tmp}, blorp_cleanup_release_arc_value);
	statements: List[String] = [
		"void* " + value_tmp + " = " + value + ";",
		"blorp_CancelCleanupFrame " + cleanup_tmp + ";",
		c_one_line(cleanup_push),
		result_type + " " + result_tmp + " = " + function_name + "(" + channel + ", " + value_tmp + timeout_suffix + ");",
		"blorp_task_cleanup_pop_slot(&" + value_tmp + ");",
		"blorp_release(" + value_tmp + ");",
		result_tmp + ";",
	]

	"({ " + statements.join(" ") + " })"


private pure func render_channel_retaining_send(
	args: ChannelRetainingSendArgs,
	runtime: ChannelRetainingSendRuntime,
) -> String:
	render_channel_retaining_send_base(
		channel_retaining_send_runtime_name(runtime),
		args.result_type,
		args.channel,
		args.value,
		"",
		args.temp_seed,
	)


private pure func render_channel_retaining_send_with_timeout(
	args: ChannelRetainingSendWithTimeoutArgs,
	runtime: ChannelRetainingSendTimeoutRuntime,
) -> String:
	render_channel_retaining_send_base(
		channel_retaining_send_timeout_runtime_name(runtime),
		args.result_type,
		args.channel,
		args.value,
		", " + args.timeout,
		args.temp_seed,
	)


private pure func channel_send_attempt_result_statements(
	result_type: String,
	status_tmp: String,
	result_tmp: String,
	constructors: ChannelSendAttemptConstructors,
) -> List[String]:
	result_assignment_template: String = raw
		|if (@STATUS@ == BLORP_CHANNEL_SEND_ACCEPTED) { @RESULT@ = @ACCEPTED@; }
		|else if (@STATUS@ == BLORP_CHANNEL_SEND_WOULD_BLOCK) { @RESULT@ = @WOULD_BLOCK@; }
		|else if (@STATUS@ == BLORP_CHANNEL_SEND_SEALED) { @RESULT@ = @SEALED@; }
		|else { @RESULT@ = @TIMED_OUT@; }
	var result_assignment: String = c_one_line(result_assignment_template)
	result_assignment = result_assignment.replace("@STATUS@", status_tmp)
	result_assignment = result_assignment.replace("@RESULT@", result_tmp)
	result_assignment = result_assignment.replace("@ACCEPTED@", constructors.accepted)
	result_assignment = result_assignment.replace("@WOULD_BLOCK@", constructors.would_block)
	result_assignment = result_assignment.replace("@SEALED@", constructors.sealed)
	result_assignment = result_assignment.replace("@TIMED_OUT@", constructors.timed_out)

	[result_type + " " + result_tmp + ";", result_assignment, result_tmp + ";"]


private pure func render_channel_send_attempt_direct(
	result_type: String,
	status_call: String,
	temp_seed: String,
	constructors: ChannelSendAttemptConstructors,
) -> String:
	status_tmp: String = "__chan_send_status_" + temp_seed
	result_tmp: String = "__chan_send_result_" + temp_seed
	statements: List[String] = [
		"long " + status_tmp + " = " + status_call + ";",
	].concat(
		channel_send_attempt_result_statements(
			result_type,
			status_tmp,
			result_tmp,
			constructors,
		),
	)

	"({ " + statements.join(" ") + " })"


private pure func render_channel_send_attempt_retained_value(
	result_type: String,
	value: String,
	status_call: String,
	temp_seed: String,
	constructors: ChannelSendAttemptConstructors,
) -> String:
	status_tmp: String = "__chan_send_status_" + temp_seed
	result_tmp: String = "__chan_send_result_" + temp_seed
	value_tmp: String = "__chan_send_value_" + temp_seed
	cleanup_tmp: String = "__chan_send_cleanup_" + temp_seed
	cleanup_push: String =
		|blorp_task_cleanup_push(&${cleanup_tmp}, &${value_tmp},
		|(void*)${value_tmp}, blorp_cleanup_release_arc_value);
	prefix: List[String] = [
		"void* " + value_tmp + " = " + value + ";",
		"blorp_CancelCleanupFrame " + cleanup_tmp + ";",
		c_one_line(cleanup_push),
		"long " + status_tmp + " = " + status_call + ";",
		"blorp_task_cleanup_pop_slot(&" + value_tmp + ");",
		"blorp_release(" + value_tmp + ");",
	]
	statements: List[String] = prefix.concat(
		channel_send_attempt_result_statements(
			result_type,
			status_tmp,
			result_tmp,
			constructors,
		),
	)

	"({ " + statements.join(" ") + " })"


private pure func render_channel_try_send_attempt(args: ChannelTrySendAttemptArgs) -> String:
	status_call: String = "blorp_channel_try_send_status(" + args.channel + ", " + args.value + ")"

	render_channel_send_attempt_direct(
		args.result_type,
		status_call,
		args.temp_seed,
		args.constructors,
	)


private pure func render_channel_try_send_attempt_retained_value(
	args: ChannelTrySendAttemptArgs,
) -> String:
	value_tmp: String = "__chan_send_value_" + args.temp_seed
	status_call: String = "blorp_channel_try_send_status(" + args.channel + ", " + value_tmp + ")"

	render_channel_send_attempt_retained_value(
		args.result_type,
		args.value,
		status_call,
		args.temp_seed,
		args.constructors,
	)


private pure func render_channel_send_timeout_attempt(
	args: ChannelSendTimeoutAttemptArgs,
) -> String:
	status_call: String = "blorp_channel_send_timeout_status(" + args.channel + ", " + args.value + ", " + args.timeout + ")"

	render_channel_send_attempt_direct(
		args.result_type,
		status_call,
		args.temp_seed,
		args.constructors,
	)


private pure func render_channel_send_timeout_attempt_retained_value(
	args: ChannelSendTimeoutAttemptArgs,
) -> String:
	value_tmp: String = "__chan_send_value_" + args.temp_seed
	status_call: String = "blorp_channel_send_timeout_status(" + args.channel + ", " + value_tmp + ", " + args.timeout + ")"

	render_channel_send_attempt_retained_value(
		args.result_type,
		args.value,
		status_call,
		args.temp_seed,
		args.constructors,
	)


private pure func channel_recv_release_mask(policy: ChannelRecvReleasePolicy) -> String:
	match policy:
		KeepChannelRecvValue:
			"0"
		ReleaseChannelRecvValue:
			"1"


private pure func channel_recv_attempt_result_statements(
	result_type: String,
	value_tmp: String,
	status_tmp: String,
	result_tmp: String,
	release_policy: ChannelRecvReleasePolicy,
	constructors: ChannelRecvAttemptConstructors,
) -> List[String]:
	release_mask: String = channel_recv_release_mask(release_policy)
	result_assignment_template: String = raw
		|if (@STATUS@ == BLORP_CHANNEL_RECV_VALUE) { @RESULT@ = @VALUE_CTOR@(@VALUE@, @RELEASE_MASK@UL); }
		|else if (@STATUS@ == BLORP_CHANNEL_RECV_SEALED) { @RESULT@ = @SEALED@; }
		|else { @RESULT@ = @EMPTY@; }
	var result_assignment: String = c_one_line(result_assignment_template)
	result_assignment = result_assignment.replace("@STATUS@", status_tmp)
	result_assignment = result_assignment.replace("@RESULT@", result_tmp)
	result_assignment = result_assignment.replace("@VALUE_CTOR@", constructors.value)
	result_assignment = result_assignment.replace("@VALUE@", value_tmp)
	result_assignment = result_assignment.replace("@RELEASE_MASK@", release_mask)
	result_assignment = result_assignment.replace("@SEALED@", constructors.sealed)
	result_assignment = result_assignment.replace("@EMPTY@", constructors.empty)

	[result_type + " " + result_tmp + ";", result_assignment, result_tmp + ";"]


private pure func channel_recv_attempt_result_statements_no_release_mask(
	result_type: String,
	value_tmp: String,
	status_tmp: String,
	result_tmp: String,
	constructors: ChannelRecvAttemptConstructors,
) -> List[String]:
	result_assignment_template: String = raw
		|if (@STATUS@ == BLORP_CHANNEL_RECV_VALUE) { @RESULT@ = @VALUE_CTOR@(@VALUE@); }
		|else if (@STATUS@ == BLORP_CHANNEL_RECV_SEALED) { @RESULT@ = @SEALED@; }
		|else { @RESULT@ = @EMPTY@; }
	var result_assignment: String = c_one_line(result_assignment_template)
	result_assignment = result_assignment.replace("@STATUS@", status_tmp)
	result_assignment = result_assignment.replace("@RESULT@", result_tmp)
	result_assignment = result_assignment.replace("@VALUE_CTOR@", constructors.value)
	result_assignment = result_assignment.replace("@VALUE@", value_tmp)
	result_assignment = result_assignment.replace("@SEALED@", constructors.sealed)
	result_assignment = result_assignment.replace("@EMPTY@", constructors.empty)

	[result_type + " " + result_tmp + ";", result_assignment, result_tmp + ";"]


private pure func render_channel_try_recv_attempt(args: ChannelTryRecvAttemptArgs) -> String:
	value_tmp: String = "__chan_recv_value_" + args.temp_seed
	status_tmp: String = "__chan_recv_status_" + args.temp_seed
	result_tmp: String = "__chan_recv_result_" + args.temp_seed
	statements: List[String] = [
		"void* " + value_tmp + " = NULL;",
		"long " + status_tmp + " = blorp_channel_try_recv_status_raw((blorp_Channel*)" + args.channel + ", &" + value_tmp + ");",
	].concat(
		channel_recv_attempt_result_statements(
			args.result_type,
			value_tmp,
			status_tmp,
			result_tmp,
			args.release_policy,
			args.constructors,
		),
	)

	"({ " + statements.join(" ") + " })"


