	statements: List[String] = [
		"void* " + value_tmp + " = NULL;",
		"long " + status_tmp + " = blorp_channel_try_recv_status_raw((blorp_Channel*)" + args.channel + ", &" + value_tmp + ");",
	].concat(
		channel_recv_attempt_result_statements_no_release_mask(
			args.result_type,
			value_tmp,
			status_tmp,
