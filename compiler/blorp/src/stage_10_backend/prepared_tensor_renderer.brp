-- C renderer helpers for prepared tensor Core nodes.
--
-- `emit.brp` owns traversal, child expression emission, ABI strings, and
-- fresh temp seeds. This module owns the final C snippet shape and local temp
-- names for prepared tensor raw-view access and allocation helpers.
private enum StorageCheckKind:
	WordStorageKind
	F64StorageKind
	F32StorageKind
	I64StorageKind


private enum RawScalarKind:
	F64RawScalarKind
	F32RawScalarKind


-- These payloads carry rendered C snippets and ABI strings. They are records
-- because Blorp structs cannot contain String fields.
record RawViewDeclArgs {
	pointer_c_type: String,
	view: String,
	source: String
}


record RawWriteArgs {
	view: String,
	index: String,
	value: String
}


record StorageCheckArgs {
	tensor: String,
	temp_seed: String
}


record TensorIndexArgs {
	tensor: String,
	index: String
}


record InlineStructGetArgs {
	tensor: String,
	index: String,
	temp_seed: String,
	struct_ty: String
}


record InlineStructElementDeclArgs {
	binding: String,
	tensor: String,
	index: String,
	temp_seed: String,
	struct_ty: String
}


record InlineStructMatrixGetCheckedArgs {
	tensor: String,
	row: String,
	col: String,
	temp_seed: String,
	struct_ty: String
}


record StackOptionVectorValueRecordGetArgs {
	tensor: String,
	index: String,
	temp_seed: String,
	option_c_type: String,
	payload_c_type: String,
	none_value: String
}


record StackOptionVectorScalarGetArgs {
	tensor: String,
	index: String,
	temp_seed: String,
	option_c_type: String,
	none_value: String
}


record StackOptionMatrixValueRecordGetArgs {
	tensor: String,
	row: String,
	col: String,
	temp_seed: String,
	option_c_type: String,
	payload_c_type: String,
	none_value: String
}


record StackOptionMatrixScalarGetArgs {
	tensor: String,
	row: String,
	col: String,
	temp_seed: String,
	option_c_type: String,
	none_value: String
}


record RawScalarGetUncheckedArgs {
	tensor: String,
	index: String,
	temp_seed: String
}


record TensorAllocPackedArgs {
	size: String,
	elem_size: String
}


record TensorAllocSizedArgs {
	size: String,
	struct_ty: String
}


record TensorAllocWithReleaseArgs {
	alloc_expr: String,
	temp_seed: String
}


record TensorFillInlineStructArgs {
	function_name: String,
	value: String,
	dim_bindings: String,
	dim_args: String,
	temp_seed: String,
	struct_ty: String
}


record TensorFillBoxedArgs {
	function_name: String,
	value: String,
	dim_args: String,
	temp_seed: String
}


record TensorFillDimBindArgs {
	temp_seed: String,
	dim_index: String,
	dim_value: String
}


record TensorFillDimNameArgs {
	temp_seed: String,
	dim_index: String
}


record TensorFillRawScalarArgs {
	dim_bindings: String,
	total_expr: String,
	value_c_type: String,
	value: String,
	alloc_expr: String,
	temp_seed: String
}


record TensorFillPackedArgs {
	dim_bindings: String,
	total_expr: String,
	value: String,
	alloc_expr: String,
	temp_seed: String
}


record TensorRankedAllocArgs {
	first_dim: String,
	total_dim: String
}


record TensorRankedAllocPackedArgs {
	first_dim: String,
	total_dim: String,
	elem_size: String
}


record TensorRankedAllocSizedArgs {
	first_dim: String,
	total_dim: String,
	struct_ty: String
}


record TensorLiteralWriteArgs {
	tensor: String,
	index: String,
	value: String
}


record TensorLiteralConstructArgs {
	tensor: String,
	alloc_expr: String,
	statements: String
}


record TensorLiteralInlineStructWriteArgs {
	tensor: String,
	index: String,
	value: String,
	temp_seed: String,
	struct_ty: String
}


record TensorLiteralBoxedSeededWriteArgs {
	tensor: String,
	index: String,
	value: String,
	temp_seed: String
}


union PreparedTensorOp:
	RawViewDecl(RawViewDeclArgs)
	RawRead(String, String)
	RawWriteExpr(RawWriteArgs)
	RawWriteStmt(RawWriteArgs)
	WordStorageCheck(StorageCheckArgs)
	F64StorageCheck(StorageCheckArgs)
	F32StorageCheck(StorageCheckArgs)
	I64StorageCheck(StorageCheckArgs)
	TensorStorageModePointer
	TensorStorageModeF64
	TensorStorageModeF32
	TensorStorageModeI64
	TensorStorageModeInline
	TensorElementSizePointer
	TensorElementSizeF64
	TensorElementSizeF32
	TensorElementSizeI64
	TensorElementSizeInlineStruct(String)
	TensorCallbackResultBoxedStruct
	TensorCallbackResultBoxedFloat
	TensorCallbackResultBoxedFloat32
	TensorCallbackResultBits
	DataPointerGetUnchecked(TensorIndexArgs)
	InlineStructGetUnchecked(InlineStructGetArgs)
	InlineStructElementDecl(InlineStructElementDeclArgs)
	InlineStructGetChecked(InlineStructGetArgs)
	InlineStructMatrixGetChecked(InlineStructMatrixGetCheckedArgs)
	StackOptionVectorValueRecordGet(StackOptionVectorValueRecordGetArgs)
	StackOptionVectorLongGet(StackOptionVectorScalarGetArgs)
	StackOptionVectorInt128Get(StackOptionVectorScalarGetArgs)
	StackOptionVectorUInt128Get(StackOptionVectorScalarGetArgs)
	StackOptionMatrixValueRecordGet(StackOptionMatrixValueRecordGetArgs)
	StackOptionMatrixLongGet(StackOptionMatrixScalarGetArgs)
	StackOptionMatrixInt128Get(StackOptionMatrixScalarGetArgs)
	StackOptionMatrixUInt128Get(StackOptionMatrixScalarGetArgs)
	F64RawGetUnchecked(RawScalarGetUncheckedArgs)
	F32RawGetUnchecked(RawScalarGetUncheckedArgs)
	TensorAllocPointer(String)
	TensorAllocI64(String)
	TensorAllocF64(String)
	TensorAllocF32(String)
	TensorAllocPacked(TensorAllocPackedArgs)
	TensorAllocSized(TensorAllocSizedArgs)
	TensorAllocWithRelease(TensorAllocWithReleaseArgs)
	TensorFillInlineStruct(TensorFillInlineStructArgs)
	TensorFillBoxed(TensorFillBoxedArgs)
	TensorFillBoxedReleaseValue(TensorFillBoxedArgs)
	TensorFillDimName(TensorFillDimNameArgs)
	TensorFillTotalName(String)
	TensorFillDimBind(TensorFillDimBindArgs)
	TensorFillDimArg(String)
	TensorFillProductExpr(String, String)
	TensorFillRawScalar(TensorFillRawScalarArgs)
	TensorFillPacked(TensorFillPackedArgs)
	TensorInitElemRelease(String)
	TensorRankedAllocPointer(TensorRankedAllocArgs)
	TensorRankedAllocI64(TensorRankedAllocArgs)
	TensorRankedAllocF64(TensorRankedAllocArgs)
	TensorRankedAllocF32(TensorRankedAllocArgs)
	TensorRankedAllocPacked(TensorRankedAllocPackedArgs)
	TensorRankedAllocSized(TensorRankedAllocSizedArgs)
	TensorLiteralName(String)
	TensorLiteralConstruct(TensorLiteralConstructArgs)
	TensorLiteralF32Write(TensorLiteralWriteArgs)
	TensorLiteralF64Write(TensorLiteralWriteArgs)
	TensorLiteralI64Write(TensorLiteralWriteArgs)
	TensorLiteralWordWrite(TensorLiteralWriteArgs)
	TensorLiteralPackedWrite(TensorLiteralWriteArgs)
	TensorLiteralInlineStructWrite(TensorLiteralInlineStructWriteArgs)
	TensorLiteralBoxedWrite(TensorLiteralWriteArgs)
	TensorLiteralBoxedOwnedWrite(TensorLiteralBoxedSeededWriteArgs)
	TensorLiteralBoxedBorrowedWrite(TensorLiteralBoxedSeededWriteArgs)


private OPEN_BRACE: String = "{"

private CLOSE_BRACE: String = "}"

private TENSOR_STORAGE_MODE_POINTER: String = "BLORP_VECTOR_STORAGE_POINTER"

private TENSOR_STORAGE_MODE_F64: String = "BLORP_VECTOR_STORAGE_F64"

private TENSOR_STORAGE_MODE_F32: String = "BLORP_VECTOR_STORAGE_F32"

private TENSOR_STORAGE_MODE_I64: String = "BLORP_VECTOR_STORAGE_I64"

private TENSOR_STORAGE_MODE_INLINE: String = "BLORP_VECTOR_STORAGE_INLINE"

private TENSOR_ELEMENT_SIZE_POINTER: String = "sizeof(void*)"

private TENSOR_ELEMENT_SIZE_F64: String = "sizeof(double)"

private TENSOR_ELEMENT_SIZE_F32: String = "sizeof(float)"

private TENSOR_ELEMENT_SIZE_I64: String = "sizeof(long)"

private TENSOR_CALLBACK_RESULT_BOXED_STRUCT: String = "BLORP_VECTOR_CALLBACK_BOXED_STRUCT"

private TENSOR_CALLBACK_RESULT_BOXED_FLOAT: String = "BLORP_VECTOR_CALLBACK_BOXED_FLOAT"

private TENSOR_CALLBACK_RESULT_BOXED_FLOAT32: String = "BLORP_VECTOR_CALLBACK_BOXED_FLOAT32"

private TENSOR_CALLBACK_RESULT_BITS: String = "BLORP_VECTOR_CALLBACK_BITS"


private pure func c_block(body: String) -> String:
	OPEN_BRACE + " " + body + " " + CLOSE_BRACE


private pure func c_statement_expr(body: String) -> String:
	"(" + c_block(body) + ")"


pure func render_tensor_raw_view_decl(
	pointer_c_type: String,
	view: String,
	source: String,
) -> String:
	"${pointer_c_type} ${view} = (${pointer_c_type})((blorp_Vector*)${source})->data"


pure func render_tensor_raw_read(view: String, index: String) -> String:
	"${view}[${index}]"


pure func render_tensor_raw_write_expr(view: String, index: String, value: String) -> String:
	c_statement_expr("${view}[${index}] = ${value}; (void)0;")


pure func render_tensor_raw_write_stmt(view: String, index: String, value: String) -> String:
	"${view}[${index}] = ${value};"


private pure func storage_check_mode(kind: StorageCheckKind) -> String:
	match kind:
		WordStorageKind:
			TENSOR_STORAGE_MODE_POINTER
		F64StorageKind:
			TENSOR_STORAGE_MODE_F64
		F32StorageKind:
			TENSOR_STORAGE_MODE_F32
		I64StorageKind:
			TENSOR_STORAGE_MODE_I64


private pure func storage_check_elem_size(kind: StorageCheckKind) -> String:
	match kind:
		WordStorageKind:
			TENSOR_ELEMENT_SIZE_POINTER
		F64StorageKind:
			TENSOR_ELEMENT_SIZE_F64
		F32StorageKind:
			TENSOR_ELEMENT_SIZE_F32
		I64StorageKind:
			TENSOR_ELEMENT_SIZE_I64


private pure func storage_check_extra_condition(
	kind: StorageCheckKind,
	vector_tmp: String,
) -> String:
	match kind:
		WordStorageKind:
			" && ${vector_tmp}->elem_release == NULL"
		F64StorageKind:
			""
		F32StorageKind:
			""
		I64StorageKind:
			""


private pure func render_storage_check(args: StorageCheckArgs, kind: StorageCheckKind) -> String:
	vector_tmp: String = "__tensor_layout_${args.temp_seed}"
	mode: String = storage_check_mode(kind)
	elem_size: String = storage_check_elem_size(kind)
	extra_condition: String = storage_check_extra_condition(kind, vector_tmp)
	vector_bind: String = "blorp_Vector* ${vector_tmp} = (blorp_Vector*)${args.tensor};"
	check: String = "${vector_tmp} && ${vector_tmp}->storage_mode == ${mode} && ${vector_tmp}->elem_size == (int16_t)${elem_size}${extra_condition};"

	c_statement_expr(vector_bind + " " + check)


private pure func render_inline_struct_load_body(
	vector_tmp: String,
	index_tmp: String,
	out_tmp: String,
	raw_tmp: String,
	struct_ty: String,
) -> String:
	inline_condition: String = "if (__builtin_expect(${vector_tmp}->storage_mode == BLORP_VECTOR_STORAGE_INLINE && ${vector_tmp}->elem_size == sizeof(${struct_ty}), 1)) "
	inline_copy: String = "memcpy(&${out_tmp}, (char*)${vector_tmp}->data + ${index_tmp} * sizeof(${struct_ty}), sizeof(${struct_ty}));"
	fallback_get: String = "void* ${raw_tmp} = ${vector_tmp}->data[${index_tmp}];"
	fallback_unbox: String = "${out_tmp} = blorp_unbox_struct(${raw_tmp}, ${struct_ty});"
	inline_branch: String = c_block(inline_copy)
	fallback_branch: String = c_block(fallback_get + " " + fallback_unbox)

	inline_condition + inline_branch + " else " + fallback_branch


private pure func render_inline_struct_get_unchecked(args: InlineStructGetArgs) -> String:
	vector_tmp: String = "__tgu_vec_${args.temp_seed}"
	index_tmp: String = "__tgu_idx_${args.temp_seed}"
	out_tmp: String = "__tgu_out_${args.temp_seed}"
	raw_tmp: String = "__tgu_raw_${args.temp_seed}"
	vector_bind: String = "blorp_Vector* ${vector_tmp} = (blorp_Vector*)${args.tensor};"
	index_bind: String = "long ${index_tmp} = ${args.index};"
	out_decl: String = "${args.struct_ty} ${out_tmp};"
	load_body: String = render_inline_struct_load_body(
		vector_tmp,
		index_tmp,
		out_tmp,
		raw_tmp,
		args.struct_ty,
	)

	c_statement_expr(
		vector_bind + " " + index_bind + " " + out_decl + " " + load_body + " " + out_tmp + ";",
	)


private pure func render_inline_struct_element_decl(args: InlineStructElementDeclArgs) -> String:
	value: String = render_inline_struct_get_unchecked({
		tensor = args.tensor,
		index = args.index,
		temp_seed = args.temp_seed,
		struct_ty = args.struct_ty,
	})

	"${args.struct_ty} ${args.binding} = ${value};"


private pure func render_inline_struct_get_checked(args: InlineStructGetArgs) -> String:
	vector_tmp: String = "__tg_vec_${args.temp_seed}"
	index_tmp: String = "__tg_idx_${args.temp_seed}"
	out_tmp: String = "__tg_out_${args.temp_seed}"
	raw_tmp: String = "__tg_raw_${args.temp_seed}"
	vector_bind: String = "blorp_Vector* ${vector_tmp} = (blorp_Vector*)${args.tensor};"
	index_bind: String = "long ${index_tmp} = ${args.index};"
	normalize_index: String = "if (${index_tmp} < 0 && ${vector_tmp}) ${index_tmp} += ${vector_tmp}->len;"
	out_decl: String = "${args.struct_ty} ${out_tmp} = {0};"
	bounds_condition: String = "if (__builtin_expect(${vector_tmp} && ${index_tmp} >= 0 && ${index_tmp} < ${vector_tmp}->len, 1)) "
	load_body: String = render_inline_struct_load_body(
		vector_tmp,
		index_tmp,
		out_tmp,
		raw_tmp,
		args.struct_ty,
	)

	c_statement_expr(
		vector_bind + " " + index_bind + " " + normalize_index + " " + out_decl + " " + bounds_condition + c_block(
			load_body,
		) + " " + out_tmp + ";",
	)


private pure func render_inline_struct_matrix_get_checked(
	args: InlineStructMatrixGetCheckedArgs,
) -> String:
	vector_tmp: String = "__tgm_vec_${args.temp_seed}"
	row_tmp: String = "__tgm_row_${args.temp_seed}"
	col_tmp: String = "__tgm_col_${args.temp_seed}"
	cols_tmp: String = "__tgm_cols_${args.temp_seed}"
	index_tmp: String = "__tgm_idx_${args.temp_seed}"
	out_tmp: String = "__tgm_out_${args.temp_seed}"
	raw_tmp: String = "__tgm_raw_${args.temp_seed}"
	vector_bind: String = "blorp_Vector* ${vector_tmp} = (blorp_Vector*)${args.tensor};"
	row_bind: String = "long ${row_tmp} = ${args.row};"
	col_bind: String = "long ${col_tmp} = ${args.col};"
	cols_bind: String = "long ${cols_tmp} = (${vector_tmp} && ${vector_tmp}->len > 0) ? ${vector_tmp}->capacity / ${vector_tmp}->len : 0;"
	normalize_row: String = "if (${row_tmp} < 0 && ${vector_tmp}) ${row_tmp} += ${vector_tmp}->len;"
	normalize_col: String = "if (${col_tmp} < 0) ${col_tmp} += ${cols_tmp};"
	index_bind: String = "long ${index_tmp} = ${row_tmp} * ${cols_tmp} + ${col_tmp};"
	out_decl: String = "${args.struct_ty} ${out_tmp} = {0};"
	bounds_condition: String = "if (__builtin_expect(${vector_tmp} && ${row_tmp} >= 0 && ${col_tmp} >= 0 && ${index_tmp} >= 0 && ${row_tmp} < ${vector_tmp}->len && ${col_tmp} < ${cols_tmp} && ${index_tmp} < ${vector_tmp}->capacity, 1)) "
	load_body: String = render_inline_struct_load_body(
		vector_tmp,
		index_tmp,
		out_tmp,
		raw_tmp,
		args.struct_ty,
	)

	c_statement_expr(
		vector_bind + " " + row_bind + " " + col_bind + " " + cols_bind + " " + normalize_row + " " + normalize_col + " " + index_bind + " " + out_decl + " " + bounds_condition + c_block(
			load_body,
		) + " " + out_tmp + ";",
	)


private pure func stack_option_vector_tmp(temp_seed: String) -> String:
	"__gso_vec_${temp_seed}"


private pure func stack_option_matrix_tmp(temp_seed: String) -> String:
	"__gso_mat_${temp_seed}"


private pure func stack_option_index_tmp(temp_seed: String) -> String:
	"__gso_idx_${temp_seed}"


private pure func stack_option_raw_tmp(temp_seed: String) -> String:
	"__gso_raw_${temp_seed}"


private pure func stack_option_payload_tmp(temp_seed: String) -> String:
	"__gso_payload_${temp_seed}"


private pure func stack_option_result_tmp(temp_seed: String) -> String:
	"__gso_result_${temp_seed}"


private pure func render_stack_option_none_assignment(
	result_tmp: String,
	option_c_type: String,
	none_value: String,
) -> String:
	"${result_tmp} = ((${option_c_type}){ .tag = BLORP_TAG_NONE, .value = ${none_value} });"


private pure func render_stack_option_some_assignment(
	result_tmp: String,
	option_c_type: String,
	payload_expr: String,
) -> String:
	"${result_tmp} = ((${option_c_type}){ .tag = BLORP_TAG_SOME, .value = ${payload_expr} });"


private pure func render_stack_option_value_record_some_body(
	vector_tmp: String,
	index_tmp: String,
	raw_tmp: String,
	payload_tmp: String,
	result_tmp: String,
	option_c_type: String,
	payload_c_type: String,
) -> String:
	inline_condition: String = "if (${vector_tmp}->storage_mode == BLORP_VECTOR_STORAGE_INLINE) "
	payload_decl: String = "${payload_c_type} ${payload_tmp};"
	inline_copy: String = "memcpy(&${payload_tmp}, (char*)${vector_tmp}->data + ${index_tmp} * ${vector_tmp}->elem_size, sizeof(${payload_c_type}));"
	inline_some: String = render_stack_option_some_assignment(
		result_tmp,
		option_c_type,
		payload_tmp,
	)
	fallback_get: String = "void* ${raw_tmp} = ${vector_tmp}->data[${index_tmp}];"
	fallback_payload: String = "blorp_unbox_struct(${raw_tmp}, ${payload_c_type})"
	fallback_some: String = render_stack_option_some_assignment(
		result_tmp,
		option_c_type,
		fallback_payload,
	)
	inline_branch: String = c_block(payload_decl + " " + inline_copy + " " + inline_some)
	fallback_branch: String = c_block(fallback_get + " " + fallback_some)

	inline_condition + inline_branch + " else " + fallback_branch


private pure func render_stack_option_long_some_body(
	vector_tmp: String,
	index_tmp: String,
	result_tmp: String,
	option_c_type: String,
) -> String:
	payload_expr: String = "blorp_vector_read_i64(${vector_tmp}, ${index_tmp})"
	render_stack_option_some_assignment(result_tmp, option_c_type, payload_expr)


private pure func render_stack_option_erased_some_body(
	vector_tmp: String,
	index_tmp: String,
	raw_tmp: String,
	result_tmp: String,
	option_c_type: String,
	unbox_fn: String,
) -> String:
	raw_get: String = "void* ${raw_tmp} = ${vector_tmp}->data[${index_tmp}];"
	payload_expr: String = "${unbox_fn}(${raw_tmp})"
	some_assignment: String = render_stack_option_some_assignment(
		result_tmp,
		option_c_type,
		payload_expr,
	)

	raw_get + " " + some_assignment


private pure func render_stack_option_vector_shell(
	tensor: String,
	index: String,
	temp_seed: String,
	option_c_type: String,
	none_value: String,
	some_body: String,
) -> String:
	vector_tmp: String = stack_option_vector_tmp(temp_seed)
	index_tmp: String = stack_option_index_tmp(temp_seed)
	result_tmp: String = stack_option_result_tmp(temp_seed)
	vector_bind: String = "blorp_Vector* ${vector_tmp} = (blorp_Vector*)${tensor};"
	index_bind: String = "long ${index_tmp} = ${index};"
	result_decl: String = "${option_c_type} ${result_tmp};"
	bounds_condition: String = "if (!${vector_tmp} || ${index_tmp} < 0 || ${index_tmp} >= ${vector_tmp}->len) "
	none_body: String = render_stack_option_none_assignment(result_tmp, option_c_type, none_value)

	c_statement_expr(
		vector_bind + " " + index_bind + " " + result_decl + " " + bounds_condition + c_block(
			none_body,
		) + " else " + c_block(some_body) + " " + result_tmp + ";",
	)


private pure func render_stack_option_matrix_shell(
	tensor: String,
	row: String,
	col: String,
	temp_seed: String,
	option_c_type: String,
	none_value: String,
	some_body: String,
) -> String:
	vector_tmp: String = stack_option_matrix_tmp(temp_seed)
	row_tmp: String = "__gso_row_${temp_seed}"
	col_tmp: String = "__gso_col_${temp_seed}"
	cols_tmp: String = "__gso_cols_${temp_seed}"
	index_tmp: String = stack_option_index_tmp(temp_seed)
	result_tmp: String = stack_option_result_tmp(temp_seed)
	vector_bind: String = "blorp_Vector* ${vector_tmp} = (blorp_Vector*)${tensor};"
	row_bind: String = "long ${row_tmp} = ${row};"
	col_bind: String = "long ${col_tmp} = ${col};"
	cols_bind: String = "long ${cols_tmp} = (${vector_tmp} && ${vector_tmp}->len > 0) ? ${vector_tmp}->capacity / ${vector_tmp}->len : 0;"
	index_bind: String = "long ${index_tmp} = ${row_tmp} * ${cols_tmp} + ${col_tmp};"
	result_decl: String = "${option_c_type} ${result_tmp};"
	bounds_condition: String = "if (!${vector_tmp} || ${row_tmp} < 0 || ${col_tmp} < 0 || ${index_tmp} < 0 || ${index_tmp} >= ${vector_tmp}->capacity) "
	none_body: String = render_stack_option_none_assignment(result_tmp, option_c_type, none_value)

	c_statement_expr(
		vector_bind + " " + row_bind + " " + col_bind + " " + cols_bind + " " + index_bind + " " + result_decl + " " + bounds_condition + c_block(
			none_body,
		) + " else " + c_block(some_body) + " " + result_tmp + ";",
	)


private pure func render_stack_option_vector_value_record_get(
	args: StackOptionVectorValueRecordGetArgs,
) -> String:
	vector_tmp: String = stack_option_vector_tmp(args.temp_seed)
	index_tmp: String = stack_option_index_tmp(args.temp_seed)
	raw_tmp: String = stack_option_raw_tmp(args.temp_seed)
	payload_tmp: String = stack_option_payload_tmp(args.temp_seed)
	result_tmp: String = stack_option_result_tmp(args.temp_seed)
	some_body: String = render_stack_option_value_record_some_body(
		vector_tmp,
		index_tmp,
		raw_tmp,
		payload_tmp,
		result_tmp,
		args.option_c_type,
		args.payload_c_type,
	)

	render_stack_option_vector_shell(
		args.tensor,
		args.index,
		args.temp_seed,
		args.option_c_type,
		args.none_value,
		some_body,
	)


private pure func render_stack_option_vector_long_get(
	args: StackOptionVectorScalarGetArgs,
) -> String:
	vector_tmp: String = stack_option_vector_tmp(args.temp_seed)
	index_tmp: String = stack_option_index_tmp(args.temp_seed)
	result_tmp: String = stack_option_result_tmp(args.temp_seed)
	some_body: String = render_stack_option_long_some_body(
		vector_tmp,
		index_tmp,
		result_tmp,
		args.option_c_type,
	)

	render_stack_option_vector_shell(
		args.tensor,
		args.index,
		args.temp_seed,
		args.option_c_type,
		args.none_value,
		some_body,
	)


private pure func render_stack_option_vector_erased_get(
	args: StackOptionVectorScalarGetArgs,
	unbox_fn: String,
) -> String:
	vector_tmp: String = stack_option_vector_tmp(args.temp_seed)
	index_tmp: String = stack_option_index_tmp(args.temp_seed)
	raw_tmp: String = stack_option_raw_tmp(args.temp_seed)
	result_tmp: String = stack_option_result_tmp(args.temp_seed)
	some_body: String = render_stack_option_erased_some_body(
		vector_tmp,
		index_tmp,
		raw_tmp,
		result_tmp,
		args.option_c_type,
		unbox_fn,
	)

	render_stack_option_vector_shell(
		args.tensor,
		args.index,
		args.temp_seed,
		args.option_c_type,
		args.none_value,
		some_body,
	)


private pure func render_stack_option_matrix_value_record_get(
	args: StackOptionMatrixValueRecordGetArgs,
) -> String:
	vector_tmp: String = stack_option_matrix_tmp(args.temp_seed)
	index_tmp: String = stack_option_index_tmp(args.temp_seed)
	raw_tmp: String = stack_option_raw_tmp(args.temp_seed)
	payload_tmp: String = stack_option_payload_tmp(args.temp_seed)
	result_tmp: String = stack_option_result_tmp(args.temp_seed)
	some_body: String = render_stack_option_value_record_some_body(
		vector_tmp,
		index_tmp,
		raw_tmp,
		payload_tmp,
		result_tmp,
		args.option_c_type,
		args.payload_c_type,
	)

	render_stack_option_matrix_shell(
		args.tensor,
		args.row,
		args.col,
		args.temp_seed,
		args.option_c_type,
		args.none_value,
		some_body,
	)


