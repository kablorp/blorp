		args.col,
		args.temp_seed,
		args.option_c_type,
		args.none_value,
		some_body,
	)


private pure func render_stack_option_matrix_erased_get(
	args: StackOptionMatrixScalarGetArgs,
	unbox_fn: String,
) -> String:
	vector_tmp: String = stack_option_matrix_tmp(args.temp_seed)
	index_tmp: String = stack_option_index_tmp(args.temp_seed)
	raw_tmp: String = stack_option_raw_tmp(args.temp_seed)
	result_tmp: String = stack_option_result_tmp(args.temp_seed)
	some_body: String = render_stack_option_erased_some_body(
