-- C renderer helpers for prepared tuple emission.
--
-- `emit.brp` decides tuple layout details and renders child Core
-- expressions. This module owns the final C shape once those inputs are known.
record TupleConstructArgs {
	arity: String,
	args: String
}


record TupleRetainElemArgs {
	tuple: String,
	index: String
}


record TupleConstructWithRcArgs {
	tuple: String,
	arity: String,
	args: String,
	retain_statements: String,
	release_mask: String
}


record TupleFieldElementArgs {
	tuple: String,
	field: String
}


record TupleFieldAccessArgs {
	tuple: String,
	source: String,
	read: String
}


union PreparedTupleOp:
	TupleName(String)
	TupleArg(String)
	TupleConstruct(TupleConstructArgs)
	TupleRetainElem(TupleRetainElemArgs)
	TupleConstructWithRc(TupleConstructWithRcArgs)
	TupleFieldElement(TupleFieldElementArgs)
	TupleFieldAccess(TupleFieldAccessArgs)


pure func render_tuple_name(temp_seed: String) -> String:
	"__tup_" + temp_seed


pure func render_tuple_arg(value: String) -> String:
	", " + value


pure func render_tuple_construct(args: TupleConstructArgs) -> String:
	"blorp_tuple_new(" + args.arity + args.args + ")"


pure func render_tuple_retain_elem(args: TupleRetainElemArgs) -> String:
	"if (" + args.tuple + "->elem[" + args.index + "]) blorp_retain(" + args.tuple + "->elem[" + args.index + "]);"


pure func render_tuple_construct_with_rc(args: TupleConstructWithRcArgs) -> String:
	"({ blorp_Tuple* " + args.tuple + " = blorp_tuple_new(" + args.arity + args.args + "); " + args.retain_statements + " blorp_tuple_set_rc(" + args.tuple + ", " + args.release_mask + "UL); " + args.tuple + "; })"


pure func render_tuple_field_element(args: TupleFieldElementArgs) -> String:
	"((blorp_Tuple*)" + args.tuple + ")->elem[" + args.field + "]"


pure func render_tuple_field_access(args: TupleFieldAccessArgs) -> String:
	"({ void* " + args.tuple + " = (void*)" + args.source + "; " + args.read + "; })"


pure func render_prepared_tuple_op(op: PreparedTupleOp) -> String:
	match op:
		TupleName(temp_seed):
			render_tuple_name(temp_seed)
		TupleArg(value):
			render_tuple_arg(value)
		TupleConstruct(args):
			render_tuple_construct(args)
		TupleRetainElem(args):
			render_tuple_retain_elem(args)
		TupleConstructWithRc(args):
			render_tuple_construct_with_rc(args)
		TupleFieldElement(args):
			render_tuple_field_element(args)
		TupleFieldAccess(args):
			render_tuple_field_access(args)
