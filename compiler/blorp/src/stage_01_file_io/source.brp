-- Source, cursor, and span primitives for the Blorp-owned compiler frontend.
--
-- This module is deliberately separate from CoreSourceLoc. Parser spans are
-- frontend facts over source text; Core spans are lowered diagnostic metadata.
record CompilerSourceFile {
	path: String,
	module_name: String,
	text: String
}


record CompilerCursor {
	offset: Int,
	line: Int,
	column: Int
}


record CompilerSourceSpan {
	path: String,
	module_name: String,
	start_offset: Int,
	start_line: Int,
	start_column: Int,
	end_offset: Int,
	end_line: Int,
	end_column: Int
}


private COMPILER_SOURCE_TAB_WIDTH: Int = 4


pure func compiler_source_file(
	path: String,
	module_name: String,
	text: String,
) -> CompilerSourceFile:
	{
		path = path,
		module_name = module_name,
		text = text
	}


pure func compiler_source_start(_: CompilerSourceFile) -> CompilerCursor:
	{
		offset = 0,
		line = 1,
		column = 1
	}


pure func compiler_source_at_end(src: CompilerSourceFile, cursor: CompilerCursor) -> Bool:
	cursor.offset >= src.text.length()


pure func compiler_source_peek(src: CompilerSourceFile, cursor: CompilerCursor) -> Option[Char]:
	src.text.get(cursor.offset)


pure func compiler_source_advance(
	src: CompilerSourceFile,
	cursor: CompilerCursor,
) -> CompilerCursor:
	match compiler_source_peek(src, cursor):
		Some('\n'):
			next: CompilerCursor = {
				offset = cursor.offset + 1,
				line = cursor.line + 1,
				column = 1
			}
			next
		Some('\t'):
			next: CompilerCursor = {
				offset = cursor.offset + 1,
				line = cursor.line,
				column = cursor.column + (COMPILER_SOURCE_TAB_WIDTH - (cursor.column - 1) % COMPILER_SOURCE_TAB_WIDTH)
			}
			next
		Some(_):
			next: CompilerCursor = {
				offset = cursor.offset + 1,
				line = cursor.line,
				column = cursor.column + 1
			}
			next
		None:
			cursor


pure func compiler_source_cursor_at(src: CompilerSourceFile, offset: Int) -> CompilerCursor:
	target: Int = if offset < 0:
		0
	else if offset > src.text.length():
		src.text.length()
	else:
		offset

	var cursor: CompilerCursor = compiler_source_start(src)

	while cursor.offset < target:
		cursor = compiler_source_advance(src, cursor)

	cursor


pure func compiler_source_span(
	src: CompilerSourceFile,
	start_cursor: CompilerCursor,
	end_cursor: CompilerCursor,
) -> CompilerSourceSpan:
	{
		path = src.path,
		module_name = src.module_name,
		start_offset = start_cursor.offset,
		start_line = start_cursor.line,
		start_column = start_cursor.column,
		end_offset = end_cursor.offset,
		end_line = end_cursor.line,
		end_column = end_cursor.column
	}


pure func compiler_source_empty_span(
	src: CompilerSourceFile,
	cursor: CompilerCursor,
) -> CompilerSourceSpan:
	compiler_source_span(src, cursor, cursor)


pure func compiler_source_span_text(src: CompilerSourceFile, span: CompilerSourceSpan) -> String:
	src.text.substring(span.start_offset, span.end_offset - span.start_offset)


pure func compiler_source_span_label(span: CompilerSourceSpan) -> String:
	span.path + ":" + span.start_line.to_string() + ":" + span.start_column.to_string()
