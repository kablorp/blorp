				|
				|-- ============================================================================
				|-- String Checks
				|-- ============================================================================
				|---
				|Check that a string is non-empty.
				|
				|doctests:
				|    :: Empty string fails
				|    match non_empty(""):
				|        Some(_):
				|            True
				|        None:
				|            False
				|
				|    :: Non-empty string passes
				|    match non_empty("hello"):
				|        Some(_):
				|            False
				|        None:
				|            True
				|---
				|pure func non_empty(s: String) -> Option[Invalid]:
				|	if s.length() == 0:
				|		Some(PredicateErr("non_empty", "must not be empty"))
				|	else:
				|		opt: Option[Invalid] = None
				|		opt
				|
				|
				|---
				|Check that a string has at least `n` characters.
				|---
				|pure func min_len(n: Int) -> InvalidCheck[String]:
				|	pure func(s: String) -> Option[Invalid]:
				|		if s.length() < n:
				|			Some(PredicateErr("min_len", "must be at least " + n.to_string() + " characters"))
				|		else:
				|			opt: Option[Invalid] = None
				|			opt
				|
				|
				|---
				|Check that a string has at most `n` characters.
				|---
				|pure func max_len(n: Int) -> InvalidCheck[String]:
				|	pure func(s: String) -> Option[Invalid]:
				|		if s.length() > n:
				|			Some(PredicateErr("max_len", "must be at most " + n.to_string() + " characters"))
				|		else:
				|			opt: Option[Invalid] = None
				|			opt
				|
				|
				|---
				|Check that a string matches one of the allowed values.
				|---
				|pure func one_of_str(allowed: List[String]) -> InvalidCheck[String]:
				|	pure func(s: String) -> Option[Invalid]:
				|		var found: Int = 0
				|
				|		for a in allowed:
				|			if a == s:
				|				found = 1
				|
				|		if found == 1:
				|			opt: Option[Invalid] = None
				|			opt
				|		else:
				|			Some(PredicateErr("one_of", "must be one of the allowed values"))
				|
				|
				|-- ============================================================================
				|-- Numeric Checks
				|-- ============================================================================
				|---
				|Check that an integer is positive (> 0).
				|
				|doctests:
				|    :: Positive value passes
				|    match positive(5):
				|        Some(_):
				|            False
				|        None:
				|            True
				|
				|    :: Negative value fails
				|    match positive(-1):
				|        Some(_):
				|            True
				|        None:
				|            False
				|---
				|pure func positive(x: Int) -> Option[Invalid]:
				|	if x <= 0:
				|		Some(PredicateErr("positive", "must be positive"))
				|	else:
				|		opt: Option[Invalid] = None
				|		opt
				|
				|
				|---
				|Check that an integer is non-negative (>= 0).
				|---
				|pure func non_negative(x: Int) -> Option[Invalid]:
				|	if x < 0:
				|		Some(PredicateErr("non_negative", "must not be negative"))
				|	else:
				|		opt: Option[Invalid] = None
				|		opt
				|
				|
				|---
				|Check that an integer is at least `n`.
				|---
				|pure func min_val(n: Int) -> InvalidCheck[Int]:
				|	pure func(x: Int) -> Option[Invalid]:
				|		if x < n:
				|			Some(PredicateErr("min_val", "must be at least " + n.to_string()))
				|		else:
				|			opt: Option[Invalid] = None
				|			opt
				|
				|
				|---
				|Check that an integer is at most `n`.
				|---
				|pure func max_val(n: Int) -> InvalidCheck[Int]:
				|	pure func(x: Int) -> Option[Invalid]:
				|		if x > n:
				|			Some(PredicateErr("max_val", "must be at most " + n.to_string()))
				|		else:
				|			opt: Option[Invalid] = None
				|			opt
				|
				|
				|---
				|Check that an integer is within [lo, hi] inclusive.
				|---
				|pure func in_range(lo: Int, hi: Int) -> InvalidCheck[Int]:
				|	pure func(x: Int) -> Option[Invalid]:
				|		if x < lo or x > hi:
				|			Some(
				|				PredicateErr(
				|					"in_range",
				|					"must be between " + lo.to_string() + " and " + hi.to_string(),
				|				),
				|			)
				|		else:
				|			opt: Option[Invalid] = None
				|			opt
				|
				|
				|-- ============================================================================
				|-- Composition
				|-- ============================================================================
				|---
				|Build a check from a predicate function.
				|Returns None when pred returns true, PredicateErr otherwise.
				|---
				|pure func check[T](
				|	code: String,
				|	message: String,
				|	pred: pure (T) -> Bool,
				|) -> InvalidCheck[T]:
				|	pure func(value: T) -> Option[Invalid]:
				|		if pred(value):
				|			opt: Option[Invalid] = None
				|			opt
				|		else:
				|			Some(PredicateErr(code, message))
				|
				|
				|-- ============================================================================
				|-- Error Formatting
				|-- ============================================================================
				|---
				|Format an Invalid error tree as a human-readable string.
				|Path is computed by walking the tree structure.
				|
				|doctests:
				|    :: Simple predicate error
				|    format_error(PredicateErr("non_empty", "must not be empty")) == "must not be empty"
				|
				|    :: Nested error includes path
				|    format_error(
				|        GroupErrs(
				|            "name",
				|            [PredicateErr("min_len", "must be at least 3 characters")],
				|        ),
				|    ) == "name: must be at least 3 characters"
				|---
				|pure func format_error(err: Invalid) -> String:
				|	format_at(err, "")
				|
				|
				|private pure func format_at(err: Invalid, path: String) -> String:
				|	match err:
				|		TypeErr(expected, got):
				|			with_path(path, "expected " + expected + ", got " + got)
				|		PredicateErr(code, message):
				|			with_path(path, message)
				|		MissingKey(key):
				|			with_path(path, "missing required key: " + key)
				|		ExtraKeys(keys):
				|			var s: String = ""
				|			var i: Int = 0
				|
				|			for k in keys:
				|				if i > 0:
				|					s = s + ", " + k
				|				else:
				|					s = k
				|
				|				i += 1
				|
				|			with_path(path, "unexpected keys: " + s)
				|		CoercionErr(from_type, to_type):
				|			with_path(path, "cannot convert " + from_type + " to " + to_type)
				|		KeyErrs(key_pairs):
				|			var key_parts: List[String] = []
				|
				|			for kp in key_pairs:
				|				k: String = kp[0]
				|				kerr: Invalid = kp[1]
				|				kpath: String = join_path(path, k)
				|				key_parts = key_parts.append(format_at(kerr, kpath))
				|
				|			join_lines(key_parts)
				|		IndexErrs(idx_pairs):
				|			var idx_parts: List[String] = []
				|
				|			for ip in idx_pairs:
				|				idx: Int = ip[0]
				|				ierr: Invalid = ip[1]
				|				ipath: String = join_path(path, "[" + idx.to_string() + "]")
				|				idx_parts = idx_parts.append(format_at(ierr, ipath))
				|
				|			join_lines(idx_parts)
				|		UnionErrs(alts):
				|			alt_count: Int = alts.length()
				|			count: String = alt_count.to_string()
				|			with_path(path, "none of " + count + " alternatives matched")
				|		GroupErrs(name, children):
				|			gpath: String = join_path(path, name)
				|			var gparts: List[String] = []
				|
				|			for ch in children:
				|				gparts = gparts.append(format_at(ch, gpath))
				|
				|			join_lines(gparts)
				|
				|
				|private pure func with_path(path: String, message: String) -> String:
				|	if path.length() == 0:
				|		message
				|	else:
				|		path + ": " + message
				|
				|
				|private pure func join_path(parent: String, child: String) -> String:
				|	if parent.length() == 0:
				|		child
				|	else if child.length() == 0:
				|		parent
				|	else if child.starts_with("["):
				|		parent + child
				|	else:
				|		parent + "." + child
				|
				|
				|private pure func join_lines(parts: List[String]) -> String:
				|	var result: String = ""
				|	var i: Int = 0
				|
				|	for p in parts:
				|		if i > 0:
				|			result = result + "\n" + p
				|		else:
				|			result = p
				|
				|		i += 1
				|
				|	result
				|
			Some(source)
		"std/vector":
			source: String = raw
				|import:
				|	tensor: length
				|	traits: Addable, FloatingPoint, HasOne, HasZero, Multipliable, Numeric, Orderable, ToFloat
				|
				|
				|type ParallelVector[T, #N] = builtin
				|
				|
				|-- Vector - 1D array operations
				|--
				|-- This module provides 1D-specific operations: factories, HOFs, numeric builtins.
				|-- For generic tensor ops (length, get, set_index), see tensor.
				|-- ============================================================================
				|-- Factory
				|-- ============================================================================
				|---
				|Clear a vector's data to zero without reallocating.
				|Returns the same vector. Requires unique ownership (var vector).
				|---
				|func clear[T, #N](arr: T[#N]) -> T[#N]:
				|	builtin("std/vector.clear")
				|
				|
				|---
				|Index of max element as a range-refined vector index. Ties keep the first match.
				|---
				|pure func argmax[T:Orderable, #N](arr: T[#N]) -> ..#N:
				|	var best_index: ..#N = 0
				|	var best_value: T = arr[0]
				|
				|	for i in 0..length(arr):
				|		value: T = arr[i]
				|
				|		if value > best_value:
				|			best_value = value
				|			best_index = i
				|
				|	best_index
				|
				|
				|---
				|Index of min element as a range-refined vector index. Ties keep the first match.
				|---
				|pure func argmin[T:Orderable, #N](arr: T[#N]) -> ..#N:
				|	var best_index: ..#N = 0
				|	var best_value: T = arr[0]
				|
				|	for i in 0..length(arr):
				|		value: T = arr[i]
				|
				|		if value < best_value:
				|			best_value = value
				|			best_index = i
				|
				|	best_index
				|
				|
				|---
				|Cumulative sum (type-dispatched).
				|---
				|pure func cumulative_sum[T:Addable+HasZero, #N](arr: T[#N]) -> T[#N]:
				|	builtin("std/vector.cumulative_sum")
				|
				|
				|---
				|Cross product (3D Float vectors only).
				|---
				|pure func cross(a: Float[#3], b: Float[#3]) -> Float[#3]:
				|	builtin("std/vector.cross")
				|
				|
				|-- ============================================================================
				|-- Scoped Parallel Pipelines
				|-- ============================================================================
				|---
				|Run a parallel vector pipeline.
				|
				|The callback receives a ParallelVector[T, #N], which intentionally exposes only
				|shape-preserving parallel combinators. The result is materialized back into a
				|normal fixed-size vector when the callback returns.
				|---
				|pure func parallel[T, U, #N](
				|	self: T[#N],
				|	body: pure (ParallelVector[T, #N]) -> ParallelVector[U, #N],
				|) -> U[#N]:
				|	builtin("std/vector.parallel")
				|
				|
				|-- ============================================================================
				|-- Higher-Order Functions
				|-- ============================================================================
				|---
				|Map: apply function to each element, returns new vector.
				|---
				|func map[T, U, #N](
				|	arr: T[#N],
				|	f: (T) -> U,
				|) -> U[#N]:
				|	builtin("std/vector.map")
				|
				|
				|---
				|Fold: reduce array to single value with an accumulator.
				|---
				|func fold[T, Acc, #N](
				|	arr: T[#N],
				|	init: Acc,
				|	f: (Acc, T) -> Acc,
				|) -> Acc:
				|	var result: Acc = init
				|
				|	for i in 0..arr.length():
				|		result = f(result, arr[i])
				|
				|	result
				|
				|
				|---
				|Zip: combine two arrays element-wise into pairs.
				|---
				|pure func zip[T, U, #N](a: T[#N], b: U[#N]) -> (T, U)[#N]:
				|	builtin("std/vector.zip")
				|
				|
				|---
				|All: check if all elements satisfy predicate.
				|---
				|func all[T, #N](
				|	arr: T[#N],
				|	pred: (T) -> Bool,
				|) -> Bool:
				|	var result: Bool = True
				|
				|	for i in 0..arr.length():
				|		result = pred(arr[i])
				|
				|		if not result:
				|			break
				|
				|	result
				|
				|
				|---
				|Any: check if any element satisfies predicate.
				|---
				|func any[T, #N](
				|	arr: T[#N],
				|	pred: (T) -> Bool,
				|) -> Bool:
				|	var result: Bool = False
				|
				|	for i in 0..arr.length():
				|		result = pred(arr[i])
				|
				|		if result:
				|			break
				|
				|	result
				|
				|
				|---
				|Convert vector to list.
				|---
				|pure func to_list[T, #N](arr: T[#N]) -> List[T]:
				|	var result: List[T] = []
				|
				|	for i in 0..arr.length():
				|		result = result.append(arr[i])
				|
				|	result
				|
				|
				|-- ============================================================================
				|-- Unified Numeric Operations (type-dispatched at codegen time)
				|-- ============================================================================
				|---
				|Sum all elements for additive numeric tensor element types.
				|---
				|pure func sum[T:Addable+HasZero, #N](arr: T[#N]) -> T:
				|	builtin("std/vector.sum")
				|
				|
				|---
				|Product of all elements for multiplicative numeric tensor element types.
				|---
				|pure func product[T:Multipliable+HasOne, #N](arr: T[#N]) -> T:
				|	builtin("std/vector.product")
				|
				|
				|---
				|Max element for ordered numeric tensor element types.
				|---
				|pure func max[T:Orderable+HasZero, #N](arr: T[#N]) -> T:
				|	builtin("std/vector.max")
				|
				|
				|---
				|Min element for ordered numeric tensor element types.
				|---
				|pure func min[T:Orderable+HasZero, #N](arr: T[#N]) -> T:
				|	builtin("std/vector.min")
				|
				|
				|---
				|Mean of all elements (always returns Float).
				|---
				|pure func mean[T:Addable+HasZero+ToFloat, #N](arr: T[#N]) -> Float:
				|	builtin("std/vector.mean")
				|
				|
				|---
				|Dot product for numeric tensor element types.
				|---
				|pure func dot[T:Numeric, #N](a: T[#N], b: T[#N]) -> T:
				|	builtin("std/vector.dot")
				|
				|
				|-- ============================================================================
				|-- Float-specific Numeric Operations
				|-- ============================================================================
				|---
				|Euclidean norm (L2 norm). Float, Float32, or Float16 vectors.
				|---
				|pure func norm[T:FloatingPoint, #N](arr: T[#N]) -> T:
				|	builtin("std/vector.norm")
				|
				|
				|---
				|Element-wise exp() on a float vector. Returns a new vector.
				|Float, Float32, or Float16.
				|---
				|pure func exp[T:FloatingPoint, #N](arr: T[#N]) -> T[#N]:
				|	builtin("std/vector.exp")
				|
				|
				|---
				|Element-wise log() on a float vector. Returns a new vector.
				|Float, Float32, or Float16.
				|---
				|pure func log[T:FloatingPoint, #N](arr: T[#N]) -> T[#N]:
				|	builtin("std/vector.log")
				|
				|
				|---
				|Element-wise sqrt() on a float vector/matrix. Returns a new tensor.
				|Uses sqrt(abs(x)) for safety (no NaN from negative values).
				|Float, Float32, or Float16.
				|---
				|pure func sqrt[T:FloatingPoint](arr: T[#_...]) -> T[#_...]:
				|	builtin("std/vector.sqrt")
				|
				|
				|-- ============================================================================
				|-- Utility Operations
				|-- ============================================================================
				|---
				|Multiply every element by a scalar. Compiles to SIMD-accelerated C.
				|---
				|pure func scale[#N](v: Float[#N], s: Float) -> Float[#N]:
				|	v * s
				|
				|
				|---
				|Linear interpolation between two vectors. ratio=0 returns a, ratio=1 returns b.
				|Uses the formula a + (b - a) * ratio for numerical stability.
				|---
				|pure func lerp[#N](a: Float[#N], b: Float[#N], ratio: Float) -> Float[#N]:
				|	a + (b - a) * ratio
				|
			Some(source)
		"std/void":
			source: String = raw
				|-- Void - Unit type.
				|--
				|-- The type with exactly one value. Used as the return type of functions
				|-- that perform side effects but don't produce a meaningful result, such
				|-- as [print]. Functions declared with [-> Void] or no return annotation
				|-- compile to C functions returning [void].
				|type Void = builtin
				|
			Some(source)
		"std/xml":
			source: String = raw
				|-- XML - Simple XML element parser
				|--
				|-- Parses XML into a tree of XmlNode values.
				|-- Supports elements, attributes, text content, and self-closing tags.
				|-- Supports the five predefined XML entities only.
				|-- Does not support: namespaces, CDATA, processing instructions, DTD.
				|-- Unsupported declarations, nested comments, and malformed input return Err.
				|--
				|-- Usage:
				|-- match parse("<root><item id=\"1\">hello</item></root>"):
				|-- Ok(node): get_text(node)
				|-- Err(e): ""
				|-- ============================================================================
				|-- Types
				|-- ============================================================================
				|union XmlNode:
				|	XmlElement(String, List[(String, String)], List[XmlNode])
				|	XmlText(String)
				|
				|
				|record XmlError {
				|	line: Int,
				|	column: Int,
				|	message: String
				|}
				|
				|
				|pure func format_error(err: XmlError) -> String:
				|	"line ${err.line.to_string()}, column ${err.column.to_string()}: ${err.message}"
				|
				|
				|-- ============================================================================
				|-- Public API
				|-- ============================================================================
				|---
				|Parse an XML string into an XmlNode tree.
				|Parse errors include line and column context in the returned string. Use
				|`parse_detailed` when callers need structured error fields.
				|
				|doctests:
				|    :: Simple element
				|    match parse("<root>hello</root>"):
				|        Ok(n):
				|            True
				|        Err(_):
				|            False
				|---
				|pure func parse(input: String) -> Result[XmlNode, String]:
				|	match parse_detailed(input):
				|		Ok(node):
				|			Ok(node)
				|		Err(err):
				|			Err(err.format_error())
				|
				|
				|---
				|Parse an XML string into an XmlNode tree with structured parser error details.
				|Use `parse` if you only need a formatted string error.
				|
				|doctests:
				|    :: Structured parse error
				|    match parse_detailed("<root>\n  <item></root>"):
				|        Ok(_):
				|            False
				|        Err(e):
				|            e.line == 2 and e.column == 9
				|---
				|pure func parse_detailed(input: String) -> Result[XmlNode, XmlError]:
				|	trimmed: String = input.trim()
				|
				|	if trimmed.length() == 0:
				|		Err(parse_error(trimmed, 0, "empty input"))
				|	else if trimmed.substring(0, 1) != "<":
				|		Err(parse_error(trimmed, 0, "expected '<'"))
				|	else:
				|		match parse_node(trimmed, 0):
				|			Ok(result):
				|				trailing_pos: Int = skip_ws_pos(trimmed, result[1])
				|				remaining: String = trimmed
				|					.substring(trailing_pos, trimmed.length() - trailing_pos)
				|					.trim()
				|
				|				if not is_element(result[0]):
				|					Err(parse_error(trimmed, 0, "malformed XML"))
				|				else if remaining.length() > 0:
				|					Err(parse_error(trimmed, trailing_pos, "unexpected trailing input"))
				|				else:
				|					Ok(result[0])
				|			Err(err):
				|				Err(err)
				|
				|
				|---
				|Get the tag name of an element node.
				|---
				|pure func get_tag(node: XmlNode) -> Option[String]:
				|	var result: Option[String] = None
				|
				|	match node:
				|		XmlElement(tag, _, _):
				|			result = Some(tag)
				|		XmlText(_):
				|			result = None
				|
				|	result
				|
				|
				|---
				|Get attribute value by name.
				|---
				|pure func get_attr(node: XmlNode, name: String) -> Option[String]:
				|	var result: Option[String] = None
				|
				|	match node:
				|		XmlElement(_, attrs, _):
				|			result = find_attr(attrs, name)
				|		XmlText(_):
				|			result = None
				|
				|	result
				|
				|
				|---
				|Get the text content of a node (first text child only for elements).
				|---
				|pure func get_text(node: XmlNode) -> String:
				|	var result: String = ""
				|
				|	match node:
				|		XmlElement(_, _, kids):
				|			result = first_text(kids)
				|		XmlText(t):
				|			result = t
				|
				|	result
				|
				|
				|---
				|Get child elements by tag name.
				|---
				|pure func find(node: XmlNode, tag: String) -> List[XmlNode]:
				|	var result: List[XmlNode] = []
				|
				|	match node:
				|		XmlElement(_, _, kids):
				|			result = filter_by_tag(kids, tag)
				|		XmlText(_):
				|			result = []
				|
				|	result
				|
				|
				|---
				|Get all child elements.
				|---
				|pure func children(node: XmlNode) -> List[XmlNode]:
				|	var result: List[XmlNode] = []
				|
				|	match node:
				|		XmlElement(_, _, kids):
				|			result = kids
				|		XmlText(_):
				|			result = []
				|
				|	result
				|
				|
				|-- ============================================================================
				|-- Internal parsing
				|-- ============================================================================
				|private pure func line_column_at(s: String, pos: Int) -> (Int, Int):
				|	var target: Int = pos
				|
				|	if target < 0:
				|		target = 0
				|	else if target > s.length():
				|		target = s.length()
				|
				|	var line: Int = 1
				|	var column: Int = 1
				|	var i: Int = 0
				|
				|	while i < target:
				|		match s.get(i):
				|			Some('\n'):
				|				line += 1
				|				column = 1
				|			Some(_):
				|				column += 1
				|			None:
				|				void
				|
				|		i += 1
				|
				|	(line, column)
				|
				|
				|private pure func parse_error(s: String, pos: Int, message: String) -> XmlError:
				|	position: (Int, Int) = line_column_at(s, pos)
				|	{
				|		line = position[0],
				|		column = position[1],
				|		message = message
				|	}
				|
				|
				|private pure func leading_ws_count(s: String) -> Int:
				|	var i: Int = 0
				|	var done: Bool = False
				|
				|	while i < s.length() and not done:
				|		match s.get(i):
				|			Some(c):
				|				if (
				|					c == ' '
				|					or c == '\t'
				|					or c == '\n'
				|					or c == '\r'
				|				):
				|					i += 1
				|				else:
				|					done = True
				|			None:
				|				done = True
				|
				|	i
				|
				|
				|private pure func skip_ws_pos(s: String, pos: Int) -> Int:
				|	var i: Int = pos
				|	var done: Bool = False
				|
				|	while i < s.length() and not done:
				|		match s.get(i):
				|			Some(c):
				|				if (
				|					c == ' '
				|					or c == '\t'
				|					or c == '\n'
				|					or c == '\r'
				|				):
				|					i += 1
				|				else:
				|					done = True
				|			None:
				|				done = True
				|
				|	i
				|
				|
				|private pure func parse_node(s: String, pos: Int) -> Result[(XmlNode, Int), XmlError]:
				|	if pos >= s.length():
