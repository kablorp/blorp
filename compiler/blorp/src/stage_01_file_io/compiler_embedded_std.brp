				|			span_from(cursor, end_cursor),
				|			end_cursor,
				|		)
				|	else:
				|		ParseFailed(error_at(cursor, "\"" + expected + "\""))
				|
				|
				|pure func take_while(
				|	src: Source,
				|	cursor: Cursor,
				|	pred: pure (Char) -> Bool,
				|) -> ParseResult[Span]:
				|	var current: Cursor = cursor
				|	var done: Bool = False
				|
				|	while not done:
				|		match peek(src, current):
				|			Some(c):
				|				if pred(c):
				|					current = advance(src, current)
				|				else:
				|					done = True
				|			None:
				|				done = True
				|
				|	Parsed(
				|		span_from(cursor, current),
				|		current,
				|	)
				|
				|
				|pure func take_while1(
				|	src: Source,
				|	cursor: Cursor,
				|	expected: String,
				|	pred: pure (Char) -> Bool,
				|) -> ParseResult[Span]:
				|	match take_while(src, cursor, pred):
				|		Parsed(span, next):
				|			if next.offset > cursor.offset:
				|				Parsed(span, next)
				|			else:
				|				ParseFailed(error_at(cursor, expected))
				|		ParseFailed(error):
				|			ParseFailed(error)
				|
				|
				|pure func digit(src: Source, cursor: Cursor) -> ParseResult[Char]:
				|	satisfy(src, cursor, EXPECTED_DIGIT, is_digit)
				|
				|
				|pure func letter(src: Source, cursor: Cursor) -> ParseResult[Char]:
				|	satisfy(src, cursor, EXPECTED_LETTER, is_alpha)
				|
				|
				|pure func whitespace(src: Source, cursor: Cursor) -> ParseResult[Char]:
				|	satisfy(src, cursor, EXPECTED_WHITESPACE, is_whitespace)
				|
				|
				|pure func skip_whitespace(src: Source, cursor: Cursor) -> ParseResult[Span]:
				|	take_while(src, cursor, is_whitespace)
				|
				|
				|pure func end_of_input(src: Source, cursor: Cursor) -> ParseResult[Cursor]:
				|	if at_end(src, cursor):
				|		Parsed(cursor, cursor)
				|	else:
				|		ParseFailed(error_at(cursor, EXPECTED_END))
				|
				|
				|pure func label[T](parser: Parser[T], expected: String) -> Parser[T]:
				|	pure func(src: Source, cursor: Cursor) -> ParseResult[T]:
				|		match parser(src, cursor):
				|			Parsed(value, next):
				|				Parsed(value, next)
				|			ParseFailed(error):
				|				ParseFailed({ error |
				|						message = expected_message(expected),
				|						expected = expected_list(expected)
				|					})
				|
				|
				|pure func commit[T](parser: Parser[T]) -> Parser[T]:
				|	pure func(src: Source, cursor: Cursor) -> ParseResult[T]:
				|		match parser(src, cursor):
				|			Parsed(value, next):
				|				Parsed(value, next)
				|			ParseFailed(error):
				|				ParseFailed({ error | committed = True })
				|
				|
				|pure func or_else[T](first: Parser[T], second: Parser[T]) -> Parser[T]:
				|	pure func(src: Source, cursor: Cursor) -> ParseResult[T]:
				|		match first(src, cursor):
				|			Parsed(value, next):
				|				Parsed(value, next)
				|			ParseFailed(first_error):
				|				if first_error.committed:
				|					ParseFailed(first_error)
				|				else:
				|					match second(src, cursor):
				|						Parsed(value, next):
				|							Parsed(value, next)
				|						ParseFailed(second_error):
				|							ParseFailed(merge_errors(first_error, second_error))
				|
				|
				|pure func optional[T](parser: Parser[T]) -> Parser[Option[T]]:
				|	pure func(src: Source, cursor: Cursor) -> ParseResult[Option[T]]:
				|		match parser(src, cursor):
				|			Parsed(value, next):
				|				Parsed(Some(value), next)
				|			ParseFailed(error):
				|				if error.committed:
				|					ParseFailed(error)
				|				else:
				|					Parsed(None, cursor)
				|
				|
				|private pure func no_progress_error(cursor: Cursor) -> ParseError:
				|	message_error(cursor, NO_PROGRESS_MESSAGE)
				|
				|
				|pure func many[T](parser: Parser[T]) -> Parser[List[T]]:
				|	pure func(src: Source, cursor: Cursor) -> ParseResult[List[T]]:
				|		var items: List[T] = []
				|		var current: Cursor = cursor
				|		var done: Bool = False
				|		var failed: Bool = False
				|		var failure: ParseError = no_progress_error(cursor)
				|
				|		while not done:
				|			match parser(src, current):
				|				Parsed(value, next):
				|					if next.offset <= current.offset:
				|						failed = True
				|						failure = no_progress_error(current)
				|						done = True
				|					else:
				|						items = items.append(value)
				|						current = next
				|				ParseFailed(error):
				|					if error.committed:
				|						failed = True
				|						failure = error
				|
				|					done = True
				|
				|		if failed:
				|			ParseFailed(failure)
				|		else:
				|			Parsed(items, current)
				|
				|
				|pure func many1[T](parser: Parser[T]) -> Parser[List[T]]:
				|	pure func(src: Source, cursor: Cursor) -> ParseResult[List[T]]:
				|		match parser(src, cursor):
				|			Parsed(first, after_first):
				|				if after_first.offset <= cursor.offset:
				|					ParseFailed(no_progress_error(cursor))
				|				else:
				|					var items: List[T] = [first]
				|					var current: Cursor = after_first
				|					var done: Bool = False
				|					var failed: Bool = False
				|					var failure: ParseError = no_progress_error(cursor)
				|
				|					while not done:
				|						match parser(src, current):
				|							Parsed(value, next):
				|								if next.offset <= current.offset:
				|									failed = True
				|									failure = no_progress_error(current)
				|									done = True
				|								else:
				|									items = items.append(value)
				|									current = next
				|							ParseFailed(error):
				|								if error.committed:
				|									failed = True
				|									failure = error
				|
				|								done = True
				|
				|					if failed:
				|						ParseFailed(failure)
				|					else:
				|						Parsed(items, current)
				|			ParseFailed(error):
				|				ParseFailed(error)
				|
				|
				|pure func then[A, B](first: Parser[A], second: Parser[B]) -> Parser[B]:
				|	pure func(src: Source, cursor: Cursor) -> ParseResult[B]:
				|		match first(src, cursor):
				|			Parsed(_, after_first):
				|				second(src, after_first)
				|			ParseFailed(error):
				|				ParseFailed(error)
				|
				|
				|pure func skip[A, B](first: Parser[A], second: Parser[B]) -> Parser[A]:
				|	pure func(src: Source, cursor: Cursor) -> ParseResult[A]:
				|		match first(src, cursor):
				|			Parsed(value, after_first):
				|				match second(src, after_first):
				|					Parsed(_, after_second):
				|						Parsed(value, after_second)
				|					ParseFailed(error):
				|						ParseFailed(error)
				|			ParseFailed(error):
				|				ParseFailed(error)
				|
				|
				|pure func between[T, A, B](
				|	open_parser: Parser[A],
				|	item_parser: Parser[T],
				|	close_parser: Parser[B],
				|) -> Parser[T]:
				|	pure func(src: Source, cursor: Cursor) -> ParseResult[T]:
				|		match open_parser(src, cursor):
				|			Parsed(_, after_open):
				|				match item_parser(src, after_open):
				|					Parsed(value, after_item):
				|						match close_parser(src, after_item):
				|							Parsed(_, after_close):
				|								Parsed(value, after_close)
				|							ParseFailed(error):
				|								ParseFailed(error)
				|					ParseFailed(error):
				|						ParseFailed(error)
				|			ParseFailed(error):
				|				ParseFailed(error)
				|
				|
				|pure func sep_by[T, S](item: Parser[T], sep: Parser[S]) -> Parser[List[T]]:
				|	pure func(src: Source, cursor: Cursor) -> ParseResult[List[T]]:
				|		match item(src, cursor):
				|			ParseFailed(error):
				|				if error.committed:
				|					ParseFailed(error)
				|				else:
				|					empty: List[T] = []
				|					Parsed(empty, cursor)
				|			Parsed(first, after_first):
				|				if after_first.offset <= cursor.offset:
				|					ParseFailed(no_progress_error(cursor))
				|				else:
				|					var items: List[T] = [first]
				|					var current: Cursor = after_first
				|					var done: Bool = False
				|					var failed: Bool = False
				|					var failure: ParseError = no_progress_error(cursor)
				|
				|					while not done:
				|						match sep(src, current):
				|							Parsed(_, after_sep):
				|								if after_sep.offset <= current.offset:
				|									failed = True
				|									failure = no_progress_error(current)
				|									done = True
				|								else:
				|									match item(src, after_sep):
				|										Parsed(value, after_item):
				|											if after_item.offset <= after_sep.offset:
				|												failed = True
				|												failure = no_progress_error(after_sep)
				|												done = True
				|											else:
				|												items = items.append(value)
				|												current = after_item
				|										ParseFailed(error):
				|											if error.committed:
				|												failed = True
				|												failure = error
				|
				|											done = True
				|							ParseFailed(error):
				|								if error.committed:
				|									failed = True
				|									failure = error
				|
				|								done = True
				|
				|					if failed:
				|						ParseFailed(failure)
				|					else:
				|						Parsed(items, current)
				|
			Some(source)
		"std/path":
			source: String = raw
				|-- Path - File path manipulation utilities
				|--
				|-- Pure functions for working with file paths. All operations are string-based
				|-- and do not access the filesystem. Uses '/' as the path separator.
				|-- Helper: find the last index of a character in a string. Returns -1 if not found.
				|private pure func last_index_of_char(s: String, c: Char) -> Int:
				|	var i: Int = s.length() - 1
				|	var found: Int = 0 - 1
				|
				|	while i >= 0:
				|		match s.get(i):
				|			Some(ch):
				|				if ch == c:
				|					found = i
				|					i = 0 - 1
				|				else:
				|					i -= 1
				|			None:
				|				i -= 1
				|
				|	found
				|
				|
				|---
				|Join two path segments with a separator.
				|If the second path is absolute, it is returned as-is.
				|
				|doctests:
				|    :: Join two segments
				|    "foo".join("bar") == "foo/bar"
				|
				|    :: Join with trailing slash
				|    "foo/".join("bar") == "foo/bar"
				|
				|    :: Absolute second path
				|    "foo".join("/bar") == "/bar"
				|
				|    :: Empty first path
				|    "".join("bar") == "bar"
				|---
				|pure func join(a: String, b: String) -> String:
				|	if b.starts_with("/"):
				|		b
				|	else if a.length() == 0:
				|		b
				|	else if a.ends_with("/"):
				|		a + b
				|	else:
				|		a + "/" + b
				|
				|
				|---
				|Get the directory portion of a path.
				|Returns "." if the path has no directory component.
				|
				|doctests:
				|    :: Simple path
				|    dirname("/foo/bar/baz.txt") == "/foo/bar"
				|
				|    :: Root path
				|    dirname("/foo") == "/"
				|
				|    :: No directory
				|    dirname("file.txt") == "."
				|
				|    :: Trailing slash stripped first
				|    dirname("/foo/bar/") == "/foo"
				|---
				|pure func dirname(path: String) -> String:
				|	p: String = if path.length() > 1:
				|		if path.ends_with("/"):
				|			path.take_left(path.length() - 1)
				|		else:
				|			path
				|	else:
				|		path
				|
				|	idx: Int = last_index_of_char(p, '/')
				|
				|	if idx < 0:
				|		"."
				|	else if idx == 0:
				|		"/"
				|	else:
				|		p.take_left(idx)
				|
				|
				|---
				|Get the filename portion of a path (everything after the last '/').
				|
				|doctests:
				|    :: Simple path
				|    basename("/foo/bar/baz.txt") == "baz.txt"
				|
				|    :: No directory
				|    basename("file.txt") == "file.txt"
				|
				|    :: Trailing slash
				|    basename("/foo/bar/") == "bar"
				|
				|    :: Root
				|    basename("/") == ""
				|---
				|pure func basename(path: String) -> String:
				|	p: String = if path.length() > 1:
				|		if path.ends_with("/"):
				|			path.take_left(path.length() - 1)
				|		else:
				|			path
				|	else:
				|		path
				|
				|	idx: Int = last_index_of_char(p, '/')
				|
				|	if idx < 0:
				|		p
				|	else:
				|		p.drop_left(idx + 1)
				|
				|
				|---
				|Get the file extension (including the dot), or None if there is none.
				|
				|doctests:
				|    :: Has extension
				|    extension("file.txt") == Some(".txt")
				|
				|    :: No extension
				|    match extension("Makefile"):
				|        None:
				|            True
				|        Some(_):
				|            False
				|
				|    :: Multiple dots
				|    extension("archive.tar.gz") == Some(".gz")
				|
				|    :: Hidden file with no extension
				|    match extension(".gitignore"):
				|        None:
				|            True
				|        Some(_):
				|            False
				|---
				|pure func extension(path: String) -> Option[String]:
				|	name: String = basename(path)
				|	idx: Int = last_index_of_char(name, '.')
				|
				|	if idx <= 0:
				|		None
				|	else:
				|		Some(name.drop_left(idx))
				|
				|
				|---
				|Get the filename without its extension.
				|
				|doctests:
				|    :: Simple stem
				|    stem("file.txt") == "file"
				|
				|    :: No extension
				|    stem("Makefile") == "Makefile"
				|
				|    :: Full path
				|    stem("/foo/bar/baz.tar.gz") == "baz.tar"
				|---
				|pure func stem(path: String) -> String:
				|	name: String = basename(path)
				|	idx: Int = last_index_of_char(name, '.')
				|
				|	if idx <= 0:
				|		name
				|	else:
				|		name.take_left(idx)
				|
				|
				|---
				|Check if a path is absolute (starts with '/').
				|
				|doctests:
				|    :: Absolute path
				|    is_absolute("/foo/bar") == True
				|
				|    :: Relative path
				|    is_absolute("foo/bar") == False
				|
				|    :: Empty path
				|    is_absolute("") == False
				|---
				|pure func is_absolute(path: String) -> Bool:
				|	path.starts_with("/")
				|
				|
				|---
				|Normalize a path by resolving '.' and '..' components and collapsing
				|multiple consecutive slashes.
				|
				|doctests:
				|    :: Resolve dot-dot
				|    normalize("/foo/bar/../baz") == "/foo/baz"
				|
				|    :: Resolve single dot
				|    normalize("/foo/./bar") == "/foo/bar"
				|
				|    :: Collapse multiple slashes
				|    normalize("/foo//bar") == "/foo/bar"
				|
				|    :: Already clean
				|    normalize("/foo/bar") == "/foo/bar"
				|
				|    :: Relative path
				|    normalize("foo/bar/../baz") == "foo/baz"
				|---
				|pure func normalize(path: String) -> String:
				|	abs: Bool = is_absolute(path)
				|	parts: List[String] = path.split("/")
				|	var stack: List[String] = []
				|	var count: Int = 0
				|
				|	for part in parts:
				|		if part.length() == 0:
				|			void
				|		else if part == ".":
				|			void
				|		else if part == "..":
				|			if count > 0:
				|				stack = stack.take(count - 1)
				|				count -= 1
				|			else if not abs:
				|				stack = stack.append("..")
				|				count += 1
				|		else:
				|			stack = stack.append(part)
				|			count += 1
				|
				|	if abs:
				|		var result: String = "/"
				|		var first: Bool = True
				|
				|		for seg in stack:
				|			if first:
				|				result += seg
				|				first = False
				|			else:
				|				result = result + "/" + seg
				|
				|		result
				|	else if count == 0:
				|		"."
				|	else:
				|		var result: String = ""
				|		var first: Bool = True
				|
				|		for seg in stack:
				|			if first:
				|				result = seg
				|				first = False
				|			else:
				|				result = result + "/" + seg
				|
				|		result
				|
			Some(source)
		"std/physics":
			source: String = raw
				|import:
				|	geometry: Vec2, vec2, vec2_add, vec2_dot, vec2_length, vec2_normalize, vec2_scale, vec2_sub
				|
				|
				|-- Physics - 2D physics simulation primitives
				|--
				|-- Pure functions for integration, forces, and collision response.
				|-- All functions operate on Vec2 from geometry.brp.
				|-- Integration
				|---
				|Euler integration step: updates position and velocity given acceleration.
				|Returns (new_position, new_velocity).
				|
				|doctests:
				|    :: Euler step with constant velocity
				|    r: (Vec2, Vec2) = euler_step(
				|        vec2(0.0, 0.0),
				|        vec2(1.0, 0.0),
				|        vec2(0.0, 0.0),
				|        1.0,
				|    )
				|    r[0].x.approx_eq(1.0)
				|---
				|pure func euler_step(pos: Vec2, vel: Vec2, acc: Vec2, dt: Float) -> (Vec2, Vec2):
				|	new_vel: Vec2 = vec2_add(
				|		vel,
				|		vec2_scale(acc, dt),
				|	)
				|	new_pos: Vec2 = vec2_add(
				|		pos,
				|		vec2_scale(new_vel, dt),
				|	)
				|	(new_pos, new_vel)
				|
				|
				|---
				|Verlet integration step: uses current and previous position.
				|Returns (new_position, current_position_as_prev).
				|
				|doctests:
				|    :: Verlet step extrapolates motion
				|    r: (Vec2, Vec2) = verlet_step(
				|        vec2(1.0, 0.0),
				|        vec2(0.0, 0.0),
				|        vec2(0.0, 0.0),
				|        1.0,
				|    )
				|    r[0].x.approx_eq(2.0)
				|---
				|pure func verlet_step(
				|	pos: Vec2,
				|	prev_pos: Vec2,
				|	acc: Vec2,
				|	dt: Float,
				|) -> (Vec2, Vec2):
				|	dt2: Float = dt * dt
				|	new_pos: Vec2 = vec2_add(
				|		vec2_sub(
				|			vec2_scale(pos, 2.0),
				|			prev_pos,
				|		),
				|		vec2_scale(acc, dt2),
				|	)
				|	(new_pos, pos)
				|
				|
				|---
				|4th-order Runge-Kutta integration step.
				|acc_fn computes acceleration given position and velocity.
				|Returns (new_position, new_velocity).
				|
				|doctests:
				|    :: RK4 step moves forward
				|    acc: pure (Vec2, Vec2) -> Vec2 = pure func(p: Vec2, v: Vec2): vec2(0.0, -9.8)
				|    r: (Vec2, Vec2) = rk4_step(
				|        vec2(0.0, 0.0),
				|        vec2(10.0, 10.0),
				|        acc,
				|        0.1,
				|    )
				|    r[0].x > 0.0
				|---
				|pure func rk4_step(
				|	pos: Vec2,
				|	vel: Vec2,
				|	acc_fn: pure (Vec2, Vec2) -> Vec2,
				|	dt: Float,
				|) -> (Vec2, Vec2):
				|	-- k1
				|	a1: Vec2 = acc_fn(pos, vel)
				|	v1: Vec2 = vel
				|
				|	-- k2
				|	p2: Vec2 = vec2_add(
				|		pos,
				|		vec2_scale(v1, dt * 0.5),
				|	)
				|	v2: Vec2 = vec2_add(
				|		vel,
				|		vec2_scale(a1, dt * 0.5),
				|	)
				|	a2: Vec2 = acc_fn(p2, v2)
				|
				|	-- k3
				|	p3: Vec2 = vec2_add(
				|		pos,
				|		vec2_scale(v2, dt * 0.5),
				|	)
				|	v3: Vec2 = vec2_add(
				|		vel,
				|		vec2_scale(a2, dt * 0.5),
				|	)
				|	a3: Vec2 = acc_fn(p3, v3)
				|
				|	-- k4
				|	p4: Vec2 = vec2_add(
				|		pos,
				|		vec2_scale(v3, dt),
				|	)
				|	v4: Vec2 = vec2_add(
				|		vel,
				|		vec2_scale(a3, dt),
				|	)
				|	a4: Vec2 = acc_fn(p4, v4)
				|
				|	-- Combine
				|	vel_sum: Vec2 = vec2_add(
				|		vec2_add(
				|			v1,
				|			vec2_scale(v2, 2.0),
				|		),
				|		vec2_add(
				|			vec2_scale(v3, 2.0),
				|			v4,
				|		),
				|	)
				|	acc_sum: Vec2 = vec2_add(
				|		vec2_add(
				|			a1,
				|			vec2_scale(a2, 2.0),
				|		),
				|		vec2_add(
				|			vec2_scale(a3, 2.0),
				|			a4,
				|		),
				|	)
				|	new_pos: Vec2 = vec2_add(
				|		pos,
				|		vec2_scale(vel_sum, dt / 6.0),
				|	)
				|	new_vel: Vec2 = vec2_add(
				|		vel,
				|		vec2_scale(acc_sum, dt / 6.0),
				|	)
				|	(new_pos, new_vel)
				|
				|
				|-- Forces
				|---
				|Gravity force (downward). Returns (0, mass * g).
				|Convention: positive g means downward force.
				|
				|doctests:
				|    :: Gravity on unit mass
				|    f: Vec2 = gravity_force(1.0, 9.8)
				|    f.y.approx_eq(9.8)
				|---
				|pure func gravity_force(mass: Float, g: Float) -> Vec2:
				|	vec2(0.0, mass * g)
				|
				|
				|---
				|Spring force (Hooke's law) pulling position toward anchor.
				|
				|doctests:
				|    :: Spring pulls back toward anchor
				|    f: Vec2 = spring_force(
				|        vec2(2.0, 0.0),
				|        vec2(0.0, 0.0),
				|        1.0,
				|        0.0,
				|    )
				|    f.x < 0.0
				|---
				|pure func spring_force(
				|	pos: Vec2,
				|	anchor: Vec2,
				|	k: Float,
				|	rest_length: Float,
				|) -> Vec2:
				|	diff: Vec2 = vec2_sub(anchor, pos)
				|	dist: Float = vec2_length(diff)
				|
				|	if dist == 0.0:
				|		vec2(0.0, 0.0)
				|	else:
				|		stretch: Float = dist - rest_length
				|		dir: Vec2 = vec2_normalize(diff)
				|		vec2_scale(dir, k * stretch)
				|
				|
				|---
				|Damping force opposing velocity.
				|
				|doctests:
				|    :: Damping opposes motion
				|    f: Vec2 = damping_force(
				|        vec2(10.0, 0.0),
				|        0.5,
				|    )
				|    f.x.approx_eq(-5.0)
				|---
				|pure func damping_force(vel: Vec2, coeff: Float) -> Vec2:
				|	vec2_scale(vel, -coeff)
				|
				|
				|---
				|Attraction force toward a target point.
				|
				|doctests:
				|    :: Attracts toward target
				|    f: Vec2 = attract_force(
				|        vec2(0.0, 0.0),
				|        vec2(1.0, 0.0),
				|        10.0,
				|    )
				|    f.x > 0.0
				|---
				|pure func attract_force(pos: Vec2, target: Vec2, strength: Float) -> Vec2:
				|	diff: Vec2 = vec2_sub(target, pos)
				|	dist: Float = vec2_length(diff)
				|
				|	if dist == 0.0:
				|		vec2(0.0, 0.0)
				|	else:
				|		vec2_scale(vec2_normalize(diff), strength)
				|
				|
				|-- Collision response
				|---
				|Reflect velocity off a surface with the given normal (perfect bounce).
				|
				|doctests:
				|    :: Reflect off horizontal surface
				|    r: Vec2 = reflect(
				|        vec2(1.0, -1.0),
				|        vec2(0.0, 1.0),
				|    )
				|    r.y.approx_eq(1.0)
				|---
				|pure func reflect(vel: Vec2, normal: Vec2) -> Vec2:
				|	d: Float = vec2_dot(vel, normal)
				|	vec2_sub(
				|		vel,
				|		vec2_scale(normal, 2.0 * d),
				|	)
				|
				|
				|---
				|Bounce with energy loss (restitution 0..1, where 1 = perfect bounce).
				|
				|doctests:
				|    :: Bounce with half restitution
				|    b: Vec2 = bounce(
				|        vec2(1.0, -1.0),
				|        vec2(0.0, 1.0),
				|        0.5,
				|    )
				|    b.y.approx_eq(0.5)
				|---
				|pure func bounce(vel: Vec2, normal: Vec2, restitution: Float) -> Vec2:
				|	d: Float = vec2_dot(vel, normal)
				|	vec2_sub(
				|		vel,
				|		vec2_scale(normal, (1.0 + restitution) * d),
				|	)
				|
				|
				|---
				|Separate two overlapping circles by pushing them apart equally.
				|Returns (new_a_pos, new_b_pos).
				|
				|doctests:
				|    :: Separate overlapping circles
				|    r: (Vec2, Vec2) = separate_circles(
				|        vec2(0.0, 0.0),
				|        1.0,
				|        vec2(1.0, 0.0),
				|        1.0,
				|    )
				|    r[0].x < 0.0
				|---
				|pure func separate_circles(
				|	a_pos: Vec2,
				|	a_radius: Float,
				|	b_pos: Vec2,
				|	b_radius: Float,
				|) -> (Vec2, Vec2):
				|	diff: Vec2 = vec2_sub(b_pos, a_pos)
				|	dist: Float = vec2_length(diff)
				|	min_dist: Float = a_radius + b_radius
				|
				|	if dist >= min_dist or dist == 0.0:
				|		(a_pos, b_pos)
				|	else:
				|		overlap: Float = min_dist - dist
				|		dir: Vec2 = vec2_normalize(diff)
				|		half_push: Vec2 = vec2_scale(dir, overlap * 0.5)
				|		(vec2_sub(a_pos, half_push), vec2_add(b_pos, half_push))
				|
				|
				|-- Utilities
				|---
				|Move current position toward target by at most max_delta distance.
				|
				|doctests:
				|    :: Move toward target with limit
				|    v: Vec2 = move_toward(
				|        vec2(0.0, 0.0),
				|        vec2(10.0, 0.0),
				|        3.0,
				|    )
				|    v.x.approx_eq(3.0)
				|---
				|pure func move_toward(current: Vec2, target: Vec2, max_delta: Float) -> Vec2:
				|	diff: Vec2 = vec2_sub(target, current)
				|	dist: Float = vec2_length(diff)
				|
				|	if dist <= max_delta or dist == 0.0:
				|		target
				|	else:
				|		vec2_add(
				|			current,
				|			vec2_scale(vec2_normalize(diff), max_delta),
				|		)
				|
				|
				|---
				|Critically damped spring smoothing for a single Float value.
				|Returns (new_value, new_velocity).
				|
				|doctests:
				|    :: Smooth damp moves toward target
				|    r: (Float, Float) = smooth_damp(0.0, 10.0, 0.0, 0.5, 0.016)
				|    r[0] > 0.0
				|---
				|pure func smooth_damp(
				|	current: Float,
				|	target: Float,
				|	vel: Float,
				|	smooth_time: Float,
				|	dt: Float,
				|) -> (Float, Float):
				|	omega: Float = 2.0 / smooth_time
				|	x: Float = omega * dt
				|	exp_factor: Float = 1.0 / (1.0 + x + 0.48 * x * x + 0.235 * x * x * x)
				|	change: Float = current - target
				|	new_vel: Float = (vel + omega * change) * exp_factor
				|	new_val: Float = target + (change + dt * vel) * exp_factor
				|	(new_val, new_vel)
				|
			Some(source)
		"std/prelude":
			source: String = raw
				|import:
				|	bool: Bool
				|	bytes: Bytes
				|	char: Char
				|	dict: Dict
				|	float16: Float16
				|	float32: Float32
				|	float: Float
				|	fs:
				|		Directory,
				|		DirectoryEntry,
				|		DirectoryEntryKind,
				|		FileAppender,
				|		FileReadAppender,
				|		FileReadWriter,
				|		FileReader,
				|		FileWriter,
				|		IOError,
				|	int: Int
				|	io: input, print, print_error, puts, read_line
				|	list: List, ParallelList
				|	matrix: ParallelMatrix
				|	option: Option(Some, None)
				|	parallel_list as ParallelListOps
				|	parallel_matrix as ParallelMatrixOps
				|	parallel_vector as ParallelVectorOps
				|	range: Range
				|	result: Result(Ok, Err)
				|	set: Set
				|	string: String
				|	vector: ParallelVector
				|
			Some(source)
		"std/process":
			source: String = raw
				|-- Process - Spawn and capture output of external processes
				|--
				|-- Provides safe process spawning with stdout/stderr capture.
				|-- Uses posix_spawnp internally (no shell injection risk for run()).
				|-- shell() is provided for convenience but runs via /bin/sh.
				|import:
				|	bytes: bytes
				|	units: DataSize, Duration, data_size_bytes, to_timeout_milliseconds
				|
				|
				|union ProcessStdin:
				|	InheritStdin
				|	NullStdin
				|	BytesStdin(Bytes)
				|
				|
				|enum ProcessStream:
				|	InheritStream
				|	CaptureStream
				|	NullStream
				|
				|
				|union ProcessExit:
				|	Exited(Int)
				|	Signaled(Int)
				|	TimedOut
				|
				|
				|implements Equatable for ProcessExit:
				|	pure func equals(a: ProcessExit, b: ProcessExit) -> Bool:
				|		match a:
				|			Exited(a_code):
				|				match b:
				|					Exited(b_code):
				|						a_code == b_code
				|					_:
				|						False
				|			Signaled(a_signal):
				|				match b:
				|					Signaled(b_signal):
				|						a_signal == b_signal
				|					_:
				|						False
				|			TimedOut:
				|				match b:
				|					TimedOut:
				|						True
				|					_:
				|						False
				|
				|
				|enum ProcessGroup:
				|	InheritProcessGroup
				|	NewProcessGroup
				|
				|
				|record ProcessEnvironmentChange {
				|	name: String,
				|	value: Option[String]
				|}
				|
				|
				|record ProcessCommand {
				|	program: String,
				|	args: List[String],
				|	cwd: Option[String],
				|	environment: List[ProcessEnvironmentChange],
				|	stdin: ProcessStdin,
				|	stdout: ProcessStream,
				|	stderr: ProcessStream,
				|	timeout: Option[Duration],
				|	process_group: ProcessGroup,
				|	capture_limit: Option[DataSize]
				|}
				|
				|
				|record ProcessResult {
				|	exit: ProcessExit,
				|	stdout: Bytes,
				|	stderr: Bytes
				|}
				|
				|
				|union ProcessError:
				|	InvalidCommand(String)
				|	ProgramNotFound(String)
				|	SpawnFailed(String)
				|	ProcessIoFailed(String)
				|	ProcessOutputLimitExceeded(String)
				|
				|
				|implements Stringable for ProcessError:
				|	pure func to_string(error: ProcessError) -> String:
				|		match error:
				|			InvalidCommand(detail):
				|				"invalid process command: " + detail
				|			ProgramNotFound(program):
				|				"program not found: " + program
				|			SpawnFailed(detail):
				|				"process spawn failed: " + detail
				|			ProcessIoFailed(detail):
				|				"process I/O failed: " + detail
				|			ProcessOutputLimitExceeded(detail):
				|				"process output limit exceeded: " + detail
				|
				|
				|---
				|Create a process command with captured output and no inherited stdin.
				|
				|The child starts in a new process group so a configured timeout can terminate
				|the child and its descendants. Record update syntax customizes other fields.
				|---
				|pure func command(program: String, args: List[String]) -> ProcessCommand:
				|	{
				|		program = program,
				|		args = args,
				|		cwd = None,
				|		environment = [],
				|		stdin = NullStdin,
				|		stdout = CaptureStream,
				|		stderr = CaptureStream,
				|		timeout = None,
				|		process_group = NewProcessGroup,
				|		capture_limit = None
				|	}
				|
				|
				|private RAW_STDIN_INHERIT: Int = 0
				|
				|private RAW_STDIN_NULL: Int = 1
				|
				|private RAW_STDIN_BYTES: Int = 2
				|
				|private RAW_STREAM_INHERIT: Int = 0
				|
				|private RAW_STREAM_CAPTURE: Int = 1
				|
				|private RAW_STREAM_NULL: Int = 2
				|
				|private RAW_GROUP_INHERIT: Int = 0
				|
				|private RAW_GROUP_NEW: Int = 1
				|
				|private RAW_EXIT_EXITED: Int = 0
				|
				|private RAW_EXIT_SIGNALED: Int = 1
				|
				|private RAW_EXIT_TIMED_OUT: Int = 2
				|
				|private RAW_ERROR_INVALID_COMMAND: Int = 0
				|
				|private RAW_ERROR_PROGRAM_NOT_FOUND: Int = 1
				|
				|private RAW_ERROR_SPAWN_FAILED: Int = 2
				|
				|private RAW_ERROR_IO_FAILED: Int = 3
				|
				|private RAW_ERROR_OUTPUT_LIMIT: Int = 4
				|
				|private RAW_DEFAULT_CAPTURE_LIMIT: Int = -1
				|
				|private record RawProcessEnvironment {
				|	set_names: List[String],
				|	set_values: List[String],
				|	unset_names: List[String]
				|}
				|
				|
				|private pure func raw_process_environment(
				|	changes: List[ProcessEnvironmentChange],
				|) -> Result[RawProcessEnvironment, ProcessError]:
				|	var set_names: List[String] = []
				|	var set_values: List[String] = []
				|	var unset_names: List[String] = []
				|	var failure: Option[ProcessError] = None
				|
				|	for change in changes:
				|		if failure.is_none():
				|			var duplicate_count: Int = 0
				|
				|			for candidate in changes:
				|				if candidate.name == change.name:
				|					duplicate_count += 1
				|
				|			if change.name.length() == 0:
				|				failure = Some(InvalidCommand("environment variable name is empty"))
				|			else if change.name.contains("="):
				|				failure = Some(InvalidCommand("environment variable name contains '='"))
				|			else if duplicate_count > 1:
				|				failure = Some(InvalidCommand("duplicate environment change for '" + change.name + "'"))
				|			else:
				|
				|				match change.value:
				|					Some(value):
				|						set_names = set_names.append(change.name)
				|						set_values = set_values.append(value)
				|					None:
				|						unset_names = unset_names.append(change.name)
				|
				|	match failure:
				|		Some(error):
				|			Err(error)
				|		None:
				|			Ok({
				|				set_names = set_names,
				|				set_values = set_values,
				|				unset_names = unset_names,
				|			})
				|
				|
				|private pure func raw_process_stdin(stdin: ProcessStdin) -> (Int, Bytes):
				|	match stdin:
				|		InheritStdin:
				|			(RAW_STDIN_INHERIT, bytes(0))
				|		NullStdin:
				|			(RAW_STDIN_NULL, bytes(0))
				|		BytesStdin(data):
				|			(RAW_STDIN_BYTES, data)
				|
				|
				|private pure func raw_process_stream(stream: ProcessStream) -> Int:
				|	match stream:
				|		InheritStream:
				|			RAW_STREAM_INHERIT
				|		CaptureStream:
				|			RAW_STREAM_CAPTURE
				|		NullStream:
				|			RAW_STREAM_NULL
				|
				|
				|private pure func raw_process_group(group: ProcessGroup) -> Int:
				|	match group:
				|		InheritProcessGroup:
				|			RAW_GROUP_INHERIT
				|		NewProcessGroup:
				|			RAW_GROUP_NEW
				|
				|
				|private pure func process_exit_from_raw(kind: Int, code: Int) -> ProcessExit:
				|	if kind == RAW_EXIT_EXITED:
				|		Exited(code)
				|	else if kind == RAW_EXIT_SIGNALED:
				|		Signaled(code)
				|	else:
				|		TimedOut
				|
				|
				|private pure func process_error_from_raw(kind: Int, detail: String) -> ProcessError:
				|	if kind == RAW_ERROR_INVALID_COMMAND:
				|		InvalidCommand(detail)
				|	else if kind == RAW_ERROR_PROGRAM_NOT_FOUND:
				|		ProgramNotFound(detail)
				|	else if kind == RAW_ERROR_SPAWN_FAILED:
				|		SpawnFailed(detail)
				|	else if kind == RAW_ERROR_OUTPUT_LIMIT:
				|		ProcessOutputLimitExceeded(detail)
				|	else:
				|		ProcessIoFailed(detail)
				|
				|
				|private pure func raw_capture_limit(limit: Option[DataSize]) -> Result[Int, ProcessError]:
				|	match limit:
				|		Some(size):
				|			byte_count: Int = data_size_bytes(size)
				|
				|			if byte_count < 0:
				|				Err(InvalidCommand("capture limit must be non-negative"))
				|			else:
				|				Ok(byte_count)
				|		None:
				|			Ok(RAW_DEFAULT_CAPTURE_LIMIT)
				|
				|
				|private func process_run_command_builtin(
				|	program: String,
				|	args: List[String],
				|	options: ((String, Bool), (List[String], List[String], List[String]), (Int, Bytes, Int, Int), (Bool, Int, Int, Int)),
				|) -> Result[(Int, Int, Bytes, Bytes), (Int, String)]:
				|	builtin("blorp_process_run_command_raw")
				|
				|
				|---
				|Run a structured process command without shell parsing or process-global
				|environment mutation.
				|
				|Captured output remains bytes. Stdin is written while captured stdout and
				|stderr are drained, so payloads larger than OS pipe buffers cannot deadlock.
				|---
				|func run_command(request: ProcessCommand) -> Result[ProcessResult, ProcessError]:
				|	environment ?= raw_process_environment(request.environment)
				|	capture_limit ?= raw_capture_limit(request.capture_limit)
				|	stdin: (Int, Bytes) = raw_process_stdin(request.stdin)
				|	has_timeout: Bool = request.timeout.is_some()
				|	timeout_ms: Int = request.timeout.map(to_timeout_milliseconds).get_or(0)
				|
				|	match process_run_command_builtin(
				|		request.program,
				|		request.args,
				|		(
				|			(request.cwd.get_or(""), request.cwd.is_some()),
				|			(
				|				environment.set_names,
				|				environment.set_values,
				|				environment.unset_names,
				|			),
				|			(
				|				stdin[0],
				|				stdin[1],
				|				raw_process_stream(request.stdout),
				|				raw_process_stream(request.stderr),
				|			),
				|			(
				|				has_timeout,
				|				timeout_ms,
				|				raw_process_group(request.process_group),
				|				capture_limit,
				|			),
				|		),
				|	):
				|		Ok(raw):
				|			Ok({
				|				exit = process_exit_from_raw(raw[0], raw[1]),
				|				stdout = raw[2],
				|				stderr = raw[3]
				|			})
				|		Err(raw):
				|			Err(process_error_from_raw(raw[0], raw[1]))
				|
				|
				|-- ============================================================================
				|-- Process Output Type
				|-- ============================================================================
				|opaque type ProcessOutput = (String, String, Int)
				|
				|
				|---
				|Captured stdout from a completed process.
				|---
				|pure func stdout(self: ProcessOutput) -> String:
				|	parts: (String, String, Int) = from ProcessOutput(self)
				|	parts[0]
				|
				|
				|---
				|Captured stderr from a completed process.
				|---
				|pure func stderr(self: ProcessOutput) -> String:
				|	parts: (String, String, Int) = from ProcessOutput(self)
				|	parts[1]
				|
				|
				|---
				|Process exit code.
				|---
				|pure func exit_code(self: ProcessOutput) -> Int:
				|	parts: (String, String, Int) = from ProcessOutput(self)
				|	parts[2]
				|
				|
				|-- ============================================================================
				|-- Core Functions (builtins)
				|-- ============================================================================
				|---
				|Run a program with arguments. Captures stdout and stderr.
				|Returns captured stdout, stderr, and exit code.
				|Uses posix_spawnp, so the program is looked up in PATH.
				|
				|doctests:
				|    :: Run echo
				|    r = run("echo", ["hello"])
				|
				|    match r:
				|        Ok(out):
				|            out.exit_code() == 0
				|        Err(_):
				|            False
				|---
				|func run(program: String, args: List[String]) -> Result[ProcessOutput, String]:
				|	process_result(process_run_builtin(program, args))
				|
				|
				|---
				|Run a program with arguments while inheriting this process's stdin, stdout,
				|and stderr. Returns the child process exit code.
				|Uses posix_spawnp, so the program is looked up in PATH.
				|
				|Use run() when output must be captured. Use run_inherit() for terminal-facing
				|commands that should stream output directly or read from the user's terminal.
				|
				|doctests:
				|    :: Run inherited process
				|    r = run_inherit("sh", ["-c", "exit 0"])
				|
				|    match r:
				|        Ok(code):
				|            code == 0
				|        Err(_):
				|            False
				|---
				|func run_inherit(program: String, args: List[String]) -> Result[Int, String]:
				|	process_run_inherit_builtin(program, args)
				|
				|
				|---
				|Run a shell command via /bin/sh -c. Captures stdout and stderr.
				|Returns captured stdout, stderr, and exit code.
				|
				|WARNING: This function passes the command to a shell. Do NOT use
				|with untrusted input — use run() instead to avoid shell injection.
				|
				|doctests:
				|    :: Shell echo
				|    r = shell("echo hello")
				|
				|    match r:
				|        Ok(out):
				|            out.exit_code() == 0
				|        Err(_):
				|            False
				|---
				|func shell(command: String) -> Result[ProcessOutput, String]:
				|	process_result(process_shell_builtin(command))
				|
				|
				|-- ============================================================================
				|-- Builtins (internal)
				|-- ============================================================================
				|private func process_run_builtin(
				|	program: String,
				|	args: List[String],
				|) -> Result[(String, String, Int), String]:
				|	builtin("blorp_process_run")
				|
				|
				|private func process_run_inherit_builtin(
				|	program: String,
				|	args: List[String],
				|) -> Result[Int, String]:
				|	builtin("blorp_process_run_inherit")
				|
				|
				|private func process_shell_builtin(command: String) -> Result[(String, String, Int), String]:
				|	builtin("blorp_process_shell")
				|
				|
				|private pure func process_output(
				|	stdout_value: String,
				|	stderr_value: String,
				|	exit_code_value: Int,
				|) -> ProcessOutput:
				|	into ProcessOutput((stdout_value, stderr_value, exit_code_value))
				|
				|
				|private pure func process_result(
				|	result: Result[(String, String, Int), String],
				|) -> Result[ProcessOutput, String]:
				|	match result:
				|		Ok(out):
				|			Ok(process_output(out[0], out[1], out[2]))
				|		Err(msg):
				|			Err(msg)
				|
				|
				|-- ============================================================================
				|-- Unix Signal Handling
				|-- ============================================================================
				|enum Signal:
				|	Hangup
				|	Interrupt
				|	Terminate
				|	User1
				|	User2
				|
				|
				|private func signal_on_builtin(
				|	signum: Int,
				|	handler: () -> Void,
				|) -> Void:
				|	builtin("blorp_signal_on")
				|
				|
				|private func signal_received_builtin(signum: Int) -> Bool:
				|	builtin("blorp_signal_received")
				|
				|
				|private func signal_raise_builtin(signum: Int) -> Void:
				|	builtin("blorp_signal_raise")
				|
				|
				|private pure func signal_hangup_number() -> Int:
				|	builtin("blorp_signal_hangup")
				|
				|
				|private pure func signal_interrupt_number() -> Int:
				|	builtin("blorp_signal_interrupt")
				|
				|
				|private pure func signal_terminate_number() -> Int:
				|	builtin("blorp_signal_terminate")
				|
				|
				|private pure func signal_user1_number() -> Int:
				|	builtin("blorp_signal_user1")
				|
				|
				|private pure func signal_user2_number() -> Int:
				|	builtin("blorp_signal_user2")
				|
				|
				|private pure func signal_number(signal: Signal) -> Int:
				|	match signal:
				|		Hangup:
				|			signal_hangup_number()
				|		Interrupt:
				|			signal_interrupt_number()
				|		Terminate:
				|			signal_terminate_number()
				|		User1:
				|			signal_user1_number()
				|		User2:
				|			signal_user2_number()
				|
				|
				|---
				|Register a handler for a Unix signal. The handler runs asynchronously
				|on the thread pool when the signal is received.
				|
				|doctests:
				|    :: Signals are typed values
				|    Interrupt != Terminate
				|---
				|func on_signal(
				|	signal: Signal,
				|	handler: () -> Void,
				|) -> Void:
				|	signal_on_builtin(signal_number(signal), handler)
				|
				|
				|---
				|Register a handler for SIGINT (Ctrl-C).
				|---
				|func on_interrupt(handler: () -> Void) -> Void:
				|	on_signal(Interrupt, handler)
				|
				|
				|---
				|Register a handler for SIGTERM.
				|---
				|func on_terminate(handler: () -> Void) -> Void:
				|	on_signal(Terminate, handler)
				|
				|
				|---
				|Check if a signal was received since last check (clears the flag).
				|---
				|func signal_received(signal: Signal) -> Bool:
				|	signal_received_builtin(signal_number(signal))
				|
				|
				|---
				|Raise a signal (send to own process). Useful for testing.
				|---
				|func raise_signal(signal: Signal) -> Void:
				|	signal_raise_builtin(signal_number(signal))
				|
			Some(source)
		"std/process_session":
			source: String = raw
				|-- Process Session - scoped, streaming external process supervision.
				|--
				|-- This is separate from the blocking process module so compiler bootstrap
				|-- generations that predate streaming sessions do not need to compile the new
				|-- runtime calls while building the next compiler.
				|import:
				|	bytes: bytes, concat as concat_bytes
				|	process:
				|		ProcessCommand,
				|		ProcessEnvironmentChange,
				|		ProcessError(InvalidCommand, ProcessIoFailed),
				|		ProcessExit(Exited, Signaled, TimedOut),
				|		ProcessGroup(InheritProcessGroup, NewProcessGroup),
				|		ProcessResult,
				|		ProcessStdin(BytesStdin, InheritStdin, NullStdin),
				|		ProcessStream(CaptureStream),
				|	units: DataSize, Duration, data_size_bytes, from_bytes, milliseconds, to_timeout_milliseconds
				|
				|
				|---
				|Opaque resource for a live child process with piped stdin, stdout, and stderr.
				|---
				|resource type ProcessSession = builtin("blorp_process_session_close")
				|
				|
				|private trait ProcessSessionClosable:
				|	func close(session: Self) -> Void
				|
				|
				|implements ProcessSessionClosable for ProcessSession:
				|	func close(session: ProcessSession) -> Void:
				|		builtin("blorp_process_session_close")
				|
				|
				|---
				|Launch description for a streaming process session.
				|
				|Sessions always use a new process group and pipe all three standard streams.
				|This keeps cleanup and stream ownership deterministic. The timeout covers the
				|leader and descendants that retain captured stdout or stderr; scope cleanup
				|always terminates the owned process group, including silent descendants. The
				|capture limit covers all stdout and stderr bytes delivered by polling.
				|---
				|opaque type ProcessSessionCommand = (String, List[String], ((String, Bool), (List[String], List[String], List[String]), (Int, Bytes, Int, Int), (Bool, Int, Int, Int)))
				|
				|
				|---
				|One bounded observation of a process session.
				|
				|Empty output means no bytes were available during this poll. The corresponding
				|open flag distinguishes that state from end-of-stream. Exit can become known
				|before descendants close inherited output descriptors, so callers should keep
				|polling until both output streams are closed.
				|---
				|record ProcessSessionActivity {
				|	stdout: Bytes,
				|	stderr: Bytes,
				|	stdout_open: Bool,
				|	stderr_open: Bool,
				|	stdin_open: Bool,
				|	stdin_writable: Bool
				|}
				|
				|
				|---
				|Current lifecycle state of a process session.
				|---
				|union ProcessSessionState:
				|	SessionRunning
				|	SessionExited(Int)
				|	SessionSignaled(Int)
				|	SessionTimedOut
				|
				|
				|---
				|Outcome of one nonblocking process-session stdin write.
				|---
				|union ProcessWrite:
				|	Wrote(Int)
				|	WriteWouldBlock
				|	StdinClosed
				|
				|
				|---
				|Outcome of running a compatible structured process command through a scoped
				|session. Interruption retains output captured before the child process group
				|finishes terminating.
				|---
				|union ProcessSessionCommandExecution:
				|	SessionCommandCompleted(ProcessResult)
				|	SessionCommandInterrupted(Int, Bytes, Bytes)
				|	SessionCommandFailed(ProcessError)
				|
				|
				|private RAW_STDIN_SESSION: Int = 3
				|
				|private RAW_STREAM_CAPTURE: Int = 1
				|
				|private RAW_GROUP_NEW: Int = 1
				|
				|private RAW_DEFAULT_CAPTURE_LIMIT: Int = -1
				|
				|private SESSION_COMMAND_POLL_BYTES: Int = 64 * 1024
				|
				|private SESSION_COMMAND_POLL_WAIT_MILLISECONDS: Int = 20
				|
				|
				|private record RawProcessEnvironment {
				|	set_names: List[String],
				|	set_values: List[String],
				|	unset_names: List[String]
				|}
				|
				|
				|private type alias RawProcessOptions = ((String, Bool), (List[String], List[String], List[String]), (Int, Bytes, Int, Int), (Bool, Int, Int, Int))
				|
				|private type alias RawProcessSessionCommand = (String, List[String], RawProcessOptions)
				|
				|
				|private union ProcessSessionInput:
				|	SessionNullInput
				|	SessionBytesInput(Bytes)
				|
				|
				|private union ProcessSessionCommandSuccess:
				|	SessionCommandSucceeded(ProcessResult)
				|	SessionCommandWasInterrupted(Int, Bytes, Bytes)
				|
				|
				|private record PreparedProcessSessionCommand {
				|	command: ProcessSessionCommand,
				|	input: ProcessSessionInput
				|}
				|
				|
				|private pure func raw_process_environment(
				|	changes: List[ProcessEnvironmentChange],
				|) -> Result[RawProcessEnvironment, ProcessError]:
				|	var set_names: List[String] = []
				|	var set_values: List[String] = []
				|	var unset_names: List[String] = []
				|	var failure: Option[ProcessError] = None
				|
				|	for change in changes:
				|		if failure.is_none():
				|			var duplicate_count: Int = 0
				|
				|			for candidate in changes:
				|				if candidate.name == change.name:
				|					duplicate_count += 1
				|
				|			if change.name.length() == 0:
				|				failure = Some(InvalidCommand("environment variable name is empty"))
				|			else if change.name.contains("="):
				|				failure = Some(InvalidCommand("environment variable name contains '='"))
				|			else if duplicate_count > 1:
				|				failure = Some(
				|					InvalidCommand("duplicate environment change for '" + change.name + "'"),
				|				)
				|			else:
				|				match change.value:
				|					Some(value):
				|						set_names = set_names.append(change.name)
				|						set_values = set_values.append(value)
				|					None:
				|						unset_names = unset_names.append(change.name)
				|
				|	match failure:
				|		Some(error):
				|			Err(error)
				|		None:
				|			Ok({
				|				set_names = set_names,
				|				set_values = set_values,
				|				unset_names = unset_names,
				|			})
				|
				|
				|private pure func raw_capture_limit(limit: Option[DataSize]) -> Result[Int, ProcessError]:
				|	match limit:
				|		Some(size):
				|			byte_count: Int = data_size_bytes(size)
				|
				|			if byte_count < 0:
				|				Err(InvalidCommand("capture limit must be non-negative"))
				|			else:
				|				Ok(byte_count)
				|		None:
				|			Ok(RAW_DEFAULT_CAPTURE_LIMIT)
				|
				|
				|private pure func raw_session_parts(request: ProcessSessionCommand) -> RawProcessSessionCommand:
				|	from ProcessSessionCommand(request)
				|
				|
				|private pure func session_from_parts(parts: RawProcessSessionCommand) -> ProcessSessionCommand:
				|	into ProcessSessionCommand(parts)
				|
				|
				|---
				|Create a streaming session command with no timeout or output limit override.
				|---
				|pure func session_command(program: String, args: List[String]) -> ProcessSessionCommand:
				|	session_from_parts(
				|		(
				|			program,
				|			args,
				|			(
				|				("", False),
				|				([], [], []),
				|				(RAW_STDIN_SESSION, bytes(0), RAW_STREAM_CAPTURE, RAW_STREAM_CAPTURE),
				|				(False, 0, RAW_GROUP_NEW, RAW_DEFAULT_CAPTURE_LIMIT),
				|			),
				|		),
				|	)
				|
				|
				|---
				|Return a session command with an optional child working directory.
				|---
				|pure func session_with_cwd(
				|	request: ProcessSessionCommand,
				|	cwd: Option[String],
				|) -> ProcessSessionCommand:
				|	parts = raw_session_parts(request)
				|	options = parts[2]
				|	session_from_parts(
				|		(
				|			parts[0],
				|			parts[1],
				|			((cwd.get_or(""), cwd.is_some()), options[1], options[2], options[3]),
				|		),
				|	)
				|
				|
				|---
				|Return a session command with a validated child-only environment overlay.
				|---
				|pure func session_with_environment(
				|	request: ProcessSessionCommand,
				|	changes: List[ProcessEnvironmentChange],
				|) -> Result[ProcessSessionCommand, ProcessError]:
				|	environment ?= raw_process_environment(changes)
				|	parts = raw_session_parts(request)
				|	options = parts[2]
				|	Ok(
				|		session_from_parts(
				|			(
				|				parts[0],
				|				parts[1],
				|				(
				|					options[0],
				|					(environment.set_names, environment.set_values, environment.unset_names),
				|					options[2],
				|					options[3],
				|				),
				|			),
				|		),
				|	)
				|
				|
				|---
				|Return a session command with an optional observable-lifetime timeout.
				|---
				|pure func session_with_timeout(
				|	request: ProcessSessionCommand,
				|	timeout: Option[Duration],
				|) -> ProcessSessionCommand:
				|	parts = raw_session_parts(request)
				|	options = parts[2]
				|	lifecycle = options[3]
				|	session_from_parts(
				|		(
				|			parts[0],
				|			parts[1],
				|			(
				|				options[0],
				|				options[1],
				|				options[2],
				|				(
				|					timeout.is_some(),
				|					timeout
				|						.map(to_timeout_milliseconds)
				|						.get_or(0),
				|					lifecycle[2],
				|					lifecycle[3],
				|				),
				|			),
				|		),
				|	)
				|
				|
				|---
				|Return a session command with a validated aggregate output limit.
				|---
				|pure func session_with_capture_limit(
				|	request: ProcessSessionCommand,
				|	limit: Option[DataSize],
				|) -> Result[ProcessSessionCommand, ProcessError]:
				|	capture_limit ?= raw_capture_limit(limit)
				|	parts = raw_session_parts(request)
				|	options = parts[2]
				|	lifecycle = options[3]
				|	Ok(
				|		session_from_parts(
				|			(
				|				parts[0],
				|				parts[1],
				|				(
				|					options[0],
				|					options[1],
				|					options[2],
				|					(lifecycle[0], lifecycle[1], lifecycle[2], capture_limit),
				|				),
				|			),
				|		),
				|	)
				|
				|
				|---
				|Start a scoped streaming child process.
				|
				|Use this only in a `with` binding. Scope exit closes all pipes, kills the owned
				|process group even if its leader has already exited, and reaps the leader before
				|releasing the session.
				|---
				|func start_session(request: ProcessSessionCommand) -> Result[ProcessSession, ProcessError]:
				|	builtin("blorp_process_session_start_raw")
				|
				|
				|---
				|Poll stdout, stderr, stdin readiness, and child exit once.
				|
				|At most `max_bytes` are read from each output stream. `wait` bounds only this
				|poll; non-positive waits return immediately. The command timeout passed to
				|`start_session` covers the child lifetime.
				|---
				|@resource_result_ordinary
				|func poll_session(
				|	session: ProcessSession,
				|	max_bytes: DataSize,
				|	wait: Duration,
				|) -> Result[ProcessSessionActivity, ProcessError]:
				|	builtin("blorp_process_session_poll_raw")
				|
				|
				|---
				|Return the current child lifecycle state without waiting.
				|---
				|@resource_result_ordinary
				|func session_state(session: ProcessSession) -> Result[ProcessSessionState, ProcessError]:
				|	builtin("blorp_process_session_state_raw")
				|
				|
				|---
				|Attempt one nonblocking write to the child stdin pipe.
				|---
				|@resource_result_ordinary
				|func write_stdin(session: ProcessSession, data: Bytes) -> Result[ProcessWrite, ProcessError]:
				|	builtin("blorp_process_session_write_raw")
				|
				|
				|---
				|Attempt one nonblocking write beginning at `offset` in `data`.
				|
				|This avoids allocating a fresh suffix after a partial pipe write. The returned
				|count is relative to the requested suffix.
				|---
				|@resource_result_ordinary
				|func write_stdin_from(
				|	session: ProcessSession,
				|	data: Bytes,
				|	offset: Int,
				|) -> Result[ProcessWrite, ProcessError]:
				|	builtin("blorp_process_session_write_from_raw")
				|
				|
				|---
				|Close the child stdin pipe. Repeated calls succeed without side effects.
				|---
				|@resource_result_ordinary
				|func close_stdin(session: ProcessSession) -> Result[Void, ProcessError]:
				|	builtin("blorp_process_session_close_stdin_raw")
				|
				|
				|---
				|Request graceful termination of the child process group.
				|---
				|@resource_result_ordinary
				|func terminate_session(session: ProcessSession) -> Result[Void, ProcessError]:
				|	builtin("blorp_process_session_terminate_raw")
				|
				|
				|---
				|Immediately kill the child process group. Polling still drains output and
				|reports the final exit state.
				|---
				|@resource_result_ordinary
				|func kill_session(session: ProcessSession) -> Result[Void, ProcessError]:
				|	builtin("blorp_process_session_kill_raw")
				|
				|
				|---
				|Convert a session lifecycle state to a completed process exit when available.
				|---
				|pure func session_exit(state: ProcessSessionState) -> Option[ProcessExit]:
				|	match state:
				|		SessionRunning:
				|			None
				|		SessionExited(code):
				|			Some(Exited(code))
				|		SessionSignaled(signal):
				|			Some(Signaled(signal))
				|		SessionTimedOut:
				|			Some(TimedOut)
				|
				|
				|private pure func prepare_session_command(
				|	request: ProcessCommand,
				|) -> Result[PreparedProcessSessionCommand, ProcessError]:
				|	input_result: Result[ProcessSessionInput, ProcessError] = match request.stdin:
				|		InheritStdin:
				|			Err(InvalidCommand("process sessions cannot inherit stdin"))
				|		NullStdin:
				|			Ok(SessionNullInput)
				|		BytesStdin(data):
				|			Ok(SessionBytesInput(data))
				|
				|	input ?= input_result
				|
				|	stdout_validation: Result[Void, ProcessError] = match request.stdout:
				|		CaptureStream:
				|			Ok(void)
				|		_:
				|			Err(InvalidCommand("process sessions require captured stdout and stderr"))
				|
				|	ignored_stdout_validation ?= stdout_validation
				|
				|	stderr_validation: Result[Void, ProcessError] = match request.stderr:
				|		CaptureStream:
				|			Ok(void)
				|		_:
				|			Err(InvalidCommand("process sessions require captured stdout and stderr"))
				|
				|	ignored_stderr_validation ?= stderr_validation
				|
				|	group_validation: Result[Void, ProcessError] = match request.process_group:
				|		NewProcessGroup:
				|			Ok(void)
				|		InheritProcessGroup:
				|			Err(InvalidCommand("process sessions require a new process group"))
				|
				|	ignored_group_validation ?= group_validation
				|
				|	configured_environment ?= session_with_environment(
				|		session_with_cwd(
				|			session_command(request.program, request.args),
				|			request.cwd,
				|		),
				|		request.environment,
				|	)
				|	configured_capture ?= session_with_capture_limit(
				|		session_with_timeout(configured_environment, request.timeout),
				|		request.capture_limit,
				|	)
				|
				|	Ok({
				|		command = configured_capture,
				|		input = input,
				|	})
				|
				|
				|private func no_session_command_interruption() -> Option[Int]:
				|	None
				|
				|
				|---
				|Run a compatible structured process command in a scoped session.
				|
				|The adapter accepts byte or null stdin, captured stdout and stderr, and a new
				|process group. Other modes are rejected instead of silently changing their
				|semantics.
				|---
				|func run_session_command(request: ProcessCommand) -> ProcessSessionCommandExecution:
				|	run_session_command_until(request, no_session_command_interruption)
				|
				|
				|---
				|Run a compatible structured process command until completion or cancellation.
				|
				|The callback returns the signal number to report when interruption is
				|requested. The session first requests graceful termination, then its lifecycle
				|automatically escalates to killing the owned process group after the runtime's
				|bounded grace period while output continues to drain.
				|---
				|func run_session_command_until(
				|	request: ProcessCommand,
				|	interrupt_requested: () -> Option[Int],
				|) -> ProcessSessionCommandExecution:
				|	match prepare_session_command(request):
				|		Err(error):
				|			SessionCommandFailed(error)
				|		Ok(prepared):
				|			match run_prepared_session_command_until(prepared, interrupt_requested):
				|				Err(error):
				|					SessionCommandFailed(error)
				|				Ok(SessionCommandSucceeded(result)):
				|					SessionCommandCompleted(result)
				|				Ok(SessionCommandWasInterrupted(signal, stdout, stderr)):
				|					SessionCommandInterrupted(signal, stdout, stderr)
				|
				|
				|private func run_prepared_session_command_until(
				|	prepared: PreparedProcessSessionCommand,
				|	interrupt_requested: () -> Option[Int],
				|) -> Result[ProcessSessionCommandSuccess, ProcessError]:
				|	with session ?= start_session(prepared.command):
				|		var stdout_parts: List[Bytes] = []
				|		var stderr_parts: List[Bytes] = []
				|		var input_offset: Int = 0
				|		var stdin_closed: Bool = False
				|		var streams_open: Bool = True
				|		var exit: Option[ProcessExit] = None
				|		var interruption: Option[Int] = None
				|		var failure: Option[ProcessError] = None
				|
				|		while failure.is_none() and (exit.is_none() or streams_open):
				|			if interruption.is_none():
				|				match interrupt_requested():
				|					Some(signal):
				|						interruption = Some(signal)
				|
				|						match close_stdin(session):
				|							Err(error):
				|								failure = Some(error)
				|							Ok(_):
				|								stdin_closed = True
				|
				|						if failure.is_none():
				|							match terminate_session(session):
				|								Err(error):
				|									failure = Some(error)
				|								Ok(_):
				|									void
				|					None:
				|						void
				|
				|			if (
				|				interruption.is_none()
				|				and failure.is_none()
				|				and not stdin_closed
				|			):
				|				match prepared.input:
				|					SessionNullInput:
				|						match close_stdin(session):
				|							Err(error):
				|								failure = Some(error)
				|							Ok(_):
				|								stdin_closed = True
				|					SessionBytesInput(input):
				|						if input_offset >= input.length():
				|							match close_stdin(session):
				|								Err(error):
				|									failure = Some(error)
				|								Ok(_):
				|									stdin_closed = True
				|						else:
				|							match write_stdin_from(session, input, input_offset):
				|								Err(error):
				|									failure = Some(error)
				|								Ok(Wrote(count)):
				|									if count <= 0:
				|										failure = Some(
				|											ProcessIoFailed(
				|												"process session made no stdin write progress",
				|											),
				|										)
				|									else:
				|										input_offset += count
				|
				|										if input_offset >= input.length():
				|											match close_stdin(session):
				|												Err(error):
				|													failure = Some(error)
				|												Ok(_):
				|													stdin_closed = True
				|								Ok(WriteWouldBlock):
				|									void
				|								Ok(StdinClosed):
				|									stdin_closed = True
				|
				|			if failure.is_none():
				|				match poll_session(
				|					session,
				|					from_bytes(SESSION_COMMAND_POLL_BYTES),
				|					milliseconds(SESSION_COMMAND_POLL_WAIT_MILLISECONDS),
				|				):
				|					Err(error):
				|						failure = Some(error)
				|					Ok(activity):
				|						if activity.stdout.length() > 0:
				|							stdout_parts = stdout_parts.append(activity.stdout)
				|
				|						if activity.stderr.length() > 0:
				|							stderr_parts = stderr_parts.append(activity.stderr)
				|
				|						streams_open = activity.stdout_open or activity.stderr_open
				|						stdin_closed = stdin_closed or not activity.stdin_open
				|
				|						match session_state(session):
				|							Err(error):
				|								failure = Some(error)
				|							Ok(state):
				|								exit = session_exit(state)
				|
				|		stdout: Bytes = concat_bytes(stdout_parts)
				|		stderr: Bytes = concat_bytes(stderr_parts)
				|
				|		match failure:
				|			Some(error):
				|				Err(error)
				|			None:
				|				match interruption:
				|					Some(signal):
				|						Ok(SessionCommandWasInterrupted(signal, stdout, stderr))
				|					None:
				|						match exit:
				|							Some(completed_exit):
				|								Ok(SessionCommandSucceeded({
				|									exit = completed_exit,
				|									stdout = stdout,
				|									stderr = stderr,
				|								}))
				|							None:
				|								Err(ProcessIoFailed("process session ended without an exit status"))
				|
			Some(source)
		"std/property":
			source: String = raw
				|-- Property — Property-based testing with shrinking
				|--
				|-- Generates random inputs and checks that properties hold.
				|-- Uses the pure SplitMix64 RNG from random — all generators are pure.
				|--
				|-- Typical use: import the generators and `check` from `property`.
				|--
				|-- func main(args: List[String]):
				|-- ok: Bool = check("addition is commutative", 100, gen_int(-100, 100),
				|-- pure func(x: Int): x + 0 == x)
				|-- if ok: 0 else: 1
				|import:
				|	random:
				|		RngState,
				|		RngStep,
				|		rng_bool,
				|		rng_float,
				|		rng_int,
				|		rng_new,
				|		rng_next_state,
				|		rng_step,
				|		rng_value,
				|	string: string
				|
				|
				|-- ============================================================================
				|-- Generator Type
				|-- ============================================================================
				|-- A generator is a pure function: RNG state -> generated value and next state.
				|type alias Gen[T] = pure (RngState) -> RngStep[T]
				|
				|
				|-- ============================================================================
				|-- Primitive Generators
				|-- ============================================================================
				|---
				|Generate a random Int in [lo, hi).
				|---
				|pure func gen_int(lo: Int, hi: Int) -> Gen[Int]:
				|	pure func(state: RngState) -> RngStep[Int]: rng_int(state, lo, hi)
				|
				|
				|---
				|Generate a random Float in [0.0, 1.0).
				|---
				|pure func gen_float() -> Gen[Float]:
				|	pure func(state: RngState) -> RngStep[Float]: rng_float(state)
				|
				|
				|---
				|Generate a random Float in [min, max).
				|---
				|pure func gen_float_range(lo: Float, hi: Float) -> Gen[Float]:
				|	pure func(state: RngState) -> RngStep[Float]:
				|		r: RngStep[Float] = rng_float(state)
				|		rng_step(lo + r.rng_value() * (hi - lo), r.rng_next_state())
				|
				|
				|---
				|Generate a random Bool.
				|---
				|pure func gen_bool() -> Gen[Bool]:
				|	pure func(state: RngState) -> RngStep[Bool]: rng_bool(state)
				|
				|
				|---
				|Generate a constant value (always the same).
				|---
				|pure func gen_const[T](value: T) -> Gen[T]:
				|	pure func(state: RngState) -> RngStep[T]: rng_step(value, state)
				|
				|
				|-- ============================================================================
				|-- Combinator Generators
				|-- ============================================================================
				|---
				|Transform a generator's output with a pure function.
				|---
				|pure func gen_map[A, B](
				|	gen: Gen[A],
				|	f: pure (A) -> B,
				|) -> Gen[B]:
				|	pure func(state: RngState) -> RngStep[B]:
				|		r: RngStep[A] = gen(state)
				|		rng_step(f(r.rng_value()), r.rng_next_state())
				|
				|
				|---
				|Generate one of two values based on a random Bool.
				|---
				|pure func gen_one_of_2[T](a: Gen[T], b: Gen[T]) -> Gen[T]:
				|	pure func(state: RngState) -> RngStep[T]:
				|		coin: RngStep[Bool] = rng_bool(state)
				|
				|		if coin.rng_value():
				|			a(coin.rng_next_state())
				|		else:
				|			b(coin.rng_next_state())
				|
				|
				|---
				|Generate a list of random length [0, max_len) with the given element generator.
				|---
				|pure func gen_list[T](elem: Gen[T], max_len: Int) -> Gen[List[T]]:
				|	pure func(state: RngState) -> RngStep[List[T]]:
				|		len_result: RngStep[Int] = rng_int(state, 0, max_len)
				|		n: Int = len_result.rng_value()
				|		var st: RngState = len_result.rng_next_state()
				|		var result: List[T] = []
				|		var i: Int = 0
				|
				|		while i < n:
				|			item: RngStep[T] = elem(st)
				|			result = result.append(item.rng_value())
				|			st = item.rng_next_state()
				|			i += 1
				|
				|		rng_step(result, st)
				|
				|
				|---
				|Generate an Option[T] — Some(value) 75% of the time, None 25%.
				|---
				|pure func gen_option[T](inner: Gen[T]) -> Gen[Option[T]]:
				|	pure func(state: RngState) -> RngStep[Option[T]]:
				|		r: RngStep[Int] = rng_int(state, 0, 4)
				|
				|		if r.rng_value() == 0:
				|			rng_step(None, r.rng_next_state())
				|		else:
				|			val: RngStep[T] = inner(r.rng_next_state())
				|			rng_step(Some(val.rng_value()), val.rng_next_state())
				|
				|
				|---
				|Generate a random ASCII string of length [0, max_len).
				|---
				|pure func gen_string(max_len: Int) -> Gen[String]:
				|	pure func(state: RngState) -> RngStep[String]:
				|		len_result: RngStep[Int] = rng_int(state, 0, max_len)
				|		n: Int = len_result.rng_value()
				|		var st: RngState = len_result.rng_next_state()
				|		var buf: String = string(n)
				|		var i: Int = 0
				|
				|		while i < n:
				|			ch: RngStep[Int] = rng_int(st, 32, 127)
				|			buf = buf.append_char(to_char(ch.rng_value()))
				|			st = ch.rng_next_state()
				|			i += 1
				|
				|		rng_step(buf, st)
				|
				|
				|---
				|Generate a random alphanumeric string of length [0, max_len).
				|---
				|pure func gen_alphanumeric(max_len: Int) -> Gen[String]:
				|	pure func(state: RngState) -> RngStep[String]:
				|		len_result: RngStep[Int] = rng_int(state, 0, max_len)
				|		n: Int = len_result.rng_value()
				|		var st: RngState = len_result.rng_next_state()
				|		chars: String = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
				|		var buf: String = string(n)
				|		var i: Int = 0
				|
				|		while i < n:
				|			idx: RngStep[Int] = rng_int(st, 0, 62)
				|
				|			match chars.get(idx.rng_value()):
				|				Some(c):
				|					buf = buf.append_char(c)
				|				None:
				|					void
				|
				|			st = idx.rng_next_state()
				|			i += 1
				|
				|		rng_step(buf, st)
				|
				|
				|-- ============================================================================
				|-- Property Checking
				|-- ============================================================================
				|---
				|Check a property over N random inputs. Prints failures with the offending input.
				|Returns True if all tests pass.
				|
				|doctests:
				|    :: Identity property passes
				|    check(
				|        "x + 0 == x",
				|        50,
				|        gen_int(
				|            -100,
				|            100,
				|        ),
				|        pure func(x: Int): x + 0 == x,
				|    )
				|---
				|func check[T:Stringable](
				|	name: String,
				|	num_tests: Int,
				|	gen: Gen[T],
				|	prop: pure (T) -> Bool,
				|) -> Bool:
				|	var state: RngState = rng_new(12345)
				|	var passed: Int = 0
				|	var failed: Bool = False
				|	var i: Int = 0
				|
				|	while i < num_tests and not failed:
				|		result: RngStep[T] = gen(state)
				|		val: T = result.rng_value()
				|		state = result.rng_next_state()
				|
				|		if prop(val):
				|			passed += 1
				|		else:
				|			print(
				|				"  FAIL: " + name + " — counterexample: " + to_string(
				|					val,
				|				) + " (test " + (i + 1).to_string() + ")",
				|			)
				|			failed = True
				|
				|		i += 1
				|
				|	if not failed:
				|		print("  OK: " + name + " (" + passed.to_string() + " tests)")
				|
				|	not failed
				|
				|
				|---
				|Check a property with two random inputs.
				|---
				|func check2[A:Stringable, B:Stringable](
				|	name: String,
				|	num_tests: Int,
				|	gen_a: Gen[A],
				|	gen_b: Gen[B],
				|	prop: pure (A, B) -> Bool,
				|) -> Bool:
				|	var state: RngState = rng_new(12345)
				|	var passed: Int = 0
				|	var failed: Bool = False
				|	var i: Int = 0
				|
				|	while i < num_tests and not failed:
				|		ra: RngStep[A] = gen_a(state)
				|		rb: RngStep[B] = gen_b(ra.rng_next_state())
				|		state = rb.rng_next_state()
				|
				|		if prop(ra.rng_value(), rb.rng_value()):
				|			passed += 1
				|		else:
				|			print(
				|				"  FAIL: " + name + " — counterexample: (" + to_string(ra.rng_value()) + ", " + rb
				|					.rng_value()
				|					.to_string() + ") (test " + (i + 1).to_string() + ")",
				|			)
				|			failed = True
				|
				|		i += 1
				|
				|	if not failed:
				|		print("  OK: " + name + " (" + passed.to_string() + " tests)")
				|
				|	not failed
				|
				|
				|-- ============================================================================
				|-- Shrinking
				|-- ============================================================================
				|---
				|Shrink an Int toward zero. Returns a list of simpler values.
				|---
				|pure func shrink_int(n: Int) -> List[Int]:
				|	if n == 0:
				|		[]
				|	else:
				|		-- Generate candidates between 0 and n (closer to zero)
				|		var result: List[Int] = [0]
				|		var abs_n: Int = n
				|
				|		if abs_n < 0:
				|			abs_n = 0 - abs_n
				|
				|		var s: Int = abs_n / 2
				|
				|		while s > 0:
				|			-- For positive n: candidates are n - s (between 0 and n)
				|			-- For negative n: candidates are n + s (between n and 0)
				|			if n > 0:
				|				result = result.append(n - s)
				|			else:
				|				result = result.append(n + s)
				|
				|			s /= 2
				|
				|		result
				|
				|
				|---
				|Check a property with shrinking on failure. Finds a minimal counterexample.
				|---
				|func check_shrink(
				|	name: String,
				|	num_tests: Int,
				|	gen: Gen[Int],
				|	prop: pure (Int) -> Bool,
				|) -> Bool:
				|	var state: RngState = rng_new(12345)
				|	var failed: Bool = False
				|	var i: Int = 0
				|
				|	while i < num_tests and not failed:
				|		result: RngStep[Int] = gen(state)
				|		val: Int = result.rng_value()
				|		state = result.rng_next_state()
				|
				|		if not prop(val):
				|			-- Found failure, try shrinking
				|			var smallest: Int = val
				|			candidates: List[Int] = shrink_int(val)
				|			var j: Int = 0
				|
				|			while j < candidates.length():
				|				match candidates.get(j):
				|					Some(c):
				|						if not prop(c):
				|							smallest = c
				|					None:
				|						void
				|
				|				j += 1
				|
				|			print(
				|				"  FAIL: " + name + " — smallest counterexample: " + to_string(
				|					smallest,
				|				) + " (original: " + val.to_string() + ")",
				|			)
				|			failed = True
				|
				|		i += 1
				|
				|	if not failed:
				|		print("  OK: " + name + " (" + num_tests.to_string() + " tests)")
				|
				|	not failed
				|
			Some(source)
		"std/ptr":
			source: String = raw
				|-- Ptr - Opaque C pointer.
				|--
				|-- Used exclusively for interop with C code declared via [foreign:].
				|-- Blorp code cannot dereference a [Ptr]; pointer arithmetic, allocation,
				|-- and deallocation all happen on the C side. A [Ptr] value is passed
				|-- through as a [void*] at the C ABI boundary.
				|--
				|-- Example:
				|-- foreign:
				|--     func sdl_load_texture(path: String) -> Ptr = "SDL_LoadTexture"
				|type Ptr = builtin
				|
			Some(source)
		"std/random":
			source: String = raw
				|-- Random - Random number generation
				|--
				|-- Provides deterministic pseudo-random number generation using
				|-- thread-local rand_r() state. Seed with seed_random() for
				|-- reproducible sequences.
				|--
				|-- All random functions are impure (modify internal RNG state).
				|--
				|-- For pure/deterministic random, use the rng_* functions which
				|-- take and return explicit state (SplitMix64 algorithm).
				|-- ============================================================================
				|-- Core Random Operations (builtins, impure)
				|-- ============================================================================
				|---
				|Seed the random number generator for deterministic sequences.
				|Call before generating random values to get reproducible results.
				|---
				|func seed_random(seed: Int) -> Void:
				|	builtin("blorp_seed_random")
				|
				|
				|---
				|Generate a random integer in [min, max) half-open range.
				|Empty or inverted range returns min.
				|
				|doctests:
				|    :: Random int in range
				|    seed_random(42)
				|    x: Int = random_int(1, 7)
				|    x >= 1 and x < 7
				|---
				|func random_int(min: Int, max: Int) -> Int:
				|	builtin("blorp_random_int")
				|
				|
				|---
				|Generate a random float in [0.0, 1.0).
				|
				|doctests:
				|    :: Random float in unit interval
				|    seed_random(42)
				|    x: Float = random_float()
				|    x >= 0.0 and x < 1.0
				|---
				|func random_float() -> Float:
				|	builtin("blorp_random_float")
				|
				|
				|-- ============================================================================
				|-- Convenience Functions (impure)
				|-- ============================================================================
				|---
				|Generate a random boolean (50/50 chance).
				|
				|doctests:
				|    :: Random bool is True or False
				|    seed_random(42)
				|    b: Bool = random_bool()
				|    b == True or b == False
				|---
				|func random_bool() -> Bool:
				|	random_float() < 0.5
				|
				|
				|---
				|Pick a random element from a list, or None if empty.
				|
				|doctests:
				|    :: Choice picks from list
				|    seed_random(42)
				|    items: List[Int] = [10, 20, 30]
				|
				|    match choice(items):
				|        Some(v):
				|            v == 10 or v == 20 or v == 30
				|        None:
				|            False
				|---
				|func choice[T](items: List[T]) -> Option[T]:
				|	len: Int = items.length()
				|
				|	if len == 0:
				|		None
				|	else:
				|		idx: Int = random_int(0, len)
				|		items.get(idx)
				|
				|
				|-- ============================================================================
				|-- Pure PRNG (SplitMix64)
				|-- ============================================================================
				|-- State has an Int representation, but callers use RngState and RngStep.
				|-- All functions are pure -- no global state mutation.
				|-- Uses SplitMix64 algorithm (pure bitwise arithmetic).
				|opaque type RngState = Int
				|
				|opaque type RngStep[T] = (T, RngState)
				|
				|private SPLITMIX_GAMMA: Int = -7046029254386353131
				|
				|private SPLITMIX_MIX_MULTIPLIER_1: Int = -4658895280553007687
				|
				|private SPLITMIX_MIX_MULTIPLIER_2: Int = -7723592293110705685
				|
				|private SPLITMIX_FLOAT_SHIFT: Int = 11
				|
				|private SPLITMIX_FLOAT_DENOMINATOR: Float = 9007199254740992.0
				|
				|
				|---
				|Value produced by a pure RNG step.
				|---
				|pure func rng_value[T](step: RngStep[T]) -> T:
				|	parts: (T, RngState) = from RngStep[T](step)
				|	parts[0]
				|
				|
				|---
				|State to pass to the next pure RNG call.
				|---
				|pure func rng_next_state[T](step: RngStep[T]) -> RngState:
				|	parts: (T, RngState) = from RngStep[T](step)
				|	parts[1]
				|
				|
				|---
				|Compare two pure RNG states explicitly.
				|---
				|pure func rng_state_equal(a: RngState, b: RngState) -> Bool:
				|	rng_state_raw(a) == rng_state_raw(b)
				|
				|
				|---
				|Construct a pure RNG step from a value and next state.
				|Useful for custom generators built on RngState.
				|---
				|pure func rng_step[T](value: T, next_state: RngState) -> RngStep[T]:
				|	into RngStep[T]((value, next_state))
				|
				|
				|private pure func rng_state_raw(state: RngState) -> Int:
				|	from RngState(state)
				|
				|
				|private pure func rng_state_from_raw(raw: Int) -> RngState:
				|	into RngState(raw)
				|
				|
				|-- SplitMix64 mixing function
				|private pure func __unsigned_shift_right(x: Int, n: Int) -> Int:
				|	if n <= 0:
				|		x
				|	else if n >= 64:
				|		0
				|	else:
				|		shifted: Int = shift_right(x, n)
				|
				|		if x < 0:
				|			shifted + shift_left(1, 64 - n)
				|		else:
				|			shifted
				|
				|
				|private pure func __splitmix64(s: Int) -> Int:
				|	var z: Int = s + SPLITMIX_GAMMA
				|	z = bit_xor(
				|		z,
				|		__unsigned_shift_right(z, 30),
				|	) * SPLITMIX_MIX_MULTIPLIER_1
				|	z = bit_xor(
				|		z,
				|		__unsigned_shift_right(z, 27),
				|	) * SPLITMIX_MIX_MULTIPLIER_2
				|	bit_xor(
				|		z,
				|		__unsigned_shift_right(z, 31),
				|	)
				|
				|
				|---
				|Create a new RNG state from a seed. Pure.
				|
				|doctests:
				|    :: Seed creates deterministic state
				|    rng_state_equal(rng_new(42), rng_new(42))
				|---
				|pure func rng_new(seed: Int) -> RngState:
				|	rng_state_from_raw(seed)
				|
				|
				|---
				|Generate the next random Int. Pure.
				|
				|doctests:
				|    :: rng_next is deterministic
				|    r1 = rng_next(rng_new(42))
				|    r2 = rng_next(rng_new(42))
				|    r1.rng_value() == r2.rng_value()
				|---
				|pure func rng_next(state: RngState) -> RngStep[Int]:
				|	raw_state: Int = rng_state_raw(state)
				|	new_state: RngState = rng_state_from_raw(raw_state + SPLITMIX_GAMMA)
				|	value: Int = __splitmix64(raw_state)
				|	rng_step(value, new_state)
				|
				|
				|---
				|Generate a random Float in [0.0, 1.0). Pure.
				|
				|doctests:
				|    :: rng_float in unit interval
				|    r = rng_float(rng_new(42))
				|    r.rng_value() >= 0.0 and r.rng_value() < 1.0
				|---
				|pure func rng_float(state: RngState) -> RngStep[Float]:
				|	raw_state: Int = rng_state_raw(state)
				|	new_state: RngState = rng_state_from_raw(raw_state + SPLITMIX_GAMMA)
				|	value: Int = __splitmix64(raw_state)
				|	f: Float = to_float(
				|		__unsigned_shift_right(
				|			value,
				|			SPLITMIX_FLOAT_SHIFT,
				|		),
				|	) * (1.0 / SPLITMIX_FLOAT_DENOMINATOR)
				|	rng_step(f, new_state)
				|
				|
				|---
				|Generate a random Int in [min, max). Pure.
				|
				|doctests:
				|    :: rng_int in range
				|    r = rng_int(rng_new(42), 1, 100)
				|    r.rng_value() >= 1 and r.rng_value() < 100
				|---
				|pure func rng_int(state: RngState, min: Int, max: Int) -> RngStep[Int]:
				|	r: RngStep[Int] = rng_next(state)
				|	val: Int = r.rng_value()
				|	range: Int = max - min
				|
				|	-- Make positive and mod to range
				|	var v: Int = val
				|
				|	if v < 0:
				|		v = -(v + 1)
				|
				|	v = v % range + min
				|	rng_step(v, r.rng_next_state())
				|
				|
				|---
				|Generate a random Bool. Pure.
				|
				|doctests:
				|    :: rng_bool returns Bool
				|    r = rng_bool(rng_new(42))
				|    r.rng_value() == True or r.rng_value() == False
				|---
				|pure func rng_bool(state: RngState) -> RngStep[Bool]:
				|	r: RngStep[Float] = rng_float(state)
				|	rng_step(r.rng_value() < 0.5, r.rng_next_state())
				|
			Some(source)
		"std/range":
			source: String = raw
				|-- First-class integer range values.
				|--
				|-- `start..end` is half-open: it includes `start` and excludes `end`.
				|-- Backwards ranges iterate down, still excluding `end`. Empty ranges iterate
				|-- zero times.
				|import:
				|	list: List
				|
				|
				|struct Range {
				|	start: Int,
				|	end: Int
				|}
				|
				|
				|---
				|Return the number of integers in the range.
				|
				|doctests:
				|    :: Ascending range
				|    (0..5).length() == 5
				|
				|    :: Descending range
				|    (5..2).length() == 3
				|
				|    :: Empty range
				|    (3..3).length() == 0
				|---
				|pure func length(self: Range) -> Int:
				|	if self.start <= self.end:
				|		self.end - self.start
				|	else:
				|		self.start - self.end
				|
				|
				|---
				|Return True when the range contains no values.
				|---
				|pure func is_empty(self: Range) -> Bool:
				|	self.start == self.end
				|
				|
				|---
				|Return True when `value` is inside the half-open range.
				|The start is included and the end is excluded for both directions.
				|
				|doctests:
				|    :: Ascending contains
				|    (2..5).contains(4) == True
				|
				|    :: Ascending excludes end
				|    (2..5).contains(5) == False
				|
				|    :: Descending contains
				|    (5..2).contains(3) == True
				|
				|    :: Descending excludes end
				|    (5..2).contains(2) == False
				|---
				|pure func contains(self: Range, value: Int) -> Bool:
				|	if self.start <= self.end:
				|		value >= self.start and value < self.end
				|	else:
				|		value <= self.start and value > self.end
				|
				|
				|---
				|Collect the range into a list of Int values.
				|
				|doctests:
				|    :: Ascending list
				|    (1..4).to_list() == [1, 2, 3]
				|
				|    :: Descending list
				|    (4..1).to_list() == [4, 3, 2]
				|---
				|pure func to_list(self: Range) -> List[Int]:
				|	var result: List[Int] = []
				|
				|	for value in self:
				|		result = result.append(value)
				|
				|	result
				|
				|
				|---
				|Fold over all values in the range.
				|---
				|func fold[Acc](
				|	self: Range,
				|	init: Acc,
				|	f: (Acc, Int) -> Acc,
				|) -> Acc:
				|pure func fold[Acc](
				|	self: Range,
				|	init: Acc,
				|	f: pure (Acc, Int) -> Acc,
				|) -> Acc:
				|	var acc: Acc = init
				|
				|	for value in self:
				|		acc = f(acc, value)
				|
				|	acc
				|
				|
				|---
				|Apply a side-effecting function to each value in the range.
				|---
				|func for_each(
				|	self: Range,
				|	f: (Int) -> Void,
				|) -> Void:
				|	for value in self:
				|		f(value)
				|
			Some(source)
		"std/regex":
			source: String = raw
				|-- Regex - Regular expression operations (POSIX Extended)
				|--
				|-- Uses POSIX Extended Regular Expressions (ERE) via regex.h.
				|-- All functions return Result to handle invalid patterns.
				|--
				|-- POSIX ERE limitations (by design — no external dependencies):
				|-- - No non-greedy quantifiers (*?, +?)
				|-- - No lookahead/lookbehind (?=...), (?<=...)
				|-- - No Unicode character classes (\p{L})
				|-- - No backreferences in replacement strings
				|--
				|-- Supported syntax: . * + ? [] [^] () | {} ^ $ \b
				|-- Character classes: [a-z] [0-9] [[:alpha:]] [[:digit:]] etc.
				|-- ============================================================================
				|-- Core Regex Operations (builtins)
				|-- ============================================================================
				|---
				|Test if pattern matches anywhere in text.
				|Returns Ok(True) if match found, Ok(False) if not, Err(msg) for invalid pattern.
				|
				|doctests:
				|    :: Pattern matches
				|    match test_regex("[0-9]+", "abc123"):
				|        Ok(v):
				|            v == True
				|        Err(_):
				|            False
				|
				|    :: Pattern does not match
				|    match test_regex("[0-9]+", "abc"):
				|        Ok(v):
				|            v == False
				|        Err(_):
				|            False
				|---
				|pure func test_regex(pattern: String, text: String) -> Result[Bool, String]:
				|	builtin("blorp_regex_test")
				|
				|
				|---
				|Find first match with capture groups.
				|Returns Ok(Some([full_match, group1, ...])) on match, Ok(None) if no match.
				|
				|doctests:
				|    :: Find first match
				|    match "[0-9]+".find("abc123def"):
				|        Ok(result):
				|            match result:
				|                Some(matches):
				|                    matches.length() > 0
				|                None:
				|                    False
				|        Err(_):
				|            False
				|---
				|pure func find(pattern: String, text: String) -> Result[Option[List[String]], String]:
				|	builtin("blorp_regex_find")
				|
				|
				|---
				|Replace all occurrences of pattern with replacement.
				|Returns Ok(result_string), Err(msg) for invalid pattern.
				|
				|doctests:
				|    :: Replace all matches
				|    match "[0-9]+".replace_all("NUM", "abc123def456"):
				|        Ok(v):
				|            v == "abcNUMdefNUM"
				|        Err(_):
				|            False
				|---
				|pure func replace_all(pattern: String, replacement: String, text: String) -> Result[String, String]:
				|	builtin("blorp_regex_replace_all")
				|
				|
				|---
				|Find all non-overlapping matches (full matches only, no groups).
				|Returns Ok([match1, match2, ...]), Err(msg) for invalid pattern.
				|
				|doctests:
				|    :: Find all matches
				|    match find_all("[0-9]+", "abc123def456"):
				|        Ok(matches):
				|            matches.length() == 2
				|        Err(_):
				|            False
				|---
				|pure func find_all(pattern: String, text: String) -> Result[List[String], String]:
				|	builtin("blorp_regex_find_all")
				|
			Some(source)
		"std/result":
			source: String = raw
				|-- Result - Error handling type
				|--
				|-- Result[T, E] represents either success (Ok) or failure (Err).
				|-- Used for functions that can fail in predictable ways.
				|-- Union (sum type) definition
				|union Result[T, E]:
				|	Ok(T)
				|	Err(E)
				|
				|
				|---
				|Check if result is success.
				|
				|doctests:
				|    :: Ok is ok
				|    ok: Result[Int, String] = Ok(42)
				|    is_ok(ok) == True
				|
				|    :: Err is not ok
				|    err: Result[Int, String] = Err("fail")
				|    is_ok(err) == False
				|---
				|pure func is_ok[T, E](self: Result[T, E]) -> Bool:
				|	match self:
				|		Ok(_):
				|			True
				|		Err(_):
				|			False
				|
				|
				|---
				|Check if result is error.
				|
				|doctests:
				|    :: Err is err
				|    err: Result[Int, String] = Err("fail")
				|    is_err(err) == True
				|
				|    :: Ok is not err
				|    ok: Result[Int, String] = Ok(42)
				|    is_err(ok) == False
				|---
				|pure func is_err[T, E](self: Result[T, E]) -> Bool:
				|	match self:
				|		Ok(_):
				|			False
				|		Err(_):
				|			True
				|
				|
				|---
				|Get the value or return a default.
				|---
				|pure func get_or[T, E](self: Result[T, E], default: T) -> T:
				|	match self:
				|		Ok(val):
				|			val
				|		Err(_):
				|			default
				|
				|
				|func get_or_else[T, E](
				|	self: Result[T, E],
				|	default_fn: (E) -> T,
				|) -> T:
				|pure func get_or_else[T, E](
				|	self: Result[T, E],
				|	default_fn: pure (E) -> T,
				|) -> T:
				|	match self:
				|		Ok(val):
				|			val
				|		Err(e):
				|			default_fn(e)
				|
				|
				|---
				|Map a function over the success value.
				|---
				|func map[T, U, E](
				|	self: Result[T, E],
				|	f: (T) -> U,
				|) -> Result[U, E]:
				|pure func map[T, U, E](
				|	self: Result[T, E],
				|	f: pure (T) -> U,
				|) -> Result[U, E]:
				|	match self:
				|		Ok(val):
				|			r: Result[U, E] = Ok(f(val))
				|			r
				|		Err(e):
				|			r: Result[U, E] = Err(e)
				|			r
				|
				|
				|---
				|Map a function over the error value.
				|---
				|func map_err[T, E, F](
				|	self: Result[T, E],
				|	f: (E) -> F,
				|) -> Result[T, F]:
				|pure func map_err[T, E, F](
				|	self: Result[T, E],
				|	f: pure (E) -> F,
				|) -> Result[T, F]:
				|	match self:
				|		Ok(val):
				|			r: Result[T, F] = Ok(val)
				|			r
				|		Err(e):
				|			Err(f(e))
				|
				|
				|---
				|Chain operations that can fail.
				|Returns f(val) if Ok, propagates Err otherwise.
				|---
				|func and_then[T, U, E](
				|	self: Result[T, E],
				|	f: (T) -> Result[U, E],
				|) -> Result[U, E]:
				|pure func and_then[T, U, E](
				|	self: Result[T, E],
				|	f: pure (T) -> Result[U, E],
				|) -> Result[U, E]:
				|	match self:
				|		Ok(val):
				|			f(val)
				|		Err(e):
				|			Err(e)
				|
				|
				|---
				|Convert Option to Result, using given error if None.
				|
				|doctests:
				|    :: Some converts to Ok
				|    match from_option(Some(42), "missing"):
				|        Ok(v):
				|            v == 42
				|        Err(_):
				|            False
				|
				|    :: None converts to Err
				|    opt: Option[Int] = None
				|
				|    match from_option(opt, "missing"):
				|        Ok(_):
				|            False
				|        Err(e):
				|            e == "missing"
				|---
				|pure func from_option[T, E](opt: Option[T], error: E) -> Result[T, E]:
				|	match opt:
				|		Some(val):
				|			r: Result[T, E] = Ok(val)
				|			r
				|		None:
				|			Err(error)
				|
				|
				|---
				|Convert Result to Option, discarding the error.
				|
				|doctests:
				|    :: Ok converts to Some
				|    ok: Result[Int, String] = Ok(42)
				|
				|    match to_option(ok):
				|        Some(v):
				|            v == 42
				|        None:
				|            False
				|---
				|pure func to_option[T, E](self: Result[T, E]) -> Option[T]:
				|	match self:
				|		Ok(val):
				|			Some(val)
				|		Err(_):
				|			None
				|
				|
				|---
				|Swap Ok and Err values.
				|Useful for working with the error side of a Result.
				|
				|doctests:
				|    :: Swap Ok to Err
				|    ok: Result[Int, String] = Ok(42)
				|
				|    match swap(ok):
				|        Ok(_):
				|            False
				|        Err(v):
				|            v == 42
				|---
				|pure func swap[T, E](self: Result[T, E]) -> Result[E, T]:
				|	match self:
				|		Ok(val):
				|			r: Result[E, T] = Err(val)
				|			r
				|		Err(e):
				|			Ok(e)
				|
				|
				|implements ToBool for Result[T, E]:
				|	pure func to_bool[T, E](self: Result[T, E]) -> Bool:
				|		match self:
				|			Ok(_):
				|				True
				|			Err(_):
				|				False
				|
				|
				|implements Stringable for Result[T:Stringable, E:Stringable]:
				|	pure func to_string[T, E](self: Result[T, E]) -> String:
				|		match self:
				|			Ok(v):
				|				"Ok(" + v.to_string() + ")"
				|			Err(e):
				|				"Err(" + e.to_string() + ")"
				|
				|
				|implements Equatable for Result[T:Equatable, E:Equatable]:
				|	pure func equals[T:Equatable, E:Equatable](a: Result[T, E], b: Result[T, E]) -> Bool:
				|		match a:
				|			Ok(x):
				|				match b:
				|					Ok(y):
				|						equals(x, y)
				|					Err(_):
				|						False
				|			Err(x):
				|				match b:
				|					Ok(_):
				|						False
				|					Err(y):
				|						equals(x, y)
				|
				|	pure func not_equals[T:Equatable, E:Equatable](a: Result[T, E], b: Result[T, E]) -> Bool:
				|		match a:
				|			Ok(x):
				|				match b:
				|					Ok(y):
				|						not equals(x, y)
				|					Err(_):
				|						True
				|			Err(x):
				|				match b:
				|					Ok(_):
				|						True
				|					Err(y):
				|						not equals(x, y)
				|-- Get value or compute default lazily (pure version)
				|-- Get value or compute default lazily (impure version)
				|
			Some(source)
		"std/set":
			source: String = raw
				|-- Set - Immutable hash set with COW optimization
				|--
				|-- Set[T] is a collection of unique elements with O(1) average
				|-- membership testing, insertion, and removal.
				|type Set[T] = builtin
				|
				|
				|-- Uses separate chaining with ARC and COW optimization.
				|-- All operations are semantically immutable.
				|--
				|-- Supported element types: Int, String (hash/equality provided by runtime)
				|-- ============================================================================
				|-- Core Builtins
				|-- ============================================================================
				|---
				|Create an empty Set.
				|
				|doctests:
				|    :: Empty set is empty
				|    s: Set[Int] = set()
				|    s.is_empty() == True
				|---
				|pure func set[T]() -> Set[T]:
				|	builtin("std/set.set")
				|
				|
				|---
				|Add an element to the set, returns new set.
				|No-op if element already present.
				|
				|doctests:
				|    :: Add element
				|    s: Set[Int] = set().add(1)
				|    s.contains(1) == True
				|---
				|pure func add[T](self: Set[T], elem: T) -> Set[T]:
				|	builtin("std/set.add")
				|
				|
				|---
				|Remove an element from the set, returns new set.
				|No-op if element not present.
				|
				|doctests:
				|    :: Remove element
				|    s: Set[Int] = set().add(1)
				|    s2: Set[Int] = s.remove(1)
				|    s2.contains(1) == False
				|---
				|pure func remove[T](self: Set[T], elem: T) -> Set[T]:
				|	builtin("std/set.remove")
				|
				|
				|---
				|Check if an element is in the set.
				|
				|doctests:
				|    :: Contains existing element
				|    s: Set[Int] = set().add(42)
				|    s.contains(42) == True
				|
				|    :: Does not contain missing element
				|    s: Set[Int] = set()
				|    s.contains(99) == False
				|---
				|pure func contains[T](self: Set[T], elem: T) -> Bool:
				|	builtin("std/set.contains")
				|
				|
				|-- Internal length for trait implementation.
				|private pure func length[T](self: Set[T]) -> Int:
				|	builtin("std/set.length")
				|
				|
				|---
				|Convert to a list of elements.
				|
				|doctests:
				|    :: Convert to list
				|    s: Set[Int] = set().add(1)
				|    s
				|        .to_list()
				|        .length() == 1
				|---
				|pure func to_list[T](self: Set[T]) -> List[T]:
				|	builtin("std/set.to_list")
				|
				|
				|---
				|Set union: all elements from both sets.
				|
				|doctests:
				|    :: Union of sets
				|    a: Set[Int] = set().add(1)
				|    b: Set[Int] = set().add(2)
				|    c: Set[Int] = a.combine(b)
				|    c.contains(1) == True
				|---
				|pure func combine[T](a: Set[T], b: Set[T]) -> Set[T]:
				|	builtin("std/set.combine")
				|
				|
				|---
				|Set intersection: elements in both sets.
				|
				|doctests:
				|    :: Intersection of sets
				|    a: Set[Int] = set()
				|        .add(1)
				|        .add(2)
				|    b: Set[Int] = set()
				|        .add(2)
				|        .add(3)
				|    c: Set[Int] = a.intersect(b)
				|    c.contains(2) == True
				|---
				|pure func intersect[T](a: Set[T], b: Set[T]) -> Set[T]:
				|	builtin("std/set.intersect")
				|
				|
				|---
				|Set difference: elements in a but not in b.
				|
				|doctests:
				|    :: Difference of sets
				|    a: Set[Int] = set()
				|        .add(1)
				|        .add(2)
				|    b: Set[Int] = set().add(2)
				|    c: Set[Int] = a.difference(b)
				|    c.contains(1) == True
				|---
				|pure func difference[T](a: Set[T], b: Set[T]) -> Set[T]:
				|	builtin("std/set.difference")
				|
				|
				|---
				|Set union: alias for combine. Named set_union because union is a keyword.
				|
				|doctests:
				|    :: Union of sets
				|    a: Set[Int] = set().add(1)
				|    b: Set[Int] = set().add(2)
				|    c: Set[Int] = a.set_union(b)
				|    c.contains(1) and c.contains(2)
				|---
				|pure func set_union[T](a: Set[T], b: Set[T]) -> Set[T]:
				|	a.combine(b)
				|
				|
				|-- ============================================================================
				|-- Higher-Order Functions
				|-- ============================================================================
				|---
				|Apply a function to each element and collect results into a new set.
				|
				|doctests:
				|    :: Map doubles
				|    s: Set[Int] = [1, 2, 3].from_list()
				|    result: Set[Int] = s.map(pure func(x: Int): x * 2)
				|    result.contains(2) and result.contains(4) and result.contains(6)
				|---
				|pure func map[T, U](
				|	self: Set[T],
				|	f: pure (T) -> U,
				|) -> Set[U]:
				|	builtin("std/set.map")
				|func map[T, U](
				|	self: Set[T],
				|	f: (T) -> U,
				|) -> Set[U]:
				|
				|
				|---
				|Filter elements by predicate.
				|
				|doctests:
				|    :: Filter evens
				|    s: Set[Int] = [1, 2, 3, 4].from_list()
				|    result: Set[Int] = s.filter(pure func(x: Int): x % 2 == 0)
				|    result.contains(2) and result.contains(4) and not result.contains(1)
				|---
				|pure func filter[T](
				|	self: Set[T],
				|	pred: pure (T) -> Bool,
				|) -> Set[T]:
				|	builtin("std/set.filter")
				|func filter[T](
				|	self: Set[T],
				|	pred: (T) -> Bool,
				|) -> Set[T]:
				|
				|
				|---
				|Fold over set elements.
				|
				|doctests:
				|    :: Sum elements
				|    s: Set[Int] = [1, 2, 3].from_list()
				|    s.fold(0, pure func(acc: Int, x: Int): acc + x) == 6
				|---
				|pure func fold[T, Acc](
				|	self: Set[T],
				|	init: Acc,
				|	f: pure (Acc, T) -> Acc,
				|) -> Acc:
				|	builtin("std/set.fold")
				|func fold[T, Acc](
				|	self: Set[T],
				|	init: Acc,
				|	f: (Acc, T) -> Acc,
				|) -> Acc:
				|
				|
				|-- ============================================================================
				|-- Construction
				|-- ============================================================================
				|---
				|Create a Set from a list (duplicates removed).
				|
				|doctests:
				|    :: Create from list deduplicates
				|    s: Set[Int] = [1, 2, 2, 3].from_list()
				|    s
				|        .to_list()
				|        .length() == 3
				|---
				|pure func from_list[T](items: List[T]) -> Set[T]:
				|	var result: Set[T] = set()
				|
				|	for item in items:
				|		result = result.add(item)
				|
				|	result
				|
				|
				|-- ============================================================================
				|-- Extended Operations
				|-- ============================================================================
				|---
				|Check if the set is empty.
				|
				|doctests:
				|    :: Empty set is empty
				|    s: Set[Int] = set()
				|    s.is_empty() == True
				|
				|    :: Non-empty set is not empty
				|    s: Set[Int] = set().add(1)
				|    s.is_empty() == False
				|---
				|pure func is_empty[T](self: Set[T]) -> Bool:
				|	self.length() == 0
				|
				|
				|---
				|Check if a is a subset of b (all elements of a are in b).
				|
				|doctests:
				|    :: Subset check
				|    a: Set[Int] = set().add(1)
				|    b: Set[Int] = set()
				|        .add(1)
				|        .add(2)
				|    a.is_subset(b) == True
				|---
				|pure func is_subset[T](a: Set[T], b: Set[T]) -> Bool:
				|	builtin("std/set.is_subset")
				|
				|
				|---
				|Check if a is a superset of b (all elements of b are in a).
				|
				|doctests:
				|    :: Superset check
				|    a: Set[Int] = set()
				|        .add(1)
				|        .add(2)
				|    b: Set[Int] = set().add(1)
				|    a.is_superset(b) == True
				|---
				|pure func is_superset[T](a: Set[T], b: Set[T]) -> Bool:
				|	b.is_subset(a)
				|
				|
				|---
				|Elements in either set but not both (a XOR b).
				|
				|doctests:
				|    :: Symmetric difference excludes common elements
				|    a: Set[Int] = [1, 2, 3].from_list()
				|    b: Set[Int] = [2, 3, 4].from_list()
				|    sd: Set[Int] = a.symmetric_difference(b)
				|    sd.contains(1) and sd.contains(4) and not sd.contains(2)
				|
				|    :: Empty if sets are equal
				|    a: Set[Int] = [1, 2].from_list()
				|    b: Set[Int] = [1, 2].from_list()
				|    a
				|        .symmetric_difference(b)
				|        .is_empty()
				|
				|    :: Disjoint sets return union
				|    a: Set[Int] = [1, 2].from_list()
				|    b: Set[Int] = [3, 4].from_list()
				|    a
				|        .symmetric_difference(b)
				|        .length() == 4
				|---
				|pure func symmetric_difference[T](a: Set[T], b: Set[T]) -> Set[T]:
				|	a
				|		.difference(b)
				|		.combine(b.difference(a))
				|
				|
				|-- ============================================================================
				|-- Trait Implementations
				|-- ============================================================================
				|-- Implement HasLength trait for Set
				|implements HasLength for Set[T]:
				|	pure func length[T](self: Set[T]) -> Int:
				|		builtin("std/set.length")
				|
				|
				|-- String conversion
				|implements Stringable for Set[T:Stringable]:
				|	pure func to_string[T](self: Set[T]) -> String:
				|		if self.is_empty():
				|			"{}"
				|		else:
				|			to_string_impl(self)
				|
				|
				|-- Helper for to_string
				|private pure func to_string_impl[T:Stringable](self: Set[T]) -> String:
				|	parts: List[String] = self
				|		.to_list()
				|		.map(func(item: T): item.to_string())
				|
				|	"{" + parts.join(", ") + "}"
				|
			Some(source)
		"std/slice":
			source: String = raw
				|-- StringSlice - Zero-copy string views for efficient parsing
				|--
				|-- StringSlice provides a view into an existing string without copying.
				|-- This is essential for efficient parsing where substring operations
				|-- would otherwise allocate new memory for each parse step.
				|--
				|-- StringSlice is a built-in type backed by the runtime. It holds a reference
				|-- to a base string plus offset and length, enabling zero-copy substring views.
				|type StringSlice = builtin
				|
				|
				|-- ============================================================================
				|-- Builtins
				|-- ============================================================================
				|---
				|Create a slice from a string (covers the entire string).
				|
				|doctests:
				|    :: Create from string
				|    s: StringSlice = from_string("hello")
				|    s.length() == 5
				|---
				|pure func from_string(s: String) -> StringSlice:
				|	builtin("std/slice.from_string")
				|
				|
				|---
				|Get the length of the slice (in bytes).
				|
				|doctests:
				|    :: Length of slice
				|    s: StringSlice = from_string("hello")
				|    s.length() == 5
				|---
				|pure func length(slice: StringSlice) -> Int:
				|	builtin("std/slice.length")
				|
				|
				|---
				|Materialize the slice into a new String (allocates).
				|---
				|implements Stringable for StringSlice:
				|	pure func to_string(slice: StringSlice) -> String:
				|		builtin("std/slice.to_string")
				|
				|
				|implements HasLength for StringSlice:
				|	pure func length(slice: StringSlice) -> Int:
				|		builtin("std/slice.length")
				|
				|
				|---
				|Get a sub-slice (zero-copy, shares base string).
				|start is byte offset, len is byte length.
				|
				|doctests:
				|    :: Sub-slice of string
				|    s: StringSlice = from_string("hello world")
				|    sub: StringSlice = s.substring(0, 5)
				|    sub.length() == 5
				|---
				|pure func substring(slice: StringSlice, start: Int, len: Int) -> StringSlice:
				|	builtin("std/slice.substring")
				|
				|
				|---
				|Check if slice starts with a given prefix.
				|
				|doctests:
				|    :: Matching prefix
				|    s: StringSlice = from_string("hello")
				|    s.starts_with("hel") == True
				|
				|    :: Non-matching prefix
				|    s: StringSlice = from_string("hello")
				|    s.starts_with("xyz") == False
				|---
				|pure func starts_with(slice: StringSlice, prefix: String) -> Bool:
				|	builtin("std/slice.starts_with")
				|
				|
				|-- ============================================================================
				|-- Safe Access
				|-- ============================================================================
				|---
				|Bounds-checked character access.
				|Returns Some(char) for valid index, None for out-of-bounds.
				|
				|doctests:
				|    :: Get first character
				|    s: StringSlice = from_string("hello")
				|
				|    match s.get(0):
				|        Some(c):
				|            c == 'h'
				|        None:
				|            False
				|---
				|pure func get(slice: StringSlice, index: Int) -> Option[Char]:
				|	builtin("std/slice.get")
				|
				|
				|-- ============================================================================
				|-- Utilities
				|-- ============================================================================
				|---
				|Check if the slice is empty.
				|
				|doctests:
				|    :: Empty slice is empty
				|    s: StringSlice = from_string("")
				|    is_empty(s) == True
				|
				|    :: Non-empty slice is not empty
				|    s: StringSlice = from_string("hello")
				|    is_empty(s) == False
				|---
				|pure func is_empty(slice: StringSlice) -> Bool:
				|	slice.length() == 0
				|
				|
				|---
				|Get the first character of the slice, or None if empty.
				|
				|doctests:
				|    :: Head of slice
				|    s: StringSlice = from_string("hello")
				|
				|    match head(s):
				|        Some(c):
				|            c == 'h'
				|        None:
				|            False
				|---
				|pure func head(slice: StringSlice) -> Option[Char]:
				|	get(slice, 0)
				|
				|
				|---
				|Get a slice without the first character (zero-copy).
				|
				|doctests:
				|    :: Tail removes first character
				|    s: StringSlice = from_string("hello")
				|    tail(s).length() == 4
				|---
				|pure func tail(slice: StringSlice) -> StringSlice:
				|	if slice.length() > 0:
				|		slice.substring(1, slice.length() - 1)
				|	else:
				|		slice
				|
				|
				|---
				|Check if slice ends with the given suffix string.
				|
				|doctests:
				|    :: Matching suffix
				|    s: StringSlice = from_string("hello")
				|    s.ends_with("llo") == True
				|
				|    :: Non-matching suffix
				|    s: StringSlice = from_string("hello")
				|    s.ends_with("xyz") == False
				|---
				|pure func ends_with(slice: StringSlice, suffix: String) -> Bool:
				|	suf_slice: StringSlice = from_string(suffix)
				|	suf_len: Int = suf_slice.length()
				|	sl_len: Int = slice.length()
				|
				|	if suf_len > sl_len:
				|		False
				|	else:
				|		sub: StringSlice = slice.substring(sl_len - suf_len, suf_len)
				|		sub.to_string() == suffix
				|
				|
				|---
				|Check if slice contains the given needle string.
				|
				|doctests:
				|    :: Contains substring
				|    s: StringSlice = from_string("hello world")
				|    s.contains("world") == True
				|
				|    :: Does not contain
				|    s: StringSlice = from_string("hello")
				|    s.contains("xyz") == False
				|---
				|pure func contains(slice: StringSlice, needle: String) -> Bool:
				|	match slice.index_of(needle):
				|		Some(_):
				|			True
				|		None:
				|			False
				|
				|
				|---
				|Find the index of needle in the slice.
				|Returns Some(index) if found, None if not found.
				|
				|doctests:
				|    :: Find existing substring
				|    s: StringSlice = from_string("hello world")
				|
				|    match s.index_of("world"):
				|        Some(i):
				|            i == 6
				|        None:
				|            False
				|---
				|pure func index_of(slice: StringSlice, needle: String) -> Option[Int]:
				|	needle_slice: StringSlice = from_string(needle)
				|	needle_len: Int = needle_slice.length()
				|	sl_len: Int = slice.length()
				|
				|	if needle_len > sl_len:
				|		None
				|	else:
				|		var i: Int = 0
				|		var result: Option[Int] = None
				|
				|		while i <= sl_len - needle_len:
				|			sub: StringSlice = slice.substring(i, needle_len)
				|
				|			if sub.to_string() == needle:
				|				result = Some(i)
				|				break
				|
				|			i += 1
				|
				|		result
				|
				|
				|---
				|Trim leading and trailing whitespace from a slice.
				|Returns a new sub-slice (zero-copy).
				|
				|doctests:
				|    :: Trim whitespace
				|    s: StringSlice = from_string("  hello  ")
				|    trim(s).to_string() == "hello"
				|---
				|pure func trim(slice: StringSlice) -> StringSlice:
				|	sl_len: Int = slice.length()
				|	var start: Int = 0
				|
				|	while start < sl_len:
				|		match slice.get(start):
				|			Some(c):
				|				if (
				|					c == ' '
				|					or c == '\t'
				|					or c == '\n'
				|					or c == '\r'
				|				):
				|					start += 1
				|				else:
				|					break
				|			None:
				|				break
				|
				|	var end_pos: Int = sl_len
				|
				|	while end_pos > start:
				|		match slice.get(end_pos - 1):
				|			Some(c):
				|				if (
				|					c == ' '
				|					or c == '\t'
				|					or c == '\n'
				|					or c == '\r'
				|				):
				|					end_pos -= 1
				|				else:
				|					break
				|			None:
				|				break
				|
				|	slice.substring(start, end_pos - start)
				|
			Some(source)
		"std/sorted_map":
			source: String = raw
				|-- SortedMap - Sorted key-value map backed by a sorted list
				|--
				|-- A map where keys are kept in sorted order. All operations maintain
				|-- sorted key order. Supports O(n) insert/lookup and O(1) min/max access.
				|-- Wrapped in an opaque type for type safety and to protect the sorted-list
				|-- invariant from direct construction.
				|--
				|-- Comparison with Dict:
				|-- Dict: O(1) average lookup/insert, insertion-ordered iteration, keys need Hashable
				|-- SortedMap: O(n) lookup/insert, key-sorted iteration, keys need Orderable
				|-- Use Dict when you need fast lookup and don't care about key order.
				|-- Use SortedMap when you need sorted iteration, min/max, or range queries.
				|opaque type SortedMap[K, V] = List[(K, V)]
				|
				|
				|-- ============================================================================
				|-- Construction
				|-- ============================================================================
				|---
				|Create an empty sorted map.
				|
				|doctests:
				|    :: Map is empty after removing its only entry
				|    sm = sorted_map()
				|        .set(1, 10)
				|        .remove(1)
				|    sm.is_empty() == True
				|---
				|pure func sorted_map[K, V]() -> SortedMap[K, V]:
				|	from_pairs([])
				|
				|
				|-- ============================================================================
				|-- Core Operations
				|-- ============================================================================
				|---
				|Insert a key-value pair. If key exists, updates the value.
				|Returns a new sorted map. O(n).
				|
				|doctests:
				|    :: Insert increases size
				|    sm = sorted_map().set(1, 10)
				|    sm.map_length() == 1
				|---
				|pure func set[K:Orderable+Equatable, V](sm: SortedMap[K, V], key: K, val: V) -> SortedMap[K, V]:
				|	data: List[(K, V)] = sorted_map_pairs(sm)
				|	from_pairs(insert_sorted(data, key, val, 0))
				|
				|
				|---
				|Get the value for a key. O(n).
				|
				|doctests:
				|    :: Get existing key
				|    sm = sorted_map().set(1, 10)
				|
				|    match sm.get(1):
				|        Some(v):
				|            v == 10
				|        None:
				|            False
				|---
				|pure func get[K:Orderable+Equatable, V](sm: SortedMap[K, V], key: K) -> Option[V]:
				|	find_key(sorted_map_pairs(sm), key, 0)
				|
				|
				|---
				|Check if a key exists in the map. O(n).
				|
				|doctests:
				|    :: Contains after insert
				|    sm = sorted_map().set(1, 10)
				|    sm.has_key(1) == True
				|---
				|pure func has_key[K:Orderable+Equatable, V](sm: SortedMap[K, V], key: K) -> Bool:
				|	match sm.get(key):
				|		Some(_):
				|			True
				|		None:
				|			False
				|
				|
				|---
				|Remove a key from the map. O(n).
				|Returns the new map (unchanged if key not found).
				|
				|doctests:
				|    :: Remove existing key
				|    var sm = sorted_map()
				|    sm = sm.set(1, 10)
				|    sm = sm.remove(1)
				|    sm.map_length() == 0
				|---
				|pure func remove[K:Orderable+Equatable, V](sm: SortedMap[K, V], key: K) -> SortedMap[K, V]:
				|	data: List[(K, V)] = sorted_map_pairs(sm)
				|	from_pairs(remove_key(data, key, 0))
				|
				|
				|---
				|Get the minimum key-value pair. O(1).
				|
				|doctests:
				|    :: Min returns smallest key
				|    var sm = sorted_map()
				|    sm = sm.set(3, 30)
				|    sm = sm.set(1, 10)
				|
				|    match sm.min():
				|        Some(pair):
				|            pair[0] == 1 and pair[1] == 10
				|        None:
				|            False
				|---
				|pure func min[K, V](sm: SortedMap[K, V]) -> Option[(K, V)]:
				|	data: List[(K, V)] = sorted_map_pairs(sm)
				|
				|	if data.length() == 0:
				|		r: Option[(K, V)] = None
				|		r
				|	else:
				|		data.get(0)
				|
				|
				|---
				|Get the maximum key-value pair. O(1).
				|
				|doctests:
				|    :: Max returns largest key
				|    var sm = sorted_map()
				|    sm = sm.set(1, 10)
				|    sm = sm.set(3, 30)
				|
				|    match sm.max():
				|        Some(pair):
				|            pair[0] == 3 and pair[1] == 30
				|        None:
				|            False
				|---
				|pure func max[K, V](sm: SortedMap[K, V]) -> Option[(K, V)]:
				|	data: List[(K, V)] = sorted_map_pairs(sm)
				|
				|	if data.length() == 0:
				|		r: Option[(K, V)] = None
				|		r
				|	else:
				|		data.get(data.length() - 1)
				|
				|
				|---
				|Get all key-value pairs with keys in range [lo, hi] inclusive. O(n).
				|
				|doctests:
				|    :: Range query
				|    var sm = sorted_map()
				|    sm = sm.set(1, 10)
				|    sm = sm.set(2, 20)
				|    sm = sm.set(3, 30)
				|    sm
				|        .range(1, 2)
				|        .length() == 2
				|---
				|pure func range[K:Orderable, V](sm: SortedMap[K, V], lo: K, hi: K) -> List[(K, V)]:
				|	collect_range(sorted_map_pairs(sm), lo, hi, 0)
				|
				|
				|---
				|Get all keys in sorted order. O(n).
				|---
				|pure func keys[K, V](sm: SortedMap[K, V]) -> List[K]:
				|	extract_keys(sorted_map_pairs(sm), 0)
				|
				|
				|---
				|Get all values in key-sorted order. O(n).
				|---
				|pure func values[K, V](sm: SortedMap[K, V]) -> List[V]:
				|	extract_values(sorted_map_pairs(sm), 0)
				|
				|
				|---
				|Convert to a list of (key, value) pairs in sorted order. O(n).
				|---
				|pure func to_list[K, V](sm: SortedMap[K, V]) -> List[(K, V)]:
				|	sorted_map_pairs(sm)
				|
				|
				|---
				|Create a sorted map from a list of (key, value) pairs. O(n^2).
				|---
				|pure func from_list[K:Orderable+Equatable, V](pairs: List[(K, V)]) -> SortedMap[K, V]:
				|	var result: SortedMap[K, V] = sorted_map()
				|
				|	for pair in pairs:
				|		result = result.set(pair[0], pair[1])
				|
				|	result
				|
				|
				|---
				|Get the number of entries. O(1).
				|---
				|pure func map_length[K, V](sm: SortedMap[K, V]) -> Int:
				|	sorted_map_pairs(sm).length()
				|
				|
				|---
				|Check if the map is empty. O(1).
				|---
				|pure func is_empty[K, V](sm: SortedMap[K, V]) -> Bool:
				|	sorted_map_pairs(sm).length() == 0
				|
				|
				|-- ============================================================================
				|-- Internal Helpers
				|-- ============================================================================
				|private pure func from_pairs[K, V](pairs: List[(K, V)]) -> SortedMap[K, V]:
				|	into SortedMap[K, V](pairs)
				|
				|
				|private pure func sorted_map_pairs[K, V](sm: SortedMap[K, V]) -> List[(K, V)]:
				|	from SortedMap[K, V](sm)
				|
				|
				|-- Insert in sorted position, replacing if key exists
				|private pure func insert_sorted[K:Orderable+Equatable, V](
				|	data: List[(K, V)],
				|	key: K,
				|	val: V,
				|	i: Int,
				|) -> List[(K, V)]:
				|	var idx: Int = i
				|	var result: List[(K, V)] = data
				|	var done: Bool = False
				|
				|	while idx < data.length() and not done:
				|		match data.get(idx):
				|			Some(pair):
				|				if pair[0] == key:
				|					result = list_set_pair(data, idx, (key, val))
				|					done = True
				|				else if key < pair[0]:
				|					result = list_insert_pair(data, idx, (key, val))
				|					done = True
				|				else:
				|					idx += 1
				|			None:
				|				done = True
				|
				|	if not done:
				|		result = result.append((key, val))
				|
				|	result
				|
				|
				|-- Find key and return value
				|private pure func find_key[K:Orderable+Equatable, V](
				|	data: List[(K, V)],
				|	key: K,
				|	i: Int,
				|) -> Option[V]:
				|	var idx: Int = i
				|	var result: Option[V] = None
				|	var done: Bool = False
				|
				|	while idx < data.length() and not done:
				|		match data.get(idx):
				|			Some(pair):
				|				if pair[0] == key:
				|					result = Some(pair[1])
				|					done = True
				|				else if pair[0] > key:
				|					done = True
				|				else:
				|					idx += 1
				|			None:
				|				done = True
				|
				|	result
				|
				|
				|-- Remove key from sorted list
				|private pure func remove_key[K:Orderable+Equatable, V](
				|	data: List[(K, V)],
				|	key: K,
				|	i: Int,
				|) -> List[(K, V)]:
				|	var idx: Int = i
				|	var result: List[(K, V)] = data
				|	var done: Bool = False
				|
				|	while idx < data.length() and not done:
				|		match data.get(idx):
				|			Some(pair):
				|				if pair[0] == key:
				|					result = list_remove_at(data, idx)
				|					done = True
				|				else if pair[0] > key:
				|					done = True
				|				else:
				|					idx += 1
				|			None:
				|				done = True
				|
				|	result
				|
				|
				|-- Collect pairs in [lo, hi] range
				|private pure func collect_range[K:Orderable, V](
				|	data: List[(K, V)],
				|	lo: K,
				|	hi: K,
				|	i: Int,
				|) -> List[(K, V)]:
				|	var result: List[(K, V)] = []
				|	var idx: Int = i
				|
				|	while idx < data.length():
				|		match data.get(idx):
				|			Some(pair):
				|				if pair[0] > hi:
				|					idx = data.length()
				|				else if pair[0] >= lo:
				|					result = result.append(pair)
				|			None:
				|				void
				|
				|		idx += 1
				|
				|	result
				|
				|
				|-- Extract all keys
				|private pure func extract_keys[K, V](data: List[(K, V)], i: Int) -> List[K]:
				|	data
				|		.drop(i)
				|		.map(func(pair: (K, V)): pair[0])
				|
				|
				|-- Extract all values
				|private pure func extract_values[K, V](data: List[(K, V)], i: Int) -> List[V]:
				|	data
				|		.drop(i)
				|		.map(func(pair: (K, V)): pair[1])
				|
				|
				|-- Set pair at index (returns new list)
				|private pure func list_set_pair[K, V](data: List[(K, V)], idx: Int, pair: (K, V)) -> List[(K, V)]:
				|	var result: List[(K, V)] = []
				|	var i: Int = 0
				|
				|	while i < data.length():
				|		if i == idx:
				|			result = result.append(pair)
				|		else:
				|			match data.get(i):
				|				Some(p):
				|					result = result.append(p)
				|				None:
				|					void
				|
				|		i += 1
				|
				|	result
				|
				|
				|-- Insert pair at index (shifts elements right)
				|private pure func list_insert_pair[K, V](
				|	data: List[(K, V)],
				|	idx: Int,
				|	pair: (K, V),
				|) -> List[(K, V)]:
				|	var result: List[(K, V)] = []
				|	var i: Int = 0
				|
				|	while i < data.length():
				|		if i == idx:
				|			result = result.append(pair)
				|
				|		match data.get(i):
				|			Some(p):
				|				result = result.append(p)
				|			None:
				|				void
				|
				|		i += 1
				|
				|	result
				|
				|
				|-- Remove element at index
				|private pure func list_remove_at[K, V](data: List[(K, V)], idx: Int) -> List[(K, V)]:
				|	var result: List[(K, V)] = []
				|	var i: Int = 0
				|
				|	while i < data.length():
				|		if i != idx:
				|			match data.get(i):
				|				Some(p):
				|					result = result.append(p)
				|				None:
				|					void
				|
				|		i += 1
				|
				|	result
				|
			Some(source)
		"std/stats":
			source: String = raw
				|-- Stats — Statistical functions for numeric data
				|--
				|-- All functions operate on List[Float] and are pure.
				|-- For integer data, convert with to_float first.
				|--
				|-- Typical use: import the statistics functions you need from `stats`.
				|-- avg: Float = mean(data)
				|-- sd: Float = stddev(data)
				|import:
				|	float: sqrt
				|
				|
				|-- ============================================================================
				|-- Central Tendency
				|-- ============================================================================
				|---
				|Arithmetic mean of a list of floats.
				|Returns 0.0 for empty lists.
				|
				|doctests:
				|    :: Mean of [1, 2, 3]
				|    mean([1.0, 2.0, 3.0]).approx_eq(2.0)
				|
				|    :: Mean of single value
				|    mean([5.0]).approx_eq(5.0)
				|
				|    :: Empty list
				|    mean([]) == 0.0
				|---
				|pure func mean(data: List[Float]) -> Float:
				|	n: Int = data.length()
				|
				|	if n == 0:
				|		0.0
				|	else:
				|		var total: Float = 0.0
				|
				|		for x in data:
				|			total += x
				|
				|		total / to_float(n)
				|
				|
				|---
				|Median value (middle element, or average of two middle elements).
				|Returns 0.0 for empty lists.
				|
				|---
				|pure func median(data: List[Float]) -> Float:
				|	n: Int = data.length()
				|
				|	if n == 0:
				|		0.0
				|	else:
				|		median_sorted(data.sort(), n)
				|
				|
				|private pure func median_sorted(sorted: List[Float], n: Int) -> Float:
				|	mid: Int = n / 2
				|
				|	if n % 2 == 1:
				|		get_float(sorted, mid)
				|	else:
				|		(get_float(sorted, mid - 1) + get_float(sorted, mid)) / 2.0
				|
				|
				|private pure func get_float(data: List[Float], idx: Int) -> Float:
				|	data
				|		.get(idx)
				|		.get_or(0.0)
				|
				|
				|---
				|Mode: the most frequently occurring value.
				|Returns None for empty lists. If multiple modes, returns the first encountered.
				|---
				|pure func mode(data: List[Float]) -> Option[Float]:
				|	n: Int = data.length()
				|
				|	if n == 0:
				|		None
				|	else:
				|		var best_val: Float = 0.0
				|		var best_count: Int = 0
				|
				|		for x in data:
				|			var n_matches: Int = 0
				|
				|			for y in data:
				|				if x == y:
				|					n_matches += 1
				|
				|			if n_matches > best_count:
				|				best_count = n_matches
				|				best_val = x
				|
				|		Some(best_val)
				|
				|
				|-- ============================================================================
				|-- Dispersion
				|-- ============================================================================
				|---
				|Population variance (divides by N).
				|
				|doctests:
				|    :: Variance of [2, 4, 4, 4, 5, 5, 7, 9]
				|    variance([2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0]).approx_eq(4.0)
				|---
				|pure func variance(data: List[Float]) -> Float:
				|	n: Int = data.length()
				|
				|	if n == 0:
				|		0.0
				|	else:
				|		avg: Float = mean(data)
				|		var sum_sq: Float = 0.0
				|
				|		for x in data:
				|			diff: Float = x - avg
				|			sum_sq += diff * diff
				|
				|		sum_sq / to_float(n)
				|
				|
				|---
				|Sample variance (divides by N-1, Bessel's correction).
				|Returns 0.0 if fewer than 2 elements.
				|---
				|pure func sample_variance(data: List[Float]) -> Float:
				|	n: Int = data.length()
				|
				|	if n < 2:
				|		0.0
				|	else:
				|		avg: Float = mean(data)
				|		var sum_sq: Float = 0.0
				|
				|		for x in data:
				|			diff: Float = x - avg
				|			sum_sq += diff * diff
				|
				|		sum_sq / to_float(n - 1)
				|
				|
				|---
				|Population standard deviation.
				|
				|doctests:
				|    :: Stddev of [2, 4, 4, 4, 5, 5, 7, 9]
				|    stddev([2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0]).approx_eq(2.0)
				|---
				|pure func stddev(data: List[Float]) -> Float:
				|	sqrt(variance(data))
				|
				|
				|---
				|Sample standard deviation (Bessel's correction).
				|---
				|pure func sample_stddev(data: List[Float]) -> Float:
				|	sqrt(sample_variance(data))
				|
				|
				|-- ============================================================================
				|-- Range and Extremes
				|-- ============================================================================
				|---
				|Minimum value. Returns None for empty lists.
				|---
				|pure func min_val(data: List[Float]) -> Option[Float]:
				|	n: Int = data.length()
				|
				|	if n == 0:
				|		None
				|	else:
				|		var m: Float = data
				|			.get(0)
				|			.get_or(0.0)
				|
				|		for i in 1..n:
				|			match data.get(i):
				|				Some(x):
				|					if x < m:
				|						m = x
				|				None:
				|					void
				|
				|		Some(m)
				|
				|
				|---
				|Maximum value. Returns None for empty lists.
				|---
				|pure func max_val(data: List[Float]) -> Option[Float]:
				|	n: Int = data.length()
				|
				|	if n == 0:
				|		None
				|	else:
				|		var m: Float = data
				|			.get(0)
				|			.get_or(0.0)
				|
				|		for i in 1..n:
				|			match data.get(i):
				|				Some(x):
				|					if x > m:
				|						m = x
				|				None:
				|					void
				|
				|		Some(m)
				|
				|
				|---
				|Range: max - min. Returns 0.0 for empty lists.
				|---
				|pure func range(data: List[Float]) -> Float:
				|	match (min_val(data), max_val(data)):
				|		(Some(lo), Some(hi)):
				|			hi - lo
				|		_:
				|			0.0
				|
				|
				|-- ============================================================================
				|-- Percentiles and Quantiles
				|-- ============================================================================
				|---
				|Percentile using linear interpolation (same as numpy's default).
				|`p` should be in [0.0, 100.0].
				|---
				|pure func percentile(data: List[Float], p: Float) -> Float:
				|	n: Int = data.length()
				|
				|	if n == 0:
				|		0.0
				|	else if n == 1:
				|		data
				|			.get(0)
				|			.get_or(0.0)
				|	else:
				|		sorted: List[Float] = data.sort()
				|
				|		clamped: Float = if p < 0.0:
				|			0.0
				|		else if p > 100.0:
				|			100.0
				|		else:
				|			p
				|
				|		rank: Float = clamped / 100.0 * to_float(n - 1)
				|		lo_idx: Int = to_int(rank)
				|		hi_idx: Int = lo_idx + 1
				|		frac: Float = rank - to_float(lo_idx)
				|		lo_val: Float = sorted
				|			.get(lo_idx)
				|			.get_or(0.0)
				|
				|		if hi_idx >= n:
				|			lo_val
				|		else:
				|			hi_val: Float = sorted
				|				.get(hi_idx)
				|				.get_or(0.0)
				|			lo_val + frac * (hi_val - lo_val)
				|
				|
				|---
				|Quartiles: returns (Q1, Q2, Q3).
				|---
				|pure func quartiles(data: List[Float]) -> (Float, Float, Float):
				|	(percentile(data, 25.0), percentile(data, 50.0), percentile(data, 75.0))
				|
				|
				|---
				|Interquartile range (Q3 - Q1).
				|---
				|pure func iqr(data: List[Float]) -> Float:
				|	percentile(data, 75.0) - percentile(data, 25.0)
				|
				|
				|-- ============================================================================
				|-- Correlation and Regression
				|-- ============================================================================
				|---
				|Pearson correlation coefficient between two lists.
				|Returns 0.0 if lists differ in length or have fewer than 2 elements.
				|---
				|pure func correlation(xs: List[Float], ys: List[Float]) -> Float:
				|	n: Int = xs.length()
				|
				|	if n != ys.length() or n < 2:
				|		0.0
				|	else:
				|		mx: Float = mean(xs)
				|		my: Float = mean(ys)
				|		var sum_xy: Float = 0.0
				|		var sum_xx: Float = 0.0
				|		var sum_yy: Float = 0.0
				|
				|		for i in 0..n:
				|			xi: Float = xs
				|				.get(i)
				|				.get_or(0.0)
				|			yi: Float = ys
				|				.get(i)
				|				.get_or(0.0)
				|			dx: Float = xi - mx
				|			dy: Float = yi - my
				|			sum_xy += dx * dy
				|			sum_xx += dx * dx
				|			sum_yy += dy * dy
				|
				|		denom: Float = sqrt(sum_xx * sum_yy)
				|
				|		if denom == 0.0:
				|			0.0
				|		else:
				|			sum_xy / denom
				|
				|
				|---
				|Simple linear regression: returns (slope, intercept).
				|Fits y = slope * x + intercept using least squares.
				|Returns (0.0, 0.0) for insufficient data.
				|---
				|pure func linear_regression(xs: List[Float], ys: List[Float]) -> (Float, Float):
				|	n: Int = xs.length()
				|
				|	if n != ys.length() or n < 2:
				|		(0.0, 0.0)
				|	else:
				|		mx: Float = mean(xs)
				|		my: Float = mean(ys)
				|		var sum_xy: Float = 0.0
				|		var sum_xx: Float = 0.0
				|
				|		for i in 0..n:
				|			xi: Float = xs
				|				.get(i)
				|				.get_or(0.0)
				|			yi: Float = ys
				|				.get(i)
				|				.get_or(0.0)
				|			dx: Float = xi - mx
				|			dy: Float = yi - my
				|			sum_xy += dx * dy
				|			sum_xx += dx * dx
				|
				|		if sum_xx == 0.0:
				|			(0.0, my)
				|		else:
				|			slope: Float = sum_xy / sum_xx
				|			intercept: Float = my - slope * mx
				|			(slope, intercept)
				|
				|
				|-- ============================================================================
				|-- Summary Statistics
				|-- ============================================================================
				|---
				|Compute sum of all elements.
				|
				|doctests:
				|    :: Sum of [1, 2, 3]
				|    sum([1.0, 2.0, 3.0]).approx_eq(6.0)
				|---
				|pure func sum(data: List[Float]) -> Float:
				|	var total: Float = 0.0
				|
				|	for x in data:
				|		total += x
				|
				|	total
				|
				|
				|---
				|Count of elements.
				|---
				|pure func count(data: List[Float]) -> Int:
				|	data.length()
				|
				|
				|-- ============================================================================
				|-- Normalization
				|-- ============================================================================
				|---
				|Z-score normalization: (x - mean) / stddev for each element.
				|Returns original data unchanged if stddev is 0.
				|---
				|pure func zscore(data: List[Float]) -> List[Float]:
				|	sd: Float = stddev(data)
				|
				|	if sd == 0.0:
				|		data
				|	else:
				|		avg: Float = mean(data)
				|		data.map(func(x: Float): (x - avg) / sd)
				|
				|
				|---
				|Min-max normalization: scale to [0.0, 1.0].
				|Returns original data unchanged if all values are equal.
				|---
				|pure func normalize(data: List[Float]) -> List[Float]:
				|	r: Float = range(data)
				|
				|	if r == 0.0:
				|		data
				|	else:
				|		lo: Float = min_val(data).get_or(0.0)
				|		data.map(func(x: Float): (x - lo) / r)
				|-- ============================================================================
				|-- Helpers
				|-- ============================================================================
				|
			Some(source)
		"std/stream":
			source: String = raw
				|-- Stream - Lazy, composable sequences
				|--
				|-- Streams process elements one at a time with constant memory.
				|-- Created from sources (lists, ranges, files), transformed with
				|-- intermediate operations (map, filter, take), and consumed with
				|-- terminal operations (collect, fold, count).
				|--
				|-- All intermediate operations are lazy — they build a pipeline
				|-- description that only executes when a terminal operation runs.
				|-- Streams are one-shot cursors with mutable pull state. The compiler rejects
				|-- binding them globally, storing them in ordinary aggregates or ordinary
				|-- carrier type aliases/ascriptions, binding carrier values such as
				|-- Option[Stream[T]], using ordinary function signatures that contain stream
				|-- carriers, using function values whose parameters or return values hide
				|-- stream carriers, and capturing them in closures, detach bodies, and
				|-- concurrent task bodies. Generic records and unions are checked after
				|-- substitution, so the rule follows their actual fields or variants. Keep
				|-- streams in direct local bindings, then consume them with terminal stream
				|-- operations. Direct producer functions such as () -> Stream[T] are ordinary
				|-- values.
				|--
				|-- Implementation: Stream[T] is a builtin type backed by a C-level
				|-- iterator with a pull function and opaque state. Closures for
				|-- map/filter callbacks are stored in the stream's state.
				|type Stream[T] = builtin
				|
				|
				|---
				|A lazy, one-shot stream whose pull operation may fail with `E`.
				|
				|Fallible streams are intended for I/O-backed sources. Terminal operations
				|return `Result` so read errors are explicit instead of being confused with
				|normal end-of-stream.
				|
				|Like `Stream[T]`, a `FallibleStream[T, E]` is a one-shot cursor. Consume it in
				|the scope where it was created; do not store it in ordinary aggregates or
				|ordinary carrier type aliases/ascriptions, do not bind carrier values such as
				|`Option[FallibleStream[T, E]]`, do not use ordinary function signatures that
				|contain fallible-stream carriers, do not use function values whose parameters
				|or return values hide fallible-stream carriers, and do not capture it in
				|closures, detach bodies, or concurrent task bodies.
				|---
				|type FallibleStream[T, E] = builtin
				|
				|
				|---
				|A future resource-producing source.
				|
				|`ResourceSource[R, E]` is a type anchor for APIs such as TCP listener
				|connections and database pool checkouts that produce owned resources one at a
				|time. It is intentionally not an ordinary collection: it cannot be stored in
				|records, unions, lists, globals, type aliases that hide it inside ordinary
				|carriers, ordinary carrier type ascriptions such as
				|`None as Option[ResourceSource[...]]`, or ordinary local bindings such as
				|`Option[ResourceSource[...]]`, and ordinary user functions cannot accept or
				|return it yet. Function values may directly produce resource sources, but their
				|parameters and return values cannot hide resource sources in ordinary carriers
				|such as `() -> Option[ResourceSource[R, E]]`. Sequential `for` iteration
				|transfers each produced resource into a scoped loop body that owns its cleanup.
				|`for ... concurrently(limit: N)` moves each produced resource into exactly one
				|child task; the child task owns scoped cleanup before user code can park. Direct
				|source locals must be immutable, must come from producer calls rather than
				|copies of existing source locals, and must not be discarded or returned from
				|concurrent tasks. Generic record and union wrappers are checked after
				|substitution, so direct resource-source producers remain ordinary while hidden
				|carriers are rejected.
				|---
				|type ResourceSource[R, E] = builtin
				|
				|
				|-- ============================================================================
				|-- Sources (constructors)
				|-- ============================================================================
				|---
				|Create a stream from a list. Iterates elements in order, constant memory.
				|
				|doctests:
				|    :: Stream from list
				|    from_list([1, 2, 3]).collect() == [1, 2, 3]
				|---
				|func from_list[T](items: List[T]) -> Stream[T]:
				|	builtin("std/stream.from_list")
				|
				|
				|---
				|Create a stream of integers from start (inclusive) to end (exclusive).
				|
				|doctests:
				|    :: Range stream
				|    from_range(0, 3).collect() == [0, 1, 2]
				|---
				|func from_range(start: Int, end: Int) -> Stream[Int]:
				|	builtin("std/stream.from_range")
				|
				|
				|---
				|Create an infinite stream that repeats a value.
				|Must be consumed with take() or another limiting operation.
				|---
				|func repeat[T](value: T) -> Stream[T]:
				|	builtin("std/stream.repeat")
				|
				|
				|---
				|Create a stream by repeatedly applying a function to a state.
				|Returns Some((value, next_state)) to yield, None to end.
				|
				|---
				|func unfold[T, S](
				|	seed: S,
				|	f: (S) -> Option[(T, S)],
				|) -> Stream[T]:
				|	builtin("std/stream.unfold")
				|
				|
				|---
				|Create an empty stream.
				|---
				|func empty[T]() -> Stream[T]:
				|	builtin("std/stream.empty")
				|
				|
				|-- ============================================================================
				|-- Intermediate operations (lazy)
				|-- ============================================================================
				|---
				|Transform each element. Lazy.
				|
				|doctests:
				|    :: Map doubles
				|    from_list([1, 2, 3])
				|        .map(func(x: Int): x * 2)
				|        .collect() == [2, 4, 6]
				|---
				|func map[T, U](
				|	self: Stream[T],
				|	f: (T) -> U,
				|) -> Stream[U]:
				|	builtin("std/stream.map")
				|
				|
				|---
				|Keep only elements where predicate returns True. Lazy.
				|
				|doctests:
				|    :: Filter evens
				|    from_list([1, 2, 3, 4])
				|        .filter(func(x: Int): x % 2 == 0)
				|        .collect() == [2, 4]
				|---
				|func filter[T](
				|	self: Stream[T],
				|	pred: (T) -> Bool,
				|) -> Stream[T]:
				|	builtin("std/stream.filter")
				|
				|
				|---
				|Filter and map in one pass. Keeps only Some results.
				|---
				|func filter_map[T, U](
				|	self: Stream[T],
				|	f: (T) -> Option[U],
				|) -> Stream[U]:
				|	builtin("std/stream.filter_map")
				|
				|
				|---
				|Take at most n elements.
				|
				|doctests:
				|    :: Take 2
				|    from_list([1, 2, 3, 4])
				|        .take(2)
				|        .collect() == [1, 2]
				|---
				|func take[T](self: Stream[T], n: Int) -> Stream[T]:
				|	builtin("std/stream.take")
				|
				|
				|---
				|Skip the first n elements.
				|
				|doctests:
				|    :: Drop 2
				|    from_list([1, 2, 3, 4])
				|        .drop(2)
				|        .collect() == [3, 4]
				|---
				|func drop[T](self: Stream[T], n: Int) -> Stream[T]:
				|	builtin("std/stream.drop")
				|
				|
				|---
				|Take elements while predicate returns True. Stops at first False.
				|---
				|func take_while[T](
				|	self: Stream[T],
				|	pred: (T) -> Bool,
				|) -> Stream[T]:
				|	builtin("std/stream.take_while")
				|
				|
				|---
				|Pair each element with its index (0-based).
				|---
				|func enumerate[T](self: Stream[T]) -> Stream[(Int, T)]:
				|	builtin("std/stream.enumerate")
				|
				|
				|-- ============================================================================
				|-- Terminal operations (consume the stream)
				|-- ============================================================================
				|---
				|Collect all elements into a List.
				|
				|doctests:
				|    :: Collect
				|    from_list([1, 2]).collect() == [1, 2]
				|---
				|func collect[T](self: Stream[T]) -> List[T]:
				|	builtin("std/stream.collect")
				|
				|
				|---
				|Collect all elements from a fallible stream into a List.
				|
				|If the source reports an error while pulling, returns `Err(error)` and discards
				|the partially collected list.
				|---
				|@resource_result_ordinary
				|func collect_result[T, E](self: FallibleStream[T, E]) -> Result[List[T], E]:
				|	builtin("blorp_fallible_stream_collect_raw")
				|
				|
				|---
				|Fold a fallible stream with an accumulator.
				|
				|Stops at the first source error and returns `Err(error)`. Otherwise returns the
				|final accumulator in `Ok`.
				|---
				|@resource_result_ordinary
				|func fold_result[T, Acc, E](
				|	self: FallibleStream[T, E],
				|	init: Acc,
				|	f: (Acc, T) -> Acc,
				|) -> Result[Acc, E]:
				|	builtin("blorp_fallible_stream_fold_raw")
				|
				|
				|---
				|Fold (reduce) the stream with an accumulator.
				|---
				|func fold[T, Acc](
				|	self: Stream[T],
				|	init: Acc,
				|	f: (Acc, T) -> Acc,
				|) -> Acc:
				|	builtin("std/stream.fold")
				|
				|
				|---
				|Count the number of elements.
				|---
				|func count[T](self: Stream[T]) -> Int:
				|	builtin("std/stream.count")
				|
				|
				|---
				|Count the number of elements in a fallible stream.
				|
				|Stops at the first source error and returns `Err(error)`.
				|---
				|@resource_result_ordinary
				|func count_result[T, E](self: FallibleStream[T, E]) -> Result[Int, E]:
				|	builtin("blorp_fallible_stream_count_raw")
				|
				|
				|---
				|Apply a side-effecting function to each element.
				|---
				|func for_each[T](
				|	self: Stream[T],
				|	f: (T) -> Void,
				|) -> Void:
				|	builtin("std/stream.for_each")
				|
				|
				|---
				|Find the first element matching a predicate.
				|---
				|func find[T](
				|	self: Stream[T],
				|	pred: (T) -> Bool,
				|) -> Option[T]:
				|	builtin("std/stream.find")
				|
				|
				|---
				|Find the first element matching a predicate in a fallible stream.
				|
				|Returns `Ok(Some(value))` for the first match, `Ok(None)` if the stream ends
				|normally with no match, or `Err(error)` if the source reports an error.
				|The result preserves the concrete `Option[T]` layout, including primitive,
				|managed, and nested-option payloads.
				|---
				|@resource_result_ordinary
				|func find_result[T, E](
				|	self: FallibleStream[T, E],
				|	pred: (T) -> Bool,
				|) -> Result[Option[T], E]:
				|	builtin("blorp_fallible_stream_find_raw")
				|
				|
				|---
				|Check if any element satisfies the predicate. Short-circuits.
				|---
				|func any[T](
				|	self: Stream[T],
				|	pred: (T) -> Bool,
				|) -> Bool:
				|	builtin("std/stream.any")
				|
				|
				|---
				|Check if any element in a fallible stream satisfies the predicate.
				|
				|Short-circuits on the first matching element or the first source error.
				|---
				|@resource_result_ordinary
				|func any_result[T, E](
				|	self: FallibleStream[T, E],
				|	pred: (T) -> Bool,
				|) -> Result[Bool, E]:
				|	builtin("blorp_fallible_stream_any_raw")
				|
				|
				|---
				|Check if all elements satisfy the predicate. Short-circuits.
				|---
				|func all[T](
				|	self: Stream[T],
				|	pred: (T) -> Bool,
				|) -> Bool:
				|	builtin("std/stream.all")
				|
				|
				|---
				|Check if all elements in a fallible stream satisfy the predicate.
				|
				|Short-circuits on the first non-matching element or the first source error.
				|---
				|@resource_result_ordinary
				|func all_result[T, E](
				|	self: FallibleStream[T, E],
				|	pred: (T) -> Bool,
				|) -> Result[Bool, E]:
				|	builtin("blorp_fallible_stream_all_raw")
				|
			Some(source)
		"std/string":
			source: String = raw
				|-- String - String type operations
				|--
				|-- Provides operations and trait implementations for the String type.
				|-- Strings are immutable, UTF-8 encoded sequences of characters.
				|--
				|-- Core Operations (builtins):
				|-- - string, reserve, append_char, append_int: Capacity-aware construction/appends
				|-- - substring, split, trim, replace: String manipulation (join lives in list)
				|-- - starts_with, ends_with, contains, index_of: Search operations
				|-- - get: Character access (returns Option[Char])
				|-- - from_char: Create string from single character
				|-- - drop_left, take_left: Slicing shortcuts
				|-- - trim_left, trim_right: One-sided trimming
				|-- - count, lines, words: Counting and splitting
				|-- - reverse, pad_left, pad_right: Formatting
				|-- - remove_prefix, remove_suffix: Prefix/suffix removal
				|-- - is_alpha, is_digit, is_whitespace, is_alphanumeric: Char classification
				|-- - base64_encode, base64_decode: Base64 encoding/decoding
				|--
				|-- Trait Implementations:
				|-- - Stringable: Identity (string is already a string)
				|-- - HasLength: Get byte length (via builtin)
				|type String = builtin
				|
				|
				|-- ============================================================================
				|-- Capacity-Aware Construction and Append
				|-- ============================================================================
				|---
				|Create an empty string with at least the requested byte capacity.
				|
				|Capacity is an implementation detail and may grow automatically during accumulation.
				|
				|doctests:
				|    :: Empty string with capacity
				|    string(16).length() == 0
				|---
				|pure func string(capacity: Int) -> String:
				|	builtin("std/string.string")
				|
				|
				|---
				|Ensure the string has at least the requested byte capacity.
				|
				|The returned value has the same text content. If the string is shared, the
				|runtime may copy before reserving capacity.
				|---
				|pure func reserve(self: String, capacity: Int) -> String:
				|	builtin("std/string.reserve")
				|
				|
				|---
				|Append a single character, reusing capacity when the string is uniquely owned.
				|
				|doctests:
				|    :: Append single character
				|    append_char(string(1), 'a') == "a"
				|---
				|pure func append_char(self: String, c: Char) -> String:
				|	builtin("std/string.append_char")
				|
				|
				|---
				|Append an integer, reusing capacity when the string is uniquely owned.
				|
				|doctests:
				|    :: Append integer
				|    append_int(string(4), -42) == "-42"
				|---
				|pure func append_int(self: String, value: Int) -> String:
				|	builtin("blorp_string_append_int")
				|
				|
				|-- ============================================================================
				|-- Core String Operations (builtins)
				|-- ============================================================================
				|---
				|Get a substring starting at 'start' with 'len' characters.
				|
				|doctests:
				|    :: Substring from start
				|    "hello world".substring(0, 5) == "hello"
				|
				|    :: Substring from middle
				|    "hello".substring(1, 3) == "ell"
				|---
				|pure func substring(self: String, start: Int, len: Int) -> String:
				|	builtin("std/string.substring")
				|
				|
				|---
				|Check if string starts with the given prefix.
				|
				|doctests:
				|    :: Matching prefix
				|    "hello world".starts_with("hello") == True
				|
				|    :: Non-matching prefix
				|    "hello".starts_with("world") == False
				|---
				|pure func starts_with(self: String, prefix: String) -> Bool:
				|	builtin("std/string.starts_with")
				|
				|
				|---
				|Check if string ends with the given suffix.
				|
				|doctests:
				|    :: Matching suffix
				|    "hello world".ends_with("world") == True
				|
				|    :: Non-matching suffix
				|    "hello".ends_with("world") == False
				|---
				|pure func ends_with(self: String, suffix: String) -> Bool:
				|	builtin("std/string.ends_with")
				|
				|
				|---
				|Check if string contains the given needle.
				|
				|doctests:
				|    :: Contains substring
				|    "hello world".contains("world") == True
				|
				|    :: Does not contain substring
				|    "hello".contains("xyz") == False
				|---
				|pure func contains(self: String, needle: String) -> Bool:
				|	builtin("std/string.contains")
				|
				|
				|-- Raw index_of builtin (returns -1 if not found)
				|pure func raw_index_of(self: String, needle: String) -> Int:
				|	builtin("std/string.raw_index_of")
				|
				|
				|---
				|Split string by delimiter.
				|
				|doctests:
				|    :: Split by comma
				|    "a,b,c"
				|        .split(",")
				|        .length() == 3
				|---
				|pure func split(self: String, delim: String) -> List[String]:
				|	builtin("std/string.split")
				|
				|
				|---
				|Remove leading and trailing whitespace.
				|
				|doctests:
				|    :: Trim whitespace
				|    trim("  hello  ") == "hello"
				|
				|    :: No whitespace unchanged
				|    trim("no spaces") == "no spaces"
				|---
				|pure func trim(self: String) -> String:
				|	builtin("std/string.trim")
				|
				|
				|---
				|Replace all occurrences of old with new.
				|
				|doctests:
				|    :: Replace word
				|    "hello world".replace("world", "blorp") == "hello blorp"
				|
				|    :: Replace all occurrences
				|    "aaa".replace("a", "b") == "bbb"
				|---
				|pure func replace(self: String, old: String, new: String) -> String:
				|	builtin("std/string.replace")
				|
				|
				|---
				|Convert character to single-character string.
				|
				|doctests:
				|    :: Convert char to string
				|    from_char('a') == "a"
				|---
				|pure func from_char(c: Char) -> String:
				|	builtin("blorp_from_char")
				|
				|
				|---
				|Get the byte length of a string.
				|
				|doctests:
				|    :: Length of string
				|    "hello".length() == 5
				|
				|    :: Empty string length
				|    "".length() == 0
				|---
				|pure func length(self: String) -> Int:
				|	builtin("std/string.length")
				|
				|
				|-- ============================================================================
				|-- Character Conversion
				|-- ============================================================================
				|---
				|Convert a string to a list of characters (byte values).
				|
				|doctests:
				|    :: Character count matches string length
				|    "abc"
				|        .chars()
				|        .length() == 3
				|
				|    :: Round-trip preserves content
				|    "hello world"
				|        .chars()
				|        .from_chars() == "hello world"
				|
				|    :: Empty string returns empty list
				|    ""
				|        .chars()
				|        .length() == 0
				|---
				|pure func chars(self: String) -> List[Char]:
				|	builtin("blorp_string_chars")
				|
				|
				|---
				|Build a string from a list of characters.
				|
				|doctests:
				|    :: Round-trip through chars/from_chars
				|    "hello"
				|        .chars()
				|        .from_chars() == "hello"
				|
				|    :: Build from char list
				|    ['a', 'b', 'c'].from_chars() == "abc"
				|---
				|pure func from_chars(cs: List[Char]) -> String:
				|	builtin("blorp_from_chars")
				|
				|
				|---
				|Convert a String to Bytes (its raw UTF-8 encoding).
				|
				|Round-trip through [Bytes.to_string] preserves content.
				|
				|doctests:
				|    :: Round-trip
				|    "hello"
				|        .to_bytes()
				|        .to_string() == "hello"
				|
				|    :: Empty string
				|    ""
				|        .to_bytes()
				|        .length() == 0
				|---
				|pure func to_bytes(self: String) -> Bytes:
				|	builtin("blorp_bytes_from_string")
				|
				|
				|-- ============================================================================
				|-- Unicode Case Conversion
				|-- Uses Unicode default case mappings. Output byte length and codepoint count
				|-- may differ from the input.
				|-- ============================================================================
				|---
				|Convert to uppercase using Unicode default case mappings.
				|
				|doctests:
				|    :: Uppercase all
				|    "hello".upper() == "HELLO"
				|
				|    :: Mixed case to upper
				|    "Hello World".upper() == "HELLO WORLD"
				|
				|    :: Unicode expansion
				|    "straße".upper() == "STRASSE"
				|---
				|pure func upper(self: String) -> String:
				|	builtin("blorp_upper")
				|
				|
				|---
				|Convert to lowercase using Unicode default case mappings.
				|
				|doctests:
				|    :: Lowercase all
				|    "HELLO".lower() == "hello"
				|
				|    :: Mixed case to lower
				|    "Hello World".lower() == "hello world"
				|
				|    :: Unicode expansion
				|    "İ".lower() == "i̇"
				|---
				|pure func lower(self: String) -> String:
				|	builtin("blorp_lower")
				|
				|
				|-- ============================================================================
				|-- ASCII Case Helpers
				|-- ============================================================================
				|---
				|Capitalize first ASCII letter, lowercase the rest.
				|
				|doctests:
				|    :: Capitalize simple
				|    "hello".capitalize() == "Hello"
				|
				|    :: Capitalize lowercases rest
				|    "hello WORLD".capitalize() == "Hello world"
				|---
				|pure func capitalize(self: String) -> String:
				|	builtin("std/string.capitalize")
				|
				|
				|---
				|Case-insensitive comparison using Unicode default case mappings.
				|
				|doctests:
				|    :: Case insensitive match
				|    equal_ignore_case("Hello", "hello") == True
				|
				|    :: Unicode expansion match
				|    equal_ignore_case("straße", "STRASSE") == True
				|
				|    :: Case insensitive mismatch
				|    equal_ignore_case("abc", "xyz") == False
				|---
				|pure func equal_ignore_case(a: String, b: String) -> Bool:
				|	a.upper() == b.upper()
				|
				|
				|---
				|Title case: capitalize first letter of each space-separated word.
				|
				|doctests:
				|    :: Title case words
				|    "hello world".title_case() == "Hello World"
				|---
				|pure func title_case(self: String) -> String:
				|	builtin("std/string.title_case")
				|
				|
				|-- ============================================================================
				|-- Parsing
				|-- ============================================================================
				|---
				|Parse a string as an integer.
				|Returns Some(n) on success, None on failure.
				|
				|doctests:
				|    :: Parse valid integer
				|    match "42".parse_int():
				|        Some(v):
				|            v == 42
				|        None:
				|            False
				|
				|    :: Parse invalid integer
				|    match "not a number".parse_int():
				|        Some(_):
				|            False
				|        None:
				|            True
				|---
				|pure func parse_int(self: String) -> Option[Int]:
				|	builtin("blorp_parse_int")
				|
				|
				|---
				|Parse a string as a float.
				|Returns Some(f) on success, None on failure.
				|
				|doctests:
				|    :: Parse valid float
				|    match "3.14".parse_float():
				|        Some(v):
				|            v > 3.0
				|        None:
				|            False
				|
				|    :: Parse invalid float
				|    match "bad".parse_float():
				|        Some(_):
				|            False
				|        None:
				|            True
				|---
				|pure func parse_float(self: String) -> Option[Float]:
				|	builtin("blorp_parse_float")
				|
				|
				|-- ============================================================================
				|-- Safe Access
				|-- ============================================================================
				|---
				|Bounds-checked character access.
				|Returns Some(char) for valid index, None for out-of-bounds.
				|
				|doctests:
				|    :: Get valid index
				|    match "hello".get(0):
				|        Some(c):
				|            c == 'h'
				|        None:
				|            False
				|
				|    :: Get out of bounds
				|    match "hello".get(10):
				|        Some(_):
				|            False
				|        None:
				|            True
				|---
				|pure func get(self: String, index: Int) -> Option[Char]:
				|	builtin("blorp_string_get_opt")
				|
				|
				|---
				|Bounds-checked character access with a a default.
				|Always returns Char
				|
				|doctests:
				|    :: Get valid index
				|    "hello".get_or(0, 'a') == 'h'
				|
				|    :: Get out of bounds
				|    "hello".get_or(10, 'a') == 'a'
				|---
				|pure func get_or(self: String, index: Int, default: Char) -> Char:
				|	self
				|		.get(index)
				|		.get_or(default)
				|
				|
				|---
				|Find the index of needle in string.
				|Returns Some(index) if found, None if not found.
				|
				|doctests:
				|    :: Find existing substring
				|    match "hello world".index_of("world"):
				|        Some(i):
				|            i == 6
				|        None:
				|            False
				|
				|    :: Find missing substring
				|    match "hello".index_of("xyz"):
				|        Some(_):
				|            False
				|        None:
				|            True
				|---
				|pure func index_of(self: String, needle: String) -> Option[Int]:
				|	result: Int = raw_index_of(self, needle)
				|
				|	if result == -1:
				|		None
				|	else:
				|		Some(result)
				|
				|
				|-- ============================================================================
				|-- Utilities
				|-- ============================================================================
				|---
				|Check if the string is empty.
				|
				|doctests:
				|    :: Empty string
				|    "".is_empty() == True
				|
				|    :: Non-empty string
				|    "hello".is_empty() == False
				|---
				|pure func is_empty(self: String) -> Bool:
				|	length(self) == 0
				|
				|
				|---
				|Get the first character of the string, or None if empty.
				|
				|doctests:
				|    :: Head of non-empty string
				|    match "hello".head():
				|        Some(c):
				|            c == 'h'
				|        None:
				|            False
				|
				|    :: Head of empty string
				|    match "".head():
				|        Some(_):
				|            False
				|        None:
				|            True
				|---
				|pure func head(self: String) -> Option[Char]:
				|	self.get(0)
				|
				|
				|---
				|Get the string without the first character.
				|Returns empty string if input is empty.
				|
				|doctests:
				|    :: Tail of non-empty string
				|    "hello".tail() == "ello"
				|
				|    :: Tail of empty string
				|    "".tail() == ""
				|---
				|pure func tail(self: String) -> String:
				|	if self.length() > 0:
				|		self.substring(1, self.length() - 1)
				|	else:
				|		self
				|
				|
				|---
				|Repeat a string n times.
				|
				|doctests:
				|    :: Repeat string
				|    "ab".repeat(3) == "ababab"
				|
				|    :: Repeat zero times
				|    "x".repeat(0) == ""
				|---
				|pure func repeat(self: String, n: Int) -> String:
				|	builtin("std/string.repeat")
				|
				|
				|---
				|URL-encode a string (RFC 3986). Encodes all characters except
				|unreserved characters (A-Z, a-z, 0-9, -, _, ., ~) as %XX.
				|
				|doctests:
				|    :: Encode spaces
				|    "hello world".url_encode() == "hello%20world"
				|
				|    :: Encode special characters
				|    "a&b=c".url_encode() == "a%26b%3Dc"
				|---
				|pure func url_encode(self: String) -> String:
				|	builtin("blorp_url_encode")
				|
				|
				|---
				|URL-decode a string. Decodes %XX sequences and + as space.
				|
				|doctests:
				|    :: Decode percent encoding
				|    "hello%20world".url_decode() == "hello world"
				|
				|    :: Decode plus as space
				|    "a+b".url_decode() == "a b"
				|---
				|pure func url_decode(self: String) -> String:
				|	builtin("blorp_url_decode")
				|
				|
				|---
				|Escape a string for safe embedding in HTML.
				|Replaces <, >, &, ", ' with their HTML entity equivalents.
				|
				|doctests:
				|    :: Escape angle brackets
				|    "<b>bold</b>".html_escape() == "&lt;b&gt;bold&lt;/b&gt;"
				|
				|    :: Escape ampersand
				|    "a&b".html_escape() == "a&amp;b"
				|---
				|pure func html_escape(self: String) -> String:
				|	builtin("blorp_html_escape")
				|
				|
				|-- ============================================================================
				|-- Slicing
				|-- ============================================================================
				|---
				|Drop the first n characters from a string.
				|Returns empty string if n >= length.
				|
				|doctests:
				|    :: Drop from start
				|    "hello".drop_left(2) == "llo"
				|
				|    :: Drop zero
				|    "hello".drop_left(0) == "hello"
				|
				|    :: Drop all
				|    "hi".drop_left(5) == ""
				|
				|    :: Drop negative
				|    "hello".drop_left(-1) == "hello"
				|---
				|pure func drop_left(self: String, n: Int) -> String:
				|	builtin("std/string.drop_left")
				|
				|
				|---
				|Take the first n characters from a string.
				|Returns the full string if n >= length.
				|
				|doctests:
				|    :: Take from start
				|    "hello".take_left(3) == "hel"
				|
				|    :: Take zero
				|    "hello".take_left(0) == ""
				|
				|    :: Take more than length
				|    "hi".take_left(10) == "hi"
				|
				|    :: Take negative
				|    "hello".take_left(-1) == ""
				|---
				|pure func take_left(self: String, n: Int) -> String:
				|	builtin("std/string.take_left")
				|
				|
				|-- ============================================================================
				|-- Trimming
				|-- ============================================================================
				|---
				|Remove leading whitespace (spaces, tabs, newlines, carriage returns).
				|
				|doctests:
				|    :: Trim leading spaces
				|    "  hello".trim_left() == "hello"
				|
				|    :: No leading whitespace
				|    "hello  ".trim_left() == "hello  "
				|
				|    :: All whitespace
				|    "   ".trim_left() == ""
				|---
				|pure func trim_left(self: String) -> String:
				|	builtin("std/string.trim_left")
				|
				|
				|---
				|Remove trailing whitespace (spaces, tabs, newlines, carriage returns).
				|
				|doctests:
				|    :: Trim trailing spaces
				|    "hello  ".trim_right() == "hello"
				|
				|    :: No trailing whitespace
				|    "  hello".trim_right() == "  hello"
				|
				|    :: All whitespace
				|    "   ".trim_right() == ""
				|---
				|pure func trim_right(self: String) -> String:
				|	builtin("std/string.trim_right")
				|
				|
				|-- ============================================================================
				|-- Counting & Splitting
				|-- ============================================================================
				|---
				|Count non-overlapping occurrences of needle in string.
				|
				|doctests:
				|    :: Count single char
				|    "hello".count("l") == 2
				|
				|    :: Count substring
				|    "abcabcabc".count("abc") == 3
				|
				|    :: Count no matches
				|    "hello".count("xyz") == 0
				|
				|    :: Count empty needle
				|    "hello".count("") == 0
				|---
				|pure func count(self: String, needle: String) -> Int:
				|	builtin("std/string.count")
				|
				|
				|---
				|Split string on line boundaries (\n, \r\n, \r).
				|More robust than s.split("\n") for cross-platform text.
				|
				|doctests:
				|    :: Split unix lines
				|    "a\nb\nc"
				|        .lines()
				|        .length() == 3
				|
				|    :: Lines content
				|    "a\nb\nc"
				|        .lines()
				|        .join("|") == "a|b|c"
				|
				|    :: Split single line (no newline)
				|    "hello"
				|        .lines()
				|        .length() == 1
				|---
				|pure func lines(self: String) -> List[String]:
				|	self
				|		.replace("\r\n", "\n")
				|		.replace("\r", "\n")
				|		.split("\n")
				|
				|
				|---
				|Split string on whitespace, dropping empty segments.
				|Handles spaces, tabs, newlines, and leading/trailing whitespace.
				|
				|doctests:
				|    :: Split words
				|    "hello world"
				|        .words()
				|        .length() == 2
				|
				|    :: Words content
				|    "hello world"
				|        .words()
				|        .join("|") == "hello|world"
				|
				|    :: Multiple spaces
				|    "  hello   world  "
				|        .words()
				|        .join("|") == "hello|world"
				|
				|    :: Empty string
				|    ""
				|        .words()
				|        .length() == 0
				|---
				|pure func words(self: String) -> List[String]:
				|	var result: List[String] = []
				|	var start: Int = -1
				|	slen: Int = self.length()
				|
				|	for i in 0..slen:
				|		match self.get(i):
				|			Some(c):
				|				if (
				|					c == ' '
				|					or c == '\t'
				|					or c == '\n'
				|					or c == '\r'
				|				):
				|					if start >= 0:
				|						result = result.append(self.substring(start, i - start))
				|						start = -1
				|				else if start < 0:
				|					start = i
				|			None:
				|				void
				|
				|	if start >= 0:
				|		result = result.append(self.substring(start, slen - start))
				|
				|	result
				|
				|
				|-- ============================================================================
				|-- Prefix/Suffix Removal
				|-- ============================================================================
				|---
				|Remove prefix from string if present, return unchanged otherwise.
				|
				|doctests:
				|    :: Remove existing prefix
				|    "hello world".remove_prefix("hello ") == "world"
				|
				|    :: Prefix not present
				|    "hello".remove_prefix("xyz") == "hello"
				|
				|    :: Empty prefix
				|    "hello".remove_prefix("") == "hello"
				|---
				|pure func remove_prefix(self: String, prefix: String) -> String:
				|	if self.starts_with(prefix):
				|		self.drop_left(prefix.length())
				|	else:
				|		self
				|
				|
				|---
				|Remove suffix from string if present, return unchanged otherwise.
				|
				|doctests:
				|    :: Remove existing suffix
				|    "hello.txt".remove_suffix(".txt") == "hello"
				|
				|    :: Suffix not present
				|    "hello".remove_suffix(".txt") == "hello"
				|
				|    :: Empty suffix
				|    "hello".remove_suffix("") == "hello"
				|---
				|pure func remove_suffix(self: String, suffix: String) -> String:
				|	if self.ends_with(suffix):
				|		self.take_left(self.length() - suffix.length())
				|	else:
				|		self
				|
				|
				|-- ============================================================================
				|-- Padding & Reversal
				|-- ============================================================================
				|---
				|Reverse a string byte-by-byte.
				|Note: operates on bytes, not Unicode codepoints. Multi-byte characters will be corrupted.
				|
				|doctests:
				|    :: Reverse word
				|    "hello".reverse() == "olleh"
				|
				|    :: Reverse palindrome
				|    "racecar".reverse() == "racecar"
				|
				|    :: Reverse empty
				|    "".reverse() == ""
				|---
				|pure func reverse(self: String) -> String:
				|	builtin("std/string.reverse")
				|
				|
				|---
				|Pad string on the left to reach target width using fill character.
				|Returns unchanged if string is already at or beyond target width.
				|
				|doctests:
				|    :: Pad with zeros
				|    "42".pad_left(5, '0') == "00042"
				|
				|    :: Pad with spaces
				|    "hi".pad_left(5, ' ') == "   hi"
				|
				|    :: Already long enough
				|    "hello".pad_left(3, ' ') == "hello"
				|---
				|pure func pad_left(self: String, width: Int, fill: Char) -> String:
				|	builtin("std/string.pad_left")
				|
				|
				|---
				|Pad string on the right to reach target width using fill character.
				|Returns unchanged if string is already at or beyond target width.
				|
				|doctests:
				|    :: Pad with spaces
				|    "hi".pad_right(5, ' ') == "hi   "
				|
				|    :: Pad with dots
				|    "hi".pad_right(5, '.') == "hi..."
				|
				|    :: Already long enough
				|    "hello".pad_right(3, '.') == "hello"
				|---
				|pure func pad_right(self: String, width: Int, fill: Char) -> String:
				|	builtin("std/string.pad_right")
				|
				|
				|-- ============================================================================
				|-- Character Classification
				|-- ============================================================================
				|---
				|Check if a character is an ASCII letter (a-z, A-Z).
				|
				|doctests:
				|    :: Lowercase letter
				|    is_alpha('a') == True
				|
				|    :: Uppercase letter
				|    is_alpha('Z') == True
				|
				|    :: Digit is not alpha
				|    is_alpha('5') == False
				|---
				|pure func is_alpha(c: Char) -> Bool:
				|	code: Int = to_int(c)
				|	code >= 65 and code <= 90 or code >= 97 and code <= 122
				|
				|
				|---
				|Check if a character is an ASCII digit (0-9).
				|
				|doctests:
				|    :: Digit
				|    is_digit('5') == True
				|
				|    :: Letter is not digit
				|    is_digit('a') == False
				|---
				|pure func is_digit(c: Char) -> Bool:
				|	code: Int = to_int(c)
				|	code >= 48 and code <= 57
				|
				|
				|---
				|Check if a character is whitespace (space, tab, newline, carriage return).
				|
				|doctests:
				|    :: Space
				|    is_whitespace(' ') == True
				|
				|    :: Tab
				|    is_whitespace('\t') == True
				|
				|    :: Letter is not whitespace
				|    is_whitespace('a') == False
				|---
				|pure func is_whitespace(c: Char) -> Bool:
				|	code: Int = to_int(c)
				|	code == 32 or code == 9 or code == 10 or code == 13
				|
				|
				|---
				|Check if a character is alphanumeric (letter or digit).
				|
				|doctests:
				|    :: Letter
				|    is_alphanumeric('a') == True
				|
				|    :: Digit
				|    is_alphanumeric('5') == True
				|
				|    :: Punctuation is not alphanumeric
				|    is_alphanumeric('!') == False
				|---
				|pure func is_alphanumeric(c: Char) -> Bool:
				|	is_digit(c) or is_alpha(c)
				|
				|
				|-- ============================================================================
				|-- Base64 Encoding/Decoding (RFC 4648)
				|-- ============================================================================
				|---
				|Encode a string to base64.
				|
				|doctests:
				|    :: Encode simple string
				|    "hello".base64_encode() == "aGVsbG8="
				|
				|    :: Encode empty string
				|    "".base64_encode() == ""
				|
				|    :: Encode with padding
				|    "a".base64_encode() == "YQ=="
				|
				|    :: Encode no padding needed
				|    "abc".base64_encode() == "YWJj"
				|---
				|pure func base64_encode(self: String) -> String:
				|	builtin("blorp_base64_encode")
				|
				|
				|---
				|Decode a base64 string. Returns None for invalid input.
				|
				|doctests:
				|    :: Decode simple string
				|    match "aGVsbG8=".base64_decode():
				|        Some(s):
				|            s == "hello"
				|        None:
				|            False
				|
				|    :: Decode no padding
				|    match "YWJj".base64_decode():
				|        Some(s):
				|            s == "abc"
				|        None:
				|            False
				|
				|    :: Decode invalid input
				|    match "!!!".base64_decode():
				|        Some(_):
				|            False
				|        None:
				|            True
				|---
				|pure func base64_decode(self: String) -> Option[String]:
				|	builtin("blorp_base64_decode")
				|
				|
				|-- ============================================================================
				|-- Trait Implementations
				|-- ============================================================================
				|-- String is already its own string representation
				|implements Stringable for String:
				|	pure func to_string(val: String) -> String:
				|		val
				|
				|
				|implements HasLength for String:
				|	pure func length(self: String) -> Int:
				|		builtin("std/string.length")
				|
				|
				|-- ============================================================================
				|-- Extended String Operations
				|-- ============================================================================
				|---
				|Split string by delimiter with a maximum number of parts.
				|If limit is 2, at most 2 parts are returned: the text before the first
				|delimiter and the rest of the string.
				|
				|doctests:
				|    :: Split with limit 2
				|    "a.b.c.d".split_n(".", 2) == ["a", "b.c.d"]
				|
				|    :: Split with high limit
				|    "a.b".split_n(".", 10) == ["a", "b"]
				|---
				|pure func split_n(self: String, delim: String, limit: Int) -> List[String]:
				|	if delim.length() == 0 or limit <= 0:
				|		[self]
				|	else:
				|		var result: List[String] = []
				|		var pos: Int = 0
				|		var parts: Int = 0
				|		slen: Int = self.length()
				|		dlen: Int = delim.length()
				|
				|		while pos <= slen and parts < limit - 1:
				|			idx: Int = raw_index_of(
				|				self.substring(pos, slen - pos),
				|				delim,
				|			)
				|
				|			if idx < 0:
				|				break
				|			else:
				|				result = result.append(self.substring(pos, idx))
				|				pos = pos + idx + dlen
				|				parts += 1
				|
				|		result = result.append(self.substring(pos, slen - pos))
				|		result
				|
				|
				|---
				|Replace only the first occurrence of old with new.
				|
				|doctests:
				|    :: Replace first match
				|    "abab".replace_first("ab", "x") == "xab"
				|
				|    :: No match returns unchanged
				|    "hello".replace_first("xyz", "q") == "hello"
				|---
				|pure func replace_first(self: String, old: String, new: String) -> String:
				|	if old.length() == 0:
				|		self
				|	else:
				|		idx: Int = raw_index_of(self, old)
				|
				|		if idx < 0:
				|			self
				|		else:
				|			self.substring(
				|				0,
				|				idx,
				|			) + new + self.substring(idx + old.length(), self.length() - idx - old.length())
				|
				|
				|-- Raw last_index_of builtin (returns -1 if not found) - internal use only
				|private pure func raw_last_index_of(self: String, needle: String) -> Int:
				|	builtin("std/string.raw_last_index_of")
				|
				|
				|---
				|Find the last index of needle in string.
				|Returns Some(index) if found, None if not found.
				|
				|doctests:
				|    :: Find last occurrence
				|    match "abcabc".last_index_of("abc"):
				|        Some(i):
				|            i == 3
				|        None:
				|            False
				|
				|    :: Not found
				|    match "hello".last_index_of("xyz"):
				|        Some(_):
				|            False
				|        None:
				|            True
				|---
				|pure func last_index_of(self: String, needle: String) -> Option[Int]:
				|	result: Int = raw_last_index_of(self, needle)
				|
				|	if result == -1:
				|		None
				|	else:
				|		Some(result)
				|
				|
				|---
				|Remove characters in the given set from both ends of the string.
				|
				|doctests:
				|    :: Trim hash characters
				|    "##hello##".trim_chars("#") == "hello"
				|
				|    :: Trim multiple character types
				|    "xxyhelloxyy".trim_chars("xy") == "hello"
				|---
				|pure func trim_chars(self: String, chars: String) -> String:
				|	builtin("std/string.trim_chars")
				|
				|
				|---
				|Take the last n characters from a string.
				|Returns the full string if n >= length.
				|
				|doctests:
				|    :: Take right
				|    "hello".take_right(3) == "llo"
				|
				|    :: Take more than length
				|    "hi".take_right(10) == "hi"
				|---
				|pure func take_right(self: String, n: Int) -> String:
				|	builtin("std/string.take_right")
				|
				|
				|---
				|Drop the last n characters from a string.
				|Returns empty string if n >= length.
				|
				|doctests:
				|    :: Drop right
				|    "hello".drop_right(2) == "hel"
				|
				|    :: Drop all
				|    "hello".drop_right(10) == ""
				|---
				|pure func drop_right(self: String, n: Int) -> String:
				|	builtin("std/string.drop_right")
				|
				|
				|---
				|Center a string within the given width using a fill character.
				|Left side gets floor(padding/2), right side gets the rest.
				|
				|doctests:
				|    :: Center with spaces
				|    "hi".center(6, ' ') == "  hi  "
				|
				|    :: Already wide enough
				|    "hello".center(3, ' ') == "hello"
				|---
				|pure func center(self: String, width: Int, fill: Char) -> String:
				|	builtin("std/string.center")
				|
				|
				|-- ============================================================================
				|-- String Predicates
				|-- ============================================================================
				|---
				|Check if all characters in the string are ASCII digits.
				|Returns False for empty strings.
				|
				|doctests:
				|    :: All digits
				|    "12345".is_numeric() == True
				|
				|    :: Contains non-digit
				|    "12a".is_numeric() == False
				|
				|    :: Empty string
				|    "".is_numeric() == False
				|
				|    :: Single digit
				|    "0".is_numeric() == True
				|
				|    :: With spaces
				|    "1 2".is_numeric() == False
				|
				|    :: With decimal point
				|    "3.14".is_numeric() == False
				|---
				|pure func is_numeric(self: String) -> Bool:
				|	builtin("std/string.is_numeric")
				|
				|
				|---
				|Check if all characters in the string are ASCII (byte values <= 127).
				|Returns True for empty strings.
				|
				|doctests:
				|    :: ASCII string
				|    "hello".is_ascii() == True
				|
				|    :: Non-ASCII string
				|    "café".is_ascii() == False
				|---
				|pure func is_ascii(self: String) -> Bool:
				|	builtin("std/string.is_ascii")
				|
				|
				|---
				|Remove common leading whitespace from all lines in a multi-line string.
				|Empty lines are ignored when computing the minimum indent.
				|
				|doctests:
				|    :: Dedent two-space indent
				|    dedent("  a\n  b") == "a\nb"
				|---
				|func dedent(self: String) -> String:
				|	all_lines: List[String] = self.split("\n")
				|
				|	-- Find minimum indent of non-empty lines by comparing length vs trim_left length
				|	var min_indent: Option[Int] = None
				|
				|	for line in all_lines:
				|		if line.length() > 0:
				|			trimmed: String = line.trim_left()
				|			indent_len: Int = line.length() - trimmed.length()
				|
				|			match min_indent:
				|				None:
				|					min_indent = Some(indent_len)
				|				Some(current):
				|					if indent_len < current:
				|						min_indent = Some(indent_len)
				|
				|	indent_to_strip: Int = min_indent.get_or(0)
				|
				|	-- Strip min_indent from each line
				|	var result_lines: List[String] = []
				|
				|	for line in all_lines:
				|		if line.length() == 0:
				|			result_lines = result_lines.append(line)
				|		else:
				|			result_lines = result_lines.append(line.drop_left(indent_to_strip))
				|
				|	result_lines.join("\n")
				|
				|
				|-- ============================================================================
				|-- Unicode Operations
				|-- ============================================================================
				|---
				|Count the number of Unicode codepoints in a UTF-8 string.
				|This may differ from byte length for multi-byte characters.
				|
				|doctests:
				|    :: ASCII string
				|    "hello".codepoint_length() == 5
				|
				|    :: Multi-byte characters
				|    "café".codepoint_length() == 4
				|---
				|pure func codepoint_length(self: String) -> Int:
				|	builtin("blorp_codepoint_length")
				|
				|
				|---
				|Get a list of Unicode codepoints (as integers) from a UTF-8 string.
				|
				|doctests:
				|    :: ASCII codepoints
				|    "AB".codepoints() == [65, 66]
				|---
				|pure func codepoints(self: String) -> List[Int]:
				|	builtin("blorp_string_codepoints")
				|
				|
				|---
				|Reverse a string by Unicode codepoints (preserves multi-byte characters).
				|
				|doctests:
				|    :: Reverse ASCII
				|    "hello".codepoint_reverse() == "olleh"
				|---
				|pure func codepoint_reverse(self: String) -> String:
				|	builtin("blorp_codepoint_reverse")
				|
				|
				|-- ============================================================================
				|-- String Algorithms
				|-- ============================================================================
				|---
				|Compute the edit distance (Levenshtein distance) between two strings.
				|Uses dynamic programming with two rows for O(min(m,n)) space.
				|
				|doctests:
				|    :: Same strings
				|    levenshtein("hello", "hello") == 0
				|
				|    :: One edit
				|    levenshtein("kitten", "sitten") == 1
				|
				|    :: Multiple edits
				|    levenshtein("saturday", "sunday") == 3
				|
				|    :: Empty strings
				|    levenshtein("", "") == 0
				|
				|    :: One empty
				|    levenshtein("abc", "") == 3
				|
				|    :: Symmetric
				|    levenshtein("abc", "def") == levenshtein("def", "abc")
				|
				|    :: Single char difference
				|    levenshtein("a", "b") == 1
				|
				|    :: Insertion
				|    levenshtein("ac", "abc") == 1
				|
				|    :: Deletion
				|    levenshtein("abc", "ac") == 1
				|---
				|pure func levenshtein(a: String, b: String) -> Int:
				|	builtin("blorp_string_levenshtein")
				|
				|
				|---
				|Find the longest common prefix of two strings.
				|
				|doctests:
				|    :: Common prefix
				|    longest_common_prefix("hello", "help") == "hel"
				|
				|    :: No common prefix
				|    longest_common_prefix("abc", "xyz") == ""
				|
				|    :: One is prefix of other
				|    longest_common_prefix("abc", "abcdef") == "abc"
				|
				|    :: Empty string
				|    longest_common_prefix("", "hello") == ""
				|
				|    :: Identical strings
				|    longest_common_prefix("same", "same") == "same"
				|
				|    :: Single char match
				|    longest_common_prefix("ab", "ac") == "a"
				|
				|    :: Both empty
				|    longest_common_prefix("", "") == ""
				|---
				|pure func longest_common_prefix(a: String, b: String) -> String:
				|	builtin("std/string.longest_common_prefix")
				|
				|
				|---
				|Hamming distance between two equal-length strings.
				|Returns None if the strings have different lengths.
				|
				|doctests:
				|    :: Same strings
				|    match hamming_distance("hello", "hello"):
				|        Some(d):
				|            d == 0
				|        None:
				|            False
				|
				|    :: Different strings
				|    match hamming_distance("karolin", "kathrin"):
				|        Some(d):
				|            d == 3
				|        None:
				|            False
				|
				|    :: Different lengths
				|    match hamming_distance("ab", "abc"):
				|        Some(_):
				|            False
				|        None:
				|            True
				|
				|    :: All different
				|    match hamming_distance("abc", "xyz"):
				|        Some(d):
				|            d == 3
				|        None:
				|            False
				|
				|    :: Empty strings
				|    match hamming_distance("", ""):
				|        Some(d):
				|            d == 0
				|        None:
				|            False
				|
				|    :: Single char
				|    match hamming_distance("a", "b"):
				|        Some(d):
				|            d == 1
				|        None:
				|            False
				|---
				|private pure func hamming_distance_raw(a: String, b: String) -> Int:
				|	builtin("std/string.hamming_distance_raw")
				|
				|
				|pure func hamming_distance(a: String, b: String) -> Option[Int]:
				|	result: Int = hamming_distance_raw(a, b)
				|
				|	if result < 0:
				|		None
				|	else:
				|		Some(result)
				|
				|
				|---
				|Find the longest common substring of two strings.
				|Returns the first longest common substring found.
				|
				|doctests:
				|    :: Common substring
				|    longest_common_substring("abcdef", "zbcdf") == "bcd"
				|
				|    :: No common substring
				|    longest_common_substring("abc", "xyz") == ""
				|
				|    :: Identical strings
				|    longest_common_substring("hello", "hello") == "hello"
				|
				|    :: Empty string
				|    longest_common_substring("", "hello") == ""
				|
				|    :: Single char match
				|    longest_common_substring("axb", "cyb") == "b"
				|
				|    :: Substring at start
				|    longest_common_substring("abcxyz", "abcdef") == "abc"
				|
				|    :: Substring at end
				|    longest_common_substring("xyzabc", "defabc") == "abc"
				|
				|    :: Both empty
				|    longest_common_substring("", "") == ""
				|---
				|pure func longest_common_substring(a: String, b: String) -> String:
				|	builtin("blorp_string_lcs")
				|
				|
				|-- ============================================================================
				|-- Number Formatting
				|-- ============================================================================
				|---
				|Convert a non-negative integer to a hexadecimal string (lowercase).
				|Negative numbers are prefixed with "-".
				|
				|doctests:
				|    :: Zero
				|    to_hex(0) == "0"
				|
				|    :: Small number
				|    to_hex(255) == "ff"
				|
				|    :: Large number
				|    to_hex(4096) == "1000"
				|
				|    :: Negative number
				|    to_hex(-1) == "-1"
				|
				|    :: Sixteen
				|    to_hex(16) == "10"
				|---
				|pure func to_hex(n: Int) -> String:
				|	if n == 0:
				|		"0"
				|	else if n < 0:
				|		"-" + to_hex(0 - n)
				|	else:
				|		hex_chars: String = "0123456789abcdef"
				|		var result: String = ""
				|		var remaining: Int = n
				|
				|		while remaining > 0:
				|			digit: Int = remaining % 16
				|
				|			match hex_chars.get(digit):
				|				Some(c):
				|					result = from_char(c) + result
				|				None:
				|					result = "?" + result
				|
				|			remaining /= 16
				|
				|		result
				|
				|
				|-- ============================================================================
				|-- Additional String Functions
				|-- ============================================================================
				|---
				|Split at the first occurrence of delimiter, returning the parts before and after.
				|Returns None if the delimiter is not found.
				|
				|doctests:
				|    :: Found
				|    match "key=value".split_once("="):
				|        Some(pair):
				|            pair[0] == "key" and pair[1] == "value"
				|        None:
				|            False
				|
				|    :: Not found
				|    match "hello".split_once("="):
				|        Some(_):
				|            False
				|        None:
				|            True
				|
				|    :: Multi-char delimiter
				|    match "a::b::c".split_once("::"):
				|        Some(pair):
				|            pair[0] == "a" and pair[1] == "b::c"
				|        None:
				|            False
				|---
				|pure func split_once(self: String, delim: String) -> Option[(String, String)]:
				|	i ?= self.index_of(delim)
				|	Some((self.take_left(i), self.drop_left(i + delim.length())))
				|
				|
				|---
				|Check if the string is empty or contains only whitespace.
				|
				|doctests:
				|    :: Empty
				|    "".is_blank() == True
				|
				|    :: Spaces
				|    "   ".is_blank() == True
				|
				|    :: Not blank
				|    " x ".is_blank() == False
				|
				|    :: Tabs and newlines
				|    " \t\n ".is_blank() == True
				|---
				|pure func is_blank(self: String) -> Bool:
				|	builtin("std/string.is_blank")
				|
				|
				|---
				|Check if the string has at least one letter and all letters are lowercase.
				|Non-letter characters (digits, punctuation) are ignored.
				|
				|doctests:
				|    :: All lower
				|    "hello".is_lower() == True
				|
				|    :: With digits
				|    "abc123".is_lower() == True
				|
				|    :: Has upper
				|    "Hello".is_lower() == False
				|
				|    :: Empty
				|    "".is_lower() == False
				|
				|    :: No letters
				|    "123".is_lower() == False
				|---
				|pure func is_lower(self: String) -> Bool:
				|	builtin("std/string.is_lower")
				|
				|
				|---
				|Check if the string has at least one letter and all letters are uppercase.
				|Non-letter characters (digits, punctuation) are ignored.
				|
				|doctests:
				|    :: All upper
				|    "HELLO".is_upper() == True
				|
				|    :: With digits
				|    "ABC123".is_upper() == True
				|
				|    :: Has lower
				|    "Hello".is_upper() == False
				|
				|    :: Empty
				|    "".is_upper() == False
				|---
				|pure func is_upper(self: String) -> Bool:
				|	builtin("std/string.is_upper")
				|
				|
				|---
				|Add a prefix to each non-empty line. Empty lines are left unchanged.
				|Inverse of dedent.
				|
				|doctests:
				|    :: Basic indent
				|    "a\nb".indent("  ") == "  a\n  b"
				|
				|    :: Empty lines preserved
				|    "a\n\nb".indent("  ") == "  a\n\n  b"
				|
				|    :: Single line
				|    "hello".indent("--") == "--hello"
				|---
				|pure func indent(self: String, prefix: String) -> String:
				|	if self.length() == 0:
				|		""
				|	else:
				|		result: List[String] = self
				|			.split("\n")
				|			.map(func(line: String):
				|				if line.length() == 0:
				|					""
				|				else:
				|					prefix + line
				|			)
				|
				|		result.join("\n")
				|
				|
				|---
				|Truncate a string to max_len characters, appending suffix if truncated.
				|The total length including suffix will not exceed max_len.
				|
				|doctests:
				|    :: Truncated
				|    "hello world".truncate(8, "...") == "hello..."
				|
				|    :: Not truncated
				|    "hi".truncate(10, "...") == "hi"
				|
				|    :: Exact length
				|    "hello".truncate(5, "...") == "hello"
				|---
				|pure func truncate(self: String, max_len: Int, suffix: String) -> String:
				|	if self.length() <= max_len:
				|		self
				|	else:
				|		self.take_left(max_len - suffix.length()) + suffix
				|
				|
				|---
				|Insert a substring at the given byte index.
				|
				|doctests:
				|    :: Middle
				|    "helo".insert(3, "l") == "hello"
				|
				|    :: Start
				|    "world".insert(0, "hello ") == "hello world"
				|
				|    :: End
				|    "hello".insert(5, " world") == "hello world"
				|---
				|pure func insert(self: String, index: Int, substr: String) -> String:
				|	self.take_left(index) + substr + self.drop_left(index)
				|
				|
				|---
				|Format an integer in the given base (2-36).
				|Returns lowercase letters for digits above 9.
				|
				|doctests:
				|    :: Binary
				|    to_base(10, 2) == "1010"
				|
				|    :: Octal
				|    to_base(255, 8) == "377"
				|
				|    :: Hex
				|    to_base(255, 16) == "ff"
				|
				|    :: Decimal
				|    to_base(42, 10) == "42"
				|
				|    :: Zero
				|    to_base(0, 16) == "0"
				|---
				|pure func to_base(n: Int, base: Int) -> String:
				|	if n == 0:
				|		"0"
				|	else:
				|		digits: String = "0123456789abcdefghijklmnopqrstuvwxyz"
				|		var result: String = ""
				|		var remaining: Int = n
				|
				|		if remaining < 0:
				|			remaining = 0 - remaining
				|
				|		while remaining > 0:
				|			digit: Int = remaining % base
				|
				|			match digits.get(digit):
				|				Some(c):
				|					result = from_char(c) + result
				|				None:
				|					result = "?" + result
				|
				|			remaining /= base
				|
				|		if n < 0:
				|			"-" + result
				|		else:
				|			result
				|
				|
				|---
				|Find all non-overlapping occurrence positions of needle in the string.
				|
				|doctests:
				|    :: Multiple occurrences
				|    "abcabc".indices_of("a") == [0, 3]
				|
				|    :: No occurrences
				|    "hello"
				|        .indices_of("z")
				|        .length() == 0
				|
				|    :: Multi-char needle
				|    "aabaa".indices_of("aa") == [0, 3]
				|---
				|pure func indices_of(self: String, needle: String) -> List[Int]:
				|	if needle.length() == 0 or self.length() == 0:
				|		[]
				|	else:
				|		var result: List[Int] = []
				|		var pos: Int = 0
				|		var remaining: String = self
				|
				|		while remaining.length() >= needle.length():
				|			match remaining.index_of(needle):
				|				Some(i):
				|					result = result.append(pos + i)
				|					pos = pos + i + needle.length()
				|					remaining = remaining.drop_left(i + needle.length())
				|				None:
				|					remaining = ""
				|
				|		result
				|
				|
				|-- String concatenation is handled by the + operator in the compiler
				|---
				|Convert an integer to a binary string.
				|
				|doctests:
				|    :: Binary of 10
				|    to_binary(10) == "1010"
				|
				|    :: Binary of 0
				|    to_binary(0) == "0"
				|---
				|pure func to_binary(n: Int) -> String:
				|	to_base(n, 2)
				|
				|
				|---
				|Zero-pad an integer to the given width.
				|
				|doctests:
				|    :: Pad single digit
				|    zero_pad(5, 3) == "005"
				|
				|    :: No padding needed
				|    zero_pad(123, 3) == "123"
				|
				|    :: Wider than needed
				|    zero_pad(1234, 3) == "1234"
				|---
				|pure func zero_pad(n: Int, width: Int) -> String:
				|	s: String = n.to_string()
				|	s.pad_left(width, '0')
				|
			Some(source)
		"std/system":
			source: String = raw
				|-- System - System interface and File I/O operations
				|--
				|-- Provides functions for interacting with the operating system and file system.
				|-- All file I/O functions are impure as they have side effects.
				|import:
				|	fs: IOError, open_dir, read_entry
				|
				|
				|-- ============================================================================
				|-- Command Execution
				|-- ============================================================================
				|---
				|Execute a shell command, returns exit code.
				|WARNING: Spawns a shell. User input passed to this function can lead to command
				|injection. Prefer process.run() for safe command execution without shell
				|interpretation.
				|---
				|func exec(command: String) -> Int:
				|	builtin("blorp_exec")
				|
				|
				|-- ============================================================================
				|-- File System Queries
				|-- ============================================================================
				|-- Check if a file or directory exists
				|func file_exists(path: String) -> Bool:
				|	builtin("blorp_file_exists")
				|
				|
				|-- Check if path is a directory
				|func is_directory(path: String) -> Bool:
				|	builtin("blorp_is_directory")
				|
				|
				|-- ============================================================================
				|-- File I/O
				|-- ============================================================================
				|-- Read entire file contents, returns Err with error message on failure
				|func read_file(path: String) -> Result[String, String]:
				|	builtin("blorp_read_file")
				|
				|
				|-- Write content to file, returns Err with error message on failure
				|func write_file(path: String, content: String) -> Result[Void, String]:
				|	builtin("blorp_write_file")
				|
				|
				|-- Read entire file contents as raw bytes, returns Err with error message on failure
				|func read_bytes(path: String) -> Result[Bytes, String]:
				|	builtin("blorp_read_bytes")
				|
				|
				|-- Write bytes directly to a file, returns Err with error message on failure
				|func write_bytes(path: String, content: Bytes) -> Result[Void, String]:
				|	builtin("blorp_write_bytes")
				|
				|
				|-- Read all lines from a file into a list (strips newlines)
				|-- Returns empty list if file doesn't exist
				|-- Loads entire file into memory; for small/medium files
				|func read_all_lines(path: String) -> List[String]:
				|	builtin("blorp_read_all_lines")
				|
				|
				|-- Write list of strings as lines to a file (adds newlines)
				|-- Returns True on success
				|func write_lines(path: String, lines: List[String]) -> Bool:
				|	match write_file(
				|		path,
				|		lines.join("\n"),
				|	):
				|		Ok(_):
				|			True
				|		Err(_):
				|			False
				|
				|
				|-- Append content to end of file, returns True on success
				|func append_file(path: String, content: String) -> Bool:
				|	builtin("blorp_append_file")
				|
				|
				|-- Process a file line by line with constant memory usage
				|-- Callback receives (line_number, line_content) — 1-indexed, newlines stripped
				|-- Returns Ok on success, Err on file open failure
				|func for_each_line(
				|	path: String,
				|	callback: (Int, String) -> Void,
				|) -> Result[Void, String]:
				|	builtin("blorp_for_each_line")
				|
				|
				|---
				|Process a file in chunks with constant memory usage.
				|Reads chunk_size bytes at a time, calls callback with each chunk as a String.
				|Returns Ok on success, Err on file open failure.
				|
				|doctests:
				|    :: Read file in chunks
				|    _ = write_file("/tmp/__blorp_test_chunk", "hello world")
				|    result: Result[Void, String] = for_each_chunk("/tmp/__blorp_test_chunk", 5, func(chunk: String):
				|        _ = chunk.length()
				|    )
				|    _ = remove_file("/tmp/__blorp_test_chunk")
				|    to_bool(result)
				|---
				|func for_each_chunk(
				|	path: String,
				|	chunk_size: Int,
				|	callback: (String) -> Void,
				|) -> Result[Void, String]:
				|	builtin("blorp_for_each_chunk")
				|
				|
				|-- ============================================================================
				|-- Filesystem Operations
				|-- ============================================================================
				|---
				|Get the current working directory.
				|Returns empty string if the directory cannot be determined.
				|
				|doctests:
				|    :: getcwd returns a non-empty string
				|    getcwd().length() > 0
				|---
				|func getcwd() -> String:
				|	builtin("blorp_getcwd")
				|
				|
				|---
				|Create a directory at the given path with mode 0755.
				|Returns True on success, False on failure (e.g., path already exists).
				|
				|doctests:
				|    :: Create and clean up a test directory
				|    _ = mkdir("/tmp/__blorp_test_mkdir")
				|    result: Bool = file_exists("/tmp/__blorp_test_mkdir")
				|    _ = remove_dir("/tmp/__blorp_test_mkdir")
				|    result == True
				|---
				|func mkdir(path: String) -> Bool:
				|	builtin("blorp_mkdir")
				|
				|
				|---
				|Remove a file at the given path.
				|Returns True on success, False on failure (e.g., file does not exist).
				|
				|doctests:
				|    :: Remove a file that was just created
				|    _ = write_file("/tmp/__blorp_test_rm", "x")
				|    remove_file("/tmp/__blorp_test_rm") == True
				|
				|    :: Removing a nonexistent file returns False
				|    remove_file("/tmp/__blorp_nonexistent_file_xyz") == False
				|---
				|func remove_file(path: String) -> Bool:
				|	builtin("blorp_remove_file")
				|
				|
				|---
				|Remove an empty directory at the given path.
				|Returns True on success, False on failure (e.g., not empty or does not exist).
				|
				|doctests:
				|    :: Remove an empty directory
				|    _ = mkdir("/tmp/__blorp_test_rmdir")
				|    remove_dir("/tmp/__blorp_test_rmdir") == True
				|
				|    :: Removing a nonexistent directory returns False
				|    remove_dir("/tmp/__blorp_nonexistent_dir_xyz") == False
				|---
				|func remove_dir(path: String) -> Bool:
				|	builtin("blorp_remove_dir")
				|
				|
				|---
				|Rename a file or directory from src path to dst path.
				|Returns True on success, False on failure.
				|
				|doctests:
				|    :: Rename a file
				|    _ = write_file("/tmp/__blorp_test_rename_src", "data")
				|    _ = rename("/tmp/__blorp_test_rename_src", "/tmp/__blorp_test_rename_dst")
				|    result: Bool = file_exists("/tmp/__blorp_test_rename_dst")
				|    _ = remove_file("/tmp/__blorp_test_rename_dst")
				|    result == True
				|---
				|func rename(src: String, dst: String) -> Bool:
				|	builtin("blorp_rename")
				|
				|
				|---
				|Execute a shell command and capture its stdout output.
				|Returns Ok with the output string (trailing newline stripped) on success,
				|or Err with an error message on failure.
				|
				|WARNING: Uses popen() which spawns a shell. User input passed to this
				|function can lead to command injection. Prefer process.run() for safe
				|command execution without shell interpretation.
				|
				|doctests:
				|    :: Capture echo output
				|    to_bool(exec_output("echo hello"))
				|
				|    :: Failed command returns Err
				|    not to_bool(exec_output("false"))
				|---
				|func exec_output(command: String) -> Result[String, String]:
				|	builtin("blorp_exec_output")
				|
				|
				|-- ============================================================================
				|-- Environment Variables
				|-- ============================================================================
				|-- Get environment variable value, returns None if not set
				|func getenv(name: String) -> Option[String]:
				|	builtin("blorp_getenv")
				|
				|
				|-- Set environment variable, returns True on success
				|func setenv(name: String, value: String) -> Bool:
				|	builtin("blorp_setenv")
				|
				|
				|-- ============================================================================
				|-- Timing
				|-- ============================================================================
				|-- Get monotonic time in microseconds (for performance measurement)
				|-- NOTE: This is monotonic clock time, not wall-clock. Use time for dates.
				|func now_microseconds() -> Int:
				|	builtin("blorp_now_us")
				|
				|
				|-- ============================================================================
				|-- File Metadata
				|-- ============================================================================
				|---
				|Get file size in bytes.
				|
				|doctests:
				|    :: Get size of a file
				|    _ = write_file("/tmp/__blorp_test_fsize", "hello")
				|
				|    match file_size("/tmp/__blorp_test_fsize"):
				|        Ok(n):
				|            n == 5
				|        Err(_):
				|            False
				|---
				|func file_size(path: String) -> Result[Int, String]:
				|	builtin("blorp_file_size")
				|
				|
				|---
				|Get file modification time as seconds since Unix epoch.
				|
				|doctests:
				|    :: Get mtime of a file
				|    _ = write_file("/tmp/__blorp_test_fmod", "data")
				|
				|    match file_modified("/tmp/__blorp_test_fmod"):
				|        Ok(t):
				|            t > 0
				|        Err(_):
				|            False
				|---
				|func file_modified(path: String) -> Result[Int, String]:
				|	builtin("blorp_file_modified")
				|
				|
				|---
				|Get the system temporary directory path.
				|
				|doctests:
				|    :: Temp dir is non-empty
				|    temp_dir().length() > 0
				|---
				|func temp_dir() -> String:
				|	builtin("blorp_temp_dir")
				|
				|
				|---
				|Create a temporary file with a given prefix. Returns the path on success.
				|
				|doctests:
				|    :: Create temp file
				|    match mkstemp_path("blorp_test_"):
				|        Ok(path):
				|            file_exists(path)
				|        Err(_):
				|            False
				|---
				|func mkstemp_path(prefix: String) -> Result[String, String]:
				|	builtin("blorp_mkstemp_path")
				|
				|
				|---
				|Recursively list all files under a directory.
				|
				|doctests:
				|    :: Walk dir finds files
				|    _ = mkdir("/tmp/__blorp_test_walk")
				|    _ = write_file("/tmp/__blorp_test_walk/a.txt", "a")
				|    files: List[String] = walk_dir("/tmp/__blorp_test_walk")
				|    _ = remove_file("/tmp/__blorp_test_walk/a.txt")
				|    _ = remove_dir("/tmp/__blorp_test_walk")
				|    files.length() >= 1
				|---
				|private func walk_dir_result(path: String) -> Result[List[String], IOError]:
				|	with dir ?= open_dir(path):
				|		var result: List[String] = []
				|		var done: Bool = False
				|		var error: Option[IOError] = None
				|
				|		while not done:
				|			match read_entry(dir):
				|				Ok(Some(entry)):
				|					full: String = path + "/" + entry.name
				|
				|					if is_directory(full):
				|						for sub in walk_dir(full):
				|							result = result.append(sub)
				|					else:
				|						result = result.append(full)
				|				Ok(None):
				|					done = True
				|				Err(err):
				|					error = Some(err)
				|					done = True
				|
				|		match error:
				|			Some(err):
				|				Err(err)
				|			None:
				|				Ok(result)
				|
				|
				|func walk_dir(path: String) -> List[String]:
				|	match walk_dir_result(path):
				|		Ok(files):
				|			files
				|		Err(_):
				|			[]
				|
			Some(source)
		"std/tensor":
			source: String = raw
				|-- Tensor - Generic multi-dimensional array operations
				|--
				|-- Core operations that work on ANY tensor regardless of dimensionality.
				|-- These operate on the first dimension (peeling semantics).
				|--
				|-- #N... (variadic dimensions) means "any number of dimensions." It is used
				|-- in function signatures to accept tensors of any shape. The concrete
				|-- dimensions flow through at the call site:
				|--
				|-- v = vector(0.0, 5)   -- 5-element zero vector
				|-- w = vector(42, 3)     -- 3-element vector filled with 42
				|-- m = matrix(0, 2, 3)  -- 2x3 matrix of zeros
				|--
				|-- #N... accepts any number of dimensions. It must be the last type
				|-- argument and can only appear once.
				|--
				|-- For 1D-specific ops (reductions, HOFs), see vector.
				|-- For 2D-specific ops (multiply, transpose), see matrix.
				|-- ============================================================================
				|-- Core Operations (builtins)
				|-- ============================================================================
				|---
				|Get the length of the first dimension.
				|---
				|pure func length[T](arr: T[#_...]) -> Int:
				|	builtin("std/tensor.length")
				|
				|
				|---
				|Bounds-checked element access.
				|Returns Some(element) for valid index, None for out-of-bounds.
				|---
				|pure func get(arr: T[#_], index: Int) -> Option[T]:
				|	builtin("std/tensor.get")
				|
				|
				|---
				|Get element at index, returning default if out of bounds.
				|---
				|pure func get_or(arr: T[#_], index: Int, default: T) -> T:
				|	match arr.get(index):
				|		Some(v):
				|			v
				|		None:
				|			default
				|
				|
				|---
				|Bounds-checked element update (returns new tensor with COW).
				|Returns Some(new_tensor) on success, None for out-of-bounds.
				|---
				|pure func set_index(arr: T[#N], index: Int, val: T) -> Option[T[#N]]:
				|	builtin("std/tensor.set_index")
				|
				|
				|-- ============================================================================
				|-- Shape
				|-- ============================================================================
				|---
				|Runtime shape assertion: refine a variadic-dim tensor to a concrete size.
				|Returns Some(tensor) when [length(t) == expected_len], or None otherwise.
				|Used to convert [T[#Ds...]] into [T[#N]] at API boundaries
				|where the expected size is a constant.
				|---
				|pure func assert_shape(t: T[#Ds...], expected_len: Int) -> Option[T[#Ds...]]:
				|	builtin("std/tensor.assert_shape")
				|
				|
				|---
				|First-dimension index loop combinator.
				|Use in [for]: [for i in indices(vector): ...].
				|In for-position, inference rewrites this into a non-materializing loop-view.
				|The yielded index is range-refined, so tensor subscripts using it are
				|compile-time bounds-checked.
				|---
				|pure func indices(vec: T[#Ds...]) -> List[Int]:
				|	builtin("std/tensor.indices")
				|
				|
				|---
				|Flat 2D iteration combinator: yields (row, col, value) triples.
				|Use in [for]: [for (i, j, v) in enumerate2(matrix): ...].
				|In for-position, inference rewrites this into a non-materializing loop-view, so
				|no intermediate List is allocated.
				|---
				|pure func enumerate2(mat: T[#M, #N]) -> List[(Int, Int, T)]:
				|	builtin("std/tensor.enumerate2")
				|
				|
				|---
				|Flat 1D iteration combinator: yields (index, value) pairs.
				|Use in [for]: [for (i, v) in enumerate(vector): ...].
				|In for-position, inference rewrites this into a non-materializing loop-view, so
				|no intermediate List is allocated.
				|---
				|pure func enumerate(vec: T[#Ds...]) -> List[(Int, T)]:
				|	builtin("std/tensor.enumerate")
				|
				|
				|---
				|Sliding window loop combinator over 1D tensors.
				|Use in [for]: [for w in windows(v, 3): ...].
				|In for-position, inference rewrites this into a non-materializing loop-view.
				|Each yielded [w] has type [T[#K]] and supports compile-time
				|bounds-checked indexing with [0..K-1] inside the loop body.
				|---
				|pure func windows(vec: T[#Ds...], size: Int) -> List[T]:
				|	builtin("std/tensor.windows")
				|
				|
				|-- ============================================================================
				|-- Compile-time Bounds-checked Access (desugared from subscript syntax)
				|-- ============================================================================
				|---
				|Compile-time bounds-checked single-index access (dimensional peeling).
				|Desugared from x[i]. On 1D returns element, on N-D returns (N-1)-D slice.
				|---
				|pure func checked_get(arr: T[#_], index: Int) -> T:
				|	builtin("std/tensor.checked_get")
				|
				|
				|---
				|Compile-time bounds-checked single-index peel on N-D tensors.
				|Compiler-emitted helper for subscript desugaring when [x[i]] returns a sub-tensor.
				|---
				|pure func tensor_peel[T](arr: T, index: Int) -> T:
				|	builtin("blorp_tensor_peel")
				|
				|
				|---
				|Compile-time bounds-checked 1D element write (COW).
				|Desugared from x[i] = val. Returns the (possibly COW-copied) tensor.
				|---
				|pure func checked_set(arr: T[#N], index: ..#N, val: T) -> T[#N]:
				|	builtin("std/tensor.checked_set")
				|
				|
				|---
				|Compile-time bounds-checked 1D range slice.
				|Desugared from x[s..e].
				|---
				|pure func checked_slice[T, #N](arr: T[#N], start: Int, end_idx: Int) -> T[#_]:
				|	builtin("std/tensor.checked_slice")
				|
				|
				|---
				|Compile-time bounds-checked 2D flat element access.
				|Desugared from m[i, j]. Returns the element directly via flat index.
				|---
				|pure func matrix_checked_get[T, #M, #N](arr: T[#M, #N], row: Int, col: Int) -> T:
				|	builtin("std/tensor.matrix_checked_get")
				|
				|
				|---
				|Compile-time bounds-checked 2D flat element write (COW).
				|Desugared from m[i, j] = val.
				|---
				|pure func matrix_checked_set[T, #M, #N](
				|	arr: T[#M, #N],
				|	row: Int,
				|	col: Int,
				|	val: T,
				|) -> T[#M, #N]:
				|	builtin("std/tensor.matrix_checked_set")
				|
				|
				|---
				|Compile-time bounds-checked 3D flat element access.
				|---
				|pure func tensor3_checked_get[T, #A, #B, #C](
				|	arr: T[#A, #B, #C],
				|	i: Int,
				|	j: Int,
				|	k: Int,
				|) -> T:
				|	builtin("std/tensor.tensor3_checked_get")
				|
				|
				|---
				|Compile-time bounds-checked 3D flat element write (COW).
				|---
				|pure func tensor3_checked_set[T, #A, #B, #C](
				|	arr: T[#A, #B, #C],
				|	i: Int,
				|	j: Int,
				|	k: Int,
				|	val: T,
				|) -> T[#A, #B, #C]:
				|	builtin("std/tensor.tensor3_checked_set")
				|
				|
				|---
				|Compile-time bounds-checked 4D flat element access.
				|---
				|pure func tensor4_checked_get[T, #A, #B, #C, #D](
				|	arr: T[#A, #B, #C, #D],
				|	i: Int,
				|	j: Int,
				|	k: Int,
				|	l: Int,
				|) -> T:
				|	builtin("std/tensor.tensor4_checked_get")
				|
				|
				|---
				|Compile-time bounds-checked 4D flat element write (COW).
				|---
				|pure func tensor4_checked_set[T, #A, #B, #C, #D](
				|	arr: T[#A, #B, #C, #D],
				|	i: Int,
				|	j: Int,
				|	k: Int,
				|	l: Int,
				|	val: T,
				|) -> T[#A, #B, #C, #D]:
				|	builtin("std/tensor.tensor4_checked_set")
				|
				|
				|---
				|Compile-time bounds-checked 5D flat element access.
				|---
				|pure func tensor5_checked_get[T, #A, #B, #C, #D, #E](
				|	arr: T[#A, #B, #C, #D, #E],
				|	i: Int,
				|	j: Int,
				|	k: Int,
				|	l: Int,
				|	m: Int,
				|) -> T:
				|	builtin("std/tensor.tensor5_checked_get")
				|
				|
				|---
				|Compile-time bounds-checked 5D flat element write (COW).
				|---
				|pure func tensor5_checked_set[T, #A, #B, #C, #D, #E](
				|	arr: T[#A, #B, #C, #D, #E],
				|	i: Int,
				|	j: Int,
				|	k: Int,
				|	l: Int,
				|	m: Int,
				|	val: T,
				|) -> T[#A, #B, #C, #D, #E]:
				|	builtin("std/tensor.tensor5_checked_set")
				|
				|
				|---
				|Create a 1D vector filled with a value.
				|
				|doctests:
				|    :: Vector of zeros
				|    v: Int[#3] = vector(0, 3)
				|    v.length() == 3
				|---
				|pure func vector(value: T, size: #N) -> T[#N]:
				|	builtin("std/tensor.vector")
				|
				|
				|---
				|Create a 2D matrix filled with a value.
				|
				|doctests:
				|    :: 2x3 matrix has 2 rows
				|    m: Int[#2, #3] = matrix(0, 2, 3)
				|    m.length() == 2
				|---
				|pure func matrix[T, #N, #M](value: T, rows: #N, cols: #M) -> T[#N, #M]:
				|	builtin("std/tensor.matrix")
				|
				|
				|---
				|Create a 3D tensor filled with a value.
				|
				|doctests:
				|    :: 2x3x4 tensor has 2 slices
				|    t: Int[#2, #3, #4] = tensor3(0, 2, 3, 4)
				|    t.length() == 2
				|---
				|pure func tensor3[T, #X, #Y, #Z](value: T, x: #X, y: #Y, z: #Z) -> T[#X, #Y, #Z]:
				|	builtin("std/tensor.tensor3")
				|
				|
				|---
				|Create a 4D tensor filled with a value.
				|---
				|pure func tensor4[T, #A, #B, #C, #D](value: T, d1: #A, d2: #B, d3: #C, d4: #D) -> T[#A, #B, #C, #D]:
				|	builtin("std/tensor.tensor4")
				|
				|
				|---
				|Create a 5D tensor filled with a value.
				|---
				|pure func tensor5[T, #A, #B, #C, #D, #E](
				|	value: T,
				|	d1: #A,
				|	d2: #B,
				|	d3: #C,
				|	d4: #D,
				|	d5: #E,
				|) -> T[#A, #B, #C, #D, #E]:
				|	builtin("std/tensor.tensor5")
				|
				|
				|---
				|Set all elements to a value. Returns a new tensor (COW).
				|
				|Signature is 1D (`T[#N]`) because the body writes a scalar at
				|each index — the multi-dim form `arr[i] = val` would peel to a row and
				|reject the scalar. For variadic-dim fills, callers should write the
				|loop explicitly with `blorp_tensor_fill`-style runtime primitives.
				|
				|doctests:
				|    :: Set all to zero
				|    v: Int[#3] = {1, 2, 3}
				|    set_all(v, 0) == {0, 0, 0}
				|---
				|pure func set_all[T, #N](arr: T[#N], val: T) -> T[#N]:
				|	var result = arr
				|
				|	for i in 0..result.length():
				|		result[i] = val
				|
				|	result
				|
				|
				|---
				|Check if the tensor is empty.
				|---
				|pure func is_empty[T](arr: T[#_...]) -> Bool:
				|	arr.length() == 0
				|
			Some(source)
		"std/terminal":
			source: String = raw
				|-- Terminal — Terminal formatting (ANSI colors, styles, tables)
				|--
				|-- Pure functions for building ANSI-colored strings.
				|-- All functions return decorated strings — they don't print directly.
				|--
				|-- Typical use: import the formatting functions you need from `terminal`.
				|-- print(bold("Title") + ": " + green("OK"))
				|import:
				|	string: string
				|
				|
				|-- ============================================================================
				|-- ANSI Escape Codes
				|-- ============================================================================
				|private ANSI_ESCAPE_PREFIX: String = "\u{1B}["
				|
				|private ANSI_SGR_SUFFIX: String = "m"
				|
				|private ANSI_PARAM_SEPARATOR: String = ";"
				|
				|private ANSI_RESET_INTENSITY: String = "22"
				|
				|private ANSI_RESET_ITALIC: String = "23"
				|
				|private ANSI_RESET_UNDERLINE: String = "24"
				|
				|private ANSI_RESET_STRIKETHROUGH: String = "29"
				|
				|private ANSI_RESET_FOREGROUND: String = "39"
				|
				|private ANSI_RESET_BACKGROUND: String = "49"
				|
				|private ANSI_STYLE_BOLD: String = "1"
				|
				|private ANSI_STYLE_DIM: String = "2"
				|
				|private ANSI_STYLE_ITALIC: String = "3"
				|
				|private ANSI_STYLE_UNDERLINE: String = "4"
				|
				|private ANSI_STYLE_STRIKETHROUGH: String = "9"
				|
				|private ANSI_FOREGROUND_RED: String = "31"
				|
				|private ANSI_FOREGROUND_GREEN: String = "32"
				|
				|private ANSI_FOREGROUND_YELLOW: String = "33"
				|
				|private ANSI_FOREGROUND_BLUE: String = "34"
				|
				|private ANSI_FOREGROUND_MAGENTA: String = "35"
				|
				|private ANSI_FOREGROUND_CYAN: String = "36"
				|
				|private ANSI_FOREGROUND_WHITE: String = "37"
				|
				|private ANSI_FOREGROUND_GRAY: String = "90"
				|
				|private ANSI_FOREGROUND_BRIGHT_RED: String = "91"
				|
				|private ANSI_FOREGROUND_BRIGHT_GREEN: String = "92"
				|
				|private ANSI_FOREGROUND_BRIGHT_YELLOW: String = "93"
				|
				|private ANSI_FOREGROUND_BRIGHT_BLUE: String = "94"
				|
				|private ANSI_FOREGROUND_BRIGHT_MAGENTA: String = "95"
				|
				|private ANSI_FOREGROUND_BRIGHT_CYAN: String = "96"
				|
				|private ANSI_BACKGROUND_RED: String = "41"
				|
				|private ANSI_BACKGROUND_GREEN: String = "42"
				|
				|private ANSI_BACKGROUND_YELLOW: String = "43"
				|
				|private ANSI_BACKGROUND_BLUE: String = "44"
				|
				|private ANSI_BACKGROUND_MAGENTA: String = "45"
				|
				|private ANSI_BACKGROUND_CYAN: String = "46"
				|
				|private ANSI_BACKGROUND_WHITE: String = "47"
				|
				|private ANSI_FOREGROUND_256_PREFIX: String = "38;5;"
				|
				|private ANSI_BACKGROUND_256_PREFIX: String = "48;5;"
				|
				|private ANSI_FOREGROUND_RGB_PREFIX: String = "38;2;"
				|
				|private ANSI_BACKGROUND_RGB_PREFIX: String = "48;2;"
				|
				|private ANSI_COLOR_COMPONENT_MIN: Int = 0
				|
				|private ANSI_COLOR_COMPONENT_MAX: Int = 255
				|
				|
				|private pure func esc(code: String) -> String:
				|	ANSI_ESCAPE_PREFIX + code + ANSI_SGR_SUFFIX
				|
				|
				|private pure func ansi_wrap(code: String, s: String, reset: String) -> String:
				|	esc(code) + s + esc(reset)
				|
				|
				|private pure func ansi_color_component(n: Int) -> Int:
				|	if n < ANSI_COLOR_COMPONENT_MIN:
				|		ANSI_COLOR_COMPONENT_MIN
				|	else if n > ANSI_COLOR_COMPONENT_MAX:
				|		ANSI_COLOR_COMPONENT_MAX
				|	else:
				|		n
				|
				|
				|-- ============================================================================
				|-- Styles
				|-- ============================================================================
				|---
				|Make text bold.
				|
				|doctests:
				|    :: Bold wraps with codes
				|    bold("hi").length() > 2
				|---
				|pure func bold(s: String) -> String:
				|	ansi_wrap(ANSI_STYLE_BOLD, s, ANSI_RESET_INTENSITY)
				|
				|
				|---
				|Make text dim.
				|---
				|pure func dim(s: String) -> String:
				|	ansi_wrap(ANSI_STYLE_DIM, s, ANSI_RESET_INTENSITY)
				|
				|
				|---
				|Make text italic.
				|---
				|pure func italic(s: String) -> String:
				|	ansi_wrap(ANSI_STYLE_ITALIC, s, ANSI_RESET_ITALIC)
				|
				|
				|---
				|Make text underlined.
				|---
				|pure func underline(s: String) -> String:
				|	ansi_wrap(ANSI_STYLE_UNDERLINE, s, ANSI_RESET_UNDERLINE)
				|
				|
				|---
				|Make text strikethrough.
				|---
				|pure func strikethrough(s: String) -> String:
				|	ansi_wrap(ANSI_STYLE_STRIKETHROUGH, s, ANSI_RESET_STRIKETHROUGH)
				|
				|
				|-- ============================================================================
				|-- Foreground Colors
				|-- ============================================================================
				|---
				|Color text red.
				|
				|doctests:
				|    :: Red wraps with codes
				|    red("hi").length() > 2
				|---
				|pure func red(s: String) -> String:
				|	ansi_wrap(ANSI_FOREGROUND_RED, s, ANSI_RESET_FOREGROUND)
				|
				|
				|---
				|Color text green.
				|---
				|pure func green(s: String) -> String:
				|	ansi_wrap(ANSI_FOREGROUND_GREEN, s, ANSI_RESET_FOREGROUND)
				|
				|
				|---
				|Color text yellow.
				|---
				|pure func yellow(s: String) -> String:
				|	ansi_wrap(ANSI_FOREGROUND_YELLOW, s, ANSI_RESET_FOREGROUND)
				|
				|
				|---
				|Color text blue.
				|---
				|pure func blue(s: String) -> String:
				|	ansi_wrap(ANSI_FOREGROUND_BLUE, s, ANSI_RESET_FOREGROUND)
				|
				|
				|---
				|Color text magenta.
				|---
				|pure func magenta(s: String) -> String:
				|	ansi_wrap(ANSI_FOREGROUND_MAGENTA, s, ANSI_RESET_FOREGROUND)
				|
				|
				|---
				|Color text cyan.
				|---
				|pure func cyan(s: String) -> String:
				|	ansi_wrap(ANSI_FOREGROUND_CYAN, s, ANSI_RESET_FOREGROUND)
				|
				|
				|---
				|Color text white.
				|---
				|pure func white(s: String) -> String:
				|	ansi_wrap(ANSI_FOREGROUND_WHITE, s, ANSI_RESET_FOREGROUND)
				|
				|
				|---
				|Color text gray (bright black).
				|---
				|pure func gray(s: String) -> String:
				|	ansi_wrap(ANSI_FOREGROUND_GRAY, s, ANSI_RESET_FOREGROUND)
				|
				|
				|-- ============================================================================
				|-- Bright Foreground Colors
				|-- ============================================================================
				|pure func bright_red(s: String) -> String:
				|	ansi_wrap(ANSI_FOREGROUND_BRIGHT_RED, s, ANSI_RESET_FOREGROUND)
				|
				|
				|pure func bright_green(s: String) -> String:
				|	ansi_wrap(ANSI_FOREGROUND_BRIGHT_GREEN, s, ANSI_RESET_FOREGROUND)
				|
				|
				|pure func bright_yellow(s: String) -> String:
				|	ansi_wrap(ANSI_FOREGROUND_BRIGHT_YELLOW, s, ANSI_RESET_FOREGROUND)
				|
				|
				|pure func bright_blue(s: String) -> String:
				|	ansi_wrap(ANSI_FOREGROUND_BRIGHT_BLUE, s, ANSI_RESET_FOREGROUND)
				|
				|
				|pure func bright_magenta(s: String) -> String:
				|	ansi_wrap(ANSI_FOREGROUND_BRIGHT_MAGENTA, s, ANSI_RESET_FOREGROUND)
				|
				|
				|pure func bright_cyan(s: String) -> String:
				|	ansi_wrap(ANSI_FOREGROUND_BRIGHT_CYAN, s, ANSI_RESET_FOREGROUND)
				|
				|
				|-- ============================================================================
				|-- Background Colors
				|-- ============================================================================
				|pure func bg_red(s: String) -> String:
				|	ansi_wrap(ANSI_BACKGROUND_RED, s, ANSI_RESET_BACKGROUND)
				|
				|
				|pure func bg_green(s: String) -> String:
				|	ansi_wrap(ANSI_BACKGROUND_GREEN, s, ANSI_RESET_BACKGROUND)
				|
				|
				|pure func bg_yellow(s: String) -> String:
				|	ansi_wrap(ANSI_BACKGROUND_YELLOW, s, ANSI_RESET_BACKGROUND)
				|
				|
				|pure func bg_blue(s: String) -> String:
				|	ansi_wrap(ANSI_BACKGROUND_BLUE, s, ANSI_RESET_BACKGROUND)
				|
				|
				|pure func bg_magenta(s: String) -> String:
				|	ansi_wrap(ANSI_BACKGROUND_MAGENTA, s, ANSI_RESET_BACKGROUND)
				|
				|
				|pure func bg_cyan(s: String) -> String:
				|	ansi_wrap(ANSI_BACKGROUND_CYAN, s, ANSI_RESET_BACKGROUND)
				|
				|
				|pure func bg_white(s: String) -> String:
				|	ansi_wrap(ANSI_BACKGROUND_WHITE, s, ANSI_RESET_BACKGROUND)
				|
				|
				|-- ============================================================================
				|-- 256-Color and RGB
				|-- ============================================================================
				|---
				|Color text with a 256-color palette index. Values outside 0-255 are clamped.
				|---
				|pure func color256(s: String, n: Int) -> String:
				|	index: Int = ansi_color_component(n)
				|	esc(ANSI_FOREGROUND_256_PREFIX + index.to_string()) + s + esc(ANSI_RESET_FOREGROUND)
				|
				|
				|---
				|Color background with a 256-color palette index. Values outside 0-255 are clamped.
				|---
				|pure func bg_color256(s: String, n: Int) -> String:
				|	index: Int = ansi_color_component(n)
				|	esc(ANSI_BACKGROUND_256_PREFIX + index.to_string()) + s + esc(ANSI_RESET_BACKGROUND)
				|
				|
				|---
				|Color text with an RGB value. Each channel is clamped to 0-255.
				|---
				|pure func rgb(s: String, r: Int, g: Int, b: Int) -> String:
				|	rr: Int = ansi_color_component(r)
				|	gg: Int = ansi_color_component(g)
				|	bb: Int = ansi_color_component(b)
				|	esc(
				|		ANSI_FOREGROUND_RGB_PREFIX + rr.to_string() + ANSI_PARAM_SEPARATOR + gg.to_string() + ANSI_PARAM_SEPARATOR + bb.to_string(),
				|	) + s + esc(ANSI_RESET_FOREGROUND)
				|
				|
				|---
				|Color background with an RGB value. Each channel is clamped to 0-255.
				|---
				|pure func bg_rgb(s: String, r: Int, g: Int, b: Int) -> String:
				|	rr: Int = ansi_color_component(r)
				|	gg: Int = ansi_color_component(g)
				|	bb: Int = ansi_color_component(b)
				|	esc(
				|		ANSI_BACKGROUND_RGB_PREFIX + rr.to_string() + ANSI_PARAM_SEPARATOR + gg.to_string() + ANSI_PARAM_SEPARATOR + bb.to_string(),
				|	) + s + esc(ANSI_RESET_BACKGROUND)
				|
				|
				|-- ============================================================================
				|-- Reset
				|-- ============================================================================
				|-- Strip all ANSI formatting.
				|RESET: String = "\u{1B}[0m"
				|
				|
				|-- ============================================================================
				|-- Composition Helpers
				|-- ============================================================================
				|---
				|Apply multiple styles to a string. Innermost style wins for conflicts.
				|
				|doctests:
				|    :: Compose bold and red
				|    s: String = bold(red("error"))
				|    s.length() > 5
				|---
				|pure func styled(
				|	s: String,
				|	styles: List[pure (String) -> String],
				|) -> String:
				|	var result: String = s
				|	var i: Int = styles.length() - 1
				|
				|	while i >= 0:
				|		match styles.get(i):
				|			Some(f):
				|				result = f(result)
				|			None:
				|				void
				|
				|		i -= 1
				|
				|	result
				|
				|
				|-- ============================================================================
				|-- Table Formatting
				|-- ============================================================================
				|---
				|Format a simple text table with headers and rows.
				|Columns are auto-sized to fit content.
				|
				|doctests:
				|    :: Table has header
				|    t: String = table(
				|        ["Name", "Age"],
				|        [["Alice", "30"], ["Bob", "25"]],
				|    )
				|    t.length() > 10
				|---
				|pure func table(headers: List[String], rows: List[List[String]]) -> String:
				|	-- Compute column widths
				|	num_cols: Int = headers.length()
				|	var widths: List[Int] = []
				|	var c: Int = 0
				|
				|	while c < num_cols:
				|		var w: Int = match headers.get(c):
				|			Some(h):
				|				h.length()
				|			None:
				|				0
				|
				|		var r: Int = 0
				|
				|		while r < rows.length():
				|			match rows.get(r):
				|				Some(row):
				|					match row.get(c):
				|						Some(cell):
				|							cell_len: Int = cell.length()
				|
				|							if cell_len > w:
				|								w = cell_len
				|						None:
				|							void
				|				None:
				|					void
				|
				|			r += 1
				|
				|		widths = widths.append(w)
				|		c += 1
				|
				|	-- Build table
				|	var buf: String = string(256)
				|
				|	-- Header
				|	buf += format_row(headers, widths)
				|	buf = buf.append_char('\n')
				|
				|	-- Separator
				|	buf += format_separator(widths)
				|	buf = buf.append_char('\n')
				|
				|	-- Rows
				|	var r: Int = 0
				|
				|	while r < rows.length():
				|		match rows.get(r):
				|			Some(row):
				|				buf += format_row(row, widths)
				|
				|				if r < rows.length() - 1:
				|					buf = buf.append_char('\n')
				|			None:
				|				void
				|
				|		r += 1
				|
				|	buf
				|
				|
				|private pure func format_row(cells: List[String], widths: List[Int]) -> String:
				|	var buf: String = string(64)
				|	var c: Int = 0
				|
				|	while c < widths.length():
				|		if c > 0:
				|			buf += "  "
				|
				|		cell: String = cells
				|			.get(c)
				|			.get_or("")
				|		w: Int = widths
				|			.get(c)
				|			.get_or(0)
				|		buf += cell.pad_right(w)
				|		c += 1
				|
				|	buf
				|
				|
				|private pure func format_separator(widths: List[Int]) -> String:
				|	var buf: String = string(64)
				|	var c: Int = 0
				|
				|	while c < widths.length():
				|		if c > 0:
				|			buf += "  "
				|
				|		w: Int = widths
				|			.get(c)
				|			.get_or(0)
				|		var i: Int = 0
				|
				|		while i < w:
				|			buf = buf.append_char('-')
				|			i += 1
				|
				|		c += 1
				|
				|	buf
				|
				|
				|---
				|Pad a string on the right with spaces to reach the target width.
				|---
				|pure func pad_right(s: String, width: Int) -> String:
				|	padding: Int = width - s.length()
				|
				|	if padding <= 0:
				|		s
				|	else:
				|		var buf: String = string(width)
				|		buf += s
				|		var i: Int = 0
				|
				|		while i < padding:
				|			buf = buf.append_char(' ')
				|			i += 1
				|
				|		buf
				|
				|
				|---
				|Pad a string on the left with spaces to reach the target width.
				|---
				|pure func pad_left(s: String, width: Int) -> String:
				|	padding: Int = width - s.length()
				|
				|	if padding <= 0:
				|		s
				|	else:
				|		var buf: String = string(width)
				|		var i: Int = 0
				|
				|		while i < padding:
				|			buf = buf.append_char(' ')
				|			i += 1
				|
				|		buf += s
				|		buf
				|
				|
				|-- ============================================================================
				|-- Progress Bar
				|-- ============================================================================
				|---
				|Render a progress bar string.
				|`current` is the current progress, `total` is the maximum.
				|`width` is the bar width in characters.
				|
				|doctests:
				|    :: Half progress
				|    bar: String = progress_bar(50, 100, 20)
				|    bar.length() > 0
				|---
				|pure func progress_bar(current: Int, total: Int, width: Int) -> String:
				|	fraction: Float = if total == 0:
				|		0.0
				|	else:
				|		to_float(current) / to_float(total)
				|
				|	filled: Int = to_int(fraction * to_float(width))
				|	var buf: String = string(width + 20)
				|	buf = buf.append_char('[')
				|	var i: Int = 0
				|
				|	while i < width:
				|		if i < filled:
				|			buf = buf.append_char('#')
				|		else:
				|			buf = buf.append_char('-')
				|
				|		i += 1
				|
				|	buf += "] "
				|	pct: Int = to_int(fraction * 100.0)
				|	buf += pct.to_string()
				|	buf.append_char('%')
				|
			Some(source)
		"std/test":
			source: String = raw
				|-- Test - Testing framework for blorp programs
				|--
				|-- Provides a simple test suite structure for writing and running tests.
				|--
				|-- Usage: import `test: TestSuite` in an import block.
				|--
				|-- func test_something() -> Bool:
				|-- actual == expected
				|--
				|-- tests: TestSuite = {
				|-- description = "My Tests",
				|-- tests = [("test name", test_something)]
				|-- }
				|--
				|-- Run with: ./blorp test path/to/test.brp
				|--
				|-- The test runner automatically detects the `tests` binding and runs it.
				|import:
				|	memory: MemStats, get_mem_stats, print_live_object_summary, reset_mem_stats
				|
				|
				|-- TestSuite record type for structured testing
				|record TestSuite {
				|	description: String,
				|	tests: List[(String, () -> Bool)]
				|}
				|
				|
				|---
				|Test-only cancellation hook.
				|
				|Runs `task` in a child task, waits until the child is observed parked at a
				|runtime cancellation point, then cancels and joins it. Returns False if the
				|child completed or could not be observed parked before the bounded probe ended.
				|
				|Use this only for deterministic runtime hardening tests that need to avoid
				|wall-clock timeout races.
				|---
				|func cancel_after_parked_for_test(task: () -> Int) -> Bool:
				|	builtin("blorp_test_cancel_after_parked")
				|
				|
				|---
				|Test-only task-window cleanup probe.
				|
				|Checks that runtime task-window cleanup flushes pending batched child tasks and
				|owns any still-live task slots before freeing its paired storage. Use this only
				|for deterministic scheduler runtime hardening tests.
				|---
				|func task_window_pending_cleanup_probe_for_test() -> Bool:
				|	builtin("blorp_test_task_window_pending_cleanup_probe")
				|
				|
				|---
				|Test-only task join slot probe.
				|
				|Checks that the runtime task join slot can replace a stale waiter and clears
				|the slot through the shared remove helper. Use this only for deterministic
				|scheduler runtime hardening tests.
				|---
				|func task_join_slot_probe_for_test() -> Bool:
				|	builtin("blorp_test_task_join_slot_probe")
				|
				|
				|---
				|Test-only scheduler creation probe.
				|
				|Checks that newly-created fibers start unparked and move to queued through the
				|created-fiber scheduling path, not through the parked wake path. Use this only
				|for deterministic scheduler runtime hardening tests.
				|---
				|func fiber_created_schedule_probe_for_test() -> Bool:
				|	builtin("blorp_test_fiber_created_schedule_probe")
				|
				|
				|---
				|Test-only scheduler timer probe.
				|
				|Checks that runtime timer waiters are tied to an exact wait operation, so a
				|stale deadline cannot wake a later wait on the same fiber. Use this only for
				|deterministic runtime hardening tests.
				|---
				|func timer_waiter_identity_probe_for_test() -> Bool:
				|	builtin("blorp_test_timer_waiter_identity_probe")
				|
				|
				|---
				|Test-only scheduler wait-owner probe.
				|
				|Checks that a runtime wait operation has a concrete owner and operation id
				|before it is marked ready to park, and that the ready-to-park transition
				|preserves that identity. Use this only for deterministic runtime hardening
				|tests.
				|---
				|func wait_ready_to_park_probe_for_test() -> Bool:
				|	builtin("blorp_test_wait_ready_to_park_probe")
				|
				|
				|---
				|Test-only scheduler lifecycle probe.
				|
				|Checks that the runtime represents the ready-to-park state explicitly between
				|running and parked, including the wake-before-yield handoff that records a
				|pending wake before the fiber has actually yielded. Use this only for
				|deterministic scheduler runtime hardening tests.
				|---
				|func fiber_lifecycle_ready_to_park_probe_for_test() -> Bool:
				|	builtin("blorp_test_fiber_lifecycle_ready_to_park_probe")
				|
				|
				|---
				|Test-only scheduler cancellation-before-park probe.
				|
				|Checks that cancellation delivered after a running fiber checks cancellation but
				|before it marks itself parked records a pending wake. Use this only for
				|deterministic scheduler runtime hardening tests.
				|---
				|func fiber_cancel_before_park_probe_for_test() -> Bool:
				|	builtin("blorp_test_fiber_cancel_before_park_probe")
				|
				|
				|---
				|Test-only scheduler timer-install probe.
				|
				|Checks that a current fiber wait can install and remove its timer deadline
				|through the shared runtime helper without losing the wait operation identity.
				|Use this only for deterministic runtime hardening tests.
				|---
				|func current_timer_wait_install_probe_for_test() -> Bool:
				|	builtin("blorp_test_current_timer_wait_install_probe")
				|
				|
				|---
				|Test-only runtime timeout arithmetic probe.
				|
				|Checks that runtime timeout conversion, polling, and deadline helpers round and
				|saturate instead of spinning or overflowing. Use this only for deterministic
				|runtime hardening tests.
				|---
				|func timeout_arithmetic_probe_for_test() -> Bool:
				|	builtin("blorp_test_timeout_arithmetic_probe")
				|
				|
				|---
				|Test-only cooperative checkpoint probe.
				|
				|Runs the compiler-owned cooperative checkpoint helper and verifies that an
				|expired reduction budget yields from a fiber. Use this only for scheduler
				|runtime hardening tests; normal Blorp programs should use `yield_now()` for an
				|explicit source-level handoff.
				|---
				|func cooperative_checkpoint_probe_for_test() -> Bool:
				|	builtin("blorp_test_cooperative_checkpoint_probe")
				|
				|
				|---
				|Test-only TLS runtime state probe.
				|
				|Exercises internal TLS session states without exposing a fake `TlsSession`
				|resource to user programs. Use this only for deterministic runtime hardening
				|tests around the portable TLS backend boundary.
				|---
				|func tls_state_probe_for_test() -> Bool:
				|	builtin("blorp_test_tls_state_probe")
				|
				|
				|---
				|Test-only WebSocket runtime state probe.
				|
				|Exercises internal WebSocket session states without exposing a fake
				|`WebSocketSession` resource to user programs. Use this only for deterministic
				|runtime hardening tests around the portable WebSocket backend boundary.
				|---
				|func websocket_state_probe_for_test() -> Bool:
				|	builtin("blorp_test_websocket_state_probe")
				|
				|
				|---
				|Test-only process spawn ownership probe.
				|
				|Forces the portable non-atomic pipe fallback and verifies descriptor cleanup,
				|failed-spawn cleanup, live-child termination/reaping, and idempotent child
				|disposal. Use this only for deterministic process-runtime hardening tests.
				|---
				|func process_spawn_fallback_probe_for_test() -> Bool:
				|	builtin("blorp_test_process_spawn_fallback_probe")
				|
				|
				|---
				|Assert a value is True. Prints a message on failure.
				|
				|doctests:
				|    :: True passes
				|    assert_true(True) == True
				|---
				|func assert_true(value: Bool) -> Bool:
				|	if value:
				|		True
				|	else:
				|		print("  assert_true failed: got False")
				|		False
				|
				|
				|---
				|Assert two floats are approximately equal within epsilon.
				|
				|doctests:
				|    :: Close values pass
				|    assert_approx(1.0, 1.0000001, 0.001) == True
				|---
				|func assert_approx(actual: Float, expected: Float, epsilon: Float) -> Bool:
				|	diff: Float = actual - expected
				|	var abs_diff: Float = diff
				|
				|	if abs_diff < 0.0:
				|		abs_diff = -abs_diff
				|
				|	if abs_diff <= epsilon:
				|		True
				|	else:
				|		print(
				|			"  assert_approx failed: expected " + to_string(
				|				expected,
				|			) + " +/- " + epsilon.to_string() + ", got " + actual.to_string(),
				|		)
				|		False
				|
				|
				|---
				|Assert two values are equal. Prints expected vs actual on failure.
				|---
				|func assert_eq[T:Equatable+Stringable](actual: T, expected: T) -> Bool:
				|	if actual == expected:
				|		True
				|	else:
				|		print(
				|			"  assert_eq failed: expected " + expected.to_string() + ", got " + actual.to_string(),
				|		)
				|		False
				|
				|
				|---
				|Assert a value is False. Prints a message on failure.
				|---
				|func assert_false(value: Bool) -> Bool:
				|	if not value:
				|		True
				|	else:
				|		print("  assert_false failed: got True")
				|		False
				|
				|
				|---
				|Assert an Option is Some. Prints on failure.
				|---
				|func assert_some[T](value: Option[T]) -> Bool:
				|	match value:
				|		Some(_):
				|			True
				|		None:
				|			print("  assert_some failed: got None")
				|			False
				|
				|
				|---
				|Assert an Option is None. Prints on failure.
				|---
				|func assert_none[T](value: Option[T]) -> Bool:
				|	match value:
				|		None:
				|			True
				|		Some(_):
				|			print("  assert_none failed: got Some")
				|			False
				|
				|
				|---
				|Assert a Result is Ok. Prints on failure.
				|---
				|func assert_ok[T, E:Stringable](value: Result[T, E]) -> Bool:
				|	match value:
				|		Ok(_):
				|			True
				|		Err(e):
				|			print("  assert_ok failed: got Err(" + e.to_string() + ")")
				|			False
				|
				|
				|---
				|Assert a Result is Err. Prints on failure.
				|---
				|func assert_err[T, E](value: Result[T, E]) -> Bool:
				|	match value:
				|		Err(_):
				|			True
				|		Ok(_):
				|			print("  assert_err failed: got Ok")
				|			False
				|
				|
				|-- Run all tests in a test suite
				|func run_suite(suite: TestSuite) -> Bool:
				|	print("")
				|	print(">> " + suite.description + " Tests")
				|	var test_count: Int = suite.tests.length()
				|	var passed: Int = 0
				|
				|	for test_pair in suite.tests:
				|		if test_pair[1]():
				|			print("  [PASS] " + test_pair[0])
				|			passed += 1
				|		else:
				|			print("  [FAIL] " + test_pair[0])
				|
				|	print("")
				|
				|	if passed == test_count:
				|		print("All " + test_count.to_string() + " tests passed")
				|		True
				|	else:
				|		print((test_count - passed).to_string() + " of " + test_count.to_string() + " tests failed")
				|		False
				|
				|
				|func run_suite_leak_check(suite: TestSuite) -> Bool:
				|	print("")
				|	print(">> " + suite.description + " Tests (leak-check)")
				|	var test_count: Int = suite.tests.length()
				|	var passed: Int = 0
				|	var leaked_tests: Int = 0
				|
				|	for test_pair in suite.tests:
				|		-- Reset stats before each test, run, then check
				|		reset_mem_stats()
				|		result: Bool = test_pair[1]()
				|		stats: MemStats = get_mem_stats()
				|		objects_after: Int = stats.current_objects
				|
				|		-- get_mem_stats() is untracked, so any live object after a test is signal.
				|		has_leak: Bool = objects_after > 0
				|
				|		if result:
				|			if has_leak:
				|				print(
				|					"  [FAIL] " + test_pair[0] + " [LEAK: " + to_string(
				|						objects_after,
				|					) + " objects]",
				|				)
				|				print_live_object_summary()
				|				leaked_tests += 1
				|			else:
				|				print("  [PASS] " + test_pair[0])
				|				passed += 1
				|		else if has_leak:
				|			print("  [FAIL] " + test_pair[0] + " [LEAK: " + objects_after.to_string() + " objects]")
				|			print_live_object_summary()
				|			leaked_tests += 1
				|		else:
				|			print("  [FAIL] " + test_pair[0])
				|
				|	print("")
				|
				|	if leaked_tests > 0:
				|		print("ERROR: " + leaked_tests.to_string() + " test(s) leaked memory")
				|
				|	suite_ok: Bool = passed == test_count and leaked_tests == 0
				|
				|	if suite_ok:
				|		print("All " + test_count.to_string() + " tests passed")
				|	else:
				|		print((test_count - passed).to_string() + " of " + test_count.to_string() + " tests failed")
				|
				|	reset_mem_stats()
				|	suite_ok
				|
			Some(source)
		"std/time":
			source: String = raw
				|import:
				|	string: length, repeat
				|	units:
				|		Duration,
				|		microseconds as make_duration_microseconds,
				|		to_microseconds as duration_microsecond_count,
				|
				|
				|-- Time - Date and time operations (POSIX-time-centric)
				|--
				|-- Time is represented as an Int (POSIX microseconds since epoch).
				|-- Pure functions extract calendar parts. Typed Instant wrappers are stack structs.
				|-- All extraction and formatting functions assume UTC.
				|-- ============================================================================
				|-- Types
				|-- ============================================================================
				|---
				|An exact instant represented as POSIX microseconds since the epoch.
				|This is a stack struct wrapper over the raw timestamp used by low-level
				|interop helpers.
				|---
				|struct Instant {
				|	microseconds_since_posix_epoch: Int
				|}
				|
				|
				|-- ============================================================================
				|-- Current Time (impure — non-deterministic)
				|-- ============================================================================
				|---
				|Get current wall-clock time in microseconds since POSIX epoch.
				|Impure: returns a different value each time it's called.
				|---
				|func now() -> Int:
				|	builtin("blorp_time_now")
				|
				|
				|---
				|Get current wall-clock time as a typed Instant.
				|Impure: returns a different value each time it's called.
				|---
				|func now_instant() -> Instant:
				|	instant_from_posix_microseconds(now())
				|
				|
				|-- ============================================================================
				|-- Calendar Part Extraction (all pure, all UTC)
				|-- ============================================================================
				|---
				|Extract year from POSIX microseconds (e.g. 2026).
				|---
				|pure func to_year(microseconds: Int) -> Int:
				|	builtin("blorp_time_to_year")
				|
				|
				|---
				|Extract month from POSIX microseconds (1-12).
				|---
				|pure func to_month(microseconds: Int) -> Int:
				|	builtin("blorp_time_to_month")
				|
				|
				|---
				|Extract day of month from POSIX microseconds (1-31).
				|---
				|pure func to_day(microseconds: Int) -> Int:
				|	builtin("blorp_time_to_day")
				|
				|
				|---
				|Extract hour from POSIX microseconds (0-23).
				|---
				|pure func to_hour(microseconds: Int) -> Int:
				|	builtin("blorp_time_to_hour")
				|
				|
				|---
				|Extract minute from POSIX microseconds (0-59).
				|---
				|pure func to_minute(microseconds: Int) -> Int:
				|	builtin("blorp_time_to_minute")
				|
				|
				|---
				|Extract second from POSIX microseconds (0-59).
				|---
				|pure func to_second(microseconds: Int) -> Int:
				|	builtin("blorp_time_to_second")
				|
				|
				|---
				|Extract day of week from POSIX microseconds (0=Sun, 1=Mon, ..., 6=Sat).
				|---
				|pure func to_weekday(microseconds: Int) -> Int:
				|	builtin("blorp_time_to_weekday")
				|
				|
				|-- ============================================================================
				|-- Construction and Conversion
				|-- ============================================================================
				|---
				|Construct POSIX microseconds from calendar parts (UTC).
				|Invalid fields are normalized by the underlying POSIX conversion; prefer
				|try_from_parts when invalid civil dates should remain explicit.
				|---
				|pure func from_parts(year: Int, month: Int, day: Int, hour: Int, minute: Int, second: Int) -> Int:
				|	builtin("blorp_time_from_parts")
				|
				|
				|---
				|Construct POSIX microseconds from UTC calendar parts, returning None when the
				|fields do not describe a valid Gregorian date-time.
				|---
				|pure func try_from_parts(
				|	year: Int,
				|	month: Int,
				|	day: Int,
				|	hour: Int,
				|	minute: Int,
				|	second: Int,
				|) -> Option[Int]:
				|	if is_valid_date_time(year, month, day, hour, minute, second):
				|		Some(from_parts(year, month, day, hour, minute, second))
				|	else:
				|		None
				|
				|
				|---
				|Format timestamp using strftime codes (e.g. "%Y-%m-%d %H:%M:%S").
				|
				|doctests:
				|    :: Format date
				|    t: Int = from_parts(2026, 1, 15, 10, 30, 0)
				|    format_time(t, "%Y-%m-%d") == "2026-01-15"
				|---
				|pure func format_time(microseconds: Int, fmt: String) -> String:
				|	builtin("blorp_time_format")
				|
				|
				|---
				|Parse date string using strptime codes.
				|Returns Some(microseconds) on success, None on failure. Numeric Gregorian
				|date/time fields are validated before accepting host C library normalization.
				|
				|doctests:
				|    :: Parse valid date
				|    match parse_time("2026-01-15", "%Y-%m-%d"):
				|        Some(_):
				|            True
				|        None:
				|            False
				|---
				|pure func parse_time(s: String, fmt: String) -> Option[Int]:
				|	builtin("blorp_time_parse")
				|
				|
				|-- ============================================================================
				|-- Duration Constants (microseconds)
				|-- ============================================================================
				|---
				|Convert seconds to microseconds.
				|
				|doctests:
				|    :: One second in microseconds
				|    seconds(1) == 1000000
				|---
				|pure func seconds(n: Int) -> Int:
				|	n * 1000000
				|
				|
				|---
				|Convert minutes to microseconds.
				|
				|doctests:
				|    :: One minute in microseconds
				|    minutes(1) == 60000000
				|---
				|pure func minutes(n: Int) -> Int:
				|	n * 60000000
				|
				|
				|---
				|Convert hours to microseconds.
				|
				|doctests:
				|    :: One hour in microseconds
				|    hours(1) == 3600000000
				|---
				|pure func hours(n: Int) -> Int:
				|	n * 3600000000
				|
				|
				|-- ============================================================================
				|-- Convenience Formatting
				|-- ============================================================================
				|---
				|Format as a whole-second RFC3339-compatible UTC string.
				|
				|doctests:
				|    :: Format UTC timestamp
				|    t: Int = from_parts(2026, 6, 15, 12, 0, 0)
				|    to_iso(t) == "2026-06-15T12:00:00Z"
				|---
				|pure func to_iso(microseconds: Int) -> String:
				|	format_time(microseconds, "%Y-%m-%dT%H:%M:%SZ")
				|
				|
				|-- ============================================================================
				|-- Duration Constructors (additional)
				|-- ============================================================================
				|---
				|Convert days to microseconds.
				|
				|doctests:
				|    :: One day
				|    days(1) == 86400000000
				|
				|    :: One week
				|    days(7) == 604800000000
				|---
				|pure func days(n: Int) -> Int:
				|	n * 86400000000
				|
				|
				|---
				|Convert weeks to microseconds.
				|
				|doctests:
				|    :: One week
				|    weeks(1) == days(7)
				|
				|    :: Two weeks
				|    weeks(2) == days(14)
				|---
				|pure func weeks(n: Int) -> Int:
				|	n * 604800000000
				|
				|
				|-- ============================================================================
				|-- Unix Timestamp Interop
				|-- ============================================================================
				|---
				|Convert POSIX microseconds to Unix seconds.
				|
				|doctests:
				|    :: Convert
				|    to_unix_seconds(1000000) == 1
				|---
				|pure func to_unix_seconds(microseconds: Int) -> Int:
				|	quotient: Int = microseconds / 1000000
				|
				|	if microseconds >= 0 or microseconds % 1000000 == 0:
				|		quotient
				|	else:
				|		quotient - 1
				|
				|
				|---
				|Convert Unix seconds to POSIX microseconds.
				|
				|doctests:
				|    :: Convert
				|    from_unix_seconds(1) == 1000000
				|---
				|pure func from_unix_seconds(s: Int) -> Int:
				|	s * 1000000
				|
				|
				|---
				|Convert POSIX microseconds to Unix milliseconds.
				|
				|doctests:
				|    :: Convert
				|    to_unix_millis(1000000) == 1000
				|---
				|pure func to_unix_millis(microseconds: Int) -> Int:
				|	quotient: Int = microseconds / 1000
				|
				|	if microseconds >= 0 or microseconds % 1000 == 0:
				|		quotient
				|	else:
				|		quotient - 1
				|
				|
				|---
				|Convert Unix milliseconds to POSIX microseconds.
				|
				|doctests:
				|    :: Convert
				|    from_unix_millis(1000) == 1000000
				|---
				|pure func from_unix_millis(ms: Int) -> Int:
				|	ms * 1000
				|
				|
				|-- ============================================================================
				|-- ISO / RFC3339 Parsing
				|-- ============================================================================
				|---
				|Parse an ISO calendar date or RFC3339 date-time to POSIX microseconds.
				|Handles: "2024-01-15T10:30:00Z", "2024-01-15T10:30:00+05:30",
				|"2024-01-15T10:30:00.123Z", "2024-01-15" (date-only, midnight UTC).
				|Returns None on invalid input.
				|
				|doctests:
				|    :: Basic UTC
				|    match from_iso("2026-06-15T12:00:00Z"):
				|        Some(t):
				|            to_iso(t) == "2026-06-15T12:00:00Z"
				|        None:
				|            False
				|
				|    :: Date only
				|    match from_iso("2026-06-15"):
				|        Some(t):
				|            to_year(t) == 2026 and to_month(t) == 6 and to_day(t) == 15
				|        None:
				|            False
				|
				|    :: Invalid
				|    match from_iso("not-a-date"):
				|        Some(_):
				|            False
				|        None:
				|            True
				|---
				|pure func from_iso(s: String) -> Option[Int]:
				|	builtin("blorp_time_from_iso")
				|
				|
				|---
				|Parse a strict RFC3339 date-time into a typed Instant.
				|Date-only strings are rejected; use from_iso for the current date-only
				|compatibility helper.
				|---
				|pure func parse_rfc3339(s: String) -> Option[Instant]:
				|	match parse_rfc3339_posix(s):
				|		Some(microseconds):
				|			Some(instant_from_posix_microseconds(microseconds))
				|		None:
				|			None
				|
				|
				|private pure func parse_rfc3339_posix(s: String) -> Option[Int]:
				|	builtin("blorp_time_parse_rfc3339")
				|
				|
				|---
				|Format a typed Instant as a UTC RFC3339 string, preserving nonzero microseconds.
				|---
				|pure func format_rfc3339(instant: Instant) -> String:
				|	microseconds: Int = instant.microseconds_since_posix_epoch
				|	base: String = format_time(microseconds, "%Y-%m-%dT%H:%M:%S")
				|	fraction: Int = subsecond_microseconds(microseconds)
				|
				|	if fraction == 0:
				|		base + "Z"
				|	else:
				|		base + "." + pad_microseconds(fraction) + "Z"
				|
				|
				|private pure func subsecond_microseconds(microseconds: Int) -> Int:
				|	remainder: Int = microseconds % 1000000
				|
				|	if remainder < 0:
				|		remainder + 1000000
				|	else:
				|		remainder
				|
				|
				|private pure func pad_microseconds(value: Int) -> String:
				|	raw: String = value.to_string()
				|	"0".repeat(6 - raw.length()) + raw
				|
				|
				|-- ============================================================================
				|-- Typed Instant / Duration Interop
				|-- ============================================================================
				|---
				|Wrap raw POSIX microseconds in a typed Instant.
				|---
				|pure func instant_from_posix_microseconds(microseconds: Int) -> Instant:
				|	{microseconds_since_posix_epoch = microseconds}
				|
				|
				|---
				|Return raw POSIX microseconds from a typed Instant.
				|---
				|pure func instant_to_posix_microseconds(instant: Instant) -> Int:
				|	instant.microseconds_since_posix_epoch
				|
				|
				|---
				|Create a typed Instant from Unix seconds.
				|---
				|pure func instant_from_unix_seconds(seconds_value: Int) -> Instant:
				|	instant_from_posix_microseconds(from_unix_seconds(seconds_value))
				|
				|
				|---
				|Convert a typed Instant to Unix seconds using POSIX floor semantics.
				|---
				|pure func instant_to_unix_seconds(instant: Instant) -> Int:
				|	to_unix_seconds(instant.microseconds_since_posix_epoch)
				|
				|
				|---
				|Create a typed Duration from microseconds.
				|---
				|pure func duration_from_microseconds(microseconds: Int) -> Duration:
				|	make_duration_microseconds(microseconds)
				|
				|
				|---
				|Return raw microseconds from a typed Duration.
				|---
				|pure func duration_to_microseconds(duration: Duration) -> Int:
				|	duration_microsecond_count(duration)
				|
				|
				|---
				|Add an exact elapsed Duration to an Instant.
				|---
				|pure func add_duration(instant: Instant, duration: Duration) -> Instant:
				|	instant_from_posix_microseconds(
				|		instant.microseconds_since_posix_epoch + duration_microsecond_count(duration),
				|	)
				|
				|
				|---
				|Subtract an exact elapsed Duration from an Instant.
				|---
				|pure func subtract_duration(instant: Instant, duration: Duration) -> Instant:
				|	instant_from_posix_microseconds(
				|		instant.microseconds_since_posix_epoch - duration_microsecond_count(duration),
				|	)
				|
				|
				|---
				|Return a - b as an exact elapsed Duration.
				|---
				|pure func duration_between(a: Instant, b: Instant) -> Duration:
				|	make_duration_microseconds(a.microseconds_since_posix_epoch - b.microseconds_since_posix_epoch)
				|
				|
				|-- ============================================================================
				|-- Truncation Functions
				|-- ============================================================================
				|---
				|Truncate to start of day (midnight UTC).
				|
				|doctests:
				|    :: Truncate afternoon
				|    t: Int = from_parts(2026, 3, 15, 14, 30, 45)
				|    to_hour(start_of_day(t)) == 0 and to_minute(start_of_day(t)) == 0
				|---
				|pure func start_of_day(microseconds: Int) -> Int:
				|	from_parts(to_year(microseconds), to_month(microseconds), to_day(microseconds), 0, 0, 0)
				|
				|
				|---
				|Truncate to start of month (1st day, midnight UTC).
				|
				|doctests:
				|    :: Truncate mid-month
				|    t: Int = from_parts(2026, 7, 22, 14, 30, 0)
				|    to_day(start_of_month(t)) == 1 and to_hour(start_of_month(t)) == 0
				|---
				|pure func start_of_month(microseconds: Int) -> Int:
				|	from_parts(to_year(microseconds), to_month(microseconds), 1, 0, 0, 0)
				|
				|
				|---
				|Truncate to start of year (Jan 1, midnight UTC).
				|
				|doctests:
				|    :: Truncate mid-year
				|    t: Int = from_parts(2026, 11, 22, 14, 30, 0)
				|    to_month(start_of_year(t)) == 1 and to_day(start_of_year(t)) == 1
				|---
				|pure func start_of_year(microseconds: Int) -> Int:
				|	from_parts(to_year(microseconds), 1, 1, 0, 0, 0)
				|
				|
				|-- ============================================================================
				|-- Weekday Name
				|-- ============================================================================
				|---
				|Get the name of the day of the week.
				|
				|doctests:
				|    :: Known day
				|    weekday_name(from_parts(2024, 1, 8, 0, 0, 0)) == "Monday"
				|---
				|pure func weekday_name(microseconds: Int) -> String:
				|	wd: Int = to_weekday(microseconds)
				|
				|	match wd:
				|		0:
				|			"Sunday"
				|		1:
				|			"Monday"
				|		2:
				|			"Tuesday"
				|		3:
				|			"Wednesday"
				|		4:
				|			"Thursday"
				|		5:
				|			"Friday"
				|		_:
				|			"Saturday"
				|
				|
				|-- ============================================================================
				|-- Date Arithmetic
				|-- ============================================================================
				|---
				|Add n days to a timestamp.
				|
				|doctests:
				|    :: Add 1 day
				|    t: Int = from_parts(2024, 1, 1, 0, 0, 0)
				|    t2: Int = add_days(t, 1)
				|    to_day(t2) == 2
				|---
				|pure func add_days(microseconds: Int, n: Int) -> Int:
				|	microseconds + n * 86400000000
				|
				|
				|---
				|Add n hours to a timestamp.
				|---
				|pure func add_hours(microseconds: Int, n: Int) -> Int:
				|	microseconds + n * 3600000000
				|
				|
				|---
				|Add n minutes to a timestamp.
				|---
				|pure func add_minutes(microseconds: Int, n: Int) -> Int:
				|	microseconds + n * 60000000
				|
				|
				|---
				|Add n seconds to a timestamp.
				|---
				|pure func add_seconds(microseconds: Int, n: Int) -> Int:
				|	microseconds + n * 1000000
				|
				|
				|---
				|Add n months to a timestamp. Clamps day if target month is shorter.
				|---
				|pure func add_months(microseconds: Int, n: Int) -> Int:
				|	y: Int = to_year(microseconds)
				|	m: Int = to_month(microseconds)
				|	d: Int = to_day(microseconds)
				|	h: Int = to_hour(microseconds)
				|	mi: Int = to_minute(microseconds)
				|	s: Int = to_second(microseconds)
				|	total_months: Int = y * 12 + m - 1 + n
				|	var new_year: Int = total_months / 12
				|	var new_month: Int = total_months % 12 + 1
				|
				|	if new_month <= 0:
				|		new_month += 12
				|		new_year -= 1
				|
				|	max_day: Int = days_in_month(new_year, new_month)
				|
				|	new_day: Int = if d > max_day:
				|		max_day
				|	else:
				|		d
				|
				|	from_parts(new_year, new_month, new_day, h, mi, s)
				|
				|
				|---
				|Add n years to a timestamp.
				|---
				|pure func add_years(microseconds: Int, n: Int) -> Int:
				|	add_months(microseconds, n * 12)
				|
				|
				|---
				|Difference between two timestamps in days (truncated).
				|---
				|pure func diff_days(a: Int, b: Int) -> Int:
				|	(a - b) / 86400000000
				|
				|
				|---
				|Check if a year is a leap year.
				|
				|doctests:
				|    :: 2024 is a leap year
				|    is_leap_year(2024) == True
				|
				|    :: 2023 is not
				|    is_leap_year(2023) == False
				|---
				|pure func is_leap_year(year: Int) -> Bool:
				|	if year % 400 == 0:
				|		True
				|	else if year % 100 == 0:
				|		False
				|	else:
				|		year % 4 == 0
				|
				|
				|private pure func is_valid_date(year: Int, month: Int, day: Int) -> Bool:
				|	if (
				|		month < 1
				|		or month > 12
				|		or day < 1
				|	):
				|		False
				|	else:
				|		day <= days_in_month(year, month)
				|
				|
				|private pure func is_valid_time(hour: Int, minute: Int, second: Int) -> Bool:
				|	hour >= 0 and hour <= 23 and minute >= 0 and minute <= 59 and second >= 0 and second <= 59
				|
				|
				|private pure func is_valid_date_time(
				|	year: Int,
				|	month: Int,
				|	day: Int,
				|	hour: Int,
				|	minute: Int,
				|	second: Int,
				|) -> Bool:
				|	is_valid_date(year, month, day) and is_valid_time(hour, minute, second)
				|
				|
				|---
				|Number of days in a given month (1-12) for a given year.
				|
				|doctests:
				|    :: February in leap year
				|    days_in_month(2024, 2) == 29
				|
				|    :: January
				|    days_in_month(2024, 1) == 31
				|---
				|pure func days_in_month(year: Int, month: Int) -> Int:
				|	match month:
				|		1:
				|			31
				|		2:
				|			if is_leap_year(year):
				|				29
				|			else:
				|				28
				|		3:
				|			31
				|		4:
				|			30
				|		5:
				|			31
				|		6:
				|			30
				|		7:
				|			31
				|		8:
				|			31
				|		9:
				|			30
				|		10:
				|			31
				|		11:
				|			30
				|		_:
				|			31
				|
				|
				|---
				|Month name from number (1-12).
				|
				|doctests:
				|    :: January
				|    month_name(1) == "January"
				|---
				|pure func month_name(month: Int) -> String:
				|	match month:
				|		1:
				|			"January"
				|		2:
				|			"February"
				|		3:
				|			"March"
				|		4:
				|			"April"
				|		5:
				|			"May"
				|		6:
				|			"June"
				|		7:
				|			"July"
				|		8:
				|			"August"
				|		9:
				|			"September"
				|		10:
				|			"October"
				|		11:
				|			"November"
				|		_:
				|			"December"
				|
			Some(source)
		"std/toml":
			source: String = raw
				|import:
				|	dict: dict
				|	string: from_char
				|
				|
				|-- TOML - TOML parser and accessor
				|--
				|-- Parses a strict subset of TOML v1.0 (key-value pairs, tables, arrays, inline
				|-- tables). Unsupported syntax returns Err instead of being guessed as strings.
				|-- Values are represented as TomlValue union type.
				|--
				|-- Supported types: String, Int, Float, Bool, Array, Table
				|-- Supported syntax: basic strings, literal strings, integers, floats,
				|-- booleans, arrays, inline tables, [table] headers, comments
				|-- Rejected TOML v1 syntax: dates/times, multi-line strings, numeric separators,
				|-- non-finite floats, quoted keys, unicode escapes, repeated table headers
				|-- ============================================================================
				|-- Types
				|-- ============================================================================
				|union TomlValue:
				|	TomlString(String)
				|	TomlInt(Int)
				|	TomlFloat(Float)
				|	TomlBool(Bool)
				|	TomlArray(List[TomlValue])
				|	TomlTable(Dict[String, TomlValue])
				|
				|
				|record TomlError {
				|	line: Int,
				|	column: Int,
				|	message: String
				|}
				|
				|
				|pure func format_parse_error(err: TomlError) -> String:
				|	"line ${err.line.to_string()}, column ${err.column.to_string()}: ${err.message}"
				|
				|
				|-- ============================================================================
				|-- Public API
				|-- ============================================================================
				|---
				|Parse a TOML string into a TomlValue.
				|Table sections are flattened: [server] host = "x" becomes key "server.host".
				|Parse errors include line and column context in the returned string. Use
				|`parse_detailed` when callers need structured error fields.
				|
				|doctests:
				|    :: Simple key-value
				|    match parse("key = \"value\""):
				|        Ok(tv):
				|            True
				|        Err(_):
				|            False
				|---
				|pure func parse(input: String) -> Result[TomlValue, String]:
				|	match parse_detailed(input):
				|		Ok(value):
				|			Ok(value)
				|		Err(err):
				|			Err(err.format_parse_error())
				|
				|
				|---
				|Parse a TOML string into a TomlValue with structured parser error details.
				|Table sections are flattened: [server] host = "x" becomes key "server.host".
				|Use `parse` if you only need a formatted string error.
				|
				|doctests:
				|    :: Structured parse error
				|    match parse_detailed("ok = 1\nname = Alice"):
				|        Ok(_):
				|            False
				|        Err(e):
				|            e.line == 2 and e.column == 8
				|---
				|pure func parse_detailed(input: String) -> Result[TomlValue, TomlError]:
				|	lines: List[String] = input.split("\n")
				|	result ?= parse_all_lines(lines)
				|	Ok(TomlTable(result))
				|
				|
				|---
				|Get a string value by key.
				|
				|doctests:
				|    :: Get string
				|    match parse("name = \"Alice\""):
				|        Ok(t):
				|            get_string(t, "name") == Some("Alice")
				|        Err(_):
				|            False
				|---
				|pure func get_string(toml: TomlValue, key: String) -> Option[String]:
				|	val: Option[TomlValue] = lookup(toml, key)
				|	extract_string(val)
				|
				|
				|---
				|Get an integer value by key.
				|---
				|pure func get_int(toml: TomlValue, key: String) -> Option[Int]:
				|	val: Option[TomlValue] = lookup(toml, key)
				|	extract_int(val)
				|
				|
				|---
				|Get a float value by key.
				|---
				|pure func get_float(toml: TomlValue, key: String) -> Option[Float]:
				|	val: Option[TomlValue] = lookup(toml, key)
				|	extract_float(val)
				|
				|
				|---
				|Get a boolean value by key.
				|---
				|pure func get_bool(toml: TomlValue, key: String) -> Option[Bool]:
				|	val: Option[TomlValue] = lookup(toml, key)
				|	extract_bool(val)
				|
				|
				|---
				|Get a value by key from a TOML table.
				|---
				|pure func lookup(toml: TomlValue, key: String) -> Option[TomlValue]:
				|	var result: Option[TomlValue] = None
				|
				|	match toml:
				|		TomlTable(dict):
				|			result = dict.get(key)
				|		_:
				|			result = None
				|
				|	result
				|
				|
				|---
				|Get a value by dot-separated path.
				|For tables, looks up "section.key" as a flat key.
				|---
				|pure func lookup_path(toml: TomlValue, path: String) -> Option[TomlValue]:
				|	-- First try direct lookup of the dotted key
				|	lookup(toml, path)
				|
				|
				|-- ============================================================================
				|-- Extractors (avoid nested match in module functions)
				|-- ============================================================================
				|private pure func extract_string(val: Option[TomlValue]) -> Option[String]:
				|	var result: Option[String] = None
				|
				|	match val:
				|		Some(v):
				|			match v:
				|				TomlString(s):
				|					result = Some(s)
				|				_:
				|					result = None
				|		None:
				|			result = None
				|
				|	result
				|
				|
				|private pure func extract_int(val: Option[TomlValue]) -> Option[Int]:
				|	var result: Option[Int] = None
				|
				|	match val:
				|		Some(v):
				|			match v:
				|				TomlInt(n):
				|					result = Some(n)
				|				_:
				|					result = None
				|		None:
				|			result = None
				|
				|	result
				|
				|
				|private pure func extract_float(val: Option[TomlValue]) -> Option[Float]:
				|	var result: Option[Float] = None
				|
				|	match val:
				|		Some(v):
				|			match v:
				|				TomlFloat(f):
				|					result = Some(f)
				|				_:
				|					result = None
				|		None:
				|			result = None
				|
				|	result
				|
				|
				|private pure func extract_bool(val: Option[TomlValue]) -> Option[Bool]:
				|	var result: Option[Bool] = None
				|
				|	match val:
				|		Some(v):
				|			match v:
				|				TomlBool(b):
				|					result = Some(b)
				|				_:
				|					result = None
				|		None:
				|			result = None
				|
				|	result
				|
				|
				|-- ============================================================================
				|-- Internal parsing
				|-- ============================================================================
				|private pure func is_alpha_char(c: Char) -> Bool:
				|	c >= 'a' and c <= 'z' or c >= 'A' and c <= 'Z'
				|
				|
				|private pure func is_key_char(c: Char) -> Bool:
				|	is_alpha_char(c) or c >= '0' and c <= '9' or c == '_' or c == '-' or c == '.'
				|
				|
				|private pure func is_valid_key_path(key: String) -> Bool:
				|	if key.length() == 0:
				|		False
				|	else:
				|		var ok: Bool = True
				|		var prev_dot: Bool = True
				|		var i: Int = 0
				|
				|		while i < key.length() and ok:
				|			match key.get(i):
				|				Some(c):
				|					if not is_key_char(c):
				|						ok = False
				|					else if c == '.':
				|						if prev_dot:
				|							ok = False
				|
				|						prev_dot = True
				|					else:
				|						prev_dot = False
				|				None:
				|					ok = False
				|
				|			i += 1
				|
				|		ok and not prev_dot
				|
				|
				|private pure func line_error(line: Int, column: Int, message: String) -> TomlError:
				|	{
				|		line = line,
				|		column = column,
				|		message = message
				|	}
				|
				|
				|private pure func value_column(line: String, eq_pos: Int) -> Int:
				|	var i: Int = eq_pos + 1
				|	var done: Bool = False
				|
				|	while i < line.length() and not done:
				|		ch: String = line.substring(i, 1)
				|
				|		if ch == " " or ch == "\t":
				|			i += 1
				|		else:
				|			done = True
				|
				|	i + 1
				|
				|
				|private pure func parse_all_lines(
				|	lines: List[String],
				|) -> Result[Dict[String, TomlValue], TomlError]:
				|	var result: Dict[String, TomlValue] = dict()
				|	var defined_sections: List[String] = []
				|	var section: String = ""
				|	var remaining: List[String] = lines
				|	var done: Bool = False
				|	var ok: Bool = True
				|	var error: TomlError = {
				|		line = 1,
				|		column = 1,
				|		message = ""
				|	}
				|	var line_number: Int = 1
				|
				|	while not done:
				|		match remaining:
				|			[]:
				|				done = True
				|			[line, ...rest]:
				|				trimmed: String = strip_inline_comment(line.trim()).trim()
				|
				|				if trimmed.length() == 0:
				|					remaining = rest
				|					line_number += 1
				|				else if has_prefix(trimmed, "#"):
				|					remaining = rest
				|					line_number += 1
				|				else if has_prefix(trimmed, "[["):
				|					ok = False
				|					error = line_error(line_number, 1, "array tables are not supported")
				|					done = True
				|				else if has_prefix(trimmed, "["):
				|					match parse_table_name(trimmed):
				|						Ok(name):
				|							if defined_sections.contains(name):
				|								ok = False
				|								error = line_error(line_number, 1, "duplicate table: " + name)
				|								done = True
				|							else:
				|								defined_sections = defined_sections.append(name)
				|								section = name
				|								remaining = rest
				|								line_number += 1
				|						Err(msg):
				|							ok = False
				|							error = line_error(line_number, 1, msg)
				|							done = True
				|				else:
				|					eq_pos: Int = find_eq(trimmed)
				|
				|					if eq_pos <= 0:
				|						ok = False
				|						error = line_error(line_number, 1, "expected key = value")
				|						done = True
				|					else:
				|						key: String = trimmed
				|							.substring(0, eq_pos)
				|							.trim()
				|
				|						if not is_valid_key_path(key):
				|							ok = False
				|							error = line_error(line_number, 1, "invalid key")
				|							done = True
				|						else:
				|							val_str: String = trimmed
				|								.substring(eq_pos + 1, trimmed.length() - eq_pos - 1)
				|								.trim()
				|
				|							full_key: String = if section.length() == 0:
				|								key
				|							else:
				|								section + "." + key
				|
				|							if result.contains(full_key):
				|								ok = False
				|								error = line_error(line_number, 1, "duplicate key: " + full_key)
				|								done = True
				|							else:
				|								match parse_value(val_str):
				|									Ok(value):
				|										result = result.set(full_key, value)
				|										remaining = rest
				|										line_number += 1
				|									Err(msg):
				|										ok = False
				|										error = line_error(
				|											line_number,
				|											value_column(trimmed, eq_pos),
				|											msg,
				|										)
				|										done = True
				|			_:
				|				done = True
				|
				|	if ok:
				|		Ok(result)
				|	else:
				|		Err(error)
				|
				|
				|private pure func parse_table_name(line: String) -> Result[String, String]:
				|	close: Int = line.raw_index_of("]")
				|
				|	if close < 0:
				|		Err("unterminated table header")
				|	else if close != line.length() - 1:
				|		Err("unexpected text after table header")
				|	else:
				|		name: String = line
				|			.substring(1, close - 1)
				|			.trim()
				|
				|		if name.length() == 0:
				|			Err("empty table name")
				|		else if is_valid_key_path(name):
				|			Ok(name)
				|		else:
				|			Err("invalid table name")
				|
				|
				|private pure func parse_value(s: String) -> Result[TomlValue, String]:
				|	if s.length() == 0:
				|		Err("missing value")
				|	else:
				|		first: String = s.substring(0, 1)
				|
				|		if first == "\"":
				|			if has_prefix(s, "\"\"\""):
				|				Err("multi-line basic strings are not supported")
				|			else:
				|				v ?= parse_basic_str(s)
				|				Ok(TomlString(v))
				|		else if first == "'":
				|			if has_prefix(s, "'''"):
				|				Err("multi-line literal strings are not supported")
				|			else:
				|				v ?= parse_literal_str(s)
				|				Ok(TomlString(v))
				|		else if first == "[":
				|			v ?= parse_array_val(s)
				|			Ok(TomlArray(v))
				|		else if first == "{":
				|			v ?= parse_inline_tbl(s)
				|			Ok(TomlTable(v))
				|		else if s == "true":
				|			Ok(TomlBool(True))
				|		else if s == "false":
				|			Ok(TomlBool(False))
				|		else:
				|			parse_num(s)
				|
				|
				|private pure func parse_basic_str(s: String) -> Result[String, String]:
				|	if s.length() < 2 or s.substring(s.length() - 1, 1) != "\"":
				|		Err("unterminated basic string")
				|	else:
				|		inner: String = s.substring(1, s.length() - 2)
				|		unescape(inner)
				|
				|
				|private pure func parse_literal_str(s: String) -> Result[String, String]:
				|	if s.length() < 2 or s.substring(s.length() - 1, 1) != "'":
				|		Err("unterminated literal string")
				|	else:
				|		Ok(s.substring(1, s.length() - 2))
				|
				|
				|private pure func unescape(s: String) -> Result[String, String]:
				|	var acc: String = ""
				|	var i: Int = 0
				|	var ok: Bool = True
				|	var error: String = ""
				|
				|	while i < s.length() and ok:
				|		ch: String = s.substring(i, 1)
				|
				|		if ch == "\\":
				|			if i + 1 >= s.length():
				|				ok = False
				|				error = "unterminated escape sequence"
				|			else:
				|				next: String = s.substring(i + 1, 1)
				|
				|				if next == "b":
				|					acc += from_char(to_char(8))
				|					i += 2
				|				else if next == "t":
				|					acc += "\t"
				|					i += 2
				|				else if next == "n":
				|					acc += "\n"
				|					i += 2
				|				else if next == "f":
				|					acc += from_char(to_char(12))
				|					i += 2
				|				else if next == "r":
				|					acc += "\r"
				|					i += 2
				|				else if next == "\"":
				|					acc += "\""
				|					i += 2
				|				else if next == "\\":
				|					acc += "\\"
				|					i += 2
				|				else:
				|					ok = False
				|					error = "invalid string escape"
				|		else:
				|			acc += ch
				|			i += 1
				|
				|	if ok:
				|		Ok(acc)
				|	else:
				|		Err(error)
				|
				|
				|private pure func parse_num(s: String) -> Result[TomlValue, String]:
				|	if s.contains("_"):
				|		Err("numeric separators are not supported")
				|	else if (
				|		s == "inf"
				|		or s == "+inf"
				|		or s == "-inf"
				|		or s == "nan"
				|		or s == "+nan"
				|		or s == "-nan"
				|	):
				|		Err("non-finite floats are not supported")
				|	else if (
				|		s.contains(".")
				|		or s.contains("e")
				|		or s.contains("E")
				|	):
				|		match s.parse_float():
				|			Some(f):
				|				Ok(TomlFloat(f))
				|			None:
				|				Err("invalid value")
				|	else:
				|		match s.parse_int():
				|			Some(n):
				|				Ok(TomlInt(n))
				|			None:
				|				Err("invalid value")
				|
				|
				|private pure func parse_array_val(s: String) -> Result[List[TomlValue], String]:
				|	if s.length() < 2 or s.substring(s.length() - 1, 1) != "]":
				|		Err("unterminated array")
				|	else:
				|		inner: String = s
				|			.substring(1, s.length() - 2)
				|			.trim()
				|
				|		if inner.length() == 0:
				|			Ok([])
				|		else if inner.substring(inner.length() - 1, 1) == ",":
				|			Err("trailing comma in array")
				|		else:
				|			split_and_parse(inner)
				|
				|
				|private pure func split_and_parse(s: String) -> Result[List[TomlValue], String]:
				|	elements ?= split_top_level(s)
				|	parse_string_list(elements)
				|
				|
				|private pure func parse_string_list(strs: List[String]) -> Result[List[TomlValue], String]:
				|	var result: List[TomlValue] = []
				|	var remaining: List[String] = strs
				|	var done: Bool = False
				|	var ok: Bool = True
				|	var error: String = ""
				|
				|	while not done:
				|		match remaining:
				|			[]:
				|				done = True
				|			[elem, ...rest]:
				|				trimmed: String = elem.trim()
				|
				|				if trimmed.length() == 0:
				|					ok = False
				|					error = "empty array element"
				|					done = True
				|				else:
				|					match parse_value(trimmed):
				|						Ok(value):
				|							result = result.append(value)
				|							remaining = rest
				|						Err(msg):
				|							ok = False
				|							error = msg
				|							done = True
				|			_:
				|				done = True
				|
				|	if ok:
				|		Ok(result)
				|	else:
				|		Err(error)
				|
				|
				|private pure func split_top_level(s: String) -> Result[List[String], String]:
				|	var result: List[String] = []
				|	var current: String = ""
				|	var depth: Int = 0
				|	var in_str: Bool = False
				|	var in_lit: Bool = False
				|	var escaped: Bool = False
				|	var i: Int = 0
				|	var ok: Bool = True
				|	var error: String = ""
				|
				|	while i < s.length() and ok:
				|		ch: String = s.substring(i, 1)
				|
				|		if in_str:
				|			current += ch
				|
				|			if escaped:
				|				escaped = False
				|			else if ch == "\\":
				|				escaped = True
				|			else if ch == "\"":
				|				in_str = False
				|		else if in_lit:
				|			current += ch
				|
				|			if ch == "'":
				|				in_lit = False
				|		else if ch == "\"":
				|			current += ch
				|			in_str = True
				|		else if ch == "'":
				|			current += ch
				|			in_lit = True
				|		else if ch == "[" or ch == "{":
				|			depth += 1
				|			current += ch
				|		else if ch == "]" or ch == "}":
				|			if depth == 0:
				|				ok = False
				|				error = "unmatched delimiter"
				|			else:
				|				depth -= 1
				|				current += ch
				|		else if ch == "," and depth == 0:
				|			result = result.append(current)
				|			current = ""
				|		else:
				|			current += ch
				|
				|		i += 1
				|
				|	if ok and in_str:
				|		ok = False
				|		error = "unterminated string"
				|
				|	if ok and in_lit:
				|		ok = False
				|		error = "unterminated literal string"
				|
				|	if ok and depth != 0:
				|		ok = False
				|		error = "unmatched delimiter"
				|
				|	if ok:
				|		result = result.append(current)
				|		Ok(result)
				|	else:
				|		Err(error)
				|
				|
				|private pure func parse_inline_tbl(s: String) -> Result[Dict[String, TomlValue], String]:
				|	if s.length() < 2 or s.substring(s.length() - 1, 1) != "}":
				|		Err("unterminated inline table")
				|	else:
				|		inner: String = s
				|			.substring(1, s.length() - 2)
				|			.trim()
				|
				|		if inner.length() == 0:
				|			Ok(dict())
				|		else if inner.substring(inner.length() - 1, 1) == ",":
				|			Err("trailing comma in inline table")
				|		else:
				|			parse_pairs(inner)
				|
				|
				|private pure func parse_pairs(s: String) -> Result[Dict[String, TomlValue], String]:
				|	var result: Dict[String, TomlValue] = dict()
				|	var pairs: List[String] = []
				|	var done: Bool = False
				|	var ok: Bool = True
				|	var error: String = ""
				|
				|	match split_top_level(s):
				|		Ok(items):
				|			pairs = items
				|		Err(msg):
				|			ok = False
				|			error = msg
				|			done = True
				|
				|	var remaining: List[String] = pairs
				|
				|	while not done:
				|		match remaining:
				|			[]:
				|				done = True
				|			[pair_str, ...rest]:
				|				trimmed: String = pair_str.trim()
				|				eq_pos: Int = find_eq(trimmed)
				|
				|				if eq_pos <= 0:
				|					ok = False
				|					error = "expected key = value in inline table"
				|					done = True
				|				else:
				|					key: String = trimmed
				|						.substring(0, eq_pos)
				|						.trim()
				|
				|					if not is_valid_key_path(key):
				|						ok = False
				|						error = "invalid inline table key"
				|						done = True
				|					else if result.contains(key):
				|						ok = False
				|						error = "duplicate inline table key: " + key
				|						done = True
				|					else:
				|						val_str: String = trimmed
				|							.substring(eq_pos + 1, trimmed.length() - eq_pos - 1)
				|							.trim()
				|
				|						match parse_value(val_str):
				|							Ok(value):
				|								result = result.set(key, value)
				|								remaining = rest
				|							Err(msg):
				|								ok = False
				|								error = msg
				|								done = True
				|			_:
				|				done = True
				|
				|	if ok:
				|		Ok(result)
				|	else:
				|		Err(error)
				|
				|
				|-- ============================================================================
				|-- Helpers
				|-- ============================================================================
				|private pure func find_eq(s: String) -> Int:
				|	var i: Int = 0
				|	var in_str: Bool = False
				|	var found: Int = -1
				|	var done: Bool = False
				|
				|	while i < s.length() and not done:
				|		ch: String = s.substring(i, 1)
				|
				|		if ch == "\"":
				|			in_str = not in_str
				|		else if ch == "=" and not in_str:
				|			found = i
				|			done = True
				|
				|		i += 1
				|
				|	found
				|
				|
				|private pure func has_prefix(s: String, prefix: String) -> Bool:
				|	plen: Int = prefix.length()
				|
				|	if s.length() < plen:
				|		False
				|	else:
				|		s.substring(0, plen) == prefix
				|
				|
				|-- Strip inline comments: "value # comment" -> "value"
				|-- Respects quoted strings (# inside quotes is not a comment)
				|private pure func strip_inline_comment(s: String) -> String:
				|	var i: Int = 0
				|	var in_str: Bool = False
				|	var in_lit: Bool = False
				|	var found: Int = -1
				|	var done: Bool = False
				|
				|	while i < s.length() and not done:
				|		ch: String = s.substring(i, 1)
				|
				|		if in_str:
				|			if ch == "\"":
				|				in_str = False
				|		else if in_lit:
				|			if ch == "'":
				|				in_lit = False
				|		else if ch == "\"":
				|			in_str = True
				|		else if ch == "'":
				|			in_lit = True
				|		else if ch == "#":
				|			found = i
				|			done = True
				|
				|		i += 1
				|
				|	if found > 0:
				|		s
				|			.substring(0, found)
				|			.trim()
				|	else:
				|		s
				|
				|
				|-- TOML Typed Decoder
				|--
				|-- Composable field decoders for extracting typed records from TOML data.
				|-- Mirrors the pattern from codec: define a Decoder[T], then run it with
				|-- from_string.
				|--
				|-- Usage:
				|-- decoder = map2(make_config, field("host", string), field("port", int))
				|-- result = from_string(decoder, toml_input)
				|-- ============================================================================
				|-- Types
				|-- ============================================================================
				|record TomlDecodeError {
				|	path: String,
				|	message: String
				|}
				|
				|
				|type alias Decoder[T] = pure (TomlValue) -> Result[T, TomlDecodeError]
				|
				|
				|-- ============================================================================
				|-- Primitive Decoders
				|-- ============================================================================
				|---
				|Decode a TOML string value by key.
				|---
				|pure func string_decoder(key: String, toml: TomlValue) -> Result[String, TomlDecodeError]:
				|	match get_string(toml, key):
				|		Some(s):
				|			Ok(s)
				|		None:
				|			Err({
				|				path = key,
				|				message = "missing or not a string",
				|			})
				|
				|
				|---
				|Decode a TOML integer value by key.
				|---
				|pure func int_decoder(key: String, toml: TomlValue) -> Result[Int, TomlDecodeError]:
				|	match get_int(toml, key):
				|		Some(n):
				|			Ok(n)
				|		None:
				|			Err({
				|				path = key,
				|				message = "missing or not an integer",
				|			})
				|
				|
				|---
				|Decode a TOML float value by key.
				|---
				|pure func float_decoder(key: String, toml: TomlValue) -> Result[Float, TomlDecodeError]:
				|	match get_float(toml, key):
				|		Some(f):
				|			Ok(f)
				|		None:
				|			Err({
				|				path = key,
				|				message = "missing or not a float",
				|			})
				|
				|
				|---
				|Decode a TOML boolean value by key.
				|---
				|pure func bool_decoder(key: String, toml: TomlValue) -> Result[Bool, TomlDecodeError]:
				|	match get_bool(toml, key):
				|		Some(b):
				|			Ok(b)
				|		None:
				|			Err({
				|				path = key,
				|				message = "missing or not a boolean",
				|			})
				|
				|
				|-- ============================================================================
				|-- Primitive Decoder Values (for use with field/optional)
				|-- ============================================================================
				|---
				|String primitive decoder — extracts a string from a TomlValue.
				|---
				|pure func string(toml: TomlValue) -> Result[String, TomlDecodeError]:
				|	match toml:
				|		TomlString(s):
				|			Ok(s)
				|		_:
				|			Err({
				|				path = "",
				|				message = "expected string",
				|			})
				|
				|
				|---
				|Integer primitive decoder — extracts an int from a TomlValue.
				|---
				|pure func int(toml: TomlValue) -> Result[Int, TomlDecodeError]:
				|	match toml:
				|		TomlInt(n):
				|			Ok(n)
				|		_:
				|			Err({
				|				path = "",
				|				message = "expected integer",
				|			})
				|
				|
				|---
				|Float primitive decoder — extracts a float from a TomlValue.
				|---
				|pure func float(toml: TomlValue) -> Result[Float, TomlDecodeError]:
				|	match toml:
				|		TomlFloat(f):
				|			Ok(f)
				|		_:
				|			Err({
				|				path = "",
				|				message = "expected float",
				|			})
				|
				|
				|---
				|Boolean primitive decoder — extracts a bool from a TomlValue.
				|---
				|pure func bool(toml: TomlValue) -> Result[Bool, TomlDecodeError]:
				|	match toml:
				|		TomlBool(b):
				|			Ok(b)
				|		_:
				|			Err({
				|				path = "",
				|				message = "expected boolean",
				|			})
				|
				|
				|-- ============================================================================
				|-- Field Decoders
				|-- ============================================================================
				|---
				|Decode a required field by key, using a primitive decoder.
				|---
				|pure func required[T](key: String, decoder: Decoder[T]) -> Decoder[T]:
				|	pure func(toml: TomlValue) -> Result[T, TomlDecodeError]:
				|		match lookup(toml, key):
				|			Some(val):
				|				match decoder(val):
				|					Ok(v):
				|						Ok(v)
				|					Err(e):
				|						Err({
				|							path = key,
				|							message = e.message,
				|						})
				|			None:
				|				Err({
				|					path = key,
				|					message = "missing field",
				|				})
				|
				|
				|---
				|Decode an optional field by key. Returns None if the key is missing.
				|---
				|pure func optional[T](key: String, decoder: Decoder[T]) -> Decoder[Option[T]]:
				|	pure func(toml: TomlValue) -> Result[Option[T], TomlDecodeError]:
				|		match lookup(toml, key):
				|			Some(val):
				|				match decoder(val):
				|					Ok(v):
				|						Ok(Some(v))
				|					Err(e):
				|						Err({
				|							path = key,
				|							message = e.message,
				|						})
				|			None:
				|				Ok(None)
				|
				|
				|-- ============================================================================
				|-- Combiners
				|-- ============================================================================
				|---
				|Combine two field decoders into a single record decoder.
				|---
				|pure func map2[A, B, R](
				|	f: pure (A, B) -> R,
				|	d1: Decoder[A],
				|	d2: Decoder[B],
				|) -> Decoder[R]:
				|	pure func(toml: TomlValue) -> Result[R, TomlDecodeError]:
				|		a ?= d1(toml)
				|		b ?= d2(toml)
				|		Ok(f(a, b))
				|
				|
				|---
				|Combine three field decoders into a single record decoder.
				|---
				|pure func map3[A, B, C, R](
				|	f: pure (A, B, C) -> R,
				|	d1: Decoder[A],
				|	d2: Decoder[B],
				|	d3: Decoder[C],
				|) -> Decoder[R]:
				|	pure func(toml: TomlValue) -> Result[R, TomlDecodeError]:
				|		a ?= d1(toml)
				|		b ?= d2(toml)
				|		c ?= d3(toml)
				|		Ok(f(a, b, c))
				|
				|
				|---
				|Combine four field decoders into a single record decoder.
				|---
				|pure func map4[A, B, C, D, R](
				|	f: pure (A, B, C, D) -> R,
				|	d1: Decoder[A],
				|	d2: Decoder[B],
				|	d3: Decoder[C],
				|	d4: Decoder[D],
				|) -> Decoder[R]:
				|	pure func(toml: TomlValue) -> Result[R, TomlDecodeError]:
				|		a ?= d1(toml)
				|		b ?= d2(toml)
				|		c ?= d3(toml)
				|		d ?= d4(toml)
				|		Ok(f(a, b, c, d))
				|
				|
				|-- ============================================================================
				|-- Pipeline
				|-- ============================================================================
				|---
				|Parse a TOML string and decode it using the decoder.
				|---
				|pure func from_string[T](decoder: Decoder[T], input: String) -> Result[T, String]:
				|	match parse(input):
				|		Ok(toml):
				|			match decoder(toml):
				|				Ok(val):
				|					Ok(val)
				|				Err(e):
				|					Err(e.format_error())
				|		Err(e):
				|			Err(e)
				|
				|
				|-- ============================================================================
				|-- Error Formatting
				|-- ============================================================================
				|---
				|Format a TomlDecodeError as a plain text string.
				|---
				|pure func format_error(err: TomlDecodeError) -> String:
				|	err.path + ": " + err.message
				|
			Some(source)
		"std/traits":
			source: String = raw
				|-- Standard Library Traits
				|--
				|-- Traits define requirements for generic type parameters.
				|-- Each trait contains method signatures that implementers must provide.
				|-- ============================================================================
				|-- Core Traits
				|-- ============================================================================
				|-- String Representation
				|trait Stringable:
				|	pure func to_string(value: Self) -> String
				|
				|
				|-- Arithmetic Operations
				|trait Addable:
				|	pure func add(a: Self, b: Self) -> Self
				|
				|
				|trait Subtractable:
				|	pure func subtract(a: Self, b: Self) -> Self
				|
				|
				|trait Multipliable:
				|	pure func multiply(a: Self, b: Self) -> Self
				|
				|
				|trait Divisible:
				|	pure func divide(a: Self, b: Self) -> Self
				|
				|
				|trait Modulable:
				|	pure func remainder(a: Self, b: Self) -> Self
				|
				|
				|trait Negatable:
				|	pure func negate(a: Self) -> Self
				|
				|
				|-- Zero and One values for numeric operations
				|trait HasZero:
				|	pure func zero() -> Self
				|
				|
				|trait HasOne:
				|	pure func one() -> Self
				|
				|
				|-- Comparison Operations
				|--
				|-- `not_equals` has a default derived from `equals`; implementations only need
				|-- to provide `equals`. The compiler synthesizes `not_equals` via trait default bodies.
				|trait Equatable:
				|	pure func equals(a: Self, b: Self) -> Bool
				|	pure func not_equals(a: Self, b: Self) -> Bool: not equals(a, b)
				|
				|
				|-- `Orderable` requires `Equatable` as a supertrait, matching
				|-- Rust/Haskell/Swift/C++. Total ordering defines equality via
				|-- antisymmetry (a <= b and b <= a implies a == b), so every ordered
				|-- type is also equatable — this prevents the Java footgun of ordering
				|-- that is inconsistent with equals. `greater_than`, `less_than_or_equal`, and
				|-- `greater_than_or_equal` default to expressions over `less_than` alone.
				|trait Orderable: Equatable:
				|	pure func less_than(a: Self, b: Self) -> Bool
				|	pure func greater_than(a: Self, b: Self) -> Bool: less_than(b, a)
				|	pure func less_than_or_equal(a: Self, b: Self) -> Bool: not less_than(b, a)
				|	pure func greater_than_or_equal(a: Self, b: Self) -> Bool: not less_than(a, b)
				|
				|
				|-- Absolute Value
				|trait Absolute:
				|	pure func abs(value: Self) -> Self
				|
				|
				|-- Min/Max Operations
				|trait Bounded:
				|	pure func min(a: Self, b: Self) -> Self
				|	pure func max(a: Self, b: Self) -> Self
				|
				|
				|-- Hash Operations
				|--
				|-- `Hashable` requires `Equatable` as a supertrait: the contract is
				|-- that `a == b` implies `hash(a) == hash(b)`, which is meaningless
				|-- without an equality relation. Blorp's built-in Dict and Set use
				|-- an internal HashDoS-resistant seeded hash for primitive keys;
				|-- this trait is the extension point for user types. The returned
				|-- Int is an implementation-defined hash value — relying on its
				|-- absolute value across runs is a bug (the runtime seeds hashers
				|-- at process start). For cryptographic hashing (SHA-256 etc.), see
				|-- `hash.brp`.
				|trait Hashable: Equatable:
				|	pure func hash(self: Self) -> Int
				|
				|
				|-- Collection Operations
				|trait HasLength:
				|	pure func length(coll: Self) -> Int
				|
				|
				|trait ToBool:
				|	pure func to_bool(value: Self) -> Bool
				|
				|
				|-- Logical Operations
				|trait Logical:
				|	pure func logical_and(a: Self, b: Self) -> Self
				|	pure func logical_or(a: Self, b: Self) -> Self
				|	pure func logical_not(a: Self) -> Self
				|
				|
				|-- Type Conversions
				|trait ToInt:
				|	pure func to_int(value: Self) -> Int
				|
				|
				|trait ToFloat:
				|	pure func to_float(value: Self) -> Float
				|
				|
				|trait ToFixed:
				|	pure func to_fixed(value: Self) -> Fixed
				|
				|
				|trait ToChar:
				|	pure func to_char(value: Self) -> Char
				|
				|
				|-- ============================================================================
				|-- Numeric Type Family Traits
				|-- ============================================================================
				|-- Integer family: Int, Int8..Int128, UInt8..UInt128
				|trait Integer: Addable + Subtractable + Multipliable + Divisible + Modulable + Orderable + HasZero + HasOne + Stringable + Absolute + Bounded + ToInt:
				|	pure func checked_div(a: Self, b: Self) -> Option[Self]
				|	pure func checked_mod(a: Self, b: Self) -> Option[Self]
				|	pure func bit_and(a: Self, b: Self) -> Self
				|	pure func bit_or(a: Self, b: Self) -> Self
				|	pure func bit_xor(a: Self, b: Self) -> Self
				|	pure func bit_not(a: Self) -> Self
				|	pure func shift_left(a: Self, n: Int) -> Self
				|	pure func shift_right(a: Self, n: Int) -> Self
				|
				|
				|trait SignedInteger: Integer + Negatable
				|
				|
				|trait UnsignedInteger: Integer
				|
				|
				|-- FloatingPoint family: Float, Float32, Float16
				|trait FloatingPoint: Addable + Subtractable + Multipliable + Divisible + Negatable + Orderable + HasZero + HasOne + Stringable + Absolute + Bounded + ToFloat:
				|	pure func floor(x: Self) -> Self
				|	pure func ceil(x: Self) -> Self
				|	pure func round(x: Self) -> Self
				|	pure func trunc(x: Self) -> Self
				|	pure func sqrt(x: Self) -> Self
				|	pure func sin(x: Self) -> Self
				|	pure func cos(x: Self) -> Self
				|	pure func tan(x: Self) -> Self
				|	pure func asin(x: Self) -> Self
				|	pure func acos(x: Self) -> Self
				|	pure func atan(x: Self) -> Self
				|	pure func atan2(x: Self, y: Self) -> Self
				|	pure func sinh(x: Self) -> Self
				|	pure func cosh(x: Self) -> Self
				|	pure func tanh(x: Self) -> Self
				|	pure func asinh(x: Self) -> Self
				|	pure func acosh(x: Self) -> Self
				|	pure func atanh(x: Self) -> Self
				|	pure func exp(x: Self) -> Self
				|	pure func exp2(x: Self) -> Self
				|	pure func expm1(x: Self) -> Self
				|	pure func log(x: Self) -> Self
				|	pure func log2(x: Self) -> Self
				|	pure func log10(x: Self) -> Self
				|	pure func log1p(x: Self) -> Self
				|	pure func pow(x: Self, y: Self) -> Self
				|	pure func cbrt(x: Self) -> Self
				|	pure func hypot(x: Self, y: Self) -> Self
				|	pure func fmod(x: Self, y: Self) -> Self
				|	pure func copysign(x: Self, y: Self) -> Self
				|	pure func fma(x: Self, y: Self, z: Self) -> Self
				|	pure func is_nan(x: Self) -> Bool
				|	pure func is_inf(x: Self) -> Bool
				|	pure func is_finite(x: Self) -> Bool
				|
				|
				|-- Numeric: the minimal bound for numeric operations
				|-- (dot product, reductions, etc.). Any type that supports addition,
				|-- multiplication, and has a zero element qualifies.
				|trait Numeric: Addable + Multipliable + HasZero
				|
				|
				|-- FixedPoint family: Fixed
				|trait FixedPoint: Addable + Subtractable + Multipliable + Divisible + Orderable + HasZero + Stringable + Absolute + Bounded:
				|	pure func get_scale(x: Self) -> Int
				|	pure func round_to(x: Self, s: Int) -> Self
				|
				|
				|-- Copying
				|trait Copyable:
				|	pure func copy(value: Self) -> Self
				|
				|
				|trait Cloneable:
				|	func clone(value: Self) -> Self
				|-- ============================================================================
				|-- Usage Examples
				|-- ============================================================================
				|--
				|-- Generic function with single trait bound:
				|-- pure func sum[T: Addable + HasZero](list: List[T]) -> T:
				|-- var result: T = zero()
				|-- for item in list:
				|-- result = add(result, item)
				|-- result
				|--
				|-- Implementing a trait for a type:
				|-- implements Stringable for Vector2:
				|-- pure func to_string(value: Vector2) -> String:
				|-- "Vector2(" + value.x.to_string() + ", " + value.y.to_string() + ")"
				|--
				|-- implements Addable for Vector2:
				|-- pure func add(a: Vector2, b: Vector2) -> Vector2:
				|-- Vector2 { x = a.x + b.x, y = a.y + b.y }
				|
			Some(source)
		"std/tuple":
			source: String = raw
				|-- Tuple — trait implementations for fixed-size heterogeneous collections.
				|--
				|-- Tuples are a surface-level language construct (2-4 elements, structural
				|-- `(a, b)` / `[0]` / `(a, b) = t`). This module adds `Equatable`, `Stringable`,
				|-- and `Orderable` impls so bare `a == b`, `to_string(t)`, and `a < b` work on
				|-- tuples with no extra ceremony at the call site.
				|--
				|-- Scope: arities 2, 3, and 4 (matches the current parser cap). If the cap
				|-- changes, add matching arity-5+ impls here.
				|--
				|-- Bounds are declared once in the `implements ... for (...)` clause; method
				|-- signatures inherit them. Calling a trait method on a tuple whose elements
				|-- don't satisfy the bound produces a standard "does not implement trait"
				|-- typecheck error naming the offending element's type.
				|-- ============================================================================
				|-- Stringable
				|-- ============================================================================
				|--
				|-- Format: "(e0, e1, ...)" — comma + single space, parens wrapping. Matches
				|-- Python / Rust / OCaml repr convention.
				|implements Stringable for (A:Stringable, B:Stringable):
				|	pure func to_string(t: (A, B)) -> String:
				|		"(" + t[0].to_string() + ", " + t[1].to_string() + ")"
				|
				|
				|implements Stringable for (A:Stringable, B:Stringable, C:Stringable):
				|	pure func to_string(t: (A, B, C)) -> String:
				|		"(" + t[0].to_string() + ", " + t[1].to_string() + ", " + t[2].to_string() + ")"
				|
				|
				|implements Stringable for (A:Stringable, B:Stringable, C:Stringable, D:Stringable):
				|	pure func to_string(t: (A, B, C, D)) -> String:
				|		"(" + t[0].to_string() + ", " + t[1].to_string() + ", " + t[2].to_string() + ", " + t[3].to_string() + ")"
				|
				|
				|-- ============================================================================
				|-- Equatable
				|-- ============================================================================
				|--
				|-- Pairwise equality. Two tuples are equal iff all corresponding fields are
				|-- equal. `not_equals` derives from `equals` via the default trait method body.
				|implements Equatable for (A:Equatable, B:Equatable):
				|	pure func equals(a: (A, B), b: (A, B)) -> Bool:
				|		a[0] == b[0] and a[1] == b[1]
				|
				|
				|implements Equatable for (A:Equatable, B:Equatable, C:Equatable):
				|	pure func equals(a: (A, B, C), b: (A, B, C)) -> Bool:
				|		a[0] == b[0] and a[1] == b[1] and a[2] == b[2]
				|
				|
				|implements Equatable for (A:Equatable, B:Equatable, C:Equatable, D:Equatable):
				|	pure func equals(a: (A, B, C, D), b: (A, B, C, D)) -> Bool:
				|		a[0] == b[0] and a[1] == b[1] and a[2] == b[2] and a[3] == b[3]
				|
				|
				|-- ============================================================================
				|-- Orderable
				|-- ============================================================================
				|--
				|-- Lexicographic ordering: compare elements left-to-right, first difference
				|-- wins. The non-strict comparison methods default via the trait bodies
				|-- expressed over `less_than` alone. Only `Orderable` is needed as a bound:
				|-- `Orderable: Equatable`
				|-- supertrait relationship (traits.brp) means each element's type
				|-- automatically satisfies `Equatable` for the `!=` operator below. The
				|-- supertrait graph is globally resolvable once the `traits` module is
				|-- loaded, so tuple.brp doesn't need to import it.
				|implements Orderable for (A:Orderable, B:Orderable):
				|	pure func less_than(a: (A, B), b: (A, B)) -> Bool:
				|		if a[0] != b[0]:
				|			a[0] < b[0]
				|		else:
				|			a[1] < b[1]
				|
				|
				|implements Orderable for (A:Orderable, B:Orderable, C:Orderable):
				|	pure func less_than(a: (A, B, C), b: (A, B, C)) -> Bool:
				|		if a[0] != b[0]:
				|			a[0] < b[0]
				|		else if a[1] != b[1]:
				|			a[1] < b[1]
				|		else:
				|			a[2] < b[2]
				|
				|
				|implements Orderable for (A:Orderable, B:Orderable, C:Orderable, D:Orderable):
				|	pure func less_than(a: (A, B, C, D), b: (A, B, C, D)) -> Bool:
				|		if a[0] != b[0]:
				|			a[0] < b[0]
				|		else if a[1] != b[1]:
				|			a[1] < b[1]
				|		else if a[2] != b[2]:
				|			a[2] < b[2]
				|		else:
				|			a[3] < b[3]
				|
