				|
				|---
				|Remove duplicate elements, preserving the first occurrence of each.
				|Uses equality comparison. O(n^2).
				|
				|doctests:
				|    :: Remove duplicates
				|    nums: List[Int] = [1, 2, 3, 2, 1, 4]
				|    result: List[Int] = nums.unique()
				|    result.length() == 4
				|
				|    :: Preserves first occurrence order
				|    nums: List[Int] = [3, 1, 2, 1, 3]
				|    result: List[Int] = nums.unique()
				|
				|    match result.get(0):
				|        Some(v):
				|            v == 3
				|        None:
				|            False
				|
				|    :: Already unique list unchanged
				|    nums: List[Int] = [1, 2, 3]
				|    nums
				|        .unique()
				|        .length() == 3
				|---
				|pure func unique[T:Equatable](self: List[T]) -> List[T]:
				|	builtin("std/list.unique")
				|
				|
				|-- =============================================================================
				|-- String Reductions
				|-- =============================================================================
				|---
				|Join a list of strings with a separator.
				|
				|doctests:
				|    :: Join with comma
				|    ["a", "b", "c"].join(",") == "a,b,c"
				|
				|    :: Join single element
				|    ["hello"].join(" ") == "hello"
				|
				|    :: Join empty list
				|    empty: List[String] = []
				|    empty.join(",") == ""
				|---
				|pure func join(self: List[String], sep: String) -> String:
				|	var result: String = ""
				|	var first: Bool = True
				|
				|	for s in self:
				|		if first:
				|			if s.length() > 0:
				|				result = result.string_append(s)
				|
				|			first = False
				|		else:
				|			if sep.length() > 0:
				|				result = result.string_append(sep)
				|
				|			if s.length() > 0:
				|				result = result.string_append(s)
				|
				|	result
				|
				|
				|private pure func string_append(self: String, other: String) -> String:
				|	builtin("std/list.string_append")
				|
				|
				|-- =============================================================================
				|-- Numeric Reductions
				|-- =============================================================================
				|---
				|Sum all elements of a list.
				|
				|doctests:
				|    :: Sum of integers
				|    sum([1, 2, 3, 4]) == 10
				|
				|    :: Sum of floats
				|    sum([1.0, 2.5, 3.5]) == 7.0
				|
				|    :: Sum of empty list
				|    empty: List[Int] = []
				|    sum(empty) == 0
				|---
				|pure func sum[T:Addable+HasZero](self: List[T]) -> T:
				|	var total: T = zero()
				|
				|	for x in self:
				|		total += x
				|
				|	total
				|
				|
				|---
				|Product of all elements of a list.
				|
				|doctests:
				|    :: Product of integers
				|    product([1, 2, 3, 4]) == 24
				|
				|    :: Product of floats
				|    product([2.0, 3.0, 4.0]) == 24.0
				|
				|    :: Product with zero
				|    product([5, 0, 3]) == 0
				|---
				|pure func product[T:Multipliable+HasOne](self: List[T]) -> T:
				|	var total: T = one()
				|
				|	for x in self:
				|		total *= x
				|
				|	total
				|
				|
				|---
				|Find the element that produces the minimum value when transformed by f.
				|Returns None for empty lists.
				|
				|doctests:
				|    :: Min by identity
				|    nums: List[Int] = [3, 1, 2]
				|    min_by(nums, pure func(x: Int): x) == Some(1)
				|
				|    :: Min by negation (finds max)
				|    nums: List[Int] = [3, 1, 2]
				|    min_by(nums, pure func(x: Int): 0 - x) == Some(3)
				|---
				|func min_by[T, K:Orderable](
				|	self: List[T],
				|	f: (T) -> K,
				|) -> Option[T]:
				|pure func min_by[T, K:Orderable](
				|	self: List[T],
				|	f: pure (T) -> K,
				|) -> Option[T]:
				|	builtin("std/list.min_by")
				|
				|
				|---
				|Find the element that produces the maximum value when transformed by f.
				|Returns None for empty lists.
				|
				|doctests:
				|    :: Max by identity
				|    nums: List[Int] = [3, 1, 2]
				|    max_by(nums, pure func(x: Int): x) == Some(3)
				|
				|    :: Max by negation (finds min)
				|    nums: List[Int] = [3, 1, 2]
				|    max_by(nums, pure func(x: Int): 0 - x) == Some(1)
				|---
				|func max_by[T, K:Orderable](
				|	self: List[T],
				|	f: (T) -> K,
				|) -> Option[T]:
				|pure func max_by[T, K:Orderable](
				|	self: List[T],
				|	f: pure (T) -> K,
				|) -> Option[T]:
				|	builtin("std/list.max_by")
				|
				|
				|-- =============================================================================
				|-- Windowing and Scanning
				|-- =============================================================================
				|---
				|Sliding windows of size n over the list.
				|Returns a list of sub-lists, each of length n.
				|Returns empty list if n <= 0 or n > list.length().
				|
				|doctests:
				|    :: Sliding windows of size 2
				|    nums: List[Int] = [1, 2, 3, 4]
				|    w: List[List[Int]] = windows(nums, 2)
				|    w.length() == 3
				|
				|    :: Single-element windows
				|    nums: List[Int] = [1, 2, 3]
				|    w: List[List[Int]] = windows(nums, 1)
				|    w.length() == 3
				|
				|    :: Window size equals list length
				|    nums: List[Int] = [1, 2, 3]
				|    w: List[List[Int]] = windows(nums, 3)
				|    w.length() == 1
				|
				|    :: Window too large returns empty
				|    nums: List[Int] = [1, 2]
				|    w: List[List[Int]] = windows(nums, 5)
				|    w.length() == 0
				|---
				|pure func windows[T](self: List[T], n: Int) -> List[List[T]]:
				|	builtin("std/list.windows")
				|
				|
				|---
				|Non-overlapping chunks of size n.
				|The last chunk may be smaller than n if the list length is not divisible by n.
				|Returns empty list if n <= 0.
				|
				|doctests:
				|    :: Even chunks
				|    nums: List[Int] = [1, 2, 3, 4]
				|    c: List[List[Int]] = chunks(nums, 2)
				|    c.length() == 2
				|
				|    :: Uneven chunks — last chunk is smaller
				|    nums: List[Int] = [1, 2, 3, 4, 5]
				|    c: List[List[Int]] = chunks(nums, 2)
				|    c.length() == 3
				|
				|    :: Chunk size equals list length
				|    nums: List[Int] = [1, 2, 3]
				|    c: List[List[Int]] = chunks(nums, 3)
				|    c.length() == 1
				|
				|    :: Chunk size larger than list
				|    nums: List[Int] = [1, 2]
				|    c: List[List[Int]] = chunks(nums, 5)
				|    c.length() == 1
				|---
				|pure func chunks[T](self: List[T], n: Int) -> List[List[T]]:
				|	builtin("std/list.chunks")
				|
				|
				|---
				|Fold with intermediate results. Like fold_left but returns a list of
				|all accumulated values, starting with the initial value.
				|---
				|func scan[T, A](
				|	self: List[T],
				|	init: A,
				|	f: (A, T) -> A,
				|) -> List[A]:
				|pure func scan[T, A](
				|	self: List[T],
				|	init: A,
				|	f: pure (A, T) -> A,
				|) -> List[A]:
				|	builtin("std/list.scan")
				|
				|
				|-- =============================================================================
				|-- Parallel List Pipelines
				|-- =============================================================================
				|-- `parallel` is the only public entry point for list parallelism. The callback
				|-- receives a ParallelList[T], which intentionally exposes only parallel-safe
				|-- combinators. It cannot be indexed, measured, collected, or mutated directly.
				|---
				|Run a parallel list pipeline.
				|
				|The callback can use ParallelList.map, ParallelList.filter, and
				|ParallelList.filter_map. The result is materialized back into a normal List
				|when the callback returns.
				|---
				|pure func parallel[T, U](
				|	self: List[T],
				|	body: pure (ParallelList[T]) -> ParallelList[U],
				|) -> List[U]:
				|	builtin("std/list.parallel")
				|
			Some(source)
		"std/log":
			source: String = raw
				|import:
				|	io: print_error
				|	time: format_time, now, to_iso
				|
				|
				|-- Log - Structured logging with configurable levels and formats
				|--
				|-- Provides a Logger record with level filtering, context fields,
				|-- and optional JSON output. All output goes to stderr.
				|--
				|-- Levels: Debug, Info, Warn, Error
				|--
				|-- Usage:
				|-- logger: Logger = logger()
				|-- log(logger, Info, "server started", [])
				|-- log(logger, Info, "request", [("method", "GET"), ("path", "/api")])
				|--
				|-- json_logger: Logger = with_json(logger())
				|-- log(json_logger, Warn, "slow query", [])
				|-- ============================================================================
				|-- Types
				|-- ============================================================================
				|enum LogLevel:
				|	Debug
				|	Info
				|	Warn
				|	Error
				|
				|
				|-- Logger stores pre-formatted context strings to avoid List RC issues
				|record Logger {
				|	level: LogLevel,
				|	context_text: String,
				|	context_json: String,
				|	json: Bool
				|}
				|
				|
				|-- ============================================================================
				|-- Logger Construction
				|-- ============================================================================
				|---
				|Create a new logger with INFO level, text format, no context fields.
				|
				|doctests:
				|    :: Default logger
				|    l: Logger = logger()
				|    l.level == Info
				|---
				|pure func logger() -> Logger:
				|	{
				|		level = Info,
				|		context_text = "",
				|		context_json = "",
				|		json = False
				|	}
				|
				|
				|---
				|Create a logger with a specific level.
				|
				|doctests:
				|    :: Set debug level
				|    l: Logger = with_level(logger(), Debug)
				|    l.level == Debug
				|---
				|pure func with_level(logger: Logger, level: LogLevel) -> Logger:
				|	{
				|		level = level,
				|		context_text = logger.context_text,
				|		context_json = logger.context_json,
				|		json = logger.json
				|	}
				|
				|
				|---
				|Enable JSON output format.
				|
				|doctests:
				|    :: Enable JSON
				|    l: Logger = with_json(logger())
				|    l.json == True
				|---
				|pure func with_json(logger: Logger) -> Logger:
				|	{
				|		level = logger.level,
				|		context_text = logger.context_text,
				|		context_json = logger.context_json,
				|		json = True
				|	}
				|
				|
				|---
				|Add persistent context fields to the logger.
				|These fields are included in every log message.
				|
				|doctests:
				|    :: Add context field
				|    l: Logger = with_fields(logger(), [("service", "api")])
				|    l.context_text.length() > 0
				|---
				|pure func with_fields(logger: Logger, fields: List[(String, String)]) -> Logger:
				|	both: (String, String) = build_both_fields(fields)
				|	new_text: String = merge_text_fields(logger.context_text, both[0])
				|	new_json: String = merge_json_fields(logger.context_json, both[1])
				|	{
				|		level = logger.level,
				|		context_text = new_text,
				|		context_json = new_json,
				|		json = logger.json
				|	}
				|
				|
				|-- ============================================================================
				|-- Logging Functions
				|-- ============================================================================
				|---
				|Log a message at the supplied level with structured fields.
				|---
				|func log(
				|	logger: Logger,
				|	level: LogLevel,
				|	msg: String,
				|	fields: List[(String, String)],
				|) -> Void:
				|	write_log(logger, level, msg, fields)
				|
				|
				|-- ============================================================================
				|-- Formatting (pure, for testing)
				|-- ============================================================================
				|---
				|Format a log entry as text.
				|
				|doctests:
				|    :: Simple text format
				|    format_text(Info, "hello", []) == "INFO  hello"
				|
				|    :: Text with fields
				|    format_text(Warn, "slow", [("ms", "500")]) == "WARN  slow  ms=500"
				|---
				|pure func format_text(level: LogLevel, msg: String, fields: List[(String, String)]) -> String:
				|	base: String = level_name(level) + "  " + msg
				|	extra: String = build_fields_text(fields)
				|
				|	if extra.length() == 0:
				|		base
				|	else:
				|		base + "  " + extra
				|
				|
				|---
				|Format a log entry as JSON.
				|
				|doctests:
				|    :: Simple JSON format
				|    result: String = format_json(Info, "hello", [])
				|    result == "{\"level\":\"INFO\",\"msg\":\"hello\"}"
				|---
				|pure func format_json(level: LogLevel, msg: String, fields: List[(String, String)]) -> String:
				|	base: String = "{\"level\":\"" + escape_json_str(
				|		level_name(level),
				|	) + "\",\"msg\":\"" + escape_json_str(msg) + "\""
				|	extra: String = build_fields_json(fields)
				|
				|	if extra.length() == 0:
				|		base + "}"
				|	else:
				|		base + "," + extra + "}"
				|
				|
				|-- ============================================================================
				|-- Internal
				|-- ============================================================================
				|private func write_log(
				|	logger: Logger,
				|	level: LogLevel,
				|	msg: String,
				|	extra_fields: List[(String, String)],
				|) -> Void:
				|	if level_rank(level) >= level_rank(logger.level):
				|		level_str: String = level_name(level)
				|		both: (String, String) = build_both_fields(extra_fields)
				|
				|		if logger.json:
				|			ts: String = now().to_iso()
				|			all_json: String = merge_json_fields(logger.context_json, both[1])
				|			base: String = "{\"time\":\"" + ts + "\",\"level\":\"" + level_str + "\",\"msg\":\"" + escape_json_str(
				|				msg,
				|			) + "\""
				|
				|			line: String = if all_json.length() == 0:
				|				base + "}"
				|			else:
				|				base + "," + all_json + "}"
				|
				|			print_error(line)
				|		else:
				|			ts: String = now().format_time("%Y-%m-%d %H:%M:%S")
				|			all_text: String = merge_text_fields(logger.context_text, both[0])
				|			base: String = "[" + ts + "] " + level_str + "  " + msg
				|
				|			line: String = if all_text.length() == 0:
				|				base
				|			else:
				|				base + "  " + all_text
				|
				|			print_error(line)
				|
				|
				|private pure func level_rank(level: LogLevel) -> Int:
				|	match level:
				|		Debug:
				|			0
				|		Info:
				|			1
				|		Warn:
				|			2
				|		Error:
				|			3
				|
				|
				|private pure func level_name(level: LogLevel) -> String:
				|	match level:
				|		Debug:
				|			"DEBUG"
				|		Info:
				|			"INFO"
				|		Warn:
				|			"WARN"
				|		Error:
				|			"ERROR"
				|
				|
				|private pure func merge_text_fields(a: String, b: String) -> String:
				|	if a.length() == 0:
				|		b
				|	else if b.length() == 0:
				|		a
				|	else:
				|		a + " " + b
				|
				|
				|private pure func merge_json_fields(a: String, b: String) -> String:
				|	if a.length() == 0:
				|		b
				|	else if b.length() == 0:
				|		a
				|	else:
				|		a + "," + b
				|
				|
				|private pure func build_both_fields(fields: List[(String, String)]) -> (String, String):
				|	var text_result: String = ""
				|	var json_result: String = ""
				|	var remaining: List[(String, String)] = fields
				|	var done: Bool = False
				|
				|	while not done:
				|		match remaining:
				|			[]:
				|				done = True
				|			[(k, v), ...rest]:
				|				text_result = if text_result.length() == 0:
				|					k + "=" + v
				|				else:
				|					text_result + " " + k + "=" + v
				|
				|				entry: String = "\"" + escape_json_str(k) + "\":\"" + escape_json_str(v) + "\""
				|
				|				json_result = if json_result.length() == 0:
				|					entry
				|				else:
				|					json_result + "," + entry
				|
				|				remaining = rest
				|			_:
				|				done = True
				|
				|	(text_result, json_result)
				|
				|
				|private pure func build_fields_text(fields: List[(String, String)]) -> String:
				|	var result: String = ""
				|	var remaining: List[(String, String)] = fields
				|	var done: Bool = False
				|
				|	while not done:
				|		match remaining:
				|			[]:
				|				done = True
				|			[(k, v), ...rest]:
				|				result = if result.length() == 0:
				|					k + "=" + v
				|				else:
				|					result + " " + k + "=" + v
				|
				|				remaining = rest
				|			_:
				|				done = True
				|
				|	result
				|
				|
				|private pure func build_fields_json(fields: List[(String, String)]) -> String:
				|	var result: String = ""
				|	var remaining: List[(String, String)] = fields
				|	var done: Bool = False
				|
				|	while not done:
				|		match remaining:
				|			[]:
				|				done = True
				|			[(k, v), ...rest]:
				|				entry: String = "\"" + escape_json_str(k) + "\":\"" + escape_json_str(v) + "\""
				|
				|				result = if result.length() == 0:
				|					entry
				|				else:
				|					result + "," + entry
				|
				|				remaining = rest
				|			_:
				|				done = True
				|
				|	result
				|
				|
				|private pure func escape_json_str(s: String) -> String:
				|	escape_loop(s, 0, "")
				|
				|
				|private @tail_recursive pure func escape_loop(s: String, i: Int, acc: String) -> String:
				|	if i >= s.length():
				|		acc
				|	else:
				|		ch: String = s.substring(i, 1)
				|
				|		if ch == "\"":
				|			escape_loop(s, i + 1, acc + "\\\"")
				|		else if ch == "\\":
				|			escape_loop(s, i + 1, acc + "\\\\")
				|		else if ch == "\n":
				|			escape_loop(s, i + 1, acc + "\\n")
				|		else if ch == "\t":
				|			escape_loop(s, i + 1, acc + "\\t")
				|		else if ch == "\r":
				|			escape_loop(s, i + 1, acc + "\\r")
				|		else:
				|			escape_loop(s, i + 1, acc + ch)
				|
			Some(source)
		"std/math":
			source: String = raw
				|-- Math - mathematical constants and cross-type math helpers.
				|-- Mathematical constants
				|PI: Float = 3.141592653589793
				|
				|E: Float = 2.718281828459045
				|
				|TAU: Float = 6.283185307179586
				|
				|PHI: Float = 1.618033988749895
				|
				|
				|-- Checked arithmetic error type.
				|--
				|-- Integer checked arithmetic helpers live in std/int.brp. This error type
				|-- stays here for now because divide_checked_float still belongs to math until
				|-- the float API cleanup happens.
				|union MathError:
				|	DivByZero
				|	Overflow
				|	Underflow
				|
				|
				|---
				|Safe float division that returns Result instead of 0.0 on divide-by-zero.
				|
				|doctests:
				|    :: Float division success
				|    match divide_checked_float(10.0, 2.0):
				|        Ok(v):
				|            v > 4.9
				|        Err(_):
				|            False
				|
				|    :: Float division by zero returns error
				|    match divide_checked_float(10.0, 0.0):
				|        Ok(_):
				|            False
				|        Err(DivByZero):
				|            True
				|        Err(_):
				|            False
				|---
				|pure func divide_checked_float(a: Float, b: Float) -> Result[Float, MathError]:
				|	if b == 0.0:
				|		Err(DivByZero)
				|	else:
				|		Ok(a / b)
				|
			Some(source)
		"std/matrix":
			source: String = raw
				|import:
				|	tensor: length, matrix, vector
				|	traits: one, zero
				|
				|
				|type ParallelMatrix[T, #M, #N] = builtin
				|
				|
				|-- Matrix - 2D array operations
				|--
				|-- This module provides 2D-specific operations: multiply, transpose,
				|-- square-matrix helpers, row/column counts, row/column access, and cell access.
				|-- For generic tensor ops (length, first-dimension get, set_index), see tensor.
				|-- ============================================================================
				|-- Scoped Parallel Pipelines
				|-- ============================================================================
				|---
				|Run a parallel matrix pipeline.
				|
				|The callback receives a ParallelMatrix[T, #M, #N], which intentionally exposes
				|only shape-preserving parallel combinators. The result is materialized back into
				|a normal fixed-size matrix when the callback returns.
				|---
				|pure func parallel[T, U, #M, #N](
				|	self: T[#M, #N],
				|	body: pure (ParallelMatrix[T, #M, #N]) -> ParallelMatrix[U, #M, #N],
				|) -> U[#M, #N]:
				|	builtin("std/matrix.parallel")
				|
				|
				|-- ============================================================================
				|-- Cell Updates
				|-- ============================================================================
				|---
				|Set cell at (row, col), returning unchanged matrix if out of bounds.
				|---
				|pure func set_cell[T, #M, #N](m: T[#M, #N], row: Int, col: Int, val: T) -> T[#M, #N]:
				|	builtin("std/matrix.set_cell")
				|
				|
				|-- ============================================================================
				|-- Matrix Operations (special-case codegen)
				|-- ============================================================================
				|---
				|Linear algebra matrix multiplication: C[M,N] = A[M,K] * B[K,N].
				|K dimension must match (validated at compile time).
				|---
				|pure func multiply[T:Numeric, #M, #K, #N](a: T[#M, #K], b: T[#K, #N]) -> T[#M, #N]:
				|	builtin("std/matrix.multiply")
				|
				|
				|---
				|Matrix transpose: swap rows and columns.
				|---
				|pure func transpose[T, #M, #N](m: T[#M, #N]) -> T[#N, #M]:
				|	builtin("std/matrix.transpose")
				|
				|
				|---
				|Matrix-vector multiply: y[i] = sum_j(W[i,j] * x[j]).
				|W is [M, N], x is [N], result is [M].
				|---
				|pure func multiply_vector[T:Numeric, #M, #N](w: T[#M, #N], x: T[#N]) -> T[#M]:
				|	builtin("std/matrix.multiply_vector")
				|
				|
				|---
				|Outer product: result[i,j] = a[i] * b[j].
				|a is [M], b is [N], result is [M, N].
				|---
				|pure func outer[T:Numeric, #M, #N](a: T[#M], b: T[#N]) -> T[#M, #N]:
				|	builtin("std/matrix.outer")
				|
				|
				|---
				|Transposed matrix-vector multiply: y[j] = sum_i(W[i,j] * x[i]) = W^T * x.
				|W is [M, N], x is [M], result is [N].
				|Computes the transpose multiply without allocating a transposed matrix.
				|Useful for backpropagation: dx = multiply_transposed_vector(w, dy).
				|---
				|pure func multiply_transposed_vector[T:Numeric, #M, #N](w: T[#M, #N], x: T[#M]) -> T[#N]:
				|	builtin("std/matrix.multiply_transposed_vector")
				|
				|
				|-- ============================================================================
				|-- Shape
				|-- ============================================================================
				|---
				|Number of rows in a matrix.
				|---
				|pure func row_count[T, #M, #N](m: T[#M, #N]) -> #M:
				|	length(m)
				|
				|
				|---
				|Number of columns in a matrix.
				|---
				|pure func column_count[T, #M, #N](m: T[#M, #N]) -> #N:
				|	length(m[0])
				|
				|
				|-- ============================================================================
				|-- Higher-Order Functions
				|-- ============================================================================
				|---
				|Map matrix cells in row-major order, preserving the exact matrix shape.
				|---
				|func map[T, U, #M, #N](
				|	self: T[#M, #N],
				|	f: (T) -> U,
				|) -> U[#M, #N]:
				|pure func map[T, U, #M, #N](
				|	self: T[#M, #N],
				|	f: pure (T) -> U,
				|) -> U[#M, #N]:
				|	builtin("blorp_matrix_map")
				|
				|
				|---
				|Map matrix cells with row and column indices, preserving the exact matrix shape.
				|---
				|func map_indexed[T, U, #M, #N](
				|	self: T[#M, #N],
				|	f: (..#M, ..#N, T) -> U,
				|) -> U[#M, #N]:
				|pure func map_indexed[T, U, #M, #N](
				|	self: T[#M, #N],
				|	f: pure (..#M, ..#N, T) -> U,
				|) -> U[#M, #N]:
				|	builtin("blorp_matrix_map_indexed")
				|
				|
				|---
				|Combine two same-shaped matrices cell-by-cell, preserving the exact shape.
				|---
				|func zip_map[A, B, C, #M, #N](
				|	self: A[#M, #N],
				|	other: B[#M, #N],
				|	f: (A, B) -> C,
				|) -> C[#M, #N]:
				|pure func zip_map[A, B, C, #M, #N](
				|	self: A[#M, #N],
				|	other: B[#M, #N],
				|	f: pure (A, B) -> C,
				|) -> C[#M, #N]:
				|	builtin("blorp_matrix_zip_map")
				|
				|
				|---
				|Fold matrix cells in row-major order.
				|---
				|func fold[T, Acc, #M, #N](
				|	self: T[#M, #N],
				|	init: Acc,
				|	f: (Acc, T) -> Acc,
				|) -> Acc:
				|pure func fold[T, Acc, #M, #N](
				|	self: T[#M, #N],
				|	init: Acc,
				|	f: pure (Acc, T) -> Acc,
				|) -> Acc:
				|	var result: Acc = init
				|
				|	for row in 0..length(self):
				|		values: T[#N] = self[row]
				|
				|		for col in 0..length(values):
				|			result = f(result, values[col])
				|
				|	result
				|
				|
				|---
				|Check whether all matrix cells satisfy a predicate.
				|---
				|func all[T, #M, #N](
				|	self: T[#M, #N],
				|	pred: (T) -> Bool,
				|) -> Bool:
				|pure func all[T, #M, #N](
				|	self: T[#M, #N],
				|	pred: pure (T) -> Bool,
				|) -> Bool:
				|	var result: Bool = True
				|
				|	for row in 0..length(self):
				|		values: T[#N] = self[row]
				|
				|		for col in 0..length(values):
				|			if not pred(values[col]):
				|				result = False
				|				break
				|
				|		if not result:
				|			break
				|
				|	result
				|
				|
				|---
				|Check whether any matrix cell satisfies a predicate.
				|---
				|func any[T, #M, #N](
				|	self: T[#M, #N],
				|	pred: (T) -> Bool,
				|) -> Bool:
				|pure func any[T, #M, #N](
				|	self: T[#M, #N],
				|	pred: pure (T) -> Bool,
				|) -> Bool:
				|	var result: Bool = False
				|
				|	for row in 0..length(self):
				|		values: T[#N] = self[row]
				|
				|		for col in 0..length(values):
				|			if pred(values[col]):
				|				result = True
				|				break
				|
				|		if result:
				|			break
				|
				|	result
				|
				|
				|---
				|Sum all matrix cells in row-major order.
				|---
				|pure func sum[T:Addable+HasZero, #M, #N](self: T[#M, #N]) -> T:
				|	var result: T = zero()
				|
				|	for row in 0..length(self):
				|		values: T[#N] = self[row]
				|
				|		for col in 0..length(values):
				|			result += values[col]
				|
				|	result
				|
				|
				|---
				|Product of all matrix cells in row-major order.
				|---
				|pure func product[T:Multipliable+HasOne, #M, #N](self: T[#M, #N]) -> T:
				|	var result: T = one()
				|
				|	for row in 0..length(self):
				|		values: T[#N] = self[row]
				|
				|		for col in 0..length(values):
				|			result *= values[col]
				|
				|	result
				|
				|
				|---
				|Maximum matrix cell in row-major order.
				|---
				|pure func max[T:Orderable, #M, #N](self: T[#M, #N]) -> T:
				|	var result: T = self[0, 0]
				|
				|	for row in 0..length(self):
				|		values: T[#N] = self[row]
				|
				|		for col in 0..length(values):
				|			value: T = values[col]
				|
				|			if value > result:
				|				result = value
				|
				|	result
				|
				|
				|---
				|Minimum matrix cell in row-major order.
				|---
				|pure func min[T:Orderable, #M, #N](self: T[#M, #N]) -> T:
				|	var result: T = self[0, 0]
				|
				|	for row in 0..length(self):
				|		values: T[#N] = self[row]
				|
				|		for col in 0..length(values):
				|			value: T = values[col]
				|
				|			if value < result:
				|				result = value
				|
				|	result
				|
				|
				|---
				|Row and column index of the maximum matrix cell. Ties keep the first row-major match.
				|---
				|pure func argmax[T:Orderable, #M, #N](self: T[#M, #N]) -> (..#M, ..#N):
				|	var best_row: ..#M = 0
				|	var best_col: ..#N = 0
				|	var best_value: T = self[0, 0]
				|
				|	for row in 0..length(self):
				|		values: T[#N] = self[row]
				|
				|		for col in 0..length(values):
				|			value: T = values[col]
				|
				|			if value > best_value:
				|				best_value = value
				|				best_row = row
				|				best_col = col
				|
				|	(best_row, best_col)
				|
				|
				|---
				|Row and column index of the minimum matrix cell. Ties keep the first row-major match.
				|---
				|pure func argmin[T:Orderable, #M, #N](self: T[#M, #N]) -> (..#M, ..#N):
				|	var best_row: ..#M = 0
				|	var best_col: ..#N = 0
				|	var best_value: T = self[0, 0]
				|
				|	for row in 0..length(self):
				|		values: T[#N] = self[row]
				|
				|		for col in 0..length(values):
				|			value: T = values[col]
				|
				|			if value < best_value:
				|				best_value = value
				|				best_row = row
				|				best_col = col
				|
				|	(best_row, best_col)
				|
				|
				|---
				|Mean of all matrix cells in row-major order.
				|---
				|pure func mean[T:Addable+HasZero+ToFloat, #M, #N](self: T[#M, #N]) -> Float:
				|	var total: T = zero()
				|	var count: Int = 0
				|
				|	for row in 0..length(self):
				|		values: T[#N] = self[row]
				|
				|		for col in 0..length(values):
				|			total += values[col]
				|			count += 1
				|
				|	to_float(total) / to_float(count)
				|
				|
				|-- ============================================================================
				|-- Shape Conversion
				|-- ============================================================================
				|---
				|Flatten a matrix into a fixed-size vector in row-major order.
				|---
				|pure func to_row_major_vector[T, #M, #N](self: T[#M, #N]) -> T[#M * #N]:
				|	first_row: T[#N] = self[0]
				|	var result: T[#M * #N] = vector(first_row[0], length(self) * length(first_row))
				|
				|	for row in 0..length(self):
				|		values: T[#N] = self[row]
				|
				|		for col in 0..length(values):
				|			result[row * length(values) + col] = values[col]
				|
				|	result
				|
				|
				|---
				|Build a matrix from a row-major fixed-size vector.
				|---
				|pure func from_row_major_vector[T, #M, #N](values: T[#M * #N], rows: #M, columns: #N) -> T[#M, #N]:
				|	first: T = values[0]
				|	var result: T[#M, #N] = matrix(first, rows, columns)
				|
				|	for row in 0..length(result):
				|		for col in 0..columns:
				|			result[row, col] = checked_get(values, row * columns + col)
				|
				|	result
				|
				|
				|-- ============================================================================
				|-- Square Matrix Helpers
				|-- ============================================================================
				|---
				|Create an identity matrix with `one()` on the main diagonal and `zero()` elsewhere.
				|---
				|pure func identity[T:HasOne+HasZero, #N](size: #N) -> T[#N, #N]:
				|	var result: T[#N, #N] = matrix(zero(), size, size)
				|
				|	for i in 0..length(result):
				|		result = set_cell(result, i, i, one())
				|
				|	result
				|
				|
				|---
				|Extract the main diagonal from a square matrix.
				|---
				|pure func diagonal[T, #N](m: T[#N, #N]) -> T[#N]:
				|	var result: T[#N] = vector(m[0, 0], length(m))
				|
				|	for i in 0..length(m):
				|		result[i] = m[i, i]
				|
				|	result
				|
				|
				|---
				|Sum the main diagonal of a square matrix.
				|---
				|pure func trace[T:Addable+HasZero, #N](m: T[#N, #N]) -> T:
				|	var total: T = zero()
				|
				|	for i in 0..length(m):
				|		total += m[i, i]
				|
				|	total
				|
				|
				|---
				|Replace the main diagonal of a square matrix.
				|---
				|pure func set_diagonal[T, #N](m: T[#N, #N], values: T[#N]) -> T[#N, #N]:
				|	var result: T[#N, #N] = m
				|
				|	for i in 0..length(values):
				|		result = set_cell(result, i, i, values[i])
				|
				|	result
				|
				|
				|-- ============================================================================
				|-- 2D Element Access (runtime bounds-checked)
				|-- ============================================================================
				|---
				|Get cell at (row, col), returning None if out of bounds.
				|---
				|pure func get[T, #M, #N](m: T[#M, #N], row: Int, col: Int) -> Option[T]:
				|	builtin("std/matrix.get")
				|
				|
				|---
				|Get cell at (row, col), returning default if out of bounds.
				|---
				|pure func get_or[T, #M, #N](m: T[#M, #N], row: Int, col: Int, default: T) -> T:
				|	match get(m, row, col):
				|		Some(v):
				|			v
				|		None:
				|			default
				|
				|
				|---
				|Get row at index, returning None if out of bounds.
				|---
				|pure func get_row[T, #M, #N](m: T[#M, #N], row: Int) -> Option[T[#N]]:
				|	if row >= 0 and row < length(m):
				|		Some(m[row])
				|	else:
				|		None
				|
				|
				|---
				|Get row at index, returning default if out of bounds.
				|---
				|pure func get_row_or[T, #M, #N](m: T[#M, #N], row: Int, default: T[#N]) -> T[#N]:
				|	match get_row(m, row):
				|		Some(v):
				|			v
				|		None:
				|			default
				|
				|
				|---
				|Get column at index, returning None if out of bounds.
				|---
				|pure func get_column[T, #M, #N](m: T[#M, #N], col: Int) -> Option[T[#M]]:
				|	if col >= 0 and col < column_count(m):
				|		first: T = get_or(m, 0, col, m[0, 0])
				|		Some(get_column_or(m, col, first))
				|	else:
				|		None
				|
				|
				|---
				|Get column at index, replacing out-of-bounds cells with default.
				|---
				|pure func get_column_or[T, #M, #N](m: T[#M, #N], col: Int, default: T) -> T[#M]:
				|	var result: T[#M] = vector(default, length(m))
				|
				|	for row in 0..result.length():
				|		result[row] = get_or(m, row, col, default)
				|
				|	result
				|
				|
				|---
				|Set a whole row, returning the unchanged matrix if the row is out of bounds.
				|---
				|pure func set_row[T, #M, #N](m: T[#M, #N], row: Int, values: T[#N]) -> T[#M, #N]:
				|	var result: T[#M, #N] = m
				|
				|	for col in 0..values.length():
				|		result = set_cell(result, row, col, values[col])
				|
				|	result
				|
				|
				|---
				|Set a whole column, returning the unchanged matrix if the column is out of bounds.
				|---
				|pure func set_column[T, #M, #N](m: T[#M, #N], col: Int, values: T[#M]) -> T[#M, #N]:
				|	var result: T[#M, #N] = m
				|
				|	for row in 0..values.length():
				|		result = set_cell(result, row, col, values[row])
				|
				|	result
				|
			Some(source)
		"std/memory":
			source: String = raw
				|-- blorp Memory Reporting Framework
				|--
				|-- Provides utilities for tracking and reporting memory usage.
				|--
				|-- Use `print_mem_stats`, `measure_memory`, and `format_bytes` while
				|-- debugging allocation behavior.
				|-- ============================================================================
				|-- Core Types and Builtins
				|-- ============================================================================
				|-- Memory statistics record tracks allocation patterns
				|record MemStats {
				|	total_allocations: Int,
				|	total_releases: Int,
				|	current_objects: Int,
				|	bytes_allocated: Int
				|}
				|
				|
				|-- Get current memory statistics.
				|-- The returned MemStats object is not counted in the snapshot, so a reset
				|-- followed by get_mem_stats() reports zero live objects unless user code
				|-- has allocated something.
				|pure func get_mem_stats() -> MemStats:
				|	builtin("blorp_get_mem_stats")
				|
				|
				|-- Reset memory statistics counters
				|func reset_mem_stats() -> Void:
				|	builtin("blorp_reset_mem_stats")
				|
				|
				|-- Print live object type buckets for the current memory-stats epoch.
				|-- This is intended for test harness diagnostics after `get_mem_stats()`
				|-- reports live objects. It does not allocate a Blorp String for the summary.
				|func print_live_object_summary() -> Void:
				|	builtin("blorp_print_live_object_summary")
				|
				|
				|-- Check if an object has unique ownership (refcount == 1)
				|-- Useful for verifying COW behavior. Stack types always return True.
				|pure func is_unique[T](obj: T) -> Bool:
				|	builtin("blorp_is_unique")
				|
				|
				|-- Get the current reference count. Heap objects return their ARC count,
				|-- stack types (Int, Bool, structs, etc.) return 0.
				|pure func refcount[T](obj: T) -> Int:
				|	builtin("blorp_refcount")
				|
				|
				|-- Get the allocated memory size in bytes. Heap objects return their
				|-- allocation size, stack types return their C sizeof.
				|pure func size_of[T](obj: T) -> Int:
				|	builtin("blorp_size_of")
				|
				|
				|-- ============================================================================
				|-- Utility Functions
				|-- ============================================================================
				|-- Format bytes with appropriate unit (B, KB, MB, GB)
				|private pure func round_to(x: Float, factor: Float) -> Float:
				|	to_float(to_int(x * factor)) / factor
				|
				|
				|pure func format_bytes(bytes: Int) -> String:
				|	bytes_f: Float = to_float(bytes)
				|
				|	match bytes < 1024:
				|		True:
				|			bytes.to_string() + " B"
				|		False:
				|			kb: Float = bytes_f / 1024.0
				|
				|			match kb < 1024.0:
				|				True:
				|					round_to(kb, 10.0).to_string() + " KB"
				|				False:
				|					mb: Float = kb / 1024.0
				|
				|					match mb < 1024.0:
				|						True:
				|							round_to(mb, 10.0).to_string() + " MB"
				|						False:
				|							gb: Float = mb / 1024.0
				|							round_to(gb, 100.0).to_string() + " GB"
				|
				|
				|-- Format memory stats as a readable string
				|pure func format_stats(stats: MemStats) -> String:
				|	"allocations: " + to_string(
				|		stats.total_allocations,
				|	) + ", releases: " + to_string(
				|		stats.total_releases,
				|	) + ", current: " + to_string(
				|		stats.current_objects,
				|	) + ", bytes: " + format_bytes(stats.bytes_allocated)
				|
				|
				|-- Print current memory statistics
				|func print_mem_stats() -> Void:
				|	stats: MemStats = get_mem_stats()
				|	print("=== Memory Stats ===")
				|	print("  Total allocations: " + stats.total_allocations.to_string())
				|	print("  Total releases:    " + stats.total_releases.to_string())
				|	print("  Current objects:   " + stats.current_objects.to_string())
				|	print("  Bytes allocated:   " + format_bytes(stats.bytes_allocated))
				|	print("====================")
				|
				|
				|-- Measure memory usage of a function
				|-- Resets stats before, runs the function, returns final stats
				|func measure_memory(f: () -> Void) -> MemStats:
				|	reset_mem_stats()
				|	f()
				|	get_mem_stats()
				|
				|
				|-- Get the delta in memory stats between two points
				|pure func mem_delta(before: MemStats, after: MemStats) -> MemStats:
				|	{
				|		total_allocations = after.total_allocations - before.total_allocations,
				|		total_releases = after.total_releases - before.total_releases,
				|		current_objects = after.current_objects - before.current_objects,
				|		bytes_allocated = after.bytes_allocated - before.bytes_allocated
				|	}
				|
				|
				|-- Check for memory leaks: returns true if objects are still live
				|pure func has_leaks(stats: MemStats) -> Bool:
				|	stats.current_objects > 0
				|
				|
				|-- Print memory report comparing before/after stats
				|func print_mem_report(label: String, before: MemStats, after: MemStats) -> Void:
				|	delta: MemStats = mem_delta(before, after)
				|	print("=== Memory Report: " + label + " ===")
				|	print("  New allocations: " + delta.total_allocations.to_string())
				|	print("  New releases:    " + delta.total_releases.to_string())
				|	print("  Net objects:     " + delta.current_objects.to_string())
				|	print("  Net bytes:       " + format_bytes(delta.bytes_allocated))
				|
				|	match has_leaks(delta):
				|		True:
				|			print("  WARNING: Potential memory leak detected!")
				|		False:
				|			print("  OK: All allocations released")
				|
				|	print("================================")
				|
			Some(source)
		"std/net/dns":
			source: String = raw
				|-- DNS - portable hostname resolution surface.
				|--
				|-- This first std shape intentionally exposes a compiler-owned operation rather
				|-- than a resolver handle. The current runtime implementation uses the platform
				|-- blocking resolver and returns copied address strings with typed DNS errors;
				|-- a future resolver service can replace the backend without making resolver
				|-- state ordinary data.
				|---
				|Typed DNS resolver error.
				|---
				|union DnsError:
				|	InvalidHost(String)
				|	LookupFailed(String)
				|
				|
				|---
				|Return a stable, human-readable description of a DNS error.
				|
				|doctests:
				|    :: Invalid host errors include detail
				|    message(InvalidHost("empty")) == "invalid host: empty"
				|
				|    :: Lookup errors include detail
				|    message(LookupFailed("no address")) == "lookup failed: no address"
				|---
				|pure func message(err: DnsError) -> String:
				|	match err:
				|		InvalidHost(detail):
				|			"invalid host: " + detail
				|		LookupFailed(detail):
				|			"lookup failed: " + detail
				|
				|
				|implements Stringable for DnsError:
				|	pure func to_string(err: DnsError) -> String:
				|		message(err)
				|
				|
				|---
				|Resolve a hostname to deduplicated IPv4 and IPv6 address strings.
				|
				|This function returns ordinary copied data, not a resolver resource. The current
				|runtime backend uses the platform blocking resolver; code that must avoid DNS in
				|a networking hot path should use numeric-host TCP/UDP operations instead.
				|
				|doctests:
				|    :: Resolve localhost
				|    match resolve("localhost"):
				|        Ok(ips):
				|            ips.length() > 0
				|        Err(_):
				|            True
				|---
				|func resolve(hostname: String) -> Result[List[String], DnsError]:
				|	builtin("blorp_dns_resolve_raw")
				|
			Some(source)
		"std/net/http":
			source: String = raw
				|import:
				|	bytes: bytes
				|
				|
				|-- HTTP - Pure HTTP/1.1 request/response parsing and formatting
				|--
				|-- All functions are pure — no I/O. Operates on Bytes buffers for
				|-- integration with TCP networking.
				|--
				|-- Supports:
				|-- - Parsing HTTP/1.1 requests (GET, POST, etc.)
				|-- - Formatting HTTP/1.1 responses
				|-- - Query string parsing
				|-- - Header lookup
				|-- ============================================================================
				|-- Types
				|-- ============================================================================
				|record Header {
				|	name: String,
				|	value: String
				|}
				|
				|
				|record Request {
				|	method: String,
				|	path: String,
				|	query: String,
				|	version: String,
				|	headers: List[Header],
				|	body: Bytes
				|}
				|
				|
				|record Response {
				|	status_code: Int,
				|	status_text: String,
				|	headers: List[Header],
				|	body: Bytes
				|}
				|
				|
				|-- ============================================================================
				|-- Request Parsing
				|-- ============================================================================
				|---
				|Parse an HTTP request from raw bytes.
				|Returns Err if the request is malformed.
				|---
				|pure func parse_request(raw: Bytes) -> Result[Request, String]:
				|	raw_str: String = raw.to_string()
				|
				|	-- Find header/body separator
				|	sep_idx: Int = raw_str.raw_index_of("\r\n\r\n")
				|
				|	if sep_idx == -1:
				|		Err("malformed request: missing header terminator")
				|	else:
				|		header_section: String = raw_str.substring(0, sep_idx)
				|		body_start: Int = sep_idx + 4
				|
				|		body_bytes: Bytes = if body_start < raw.length():
				|			raw.slice(body_start, raw.length() - body_start)
				|		else:
				|			bytes(0)
				|
				|		header_lines: List[String] = header_section.split("\r\n")
				|
				|		if header_lines.length() == 0:
				|			Err("malformed request: empty headers")
				|		else:
				|			match header_lines.get(0):
				|				Some(request_line):
				|					parse_request_inner(request_line, header_lines, body_bytes)
				|				None:
				|					Err("malformed request: no request line")
				|
				|
				|-- Helper to parse the request line and remaining headers
				|private pure func parse_request_inner(
				|	request_line: String,
				|	header_lines: List[String],
				|	body_bytes: Bytes,
				|) -> Result[Request, String]:
				|	parts: List[String] = request_line.split(" ")
				|
				|	match parts:
				|		[method, full_path, version, ...rest]:
				|			(path, query) = split_path_query(full_path)
				|			headers: List[Header] = parse_headers(header_lines, 1)
				|			Ok({
				|				method = method,
				|				path = path,
				|				query = query,
				|				version = version,
				|				headers = headers,
				|				body = body_bytes,
				|			})
				|		_:
				|			Err("malformed request line: " + request_line)
				|
				|
				|-- Split a path into (path, query_string)
				|private pure func split_path_query(full_path: String) -> (String, String):
				|	qidx: Int = full_path.raw_index_of("?")
				|
				|	if qidx == -1:
				|		empty_q: String = full_path.substring(0, 0)
				|		result: (String, String) = (full_path, empty_q)
				|		result
				|	else:
				|		path_part: String = full_path.substring(0, qidx)
				|		query_part: String = full_path.substring(qidx + 1, full_path.length() - qidx - 1)
				|		result: (String, String) = (path_part, query_part)
				|		result
				|
				|
				|-- Parse header lines starting from a given index
				|private pure func parse_headers(lines: List[String], start: Int) -> List[Header]:
				|	lines
				|		.drop(start)
				|		.filter_map(parse_header_line)
				|
				|
				|private pure func parse_header_line(line: String) -> Option[Header]:
				|	colon_idx: Int = line.raw_index_of(": ")
				|
				|	if colon_idx > 0:
				|		name: String = line.substring(0, colon_idx)
				|		value: String = line.substring(colon_idx + 2, line.length() - colon_idx - 2)
				|		Some({
				|			name = name,
				|			value = value,
				|		})
				|	else:
				|		None
				|
				|
				|-- ============================================================================
				|-- Query String Parsing
				|-- ============================================================================
				|---
				|Parse a URL query string into key-value pairs.
				|Example: "foo=bar&baz=qux" -> [("foo", "bar"), ("baz", "qux")]
				|---
				|pure func parse_query_string(query: String) -> List[(String, String)]:
				|	if query.length() == 0:
				|		[]
				|	else:
				|		query
				|			.split("&")
				|			.map(parse_query_string_part)
				|
				|
				|private pure func parse_query_string_part(part: String) -> (String, String):
				|	eq_idx: Int = part.raw_index_of("=")
				|
				|	if eq_idx > 0:
				|		key: String = part.substring(0, eq_idx)
				|		val: String = part.substring(eq_idx + 1, part.length() - eq_idx - 1)
				|		(key, val)
				|	else:
				|		empty_v: String = part.substring(0, 0)
				|		(part, empty_v)
				|
				|
				|-- ============================================================================
				|-- Response Formatting
				|-- ============================================================================
				|---
				|Format an HTTP response into bytes ready to send over TCP.
				|---
				|pure func format_response(resp: Response) -> Bytes:
				|	var s: String = "HTTP/1.1 " + resp.status_code.to_string() + " " + resp.status_text + "\r\n"
				|
				|	-- Add Content-Length header if body is non-empty
				|	body_len: Int = resp.body.length()
				|	has_content_length: Bool = header_exists(resp.headers, "Content-Length")
				|
				|	if body_len > 0 and not has_content_length:
				|		s = s + "Content-Length: " + body_len.to_string() + "\r\n"
				|
				|	-- Add Connection: close unless user specified otherwise
				|	if not header_exists(resp.headers, "Connection"):
				|		s += "Connection: close\r\n"
				|
				|	-- Add user headers
				|	s = format_headers_into(s, resp.headers, 0)
				|	s += "\r\n"
				|
				|	-- Combine header bytes + body bytes
				|	header_bytes: Bytes = s.to_bytes()
				|
				|	if body_len > 0:
				|		header_bytes.append(resp.body)
				|	else:
				|		header_bytes
				|
				|
				|-- Format headers into a string (recursive to avoid type erasure in match)
				|private pure func format_headers_into(s: String, headers: List[Header], i: Int) -> String:
				|	if i >= headers.length():
				|		s
				|	else:
				|		match headers.get(i):
				|			Some(h):
				|				hdr: Header = h
				|				format_headers_into(s + hdr.name + ": " + hdr.value + "\r\n", headers, i + 1)
				|			None:
				|				s
				|
				|
				|-- Check if a header name exists
				|private pure func header_exists(headers: List[Header], name: String) -> Bool:
				|	header_exists_at(headers, name, 0)
				|
				|
				|private pure func header_exists_at(headers: List[Header], name: String, i: Int) -> Bool:
				|	if i >= headers.length():
				|		False
				|	else:
				|		match headers.get(i):
				|			Some(h):
				|				hdr: Header = h
				|
				|				if hdr.name.equal_ignore_case(name):
				|					True
				|				else:
				|					header_exists_at(headers, name, i + 1)
				|			None:
				|				False
				|
				|
				|-- ============================================================================
				|-- Status Codes
				|-- ============================================================================
				|---
				|Get the standard status text for an HTTP status code.
				|---
				|pure func status_text(code: Int) -> String:
				|	match code:
				|		200:
				|			"OK"
				|		201:
				|			"Created"
				|		204:
				|			"No Content"
				|		301:
				|			"Moved Permanently"
				|		302:
				|			"Found"
				|		304:
				|			"Not Modified"
				|		400:
				|			"Bad Request"
				|		401:
				|			"Unauthorized"
				|		403:
				|			"Forbidden"
				|		404:
				|			"Not Found"
				|		405:
				|			"Method Not Allowed"
				|		408:
				|			"Request Timeout"
				|		500:
				|			"Internal Server Error"
				|		502:
				|			"Bad Gateway"
				|		503:
				|			"Service Unavailable"
				|		_:
				|			"Unknown"
				|
				|
				|-- ============================================================================
				|-- Convenience Constructors
				|-- ============================================================================
				|---
				|Create a 200 OK response with a text body.
				|---
				|pure func ok_text(body: String) -> Response:
				|	body_bytes: Bytes = body.to_bytes()
				|	{
				|		status_code = 200,
				|		status_text = "OK",
				|		headers = [
				|			{
				|				name = "Content-Type",
				|				value = "text/plain"
				|			},
				|		],
				|		body = body_bytes
				|	}
				|
				|
				|---
				|Create an error response with a status code and message.
				|---
				|pure func error_response(code: Int, msg: String) -> Response:
				|	body_bytes: Bytes = msg.to_bytes()
				|	{
				|		status_code = code,
				|		status_text = status_text(code),
				|		headers = [
				|			{
				|				name = "Content-Type",
				|				value = "text/plain"
				|			},
				|		],
				|		body = body_bytes
				|	}
				|
				|
				|-- ============================================================================
				|-- Header Utilities
				|-- ============================================================================
				|---
				|Look up a header value by name (case-insensitive).
				|---
				|pure func get_header(headers: List[Header], name: String) -> Option[String]:
				|	get_header_at(headers, name, 0)
				|
				|
				|private pure func get_header_at(headers: List[Header], name: String, i: Int) -> Option[String]:
				|	if i >= headers.length():
				|		None
				|	else:
				|		match headers.get(i):
				|			Some(h):
				|				hdr: Header = h
				|
				|				if hdr.name.equal_ignore_case(name):
				|					Some(hdr.value)
				|				else:
				|					get_header_at(headers, name, i + 1)
				|			None:
				|				None
				|
			Some(source)
		"std/net/mime":
			source: String = raw
				|-- MIME Types - Common MIME type lookups
				|--
				|-- Maps file extensions to MIME types and vice versa.
				|-- All functions are pure.
				|-- ============================================================================
				|-- Extension → MIME Type
				|-- ============================================================================
				|---
				|Get the MIME type for a file extension (without dot).
				|Returns "application/octet-stream" for unknown extensions.
				|
				|doctests:
				|    :: HTML extension
				|    from_extension("html") == "text/html"
				|
				|    :: JSON extension
				|    from_extension("json") == "application/json"
				|
				|    :: Unknown extension
				|    from_extension("xyz") == "application/octet-stream"
				|
				|    :: Case insensitive
				|    from_extension("HTML") == "text/html"
				|---
				|pure func from_extension(ext: String) -> String:
				|	e: String = ext.lower()
				|
				|	if e == "html" or e == "htm":
				|		"text/html"
				|	else if e == "css":
				|		"text/css"
				|	else if e == "js" or e == "mjs":
				|		"text/javascript"
				|	else if e == "json":
				|		"application/json"
				|	else if e == "xml":
				|		"application/xml"
				|	else if e == "txt":
				|		"text/plain"
				|	else if e == "csv":
				|		"text/csv"
				|	else if e == "md":
				|		"text/markdown"
				|	else if e == "yaml" or e == "yml":
				|		"text/yaml"
				|	else if e == "toml":
				|		"application/toml"
				|	else:
				|		from_extension_media(e)
				|
				|
				|private pure func from_extension_media(e: String) -> String:
				|	if e == "png":
				|		"image/png"
				|	else if e == "jpg" or e == "jpeg":
				|		"image/jpeg"
				|	else if e == "gif":
				|		"image/gif"
				|	else if e == "svg":
				|		"image/svg+xml"
				|	else if e == "ico":
				|		"image/x-icon"
				|	else if e == "webp":
				|		"image/webp"
				|	else if e == "avif":
				|		"image/avif"
				|	else if e == "bmp":
				|		"image/bmp"
				|	else if e == "mp3":
				|		"audio/mpeg"
				|	else if e == "wav":
				|		"audio/wav"
				|	else if e == "ogg":
				|		"audio/ogg"
				|	else if e == "flac":
				|		"audio/flac"
				|	else if e == "mp4":
				|		"video/mp4"
				|	else if e == "webm":
				|		"video/webm"
				|	else if e == "avi":
				|		"video/x-msvideo"
				|	else if e == "mov":
				|		"video/quicktime"
				|	else:
				|		from_extension_app(e)
				|
				|
				|private pure func from_extension_app(e: String) -> String:
				|	if e == "pdf":
				|		"application/pdf"
				|	else if e == "zip":
				|		"application/zip"
				|	else if e == "gz" or e == "gzip":
				|		"application/gzip"
				|	else if e == "tar":
				|		"application/x-tar"
				|	else if e == "wasm":
				|		"application/wasm"
				|	else if e == "woff":
				|		"font/woff"
				|	else if e == "woff2":
				|		"font/woff2"
				|	else if e == "ttf":
				|		"font/ttf"
				|	else:
				|		"application/octet-stream"
				|
				|
				|-- ============================================================================
				|-- MIME Type → Extension
				|-- ============================================================================
				|---
				|Get a file extension for a MIME type.
				|Returns None for unrecognized MIME types.
				|
				|doctests:
				|    :: HTML type
				|    match to_extension("text/html"):
				|        Some(e):
				|            e == "html"
				|        None:
				|            False
				|
				|    :: Unknown type
				|    match to_extension("application/x-custom"):
				|        Some(_):
				|            False
				|        None:
				|            True
				|---
				|pure func to_extension(mime: String) -> Option[String]:
				|	if mime == "text/html":
				|		Some("html")
				|	else if mime == "text/css":
				|		Some("css")
				|	else if mime == "text/javascript":
				|		Some("js")
				|	else if mime == "application/json":
				|		Some("json")
				|	else if mime == "application/xml":
				|		Some("xml")
				|	else if mime == "text/plain":
				|		Some("txt")
				|	else if mime == "text/csv":
				|		Some("csv")
				|	else if mime == "image/png":
				|		Some("png")
				|	else if mime == "image/jpeg":
				|		Some("jpg")
				|	else if mime == "image/gif":
				|		Some("gif")
				|	else if mime == "image/svg+xml":
				|		Some("svg")
				|	else if mime == "audio/mpeg":
				|		Some("mp3")
				|	else if mime == "video/mp4":
				|		Some("mp4")
				|	else if mime == "application/pdf":
				|		Some("pdf")
				|	else if mime == "application/zip":
				|		Some("zip")
				|	else if mime == "application/gzip":
				|		Some("gz")
				|	else if mime == "application/wasm":
				|		Some("wasm")
				|	else:
				|		None
				|
				|
				|-- ============================================================================
				|-- Utilities
				|-- ============================================================================
				|---
				|Check if a MIME type is a text type.
				|---
				|pure func is_text(mime: String) -> Bool:
				|	(
				|		mime.starts_with("text/")
				|		or mime == "application/json"
				|		or mime == "application/xml"
				|		or mime == "application/javascript"
				|	)
				|
			Some(source)
		"std/net/tcp":
			source: String = raw
				|-- TCP Networking - scoped socket resources.
				|--
				|-- TcpListener and TcpStream are external capabilities. Acquire them with a
				|-- scoped `with` binding so the compiler installs deterministic cleanup. TCP
				|-- endpoints are explicit typed values: use `Port` to represent concrete remote
				|-- ports, `listen_*_any_port` when the OS should choose an ephemeral listener
				|-- port, `IpAddress` for numeric addresses, and `DnsName` when hostname
				|-- resolution is intended. Hostname resolution still uses blocking DNS;
				|-- validated numeric addresses avoid that resolver path.
				|import:
				|	stream: FallibleStream, ResourceSource
				|
				|
				|---
				|Opaque resource for a listening TCP socket.
				|---
				|resource type TcpListener = builtin("blorp_tcp_close_listener")
				|
				|
				|---
				|Opaque resource for a connected TCP socket.
				|---
				|resource type TcpStream = builtin("blorp_tcp_close_stream")
				|
				|
				|---
				|IP protocol family.
				|---
				|enum IpFamily:
				|	IPv4
				|	IPv6
				|
				|
				|---
				|Validated IP address text.
				|
				|`IpAddress` is a nominal builtin type, not a `String` alias. Construct it with
				|`ipv4(...)` or `parse_ip(...)` so invalid IP text cannot flow into typed TCP
				|APIs as an already-validated address.
				|---
				|type IpAddress = builtin
				|
				|
				|---
				|Validated DNS name text.
				|
				|`DnsName` keeps hostname resolution explicit. Use `dns_name(...)` before
				|connecting by name, and use `ipv4(...)` or `parse_ip(...)` for IP literals.
				|---
				|type DnsName = builtin
				|
				|
				|---
				|Validated IPv6 interface scope or zone identifier.
				|
				|Scopes are OS-specific text, for example an interface name or numeric zone. The
				|constructor rejects only empty, NUL-containing, and oversized values so the API
				|does not rule out legal platform forms.
				|---
				|type InterfaceScope = builtin
				|
				|
				|---
				|Validated remote TCP port.
				|
				|`Port` represents concrete ports 1 through 65535. Binding to an OS-assigned
				|ephemeral port is represented by `listen_*_any_port` APIs, not by passing magic
				|port 0.
				|---
				|type Port = builtin
				|
				|
				|---
				|Private finalizer trait implemented by scoped TCP resources.
				|
				|`with` blocks use compiler-owned cleanup builtins directly. This trait keeps the
				|runtime finalizers documented inside the module without exporting a manual
				|`close` operation that could conflict with scoped cleanup ownership.
				|---
				|private trait TcpClosable:
				|	func close(handle: Self) -> Void
				|
				|
				|implements TcpClosable for TcpListener:
				|	func close(listener: TcpListener) -> Void:
				|		builtin("blorp_tcp_close_listener")
				|
				|
				|implements TcpClosable for TcpStream:
				|	func close(stream: TcpStream) -> Void:
				|		builtin("blorp_tcp_close_stream")
				|
				|
				|---
				|Typed error surface for TCP APIs.
				|
				|The current runtime still reports most TCP failures as strings. The resource
				|bridge classifies explicit Blorp-side precondition failures as `InvalidInput`
				|and preserves lower-level runtime details as `Other` until the runtime exposes
				|stable TCP error classes directly.
				|---
				|union TcpError:
				|	InvalidInput(String)
				|	TimedOut(String)
				|	Closed(String)
				|	Busy(String)
				|	Dns(String)
				|	ConnectionFailed(String)
				|	Interrupted(String)
				|	Unsupported(String)
				|	Other(String)
				|
				|
				|---
				|Return a stable, human-readable description of a TCP error.
				|
				|doctests:
				|    :: Invalid input includes detail
				|    message(InvalidInput("bad port")) == "invalid input: bad port"
				|
				|    :: Runtime compatibility errors preserve detail
				|    message(Other("tcp read: timed out")) == "tcp error: tcp read: timed out"
				|---
				|pure func message(err: TcpError) -> String:
				|	match err:
				|		InvalidInput(detail):
				|			"invalid input: " + detail
				|		TimedOut(detail):
				|			"timed out: " + detail
				|		Closed(detail):
				|			"closed: " + detail
				|		Busy(detail):
				|			"busy: " + detail
				|		Dns(detail):
				|			"dns error: " + detail
				|		ConnectionFailed(detail):
				|			"connection failed: " + detail
				|		Interrupted(detail):
				|			"interrupted: " + detail
				|		Unsupported(detail):
				|			"unsupported: " + detail
				|		Other(detail):
				|			"tcp error: " + detail
				|
				|
				|implements Stringable for TcpError:
				|	pure func to_string(err: TcpError) -> String:
				|		message(err)
				|
				|
				|---
				|Return True when a TCP error is a timeout.
				|
				|doctests:
				|    :: TimedOut is recognized
				|    is_timed_out(TimedOut("accept")) == True
				|
				|    :: Other errors are not timeouts
				|    is_timed_out(Other("closed")) == False
				|---
				|pure func is_timed_out(err: TcpError) -> Bool:
				|	match err:
				|		TimedOut(_):
				|			True
				|		_:
				|			False
				|
				|
				|private pure func map_address_error[T](result: Result[T, String]) -> Result[T, TcpError]:
				|	match result:
				|		Ok(value):
				|			Ok(value)
				|		Err(detail):
				|			Err(InvalidInput(detail))
				|
				|
				|---
				|Construct a validated IPv4 address from four bytes.
				|
				|doctests:
				|    :: IPv4 constructor formats dotted decimal
				|    ipv4(to_uint8(127), to_uint8(0), to_uint8(0), to_uint8(1)).to_string() == "127.0.0.1"
				|---
				|pure func ipv4(a: UInt8, b: UInt8, c: UInt8, d: UInt8) -> IpAddress:
				|	builtin("blorp_tcp_ipv4_raw")
				|
				|
				|private pure func parse_ip_raw(text: String) -> Result[IpAddress, String]:
				|	builtin("blorp_tcp_parse_ip_raw")
				|
				|
				|---
				|Parse IPv4 or IPv6 address text into a validated IP address.
				|---
				|pure func parse_ip(text: String) -> Result[IpAddress, TcpError]:
				|	text
				|		.parse_ip_raw()
				|		.map_address_error()
				|
				|
				|private pure func dns_name_raw(text: String) -> Result[DnsName, String]:
				|	builtin("blorp_tcp_dns_name_raw")
				|
				|
				|---
				|Validate DNS name text.
				|
				|This intentionally performs only structural checks that are universally useful:
				|the name must be non-empty, shorter than the runtime host buffer, and free of
				|NUL bytes. IP literals are rejected so numeric endpoints stay explicit.
				|Resolution remains a separate operation performed by connect APIs.
				|---
				|pure func dns_name(text: String) -> Result[DnsName, TcpError]:
				|	text
				|		.dns_name_raw()
				|		.map_address_error()
				|
				|
				|private pure func interface_scope_raw(text: String) -> Result[InterfaceScope, String]:
				|	builtin("blorp_tcp_interface_scope_raw")
				|
				|
				|---
				|Validate an IPv6 interface scope or zone identifier.
				|---
				|pure func interface_scope(text: String) -> Result[InterfaceScope, TcpError]:
				|	text
				|		.interface_scope_raw()
				|		.map_address_error()
				|
				|
				|private pure func port_raw(value: Int) -> Result[Port, String]:
				|	builtin("blorp_tcp_port_raw")
				|
				|
				|---
				|Validate a concrete remote TCP port.
				|
				|Ports are 1 through 65535. Use a `listen_*_any_port` API when binding a listener
				|and asking the OS to assign an ephemeral port.
				|---
				|pure func port(value: Int) -> Result[Port, TcpError]:
				|	value
				|		.port_raw()
				|		.map_address_error()
				|
				|
				|---
				|Return the stored text representation of a validated IP address.
				|---
				|pure func ip_text(address: IpAddress) -> String:
				|	builtin("blorp_tcp_ip_text_raw")
				|
				|
				|implements Stringable for IpAddress:
				|	pure func to_string(address: IpAddress) -> String:
				|		address.ip_text()
				|
				|
				|---
				|Return the text representation of a validated DNS name.
				|---
				|pure func dns_name_text(name: DnsName) -> String:
				|	builtin("blorp_tcp_dns_name_text_raw")
				|
				|
				|implements Stringable for DnsName:
				|	pure func to_string(name: DnsName) -> String:
				|		name.dns_name_text()
				|
				|
				|---
				|Return the text representation of an interface scope.
				|---
				|pure func interface_scope_text(scope: InterfaceScope) -> String:
				|	builtin("blorp_tcp_interface_scope_text_raw")
				|
				|
				|implements Stringable for InterfaceScope:
				|	pure func to_string(scope: InterfaceScope) -> String:
				|		scope.interface_scope_text()
				|
				|
				|private pure func port_value(value: Port) -> Int:
				|	builtin("blorp_tcp_port_value_raw")
				|
				|
				|implements Stringable for Port:
				|	pure func to_string(value: Port) -> String:
				|		value
				|			.port_value()
				|			.to_string()
				|
				|
				|---
				|Return the local port for a scoped listener.
				|---
				|@resource_result_ordinary
				|func local_port(listener: TcpListener) -> Result[Int, TcpError]:
				|	builtin("blorp_tcp_local_port_listener_raw")
				|
				|
				|---
				|Return the local port for a scoped stream.
				|---
				|@resource_result_ordinary
				|func stream_local_port(stream: TcpStream) -> Result[Int, TcpError]:
				|	builtin("blorp_tcp_local_port_stream_raw")
				|
				|
				|---
				|Set the default runtime operation timeout for a scoped listener.
				|
				|This is a virtual-thread deadline used by accept waits on an existing listener,
				|not a kernel socket timeout. Negative timeouts are rejected.
				|---
				|@resource_result_ordinary
				|func set_timeout(listener: TcpListener, ms: Int) -> Result[Void, TcpError]:
				|	builtin("blorp_tcp_set_timeout_listener_raw")
				|
				|
				|---
				|Set the default runtime operation timeout for a scoped stream.
				|
				|This is a virtual-thread deadline used by read/write waits on an existing
				|stream, not a kernel socket timeout. Negative timeouts are rejected.
				|---
				|@resource_result_ordinary
				|func set_stream_timeout(stream: TcpStream, ms: Int) -> Result[Void, TcpError]:
				|	builtin("blorp_tcp_set_timeout_stream_raw")
				|
				|
				|---
				|Listen on a loopback address for one IP family.
				|---
				|func listen_loopback(family: IpFamily, port: Port, backlog: Int) -> Result[TcpListener, TcpError]:
				|	builtin("blorp_tcp_listen_loopback_raw")
				|
				|
				|---
				|Listen on a loopback address and ask the OS to assign an available port.
				|---
				|func listen_loopback_any_port(family: IpFamily, backlog: Int) -> Result[TcpListener, TcpError]:
				|	builtin("blorp_tcp_listen_loopback_any_port_raw")
				|
				|
				|---
				|Listen on all local interfaces for one IP family.
				|---
				|func listen_any_interface(
				|	family: IpFamily,
				|	port: Port,
				|	backlog: Int,
				|) -> Result[TcpListener, TcpError]:
				|	builtin("blorp_tcp_listen_any_interface_raw")
				|
				|
				|---
				|Listen on all local interfaces and ask the OS to assign an available port.
				|---
				|func listen_any_interface_any_port(family: IpFamily, backlog: Int) -> Result[TcpListener, TcpError]:
				|	builtin("blorp_tcp_listen_any_interface_any_port_raw")
				|
				|
				|---
				|Listen on a validated IP address.
				|---
				|func listen_ip(address: IpAddress, port: Port, backlog: Int) -> Result[TcpListener, TcpError]:
				|	builtin("blorp_tcp_listen_ip_raw")
				|
				|
				|---
				|Listen on a validated IP address and ask the OS to assign an available port.
				|---
				|func listen_ip_any_port(address: IpAddress, backlog: Int) -> Result[TcpListener, TcpError]:
				|	builtin("blorp_tcp_listen_ip_any_port_raw")
				|
				|
				|---
				|Listen on a validated IPv6 address with an explicit interface scope.
				|---
				|func listen_scoped_ip(
				|	address: IpAddress,
				|	scope: InterfaceScope,
				|	port: Port,
				|	backlog: Int,
				|) -> Result[TcpListener, TcpError]:
				|	builtin("blorp_tcp_listen_scoped_ip_raw")
				|
				|
				|---
				|Listen on a scoped IPv6 address and ask the OS to assign an available port.
				|---
				|func listen_scoped_ip_any_port(
				|	address: IpAddress,
				|	scope: InterfaceScope,
				|	backlog: Int,
				|) -> Result[TcpListener, TcpError]:
				|	builtin("blorp_tcp_listen_scoped_ip_any_port_raw")
				|
				|
				|---
				|Accept an incoming connection on a listening socket.
				|
				|The listener must be a scoped `with` binding. Only one parked accept may be in
				|progress for a listener. Use a single accept loop or a resource source such as
				|`connections_continue_on_error(listener)` to fan accepted streams into
				|structured concurrent consumers; overlapping parked accepts return an error
				|instead of pretending the listener is closed.
				|---
				|func accept(listener: TcpListener) -> Result[TcpStream, TcpError]:
				|	builtin("blorp_tcp_accept_raw")
				|
				|
				|---
				|Create a resource-producing source of accepted streams.
				|
				|The source borrows the scoped listener, so it must stay inside the listener's
				|`with` block. Sequential `for` iteration transfers each accepted stream into a
				|scoped loop body and closes it at the end of that iteration. Accept errors end
				|the source.
				|---
				|func connections_stop_on_error(listener: TcpListener) -> ResourceSource[TcpStream, TcpError]:
				|	builtin("blorp_tcp_connections_stop_on_error_raw")
				|
				|
				|---
				|Create a resource-producing source of accepted streams.
				|
				|The source borrows the scoped listener, so it must stay inside the listener's
				|`with` block. Sequential `for` iteration transfers each accepted stream into a
				|scoped loop body and closes it at the end of that iteration. Accept timeouts
				|are treated as transient and the source continues accepting; other accept
				|errors end the source.
				|---
				|func connections_continue_on_error(listener: TcpListener) -> ResourceSource[TcpStream, TcpError]:
				|	builtin("blorp_tcp_connections_continue_on_error_raw")
				|
				|
				|---
				|Connect to this machine's loopback address for one IP family.
				|---
				|func connect_loopback(family: IpFamily, port: Port) -> Result[TcpStream, TcpError]:
				|	builtin("blorp_tcp_connect_loopback_raw")
				|
				|
				|---
				|Connect to a validated IP address.
				|---
				|func connect_ip(address: IpAddress, port: Port) -> Result[TcpStream, TcpError]:
				|	builtin("blorp_tcp_connect_ip_raw")
				|
				|
				|---
				|Connect to a validated IPv6 address with an explicit interface scope.
				|---
				|func connect_scoped_ip(
				|	address: IpAddress,
				|	scope: InterfaceScope,
				|	port: Port,
				|) -> Result[TcpStream, TcpError]:
				|	builtin("blorp_tcp_connect_scoped_ip_raw")
				|
				|
				|---
				|Connect to a validated DNS name.
				|---
				|func connect_name(name: DnsName, port: Port) -> Result[TcpStream, TcpError]:
				|	builtin("blorp_tcp_connect_name_raw")
				|
				|
				|---
				|Read up to `max_bytes` from a socket.
				|
				|The stream must be a scoped `with` binding. Returns the data actually read,
				|which may be less than `max_bytes`. An empty `Bytes` value means the peer closed
				|the connection. Passing a non-positive size or a size larger than 64 MiB returns
				|`Err(InvalidInput(...))`.
				|---
				|@resource_result_ordinary
				|func read_chunk(stream: TcpStream, max_bytes: Int) -> Result[Bytes, TcpError]:
				|	builtin("blorp_tcp_read_raw")
				|
				|
				|---
				|Alias for `read_chunk`.
				|---
				|@resource_result_ordinary
				|func read(stream: TcpStream, max_bytes: Int) -> Result[Bytes, TcpError]:
				|	builtin("blorp_tcp_read_raw")
				|
				|
				|---
				|Create a fallible stream of byte chunks from a scoped TCP stream.
				|
				|Each pull reads up to `max_bytes` bytes. An empty read from the peer ends the
				|stream normally; socket, timeout, and cancellation-adjacent failures are
				|reported through terminal operations as `Result[..., TcpError]`.
				|---
				|func chunks(stream: TcpStream, max_bytes: Int) -> FallibleStream[Bytes, TcpError]:
				|	builtin("blorp_tcp_chunks_raw")
				|
				|
				|---
				|Create a fallible stream of text lines from a scoped TCP stream.
				|
				|Lines are returned without trailing `\n` or `\r\n`. The stream ends normally
				|when the peer closes the connection; a final line without a trailing newline is
				|still yielded.
				|---
				|func lines(stream: TcpStream) -> FallibleStream[String, TcpError]:
				|	builtin("blorp_tcp_lines_raw")
				|
				|
				|---
				|Write one byte chunk to a socket.
				|
				|The stream must be a scoped `with` binding. Returns the number of bytes written
				|on success. If cancellation, timeout, or an OS error happens after a partial
				|send, the function returns an error and the peer may still have received the
				|bytes already sent.
				|---
				|@resource_result_ordinary
				|func write(stream: TcpStream, data: Bytes) -> Result[Int, TcpError]:
				|	builtin("blorp_tcp_write_raw")
				|
				|
				|---
				|Write all bytes in `data` to a socket.
				|
				|Returns `Ok(void)` once every byte has been written. If cancellation, timeout,
				|or an OS error happens after a partial send, the function returns an error and
				|the peer may still have received bytes already sent.
				|---
				|@resource_result_ordinary
				|func write_all(stream: TcpStream, data: Bytes) -> Result[Void, TcpError]:
				|	builtin("blorp_tcp_write_all_raw")
				|
				|
				|---
				|Set SO_REUSEADDR on a listener.
				|---
				|@resource_result_ordinary
				|func set_reuse_addr(listener: TcpListener) -> Result[Void, TcpError]:
				|	builtin("blorp_tcp_set_reuse_addr_raw")
				|
			Some(source)
		"std/net/tls":
			source: String = raw
				|-- TLS Networking - scoped dependent TLS session resources.
				|--
				|-- TlsSession is an external capability acquired inside an existing scoped
				|-- TcpStream. The portable default runtime reports typed Unsupported errors;
				|-- runtimes built with the OpenSSL backend profile provide native TLS.
				|import:
				|	net/tcp: TcpStream
				|	stream: FallibleStream
				|
				|
				|---
				|Opaque resource for a TLS session layered over a scoped TCP stream.
				|---
				|resource type TlsSession = builtin("blorp_tls_close_session")
				|
				|
				|---
				|Private finalizer trait implemented by scoped TLS resources.
				|
				|`with` blocks use compiler-owned cleanup builtins directly. This trait keeps
				|the runtime finalizer documented inside the module without exporting a manual
				|`close` operation that could conflict with scoped cleanup ownership.
				|---
				|private trait TlsClosable:
				|	func close(handle: Self) -> Void
				|
				|
				|implements TlsClosable for TlsSession:
				|	func close(session: TlsSession) -> Void:
				|		builtin("blorp_tls_close_session")
				|
				|
				|---
				|Typed error surface for TLS APIs.
				|
				|The portable default backend reports `Unsupported`. Native TLS backends report
				|typed input, transport, certificate, protocol, timeout, closed, busy, and other
				|failures through this same surface. Transport failures are string details for
				|now; a future operation-result bridge can carry nested `TcpError` values once
				|nested error payloads are represented explicitly in compiler metadata.
				|---
				|union TlsError:
				|	InvalidInput(String)
				|	HandshakeFailed(String)
				|	Transport(String)
				|	Certificate(String)
				|	Protocol(String)
				|	TimedOut(String)
				|	Closed(String)
				|	Busy(String)
				|	Unsupported(String)
				|	Other(String)
				|
				|
				|---
				|Return a stable, human-readable description of a TLS error.
				|
				|doctests:
				|    :: Unsupported includes detail
				|    message(Unsupported("native TLS not built")) == "unsupported: native TLS not built"
				|
				|    :: Transport includes detail
				|    message(Transport("tcp reset")) == "transport error: tcp reset"
				|---
				|pure func message(err: TlsError) -> String:
				|	match err:
				|		InvalidInput(detail):
				|			"invalid input: " + detail
				|		HandshakeFailed(detail):
				|			"handshake failed: " + detail
				|		Transport(detail):
				|			"transport error: " + detail
				|		Certificate(detail):
				|			"certificate error: " + detail
				|		Protocol(detail):
				|			"protocol error: " + detail
				|		TimedOut(detail):
				|			"timed out: " + detail
				|		Closed(detail):
				|			"closed: " + detail
				|		Busy(detail):
				|			"busy: " + detail
				|		Unsupported(detail):
				|			"unsupported: " + detail
				|		Other(detail):
				|			"tls error: " + detail
				|
				|
				|implements Stringable for TlsError:
				|	pure func to_string(err: TlsError) -> String:
				|		message(err)
				|
				|
				|---
				|Return True when this runtime has an implemented native TLS backend.
				|
				|The portable default backend returns False. A runtime built with
				|`BLORP_TLS_BACKEND=openssl` returns True when OpenSSL was available at compile
				|and link time. Use this for high-level helpers that should report deterministic
				|TLS unsupported errors before opening a transport.
				|---
				|func native_available() -> Bool:
				|	builtin("blorp_tls_native_available_raw")
				|
				|
				|---
				|Return True when a TLS error is a timeout.
				|
				|doctests:
				|    :: TimedOut is recognized
				|    is_timed_out(TimedOut("handshake")) == True
				|
				|    :: Unsupported is not a timeout
				|    is_timed_out(Unsupported("not built")) == False
				|---
				|pure func is_timed_out(err: TlsError) -> Bool:
				|	match err:
				|		TimedOut(_):
				|			True
				|		_:
				|			False
				|
				|
				|---
				|Begin a TLS client session over an existing scoped TCP stream.
				|
				|The returned `TlsSession` is a dependent resource. It must be acquired inside
				|the parent TCP stream's `with` scope so TLS cleanup runs before TCP cleanup.
				|The portable default backend returns `Err(Unsupported(...))`; native backends
				|perform a nonblocking TLS client handshake before exposing the session.
				|---
				|func connect(stream: TcpStream, server_name: String) -> Result[TlsSession, TlsError]:
				|	builtin("blorp_tls_connect_raw")
				|
				|
				|---
				|Read up to `max_bytes` decrypted bytes from a TLS session.
				|
				|The portable default backend returns `Err(Unsupported(...))`; native backends
				|park the current virtual thread on transport readiness when the TLS engine
				|needs more socket I/O.
				|---
				|@resource_result_ordinary
				|func read_chunk(session: TlsSession, max_bytes: Int) -> Result[Bytes, TlsError]:
				|	builtin("blorp_tls_read_raw")
				|
				|
				|---
				|Alias for `read_chunk`.
				|---
				|@resource_result_ordinary
				|func read(session: TlsSession, max_bytes: Int) -> Result[Bytes, TlsError]:
				|	builtin("blorp_tls_read_raw")
				|
				|
				|---
				|Create a fallible stream of decrypted byte chunks from a scoped TLS session.
				|
				|Each pull reads up to `max_bytes` decrypted bytes. An empty read ends the stream
				|normally; handshake, protocol, transport, timeout, and cancellation-adjacent
				|failures are reported through terminal operations as `Result[..., TlsError]`.
				|The portable default backend returns `Err(Unsupported(...))` from terminal
				|operations.
				|---
				|func chunks(session: TlsSession, max_bytes: Int) -> FallibleStream[Bytes, TlsError]:
				|	builtin("blorp_tls_chunks_raw")
				|
				|
				|---
				|Write encrypted bytes to a TLS session.
				|
				|The portable default backend returns `Err(Unsupported(...))`; native backends
				|may write fewer bytes than requested.
				|---
				|@resource_result_ordinary
				|func write(session: TlsSession, data: Bytes) -> Result[Int, TlsError]:
				|	builtin("blorp_tls_write_raw")
				|
				|
				|---
				|Write all encrypted bytes to a TLS session.
				|
				|The portable default backend returns `Err(Unsupported(...))`; native backends
				|loop until all bytes are written or a typed error occurs.
				|---
				|@resource_result_ordinary
				|func write_all(session: TlsSession, data: Bytes) -> Result[Void, TlsError]:
				|	builtin("blorp_tls_write_all_raw")
				|
			Some(source)
		"std/net/udp":
			source: String = raw
				|-- UDP Networking - scoped socket resources.
				|--
				|-- UdpSocket is an external capability. Acquire it with
				|-- `with sock ?= socket():` so the compiler installs deterministic cleanup.
				|-- UDP supports binding, sending datagrams, receiving one datagram, streaming
				|-- received datagrams, numeric no-DNS helpers, and querying the local port.
				|import:
				|	stream: FallibleStream
				|
				|
				|---
				|Opaque resource for a UDP socket.
				|---
				|resource type UdpSocket = builtin("blorp_udp_close_socket")
				|
				|
				|---
				|Private finalizer trait implemented by scoped UDP resources.
				|
				|`with` blocks use compiler-owned cleanup builtins directly. This trait keeps the
				|runtime finalizer documented inside the module without exporting a manual
				|`close` operation that could conflict with scoped cleanup ownership.
				|---
				|private trait UdpClosable:
				|	func close(handle: Self) -> Void
				|
				|
				|implements UdpClosable for UdpSocket:
				|	func close(socket: UdpSocket) -> Void:
				|		builtin("blorp_udp_close_socket")
				|
				|
				|---
				|Typed error surface for UDP APIs.
				|---
				|union UdpError:
				|	InvalidInput(String)
				|	TimedOut(String)
				|	Closed(String)
				|	Busy(String)
				|	Dns(String)
				|	Interrupted(String)
				|	Unsupported(String)
				|	Other(String)
				|
				|
				|---
				|Return a stable, human-readable description of a UDP error.
				|
				|doctests:
				|    :: Invalid input includes detail
				|    message(InvalidInput("bad port")) == "invalid input: bad port"
				|
				|    :: Runtime compatibility errors preserve detail
				|    message(Other("udp send_to: network unreachable")) == "udp error: udp send_to: network unreachable"
				|---
				|pure func message(err: UdpError) -> String:
				|	match err:
				|		InvalidInput(detail):
				|			"invalid input: " + detail
				|		TimedOut(detail):
				|			"timed out: " + detail
				|		Closed(detail):
				|			"closed: " + detail
				|		Busy(detail):
				|			"busy: " + detail
				|		Dns(detail):
				|			"dns error: " + detail
				|		Interrupted(detail):
				|			"interrupted: " + detail
				|		Unsupported(detail):
				|			"unsupported: " + detail
				|		Other(detail):
				|			"udp error: " + detail
				|
				|
				|implements Stringable for UdpError:
				|	pure func to_string(err: UdpError) -> String:
				|		message(err)
				|
				|
				|---
				|Ordinary received UDP datagram data.
				|
				|`data` contains the bytes received. `host` and `port` describe the sender using
				|numeric address text from the OS; no reverse DNS is performed.
				|---
				|record Datagram {
				|	data: Bytes,
				|	host: String,
				|	port: Int
				|}
				|
				|
				|---
				|Create an unbound UDP socket.
				|
				|Use with `with sock ?= socket():` so the socket is closed automatically when the
				|block exits.
				|---
				|func socket() -> Result[UdpSocket, UdpError]:
				|	builtin("blorp_udp_socket_raw")
				|
				|
				|---
				|Bind a scoped UDP socket to host:port.
				|
				|Use "" to bind to the platform's passive any-host address without DNS. Numeric
				|hosts avoid resolver work. Passing port 0 asks the OS to choose an ephemeral
				|port.
				|---
				|@resource_result_ordinary
				|func bind(socket: UdpSocket, host: String, port: Int) -> Result[Void, UdpError]:
				|	builtin("blorp_udp_bind_raw")
				|
				|
				|---
				|Bind a scoped UDP socket to a numeric IPv4 host:port.
				|
				|Use "" to bind to the platform's passive any-host address. Hostnames are
				|rejected before resolver APIs are reached, so this is the enforceable no-DNS
				|binding path.
				|---
				|@resource_result_ordinary
				|func bind_numeric(socket: UdpSocket, host: String, port: Int) -> Result[Void, UdpError]:
				|	builtin("blorp_udp_bind_numeric_raw")
				|
				|
				|---
				|Send a datagram to host:port from a scoped UDP socket.
				|
				|The payload is ordinary `Bytes` data and is not retained after the call returns.
				|This operation performs a nonblocking one-shot send and reports `Busy` if the
				|socket would block.
				|---
				|@resource_result_ordinary
				|func send_to(
				|	socket: UdpSocket,
				|	data: Bytes,
				|	host: String,
				|	port: Int,
				|) -> Result[Int, UdpError]:
				|	builtin("blorp_udp_send_to_raw")
				|
				|
				|---
				|Send a datagram to a numeric IPv4 host:port from a scoped UDP socket.
				|
				|Hostnames are rejected before resolver APIs are reached. This operation keeps
				|the same one-shot nonblocking behavior as `send_to`.
				|---
				|@resource_result_ordinary
				|func send_to_numeric(
				|	socket: UdpSocket,
				|	data: Bytes,
				|	host: String,
				|	port: Int,
				|) -> Result[Int, UdpError]:
				|	builtin("blorp_udp_send_to_numeric_raw")
				|
				|
				|---
				|Send a datagram to host:port, parking the current virtual thread if needed.
				|
				|UDP datagram sends are atomic at the OS boundary: this returns the number of
				|bytes accepted for one datagram or a typed error. If the socket would block,
				|the current virtual thread parks until the socket is writable, without blocking
				|an OS thread. Concurrent parked sends on the same socket are rejected as `Busy`
				|rather than sharing mutable socket state implicitly.
				|---
				|@resource_result_ordinary
				|func send_to_wait(
				|	socket: UdpSocket,
				|	data: Bytes,
				|	host: String,
				|	port: Int,
				|) -> Result[Int, UdpError]:
				|	builtin("blorp_udp_send_to_wait_raw")
				|
				|
				|---
				|Send a datagram to a numeric IPv4 host:port, parking the current virtual thread
				|if needed.
				|
				|Hostnames are rejected before resolver APIs are reached. Concurrent parked sends
				|on the same socket are rejected as `Busy`.
				|---
				|@resource_result_ordinary
				|func send_to_wait_numeric(
				|	socket: UdpSocket,
				|	data: Bytes,
				|	host: String,
				|	port: Int,
				|) -> Result[Int, UdpError]:
				|	builtin("blorp_udp_send_to_wait_numeric_raw")
				|
				|
				|---
				|Receive one datagram from a scoped UDP socket.
				|
				|The socket must be bound before receiving. The call parks the current virtual
				|thread when no datagram is available, without blocking an OS thread. Passing a
				|non-positive size or a size larger than 65535 returns `Err(InvalidInput(...))`.
				|---
				|@resource_result_ordinary
				|func recv_from(socket: UdpSocket, max_bytes: Int) -> Result[Datagram, UdpError]:
				|	builtin("blorp_udp_recv_from_raw")
				|
				|
				|---
				|Create a fallible stream of datagrams from a scoped UDP socket.
				|
				|The stream never ends normally; it yields received datagrams until the socket
				|reports an error or the surrounding operation is cancelled. Use terminal
				|operations such as `find_result` or `any_result` when the consumer has a
				|bounded stopping condition.
				|---
				|func datagrams(socket: UdpSocket, max_bytes: Int) -> FallibleStream[Datagram, UdpError]:
				|	builtin("blorp_udp_datagrams_raw")
				|
				|
				|---
				|Return the local port for a scoped UDP socket.
				|---
				|@resource_result_ordinary
				|func local_port(socket: UdpSocket) -> Result[Int, UdpError]:
				|	builtin("blorp_udp_local_port_raw")
				|
			Some(source)
		"std/net/url":
			source: String = raw
				|-- URL - RFC 3986 URL parsing and manipulation
				|--
				|-- Provides URL parsing, reconstruction, percent encoding/decoding,
				|-- and query string utilities.
				|-- ============================================================================
				|-- Types
				|-- ============================================================================
				|record Url {
				|	scheme: String,
				|	host: String,
				|	port: Option[Int],
				|	path: String,
				|	query: String,
				|	fragment: String
				|}
				|
				|
				|-- ============================================================================
				|-- Parsing
				|-- ============================================================================
				|---
				|Parse a URL string into its components.
				|Supports http, https, and other schemes.
				|
				|doctests:
				|    :: Parse simple URL
				|    match parse("https://example.com/path"):
				|        Ok(u):
				|            u.scheme == "https" and u.host == "example.com" and u.path == "/path"
				|        Err(_):
				|            False
				|
				|    :: Parse URL with port
				|    match parse("http://localhost:8080/api"):
				|        Ok(u):
				|            u.host == "localhost"
				|        Err(_):
				|            False
				|
				|    :: Parse URL with query and fragment
				|    match parse("https://example.com/search?q=hello#results"):
				|        Ok(u):
				|            u.query == "q=hello" and u.fragment == "results"
				|        Err(_):
				|            False
				|---
				|pure func parse(url: String) -> Result[Url, String]:
				|	match url.index_of("://"):
				|		None:
				|			Err("invalid URL: missing scheme")
				|		Some(colon_idx):
				|			scheme: String = url.substring(0, colon_idx)
				|			after_scheme: String = url.substring(colon_idx + 3, url.length() - colon_idx - 3)
				|
				|			-- Split authority from path+query+fragment
				|			var authority: String = ""
				|			var remainder: String = "/"
				|
				|			match after_scheme.index_of("/"):
				|				None:
				|					authority = after_scheme.substring(0, after_scheme.length())
				|				Some(slash_idx):
				|					authority = after_scheme.substring(0, slash_idx)
				|					remainder = after_scheme.substring(slash_idx, after_scheme.length() - slash_idx)
				|
				|			-- Extract fragment
				|			var fragment: String = ""
				|			var before_frag: String = ""
				|
				|			match remainder.index_of("#"):
				|				None:
				|					before_frag = remainder.substring(0, remainder.length())
				|				Some(frag_idx):
				|					fragment = remainder.substring(frag_idx + 1, remainder.length() - frag_idx - 1)
				|					before_frag = remainder.substring(0, frag_idx)
				|
				|			-- Extract query
				|			var query: String = ""
				|			var path: String = "/"
				|
				|			match before_frag.index_of("?"):
				|				None:
				|					path = before_frag.substring(0, before_frag.length())
				|				Some(q_idx):
				|					query = before_frag.substring(q_idx + 1, before_frag.length() - q_idx - 1)
				|					path = before_frag.substring(0, q_idx)
				|
				|			-- Parse host:port
				|			var host: String = ""
				|			var port: Option[Int] = None
				|
				|			match authority.index_of(":"):
				|				None:
				|					host = authority.substring(0, authority.length())
				|				Some(port_idx):
				|					host = authority.substring(0, port_idx)
				|					port_str: String = authority.substring(
				|						port_idx + 1,
				|						authority.length() - port_idx - 1,
				|					)
				|					port = port_str.parse_int()
				|
				|			result: Url = {
				|				scheme = scheme,
				|				host = host,
				|				port = port,
				|				path = path,
				|				query = query,
				|				fragment = fragment
				|			}
				|			Ok(result)
				|
				|
				|-- ============================================================================
				|-- Reconstruction
				|-- ============================================================================
				|---
				|Reconstruct a URL string from its components.
				|
				|doctests:
				|    :: Round-trip simple URL
				|    match parse("https://example.com/path"):
				|        Ok(u):
				|            u.to_string() == "https://example.com/path"
				|        Err(_):
				|            False
				|---
				|implements Stringable for Url:
				|	pure func to_string(url: Url) -> String:
				|		var result: String = url.scheme + "://" + url.host
				|
				|		match url.port:
				|			Some(p):
				|				result = result + ":" + p.to_string()
				|			None:
				|				void
				|
				|		result += url.path
				|
				|		if url.query.length() > 0:
				|			result = result + "?" + url.query
				|
				|		if url.fragment.length() > 0:
				|			result = result + "#" + url.fragment
				|
				|		result
				|
				|
				|-- ============================================================================
				|-- Percent Encoding
				|-- ============================================================================
				|---
				|Percent-encode a string for use in URLs (RFC 3986).
				|Delegates to the existing url_encode builtin.
				|
				|doctests:
				|    :: Encode spaces
				|    encode("hello world") == "hello%20world"
				|
				|    :: Encode special chars
				|    encode("a&b=c") == "a%26b%3Dc"
				|---
				|pure func encode(s: String) -> String:
				|	s.url_encode()
				|
				|
				|---
				|Decode a percent-encoded string.
				|Delegates to the existing url_decode builtin.
				|
				|doctests:
				|    :: Decode percent encoding
				|    decode("hello%20world") == "hello world"
				|---
				|pure func decode(s: String) -> String:
				|	s.url_decode()
				|
				|
				|-- ============================================================================
				|-- Query String Utilities
				|-- ============================================================================
				|---
				|Parse a query string into key-value pairs.
				|Decodes percent-encoded keys and values.
				|
				|doctests:
				|    :: Parse simple query
				|    pairs: List[(String, String)] = parse_query("foo=bar&baz=qux")
				|    pairs.length() == 2
				|
				|    :: Parse encoded values
				|    pairs: List[(String, String)] = parse_query("name=hello%20world")
				|    pairs.length() == 1
				|---
				|pure func parse_query(query: String) -> List[(String, String)]:
				|	if query.length() == 0:
				|		[]
				|	else:
				|		query
				|			.split("&")
				|			.filter_map(parse_query_part)
				|
				|
				|private pure func parse_query_part(part: String) -> Option[(String, String)]:
				|	match part.index_of("="):
				|		Some(eq_idx):
				|			if eq_idx > 0:
				|				key: String = part
				|					.substring(0, eq_idx)
				|					.url_decode()
				|				val: String = part
				|					.substring(eq_idx + 1, part.length() - eq_idx - 1)
				|					.url_decode()
				|				Some((key, val))
				|			else:
				|				None
				|		None:
				|			if part.length() > 0:
				|				Some((part.url_decode(), ""))
				|			else:
				|				None
				|
				|
				|---
				|Build a query string from key-value pairs.
				|Percent-encodes both keys and values.
				|
				|doctests:
				|    :: Build query string
				|    build_query([("foo", "bar"), ("q", "hello world")]) == "foo=bar&q=hello%20world"
				|---
				|pure func build_query(pairs: List[(String, String)]) -> String:
				|	parts: List[String] = pairs.map(
				|		func(pair: (String, String)): pair[0].url_encode() + "=" + pair[1].url_encode(),
				|	)
				|
				|	parts.join("&")
				|
				|
				|-- ============================================================================
				|-- Utility Functions
				|-- ============================================================================
				|---
				|Get the effective port for a URL (returns default port for scheme if not specified).
				|---
				|pure func effective_port(url: Url) -> Int:
				|	match url.port:
				|		Some(p):
				|			p
				|		None:
				|			if url.scheme == "https":
				|				443
				|			else if url.scheme == "http":
				|				80
				|			else:
				|				0
				|
				|
				|---
				|Check if a URL uses TLS (https scheme).
				|---
				|pure func is_https(url: Url) -> Bool:
				|	url.scheme == "https"
				|
			Some(source)
		"std/net/websocket":
			source: String = raw
				|-- WebSocket Networking - scoped session resource foundation.
				|--
				|-- WebSocketSession is an external protocol capability. The std surface keeps
				|-- protocol ownership scoped so sessions cannot be copied out of their cleanup
				|-- lifetime.
				|---
				|Opaque resource for a WebSocket session.
				|---
				|resource type WebSocketSession = builtin("blorp_websocket_close_session")
				|
				|
				|---
				|Private finalizer trait implemented by scoped WebSocket resources.
				|
				|`with` blocks use compiler-owned cleanup builtins directly. This trait keeps
				|the runtime finalizer documented inside the module without exporting a manual
				|`close` operation that could conflict with scoped cleanup ownership.
				|---
				|private trait WebSocketClosable:
				|	func close(handle: Self) -> Void
				|
				|
				|implements WebSocketClosable for WebSocketSession:
				|	func close(session: WebSocketSession) -> Void:
				|		builtin("blorp_websocket_close_session")
				|
				|
				|---
				|Ordinary WebSocket message values.
				|---
				|union Message:
				|	Text(String)
				|	Binary(Bytes)
				|	Close(Int, String)
				|	Ping(Bytes)
				|	Pong(Bytes)
				|
				|
				|---
				|Typed error surface for WebSocket APIs.
				|---
				|union WebSocketError:
				|	InvalidUrl(String)
				|	HandshakeFailed(String)
				|	Transport(String)
				|	Tls(String)
				|	Protocol(String)
				|	TimedOut(String)
				|	Closed(String)
				|	Busy(String)
				|	Unsupported(String)
				|	Other(String)
				|
				|
				|---
				|Return a stable, human-readable description of a WebSocket error.
				|
				|doctests:
				|    :: Unsupported includes detail
				|    message(Unsupported("not built")) == "unsupported: not built"
				|
				|    :: InvalidUrl includes detail
				|    message(InvalidUrl("missing scheme")) == "invalid URL: missing scheme"
				|---
				|pure func message(err: WebSocketError) -> String:
				|	match err:
				|		InvalidUrl(detail):
				|			"invalid URL: " + detail
				|		HandshakeFailed(detail):
				|			"handshake failed: " + detail
				|		Transport(detail):
				|			"transport error: " + detail
				|		Tls(detail):
				|			"tls error: " + detail
				|		Protocol(detail):
				|			"protocol error: " + detail
				|		TimedOut(detail):
				|			"timed out: " + detail
				|		Closed(detail):
				|			"closed: " + detail
				|		Busy(detail):
				|			"busy: " + detail
				|		Unsupported(detail):
				|			"unsupported: " + detail
				|		Other(detail):
				|			"websocket error: " + detail
				|
				|
				|implements Stringable for WebSocketError:
				|	pure func to_string(err: WebSocketError) -> String:
				|		message(err)
				|
				|
				|---
				|Return True when this runtime has an implemented native WebSocket backend.
				|
				|The default runtime supports native `ws://` sessions over TCP. `wss://`
				|sessions additionally require a native TLS backend; runtimes without TLS return
				|a typed `Unsupported` error for secure URLs before opening the network.
				|---
				|func native_available() -> Bool:
				|	builtin("blorp_websocket_native_available_raw")
				|
				|
				|---
				|Return True when a WebSocket error is a timeout.
				|
				|doctests:
				|    :: TimedOut is recognized
				|    is_timed_out(TimedOut("handshake")) == True
				|
				|    :: Unsupported is not a timeout
				|    is_timed_out(Unsupported("not built")) == False
				|---
				|pure func is_timed_out(err: WebSocketError) -> Bool:
				|	match err:
				|		TimedOut(_):
				|			True
				|		_:
				|			False
				|
				|
				|---
				|Connect to a WebSocket URL as a scoped session resource.
				|
				|The URL must start with `ws://` or `wss://` and include a non-empty host.
				|The optional port must be numeric and in range. Raw spaces/control characters
				|fragments, and user-info authority syntax are rejected before the backend
				|boundary.
				|The returned session is a scoped resource. `ws://` connects through TCP and
				|performs the HTTP upgrade handshake before the resource is published. `wss://`
				|requires a native TLS backend.
				|---
				|func connect(url: String) -> Result[WebSocketSession, WebSocketError]:
				|	builtin("blorp_websocket_connect_raw")
				|
				|
				|---
				|Receive one complete message from a scoped WebSocket session.
				|
				|Overlapping receives on the same session return `Err(Busy(...))`. Runtime
				|backends return a frame kind plus owned payload fields; generated code
				|constructs these ordinary `Message` values at the Blorp boundary. Receiving a
				|close frame moves the session into a peer-closing state: ordinary reads and
				|writes then return `Err(Closed(...))`, but one `send_close` reply remains valid.
				|---
				|@resource_result_ordinary
				|func receive(session: WebSocketSession) -> Result[Message, WebSocketError]:
				|	builtin("blorp_websocket_receive_raw")
				|
				|
				|---
				|Send a complete text message on a scoped WebSocket session.
				|
				|Missing or malformed text payloads return `Err(Protocol(...))`. Overlapping
				|writes on the same session return `Err(Busy(...))`.
				|---
				|@resource_result_ordinary
				|func send_text(session: WebSocketSession, text: String) -> Result[Void, WebSocketError]:
				|	builtin("blorp_websocket_send_text_raw")
				|
				|
				|---
				|Send a complete binary message on a scoped WebSocket session.
				|
				|Missing or malformed binary payloads return `Err(Protocol(...))`. Overlapping
				|writes on the same session return `Err(Busy(...))`.
				|---
				|@resource_result_ordinary
				|func send_binary(session: WebSocketSession, bytes: Bytes) -> Result[Void, WebSocketError]:
				|	builtin("blorp_websocket_send_binary_raw")
				|
				|
				|---
				|Send a ping control frame on a scoped WebSocket session.
				|
				|Ping payloads must be 125 bytes or fewer. Missing, malformed, or oversized
				|payloads return `Err(Protocol(...))`. Overlapping writes on the same session
				|return `Err(Busy(...))`.
				|---
				|@resource_result_ordinary
				|func send_ping(session: WebSocketSession, bytes: Bytes) -> Result[Void, WebSocketError]:
				|	builtin("blorp_websocket_send_ping_raw")
				|
				|
				|---
				|Send a pong control frame on a scoped WebSocket session.
				|
				|Pong payloads must be 125 bytes or fewer. Missing, malformed, or oversized
				|payloads return `Err(Protocol(...))`. Overlapping writes on the same session
				|return `Err(Busy(...))`.
				|---
				|@resource_result_ordinary
				|func send_pong(session: WebSocketSession, bytes: Bytes) -> Result[Void, WebSocketError]:
				|	builtin("blorp_websocket_send_pong_raw")
				|
				|
				|---
				|Send a close control frame on a scoped WebSocket session.
				|
				|Overlapping writes on the same session return `Err(Busy(...))`. A successful
				|close-frame send moves the session into a closing state; later reads or writes
				|on that session return `Err(Closed(...))`. If the peer has already sent a close
				|frame, `send_close` remains valid so callers can reply with the closing frame
				|required by the protocol.
				|Close codes must be valid WebSocket wire close codes, and the reason must fit
				|inside the close frame.
				|---
				|@resource_result_ordinary
				|func send_close(
				|	session: WebSocketSession,
				|	code: Int,
				|	reason: String,
				|) -> Result[Void, WebSocketError]:
				|	builtin("blorp_websocket_send_close_raw")
				|
			Some(source)
		"std/noise":
			source: String = raw
				|-- Noise - Procedural noise functions for terrain, textures, and effects.
				|--
				|-- Provides value noise and Perlin noise in 1D, 2D, and 3D.
				|-- All functions are pure and deterministic.
				|import:
				|	float: floor, lerp
				|
				|
				|private NOISE_HASH_MULTIPLIER: Int = 1103515245
				|
				|private NOISE_HASH_INCREMENT: Int = 12345
				|
				|private NOISE_HASH_SHIFT_DIVISOR: Int = 65536
				|
				|private NOISE_HASH_MODULUS: Int = 32768
				|
				|private VALUE_NOISE_BUCKETS: Int = 10000
				|
				|private VALUE_NOISE_BUCKETS_FLOAT: Float = 10000.0
				|
				|private VALUE_NOISE_Y_STRIDE: Int = 57
				|
				|private VALUE_NOISE_Z_STRIDE: Int = 113
				|
				|
				|-- ============================================================================
				|-- Hash (internal)
				|-- ============================================================================
				|-- Integer hash for noise permutation
				|private pure func noise_hash(n: Int) -> Int:
				|	var h: Int = n
				|	h = (h * NOISE_HASH_MULTIPLIER + NOISE_HASH_INCREMENT) / NOISE_HASH_SHIFT_DIVISOR % NOISE_HASH_MODULUS
				|	h = h * NOISE_HASH_MULTIPLIER + NOISE_HASH_INCREMENT
				|
				|	if h < 0:
				|		0 - h
				|	else:
				|		h
				|
				|
				|private pure func unit_noise_value(cell: Int) -> Float:
				|	to_float(noise_hash(cell) % VALUE_NOISE_BUCKETS) / VALUE_NOISE_BUCKETS_FLOAT
				|
				|
				|private pure func value_noise_cell_2d(xi: Int, yi: Int) -> Int:
				|	xi + yi * VALUE_NOISE_Y_STRIDE
				|
				|
				|private pure func value_noise_cell_3d(xi: Int, yi: Int, zi: Int) -> Int:
				|	xi + yi * VALUE_NOISE_Y_STRIDE + zi * VALUE_NOISE_Z_STRIDE
				|
				|
				|-- ============================================================================
				|-- Value Noise
				|-- ============================================================================
				|---
				|1D value noise. Returns a smooth random value in [0, 1] for any input.
				|Continuous and deterministic.
				|
				|doctests:
				|    :: Deterministic
				|    value_noise_1d(5.5) == value_noise_1d(5.5)
				|
				|    :: In range
				|    value_noise_1d(3.7) >= 0.0
				|---
				|pure func value_noise_1d(x: Float) -> Float:
				|	xi: Int = to_int(floor(x))
				|	xf: Float = x - to_float(xi)
				|	t: Float = xf * xf * (3.0 - 2.0 * xf)
				|	a: Float = unit_noise_value(xi)
				|	b: Float = unit_noise_value(xi + 1)
				|	lerp(a, b, t)
				|
				|
				|---
				|2D value noise. Returns smooth random value in [0, 1].
				|
				|doctests:
				|    :: Deterministic
				|    value_noise_2d(1.5, 2.3) == value_noise_2d(1.5, 2.3)
				|
				|    :: In range
				|    value_noise_2d(3.7, 8.1) >= 0.0
				|---
				|pure func value_noise_2d(x: Float, y: Float) -> Float:
				|	xi: Int = to_int(floor(x))
				|	yi: Int = to_int(floor(y))
				|	xf: Float = x - to_float(xi)
				|	yf: Float = y - to_float(yi)
				|	tx: Float = xf * xf * (3.0 - 2.0 * xf)
				|	ty: Float = yf * yf * (3.0 - 2.0 * yf)
				|	n00: Float = unit_noise_value(value_noise_cell_2d(xi, yi))
				|	n10: Float = unit_noise_value(value_noise_cell_2d(xi + 1, yi))
				|	n01: Float = unit_noise_value(value_noise_cell_2d(xi, yi + 1))
				|	n11: Float = unit_noise_value(value_noise_cell_2d(xi + 1, yi + 1))
				|	lerp(
				|		lerp(n00, n10, tx),
				|		lerp(n01, n11, tx),
				|		ty,
				|	)
				|
				|
				|---
				|3D value noise. Returns smooth random value in [0, 1].
				|---
				|pure func value_noise_3d(x: Float, y: Float, z: Float) -> Float:
				|	xi: Int = to_int(floor(x))
				|	yi: Int = to_int(floor(y))
				|	zi: Int = to_int(floor(z))
				|	xf: Float = x - to_float(xi)
				|	yf: Float = y - to_float(yi)
				|	zf: Float = z - to_float(zi)
				|	tx: Float = xf * xf * (3.0 - 2.0 * xf)
				|	ty: Float = yf * yf * (3.0 - 2.0 * yf)
				|	tz: Float = zf * zf * (3.0 - 2.0 * zf)
				|	n000: Float = unit_noise_value(value_noise_cell_3d(xi, yi, zi))
				|	n100: Float = unit_noise_value(value_noise_cell_3d(xi + 1, yi, zi))
				|	n010: Float = unit_noise_value(value_noise_cell_3d(xi, yi + 1, zi))
				|	n110: Float = unit_noise_value(value_noise_cell_3d(xi + 1, yi + 1, zi))
				|	n001: Float = unit_noise_value(value_noise_cell_3d(xi, yi, zi + 1))
				|	n101: Float = unit_noise_value(value_noise_cell_3d(xi + 1, yi, zi + 1))
				|	n011: Float = unit_noise_value(value_noise_cell_3d(xi, yi + 1, zi + 1))
				|	n111: Float = unit_noise_value(value_noise_cell_3d(xi + 1, yi + 1, zi + 1))
				|	x0: Float = lerp(
				|		lerp(n000, n100, tx),
				|		lerp(n010, n110, tx),
				|		ty,
				|	)
				|	x1: Float = lerp(
				|		lerp(n001, n101, tx),
				|		lerp(n011, n111, tx),
				|		ty,
				|	)
				|	lerp(x0, x1, tz)
				|
				|
				|-- ============================================================================
				|-- Fractal Brownian Motion (fBm)
				|-- ============================================================================
				|---
				|Fractal Brownian motion in 2D: layers multiple octaves of noise
				|for natural-looking terrain, clouds, etc.
				|
				|octaves: number of noise layers (4-8 typical)
				|persistence: amplitude decay per octave (0.5 typical)
				|
				|doctests:
				|    :: Deterministic
				|    fbm_2d(1.5, 2.3, 4, 0.5) == fbm_2d(1.5, 2.3, 4, 0.5)
				|---
				|pure func fbm_2d(
				|	x: Float,
				|	y: Float,
				|	octaves: Int,
				|	persistence: Float,
				|) -> Float:
				|	var total: Float = 0.0
				|	var amplitude: Float = 1.0
				|	var frequency: Float = 1.0
				|	var max_val: Float = 0.0
				|	var i: Int = 0
				|
				|	while i < octaves:
				|		total += value_noise_2d(x * frequency, y * frequency) * amplitude
				|		max_val += amplitude
				|		amplitude *= persistence
				|		frequency *= 2.0
				|		i += 1
				|
				|	total / max_val
				|
				|
				|---
				|Fractal Brownian motion in 3D.
				|---
				|pure func fbm_3d(
				|	x: Float,
				|	y: Float,
				|	z: Float,
				|	octaves: Int,
				|	persistence: Float,
				|) -> Float:
				|	var total: Float = 0.0
				|	var amplitude: Float = 1.0
				|	var frequency: Float = 1.0
				|	var max_val: Float = 0.0
				|	var i: Int = 0
				|
				|	while i < octaves:
				|		total += value_noise_3d(x * frequency, y * frequency, z * frequency) * amplitude
				|		max_val += amplitude
				|		amplitude *= persistence
				|		frequency *= 2.0
				|		i += 1
				|
				|	total / max_val
				|
			Some(source)
		"std/option":
			source: String = raw
				|-- Option - Optional value type
				|--
				|-- Option[T] represents a value that may or may not be present.
				|-- Used for safe handling of "nullable" values without null pointers.
				|-- The compiler specializes the representation by payload type: primitive
				|-- scalars, Int128/UInt128, ranges, enums, and structs use stack layouts;
				|-- managed payloads use an internal nullable pointer; nested/unsafe generic
				|-- cases stay boxed.
				|--
				|-- Variants:
				|-- - Some(T): Contains a value
				|-- - None: No value present
				|--
				|-- Core Functions:
				|-- - is_some, is_none: Check presence
				|-- - get_or, get_or_else: Get value with default
				|-- - map, and_then, filter: Transform contents
				|--
				|-- Trait Implementations:
				|-- - ToBool: Some -> True, None -> False
				|-- - Stringable: "Some(x)" or "None" (requires T: Stringable)
				|-- - Equatable: Compare by contents (requires T: Equatable)
				|-- Union (sum type) definition
				|union Option[T]:
				|	Some(T)
				|	None
				|
				|
				|---
				|Check if option contains a value.
				|
				|doctests:
				|    :: Some returns true
				|    is_some(Some(42)) == True
				|---
				|pure func is_some[T](self: Option[T]) -> Bool:
				|	match self:
				|		Some(_):
				|			True
				|		None:
				|			False
				|
				|
				|---
				|Check if option is empty.
				|
				|doctests:
				|    :: None case
				|    opt: Option[Int] = None
				|    is_none(opt) == True
				|---
				|pure func is_none[T](self: Option[T]) -> Bool:
				|	match self:
				|		Some(_):
				|			False
				|		None:
				|			True
				|
				|
				|---
				|Get the value or return a default.
				|
				|doctests:
				|    :: Unwrap Some returns value
				|    get_or(Some(42), 0) == 42
				|
				|    :: Unwrap None returns default
				|    opt: Option[Int] = None
				|    opt.get_or(0) == 0
				|---
				|pure func get_or[T](self: Option[T], default_val: T) -> T:
				|	match self:
				|		Some(val):
				|			val
				|		None:
				|			default_val
				|
				|
				|---
				|Map a function over an option
				|Returns Some(f(val)) if Some, None if None.
				|
				|doctests:
				|    :: Map over Some
				|    match map(Some(5), func(x: Int): x * 2):
				|        Some(v):
				|            v == 10
				|        None:
				|            False
				|---
				|func map[T, U](
				|	self: Option[T],
				|	f: (T) -> U,
				|) -> Option[U]:
				|pure func map[T, U](
				|	self: Option[T],
				|	f: pure (T) -> U,
				|) -> Option[U]:
				|	match self:
				|		Some(val):
				|			Some(f(val))
				|		None:
				|			None
				|
				|
				|---
				|Chain operations that return Option (pure version).
				|Returns f(val) if Some, None if None.
				|
				|doctests:
				|    :: and_then over Some
				|    result = and_then(Some(5), func(x: Int): Some(x * 2))
				|
				|    match result:
				|        Some(v):
				|            v == 10
				|        None:
				|            False
				|---
				|func and_then[T, U](
				|	self: Option[T],
				|	f: (T) -> Option[U],
				|) -> Option[U]:
				|pure func and_then[T, U](
				|	self: Option[T],
				|	f: pure (T) -> Option[U],
				|) -> Option[U]:
				|	match self:
				|		Some(val):
				|			f(val)
				|		_:
				|			None
				|
				|
				|---
				|Keep value only if predicate is true (pure version).
				|
				|doctests:
				|    :: Filter keeps matching value
				|    match filter(Some(10), func(x: Int): x > 5):
				|        Some(v):
				|            v == 10
				|        None:
				|            False
				|---
				|func filter[T](
				|	self: Option[T],
				|	pred: (T) -> Bool,
				|) -> Option[T]:
				|pure func filter[T](
				|	self: Option[T],
				|	pred: pure (T) -> Bool,
				|) -> Option[T]:
				|	match self:
				|		Some(val):
				|			if pred(val):
				|				Some(val)
				|			else:
				|				None
				|		None:
				|			None
				|
				|
				|---
				|Get value or compute default lazily
				|
				|doctests:
				|    :: Unwrap Some skips default function
				|    get_or_else(Some(42), func(): 0) == 42
				|---
				|pure func get_or_else[T](
				|	self: Option[T],
				|	default_fn: pure () -> T,
				|) -> T:
				|func get_or_else[T](
				|	self: Option[T],
				|	default_fn: () -> T,
				|) -> T:
				|	match self:
				|		Some(val):
				|			val
				|		None:
				|			default_fn()
				|
				|
				|---
				|Convert Option to Result, using given error value if None.
				|Useful with ?= bindings: `value ?= some_option().to_result("missing")`
				|---
				|pure func to_result[T, E](self: Option[T], error: E) -> Result[T, E]:
				|	match self:
				|		Some(val):
				|			Ok(val)
				|		None:
				|			Err(error)
				|
				|
				|implements ToBool for Option[T]:
				|	pure func to_bool[T](self: Option[T]) -> Bool:
				|		match self:
				|			Some(_):
				|				True
				|			None:
				|				False
				|
				|
				|implements Stringable for Option[T:Stringable]:
				|	pure func to_string[T:Stringable](self: Option[T]) -> String:
				|		match self:
				|			Some(val):
				|				"Some(" + val.to_string() + ")"
				|			None:
				|				"None"
				|
				|
				|implements Equatable for Option[T:Equatable]:
				|	pure func equals[T:Equatable](a: Option[T], b: Option[T]) -> Bool:
				|		match a:
				|			Some(x):
				|				match b:
				|					Some(y):
				|						equals(x, y)
				|					None:
				|						False
				|			None:
				|				match b:
				|					Some(_):
				|						False
				|					None:
				|						True
				|
				|	pure func not_equals[T:Equatable](a: Option[T], b: Option[T]) -> Bool:
				|		match a:
				|			Some(x):
				|				match b:
				|					Some(y):
				|						not equals(x, y)
				|					None:
				|						True
				|			None:
				|				match b:
				|					Some(_):
				|						True
				|					None:
				|						False
				|-- Utility functions for Option
				|-- Map a function over an option.
				|-- Chain operations that return Option.
				|-- Keep value only if predicate is true.
				|-- Get value or compute default lazily.
				|-- Type conversions FROM Option
				|
			Some(source)
		"std/parallel_list":
			source: String = raw
				|-- ParallelList - scoped combinators for List.parallel callbacks.
				|private pure func __parallel_list_map[T, U](
				|	self: ParallelList[T],
				|	f: pure (T) -> U,
				|) -> ParallelList[U]:
				|	builtin("blorp_map_parallel")
				|
				|
				|private pure func __parallel_list_filter[T](
				|	self: ParallelList[T],
				|	predicate: pure (T) -> Bool,
				|) -> ParallelList[T]:
				|	builtin("blorp_filter_parallel")
				|
				|
				|private pure func __parallel_list_filter_map[T, U](
				|	self: ParallelList[T],
				|	f: pure (T) -> Option[U],
				|) -> ParallelList[U]:
				|	builtin("blorp_filter_map_parallel")
				|
				|
				|---
				|Parallel map over a ParallelList.
				|---
				|pure func map[T, U](
				|	self: ParallelList[T],
				|	f: pure (T) -> U,
				|) -> ParallelList[U]:
				|	__parallel_list_map(self, f)
				|
				|
				|---
				|Parallel filter over a ParallelList.
				|---
				|pure func filter[T](
				|	self: ParallelList[T],
				|	predicate: pure (T) -> Bool,
				|) -> ParallelList[T]:
				|	__parallel_list_filter(self, predicate)
				|
				|
				|---
				|Parallel filter-map over a ParallelList.
				|---
				|pure func filter_map[T, U](
				|	self: ParallelList[T],
				|	f: pure (T) -> Option[U],
				|) -> ParallelList[U]:
				|	__parallel_list_filter_map(self, f)
				|
			Some(source)
		"std/parallel_matrix":
			source: String = raw
				|-- ParallelMatrix - scoped combinators for Matrix.parallel callbacks.
				|import:
				|	matrix: ParallelMatrix
				|
				|
				|private pure func __parallel_matrix_map[T, U, #M, #N](
				|	self: ParallelMatrix[T, #M, #N],
				|	f: pure (T) -> U,
				|) -> ParallelMatrix[U, #M, #N]:
				|	builtin("blorp_mmap_parallel")
				|
				|
				|private pure func __parallel_matrix_map_indexed[T, U, #M, #N](
				|	self: ParallelMatrix[T, #M, #N],
				|	f: pure (..#M, ..#N, T) -> U,
				|) -> ParallelMatrix[U, #M, #N]:
				|	builtin("blorp_mmap_indexed_parallel")
				|
				|
				|private pure func __parallel_matrix_zip_map[A, B, C, #M, #N](
				|	self: ParallelMatrix[A, #M, #N],
				|	other: B[#M, #N],
				|	f: pure (A, B) -> C,
				|) -> ParallelMatrix[C, #M, #N]:
				|	builtin("blorp_mzip_parallel")
				|
				|
				|---
				|Parallel shape-preserving map over a ParallelMatrix.
				|---
				|pure func map[T, U, #M, #N](
				|	self: ParallelMatrix[T, #M, #N],
				|	f: pure (T) -> U,
				|) -> ParallelMatrix[U, #M, #N]:
				|	__parallel_matrix_map(self, f)
				|
				|
				|---
				|Parallel shape-preserving indexed map over a ParallelMatrix.
				|---
				|pure func map_indexed[T, U, #M, #N](
				|	self: ParallelMatrix[T, #M, #N],
				|	f: pure (..#M, ..#N, T) -> U,
				|) -> ParallelMatrix[U, #M, #N]:
				|	__parallel_matrix_map_indexed(self, f)
				|
				|
				|---
				|Parallel shape-preserving zip-map over a ParallelMatrix and same-sized matrix.
				|---
				|pure func zip_map[A, B, C, #M, #N](
				|	self: ParallelMatrix[A, #M, #N],
				|	other: B[#M, #N],
				|	f: pure (A, B) -> C,
				|) -> ParallelMatrix[C, #M, #N]:
				|	__parallel_matrix_zip_map(self, other, f)
				|
			Some(source)
		"std/parallel_vector":
			source: String = raw
				|-- ParallelVector - scoped combinators for Vector.parallel callbacks.
				|import:
				|	vector: ParallelVector
				|
				|
				|private pure func __parallel_vector_map[T, U, #N](
				|	self: ParallelVector[T, #N],
				|	f: pure (T) -> U,
				|) -> ParallelVector[U, #N]:
				|	builtin("blorp_vmap_parallel")
