				|	var found: Int = -1
				|	var done: Bool = False
				|
				|	while i < s.length() and not done:
				|		match s.get(i):
				|			Some(actual):
				|				if actual == ch:
				|					found = i
				|					done = True
				|			None:
				|				done = True
				|
				|		i += 1
				|
				|	found
				|
				|
				|private pure func find_str(s: String, start: Int, target: String) -> Int:
				|	tlen: Int = target.length()
				|	var i: Int = start
				|	var found: Int = -1
				|	var done: Bool = False
				|
				|	while i + tlen <= s.length() and not done:
				|		if starts_at(s, i, target):
				|			found = i
				|			done = True
				|
				|		i += 1
				|
				|	found
				|
				|
				|private pure func find_space(s: String) -> Int:
				|	var i: Int = 0
				|	var found: Int = -1
				|	var done: Bool = False
				|
				|	while i < s.length() and not done:
				|		match s.get(i):
				|			Some(c):
				|				if (
				|					c == ' '
				|					or c == '\t'
				|					or c == '\n'
				|				):
				|					found = i
				|					done = True
				|			None:
				|				done = True
				|
				|		i += 1
				|
				|	found
				|
				|
				|private pure func find_attr(attrs: List[(String, String)], name: String) -> Option[String]:
				|	var result: Option[String] = None
				|	var remaining: List[(String, String)] = attrs
				|	var done: Bool = False
				|
				|	while not done:
				|		match remaining:
				|			[]:
				|				done = True
				|			[pair, ...rest]:
				|				if pair[0] == name:
				|					result = Some(pair[1])
				|					done = True
				|				else:
				|					remaining = rest
				|			_:
				|				done = True
