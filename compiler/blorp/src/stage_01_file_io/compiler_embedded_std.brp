		"std/io":
			source: String = raw
				|-- IO - Input/Output operations
				|--
				|-- Core I/O functions for console and stdin/stdout interaction.
				|-- All functions are impure — I/O is an observable side effect.
				|---
				|Print a value to stdout followed by a newline.
				|---
				|func print[T:Stringable](value: T) -> Void:
				|	__print_string(value.to_string())
				|
				|
				|private func __print_string(s: String) -> Void:
				|	builtin("blorp_print")
				|
				|
				|---
				|Print a value to stdout without adding a newline.
				|---
				|func puts[T:Stringable](value: T) -> Void:
				|	__puts_string(value.to_string())
				|
				|
				|private func __puts_string(s: String) -> Void:
				|	builtin("blorp_puts")
				|
				|
				|---
				|Print a value to stderr followed by a newline. Use for diagnostics so
				|that normal output on stdout remains clean for pipes and redirection.
				|---
				|func print_error[T:Stringable](value: T) -> Void:
				|	__print_error_string(value.to_string())
				|
				|
				|private func __print_error_string(s: String) -> Void:
				|	builtin("blorp_print_error")
				|
				|
				|---
				|Read a single line from stdin, stripping the trailing newline.
				|Returns None at EOF, so empty user-entered lines remain distinguishable
				|from end-of-input. On interactive terminals, Ctrl-D returns None for that read
				|without making later reads immediately return EOF.
				|---
				|func read_line() -> Option[String]:
				|	builtin("blorp_read_line")
				|
				|
				|---
				|Read a single line from stdin, stripping the trailing newline.
				|Returns an empty string at EOF.
				|---
				|func read_line_or_empty() -> String:
				|	builtin("blorp_read_line_or_empty")
				|
				|
				|---
				|Write `prompt` to stdout (without a trailing newline) and read one line
				|from stdin. Trailing newline on the input is stripped. Returns None at EOF.
				|On interactive terminals, Ctrl-D returns None for that read without making later
				|reads immediately return EOF.
				|---
				|func input(prompt: String) -> Option[String]:
				|	builtin("blorp_input")
				|
				|
				|---
				|Write `prompt` to stdout (without a trailing newline) and read one line
				|from stdin. Returns an empty string at EOF.
				|---
				|func input_or_empty(prompt: String) -> String:
				|	builtin("blorp_input_or_empty")
				|
			Some(source)
		"std/json":
			source: String = raw
				|import:
				|	float: is_finite
				|	parser: Cursor, ParseError, ParseResult(ParseFailed, Parsed), make_span
				|	string: from_char, is_digit, string as make_string
				|
				|
				|-- JSON Parser
				|-- Built around an indexed scanner. `parse` adapts the scanner to ParseResult
				|-- for callers that need cursor-based composition.
				|-- JsonValue.to_string emits valid JSON for all JsonValue values. Since JSON
				|-- has no NaN or infinity literals, non-finite JsonNumber values serialize as
				|-- null.
				|-- JSON Value type
				|union JsonValue:
				|	JsonNull
				|	JsonBool(Bool)
				|	JsonNumber(Float)
				|	JsonString(String)
				|	JsonVector(List[JsonValue])
				|	JsonObject(List[(String, JsonValue)])
				|
				|
				|record JsonError {
				|	line: Int,
				|	column: Int,
				|	message: String
				|}
				|
				|
				|pure func format_error(err: JsonError) -> String:
				|	"line ${err.line.to_string()}, column ${err.column.to_string()}: ${err.message}"
				|
				|
				|private pure func is_nonzero_digit(c: Char) -> Bool:
				|	c >= '1' and c <= '9'
				|
				|
				|private pure func is_exp_marker(c: Char) -> Bool:
				|	c == 'e' or c == 'E'
				|
				|
				|private pure func is_sign(c: Char) -> Bool:
				|	c == '+' or c == '-'
				|
				|
				|private pure func is_hex_digit(c: Char) -> Bool:
				|	c >= '0' and c <= '9' or c >= 'a' and c <= 'f' or c >= 'A' and c <= 'F'
				|
				|
				|private pure func hex_value(c: Char) -> Int:
				|	if c >= '0' and c <= '9':
				|		to_int(c) - to_int('0')
				|	else if c >= 'a' and c <= 'f':
				|		10 + to_int(c) - to_int('a')
				|	else if c >= 'A' and c <= 'F':
				|		10 + to_int(c) - to_int('A')
				|	else:
				|		0
				|
				|
				|private pure func hex_digit_char(n: Int) -> Char:
				|	if n < 10:
				|		to_char(to_int('0') + n)
				|	else:
				|		to_char(to_int('A') + n - 10)
				|
				|
				|private pure func parse_hex4_at(input: String, start: Int) -> Option[Int]:
				|	if start + 4 > input.length():
				|		None
				|	else:
				|		var value: Int = 0
				|		var i: Int = 0
				|		var ok: Bool = True
				|
				|		while i < 4 and ok:
				|			match input.get(start + i):
				|				Some(c):
				|					if is_hex_digit(c):
				|						value = value * 16 + hex_value(c)
				|						i += 1
				|					else:
				|						ok = False
				|				None:
				|					ok = False
				|
				|		if ok:
				|			Some(value)
				|		else:
				|			None
				|
				|
				|private pure func is_high_surrogate(code: Int) -> Bool:
				|	code >= 55296 and code <= 56319
				|
				|
				|private pure func is_low_surrogate(code: Int) -> Bool:
				|	code >= 56320 and code <= 57343
				|
				|
				|private pure func has_unicode_escape_at(input: String, start: Int) -> Bool:
				|	match input.get(start):
				|		Some(bs):
				|			match input.get(start + 1):
				|				Some(u):
				|					bs == '\\' and u == 'u'
				|				None:
				|					False
				|		None:
				|			False
				|
				|
				|private pure func append_unicode_escape(result: String, code: Int) -> String:
				|	var out: String = result
				|	out = out.append_char('\\')
				|	out = out.append_char('u')
				|	out = out.append_char(hex_digit_char(code / 4096 % 16))
				|	out = out.append_char(hex_digit_char(code / 256 % 16))
				|	out = out.append_char(hex_digit_char(code / 16 % 16))
				|	out = out.append_char(hex_digit_char(code % 16))
				|	out
				|
				|
				|-- ============================================================================
				|-- Indexed strict JSON parser
				|-- ============================================================================
				|private struct JsonScanner {
				|	pos: Int,
				|	line: Int,
				|	column: Int
				|}
				|
				|
				|private record JsonScanFailure {
				|	error: JsonError,
				|	pos: Int
				|}
				|
				|
				|private JSON_SCANNER: JsonScanner = {
				|	pos = 0,
				|	line = 1,
				|	column = 1
				|}
				|
				|
				|private pure func parser_cursor(s: JsonScanner) -> Cursor:
				|	{
				|		offset = s.pos,
				|		line = s.line,
				|		column = s.column
				|	}
				|
				|
				|private pure func parser_error(failure: JsonScanFailure) -> ParseError:
				|	cursor: Cursor = {
				|		offset = failure.pos,
				|		line = failure.error.line,
				|		column = failure.error.column
				|	}
				|	{
				|		span = make_span(cursor, cursor),
				|		message = failure.error.message,
				|		expected = [],
				|		committed = False
				|	}
				|
				|
				|private pure func scanner_at_end(input: String, s: JsonScanner) -> Bool:
				|	s.pos >= input.length()
				|
				|
				|private pure func scanner_peek(input: String, s: JsonScanner) -> Option[Char]:
				|	input.get(s.pos)
				|
				|
				|private pure func scanner_advance(input: String, s: JsonScanner) -> JsonScanner:
				|	match scanner_peek(input, s):
				|		Some('\n'):
				|			{
				|				pos = s.pos + 1,
				|				line = s.line + 1,
				|				column = 1
				|			}
				|		Some(_):
				|			{
				|				pos = s.pos + 1,
				|				line = s.line,
				|				column = s.column + 1
				|			}
				|		None:
				|			s
				|
				|
				|private pure func scanner_advance_same_line(s: JsonScanner, count: Int) -> JsonScanner:
				|	if count <= 0:
				|		s
				|	else:
				|		{
				|			pos = s.pos + count,
				|			line = s.line,
				|			column = s.column + count
				|		}
				|
				|
				|private pure func scanner_advance_same_line_to(s: JsonScanner, target: Int) -> JsonScanner:
				|	scanner_advance_same_line(s, target - s.pos)
				|
				|
				|private pure func scanner_error(s: JsonScanner, message: String) -> JsonScanFailure:
				|	{
				|		error = {
				|			line = s.line,
				|			column = s.column,
				|			message = message
				|		},
				|		pos = s.pos
				|	}
				|
				|
				|private pure func scanner_skip_whitespace(input: String, s: JsonScanner) -> JsonScanner:
				|	var st: JsonScanner = s
				|	var done: Bool = False
				|
				|	while not done:
				|		match scanner_peek(input, st):
				|			Some(c):
				|				if (
				|					c == ' '
				|					or c == '\n'
				|					or c == '\r'
				|					or c == '\t'
				|				):
				|					st = scanner_advance(input, st)
				|				else:
				|					done = True
				|			None:
				|				done = True
				|
				|	st
				|
				|
				|private pure func scanner_starts_at(input: String, s: JsonScanner, prefix: String) -> Bool:
				|	plen: Int = prefix.length()
				|
				|	if s.pos + plen > input.length():
				|		False
				|	else:
				|		var matches: Bool = True
				|		var i: Int = 0
				|
				|		while i < plen and matches:
				|			match input.get(s.pos + i):
				|				Some(actual):
				|					match prefix.get(i):
				|						Some(expected):
				|							if actual != expected:
				|								matches = False
				|						None:
				|							matches = False
				|				None:
				|					matches = False
				|
				|			i += 1
				|
				|		matches
				|
				|
				|private pure func scanner_literal(
				|	input: String,
				|	s: JsonScanner,
				|	text: String,
				|	value: JsonValue,
				|) -> Result[(JsonValue, JsonScanner), JsonScanFailure]:
				|	if scanner_starts_at(input, s, text):
				|		Ok((value, scanner_advance_same_line(s, text.length())))
				|	else:
				|		Err(scanner_error(s, "expected JSON value"))
				|
				|
				|private pure func scanner_parse_string(
				|	input: String,
				|	s: JsonScanner,
				|) -> Result[(String, JsonScanner), JsonScanFailure]:
				|	q: Char = '\"'
				|	bs: Char = '\\'
				|
				|	match scanner_peek(input, s):
				|		Some(c):
				|			if c != q:
				|				Err(scanner_error(s, "expected string"))
				|			else:
				|				var result: String = make_string(16)
				|				var st: JsonScanner = scanner_advance(input, s)
				|				var done: Bool = False
				|				var has_error: Bool = False
				|				var error: JsonScanFailure = scanner_error(s, "unterminated string")
				|
				|				while not done and not has_error:
				|					match scanner_peek(input, st):
				|						None:
				|							has_error = True
				|							error = scanner_error(st, "unterminated string")
				|						Some(ch):
				|							if ch == q:
				|								done = True
				|								st = scanner_advance(input, st)
				|							else if ch == bs:
				|								escape_start: JsonScanner = st
				|								next_state: JsonScanner = scanner_advance(input, st)
				|
				|								match scanner_peek(input, next_state):
				|									None:
				|										has_error = True
				|										error = scanner_error(
				|											escape_start,
				|											"unterminated escape sequence",
				|										)
				|									Some(next):
				|										match next:
				|											'\"':
				|												result = result.append_char(q)
				|												st = scanner_advance_same_line(st, 2)
				|											'\\':
				|												result = result.append_char(bs)
				|												st = scanner_advance_same_line(st, 2)
				|											'/':
				|												result = result.append_char('/')
				|												st = scanner_advance_same_line(st, 2)
				|											'b':
				|												result = result.append_char(to_char(8))
				|												st = scanner_advance_same_line(st, 2)
				|											'f':
				|												result = result.append_char(to_char(12))
				|												st = scanner_advance_same_line(st, 2)
				|											'n':
				|												result = result.append_char('\n')
				|												st = scanner_advance_same_line(st, 2)
				|											't':
				|												result = result.append_char('\t')
				|												st = scanner_advance_same_line(st, 2)
				|											'r':
				|												result = result.append_char('\r')
				|												st = scanner_advance_same_line(st, 2)
				|											'u':
				|												match parse_hex4_at(input, st.pos + 2):
				|													Some(code):
				|														if is_high_surrogate(code):
				|															if has_unicode_escape_at(
				|																input,
				|																st.pos + 6,
				|															):
				|																match parse_hex4_at(
				|																	input,
				|																	st.pos + 8,
				|																):
				|																	Some(low):
				|																		if is_low_surrogate(low):
				|																			full: Int = 65536 + (code - 55296) * 1024 + (low - 56320)
				|																			result = result.append_char(
				|																				to_char(full),
				|																			)
				|																			st = scanner_advance_same_line(
				|																				st,
				|																				12,
				|																			)
				|																		else:
				|																			has_error = True
				|																			error = scanner_error(
				|																				escape_start,
				|																				"invalid unicode surrogate pair",
				|																			)
				|																	None:
				|																		has_error = True
				|																		error = scanner_error(
				|																			escape_start,
				|																			"invalid unicode escape",
				|																		)
				|															else:
				|																has_error = True
				|																error = scanner_error(
				|																	escape_start,
				|																	"unpaired unicode high surrogate",
				|																)
				|														else if is_low_surrogate(code):
				|															has_error = True
				|															error = scanner_error(
				|																escape_start,
				|																"unpaired unicode low surrogate",
				|															)
				|														else:
				|															result = result.append_char(
				|																to_char(code),
				|															)
				|															st = scanner_advance_same_line(st, 6)
				|													None:
				|														has_error = True
				|														error = scanner_error(
				|															escape_start,
				|															"invalid unicode escape",
				|														)
				|											_:
				|												has_error = True
				|												error = scanner_error(
				|													escape_start,
				|													"invalid string escape",
				|												)
				|							else if to_int(ch) < 32:
				|								has_error = True
				|								error = scanner_error(st, "unescaped control character in string")
				|							else:
				|								-- Scanner positions are byte offsets; preserve raw UTF-8 bytes.
				|								result += input.substring(st.pos, 1)
				|								st = scanner_advance(input, st)
				|
				|				if has_error:
				|					Err(error)
				|				else:
				|					Ok((result, st))
				|		None:
				|			Err(scanner_error(s, "expected string"))
				|
				|
				|private pure func scanner_parse_number(
				|	input: String,
				|	s: JsonScanner,
				|) -> Result[(JsonValue, JsonScanner), JsonScanFailure]:
				|	len: Int = input.length()
				|	var i: Int = s.pos
				|	var ok: Bool = True
				|	var message: String = "invalid number"
				|	var error_index: Int = i
				|
				|	match input.get(i):
				|		Some(c):
				|			if c == '-':
				|				i += 1
				|		None:
				|			ok = False
				|			error_index = i
				|
				|	if ok:
				|		match input.get(i):
				|			Some(c):
				|				if c == '0':
				|					i += 1
				|
				|					match input.get(i):
				|						Some(next):
				|							if is_digit(next):
				|								ok = False
				|								message = "invalid number: leading zero"
				|								error_index = i
				|						None:
				|							void
				|				else if is_nonzero_digit(c):
				|					i += 1
				|					var scanning_int: Bool = True
				|
				|					while scanning_int:
				|						match input.get(i):
				|							Some(next):
				|								if is_digit(next):
				|									i += 1
				|								else:
				|									scanning_int = False
				|							None:
				|								scanning_int = False
				|				else:
				|					ok = False
				|					message = "invalid number: expected digit"
				|					error_index = i
				|			None:
				|				ok = False
				|				message = "invalid number: expected digit"
				|				error_index = i
				|
				|	if ok:
				|		match input.get(i):
				|			Some(c):
				|				if c == '.':
				|					i += 1
				|
				|					match input.get(i):
				|						Some(first_frac):
				|							if is_digit(first_frac):
				|								i += 1
				|								var scanning_frac: Bool = True
				|
				|								while scanning_frac:
				|									match input.get(i):
				|										Some(next):
				|											if is_digit(next):
				|												i += 1
				|											else:
				|												scanning_frac = False
				|										None:
				|											scanning_frac = False
				|							else:
				|								ok = False
				|								message = "invalid number: expected digit after decimal point"
				|								error_index = i
				|						None:
				|							ok = False
				|							message = "invalid number: expected digit after decimal point"
				|							error_index = i
				|			None:
				|				void
				|
				|	if ok:
				|		match input.get(i):
				|			Some(c):
				|				if is_exp_marker(c):
				|					i += 1
				|
				|					match input.get(i):
				|						Some(sign):
				|							if is_sign(sign):
				|								i += 1
				|						None:
				|							void
				|
				|					match input.get(i):
				|						Some(first_exp):
				|							if is_digit(first_exp):
				|								i += 1
				|								var scanning_exp: Bool = True
				|
				|								while scanning_exp:
				|									match input.get(i):
				|										Some(next):
				|											if is_digit(next):
				|												i += 1
				|											else:
				|												scanning_exp = False
				|										None:
				|											scanning_exp = False
				|							else:
				|								ok = False
				|								message = "invalid number: expected exponent digit"
				|								error_index = i
				|						None:
				|							ok = False
				|							message = "invalid number: expected exponent digit"
				|							error_index = i
				|			None:
				|				void
				|
				|	if ok and i > s.pos:
				|		num_str: String = input.substring(s.pos, i - s.pos)
				|		Ok((JsonNumber(to_float(num_str)), scanner_advance_same_line_to(s, i)))
				|	else:
				|		Err(scanner_error(scanner_advance_same_line_to(s, error_index), message))
				|
				|
				|private pure func scanner_parse_value(
				|	input: String,
				|	s: JsonScanner,
				|) -> Result[(JsonValue, JsonScanner), JsonScanFailure]:
				|	st: JsonScanner = scanner_skip_whitespace(input, s)
				|
				|	match scanner_peek(input, st):
				|		Some('n'):
				|			scanner_literal(input, st, "null", JsonNull)
				|		Some('t'):
				|			scanner_literal(input, st, "true", JsonBool(True))
				|		Some('f'):
				|			scanner_literal(input, st, "false", JsonBool(False))
				|		Some('-'):
				|			scanner_parse_number(input, st)
				|		Some(c):
				|			if is_digit(c):
				|				scanner_parse_number(input, st)
				|			else if c == '\"':
				|				match scanner_parse_string(input, st):
				|					Ok((value, rest)):
				|						Ok((JsonString(value), rest))
				|					Err(e):
				|						Err(e)
				|			else if c == '[':
				|				scanner_parse_array(input, st)
				|			else if c == '{':
				|				scanner_parse_object(input, st)
				|			else:
				|				Err(scanner_error(st, "expected JSON value"))
				|		None:
				|			Err(scanner_error(st, "expected JSON value"))
				|
				|
				|private pure func scanner_parse_array(
				|	input: String,
				|	s: JsonScanner,
				|) -> Result[(JsonValue, JsonScanner), JsonScanFailure]:
				|	var st: JsonScanner = scanner_advance(input, s)
				|	var items: List[JsonValue] = []
				|	var done: Bool = False
				|	var has_error: Bool = False
				|	var error: JsonScanFailure = scanner_error(s, "")
				|	st = scanner_skip_whitespace(input, st)
				|
				|	match scanner_peek(input, st):
				|		Some(']'):
				|			done = True
				|			st = scanner_advance(input, st)
				|		_:
				|			void
				|
				|	while not done and not has_error:
				|		match scanner_parse_value(input, st):
				|			Ok((value, rest)):
				|				items = items.append(value)
				|				st = scanner_skip_whitespace(input, rest)
				|
				|				match scanner_peek(input, st):
				|					Some(','):
				|						st = scanner_advance(input, st)
				|					Some(']'):
				|						done = True
				|						st = scanner_advance(input, st)
				|					Some(_):
				|						has_error = True
				|						error = scanner_error(st, "expected ',' or ']' in array")
				|					None:
				|						has_error = True
				|						error = scanner_error(st, "unterminated array")
				|			Err(e):
				|				has_error = True
				|				error = e
				|
				|	if has_error:
				|		Err(error)
				|	else:
				|		Ok((JsonVector(items), st))
				|
				|
				|private pure func scanner_parse_object(
				|	input: String,
				|	s: JsonScanner,
				|) -> Result[(JsonValue, JsonScanner), JsonScanFailure]:
				|	var st: JsonScanner = scanner_advance(input, s)
				|	var pairs: List[(String, JsonValue)] = []
				|	var seen: List[String] = []
				|	var done: Bool = False
				|	var has_error: Bool = False
				|	var error: JsonScanFailure = scanner_error(s, "")
				|	st = scanner_skip_whitespace(input, st)
				|
				|	match scanner_peek(input, st):
				|		Some('}'):
				|			done = True
				|			st = scanner_advance(input, st)
				|		_:
				|			void
				|
				|	while not done and not has_error:
				|		st = scanner_skip_whitespace(input, st)
				|		key_start: JsonScanner = st
				|
				|		match scanner_peek(input, st):
				|			Some('\"'):
				|				match scanner_parse_string(input, st):
				|					Ok((key, after_key)):
				|						if seen.contains(key):
				|							has_error = True
				|							error = scanner_error(key_start, "duplicate object key")
				|						else:
				|							seen = seen.append(key)
				|							st = scanner_skip_whitespace(input, after_key)
				|
				|							match scanner_peek(input, st):
				|								Some(':'):
				|									st = scanner_advance(input, st)
				|
				|									match scanner_parse_value(input, st):
				|										Ok((value, after_value)):
				|											pairs = pairs.append((key, value))
				|											st = scanner_skip_whitespace(input, after_value)
				|
				|											match scanner_peek(input, st):
				|												Some(','):
				|													st = scanner_advance(input, st)
				|												Some('}'):
				|													done = True
				|													st = scanner_advance(input, st)
				|												Some(_):
				|													has_error = True
				|													error = scanner_error(
				|														st,
				|														"expected ',' or '}' in object",
				|													)
				|												None:
				|													has_error = True
				|													error = scanner_error(st, "unterminated object")
				|										Err(e):
				|											has_error = True
				|											error = e
				|								Some(_):
				|									has_error = True
				|									error = scanner_error(st, "expected ':' after object key")
				|								None:
				|									has_error = True
				|									error = scanner_error(st, "unterminated object")
				|					Err(e):
				|						has_error = True
				|						error = e
				|			Some(_):
				|				has_error = True
				|				error = scanner_error(st, "expected string key")
				|			None:
				|				has_error = True
				|				error = scanner_error(st, "unterminated object")
				|
				|	if has_error:
				|		Err(error)
				|	else:
				|		Ok((JsonObject(pairs), st))
				|
				|
				|---
				|Parse one JSON value and return the cursor after that value.
				|This is the cursor-based entry point for code that composes parsers. It uses
				|the same scanner as `parse_json`, but it does not require the scanner to consume
				|the full input.
				|
				|doctests:
				|    :: Parse preserves trailing cursor
				|    match parse("true false"):
				|        Parsed(JsonBool(True), cursor):
				|            cursor.offset == 4
				|        _:
				|            False
				|---
				|pure func parse(input: String) -> ParseResult[JsonValue]:
				|	match scanner_parse_value(input, JSON_SCANNER):
				|		Ok((value, rest)):
				|			Parsed(value, parser_cursor(rest))
				|		Err(failure):
				|			ParseFailed(parser_error(failure))
				|
				|
				|---
				|Parse a JSON string into a JsonValue, returning Result instead of ParseResult.
				|Requires the full input to be one JSON value, apart from trailing whitespace.
				|Errors include line and column context in the returned string. Use
				|`parse_json_detailed` when callers need structured error fields.
				|Use `parse` if you need remaining-input behavior.
				|
				|doctests:
				|    :: Parse valid JSON
				|    match "{\"x\": 1}".parse_json():
				|        Ok(_):
				|            True
				|        Err(_):
				|            False
				|
				|    :: Invalid JSON returns Err
				|    match "not json".parse_json():
				|        Ok(_):
				|            False
				|        Err(_):
				|            True
				|---
				|pure func parse_json(input: String) -> Result[JsonValue, String]:
				|	match parse_json_detailed(input):
				|		Ok(value):
				|			Ok(value)
				|		Err(err):
				|			Err(err.format_error())
				|
				|
				|---
				|Parse a JSON string into a JsonValue with structured error details.
				|Requires the full input to be one JSON value, apart from trailing whitespace.
				|Use `parse_json` if you only need a formatted string error.
				|
				|doctests:
				|    :: Structured line and column error
				|    match parse_json_detailed("true\nfalse"):
				|        Ok(_):
				|            False
				|        Err(e):
				|            e.line == 2 and e.column == 1
				|---
				|pure func parse_json_detailed(input: String) -> Result[JsonValue, JsonError]:
				|	match scanner_parse_value(input, JSON_SCANNER):
				|		Ok((value, rest)):
				|			trailing: JsonScanner = scanner_skip_whitespace(input, rest)
				|
				|			if scanner_at_end(input, trailing):
				|				Ok(value)
				|			else:
				|				Err(scanner_error(trailing, "unexpected trailing input").error)
				|		Err(e):
				|			Err(e.error)
				|
				|
				|-- ============================================================================
				|-- JSON Value Accessors
				|-- ============================================================================
				|pure func is_null(value: JsonValue) -> Bool:
				|	match value:
				|		JsonNull:
				|			True
				|		_:
				|			False
				|
				|
				|pure func as_bool(value: JsonValue) -> Option[Bool]:
				|	match value:
				|		JsonBool(b):
				|			Some(b)
				|		_:
				|			None
				|
				|
				|pure func as_number(value: JsonValue) -> Option[Float]:
				|	match value:
				|		JsonNumber(n):
				|			Some(n)
				|		_:
				|			None
				|
				|
				|pure func as_string(value: JsonValue) -> Option[String]:
				|	match value:
				|		JsonString(s):
				|			Some(s)
				|		_:
				|			None
				|
				|
				|pure func as_array(value: JsonValue) -> Option[List[JsonValue]]:
				|	match value:
				|		JsonVector(arr):
				|			Some(arr)
				|		_:
				|			None
				|
				|
				|pure func as_object(value: JsonValue) -> Option[List[(String, JsonValue)]]:
				|	match value:
				|		JsonObject(obj):
				|			Some(obj)
				|		_:
				|			None
				|
				|
				|pure func get_field(value: JsonValue, key: String) -> Option[JsonValue]:
				|	match value:
				|		JsonObject(pairs):
				|			var result: Option[JsonValue] = None
				|			var i: Int = 0
				|			var found: Bool = False
				|
				|			while i < pairs.length() and not found:
				|				match pairs.get(i):
				|					Some(pair):
				|						if pair[0] == key:
				|							result = Some(pair[1])
				|							found = True
				|					None:
				|						void
				|
				|				i += 1
				|
				|			result
				|		_:
				|			None
				|
				|
				|-- ============================================================================
				|-- JSON Serialization
				|-- ============================================================================
				|private QUOTE_CHAR: String = "\""
				|
				|
				|implements Stringable for JsonValue:
				|	pure func to_string(value: JsonValue) -> String:
				|		q: String = QUOTE_CHAR
				|
				|		match value:
				|			JsonNull:
				|				"null"
				|			JsonBool(b):
				|				if b:
				|					"true"
				|				else:
				|					"false"
				|			JsonNumber(n):
				|				if is_finite(n):
				|					n.to_string()
				|				else:
				|					"null"
				|			JsonString(s):
				|				q + escape(s) + q
				|			JsonVector(arr):
				|				var result: String = "["
				|				var first: Bool = True
				|				var i: Int = 0
				|
				|				while i < arr.length():
				|					elem_opt: Option[JsonValue] = arr.get(i)
				|
				|					match elem_opt:
				|						Some(elem):
				|							if first:
				|								first = False
				|							else:
				|								result = result.append_char(',')
				|
				|							result += elem.to_string()
				|						None:
				|							void
				|
				|					i += 1
				|
				|				result + "]"
				|			JsonObject(pairs):
				|				var result: String = from_char('{')
				|				var first: Bool = True
				|				var i: Int = 0
				|
				|				while i < pairs.length():
				|					pair_opt: Option[(String, JsonValue)] = pairs.get(i)
				|
				|					match pair_opt:
				|						Some(pair):
				|							if first:
				|								first = False
				|							else:
				|								result = result.append_char(',')
				|
				|							result = result.append_char('\"')
				|							result += escape(pair[0])
				|							result = result.append_char('\"')
				|							result = result.append_char(':')
				|							result += pair[1].to_string()
				|						None:
				|							void
				|
				|					i += 1
				|
				|				result + from_char('}')
				|
				|
				|---
				|Emit JSON in bounded chunks without materializing serialized container
				|subtrees. The callback owns each chunk only for the duration of the call.
				|---
				|func emit_json_chunks(
				|	value: JsonValue,
				|	emit: (String) -> Void,
				|) -> Void:
				|	match value:
				|		JsonNull:
				|			emit("null")
				|			void
				|		JsonBool(flag):
				|			if flag:
				|				emit("true")
				|			else:
				|				emit("false")
				|
				|			void
				|		JsonNumber(number):
				|			if is_finite(number):
				|				emit(number.to_string())
				|			else:
				|				emit("null")
				|
				|			void
				|		JsonString(text):
				|			emit(QUOTE_CHAR)
				|			emit(escape(text))
				|			emit(QUOTE_CHAR)
				|			void
				|		JsonVector(items):
				|			emit("[")
				|			var first: Bool = True
				|
				|			for item in items:
				|				if first:
				|					first = False
				|				else:
				|					emit(",")
				|
				|				emit_json_chunks(item, emit)
				|
				|			emit("]")
				|			void
				|		JsonObject(fields):
				|			emit("{")
				|			var first: Bool = True
				|
				|			for field in fields:
				|				if first:
				|					first = False
				|				else:
				|					emit(",")
				|
				|				emit(QUOTE_CHAR)
				|				emit(escape(field[0]))
				|				emit(QUOTE_CHAR)
				|				emit(":")
				|				emit_json_chunks(field[1], emit)
				|
				|			emit("}")
				|			void
				|
				|
				|private pure func escape(s: String) -> String:
				|	var result: String = make_string(16)
				|	var i: Int = 0
				|
				|	while i < s.length():
				|		match s.get(i):
				|			Some(c):
				|				code: Int = to_int(c)
				|
				|				match code:
				|					34:
				|						result = result.append_char('\\')
				|						result = result.append_char('\"')
				|					92:
				|						result = result.append_char('\\')
				|						result = result.append_char('\\')
				|					10:
				|						result = result.append_char('\\')
				|						result = result.append_char('n')
				|					13:
				|						result = result.append_char('\\')
				|						result = result.append_char('r')
				|					9:
				|						result = result.append_char('\\')
				|						result = result.append_char('t')
				|					8:
				|						result = result.append_char('\\')
				|						result = result.append_char('b')
				|					12:
				|						result = result.append_char('\\')
				|						result = result.append_char('f')
				|					_:
				|						if code < 32:
				|							result = append_unicode_escape(result, code)
				|						else if code < 127:
				|							result = result.append_char(c)
				|						else:
				|							result += s.substring(i, 1)
				|			None:
				|				void
				|
				|		i += 1
				|
				|	result
				|-- is_digit imported from parser (which re-exports from string)
				|
			Some(source)
		"std/list":
			source: String = raw
				|import:
				|	traits: one, zero
				|	units: Duration, to_timeout_milliseconds
				|
				|
				|-- List - Dynamic array type operations
				|--
				|-- List[T] is a dynamic, heap-allocated array with automatic memory management.
				|-- Uses ARC (Automatic Reference Counting) and COW (Copy-on-Write) optimization.
				|-- All operations are semantically immutable - mutations return new lists.
				|-- COW optimization mutates in-place when refcount is 1.
				|type List[T] = builtin
				|
				|
				|type ParallelList[T] = builtin
				|
				|
				|-- ============================================================================
				|-- Core List Operations (builtins)
				|-- ============================================================================
				|---
				|Create an empty List[T] with the given capacity reserved.
				|
				|The list starts with length 0; `capacity` is a hint to the runtime for how
				|many elements will fit without reallocation. Useful when appending in a loop
				|where the final size is known in advance.
				|
				|doctests:
				|    :: Empty list with capacity
				|    xs: List[Int] = list(100)
				|    xs.length() == 0
				|
				|    :: Appending within capacity
				|    var xs: List[Int] = list(8)
				|
				|    for i in 0..5:
				|        xs = xs.append(i)
				|
				|    xs.length() == 5
				|---
				|pure func list[T](capacity: Int) -> List[T]:
				|	builtin("std/list.list")
				|
				|
				|---
				|Get element at index, returning Option[T].
				|
				|doctests:
				|    :: Get element in bounds
				|    nums: List[Int] = [10, 20, 30]
				|
				|    match nums.get(1):
				|        Some(v):
				|            v == 20
				|        None:
				|            False
				|
				|    :: Get element out of bounds returns None
				|    nums: List[Int] = [10, 20, 30]
				|
				|    match nums.get(5):
				|        Some(_):
				|            False
				|        None:
				|            True
				|---
				|pure func get[T](self: List[T], index: Int) -> Option[T]:
				|	builtin("std/list.get")
				|
				|
				|---
				|Get element at index, or return a default value if out of bounds.
				|
				|doctests:
				|    :: Get element in bounds
				|    [10, 20, 30].get_or(1, 0) == 20
				|
				|    :: Get element out of bounds returns default
				|    [10, 20, 30].get_or(5, 99) == 99
				|
				|    :: Get from empty list returns default
				|    empty: List[Int] = []
				|    empty.get_or(0, 42) == 42
				|---
				|pure func get_or[T](self: List[T], index: Int, default: T) -> T:
				|	builtin("std/list.get_or")
				|
				|
				|---
				|Append an element to the end of the list. Returns a new list.
				|
				|doctests:
				|    :: Append to empty list
				|    empty: List[Int] = []
				|    result: List[Int] = empty.append(42)
				|    result.length() == 1
				|
				|    :: Append preserves existing elements
				|    nums: List[Int] = [1, 2, 3]
				|    result: List[Int] = nums.append(4)
				|    result.length() == 4
				|---
				|pure func append[T](self: List[T], elem: T) -> List[T]:
				|	builtin("std/list.append")
				|
				|
				|---
				|Replace element at index. Returns Some(new_list) on success, None if out of bounds.
				|---
				|pure func set_index[T](self: List[T], index: Int, elem: T) -> Option[List[T]]:
				|	if index < 0 or index >= self.length():
				|		None
				|	else:
				|		Some(__unsafe_list_set_index(self, index, elem))
				|
				|
				|private pure func __unsafe_list_set_index[T](self: List[T], index: Int, elem: T) -> List[T]:
				|	builtin("std/list.__unsafe_list_set_index")
				|
				|
				|---
				|Swap two list elements. Returns Some(new_list) on success, None if either
				|index is negative or out of bounds.
				|
				|doctests:
				|    :: Swap first and last
				|    match [1, 2, 3].swap(0, 2):
				|        Some(xs):
				|            xs == [3, 2, 1]
				|        None:
				|            False
				|
				|    :: Same index is valid and unchanged
				|    xs: List[Int] = [1, 2, 3]
				|
				|    match xs.swap(1, 1):
				|        Some(swapped):
				|            swapped == xs
				|        None:
				|            False
				|
				|    :: Negative index returns None
				|    match [1, 2, 3].swap(-1, 2):
				|        Some(_):
				|            False
				|        None:
				|            True
				|
				|    :: Out-of-bounds index returns None
				|    match [1, 2, 3].swap(0, 3):
				|        Some(_):
				|            False
				|        None:
				|            True
				|---
				|pure func swap[T](self: List[T], i: Int, j: Int) -> Option[List[T]]:
				|	if i < 0 or j < 0:
				|		None
				|	else:
				|		max_index: Int = if i > j:
				|			i
				|		else:
				|			j
				|
				|		if max_index >= self.length():
				|			None
				|		else if i == j:
				|			Some(self)
				|		else:
				|			Some(__unsafe_list_swap(self, i, j))
				|
				|
				|private pure func __unsafe_list_swap[T](self: List[T], i: Int, j: Int) -> List[T]:
				|	builtin("std/list.__unsafe_list_swap")
				|
				|
				|---
				|Replace element at index. Returns updated list, or the original list unchanged
				|if the index is out of bounds.
				|
				|doctests:
				|    :: Set valid index
				|    [1, 2, 3].set(1, 99) == [1, 99, 3]
				|
				|    :: Out of bounds returns original
				|    [1, 2, 3].set(10, 99) == [1, 2, 3]
				|---
				|pure func set[T](self: List[T], index: Int, elem: T) -> List[T]:
				|	builtin("std/list.set")
				|
				|
				|---
				|Insert element at index, shifting later elements right.
				|Returns Some(new_list) on success, None if index out of bounds.
				|---
				|pure func insert[T](self: List[T], index: Int, elem: T) -> Option[List[T]]:
				|	if index < 0 or index > self.length():
				|		None
				|	else:
				|		Some(__unsafe_list_insert(self, index, elem))
				|
				|
				|private pure func __unsafe_list_insert[T](self: List[T], index: Int, elem: T) -> List[T]:
				|	builtin("std/list.__unsafe_list_insert")
				|
				|
				|---
				|Remove element at index, shifting later elements left.
				|Returns Some(new_list) on success, None if index out of bounds.
				|---
				|pure func remove[T](self: List[T], index: Int) -> Option[List[T]]:
				|	if index < 0 or index >= self.length():
				|		None
				|	else:
				|		Some(__unsafe_list_remove(self, index))
				|
				|
				|private pure func __unsafe_list_remove[T](self: List[T], index: Int) -> List[T]:
				|	builtin("std/list.__unsafe_list_remove")
				|
				|
				|-- Implement HasLength trait for List
				|implements HasLength for List[T]:
				|	pure func length[T](self: List[T]) -> Int:
				|		builtin("std/list.length")
				|
				|
				|-- Implement Stringable trait for List
				|implements Stringable for List[T:Stringable]:
				|	pure func to_string[T](self: List[T]) -> String:
				|		builtin("std/list.to_string")
				|
				|
				|---
				|Check if the list is empty.
				|
				|doctests:
				|    :: Empty list is empty
				|    empty: List[Int] = []
				|    empty.is_empty() == True
				|
				|    :: Non-empty list is not empty
				|    nums: List[Int] = [1, 2, 3]
				|    nums.is_empty() == False
				|---
				|pure func is_empty[T](self: List[T]) -> Bool:
				|	self.length() == 0
				|
				|
				|---
				|Get first element of list.
				|Returns Some(element) if list is non-empty, None otherwise.
				|
				|doctests:
				|    :: Head of non-empty list
				|    nums: List[Int] = [10, 20, 30]
				|
				|    match nums.head():
				|        Some(v):
				|            v == 10
				|        None:
				|            False
				|
				|    :: Head of empty list is None
				|    empty: List[Int] = []
				|
				|    match empty.head():
				|        Some(_):
				|            False
				|        None:
				|            True
				|---
				|pure func head[T](self: List[T]) -> Option[T]:
				|	self.get(0)
				|
				|
				|---
				|Get all elements except the first.
				|Returns a new list without the first element, or empty list if input is empty.
				|
				|doctests:
				|    :: Tail of a 3-element list
				|    nums: List[Int] = [10, 20, 30]
				|    result: List[Int] = nums.tail()
				|    result.length() == 2
				|
				|    :: Tail of empty list is empty
				|    empty: List[Int] = []
				|    empty
				|        .tail()
				|        .length() == 0
				|
				|    :: Tail of single element is empty
				|    one: List[Int] = [42]
				|    one
				|        .tail()
				|        .length() == 0
				|---
				|pure func tail[T](self: List[T]) -> List[T]:
				|	__unsafe_list_tail(self)
				|
				|
				|private pure func __unsafe_list_tail[T](self: List[T]) -> List[T]:
				|	builtin("std/list.__unsafe_list_tail")
				|
				|
				|---
				|Map a function over all elements.
				|Returns a new list with the function applied to each element.
				|---
				|func map[T, U](
				|	self: List[T],
				|	f: (T) -> U,
				|) -> List[U]:
				|pure func map[T, U](
				|	self: List[T],
				|	f: pure (T) -> U,
				|) -> List[U]:
				|	builtin("std/list.map")
				|
				|
				|---
				|Map a function over all elements concurrently, collecting one Result per input.
				|
				|This is the preferred method name for virtual-thread fan-out that returns
				|values. It matches `parallel` as a list method while keeping statement fan-out
				|on `for ... concurrently(limit: N)`.
				|
				|The result order matches the input order. `limit` is the maximum number of
				|tasks active at once; values less than 1 run serially with a limit of 1.
				|
				|doctests:
				|    :: Concurrent method preserves input order
				|    nums: List[Int] = [1, 2, 3]
				|    results: List[Result[Int, ConcurrencyError]] = nums.concurrent(2, func(n: Int): n * 2)
				|
				|    match results.get(1):
				|        Some(Ok(v)):
				|            v == 4
				|        _:
				|            False
				|---
				|func concurrent[T, U](
				|	self: List[T],
				|	limit: Int,
				|	f: (T) -> U,
				|) -> List[Result[U, ConcurrencyError]]:
				|	builtin("std/list.concurrent")
				|
				|
				|---
				|Map a function over all elements concurrently with a typed whole-operation
				|timeout, collecting one Result per input.
				|
				|Use `for ... concurrently(limit: N, timeout: d):` for statement fan-out and
				|`list.concurrent_with_timeout(limit, d, func)` when the caller needs the
				|collected results.
				|
				|The result order matches the input order. `limit` is the maximum number of
				|tasks active at once; values less than 1 run serially with a limit of 1. The
				|timeout applies to the whole operation, not to each item.
				|
				|doctests:
				|    :: Concurrent method with timeout preserves input order
				|    import:
				|        units: microseconds
				|
				|    nums: List[Int] = [1, 2, 3]
				|    timeout: Duration = microseconds(100000)
				|    results: List[Result[Int, ConcurrencyError]] = nums.concurrent_with_timeout(
				|        2,
				|        timeout,
				|        func(n: Int): n * 2,
				|    )
				|
				|    match results.get(1):
				|        Some(Ok(v)):
				|            v == 4
				|        _:
				|            False
				|---
				|func concurrent_with_timeout[T, U](
				|	self: List[T],
				|	limit: Int,
				|	timeout: Duration,
				|	f: (T) -> U,
				|) -> List[Result[U, ConcurrencyError]]:
				|	__concurrent_timeout_ms(self, limit, to_timeout_milliseconds(timeout), f)
				|
				|
				|private func __concurrent_timeout_ms[T, U](
				|	self: List[T],
				|	limit: Int,
				|	timeout_ms: Int,
				|	f: (T) -> U,
				|) -> List[Result[U, ConcurrencyError]]:
				|	builtin("std/list.__concurrent_timeout_ms")
				|
				|
