				|	var remaining: List[XmlNode] = nodes
				|	var done: Bool = False
				|
				|	while not done:
				|		match remaining:
				|			[]:
				|				done = True
				|			[node, ...rest]:
				|				txt: String = get_text_val(node)
				|
				|				if txt.length() > 0:
				|					result = txt
				|					done = True
				|				else:
				|					remaining = rest
				|			_:
				|				done = True
