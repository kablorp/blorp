				|---
				|Insert a separator between each element.
				|
				|doctests:
				|    :: Intersperse separator
				|    nums: List[Int] = [1, 2, 3]
				|    result: List[Int] = nums.intersperse(0)
				|    result.length() == 5
				|
				|    :: Separator is between elements
				|    nums: List[Int] = [1, 2, 3]
				|    result: List[Int] = nums.intersperse(0)
				|
				|    match result.get(1):
				|        Some(v):
				|            v == 0
				|        None:
				|            False
				|
				|    :: Single element unchanged
				|    one: List[Int] = [42]
				|    one
				|        .intersperse(0)
				|        .length() == 1
