-- Generated by gen_embed_std.ml --blorp; do not edit.
pure func embedded_std_source(module_name: String) -> Option[String]:
	match module_name:
		"std/argparse":
			source: String = raw
				|import:
				|	dict: dict
				|
				|
				|-- Argparse - Declarative CLI argument parser
				|--
				|-- Provides a combinator-style argument parser for CLI programs.
				|-- Parse function is pure - returns an ArgumentParseOutcome union instead of
				|-- printing directly, so the caller controls I/O.
				|--
				|-- Supports:
				|-- - Long options (--output FILE, --output=FILE)
				|-- - Short options (-o FILE)
				|-- - Boolean flags (--verbose, -v)
				|-- - Combined short flags (-vf)
				|-- - Positional arguments
				|-- - Rest args after bare "--"
				|-- - Auto --help/-h and --version
				|-- - Required args, defaults, typed values
				|--
				|-- Typical use: import the module as `argparse as Args`.
				|-- ============================================================================
				|-- Types
				|-- ============================================================================
				|private union ArgKind:
				|	Flag
				|	Opt
				|	Positional
				|
				|
				|private union ValueType:
				|	StringType
				|	IntType
				|	FloatType
				|	BoolType
				|
				|
				|record Param {
				|	name: String,
				|	kind: ArgKind,
				|	long: Option[String],
				|	short: Option[String],
				|	help: String,
				|	required: Bool,
				|	default_value: Option[String],
				|	value_type: ValueType,
				|	metavar: Option[String]
				|}
				|
				|
				|union Value:
				|	StringVal(String)
				|	IntVal(Int)
				|	FloatVal(Float)
				|	BoolVal(Bool)
				|
				|
				|record Args {
				|	values: Dict[String, Value],
				|	positional: List[String],
				|	rest: List[String]
				|}
				|
				|
				|record Cli {
				|	name: String,
				|	version: String,
				|	description: String,
				|	params: List[Param]
				|}
				|
				|
				|union ArgumentParseError:
				|	UnknownArg(String)
				|	MissingValue(String)
				|	MissingRequired(String)
				|	InvalidValue(String, String)
				|	DuplicateArg(String)
				|
				|
				|union ArgumentParseOutcome:
				|	ArgumentsParsed(Args)
				|	ArgumentsHelpRequested(String)
				|	ArgumentsVersionRequested(String)
				|	ArgumentsParseFailed(ArgumentParseError)
				|
				|
				|-- ============================================================================
				|-- Builders
				|-- ============================================================================
				|private pure func make_param(
				|	name: String,
				|	kind: ArgKind,
				|	long: Option[String],
				|	short: Option[String],
				|	help: String,
				|	req: Bool,
				|	vtype: ValueType,
				|	metavar: Option[String],
				|) -> Param:
				|	{
				|		name = name,
				|		kind = kind,
				|		long = long,
				|		short = short,
				|		help = help,
				|		required = req,
				|		default_value = None,
				|		value_type = vtype,
				|		metavar = metavar
				|	}
				|
				|
				|---
				|Create a boolean flag (e.g. --verbose, -v).
				|
				|doctests:
				|    :: Flag has correct name
				|    spec: Param = flag("verbose", Some("--verbose"), Some("-v"), "Enable verbose output")
				|    spec.name == "verbose"
				|---
				|pure func flag(
				|	name: String,
				|	long: Option[String],
				|	short: Option[String],
				|	help: String,
				|) -> Param:
				|	make_param(name, Flag, long, short, help, False, BoolType, None)
				|
				|
				|---
				|Create a named argument that takes a string value (e.g. --output FILE).
				|
				|doctests:
				|    :: Arg has correct name
				|    spec: Param = arg("output", Some("--output"), Some("-o"), "Output file", Some("FILE"))
				|    spec.name == "output"
				|---
				|pure func arg(
				|	name: String,
				|	long: Option[String],
				|	short: Option[String],
				|	help: String,
				|	metavar: Option[String],
				|) -> Param:
				|	make_param(name, Opt, long, short, help, False, StringType, metavar)
				|
				|
				|---
				|Create a named argument that takes an integer value.
				|---
				|pure func arg_int(
				|	name: String,
				|	long: Option[String],
				|	short: Option[String],
				|	help: String,
				|	metavar: Option[String],
				|) -> Param:
				|	make_param(name, Opt, long, short, help, False, IntType, metavar)
				|
				|
				|---
				|Create a named argument that takes a float value.
				|---
				|pure func arg_float(
				|	name: String,
				|	long: Option[String],
				|	short: Option[String],
				|	help: String,
				|	metavar: Option[String],
				|) -> Param:
				|	make_param(name, Opt, long, short, help, False, FloatType, metavar)
				|
				|
				|---
				|Create a positional argument.
				|
				|doctests:
				|    :: Positional is required by default
				|    spec: Param = positional("input", "Input file")
				|    spec.required == True
				|---
				|pure func positional(name: String, help: String) -> Param:
				|	make_param(name, Positional, None, None, help, True, StringType, None)
				|
				|
				|---
				|Set a default value for a param.
				|---
				|pure func with_default(spec: Param, default_val: String) -> Param:
				|	{ spec |
				|		default_value = Some(default_val),
				|		required = False
				|	}
				|
				|
				|---
				|Make an arg spec required.
				|---
				|pure func required(spec: Param) -> Param:
				|	{ spec | required = True }
				|
				|
				|-- ============================================================================
				|-- Typed Extractors
				|-- ============================================================================
				|---
				|Get a string value from parsed args by name.
				|---
				|pure func get_string(result: Args, name: String) -> Option[String]:
				|	val ?= result.values.get(name)
				|
				|	match val:
				|		StringVal(s):
				|			Some(s)
				|		_:
				|			None
				|
				|
				|---
				|Get an int value from parsed args by name.
				|---
				|pure func get_int(result: Args, name: String) -> Option[Int]:
				|	val ?= result.values.get(name)
				|
				|	match val:
				|		IntVal(n):
				|			Some(n)
				|		_:
				|			None
				|
				|
				|---
				|Get a float value from parsed args by name.
				|---
				|pure func get_float(result: Args, name: String) -> Option[Float]:
				|	val ?= result.values.get(name)
				|
				|	match val:
				|		FloatVal(f):
				|			Some(f)
				|		_:
				|			None
				|
				|
				|---
				|Get a boolean flag value. Returns False if absent.
				|---
				|pure func get_flag(result: Args, name: String) -> Bool:
				|	match result.values.get(name):
				|		Some(val):
				|			match val:
				|				BoolVal(b):
				|					b
				|				_:
				|					False
				|		None:
				|			False
				|
				|
				|---
				|Get a string value or return a default.
				|---
				|pure func get_string_or(result: Args, name: String, default: String) -> String:
				|	get_string(result, name).get_or(default)
				|
				|
				|---
				|Get an int value or return a default.
				|---
				|pure func get_int_or(result: Args, name: String, default: Int) -> Int:
				|	get_int(result, name).get_or(default)
				|
				|
				|---
				|Get a float value or return a default.
				|---
				|pure func get_float_or(result: Args, name: String, default: Float) -> Float:
				|	get_float(result, name).get_or(default)
				|
				|
				|---
				|Format an ArgumentParseError as a human-readable string.
				|---
				|pure func format_error(err: ArgumentParseError) -> String:
				|	match err:
				|		UnknownArg(arg):
				|			"unknown argument: ${arg}"
				|		MissingValue(arg):
				|			"missing value for: ${arg}"
				|		MissingRequired(name):
				|			"missing required argument: ${name}"
				|		InvalidValue(name, raw):
				|			"invalid value for ${name}: ${raw}"
				|		DuplicateArg(name):
				|			"duplicate argument: ${name}"
				|
				|
				|implements Stringable for ArgumentParseError:
				|	pure func to_string(err: ArgumentParseError) -> String:
				|		format_error(err)
				|
				|
				|-- ============================================================================
				|-- Help Text Generation
				|-- ============================================================================
				|private pure func help_header(parser: Cli) -> String:
				|	if parser.version.length() > 0:
				|		"${parser.name} v${parser.version} - ${parser.description}"
				|	else:
				|		"${parser.name} - ${parser.description}"
				|
				|
				|private pure func help_usage_line(parser: Cli) -> String:
				|	var usage: String = "Usage: ${parser.name} [OPTIONS]"
				|
				|	for s in parser.params:
				|		match s.kind:
				|			Positional:
				|				usage += " <${s.name}>"
				|			_:
				|				void
				|
				|	usage
				|
				|
				|private pure func format_option_line(spec: Param) -> String:
				|	var left: String = match spec.short:
				|		Some(short):
				|			match spec.long:
				|				Some(long):
				|					"  ${short}, ${long}"
				|				None:
				|					"  ${short}"
				|		None:
				|			match spec.long:
				|				Some(long):
				|					"      ${long}"
				|				None:
				|					"      ${spec.name}"
				|
				|	match spec.kind:
				|		Opt:
				|			match spec.metavar:
				|				Some(metavar):
				|					left += " ${metavar}"
				|				None:
				|					left += " VALUE"
				|		_:
				|			void
				|
				|	var desc: String = spec.help
				|
				|	match spec.default_value:
				|		Some(default_value):
				|			desc = "${desc} [default: ${default_value}]"
				|		None:
				|			void
				|
				|	left.pad_right(28, ' ') + desc
				|
				|
				|private pure func format_pos_line(name: String, help: String) -> String:
				|	"  <${name}>".pad_right(28, ' ') + help
				|
				|
				|private pure func generate_help(parser: Cli) -> String:
				|	var lines: List[String] = [help_header(parser), "", help_usage_line(parser), ""]
				|
				|	-- Check for positional args
				|	var has_positional: Bool = False
				|
				|	for s in parser.params:
				|		match s.kind:
				|			Positional:
				|				has_positional = True
				|			_:
				|				void
				|
				|	-- Positional arguments section
				|	if has_positional:
				|		lines = lines.append("Arguments:")
				|
				|		for s in parser.params:
				|			match s.kind:
				|				Positional:
				|					lines = lines.append(format_pos_line(s.name, s.help))
				|				_:
				|					void
				|
				|		lines = lines.append("")
				|
				|	-- Options section
				|	lines = lines.append("Options:")
				|
				|	for s in parser.params:
				|		match s.kind:
				|			Positional:
				|				void
				|			_:
				|				lines = lines.append(format_option_line(s))
				|
				|	lines = lines.append("  -h, --help".pad_right(28, ' ') + "Show this help message")
				|	lines = lines.append("      --version".pad_right(28, ' ') + "Show version")
				|	lines.join("\n")
				|
				|
				|-- ============================================================================
				|-- Value Parsing
				|-- ============================================================================
				|private pure func parse_value(raw: String, vtype: ValueType) -> Option[Value]:
				|	match vtype:
				|		StringType:
				|			Some(StringVal(raw))
				|		IntType:
				|			n ?= raw.parse_int()
				|			Some(IntVal(n))
				|		FloatType:
				|			f ?= raw.parse_float()
				|			Some(FloatVal(f))
				|		BoolType:
				|			if raw == "true":
				|				Some(BoolVal(True))
				|			else if raw == "false":
				|				Some(BoolVal(False))
				|			else:
				|				None
				|
				|
				|-- ============================================================================
				|-- Internal: Lookup index (maps --key / -k to its Param)
				|-- ============================================================================
				|private pure func build_index(specs: List[Param]) -> Dict[String, Param]:
				|	var result: Dict[String, Param] = dict()
				|
				|	for s in specs:
				|		match s.long:
				|			Some(long):
				|				result = result.set(long, s)
				|			None:
				|				void
				|
				|		match s.short:
				|			Some(short):
				|				result = result.set(short, s)
				|			None:
				|				void
				|
				|	result
				|
				|
				|-- ============================================================================
				|-- Internal: Default application and validation
				|-- ============================================================================
				|private pure func apply_defaults(
				|	values: Dict[String, Value],
				|	specs: List[Param],
				|) -> Dict[String, Value]:
				|	var result: Dict[String, Value] = values
				|
				|	for s in specs:
				|		if not result.contains(s.name):
				|			match s.default_value:
				|				Some(default_value):
				|					match parse_value(default_value, s.value_type):
				|						Some(parsed):
				|							result = result.set(s.name, parsed)
				|						None:
				|							void
				|				None:
				|					void
				|
				|	result
				|
				|
				|private pure func check_required(
				|	values: Dict[String, Value],
				|	specs: List[Param],
				|) -> Option[ArgumentParseError]:
				|	var missing: Option[ArgumentParseError] = None
				|
				|	for s in specs:
				|		if (
				|			missing.is_none()
				|			and s.required
				|			and not values.contains(s.name)
				|		):
				|			missing = Some(MissingRequired(s.name))
				|
				|	missing
				|
				|
				|private pure func short_matches(spec: Param, ch: Char) -> Bool:
				|	match spec.short:
				|		Some(short):
				|			match short.get(1):
				|				Some(short_ch):
				|					short_ch == ch
				|				None:
				|					False
				|		None:
				|			False
				|
				|
				|private pure func find_short_index(specs: List[Param], ch: Char) -> Option[Int]:
				|	var found: Option[Int] = None
				|	var idx: Int = 0
				|
				|	for s in specs:
				|		if found.is_none() and short_matches(s, ch):
				|			found = Some(idx)
				|
				|		idx += 1
				|
				|	found
				|
				|
				|private pure func short_key_for(ch: Char) -> String:
				|	"-" + ch.to_string()
				|
				|
				|-- ============================================================================
				|-- Core Parse Function
				|-- ============================================================================
				|private pure func resolve_param_value(
				|	param: Param,
				|	raw: String,
				|) -> Result[(String, Value), ArgumentParseError]:
				|	match param.value_type:
				|		IntType:
				|			raw_for_error: String = raw.substring(0, raw.length())
				|			parsed ?= parse_value(
				|				raw,
				|				param.value_type,
				|			).to_result(InvalidValue(param.name, raw_for_error))
				|			Ok((param.name, parsed))
				|		FloatType:
				|			raw_for_error: String = raw.substring(0, raw.length())
				|			parsed ?= parse_value(
				|				raw,
				|				param.value_type,
				|			).to_result(InvalidValue(param.name, raw_for_error))
				|			Ok((param.name, parsed))
				|		_:
				|			raw_for_value: String = raw.substring(0, raw.length())
				|			raw_for_error: String = raw.substring(0, raw.length())
				|			parsed ?= parse_value(
				|				raw_for_value,
				|				param.value_type,
				|			).to_result(InvalidValue(param.name, raw_for_error))
				|			Ok((param.name, parsed))
				|
				|
				|-- Resolve a key to its param, parse a raw value, return (name, parsed_value).
				|private pure func resolve_value(
				|	lookup: Dict[String, Param],
				|	key: String,
				|	raw: String,
				|) -> Result[(String, Value), ArgumentParseError]:
				|	param ?= lookup
				|		.get(key)
				|		.to_result(UnknownArg(key))
				|	resolve_param_value(param, raw)
				|
				|
				|---
				|Parse command line arguments according to an Cli spec.
				|Pure function - returns an ArgumentParseOutcome without performing any I/O.
				|Skips args[0] (program name).
				|---
				|pure func parse(parser: Cli, args: List[String]) -> ArgumentParseOutcome:
				|	-- Pre-build lookup (maps --key / -k to Param)
				|	lookup: Dict[String, Param] = build_index(parser.params)
				|
				|	-- Positional spec names
				|	var pos_names: List[String] = []
				|
				|	for s in parser.params:
				|		match s.kind:
				|			Positional:
				|				pos_names = pos_names.append(s.name)
				|			_:
				|				void
				|
				|	-- Parse state
				|	var values: Dict[String, Value] = dict()
				|	var positional_args: List[String] = []
				|	var rest_args: List[String] = []
				|	var past_separator: Bool = False
				|	var pos_index: Int = 0
				|	var error: Option[ArgumentParseError] = None
				|	var help_requested: Bool = False
				|	var version_requested: Bool = False
				|
				|	-- Skip program name at index 0, iterate from index 1
				|	var idx: Int = 1
				|	var num_args: Int = args.length()
				|
				|	while idx < num_args:
				|		match args.get(idx):
				|			Some(arg):
				|				if past_separator:
				|					rest_args = rest_args.append(arg)
				|					idx += 1
				|				else if arg == "--":
				|					past_separator = True
				|					idx += 1
				|				else if arg == "--help" or arg == "-h":
				|					help_requested = True
				|					idx = num_args
				|				else if arg == "--version":
				|					version_requested = True
				|					idx = num_args
				|				else if arg.starts_with("--"):
				|					match arg.index_of("="):
				|						Some(eq_pos):
				|							-- --key=value form
				|							key: String = arg.substring(0, eq_pos)
				|							raw_val: String = arg.substring(eq_pos + 1, arg.length() - eq_pos - 1)
				|
				|							match resolve_value(lookup, key, raw_val):
				|								Ok((sname, parsed)):
				|									values = values.set(sname, parsed)
				|								Err(e):
				|									error = Some(e)
				|
				|							idx += 1
				|						None:
				|							-- --key form (flag or option consuming next arg)
				|							match lookup.get(arg):
				|								Some(param):
				|									match param.kind:
				|										Flag:
				|											values = values.set(param.name, BoolVal(True))
				|											idx += 1
				|										Opt:
				|											if idx + 1 < num_args:
				|												match args.get(idx + 1):
				|													Some(next_arg):
				|														match resolve_value(lookup, arg, next_arg):
				|															Ok((sn, parsed)):
				|																values = values.set(sn, parsed)
				|															Err(e):
				|																error = Some(e)
				|													None:
				|														error = Some(MissingValue(arg))
				|
				|												idx += 2
				|											else:
				|												error = Some(MissingValue(arg))
				|												idx += 1
				|										Positional:
				|											idx += 1
				|								None:
				|									error = Some(UnknownArg(arg))
				|									idx += 1
				|				else if arg.starts_with("-") and arg.length() > 1:
				|					match arg.get(1):
				|						Some(first_short):
				|							-- Short option
				|							match find_short_index(parser.params, first_short):
				|								Some(param_idx):
				|									match parser.params.get(param_idx):
				|										Some(param):
				|											match param.kind:
				|												Flag:
				|													-- Combined flags: -vf
				|													var fi: Int = 1
				|													var flag_ok: Bool = True
				|
				|													while fi < arg.length() and flag_ok:
				|														match arg.get(fi):
				|															Some(flag_ch):
				|																match find_short_index(
				|																	parser.params,
				|																	flag_ch,
				|																):
				|																	Some(fp_idx):
				|																		match parser.params.get(
				|																			fp_idx,
				|																		):
				|																			Some(fp):
				|																				match fp.kind:
				|																					Flag:
				|																						values = values.set(
				|																							fp.name,
				|																							BoolVal(
				|																								True,
				|																							),
				|																						)
				|																					_:
				|																						flag_ok = False
				|																						error = Some(
				|																							MissingValue(
				|																								short_key_for(
				|																									flag_ch,
				|																								),
				|																							),
				|																						)
				|																			None:
				|																				flag_ok = False
				|																				error = Some(
				|																					UnknownArg(
				|																						short_key_for(
				|																							flag_ch,
				|																						),
				|																					),
				|																				)
				|																	None:
				|																		flag_ok = False
				|																		error = Some(
				|																			UnknownArg(
				|																				short_key_for(
				|																					flag_ch,
				|																				),
				|																			),
				|																		)
				|															None:
				|																flag_ok = False
				|
				|														fi += 1
				|
				|													idx += 1
				|												Opt:
				|													if arg.length() > 2:
				|														-- Attached value: -oFILE
				|														attached_val: String = arg.substring(
				|															2,
				|															arg.length() - 2,
				|														)
				|
				|														match resolve_param_value(
				|															param,
				|															attached_val,
				|														):
				|															Ok((sn, parsed)):
				|																values = values.set(sn, parsed)
				|															Err(e):
				|																error = Some(e)
				|
				|														idx += 1
				|													else if idx + 1 < num_args:
				|														match args.get(idx + 1):
				|															Some(next_arg):
				|																match resolve_param_value(
				|																	param,
				|																	next_arg,
				|																):
				|																	Ok((sn, parsed)):
				|																		values = values.set(
				|																			sn,
				|																			parsed,
				|																		)
				|																	Err(e):
				|																		error = Some(e)
				|															None:
				|																error = Some(
				|																	MissingValue(
				|																		short_key_for(
				|																			first_short,
				|																		),
				|																	),
				|																)
				|
				|														idx += 2
				|													else:
				|														error = Some(
				|															MissingValue(
				|																short_key_for(first_short),
				|															),
				|														)
				|														idx += 1
				|												Positional:
				|													idx += 1
				|										None:
				|											error = Some(UnknownArg(short_key_for(first_short)))
				|											idx += 1
				|								None:
				|									error = Some(UnknownArg(short_key_for(first_short)))
				|									idx += 1
				|						None:
				|							idx += 1
				|				else:
				|					-- Positional argument
				|					positional_args = positional_args.append(arg)
				|
				|					match pos_names.get(pos_index):
				|						Some(pname):
				|							values = values.set(pname, StringVal(arg))
				|						None:
				|							void
				|
				|					pos_index += 1
				|					idx += 1
				|			None:
				|				idx += 1
				|
				|	-- Post-processing: apply defaults, validate required
				|	if help_requested:
				|		ArgumentsHelpRequested(generate_help(parser))
				|	else if version_requested:
				|		ArgumentsVersionRequested("${parser.name} ${parser.version}")
				|	else:
				|		match error:
				|			Some(e):
				|				ArgumentsParseFailed(e)
				|			None:
				|				values = apply_defaults(values, parser.params)
				|
				|				match check_required(values, parser.params):
				|					Some(e):
				|						ArgumentsParseFailed(e)
				|					None:
				|						ArgumentsParsed({
				|							values = values,
				|							positional = positional_args,
				|							rest = rest_args,
				|						})
				|
			Some(source)
		"std/bool":
			source: String = raw
				|-- Bool - Boolean type trait implementations
				|--
				|-- Provides standard trait implementations for the Bool type:
				|-- - Stringable: Convert to "True" or "False"
				|-- - Logical: and, or, not operations
				|-- - Equatable: Equality comparison
				|-- - ToInt, ToFloat: Type conversions (True=1, False=0)
				|enum Bool:
				|	True
				|	False
				|
				|
				|-- Convenience helper for method-style boolean negation
				|pure func negate(val: Bool) -> Bool:
				|	not val
				|
				|
				|-- Boolean to string conversion
				|implements Stringable for Bool:
				|	pure func to_string(val: Bool) -> String:
				|		match val:
				|			True:
				|				"True"
				|			False:
				|				"False"
				|
				|
				|-- Logical operators
				|implements Logical for Bool:
				|	pure func logical_and(a: Bool, b: Bool) -> Bool:
				|		a and b
				|
				|	pure func logical_or(a: Bool, b: Bool) -> Bool:
				|		a or b
				|
				|	pure func logical_not(a: Bool) -> Bool:
				|		not a
				|
				|
				|-- Comparison operators
				|implements Equatable for Bool:
				|	pure func equals(a: Bool, b: Bool) -> Bool:
				|		a == b
				|
				|	pure func not_equals(a: Bool, b: Bool) -> Bool:
				|		a != b
				|
				|
				|-- Type conversions FROM Bool
				|implements ToInt for Bool:
				|	pure func to_int(val: Bool) -> Int:
				|		if val:
				|			1
				|		else:
				|			0
				|
				|
				|implements ToFloat for Bool:
				|	pure func to_float(val: Bool) -> Float:
				|		if val:
				|			1.0
				|		else:
				|			0.0
				|
			Some(source)
		"std/bytes":
			source: String = raw
				|-- Bytes - Immutable binary buffer with COW optimization
				|--
				|-- Bytes is a contiguous buffer of unsigned bytes (0-255) for binary data.
				|type Bytes = builtin
				|
				|
				|-- Uses ARC with COW semantics — all operations are semantically immutable.
				|-- Safe: all access is bounds-checked and returns Option for reads.
				|-- ============================================================================
				|-- Core Builtins
				|-- ============================================================================
				|---
				|Create a zero-filled Bytes buffer of the given size.
				|
				|doctests:
				|    :: Bytes buffer has correct length
				|    b: Bytes = bytes(10)
				|    b.length() == 10
				|---
				|pure func bytes(size: Int) -> Bytes:
				|	builtin("std/bytes.bytes")
				|
				|
				|-- [to_string(self: Bytes) -> String] lives below in the Stringable
				|-- implementation. It interprets bytes as UTF-8.
				|---
				|Get a byte at the given index.
				|Returns None if index is out of bounds, Some(Int) with value 0-255 otherwise.
				|
				|doctests:
				|    :: Get valid index
				|    b: Bytes = "A".to_bytes()
				|
				|    match b.get(0):
				|        Some(v):
				|            v == 65
				|        None:
				|            False
				|---
				|pure func get(self: Bytes, index: Int) -> Option[Int]:
				|	builtin("std/bytes.get")
				|
				|
				|---
				|Set a byte at the given index (COW).
				|Values are clamped to 0-255. Returns the buffer unchanged if index is OOB.
				|
				|doctests:
				|    :: Set and read back
				|    var b: Bytes = bytes(3)
				|    b = b.set_index(0, 42)
				|
				|    match b.get(0):
				|        Some(v):
				|            v == 42
				|        None:
				|            False
				|---
				|pure func set_index(self: Bytes, index: Int, value: Int) -> Bytes:
				|	builtin("std/bytes.set_index")
				|
				|
				|---
				|Extract a sub-buffer starting at `start` of length `len`.
				|
				|doctests:
				|    :: Slice middle
				|    b: Bytes = "hello".to_bytes()
				|    s: Bytes = b.slice(1, 3)
				|    s.to_string() == "ell"
				|---
				|pure func slice(self: Bytes, start: Int, len: Int) -> Bytes:
				|	builtin("std/bytes.slice")
				|
				|
				|---
				|Append another Bytes buffer (COW).
				|
				|doctests:
				|    :: Append two buffers
				|    a: Bytes = "hel".to_bytes()
				|    b: Bytes = "lo".to_bytes()
				|    c: Bytes = a.append(b)
				|    c.to_string() == "hello"
				|---
				|pure func append(a: Bytes, b: Bytes) -> Bytes:
				|	builtin("std/bytes.append")
				|
				|
				|---
				|Get the length of a Bytes buffer.
				|
				|doctests:
				|    :: Length of buffer
				|    b: Bytes = "test".to_bytes()
				|    b.length() == 4
				|---
				|pure func length(self: Bytes) -> Int:
				|	builtin("std/bytes.length")
				|
				|
				|---
				|Fill all bytes with a value (0-255), COW.
				|
				|doctests:
				|    :: Fill with value
				|    var b: Bytes = bytes(3)
				|    b = b.fill(255)
				|
				|    match b.get(0):
				|        Some(v):
				|            v == 255
				|        None:
				|            False
				|---
				|pure func fill(self: Bytes, value: Int) -> Bytes:
				|	builtin("std/bytes.fill")
				|
				|
				|---
				|Bulk copy bytes from src into dst at their respective offsets.
				|Performs a single COW check on dst and a single memcpy.
				|len is clamped so neither range exceeds its buffer's bounds.
				|
				|doctests:
				|    :: Copy region from src into dst
				|    src: Bytes = "hello".to_bytes()
				|    var dst: Bytes = bytes(5)
				|    dst = dst.blit(0, src, 1, 3)
				|    slice_result: Bytes = dst.slice(0, 3)
				|    slice_result.to_string() == "ell"
				|---
				|pure func blit(
				|	self: Bytes,
				|	dst_offset: Int,
				|	src: Bytes,
				|	src_offset: Int,
				|	len: Int,
				|) -> Bytes:
				|	builtin("std/bytes.blit")
				|
				|
				|---
				|Find the first occurrence of a byte value starting from `start`.
				|Returns None if not found.
				|
				|doctests:
				|    :: Find existing byte
				|    b: Bytes = "hello".to_bytes()
				|    b.index_of(108, 0) == Some(2)
				|---
				|pure func index_of(self: Bytes, value: Int, start: Int) -> Option[Int]:
				|	builtin("std/bytes.index_of")
				|
				|
				|---
				|Concatenate a list of Bytes buffers into one.
				|
				|doctests:
				|    :: Concat list
				|    parts: List[Bytes] = ["a".to_bytes(), "b".to_bytes(), "c".to_bytes()]
				|    parts
				|        .concat()
				|        .to_string() == "abc"
				|---
				|pure func concat(parts: List[Bytes]) -> Bytes:
				|	var total: Int = 0
				|
				|	for p in parts:
				|		total += p.length()
				|
				|	var result: Bytes = bytes(total)
				|	var pos: Int = 0
				|
				|	for p in parts:
				|		result = result.blit(pos, p, 0, p.length())
				|		pos += p.length()
				|
				|	result
				|
				|
				|-- ============================================================================
				|-- Binary Encoding
				|-- ============================================================================
				|---
				|Write a 16-bit integer at offset in big-endian byte order (COW).
				|---
				|pure func write_int16_be(self: Bytes, offset: Int, value: Int) -> Bytes:
				|	r: Bytes = self.set_index(
				|		offset,
				|		bit_and(
				|			shift_right(value, 8),
				|			255,
				|		),
				|	)
				|	r.set_index(
				|		offset + 1,
				|		bit_and(value, 255),
				|	)
				|
				|
				|---
				|Write a 16-bit integer at offset in little-endian byte order (COW).
				|---
				|pure func write_int16_le(self: Bytes, offset: Int, value: Int) -> Bytes:
				|	r: Bytes = self.set_index(
				|		offset,
				|		bit_and(value, 255),
				|	)
				|	r.set_index(
				|		offset + 1,
				|		bit_and(
				|			shift_right(value, 8),
				|			255,
				|		),
				|	)
				|
				|
				|---
				|Read a 16-bit integer at offset in big-endian byte order.
				|Returns None if not enough bytes.
				|---
				|pure func read_int16_be(self: Bytes, offset: Int) -> Option[Int]:
				|	if offset < 0 or offset + 2 > self.length():
				|		None
				|	else:
				|		hi ?= self.get(offset)
				|		lo ?= self.get(offset + 1)
				|		Some(bit_or(shift_left(hi, 8), lo))
				|
				|
				|---
				|Read a 16-bit integer at offset in little-endian byte order.
				|Returns None if not enough bytes.
				|---
				|pure func read_int16_le(self: Bytes, offset: Int) -> Option[Int]:
				|	if offset < 0 or offset + 2 > self.length():
				|		None
				|	else:
				|		lo ?= self.get(offset)
				|		hi ?= self.get(offset + 1)
				|		Some(bit_or(shift_left(hi, 8), lo))
				|
				|
				|---
				|Write a 32-bit integer at offset in big-endian byte order (COW).
				|---
				|pure func write_int32_be(self: Bytes, offset: Int, value: Int) -> Bytes:
				|	r0: Bytes = self.set_index(
				|		offset,
				|		bit_and(
				|			shift_right(value, 24),
				|			255,
				|		),
				|	)
				|	r1: Bytes = r0.set_index(
				|		offset + 1,
				|		bit_and(
				|			shift_right(value, 16),
				|			255,
				|		),
				|	)
				|	r2: Bytes = r1.set_index(
				|		offset + 2,
				|		bit_and(
				|			shift_right(value, 8),
				|			255,
				|		),
				|	)
				|	r2.set_index(
				|		offset + 3,
				|		bit_and(value, 255),
				|	)
				|
				|
				|---
				|Write a 32-bit integer at offset in little-endian byte order (COW).
				|---
				|pure func write_int32_le(self: Bytes, offset: Int, value: Int) -> Bytes:
				|	r0: Bytes = self.set_index(
				|		offset,
				|		bit_and(value, 255),
				|	)
				|	r1: Bytes = r0.set_index(
				|		offset + 1,
				|		bit_and(
				|			shift_right(value, 8),
				|			255,
				|		),
				|	)
				|	r2: Bytes = r1.set_index(
				|		offset + 2,
				|		bit_and(
				|			shift_right(value, 16),
				|			255,
				|		),
				|	)
				|	r2.set_index(
				|		offset + 3,
				|		bit_and(
				|			shift_right(value, 24),
				|			255,
				|		),
				|	)
				|
				|
				|---
				|Read a 32-bit integer at offset in big-endian byte order.
				|Returns None if not enough bytes.
				|---
				|pure func read_int32_be(self: Bytes, offset: Int) -> Option[Int]:
				|	if offset < 0 or offset + 4 > self.length():
				|		None
				|	else:
				|		b3 ?= self.get(offset)
				|		b2 ?= self.get(offset + 1)
				|		b1 ?= self.get(offset + 2)
				|		b0 ?= self.get(offset + 3)
				|		Some(bit_or(bit_or(shift_left(b3, 24), shift_left(b2, 16)), bit_or(shift_left(b1, 8), b0)))
				|
				|
				|---
				|Read a 32-bit integer at offset in little-endian byte order.
				|Returns None if not enough bytes.
				|---
				|pure func read_int32_le(self: Bytes, offset: Int) -> Option[Int]:
				|	if offset < 0 or offset + 4 > self.length():
				|		None
				|	else:
				|		b0 ?= self.get(offset)
				|		b1 ?= self.get(offset + 1)
				|		b2 ?= self.get(offset + 2)
				|		b3 ?= self.get(offset + 3)
				|		Some(bit_or(bit_or(shift_left(b3, 24), shift_left(b2, 16)), bit_or(shift_left(b1, 8), b0)))
				|
				|
				|---
				|Convert Bytes to a hex string representation.
				|---
				|pure func to_hex(self: Bytes) -> String:
				|	hex_chars: String = "0123456789abcdef"
				|	blen: Int = self.length()
				|	var result: String = ""
				|
				|	for i in 0..blen:
				|		match self.get(i):
				|			Some(b):
				|				result = result + hex_chars.substring(b / 16, 1) + hex_chars.substring(b % 16, 1)
				|			None:
				|				void
				|
				|	result
				|
				|
				|---
				|Parse a hex string into Bytes. Returns None for invalid input.
				|Accepts both uppercase and lowercase hex digits.
				|
				|doctests:
				|    :: Decode valid hex
				|    match from_hex("48656c6c6f"):
				|        Some(b):
				|            b.length() == 5
				|        None:
				|            False
				|
				|    :: Hex round-trip
				|    match from_hex("4f4b"):
				|        Some(b):
				|            to_hex(b) == "4f4b"
				|        None:
				|            False
				|
				|    :: Odd-length hex is invalid
				|    match from_hex("abc"):
				|        Some(_):
				|            False
				|        None:
				|            True
				|
				|    :: Empty hex
				|    match from_hex(""):
				|        Some(b):
				|            b.length() == 0
				|        None:
				|            False
				|---
				|pure func from_hex(s: String) -> Option[Bytes]:
				|	builtin("std/bytes.from_hex")
				|
				|
				|-- ============================================================================
				|-- UTF-8 Encoding/Decoding
				|-- ============================================================================
				|---
				|Encode a list of Unicode codepoints to UTF-8 bytes.
				|
				|doctests:
				|    :: Encode ASCII
				|    b: Bytes = encode_utf8(['H', 'i'])
				|    b.length() == 2
				|---
				|pure func encode_utf8(chars: List[Char]) -> Bytes:
				|	builtin("std/bytes.encode_utf8")
				|
				|
				|---
				|Decode UTF-8 bytes to a list of Unicode codepoints.
				|Returns None for invalid UTF-8 sequences.
				|
				|doctests:
				|    :: Decode ASCII bytes
				|    match decode_utf8("Hi".to_bytes()):
				|        Some(chars):
				|            chars.length() == 2
				|        None:
				|            False
				|
				|    :: Round-trip through encode/decode
				|    match decode_utf8(encode_utf8(['A', 'B', 'C'])):
				|        Some(chars):
				|            chars.length() == 3
				|        None:
				|            False
				|---
				|pure func decode_utf8(self: Bytes) -> Option[List[Char]]:
				|	builtin("std/bytes.decode_utf8")
				|
				|
				|-- ============================================================================
				|-- Trait Implementations
				|-- ============================================================================
				|implements HasLength for Bytes:
				|	pure func length(self: Bytes) -> Int:
				|		builtin("std/bytes.length")
				|
				|
				|---
				|Convert Bytes to a String by interpreting the bytes as UTF-8.
				|
				|doctests:
				|    :: Convert back to string
				|    b: Bytes = "world".to_bytes()
				|    b.to_string() == "world"
				|---
				|implements Stringable for Bytes:
				|	pure func to_string(self: Bytes) -> String:
				|		builtin("blorp_bytes_to_string")
				|
				|
				|-- ============================================================================
				|-- Convenience
				|-- ============================================================================
				|---
				|Check if buffer is empty.
				|---
				|pure func is_empty(self: Bytes) -> Bool:
				|	self.length() == 0
				|
			Some(source)
		"std/cache":
			source: String = raw
				|import:
				|	int: INT_MAX
				|
				|
				|-- Cache - LRU (Least Recently Used) cache with fixed capacity.
				|--
				|-- Pure, immutable cache backed by a Dict with logical timestamps.
				|-- When the cache is full, the least-recently-used entry is evicted.
				|--
				|-- Usage:
				|-- import:
				|-- cache as C
				|-- c = C.cache(100)
				|-- c = C.put(c, "key", 42)
				|-- match C.get(c, "key"):
				|-- Some(val): use(val)
				|-- None: compute()
				|--
				|-- Performance:
				|-- get:      O(1) via Dict lookup
				|-- put:      O(1) amortized, O(n) on eviction (scans for min timestamp)
				|-- contains: O(1) via Dict lookup
				|-- remove:   O(1) via Dict remove
				|-- length:   O(1)
				|---
				|LRU cache with fixed maximum capacity.
				|Entries are (value, timestamp) pairs; timestamp tracks access recency.
				|---
				|opaque type Cache[K, V] = (Int, Dict[K, (V, Int)], Int)
				|
				|
				|---
				|Create a new empty cache with the given maximum capacity.
				|
				|---
				|pure func cache[K, V](capacity: Int) -> Cache[K, V]:
				|	from_parts(capacity, {}, 0)
				|
				|
				|---
				|Look up a value in the cache without updating access time.
				|Use touch after a successful get to refresh the entry's recency.
				|
				|---
				|pure func get[K, V](cache: Cache[K, V], key: K) -> Option[V]:
				|	cache_data(cache)
				|		.get(key)
				|		.map(func(entry): entry[0])
				|
				|
				|---
				|Touch a key to refresh its access timestamp (marks it as recently used).
				|Call after get to implement LRU behavior.
				|---
				|pure func touch[K, V](cache: Cache[K, V], key: K) -> Cache[K, V]:
				|	data: Dict[K, (V, Int)] = cache_data(cache)
				|
				|	match data.get(key):
				|		Some(entry):
				|			new_counter: Int = cache_counter(cache) + 1
				|			from_parts(
				|				cache_capacity(cache),
				|				data.set(key, (entry[0], new_counter)),
				|				new_counter,
				|			)
				|		None:
				|			cache
				|
				|
				|---
				|Put a key-value pair into the cache. If the cache is at capacity,
				|the least-recently-used entry is evicted.
				|---
				|pure func put[K, V](cache: Cache[K, V], key: K, value: V) -> Cache[K, V]:
				|	capacity: Int = cache_capacity(cache)
				|	data: Dict[K, (V, Int)] = cache_data(cache)
				|	new_counter: Int = cache_counter(cache) + 1
				|
				|	if data.contains(key):
				|		from_parts(
				|			capacity,
				|			data.set(key, (value, new_counter)),
				|			new_counter,
				|		)
				|	else if data.length() >= capacity:
				|		evicted: Dict[K, (V, Int)] = evict_lru(data)
				|		from_parts(
				|			capacity,
				|			evicted.set(key, (value, new_counter)),
				|			new_counter,
				|		)
				|	else:
				|		from_parts(
				|			capacity,
				|			data.set(key, (value, new_counter)),
				|			new_counter,
				|		)
				|
				|
				|---
				|Check if a key exists in the cache (does not update access time).
				|---
				|pure func contains[K, V](cache: Cache[K, V], key: K) -> Bool:
				|	cache_data(cache).contains(key)
				|
				|
				|---
				|Get the number of entries in the cache.
				|---
				|pure func length[K, V](cache: Cache[K, V]) -> Int:
				|	cache_data(cache).length()
				|
				|
				|---
				|Remove a key from the cache.
				|---
				|pure func remove[K, V](cache: Cache[K, V], key: K) -> Cache[K, V]:
				|	from_parts(
				|		cache_capacity(cache),
				|		cache_data(cache).remove(key),
				|		cache_counter(cache),
				|	)
				|
				|
				|-- ============================================================================
				|-- Internal
				|-- ============================================================================
				|private pure func from_parts[K, V](
				|	capacity: Int,
				|	data: Dict[K, (V, Int)],
				|	counter: Int,
				|) -> Cache[K, V]:
				|	into Cache[K, V]((capacity, data, counter))
				|
				|
				|private pure func cache_parts[K, V](cache: Cache[K, V]) -> (Int, Dict[K, (V, Int)], Int):
				|	from Cache[K, V](cache)
				|
				|
				|private pure func cache_capacity[K, V](cache: Cache[K, V]) -> Int:
				|	parts: (Int, Dict[K, (V, Int)], Int) = cache_parts(cache)
				|	parts[0]
				|
				|
				|private pure func cache_data[K, V](cache: Cache[K, V]) -> Dict[K, (V, Int)]:
				|	parts: (Int, Dict[K, (V, Int)], Int) = cache_parts(cache)
				|	parts[1]
				|
				|
				|private pure func cache_counter[K, V](cache: Cache[K, V]) -> Int:
				|	parts: (Int, Dict[K, (V, Int)], Int) = cache_parts(cache)
				|	parts[2]
				|
				|
				|private pure func evict_lru[K, V](data: Dict[K, (V, Int)]) -> Dict[K, (V, Int)]:
				|	entries: List[(K, (V, Int))] = data.entries()
				|	var min_key: Option[K] = None
				|	var min_time: Int = INT_MAX
				|
				|	for entry in entries:
				|		k: K = entry[0]
				|		val_and_time: (V, Int) = entry[1]
				|		timestamp: Int = val_and_time[1]
				|
				|		if timestamp < min_time:
				|			min_time = timestamp
				|			min_key = Some(k)
				|
				|	match min_key:
				|		Some(k):
				|			data.remove(k)
				|		None:
				|			data
				|
			Some(source)
		"std/channel":
			source: String = raw
				|import:
				|	units: Duration, to_timeout_milliseconds
				|
				|
				|-- Channel - Bounded multi-producer, multi-consumer channels.
				|--
				|-- Channels are the primary synchronization primitive for [concurrent:]
				|-- blocks, [detach]ed tasks, and fiber-to-fiber message passing. Sends and
				|-- receives are fiber-aware: blocking operations park the fiber without
				|-- occupying an OS thread.
				|--
				|-- Provided by the compiler runtime.
				|type Channel[T] = builtin
				|
				|
				|-- Error returned by concurrent work when a timeout fires, a task fails, or
				|-- cancellation interrupts a blocking operation. Auto-imported for
				|-- [concurrent:] scope.
				|union ConcurrencyError:
				|	Timeout
				|	TaskFailed(String)
				|	Cancelled
				|
				|
				|-- Public name for the result produced by a fixed [concurrent:] task.
				|-- This is an alias, so existing Ok/Err matching works directly while the type
				|-- still makes the task boundary visible in annotations and documentation.
				|type alias TaskResult[T] = Result[T, ConcurrencyError]
				|
				|
				|-- Outcome returned by typed channel send-attempt helpers.
				|union SendAttempt:
				|	SendAccepted
				|	SendWouldBlock
				|	SendSealed
				|	SendTimedOut
				|
				|
				|-- Outcome returned by typed channel receive-attempt helpers. RecvWouldBlock
				|-- means no value is currently buffered, RecvSealed means the channel is sealed
				|-- and drained, and RecvTimedOut means a timed receive reached its timeout
				|-- before observing a value or seal.
				|union RecvAttempt[T]:
				|	RecvValue(T)
				|	RecvWouldBlock
				|	RecvSealed
				|	RecvTimedOut
				|
				|
				|-- Error returned by typed channel send helpers when a channel has been sealed.
				|union ChannelSealed:
				|	Sealed
				|
				|
				|-- ============================================================================
				|-- Channel construction
				|-- ============================================================================
				|---
				|Create a bounded channel with the given capacity.
				|Sending when full blocks until a slot is free; receiving when empty blocks
				|until a value arrives or the channel is sealed. Capacities less than 1 are
				|clamped to 1 so channel construction is infallible.
				|---
				|func channel[T](capacity: Int) -> Channel[T]:
				|	builtin("std/channel.channel")
				|
				|
				|-- ============================================================================
				|-- Blocking send/recv
				|-- ============================================================================
				|---
				|Compatibility blocking send. Blocks if the channel is full. Returns False if
				|the channel is sealed.
				|
				|Prefer wait_send when backpressure is intentional and the sealed case should
				|remain visible in the type. Prefer try_send_attempt when fullness is a normal
				|branch.
				|---
				|func send[T](ch: Channel[T], val: T) -> Bool:
				|	builtin("std/channel.send")
				|
				|
				|---
				|Send a value, blocking if the channel is full. Returns Ok(void) if the value
				|was accepted, or Err(Sealed) if the channel has been sealed.
				|
				|Use this when backpressure is intentional and the sealed case should remain
				|visible in the type.
				|
				|doctests:
				|    :: wait_send accepts a value
				|    ch: Channel[Int] = channel(1)
				|
				|    match wait_send(ch, 7):
				|        Ok(_):
				|            recv(ch) == Some(7)
				|        Err(_):
				|            False
				|
				|    :: wait_send reports a sealed channel
				|    ch: Channel[Int] = channel(1)
				|    seal(ch)
				|
				|    match wait_send(ch, 7):
				|        Ok(_):
				|            False
				|        Err(Sealed):
				|            True
				|---
				|func wait_send[T](ch: Channel[T], val: T) -> Result[Void, ChannelSealed]:
				|	if send(ch, val):
				|		Ok(void)
				|	else:
				|		Err(Sealed)
				|
				|
				|---
				|Receive a value. Blocks if the channel is empty. Returns None once the
				|channel is sealed and drained.
				|---
				|func recv[T](ch: Channel[T]) -> Option[T]:
				|	builtin("std/channel.recv")
				|
				|
				|---
				|Receive a value, blocking if the channel is empty. Returns Ok(value) when a
				|value is available, or Err(Sealed) once the channel is sealed and drained.
				|
				|Use this when a consumer needs the sealed case in the type instead of an
				|Option sentinel.
				|
				|doctests:
				|    :: wait_recv accepts a buffered value
				|    ch: Channel[Int] = channel(1)
				|    _ = send(ch, 7)
				|
				|    match wait_recv(ch):
				|        Ok(v):
				|            v == 7
				|        Err(_):
				|            False
				|
				|    :: wait_recv reports a sealed and drained channel
				|    ch: Channel[Int] = channel(1)
				|    seal(ch)
				|
				|    match wait_recv(ch):
				|        Ok(_):
				|            False
				|        Err(Sealed):
				|            True
				|---
				|func wait_recv[T](ch: Channel[T]) -> Result[T, ChannelSealed]:
				|	match recv(ch):
				|		Some(value):
				|			Ok(value)
				|		None:
				|			Err(Sealed)
				|
				|
				|-- ============================================================================
				|-- Non-blocking variants
				|-- ============================================================================
				|---
				|Non-blocking send. Returns False immediately if the channel is full or
				|sealed.
				|---
				|func try_send[T](ch: Channel[T], val: T) -> Bool:
				|	builtin("std/channel.try_send")
				|
				|
				|---
				|Non-blocking send with a typed outcome. Returns SendAccepted when the value was
				|accepted, SendWouldBlock when the channel is full, or SendSealed when no more
				|sends are accepted.
				|
				|doctests:
				|    :: try_send_attempt accepts when capacity is available
				|    ch: Channel[Int] = channel(1)
				|
				|    match try_send_attempt(ch, 7):
				|        SendAccepted:
				|            recv(ch) == Some(7)
				|        _:
				|            False
				|
				|    :: try_send_attempt reports a full channel
				|    ch: Channel[Int] = channel(1)
				|    _ = send(ch, 1)
				|
				|    match try_send_attempt(ch, 2):
				|        SendWouldBlock:
				|            True
				|        _:
				|            False
				|---
				|func try_send_attempt[T](ch: Channel[T], val: T) -> SendAttempt:
				|	builtin("blorp_channel_try_send_attempt")
				|
				|
				|---
				|Non-blocking receive. Returns None immediately if the channel is empty
				|or sealed.
				|---
				|func try_recv[T](ch: Channel[T]) -> Option[T]:
				|	builtin("std/channel.try_recv")
				|
				|
				|---
				|Non-blocking receive with a typed outcome. Returns RecvValue(value) when a
				|value was available, RecvWouldBlock when the channel is currently empty, or
				|RecvSealed when the channel is sealed and drained.
				|
				|The channel may be sealed by another fiber immediately after RecvWouldBlock;
				|the result describes one coherent observation of the channel state, not a
				|static refinement of the channel handle.
				|
				|doctests:
				|    :: try_recv_attempt accepts a buffered value
				|    ch: Channel[Int] = channel(1)
				|    _ = send(ch, 7)
				|
				|    match try_recv_attempt(ch):
				|        RecvValue(v):
				|            v == 7
				|        _:
				|            False
				|
				|    :: try_recv_attempt reports an empty channel
				|    ch: Channel[Int] = channel(1)
				|
				|    match try_recv_attempt(ch):
				|        RecvWouldBlock:
				|            True
				|        _:
				|            False
				|
				|    :: try_recv_attempt reports a sealed and drained channel
				|    ch: Channel[Int] = channel(1)
				|    seal(ch)
				|
				|    match try_recv_attempt(ch):
				|        RecvSealed:
				|            True
				|        _:
				|            False
				|---
				|func try_recv_attempt[T](ch: Channel[T]) -> RecvAttempt[T]:
				|	builtin("blorp_channel_try_recv_attempt")
				|
				|
				|-- ============================================================================
				|-- Timeouts
				|-- ============================================================================
				|---
				|Receive with a timeout in milliseconds. Returns None on timeout or if
				|the channel is sealed. A timeout less than or equal to 0 does not wait, but
				|still receives a value already available in the channel.
				|
				|This is a compatibility API: None intentionally does not distinguish timeout
				|from sealed-and-drained. Use wait_recv when a blocking receive needs the sealed
				|case in the type, or try_recv_attempt when a non-blocking receive needs a typed
				|outcome.
				|
				|doctests:
				|    :: recv_timeout reports sealed and drained as None
				|    ch: Channel[Int] = channel(1)
				|    seal(ch)
				|
				|    match recv_timeout(ch, 1):
				|        None:
				|            True
				|        Some(_):
				|            False
				|---
				|func recv_timeout[T](ch: Channel[T], ms: Int) -> Option[T]:
				|	builtin("std/channel.recv_timeout")
				|
				|
				|---
				|Receive with a timeout in milliseconds and a typed outcome. Returns
				|RecvValue(value) when a value arrives, RecvTimedOut when the timeout expires,
				|or RecvSealed once the channel is sealed and drained. A timeout less than or
				|equal to 0 does not wait, but still receives a value already available in the
				|channel.
				|
				|Unlike recv_timeout, this observes value, timeout, and sealed state in one
				|runtime-backed channel wait.
				|
				|doctests:
				|    :: recv_timeout_attempt reports timeout
				|    ch: Channel[Int] = channel(1)
				|
				|    match recv_timeout_attempt(ch, 1):
				|        RecvTimedOut:
				|            True
				|        _:
				|            False
				|
				|    :: recv_timeout_attempt reports sealed and drained
				|    ch: Channel[Int] = channel(1)
				|    seal(ch)
				|
				|    match recv_timeout_attempt(ch, 1):
				|        RecvSealed:
				|            True
				|        _:
				|            False
				|---
				|func recv_timeout_attempt[T](ch: Channel[T], ms: Int) -> RecvAttempt[T]:
				|	builtin("blorp_channel_recv_timeout_attempt")
				|
				|
				|---
				|Send with a timeout in milliseconds. Returns False on timeout, full
				|channel, or sealed channel. A timeout less than or equal to 0 does not wait,
				|but still sends if capacity is already available.
				|---
				|func send_timeout[T](ch: Channel[T], val: T, ms: Int) -> Bool:
				|	builtin("std/channel.send_timeout")
				|
				|
				|---
				|Receive with a typed Duration timeout and typed outcome. Returns
				|RecvValue(value) when a value arrives, RecvTimedOut when the timeout expires,
				|or RecvSealed once the channel is sealed and drained. A timeout less than or
				|equal to zero does not wait, but still receives a value already available in
				|the channel. Positive durations below one millisecond round up to one
				|millisecond.
				|
				|doctests:
				|    :: Duration recv attempt reports timeout
				|    import:
				|        units: microseconds
				|
				|    ch: Channel[Int] = channel(1)
				|    timeout: Duration = microseconds(1)
				|
				|    match recv_timeout_attempt_for(ch, timeout):
				|        RecvTimedOut:
				|            True
				|        _:
				|            False
				|---
				|func recv_timeout_attempt_for[T](ch: Channel[T], timeout: Duration) -> RecvAttempt[T]:
				|	recv_timeout_attempt(ch, to_timeout_milliseconds(timeout))
				|
				|
				|---
				|Send with a timeout and a typed outcome. Returns SendAccepted when the value
				|was accepted, SendTimedOut when capacity did not become available in time, or
				|SendSealed when no more sends are accepted. A timeout less than or equal to 0
				|does not wait, but still sends if capacity is already available.
				|
				|doctests:
				|    :: send_timeout_attempt accepts when capacity is available
				|    ch: Channel[Int] = channel(1)
				|
				|    match send_timeout_attempt(ch, 7, 100):
				|        SendAccepted:
				|            recv(ch) == Some(7)
				|        _:
				|            False
				|
				|    :: send_timeout_attempt reports a sealed channel
				|    ch: Channel[Int] = channel(1)
				|    seal(ch)
				|
				|    match send_timeout_attempt(ch, 7, 100):
				|        SendSealed:
				|            True
				|        _:
				|            False
				|---
				|func send_timeout_attempt[T](ch: Channel[T], val: T, ms: Int) -> SendAttempt:
				|	builtin("blorp_channel_send_timeout_attempt")
				|
				|
				|---
				|Send with a typed Duration timeout and typed outcome. Returns SendAccepted
				|when the value was accepted, SendTimedOut when capacity did not become
				|available in time, or SendSealed when no more sends are accepted. A timeout
				|less than or equal to zero does not wait, but still sends if capacity is
				|already available. Positive durations below one millisecond round up to one
				|millisecond.
				|
				|doctests:
				|    :: Duration send attempt reports timeout
				|    import:
				|        units: microseconds
				|
				|    ch: Channel[Int] = channel(1)
				|    _ = send(ch, 1)
				|    timeout: Duration = microseconds(1)
				|
				|    match send_timeout_attempt_for(ch, 2, timeout):
				|        SendTimedOut:
				|            True
				|        _:
				|            False
				|---
				|func send_timeout_attempt_for[T](ch: Channel[T], val: T, timeout: Duration) -> SendAttempt:
				|	send_timeout_attempt(ch, val, to_timeout_milliseconds(timeout))
				|
				|
				|-- ============================================================================
				|-- Lifecycle
				|-- ============================================================================
				|---
				|Seal the channel. Further sends fail; values already in flight are still
				|deliverable via recv/try_recv. Receivers get None once the channel is sealed
				|and drained. Idempotent.
				|---
				|func seal[T](ch: Channel[T]) -> Void:
				|	builtin("blorp_channel_seal")
				|
				|
				|-- ============================================================================
				|-- Scheduler primitives
				|-- ============================================================================
				|---
				|Sleep the current fiber for [ms] milliseconds. Fiber-aware: does not
				|block the underlying OS thread, so the scheduler can run other fibers.
				|---
				|func sleep(ms: Int) -> Void:
				|	builtin("std/channel.sleep")
				|
				|
				|---
				|Cooperatively yield the current fiber.
				|
				|This gives the scheduler a chance to run other ready fibers without installing
				|a timer or blocking an OS thread. It is a scheduling hint for tests,
				|benchmarks, and explicit cooperative handoff points; it does not guarantee that
				|another fiber runs before the current fiber resumes.
				|---
				|func yield_now() -> Void:
				|	builtin("std/channel.yield_now")
				|
				|
				|---
				|Sleep the current fiber for a typed Duration. Positive durations below one
				|millisecond round up to one millisecond so they remain real waits when
				|forwarded to the current millisecond runtime primitive.
				|---
				|func sleep_for(timeout: Duration) -> Void:
				|	sleep(to_timeout_milliseconds(timeout))
				|
				|
				|---
				|Return the number of worker threads available for [concurrent:] blocks.
				|Determined at runtime from the [BLORP_THREADS] environment variable,
				|the CLI [--threads] option, or a platform default.
				|---
				|pure func max_threads() -> Int:
				|	builtin("std/channel.max_threads")
				|
			Some(source)
		"std/char":
			source: String = raw
				|-- Char - Unicode codepoint type trait implementations
				|--
				|-- Char represents a single Unicode codepoint (up to U+10FFFF).
				|--
				|-- Provides standard trait implementations for the Char type:
				|-- - Stringable: UTF-8 encode to single-character string
				|-- - ToInt: Get numeric codepoint value
				|-- - Equatable, Orderable: Comparison operations (by codepoint value)
				|type Char = builtin
				|
				|
				|-- String conversion (UTF-8 encode)
				|implements Stringable for Char:
				|	pure func to_string(val: Char) -> String:
				|		builtin("blorp_from_char")
				|
				|
				|-- Int conversion (codepoint value)
				|implements ToInt for Char:
				|	pure func to_int(val: Char) -> Int:
				|		to_int(val)
				|
				|
				|-- Comparison operators
				|implements Equatable for Char:
				|	pure func equals(a: Char, b: Char) -> Bool:
				|		a == b
				|
				|	pure func not_equals(a: Char, b: Char) -> Bool:
				|		a != b
				|
				|
				|implements Orderable for Char:
				|	pure func less_than(a: Char, b: Char) -> Bool:
				|		a < b
				|
				|	pure func greater_than(a: Char, b: Char) -> Bool:
				|		a > b
				|
				|	pure func less_than_or_equal(a: Char, b: Char) -> Bool:
				|		a <= b
				|
				|	pure func greater_than_or_equal(a: Char, b: Char) -> Bool:
				|		a >= b
				|
			Some(source)
		"std/codec":
			source: String = raw
				|-- Codec — Universal serialization framework
				|--
				|-- Provides a format-agnostic Value type and composable decoder/encoder
				|-- combinators. Write one Decoder[T] for your type and use it with
				|-- JSON, TOML, YAML, or CSV — each format just converts to/from Value.
				|--
				|-- Encoding:  implement the Encodable trait (to_value)
				|-- Decoding:  compose a Decoder[T] from combinators (field, d_string, map3, etc.)
				|-- ============================================================================
				|-- Value Type
				|-- ============================================================================
				|---
				|Universal intermediate representation for serialized data.
				|All formats (JSON, TOML, YAML, CSV) convert to/from Value.
				|
				|doctests:
				|    :: VInt holds integer
				|    match VInt(42):
				|        VInt(n):
				|            n == 42
				|        _:
				|            False
				|
				|    :: VString holds string
				|    match VString("hello"):
				|        VString(s):
				|            s == "hello"
				|        _:
				|            False
				|---
				|union Value:
				|	VNull
				|	VBool(Bool)
				|	VInt(Int)
				|	VFloat(Float)
				|	VString(String)
				|	VList(List[Value])
				|	VRecord(List[(String, Value)])
				|
				|
				|-- ============================================================================
				|-- Value Accessors
				|-- ============================================================================
				|---
				|Extract a String from a Value, or None if not VString.
				|---
				|pure func as_string(v: Value) -> Option[String]:
				|	match v:
				|		VString(s):
				|			Some(s)
				|		_:
				|			None
				|
				|
				|---
				|Extract an Int from a Value, or None if not VInt.
				|---
				|pure func as_int(v: Value) -> Option[Int]:
				|	match v:
				|		VInt(n):
				|			Some(n)
				|		_:
				|			None
				|
				|
				|---
				|Extract a Float from a Value. Coerces VInt to Float. None otherwise.
				|---
				|pure func as_float(v: Value) -> Option[Float]:
				|	match v:
				|		VFloat(f):
				|			Some(f)
				|		VInt(n):
				|			Some(to_float(n))
				|		_:
				|			None
				|
				|
				|---
				|Extract a Bool from a Value, or None if not VBool.
				|---
				|pure func as_bool(v: Value) -> Option[Bool]:
				|	match v:
				|		VBool(b):
				|			Some(b)
				|		_:
				|			None
				|
				|
				|---
				|Extract a List from a Value, or None if not VList.
				|---
				|pure func as_list(v: Value) -> Option[List[Value]]:
				|	match v:
				|		VList(items):
				|			Some(items)
				|		_:
				|			None
				|
				|
				|---
				|Extract a record (list of key-value pairs) from a Value, or None if not VRecord.
				|---
				|pure func as_record(v: Value) -> Option[List[(String, Value)]]:
				|	match v:
				|		VRecord(pairs):
				|			Some(pairs)
				|		_:
				|			None
				|
				|
				|---
				|Check if a Value is VNull.
				|---
				|pure func is_null(v: Value) -> Bool:
				|	match v:
				|		VNull:
				|			True
				|		_:
				|			False
				|
				|
				|---
				|Look up a field in a VRecord by key.
				|
				|doctests:
				|    :: Field lookup
				|    v: Value = VRecord([("name", VString("Alice"))])
				|
				|    match v.get_field("name"):
				|        Some(VString(s)):
				|            s == "Alice"
				|        _:
				|            False
				|
				|    :: Missing field
				|    v2: Value = VRecord([("x", VInt(1))])
				|
				|    match v2.get_field("y"):
				|        None:
				|            True
				|        _:
				|            False
				|---
				|pure func get_field(v: Value, key: String) -> Option[Value]:
				|	match v:
				|		VRecord(pairs):
				|			var i: Int = 0
				|			var found: Option[Value] = None
				|			var done: Bool = False
				|
				|			while i < pairs.length() and not done:
				|				match pairs.get(i):
				|					Some(pair):
				|						if pair[0] == key:
				|							found = Some(pair[1])
				|							done = True
				|					None:
				|						void
				|
				|				i += 1
				|
				|			found
				|		_:
				|			None
				|
				|
				|-- ============================================================================
				|-- Encode Trait
				|-- ============================================================================
				|---
				|Trait for types that can be serialized to a Value.
				|Implement this for your records to enable multi-format encoding.
				|---
				|trait Encodable:
				|	pure func to_value(self: Self) -> Value
				|
				|
				|implements Encodable for Int:
				|	pure func to_value(val: Int) -> Value:
				|		VInt(val)
				|
				|
				|implements Encodable for Float:
				|	pure func to_value(val: Float) -> Value:
				|		VFloat(val)
				|
				|
				|implements Encodable for String:
				|	pure func to_value(val: String) -> Value:
				|		VString(val)
				|
				|
				|implements Encodable for Bool:
				|	pure func to_value(val: Bool) -> Value:
				|		VBool(val)
				|
				|
				|-- ============================================================================
				|-- Decode Error
				|-- ============================================================================
				|---
				|Error from decoding, with a path trace showing where the error occurred.
				|
				|doctests:
				|    :: Error with empty path
				|    e: DecodeError = {
				|        path = [],
				|        message = "bad"
				|    }
				|    e.format_error() == "bad"
				|
				|    :: Error with path
				|    e2: DecodeError = {
				|        path = ["user", "name"],
				|        message = "expected string"
				|    }
				|    e2.format_error() == "at user.name: expected string"
				|---
				|record DecodeError {
				|	path: List[String],
				|	message: String
				|}
				|
				|
				|---
				|Format a DecodeError as a human-readable string.
				|---
				|pure func format_error(err: DecodeError) -> String:
				|	if err.path.length() == 0:
				|		err.message
				|	else:
				|		path_str: String = err.path.join_path()
				|		"at ${path_str}: ${err.message}"
				|
				|
				|private pure func join_path(parts: List[String]) -> String:
				|	var result: String = ""
				|	var i: Int = 0
				|
				|	while i < parts.length():
				|		match parts.get(i):
				|			Some(part):
				|				if i > 0:
				|					result = result + "." + part
				|				else:
				|					result = part
				|			None:
				|				void
				|
				|		i += 1
				|
				|	result
				|
				|
				|private pure func prepend_path(field_name: String, err: DecodeError) -> DecodeError:
				|	new_path: List[String] = [field_name].concat(err.path)
				|	{
				|		path = new_path,
				|		message = err.message
				|	}
				|
				|
				|private pure func make_error(msg: String) -> DecodeError:
				|	{
				|		path = [],
				|		message = msg
				|	}
				|
				|
				|-- ============================================================================
				|-- Decoder Type
				|-- ============================================================================
				|---
				|A decoder is a pure function from Value to Result.
				|Compose decoders with field(), map2(), etc.
				|---
				|type alias Decoder[T] = pure (Value) -> Result[T, DecodeError]
				|
				|
				|---
				|Run a decoder on a Value.
				|---
				|pure func decode[T](decoder: Decoder[T], value: Value) -> Result[T, DecodeError]:
				|	decoder(value)
				|
				|
				|-- ============================================================================
				|-- Primitive Decoders
				|-- ============================================================================
				|---
				|Decode a string. Accepts VString only.
				|
				|doctests:
				|    :: Decode string
				|    match d_string(VString("hi")):
				|        Ok(s):
				|            s == "hi"
				|        _:
				|            False
				|
				|    :: Reject int
				|    match d_string(VInt(1)):
				|        Err(_):
				|            True
				|        _:
				|            False
				|---
				|pure func d_string(v: Value) -> Result[String, DecodeError]:
				|	match v:
				|		VString(s):
				|			Ok(s)
				|		_:
				|			Err(make_error("expected string"))
				|
				|
				|---
				|Decode an integer. Accepts VInt, coerces VFloat (truncates) and VString (parses).
				|
				|doctests:
				|    :: Decode VInt
				|    match d_int(VInt(42)):
				|        Ok(n):
				|            n == 42
				|        _:
				|            False
				|
				|    :: Coerce VFloat
				|    match d_int(VFloat(3.9)):
				|        Ok(n):
				|            n == 3
				|        _:
				|            False
				|
				|    :: Coerce VString
				|    match d_int(VString("99")):
				|        Ok(n):
				|            n == 99
				|        _:
				|            False
				|
				|    :: Reject bad string
				|    match d_int(VString("abc")):
				|        Err(_):
				|            True
				|        _:
				|            False
				|---
				|pure func d_int(v: Value) -> Result[Int, DecodeError]:
				|	match v:
				|		VInt(n):
				|			Ok(n)
				|		VFloat(f):
				|			Ok(to_int(f))
				|		VString(s):
				|			match s.parse_int():
				|				Some(n):
				|					Ok(n)
				|				None:
				|					Err(make_error("expected integer, got: " + s))
				|		_:
				|			Err(make_error("expected integer"))
				|
				|
				|---
				|Decode a float. Accepts VFloat, coerces VInt and VString.
				|
				|doctests:
				|    :: Decode VFloat
				|    match d_float(VFloat(3.14)):
				|        Ok(f):
				|            f > 3.13 and f < 3.15
				|        _:
				|            False
				|
				|    :: Coerce VInt
				|    match d_float(VInt(5)):
				|        Ok(f):
				|            f > 4.99 and f < 5.01
				|        _:
				|            False
				|---
				|pure func d_float(v: Value) -> Result[Float, DecodeError]:
				|	match v:
				|		VFloat(f):
				|			Ok(f)
				|		VInt(n):
				|			Ok(to_float(n))
				|		VString(s):
				|			match s.parse_float():
				|				Some(f):
				|					Ok(f)
				|				None:
				|					Err(make_error("expected number, got: " + s))
				|		_:
				|			Err(make_error("expected number"))
				|
				|
				|---
				|Decode a boolean. Accepts VBool only.
				|
				|doctests:
				|    :: Decode true
				|    match d_bool(VBool(True)):
				|        Ok(b):
				|            b == True
				|        _:
				|            False
				|---
				|pure func d_bool(v: Value) -> Result[Bool, DecodeError]:
				|	match v:
				|		VBool(b):
				|			Ok(b)
				|		_:
				|			Err(make_error("expected boolean"))
				|
				|
				|---
				|Decode a null value. Accepts VNull only.
				|---
				|pure func d_null(v: Value) -> Result[Bool, DecodeError]:
				|	match v:
				|		VNull:
				|			Ok(True)
				|		_:
				|			Err(make_error("expected null"))
				|
				|
				|-- ============================================================================
				|-- Combinators
				|-- ============================================================================
				|---
				|Decode a required field from a VRecord.
				|---
				|pure func field[T](name: String, decoder: Decoder[T]) -> Decoder[T]:
				|	pure func(v: Value) -> Result[T, DecodeError]:
				|		field_value ?= v
				|			.get_field(name)
				|			.to_result(make_error("missing field: ${name}"))
				|		val ?= decoder(field_value).map_err(func(e: DecodeError): prepend_path(name, e))
				|		Ok(val)
				|
				|
				|---
				|Decode an optional field. Returns None if missing or null.
				|---
				|pure func optional[T](name: String, decoder: Decoder[T]) -> Decoder[Option[T]]:
				|	pure func(v: Value) -> Result[Option[T], DecodeError]:
				|		match v.get_field(name):
				|			Some(field_value):
				|				match field_value:
				|					VNull:
				|						Ok(None)
				|					_:
				|						val ?= decoder(
				|							field_value,
				|						).map_err(
				|							func(e: DecodeError): prepend_path(name, e),
				|						)
				|						Ok(Some(val))
				|			None:
				|				Ok(None)
				|
				|
				|-- ============================================================================
				|-- Direct field accessors (convenience: decode a single field right now
				|-- instead of building a Decoder[T] and running it later).
				|-- ============================================================================
				|---
				|Decode a required integer field from a VRecord. Shortcut for
				|`decode(field(name, d_int), obj)`.
				|
				|doctests:
				|    :: Read Int field
				|    v: Value = VRecord([("age", VInt(42))])
				|
				|    match field_int(v, "age"):
				|        Ok(n):
				|            n == 42
				|        _:
				|            False
				|
				|    :: Missing field errors
				|    v: Value = VRecord([])
				|
				|    match field_int(v, "age"):
				|        Err(_):
				|            True
				|        _:
				|            False
				|---
				|pure func field_int(obj: Value, name: String) -> Result[Int, DecodeError]:
				|	field(name, d_int)(obj)
				|
				|
				|---
				|Decode a required float field from a VRecord.
				|---
				|pure func field_float(obj: Value, name: String) -> Result[Float, DecodeError]:
				|	field(name, d_float)(obj)
				|
				|
				|---
				|Decode a required string field from a VRecord.
				|---
				|pure func field_string(obj: Value, name: String) -> Result[String, DecodeError]:
				|	field(name, d_string)(obj)
				|
				|
				|---
				|Decode a required boolean field from a VRecord.
				|---
				|pure func field_bool(obj: Value, name: String) -> Result[Bool, DecodeError]:
				|	field(name, d_bool)(obj)
				|
				|
				|---
				|Decode a required list-of-T field from a VRecord. The `item` argument picks
				|the element type — pass `d_int`, `d_string`, etc. At call sites in modules
				|where the `Decoder` alias isn't in scope, passing a `d_*` decoder requires
				|importing `Decoder` alongside (Triage Cluster 8 — type-alias unification).
				|---
				|pure func field_list[T](obj: Value, name: String, item: Decoder[T]) -> Result[List[T], DecodeError]:
				|	field(name, d_list(item))(obj)
				|
				|
				|---
				|Decode a list of values using an item decoder.
				|---
				|pure func d_list[T](item_decoder: Decoder[T]) -> Decoder[List[T]]:
				|	pure func(v: Value) -> Result[List[T], DecodeError]:
				|		match v.as_list():
				|			Some(items):
				|				var result: List[T] = []
				|				var i: Int = 0
				|				var err: Option[DecodeError] = None
				|				var has_error: Bool = False
				|
				|				while i < items.length() and not has_error:
				|					match items.get(i):
				|						Some(elem):
				|							match item_decoder(elem):
				|								Ok(val):
				|									result = result.append(val)
				|								Err(e):
				|									err = Some(prepend_path("[" + i.to_string() + "]", e))
				|									has_error = True
				|						None:
				|							void
				|
				|					i += 1
				|
				|				match err:
				|					Some(e):
				|						Err(e)
				|					None:
				|						Ok(result)
				|			None:
				|				Err(make_error("expected list"))
				|
				|
				|---
				|Decode a nested field path like ["user", "address", "city"].
				|---
				|pure func at[T](path: List[String], decoder: Decoder[T]) -> Decoder[T]:
				|	if path.length() == 0:
				|		decoder
				|	else:
				|		match path.get(0):
				|			Some(first):
				|				rest: List[String] = path.drop(1)
				|
				|				field(
				|					first,
				|					at(rest, decoder),
				|				)
				|			None:
				|				decoder
				|
				|
				|---
				|Decode an element at a specific index in a VList.
				|---
				|pure func index[T](idx: Int, decoder: Decoder[T]) -> Decoder[T]:
				|	pure func(v: Value) -> Result[T, DecodeError]:
				|		items ?= v
				|			.as_list()
				|			.to_result(make_error("expected list"))
				|		elem ?= items
				|			.get(idx)
				|			.to_result(make_error("index out of bounds: ${idx.to_string()}"))
				|		val ?= decoder(elem).map_err(func(e: DecodeError): prepend_path("[${idx.to_string()}]", e))
				|		Ok(val)
				|
				|
				|---
				|Decode a nullable value. VNull becomes None, anything else is decoded as Some.
				|---
				|pure func d_nullable[T](decoder: Decoder[T]) -> Decoder[Option[T]]:
				|	pure func(v: Value) -> Result[Option[T], DecodeError]:
				|		match v:
				|			VNull:
				|				Ok(None)
				|			_:
				|				val ?= decoder(v)
				|				Ok(Some(val))
				|
				|
				|---
				|Transform a decoder's output with a function.
				|---
				|pure func d_map[A, B](
				|	decoder: Decoder[A],
				|	f: pure (A) -> B,
				|) -> Decoder[B]:
				|	pure func(v: Value) -> Result[B, DecodeError]:
				|		val ?= decoder(v)
				|		Ok(f(val))
				|
				|
				|---
				|A decoder that always succeeds with a given value, ignoring the input.
				|---
				|pure func d_succeed[T](value: T) -> Decoder[T]:
				|	pure func(_: Value) -> Result[T, DecodeError]: Ok(value)
				|
				|
				|---
				|A decoder that always fails with a given message.
				|---
				|pure func d_fail[T](message: String) -> Decoder[T]:
				|	pure func(_: Value) -> Result[T, DecodeError]: Err(make_error(message))
				|
				|
				|---
				|Try the first decoder; if it fails, try the second.
				|---
				|pure func d_or_else[T](first: Decoder[T], second: Decoder[T]) -> Decoder[T]:
				|	pure func(v: Value) -> Result[T, DecodeError]:
				|		match first(v):
				|			Ok(val):
				|				Ok(val)
				|			Err(_):
				|				second(v)
				|
				|
				|---
				|Return a default value if the decoder fails.
				|---
				|pure func d_with_default[T](decoder: Decoder[T], default_value: T) -> Decoder[T]:
				|	pure func(v: Value) -> Result[T, DecodeError]:
				|		match decoder(v):
				|			Ok(val):
				|				Ok(val)
				|			Err(_):
				|				Ok(default_value)
				|
				|
				|---
				|Lazy decoder for recursive structures.
				|---
				|pure func d_lazy[T](thunk: pure () -> Decoder[T]) -> Decoder[T]:
				|	pure func(v: Value) -> Result[T, DecodeError]:
				|		thunk()(v)
				|
				|
				|-- ============================================================================
				|-- Map Combinators
				|-- ============================================================================
				|---
				|Combine two decoders with a function.
				|---
				|pure func map2[A, B, R](
				|	f: pure (A, B) -> R,
				|	d1: Decoder[A],
				|	d2: Decoder[B],
				|) -> Decoder[R]:
				|	pure func(v: Value) -> Result[R, DecodeError]:
				|		a ?= d1(v)
				|		b ?= d2(v)
				|		Ok(f(a, b))
				|
				|
				|---
				|Combine three decoders with a function.
				|---
				|pure func map3[A, B, C, R](
				|	f: pure (A, B, C) -> R,
				|	d1: Decoder[A],
				|	d2: Decoder[B],
				|	d3: Decoder[C],
				|) -> Decoder[R]:
				|	pure func(v: Value) -> Result[R, DecodeError]:
				|		a ?= d1(v)
				|		b ?= d2(v)
				|		c ?= d3(v)
				|		Ok(f(a, b, c))
				|
				|
				|---
				|Combine four decoders with a function.
				|---
				|pure func map4[A, B, C, D, R](
				|	f: pure (A, B, C, D) -> R,
				|	d1: Decoder[A],
				|	d2: Decoder[B],
				|	d3: Decoder[C],
				|	d4: Decoder[D],
				|) -> Decoder[R]:
				|	pure func(v: Value) -> Result[R, DecodeError]:
				|		a ?= d1(v)
				|		b ?= d2(v)
				|		c ?= d3(v)
				|		d ?= d4(v)
				|		Ok(f(a, b, c, d))
				|
				|
				|---
				|Combine five decoders with a function.
				|---
				|pure func map5[A, B, C, D, E, R](
				|	f: pure (A, B, C, D, E) -> R,
				|	d1: Decoder[A],
				|	d2: Decoder[B],
				|	d3: Decoder[C],
				|	d4: Decoder[D],
				|	d5: Decoder[E],
				|) -> Decoder[R]:
				|	pure func(v: Value) -> Result[R, DecodeError]:
				|		a ?= d1(v)
				|		b ?= d2(v)
				|		c ?= d3(v)
				|		d ?= d4(v)
				|		e ?= d5(v)
				|		Ok(f(a, b, c, d, e))
				|
				|
				|---
				|Combine six decoders with a function.
				|---
				|pure func map6[A, B, C, D, E, F, R](
				|	func_: pure (A, B, C, D, E, F) -> R,
				|	d1: Decoder[A],
				|	d2: Decoder[B],
				|	d3: Decoder[C],
				|	d4: Decoder[D],
				|	d5: Decoder[E],
				|	d6: Decoder[F],
				|) -> Decoder[R]:
				|	pure func(v: Value) -> Result[R, DecodeError]:
				|		a ?= d1(v)
				|		b ?= d2(v)
				|		c ?= d3(v)
				|		d ?= d4(v)
				|		e ?= d5(v)
				|		f ?= d6(v)
				|		Ok(func_(a, b, c, d, e, f))
				|
				|
				|-- ============================================================================
				|-- Value Serialization (debug format)
				|-- ============================================================================
				|---
				|Serialize a Value to a debug string representation.
				|
				|doctests:
				|    :: Null
				|    VNull.value_to_string() == "null"
				|
				|    :: Int
				|    VInt(42).value_to_string() == "42"
				|
				|    :: String
				|    VString("hi").value_to_string() == "\"hi\""
				|---
				|pure func value_to_string(v: Value) -> String:
				|	match v:
				|		VNull:
				|			"null"
				|		VBool(b):
				|			if b:
				|				"true"
				|			else:
				|				"false"
				|		VInt(n):
				|			n.to_string()
				|		VFloat(f):
				|			f.to_string()
				|		VString(s):
				|			"\"" + s + "\""
				|		VList(items):
				|			parts: List[String] = items.map(func(item: Value): item.value_to_string())
				|			"[" + parts.join(", ") + "]"
				|		VRecord(pairs):
				|			parts: List[String] = pairs.map(
				|				func(pair: (String, Value)): "\"" + pair[0] + "\": " + pair[1].value_to_string(),
				|			)
				|			"{" + parts.join(", ") + "}"
				|
			Some(source)
		"std/codec_bridge":
			source: String = raw
				|-- Codec Bridge — Convert format-specific values to universal codec.Value
				|--
				|-- Bridges between JSON, TOML, CSV and the codec serialization framework.
				|-- Import this module to use codec.Decoder[T] with parsed JSON/TOML/CSV data.
				|--
				|-- Typical use: import the conversion functions you need from `codec_bridge`.
				|import:
				|	codec: Value(VBool, VFloat, VInt, VList, VNull, VRecord, VString)
				|	json: JsonValue(JsonBool, JsonNull, JsonNumber, JsonObject, JsonString, JsonVector)
				|	toml: TomlValue(TomlArray, TomlBool, TomlFloat, TomlInt, TomlString, TomlTable)
				|
				|
				|-- ============================================================================
				|-- JSON -> Value
				|-- ============================================================================
				|---
				|Convert a JsonValue to a universal codec Value.
				|
				|doctests:
				|    :: Null converts
				|    match JsonNull.json_to_value():
				|        VNull:
				|            True
				|        _:
				|            False
				|
				|    :: String converts
				|    match JsonString("hi").json_to_value():
				|        VString(s):
				|            s == "hi"
				|        _:
				|            False
				|---
				|pure func json_to_value(json: JsonValue) -> Value:
				|	match json:
				|		JsonNull:
				|			VNull
				|		JsonBool(b):
				|			VBool(b)
				|		JsonNumber(n):
				|			VFloat(n)
				|		JsonString(s):
				|			VString(s)
				|		JsonVector(items):
				|			VList(items.map(
				|				func(item: JsonValue): item.json_to_value(),
				|			))
				|		JsonObject(pairs):
				|			VRecord(pairs.map(
				|				func(pair: (String, JsonValue)): (pair[0], pair[1].json_to_value()),
				|			))
				|
				|
				|-- ============================================================================
				|-- TOML -> Value
				|-- ============================================================================
				|---
				|Convert a TomlValue to a universal codec Value.
				|
				|doctests:
				|    :: Int converts
				|    match TomlInt(42).toml_to_value():
				|        VInt(n):
				|            n == 42
				|        _:
				|            False
				|
				|    :: String converts
				|    match TomlString("hi").toml_to_value():
				|        VString(s):
				|            s == "hi"
				|        _:
				|            False
				|---
				|pure func toml_to_value(toml: TomlValue) -> Value:
				|	match toml:
				|		TomlString(s):
				|			VString(s)
				|		TomlInt(n):
				|			VInt(n)
				|		TomlFloat(f):
				|			VFloat(f)
				|		TomlBool(b):
				|			VBool(b)
				|		TomlArray(items):
				|			VList(items.map(
				|				func(item: TomlValue): item.toml_to_value(),
				|			))
				|		TomlTable(dict):
				|			pairs: List[(String, TomlValue)] = dict.entries()
				|			VRecord(pairs.map(
				|				func(pair: (String, TomlValue)): (pair[0], pair[1].toml_to_value()),
				|			))
				|
				|
				|-- ============================================================================
				|-- CSV -> Value
				|-- ============================================================================
				|---
				|Convert a CSV row to a universal codec Value using headers as field names.
				|All values become VString — use codec decoders (d_int, d_float) for type coercion.
				|
				|doctests:
				|    :: Row converts
				|    v: Value = csv_row_to_value(
				|        ["name", "age"],
				|        ["Alice", "30"],
				|    )
				|
				|    match v:
				|        VRecord(pairs):
				|            pairs.length() == 2
				|        _:
				|            False
				|---
				|pure func csv_row_to_value(headers: List[String], row: List[String]) -> Value:
				|	pairs: List[(String, Value)] = headers
				|		.enumerate()
				|		.filter_map(func(indexed: (Int, String)) -> Option[(String, Value)]:
				|			match row.get(indexed[0]):
				|				Some(value):
				|					Some((indexed[1], VString(value)))
				|				None:
				|					None
				|		)
				|
				|	VRecord(pairs)
				|
				|
				|-- ============================================================================
				|-- Value -> JSON
				|-- ============================================================================
				|---
				|Convert a universal codec Value to a JsonValue. Inverse of [json_to_value].
				|
				|VInt is widened to JsonNumber(Float) because JsonValue only carries one
				|numeric variant; large integers may lose precision. All other variants
				|round-trip losslessly.
				|
				|Use this when you need JSON output from a codec Value. JsonValue's Stringable
				|implementation handles common escapes; codec's own value_to_string is a debug
				|format.
				|
				|doctests:
				|    :: Null round-trips
				|    match VNull.value_to_json():
				|        JsonNull:
				|            True
				|        _:
				|            False
				|
				|    :: String round-trips
				|    match VString("hi").value_to_json():
				|        JsonString(s):
				|            s == "hi"
				|        _:
				|            False
				|
				|    :: Int widens to Number
				|    match VInt(42).value_to_json():
				|        JsonNumber(n):
				|            n > 41.9 and n < 42.1
				|        _:
				|            False
				|---
				|pure func value_to_json(v: Value) -> JsonValue:
				|	match v:
				|		VNull:
				|			JsonNull
				|		VBool(b):
				|			JsonBool(b)
				|		VInt(n):
				|			JsonNumber(to_float(n))
				|		VFloat(f):
				|			JsonNumber(f)
				|		VString(s):
				|			JsonString(s)
				|		VList(items):
				|			JsonVector(items.map(
				|				func(item: Value): item.value_to_json(),
				|			))
				|		VRecord(pairs):
				|			JsonObject(pairs.map(
				|				func(pair: (String, Value)): (pair[0], pair[1].value_to_json()),
				|			))
				|
			Some(source)
		"std/compiler_runtime":
			source: String = raw
				|-- Compiler executable support.
				|--
				|-- Ordinary programs receive empty source values. The Blorp compiler executable
				|-- links a generated provider containing the exact runtime translation unit and
				|-- declarations used for artifact writing and runtime-object compilation.
				|
				|private pure func compiler_runtime_source_raw() -> String:
				|	builtin("blorp_compiler_runtime_source")
				|
				|
				|private pure func compiler_runtime_declarations_raw() -> String:
				|	builtin("blorp_compiler_runtime_decl")
				|
				|
				|record CompilerRuntimeSources {
				|	runtime: String,
				|	declarations: String
				|}
				|
				|
				|pure func compiler_runtime_sources() -> CompilerRuntimeSources:
				|	{
				|		runtime = compiler_runtime_source_raw(),
				|		declarations = compiler_runtime_declarations_raw()
				|	}
				|
			Some(source)
		"std/crypto_random":
			source: String = raw
				|---
				|Generate n cryptographically secure random bytes.
				|
				|doctests:
				|    :: Random bytes has correct length
				|    b: Bytes = crypto_random_bytes(16)
				|    b.length() == 16
				|
				|    :: Zero bytes returns empty
				|    b: Bytes = crypto_random_bytes(0)
				|    b.length() == 0
				|---
				|func crypto_random_bytes(n: Int) -> Bytes:
				|	builtin("blorp_crypto_random_bytes")
				|
				|
				|---
				|Generate n random bytes and return as hex string (2n characters).
				|
				|doctests:
				|    :: Hex has correct length
				|    h: String = random_hex(8)
				|    h.length() == 16
				|---
				|func random_hex(n: Int) -> String:
				|	crypto_random_bytes(n).to_hex()
				|
				|
				|---
				|Generate a URL-safe base64 token from n random bytes.
				|Uses base64url encoding (- instead of +, _ instead of /, no padding).
				|
				|doctests:
				|    :: Token is non-empty
				|    t: String = random_token(16)
				|    t.length() > 0
				|---
				|func random_token(n: Int) -> String:
				|	raw: String = crypto_random_bytes(n)
				|		.to_string()
				|		.base64_encode()
				|	no_plus: String = raw.replace("+", "-")
				|	no_slash: String = no_plus.replace("/", "_")
				|	strip_padding(no_slash)
				|
				|
				|private pure func strip_padding(s: String) -> String:
				|	len: Int = s.length()
				|
				|	if len == 0:
				|		s
				|	else:
				|		last: String = s.substring(len - 1, 1)
				|
				|		if last == "=":
				|			strip_padding(s.substring(0, len - 1))
				|		else:
				|			s
				|
			Some(source)
		"std/csv":
			source: String = raw
				|import:
				|	dict as Dicts
				|	string: from_char, string
				|
				|
				|-- CSV Parser and Formatter
				|-- RFC 4180 compliant: quoted fields, embedded commas/newlines, escaped quotes
				|-- ============================================================================
				|-- Types
				|-- ============================================================================
				|record CsvConfig {
				|	delimiter: Char,
				|	quote_char: Char
				|}
				|
				|
				|record CsvError {
				|	line: Int,
				|	column: Int,
				|	message: String
				|}
				|
				|
				|-- ============================================================================
				|-- Config Constructors
				|-- ============================================================================
				|pure func default_config() -> CsvConfig:
				|	{
				|		delimiter = ',',
				|		quote_char = '\"'
				|	}
				|
				|
				|pure func tsv_config() -> CsvConfig:
				|	{
				|		delimiter = '\t',
				|		quote_char = '\"'
				|	}
				|
				|
				|-- ============================================================================
				|-- Internal: Field Parsing
				|-- ============================================================================
				|private pure func parse_quoted_field(input: String, pos: Int, config: CsvConfig) -> (String, Int):
				|	var i: Int = pos + 1
				|	var result: String = string(16)
				|	var done: Bool = False
				|
				|	while not done:
				|		match input.get(i):
				|			Some(c):
				|				if c == config.quote_char:
				|					match input.get(i + 1):
				|						Some(next):
				|							if next == config.quote_char:
				|								result = result.append_char(config.quote_char)
				|								i += 2
				|							else:
				|								done = True
				|								i += 1
				|						None:
				|							done = True
				|							i += 1
				|				else:
				|					result = result.append_char(c)
				|					i += 1
				|			None:
				|				done = True
				|
				|	(result, i)
				|
				|
				|private pure func parse_unquoted_field(input: String, pos: Int, config: CsvConfig) -> (String, Int):
				|	var i: Int = pos
				|	var result: String = string(16)
				|	var done: Bool = False
				|
				|	while not done:
				|		match input.get(i):
				|			Some(c):
				|				if (
				|					c == config.delimiter
				|					or c == '\n'
				|					or c == '\r'
				|				):
				|					done = True
				|				else:
				|					result = result.append_char(c)
				|					i += 1
				|			None:
				|				done = True
				|
				|	(result, i)
				|
				|
				|private pure func parse_field(input: String, pos: Int, config: CsvConfig) -> (String, Int):
				|	match input.get(pos):
				|		Some(c):
				|			if c == config.quote_char:
				|				parse_quoted_field(input, pos, config)
				|			else:
				|				parse_unquoted_field(input, pos, config)
				|		None:
				|			("", pos)
				|
				|
				|-- ============================================================================
				|-- Internal: Row and Document Parsing
				|-- ============================================================================
				|private pure func parse_row(input: String, pos: Int, config: CsvConfig) -> (List[String], Int):
				|	var fields: List[String] = []
				|	var i: Int = pos
				|	var done: Bool = False
				|
				|	while not done:
				|		field_result: (String, Int) = parse_field(input, i, config)
				|		fields = fields.append(field_result[0])
				|		i = field_result[1]
				|
				|		if i >= input.length():
				|			done = True
				|		else:
				|			match input.get(i):
				|				Some(c):
				|					if c == config.delimiter:
				|						i += 1
				|					else:
				|						done = True
				|				None:
				|					done = True
				|
				|	(fields, i)
				|
				|
				|private pure func skip_newline(input: String, pos: Int) -> Int:
				|	match input.get(pos):
				|		Some(c):
				|			if c == '\r':
				|				match input.get(pos + 1):
				|					Some(n):
				|						if n == '\n':
				|							pos + 2
				|						else:
				|							pos + 1
				|					None:
				|						pos + 1
				|			else if c == '\n':
				|				pos + 1
				|			else:
				|				pos
				|		None:
				|			pos
				|
				|
				|private pure func parse_rows(input: String, config: CsvConfig) -> List[List[String]]:
				|	var rows: List[List[String]] = []
				|	var i: Int = 0
				|
				|	while i < input.length():
				|		row_result: (List[String], Int) = parse_row(input, i, config)
				|		rows = rows.append(row_result[0])
				|		i = row_result[1]
				|		i = skip_newline(input, i)
				|
				|	rows
				|
				|
				|-- ============================================================================
				|-- Internal: Formatting Helpers
				|-- ============================================================================
				|private pure func needs_quoting(field: String, config: CsvConfig) -> Bool:
				|	var i: Int = 0
				|	var found: Bool = False
				|	var done: Bool = False
				|
				|	while not done:
				|		match field.get(i):
				|			Some(c):
				|				if (
				|					c == config.delimiter
				|					or c == config.quote_char
				|					or c == '\n'
				|					or c == '\r'
				|				):
				|					found = True
				|					done = True
				|				else:
				|					i += 1
				|			None:
				|				done = True
				|
				|	found
				|
				|
				|private pure func quote_field(field: String, config: CsvConfig) -> String:
				|	q: String = from_char(config.quote_char)
				|	escaped: String = field.replace(q, q + q)
				|	q + escaped + q
				|
				|
				|private pure func format_field(field: String, config: CsvConfig) -> String:
				|	if needs_quoting(field, config):
				|		quote_field(field, config)
				|	else:
				|		field
				|
				|
				|private pure func format_row(row: List[String], config: CsvConfig) -> String:
				|	parts: List[String] = row.map(func(field: String): format_field(field, config))
				|
				|	parts.join(from_char(config.delimiter))
				|
				|
				|-- ============================================================================
				|-- Core API
				|-- ============================================================================
				|pure func parse_csv(input: String) -> List[List[String]]:
				|	parse_rows(input, default_config())
				|
				|
				|pure func format_csv(rows: List[List[String]]) -> String:
				|	config: CsvConfig = default_config()
				|	formatted: List[String] = rows.map(func(row: List[String]): format_row(row, config))
				|
				|	formatted.join("\r\n")
				|
				|
				|-- ============================================================================
				|-- Config API
				|-- ============================================================================
				|pure func parse_csv_with_config(input: String, config: CsvConfig) -> List[List[String]]:
				|	parse_rows(input, config)
				|
				|
				|pure func format_csv_with_config(rows: List[List[String]], config: CsvConfig) -> String:
				|	formatted: List[String] = rows.map(func(row: List[String]): format_row(row, config))
				|
				|	formatted.join("\r\n")
				|
				|
				|pure func format_csv_row(row: List[String]) -> String:
				|	format_row(row, default_config())
				|
				|
				|-- ============================================================================
				|-- Strict Parsing API
				|-- ============================================================================
				|private pure func try_parse_quoted_field(
				|	input: String,
				|	pos: Int,
				|	line: Int,
				|	col: Int,
				|	config: CsvConfig,
				|) -> Result[(String, Int), CsvError]:
				|	var i: Int = pos + 1
				|	var result: String = string(16)
				|	var done: Bool = False
				|	var err: Option[CsvError] = None
				|
				|	while not done:
				|		match input.get(i):
				|			Some(c):
				|				if c == config.quote_char:
				|					match input.get(i + 1):
				|						Some(next):
				|							if next == config.quote_char:
				|								result = result.append_char(config.quote_char)
				|								i += 2
				|							else:
				|								done = True
				|								i += 1
				|						None:
				|							done = True
				|							i += 1
				|				else:
				|					result = result.append_char(c)
				|					i += 1
				|			None:
				|				done = True
				|				err = Some({
				|					line = line,
				|					column = col,
				|					message = "unterminated quoted field",
				|				})
				|
				|	match err:
				|		Some(e):
				|			Err(e)
				|		None:
				|			Ok((result, i))
				|
				|
				|private pure func try_parse_field(
				|	input: String,
				|	pos: Int,
				|	line: Int,
				|	col: Int,
				|	config: CsvConfig,
				|) -> Result[(String, Int), CsvError]:
				|	match input.get(pos):
				|		Some(c):
				|			if c == config.quote_char:
				|				try_parse_quoted_field(input, pos, line, col, config)
				|			else:
				|				field_result: (String, Int) = parse_unquoted_field(input, pos, config)
				|				Ok(field_result)
				|		None:
				|			Ok(("", pos))
				|
				|
				|private pure func try_parse_row(
				|	input: String,
				|	pos: Int,
				|	line: Int,
				|	config: CsvConfig,
				|) -> Result[(List[String], Int), CsvError]:
				|	var fields: List[String] = []
				|	var i: Int = pos
				|	var col: Int = 1
				|	var done: Bool = False
				|	var error: Option[CsvError] = None
				|
				|	while not done:
				|		match try_parse_field(input, i, line, col, config):
				|			Ok(field_result):
				|				fields = fields.append(field_result[0])
				|				col += field_result[1] - i
				|				i = field_result[1]
				|
				|				if i >= input.length():
				|					done = True
				|				else:
				|					match input.get(i):
				|						Some(c):
				|							if c == config.delimiter:
				|								i += 1
				|								col += 1
				|							else:
				|								done = True
				|						None:
				|							done = True
				|			Err(e):
				|				done = True
				|				error = Some(e)
				|
				|	match error:
				|		Some(e):
				|			Err(e)
				|		None:
				|			Ok((fields, i))
				|
				|
				|private pure func try_parse_rows(
				|	input: String,
				|	config: CsvConfig,
				|) -> Result[List[List[String]], CsvError]:
				|	var rows: List[List[String]] = []
				|	var i: Int = 0
				|	var line: Int = 1
				|	var error: Option[CsvError] = None
				|	var has_error: Bool = False
				|
				|	while i < input.length() and not has_error:
				|		match try_parse_row(input, i, line, config):
				|			Ok(row_result):
				|				rows = rows.append(row_result[0])
				|				i = row_result[1]
				|				i = skip_newline(input, i)
				|				line += 1
				|			Err(e):
				|				error = Some(e)
				|				has_error = True
				|
				|	match error:
				|		Some(e):
				|			Err(e)
				|		None:
				|			Ok(rows)
				|
				|
				|pure func try_parse_csv(input: String) -> Result[List[List[String]], CsvError]:
				|	try_parse_rows(input, default_config())
				|
				|
				|pure func try_parse_csv_with_config(
				|	input: String,
				|	config: CsvConfig,
				|) -> Result[List[List[String]], CsvError]:
				|	try_parse_rows(input, config)
				|
				|
				|-- ============================================================================
				|-- Header-Aware API
				|-- ============================================================================
				|pure func parse_csv_with_headers(input: String) -> List[Dict[String, String]]:
				|	rows: List[List[String]] = parse_csv(input)
				|
				|	match rows.get(0):
				|		None:
				|			[]
				|		Some(headers):
				|			var result: List[Dict[String, String]] = []
				|			var i: Int = 1
				|			len: Int = rows.length()
				|
				|			while i < len:
				|				match rows.get(i):
				|					Some(row):
				|						pairs: List[(String, String)] = headers.zip(row)
				|						result = result.append(Dicts.from_list(pairs))
				|					None:
				|						void
				|
				|				i += 1
				|
				|			result
				|
				|
				|-- ============================================================================
				|-- Error Formatting
				|-- ============================================================================
				|pure func format_error(err: CsvError) -> String:
				|	"line ${err.line.to_string()}, column ${err.column.to_string()}: ${err.message}"
				|
				|
				|-- CSV Typed Decoder
				|--
				|-- Composable column decoders for extracting typed records from CSV data.
				|-- Mirrors the pattern from codec: define a Decoder[T], then run it with
				|-- from_string.
				|--
				|-- Usage:
				|-- decoder = map3(make_record, col_string(0), col_int(1), col_float(2))
				|-- result = from_string(decoder, csv_input)
				|-- ============================================================================
				|-- Types
				|-- ============================================================================
				|record CsvDecodeError {
				|	row: Int,
				|	column: Int,
				|	message: String
				|}
				|
				|
				|type alias Decoder[T] = pure (List[String]) -> Result[T, CsvDecodeError]
				|
				|
				|-- ============================================================================
				|-- Column Extractors
				|-- ============================================================================
				|---
				|Extract a string from column `idx`.
				|---
				|pure func col_string(idx: Int) -> Decoder[String]:
				|	pure func(row: List[String]) -> Result[String, CsvDecodeError]:
				|		match row.get(idx):
				|			Some(s):
				|				Ok(s)
				|			None:
				|				Err({
				|					row = 0,
				|					column = idx,
				|					message = "missing column",
				|				})
				|
				|
				|---
				|Extract an integer from column `idx`. Fails if the value is not a valid integer.
				|---
				|pure func col_int(idx: Int) -> Decoder[Int]:
				|	pure func(row: List[String]) -> Result[Int, CsvDecodeError]:
				|		match row.get(idx):
				|			Some(s):
				|				match s.parse_int():
				|					Some(n):
				|						Ok(n)
				|					None:
				|						Err({
				|							row = 0,
				|							column = idx,
				|							message = "expected integer",
				|						})
				|			None:
				|				Err({
				|					row = 0,
				|					column = idx,
				|					message = "missing column",
				|				})
				|
				|
				|---
				|Extract a float from column `idx`. Fails if the value is not a valid number.
				|---
				|pure func col_float(idx: Int) -> Decoder[Float]:
				|	pure func(row: List[String]) -> Result[Float, CsvDecodeError]:
				|		match row.get(idx):
				|			Some(s):
				|				match s.parse_float():
				|					Some(f):
				|						Ok(f)
				|					None:
				|						Err({
				|							row = 0,
				|							column = idx,
				|							message = "expected number",
				|						})
				|			None:
				|				Err({
				|					row = 0,
				|					column = idx,
				|					message = "missing column",
				|				})
				|
				|
				|-- ============================================================================
				|-- Combiners
				|-- ============================================================================
				|---
				|Combine two column decoders into a single record decoder.
				|---
				|pure func map2[A, B, R](
				|	f: pure (A, B) -> R,
				|	d1: Decoder[A],
				|	d2: Decoder[B],
				|) -> Decoder[R]:
				|	pure func(row: List[String]) -> Result[R, CsvDecodeError]:
				|		a ?= d1(row)
				|		b ?= d2(row)
				|		Ok(f(a, b))
				|
				|
				|---
				|Combine three column decoders into a single record decoder.
				|---
				|pure func map3[A, B, C, R](
				|	f: pure (A, B, C) -> R,
				|	d1: Decoder[A],
				|	d2: Decoder[B],
				|	d3: Decoder[C],
				|) -> Decoder[R]:
				|	pure func(row: List[String]) -> Result[R, CsvDecodeError]:
				|		a ?= d1(row)
				|		b ?= d2(row)
				|		c ?= d3(row)
				|		Ok(f(a, b, c))
				|
				|
				|---
				|Combine four column decoders into a single record decoder.
				|---
				|pure func map4[A, B, C, D, R](
				|	f: pure (A, B, C, D) -> R,
				|	d1: Decoder[A],
				|	d2: Decoder[B],
				|	d3: Decoder[C],
				|	d4: Decoder[D],
				|) -> Decoder[R]:
				|	pure func(row: List[String]) -> Result[R, CsvDecodeError]:
				|		a ?= d1(row)
				|		b ?= d2(row)
				|		c ?= d3(row)
				|		d ?= d4(row)
				|		Ok(f(a, b, c, d))
				|
				|
				|-- ============================================================================
				|-- Pipeline
				|-- ============================================================================
				|---
				|Parse a CSV string with a header row, decode each data row using the decoder.
				|The first row is skipped (treated as headers).
				|---
				|pure func from_string[T](decoder: Decoder[T], input: String) -> Result[List[T], CsvDecodeError]:
				|	rows: List[List[String]] = parse_csv(input)
				|	decode_rows(decoder, rows, 1)
				|
				|
				|---
				|Parse a CSV string without a header row, decode all rows.
				|---
				|pure func from_string_no_header[T](
				|	decoder: Decoder[T],
				|	input: String,
				|) -> Result[List[T], CsvDecodeError]:
				|	rows: List[List[String]] = parse_csv(input)
				|	decode_rows(decoder, rows, 0)
				|
				|
				|---
				|Apply decoder to a single row, tagging the error with the row number.
				|---
				|private pure func decode_one_row[T](
				|	decoder: Decoder[T],
				|	row: List[String],
				|	row_num: Int,
				|) -> Result[T, CsvDecodeError]:
				|	match decoder(row):
				|		Ok(val):
				|			ok_result: Result[T, CsvDecodeError] = Ok(val)
				|			ok_result
				|		Err(e):
				|			Err({
				|				row = row_num,
				|				column = e.column,
				|				message = e.message,
				|			})
				|
				|
				|---
				|Decode rows starting from index `start`.
				|---
				|private pure func decode_rows[T](
				|	decoder: Decoder[T],
				|	rows: List[List[String]],
				|	start: Int,
				|) -> Result[List[T], CsvDecodeError]:
				|	var result: List[T] = []
				|	var i: Int = start
				|	var err: Option[CsvDecodeError] = None
				|	var has_error: Bool = False
				|
				|	while i < rows.length() and not has_error:
				|		match rows.get(i):
				|			Some(row):
				|				match decode_one_row(decoder, row, i + 1):
				|					Ok(val):
				|						result = result.append(val)
				|					Err(e):
				|						err = Some(e)
				|						has_error = True
				|			None:
				|				void
				|
				|		i += 1
				|
				|	var final_result: Result[List[T], CsvDecodeError] = Ok(result)
				|
				|	match err:
				|		Some(e):
				|			final_result = Err(e)
				|		None:
				|			void
				|
				|	final_result
				|
				|
				|-- ============================================================================
				|-- Error Formatting
				|-- ============================================================================
				|---
				|Format a CsvDecodeError as a plain text string.
				|---
				|pure func format_decode_error(err: CsvDecodeError) -> String:
				|	"row ${err.row.to_string()}, column ${err.column.to_string()}: ${err.message}"
				|
			Some(source)
		"std/debug":
			source: String = raw
				|-- Debug - Debugging utilities
				|--
				|-- These helpers are @debug_only: call them from a debug: block, compile with
				|-- --debug, or use them from blorp test code.
				|-- Universal compiler-synthesized debug representation.
				|@debug_only
				|pure func debug_string[T](value: T) -> String:
				|	builtin("blorp_debug_string")
				|
				|
				|-- Log a debug message to stderr.
				|@debug_only
				|pure func log(msg: String) -> Void:
				|	builtin("blorp_debug_log_msg")
				|
				|
				|-- Log an info-level message to stderr with timestamp
				|@debug_only
				|pure func info(msg: String) -> Void:
				|	builtin("blorp_debug_info")
				|
				|
				|-- Log a warning-level message to stderr with timestamp
				|@debug_only
				|pure func warn(msg: String) -> Void:
				|	builtin("blorp_debug_warn")
				|
				|
				|-- Log an error-level message to stderr with timestamp
				|@debug_only
				|pure func error(msg: String) -> Void:
				|	builtin("blorp_debug_error")
				|
				|
				|-- ============================================================================
				|-- Type Introspection
				|-- ============================================================================
				|--
				|-- Reflection primitives: report compile-time facts about an expression's
				|-- type as a runtime value (a String or Bool). Constant-folded per call
				|-- site — zero runtime cost, no reflection machinery in the binary.
				|--
				|-- These belong in [debug] because branching on these values in production
				|-- code is fragile: type_name's output format is not a stable API, and
				|-- relying on is_heap couples code to implementation-level memory-layout
				|-- decisions. Use for debugging, logging, error messages — not for
				|-- dispatch.
				|---
				|Return the compile-time type of [x] as a String literal. Constant-folded
				|at each call site with zero runtime cost.
				|
				|doctests:
				|    :: Primitive types
				|    type_name(42) == "#42"
				|    type_name(3.14) == "Float"
				|    type_name("hi") == "String"
				|
				|    :: Parameterized types render their arguments
				|    type_name([1, 2, 3]) == "List[Int]"
				|---
				|@debug_only
				|pure func type_name[T](x: T) -> String:
				|	builtin("std/debug.type_name")
				|
				|
				|---
				|Return True if values of [x]'s type live on the heap (reference-counted),
				|False if they live on the stack (primitives, structs, and stack Option/Result
				|layouts). Constant-folded at each call site.
				|
				|doctests:
				|    :: Primitives live on the stack
				|    is_heap(42) == False
				|    is_heap(True) == False
				|
				|    :: Lists and strings live on the heap
				|    is_heap([1, 2, 3]) == True
				|    is_heap("hello") == True
				|
				|    :: Stack options do not live on the heap
				|    maybe: Option[Int] = Some(42)
				|    is_heap(maybe) == False
				|---
				|@debug_only
				|pure func is_heap[T](x: T) -> Bool:
				|	builtin("std/debug.is_heap")
				|
			Some(source)
		"std/deque":
			source: String = raw
				|-- Deque - Double-ended queue
				|--
				|-- A double-ended queue backed by two lists (front and back).
				|-- Supports O(1) amortized push/pop from both ends.
				|-- The two-list representation is private to this module.
				|-- ============================================================================
				|opaque type Deque[T] = (List[T], List[T])
				|
				|
				|-- Construction
				|-- ============================================================================
				|---
				|Create an empty deque.
				|
				|doctests:
				|    :: New deque is empty
				|    d = deque()
				|    filled = d.push_back(1)
				|    d.is_empty() == True and filled
				|        .to_list()
				|        .length() == 1
				|---
				|pure func deque[T]() -> Deque[T]:
				|	front: List[T] = []
				|	back: List[T] = []
				|	from_parts(front, back)
				|
				|
				|-- ============================================================================
				|-- Core Operations
				|-- ============================================================================
				|---
				|Push a value to the front of the deque.
				|
				|doctests:
				|    :: Push front adds to front
				|    var d = deque()
				|    d = d.push_front(1)
				|    d
				|        .to_list()
				|        .length() == 1
				|---
				|pure func push_front[T](self: Deque[T], val: T) -> Deque[T]:
				|	parts: (List[T], List[T]) = deque_parts(self)
				|	front: List[T] = parts[0]
				|	new_front: List[T] = [val].concat(front)
				|	from_parts(new_front, parts[1])
				|
				|
				|---
				|Push a value to the back of the deque.
				|
				|doctests:
				|    :: Push back adds to back
				|    var d = deque()
				|    d = d.push_back(1)
				|    d
				|        .to_list()
				|        .length() == 1
				|---
				|pure func push_back[T](self: Deque[T], val: T) -> Deque[T]:
				|	parts: (List[T], List[T]) = deque_parts(self)
				|	back: List[T] = parts[1]
				|	new_back: List[T] = [val].concat(back)
				|	from_parts(parts[0], new_back)
				|
				|
				|---
				|Pop a value from the front of the deque.
				|Returns None if empty, Some((value, new_deque)) otherwise.
				|
				|doctests:
				|    :: Pop front returns first pushed
				|    var d = deque()
				|    d = d.push_front(1)
				|    d = d.push_front(2)
				|
				|    match d.pop_front():
				|        Some(pair):
				|            pair[0] == 2
				|        None:
				|            False
				|---
				|func pop_front[T](self: Deque[T]) -> Option[(T, Deque[T])]:
				|	parts: (List[T], List[T]) = deque_parts(self)
				|	front: List[T] = parts[0]
				|	back: List[T] = parts[1]
				|	none: Option[(T, Deque[T])] = None
				|
				|	if list_len(front) > 0:
				|		val ?= front.get(0)
				|		rest: List[T] = front.drop(1)
				|		Some((val, from_parts(rest, back)))
				|	else if list_len(back) == 0:
				|		none
				|	else:
				|		-- Reverse back to become front
				|		reversed: List[T] = back.reverse()
				|		val ?= reversed.get(0)
				|		rest: List[T] = reversed.drop(1)
				|		empty_back: List[T] = []
				|		Some((val, from_parts(rest, empty_back)))
				|
				|
				|---
				|Pop a value from the back of the deque.
				|Returns None if empty, Some((value, new_deque)) otherwise.
				|
				|doctests:
				|    :: Pop back returns last pushed
				|    var d = deque()
				|    d = d.push_back(1)
				|    d = d.push_back(2)
				|
				|    match d.pop_back():
				|        Some(pair):
				|            pair[0] == 2
				|        None:
				|            False
				|---
				|func pop_back[T](self: Deque[T]) -> Option[(T, Deque[T])]:
				|	parts: (List[T], List[T]) = deque_parts(self)
				|	front: List[T] = parts[0]
				|	back: List[T] = parts[1]
				|	none: Option[(T, Deque[T])] = None
				|
				|	if list_len(back) > 0:
				|		val ?= back.get(0)
				|		rest: List[T] = back.drop(1)
				|		Some((val, from_parts(front, rest)))
				|	else if list_len(front) == 0:
				|		none
				|	else:
				|		-- Reverse front to become back
				|		reversed: List[T] = front.reverse()
				|		val ?= reversed.get(0)
				|		rest: List[T] = reversed.drop(1)
				|		empty_front: List[T] = []
				|		Some((val, from_parts(empty_front, rest)))
				|
				|
				|---
				|Peek at the front element without removing.
				|---
				|pure func peek_front[T](self: Deque[T]) -> Option[T]:
				|	parts: (List[T], List[T]) = deque_parts(self)
				|	front: List[T] = parts[0]
				|	back: List[T] = parts[1]
				|
				|	if list_len(front) > 0:
				|		front.get(0)
				|	else if list_len(back) == 0:
				|		None
				|	else:
				|		back.get(list_len(back) - 1)
				|
				|
				|-- Last element of back is front
				|---
				|Peek at the back element without removing.
				|---
				|pure func peek_back[T](self: Deque[T]) -> Option[T]:
				|	parts: (List[T], List[T]) = deque_parts(self)
				|	front: List[T] = parts[0]
				|	back: List[T] = parts[1]
				|
				|	if list_len(back) > 0:
				|		back.get(0)
				|	else if list_len(front) == 0:
				|		None
				|	else:
				|		front.get(list_len(front) - 1)
				|
				|
				|-- Last element of front is back
				|---
				|Check if the deque is empty.
				|---
				|pure func is_empty[T](self: Deque[T]) -> Bool:
				|	parts: (List[T], List[T]) = deque_parts(self)
				|	list_len(parts[0]) == 0 and list_len(parts[1]) == 0
				|
				|
				|-- Count elements in a list without calling length (avoids shadowing by deque's length)
				|private pure func list_len[T](lst: List[T]) -> Int:
				|	var n: Int = 0
				|
				|	for _ in lst:
				|		n += 1
				|
				|	n
				|
				|
				|---
				|Get the total number of elements.
				|---
				|pure func length[T](self: Deque[T]) -> Int:
				|	parts: (List[T], List[T]) = deque_parts(self)
				|	list_len(parts[0]) + list_len(parts[1])
				|
				|
				|---
				|Convert deque to a list (front to back order).
				|---
				|pure func to_list[T](self: Deque[T]) -> List[T]:
				|	parts: (List[T], List[T]) = deque_parts(self)
				|	front: List[T] = parts[0]
				|	back: List[T] = parts[1]
				|	reversed_back: List[T] = back.reverse()
				|	front.concat(reversed_back)
				|
				|
				|-- ============================================================================
				|-- Internal Helpers
				|-- ============================================================================
				|private pure func from_parts[T](front: List[T], back: List[T]) -> Deque[T]:
				|	into Deque[T]((front, back))
				|
				|
				|private pure func deque_parts[T](self: Deque[T]) -> (List[T], List[T]):
				|	from Deque[T](self)
				|
			Some(source)
		"std/dict":
			source: String = raw
				|import:
				|	list: join
				|	traits: one, zero
				|
				|
				|-- Dict - Ordered dictionary with COW optimization
				|--
				|-- Dict[K, V] is an insertion-ordered key-value mapping with O(1) average
				|type Dict[K, V] = builtin
				|
				|
				|-- lookup, insert, and remove. Uses open addressing with h2 fingerprints,
				|-- ARC (Automatic Reference Counting), and COW (Copy-on-Write) optimization.
				|-- All operations are semantically immutable — mutations return new dicts.
				|--
				|-- Iteration order is insertion order. Removing a key preserves the relative
				|-- order of remaining keys. New keys are appended at the end.
				|--
				|-- Supports direct iteration:
				|-- for k in dict:           -- iterate keys (zero allocation)
				|-- for (k, v) in dict:     -- iterate key-value pairs (zero allocation)
				|-- dict.keys()              -- List[K] in insertion order
				|-- dict.values()            -- List[V] in insertion order
				|-- dict.entries()           -- List[(K, V)] in insertion order
				|--
				|-- Supported key types: Int, String, Bool, Char, Float (hash/equality provided by runtime)
				|-- ============================================================================
				|-- Core Builtins
				|-- ============================================================================
				|---
				|Create an empty Dict.
				|
				|doctests:
				|    :: Empty dict is empty
				|    d: Dict[String, Int] = dict()
				|    d.is_empty() == True
				|---
				|pure func dict[K, V]() -> Dict[K, V]:
				|	builtin("std/dict.dict")
				|
				|
				|---
				|Create an empty Dict with capacity reserved for approximately `capacity` entries.
				|
				|The dict starts with length 0; `capacity` is a hint to avoid rehashing when
				|the expected number of inserted entries is known in advance.
				|
				|doctests:
				|    :: Empty dict with capacity is empty
				|    d: Dict[String, Int] = with_capacity(100)
				|    d.is_empty() == True
				|
				|    :: Inserting into dict with capacity
				|    d: Dict[String, Int] = with_capacity(8).set("x", 10)
				|    d.get_or("x", 0) == 10
				|---
				|pure func with_capacity[K, V](capacity: Int) -> Dict[K, V]:
				|	builtin("std/dict.with_capacity")
