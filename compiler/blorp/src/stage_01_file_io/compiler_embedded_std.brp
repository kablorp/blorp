				|
				|-- ============================================================================
				|-- Search
				|-- ============================================================================
				|---
				|Binary search on a sorted list. Returns the index of the target, or None.
				|The list must be sorted in ascending order.
				|
				|doctests:
				|    :: Find element
				|    [1, 2, 3, 4, 5].binary_search(3) == Some(2)
				|
				|    :: Element not found
				|    [1, 2, 3, 4, 5].binary_search(6) == None
				|
				|    :: Empty list
				|    xs: List[Int] = []
				|    xs.binary_search(1) == None
				|---
				|pure func binary_search[T:Orderable](sorted: List[T], target: T) -> Option[Int]:
				|	builtin("std/list.binary_search")
				|
				|
				|---
				|Binary search using a custom comparison function.
				|compare(a, b) should return negative if a < b, 0 if equal, positive if a > b.
				|The list must be sorted according to the same comparison function.
				|
				|doctests:
				|    :: Find with custom compare
				|    cmp: pure (Int, Int) -> Int = pure func(a: Int, b: Int): a - b
				|    [1, 2, 3, 4, 5].binary_search_by(3, cmp) == Some(2)
				|
				|    :: Not found with custom compare
				|    cmp: pure (Int, Int) -> Int = pure func(a: Int, b: Int): a - b
				|    [1, 2, 3, 4, 5].binary_search_by(6, cmp) == None
				|---
				|pure func binary_search_by[T](
				|	sorted: List[T],
				|	target: T,
				|	compare: pure (T, T) -> Int,
				|) -> Option[Int]:
				|	builtin("std/list.binary_search_by")
				|
				|
				|-- ============================================================================
				|-- Utility Functions
				|-- ============================================================================
				|---
				|Reverse the order of elements.
				|
				|doctests:
				|    :: Reverse a list
				|    nums: List[Int] = [1, 2, 3]
				|    reversed: List[Int] = nums.reverse()
				|
				|    match reversed.get(0):
				|        Some(v):
				|            v == 3
				|        None:
				|            False
				|---
				|pure func reverse[T](self: List[T]) -> List[T]:
				|	builtin("std/list.reverse")
				|
				|
				|---
				|Find the first element matching a predicate.
				|
				|doctests:
				|    :: Find element matching predicate
				|    nums: List[Int] = [1, 2, 3, 4, 5]
				|
				|    match nums.find(func(x: Int): x > 3):
				|        Some(v):
				|            v == 4
				|        None:
				|            False
				|
				|    :: Find in empty list returns None
				|    empty: List[Int] = []
				|
				|    match empty.find(func(x: Int): x > 0):
				|        Some(_):
				|            False
				|        None:
				|            True
				|---
				|func find[T](
				|	self: List[T],
				|	pred: (T) -> Bool,
				|) -> Option[T]:
				|pure func find[T](
				|	self: List[T],
				|	pred: pure (T) -> Bool,
				|) -> Option[T]:
				|	builtin("std/list.find")
				|
				|
				|---
				|Check if a list contains an element.
				|
				|doctests:
				|    :: Contains existing element
				|    nums: List[Int] = [1, 2, 3]
				|    nums.contains(2) == True
				|
				|    :: Does not contain missing element
				|    nums: List[Int] = [1, 2, 3]
				|    nums.contains(5) == False
				|---
				|pure func contains[T:Equatable](self: List[T], elem: T) -> Bool:
				|	var found: Bool = False
				|
				|	for item in self:
				|		if item == elem:
				|			found = True
				|			break
				|		else:
				|			void
				|
				|	found
				|
				|
				|---
				|Take the first n elements.
				|
				|doctests:
				|    :: Take first 3 elements
				|    nums: List[Int] = [1, 2, 3, 4, 5]
				|    result: List[Int] = nums.take(3)
				|    result.length() == 3
				|---
				|pure func take[T](self: List[T], n: Int) -> List[T]:
				|	builtin("std/list.take")
				|
				|
				|---
				|Drop the first n elements.
				|
				|doctests:
				|    :: Drop first 2 elements
				|    nums: List[Int] = [1, 2, 3, 4, 5]
				|    result: List[Int] = nums.drop(2)
