				|---
				|Pair each element with its index.
				|
				|doctests:
				|    :: Enumerate a list
				|    names: List[String] = ["a", "b", "c"]
				|    result: List[(Int, String)] = names.enumerate()
				|    result.length() == 3
				|
				|    :: First pair has index 0
				|    nums: List[Int] = [10, 20]
				|    result: List[(Int, Int)] = nums.enumerate()
				|
				|    match result.get(0):
				|        Some(pair):
				|            pair[0] == 0 and pair[1] == 10
				|        None:
				|            False
