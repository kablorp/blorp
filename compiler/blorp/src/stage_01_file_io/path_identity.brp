-- Filesystem-backed path identity for compiler inputs that already exist.
--
-- Lexical path normalization is insufficient at graph/discovery boundaries:
-- aliases through symbolic links must resolve to one physical source before
-- parsing, policy classification, or deduplication.
import:
	fs: IOError(Other)
	path: normalize
	string: replace


foreign(include: "path_identity_ffi.h"):
	private func path_realpath_ffi(path: String) -> String = "blorp_compiler_path_realpath"
	pure func path_host_is_windows() -> Bool = "blorp_compiler_path_host_is_windows"


record ExistingPathIdentity {
	io_path: String,
	canonical_path: String
}


func path_realpath(path: String) -> String:
	path_realpath_ffi(path)


pure func normalize_canonical_path_for_platform(path: String, is_windows: Bool) -> String:
	if is_windows:
		with_separators: String = path.replace("\\", "/")

		-- Keep native extended syntax in `io_path`, but remove it from the
		-- stable comparison identity. Preserve the UNC root's leading `//`.
		if with_separators.starts_with("//?/UNC/"):
			"//" + with_separators.drop_left(8)
		else if with_separators.starts_with("//?/"):
			with_separators.drop_left(4)
		else:
			with_separators
	else:
		normalize(path)


pure func path_is_absolute_for_platform(path: String, is_windows: Bool) -> Bool:
	if is_windows:
		(
			path.starts_with("/")
			or path.starts_with("\\")
			or path.length() >= 2 and path.get(1) == Some(':')
		)
	else:
		path.starts_with("/")


pure func path_is_absolute(path: String) -> Bool:
	path_is_absolute_for_platform(path, path_host_is_windows())


func existing_path_identity(path: String) -> Result[ExistingPathIdentity, IOError]:
	resolved: String = path_realpath(path)

	if resolved.length() == 0:
		Err(Other("failed to resolve canonical path for existing compiler input: " + path))
	else:
		Ok({
			io_path = resolved,
			canonical_path = normalize_canonical_path_for_platform(
				resolved,
				path_host_is_windows(),
			),
		})


func canonical_existing_path(path: String) -> Result[String, IOError]:
	existing_path_identity(path).map(func(identity): identity.canonical_path)
