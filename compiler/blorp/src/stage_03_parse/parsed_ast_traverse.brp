-- Shared one-level traversal for parsed expressions.
--
-- Callers own recursion and node-specific rewrites. Keeping child traversal
-- here prevents parser-adjacent and typecheck rewrites from each maintaining a
-- separate exhaustive copy of the ParsedExpr shape.
import:
	parsed_ast:
		ParsedConcurrentParam,
		ParsedDictEntry,
		ParsedExpr(
			ParsedAssignExpr,
			ParsedAscriptionExpr,
			ParsedBinaryExpr,
			ParsedBlockExpr,
			ParsedCallExpr,
			ParsedCompoundAssignExpr,
			ParsedConcurrentBlockExpr,
			ParsedConcurrentForExpr,
			ParsedDebugBlockExpr,
			ParsedDetachExpr,
			ParsedDictExpr,
			ParsedFieldAccessExpr,
			ParsedForExpr,
			ParsedFunctionDeclExpr,
			ParsedIfExpr,
			ParsedLambdaExpr,
			ParsedListExpr,
			ParsedLogicalExpr,
			ParsedMatchExpr,
			ParsedOpaqueFromExpr,
			ParsedOpaqueIntoExpr,
			ParsedQuestionBindExpr,
			ParsedRangeExpr,
			ParsedRecordExpr,
			ParsedRecordUpdateExpr,
			ParsedSelectExpr,
			ParsedStringInterpolationPartsExpr,
			ParsedSubscriptAssignExpr,
			ParsedSubscriptExpr,
			ParsedTupleDestructExpr,
			ParsedTupleExpr,
			ParsedUnaryExpr,
			ParsedVarDeclExpr,
			ParsedVectorExpr,
			ParsedWhileExpr,
			ParsedWithExpr,
		),
		ParsedMatchCase,
		ParsedRecordExprField,
		ParsedSelectArm,
		ParsedSelectArmKind(ParsedSelectAfterArm, ParsedSelectReceiveArm, ParsedSelectSealedArm),
		ParsedStringInterpolationPart(ParsedInterpolationExpr, ParsedInterpolationLiteral),
		ParsedWithBinding,
		ParsedWithErrorMap,


private pure func map_record_field(
	field: ParsedRecordExprField,
	mapper: pure (ParsedExpr) -> ParsedExpr,
) -> ParsedRecordExprField:
	{ field | value = mapper(field.value) }


private pure func map_dict_entry(
	entry: ParsedDictEntry,
	mapper: pure (ParsedExpr) -> ParsedExpr,
) -> ParsedDictEntry:
	{ entry |
		key = mapper(entry.key),
		value = mapper(entry.value)
	}


private pure func map_match_case(
	case: ParsedMatchCase,
	mapper: pure (ParsedExpr) -> ParsedExpr,
) -> ParsedMatchCase:
	{ case | body = mapper(case.body) }


private pure func map_select_arm_kind(
	kind: ParsedSelectArmKind,
	mapper: pure (ParsedExpr) -> ParsedExpr,
) -> ParsedSelectArmKind:
	match kind:
		ParsedSelectReceiveArm(name, channel):
			ParsedSelectReceiveArm(name, mapper(channel))
		ParsedSelectSealedArm(channel):
			ParsedSelectSealedArm(mapper(channel))
		ParsedSelectAfterArm(timeout):
			ParsedSelectAfterArm(mapper(timeout))


private pure func map_select_arm(
	arm: ParsedSelectArm,
	mapper: pure (ParsedExpr) -> ParsedExpr,
) -> ParsedSelectArm:
	{ arm |
		kind = map_select_arm_kind(arm.kind, mapper),
		body = mapper(arm.body)
	}


private pure func map_with_error(
	error_map: ParsedWithErrorMap,
	mapper: pure (ParsedExpr) -> ParsedExpr,
) -> ParsedWithErrorMap:
	{ error_map | value = mapper(error_map.value) }


private pure func map_with_binding(
	binding: ParsedWithBinding,
	mapper: pure (ParsedExpr) -> ParsedExpr,
) -> ParsedWithBinding:
	{ binding |
		value = mapper(binding.value),
		error_map = binding.error_map.map(func(error_map): map_with_error(error_map, mapper))
	}


private pure func map_concurrent_param(
	param: ParsedConcurrentParam,
	mapper: pure (ParsedExpr) -> ParsedExpr,
) -> ParsedConcurrentParam:
	{ param | value = mapper(param.value) }


private pure func map_interpolation_part(
	part: ParsedStringInterpolationPart,
	mapper: pure (ParsedExpr) -> ParsedExpr,
) -> ParsedStringInterpolationPart:
	match part:
		ParsedInterpolationExpr(expr):
			ParsedInterpolationExpr(mapper(expr))
		ParsedInterpolationLiteral(_):
			part


private pure func fold_expr_list[T](
	items: List[ParsedExpr],
	initial: T,
	folder: pure (T, ParsedExpr) -> T,
) -> T:
	var result = initial

	for item in items:
		result = folder(result, item)

	result


-- Read-only one-level traversal for analyses. It preserves source child order
-- and never materializes a temporary child list.
pure func fold_parsed_expr_children[T](
	expr: ParsedExpr,
	initial: T,
	folder: pure (T, ParsedExpr) -> T,
) -> T:
	match expr:
		ParsedStringInterpolationPartsExpr(parts, _, _):
			var result = initial

			for part in parts:
				match part:
					ParsedInterpolationExpr(child):
						result = folder(result, child)
					ParsedInterpolationLiteral(_):
						void

			result
		ParsedUnaryExpr(_, value, _):
			folder(initial, value)
		ParsedBinaryExpr(_, left, right, _):
			folder(
				folder(initial, left),
				right,
			)
		ParsedLogicalExpr(_, left, right, _):
			folder(
				folder(initial, left),
				right,
			)
		ParsedAscriptionExpr(value, _, _):
			folder(initial, value)
		ParsedRangeExpr(start, finish, _):
			folder(
				folder(initial, start),
				finish,
			)
		ParsedCallExpr(callee, args, _):
			fold_expr_list(
				args,
				folder(initial, callee),
				folder,
			)
		ParsedFieldAccessExpr(target, _, _):
			folder(initial, target)
		ParsedSubscriptExpr(target, indices, _):
			fold_expr_list(
				indices,
				folder(initial, target),
				folder,
			)
		ParsedListExpr(items, _):
			fold_expr_list(items, initial, folder)
		ParsedTupleExpr(items, _):
			fold_expr_list(items, initial, folder)
		ParsedRecordExpr(fields, _):
			var result = initial

			for field in fields:
				result = folder(result, field.value)

			result
		ParsedRecordUpdateExpr(base, fields, _):
			var result = folder(initial, base)

			for field in fields:
				result = folder(result, field.value)

			result
		ParsedDictExpr(entries, _):
			var result = initial

			for entry in entries:
				result = folder(
					folder(result, entry.key),
					entry.value,
				)

			result
		ParsedVectorExpr(items, _):
			fold_expr_list(items, initial, folder)
		ParsedOpaqueIntoExpr(_, value, _):
			folder(initial, value)
		ParsedOpaqueFromExpr(_, value, _):
			folder(initial, value)
		ParsedBlockExpr(items, _):
			fold_expr_list(items, initial, folder)
		ParsedIfExpr(condition, then_expr, else_expr, _):
			with_then = folder(
				folder(initial, condition),
				then_expr,
			)

			match else_expr:
				Some(found):
					folder(with_then, found)
				None:
					with_then
		ParsedMatchExpr(value, cases, _):
			var result = folder(initial, value)

			for case in cases:
				result = folder(result, case.body)

			result
		ParsedSelectExpr(arms, _):
			var result = initial

			for arm in arms:
				channel_or_timeout = match arm.kind:
					ParsedSelectReceiveArm(_, channel):
						channel
					ParsedSelectSealedArm(channel):
						channel
					ParsedSelectAfterArm(timeout):
						timeout

				result = folder(
					folder(result, channel_or_timeout),
					arm.body,
				)

			result
		ParsedWithExpr(binding, body, _):
			with_value = folder(initial, binding.value)

			with_error = match binding.error_map:
				Some(error_map):
					folder(with_value, error_map.value)
				None:
					with_value

			folder(with_error, body)
		ParsedDebugBlockExpr(body, _):
			folder(initial, body)
		ParsedLambdaExpr(_, _, _, body, _):
			folder(initial, body)
		ParsedFunctionDeclExpr(function_decl):
			match function_decl.body:
				Some(body):
					folder(initial, body)
				None:
					initial
		ParsedWhileExpr(condition, body, _):
			folder(
				folder(initial, condition),
				body,
			)
		ParsedForExpr(_, iterable, body, _):
			folder(
				folder(initial, iterable),
				body,
			)
		ParsedConcurrentBlockExpr(params, body, _):
			var result = initial

			for param in params:
				result = folder(result, param.value)

			folder(result, body)
		ParsedConcurrentForExpr(_, iterable, params, body, _):
			var result = folder(initial, iterable)

			for param in params:
				result = folder(result, param.value)

			folder(result, body)
		ParsedDetachExpr(body, _):
			folder(initial, body)
		ParsedVarDeclExpr(_, _, value, _, _):
			folder(initial, value)
		ParsedAssignExpr(_, value, _):
			folder(initial, value)
		ParsedCompoundAssignExpr(_, _, value, _):
			folder(initial, value)
		ParsedSubscriptAssignExpr(target, indices, value, _):
			folder(
				fold_expr_list(
					indices,
					folder(initial, target),
					folder,
				),
				value,
			)
		ParsedTupleDestructExpr(_, value, _):
			folder(initial, value)
		ParsedQuestionBindExpr(_, _, value, _):
			folder(initial, value)
		_:
			initial


pure func map_parsed_expr_children(
	expr: ParsedExpr,
	mapper: pure (ParsedExpr) -> ParsedExpr,
) -> ParsedExpr:
	match expr:
		ParsedStringInterpolationPartsExpr(parts, is_multiline, span):
			ParsedStringInterpolationPartsExpr(
				parts.map(func(part): map_interpolation_part(part, mapper)),
				is_multiline,
				span,
			)
		ParsedUnaryExpr(op, value, span):
			ParsedUnaryExpr(op, mapper(value), span)
		ParsedBinaryExpr(op, left, right, span):
			ParsedBinaryExpr(op, mapper(left), mapper(right), span)
		ParsedLogicalExpr(op, left, right, span):
			ParsedLogicalExpr(op, mapper(left), mapper(right), span)
		ParsedAscriptionExpr(value, type_expr, span):
			ParsedAscriptionExpr(mapper(value), type_expr, span)
		ParsedRangeExpr(start, finish, span):
			ParsedRangeExpr(mapper(start), mapper(finish), span)
		ParsedCallExpr(callee, args, span):
			ParsedCallExpr(
				mapper(callee),
				args.map(mapper),
				span,
			)
		ParsedFieldAccessExpr(target, field, span):
			ParsedFieldAccessExpr(mapper(target), field, span)
		ParsedSubscriptExpr(target, indices, span):
			ParsedSubscriptExpr(
				mapper(target),
				indices.map(mapper),
				span,
			)
		ParsedListExpr(items, span):
			ParsedListExpr(
				items.map(mapper),
				span,
			)
		ParsedTupleExpr(items, span):
			ParsedTupleExpr(
				items.map(mapper),
				span,
			)
		ParsedRecordExpr(fields, span):
			ParsedRecordExpr(
				fields.map(func(field): map_record_field(field, mapper)),
				span,
			)
		ParsedRecordUpdateExpr(base, fields, span):
			ParsedRecordUpdateExpr(
				mapper(base),
				fields.map(func(field): map_record_field(field, mapper)),
				span,
			)
		ParsedDictExpr(entries, span):
			ParsedDictExpr(
				entries.map(func(entry): map_dict_entry(entry, mapper)),
				span,
			)
		ParsedVectorExpr(items, span):
			ParsedVectorExpr(
				items.map(mapper),
				span,
			)
		ParsedOpaqueIntoExpr(type_expr, value, span):
			ParsedOpaqueIntoExpr(type_expr, mapper(value), span)
		ParsedOpaqueFromExpr(type_expr, value, span):
			ParsedOpaqueFromExpr(type_expr, mapper(value), span)
		ParsedBlockExpr(items, span):
			ParsedBlockExpr(
				items.map(mapper),
				span,
			)
		ParsedIfExpr(cond, then_expr, else_expr, span):
			ParsedIfExpr(
				mapper(cond),
				mapper(then_expr),
				else_expr.map(mapper),
				span,
			)
		ParsedMatchExpr(value, cases, span):
			ParsedMatchExpr(
				mapper(value),
				cases.map(func(case): map_match_case(case, mapper)),
				span,
			)
		ParsedSelectExpr(arms, span):
			ParsedSelectExpr(
				arms.map(func(arm): map_select_arm(arm, mapper)),
				span,
			)
		ParsedWithExpr(binding, body, span):
			ParsedWithExpr(
				map_with_binding(binding, mapper),
				mapper(body),
				span,
			)
		ParsedDebugBlockExpr(body, span):
			ParsedDebugBlockExpr(mapper(body), span)
		ParsedLambdaExpr(is_pure, params, return_type, body, span):
			ParsedLambdaExpr(is_pure, params, return_type, mapper(body), span)
		ParsedFunctionDeclExpr(decl):
			ParsedFunctionDeclExpr({ decl | body = decl.body.map(mapper) })
		ParsedWhileExpr(cond, body, span):
			ParsedWhileExpr(mapper(cond), mapper(body), span)
		ParsedForExpr(binder, iterable, body, span):
			ParsedForExpr(binder, mapper(iterable), mapper(body), span)
		ParsedConcurrentBlockExpr(params, body, span):
			ParsedConcurrentBlockExpr(
				params.map(func(param): map_concurrent_param(param, mapper)),
				mapper(body),
				span,
			)
		ParsedConcurrentForExpr(name, iterable, params, body, span):
			ParsedConcurrentForExpr(
				name,
				mapper(iterable),
				params.map(func(param): map_concurrent_param(param, mapper)),
				mapper(body),
				span,
			)
		ParsedDetachExpr(body, span):
			ParsedDetachExpr(mapper(body), span)
		ParsedVarDeclExpr(name, type_expr, value, is_mutable, span):
			ParsedVarDeclExpr(name, type_expr, mapper(value), is_mutable, span)
		ParsedAssignExpr(name, value, span):
			ParsedAssignExpr(name, mapper(value), span)
		ParsedCompoundAssignExpr(name, op, value, span):
			ParsedCompoundAssignExpr(name, op, mapper(value), span)
		ParsedSubscriptAssignExpr(target, indices, value, span):
			ParsedSubscriptAssignExpr(
				mapper(target),
				indices.map(mapper),
				mapper(value),
				span,
			)
		ParsedTupleDestructExpr(names, value, span):
			ParsedTupleDestructExpr(names, mapper(value), span)
		ParsedQuestionBindExpr(name, type_expr, value, span):
			ParsedQuestionBindExpr(name, type_expr, mapper(value), span)
		_:
			expr
