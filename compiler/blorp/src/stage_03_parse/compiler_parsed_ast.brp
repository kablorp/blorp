import:
	../stage_01_file_io/compiler_source: CompilerSourceFile, CompilerSourceSpan
	../stage_02_lex/compiler_parse_diagnostic:
		CompilerParseDiagnostic,
		compiler_parse_diagnostic_is_error,


enum ParsedProgramPhase:
	RawParsedProgram
	TypecheckSourceProgram


pure func parsed_program_phase_name(phase: ParsedProgramPhase) -> String:
	match phase:
		RawParsedProgram:
			"raw_parse"
		TypecheckSourceProgram:
			"typecheck_source"


pure func parsed_program_phase_from_name(name: String) -> Option[ParsedProgramPhase]:
	if name == "raw_parse":
		Some(RawParsedProgram)
	else if name == "typecheck_source":
		Some(TypecheckSourceProgram)
	else:
		None


record ParsedIdentifier {
	text: String,
	span: CompilerSourceSpan
}


enum ParsedDimBinaryOp:
	ParsedDimAddOp
	ParsedDimSubtractOp
	ParsedDimMultiplyOp
	ParsedDimDivideOp


union ParsedTypeExpr:
	ParsedNamedType(ParsedIdentifier, List[ParsedTypeExpr], CompilerSourceSpan)
	ParsedQualifiedNamedType(ParsedIdentifier, ParsedIdentifier, List[ParsedTypeExpr], CompilerSourceSpan)
	ParsedBoundedType(ParsedIdentifier, List[ParsedIdentifier], CompilerSourceSpan)
	ParsedDimNameType(ParsedIdentifier, Bool, CompilerSourceSpan)
	ParsedDimLiteralType(String, CompilerSourceSpan)
	ParsedDimBinaryType(ParsedDimBinaryOp, ParsedTypeExpr, ParsedTypeExpr, CompilerSourceSpan)
	ParsedRangeType(ParsedTypeExpr, CompilerSourceSpan)
	ParsedTupleType(List[ParsedTypeExpr], CompilerSourceSpan)
	ParsedFunctionType(Bool, List[ParsedTypeExpr], ParsedTypeExpr, CompilerSourceSpan)
	ParsedArrayType(ParsedTypeExpr, List[ParsedTypeExpr], CompilerSourceSpan)
	ParsedMissingType(CompilerSourceSpan)


record ParsedTypeParamDecl {
	name: ParsedIdentifier,
	bounds: List[ParsedIdentifier],
	span: CompilerSourceSpan
}


record ParsedDimConstraint {
	left: ParsedTypeExpr,
	right: ParsedTypeExpr,
	span: CompilerSourceSpan
}


union ParsedParamBinder:
	ParsedParamNameBinder(ParsedIdentifier)
	ParsedParamWildcardBinder(CompilerSourceSpan)
	ParsedParamTupleBinder(List[ParsedIdentifier], CompilerSourceSpan)


record ParsedParam {
	binder: ParsedParamBinder,
	type_expr: Option[ParsedTypeExpr],
	span: CompilerSourceSpan
}


record ParsedLambdaParam {
	name: ParsedIdentifier,
	type_expr: Option[ParsedTypeExpr],
	span: CompilerSourceSpan
}


enum ParsedBinaryOp:
	ParsedAddOp
	ParsedSubtractOp
	ParsedMultiplyOp
	ParsedDivideOp
	ParsedModuloOp
	ParsedEqualOp
	ParsedNotEqualOp
	ParsedLessOp
	ParsedLessEqualOp
	ParsedGreaterOp
	ParsedGreaterEqualOp


enum ParsedLogicalOp:
	ParsedAndOp
	ParsedOrOp


enum ParsedUnaryOp:
	ParsedNegateOp
	ParsedNotOp


enum ParsedCompoundAssignOp:
	ParsedAssignAddOp
	ParsedAssignSubtractOp
	ParsedAssignMultiplyOp
	ParsedAssignDivideOp


enum ParsedStringLiteralForm:
	ParsedPlainStringLiteral
	ParsedRawStringLiteral
	ParsedPipeStringLiteral
	ParsedRawPipeStringLiteral


enum ParsedFunctionAnnotation:
	ParsedTailRecursiveAnnotation
	ParsedNoCopyAnnotation
	ParsedDebugOnlyAnnotation
	ParsedResourceResultOrdinaryAnnotation


union ParsedListPatternSpread:
	ParsedListSpreadName(ParsedIdentifier)
	ParsedListSpreadWildcard(CompilerSourceSpan)


union ParsedPattern:
	ParsedWildcardPattern(CompilerSourceSpan)
	ParsedNamePattern(ParsedIdentifier)
	ParsedIntPattern(String, CompilerSourceSpan)
	ParsedFloatPattern(String, CompilerSourceSpan)
	ParsedStringPattern(String, ParsedStringLiteralForm, CompilerSourceSpan)
	ParsedCharPattern(Int, CompilerSourceSpan)
	ParsedBoolPattern(Bool, CompilerSourceSpan)
	ParsedConstructorPattern(ParsedIdentifier, List[ParsedPattern], CompilerSourceSpan)
	ParsedQualifiedConstructorPattern(ParsedIdentifier, ParsedIdentifier, List[ParsedPattern], CompilerSourceSpan)
	ParsedTuplePattern(List[ParsedPattern], CompilerSourceSpan)
	ParsedListPattern(List[ParsedPattern], Option[ParsedListPatternSpread], CompilerSourceSpan)
	ParsedOrPattern(List[ParsedPattern], CompilerSourceSpan)
	ParsedMissingPattern(CompilerSourceSpan)


record ParsedMatchCase {
	pattern: ParsedPattern,
	body: ParsedExpr,
	span: CompilerSourceSpan
}


union ParsedSelectArmKind:
	ParsedSelectReceiveArm(ParsedIdentifier, ParsedExpr)
	ParsedSelectSealedArm(ParsedExpr)
	ParsedSelectAfterArm(ParsedExpr)


record ParsedSelectArm {
	kind: ParsedSelectArmKind,
	body: ParsedExpr,
	span: CompilerSourceSpan
}


record ParsedRecordExprField {
	name: ParsedIdentifier,
	value: ParsedExpr,
	span: CompilerSourceSpan
}


record ParsedDictEntry {
	key: ParsedExpr,
	value: ParsedExpr,
	span: CompilerSourceSpan
}


record ParsedConcurrentParam {
	name: ParsedIdentifier,
	value: ParsedExpr,
	span: CompilerSourceSpan
}


enum ParsedWithBindingKind:
	ParsedWithPlainBinding
	ParsedWithTryBinding


record ParsedWithErrorMap {
	name: ParsedIdentifier,
	value: ParsedExpr,
	span: CompilerSourceSpan
}


record ParsedWithBinding {
	name: ParsedIdentifier,
	type_expr: Option[ParsedTypeExpr],
	value: ParsedExpr,
	kind: ParsedWithBindingKind,
	error_map: Option[ParsedWithErrorMap],
	span: CompilerSourceSpan
}


union ParsedForBinder:
	ParsedForNameBinder(ParsedIdentifier)
	ParsedForTupleBinder(List[ParsedIdentifier], CompilerSourceSpan)


union ParsedStringInterpolationPart:
	ParsedInterpolationLiteral(String)
	ParsedInterpolationExpr(ParsedExpr)


union ParsedExpr:
	ParsedNameExpr(ParsedIdentifier)
	ParsedIntLiteralExpr(String, CompilerSourceSpan)
	ParsedFloatLiteralExpr(String, CompilerSourceSpan)
	ParsedStringLiteralExpr(String, ParsedStringLiteralForm, CompilerSourceSpan)
	ParsedStringInterpolationExpr(String, Bool, CompilerSourceSpan)
	ParsedStringInterpolationPartsExpr(List[ParsedStringInterpolationPart], Bool, CompilerSourceSpan)
	ParsedBoolLiteralExpr(Bool, CompilerSourceSpan)
	ParsedCharLiteralExpr(Int, CompilerSourceSpan)
	ParsedUnaryExpr(ParsedUnaryOp, ParsedExpr, CompilerSourceSpan)
	ParsedBinaryExpr(ParsedBinaryOp, ParsedExpr, ParsedExpr, CompilerSourceSpan)
	ParsedLogicalExpr(ParsedLogicalOp, ParsedExpr, ParsedExpr, CompilerSourceSpan)
	ParsedAscriptionExpr(ParsedExpr, ParsedTypeExpr, CompilerSourceSpan)
	ParsedRangeExpr(ParsedExpr, ParsedExpr, CompilerSourceSpan)
	ParsedCallExpr(ParsedExpr, List[ParsedExpr], CompilerSourceSpan)
	ParsedFieldAccessExpr(ParsedExpr, ParsedIdentifier, CompilerSourceSpan)
	ParsedSubscriptExpr(ParsedExpr, List[ParsedExpr], CompilerSourceSpan)
	ParsedListExpr(List[ParsedExpr], CompilerSourceSpan)
	ParsedTupleExpr(List[ParsedExpr], CompilerSourceSpan)
	ParsedRecordExpr(List[ParsedRecordExprField], CompilerSourceSpan)
	ParsedRecordUpdateExpr(ParsedExpr, List[ParsedRecordExprField], CompilerSourceSpan)
	ParsedDictExpr(List[ParsedDictEntry], CompilerSourceSpan)
	ParsedVectorExpr(List[ParsedExpr], CompilerSourceSpan)
	ParsedOpaqueIntoExpr(ParsedTypeExpr, ParsedExpr, CompilerSourceSpan)
	ParsedOpaqueFromExpr(ParsedTypeExpr, ParsedExpr, CompilerSourceSpan)
	ParsedBlockExpr(List[ParsedExpr], CompilerSourceSpan)
	ParsedIfExpr(ParsedExpr, ParsedExpr, Option[ParsedExpr], CompilerSourceSpan)
	ParsedMatchExpr(ParsedExpr, List[ParsedMatchCase], CompilerSourceSpan)
	ParsedSelectExpr(List[ParsedSelectArm], CompilerSourceSpan)
	ParsedWithExpr(ParsedWithBinding, ParsedExpr, CompilerSourceSpan)
	ParsedDebugBlockExpr(ParsedExpr, CompilerSourceSpan)
	ParsedLambdaExpr(Bool, List[ParsedLambdaParam], Option[ParsedTypeExpr], ParsedExpr, CompilerSourceSpan)
	ParsedFunctionDeclExpr(ParsedFunctionDecl)
	ParsedWhileExpr(ParsedExpr, ParsedExpr, CompilerSourceSpan)
	ParsedForExpr(ParsedForBinder, ParsedExpr, ParsedExpr, CompilerSourceSpan)
	ParsedConcurrentBlockExpr(List[ParsedConcurrentParam], ParsedExpr, CompilerSourceSpan)
	ParsedConcurrentForExpr(ParsedIdentifier, ParsedExpr, List[ParsedConcurrentParam], ParsedExpr, CompilerSourceSpan)
	ParsedDetachExpr(ParsedExpr, CompilerSourceSpan)
	ParsedBreakExpr(CompilerSourceSpan)
	ParsedContinueExpr(CompilerSourceSpan)
	ParsedVoidExpr(CompilerSourceSpan)
	ParsedBuiltinExpr(Option[String], CompilerSourceSpan)
	ParsedVarDeclExpr(ParsedIdentifier, Option[ParsedTypeExpr], ParsedExpr, Bool, CompilerSourceSpan)
	ParsedAssignExpr(ParsedIdentifier, ParsedExpr, CompilerSourceSpan)
	ParsedCompoundAssignExpr(ParsedIdentifier, ParsedCompoundAssignOp, ParsedExpr, CompilerSourceSpan)
	ParsedSubscriptAssignExpr(ParsedExpr, List[ParsedExpr], ParsedExpr, CompilerSourceSpan)
	ParsedTupleDestructExpr(List[ParsedIdentifier], ParsedExpr, CompilerSourceSpan)
	ParsedQuestionBindExpr(ParsedIdentifier, Option[ParsedTypeExpr], ParsedExpr, CompilerSourceSpan)
	ParsedMissingExpr(CompilerSourceSpan)


union ParsedFunctionBodyKind:
	ParsedFunctionSourceBody
	ParsedFunctionBuiltinBody(Option[String])
	ParsedFunctionForwardDecl


record ParsedFunctionDecl {
	name: ParsedIdentifier,
	type_params: List[ParsedTypeParamDecl],
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	dim_constraints: List[ParsedDimConstraint],
	body: Option[ParsedExpr],
	is_pure: Bool,
	annotations: List[ParsedFunctionAnnotation],
	doc: Option[String],
	span: CompilerSourceSpan
}


pure func parsed_function_body_kind(body: Option[ParsedExpr]) -> ParsedFunctionBodyKind:
	match body:
		None:
			ParsedFunctionForwardDecl
		Some(ParsedBuiltinExpr(name, _)):
			ParsedFunctionBuiltinBody(name)
		Some(ParsedBlockExpr(items, _)):
			if items.length() != 1:
				ParsedFunctionSourceBody
			else:
				match items.get(0):
					Some(item):
						match parsed_function_body_kind(Some(item)):
							ParsedFunctionBuiltinBody(name):
								ParsedFunctionBuiltinBody(name)
							_:
								ParsedFunctionSourceBody
					None:
						ParsedFunctionSourceBody
		Some(_):
			ParsedFunctionSourceBody


pure func parsed_function_body_is_builtin(body: Option[ParsedExpr]) -> Bool:
	match parsed_function_body_kind(body):
		ParsedFunctionBuiltinBody(_):
			True
		_:
			False


record ParsedVarDecl {
	name: ParsedIdentifier,
	type_expr: Option[ParsedTypeExpr],
	value: ParsedExpr,
	is_mutable: Bool,
	span: CompilerSourceSpan
}


record ParsedImportSymbol {
	name: ParsedIdentifier,
	symbol_alias: Option[ParsedIdentifier],
	constructors: List[ParsedIdentifier],
	span: CompilerSourceSpan
}


record ParsedImportDecl {
	module_path: String,
	module_alias: Option[ParsedIdentifier],
	symbols: Option[List[ParsedImportSymbol]],
	span: CompilerSourceSpan
}


record ParsedForeignBlockArg {
	name: ParsedIdentifier,
	value: String,
	span: CompilerSourceSpan
}


record ParsedForeignFunctionDecl {
	name: ParsedIdentifier,
	params: List[ParsedParam],
	return_type: ParsedTypeExpr,
	c_name: Option[String],
	is_pure: Bool,
	is_private: Bool,
	annotations: List[ParsedFunctionAnnotation],
	span: CompilerSourceSpan
}


record ParsedFieldDecl {
	name: ParsedIdentifier,
	type_expr: ParsedTypeExpr,
	span: CompilerSourceSpan
}


record ParsedRecordDecl {
	name: ParsedIdentifier,
	type_params: List[ParsedTypeParamDecl],
	fields: List[ParsedFieldDecl],
	is_struct: Bool,
	doc: Option[String],
	span: CompilerSourceSpan
}


record ParsedVariantDecl {
	name: ParsedIdentifier,
	fields: List[ParsedTypeExpr],
	span: CompilerSourceSpan
}


record ParsedUnionDecl {
	name: ParsedIdentifier,
	type_params: List[ParsedTypeParamDecl],
	variants: List[ParsedVariantDecl],
	is_enum: Bool,
	doc: Option[String],
	span: CompilerSourceSpan
}


record ParsedResourceCleanup {
	builtin_name: String,
	span: CompilerSourceSpan
}


record ParsedBuiltinTypeDecl {
	name: ParsedIdentifier,
	type_params: List[ParsedTypeParamDecl],
	is_resource: Bool,
	cleanup: Option[ParsedResourceCleanup],
	doc: Option[String],
	span: CompilerSourceSpan
}


record ParsedTypeAliasDecl {
	name: ParsedIdentifier,
	type_params: List[ParsedTypeParamDecl],
	target: ParsedTypeExpr,
	is_opaque: Bool,
	doc: Option[String],
	span: CompilerSourceSpan
}


record ParsedTraitMethodDecl {
	name: ParsedIdentifier,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	body: Option[ParsedExpr],
	is_pure: Bool,
	span: CompilerSourceSpan
}


record ParsedTraitDecl {
	name: ParsedIdentifier,
	type_params: List[ParsedTypeParamDecl],
	supertraits: List[ParsedIdentifier],
	methods: List[ParsedTraitMethodDecl],
	doc: Option[String],
	span: CompilerSourceSpan
}


record ParsedImplDecl {
	trait_name: ParsedIdentifier,
	for_type: ParsedTypeExpr,
	methods: List[ParsedFunctionDecl],
	doc: Option[String],
	span: CompilerSourceSpan
}


union ParsedDecl:
	FunctionParsedDecl(ParsedFunctionDecl)
	VarParsedDecl(ParsedVarDecl)
	ImportBlockParsedDecl(List[ParsedImportDecl], CompilerSourceSpan)
	ForeignBlockParsedDecl(List[ParsedForeignBlockArg], List[ParsedForeignFunctionDecl], CompilerSourceSpan)
	RecordParsedDecl(ParsedRecordDecl)
	UnionParsedDecl(ParsedUnionDecl)
	BuiltinTypeParsedDecl(ParsedBuiltinTypeDecl)
	TypeAliasParsedDecl(ParsedTypeAliasDecl)
	TraitParsedDecl(ParsedTraitDecl)
	ImplParsedDecl(ParsedImplDecl)
	PrivateParsedDecl(ParsedDecl, CompilerSourceSpan)
	ParsedErrorDecl(CompilerSourceSpan)


record ParsedProgram {
	source: CompilerSourceFile,
	decls: List[ParsedDecl],
	diagnostics: List[CompilerParseDiagnostic]
}


pure func parsed_identifier(text: String, span: CompilerSourceSpan) -> ParsedIdentifier:
	{
		text = text,
		span = span
	}


pure func parsed_program_has_errors(program: ParsedProgram) -> Bool:
	var has_error: Bool = False

	for diagnostic in program.diagnostics:
		if compiler_parse_diagnostic_is_error(diagnostic):
			has_error = True
			break

	has_error


pure func parsed_program_ok(program: ParsedProgram) -> Bool:
	not parsed_program_has_errors(program)


pure func parsed_decl_span(decl: ParsedDecl) -> CompilerSourceSpan:
	match decl:
		FunctionParsedDecl(function_decl):
			function_decl.span
		VarParsedDecl(var_decl):
			var_decl.span
		ImportBlockParsedDecl(_, span):
			span
		ForeignBlockParsedDecl(_, _, span):
			span
		RecordParsedDecl(record_decl):
			record_decl.span
		UnionParsedDecl(union_decl):
			union_decl.span
		BuiltinTypeParsedDecl(type_decl):
			type_decl.span
		TypeAliasParsedDecl(type_alias_decl):
			type_alias_decl.span
		TraitParsedDecl(trait_decl):
			trait_decl.span
		ImplParsedDecl(impl_decl):
			impl_decl.span
		PrivateParsedDecl(_, span):
			span
		ParsedErrorDecl(span):
			span


pure func parsed_decl_name(decl: ParsedDecl) -> Option[String]:
	match decl:
		FunctionParsedDecl(function_decl):
			Some(function_decl.name.text)
		VarParsedDecl(var_decl):
			Some(var_decl.name.text)
		ImportBlockParsedDecl(_, _):
			Some("import")
		ForeignBlockParsedDecl(_, _, _):
			Some("foreign")
		RecordParsedDecl(record_decl):
			Some(record_decl.name.text)
		UnionParsedDecl(union_decl):
			Some(union_decl.name.text)
		BuiltinTypeParsedDecl(type_decl):
			Some(type_decl.name.text)
		TypeAliasParsedDecl(type_alias_decl):
			Some(type_alias_decl.name.text)
		TraitParsedDecl(trait_decl):
			Some(trait_decl.name.text)
		ImplParsedDecl(impl_decl):
			Some(impl_decl.trait_name.text)
		PrivateParsedDecl(inner, _):
			parsed_decl_name(inner)
		ParsedErrorDecl(_):
			None


pure func parsed_type_expr_span(type_expr: ParsedTypeExpr) -> CompilerSourceSpan:
	match type_expr:
		ParsedNamedType(_, _, span):
			span
		ParsedQualifiedNamedType(_, _, _, span):
			span
		ParsedBoundedType(_, _, span):
			span
		ParsedDimNameType(_, _, span):
			span
		ParsedDimLiteralType(_, span):
			span
		ParsedDimBinaryType(_, _, _, span):
			span
		ParsedRangeType(_, span):
			span
		ParsedTupleType(_, span):
			span
		ParsedFunctionType(_, _, _, span):
			span
		ParsedArrayType(_, _, span):
			span
		ParsedMissingType(span):
			span


pure func parsed_expr_span(expr: ParsedExpr) -> CompilerSourceSpan:
	match expr:
		ParsedNameExpr(identifier):
			identifier.span
		ParsedIntLiteralExpr(_, span):
			span
		ParsedFloatLiteralExpr(_, span):
			span
		ParsedStringLiteralExpr(_, _, span):
			span
		ParsedStringInterpolationExpr(_, _, span):
			span
		ParsedStringInterpolationPartsExpr(_, _, span):
			span
		ParsedBoolLiteralExpr(_, span):
			span
		ParsedCharLiteralExpr(_, span):
			span
		ParsedUnaryExpr(_, _, span):
			span
		ParsedBinaryExpr(_, _, _, span):
			span
		ParsedLogicalExpr(_, _, _, span):
			span
		ParsedAscriptionExpr(_, _, span):
			span
		ParsedRangeExpr(_, _, span):
			span
		ParsedCallExpr(_, _, span):
			span
		ParsedFieldAccessExpr(_, _, span):
			span
		ParsedSubscriptExpr(_, _, span):
			span
		ParsedListExpr(_, span):
			span
		ParsedTupleExpr(_, span):
			span
		ParsedRecordExpr(_, span):
			span
		ParsedRecordUpdateExpr(_, _, span):
			span
		ParsedDictExpr(_, span):
			span
		ParsedVectorExpr(_, span):
			span
		ParsedOpaqueIntoExpr(_, _, span):
			span
		ParsedOpaqueFromExpr(_, _, span):
			span
		ParsedBlockExpr(_, span):
			span
		ParsedIfExpr(_, _, _, span):
			span
		ParsedMatchExpr(_, _, span):
			span
		ParsedSelectExpr(_, span):
			span
		ParsedWithExpr(_, _, span):
			span
		ParsedDebugBlockExpr(_, span):
			span
		ParsedLambdaExpr(_, _, _, _, span):
			span
		ParsedFunctionDeclExpr(function_decl):
			function_decl.span
		ParsedWhileExpr(_, _, span):
			span
		ParsedForExpr(_, _, _, span):
			span
		ParsedConcurrentBlockExpr(_, _, span):
			span
		ParsedConcurrentForExpr(_, _, _, _, span):
			span
		ParsedDetachExpr(_, span):
			span
		ParsedBreakExpr(span):
			span
		ParsedContinueExpr(span):
			span
		ParsedVoidExpr(span):
			span
		ParsedBuiltinExpr(_, span):
			span
		ParsedVarDeclExpr(_, _, _, _, span):
			span
		ParsedAssignExpr(_, _, span):
			span
		ParsedCompoundAssignExpr(_, _, _, span):
			span
		ParsedSubscriptAssignExpr(_, _, _, span):
			span
		ParsedTupleDestructExpr(_, _, span):
			span
		ParsedQuestionBindExpr(_, _, _, span):
			span
		ParsedMissingExpr(span):
			span


pure func parsed_param_binder_span(binder: ParsedParamBinder) -> CompilerSourceSpan:
	match binder:
		ParsedParamNameBinder(identifier):
			identifier.span
		ParsedParamWildcardBinder(span):
			span
		ParsedParamTupleBinder(_, span):
			span


pure func parsed_pattern_span(pattern: ParsedPattern) -> CompilerSourceSpan:
	match pattern:
		ParsedWildcardPattern(span):
			span
		ParsedNamePattern(identifier):
			identifier.span
		ParsedIntPattern(_, span):
			span
		ParsedFloatPattern(_, span):
			span
		ParsedStringPattern(_, _, span):
			span
		ParsedCharPattern(_, span):
			span
		ParsedBoolPattern(_, span):
			span
		ParsedConstructorPattern(_, _, span):
			span
		ParsedQualifiedConstructorPattern(_, _, _, span):
			span
		ParsedTuplePattern(_, span):
			span
		ParsedListPattern(_, _, span):
			span
		ParsedOrPattern(_, span):
			span
		ParsedMissingPattern(span):
			span
