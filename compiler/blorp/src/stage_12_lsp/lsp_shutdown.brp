-- Decoder and response encoder for the LSP shutdown request.
--
-- Existing LSP clients commonly serialize absent parameters as JSON null, so
-- shutdown accepts either an omitted params field or null and rejects all other
-- parameter shapes.
import:
	json: JsonValue(JsonNull)
	lsp_json_rpc:
		LspJsonRpcEnvelope,
		decode_lsp_json_rpc_body,
		lsp_json_rpc_method,
		lsp_json_rpc_parameters,
		lsp_json_rpc_request_id,
		lsp_json_rpc_success_value,
	lsp_protocol:
		LspProtocolError(LspInvalidMethodParameters, LspMissingRequestId, LspUnknownMethod),
		LspProtocolInputOutcome(
			LspProtocolInputAccepted,
			LspProtocolInputIgnored,
			LspProtocolInputRejected,
		),
		LspRequestId,


private LSP_SHUTDOWN_METHOD: String = "shutdown"


record LspShutdownRequest {
	id: LspRequestId
}


pure func lsp_shutdown_method() -> String:
	LSP_SHUTDOWN_METHOD


private pure func shutdown_parameter_error() -> LspProtocolError:
	LspInvalidMethodParameters(LSP_SHUTDOWN_METHOD, "params must be omitted or null")


pure func decode_lsp_shutdown_envelope(
	envelope: LspJsonRpcEnvelope,
) -> LspProtocolInputOutcome[LspShutdownRequest]:
	method = lsp_json_rpc_method(envelope)
	request_id = lsp_json_rpc_request_id(envelope)

	if method != LSP_SHUTDOWN_METHOD:
		match request_id:
			Some(id):
				LspProtocolInputRejected({
					request_id = Some(id),
					error = LspUnknownMethod(method),
				})
			None:
				LspProtocolInputIgnored(LspUnknownMethod(method))
	else:
		match request_id:
			None:
				LspProtocolInputIgnored(LspMissingRequestId(method))
			Some(id):
				match lsp_json_rpc_parameters(envelope):
					None:
						LspProtocolInputAccepted({id = id})
					Some(JsonNull):
						LspProtocolInputAccepted({id = id})
					Some(_):
						LspProtocolInputRejected({
							request_id = Some(id),
							error = shutdown_parameter_error(),
						})


pure func decode_lsp_shutdown_request(body: String) -> LspProtocolInputOutcome[LspShutdownRequest]:
	match decode_lsp_json_rpc_body(body):
		Err(failure):
			LspProtocolInputRejected(failure)
		Ok(envelope):
			decode_lsp_shutdown_envelope(envelope)


pure func encode_lsp_shutdown_response(request: LspShutdownRequest) -> String:
	lsp_json_rpc_success_value(request.id, JsonNull).to_string()
