-- JSON-RPC envelope handling shared by every LSP method.
--
-- This module is intentionally unaware of LSP method parameters. It validates
-- the common request shape once, preserves a valid ID across later failures,
-- and owns the standard JSON-RPC success/error response envelopes.
import:
	float: is_finite
	json: JsonValue(JsonNull, JsonNumber, JsonObject, JsonString), as_string, get_field, parse_json
	lsp_protocol:
		LspProtocolError(
			LspInvalidMethodParameters,
			LspInvalidProtocolEnvelope,
			LspInvalidLifecycle,
			LspInvalidRequestId,
			LspMalformedJson,
			LspMissingProtocolField,
			LspMissingRequestId,
			LspServerNotInitialized,
			LspUnexpectedRequestId,
			LspUnknownMethod,
			LspUnsupportedProtocolVersion,
		),
		LspProtocolFailure,
		LspRequestId(LspIntegerRequestId, LspStringRequestId),


private LSP_JSON_RPC_VERSION: String = "2.0"

-- LSP's Integer base type is signed 32-bit even when the host Int is wider.
private LSP_INTEGER_MAX: Float = 2147483647.0

private LSP_INTEGER_MIN: Float = -2147483648.0

-- Reserved JSON-RPC 2.0 server error codes.
private JSON_RPC_PARSE_ERROR_CODE: Float = -32700.0

private JSON_RPC_INVALID_REQUEST_CODE: Float = -32600.0

private JSON_RPC_METHOD_NOT_FOUND_CODE: Float = -32601.0

private JSON_RPC_INVALID_PARAMS_CODE: Float = -32602.0

-- LSP reserves this server error for requests received before initialization.
private LSP_SERVER_NOT_INITIALIZED_CODE: Float = -32002.0


private record LspJsonRpcEnvelopeRep {
	request_id: Option[LspRequestId],
	method: String,
	params: Option[JsonValue]
}


-- Only successful common-envelope validation can construct this value. Method
-- codecs therefore receive proof that JSON-RPC version, ID, and method shape
-- have already been checked once by the shared decoder.
opaque type LspJsonRpcEnvelope = LspJsonRpcEnvelopeRep


private pure func json_rpc_envelope(rep: LspJsonRpcEnvelopeRep) -> LspJsonRpcEnvelope:
	into LspJsonRpcEnvelope(rep)


private pure func json_rpc_envelope_rep(envelope: LspJsonRpcEnvelope) -> LspJsonRpcEnvelopeRep:
	from LspJsonRpcEnvelope(envelope)


pure func lsp_json_rpc_request_id(envelope: LspJsonRpcEnvelope) -> Option[LspRequestId]:
	json_rpc_envelope_rep(envelope).request_id


pure func lsp_json_rpc_method(envelope: LspJsonRpcEnvelope) -> String:
	json_rpc_envelope_rep(envelope).method


pure func lsp_json_rpc_parameters(envelope: LspJsonRpcEnvelope) -> Option[JsonValue]:
	json_rpc_envelope_rep(envelope).params


private pure func protocol_failure(
	request_id: Option[LspRequestId],
	error: LspProtocolError,
) -> LspProtocolFailure:
	{
		request_id = request_id,
		error = error
	}


pure func lsp_integer_from_json(value: JsonValue) -> Option[Int]:
	match value:
		JsonNumber(number):
			if (
				not is_finite(number)
				or number < LSP_INTEGER_MIN
				or number > LSP_INTEGER_MAX
			):
				None
			else:
				id: Int = to_int(number)

				if to_float(id) == number:
					Some(id)
				else:
					None
		_:
			None


private pure func decode_request_id(value: JsonValue) -> Result[LspRequestId, LspProtocolError]:
	match value:
		JsonString(id):
			Ok(LspStringRequestId(id))
		JsonNumber(_):
			match lsp_integer_from_json(value):
				Some(id):
					Ok(LspIntegerRequestId(id))
				None:
					Err(LspInvalidRequestId)
		_:
			Err(LspInvalidRequestId)


private pure func decode_optional_request_id(
	root: JsonValue,
) -> Result[Option[LspRequestId], LspProtocolFailure]:
	match get_field(root, "id"):
		None:
			Ok(None)
		Some(value):
			match decode_request_id(value):
				Ok(id):
					Ok(Some(id))
				Err(error):
					Err(protocol_failure(None, error))


private pure func protocol_string_field(
	root: JsonValue,
	request_id: Option[LspRequestId],
	name: String,
) -> Result[String, LspProtocolFailure]:
	match get_field(root, name):
		Some(value):
			match as_string(value):
				Some(text):
					Ok(text)
				None:
					Err(
						protocol_failure(
							request_id,
							LspInvalidProtocolEnvelope("`${name}` must be a string"),
						),
					)
		None:
			Err(protocol_failure(request_id, LspMissingProtocolField(name)))


pure func decode_lsp_json_rpc_body(body: String) -> Result[LspJsonRpcEnvelope, LspProtocolFailure]:
	root ?= match parse_json(body):
		Ok(value):
			Ok(value)
		Err(message):
			Err(protocol_failure(None, LspMalformedJson(message)))

	match root:
		JsonObject(_):
			request_id ?= decode_optional_request_id(root)
			version ?= protocol_string_field(root, request_id, "jsonrpc")

			if version != LSP_JSON_RPC_VERSION:
				Err(protocol_failure(request_id, LspUnsupportedProtocolVersion(version)))
			else:
				method ?= protocol_string_field(root, request_id, "method")
				Ok(json_rpc_envelope({
					request_id = request_id,
					method = method,
					params = get_field(root, "params"),
				}))
		_:
			Err(
				protocol_failure(
					None,
					LspInvalidProtocolEnvelope("JSON-RPC body must be an object"),
				),
			)


private pure func request_id_json(request_id: Option[LspRequestId]) -> JsonValue:
	match request_id:
		None:
			JsonNull
		Some(LspIntegerRequestId(value)):
			JsonNumber(to_float(value))
		Some(LspStringRequestId(value)):
			JsonString(value)


private pure func protocol_error_code(error: LspProtocolError) -> Float:
	match error:
		LspMalformedJson(_):
			JSON_RPC_PARSE_ERROR_CODE
		LspUnknownMethod(_):
			JSON_RPC_METHOD_NOT_FOUND_CODE
		LspInvalidMethodParameters(_, _):
			JSON_RPC_INVALID_PARAMS_CODE
		LspServerNotInitialized(_):
			LSP_SERVER_NOT_INITIALIZED_CODE
		_:
			JSON_RPC_INVALID_REQUEST_CODE


private pure func protocol_error_message(error: LspProtocolError) -> String:
	match error:
		LspMalformedJson(_):
			"Parse error"
		LspUnknownMethod(_):
			"Method not found"
		LspInvalidMethodParameters(_, _):
			"Invalid params"
		LspServerNotInitialized(_):
			"Server not initialized"
		_:
			"Invalid Request"


private pure func protocol_error_detail(error: LspProtocolError) -> String:
	match error:
		LspMalformedJson(detail):
			detail
		LspInvalidProtocolEnvelope(detail):
			detail
		LspUnsupportedProtocolVersion(version):
			"unsupported JSON-RPC version `${version}`"
		LspUnknownMethod(method):
			"unknown method `${method}`"
		LspMissingProtocolField(field):
			"missing required field `${field}`"
		LspMissingRequestId(method):
			"request method `${method}` requires an ID"
		LspUnexpectedRequestId(method):
			"notification method `${method}` must not include an ID"
		LspInvalidLifecycle(method):
			"method `${method}` is not valid in the current server lifecycle state"
		LspServerNotInitialized(method):
			"method `${method}` requires an initialized server"
		LspInvalidRequestId:
			"request ID must be a string or signed 32-bit integer"
		LspInvalidMethodParameters(method, detail):
			"${method}: ${detail}"


pure func lsp_json_rpc_success_value(id: LspRequestId, result: JsonValue) -> JsonValue:
	JsonObject([
		("jsonrpc", JsonString(LSP_JSON_RPC_VERSION)),
		("id", request_id_json(Some(id))),
		("result", result),
	])


pure func lsp_json_rpc_error_value(failure: LspProtocolFailure) -> JsonValue:
	JsonObject([
		("jsonrpc", JsonString(LSP_JSON_RPC_VERSION)),
		("id", request_id_json(failure.request_id)),
		("error", JsonObject([
			("code", JsonNumber(protocol_error_code(failure.error))),
			("message", JsonString(protocol_error_message(failure.error))),
			("data", JsonString(protocol_error_detail(failure.error))),
		])),
	])
