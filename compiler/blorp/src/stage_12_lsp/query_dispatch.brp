-- Typed admission boundary for synchronous semantic LSP requests.
--
-- Each semantic codec owns its wire contract. This module owns the common
-- routing decision and preserves unhandled envelopes for document/lifecycle
-- dispatch, so the actor does not duplicate method-name checks or decode
-- outcomes. Query execution is still synchronous; a future asynchronous
-- query worker can attach ownership to SemanticQueryWork without changing
-- the protocol codecs.
import:
	analysis_model:
		SemanticIndexState(CurrentSemanticIndex, SemanticIndexUnavailable, StaleSemanticIndex),
	definition: DefinitionRequest, decode_lsp_definition_envelope, definition_method
	document_highlight:
		DocumentHighlightRequest,
		decode_lsp_document_highlight_envelope,
		document_highlight_method,
	document_symbol:
		DocumentSymbolRequest,
		decode_lsp_document_symbol_envelope,
		document_symbol_method,
	hover: HoverRequest, decode_lsp_hover_envelope, hover_method
	json_rpc: JsonRpcEnvelope, json_rpc_method
	protocol:
		ProtocolError,
		ProtocolFailure,
		ProtocolInputOutcome(ProtocolInputAccepted, ProtocolInputIgnored, ProtocolInputRejected),
	references: ReferencesRequest, decode_lsp_references_envelope, references_method
	snapshot_model: ConfigurationEpoch, WorkspaceRevision


union SemanticQueryRequest:
	DefinitionSemanticQuery(DefinitionRequest)
	DocumentSymbolSemanticQuery(DocumentSymbolRequest)
	DocumentHighlightSemanticQuery(DocumentHighlightRequest)
	ReferencesSemanticQuery(ReferencesRequest)
	HoverSemanticQuery(HoverRequest)


opaque type SemanticQueryToken = Int


pure func semantic_query_token(value: Int) -> SemanticQueryToken:
	into SemanticQueryToken(value)


pure func semantic_query_token_value(token: SemanticQueryToken) -> Int:
	from SemanticQueryToken(token)


-- A query work item owns the immutable semantic snapshot used by execution.
-- The actor can run it synchronously today, while a later worker can retain the
-- token and reject a completion whose ownership or snapshot is no longer current.
private record SemanticQuerySnapshotRep {
	semantic_index: SemanticIndexState,
	workspace_revision: WorkspaceRevision,
	configuration_epoch: ConfigurationEpoch
}


opaque type SemanticQuerySnapshot = SemanticQuerySnapshotRep


private pure func semantic_index_workspace_revision(
	semantic_index: SemanticIndexState,
) -> WorkspaceRevision:
	match semantic_index:
		CurrentSemanticIndex(index):
			index.workspace_revision
		StaleSemanticIndex(_, revision):
			revision
		SemanticIndexUnavailable(revision):
			revision


pure func semantic_query_snapshot(
	semantic_index: SemanticIndexState,
	configuration_epoch: ConfigurationEpoch,
) -> SemanticQuerySnapshot:
	into SemanticQuerySnapshot({
		semantic_index = semantic_index,
		workspace_revision = semantic_index_workspace_revision(semantic_index),
		configuration_epoch = configuration_epoch,
	})


pure func semantic_query_snapshot_semantic_index(
	snapshot: SemanticQuerySnapshot,
) -> SemanticIndexState:
	from SemanticQuerySnapshot(snapshot).semantic_index


pure func semantic_query_snapshot_workspace_revision(
	snapshot: SemanticQuerySnapshot,
) -> WorkspaceRevision:
	from SemanticQuerySnapshot(snapshot).workspace_revision


pure func semantic_query_snapshot_configuration_epoch(
	snapshot: SemanticQuerySnapshot,
) -> ConfigurationEpoch:
	from SemanticQuerySnapshot(snapshot).configuration_epoch


private record SemanticQueryWorkRep {
	token: SemanticQueryToken,
	request: SemanticQueryRequest,
	snapshot: SemanticQuerySnapshot
}


opaque type SemanticQueryWork = SemanticQueryWorkRep


pure func semantic_query_work(
	token: SemanticQueryToken,
	request: SemanticQueryRequest,
	snapshot: SemanticQuerySnapshot,
) -> SemanticQueryWork:
	into SemanticQueryWork({
		token = token,
		request = request,
		snapshot = snapshot,
	})


pure func semantic_query_work_token(work: SemanticQueryWork) -> SemanticQueryToken:
	from SemanticQueryWork(work).token


pure func semantic_query_work_request(work: SemanticQueryWork) -> SemanticQueryRequest:
	from SemanticQueryWork(work).request


pure func semantic_query_work_snapshot(work: SemanticQueryWork) -> SemanticQuerySnapshot:
	from SemanticQueryWork(work).snapshot


union SemanticQueryDispatch:
	SemanticQueryAccepted(SemanticQueryRequest)
	SemanticQueryRejected(ProtocolFailure)
	SemanticQueryIgnored(ProtocolError)
	SemanticQueryUnhandled(JsonRpcEnvelope)


private pure func dispatch_definition_query(envelope: JsonRpcEnvelope) -> SemanticQueryDispatch:
	match decode_lsp_definition_envelope(envelope):
		ProtocolInputAccepted(request):
			SemanticQueryAccepted(DefinitionSemanticQuery(request))
		ProtocolInputRejected(failure):
			SemanticQueryRejected(failure)
		ProtocolInputIgnored(error):
			SemanticQueryIgnored(error)


private pure func dispatch_document_symbol_query(
	envelope: JsonRpcEnvelope,
) -> SemanticQueryDispatch:
	match decode_lsp_document_symbol_envelope(envelope):
		ProtocolInputAccepted(request):
			SemanticQueryAccepted(DocumentSymbolSemanticQuery(request))
		ProtocolInputRejected(failure):
			SemanticQueryRejected(failure)
		ProtocolInputIgnored(error):
			SemanticQueryIgnored(error)


private pure func dispatch_document_highlight_query(
	envelope: JsonRpcEnvelope,
) -> SemanticQueryDispatch:
	match decode_lsp_document_highlight_envelope(envelope):
		ProtocolInputAccepted(request):
			SemanticQueryAccepted(DocumentHighlightSemanticQuery(request))
		ProtocolInputRejected(failure):
			SemanticQueryRejected(failure)
		ProtocolInputIgnored(error):
			SemanticQueryIgnored(error)


private pure func dispatch_references_query(envelope: JsonRpcEnvelope) -> SemanticQueryDispatch:
	match decode_lsp_references_envelope(envelope):
		ProtocolInputAccepted(request):
			SemanticQueryAccepted(ReferencesSemanticQuery(request))
		ProtocolInputRejected(failure):
			SemanticQueryRejected(failure)
		ProtocolInputIgnored(error):
			SemanticQueryIgnored(error)


private pure func dispatch_hover_query(envelope: JsonRpcEnvelope) -> SemanticQueryDispatch:
	match decode_lsp_hover_envelope(envelope):
		ProtocolInputAccepted(request):
			SemanticQueryAccepted(HoverSemanticQuery(request))
		ProtocolInputRejected(failure):
			SemanticQueryRejected(failure)
		ProtocolInputIgnored(error):
			SemanticQueryIgnored(error)


pure func dispatch_lsp_semantic_query(envelope: JsonRpcEnvelope) -> SemanticQueryDispatch:
	method = json_rpc_method(envelope)

	if method == definition_method():
		dispatch_definition_query(envelope)
	else if method == document_symbol_method():
		dispatch_document_symbol_query(envelope)
	else if method == document_highlight_method():
		dispatch_document_highlight_query(envelope)
	else if method == references_method():
		dispatch_references_query(envelope)
	else if method == hover_method():
		dispatch_hover_query(envelope)
	else:
		SemanticQueryUnhandled(envelope)
