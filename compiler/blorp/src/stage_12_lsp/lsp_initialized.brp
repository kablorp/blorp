-- The initialized notification completes the LSP initialization handshake.
--
-- Decoding an existing envelope lets the eventual router parse JSON exactly
-- once. The raw-body entry point remains a thin convenience for focused tests
-- and other callers that do not yet own a router.
import:
	json: JsonValue(JsonObject)
	lsp_json_rpc:
		LspJsonRpcEnvelope,
		decode_lsp_json_rpc_body,
		lsp_json_rpc_method,
		lsp_json_rpc_parameters,
		lsp_json_rpc_request_id,
	lsp_lifecycle_model:
		LspInitializedNotification(LspClientInitialized),
		LspLifecycleError,
		LspLifecycleState,
		lsp_lifecycle_accept_initialized,
	lsp_protocol:
		LspProtocolError(LspInvalidMethodParameters, LspUnexpectedRequestId, LspUnknownMethod),
		LspProtocolInputOutcome(
			LspProtocolInputAccepted,
			LspProtocolInputIgnored,
			LspProtocolInputRejected,
		),


private LSP_INITIALIZED_METHOD: String = "initialized"


pure func lsp_initialized_method() -> String:
	LSP_INITIALIZED_METHOD


private pure func initialized_parameter_error(detail: String) -> LspProtocolError:
	LspInvalidMethodParameters(LSP_INITIALIZED_METHOD, detail)


pure func decode_lsp_initialized_envelope(
	envelope: LspJsonRpcEnvelope,
) -> LspProtocolInputOutcome[LspInitializedNotification]:
	method = lsp_json_rpc_method(envelope)
	request_id = lsp_json_rpc_request_id(envelope)

	if method != LSP_INITIALIZED_METHOD:
		match request_id:
			Some(_):
				LspProtocolInputRejected({
					request_id = request_id,
					error = LspUnknownMethod(method),
				})
			None:
				LspProtocolInputIgnored(LspUnknownMethod(method))
	else:
		match request_id:
			Some(_):
				LspProtocolInputRejected({
					request_id = request_id,
					error = LspUnexpectedRequestId(method),
				})
			None:
				match lsp_json_rpc_parameters(envelope):
					None:
						LspProtocolInputAccepted(LspClientInitialized)
					Some(JsonObject(_)):
						LspProtocolInputAccepted(LspClientInitialized)
					Some(_):
						LspProtocolInputIgnored(
							initialized_parameter_error("params must be an object"),
						)


pure func decode_lsp_initialized_notification(
	body: String,
) -> LspProtocolInputOutcome[LspInitializedNotification]:
	match decode_lsp_json_rpc_body(body):
		Err(failure):
			LspProtocolInputRejected(failure)
		Ok(envelope):
			decode_lsp_initialized_envelope(envelope)


pure func handle_lsp_initialized_notification(
	state: LspLifecycleState,
	notification: LspInitializedNotification,
) -> Result[LspLifecycleState, LspLifecycleError]:
	lsp_lifecycle_accept_initialized(state, notification)
