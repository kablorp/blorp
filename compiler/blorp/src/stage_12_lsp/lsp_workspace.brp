-- Serialized immutable ownership for editor overlays and compiler workspace facts.
--
-- Filesystem effects and compiler analysis remain outside this reducer. Every
-- accepted event produces one self-consistent snapshot, so workers cannot pair
-- source text from one edit with dependency or configuration facts from another.
import:
	../stage_04_modules/frontend_graph:
		CompilerFrontendImportEdge,
		CompilerFrontendImportResolution(
			CompilerFrontendResolvedImport,
			CompilerFrontendUnresolvedImport,
		),
	../stage_04_modules/loaded_module:
		CompilerResolvedModuleIdentity,
		compiler_module_identities_equal,
		compiler_module_identity_from_resolved,
		compiler_module_origins_equal,
		compiler_resolved_module_identities_equal,
		compiler_resolved_module_identity_from_resolver,
		compiler_resolved_module_origin,
	lsp_analysis_cache:
		LspAnalysisCacheSnapshot,
		lsp_analysis_cache,
		lsp_analysis_cache_remove_typed_for_module,
		lsp_analysis_cache_store_lexed,
		lsp_analysis_cache_store_parsed,
		lsp_analysis_cache_store_typed,
		lsp_analysis_cache_typed,
		lsp_module_analysis_fingerprints_equal,
		lsp_parse_fingerprints_equal,
	lsp_analysis_model:
		LspIndexCoverage(LspCompleteIndexCoverage, LspPartialIndexCoverageState),
		LspLexedSnapshot,
		LspMissingIndexModule,
		LspModuleSemanticIndex,
		LspParsedSnapshot,
		LspPartialIndexReason(
			LspIndexAnalysisCancelled,
			LspIndexExtractionFailed,
			LspIndexParseFailed,
			LspIndexSourceUnavailable,
			LspIndexTypecheckFailed,
		),
		LspSemanticIndexSnapshot,
		LspSemanticIndexState(
			LspCurrentSemanticIndex,
			LspSemanticIndexUnavailable,
			LspStaleSemanticIndex,
		),
		LspTypedSnapshot,
		lsp_lexed_artifact_fingerprint,
		lsp_module_semantic_index_module_identity,
		lsp_module_semantic_index_uri,
		lsp_parsed_artifact_fingerprint,
		lsp_typed_artifact_fingerprint,
		lsp_typed_artifact_module_index,
	lsp_analysis_planner: lsp_analysis_roots_for_workspace, lsp_analysis_targets_for_workspace
	lsp_architecture:
		LspAnalysisCommit(LspAnalysisCommitted, LspCurrentAnalysisFailed, LspStaleAnalysisDropped),
		LspAnalysisCompletion,
		LspAnalysisPlan,
		LspAnalysisPlanningRequirement(LspAnalysisPlanRequired, LspNoAnalysisPlanRequired),
		LspAnalysisResult,
		LspAnalysisTarget,
		LspCommittedAnalysis,
		LspCompilerWorkspaceSnapshot,
		LspFailedAnalysisCommit,
		LspInvalidatedModule,
		LspInvalidationPlan,
		LspInvalidationReason(
			LspConfigurationInvalidated,
			LspDocumentIdentityInvalidated,
			LspModuleSetInvalidated,
			LspSourceContentInvalidated,
			LspSourceRemoved,
		),
		LspSuccessfulAnalysisTarget,
		LspTargetAnalysisFailure(
			LspTargetAnalysisCancelled,
			LspTargetParseFailed,
			LspTargetSemanticIndexFailed,
			LspTargetSourceUnavailable,
			LspTargetTypecheckFailed,
		),
		LspTargetAnalysisOutcome(LspTargetAnalysisFailed, LspTargetAnalysisSucceeded),
		LspWorkspaceError(
			LspAnalysisCompletionArtifactMismatch,
			LspAnalysisCompletionCoverageMismatch,
			LspAnalysisCompletionDiagnosticMismatch,
			LspAnalysisCompletionDuplicateTarget,
			LspAnalysisCompletionDependencyMismatch,
			LspAnalysisCompletionMissingTarget,
			LspAnalysisCompletionPlanMismatch,
			LspAnalysisCompletionRevisionMismatch,
			LspAnalysisCompletionUnknownTarget,
			LspOutOfOrderDocumentVersion,
			LspWorkspaceDocumentAlreadyOpen,
			LspWorkspaceDocumentNotOpen,
			LspWorkspaceModuleIdentityConflict,
		),
		LspWorkspaceSnapshot,
		LspWorkspaceTransition,
	lsp_diagnostic_model: LspDiagnosticPublication
	lsp_document_model:
		LspDocumentChange,
		LspDocumentSave,
		LspDocumentVersion,
		LspOpenedDocument,
		lsp_document_version_value,
	lsp_document_store:
