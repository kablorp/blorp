		lsp_remove_discovered_source,
		lsp_select_source,
		lsp_selected_compiler_identity_changed,
		lsp_selected_compiler_input_changed,
		lsp_selected_source,
		lsp_set_discovered_source,
		lsp_set_open_document_source,
		lsp_source_layers_for_uri,
		lsp_source_layers_from_discovered,
		lsp_source_snapshots_equal,
		lsp_update_open_document_source,
	lsp_workspace_store:
		LspDependencyStore,
		LspSourceStore,
		lsp_dependency_store,
		lsp_dependency_store_for_uri,
		lsp_dependency_store_from_values,
		lsp_dependency_store_get,
		lsp_dependency_store_length,
		lsp_dependency_store_remove_for_uri,
		lsp_dependency_store_set,
		lsp_dependency_store_values,
		lsp_dependency_stores_equal,
		lsp_source_store_length,
		lsp_source_store_values,


private record LspWorkspaceRep {
	documents: LspDocumentStore,
	snapshot: LspWorkspaceSnapshot
}


opaque type LspWorkspace = LspWorkspaceRep


private pure func workspace_rep(workspace: LspWorkspace) -> LspWorkspaceRep:
	from LspWorkspace(workspace)


private pure func empty_analysis_cache() -> LspAnalysisCacheSnapshot:
	lsp_analysis_cache()


private pure func dependencies_for_sources(
	sources: LspSourceStore,
) -> Result[LspDependencyStore, LspWorkspaceError]:
	var dependencies: List[LspModuleDependencyState] = []

	for layers in lsp_source_store_values(sources):
		match lsp_select_source(layers):
			Some(source_snapshot):
				source = lsp_source_snapshot_source(source_snapshot)
				identity = compiler_resolved_module_identity_from_resolver(
					source.module_name,
					lsp_source_snapshot_origin(source_snapshot),
				)
				dependencies = dependencies.append(
					LspUnparsedModuleDependencies(
						layers.uri,
						identity,
					),
				)
			None:
				void

	lsp_dependency_store_from_values(
		dependencies,
	).map_err(
		func(uri): LspWorkspaceModuleIdentityConflict(uri),
	)


pure func lsp_workspace(
	configuration: LspWorkspaceConfiguration,
	discovered_sources: List[LspDiscoveredSourceSnapshot],
) -> Result[LspWorkspace, LspWorkspaceError]:
	match lsp_source_layers_from_discovered(discovered_sources):
		Err(error):
			Err(error)
		Ok(sources):
			dependencies ?= dependencies_for_sources(sources)
			revision = lsp_initial_workspace_revision()
			compiler: LspCompilerWorkspaceSnapshot = {
				revision = revision,
				configuration_epoch = lsp_initial_configuration_epoch(),
				configuration = configuration,
				sources = sources,
				dependencies = dependencies,
				analysis_cache = empty_analysis_cache()
			}
			snapshot: LspWorkspaceSnapshot = {
				compiler = compiler,
				semantic_index = LspSemanticIndexUnavailable(revision)
			}

			Ok(into LspWorkspace({
					documents = lsp_document_store(),
					snapshot = snapshot,
				}))


pure func lsp_workspace_document_store(workspace: LspWorkspace) -> LspDocumentStore:
	workspace_rep(workspace).documents


pure func lsp_workspace_snapshot(workspace: LspWorkspace) -> LspWorkspaceSnapshot:
	workspace_rep(workspace).snapshot


private pure func reset_dependency(
	dependencies: LspDependencyStore,
	sources: LspSourceStore,
	uri: LspDocumentUri,
) -> LspDependencyStore:
	without_previous = lsp_dependency_store_remove_for_uri(dependencies, uri)

	match lsp_selected_source(sources, uri):
		Some(source_snapshot):
			source = lsp_source_snapshot_source(source_snapshot)
			identity = compiler_resolved_module_identity_from_resolver(
				source.module_name,
				lsp_source_snapshot_origin(source_snapshot),
			)
			lsp_dependency_store_set(
				without_previous,
				LspUnparsedModuleDependencies(uri, identity),
			)
		None:
			without_previous


private pure func semantic_index_after_revision(
	state: LspSemanticIndexState,
	next_revision: LspWorkspaceRevision,
	semantic_source_changed: Bool,
) -> LspSemanticIndexState:
	match state:
		LspCurrentSemanticIndex(index):
			if semantic_source_changed:
				LspStaleSemanticIndex(index, next_revision)
			else:
				LspCurrentSemanticIndex({ index | workspace_revision = next_revision })
		LspStaleSemanticIndex(index, _):
			LspStaleSemanticIndex(index, next_revision)
		LspSemanticIndexUnavailable(_):
			LspSemanticIndexUnavailable(next_revision)


private pure func transition_with_revision(
	rep: LspWorkspaceRep,
	documents: LspDocumentStore,
	configuration: LspWorkspaceConfiguration,
	configuration_epoch: LspConfigurationEpoch,
	sources: LspSourceStore,
	dependencies: LspDependencyStore,
	invalidated_modules: List[LspInvalidatedModule],
	diagnostics_to_clear: List[LspSnapshotIdentity],
	semantic_source_changed: Bool,
) -> (LspWorkspace, LspWorkspaceTransition):
	next_revision = lsp_next_workspace_revision(rep.snapshot.compiler.revision)
	compiler: LspCompilerWorkspaceSnapshot = {
		revision = next_revision,
		configuration_epoch = configuration_epoch,
		configuration = configuration,
		sources = sources,
		dependencies = dependencies,
		analysis_cache = rep.snapshot.compiler.analysis_cache
	}
	snapshot: LspWorkspaceSnapshot = {
		compiler = compiler,
		semantic_index = semantic_index_after_revision(
			rep.snapshot.semantic_index,
			next_revision,
			semantic_source_changed,
		)
	}
	workspace = into LspWorkspace({
		documents = documents,
		snapshot = snapshot,
	})
	invalidation: LspInvalidationPlan = {
		workspace_revision = next_revision,
		modules = invalidated_modules
	}
	transition: LspWorkspaceTransition = {
		snapshot = snapshot,
		invalidation = invalidation,
		analysis_planning = LspAnalysisPlanRequired,
		diagnostics_to_clear = diagnostics_to_clear
	}

	(workspace, transition)


private pure func no_op_transition(workspace: LspWorkspace) -> LspWorkspaceTransition:
	snapshot = lsp_workspace_snapshot(workspace)
	{
		snapshot = snapshot,
		invalidation = {
			workspace_revision = snapshot.compiler.revision,
			modules = []
		},
		analysis_planning = LspNoAnalysisPlanRequired,
		diagnostics_to_clear = []
	}


private pure func document_store_error(error: LspDocumentStoreError) -> LspWorkspaceError:
	match error:
		LspDocumentAlreadyOpen(uri):
			LspWorkspaceDocumentAlreadyOpen(uri)
		LspDocumentNotOpen(uri):
			LspWorkspaceDocumentNotOpen(uri)
		LspDocumentVersionNotNewer(uri, current, received):
			LspOutOfOrderDocumentVersion(uri, current, received)


private pure func invalidated_source(
	uri: LspDocumentUri,
	reason: LspInvalidationReason,
) -> List[LspInvalidatedModule]:
	[
		{
			uri = uri,
			reason = reason
		},
	]


private pure func document_invalidation_reason(
	compiler_input_changed: Bool,
) -> LspInvalidationReason:
	if compiler_input_changed:
		LspSourceContentInvalidated
	else:
		LspDocumentIdentityInvalidated


private pure func apply_document_open(
	workspace: LspWorkspace,
	resolved: LspResolvedDocumentOpen,
) -> Result[(LspWorkspace, LspWorkspaceTransition), LspWorkspaceError]:
	rep = workspace_rep(workspace)
	opened: LspOpenedDocument = resolved.document

	match lsp_document_store_open(rep.documents, opened):
		Err(error):
			Err(document_store_error(error))
		Ok(documents):
			sources = lsp_set_open_document_source(
				rep.snapshot.compiler.sources,
				opened,
				resolved.source,
				resolved.provenance,
			)
			compiler_input_changed = lsp_selected_compiler_input_changed(
				rep.snapshot.compiler.sources,
				sources,
				opened.document.uri,
			)

			dependencies = if compiler_input_changed:
				reset_dependency(rep.snapshot.compiler.dependencies, sources, opened.document.uri)
			else:
				rep.snapshot.compiler.dependencies

			Ok(
				transition_with_revision(
					rep,
					documents,
					rep.snapshot.compiler.configuration,
					rep.snapshot.compiler.configuration_epoch,
					sources,
					dependencies,
					invalidated_source(
						opened.document.uri,
						document_invalidation_reason(compiler_input_changed),
					),
					[],
					compiler_input_changed,
				),
			)


private pure func apply_document_change(
	workspace: LspWorkspace,
	changed: LspDocumentChange,
) -> Result[(LspWorkspace, LspWorkspaceTransition), LspWorkspaceError]:
	rep = workspace_rep(workspace)

	match lsp_document_store_change(rep.documents, changed):
		Err(error):
			Err(document_store_error(error))
		Ok(documents):
			match lsp_document_store_find(documents, changed.uri):
				None:
					Err(LspWorkspaceDocumentNotOpen(changed.uri))
				Some(opened):
					match lsp_update_open_document_source(rep.snapshot.compiler.sources, opened):
						None:
							Err(LspWorkspaceDocumentNotOpen(changed.uri))
						Some(sources):
							compiler_input_changed = lsp_selected_compiler_input_changed(
								rep.snapshot.compiler.sources,
								sources,
								changed.uri,
							)

							dependencies = if compiler_input_changed:
								reset_dependency(
									rep.snapshot.compiler.dependencies,
									sources,
									changed.uri,
								)
							else:
								rep.snapshot.compiler.dependencies

							Ok(
								transition_with_revision(
									rep,
									documents,
									rep.snapshot.compiler.configuration,
									rep.snapshot.compiler.configuration_epoch,
									sources,
									dependencies,
									invalidated_source(
										changed.uri,
										document_invalidation_reason(compiler_input_changed),
									),
									[],
									compiler_input_changed,
								),
							)


private pure func apply_document_save(
	workspace: LspWorkspace,
	saved: LspDocumentSave,
) -> Result[(LspWorkspace, LspWorkspaceTransition), LspWorkspaceError]:
	rep = workspace_rep(workspace)

	match lsp_document_store_save(rep.documents, saved):
		Err(error):
			Err(document_store_error(error))
		Ok(_):
			Ok((workspace, no_op_transition(workspace)))


private pure func apply_document_close(
	workspace: LspWorkspace,
	uri: LspDocumentUri,
) -> Result[(LspWorkspace, LspWorkspaceTransition), LspWorkspaceError]:
	rep = workspace_rep(workspace)

	match lsp_document_store_find(rep.documents, uri):
		None:
			Err(LspWorkspaceDocumentNotOpen(uri))
		Some(opened):
			match lsp_document_store_close(rep.documents, uri):
				Err(error):
					Err(document_store_error(error))
				Ok(documents):
					sources = lsp_close_open_document_source(rep.snapshot.compiler.sources, uri)
					source_exists = lsp_selected_source(sources, uri).is_some()
					compiler_input_changed = lsp_selected_compiler_input_changed(
						rep.snapshot.compiler.sources,
						sources,
						uri,
					)

					dependencies = if compiler_input_changed:
						reset_dependency(rep.snapshot.compiler.dependencies, sources, uri)
					else:
						rep.snapshot.compiler.dependencies

					reason = if source_exists:
						document_invalidation_reason(compiler_input_changed)
					else:
						LspSourceRemoved

					old_identity = lsp_snapshot_identity(
						uri,
						Some(opened.document.version),
						rep.snapshot.compiler.revision,
						rep.snapshot.compiler.configuration_epoch,
					)

					Ok(
						transition_with_revision(
							rep,
							documents,
							rep.snapshot.compiler.configuration,
							rep.snapshot.compiler.configuration_epoch,
							sources,
							dependencies,
							invalidated_source(uri, reason),
							[old_identity],
							compiler_input_changed,
						),
					)


private pure func apply_disk_source_update(
	workspace: LspWorkspace,
	discovered: LspDiscoveredSourceSnapshot,
) -> Result[(LspWorkspace, LspWorkspaceTransition), LspWorkspaceError]:
	rep = workspace_rep(workspace)
	existing = lsp_source_layers_for_uri(rep.snapshot.compiler.sources, discovered.uri)

	if existing.map(func(layers): layers.discovered_source) == Some(Some(discovered.layer)):
		Ok((workspace, no_op_transition(workspace)))
	else:
		sources = lsp_set_discovered_source(rep.snapshot.compiler.sources, discovered)
		adds_discovered_identity = existing
			.map(func(layers):
				layers.discovered_source.is_none()
			)
			.get_or(True)
		semantic_changed = lsp_selected_compiler_input_changed(
			rep.snapshot.compiler.sources,
			sources,
			discovered.uri,
		)
		identity_changed = lsp_selected_compiler_identity_changed(
			rep.snapshot.compiler.sources,
			sources,
			discovered.uri,
		)

		dependencies = if semantic_changed:
			reset_dependency(rep.snapshot.compiler.dependencies, sources, discovered.uri)
		else:
			rep.snapshot.compiler.dependencies

		invalidated_modules: List[LspInvalidatedModule] = if semantic_changed:
			if adds_discovered_identity or identity_changed:
				invalidated_source(discovered.uri, LspModuleSetInvalidated)
			else:
				invalidated_source(discovered.uri, LspSourceContentInvalidated)
		else:
			[]

		Ok(
			transition_with_revision(
				rep,
				rep.documents,
				rep.snapshot.compiler.configuration,
				rep.snapshot.compiler.configuration_epoch,
				sources,
				dependencies,
				invalidated_modules,
				[],
				semantic_changed,
			),
		)


private pure func apply_disk_source_remove(
	workspace: LspWorkspace,
	uri: LspDocumentUri,
) -> Result[(LspWorkspace, LspWorkspaceTransition), LspWorkspaceError]:
	rep = workspace_rep(workspace)

	match lsp_source_layers_for_uri(rep.snapshot.compiler.sources, uri):
		None:
			Ok((workspace, no_op_transition(workspace)))
		Some(existing):
			match existing.discovered_source:
				None:
					Ok((workspace, no_op_transition(workspace)))
				Some(_):
					sources = lsp_remove_discovered_source(rep.snapshot.compiler.sources, uri)
					semantic_changed = lsp_selected_compiler_input_changed(
						rep.snapshot.compiler.sources,
						sources,
						uri,
					)
					source_exists = lsp_selected_source(sources, uri).is_some()

					dependencies = if semantic_changed:
						reset_dependency(rep.snapshot.compiler.dependencies, sources, uri)
					else:
						rep.snapshot.compiler.dependencies

					reason = if source_exists:
						LspSourceContentInvalidated
					else:
						LspSourceRemoved

					invalidated_modules: List[LspInvalidatedModule] = if semantic_changed:
						invalidated_source(uri, reason)
					else:
						[]

					Ok(
						transition_with_revision(
							rep,
							rep.documents,
							rep.snapshot.compiler.configuration,
							rep.snapshot.compiler.configuration_epoch,
							sources,
							dependencies,
							invalidated_modules,
							[],
							semantic_changed,
						),
					)


private pure func configuration_invalidations(
	current_sources: LspSourceStore,
	next_sources: LspSourceStore,
) -> List[LspInvalidatedModule]:
	configured = lsp_source_store_values(next_sources).map(func(layers) -> LspInvalidatedModule: {
			uri = layers.uri,
			reason = LspConfigurationInvalidated
		})
	removed = lsp_source_store_values(
		current_sources,
	).filter_map(func(layers) -> Option[LspInvalidatedModule]:
		if lsp_selected_source(next_sources, layers.uri).is_some():
			None
		else:
			Some({
				uri = layers.uri,
				reason = LspSourceRemoved,
			})
	)

	configured + removed


private pure func apply_configuration_update(
	workspace: LspWorkspace,
	update: LspWorkspaceConfigurationUpdate,
) -> Result[(LspWorkspace, LspWorkspaceTransition), LspWorkspaceError]:
	rep = workspace_rep(workspace)

	match lsp_source_layers_from_discovered(update.sources):
		Err(error):
			Err(error)
		Ok(discovered_sources):
			sources = lsp_reconciled_configuration_sources(
				rep.snapshot.compiler.sources,
				discovered_sources,
			)
			dependencies ?= dependencies_for_sources(sources)
			Ok(
				transition_with_revision(
					rep,
					rep.documents,
					update.configuration,
					lsp_next_configuration_epoch(rep.snapshot.compiler.configuration_epoch),
					sources,
					dependencies,
					configuration_invalidations(rep.snapshot.compiler.sources, sources),
					[],
					True,
				),
			)


pure func lsp_apply_workspace_event(
	workspace: LspWorkspace,
	event: LspWorkspaceEvent,
) -> Result[(LspWorkspace, LspWorkspaceTransition), LspWorkspaceError]:
	match event:
		LspResolvedDocumentOpened(resolved):
			apply_document_open(workspace, resolved)
		LspWorkspaceDocumentChanged(changed):
			apply_document_change(workspace, changed)
		LspWorkspaceDocumentSaved(saved):
			apply_document_save(workspace, saved)
		LspWorkspaceDocumentClosed(uri):
			apply_document_close(workspace, uri)
		LspDiskSourceUpdated(discovered):
			apply_disk_source_update(workspace, discovered)
		LspDiskSourceRemoved(uri):
			apply_disk_source_remove(workspace, uri)
		LspWorkspaceConfigurationChanged(update):
			apply_configuration_update(workspace, update)


private pure func document_versions_equal(
	left: Option[LspDocumentVersion],
	right: Option[LspDocumentVersion],
) -> Bool:
	match (left, right):
		(None, None):
			True
		(Some(left_version), Some(right_version)):
			lsp_document_version_value(left_version) == lsp_document_version_value(right_version)
		_:
			False


private pure func snapshot_identities_equal(
	left: LspSnapshotIdentity,
	right: LspSnapshotIdentity,
) -> Bool:
	(
		left.uri == right.uri
		and document_versions_equal(left.document_version, right.document_version)
		and lsp_workspace_revision_value(
			left.workspace_revision,
		) == lsp_workspace_revision_value(right.workspace_revision)
		and lsp_configuration_epoch_value(
			left.configuration_epoch,
		) == lsp_configuration_epoch_value(right.configuration_epoch)
	)


private pure func analysis_targets_equal(left: LspAnalysisTarget, right: LspAnalysisTarget) -> Bool:
	(
		snapshot_identities_equal(left.identity, right.identity)
		and compiler_resolved_module_identities_equal(
			left.resolved_module_identity,
			right.resolved_module_identity,
		)
		and lsp_module_analysis_fingerprints_equal(left.fingerprint, right.fingerprint)
	)


private pure func selected_sources(sources: LspSourceStore) -> List[LspSourceSnapshot]:
	lsp_source_store_values(sources).filter_map(lsp_select_source)


private pure func plan_sources_match_current(
	plan: LspAnalysisPlan,
	current: LspCompilerWorkspaceSnapshot,
) -> Bool:
	if lsp_source_store_length(plan.workspace.sources) != lsp_source_store_length(current.sources):
		False
	else:
		selected_sources(current.sources).all(func(current_source):
			planned = lsp_selected_source(
				plan.workspace.sources,
				lsp_source_snapshot_uri(current_source),
			)
			planned
				.map(func(planned_source):
					lsp_source_snapshots_equal(current_source, planned_source)
				)
				.get_or(False)
		)


private pure func plan_targets_cover_sources(
	plan: LspAnalysisPlan,
	current: LspCompilerWorkspaceSnapshot,
) -> Bool:
	expected_targets = lsp_analysis_targets_for_workspace(current)
	sources_covered = expected_targets.all(func(expected):
		(
			plan.targets.any(func(target): analysis_targets_equal(target, expected))
			or lsp_analysis_cache_typed(
				plan.workspace.analysis_cache,
				expected.fingerprint,
			).is_some()
		)
	)
	targets_known = plan.targets.all(func(target):
		expected_targets.any(func(expected):
			analysis_targets_equal(target, expected)
		)
	)
	sources_covered and targets_known


private pure func analysis_root_lists_equal(
	left: List[CompilerResolvedModuleIdentity],
	right: List[CompilerResolvedModuleIdentity],
) -> Bool:
	match (left, right):
		([], []):
			True
		([left_root, ...left_remaining], [right_root, ...right_remaining]):
			(
				compiler_resolved_module_identities_equal(left_root, right_root)
				and analysis_root_lists_equal(left_remaining, right_remaining)
			)
		_:
			False


private pure func validate_analysis_plan(
	plan: LspAnalysisPlan,
	current: LspCompilerWorkspaceSnapshot,
) -> Result[Void, LspWorkspaceError]:
	if (
		lsp_workspace_revision_value(
			plan.workspace_revision,
		) != lsp_workspace_revision_value(current.revision)
		or lsp_workspace_revision_value(
			plan.workspace.revision,
		) != lsp_workspace_revision_value(current.revision)
	):
		Err(LspAnalysisCompletionPlanMismatch("scheduled workspace revision changed"))
	else if lsp_configuration_epoch_value(
		plan.workspace.configuration_epoch,
	) != lsp_configuration_epoch_value(current.configuration_epoch):
		Err(LspAnalysisCompletionPlanMismatch("scheduled configuration epoch changed"))
	else if not lsp_workspace_configurations_equal(
		plan.workspace.configuration,
		current.configuration,
	):
		Err(LspAnalysisCompletionPlanMismatch("scheduled workspace configuration changed"))
	else if not plan_sources_match_current(plan, current):
		Err(LspAnalysisCompletionPlanMismatch("scheduled source snapshot changed"))
	else if not lsp_dependency_stores_equal(plan.workspace.dependencies, current.dependencies):
		Err(LspAnalysisCompletionPlanMismatch("scheduled dependency snapshot changed"))
	else if not analysis_root_lists_equal(plan.roots, lsp_analysis_roots_for_workspace(current)):
		Err(LspAnalysisCompletionPlanMismatch("scheduled open roots changed"))
	else if not plan_targets_cover_sources(plan, current):
		Err(LspAnalysisCompletionPlanMismatch("scheduled targets do not cover all open sources"))
	else:
		Ok(void)


private pure func outcome_target(outcome: LspTargetAnalysisOutcome) -> LspAnalysisTarget:
	match outcome:
		LspTargetAnalysisSucceeded(success):
			success.target
		LspTargetAnalysisFailed(failure):
			failure.target


private pure func lexed_matches_target(
	snapshot: LspLexedSnapshot,
	target: LspAnalysisTarget,
) -> Bool:
	fingerprint = lsp_lexed_artifact_fingerprint(snapshot.artifact)

	(
		snapshot_identities_equal(snapshot.identity, target.identity)
		and fingerprint.uri == target.identity.uri
		and fingerprint.source.value == target.fingerprint.source.value
		and fingerprint.frontend.value == target.fingerprint.frontend.value
	)


private pure func parsed_matches_target(
	snapshot: LspParsedSnapshot,
	target: LspAnalysisTarget,
) -> Bool:
	fingerprint = lsp_parsed_artifact_fingerprint(snapshot.artifact)

	(
		snapshot_identities_equal(snapshot.identity, target.identity)
		and fingerprint.uri == target.identity.uri
		and fingerprint.source.value == target.fingerprint.source.value
		and fingerprint.frontend.value == target.fingerprint.frontend.value
	)


private pure func typed_matches_target(
	snapshot: LspTypedSnapshot,
	target: LspAnalysisTarget,
) -> Bool:
	(
		snapshot_identities_equal(snapshot.identity, target.identity)
		and lsp_module_analysis_fingerprints_equal(
			lsp_typed_artifact_fingerprint(snapshot.artifact),
			target.fingerprint,
		)
		and lsp_module_semantic_index_uri(
			lsp_typed_artifact_module_index(snapshot.artifact),
		) == target.identity.uri
	)


private pure func outcome_artifacts_match_target(outcome: LspTargetAnalysisOutcome) -> Bool:
	match outcome:
		LspTargetAnalysisSucceeded(success):
			(
				lexed_matches_target(success.lexed, success.target)
				and parsed_matches_target(success.parsed, success.target)
				and typed_matches_target(success.typed, success.target)
			)
		LspTargetAnalysisFailed(failure):
			lexed_ok = failure.lexed
				.map(func(snapshot):
					lexed_matches_target(snapshot, failure.target)
				)
				.get_or(True)
			parsed_ok = failure.parsed
				.map(func(snapshot):
					parsed_matches_target(snapshot, failure.target)
				)
				.get_or(True)
			lexed_ok and parsed_ok


private pure func outcome_diagnostics_match_target(outcome: LspTargetAnalysisOutcome) -> Bool:
	target = outcome_target(outcome)

	diagnostics = match outcome:
		LspTargetAnalysisSucceeded(success):
			success.diagnostics
		LspTargetAnalysisFailed(failure):
			failure.diagnostics

	diagnostics.all(func(publication):
		snapshot_identities_equal(publication.identity, target.identity)
	)


private pure func validate_analysis_result(
	plan_targets: List[LspAnalysisTarget],
	result: LspAnalysisResult,
) -> Result[Void, LspWorkspaceError]:
	var seen: List[LspAnalysisTarget] = []
	var error: Option[LspWorkspaceError] = None

	for outcome in result.outcomes:
		if error.is_none():
			target = outcome_target(outcome)

			if seen.any(func(existing): analysis_targets_equal(existing, target)):
				error = Some(LspAnalysisCompletionDuplicateTarget(target.identity.uri))
			else if not plan_targets.any(func(planned): analysis_targets_equal(planned, target)):
				error = Some(LspAnalysisCompletionUnknownTarget(target.identity.uri))
			else if not outcome_artifacts_match_target(outcome):
				error = Some(LspAnalysisCompletionArtifactMismatch(target.identity.uri))
			else if not outcome_diagnostics_match_target(outcome):
				error = Some(LspAnalysisCompletionDiagnosticMismatch(target.identity.uri))
			else:
				seen = seen.append(target)

	if error.is_none():
		for planned in plan_targets:
			if (
				error.is_none()
				and not seen.any(func(found): analysis_targets_equal(found, planned))
			):
				error = Some(LspAnalysisCompletionMissingTarget(planned.identity.uri))

	match error:
		Some(found):
			Err(found)
		None:
			Ok(void)


private pure func dependency_edge_matches_selected_graph(
	edge: CompilerFrontendImportEdge,
	importer: CompilerResolvedModuleIdentity,
	selected_identities: List[CompilerResolvedModuleIdentity],
) -> Bool:
	importer_matches = compiler_resolved_module_identities_equal(edge.importer, importer)

	target_matches = match edge.resolution:
		CompilerFrontendUnresolvedImport:
			True
		CompilerFrontendResolvedImport(target):
			selected_identities.any(func(identity):
				compiler_resolved_module_identities_equal(identity, target)
			)

	importer_matches and target_matches


private pure func validate_analysis_dependencies(
	sources: LspSourceStore,
	dependencies: LspDependencyStore,
	outcomes: List[LspTargetAnalysisOutcome],
) -> Result[Void, LspWorkspaceError]:
	dependency_values = lsp_dependency_store_values(dependencies)
	expected_identities = dependency_values.map(lsp_module_dependency_identity)
	var error: Option[String] = None

	for outcome in outcomes:
		target = outcome_target(outcome)

		if (
			error.is_none()
			and not lsp_dependency_store_for_uri(
				dependencies,
				target.identity.uri,
			).any(func(dependency):
				compiler_module_identities_equal(
					compiler_module_identity_from_resolved(
						lsp_module_dependency_identity(dependency),
					),
					target.fingerprint.module_identity,
				)
			)
		):
			error = Some("analysis target has no dependency phase result")

	for state in dependency_values:
		if error.is_none():
			identity = lsp_module_dependency_identity(state)
			uri = lsp_module_dependency_uri(state)
			source_snapshot = lsp_selected_source(sources, uri)
			outcome = outcomes.find(func(candidate):
				compiler_module_identities_equal(
					outcome_target(candidate).fingerprint.module_identity,
					compiler_module_identity_from_resolved(identity),
				)
			)

			match source_snapshot:
				None:
					error = Some(
						"dependency result references a source outside the scheduled snapshot",
					)
				Some(source):
					if not compiler_module_origins_equal(
						compiler_resolved_module_origin(identity),
						lsp_source_snapshot_origin(source),
					):
						error = Some("dependency module origin does not match selected source")
					else:
						phase_allowed = match (outcome, state):
							(Some(LspTargetAnalysisSucceeded(_)), LspResolvedDependencies(_)):
								True
							(Some(LspTargetAnalysisFailed(failure)), _):
								match failure.failure:
									LspTargetParseFailed:
										match state:
											LspUnparsedModuleDependencies(_, _):
												True
											LspParsedDependencies(_):
												True
											_:
												False
									LspTargetSourceUnavailable:
										match state:
											LspUnparsedModuleDependencies(_, _):
												True
											_:
												False
									LspTargetTypecheckFailed:
										match state:
											LspResolvedDependencies(_):
												True
											_:
												False
									LspTargetSemanticIndexFailed:
										match state:
											LspResolvedDependencies(_):
												True
											_:
												False
									LspTargetAnalysisCancelled:
										True
							(None, LspResolvedDependencies(_)):
								True
							_:
								False

						if not phase_allowed:
							error = Some("dependency phase does not match target analysis outcome")
						else:
							match state:
								LspResolvedDependencies(resolved):
									var edges_valid: Bool = True

									for edge in resolved.import_edges:
										if edges_valid:
											edges_valid = dependency_edge_matches_selected_graph(
												edge,
												resolved.module_identity,
												expected_identities,
											)

									if not edges_valid:
										error = Some(
											"resolved dependency edge is outside the selected source graph",
										)
								_:
									void

	match error:
		Some(message):
			Err(LspAnalysisCompletionDependencyMismatch(message))
		None:
			Ok(void)


private pure func partial_reason(failure: LspTargetAnalysisFailure) -> LspPartialIndexReason:
	match failure:
		LspTargetParseFailed:
			LspIndexParseFailed
		LspTargetTypecheckFailed:
			LspIndexTypecheckFailed
		LspTargetSemanticIndexFailed:
			LspIndexExtractionFailed
		LspTargetAnalysisCancelled:
			LspIndexAnalysisCancelled
		LspTargetSourceUnavailable:
			LspIndexSourceUnavailable


private record LspCompletionProducts {
	cache: LspAnalysisCacheSnapshot,
	indexes: List[LspModuleSemanticIndex],
	missing: List[LspMissingIndexModule],
	diagnostics: List[LspDiagnosticPublication]
}


private pure func prior_index_modules(state: LspSemanticIndexState) -> List[LspModuleSemanticIndex]:
	match state:
		LspCurrentSemanticIndex(index):
			index.modules
		LspStaleSemanticIndex(index, _):
			index.modules
		LspSemanticIndexUnavailable(_):
			[]


private pure func targets_contain_index(
	targets: List[LspAnalysisTarget],
	index: LspModuleSemanticIndex,
) -> Bool:
	targets.any(func(target):
		compiler_module_identities_equal(
			target.fingerprint.module_identity,
			lsp_module_semantic_index_module_identity(index),
		)
	)


private pure func prior_missing_modules(
	state: LspSemanticIndexState,
) -> List[LspMissingIndexModule]:
	index: Option[LspSemanticIndexSnapshot] = match state:
		LspCurrentSemanticIndex(found):
			Some(found)
		LspStaleSemanticIndex(found, _):
			Some(found)
		LspSemanticIndexUnavailable(_):
			None

	match index:
		None:
			[]
		Some(found):
			match found.coverage:
				LspCompleteIndexCoverage:
					[]
				LspPartialIndexCoverageState(partial):
					partial.missing_modules


private pure func targets_contain_missing_module(
	targets: List[LspAnalysisTarget],
	module: LspMissingIndexModule,
) -> Bool:
	targets.any(func(target):
		compiler_module_identities_equal(target.fingerprint.module_identity, module.module_identity)
	)


private pure func remove_target_index(
	indexes: List[LspModuleSemanticIndex],
	target: LspAnalysisTarget,
) -> List[LspModuleSemanticIndex]:
	indexes.filter(func(index):
		not compiler_module_identities_equal(
			lsp_module_semantic_index_module_identity(index),
			target.fingerprint.module_identity,
		)
	)


private pure func remove_target_missing(
	missing: List[LspMissingIndexModule],
	target: LspAnalysisTarget,
) -> List[LspMissingIndexModule]:
	missing.filter(func(module):
		not compiler_module_identities_equal(
			module.module_identity,
			target.fingerprint.module_identity,
		)
	)


private pure func completion_products(
	initial_cache: LspAnalysisCacheSnapshot,
	initial_index: LspSemanticIndexState,
	current_targets: List[LspAnalysisTarget],
	outcomes: List[LspTargetAnalysisOutcome],
) -> LspCompletionProducts:
	var cache = initial_cache
	var indexes = prior_index_modules(initial_index).filter(func(index):
		targets_contain_index(current_targets, index)
	)
	var missing = prior_missing_modules(initial_index).filter(func(module):
		targets_contain_missing_module(current_targets, module)
	)
	var diagnostics: List[LspDiagnosticPublication] = []

	for outcome in outcomes:
		match outcome:
			LspTargetAnalysisSucceeded(success):
				indexes = remove_target_index(indexes, success.target)
				missing = remove_target_missing(missing, success.target)
				cache = lsp_analysis_cache_store_lexed(cache, success.lexed.artifact)
				cache = lsp_analysis_cache_store_parsed(cache, success.parsed.artifact)
				cache = lsp_analysis_cache_store_typed(cache, success.typed.artifact)
				indexes = indexes.append(lsp_typed_artifact_module_index(success.typed.artifact))
				diagnostics = diagnostics.concat(success.diagnostics)
			LspTargetAnalysisFailed(failure):
				indexes = remove_target_index(indexes, failure.target)
				missing = remove_target_missing(missing, failure.target)
				cache = lsp_analysis_cache_remove_typed_for_module(
					cache,
					failure.target.fingerprint.module_identity,
				)

				match failure.lexed:
					Some(snapshot):
						cache = lsp_analysis_cache_store_lexed(cache, snapshot.artifact)
					None:
						void

				match failure.parsed:
					Some(snapshot):
						cache = lsp_analysis_cache_store_parsed(cache, snapshot.artifact)
					None:
						void

				missing = missing.append({
					uri = failure.target.identity.uri,
					module_identity = failure.target.fingerprint.module_identity,
					reason = partial_reason(failure.failure),
				})
				diagnostics = diagnostics.concat(failure.diagnostics)

	{
		cache = cache,
		indexes = indexes,
		missing = missing,
		diagnostics = diagnostics
	}


private pure func validate_index_coverage(
	products: LspCompletionProducts,
	targets: List[LspAnalysisTarget],
) -> Result[Void, LspWorkspaceError]:
	var error: Option[String] = None

	-- Semantic artifacts and diagnostics are publication-target products. Closed
	-- reachable dependencies remain in the dependency graph, but are not required
	-- to manufacture an editor index until they become open targets.
	for target in targets:
		if error.is_none():
			module_identity = target.fingerprint.module_identity
			missing_count = products.missing
				.filter(func(module):
					compiler_module_identities_equal(module.module_identity, module_identity)
				)
				.length()

			index_count = products.indexes
				.filter(func(index):
					compiler_module_identities_equal(
						lsp_module_semantic_index_module_identity(index),
						module_identity,
					)
				)
				.length()

			if missing_count + index_count != 1:
				error = Some((
						"each analysis target must have exactly one semantic index or partial-coverage "
						+ "reason"
					))

	match error:
		Some(message):
			Err(LspAnalysisCompletionCoverageMismatch(message))
		None:
			Ok(void)


pure func lsp_apply_analysis_completion(
	workspace: LspWorkspace,
	completion: LspAnalysisCompletion,
) -> Result[(LspWorkspace, LspAnalysisCommit), LspWorkspaceError]:
	rep = workspace_rep(workspace)
	current_revision = rep.snapshot.compiler.revision
	scheduled_revision = completion.scheduled.plan.workspace_revision

	if lsp_workspace_revision_value(
		current_revision,
	) != lsp_workspace_revision_value(scheduled_revision):
		Ok((workspace, LspStaleAnalysisDropped(completion)))
	else:
		plan_validation ?= validate_analysis_plan(completion.scheduled.plan, rep.snapshot.compiler)

		match completion.result:
			Err(failure):
				failed: LspFailedAnalysisCommit = {
					snapshot = rep.snapshot,
					scheduled = completion.scheduled,
					failure = failure
				}
				Ok((workspace, LspCurrentAnalysisFailed(failed)))
			Ok(result):
				if lsp_workspace_revision_value(
					result.workspace_revision,
				) != lsp_workspace_revision_value(scheduled_revision):
					Err(
						LspAnalysisCompletionRevisionMismatch(
							scheduled_revision,
							result.workspace_revision,
						),
					)
				else:
					validation_result ?= validate_analysis_result(
						completion.scheduled.plan.targets,
						result,
					)
					dependency_validation ?= validate_analysis_dependencies(
						rep.snapshot.compiler.sources,
						result.dependencies,
						result.outcomes,
					)
					current_targets = lsp_analysis_targets_for_workspace(rep.snapshot.compiler)
					products = completion_products(
						rep.snapshot.compiler.analysis_cache,
						rep.snapshot.semantic_index,
						current_targets,
						result.outcomes,
					)
					coverage_validation ?= validate_index_coverage(products, current_targets)

					coverage: LspIndexCoverage = if products.missing.length() == 0:
						LspCompleteIndexCoverage
					else:
						LspPartialIndexCoverageState({missing_modules = products.missing})

					index: LspSemanticIndexSnapshot = {
						workspace_revision = current_revision,
						modules = products.indexes,
						coverage = coverage
					}
					compiler = { rep.snapshot.compiler |
						dependencies = result.dependencies,
						analysis_cache = products.cache
					}
					snapshot: LspWorkspaceSnapshot = {
						compiler = compiler,
						semantic_index = LspCurrentSemanticIndex(index)
					}
					updated = into LspWorkspace({ rep | snapshot = snapshot })
					committed: LspCommittedAnalysis = {
						snapshot = snapshot,
						diagnostics = products.diagnostics
					}
					Ok((updated, LspAnalysisCommitted(committed)))
