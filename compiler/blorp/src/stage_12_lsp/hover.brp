-- JSON-RPC codec for the first hover slice.
-- Wire validation stays separate from exact semantic identity lookup in
-- hover_query, so an invalid position never reaches compiler-owned state.
import:
	document_sync_codec: document_parameter_error, required_object_field, required_string_field
	hover_model: HoverInfo
	identity: DocumentUri, document_uri
	json: JsonValue(JsonNull, JsonNumber, JsonObject, JsonString), get_field
	json_rpc:
		JsonRpcEnvelope,
		decode_lsp_json_rpc_body,
		integer_from_json,
		json_rpc_error_value,
		json_rpc_method,
		json_rpc_parameters,
		json_rpc_request_id,
		json_rpc_success_value,
	position: ProtocolPosition, ProtocolRange
	protocol:
		ProtocolError(InvalidMethodParameters, MissingRequestId, UnknownMethod),
		ProtocolFailure,
		ProtocolInputOutcome(ProtocolInputAccepted, ProtocolInputIgnored, ProtocolInputRejected),
		ProtocolResponse(ProtocolErrorResponse, ProtocolSuccessResponse),
		RequestId,


private HOVER_METHOD: String = "textDocument/hover"


record HoverRequest {
	id: RequestId,
	uri: DocumentUri,
	position: ProtocolPosition
}


pure func hover_method() -> String:
	HOVER_METHOD


private pure func hover_parameter_error(detail: String) -> ProtocolError:
	document_parameter_error(HOVER_METHOD, detail)


private pure func required_nonnegative_integer_field(
	value: JsonValue,
	name: String,
) -> Result[Int, ProtocolError]:
	match get_field(value, name):
		None:
			Err(hover_parameter_error("missing required `${name}` integer"))
		Some(field):
			match integer_from_json(field):
				None:
					Err(hover_parameter_error("`${name}` must be a signed 32-bit integer"))
				Some(integer):
					if integer < 0:
						Err(hover_parameter_error("`${name}` must be non-negative"))
					else:
						Ok(integer)


private pure func required_protocol_position(
	value: JsonValue,
) -> Result[ProtocolPosition, ProtocolError]:
	line ?= required_nonnegative_integer_field(value, "line")
	character ?= required_nonnegative_integer_field(value, "character")
	Ok({
		line = line,
		utf16_character = character,
	})


private pure func decode_hover_parameters(
	params: JsonValue,
) -> Result[(DocumentUri, ProtocolPosition), ProtocolError]:
	match params:
		JsonObject(_):
			text_document ?= required_object_field(params, "textDocument", HOVER_METHOD)
			uri ?= required_string_field(text_document, "uri", HOVER_METHOD)
			position_value ?= required_object_field(params, "position", HOVER_METHOD)
			query_position ?= required_protocol_position(position_value)
			Ok((document_uri(uri), query_position))
		_:
			Err(hover_parameter_error("params must be an object"))


pure func decode_lsp_hover_envelope(
	envelope: JsonRpcEnvelope,
) -> ProtocolInputOutcome[HoverRequest]:
	method = json_rpc_method(envelope)
	request_id = json_rpc_request_id(envelope)

	if method != HOVER_METHOD:
		match request_id:
			Some(_):
				ProtocolInputRejected({
					request_id = request_id,
					error = UnknownMethod(method),
				})
			None:
				ProtocolInputIgnored(UnknownMethod(method))
	else:
		match request_id:
			None:
				ProtocolInputIgnored(MissingRequestId(HOVER_METHOD))
			Some(id):
				match json_rpc_parameters(envelope):
					None:
						ProtocolInputRejected({
							request_id = Some(id),
							error = hover_parameter_error("missing required params object"),
						})
					Some(params):
						match decode_hover_parameters(params):
							Err(error):
								ProtocolInputRejected({
									request_id = Some(id),
									error = error,
								})
							Ok(query):
								ProtocolInputAccepted({
									id = id,
									uri = query[0],
									position = query[1],
								})


pure func decode_lsp_hover_request(body: String) -> ProtocolInputOutcome[HoverRequest]:
	match decode_lsp_json_rpc_body(body):
		Err(failure):
			ProtocolInputRejected(failure)
		Ok(envelope):
			decode_lsp_hover_envelope(envelope)


private pure func position_json(position: ProtocolPosition) -> JsonValue:
	JsonObject([
		("line", JsonNumber(to_float(position.line))),
		("character", JsonNumber(to_float(position.utf16_character))),
	])


private pure func range_json(range: ProtocolRange) -> JsonValue:
	JsonObject([
		("start", position_json(range.start)),
		("end", position_json(range.end)),
	])


private pure func hover_info_json(hover: HoverInfo) -> JsonValue:
	JsonObject([("contents", JsonObject([
			("kind", JsonString("plaintext")),
			("value", JsonString(hover.contents)),
		])), ("range", range_json(hover.range))])


pure func encode_lsp_hover_response(
	response: ProtocolResponse[Option[HoverInfo], ProtocolFailure],
) -> String:
	match response:
		ProtocolSuccessResponse(id, hover):
			result: JsonValue = match hover:
				Some(found):
					hover_info_json(found)
				None:
					JsonNull

			json_rpc_success_value(id, result).to_string()
		ProtocolErrorResponse(failure):
			json_rpc_error_value(failure).to_string()
