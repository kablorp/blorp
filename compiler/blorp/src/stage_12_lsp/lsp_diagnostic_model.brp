-- Dependency-light diagnostic values and the final stale-publication guard.
-- Compiler analysis constructs these values, while the serialized server state
-- alone decides whether a completed publication still describes current text.
import:
	lsp_document_model: lsp_document_version_value
	lsp_document_store: LspDocumentStore, lsp_document_store_find
	lsp_identity: LspDocumentUri
	lsp_position: LspRange
	lsp_snapshot_model: LspConfigurationEpoch, LspSnapshotIdentity, LspWorkspaceRevision


enum LspDiagnosticSeverity:
	LspErrorDiagnostic
	LspWarningDiagnostic
	LspInformationDiagnostic
	LspHintDiagnostic


record LspDiagnostic {
	range: LspRange,
	severity: LspDiagnosticSeverity,
	code: Option[String],
	message: String
}


record LspDiagnosticPublication {
	identity: LspSnapshotIdentity,
	diagnostics: List[LspDiagnostic]
}


record LspDiagnosticClearRequest {
	uri: LspDocumentUri
}


pure func lsp_diagnostic_publication_is_current(
	documents: LspDocumentStore,
	workspace_revision: LspWorkspaceRevision,
	configuration_epoch: LspConfigurationEpoch,
	publication: LspDiagnosticPublication,
) -> Bool:
	identity = publication.identity

	if (
		identity.workspace_revision != workspace_revision
		or identity.configuration_epoch != configuration_epoch
	):
		False
	else:
		match (identity.document_version, lsp_document_store_find(documents, identity.uri)):
			(Some(published_version), Some(opened)):
				lsp_document_version_value(
					published_version,
				) == lsp_document_version_value(opened.document.version)
			_:
				False


pure func lsp_diagnostic_clear_is_current(
	documents: LspDocumentStore,
	request: LspDiagnosticClearRequest,
) -> Bool:
	lsp_document_store_find(documents, request.uri).is_none()
