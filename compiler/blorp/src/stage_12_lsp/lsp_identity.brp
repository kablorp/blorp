-- Concrete LSP identity primitives shared by protocol and workspace slices.
--
-- URI representation is opaque so protocol code cannot accidentally compare or
-- combine it with method names, paths, or arbitrary strings. Conversion remains
-- explicit at JSON and filesystem boundaries.
opaque type LspDocumentUri = String


pure func lsp_document_uri(value: String) -> LspDocumentUri:
	into LspDocumentUri(value)


pure func lsp_document_uri_value(uri: LspDocumentUri) -> String:
	from LspDocumentUri(uri)
