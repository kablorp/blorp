-- Opaque persistent indexes used by immutable LSP workspace snapshots.
--
-- URI stores use the exact URI string as their canonical key. Module stores
-- use the compiler's lossless storage key. The stored identity is still checked
-- on lookup so a future key-format regression fails closed instead of aliasing
-- two modules.
import:
	../stage_04_modules/loaded_module:
		ModuleIdentity,
		module_identities_equal,
		module_identity_storage_key,
	identity: DocumentUri, document_uri_value


opaque type UriStore[V] = Dict[String, V]


private record ModuleStoreEntry[V] {
	identity: ModuleIdentity,
	value: V
}


opaque type ModuleStore[V] = Dict[String, ModuleStoreEntry[V]]


union IndexedStoreError:
	IndexedStoreDuplicateUri(DocumentUri)
	IndexedStoreDuplicateModule(ModuleIdentity)


private pure func uri_store_values_by_key[V](store: UriStore[V]) -> Dict[String, V]:
	from_opaque UriStore[V](store)


pure func uri_store[V]() -> UriStore[V]:
	empty: Dict[String, V] = {}
	into_opaque UriStore[V](empty)


pure func uri_store_from_entries[V](
	entries: List[(DocumentUri, V)],
) -> Result[UriStore[V], IndexedStoreError]:
	var store: UriStore[V] = uri_store()
	var duplicate: Option[DocumentUri] = None

	for entry in entries:
		if duplicate.is_none():
			uri = entry[0]

			if uri_store_contains(store, uri):
				duplicate = Some(uri)
			else:
				store = uri_store_set(store, uri, entry[1])

	match duplicate:
		Some(uri):
			Err(IndexedStoreDuplicateUri(uri))
		None:
			Ok(store)


pure func uri_store_get[V](store: UriStore[V], uri: DocumentUri) -> Option[V]:
	uri_store_values_by_key(store).get(document_uri_value(uri))


pure func uri_store_set[V](store: UriStore[V], uri: DocumentUri, value: V) -> UriStore[V]:
	into_opaque UriStore[V](uri_store_values_by_key(store).set(document_uri_value(uri), value))


pure func uri_store_remove[V](store: UriStore[V], uri: DocumentUri) -> UriStore[V]:
	into_opaque UriStore[V](uri_store_values_by_key(store).remove(document_uri_value(uri)))


pure func uri_store_contains[V](store: UriStore[V], uri: DocumentUri) -> Bool:
	uri_store_values_by_key(store).contains(document_uri_value(uri))


pure func uri_store_values[V](store: UriStore[V]) -> List[V]:
	uri_store_values_by_key(store).values()


pure func uri_store_length[V](store: UriStore[V]) -> Int:
	uri_store_values_by_key(store).length()


pure func uri_store_is_empty[V](store: UriStore[V]) -> Bool:
	uri_store_values_by_key(store).is_empty()


private pure func module_store_entries[V](
	store: ModuleStore[V],
) -> Dict[String, ModuleStoreEntry[V]]:
	from_opaque ModuleStore[V](store)


pure func module_store[V]() -> ModuleStore[V]:
	empty: Dict[String, ModuleStoreEntry[V]] = {}
	into_opaque ModuleStore[V](empty)


pure func module_store_from_entries[V](
	entries: List[(ModuleIdentity, V)],
) -> Result[ModuleStore[V], IndexedStoreError]:
	var store: ModuleStore[V] = module_store()
	var duplicate: Option[ModuleIdentity] = None

	for entry in entries:
		if duplicate.is_none():
			identity = entry[0]

			if module_store_contains(store, identity):
				duplicate = Some(identity)
			else:
				store = module_store_set(store, identity, entry[1])

	match duplicate:
		Some(identity):
			Err(IndexedStoreDuplicateModule(identity))
		None:
			Ok(store)


pure func module_store_get[V](store: ModuleStore[V], identity: ModuleIdentity) -> Option[V]:
	key = module_identity_storage_key(identity)
	entry ?= module_store_entries(store).get(key)

	if module_identities_equal(entry.identity, identity):
		Some(entry.value)
	else:
		None


pure func module_store_set[V](
	store: ModuleStore[V],
	identity: ModuleIdentity,
	value: V,
) -> ModuleStore[V]:
	key = module_identity_storage_key(identity)
	entries = module_store_entries(store)

	match entries.get(key):
		Some(existing):
			if not module_identities_equal(existing.identity, identity):
				store
			else:
				entry: ModuleStoreEntry[V] = {
					identity = identity,
					value = value
				}
				into_opaque ModuleStore[V](entries.set(key, entry))
		None:
			entry: ModuleStoreEntry[V] = {
				identity = identity,
				value = value
			}
			into_opaque ModuleStore[V](entries.set(key, entry))


pure func module_store_remove[V](store: ModuleStore[V], identity: ModuleIdentity) -> ModuleStore[V]:
	key = module_identity_storage_key(identity)
	entries = module_store_entries(store)

	match entries.get(key):
		Some(existing):
			if module_identities_equal(existing.identity, identity):
				into_opaque ModuleStore[V](entries.remove(key))
			else:
				store
		None:
			store


pure func module_store_contains[V](store: ModuleStore[V], identity: ModuleIdentity) -> Bool:
	module_store_get(store, identity).is_some()


pure func module_store_values[V](store: ModuleStore[V]) -> List[V]:
	module_store_entries(store)
		.values()
		.map(func(entry): entry.value)


pure func module_store_length[V](store: ModuleStore[V]) -> Int:
	module_store_entries(store).length()


pure func module_store_is_empty[V](store: ModuleStore[V]) -> Bool:
	module_store_entries(store).is_empty()
