-- Dependency-light protocol model shared by JSON-RPC, routing, and LSP methods.
--
-- Keeping these primitives outside the compiler-facing architecture prevents a
-- low-level wire decoder from importing lexer, parser, and typechecker models.
-- JSON-RPC permits integer and string request IDs. Keeping the alternatives in
-- the type prevents lossy string conversion and guarantees an exact echo.
union LspRequestId:
	LspIntegerRequestId(Int)
	LspStringRequestId(String)


union LspProtocolError:
	LspMalformedJson(String)
	LspInvalidProtocolEnvelope(String)
	LspUnsupportedProtocolVersion(String)
	LspUnknownMethod(String)
	LspMissingProtocolField(String)
	LspMissingRequestId(String)
	LspUnexpectedRequestId(String)
	LspInvalidLifecycle(String)
	LspServerNotInitialized(String)
	LspInternalError(String)
	LspInvalidRequestId
	LspInvalidMethodParameters(String, String)


-- A protocol failure retains a valid request ID when one was decoded before a
-- later envelope or method validation failed. That is necessary to emit the
-- matching JSON-RPC error without reparsing the request body.
record LspProtocolFailure {
	request_id: Option[LspRequestId],
	error: LspProtocolError
}


-- Notifications and requests have different response obligations. Encoding
-- that distinction here prevents callers from replying to notifications or
-- dropping required JSON-RPC error responses.
union LspProtocolInputOutcome[T]:
	LspProtocolInputAccepted(T)
	LspProtocolInputRejected(LspProtocolFailure)
	LspProtocolInputIgnored(LspProtocolError)


-- The error payload owns its request-ID invariant: protocol failures may lack a
-- decoded ID, while semantic request failures use a type with a required ID.
union LspProtocolResponse[T, E]:
	LspProtocolSuccessResponse(LspRequestId, T)
	LspProtocolErrorResponse(E)
