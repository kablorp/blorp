-- JSON encoding for server-initiated diagnostic notifications.
-- The transport layer frames the returned body but does not inspect or rebuild it.
import:
	json: JsonValue(JsonNumber, JsonObject, JsonString, JsonVector)
	lsp_diagnostic_model:
		LspDiagnostic,
		LspDiagnosticPublication,
		LspDiagnosticSeverity(
			LspErrorDiagnostic,
			LspHintDiagnostic,
			LspInformationDiagnostic,
			LspWarningDiagnostic,
		),
	lsp_document_model: lsp_document_version_value
	lsp_identity: LspDocumentUri, lsp_document_uri_value
	lsp_position: LspPosition, LspRange


private LSP_JSON_RPC_VERSION: String = "2.0"

private LSP_PUBLISH_DIAGNOSTICS_METHOD: String = "textDocument/publishDiagnostics"

private LSP_DIAGNOSTIC_SOURCE: String = "blorp"


private pure func diagnostic_severity_number(severity: LspDiagnosticSeverity) -> Float:
	match severity:
		LspErrorDiagnostic:
			1.0
		LspWarningDiagnostic:
			2.0
		LspInformationDiagnostic:
			3.0
		LspHintDiagnostic:
			4.0


private pure func position_value(position: LspPosition) -> JsonValue:
	JsonObject([
		("line", JsonNumber(to_float(position.line))),
		("character", JsonNumber(to_float(position.utf16_character))),
	])


private pure func range_value(range: LspRange) -> JsonValue:
	JsonObject([
		("start", position_value(range.start)),
		("end", position_value(range.end)),
	])


private pure func diagnostic_value(diagnostic: LspDiagnostic) -> JsonValue:
	base_fields: List[(String, JsonValue)] = [
		("range", range_value(diagnostic.range)),
		("severity", JsonNumber(diagnostic_severity_number(diagnostic.severity))),
		("source", JsonString(LSP_DIAGNOSTIC_SOURCE)),
		("message", JsonString(diagnostic.message)),
	]

	fields: List[(String, JsonValue)] = match diagnostic.code:
		Some(code):
			base_fields.append(("code", JsonString(code)))
		None:
			base_fields

	JsonObject(fields)


private pure func publish_diagnostics_body(
	uri: LspDocumentUri,
	version: Option[Int],
	diagnostics: List[LspDiagnostic],
) -> String:
	base_params: List[(String, JsonValue)] = [
		("uri", JsonString(lsp_document_uri_value(uri))),
		("diagnostics", JsonVector(diagnostics.map(diagnostic_value))),
	]

	params: List[(String, JsonValue)] = match version:
		Some(value):
			base_params.append(("version", JsonNumber(to_float(value))))
		None:
			base_params

	JsonObject([
		("jsonrpc", JsonString(LSP_JSON_RPC_VERSION)),
		("method", JsonString(LSP_PUBLISH_DIAGNOSTICS_METHOD)),
		("params", JsonObject(params)),
	]).to_string()


pure func encode_lsp_diagnostic_publication(
	publication: LspDiagnosticPublication,
	supports_versioned_diagnostics: Bool,
) -> String:
	version: Option[Int] = if supports_versioned_diagnostics:
		publication.identity.document_version.map(lsp_document_version_value)
	else:
		None

	publish_diagnostics_body(publication.identity.uri, version, publication.diagnostics)


pure func encode_lsp_clear_diagnostics(uri: LspDocumentUri) -> String:
	diagnostics: List[LspDiagnostic] = []
	publish_diagnostics_body(uri, None, diagnostics)
