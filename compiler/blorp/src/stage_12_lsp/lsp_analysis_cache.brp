-- Fingerprint-checked access to unversioned compiler artifacts.
--
-- The underlying persistent stores retain only the newest artifact for a URI
-- or module identity. A lookup must still present the complete phase-specific
-- fingerprint, so a stale entry can never be mistaken for a cache hit.
import:
	../stage_04_modules/loaded_module: CompilerModuleIdentity, compiler_module_identities_equal
	lsp_analysis_model:
		LspLexedArtifact,
		LspModuleAnalysisFingerprint,
		LspParseFingerprint,
		LspParsedArtifact,
		LspTypedArtifact,
		lsp_lexed_artifact_fingerprint,
		lsp_parsed_artifact_fingerprint,
		lsp_typed_artifact_fingerprint,
	lsp_indexed_store:
		LspModuleStore,
		LspUriStore,
		lsp_module_store,
		lsp_module_store_get,
		lsp_module_store_remove,
		lsp_module_store_set,
		lsp_uri_store,
		lsp_uri_store_get,
		lsp_uri_store_remove,
		lsp_uri_store_set,
	lsp_snapshot_model: lsp_configuration_epoch_value


private record LspAnalysisCacheRep {
	lexed: LspUriStore[LspLexedArtifact],
	parsed: LspUriStore[LspParsedArtifact],
	typed: LspModuleStore[LspTypedArtifact]
}


opaque type LspAnalysisCacheSnapshot = LspAnalysisCacheRep


private pure func analysis_cache_rep(cache: LspAnalysisCacheSnapshot) -> LspAnalysisCacheRep:
	from LspAnalysisCacheSnapshot(cache)


pure func lsp_analysis_cache() -> LspAnalysisCacheSnapshot:
	representation: LspAnalysisCacheRep = {
		lexed = lsp_uri_store(),
		parsed = lsp_uri_store(),
		typed = lsp_module_store()
	}
	into LspAnalysisCacheSnapshot(representation)


pure func lsp_parse_fingerprints_equal(
	left: LspParseFingerprint,
	right: LspParseFingerprint,
) -> Bool:
	(
		left.uri == right.uri
		and left.source.value == right.source.value
		and left.frontend.value == right.frontend.value
	)


pure func lsp_module_analysis_fingerprints_equal(
	left: LspModuleAnalysisFingerprint,
	right: LspModuleAnalysisFingerprint,
) -> Bool:
	(
		compiler_module_identities_equal(left.module_identity, right.module_identity)
		and left.source.value == right.source.value
		and lsp_configuration_epoch_value(
			left.configuration_epoch,
		) == lsp_configuration_epoch_value(right.configuration_epoch)
		and left.frontend.value == right.frontend.value
	)


pure func lsp_analysis_cache_lexed(
	cache: LspAnalysisCacheSnapshot,
	fingerprint: LspParseFingerprint,
) -> Option[LspLexedArtifact]:
	representation = analysis_cache_rep(cache)
	artifact ?= lsp_uri_store_get(representation.lexed, fingerprint.uri)

	if lsp_parse_fingerprints_equal(lsp_lexed_artifact_fingerprint(artifact), fingerprint):
		Some(artifact)
	else:
		None


pure func lsp_analysis_cache_parsed(
	cache: LspAnalysisCacheSnapshot,
	fingerprint: LspParseFingerprint,
) -> Option[LspParsedArtifact]:
	representation = analysis_cache_rep(cache)
	artifact ?= lsp_uri_store_get(representation.parsed, fingerprint.uri)

	if lsp_parse_fingerprints_equal(lsp_parsed_artifact_fingerprint(artifact), fingerprint):
		Some(artifact)
	else:
		None


pure func lsp_analysis_cache_typed(
	cache: LspAnalysisCacheSnapshot,
	fingerprint: LspModuleAnalysisFingerprint,
) -> Option[LspTypedArtifact]:
	representation = analysis_cache_rep(cache)
	artifact ?= lsp_module_store_get(representation.typed, fingerprint.module_identity)

	if lsp_module_analysis_fingerprints_equal(
		lsp_typed_artifact_fingerprint(artifact),
		fingerprint,
	):
		Some(artifact)
	else:
		None


pure func lsp_analysis_cache_store_lexed(
	cache: LspAnalysisCacheSnapshot,
	artifact: LspLexedArtifact,
) -> LspAnalysisCacheSnapshot:
	representation = analysis_cache_rep(cache)
	fingerprint = lsp_lexed_artifact_fingerprint(artifact)
	updated: LspAnalysisCacheRep = { representation |
		lexed = lsp_uri_store_set(representation.lexed, fingerprint.uri, artifact)
	}
	into LspAnalysisCacheSnapshot(updated)


pure func lsp_analysis_cache_store_parsed(
	cache: LspAnalysisCacheSnapshot,
	artifact: LspParsedArtifact,
) -> LspAnalysisCacheSnapshot:
	representation = analysis_cache_rep(cache)
	fingerprint = lsp_parsed_artifact_fingerprint(artifact)
	updated: LspAnalysisCacheRep = { representation |
		parsed = lsp_uri_store_set(representation.parsed, fingerprint.uri, artifact)
	}
	into LspAnalysisCacheSnapshot(updated)


pure func lsp_analysis_cache_store_typed(
	cache: LspAnalysisCacheSnapshot,
	artifact: LspTypedArtifact,
) -> LspAnalysisCacheSnapshot:
	representation = analysis_cache_rep(cache)
	fingerprint = lsp_typed_artifact_fingerprint(artifact)
	updated: LspAnalysisCacheRep = { representation |
		typed = lsp_module_store_set(representation.typed, fingerprint.module_identity, artifact)
	}
	into LspAnalysisCacheSnapshot(updated)


pure func lsp_analysis_cache_remove_lexed(
	cache: LspAnalysisCacheSnapshot,
	fingerprint: LspParseFingerprint,
) -> LspAnalysisCacheSnapshot:
	if lsp_analysis_cache_lexed(cache, fingerprint).is_none():
		cache
	else:
		representation = analysis_cache_rep(cache)
		updated: LspAnalysisCacheRep = { representation |
			lexed = lsp_uri_store_remove(representation.lexed, fingerprint.uri)
		}
		into LspAnalysisCacheSnapshot(updated)


pure func lsp_analysis_cache_remove_parsed(
	cache: LspAnalysisCacheSnapshot,
	fingerprint: LspParseFingerprint,
) -> LspAnalysisCacheSnapshot:
	if lsp_analysis_cache_parsed(cache, fingerprint).is_none():
		cache
	else:
		representation = analysis_cache_rep(cache)
		updated: LspAnalysisCacheRep = { representation |
			parsed = lsp_uri_store_remove(representation.parsed, fingerprint.uri)
		}
		into LspAnalysisCacheSnapshot(updated)


pure func lsp_analysis_cache_remove_typed(
	cache: LspAnalysisCacheSnapshot,
	fingerprint: LspModuleAnalysisFingerprint,
) -> LspAnalysisCacheSnapshot:
	if lsp_analysis_cache_typed(cache, fingerprint).is_none():
		cache
	else:
		representation = analysis_cache_rep(cache)
		updated: LspAnalysisCacheRep = { representation |
			typed = lsp_module_store_remove(representation.typed, fingerprint.module_identity)
		}
		into LspAnalysisCacheSnapshot(updated)


-- Invalidation knows which module became unusable, but its replacement
-- fingerprint is intentionally different from the stale cached artifact.
-- Removing by canonical module identity prevents a failed reanalysis from
-- leaving the previous successful artifact reachable.
pure func lsp_analysis_cache_remove_typed_for_module(
	cache: LspAnalysisCacheSnapshot,
	module_identity: CompilerModuleIdentity,
) -> LspAnalysisCacheSnapshot:
	representation = analysis_cache_rep(cache)
	updated: LspAnalysisCacheRep = { representation |
		typed = lsp_module_store_remove(representation.typed, module_identity)
	}
	into LspAnalysisCacheSnapshot(updated)
