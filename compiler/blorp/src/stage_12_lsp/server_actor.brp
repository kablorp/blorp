-- Pure ownership boundary for workspace transitions and compiler scheduling.
-- The reducer returns effects as data; filesystem, compiler, transport, and
-- process effects are interpreted by the native server loops in later slices.
import:
	analysis_planner: plan_analysis
	architecture:
		AnalysisCommit(AnalysisCommitted, CurrentAnalysisFailed, StaleAnalysisDropped),
		AnalysisCompletion,
		AnalysisPlan,
		AnalysisPlanningRequirement(AnalysisPlanRequired, NoAnalysisPlanRequired),
		AnalysisRequest,
		CancellationToken,
		ScheduledAnalysis,
		WorkspaceError(
			OutOfOrderDocumentVersion,
			WorkspaceDocumentAlreadyOpen,
			WorkspaceDocumentNotOpen,
		),
		cancellation_token,
		cancellation_token_value,
	definition: encode_lsp_definition_response
	definition_query:
		DefinitionQueryResult(DefinitionQueryLocations, DefinitionQueryUnavailable),
		definition_query_snapshot,
	document_highlight: encode_lsp_document_highlight_response
	document_highlight_query:
		DocumentHighlightQueryResult(
			DocumentHighlightQueryHighlights,
			DocumentHighlightQueryUnavailable,
		),
		document_highlights_query_snapshot,
	diagnostic_model: DiagnosticPublication
	document_dispatch:
		DocumentEnvelopeDispatch(
			DocumentEnvelopeAccepted,
			DocumentEnvelopeIgnored,
			DocumentEnvelopeRejected,
			DocumentEnvelopeUnhandled,
		),
		DocumentNotification(
			DecodedDocumentChange,
			DecodedDocumentClose,
			DecodedDocumentOpen,
			DecodedDocumentSave,
		),
		dispatch_lsp_document_envelope,
	document_model: OpenedDocument
	document_store: document_store_find
	document_symbol: encode_lsp_document_symbol_response
	document_symbol_query:
		DocumentSymbolQueryResult(DocumentSymbolQuerySymbols, DocumentSymbolQueryUnavailable),
		document_symbols_query_snapshot,
	exit_notification: exit_method
	hover: encode_lsp_hover_response
	hover_query: HoverQueryResult(HoverQueryInfo, HoverQueryUnavailable), hover_query_snapshot
	identity: DocumentUri
	indexed_store: UriStore, uri_store, uri_store_contains, uri_store_remove, uri_store_set
	initialize: encode_lsp_initialize_response, initialize_method, initialize_response
	initialize_model: InitializeTransition
	json_rpc: JsonRpcEnvelope, json_rpc_error_value, json_rpc_method, json_rpc_request_id
	lifecycle_dispatch:
		LifecycleAction(
			LifecycleContinue,
			LifecycleExit,
			LifecycleInitializeRequested,
			LifecycleRespond,
		),
		LifecycleDispatch(LifecycleHandled, LifecycleUnhandled),
		dispatch_lsp_lifecycle_envelope,
	lifecycle_model:
		LifecycleState,
		OperationalAdmission(OperationalAfterShutdown),
		ServerExitStatus,
		initial_lifecycle_state,
		lifecycle_accept_initialize,
		lifecycle_operational_admission,
		lifecycle_running_initialization,
	protocol:
		ProtocolError(InternalError, InvalidLifecycle, ServerBusy, ServerNotInitialized),
		ProtocolResponse(ProtocolSuccessResponse),
		RequestId,
	query_dispatch:
		SemanticQueryDispatch(
			SemanticQueryAccepted,
			SemanticQueryIgnored,
			SemanticQueryRejected,
			SemanticQueryUnhandled,
		),
		SemanticQueryRequest(
			DefinitionSemanticQuery,
			DocumentSymbolSemanticQuery,
			DocumentHighlightSemanticQuery,
			HoverSemanticQuery,
			ReferencesSemanticQuery,
		),
		SemanticQueryWork,
		dispatch_lsp_semantic_query,
		semantic_query_snapshot,
		semantic_query_snapshot_semantic_index,
		semantic_query_token,
		semantic_query_work,
		semantic_query_work_request,
		semantic_query_work_snapshot,
	references: encode_lsp_references_response
	references_query:
		ReferencesQueryResult(ReferencesQueryLocations, ReferencesQueryUnavailable),
		references_query_snapshot,
	server_event:
		DocumentEffectToken,
		DocumentSyncIssue(
			DocumentOpenResolutionIssue,
			DocumentWorkspaceIssue,
			SavedSourceRefreshIssue,
		),
		ServerEffect(
			AnalysisCompletionRejected,
			AnalysisPlanningFailed,
			CancelAnalysis,
			ClearDiagnostics,
			ExitServer,
			LoadWorkspace,
			OperationalEnvelopeReady,
			PublishDiagnostics,
			RefreshSavedSource,
			ReportDocumentSyncIssue,
			ReportSourceLoadIssues,
			ResolveOpenDocument,
			SendMessage,
			StartAnalysis,
		),
		ServerEvent(
			ServerAnalysisCompleted,
			ServerClientEnvelope,
			ServerDocumentOpenResolutionFailed,
			ServerDocumentOpenResolved,
			ServerSavedSourceRefreshFailed,
			ServerSavedSourceRemoved,
			ServerSavedSourceUpdated,
			ServerSourceLoadFailed,
			ServerSourceLoadSucceeded,
		),
		SourceLoadToken,
		document_effect_token,
		document_effect_token_value,
		source_load_token,
		source_load_token_value,
	snapshot_model: SnapshotIdentity
	source_loader:
		FatalSourceLoadError,
		SourceLoadEnvironment,
		SourceLoadIssue,
		fatal_source_load_error_description,
		source_load_request,
	workspace:
		Workspace,
		apply_analysis_completion,
		apply_workspace_event,
		empty_diagnostic_publications,
		workspace_document_store,
		workspace_snapshot,
	workspace_model:
		WorkspaceConfiguration,
		WorkspaceEvent(
			DiskSourceRemoved,
			DiskSourceUpdated,
			ResolvedDocumentOpened,
			WorkspaceDocumentChanged,
			WorkspaceDocumentClosed,
			WorkspaceDocumentSaved,
		),


private INITIAL_CANCELLATION_TOKEN_VALUE: Int = 0

private INITIAL_SOURCE_LOAD_TOKEN_VALUE: Int = 0

private INITIAL_DOCUMENT_EFFECT_TOKEN_VALUE: Int = 0

private INITIAL_SEMANTIC_QUERY_TOKEN_VALUE: Int = 0

private DOCUMENT_EFFECT_PENDING_DETAIL: String = "document synchronization is still pending"


-- Pending work exists only while another wave is active. Representing the
-- queue as a union keeps that scheduling invariant local and reviewable.
private union AnalysisSchedule:
	AnalysisIdle
	AnalysisActive(ScheduledAnalysis)
	AnalysisActiveWithReplacement(ScheduledAnalysis, AnalysisPlan)


private union PendingDocumentEffect:
	PendingOpenResolution(DocumentEffectToken, DocumentUri)
	PendingSaveRefresh(DocumentEffectToken, DocumentUri)


private record ReadyServerState {
	lifecycle: LifecycleState,
	workspace: Workspace,
	pending_document_effect: Option[PendingDocumentEffect],
	pending_document_notifications: List[DocumentNotification],
	rejected_open_sessions: UriStore[Bool],
	schedule: AnalysisSchedule,
	next_cancellation_token_value: Int,
	next_document_effect_token_value: Int,
	next_semantic_query_token_value: Int
}


private record ProtocolServerState {
	lifecycle: LifecycleState,
	source_load_environment: SourceLoadEnvironment,
	next_source_load_token_value: Int
}


private record LoadingServerState {
	lifecycle: LifecycleState,
	source_load_environment: SourceLoadEnvironment,
	initialization: InitializeTransition,
	source_load_token: SourceLoadToken,
	next_source_load_token_value: Int
}


private union NativeServerStateRep:
	NativeProtocolOnly(ProtocolServerState)
	NativeSourceLoading(LoadingServerState)
	NativeReady(ReadyServerState)
	NativeExited(ServerExitStatus)


opaque type NativeServerState = NativeServerStateRep


union ServerActorError:
	ServerWorkspaceError(WorkspaceError)
	ServerDocumentEffectPending


record ServerActorTransition {
	state: NativeServerState,
	effects: List[ServerEffect]
}


private pure func native_server_state(rep: NativeServerStateRep) -> NativeServerState:
	into NativeServerState(rep)


private pure func native_server_state_rep(state: NativeServerState) -> NativeServerStateRep:
	from NativeServerState(state)


pure func initial_server_state(source_load_environment: SourceLoadEnvironment) -> NativeServerState:
	native_server_state(NativeProtocolOnly({
		lifecycle = initial_lifecycle_state(),
		source_load_environment = source_load_environment,
		next_source_load_token_value = INITIAL_SOURCE_LOAD_TOKEN_VALUE,
	}))


pure func server_is_loading(state: NativeServerState) -> Bool:
	match native_server_state_rep(state):
		NativeSourceLoading(_):
			True
		_:
			False


pure func server_lifecycle(state: NativeServerState) -> Option[LifecycleState]:
	match native_server_state_rep(state):
		NativeProtocolOnly(protocol):
			Some(protocol.lifecycle)
		NativeSourceLoading(loading):
			Some(loading.lifecycle)
		NativeReady(ready):
			Some(ready.lifecycle)
		NativeExited(_):
			None


pure func server_active_analysis(state: NativeServerState) -> Option[ScheduledAnalysis]:
	match native_server_state_rep(state):
		NativeReady(ready):
			match ready.schedule:
				AnalysisIdle:
					None
				AnalysisActive(active):
					Some(active)
				AnalysisActiveWithReplacement(active, _):
					Some(active)
		_:
			None


pure func server_pending_analysis(state: NativeServerState) -> Option[AnalysisPlan]:
	match native_server_state_rep(state):
		NativeReady(ready):
			match ready.schedule:
				AnalysisActiveWithReplacement(_, pending):
					Some(pending)
				_:
					None
		_:
			None


pure func server_pending_document_notification_count(state: NativeServerState) -> Int:
	match native_server_state_rep(state):
		NativeReady(ready):
			ready.pending_document_notifications.length()
		_:
			0


pure func server_next_semantic_query_token_value(state: NativeServerState) -> Option[Int]:
	match native_server_state_rep(state):
		NativeReady(ready):
			Some(ready.next_semantic_query_token_value)
		_:
			None


pure func server_find_document(
	state: NativeServerState,
	uri: DocumentUri,
) -> Option[OpenedDocument]:
	match native_server_state_rep(state):
		NativeReady(ready):
			document_store_find(workspace_document_store(ready.workspace), uri)
		_:
			None


pure func server_workspace_configuration(
	state: NativeServerState,
) -> Option[WorkspaceConfiguration]:
	match native_server_state_rep(state):
		NativeReady(ready):
			Some(workspace_snapshot(ready.workspace).compiler.configuration)
		_:
			None


pure func server_supports_versioned_diagnostics(state: NativeServerState) -> Bool:
	match server_lifecycle(state):
		Some(lifecycle):
			match lifecycle_running_initialization(lifecycle):
				Some(initialization):
					initialization.request.parameters.supports_versioned_diagnostics
				None:
					False
		None:
			False


private pure func next_scheduled_analysis(
	ready: ReadyServerState,
	plan: AnalysisPlan,
) -> (ReadyServerState, ServerEffect):
	token: CancellationToken = cancellation_token(ready.next_cancellation_token_value)
	scheduled: ScheduledAnalysis = {
		token = token,
		plan = plan
	}
	request: AnalysisRequest = {
		plan = plan,
		cancellation_token = token
	}
	({ ready |
			schedule = AnalysisActive(scheduled),
			next_cancellation_token_value = ready.next_cancellation_token_value + 1
		}, StartAnalysis(request))


private pure func schedule_analysis(
	ready: ReadyServerState,
	plan: AnalysisPlan,
) -> (ReadyServerState, List[ServerEffect]):
	match ready.schedule:
		AnalysisIdle:
			started = next_scheduled_analysis(ready, plan)
			(started[0], [started[1]])
		AnalysisActive(active):
			(
				{ ready | schedule = AnalysisActiveWithReplacement(active, plan) },
				[CancelAnalysis(active.token)],
			)
		AnalysisActiveWithReplacement(active, _):
			-- A newer revision supersedes the unsent replacement atomically.
			({ ready | schedule = AnalysisActiveWithReplacement(active, plan) }, [])


private pure func retire_schedule_after_planning_failure(
	ready: ReadyServerState,
) -> (ReadyServerState, List[ServerEffect]):
	match active_analysis(ready.schedule):
		None:
			({ ready | schedule = AnalysisIdle }, [])
		Some(active):
			-- No older active or pending plan may run against the newer accepted
			-- workspace revision after planning that revision failed.
			({ ready | schedule = AnalysisIdle }, [CancelAnalysis(active.token)])


private pure func diagnostic_effects(
	diagnostics: List[DiagnosticPublication],
) -> List[ServerEffect]:
	diagnostics.map(func(diagnostic): PublishDiagnostics(diagnostic))


private pure func clear_effects(identities: List[SnapshotIdentity]) -> List[ServerEffect]:
	identities.map(func(identity): ClearDiagnostics(identity))


private pure func apply_workspace_change(
	ready: ReadyServerState,
	event: WorkspaceEvent,
) -> Result[ServerActorTransition, ServerActorError]:
	applied ?= apply_workspace_event(
		ready.workspace,
		event,
	).map_err(
		func(error): ServerWorkspaceError(error),
	)
	workspace = applied[0]
	transition = applied[1]
	clears = clear_effects(transition.diagnostics_to_clear)

	match transition.analysis_planning:
		NoAnalysisPlanRequired:
			Ok({
				state = native_server_state(NativeReady({ ready | workspace = workspace })),
				effects = clears,
			})
		AnalysisPlanRequired:
			match plan_analysis(transition):
				Err(error):
					-- The accepted workspace event remains authoritative even when
					-- an internal planning invariant prevents this analysis wave.
					retired = retire_schedule_after_planning_failure(
						{ ready | workspace = workspace },
					)
					Ok({
						state = native_server_state(NativeReady(retired[0])),
						effects = clears + diagnostic_effects(
							empty_diagnostic_publications(
								workspace,
							),
						) + retired[1] + [AnalysisPlanningFailed(error)],
					})
				Ok(plan):
					scheduled = schedule_analysis({ ready | workspace = workspace }, plan)
					Ok({
						state = native_server_state(NativeReady(scheduled[0])),
						effects = clears + scheduled[1],
					})


private pure func active_matches_completion(
	active: ScheduledAnalysis,
	completion: AnalysisCompletion,
) -> Bool:
	cancellation_token_value(active.token) == cancellation_token_value(completion.scheduled.token)


private pure func active_analysis(schedule: AnalysisSchedule) -> Option[ScheduledAnalysis]:
	match schedule:
		AnalysisIdle:
			None
		AnalysisActive(active):
			Some(active)
		AnalysisActiveWithReplacement(active, _):
			Some(active)


private pure func pending_analysis(schedule: AnalysisSchedule) -> Option[AnalysisPlan]:
	match schedule:
		AnalysisActiveWithReplacement(_, pending):
			Some(pending)
		_:
			None


private pure func start_replacement_after_completion(
	ready: ReadyServerState,
	pending: Option[AnalysisPlan],
) -> (ReadyServerState, List[ServerEffect]):
	match pending:
		None:
			({ ready | schedule = AnalysisIdle }, [])
		Some(plan):
			started = next_scheduled_analysis({ ready | schedule = AnalysisIdle }, plan)
			(started[0], [started[1]])


private pure func apply_completion_to_actor(
	ready: ReadyServerState,
	completion: AnalysisCompletion,
) -> Result[ServerActorTransition, ServerActorError]:
	active = active_analysis(ready.schedule)
	pending = pending_analysis(ready.schedule)

	match active:
		None:
			Ok({
				state = native_server_state(NativeReady(ready)),
				effects = [],
			})
		Some(scheduled):
			if not active_matches_completion(scheduled, completion):
				Ok({
					state = native_server_state(NativeReady(ready)),
					effects = [],
				})
			else:
				-- The token authenticates actor-owned scheduling state. The worker's
				-- copied plan is not trusted as the commit authority.
				authenticated: AnalysisCompletion = { completion | scheduled = scheduled }

				match apply_analysis_completion(ready.workspace, authenticated):
					Err(error):
						next = start_replacement_after_completion(ready, pending)
						Ok({
							state = native_server_state(NativeReady(next[0])),
							effects = diagnostic_effects(
								empty_diagnostic_publications(
									ready.workspace,
								),
							) + [AnalysisCompletionRejected(error)] + next[1],
						})
					Ok(committed):
						diagnostics: List[DiagnosticPublication] = match committed[1]:
							AnalysisCommitted(value):
								value.diagnostics
							CurrentAnalysisFailed(value):
								value.diagnostics
							StaleAnalysisDropped(_):
								[]

						next = start_replacement_after_completion(
							{ ready | workspace = committed[0] },
							pending,
						)
						Ok({
							state = native_server_state(NativeReady(next[0])),
							effects = diagnostic_effects(diagnostics) + next[1],
						})


private pure func actor_transition(
	state: NativeServerState,
	effects: List[ServerEffect],
) -> Result[ServerActorTransition, ServerActorError]:
	Ok({
		state = state,
		effects = effects,
	})


private pure func protocol_error_message(
	request_id: Option[RequestId],
	error: ProtocolError,
) -> String:
	json_rpc_error_value({
		request_id = request_id,
		error = error,
	}).to_string()


private pure func exit_transition(status: ServerExitStatus) -> ServerActorTransition:
	{
		state = native_server_state(NativeExited(status)),
		effects = [ExitServer(status)]
	}


private pure func apply_protocol_client_envelope(
	protocol: ProtocolServerState,
	envelope: JsonRpcEnvelope,
) -> Result[ServerActorTransition, ServerActorError]:
	match dispatch_lsp_lifecycle_envelope(protocol.lifecycle, envelope):
		LifecycleUnhandled(unhandled):
			actor_transition(
				native_server_state(NativeProtocolOnly(protocol)),
				[OperationalEnvelopeReady(unhandled)],
			)
		LifecycleHandled(transition):
			match transition.action:
				LifecycleInitializeRequested(initialization):
					token = source_load_token(protocol.next_source_load_token_value)
					request = source_load_request(
						protocol.source_load_environment,
						initialization.request.parameters,
					)
					actor_transition(native_server_state(NativeSourceLoading({
							lifecycle = transition.lifecycle,
							source_load_environment = protocol.source_load_environment,
							initialization = initialization,
							source_load_token = token,
							next_source_load_token_value = protocol.next_source_load_token_value + 1,
						})), [LoadWorkspace(token, request)])
				LifecycleRespond(body):
					actor_transition(
						native_server_state(
							NativeProtocolOnly({ protocol | lifecycle = transition.lifecycle }),
						),
						[SendMessage(body)],
					)
				LifecycleExit(status):
					Ok(exit_transition(status))
				LifecycleContinue:
					actor_transition(
						native_server_state(
							NativeProtocolOnly({ protocol | lifecycle = transition.lifecycle }),
						),
						[],
					)


private pure func apply_loading_client_envelope(
	loading: LoadingServerState,
	envelope: JsonRpcEnvelope,
) -> Result[ServerActorTransition, ServerActorError]:
	method = json_rpc_method(envelope)

	if method == exit_method():
		match dispatch_lsp_lifecycle_envelope(loading.lifecycle, envelope):
			LifecycleHandled(transition):
				match transition.action:
					LifecycleExit(status):
						Ok(exit_transition(status))
					_:
						actor_transition(native_server_state(NativeSourceLoading(loading)), [])
			LifecycleUnhandled(_):
				actor_transition(native_server_state(NativeSourceLoading(loading)), [])
	else:
		match json_rpc_request_id(envelope):
			None:
				actor_transition(native_server_state(NativeSourceLoading(loading)), [])
			Some(request_id):
				error = if method == initialize_method():
					InvalidLifecycle(method)
				else:
					ServerNotInitialized(method)

				actor_transition(
					native_server_state(NativeSourceLoading(loading)),
					[SendMessage(protocol_error_message(Some(request_id), error))],
				)


private pure func initialization_failure_transition(
	loading: LoadingServerState,
	detail: String,
) -> Result[ServerActorTransition, ServerActorError]:
	message = protocol_error_message(Some(loading.initialization.request.id), InternalError(detail))

	actor_transition(native_server_state(NativeProtocolOnly({
			lifecycle = loading.lifecycle,
			source_load_environment = loading.source_load_environment,
			next_source_load_token_value = loading.next_source_load_token_value,
		})), [SendMessage(message)])


private pure func source_load_failure_transition(
	loading: LoadingServerState,
	error: FatalSourceLoadError,
) -> Result[ServerActorTransition, ServerActorError]:
	initialization_failure_transition(
		loading,
		"initialize source loading failed: " + fatal_source_load_error_description(error),
	)


private pure func apply_source_load_success(
	loading: LoadingServerState,
	workspace: Workspace,
	issues: List[SourceLoadIssue],
) -> Result[ServerActorTransition, ServerActorError]:
	match lifecycle_accept_initialize(loading.lifecycle, loading.initialization):
		Err(_):
			initialization_failure_transition(
				loading,
				"initialize lifecycle changed before source loading completed",
			)
		Ok(next_lifecycle):
			response = encode_lsp_initialize_response(initialize_response(loading.initialization))

			issue_effects: List[ServerEffect] = if issues.is_empty():
				[]
			else:
				[ReportSourceLoadIssues(issues)]

			actor_transition(native_server_state(NativeReady({
					lifecycle = next_lifecycle,
					workspace = workspace,
					pending_document_effect = None,
					pending_document_notifications = [],
					rejected_open_sessions = uri_store(),
					schedule = AnalysisIdle,
					next_cancellation_token_value = INITIAL_CANCELLATION_TOKEN_VALUE,
					next_document_effect_token_value = INITIAL_DOCUMENT_EFFECT_TOKEN_VALUE,
					next_semantic_query_token_value = INITIAL_SEMANTIC_QUERY_TOKEN_VALUE,
				})), [SendMessage(response)] + issue_effects)


private pure func source_load_token_matches(
	loading: LoadingServerState,
	token: SourceLoadToken,
) -> Bool:
	source_load_token_value(loading.source_load_token) == source_load_token_value(token)


private pure func rejected_open_session(ready: ReadyServerState, uri: DocumentUri) -> Bool:
	uri_store_contains(ready.rejected_open_sessions, uri)


private pure func document_effect_tokens_equal(
	left: DocumentEffectToken,
	right: DocumentEffectToken,
) -> Bool:
	document_effect_token_value(left) == document_effect_token_value(right)


private pure func pending_open_matches(
	ready: ReadyServerState,
	token: DocumentEffectToken,
	uri: DocumentUri,
) -> Bool:
	match ready.pending_document_effect:
		Some(PendingOpenResolution(pending_token, pending_uri)):
			document_effect_tokens_equal(pending_token, token) and pending_uri == uri
		_:
			False


private pure func pending_save_matches(
	ready: ReadyServerState,
	token: DocumentEffectToken,
	uri: DocumentUri,
) -> Bool:
	match ready.pending_document_effect:
		Some(PendingSaveRefresh(pending_token, pending_uri)):
			document_effect_tokens_equal(pending_token, token) and pending_uri == uri
		_:
			False


private pure func without_rejected_open_session(
	ready: ReadyServerState,
	uri: DocumentUri,
) -> ReadyServerState:
	{ ready | rejected_open_sessions = uri_store_remove(ready.rejected_open_sessions, uri) }


private pure func expected_document_workspace_error(error: WorkspaceError) -> Bool:
	match error:
		WorkspaceDocumentAlreadyOpen(_):
			True
		WorkspaceDocumentNotOpen(_):
			True
		OutOfOrderDocumentVersion(_, _, _):
			True
		_:
			False


private pure func apply_document_workspace_event(
	ready: ReadyServerState,
	event: WorkspaceEvent,
) -> Result[ServerActorTransition, ServerActorError]:
	match apply_workspace_change(ready, event):
		Ok(transition):
			Ok(transition)
		Err(ServerWorkspaceError(error)):
			if expected_document_workspace_error(error):
				actor_transition(native_server_state(NativeReady(ready)), [])
			else:
				actor_transition(
					native_server_state(NativeReady(ready)),
					[ReportDocumentSyncIssue(DocumentWorkspaceIssue(error))],
				)


private pure func apply_document_notification(
	ready: ReadyServerState,
	notification: DocumentNotification,
) -> Result[ServerActorTransition, ServerActorError]:
	match notification:
		DecodedDocumentOpen(document):
			uri = document.document.uri
			already_open = document_store_find(
				workspace_document_store(ready.workspace),
				uri,
			).is_some()

			if rejected_open_session(ready, uri) or already_open:
				actor_transition(native_server_state(NativeReady(ready)), [])
			else:
				token = document_effect_token(ready.next_document_effect_token_value)
				updated = { ready |
					pending_document_effect = Some(PendingOpenResolution(token, uri)),
					next_document_effect_token_value = ready.next_document_effect_token_value + 1
				}
				actor_transition(
					native_server_state(NativeReady(updated)),
					[ResolveOpenDocument(token, document)],
				)
		DecodedDocumentChange(change):
			if rejected_open_session(ready, change.uri):
				actor_transition(native_server_state(NativeReady(ready)), [])
			else:
				apply_document_workspace_event(ready, WorkspaceDocumentChanged(change))
		DecodedDocumentSave(save):
			if (
				rejected_open_session(ready, save.uri)
				or document_store_find(
					workspace_document_store(ready.workspace),
					save.uri,
				).is_none()
			):
				actor_transition(native_server_state(NativeReady(ready)), [])
			else:
				match apply_document_workspace_event(ready, WorkspaceDocumentSaved(save)):
					Err(error):
						Err(error)
					Ok(transition):
						match native_server_state_rep(transition.state):
							NativeReady(updated_ready):
								token = document_effect_token(
									updated_ready.next_document_effect_token_value,
								)
								with_pending = { updated_ready |
									pending_document_effect = Some(
										PendingSaveRefresh(
											token,
											save.uri,
										),
									),
									next_document_effect_token_value = updated_ready.next_document_effect_token_value + 1
								}
								actor_transition(
									native_server_state(NativeReady(with_pending)),
									transition.effects + [RefreshSavedSource(token, save.uri)],
								)
							_:
								Err(ServerDocumentEffectPending)
		DecodedDocumentClose(uri):
			if rejected_open_session(ready, uri):
				actor_transition(
					native_server_state(NativeReady(without_rejected_open_session(ready, uri))),
					[],
				)
			else:
				apply_document_workspace_event(ready, WorkspaceDocumentClosed(uri))


private pure func queue_document_notification(
	ready: ReadyServerState,
	notification: DocumentNotification,
) -> Result[ServerActorTransition, ServerActorError]:
	queued = { ready |
		pending_document_notifications = ready.pending_document_notifications.append(notification)
	}
	actor_transition(native_server_state(NativeReady(queued)), [])


private pure func drain_pending_document_notifications(
	ready: ReadyServerState,
) -> Result[ServerActorTransition, ServerActorError]:
	match ready.pending_document_notifications:
		[]:
			actor_transition(native_server_state(NativeReady(ready)), [])
		[notification, ...remaining]:
			next_ready = { ready | pending_document_notifications = remaining }

			match apply_document_notification(next_ready, notification):
				Err(error):
					Err(error)
				Ok(transition):
					match native_server_state_rep(transition.state):
						NativeReady(updated):
							if updated.pending_document_effect.is_some():
								Ok(transition)
							else:
								match drain_pending_document_notifications(updated):
									Err(error):
										Err(error)
									Ok(drained):
										Ok(
											{ drained |
												effects = transition.effects + drained.effects
											},
										)
						_:
							Err(ServerDocumentEffectPending)


private pure func drain_after_document_transition(
	transition: ServerActorTransition,
) -> Result[ServerActorTransition, ServerActorError]:
	match native_server_state_rep(transition.state):
		NativeReady(ready):
			if ready.pending_document_notifications.is_empty():
				Ok(transition)
			else:
				match drain_pending_document_notifications(ready):
					Err(error):
						Err(error)
					Ok(drained):
						Ok({ drained | effects = transition.effects + drained.effects })
		_:
			Err(ServerDocumentEffectPending)


private pure func next_semantic_query_work(
	ready: ReadyServerState,
	query: SemanticQueryRequest,
) -> (ReadyServerState, SemanticQueryWork):
	-- The token is allocated by the actor even while execution is synchronous;
	-- a future worker completion can therefore prove which query it belongs to.
	snapshot = workspace_snapshot(ready.workspace)
	work = semantic_query_work(
		semantic_query_token(ready.next_semantic_query_token_value),
		query,
		semantic_query_snapshot(snapshot.semantic_index, snapshot.compiler.configuration_epoch),
	)
	({ ready | next_semantic_query_token_value = ready.next_semantic_query_token_value + 1 }, work)


private pure func apply_ready_semantic_query(
	ready: ReadyServerState,
	query: SemanticQueryRequest,
) -> Result[ServerActorTransition, ServerActorError]:
	owned = next_semantic_query_work(ready, query)
	owned_ready = owned[0]
	work = owned[1]
	semantic_index = semantic_query_snapshot_semantic_index(semantic_query_work_snapshot(work))

	match semantic_query_work_request(work):
		DefinitionSemanticQuery(request):
			locations = match definition_query_snapshot(
				semantic_index,
				request.uri,
				request.position,
			):
				DefinitionQueryLocations(found):
					Some(found)
				DefinitionQueryUnavailable:
					None

			actor_transition(
				native_server_state(NativeReady(owned_ready)),
				[
					SendMessage(
						encode_lsp_definition_response(
							ProtocolSuccessResponse(
								request.id,
								locations,
							),
						),
					),
				],
			)
		DocumentSymbolSemanticQuery(request):
			symbols = match document_symbols_query_snapshot(semantic_index, request.uri):
				DocumentSymbolQuerySymbols(found):
					Some(found)
				DocumentSymbolQueryUnavailable:
					None

			actor_transition(
				native_server_state(NativeReady(owned_ready)),
				[
					SendMessage(
						encode_lsp_document_symbol_response(
							ProtocolSuccessResponse(
								request.id,
								symbols,
							),
						),
					),
				],
			)
		DocumentHighlightSemanticQuery(request):
			highlights = match document_highlights_query_snapshot(
				semantic_index,
				request.uri,
				request.position,
			):
				DocumentHighlightQueryHighlights(found):
					Some(found)
				DocumentHighlightQueryUnavailable:
					None

			actor_transition(
				native_server_state(NativeReady(owned_ready)),
				[
					SendMessage(
						encode_lsp_document_highlight_response(
							ProtocolSuccessResponse(request.id, highlights),
						),
					),
				],
			)
		HoverSemanticQuery(request):
			hover = match hover_query_snapshot(semantic_index, request.uri, request.position):
				HoverQueryInfo(found):
					Some(found)
				HoverQueryUnavailable:
					None

			actor_transition(
				native_server_state(NativeReady(owned_ready)),
				[
					SendMessage(
						encode_lsp_hover_response(ProtocolSuccessResponse(request.id, hover)),
					),
				],
			)
		ReferencesSemanticQuery(request):
			locations = match references_query_snapshot(
				semantic_index,
				request.uri,
				request.position,
				request.include_declaration,
			):
				ReferencesQueryLocations(found):
					Some(found)
				ReferencesQueryUnavailable:
					None

			actor_transition(
				native_server_state(NativeReady(owned_ready)),
				[
					SendMessage(
						encode_lsp_references_response(
							ProtocolSuccessResponse(
								request.id,
								locations,
							),
						),
					),
				],
			)


private pure func apply_ready_operational_envelope(
	ready: ReadyServerState,
	envelope: JsonRpcEnvelope,
) -> Result[ServerActorTransition, ServerActorError]:
	match dispatch_lsp_semantic_query(envelope):
		SemanticQueryAccepted(query):
			apply_ready_semantic_query(ready, query)
		SemanticQueryRejected(failure):
			actor_transition(
				native_server_state(NativeReady(ready)),
				[SendMessage(json_rpc_error_value(failure).to_string())],
			)
		SemanticQueryIgnored(_):
			actor_transition(native_server_state(NativeReady(ready)), [])
		SemanticQueryUnhandled(unhandled):
			apply_ready_non_query_operational_envelope(ready, unhandled)


private pure func apply_ready_non_query_operational_envelope(
	ready: ReadyServerState,
	envelope: JsonRpcEnvelope,
) -> Result[ServerActorTransition, ServerActorError]:
	match dispatch_lsp_document_envelope(envelope):
		DocumentEnvelopeAccepted(notification):
			apply_document_notification(ready, notification)
		DocumentEnvelopeIgnored(_):
			actor_transition(native_server_state(NativeReady(ready)), [])
		DocumentEnvelopeRejected(failure):
			actor_transition(
				native_server_state(NativeReady(ready)),
				[SendMessage(json_rpc_error_value(failure).to_string())],
			)
		DocumentEnvelopeUnhandled(unhandled):
			actor_transition(
				native_server_state(NativeReady(ready)),
				[OperationalEnvelopeReady(unhandled)],
			)


private pure func retire_analysis_for_shutdown(
	ready: ReadyServerState,
) -> (ReadyServerState, List[ServerEffect]):
	without_document_work = { ready |
		pending_document_effect = None,
		pending_document_notifications = []
	}

	match active_analysis(ready.schedule):
		None:
			({ without_document_work | schedule = AnalysisIdle }, [])
		Some(active):
			({ without_document_work | schedule = AnalysisIdle }, [CancelAnalysis(active.token)])


private pure func apply_ready_client_envelope(
	ready: ReadyServerState,
	envelope: JsonRpcEnvelope,
) -> Result[ServerActorTransition, ServerActorError]:
	match dispatch_lsp_lifecycle_envelope(ready.lifecycle, envelope):
		LifecycleUnhandled(unhandled):
			if ready.pending_document_effect.is_some():
				match dispatch_lsp_document_envelope(unhandled):
					DocumentEnvelopeAccepted(notification):
						queue_document_notification(ready, notification)
					DocumentEnvelopeRejected(failure):
						actor_transition(
							native_server_state(NativeReady(ready)),
							[SendMessage(json_rpc_error_value(failure).to_string())],
						)
					DocumentEnvelopeIgnored(_):
						actor_transition(native_server_state(NativeReady(ready)), [])
					DocumentEnvelopeUnhandled(_):
						match json_rpc_request_id(unhandled):
							Some(request_id):
								actor_transition(
									native_server_state(NativeReady(ready)),
									[SendMessage(json_rpc_error_value({
											request_id = Some(request_id),
											error = ServerBusy(DOCUMENT_EFFECT_PENDING_DETAIL),
										}).to_string())],
								)
							None:
								actor_transition(native_server_state(NativeReady(ready)), [])
			else:
				apply_ready_operational_envelope(ready, unhandled)
		LifecycleHandled(transition):
			updated = { ready | lifecycle = transition.lifecycle }

			match transition.action:
				LifecycleRespond(body):
					match lifecycle_operational_admission(updated.lifecycle):
						OperationalAfterShutdown:
							retired = retire_analysis_for_shutdown(updated)
							actor_transition(
								native_server_state(NativeReady(retired[0])),
								[SendMessage(body)] + retired[1],
							)
						_:
							actor_transition(
								native_server_state(NativeReady(updated)),
								[SendMessage(body)],
							)
				LifecycleExit(status):
					Ok(exit_transition(status))
				LifecycleContinue:
					actor_transition(native_server_state(NativeReady(updated)), [])
				LifecycleInitializeRequested(_):
					actor_transition(
						native_server_state(NativeReady(updated)),
						[
							SendMessage(
								protocol_error_message(
									json_rpc_request_id(envelope),
									InvalidLifecycle(initialize_method()),
								),
							),
						],
					)


pure func apply_server_event(
	state: NativeServerState,
	event: ServerEvent,
) -> Result[ServerActorTransition, ServerActorError]:
	match native_server_state_rep(state):
		NativeProtocolOnly(protocol):
			match event:
				ServerClientEnvelope(envelope):
					apply_protocol_client_envelope(protocol, envelope)
				_:
					actor_transition(state, [])
		NativeSourceLoading(loading):
			match event:
				ServerClientEnvelope(envelope):
					apply_loading_client_envelope(loading, envelope)
				ServerSourceLoadSucceeded(token, workspace, issues):
					if source_load_token_matches(loading, token):
						apply_source_load_success(loading, workspace, issues)
					else:
						actor_transition(state, [])
				ServerSourceLoadFailed(token, error):
					if source_load_token_matches(loading, token):
						source_load_failure_transition(loading, error)
					else:
						actor_transition(state, [])
				_:
					actor_transition(state, [])
		NativeReady(ready):
			match event:
				ServerClientEnvelope(envelope):
					apply_ready_client_envelope(ready, envelope)
				ServerDocumentOpenResolved(token, resolved):
					uri = resolved.document.document.uri

					if (
						lifecycle_running_initialization(ready.lifecycle).is_none()
						or not pending_open_matches(ready, token, uri)
					):
						actor_transition(state, [])
					else:
						match apply_document_workspace_event(
							{ ready | pending_document_effect = None },
							ResolvedDocumentOpened(resolved),
						):
							Err(error):
								Err(error)
							Ok(transition):
								drain_after_document_transition(transition)
				ServerDocumentOpenResolutionFailed(token, uri, error):
					if (
						lifecycle_running_initialization(ready.lifecycle).is_none()
						or not pending_open_matches(ready, token, uri)
					):
						actor_transition(state, [])
					else:
						updated = { ready |
							pending_document_effect = None,
							rejected_open_sessions = uri_store_set(
								ready.rejected_open_sessions,
								uri,
								True,
							)
						}

						match actor_transition(
							native_server_state(NativeReady(updated)),
							[ReportDocumentSyncIssue(DocumentOpenResolutionIssue(uri, error))],
						):
							Err(actor_error):
								Err(actor_error)
							Ok(transition):
								drain_after_document_transition(transition)
				ServerSavedSourceUpdated(token, discovered):
					if (
						lifecycle_running_initialization(ready.lifecycle).is_some()
						and pending_save_matches(ready, token, discovered.uri)
					):
						match apply_workspace_change(
							{ ready | pending_document_effect = None },
							DiskSourceUpdated(discovered),
						):
							Err(error):
								Err(error)
							Ok(transition):
								drain_after_document_transition(transition)
					else:
						actor_transition(state, [])
				ServerSavedSourceRemoved(token, uri):
					if (
						lifecycle_running_initialization(ready.lifecycle).is_some()
						and pending_save_matches(ready, token, uri)
					):
						match apply_workspace_change(
							{ ready | pending_document_effect = None },
							DiskSourceRemoved(uri),
						):
							Err(error):
								Err(error)
							Ok(transition):
								drain_after_document_transition(transition)
					else:
						actor_transition(state, [])
				ServerSavedSourceRefreshFailed(token, uri, error):
					if (
						lifecycle_running_initialization(ready.lifecycle).is_some()
						and pending_save_matches(ready, token, uri)
					):
						match actor_transition(
							native_server_state(
								NativeReady({ ready | pending_document_effect = None }),
							),
							[ReportDocumentSyncIssue(SavedSourceRefreshIssue(uri, error))],
						):
							Err(actor_error):
								Err(actor_error)
							Ok(transition):
								drain_after_document_transition(transition)
					else:
						actor_transition(state, [])
				ServerSourceLoadSucceeded(_, _, _):
					actor_transition(state, [])
				ServerSourceLoadFailed(_, _):
					actor_transition(state, [])
				ServerAnalysisCompleted(completion):
					if lifecycle_running_initialization(ready.lifecycle).is_some():
						apply_completion_to_actor(ready, completion)
					else:
						actor_transition(state, [])
		NativeExited(_):
			actor_transition(state, [])
