-- Typed document-symbol values shared by the semantic query and JSON codec.
--
-- These values retain protocol ranges and compiler-owned names without making
-- the wire codec responsible for semantic identity or source reconstruction.
import:
	../stage_12_lsp/position: ProtocolRange


enum DocumentSymbolKind:
	DocumentSymbolMethod
	DocumentSymbolField
	DocumentSymbolConstructor
	DocumentSymbolClass
	DocumentSymbolInterface
	DocumentSymbolFunction
	DocumentSymbolVariable


record DocumentSymbol {
	name: String,
	kind: DocumentSymbolKind,
	range: ProtocolRange,
	selection_range: ProtocolRange
}


-- Values are assigned by the LSP protocol. Keep the mapping named here so
-- callers cannot accidentally use a nearby integer for a different kind.
private DOCUMENT_SYMBOL_KIND_METHOD: Int = 6

private DOCUMENT_SYMBOL_KIND_FIELD: Int = 8

private DOCUMENT_SYMBOL_KIND_CONSTRUCTOR: Int = 9

private DOCUMENT_SYMBOL_KIND_CLASS: Int = 5

private DOCUMENT_SYMBOL_KIND_INTERFACE: Int = 11

private DOCUMENT_SYMBOL_KIND_FUNCTION: Int = 12

private DOCUMENT_SYMBOL_KIND_VARIABLE: Int = 13


pure func document_symbol_kind_value(kind: DocumentSymbolKind) -> Int:
	match kind:
		DocumentSymbolMethod:
			DOCUMENT_SYMBOL_KIND_METHOD
		DocumentSymbolField:
			DOCUMENT_SYMBOL_KIND_FIELD
		DocumentSymbolConstructor:
			DOCUMENT_SYMBOL_KIND_CONSTRUCTOR
		DocumentSymbolClass:
			DOCUMENT_SYMBOL_KIND_CLASS
		DocumentSymbolInterface:
			DOCUMENT_SYMBOL_KIND_INTERFACE
		DocumentSymbolFunction:
			DOCUMENT_SYMBOL_KIND_FUNCTION
		DocumentSymbolVariable:
			DOCUMENT_SYMBOL_KIND_VARIABLE
