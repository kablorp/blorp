-- JSON encoding for server-initiated diagnostic notifications.
-- The transport layer frames the returned body but does not inspect or rebuild it.
import:
	diagnostic_model:
		Diagnostic,
		DiagnosticPublication,
		DiagnosticSeverity(
			ErrorDiagnostic,
			HintDiagnostic,
			InformationDiagnostic,
			WarningDiagnostic,
		),
	document_model: document_version_value
	identity: DocumentUri, document_uri_value
	json: JsonValue(JsonNumber, JsonObject, JsonString, JsonVector)
	position: ProtocolPosition, ProtocolRange


private JSON_RPC_VERSION: String = "2.0"

private PUBLISH_DIAGNOSTICS_METHOD: String = "textDocument/publishDiagnostics"

private DIAGNOSTIC_SOURCE: String = "blorp"


private pure func diagnostic_severity_number(severity: DiagnosticSeverity) -> Float:
	match severity:
		ErrorDiagnostic:
			1.0
		WarningDiagnostic:
			2.0
		InformationDiagnostic:
			3.0
		HintDiagnostic:
			4.0


private pure func position_value(position: ProtocolPosition) -> JsonValue:
	JsonObject([
		("line", JsonNumber(to_float(position.line))),
		("character", JsonNumber(to_float(position.utf16_character))),
	])


private pure func range_value(range: ProtocolRange) -> JsonValue:
	JsonObject([
		("start", position_value(range.start)),
		("end", position_value(range.end)),
	])


private pure func diagnostic_value(diagnostic: Diagnostic) -> JsonValue:
	base_fields: List[(String, JsonValue)] = [
		("range", range_value(diagnostic.range)),
		("severity", JsonNumber(diagnostic_severity_number(diagnostic.severity))),
		("source", JsonString(DIAGNOSTIC_SOURCE)),
		("message", JsonString(diagnostic.message)),
	]

	fields: List[(String, JsonValue)] = match diagnostic.code:
		Some(code):
			base_fields.append(("code", JsonString(code)))
		None:
			base_fields

	JsonObject(fields)


private pure func publish_diagnostics_body(
	uri: DocumentUri,
	version: Option[Int],
	diagnostics: List[Diagnostic],
) -> String:
	base_params: List[(String, JsonValue)] = [
		("uri", JsonString(document_uri_value(uri))),
		("diagnostics", JsonVector(diagnostics.map(diagnostic_value))),
	]

	params: List[(String, JsonValue)] = match version:
		Some(value):
			base_params.append(("version", JsonNumber(to_float(value))))
		None:
			base_params

	JsonObject([
		("jsonrpc", JsonString(JSON_RPC_VERSION)),
		("method", JsonString(PUBLISH_DIAGNOSTICS_METHOD)),
		("params", JsonObject(params)),
	]).to_string()


pure func encode_lsp_diagnostic_publication(
	publication: DiagnosticPublication,
	supports_versioned_diagnostics: Bool,
) -> String:
	version: Option[Int] = if supports_versioned_diagnostics:
		publication.identity.document_version.map(document_version_value)
	else:
		None

	publish_diagnostics_body(publication.identity.uri, version, publication.diagnostics)


pure func encode_lsp_clear_diagnostics(uri: DocumentUri) -> String:
	diagnostics: List[Diagnostic] = []
	publish_diagnostics_body(uri, None, diagnostics)
