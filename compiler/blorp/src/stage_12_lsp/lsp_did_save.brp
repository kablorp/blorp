-- Decoder and immutable overlay transition for textDocument/didSave.
--
-- A save has no document version. Optional included text remains metadata for
-- later disk-layer or diagnostics processing and never replaces editor text;
-- only didChange can advance the authoritative versioned overlay.
import:
	json: JsonValue(JsonObject), as_string, get_field
	lsp_document_model: LspDocumentSave
	lsp_document_store: LspDocumentStore, LspDocumentStoreError, lsp_document_store_save
	lsp_document_sync_codec:
		lsp_document_parameter_error,
		lsp_required_object_field,
		lsp_required_string_field,
	lsp_identity: lsp_document_uri
	lsp_json_rpc:
		LspJsonRpcEnvelope,
		decode_lsp_json_rpc_body,
		lsp_json_rpc_method,
		lsp_json_rpc_parameters,
		lsp_json_rpc_request_id,
	lsp_protocol:
		LspProtocolError(LspUnexpectedRequestId, LspUnknownMethod),
		LspProtocolInputOutcome(
			LspProtocolInputAccepted,
			LspProtocolInputIgnored,
			LspProtocolInputRejected,
		),


private LSP_DID_SAVE_METHOD: String = "textDocument/didSave"


pure func lsp_did_save_method() -> String:
	LSP_DID_SAVE_METHOD


private pure func did_save_parameter_error(detail: String) -> LspProtocolError:
	lsp_document_parameter_error(LSP_DID_SAVE_METHOD, detail)


private pure func decode_optional_save_text(
	params: JsonValue,
) -> Result[Option[String], LspProtocolError]:
	match get_field(params, "text"):
		None:
			Ok(None)
		Some(value):
			match as_string(value):
				Some(text):
					Ok(Some(text))
				None:
					Err(did_save_parameter_error("`text` must be a string when present"))


private pure func decode_did_save_parameters(
	params: JsonValue,
) -> Result[LspDocumentSave, LspProtocolError]:
	match params:
		JsonObject(_):
			text_document ?= lsp_required_object_field(params, "textDocument", LSP_DID_SAVE_METHOD)
			uri ?= lsp_required_string_field(text_document, "uri", LSP_DID_SAVE_METHOD)
			text ?= decode_optional_save_text(params)

			Ok({
				uri = lsp_document_uri(uri),
				text = text,
			})
		_:
			Err(did_save_parameter_error("params must be an object"))


pure func decode_lsp_did_save_envelope(
	envelope: LspJsonRpcEnvelope,
) -> LspProtocolInputOutcome[LspDocumentSave]:
	method = lsp_json_rpc_method(envelope)
	request_id = lsp_json_rpc_request_id(envelope)

	if method != LSP_DID_SAVE_METHOD:
		match request_id:
			Some(_):
				LspProtocolInputRejected({
					request_id = request_id,
					error = LspUnknownMethod(method),
				})
			None:
				LspProtocolInputIgnored(LspUnknownMethod(method))
	else:
		match request_id:
			Some(_):
				LspProtocolInputRejected({
					request_id = request_id,
					error = LspUnexpectedRequestId(method),
				})
			None:
				match lsp_json_rpc_parameters(envelope):
					None:
						LspProtocolInputIgnored(
							did_save_parameter_error("missing required params object"),
						)
					Some(params):
						match decode_did_save_parameters(params):
							Ok(saved):
								LspProtocolInputAccepted(saved)
							Err(error):
								LspProtocolInputIgnored(error)


pure func decode_lsp_did_save_notification(
	body: String,
) -> LspProtocolInputOutcome[LspDocumentSave]:
	match decode_lsp_json_rpc_body(body):
		Err(failure):
			LspProtocolInputRejected(failure)
		Ok(envelope):
			decode_lsp_did_save_envelope(envelope)


pure func handle_lsp_did_save_notification(
	store: LspDocumentStore,
	saved: LspDocumentSave,
) -> Result[LspDocumentStore, LspDocumentStoreError]:
	lsp_document_store_save(store, saved)
