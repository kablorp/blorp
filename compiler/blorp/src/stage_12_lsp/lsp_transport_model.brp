-- Dependency-light errors for the stdio LSP transport.
--
-- Framing must not parse JSON or call compiler code, which keeps partial reads
-- and broken frames isolated from protocol routing and workspace state. The
-- effectful transport interface belongs with the R10C process implementation;
-- defining it before the reader loop exists would hide the required ordering of
-- completed bodies before a later terminal framing error.
union LspTransportError:
	LspInvalidFrameHeader(String)
	LspFrameHeaderTooLarge(Int, Int)
	LspFrameBodyTooLarge(Int)
	LspInvalidFrameBodyUtf8
	LspIncompleteFrameHeader
	LspIncompleteFrameBody
	LspTransportReadFailed(String)
	LspTransportWriteFailed(String)
