-- Dependency-light framing boundary for the stdio LSP transport.
--
-- Framing owns Content-Length and stream IO only. It must not parse JSON or
-- call compiler code, which keeps partial reads and broken frames isolated from
-- protocol routing and workspace state.
union LspTransportError:
	LspInvalidFrameHeader(String)
	LspIncompleteFrameBody
	LspTransportReadFailed(String)
	LspTransportWriteFailed(String)


trait LspFrameTransport:
	func lsp_read_frame(transport: Self) -> Result[Option[String], LspTransportError]
	func lsp_write_frame(transport: Self, body: String) -> Result[Void, LspTransportError]
