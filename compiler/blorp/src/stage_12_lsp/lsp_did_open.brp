-- Decoder for the textDocument/didOpen notification.
--
-- While a document is open, the client-provided text is authoritative. This
-- module preserves that text verbatim and performs no filesystem reads or
-- compiler analysis.
import:
	json: JsonValue(JsonObject)
	lsp_document_model: LspOpenedDocument
	lsp_document_store: LspDocumentStore, LspDocumentStoreError, lsp_document_store_open
	lsp_document_sync_codec:
		lsp_document_parameter_error,
		lsp_required_document_version,
		lsp_required_object_field,
		lsp_required_string_field,
	lsp_identity: lsp_document_uri
	lsp_json_rpc:
		LspJsonRpcEnvelope,
		decode_lsp_json_rpc_body,
		lsp_json_rpc_method,
		lsp_json_rpc_parameters,
		lsp_json_rpc_request_id,
	lsp_protocol:
		LspProtocolError(LspInvalidMethodParameters, LspUnexpectedRequestId, LspUnknownMethod),
		LspProtocolInputOutcome(
			LspProtocolInputAccepted,
			LspProtocolInputIgnored,
			LspProtocolInputRejected,
		),


private LSP_DID_OPEN_METHOD: String = "textDocument/didOpen"


pure func lsp_did_open_method() -> String:
	LSP_DID_OPEN_METHOD


private pure func did_open_parameter_error(detail: String) -> LspProtocolError:
	lsp_document_parameter_error(LSP_DID_OPEN_METHOD, detail)


private pure func decode_did_open_parameters(
	params: JsonValue,
) -> Result[LspOpenedDocument, LspProtocolError]:
	match params:
		JsonObject(_):
			text_document ?= lsp_required_object_field(params, "textDocument", LSP_DID_OPEN_METHOD)
			uri ?= lsp_required_string_field(text_document, "uri", LSP_DID_OPEN_METHOD)
			language_id ?= lsp_required_string_field(
				text_document,
				"languageId",
				LSP_DID_OPEN_METHOD,
			)
			version ?= lsp_required_document_version(text_document, LSP_DID_OPEN_METHOD)
			text ?= lsp_required_string_field(text_document, "text", LSP_DID_OPEN_METHOD)

			opened: LspOpenedDocument = {
				document = {
					uri = lsp_document_uri(uri),
					version = version,
					text = text
				},
				language_id = language_id
			}

			Ok(opened)
		_:
			Err(did_open_parameter_error("params must be an object"))


pure func decode_lsp_did_open_envelope(
	envelope: LspJsonRpcEnvelope,
) -> LspProtocolInputOutcome[LspOpenedDocument]:
	method = lsp_json_rpc_method(envelope)
	request_id = lsp_json_rpc_request_id(envelope)

	if method != LSP_DID_OPEN_METHOD:
		match request_id:
			Some(_):
				LspProtocolInputRejected({
					request_id = request_id,
					error = LspUnknownMethod(method),
				})
			None:
				LspProtocolInputIgnored(LspUnknownMethod(method))
	else:
		match request_id:
			Some(_):
				LspProtocolInputRejected({
					request_id = request_id,
					error = LspUnexpectedRequestId(method),
				})
			None:
				match lsp_json_rpc_parameters(envelope):
					None:
						LspProtocolInputIgnored(
							did_open_parameter_error("missing required params object"),
						)
					Some(params):
						match decode_did_open_parameters(params):
							Ok(opened):
								LspProtocolInputAccepted(opened)
							Err(error):
								LspProtocolInputIgnored(error)


pure func decode_lsp_did_open_notification(
	body: String,
) -> LspProtocolInputOutcome[LspOpenedDocument]:
	match decode_lsp_json_rpc_body(body):
		Err(failure):
			LspProtocolInputRejected(failure)
		Ok(envelope):
			decode_lsp_did_open_envelope(envelope)


pure func handle_lsp_did_open_notification(
	store: LspDocumentStore,
	opened: LspOpenedDocument,
) -> Result[LspDocumentStore, LspDocumentStoreError]:
	lsp_document_store_open(store, opened)
