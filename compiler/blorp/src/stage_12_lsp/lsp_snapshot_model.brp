-- Identity facts that must still be current before an analysis result is used.
--
-- These wrappers prevent document versions, workspace revisions, and
-- configuration epochs from being interchanged merely because each is stored as
-- an Int. Revisions and epochs are non-negative monotonic counters owned by the
-- future workspace reducer.
import:
	lsp_document_model: LspDocumentVersion
	lsp_identity: LspDocumentUri


opaque type LspWorkspaceRevision = Int

opaque type LspConfigurationEpoch = Int


pure func lsp_initial_workspace_revision() -> LspWorkspaceRevision:
	into LspWorkspaceRevision(0)


pure func lsp_next_workspace_revision(revision: LspWorkspaceRevision) -> LspWorkspaceRevision:
	into LspWorkspaceRevision(from LspWorkspaceRevision(revision) + 1)


pure func lsp_workspace_revision(value: Int) -> Option[LspWorkspaceRevision]:
	if value < 0:
		None
	else:
		Some(into LspWorkspaceRevision(value))


pure func lsp_workspace_revision_value(revision: LspWorkspaceRevision) -> Int:
	from LspWorkspaceRevision(revision)


pure func lsp_configuration_epoch(value: Int) -> Option[LspConfigurationEpoch]:
	if value < 0:
		None
	else:
		Some(into LspConfigurationEpoch(value))


pure func lsp_initial_configuration_epoch() -> LspConfigurationEpoch:
	into LspConfigurationEpoch(0)


pure func lsp_next_configuration_epoch(epoch: LspConfigurationEpoch) -> LspConfigurationEpoch:
	into LspConfigurationEpoch(from LspConfigurationEpoch(epoch) + 1)


pure func lsp_configuration_epoch_value(epoch: LspConfigurationEpoch) -> Int:
	from LspConfigurationEpoch(epoch)


record LspSnapshotIdentity {
	uri: LspDocumentUri,
	document_version: Option[LspDocumentVersion],
	workspace_revision: LspWorkspaceRevision,
	configuration_epoch: LspConfigurationEpoch
}


pure func lsp_snapshot_identity(
	uri: LspDocumentUri,
	document_version: Option[LspDocumentVersion],
	workspace_revision: LspWorkspaceRevision,
	configuration_epoch: LspConfigurationEpoch,
) -> LspSnapshotIdentity:
	{
		uri = uri,
		document_version = document_version,
		workspace_revision = workspace_revision,
		configuration_epoch = configuration_epoch
	}
