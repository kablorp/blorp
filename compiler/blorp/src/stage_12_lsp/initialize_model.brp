-- Typed data shared by initialize decoding, handling, and server composition.
-- This module stays independent of compiler stages so protocol-only paths do not
-- pull lexer, parser, module, and typechecker globals into their build graph.
import:
	identity: DocumentUri
	protocol: RequestId


record InitializeParameters {
	process_id: Option[Int],
	workspace_folders: Option[List[DocumentUri]],
	root_uri: Option[DocumentUri],
	supports_definition_links: Bool,
	supports_declaration_links: Bool,
	supports_type_definition_links: Bool,
	supports_versioned_diagnostics: Bool
}


pure func initialize_workspace_roots(parameters: InitializeParameters) -> List[DocumentUri]:
	match parameters.workspace_folders:
		Some([first, ...rest]):
			[first] + rest
		_:
			parameters.root_uri
				.map(func(root): [root])
				.get_or([])


enum PositionEncoding:
	Utf16PositionEncoding


-- The sole synchronization capability represents the complete implemented set:
-- open/close plus full changes. Save remains unadvertised until the workspace
-- reducer has a save-specific consumer for its unversioned event metadata.
enum TextDocumentSyncCapability:
	FullDocumentSync


record InitializeResult {
	position_encoding: PositionEncoding,
	text_document_sync: TextDocumentSyncCapability
}


record InitializeRequest {
	id: RequestId,
	parameters: InitializeParameters
}


-- The transition keeps all decoded initialization state beside the response.
-- The eventual workspace actor can therefore apply roots, process lifecycle,
-- and client capabilities without decoding the request a second time.
record InitializeTransition {
	request: InitializeRequest,
	result: InitializeResult
}
