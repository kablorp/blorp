		module_semantic_index_module_identity,
		module_semantic_index_uri,
		parsed_artifact_fingerprint,
		typed_artifact_fingerprint,
		typed_artifact_module_index,
	analysis_planner: analysis_roots_for_workspace, analysis_targets_for_workspace
	architecture:
		AnalysisCommit(AnalysisCommitted, CurrentAnalysisFailed, StaleAnalysisDropped),
		AnalysisCompletion,
		AnalysisPlan,
		AnalysisPlanningRequirement(AnalysisPlanRequired, NoAnalysisPlanRequired),
		AnalysisResult,
