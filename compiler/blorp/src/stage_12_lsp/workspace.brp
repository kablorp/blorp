-- Serialized immutable ownership for editor overlays and compiler workspace facts.
--
-- Filesystem effects and compiler analysis remain outside this reducer. Every
-- accepted event produces one self-consistent snapshot, so workers cannot pair
-- source text from one edit with dependency or configuration facts from another.
import:
	../stage_04_modules/frontend_graph:
		FrontendImportEdge,
		FrontendImportResolution(FrontendResolvedImport, FrontendUnresolvedImport),
	../stage_04_modules/loaded_module:
		ResolvedModuleIdentity,
		module_identities_equal,
		module_identity_from_resolved,
		module_origins_equal,
		resolved_module_identities_equal,
