-- First concrete Blorp-owned LSP endpoint.
--
-- initialize is deliberately the first vertical slice: it exercises shared
-- JSON-RPC decoding, typed method validation, state transition construction,
-- and response encoding without document analysis or concurrency. This module
-- accepts one already-framed JSON body; Content-Length remains separate.
import:
	../stage_01_file_io/compiler_build_info: version
	identity: DocumentUri, document_uri
	initialize_model:
		DefinitionProviderCapability(DefinitionProviderEnabled),
		DocumentHighlightProviderCapability(DocumentHighlightProviderEnabled),
		DocumentSymbolProviderCapability(DocumentSymbolProviderEnabled),
		HoverProviderCapability(HoverProviderEnabled),
		InitializeParameters,
		InitializeRequest,
		InitializeResult,
		InitializeTransition,
		PositionEncoding(Utf16PositionEncoding),
		ReferencesProviderCapability(ReferencesProviderEnabled),
		TextDocumentSyncCapability(FullDocumentSync),
	json:
		JsonValue(JsonBool, JsonNull, JsonNumber, JsonObject, JsonString, JsonVector),
		as_bool,
		get_field,
	json_rpc:
		JsonRpcEnvelope,
		decode_lsp_json_rpc_body,
		integer_from_json,
		json_rpc_error_value,
		json_rpc_method,
		json_rpc_parameters,
		json_rpc_request_id,
		json_rpc_success_value,
	protocol:
		ProtocolError(InvalidMethodParameters, MissingRequestId, UnknownMethod),
		ProtocolFailure,
		ProtocolInputOutcome(ProtocolInputAccepted, ProtocolInputIgnored, ProtocolInputRejected),
		ProtocolResponse(ProtocolErrorResponse, ProtocolSuccessResponse),
		RequestId,


private INITIALIZE_METHOD: String = "initialize"

private SERVER_NAME: String = "blorp"

private UTF16_ENCODING: String = "utf-16"

-- LSP assigns 1 to full-document synchronization.
private FULL_DOCUMENT_SYNC_KIND: Float = 1.0


pure func initialize_method() -> String:
	INITIALIZE_METHOD


private record InitializeClientCapabilities {
	supports_definition_links: Bool,
	supports_declaration_links: Bool,
	supports_type_definition_links: Bool,
	supports_versioned_diagnostics: Bool
}


private pure func initialize_parameter_error(detail: String) -> ProtocolError:
	InvalidMethodParameters(INITIALIZE_METHOD, detail)


private pure func initialize_protocol_failure(
	request_id: RequestId,
	error: ProtocolError,
) -> ProtocolInputOutcome[InitializeRequest]:
	ProtocolInputRejected({
		request_id = Some(request_id),
		error = error,
	})


private pure func initialize_object_field(
	value: JsonValue,
	name: String,
	required: Bool,
) -> Result[JsonValue, ProtocolError]:
	match get_field(value, name):
		Some(JsonObject(fields)):
			Ok(JsonObject(fields))
		Some(JsonNull):
			if required:
				Err(initialize_parameter_error("`${name}` must be an object"))
			else:
				Ok(JsonObject([]))
		Some(_):
			Err(initialize_parameter_error("`${name}` must be an object"))
		None:
			if required:
				Err(initialize_parameter_error("missing required `${name}` object"))
			else:
				Ok(JsonObject([]))


private pure func optional_initialize_bool(
	value: JsonValue,
	name: String,
) -> Result[Bool, ProtocolError]:
	match get_field(value, name):
		None:
			Ok(False)
		Some(JsonNull):
			Ok(False)
		Some(field):
			match as_bool(field):
				Some(flag):
					Ok(flag)
				None:
					Err(initialize_parameter_error("`${name}` must be a boolean"))


private pure func decode_process_id(params: JsonValue) -> Result[Option[Int], ProtocolError]:
	match get_field(params, "processId"):
		None:
			Err(initialize_parameter_error("missing required `processId`"))
		Some(JsonNull):
			Ok(None)
		Some(value):
			match integer_from_json(value):
				Some(process_id):
					Ok(Some(process_id))
				None:
					Err(
						initialize_parameter_error(
							"`processId` must be a signed 32-bit integer or null",
						),
					)


private pure func decode_workspace_folder(value: JsonValue) -> Result[DocumentUri, ProtocolError]:
	match value:
		JsonObject(_):
			match (get_field(value, "uri"), get_field(value, "name")):
				(Some(JsonString(uri)), Some(JsonString(_))):
					Ok(document_uri(uri))
				(Some(JsonString(_)), _):
					Err(initialize_parameter_error("workspace folder `name` must be a string"))
				_:
					Err(initialize_parameter_error("workspace folder `uri` must be a string"))
		_:
			Err(initialize_parameter_error("each workspace folder must be an object"))


private pure func decode_workspace_folders(
	values: List[JsonValue],
) -> Result[List[DocumentUri], ProtocolError]:
	match values:
		[]:
			Ok([])
		[value, ...rest]:
			root ?= decode_workspace_folder(value)
			remaining ?= decode_workspace_folders(rest)
			Ok([root] + remaining)


private pure func decode_root_uri(params: JsonValue) -> Result[Option[DocumentUri], ProtocolError]:
	match get_field(params, "rootUri"):
		None:
			Ok(None)
		Some(JsonNull):
			Ok(None)
		Some(JsonString(uri)):
			Ok(Some(document_uri(uri)))
		Some(_):
			Err(initialize_parameter_error("`rootUri` must be a string or null"))


private pure func decode_workspace_folders_field(
	params: JsonValue,
) -> Result[Option[List[DocumentUri]], ProtocolError]:
	match get_field(params, "workspaceFolders"):
		Some(JsonVector(folders)):
			decode_workspace_folders(folders).map(pure func(roots: List[DocumentUri]): Some(roots))
		Some(JsonNull):
			Ok(None)
		Some(_):
			Err(initialize_parameter_error("`workspaceFolders` must be an array or null"))
		None:
			Ok(None)


private pure func decode_initialize_capabilities(
	params: JsonValue,
) -> Result[InitializeClientCapabilities, ProtocolError]:
	capabilities ?= initialize_object_field(params, "capabilities", True)
	text_document ?= initialize_object_field(capabilities, "textDocument", False)
	definition ?= initialize_object_field(text_document, "definition", False)
	declaration ?= initialize_object_field(text_document, "declaration", False)
	type_definition ?= initialize_object_field(text_document, "typeDefinition", False)
	publish_diagnostics ?= initialize_object_field(text_document, "publishDiagnostics", False)

	definition_links ?= optional_initialize_bool(definition, "linkSupport")
	declaration_links ?= optional_initialize_bool(declaration, "linkSupport")
	type_definition_links ?= optional_initialize_bool(type_definition, "linkSupport")
	versioned_diagnostics ?= optional_initialize_bool(publish_diagnostics, "versionSupport")

	Ok({
		supports_definition_links = definition_links,
		supports_declaration_links = declaration_links,
		supports_type_definition_links = type_definition_links,
		supports_versioned_diagnostics = versioned_diagnostics,
	})


private pure func decode_initialize_parameters(
	value: JsonValue,
) -> Result[InitializeParameters, ProtocolError]:
	match value:
		JsonObject(_):
			process_id ?= decode_process_id(value)
			workspace_folders ?= decode_workspace_folders_field(value)
			root_uri ?= decode_root_uri(value)
			capabilities ?= decode_initialize_capabilities(value)

			Ok({
				process_id = process_id,
				workspace_folders = workspace_folders,
				root_uri = root_uri,
				supports_definition_links = capabilities.supports_definition_links,
				supports_declaration_links = capabilities.supports_declaration_links,
				supports_type_definition_links = capabilities.supports_type_definition_links,
				supports_versioned_diagnostics = capabilities.supports_versioned_diagnostics,
			})
		_:
			Err(initialize_parameter_error("params must be an object"))


pure func decode_lsp_initialize_envelope(
	envelope: JsonRpcEnvelope,
) -> ProtocolInputOutcome[InitializeRequest]:
	method = json_rpc_method(envelope)
	request_id = json_rpc_request_id(envelope)

	if method != INITIALIZE_METHOD:
		match request_id:
			Some(request_id):
				initialize_protocol_failure(request_id, UnknownMethod(method))
			None:
				ProtocolInputIgnored(UnknownMethod(method))
	else:
		match request_id:
			None:
				ProtocolInputIgnored(MissingRequestId(method))
			Some(request_id):
				match json_rpc_parameters(envelope):
					None:
						initialize_protocol_failure(
							request_id,
							initialize_parameter_error("missing required `params` object"),
						)
					Some(params_value):
						match decode_initialize_parameters(params_value):
							Ok(parameters):
								ProtocolInputAccepted({
									id = request_id,
									parameters = parameters,
								})
							Err(error):
								initialize_protocol_failure(request_id, error)


pure func decode_lsp_initialize_request(body: String) -> ProtocolInputOutcome[InitializeRequest]:
	match decode_lsp_json_rpc_body(body):
		Err(failure):
			ProtocolInputRejected(failure)
		Ok(envelope):
			decode_lsp_initialize_envelope(envelope)


pure func handle_lsp_initialize_request(request: InitializeRequest) -> InitializeTransition:
	{
		request = request,
		result = {
			position_encoding = Utf16PositionEncoding,
			text_document_sync = FullDocumentSync,
			definition_provider = DefinitionProviderEnabled,
			references_provider = ReferencesProviderEnabled,
			document_symbol_provider = DocumentSymbolProviderEnabled,
			document_highlight_provider = DocumentHighlightProviderEnabled,
			hover_provider = HoverProviderEnabled
		}
	}


pure func handle_lsp_initialize_body(body: String) -> ProtocolInputOutcome[InitializeTransition]:
	match decode_lsp_initialize_request(body):
		ProtocolInputAccepted(request):
			ProtocolInputAccepted(handle_lsp_initialize_request(request))
		ProtocolInputRejected(failure):
			ProtocolInputRejected(failure)
		ProtocolInputIgnored(error):
			ProtocolInputIgnored(error)


pure func initialize_response(
	transition: InitializeTransition,
) -> ProtocolResponse[InitializeResult, ProtocolFailure]:
	ProtocolSuccessResponse(transition.request.id, transition.result)


pure func initialize_error_response(
	failure: ProtocolFailure,
) -> ProtocolResponse[InitializeResult, ProtocolFailure]:
	ProtocolErrorResponse(failure)


private pure func initialize_result_json(result: InitializeResult) -> JsonValue:
	position_encoding: String = match result.position_encoding:
		Utf16PositionEncoding:
			UTF16_ENCODING

	text_document_sync: JsonValue = match result.text_document_sync:
		FullDocumentSync:
			JsonObject([
				("openClose", JsonBool(True)),
				("change", JsonNumber(FULL_DOCUMENT_SYNC_KIND)),
				("save", JsonObject([("includeText", JsonBool(False))])),
			])

	definition_provider: JsonValue = match result.definition_provider:
		DefinitionProviderEnabled:
			JsonBool(True)

	references_provider: JsonValue = match result.references_provider:
		ReferencesProviderEnabled:
			JsonBool(True)

	document_symbol_provider: JsonValue = match result.document_symbol_provider:
		DocumentSymbolProviderEnabled:
			JsonBool(True)

	document_highlight_provider: JsonValue = match result.document_highlight_provider:
		DocumentHighlightProviderEnabled:
			JsonBool(True)

	hover_provider: JsonValue = match result.hover_provider:
		HoverProviderEnabled:
			JsonBool(True)

	JsonObject([("capabilities", JsonObject([
			("positionEncoding", JsonString(position_encoding)),
			("textDocumentSync", text_document_sync),
			("definitionProvider", definition_provider),
			("referencesProvider", references_provider),
			("documentSymbolProvider", document_symbol_provider),
			("documentHighlightProvider", document_highlight_provider),
			("hoverProvider", hover_provider),
		])), ("serverInfo", JsonObject([
			("name", JsonString(SERVER_NAME)),
			("version", JsonString(version())),
		]))])


-- This is the initialize branch of the protocol codec, kept separate from the
-- typed handler so workspace state never depends on JSON or encoded strings.
pure func encode_lsp_initialize_response(
	response: ProtocolResponse[InitializeResult, ProtocolFailure],
) -> String:
	match response:
		ProtocolSuccessResponse(id, result):
			json_rpc_success_value(id, initialize_result_json(result)).to_string()
		ProtocolErrorResponse(failure):
			json_rpc_error_value(failure).to_string()
