-- Shared field validation for document synchronization method codecs.
--
-- The method name remains an argument so diagnostics identify the protocol
-- operation that owns the malformed parameters.
import:
	json: JsonValue(JsonObject), as_string, get_field
	lsp_document_model: LspDocumentVersion, lsp_document_version
	lsp_json_rpc: lsp_integer_from_json
	lsp_protocol: LspProtocolError(LspInvalidMethodParameters)


pure func lsp_document_parameter_error(method: String, detail: String) -> LspProtocolError:
	LspInvalidMethodParameters(method, detail)


pure func lsp_required_object_field(
	value: JsonValue,
	name: String,
	method: String,
) -> Result[JsonValue, LspProtocolError]:
	match get_field(value, name):
		Some(JsonObject(fields)):
			Ok(JsonObject(fields))
		Some(_):
			Err(lsp_document_parameter_error(method, "`${name}` must be an object"))
		None:
			Err(lsp_document_parameter_error(method, "missing required `${name}` object"))


pure func lsp_required_string_field(
	value: JsonValue,
	name: String,
	method: String,
) -> Result[String, LspProtocolError]:
	match get_field(value, name):
		Some(field):
			match as_string(field):
				Some(text):
					Ok(text)
				None:
					Err(lsp_document_parameter_error(method, "`${name}` must be a string"))
		None:
			Err(lsp_document_parameter_error(method, "missing required `${name}` string"))


pure func lsp_required_document_version(
	value: JsonValue,
	method: String,
) -> Result[LspDocumentVersion, LspProtocolError]:
	match get_field(value, "version"):
		Some(version_value):
			match lsp_integer_from_json(version_value):
				Some(version):
					match lsp_document_version(version):
						Some(document_version):
							Ok(document_version)
						None:
							Err(
								lsp_document_parameter_error(
									method,
									"`version` must be a signed 32-bit integer",
								),
							)
				None:
					Err(
						lsp_document_parameter_error(
							method,
							"`version` must be a signed 32-bit integer",
						),
					)
		None:
			Err(lsp_document_parameter_error(method, "missing required `version` integer"))
