-- Opaque persistent indexes used by immutable LSP workspace snapshots.
--
-- URI stores use the exact URI string as their canonical key. Module stores
-- use the compiler's lossless storage key. The stored identity is still checked
-- on lookup so a future key-format regression fails closed instead of aliasing
-- two modules.
import:
	../stage_04_modules/loaded_module:
		CompilerModuleIdentity,
		compiler_module_identities_equal,
		compiler_module_identity_storage_key,
	lsp_identity: LspDocumentUri, lsp_document_uri_value


opaque type LspUriStore[V] = Dict[String, V]


private record LspModuleStoreEntry[V] {
	identity: CompilerModuleIdentity,
	value: V
}


opaque type LspModuleStore[V] = Dict[String, LspModuleStoreEntry[V]]


union LspIndexedStoreError:
	LspIndexedStoreDuplicateUri(LspDocumentUri)
	LspIndexedStoreDuplicateModule(CompilerModuleIdentity)


private pure func uri_store_values_by_key[V](store: LspUriStore[V]) -> Dict[String, V]:
	from LspUriStore[V](store)


pure func lsp_uri_store[V]() -> LspUriStore[V]:
	empty: Dict[String, V] = {}
	into LspUriStore[V](empty)


pure func lsp_uri_store_from_entries[V](
	entries: List[(LspDocumentUri, V)],
) -> Result[LspUriStore[V], LspIndexedStoreError]:
	var store: LspUriStore[V] = lsp_uri_store()
	var duplicate: Option[LspDocumentUri] = None

	for entry in entries:
		if duplicate.is_none():
			uri = entry[0]

			if lsp_uri_store_contains(store, uri):
				duplicate = Some(uri)
			else:
				store = lsp_uri_store_set(store, uri, entry[1])

	match duplicate:
		Some(uri):
			Err(LspIndexedStoreDuplicateUri(uri))
		None:
			Ok(store)


pure func lsp_uri_store_get[V](store: LspUriStore[V], uri: LspDocumentUri) -> Option[V]:
	uri_store_values_by_key(store).get(lsp_document_uri_value(uri))


pure func lsp_uri_store_set[V](
	store: LspUriStore[V],
	uri: LspDocumentUri,
	value: V,
) -> LspUriStore[V]:
	into LspUriStore[V](uri_store_values_by_key(store).set(lsp_document_uri_value(uri), value))


pure func lsp_uri_store_remove[V](store: LspUriStore[V], uri: LspDocumentUri) -> LspUriStore[V]:
	into LspUriStore[V](uri_store_values_by_key(store).remove(lsp_document_uri_value(uri)))


pure func lsp_uri_store_contains[V](store: LspUriStore[V], uri: LspDocumentUri) -> Bool:
	uri_store_values_by_key(store).contains(lsp_document_uri_value(uri))


pure func lsp_uri_store_values[V](store: LspUriStore[V]) -> List[V]:
	uri_store_values_by_key(store).values()


pure func lsp_uri_store_length[V](store: LspUriStore[V]) -> Int:
	uri_store_values_by_key(store).length()


pure func lsp_uri_store_is_empty[V](store: LspUriStore[V]) -> Bool:
	uri_store_values_by_key(store).is_empty()


private pure func module_store_entries[V](
	store: LspModuleStore[V],
) -> Dict[String, LspModuleStoreEntry[V]]:
	from LspModuleStore[V](store)


pure func lsp_module_store[V]() -> LspModuleStore[V]:
	empty: Dict[String, LspModuleStoreEntry[V]] = {}
	into LspModuleStore[V](empty)


pure func lsp_module_store_from_entries[V](
	entries: List[(CompilerModuleIdentity, V)],
) -> Result[LspModuleStore[V], LspIndexedStoreError]:
	var store: LspModuleStore[V] = lsp_module_store()
	var duplicate: Option[CompilerModuleIdentity] = None

	for entry in entries:
		if duplicate.is_none():
			identity = entry[0]

			if lsp_module_store_contains(store, identity):
				duplicate = Some(identity)
			else:
				store = lsp_module_store_set(store, identity, entry[1])

	match duplicate:
		Some(identity):
			Err(LspIndexedStoreDuplicateModule(identity))
		None:
			Ok(store)


pure func lsp_module_store_get[V](
	store: LspModuleStore[V],
	identity: CompilerModuleIdentity,
) -> Option[V]:
	key = compiler_module_identity_storage_key(identity)
	entry ?= module_store_entries(store).get(key)

	if compiler_module_identities_equal(entry.identity, identity):
		Some(entry.value)
	else:
		None


pure func lsp_module_store_set[V](
	store: LspModuleStore[V],
	identity: CompilerModuleIdentity,
	value: V,
) -> LspModuleStore[V]:
	key = compiler_module_identity_storage_key(identity)
	entries = module_store_entries(store)

	match entries.get(key):
		Some(existing):
			if not compiler_module_identities_equal(existing.identity, identity):
				store
			else:
				entry: LspModuleStoreEntry[V] = {
					identity = identity,
					value = value
				}
				into LspModuleStore[V](entries.set(key, entry))
		None:
			entry: LspModuleStoreEntry[V] = {
				identity = identity,
				value = value
			}
			into LspModuleStore[V](entries.set(key, entry))


pure func lsp_module_store_remove[V](
	store: LspModuleStore[V],
	identity: CompilerModuleIdentity,
) -> LspModuleStore[V]:
	key = compiler_module_identity_storage_key(identity)
	entries = module_store_entries(store)

	match entries.get(key):
		Some(existing):
			if compiler_module_identities_equal(existing.identity, identity):
				into LspModuleStore[V](entries.remove(key))
			else:
				store
		None:
			store


pure func lsp_module_store_contains[V](
	store: LspModuleStore[V],
	identity: CompilerModuleIdentity,
) -> Bool:
	lsp_module_store_get(store, identity).is_some()


pure func lsp_module_store_values[V](store: LspModuleStore[V]) -> List[V]:
	module_store_entries(store)
		.values()
		.map(func(entry): entry.value)


pure func lsp_module_store_length[V](store: LspModuleStore[V]) -> Int:
	module_store_entries(store).length()


pure func lsp_module_store_is_empty[V](store: LspModuleStore[V]) -> Bool:
	module_store_entries(store).is_empty()
