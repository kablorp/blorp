-- Compiler-private raw stdio boundary for the native LSP process.
--
-- These operations preserve byte payloads and distinguish EOF from an empty
-- successful read. They are intentionally not part of std: process-owned stdin
-- and stdout need an LSP-specific lifetime and reactor contract before a general
-- user-facing API can be designed.
union CompilerStdioError:
	CompilerStdioInvalidInput(String)
	CompilerStdinReadFailed(String)
	CompilerStdoutWriteFailed(String)


private union CompilerStdinRawOutcome:
	CompilerStdinRawData(Bytes)
	CompilerStdinRawEof


union CompilerStdinReadOutcome:
	CompilerStdinReadData(Bytes)
	CompilerStdinReadEof
	CompilerStdinReadFailed(CompilerStdioError)


private func compiler_stdin_read_raw(max_bytes: Int) -> Result[CompilerStdinRawOutcome, CompilerStdioError]:
	builtin("blorp_compiler_stdin_read_raw")


func compiler_stdin_read(max_bytes: Int) -> CompilerStdinReadOutcome:
	if max_bytes <= 0:
		CompilerStdinReadFailed(CompilerStdioInvalidInput("max_bytes must be positive"))
	else:
		match compiler_stdin_read_raw(max_bytes):
			Ok(CompilerStdinRawData(data)):
				CompilerStdinReadData(data)
			Ok(CompilerStdinRawEof):
				CompilerStdinReadEof
			Err(error):
				CompilerStdinReadFailed(error)


func compiler_stdout_write_all(data: Bytes) -> Result[Void, CompilerStdioError]:
	builtin("blorp_compiler_stdout_write_all_raw")
