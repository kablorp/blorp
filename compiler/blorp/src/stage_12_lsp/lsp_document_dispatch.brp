-- Canonical routing over the existing document synchronization codecs.
--
-- This module selects one codec from the JSON-RPC method and preserves its
-- notification/request response obligation. It neither reparses parameters nor
-- mutates document state; the server actor sends accepted values through the
-- workspace reducer.
import:
	lsp_did_change: decode_lsp_did_change_envelope, lsp_did_change_method
	lsp_did_close: decode_lsp_did_close_envelope, lsp_did_close_method
	lsp_did_open: decode_lsp_did_open_envelope, lsp_did_open_method
	lsp_did_save: decode_lsp_did_save_envelope, lsp_did_save_method
	lsp_document_model: LspDocumentChange, LspDocumentSave, LspOpenedDocument
	lsp_identity: LspDocumentUri
	lsp_json_rpc: LspJsonRpcEnvelope, lsp_json_rpc_method
	lsp_protocol:
		LspProtocolError,
		LspProtocolFailure,
		LspProtocolInputOutcome(
			LspProtocolInputAccepted,
			LspProtocolInputIgnored,
			LspProtocolInputRejected,
		),


union LspDocumentNotification:
	LspDecodedDocumentOpen(LspOpenedDocument)
	LspDecodedDocumentChange(LspDocumentChange)
	LspDecodedDocumentSave(LspDocumentSave)
	LspDecodedDocumentClose(LspDocumentUri)


union LspDocumentEnvelopeDispatch:
	LspDocumentEnvelopeAccepted(LspDocumentNotification)
	LspDocumentEnvelopeIgnored(LspProtocolError)
	LspDocumentEnvelopeRejected(LspProtocolFailure)
	LspDocumentEnvelopeUnhandled(LspJsonRpcEnvelope)


private pure func open_dispatch(envelope: LspJsonRpcEnvelope) -> LspDocumentEnvelopeDispatch:
	match decode_lsp_did_open_envelope(envelope):
		LspProtocolInputAccepted(document):
			LspDocumentEnvelopeAccepted(LspDecodedDocumentOpen(document))
		LspProtocolInputIgnored(error):
			LspDocumentEnvelopeIgnored(error)
		LspProtocolInputRejected(failure):
			LspDocumentEnvelopeRejected(failure)


private pure func change_dispatch(envelope: LspJsonRpcEnvelope) -> LspDocumentEnvelopeDispatch:
	match decode_lsp_did_change_envelope(envelope):
		LspProtocolInputAccepted(change):
			LspDocumentEnvelopeAccepted(LspDecodedDocumentChange(change))
		LspProtocolInputIgnored(error):
			LspDocumentEnvelopeIgnored(error)
		LspProtocolInputRejected(failure):
			LspDocumentEnvelopeRejected(failure)


private pure func save_dispatch(envelope: LspJsonRpcEnvelope) -> LspDocumentEnvelopeDispatch:
	match decode_lsp_did_save_envelope(envelope):
		LspProtocolInputAccepted(save):
			LspDocumentEnvelopeAccepted(LspDecodedDocumentSave(save))
		LspProtocolInputIgnored(error):
			LspDocumentEnvelopeIgnored(error)
		LspProtocolInputRejected(failure):
			LspDocumentEnvelopeRejected(failure)


private pure func close_dispatch(envelope: LspJsonRpcEnvelope) -> LspDocumentEnvelopeDispatch:
	match decode_lsp_did_close_envelope(envelope):
		LspProtocolInputAccepted(uri):
			LspDocumentEnvelopeAccepted(LspDecodedDocumentClose(uri))
		LspProtocolInputIgnored(error):
			LspDocumentEnvelopeIgnored(error)
		LspProtocolInputRejected(failure):
			LspDocumentEnvelopeRejected(failure)


pure func dispatch_lsp_document_envelope(
	envelope: LspJsonRpcEnvelope,
) -> LspDocumentEnvelopeDispatch:
	method = lsp_json_rpc_method(envelope)

	if method == lsp_did_open_method():
		open_dispatch(envelope)
	else if method == lsp_did_change_method():
		change_dispatch(envelope)
	else if method == lsp_did_save_method():
		save_dispatch(envelope)
	else if method == lsp_did_close_method():
		close_dispatch(envelope)
	else:
		LspDocumentEnvelopeUnhandled(envelope)
