-- Immutable editor-overlay ownership keyed by the exact document URI string.
--
-- The opaque Dict representation gives expected O(1) lookup while preventing
-- protocol handlers from bypassing balanced open/close invariants.
import:
	lsp_document_model:
		LspDocumentChange,
		LspDocumentSave,
		LspDocumentVersion,
		LspOpenedDocument,
		LspVersionedDocumentText,
		lsp_document_version_value,
	lsp_identity: LspDocumentUri, lsp_document_uri_value


opaque type LspDocumentStore = Dict[String, LspOpenedDocument]


union LspDocumentStoreError:
	LspDocumentAlreadyOpen(LspDocumentUri)
	LspDocumentNotOpen(LspDocumentUri)
	LspDocumentVersionNotNewer(LspDocumentUri, LspDocumentVersion, LspDocumentVersion)


private pure func document_store(documents: Dict[String, LspOpenedDocument]) -> LspDocumentStore:
	into LspDocumentStore(documents)


private pure func document_store_documents(
	store: LspDocumentStore,
) -> Dict[String, LspOpenedDocument]:
	from LspDocumentStore(store)


pure func lsp_document_store() -> LspDocumentStore:
	documents: Dict[String, LspOpenedDocument] = {}
	document_store(documents)


pure func lsp_document_store_find(
	store: LspDocumentStore,
	uri: LspDocumentUri,
) -> Option[LspOpenedDocument]:
	document_store_documents(store).get(lsp_document_uri_value(uri))


pure func lsp_document_store_open(
	store: LspDocumentStore,
	opened: LspOpenedDocument,
) -> Result[LspDocumentStore, LspDocumentStoreError]:
	uri = opened.document.uri
	key = lsp_document_uri_value(uri)
	documents = document_store_documents(store)

	if documents.contains(key):
		Err(LspDocumentAlreadyOpen(uri))
	else:
		Ok(document_store(documents.set(key, opened)))


pure func lsp_document_store_change(
	store: LspDocumentStore,
	changed: LspDocumentChange,
) -> Result[LspDocumentStore, LspDocumentStoreError]:
	key = lsp_document_uri_value(changed.uri)
	documents = document_store_documents(store)

	match documents.get(key):
		None:
			Err(LspDocumentNotOpen(changed.uri))
		Some(opened):
			current = opened.document.version

			if lsp_document_version_value(changed.version) <= lsp_document_version_value(current):
				Err(LspDocumentVersionNotNewer(changed.uri, current, changed.version))
			else:
				text: String = match changed.replacement_text:
					Some(replacement):
						replacement
					None:
						opened.document.text

				document: LspVersionedDocumentText = {
					uri = changed.uri,
					version = changed.version,
					text = text
				}

				Ok(document_store(documents.set(key, { opened | document = document })))


pure func lsp_document_store_save(
	store: LspDocumentStore,
	saved: LspDocumentSave,
) -> Result[LspDocumentStore, LspDocumentStoreError]:
	key = lsp_document_uri_value(saved.uri)
	documents = document_store_documents(store)

	match documents.get(key):
		None:
			Err(LspDocumentNotOpen(saved.uri))
		Some(_):
			-- didSave has no version. Its optional text can describe an older save
			-- than the current edit, so only didChange may replace overlay text.
			Ok(store)


pure func lsp_document_store_close(
	store: LspDocumentStore,
	uri: LspDocumentUri,
) -> Result[LspDocumentStore, LspDocumentStoreError]:
	key = lsp_document_uri_value(uri)
	documents = document_store_documents(store)

	if documents.contains(key):
		Ok(document_store(documents.remove(key)))
	else:
		Err(LspDocumentNotOpen(uri))
