-- Identity-coherent persistent stores for workspace-owned facts.
--
-- Keys are always derived from the stored value. The generic indexed store is
-- hidden behind these wrappers so source and dependency identities cannot be
-- paired with unrelated URI keys in a workspace snapshot.
import:
	../stage_04_modules/frontend_graph:
		CompilerFrontendImportEdge,
		CompilerFrontendImportResolution(
			CompilerFrontendResolvedImport,
			CompilerFrontendUnresolvedImport,
		),
	../stage_04_modules/loaded_module:
		CompilerResolvedModuleIdentity,
		compiler_resolved_module_identities_equal,
		compiler_resolved_module_identity_storage_key,
	lsp_identity: LspDocumentUri
	lsp_indexed_store:
		LspUriStore,
		lsp_uri_store,
		lsp_uri_store_contains,
		lsp_uri_store_get,
		lsp_uri_store_is_empty,
		lsp_uri_store_length,
		lsp_uri_store_remove,
		lsp_uri_store_set,
		lsp_uri_store_values,
	lsp_workspace_model:
		LspModuleDependencyState(
			LspParsedDependencies,
			LspResolvedDependencies,
			LspUnparsedModuleDependencies,
		),
		LspSourceLayers,
		lsp_module_dependency_identity,
		lsp_module_dependency_uri,


opaque type LspSourceStore = LspUriStore[LspSourceLayers]


private record LspDependencyStoreEntry {
	identity: CompilerResolvedModuleIdentity,
	value: LspModuleDependencyState
}


opaque type LspDependencyStore = Dict[String, LspDependencyStoreEntry]


pure func lsp_source_store() -> LspSourceStore:
	into LspSourceStore(lsp_uri_store())


pure func lsp_source_store_from_values(
	values: List[LspSourceLayers],
) -> Result[LspSourceStore, LspDocumentUri]:
	var store: LspSourceStore = lsp_source_store()
	var duplicate: Option[LspDocumentUri] = None

	for value in values:
		if duplicate.is_none():
			if lsp_source_store_contains(store, value.uri):
				duplicate = Some(value.uri)
			else:
				store = lsp_source_store_set(store, value)

	match duplicate:
		Some(uri):
			Err(uri)
		None:
			Ok(store)


pure func lsp_source_store_get(
	store: LspSourceStore,
	uri: LspDocumentUri,
) -> Option[LspSourceLayers]:
	lsp_uri_store_get(from LspSourceStore(store), uri)


pure func lsp_source_store_set(store: LspSourceStore, value: LspSourceLayers) -> LspSourceStore:
	underlying = from LspSourceStore(store)
	into LspSourceStore(lsp_uri_store_set(underlying, value.uri, value))


pure func lsp_source_store_remove(store: LspSourceStore, uri: LspDocumentUri) -> LspSourceStore:
	into LspSourceStore(lsp_uri_store_remove(from LspSourceStore(store), uri))


pure func lsp_source_store_contains(store: LspSourceStore, uri: LspDocumentUri) -> Bool:
	lsp_uri_store_contains(from LspSourceStore(store), uri)


pure func lsp_source_store_values(store: LspSourceStore) -> List[LspSourceLayers]:
	lsp_uri_store_values(from LspSourceStore(store))


pure func lsp_source_store_length(store: LspSourceStore) -> Int:
	lsp_uri_store_length(from LspSourceStore(store))


pure func lsp_source_store_is_empty(store: LspSourceStore) -> Bool:
	lsp_uri_store_is_empty(from LspSourceStore(store))


pure func lsp_dependency_store() -> LspDependencyStore:
	empty: Dict[String, LspDependencyStoreEntry] = {}
	into LspDependencyStore(empty)


private pure func dependency_store_entries(
	store: LspDependencyStore,
) -> Dict[String, LspDependencyStoreEntry]:
	from LspDependencyStore(store)


pure func lsp_dependency_store_from_values(
	values: List[LspModuleDependencyState],
) -> Result[LspDependencyStore, LspDocumentUri]:
	var store: LspDependencyStore = lsp_dependency_store()
	var duplicate: Option[LspDocumentUri] = None

	for value in values:
		if duplicate.is_none():
			uri = lsp_module_dependency_uri(value)
			identity = lsp_module_dependency_identity(value)
			key = compiler_resolved_module_identity_storage_key(identity)

			if dependency_store_entries(store).contains(key):
				duplicate = Some(uri)
			else:
				store = lsp_dependency_store_set(store, value)

	match duplicate:
		Some(uri):
			Err(uri)
		None:
			Ok(store)


pure func lsp_dependency_store_get(
	store: LspDependencyStore,
	identity: CompilerResolvedModuleIdentity,
) -> Option[LspModuleDependencyState]:
	key = compiler_resolved_module_identity_storage_key(identity)
	entry ?= dependency_store_entries(store).get(key)

	if compiler_resolved_module_identities_equal(entry.identity, identity):
		Some(entry.value)
	else:
		None


pure func lsp_dependency_store_for_uri(
	store: LspDependencyStore,
	uri: LspDocumentUri,
) -> List[LspModuleDependencyState]:
	lsp_dependency_store_values(store).filter(func(value):
		lsp_module_dependency_uri(value) == uri
	)


pure func lsp_dependency_store_set(
	store: LspDependencyStore,
	value: LspModuleDependencyState,
) -> LspDependencyStore:
	identity = lsp_module_dependency_identity(value)
	key = compiler_resolved_module_identity_storage_key(identity)
	entry: LspDependencyStoreEntry = {
		identity = identity,
		value = value
	}
	into LspDependencyStore(dependency_store_entries(store).set(key, entry))


pure func lsp_dependency_store_remove(
	store: LspDependencyStore,
	identity: CompilerResolvedModuleIdentity,
) -> LspDependencyStore:
	key = compiler_resolved_module_identity_storage_key(identity)

	match dependency_store_entries(store).get(key):
		Some(entry):
			if compiler_resolved_module_identities_equal(entry.identity, identity):
				into LspDependencyStore(dependency_store_entries(store).remove(key))
			else:
				store
		None:
			store


pure func lsp_dependency_store_remove_for_uri(
	store: LspDependencyStore,
	uri: LspDocumentUri,
) -> LspDependencyStore:
	var updated = store

	for value in lsp_dependency_store_for_uri(store, uri):
		updated = lsp_dependency_store_remove(updated, lsp_module_dependency_identity(value))

	updated


pure func lsp_dependency_store_values(store: LspDependencyStore) -> List[LspModuleDependencyState]:
	dependency_store_entries(store)
		.values()
		.map(func(entry): entry.value)


pure func lsp_dependency_store_length(store: LspDependencyStore) -> Int:
	dependency_store_entries(store).length()


pure func lsp_dependency_store_is_empty(store: LspDependencyStore) -> Bool:
	dependency_store_entries(store).is_empty()


private pure func import_resolutions_equal(
	left: CompilerFrontendImportResolution,
	right: CompilerFrontendImportResolution,
) -> Bool:
	match (left, right):
		(CompilerFrontendUnresolvedImport, CompilerFrontendUnresolvedImport):
			True
		(CompilerFrontendResolvedImport(left_target), CompilerFrontendResolvedImport(right_target)):
			compiler_resolved_module_identities_equal(left_target, right_target)
		_:
			False


private pure func import_edges_equal(
	left: CompilerFrontendImportEdge,
	right: CompilerFrontendImportEdge,
) -> Bool:
	(
		compiler_resolved_module_identities_equal(left.importer, right.importer)
		and left.requested_path == right.requested_path
		and import_resolutions_equal(left.resolution, right.resolution)
	)


private pure func import_edge_lists_equal(
	left: List[CompilerFrontendImportEdge],
	right: List[CompilerFrontendImportEdge],
) -> Bool:
	(
		left.length() == right.length()
		and left
			.zip(right)
			.all(func(pair):
				import_edges_equal(pair[0], pair[1])
			)
	)


private pure func dependency_states_equal(
	left: LspModuleDependencyState,
	right: LspModuleDependencyState,
) -> Bool:
	match (left, right):
		(LspUnparsedModuleDependencies(left_uri, left_identity), LspUnparsedModuleDependencies(right_uri, right_identity)):
			(
				left_uri == right_uri
				and compiler_resolved_module_identities_equal(left_identity, right_identity)
			)
		(LspParsedDependencies(left_parsed), LspParsedDependencies(right_parsed)):
			(
				left_parsed.uri == right_parsed.uri
				and compiler_resolved_module_identities_equal(
					left_parsed.module_identity,
					right_parsed.module_identity,
				)
				and left_parsed.import_paths == right_parsed.import_paths
			)
		(LspResolvedDependencies(left_resolved), LspResolvedDependencies(right_resolved)):
			(
				left_resolved.uri == right_resolved.uri
				and compiler_resolved_module_identities_equal(
					left_resolved.module_identity,
					right_resolved.module_identity,
				)
				and import_edge_lists_equal(left_resolved.import_edges, right_resolved.import_edges)
			)
		_:
			False


pure func lsp_dependency_stores_equal(left: LspDependencyStore, right: LspDependencyStore) -> Bool:
	left_values = lsp_dependency_store_values(left)

	left_values.length() == lsp_dependency_store_length(right) and left_values.all(func(value):
		identity = lsp_module_dependency_identity(value)

		match lsp_dependency_store_get(right, identity):
			Some(other):
				dependency_states_equal(value, other)
			None:
				False
	)
