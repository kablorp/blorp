-- Immutable work emitted by serialized server-state transitions.
--
-- Parsing and typechecking do not run inside the protocol reducer. A server loop
-- may execute analysis concurrently, but its embedded snapshot identity must
-- pass the canonical publication guard after completion. Clear requests remain
-- URI-scoped and are emitted only if serialized state still considers them safe.
import:
	diagnostic_model: DiagnosticClearRequest
	document_model: VersionedDocumentText
	snapshot_model: ConfigurationEpoch, SnapshotIdentity, WorkspaceRevision, snapshot_identity


private record DocumentAnalysisRequestRep {
	identity: SnapshotIdentity,
	document: VersionedDocumentText
}


opaque type DocumentAnalysisRequest = DocumentAnalysisRequestRep


pure func document_analysis_request(
	document: VersionedDocumentText,
	workspace_revision: WorkspaceRevision,
	configuration_epoch: ConfigurationEpoch,
) -> DocumentAnalysisRequest:
	into DocumentAnalysisRequest({
			identity = snapshot_identity(
				document.uri,
				Some(document.version),
				workspace_revision,
				configuration_epoch,
			),
			document = document
		})


pure func document_analysis_identity(request: DocumentAnalysisRequest) -> SnapshotIdentity:
	from DocumentAnalysisRequest(request).identity


pure func document_analysis_document(request: DocumentAnalysisRequest) -> VersionedDocumentText:
	from DocumentAnalysisRequest(request).document


union ServerWork:
	AnalyzeDocument(DocumentAnalysisRequest)
	ClearDocumentDiagnostics(DiagnosticClearRequest)
