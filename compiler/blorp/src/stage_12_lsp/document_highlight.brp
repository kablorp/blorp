-- JSON-RPC codec for document-local symbol highlights.
-- The request is deliberately position-based; exact identity resolution stays
-- in document_highlight_query and never falls back to name matching.
import:
	document_highlight_model: DocumentHighlight
	document_sync_codec: document_parameter_error, required_object_field, required_string_field
	identity: DocumentUri, document_uri
	json: JsonValue(JsonNull, JsonNumber, JsonObject, JsonString, JsonVector), get_field
	json_rpc:
		JsonRpcEnvelope,
		decode_lsp_json_rpc_body,
		integer_from_json,
		json_rpc_error_value,
		json_rpc_method,
		json_rpc_parameters,
		json_rpc_request_id,
		json_rpc_success_value,
	position: ProtocolPosition, ProtocolRange
	protocol:
		ProtocolError(MissingRequestId, UnknownMethod),
		ProtocolFailure,
		ProtocolInputOutcome(ProtocolInputAccepted, ProtocolInputIgnored, ProtocolInputRejected),
		ProtocolResponse(ProtocolErrorResponse, ProtocolSuccessResponse),
		RequestId,


private DOCUMENT_HIGHLIGHT_METHOD: String = "textDocument/documentHighlight"


record DocumentHighlightRequest {
	id: RequestId,
	uri: DocumentUri,
	position: ProtocolPosition
}


pure func document_highlight_method() -> String:
	DOCUMENT_HIGHLIGHT_METHOD


private pure func document_highlight_parameter_error(detail: String) -> ProtocolError:
	document_parameter_error(DOCUMENT_HIGHLIGHT_METHOD, detail)


private pure func required_nonnegative_integer_field(
	value: JsonValue,
	name: String,
) -> Result[Int, ProtocolError]:
	match get_field(value, name):
		None:
			Err(document_highlight_parameter_error("missing required `${name}` integer"))
		Some(field):
			match integer_from_json(field):
				None:
					Err(
						document_highlight_parameter_error(
							"`${name}` must be a signed 32-bit integer",
						),
					)
				Some(integer):
					if integer < 0:
						Err(document_highlight_parameter_error("`${name}` must be non-negative"))
					else:
						Ok(integer)


private pure func required_protocol_position(
	value: JsonValue,
) -> Result[ProtocolPosition, ProtocolError]:
	line ?= required_nonnegative_integer_field(value, "line")
	character ?= required_nonnegative_integer_field(value, "character")
	Ok({
		line = line,
		utf16_character = character,
	})


private pure func decode_document_highlight_parameters(
	params: JsonValue,
) -> Result[(DocumentUri, ProtocolPosition), ProtocolError]:
	match params:
		JsonObject(_):
			text_document ?= required_object_field(
				params,
				"textDocument",
				DOCUMENT_HIGHLIGHT_METHOD,
			)
			uri ?= required_string_field(text_document, "uri", DOCUMENT_HIGHLIGHT_METHOD)
			position_value ?= required_object_field(params, "position", DOCUMENT_HIGHLIGHT_METHOD)
			query_position ?= required_protocol_position(position_value)
			Ok((document_uri(uri), query_position))
		_:
			Err(document_highlight_parameter_error("params must be an object"))


pure func decode_lsp_document_highlight_envelope(
	envelope: JsonRpcEnvelope,
) -> ProtocolInputOutcome[DocumentHighlightRequest]:
	method = json_rpc_method(envelope)
	request_id = json_rpc_request_id(envelope)

	if method != DOCUMENT_HIGHLIGHT_METHOD:
		match request_id:
			Some(_):
				ProtocolInputRejected({
					request_id = request_id,
					error = UnknownMethod(method),
				})
			None:
				ProtocolInputIgnored(UnknownMethod(method))
	else:
		match request_id:
			None:
				ProtocolInputIgnored(MissingRequestId(DOCUMENT_HIGHLIGHT_METHOD))
			Some(id):
				match json_rpc_parameters(envelope):
					None:
						ProtocolInputRejected({
							request_id = Some(id),
							error = document_highlight_parameter_error(
								"missing required params object",
							),
						})
					Some(params):
						match decode_document_highlight_parameters(params):
							Err(error):
								ProtocolInputRejected({
									request_id = Some(id),
									error = error,
								})
							Ok(query):
								ProtocolInputAccepted({
									id = id,
									uri = query[0],
									position = query[1],
								})


pure func decode_lsp_document_highlight_request(
	body: String,
) -> ProtocolInputOutcome[DocumentHighlightRequest]:
	match decode_lsp_json_rpc_body(body):
		Err(failure):
			ProtocolInputRejected(failure)
		Ok(envelope):
			decode_lsp_document_highlight_envelope(envelope)


private pure func position_json(position: ProtocolPosition) -> JsonValue:
	JsonObject([
		("line", JsonNumber(to_float(position.line))),
		("character", JsonNumber(to_float(position.utf16_character))),
	])


private pure func range_json(range: ProtocolRange) -> JsonValue:
	JsonObject([
		("start", position_json(range.start)),
		("end", position_json(range.end)),
	])


private pure func document_highlight_json(highlight: DocumentHighlight) -> JsonValue:
	JsonObject([("range", range_json(highlight.range))])


private pure func document_highlights_result_json(highlights: List[DocumentHighlight]) -> JsonValue:
	JsonVector(highlights.map(document_highlight_json))


pure func encode_lsp_document_highlight_response(
	response: ProtocolResponse[Option[List[DocumentHighlight]], ProtocolFailure],
) -> String:
	match response:
		ProtocolSuccessResponse(id, highlights):
			result: JsonValue = match highlights:
				Some(found):
					document_highlights_result_json(found)
				None:
					JsonNull

			json_rpc_success_value(id, result).to_string()
		ProtocolErrorResponse(failure):
			json_rpc_error_value(failure).to_string()
