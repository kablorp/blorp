-- Pure hover lookup over one immutable semantic-index snapshot.
-- Hover resolves an exact compiler-issued symbol and renders the typed display
-- projection produced while the compiler builds the semantic index.
import:
	analysis_model:
		ModuleSemanticIndex,
		SemanticIndexSnapshot,
		SemanticIndexState(CurrentSemanticIndex, SemanticIndexUnavailable, StaleSemanticIndex),
		SemanticSymbolId,
		module_semantic_index_definition,
		module_semantic_index_symbol_at,
		module_semantic_index_uri,
	hover_model: HoverInfo
	identity: DocumentUri, document_uri_value
	position: ProtocolPosition


union HoverQueryResult:
	HoverQueryInfo(HoverInfo)
	HoverQueryUnavailable


private pure func module_uri_is(module: ModuleSemanticIndex, uri: DocumentUri) -> Bool:
	document_uri_value(module_semantic_index_uri(module)) == document_uri_value(uri)


private pure func module_for_uri(
	modules: List[ModuleSemanticIndex],
	uri: DocumentUri,
) -> Option[ModuleSemanticIndex]:
	modules.find(func(module): module_uri_is(module, uri))


private pure func definition_in_modules(
	modules: List[ModuleSemanticIndex],
	symbol: SemanticSymbolId,
) -> Option[HoverInfo]:
	var found: Option[HoverInfo] = None

	for module in modules:
		match module_semantic_index_definition(module, symbol):
			Some(definition):
				found = Some({
					contents = definition.hover_contents,
					range = definition.selection_range,
				})
			None:
				found = found

	found


private pure func hover_from_snapshot(
	index: SemanticIndexSnapshot,
	uri: DocumentUri,
	position: ProtocolPosition,
) -> HoverQueryResult:
	match module_for_uri(index.modules, uri):
		None:
			HoverQueryUnavailable
		Some(module):
			match module_semantic_index_symbol_at(module, uri, position):
				None:
					HoverQueryUnavailable
				Some(symbol):
					match definition_in_modules(index.modules, symbol):
						Some(hover):
							HoverQueryInfo(hover)
						None:
							HoverQueryUnavailable


pure func hover_query_snapshot(
	semantic_index: SemanticIndexState,
	uri: DocumentUri,
	position: ProtocolPosition,
) -> HoverQueryResult:
	match semantic_index:
		CurrentSemanticIndex(index):
			hover_from_snapshot(index, uri, position)
		StaleSemanticIndex(_, _):
			HoverQueryUnavailable
		SemanticIndexUnavailable(_):
			HoverQueryUnavailable
