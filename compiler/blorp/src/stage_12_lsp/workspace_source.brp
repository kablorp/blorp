-- Exact source selection over an immutable workspace snapshot.
--
-- This is the only boundary that chooses between an editor overlay and its
-- retained discovered layer. Compiler workers consume the selected value and
-- therefore cannot accidentally read disk after a revision has been stamped.
import:
	../stage_01_file_io/source: SourceFile
	../stage_04_modules/loaded_module:
		ModuleOrigin(NativePackageModule, SourcePackageModule, StdlibModule, UserModule),
		module_origins_equal,
	architecture:
		WorkspaceError(WorkspaceSourceIdentityConflict, WorkspaceSourceUnavailable),
		WorkspaceSnapshot,
	document_model: DocumentVersion, OpenedDocument, document_version_value
	fingerprint_model: ContentFingerprint
	identity: DocumentUri
	workspace_model:
		DiscoveredSourceLayer,
		DiscoveredSourceProvenance(
			DiskSource,
			NativePackageSource,
			SourcePackageSource,
			StandardLibrarySource,
		),
		DiscoveredSourceSnapshot,
		OpenDocumentSourceLayer,
		SelectedSourceProvenance(SelectedDiscoveredSource, SelectedOpenDocument),
		SourceLayers,
		SourceSnapshot,
		source_snapshot_content_fingerprint,
		source_snapshot_for_layers,
		source_snapshot_origin,
		source_snapshot_provenance,
		source_snapshot_source,
		source_snapshot_source_package,
		source_snapshot_uri,
	workspace_store:
		SourceStore,
		source_store,
		source_store_contains,
		source_store_from_values,
		source_store_get,
		source_store_remove,
		source_store_set,
		source_store_values,


private pure func source_fingerprint(source: SourceFile) -> ContentFingerprint:
	-- Using the immutable source string itself is collision-free. String value
	-- semantics share the allocation, so this does not duplicate the document.
	{value = source.text}


pure func discovered_source_layer(
	source: SourceFile,
	provenance: DiscoveredSourceProvenance,
) -> DiscoveredSourceLayer:
	{
		source = source,
		provenance = provenance,
		content_fingerprint = source_fingerprint(source)
	}


pure func open_document_source_layer(
	source: SourceFile,
	provenance: DiscoveredSourceProvenance,
	document_version: DocumentVersion,
) -> OpenDocumentSourceLayer:
	{
		source = source,
		provenance = provenance,
		document_version = document_version,
		content_fingerprint = source_fingerprint(source)
	}


pure func source_layers(
	uri: DocumentUri,
	discovered_source: Option[DiscoveredSourceLayer],
	open_document: Option[OpenDocumentSourceLayer],
) -> SourceLayers:
	{
		uri = uri,
		discovered_source = discovered_source,
		open_document = open_document
	}


private pure func normalized_discovered_source(
	discovered: DiscoveredSourceSnapshot,
) -> DiscoveredSourceSnapshot:
	{ discovered |
		layer = discovered_source_layer(discovered.layer.source, discovered.layer.provenance)
	}


pure func source_layers_from_discovered(
	discovered_sources: List[DiscoveredSourceSnapshot],
) -> Result[SourceStore, WorkspaceError]:
	values = discovered_sources.map(func(discovered):
		normalized = normalized_discovered_source(discovered)
		source_layers(normalized.uri, Some(normalized.layer), None)
	)

	match source_store_from_values(values):
		Ok(sources):
			Ok(sources)
		Err(uri):
			Err(WorkspaceSourceIdentityConflict(uri))


pure func source_layers_for_uri(sources: SourceStore, uri: DocumentUri) -> Option[SourceLayers]:
	source_store_get(sources, uri)


pure func set_open_document_source(
	sources: SourceStore,
	opened: OpenedDocument,
	source: SourceFile,
	provenance: DiscoveredSourceProvenance,
) -> SourceStore:
	existing = source_layers_for_uri(sources, opened.document.uri)
	open_document = open_document_source_layer(
		{ source | text = opened.document.text },
		provenance,
		opened.document.version,
	)

	match existing:
		None:
			source_store_set(
				sources,
				source_layers(opened.document.uri, None, Some(open_document)),
			)
		Some(layers):
			source_store_set(sources, { layers | open_document = Some(open_document) })


pure func update_open_document_source(
	sources: SourceStore,
	opened: OpenedDocument,
) -> Option[SourceStore]:
	layers ?= source_layers_for_uri(sources, opened.document.uri)
	current ?= layers.open_document
	open_document = open_document_source_layer(
		{ current.source | text = opened.document.text },
		current.provenance,
		opened.document.version,
	)
	Some(source_store_set(sources, { layers | open_document = Some(open_document) }))


private pure func rebase_open_document_source(
	open_document: OpenDocumentSourceLayer,
	discovered: DiscoveredSourceLayer,
) -> OpenDocumentSourceLayer:
	open_document_source_layer(
		{ discovered.source | text = open_document.source.text },
		discovered.provenance,
		open_document.document_version,
	)


pure func close_open_document_source(sources: SourceStore, uri: DocumentUri) -> SourceStore:
	match source_store_get(sources, uri):
		None:
			sources
		Some(layers):
			match layers.discovered_source:
				Some(_):
					source_store_set(sources, { layers | open_document = None })
				None:
					source_store_remove(sources, uri)


pure func set_discovered_source(
	sources: SourceStore,
	discovered: DiscoveredSourceSnapshot,
) -> SourceStore:
	normalized = normalized_discovered_source(discovered)

	match source_layers_for_uri(sources, normalized.uri):
		None:
			source_store_set(
				sources,
				source_layers(normalized.uri, Some(normalized.layer), None),
			)
		Some(layers):
			rebased_open = layers.open_document.map(func(open_document):
				rebase_open_document_source(open_document, normalized.layer)
			)
			source_store_set(
				sources,
				{ layers |
					discovered_source = Some(normalized.layer),
					open_document = rebased_open
				},
			)


pure func remove_discovered_source(sources: SourceStore, uri: DocumentUri) -> SourceStore:
	match source_store_get(sources, uri):
		None:
			sources
		Some(layers):
			match layers.open_document:
				Some(_):
					source_store_set(sources, { layers | discovered_source = None })
				None:
					source_store_remove(sources, uri)


pure func select_source(layers: SourceLayers) -> Option[SourceSnapshot]:
	source_snapshot_for_layers(layers)


pure func selected_source(sources: SourceStore, uri: DocumentUri) -> Option[SourceSnapshot]:
	match source_layers_for_uri(sources, uri):
		Some(layers):
			select_source(layers)
		None:
			None


pure func selected_compiler_input_changed(
	before: SourceStore,
	after: SourceStore,
	uri: DocumentUri,
) -> Bool:
	match selected_source(before, uri):
		None:
			selected_source(after, uri).is_some()
		Some(before_source):
			match selected_source(after, uri):
				None:
					True
				Some(after_source):
					before_compiler_source = source_snapshot_source(before_source)
					after_compiler_source = source_snapshot_source(after_source)
					not ((
						source_snapshot_uri(before_source) == source_snapshot_uri(after_source)
						and before_compiler_source.path == after_compiler_source.path
						and before_compiler_source.module_name == after_compiler_source.module_name
						and before_compiler_source.text == after_compiler_source.text
						and module_origins_equal(
							source_snapshot_origin(before_source),
							source_snapshot_origin(after_source),
						)
						and source_snapshot_content_fingerprint(
							before_source,
						).value == source_snapshot_content_fingerprint(after_source).value
					))


private pure func discovered_provenance_equal(
	left: DiscoveredSourceProvenance,
	right: DiscoveredSourceProvenance,
) -> Bool:
	match (left, right):
		(DiskSource, DiskSource):
			True
		(StandardLibrarySource, StandardLibrarySource):
			True
		(NativePackageSource(left_id), NativePackageSource(right_id)):
			left_id == right_id
		(SourcePackageSource(left_package), SourcePackageSource(right_package)):
			(
				left_package.package_alias == right_package.package_alias
				and left_package.package_name == right_package.package_name
				and left_package.source_dir == right_package.source_dir
				and left_package.exports == right_package.exports
			)
		_:
			False


private pure func selected_provenance_equal(
	left: SelectedSourceProvenance,
	right: SelectedSourceProvenance,
) -> Bool:
	match (left, right):
		(SelectedOpenDocument(left_version), SelectedOpenDocument(right_version)):
			document_version_value(left_version) == document_version_value(right_version)
		(SelectedDiscoveredSource(left_source), SelectedDiscoveredSource(right_source)):
			discovered_provenance_equal(left_source, right_source)
		_:
			False


pure func source_snapshots_equal(left: SourceSnapshot, right: SourceSnapshot) -> Bool:
	left_source = source_snapshot_source(left)
	right_source = source_snapshot_source(right)

	(
		source_snapshot_uri(left) == source_snapshot_uri(right)
		and left_source.path == right_source.path
		and left_source.module_name == right_source.module_name
		and left_source.text == right_source.text
		and module_origins_equal(source_snapshot_origin(left), source_snapshot_origin(right))
		and source_snapshot_source_package(left) == source_snapshot_source_package(right)
		and selected_provenance_equal(
			source_snapshot_provenance(left),
			source_snapshot_provenance(right),
		)
		and source_snapshot_content_fingerprint(
			left,
		).value == source_snapshot_content_fingerprint(right).value
	)


pure func selected_compiler_identity_changed(
	before: SourceStore,
	after: SourceStore,
	uri: DocumentUri,
) -> Bool:
	match selected_source(before, uri):
		None:
			selected_source(after, uri).is_some()
		Some(before_source):
			match selected_source(after, uri):
				None:
					True
				Some(after_source):
					before_compiler_source = source_snapshot_source(before_source)
					after_compiler_source = source_snapshot_source(after_source)
					not ((
						source_snapshot_uri(before_source) == source_snapshot_uri(after_source)
						and before_compiler_source.path == after_compiler_source.path
						and before_compiler_source.module_name == after_compiler_source.module_name
						and module_origins_equal(
							source_snapshot_origin(before_source),
							source_snapshot_origin(after_source),
						)
					))


pure func reconciled_configuration_sources(
	current_sources: SourceStore,
	discovered_sources: SourceStore,
) -> SourceStore:
	var reconciled: SourceStore = source_store()

	for discovered in source_store_values(discovered_sources):
		next = match source_store_get(current_sources, discovered.uri):
			Some(current):
				match current.open_document:
					Some(open_document):
						match discovered.discovered_source:
							Some(layer):
								rebased_open = rebase_open_document_source(open_document, layer)
								{ discovered | open_document = Some(rebased_open) }
							None:
								{ discovered | open_document = Some(open_document) }
					None:
						discovered
			None:
				discovered

		reconciled = source_store_set(reconciled, next)

	for current in source_store_values(current_sources):
		if not source_store_contains(discovered_sources, current.uri):
			match current.open_document:
				Some(_):
					next = { current | discovered_source = None }
					reconciled = source_store_set(reconciled, next)
				None:
					void

	reconciled


pure func source_for_uri(
	workspace: WorkspaceSnapshot,
	uri: DocumentUri,
) -> Result[SourceSnapshot, WorkspaceError]:
	match source_store_get(workspace.compiler.sources, uri):
		Some(layers):
			if layers.uri != uri:
				Err(WorkspaceSourceIdentityConflict(uri))
			else:
				match select_source(layers):
					Some(source):
						Ok(source)
					None:
						Err(WorkspaceSourceUnavailable(uri))
		None:
			Err(WorkspaceSourceUnavailable(uri))
