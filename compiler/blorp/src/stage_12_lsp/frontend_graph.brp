-- Immutable LSP source-provider adapter for compiler-owned graph discovery.
--
-- Every candidate comes from the selected source layer of one workspace
-- revision. Resolution never reads disk, so an open overlay remains the exact
-- compiler input throughout discovery, parsing, and edge construction.
import:
	../stage_03_parse/source_ast_finalize: finalized_typecheck_program_ast
	../stage_04_modules/frontend_graph:
		CompilerFrontendGraph,
		CompilerFrontendImportEdge,
		CompilerFrontendModule,
		compiler_frontend_graph_import_edges,
		compiler_frontend_graph_modules,
	../stage_04_modules/frontend_graph_service:
		CompilerFrontendSourceCandidate,
		CompilerFrontendSourceResolution(
			CompilerFrontendSourceResolved,
			CompilerFrontendSourceUnresolved,
		),
		compiler_frontend_discovery_error_message,
		compiler_frontend_graph_discover,
		compiler_frontend_implicit_module_paths,
		compiler_frontend_source_candidate,
	../stage_04_modules/frontend_import_plan:
		CompilerFrontendImportLookup(
			CompilerFrontendLocalPathLookup,
			CompilerFrontendNativePackageLookup,
			CompilerFrontendRelativePathLookup,
			CompilerFrontendSourcePackageAliasLookup,
			CompilerFrontendSourcePackageInternalLookup,
			CompilerFrontendStandardLibraryLookup,
		),
		compiler_frontend_import_lookup_plan,
	../stage_04_modules/loaded_module:
		CompilerModuleOrigin(
			CompilerNativePackageModule,
			CompilerSourcePackageModule,
			CompilerStdlibModule,
		),
		CompilerResolvedModuleIdentity,
		compiler_module_origins_equal,
		compiler_resolved_module_canonical_path,
		compiler_resolved_module_identities_equal,
		compiler_resolved_module_identity_from_resolver,
		compiler_resolved_module_origin,
	../stage_04_modules/source_package_layout:
		CompilerSourcePackageLayout,
		compiler_source_package_contains_internal_module,
		compiler_source_package_export_for_alias,
		compiler_source_package_path_for_module,
	identity: DocumentUri
	workspace_model:
		ModuleDependencyState(ResolvedDependencies),
		ResolvedModuleDependencies,
		SourceSnapshot,
		source_snapshot_origin,
		source_snapshot_source,
		source_snapshot_source_package,
		source_snapshot_uri,
	workspace_source: select_source
	workspace_store: DependencyStore, SourceStore, dependency_store_from_values, source_store_values


record FrontendGraphSnapshot {
	graph: CompilerFrontendGraph,
	dependencies: DependencyStore
}


union FrontendGraphError:
	FrontendGraphDiscoveryFailed(String)
	FrontendGraphDuplicateDependencyUri(DocumentUri)
	FrontendGraphMissingModuleSource(String)
	FrontendGraphAmbiguousModuleSource(String)


private record FrontendCandidate {
	uri: DocumentUri,
	compiler: CompilerFrontendSourceCandidate,
	source_package: Option[CompilerSourcePackageLayout]
}


private pure func frontend_candidate(source: SourceSnapshot) -> FrontendCandidate:
	compiler_source = source_snapshot_source(source)
	identity = compiler_resolved_module_identity_from_resolver(
		compiler_source.module_name,
		source_snapshot_origin(source),
	)
	{
		uri = source_snapshot_uri(source),
		compiler = compiler_frontend_source_candidate(identity, compiler_source),
		source_package = source_snapshot_source_package(source)
	}


private pure func selected_candidates(sources: SourceStore) -> List[FrontendCandidate]:
	source_store_values(sources).filter_map(func(layers):
		select_source(layers).map(frontend_candidate)
	)


private pure func implicit_compiler_candidates(
	candidates: List[FrontendCandidate],
	roots: List[CompilerFrontendSourceCandidate],
) -> List[CompilerFrontendSourceCandidate]:
	implicit_paths = compiler_frontend_implicit_module_paths()

	candidates.filter_map(func(candidate):
		origin = compiler_resolved_module_origin(candidate.compiler.identity)
		path = compiler_resolved_module_canonical_path(candidate.compiler.identity)
		already_root = roots.any(func(root):
			compiler_resolved_module_identities_equal(root.identity, candidate.compiler.identity)
		)

		if (
			origin == CompilerStdlibModule
			and implicit_paths.contains(path)
			and not already_root
		):
			Some(candidate.compiler)
		else:
			None
	)


private pure func root_candidates(
	candidates: List[FrontendCandidate],
	roots: List[CompilerResolvedModuleIdentity],
) -> Result[List[CompilerFrontendSourceCandidate], FrontendGraphError]:
	var selected: List[CompilerFrontendSourceCandidate] = []
	var error: Option[FrontendGraphError] = None

	for root in roots:
		if error.is_none():
			matches = candidates.filter(func(candidate):
				compiler_resolved_module_identities_equal(candidate.compiler.identity, root)
			)

			match matches:
				[]:
					error = Some(
						FrontendGraphMissingModuleSource(
							compiler_resolved_module_canonical_path(root),
						),
					)
				[candidate]:
					selected = selected.append(candidate.compiler)
				_:
					error = Some(
						FrontendGraphAmbiguousModuleSource(
							compiler_resolved_module_canonical_path(root),
						),
					)

	match error:
		Some(found):
			Err(found)
		None:
			Ok(selected)


private pure func candidates_with_canonical_path(
	candidates: List[FrontendCandidate],
	canonical_path: String,
) -> List[FrontendCandidate]:
	candidates.filter(func(candidate):
		compiler_resolved_module_canonical_path(candidate.compiler.identity) == canonical_path
	)


private pure func candidates_with_source_path(
	candidates: List[FrontendCandidate],
	source_path: String,
) -> List[FrontendCandidate]:
	candidates.filter(func(candidate): candidate.compiler.source.path == source_path)


private pure func unique_resolution(
	candidates: List[FrontendCandidate],
	description: String,
) -> Result[Option[CompilerFrontendSourceCandidate], String]:
	match candidates:
		[]:
			Ok(None)
		[found]:
			Ok(Some(found.compiler))
		_:
			Err("ambiguous compiler frontend import target for " + description)


private pure func candidates_with_origin(
	candidates: List[FrontendCandidate],
	origin: CompilerModuleOrigin,
) -> List[FrontendCandidate]:
	candidates.filter(func(candidate):
		compiler_module_origins_equal(
			compiler_resolved_module_origin(candidate.compiler.identity),
			origin,
		)
	)


private pure func candidate_is_native_package(candidate: FrontendCandidate) -> Bool:
	match compiler_resolved_module_origin(candidate.compiler.identity):
		CompilerNativePackageModule(_):
			True
		_:
			False


private pure func candidate_with_canonical_module(
	candidate: FrontendCandidate,
	canonical_module: String,
) -> CompilerFrontendSourceCandidate:
	origin = compiler_resolved_module_origin(candidate.compiler.identity)
	compiler_frontend_source_candidate(
		compiler_resolved_module_identity_from_resolver(canonical_module, origin),
		{ candidate.compiler.source | module_name = canonical_module },
	)


private pure func source_package_alias_candidate(
	candidates: List[FrontendCandidate],
	requested_path: String,
) -> Result[Option[CompilerFrontendSourceCandidate], String]:
	var matches: List[CompilerFrontendSourceCandidate] = []

	for candidate in candidates:
		match candidate.source_package:
			Some(package):
				match compiler_source_package_export_for_alias(package, requested_path):
					Some(package_module):
						if candidate.compiler.source.path == compiler_source_package_path_for_module(
							package,
							package_module,
						):
							matches = matches.append(
								candidate_with_canonical_module(
									candidate,
									requested_path,
								),
							)
					None:
						void
			None:
				void

	match matches:
		[]:
			Ok(None)
		[found]:
			Ok(Some(found))
		_:
			Err("ambiguous source package export `" + requested_path + "`")


private pure func source_package_internal_candidate(
	candidates: List[FrontendCandidate],
	package_alias: String,
	module_path: String,
) -> Result[Option[CompilerFrontendSourceCandidate], String]:
	matches = candidates.filter(func(candidate):
		match candidate.source_package:
			Some(package):
				(
					package.package_alias == package_alias
					and compiler_source_package_contains_internal_module(package, module_path)
					and candidate.compiler.source.path == compiler_source_package_path_for_module(
						package,
						module_path,
					)
				)
			None:
				False
	)

	match matches:
		[]:
			Ok(None)
		[found]:
			Ok(Some(candidate_with_canonical_module(found, module_path)))
		_:
			Err("ambiguous source package module `" + module_path + "`")


private pure func candidate_for_lookup(
	candidates: List[FrontendCandidate],
	lookup: CompilerFrontendImportLookup,
) -> Result[Option[CompilerFrontendSourceCandidate], String]:
	match lookup:
		CompilerFrontendNativePackageLookup(canonical_path):
			native_candidates = candidates_with_canonical_path(
				candidates,
				canonical_path,
			).filter(candidate_is_native_package)
			unique_resolution(native_candidates, "native package module `" + canonical_path + "`")
		CompilerFrontendStandardLibraryLookup(canonical_path):
			unique_resolution(
				candidates_with_origin(
					candidates_with_canonical_path(candidates, canonical_path),
					CompilerStdlibModule,
				),
				"standard library module `" + canonical_path + "`",
			)
		CompilerFrontendRelativePathLookup(source_path, confinement_origin):
			path_candidates = candidates_with_source_path(candidates, source_path)

			confined = match confinement_origin:
				CompilerSourcePackageModule(package_alias):
					candidates_with_origin(
						path_candidates,
						CompilerSourcePackageModule(package_alias),
					)
				_:
					path_candidates

			unique_resolution(confined, "path `" + source_path + "`")
		CompilerFrontendSourcePackageAliasLookup(canonical_path):
			source_package_alias_candidate(candidates, canonical_path)
		CompilerFrontendSourcePackageInternalLookup(package_alias, canonical_path):
			source_package_internal_candidate(candidates, package_alias, canonical_path)
		CompilerFrontendLocalPathLookup(source_path):
			unique_resolution(
				candidates_with_source_path(candidates, source_path),
				"path `" + source_path + "`",
			)


private pure func resolve_selected_candidate(
	candidates: List[FrontendCandidate],
	importer: CompilerFrontendSourceCandidate,
	requested_path: String,
) -> Result[CompilerFrontendSourceResolution, String]:
	var resolution: Option[CompilerFrontendSourceCandidate] = None
	var error: Option[String] = None

	for lookup in compiler_frontend_import_lookup_plan(importer, requested_path):
		if resolution.is_none() and error.is_none():
			match candidate_for_lookup(candidates, lookup):
				Err(message):
					error = Some(message)
				Ok(Some(candidate)):
					resolution = Some(candidate)
				Ok(None):
					void

	match error:
		Some(message):
			Err(message)
		None:
			match resolution:
				Some(candidate):
					Ok(CompilerFrontendSourceResolved(candidate))
				None:
					Ok(CompilerFrontendSourceUnresolved)


private pure func resolved_dependencies(
	graph: CompilerFrontendGraph,
	candidates: List[FrontendCandidate],
) -> Result[DependencyStore, FrontendGraphError]:
	edges = compiler_frontend_graph_import_edges(graph)
	var states: List[ModuleDependencyState] = []
	var error: Option[FrontendGraphError] = None

	for module in compiler_frontend_graph_modules(graph):
		if error.is_none():
			program = finalized_typecheck_program_ast(module.program)
			backing = candidates.filter(func(candidate):
				(
					candidate.compiler.source.path == program.source.path
					and candidate.compiler.source.text == program.source.text
				)
			)

			match backing:
				[]:
					error = Some(FrontendGraphMissingModuleSource(program.source.path))
				[candidate]:
					module_edges = edges.filter(func(edge):
						compiler_resolved_module_identities_equal(edge.importer, module.identity)
					)
					resolved: ResolvedModuleDependencies = {
						uri = candidate.uri,
						module_identity = module.identity,
						import_edges = module_edges
					}
					states = states.append(ResolvedDependencies(resolved))
				_:
					error = Some(FrontendGraphAmbiguousModuleSource(program.source.path))

	match error:
		Some(found):
			Err(found)
		None:
			match dependency_store_from_values(states):
				Ok(store):
					Ok(store)
				Err(uri):
					Err(FrontendGraphDuplicateDependencyUri(uri))


func frontend_graph_for_roots(
	sources: SourceStore,
	roots: List[CompilerResolvedModuleIdentity],
) -> Result[FrontendGraphSnapshot, FrontendGraphError]:
	candidates = selected_candidates(sources)
	compiler_roots ?= root_candidates(candidates, roots)
	implicit_candidates = implicit_compiler_candidates(candidates, compiler_roots)

	match (
		compiler_frontend_graph_discover(compiler_roots, implicit_candidates, func(
			importer,
			requested_path,
		):
			resolve_selected_candidate(candidates, importer, requested_path)
		)
	):
		Err(error):
			Err(FrontendGraphDiscoveryFailed(compiler_frontend_discovery_error_message(error)))
		Ok(graph):
			dependencies ?= resolved_dependencies(graph, candidates)
			Ok({
				graph = graph,
				dependencies = dependencies,
			})


-- Compatibility entry point for callers that intentionally treat every source
-- as a root. Production LSP analysis uses frontend_graph_for_roots so the
-- catalog remains a candidate set rather than compulsory compiler work.
func frontend_graph_for_sources(
	sources: SourceStore,
) -> Result[FrontendGraphSnapshot, FrontendGraphError]:
	candidates = selected_candidates(sources)
	frontend_graph_for_roots(
		sources,
		candidates.map(func(candidate): candidate.compiler.identity),
	)
