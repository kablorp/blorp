-- Data crossing the serialized server actor boundary. These unions contain no
-- effect interpretation so tests and future transport/worker loops share one
-- closed vocabulary without importing the actor's private state.
import:
	lsp_architecture:
		LspAnalysisCompletion,
		LspCancellationToken,
		LspCompilerAnalysisRequest,
		LspWorkspaceError,
	lsp_diagnostic_model: LspDiagnosticPublication
	lsp_document_model: LspOpenedDocument
	lsp_identity: LspDocumentUri
	lsp_json_rpc: LspJsonRpcEnvelope
	lsp_lifecycle_model: LspExitStatus
	lsp_snapshot_model: LspSnapshotIdentity
	lsp_source_loader:
		LspFatalSourceLoadError,
		LspOpenSourceResolutionError,
		LspSavedSourceRefreshError,
		LspSourceLoadIssue,
		LspSourceLoadRequest,
	lsp_workspace: LspWorkspace
	lsp_workspace_model: LspDiscoveredSourceSnapshot, LspResolvedDocumentOpen


-- Source loading is asynchronous. An opaque scalar identity prevents a delayed
-- completion from an earlier initialize attempt from satisfying a later retry.
opaque type LspSourceLoadToken = Int


pure func lsp_source_load_token(value: Int) -> LspSourceLoadToken:
	into LspSourceLoadToken(value)


pure func lsp_source_load_token_value(token: LspSourceLoadToken) -> Int:
	from LspSourceLoadToken(token)


opaque type LspDocumentEffectToken = Int


pure func lsp_document_effect_token(value: Int) -> LspDocumentEffectToken:
	into LspDocumentEffectToken(value)


pure func lsp_document_effect_token_value(token: LspDocumentEffectToken) -> Int:
	from LspDocumentEffectToken(token)


union LspDocumentSyncIssue:
	LspDocumentOpenResolutionIssue(LspDocumentUri, LspOpenSourceResolutionError)
	LspSavedSourceRefreshIssue(LspDocumentUri, LspSavedSourceRefreshError)
	LspDocumentWorkspaceIssue(LspWorkspaceError)


union LspServerEvent:
	LspServerClientEnvelope(LspJsonRpcEnvelope)
	LspServerSourceLoadSucceeded(LspSourceLoadToken, LspWorkspace, List[LspSourceLoadIssue])
	LspServerSourceLoadFailed(LspSourceLoadToken, LspFatalSourceLoadError)
	LspServerDocumentOpenResolved(LspDocumentEffectToken, LspResolvedDocumentOpen)
	LspServerDocumentOpenResolutionFailed(LspDocumentEffectToken, LspDocumentUri, LspOpenSourceResolutionError)
	LspServerSavedSourceUpdated(LspDocumentEffectToken, LspDiscoveredSourceSnapshot)
	LspServerSavedSourceRemoved(LspDocumentEffectToken, LspDocumentUri)
	LspServerSavedSourceRefreshFailed(LspDocumentEffectToken, LspDocumentUri, LspSavedSourceRefreshError)
	LspServerAnalysisCompleted(LspAnalysisCompletion)


-- For document filesystem effects, the interpreter reads configuration from
-- the accompanying ready state and completes the command before dequeuing the
-- next client event. This preserves didOpen/change and didSave/close ordering.
union LspServerEffect:
	LspLoadWorkspace(LspSourceLoadToken, LspSourceLoadRequest)
	LspResolveOpenDocument(LspDocumentEffectToken, LspOpenedDocument)
	LspRefreshSavedSource(LspDocumentEffectToken, LspDocumentUri)
	LspReportSourceLoadIssues(List[LspSourceLoadIssue])
	LspReportDocumentSyncIssue(LspDocumentSyncIssue)
	LspSendMessage(String)
	LspOperationalEnvelopeReady(LspJsonRpcEnvelope)
	LspExitServer(LspExitStatus)
	LspStartAnalysis(LspCompilerAnalysisRequest)
	LspCancelAnalysis(LspCancellationToken)
	LspPublishDiagnostics(LspDiagnosticPublication)
	LspClearDiagnostics(LspSnapshotIdentity)
	LspAnalysisPlanningFailed(LspWorkspaceError)
	LspAnalysisCompletionRejected(LspWorkspaceError)
