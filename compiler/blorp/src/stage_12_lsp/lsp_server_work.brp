-- Immutable work emitted by serialized server-state transitions.
--
-- Parsing and typechecking do not run inside the protocol reducer. A server loop
-- may execute analysis concurrently, but its embedded snapshot identity must
-- pass the canonical publication guard after completion. Clear requests remain
-- URI-scoped and are emitted only if serialized state still considers them safe.
import:
	lsp_diagnostic_model: LspDiagnosticClearRequest
	lsp_document_model: LspVersionedDocumentText
	lsp_snapshot_model:
		LspConfigurationEpoch,
		LspSnapshotIdentity,
		LspWorkspaceRevision,
		lsp_snapshot_identity,


private record LspDocumentAnalysisRequestRep {
	identity: LspSnapshotIdentity,
	document: LspVersionedDocumentText
}


opaque type LspDocumentAnalysisRequest = LspDocumentAnalysisRequestRep


pure func lsp_document_analysis_request(
	document: LspVersionedDocumentText,
	workspace_revision: LspWorkspaceRevision,
	configuration_epoch: LspConfigurationEpoch,
) -> LspDocumentAnalysisRequest:
	into LspDocumentAnalysisRequest({
		identity = lsp_snapshot_identity(
			document.uri,
			Some(document.version),
			workspace_revision,
			configuration_epoch,
		),
		document = document,
	})


pure func lsp_document_analysis_identity(
	request: LspDocumentAnalysisRequest,
) -> LspSnapshotIdentity:
	from LspDocumentAnalysisRequest(request).identity


pure func lsp_document_analysis_document(
	request: LspDocumentAnalysisRequest,
) -> LspVersionedDocumentText:
	from LspDocumentAnalysisRequest(request).document


union LspServerWork:
	LspAnalyzeDocument(LspDocumentAnalysisRequest)
	LspClearDocumentDiagnostics(LspDiagnosticClearRequest)
