-- Decoder for the LSP exit notification.
--
-- Exit never sends a response. The lifecycle dispatcher converts an accepted
-- notification into a typed process-exit action after checking whether shutdown
-- was previously accepted.
import:
	json: JsonValue(JsonNull)
	lsp_json_rpc:
		LspJsonRpcEnvelope,
		decode_lsp_json_rpc_body,
		lsp_json_rpc_method,
		lsp_json_rpc_parameters,
		lsp_json_rpc_request_id,
	lsp_protocol:
		LspProtocolError(LspInvalidMethodParameters, LspUnexpectedRequestId, LspUnknownMethod),
		LspProtocolInputOutcome(
			LspProtocolInputAccepted,
			LspProtocolInputIgnored,
			LspProtocolInputRejected,
		),


private LSP_EXIT_METHOD: String = "exit"


enum LspExitNotification:
	LspClientExit


pure func lsp_exit_method() -> String:
	LSP_EXIT_METHOD


private pure func exit_parameter_error() -> LspProtocolError:
	LspInvalidMethodParameters(LSP_EXIT_METHOD, "params must be omitted or null")


pure func decode_lsp_exit_envelope(
	envelope: LspJsonRpcEnvelope,
) -> LspProtocolInputOutcome[LspExitNotification]:
	method = lsp_json_rpc_method(envelope)
	request_id = lsp_json_rpc_request_id(envelope)

	if method != LSP_EXIT_METHOD:
		match request_id:
			Some(_):
				LspProtocolInputRejected({
					request_id = request_id,
					error = LspUnknownMethod(method),
				})
			None:
				LspProtocolInputIgnored(LspUnknownMethod(method))
	else:
		match request_id:
			Some(_):
				LspProtocolInputRejected({
					request_id = request_id,
					error = LspUnexpectedRequestId(method),
				})
			None:
				match lsp_json_rpc_parameters(envelope):
					None:
						LspProtocolInputAccepted(LspClientExit)
					Some(JsonNull):
						LspProtocolInputAccepted(LspClientExit)
					Some(_):
						LspProtocolInputIgnored(exit_parameter_error())


pure func decode_lsp_exit_notification(
	body: String,
) -> LspProtocolInputOutcome[LspExitNotification]:
	match decode_lsp_json_rpc_body(body):
		Err(failure):
			LspProtocolInputRejected(failure)
		Ok(envelope):
			decode_lsp_exit_envelope(envelope)
