-- Decoder for the LSP exit notification.
--
-- Exit never sends a response. The lifecycle dispatcher converts an accepted
-- notification into a typed process-exit action after checking whether shutdown
-- was previously accepted.
import:
	json: JsonValue(JsonNull)
	json_rpc:
		JsonRpcEnvelope,
		decode_lsp_json_rpc_body,
		json_rpc_method,
		json_rpc_parameters,
		json_rpc_request_id,
	protocol:
		ProtocolError(InvalidMethodParameters, UnexpectedRequestId, UnknownMethod),
		ProtocolInputOutcome(ProtocolInputAccepted, ProtocolInputIgnored, ProtocolInputRejected),


private EXIT_METHOD: String = "exit"


enum ExitNotification:
	ClientExit


pure func exit_method() -> String:
	EXIT_METHOD


private pure func exit_parameter_error() -> ProtocolError:
	InvalidMethodParameters(EXIT_METHOD, "params must be omitted or null")


pure func decode_lsp_exit_envelope(
	envelope: JsonRpcEnvelope,
) -> ProtocolInputOutcome[ExitNotification]:
	method = json_rpc_method(envelope)
	request_id = json_rpc_request_id(envelope)

	if method != EXIT_METHOD:
		match request_id:
			Some(_):
				ProtocolInputRejected({
					request_id = request_id,
					error = UnknownMethod(method),
				})
			None:
				ProtocolInputIgnored(UnknownMethod(method))
	else:
		match request_id:
			Some(_):
				ProtocolInputRejected({
					request_id = request_id,
					error = UnexpectedRequestId(method),
				})
			None:
				match json_rpc_parameters(envelope):
					None:
						ProtocolInputAccepted(ClientExit)
					Some(JsonNull):
						ProtocolInputAccepted(ClientExit)
					Some(_):
						ProtocolInputIgnored(exit_parameter_error())


pure func decode_lsp_exit_notification(body: String) -> ProtocolInputOutcome[ExitNotification]:
	match decode_lsp_json_rpc_body(body):
		Err(failure):
			ProtocolInputRejected(failure)
		Ok(envelope):
			decode_lsp_exit_envelope(envelope)
