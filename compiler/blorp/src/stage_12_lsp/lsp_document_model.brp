-- Dependency-light document synchronization values shared by protocol codecs,
-- the overlay store, and the compiler-facing architecture.
import:
	lsp_identity: LspDocumentUri


-- Document versions are protocol integers, but remain distinct from workspace
-- revisions and configuration epochs throughout the compiler pipeline.
opaque type LspDocumentVersion = Int

private LSP_DOCUMENT_VERSION_MIN: Int = -2147483648

private LSP_DOCUMENT_VERSION_MAX: Int = 2147483647


pure func lsp_document_version(value: Int) -> Option[LspDocumentVersion]:
	if value < LSP_DOCUMENT_VERSION_MIN or value > LSP_DOCUMENT_VERSION_MAX:
		None
	else:
		Some(into LspDocumentVersion(value))


pure func lsp_document_version_value(version: LspDocumentVersion) -> Int:
	from LspDocumentVersion(version)


record LspVersionedDocumentText {
	uri: LspDocumentUri,
	version: LspDocumentVersion,
	text: String
}


-- An empty contentChanges array still advances the protocol version but has no
-- replacement text. Keeping that distinct from Some("") prevents a no-op from
-- accidentally clearing the editor overlay.
record LspDocumentChange {
	uri: LspDocumentUri,
	version: LspDocumentVersion,
	replacement_text: Option[String]
}


-- Save notifications do not carry a document version, so included text remains
-- event metadata and must not replace the authoritative versioned overlay.
record LspDocumentSave {
	uri: LspDocumentUri,
	text: Option[String]
}


-- language_id belongs to the open lifecycle rather than every text revision.
-- A client changes it by closing and reopening the document.
record LspOpenedDocument {
	document: LspVersionedDocumentText,
	language_id: String
}


union LspDocumentEvent:
	LspDocumentOpened(LspOpenedDocument)
	LspDocumentChanged(LspDocumentChange)
	LspDocumentSaved(LspDocumentSave)
	LspDocumentClosed(LspDocumentUri)
