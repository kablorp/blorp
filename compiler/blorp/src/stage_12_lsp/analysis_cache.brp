-- Fingerprint-checked access to unversioned compiler artifacts.
--
-- The underlying persistent stores retain only the newest artifact for a URI
-- or module identity. A lookup must still present the complete phase-specific
-- fingerprint, so a stale entry can never be mistaken for a cache hit.
import:
	../stage_04_modules/loaded_module: CompilerModuleIdentity, compiler_module_identities_equal
	analysis_model:
		LexedArtifact,
		ModuleAnalysisFingerprint,
		ParseFingerprint,
		ParsedArtifact,
		TypedArtifact,
		lexed_artifact_fingerprint,
		parsed_artifact_fingerprint,
		typed_artifact_fingerprint,
	indexed_store:
		ModuleStore,
		UriStore,
		module_store,
		module_store_get,
		module_store_remove,
		module_store_set,
		uri_store,
		uri_store_get,
		uri_store_remove,
		uri_store_set,
	snapshot_model: configuration_epoch_value


private record AnalysisCacheRep {
	lexed: UriStore[LexedArtifact],
	parsed: UriStore[ParsedArtifact],
	typed: ModuleStore[TypedArtifact]
}


opaque type AnalysisCacheSnapshot = AnalysisCacheRep


private pure func analysis_cache_rep(cache: AnalysisCacheSnapshot) -> AnalysisCacheRep:
	from AnalysisCacheSnapshot(cache)


pure func analysis_cache() -> AnalysisCacheSnapshot:
	representation: AnalysisCacheRep = {
		lexed = uri_store(),
		parsed = uri_store(),
		typed = module_store()
	}
	into AnalysisCacheSnapshot(representation)


pure func parse_fingerprints_equal(left: ParseFingerprint, right: ParseFingerprint) -> Bool:
	(
		left.uri == right.uri
		and left.source.value == right.source.value
		and left.frontend.value == right.frontend.value
	)


pure func module_analysis_fingerprints_equal(
	left: ModuleAnalysisFingerprint,
	right: ModuleAnalysisFingerprint,
) -> Bool:
	(
		compiler_module_identities_equal(left.module_identity, right.module_identity)
		and left.source.value == right.source.value
		and configuration_epoch_value(
			left.configuration_epoch,
		) == configuration_epoch_value(right.configuration_epoch)
		and left.frontend.value == right.frontend.value
	)


pure func analysis_cache_lexed(
	cache: AnalysisCacheSnapshot,
	fingerprint: ParseFingerprint,
) -> Option[LexedArtifact]:
	representation = analysis_cache_rep(cache)
	artifact ?= uri_store_get(representation.lexed, fingerprint.uri)

	if parse_fingerprints_equal(lexed_artifact_fingerprint(artifact), fingerprint):
		Some(artifact)
	else:
		None


pure func analysis_cache_parsed(
	cache: AnalysisCacheSnapshot,
	fingerprint: ParseFingerprint,
) -> Option[ParsedArtifact]:
	representation = analysis_cache_rep(cache)
	artifact ?= uri_store_get(representation.parsed, fingerprint.uri)

	if parse_fingerprints_equal(parsed_artifact_fingerprint(artifact), fingerprint):
		Some(artifact)
	else:
		None


pure func analysis_cache_typed(
	cache: AnalysisCacheSnapshot,
	fingerprint: ModuleAnalysisFingerprint,
) -> Option[TypedArtifact]:
	representation = analysis_cache_rep(cache)
	artifact ?= module_store_get(representation.typed, fingerprint.module_identity)

	if module_analysis_fingerprints_equal(typed_artifact_fingerprint(artifact), fingerprint):
		Some(artifact)
	else:
		None


pure func analysis_cache_store_lexed(
	cache: AnalysisCacheSnapshot,
	artifact: LexedArtifact,
) -> AnalysisCacheSnapshot:
	representation = analysis_cache_rep(cache)
	fingerprint = lexed_artifact_fingerprint(artifact)
	updated: AnalysisCacheRep = { representation |
		lexed = uri_store_set(representation.lexed, fingerprint.uri, artifact)
	}
	into AnalysisCacheSnapshot(updated)


pure func analysis_cache_store_parsed(
	cache: AnalysisCacheSnapshot,
	artifact: ParsedArtifact,
) -> AnalysisCacheSnapshot:
	representation = analysis_cache_rep(cache)
	fingerprint = parsed_artifact_fingerprint(artifact)
	updated: AnalysisCacheRep = { representation |
		parsed = uri_store_set(representation.parsed, fingerprint.uri, artifact)
	}
	into AnalysisCacheSnapshot(updated)


pure func analysis_cache_store_typed(
	cache: AnalysisCacheSnapshot,
	artifact: TypedArtifact,
) -> AnalysisCacheSnapshot:
	representation = analysis_cache_rep(cache)
	fingerprint = typed_artifact_fingerprint(artifact)
	updated: AnalysisCacheRep = { representation |
		typed = module_store_set(representation.typed, fingerprint.module_identity, artifact)
	}
	into AnalysisCacheSnapshot(updated)


pure func analysis_cache_remove_lexed(
	cache: AnalysisCacheSnapshot,
	fingerprint: ParseFingerprint,
) -> AnalysisCacheSnapshot:
	if analysis_cache_lexed(cache, fingerprint).is_none():
		cache
	else:
		representation = analysis_cache_rep(cache)
		updated: AnalysisCacheRep = { representation |
			lexed = uri_store_remove(representation.lexed, fingerprint.uri)
		}
		into AnalysisCacheSnapshot(updated)


pure func analysis_cache_remove_parsed(
	cache: AnalysisCacheSnapshot,
	fingerprint: ParseFingerprint,
) -> AnalysisCacheSnapshot:
	if analysis_cache_parsed(cache, fingerprint).is_none():
		cache
	else:
		representation = analysis_cache_rep(cache)
		updated: AnalysisCacheRep = { representation |
			parsed = uri_store_remove(representation.parsed, fingerprint.uri)
		}
		into AnalysisCacheSnapshot(updated)


pure func analysis_cache_remove_typed(
	cache: AnalysisCacheSnapshot,
	fingerprint: ModuleAnalysisFingerprint,
) -> AnalysisCacheSnapshot:
	if analysis_cache_typed(cache, fingerprint).is_none():
		cache
	else:
		representation = analysis_cache_rep(cache)
		updated: AnalysisCacheRep = { representation |
			typed = module_store_remove(representation.typed, fingerprint.module_identity)
		}
		into AnalysisCacheSnapshot(updated)


-- Invalidation knows which module became unusable, but its replacement
-- fingerprint is intentionally different from the stale cached artifact.
-- Removing by canonical module identity prevents a failed reanalysis from
-- leaving the previous successful artifact reachable.
pure func analysis_cache_remove_typed_for_module(
	cache: AnalysisCacheSnapshot,
	module_identity: CompilerModuleIdentity,
) -> AnalysisCacheSnapshot:
	representation = analysis_cache_rep(cache)
	updated: AnalysisCacheRep = { representation |
		typed = module_store_remove(representation.typed, module_identity)
	}
	into AnalysisCacheSnapshot(updated)
