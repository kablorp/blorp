-- Rendering policy for the Blorp-owned compile/run effect boundary.
import:
	../stage_09_core/compiler_semantic_worker_protocol:
		SemanticMiddleDiagnostic,
	compiler_cli_core_observation: CliCoreObservation
	compiler_cli_timing: CliCompileTiming


private pure func semantic_diagnostic_location(
	diagnostic: SemanticMiddleDiagnostic,
) -> String:
	match diagnostic.path:
		Some(path):
			if diagnostic.line > 0 and diagnostic.column > 0:
				"${path}:${diagnostic.line.to_string()}:${diagnostic.column.to_string()}: "
			else:
				"${path}: "
		None:
			""


private pure func render_semantic_diagnostic(
	diagnostic: SemanticMiddleDiagnostic,
) -> String:
	result: String = "${semantic_diagnostic_location(diagnostic)}error[${diagnostic.code}]: ${diagnostic.message}"

	match diagnostic.help:
		Some(help):
			result + "\nhelp: ${help}"
		None:
			result


pure func render_semantic_diagnostics(
	diagnostics: List[SemanticMiddleDiagnostic],
) -> String:
	diagnostics.map(render_semantic_diagnostic).join("\n")


private pure func render_core_observation(
	observation: CliCoreObservation,
) -> String:
	rendered: String = if observation.rendered.ends_with("\n"):
		observation.rendered
	else:
		observation.rendered + "\n"

	"===== after ${observation.stage_name} =====\n${rendered}"


pure func render_core_observations(
	source_path: String,
	observations: List[CliCoreObservation],
) -> String:
	if observations.length() == 0:
		""
	else:
		body: String = observations
			.map(render_core_observation)
			.join("")
		"-- blorp ${source_path}\n${body}"


private pure func render_compile_timing(timing: CliCompileTiming) -> String:
	milliseconds: Float = to_float(timing.microseconds) / 1000.0
	"${timing.label}\t${milliseconds.to_string()} ms"


pure func render_compile_timings(timings: List[CliCompileTiming]) -> String:
	if timings.length() == 0:
		""
	else:
		var total_microseconds: Int = 0

		for timing in timings:
			total_microseconds += timing.microseconds

		total: CliCompileTiming = {
			label = "total",
			microseconds = total_microseconds
		}
		"Compiler phase timings\n${timings.append(total).map(render_compile_timing).join("\n")}"
