-- Host platform and toolchain discovery for Blorp-owned compilation effects.
--
-- Environment access belongs at the outer CLI boundary. This module accepts
-- typed probe inputs and returns stable values that host compilation, runtime
-- caching, and program execution can share without repeating detection.
import:
	../stage_10_backend/build_artifact: BuildPlatform(BuildLinux, BuildMacos)
	bytes: Bytes
	host_c:
		HostCCompiler,
		HostCCompilerFamily(HostClang, HostGcc, HostOtherCompiler),
		HostTlsBackend(HostTlsOpenSsl, HostTlsUnsupported),
		HostTlsConfiguration,
	path: join
	process as Process
	string: is_whitespace, string
	units: DataSize, Duration


record HostToolchainProbe {
	compiler: HostCCompiler,
	uname_program: String,
	timeout: Option[Duration],
	capture_limit: DataSize
}


record HostToolchain {
	platform: BuildPlatform,
	compiler: HostCCompiler,
	compiler_identity: String,
	target_identity: String
}


union HostProcessExecution:
	HostProcessCompleted(Process.ProcessResult)
	HostProcessFailed(Process.ProcessError)
	HostProcessInterrupted(Int, Bytes, Bytes)


union HostPlatformError:
	HostPlatformProcessFailed(String, Process.ProcessError)
	HostPlatformInterrupted(Int, Bytes, Bytes)
	HostPlatformProbeRejected(String, Int, String)
	HostPlatformProbeSignaled(String, Int, String)
	HostPlatformProbeTimedOut(String, String)
	HostPlatformProbeEmpty(String)
	HostPlatformUnsupported(String)
	HostTlsBackendInvalid(String)
	HostArgumentListInvalid(String)


pure func host_platform_error_message(error: HostPlatformError) -> String:
	match error:
		HostPlatformProcessFailed(label, process_error):
			"${label} failed: ${process_error.to_string()}"
		HostPlatformInterrupted(signal, _, _):
			"host discovery was interrupted by signal ${signal.to_string()}"
		HostPlatformProbeRejected(label, code, diagnostics):
			"${label} exited with status ${code.to_string()}: ${diagnostics}"
		HostPlatformProbeSignaled(label, signal, diagnostics):
			"${label} was terminated by signal ${signal.to_string()}: ${diagnostics}"
		HostPlatformProbeTimedOut(label, diagnostics):
			"${label} timed out: ${diagnostics}"
		HostPlatformProbeEmpty(label):
			"${label} returned no output"
		HostPlatformUnsupported(platform):
			"unsupported host platform `${platform}`"
		HostTlsBackendInvalid(backend):
			"unsupported TLS backend `${backend}`"
		HostArgumentListInvalid(detail):
			"invalid host argument list: ${detail}"


private enum HostArgumentQuote:
	HostArgumentUnquoted
	HostArgumentSingleQuoted
	HostArgumentDoubleQuoted


private pure func probe_diagnostics(stdout: String, stderr: String) -> String:
	if stdout.length() == 0:
		stderr
	else if stderr.length() == 0:
		stdout
	else:
		stdout + "\n" + stderr


private func run_host_process(request: Process.ProcessCommand) -> HostProcessExecution:
	match Process.run_command(request):
		Ok(result):
			HostProcessCompleted(result)
		Err(error):
			HostProcessFailed(error)


private func probe_output_with_runner(
	label: String,
	program: String,
	arguments: List[String],
	timeout: Option[Duration],
	capture_limit: DataSize,
	require_output: Bool,
	runner: (Process.ProcessCommand) -> HostProcessExecution,
) -> Result[String, HostPlatformError]:
	request = { Process.command(program, arguments) |
		timeout = timeout,
		capture_limit = Process.BoundedCapture(capture_limit)
	}

	match runner(request):
		HostProcessFailed(error):
			Err(HostPlatformProcessFailed(label, error))
		HostProcessInterrupted(signal, stdout, stderr):
			Err(HostPlatformInterrupted(signal, stdout, stderr))
		HostProcessCompleted(result):
			diagnostics: String = probe_diagnostics(
				result.stdout.to_string(),
				result.stderr.to_string(),
			)

			match result.exit:
				Process.Exited(code):
					if code != 0:
						Err(HostPlatformProbeRejected(label, code, diagnostics))
					else if (
						require_output
						and diagnostics
							.trim()
							.length() == 0
					):
						Err(HostPlatformProbeEmpty(label))
					else:
						Ok(diagnostics.trim())
				Process.Signaled(signal):
					Err(HostPlatformProbeSignaled(label, signal, diagnostics))
				Process.TimedOut:
					Err(HostPlatformProbeTimedOut(label, diagnostics))


private func probe_text_with_runner(
	label: String,
	program: String,
	arguments: List[String],
	timeout: Option[Duration],
	capture_limit: DataSize,
	runner: (Process.ProcessCommand) -> HostProcessExecution,
) -> Result[String, HostPlatformError]:
	probe_output_with_runner(label, program, arguments, timeout, capture_limit, True, runner)


pure func parse_host_platform(output: String) -> Result[BuildPlatform, HostPlatformError]:
	name: String = output.trim()

	match name.lower():
		"linux":
			Ok(BuildLinux)
		"darwin":
			Ok(BuildMacos)
		_:
			Err(HostPlatformUnsupported(name))


-- GCC distributors may expose the driver as `cc` without a `gcc` token, but
-- retain the upstream copyright marker in `--version` output.
private GCC_VERSION_MARKERS: List[String] = ["gcc", "gnu compiler", "free software foundation"]


pure func host_c_compiler_family(version_output: String) -> HostCCompilerFamily:
	version: String = version_output.lower()

	if version.contains("clang"):
		HostClang
	else if GCC_VERSION_MARKERS.any(func(marker): version.contains(marker)):
		HostGcc
	else:
		HostOtherCompiler


pure func parse_host_arguments(value: String) -> Result[List[String], HostPlatformError]:
	var arguments: List[String] = []
	var current: String = string(value.length())
	var quote: HostArgumentQuote = HostArgumentUnquoted
	var escaping: Bool = False
	var token_started: Bool = False
	var index: Int = 0

	while index < value.length():
		match value.get(index):
			None:
				index = value.length()
			Some(character):
				if escaping:
					current = current.append_char(character)
					escaping = False
					token_started = True
				else:
					match quote:
						HostArgumentUnquoted:
							if is_whitespace(character):
								if token_started:
									arguments = arguments.append(current)
									current = string(value.length() - index)
									token_started = False
							else if character == '\\':
								escaping = True
								token_started = True
							else if character == '\'':
								quote = HostArgumentSingleQuoted
								token_started = True
							else if character == '\"':
								quote = HostArgumentDoubleQuoted
								token_started = True
							else:
								current = current.append_char(character)
								token_started = True
						HostArgumentSingleQuoted:
							if character == '\'':
								quote = HostArgumentUnquoted
							else:
								current = current.append_char(character)
						HostArgumentDoubleQuoted:
							if character == '\"':
								quote = HostArgumentUnquoted
							else if character == '\\':
								escaping = True
							else:
								current = current.append_char(character)

				index += 1

	if escaping:
		Err(HostArgumentListInvalid("argument list ends with an escape"))
	else:
		match quote:
			HostArgumentSingleQuoted:
				Err(HostArgumentListInvalid("argument list has an unterminated single quote"))
			HostArgumentDoubleQuoted:
				Err(HostArgumentListInvalid("argument list has an unterminated double quote"))
			HostArgumentUnquoted:
				if token_started:
					Ok(arguments.append(current))
				else:
					Ok(arguments)


func probe_host_arguments_with_runner(
	label: String,
	program: String,
	arguments: List[String],
	timeout: Option[Duration],
	capture_limit: DataSize,
	runner: (Process.ProcessCommand) -> HostProcessExecution,
) -> Result[List[String], HostPlatformError]:
	output ?= probe_output_with_runner(
		label,
		program,
		arguments,
		timeout,
		capture_limit,
		False,
		runner,
	)
	parse_host_arguments(output)


func discover_host_toolchain_with_runner(
	probe: HostToolchainProbe,
	runner: (Process.ProcessCommand) -> HostProcessExecution,
) -> Result[HostToolchain, HostPlatformError]:
	platform_output ?= probe_text_with_runner(
		"host platform",
		probe.uname_program,
		["-s"],
		probe.timeout,
		probe.capture_limit,
		runner,
	)
	platform ?= parse_host_platform(platform_output)
	compiler_identity ?= probe_text_with_runner(
		"C compiler identity",
		probe.compiler.program,
		probe.compiler.prefix_arguments.append("--version"),
		probe.timeout,
		probe.capture_limit,
		runner,
	)
	target_identity ?= probe_text_with_runner(
		"C compiler target",
		probe.compiler.program,
		probe.compiler.prefix_arguments.append("-dumpmachine"),
		probe.timeout,
		probe.capture_limit,
		runner,
	)

	Ok({
		platform = platform,
		compiler = { probe.compiler | family = host_c_compiler_family(compiler_identity) },
		compiler_identity = compiler_identity,
		target_identity = target_identity,
	})


func discover_host_toolchain(probe: HostToolchainProbe) -> Result[HostToolchain, HostPlatformError]:
	discover_host_toolchain_with_runner(probe, run_host_process)


pure func parse_host_tls_backend(
	value: Option[String],
) -> Result[HostTlsBackend, HostPlatformError]:
	match value:
		None:
			Ok(HostTlsUnsupported)
		Some(raw):
			normalized: String = raw
				.trim()
				.lower()

			match normalized:
				"":
					Ok(HostTlsUnsupported)
				"unsupported":
					Ok(HostTlsUnsupported)
				"openssl":
					Ok(HostTlsOpenSsl)
				_:
					Err(HostTlsBackendInvalid(normalized))


pure func host_tls_configuration(
	backend: HostTlsBackend,
	compile_arguments: List[String],
	link_arguments: List[String],
) -> HostTlsConfiguration:
	match backend:
		HostTlsUnsupported:
			{
				backend = HostTlsUnsupported,
				runtime_arguments = [],
				link_arguments = []
			}
		HostTlsOpenSsl:
			{
				backend = HostTlsOpenSsl,
				runtime_arguments = [
					"-DBLORP_TLS_BACKEND_PROFILE_OPENSSL=1",
				].concat(compile_arguments),
				link_arguments = link_arguments
			}


private pure func nonempty_path(value: Option[String]) -> Option[String]:
	match value:
		Some(path):
			if (
				path
					.trim()
					.length() == 0
			):
				None
			else:
				Some(path)
		None:
			None


pure func host_cache_root(
	override: Option[String],
	xdg_cache_home: Option[String],
	home: Option[String],
	temporary_root: String,
) -> String:
	match nonempty_path(override):
		Some(path):
			path
		None:
			base: String = match nonempty_path(xdg_cache_home):
				Some(path):
					path
				None:
					match nonempty_path(home):
						Some(path):
							join(path, ".cache")
						None:
							join(temporary_root, ".cache")

			join(
				join(base, "blorp"),
				"cas",
			)
