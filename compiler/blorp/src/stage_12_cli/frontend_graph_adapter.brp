-- Transitional adapter from the CLI-facing graph to the compiler-owned graph.
--
-- Discovery remains in source_graph during extraction, but every semantic
-- edge is converted to the shared exact-identity representation here. This
-- adapter is deleted once CLI callers consume FrontendGraph directly.
import:
	../stage_04_modules/frontend_graph:
		FrontendGraph,
		FrontendImportEdge,
		FrontendModule,
		frontend_module,
		frontend_resolved_import_edge,
		frontend_unresolved_import_edge,
	../stage_04_modules/frontend_graph_service:
		FrontendGraphServiceError,
		frontend_graph_for_sources,
		frontend_graph_service_error_message,
	../stage_04_modules/loaded_module:
		ModuleOrigin(NativePackageModule, SourcePackageModule, StdlibModule, UserModule),
		ResolvedModuleIdentity,
		module_origins_equal,
		resolved_module_identity_from_resolver,
	plan:
		CliFrontendGraphSource,
		CliFrontendImportEdge,
		CliFrontendModuleGraph,
		CliFrontendModuleOrigin(
			CliFrontendGeneratedModule,
			CliFrontendPkgModule,
			CliFrontendSourcePackageModule,
			CliFrontendStdModule,
			CliFrontendUserModule,
		),


union CliFrontendGraphAdapterError:
	CliFrontendGraphMissingImporter(String, String)
	CliFrontendGraphIncompleteResolvedEdge(String)
	CliFrontendGraphMissingResolvedTarget(String, String)
	CliFrontendGraphRejected(List[FrontendGraphServiceError])


pure func cli_frontend_graph_adapter_error_message(error: CliFrontendGraphAdapterError) -> String:
	match error:
		CliFrontendGraphMissingImporter(path, module_name):
			"frontend import source `" + module_name + "` at `" + path + "` is absent"
		CliFrontendGraphIncompleteResolvedEdge(import_path):
			"frontend import `" + import_path + "` has an incomplete resolved identity"
		CliFrontendGraphMissingResolvedTarget(path, module_name):
			"frontend import target `" + module_name + "` at `" + path + "` is absent"
		CliFrontendGraphRejected(errors):
			errors
				.map(frontend_graph_service_error_message)
				.join("\n")


pure func cli_frontend_compiler_origin(origin: CliFrontendModuleOrigin) -> ModuleOrigin:
	match origin:
		CliFrontendUserModule:
			UserModule
		CliFrontendGeneratedModule:
			UserModule
		CliFrontendStdModule:
			StdlibModule
		CliFrontendSourcePackageModule(package_alias):
			SourcePackageModule(package_alias)
		CliFrontendPkgModule(package_id):
			NativePackageModule(package_id)


pure func cli_frontend_compiler_identity(
	module_name: String,
	origin: CliFrontendModuleOrigin,
) -> ResolvedModuleIdentity:
	resolved_module_identity_from_resolver(module_name, cli_frontend_compiler_origin(origin))


private pure func module(source: CliFrontendGraphSource) -> FrontendModule:
	frontend_module(
		cli_frontend_compiler_identity(source.module_name, source.origin),
		source.typecheck_program,
	)


private pure func edge_importer_source(
	sources: List[CliFrontendGraphSource],
	edge: CliFrontendImportEdge,
) -> Option[CliFrontendGraphSource]:
	sources.find(func(source):
		source.path == edge.from_path and source.module_name == edge.from_module
	)


private pure func adapt_import_edge(
	sources: List[CliFrontendGraphSource],
	edge: CliFrontendImportEdge,
) -> Result[FrontendImportEdge, CliFrontendGraphAdapterError]:
	importer ?= edge_importer_source(
		sources,
		edge,
	).to_result(CliFrontendGraphMissingImporter(edge.from_path, edge.from_module))
	importer_identity = cli_frontend_compiler_identity(importer.module_name, importer.origin)

	match (edge.resolved_path, edge.resolved_module, edge.resolved_origin):
		(None, None, None):
			Ok(frontend_unresolved_import_edge(importer_identity, edge.import_path))
		(Some(path), Some(module_name), Some(origin)):
			target ?= sources
				.find(func(source):
					(
						source.path == path
						and source.module_name == module_name
						and module_origins_equal(
							cli_frontend_compiler_origin(source.origin),
							cli_frontend_compiler_origin(origin),
						)
					)
				)
				.to_result(CliFrontendGraphMissingResolvedTarget(path, module_name))

			Ok(
				frontend_resolved_import_edge(
					importer_identity,
					edge.import_path,
					cli_frontend_compiler_identity(target.module_name, target.origin),
				),
			)
		_:
			Err(CliFrontendGraphIncompleteResolvedEdge(edge.import_path))


private pure func adapt_import_edges(
	sources: List[CliFrontendGraphSource],
	edges: List[CliFrontendImportEdge],
) -> Result[List[FrontendImportEdge], CliFrontendGraphAdapterError]:
	var converted: List[FrontendImportEdge] = []
	var error: Option[CliFrontendGraphAdapterError] = None

	for edge in edges:
		if error.is_none():
			match adapt_import_edge(sources, edge):
				Ok(value):
					converted = converted.append(value)
				Err(found):
					error = Some(found)

	match error:
		Some(found):
			Err(found)
		None:
			Ok(converted)


pure func cli_frontend_graph_as_compiler_graph(
	graph: CliFrontendModuleGraph,
) -> Result[FrontendGraph, CliFrontendGraphAdapterError]:
	sources = graph.roots.concat(graph.modules)
	modules = sources.map(module)
	roots = graph.roots.map(func(source):
		cli_frontend_compiler_identity(source.module_name, source.origin)
	)
	edges ?= adapt_import_edges(sources, graph.import_edges)

	match frontend_graph_for_sources(modules, roots, edges):
		Ok(converted):
			Ok(converted)
		Err(errors):
			Err(CliFrontendGraphRejected(errors))


pure func validated_cli_frontend_graph(
	graph: CliFrontendModuleGraph,
) -> Result[CliFrontendModuleGraph, String]:
	match cli_frontend_graph_as_compiler_graph(graph):
		Ok(_):
			Ok(graph)
		Err(error):
			Err(cli_frontend_graph_adapter_error_message(error))
