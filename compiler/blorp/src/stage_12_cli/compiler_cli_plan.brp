-- Shared data model for Blorp-owned CLI planning.
import:
	../stage_03_parse/compiler_source_ast_finalize: FinalizedTypecheckProgram
	compiler_cli_args: CliCheckArgs, CliCompileArgs, CliPurifyArgs, CliRunArgs, CliTestArgs
	json: JsonValue


enum CliDelegationIo:
	BatchCliDelegation
	TerminalCliDelegation


record LegacyCliDelegation {
	args: List[String],
	io: CliDelegationIo
}


record CliHandledResult {
	status: Int,
	stdout: String,
	stderr: String
}


record CliRunRequest {
	args: List[String],
	version: Option[String],
	source: Option[CliSourceFile]
}


union CliRunPlan:
	CliRunHandled(CliHandledResult)
	CliRunDelegate(LegacyCliDelegation)
	CliRunCheck(CliCheckPlan)
	CliRunCompile(CliCompilePlan)
	CliRunSource(CliRunSourcePlan)
	CliRunTest(CliTestRunPlan)
	CliRunPurify(CliPurifyRunPlan)
	CliRunRepl(CliReplRunPlan)
	CliRunLsp
	CliRunPackage(CliPackageRunPlan)


union CliSourceTarget:
	CliSourceFileTarget(String)
	CliSourceDirectoryTarget(String)


record CliCheckTargetExpansion {
	targets: List[CliSourceTarget],
	source_paths: List[String]
}


record CliSourceFile {
	path: String,
	module_name: String,
	source_text: String
}


record CliGeneratedModuleImport {
	module_path: String,
	source_path: String,
	source_module: String
}


record CliGeneratedModule {
	source: CliSourceFile,
	imports: List[CliGeneratedModuleImport]
}


record CliParsedSourceFile {
	path: String,
	module_name: String,
	source_text: String,
	parsed_source: JsonValue,
	typecheck_program: FinalizedTypecheckProgram
}


record CliFrontendSourcePackage {
	package_alias: String,
	package_name: String,
	package_root: String,
	source_dir: String,
	exports: List[String]
}


record CliFrontendGraphContext {
	std_dir: Option[String],
	source_packages: List[CliFrontendSourcePackage],
	package_roots: List[String]
}


union CliFrontendModuleOrigin:
	CliFrontendUserModule
	CliFrontendGeneratedModule
	CliFrontendStdModule
	CliFrontendSourcePackageModule(String)
	CliFrontendPkgModule(String)


record CliFrontendGraphSource {
	path: String,
	module_name: String,
	source_text: String,
	parsed_source: JsonValue,
	typecheck_program: FinalizedTypecheckProgram,
	origin: CliFrontendModuleOrigin
}


record CliFrontendImportEdge {
	from_path: String,
	from_module: String,
	import_path: String,
	resolved_path: Option[String],
	resolved_module: Option[String],
	resolved_origin: Option[CliFrontendModuleOrigin]
}


record CliFrontendModuleGraph {
	context: CliFrontendGraphContext,
	roots: List[CliFrontendGraphSource],
	modules: List[CliFrontendGraphSource],
	import_edges: List[CliFrontendImportEdge],
	diagnostics: List[String]
}


record CliCheckPlan {
	args: List[String],
	options: CliCheckArgs,
	graph: CliFrontendModuleGraph
}


record CliCompilePlan {
	args: List[String],
	options: CliCompileArgs,
	graph: CliFrontendModuleGraph
}


record CliRunSourcePlan {
	args: List[String],
	options: CliRunArgs,
	graph: CliFrontendModuleGraph
}


union CliOcamlHostPlan:
	CliOcamlHostHandled(CliHandledResult)
	CliOcamlHostTest(CliTestRunPlan, String)
	CliOcamlHostRepl(CliReplRunPlan, String)
	CliOcamlHostLsp
	CliOcamlHostPackage(CliPackageRunPlan)


union CliTestRunCommand:
	CliTestExecute(CliTestArgs)
	CliTestWarmup


record CliTestRunPlan {
	args: List[String],
	command: CliTestRunCommand
}


record CliPurifyRunPlan {
	args: List[String],
	options: CliPurifyArgs,
	graph: CliFrontendModuleGraph
}


record CliReplRunPlan {
	args: List[String],
	debug: Bool
}


union CliPackageRunCommand:
	CliPackageRunCheck(String)
	CliPackageRunHash(String)
	CliPackageRunPack(String, String)
	CliPackageRunFetchAll
	CliPackageRunFetchTarget(String, List[String])
	CliPackageRunVendorAll
	CliPackageRunVendorTarget(String, Option[String])


record CliPackageRunPlan {
	args: List[String],
	command: CliPackageRunCommand
}
