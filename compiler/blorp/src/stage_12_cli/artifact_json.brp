-- JSON encoding for Blorp CLI plans crossing the compiler bridge.
import:
	args: CliCompileArgs
	bridge_protocol: BRIDGE_SCHEMA_VERSION, bridge_success_json
	json: JsonValue(JsonBool, JsonNull, JsonNumber, JsonObject, JsonString, JsonVector)
	plan:
		CliCompilePlan,
		CliFrontendGraphContext,
		CliFrontendGraphSource,
		CliFrontendImportEdge,
		CliFrontendModuleGraph,
		CliFrontendModuleOrigin(
			CliFrontendGeneratedModule,
			CliFrontendPkgModule,
			CliFrontendSourcePackageModule,
			CliFrontendStdModule,
			CliFrontendUserModule,
		),
		CliFrontendSourcePackage,
		CliRunPlan(
			CliRunCheck,
			CliRunCompile,
			CliRunHandled,
			CliRunLsp,
			CliRunLint,
			CliRunPackage,
			CliRunPurify,
			CliRunSource,
			CliRunTest,
		),


private pure func owned_string(text: String) -> String:
	text.substring(0, text.length())


private pure func json_owned_string(text: String) -> JsonValue:
	JsonString(owned_string(text))


private pure func owned_json(value: JsonValue) -> JsonValue:
	match value:
		JsonNull:
			JsonNull
		JsonBool(flag):
			JsonBool(flag)
		JsonNumber(number):
			JsonNumber(number)
		JsonString(text):
			JsonString(owned_string(text))
		JsonVector(items):
			JsonVector(items.map(owned_json))
		JsonObject(fields):
			JsonObject(fields.map(
				func(field): (owned_string(field[0]), owned_json(field[1])),
			))


private pure func json_string_list(values: List[String]) -> JsonValue:
	JsonVector(values.map(json_owned_string))


private pure func json_optional_string(value: Option[String]) -> JsonValue:
	match value:
		Some(text):
			json_owned_string(text)
		None:
			JsonNull


private pure func frontend_module_origin_json(origin: CliFrontendModuleOrigin) -> JsonValue:
	match origin:
		CliFrontendUserModule:
			JsonObject([("kind", JsonString("user"))])
		CliFrontendGeneratedModule:
			JsonObject([("kind", JsonString("generated"))])
		CliFrontendStdModule:
			JsonObject([("kind", JsonString("std"))])
		CliFrontendSourcePackageModule(package_alias):
			JsonObject([
				("kind", JsonString("source_package")),
				("package", json_owned_string(package_alias)),
			])
		CliFrontendPkgModule(package_id):
			JsonObject([
				("kind", JsonString("pkg")),
				("package", json_owned_string(package_id)),
			])


private pure func json_optional_frontend_module_origin(
	value: Option[CliFrontendModuleOrigin],
) -> JsonValue:
	match value:
		Some(origin):
			frontend_module_origin_json(origin)
		None:
			JsonNull


pure func cli_compile_options_json(args: CliCompileArgs) -> JsonValue:
	JsonObject([
		("kind", JsonString("compile")),
		("ast_only", JsonBool(args.ast_only)),
		("profile", JsonBool(args.profile)),
		("dump_ast", JsonBool(args.dump_ast)),
		("dump_typed_ast", JsonBool(args.dump_typed_ast)),
		("dump_core_after", json_string_list(args.dump_core_after)),
		("dump_file", json_optional_string(args.dump_file)),
		("stop_after", json_optional_string(args.stop_after)),
		("time_phases", JsonBool(args.time_phases)),
		("check_invariants", JsonBool(args.check_invariants)),
		("debug", JsonBool(args.debug)),
		("no_format", JsonBool(args.no_format)),
		("embed_runtime", JsonBool(args.embed_runtime)),
		("std_dir", json_optional_string(args.std_dir)),
		("output", json_optional_string(args.output)),
		("files", json_string_list(args.files)),
	])


private pure func cli_frontend_graph_source_json(source: CliFrontendGraphSource) -> JsonValue:
	JsonObject([
		("path", json_owned_string(source.path)),
		("module", json_owned_string(source.module_name)),
		("source_text", json_owned_string(source.source_text)),
		("origin", frontend_module_origin_json(source.origin)),
	])


private pure func cli_frontend_graph_sources_json(
	sources: List[CliFrontendGraphSource],
) -> JsonValue:
	JsonVector(sources.map(cli_frontend_graph_source_json))


private pure func cli_frontend_import_edge_json(edge: CliFrontendImportEdge) -> JsonValue:
	JsonObject([
		("from_path", json_owned_string(edge.from_path)),
		("from_module", json_owned_string(edge.from_module)),
		("import_path", json_owned_string(edge.import_path)),
		("resolved_path", json_optional_string(edge.resolved_path)),
		("resolved_module", json_optional_string(edge.resolved_module)),
		("resolved_origin", json_optional_frontend_module_origin(edge.resolved_origin)),
	])


private pure func cli_frontend_source_package_json(package: CliFrontendSourcePackage) -> JsonValue:
	JsonObject([
		("alias", json_owned_string(package.package_alias)),
		("name", json_owned_string(package.package_name)),
		("root", json_owned_string(package.package_root)),
		("source_dir", json_owned_string(package.source_dir)),
		("exports", json_string_list(package.exports)),
	])


private pure func cli_frontend_graph_context_json(context: CliFrontendGraphContext) -> JsonValue:
	JsonObject([
		("std_dir", json_optional_string(context.std_dir)),
		(
			"source_packages",
			JsonVector(context.source_packages.map(cli_frontend_source_package_json)),
		),
		("package_roots", json_string_list(context.package_roots)),
	])


private pure func cli_frontend_module_graph_artifact_json(
	command: String,
	args: List[String],
	options: JsonValue,
	graph: CliFrontendModuleGraph,
) -> JsonValue:
	JsonObject([
		("kind", JsonString("frontend_module_graph")),
		("command", JsonString(command)),
		("args", json_string_list(args)),
		("options", owned_json(options)),
		("context", cli_frontend_graph_context_json(graph.context)),
		("roots", cli_frontend_graph_sources_json(graph.roots)),
		("modules", cli_frontend_graph_sources_json(graph.modules)),
		("imports", JsonVector(graph.import_edges.map(cli_frontend_import_edge_json))),
		("diagnostics", json_string_list(graph.diagnostics)),
	])


private pure func cli_compile_plan_artifact_json(plan: CliCompilePlan) -> JsonValue:
	cli_frontend_module_graph_artifact_json(
		"compile",
		plan.args,
		cli_compile_options_json(plan.options),
		plan.graph,
	)


pure func cli_command_error_json(message: String, status: Int) -> JsonValue:
	JsonObject([
		("schema", JsonNumber(to_float(BRIDGE_SCHEMA_VERSION))),
		("ok", JsonBool(False)),
		("error", JsonObject([
			("code", JsonString("cli_command_error")),
			("message", json_owned_string(message)),
			("status", JsonNumber(to_float(status))),
		])),
	])


pure func cli_run_plan_to_json(plan: CliRunPlan) -> JsonValue:
	match plan:
		CliRunCheck(_):
			cli_command_error_json(
				"check plans execute directly and cannot be serialized as compiler artifacts",
				1,
			)
		CliRunHandled(result):
			bridge_success_json(JsonObject([
				("kind", JsonString("handled")),
				("status", JsonNumber(to_float(result.status))),
				("stdout", json_owned_string(result.stdout)),
				("stderr", json_owned_string(result.stderr)),
			]))
		CliRunCompile(compile_plan):
			-- The bridge envelope serializes compile plans; the production CLI
			-- executes the same plan directly.
			bridge_success_json(cli_compile_plan_artifact_json(compile_plan))
		CliRunSource(_):
			cli_command_error_json(
				"run plans execute directly and cannot be serialized as compiler artifacts",
				1,
			)
		CliRunTest(_):
			cli_command_error_json(
				"test plans execute directly and cannot be serialized as compiler artifacts",
				1,
			)
		CliRunPurify(_):
			cli_command_error_json(
				"purify plans execute directly and cannot be serialized as compiler artifacts",
				1,
			)
		CliRunLint(_):
			cli_command_error_json(
				"lint plans execute directly and cannot be serialized as compiler artifacts",
				1,
			)
		CliRunLsp:
			cli_command_error_json(
				"LSP plans execute directly and cannot be serialized as compiler artifacts",
				1,
			)
		CliRunPackage(_):
			cli_command_error_json(
				"package plans execute directly and cannot be serialized as compiler artifacts",
				1,
			)
