import:
	compiler_cli: run_cli, run_cli_with_source
	compiler_cli_artifact_json: cli_ocaml_host_plan_to_json
	compiler_cli_compile_effect: execute_compile_command
	compiler_cli_execute: execute_check_plan
	compiler_cli_plan:
		CliHandledResult,
		CliOcamlHostPlan(
			CliOcamlHostLsp,
			CliOcamlHostPackage,
			CliOcamlHostPurify,
			CliOcamlHostRepl,
			CliOcamlHostTest,
		),
		CliRunPlan(
			CliRunCheck,
			CliRunCompile,
			CliRunDelegate,
			CliRunHandled,
			CliRunLsp,
			CliRunPackage,
			CliRunPurify,
			CliRunRepl,
			CliRunSource,
			CliRunTest,
		),
		CliSourceFile,
	compiler_cli_run_effect:
		CliRunEffectConfiguration,
		build_run_executable,
		execute_run_command,
	compiler_runtime: compiler_runtime_sources
	compiler_semantic_worker_client: SemanticMiddleWorkerCommand
	io: print, print_error
	path: dirname, join, stem
	process: run_inherit
	system: getenv, mkstemp_path, read_file, remove_file, temp_dir, write_file
	units: mebibytes


private OCAML_HOST_ENV: String = "BLORP_OCAML_HOST_BIN"

private OCAML_MIDDLE_ENV: String = "BLORP_OCAML_MIDDLE_BIN"

private DEFAULT_OCAML_HOST_NAME: String = "blorp-ocaml-host"

private DEFAULT_OCAML_MIDDLE_NAME: String = "blorp-ocaml-middle"

private DEFAULT_BLORP_NAME: String = "blorp"

private HOST_EXECUTE_CLI_PLAN_COMMAND: String = "__compiler-run-cli-plan"

private BUILD_SYNTHETIC_EXECUTABLE_COMMAND: String = "__compiler-build-synthetic-executable"

private SEMANTIC_WORKER_RESPONSE_MEBIBYTES: Int = 512

private HOST_CAPTURE_MEBIBYTES: Int = 64


private pure func sibling_ocaml_host_path(program_path: String) -> String:
	if program_path.contains("/"):
		join(dirname(program_path), DEFAULT_OCAML_HOST_NAME)
	else:
		DEFAULT_OCAML_HOST_NAME


private pure func sibling_ocaml_middle_path(program_path: String) -> String:
	if program_path.contains("/"):
		join(dirname(program_path), DEFAULT_OCAML_MIDDLE_NAME)
	else:
		DEFAULT_OCAML_MIDDLE_NAME


private func ocaml_host_path(program_path: String) -> String:
	match getenv(OCAML_HOST_ENV):
		Some(path):
			if path.length() > 0:
				path
			else:
				sibling_ocaml_host_path(program_path)
		None:
			sibling_ocaml_host_path(program_path)


private func ocaml_middle_path(program_path: String) -> String:
	match getenv(OCAML_MIDDLE_ENV):
		Some(path):
			if path.length() > 0:
				path
			else:
				sibling_ocaml_middle_path(program_path)
		None:
			sibling_ocaml_middle_path(program_path)


private pure func semantic_middle_worker(path: String) -> SemanticMiddleWorkerCommand:
	{
		program = path,
		args = [],
		timeout = None,
		max_response_size = mebibytes(SEMANTIC_WORKER_RESPONSE_MEBIBYTES)
	}


private func run_effect_configuration(middle_path: String) -> CliRunEffectConfiguration:
	{
		worker = semantic_middle_worker(middle_path),
		runtime_sources = compiler_runtime_sources(),
		host_timeout = None,
		capture_limit = mebibytes(HOST_CAPTURE_MEBIBYTES),
		temporary_root = temp_dir()
	}


private pure func is_internal_compiler_command(args: List[String]) -> Bool:
	match args.get(0):
		Some(command):
			match command:
				"__compiler-bridge-prepare":
					True
				"__compiler-run-cli-plan":
					True
				_:
					False
		None:
			False


private func run_ocaml_host(host_path: String, host_args: List[String]) -> Int:
	match run_inherit(host_path, host_args):
		Ok(status):
			status
		Err(message):
			print_error("Error: cannot run OCaml compiler host: " + message)
			1


private func write_cli_plan_file(plan: CliOcamlHostPlan) -> Result[String, String]:
	path ?= mkstemp_path("blorp_cli_plan_")

	match write_file(path, cli_ocaml_host_plan_to_json(plan).to_string()):
		Ok(_):
			Ok(path)
		Err(message):
			Err(message)


private func run_ocaml_host_with_plan(host_path: String, plan: CliOcamlHostPlan) -> Int:
	match write_cli_plan_file(plan):
		Ok(path):
			status: Int = run_ocaml_host(
				host_path,
				[HOST_EXECUTE_CLI_PLAN_COMMAND, path],
			)
			_ = remove_file(path)
			status
		Err(message):
			print_error("Error: cannot write CLI plan: " + message)
			1


private func run_handled_result(result: CliHandledResult) -> Int:
	if result.stdout.length() != 0:
		print(result.stdout)

	if result.stderr.length() != 0:
		print_error(result.stderr)

	result.status


private func execute_internal_synthetic_build(
	middle_path: String,
	host_args: List[String],
) -> Option[Int]:
	match host_args:
		[
			command,
			source_text_path,
			logical_source_path,
			output_path,
		...run_options
	]:
			if command != BUILD_SYNTHETIC_EXECUTABLE_COMMAND:
				None
			else:
				match read_file(source_text_path):
					Err(message):
						print_error("Error: cannot read synthetic source: " + message)
						Some(1)
					Ok(source_text):
						source: CliSourceFile = {
							path = logical_source_path,
							module_name = stem(logical_source_path),
							source_text = source_text
						}
						plan: CliRunPlan = run_cli_with_source(
							["run", "--no-format"].concat(run_options).append(logical_source_path),
							source,
						)

						match plan:
							CliRunSource(run_plan):
								Some(run_handled_result(build_run_executable(
									run_plan,
									output_path,
									run_effect_configuration(middle_path),
								)))
							CliRunHandled(result):
								Some(run_handled_result(result))
							_:
								print_error(
									"Internal error: synthetic source did not produce a run plan",
								)
								Some(1)
		[command, ..._]:
			if command == BUILD_SYNTHETIC_EXECUTABLE_COMMAND:
				print_error(
					"Usage: blorp __compiler-build-synthetic-executable <source-text-path> <logical-source-path> <output-path> [run-options]",
				)
				Some(1)
			else:
				None
		_:
			None


private func execute_cli_plan(
	program_path: String,
	host_path: String,
	middle_path: String,
	plan: CliRunPlan,
) -> Int:
	match plan:
		CliRunDelegate(delegation):
			run_ocaml_host(host_path, delegation.args)
		CliRunCheck(check_plan):
			run_handled_result(execute_check_plan(check_plan))
		CliRunHandled(result):
			run_handled_result(result)
		CliRunCompile(compile_plan):
			run_handled_result(
				execute_compile_command(
					compile_plan,
					semantic_middle_worker(middle_path),
					compiler_runtime_sources(),
				),
			)
		CliRunSource(run_plan):
			run_handled_result(execute_run_command(
				run_plan,
				run_effect_configuration(middle_path),
			))
		CliRunTest(test_plan):
			run_ocaml_host_with_plan(
				host_path,
				CliOcamlHostTest(test_plan, program_path),
			)
		CliRunPurify(purify_plan):
			run_ocaml_host_with_plan(host_path, CliOcamlHostPurify(purify_plan))
		CliRunRepl(repl_plan):
			run_ocaml_host_with_plan(
				host_path,
				CliOcamlHostRepl(repl_plan, program_path),
			)
		CliRunLsp:
			run_ocaml_host_with_plan(host_path, CliOcamlHostLsp)
		CliRunPackage(package_plan):
			run_ocaml_host_with_plan(host_path, CliOcamlHostPackage(package_plan))


func main(args: List[String]) -> Int:
	host_args: List[String] = args.drop(1)
	program_path: String = args
		.get(0)
		.get_or(DEFAULT_BLORP_NAME)
	host_path: String = ocaml_host_path(program_path)
	middle_path: String = ocaml_middle_path(program_path)

	match execute_internal_synthetic_build(middle_path, host_args):
		Some(status):
			status
		None:
			if is_internal_compiler_command(host_args):
				run_ocaml_host(host_path, host_args)
			else:
				execute_cli_plan(
					program_path,
					host_path,
					middle_path,
					run_cli(host_args),
				)
