-- Stable structural counters shared by the current test runner and the
-- Blorp-owned compilation session that will replace it.
TEST_SESSION_COUNTER_SCHEMA_VERSION: Int = 1

TEST_SESSION_COUNTER_PREFIX: String = "BLORP_TEST_SESSION_COUNTER "


record CompilerTestSessionCounters {
	discovered_runnable_files: Int,
	unique_discovered_runnable_source_identities: Int,
	retained_runnable_source_bytes: Int,
	declared_test_suites: Int,
	path_policy_process_isolated_files: Int,
	path_policy_filesystem_isolated_files: Int,
	planned_combined_run_all_harnesses: Int,
	planned_combined_selector_harnesses: Int,
	planned_combined_suite_files: Int,
	planned_combined_native_executions: Int,
	planned_individual_source_files: Int,
	ocaml_host_invocations: Int
}


-- JsonValue stores numbers as Float. This protocol uses a fixed set of keys,
-- so direct decimal rendering preserves the full Int range without escaping
-- any dynamic strings or narrowing counters through floating point.
private pure func render_test_session_counter_values(
	counters: CompilerTestSessionCounters,
) -> String:
	"{\"discovered_runnable_files\":" + counters.discovered_runnable_files.to_string() + ",\"unique_discovered_runnable_source_identities\":" + counters.unique_discovered_runnable_source_identities.to_string() + ",\"retained_runnable_source_bytes\":" + counters.retained_runnable_source_bytes.to_string() + ",\"declared_test_suites\":" + counters.declared_test_suites.to_string() + ",\"path_policy_process_isolated_files\":" + counters.path_policy_process_isolated_files.to_string() + ",\"path_policy_filesystem_isolated_files\":" + counters.path_policy_filesystem_isolated_files.to_string() + ",\"planned_combined_run_all_harnesses\":" + counters.planned_combined_run_all_harnesses.to_string() + ",\"planned_combined_selector_harnesses\":" + counters.planned_combined_selector_harnesses.to_string() + ",\"planned_combined_suite_files\":" + counters.planned_combined_suite_files.to_string() + ",\"planned_combined_native_executions\":" + counters.planned_combined_native_executions.to_string() + ",\"planned_individual_source_files\":" + counters.planned_individual_source_files.to_string() + ",\"ocaml_host_invocations\":" + counters.ocaml_host_invocations.to_string() + "}"


pure func render_test_session_totals(counters: CompilerTestSessionCounters) -> String:
	TEST_SESSION_COUNTER_PREFIX + "{\"schema_version\":" + TEST_SESSION_COUNTER_SCHEMA_VERSION.to_string() + ",\"event\":\"session_totals\",\"scope\":{\"kind\":\"session\"},\"counters\":" + render_test_session_counter_values(
		counters,
	) + "}"
