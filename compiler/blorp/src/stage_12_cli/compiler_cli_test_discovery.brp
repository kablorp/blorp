-- Structural test-source facts used by Blorp-owned test discovery.
--
-- Classification consumes the parsed program instead of guessing from source
-- substrings. Filesystem traversal and execution policy are separate concerns.
-- A `tests` binding is only a candidate here; resolved TestSuite identity must
-- be checked after module loading and type resolution.
import:
	../stage_01_file_io/compiler_source: compiler_source_file
	../stage_03_parse/compiler_parsed_ast:
		ParsedDecl(
			BuiltinTypeParsedDecl,
			FunctionParsedDecl,
			ImplParsedDecl,
			PrivateParsedDecl,
			RecordParsedDecl,
			TraitParsedDecl,
			TypeAliasParsedDecl,
			UnionParsedDecl,
			VarParsedDecl,
		),
		ParsedProgram,
		parsed_program_has_errors,
	../stage_03_parse/compiler_parser: parse_compiler_source
	../stage_05_types/compiler_type:
		SemanticType(SemanticNamedType),
		canonical_module_type_name,
		types_equal,
	../stage_06_typecheck/compiler_typecheck_bridge: CompilerTypecheckedModule
	../stage_06_typecheck/compiler_typecheck_decl:
		CompilerTypedDecl(CompilerTypedGlobalVarDecl, CompilerTypedPrivateDecl),
	fs:
		DirectoryEntry,
		DirectoryEntryKind(EntryDirectory, EntryFile, EntryOther, EntrySymlink, EntryUnknown),
		IOError(NotFound),
		open_dir,
		open_read,
		read_next_entries,
		read_text,
	path: basename, join, normalize, stem
	system: file_exists, is_directory


private DIRECTORY_READ_BATCH_SIZE: Int = 128

private SKIP_DIRECTORIES: List[String] = ["test_compiler", "should_fail", "should_pass"]

private PROCESS_ISOLATED_TEST_ROOTS: List[String] = [
	"tests/test_blorp/concurrency",
	"tests/test_blorp/sys",
]

private FILESYSTEM_ISOLATED_TEST_ROOTS: List[String] = ["tests/test_blorp/memory"]

private LEAK_BASELINE_ROOT: String = "tests/test_blorp/memory/leak_check_baselines"

private TEST_SUITE_MODULE: String = "std/test"

private TEST_SUITE_TYPE: String = "TestSuite"


record CliTestSourceFeatures {
	has_main: Bool,
	has_tests_binding: Bool,
	has_doctests: Bool
}


union CliTestExecutionIsolation:
	CliSharedTestProcess
	CliFreshTestProcess(String)
	CliFreshTestFilesystem(String)


union CliTestSuiteBindingResolution:
	CliTestSuiteBindingResolved
	CliTestSuiteBindingMissing
	CliTestSuiteBindingWrongType(SemanticType)
	CliTestSuiteBindingInaccessible
	CliTestSuiteBindingAmbiguous
	CliTestSuiteBindingInvalidProgram


record CliDiscoveredTestSource {
	program: ParsedProgram,
	features: CliTestSourceFeatures,
	is_leak_baseline_program: Bool,
	isolation: CliTestExecutionIsolation
}


private pure func project_relative_path(path_value: String, project_root: String) -> String:
	path: String = normalize(path_value)
	root: String = normalize(project_root)

	root_prefix: String = if root == "/":
		root
	else:
		root + "/"

	if path.starts_with(root_prefix):
		path.drop_left(root_prefix.length())
	else:
		path


private pure func path_under(root: String, path: String) -> Bool:
	path == root or path.starts_with(root + "/")


private pure func matching_root(roots: List[String], path: String) -> Option[String]:
	roots.find(func(root): path_under(root, path))


pure func test_execution_isolation(
	path_value: String,
	project_root: String,
) -> CliTestExecutionIsolation:
	path: String = project_relative_path(path_value, project_root)

	match matching_root(FILESYSTEM_ISOLATED_TEST_ROOTS, path):
		Some(root):
			CliFreshTestFilesystem(root)
		None:
			match matching_root(PROCESS_ISOLATED_TEST_ROOTS, path):
				Some(root):
					CliFreshTestProcess(root)
				None:
					CliSharedTestProcess


private pure func is_leak_baseline_program(path_value: String, project_root: String) -> Bool:
	path: String = project_relative_path(path_value, project_root)
	path.ends_with(".brp") and path_under(LEAK_BASELINE_ROOT, path)


private pure func decl_has_main(decl: ParsedDecl) -> Bool:
	match decl:
		FunctionParsedDecl(function_decl):
			function_decl.name.text == "main"
		PrivateParsedDecl(inner, _):
			decl_has_main(inner)
		_:
			False


private pure func decl_has_tests_binding(decl: ParsedDecl) -> Bool:
	match decl:
		VarParsedDecl(var_decl):
			var_decl.name.text == "tests"
		PrivateParsedDecl(inner, _):
			decl_has_tests_binding(inner)
		_:
			False


private pure func decl_doc(decl: ParsedDecl) -> Option[String]:
	match decl:
		FunctionParsedDecl(function_decl):
			function_decl.doc
		RecordParsedDecl(record_decl):
			record_decl.doc
		UnionParsedDecl(union_decl):
			union_decl.doc
		BuiltinTypeParsedDecl(type_decl):
			type_decl.doc
		TypeAliasParsedDecl(type_alias):
			type_alias.doc
		TraitParsedDecl(trait_decl):
			trait_decl.doc
		ImplParsedDecl(impl_decl):
			impl_decl.doc
		PrivateParsedDecl(inner, _):
			decl_doc(inner)
		_:
			None


private pure func decl_has_doctests(decl: ParsedDecl) -> Bool:
	decl_doc(decl)
		.map(func(doc):
			doc
				.lines()
				.any(func(line): line.trim() == "doctests:")
		)
		.get_or(False)


pure func classify_test_source(program: ParsedProgram) -> CliTestSourceFeatures:
	{
		has_main = program.decls.any(decl_has_main),
		has_tests_binding = program.decls.any(decl_has_tests_binding),
		has_doctests = program.decls.any(decl_has_doctests)
	}


private union CliTestSuiteBindingCandidate:
	PublicTestSuiteBinding(SemanticType)
	PrivateTestSuiteBinding


private pure func test_suite_binding_candidates(
	decl: CompilerTypedDecl,
) -> List[CliTestSuiteBindingCandidate]:
	match decl:
		CompilerTypedGlobalVarDecl(info):
			if info.decl.name.text == "tests":
				[PublicTestSuiteBinding(info.binding_type)]
			else:
				[]
		CompilerTypedPrivateDecl(inner):
			if test_suite_binding_candidates(inner).length() > 0:
				[PrivateTestSuiteBinding]
			else:
				[]
		_:
			[]


pure func resolve_test_suite_binding(
	module: CompilerTypecheckedModule,
) -> CliTestSuiteBindingResolution:
	if parsed_program_has_errors(module.parsed_program) or module.errors.length() > 0:
		CliTestSuiteBindingInvalidProgram
	else:
		candidates: List[CliTestSuiteBindingCandidate] = module.typed_program.decls.flat_map(
			test_suite_binding_candidates,
		)

		match candidates:
			[]:
				CliTestSuiteBindingMissing
			[PrivateTestSuiteBinding]:
				CliTestSuiteBindingInaccessible
			[PublicTestSuiteBinding(binding_type)]:
				expected: SemanticType = SemanticNamedType(
					canonical_module_type_name(TEST_SUITE_MODULE, TEST_SUITE_TYPE),
					[],
				)

				if types_equal(binding_type, expected):
					CliTestSuiteBindingResolved
				else:
					CliTestSuiteBindingWrongType(binding_type)
			_:
				CliTestSuiteBindingAmbiguous


private func read_directory_entries(path_value: String) -> Result[List[DirectoryEntry], IOError]:
	with dir ?= open_dir(path_value):
		var entries: List[DirectoryEntry] = []
		var read_error: Option[IOError] = None

		while True:
			match read_next_entries(dir, DIRECTORY_READ_BATCH_SIZE):
				Ok(batch):
					if batch.length() == 0:
						break
					else:
						entries = entries.concat(batch)
				Err(err):
					read_error = Some(err)
					break

		match read_error:
			Some(err):
				Err(err)
			None:
				Ok(entries.sort_by(
					func(entry): entry.name,
				))


private func collect_directory_test_paths(path_value: String) -> Result[List[String], IOError]:
	if SKIP_DIRECTORIES.contains(basename(path_value)):
		Ok([])
	else:
		entries ?= read_directory_entries(path_value)
		var paths: List[String] = []
		var collect_error: Option[IOError] = None

		for entry in entries:
			full_path: String = path_value.join(entry.name)

			match entry.kind:
				EntryDirectory:
					match collect_directory_test_paths(full_path):
						Ok(child_paths):
							paths = paths.concat(child_paths)
						Err(err):
							collect_error = Some(err)
							break
				EntryFile:
					if full_path.ends_with(".brp"):
						paths = paths.append(full_path)
				EntryUnknown:
					-- The runtime already attempts an lstat fallback. Avoid
					-- following a raced symlink or opening a special file.
					void
				EntrySymlink:
					void
				EntryOther:
					void

		match collect_error:
			Some(err):
				Err(err)
			None:
				Ok(paths)


private func collect_test_paths(path_value: String) -> Result[List[String], IOError]:
	if not file_exists(path_value):
		Err(NotFound(path_value))
	else if is_directory(path_value):
		collect_directory_test_paths(path_value)
	else if path_value.ends_with(".brp"):
		Ok([path_value])
	else:
		Ok([])


private func read_parsed_program(path_value: String) -> Result[ParsedProgram, IOError]:
	with reader ?= open_read(path_value):
		source_text ?= reader.read_text()
		Ok(parse_compiler_source(compiler_source_file(path_value, stem(path_value), source_text)))


private pure func should_discover_test_source(
	program: ParsedProgram,
	features: CliTestSourceFeatures,
	include_leak_baseline_programs: Bool,
	leak_baseline_program: Bool,
) -> Bool:
	(
		features.has_tests_binding
		or features.has_doctests
		or parsed_program_has_errors(program)
		or include_leak_baseline_programs and leak_baseline_program
	)


func discover_test_sources(
	paths: List[String],
	project_root: String,
	include_leak_baseline_programs: Bool,
) -> Result[List[CliDiscoveredTestSource], IOError]:
	var candidate_paths: List[String] = []
	var collect_error: Option[IOError] = None

	for path_value in paths:
		match collect_test_paths(path_value):
			Ok(collected):
				candidate_paths = candidate_paths.concat(collected)
			Err(err):
				collect_error = Some(err)
				break

	var sources: List[CliDiscoveredTestSource] = []
	var read_error: Option[IOError] = None

	if collect_error.is_none():
		for path_value in (
			candidate_paths
				.map(normalize)
				.sort()
				.unique()
		):
			match read_parsed_program(path_value):
				Ok(program):
					features: CliTestSourceFeatures = classify_test_source(program)
					leak_baseline_program: Bool = is_leak_baseline_program(path_value, project_root)

					if should_discover_test_source(
						program,
						features,
						include_leak_baseline_programs,
						leak_baseline_program,
					):
						sources = sources.append({
							program = program,
							features = features,
							is_leak_baseline_program = leak_baseline_program,
							isolation = test_execution_isolation(path_value, project_root),
						})
				Err(err):
					read_error = Some(err)
					break

	match collect_error:
		Some(err):
			Err(err)
		None:
			match read_error:
				Some(err):
					Err(err)
				None:
					Ok(sources)
