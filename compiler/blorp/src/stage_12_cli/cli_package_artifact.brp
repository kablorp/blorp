-- Deterministic portable source-package artifact encoding.
--
-- The format is intentionally framed rather than JSON: source bytes are
-- arbitrary binary data and their exact representation participates in the
-- package hash. Paths are validated before any filesystem effect occurs.
import:
	../stage_04_modules/package_hash:
		CompilerPackageHashEntry,
		compiler_hash_package_entries,
		compiler_read_package_entries,
	bytes: Bytes, concat as concat_bytes
	fs: create_directories, message
	int: INT_MAX
	path: dirname
	system: file_size, read_bytes, write_bytes


private PACKAGE_ARTIFACT_MAGIC: String = "blorp-package-artifact-v1\0"

private PACKAGE_ARTIFACT_ENTRY_MARKER: String = "file\0"

private PACKAGE_ARTIFACT_TERMINATOR: Int = 0

-- Source packages are compiler input, not a bulk distribution format. A hard
-- ceiling bounds both local reads and remote download memory without limiting
-- realistic source trees.
CLI_PACKAGE_ARTIFACT_MAX_BYTES: Int = 256 * 1024 * 1024


private record PackageArtifactValue {
	value: Bytes,
	next_offset: Int
}


private pure func framed_artifact_value(value: Bytes) -> List[Bytes]:
	[
		value
			.length()
			.to_string()
			.to_bytes(),
		"\0".to_bytes(),
		value,
		"\0".to_bytes(),
	]


private pure func package_artifact_bytes(entries: List[CompilerPackageHashEntry]) -> Bytes:
	var parts: List[Bytes] = [PACKAGE_ARTIFACT_MAGIC.to_bytes()]

	for entry in entries:
		parts = parts
			.append(PACKAGE_ARTIFACT_ENTRY_MARKER.to_bytes())
			.concat(framed_artifact_value(entry.relative_path.to_bytes()))
			.concat(framed_artifact_value(entry.contents))

	concat_bytes(parts)


pure func validate_cli_package_artifact_size(
	artifact_path: String,
	size: Int,
) -> Result[Void, List[String]]:
	if size > CLI_PACKAGE_ARTIFACT_MAX_BYTES:
		Err(
			[
				"${artifact_path}: package artifact exceeds maximum size of ${CLI_PACKAGE_ARTIFACT_MAX_BYTES} bytes",
			],
		)
	else:
		Ok(void)


func write_cli_package_artifact(
	root: String,
	source_files: List[String],
	output: String,
) -> Result[String, List[String]]:
	entries ?= compiler_read_package_entries(root, source_files).map_err(func(errors):
		errors.map(func(error): error.message)
	)
	artifact: Bytes = package_artifact_bytes(entries)
	valid_size ?= validate_cli_package_artifact_size(output, artifact.length())
	written ?= write_bytes(output, artifact).map_err(func(error): [error])
	Ok(compiler_hash_package_entries(entries))


private pure func artifact_path_is_safe(path: String) -> Bool:
	if (
		path.length() == 0
		or path.starts_with("/")
		or path.contains("\\")
		or path
			.to_bytes()
			.index_of(PACKAGE_ARTIFACT_TERMINATOR, 0)
			.is_some()
	):
		False
	else:
		parts: List[String] = path.split("/")

		(
			parts.all(func(part): part.length() > 0 and part != "." and part != "..")
			and (path == "package.toml" or path.starts_with("src/"))
		)


private pure func bytes_match_at(bytes_value: Bytes, offset: Int, expected: Bytes) -> Bool:
	if offset < 0 or offset + expected.length() > bytes_value.length():
		False
	else:
		var matches: Bool = True
		var index: Int = 0

		while index < expected.length() and matches:
			matches = bytes_value.get(offset + index) == expected.get(index)
			index += 1

		matches


private pure func read_artifact_value(
	artifact_path: String,
	artifact: Bytes,
	offset: Int,
) -> Result[PackageArtifactValue, String]:
	separator ?= artifact
		.index_of(PACKAGE_ARTIFACT_TERMINATOR, offset)
		.to_result("${artifact_path}: truncated artifact length")

	if separator == offset:
		Err("${artifact_path}: empty artifact length")
	else:
		var value_length: Int = 0
		var index: Int = offset
		var error: Option[String] = None

		while index < separator and error.is_none():
			match artifact.get(index):
				None:
					error = Some("${artifact_path}: truncated artifact length")
				Some(byte):
					if byte < 48 or byte > 57:
						error = Some("${artifact_path}: invalid artifact length")
					else:
						digit: Int = byte - 48

						if value_length > (INT_MAX - digit) / 10:
							error = Some("${artifact_path}: artifact length is too large")
						else:
							value_length = value_length * 10 + digit

			index += 1

		match error:
			Some(detail):
				Err(detail)
			None:
				value_start: Int = separator + 1
				remaining: Int = artifact.length() - value_start

				if remaining <= 0 or value_length > remaining - 1:
					Err("${artifact_path}: truncated artifact value")
				else:
					value_end: Int = value_start + value_length

					if artifact.get(value_end) != Some(PACKAGE_ARTIFACT_TERMINATOR):
						Err("${artifact_path}: artifact value missing terminator")
					else:
						Ok({
							value = artifact.slice(value_start, value_length),
							next_offset = value_end + 1,
						})


pure func parse_cli_package_artifact(
	artifact_path: String,
	artifact: Bytes,
) -> Result[List[CompilerPackageHashEntry], List[String]]:
	valid_size ?= validate_cli_package_artifact_size(artifact_path, artifact.length())

	if not bytes_match_at(artifact, 0, PACKAGE_ARTIFACT_MAGIC.to_bytes()):
		Err(["${artifact_path}: not a blorp package artifact"])
	else:
		var entries: List[CompilerPackageHashEntry] = []
		var seen_paths: List[String] = []
		var offset: Int = PACKAGE_ARTIFACT_MAGIC.length()
		var error: Option[String] = None

		while offset < artifact.length() and error.is_none():
			if not bytes_match_at(artifact, offset, PACKAGE_ARTIFACT_ENTRY_MARKER.to_bytes()):
				error = Some("${artifact_path}: invalid package artifact entry marker")
			else:
				match read_artifact_value(
					artifact_path,
					artifact,
					offset + PACKAGE_ARTIFACT_ENTRY_MARKER.length(),
				):
					Err(detail):
						error = Some(detail)
					Ok(path_value):
						relative_path: String = path_value.value.to_string()

						if not artifact_path_is_safe(relative_path):
							error = Some(
								"${artifact_path}: package artifact contains unsafe path `${relative_path}`",
							)
						else if seen_paths.contains(relative_path):
							error = Some(
								"${artifact_path}: package artifact contains duplicate path `${relative_path}`",
							)
						else:
							match read_artifact_value(
								artifact_path,
								artifact,
								path_value.next_offset,
							):
								Err(detail):
									error = Some(detail)
								Ok(contents_value):
									seen_paths = seen_paths.append(relative_path)
									entries = entries.append({
										relative_path = relative_path,
										contents = contents_value.value,
									})
									offset = contents_value.next_offset

		match error:
			Some(detail):
				Err([detail])
			None:
				Ok(entries)


func read_cli_package_artifact(
	artifact_path: String,
) -> Result[List[CompilerPackageHashEntry], List[String]]:
	size ?= file_size(artifact_path).map_err(func(error): [error])
	valid_size ?= validate_cli_package_artifact_size(artifact_path, size)
	artifact ?= read_bytes(artifact_path).map_err(func(error): [error])
	parse_cli_package_artifact(artifact_path, artifact)


func unpack_cli_package_artifact_entries(
	target: String,
	entries: List[CompilerPackageHashEntry],
) -> Result[Void, List[String]]:
	unsafe_entry: Option[CompilerPackageHashEntry] = entries.find(func(entry):
		not artifact_path_is_safe(entry.relative_path)
	)

	match unsafe_entry:
		Some(entry):
			Err(["package artifact contains unsafe path `${entry.relative_path}`"])
		None:
			var write_error: Option[String] = None

			for entry in entries:
				if write_error.is_none():
					path: String = target + "/" + entry.relative_path

					match create_directories(dirname(path)):
						Err(error):
							write_error = Some(message(error))
						Ok(_):
							match write_bytes(path, entry.contents):
								Err(error):
									write_error = Some(error)
								Ok(_):
									void

			match write_error:
				Some(error):
					Err([error])
				None:
					Ok(void)
