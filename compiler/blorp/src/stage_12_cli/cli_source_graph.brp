private CURRENT_PACKAGE_STD_COMPAT: String = "preview-1"

private IMPLICIT_PRELUDE_MODULE: String = "std/prelude"

private IMPLICIT_TUPLE_IMPL_MODULE: String = "std/tuple"

private TEST_RUNTIME_MODULE: String = "std/test"


private pure func finalized_program_for_source(
	path: String,
	module_name: String,
	text: String,
) -> FinalizedTypecheckProgram:
	finalized_typecheck_program(
		parse_compiler_source(compiler_source_file(path, module_name, text)),
	)


private pure func absolute_normalized_path(cwd: String, path: String) -> String:
	if path.starts_with("/"):
		normalize(path)
	else:
		normalize(join(cwd, path))


private pure func is_path_under_dir(dir: String, path: String) -> Bool:
	normalized_dir: String = normalize(dir)
	normalized_path: String = normalize(path)
	normalized_path == normalized_dir or normalized_path.starts_with(normalized_dir + "/")


private func should_auto_format_cli_source(path: String) -> Bool:
	cwd: String = getcwd()
	std_dir: String = normalize(join(cwd, "std"))
	source_path: String = absolute_normalized_path(cwd, path)

	not is_path_under_dir(std_dir, source_path)


private func env_disables_auto_format() -> Bool:
	match getenv("BLORP_NO_FORMAT"):
		Some(value):
			value == "1"
		None:
			False


private func action_uses_auto_format(action: CliAction) -> Bool:
	-- Test discovery is intentionally read-only. Test sources are parsed as-is;
	-- formatting remains an explicit command instead of a test side effect.
	if env_disables_auto_format():
		False
	else:
		match action:
			CliCheck(args):
				not args.no_format
			CliCompile(args):
				not args.no_format
			CliRun(args):
				not args.no_format
			_:
				False


private pure func format_cli_source_error(
	path: String,
	format_result: FormatCommandResult,
) -> String:
	detail: String = if format_result.stderr != "":
		format_result.stderr.trim_right()
	else if format_result.stdout != "":
		format_result.stdout.trim_right()
	else:
		"failed to format source file `" + path + "`"

	if detail == "":
		"failed to format source file `" + path + "`"
	else:
		detail


private func auto_format_cli_source_if_needed(
	action: CliAction,
	path: String,
) -> Result[Void, String]:
	if action_uses_auto_format(action) and should_auto_format_cli_source(path):
		format_result: FormatCommandResult = run_format_command([path])

		if format_result.status == 0:
			Ok(void)
		else:
			Err(format_cli_source_error(path, format_result))
	else:
		Ok(void)


private pure func single_path(paths: List[String]) -> Option[String]:
	match paths:
		[path]:
			Some(path)
		_:
			None


func frontend_source_for_action(action: CliAction) -> Option[String]:
	match action:
		CliCompile(args):
			single_path(args.files)
		CliRun(args):
			single_path(args.files)
		_:
			None


private func expand_check_target(path: String) -> Result[CliCheckTargetExpansion, String]:
	if not file_exists(path):
		Err("failed to read source file `" + path + "`: not found: " + path)
	else if is_directory(path):
		Ok({
			targets = [CliSourceDirectoryTarget(path)],
			source_paths = walk_dir(path).filter(func(source_path): source_path.ends_with(".brp")),
		})
	else:
		Ok({
			targets = [CliSourceFileTarget(path)],
			source_paths = [path],
		})


func expand_check_targets(paths: List[String]) -> Result[CliCheckTargetExpansion, String]:
	var targets: List[CliSourceTarget] = []
	var source_paths: List[String] = []
	var error: Option[String] = None

	for path in paths:
		match error:
			Some(_):
				break
			None:
				match expand_check_target(path):
					Ok(expansion):
						targets = targets.concat(expansion.targets)
						source_paths = source_paths.concat(expansion.source_paths)
					Err(message):
						error = Some(message)

	match error:
		Some(message):
			Err(message)
		None:
			Ok({
				targets = targets,
				source_paths = source_paths.sort(),
			})


private func read_text_file(path: String) -> Result[String, String]:
	with reader ?= open_read(path) on err => message(err):
		match reader.read_text():
			Ok(source):
				Ok(source)
			Err(err):
				Err(message(err))


private func read_cli_source_file(path: String) -> Result[CliSourceFile, String]:
	source ?= read_text_file(
		path,
	).map_err(
		func(err): "failed to read source file `" + path + "`: " + err,
	)

	Ok({
		path = path,
		module_name = stem(path),
		source_text = source,
	})


func read_cli_source_file_for_action(
	action: CliAction,
	path: String,
) -> Result[CliSourceFile, String]:
	match auto_format_cli_source_if_needed(action, path):
		Ok(_):
			read_cli_source_file(path)
		Err(message):
			Err(message)


func read_cli_sources_for_action(
	action: CliAction,
	paths: List[String],
) -> Result[List[CliSourceFile], String]:
	var sources: List[CliSourceFile] = []
	var error: Option[String] = None

	for path in paths:
		match error:
			Some(_):
				break
			None:
				match read_cli_source_file_for_action(action, path):
					Ok(source):
						sources = sources.append(source)
					Err(message):
						error = Some(message)

	match error:
		Some(message):
			Err(message)
		None:
			Ok(sources)


pure func single_explicit_check_source(
	expansion: CliCheckTargetExpansion,
	sources: List[CliSourceFile],
) -> Option[CliSourceFile]:
	match expansion.targets:
		[CliSourceFileTarget(path)]:
			match sources:
				[source]:
					if source.path == path:
						Some(source)
					else:
						None
				_:
					None
		_:
			None


func parse_cli_source(source: CliSourceFile) -> Result[CliParsedSourceFile, String]:
	Ok({
		path = source.path,
		module_name = source.module_name,
		source_text = source.source_text,
		typecheck_program = finalized_program_for_source(
			source.path,
			source.module_name,
			source.source_text,
		),
	})


pure func parsed_cli_source_from_program(program: ParsedProgram) -> CliParsedSourceFile:
	{
		path = program.source.path,
		module_name = program.source.module_name,
		source_text = program.source.text,
		typecheck_program = finalized_typecheck_program(program)
	}


func parse_cli_sources(sources: List[CliSourceFile]) -> Result[List[CliParsedSourceFile], String]:
	var parsed_sources: List[CliParsedSourceFile] = []
	var error: Option[String] = None

	for source in sources:
		if error.is_some():
			break

		match parse_cli_source(source):
			Ok(parsed):
				parsed_sources = parsed_sources.append(parsed)
			Err(message):
				error = Some(message)

	match error:
		Some(message):
			Err(message)
		None:
			Ok(parsed_sources)


union CliResolvedImportContents:
	CliFilesystemImport
	CliEmbeddedImport(String)


record CliResolvedImportSource {
	path: String,
	module_name: String,
	contents: CliResolvedImportContents
}


private pure func action_std_dir(action: CliAction) -> Option[String]:
	match action:
		CliCheck(args):
			args.std_dir
		CliCompile(args):
			args.std_dir
		CliRun(args):
			args.std_dir
		CliTest(args):
			args.std_dir
		_:
			None


private func action_or_env_std_dir(action: CliAction) -> Option[String]:
	match action_std_dir(action):
		Some(path):
			Some(path)
		None:
			match getenv("BLORP_STD"):
				Some(path):
					if path.trim() == "":
						None
					else:
						Some(path)
				None:
					None


private pure func strip_prefix(prefix: String, text: String) -> String:
	text.drop_left(prefix.length())


private pure func absolute_path_from(cwd: String, path: String) -> String:
	if path.starts_with("/"):
		normalize(path)
	else:
		normalize(join(cwd, path))


private func absolute_path(path: String) -> String:
	absolute_path_from(getcwd(), path)


private func module_name_for_resolved_source_path(path: String) -> String:
	cwd: String = normalize(getcwd())
	absolute: String = absolute_path(path)

	relative: String = if is_path_under_dir(cwd, absolute):
		strip_prefix(cwd + "/", absolute)
	else:
		absolute

	if relative.ends_with(".brp"):
		relative.substring(0, relative.length() - 4)
	else:
		relative


private pure func config_relative_path(config_dir: String, path: String) -> String:
	if path.starts_with("/"):
		normalize(path)
	else:
		normalize(join(config_dir, path))


private pure func is_identifier_start(ch: Char) -> Bool:
	ch >= 'a' and ch <= 'z' or ch >= 'A' and ch <= 'Z' or ch == '_'


private pure func is_blorp_identifier(text: String) -> Bool:
	if text.length() == 0:
		False
	else:
		match text.get(0):
			Some(first):
				if not is_identifier_start(first):
					False
				else:
					var ok: Bool = True
					var i: Int = 1

					while i < text.length() and ok:
						match text.get(i):
							Some(ch):
								if not (is_identifier_start(ch) or ch >= '0' and ch <= '9'):
									ok = False
							None:
								ok = False

						i += 1

					ok
			None:
				False


private pure func valid_package_alias(package_alias: String) -> Bool:
	is_blorp_identifier(package_alias) and package_alias != "std" and package_alias != "pkg"


private pure func append_unique_string(values: List[String], value: String) -> List[String]:
	if values.contains(value):
		values
	else:
		values.append(value)


private pure func module_source_filename(module_path: String) -> String:
	if module_path.ends_with(".brp"):
		module_path
	else:
		module_path + ".brp"


private pure func toml_string_value(value: TomlValue) -> Option[String]:
	match value:
		TomlString(text):
			Some("" + text)
		_:
			None


private pure func toml_string_list_value(value: TomlValue) -> Option[List[String]]:
	match value:
		TomlArray(items):
			var strings: List[String] = []
			var ok: Bool = True

			for item in items:
				if not ok:
					break

				match item:
					TomlString(text):
						strings = strings.append("" + text)
					_:
						ok = False

			if ok:
				Some(strings)
			else:
				None
		_:
			None


private pure func toml_table_string_field(value: TomlValue, field_name: String) -> Option[String]:
	match value:
		TomlTable(fields):
			match fields.get(field_name):
				Some(field):
					toml_string_value(field)
				None:
					None
		_:
			None


private pure func toml_table_string_list_field(
	value: TomlValue,
	field_name: String,
) -> Option[List[String]]:
	match value:
		TomlTable(fields):
			match fields.get(field_name):
				Some(field):
					toml_string_list_value(field)
				None:
					None
		_:
			None


private pure func toml_string_at(toml: TomlValue, key: String) -> Option[String]:
	match toml_lookup(toml, key):
		Some(value):
			toml_string_value(value)
		None:
			None


private pure func toml_string_list_at(toml: TomlValue, key: String) -> Option[List[String]]:
	match toml_lookup(toml, key):
		Some(value):
			toml_string_list_value(value)
		None:
			None


private pure func package_alias_from_toml_key(key: String) -> Option[String]:
	if not key.starts_with("packages."):
		None
	else:
		rest: String = strip_prefix("packages.", key)

		match rest.split("."):
			[package_alias]:
				if valid_package_alias(package_alias):
					Some(package_alias)
				else:
					None
			[package_alias, _]:
				if valid_package_alias(package_alias):
					Some(package_alias)
				else:
					None
			_:
				None


private pure func package_aliases_from_toml(toml: TomlValue) -> List[String]:
	match toml:
		TomlTable(fields):
			var aliases: List[String] = []

			for key in fields.keys():
				match package_alias_from_toml_key(key):
					Some(package_alias):
						aliases = append_unique_string(aliases, package_alias)
					None:
						void

			aliases
		_:
			[]


private pure func package_alias_inline_value(
	toml: TomlValue,
	package_alias: String,
) -> Option[TomlValue]:
	toml_lookup(toml, "packages." + package_alias)


private pure func package_alias_string_config(
	toml: TomlValue,
	package_alias: String,
	field_name: String,
) -> Option[String]:
	match toml_string_at(toml, "packages." + package_alias + "." + field_name):
		Some(value):
			Some(value)
		None:
			match package_alias_inline_value(toml, package_alias):
				Some(inline_value):
					toml_table_string_field(inline_value, field_name)
				None:
					None


private pure func package_alias_string_list_config(
	toml: TomlValue,
	package_alias: String,
	field_name: String,
) -> Option[List[String]]:
	match toml_string_list_at(toml, "packages." + package_alias + "." + field_name):
		Some(value):
			Some(value)
		None:
			match package_alias_inline_value(toml, package_alias):
				Some(inline_value):
					toml_table_string_list_field(inline_value, field_name)
				None:
					None


private pure func is_hex_string(text: String) -> Bool:
	if text.length() == 0:
		False
	else:
		var ok: Bool = True
		var i: Int = 0

		while i < text.length() and ok:
			match text.get(i):
				Some(ch):
					if not ((
						ch >= '0' and ch <= '9'
						or ch >= 'a' and ch <= 'f'
						or ch >= 'A' and ch <= 'F'
					)):
						ok = False
				None:
					ok = False

			i += 1

		ok


private pure func normalize_hash_pin(pin: String) -> Option[String]:
	lower_pin: String = pin
		.trim()
		.lower()

	hash: String = if lower_pin.starts_with("blake3:"):
		strip_prefix("blake3:", lower_pin)
	else:
		lower_pin

	if (
		hash.length() >= 16
		and hash.length() <= 64
		and is_hex_string(hash)
	):
		Some(hash)
	else:
		None


private func package_cache_root() -> String:
	match getenv("BLORP_PACKAGE_CACHE"):
		Some(path):
			if (
				path
					.trim()
					.length() > 0
			):
				path
			else:
				package_cache_root_without_override()
		None:
			package_cache_root_without_override()


private func package_cache_root_without_override() -> String:
	cache_base: String = match getenv("XDG_CACHE_HOME"):
		Some(path):
			if (
				path
					.trim()
					.length() > 0
			):
				path
			else:
				default_package_cache_base()
		None:
			default_package_cache_base()

	join(
		join(cache_base, "blorp"),
		"packages",
	)


private func default_package_cache_base() -> String:
	match getenv("HOME"):
		Some(home):
			if (
				home
					.trim()
					.length() > 0
			):
				join(home, ".cache")
			else:
				join(temp_dir(), ".cache")
		None:
			join(temp_dir(), ".cache")


private func cached_package_root_for_pin(pin: String) -> Option[String]:
	match normalize_hash_pin(pin):
		Some(normalized):
			cache_dir: String = join(
				join(package_cache_root(), "blake3"),
				normalized.take_left(16),
			)

			if not file_exists(join(cache_dir, "READY")):
				None
			else:
				match read_text_file(join(cache_dir, "HASH")):
					Ok(actual):
						if (
							actual
								.trim()
								.lower()
								.starts_with(normalized)
						):
							Some(cache_dir)
						else:
							None
					Err(_):
						None
		None:
			None


private pure func package_cache_fetch_help(
	package_alias: String,
	locations: List[String],
) -> String:
	if locations.length() == 0:
		"Add from = [...] for package `${package_alias}` and run `blorp package fetch ${package_alias}`, or configure a local path."
	else:
		"Run `blorp package fetch ${package_alias}` from the project directory before compiling."


private func package_root_for_alias(
	config_dir: String,
	toml: TomlValue,
	package_alias: String,
) -> Result[String, String]:
	match package_alias_string_config(toml, package_alias, "path"):
		Some(path):
			if (
				path
					.trim()
					.length() == 0
			):
				Err("package alias `${package_alias}` has an empty path")
			else:
				Ok(config_relative_path(config_dir, path))
		None:
			match package_alias_string_config(toml, package_alias, "hash"):
				Some(pin):
					match normalize_hash_pin(pin):
						Some(_):
							match cached_package_root_for_pin(pin):
								Some(package_root):
									Ok(package_root)
								None:
									locations: List[String] = match package_alias_string_list_config(
										toml,
										package_alias,
										"from",
									):
										Some(locations):
											locations
										None:
											[]

									help: String = package_cache_fetch_help(
										package_alias,
										locations,
									)

									Err(
										"package alias `${package_alias}` cannot use hash ${pin} from the local package cache\nhelp: ${help}",
									)
						None:
							Err("package alias `${package_alias}` has an invalid hash pin: ${pin}")
				None:
					Err("package alias `${package_alias}` must define path or hash")


record CliPackageManifest {
	name: String,
	std_compat: String,
	exports: List[String]
}


record CliSourceGraphConfig {
	std_dir: Option[String],
	source_packages: List[CliFrontendSourcePackage],
	diagnostics: List[String]
}


record CliConfiguredSourcePackages {
	packages: List[CliFrontendSourcePackage],
	diagnostics: List[String]
}


private pure func package_manifest_from_toml(toml: TomlValue) -> Option[CliPackageManifest]:
	name ?= toml_string_at(toml, "package.name")
	std_compat ?= toml_string_at(toml, "compat.std")
	exports ?= toml_string_list_at(toml, "exports.modules")

	if (
		valid_package_alias(name)
		and std_compat == CURRENT_PACKAGE_STD_COMPAT
		and exports.length() > 0
	):
		Some({
			name = name,
			std_compat = std_compat,
			exports = exports,
		})
	else:
		None


private func package_exports_exist(source_dir: String, exports: List[String]) -> Bool:
	var ok: Bool = True

	for module_name in exports:
		if not file_exists(join(source_dir, module_source_filename(module_name))):
			ok = False
			break

	ok


private func read_source_package(
	package_alias: String,
	package_root: String,
) -> Option[CliFrontendSourcePackage]:
	normalized_root: String = normalize(package_root)
	source_dir: String = normalize(join(normalized_root, "src"))

	if not is_directory(source_dir):
		None
	else:
		match read_text_file(join(normalized_root, "package.toml")):
			Ok(source):
				match parse_toml(source):
					Ok(toml):
						match package_manifest_from_toml(toml):
							Some(manifest):
								if package_exports_exist(source_dir, manifest.exports):
									Some({
										package_alias = package_alias,
										package_name = manifest.name,
										package_root = normalized_root,
										source_dir = source_dir,
										exports = manifest.exports,
									})
								else:
									None
							None:
								None
					Err(_):
						None
			Err(_):
				None


private func find_blorp_config_from_dir(base_dir: String) -> Option[String]:
	var current: String = absolute_path(base_dir)
	var result: Option[String] = None
	var done: Bool = False

	while not done:
		candidate: String = join(current, "blorp.toml")

		if file_exists(candidate) and not is_directory(candidate):
			result = Some(candidate)
			done = True
		else:
			parent: String = dirname(current)

			if parent == current:
				done = True
			else:
				current = parent

	result


private pure func source_package_seen(
	packages: List[CliFrontendSourcePackage],
	package_alias: String,
	source_dir: String,
) -> Bool:
	var seen: Bool = False

	for package in packages:
		if package.package_alias == package_alias and package.source_dir == source_dir:
			seen = True
			break

	seen


private pure func config_std_dir_from_toml(config_dir: String, toml: TomlValue) -> Option[String]:
	match toml_string_at(toml, "std.path"):
		Some(path):
			if (
				path
					.trim()
					.length() == 0
			):
				None
			else:
				Some(config_relative_path(config_dir, path))
		None:
			None


private func source_packages_from_config_toml(
	config_dir: String,
	toml: TomlValue,
) -> CliConfiguredSourcePackages:
	var packages: List[CliFrontendSourcePackage] = []
	var diagnostics: List[String] = []

	for package_alias in package_aliases_from_toml(toml):
		match package_root_for_alias(config_dir, toml, package_alias):
			Ok(package_root):
				match read_source_package(package_alias, package_root):
					Some(package):
						if not source_package_seen(
							packages,
							package.package_alias,
							package.source_dir,
						):
							packages = packages.append(package)
					None:
						diagnostics = append_unique_string(
							diagnostics,
							"package alias `${package_alias}` does not resolve to a valid source package at `${package_root}`",
						)
			Err(message):
				diagnostics = append_unique_string(diagnostics, message)

	{
		packages = packages,
		diagnostics = diagnostics
	}


private func source_graph_config(config_path: String) -> CliSourceGraphConfig:
	config_dir: String = dirname(config_path)

	match read_text_file(config_path):
		Ok(source):
			match parse_toml(source):
				Ok(toml):
					configured_packages = source_packages_from_config_toml(config_dir, toml)

					{
						std_dir = config_std_dir_from_toml(config_dir, toml),
						source_packages = configured_packages.packages,
						diagnostics = configured_packages.diagnostics
					}
				Err(message):
					{
						std_dir = None,
						source_packages = [],
						diagnostics = ["failed to parse `${config_path}`: ${message}"]
					}
		Err(message):
			{
				std_dir = None,
				source_packages = [],
				diagnostics = ["failed to read `${config_path}`: ${message}"]
			}


private func find_pkg_root_from_dir(base_dir: String) -> Option[String]:
	var current: String = absolute_path(base_dir)
	var result: Option[String] = None
	var done: Bool = False

	while not done:
		candidate: String = join(current, "pkg")

		if is_directory(candidate):
			result = Some(candidate)
			done = True
		else:
			parent: String = dirname(current)

			if parent == current:
				done = True
			else:
				current = parent

	result


private pure func append_unique_package(
	packages: List[CliFrontendSourcePackage],
	package: CliFrontendSourcePackage,
) -> List[CliFrontendSourcePackage]:
	if source_package_seen(packages, package.package_alias, package.source_dir):
		packages
	else:
		packages.append(package)


private pure func append_unique_packages(
	packages: List[CliFrontendSourcePackage],
	more: List[CliFrontendSourcePackage],
) -> List[CliFrontendSourcePackage]:
	var result: List[CliFrontendSourcePackage] = packages

	for package in more:
		result = append_unique_package(result, package)

	result


private pure func conflicting_package_alias(
	packages: List[CliFrontendSourcePackage],
	package: CliFrontendSourcePackage,
) -> Option[CliFrontendSourcePackage]:
	packages.find(
		func(
			existing,
		): (
			existing.package_alias == package.package_alias
			and existing.source_dir != package.source_dir
		),
	)


record CliSourceGraphSetup {
	context: CliFrontendGraphContext,
	diagnostics: List[String]
}


func source_graph_setup_for_paths(
	action: CliAction,
	root_paths: List[String],
) -> CliSourceGraphSetup:
	var std_dir: Option[String] = action_or_env_std_dir(action)
	explicit_std_dir: Bool = std_dir.is_some()
	var source_packages: List[CliFrontendSourcePackage] = []
	var package_roots: List[String] = []
	var diagnostics: List[String] = []
	cwd_pkg: String = join(getcwd(), "pkg")

	if is_directory(cwd_pkg):
		package_roots = append_unique_string(package_roots, normalize(cwd_pkg))

	for root_path in root_paths:
		base_dir: String = dirname(root_path)

		match find_blorp_config_from_dir(base_dir):
			Some(config_path):
				config: CliSourceGraphConfig = source_graph_config(config_path)

				if not explicit_std_dir:
					match (std_dir, config.std_dir):
						(None, Some(configured)):
							std_dir = Some(configured)
						(Some(selected), Some(configured)):
							if selected != configured:
								diagnostics = append_unique_string(
									diagnostics,
									"source roots require conflicting standard-library directories `${selected}` and `${configured}`",
								)
						_:
							void

				for package in config.source_packages:
					match conflicting_package_alias(source_packages, package):
						Some(existing):
							diagnostics = append_unique_string(
								diagnostics,
								"package alias `${package.package_alias}` resolves to both `${existing.source_dir}` and `${package.source_dir}`",
							)
						None:
							void

				source_packages = append_unique_packages(source_packages, config.source_packages)

				for diagnostic in config.diagnostics:
					diagnostics = append_unique_string(diagnostics, diagnostic)
			None:
				void

		match find_pkg_root_from_dir(base_dir):
			Some(pkg_root):
				package_roots = append_unique_string(package_roots, normalize(pkg_root))
			None:
				void

	{
		context = {
			std_dir = std_dir,
			source_packages = source_packages,
			package_roots = package_roots
		},
		diagnostics = diagnostics
	}


private func source_graph_setup_for_sources(
	action: CliAction,
	roots: List[CliParsedSourceFile],
) -> CliSourceGraphSetup:
	source_graph_setup_for_paths(
		action,
		roots.map(func(root): root.path),
	)


private pure func split_module_ref(module_path: String) -> Option[(String, String)]:
	match module_path.split("/"):
		[]:
			None
		[""]:
			None
		[head]:
			if head.length() == 0:
				None
			else:
				Some((head, ""))
		[head, ...rest]:
			if head.length() == 0:
				None
			else:
				Some((head, rest.join("/")))


private func source_package_for_path(
	context: CliFrontendGraphContext,
	path: String,
) -> Option[CliFrontendSourcePackage]:
	if context.source_packages.length() == 0:
		None
	else:
		var result: Option[CliFrontendSourcePackage] = None
		absolute: String = absolute_path(path)

		for package in context.source_packages:
			if is_path_under_dir(package.source_dir, absolute):
				result = Some(package)
				break

		result


private func path_is_in_configured_std(context: CliFrontendGraphContext, path: String) -> Bool:
	match context.std_dir:
		Some(std_dir):
			is_path_under_dir(absolute_path(std_dir), absolute_path(path))
		None:
			False


private func configured_std_module_name(
	context: CliFrontendGraphContext,
	path: String,
) -> Option[String]:
	match context.std_dir:
		Some(std_dir):
			std_root: String = absolute_path(std_dir)
			absolute: String = absolute_path(path)

			if is_path_under_dir(std_root, absolute):
				relative: String = strip_prefix(std_root + "/", absolute)

				without_extension: String = if relative.ends_with(".brp"):
					relative.substring(0, relative.length() - 4)
				else:
					relative

				Some("std/" + without_extension)
			else:
				None
		None:
			None


private pure func parsed_source_with_module_name(
	source: CliParsedSourceFile,
	module_name: String,
) -> CliParsedSourceFile:
	{ source |
		module_name = module_name,
		typecheck_program = finalized_program_for_source(
			source.path,
			module_name,
			source.source_text,
		)
	}


private pure func cli_source_with_module_name(
	source: CliSourceFile,
	module_name: String,
) -> CliSourceFile:
	{ source | module_name = module_name }


private func parse_cli_source_with_context(
	context: CliFrontendGraphContext,
	source: CliSourceFile,
) -> Result[CliParsedSourceFile, String]:
	match configured_std_module_name(context, source.path):
		Some(module_name):
			if module_name == source.module_name:
				parse_cli_source(source)
			else:
				parse_cli_source(cli_source_with_module_name(source, module_name))
		None:
			parse_cli_source(source)


func parse_cli_source_with_setup(
	setup: CliSourceGraphSetup,
	source: CliSourceFile,
) -> Result[CliParsedSourceFile, String]:
	parse_cli_source_with_context(setup.context, source)


func parse_cli_sources_with_setup(
	setup: CliSourceGraphSetup,
	sources: List[CliSourceFile],
) -> Result[List[CliParsedSourceFile], String]:
	var parsed_sources: List[CliParsedSourceFile] = []
	var error: Option[String] = None

	for source in sources:
		if error.is_some():
			break

		match parse_cli_source_with_context(setup.context, source):
			Ok(parsed):
				parsed_sources = parsed_sources.append(parsed)
			Err(message):
				error = Some(message)

	match error:
		Some(message):
			Err(message)
		None:
			Ok(parsed_sources)


private func normalize_root_module_name(
	context: CliFrontendGraphContext,
	source: CliParsedSourceFile,
) -> CliParsedSourceFile:
	match configured_std_module_name(context, source.path):
		Some(module_name):
			if module_name == source.module_name:
				source
			else:
				parsed_source_with_module_name(source, module_name)
		None:
			source


private func normalize_root_module_names(
	context: CliFrontendGraphContext,
	roots: List[CliParsedSourceFile],
) -> List[CliParsedSourceFile]:
	roots.map(func(source): normalize_root_module_name(context, source))


private func frontend_module_origin_for_path(
	context: CliFrontendGraphContext,
	path: String,
	module_name: String,
) -> CliFrontendModuleOrigin:
	if module_name.starts_with("std/") or path_is_in_configured_std(context, path):
		CliFrontendStdModule
	else if module_name.starts_with("pkg/"):
		match split_module_ref(strip_prefix("pkg/", module_name)):
			Some((package_id, _)):
				CliFrontendPkgModule(package_id)
			None:
				CliFrontendPkgModule("pkg")
	else:
		match source_package_for_path(context, path):
			Some(package):
				CliFrontendSourcePackageModule(package.package_alias)
			None:
				CliFrontendUserModule


private func frontend_graph_source(
	context: CliFrontendGraphContext,
	source: CliParsedSourceFile,
) -> CliFrontendGraphSource:
	{
		path = source.path,
		module_name = source.module_name,
		source_text = source.source_text,
		typecheck_program = source.typecheck_program,
		origin = frontend_module_origin_for_path(context, source.path, source.module_name)
	}


private func frontend_graph_sources(
	context: CliFrontendGraphContext,
	sources: List[CliParsedSourceFile],
) -> List[CliFrontendGraphSource]:
	var graph_sources: List[CliFrontendGraphSource] = []

	for source in sources:
		graph_sources = graph_sources.append(frontend_graph_source(context, source))

	graph_sources


private pure func filesystem_import_source(
	path: String,
	module_name: String,
) -> CliResolvedImportSource:
	{
		path = normalize(path),
		module_name = module_name,
		contents = CliFilesystemImport
	}


private pure func embedded_std_import_source(
	module_name: String,
) -> Option[CliResolvedImportSource]:
	source_text ?= embedded_std_source(module_name)

	Some({
		path = "<embedded:${module_name}>",
		module_name = module_name,
		contents = CliEmbeddedImport(source_text),
	})


private pure func compiler_source_package_layout(
	package: CliFrontendSourcePackage,
) -> CompilerSourcePackageLayout:
	{
		package_alias = package.package_alias,
		package_name = package.package_name,
		source_dir = package.source_dir,
		exports = package.exports
	}


private func resolve_source_package_alias_import(
	context: CliFrontendGraphContext,
	module_path: String,
) -> Option[CliResolvedImportSource]:
	var result: Option[CliResolvedImportSource] = None

	for package in context.source_packages:
		if result.is_some():
			break

		layout = compiler_source_package_layout(package)

		match compiler_source_package_export_for_alias(layout, module_path):
			Some(package_module):
				path = compiler_source_package_path_for_module(layout, package_module)

				if file_exists(path):
					result = Some(filesystem_import_source(path, module_path))
			None:
				void

	result


private func resolve_source_package_internal_import(
	package: CliFrontendSourcePackage,
	module_path: String,
) -> Option[CliResolvedImportSource]:
	layout = compiler_source_package_layout(package)

	if compiler_source_package_contains_internal_module(layout, module_path):
		path = compiler_source_package_path_for_module(layout, module_path)

		if file_exists(path):
			Some(filesystem_import_source(path, module_path))
		else:
			None
	else:
		None


private func resolve_native_package_import(
	context: CliFrontendGraphContext,
	module_path: String,
) -> Option[CliResolvedImportSource]:
	rest: String = strip_prefix("pkg/", module_path)
	var result: Option[CliResolvedImportSource] = None

	for package_root in context.package_roots:
		if result.is_some():
			break

		candidate: String = join(package_root, module_source_filename(rest))

		if file_exists(candidate):
			result = Some(filesystem_import_source(candidate, module_path))

	result


private func resolve_standard_library_import(
	context: CliFrontendGraphContext,
	module_path: String,
) -> Option[CliResolvedImportSource]:
	match context.std_dir:
		Some(dir):
			rest: String = strip_prefix("std/", module_path)
			path: String = join(dir, module_source_filename(rest))

			if file_exists(path):
				Some(filesystem_import_source(path, module_path))
			else:
				None
		None:
			embedded_std_import_source(module_path)


private pure func source_package_with_alias(
	context: CliFrontendGraphContext,
	package_alias: String,
) -> Option[CliFrontendSourcePackage]:
	context.source_packages.find(func(package): package.package_alias == package_alias)


private func resolve_path_import(
	path: String,
	confinement_origin: Option[CompilerModuleOrigin],
	context: CliFrontendGraphContext,
) -> Option[CliResolvedImportSource]:
	allowed: Bool = match confinement_origin:
		Some(CompilerSourcePackageModule(package_alias)):
			match source_package_with_alias(context, package_alias):
				Some(package):
					is_path_under_dir(package.source_dir, path)
				None:
					False
		_:
			True

	if allowed and file_exists(path):
		Some(filesystem_import_source(path, module_name_for_resolved_source_path(path)))
	else:
		None


private func resolve_frontend_import_lookup(
	context: CliFrontendGraphContext,
	lookup: CompilerFrontendImportLookup,
) -> Option[CliResolvedImportSource]:
	match lookup:
		CompilerFrontendNativePackageLookup(module_path):
			resolve_native_package_import(context, module_path)
		CompilerFrontendStandardLibraryLookup(module_path):
			resolve_standard_library_import(context, module_path)
		CompilerFrontendRelativePathLookup(path, confinement_origin):
			resolve_path_import(path, Some(confinement_origin), context)
		CompilerFrontendSourcePackageAliasLookup(module_path):
			resolve_source_package_alias_import(context, module_path)
		CompilerFrontendSourcePackageInternalLookup(package_alias, module_path):
			match source_package_with_alias(context, package_alias):
				Some(package):
					resolve_source_package_internal_import(package, module_path)
				None:
					None
		CompilerFrontendLocalPathLookup(path):
			resolve_path_import(path, None, context)


private func read_cli_import_source(
	resolved: CliResolvedImportSource,
) -> Result[Option[CliSourceFile], String]:
	match resolved.contents:
		CliEmbeddedImport(source_text):
			Ok(Some({
				path = resolved.path,
				module_name = resolved.module_name,
				source_text = source_text,
			}))
		CliFilesystemImport:
			if not file_exists(resolved.path):
				Ok(None)
			else:
				source ?= read_text_file(
					resolved.path,
				).map_err(
					func(err): "failed to read source file `" + resolved.path + "`: " + err,
				)

				Ok(Some({
					path = resolved.path,
					module_name = resolved.module_name,
					source_text = source,
				}))


private pure func generated_import_binding(
	bindings: List[CliGeneratedModuleImport],
	module_path: String,
) -> Result[Option[CliGeneratedModuleImport], String]:
	var found: Option[CliGeneratedModuleImport] = None
	var count: Int = 0

	for binding in bindings:
		if binding.module_path == module_path:
			found = Some(binding)
			count += 1

	if count > 1:
		Err("generated module has duplicate binding for import `" + module_path + "`")
	else:
		Ok(found)


private pure func existing_source_for_generated_import(
	sources: List[CliFrontendGraphSource],
	binding: CliGeneratedModuleImport,
) -> Result[CliFrontendGraphSource, String]:
	var found: Option[CliFrontendGraphSource] = None
	var count: Int = 0

	for source in sources:
		if source.path == binding.source_path and source.module_name == binding.source_module:
			found = Some(source)
			count += 1

	if count == 0:
		Err(
			"generated import `" + binding.module_path + "` targets an absent graph identity `" + binding.source_module + "` at `" + binding.source_path + "`",
		)
	else if count > 1:
		Err("generated import `" + binding.module_path + "` targets an ambiguous graph identity")
	else:
		match found:
			Some(source):
				Ok(source)
			None:
				Err("internal error: generated import lookup lost its source")


private pure func existing_source_for_generated_module_path(
	sources: List[CliFrontendGraphSource],
	module_path: String,
) -> Result[CliFrontendGraphSource, String]:
	var found: Option[CliFrontendGraphSource] = None
	var count: Int = 0

	for source in sources:
		if source.module_name == module_path:
			found = Some(source)
			count += 1

	if count == 0:
		Err("generated import `" + module_path + "` is absent from the retained graph")
	else if count > 1:
		Err("generated import `" + module_path + "` has an ambiguous retained graph identity")
	else:
		match found:
			Some(source):
				Ok(source)
			None:
				Err("internal error: generated module lookup lost its source")


private pure func ambiguous_generated_import_module(
	bindings: List[CliGeneratedModuleImport],
) -> Option[String]:
	var seen: List[CliGeneratedModuleImport] = []
	var ambiguous: Option[String] = None

	for binding in bindings:
		if ambiguous.is_some():
			break

		if seen.any(
			func(
				existing,
			): (
				existing.source_module == binding.source_module
				and existing.source_path != binding.source_path
			),
		):
			ambiguous = Some(binding.source_module)
		else:
			seen = seen.append(binding)

	ambiguous


private pure func frontend_import_edge_for_existing_source(
	source: CliParsedSourceFile,
	module_path: String,
	target: CliFrontendGraphSource,
) -> CliFrontendImportEdge:
	{
		from_path = source.path,
		from_module = source.module_name,
		import_path = module_path,
		resolved_path = Some(target.path),
		resolved_module = Some(target.module_name),
		resolved_origin = Some(target.origin)
	}


private pure func existing_generated_import_target(
	existing_sources: List[CliFrontendGraphSource],
	bindings: List[CliGeneratedModuleImport],
	module_path: String,
) -> Result[CliFrontendGraphSource, String]:
	match generated_import_binding(bindings, module_path):
		Err(message):
			Err(message)
		Ok(Some(binding)):
			existing_source_for_generated_import(existing_sources, binding)
		Ok(None):
			existing_source_for_generated_module_path(existing_sources, module_path)


private func generated_import_edges(
	source: CliParsedSourceFile,
	existing_sources: List[CliFrontendGraphSource],
	bindings: List[CliGeneratedModuleImport],
) -> Result[List[CliFrontendImportEdge], String]:
	var import_edges: List[CliFrontendImportEdge] = []
	var error: Option[String] = None
	import_paths = module_surface_import_paths(
		finalized_typecheck_program_ast(source.typecheck_program),
	)

	for module_path in import_paths:
		if error.is_some():
			break

		match existing_generated_import_target(existing_sources, bindings, module_path):
			Err(message):
				error = Some(message)
			Ok(target):
				import_edges = import_edges.append(
					frontend_import_edge_for_existing_source(
						source,
						module_path,
						target,
					),
				)

	match error:
		Some(message):
			Err(message)
		None:
			Ok(import_edges)


record CliSourceGraphWalk {
	modules: List[CliParsedSourceFile],
	import_edges: List[CliFrontendImportEdge]
}


private func implicit_std_module_source(
	context: CliFrontendGraphContext,
	roots: List[CliParsedSourceFile],
	module_name: String,
) -> Result[List[CliSourceFile], String]:
	if roots.any(func(root): root.module_name == module_name):
		Ok([])
	else:
		match context.std_dir:
			Some(std_dir):
				std_name: String = strip_prefix("std/", module_name)
				path: String = normalize(join(std_dir, module_source_filename(std_name)))

				if roots.any(func(root): normalize(root.path) == path) or not file_exists(path):
					Ok([])
				else:
					source ?= read_text_file(
						path,
					).map_err(
						func(err): "failed to read implicit compiler module `${path}`: ${err}",
					)

					Ok(
						[
							{
								path = path,
								module_name = module_name,
								source_text = source
							},
						],
					)
			None:
				match embedded_std_source(module_name):
					Some(source):
						Ok(
							[
								{
									path = "<embedded:${module_name}>",
									module_name = module_name,
									source_text = source
								},
							],
						)
					None:
						Err("embedded standard library is missing `${module_name}`")


private func implicit_compiler_sources(
	context: CliFrontendGraphContext,
	roots: List[CliParsedSourceFile],
) -> Result[List[CliSourceFile], String]:
	prelude ?= implicit_std_module_source(context, roots, IMPLICIT_PRELUDE_MODULE)
	tuple_impls ?= implicit_std_module_source(context, roots, IMPLICIT_TUPLE_IMPL_MODULE)
	Ok(prelude.concat(tuple_impls))


private func implicit_test_runtime_sources(
	context: CliFrontendGraphContext,
	roots: List[CliParsedSourceFile],
	enabled: Bool,
) -> Result[List[CliSourceFile], String]:
	if enabled:
		implicit_std_module_source(context, roots, TEST_RUNTIME_MODULE)
	else:
		Ok([])


private func implicit_compiler_sources_if_enabled(
	context: CliFrontendGraphContext,
	roots: List[CliParsedSourceFile],
	enabled: Bool,
) -> Result[List[CliSourceFile], String]:
	if enabled:
		implicit_compiler_sources(context, roots)
	else:
		Ok([])


private func source_candidate(
	context: CliFrontendGraphContext,
	source: CliSourceFile,
) -> CompilerFrontendSourceCandidate:
	origin = frontend_module_origin_for_path(context, source.path, source.module_name)
	compiler_frontend_source_candidate(
		cli_frontend_compiler_identity(source.module_name, origin),
		compiler_source_file(source.path, source.module_name, source.source_text),
	)


private func parsed_source_candidate(
	context: CliFrontendGraphContext,
	source: CliParsedSourceFile,
) -> CompilerFrontendSourceCandidate:
	source_candidate(
		context,
		{
			path = source.path,
			module_name = source.module_name,
			source_text = source.source_text
		},
	)


private func resolve_frontend_source_candidate(
	context: CliFrontendGraphContext,
	importer: CompilerFrontendSourceCandidate,
	requested_path: String,
) -> Result[CompilerFrontendSourceResolution, String]:
	var resolved: Option[CliResolvedImportSource] = None

	for lookup in compiler_frontend_import_lookup_plan(importer, requested_path):
		if resolved.is_none():
			resolved = resolve_frontend_import_lookup(context, lookup)

	match resolved:
		None:
			Ok(CompilerFrontendSourceUnresolved)
		Some(source):
			match read_cli_import_source(source):
				Err(message):
					Err(message)
				Ok(None):
					Ok(CompilerFrontendSourceUnresolved)
				Ok(Some(import_source)):
					Ok(CompilerFrontendSourceResolved(source_candidate(context, import_source)))


private pure func cli_origin_for_compiler_origin(
	origin: CompilerModuleOrigin,
) -> CliFrontendModuleOrigin:
	match origin:
		CompilerUserModule:
			CliFrontendUserModule
		CompilerStdlibModule:
			CliFrontendStdModule
		CompilerSourcePackageModule(package_alias):
			CliFrontendSourcePackageModule(package_alias)
		CompilerNativePackageModule(package_id):
			CliFrontendPkgModule(package_id)


private pure func parsed_source_for_compiler_module(
	module: CompilerFrontendModule,
) -> CliParsedSourceFile:
	program = finalized_typecheck_program_ast(module.program)
	{
		path = program.source.path,
		module_name = program.source.module_name,
		source_text = program.source.text,
		typecheck_program = module.program
	}


private pure func compiler_module_for_identity(
	modules: List[CompilerFrontendModule],
	identity: CompilerResolvedModuleIdentity,
) -> Option[CompilerFrontendModule]:
	modules.find(func(module):
		compiler_resolved_module_identities_equal(module.identity, identity)
	)


private pure func cli_edge_for_compiler_edge(
	modules: List[CompilerFrontendModule],
	edge: CompilerFrontendImportEdge,
) -> Result[CliFrontendImportEdge, String]:
	importer ?= compiler_module_for_identity(
		modules,
		edge.importer,
	).to_result("validated compiler frontend graph lost an import source")
	importer_program = finalized_typecheck_program_ast(importer.program)

	match edge.resolution:
		CompilerFrontendUnresolvedImport:
			Ok({
				from_path = importer_program.source.path,
				from_module = importer_program.source.module_name,
				import_path = edge.requested_path,
				resolved_path = None,
				resolved_module = None,
				resolved_origin = None,
			})
		CompilerFrontendResolvedImport(target_identity):
			target ?= compiler_module_for_identity(
				modules,
				target_identity,
			).to_result("validated compiler frontend graph lost an import target")
			target_program = finalized_typecheck_program_ast(target.program)
			Ok({
				from_path = importer_program.source.path,
				from_module = importer_program.source.module_name,
				import_path = edge.requested_path,
				resolved_path = Some(target_program.source.path),
				resolved_module = Some(target_program.source.module_name),
				resolved_origin = Some(
					cli_origin_for_compiler_origin(
						compiler_resolved_module_origin(target_identity),
					),
				),
			})


private pure func cli_edges_for_compiler_graph(
	graph: CompilerFrontendGraph,
) -> Result[List[CliFrontendImportEdge], String]:
	modules = compiler_frontend_graph_modules(graph)
	var edges: List[CliFrontendImportEdge] = []
	var error: Option[String] = None

	for edge in compiler_frontend_graph_import_edges(graph):
		if error.is_none():
			match cli_edge_for_compiler_edge(modules, edge):
				Ok(converted):
					edges = edges.append(converted)
				Err(message):
					error = Some(message)

	match error:
		Some(message):
			Err(message)
		None:
			Ok(edges)


private pure func compiler_graph_walk(
	graph: CompilerFrontendGraph,
	root_identities: List[CompilerResolvedModuleIdentity],
) -> Result[CliSourceGraphWalk, String]:
	modules = compiler_frontend_graph_modules(graph)
	non_roots = modules.filter(func(module):
		not root_identities.any(func(root):
			compiler_resolved_module_identities_equal(module.identity, root)
		)
	)
	edges ?= cli_edges_for_compiler_graph(graph)

	Ok({
		modules = non_roots.map(parsed_source_for_compiler_module),
		import_edges = edges,
	})


private func source_graph_walk_for_roots(
	context: CliFrontendGraphContext,
	roots: List[CliParsedSourceFile],
	include_implicit_compiler_sources: Bool,
	include_test_runtime: Bool,
) -> Result[CliSourceGraphWalk, String]:
	compiler_sources ?= implicit_compiler_sources_if_enabled(
		context,
		roots,
		include_implicit_compiler_sources,
	)
	test_runtime_sources ?= implicit_test_runtime_sources(context, roots, include_test_runtime)
	implicit_sources: List[CliSourceFile] = compiler_sources.concat(test_runtime_sources)
	root_candidates = roots.map(func(root): parsed_source_candidate(context, root))
	seed_candidates = implicit_sources.map(func(source): source_candidate(context, source))
	graph ?= compiler_frontend_graph_discover(root_candidates, seed_candidates, func(
		importer,
		requested_path,
	):
		resolve_frontend_source_candidate(context, importer, requested_path)
	).map_err(compiler_frontend_discovery_error_message)

	compiler_graph_walk(
		graph,
		root_candidates.map(func(root): root.identity),
	)


func source_graph_modules_for_roots(
	action: CliAction,
	roots: List[CliParsedSourceFile],
) -> Result[List[CliParsedSourceFile], String]:
	setup: CliSourceGraphSetup = source_graph_setup_for_sources(action, roots)
	context: CliFrontendGraphContext = setup.context
	normalized_roots: List[CliParsedSourceFile] = normalize_root_module_names(context, roots)
	walk ?= source_graph_walk_for_roots(context, normalized_roots, False, False)
	Ok(walk.modules)


func frontend_module_graph_for_roots(
	action: CliAction,
	roots: List[CliParsedSourceFile],
) -> Result[CliFrontendModuleGraph, String]:
	setup: CliSourceGraphSetup = source_graph_setup_for_sources(action, roots)

	include_test_runtime: Bool = match action:
		CliTest(_):
			True
		_:
			False

	frontend_module_graph_for_roots_with_setup_and_test_runtime(setup, roots, include_test_runtime)


func frontend_module_graph_for_roots_with_setup(
	setup: CliSourceGraphSetup,
	roots: List[CliParsedSourceFile],
) -> Result[CliFrontendModuleGraph, String]:
	frontend_module_graph_for_roots_with_setup_and_test_runtime(setup, roots, False)


private func frontend_module_graph_for_roots_with_setup_and_test_runtime(
	setup: CliSourceGraphSetup,
	roots: List[CliParsedSourceFile],
	include_test_runtime: Bool,
) -> Result[CliFrontendModuleGraph, String]:
	context: CliFrontendGraphContext = setup.context
	normalized_roots: List[CliParsedSourceFile] = normalize_root_module_names(context, roots)
	walk ?= source_graph_walk_for_roots(context, normalized_roots, True, include_test_runtime)

	graph: CliFrontendModuleGraph = {
		context = context,
		roots = frontend_graph_sources(context, normalized_roots),
		modules = frontend_graph_sources(context, walk.modules),
		import_edges = walk.import_edges,
		diagnostics = setup.diagnostics
	}
	validated_cli_frontend_graph(graph)


private pure func frontend_graph_source_key(
	source: CliFrontendGraphSource,
) -> CliFrontendGraphSourceKey:
	{
		path = source.path,
		module_name = source.module_name
	}


private pure func frontend_graph_source_matches_key(
	source: CliFrontendGraphSource,
	key: CliFrontendGraphSourceKey,
) -> Bool:
	source.path == key.path and source.module_name == key.module_name


private pure func frontend_graph_key_matches_edge_source(
	key: CliFrontendGraphSourceKey,
	edge: CliFrontendImportEdge,
) -> Bool:
	key.path == edge.from_path and key.module_name == edge.from_module


private pure func frontend_graph_keys_contain(
	keys: List[CliFrontendGraphSourceKey],
	key: CliFrontendGraphSourceKey,
) -> Bool:
	var contains: Bool = False

	for existing in keys:
		if existing.path == key.path and existing.module_name == key.module_name:
			contains = True
			break

	contains


private pure func frontend_graph_sources_contain_key(
	sources: List[CliFrontendGraphSource],
	key: CliFrontendGraphSourceKey,
) -> Bool:
	var contains: Bool = False

	for source in sources:
		if frontend_graph_source_matches_key(source, key):
			contains = True
			break

	contains


private pure func retained_projection_roots(
	graph: CliFrontendModuleGraph,
	root_keys: List[CliFrontendGraphSourceKey],
) -> Result[List[CliFrontendGraphSource], String]:
	if root_keys.length() == 0:
		Err("retained frontend graph projection requires at least one root")
	else:
		var roots: List[CliFrontendGraphSource] = []
		var seen: List[CliFrontendGraphSourceKey] = []
		var error: Option[String] = None

		for key in root_keys:
			if frontend_graph_keys_contain(seen, key):
				error = Some(
					"retained frontend graph projection repeats root `" + key.module_name + "` at `" + key.path + "`",
				)
				break
			else:
				var match_count: Int = 0
				var matched: Option[CliFrontendGraphSource] = None

				for source in graph.roots:
					if frontend_graph_source_matches_key(source, key):
						match_count += 1
						matched = Some(source)

				if match_count == 0:
					error = Some(
						"retained frontend graph projection root `" + key.module_name + "` at `" + key.path + "` is absent",
					)
					break
				else if match_count > 1:
					error = Some(
						"retained frontend graph projection root `" + key.module_name + "` at `" + key.path + "` is ambiguous",
					)
					break
				else:
					match matched:
						Some(source):
							roots = roots.append(source)
							seen = seen.append(key)
						None:
							error = Some(
								"internal error: retained frontend root lookup lost its source",
							)
							break

		match error:
			Some(message):
				Err(message)
			None:
				Ok(roots)


private pure func implicit_frontend_graph_source(source: CliFrontendGraphSource) -> Bool:
	match source.origin:
		CliFrontendStdModule:
			(
				source.module_name == IMPLICIT_PRELUDE_MODULE
				or source.module_name == IMPLICIT_TUPLE_IMPL_MODULE
				or source.module_name == TEST_RUNTIME_MODULE
			)
		_:
			False


private pure func retained_projection_closure(
	graph: CliFrontendModuleGraph,
	roots: List[CliFrontendGraphSource],
) -> Result[List[CliFrontendGraphSourceKey], String]:
	all_sources: List[CliFrontendGraphSource] = graph.roots.concat(graph.modules)
	var closure: List[CliFrontendGraphSourceKey] = []

	for root in roots:
		closure = closure.append(frontend_graph_source_key(root))

	-- Prelude and tuple implementations are implicit roots in the ordinary
	-- frontend graph, so no source import edge points to them.
	for source in all_sources:
		if implicit_frontend_graph_source(source):
			key: CliFrontendGraphSourceKey = frontend_graph_source_key(source)

			if not frontend_graph_keys_contain(closure, key):
				closure = closure.append(key)

	var changed: Bool = True
	var error: Option[String] = None

	while changed and error.is_none():
		changed = False

		for edge in graph.import_edges:
			var source_is_reachable: Bool = False

			for key in closure:
				if frontend_graph_key_matches_edge_source(key, edge):
					source_is_reachable = True
					break

			if source_is_reachable:
				match (edge.resolved_path, edge.resolved_module):
					(Some(path), Some(module_name)):
						target: CliFrontendGraphSourceKey = {
							path = path,
							module_name = module_name
						}

						if not frontend_graph_sources_contain_key(all_sources, target):
							error = Some(
								"retained frontend graph import target `" + module_name + "` at `" + path + "` is absent",
							)
							break
						else if not frontend_graph_keys_contain(closure, target):
							closure = closure.append(target)
							changed = True
					(None, None):
						void
					_:
						error = Some(
							"retained frontend graph import edge has incomplete resolved identity",
						)
						break

	match error:
		Some(message):
			Err(message)
		None:
			Ok(closure)


-- Project one batch from an invocation-owned graph without reading or parsing
-- source again. Other invocation roots are retained as modules only when they
-- are reachable dependencies of the selected roots.
pure func frontend_module_graph_for_retained_roots(
	graph: CliFrontendModuleGraph,
	root_keys: List[CliFrontendGraphSourceKey],
) -> Result[CliFrontendModuleGraph, String]:
	roots ?= retained_projection_roots(graph, root_keys)
	closure ?= retained_projection_closure(graph, roots)
	all_sources: List[CliFrontendGraphSource] = graph.roots.concat(graph.modules)
	var modules: List[CliFrontendGraphSource] = []
	var import_edges: List[CliFrontendImportEdge] = []

	for source in all_sources:
		key: CliFrontendGraphSourceKey = frontend_graph_source_key(source)

		if (
			frontend_graph_keys_contain(closure, key)
			and not frontend_graph_sources_contain_key(roots, key)
		):
			modules = modules.append(source)

	for edge in graph.import_edges:
		var source_is_reachable: Bool = False

		for key in closure:
			if frontend_graph_key_matches_edge_source(key, edge):
				source_is_reachable = True
				break

		if source_is_reachable:
			import_edges = import_edges.append(edge)

	projected: CliFrontendModuleGraph = {
		context = graph.context,
		roots = roots,
		modules = modules,
		import_edges = import_edges,
		diagnostics = graph.diagnostics
	}
	validated_cli_frontend_graph(projected)


func frontend_module_graph_with_generated_root(
	graph: CliFrontendModuleGraph,
	generated_module: CliGeneratedModule,
) -> Result[CliFrontendModuleGraph, String]:
	existing_sources: List[CliFrontendGraphSource] = graph.roots.concat(graph.modules)
	collision: Option[CliFrontendGraphSource] = existing_sources.find(
		func(
			source,
		): (
			source.path == generated_module.source.path
			or source.module_name == generated_module.source.module_name
		),
	)

	match collision:
		Some(source):
			Err(
				"generated module identity collides with existing graph source `" + source.module_name + "` at `" + source.path + "`",
			)
		None:
			match ambiguous_generated_import_module(generated_module.imports):
				Some(module_name):
					Err(
						"generated imports target distinct sources with the same module identity `" + module_name + "`",
					)
				None:
					generated ?= parse_cli_source(generated_module.source)
					import_edges ?= generated_import_edges(
						generated,
						existing_sources,
						generated_module.imports,
					)
					generated_root: CliFrontendGraphSource = {
						path = generated.path,
						module_name = generated.module_name,
						source_text = generated.source_text,
						typecheck_program = generated.typecheck_program,
						origin = CliFrontendGeneratedModule
					}

					combined: CliFrontendModuleGraph = {
						context = graph.context,
						roots = [generated_root],
						modules = existing_sources,
						import_edges = graph.import_edges.concat(import_edges),
						diagnostics = graph.diagnostics
					}
					validated_cli_frontend_graph(combined)
