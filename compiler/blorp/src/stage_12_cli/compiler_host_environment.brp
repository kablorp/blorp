-- One-time discovery of host compilation policy from explicit inputs.
--
-- The production helper reads process environment only to construct the input
-- record. All downstream compilation receives the resulting typed context.
import:
	../stage_10_backend/compiler_build_artifact:
		BuildPlatform(BuildLinux, BuildMacos),
	compiler_host_c:
		HostCCompilerFamily(HostOtherCompiler),
		HostTlsBackend(HostTlsOpenSsl, HostTlsUnsupported),
		HostTlsConfiguration,
	compiler_platform:
		HostPlatformError,
		HostToolchain,
		HostToolchainProbe,
		discover_host_toolchain,
		host_cache_root,
		host_tls_configuration,
		parse_host_arguments,
		parse_host_tls_backend,
		probe_host_arguments,
	system: getenv, temp_dir
	units: DataSize, Duration


record CompilerHostEnvironmentInput {
	tls_backend: Option[String],
	openssl_compile_arguments: Option[String],
	openssl_link_arguments: Option[String],
	runtime_cache_root: Option[String],
	xdg_cache_home: Option[String],
	home: Option[String],
	temporary_root: String,
	raylib_prefix: Option[String],
	discover_raylib_prefix: Bool
}


record CompilerHostEnvironmentProbe {
	input: CompilerHostEnvironmentInput,
	toolchain: HostToolchainProbe,
	pkg_config_program: String,
	brew_program: String
}


record CompilerHostEnvironment {
	toolchain: HostToolchain,
	tls: HostTlsConfiguration,
	cache_root: String,
	raylib_prefix: Option[String]
}


private func configured_arguments(
	override: Option[String],
	label: String,
	pkg_config_program: String,
	pkg_config_option: String,
	timeout: Option[Duration],
	capture_limit: DataSize,
) -> Result[List[String], HostPlatformError]:
	match override:
		Some(arguments):
			parse_host_arguments(arguments)
		None:
			probe_host_arguments(
				label,
				pkg_config_program,
				[pkg_config_option, "openssl"],
				timeout,
				capture_limit,
			)


private func discover_tls_configuration(
	probe: CompilerHostEnvironmentProbe,
) -> Result[HostTlsConfiguration, HostPlatformError]:
	backend ?= parse_host_tls_backend(probe.input.tls_backend)
	tls_configuration_for_backend(backend, probe)


private func tls_configuration_for_backend(
	backend: HostTlsBackend,
	probe: CompilerHostEnvironmentProbe,
) -> Result[HostTlsConfiguration, HostPlatformError]:
	match backend:
		HostTlsUnsupported:
			Ok(host_tls_configuration(HostTlsUnsupported, [], []))
		HostTlsOpenSsl:
			compile_arguments ?= configured_arguments(
				probe.input.openssl_compile_arguments,
				"OpenSSL compiler flags",
				probe.pkg_config_program,
				"--cflags",
				probe.toolchain.timeout,
				probe.toolchain.capture_limit,
			)
			link_arguments ?= configured_arguments(
				probe.input.openssl_link_arguments,
				"OpenSSL linker flags",
				probe.pkg_config_program,
				"--libs",
				probe.toolchain.timeout,
				probe.toolchain.capture_limit,
			)
			Ok(host_tls_configuration(HostTlsOpenSsl, compile_arguments, link_arguments))


private func discover_raylib_prefix(
	probe: CompilerHostEnvironmentProbe,
	platform: BuildPlatform,
) -> Option[String]:
	match probe.input.raylib_prefix:
		Some(prefix):
			if prefix.trim().length() == 0:
				None
			else:
				Some(prefix)
		None:
			if not probe.input.discover_raylib_prefix:
				None
			else:
				match platform:
					BuildLinux:
						None
					BuildMacos:
						match probe_host_arguments(
							"raylib Homebrew prefix",
							probe.brew_program,
							["--prefix", "raylib"],
							probe.toolchain.timeout,
							probe.toolchain.capture_limit,
						):
							Ok(prefixes):
								match prefixes:
									[prefix]:
										Some(prefix)
									_:
										None
							Err(_):
								None


func discover_compiler_host_environment(
	probe: CompilerHostEnvironmentProbe,
) -> Result[CompilerHostEnvironment, HostPlatformError]:
	toolchain ?= discover_host_toolchain(probe.toolchain)
	tls ?= discover_tls_configuration(probe)

	Ok({
		toolchain = toolchain,
		tls = tls,
		cache_root = host_cache_root(
			probe.input.runtime_cache_root,
			probe.input.xdg_cache_home,
			probe.input.home,
			probe.input.temporary_root,
		),
		raylib_prefix = discover_raylib_prefix(probe, toolchain.platform),
	})


func current_compiler_host_environment(
	discover_raylib: Bool,
	timeout: Option[Duration],
	capture_limit: DataSize,
) -> Result[CompilerHostEnvironment, HostPlatformError]:
	environment_input: CompilerHostEnvironmentInput = {
		tls_backend = getenv("BLORP_TLS_BACKEND"),
		openssl_compile_arguments = getenv("BLORP_OPENSSL_CFLAGS"),
		openssl_link_arguments = getenv("BLORP_OPENSSL_LIBS"),
		runtime_cache_root = getenv("BLORP_RUNTIME_CACHE"),
		xdg_cache_home = getenv("XDG_CACHE_HOME"),
		home = getenv("HOME"),
		temporary_root = temp_dir(),
		raylib_prefix = getenv("BLORP_RAYLIB_PREFIX"),
		discover_raylib_prefix = discover_raylib
	}
	toolchain: HostToolchainProbe = {
		compiler = {
			program = "cc",
			prefix_arguments = [],
			family = HostOtherCompiler
		},
		uname_program = "uname",
		timeout = timeout,
		capture_limit = capture_limit
	}

	discover_compiler_host_environment({
		input = environment_input,
		toolchain = toolchain,
		pkg_config_program = "pkg-config",
		brew_program = "brew"
	})
