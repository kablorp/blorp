-- Source reading, package source resolution, and import graph discovery for the Blorp CLI.
import:
	../stage_01_file_io/compiler_embedded_std: embedded_std_source
	../stage_03_parse/compiler_parsed_ast:
		ParsedProgram,
		ParsedProgramPhase(TypecheckSourceProgram),
	../stage_03_parse/compiler_parser_bridge as ParserBridge
	../stage_11_format/compiler_format: FormatCommandResult, run_format_command
	compiler_cli_args: CliAction(CliCheck, CliCompile, CliRun, CliTest)
	compiler_cli_plan:
		CliCheckTargetExpansion,
		CliFrontendGraphContext,
		CliFrontendGraphSource,
		CliFrontendImportEdge,
		CliFrontendModuleGraph,
		CliFrontendModuleOrigin(
			CliFrontendGeneratedModule,
			CliFrontendPkgModule,
			CliFrontendSourcePackageModule,
			CliFrontendStdModule,
			CliFrontendUserModule,
		),
		CliFrontendSourcePackage,
		CliGeneratedModule,
		CliGeneratedModuleImport,
		CliParsedSourceFile,
		CliSourceFile,
		CliSourceTarget(CliSourceDirectoryTarget, CliSourceFileTarget),
	fs: message, open_read, read_text
	json:
		JsonValue(JsonNull, JsonObject, JsonString, JsonVector),
		as_array,
		as_string,
		get_field,
	path: dirname, join, normalize, stem
	system: file_exists, getcwd, getenv, is_directory, temp_dir, walk_dir
	toml: TomlValue(TomlArray, TomlString, TomlTable), lookup as toml_lookup, parse as parse_toml


private CURRENT_PACKAGE_STD_COMPAT: String = "preview-1"


private pure func owned_string(text: String) -> String:
	text.substring(0, text.length())


private pure func absolute_normalized_path(cwd: String, path: String) -> String:
	if path.starts_with("/"):
		normalize(path)
	else:
		normalize(join(cwd, path))


private pure func is_path_under_dir(dir: String, path: String) -> Bool:
	normalized_dir: String = normalize(dir)
	normalized_path: String = normalize(path)
	normalized_path == normalized_dir or normalized_path.starts_with(normalized_dir + "/")


private func should_auto_format_cli_source(path: String) -> Bool:
	cwd: String = getcwd()
	std_dir: String = normalize(join(cwd, "std"))
	source_path: String = absolute_normalized_path(cwd, path)

	not is_path_under_dir(std_dir, source_path)


private func env_disables_auto_format() -> Bool:
	match getenv("BLORP_NO_FORMAT"):
		Some(value):
			value == "1"
		None:
			False


private func action_uses_auto_format(action: CliAction) -> Bool:
	if env_disables_auto_format():
		False
	else:
		match action:
			CliCheck(args):
				not args.no_format
			CliCompile(args):
				not args.no_format
			CliRun(args):
				not args.no_format
			_:
				False


private pure func format_cli_source_error(
	path: String,
	format_result: FormatCommandResult,
) -> String:
	detail: String = if format_result.stderr != "":
		format_result.stderr.trim_right()
	else if format_result.stdout != "":
		format_result.stdout.trim_right()
	else:
		"failed to format source file `" + path + "`"

	if detail == "":
		"failed to format source file `" + path + "`"
	else:
		detail


private func auto_format_cli_source_if_needed(
	action: CliAction,
	path: String,
) -> Result[Void, String]:
	if action_uses_auto_format(action) and should_auto_format_cli_source(path):
		format_result: FormatCommandResult = run_format_command([path])

		if format_result.status == 0:
			Ok(void)
		else:
			Err(format_cli_source_error(path, format_result))
	else:
		Ok(void)


private pure func single_path(paths: List[String]) -> Option[String]:
	match paths:
		[path]:
			Some(path)
		_:
			None


func frontend_source_for_action(action: CliAction) -> Option[String]:
	match action:
		CliCompile(args):
			single_path(args.files)
		CliRun(args):
			single_path(args.files)
		_:
			None


private pure func is_blorp_source_path(path: String) -> Bool:
	path.ends_with(".brp")


private pure func blorp_source_paths(paths: List[String]) -> List[String]:
	var sources: List[String] = []

	for path in paths:
		if is_blorp_source_path(path):
			sources = sources.append(path)

	sources


private func expand_check_target(path: String) -> Result[CliCheckTargetExpansion, String]:
	if not file_exists(path):
		Err("failed to read source file `" + path + "`: not found: " + path)
	else if is_directory(path):
		Ok({
			targets = [CliSourceDirectoryTarget(path)],
			source_paths = blorp_source_paths(walk_dir(path)),
		})
	else:
		Ok({
			targets = [CliSourceFileTarget(path)],
			source_paths = [path],
		})


func expand_check_targets(paths: List[String]) -> Result[CliCheckTargetExpansion, String]:
	var targets: List[CliSourceTarget] = []
	var source_paths: List[String] = []
	var error: Option[String] = None

	for path in paths:
		match error:
			Some(_):
				break
			None:
				match expand_check_target(path):
					Ok(expansion):
						targets = targets.concat(expansion.targets)
						source_paths = source_paths.concat(expansion.source_paths)
					Err(message):
						error = Some(message)

	match error:
		Some(message):
			Err(message)
		None:
			Ok({
				targets = targets,
				source_paths = source_paths.sort(),
			})


private func read_text_file(path: String) -> Result[String, String]:
	with reader ?= open_read(path) on err => message(err):
		match reader.read_text():
			Ok(source):
				Ok(source)
			Err(err):
				Err(message(err))


private pure func module_name_for_cli_path(path: String) -> String:
	stem(path)


private func read_cli_source_file(path: String) -> Result[CliSourceFile, String]:
	source ?= read_text_file(
		path,
	).map_err(
		func(err): "failed to read source file `" + path + "`: " + err,
	)

	Ok({
		path = owned_string(path),
		module_name = owned_string(module_name_for_cli_path(path)),
		source_text = owned_string(source),
	})


private func read_cli_source_file_for_action(
	action: CliAction,
	path: String,
) -> Result[CliSourceFile, String]:
	match auto_format_cli_source_if_needed(action, path):
		Ok(_):
			read_cli_source_file(path)
		Err(message):
			Err(message)


func read_cli_sources_for_action(
	action: CliAction,
	paths: List[String],
) -> Result[List[CliSourceFile], String]:
	var sources: List[CliSourceFile] = []
	var error: Option[String] = None

	for path in paths:
		match error:
			Some(_):
				break
			None:
				match read_cli_source_file_for_action(action, path):
					Ok(source):
						sources = sources.append(source)
					Err(message):
						error = Some(message)

	match error:
		Some(message):
			Err(message)
		None:
			Ok(sources)


pure func single_explicit_check_source(
	expansion: CliCheckTargetExpansion,
	sources: List[CliSourceFile],
) -> Option[CliSourceFile]:
	match expansion.targets:
		[CliSourceFileTarget(path)]:
			match sources:
				[source]:
					if source.path == path:
						Some(source)
					else:
						None
				_:
					None
		_:
			None


func parse_cli_source(source: CliSourceFile) -> Result[CliParsedSourceFile, String]:
	artifact = ParserBridge.parsed_source_bridge_artifact(
		source.path,
		source.module_name,
		source.source_text,
		TypecheckSourceProgram,
		False,
	)
	Ok({
		path = owned_string(source.path),
		module_name = owned_string(source.module_name),
		source_text = owned_string(source.source_text),
		parsed_source = artifact.json,
		typecheck_program = artifact.program,
	})


pure func parsed_cli_source_from_program(program: ParsedProgram) -> CliParsedSourceFile:
	artifact = ParserBridge.parsed_source_bridge_artifact_from_program(
		program,
		TypecheckSourceProgram,
	)
	{
		path = owned_string(program.source.path),
		module_name = owned_string(program.source.module_name),
		source_text = owned_string(program.source.text),
		parsed_source = artifact.json,
		typecheck_program = artifact.program,
	}


func parse_cli_sources(sources: List[CliSourceFile]) -> Result[List[CliParsedSourceFile], String]:
	var parsed_sources: List[CliParsedSourceFile] = []
	var error: Option[String] = None

	for source in sources:
		if error.is_some():
			break

		match parse_cli_source(source):
			Ok(parsed):
				parsed_sources = parsed_sources.append(parsed)
			Err(message):
				error = Some(message)

	match error:
		Some(message):
			Err(message)
		None:
			Ok(parsed_sources)


union CliResolvedImportContents:
	CliFilesystemImport
	CliEmbeddedImport(String)


record CliResolvedImportSource {
	path: String,
	module_name: String,
	contents: CliResolvedImportContents
}


private record CliSourceIdentity {
	path: String,
	module_name: String
}


record CliSourceGraphDiscovery {
	sources: List[CliSourceFile],
	seen_sources: List[CliSourceIdentity],
	import_edges: List[CliFrontendImportEdge]
}


private pure func json_array_field(
	value: JsonValue,
	name: String,
) -> Result[List[JsonValue], String]:
	match get_field(value, name):
		Some(field):
			match as_array(field):
				Some(items):
					Ok(items)
				None:
					Err("module surface field `" + name + "` was not an array")
		None:
			Err("module surface missing field `" + name + "`")


private pure func json_string_field(value: JsonValue, name: String) -> Result[String, String]:
	match get_field(value, name):
		Some(field):
			match as_string(field):
				Some(text):
					Ok(text)
				None:
					Err("module surface field `" + name + "` was not a string")
		None:
			Err("module surface missing field `" + name + "`")


private pure func module_surface_import_paths_json(
	surface: JsonValue,
) -> Result[List[String], String]:
	var imports: List[String] = []
	var error: Option[String] = None

	items ?= json_array_field(surface, "imports")

	for item in items:
		match error:
			Some(_):
				break
			None:
				match json_string_field(item, "module_path"):
					Ok(module_path):
						imports = imports.append(module_path)
					Err(message):
						error = Some(message)

	match error:
		Some(message):
			Err(message)
		None:
			Ok(imports)


private pure func parsed_source_module_surface(
	source: CliParsedSourceFile,
) -> Result[JsonValue, String]:
	match get_field(source.parsed_source, "module_surface"):
		Some(surface):
			Ok(surface)
		None:
			Err("parsed source `" + source.path + "` missing module_surface")


private pure func parsed_source_import_paths(
	source: CliParsedSourceFile,
) -> Result[List[String], String]:
	surface ?= parsed_source_module_surface(source)
	module_surface_import_paths_json(surface)


private pure func action_std_dir(action: CliAction) -> Option[String]:
	match action:
		CliCheck(args):
			args.std_dir
		CliCompile(args):
			args.std_dir
		CliRun(args):
			args.std_dir
		CliTest(args):
			args.std_dir
		_:
			None


private func action_or_env_std_dir(action: CliAction) -> Option[String]:
	match action_std_dir(action):
		Some(path):
			Some(path)
		None:
			match getenv("BLORP_STD"):
				Some(path):
					if path.trim() == "":
						None
					else:
						Some(path)
				None:
					None


private pure func strip_prefix(prefix: String, text: String) -> String:
	text.drop_left(prefix.length())


private pure func absolute_path_from(cwd: String, path: String) -> String:
	if path.starts_with("/"):
		normalize(path)
	else:
		normalize(join(cwd, path))


private func absolute_path(path: String) -> String:
	absolute_path_from(getcwd(), path)


private func module_name_for_resolved_source_path(path: String) -> String:
	cwd: String = normalize(getcwd())
	absolute: String = absolute_path(path)

	relative: String = if is_path_under_dir(cwd, absolute):
		strip_prefix(cwd + "/", absolute)
	else:
		absolute

	if relative.ends_with(".brp"):
		relative.substring(0, relative.length() - 4)
	else:
		relative


private pure func config_relative_path(config_dir: String, path: String) -> String:
	if path.starts_with("/"):
		normalize(path)
	else:
		normalize(join(config_dir, path))


private pure func is_identifier_start(ch: Char) -> Bool:
	ch >= 'a' and ch <= 'z' or ch >= 'A' and ch <= 'Z' or ch == '_'


private pure func is_identifier_rest(ch: Char) -> Bool:
	is_identifier_start(ch) or ch >= '0' and ch <= '9'


private pure func is_blorp_identifier(text: String) -> Bool:
	if text.length() == 0:
		False
	else:
		match text.get(0):
			Some(first):
				if not is_identifier_start(first):
					False
				else:
					var ok: Bool = True
					var i: Int = 1

					while i < text.length() and ok:
						match text.get(i):
							Some(ch):
								if not is_identifier_rest(ch):
									ok = False
							None:
								ok = False

						i += 1

					ok
			None:
				False


private pure func valid_package_alias(package_alias: String) -> Bool:
	is_blorp_identifier(package_alias) and package_alias != "std" and package_alias != "pkg"


private pure func append_unique_string(values: List[String], value: String) -> List[String]:
	if values.contains(value):
		values
	else:
		values.append(value)


private pure func module_source_filename(module_path: String) -> String:
	if module_path.ends_with(".brp"):
		module_path
	else:
		module_path + ".brp"


private pure func toml_string_value(value: TomlValue) -> Option[String]:
	match value:
		TomlString(text):
			Some("" + text)
		_:
			None


private pure func toml_string_list_value(value: TomlValue) -> Option[List[String]]:
	match value:
		TomlArray(items):
			var strings: List[String] = []
			var ok: Bool = True

			for item in items:
				if not ok:
					break

				match item:
					TomlString(text):
						strings = strings.append("" + text)
					_:
						ok = False

			if ok:
				Some(strings)
			else:
				None
		_:
			None


private pure func toml_table_string_field(value: TomlValue, field_name: String) -> Option[String]:
	match value:
		TomlTable(fields):
			match fields.get(field_name):
				Some(field):
					toml_string_value(field)
				None:
					None
		_:
			None


private pure func toml_table_string_list_field(
	value: TomlValue,
	field_name: String,
) -> Option[List[String]]:
	match value:
		TomlTable(fields):
			match fields.get(field_name):
				Some(field):
					toml_string_list_value(field)
				None:
					None
		_:
			None


private pure func toml_string_at(toml: TomlValue, key: String) -> Option[String]:
	match toml_lookup(toml, key):
		Some(value):
			toml_string_value(value)
		None:
			None


private pure func toml_string_list_at(toml: TomlValue, key: String) -> Option[List[String]]:
	match toml_lookup(toml, key):
		Some(value):
			toml_string_list_value(value)
		None:
			None


private pure func package_alias_from_toml_key(key: String) -> Option[String]:
	if not key.starts_with("packages."):
		None
	else:
		rest: String = strip_prefix("packages.", key)

		match rest.split("."):
			[package_alias]:
				if valid_package_alias(package_alias):
					Some(package_alias)
				else:
					None
			[package_alias, _]:
				if valid_package_alias(package_alias):
					Some(package_alias)
				else:
					None
			_:
				None


private pure func package_aliases_from_toml(toml: TomlValue) -> List[String]:
	match toml:
		TomlTable(fields):
			var aliases: List[String] = []

			for key in fields.keys():
				match package_alias_from_toml_key(key):
					Some(package_alias):
						aliases = append_unique_string(aliases, package_alias)
					None:
						void

			aliases
		_:
			[]


private pure func package_alias_inline_value(
	toml: TomlValue,
	package_alias: String,
) -> Option[TomlValue]:
	toml_lookup(toml, "packages." + package_alias)


private pure func package_alias_string_config(
	toml: TomlValue,
	package_alias: String,
	field_name: String,
) -> Option[String]:
	match toml_string_at(toml, "packages." + package_alias + "." + field_name):
		Some(value):
			Some(value)
		None:
			match package_alias_inline_value(toml, package_alias):
				Some(inline_value):
					toml_table_string_field(inline_value, field_name)
				None:
					None


private pure func package_alias_string_list_config(
	toml: TomlValue,
	package_alias: String,
	field_name: String,
) -> Option[List[String]]:
	match toml_string_list_at(toml, "packages." + package_alias + "." + field_name):
		Some(value):
			Some(value)
		None:
			match package_alias_inline_value(toml, package_alias):
				Some(inline_value):
					toml_table_string_list_field(inline_value, field_name)
				None:
					None


private pure func is_hex_char(ch: Char) -> Bool:
	ch >= '0' and ch <= '9' or ch >= 'a' and ch <= 'f' or ch >= 'A' and ch <= 'F'


private pure func is_hex_string(text: String) -> Bool:
	if text.length() == 0:
		False
	else:
		var ok: Bool = True
		var i: Int = 0

		while i < text.length() and ok:
			match text.get(i):
				Some(ch):
					if not is_hex_char(ch):
						ok = False
				None:
					ok = False

			i += 1

		ok


private pure func normalize_hash_pin(pin: String) -> Option[String]:
	lower_pin: String = pin
		.trim()
		.lower()

	hash: String = if lower_pin.starts_with("blake3:"):
		strip_prefix("blake3:", lower_pin)
	else:
		lower_pin

	if (
		hash.length() >= 16
		and hash.length() <= 64
		and is_hex_string(hash)
	):
		Some(hash)
	else:
		None


private func package_cache_root() -> String:
	match getenv("BLORP_PACKAGE_CACHE"):
		Some(path):
			if (
				path
					.trim()
					.length() > 0
			):
				path
			else:
				package_cache_root_without_override()
		None:
			package_cache_root_without_override()


private func package_cache_root_without_override() -> String:
	cache_base: String = match getenv("XDG_CACHE_HOME"):
		Some(path):
			if (
				path
					.trim()
					.length() > 0
			):
				path
			else:
				default_package_cache_base()
		None:
			default_package_cache_base()

	join(
		join(cache_base, "blorp"),
		"packages",
	)


private func default_package_cache_base() -> String:
	match getenv("HOME"):
		Some(home):
			if (
				home
					.trim()
					.length() > 0
			):
				join(home, ".cache")
			else:
				join(temp_dir(), ".cache")
		None:
			join(temp_dir(), ".cache")


private func cached_package_root_for_pin(pin: String) -> Option[String]:
	match normalize_hash_pin(pin):
		Some(normalized):
			cache_dir: String = join(
				join(package_cache_root(), "blake3"),
				normalized.take_left(16),
			)

			if not file_exists(join(cache_dir, "READY")):
				None
			else:
				match read_text_file(join(cache_dir, "HASH")):
					Ok(actual):
						if (
							actual
								.trim()
								.lower()
								.starts_with(normalized)
						):
							Some(cache_dir)
						else:
							None
					Err(_):
						None
		None:
			None


private pure func package_cache_fetch_help(
	package_alias: String,
	locations: List[String],
) -> String:
	if locations.length() == 0:
		"Add from = [...] for package `${package_alias}` and run `blorp package fetch ${package_alias}`, or configure a local path."
	else:
		"Run `blorp package fetch ${package_alias}` from the project directory before compiling."


private func package_root_for_alias(
	config_dir: String,
	toml: TomlValue,
	package_alias: String,
) -> Result[String, String]:
	match package_alias_string_config(toml, package_alias, "path"):
		Some(path):
			if (
				path
					.trim()
					.length() == 0
			):
				Err("package alias `${package_alias}` has an empty path")
			else:
				Ok(config_relative_path(config_dir, path))
		None:
			match package_alias_string_config(toml, package_alias, "hash"):
				Some(pin):
					match normalize_hash_pin(pin):
						Some(_):
							match cached_package_root_for_pin(pin):
								Some(package_root):
									Ok(package_root)
								None:
									locations: List[String] = match package_alias_string_list_config(
										toml,
										package_alias,
										"from",
									):
										Some(locations):
											locations
										None:
											[]

									help: String = package_cache_fetch_help(
										package_alias,
										locations,
									)

									Err(
										"package alias `${package_alias}` cannot use hash ${pin} from the local package cache\nhelp: ${help}",
									)
						None:
							Err("package alias `${package_alias}` has an invalid hash pin: ${pin}")
				None:
					Err("package alias `${package_alias}` must define path or hash")


record CliPackageManifest {
	name: String,
	std_compat: String,
	exports: List[String]
}


record CliSourceGraphConfig {
	std_dir: Option[String],
	source_packages: List[CliFrontendSourcePackage],
	diagnostics: List[String]
}


record CliConfiguredSourcePackages {
	packages: List[CliFrontendSourcePackage],
	diagnostics: List[String]
}


private pure func package_manifest_from_toml(toml: TomlValue) -> Option[CliPackageManifest]:
	name ?= toml_string_at(toml, "package.name")
	std_compat ?= toml_string_at(toml, "compat.std")
	exports ?= toml_string_list_at(toml, "exports.modules")

	if (
		valid_package_alias(name)
		and std_compat == CURRENT_PACKAGE_STD_COMPAT
		and exports.length() > 0
	):
		Some({
			name = name,
			std_compat = std_compat,
			exports = exports,
		})
	else:
		None


private func package_exports_exist(source_dir: String, exports: List[String]) -> Bool:
	var ok: Bool = True

	for module_name in exports:
		if not file_exists(join(source_dir, module_source_filename(module_name))):
			ok = False
			break

	ok


private func read_source_package(
	package_alias: String,
	package_root: String,
) -> Option[CliFrontendSourcePackage]:
	normalized_root: String = normalize(package_root)
	source_dir: String = normalize(join(normalized_root, "src"))

	if not is_directory(source_dir):
		None
	else:
		match read_text_file(join(normalized_root, "package.toml")):
			Ok(source):
				match parse_toml(source):
					Ok(toml):
						match package_manifest_from_toml(toml):
							Some(manifest):
								if package_exports_exist(source_dir, manifest.exports):
									Some({
										package_alias = package_alias,
										package_name = manifest.name,
										package_root = normalized_root,
										source_dir = source_dir,
										exports = manifest.exports,
									})
								else:
									None
							None:
								None
					Err(_):
						None
			Err(_):
				None


private func find_blorp_config_from_dir(base_dir: String) -> Option[String]:
	var current: String = absolute_path(base_dir)
	var result: Option[String] = None
	var done: Bool = False

	while not done:
		candidate: String = join(current, "blorp.toml")

		if file_exists(candidate) and not is_directory(candidate):
			result = Some(candidate)
			done = True
		else:
			parent: String = dirname(current)

			if parent == current:
				done = True
			else:
				current = parent

	result


private pure func source_package_seen(
	packages: List[CliFrontendSourcePackage],
	package_alias: String,
	source_dir: String,
) -> Bool:
	var seen: Bool = False

	for package in packages:
		if package.package_alias == package_alias and package.source_dir == source_dir:
			seen = True
			break

	seen


private pure func config_std_dir_from_toml(config_dir: String, toml: TomlValue) -> Option[String]:
	match toml_string_at(toml, "std.path"):
		Some(path):
			if (
				path
					.trim()
					.length() == 0
			):
				None
			else:
				Some(config_relative_path(config_dir, path))
		None:
			None


private func source_packages_from_config_toml(
	config_dir: String,
	toml: TomlValue,
) -> CliConfiguredSourcePackages:
	var packages: List[CliFrontendSourcePackage] = []
	var diagnostics: List[String] = []

	for package_alias in package_aliases_from_toml(toml):
		match package_root_for_alias(config_dir, toml, package_alias):
			Ok(package_root):
				match read_source_package(package_alias, package_root):
					Some(package):
						if not source_package_seen(
							packages,
							package.package_alias,
							package.source_dir,
						):
							packages = packages.append(package)
					None:
						diagnostics = append_unique_string(
							diagnostics,
							"package alias `${package_alias}` does not resolve to a valid source package at `${package_root}`",
						)
			Err(message):
				diagnostics = append_unique_string(diagnostics, message)

	{
		packages = packages,
		diagnostics = diagnostics
	}


private func source_graph_config(config_path: String) -> CliSourceGraphConfig:
	config_dir: String = dirname(config_path)

	match read_text_file(config_path):
		Ok(source):
			match parse_toml(source):
				Ok(toml):
					configured_packages = source_packages_from_config_toml(config_dir, toml)

					{
						std_dir = config_std_dir_from_toml(config_dir, toml),
						source_packages = configured_packages.packages,
						diagnostics = configured_packages.diagnostics
					}
				Err(message):
					{
						std_dir = None,
						source_packages = [],
						diagnostics = ["failed to parse `${config_path}`: ${message}"]
					}
		Err(message):
			{
				std_dir = None,
				source_packages = [],
				diagnostics = ["failed to read `${config_path}`: ${message}"]
			}


private func find_pkg_root_from_dir(base_dir: String) -> Option[String]:
	var current: String = absolute_path(base_dir)
	var result: Option[String] = None
	var done: Bool = False

	while not done:
		candidate: String = join(current, "pkg")

		if is_directory(candidate):
			result = Some(candidate)
			done = True
		else:
			parent: String = dirname(current)

			if parent == current:
				done = True
			else:
				current = parent

	result


private pure func append_unique_package(
	packages: List[CliFrontendSourcePackage],
	package: CliFrontendSourcePackage,
) -> List[CliFrontendSourcePackage]:
	if source_package_seen(packages, package.package_alias, package.source_dir):
		packages
	else:
		packages.append(package)


private pure func append_unique_packages(
	packages: List[CliFrontendSourcePackage],
	more: List[CliFrontendSourcePackage],
) -> List[CliFrontendSourcePackage]:
	var result: List[CliFrontendSourcePackage] = packages

	for package in more:
		result = append_unique_package(result, package)

	result


record CliSourceGraphSetup {
	context: CliFrontendGraphContext,
	diagnostics: List[String]
}


private func source_graph_setup_for_sources(
	action: CliAction,
	roots: List[CliParsedSourceFile],
) -> CliSourceGraphSetup:
	var std_dir: Option[String] = action_or_env_std_dir(action)
	var source_packages: List[CliFrontendSourcePackage] = []
	var package_roots: List[String] = []
	var diagnostics: List[String] = []
	cwd_pkg: String = join(getcwd(), "pkg")

	if is_directory(cwd_pkg):
		package_roots = append_unique_string(package_roots, normalize(cwd_pkg))

	for root in roots:
		base_dir: String = dirname(root.path)

		match find_blorp_config_from_dir(base_dir):
			Some(config_path):
				config: CliSourceGraphConfig = source_graph_config(config_path)

				if std_dir.is_none():
					std_dir = config.std_dir

				source_packages = append_unique_packages(source_packages, config.source_packages)

				for diagnostic in config.diagnostics:
					diagnostics = append_unique_string(diagnostics, diagnostic)
			None:
				void

		match find_pkg_root_from_dir(base_dir):
			Some(pkg_root):
				package_roots = append_unique_string(package_roots, normalize(pkg_root))
			None:
				void

	{
		context = {
			std_dir = std_dir,
			source_packages = source_packages,
			package_roots = package_roots
		},
		diagnostics = diagnostics
	}


private pure func source_identity_seen(
	sources: List[CliSourceIdentity],
	path: String,
	module_name: String,
) -> Bool:
	-- Module name remains part of identity because package aliases can
	-- intentionally assign distinct nominal identities to one physical source.
	-- Explicit roots and package-relative imports are not yet canonicalized
	-- against alternate names for the same path.
	var seen: Bool = False

	for source in sources:
		if source.path == path and source.module_name == module_name:
			seen = True
			break

	seen


private pure func split_module_ref(module_path: String) -> Option[(String, String)]:
	match module_path.split("/"):
		[]:
			None
		[""]:
			None
		[head]:
			if head.length() == 0:
				None
			else:
				Some((head, ""))
		[head, ...rest]:
			if head.length() == 0:
				None
			else:
				Some((head, rest.join("/")))


private func source_package_for_path(
	context: CliFrontendGraphContext,
	path: String,
) -> Option[CliFrontendSourcePackage]:
	if context.source_packages.length() == 0:
		None
	else:
		var result: Option[CliFrontendSourcePackage] = None
		absolute: String = absolute_path(path)

		for package in context.source_packages:
			if is_path_under_dir(package.source_dir, absolute):
				result = Some(package)
				break

		result


private func path_is_in_configured_std(context: CliFrontendGraphContext, path: String) -> Bool:
	match context.std_dir:
		Some(std_dir):
			is_path_under_dir(absolute_path(std_dir), absolute_path(path))
		None:
			False


private func configured_std_module_name(
	context: CliFrontendGraphContext,
	path: String,
) -> Option[String]:
	match context.std_dir:
		Some(std_dir):
			std_root: String = absolute_path(std_dir)
			absolute: String = absolute_path(path)

			if is_path_under_dir(std_root, absolute):
				relative: String = strip_prefix(std_root + "/", absolute)

				without_extension: String = if relative.ends_with(".brp"):
					relative.substring(0, relative.length() - 4)
				else:
					relative

				Some("std/" + without_extension)
			else:
				None
		None:
			None


private pure func parsed_program_with_module_name(
	program: ParsedProgram,
	module_name: String,
) -> ParsedProgram:
	{ program | source = { program.source | module_name = module_name } }


private func normalize_root_module_name(
	context: CliFrontendGraphContext,
	source: CliParsedSourceFile,
) -> CliParsedSourceFile:
	match configured_std_module_name(context, source.path):
		Some(module_name):
			{
				source |
				module_name = module_name,
				typecheck_program = parsed_program_with_module_name(source.typecheck_program, module_name)
			}
		None:
			source


private func normalize_root_module_names(
	context: CliFrontendGraphContext,
	roots: List[CliParsedSourceFile],
) -> List[CliParsedSourceFile]:
	roots.map(func(source): normalize_root_module_name(context, source))


private func frontend_module_origin_for_path(
	context: CliFrontendGraphContext,
	path: String,
	module_name: String,
) -> CliFrontendModuleOrigin:
	if module_name.starts_with("std/") or path_is_in_configured_std(context, path):
		CliFrontendStdModule
	else if module_name.starts_with("pkg/"):
		match split_module_ref(strip_prefix("pkg/", module_name)):
			Some((package_id, _)):
				CliFrontendPkgModule(package_id)
			None:
				CliFrontendPkgModule("pkg")
	else:
		match source_package_for_path(context, path):
			Some(package):
				CliFrontendSourcePackageModule(package.package_alias)
			None:
				CliFrontendUserModule


private func frontend_graph_source(
	context: CliFrontendGraphContext,
	source: CliParsedSourceFile,
) -> CliFrontendGraphSource:
	{
		path = owned_string(source.path),
		module_name = owned_string(source.module_name),
		source_text = owned_string(source.source_text),
		parsed_source = source.parsed_source,
		typecheck_program = source.typecheck_program,
		origin = frontend_module_origin_for_path(context, source.path, source.module_name)
	}


private func frontend_graph_sources(
	context: CliFrontendGraphContext,
	sources: List[CliParsedSourceFile],
) -> List[CliFrontendGraphSource]:
	var graph_sources: List[CliFrontendGraphSource] = []

	for source in sources:
		graph_sources = graph_sources.append(frontend_graph_source(context, source))

	graph_sources


private func resolved_import_origin(
	context: CliFrontendGraphContext,
	resolved: CliResolvedImportSource,
) -> CliFrontendModuleOrigin:
	frontend_module_origin_for_path(context, resolved.path, resolved.module_name)


private pure func resolved_import_path(resolved: Option[CliResolvedImportSource]) -> Option[String]:
	match resolved:
		Some(source):
			Some(source.path)
		None:
			None


private pure func resolved_import_module(
	resolved: Option[CliResolvedImportSource],
) -> Option[String]:
	match resolved:
		Some(source):
			Some(source.module_name)
		None:
			None


private func resolved_import_module_origin(
	context: CliFrontendGraphContext,
	resolved: Option[CliResolvedImportSource],
) -> Option[CliFrontendModuleOrigin]:
	match resolved:
		Some(source):
			Some(resolved_import_origin(context, source))
		None:
			None


private func frontend_import_edge(
	context: CliFrontendGraphContext,
	source: CliParsedSourceFile,
	module_path: String,
	resolved: Option[CliResolvedImportSource],
) -> CliFrontendImportEdge:
	{
		from_path = source.path,
		from_module = source.module_name,
		import_path = module_path,
		resolved_path = resolved_import_path(resolved),
		resolved_module = resolved_import_module(resolved),
		resolved_origin = resolved_import_module_origin(context, resolved)
	}


private pure func filesystem_import_source(
	path: String,
	module_name: String,
) -> CliResolvedImportSource:
	{
		path = normalize(path),
		module_name = module_name,
		contents = CliFilesystemImport
	}


private pure func embedded_std_import_source(
	module_name: String,
) -> Option[CliResolvedImportSource]:
	source_text ?= embedded_std_source(module_name)

	Some({
		path = "<embedded:${module_name}>",
		module_name = module_name,
		contents = CliEmbeddedImport(source_text),
	})


private pure func source_package_export_for_alias(
	package: CliFrontendSourcePackage,
	module_path: String,
) -> Option[String]:
	match split_module_ref(module_path):
		Some((head, rest)):
			if head != package.package_alias:
				None
			else:
				package_module: String = if rest.length() == 0:
					"" + package.package_name
				else:
					package.package_name + "/" + rest

				if package.exports.contains(package_module):
					Some(package_module)
				else:
					None
		None:
			None


private func resolve_source_package_alias_import(
	context: CliFrontendGraphContext,
	module_path: String,
) -> Option[CliResolvedImportSource]:
	var result: Option[CliResolvedImportSource] = None

	for package in context.source_packages:
		if result.is_some():
			break

		match source_package_export_for_alias(package, module_path):
			Some(package_module):
				path: String = join(package.source_dir, module_source_filename(package_module))

				if file_exists(path):
					result = Some(filesystem_import_source(path, module_path))
			None:
				void

	result


private func resolve_source_package_internal_import(
	package: CliFrontendSourcePackage,
	module_path: String,
) -> Option[CliResolvedImportSource]:
	if module_path == package.package_name or module_path.starts_with(package.package_name + "/"):
		path: String = join(package.source_dir, module_source_filename(module_path))

		if file_exists(path):
			Some(filesystem_import_source(path, module_path))
		else:
			None
	else:
		None


private pure func relative_import_allowed(
	current_package: Option[CliFrontendSourcePackage],
	candidate: String,
) -> Bool:
	match current_package:
		Some(package):
			is_path_under_dir(package.source_dir, candidate)
		None:
			True


private func resolve_relative_import_source(
	current_package: Option[CliFrontendSourcePackage],
	base_dir: String,
	module_path: String,
) -> Option[CliResolvedImportSource]:
	candidate: String = if module_path.starts_with("./"):
		rest: String = strip_prefix("./", module_path)
		normalize(join(base_dir, module_source_filename(rest)))
	else:
		normalize(join(base_dir, module_source_filename(module_path)))

	if file_exists(candidate) and relative_import_allowed(current_package, candidate):
		Some(filesystem_import_source(candidate, module_name_for_resolved_source_path(candidate)))
	else:
		None


private func resolve_pkg_import_source_path(
	context: CliFrontendGraphContext,
	current_package: Option[CliFrontendSourcePackage],
	base_dir: String,
	module_path: String,
) -> Option[CliResolvedImportSource]:
	if current_package.is_some():
		None
	else:
		std_base: Bool = match context.std_dir:
			Some(std_dir):
				is_path_under_dir(std_dir, absolute_path(base_dir))
			None:
				False

		if std_base:
			None
		else:
			rest: String = strip_prefix("pkg/", module_path)
			var result: Option[CliResolvedImportSource] = None

			for package_root in context.package_roots:
				if result.is_some():
					break

				candidate: String = join(package_root, module_source_filename(rest))

				if file_exists(candidate):
					result = Some(filesystem_import_source(candidate, module_path))

			result


private func resolve_import_source_path(
	context: CliFrontendGraphContext,
	base_dir: String,
	module_path: String,
) -> Option[CliResolvedImportSource]:
	current_package: Option[CliFrontendSourcePackage] = source_package_for_path(context, base_dir)

	if module_path.starts_with("pkg/"):
		resolve_pkg_import_source_path(context, current_package, base_dir, module_path)
	else if module_path.starts_with("std/"):
		match context.std_dir:
			Some(dir):
				rest: String = strip_prefix("std/", module_path)
				path: String = join(dir, module_source_filename(rest))

				if file_exists(path):
					Some(filesystem_import_source(path, module_path))
				else:
					None
			None:
				embedded_std_import_source(module_path)
	else if module_path.starts_with("./") or module_path.starts_with("../"):
		resolve_relative_import_source(current_package, base_dir, module_path)
	else:
		match current_package:
			Some(package):
				resolve_source_package_internal_import(package, module_path)
			None:
				match resolve_source_package_alias_import(context, module_path):
					Some(resolved):
						Some(resolved)
					None:
						match context.std_dir:
							Some(dir):
								std_path: String = join(dir, module_source_filename(module_path))

								if file_exists(std_path):
									Some(filesystem_import_source(std_path, "std/" + module_path))
								else:
									local_path: String = join(
										base_dir,
										module_source_filename(module_path),
									)

									if file_exists(local_path):
										Some(
											filesystem_import_source(
												local_path,
												module_name_for_resolved_source_path(local_path),
											),
										)
									else:
										None
							None:
								match embedded_std_import_source("std/" + module_path):
									Some(embedded):
										Some(embedded)
									None:
										local_path: String = join(
											base_dir,
											module_source_filename(module_path),
										)

										if file_exists(local_path):
											Some(
												filesystem_import_source(
													local_path,
													module_name_for_resolved_source_path(
														local_path,
													),
												),
											)
										else:
											None


private func read_cli_import_source(
	resolved: CliResolvedImportSource,
) -> Result[Option[CliSourceFile], String]:
	match resolved.contents:
		CliEmbeddedImport(source_text):
			Ok(Some({
				path = resolved.path,
				module_name = resolved.module_name,
				source_text = source_text,
			}))
		CliFilesystemImport:
			if not file_exists(resolved.path):
				Ok(None)
			else:
				source ?= read_text_file(
					resolved.path,
				).map_err(
					func(err): "failed to read source file `" + resolved.path + "`: " + err,
				)

				Ok(Some({
					path = resolved.path,
					module_name = resolved.module_name,
					source_text = source,
				}))


private func discover_import_sources_for_parsed_source(
	context: CliFrontendGraphContext,
	source: CliParsedSourceFile,
	seen_sources: List[CliSourceIdentity],
) -> Result[CliSourceGraphDiscovery, String]:
	var sources: List[CliSourceFile] = []
	var seen: List[CliSourceIdentity] = seen_sources
	var import_edges: List[CliFrontendImportEdge] = []
	var error: Option[String] = None
	base_dir: String = dirname(source.path)
	import_paths ?= parsed_source_import_paths(source)

	for module_path in import_paths:
		match error:
			Some(_):
				break
			None:
				resolved: Option[CliResolvedImportSource] = resolve_import_source_path(
					context,
					base_dir,
					module_path,
				)
				import_edges = import_edges.append(
					frontend_import_edge(
						context,
						source,
						module_path,
						resolved,
					),
				)

				match resolved:
					Some(resolved):
						if not source_identity_seen(seen, resolved.path, resolved.module_name):
							match read_cli_import_source(resolved):
								Ok(Some(import_source)):
									seen = seen.append({
										path = import_source.path,
										module_name = import_source.module_name,
									})
									sources = sources.append(import_source)
								Ok(None):
									void
								Err(message):
									error = Some(message)
					None:
						void

	match error:
		Some(message):
			Err(message)
		None:
			Ok({
				sources = sources,
				seen_sources = seen,
				import_edges = import_edges,
			})


private func discover_import_sources_for_parsed_sources(
	context: CliFrontendGraphContext,
	parsed_sources: List[CliParsedSourceFile],
	seen_sources: List[CliSourceIdentity],
) -> Result[CliSourceGraphDiscovery, String]:
	var sources: List[CliSourceFile] = []
	var seen: List[CliSourceIdentity] = seen_sources
	var import_edges: List[CliFrontendImportEdge] = []
	var error: Option[String] = None

	for source in parsed_sources:
		match error:
			Some(_):
				break
			None:
				match discover_import_sources_for_parsed_source(context, source, seen):
					Ok(discovery):
						seen = discovery.seen_sources
						sources = sources.concat(discovery.sources)
						import_edges = import_edges.concat(discovery.import_edges)
					Err(message):
						error = Some(message)

	match error:
		Some(message):
			Err(message)
		None:
			Ok({
				sources = sources,
				seen_sources = seen,
				import_edges = import_edges,
			})


private pure func generated_import_binding(
	bindings: List[CliGeneratedModuleImport],
	module_path: String,
) -> Result[Option[CliGeneratedModuleImport], String]:
	var found: Option[CliGeneratedModuleImport] = None
	var count: Int = 0

	for binding in bindings:
		if binding.module_path == module_path:
			found = Some(binding)
			count += 1

	if count > 1:
		Err("generated module has duplicate binding for import `" + module_path + "`")
	else:
		Ok(found)


private pure func existing_source_for_generated_import(
	sources: List[CliFrontendGraphSource],
	binding: CliGeneratedModuleImport,
) -> Result[CliFrontendGraphSource, String]:
	var found: Option[CliFrontendGraphSource] = None
	var count: Int = 0

	for source in sources:
		if source.path == binding.source_path and source.module_name == binding.source_module:
			found = Some(source)
			count += 1

	if count == 0:
		Err(
			"generated import `" + binding.module_path + "` targets an absent graph identity `" + binding.source_module + "` at `" + binding.source_path + "`",
		)
	else if count > 1:
		Err("generated import `" + binding.module_path + "` targets an ambiguous graph identity")
	else:
		match found:
			Some(source):
				Ok(source)
			None:
				Err("internal error: generated import lookup lost its source")


private pure func existing_source_for_generated_module_path(
	sources: List[CliFrontendGraphSource],
	module_path: String,
) -> Result[CliFrontendGraphSource, String]:
	var found: Option[CliFrontendGraphSource] = None
	var count: Int = 0

	for source in sources:
		if source.module_name == module_path:
			found = Some(source)
			count += 1

	if count == 0:
		Err("generated import `" + module_path + "` is absent from the retained graph")
	else if count > 1:
		Err("generated import `" + module_path + "` has an ambiguous retained graph identity")
	else:
		match found:
			Some(source):
				Ok(source)
			None:
				Err("internal error: generated module lookup lost its source")


private pure func ambiguous_generated_import_module(
	bindings: List[CliGeneratedModuleImport],
) -> Option[String]:
	var seen: List[CliGeneratedModuleImport] = []
	var ambiguous: Option[String] = None

	for binding in bindings:
		if ambiguous.is_some():
			break

		if seen.any(
			func(
				existing,
			): (
				existing.source_module == binding.source_module
				and existing.source_path != binding.source_path
			),
		):
			ambiguous = Some(binding.source_module)
		else:
			seen = seen.append(binding)

	ambiguous


private pure func frontend_import_edge_for_existing_source(
	source: CliParsedSourceFile,
	module_path: String,
	target: CliFrontendGraphSource,
) -> CliFrontendImportEdge:
	{
		from_path = source.path,
		from_module = source.module_name,
		import_path = module_path,
		resolved_path = Some(target.path),
		resolved_module = Some(target.module_name),
		resolved_origin = Some(target.origin)
	}


private pure func existing_generated_import_target(
	existing_sources: List[CliFrontendGraphSource],
	bindings: List[CliGeneratedModuleImport],
	module_path: String,
) -> Result[CliFrontendGraphSource, String]:
	match generated_import_binding(bindings, module_path):
		Err(message):
			Err(message)
		Ok(Some(binding)):
			existing_source_for_generated_import(existing_sources, binding)
		Ok(None):
			existing_source_for_generated_module_path(existing_sources, module_path)


private func generated_import_edges(
	source: CliParsedSourceFile,
	existing_sources: List[CliFrontendGraphSource],
	bindings: List[CliGeneratedModuleImport],
) -> Result[List[CliFrontendImportEdge], String]:
	var import_edges: List[CliFrontendImportEdge] = []
	var error: Option[String] = None
	import_paths ?= parsed_source_import_paths(source)

	for module_path in import_paths:
		if error.is_some():
			break

		match existing_generated_import_target(existing_sources, bindings, module_path):
			Err(message):
				error = Some(message)
			Ok(target):
				import_edges = import_edges.append(
					frontend_import_edge_for_existing_source(
						source,
						module_path,
						target,
					),
				)

	match error:
		Some(message):
			Err(message)
		None:
			Ok(import_edges)


private pure func parsed_source_identities(
	sources: List[CliParsedSourceFile],
) -> List[CliSourceIdentity]:
	var identities: List[CliSourceIdentity] = []

	for source in sources:
		identities = identities.append({
			path = source.path,
			module_name = source.module_name,
		})

	identities


record CliSourceGraphWalk {
	modules: List[CliParsedSourceFile],
	import_edges: List[CliFrontendImportEdge]
}


private func implicit_prelude_sources(
	context: CliFrontendGraphContext,
	roots: List[CliParsedSourceFile],
) -> Result[List[CliSourceFile], String]:
	if roots.any(func(root): root.module_name == "std/prelude"):
		Ok([])
	else:
		match context.std_dir:
			Some(std_dir):
				path: String = normalize(join(std_dir, "prelude.brp"))

				if roots.any(func(root): normalize(root.path) == path) or not file_exists(path):
					Ok([])
				else:
					source ?= read_text_file(
						path,
					).map_err(
						func(err): "failed to read implicit prelude `${path}`: ${err}",
					)

					Ok(
						[
							{
								path = path,
								module_name = "std/prelude",
								source_text = source
							},
						],
					)
			None:
				match embedded_std_source("std/prelude"):
					Some(source):
						Ok(
							[
								{
									path = "<embedded:std/prelude>",
									module_name = "std/prelude",
									source_text = source
								},
							],
						)
					None:
						Err("embedded standard library is missing `std/prelude`")


private func implicit_prelude_sources_if_enabled(
	context: CliFrontendGraphContext,
	roots: List[CliParsedSourceFile],
	enabled: Bool,
) -> Result[List[CliSourceFile], String]:
	if enabled:
		implicit_prelude_sources(context, roots)
	else:
		Ok([])


private func source_graph_walk_for_roots(
	context: CliFrontendGraphContext,
	roots: List[CliParsedSourceFile],
	include_implicit_prelude: Bool,
) -> Result[CliSourceGraphWalk, String]:
	var modules: List[CliParsedSourceFile] = []
	var import_edges: List[CliFrontendImportEdge] = []
	var seen_sources: List[CliSourceIdentity] = parsed_source_identities(roots)
	prelude_sources ?= implicit_prelude_sources_if_enabled(context, roots, include_implicit_prelude)

	for source in prelude_sources:
		if not source_identity_seen(seen_sources, source.path, source.module_name):
			seen_sources = seen_sources.append({
				path = source.path,
				module_name = source.module_name,
			})

	initial ?= discover_import_sources_for_parsed_sources(context, roots, seen_sources)
	seen_sources = initial.seen_sources
	import_edges = import_edges.concat(initial.import_edges)
	var pending: List[CliSourceFile] = prelude_sources.concat(initial.sources)
	var error: Option[String] = None

	while pending.length() > 0:
		match error:
			Some(_):
				break
			None:
				match parse_cli_sources(pending):
					Ok(parsed_batch):
						modules = modules.concat(parsed_batch)

						match discover_import_sources_for_parsed_sources(
							context,
							parsed_batch,
							seen_sources,
						):
							Ok(discovery):
								seen_sources = discovery.seen_sources
								import_edges = import_edges.concat(discovery.import_edges)
								pending = discovery.sources
							Err(message):
								error = Some(message)
					Err(message):
						error = Some(message)

	match error:
		Some(message):
			Err(message)
		None:
			Ok({
				modules = modules,
				import_edges = import_edges,
			})


func source_graph_modules_for_roots(
	action: CliAction,
	roots: List[CliParsedSourceFile],
) -> Result[List[CliParsedSourceFile], String]:
	setup: CliSourceGraphSetup = source_graph_setup_for_sources(action, roots)
	context: CliFrontendGraphContext = setup.context
	normalized_roots: List[CliParsedSourceFile] = normalize_root_module_names(context, roots)
	walk ?= source_graph_walk_for_roots(context, normalized_roots, False)
	Ok(walk.modules)


func frontend_module_graph_for_roots(
	action: CliAction,
	roots: List[CliParsedSourceFile],
) -> Result[CliFrontendModuleGraph, String]:
	setup: CliSourceGraphSetup = source_graph_setup_for_sources(action, roots)
	context: CliFrontendGraphContext = setup.context
	normalized_roots: List[CliParsedSourceFile] = normalize_root_module_names(context, roots)
	walk ?= source_graph_walk_for_roots(context, normalized_roots, True)

	Ok({
		context = context,
		roots = frontend_graph_sources(context, normalized_roots),
		modules = frontend_graph_sources(context, walk.modules),
		import_edges = walk.import_edges,
		diagnostics = setup.diagnostics,
	})


func frontend_module_graph_with_generated_root(
	graph: CliFrontendModuleGraph,
	generated_module: CliGeneratedModule,
) -> Result[CliFrontendModuleGraph, String]:
	existing_sources: List[CliFrontendGraphSource] = graph.roots.concat(graph.modules)
	collision: Option[CliFrontendGraphSource] = existing_sources.find(
		func(
			source,
		): (
			source.path == generated_module.source.path
			or source.module_name == generated_module.source.module_name
		),
	)

	match collision:
		Some(source):
			Err(
				"generated module identity collides with existing graph source `" + source.module_name + "` at `" + source.path + "`",
			)
		None:
			match ambiguous_generated_import_module(generated_module.imports):
				Some(module_name):
					Err(
						"generated imports target distinct sources with the same module identity `" + module_name + "`",
					)
				None:
					generated ?= parse_cli_source(generated_module.source)
					import_edges ?= generated_import_edges(
						generated,
						existing_sources,
						generated_module.imports,
					)
					generated_root: CliFrontendGraphSource = {
						path = owned_string(generated.path),
						module_name = owned_string(generated.module_name),
						source_text = owned_string(generated.source_text),
						parsed_source = generated.parsed_source,
						typecheck_program = generated.typecheck_program,
						origin = CliFrontendGeneratedModule
					}

					Ok({
						context = graph.context,
						roots = [generated_root],
						modules = existing_sources,
						import_edges = graph.import_edges.concat(import_edges),
						diagnostics = graph.diagnostics,
					})


func parse_cli_source_file_for_action(
	action: CliAction,
	path: String,
) -> Result[CliParsedSourceFile, String]:
	source ?= read_cli_source_file_for_action(action, path)
	parse_cli_source(source)
