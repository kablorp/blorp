-- Blorp-owned execution of the public package command surface.
--
-- Argument parsing remains in args/plan. This module translates that
-- typed plan into package-domain operations and presentation only; package
-- identity, validation, hashing, and cache verification live below it.
import:
	../stage_04_modules/package_hash:
		compiler_hash_package_files,
		compiler_package_hash_matches_pin,
		compiler_validate_package_hash_pin,
	../stage_04_modules/project_source_catalog:
		CompilerProjectPackageConfiguration,
		CompilerProjectPackageEntry,
		CompilerProjectSourceCatalogIssue(
			CompilerProjectConfigParseFailed,
			CompilerProjectConfigReadFailed,
			CompilerProjectConflictingPackageAlias,
			CompilerProjectConflictingStdDirectories,
			CompilerProjectInvalidSourcePackage,
			CompilerProjectPackageCacheUnavailable,
			CompilerProjectPackageHashInvalid,
			CompilerProjectPackageLocationMissing,
			CompilerProjectPackagePathEmpty,
			CompilerProjectStdDirectoryInvalid,
		),
		compiler_project_package_configuration,
	package_artifact: write_cli_package_artifact
	package_cache:
		CliCachedPackage,
		fetch_cli_package,
		find_cli_cached_package,
		vendor_cli_cached_package,
	package_check: check_cli_package
	path: dirname, join
	plan:
		CliHandledResult,
		CliPackageRunCommand(
			CliPackageRunCheck,
			CliPackageRunFetchAll,
			CliPackageRunFetchTarget,
			CliPackageRunHash,
			CliPackageRunPack,
			CliPackageRunVendorAll,
			CliPackageRunVendorTarget,
		),
		CliPackageRunPlan,
	system: file_exists, getcwd


private union CliPackageFetchResult:
	CliPackageFetched(CliCachedPackage)
	CliPackageAlreadyCached(CliCachedPackage)


private union CliPackageVendorResult:
	CliPackageVendored(String, String, String)
	CliPackageAlreadyVendored(String, String, String)


private record CliPackageConfigurationMatch {
	configuration: CompilerProjectPackageConfiguration,
	package_index: Int
}


private pure func package_success(stdout: String) -> CliHandledResult:
	{
		status = 0,
		stdout = stdout,
		stderr = ""
	}


private pure func package_failure(errors: List[String]) -> CliHandledResult:
	{
		status = 1,
		stdout = "",
		stderr = errors.join("\n")
	}


private pure func package_configuration_issue_text(
	issue: CompilerProjectSourceCatalogIssue,
) -> String:
	match issue:
		CompilerProjectConfigReadFailed(path, detail):
			"failed to read `${path}`: ${detail}"
		CompilerProjectConfigParseFailed(path, detail):
			"failed to parse `${path}`: ${detail}"
		CompilerProjectPackagePathEmpty(package_alias):
			"package alias `${package_alias}` has an empty path"
		CompilerProjectPackageLocationMissing(package_alias):
			"package alias `${package_alias}` must define path or hash"
		CompilerProjectPackageHashInvalid(package_alias, pin):
			"package alias `${package_alias}` has an invalid hash pin: ${pin}"
		CompilerProjectPackageCacheUnavailable(package_alias, pin, _):
			"package alias `${package_alias}` cannot use hash ${pin} from the local package cache"
		CompilerProjectInvalidSourcePackage(package_alias, package_root, _):
			"package alias `${package_alias}` does not resolve to a valid source package at `${package_root}`"
		CompilerProjectStdDirectoryInvalid(path):
			"standard-library directory `${path}` does not exist or is not a directory"
		CompilerProjectConflictingStdDirectories(selected, configured):
			"source roots require conflicting standard-library directories `${selected}` and `${configured}`"
		CompilerProjectConflictingPackageAlias(package_alias, existing, conflicting):
			"package alias `${package_alias}` resolves to both `${existing}` and `${conflicting}`"


private func package_configuration(
	command_name: String,
) -> Result[CompilerProjectPackageConfiguration, List[String]]:
	match compiler_project_package_configuration(getcwd()):
		Err(issues):
			Err(issues.map(package_configuration_issue_text))
		Ok(None):
			Err(["no blorp.toml found for package ${command_name}"])
		Ok(Some(configuration)):
			Ok(configuration)


private pure func package_pins_overlap(left: String, right: String) -> Bool:
	match (compiler_validate_package_hash_pin(left), compiler_validate_package_hash_pin(right)):
		(Ok(left_pin), Ok(right_pin)):
			if left_pin == right_pin:
				True
			else if left_pin.length() <= right_pin.length():
				right_pin.starts_with(left_pin)
			else:
				left_pin.starts_with(right_pin)
		_:
			False


private func package_configuration_lookup(
	target: String,
) -> Result[CliPackageConfigurationMatch, List[String]]:
	configuration ?= package_configuration("command")

	match configuration.packages.find_index(func(package): package.package_alias == target):
		Some(package_index):
			Ok({
				configuration = configuration,
				package_index = package_index,
			})
		None:
			var matching_indexes: List[Int] = []
			var package_index: Int = 0

			for package in configuration.packages:
				if (
					package.package_hash_pin
						.map(func(pin): package_pins_overlap(pin, target))
						.get_or(False)
				):
					matching_indexes = matching_indexes.append(package_index)

				package_index += 1

			match matching_indexes:
				[matched_index]:
					Ok({
						configuration = configuration,
						package_index = matched_index,
					})
				[]:
					Err(["package `${target}` is not declared in the nearest blorp.toml"])
				_:
					aliases: String = matching_indexes
						.filter_map(func(index):
							configuration.packages
								.get(index)
								.map(func(package): package.package_alias)
						)
						.join(", ")
					Err(
						[
							"package hash `${target}` matches multiple aliases in the nearest blorp.toml: ${aliases}",
						],
					)


private pure func configured_package_hash(
	package: CompilerProjectPackageEntry,
) -> Result[String, List[String]]:
	package.package_hash_pin.to_result(
		[
			"package alias `${package.package_alias}` must define hash to use package fetch or vendor",
		],
	)


private pure func fetch_result_text(package_alias: String, result: CliPackageFetchResult) -> String:
	match result:
		CliPackageFetched(package):
			"Fetched ${package_alias}\nHash ${package.hash}\nCache ${package.path}"
		CliPackageAlreadyCached(package):
			"Already cached ${package_alias}\nHash ${package.hash}\nCache ${package.path}"


private func fetch_configured_package(
	package: CompilerProjectPackageEntry,
) -> Result[CliPackageFetchResult, List[String]]:
	hash ?= configured_package_hash(package)

	match find_cli_cached_package(hash):
		Ok(cached):
			Ok(CliPackageAlreadyCached(cached))
		Err(_):
			if package.package_from.length() == 0:
				Err(
					[
						"package alias `${package.package_alias}` has no from locations; pass locations explicitly",
					],
				)
			else:
				match fetch_cli_package(hash, package.package_from):
					Ok(cached):
						Ok(CliPackageFetched(cached))
					Err(errors):
						Err(errors)


private func fetch_explicit_package(
	target: String,
	locations: List[String],
) -> Result[(String, CliPackageFetchResult), List[String]]:
	pin ?= compiler_validate_package_hash_pin(target).map_err(func(error):
		["package hash `${target}` is invalid: ${error}"]
	)

	match find_cli_cached_package(pin):
		Ok(cached):
			Ok((cached.inventory.manifest.name, CliPackageAlreadyCached(cached)))
		Err(_):
			cached ?= fetch_cli_package(pin, locations)
			Ok((cached.inventory.manifest.name, CliPackageFetched(cached)))


private func execute_package_fetch_target(
	target: String,
	locations: List[String],
) -> CliHandledResult:
	result: Result[(String, CliPackageFetchResult), List[String]] = if locations.length() > 0:
		fetch_explicit_package(target, locations)
	else:
		match package_configuration_lookup(target):
			Err(errors):
				Err(errors)
			Ok(found):
				match found.configuration.packages.get(found.package_index):
					None:
						Err(["internal package configuration index is out of bounds"])
					Some(package):
						fetch_configured_package(package).map(func(fetch_result):
							(package.package_alias, fetch_result)
						)

	match result:
		Err(errors):
			package_failure(errors)
		Ok((package_alias, fetch_result)):
			package_success(fetch_result_text(package_alias, fetch_result))


private func execute_package_fetch_all() -> CliHandledResult:
	match package_configuration("fetch"):
		Err(errors):
			package_failure(errors)
		Ok(configuration):
			var lines: List[String] = []
			var errors: List[String] = []

			for package in configuration.packages:
				match package.package_hash_pin:
					None:
						lines = lines.append("Skipped local package ${package.package_alias}")
					Some(hash):
						match find_cli_cached_package(hash):
							Ok(cached):
								lines = lines.append(
									fetch_result_text(
										package.package_alias,
										CliPackageAlreadyCached(cached),
									),
								)
							Err(_):
								if (
									package.package_path.is_some()
									and package.package_from.length() == 0
								):
									lines = lines.append(
										"Skipped local package ${package.package_alias}",
									)
								else:
									match fetch_configured_package(package):
										Ok(result):
											lines = lines.append(
												fetch_result_text(
													package.package_alias,
													result,
												),
											)
										Err(found):
											errors = errors.concat(found)

			if errors.length() > 0:
				package_failure(errors)
			else if lines.length() == 0:
				package_success("No packages declared")
			else:
				package_success(lines.join("\n"))


private func local_package_hash(path: String) -> Result[String, List[String]]:
	inventory ?= check_cli_package(path)
	compiler_hash_package_files(path, inventory.source_files).map_err(func(errors):
		errors.map(func(error): error.message)
	)


private func existing_vendor_hash(
	pin: String,
	destination: String,
) -> Result[Option[String], List[String]]:
	if not file_exists(destination):
		Ok(None)
	else:
		match local_package_hash(destination):
			Err(errors):
				detail: String = errors.join("\n")
				Err(
					[
						"vendor destination `${destination}` already exists but is not a valid package:\n${detail}",
					],
				)
			Ok(actual):
				if compiler_package_hash_matches_pin(pin, actual):
					Ok(Some(actual))
				else:
					Err(
						[
							"vendor destination `${destination}` already exists but has the wrong hash\nExpected ${pin}\nFound ${actual}",
						],
					)


private func vendor_new_package(
	name: String,
	pin: String,
	destination: String,
) -> Result[CliPackageVendorResult, List[String]]:
	cached ?= vendor_cli_cached_package(pin, destination)
	Ok(CliPackageVendored(name, cached.hash, destination))


private func vendor_default_package(
	name: String,
	pin: String,
	destination: String,
) -> Result[CliPackageVendorResult, List[String]]:
	match existing_vendor_hash(pin, destination):
		Err(errors):
			Err(errors)
		Ok(Some(actual)):
			Ok(CliPackageAlreadyVendored(name, actual, destination))
		Ok(None):
			vendor_new_package(name, pin, destination)


private pure func vendor_result_text(result: CliPackageVendorResult) -> String:
	match result:
		CliPackageVendored(name, hash, path):
			"Vendored ${name}\nHash ${hash}\nPath ${path}"
		CliPackageAlreadyVendored(name, hash, path):
			"Already vendored ${name}\nHash ${hash}\nPath ${path}"


private func vendor_configured_package(
	configuration: CompilerProjectPackageConfiguration,
	package: CompilerProjectPackageEntry,
	destination: Option[String],
) -> Result[CliPackageVendorResult, List[String]]:
	hash ?= configured_package_hash(package)
	dest: String = destination.get_or(
		join(
			join(dirname(configuration.config_path), "vendor"),
			package.package_alias,
		),
	)

	match destination:
		Some(_):
			vendor_new_package(package.package_alias, hash, dest)
		None:
			vendor_default_package(package.package_alias, hash, dest)


private func vendor_hash_target(
	target: String,
	destination: String,
) -> Result[CliPackageVendorResult, List[String]]:
	pin ?= compiler_validate_package_hash_pin(target).map_err(func(error):
		["invalid package hash: ${error}"]
	)
	cached ?= find_cli_cached_package(pin)
	vendor_new_package(cached.inventory.manifest.name, pin, destination)


private func execute_package_vendor_target(
	target: String,
	destination: Option[String],
) -> CliHandledResult:
	result: Result[CliPackageVendorResult, List[String]] = match destination:
		Some(dest):
			match compiler_validate_package_hash_pin(target):
				Ok(_):
					vendor_hash_target(target, dest)
				Err(_):
					match package_configuration_lookup(target):
						Ok(found):
							match found.configuration.packages.get(found.package_index):
								Some(package):
									vendor_configured_package(
										found.configuration,
										package,
										Some(dest),
									)
								None:
									Err(["internal package configuration index is out of bounds"])
						Err(_):
							vendor_hash_target(target, dest)
		None:
			match package_configuration_lookup(target):
				Ok(found):
					match found.configuration.packages.get(found.package_index):
						Some(package):
							vendor_configured_package(found.configuration, package, None)
						None:
							Err(["internal package configuration index is out of bounds"])
				Err(errors):
					Err(errors)

	match result:
		Ok(vendor_result):
			package_success(vendor_result_text(vendor_result))
		Err(errors):
			package_failure(errors)


private func execute_package_vendor_all() -> CliHandledResult:
	match package_configuration("vendor"):
		Err(errors):
			package_failure(errors)
		Ok(configuration):
			var lines: List[String] = []
			var errors: List[String] = []

			for package in configuration.packages:
				if package.package_path.is_some() or package.package_hash_pin.is_none():
					lines = lines.append("Skipped local package ${package.package_alias}")
				else:
					match vendor_configured_package(configuration, package, None):
						Ok(result):
							lines = lines.append(vendor_result_text(result))
						Err(found):
							detail: String = found.join("\n")
							errors = errors.concat(
								["package alias `${package.package_alias}`:\n${detail}"],
							)

			if errors.length() > 0:
				package_failure(errors)
			else if lines.length() == 0:
				package_success("No packages declared")
			else:
				package_success(lines.join("\n"))


func execute_package_plan(plan: CliPackageRunPlan) -> CliHandledResult:
	match plan.command:
		CliPackageRunCheck(path):
			match check_cli_package(path):
				Err(errors):
					package_failure(errors)
				Ok(inventory):
					package_success(
						"Package ${inventory.manifest.name}: ok (${inventory.source_files.length()} source files checked)",
					)
		CliPackageRunHash(path):
			match check_cli_package(path):
				Err(errors):
					package_failure(errors)
				Ok(inventory):
					match compiler_hash_package_files(path, inventory.source_files):
						Err(errors):
							package_failure(errors.map(
								func(error): error.message,
							))
						Ok(hash):
							package_success(hash)
		CliPackageRunPack(path, output):
			match check_cli_package(path):
				Err(errors):
					package_failure(errors)
				Ok(inventory):
					match write_cli_package_artifact(path, inventory.source_files, output):
						Err(errors):
							package_failure(errors)
						Ok(hash):
							package_success("Wrote ${output}\nHash ${hash}")
		CliPackageRunFetchAll:
			execute_package_fetch_all()
		CliPackageRunFetchTarget(target, locations):
			execute_package_fetch_target(target, locations)
		CliPackageRunVendorAll:
			execute_package_vendor_all()
		CliPackageRunVendorTarget(target, destination):
			execute_package_vendor_target(target, destination)
