-- Shared human-readable frontend output for source-oriented CLI commands.
--
-- Parse-only output intentionally starts from source text. It must not enter
-- typechecking or the semantic-middle worker because `compile --ast` is a
-- parser command even when the program contains type errors.
import:
	../stage_01_file_io/compiler_source: compiler_source_file
	../stage_03_parse/compiler_parsed_ast:
		ParsedDecl(
			BuiltinTypeParsedDecl,
			ForeignBlockParsedDecl,
			FunctionParsedDecl,
			ImplParsedDecl,
			ImportBlockParsedDecl,
			ParsedErrorDecl,
			PrivateParsedDecl,
			RecordParsedDecl,
			TraitParsedDecl,
			TypeAliasParsedDecl,
			UnionParsedDecl,
			VarParsedDecl,
		),
		ParsedProgram,
	../stage_03_parse/compiler_parser: parse_compiler_source


private pure func parsed_count_summary(
	kind: String,
	name: String,
	count: Int,
	item_name: String,
) -> String:
	"${kind} ${name} with ${count.to_string()} ${item_name}"


private pure func parsed_decl_summary(decl: ParsedDecl) -> List[String]:
	match decl:
		FunctionParsedDecl(function_decl):
			["Func ${function_decl.name.text}"]
		VarParsedDecl(var_decl):
			if var_decl.is_mutable:
				["var ${var_decl.name.text}"]
			else:
				[var_decl.name.text]
		ImportBlockParsedDecl(imports, _):
			imports.map(func(import_decl): "Import ${import_decl.module_path}")
		ForeignBlockParsedDecl(_, functions, _):
			functions.map(func(function_decl): "Func ${function_decl.name.text}")
		RecordParsedDecl(record_decl):
			if record_decl.is_struct:
				[
					parsed_count_summary(
						"Struct",
						record_decl.name.text,
						record_decl.fields.length(),
						"fields",
					),
				]
			else:
				[
					parsed_count_summary(
						"Record",
						record_decl.name.text,
						record_decl.fields.length(),
						"fields",
					),
				]
		UnionParsedDecl(union_decl):
			[
				parsed_count_summary(
					"Union",
					union_decl.name.text,
					union_decl.variants.length(),
					"variants",
				),
			]
		BuiltinTypeParsedDecl(type_decl):
			["BuiltinType ${type_decl.name.text}"]
		TypeAliasParsedDecl(alias_decl):
			["TypeAlias ${alias_decl.name.text}"]
		TraitParsedDecl(trait_decl):
			["Trait ${trait_decl.name.text}"]
		ImplParsedDecl(impl_decl):
			["Impl ${impl_decl.trait_name.text}"]
		PrivateParsedDecl(_, _):
			["Private"]
		ParsedErrorDecl(_):
			["<parse error>"]


pure func parsed_program_summary(program: ParsedProgram) -> String:
	program.decls
		.flat_map(parsed_decl_summary)
		.join("\n")


pure func parsed_source_summary(
	path: String,
	module_name: String,
	source_text: String,
) -> String:
	parse_compiler_source(
		compiler_source_file(path, module_name, source_text),
	).parsed_program_summary()
