-- Shared human-readable frontend output for source-oriented CLI commands.
--
-- Parse-only output intentionally starts from source text. It must not enter
-- typechecking or Core lowering because `compile --ast` is a parser command
-- even when the program contains type errors.
import:
	../stage_01_file_io/compiler_source: compiler_source_file
	../stage_03_parse/compiler_parsed_ast:
		ParsedDecl(
			BuiltinTypeParsedDecl,
			ForeignBlockParsedDecl,
			FunctionParsedDecl,
			ImplParsedDecl,
			ImportBlockParsedDecl,
			ParsedErrorDecl,
			PrivateParsedDecl,
			RecordParsedDecl,
			TraitParsedDecl,
			TypeAliasParsedDecl,
			UnionParsedDecl,
			VarParsedDecl,
		),
		ParsedProgram,
	../stage_03_parse/compiler_parser: parse_compiler_source
	../stage_05_types/compiler_type: CompilerType(CompilerFunctionType), compiler_type_to_string
	../stage_06_typecheck/compiler_typecheck_decl:
		CompilerTypedDecl(
			CompilerTypedForeignFunctionDecl,
			CompilerTypedFunctionDecl,
			CompilerTypedGlobalVarDecl,
			CompilerTypedImplDecl,
			CompilerTypedParsedDecl,
			CompilerTypedPrivateDecl,
			CompilerTypedRecordDecl,
			CompilerTypedTraitDecl,
			CompilerTypedTypeAliasDecl,
			CompilerTypedUnionDecl,
		),
		CompilerTypedProgram,


private pure func parsed_count_summary(
	kind: String,
	name: String,
	count: Int,
	item_name: String,
) -> String:
	"${kind} ${name} with ${count.to_string()} ${item_name}"


private pure func parsed_decl_summary(decl: ParsedDecl) -> List[String]:
	match decl:
		FunctionParsedDecl(function_decl):
			["Func ${function_decl.name.text}"]
		VarParsedDecl(var_decl):
			if var_decl.is_mutable:
				["var ${var_decl.name.text}"]
			else:
				[var_decl.name.text]
		ImportBlockParsedDecl(imports, _):
			imports.map(func(import_decl): "Import ${import_decl.module_path}")
		ForeignBlockParsedDecl(_, functions, _):
			functions.map(func(function_decl): "Func ${function_decl.name.text}")
		RecordParsedDecl(record_decl):
			if record_decl.is_struct:
				[
					parsed_count_summary(
						"Struct",
						record_decl.name.text,
						record_decl.fields.length(),
						"fields",
					),
				]
			else:
				[
					parsed_count_summary(
						"Record",
						record_decl.name.text,
						record_decl.fields.length(),
						"fields",
					),
				]
		UnionParsedDecl(union_decl):
			[
				parsed_count_summary(
					"Union",
					union_decl.name.text,
					union_decl.variants.length(),
					"variants",
				),
			]
		BuiltinTypeParsedDecl(type_decl):
			["BuiltinType ${type_decl.name.text}"]
		TypeAliasParsedDecl(alias_decl):
			["TypeAlias ${alias_decl.name.text}"]
		TraitParsedDecl(trait_decl):
			["Trait ${trait_decl.name.text}"]
		ImplParsedDecl(impl_decl):
			["Impl ${impl_decl.trait_name.text}"]
		PrivateParsedDecl(_, _):
			["Private"]
		ParsedErrorDecl(_):
			["<parse error>"]


pure func parsed_program_summary(program: ParsedProgram) -> String:
	program.decls
		.flat_map(parsed_decl_summary)
		.join("\n")


private pure func typed_callable_summary(
	kind: String,
	name: String,
	is_pure: Bool,
	param_types: List[CompilerType],
	return_type: CompilerType,
) -> String:
	callable_type: CompilerType = CompilerFunctionType(is_pure, param_types, return_type)
	"${kind} ${name}: ${compiler_type_to_string(callable_type)}"


private pure func typed_decl_summary(decl: CompilerTypedDecl) -> List[String]:
	match decl:
		CompilerTypedFunctionDecl(info):
			[
				typed_callable_summary(
					"Func",
					info.decl.name.text,
					info.decl.is_pure,
					info.param_types,
					info.semantic_return_type,
				),
			]
		CompilerTypedForeignFunctionDecl(info):
			[
				typed_callable_summary(
					"Foreign func",
					info.decl.name.text,
					info.decl.is_pure,
					info.param_types,
					info.semantic_return_type,
				),
			]
		CompilerTypedGlobalVarDecl(info):
			prefix: String = if info.decl.is_mutable:
				"var "
			else:
				""

			["${prefix}${info.decl.name.text}: ${compiler_type_to_string(info.binding_type)}"]
		CompilerTypedRecordDecl(info):
			kind: String = if info.decl.is_struct:
				"Struct"
			else:
				"Record"

			[parsed_count_summary(kind, info.decl.name.text, info.fields.length(), "fields")]
		CompilerTypedTypeAliasDecl(info):
			target_type: String = compiler_type_to_string(info.semantic_target_type)
			["TypeAlias ${info.decl.name.text}: ${target_type}"]
		CompilerTypedTraitDecl(info):
			[parsed_count_summary("Trait", info.decl.name.text, info.methods.length(), "methods")]
		CompilerTypedUnionDecl(info):
			[parsed_count_summary("Union", info.decl.name.text, info.variants.length(), "variants")]
		CompilerTypedImplDecl(info):
			["Impl ${info.decl.trait_name.text} for ${compiler_type_to_string(info.for_type)}"]
		CompilerTypedPrivateDecl(inner):
			typed_decl_summary(inner).map(func(line): "Private ${line}")
		CompilerTypedParsedDecl(parsed):
			parsed_decl_summary(parsed)


pure func typed_program_summary(program: CompilerTypedProgram) -> String:
	program.decls
		.flat_map(typed_decl_summary)
		.join("\n")


pure func parsed_source_summary(path: String, module_name: String, source_text: String) -> String:
	parse_compiler_source(
		compiler_source_file(
			path,
			module_name,
			source_text,
		),
	).parsed_program_summary()
