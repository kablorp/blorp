-- Stable public data model for source lint findings.
--
-- Findings intentionally contain no edit or remediation payload. Automated
-- remediation is a separate concern that can consume this stable surface.
import:
	../stage_01_file_io/source: CompilerSourceSpan


enum LintRuleId:
	LintSingleFieldRecord
	LintSingleFieldStruct
	LintSingleVariantUnion
	LintPureNoParameters
	LintImmediateOptionMatch
	LintLoopListLookup
	LintManualListIndexLoop
	LintRepeatedListLookup
	LintListAppendAccumulator
	LintConstantParameter


enum LintSeverity:
	LintAdvice
	LintWarning


record LintFinding {
	rule_id: LintRuleId,
	severity: LintSeverity,
	span: CompilerSourceSpan,
	message: String
}


pure func lint_rule_id_name(rule_id: LintRuleId) -> String:
	match rule_id:
		LintSingleFieldRecord:
			"structure.single-field-record"
		LintSingleFieldStruct:
			"structure.single-field-struct"
		LintSingleVariantUnion:
			"structure.single-variant-union"
		LintPureNoParameters:
			"function.pure-no-parameters"
		LintImmediateOptionMatch:
			"option.immediate-parameter-match"
		LintLoopListLookup:
			"loop.list-lookup"
		LintManualListIndexLoop:
			"loop.manual-list-index"
		LintRepeatedListLookup:
			"loop.repeated-list-lookup"
		LintListAppendAccumulator:
			"collection.list-append-accumulator"
		LintConstantParameter:
			"function.constant-parameter"


pure func lint_rule_id_from_name(name: String) -> Option[LintRuleId]:
	match name:
		"structure.single-field-record":
			Some(LintSingleFieldRecord)
		"structure.single-field-struct":
			Some(LintSingleFieldStruct)
		"structure.single-variant-union":
			Some(LintSingleVariantUnion)
		"function.pure-no-parameters":
			Some(LintPureNoParameters)
		"option.immediate-parameter-match":
			Some(LintImmediateOptionMatch)
		"loop.list-lookup":
			Some(LintLoopListLookup)
		"loop.manual-list-index":
			Some(LintManualListIndexLoop)
		"loop.repeated-list-lookup":
			Some(LintRepeatedListLookup)
		"collection.list-append-accumulator":
			Some(LintListAppendAccumulator)
		"function.constant-parameter":
			Some(LintConstantParameter)
		_:
			None


pure func lint_severity_name(severity: LintSeverity) -> String:
	match severity:
		LintAdvice:
			"advice"
		LintWarning:
			"warning"


private pure func finding_before(left: LintFinding, right: LintFinding) -> Bool:
	if left.span.path != right.span.path:
		left.span.path < right.span.path
	else if left.span.start_offset != right.span.start_offset:
		left.span.start_offset < right.span.start_offset
	else if lint_rule_id_name(left.rule_id) != lint_rule_id_name(right.rule_id):
		lint_rule_id_name(left.rule_id) < lint_rule_id_name(right.rule_id)
	else if left.span.end_offset != right.span.end_offset:
		left.span.end_offset < right.span.end_offset
	else:
		left.message < right.message


private pure func insert_finding(
	finding: LintFinding,
	ordered: List[LintFinding],
) -> List[LintFinding]:
	match ordered:
		[]:
			[finding]
		[head, ...tail]:
			if finding_before(finding, head):
				[finding] + ordered
			else:
				[head] + insert_finding(finding, tail)


pure func lint_findings_sorted(findings: List[LintFinding]) -> List[LintFinding]:
	var ordered: List[LintFinding] = []

	for finding in findings:
		ordered = insert_finding(finding, ordered)

	ordered
