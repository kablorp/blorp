-- Partition test sources only where module identity requires separate graphs.
import:
	cli_test_discovery: CliTestSourcePath


enum CliTestPartitionPolicy:
	MaximalCompatibleTestPartition
	BoundedSanitizedTestPartition


-- Sanitizer artifacts retain substantially more host state. Keep their
-- measured memory boundary independent from the normal compile-once route.
private SANITIZED_TEST_SOURCE_LIMIT: Int = 8

private SANITIZED_TEST_SOURCE_BYTE_LIMIT: Int = 512 * 1024


private pure func source_bytes(candidate: CliTestSourcePath) -> Int:
	if candidate.source_bytes > 0:
		candidate.source_bytes
	else:
		0


private pure func sanitized_partition_exceeded(
	policy: CliTestPartitionPolicy,
	batch: List[CliTestSourcePath],
	batch_bytes: Int,
	candidate_bytes: Int,
) -> Bool:
	match policy:
		MaximalCompatibleTestPartition:
			False
		BoundedSanitizedTestPartition:
			(
				batch.length() >= SANITIZED_TEST_SOURCE_LIMIT
				or batch_bytes > SANITIZED_TEST_SOURCE_BYTE_LIMIT
				or candidate_bytes > SANITIZED_TEST_SOURCE_BYTE_LIMIT - batch_bytes
			)


-- Generated imports are keyed by module identity as well as source path. Start
-- a new graph before a repeated root module name so same-named suites in
-- different directories remain independently addressable.
pure func batch_test_source_candidates(
	candidates: List[CliTestSourcePath],
	policy: CliTestPartitionPolicy,
) -> List[List[CliTestSourcePath]]:
	var batches: List[List[CliTestSourcePath]] = []
	var batch: List[CliTestSourcePath] = []
	var module_names: List[String] = []
	var batch_bytes: Int = 0

	for candidate in candidates:
		candidate_bytes: Int = source_bytes(candidate)

		if (
			batch.length() > 0
			and ((
				module_names.contains(candidate.module_name)
				or sanitized_partition_exceeded(policy, batch, batch_bytes, candidate_bytes)
			))
		):
			batches = batches.append(batch)
			batch = []
			module_names = []
			batch_bytes = 0

		batch = batch.append(candidate)
		module_names = module_names.append(candidate.module_name)
		batch_bytes += candidate_bytes

	if batch.length() > 0:
		batches = batches.append(batch)

	batches
