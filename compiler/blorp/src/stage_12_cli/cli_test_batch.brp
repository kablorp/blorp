-- Source-budgeted grouping for combined Blorp test artifacts.
import:
	cli_test_discovery: CliTestSourcePath


-- Combined compiler-owned TestSuite graphs grow superlinearly during
-- specialization. An eight-source CLI-heavy batch measured 2.30 GiB peak RSS;
-- the former monolithic CLI suite reached 4.62 GiB by itself, so grouping up
-- to sixteen sources left too little memory headroom on Linux CI.
private TEST_SOURCE_LIMIT: Int = 8

-- Use root source size as an early partition signal in addition to file count;
-- this does not claim to measure the later transitive module graph. One compiler
-- Core-emitter suite is larger than the budget and is intentionally accepted as
-- a singleton; combining it with seven ordinary suites exceeded the Ubuntu CI
-- lane budget.
private TEST_SOURCE_BYTE_LIMIT: Int = 512 * 1024


private pure func source_bytes(candidate: CliTestSourcePath) -> Int:
	if candidate.source_bytes > 0:
		candidate.source_bytes
	else:
		0


private pure func adding_source_exceeds_byte_limit(batch_bytes: Int, candidate_bytes: Int) -> Bool:
	batch_bytes > TEST_SOURCE_BYTE_LIMIT or candidate_bytes > TEST_SOURCE_BYTE_LIMIT - batch_bytes


-- Generated imports are keyed by module identity as well as source path. Start
-- a new graph before a repeated root module name so same-named suites in
-- different directories remain independently addressable.
pure func batch_test_source_candidates(
	candidates: List[CliTestSourcePath],
) -> List[List[CliTestSourcePath]]:
	var batches: List[List[CliTestSourcePath]] = []
	var batch: List[CliTestSourcePath] = []
	var module_names: List[String] = []
	var batch_bytes: Int = 0

	for candidate in candidates:
		candidate_bytes: Int = source_bytes(candidate)

		if (
			batch.length() > 0
			and ((
				batch.length() >= TEST_SOURCE_LIMIT
				or module_names.contains(candidate.module_name)
				or adding_source_exceeds_byte_limit(batch_bytes, candidate_bytes)
			))
		):
			batches = batches.append(batch)
			batch = []
			module_names = []
			batch_bytes = 0

		batch = batch.append(candidate)
		module_names = module_names.append(candidate.module_name)
		batch_bytes += candidate_bytes

	if batch.length() > 0:
		batches = batches.append(batch)

	batches
