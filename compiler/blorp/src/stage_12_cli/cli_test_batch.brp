-- Source-budgeted grouping for combined Blorp test artifacts.
--
-- Doctest graphs retain generated expressions and need the lower measured
-- limit. TestSuite-only graphs are shallower, so they can amortize frontend
-- and native compilation over a larger group without crossing that boundary.
import:
	cli_args: CliTestMode(CliTestAll, CliTestDocOnly, CliTestSuiteOnly)
	cli_test_discovery: CliTestSourcePath


private DOCTEST_CAPABLE_SOURCE_LIMIT: Int = 16

-- A cold 33-file compiler-suite sample completed in 597 seconds at 32 sources
-- versus 712 seconds at 16, while its generated executable stayed within the
-- production timeout. Keep this separate from the doctest safety boundary.
private TEST_SUITE_SOURCE_LIMIT: Int = 32


private pure func source_limit(mode: CliTestMode) -> Int:
	match mode:
		CliTestSuiteOnly:
			TEST_SUITE_SOURCE_LIMIT
		CliTestAll:
			DOCTEST_CAPABLE_SOURCE_LIMIT
		CliTestDocOnly:
			DOCTEST_CAPABLE_SOURCE_LIMIT


-- Generated imports are keyed by module identity as well as source path. Start
-- a new graph before a repeated root module name so same-named suites in
-- different directories remain independently addressable.
pure func batch_test_source_candidates(
	candidates: List[CliTestSourcePath],
	mode: CliTestMode,
) -> List[List[CliTestSourcePath]]:
	limit: Int = source_limit(mode)
	var batches: List[List[CliTestSourcePath]] = []
	var batch: List[CliTestSourcePath] = []
	var module_names: List[String] = []

	for candidate in candidates:
		if batch.length() >= limit or module_names.contains(candidate.module_name):
			batches = batches.append(batch)
			batch = []
			module_names = []

		batch = batch.append(candidate)
		module_names = module_names.append(candidate.module_name)

	if batch.length() > 0:
		batches = batches.append(batch)

	batches
