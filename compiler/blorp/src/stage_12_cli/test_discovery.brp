-- Structural test-source facts used by Blorp-owned test discovery.
--
-- Classification consumes the parsed program instead of guessing from source
-- substrings. Filesystem traversal and execution policy are separate concerns.
-- A `tests` binding is only a candidate here; resolved TestSuite identity must
-- be checked after module loading and type resolution.
import:
	../stage_01_file_io/path_identity: existing_path_identity
	../stage_01_file_io/source: source_file
	../stage_03_parse/language_parser: parse_compiler_source
	../stage_03_parse/parsed_ast:
		ParsedDecl(
			BuiltinTypeParsedDecl,
			FunctionParsedDecl,
			ImplParsedDecl,
			PrivateParsedDecl,
			RecordParsedDecl,
			TraitParsedDecl,
			TypeAliasParsedDecl,
			UnionParsedDecl,
			VarParsedDecl,
		),
		ParsedProgram,
		parsed_program_has_errors,
	fs:
		DirectoryEntryKind(EntryDirectory, EntryFile, EntryOther, EntrySymlink, EntryUnknown),
		IOError(NotFound, Other),
		open_read,
		read_directory,
		read_text,
	path: basename, join, normalize, stem
	system: file_exists, file_size, is_directory
	test_leak_baseline: test_is_leak_baseline_program


private SKIP_DIRECTORIES: List[String] = ["test_compiler", "should_fail", "should_pass"]


record CliTestSourceFeatures {
	has_main: Bool,
	has_tests_binding: Bool,
	has_doctests: Bool
}


record CliDiscoveredTestSource {
	program: ParsedProgram,
	canonical_path: String,
	features: CliTestSourceFeatures,
	is_leak_baseline_program: Bool
}


-- Compact invocation-owned input. Parsed programs are batch-owned so a large
-- directory invocation does not retain every frontend tree at once.
record CliTestSourcePath {
	source_path: String,
	io_path: String,
	canonical_path: String,
	module_name: String,
	source_bytes: Int,
	is_leak_baseline_program: Bool
}


private pure func decl_has_main(decl: ParsedDecl) -> Bool:
	match decl:
		FunctionParsedDecl(function_decl):
			function_decl.name.text == "main"
		PrivateParsedDecl(inner, _):
			decl_has_main(inner)
		_:
			False


private pure func decl_has_tests_binding(decl: ParsedDecl) -> Bool:
	match decl:
		VarParsedDecl(var_decl):
			var_decl.name.text == "tests"
		_:
			False


private pure func decl_doc(decl: ParsedDecl) -> Option[String]:
	match decl:
		FunctionParsedDecl(function_decl):
			function_decl.doc
		RecordParsedDecl(record_decl):
			record_decl.doc
		UnionParsedDecl(union_decl):
			union_decl.doc
		BuiltinTypeParsedDecl(type_decl):
			type_decl.doc
		TypeAliasParsedDecl(type_alias):
			type_alias.doc
		TraitParsedDecl(trait_decl):
			trait_decl.doc
		ImplParsedDecl(impl_decl):
			impl_decl.doc
		PrivateParsedDecl(inner, _):
			decl_doc(inner)
		_:
			None


private pure func decl_has_doctests(decl: ParsedDecl) -> Bool:
	decl_doc(decl)
		.map(func(doc):
			doc
				.lines()
				.any(func(line): line.trim() == "doctests:")
		)
		.get_or(False)


pure func classify_test_source(program: ParsedProgram) -> CliTestSourceFeatures:
	{
		has_main = program.decls.any(decl_has_main),
		has_tests_binding = program.decls.any(decl_has_tests_binding),
		has_doctests = program.decls.any(decl_has_doctests)
	}


private func collect_directory_test_paths(path_value: String) -> Result[List[String], IOError]:
	if SKIP_DIRECTORIES.contains(basename(path_value)):
		Ok([])
	else:
		entries ?= read_directory(path_value)
		var paths: List[String] = []
		var collect_error: Option[IOError] = None

		for entry in entries:
			full_path: String = path_value.join(entry.name)

			match entry.kind:
				EntryDirectory:
					match collect_directory_test_paths(full_path):
						Ok(child_paths):
							paths = paths.concat(child_paths)
						Err(err):
							collect_error = Some(err)
							break
				EntryFile:
					if full_path.ends_with(".brp"):
						paths = paths.append(full_path)
				EntryUnknown:
					-- The runtime already attempts an lstat fallback. Avoid
					-- following a raced symlink or opening a special file.
					void
				EntrySymlink:
					void
				EntryOther:
					void

		match collect_error:
			Some(err):
				Err(err)
			None:
				Ok(paths)


private func collect_test_paths(path_value: String) -> Result[List[String], IOError]:
	if not file_exists(path_value):
		Err(NotFound(path_value))
	else if is_directory(path_value):
		collect_directory_test_paths(path_value)
	else if path_value.ends_with(".brp"):
		Ok([path_value])
	else:
		Ok([])


private func read_parsed_program(path: CliTestSourcePath) -> Result[ParsedProgram, IOError]:
	with reader ?= open_read(path.io_path):
		source_text ?= reader.read_text()
		Ok(
			parse_compiler_source(
				source_file(
					path.source_path,
					stem(path.source_path),
					source_text,
				),
			),
		)


private pure func should_discover_test_source(
	program: ParsedProgram,
	features: CliTestSourceFeatures,
	include_leak_baseline_programs: Bool,
	leak_baseline_program: Bool,
) -> Bool:
	(
		features.has_tests_binding
		or features.has_doctests
		or parsed_program_has_errors(program)
		or include_leak_baseline_programs and leak_baseline_program
	)


func discover_test_source_paths(
	paths: List[String],
	project_root: String,
) -> Result[List[CliTestSourcePath], IOError]:
	project_identity ?= existing_path_identity(project_root)
	canonical_project_root: String = project_identity.canonical_path
	var candidate_paths: List[String] = []
	var collect_error: Option[IOError] = None

	for path_value in paths:
		match collect_test_paths(path_value):
			Ok(collected):
				candidate_paths = candidate_paths.concat(collected)
			Err(err):
				collect_error = Some(err)
				break

	var canonical_candidate_paths: List[CliTestSourcePath] = []
	var identity_error: Option[IOError] = None
	var seen_canonical_paths: List[String] = []

	if collect_error.is_none():
		for path_value in candidate_paths:
			match existing_path_identity(path_value):
				Ok(identity):
					if not seen_canonical_paths.contains(identity.canonical_path):
						match file_size(identity.io_path):
							Ok(source_bytes):
								seen_canonical_paths = seen_canonical_paths.append(
									identity.canonical_path,
								)
								canonical_candidate_paths = canonical_candidate_paths.append({
									source_path = normalize(path_value),
									io_path = identity.io_path,
									canonical_path = identity.canonical_path,
									module_name = stem(path_value),
									source_bytes = source_bytes,
									is_leak_baseline_program = test_is_leak_baseline_program(
										identity.canonical_path,
										canonical_project_root,
									),
								})
							Err(message):
								identity_error = Some(
									Other(
										"failed to read test source size for " + path_value + ": " + message,
									),
								)
								break
				Err(err):
					identity_error = Some(err)
					break

	match collect_error:
		Some(err):
			Err(err)
		None:
			match identity_error:
				Some(err):
					Err(err)
				None:
					Ok(canonical_candidate_paths)


func discover_test_sources_from_paths(
	paths: List[CliTestSourcePath],
	include_leak_baseline_programs: Bool,
) -> Result[List[CliDiscoveredTestSource], IOError]:
	var sources: List[CliDiscoveredTestSource] = []
	var read_error: Option[IOError] = None

	-- Path discovery is already sorted and canonical-path deduplicated. The
	-- caller controls batch size without changing execution order.
	for candidate in paths:
		match read_parsed_program(candidate):
			Ok(program):
				features: CliTestSourceFeatures = classify_test_source(program)

				if should_discover_test_source(
					program,
					features,
					include_leak_baseline_programs,
					candidate.is_leak_baseline_program,
				):
					sources = sources.append({
						program = program,
						canonical_path = candidate.canonical_path,
						features = features,
						is_leak_baseline_program = candidate.is_leak_baseline_program,
					})
			Err(err):
				read_error = Some(err)
				break

	match read_error:
		Some(err):
			Err(err)
		None:
			Ok(sources)


func discover_test_sources(
	paths: List[String],
	project_root: String,
	include_leak_baseline_programs: Bool,
) -> Result[List[CliDiscoveredTestSource], IOError]:
	candidate_paths ?= discover_test_source_paths(paths, project_root)
	discover_test_sources_from_paths(candidate_paths, include_leak_baseline_programs)
