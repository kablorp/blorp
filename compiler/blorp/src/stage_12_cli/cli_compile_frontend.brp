-- Compile/run projection from a typed CLI source graph to contiguous Core.
-- Keeping this out of the check executor prevents backend-only Core types from
-- entering the production check program.
import:
	../stage_06_typecheck/typecheck_bridge:
		CompilerTypecheckedGraph,
		CompilerTypecheckedModule,
	../stage_06_typecheck/typecheck_decl:
		TypedDecl(TypedForeignFunctionDecl, TypedPrivateDecl),
	../stage_06_typecheck/typecheck_state: CompilerImportBinding
	../stage_08_core_lower/core_graph_prepare:
		CompilerCoreGraphUnit,
		compiler_core_graph_prepare_error_to_string,
		prepare_core_graph,
	../stage_09_core/core_early_pipeline:
		CoreEarlyPipelineConfiguration,
		CoreEarlyPipelineDiagnostic,
		CoreEarlyPipelineExecution(
			CoreEarlyPipelineCompleted,
			CoreEarlyPipelineFailed,
			CoreEarlyPipelineStopped,
		),
		CoreEarlyPipelineInput,
		CoreEarlyPipelineObservation,
		CoreEarlyPipelineStage,
		core_early_pipeline_diagnostic_hint,
		core_early_pipeline_diagnostic_message,
		core_early_pipeline_stage_name,
		finish_early_core_pipeline_after_projection,
		run_early_core_pipeline_to_runtime_projection,
	../stage_09_core/core_json: CoreDecl(FunctionDecl), CoreFunction, CoreProgram
	../stage_09_core/core_resolve: CoreResolveImportBinding, CoreResolveModuleImports
	../stage_09_core/core_runtime_projection:
		core_runtime_projection_error_message,
		project_runtime_program,
	cli_core_observation: CliCoreObservation
	cli_frontend_output: typed_program_summary
	cli_plan: CliFrontendModuleGraph
	cli_typecheck: typecheck_frontend_root, typechecked_graph_errors
	path: dirname


record CliCoreCompilation {
	target_path: String,
	target_module_name: String,
	program: CoreProgram,
	check_invariants: Bool
}


union CompiledFrontendGraph:
	CompiledFrontendReady(CliCoreCompilation, Option[String], List[String], List[CliCoreObservation])
	CompiledFrontendStopped(String, String, String, List[CliCoreObservation])


record CliFrontendCompilePolicy {
	allow_debug_only_calls: Bool,
	retain_debug_blocks: Bool,
	include_typed_summary: Bool
}


private pure func core_resolve_import_binding(
	binding: CompilerImportBinding,
) -> CoreResolveImportBinding:
	{
		local_name = binding.local_name,
		module_path = binding.module_path,
		original_name = binding.original_name
	}


private pure func core_graph_unit(module: CompilerTypecheckedModule) -> CompilerCoreGraphUnit:
	{
		module_name = module.module_name,
		typed_program = module.typed_program
	}


private pure func core_resolve_module_imports(
	module: CompilerTypecheckedModule,
) -> CoreResolveModuleImports:
	{
		module_name = module.module_name,
		import_bindings = module.import_bindings.map(core_resolve_import_binding)
	}


private pure func typed_decl_uses_source_include(decl: TypedDecl) -> Bool:
	match decl:
		TypedForeignFunctionDecl(info):
			not info.includes.is_empty()
		TypedPrivateDecl(inner):
			typed_decl_uses_source_include(inner)
		_:
			False


private pure func typechecked_module_source_include_dirs(
	module: CompilerTypecheckedModule,
) -> List[String]:
	if module.typed_program.decls.any(typed_decl_uses_source_include):
		[dirname(module.path)]
	else:
		[]


pure func typechecked_graph_source_include_dirs(graph: CompilerTypecheckedGraph) -> List[String]:
	[graph.target]
		.concat(graph.modules)
		.flat_map(typechecked_module_source_include_dirs)
		.unique()


private pure func early_observation(
	observation: CoreEarlyPipelineObservation,
) -> CliCoreObservation:
	{
		stage_name = core_early_pipeline_stage_name(observation.stage),
		rendered = observation.rendered
	}


private pure func early_pipeline_error(diagnostic: CoreEarlyPipelineDiagnostic) -> String:
	message: String = core_early_pipeline_diagnostic_message(diagnostic)

	match core_early_pipeline_diagnostic_hint(diagnostic):
		Some(hint):
			"${message}\nhelp: ${hint}"
		None:
			message


private pure func function_is_program_entrypoint(function_info: CoreFunction) -> Bool:
	function_info.name == "main" and function_info.source_module.is_none()


private pure func program_has_top_level_main(program: CoreProgram) -> Bool:
	program.decls.any(func(decl):
		match decl:
			FunctionDecl(function_info):
				function_is_program_entrypoint(function_info)
			_:
				False
	)


private pure func missing_main_error(path: String) -> String:
	"${path}:1:1: error[missing_main]: cannot compile runnable source without a main function\nhelp: Add a top-level `main` function, or use a check-only command for library source."


pure func compile_frontend_graph(
	graph: CliFrontendModuleGraph,
	policy: CliFrontendCompilePolicy,
	require_main: Bool,
	check_invariants: Bool,
	early_observations: List[CoreEarlyPipelineStage],
	early_stop: Option[CoreEarlyPipelineStage],
) -> Result[CompiledFrontendGraph, List[String]]:
	compile_frontend_graph_with_typed_validation(
		graph,
		policy,
		pure func(_): [],
		require_main,
		check_invariants,
		early_observations,
		early_stop,
	)


pure func compile_frontend_graph_with_typed_validation(
	graph: CliFrontendModuleGraph,
	policy: CliFrontendCompilePolicy,
	validate: pure (CompilerTypecheckedGraph) -> List[String],
	require_main: Bool,
	check_invariants: Bool,
	early_observations: List[CoreEarlyPipelineStage],
	early_stop: Option[CoreEarlyPipelineStage],
) -> Result[CompiledFrontendGraph, List[String]]:
	match graph.roots:
		[root]:
			typechecked = typecheck_frontend_root(graph, root, policy.allow_debug_only_calls)
			errors = graph.diagnostics.concat(typechecked_graph_errors(typechecked))

			if errors.length() != 0:
				Err(errors)
			else:
				validation_errors: List[String] = validate(typechecked)

				if validation_errors.length() != 0:
					Err(validation_errors)
				else:
					compile_validated_typechecked_frontend_graph(
						typechecked,
						policy.retain_debug_blocks,
						policy.include_typed_summary,
						require_main,
						check_invariants,
						early_observations,
						early_stop,
					)
		_:
			Err(["source compilation requires exactly one root module"])


private pure func compile_validated_typechecked_frontend_graph(
	typechecked: CompilerTypecheckedGraph,
	retain_debug_blocks: Bool,
	include_typed_summary: Bool,
	require_main: Bool,
	check_invariants: Bool,
	early_observations: List[CoreEarlyPipelineStage],
	early_stop: Option[CoreEarlyPipelineStage],
) -> Result[CompiledFrontendGraph, List[String]]:
	prepared = prepare_core_graph(
		typechecked.target.typed_program,
		typechecked.modules.map(core_graph_unit),
		typechecked.next_def_id,
	)

	prepared_graph ?= match prepared:
		Ok(graph):
			Ok(graph)
		Err(error):
			Err([compiler_core_graph_prepare_error_to_string(error)])

	early_configuration: CoreEarlyPipelineConfiguration = {
		debug = retain_debug_blocks,
		check_invariants = check_invariants,
		observations = early_observations,
		stop_after = early_stop
	}
	early_input: CoreEarlyPipelineInput = {
		program = prepared_graph.program,
		next_def_id = prepared_graph.next_def_id
	}

	match run_early_core_pipeline_to_runtime_projection(
		early_input,
		early_configuration,
		typechecked.target.import_bindings.map(core_resolve_import_binding),
		typechecked.modules.map(core_resolve_module_imports),
	):
		CoreEarlyPipelineFailed(diagnostic):
			Err([early_pipeline_error(diagnostic)])
		CoreEarlyPipelineStopped(stage, rendered, completed_observations):
			Ok(
				CompiledFrontendStopped(
					typechecked.target.path,
					core_early_pipeline_stage_name(stage),
					rendered,
					completed_observations.map(early_observation),
				),
			)
		CoreEarlyPipelineCompleted(output):
			projected_program ?= match project_runtime_program(output.program):
				Ok(program):
					Ok(program)
				Err(error):
					Err([core_runtime_projection_error_message(error)])

			match finish_early_core_pipeline_after_projection(
				{ output | program = projected_program },
				early_configuration,
			):
				CoreEarlyPipelineFailed(diagnostic):
					Err([early_pipeline_error(diagnostic)])
				CoreEarlyPipelineStopped(stage, rendered, completed_observations):
					Ok(
						CompiledFrontendStopped(
							typechecked.target.path,
							core_early_pipeline_stage_name(stage),
							rendered,
							completed_observations.map(early_observation),
						),
					)
				CoreEarlyPipelineCompleted(completed):
					if require_main and not program_has_top_level_main(completed.program):
						Err([missing_main_error(typechecked.target.path)])
					else:
						compilation: CliCoreCompilation = {
							target_path = typechecked.target.path,
							target_module_name = typechecked.target.module_name,
							program = completed.program,
							check_invariants = check_invariants
						}

						typed_summary: Option[String] = if include_typed_summary:
							Some(typed_program_summary(typechecked.target.typed_program))
						else:
							None

						Ok(
							CompiledFrontendReady(
								compilation,
								typed_summary,
								typechecked_graph_source_include_dirs(typechecked),
								completed.observations.map(early_observation),
							),
						)
