-- Shared failure rendering for compile/run after frontend preparation.
import:
	compiler_cli_compile_execute:
		CliCompileExecution(
			CliCompileArtifact,
			CliCompileBuildArtifactFailed,
			CliCompileEmitFailed,
			CliCompileFrontendFailed,
			CliCompileProtocolFailed,
			CliCompileSemanticFailed,
			CliCompileStopped,
			CliCompileWorkerFailed,
		),
	compiler_cli_effect_output: render_semantic_diagnostics


pure func compile_execution_failure_message(
	execution: CliCompileExecution,
) -> Option[String]:
	match execution:
		CliCompileFrontendFailed(errors):
			Some(errors.join("\n"))
		CliCompileSemanticFailed(_, diagnostics):
			Some(render_semantic_diagnostics(diagnostics))
		CliCompileProtocolFailed(_, detail):
			Some("semantic worker protocol failure: ${detail}")
		CliCompileWorkerFailed(_, detail):
			Some("semantic worker failure: ${detail}")
		CliCompileEmitFailed(_, detail):
			Some("internal C emission failure: ${detail}")
		CliCompileBuildArtifactFailed(_, detail):
			Some("build artifact failure: ${detail}")
		CliCompileStopped(_, _, _, _):
			None
		CliCompileArtifact(_, _, _):
			None
