-- Typed in-process execution for source-oriented CLI plans.
--
-- Check ends at the Blorp-owned typed frontend and does not import semantic
-- protocol or backend types.
import:
	../stage_06_typecheck/compiler_typed_ast_json: compiler_typed_program_to_json
	compiler_cli_diagnostic: cli_error_message
	compiler_cli_frontend_output: parsed_program_summary
	compiler_cli_plan: CliCheckPlan, CliHandledResult
	compiler_cli_typecheck:
		typecheck_frontend_root,
		typecheck_frontend_root_only,
		typechecked_graph_errors,


private pure func append_output(output: String, text: String) -> String:
	if text.length() == 0:
		output
	else if output.length() == 0:
		text
	else:
		output + "\n" + text


private pure func append_messages(output: String, messages: List[String]) -> String:
	var result = output

	for message in messages:
		result = append_output(result, message)

	result


pure func execute_check_plan(plan: CliCheckPlan) -> CliHandledResult:
	var stdout: String = ""
	var stderr: String = append_messages(
		"",
		plan.graph.diagnostics.map(cli_error_message),
	)
	var failed: Bool = plan.graph.diagnostics.length() != 0
	multiple_roots: Bool = plan.graph.roots.length() > 1
	var dependencies_checked: Bool = False

	if plan.graph.diagnostics.length() == 0:
		for root in plan.graph.roots:
			if multiple_roots:
				stdout = append_output(stdout, "Checking ${root.path}")

			typechecked = if dependencies_checked:
				typecheck_frontend_root_only(plan.graph, root, plan.options.debug)
			else:
				typecheck_frontend_root(plan.graph, root, plan.options.debug)
			dependencies_checked = True
			errors = typechecked_graph_errors(typechecked)

			if plan.options.dump_ast:
				stdout = append_output(
					stdout,
					parsed_program_summary(typechecked.target.parsed_program),
				)

			if errors.length() == 0:
				if plan.options.dump_typed_ast:
					stdout = append_output(
						stdout,
						compiler_typed_program_to_json(
							typechecked.target.typed_program,
						).to_string(),
					)

				stdout = append_output(stdout, "Type checking succeeded.")
			else:
				failed = True
				stderr = append_messages(stderr, errors)

	status: Int = if failed:
		1
	else:
		0

	{
		status = status,
		stdout = stdout,
		stderr = stderr
	}
