-- Narrow discovery policy for standalone leak-baseline programs. Ordinary
-- TestSuite execution rejects these `main` programs before graph construction.
import:
	path: is_absolute, join, normalize


private LEAK_BASELINE_ROOT: String = "tests/test_blorp/memory/leak_check_baselines"


private pure func host_path_is_absolute(path_value: String) -> Bool:
	(
		is_absolute(path_value)
		or (
			path_value.length() >= 3
			and path_value.get(1) == Some(':')
			and path_value.get(2) == Some('/')
		)
	)


private pure func project_relative_path(path_value: String, project_root: String) -> String:
	root: String = normalize(project_root)

	path: String = if host_path_is_absolute(path_value):
		normalize(path_value)
	else:
		normalize(join(root, path_value))

	root_prefix: String = if root == "/":
		root
	else:
		root + "/"

	if path.starts_with(root_prefix):
		path.drop_left(root_prefix.length())
	else:
		path


private pure func path_under(root: String, path: String) -> Bool:
	path == root or path.starts_with(root + "/")


pure func test_is_leak_baseline_program(path: String, project_root: String) -> Bool:
	relative_path: String = project_relative_path(path, project_root)
	relative_path.ends_with(".brp") and path_under(LEAK_BASELINE_ROOT, relative_path)
