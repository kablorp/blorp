private pure func compiler_typed_select_arms_debug_block_impure_call_names(
	arms: List[CompilerTypedSelectArm],
) -> List[String]:
	var result: List[String] = []

	for arm in arms:
		match arm.kind:
			CompilerTypedSelectReceiveArm(_, _, channel):
				result = compiler_append_impure_call_names(
					result,
					compiler_typed_expr_debug_block_impure_call_names(channel),
				)
			CompilerTypedSelectSealedArm(_, channel):
				result = compiler_append_impure_call_names(
					result,
					compiler_typed_expr_debug_block_impure_call_names(channel),
				)
			CompilerTypedSelectAfterArm(timeout):
				result = compiler_append_impure_call_names(
					result,
					compiler_typed_expr_debug_block_impure_call_names(timeout),
				)

		result = compiler_append_impure_call_names(
			result,
			compiler_typed_expr_debug_block_impure_call_names(arm.body),
		)

	result


pure func compiler_typed_expr_debug_block_impure_call_names(
	expr: CompilerTypedExpr,
) -> List[String]:
	match expr:
		CompilerTypedUnaryExpr(_, inner, _, _):
			compiler_typed_expr_debug_block_impure_call_names(inner)
		CompilerTypedBinaryExpr(_, left, right, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_debug_block_impure_call_names(left),
				compiler_typed_expr_debug_block_impure_call_names(right),
			)
		CompilerTypedLogicalExpr(_, left, right, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_debug_block_impure_call_names(left),
				compiler_typed_expr_debug_block_impure_call_names(right),
			)
		CompilerTypedCallExpr(callee, args, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_debug_block_impure_call_names(callee),
				compiler_typed_expr_list_debug_block_impure_call_names(args),
			)
		CompilerTypedTupleExpr(items, _, _):
			compiler_typed_expr_list_debug_block_impure_call_names(items)
		CompilerTypedTupleDestructExpr(_, value, _, _):
			compiler_typed_expr_debug_block_impure_call_names(value)
		CompilerTypedAssignExpr(_, _, value, _, _):
			compiler_typed_expr_debug_block_impure_call_names(value)
		CompilerTypedSubscriptExpr(receiver, indices, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_debug_block_impure_call_names(receiver),
				compiler_typed_expr_list_debug_block_impure_call_names(indices),
			)
		CompilerTypedSubscriptAssignExpr(_, receiver, indices, value, _, _):
			with_indices = compiler_append_impure_call_names(
				compiler_typed_expr_debug_block_impure_call_names(receiver),
				compiler_typed_expr_list_debug_block_impure_call_names(indices),
			)
			compiler_append_impure_call_names(
				with_indices,
				compiler_typed_expr_debug_block_impure_call_names(value),
			)
		CompilerTypedListExpr(items, _, _):
			compiler_typed_expr_list_debug_block_impure_call_names(items)
		CompilerTypedVectorExpr(items, _, _):
			compiler_typed_expr_list_debug_block_impure_call_names(items)
		CompilerTypedDictExpr(entries, _, _):
			compiler_typed_dict_entries_debug_block_impure_call_names(entries)
		CompilerTypedRecordExpr(fields, _, _):
			compiler_typed_record_fields_debug_block_impure_call_names(fields)
		CompilerTypedRecordUpdateExpr(base, fields, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_debug_block_impure_call_names(base),
				compiler_typed_record_fields_debug_block_impure_call_names(fields),
			)
		CompilerTypedFieldAccessExpr(receiver, _, _, _):
			compiler_typed_expr_debug_block_impure_call_names(receiver)
		CompilerTypedLambdaExpr(_, _, _, body, _, _):
			compiler_typed_expr_debug_block_impure_call_names(body)
		CompilerTypedRangeExpr(start_expr, end_expr, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_debug_block_impure_call_names(start_expr),
				compiler_typed_expr_debug_block_impure_call_names(end_expr),
			)
		CompilerTypedIfExpr(condition, then_branch, else_branch, _, _):
			with_then = compiler_append_impure_call_names(
				compiler_typed_expr_debug_block_impure_call_names(condition),
				compiler_typed_expr_debug_block_impure_call_names(then_branch),
			)

			match else_branch:
				Some(branch):
					compiler_append_impure_call_names(
						with_then,
						compiler_typed_expr_debug_block_impure_call_names(branch),
					)
				None:
					with_then
		CompilerTypedMatchExpr(scrutinee, cases, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_debug_block_impure_call_names(scrutinee),
				compiler_typed_match_cases_debug_block_impure_call_names(cases),
			)
		CompilerTypedSelectExpr(arms, _, _):
			compiler_typed_select_arms_debug_block_impure_call_names(arms)
		CompilerTypedWhileExpr(condition, body, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_debug_block_impure_call_names(condition),
				compiler_typed_expr_debug_block_impure_call_names(body),
			)
		CompilerTypedForExpr(_, iterable, _, body, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_debug_block_impure_call_names(iterable),
				compiler_typed_expr_debug_block_impure_call_names(body),
			)
		CompilerTypedConcurrentBlockExpr(params, bindings, _, _):
			compiler_append_impure_call_names(
				compiler_typed_concurrent_params_debug_block_impure_call_names(params),
				compiler_typed_concurrent_bindings_debug_block_impure_call_names(bindings),
			)
		CompilerTypedConcurrentForExpr(_, iterable, params, body, _, _):
			with_iterable = compiler_typed_expr_debug_block_impure_call_names(iterable)
			with_params = compiler_append_impure_call_names(
				with_iterable,
				compiler_typed_concurrent_params_debug_block_impure_call_names(params),
			)
			compiler_append_impure_call_names(
				with_params,
				compiler_typed_expr_debug_block_impure_call_names(body),
			)
		CompilerTypedDetachExpr(body, _, _):
			compiler_typed_expr_debug_block_impure_call_names(body)
		CompilerTypedAscriptionExpr(inner, _, _, _):
			compiler_typed_expr_debug_block_impure_call_names(inner)
		CompilerTypedOpaqueIntoExpr(_, inner, _, _):
			compiler_typed_expr_debug_block_impure_call_names(inner)
		CompilerTypedOpaqueFromExpr(_, inner, _, _):
			compiler_typed_expr_debug_block_impure_call_names(inner)
		CompilerTypedBlockExpr(items, _, _):
			compiler_typed_expr_list_debug_block_impure_call_names(items)
		CompilerTypedWithExpr(binding, body, _, _):
			compiler_append_impure_call_names(
				compiler_typed_with_binding_debug_block_impure_call_names(binding),
				compiler_typed_expr_debug_block_impure_call_names(body),
			)
		CompilerTypedDebugBlockExpr(body, _, _):
			compiler_typed_expr_impure_call_names(body)
		CompilerTypedVarDeclExpr(payload, _):
			compiler_typed_expr_debug_block_impure_call_names(payload.initializer)
		CompilerTypedQuestionBindExpr(_, _, value, _, _):
			compiler_typed_expr_debug_block_impure_call_names(value)
		_:
			[]


private pure func compiler_typed_expr_list_has_debug_block_assignment(
	exprs: List[CompilerTypedExpr],
) -> Bool:
	var found: Bool = False

	for expr in exprs:
		if compiler_typed_expr_has_debug_block_assignment(expr):
			found = True
			break

	found


private pure func compiler_typed_expr_has_assignment_inside_debug_block(
	expr: CompilerTypedExpr,
) -> Bool:
	match expr:
		CompilerTypedAssignExpr(_, _, _, _, _):
			True
		CompilerTypedSubscriptAssignExpr(_, _, _, _, _, _):
			True
		CompilerTypedTupleDestructExpr(_, _, _, _):
			True
		CompilerTypedVarDeclExpr(_, _):
			True
		CompilerTypedQuestionBindExpr(_, _, _, _, _):
			True
		CompilerTypedUnaryExpr(_, inner, _, _):
			compiler_typed_expr_has_assignment_inside_debug_block(inner)
		CompilerTypedBinaryExpr(_, left, right, _, _):
			(
				compiler_typed_expr_has_assignment_inside_debug_block(left)
				or compiler_typed_expr_has_assignment_inside_debug_block(right)
			)
		CompilerTypedLogicalExpr(_, left, right, _, _):
			(
				compiler_typed_expr_has_assignment_inside_debug_block(left)
				or compiler_typed_expr_has_assignment_inside_debug_block(right)
			)
		CompilerTypedCallExpr(callee, args, _, _):
			(
				compiler_typed_expr_has_assignment_inside_debug_block(callee)
				or compiler_typed_expr_list_has_assignment_inside_debug_block(args)
			)
		CompilerTypedTupleExpr(items, _, _):
			compiler_typed_expr_list_has_assignment_inside_debug_block(items)
		CompilerTypedListExpr(items, _, _):
			compiler_typed_expr_list_has_assignment_inside_debug_block(items)
		CompilerTypedVectorExpr(items, _, _):
			compiler_typed_expr_list_has_assignment_inside_debug_block(items)
		CompilerTypedDictExpr(entries, _, _):
			compiler_typed_dict_entries_have_assignment_inside_debug_block(entries)
		CompilerTypedRecordExpr(fields, _, _):
			compiler_typed_record_fields_have_assignment_inside_debug_block(fields)
		CompilerTypedRecordUpdateExpr(base, fields, _, _):
			(
				compiler_typed_expr_has_assignment_inside_debug_block(base)
				or compiler_typed_record_fields_have_assignment_inside_debug_block(fields)
			)
		CompilerTypedFieldAccessExpr(receiver, _, _, _):
			compiler_typed_expr_has_assignment_inside_debug_block(receiver)
		CompilerTypedSubscriptExpr(receiver, indices, _, _):
			(
				compiler_typed_expr_has_assignment_inside_debug_block(receiver)
				or compiler_typed_expr_list_has_assignment_inside_debug_block(indices)
			)
		CompilerTypedLambdaExpr(_, _, _, _, _, _):
			False
		CompilerTypedBlockExpr(items, _, _):
			compiler_typed_expr_list_has_assignment_inside_debug_block(items)
		CompilerTypedDebugBlockExpr(body, _, _):
			compiler_typed_expr_has_assignment_inside_debug_block(body)
		CompilerTypedAscriptionExpr(inner, _, _, _):
			compiler_typed_expr_has_assignment_inside_debug_block(inner)
		CompilerTypedOpaqueIntoExpr(_, inner, _, _):
			compiler_typed_expr_has_assignment_inside_debug_block(inner)
		CompilerTypedOpaqueFromExpr(_, inner, _, _):
			compiler_typed_expr_has_assignment_inside_debug_block(inner)
		CompilerTypedIfExpr(condition, then_branch, else_branch, _, _):
			if (
				compiler_typed_expr_has_assignment_inside_debug_block(condition)
				or compiler_typed_expr_has_assignment_inside_debug_block(then_branch)
			):
				True
			else:
				match else_branch:
					Some(branch):
						compiler_typed_expr_has_assignment_inside_debug_block(branch)
					None:
						False
		CompilerTypedMatchExpr(scrutinee, cases, _, _):
			(
				compiler_typed_expr_has_assignment_inside_debug_block(scrutinee)
				or compiler_typed_match_cases_have_assignment_inside_debug_block(cases)
			)
		CompilerTypedSelectExpr(arms, _, _):
			compiler_typed_select_arms_have_assignment_inside_debug_block(arms)
		CompilerTypedWhileExpr(condition, body, _, _):
			(
				compiler_typed_expr_has_assignment_inside_debug_block(condition)
				or compiler_typed_expr_has_assignment_inside_debug_block(body)
			)
		CompilerTypedForExpr(_, iterable, _, body, _, _):
			(
				compiler_typed_expr_has_assignment_inside_debug_block(iterable)
				or compiler_typed_expr_has_assignment_inside_debug_block(body)
			)
		CompilerTypedConcurrentBlockExpr(params, bindings, _, _):
			(
				compiler_typed_concurrent_params_have_assignment_inside_debug_block(params)
				or compiler_typed_concurrent_bindings_have_assignment_inside_debug_block(bindings)
			)
		CompilerTypedConcurrentForExpr(_, iterable, params, body, _, _):
			(
				compiler_typed_expr_has_assignment_inside_debug_block(iterable)
				or compiler_typed_concurrent_params_have_assignment_inside_debug_block(params)
				or compiler_typed_expr_has_assignment_inside_debug_block(body)
			)
		CompilerTypedWithExpr(binding, body, _, _):
			(
				compiler_typed_with_binding_has_assignment_inside_debug_block(binding)
				or compiler_typed_expr_has_assignment_inside_debug_block(body)
			)
		CompilerTypedDetachExpr(body, _, _):
			compiler_typed_expr_has_assignment_inside_debug_block(body)
		CompilerTypedStringInterpolationPartsExpr(parts, _, _, _):
			compiler_typed_interpolation_parts_have_assignment_inside_debug_block(parts)
		_:
			False


private pure func compiler_typed_expr_list_has_assignment_inside_debug_block(
	exprs: List[CompilerTypedExpr],
) -> Bool:
	var found: Bool = False

	for expr in exprs:
		if compiler_typed_expr_has_assignment_inside_debug_block(expr):
			found = True
			break

	found


