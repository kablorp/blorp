pure func compiler_typed_expr_with_slot(
	expr: CompilerTypedExpr,
	value_slot: CompilerValueSlot,
) -> CompilerTypedExpr:
	info = compiler_typed_expr_info(expr)
	next_info = compiler_typed_expr_info_from_slot(
		info.source_type,
		info.origin,
		info.proofs,
		info.resolved_call,
		value_slot,
	)

	compiler_typed_expr_with_info(
		expr,
		compiler_expr_info_with_resource_dependencies(next_info, info.resource_dependencies),
	)


pure func compiler_typed_expr_source_type(expr: CompilerTypedExpr) -> Option[CompilerType]:
	compiler_optional_type_copy(compiler_typed_expr_info(expr).source_type)


pure func compiler_typed_expr_semantic_type(expr: CompilerTypedExpr) -> CompilerType:
	compiler_type_copy(compiler_typed_expr_info(expr).semantic_type)


pure func compiler_typed_expr_value_type(expr: CompilerTypedExpr) -> CompilerType:
	compiler_type_copy(compiler_typed_expr_info(expr).value_type)


pure func compiler_typed_expr_origin(expr: CompilerTypedExpr) -> CompilerExprTypeOrigin:
	compiler_expr_type_origin_copy(compiler_typed_expr_info(expr).origin)


pure func compiler_typed_expr_widening(expr: CompilerTypedExpr) -> CompilerTypeWideningDecision:
	compiler_widening_decision_copy(
		compiler_widening_decision(compiler_typed_expr_info(expr).value_slot),
	)


pure func compiler_typed_expr_resolved_call(
	expr: CompilerTypedExpr,
) -> Option[CompilerResolvedCallInfo]:
	compiler_optional_resolved_call_info_copy(compiler_typed_expr_info(expr).resolved_call)


private pure func compiler_optional_type_contains_meta(typ: Option[CompilerType]) -> Bool:
	match typ:
		Some(value):
			compiler_type_contains_meta(value)
		None:
			False


private pure func compiler_expr_type_origin_contains_meta(origin: CompilerExprTypeOrigin) -> Bool:
	match origin:
		CompilerExplicitAnnotationOrigin(typ):
			compiler_type_contains_meta(typ)
		CompilerInferredOrigin:
			False
		CompilerSynthesizedOrigin(_):
			False


private pure func compiler_widening_decision_contains_meta(
	decision: CompilerTypeWideningDecision,
) -> Bool:
	match decision:
		CompilerTypeKeep(typ):
			compiler_type_contains_meta(typ)
		CompilerTypeWiden(from_type, to_type, _):
			compiler_type_contains_meta(from_type) or compiler_type_contains_meta(to_type)


private pure func compiler_value_slot_contains_meta(slot: CompilerValueSlot) -> Bool:
	(
		compiler_type_contains_meta(slot.semantic_type)
		or compiler_widening_decision_contains_meta(slot.decision)
	)


private pure func compiler_type_list_contains_meta(types: List[CompilerType]) -> Bool:
	var found: Bool = False

	for typ in types:
		if compiler_type_contains_meta(typ):
			found = True
			break

	found


private pure func compiler_resolved_call_contains_meta(info: CompilerResolvedCallInfo) -> Bool:
	var found: Bool = False

	for constraint in info.dim_constraints:
		if compiler_type_contains_meta(constraint[0]) or compiler_type_contains_meta(constraint[1]):
			found = True
			break

	(
		found
		or compiler_type_list_contains_meta(info.instantiated_params)
		or compiler_type_contains_meta(info.instantiated_return)
	)


private pure func compiler_optional_resolved_call_contains_meta(
	info: Option[CompilerResolvedCallInfo],
) -> Bool:
	match info:
		Some(value):
			compiler_resolved_call_contains_meta(value)
		None:
			False


pure func compiler_typed_expr_info_contains_meta(info: CompilerTypedExprInfo) -> Bool:
	(
		compiler_optional_type_contains_meta(info.source_type)
		or compiler_type_contains_meta(info.semantic_type)
		or compiler_type_contains_meta(info.value_type)
		or compiler_expr_type_origin_contains_meta(info.origin)
		or compiler_value_slot_contains_meta(info.value_slot)
		or compiler_optional_resolved_call_contains_meta(info.resolved_call)
	)


private pure func compiler_typed_expr_info_origin_error(
	info: CompilerTypedExprInfo,
) -> Option[String]:
	match info.origin:
		CompilerExplicitAnnotationOrigin(origin_type):
			match info.source_type:
				Some(source_type):
					if compiler_types_equal(origin_type, source_type):
						None
					else:
						Some("explicit origin type must match source type")
				None:
					Some("explicit origin requires source type")
		CompilerInferredOrigin:
			None
		CompilerSynthesizedOrigin(_):
			None


private pure func compiler_typed_expr_info_widening_error(
	info: CompilerTypedExprInfo,
) -> Option[String]:
	if not compiler_types_equal(info.semantic_type, info.value_slot.semantic_type):
		Some("semantic type must match value slot semantic type")
	else:
		match info.value_slot.decision:
			CompilerTypeKeep(typ):
				if not compiler_types_equal(info.semantic_type, typ):
					Some("kept widening decision must match semantic type")
				else if not compiler_types_equal(info.value_type, typ):
					Some("kept widening decision must match value type")
				else:
					None
			CompilerTypeWiden(from_type, to_type, _):
				if not compiler_types_equal(info.semantic_type, from_type):
					Some("widening source must match semantic type")
				else if not compiler_types_equal(info.value_type, to_type):
					Some("widening target must match value type")
				else:
					None


private pure func compiler_dim_constraints_equal(
	left: List[(CompilerType, CompilerType)],
	right: List[(CompilerType, CompilerType)],
) -> Bool:
	if left.length() != right.length():
		False
	else:
		var equal: Bool = True
		var index: Int = 0

		while equal and index < left.length():
			match (left.get(index), right.get(index)):
				(Some(left_pair), Some(right_pair)):
					equal = (
						compiler_types_equal(left_pair[0], right_pair[0])
						and compiler_types_equal(left_pair[1], right_pair[1])
					)
				_:
					equal = False

			index += 1

		equal


private pure func compiler_callable_origins_equal(
	left: CompilerCallableOrigin,
	right: CompilerCallableOrigin,
) -> Bool:
	match left:
		CompilerCallableLocal:
			match right:
				CompilerCallableLocal:
					True
				_:
					False
		CompilerCallableImported(left_path):
			match right:
				CompilerCallableImported(right_path):
					left_path == right_path
				_:
					False
		CompilerCallableBuiltin:
			match right:
				CompilerCallableBuiltin:
					True
				_:
					False
		CompilerCallableForeign:
			match right:
				CompilerCallableForeign:
					True
				_:
					False
		CompilerCallableConstructor(left_parent):
			match right:
				CompilerCallableConstructor(right_parent):
					left_parent == right_parent
				_:
					False
		CompilerCallableImplMethod:
			match right:
				CompilerCallableImplMethod:
					True
				_:
					False


private pure func compiler_resolved_call_targets_equal(
	left: CompilerResolvedCallTarget,
	right: CompilerResolvedCallTarget,
) -> Bool:
	match left:
		CompilerResolvedDirectCall(left_id, left_origin):
			match right:
				CompilerResolvedDirectCall(right_id, right_origin):
					(
						left_id == right_id
						and compiler_callable_origins_equal(left_origin, right_origin)
					)
				_:
					False
		CompilerResolvedTraitMethodCall(left_trait, left_target):
			match right:
				CompilerResolvedTraitMethodCall(right_trait, right_target):
					left_trait == right_trait and match (left_target, right_target):
						(Some(left_value), Some(right_value)):
							(
								left_value.callable_id == right_value.callable_id
								and left_value.module_path == right_value.module_path
							)
						(None, None):
							True
						_:
							False
				_:
					False
		CompilerResolvedIntrinsicCall:
			match right:
				CompilerResolvedIntrinsicCall:
					True
				_:
					False
		CompilerResolvedClosureCall:
			match right:
				CompilerResolvedClosureCall:
					True
				_:
					False


private pure func compiler_optional_resolved_loop_producers_equal(
	left: Option[CompilerResolvedLoopProducer],
	right: Option[CompilerResolvedLoopProducer],
) -> Bool:
	match left:
		Some(left_value):
			match right:
				Some(right_value):
					left_value == right_value
				None:
					False
		None:
			right.is_none()


private pure func compiler_resolved_call_infos_equal(
	left: CompilerResolvedCallInfo,
	right: CompilerResolvedCallInfo,
) -> Bool:
	(
		left.callee_name == right.callee_name
		and left.source_name == right.source_name
		and compiler_purities_equal(left.purity, right.purity)
		and compiler_resolved_call_targets_equal(left.target, right.target)
		and compiler_resource_arg_policies_equal(left.resource_args, right.resource_args)
		and compiler_dim_constraints_equal(left.dim_constraints, right.dim_constraints)
		and compiler_optional_resolved_loop_producers_equal(left.loop_producer, right.loop_producer)
	)


private pure func compiler_typed_call_resolved_metadata_error(
	callee: CompilerTypedExpr,
	call_info: CompilerTypedExprInfo,
) -> Option[String]:
	match compiler_typed_expr_resolved_call(callee):
		Some(callee_call):
			match call_info.resolved_call:
				Some(call_call):
					if compiler_resolved_call_infos_equal(callee_call, call_call):
						None
					else:
						Some("call expression resolved-call metadata must match callee")
				None:
					Some("call expression missing resolved-call metadata from callee")
		None:
			None


pure func compiler_typed_expr_info_type_error(info: CompilerTypedExprInfo) -> Option[String]:
	match compiler_typed_expr_info_origin_error(info):
		Some(message):
			Some(message)
		None:
			compiler_typed_expr_info_widening_error(info)


private pure func compiler_first_typed_expr_type_error(
	exprs: List[CompilerTypedExpr],
) -> Option[String]:
	var result: Option[String] = None

	for expr in exprs:
		match result:
			Some(_):
				break
			None:
				result = compiler_typed_expr_type_error(expr)

	result


private pure func compiler_optional_typed_expr_type_error(
	expr: Option[CompilerTypedExpr],
) -> Option[String]:
	match expr:
		Some(value):
			compiler_typed_expr_type_error(value)
		None:
			None


