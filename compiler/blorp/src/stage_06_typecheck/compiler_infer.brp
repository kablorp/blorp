CONCURRENT_PARAM_MAX_THREADS: String = "max_threads"

CONCURRENT_PARAM_TIMEOUT: String = "timeout"

CONCURRENT_FOR_PARAM_LIMIT: String = "limit"


union CompilerExprTypeOrigin:
	CompilerInferredOrigin
	CompilerExplicitAnnotationOrigin(CompilerType)
	CompilerSynthesizedOrigin(String)


union CompilerCallableOrigin:
	CompilerCallableLocal
	CompilerCallableImported(String)
	CompilerCallableBuiltin
	CompilerCallableForeign
	CompilerCallableConstructor(String)
	CompilerCallableImplMethod


union CompilerResolvedCallTarget:
	CompilerResolvedDirectCall(Int, CompilerCallableOrigin)
	CompilerResolvedTraitMethodCall(String, Option[CompilerImplMethodTarget])
	CompilerResolvedIntrinsicCall
	CompilerResolvedClosureCall


enum CompilerResolvedLoopProducer:
	CompilerResolvedLoopProducerIndices
	CompilerResolvedLoopProducerEnumerate
	CompilerResolvedLoopProducerEnumerate2
	CompilerResolvedLoopProducerWindows


record CompilerResolvedCallInfo {
	callee_name: String,
	source_name: String,
	purity: CompilerPurity,
	target: CompilerResolvedCallTarget,
	instantiated_params: List[CompilerType],
	instantiated_return: CompilerType,
	resource_args: CompilerResourceArgPolicy,
	dim_constraints: List[(CompilerType, CompilerType)],
	loop_producer: Option[CompilerResolvedLoopProducer]
}


private record CompilerTraitMethodCallee {
	source_name: String,
	method_name: String,
	trait_name: String,
	method: CompilerTraitMethodSig
}


record CompilerTypedExprInfo {
	source_type: Option[CompilerType],
	semantic_type: CompilerType,
	value_type: CompilerType,
	origin: CompilerExprTypeOrigin,
	value_slot: CompilerValueSlot,
	proofs: CompilerValueProofs,
	resolved_call: Option[CompilerResolvedCallInfo],
	resource_dependencies: List[String]
}


record CompilerTypedVarDeclPayload {
	name: ParsedIdentifier,
	annotation: Option[CompilerType],
	initializer: CompilerTypedExpr,
	is_mutable: Bool,
	span: CompilerSourceSpan
}


record CompilerTypedDictEntry {
	key: CompilerTypedExpr,
	value: CompilerTypedExpr
}


private pure func compiler_typed_dict_entry(
	key: CompilerTypedExpr,
	value: CompilerTypedExpr,
) -> CompilerTypedDictEntry:
	{
		key = key,
		value = value
	}


record CompilerTypedRecordField {
	name: ParsedIdentifier,
	value: CompilerTypedExpr,
	span: CompilerSourceSpan
}


record CompilerTypedLambdaParam {
	name: ParsedIdentifier,
	source_type: Option[CompilerType],
	param_type: CompilerType
}


union CompilerTypedStringInterpolationPart:
	CompilerTypedInterpolationLiteral(String)
	CompilerTypedInterpolationExpr(CompilerTypedExpr)


union CompilerTypedPattern:
	CompilerTypedWildcardPattern(CompilerSourceSpan)
	CompilerTypedNamePattern(ParsedIdentifier, CompilerType)
	CompilerTypedBoolPattern(Bool, CompilerSourceSpan)
	CompilerTypedIntPattern(String, CompilerSourceSpan)
	CompilerTypedFloatPattern(String, CompilerSourceSpan)
	CompilerTypedStringPattern(String, CompilerSourceSpan)
	CompilerTypedCharPattern(Int, CompilerSourceSpan)
	CompilerTypedConstructorPattern(ParsedIdentifier, List[CompilerTypedPattern], CompilerSourceSpan)
	CompilerTypedQualifiedConstructorPattern(ParsedIdentifier, ParsedIdentifier, List[CompilerTypedPattern], CompilerSourceSpan)
	CompilerTypedTuplePattern(List[CompilerTypedPattern], CompilerSourceSpan)
	CompilerTypedListPattern(List[CompilerTypedPattern], Option[ParsedListPatternSpread], CompilerSourceSpan)
	CompilerTypedOrPattern(List[CompilerTypedPattern], CompilerSourceSpan)
	CompilerTypedUnsupportedPattern(String, CompilerSourceSpan)


record CompilerTypedMatchCase {
	pattern: CompilerTypedPattern,
	body: CompilerTypedExpr,
	span: CompilerSourceSpan
}


union CompilerTypedSelectArmKind:
	CompilerTypedSelectReceiveArm(ParsedIdentifier, CompilerType, CompilerTypedExpr)
	CompilerTypedSelectSealedArm(CompilerType, CompilerTypedExpr)
	CompilerTypedSelectAfterArm(CompilerTypedExpr)


record CompilerTypedSelectArm {
	kind: CompilerTypedSelectArmKind,
	body: CompilerTypedExpr,
	span: CompilerSourceSpan
}


enum CompilerTypedAssignScope:
	CompilerLocalAssignScope
	CompilerModuleAssignScope


record CompilerTypedAssignTarget {
	name: String,
	scope: CompilerTypedAssignScope
}


record CompilerTypedConcurrentParam {
	name: ParsedIdentifier,
	value: CompilerTypedExpr,
	span: CompilerSourceSpan
}


record CompilerTypedConcurrentBinding {
	name: ParsedIdentifier,
	annotation: Option[CompilerType],
	value: CompilerTypedExpr,
	span: CompilerSourceSpan,
	info: CompilerTypedExprInfo
}


record CompilerTypedWithErrorMap {
	name: ParsedIdentifier,
	value: CompilerTypedExpr,
	span: CompilerSourceSpan
}


record CompilerTypedWithBinding {
	name: ParsedIdentifier,
	annotation: Option[CompilerType],
	value: CompilerTypedExpr,
	kind: ParsedWithBindingKind,
	error_map: Option[CompilerTypedWithErrorMap],
	cleanup_function: Option[String],
	span: CompilerSourceSpan
}


pure func compiler_typed_with_binding_is_try(binding: CompilerTypedWithBinding) -> Bool:
	match binding.kind:
		ParsedWithPlainBinding:
			False
		ParsedWithTryBinding:
			True


union CompilerTypedLoopView:
	CompilerTypedIndicesLoopView(CompilerType)
	CompilerTypedEnumerateLoopView(CompilerType)
	CompilerTypedEnumerate2LoopView(CompilerType)
	CompilerTypedWindowsLoopView(Int, CompilerType)


union CompilerTypedExpr:
	CompilerTypedNameExpr(ParsedIdentifier, CompilerTypedExprInfo)
	CompilerTypedIntLiteralExpr(String, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedFloatLiteralExpr(String, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedStringLiteralExpr(String, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedStringInterpolationExpr(String, Bool, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedStringInterpolationPartsExpr(List[CompilerTypedStringInterpolationPart], Bool, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedBoolLiteralExpr(Bool, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedCharLiteralExpr(Int, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedUnaryExpr(ParsedUnaryOp, CompilerTypedExpr, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedBinaryExpr(ParsedBinaryOp, CompilerTypedExpr, CompilerTypedExpr, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedLogicalExpr(ParsedLogicalOp, CompilerTypedExpr, CompilerTypedExpr, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedCallExpr(CompilerTypedExpr, List[CompilerTypedExpr], CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedTupleExpr(List[CompilerTypedExpr], CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedTupleDestructExpr(List[ParsedIdentifier], CompilerTypedExpr, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedAssignExpr(ParsedIdentifier, CompilerTypedAssignScope, CompilerTypedExpr, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedSubscriptExpr(CompilerTypedExpr, List[CompilerTypedExpr], CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedSubscriptAssignExpr(Option[CompilerTypedAssignTarget], CompilerTypedExpr, List[CompilerTypedExpr], CompilerTypedExpr, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedListExpr(List[CompilerTypedExpr], CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedVectorExpr(List[CompilerTypedExpr], CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedDictExpr(List[CompilerTypedDictEntry], CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedOpaqueIntoExpr(CompilerType, CompilerTypedExpr, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedOpaqueFromExpr(CompilerType, CompilerTypedExpr, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedRecordExpr(List[CompilerTypedRecordField], CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedRecordUpdateExpr(CompilerTypedExpr, List[CompilerTypedRecordField], CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedFieldAccessExpr(CompilerTypedExpr, ParsedIdentifier, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedLambdaExpr(Bool, List[CompilerTypedLambdaParam], Option[CompilerType], CompilerTypedExpr, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedRangeExpr(CompilerTypedExpr, CompilerTypedExpr, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedIfExpr(CompilerTypedExpr, CompilerTypedExpr, Option[CompilerTypedExpr], CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedMatchExpr(CompilerTypedExpr, List[CompilerTypedMatchCase], CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedSelectExpr(List[CompilerTypedSelectArm], CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedWhileExpr(CompilerTypedExpr, CompilerTypedExpr, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedForExpr(ParsedForBinder, CompilerTypedExpr, Option[CompilerTypedLoopView], CompilerTypedExpr, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedConcurrentBlockExpr(List[CompilerTypedConcurrentParam], List[CompilerTypedConcurrentBinding], CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedConcurrentForExpr(ParsedIdentifier, CompilerTypedExpr, List[CompilerTypedConcurrentParam], CompilerTypedExpr, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedDetachExpr(CompilerTypedExpr, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedAscriptionExpr(CompilerTypedExpr, CompilerType, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedBlockExpr(List[CompilerTypedExpr], CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedWithExpr(CompilerTypedWithBinding, CompilerTypedExpr, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedDebugBlockExpr(CompilerTypedExpr, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedVarDeclExpr(CompilerTypedVarDeclPayload, CompilerTypedExprInfo)
	CompilerTypedQuestionBindExpr(ParsedIdentifier, Option[CompilerType], CompilerTypedExpr, CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedBreakExpr(CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedContinueExpr(CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedVoidExpr(CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedBuiltinExpr(Option[String], CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedMissingExpr(CompilerSourceSpan, CompilerTypedExprInfo)
	CompilerTypedUnsupportedExpr(String, CompilerSourceSpan, CompilerTypedExprInfo)


union CompilerExpectedValueSlotContext:
	CompilerExpectedArgumentSlot
	CompilerExpectedCollectionElementSlot(CompilerCollectionKind)
	CompilerExpectedBitwiseOperandSlot


record CompilerInferContext {
	state: CompilerTypecheckState,
	expected_type: Option[CompilerType],
	expected_slot: Option[CompilerExpectedValueSlotContext],
	in_loop: Bool,
	in_debug: Bool,
	suppress_debug_only_reference: Bool
}


private record CompilerTraitSelfCallResolution {
	context: CompilerInferContext,
	callee: CompilerTypedExpr,
	params: List[CompilerType],
	return_type: CompilerType,
	resolved_call: Option[CompilerResolvedCallInfo]
}


private record CompilerCallTypeParamScope {
	bound_params: List[CompilerBoundTypeParam],
	renames: List[CompilerTypeSubstEntry]
}


private record CompilerCallSignature {
	bound_params: List[CompilerBoundTypeParam],
	params: List[CompilerType],
	return_type: CompilerType
}


record CompilerInferResult {
	context: CompilerInferContext,
	expr: CompilerTypedExpr
}


private record CompilerMemoizedTypeShapeCheck {
	contains: Bool,
	memo: CompilerTypeShapeMemo
}


private record CompilerCheckedType {
	context: CompilerInferContext,
	typ: CompilerType
}


private record CompilerInferCallArgsResult {
	context: CompilerInferContext,
	args: List[CompilerTypedExpr],
	subst: List[CompilerTypeSubstEntry]
}


private record CompilerInferConcurrentParamsResult {
	context: CompilerInferContext,
	params: List[CompilerTypedConcurrentParam]
}


private record CompilerInferSelectArmsResult {
	context: CompilerInferContext,
	arms: List[CompilerTypedSelectArm]
}


private record CompilerInferSelectArmResult {
	context: CompilerInferContext,
	arm: CompilerTypedSelectArm
}


private record CompilerSelectChannelTypeResult {
	context: CompilerInferContext,
	element_type: Option[CompilerType]
}


private record CompilerConcurrentForIterableTypeResult {
	context: CompilerInferContext,
	element_type: Option[CompilerType]
}


private record CompilerInferWithTryBindingResult {
	context: CompilerInferContext,
	inner_type: CompilerType,
	error_map: Option[CompilerTypedWithErrorMap]
}


private record CompilerBindTypeSubstResult {
	context: CompilerInferContext,
	subst: List[CompilerTypeSubstEntry]
}


private record CompilerInferExprListResult {
	context: CompilerInferContext,
	exprs: List[CompilerTypedExpr]
}


private record CompilerInferDictEntriesResult {
	context: CompilerInferContext,
	entries: List[CompilerTypedDictEntry]
}


private record CompilerInferRecordFieldsResult {
	context: CompilerInferContext,
	fields: List[CompilerTypedRecordField]
}


private record CompilerInferStringInterpolationPartsResult {
	context: CompilerInferContext,
	parts: List[CompilerTypedStringInterpolationPart]
}


private record CompilerInferLambdaParamsResult {
	context: CompilerInferContext,
	params: List[CompilerTypedLambdaParam],
	param_types: List[CompilerType]
}


private record CompilerInferPatternResult {
	context: CompilerInferContext,
	env: CompilerEnv,
	pattern: CompilerTypedPattern,
	catch_all: Bool,
	matches_true: Bool,
	matches_false: Bool
}


private record CompilerInferPatternItemsResult {
	context: CompilerInferContext,
	env: CompilerEnv,
	patterns: List[CompilerTypedPattern]
}


private record CompilerInferMatchCasesResult {
	context: CompilerInferContext,
	cases: List[CompilerTypedMatchCase],
	result_type: Option[CompilerType],
	catch_all: Bool,
	matches_true: Bool,
	matches_false: Bool
}


private record CompilerListPatternCoverage {
	fixed_length: Int,
	has_spread: Bool
}


private record CompilerMatchResultTypeResult {
	context: CompilerInferContext,
	result_type: Option[CompilerType]
}


private record CompilerEqualityCompatibility {
	context: CompilerInferContext,
	left_type: CompilerType,
	right_type: CompilerType
}


private record CompilerConstructorTypeArgsStep {
	context: CompilerInferContext,
	args: List[CompilerType]
}


private record CompilerConstructorTypeStep {
	context: CompilerInferContext,
	typ: CompilerType
}


private record CompilerForTupleElementsResult {
	context: CompilerInferContext,
	elements: List[CompilerType],
	ok: Bool
}


private record CompilerInferSubscriptIndicesResult {
	context: CompilerInferContext,
	indices: List[CompilerTypedExpr],
	values: List[Int],
	static_flags: List[Bool],
	all_static: Bool
}


private record CompilerValidatedSubscriptIndex {
	context: CompilerInferContext,
	index: CompilerTypedExpr
}


private record CompilerValidatedSubscriptIndices {
	context: CompilerInferContext,
	indices: List[CompilerTypedExpr]
}


private enum CompilerOpaqueConversion:
	CompilerOpaqueIntoConversion
	CompilerOpaqueFromConversion


private record CompilerOpaqueConversionTypeResult {
	context: CompilerInferContext,
	source_type: CompilerType,
	opaque_type: CompilerType,
	target_type: CompilerType,
	ok: Bool
}


private union CompilerQuestionBindCarrier:
	CompilerQuestionBindOptionCarrier(CompilerType)
	CompilerQuestionBindResultCarrier(CompilerType, CompilerType)
	CompilerQuestionBindNonCarrier


private pure func compiler_expected_value_slot_context_copy(
	slot: CompilerExpectedValueSlotContext,
) -> CompilerExpectedValueSlotContext:
	match slot:
		CompilerExpectedArgumentSlot:
			CompilerExpectedArgumentSlot
		CompilerExpectedCollectionElementSlot(kind):
			CompilerExpectedCollectionElementSlot(kind)
		CompilerExpectedBitwiseOperandSlot:
			CompilerExpectedBitwiseOperandSlot


private pure func compiler_optional_expected_value_slot_context_copy(
	slot: Option[CompilerExpectedValueSlotContext],
) -> Option[CompilerExpectedValueSlotContext]:
	match slot:
		Some(value):
			Some(compiler_expected_value_slot_context_copy(value))
		None:
			None


private pure func compiler_type_list_copy(types: List[CompilerType]) -> List[CompilerType]:
	types.map(compiler_type_copy)


private pure func compiler_infer_context_copy(
	context: CompilerInferContext,
) -> CompilerInferContext:
	{
		state = context.state,
		expected_type = compiler_optional_type_copy(context.expected_type),
		expected_slot = compiler_optional_expected_value_slot_context_copy(context.expected_slot),
		in_loop = context.in_loop,
		in_debug = context.in_debug,
		suppress_debug_only_reference = context.suppress_debug_only_reference
	}


pure func compiler_infer_context(state: CompilerTypecheckState) -> CompilerInferContext:
	{
		state = state,
		expected_type = None,
		expected_slot = None,
		in_loop = False,
		in_debug = False,
		suppress_debug_only_reference = False
	}


private pure func compiler_infer_canonical_expected_type(
	context: CompilerInferContext,
	expected_type: CompilerType,
) -> CompilerType:
	qualified = compiler_resolve_qualified_type_names(context.state.module_aliases, expected_type)
	compiler_env_resolve_alias(context.state.env, qualified)


pure func compiler_infer_with_expected(
	context: CompilerInferContext,
	expected_type: CompilerType,
) -> CompilerInferContext:
	{
		state = context.state,
		expected_type = Some(compiler_infer_canonical_expected_type(context, expected_type)),
		expected_slot = None,
		in_loop = context.in_loop,
		in_debug = context.in_debug,
		suppress_debug_only_reference = context.suppress_debug_only_reference
	}


pure func compiler_infer_with_expected_value_slot(
	context: CompilerInferContext,
	expected_type: CompilerType,
	expected_slot: CompilerExpectedValueSlotContext,
) -> CompilerInferContext:
	{
		state = context.state,
		expected_type = Some(compiler_infer_canonical_expected_type(context, expected_type)),
		expected_slot = Some(compiler_expected_value_slot_context_copy(expected_slot)),
		in_loop = context.in_loop,
		in_debug = context.in_debug,
		suppress_debug_only_reference = context.suppress_debug_only_reference
	}


pure func compiler_infer_without_expected(context: CompilerInferContext) -> CompilerInferContext:
	{
		state = context.state,
		expected_type = None,
		expected_slot = None,
		in_loop = context.in_loop,
		in_debug = context.in_debug,
		suppress_debug_only_reference = context.suppress_debug_only_reference
	}


private pure func compiler_infer_context_with_state(
	context: CompilerInferContext,
	state: CompilerTypecheckState,
) -> CompilerInferContext:
	{
		state = state,
		expected_type = compiler_optional_type_copy(context.expected_type),
		expected_slot = compiler_optional_expected_value_slot_context_copy(context.expected_slot),
		in_loop = context.in_loop,
		in_debug = context.in_debug,
		suppress_debug_only_reference = context.suppress_debug_only_reference
	}


private pure func compiler_infer_inside_loop(context: CompilerInferContext) -> CompilerInferContext:
	{
		state = context.state,
		expected_type = None,
		expected_slot = None,
		in_loop = True,
		in_debug = context.in_debug,
		suppress_debug_only_reference = context.suppress_debug_only_reference
	}


private pure func compiler_infer_inside_debug(
	context: CompilerInferContext,
) -> CompilerInferContext:
	{
		state = context.state,
		expected_type = None,
		expected_slot = None,
		in_loop = context.in_loop,
		in_debug = True,
		suppress_debug_only_reference = context.suppress_debug_only_reference
	}


private pure func compiler_infer_suppress_debug_only_reference(
	context: CompilerInferContext,
) -> CompilerInferContext:
	{
		state = context.state,
		expected_type = compiler_optional_type_copy(context.expected_type),
		expected_slot = compiler_optional_expected_value_slot_context_copy(context.expected_slot),
		in_loop = context.in_loop,
		in_debug = context.in_debug,
		suppress_debug_only_reference = True
	}


private pure func compiler_typecheck_state_with_env(
	state: CompilerTypecheckState,
	env: CompilerEnv,
) -> CompilerTypecheckState:
	{ state | env = env }


private pure func compiler_expr_type_origin_copy(
	origin: CompilerExprTypeOrigin,
) -> CompilerExprTypeOrigin:
	match origin:
		CompilerInferredOrigin:
			CompilerInferredOrigin
		CompilerExplicitAnnotationOrigin(typ):
			CompilerExplicitAnnotationOrigin(compiler_type_copy(typ))
		CompilerSynthesizedOrigin(label):
			CompilerSynthesizedOrigin(label)


private pure func compiler_resolved_call_info_copy(
	info: CompilerResolvedCallInfo,
) -> CompilerResolvedCallInfo:
	{
		callee_name = info.callee_name,
		source_name = info.source_name,
		purity = info.purity,
		target = compiler_resolved_call_target_copy(info.target),
		instantiated_params = compiler_type_list_copy(info.instantiated_params),
		instantiated_return = compiler_type_copy(info.instantiated_return),
		resource_args = info.resource_args,
		dim_constraints = info.dim_constraints.map(compiler_dim_constraint_copy),
		loop_producer = info.loop_producer
	}


private pure func compiler_dim_constraint_copy(
	constraint: (CompilerType, CompilerType),
) -> (CompilerType, CompilerType):
	(compiler_type_copy(constraint[0]), compiler_type_copy(constraint[1]))


private pure func compiler_optional_resolved_call_info_copy(
	info: Option[CompilerResolvedCallInfo],
) -> Option[CompilerResolvedCallInfo]:
	match info:
		Some(value):
			Some(compiler_resolved_call_info_copy(value))
		None:
			empty: Option[CompilerResolvedCallInfo] = None
			empty


private pure func compiler_widening_decision_copy(
	decision: CompilerTypeWideningDecision,
) -> CompilerTypeWideningDecision:
	match decision:
		CompilerTypeKeep(typ):
			CompilerTypeKeep(compiler_type_copy(typ))
		CompilerTypeWiden(from_type, to_type, reason):
			CompilerTypeWiden(compiler_type_copy(from_type), compiler_type_copy(to_type), reason)


private pure func compiler_value_slot_copy(slot: CompilerValueSlot) -> CompilerValueSlot:
	{
		semantic_type = compiler_type_copy(slot.semantic_type),
		decision = compiler_widening_decision_copy(slot.decision)
	}


private pure func compiler_string_list_copy(values: List[String]) -> List[String]:
	values.map(func(value): value)


private pure func compiler_typed_expr_info_copy(
	info: CompilerTypedExprInfo,
) -> CompilerTypedExprInfo:
	{
		source_type = compiler_optional_type_copy(info.source_type),
		semantic_type = compiler_type_copy(info.semantic_type),
		value_type = compiler_type_copy(info.value_type),
		origin = compiler_expr_type_origin_copy(info.origin),
		value_slot = compiler_value_slot_copy(info.value_slot),
		proofs = info.proofs,
		resolved_call = compiler_optional_resolved_call_info_copy(info.resolved_call),
		resource_dependencies = compiler_string_list_copy(info.resource_dependencies)
	}


private pure func compiler_resolved_call_with_instantiated_signature(
	info: CompilerResolvedCallInfo,
	params: List[CompilerType],
	return_type: CompilerType,
) -> CompilerResolvedCallInfo:
	{ info |
		instantiated_params = compiler_type_list_copy(params),
		instantiated_return = compiler_type_copy(return_type)
	}


private pure func compiler_optional_resolved_call_with_instantiated_signature(
	info: Option[CompilerResolvedCallInfo],
	params: List[CompilerType],
	return_type: CompilerType,
) -> Option[CompilerResolvedCallInfo]:
	match info:
		Some(value):
			Some(compiler_resolved_call_with_instantiated_signature(value, params, return_type))
		None:
			empty: Option[CompilerResolvedCallInfo] = None
			empty


private pure func compiler_keep_value_slot(typ: CompilerType) -> CompilerValueSlot:
	{
		semantic_type = compiler_type_copy(typ),
		decision = CompilerTypeKeep(compiler_type_copy(typ))
	}


private pure func compiler_infer_expected_slot(
	context: CompilerInferContext,
	semantic_type: CompilerType,
) -> CompilerValueSlot:
	match (context.expected_type, context.expected_slot):
		(Some(expected_type), Some(slot_context)):
			match slot_context:
				CompilerExpectedArgumentSlot:
					compiler_argument_target_slot(
						context.state.context,
						expected_type,
						semantic_type,
					)
				CompilerExpectedCollectionElementSlot(kind):
					compiler_collection_element_target_slot(kind, expected_type, semantic_type)
				CompilerExpectedBitwiseOperandSlot:
					compiler_bitwise_operand_target_slot(expected_type, semantic_type)
		_:
			compiler_keep_value_slot(semantic_type)


private pure func compiler_infer_range_binding_slot(
	context: CompilerInferContext,
	semantic_type: CompilerType,
) -> CompilerValueSlot:
	match context.expected_type:
		Some(CompilerRangeType(_)):
			compiler_infer_expected_slot(context, semantic_type)
		_:
			compiler_range_proof_slot(semantic_type)


private pure func compiler_typed_expr_info_from_slot(
	source_type: Option[CompilerType],
	origin: CompilerExprTypeOrigin,
	proofs: CompilerValueProofs,
	resolved_call: Option[CompilerResolvedCallInfo],
	value_slot: CompilerValueSlot,
) -> CompilerTypedExprInfo:
	semantic_type = compiler_widening_semantic_type(value_slot)
	value_type = compiler_widening_value_type(value_slot)

	{
		source_type = compiler_optional_type_copy(source_type),
		semantic_type = compiler_type_copy(semantic_type),
		value_type = compiler_type_copy(value_type),
		origin = compiler_expr_type_origin_copy(origin),
		value_slot = value_slot,
		proofs = proofs,
		resolved_call = compiler_optional_resolved_call_info_copy(resolved_call),
		resource_dependencies = []
	}


private pure func compiler_expr_info_with_resource_dependencies(
	info: CompilerTypedExprInfo,
	dependencies: List[String],
) -> CompilerTypedExprInfo:
	{ info | resource_dependencies = dependencies }


private pure func compiler_inferred_info(
	context: CompilerInferContext,
	semantic_type: CompilerType,
) -> CompilerTypedExprInfo:
	compiler_typed_expr_info_from_slot(
		None,
		CompilerInferredOrigin,
		compiler_unrefined_binding(),
		None,
		compiler_infer_expected_slot(context, semantic_type),
	)


private pure func compiler_callable_origin_from_func(
	origin: CompilerFuncOrigin,
	module_path: Option[String],
) -> CompilerCallableOrigin:
	match origin:
		CompilerUserDefinedFunc:
			match module_path:
				Some(path):
					CompilerCallableImported(path)
				None:
					CompilerCallableLocal
		CompilerBuiltinFunc:
			CompilerCallableBuiltin
		CompilerForeignFunc:
			CompilerCallableForeign


private pure func compiler_resolved_call_target_copy(
	target: CompilerResolvedCallTarget,
) -> CompilerResolvedCallTarget:
	match target:
		CompilerResolvedDirectCall(callable_id, origin):
			CompilerResolvedDirectCall(callable_id, origin)
		CompilerResolvedTraitMethodCall(trait_name, impl_target):
			CompilerResolvedTraitMethodCall(trait_name, impl_target)
		CompilerResolvedIntrinsicCall:
			CompilerResolvedIntrinsicCall
		CompilerResolvedClosureCall:
			CompilerResolvedClosureCall


pure func compiler_resolved_call_callable_id(info: CompilerResolvedCallInfo) -> Option[Int]:
	match info.target:
		CompilerResolvedDirectCall(callable_id, _):
			Some(callable_id)
		CompilerResolvedTraitMethodCall(_, impl_target):
			impl_target.map(func(target): target.callable_id)
		CompilerResolvedIntrinsicCall:
			None
		CompilerResolvedClosureCall:
			None


private pure func compiler_resolved_call_is_trait_target(info: CompilerResolvedCallInfo) -> Bool:
	match info.target:
		CompilerResolvedTraitMethodCall(_, _):
			True
		_:
			False


private pure func compiler_resolved_call_trait_name(
	info: CompilerResolvedCallInfo,
) -> Option[String]:
	match info.target:
		CompilerResolvedTraitMethodCall(trait_name, _):
			Some(trait_name)
		_:
			None


private pure func compiler_purity_from_bool(is_pure: Bool) -> CompilerPurity:
	if is_pure:
		CompilerPure
	else:
		CompilerImpure


private pure func compiler_resolved_loop_producer(
	producer: Option[CompilerLoopProducer],
) -> Option[CompilerResolvedLoopProducer]:
	match producer:
		Some(value):
			if compiler_loop_producer_is_indices(value):
				Some(CompilerResolvedLoopProducerIndices)
			else if compiler_loop_producer_is_enumerate(value):
				Some(CompilerResolvedLoopProducerEnumerate)
			else if compiler_loop_producer_is_enumerate2(value):
				Some(CompilerResolvedLoopProducerEnumerate2)
			else if compiler_loop_producer_is_windows(value):
				Some(CompilerResolvedLoopProducerWindows)
			else:
				None
		None:
			None


private pure func compiler_resolved_call_params_from_type(
	func_type: CompilerType,
) -> List[CompilerType]:
	match func_type:
		CompilerFunctionType(_, params, _):
			compiler_type_list_copy(params)
		_:
			[]


private pure func compiler_resolved_call_return_from_type(func_type: CompilerType) -> CompilerType:
	match func_type:
		CompilerFunctionType(_, _, return_type):
			compiler_type_copy(return_type)
		_:
			compiler_type_copy(func_type)


private pure func compiler_trait_method_callee_function_type(
	callee: CompilerTraitMethodCallee,
) -> CompilerType:
	CompilerFunctionType(
		callee.method.is_pure,
		callee.method.params.map(compiler_type_copy),
		compiler_type_copy(callee.method.return_type),
	)


private pure func compiler_resolved_call_from_trait_method_callee(
	callee: CompilerTraitMethodCallee,
	impl_target: Option[CompilerImplMethodTarget],
) -> CompilerResolvedCallInfo:
	{
		callee_name = callee.method_name,
		source_name = callee.source_name,
		purity = compiler_purity_from_bool(callee.method.is_pure),
		target = CompilerResolvedTraitMethodCall(callee.trait_name, impl_target),
		instantiated_params = callee.method.params.map(compiler_type_copy),
		instantiated_return = compiler_type_copy(callee.method.return_type),
		resource_args = CompilerRejectResourceArgs,
		dim_constraints = [],
		loop_producer = None
	}


private pure func compiler_resolved_call_from_closure(
	is_pure: Bool,
	params: List[CompilerType],
	return_type: CompilerType,
) -> CompilerResolvedCallInfo:
	{
		callee_name = "<closure>",
		source_name = "<closure>",
		purity = compiler_purity_from_bool(is_pure),
		target = CompilerResolvedClosureCall,
		instantiated_params = compiler_type_list_copy(params),
		instantiated_return = compiler_type_copy(return_type),
		resource_args = CompilerRejectResourceArgs,
		dim_constraints = [],
		loop_producer = None
	}


private pure func compiler_resolved_call_with_resource_args(
	info: CompilerResolvedCallInfo,
	resource_args: CompilerResourceArgPolicy,
) -> CompilerResolvedCallInfo:
	{ info | resource_args = resource_args }


private pure func compiler_trait_method_resource_args_for_type(
	context: CompilerInferContext,
	trait_name: String,
	method_name: String,
	receiver_type: CompilerType,
	fallback: CompilerResourceArgPolicy,
) -> CompilerResourceArgPolicy:
	match compiler_env_find_impl_method_info(
		context.state.env,
		trait_name,
		method_name,
		receiver_type,
	):
		Some(method_info):
			method_info.resource_args
		None:
			fallback


private pure func compiler_resolved_call_from_func_symbol_with_source(
	callee_name: String,
	source_name: String,
	func_symbol: CompilerFuncSymbol,
) -> CompilerResolvedCallInfo:
	{
		callee_name = callee_name,
		source_name = source_name,
		purity = func_symbol.purity,
		target = CompilerResolvedDirectCall(
			func_symbol.callable_id,
			compiler_callable_origin_from_func(func_symbol.origin, func_symbol.module_path),
		),
		instantiated_params = compiler_resolved_call_params_from_type(func_symbol.func_type),
		instantiated_return = compiler_resolved_call_return_from_type(func_symbol.func_type),
		resource_args = func_symbol.resource_args,
		dim_constraints = func_symbol.dim_constraints.map(compiler_dim_constraint_copy),
		loop_producer = compiler_resolved_loop_producer(func_symbol.loop_producer)
	}


private pure func compiler_resolved_call_from_func_symbol(
	callee_name: String,
	func_symbol: CompilerFuncSymbol,
) -> CompilerResolvedCallInfo:
	compiler_resolved_call_from_func_symbol_with_source(callee_name, callee_name, func_symbol)


private pure func compiler_resolved_call_from_overload_entry(
	callee_name: String,
	source_name: String,
	entry: CompilerOverloadEntry,
) -> CompilerResolvedCallInfo:
	{
		callee_name = callee_name,
		source_name = source_name,
		purity = entry.purity,
		target = CompilerResolvedDirectCall(
			entry.def_id,
			compiler_callable_origin_from_func(entry.origin, entry.module_path),
		),
		instantiated_params = compiler_resolved_call_params_from_type(entry.func_type),
		instantiated_return = compiler_resolved_call_return_from_type(entry.func_type),
		resource_args = entry.resource_args,
		dim_constraints = entry.dim_constraints.map(compiler_dim_constraint_copy),
		loop_producer = compiler_resolved_loop_producer(entry.loop_producer)
	}


private pure func compiler_resolved_call_from_constructor(
	callee_name: String,
	callable_id: Int,
	parent_type: String,
	constructor_type: CompilerType,
) -> CompilerResolvedCallInfo:
	{
		callee_name = callee_name,
		source_name = callee_name,
		purity = CompilerPure,
		target = CompilerResolvedDirectCall(callable_id, CompilerCallableConstructor(parent_type)),
		instantiated_params = compiler_resolved_call_params_from_type(constructor_type),
		instantiated_return = compiler_resolved_call_return_from_type(constructor_type),
		resource_args = CompilerRejectResourceArgs,
		dim_constraints = [],
		loop_producer = None
	}


private pure func compiler_explicit_info(
	source_type: CompilerType,
	semantic_type: CompilerType,
) -> CompilerTypedExprInfo:
	compiler_typed_expr_info_from_slot(
		Some(compiler_type_copy(source_type)),
		CompilerExplicitAnnotationOrigin(compiler_type_copy(source_type)),
		compiler_unrefined_binding(),
		None,
		compiler_keep_value_slot(semantic_type),
	)


pure func compiler_typed_expr_info(expr: CompilerTypedExpr) -> CompilerTypedExprInfo:
	match expr:
		CompilerTypedNameExpr(_, info):
			info
		CompilerTypedIntLiteralExpr(_, _, info):
			info
		CompilerTypedFloatLiteralExpr(_, _, info):
			info
		CompilerTypedStringLiteralExpr(_, _, info):
			info
		CompilerTypedStringInterpolationExpr(_, _, _, info):
			info
		CompilerTypedStringInterpolationPartsExpr(_, _, _, info):
			info
		CompilerTypedBoolLiteralExpr(_, _, info):
			info
		CompilerTypedCharLiteralExpr(_, _, info):
			info
		CompilerTypedUnaryExpr(_, _, _, info):
			info
		CompilerTypedBinaryExpr(_, _, _, _, info):
			info
		CompilerTypedLogicalExpr(_, _, _, _, info):
			info
		CompilerTypedCallExpr(_, _, _, info):
			info
		CompilerTypedTupleExpr(_, _, info):
			info
		CompilerTypedTupleDestructExpr(_, _, _, info):
			info
		CompilerTypedAssignExpr(_, _, _, _, info):
			info
		CompilerTypedSubscriptExpr(_, _, _, info):
			info
		CompilerTypedSubscriptAssignExpr(_, _, _, _, _, info):
			info
		CompilerTypedListExpr(_, _, info):
			info
		CompilerTypedVectorExpr(_, _, info):
			info
		CompilerTypedDictExpr(_, _, info):
			info
		CompilerTypedOpaqueIntoExpr(_, _, _, info):
			info
		CompilerTypedOpaqueFromExpr(_, _, _, info):
			info
		CompilerTypedRecordExpr(_, _, info):
			info
		CompilerTypedRecordUpdateExpr(_, _, _, info):
			info
		CompilerTypedFieldAccessExpr(_, _, _, info):
			info
		CompilerTypedLambdaExpr(_, _, _, _, _, info):
			info
		CompilerTypedRangeExpr(_, _, _, info):
			info
		CompilerTypedIfExpr(_, _, _, _, info):
			info
		CompilerTypedMatchExpr(_, _, _, info):
			info
		CompilerTypedSelectExpr(_, _, info):
			info
		CompilerTypedWhileExpr(_, _, _, info):
			info
		CompilerTypedForExpr(_, _, _, _, _, info):
			info
		CompilerTypedConcurrentBlockExpr(_, _, _, info):
			info
		CompilerTypedConcurrentForExpr(_, _, _, _, _, info):
			info
		CompilerTypedDetachExpr(_, _, info):
			info
		CompilerTypedAscriptionExpr(_, _, _, info):
			info
		CompilerTypedBlockExpr(_, _, info):
			info
		CompilerTypedWithExpr(_, _, _, info):
			info
		CompilerTypedDebugBlockExpr(_, _, info):
			info
		CompilerTypedVarDeclExpr(_, info):
			info
		CompilerTypedQuestionBindExpr(_, _, _, _, info):
			info
		CompilerTypedBreakExpr(_, info):
			info
		CompilerTypedContinueExpr(_, info):
			info
		CompilerTypedVoidExpr(_, info):
			info
		CompilerTypedBuiltinExpr(_, _, info):
			info
		CompilerTypedMissingExpr(_, info):
			info
		CompilerTypedUnsupportedExpr(_, _, info):
			info


private pure func compiler_typed_expr_with_info(
	expr: CompilerTypedExpr,
	info: CompilerTypedExprInfo,
) -> CompilerTypedExpr:
	match expr:
		CompilerTypedNameExpr(name, _):
			CompilerTypedNameExpr(name, info)
		CompilerTypedIntLiteralExpr(text, span, _):
			CompilerTypedIntLiteralExpr(text, span, info)
		CompilerTypedFloatLiteralExpr(text, span, _):
			CompilerTypedFloatLiteralExpr(text, span, info)
		CompilerTypedStringLiteralExpr(text, span, _):
			CompilerTypedStringLiteralExpr(text, span, info)
		CompilerTypedStringInterpolationExpr(text, raw, span, _):
			CompilerTypedStringInterpolationExpr(text, raw, span, info)
		CompilerTypedStringInterpolationPartsExpr(parts, multiline, span, _):
			CompilerTypedStringInterpolationPartsExpr(parts, multiline, span, info)
		CompilerTypedBoolLiteralExpr(value, span, _):
			CompilerTypedBoolLiteralExpr(value, span, info)
		CompilerTypedCharLiteralExpr(value, span, _):
			CompilerTypedCharLiteralExpr(value, span, info)
		CompilerTypedUnaryExpr(op, inner, span, _):
			CompilerTypedUnaryExpr(op, inner, span, info)
		CompilerTypedBinaryExpr(op, left, right, span, _):
			CompilerTypedBinaryExpr(op, left, right, span, info)
		CompilerTypedLogicalExpr(op, left, right, span, _):
			CompilerTypedLogicalExpr(op, left, right, span, info)
		CompilerTypedCallExpr(callee, args, span, _):
			CompilerTypedCallExpr(callee, args, span, info)
		CompilerTypedTupleExpr(items, span, _):
			CompilerTypedTupleExpr(items, span, info)
		CompilerTypedTupleDestructExpr(names, value, span, _):
			CompilerTypedTupleDestructExpr(names, value, span, info)
		CompilerTypedAssignExpr(name, scope, value, span, _):
			CompilerTypedAssignExpr(name, scope, value, span, info)
		CompilerTypedSubscriptExpr(receiver, indices, span, _):
			CompilerTypedSubscriptExpr(receiver, indices, span, info)
		CompilerTypedSubscriptAssignExpr(assign_target, receiver, indices, value, span, _):
			CompilerTypedSubscriptAssignExpr(assign_target, receiver, indices, value, span, info)
		CompilerTypedListExpr(items, span, _):
			CompilerTypedListExpr(items, span, info)
		CompilerTypedVectorExpr(items, span, _):
			CompilerTypedVectorExpr(items, span, info)
		CompilerTypedDictExpr(entries, span, _):
			CompilerTypedDictExpr(entries, span, info)
		CompilerTypedOpaqueIntoExpr(source_type, inner, span, _):
			CompilerTypedOpaqueIntoExpr(source_type, inner, span, info)
		CompilerTypedOpaqueFromExpr(source_type, inner, span, _):
			CompilerTypedOpaqueFromExpr(source_type, inner, span, info)
		CompilerTypedRecordExpr(fields, span, _):
			CompilerTypedRecordExpr(fields, span, info)
		CompilerTypedRecordUpdateExpr(receiver, fields, span, _):
			CompilerTypedRecordUpdateExpr(receiver, fields, span, info)
		CompilerTypedFieldAccessExpr(receiver, field, span, _):
			CompilerTypedFieldAccessExpr(receiver, field, span, info)
		CompilerTypedLambdaExpr(is_pure, params, return_annotation, body, span, _):
			CompilerTypedLambdaExpr(is_pure, params, return_annotation, body, span, info)
		CompilerTypedRangeExpr(start_expr, end_expr, span, _):
			CompilerTypedRangeExpr(start_expr, end_expr, span, info)
		CompilerTypedIfExpr(condition, then_branch, else_branch, span, _):
			CompilerTypedIfExpr(condition, then_branch, else_branch, span, info)
		CompilerTypedMatchExpr(scrutinee, cases, span, _):
			CompilerTypedMatchExpr(scrutinee, cases, span, info)
		CompilerTypedSelectExpr(arms, span, _):
			CompilerTypedSelectExpr(arms, span, info)
		CompilerTypedWhileExpr(condition, body, span, _):
			CompilerTypedWhileExpr(condition, body, span, info)
		CompilerTypedForExpr(binder, iterable, loop_view, body, span, _):
			CompilerTypedForExpr(binder, iterable, loop_view, body, span, info)
		CompilerTypedConcurrentBlockExpr(params, bindings, span, _):
			CompilerTypedConcurrentBlockExpr(params, bindings, span, info)
		CompilerTypedConcurrentForExpr(name, iterable, params, body, span, _):
			CompilerTypedConcurrentForExpr(name, iterable, params, body, span, info)
		CompilerTypedDetachExpr(body, span, _):
			CompilerTypedDetachExpr(body, span, info)
		CompilerTypedAscriptionExpr(inner, source_type, span, _):
			CompilerTypedAscriptionExpr(inner, source_type, span, info)
		CompilerTypedBlockExpr(items, span, _):
			CompilerTypedBlockExpr(items, span, info)
		CompilerTypedWithExpr(binding, body, span, _):
			CompilerTypedWithExpr(binding, body, span, info)
		CompilerTypedDebugBlockExpr(body, span, _):
