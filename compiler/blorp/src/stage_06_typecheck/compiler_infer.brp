pure func compiler_typed_expr_type_error(expr: CompilerTypedExpr) -> Option[String]:
	match compiler_typed_expr_info_type_error(compiler_typed_expr_info(expr)):
		Some(message):
			Some(message)
		None:
			match expr:
				CompilerTypedNameExpr(_, _):
					None
				CompilerTypedIntLiteralExpr(_, _, _):
					None
				CompilerTypedFloatLiteralExpr(_, _, _):
					None
				CompilerTypedStringLiteralExpr(_, _, _):
					None
				CompilerTypedStringInterpolationExpr(_, _, _, _):
					None
				CompilerTypedStringInterpolationPartsExpr(parts, _, _, _):
					compiler_typed_string_interpolation_parts_type_error(parts)
				CompilerTypedBoolLiteralExpr(_, _, _):
					None
				CompilerTypedCharLiteralExpr(_, _, _):
					None
				CompilerTypedUnaryExpr(_, inner, _, _):
					compiler_typed_expr_type_error(inner)
				CompilerTypedBinaryExpr(_, left, right, _, _):
					match compiler_typed_expr_type_error(left):
						Some(message):
							Some(message)
						None:
							compiler_typed_expr_type_error(right)
				CompilerTypedLogicalExpr(_, left, right, _, _):
					match compiler_typed_expr_type_error(left):
						Some(message):
							Some(message)
						None:
							compiler_typed_expr_type_error(right)
				CompilerTypedCallExpr(callee, args, _, info):
					match compiler_typed_expr_type_error(callee):
						Some(message):
							Some(message)
						None:
							match compiler_typed_call_resolved_metadata_error(callee, info):
								Some(message):
									Some(message)
								None:
									compiler_first_typed_expr_type_error(args)
				CompilerTypedTupleExpr(items, _, _):
					compiler_first_typed_expr_type_error(items)
				CompilerTypedTupleDestructExpr(_, value, _, _):
					compiler_typed_expr_type_error(value)
				CompilerTypedAssignExpr(_, _, value, _, _):
					compiler_typed_expr_type_error(value)
				CompilerTypedSubscriptExpr(receiver, indices, _, _):
					match compiler_typed_expr_type_error(receiver):
						Some(message):
							Some(message)
						None:
							compiler_first_typed_expr_type_error(indices)
				CompilerTypedSubscriptAssignExpr(_, receiver, indices, value, _, _):
					match compiler_typed_expr_type_error(receiver):
						Some(message):
							Some(message)
						None:
							match compiler_first_typed_expr_type_error(indices):
								Some(message):
									Some(message)
								None:
									compiler_typed_expr_type_error(value)
				CompilerTypedListExpr(items, _, _):
					compiler_first_typed_expr_type_error(items)
				CompilerTypedVectorExpr(items, _, _):
					compiler_first_typed_expr_type_error(items)
				CompilerTypedDictExpr(entries, _, _):
					compiler_typed_dict_entries_type_error(entries)
				CompilerTypedOpaqueIntoExpr(_, inner, _, _):
					compiler_typed_expr_type_error(inner)
				CompilerTypedOpaqueFromExpr(_, inner, _, _):
					compiler_typed_expr_type_error(inner)
				CompilerTypedRecordExpr(fields, _, _):
					compiler_typed_record_fields_type_error(fields)
				CompilerTypedRecordUpdateExpr(receiver, fields, _, _):
					match compiler_typed_expr_type_error(receiver):
						Some(message):
							Some(message)
						None:
							compiler_typed_record_fields_type_error(fields)
				CompilerTypedFieldAccessExpr(receiver, _, _, _):
					compiler_typed_expr_type_error(receiver)
				CompilerTypedLambdaExpr(_, _, _, body, _, _):
					compiler_typed_expr_type_error(body)
				CompilerTypedRangeExpr(start_expr, end_expr, _, _):
					match compiler_typed_expr_type_error(start_expr):
						Some(message):
							Some(message)
						None:
							compiler_typed_expr_type_error(end_expr)
				CompilerTypedIfExpr(condition, then_branch, else_branch, _, _):
					match compiler_typed_expr_type_error(condition):
						Some(message):
							Some(message)
						None:
							match compiler_typed_expr_type_error(then_branch):
								Some(message):
									Some(message)
								None:
									compiler_optional_typed_expr_type_error(else_branch)
				CompilerTypedMatchExpr(scrutinee, cases, _, _):
					match compiler_typed_expr_type_error(scrutinee):
						Some(message):
							Some(message)
						None:
							compiler_typed_match_cases_type_error(cases)
				CompilerTypedSelectExpr(arms, _, _):
					compiler_typed_select_arms_type_error(arms)
				CompilerTypedWhileExpr(condition, body, _, _):
					match compiler_typed_expr_type_error(condition):
						Some(message):
							Some(message)
						None:
							compiler_typed_expr_type_error(body)
				CompilerTypedForExpr(_, iterable, _, body, _, _):
					match compiler_typed_expr_type_error(iterable):
						Some(message):
							Some(message)
						None:
							compiler_typed_expr_type_error(body)
				CompilerTypedConcurrentBlockExpr(params, bindings, _, _):
					match compiler_typed_concurrent_params_type_error(params):
						Some(message):
							Some(message)
						None:
							compiler_typed_concurrent_bindings_type_error(bindings)
				CompilerTypedConcurrentForExpr(_, iterable, params, body, _, _):
					match compiler_typed_expr_type_error(iterable):
						Some(message):
							Some(message)
						None:
							match compiler_typed_concurrent_params_type_error(params):
								Some(message):
									Some(message)
								None:
									compiler_typed_expr_type_error(body)
				CompilerTypedDetachExpr(body, _, _):
					compiler_typed_expr_type_error(body)
				CompilerTypedAscriptionExpr(inner, _, _, _):
					compiler_typed_expr_type_error(inner)
				CompilerTypedBlockExpr(items, _, _):
					compiler_first_typed_expr_type_error(items)
				CompilerTypedWithExpr(binding, body, _, _):
					match compiler_typed_with_binding_type_error(binding):
						Some(message):
							Some(message)
						None:
							compiler_typed_expr_type_error(body)
				CompilerTypedDebugBlockExpr(body, _, _):
					compiler_typed_expr_type_error(body)
				CompilerTypedVarDeclExpr(payload, _):
					compiler_typed_var_decl_payload_type_error(payload)
				CompilerTypedQuestionBindExpr(_, _, value, _, _):
					compiler_typed_expr_type_error(value)
				CompilerTypedBreakExpr(_, _):
					None
				CompilerTypedContinueExpr(_, _):
					None
				CompilerTypedVoidExpr(_, _):
					None
				CompilerTypedBuiltinExpr(_, _, _):
					None
				CompilerTypedMissingExpr(_, _):
					None
				CompilerTypedUnsupportedExpr(_, _, _):
					None


private pure func compiler_typed_dict_entry_contains_meta(entry: CompilerTypedDictEntry) -> Bool:
	compiler_typed_expr_contains_meta(entry.key) or compiler_typed_expr_contains_meta(entry.value)


private pure func compiler_typed_record_field_contains_meta(
	field: CompilerTypedRecordField,
) -> Bool:
	compiler_typed_expr_contains_meta(field.value)


private pure func compiler_typed_lambda_param_contains_meta(
	param: CompilerTypedLambdaParam,
) -> Bool:
	(
		compiler_optional_type_contains_meta(param.source_type)
		or compiler_type_contains_meta(param.param_type)
	)


private pure func compiler_typed_string_interpolation_part_contains_meta(
	part: CompilerTypedStringInterpolationPart,
) -> Bool:
	match part:
		CompilerTypedInterpolationLiteral(_):
			False
		CompilerTypedInterpolationExpr(expr):
			compiler_typed_expr_contains_meta(expr)


private pure func compiler_typed_pattern_contains_meta(pattern: CompilerTypedPattern) -> Bool:
	match pattern:
		CompilerTypedWildcardPattern(_):
			False
		CompilerTypedNamePattern(_, typ):
			compiler_type_contains_meta(typ)
		CompilerTypedBoolPattern(_, _):
			False
		CompilerTypedIntPattern(_, _):
			False
		CompilerTypedFloatPattern(_, _):
			False
		CompilerTypedStringPattern(_, _):
			False
		CompilerTypedCharPattern(_, _):
			False
		CompilerTypedConstructorPattern(_, fields, _):
			fields.any(compiler_typed_pattern_contains_meta)
		CompilerTypedQualifiedConstructorPattern(_, _, fields, _):
			fields.any(compiler_typed_pattern_contains_meta)
		CompilerTypedTuplePattern(items, _):
			items.any(compiler_typed_pattern_contains_meta)
		CompilerTypedListPattern(items, _, _):
			items.any(compiler_typed_pattern_contains_meta)
		CompilerTypedOrPattern(items, _):
			items.any(compiler_typed_pattern_contains_meta)
		CompilerTypedUnsupportedPattern(_, _):
			False


private pure func compiler_typed_match_case_contains_meta(case: CompilerTypedMatchCase) -> Bool:
	(
		compiler_typed_pattern_contains_meta(case.pattern)
		or compiler_typed_expr_contains_meta(case.body)
	)


private pure func compiler_typed_select_arm_kind_contains_meta(
	kind: CompilerTypedSelectArmKind,
) -> Bool:
	match kind:
		CompilerTypedSelectReceiveArm(_, elem_type, channel):
			compiler_type_contains_meta(elem_type) or compiler_typed_expr_contains_meta(channel)
		CompilerTypedSelectSealedArm(elem_type, channel):
			compiler_type_contains_meta(elem_type) or compiler_typed_expr_contains_meta(channel)
		CompilerTypedSelectAfterArm(timeout):
			compiler_typed_expr_contains_meta(timeout)


private pure func compiler_typed_select_arm_contains_meta(arm: CompilerTypedSelectArm) -> Bool:
	(
		compiler_typed_select_arm_kind_contains_meta(arm.kind)
		or compiler_typed_expr_contains_meta(arm.body)
	)


private pure func compiler_typed_concurrent_param_contains_meta(
	param: CompilerTypedConcurrentParam,
) -> Bool:
	compiler_typed_expr_contains_meta(param.value)


private pure func compiler_typed_concurrent_binding_contains_meta(
	binding: CompilerTypedConcurrentBinding,
) -> Bool:
	(
		compiler_optional_type_contains_meta(binding.annotation)
		or compiler_typed_expr_contains_meta(binding.value)
	)


private pure func compiler_typed_with_error_map_contains_meta(
	error_map: CompilerTypedWithErrorMap,
) -> Bool:
	compiler_typed_expr_contains_meta(error_map.value)


private pure func compiler_optional_typed_with_error_map_contains_meta(
	error_map: Option[CompilerTypedWithErrorMap],
) -> Bool:
	match error_map:
		Some(value):
			compiler_typed_with_error_map_contains_meta(value)
		None:
			False


private pure func compiler_typed_with_binding_contains_meta(
	binding: CompilerTypedWithBinding,
) -> Bool:
	(
		compiler_optional_type_contains_meta(binding.annotation)
		or compiler_typed_expr_contains_meta(binding.value)
		or compiler_optional_typed_with_error_map_contains_meta(binding.error_map)
	)


private pure func compiler_typed_var_decl_payload_contains_meta(
	payload: CompilerTypedVarDeclPayload,
) -> Bool:
	(
		compiler_optional_type_contains_meta(payload.annotation)
		or compiler_typed_expr_contains_meta(payload.initializer)
	)


pure func compiler_typed_expr_contains_meta(expr: CompilerTypedExpr) -> Bool:
	if compiler_typed_expr_info_contains_meta(compiler_typed_expr_info(expr)):
		True
	else:
		match expr:
			CompilerTypedNameExpr(_, _):
				False
			CompilerTypedIntLiteralExpr(_, _, _):
				False
			CompilerTypedFloatLiteralExpr(_, _, _):
				False
			CompilerTypedStringLiteralExpr(_, _, _):
				False
			CompilerTypedStringInterpolationExpr(_, _, _, _):
				False
			CompilerTypedStringInterpolationPartsExpr(parts, _, _, _):
				parts.any(compiler_typed_string_interpolation_part_contains_meta)
			CompilerTypedBoolLiteralExpr(_, _, _):
				False
			CompilerTypedCharLiteralExpr(_, _, _):
				False
			CompilerTypedUnaryExpr(_, inner, _, _):
				compiler_typed_expr_contains_meta(inner)
			CompilerTypedBinaryExpr(_, left, right, _, _):
				compiler_typed_expr_contains_meta(left) or compiler_typed_expr_contains_meta(right)
			CompilerTypedLogicalExpr(_, left, right, _, _):
				compiler_typed_expr_contains_meta(left) or compiler_typed_expr_contains_meta(right)
			CompilerTypedCallExpr(callee, args, _, _):
				(
					compiler_typed_expr_contains_meta(callee)
					or args.any(compiler_typed_expr_contains_meta)
				)
			CompilerTypedTupleExpr(items, _, _):
				items.any(compiler_typed_expr_contains_meta)
			CompilerTypedTupleDestructExpr(_, value, _, _):
				compiler_typed_expr_contains_meta(value)
			CompilerTypedAssignExpr(_, _, value, _, _):
				compiler_typed_expr_contains_meta(value)
			CompilerTypedSubscriptExpr(receiver, indices, _, _):
				(
					compiler_typed_expr_contains_meta(receiver)
					or indices.any(compiler_typed_expr_contains_meta)
				)
			CompilerTypedSubscriptAssignExpr(_, receiver, indices, value, _, _):
				(
					compiler_typed_expr_contains_meta(receiver)
					or indices.any(compiler_typed_expr_contains_meta)
					or compiler_typed_expr_contains_meta(value)
				)
			CompilerTypedListExpr(items, _, _):
				items.any(compiler_typed_expr_contains_meta)
			CompilerTypedVectorExpr(items, _, _):
				items.any(compiler_typed_expr_contains_meta)
			CompilerTypedDictExpr(entries, _, _):
				entries.any(compiler_typed_dict_entry_contains_meta)
			CompilerTypedOpaqueIntoExpr(source_type, inner, _, _):
				compiler_type_contains_meta(source_type) or compiler_typed_expr_contains_meta(inner)
			CompilerTypedOpaqueFromExpr(source_type, inner, _, _):
				compiler_type_contains_meta(source_type) or compiler_typed_expr_contains_meta(inner)
			CompilerTypedRecordExpr(fields, _, _):
				fields.any(compiler_typed_record_field_contains_meta)
			CompilerTypedRecordUpdateExpr(receiver, fields, _, _):
				(
					compiler_typed_expr_contains_meta(receiver)
					or fields.any(compiler_typed_record_field_contains_meta)
				)
			CompilerTypedFieldAccessExpr(receiver, _, _, _):
				compiler_typed_expr_contains_meta(receiver)
			CompilerTypedLambdaExpr(_, params, return_annotation, body, _, _):
				(
					params.any(compiler_typed_lambda_param_contains_meta)
					or compiler_optional_type_contains_meta(return_annotation)
					or compiler_typed_expr_contains_meta(body)
				)
			CompilerTypedRangeExpr(start_expr, end_expr, _, _):
				(
					compiler_typed_expr_contains_meta(start_expr)
					or compiler_typed_expr_contains_meta(end_expr)
				)
			CompilerTypedIfExpr(condition, then_branch, else_branch, _, _):
				(
					compiler_typed_expr_contains_meta(condition)
					or compiler_typed_expr_contains_meta(then_branch)
					or match else_branch:
						Some(branch):
							compiler_typed_expr_contains_meta(branch)
						None:
							False
				)
			CompilerTypedMatchExpr(scrutinee, cases, _, _):
				(
					compiler_typed_expr_contains_meta(scrutinee)
					or cases.any(compiler_typed_match_case_contains_meta)
				)
			CompilerTypedSelectExpr(arms, _, _):
				arms.any(compiler_typed_select_arm_contains_meta)
			CompilerTypedWhileExpr(condition, body, _, _):
				(
					compiler_typed_expr_contains_meta(condition)
					or compiler_typed_expr_contains_meta(body)
				)
			CompilerTypedForExpr(_, iterable, _, body, _, _):
				(
					compiler_typed_expr_contains_meta(iterable)
					or compiler_typed_expr_contains_meta(body)
				)
			CompilerTypedConcurrentBlockExpr(params, bindings, _, _):
				(
					params.any(compiler_typed_concurrent_param_contains_meta)
					or bindings.any(compiler_typed_concurrent_binding_contains_meta)
				)
			CompilerTypedConcurrentForExpr(_, iterable, params, body, _, _):
				(
					compiler_typed_expr_contains_meta(iterable)
					or params.any(compiler_typed_concurrent_param_contains_meta)
					or compiler_typed_expr_contains_meta(body)
				)
			CompilerTypedDetachExpr(body, _, _):
				compiler_typed_expr_contains_meta(body)
			CompilerTypedAscriptionExpr(inner, source_type, _, _):
				compiler_typed_expr_contains_meta(inner) or compiler_type_contains_meta(source_type)
			CompilerTypedBlockExpr(items, _, _):
				items.any(compiler_typed_expr_contains_meta)
			CompilerTypedWithExpr(binding, body, _, _):
				(
					compiler_typed_with_binding_contains_meta(binding)
					or compiler_typed_expr_contains_meta(body)
				)
			CompilerTypedDebugBlockExpr(body, _, _):
				compiler_typed_expr_contains_meta(body)
			CompilerTypedVarDeclExpr(payload, _):
				compiler_typed_var_decl_payload_contains_meta(payload)
			CompilerTypedQuestionBindExpr(_, annotation, value, _, _):
				(
					compiler_optional_type_contains_meta(annotation)
					or compiler_typed_expr_contains_meta(value)
				)
			CompilerTypedBreakExpr(_, _):
				False
			CompilerTypedContinueExpr(_, _):
				False
			CompilerTypedVoidExpr(_, _):
				False
			CompilerTypedBuiltinExpr(_, _, _):
				False
			CompilerTypedMissingExpr(_, _):
				False
			CompilerTypedUnsupportedExpr(_, _, _):
				False


private pure func compiler_zonk_optional_type(
	context: CompilerContext,
	typ: Option[CompilerType],
) -> Option[CompilerType]:
	match typ:
		Some(value):
			Some(compiler_zonk_type(context, value))
		None:
			None


private pure func compiler_zonk_expr_type_origin(
	context: CompilerContext,
	origin: CompilerExprTypeOrigin,
) -> CompilerExprTypeOrigin:
	match origin:
		CompilerInferredOrigin:
			CompilerInferredOrigin
		CompilerExplicitAnnotationOrigin(typ):
			CompilerExplicitAnnotationOrigin(compiler_zonk_type(context, typ))
		CompilerSynthesizedOrigin(label):
			CompilerSynthesizedOrigin(label)


private pure func compiler_zonk_dim_constraint(
	context: CompilerContext,
	constraint: (CompilerType, CompilerType),
) -> (CompilerType, CompilerType):
	(compiler_zonk_type(context, constraint[0]), compiler_zonk_type(context, constraint[1]))


private pure func compiler_zonk_dim_constraints(
	context: CompilerContext,
	constraints: List[(CompilerType, CompilerType)],
) -> List[(CompilerType, CompilerType)]:
	constraints.map(func(constraint): compiler_zonk_dim_constraint(context, constraint))


private pure func compiler_zonk_types(
	context: CompilerContext,
	types: List[CompilerType],
) -> List[CompilerType]:
	types.map(func(typ): compiler_zonk_type(context, typ))


private pure func compiler_zonk_resolved_call_info(
	context: CompilerContext,
	info: CompilerResolvedCallInfo,
) -> CompilerResolvedCallInfo:
	{
		callee_name = info.callee_name,
		source_name = info.source_name,
		purity = info.purity,
		target = compiler_resolved_call_target_copy(info.target),
		instantiated_params = compiler_zonk_types(context, info.instantiated_params),
		instantiated_return = compiler_zonk_type(context, info.instantiated_return),
		resource_args = info.resource_args,
		dim_constraints = compiler_zonk_dim_constraints(context, info.dim_constraints),
		loop_producer = info.loop_producer
	}


private pure func compiler_zonk_optional_resolved_call_info(
	context: CompilerContext,
	info: Option[CompilerResolvedCallInfo],
) -> Option[CompilerResolvedCallInfo]:
	match info:
		Some(value):
			Some(compiler_zonk_resolved_call_info(context, value))
		None:
			empty: Option[CompilerResolvedCallInfo] = None
			empty


private pure func compiler_zonk_widening_decision(
	context: CompilerContext,
	decision: CompilerTypeWideningDecision,
) -> CompilerTypeWideningDecision:
	match decision:
		CompilerTypeKeep(typ):
			CompilerTypeKeep(compiler_zonk_type(context, typ))
		CompilerTypeWiden(from_type, to_type, reason):
			CompilerTypeWiden(
				compiler_zonk_type(context, from_type),
				compiler_zonk_type(context, to_type),
				reason,
			)


private pure func compiler_zonk_value_slot(
	context: CompilerContext,
	slot: CompilerValueSlot,
) -> CompilerValueSlot:
	{
		semantic_type = compiler_zonk_type(context, slot.semantic_type),
		decision = compiler_zonk_widening_decision(context, slot.decision)
	}


private pure func compiler_zonk_typed_expr_info(
	context: CompilerContext,
	info: CompilerTypedExprInfo,
) -> CompilerTypedExprInfo:
	{
		source_type = compiler_zonk_optional_type(context, info.source_type),
		semantic_type = compiler_zonk_type(context, info.semantic_type),
		value_type = compiler_zonk_type(context, info.value_type),
		origin = compiler_zonk_expr_type_origin(context, info.origin),
		value_slot = compiler_zonk_value_slot(context, info.value_slot),
		proofs = info.proofs,
		resolved_call = compiler_zonk_optional_resolved_call_info(context, info.resolved_call),
		resource_dependencies = info.resource_dependencies
	}


private pure func compiler_zonk_typed_var_decl_payload(
	context: CompilerContext,
	payload: CompilerTypedVarDeclPayload,
) -> CompilerTypedVarDeclPayload:
	{
		name = payload.name,
		annotation = compiler_zonk_optional_type(context, payload.annotation),
		initializer = compiler_zonk_typed_expr(context, payload.initializer),
		is_mutable = payload.is_mutable,
		span = payload.span
	}


private pure func compiler_zonk_typed_dict_entry(
	context: CompilerContext,
	entry: CompilerTypedDictEntry,
) -> CompilerTypedDictEntry:
	compiler_typed_dict_entry(
		compiler_zonk_typed_expr(context, entry.key),
		compiler_zonk_typed_expr(context, entry.value),
	)


private pure func compiler_zonk_typed_record_field(
	context: CompilerContext,
	field: CompilerTypedRecordField,
) -> CompilerTypedRecordField:
	{
		name = field.name,
		value = compiler_zonk_typed_expr(context, field.value),
		span = field.span
	}


private pure func compiler_zonk_typed_lambda_param(
	context: CompilerContext,
	param: CompilerTypedLambdaParam,
) -> CompilerTypedLambdaParam:
	{
		name = param.name,
		source_type = compiler_zonk_optional_type(context, param.source_type),
		param_type = compiler_zonk_type(context, param.param_type)
	}


private pure func compiler_zonk_typed_string_interpolation_part(
	context: CompilerContext,
	part: CompilerTypedStringInterpolationPart,
) -> CompilerTypedStringInterpolationPart:
	match part:
		CompilerTypedInterpolationLiteral(value):
			CompilerTypedInterpolationLiteral(value)
		CompilerTypedInterpolationExpr(expr):
			CompilerTypedInterpolationExpr(compiler_zonk_typed_expr(context, expr))


private pure func compiler_zonk_typed_pattern(
	context: CompilerContext,
	pattern: CompilerTypedPattern,
) -> CompilerTypedPattern:
	match pattern:
		CompilerTypedWildcardPattern(span):
			CompilerTypedWildcardPattern(span)
		CompilerTypedNamePattern(name, typ):
			CompilerTypedNamePattern(
				name,
				compiler_zonk_type(context, typ),
			)
		CompilerTypedBoolPattern(value, span):
			CompilerTypedBoolPattern(value, span)
		CompilerTypedIntPattern(value, span):
			CompilerTypedIntPattern(value, span)
		CompilerTypedFloatPattern(value, span):
			CompilerTypedFloatPattern(value, span)
		CompilerTypedStringPattern(value, span):
			CompilerTypedStringPattern(value, span)
		CompilerTypedCharPattern(value, span):
			CompilerTypedCharPattern(value, span)
		CompilerTypedConstructorPattern(name, fields, span):
			CompilerTypedConstructorPattern(
				name,
				fields.map(func(field): compiler_zonk_typed_pattern(context, field)),
				span,
			)
		CompilerTypedQualifiedConstructorPattern(module_name, name, fields, span):
			CompilerTypedQualifiedConstructorPattern(
				module_name,
				name,
				fields.map(func(field): compiler_zonk_typed_pattern(context, field)),
				span,
			)
		CompilerTypedTuplePattern(items, span):
			CompilerTypedTuplePattern(
				items.map(func(item): compiler_zonk_typed_pattern(context, item)),
				span,
			)
		CompilerTypedListPattern(items, spread, span):
			CompilerTypedListPattern(
				items.map(func(item): compiler_zonk_typed_pattern(context, item)),
				spread,
				span,
			)
		CompilerTypedOrPattern(items, span):
			CompilerTypedOrPattern(
				items.map(func(item): compiler_zonk_typed_pattern(context, item)),
				span,
			)
		CompilerTypedUnsupportedPattern(label, span):
			CompilerTypedUnsupportedPattern(label, span)


private pure func compiler_zonk_typed_match_case(
	context: CompilerContext,
	case: CompilerTypedMatchCase,
) -> CompilerTypedMatchCase:
	{
		pattern = compiler_zonk_typed_pattern(context, case.pattern),
		body = compiler_zonk_typed_expr(context, case.body),
		span = case.span
	}


private pure func compiler_zonk_typed_select_arm_kind(
	context: CompilerContext,
	kind: CompilerTypedSelectArmKind,
) -> CompilerTypedSelectArmKind:
	match kind:
		CompilerTypedSelectReceiveArm(name, channel_type, channel):
			CompilerTypedSelectReceiveArm(
				name,
				compiler_zonk_type(context, channel_type),
				compiler_zonk_typed_expr(context, channel),
			)
		CompilerTypedSelectSealedArm(channel_type, channel):
			CompilerTypedSelectSealedArm(
				compiler_zonk_type(context, channel_type),
				compiler_zonk_typed_expr(context, channel),
			)
		CompilerTypedSelectAfterArm(timeout):
			CompilerTypedSelectAfterArm(compiler_zonk_typed_expr(context, timeout))


private pure func compiler_zonk_typed_select_arm(
	context: CompilerContext,
	arm: CompilerTypedSelectArm,
) -> CompilerTypedSelectArm:
	{
		kind = compiler_zonk_typed_select_arm_kind(context, arm.kind),
		body = compiler_zonk_typed_expr(context, arm.body),
		span = arm.span
	}


private pure func compiler_zonk_typed_concurrent_param(
	context: CompilerContext,
	param: CompilerTypedConcurrentParam,
) -> CompilerTypedConcurrentParam:
	{
		name = param.name,
		value = compiler_zonk_typed_expr(context, param.value),
		span = param.span
	}


private pure func compiler_zonk_typed_concurrent_binding(
	context: CompilerContext,
	binding: CompilerTypedConcurrentBinding,
) -> CompilerTypedConcurrentBinding:
	{
		name = binding.name,
		annotation = compiler_zonk_optional_type(context, binding.annotation),
		value = compiler_zonk_typed_expr(context, binding.value),
		span = binding.span,
		info = compiler_zonk_typed_expr_info(context, binding.info)
	}


private pure func compiler_zonk_typed_with_error_map(
	context: CompilerContext,
	error_map: CompilerTypedWithErrorMap,
) -> CompilerTypedWithErrorMap:
	{
		name = error_map.name,
		value = compiler_zonk_typed_expr(context, error_map.value),
		span = error_map.span
	}


private pure func compiler_zonk_optional_typed_with_error_map(
	context: CompilerContext,
	error_map: Option[CompilerTypedWithErrorMap],
) -> Option[CompilerTypedWithErrorMap]:
	match error_map:
		Some(value):
			Some(compiler_zonk_typed_with_error_map(context, value))
		None:
			None


private pure func compiler_zonk_typed_with_binding(
	context: CompilerContext,
	binding: CompilerTypedWithBinding,
) -> CompilerTypedWithBinding:
	{
		name = binding.name,
		annotation = compiler_zonk_optional_type(context, binding.annotation),
		value = compiler_zonk_typed_expr(context, binding.value),
		kind = binding.kind,
		error_map = compiler_zonk_optional_typed_with_error_map(context, binding.error_map),
		cleanup_function = binding.cleanup_function,
		span = binding.span
	}


private pure func compiler_zonk_typed_loop_view(
	context: CompilerContext,
	view: CompilerTypedLoopView,
) -> CompilerTypedLoopView:
	match view:
		CompilerTypedIndicesLoopView(element_type):
			CompilerTypedIndicesLoopView(compiler_zonk_type(context, element_type))
		CompilerTypedEnumerateLoopView(element_type):
			CompilerTypedEnumerateLoopView(compiler_zonk_type(context, element_type))
		CompilerTypedEnumerate2LoopView(element_type):
			CompilerTypedEnumerate2LoopView(compiler_zonk_type(context, element_type))
		CompilerTypedWindowsLoopView(size, element_type):
			CompilerTypedWindowsLoopView(
				size,
				compiler_zonk_type(context, element_type),
			)


pure func compiler_zonk_typed_expr(
	context: CompilerContext,
	expr: CompilerTypedExpr,
) -> CompilerTypedExpr:
	info = compiler_zonk_typed_expr_info(context, compiler_typed_expr_info(expr))

	match expr:
		CompilerTypedNameExpr(name, _):
			CompilerTypedNameExpr(name, info)
		CompilerTypedIntLiteralExpr(text, span, _):
			CompilerTypedIntLiteralExpr(text, span, info)
		CompilerTypedFloatLiteralExpr(text, span, _):
			CompilerTypedFloatLiteralExpr(text, span, info)
		CompilerTypedStringLiteralExpr(text, span, _):
			CompilerTypedStringLiteralExpr(text, span, info)
		CompilerTypedStringInterpolationExpr(text, raw, span, _):
			CompilerTypedStringInterpolationExpr(text, raw, span, info)
		CompilerTypedStringInterpolationPartsExpr(parts, multiline, span, _):
			CompilerTypedStringInterpolationPartsExpr(
				parts.map(func(part): compiler_zonk_typed_string_interpolation_part(context, part)),
				multiline,
				span,
				info,
			)
		CompilerTypedBoolLiteralExpr(value, span, _):
			CompilerTypedBoolLiteralExpr(value, span, info)
		CompilerTypedCharLiteralExpr(value, span, _):
			CompilerTypedCharLiteralExpr(value, span, info)
		CompilerTypedUnaryExpr(op, inner, span, _):
			CompilerTypedUnaryExpr(
				op,
				compiler_zonk_typed_expr(context, inner),
				span,
				info,
			)
		CompilerTypedBinaryExpr(op, left, right, span, _):
			CompilerTypedBinaryExpr(
				op,
				compiler_zonk_typed_expr(context, left),
				compiler_zonk_typed_expr(context, right),
				span,
				info,
			)
		CompilerTypedLogicalExpr(op, left, right, span, _):
			CompilerTypedLogicalExpr(
				op,
				compiler_zonk_typed_expr(context, left),
				compiler_zonk_typed_expr(context, right),
				span,
				info,
			)
		CompilerTypedCallExpr(callee, args, span, _):
			CompilerTypedCallExpr(
				compiler_zonk_typed_expr(context, callee),
				args.map(func(arg): compiler_zonk_typed_expr(context, arg)),
				span,
				info,
			)
		CompilerTypedTupleExpr(items, span, _):
			CompilerTypedTupleExpr(
				items.map(func(item): compiler_zonk_typed_expr(context, item)),
				span,
				info,
			)
		CompilerTypedTupleDestructExpr(names, value, span, _):
			CompilerTypedTupleDestructExpr(
				names,
				compiler_zonk_typed_expr(context, value),
				span,
				info,
			)
		CompilerTypedAssignExpr(name, scope, value, span, _):
			CompilerTypedAssignExpr(
				name,
				scope,
				compiler_zonk_typed_expr(context, value),
				span,
				info,
			)
		CompilerTypedSubscriptExpr(receiver, indices, span, _):
			CompilerTypedSubscriptExpr(
				compiler_zonk_typed_expr(context, receiver),
				indices.map(func(index): compiler_zonk_typed_expr(context, index)),
				span,
				info,
			)
		CompilerTypedSubscriptAssignExpr(assign_target, receiver, indices, value, span, _):
			CompilerTypedSubscriptAssignExpr(
				assign_target,
				compiler_zonk_typed_expr(context, receiver),
				indices.map(func(index): compiler_zonk_typed_expr(context, index)),
				compiler_zonk_typed_expr(context, value),
				span,
				info,
			)
		CompilerTypedListExpr(items, span, _):
			CompilerTypedListExpr(
				items.map(func(item): compiler_zonk_typed_expr(context, item)),
				span,
				info,
			)
		CompilerTypedVectorExpr(items, span, _):
			CompilerTypedVectorExpr(
				items.map(func(item): compiler_zonk_typed_expr(context, item)),
				span,
				info,
			)
		CompilerTypedDictExpr(entries, span, _):
			CompilerTypedDictExpr(
				entries.map(func(entry): compiler_zonk_typed_dict_entry(context, entry)),
				span,
				info,
			)
		CompilerTypedOpaqueIntoExpr(source_type, inner, span, _):
			CompilerTypedOpaqueIntoExpr(
				compiler_zonk_type(context, source_type),
				compiler_zonk_typed_expr(context, inner),
				span,
				info,
			)
		CompilerTypedOpaqueFromExpr(source_type, inner, span, _):
			CompilerTypedOpaqueFromExpr(
				compiler_zonk_type(context, source_type),
				compiler_zonk_typed_expr(context, inner),
				span,
				info,
			)
		CompilerTypedRecordExpr(fields, span, _):
			CompilerTypedRecordExpr(
				fields.map(func(field): compiler_zonk_typed_record_field(context, field)),
				span,
				info,
			)
		CompilerTypedRecordUpdateExpr(receiver, fields, span, _):
			CompilerTypedRecordUpdateExpr(
				compiler_zonk_typed_expr(context, receiver),
				fields.map(func(field): compiler_zonk_typed_record_field(context, field)),
				span,
				info,
			)
		CompilerTypedFieldAccessExpr(receiver, field, span, _):
			CompilerTypedFieldAccessExpr(
				compiler_zonk_typed_expr(context, receiver),
				field,
				span,
				info,
			)
		CompilerTypedLambdaExpr(is_pure, params, return_annotation, body, span, _):
			CompilerTypedLambdaExpr(
				is_pure,
				params.map(func(param): compiler_zonk_typed_lambda_param(context, param)),
				compiler_zonk_optional_type(context, return_annotation),
				compiler_zonk_typed_expr(context, body),
				span,
				info,
			)
		CompilerTypedRangeExpr(start_expr, end_expr, span, _):
			CompilerTypedRangeExpr(
				compiler_zonk_typed_expr(context, start_expr),
				compiler_zonk_typed_expr(context, end_expr),
				span,
				info,
			)
		CompilerTypedIfExpr(condition, then_branch, else_branch, span, _):
			CompilerTypedIfExpr(
				compiler_zonk_typed_expr(context, condition),
				compiler_zonk_typed_expr(context, then_branch),
				else_branch.map(func(branch): compiler_zonk_typed_expr(context, branch)),
				span,
				info,
			)
		CompilerTypedMatchExpr(scrutinee, cases, span, _):
			CompilerTypedMatchExpr(
				compiler_zonk_typed_expr(context, scrutinee),
				cases.map(func(case): compiler_zonk_typed_match_case(context, case)),
				span,
				info,
			)
		CompilerTypedSelectExpr(arms, span, _):
			CompilerTypedSelectExpr(
				arms.map(func(arm): compiler_zonk_typed_select_arm(context, arm)),
				span,
				info,
			)
		CompilerTypedWhileExpr(condition, body, span, _):
			CompilerTypedWhileExpr(
				compiler_zonk_typed_expr(context, condition),
				compiler_zonk_typed_expr(context, body),
				span,
				info,
			)
		CompilerTypedForExpr(binder, iterable, loop_view, body, span, _):
			CompilerTypedForExpr(
				binder,
				compiler_zonk_typed_expr(context, iterable),
				loop_view.map(func(view): compiler_zonk_typed_loop_view(context, view)),
				compiler_zonk_typed_expr(context, body),
				span,
				info,
			)
		CompilerTypedConcurrentBlockExpr(params, bindings, span, _):
			CompilerTypedConcurrentBlockExpr(
				params.map(
					func(param): compiler_zonk_typed_concurrent_param(context, param),
				),
				bindings.map(func(binding):
					compiler_zonk_typed_concurrent_binding(context, binding)
				),
				span,
				info,
			)
		CompilerTypedConcurrentForExpr(name, iterable, params, body, span, _):
			CompilerTypedConcurrentForExpr(
				name,
				compiler_zonk_typed_expr(context, iterable),
				params.map(func(param): compiler_zonk_typed_concurrent_param(context, param)),
				compiler_zonk_typed_expr(context, body),
				span,
				info,
			)
		CompilerTypedDetachExpr(body, span, _):
			CompilerTypedDetachExpr(
				compiler_zonk_typed_expr(context, body),
				span,
				info,
			)
		CompilerTypedAscriptionExpr(inner, source_type, span, _):
			CompilerTypedAscriptionExpr(
				compiler_zonk_typed_expr(context, inner),
				compiler_zonk_type(context, source_type),
				span,
				info,
			)
		CompilerTypedBlockExpr(items, span, _):
			CompilerTypedBlockExpr(
				items.map(func(item): compiler_zonk_typed_expr(context, item)),
				span,
				info,
			)
		CompilerTypedWithExpr(binding, body, span, _):
			CompilerTypedWithExpr(
				compiler_zonk_typed_with_binding(context, binding),
				compiler_zonk_typed_expr(context, body),
				span,
				info,
			)
		CompilerTypedDebugBlockExpr(body, span, _):
			CompilerTypedDebugBlockExpr(
				compiler_zonk_typed_expr(context, body),
				span,
				info,
			)
		CompilerTypedVarDeclExpr(payload, _):
			CompilerTypedVarDeclExpr(
				compiler_zonk_typed_var_decl_payload(context, payload),
				info,
			)
		CompilerTypedQuestionBindExpr(name, annotation, value, span, _):
			CompilerTypedQuestionBindExpr(
				name,
				compiler_zonk_optional_type(context, annotation),
				compiler_zonk_typed_expr(context, value),
				span,
				info,
			)
		CompilerTypedBreakExpr(span, _):
			CompilerTypedBreakExpr(span, info)
		CompilerTypedContinueExpr(span, _):
			CompilerTypedContinueExpr(span, info)
		CompilerTypedVoidExpr(span, _):
			CompilerTypedVoidExpr(span, info)
		CompilerTypedBuiltinExpr(name, span, _):
			CompilerTypedBuiltinExpr(name, span, info)
		CompilerTypedMissingExpr(span, _):
			CompilerTypedMissingExpr(span, info)
		CompilerTypedUnsupportedExpr(label, span, _):
			CompilerTypedUnsupportedExpr(label, span, info)


pure func compiler_finalize_infer_result(result: CompilerInferResult) -> CompilerInferResult:
	{
		context = result.context,
		expr = compiler_zonk_typed_expr(result.context.state.context, result.expr)
	}


private pure func compiler_append_resource_refs(
	refs: List[String],
	extra: List[String],
) -> List[String]:
	var result = refs

	for name in extra:
		if not result.contains(name):
			result = result.append(name)

	result


private pure func compiler_resource_result_breaks_dependency(
	policy: CompilerResourceResultPolicy,
) -> Bool:
	match policy:
		CompilerResourceResultOrdinary:
			True
		CompilerResourceResultIndependent:
			True
		CompilerResourceResultDependent:
			False


private pure func compiler_call_result_breaks_resource_dependency(
	info: CompilerTypedExprInfo,
) -> Bool:
	match info.resolved_call:
		Some(call):
			match call.resource_args:
				CompilerAllowResourceArgs(policy):
					compiler_resource_result_breaks_dependency(policy)
				CompilerRejectResourceArgs:
					False
		None:
			False


private pure func compiler_typed_expr_list_resource_dependency_refs(
	context: CompilerInferContext,
	items: List[CompilerTypedExpr],
) -> List[String]:
	var result: List[String] = []

	for item in items:
		result = compiler_append_resource_refs(
			result,
			compiler_typed_expr_resource_dependency_refs(context, item),
		)

	result


private pure func compiler_typed_dict_entries_resource_dependency_refs(
	context: CompilerInferContext,
	entries: List[CompilerTypedDictEntry],
) -> List[String]:
	var result: List[String] = []

	for entry in entries:
		result = compiler_append_resource_refs(
			result,
			compiler_typed_expr_resource_dependency_refs(context, entry.key),
		)
		result = compiler_append_resource_refs(
			result,
			compiler_typed_expr_resource_dependency_refs(context, entry.value),
		)

	result


private pure func compiler_typed_record_fields_resource_dependency_refs(
	context: CompilerInferContext,
	fields: List[CompilerTypedRecordField],
) -> List[String]:
	var result: List[String] = []

	for field in fields:
		result = compiler_append_resource_refs(
			result,
			compiler_typed_expr_resource_dependency_refs(context, field.value),
		)

	result


private pure func compiler_typed_match_cases_resource_dependency_refs(
	context: CompilerInferContext,
	cases: List[CompilerTypedMatchCase],
) -> List[String]:
	var result: List[String] = []

	for case in cases:
		result = compiler_append_resource_refs(
			result,
			compiler_typed_expr_resource_dependency_refs(context, case.body),
		)

	result


private pure func compiler_typed_interpolation_parts_resource_dependency_refs(
	context: CompilerInferContext,
	parts: List[CompilerTypedStringInterpolationPart],
) -> List[String]:
	var result: List[String] = []

	for part in parts:
		match part:
			CompilerTypedInterpolationExpr(expr):
				result = compiler_append_resource_refs(
					result,
					compiler_typed_expr_resource_dependency_refs(context, expr),
				)
			CompilerTypedInterpolationLiteral(_):
				void

	result


private pure func compiler_typed_concurrent_bindings_resource_dependency_refs(
	context: CompilerInferContext,
	bindings: List[CompilerTypedConcurrentBinding],
) -> List[String]:
	var result: List[String] = []

	for binding in bindings:
		result = compiler_append_resource_refs(
			result,
			compiler_typed_expr_resource_dependency_refs(context, binding.value),
		)

	result


private pure func compiler_typed_block_result_expr(
	items: List[CompilerTypedExpr],
) -> Option[CompilerTypedExpr]:
	if items.length() == 0:
		None
	else:
		items.get(items.length() - 1)


private pure func compiler_typed_expr_resource_dependency_refs(
	context: CompilerInferContext,
	expr: CompilerTypedExpr,
) -> List[String]:
	match expr:
		CompilerTypedNameExpr(name, info):
			if info.resource_dependencies.length() > 0:
				info.resource_dependencies
			else if compiler_env_is_scoped_resource_related_var(context.state.env, name.text):
				[name.text]
			else:
				[]
		CompilerTypedUnaryExpr(_, inner, _, _):
			compiler_typed_expr_resource_dependency_refs(context, inner)
		CompilerTypedBinaryExpr(_, left, right, _, _):
			compiler_append_resource_refs(
				compiler_typed_expr_resource_dependency_refs(context, left),
				compiler_typed_expr_resource_dependency_refs(context, right),
			)
		CompilerTypedLogicalExpr(_, left, right, _, _):
			compiler_append_resource_refs(
				compiler_typed_expr_resource_dependency_refs(context, left),
				compiler_typed_expr_resource_dependency_refs(context, right),
			)
		CompilerTypedCallExpr(callee, args, _, info):
			if compiler_call_result_breaks_resource_dependency(info):
				[]
			else:
				compiler_append_resource_refs(
					compiler_typed_expr_resource_dependency_refs(context, callee),
					compiler_typed_expr_list_resource_dependency_refs(context, args),
				)
		CompilerTypedTupleExpr(items, _, _):
			compiler_typed_expr_list_resource_dependency_refs(context, items)
		CompilerTypedSubscriptExpr(receiver, indices, _, _):
			compiler_append_resource_refs(
				compiler_typed_expr_resource_dependency_refs(context, receiver),
				compiler_typed_expr_list_resource_dependency_refs(context, indices),
			)
		CompilerTypedListExpr(items, _, _):
			compiler_typed_expr_list_resource_dependency_refs(context, items)
		CompilerTypedVectorExpr(items, _, _):
			compiler_typed_expr_list_resource_dependency_refs(context, items)
		CompilerTypedDictExpr(entries, _, _):
			compiler_typed_dict_entries_resource_dependency_refs(context, entries)
		CompilerTypedOpaqueIntoExpr(_, inner, _, _):
			compiler_typed_expr_resource_dependency_refs(context, inner)
		CompilerTypedOpaqueFromExpr(_, inner, _, _):
			compiler_typed_expr_resource_dependency_refs(context, inner)
		CompilerTypedRecordExpr(fields, _, _):
			compiler_typed_record_fields_resource_dependency_refs(context, fields)
		CompilerTypedRecordUpdateExpr(base, fields, _, _):
			compiler_append_resource_refs(
				compiler_typed_expr_resource_dependency_refs(context, base),
				compiler_typed_record_fields_resource_dependency_refs(context, fields),
			)
		CompilerTypedFieldAccessExpr(receiver, _, _, _):
			compiler_typed_expr_resource_dependency_refs(context, receiver)
		CompilerTypedRangeExpr(start_expr, end_expr, _, _):
			compiler_append_resource_refs(
				compiler_typed_expr_resource_dependency_refs(context, start_expr),
				compiler_typed_expr_resource_dependency_refs(context, end_expr),
			)
		CompilerTypedIfExpr(condition, then_branch, else_branch, _, _):
			with_then = compiler_append_resource_refs(
				compiler_typed_expr_resource_dependency_refs(context, condition),
				compiler_typed_expr_resource_dependency_refs(context, then_branch),
			)

			match else_branch:
				Some(branch):
					compiler_append_resource_refs(
						with_then,
						compiler_typed_expr_resource_dependency_refs(context, branch),
					)
				None:
					with_then
		CompilerTypedMatchExpr(scrutinee, cases, _, _):
			compiler_append_resource_refs(
				compiler_typed_expr_resource_dependency_refs(context, scrutinee),
				compiler_typed_match_cases_resource_dependency_refs(context, cases),
			)
		CompilerTypedAscriptionExpr(inner, _, _, _):
			compiler_typed_expr_resource_dependency_refs(context, inner)
		CompilerTypedBlockExpr(items, _, _):
			match compiler_typed_block_result_expr(items):
				Some(result_expr):
					compiler_typed_expr_resource_dependency_refs(context, result_expr)
				None:
					[]
		CompilerTypedConcurrentBlockExpr(_, bindings, _, _):
			compiler_typed_concurrent_bindings_resource_dependency_refs(context, bindings)
		CompilerTypedWithExpr(_, body, _, _):
			compiler_typed_expr_resource_dependency_refs(context, body)
		CompilerTypedStringInterpolationPartsExpr(parts, _, _, _):
			compiler_typed_interpolation_parts_resource_dependency_refs(context, parts)
		_:
			[]


private pure func compiler_expr_derives_from_scoped_resource(
	context: CompilerInferContext,
	expr: CompilerTypedExpr,
) -> Bool:
	compiler_typed_expr_resource_dependency_refs(context, expr).length() > 0


private pure func compiler_binding_origin_for_initializer(
	context: CompilerInferContext,
	initializer: CompilerTypedExpr,
) -> CompilerVarOrigin:
	if compiler_expr_derives_from_scoped_resource(context, initializer):
		CompilerScopedResourceDerived
	else:
		CompilerLetBinding


private pure func compiler_copy_diagnostic_name(name: String) -> String:
	name.substring(0, name.length())


private pure func compiler_append_impure_call_names(
	names: List[String],
	extra: List[String],
) -> List[String]:
	var result = names

	for name in extra:
		result = result.append(name)

	result


private pure func compiler_typed_expr_list_impure_call_names(
	exprs: List[CompilerTypedExpr],
) -> List[String]:
	var result: List[String] = []

	for expr in exprs:
		result = compiler_append_impure_call_names(
			result,
			compiler_typed_expr_impure_call_names(expr),
		)

	result


private pure func compiler_typed_dict_entries_impure_call_names(
	entries: List[CompilerTypedDictEntry],
) -> List[String]:
	var result: List[String] = []

	for entry in entries:
		result = compiler_append_impure_call_names(
			result,
			compiler_typed_expr_impure_call_names(entry.key),
		)
		result = compiler_append_impure_call_names(
			result,
			compiler_typed_expr_impure_call_names(entry.value),
		)

	result


private pure func compiler_typed_record_fields_impure_call_names(
	fields: List[CompilerTypedRecordField],
) -> List[String]:
	var result: List[String] = []

	for field in fields:
		result = compiler_append_impure_call_names(
			result,
			compiler_typed_expr_impure_call_names(field.value),
		)

	result


private pure func compiler_typed_concurrent_params_impure_call_names(
	params: List[CompilerTypedConcurrentParam],
) -> List[String]:
	var result: List[String] = []

	for param in params:
		result = compiler_append_impure_call_names(
			result,
			compiler_typed_expr_impure_call_names(param.value),
		)

	result


private pure func compiler_typed_concurrent_bindings_impure_call_names(
	bindings: List[CompilerTypedConcurrentBinding],
) -> List[String]:
	var result: List[String] = []

	for binding in bindings:
		result = compiler_append_impure_call_names(
			result,
			compiler_typed_expr_impure_call_names(binding.value),
		)

	result


private pure func compiler_typed_with_binding_impure_call_names(
	binding: CompilerTypedWithBinding,
) -> List[String]:
	result = compiler_typed_expr_impure_call_names(binding.value)

	match binding.error_map:
		Some(mapper):
			compiler_append_impure_call_names(
				result,
				compiler_typed_expr_impure_call_names(mapper.value),
			)
		None:
			result


private pure func compiler_typed_interpolation_parts_impure_call_names(
	parts: List[CompilerTypedStringInterpolationPart],
) -> List[String]:
	var result: List[String] = []

	for part in parts:
		match part:
			CompilerTypedInterpolationLiteral(_):
				void
			CompilerTypedInterpolationExpr(expr):
				result = compiler_append_impure_call_names(
					result,
					compiler_typed_expr_impure_call_names(expr),
				)

	result


private pure func compiler_typed_match_cases_impure_call_names(
	cases: List[CompilerTypedMatchCase],
) -> List[String]:
	var result: List[String] = []

	for case in cases:
		result = compiler_append_impure_call_names(
			result,
			compiler_typed_expr_impure_call_names(case.body),
		)

	result


private pure func compiler_typed_select_arm_kind_impure_call_names(
	kind: CompilerTypedSelectArmKind,
) -> List[String]:
	match kind:
		CompilerTypedSelectReceiveArm(_, _, channel):
			compiler_typed_expr_impure_call_names(channel)
		CompilerTypedSelectSealedArm(_, channel):
			compiler_typed_expr_impure_call_names(channel)
		CompilerTypedSelectAfterArm(timeout):
			compiler_typed_expr_impure_call_names(timeout)


private pure func compiler_typed_select_arms_impure_call_names(
	arms: List[CompilerTypedSelectArm],
) -> List[String]:
	var result: List[String] = []

	for arm in arms:
		result = compiler_append_impure_call_names(
			result,
			compiler_typed_select_arm_kind_impure_call_names(arm.kind),
		)
		result = compiler_append_impure_call_names(
			result,
			compiler_typed_expr_impure_call_names(arm.body),
		)

	result


private pure func compiler_call_expr_impure_call_name(info: CompilerTypedExprInfo) -> List[String]:
	match info.resolved_call:
		Some(call):
			if compiler_purities_equal(call.purity, CompilerImpure):
				[compiler_copy_diagnostic_name(call.callee_name)]
			else:
				[]
		None:
			[]


pure func compiler_typed_expr_impure_call_names(expr: CompilerTypedExpr) -> List[String]:
	match expr:
		CompilerTypedUnaryExpr(_, inner, _, _):
			compiler_typed_expr_impure_call_names(inner)
		CompilerTypedBinaryExpr(_, left, right, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_impure_call_names(left),
				compiler_typed_expr_impure_call_names(right),
			)
		CompilerTypedLogicalExpr(_, left, right, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_impure_call_names(left),
				compiler_typed_expr_impure_call_names(right),
			)
		CompilerTypedCallExpr(callee, args, _, info):
			with_callee = compiler_append_impure_call_names(
				compiler_typed_expr_impure_call_names(callee),
				compiler_typed_expr_list_impure_call_names(args),
			)
			compiler_append_impure_call_names(
				with_callee,
				compiler_call_expr_impure_call_name(info),
			)
		CompilerTypedTupleExpr(items, _, _):
			compiler_typed_expr_list_impure_call_names(items)
		CompilerTypedTupleDestructExpr(_, value, _, _):
			compiler_typed_expr_impure_call_names(value)
		CompilerTypedAssignExpr(_, _, value, _, _):
			compiler_typed_expr_impure_call_names(value)
		CompilerTypedSubscriptExpr(receiver, indices, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_impure_call_names(receiver),
				compiler_typed_expr_list_impure_call_names(indices),
			)
		CompilerTypedSubscriptAssignExpr(_, receiver, indices, value, _, _):
			with_indices = compiler_append_impure_call_names(
				compiler_typed_expr_impure_call_names(receiver),
				compiler_typed_expr_list_impure_call_names(indices),
			)
			compiler_append_impure_call_names(
				with_indices,
				compiler_typed_expr_impure_call_names(value),
			)
		CompilerTypedListExpr(items, _, _):
			compiler_typed_expr_list_impure_call_names(items)
		CompilerTypedVectorExpr(items, _, _):
			compiler_typed_expr_list_impure_call_names(items)
		CompilerTypedDictExpr(entries, _, _):
			compiler_typed_dict_entries_impure_call_names(entries)
		CompilerTypedRecordExpr(fields, _, _):
			compiler_typed_record_fields_impure_call_names(fields)
		CompilerTypedRecordUpdateExpr(base, fields, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_impure_call_names(base),
				compiler_typed_record_fields_impure_call_names(fields),
			)
		CompilerTypedFieldAccessExpr(receiver, _, _, _):
			compiler_typed_expr_impure_call_names(receiver)
		CompilerTypedLambdaExpr(is_pure, _, _, body, _, _):
			if is_pure:
				compiler_typed_expr_impure_call_names(body)
			else:
				[]
		CompilerTypedRangeExpr(start_expr, end_expr, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_impure_call_names(start_expr),
				compiler_typed_expr_impure_call_names(end_expr),
			)
		CompilerTypedIfExpr(condition, then_branch, else_branch, _, _):
			with_then = compiler_append_impure_call_names(
				compiler_typed_expr_impure_call_names(condition),
				compiler_typed_expr_impure_call_names(then_branch),
			)

			match else_branch:
				Some(branch):
					compiler_append_impure_call_names(
						with_then,
						compiler_typed_expr_impure_call_names(branch),
					)
				None:
					with_then
		CompilerTypedMatchExpr(scrutinee, cases, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_impure_call_names(scrutinee),
				compiler_typed_match_cases_impure_call_names(cases),
			)
		CompilerTypedSelectExpr(arms, _, _):
			compiler_append_impure_call_names(
				["select"],
				compiler_typed_select_arms_impure_call_names(arms),
			)
		CompilerTypedWhileExpr(condition, body, _, _):
			compiler_append_impure_call_names(
				compiler_typed_expr_impure_call_names(condition),
				compiler_typed_expr_impure_call_names(body),
			)
		CompilerTypedForExpr(_, iterable, _, body, _, _):
			with_iterable = compiler_append_impure_call_names(
				compiler_for_iterable_impure_call_name(iterable),
				compiler_typed_expr_impure_call_names(iterable),
			)
			compiler_append_impure_call_names(
				with_iterable,
				compiler_typed_expr_impure_call_names(body),
			)
		CompilerTypedConcurrentBlockExpr(params, bindings, _, _):
			compiler_append_impure_call_names(
				["concurrent"],
				compiler_append_impure_call_names(
					compiler_typed_concurrent_params_impure_call_names(params),
					compiler_typed_concurrent_bindings_impure_call_names(bindings),
				),
			)
		CompilerTypedConcurrentForExpr(_, iterable, params, body, _, _):
			with_iterable = compiler_append_impure_call_names(
				["for ... concurrently"],
				compiler_typed_expr_impure_call_names(iterable),
			)
			with_params = compiler_append_impure_call_names(
				with_iterable,
				compiler_typed_concurrent_params_impure_call_names(params),
			)
			compiler_append_impure_call_names(
				with_params,
				compiler_typed_expr_impure_call_names(body),
			)
		CompilerTypedDetachExpr(body, _, _):
			compiler_append_impure_call_names(
				["detach"],
				compiler_typed_expr_impure_call_names(body),
			)
		CompilerTypedAscriptionExpr(inner, _, _, _):
			compiler_typed_expr_impure_call_names(inner)
		CompilerTypedOpaqueIntoExpr(_, inner, _, _):
			compiler_typed_expr_impure_call_names(inner)
		CompilerTypedOpaqueFromExpr(_, inner, _, _):
			compiler_typed_expr_impure_call_names(inner)
		CompilerTypedBlockExpr(items, _, _):
			compiler_typed_expr_list_impure_call_names(items)
		CompilerTypedWithExpr(binding, body, _, _):
			compiler_append_impure_call_names(
				compiler_typed_with_binding_impure_call_names(binding),
				compiler_typed_expr_impure_call_names(body),
			)
		CompilerTypedDebugBlockExpr(body, _, _):
			compiler_typed_expr_impure_call_names(body)
		CompilerTypedVarDeclExpr(payload, _):
			compiler_typed_expr_impure_call_names(payload.initializer)
		CompilerTypedQuestionBindExpr(_, _, value, _, _):
			compiler_typed_expr_impure_call_names(value)
		CompilerTypedStringInterpolationPartsExpr(parts, _, _, _):
			compiler_typed_interpolation_parts_impure_call_names(parts)
		_:
			[]


private pure func compiler_append_module_assign_names(
	names: List[String],
	extra: List[String],
) -> List[String]:
	var result = names

	for name in extra:
		result = result.append(name)

	result


private pure func compiler_typed_expr_list_module_assign_names(
	exprs: List[CompilerTypedExpr],
) -> List[String]:
	var result: List[String] = []

	for expr in exprs:
		result = compiler_append_module_assign_names(
			result,
			compiler_typed_expr_module_assign_names(expr),
		)

	result


private pure func compiler_typed_dict_entries_module_assign_names(
	entries: List[CompilerTypedDictEntry],
) -> List[String]:
	var result: List[String] = []

	for entry in entries:
		result = compiler_append_module_assign_names(
			result,
			compiler_typed_expr_module_assign_names(entry.key),
		)
		result = compiler_append_module_assign_names(
			result,
			compiler_typed_expr_module_assign_names(entry.value),
		)

	result


private pure func compiler_typed_record_fields_module_assign_names(
	fields: List[CompilerTypedRecordField],
) -> List[String]:
	var result: List[String] = []

	for field in fields:
		result = compiler_append_module_assign_names(
			result,
			compiler_typed_expr_module_assign_names(field.value),
		)

	result


private pure func compiler_typed_concurrent_params_module_assign_names(
	params: List[CompilerTypedConcurrentParam],
) -> List[String]:
	var result: List[String] = []

	for param in params:
		result = compiler_append_module_assign_names(
			result,
			compiler_typed_expr_module_assign_names(param.value),
		)

	result


private pure func compiler_typed_concurrent_bindings_module_assign_names(
	bindings: List[CompilerTypedConcurrentBinding],
) -> List[String]:
	var result: List[String] = []

	for binding in bindings:
		result = compiler_append_module_assign_names(
			result,
			compiler_typed_expr_module_assign_names(binding.value),
		)

	result


private pure func compiler_typed_with_binding_module_assign_names(
	binding: CompilerTypedWithBinding,
) -> List[String]:
	result = compiler_typed_expr_module_assign_names(binding.value)

	match binding.error_map:
		Some(mapper):
			compiler_append_module_assign_names(
				result,
				compiler_typed_expr_module_assign_names(mapper.value),
			)
		None:
			result


private pure func compiler_typed_interpolation_parts_module_assign_names(
	parts: List[CompilerTypedStringInterpolationPart],
) -> List[String]:
	var result: List[String] = []

	for part in parts:
		match part:
			CompilerTypedInterpolationLiteral(_):
				void
			CompilerTypedInterpolationExpr(expr):
				result = compiler_append_module_assign_names(
					result,
					compiler_typed_expr_module_assign_names(expr),
				)

	result


private pure func compiler_typed_match_cases_module_assign_names(
	cases: List[CompilerTypedMatchCase],
) -> List[String]:
	var result: List[String] = []

	for case in cases:
		result = compiler_append_module_assign_names(
			result,
			compiler_typed_expr_module_assign_names(case.body),
		)

	result


private pure func compiler_typed_select_arm_kind_module_assign_names(
	kind: CompilerTypedSelectArmKind,
) -> List[String]:
	match kind:
		CompilerTypedSelectReceiveArm(_, _, channel):
			compiler_typed_expr_module_assign_names(channel)
		CompilerTypedSelectSealedArm(_, channel):
			compiler_typed_expr_module_assign_names(channel)
		CompilerTypedSelectAfterArm(timeout):
			compiler_typed_expr_module_assign_names(timeout)


private pure func compiler_typed_select_arms_module_assign_names(
	arms: List[CompilerTypedSelectArm],
) -> List[String]:
	var result: List[String] = []

	for arm in arms:
		result = compiler_append_module_assign_names(
			result,
			compiler_typed_select_arm_kind_module_assign_names(arm.kind),
		)
		result = compiler_append_module_assign_names(
			result,
			compiler_typed_expr_module_assign_names(arm.body),
		)

	result


pure func compiler_typed_expr_module_assign_names(expr: CompilerTypedExpr) -> List[String]:
	match expr:
		CompilerTypedUnaryExpr(_, inner, _, _):
			compiler_typed_expr_module_assign_names(inner)
		CompilerTypedBinaryExpr(_, left, right, _, _):
			compiler_append_module_assign_names(
				compiler_typed_expr_module_assign_names(left),
				compiler_typed_expr_module_assign_names(right),
			)
		CompilerTypedLogicalExpr(_, left, right, _, _):
			compiler_append_module_assign_names(
				compiler_typed_expr_module_assign_names(left),
				compiler_typed_expr_module_assign_names(right),
			)
		CompilerTypedCallExpr(callee, args, _, _):
			compiler_append_module_assign_names(
				compiler_typed_expr_module_assign_names(callee),
				compiler_typed_expr_list_module_assign_names(args),
			)
		CompilerTypedTupleExpr(items, _, _):
			compiler_typed_expr_list_module_assign_names(items)
		CompilerTypedTupleDestructExpr(_, value, _, _):
			compiler_typed_expr_module_assign_names(value)
		CompilerTypedAssignExpr(name, scope, value, _, _):
			value_names = compiler_typed_expr_module_assign_names(value)

			match scope:
				CompilerModuleAssignScope:
					compiler_append_module_assign_names(
						value_names,
						[compiler_copy_diagnostic_name(name.text)],
					)
				CompilerLocalAssignScope:
					value_names
		CompilerTypedSubscriptExpr(receiver, indices, _, _):
			compiler_append_module_assign_names(
				compiler_typed_expr_module_assign_names(receiver),
				compiler_typed_expr_list_module_assign_names(indices),
			)
		CompilerTypedSubscriptAssignExpr(assign_target, receiver, indices, value, _, _):
			with_indices = compiler_append_module_assign_names(
				compiler_typed_expr_module_assign_names(receiver),
				compiler_typed_expr_list_module_assign_names(indices),
			)
			value_names = compiler_append_module_assign_names(
				with_indices,
				compiler_typed_expr_module_assign_names(value),
			)

			match assign_target:
				Some(target):
					match target.scope:
						CompilerModuleAssignScope:
							compiler_append_module_assign_names(
								value_names,
								[compiler_copy_diagnostic_name(target.name)],
							)
						CompilerLocalAssignScope:
							value_names
				None:
					value_names
		CompilerTypedListExpr(items, _, _):
			compiler_typed_expr_list_module_assign_names(items)
		CompilerTypedVectorExpr(items, _, _):
			compiler_typed_expr_list_module_assign_names(items)
		CompilerTypedDictExpr(entries, _, _):
			compiler_typed_dict_entries_module_assign_names(entries)
		CompilerTypedRecordExpr(fields, _, _):
			compiler_typed_record_fields_module_assign_names(fields)
		CompilerTypedRecordUpdateExpr(base, fields, _, _):
			compiler_append_module_assign_names(
				compiler_typed_expr_module_assign_names(base),
				compiler_typed_record_fields_module_assign_names(fields),
			)
		CompilerTypedFieldAccessExpr(receiver, _, _, _):
			compiler_typed_expr_module_assign_names(receiver)
		CompilerTypedLambdaExpr(is_pure, _, _, body, _, _):
			if is_pure:
				compiler_typed_expr_module_assign_names(body)
			else:
				[]
		CompilerTypedRangeExpr(start_expr, end_expr, _, _):
			compiler_append_module_assign_names(
				compiler_typed_expr_module_assign_names(start_expr),
				compiler_typed_expr_module_assign_names(end_expr),
			)
		CompilerTypedIfExpr(condition, then_branch, else_branch, _, _):
			with_then = compiler_append_module_assign_names(
				compiler_typed_expr_module_assign_names(condition),
				compiler_typed_expr_module_assign_names(then_branch),
			)

			match else_branch:
				Some(branch):
					compiler_append_module_assign_names(
						with_then,
						compiler_typed_expr_module_assign_names(branch),
					)
				None:
					with_then
		CompilerTypedMatchExpr(scrutinee, cases, _, _):
			compiler_append_module_assign_names(
				compiler_typed_expr_module_assign_names(scrutinee),
				compiler_typed_match_cases_module_assign_names(cases),
			)
		CompilerTypedSelectExpr(arms, _, _):
			compiler_typed_select_arms_module_assign_names(arms)
		CompilerTypedWhileExpr(condition, body, _, _):
			compiler_append_module_assign_names(
				compiler_typed_expr_module_assign_names(condition),
				compiler_typed_expr_module_assign_names(body),
			)
		CompilerTypedForExpr(_, iterable, _, body, _, _):
			compiler_append_module_assign_names(
				compiler_typed_expr_module_assign_names(iterable),
				compiler_typed_expr_module_assign_names(body),
			)
		CompilerTypedConcurrentBlockExpr(params, bindings, _, _):
			compiler_append_module_assign_names(
				compiler_typed_concurrent_params_module_assign_names(params),
				compiler_typed_concurrent_bindings_module_assign_names(bindings),
			)
		CompilerTypedConcurrentForExpr(_, iterable, params, body, _, _):
			with_iterable = compiler_typed_expr_module_assign_names(iterable)
			with_params = compiler_append_module_assign_names(
				with_iterable,
				compiler_typed_concurrent_params_module_assign_names(params),
			)
			compiler_append_module_assign_names(
				with_params,
				compiler_typed_expr_module_assign_names(body),
			)
		CompilerTypedDetachExpr(body, _, _):
			compiler_typed_expr_module_assign_names(body)
		CompilerTypedAscriptionExpr(inner, _, _, _):
			compiler_typed_expr_module_assign_names(inner)
		CompilerTypedOpaqueIntoExpr(_, inner, _, _):
			compiler_typed_expr_module_assign_names(inner)
		CompilerTypedOpaqueFromExpr(_, inner, _, _):
			compiler_typed_expr_module_assign_names(inner)
		CompilerTypedBlockExpr(items, _, _):
			compiler_typed_expr_list_module_assign_names(items)
		CompilerTypedWithExpr(binding, body, _, _):
			compiler_append_module_assign_names(
				compiler_typed_with_binding_module_assign_names(binding),
				compiler_typed_expr_module_assign_names(body),
			)
		CompilerTypedDebugBlockExpr(body, _, _):
			compiler_typed_expr_module_assign_names(body)
		CompilerTypedVarDeclExpr(payload, _):
			compiler_typed_expr_module_assign_names(payload.initializer)
		CompilerTypedQuestionBindExpr(_, _, value, _, _):
			compiler_typed_expr_module_assign_names(value)
		CompilerTypedStringInterpolationPartsExpr(parts, _, _, _):
			compiler_typed_interpolation_parts_module_assign_names(parts)
		_:
			[]


