private pure func compiler_typed_select_arm_kind_type_error(
	kind: CompilerTypedSelectArmKind,
) -> Option[String]:
	match kind:
		CompilerTypedSelectReceiveArm(_, _, channel):
			compiler_typed_expr_type_error(channel)
		CompilerTypedSelectSealedArm(_, channel):
			compiler_typed_expr_type_error(channel)
		CompilerTypedSelectAfterArm(timeout):
			compiler_typed_expr_type_error(timeout)


private pure func compiler_typed_select_arm_type_error(
	arm: CompilerTypedSelectArm,
) -> Option[String]:
	match compiler_typed_select_arm_kind_type_error(arm.kind):
		Some(message):
			Some(message)
		None:
			compiler_typed_expr_type_error(arm.body)


