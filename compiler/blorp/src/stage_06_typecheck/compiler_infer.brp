	for binding in bindings:
		result = compiler_append_impure_call_names(
			result,
			compiler_typed_expr_debug_block_impure_call_names(binding.value),
		)

	result


private pure func compiler_typed_with_binding_debug_block_impure_call_names(
	binding: CompilerTypedWithBinding,
) -> List[String]:
	result = compiler_typed_expr_debug_block_impure_call_names(binding.value)

	match binding.error_map:
		Some(mapper):
			compiler_append_impure_call_names(
				result,
				compiler_typed_expr_debug_block_impure_call_names(mapper.value),
			)
		None:
			result


private pure func compiler_typed_match_cases_debug_block_impure_call_names(
	cases: List[CompilerTypedMatchCase],
