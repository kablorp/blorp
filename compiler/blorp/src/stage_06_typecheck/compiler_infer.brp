		_:
			CompilerTypeKeep(compiler_type_void())


private pure func compiler_typed_record_field_widening(
	fields: List[CompilerTypedRecordField],
	field_name: String,
) -> CompilerTypeWideningDecision:
	var result: CompilerTypeWideningDecision = CompilerTypeKeep(compiler_type_void())
	var index: Int = 0
	var found: Bool = False

	while index < fields.length() and not found:
		match fields.get(index):
			Some(field):
				if field.name.text == field_name:
					result = compiler_typed_expr_widening(field.value)
					found = True
			None:
				void

		index += 1

	result


pure func compiler_typed_expr_record_field_widening(
	expr: CompilerTypedExpr,
	field_name: String,
) -> CompilerTypeWideningDecision:
	match expr:
		CompilerTypedRecordExpr(fields, _, _):
			compiler_typed_record_field_widening(fields, field_name)
		CompilerTypedRecordUpdateExpr(_, fields, _, _):
			compiler_typed_record_field_widening(fields, field_name)
		_:
			CompilerTypeKeep(compiler_type_void())


pure func compiler_typed_expr_field_access_receiver_type(
	expr: CompilerTypedExpr,
) -> Option[CompilerType]:
	match expr:
		CompilerTypedFieldAccessExpr(receiver, _, _, _):
			Some(compiler_typed_expr_semantic_type(receiver))
		_:
			None


private pure func compiler_infer_result(
	context: CompilerInferContext,
	expr: CompilerTypedExpr,
) -> CompilerInferResult:
	{
		context = context,
		expr = expr
	}


private pure func compiler_infer_error(
	context: CompilerInferContext,
	message: String,
) -> CompilerInferContext:
	compiler_infer_context_with_state(
		context,
		compiler_typecheck_state_add_error(context.state, message),
	)


private pure func compiler_checked_type(
	context: CompilerInferContext,
	typ: CompilerType,
) -> CompilerCheckedType:
	{
		context = compiler_infer_context_copy(context),
		typ = compiler_type_copy(typ)
	}


private pure func compiler_binary_op_symbol(op: ParsedBinaryOp) -> String:
	match op:
		ParsedAddOp:
			"+"
		ParsedSubtractOp:
			"-"
		ParsedMultiplyOp:
			"*"
		ParsedDivideOp:
			"/"
		ParsedModuloOp:
			"%"
		ParsedEqualOp:
			"=="
		ParsedNotEqualOp:
			"!="
		ParsedLessOp:
			"<"
		ParsedLessEqualOp:
			"<="
		ParsedGreaterOp:
			">"
		ParsedGreaterEqualOp:
			">="


private pure func compiler_is_arithmetic_binary_op(op: ParsedBinaryOp) -> Bool:
	match op:
		ParsedAddOp:
			True
		ParsedSubtractOp:
			True
		ParsedMultiplyOp:
			True
		ParsedDivideOp:
			True
		ParsedModuloOp:
			True
		_:
			False


private pure func compiler_is_comparison_binary_op(op: ParsedBinaryOp) -> Bool:
	match op:
		ParsedLessOp:
			True
		ParsedLessEqualOp:
			True
		ParsedGreaterOp:
			True
		ParsedGreaterEqualOp:
			True
		_:
			False


private pure func compiler_is_equality_binary_op(op: ParsedBinaryOp) -> Bool:
	match op:
		ParsedEqualOp:
			True
		ParsedNotEqualOp:
			True
		_:
			False


private pure func compiler_is_add_binary_op(op: ParsedBinaryOp) -> Bool:
	match op:
		ParsedAddOp:
			True
		_:
			False


private pure func compiler_is_modulo_binary_op(op: ParsedBinaryOp) -> Bool:
	match op:
		ParsedModuloOp:
			True
		_:
			False


private pure func compiler_arithmetic_trait_name(op: ParsedBinaryOp) -> String:
	match op:
		ParsedAddOp:
			"Addable"
		ParsedSubtractOp:
			"Subtractable"
		ParsedMultiplyOp:
			"Multipliable"
		ParsedDivideOp:
			"Divisible"
		ParsedModuloOp:
			"Modulable"
		_:
			"Addable"


private pure func compiler_named_value_type_is(typ: CompilerType, name: String) -> Bool:
	match typ:
		CompilerNamedType(type_name, args):
			type_name == name and args.length() == 0
		_:
			False


private pure func compiler_named_type_head_is(typ: CompilerType, name: String) -> Bool:
	match typ:
		CompilerNamedType(type_name, _):
			type_name == name
		_:
			False


private pure func compiler_is_fixed_type(typ: CompilerType) -> Bool:
	compiler_named_value_type_is(typ, "Fixed")


private pure func compiler_is_orderable_primitive_type(typ: CompilerType) -> Bool:
	(
		compiler_named_value_type_is(typ, "Int")
		or compiler_named_value_type_is(typ, "Float")
		or compiler_named_value_type_is(typ, "String")
		or compiler_named_value_type_is(typ, "Char")
		or compiler_is_fixed_type(typ)
		or compiler_is_any_float_type(typ)
		or compiler_is_any_integer_type(typ)
	)


private pure func compiler_is_equality_primitive_type(typ: CompilerType) -> Bool:
	compiler_is_orderable_primitive_type(typ) or compiler_named_value_type_is(typ, "Bool")


private pure func compiler_is_enum_value_type(
	context: CompilerInferContext,
	typ: CompilerType,
) -> Bool:
	match typ:
		CompilerNamedType(name, args):
			if args.length() != 0:
				False
			else:
				match compiler_env_get_type_kind(context.state.env, name):
					Some(kind):
						kind == CompilerTypeEnum
					None:
						False
		_:
			False


private pure func compiler_is_primitive_value_type(typ: CompilerType) -> Bool:
	(
		compiler_is_equality_primitive_type(typ)
		or compiler_is_any_float_type(typ)
		or compiler_is_any_integer_type(typ)
	)


private pure func compiler_type_param_name(
	context: CompilerInferContext,
	typ: CompilerType,
) -> Option[String]:
	type_params = compiler_env_get_type_params(context.state.env)

	match typ:
		CompilerTypeVar(name):
			if type_params.contains(name):
				Some(name)
			else:
				None
		CompilerNamedType(name, args):
			if args.length() == 0 and type_params.contains(name):
				Some(name)
			else:
				None
		_:
			None


private pure func compiler_tensor_element_supports_arithmetic(typ: CompilerType) -> Bool:
	compiler_is_any_integer_type(typ) or compiler_is_any_float_type(typ)


private pure func compiler_dim_is_variadic(typ: CompilerType) -> Bool:
	match typ:
		CompilerVarDimsType(_):
			True
		_:
			False


private pure func compiler_tensor_arithmetic_result_type(
	op: ParsedBinaryOp,
	left_type: CompilerType,
	right_type: CompilerType,
) -> Option[CompilerType]:
	if not compiler_is_arithmetic_binary_op(op) or compiler_is_modulo_binary_op(op):
		None
	else:
		match (compiler_array_type_parts(left_type), compiler_array_type_parts(right_type)):
			(Some((element, dims)), None):
				if (
					compiler_tensor_element_supports_arithmetic(element)
					and compiler_types_equal(element, right_type)
				):
					Some(compiler_type_copy(left_type))
				else:
					None
			(None, Some((element, dims))):
				if (
					compiler_tensor_element_supports_arithmetic(element)
					and compiler_types_equal(left_type, element)
				):
					Some(compiler_type_copy(right_type))
				else:
					None
			(Some((left_element, left_dims)), Some((right_element, right_dims))):
				if (
					compiler_tensor_element_supports_arithmetic(left_element)
					and compiler_types_equal(left_element, right_element)
					and not left_dims.any(compiler_dim_is_variadic)
					and not right_dims.any(compiler_dim_is_variadic)
					and compiler_types_equal(left_type, right_type)
				):
					Some(compiler_type_copy(left_type))
				else:
					None
			_:
				None


private pure func compiler_type_satisfies_trait(
	context: CompilerInferContext,
	typ: CompilerType,
	trait_name: String,
) -> Bool:
	compiler_env_resolve_trait_obligation(
		context.state.env,
		compiler_trait_obligation(compiler_type_copy(typ), trait_name),
	) == CompilerTraitObligationSatisfied


private pure func compiler_is_structural_equality_collection(typ: CompilerType) -> Bool:
	match typ:
		CompilerNamedType(name, _):
			normalized_name: String = compiler_normalize_type_name(name)

			normalized_name == "List" or normalized_name == "Dict" or normalized_name == "Set"
		_:
			False


private pure func compiler_equality_compatibility(
	context: CompilerInferContext,
	left: CompilerType,
	right: CompilerType,
) -> Option[CompilerEqualityCompatibility]:
	resolved_left = compiler_env_resolve_alias(context.state.env, left)
	resolved_right = compiler_env_resolve_alias(context.state.env, right)

	match compiler_unify_symmetric(context.state.context, resolved_left, resolved_right):
		Some(step):
			next_state = { context.state | context = step.context }
			next_context = compiler_infer_context_with_state(context, next_state)
			Some({
				context = next_context,
				left_type = compiler_zonk_type(step.context, resolved_left),
				right_type = compiler_zonk_type(step.context, resolved_right),
			})
		None:
			None


private pure func compiler_open_exhaustiveness_scalar_name(typ: CompilerType) -> Option[String]:
	if (
		compiler_is_any_integer_type(typ)
		or compiler_is_any_float_type(typ)
		or compiler_named_value_type_is(typ, "String")
		or compiler_named_value_type_is(typ, "Char")
		or compiler_is_fixed_type(typ)
	):
		Some(compiler_type_to_string(typ))
	else:
		None


private pure func compiler_arithmetic_result_type(
	op: ParsedBinaryOp,
	left_type: CompilerType,
	right_type: CompilerType,
) -> Option[CompilerType]:
	match compiler_tensor_arithmetic_result_type(op, left_type, right_type):
		Some(result_type):
			Some(result_type)
		None:
			if (
				compiler_named_value_type_is(left_type, "Int")
				and compiler_named_value_type_is(right_type, "Int")
			):
				Some(compiler_type_int())
			else if (
				compiler_named_value_type_is(left_type, "Float")
				and compiler_named_value_type_is(right_type, "Float")
			):
				Some(compiler_type_float())
			else if (
				compiler_is_fixed_type(left_type)
				and compiler_is_fixed_type(right_type)
				and not compiler_is_modulo_binary_op(op)
			):
				Some(CompilerNamedType("Fixed", []))
			else if (
				compiler_is_add_binary_op(op)
				and compiler_named_value_type_is(left_type, "String")
				and compiler_named_value_type_is(right_type, "String")
			):
				Some(compiler_type_string())
			else if (
				compiler_is_any_float_type(left_type)
				and compiler_types_equal(left_type, right_type)
			):
				Some(compiler_type_copy(left_type))
			else if (
				compiler_is_any_integer_type(left_type)
				and compiler_types_equal(left_type, right_type)
			):
				Some(compiler_type_copy(left_type))
			else:
				None


private pure func compiler_check_arithmetic_binary_op(
	context: CompilerInferContext,
	op: ParsedBinaryOp,
	left_type: CompilerType,
	right_type: CompilerType,
) -> CompilerCheckedType:
	match compiler_arithmetic_result_type(op, left_type, right_type):
		Some(result_type):
			compiler_checked_type(context, result_type)
		None:
			left_param_name = compiler_type_param_name(context, left_type)
			right_param_name = compiler_type_param_name(context, right_type)
			trait_name = compiler_arithmetic_trait_name(op)

			match (left_param_name, right_param_name):
				(Some(left_name), Some(right_name)):
					if left_name != right_name:
						next = compiler_infer_error(
							context,
							"Cannot apply " + compiler_binary_op_symbol(
								op,
							) + " to different type parameters " + compiler_type_to_string(
								left_type,
							) + " and " + compiler_type_to_string(right_type),
						)
						compiler_checked_type(next, compiler_type_void())
					else if compiler_type_satisfies_trait(context, left_type, trait_name):
						compiler_checked_type(context, compiler_type_copy(left_type))
					else:
						next = compiler_infer_error(
							context,
							"Type parameter '" + left_name + "' requires " + trait_name + " bound for " + compiler_binary_op_symbol(
								op,
							) + " operator",
						)
						compiler_checked_type(next, compiler_type_void())
				_:
					if (
						compiler_types_equal(left_type, right_type)
						and not compiler_is_primitive_value_type(left_type)
						and compiler_type_satisfies_trait(context, left_type, trait_name)
					):
						compiler_checked_type(context, compiler_type_copy(left_type))
					else:
						next = compiler_infer_error(
							context,
							"Cannot apply " + compiler_binary_op_symbol(
								op,
							) + " to " + compiler_type_to_string(
								left_type,
							) + " and " + compiler_type_to_string(right_type),
						)
						compiler_checked_type(next, compiler_type_void())


private pure func compiler_check_comparison_binary_op(
	context: CompilerInferContext,
	left_type: CompilerType,
	right_type: CompilerType,
) -> CompilerCheckedType:
	left_param_name = compiler_type_param_name(context, left_type)
	right_param_name = compiler_type_param_name(context, right_type)

	if (
		compiler_types_equal(left_type, right_type)
		and compiler_is_orderable_primitive_type(left_type)
	):
		compiler_checked_type(context, compiler_type_bool())
	else:
		match (left_param_name, right_param_name):
			(Some(left_name), Some(right_name)):
				if left_name != right_name:
					next = compiler_infer_error(
						context,
						"Comparison requires the same type parameter, got " + left_name + " and " + right_name,
					)
					compiler_checked_type(next, compiler_type_void())
				else if compiler_type_satisfies_trait(context, left_type, "Orderable"):
					compiler_checked_type(context, compiler_type_bool())
				else:
					next = compiler_infer_error(
						context,
						"Type parameter '" + left_name + "' requires Orderable bound for comparison operators",
					)
					compiler_checked_type(next, compiler_type_void())
			_:
				if (
					compiler_types_equal(left_type, right_type)
					and compiler_type_satisfies_trait(context, left_type, "Orderable")
				):
					compiler_checked_type(context, compiler_type_bool())
				else:
					next = compiler_infer_error(
						context,
						"Comparison requires matching types that implement Orderable, got " + compiler_type_to_string(
							left_type,
						) + " and " + compiler_type_to_string(right_type),
					)
					compiler_checked_type(next, compiler_type_void())


private pure func compiler_check_equality_binary_op(
	context: CompilerInferContext,
	left_type: CompilerType,
	right_type: CompilerType,
) -> CompilerCheckedType:
	match compiler_equality_compatibility(context, left_type, right_type):
		Some(compatibility):
			left_param_name = compiler_type_param_name(
				compatibility.context,
				compatibility.left_type,
			)
			right_param_name = compiler_type_param_name(
				compatibility.context,
				compatibility.right_type,
			)

			if (
				compiler_is_equality_primitive_type(compatibility.left_type)
				or compiler_is_enum_value_type(compatibility.context, compatibility.left_type)
				or compiler_is_structural_equality_collection(compatibility.left_type)
			):
				compiler_checked_type(compatibility.context, compiler_type_bool())
			else:
				match (left_param_name, right_param_name):
					(Some(left_name), Some(right_name)):
						if left_name != right_name:
							next = compiler_infer_error(
								compatibility.context,
								"Cannot compare type parameters " + compiler_type_to_string(
									compatibility.left_type,
								) + " and " + compiler_type_to_string(
									compatibility.right_type,
								) + " because equality requires the same type",
							)
							compiler_checked_type(next, compiler_type_void())
						else if compiler_type_satisfies_trait(
							compatibility.context,
							compatibility.left_type,
							"Equatable",
						):
							compiler_checked_type(compatibility.context, compiler_type_bool())
						else:
							next = compiler_infer_error(
								compatibility.context,
								"Type parameter '" + left_name + "' requires Equatable bound for == and " + "!= operators. Add '" + left_name + ": Equatable' to the function signature",
							)
							compiler_checked_type(next, compiler_type_void())
					_:
						compiler_checked_type(compatibility.context, compiler_type_bool())
		None:
			next = compiler_infer_error(
				context,
				"Equality comparison requires compatible types, got " + compiler_type_to_string(
					left_type,
				) + " and " + compiler_type_to_string(right_type),
			)
			compiler_checked_type(next, compiler_type_void())


private pure func compiler_check_binary_op(
	context: CompilerInferContext,
	op: ParsedBinaryOp,
	left_type: CompilerType,
	right_type: CompilerType,
) -> CompilerCheckedType:
	if compiler_is_arithmetic_binary_op(op):
		compiler_check_arithmetic_binary_op(context, op, left_type, right_type)
	else if compiler_is_comparison_binary_op(op):
		compiler_check_comparison_binary_op(context, left_type, right_type)
	else if compiler_is_equality_binary_op(op):
		compiler_check_equality_binary_op(context, left_type, right_type)
	else:
		next = compiler_infer_error(context, "Unsupported binary operator")
		compiler_checked_type(next, compiler_type_void())


private pure func compiler_mod_result_type(
	op: ParsedBinaryOp,
	left_semantic_type: CompilerType,
	right_semantic_type: CompilerType,
	result_type: CompilerType,
) -> CompilerType:
	if not compiler_is_modulo_binary_op(op):
		compiler_type_copy(result_type)
	else:
		lhs_non_negative = match left_semantic_type:
			CompilerRangeType(_):
				True
			CompilerConstIntType(value):
				value >= 0
			_:
				False

		if not lhs_non_negative:
			compiler_type_copy(result_type)
		else:
			match right_semantic_type:
				CompilerConstIntType(bound):
					if bound > 0:
						CompilerRangeType(CompilerConstIntType(bound))
					else:
						compiler_type_copy(result_type)
				_:
					compiler_type_copy(result_type)


private pure func compiler_unary_operand_slot(
	op: ParsedUnaryOp,
	operand_type: CompilerType,
) -> CompilerValueSlot:
	match op:
		ParsedNegateOp:
			compiler_numeric_operand_slot(ParsedSubtractOp, operand_type)
		ParsedNotOp:
			compiler_keep_value_slot(operand_type)


private pure func compiler_is_negatable_array_type(typ: CompilerType) -> Bool:
	match typ:
		CompilerArrayType(element_type, _):
			(
				compiler_named_value_type_is(element_type, "Int")
				or compiler_is_signed_integer_type(element_type)
				or compiler_is_any_float_type(element_type)
			)
		_:
			False


private pure func compiler_check_unary_op(
	context: CompilerInferContext,
	op: ParsedUnaryOp,
	operand_type: CompilerType,
) -> CompilerCheckedType:
	match op:
		ParsedNegateOp:
			if compiler_named_value_type_is(operand_type, "Int"):
				compiler_checked_type(context, compiler_type_int())
			else if compiler_named_value_type_is(operand_type, "Float"):
				compiler_checked_type(context, compiler_type_float())
			else if compiler_is_negatable_array_type(operand_type):
				compiler_checked_type(context, operand_type)
			else if compiler_is_any_float_type(operand_type):
				compiler_checked_type(context, operand_type)
			else if compiler_is_signed_integer_type(operand_type):
				compiler_checked_type(context, operand_type)
			else if compiler_is_unsigned_integer_type(operand_type):
				next = compiler_infer_error(
					context,
					"Cannot negate unsigned type " + compiler_type_to_string(operand_type),
				)
				compiler_checked_type(next, compiler_type_void())
			else if compiler_type_satisfies_trait(context, operand_type, "Negatable"):
				compiler_checked_type(context, operand_type)
			else:
				next = compiler_infer_error(
					context,
					"Negation requires numeric type, got " + compiler_type_to_string(operand_type),
				)
				compiler_checked_type(next, compiler_type_void())
		ParsedNotOp:
			if compiler_named_value_type_is(operand_type, "Bool"):
				compiler_checked_type(context, compiler_type_bool())
			else:
				next = compiler_infer_error(
					context,
					"Logical not requires Bool, got " + compiler_type_to_string(operand_type),
				)
				compiler_checked_type(next, compiler_type_void())


private pure func compiler_check_logical_op(
	context: CompilerInferContext,
	left_type: CompilerType,
	right_type: CompilerType,
) -> CompilerCheckedType:
	if (
		compiler_named_value_type_is(left_type, "Bool")
		and compiler_named_value_type_is(right_type, "Bool")
	):
		compiler_checked_type(context, compiler_type_bool())
	else:
		next = compiler_infer_error(
			context,
			"Logical operation requires Bool operands, got " + compiler_type_to_string(
				left_type,
			) + " and " + compiler_type_to_string(right_type),
		)
		compiler_checked_type(next, compiler_type_void())


private pure func compiler_parse_int_literal(text: String) -> Int:
	text
		.parse_int()
		.get_or(0)


private pure func compiler_literal_result(
	context: CompilerInferContext,
	expr: CompilerTypedExpr,
) -> CompilerInferResult:
	compiler_infer_result(context, expr)


private pure func compiler_type_can_interpolate(typ: CompilerType) -> Bool:
	if (
		compiler_named_value_type_is(typ, "Int")
		or compiler_named_value_type_is(typ, "Float")
		or compiler_named_value_type_is(typ, "Bool")
		or compiler_named_value_type_is(typ, "Char")
		or compiler_named_value_type_is(typ, "String")
		or compiler_is_any_integer_type(typ)
		or compiler_is_any_float_type(typ)
	):
		True
	else:
		match typ:
			CompilerConstIntType(_):
				True
			CompilerRangeType(_):
				True
			CompilerArrayType(_, _):
				True
			CompilerNamedType(name, _):
				(
					name == "List"
					or name == "Result"
					or name == "Tensor"
					or name == "Vector"
					or name == "Matrix"
				)
			_:
				False


private pure func compiler_interpolation_type_error(
	context: CompilerInferContext,
	typ: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Interpolated expression has type " + compiler_type_to_string(typ) + ((
			" which cannot be converted to String. Implement Stringable for this type or "
			+ "convert it explicitly"
		)),
	)


private pure func compiler_infer_string_interpolation_parts_result(
	context: CompilerInferContext,
	parts: List[CompilerTypedStringInterpolationPart],
) -> CompilerInferStringInterpolationPartsResult:
	{
		context = compiler_infer_context_copy(context),
		parts = parts
	}


private pure func compiler_infer_string_interpolation_parts(
	context: CompilerInferContext,
	parts: List[ParsedStringInterpolationPart],
) -> CompilerInferStringInterpolationPartsResult:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var typed_parts: List[CompilerTypedStringInterpolationPart] = []

	for part in parts:
		match part:
			ParsedInterpolationLiteral(value):
				typed_parts = typed_parts.append(CompilerTypedInterpolationLiteral(value))
			ParsedInterpolationExpr(expr):
				expr_result = compiler_infer_expr(
					compiler_infer_without_expected(next_context),
					expr,
				)
				expr_type = compiler_typed_expr_semantic_type(expr_result.expr)

				next_context = if compiler_type_can_interpolate(expr_type):
					compiler_infer_context_copy(expr_result.context)
				else:
					compiler_interpolation_type_error(expr_result.context, expr_type)

				typed_parts = typed_parts.append(CompilerTypedInterpolationExpr(expr_result.expr))

	compiler_infer_string_interpolation_parts_result(
		compiler_infer_without_expected(next_context),
		typed_parts,
	)


private pure func compiler_infer_string_interpolation_parts_expr(
	context: CompilerInferContext,
	parts: List[ParsedStringInterpolationPart],
	is_multiline: Bool,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	parts_result = compiler_infer_string_interpolation_parts(context, parts)
	result_context = compiler_infer_context_with_state(context, parts_result.context.state)
	typed = CompilerTypedStringInterpolationPartsExpr(
		parts_result.parts,
		is_multiline,
		span,
		compiler_inferred_info(result_context, compiler_type_string()),
	)

	compiler_infer_result(result_context, typed)


private pure func compiler_inferred_string_literal_type(
	context: CompilerInferContext,
) -> CompilerType:
	match context.expected_type:
		Some(CompilerNamedType(name, args)):
			if name == "LiteralString" and args.length() == 0:
				CompilerNamedType(name, [])
			else:
				compiler_type_string()
		_:
			compiler_type_string()


private pure func compiler_var_origin_resource_dependencies(
	name: String,
	origin: CompilerVarOrigin,
) -> List[String]:
	match origin:
		CompilerScopedResource:
			[name]
		CompilerScopedResourceUnavailable(_):
			[name]
		CompilerScopedResourceDerived:
			[name]
		_:
			[]


private pure func compiler_inferred_constructor_type_args(
	context: CompilerInferContext,
	type_params: List[String],
	field_types: List[CompilerType],
) -> CompilerConstructorTypeArgsStep:
	var compiler_context: CompilerContext = context.state.context
	var args: List[CompilerType] = []

	for param in type_params:
		if field_types.any(func(field_type): compiler_occurs_in(param, field_type)):
			args = args.append(CompilerTypeVar(param))
		else:
			step = compiler_fresh_meta_with_origin(compiler_context, param)
			compiler_context = step.context
			args = args.append(step.meta_type)

	next_state = { context.state | context = compiler_context }
	{
		context = compiler_infer_context_with_state(context, next_state),
		args = args
	}


private pure func compiler_constructor_return_type(
	context: CompilerInferContext,
	parent_type: String,
	type_params: List[String],
	field_types: List[CompilerType],
) -> CompilerConstructorTypeStep:
	match context.expected_type:
		Some(CompilerNamedType(expected_name, args)):
			if expected_name == parent_type and args.length() == type_params.length():
				{
					context = context,
					typ = CompilerNamedType(
						parent_type,
						args.map(compiler_type_copy),
					)
				}
			else:
				step = compiler_inferred_constructor_type_args(context, type_params, field_types)
				{
					context = step.context,
					typ = CompilerNamedType(parent_type, step.args)
				}
		_:
			step = compiler_inferred_constructor_type_args(context, type_params, field_types)
			{
				context = step.context,
				typ = CompilerNamedType(parent_type, step.args)
			}


private pure func compiler_constructor_return_subst(
	type_params: List[String],
	return_type: CompilerType,
) -> List[CompilerTypeSubstEntry]:
	match return_type:
		CompilerNamedType(_, args):
			var result: List[CompilerTypeSubstEntry] = []
			var index: Int = 0

			while index < type_params.length() and index < args.length():
				match (type_params.get(index), args.get(index)):
					(Some(name), Some(arg)):
						result = result.append(compiler_type_subst_entry(name, arg))
					_:
						void

				index += 1

			result
		_:
			[]


private pure func compiler_constructor_field_types(
	type_params: List[String],
	return_type: CompilerType,
	field_types: List[CompilerType],
) -> List[CompilerType]:
	subst = compiler_constructor_return_subst(type_params, return_type)
	field_types.map(func(field_type): compiler_apply_subst(subst, field_type))


private pure func compiler_constructor_expr_type(
	context: CompilerInferContext,
	parent_type: String,
	type_params: List[String],
	field_types: List[CompilerType],
) -> CompilerConstructorTypeStep:
	return_step = compiler_constructor_return_type(context, parent_type, type_params, field_types)

	if field_types.length() == 0:
		return_step
	else:
		{
			context = return_step.context,
			typ = CompilerFunctionType(
				True,
				compiler_constructor_field_types(type_params, return_step.typ, field_types),
				return_step.typ,
			)
		}


private pure func compiler_infer_constructor_name_expr(
	context: CompilerInferContext,
	name: ParsedIdentifier,
	ctor: CompilerConstructorSymbol,
) -> CompilerInferResult:
	constructor_step = compiler_constructor_expr_type(
		context,
		ctor.parent_type,
		ctor.type_params,
		ctor.field_types,
	)
	constructor_type = constructor_step.typ
	resolved_call = Some(
		compiler_resolved_call_from_constructor(
			name.text,
			ctor.constructor_id,
			ctor.parent_type,
			constructor_type,
		),
	)
	expr = CompilerTypedNameExpr(
		name,
		compiler_typed_expr_info_from_slot(
			None,
			CompilerInferredOrigin,
			compiler_unrefined_binding(),
			resolved_call,
			compiler_keep_value_slot(constructor_type),
		),
	)

	compiler_infer_result(constructor_step.context, expr)


private pure func compiler_module_path_matches_span(
	module_path: String,
	span: CompilerSourceSpan,
) -> Bool:
	(
		module_path == span.module_name
		or module_path == span.path
		or span.path.ends_with(module_path + ".brp")
	)


private pure func compiler_module_symbol_visible_as_bare(
	state: CompilerTypecheckState,
	span: CompilerSourceSpan,
	local_name: String,
	module_path: Option[String],
	original_name: String,
) -> Bool:
	match module_path:
		None:
			True
		Some(path):
			if compiler_module_path_matches_span(path, span):
				True
			else:
				compiler_typecheck_state_has_import_binding(
					state,
					local_name,
					path,
					Some(original_name),
				)


private pure func compiler_constructor_visible_as_bare(
	state: CompilerTypecheckState,
	span: CompilerSourceSpan,
	local_name: String,
	original_name: String,
	ctor: CompilerConstructorSymbol,
) -> Bool:
	match compiler_typecheck_state_find_type_home(state, ctor.parent_type):
		Some(module_path):
			compiler_module_symbol_visible_as_bare(
				state,
				span,
				local_name,
				Some(module_path),
				original_name,
			)
		None:
			True


private pure func compiler_symbol_visible_as_bare(
	state: CompilerTypecheckState,
	span: CompilerSourceSpan,
	local_name: String,
	symbol: CompilerSymbol,
) -> Bool:
	match symbol.kind:
		CompilerVarSymbolKind(var_symbol):
			compiler_module_symbol_visible_as_bare(
				state,
				span,
				local_name,
				var_symbol.module_path,
				symbol.name,
			)
		CompilerFuncSymbolKind(func_symbol):
			compiler_module_symbol_visible_as_bare(
				state,
				span,
				local_name,
				func_symbol.module_path,
				symbol.name,
			)
		CompilerConstructorSymbolKind(ctor):
			compiler_constructor_visible_as_bare(state, span, local_name, symbol.name, ctor)
		_:
			True


private pure func compiler_symbol_is_lexical_or_current_module(
	state: CompilerTypecheckState,
	span: CompilerSourceSpan,
	symbol: CompilerSymbol,
) -> Bool:
	match symbol.kind:
		CompilerVarSymbolKind(var_symbol):
			match var_symbol.module_path:
				Some(module_path):
					compiler_module_path_matches_span(module_path, span)
				None:
					True
		CompilerFuncSymbolKind(func_symbol):
			match func_symbol.module_path:
				Some(module_path):
					compiler_module_path_matches_span(module_path, span)
				None:
					func_symbol.origin != CompilerBuiltinFunc
		CompilerConstructorSymbolKind(ctor):
			match compiler_typecheck_state_find_type_home(state, ctor.parent_type):
				Some(module_path):
					(
						not compiler_typecheck_state_type_home_is_imported(state, ctor.parent_type)
						and compiler_module_path_matches_span(module_path, span)
					)
				None:
					False
		_:
			False


private pure func compiler_symbol_from_imported_binding(
	context: CompilerInferContext,
	local_name: String,
	binding: CompilerImportedNameBinding,
) -> Option[CompilerSymbol]:
	module_path = binding.module_path
	original_name = binding.original_name

	match compiler_find_module_constructor(
		context,
		context.state.env,
		compiler_type_name_copy(module_path),
		compiler_type_name_copy(original_name),
	):
		Some(ctor):
			Some({
				name = local_name,
				kind = CompilerConstructorSymbolKind(ctor),
			})
		None:
			match compiler_env_get_module_func_symbol(
				context.state.env,
				compiler_type_name_copy(module_path),
				compiler_type_name_copy(original_name),
			):
				Some(func_symbol):
					Some({
						name = local_name,
						kind = CompilerFuncSymbolKind(func_symbol),
					})
				None:
					match compiler_env_get_module_var_symbol(
						context.state.env,
						compiler_type_name_copy(module_path),
						compiler_type_name_copy(original_name),
					):
						Some(var_symbol):
							Some({
								name = local_name,
								kind = CompilerVarSymbolKind(var_symbol),
							})
						None:
							None


private pure func compiler_trait_method_callee_from_trait(
	context: CompilerInferContext,
	source_name: String,
	method_name: String,
	trait_name: String,
) -> Option[CompilerTraitMethodCallee]:
	match compiler_env_find_trait_method(context.state.env, trait_name, method_name):
		Some((method, declaring_trait)):
			Some({
				source_name = source_name,
				method_name = method_name,
				trait_name = declaring_trait,
				method = method,
			})
		None:
			None


private pure func compiler_imported_trait_method_callee(
	context: CompilerInferContext,
	local_name: String,
	binding: CompilerImportedNameBinding,
) -> Option[CompilerTraitMethodCallee]:
	match compiler_env_get_function_trait(context.state.env, binding.original_name):
		Some(trait_name):
			compiler_trait_method_callee_from_trait(
				context,
				local_name,
				binding.original_name,
				trait_name,
			)
		None:
			None


private pure func compiler_local_trait_method_callee(
	context: CompilerInferContext,
	name: String,
) -> Option[CompilerTraitMethodCallee]:
	match compiler_env_get_function_trait(context.state.env, name):
		Some(trait_name):
			if compiler_typecheck_state_allows_scoped_trait_function(
				context.state,
				name,
				trait_name,
			):
				compiler_trait_method_callee_from_trait(context, name, name, trait_name)
			else if compiler_trait_method_is_compiler_prelude(trait_name):
				compiler_trait_method_callee_from_trait(context, name, name, trait_name)
			else:
				match compiler_typecheck_state_find_top_level_name(context.state, trait_name):
					Some(kind):
						if compiler_top_level_name_kind_is_trait(kind):
							compiler_trait_method_callee_from_trait(context, name, name, trait_name)
						else:
							None
					None:
						None
		None:
			None


private pure func compiler_trait_method_is_compiler_prelude(trait_name: String) -> Bool:
	compiler_builtin_trait_is_prelude(trait_name)


private pure func compiler_lookup_trait_method_callee(
	context: CompilerInferContext,
	name: ParsedIdentifier,
) -> Option[CompilerTraitMethodCallee]:
	match compiler_typecheck_state_find_imported_name(context.state, name.text):
		Some(binding):
			compiler_imported_trait_method_callee(context, name.text, binding)
		None:
			compiler_local_trait_method_callee(context, name.text)


private pure func compiler_imported_receiver_trait_method_callee(
	context: CompilerInferContext,
	name: ParsedIdentifier,
	receiver_type: CompilerType,
) -> Option[CompilerTraitMethodCallee]:
	type_is_imported = match receiver_type:
		CompilerNamedType(type_name, _):
			compiler_typecheck_state_type_home_is_imported(context.state, type_name)
		_:
			False

	if not type_is_imported:
		None
	else:
		match compiler_env_get_function_trait(context.state.env, name.text):
			Some(trait_name):
				match compiler_env_find_impl_method_info(
					context.state.env,
					trait_name,
					name.text,
					receiver_type,
				):
					Some(_):
						compiler_trait_method_callee_from_trait(
							context,
							name.text,
							name.text,
							trait_name,
						)
					None:
						None
			None:
				None


private pure func compiler_lookup_bare_symbol(
	context: CompilerInferContext,
	name: ParsedIdentifier,
) -> Option[CompilerSymbol]:
	var local_or_current: Option[CompilerSymbol] = None
	var visible_fallback: Option[CompilerSymbol] = None
	var builtin_fallback: Option[CompilerSymbol] = None
	imported_binding = compiler_typecheck_state_find_imported_name(context.state, name.text)

	for symbol in compiler_env_symbols_named(context.state.env, name.text):
		match symbol.kind:
			CompilerFuncSymbolKind(func_symbol):
				if func_symbol.origin == CompilerBuiltinFunc:
					if builtin_fallback.is_none():
						builtin_fallback = Some(symbol)
				else:
					if compiler_symbol_is_lexical_or_current_module(
						context.state,
						name.span,
						symbol,
					):
						local_or_current = Some(symbol)
						break
					else if (
						visible_fallback.is_none()
						and compiler_symbol_visible_as_bare(
							context.state,
							name.span,
							name.text,
							symbol,
						)
					):
						visible_fallback = Some(symbol)
			_:
				if compiler_symbol_is_lexical_or_current_module(context.state, name.span, symbol):
					local_or_current = Some(symbol)
					break
				else if (
					visible_fallback.is_none()
					and compiler_symbol_visible_as_bare(context.state, name.span, name.text, symbol)
				):
					visible_fallback = Some(symbol)

	match local_or_current:
		Some(symbol):
			Some(symbol)
		None:
			match imported_binding:
				Some(binding):
					match compiler_symbol_from_imported_binding(
						context,
						compiler_type_name_copy(name.text),
						binding,
					):
						Some(imported_symbol):
							Some(imported_symbol)
						None:
							match visible_fallback:
								Some(symbol):
									Some(symbol)
								None:
									builtin_fallback
				None:
					match visible_fallback:
						Some(symbol):
							Some(symbol)
						None:
							builtin_fallback


private pure func compiler_source_name_for_imported_module_path(
	context: CompilerInferContext,
	local_name: String,
	module_path: Option[String],
) -> String:
	match module_path:
		Some(path):
			match compiler_typecheck_state_find_imported_name(context.state, local_name):
				Some(binding):
					if binding.module_path == path:
						binding.original_name
					else:
						local_name
				None:
					local_name
		None:
			local_name


private pure func compiler_source_name_for_func_symbol(
	context: CompilerInferContext,
	local_name: String,
	func_symbol: CompilerFuncSymbol,
) -> String:
	compiler_source_name_for_imported_module_path(context, local_name, func_symbol.module_path)


private pure func compiler_source_name_for_overload_entry(
	context: CompilerInferContext,
	local_name: String,
	entry: CompilerOverloadEntry,
) -> String:
	compiler_source_name_for_imported_module_path(context, local_name, entry.module_path)


private pure func compiler_infer_trait_method_name_expr(
	context: CompilerInferContext,
	name: ParsedIdentifier,
	callee: CompilerTraitMethodCallee,
) -> CompilerInferResult:
	func_type = compiler_trait_method_callee_function_type(callee)
	expr = CompilerTypedNameExpr(
		name,
		compiler_typed_expr_info_from_slot(
			None,
			CompilerInferredOrigin,
			compiler_unrefined_binding(),
			Some(compiler_resolved_call_from_trait_method_callee(callee, None)),
			compiler_infer_expected_slot(context, func_type),
		),
	)
	compiler_infer_result(context, expr)


private pure func compiler_builtin_symbol_prefers_trait_dispatch(name: String) -> Bool:
	-- These builtins have an Int fallback signature for concrete calls, but
	-- their trait contract is authoritative for bounded generic callers.
	[
		"checked_div",
		"checked_mod",
		"bit_and",
		"bit_or",
		"bit_xor",
		"bit_not",
		"shift_left",
		"shift_right",
	].contains(name)


private pure func compiler_infer_name_expr(
	context: CompilerInferContext,
	name: ParsedIdentifier,
) -> CompilerInferResult:
	match compiler_lookup_bare_symbol(context, name):
		Some(symbol):
			match symbol.kind:
				CompilerVarSymbolKind(var_symbol):
					var_type = compiler_resolve_type_metas(
						context.state.context,
						var_symbol.var_type,
					)
					dependencies = compiler_var_origin_resource_dependencies(
						name.text,
						var_symbol.origin,
					)

					value_slot = match var_type:
						CompilerRangeType(_):
							compiler_infer_range_binding_slot(context, var_type)
						_:
							compiler_infer_expected_slot(context, var_type)

					expr = CompilerTypedNameExpr(
						name,
						compiler_expr_info_with_resource_dependencies(
							compiler_typed_expr_info_from_slot(
								var_symbol.source_type,
								CompilerInferredOrigin,
								compiler_unrefined_binding(),
								None,
								value_slot,
							),
							dependencies,
						),
					)
					compiler_infer_result(context, expr)
				CompilerFuncSymbolKind(func_symbol):
					trait_callee = if (
						func_symbol.origin == CompilerBuiltinFunc
						and compiler_builtin_symbol_prefers_trait_dispatch(name.text)
					):
						compiler_lookup_trait_method_callee(context, name)
					else:
						empty: Option[CompilerTraitMethodCallee] = None
						empty

					match trait_callee:
						Some(callee):
							compiler_infer_trait_method_name_expr(context, name, callee)
						None:
							next_context = compiler_check_debug_only_reference(
								context,
								name.text,
								func_symbol.debug_only,
							)
							source_name = compiler_source_name_for_func_symbol(
								context,
								name.text,
								func_symbol,
							)
							expr = CompilerTypedNameExpr(
								name,
								compiler_typed_expr_info_from_slot(
									None,
									CompilerInferredOrigin,
									compiler_unrefined_binding(),
									Some(
										compiler_resolved_call_from_func_symbol_with_source(
											name.text,
											source_name,
											func_symbol,
										),
									),
									compiler_infer_expected_slot(
										next_context,
										func_symbol.func_type,
									),
								),
							)
							compiler_infer_result(next_context, expr)
				CompilerConstructorSymbolKind(ctor):
					compiler_infer_constructor_name_expr(context, name, ctor)
				_:
					next = compiler_infer_error(context, "`" + name.text + "` is not a value")
					compiler_infer_result(
						next,
						CompilerTypedNameExpr(
							name,
							compiler_inferred_info(next, compiler_type_void()),
						),
					)
		None:
			match compiler_lookup_trait_method_callee(context, name):
				Some(callee):
					compiler_infer_trait_method_name_expr(context, name, callee)
				None:
					match compiler_env_get_constructor(context.state.env, name.text):
						Some(ctor):
							compiler_infer_constructor_name_expr(context, name, ctor)
						None:
							next = compiler_infer_error(
								context,
								"Unbound value `" + name.text + "`",
							)
							compiler_infer_result(
								next,
								CompilerTypedNameExpr(
									name,
									compiler_inferred_info(next, compiler_type_void()),
								),
							)


private pure func compiler_apply_ascription(
	context: CompilerInferContext,
	inner: CompilerTypedExpr,
	source_type: CompilerType,
	semantic_type: CompilerType,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	value_type = compiler_typed_expr_value_type(inner)

	next = if compiler_types_equal(value_type, semantic_type):
		context
	else:
		compiler_infer_error(
			context,
			"Ascribed type `" + compiler_type_to_string(
				source_type,
			) + "` does not match value type `" + compiler_type_to_string(value_type) + "`",
		)

	compiler_infer_result(
		next,
		CompilerTypedAscriptionExpr(
			inner,
			source_type,
			span,
			compiler_explicit_info(source_type, semantic_type),
		),
	)


private pure func compiler_opaque_conversion_name(conversion: CompilerOpaqueConversion) -> String:
	match conversion:
		CompilerOpaqueIntoConversion:
			"into"
		CompilerOpaqueFromConversion:
			"from"


private pure func compiler_opaque_conversion_same_module(
	home_module: Option[String],
	span: CompilerSourceSpan,
) -> Bool:
	match home_module:
		Some(module_path):
			compiler_module_path_matches_span(module_path, span)
		None:
			True


private pure func compiler_type_param_subst_for_args(
	type_params: List[String],
	args: List[CompilerType],
) -> List[CompilerTypeSubstEntry]:
	var subst: List[CompilerTypeSubstEntry] = []
	var index: Int = 0

	while index < type_params.length() and index < args.length():
		match (type_params.get(index), args.get(index)):
			(Some(type_param), Some(arg)):
				subst = subst.append(compiler_type_subst_entry(type_param, arg))
			_:
				void

		index += 1

	subst


private pure func compiler_opaque_conversion_type_result(
	context: CompilerInferContext,
	source_type: CompilerType,
	opaque_type: CompilerType,
	target_type: CompilerType,
	ok: Bool,
) -> CompilerOpaqueConversionTypeResult:
	{
		context = compiler_infer_context_copy(context),
		source_type = compiler_type_copy(source_type),
		opaque_type = compiler_type_copy(opaque_type),
		target_type = compiler_type_copy(target_type),
		ok = ok
	}


private pure func compiler_resolve_opaque_conversion_type(
	context: CompilerInferContext,
	type_expr: ParsedTypeExpr,
	span: CompilerSourceSpan,
) -> CompilerOpaqueConversionTypeResult:
	source_type = compiler_type_from_parsed_type_expr(type_expr)
	opaque_type = compiler_infer_canonical_expected_type(context, source_type)

	match opaque_type:
		CompilerNamedType(name, args):
			match compiler_env_get_opaque_alias(context.state.env, name):
				Some((type_params, target, home_module)):
					if type_params.length() != args.length():
						next = compiler_infer_error(
							context,
							"Opaque type '" + name + "' expects " + type_params
								.length()
								.to_string() + " type argument(s), got " + args
								.length()
								.to_string(),
						)
						compiler_opaque_conversion_type_result(
							next,
							source_type,
							opaque_type,
							compiler_type_void(),
							False,
						)
					else if not compiler_opaque_conversion_same_module(home_module, span):
						next = compiler_infer_error(
							context,
							"Opaque type '" + name + "' can only use into/from conversions in its defining module",
						)
						compiler_opaque_conversion_type_result(
							next,
							source_type,
							opaque_type,
							compiler_type_void(),
							False,
						)
					else:
						subst = compiler_type_param_subst_for_args(type_params, args)
						target_type = compiler_apply_subst(subst, target)
						compiler_opaque_conversion_type_result(
							context,
							source_type,
							opaque_type,
							target_type,
							True,
						)
				None:
					next = compiler_infer_error(
						context,
						"Type '" + compiler_type_to_string(
							opaque_type,
						) + "' is not an opaque type",
					)
					compiler_opaque_conversion_type_result(
						next,
						source_type,
						opaque_type,
						compiler_type_void(),
						False,
					)
		_:
			next = compiler_infer_error(
				context,
				"Expected an opaque named type, got " + compiler_type_to_string(opaque_type),
			)
			compiler_opaque_conversion_type_result(
				next,
				source_type,
				opaque_type,
				compiler_type_void(),
				False,
			)


private pure func compiler_typed_opaque_conversion_expr(
	conversion: CompilerOpaqueConversion,
	source_type: CompilerType,
	inner: CompilerTypedExpr,
	result_type: CompilerType,
	span: CompilerSourceSpan,
	info: CompilerTypedExprInfo,
) -> CompilerTypedExpr:
	match conversion:
		CompilerOpaqueIntoConversion:
			CompilerTypedOpaqueIntoExpr(source_type, inner, span, info)
		CompilerOpaqueFromConversion:
			CompilerTypedOpaqueFromExpr(source_type, inner, span, info)


private pure func compiler_infer_opaque_conversion_expr(
	context: CompilerInferContext,
	conversion: CompilerOpaqueConversion,
	type_expr: ParsedTypeExpr,
	inner: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	type_result = compiler_resolve_opaque_conversion_type(context, type_expr, span)

	expected_inner_type = match conversion:
		CompilerOpaqueIntoConversion:
			compiler_type_copy(type_result.target_type)
		CompilerOpaqueFromConversion:
			compiler_type_copy(type_result.opaque_type)

	inner_context = if type_result.ok:
		compiler_infer_with_expected_value_slot(
			type_result.context,
			expected_inner_type,
			CompilerExpectedArgumentSlot,
		)
	else:
		compiler_infer_context_copy(type_result.context)

	inner_result = compiler_infer_expr(inner_context, inner)
	inner_value_type = compiler_typed_expr_value_type(inner_result.expr)

	checked_context = if (
		type_result.ok
		and not compiler_types_equal(inner_value_type, expected_inner_type)
	):
		compiler_infer_error(
			inner_result.context,
			compiler_opaque_conversion_name(
				conversion,
			) + " expected " + compiler_type_to_string(
				expected_inner_type,
			) + ", got " + compiler_type_to_string(inner_value_type),
		)
	else:
		compiler_infer_context_copy(inner_result.context)

	result_type = match conversion:
		CompilerOpaqueIntoConversion:
			compiler_type_copy(type_result.opaque_type)
		CompilerOpaqueFromConversion:
			compiler_type_copy(type_result.target_type)

	info = compiler_inferred_info(checked_context, result_type)
	typed = compiler_typed_opaque_conversion_expr(
		conversion,
		compiler_type_copy(type_result.source_type),
		inner_result.expr,
		result_type,
		span,
		info,
	)

	compiler_infer_result(checked_context, typed)


private pure func compiler_infer_ascription_expr(
	context: CompilerInferContext,
	inner: ParsedExpr,
	type_expr: ParsedTypeExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	source_type = compiler_type_from_parsed_type_expr(type_expr)
	semantic_type = compiler_infer_canonical_expected_type(context, source_type)
	inner_result = compiler_infer_expr(
		compiler_infer_with_expected_value_slot(
			context,
			semantic_type,
			CompilerExpectedArgumentSlot,
		),
		inner,
	)
	compiler_apply_ascription(
		inner_result.context,
		inner_result.expr,
		source_type,
		semantic_type,
		span,
	)


private pure func compiler_infer_unary_expr(
	context: CompilerInferContext,
	op: ParsedUnaryOp,
	operand: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	operand_result = compiler_infer_expr(compiler_infer_without_expected(context), operand)
	operand_semantic_type = compiler_typed_expr_semantic_type(operand_result.expr)
	operand_slot = compiler_unary_operand_slot(op, operand_semantic_type)
	operand_value_type = compiler_widening_value_type(operand_slot)
	checked = compiler_check_unary_op(operand_result.context, op, operand_value_type)
	typed_operand = compiler_typed_expr_with_slot(operand_result.expr, operand_slot)
	typed = CompilerTypedUnaryExpr(
		op,
		typed_operand,
		span,
		compiler_inferred_info(checked.context, checked.typ),
	)

	compiler_infer_result(checked.context, typed)


private pure func compiler_infer_binary_expr(
	context: CompilerInferContext,
	op: ParsedBinaryOp,
	left: ParsedExpr,
	right: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	left_result = compiler_infer_expr(compiler_infer_without_expected(context), left)
	right_result = compiler_infer_expr(compiler_infer_without_expected(left_result.context), right)
	left_semantic_type = compiler_typed_expr_semantic_type(left_result.expr)
	right_semantic_type = compiler_typed_expr_semantic_type(right_result.expr)
	left_slot = compiler_numeric_operand_slot(op, left_semantic_type)
	right_slot = compiler_numeric_operand_slot(op, right_semantic_type)
	left_value_type = compiler_widening_value_type(left_slot)
	right_value_type = compiler_widening_value_type(right_slot)
	checked = compiler_check_binary_op(right_result.context, op, left_value_type, right_value_type)
	result_type = compiler_mod_result_type(op, left_semantic_type, right_semantic_type, checked.typ)
	typed_left = compiler_typed_expr_with_slot(left_result.expr, left_slot)
	typed_right = compiler_typed_expr_with_slot(right_result.expr, right_slot)
	typed = CompilerTypedBinaryExpr(
		op,
		typed_left,
		typed_right,
		span,
		compiler_inferred_info(checked.context, result_type),
	)

	compiler_infer_result(checked.context, typed)


private pure func compiler_infer_logical_expr(
	context: CompilerInferContext,
	op: ParsedLogicalOp,
	left: ParsedExpr,
	right: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	left_result = compiler_infer_expr(compiler_infer_without_expected(context), left)
	right_result = compiler_infer_expr(compiler_infer_without_expected(left_result.context), right)
	left_type = compiler_typed_expr_semantic_type(left_result.expr)
	right_type = compiler_typed_expr_semantic_type(right_result.expr)
	checked = compiler_check_logical_op(right_result.context, left_type, right_type)
	typed = CompilerTypedLogicalExpr(
		op,
		left_result.expr,
		right_result.expr,
		span,
		compiler_inferred_info(checked.context, checked.typ),
	)

	compiler_infer_result(checked.context, typed)


private pure func compiler_call_name(callee: CompilerTypedExpr) -> Option[String]:
	match callee:
		CompilerTypedNameExpr(name, _):
			Some(name.text)
		_:
			None


private pure func compiler_call_arity_error(
	context: CompilerInferContext,
	callee: CompilerTypedExpr,
	expected: Int,
	got: Int,
) -> CompilerInferContext:
	name_text = match compiler_call_name(callee):
		Some(name):
			" '" + name + "'"
		None:
			""

	arg_word = if expected == 1:
		" argument"
	else:
		" arguments"

	compiler_infer_error(
		context,
		"Function" + name_text + " expects " + expected.to_string() + arg_word + ", got " + got.to_string(),
	)


private pure func compiler_argument_mismatch_error(
	context: CompilerInferContext,
	callee: CompilerTypedExpr,
	index: Int,
	expected: CompilerType,
	got: CompilerType,
	span: CompilerSourceSpan,
) -> CompilerInferContext:
	callee_text = match compiler_call_name(callee):
		Some(name):
			"in call to '${name}', "
		None:
			""

	expected_text = compiler_type_to_string(expected)
	got_text = compiler_type_to_string(got)
	location = compiler_source_span_label(span)

	compiler_infer_error(
		context,
		"Argument type mismatch: ${callee_text}argument ${(index + 1).to_string()} expected ${expected_text}, got ${got_text} at ${location}",
	)


private pure func compiler_type_contains_type_var(typ: CompilerType) -> Bool:
	match typ:
		CompilerTypeVar(_):
			True
		CompilerNamedType(name, args):
			if args.length() == 0:
				compiler_is_legacy_single_letter_type_param(name)
			else:
				args.any(compiler_type_contains_type_var)
		CompilerArrayType(element, dims):
			compiler_type_contains_type_var(element) or dims.any(compiler_type_contains_type_var)
		CompilerFunctionType(_, params, return_type):
			(
				params.any(compiler_type_contains_type_var)
				or compiler_type_contains_type_var(return_type)
			)
		CompilerTupleType(elements):
			elements.any(compiler_type_contains_type_var)
		CompilerRangeType(inner):
			compiler_type_contains_type_var(inner)
		CompilerDimOpType(_, left, right):
			compiler_type_contains_type_var(left) or compiler_type_contains_type_var(right)
		_:
			False


private pure func compiler_type_contains_self(typ: CompilerType) -> Bool:
	match typ:
		CompilerSelfType:
			True
		CompilerNamedType(_, args):
			args.any(compiler_type_contains_self)
		CompilerArrayType(element, dims):
			compiler_type_contains_self(element) or dims.any(compiler_type_contains_self)
		CompilerFunctionType(_, params, return_type):
			params.any(compiler_type_contains_self) or compiler_type_contains_self(return_type)
		CompilerTupleType(elements):
			elements.any(compiler_type_contains_self)
		CompilerRangeType(inner):
			compiler_type_contains_self(inner)
		CompilerDimOpType(_, left, right):
			compiler_type_contains_self(left) or compiler_type_contains_self(right)
		_:
			False


private pure func compiler_bound_type_param_names(
	params: List[CompilerBoundTypeParam],
) -> List[String]:
	params.map(func(param): param.name)


private pure func compiler_fresh_callee_type_param_name(
	outer_names: List[String],
	used_names: List[String],
	name: String,
) -> String:
	if not outer_names.contains(name) and not used_names.contains(name):
		name
	else:
		is_dim = compiler_is_dim_var_name(name)

		base_name = if is_dim:
			name.substring(1, name.length())
		else:
			name

		prefix = if is_dim:
			"#__callee_"
		else:
			"__callee_"

		var index: Int = 0
		var candidate: String = prefix + base_name

		while outer_names.contains(candidate) or used_names.contains(candidate):
			index += 1
			candidate = prefix + index.to_string() + "_" + base_name

		candidate


private pure func compiler_renamed_bound_type_param(
	param: CompilerBoundTypeParam,
	name: String,
) -> CompilerBoundTypeParam:
	{ param | name = name }


private pure func compiler_call_type_param_scope_result(
	bound_params: List[CompilerBoundTypeParam],
	renames: List[CompilerTypeSubstEntry],
) -> CompilerCallTypeParamScope:
	{
		bound_params = bound_params,
		renames = renames
	}


private pure func compiler_call_type_param_scope(
	context: CompilerInferContext,
	bound_params: List[CompilerBoundTypeParam],
) -> CompilerCallTypeParamScope:
	outer_names = compiler_env_get_type_params(context.state.env)
	var used_names: List[String] = []
	var scoped_params: List[CompilerBoundTypeParam] = []
	var renames: List[CompilerTypeSubstEntry] = []

	for param in bound_params:
		scoped_name = compiler_fresh_callee_type_param_name(outer_names, used_names, param.name)
		scoped_params = scoped_params.append(compiler_renamed_bound_type_param(param, scoped_name))
		used_names = used_names.append(scoped_name)

		if scoped_name != param.name:
			renames = renames.append(
				compiler_type_subst_entry(
					param.name,
					CompilerTypeVar(scoped_name),
				),
			)

	compiler_call_type_param_scope_result(scoped_params, renames)


private pure func compiler_call_signature(
	context: CompilerInferContext,
	bound_params: List[CompilerBoundTypeParam],
	params: List[CompilerType],
	return_type: CompilerType,
) -> CompilerCallSignature:
	scope = compiler_call_type_param_scope(context, bound_params)

	{
		bound_params = scope.bound_params,
		params = params.map(func(param): compiler_apply_subst(scope.renames, param)),
		return_type = compiler_apply_subst(scope.renames, return_type)
	}


private pure func compiler_type_contains_named_type_param(
	type_param_names: List[String],
	typ: CompilerType,
) -> Bool:
	match typ:
		CompilerTypeVar(name):
			type_param_names.contains(name)
		CompilerNamedType(name, args):
			(
				args.length() == 0 and type_param_names.contains(name)
				or args.any(
					func(
						arg,
					): compiler_type_contains_named_type_param(
						compiler_string_list_copy(type_param_names),
						arg,
					),
				)
			)
		CompilerArrayType(element, dims):
			(
				compiler_type_contains_named_type_param(
					compiler_string_list_copy(type_param_names),
					element,
				)
				or dims.any(
					func(
						dim,
					): compiler_type_contains_named_type_param(
						compiler_string_list_copy(type_param_names),
						dim,
					),
				)
			)
		CompilerFunctionType(_, params, return_type):
			(
				params.any(
					func(
						param,
					): compiler_type_contains_named_type_param(
						compiler_string_list_copy(type_param_names),
						param,
					),
				)
				or compiler_type_contains_named_type_param(
					compiler_string_list_copy(type_param_names),
					return_type,
				)
			)
		CompilerTupleType(elements):
			elements.any(
				func(
					element,
				): compiler_type_contains_named_type_param(
					compiler_string_list_copy(type_param_names),
					element,
				),
			)
		CompilerRangeType(inner):
			compiler_type_contains_named_type_param(
				compiler_string_list_copy(type_param_names),
				inner,
			)
		CompilerDimOpType(_, left, right):
			(
				compiler_type_contains_named_type_param(
					compiler_string_list_copy(type_param_names),
					left,
				)
				or compiler_type_contains_named_type_param(
					compiler_string_list_copy(type_param_names),
					right,
				)
			)
		_:
			False


private pure func compiler_type_contains_call_type_param(
	type_param_names: List[String],
	typ: CompilerType,
) -> Bool:
	if type_param_names.length() == 0:
		compiler_type_contains_type_var(typ)
	else:
		compiler_type_contains_named_type_param(compiler_string_list_copy(type_param_names), typ)


private pure func compiler_find_type_subst(
	subst: List[CompilerTypeSubstEntry],
	name: String,
) -> Option[CompilerType]:
	var result: Option[CompilerType] = None
	var index: Int = 0

	while index < subst.length() and result.is_none():
		match subst.get(index):
			Some(entry):
				if entry.var_name == name:
					result = Some(entry.concrete_type)
			None:
				void

		index += 1

	result


private pure func compiler_bind_type_subst_result(
	context: CompilerInferContext,
	subst: List[CompilerTypeSubstEntry],
) -> CompilerBindTypeSubstResult:
	{
		context = compiler_infer_context_copy(context),
		subst = subst
	}


private pure func compiler_generic_actual_type(
	param_name: String,
	typ: CompilerType,
) -> CompilerType:
	if compiler_is_dim_var_name(param_name):
		compiler_type_copy(typ)
	else:
		compiler_default_collection_element_type(typ)


private pure func compiler_generic_conflict_error(
	context: CompilerInferContext,
	name: String,
	existing: CompilerType,
	found: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Generic type parameter " + name + " inferred as " + compiler_type_to_string(
			existing,
		) + " and " + compiler_type_to_string(found),
	)


private pure func compiler_bind_type_var_subst(
	context: CompilerInferContext,
	name: String,
	actual_type: CompilerType,
	subst: List[CompilerTypeSubstEntry],
) -> CompilerBindTypeSubstResult:
	bound_type = compiler_generic_actual_type(name, actual_type)

	is_identity = match bound_type:
		CompilerTypeVar(actual_name):
			actual_name == name
		CompilerNamedType(actual_name, args):
			args.length() == 0 and actual_name == name
		_:
			False

	if is_identity:
		compiler_bind_type_subst_result(context, subst)
	else:
		match compiler_find_type_subst(subst, name):
			Some(existing):
				if compiler_types_equal(existing, bound_type):
					compiler_bind_type_subst_result(context, subst)
				else if (
					compiler_type_contains_meta(existing)
					or compiler_type_contains_meta(bound_type)
				):
					match compiler_unify_symmetric(context.state.context, existing, bound_type):
						Some(step):
							next_state = { context.state | context = step.context }
							compiler_bind_type_subst_result(
								compiler_infer_context_with_state(context, next_state),
								subst,
							)
						None:
							compiler_bind_type_subst_result(
								compiler_generic_conflict_error(
									context,
									name,
									existing,
									bound_type,
								),
								subst,
							)
				else:
					compiler_bind_type_subst_result(
						compiler_generic_conflict_error(context, name, existing, bound_type),
						subst,
					)
			None:
				compiler_bind_type_subst_result(
					context,
					subst.append(compiler_type_subst_entry(name, bound_type)),
				)


private pure func compiler_complete_call_type_subst(
	context: CompilerInferContext,
	bound_params: List[CompilerBoundTypeParam],
	subst: List[CompilerTypeSubstEntry],
) -> CompilerBindTypeSubstResult:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var next_subst: List[CompilerTypeSubstEntry] = subst

	for param in bound_params:
		if (
			param.bounds.length() == 0
			and compiler_find_type_subst(next_subst, param.name).is_none()
		):
			step = compiler_fresh_meta_with_origin(next_context.state.context, param.name)
			next_state = { next_context.state | context = step.context }
			next_context = compiler_infer_context_with_state(next_context, next_state)
			next_subst = next_subst.append(compiler_type_subst_entry(param.name, step.meta_type))

	compiler_bind_type_subst_result(next_context, next_subst)


private pure func compiler_bind_type_list_subst(
	context: CompilerInferContext,
	param_types: List[CompilerType],
	actual_types: List[CompilerType],
	subst: List[CompilerTypeSubstEntry],
) -> CompilerBindTypeSubstResult:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var next_subst: List[CompilerTypeSubstEntry] = subst
	var index: Int = 0

	while index < param_types.length() and index < actual_types.length():
		match (param_types.get(index), actual_types.get(index)):
			(Some(param_type), Some(actual_type)):
				result = compiler_bind_type_subst(next_context, param_type, actual_type, next_subst)
				next_context = result.context
				next_subst = result.subst
			_:
				void

		index += 1

	compiler_bind_type_subst_result(next_context, next_subst)


private pure func compiler_bind_type_list_subst_with_type_params(
	context: CompilerInferContext,
	type_param_names: List[String],
	param_types: List[CompilerType],
	actual_types: List[CompilerType],
	subst: List[CompilerTypeSubstEntry],
) -> CompilerBindTypeSubstResult:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var next_subst: List[CompilerTypeSubstEntry] = subst
	var index: Int = 0

	while index < param_types.length() and index < actual_types.length():
		match (param_types.get(index), actual_types.get(index)):
			(Some(param_type), Some(actual_type)):
				result = compiler_bind_type_subst_with_type_params(
					next_context,
					type_param_names,
					param_type,
					actual_type,
					next_subst,
				)
				next_context = result.context
				next_subst = result.subst
			_:
				void

		index += 1

	compiler_bind_type_subst_result(next_context, next_subst)


private pure func compiler_bind_type_subst_with_type_params(
	context: CompilerInferContext,
	type_param_names: List[String],
	param_type: CompilerType,
	actual_type: CompilerType,
	subst: List[CompilerTypeSubstEntry],
) -> CompilerBindTypeSubstResult:
	match param_type:
		CompilerTypeVar(name):
			if type_param_names.length() == 0 or type_param_names.contains(name):
				compiler_bind_type_var_subst(context, name, actual_type, subst)
			else:
				compiler_bind_type_subst_result(context, subst)
		CompilerNamedType(param_name, param_args):
			if param_args.length() == 0 and type_param_names.contains(param_name):
				compiler_bind_type_var_subst(context, param_name, actual_type, subst)
			else:
				match actual_type:
					CompilerNamedType(actual_name, actual_args):
						if (
							param_name == actual_name
							and param_args.length() == actual_args.length()
						):
							compiler_bind_type_list_subst_with_type_params(
								context,
								type_param_names,
								param_args,
								actual_args,
								subst,
							)
						else:
							compiler_bind_type_subst_result(context, subst)
					_:
						compiler_bind_type_subst_result(context, subst)
		CompilerArrayType(param_element, param_dims):
			match compiler_array_type_parts(actual_type):
				Some((actual_element, actual_dims)):
					element_result = compiler_bind_type_subst_with_type_params(
						context,
						type_param_names,
						param_element,
						actual_element,
						subst,
					)
					compiler_bind_type_list_subst_with_type_params(
						element_result.context,
						type_param_names,
						param_dims,
						actual_dims,
						element_result.subst,
					)
				None:
					compiler_bind_type_subst_result(context, subst)
		CompilerTupleType(param_elements):
			match actual_type:
				CompilerTupleType(actual_elements):
					if param_elements.length() == actual_elements.length():
						compiler_bind_type_list_subst_with_type_params(
							context,
							type_param_names,
							param_elements,
							actual_elements,
							subst,
						)
					else:
						compiler_bind_type_subst_result(context, subst)
				_:
					compiler_bind_type_subst_result(context, subst)
		CompilerFunctionType(_, param_params, param_return):
			match actual_type:
				CompilerFunctionType(_, actual_params, actual_return):
					param_result = compiler_bind_type_list_subst_with_type_params(
						context,
						type_param_names,
						param_params,
						actual_params,
						subst,
					)
					compiler_bind_type_subst_with_type_params(
						param_result.context,
						type_param_names,
						param_return,
						actual_return,
						param_result.subst,
					)
				_:
					compiler_bind_type_subst_result(context, subst)
		CompilerRangeType(param_inner):
			match actual_type:
				CompilerRangeType(actual_inner):
					compiler_bind_type_subst_with_type_params(
						context,
						type_param_names,
						param_inner,
						actual_inner,
						subst,
					)
				_:
					compiler_bind_type_subst_result(context, subst)
		_:
			compiler_bind_type_subst_result(context, subst)


private pure func compiler_bind_type_subst(
	context: CompilerInferContext,
	param_type: CompilerType,
	actual_type: CompilerType,
	subst: List[CompilerTypeSubstEntry],
) -> CompilerBindTypeSubstResult:
	match param_type:
		CompilerTypeVar(name):
			compiler_bind_type_var_subst(context, name, actual_type, subst)
		CompilerNamedType(param_name, param_args):
			match actual_type:
				CompilerNamedType(actual_name, actual_args):
					if param_name == actual_name and param_args.length() == actual_args.length():
						compiler_bind_type_list_subst(context, param_args, actual_args, subst)
					else:
						compiler_bind_type_subst_result(context, subst)
				_:
					compiler_bind_type_subst_result(context, subst)
		CompilerArrayType(param_element, param_dims):
			match compiler_array_type_parts(actual_type):
				Some((actual_element, actual_dims)):
					element_result = compiler_bind_type_subst(
						context,
						param_element,
						actual_element,
						subst,
					)
					compiler_bind_type_list_subst(
						element_result.context,
						param_dims,
						actual_dims,
						element_result.subst,
					)
				None:
					compiler_bind_type_subst_result(context, subst)
		CompilerTupleType(param_elements):
			match actual_type:
				CompilerTupleType(actual_elements):
					if param_elements.length() == actual_elements.length():
						compiler_bind_type_list_subst(
							context,
							param_elements,
							actual_elements,
							subst,
						)
					else:
						compiler_bind_type_subst_result(context, subst)
				_:
					compiler_bind_type_subst_result(context, subst)
		CompilerFunctionType(_, param_params, param_return):
			match actual_type:
				CompilerFunctionType(_, actual_params, actual_return):
					param_result = compiler_bind_type_list_subst(
						context,
						param_params,
						actual_params,
						subst,
					)
					compiler_bind_type_subst(
						param_result.context,
						param_return,
						actual_return,
						param_result.subst,
					)
				_:
					compiler_bind_type_subst_result(context, subst)
		CompilerRangeType(param_inner):
			match actual_type:
				CompilerRangeType(actual_inner):
					compiler_bind_type_subst(context, param_inner, actual_inner, subst)
				_:
					compiler_bind_type_subst_result(context, subst)
		_:
			compiler_bind_type_subst_result(context, subst)


private pure func compiler_infer_call_args_result(
	context: CompilerInferContext,
	args: List[CompilerTypedExpr],
	subst: List[CompilerTypeSubstEntry],
) -> CompilerInferCallArgsResult:
	{
		context = compiler_infer_context_copy(context),
		args = args,
		subst = subst
	}


private pure func compiler_function_params_contain_generic_param(
	type_param_names: List[String],
	params: List[CompilerType],
) -> Bool:
	params.any(
		func(
			param,
		): compiler_type_contains_call_type_param(
			compiler_string_list_copy(type_param_names),
			param,
		),
	)


private pure func compiler_generic_param_type_can_guide_argument(
	type_param_names: List[String],
	param_type: CompilerType,
) -> Bool:
	if not compiler_type_contains_call_type_param(type_param_names, param_type):
		True
	else:
		match param_type:
			CompilerFunctionType(_, callback_params, _):
				not compiler_function_params_contain_generic_param(
					compiler_string_list_copy(type_param_names),
					callback_params,
				)
			_:
				False


private pure func compiler_generic_argument_bind_type(
	type_param_names: List[String],
	param_type: CompilerType,
	arg: CompilerTypedExpr,
	value_type: CompilerType,
) -> CompilerType:
	dim_param_name: Option[String] = match param_type:
		CompilerTypeVar(name):
			if type_param_names.contains(name) and compiler_is_dim_var_name(name):
				Some(name)
			else:
				None
		CompilerNamedType(name, args):
			if (
				args.length() == 0
				and type_param_names.contains(name)
				and compiler_is_dim_var_name(name)
			):
				Some(name)
			else:
				None
		_:
			None

	match dim_param_name:
		Some(_):
			compiler_static_dim_from_typed_expr(arg).get_or(compiler_type_copy(value_type))
		None:
			compiler_type_copy(value_type)


private pure func compiler_infer_call_args_with_subst(
	context: CompilerInferContext,
	callee: CompilerTypedExpr,
	args: List[ParsedExpr],
	params: List[CompilerType],
	type_param_names: List[String],
	initial_subst: List[CompilerTypeSubstEntry],
) -> CompilerInferCallArgsResult:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var typed_args: List[CompilerTypedExpr] = []
	var subst: List[CompilerTypeSubstEntry] = initial_subst
	var index: Int = 0

	while index < args.length():
		match (args.get(index), params.get(index)):
			(Some(arg), Some(raw_param_type)):
				param_type = compiler_apply_subst(subst, raw_param_type)
				is_generic_param = compiler_type_contains_call_type_param(
					compiler_string_list_copy(type_param_names),
					raw_param_type,
				)
				can_use_expected_type = compiler_generic_param_type_can_guide_argument(
					compiler_string_list_copy(type_param_names),
					param_type,
				)

				arg_context = if can_use_expected_type:
					compiler_infer_with_expected_value_slot(
						next_context,
						param_type,
						CompilerExpectedArgumentSlot,
					)
				else:
					compiler_infer_without_expected(next_context)

				arg_result = compiler_infer_expr(arg_context, arg)
				arg_value_type = compiler_typed_expr_value_type(arg_result.expr)
				arg_bind_type = compiler_generic_argument_bind_type(
					compiler_string_list_copy(type_param_names),
					raw_param_type,
					arg_result.expr,
					arg_value_type,
				)

				bind_result = if is_generic_param:
					compiler_bind_type_subst_with_type_params(
						arg_result.context,
						compiler_string_list_copy(type_param_names),
						raw_param_type,
						arg_bind_type,
						subst,
					)
				else:
					compiler_bind_type_subst_result(arg_result.context, subst)

				subst = bind_result.subst
				owned_arg = compiler_typed_expr_with_info(
					arg_result.expr,
					compiler_typed_expr_info_copy(compiler_typed_expr_info(arg_result.expr)),
				)

				next_context = if is_generic_param:
					compiler_infer_context_copy(bind_result.context)
				else:
					if compiler_types_equal(arg_value_type, param_type):
						compiler_infer_context_copy(bind_result.context)
					else:
						compiler_argument_mismatch_error(
							bind_result.context,
							callee,
							index,
							param_type,
							arg_value_type,
							parsed_expr_span(arg),
						)

				typed_args = typed_args.append(owned_arg)
			_:
				void

		index += 1

	compiler_infer_call_args_result(
		compiler_infer_without_expected(next_context),
		typed_args,
		subst,
	)


private pure func compiler_inferred_call_info(
	context: CompilerInferContext,
	semantic_type: CompilerType,
	resolved_call: Option[CompilerResolvedCallInfo],
) -> CompilerTypedExprInfo:
	compiler_typed_expr_info_from_slot(
		None,
		CompilerInferredOrigin,
		compiler_unrefined_binding(),
		resolved_call,
		compiler_infer_expected_slot(context, semantic_type),
	)


private pure func compiler_typed_module_marker_expr(
	module_ident: ParsedIdentifier,
) -> CompilerTypedExpr:
	CompilerTypedNameExpr(
		module_ident,
		compiler_typed_expr_info_from_slot(
			None,
			CompilerInferredOrigin,
			compiler_unrefined_binding(),
			None,
			compiler_keep_value_slot(CompilerNamedType("Module", [])),
		),
	)


private pure func compiler_typed_qualified_module_field_expr(
	module_ident: ParsedIdentifier,
	field: ParsedIdentifier,
	span: CompilerSourceSpan,
	field_type: CompilerType,
	resolved_call: Option[CompilerResolvedCallInfo],
) -> CompilerTypedExpr:
	CompilerTypedFieldAccessExpr(
		compiler_typed_module_marker_expr(module_ident),
		field,
		span,
		compiler_typed_expr_info_from_slot(
			None,
			CompilerInferredOrigin,
			compiler_unrefined_binding(),
			resolved_call,
			compiler_keep_value_slot(field_type),
		),
	)


private pure func compiler_typed_qualified_module_var_expr(
	module_ident: ParsedIdentifier,
	field: ParsedIdentifier,
	span: CompilerSourceSpan,
	var_symbol: CompilerVarSymbol,
) -> CompilerTypedExpr:
	CompilerTypedFieldAccessExpr(
		compiler_typed_module_marker_expr(module_ident),
		field,
		span,
		compiler_typed_expr_info_from_slot(
			var_symbol.source_type,
			CompilerInferredOrigin,
			compiler_unrefined_binding(),
			None,
			compiler_keep_value_slot(var_symbol.var_type),
		),
	)


private pure func compiler_find_module_constructor(
	context: CompilerInferContext,
	env: CompilerEnv,
	module_path: String,
	name: String,
) -> Option[CompilerConstructorSymbol]:
	var result: Option[CompilerConstructorSymbol] = None

	for ctor in compiler_env_get_constructors(env, name):
		if compiler_typecheck_state_type_home_matches(context.state, ctor.parent_type, module_path):
			result = Some(ctor)
			break

	result


private pure func compiler_typed_qualified_module_constructor_expr(
	context: CompilerInferContext,
	module_ident: ParsedIdentifier,
	field: ParsedIdentifier,
	span: CompilerSourceSpan,
	ctor: CompilerConstructorSymbol,
) -> CompilerInferResult:
	constructor_step = compiler_constructor_expr_type(
		context,
		ctor.parent_type,
		ctor.type_params,
		ctor.field_types,
	)
	constructor_type = constructor_step.typ

	compiler_infer_result(
		constructor_step.context,
		compiler_typed_qualified_module_field_expr(
			module_ident,
			field,
			span,
			constructor_type,
			Some(
				compiler_resolved_call_from_constructor(
					field.text,
					ctor.constructor_id,
					ctor.parent_type,
					constructor_type,
				),
			),
		),
	)


private pure func compiler_infer_qualified_module_callee(
	context: CompilerInferContext,
	callee: ParsedExpr,
) -> Option[CompilerInferResult]:
	match callee:
		ParsedFieldAccessExpr(receiver, field, span):
			match receiver:
				ParsedNameExpr(module_ident):
					match compiler_typecheck_state_find_module_alias(
						context.state,
						module_ident.text,
					):
						Some(module_path):
							match compiler_env_get_module_func_symbol(
								context.state.env,
								module_path,
								field.text,
							):
								Some(func_symbol):
									typed = compiler_typed_qualified_module_field_expr(
										module_ident,
										field,
										span,
										func_symbol.func_type,
										Some(
											compiler_resolved_call_from_func_symbol(
												field.text,
												func_symbol,
											),
										),
									)
									Some(compiler_infer_result(context, typed))
								None:
									match compiler_find_module_constructor(
										context,
										context.state.env,
										module_path,
										field.text,
									):
										Some(ctor):
											Some(
												compiler_typed_qualified_module_constructor_expr(
													context,
													module_ident,
													field,
													span,
													ctor,
												),
											)
										None:
											None
						None:
							None
				_:
					None
		_:
			None


private pure func compiler_infer_qualified_module_field_expr(
	context: CompilerInferContext,
	receiver: ParsedExpr,
	field: ParsedIdentifier,
	span: CompilerSourceSpan,
) -> Option[CompilerInferResult]:
	match receiver:
		ParsedNameExpr(module_ident):
			match compiler_typecheck_state_find_module_alias(context.state, module_ident.text):
				Some(module_path):
					match compiler_env_get_module_func_symbol(
						context.state.env,
						module_path,
						field.text,
					):
						Some(func_symbol):
							next_context = compiler_check_debug_only_reference(
								context,
								field.text,
								func_symbol.debug_only,
							)
							typed = compiler_typed_qualified_module_field_expr(
								module_ident,
								field,
								span,
								func_symbol.func_type,
								Some(
									compiler_resolved_call_from_func_symbol(
										field.text,
										func_symbol,
									),
								),
							)
							Some(compiler_infer_result(next_context, typed))
						None:
							match compiler_env_get_module_var_symbol(
								context.state.env,
								module_path,
								field.text,
							):
								Some(var_symbol):
									typed = compiler_typed_qualified_module_var_expr(
										module_ident,
										field,
										span,
										var_symbol,
									)
									Some(compiler_infer_result(context, typed))
								None:
									match compiler_find_module_constructor(
										context,
										context.state.env,
										module_path,
										field.text,
									):
										Some(ctor):
											Some(
												compiler_typed_qualified_module_constructor_expr(
													context,
													module_ident,
													field,
													span,
													ctor,
												),
											)
										None:
											next = compiler_infer_error(
												context,
												"Module alias `" + module_ident.text + "` for module `" + module_path + "` has no value or function `" + field.text + "`",
											)
											typed = compiler_typed_qualified_module_field_expr(
												module_ident,
												field,
												span,
												compiler_type_void(),
												None,
											)
											Some(compiler_infer_result(next, typed))
				None:
					None
		_:
			None


private pure func compiler_missing_qualified_module_call_result(
	context: CompilerInferContext,
	callee: ParsedExpr,
	span: CompilerSourceSpan,
) -> Option[CompilerInferResult]:
	match callee:
		ParsedFieldAccessExpr(receiver, field, field_span):
			match receiver:
				ParsedNameExpr(module_ident):
					match compiler_typecheck_state_find_module_alias(
						context.state,
						module_ident.text,
					):
						Some(module_path):
							if (
								compiler_env_get_module_func_symbol(
									context.state.env,
									module_path,
									field.text,
								).is_some()
								or compiler_find_module_constructor(
									context,
									context.state.env,
									module_path,
									field.text,
								).is_some()
							):
								None
							else:
								next = compiler_infer_error(
									context,
									"Module alias `" + module_ident.text + "` for module `" + module_path + "` has no function `" + field.text + "`",
								)
								typed_callee = compiler_typed_qualified_module_field_expr(
									module_ident,
									field,
									field_span,
									compiler_type_void(),
									None,
								)
								typed = CompilerTypedCallExpr(
									typed_callee,
									[],
									span,
									compiler_inferred_call_info(next, compiler_type_void(), None),
								)
								Some(compiler_infer_result(next, typed))
						None:
							None
				_:
					None
		_:
			None


private pure func compiler_bare_overload_first_arg_type(
	context: CompilerInferContext,
	args: List[ParsedExpr],
) -> Option[CompilerType]:
	match args.get(0):
		Some(first_arg):
			first_arg_result = compiler_infer_expr(
				compiler_infer_without_expected(context),
				first_arg,
			)

			if first_arg_result.context.state.errors.length() == context.state.errors.length():
				Some(compiler_typed_expr_value_type(first_arg_result.expr))
			else:
				None
		None:
			None


private pure func compiler_bare_overload_arg_types(
	context: CompilerInferContext,
	args: List[ParsedExpr],
) -> Option[List[CompilerType]]:
	var arg_types: List[CompilerType] = []
	var ok: Bool = True

	for arg in args:
		if ok:
			arg_result = compiler_infer_expr(compiler_infer_without_expected(context), arg)

			if arg_result.context.state.errors.length() == context.state.errors.length():
				arg_types = arg_types.append(
					compiler_type_copy(compiler_typed_expr_value_type(arg_result.expr)),
				)
			else:
				ok = False

	if ok:
		Some(arg_types)
	else:
		None


private pure func compiler_bare_overload_callee_result(
	context: CompilerInferContext,
	name: ParsedIdentifier,
	entry: CompilerOverloadEntry,
) -> CompilerInferResult:
	source_name = compiler_source_name_for_overload_entry(context, name.text, entry)
	typed = CompilerTypedNameExpr(
		name,
		compiler_typed_expr_info_from_slot(
			None,
			CompilerInferredOrigin,
			compiler_unrefined_binding(),
			Some(compiler_resolved_call_from_overload_entry(name.text, source_name, entry)),
			compiler_keep_value_slot(entry.func_type),
		),
	)
	compiler_infer_result(context, typed)


private pure func compiler_infer_bare_overload_callee(
	context: CompilerInferContext,
	callee: ParsedExpr,
	args: List[ParsedExpr],
) -> Option[CompilerInferResult]:
	match callee:
		ParsedNameExpr(name):
			match compiler_lookup_bare_symbol(context, name):
				Some(_):
					None
				None:
					overloads = compiler_env_get_overloads(context.state.env, name.text)

					if overloads.length() == 0:
						None
					else:
						match compiler_bare_overload_arg_types(context, args):
							Some(arg_types):
								match compiler_env_select_overload_for_args(overloads, arg_types):
									Some(entry):
										Some(
											compiler_bare_overload_callee_result(
												context,
												name,
												entry,
											),
										)
									None:
										match arg_types.get(0):
											Some(first_arg_type):
												match compiler_env_resolve_overload(
													context.state.env,
													name.text,
													first_arg_type,
												):
													Some(entry):
														Some(
															compiler_bare_overload_callee_result(
																context,
																name,
																entry,
															),
														)
													None:
														None
											None:
												None
							None:
								None
		_:
			None


private pure func compiler_missing_bare_overload_call_result(
	context: CompilerInferContext,
	callee: ParsedExpr,
	args: List[ParsedExpr],
	span: CompilerSourceSpan,
) -> Option[CompilerInferResult]:
	match callee:
		ParsedNameExpr(name):
			match compiler_lookup_bare_symbol(context, name):
				Some(_):
					None
				None:
					if compiler_env_get_overloads(context.state.env, name.text).length() == 0:
						None
					else:
						match compiler_bare_overload_first_arg_type(context, args):
							Some(first_arg_type):
								if compiler_env_resolve_overload(
									context.state.env,
									name.text,
									first_arg_type,
								).is_some():
									None
								else:
									next = compiler_infer_error(
										context,
										"No overload `" + name.text + "` matches first argument type " + compiler_type_to_string(
											first_arg_type,
										),
									)
									typed_callee = CompilerTypedNameExpr(
										name,
										compiler_inferred_info(next, compiler_type_void()),
									)
									typed = CompilerTypedCallExpr(
										typed_callee,
										[],
										span,
										compiler_inferred_call_info(
											next,
											compiler_type_void(),
											None,
										),
									)
									Some(compiler_infer_result(next, typed))
							None:
								None
		_:
			None


private pure func compiler_bare_callee_is_constructor(
	context: CompilerInferContext,
	name: ParsedIdentifier,
) -> Bool:
	match compiler_lookup_bare_symbol(context, name):
		Some(symbol):
			match symbol.kind:
				CompilerConstructorSymbolKind(_):
					True
				_:
					False
		None:
			False


private pure func compiler_qualified_callee_is_constructor(
	context: CompilerInferContext,
	receiver: ParsedExpr,
	field: ParsedIdentifier,
) -> Bool:
	match receiver:
		ParsedNameExpr(module_ident):
			match compiler_typecheck_state_find_module_alias(context.state, module_ident.text):
				Some(module_path):
					compiler_find_module_constructor(
						context,
						context.state.env,
						module_path,
						field.text,
					).is_some()
				None:
					False
		_:
			False


private pure func compiler_call_callee_context(
	context: CompilerInferContext,
	callee: ParsedExpr,
) -> CompilerInferContext:
	is_constructor = match callee:
		ParsedNameExpr(name):
			compiler_bare_callee_is_constructor(context, name)
		ParsedFieldAccessExpr(receiver, field, _):
			compiler_qualified_callee_is_constructor(context, receiver, field)
		_:
			False

	if is_constructor:
		compiler_infer_context_copy(context)
	else:
		compiler_infer_without_expected(context)


private pure func compiler_types_after_first(types: List[CompilerType]) -> List[CompilerType]:
	var result: List[CompilerType] = []
	var index: Int = 1

	while index < types.length():
		match types.get(index):
			Some(typ):
				result = result.append(typ)
			None:
				void

		index += 1

	result


private pure func compiler_resolved_entry_bound_type_params(
	context: CompilerInferContext,
	resolved_call: CompilerResolvedCallInfo,
) -> Option[List[CompilerBoundTypeParam]]:
	match compiler_resolved_call_callable_id(resolved_call):
		Some(callable_id):
			compiler_env_find_callable_type_params_by_def_id(context.state.env, callable_id)
		None:
			None


private pure func compiler_declared_callee_bound_type_params(
	context: CompilerInferContext,
	callee: CompilerTypedExpr,
) -> List[CompilerBoundTypeParam]:
	match callee:
		CompilerTypedNameExpr(name, _):
			match compiler_env_get_func_info(context.state.env, name.text):
				Some((_, type_params, _)):
					type_params
				None:
					[]
		CompilerTypedFieldAccessExpr(receiver, field, _, _):
			match receiver:
				CompilerTypedNameExpr(module_ident, _):
					match compiler_typecheck_state_find_module_alias(
						context.state,
						module_ident.text,
					):
						Some(module_path):
							match compiler_env_get_module_func_symbol(
								context.state.env,
								module_path,
								field.text,
							):
								Some(func_symbol):
									func_symbol.type_params
								None:
									[]
						None:
							[]
				_:
					[]
		_:
			[]


private pure func compiler_callee_bound_type_params(
	context: CompilerInferContext,
	callee: CompilerTypedExpr,
) -> List[CompilerBoundTypeParam]:
	match compiler_typed_expr_resolved_call(callee):
		Some(resolved_call):
			match compiler_resolved_entry_bound_type_params(context, resolved_call):
				Some(type_params):
					type_params
				None:
					compiler_declared_callee_bound_type_params(context, callee)
		None:
			compiler_declared_callee_bound_type_params(context, callee)


private pure func compiler_call_trait_bound_error(
	context: CompilerInferContext,
	callee_name: String,
	concrete_type: CompilerType,
	trait_name: String,
) -> CompilerInferContext:
	match concrete_type:
		CompilerTypeVar(name):
			compiler_infer_error(
				context,
				"Type parameter " + name + " does not have bound " + trait_name + " (required by " + callee_name + ")",
			)
		_:
			compiler_infer_error(
				context,
				"Type " + compiler_type_to_string(
					concrete_type,
				) + " does not implement trait " + trait_name + " (required by " + callee_name + ")",
			)


private pure func compiler_check_call_trait_bounds_for_params(
	context: CompilerInferContext,
	callee: CompilerTypedExpr,
	bound_params: List[CompilerBoundTypeParam],
	subst: List[CompilerTypeSubstEntry],
) -> CompilerInferContext:
	callee_name = match compiler_typed_expr_resolved_call(callee):
		Some(info):
			info.callee_name
		None:
			"<function>"

	var next: CompilerInferContext = compiler_infer_context_copy(context)

	for param in bound_params:
		match compiler_find_type_subst(subst, param.name):
			Some(concrete_type):
				obligations = compiler_trait_obligations_for_bound_type_param(param, concrete_type)

				match compiler_env_find_unsatisfied_trait_obligation(next.state.env, obligations):
					Some(obligation):
						next = compiler_call_trait_bound_error(
							next,
							callee_name,
							concrete_type,
							obligation.obligation_trait.name,
						)
					None:
						void
			None:
				void

	next


private pure func compiler_resolved_call_is_trait_method(
	resolved_call: Option[CompilerResolvedCallInfo],
) -> Bool:
	match resolved_call:
		Some(call):
			compiler_resolved_call_is_trait_target(call)
		None:
			False


private pure func compiler_trait_self_type_from_call(
	context: CompilerInferContext,
	args: List[ParsedExpr],
) -> Option[CompilerType]:
	match args.get(0):
		Some(first_arg):
			first_arg_result = compiler_infer_expr(
				compiler_infer_without_expected(context),
				first_arg,
			)

			if first_arg_result.context.state.errors.length() == context.state.errors.length():
				Some(
					compiler_widening_value_type(
						compiler_method_receiver_slot(
							compiler_typed_expr_semantic_type(first_arg_result.expr),
						),
					),
				)
			else:
				None
		None:
			match context.expected_type:
				Some(expected_type):
					Some(compiler_type_copy(expected_type))
				None:
					None


private pure func compiler_check_trait_method_self_bound(
	context: CompilerInferContext,
	resolved_call: Option[CompilerResolvedCallInfo],
	self_type: CompilerType,
) -> CompilerInferContext:
	match resolved_call:
		Some(call):
			match compiler_resolved_call_trait_name(call):
				Some(trait_name):
					match compiler_env_find_unsatisfied_trait_obligation(
						context.state.env,
						[compiler_trait_obligation(self_type, trait_name)],
					):
						Some(obligation):
							compiler_call_trait_bound_error(
								context,
								call.callee_name,
								self_type,
								obligation.obligation_trait.name,
							)
						None:
							context
				None:
					context
		None:
			context


private pure func compiler_resolve_trait_self_call(
	context: CompilerInferContext,
	callee: CompilerTypedExpr,
	args: List[ParsedExpr],
	is_pure: Bool,
	params: List[CompilerType],
	return_type: CompilerType,
	resolved_call: Option[CompilerResolvedCallInfo],
) -> CompilerTraitSelfCallResolution:
	if (
		compiler_resolved_call_is_trait_method(resolved_call)
		and (params.any(compiler_type_contains_self) or compiler_type_contains_self(return_type))
	):
		match compiler_trait_self_type_from_call(context, args):
			Some(self_type):
				resolved_params = params.map(func(param): compiler_resolve_self(self_type, param))
				resolved_return = compiler_resolve_self(self_type, return_type)
				resolved_func_type = CompilerFunctionType(is_pure, resolved_params, resolved_return)
				info = compiler_typed_expr_info(callee)
				updated_resolved_call = compiler_optional_resolved_call_with_instantiated_signature(
					resolved_call,
					resolved_params,
					resolved_return,
				)

				resource_args = match updated_resolved_call:
					Some(call):
						match compiler_resolved_call_trait_name(call):
							Some(trait_name):
								compiler_trait_method_resource_args_for_type(
									context,
									trait_name,
									call.callee_name,
									self_type,
									call.resource_args,
								)
							None:
								call.resource_args
					None:
						CompilerRejectResourceArgs

				final_resolved_call = match updated_resolved_call:
					Some(call):
						Some(compiler_resolved_call_with_resource_args(call, resource_args))
					None:
						empty: Option[CompilerResolvedCallInfo] = None
						empty

				updated_info = { info |
					semantic_type = resolved_func_type,
					value_type = resolved_func_type,
					value_slot = compiler_keep_value_slot(resolved_func_type),
					resolved_call = final_resolved_call
				}
				checked_context = compiler_check_trait_method_self_bound(
					context,
					resolved_call,
					self_type,
				)
				{
					context = checked_context,
					callee = compiler_typed_expr_with_info(callee, updated_info),
					params = resolved_params,
					return_type = resolved_return,
					resolved_call = final_resolved_call
				}
			None:
				{
					context = context,
					callee = callee,
					params = params,
					return_type = return_type,
					resolved_call = resolved_call
				}
	else:
		{
			context = context,
			callee = callee,
			params = params,
			return_type = return_type,
			resolved_call = resolved_call
		}


private pure func compiler_dim_constraint_error(
	context: CompilerInferContext,
	callee_name: String,
	lhs: CompilerType,
	rhs: CompilerType,
	resolved_lhs: CompilerType,
	resolved_rhs: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Dimension constraint violated in call to '" + callee_name + "'\n   = constraint: " + compiler_type_to_string(
			lhs,
		) + " == " + compiler_type_to_string(
			rhs,
		) + "\n   = but: " + compiler_type_to_string(
			resolved_lhs,
		) + " != " + compiler_type_to_string(resolved_rhs),
	)


private pure func compiler_dim_constraint_solved(result: CompilerDimSolveResult) -> Bool:
	match result:
		CompilerDimSolved:
			True
		CompilerDimBindMeta(_, _):
			False
		CompilerDimBindVar(_, _):
			False
		CompilerDimContradiction:
			False
		CompilerDimStuck:
			False


private pure func compiler_check_call_dim_constraints(
	context: CompilerInferContext,
	resolved_call: Option[CompilerResolvedCallInfo],
	subst: List[CompilerTypeSubstEntry],
) -> CompilerInferContext:
	match resolved_call:
		Some(call):
			var next: CompilerInferContext = compiler_infer_context_copy(context)

			for constraint in call.dim_constraints:
				lhs = constraint[0]
				rhs = constraint[1]
				resolved_lhs = compiler_apply_subst(subst, lhs)
				resolved_rhs = compiler_apply_subst(subst, rhs)

				if not compiler_dim_constraint_solved(
					compiler_dim_solve(
						[],
						resolved_lhs,
						resolved_rhs,
					),
				):
					next = compiler_dim_constraint_error(
						next,
						call.callee_name,
						lhs,
						rhs,
						resolved_lhs,
						resolved_rhs,
					)

			next
		None:
			compiler_infer_context_copy(context)


private pure func compiler_call_allows_resource_args(
	resolved_call: Option[CompilerResolvedCallInfo],
) -> Bool:
	match resolved_call:
		Some(call):
			match call.resource_args:
				CompilerAllowResourceArgs(_):
					True
				CompilerRejectResourceArgs:
					False
		None:
			False


private pure func compiler_resolved_call_display_name(
	resolved_call: Option[CompilerResolvedCallInfo],
) -> String:
	match resolved_call:
		Some(call):
			call.callee_name
		None:
			"<function>"


private pure func compiler_resolved_call_is_debug_only(
	context: CompilerInferContext,
	resolved_call: Option[CompilerResolvedCallInfo],
) -> Bool:
	match resolved_call:
		Some(call):
			match compiler_resolved_call_callable_id(call):
				Some(callable_id):
					match compiler_env_find_callable_debug_only_by_def_id(
						context.state.env,
						callable_id,
					):
						Some(debug_only):
							debug_only
						None:
							False
				None:
					False
		None:
			False


private pure func compiler_check_debug_only_reference(
	context: CompilerInferContext,
	name: String,
	debug_only: Bool,
) -> CompilerInferContext:
	if (
		debug_only
		and not context.suppress_debug_only_reference
		and not context.in_debug
		and not context.state.allow_debug_only_calls
	):
		compiler_infer_error(
			context,
			"debug-only function '" + name + "' can only be used inside a debug: block",
		)
	else:
		context


private pure func compiler_check_debug_only_call(
	context: CompilerInferContext,
	resolved_call: Option[CompilerResolvedCallInfo],
) -> CompilerInferContext:
	if compiler_resolved_call_is_debug_only(context, resolved_call):
		compiler_check_debug_only_reference(
			context,
			compiler_resolved_call_display_name(resolved_call),
			True,
		)
	else:
		context


private pure func compiler_is_direct_scoped_resource_arg(
	context: CompilerInferContext,
	arg: CompilerTypedExpr,
) -> Bool:
	match arg:
		CompilerTypedNameExpr(name, _):
			compiler_env_is_scoped_resource_var(context.state.env, name.text)
		_:
			False


private pure func compiler_check_resource_operation_arg(
	context: CompilerInferContext,
	resolved_call: Option[CompilerResolvedCallInfo],
	arg: CompilerTypedExpr,
) -> CompilerInferContext:
	unavailable_context = match arg:
		CompilerTypedNameExpr(name, _):
			match compiler_env_scoped_resource_unavailable_owner(context.state.env, name.text):
				Some(owner):
					compiler_infer_error(
						context,
						"scoped resource `" + name.text + "` is unavailable while " + owner + " is in scope",
					)
				None:
					context
		_:
			context

	if unavailable_context.state.errors.length() > context.state.errors.length():
		unavailable_context
	else:
		arg_type = compiler_typed_expr_value_type(arg)

		if (
			compiler_type_contains_resource(unavailable_context, arg_type)
			and not compiler_is_direct_scoped_resource_arg(unavailable_context, arg)
		):
			compiler_infer_error(
				unavailable_context,
				(
					"resource argument to compiler-owned resource operation must be a scoped with "
					+ "binding `"
				) + compiler_resolved_call_display_name(resolved_call) + "`",
			)
		else:
			unavailable_context


private pure func compiler_check_ordinary_call_arg(
	context: CompilerInferContext,
	resolved_call: Option[CompilerResolvedCallInfo],
	arg: CompilerTypedExpr,
) -> CompilerInferContext:
	arg_type = compiler_typed_expr_value_type(arg)
	callee_name = compiler_resolved_call_display_name(resolved_call)

	if compiler_type_contains_resource(context, arg_type):
		compiler_infer_error(
			context,
			"scoped resource value cannot be passed to ordinary call `" + callee_name + "`",
		)
	else:
		refs = compiler_typed_expr_resource_dependency_refs(context, arg)

		if refs.length() > 0:
			compiler_infer_error(
				context,
				"scoped resource-derived value cannot be passed to ordinary call `" + callee_name + "`",
			)
		else:
			context


private pure func compiler_check_call_resource_args(
	context: CompilerInferContext,
	resolved_call: Option[CompilerResolvedCallInfo],
	args: List[CompilerTypedExpr],
) -> CompilerInferContext:
	var next_context = compiler_infer_context_copy(context)
	allow_resource_args = compiler_call_allows_resource_args(resolved_call)

	for arg in args:
		next_context = if allow_resource_args:
			compiler_check_resource_operation_arg(next_context, resolved_call, arg)
		else:
			compiler_check_ordinary_call_arg(next_context, resolved_call, arg)

	next_context


private pure func compiler_bind_expected_return_subst(
	context: CompilerInferContext,
	type_param_names: List[String],
	return_type: CompilerType,
	subst: List[CompilerTypeSubstEntry],
) -> CompilerBindTypeSubstResult:
	match context.expected_type:
		Some(expected_type):
			resolved_return_type = compiler_env_resolve_alias(context.state.env, return_type)
			resolved_expected_type = compiler_env_resolve_alias(context.state.env, expected_type)

			if compiler_type_contains_call_type_param(
				compiler_string_list_copy(type_param_names),
				resolved_return_type,
			):
				compiler_bind_type_subst_with_type_params(
					context,
					compiler_string_list_copy(type_param_names),
					resolved_return_type,
					resolved_expected_type,
					subst,
				)
			else:
				compiler_bind_type_subst_result(context, subst)
		None:
			compiler_bind_type_subst_result(context, subst)


private pure func compiler_callable_value_type(
	context: CompilerInferContext,
	value_type: CompilerType,
) -> CompilerType:
	compiler_env_resolve_alias(context.state.env, value_type)


private pure func compiler_refined_length_return_type(
	arg_type: CompilerType,
	fallback: CompilerType,
) -> CompilerType:
	match compiler_array_type_parts(arg_type):
		Some((_, dims)):
			match dims.get(0):
				Some(CompilerConstIntType(size)):
					CompilerConstIntType(size)
				Some(CompilerTypeVar(name)):
					if compiler_is_dim_var_name(name):
						CompilerTypeVar(name)
					else:
						compiler_type_copy(fallback)
				Some(CompilerDimOpType(op, left, right)):
					compiler_normalize_dim(
						CompilerDimOpType(
							op,
							compiler_type_copy(left),
							compiler_type_copy(right),
						),
					)
				_:
					compiler_type_copy(fallback)
		None:
			compiler_type_copy(fallback)


private pure func compiler_static_dim_from_type(typ: CompilerType) -> Option[CompilerType]:
	match typ:
		CompilerConstIntType(_):
			Some(compiler_type_copy(typ))
		CompilerTypeVar(name):
			if compiler_is_dim_var_name(name):
				Some(compiler_type_copy(typ))
			else:
				None
		CompilerNamedType(name, args):
			if args.length() == 0 and compiler_is_dim_var_name(name):
				Some(CompilerTypeVar(name))
			else:
				None
		CompilerDimOpType(_, _, _):
			Some(compiler_normalize_dim(compiler_type_copy(typ)))
		_:
			None


private pure func compiler_binary_dim_op(op: ParsedBinaryOp) -> Option[CompilerDimOp]:
	match op:
		ParsedAddOp:
			Some(CompilerDimAdd)
		ParsedSubtractOp:
			Some(CompilerDimSubtract)
		ParsedMultiplyOp:
			Some(CompilerDimMultiply)
		ParsedDivideOp:
			Some(CompilerDimDivide)
		_:
			None


private pure func compiler_static_dim_from_typed_expr(
	expr: CompilerTypedExpr,
) -> Option[CompilerType]:
	semantic_dim = compiler_static_dim_from_type(compiler_typed_expr_semantic_type(expr))

	match expr:
		CompilerTypedIntLiteralExpr(text, _, _):
			text
				.parse_int()
				.map(func(value): CompilerConstIntType(value))
		CompilerTypedBinaryExpr(op, left, right, _, _):
			match (
				compiler_binary_dim_op(op),
				compiler_static_dim_from_typed_expr(left),
				compiler_static_dim_from_typed_expr(right),
			):
				(Some(dim_op), Some(left_dim), Some(right_dim)):
					Some(compiler_normalize_dim(CompilerDimOpType(dim_op, left_dim, right_dim)))
				_:
					semantic_dim
		CompilerTypedCallExpr(_, args, _, info):
			call_name = compiler_resolved_call_display_name(info.resolved_call)

			if (call_name == "length" or call_name == "vector_length") and args.length() == 1:
				match args.get(0):
					Some(arg):
						match compiler_array_type_parts(compiler_typed_expr_semantic_type(arg)):
							Some((_, dims)):
								match dims.get(0):
									Some(dim):
										match compiler_static_dim_from_type(dim):
											Some(result):
												Some(result)
											None:
												semantic_dim
									None:
										semantic_dim
							None:
								semantic_dim
					None:
						semantic_dim
			else:
				semantic_dim
		_:
			semantic_dim


private pure func compiler_static_constructor_dims(
	args: List[CompilerTypedExpr],
	rank: Int,
) -> Option[List[CompilerType]]:
	var dims: List[CompilerType] = []
	var index: Int = 0
	var complete: Bool = True

	while index < rank and complete:
		match args.get(index + 1):
			Some(arg):
				match compiler_static_dim_from_typed_expr(arg):
					Some(dim):
						dims = dims.append(dim)
					None:
						complete = False
			None:
				complete = False

		index += 1

	if complete and dims.length() == rank:
		Some(dims)
	else:
		None


private pure func compiler_refined_tensor_constructor_return_type(
	args: List[CompilerTypedExpr],
	rank: Int,
	fallback: CompilerType,
) -> CompilerType:
	match (args.get(0), compiler_static_constructor_dims(args, rank)):
		(Some(value), Some(dims)):
			element_type = match compiler_array_type_parts(fallback):
				Some((element, _)):
					compiler_type_copy(element)
				None:
					compiler_typed_expr_semantic_type(value)

			CompilerArrayType(element_type, dims)
		_:
			compiler_type_copy(fallback)


private pure func compiler_refined_builtin_return_type(
	resolved_call: Option[CompilerResolvedCallInfo],
	args: List[CompilerTypedExpr],
	fallback: CompilerType,
) -> CompilerType:
	name = compiler_resolved_call_display_name(resolved_call)
	special_inference = compiler_builtin_special_inference(name)

	match special_inference:
		Some(CompilerVectorCtorInference):
			compiler_refined_tensor_constructor_return_type(args, 1, fallback)
		Some(CompilerMatrixCtorInference):
			compiler_refined_tensor_constructor_return_type(args, 2, fallback)
		Some(CompilerTensorCtorInference(rank)):
			compiler_refined_tensor_constructor_return_type(args, rank, fallback)
		_:
			if (name == "length" or name == "vector_length") and args.length() == 1:
				match args.get(0):
					Some(arg):
						compiler_refined_length_return_type(
							compiler_typed_expr_semantic_type(arg),
							fallback,
						)
					None:
						compiler_type_copy(fallback)
			else:
				compiler_type_copy(fallback)


private pure func compiler_infer_call_with_callee_result(
	context: CompilerInferContext,
	callee_result: CompilerInferResult,
	args: List[ParsedExpr],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	callee_type = compiler_callable_value_type(
		compiler_infer_context_with_state(context, callee_result.context.state),
		compiler_typed_expr_value_type(callee_result.expr),
	)
	resolved_call = compiler_typed_expr_resolved_call(callee_result.expr)

	match callee_type:
		CompilerFunctionType(is_pure, raw_params, raw_return_type):
			initial_resolved_call = match resolved_call:
				Some(_):
					resolved_call
				None:
					Some(compiler_resolved_call_from_closure(is_pure, raw_params, raw_return_type))

			self_resolution = compiler_resolve_trait_self_call(
				compiler_infer_context_with_state(context, callee_result.context.state),
				callee_result.expr,
				args,
				is_pure,
				raw_params,
				raw_return_type,
				initial_resolved_call,
			)
			params = self_resolution.params
			return_type = self_resolution.return_type
			self_resolved_call = self_resolution.resolved_call
			callee_expr = self_resolution.callee
			signature = compiler_call_signature(
				self_resolution.context,
				compiler_callee_bound_type_params(context, callee_expr),
				params,
				return_type,
			)
			call_params = signature.params
			call_return_type = signature.return_type
			type_param_names: List[String] = compiler_bound_type_param_names(signature.bound_params)

			if call_params.length() != args.length():
				next = compiler_call_arity_error(
					compiler_infer_without_expected(self_resolution.context),
					callee_expr,
					call_params.length(),
					args.length(),
				)
				typed = CompilerTypedCallExpr(
					callee_expr,
					[],
					span,
					compiler_inferred_call_info(next, compiler_type_void(), self_resolved_call),
				)
				compiler_infer_result(next, typed)
			else:
				initial_return_bind = compiler_bind_expected_return_subst(
					self_resolution.context,
					type_param_names,
					call_return_type,
					[],
				)
				arg_result = compiler_infer_call_args_with_subst(
					initial_return_bind.context,
					callee_expr,
					args,
					call_params,
					type_param_names,
					initial_return_bind.subst,
				)
				result_context = compiler_infer_context_with_state(
					context,
					arg_result.context.state,
				)
				return_bind = compiler_bind_expected_return_subst(
					result_context,
					type_param_names,
					call_return_type,
					arg_result.subst,
				)
				complete_subst = compiler_complete_call_type_subst(
					return_bind.context,
					signature.bound_params,
					return_bind.subst,
				)
				checked_context = compiler_check_call_trait_bounds_for_params(
					complete_subst.context,
					callee_expr,
					signature.bound_params,
					complete_subst.subst,
				)
				dim_checked_context = compiler_check_call_dim_constraints(
					checked_context,
					self_resolved_call,
					complete_subst.subst,
				)
				debug_checked_context = compiler_check_debug_only_call(
					dim_checked_context,
					self_resolved_call,
				)
				resource_checked_context = compiler_check_call_resource_args(
					debug_checked_context,
					self_resolved_call,
					arg_result.args,
				)
				resolved_param_types = call_params.map(
					func(param): compiler_apply_subst(complete_subst.subst, param),
				)
				resolved_return_type = compiler_refined_builtin_return_type(
					self_resolved_call,
					arg_result.args,
					compiler_apply_subst(complete_subst.subst, call_return_type),
				)
				instantiated_resolved_call = compiler_optional_resolved_call_with_instantiated_signature(
					self_resolved_call,
					resolved_param_types,
					resolved_return_type,
				)
				typed = CompilerTypedCallExpr(
					callee_expr,
					arg_result.args,
					span,
					compiler_inferred_call_info(
						resource_checked_context,
						resolved_return_type,
						instantiated_resolved_call,
					),
				)
				compiler_infer_result(resource_checked_context, typed)
		_:
			next = compiler_infer_error(
				compiler_infer_without_expected(callee_result.context),
				"Cannot call non-function type: " + compiler_type_to_string(callee_type),
			)
			typed = CompilerTypedCallExpr(
				callee_result.expr,
				[],
				span,
				compiler_inferred_call_info(next, compiler_type_void(), resolved_call),
			)
			compiler_infer_result(next, typed)


private pure func compiler_parsed_args_after_first(args: List[ParsedExpr]) -> List[ParsedExpr]:
	var result: List[ParsedExpr] = []
	var index: Int = 1

	while index < args.length():
		match args.get(index):
			Some(arg):
				result = result.append(arg)
			None:
				void

		index += 1

	result


private pure func compiler_parsed_args_with_receiver(
	receiver: ParsedExpr,
	args: List[ParsedExpr],
) -> List[ParsedExpr]:
	[receiver].concat(args)


private pure func compiler_trait_method_ufcs_resource_args(
	context: CompilerInferContext,
	method_callee: CompilerTraitMethodCallee,
	receiver: ParsedExpr,
) -> CompilerResourceArgPolicy:
	receiver_result = compiler_infer_expr(compiler_infer_without_expected(context), receiver)

	if receiver_result.context.state.errors.length() != context.state.errors.length():
		CompilerRejectResourceArgs
	else:
		receiver_type = compiler_typed_expr_value_type(receiver_result.expr)

		compiler_trait_method_resource_args_for_type(
			context,
			method_callee.trait_name,
			method_callee.method_name,
			receiver_type,
			CompilerRejectResourceArgs,
		)


private pure func compiler_infer_ufcs_call_with_receiver_result(
	context: CompilerInferContext,
	receiver_result: CompilerInferResult,
	method: ParsedIdentifier,
	entry: CompilerOverloadEntry,
	args: List[ParsedExpr],
	span: CompilerSourceSpan,
) -> Option[CompilerInferResult]:
	source_name = compiler_source_name_for_overload_entry(context, method.text, entry)
	resolved_call = compiler_resolved_call_from_overload_entry(method.text, source_name, entry)
	callee_expr = CompilerTypedNameExpr(
		method,
		compiler_typed_expr_info_from_slot(
			None,
			CompilerInferredOrigin,
			compiler_unrefined_binding(),
			Some(resolved_call),
			compiler_keep_value_slot(entry.func_type),
		),
	)

	match entry.func_type:
		CompilerFunctionType(_, params, return_type):
			signature = compiler_call_signature(context, entry.type_params, params, return_type)
			call_params = signature.params
			call_return_type = signature.return_type
			expected_arg_count = call_params.length() - 1

			if expected_arg_count != args.length():
				next = compiler_call_arity_error(
					compiler_infer_without_expected(receiver_result.context),
					callee_expr,
					expected_arg_count,
					args.length(),
				)
				typed = CompilerTypedCallExpr(
					callee_expr,
					[receiver_result.expr],
					span,
					compiler_inferred_call_info(next, compiler_type_void(), Some(resolved_call)),
				)
				Some(compiler_infer_result(next, typed))
			else:
				match call_params.get(0):
					Some(receiver_param):
						type_param_names: List[String] = compiler_bound_type_param_names(
							signature.bound_params,
						)
						receiver_type = compiler_typed_expr_value_type(receiver_result.expr)
						receiver_bind = compiler_bind_type_subst_with_type_params(
							receiver_result.context,
							type_param_names,
							receiver_param,
							receiver_type,
							[],
						)
						initial_return_bind = compiler_bind_expected_return_subst(
							receiver_bind.context,
							type_param_names,
							call_return_type,
							receiver_bind.subst,
						)
						arg_result = compiler_infer_call_args_with_subst(
							initial_return_bind.context,
							callee_expr,
							args,
							compiler_types_after_first(call_params),
							type_param_names,
							initial_return_bind.subst,
						)
						result_context = compiler_infer_context_with_state(
							context,
							arg_result.context.state,
						)
						return_bind = compiler_bind_expected_return_subst(
							result_context,
							type_param_names,
							call_return_type,
							arg_result.subst,
						)
						complete_subst = compiler_complete_call_type_subst(
							return_bind.context,
							signature.bound_params,
							return_bind.subst,
						)
						checked_context = compiler_check_call_trait_bounds_for_params(
							complete_subst.context,
							callee_expr,
							signature.bound_params,
							complete_subst.subst,
						)
						dim_checked_context = compiler_check_call_dim_constraints(
							checked_context,
							Some(resolved_call),
							complete_subst.subst,
						)
						debug_checked_context = compiler_check_debug_only_call(
							dim_checked_context,
							Some(resolved_call),
						)
						resource_checked_context = compiler_check_call_resource_args(
							debug_checked_context,
							Some(resolved_call),
							[receiver_result.expr].concat(arg_result.args),
						)
						resolved_param_types = call_params.map(
							func(param): compiler_apply_subst(complete_subst.subst, param),
						)
						call_args = [receiver_result.expr].concat(arg_result.args)
						resolved_return_type = compiler_refined_builtin_return_type(
							Some(resolved_call),
							call_args,
							compiler_apply_subst(complete_subst.subst, call_return_type),
						)
						instantiated_resolved_call = compiler_resolved_call_with_instantiated_signature(
							resolved_call,
							resolved_param_types,
							resolved_return_type,
						)
						typed = CompilerTypedCallExpr(
							callee_expr,
							call_args,
							span,
							compiler_inferred_call_info(
								resource_checked_context,
								resolved_return_type,
								Some(instantiated_resolved_call),
							),
						)
						Some(compiler_infer_result(resource_checked_context, typed))
					None:
						None
		_:
			None


private pure func compiler_infer_trait_method_ufcs_call_expr(
	context: CompilerInferContext,
	callee: ParsedExpr,
	args: List[ParsedExpr],
	span: CompilerSourceSpan,
) -> Option[CompilerInferResult]:
	match callee:
		ParsedFieldAccessExpr(receiver, method, _):
			is_module_alias = match receiver:
				ParsedNameExpr(module_ident):
					compiler_typecheck_state_find_module_alias(
						context.state,
						module_ident.text,
					).is_some()
				_:
					False

			if is_module_alias:
				None
			else:
				receiver_result = compiler_infer_expr(
					compiler_infer_without_expected(context),
					receiver,
				)

				method_callee: Option[CompilerTraitMethodCallee] = match compiler_lookup_trait_method_callee(
					context,
					method,
				):
					Some(callee):
						Some(callee)
					None:
						if receiver_result.context.state.errors.length() == context.state.errors.length():
							compiler_imported_receiver_trait_method_callee(
								context,
								method,
								compiler_typed_expr_value_type(receiver_result.expr),
							)
						else:
							None

				match method_callee:
					Some(method_callee):
						func_type = compiler_trait_method_callee_function_type(method_callee)
						receiver_type = compiler_typed_expr_value_type(receiver_result.expr)

						impl_target: Option[CompilerImplMethodTarget] = match compiler_env_find_impl_method_info(
							context.state.env,
							method_callee.trait_name,
							method_callee.method_name,
							receiver_type,
						):
							Some(method_info):
								method_info.target
							None:
								None

						resource_args = compiler_trait_method_ufcs_resource_args(
							context,
							method_callee,
							receiver,
						)
						resolved_call = compiler_resolved_call_with_resource_args(
							compiler_resolved_call_from_trait_method_callee(
								method_callee,
								impl_target,
							),
							resource_args,
						)
						callee_expr = CompilerTypedNameExpr(
							method,
							compiler_typed_expr_info_from_slot(
								None,
								CompilerInferredOrigin,
								compiler_unrefined_binding(),
								Some(resolved_call),
								compiler_keep_value_slot(func_type),
							),
						)
						callee_result = compiler_infer_result(context, callee_expr)
						Some(
							compiler_infer_call_with_callee_result(
								context,
								callee_result,
								compiler_parsed_args_with_receiver(receiver, args),
								span,
							),
						)
					None:
						None
		_:
			None


private pure func compiler_infer_qualified_module_ufcs_call_expr(
	context: CompilerInferContext,
	callee: ParsedExpr,
	args: List[ParsedExpr],
	span: CompilerSourceSpan,
) -> Option[CompilerInferResult]:
	match callee:
		ParsedFieldAccessExpr(receiver, method, _):
			match receiver:
				ParsedNameExpr(module_ident):
					match compiler_typecheck_state_find_module_alias(
						context.state,
						module_ident.text,
					):
						Some(module_path):
							match args.get(0):
								Some(receiver_arg):
									receiver_result = compiler_infer_expr(
										compiler_infer_without_expected(context),
										receiver_arg,
									)

									if receiver_result.context.state.errors.length() != context.state.errors.length():
										None
									else:
										receiver_type = compiler_typed_expr_value_type(
											receiver_result.expr,
										)

										match compiler_env_resolve_module_ufcs_method(
											context.state.env,
											module_path,
											method.text,
											receiver_type,
										):
											Some(entry):
												compiler_infer_ufcs_call_with_receiver_result(
													context,
													receiver_result,
													method,
													entry,
													compiler_parsed_args_after_first(args),
													span,
												)
											None:
												None
								None:
									None
						None:
							None
				_:
					None
		_:
			None


private pure func compiler_qualified_module_owns_trait_dispatch(
	context: CompilerInferContext,
	module_path: String,
	trait_name: String,
	receiver_type: CompilerType,
) -> Bool:
	trait_owned = match compiler_env_get_trait(context.state.env, trait_name):
		Some(trait_def):
			trait_def.module_path == Some(module_path)
		None:
			False

	type_owned = match receiver_type:
		CompilerNamedType(type_name, _):
			compiler_typecheck_state_type_home_matches(context.state, type_name, module_path)
		_:
			False

	-- The orphan rule requires every implementation to live with either its
	-- trait or receiver type, so these two ownership facts fully identify the
	-- modules through which qualified implementation dispatch is visible.
	trait_owned or type_owned


private pure func compiler_infer_qualified_module_trait_call_expr(
	context: CompilerInferContext,
	callee: ParsedExpr,
	args: List[ParsedExpr],
	span: CompilerSourceSpan,
) -> Option[CompilerInferResult]:
	match callee:
		ParsedFieldAccessExpr(receiver, method, field_span):
			match (receiver, args.get(0)):
				(ParsedNameExpr(module_ident), Some(receiver_arg)):
					match compiler_typecheck_state_find_module_alias(
						context.state,
						module_ident.text,
					):
						Some(module_path):
							receiver_result = compiler_infer_expr(
								compiler_infer_without_expected(context),
								receiver_arg,
							)

							if receiver_result.context.state.errors.length() != context.state.errors.length():
								None
							else:
								receiver_type = compiler_typed_expr_value_type(receiver_result.expr)

								match compiler_env_get_function_trait(
									context.state.env,
									method.text,
								):
									Some(trait_name):
										if not compiler_qualified_module_owns_trait_dispatch(
											context,
											module_path,
											trait_name,
											receiver_type,
										):
											None
										else:
											match (
												compiler_trait_method_callee_from_trait(
													context,
													method.text,
													method.text,
													trait_name,
												),
												compiler_env_find_impl_method_info(
													context.state.env,
													trait_name,
													method.text,
													receiver_type,
												),
											):
												(Some(method_callee), Some(method_info)):
													resolved_call = compiler_resolved_call_with_resource_args(
														compiler_resolved_call_from_trait_method_callee(
															method_callee,
															method_info.target,
														),
														method_info.resource_args,
													)
													callee_expr = compiler_typed_qualified_module_field_expr(
														module_ident,
														method,
														field_span,
														method_info.func_type,
														Some(resolved_call),
													)
													Some(
														compiler_infer_call_with_callee_result(
															context,
															compiler_infer_result(
																context,
																callee_expr,
															),
															args,
															span,
														),
													)
												_:
													None
									None:
										None
						None:
							None
				_:
					None
		_:
			None


private pure func compiler_resolve_visible_ufcs_method(
	context: CompilerInferContext,
	name: String,
	receiver_type: CompilerType,
) -> Option[CompilerOverloadEntry]:
	matches = compiler_env_lookup_ufcs_methods(context.state.env, name, receiver_type)
	local_matches = matches.filter(func(entry):
		entry.module_path.is_none() and entry.origin != CompilerBuiltinFunc
	)
	imported_matches = matches.filter(func(entry):
		match entry.module_path:
			Some(module_path):
				compiler_typecheck_state_has_import_binding(
					context.state,
					name,
					module_path,
					Some(name),
				)
			None:
				False
	)
	local_match = compiler_env_select_ufcs_method(local_matches, receiver_type)
	imported_match = compiler_env_select_ufcs_method(imported_matches, receiver_type)

	match local_match:
		Some(entry):
			Some(entry)
		None:
			match imported_match:
				Some(entry):
					Some(entry)
				None:
					compiler_env_resolve_ufcs_method(context.state.env, name, receiver_type)


private pure func compiler_infer_ufcs_call_expr(
	context: CompilerInferContext,
	callee: ParsedExpr,
	args: List[ParsedExpr],
	span: CompilerSourceSpan,
) -> Option[CompilerInferResult]:
	match callee:
		ParsedFieldAccessExpr(receiver, method, _):
			is_module_alias = match receiver:
				ParsedNameExpr(module_ident):
					compiler_typecheck_state_find_module_alias(
						context.state,
						module_ident.text,
					).is_some()
				_:
					False

			if is_module_alias:
				None
			else:
				receiver_result = compiler_infer_expr(
					compiler_infer_without_expected(context),
					receiver,
				)

				if receiver_result.context.state.errors.length() != context.state.errors.length():
					None
				else:
					receiver_type = compiler_typed_expr_value_type(receiver_result.expr)

					match compiler_resolve_visible_ufcs_method(context, method.text, receiver_type):
						Some(entry):
							compiler_infer_ufcs_call_with_receiver_result(
								context,
								receiver_result,
								method,
								entry,
								args,
								span,
							)
						None:
							None
		_:
			None


private pure func compiler_infer_call_expr(
	context: CompilerInferContext,
	callee: ParsedExpr,
	args: List[ParsedExpr],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	match compiler_infer_special_builtin_call_expr(
		compiler_infer_without_expected(context),
		callee,
		args,
		span,
	):
		Some(result):
			result
		None:
			-- Module-qualified ordinary calls can reach this UFCS selector when
			-- their first argument matches the first parameter. Preserve the
			-- caller's expected type so return-only generics can still bind from
			-- annotated locals.
			match compiler_infer_qualified_module_ufcs_call_expr(context, callee, args, span):
				Some(result):
					result
				None:
					match compiler_infer_qualified_module_trait_call_expr(
						context,
						callee,
						args,
						span,
					):
						Some(result):
							result
						None:
							match compiler_missing_qualified_module_call_result(
								compiler_infer_without_expected(context),
								callee,
								span,
							):
								Some(result):
									result
								None:
									match compiler_infer_bare_overload_callee(
										compiler_infer_without_expected(context),
										callee,
										args,
									):
										Some(callee_result):
											compiler_infer_call_with_callee_result(
												context,
												callee_result,
												args,
												span,
											)
										None:
											match compiler_missing_bare_overload_call_result(
												compiler_infer_without_expected(context),
												callee,
												args,
												span,
											):
												Some(result):
													result
												None:
													match compiler_infer_ufcs_call_expr(
														context,
														callee,
														args,
														span,
													):
														Some(result):
															result
														None:
															match compiler_infer_trait_method_ufcs_call_expr(
																context,
																callee,
																args,
																span,
															):
																Some(result):
																	result
																None:
																	callee_context = compiler_infer_suppress_debug_only_reference(
																		compiler_call_callee_context(
																			context,
																			callee,
																		),
																	)

																	callee_result = match compiler_infer_qualified_module_callee(
																		callee_context,
																		callee,
																	):
																		Some(result):
																			result
																		None:
																			compiler_infer_expr(
																				callee_context,
																				callee,
																			)

																	compiler_infer_call_with_callee_result(
																		context,
																		callee_result,
																		args,
																		span,
																	)


private pure func compiler_expected_function_type(
	context: CompilerInferContext,
) -> Option[(Bool, List[CompilerType], CompilerType)]:
	resolved_expected = context.expected_type.map(func(typ: CompilerType) -> CompilerType:
		compiler_env_resolve_alias(context.state.env, typ)
	)

	match resolved_expected:
		Some(CompilerFunctionType(is_pure, params, return_type)):
			Some((is_pure, params, return_type))
		_:
			None


private pure func compiler_lambda_missing_param_type_error(
	context: CompilerInferContext,
	name: String,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Cannot infer type of lambda parameter `" + name + "`; add a type annotation",
	)


private pure func compiler_lambda_return_mismatch_error(
	context: CompilerInferContext,
	expected: CompilerType,
	got: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Lambda body type mismatch: expected " + compiler_type_to_string(
			expected,
		) + ", got " + compiler_type_to_string(got),
	)


private pure func compiler_name_list_add_unique(names: List[String], name: String) -> List[String]:
	if names.contains(name):
		names
	else:
		names.append(name)


private pure func compiler_name_lists_concat_unique(
	names: List[String],
	extra: List[String],
) -> List[String]:
	var result = names

	for name in extra:
		result = compiler_name_list_add_unique(result, name)

	result


private pure func compiler_pattern_bound_names(
	env: CompilerEnv,
	pattern: ParsedPattern,
) -> List[String]:
	match pattern:
		ParsedNamePattern(name):
			if compiler_env_get_constructor(env, name.text).is_some():
				[]
			else:
				[name.text]
		ParsedConstructorPattern(_, fields, _):
			var result: List[String] = []

			for field in fields:
				result = compiler_name_lists_concat_unique(
					result,
					compiler_pattern_bound_names(env, field),
				)

			result
		ParsedQualifiedConstructorPattern(_, _, fields, _):
			var result: List[String] = []

			for field in fields:
				result = compiler_name_lists_concat_unique(
					result,
					compiler_pattern_bound_names(env, field),
				)

			result
		ParsedTuplePattern(items, _):
			var result: List[String] = []

			for item in items:
				result = compiler_name_lists_concat_unique(
					result,
					compiler_pattern_bound_names(env, item),
				)

			result
		ParsedListPattern(items, spread, _):
			var result: List[String] = []

			for item in items:
				result = compiler_name_lists_concat_unique(
					result,
					compiler_pattern_bound_names(env, item),
				)

			match spread:
				Some(ParsedListSpreadName(name)):
					compiler_name_list_add_unique(result, name.text)
				Some(ParsedListSpreadWildcard(_)):
					result
				None:
					result
		ParsedOrPattern(options, _):
			var result: List[String] = []

			for option in options:
				result = compiler_name_lists_concat_unique(
					result,
					compiler_pattern_bound_names(env, option),
				)

			result
		_:
			[]


private pure func compiler_free_var_refs_in_interpolation_parts(
	env: CompilerEnv,
	bound: List[String],
	parts: List[ParsedStringInterpolationPart],
) -> List[String]:
	var result: List[String] = []

	for part in parts:
		match part:
			ParsedInterpolationLiteral(_):
				void
			ParsedInterpolationExpr(expr):
				result = compiler_name_lists_concat_unique(
					result,
					compiler_free_var_refs_in_expr(env, bound, expr),
				)

	result


private pure func compiler_free_var_refs_in_exprs(
	env: CompilerEnv,
	bound: List[String],
	exprs: List[ParsedExpr],
) -> List[String]:
	var result: List[String] = []

	for expr in exprs:
		result = compiler_name_lists_concat_unique(
			result,
			compiler_free_var_refs_in_expr(env, bound, expr),
		)

	result


private pure func compiler_free_var_refs_in_dict_entries(
	env: CompilerEnv,
	bound: List[String],
	entries: List[ParsedDictEntry],
) -> List[String]:
	var result: List[String] = []

	for entry in entries:
		result = compiler_name_lists_concat_unique(
			result,
			compiler_free_var_refs_in_expr(env, bound, entry.key),
		)
		result = compiler_name_lists_concat_unique(
			result,
			compiler_free_var_refs_in_expr(env, bound, entry.value),
		)

	result


private pure func compiler_free_var_refs_in_record_fields(
	env: CompilerEnv,
	bound: List[String],
	fields: List[ParsedRecordExprField],
) -> List[String]:
	var result: List[String] = []

	for field in fields:
		result = compiler_name_lists_concat_unique(
			result,
			compiler_free_var_refs_in_expr(env, bound, field.value),
		)

	result


private pure func compiler_free_var_refs_in_match_cases(
	env: CompilerEnv,
	bound: List[String],
	cases: List[ParsedMatchCase],
) -> List[String]:
	var result: List[String] = []

	for case in cases:
		case_bound = compiler_name_lists_concat_unique(
			bound,
			compiler_pattern_bound_names(env, case.pattern),
		)
		result = compiler_name_lists_concat_unique(
			result,
			compiler_free_var_refs_in_expr(env, case_bound, case.body),
		)

	result


private pure func compiler_free_var_refs_in_concurrent_params(
	env: CompilerEnv,
	bound: List[String],
	params: List[ParsedConcurrentParam],
) -> List[String]:
	var result: List[String] = []

	for param in params:
		result = compiler_name_lists_concat_unique(
			result,
			compiler_free_var_refs_in_expr(env, bound, param.value),
		)

	result


private pure func compiler_free_var_refs_in_select_arms(
	env: CompilerEnv,
	bound: List[String],
	arms: List[ParsedSelectArm],
) -> List[String]:
	var result: List[String] = []

	for arm in arms:
		match arm.kind:
			ParsedSelectReceiveArm(name, channel):
				body_bound = compiler_name_list_add_unique(bound, name.text)
				result = compiler_name_lists_concat_unique(
					result,
					compiler_free_var_refs_in_expr(env, bound, channel),
				)
				result = compiler_name_lists_concat_unique(
					result,
					compiler_free_var_refs_in_expr(env, body_bound, arm.body),
				)
			ParsedSelectSealedArm(channel):
				result = compiler_name_lists_concat_unique(
					result,
					compiler_free_var_refs_in_expr(env, bound, channel),
				)
				result = compiler_name_lists_concat_unique(
					result,
					compiler_free_var_refs_in_expr(env, bound, arm.body),
				)
			ParsedSelectAfterArm(timeout):
				result = compiler_name_lists_concat_unique(
					result,
					compiler_free_var_refs_in_expr(env, bound, timeout),
				)
				result = compiler_name_lists_concat_unique(
					result,
					compiler_free_var_refs_in_expr(env, bound, arm.body),
				)

	result


private pure func compiler_free_var_refs_in_with_binding(
	env: CompilerEnv,
	bound: List[String],
	binding: ParsedWithBinding,
) -> List[String]:
	value_refs = compiler_free_var_refs_in_expr(env, bound, binding.value)

	match binding.error_map:
		Some(mapper):
			mapper_bound = compiler_name_list_add_unique(bound, mapper.name.text)
			compiler_name_lists_concat_unique(
				value_refs,
				compiler_free_var_refs_in_expr(env, mapper_bound, mapper.value),
			)
		None:
			value_refs


private pure func compiler_free_var_refs_in_concurrent_block_body(
	env: CompilerEnv,
	bound: List[String],
	body: ParsedExpr,
) -> List[String]:
	match body:
		ParsedBlockExpr(items, _):
			var result: List[String] = []

			for item in items:
				match compiler_concurrent_binding_value(item):
					Some(value):
						result = compiler_name_lists_concat_unique(
							result,
							compiler_free_var_refs_in_expr(env, bound, value),
						)
					None:
						result = compiler_name_lists_concat_unique(
							result,
							compiler_free_var_refs_in_expr(env, bound, item),
						)

			result
		_:
			compiler_free_var_refs_in_expr(env, bound, body)


private pure func compiler_sequence_bound_after_expr(
	env: CompilerEnv,
	bound: List[String],
	expr: ParsedExpr,
) -> List[String]:
	match expr:
		ParsedVarDeclExpr(name, _, _, _, _):
			compiler_name_list_add_unique(bound, name.text)
		ParsedAssignExpr(name, _, _):
			if compiler_expr_introduces_local_name(env, bound, name):
				compiler_name_list_add_unique(bound, name.text)
			else:
				bound
		ParsedQuestionBindExpr(name, _, _, _):
			compiler_name_list_add_unique(bound, name.text)
		ParsedTupleDestructExpr(names, _, _):
			compiler_name_lists_concat_unique(
				bound,
				names.map(func(name): name.text),
			)
		_:
			bound


private pure func compiler_free_var_refs_in_sequence(
	env: CompilerEnv,
	bound: List[String],
	exprs: List[ParsedExpr],
) -> List[String]:
	var result: List[String] = []
	var next_bound = bound

	for expr in exprs:
		result = compiler_name_lists_concat_unique(
			result,
			compiler_free_var_refs_in_expr(env, next_bound, expr),
		)
		next_bound = compiler_sequence_bound_after_expr(env, next_bound, expr)

	result


private pure func compiler_lambda_param_bound_names(
	params: List[ParsedLambdaParam],
) -> List[String]:
	var result: List[String] = []

	for param in params:
		result = compiler_name_list_add_unique(result, param.name.text)

	result


private pure func compiler_for_binder_bound_names(binder: ParsedForBinder) -> List[String]:
	match binder:
		ParsedForNameBinder(name):
			[name.text]
		ParsedForTupleBinder(names, _):
			names.map(func(name): name.text)


private pure func compiler_free_var_lhs_refs(
	env: CompilerEnv,
	bound: List[String],
	name: ParsedIdentifier,
) -> List[String]:
	if bound.contains(name.text):
		[]
	else:
		match compiler_env_lookup(env, name.text):
			Some(_):
				[name.text]
			None:
				[]


private pure func compiler_expr_introduces_local_name(
	env: CompilerEnv,
	bound: List[String],
	name: ParsedIdentifier,
) -> Bool:
	not bound.contains(name.text) and compiler_env_lookup(env, name.text).is_none()


private pure func compiler_free_var_refs_in_expr(
	env: CompilerEnv,
	bound: List[String],
	expr: ParsedExpr,
) -> List[String]:
	match expr:
		ParsedNameExpr(name):
			if bound.contains(name.text):
				[]
			else:
				[name.text]
		ParsedUnaryExpr(_, inner, _):
			compiler_free_var_refs_in_expr(env, bound, inner)
		ParsedBinaryExpr(_, left, right, _):
			compiler_name_lists_concat_unique(
				compiler_free_var_refs_in_expr(env, bound, left),
				compiler_free_var_refs_in_expr(env, bound, right),
			)
		ParsedLogicalExpr(_, left, right, _):
			compiler_name_lists_concat_unique(
				compiler_free_var_refs_in_expr(env, bound, left),
				compiler_free_var_refs_in_expr(env, bound, right),
			)
		ParsedAscriptionExpr(inner, _, _):
			compiler_free_var_refs_in_expr(env, bound, inner)
		ParsedOpaqueIntoExpr(_, inner, _):
			compiler_free_var_refs_in_expr(env, bound, inner)
		ParsedOpaqueFromExpr(_, inner, _):
			compiler_free_var_refs_in_expr(env, bound, inner)
		ParsedQuestionBindExpr(_, _, value, _):
			compiler_free_var_refs_in_expr(env, bound, value)
		ParsedRangeExpr(start_expr, end_expr, _):
			compiler_name_lists_concat_unique(
				compiler_free_var_refs_in_expr(env, bound, start_expr),
				compiler_free_var_refs_in_expr(env, bound, end_expr),
			)
		ParsedStringInterpolationPartsExpr(parts, _, _):
			compiler_free_var_refs_in_interpolation_parts(env, bound, parts)
		ParsedCallExpr(callee, args, _):
			compiler_name_lists_concat_unique(
				compiler_free_var_refs_in_expr(env, bound, callee),
				compiler_free_var_refs_in_exprs(env, bound, args),
			)
		ParsedFieldAccessExpr(receiver, _, _):
			compiler_free_var_refs_in_expr(env, bound, receiver)
		ParsedSubscriptExpr(receiver, indices, _):
			compiler_name_lists_concat_unique(
				compiler_free_var_refs_in_expr(env, bound, receiver),
				compiler_free_var_refs_in_exprs(env, bound, indices),
			)
		ParsedListExpr(items, _):
			compiler_free_var_refs_in_exprs(env, bound, items)
		ParsedTupleExpr(items, _):
			compiler_free_var_refs_in_exprs(env, bound, items)
		ParsedVectorExpr(items, _):
			compiler_free_var_refs_in_exprs(env, bound, items)
		ParsedDictExpr(entries, _):
			compiler_free_var_refs_in_dict_entries(env, bound, entries)
		ParsedRecordExpr(fields, _):
			compiler_free_var_refs_in_record_fields(env, bound, fields)
		ParsedRecordUpdateExpr(base, fields, _):
			compiler_name_lists_concat_unique(
				compiler_free_var_refs_in_expr(env, bound, base),
				compiler_free_var_refs_in_record_fields(env, bound, fields),
			)
		ParsedBlockExpr(items, _):
			compiler_free_var_refs_in_sequence(env, bound, items)
		ParsedIfExpr(condition, then_branch, else_branch, _):
			with_then = compiler_name_lists_concat_unique(
				compiler_free_var_refs_in_expr(env, bound, condition),
				compiler_free_var_refs_in_expr(env, bound, then_branch),
			)

			match else_branch:
				Some(branch):
					compiler_name_lists_concat_unique(
						with_then,
						compiler_free_var_refs_in_expr(env, bound, branch),
					)
				None:
					with_then
		ParsedMatchExpr(scrutinee, cases, _):
			compiler_name_lists_concat_unique(
				compiler_free_var_refs_in_expr(env, bound, scrutinee),
				compiler_free_var_refs_in_match_cases(env, bound, cases),
			)
		ParsedDebugBlockExpr(body, _):
			compiler_free_var_refs_in_expr(env, bound, body)
		ParsedSelectExpr(arms, _):
			compiler_free_var_refs_in_select_arms(env, bound, arms)
		ParsedWithExpr(binding, body, _):
			body_bound = compiler_name_list_add_unique(bound, binding.name.text)
			compiler_name_lists_concat_unique(
				compiler_free_var_refs_in_with_binding(env, bound, binding),
				compiler_free_var_refs_in_expr(env, body_bound, body),
			)
		ParsedConcurrentBlockExpr(params, body, _):
			compiler_name_lists_concat_unique(
				compiler_free_var_refs_in_concurrent_params(env, bound, params),
				compiler_free_var_refs_in_concurrent_block_body(env, bound, body),
			)
		ParsedConcurrentForExpr(name, iterable, params, body, _):
			body_bound = compiler_name_list_add_unique(bound, name.text)
			compiler_name_lists_concat_unique(
				compiler_name_lists_concat_unique(
					compiler_free_var_refs_in_expr(env, bound, iterable),
					compiler_free_var_refs_in_concurrent_params(env, bound, params),
				),
				compiler_free_var_refs_in_expr(env, body_bound, body),
			)
		ParsedDetachExpr(body, _):
			compiler_free_var_refs_in_expr(env, bound, body)
		ParsedLambdaExpr(_, params, _, body, _):
			lambda_bound = compiler_name_lists_concat_unique(
				bound,
				compiler_lambda_param_bound_names(params),
			)
			compiler_free_var_refs_in_expr(env, lambda_bound, body)
		ParsedWhileExpr(condition, body, _):
			compiler_name_lists_concat_unique(
				compiler_free_var_refs_in_expr(env, bound, condition),
				compiler_free_var_refs_in_expr(env, bound, body),
			)
		ParsedForExpr(binder, iterable, body, _):
			body_bound = compiler_name_lists_concat_unique(
				bound,
				compiler_for_binder_bound_names(binder),
			)
			compiler_name_lists_concat_unique(
				compiler_free_var_refs_in_expr(env, bound, iterable),
				compiler_free_var_refs_in_expr(env, body_bound, body),
			)
		ParsedVarDeclExpr(_, _, value, _, _):
			compiler_free_var_refs_in_expr(env, bound, value)
		ParsedAssignExpr(name, value, _):
			compiler_name_lists_concat_unique(
				compiler_free_var_lhs_refs(env, bound, name),
				compiler_free_var_refs_in_expr(env, bound, value),
			)
		ParsedCompoundAssignExpr(name, _, value, _):
			compiler_name_lists_concat_unique(
				compiler_free_var_lhs_refs(env, bound, name),
				compiler_free_var_refs_in_expr(env, bound, value),
			)
		ParsedSubscriptAssignExpr(target, indices, value, _):
			with_indices = compiler_name_lists_concat_unique(
				compiler_free_var_refs_in_expr(env, bound, target),
				compiler_free_var_refs_in_exprs(env, bound, indices),
			)
			compiler_name_lists_concat_unique(
				with_indices,
				compiler_free_var_refs_in_expr(env, bound, value),
			)
		ParsedTupleDestructExpr(_, value, _):
			compiler_free_var_refs_in_expr(env, bound, value)
		_:
			[]


private pure func compiler_mutable_capture_names(
	env: CompilerEnv,
	refs: List[String],
) -> List[String]:
	var result: List[String] = []

	for name in refs:
		match compiler_env_lookup(env, name):
			Some(symbol):
				match symbol.kind:
					CompilerVarSymbolKind(var_symbol):
						if compiler_var_mutability_is_mutable(var_symbol.mutability):
							result = compiler_name_list_add_unique(result, name)
						else:
							void
					_:
						void
			None:
				void

	result


private pure func compiler_scoped_resource_capture_names(
	env: CompilerEnv,
	refs: List[String],
) -> List[String]:
	var result: List[String] = []

	for name in refs:
		if (
			compiler_env_is_scoped_resource_var(env, name)
			or compiler_env_scoped_resource_unavailable_owner(env, name).is_some()
		):
			result = compiler_name_list_add_unique(result, name)

	result


private pure func compiler_scoped_resource_derived_capture_names(
	env: CompilerEnv,
	refs: List[String],
) -> List[String]:
	var result: List[String] = []

	for name in refs:
		if compiler_env_is_scoped_resource_derived_var(env, name):
			result = compiler_name_list_add_unique(result, name)

	result


private pure func compiler_resource_capability_target_matches(
	target: CompilerResourceShapeTarget,
	name: String,
) -> Bool:
	match target:
		CompilerOneShotStreamShape:
			compiler_is_one_shot_stream_type_name(name)
		CompilerResourceSourceShape:
			compiler_is_resource_source_type_name(name)


private pure func compiler_copy_type_scan_name(name: String) -> String:
	name.substring(0, name.length())


private pure func compiler_named_type_component_types(
	context: CompilerInferContext,
	name: String,
	args: List[CompilerType],
) -> Option[List[CompilerType]]:
	match compiler_env_get_record(context.state.env, name):
		Some((type_params, fields)):
			subst = compiler_type_param_subst_for_args(type_params, args)
			Some(fields.map(
				func(field): compiler_apply_subst(subst, field.field_type),
			))
		None:
			match compiler_env_get_type_decl(context.state.env, name):
				Some((type_params, variants)):
					subst = compiler_type_param_subst_for_args(type_params, args)
					var result: List[CompilerType] = []

					for variant in variants:
						for field_type in variant.fields:
							result = result.append(compiler_apply_subst(subst, field_type))

					Some(result)
				None:
					None


private pure func compiler_type_is_resource_capability_target(
	context: CompilerInferContext,
	target: CompilerResourceShapeTarget,
	typ: CompilerType,
) -> Bool:
	resolved = compiler_env_resolve_alias_head(context.state.env, typ)

	match resolved:
		CompilerNamedType(name, _):
			compiler_resource_capability_target_matches(target, name)
		_:
			False


private pure func compiler_type_contains_resource_capability_seen(
	context: CompilerInferContext,
	target: CompilerResourceShapeTarget,
	visited: List[String],
	typ: CompilerType,
) -> Bool:
	resolved = compiler_env_resolve_alias_head(context.state.env, typ)

	match resolved:
		CompilerNamedType(name, args):
			owned_name: String = compiler_copy_type_scan_name(name)

			if compiler_resource_capability_target_matches(target, owned_name):
				True
			else if visited.contains(owned_name):
				False
			else:
				next_visited: List[String] = visited.append(owned_name)

				match compiler_named_type_component_types(context, owned_name, args):
					Some(components):
						components.any(
							func(
								component,
							): compiler_type_contains_resource_capability_seen(
								context,
								target,
								next_visited,
								component,
							),
						)
					None:
						args.any(
							func(
								arg,
							): compiler_type_contains_resource_capability_seen(
								context,
								target,
								visited,
								arg,
							),
						)
		CompilerArrayType(element, dims):
			(
				compiler_type_contains_resource_capability_seen(context, target, visited, element)
				or dims.any(
					func(
						dim,
					): compiler_type_contains_resource_capability_seen(
						context,
						target,
						visited,
						dim,
					),
				)
			)
		CompilerFunctionType(_, _, _):
			False
		CompilerTupleType(elements):
			elements.any(
				func(
					element,
				): compiler_type_contains_resource_capability_seen(
					context,
					target,
					visited,
					element,
				),
			)
		CompilerRangeType(inner):
			compiler_type_contains_resource_capability_seen(context, target, visited, inner)
		CompilerDimOpType(_, left, right):
			(
				compiler_type_contains_resource_capability_seen(context, target, visited, left)
				or compiler_type_contains_resource_capability_seen(context, target, visited, right)
			)
		_:
			False


private pure func compiler_type_contains_resource_capability_uncached(
	context: CompilerInferContext,
	target: CompilerResourceShapeTarget,
	typ: CompilerType,
) -> Bool:
	compiler_type_contains_resource_capability_seen(context, target, [], typ)


private pure func compiler_type_endpoint_hides_resource_capability(
	context: CompilerInferContext,
	target: CompilerResourceShapeTarget,
	typ: CompilerType,
) -> Bool:
	(
		compiler_type_contains_resource_capability_uncached(context, target, typ)
		and not compiler_type_is_resource_capability_target(context, target, typ)
	)


private pure func compiler_function_endpoint_has_resource_capability_carrier(
	context: CompilerInferContext,
	target: CompilerResourceShapeTarget,
	visited: List[String],
	typ: CompilerType,
) -> Bool:
	resolved = compiler_env_resolve_alias_head(context.state.env, typ)

	match resolved:
		CompilerFunctionType(_, _, _):
			compiler_type_contains_resource_capability_function_carrier_seen(
				context,
				target,
				visited,
				resolved,
			)
		_:
			(
				compiler_type_endpoint_hides_resource_capability(context, target, resolved)
				or compiler_type_contains_resource_capability_function_carrier_seen(
					context,
					target,
					visited,
					resolved,
				)
			)


private pure func compiler_type_contains_resource_capability_function_carrier_seen(
	context: CompilerInferContext,
	target: CompilerResourceShapeTarget,
	visited: List[String],
	typ: CompilerType,
) -> Bool:
	resolved = compiler_env_resolve_alias_head(context.state.env, typ)

	match resolved:
		CompilerFunctionType(_, params, return_type):
			(
				params.any(
					func(
						param,
					): compiler_function_endpoint_has_resource_capability_carrier(
						context,
						target,
						visited,
						param,
					),
				)
				or compiler_function_endpoint_has_resource_capability_carrier(
					context,
					target,
					visited,
					return_type,
				)
			)
		CompilerNamedType(name, args):
			owned_name: String = compiler_copy_type_scan_name(name)

			if compiler_resource_capability_target_matches(target, owned_name):
				False
			else if visited.contains(owned_name):
				False
			else:
				next_visited: List[String] = visited.append(owned_name)

				match compiler_named_type_component_types(context, owned_name, args):
					Some(components):
						components.any(
							func(
								component,
							): compiler_type_contains_resource_capability_function_carrier_seen(
								context,
								target,
								next_visited,
								component,
							),
						)
					None:
						args.any(
							func(
								arg,
							): compiler_type_contains_resource_capability_function_carrier_seen(
								context,
								target,
								visited,
								arg,
							),
						)
		CompilerArrayType(element, dims):
			(
				compiler_type_contains_resource_capability_function_carrier_seen(
					context,
					target,
					visited,
					element,
				)
				or dims.any(
					func(
						dim,
					): compiler_type_contains_resource_capability_function_carrier_seen(
						context,
						target,
						visited,
						dim,
					),
				)
			)
		CompilerTupleType(elements):
			elements.any(
				func(
					element,
				): compiler_type_contains_resource_capability_function_carrier_seen(
					context,
					target,
					visited,
					element,
				),
			)
		CompilerRangeType(inner):
			compiler_type_contains_resource_capability_function_carrier_seen(
				context,
				target,
				visited,
				inner,
			)
		CompilerDimOpType(_, left, right):
			(
				compiler_type_contains_resource_capability_function_carrier_seen(
					context,
					target,
					visited,
					left,
				)
				or compiler_type_contains_resource_capability_function_carrier_seen(
					context,
					target,
					visited,
					right,
				)
			)
		_:
			False


private pure func compiler_type_contains_resource_capability_function_carrier_uncached(
	context: CompilerInferContext,
	target: CompilerResourceShapeTarget,
	typ: CompilerType,
) -> Bool:
	compiler_type_contains_resource_capability_function_carrier_seen(context, target, [], typ)


private pure func compiler_contains_target_memo_lookup(
	memo: CompilerTypeShapeMemo,
	target: CompilerResourceShapeTarget,
	typ: CompilerType,
) -> Option[Bool]:
	var result: Option[Bool] = None

	for entry in memo.contains_target:
		if (
			entry.target == target
			and entry.rigid_type_params.length() == 0
			and compiler_types_equal(entry.typ, typ)
		):
			result = Some(entry.contains)
			break

	result


private pure func compiler_function_carrier_memo_lookup(
	memo: CompilerTypeShapeMemo,
	target: CompilerResourceShapeTarget,
	typ: CompilerType,
) -> Option[Bool]:
	var result: Option[Bool] = None

	for entry in memo.function_carrier:
		if (
			entry.target == target
			and entry.rigid_type_params.length() == 0
			and compiler_types_equal(entry.typ, typ)
		):
			result = Some(entry.contains)
			break

	result


private pure func compiler_type_contains_resource_capability(
	context: CompilerInferContext,
	target: CompilerResourceShapeTarget,
	typ: CompilerType,
) -> CompilerMemoizedTypeShapeCheck:
	memo = context.state.type_shape_memo

	match compiler_contains_target_memo_lookup(memo, target, typ):
		Some(cached_result):
			{
				contains = cached_result,
				memo = memo
			}
		None:
			contains_capability = compiler_type_contains_resource_capability_uncached(
				context,
				target,
				typ,
			)
			{
				contains = contains_capability,
				memo = { memo | contains_target = memo.contains_target.append({
						target = target,
						rigid_type_params = [],
						typ = typ,
						contains = contains_capability,
					}) }
			}


private pure func compiler_type_contains_resource_capability_function_carrier(
	context: CompilerInferContext,
	target: CompilerResourceShapeTarget,
	typ: CompilerType,
) -> CompilerMemoizedTypeShapeCheck:
	memo = context.state.type_shape_memo

	match compiler_function_carrier_memo_lookup(memo, target, typ):
		Some(cached_result):
			{
				contains = cached_result,
				memo = memo
			}
		None:
			contains_carrier = compiler_type_contains_resource_capability_function_carrier_uncached(
				context,
				target,
				typ,
			)
			{
				contains = contains_carrier,
				memo = { memo | function_carrier = memo.function_carrier.append({
						target = target,
						rigid_type_params = [],
						typ = typ,
						contains = contains_carrier,
					}) }
			}


private pure func compiler_infer_context_with_type_shape_memo(
	context: CompilerInferContext,
	memo: CompilerTypeShapeMemo,
) -> CompilerInferContext:
	{ context | state = { context.state | type_shape_memo = memo } }


private pure func compiler_optional_binding_name_suffix(name: String) -> String:
	if name == "_":
		""
	else:
		" `" + name + "`"


private pure func compiler_check_one_shot_stream_ordinary_binding(
	context: CompilerInferContext,
	binding_name: String,
	typ: CompilerType,
) -> CompilerInferContext:
	carrier_check = compiler_type_contains_resource_capability_function_carrier(
		context,
		CompilerOneShotStreamShape,
		typ,
	)
	with_function_carrier_memo = compiler_infer_context_with_type_shape_memo(
		context,
		carrier_check.memo,
	)

	if carrier_check.contains:
		compiler_infer_error(
			with_function_carrier_memo,
			"function value" + compiler_optional_binding_name_suffix(
				binding_name,
			) + " cannot accept or return a one-shot stream carrier",
		)
	else:
		capability_check = compiler_type_contains_resource_capability(
			with_function_carrier_memo,
			CompilerOneShotStreamShape,
			typ,
		)
		with_contains_memo = compiler_infer_context_with_type_shape_memo(
			with_function_carrier_memo,
			capability_check.memo,
		)

		if (
			capability_check.contains
			and not compiler_type_is_resource_capability_target(
				with_contains_memo,
				CompilerOneShotStreamShape,
				typ,
			)
		):
			compiler_infer_error(
				with_contains_memo,
				"one-shot stream value" + compiler_optional_binding_name_suffix(
					binding_name,
				) + " cannot be bound to an ordinary variable",
			)
		else:
			compiler_infer_context_copy(with_contains_memo)


private pure func compiler_check_resource_source_ordinary_binding(
	context: CompilerInferContext,
	binding_name: String,
	typ: CompilerType,
) -> CompilerInferContext:
	carrier_check = compiler_type_contains_resource_capability_function_carrier(
		context,
		CompilerResourceSourceShape,
		typ,
	)
	with_function_carrier_memo = compiler_infer_context_with_type_shape_memo(
		context,
		carrier_check.memo,
	)

	if carrier_check.contains:
		compiler_infer_error(
			with_function_carrier_memo,
			"function value" + compiler_optional_binding_name_suffix(
				binding_name,
			) + " cannot accept or return a resource source carrier",
		)
	else:
		capability_check = compiler_type_contains_resource_capability(
			with_function_carrier_memo,
			CompilerResourceSourceShape,
			typ,
		)
		with_contains_memo = compiler_infer_context_with_type_shape_memo(
			with_function_carrier_memo,
			capability_check.memo,
		)

		if (
			capability_check.contains
			and not compiler_type_is_resource_capability_target(
				with_contains_memo,
				CompilerResourceSourceShape,
				typ,
			)
		):
			compiler_infer_error(
				with_contains_memo,
				"resource source value" + compiler_optional_binding_name_suffix(
					binding_name,
				) + " cannot be bound to an ordinary variable",
			)
		else:
			compiler_infer_context_copy(with_contains_memo)


private pure func compiler_check_resource_source_mutable_binding(
	context: CompilerInferContext,
	binding_name: String,
	typ: CompilerType,
	is_mutable: Bool,
) -> CompilerInferContext:
	if (
		is_mutable
		and compiler_type_is_resource_capability_target(context, CompilerResourceSourceShape, typ)
	):
		compiler_infer_error(
			context,
			"resource source value" + compiler_optional_binding_name_suffix(
				binding_name,
			) + " cannot be mutable",
		)
	else:
		compiler_infer_context_copy(context)


private pure func compiler_resource_source_refs_in_expr(
	context: CompilerInferContext,
	expr: ParsedExpr,
) -> List[String]:
	refs = compiler_free_var_refs_in_expr(context.state.env, [], expr)
	compiler_capture_names_with_capability(context, refs, CompilerResourceSourceShape)


private pure func compiler_check_resource_source_copy_from_existing(
	context: CompilerInferContext,
	binding_name: String,
	typ: CompilerType,
	value: ParsedExpr,
) -> CompilerInferContext:
	if compiler_type_is_resource_capability_target(context, CompilerResourceSourceShape, typ):
		refs = compiler_resource_source_refs_in_expr(context, value)

		if refs.length() > 0:
			plural = if refs.length() == 1:
				""
			else:
				"s"

			compiler_infer_error(
				context,
				"resource source value" + compiler_optional_binding_name_suffix(
					binding_name,
				) + " cannot copy existing resource source value" + plural + ": " + compiler_join_names(
					refs,
				),
			)
		else:
			compiler_infer_context_copy(context)
	else:
		compiler_infer_context_copy(context)


private pure func compiler_check_resource_capability_binding(
	context: CompilerInferContext,
	binding_name: String,
	typ: CompilerType,
	is_mutable: Bool,
	value: ParsedExpr,
) -> CompilerInferContext:
	stream_context = compiler_check_one_shot_stream_ordinary_binding(context, binding_name, typ)
	source_context = compiler_check_resource_source_ordinary_binding(
		stream_context,
		binding_name,
		typ,
	)
	mutable_context = compiler_check_resource_source_mutable_binding(
		source_context,
		binding_name,
		typ,
		is_mutable,
	)
	compiler_check_resource_source_copy_from_existing(mutable_context, binding_name, typ, value)


private pure func compiler_check_one_shot_stream_storage(
	context: CompilerInferContext,
	container: String,
	typ: CompilerType,
) -> CompilerInferContext:
	capability_check = compiler_type_contains_resource_capability(
		context,
		CompilerOneShotStreamShape,
		typ,
	)
	with_memo = compiler_infer_context_with_type_shape_memo(context, capability_check.memo)

	if capability_check.contains:
		compiler_infer_error(
			with_memo,
			"one-shot stream values cannot be stored in " + container + " (found " + compiler_type_to_string(
				typ,
			) + ")",
		)
	else:
		compiler_infer_context_copy(with_memo)


private pure func compiler_check_resource_source_storage(
	context: CompilerInferContext,
	container: String,
	typ: CompilerType,
) -> CompilerInferContext:
	capability_check = compiler_type_contains_resource_capability(
		context,
		CompilerResourceSourceShape,
		typ,
	)
	with_memo = compiler_infer_context_with_type_shape_memo(context, capability_check.memo)

	if capability_check.contains:
		compiler_infer_error(
			with_memo,
			"resource source values cannot be stored in " + container + " (found " + compiler_type_to_string(
				typ,
			) + ")",
		)
	else:
		compiler_infer_context_copy(with_memo)


private pure func compiler_check_resource_capability_storage(
	context: CompilerInferContext,
	container: String,
	typ: CompilerType,
) -> CompilerInferContext:
	stream_context = compiler_check_one_shot_stream_storage(context, container, typ)
	compiler_check_resource_source_storage(stream_context, container, typ)


private pure func compiler_capture_names_with_capability(
	context: CompilerInferContext,
	refs: List[String],
	target: CompilerResourceShapeTarget,
) -> List[String]:
	var result: List[String] = []

	for name in refs:
		match compiler_env_get_var_type(context.state.env, name):
			Some(typ):
				if compiler_type_contains_resource_capability_uncached(context, target, typ):
					result = compiler_name_list_add_unique(result, name)
			None:
				void

	result


private pure func compiler_join_names(names: List[String]) -> String:
	var result: String = ""
	var index: Int = 0

	for name in names:
		if index == 0:
			result = name
		else:
			result = result + ", " + name

		index += 1

	result


private pure func compiler_check_lambda_captures(
	context: CompilerInferContext,
	params: List[ParsedLambdaParam],
	body: ParsedExpr,
) -> CompilerInferContext:
	free_refs = compiler_free_var_refs_in_expr(
		context.state.env,
		compiler_lambda_param_bound_names(params),
		body,
	)
	resource_captures = compiler_scoped_resource_capture_names(context.state.env, free_refs)
	source_captures = compiler_capture_names_with_capability(
		context,
		free_refs,
		CompilerResourceSourceShape,
	)
	derived_captures = compiler_scoped_resource_derived_capture_names(context.state.env, free_refs)
	stream_captures = compiler_capture_names_with_capability(
		context,
		free_refs,
		CompilerOneShotStreamShape,
	)
	mutable_captures = compiler_mutable_capture_names(context.state.env, free_refs)

	if resource_captures.length() > 0:
		plural = if resource_captures.length() == 1:
			""
		else:
			"s"

		compiler_infer_error(
			context,
			"Closure cannot capture scoped resource" + plural + ": " + compiler_join_names(
				resource_captures,
			) + ". Keep resource use inside the with block without storing it in a closure.",
		)
	else if source_captures.length() > 0:
		plural = if source_captures.length() == 1:
			""
		else:
			"s"

		compiler_infer_error(
			context,
			"Closure cannot capture resource source value" + plural + ": " + compiler_join_names(
				source_captures,
			) + ". Consume the source with resource-source iteration instead.",
		)
	else if derived_captures.length() > 0:
		plural = if derived_captures.length() == 1:
			""
		else:
			"s"

		compiler_infer_error(
			context,
			"Closure cannot capture scoped resource-derived value" + plural + ": " + compiler_join_names(
				derived_captures,
			) + ". Keep dependent values inside the with block without storing them in a closure.",
		)
	else if stream_captures.length() > 0:
		plural = if stream_captures.length() == 1:
			""
		else:
			"s"

		compiler_infer_error(
			context,
			"Closure cannot capture one-shot stream value" + plural + ": " + compiler_join_names(
				stream_captures,
			) + ((
				". Create and consume the stream inside the closure, or collect ordinary data "
				+ "before creating the closure."
			)),
		)
	else if mutable_captures.length() == 0:
		compiler_infer_context_copy(context)
	else:
		plural = if mutable_captures.length() == 1:
			""
		else:
			"s"

		compiler_infer_error(
			context,
			"Closure cannot capture mutable variable" + plural + ": " + compiler_join_names(
				mutable_captures,
			) + ". Use explicit state threading instead.",
		)


private pure func compiler_lambda_param_type(
	context: CompilerInferContext,
	param: ParsedLambdaParam,
	index: Int,
	expected_params: List[CompilerType],
) -> (CompilerInferContext, CompilerTypedLambdaParam):
	match param.type_expr:
		Some(type_expr):
			source_type = compiler_type_from_parsed_type_expr(type_expr)
			semantic_type = compiler_infer_canonical_expected_type(context, source_type)
			(compiler_infer_context_copy(context), {
					name = param.name,
					source_type = Some(compiler_type_copy(source_type)),
					param_type = semantic_type
				})
		None:
			match expected_params.get(index):
				Some(expected_type):
					(compiler_infer_context_copy(context), {
							name = param.name,
							source_type = None,
							param_type = compiler_type_copy(expected_type)
						})
				None:
					next = compiler_lambda_missing_param_type_error(context, param.name.text)
					(next, {
							name = param.name,
							source_type = None,
							param_type = compiler_type_void()
						})


private pure func compiler_infer_lambda_params_result(
	context: CompilerInferContext,
	params: List[CompilerTypedLambdaParam],
	param_types: List[CompilerType],
) -> CompilerInferLambdaParamsResult:
	{
		context = compiler_infer_context_copy(context),
		params = params,
		param_types = param_types
	}


private pure func compiler_infer_lambda_params(
	context: CompilerInferContext,
	params: List[ParsedLambdaParam],
	expected_params: List[CompilerType],
) -> CompilerInferLambdaParamsResult:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var typed_params: List[CompilerTypedLambdaParam] = []
	var param_types: List[CompilerType] = []
	var seen: List[String] = []
	var index: Int = 0

	while index < params.length():
		match params.get(index):
			Some(param):
				if seen.contains(param.name.text):
					next_context = compiler_infer_error(
						next_context,
						"Cannot redeclare lambda parameter `" + param.name.text + "`",
					)

				seen = seen.append(param.name.text)
				param_result: (CompilerInferContext, CompilerTypedLambdaParam) = compiler_lambda_param_type(
					next_context,
					param,
					index,
					expected_params,
				)
				next_context = param_result[0]
				typed_param = param_result[1]
				typed_params = typed_params.append(typed_param)
				param_types = param_types.append(compiler_type_copy(typed_param.param_type))
			None:
				void

		index += 1

	compiler_infer_lambda_params_result(next_context, typed_params, param_types)


private pure func compiler_add_lambda_param_bindings(
	env: CompilerEnv,
	params: List[CompilerTypedLambdaParam],
) -> CompilerEnv:
	var next_env: CompilerEnv = env

	for param in params:
		next_env = compiler_env_add_var_with_details(
			next_env,
			param.name.text,
			compiler_type_copy(param.param_type),
			compiler_optional_type_copy(param.source_type),
			CompilerImmutableBinding,
			CompilerFuncParam,
			compiler_unrefined_binding(),
		)

	next_env


private pure func compiler_expected_lambda_return_type(
	context: CompilerInferContext,
	return_type: Option[ParsedTypeExpr],
	expected_return_type: Option[CompilerType],
) -> Option[CompilerType]:
	match return_type:
		Some(type_expr):
			Some(
				compiler_infer_canonical_expected_type(
					context,
					compiler_type_from_parsed_type_expr(type_expr),
				),
			)
		None:
			match expected_return_type:
				Some(typ):
					if compiler_type_contains_type_var(typ):
						None
					else:
						Some(compiler_type_copy(typ))
				None:
					None


private pure func compiler_infer_lambda_expr(
	context: CompilerInferContext,
	is_pure: Bool,
	params: List[ParsedLambdaParam],
	return_type: Option[ParsedTypeExpr],
	body: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	expected_function = compiler_expected_function_type(context)

	expected_params: List[CompilerType] = match expected_function:
		Some((_, param_types, _)):
			param_types
		None:
			[]

	expected_pure = match expected_function:
		Some((is_expected_pure, _, _)):
			is_expected_pure
		None:
			False

	expected_return_type: Option[CompilerType] = match expected_function:
		Some((_, _, expected_return)):
			Some(expected_return)
		None:
			None

	capture_context = compiler_check_lambda_captures(context, params, body)
	params_result = compiler_infer_lambda_params(capture_context, params, expected_params)
	var body_env = compiler_env_push_scope(params_result.context.state.env)
	body_env = compiler_add_lambda_param_bindings(body_env, params_result.params)
	body_state = compiler_typecheck_state_with_env(params_result.context.state, body_env)
	body_base_context = compiler_infer_context_with_state(params_result.context, body_state)
	declared_return_type = compiler_expected_lambda_return_type(
		body_base_context,
		return_type,
		expected_return_type,
	)

	body_context = match declared_return_type:
		Some(typ):
			compiler_infer_with_expected_value_slot(
				body_base_context,
				typ,
				CompilerExpectedArgumentSlot,
			)
		None:
			compiler_infer_without_expected(body_base_context)

	body_result = compiler_infer_expr(body_context, body)
	body_value_type = compiler_typed_expr_value_type(body_result.expr)

	result_return_type = match declared_return_type:
		Some(typ):
			compiler_type_copy(typ)
		None:
			compiler_typed_expr_semantic_type(body_result.expr)

	checked_context = match declared_return_type:
		Some(typ):
			if compiler_types_equal(body_value_type, typ):
				compiler_infer_context_copy(body_result.context)
			else:
				compiler_lambda_return_mismatch_error(body_result.context, typ, body_value_type)
		None:
			compiler_infer_context_copy(body_result.context)

	outer_env = compiler_env_pop_scope(checked_context.state.env)
	outer_state = compiler_typecheck_state_with_env(checked_context.state, outer_env)
	result_context = compiler_infer_context_with_state(context, outer_state)
	inferred_pure = (
		is_pure
		or expected_pure and compiler_typed_expr_impure_call_names(body_result.expr).length() == 0
	)

	function_type = CompilerFunctionType(
		inferred_pure,
		params_result.param_types,
		result_return_type,
	)
	typed = CompilerTypedLambdaExpr(
		inferred_pure,
		params_result.params,
		compiler_optional_type_copy(declared_return_type),
		body_result.expr,
		span,
		compiler_inferred_info(result_context, function_type),
	)

	compiler_infer_result(result_context, typed)


private pure func compiler_infer_expr_list_result(
	context: CompilerInferContext,
	exprs: List[CompilerTypedExpr],
) -> CompilerInferExprListResult:
	{
		context = compiler_infer_context_copy(context),
		exprs = exprs
	}


private pure func compiler_infer_unconstrained_exprs(
	context: CompilerInferContext,
	exprs: List[ParsedExpr],
) -> CompilerInferExprListResult:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var typed_exprs: List[CompilerTypedExpr] = []
	var index: Int = 0

	while index < exprs.length():
		match exprs.get(index):
			Some(expr):
				result = compiler_infer_expr(compiler_infer_without_expected(next_context), expr)
				next_context = compiler_infer_context_copy(result.context)
				typed_exprs = typed_exprs.append(result.expr)
			None:
				void

		index += 1

	compiler_infer_expr_list_result(compiler_infer_without_expected(next_context), typed_exprs)


private pure func compiler_tuple_type_from_items(items: List[CompilerTypedExpr]) -> CompilerType:
	CompilerTupleType(items.map(compiler_typed_expr_semantic_type))


private pure func compiler_tuple_value_type_from_items(
	items: List[CompilerTypedExpr],
) -> CompilerType:
	CompilerTupleType(items.map(
		func(item): compiler_scalar_int_value_type(compiler_typed_expr_value_type(item)),
	))


private pure func compiler_expected_tuple_item_types(
	context: CompilerInferContext,
) -> Option[List[CompilerType]]:
	match context.expected_type:
		Some(expected_type):
			compiler_tuple_elements_from_type(expected_type)
		None:
			None


private pure func compiler_infer_tuple_items_with_expected(
	context: CompilerInferContext,
	items: List[ParsedExpr],
	expected_items: List[CompilerType],
) -> CompilerInferExprListResult:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var typed_exprs: List[CompilerTypedExpr] = []
	var index: Int = 0

	while index < items.length():
		match (items.get(index), expected_items.get(index)):
			(Some(item), Some(expected_type)):
				result = compiler_infer_expr(
					compiler_infer_with_expected_value_slot(
						next_context,
						expected_type,
						CompilerExpectedArgumentSlot,
					),
					item,
				)
				next_context = compiler_infer_context_copy(result.context)
				typed_exprs = typed_exprs.append(result.expr)
			_:
				void

		index += 1

	compiler_infer_expr_list_result(compiler_infer_without_expected(next_context), typed_exprs)


private pure func compiler_infer_tuple_items(
	context: CompilerInferContext,
	items: List[ParsedExpr],
) -> CompilerInferExprListResult:
	match compiler_expected_tuple_item_types(context):
		Some(expected_items):
			if expected_items.length() == items.length():
				compiler_infer_tuple_items_with_expected(context, items, expected_items)
			else:
				compiler_infer_unconstrained_exprs(context, items)
		None:
			compiler_infer_unconstrained_exprs(context, items)


private pure func compiler_infer_tuple_expr(
	context: CompilerInferContext,
	items: List[ParsedExpr],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	items_result = compiler_infer_tuple_items(context, items)
	tuple_type = compiler_tuple_type_from_items(items_result.exprs)
	tuple_value_type = compiler_tuple_value_type_from_items(items_result.exprs)
	var checked_context: CompilerInferContext = compiler_infer_context_with_state(
		context,
		items_result.context.state,
	)

	for item in items_result.exprs:
		checked_context = compiler_check_resource_capability_storage(
			checked_context,
			"tuple literals",
			compiler_typed_expr_value_type(item),
		)

	typed = CompilerTypedTupleExpr(
		items_result.exprs,
		span,
		compiler_typed_expr_info_from_slot(
			None,
			CompilerInferredOrigin,
			compiler_unrefined_binding(),
			None,
			compiler_tuple_literal_slot(tuple_type, tuple_value_type),
		),
	)

	compiler_infer_result(checked_context, typed)


private pure func compiler_tuple_destruct_redeclaration_error(
	context: CompilerInferContext,
	name: String,
) -> CompilerInferContext:
	compiler_infer_error(context, "Cannot redeclare `" + name + "` in tuple destructuring")


private pure func compiler_check_tuple_destruct_redeclarations(
	context: CompilerInferContext,
	names: List[ParsedIdentifier],
) -> CompilerInferContext:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var seen: List[String] = []

	for name in names:
		if name.text != "_":
			if (
				compiler_env_lookup_in_current_scope(context.state.env, name.text).is_some()
				or seen.contains(name.text)
			):
				next_context = compiler_tuple_destruct_redeclaration_error(next_context, name.text)

			seen = seen.append(name.text)

	next_context


private pure func compiler_add_tuple_destruct_bindings(
	env: CompilerEnv,
	names: List[ParsedIdentifier],
	element_types: List[CompilerType],
) -> CompilerEnv:
	var next_env: CompilerEnv = env
	var index: Int = 0

	while index < names.length():
		match names.get(index):
			Some(name):
				if name.text != "_":
					elem_type = compiler_tuple_binding_type(element_types, index)
					next_env = compiler_env_add_var_with_details(
						next_env,
						name.text,
						compiler_type_copy(elem_type),
						Some(compiler_type_copy(elem_type)),
						CompilerImmutableBinding,
						CompilerLetBinding,
						compiler_unrefined_binding(),
					)
			None:
				void

		index += 1

	next_env


private pure func compiler_tuple_destruct_arity_error(
	context: CompilerInferContext,
	binder_count: Int,
	element_count: Int,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Tuple destructuring arity mismatch: expected " + binder_count.to_string() + " elements, got " + element_count.to_string(),
	)


private pure func compiler_tuple_destruct_non_tuple_error(
	context: CompilerInferContext,
	typ: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Tuple destructuring requires a tuple type, got " + compiler_type_to_string(typ),
	)


private pure func compiler_infer_tuple_destruct_expr(
	context: CompilerInferContext,
	names: List[ParsedIdentifier],
	value: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	checked_context = compiler_check_tuple_destruct_redeclarations(context, names)
	value_result = compiler_infer_expr(compiler_infer_without_expected(checked_context), value)
	value_type = compiler_typed_expr_semantic_type(value_result.expr)
	element_result = compiler_tuple_elements_from_type(value_type)

	result_context = match element_result:
		Some(element_types):
			if names.length() == element_types.length():
				next_env = compiler_add_tuple_destruct_bindings(
					value_result.context.state.env,
					names,
					element_types,
				)
				next_state = compiler_typecheck_state_with_env(value_result.context.state, next_env)
				compiler_infer_context_with_state(context, next_state)
			else:
				compiler_tuple_destruct_arity_error(
					value_result.context,
					names.length(),
					element_types.length(),
				)
		None:
			compiler_tuple_destruct_non_tuple_error(value_result.context, value_type)

	typed = CompilerTypedTupleDestructExpr(
		names,
		value_result.expr,
		span,
		compiler_inferred_info(result_context, compiler_type_void()),
	)

	compiler_infer_result(result_context, typed)


private pure func compiler_expected_list_element_type(
	context: CompilerInferContext,
) -> Option[CompilerType]:
	match context.expected_type:
		Some(expected):
			match expected:
				CompilerNamedType(name, args):
					if name == "List" and args.length() == 1:
						args
							.get(0)
							.map(compiler_type_copy)
					else:
						None
				_:
					None
		None:
			None


private pure func compiler_expected_vector_type(
	context: CompilerInferContext,
) -> Option[(CompilerType, List[CompilerType])]:
	match context.expected_type:
		Some(expected):
			compiler_array_type_parts(expected)
		None:
			None


private pure func compiler_dims_after_first(dims: List[CompilerType]) -> List[CompilerType]:
	var result: List[CompilerType] = []
	var index: Int = 1

	while index < dims.length():
		match dims.get(index):
			Some(dim):
				result = result.append(dim)
			None:
				void

		index += 1

	result


private pure func compiler_vector_item_type(
	element_type: CompilerType,
	dims: List[CompilerType],
) -> CompilerType:
	if dims.length() <= 1:
		compiler_type_copy(element_type)
	else:
		compiler_array_type(compiler_type_copy(element_type), compiler_dims_after_first(dims))


private pure func compiler_default_collection_element_type(typ: CompilerType) -> CompilerType:
	match typ:
		CompilerTupleType(elements):
			CompilerTupleType(elements.map(compiler_default_collection_element_type))
		_:
			compiler_numeric_operand_type(ParsedAddOp, typ)


private pure func compiler_types_compatible_for_inference(
	context: CompilerInferContext,
	expected: CompilerType,
	actual: CompilerType,
) -> Bool:
	type_params = compiler_env_get_type_params(context.state.env)
	resolved_expected = compiler_env_resolve_alias(context.state.env, expected)
	resolved_actual = compiler_env_resolve_alias(context.state.env, actual)
	compiler_types_compatible_with_params(type_params, resolved_expected, resolved_actual)


private pure func compiler_common_inferred_type_without_meta(
	context: CompilerInferContext,
	left: CompilerType,
	right: CompilerType,
) -> Option[CompilerCheckedType]:
	if compiler_types_equal(left, right):
		Some(compiler_checked_type(context, left))
	else if compiler_types_compatible_for_inference(context, left, right):
		Some(compiler_checked_type(context, left))
	else if compiler_types_compatible_for_inference(context, right, left):
		Some(compiler_checked_type(context, right))
	else:
		match (left, right):
			(CompilerConstIntType(_), CompilerConstIntType(_)):
				Some(compiler_checked_type(context, compiler_type_int()))
			(CompilerConstIntType(_), CompilerNamedType(name, args)):
				if name == "Int" and args.length() == 0:
					Some(compiler_checked_type(context, compiler_type_int()))
				else:
					None
			(CompilerNamedType(name, args), CompilerConstIntType(_)):
				if name == "Int" and args.length() == 0:
					Some(compiler_checked_type(context, compiler_type_int()))
				else:
					None
			_:
				None


private pure func compiler_common_inferred_type(
	context: CompilerInferContext,
	left: CompilerType,
	right: CompilerType,
) -> Option[CompilerCheckedType]:
	if compiler_type_contains_meta(left) or compiler_type_contains_meta(right):
		resolved_left = compiler_env_resolve_alias(context.state.env, left)
		resolved_right = compiler_env_resolve_alias(context.state.env, right)

		match compiler_unify_symmetric(context.state.context, resolved_left, resolved_right):
			Some(step):
				next_state = { context.state | context = step.context }
				next_context = compiler_infer_context_with_state(context, next_state)
				Some(compiler_checked_type(next_context, compiler_zonk_type(step.context, left)))
			None:
				None
	else:
		compiler_common_inferred_type_without_meta(context, left, right)


private pure func compiler_type_range() -> CompilerType:
	CompilerNamedType("Range", [])


private pure func compiler_type_dict(
	key_type: CompilerType,
	value_type: CompilerType,
) -> CompilerType:
	CompilerNamedType(
		"Dict",
		[compiler_type_copy(key_type), compiler_type_copy(value_type)],
	)


private pure func compiler_list_element_mismatch_error(
	context: CompilerInferContext,
	index: Int,
	expected: CompilerType,
	got: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"List element " + (index + 1).to_string() + " expected " + compiler_type_to_string(
			expected,
		) + ", got " + compiler_type_to_string(got),
	)


private pure func compiler_vector_element_mismatch_error(
	context: CompilerInferContext,
	index: Int,
	expected: CompilerType,
	got: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Tensor element " + (index + 1).to_string() + " expected " + compiler_type_to_string(
			expected,
		) + ", got " + compiler_type_to_string(got),
	)


private pure func compiler_vector_expected_count_error(
	context: CompilerInferContext,
	expected: Int,
	got: Int,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Tensor literal expected " + expected.to_string() + " elements, got " + got.to_string(),
	)


private pure func compiler_check_vector_expected_count(
	context: CompilerInferContext,
	dims: List[CompilerType],
	actual_count: Int,
) -> CompilerInferContext:
	match dims.get(0):
		Some(CompilerConstIntType(expected_count)):
			if expected_count == actual_count:
				compiler_infer_context_copy(context)
			else:
				compiler_vector_expected_count_error(context, expected_count, actual_count)
		_:
			compiler_infer_context_copy(context)


private pure func compiler_vector_items_all_literal_vectors(items: List[ParsedExpr]) -> Bool:
	var result: Bool = True

	for item in items:
		match item:
			ParsedVectorExpr(_, _):
				void
			_:
				result = False
				break

	result


private pure func compiler_check_nested_vector_literal_items(
	context: CompilerInferContext,
	items: List[ParsedExpr],
	item_type: CompilerType,
) -> CompilerInferContext:
	match compiler_array_type_parts(item_type):
		Some((_, dims)):
			if dims.length() > 0 and not compiler_vector_items_all_literal_vectors(items):
				compiler_infer_error(
					context,
					(
						"Multi-dimensional tensor literals must use nested literal syntax (e.g., {{1,2},"
						+ "{3,4}}). Constructing from tensor variables is not yet supported"
					),
				)
			else:
				compiler_infer_context_copy(context)
		None:
			compiler_infer_context_copy(context)


private pure func compiler_collection_slot_for_target(
	kind: CompilerCollectionKind,
	target_type: CompilerType,
	semantic_type: CompilerType,
) -> CompilerValueSlot:
	if compiler_types_equal(compiler_default_collection_element_type(semantic_type), target_type):
		compiler_collection_element_target_slot(kind, target_type, semantic_type)
	else:
		compiler_keep_value_slot(semantic_type)


private pure func compiler_infer_list_tail_items(
	context: CompilerInferContext,
	items: List[ParsedExpr],
	start_index: Int,
	element_type: CompilerType,
	typed_items: List[CompilerTypedExpr],
) -> CompilerInferExprListResult:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var result_items: List[CompilerTypedExpr] = typed_items
	var index: Int = start_index

	while index < items.length():
		match items.get(index):
			Some(item):
				item_result = compiler_infer_expr(
					compiler_infer_with_expected_value_slot(
						next_context,
						element_type,
						CompilerExpectedCollectionElementSlot(CompilerListLiteral),
					),
					item,
				)
				item_semantic_type = compiler_typed_expr_semantic_type(item_result.expr)
				item_candidate_type = compiler_default_collection_element_type(item_semantic_type)
				item_slot = compiler_collection_slot_for_target(
					CompilerListLiteral,
					element_type,
					item_semantic_type,
				)
				typed_item = compiler_typed_expr_with_slot(item_result.expr, item_slot)
				item_type = compiler_typed_expr_value_type(typed_item)

				next_context = if compiler_types_compatible_for_inference(
					item_result.context,
					element_type,
					item_type,
				):
					compiler_infer_context_copy(item_result.context)
				else:
					compiler_list_element_mismatch_error(
						item_result.context,
						index,
						element_type,
						item_candidate_type,
					)

				next_context = compiler_check_resource_capability_storage(
					next_context,
					"List literals",
					item_type,
				)
				result_items = result_items.append(typed_item)
			None:
				void

		index += 1

	compiler_infer_expr_list_result(compiler_infer_without_expected(next_context), result_items)


private pure func compiler_infer_list_expr(
	context: CompilerInferContext,
	items: List[ParsedExpr],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	match compiler_expected_list_element_type(context):
		Some(expected_element):
			if items.length() == 0:
				result_context = compiler_check_resource_capability_storage(
					context,
					"List literals",
					expected_element,
				)
				list_type = compiler_type_list(expected_element)
				typed = CompilerTypedListExpr(
					[],
					span,
					compiler_inferred_info(result_context, list_type),
				)
				compiler_infer_result(result_context, typed)
			else:
				items_result = compiler_infer_list_tail_items(
					context,
					items,
					0,
					expected_element,
					[],
				)
				result_context = compiler_infer_context_with_state(
					context,
					items_result.context.state,
				)
				list_type = compiler_type_list(expected_element)
				typed = CompilerTypedListExpr(
					items_result.exprs,
					span,
					compiler_inferred_info(result_context, list_type),
				)
				compiler_infer_result(result_context, typed)
		None:
			if items.length() == 0:
				next = compiler_infer_error(
					context,
					"Cannot infer element type for empty list literal",
				)
				typed = CompilerTypedListExpr(
					[],
					span,
					compiler_inferred_info(next, compiler_type_list(compiler_type_void())),
				)
				compiler_infer_result(next, typed)
			else:
				match items.get(0):
					Some(first_item):
						first_result = compiler_infer_expr(
							compiler_infer_without_expected(context),
							first_item,
						)
						first_semantic_type = compiler_typed_expr_semantic_type(first_result.expr)
						element_type = compiler_default_collection_element_type(first_semantic_type)
						first_typed = compiler_typed_expr_with_slot(
							first_result.expr,
							compiler_collection_slot_for_target(
								CompilerListLiteral,
								element_type,
								first_semantic_type,
							),
						)

						first_context = if compiler_types_equal(
							compiler_typed_expr_value_type(first_typed),
							element_type,
						):
							compiler_infer_context_copy(first_result.context)
						else:
							compiler_list_element_mismatch_error(
								first_result.context,
								0,
								element_type,
								compiler_typed_expr_value_type(first_typed),
							)

						first_storage_context = compiler_check_resource_capability_storage(
							first_context,
							"List literals",
							compiler_typed_expr_value_type(first_typed),
						)
						items_result = compiler_infer_list_tail_items(
							first_storage_context,
							items,
							1,
							element_type,
							[first_typed],
						)
						result_context = compiler_infer_context_with_state(
							context,
							items_result.context.state,
						)
						list_type = compiler_type_list(element_type)
						typed = CompilerTypedListExpr(
							items_result.exprs,
							span,
							compiler_inferred_info(result_context, list_type),
						)
						compiler_infer_result(result_context, typed)
					None:
						next = compiler_infer_error(
							context,
							"Cannot infer element type for empty list literal",
						)
						typed = CompilerTypedListExpr(
							[],
							span,
							compiler_inferred_info(next, compiler_type_list(compiler_type_void())),
						)
						compiler_infer_result(next, typed)


private pure func compiler_infer_vector_tail_items(
	context: CompilerInferContext,
	items: List[ParsedExpr],
	start_index: Int,
	item_type: CompilerType,
	typed_items: List[CompilerTypedExpr],
) -> CompilerInferExprListResult:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var result_items: List[CompilerTypedExpr] = typed_items
	var index: Int = start_index

	while index < items.length():
		match items.get(index):
			Some(item):
				item_result = compiler_infer_expr(
					compiler_infer_with_expected_value_slot(
						next_context,
						item_type,
						CompilerExpectedCollectionElementSlot(CompilerVectorLiteral),
					),
					item,
				)
				item_semantic_type = compiler_typed_expr_semantic_type(item_result.expr)
				item_candidate_type = compiler_default_collection_element_type(item_semantic_type)
				item_slot = compiler_collection_slot_for_target(
					CompilerVectorLiteral,
					item_type,
					item_semantic_type,
				)
				typed_item = compiler_typed_expr_with_slot(item_result.expr, item_slot)
				item_value_type = compiler_typed_expr_value_type(typed_item)

				next_context = if compiler_types_equal(item_value_type, item_type):
					compiler_infer_context_copy(item_result.context)
				else:
					compiler_vector_element_mismatch_error(
						item_result.context,
						index,
						item_type,
						item_candidate_type,
					)

				next_context = compiler_check_resource_capability_storage(
					next_context,
					"tensor literals",
					item_value_type,
				)
				result_items = result_items.append(typed_item)
			None:
				void

		index += 1

	compiler_infer_expr_list_result(compiler_infer_without_expected(next_context), result_items)


private pure func compiler_array_type_from_item_count(
	item_type: CompilerType,
	count: Int,
) -> CompilerType:
	match compiler_array_type_parts(item_type):
		Some((element_type, dims)):
			var result_dims: List[CompilerType] = [CompilerConstIntType(count)]

			for dim in dims:
				result_dims = result_dims.append(dim)

			compiler_array_type(element_type, result_dims)
		None:
			compiler_array_type(item_type, [CompilerConstIntType(count)])


private pure func compiler_infer_vector_expr(
	context: CompilerInferContext,
	items: List[ParsedExpr],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	match compiler_expected_vector_type(context):
		Some((element_type, dims)):
			result_type = compiler_array_type(element_type, dims)
			item_type = compiler_vector_item_type(element_type, dims)
			count_context = compiler_check_vector_expected_count(context, dims, items.length())
			nested_context = compiler_check_nested_vector_literal_items(
				count_context,
				items,
				item_type,
			)

			storage_context = if items.length() == 0:
				compiler_check_resource_capability_storage(
					nested_context,
					"tensor literals",
					item_type,
				)
			else:
				compiler_infer_context_copy(nested_context)

			items_result = compiler_infer_vector_tail_items(
				storage_context,
				items,
				0,
				item_type,
				[],
			)
			result_context = compiler_infer_context_with_state(context, items_result.context.state)
			typed = CompilerTypedVectorExpr(
				items_result.exprs,
				span,
				compiler_inferred_info(result_context, result_type),
			)
			compiler_infer_result(result_context, typed)
		None:
			if items.length() == 0:
				next = compiler_infer_error(context, "Cannot infer type of empty tensor literal")
				typed = CompilerTypedVectorExpr(
					[],
					span,
					compiler_inferred_info(
						next,
						compiler_array_type(compiler_type_void(), [CompilerConstIntType(0)]),
					),
				)
				compiler_infer_result(next, typed)
			else:
				match items.get(0):
					Some(first_item):
						first_result = compiler_infer_expr(
							compiler_infer_without_expected(context),
							first_item,
						)
						first_semantic_type = compiler_typed_expr_semantic_type(first_result.expr)
						item_type = compiler_default_collection_element_type(first_semantic_type)
						first_typed = compiler_typed_expr_with_slot(
							first_result.expr,
							compiler_collection_slot_for_target(
								CompilerVectorLiteral,
								item_type,
								first_semantic_type,
							),
						)

						first_context = if compiler_types_equal(
							compiler_typed_expr_value_type(first_typed),
							item_type,
						):
							compiler_infer_context_copy(first_result.context)
						else:
							compiler_vector_element_mismatch_error(
								first_result.context,
								0,
								item_type,
								compiler_typed_expr_value_type(first_typed),
							)

						first_storage_context = compiler_check_resource_capability_storage(
							first_context,
							"tensor literals",
							compiler_typed_expr_value_type(first_typed),
						)
						nested_context = compiler_check_nested_vector_literal_items(
							first_storage_context,
							items,
							item_type,
						)
						items_result = compiler_infer_vector_tail_items(
							nested_context,
							items,
							1,
							item_type,
							[first_typed],
						)
						result_context = compiler_infer_context_with_state(
							context,
							items_result.context.state,
						)
						vector_type = compiler_array_type_from_item_count(item_type, items.length())
						typed = CompilerTypedVectorExpr(
							items_result.exprs,
							span,
							compiler_inferred_info(result_context, vector_type),
						)
						compiler_infer_result(result_context, typed)
					None:
						next = compiler_infer_error(
							context,
							"Cannot infer type of empty tensor literal",
						)
						typed = CompilerTypedVectorExpr(
							[],
							span,
							compiler_inferred_info(
								next,
								compiler_array_type(
									compiler_type_void(),
									[CompilerConstIntType(0)],
								),
							),
						)
						compiler_infer_result(next, typed)


private pure func compiler_expected_dict_types(
	context: CompilerInferContext,
) -> Option[(CompilerType, CompilerType)]:
	match context.expected_type:
		Some(expected):
			match expected:
				CompilerNamedType(name, args):
					if name == "Dict" and args.length() == 2:
						match (args.get(0), args.get(1)):
							(Some(key_type), Some(value_type)):
								Some((compiler_type_copy(key_type), compiler_type_copy(value_type)))
							_:
								None
					else:
						None
				_:
					None
		None:
			None


private pure func compiler_dict_entry_mismatch_error(
	context: CompilerInferContext,
	label: String,
	index: Int,
	expected: CompilerType,
	got: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		label + " " + (index + 1).to_string() + " expected " + compiler_type_to_string(
			expected,
		) + ", got " + compiler_type_to_string(got),
	)


private pure func compiler_infer_dict_entries_result(
	context: CompilerInferContext,
	entries: List[CompilerTypedDictEntry],
) -> CompilerInferDictEntriesResult:
	{
		context = compiler_infer_context_copy(context),
		entries = entries
	}


private pure func compiler_infer_dict_entries(
	context: CompilerInferContext,
	entries: List[ParsedDictEntry],
	start_index: Int,
	key_type: CompilerType,
	value_type: CompilerType,
	typed_entries: List[CompilerTypedDictEntry],
) -> CompilerInferDictEntriesResult:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var result_entries: List[CompilerTypedDictEntry] = typed_entries
	var index: Int = start_index

	while index < entries.length():
		match entries.get(index):
			Some(entry):
				key_result = compiler_infer_expr(
					compiler_infer_without_expected(next_context),
					entry.key,
				)
				key_semantic_type = compiler_typed_expr_semantic_type(key_result.expr)
				key_candidate_type = compiler_default_collection_element_type(key_semantic_type)
				typed_key = compiler_typed_expr_with_slot(
					key_result.expr,
					compiler_collection_slot_for_target(
						CompilerDictLiteral,
						key_type,
						key_semantic_type,
					),
				)
				key_value_type = compiler_typed_expr_value_type(typed_key)

				key_context = if compiler_types_equal(key_value_type, key_type):
					compiler_infer_context_copy(key_result.context)
				else:
					compiler_dict_entry_mismatch_error(
						key_result.context,
						"Dict literal key",
						index,
						key_type,
						key_candidate_type,
					)

				key_storage_context = compiler_check_resource_capability_storage(
					key_context,
					"Dict literals",
					key_value_type,
				)

				value_result = compiler_infer_expr(
					compiler_infer_without_expected(key_storage_context),
					entry.value,
				)
				value_semantic_type = compiler_typed_expr_semantic_type(value_result.expr)
				value_candidate_type = compiler_default_collection_element_type(value_semantic_type)
				typed_value = compiler_typed_expr_with_slot(
					value_result.expr,
					compiler_collection_slot_for_target(
						CompilerDictLiteral,
						value_type,
						value_semantic_type,
					),
				)
				value_value_type = compiler_typed_expr_value_type(typed_value)

				next_context = if compiler_types_equal(value_value_type, value_type):
					compiler_infer_context_copy(value_result.context)
				else:
					compiler_dict_entry_mismatch_error(
						value_result.context,
						"Dict literal value",
						index,
						value_type,
						value_candidate_type,
					)

				next_context = compiler_check_resource_capability_storage(
					next_context,
					"Dict literals",
					value_value_type,
				)
				typed_entry = compiler_typed_dict_entry(typed_key, typed_value)
				result_entries = result_entries.append(typed_entry)
			None:
				void

		index += 1

	compiler_infer_dict_entries_result(
		compiler_infer_without_expected(next_context),
		result_entries,
	)


private pure func compiler_infer_dict_expr(
	context: CompilerInferContext,
	entries: List[ParsedDictEntry],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	match compiler_expected_dict_types(context):
		Some((key_type, value_type)):
			initial_context = if entries.length() == 0:
				key_context = compiler_check_resource_capability_storage(
					context,
					"Dict literals",
					key_type,
				)
				compiler_check_resource_capability_storage(key_context, "Dict literals", value_type)
			else:
				compiler_infer_context_copy(context)

			entries_result = compiler_infer_dict_entries(
				initial_context,
				entries,
				0,
				key_type,
				value_type,
				[],
			)
			result_context = compiler_infer_context_with_state(
				context,
				entries_result.context.state,
			)
			dict_type = compiler_type_dict(key_type, value_type)
			typed = CompilerTypedDictExpr(
				entries_result.entries,
				span,
				compiler_inferred_info(result_context, dict_type),
			)
			compiler_infer_result(result_context, typed)
		None:
			if entries.length() == 0:
				next = compiler_infer_error(context, "Cannot infer type of empty dict literal")
				typed = CompilerTypedDictExpr(
					[],
					span,
					compiler_inferred_info(
						next,
						compiler_type_dict(compiler_type_void(), compiler_type_void()),
					),
				)
				compiler_infer_result(next, typed)
			else:
				match entries.get(0):
					Some(first_entry):
						first_key_result = compiler_infer_expr(
							compiler_infer_without_expected(context),
							first_entry.key,
						)
						first_key_semantic_type = compiler_typed_expr_semantic_type(
							first_key_result.expr,
						)
						key_type = compiler_default_collection_element_type(first_key_semantic_type)
						first_key = compiler_typed_expr_with_slot(
							first_key_result.expr,
							compiler_collection_slot_for_target(
								CompilerDictLiteral,
								key_type,
								first_key_semantic_type,
							),
						)
						first_key_context = compiler_check_resource_capability_storage(
							first_key_result.context,
							"Dict literals",
							compiler_typed_expr_value_type(first_key),
						)

						first_value_result = compiler_infer_expr(
							compiler_infer_without_expected(first_key_context),
							first_entry.value,
						)
						first_value_semantic_type = compiler_typed_expr_semantic_type(
							first_value_result.expr,
						)
						value_type = compiler_default_collection_element_type(
							first_value_semantic_type,
						)
						first_value = compiler_typed_expr_with_slot(
							first_value_result.expr,
							compiler_collection_slot_for_target(
								CompilerDictLiteral,
								value_type,
								first_value_semantic_type,
							),
						)
						first_context = compiler_check_resource_capability_storage(
							first_value_result.context,
							"Dict literals",
							compiler_typed_expr_value_type(first_value),
						)
						entries_result = compiler_infer_dict_entries(
							first_context,
							entries,
							1,
							key_type,
							value_type,
							[compiler_typed_dict_entry(first_key, first_value)],
						)
						result_context = compiler_infer_context_with_state(
							context,
							entries_result.context.state,
						)
						dict_type = compiler_type_dict(key_type, value_type)
						typed = CompilerTypedDictExpr(
							entries_result.entries,
							span,
							compiler_inferred_info(result_context, dict_type),
						)
						compiler_infer_result(result_context, typed)
					None:
						next = compiler_infer_error(
							context,
							"Cannot infer type of empty dict literal",
						)
						typed = CompilerTypedDictExpr(
							[],
							span,
							compiler_inferred_info(
								next,
								compiler_type_dict(compiler_type_void(), compiler_type_void()),
							),
						)
						compiler_infer_result(next, typed)


private pure func compiler_record_subst_for_args(
	type_params: List[String],
	args: List[CompilerType],
) -> List[CompilerTypeSubstEntry]:
	var subst: List[CompilerTypeSubstEntry] = []
	var index: Int = 0

	while index < type_params.length() and index < args.length():
		match (type_params.get(index), args.get(index)):
			(Some(type_param), Some(arg)):
				subst = subst.append(compiler_type_subst_entry(type_param, arg))
			_:
				void

		index += 1

	subst


private pure func compiler_record_field_types(
	context: CompilerInferContext,
	record_name: String,
	args: List[CompilerType],
) -> Option[List[CompilerFieldDecl]]:
	match compiler_env_get_record(context.state.env, record_name):
		Some((type_params, fields)):
			if type_params.length() != args.length():
				None
			else:
				subst = compiler_record_subst_for_args(type_params, args)
				Some(fields.map(
					func(field: CompilerFieldDecl) -> CompilerFieldDecl: {
						name = field.name,
						field_type = compiler_apply_subst(subst, field.field_type)
					},
				))
		None:
			None


private pure func compiler_find_record_field(
	fields: List[CompilerFieldDecl],
	name: String,
) -> Option[CompilerFieldDecl]:
	var result: Option[CompilerFieldDecl] = None
	var index: Int = 0

	while index < fields.length() and result.is_none():
		match fields.get(index):
			Some(field):
				if field.name == name:
					result = Some({
						name = field.name,
						field_type = compiler_type_copy(field.field_type),
					})
			None:
				void

		index += 1

	result


private pure func compiler_record_field_names(fields: List[CompilerFieldDecl]) -> List[String]:
	fields.map(func(field): field.name)


private pure func compiler_record_expr_field_names(
	fields: List[ParsedRecordExprField],
) -> List[String]:
	fields.map(func(field): field.name.text)


private pure func compiler_missing_record_field_names(
	expected_fields: List[CompilerFieldDecl],
	actual_fields: List[ParsedRecordExprField],
) -> List[String]:
	provided_names = compiler_record_expr_field_names(actual_fields)
	var missing: List[String] = []

	for field in expected_fields:
		if not provided_names.contains(field.name):
			missing = missing.append(field.name)

	missing


private pure func compiler_record_missing_fields_error(
	context: CompilerInferContext,
	missing_names: List[String],
) -> CompilerInferContext:
	if missing_names.length() == 0:
		compiler_infer_context_copy(context)
	else:
		compiler_infer_error(
			context,
			"Record literal is missing field(s): " + missing_names.join(", "),
		)


private pure func compiler_record_unknown_field_error(
	context: CompilerInferContext,
	field_name: String,
	expected_fields: List[CompilerFieldDecl],
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Unknown field '" + field_name + "' in record literal. Valid fields: " + compiler_record_field_names(
			expected_fields,
		).join(", "),
	)


private pure func compiler_record_field_mismatch_error(
	context: CompilerInferContext,
	field_name: String,
	expected: CompilerType,
	got: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Record field '" + field_name + "': expected " + compiler_type_to_string(
			expected,
		) + ", got " + compiler_type_to_string(got),
	)


private pure func compiler_infer_record_fields_result(
	context: CompilerInferContext,
	fields: List[CompilerTypedRecordField],
) -> CompilerInferRecordFieldsResult:
	{
		context = compiler_infer_context_copy(context),
		fields = fields
	}


private pure func compiler_infer_record_fields(
	context: CompilerInferContext,
	fields: List[ParsedRecordExprField],
	expected_fields: List[CompilerFieldDecl],
) -> CompilerInferRecordFieldsResult:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var typed_fields: List[CompilerTypedRecordField] = []
	var index: Int = 0

	while index < fields.length():
		match fields.get(index):
			Some(field):
				match compiler_find_record_field(expected_fields, field.name.text):
					Some(expected_field):
						value_result = compiler_infer_expr(
							compiler_infer_with_expected_value_slot(
								next_context,
								expected_field.field_type,
								CompilerExpectedArgumentSlot,
							),
							field.value,
						)
						value_type = compiler_typed_expr_value_type(value_result.expr)

						next_context = if compiler_types_equal(
							value_type,
							expected_field.field_type,
						):
							compiler_infer_context_copy(value_result.context)
						else:
							compiler_record_field_mismatch_error(
								value_result.context,
								field.name.text,
								expected_field.field_type,
								value_type,
							)

						next_context = compiler_check_resource_capability_storage(
							next_context,
							"record fields",
							value_type,
						)
						typed_fields = typed_fields.append({
							name = field.name,
							value = value_result.expr,
							span = field.span,
						})
					None:
						unknown_context = compiler_record_unknown_field_error(
							next_context,
							field.name.text,
							expected_fields,
						)
						value_result = compiler_infer_expr(
							compiler_infer_without_expected(unknown_context),
							field.value,
						)
						next_context = compiler_check_resource_capability_storage(
							value_result.context,
							"record fields",
							compiler_typed_expr_value_type(value_result.expr),
						)
						typed_fields = typed_fields.append({
							name = field.name,
							value = value_result.expr,
							span = field.span,
						})
			None:
				void

		index += 1

	compiler_infer_record_fields_result(compiler_infer_without_expected(next_context), typed_fields)


private pure func compiler_infer_unconstrained_record_fields(
	context: CompilerInferContext,
	fields: List[ParsedRecordExprField],
) -> CompilerInferRecordFieldsResult:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var typed_fields: List[CompilerTypedRecordField] = []
	var index: Int = 0

	while index < fields.length():
		match fields.get(index):
			Some(field):
				value_result = compiler_infer_expr(
					compiler_infer_without_expected(next_context),
					field.value,
				)
				next_context = compiler_check_resource_capability_storage(
					value_result.context,
					"record fields",
					compiler_typed_expr_value_type(value_result.expr),
				)
				typed_fields = typed_fields.append({
					name = field.name,
					value = value_result.expr,
					span = field.span,
				})
			None:
				void

		index += 1

	compiler_infer_record_fields_result(compiler_infer_without_expected(next_context), typed_fields)


private pure func compiler_infer_known_record_expr(
	context: CompilerInferContext,
	fields: List[ParsedRecordExprField],
	span: CompilerSourceSpan,
	record_type: CompilerType,
	expected_fields: List[CompilerFieldDecl],
) -> CompilerInferResult:
	fields_result = compiler_infer_record_fields(context, fields, expected_fields)
	missing_context = compiler_record_missing_fields_error(
		fields_result.context,
		compiler_missing_record_field_names(expected_fields, fields),
	)
	result_context = compiler_infer_context_with_state(context, missing_context.state)
	typed = CompilerTypedRecordExpr(
		fields_result.fields,
		span,
		compiler_inferred_info(result_context, record_type),
	)

	compiler_infer_result(result_context, typed)


private pure func compiler_record_literal_inference_error(
	context: CompilerInferContext,
	fields: List[ParsedRecordExprField],
	span: CompilerSourceSpan,
	message: String,
) -> CompilerInferResult:
	next = compiler_infer_error(context, message)
	fields_result = compiler_infer_unconstrained_record_fields(
		compiler_infer_without_expected(next),
		fields,
	)
	result_context = compiler_infer_context_with_state(context, fields_result.context.state)
	typed = CompilerTypedRecordExpr(
		fields_result.fields,
		span,
		compiler_inferred_info(result_context, compiler_type_void()),
	)

	compiler_infer_result(result_context, typed)


private CANNOT_INFER_RECORD_MESSAGE: String = (
	"Cannot infer record type without annotation. Add an explicit record type, e.g. "
	+ "p: Point = {x = 1, y = 2}"
)


private pure func compiler_invalid_record_literal_message(
	fields: List[ParsedRecordExprField],
	expected_type: CompilerType,
) -> String:
	if fields.length() == 0:
		"Cannot use {} for type " + compiler_type_to_string(expected_type) + ": not a record type"
	else:
		"Cannot use record literal for type " + compiler_type_to_string(expected_type)


private pure func compiler_infer_record_from_fields(
	context: CompilerInferContext,
	fields: List[ParsedRecordExprField],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	if fields.length() == 0:
		compiler_record_literal_inference_error(context, fields, span, CANNOT_INFER_RECORD_MESSAGE)
	else:
		field_names = compiler_record_expr_field_names(fields)
		matches = compiler_env_find_records_with_fields(context.state.env, field_names)

		if matches.length() == 0:
			compiler_record_literal_inference_error(
				context,
				fields,
				span,
				CANNOT_INFER_RECORD_MESSAGE,
			)
		else if matches.length() == 1:
			match matches.get(0):
				Some(record_name):
					match compiler_record_field_types(context, record_name, []):
						Some(expected_fields):
							compiler_infer_known_record_expr(
								context,
								fields,
								span,
								CompilerNamedType(record_name, []),
								expected_fields,
							)
						None:
							compiler_record_literal_inference_error(
								context,
								fields,
								span,
								"Internal error: matched record type '" + record_name + "' has no field metadata",
							)
				None:
					compiler_record_literal_inference_error(
						context,
						fields,
						span,
						CANNOT_INFER_RECORD_MESSAGE,
					)
		else:
			compiler_record_literal_inference_error(
				context,
				fields,
				span,
				"Ambiguous record literal: could be " + matches.join(
					" or ",
				) + ". Multiple types share fields {" + field_names.join(", ") + "}",
			)


private pure func compiler_expected_empty_record_collection_type(
	context: CompilerInferContext,
) -> Option[CompilerType]:
	match context.expected_type:
		Some(expected_type):
			match expected_type:
				CompilerNamedType(name, args):
					if (
						name == "Dict" and args.length() == 2
						or name == "Set" and args.length() == 1
					):
						Some(compiler_type_copy(expected_type))
					else:
						None
				_:
					None
		None:
			None


private pure func compiler_infer_empty_record_collection_expr(
	context: CompilerInferContext,
	collection_type: CompilerType,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	container = match collection_type:
		CompilerNamedType("Set", _):
			"Set literals"
		_:
			"Dict literals"

	result_context = compiler_check_resource_capability_storage(context, container, collection_type)
	typed = CompilerTypedDictExpr(
		[],
		span,
		compiler_inferred_info(result_context, collection_type),
	)
	compiler_infer_result(result_context, typed)


private pure func compiler_infer_record_expr_as_record(
	context: CompilerInferContext,
	fields: List[ParsedRecordExprField],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	match context.expected_type:
		Some(expected_type):
			match expected_type:
				CompilerNamedType(record_name, args):
					match compiler_record_field_types(context, record_name, args):
						Some(expected_fields):
							compiler_infer_known_record_expr(
								context,
								fields,
								span,
								CompilerNamedType(
									record_name,
									args.map(compiler_type_copy),
								),
								expected_fields,
							)
						None:
							compiler_record_literal_inference_error(
								context,
								fields,
								span,
								compiler_invalid_record_literal_message(fields, expected_type),
							)
				_:
					compiler_record_literal_inference_error(
						context,
						fields,
						span,
						compiler_invalid_record_literal_message(fields, expected_type),
					)
		None:
			compiler_infer_record_from_fields(context, fields, span)


private pure func compiler_infer_record_expr(
	context: CompilerInferContext,
	fields: List[ParsedRecordExprField],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	if fields.length() == 0:
		match compiler_expected_empty_record_collection_type(context):
			Some(collection_type):
				compiler_infer_empty_record_collection_expr(context, collection_type, span)
			None:
				compiler_infer_record_expr_as_record(context, fields, span)
	else:
		compiler_infer_record_expr_as_record(context, fields, span)


private pure func compiler_record_update_unknown_field_error(
	context: CompilerInferContext,
	record_name: String,
	field_name: String,
	expected_fields: List[CompilerFieldDecl],
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Record " + record_name + " has no field '" + field_name + "'. Valid fields: " + compiler_record_field_names(
			expected_fields,
		).join(", "),
	)


private pure func compiler_record_update_field_mismatch_error(
	context: CompilerInferContext,
	field_name: String,
	expected: CompilerType,
	got: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Record update field '" + field_name + "' type mismatch: expected " + compiler_type_to_string(
			expected,
		) + ", got " + compiler_type_to_string(got),
	)


private pure func compiler_infer_record_update_fields(
	context: CompilerInferContext,
	record_name: String,
	fields: List[ParsedRecordExprField],
	expected_fields: List[CompilerFieldDecl],
) -> CompilerInferRecordFieldsResult:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var typed_fields: List[CompilerTypedRecordField] = []
	var index: Int = 0

	while index < fields.length():
		match fields.get(index):
			Some(field):
				match compiler_find_record_field(expected_fields, field.name.text):
					Some(expected_field):
						value_result = compiler_infer_expr(
							compiler_infer_with_expected_value_slot(
								next_context,
								expected_field.field_type,
								CompilerExpectedArgumentSlot,
							),
							field.value,
						)
						value_type = compiler_typed_expr_value_type(value_result.expr)

						next_context = if compiler_types_equal(
							value_type,
							expected_field.field_type,
						):
							compiler_infer_context_copy(value_result.context)
						else:
							compiler_record_update_field_mismatch_error(
								value_result.context,
								field.name.text,
								expected_field.field_type,
								value_type,
							)

						next_context = compiler_check_resource_capability_storage(
							next_context,
							"record updates",
							value_type,
						)
						typed_fields = typed_fields.append({
							name = field.name,
							value = value_result.expr,
							span = field.span,
						})
					None:
						unknown_context = compiler_record_update_unknown_field_error(
							next_context,
							record_name,
							field.name.text,
							expected_fields,
						)
						value_result = compiler_infer_expr(
							compiler_infer_without_expected(unknown_context),
							field.value,
						)
						next_context = compiler_check_resource_capability_storage(
							value_result.context,
							"record updates",
							compiler_typed_expr_value_type(value_result.expr),
						)
						typed_fields = typed_fields.append({
							name = field.name,
							value = value_result.expr,
							span = field.span,
						})
			None:
				void

		index += 1

	compiler_infer_record_fields_result(compiler_infer_without_expected(next_context), typed_fields)


private pure func compiler_record_update_non_record_error(
	context: CompilerInferContext,
	base_type: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Record update requires a record type, got " + compiler_type_to_string(base_type),
	)


private pure func compiler_record_update_unknown_type_error(
	context: CompilerInferContext,
	type_name: String,
) -> CompilerInferContext:
	compiler_infer_error(context, "Type " + type_name + " is not a record")


private pure func compiler_infer_record_update_expr(
	context: CompilerInferContext,
	base: ParsedExpr,
	fields: List[ParsedRecordExprField],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	base_result = compiler_infer_expr(compiler_infer_without_expected(context), base)
	base_type = compiler_typed_expr_semantic_type(base_result.expr)
	base_context = compiler_check_resource_capability_storage(
		base_result.context,
		"record updates",
		base_type,
	)

	match base_type:
		CompilerNamedType(record_name, args):
			match compiler_record_field_types(context, record_name, args):
				Some(expected_fields):
					fields_result = compiler_infer_record_update_fields(
						base_context,
						record_name,
						fields,
						expected_fields,
					)
					result_context = compiler_infer_context_with_state(
						context,
						fields_result.context.state,
					)
					typed = CompilerTypedRecordUpdateExpr(
						base_result.expr,
						fields_result.fields,
						span,
						compiler_inferred_info(result_context, base_type),
					)
					compiler_infer_result(result_context, typed)
				None:
					next = compiler_record_update_unknown_type_error(base_context, record_name)
					fields_result = compiler_infer_unconstrained_record_fields(
						compiler_infer_without_expected(next),
						fields,
					)
					result_context = compiler_infer_context_with_state(
						context,
						fields_result.context.state,
					)
					typed = CompilerTypedRecordUpdateExpr(
						base_result.expr,
						fields_result.fields,
						span,
						compiler_inferred_info(result_context, compiler_type_void()),
					)
					compiler_infer_result(result_context, typed)
		_:
			next = compiler_record_update_non_record_error(base_context, base_type)
			fields_result = compiler_infer_unconstrained_record_fields(
				compiler_infer_without_expected(next),
				fields,
			)
			result_context = compiler_infer_context_with_state(context, fields_result.context.state)
			typed = CompilerTypedRecordUpdateExpr(
				base_result.expr,
				fields_result.fields,
				span,
				compiler_inferred_info(result_context, compiler_type_void()),
			)
			compiler_infer_result(result_context, typed)


private pure func compiler_tuple_field_type(
	elements: List[CompilerType],
	field: String,
) -> Option[CompilerType]:
	match field.parse_int():
		Some(index):
			if index >= 0 and index < elements.length():
				elements
					.get(index)
					.map(compiler_type_copy)
			else:
				None
		None:
			None


private pure func compiler_record_field_access_error(
	context: CompilerInferContext,
	typ: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Cannot access field on type " + compiler_type_to_string(typ) + ((
			". Field access is supported on record fields. Use tuple[index] for tuple "
			+ "elements"
		)),
	)


private pure func compiler_infer_field_access_expr(
	context: CompilerInferContext,
	receiver: ParsedExpr,
	field: ParsedIdentifier,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	match compiler_infer_qualified_module_field_expr(context, receiver, field, span):
		Some(result):
			result
		None:
			compiler_infer_ordinary_field_access_expr(context, receiver, field, span)


private pure func compiler_infer_ordinary_field_access_expr(
	context: CompilerInferContext,
	receiver: ParsedExpr,
	field: ParsedIdentifier,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	receiver_result = compiler_infer_expr(compiler_infer_without_expected(context), receiver)
	receiver_type = compiler_typed_expr_semantic_type(receiver_result.expr)

	match receiver_type:
		CompilerTupleType(elements):
			match compiler_tuple_field_type(elements, field.text):
				Some(field_type):
					result_context = compiler_infer_context_with_state(
						context,
						receiver_result.context.state,
					)
					typed = CompilerTypedFieldAccessExpr(
						receiver_result.expr,
						field,
						span,
						compiler_inferred_info(result_context, field_type),
					)
					compiler_infer_result(result_context, typed)
				None:
					next = compiler_infer_error(
						receiver_result.context,
						"Tuple of arity " + elements
							.length()
							.to_string() + " has no field " + field.text,
					)
					typed = CompilerTypedFieldAccessExpr(
						receiver_result.expr,
						field,
						span,
						compiler_inferred_info(next, compiler_type_void()),
					)
					compiler_infer_result(next, typed)
		CompilerNamedType(name, args):
			if name == "Tuple":
				match compiler_tuple_field_type(args, field.text):
					Some(field_type):
						result_context = compiler_infer_context_with_state(
							context,
							receiver_result.context.state,
						)
						typed = CompilerTypedFieldAccessExpr(
							receiver_result.expr,
							field,
							span,
							compiler_inferred_info(result_context, field_type),
						)
						compiler_infer_result(result_context, typed)
					None:
						next = compiler_infer_error(
							receiver_result.context,
							"Tuple of arity " + args
								.length()
								.to_string() + " has no field " + field.text,
						)
						typed = CompilerTypedFieldAccessExpr(
							receiver_result.expr,
							field,
							span,
							compiler_inferred_info(next, compiler_type_void()),
						)
						compiler_infer_result(next, typed)
			else:
				match compiler_record_field_types(context, name, args):
					Some(fields):
						match compiler_find_record_field(fields, field.text):
							Some(field_decl):
								result_context = compiler_infer_context_with_state(
									context,
									receiver_result.context.state,
								)
								typed = CompilerTypedFieldAccessExpr(
									receiver_result.expr,
									field,
									span,
									compiler_inferred_info(result_context, field_decl.field_type),
								)
								compiler_infer_result(result_context, typed)
							None:
								next = compiler_infer_error(
									receiver_result.context,
									"Record " + name + " has no field '" + field.text + "'. Valid fields: " + compiler_record_field_names(
										fields,
									).join(", "),
								)
								typed = CompilerTypedFieldAccessExpr(
									receiver_result.expr,
									field,
									span,
									compiler_inferred_info(next, compiler_type_void()),
								)
								compiler_infer_result(next, typed)
					None:
						next = compiler_record_field_access_error(
							receiver_result.context,
							receiver_type,
						)
						typed = CompilerTypedFieldAccessExpr(
							receiver_result.expr,
							field,
							span,
							compiler_inferred_info(next, compiler_type_void()),
						)
						compiler_infer_result(next, typed)
		_:
			next = compiler_record_field_access_error(receiver_result.context, receiver_type)
			typed = CompilerTypedFieldAccessExpr(
				receiver_result.expr,
				field,
				span,
				compiler_inferred_info(next, compiler_type_void()),
			)
			compiler_infer_result(next, typed)


private pure func compiler_subscript_static_index(index_expr: ParsedExpr) -> Option[Int]:
	match index_expr:
		ParsedIntLiteralExpr(text, _):
			Some(compiler_parse_int_literal(text))
		ParsedUnaryExpr(ParsedNegateOp, ParsedIntLiteralExpr(text, _), _):
			Some(0 - compiler_parse_int_literal(text))
		_:
			None


private pure func compiler_infer_subscript_indices_result(
	context: CompilerInferContext,
	indices: List[CompilerTypedExpr],
	values: List[Int],
	static_flags: List[Bool],
	all_static: Bool,
) -> CompilerInferSubscriptIndicesResult:
	{
		context = compiler_infer_context_copy(context),
		indices = indices,
		values = values,
		static_flags = static_flags,
		all_static = all_static
	}


private pure func compiler_static_subscript_index_error(
	context: CompilerInferContext,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		(
			"Subscript index must be a compile-time integer literal. Use get() for runtime-"
			+ "checked access"
		),
	)


private pure func compiler_infer_subscript_indices(
	context: CompilerInferContext,
	indices: List[ParsedExpr],
) -> CompilerInferSubscriptIndicesResult:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var typed_indices: List[CompilerTypedExpr] = []
	var values: List[Int] = []
	var static_flags: List[Bool] = []
	var all_static: Bool = True
	var index: Int = 0

	while index < indices.length():
		match indices.get(index):
			Some(index_expr):
				index_result = compiler_infer_expr(
					compiler_infer_with_expected_value_slot(
						next_context,
						compiler_type_int(),
						CompilerExpectedArgumentSlot,
					),
					index_expr,
				)
				index_type = compiler_typed_expr_value_type(index_result.expr)

				type_context = if compiler_range_endpoint_type_is_int_like(index_type):
					compiler_infer_context_copy(index_result.context)
				else:
					compiler_infer_error(
						index_result.context,
						"Subscript index must be Int, got " + compiler_type_to_string(index_type),
					)

				match compiler_subscript_static_index(index_expr):
					Some(value):
						values = values.append(value)
						static_flags = static_flags.append(True)
						next_context = compiler_infer_context_copy(type_context)
					None:
						values = values.append(0)
						static_flags = static_flags.append(False)
						all_static = False
						next_context = compiler_infer_context_copy(type_context)

				typed_indices = typed_indices.append(index_result.expr)
			None:
				void

		index += 1

	compiler_infer_subscript_indices_result(
		compiler_infer_without_expected(next_context),
		typed_indices,
		values,
		static_flags,
		all_static,
	)


private pure func compiler_subscript_single_index_value(values: List[Int]) -> Int:
	match values.get(0):
		Some(value):
			value
		None:
			0


private pure func compiler_subscript_tuple_error(
	context: CompilerInferContext,
	message: String,
) -> CompilerInferContext:
	compiler_infer_error(context, message)


private pure func compiler_subscript_tuple_result_type(
	elements: List[CompilerType],
	values: List[Int],
) -> CompilerType:
	index_value = compiler_subscript_single_index_value(values)

	match elements.get(index_value):
		Some(element):
			compiler_type_copy(element)
		None:
			compiler_type_void()


private pure func compiler_validate_tuple_subscript(
	context: CompilerInferContext,
	elements: List[CompilerType],
	values: List[Int],
	index_count: Int,
	all_static: Bool,
) -> CompilerInferContext:
	if index_count != 1:
		compiler_subscript_tuple_error(
			context,
			"Tuple subscript expects exactly one index, got " + index_count.to_string(),
		)
	else if all_static:
		index_value = compiler_subscript_single_index_value(values)

		if index_value < 0 or index_value >= elements.length():
			compiler_subscript_tuple_error(
				context,
				"Tuple index " + index_value.to_string() + " out of bounds for tuple of arity " + elements
					.length()
					.to_string(),
			)
		else:
			compiler_infer_context_copy(context)
	else:
		compiler_static_subscript_index_error(context)


private pure func compiler_array_subscript_result_type(
	element_type: CompilerType,
	dims: List[CompilerType],
	index_count: Int,
) -> CompilerType:
	if index_count == 1:
		compiler_vector_item_type(element_type, dims)
	else:
		compiler_type_copy(element_type)


private pure func compiler_subscript_resolved_index(index_value: Int, size: Int) -> Int:
	if index_value < 0:
		size + index_value
	else:
		index_value


private pure func compiler_validate_array_index(
	context: CompilerInferContext,
	index_value: Int,
	dim: CompilerType,
) -> CompilerInferContext:
	match dim:
		CompilerConstIntType(size):
			resolved_index = compiler_subscript_resolved_index(index_value, size)

			if resolved_index < 0:
				compiler_infer_error(
					context,
					"Negative index " + index_value.to_string() + " out of bounds for dimension of size " + size.to_string() + " (resolves to " + resolved_index.to_string() + ")",
				)
			else if resolved_index >= size:
				compiler_infer_error(
					context,
					"Index " + index_value.to_string() + " out of bounds for dimension of size " + size.to_string(),
				)
			else:
				compiler_infer_context_copy(context)
		_:
			if compiler_dim_is_proven_positive(dim) and (index_value == 0 or index_value == -1):
				-- Dimensions are constrained positive, so the first and last
				-- positions exist even when a symbolic dimension expression has
				-- not yet been instantiated.
				compiler_infer_context_copy(context)
			else:
				compiler_infer_error(
					context,
					"Cannot verify bounds: dimension is not known at compile time",
				)


private pure func compiler_dim_is_proven_positive(dim: CompilerType) -> Bool:
	match compiler_normalize_dim(dim):
		CompilerConstIntType(value):
			value > 0
		CompilerTypeVar(name):
			compiler_is_dim_var_name(name)
		CompilerNamedType(name, args):
			args.length() == 0 and compiler_is_dim_var_name(name)
		CompilerDimOpType(op, left, right):
			match op:
				CompilerDimAdd:
					compiler_dim_is_proven_positive(left) and compiler_dim_is_proven_positive(right)
				CompilerDimMultiply:
					compiler_dim_is_proven_positive(left) and compiler_dim_is_proven_positive(right)
				_:
					False
		_:
			False


private pure func compiler_range_bound_fits_dim(bound: CompilerType, dim: CompilerType) -> Bool:
	match (bound, dim):
		(CompilerConstIntType(bound_size), CompilerConstIntType(dim_size)):
			bound_size <= dim_size
		(CompilerTypeVar(bound_name), CompilerTypeVar(dim_name)):
			(
				compiler_is_dim_var_name(bound_name)
				and compiler_is_dim_var_name(dim_name)
				and bound_name == dim_name
			)
		_:
			compiler_types_equal(bound, dim)


private pure func compiler_expr_range_bound(expr: CompilerTypedExpr) -> Option[CompilerType]:
	match compiler_typed_expr_semantic_type(expr):
		CompilerRangeType(bound):
			Some(compiler_type_copy(bound))
		_:
			None


private pure func compiler_flattened_index_term(
	expr: CompilerTypedExpr,
) -> Option[(CompilerType, CompilerType)]:
	match expr:
		CompilerTypedBinaryExpr(ParsedMultiplyOp, left, right, _, _):
			match (compiler_expr_range_bound(left), compiler_static_dim_from_typed_expr(right)):
				(Some(outer_bound), Some(stride)):
					Some((outer_bound, stride))
				_:
					match (
						compiler_expr_range_bound(right),
						compiler_static_dim_from_typed_expr(left),
					):
						(Some(outer_bound), Some(stride)):
							Some((outer_bound, stride))
						_:
							None
		_:
			None


private pure func compiler_flattened_index_term_fits_dim(
	term: CompilerTypedExpr,
	offset: CompilerTypedExpr,
	dim: CompilerType,
) -> Bool:
	match (compiler_flattened_index_term(term), compiler_expr_range_bound(offset)):
		(Some((outer_bound, stride)), Some(offset_bound)):
			normalized_stride = compiler_normalize_dim(stride)
			normalized_offset_bound = compiler_normalize_dim(offset_bound)
			normalized_dim = compiler_normalize_dim(dim)
			expected_dim = compiler_normalize_dim(
				CompilerDimOpType(
					CompilerDimMultiply,
					outer_bound,
					normalized_stride,
				),
			)

			(
				compiler_types_equal(normalized_stride, normalized_offset_bound)
				and compiler_types_equal(expected_dim, normalized_dim)
			)
		_:
			False


private pure func compiler_flattened_index_fits_dim(
	expr: CompilerTypedExpr,
	dim: CompilerType,
) -> Bool:
	match expr:
		CompilerTypedBinaryExpr(ParsedAddOp, left, right, _, _):
			(
				compiler_flattened_index_term_fits_dim(left, right, dim)
				or compiler_flattened_index_term_fits_dim(right, left, dim)
			)
		_:
			False


private pure func compiler_subscript_index_location(expr: CompilerTypedExpr) -> String:
	match expr:
		CompilerTypedNameExpr(name, _):
			" at " + compiler_source_span_label(name.span)
		_:
			""


private pure func compiler_validate_array_range_index(
	context: CompilerInferContext,
	index_expr: CompilerTypedExpr,
	dim: CompilerType,
) -> CompilerInferContext:
	index_type = compiler_typed_expr_semantic_type(index_expr)

	match index_type:
		CompilerRangeType(bound):
			if compiler_range_bound_fits_dim(bound, dim):
				compiler_infer_context_copy(context)
			else:
				compiler_infer_error(
					context,
					"Range-refined index " + compiler_type_to_string(
						index_type,
					) + " is not proven in bounds for dimension " + compiler_type_to_string(dim),
				)
		_:
			if compiler_flattened_index_fits_dim(index_expr, dim):
				compiler_infer_context_copy(context)
			else:
				compiler_infer_error(
					context,
					(
						"Subscript index must be a compile-time integer literal. Use get() for runtime-"
						+ "checked access"
					) + compiler_subscript_index_location(index_expr),
				)


private pure func compiler_typed_name_text(expr: CompilerTypedExpr) -> Option[String]:
	match expr:
		CompilerTypedNameExpr(name, _):
			Some(name.text)
		_:
			None


private pure func compiler_positive_modulo_bound(expr: CompilerTypedExpr) -> Option[Int]:
	match compiler_typed_expr_semantic_type(expr):
		CompilerConstIntType(value):
			if value > 0:
				Some(value)
			else:
				None
		_:
			None


private pure func compiler_length_call_receiver_name(expr: CompilerTypedExpr) -> Option[String]:
	match expr:
		CompilerTypedCallExpr(callee, args, _, _):
			match compiler_typed_name_text(callee):
				Some(name):
					if name == "length" or name == "vector_length":
						match args.get(0):
							Some(receiver):
								compiler_typed_name_text(receiver)
							None:
								None
					else:
						None
				None:
					None
		_:
			None


private pure func compiler_modulo_uses_receiver_length(
	receiver: CompilerTypedExpr,
	right: CompilerTypedExpr,
) -> Bool:
	match (compiler_typed_name_text(receiver), compiler_length_call_receiver_name(right)):
		(Some(receiver_name), Some(length_receiver_name)):
			receiver_name == length_receiver_name
		_:
			False


private pure func compiler_safe_subscript_modulo(
	context: CompilerInferContext,
	left: CompilerTypedExpr,
	right: CompilerTypedExpr,
	span: CompilerSourceSpan,
	bound: CompilerType,
) -> CompilerTypedExpr:
	int_info = compiler_inferred_info(compiler_infer_without_expected(context), compiler_type_int())
	inner_mod = CompilerTypedBinaryExpr(ParsedModuloOp, left, right, span, int_info)
	add_bound = CompilerTypedBinaryExpr(ParsedAddOp, inner_mod, right, span, int_info)

	CompilerTypedBinaryExpr(
		ParsedModuloOp,
		add_bound,
		right,
		span,
		compiler_inferred_info(
			compiler_infer_without_expected(context),
			CompilerRangeType(compiler_type_copy(bound)),
		),
	)


private pure func compiler_validated_subscript_index(
	context: CompilerInferContext,
	index: CompilerTypedExpr,
) -> CompilerValidatedSubscriptIndex:
	{
		context = compiler_infer_context_copy(context),
		index = index
	}


private pure func compiler_subscript_modulo_error(
	context: CompilerInferContext,
	index: CompilerTypedExpr,
	message: String,
) -> CompilerValidatedSubscriptIndex:
	compiler_validated_subscript_index(
		compiler_infer_error(context, message),
		index,
	)


private pure func compiler_validate_dynamic_array_index(
	context: CompilerInferContext,
	receiver: CompilerTypedExpr,
	index: CompilerTypedExpr,
	dim: CompilerType,
) -> CompilerValidatedSubscriptIndex:
	match index:
		CompilerTypedBinaryExpr(ParsedModuloOp, left, right, span, _):
			match (compiler_positive_modulo_bound(right), dim):
				(Some(bound), CompilerConstIntType(size)):
					if bound <= size:
						compiler_validated_subscript_index(
							context,
							compiler_safe_subscript_modulo(
								context,
								left,
								right,
								span,
								CompilerConstIntType(bound),
							),
						)
					else:
						compiler_subscript_modulo_error(
							context,
							index,
							"Modulo bound ${bound} exceeds dimension of size ${size}",
						)
				_:
					if compiler_modulo_uses_receiver_length(receiver, right):
						compiler_validated_subscript_index(
							context,
							compiler_safe_subscript_modulo(context, left, right, span, dim),
						)
					else:
						compiler_subscript_modulo_error(
							context,
							index,
							(
								"Subscript modulo requires a positive compile-time integer literal or length(v). "
								+ "Use get() for runtime-checked access"
							),
						)
		_:
			compiler_validated_subscript_index(
				compiler_validate_array_range_index(context, index, dim),
				index,
			)


private pure func compiler_validated_subscript_indices(
	context: CompilerInferContext,
	indices: List[CompilerTypedExpr],
) -> CompilerValidatedSubscriptIndices:
	{
		context = compiler_infer_context_copy(context),
		indices = indices
	}


private pure func compiler_validate_array_subscript_indices(
	context: CompilerInferContext,
	receiver: CompilerTypedExpr,
	dims: List[CompilerType],
	indices: List[CompilerTypedExpr],
	values: List[Int],
	static_flags: List[Bool],
) -> CompilerValidatedSubscriptIndices:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var validated_indices: List[CompilerTypedExpr] = []
	var index: Int = 0

	while index < indices.length() and index < dims.length():
		match (indices.get(index), values.get(index), static_flags.get(index), dims.get(index)):
			(Some(index_expr), Some(index_value), Some(is_static), Some(dim)):
				if is_static:
					next_context = compiler_validate_array_index(next_context, index_value, dim)
					validated_indices = validated_indices.append(index_expr)
				else:
					validated = compiler_validate_dynamic_array_index(
						next_context,
						receiver,
						index_expr,
						dim,
					)
					next_context = validated.context
					validated_indices = validated_indices.append(validated.index)
			_:
				void

		index += 1

	compiler_validated_subscript_indices(next_context, validated_indices)


private pure func compiler_array_subscript_arity_error(
	context: CompilerInferContext,
	index_count: Int,
	dim_count: Int,
) -> CompilerInferContext:
	if index_count == 1:
		compiler_infer_context_copy(context)
	else:
		compiler_infer_error(
			context,
			"Multi-index subscript has " + index_count.to_string() + " indices but array has " + dim_count.to_string() + " dimensions",
		)


private pure func compiler_validate_array_subscript(
	context: CompilerInferContext,
	receiver: CompilerTypedExpr,
	dims: List[CompilerType],
	indices: List[CompilerTypedExpr],
	values: List[Int],
	static_flags: List[Bool],
	index_count: Int,
) -> CompilerValidatedSubscriptIndices:
	if dims.length() == 0:
		compiler_validated_subscript_indices(
			compiler_infer_error(
				context,
				"checked_get requires an array type, got empty dimensions",
			),
			indices,
		)
	else if index_count == 1 or index_count == dims.length():
		compiler_validate_array_subscript_indices(
			context,
			receiver,
			dims,
			indices,
			values,
			static_flags,
		)
	else:
		compiler_validated_subscript_indices(
			compiler_array_subscript_arity_error(context, index_count, dims.length()),
			indices,
		)


private pure func compiler_non_array_subscript_error(
	context: CompilerInferContext,
	typ: CompilerType,
	index_count: Int,
) -> CompilerInferContext:
	match typ:
		CompilerNamedType(name, _):
			if name == "List":
				compiler_infer_error(
					context,
					(
						"checked_get is not supported on List. Use get(list, index) for bounds-checked "
						+ "access"
					),
				)
			else if name == "String":
				compiler_infer_error(
					context,
					(
						"checked_get is not supported on String. Use get(str, index) for bounds-checked "
						+ "access"
					),
				)
			else if index_count == 1:
				compiler_infer_error(
					context,
					"checked_get requires an array type, got " + compiler_type_to_string(typ),
				)
			else:
				compiler_infer_error(
					context,
					"Type " + compiler_type_to_string(typ) + ((
						" does not support multi-index subscript. Multi-index subscript is supported on "
						+ "array types"
					)),
				)
		_:
			if index_count == 1:
				compiler_infer_error(
					context,
					"checked_get requires an array type, got " + compiler_type_to_string(typ),
				)
			else:
				compiler_infer_error(
					context,
					"Type " + compiler_type_to_string(typ) + ((
						" does not support multi-index subscript. Multi-index subscript is supported on "
						+ "array types"
					)),
				)


private pure func compiler_subscript_type_if_no_errors(
	context: CompilerInferContext,
	original_error_count: Int,
	typ: CompilerType,
) -> CompilerType:
	if context.state.errors.length() == original_error_count:
		compiler_type_copy(typ)
	else:
		compiler_type_void()


private pure func compiler_infer_subscript_result(
	context: CompilerInferContext,
	next_context: CompilerInferContext,
	receiver: CompilerTypedExpr,
	indices: List[CompilerTypedExpr],
	span: CompilerSourceSpan,
	result_type: CompilerType,
) -> CompilerInferResult:
	result_context = compiler_infer_context_with_state(context, next_context.state)
	typed = CompilerTypedSubscriptExpr(
		receiver,
		indices,
		span,
		compiler_inferred_info(result_context, result_type),
	)
	compiler_infer_result(result_context, typed)


private pure func compiler_infer_tuple_subscript_result(
	context: CompilerInferContext,
	receiver: CompilerTypedExpr,
	index_result: CompilerInferSubscriptIndicesResult,
	elements: List[CompilerType],
	index_count: Int,
	span: CompilerSourceSpan,
	original_error_count: Int,
) -> CompilerInferResult:
	next_context = compiler_validate_tuple_subscript(
		index_result.context,
		elements,
		index_result.values,
		index_count,
		index_result.all_static,
	)
	result_type = compiler_subscript_type_if_no_errors(
		next_context,
		original_error_count,
		compiler_subscript_tuple_result_type(elements, index_result.values),
	)
	compiler_infer_subscript_result(
		context,
		next_context,
		receiver,
		index_result.indices,
		span,
		result_type,
	)


private pure func compiler_infer_array_subscript_result(
	context: CompilerInferContext,
	receiver: CompilerTypedExpr,
	index_result: CompilerInferSubscriptIndicesResult,
	element_type: CompilerType,
	dims: List[CompilerType],
	index_count: Int,
	span: CompilerSourceSpan,
	original_error_count: Int,
) -> CompilerInferResult:
	validated = compiler_validate_array_subscript(
		index_result.context,
		receiver,
		dims,
		index_result.indices,
		index_result.values,
		index_result.static_flags,
		index_count,
	)
	result_type = compiler_subscript_type_if_no_errors(
		validated.context,
		original_error_count,
		compiler_array_subscript_result_type(element_type, dims, index_count),
	)
	compiler_infer_subscript_result(
		context,
		validated.context,
		receiver,
		validated.indices,
		span,
		result_type,
	)


private pure func compiler_infer_unsupported_subscript_result(
	context: CompilerInferContext,
	receiver: CompilerTypedExpr,
	index_result: CompilerInferSubscriptIndicesResult,
	receiver_type: CompilerType,
	index_count: Int,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	next_context = compiler_non_array_subscript_error(
		index_result.context,
		receiver_type,
		index_count,
	)
	compiler_infer_subscript_result(
		context,
		next_context,
		receiver,
		index_result.indices,
		span,
		compiler_type_void(),
	)


private pure func compiler_infer_subscript_expr(
	context: CompilerInferContext,
	receiver: ParsedExpr,
	indices: List[ParsedExpr],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	original_error_count = context.state.errors.length()
	receiver_result = compiler_infer_expr(compiler_infer_without_expected(context), receiver)
	index_result = compiler_infer_subscript_indices(receiver_result.context, indices)
	receiver_type = compiler_typed_expr_semantic_type(receiver_result.expr)
	index_count = indices.length()

	match receiver_type:
		CompilerTupleType(elements):
			compiler_infer_tuple_subscript_result(
				context,
				receiver_result.expr,
				index_result,
				elements,
				index_count,
				span,
				original_error_count,
			)
		CompilerNamedType(name, args):
			if name == "Tuple":
				compiler_infer_tuple_subscript_result(
					context,
					receiver_result.expr,
					index_result,
					args,
					index_count,
					span,
					original_error_count,
				)
			else:
				match compiler_array_type_parts(receiver_type):
					Some((element_type, dims)):
						compiler_infer_array_subscript_result(
							context,
							receiver_result.expr,
							index_result,
							element_type,
							dims,
							index_count,
							span,
							original_error_count,
						)
					None:
						compiler_infer_unsupported_subscript_result(
							context,
							receiver_result.expr,
							index_result,
							receiver_type,
							index_count,
							span,
						)
		_:
			match compiler_array_type_parts(receiver_type):
				Some((element_type, dims)):
					compiler_infer_array_subscript_result(
						context,
						receiver_result.expr,
						index_result,
						element_type,
						dims,
						index_count,
						span,
						original_error_count,
					)
				None:
					compiler_infer_unsupported_subscript_result(
						context,
						receiver_result.expr,
						index_result,
						receiver_type,
						index_count,
						span,
					)


private pure func compiler_builtin_resolved_call(
	name: String,
	params: List[CompilerType],
	return_type: CompilerType,
) -> CompilerResolvedCallInfo:
	{
		callee_name = name,
		source_name = name,
		purity = CompilerPure,
		target = CompilerResolvedIntrinsicCall,
		instantiated_params = compiler_type_list_copy(params),
		instantiated_return = compiler_type_copy(return_type),
		resource_args = CompilerRejectResourceArgs,
		dim_constraints = [],
		loop_producer = None
	}


private pure func compiler_typed_builtin_callee(
	name: String,
	params: List[CompilerType],
	return_type: CompilerType,
	span: CompilerSourceSpan,
	resolved_call: CompilerResolvedCallInfo,
) -> CompilerTypedExpr:
	func_type = CompilerFunctionType(True, params, return_type)

	CompilerTypedNameExpr(
		parsed_identifier(name, span),
		compiler_typed_expr_info_from_slot(
			None,
			CompilerInferredOrigin,
			compiler_unrefined_binding(),
			Some(resolved_call),
			compiler_keep_value_slot(func_type),
		),
	)


private pure func compiler_checked_get_builtin_result(
	context: CompilerInferContext,
	next_context: CompilerInferContext,
	callee_name: String,
	receiver: CompilerTypedExpr,
	index: CompilerTypedExpr,
	receiver_type: CompilerType,
	result_type: CompilerType,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	result_context = compiler_infer_context_with_state(context, next_context.state)
	params: List[CompilerType] = [compiler_type_copy(receiver_type), compiler_type_int()]
	resolved_call = compiler_builtin_resolved_call(callee_name, params, result_type)
	callee = compiler_typed_builtin_callee(callee_name, params, result_type, span, resolved_call)
	typed = CompilerTypedCallExpr(
		callee,
		[receiver, index],
		span,
		compiler_inferred_call_info(
			result_context,
			result_type,
			Some(resolved_call),
		),
	)

	compiler_infer_result(result_context, typed)


private pure func compiler_checked_get_tuple_result(
	context: CompilerInferContext,
	receiver: CompilerTypedExpr,
	index_result: CompilerInferSubscriptIndicesResult,
	elements: List[CompilerType],
	span: CompilerSourceSpan,
	original_error_count: Int,
) -> CompilerInferResult:
	next_context = compiler_validate_tuple_subscript(
		index_result.context,
		elements,
		index_result.values,
		1,
		index_result.all_static,
	)
	result_type = compiler_subscript_type_if_no_errors(
		next_context,
		original_error_count,
		compiler_subscript_tuple_result_type(elements, index_result.values),
	)
	index_value = compiler_subscript_single_index_value(index_result.values)
	result_context = compiler_infer_context_with_state(context, next_context.state)
	typed = CompilerTypedFieldAccessExpr(
		receiver,
		parsed_identifier(index_value.to_string(), span),
		span,
		compiler_inferred_info(result_context, result_type),
	)

	compiler_infer_result(result_context, typed)


private pure func compiler_checked_get_array_callee_name(dims: List[CompilerType]) -> String:
	if dims.length() > 1:
		"tensor_peel"
	else:
		"checked_get"


private pure func compiler_checked_get_array_result(
	context: CompilerInferContext,
	receiver: CompilerTypedExpr,
	index_result: CompilerInferSubscriptIndicesResult,
	element_type: CompilerType,
	dims: List[CompilerType],
	span: CompilerSourceSpan,
	original_error_count: Int,
) -> CompilerInferResult:
	validated = compiler_validate_array_subscript(
		index_result.context,
		receiver,
		dims,
		index_result.indices,
		index_result.values,
		index_result.static_flags,
		1,
	)
	result_type = compiler_subscript_type_if_no_errors(
		validated.context,
		original_error_count,
		compiler_array_subscript_result_type(element_type, dims, 1),
	)
	receiver_type = compiler_typed_expr_semantic_type(receiver)
	index = validated.indices.get_or(
		0,
		CompilerTypedMissingExpr(
			span,
			compiler_inferred_info(validated.context, compiler_type_int()),
		),
	)

	compiler_checked_get_builtin_result(
		context,
		validated.context,
		compiler_checked_get_array_callee_name(dims),
		receiver,
		index,
		receiver_type,
		result_type,
		span,
	)


private pure func compiler_checked_get_unsupported_result(
	context: CompilerInferContext,
	receiver: CompilerTypedExpr,
	index_result: CompilerInferSubscriptIndicesResult,
	receiver_type: CompilerType,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	next_context = compiler_non_array_subscript_error(index_result.context, receiver_type, 1)
	index = index_result.indices.get_or(
		0,
		CompilerTypedMissingExpr(
			span,
			compiler_inferred_info(next_context, compiler_type_int()),
		),
	)

	compiler_checked_get_builtin_result(
		context,
		next_context,
		"checked_get",
		receiver,
		index,
		receiver_type,
		compiler_type_void(),
		span,
	)


private pure func compiler_infer_checked_get_call(
	context: CompilerInferContext,
	args: List[ParsedExpr],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	if args.length() != 2:
		next = compiler_infer_error(
			context,
			"checked_get takes exactly 2 arguments: (tensor, index: Int)",
		)
		missing = CompilerTypedMissingExpr(
			span,
			compiler_inferred_info(next, compiler_type_void()),
		)
		compiler_infer_result(next, missing)
	else:
		original_error_count = context.state.errors.length()
		receiver_arg = args.get_or(0, ParsedMissingExpr(span))
		index_arg = args.get_or(1, ParsedMissingExpr(span))
		receiver_result = compiler_infer_expr(
			compiler_infer_without_expected(context),
			receiver_arg,
		)
		index_result = compiler_infer_subscript_indices(receiver_result.context, [index_arg])
		receiver_type = compiler_typed_expr_semantic_type(receiver_result.expr)

		match receiver_type:
			CompilerTupleType(elements):
				compiler_checked_get_tuple_result(
					context,
					receiver_result.expr,
					index_result,
					elements,
					span,
					original_error_count,
				)
			CompilerNamedType(name, type_args):
				if name == "Tuple":
					compiler_checked_get_tuple_result(
						context,
						receiver_result.expr,
						index_result,
						type_args,
						span,
						original_error_count,
					)
				else:
					match compiler_array_type_parts(receiver_type):
						Some((element_type, dims)):
							compiler_checked_get_array_result(
								context,
								receiver_result.expr,
								index_result,
								element_type,
								dims,
								span,
								original_error_count,
							)
						None:
							compiler_checked_get_unsupported_result(
								context,
								receiver_result.expr,
								index_result,
								receiver_type,
								span,
							)
			_:
				match compiler_array_type_parts(receiver_type):
					Some((element_type, dims)):
						compiler_checked_get_array_result(
							context,
							receiver_result.expr,
							index_result,
							element_type,
							dims,
							span,
							original_error_count,
						)
					None:
						compiler_checked_get_unsupported_result(
							context,
							receiver_result.expr,
							index_result,
							receiver_type,
							span,
						)


private pure func compiler_nd_checked_get_result(
	name: String,
	result: CompilerInferResult,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	match result.expr:
		CompilerTypedSubscriptExpr(receiver, indices, _, _):
			receiver_type = compiler_typed_expr_semantic_type(receiver)
			result_type = compiler_typed_expr_semantic_type(result.expr)
			params = [receiver_type].concat(indices.map(
				func(_): compiler_type_int(),
			))
			resolved_call = compiler_builtin_resolved_call(name, params, result_type)
			callee = compiler_typed_builtin_callee(name, params, result_type, span, resolved_call)
			typed = CompilerTypedCallExpr(
				callee,
				[receiver].concat(indices),
				span,
				compiler_inferred_call_info(result.context, result_type, Some(resolved_call)),
			)
			compiler_infer_result(result.context, typed)
		_:
			result


private pure func compiler_infer_nd_checked_get_call(
	context: CompilerInferContext,
	name: String,
	index_count: Int,
	args: List[ParsedExpr],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	if args.length() != index_count + 1:
		next = compiler_infer_error(context, "${name} takes ${index_count + 1} arguments")
		missing = CompilerTypedMissingExpr(
			span,
			compiler_inferred_info(next, compiler_type_void()),
		)
		compiler_infer_result(next, missing)
	else:
		receiver = args.get_or(0, ParsedMissingExpr(span))
		parsed_indices: List[ParsedExpr] = compiler_parsed_args_after_first(args)
		compiler_nd_checked_get_result(
			name,
			compiler_infer_subscript_expr(context, receiver, parsed_indices, span),
			span,
		)


private pure func compiler_checked_slice_error(
	context: CompilerInferContext,
	message: String,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	next = compiler_infer_error(context, message)
	compiler_infer_result(
		next,
		CompilerTypedMissingExpr(
			span,
			compiler_inferred_info(next, compiler_type_void()),
		),
	)


private pure func compiler_typed_static_int(expr: CompilerTypedExpr) -> Option[Int]:
	match compiler_typed_expr_semantic_type(expr):
		CompilerConstIntType(value):
			Some(value)
		_:
			None


private pure func compiler_checked_slice_result(
	context: CompilerInferContext,
	receiver: CompilerTypedExpr,
	start: CompilerTypedExpr,
	end: CompilerTypedExpr,
	element_type: CompilerType,
	array_size: Int,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	match (compiler_typed_static_int(start), compiler_typed_static_int(end)):
		(Some(start_value), Some(end_value)):
			if start_value < 0:
				compiler_checked_slice_error(
					context,
					"Slice start ${start_value} is negative",
					span,
				)
			else if end_value > array_size:
				compiler_checked_slice_error(
					context,
					"Slice end ${end_value} out of bounds for Tensor of size ${array_size}",
					span,
				)
			else if start_value >= end_value:
				compiler_checked_slice_error(
					context,
					"Slice start ${start_value} must be less than end ${end_value}",
					span,
				)
			else:
				receiver_type = compiler_typed_expr_semantic_type(receiver)
				result_type = CompilerArrayType(
					compiler_type_copy(element_type),
					[CompilerConstIntType(end_value - start_value)],
				)
				params = [receiver_type, compiler_type_int(), compiler_type_int()]
				resolved_call = compiler_builtin_resolved_call("checked_slice", params, result_type)
				callee = compiler_typed_builtin_callee(
					"checked_slice",
					params,
					result_type,
					span,
					resolved_call,
				)
				typed = CompilerTypedCallExpr(
					callee,
					[receiver, start, end],
					span,
					compiler_inferred_call_info(
						context,
						result_type,
						Some(resolved_call),
					),
				)
				compiler_infer_result(context, typed)
		_:
			compiler_checked_slice_error(
				context,
				"checked_slice requires compile-time integer literal start and end",
				span,
			)


private pure func compiler_infer_checked_slice_call(
	context: CompilerInferContext,
	args: List[ParsedExpr],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	if args.length() != 3:
		compiler_checked_slice_error(
			context,
			"checked_slice takes exactly 3 arguments: (tensor, start: Int, end: Int)",
			span,
		)
	else:
		receiver_result = compiler_infer_expr(
			compiler_infer_without_expected(context),
			args.get_or(0, ParsedMissingExpr(span)),
		)
		start_result = compiler_infer_expr(
			compiler_infer_with_expected_value_slot(
				receiver_result.context,
				compiler_type_int(),
				CompilerExpectedArgumentSlot,
			),
			args.get_or(1, ParsedMissingExpr(span)),
		)
		end_result = compiler_infer_expr(
			compiler_infer_with_expected_value_slot(
				start_result.context,
				compiler_type_int(),
				CompilerExpectedArgumentSlot,
			),
			args.get_or(2, ParsedMissingExpr(span)),
		)
		receiver_type = compiler_typed_expr_semantic_type(receiver_result.expr)

		match compiler_array_type_parts(receiver_type):
			Some((element_type, dims)):
				if dims.length() != 1:
					compiler_checked_slice_error(
						end_result.context,
						"checked_slice is only supported on 1D arrays",
						span,
					)
				else:
					match dims.get(0):
						Some(CompilerConstIntType(array_size)):
							compiler_checked_slice_result(
								end_result.context,
								receiver_result.expr,
								start_result.expr,
								end_result.expr,
								element_type,
								array_size,
								span,
							)
						_:
							compiler_checked_slice_error(
								end_result.context,
								"Cannot verify slice bounds: dimension is not known at compile time",
								span,
							)
			None:
				compiler_checked_slice_error(
					end_result.context,
					"checked_slice requires a 1D array, got " + compiler_type_to_string(
						receiver_type,
					),
					span,
				)


private pure func compiler_infer_special_builtin_call_expr(
	context: CompilerInferContext,
	callee: ParsedExpr,
	args: List[ParsedExpr],
	span: CompilerSourceSpan,
) -> Option[CompilerInferResult]:
	match callee:
		ParsedNameExpr(name):
			match compiler_builtin_special_inference(name.text):
				Some(CompilerCheckedGetInference):
					Some(compiler_infer_checked_get_call(context, args, span))
				Some(CompilerCheckedSliceInference):
					Some(compiler_infer_checked_slice_call(context, args, span))
				Some(CompilerMatrixCheckedGetInference):
					Some(compiler_infer_nd_checked_get_call(context, name.text, 2, args, span))
				Some(CompilerTensorCheckedGetInference(rank)):
					Some(compiler_infer_nd_checked_get_call(context, name.text, rank, args, span))
				_:
					None
		_:
			None


private pure func compiler_subscript_assignment_root(target: ParsedExpr) -> Option[String]:
	match target:
		ParsedNameExpr(name):
			Some(name.text)
		ParsedFieldAccessExpr(receiver, _, _):
			compiler_subscript_assignment_root(receiver)
		_:
			None


private record CompilerSubscriptAssignmentMutabilityResult {
	context: CompilerInferContext,
	assign_target: Option[CompilerTypedAssignTarget]
}


private pure func compiler_typed_assign_target(
	name: String,
	scope: CompilerTypedAssignScope,
) -> CompilerTypedAssignTarget:
	{
		name = name.substring(0, name.length()),
		scope = scope
	}


private pure func compiler_subscript_assignment_mutability_result(
	context: CompilerInferContext,
	assign_target: Option[CompilerTypedAssignTarget],
) -> CompilerSubscriptAssignmentMutabilityResult:
	target_copy: Option[CompilerTypedAssignTarget] = match assign_target:
		Some(target):
			Some({
				name = target.name.substring(0, target.name.length()),
				scope = target.scope,
			})
		None:
			None

	{
		context = compiler_infer_context_copy(context),
		assign_target = target_copy
	}


private pure func compiler_subscript_assignment_mutability(
	context: CompilerInferContext,
	target: ParsedExpr,
) -> CompilerSubscriptAssignmentMutabilityResult:
	match compiler_subscript_assignment_root(target):
		Some(name):
			match compiler_env_lookup_with_scope_depth(context.state.env, name):
				Some(lookup):
					match lookup.symbol.kind:
						CompilerVarSymbolKind(var_symbol):
							if compiler_var_mutability_is_mutable(var_symbol.mutability):
								compiler_subscript_assignment_mutability_result(
									context,
									Some(
										compiler_typed_assign_target(
											name,
											compiler_assign_scope_from_lookup(context, lookup),
										),
									),
								)
							else:
								compiler_subscript_assignment_mutability_result(
									compiler_infer_error(
										context,
										"Cannot assign to subscript of immutable variable '" + name + "'",
									),
									None,
								)
						_:
							compiler_subscript_assignment_mutability_result(context, None)
				None:
					compiler_subscript_assignment_mutability_result(context, None)
		None:
			compiler_subscript_assignment_mutability_result(context, None)


private pure func compiler_subscript_assignment_arity_error(
	context: CompilerInferContext,
	index_count: Int,
	dim_count: Int,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Subscript assignment has " + index_count.to_string() + " indices but tensor has " + dim_count.to_string() + " dimensions",
	)


private pure func compiler_validate_array_subscript_assignment(
	context: CompilerInferContext,
	target: CompilerTypedExpr,
	dims: List[CompilerType],
	indices: List[CompilerTypedExpr],
	values: List[Int],
	static_flags: List[Bool],
	index_count: Int,
) -> CompilerValidatedSubscriptIndices:
	if index_count != dims.length():
		compiler_validated_subscript_indices(
			compiler_subscript_assignment_arity_error(context, index_count, dims.length()),
			indices,
		)
	else:
		compiler_validate_array_subscript_indices(
			context,
			target,
			dims,
			indices,
			values,
			static_flags,
		)


private pure func compiler_subscript_assignment_value_mismatch_error(
	context: CompilerInferContext,
	expected: CompilerType,
	got: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Cannot assign " + compiler_type_to_string(
			got,
		) + " to tensor element of type " + compiler_type_to_string(expected),
	)


private pure func compiler_subscript_assignment_target_error(
	context: CompilerInferContext,
	target_type: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Type " + compiler_type_to_string(target_type) + ((
			" does not support subscript assignment. Subscript assignment is supported on "
			+ "array types"
		)),
	)


private pure func compiler_infer_subscript_assign_result(
	context: CompilerInferContext,
	next_context: CompilerInferContext,
	assign_target: Option[CompilerTypedAssignTarget],
	target: CompilerTypedExpr,
	indices: List[CompilerTypedExpr],
	value: CompilerTypedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	result_context = compiler_infer_context_with_state(context, next_context.state)
	typed = CompilerTypedSubscriptAssignExpr(
		assign_target,
		target,
		indices,
		value,
		span,
		compiler_inferred_info(result_context, compiler_type_void()),
	)
	compiler_infer_result(result_context, typed)


private pure func compiler_checked_set_callee_name(index_count: Int) -> String:
	match index_count:
		2:
			"matrix_checked_set"
		3:
			"tensor3_checked_set"
		4:
			"tensor4_checked_set"
		5:
			"tensor5_checked_set"
		_:
			"checked_set"


private pure func compiler_checked_set_call(
	context: CompilerInferContext,
	target: CompilerTypedExpr,
	indices: List[CompilerTypedExpr],
	value: CompilerTypedExpr,
	target_type: CompilerType,
	element_type: CompilerType,
	span: CompilerSourceSpan,
) -> CompilerTypedExpr:
	callee_name = compiler_checked_set_callee_name(indices.length())
	params = [compiler_type_copy(target_type)]
		.concat(indices.map(
			func(_): compiler_type_int(),
		))
		.append(compiler_type_copy(element_type))
	resolved_call = compiler_builtin_resolved_call(callee_name, params, target_type)
	callee = compiler_typed_builtin_callee(callee_name, params, target_type, span, resolved_call)

	CompilerTypedCallExpr(
		callee,
		[target]
			.concat(indices)
			.append(value),
		span,
		compiler_inferred_call_info(
			context,
			target_type,
			Some(resolved_call),
		),
	)


private pure func compiler_infer_array_subscript_assign_result(
	context: CompilerInferContext,
	next_context: CompilerInferContext,
	assign_target: Option[CompilerTypedAssignTarget],
	target: CompilerTypedExpr,
	indices: List[CompilerTypedExpr],
	value: CompilerTypedExpr,
	target_type: CompilerType,
	element_type: CompilerType,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	result_context = compiler_infer_context_with_state(context, next_context.state)
	set_call = compiler_checked_set_call(
		result_context,
		target,
		indices,
		value,
		target_type,
		element_type,
		span,
	)

	match (assign_target, target):
		(Some(destination), CompilerTypedNameExpr(name, _)):
			if destination.name == name.text:
				typed = CompilerTypedAssignExpr(
					name,
					destination.scope,
					set_call,
					span,
					compiler_inferred_info(result_context, compiler_type_void()),
				)
				compiler_infer_result(result_context, typed)
			else:
				compiler_infer_subscript_assign_result(
					context,
					next_context,
					assign_target,
					target,
					indices,
					value,
					span,
				)
		_:
			compiler_infer_subscript_assign_result(
				context,
				next_context,
				assign_target,
				target,
				indices,
				value,
				span,
			)


private pure func compiler_infer_subscript_assignment_value(
	context: CompilerInferContext,
	expected_type: Option[CompilerType],
	value: ParsedExpr,
) -> CompilerInferResult:
	match expected_type:
		Some(typ):
			compiler_infer_expr(
				compiler_infer_with_expected_value_slot(context, typ, CompilerExpectedArgumentSlot),
				value,
			)
		None:
			compiler_infer_expr(compiler_infer_without_expected(context), value)


private pure func compiler_infer_array_subscript_assign_expr(
	context: CompilerInferContext,
	target_result: CompilerInferResult,
	index_result: CompilerInferSubscriptIndicesResult,
	assign_target: Option[CompilerTypedAssignTarget],
	value: ParsedExpr,
	element_type: CompilerType,
	dims: List[CompilerType],
	index_count: Int,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	validated = compiler_validate_array_subscript_assignment(
		index_result.context,
		target_result.expr,
		dims,
		index_result.indices,
		index_result.values,
		index_result.static_flags,
		index_count,
	)
	value_result = compiler_infer_subscript_assignment_value(
		validated.context,
		Some(element_type),
		value,
	)
	value_type = compiler_typed_expr_value_type(value_result.expr)

	next_context = if compiler_types_equal(value_type, element_type):
		compiler_infer_context_copy(value_result.context)
	else:
		compiler_subscript_assignment_value_mismatch_error(
			value_result.context,
			element_type,
			value_type,
		)

	compiler_infer_array_subscript_assign_result(
		context,
		next_context,
		assign_target,
		target_result.expr,
		validated.indices,
		value_result.expr,
		compiler_typed_expr_semantic_type(target_result.expr),
		element_type,
		span,
	)


private pure func compiler_infer_invalid_subscript_assign_expr(
	context: CompilerInferContext,
	target_result: CompilerInferResult,
	index_result: CompilerInferSubscriptIndicesResult,
	assign_target: Option[CompilerTypedAssignTarget],
	value: ParsedExpr,
	target_type: CompilerType,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	target_context = compiler_subscript_assignment_target_error(index_result.context, target_type)
	value_result = compiler_infer_subscript_assignment_value(target_context, None, value)
	compiler_infer_subscript_assign_result(
		context,
		value_result.context,
		assign_target,
		target_result.expr,
		index_result.indices,
		value_result.expr,
		span,
	)


private pure func compiler_infer_subscript_assign_expr(
	context: CompilerInferContext,
	target: ParsedExpr,
	indices: List[ParsedExpr],
	value: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	mutability = compiler_subscript_assignment_mutability(context, target)
	target_result = compiler_infer_expr(compiler_infer_without_expected(mutability.context), target)
	index_result = compiler_infer_subscript_indices(target_result.context, indices)
	target_type = compiler_typed_expr_semantic_type(target_result.expr)
	index_count = indices.length()

	match compiler_array_type_parts(target_type):
		Some((element_type, dims)):
			compiler_infer_array_subscript_assign_expr(
				context,
				target_result,
				index_result,
				mutability.assign_target,
				value,
				element_type,
				dims,
				index_count,
				span,
			)
		None:
			compiler_infer_invalid_subscript_assign_expr(
				context,
				target_result,
				index_result,
				mutability.assign_target,
				value,
				target_type,
				span,
			)


private pure func compiler_range_endpoint_error(
	context: CompilerInferContext,
	label: String,
	typ: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Range " + label + " must be Int, got " + compiler_type_to_string(typ),
	)


private pure func compiler_range_endpoint_type_is_int_like(typ: CompilerType) -> Bool:
	compiler_named_value_type_is(typ, "Int") or compiler_is_dim_type(typ)


private pure func compiler_infer_range_expr(
	context: CompilerInferContext,
	start_expr: ParsedExpr,
	end_expr: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	start_result = compiler_infer_expr(
		compiler_infer_with_expected_value_slot(
			context,
			compiler_type_int(),
			CompilerExpectedArgumentSlot,
		),
		start_expr,
	)
	start_type = compiler_typed_expr_value_type(start_result.expr)

	start_context = if compiler_range_endpoint_type_is_int_like(start_type):
		compiler_infer_context_copy(start_result.context)
	else:
		compiler_range_endpoint_error(start_result.context, "start", start_type)

	end_result = compiler_infer_expr(
		compiler_infer_with_expected_value_slot(
			start_context,
			compiler_type_int(),
			CompilerExpectedArgumentSlot,
		),
		end_expr,
	)
	end_type = compiler_typed_expr_value_type(end_result.expr)

	result_context = if compiler_range_endpoint_type_is_int_like(end_type):
		compiler_infer_context_with_state(context, end_result.context.state)
	else:
		compiler_infer_context_with_state(
			context,
			compiler_range_endpoint_error(end_result.context, "end", end_type).state,
		)

	typed = CompilerTypedRangeExpr(
		start_result.expr,
		end_result.expr,
		span,
		compiler_inferred_info(result_context, compiler_type_range()),
	)

	compiler_infer_result(result_context, typed)


private pure func compiler_pattern_type_error(
	context: CompilerInferContext,
	pattern_label: String,
	expected: CompilerType,
	got: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		pattern_label + " pattern requires " + compiler_type_to_string(
			expected,
		) + " scrutinee, got " + compiler_type_to_string(got),
	)


private pure func compiler_int_pattern_scrutinee_type(typ: CompilerType) -> Bool:
	match typ:
		CompilerConstIntType(_):
			True
		_:
			compiler_is_any_integer_type(typ) or compiler_named_value_type_is(typ, "Int")


private pure func compiler_infer_pattern_result(
	context: CompilerInferContext,
	env: CompilerEnv,
	pattern: CompilerTypedPattern,
	catch_all: Bool,
	matches_true: Bool,
	matches_false: Bool,
) -> CompilerInferPatternResult:
	{
		context = compiler_infer_context_copy(context),
		env = env,
		pattern = pattern,
		catch_all = catch_all,
		matches_true = matches_true,
		matches_false = matches_false
	}


private pure func compiler_add_match_binding(
	env: CompilerEnv,
	name: ParsedIdentifier,
	typ: CompilerType,
) -> CompilerEnv:
	compiler_env_add_var_with_details(
		env,
		name.text,
		compiler_type_copy(typ),
		Some(compiler_type_copy(typ)),
		CompilerImmutableBinding,
		CompilerMatchBinding,
		compiler_unrefined_binding(),
	)


private pure func compiler_tuple_pattern_element_types(
	scrutinee_type: CompilerType,
) -> Option[List[CompilerType]]:
	match scrutinee_type:
		CompilerTupleType(elements):
			Some(elements.map(compiler_type_copy))
		CompilerNamedType(name, args):
			if name == "Tuple":
				Some(args.map(compiler_type_copy))
			else:
				None
		_:
			None


private pure func compiler_list_pattern_element_type(
	scrutinee_type: CompilerType,
) -> Option[CompilerType]:
	match scrutinee_type:
		CompilerNamedType(name, args):
			if name == "List":
				match args.get(0):
					Some(element):
						Some(compiler_type_copy(element))
					None:
						Some(CompilerTypeVar("_list_elem"))
			else:
				None
		_:
			None


private pure func compiler_infer_pattern_items_result(
	context: CompilerInferContext,
	env: CompilerEnv,
	patterns: List[CompilerTypedPattern],
) -> CompilerInferPatternItemsResult:
	{
		context = compiler_infer_context_copy(context),
		env = env,
		patterns = patterns
	}


private pure func compiler_infer_pattern_items(
	context: CompilerInferContext,
	env: CompilerEnv,
	patterns: List[ParsedPattern],
	item_types: List[CompilerType],
) -> CompilerInferPatternItemsResult:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var next_env: CompilerEnv = env
	var typed_patterns: List[CompilerTypedPattern] = []
	var index: Int = 0

	while index < patterns.length():
		match (patterns.get(index), item_types.get(index)):
			(Some(pattern), Some(item_type)):
				item_result = compiler_infer_pattern(next_context, next_env, pattern, item_type)
				next_context = item_result.context
				next_env = item_result.env
				typed_patterns = typed_patterns.append(item_result.pattern)
			_:
				void

		index += 1

	compiler_infer_pattern_items_result(next_context, next_env, typed_patterns)


private pure func compiler_infer_repeated_pattern_items(
	context: CompilerInferContext,
	env: CompilerEnv,
	patterns: List[ParsedPattern],
	item_type: CompilerType,
) -> CompilerInferPatternItemsResult:
	var item_types: List[CompilerType] = []

	for _pattern in patterns:
		item_types = item_types.append(compiler_type_copy(item_type))

	compiler_infer_pattern_items(context, env, patterns, item_types)


private pure func compiler_bind_list_pattern_spread(
	env: CompilerEnv,
	spread: Option[ParsedListPatternSpread],
	scrutinee_type: CompilerType,
) -> CompilerEnv:
	match spread:
		Some(ParsedListSpreadName(name)):
			compiler_add_match_binding(env, name, scrutinee_type)
		Some(ParsedListSpreadWildcard(_)):
			env
		None:
			env


private pure func compiler_pattern_bound_names_equal(
	env: CompilerEnv,
	left: ParsedPattern,
	right: ParsedPattern,
) -> Bool:
	compiler_string_lists_equal(
		compiler_pattern_bound_names(env, left).sort(),
		compiler_pattern_bound_names(env, right).sort(),
	)


private pure func compiler_or_pattern_bindings_error(
	context: CompilerInferContext,
) -> CompilerInferContext:
	compiler_infer_error(context, "Or-pattern alternatives must bind the same variables")


private pure func compiler_constructor_subst_for_scrutinee(
	type_params: List[String],
	scrutinee_type: CompilerType,
) -> List[CompilerTypeSubstEntry]:
	match scrutinee_type:
		CompilerNamedType(_, args):
			var result: List[CompilerTypeSubstEntry] = []
			var index: Int = 0

			while index < type_params.length() and index < args.length():
				match (type_params.get(index), args.get(index)):
					(Some(name), Some(arg)):
						result = result.append(compiler_type_subst_entry(name, arg))
					_:
						void

				index += 1

			result
		_:
			[]


private pure func compiler_constructor_field_types_for_scrutinee(
	field_types: List[CompilerType],
	type_params: List[String],
	scrutinee_type: CompilerType,
) -> List[CompilerType]:
	subst = compiler_constructor_subst_for_scrutinee(type_params, scrutinee_type)
	field_types.map(func(field_type): compiler_apply_subst(subst, field_type))


private pure func compiler_constructor_pattern_parent_error(
	context: CompilerInferContext,
	constructor_name: String,
	parent_type: String,
	scrutinee_type: CompilerType,
) -> CompilerInferContext:
	match scrutinee_type:
		CompilerNamedType(type_name, _):
			compiler_infer_error(
				context,
				"Constructor " + constructor_name + " belongs to type " + parent_type + ", not " + type_name,
			)
		_:
			compiler_infer_error(
				context,
				"Constructor " + constructor_name + " cannot match scrutinee of type " + compiler_type_to_string(
					scrutinee_type,
				),
			)


private pure func compiler_infer_known_constructor_pattern(
	context: CompilerInferContext,
	env: CompilerEnv,
	constructor_name: ParsedIdentifier,
	constructor_label: String,
	parent_type: String,
	type_params: List[String],
	field_types: List[CompilerType],
	fields: List[ParsedPattern],
	span: CompilerSourceSpan,
	scrutinee_type: CompilerType,
) -> CompilerInferPatternResult:
	parent_context = match scrutinee_type:
		CompilerNamedType(type_name, _):
			if type_name == parent_type:
				compiler_infer_context_copy(context)
			else:
				compiler_constructor_pattern_parent_error(
					context,
					constructor_label,
					parent_type,
					scrutinee_type,
				)
		_:
			compiler_constructor_pattern_parent_error(
				context,
				constructor_label,
				parent_type,
				scrutinee_type,
			)

	if fields.length() != field_types.length():
		compiler_infer_pattern_result(
			compiler_infer_error(
				parent_context,
				"Constructor " + constructor_label + " expects " + field_types
					.length()
					.to_string() + " field(s), but pattern has " + fields
					.length()
					.to_string(),
			),
			env,
			CompilerTypedConstructorPattern(constructor_name, [], span),
			False,
			False,
			False,
		)
	else:
		concrete_fields = compiler_constructor_field_types_for_scrutinee(
			field_types,
			type_params,
			scrutinee_type,
		)
		items_result = compiler_infer_pattern_items(parent_context, env, fields, concrete_fields)
		compiler_infer_pattern_result(
			items_result.context,
			items_result.env,
			CompilerTypedConstructorPattern(constructor_name, items_result.patterns, span),
			False,
			False,
			False,
		)


private pure func compiler_infer_constructor_pattern(
	context: CompilerInferContext,
	env: CompilerEnv,
	constructor_name: ParsedIdentifier,
	fields: List[ParsedPattern],
	span: CompilerSourceSpan,
	scrutinee_type: CompilerType,
) -> CompilerInferPatternResult:
	match compiler_env_get_constructor(env, constructor_name.text):
		Some(ctor):
			compiler_infer_known_constructor_pattern(
				context,
				env,
				constructor_name,
				constructor_name.text,
				ctor.parent_type,
				ctor.type_params,
				ctor.field_types,
				fields,
				span,
				scrutinee_type,
			)
		None:
			compiler_infer_pattern_result(
				compiler_infer_error(
					context,
					"Unknown constructor pattern `" + constructor_name.text + "`",
				),
				env,
				CompilerTypedConstructorPattern(constructor_name, [], span),
				False,
				False,
				False,
			)


private pure func compiler_qualified_constructor_pattern_result(
	base: CompilerInferPatternResult,
	module_name: ParsedIdentifier,
	name: ParsedIdentifier,
	span: CompilerSourceSpan,
) -> CompilerInferPatternResult:
	typed_fields: List[CompilerTypedPattern] = match base.pattern:
		CompilerTypedConstructorPattern(_, fields, _):
			fields
		_:
			[]

	compiler_infer_pattern_result(
		base.context,
		base.env,
		CompilerTypedQualifiedConstructorPattern(module_name, name, typed_fields, span),
		base.catch_all,
		base.matches_true,
		base.matches_false,
	)


private pure func compiler_infer_qualified_constructor_pattern(
	context: CompilerInferContext,
	env: CompilerEnv,
	module_name: ParsedIdentifier,
	name: ParsedIdentifier,
	fields: List[ParsedPattern],
	span: CompilerSourceSpan,
	scrutinee_type: CompilerType,
) -> CompilerInferPatternResult:
	match compiler_typecheck_state_find_module_alias(context.state, module_name.text):
		Some(module_path):
			match compiler_find_module_constructor(context, env, module_path, name.text):
				Some(ctor):
					base = compiler_infer_known_constructor_pattern(
						context,
						env,
						name,
						module_name.text + "." + name.text,
						ctor.parent_type,
						ctor.type_params,
						ctor.field_types,
						fields,
						span,
						scrutinee_type,
					)
					compiler_qualified_constructor_pattern_result(base, module_name, name, span)
				None:
					compiler_infer_pattern_result(
						compiler_infer_error(
							context,
							"Module alias `" + module_name.text + "` for module `" + module_path + "` has no constructor `" + name.text + "`",
						),
						env,
						CompilerTypedQualifiedConstructorPattern(module_name, name, [], span),
						False,
						False,
						False,
					)
		None:
			compiler_infer_pattern_result(
				compiler_infer_error(
					context,
					"Unknown module alias `" + module_name.text + "` in constructor pattern",
				),
				env,
				CompilerTypedQualifiedConstructorPattern(module_name, name, [], span),
				False,
				False,
				False,
			)


private pure func compiler_infer_pattern(
	context: CompilerInferContext,
	env: CompilerEnv,
	pattern: ParsedPattern,
	scrutinee_type: CompilerType,
) -> CompilerInferPatternResult:
	match pattern:
		ParsedWildcardPattern(span):
			compiler_infer_pattern_result(
				context,
				env,
				CompilerTypedWildcardPattern(span),
				True,
				False,
				False,
			)
		ParsedNamePattern(name):
			match compiler_env_get_constructor(env, name.text):
				Some(_):
					compiler_infer_constructor_pattern(
						context,
						env,
						name,
						[],
						name.span,
						scrutinee_type,
					)
				None:
					next_env = compiler_add_match_binding(env, name, scrutinee_type)
					compiler_infer_pattern_result(
						context,
						next_env,
						CompilerTypedNamePattern(name, scrutinee_type),
						True,
						False,
						False,
					)
		ParsedBoolPattern(value, span):
			next_context = if compiler_named_value_type_is(scrutinee_type, "Bool"):
				compiler_infer_context_copy(context)
			else:
				compiler_pattern_type_error(context, "Bool", compiler_type_bool(), scrutinee_type)

			compiler_infer_pattern_result(
				next_context,
				env,
				CompilerTypedBoolPattern(value, span),
				False,
				value,
				not value,
			)
		ParsedIntPattern(text, span):
			next_context = if compiler_int_pattern_scrutinee_type(scrutinee_type):
				compiler_infer_context_copy(context)
			else:
				compiler_pattern_type_error(context, "Int", compiler_type_int(), scrutinee_type)

			compiler_infer_pattern_result(
				next_context,
				env,
				CompilerTypedIntPattern(text, span),
				False,
				False,
				False,
			)
		ParsedStringPattern(value, _, span):
			next_context = if compiler_named_value_type_is(scrutinee_type, "String"):
				compiler_infer_context_copy(context)
			else:
				compiler_pattern_type_error(
					context,
					"String",
					compiler_type_string(),
					scrutinee_type,
				)

			compiler_infer_pattern_result(
				next_context,
				env,
				CompilerTypedStringPattern(value, span),
				False,
				False,
				False,
			)
		ParsedCharPattern(value, span):
			next_context = if compiler_named_value_type_is(scrutinee_type, "Char"):
				compiler_infer_context_copy(context)
			else:
				compiler_pattern_type_error(context, "Char", compiler_type_char(), scrutinee_type)

			compiler_infer_pattern_result(
				next_context,
				env,
				CompilerTypedCharPattern(value, span),
				False,
				False,
				False,
			)
		ParsedFloatPattern(text, span):
			next_context = if compiler_is_any_float_type(scrutinee_type):
				compiler_infer_context_copy(context)
			else:
				compiler_pattern_type_error(context, "Float", compiler_type_float(), scrutinee_type)

			compiler_infer_pattern_result(
				next_context,
				env,
				CompilerTypedFloatPattern(text, span),
				False,
				False,
				False,
			)
		ParsedConstructorPattern(name, fields, span):
			compiler_infer_constructor_pattern(context, env, name, fields, span, scrutinee_type)
		ParsedQualifiedConstructorPattern(module_name, name, fields, span):
			compiler_infer_qualified_constructor_pattern(
				context,
				env,
				module_name,
				name,
				fields,
				span,
				scrutinee_type,
			)
		ParsedTuplePattern(items, span):
			match compiler_tuple_pattern_element_types(scrutinee_type):
				Some(elements):
					if items.length() != elements.length():
						compiler_infer_pattern_result(
							compiler_infer_error(context, "Tuple pattern has " + items
									.length()
									.to_string() + " elements, but scrutinee tuple has " + elements
									.length()
									.to_string() + " elements"),
							env,
							CompilerTypedTuplePattern([], span),
							False,
							False,
							False,
						)
					else:
						items_result = compiler_infer_pattern_items(context, env, items, elements)
						compiler_infer_pattern_result(
							items_result.context,
							items_result.env,
							CompilerTypedTuplePattern(items_result.patterns, span),
							False,
							False,
							False,
						)
				None:
					compiler_infer_pattern_result(
						compiler_infer_error(
							context,
							"Tuple pattern cannot match scrutinee of type " + compiler_type_to_string(
								scrutinee_type,
							),
						),
						env,
						CompilerTypedTuplePattern([], span),
						False,
						False,
						False,
					)
		ParsedListPattern(items, spread, span):
			match compiler_list_pattern_element_type(scrutinee_type):
				Some(element_type):
					items_result = compiler_infer_repeated_pattern_items(
						context,
						env,
						items,
						element_type,
					)
					next_env = compiler_bind_list_pattern_spread(
						items_result.env,
						spread,
						scrutinee_type,
					)
					compiler_infer_pattern_result(
						items_result.context,
						next_env,
						CompilerTypedListPattern(items_result.patterns, spread, span),
						False,
						False,
						False,
					)
				None:
					compiler_infer_pattern_result(
						compiler_infer_error(
							context,
							"List pattern cannot match scrutinee of type " + compiler_type_to_string(
								scrutinee_type,
							),
						),
						env,
						CompilerTypedListPattern([], spread, span),
						False,
						False,
						False,
					)
		ParsedOrPattern(options, span):
			match options.get(0):
				Some(first):
					first_result = compiler_infer_pattern(context, env, first, scrutinee_type)
					var next_context: CompilerInferContext = first_result.context
					var typed_options: List[CompilerTypedPattern] = [first_result.pattern]
					var catch_all: Bool = first_result.catch_all
					var matches_true: Bool = first_result.matches_true
					var matches_false: Bool = first_result.matches_false
					var index: Int = 1

					while index < options.length():
						match options.get(index):
							Some(option):
								next_context = if compiler_pattern_bound_names_equal(
									env,
									first,
									option,
								):
									next_context
								else:
									compiler_or_pattern_bindings_error(next_context)

								option_result = compiler_infer_pattern(
									next_context,
									env,
									option,
									scrutinee_type,
								)
								next_context = option_result.context
								typed_options = typed_options.append(option_result.pattern)
								catch_all = catch_all or option_result.catch_all
								matches_true = matches_true or option_result.matches_true
								matches_false = matches_false or option_result.matches_false
							None:
								void

						index += 1

					compiler_infer_pattern_result(
						next_context,
						first_result.env,
						CompilerTypedOrPattern(typed_options, span),
						catch_all,
						matches_true,
						matches_false,
					)
				None:
					compiler_infer_pattern_result(
						compiler_infer_error(
							context,
							"Or pattern must have at least one alternative",
						),
						env,
						CompilerTypedOrPattern([], span),
						False,
						False,
						False,
					)
		ParsedMissingPattern(span):
			compiler_infer_pattern_result(
				compiler_infer_error(context, "Missing match pattern"),
				env,
				CompilerTypedUnsupportedPattern("missing", span),
				False,
				False,
				False,
			)


private pure func compiler_match_type_mismatch_error(
	context: CompilerInferContext,
	expected: CompilerType,
	got: CompilerType,
	span: CompilerSourceSpan,
) -> CompilerInferContext:
	expected_text = compiler_type_to_string(expected)
	got_text = compiler_type_to_string(got)
	location = compiler_source_span_label(span)

	compiler_infer_error(
		context,
		"Match branch type mismatch: expected ${expected_text}, got ${got_text} at ${location}",
	)


private pure func compiler_match_result_type(
	context: CompilerInferContext,
	current_type: Option[CompilerType],
	branch_type: CompilerType,
	branch_span: CompilerSourceSpan,
) -> CompilerMatchResultTypeResult:
	match current_type:
		None:
			{
				context = compiler_infer_context_copy(context),
				result_type = Some(compiler_type_copy(branch_type))
			}
		Some(expected):
			match compiler_common_inferred_type(context, expected, branch_type):
				Some(common):
					{
						context = common.context,
						result_type = Some(common.typ)
					}
				None:
					{
						context = compiler_match_type_mismatch_error(
							context,
							expected,
							branch_type,
							branch_span,
						),
						result_type = Some(expected)
					}


private pure func compiler_infer_match_cases_result(
	context: CompilerInferContext,
	cases: List[CompilerTypedMatchCase],
	result_type: Option[CompilerType],
	catch_all: Bool,
	matches_true: Bool,
	matches_false: Bool,
) -> CompilerInferMatchCasesResult:
	{
		context = compiler_infer_context_copy(context),
		cases = cases,
		result_type = compiler_optional_type_copy(result_type),
		catch_all = catch_all,
		matches_true = matches_true,
		matches_false = matches_false
	}


private pure func compiler_match_body_context(
	context: CompilerInferContext,
) -> CompilerInferContext:
	match context.expected_type:
		Some(expected):
			compiler_infer_with_expected_value_slot(context, expected, CompilerExpectedArgumentSlot)
		None:
			compiler_infer_without_expected(context)


private pure func compiler_infer_match_cases(
	context: CompilerInferContext,
	cases: List[ParsedMatchCase],
	scrutinee_type: CompilerType,
) -> CompilerInferMatchCasesResult:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var typed_cases: List[CompilerTypedMatchCase] = []
	var result_type: Option[CompilerType] = None
	var catch_all: Bool = False
	var matches_true: Bool = False
	var matches_false: Bool = False
	var index: Int = 0

	while index < cases.length():
		match cases.get(index):
			Some(case):
				case_env = compiler_env_push_scope(next_context.state.env)
				pattern_result = compiler_infer_pattern(
					next_context,
					case_env,
					case.pattern,
					scrutinee_type,
				)
				case_state = compiler_typecheck_state_with_env(
					pattern_result.context.state,
					pattern_result.env,
				)
				case_context = compiler_infer_context_with_state(pattern_result.context, case_state)
				body_result = compiler_infer_expr(
					compiler_match_body_context(case_context),
					case.body,
				)
				branch_type = compiler_typed_expr_semantic_type(body_result.expr)
				result_pair = compiler_match_result_type(
					body_result.context,
					result_type,
					branch_type,
					case.span,
				)
				next_context = result_pair.context
				result_type = result_pair.result_type
				outer_env = compiler_env_pop_scope(next_context.state.env)
				outer_state = compiler_typecheck_state_with_env(next_context.state, outer_env)
				next_context = compiler_infer_context_with_state(context, outer_state)
				typed_cases = typed_cases.append({
					pattern = pattern_result.pattern,
					body = body_result.expr,
					span = case.span,
				})
				catch_all = catch_all or pattern_result.catch_all
				matches_true = matches_true or pattern_result.matches_true
				matches_false = matches_false or pattern_result.matches_false
			None:
				void

		index += 1

	compiler_infer_match_cases_result(
		next_context,
		typed_cases,
		result_type,
		catch_all,
		matches_true,
		matches_false,
	)


private pure func compiler_bool_match_exhaustiveness_error(
	context: CompilerInferContext,
	matches_true: Bool,
	matches_false: Bool,
) -> CompilerInferContext:
	if matches_true and matches_false:
		compiler_infer_context_copy(context)
	else:
		missing = if not matches_true and not matches_false:
			"True and False"
		else if not matches_true:
			"True"
		else:
			"False"

		compiler_infer_error(context, "Non-exhaustive match on Bool: missing " + missing)


private pure func compiler_typed_pattern_constructor_names(
	pattern: CompilerTypedPattern,
) -> List[String]:
	match pattern:
		CompilerTypedConstructorPattern(name, _, _):
			[name.text]
		CompilerTypedQualifiedConstructorPattern(_, name, _, _):
			[name.text]
		CompilerTypedOrPattern(options, _):
			var result: List[String] = []

			for option in options:
				for name in compiler_typed_pattern_constructor_names(option):
					if not result.contains(name):
						result = result.append(name)

			result
		_:
			[]


private pure func compiler_match_case_constructor_names(
	cases: List[CompilerTypedMatchCase],
) -> List[String]:
	var result: List[String] = []

	for case in cases:
		for name in compiler_typed_pattern_constructor_names(case.pattern):
			if not result.contains(name):
				result = result.append(name)

	result


private pure func compiler_variant_names(variants: List[CompilerVariantDef]) -> List[String]:
	variants.map(func(variant): variant.name)


private pure func compiler_missing_constructor_names(
	all_names: List[String],
	seen_names: List[String],
) -> List[String]:
	var missing: List[String] = []

	for name in all_names:
		if not seen_names.contains(name):
			missing = missing.append(name)

	missing


private pure func compiler_constructor_match_exhaustiveness_error(
	context: CompilerInferContext,
	scrutinee_type: CompilerType,
	cases: List[CompilerTypedMatchCase],
) -> CompilerInferContext:
	match scrutinee_type:
		CompilerNamedType(type_name, _):
			match compiler_env_get_type_decl(context.state.env, type_name):
				Some((_, variants)):
					missing = compiler_missing_constructor_names(
						compiler_variant_names(variants),
						compiler_match_case_constructor_names(cases),
					)

					if missing.length() == 0:
						compiler_infer_context_copy(context)
					else:
						compiler_infer_error(
							context,
							"Non-exhaustive match on " + type_name + ": missing " + missing.join(
								", ",
							),
						)
				None:
					compiler_infer_context_copy(context)
		_:
			compiler_infer_context_copy(context)


private pure func compiler_typed_pattern_is_catch_all(pattern: CompilerTypedPattern) -> Bool:
	match pattern:
		CompilerTypedWildcardPattern(_):
			True
		CompilerTypedNamePattern(_, _):
			True
		CompilerTypedOrPattern(options, _):
			var found: Bool = False

			for option in options:
				if compiler_typed_pattern_is_catch_all(option):
					found = True
					break

			found
		_:
			False


private pure func compiler_typed_patterns_all_catch_all(
	patterns: List[CompilerTypedPattern],
) -> Bool:
	var all_catch_all: Bool = True

	for pattern in patterns:
		if not compiler_typed_pattern_is_catch_all(pattern):
			all_catch_all = False
			break

	all_catch_all


private pure func compiler_typed_pattern_list_coverages(
	pattern: CompilerTypedPattern,
) -> List[CompilerListPatternCoverage]:
	match pattern:
		CompilerTypedListPattern(items, spread, _):
			if compiler_typed_patterns_all_catch_all(items):
				[
					{
						fixed_length = items.length(),
						has_spread = spread.is_some()
					},
				]
			else:
				[]
		CompilerTypedOrPattern(options, _):
			var result: List[CompilerListPatternCoverage] = []

			for option in options:
				result = result.concat(compiler_typed_pattern_list_coverages(option))

			result
		_:
			[]


private pure func compiler_match_case_list_coverages(
	cases: List[CompilerTypedMatchCase],
) -> List[CompilerListPatternCoverage]:
	var result: List[CompilerListPatternCoverage] = []

	for case in cases:
		result = result.concat(compiler_typed_pattern_list_coverages(case.pattern))

	result


private pure func compiler_min_int(left: Int, right: Int) -> Int:
	if left < right:
		left
	else:
		right


private pure func compiler_min_spread_list_coverage(
	coverages: List[CompilerListPatternCoverage],
) -> Option[Int]:
	var result: Option[Int] = None

	for coverage in coverages:
		if coverage.has_spread:
			result = match result:
				Some(current):
					Some(compiler_min_int(current, coverage.fixed_length))
				None:
					Some(coverage.fixed_length)

	result


private pure func compiler_exact_list_length_covered(
	coverages: List[CompilerListPatternCoverage],
	length: Int,
) -> Bool:
	var covered: Bool = False

	for coverage in coverages:
		if not coverage.has_spread and coverage.fixed_length == length:
			covered = True
			break

	covered


private pure func compiler_missing_list_lengths(
	coverages: List[CompilerListPatternCoverage],
	max_exclusive: Int,
) -> List[Int]:
	var missing: List[Int] = []
	var length: Int = 0

	while length < max_exclusive:
		if not compiler_exact_list_length_covered(coverages, length):
			missing = missing.append(length)

		length += 1

	missing


private pure func compiler_list_length_label(length: Int) -> String:
	if length == 0:
		"[]"
	else:
		"length " + length.to_string()


private pure func compiler_check_list_match_exhaustiveness(
	context: CompilerInferContext,
	cases: List[CompilerTypedMatchCase],
) -> CompilerInferContext:
	coverages = compiler_match_case_list_coverages(cases)

	match compiler_min_spread_list_coverage(coverages):
		Some(min_spread):
			missing = compiler_missing_list_lengths(coverages, min_spread)

			if missing.length() == 0:
				compiler_infer_context_copy(context)
			else:
				compiler_infer_error(context, "Non-exhaustive match on List: missing " + missing
						.map(compiler_list_length_label)
						.join(", "))
		None:
			compiler_infer_error(
				context,
				(
					"Non-exhaustive match on List: add a catch-all spread pattern (e.g., [x, ..."
					+ "rest]) or wildcard (_)"
				),
			)


private pure func compiler_check_match_exhaustiveness(
	context: CompilerInferContext,
	scrutinee_type: CompilerType,
	cases: List[CompilerTypedMatchCase],
	catch_all: Bool,
	matches_true: Bool,
	matches_false: Bool,
) -> CompilerInferContext:
	if catch_all:
		compiler_infer_context_copy(context)
	else if compiler_named_value_type_is(scrutinee_type, "Bool"):
		compiler_bool_match_exhaustiveness_error(context, matches_true, matches_false)
	else:
		match compiler_open_exhaustiveness_scalar_name(scrutinee_type):
			Some(type_name):
				compiler_infer_error(
					context,
					"Non-exhaustive match on " + type_name + ": add a wildcard (_) or default pattern to handle all values",
				)
			None:
				if compiler_named_type_head_is(scrutinee_type, "List"):
					compiler_check_list_match_exhaustiveness(context, cases)
				else:
					compiler_constructor_match_exhaustiveness_error(context, scrutinee_type, cases)


private pure func compiler_infer_match_expr(
	context: CompilerInferContext,
	scrutinee: ParsedExpr,
	cases: List[ParsedMatchCase],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	scrutinee_result = compiler_infer_expr(compiler_infer_without_expected(context), scrutinee)
	scrutinee_type = compiler_typed_expr_semantic_type(scrutinee_result.expr)

	if cases.length() == 0:
		next = compiler_infer_error(
			scrutinee_result.context,
			"match expression must have at least one case",
		)
		typed = CompilerTypedMatchExpr(
			scrutinee_result.expr,
			[],
			span,
			compiler_inferred_info(next, compiler_type_void()),
		)
		compiler_infer_result(next, typed)
	else:
		cases_context = compiler_infer_context_with_state(context, scrutinee_result.context.state)
		cases_result = compiler_infer_match_cases(cases_context, cases, scrutinee_type)
		exhaustive_context = compiler_check_match_exhaustiveness(
			cases_result.context,
			scrutinee_type,
			cases_result.cases,
			cases_result.catch_all,
			cases_result.matches_true,
			cases_result.matches_false,
		)

		result_type = match cases_result.result_type:
			Some(typ):
				compiler_type_copy(typ)
			None:
				compiler_type_void()

		result_context = compiler_infer_context_with_state(context, exhaustive_context.state)
		typed = CompilerTypedMatchExpr(
			scrutinee_result.expr,
			cases_result.cases,
			span,
			compiler_inferred_info(result_context, result_type),
		)
		compiler_infer_result(result_context, typed)


private pure func compiler_condition_error(
	context: CompilerInferContext,
	kind: String,
	condition_type: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		kind + " condition must be Bool, got " + compiler_type_to_string(condition_type),
	)


private pure func compiler_if_without_else_error(
	context: CompilerInferContext,
	then_type: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"if-expression without else cannot produce a value; then-branch returns " + compiler_type_to_string(
			then_type,
		),
	)


private pure func compiler_if_type_mismatch_error(
	context: CompilerInferContext,
	then_type: CompilerType,
	else_type: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"If-else type mismatch: then-branch returns " + compiler_type_to_string(
			then_type,
		) + ", else-branch returns " + compiler_type_to_string(else_type),
	)


private pure func compiler_condition_is_zero(expr: ParsedExpr) -> Bool:
	match expr:
		ParsedIntLiteralExpr(text, _):
			compiler_parse_int_literal(text) == 0
		_:
			False


private pure func compiler_condition_name(expr: ParsedExpr) -> Option[String]:
	match expr:
		ParsedNameExpr(name):
			Some(name.text)
		_:
			None


private pure func compiler_condition_nonnegative_name(expr: ParsedExpr) -> Option[String]:
	match expr:
		ParsedBinaryExpr(op, left, right, _):
			match op:
				ParsedGreaterEqualOp:
					if compiler_condition_is_zero(right):
						compiler_condition_name(left)
					else:
						None
				ParsedLessEqualOp:
					if compiler_condition_is_zero(left):
						compiler_condition_name(right)
					else:
						None
				_:
					None
		_:
			None


private pure func compiler_condition_length_collection_name(expr: ParsedExpr) -> Option[String]:
	match expr:
		ParsedCallExpr(callee, args, _):
			match callee:
				ParsedNameExpr(callee_name):
					if callee_name.text == "length" and args.length() == 1:
						match args.get(0):
							Some(ParsedNameExpr(collection_name)):
								Some(collection_name.text)
							_:
								None
					else:
						None
				_:
					None
		_:
			None


private pure func compiler_condition_length_bound(expr: ParsedExpr) -> Option[(String, String)]:
	match expr:
		ParsedBinaryExpr(ParsedLessOp, left, right, _):
			match compiler_condition_name(left):
				Some(index_name):
					match compiler_condition_length_collection_name(right):
						Some(collection_name):
							Some((index_name, collection_name))
						None:
							None
				None:
					None
		_:
			None


private pure func compiler_if_range_refinement_from_parts(
	context: CompilerInferContext,
	lower: ParsedExpr,
	upper: ParsedExpr,
) -> Option[(String, CompilerType)]:
	match compiler_condition_nonnegative_name(lower):
		Some(lower_name):
			match compiler_condition_length_bound(upper):
				Some((upper_name, collection_name)):
					if lower_name != upper_name:
						None
					else:
						if compiler_env_var_is_immutable(context.state.env, lower_name):
							match compiler_env_get_var_type(context.state.env, collection_name):
								Some(collection_type):
									match compiler_array_type_parts(collection_type):
										Some((_, dims)):
											dims
												.get(0)
												.map(
													func(
														dim,
													): (lower_name, compiler_type_copy(dim)),
												)
										None:
											None
								None:
									None
						else:
							None
				None:
					None
		None:
			None


private pure func compiler_if_range_refinement(
	context: CompilerInferContext,
	condition: ParsedExpr,
) -> Option[(String, CompilerType)]:
	match condition:
		ParsedLogicalExpr(ParsedAndOp, left, right, _):
			match compiler_if_range_refinement_from_parts(context, left, right):
				Some(refinement):
					Some(refinement)
				None:
					compiler_if_range_refinement_from_parts(context, right, left)
		_:
			None


private pure func compiler_if_refined_then_context(
	context: CompilerInferContext,
	refinement: Option[(String, CompilerType)],
) -> CompilerInferContext:
	match refinement:
		Some((name, bound)):
			refined_type = CompilerRangeType(bound)
			refined_env = compiler_env_add_var_with_details(
				compiler_env_push_scope(context.state.env),
				name,
				refined_type,
				Some(compiler_type_int()),
				CompilerImmutableBinding,
				CompilerLetBinding,
				compiler_unrefined_binding(),
			)
			refined_state = compiler_typecheck_state_with_env(context.state, refined_env)
			compiler_infer_context_with_state(context, refined_state)
		None:
			compiler_infer_context_copy(context)


private pure func compiler_if_unscoped_then_context(
	context: CompilerInferContext,
	refinement: Option[(String, CompilerType)],
) -> CompilerInferContext:
	match refinement:
		Some(_):
			outer_env = compiler_env_pop_scope(context.state.env)
			outer_state = compiler_typecheck_state_with_env(context.state, outer_env)
			compiler_infer_context_with_state(context, outer_state)
		None:
			compiler_infer_context_copy(context)


private pure func compiler_infer_if_expr(
	context: CompilerInferContext,
	condition: ParsedExpr,
	then_branch: ParsedExpr,
	else_branch: Option[ParsedExpr],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	condition_result = compiler_infer_expr(compiler_infer_without_expected(context), condition)
	condition_type = compiler_typed_expr_semantic_type(condition_result.expr)

	condition_context = if compiler_named_value_type_is(condition_type, "Bool"):
		compiler_infer_context_copy(condition_result.context)
	else:
		compiler_condition_error(condition_result.context, "If", condition_type)

	branch_context = match else_branch:
		Some(_):
			compiler_infer_context_with_state(context, condition_context.state)
		None:
			compiler_infer_without_expected(
				compiler_infer_context_with_state(
					context,
					condition_context.state,
				),
			)

	refinement = compiler_if_range_refinement(condition_context, condition)
	refined_branch_context = compiler_if_refined_then_context(branch_context, refinement)
	raw_then_result = compiler_infer_expr(refined_branch_context, then_branch)
	then_result = compiler_infer_result(
		compiler_if_unscoped_then_context(raw_then_result.context, refinement),
		raw_then_result.expr,
	)
	then_type = compiler_typed_expr_semantic_type(then_result.expr)

	match else_branch:
		None:
			next_context = if compiler_types_equal(then_type, compiler_type_void()):
				compiler_infer_context_copy(then_result.context)
			else:
				compiler_if_without_else_error(then_result.context, then_type)

			typed = CompilerTypedIfExpr(
				condition_result.expr,
				then_result.expr,
				None,
				span,
				compiler_inferred_info(next_context, compiler_type_void()),
			)
			compiler_infer_result(next_context, typed)
		Some(else_expr):
			else_result = compiler_infer_expr(
				compiler_infer_context_with_state(context, then_result.context.state),
				else_expr,
			)
			else_type = compiler_typed_expr_semantic_type(else_result.expr)

			match compiler_common_inferred_type(else_result.context, then_type, else_type):
				Some(common):
					result_context = compiler_infer_context_with_state(
						context,
						common.context.state,
					)
					typed = CompilerTypedIfExpr(
						condition_result.expr,
						then_result.expr,
						Some(else_result.expr),
						span,
						compiler_inferred_info(result_context, common.typ),
					)
					compiler_infer_result(result_context, typed)
				None:
					next_context = compiler_if_type_mismatch_error(
						else_result.context,
						then_type,
						else_type,
					)
					typed = CompilerTypedIfExpr(
						condition_result.expr,
						then_result.expr,
						Some(else_result.expr),
						span,
						compiler_inferred_info(next_context, compiler_type_void()),
					)
					compiler_infer_result(next_context, typed)


private pure func compiler_infer_while_expr(
	context: CompilerInferContext,
	condition: ParsedExpr,
	body: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	condition_result = compiler_infer_expr(
		compiler_infer_with_expected_value_slot(
			context,
			compiler_type_bool(),
			CompilerExpectedArgumentSlot,
		),
		condition,
	)
	condition_type = compiler_typed_expr_value_type(condition_result.expr)

	condition_context = if compiler_named_value_type_is(condition_type, "Bool"):
		compiler_infer_context_copy(condition_result.context)
	else:
		compiler_condition_error(condition_result.context, "While", condition_type)

	body_result = compiler_infer_expr(compiler_infer_inside_loop(condition_context), body)
	result_context = compiler_infer_context_with_state(context, body_result.context.state)
	typed = CompilerTypedWhileExpr(
		condition_result.expr,
		body_result.expr,
		span,
		compiler_inferred_info(result_context, compiler_type_void()),
	)

	compiler_infer_result(result_context, typed)


private pure func compiler_infer_break_expr(
	context: CompilerInferContext,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	next_context = if context.in_loop:
		compiler_infer_context_copy(context)
	else:
		compiler_infer_error(context, "'break' can only be used inside a loop")

	typed = CompilerTypedBreakExpr(
		span,
		compiler_inferred_info(next_context, compiler_type_void()),
	)

	compiler_infer_result(next_context, typed)


private pure func compiler_infer_continue_expr(
	context: CompilerInferContext,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	next_context = if context.in_loop:
		compiler_infer_context_copy(context)
	else:
		compiler_infer_error(context, "'continue' can only be used inside a loop")

	typed = CompilerTypedContinueExpr(
		span,
		compiler_inferred_info(next_context, compiler_type_void()),
	)

	compiler_infer_result(next_context, typed)


private pure func compiler_array_loop_element_type(
	element_type: CompilerType,
	dims: List[CompilerType],
) -> Option[CompilerType]:
	if dims.length() == 0:
		None
	else if dims.length() == 1:
		Some(compiler_type_copy(element_type))
	else:
		var rest: List[CompilerType] = []
		var index: Int = 1

		while index < dims.length():
			match dims.get(index):
				Some(dim):
					rest = rest.append(compiler_type_copy(dim))
				None:
					void

			index += 1

		Some(CompilerArrayType(compiler_type_copy(element_type), rest))


private pure func compiler_is_single_argument_iterable_type_name(name: String) -> Bool:
	(
		name == "Channel"
		or name == "List"
		or name == "Set"
		or name == "Vector"
		or compiler_is_stream_type_name(name)
	)


private pure func compiler_iterable_element_type(typ: CompilerType) -> Option[CompilerType]:
	match typ:
		CompilerNamedType(name, args):
			if name == "Range" and args.length() == 0:
				Some(compiler_type_int())
			else if name == "String" and args.length() == 0:
				Some(compiler_type_char())
			else if compiler_is_single_argument_iterable_type_name(name) and args.length() == 1:
				match args.get(0):
					Some(element):
						Some(compiler_type_copy(element))
					None:
						None
			else if compiler_is_resource_source_type_name(name) and args.length() == 2:
				args
					.get(0)
					.map(compiler_type_copy)
			else if name == "Dict" and args.length() == 2:
				match args.get(0):
					Some(element):
						Some(compiler_type_copy(element))
					None:
						None
			else:
				None
		CompilerArrayType(element_type, dims):
			compiler_array_loop_element_type(element_type, dims)
		_:
			None


private pure func compiler_loop_index_type(dim: CompilerType) -> CompilerType:
	match dim:
		CompilerConstIntType(bound):
			if bound > 0:
				CompilerRangeType(CompilerConstIntType(bound))
			else:
				compiler_type_int()
		CompilerTypeVar(name):
			if compiler_is_dim_var_name(name):
				CompilerRangeType(CompilerTypeVar(name))
			else:
				compiler_type_int()
		CompilerVarDimsType(name):
			CompilerRangeType(CompilerVarDimsType(name))
		CompilerDimOpType(op, left, right):
			CompilerRangeType(
				compiler_normalize_dim(
					CompilerDimOpType(
						op,
						compiler_type_copy(left),
						compiler_type_copy(right),
					),
				),
			)
		_:
			compiler_type_int()


private pure func compiler_indices_loop_view(
	dims: List[CompilerType],
) -> Option[CompilerTypedLoopView]:
	match dims.get(0):
		Some(first_dim):
			Some(CompilerTypedIndicesLoopView(compiler_loop_index_type(first_dim)))
		None:
			None


private pure func compiler_enumerate_loop_view(
	element_type: CompilerType,
	dims: List[CompilerType],
) -> Option[CompilerTypedLoopView]:
	match (dims.get(0), compiler_array_loop_element_type(element_type, dims)):
		(Some(first_dim), Some(loop_element_type)):
			Some(
				CompilerTypedEnumerateLoopView(
					CompilerTupleType([compiler_loop_index_type(first_dim), loop_element_type]),
				),
			)
		_:
			None


private pure func compiler_enumerate2_loop_view(
	element_type: CompilerType,
	dims: List[CompilerType],
) -> Option[CompilerTypedLoopView]:
	match (dims.get(0), dims.get(1)):
		(Some(row_dim), Some(column_dim)):
			Some(CompilerTypedEnumerate2LoopView(CompilerTupleType([
				compiler_loop_index_type(row_dim),
				compiler_loop_index_type(column_dim),
				compiler_type_copy(element_type),
			])))
		_:
			None


private pure func compiler_windows_loop_view(
	element_type: CompilerType,
	dims: List[CompilerType],
	args: List[CompilerTypedExpr],
) -> Option[CompilerTypedLoopView]:
	if dims.length() != 1:
		None
	else:
		match args.get(1):
			Some(CompilerTypedIntLiteralExpr(text, _, _)):
				match text.parse_int():
					Some(size):
						if size > 0:
							Some(
								CompilerTypedWindowsLoopView(
									size,
									CompilerArrayType(
										compiler_type_copy(element_type),
										[CompilerConstIntType(size)],
									),
								),
							)
						else:
							None
					None:
						None
			_:
				None


private pure func compiler_typed_loop_view(
	iterable: CompilerTypedExpr,
) -> Option[CompilerTypedLoopView]:
	match iterable:
		CompilerTypedCallExpr(_, args, _, info):
			match (info.resolved_call, args.get(0)):
				(Some(call), Some(source)):
					match compiler_array_type_parts(compiler_typed_expr_semantic_type(source)):
						Some((element_type, dims)):
							match call.loop_producer:
								Some(CompilerResolvedLoopProducerIndices):
									compiler_indices_loop_view(dims)
								Some(CompilerResolvedLoopProducerEnumerate):
									compiler_enumerate_loop_view(element_type, dims)
								Some(CompilerResolvedLoopProducerEnumerate2):
									compiler_enumerate2_loop_view(element_type, dims)
								Some(CompilerResolvedLoopProducerWindows):
									compiler_windows_loop_view(element_type, dims, args)
								None:
									None
						None:
							None
				_:
					None
		_:
			None


pure func compiler_typed_loop_view_element_type(view: CompilerTypedLoopView) -> CompilerType:
	match view:
		CompilerTypedIndicesLoopView(element_type):
			compiler_type_copy(element_type)
		CompilerTypedEnumerateLoopView(element_type):
			compiler_type_copy(element_type)
		CompilerTypedEnumerate2LoopView(element_type):
			compiler_type_copy(element_type)
		CompilerTypedWindowsLoopView(_, element_type):
			compiler_type_copy(element_type)


private pure func compiler_iterable_binding_origin(typ: CompilerType) -> CompilerVarOrigin:
	match typ:
		CompilerNamedType(name, args):
			if compiler_is_resource_source_type_name(name) and args.length() == 2:
				CompilerScopedResource
			else:
				CompilerForLoopVar
		_:
			CompilerForLoopVar


private pure func compiler_for_iterable_error(
	context: CompilerInferContext,
	iterable_type: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Cannot iterate over type " + compiler_type_to_string(iterable_type) + ((
			". For-in loops work with Channel, Dict, List, Vector, Set, Stream, String, and "
			+ "Range types"
		)),
	)


private pure func compiler_for_iterable_impure_call_name(
	iterable: CompilerTypedExpr,
) -> List[String]:
	match compiler_typed_expr_semantic_type(iterable):
		CompilerNamedType(name, args):
			if name == "Channel" and args.length() == 1:
				["channel receive"]
			else if compiler_is_stream_type_name(name) and args.length() == 1:
				["stream next"]
			else:
				[]
		_:
			[]


private pure func compiler_for_tuple_elements_result(
	context: CompilerInferContext,
	elements: List[CompilerType],
	ok: Bool,
) -> CompilerForTupleElementsResult:
	{
		context = compiler_infer_context_copy(context),
		elements = elements.map(compiler_type_copy),
		ok = ok
	}


private pure func compiler_tuple_elements_from_type(
	typ: CompilerType,
) -> Option[List[CompilerType]]:
	match typ:
		CompilerTupleType(elements):
			Some(elements.map(compiler_type_copy))
		CompilerNamedType(name, args):
			if name == "Tuple":
				Some(args.map(compiler_type_copy))
			else:
				None
		_:
			None


private pure func compiler_for_tuple_elements_from_iterable_element(
	context: CompilerInferContext,
	element_type: CompilerType,
) -> CompilerForTupleElementsResult:
	match compiler_tuple_elements_from_type(element_type):
		Some(elements):
			compiler_for_tuple_elements_result(context, elements, True)
		None:
			next = compiler_infer_error(
				context,
				"Tuple for-loop requires iterable elements to be tuples, got " + compiler_type_to_string(
					element_type,
				),
			)
			compiler_for_tuple_elements_result(next, [], False)


private pure func compiler_for_tuple_iterable_error(
	context: CompilerInferContext,
	iterable_type: CompilerType,
) -> CompilerForTupleElementsResult:
	next = compiler_infer_error(
		context,
		"Cannot iterate over type " + compiler_type_to_string(
			iterable_type,
		) + ". Tuple for-in loops work with Dict and iterables of tuples",
	)
	compiler_for_tuple_elements_result(next, [], False)


private pure func compiler_for_tuple_element_types(
	context: CompilerInferContext,
	iterable_type: CompilerType,
) -> CompilerForTupleElementsResult:
	match iterable_type:
		CompilerNamedType(name, args):
			if name == "Dict" and args.length() == 2:
				match (args.get(0), args.get(1)):
					(Some(key_type), Some(value_type)):
						compiler_for_tuple_elements_result(
							context,
							[compiler_type_copy(key_type), compiler_type_copy(value_type)],
							True,
						)
					_:
						compiler_for_tuple_elements_result(context, [], False)
			else:
				match compiler_iterable_element_type(iterable_type):
					Some(element_type):
						compiler_for_tuple_elements_from_iterable_element(context, element_type)
					None:
						compiler_for_tuple_iterable_error(context, iterable_type)
		_:
			match compiler_iterable_element_type(iterable_type):
				Some(element_type):
					compiler_for_tuple_elements_from_iterable_element(context, element_type)
				None:
					compiler_for_tuple_iterable_error(context, iterable_type)


private pure func compiler_for_tuple_arity_error(
	context: CompilerInferContext,
	binder_count: Int,
	element_count: Int,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Tuple for-loop arity mismatch: expected " + binder_count.to_string() + " binders, got " + element_count.to_string() + " tuple fields",
	)


private pure func compiler_for_redeclaration_error(
	context: CompilerInferContext,
	name: String,
) -> CompilerInferContext:
	compiler_infer_error(context, "Cannot redeclare `" + name + "` in for loop")


private pure func compiler_check_for_tuple_redeclarations(
	context: CompilerInferContext,
	names: List[ParsedIdentifier],
) -> CompilerInferContext:
	var next_context: CompilerInferContext = compiler_infer_context_copy(context)
	var seen: List[String] = []

	for name in names:
		if name.text != "_":
			if (
				compiler_env_lookup_in_current_scope(context.state.env, name.text).is_some()
				or seen.contains(name.text)
			):
				next_context = compiler_for_redeclaration_error(next_context, name.text)

			seen = seen.append(name.text)

	next_context


private pure func compiler_tuple_binding_type(
	element_types: List[CompilerType],
	index: Int,
) -> CompilerType:
	match element_types.get(index):
		Some(typ):
			compiler_type_copy(typ)
		None:
			compiler_type_void()


private pure func compiler_add_tuple_for_bindings(
	env: CompilerEnv,
	names: List[ParsedIdentifier],
	element_types: List[CompilerType],
) -> CompilerEnv:
	var next_env: CompilerEnv = env
	var index: Int = 0

	while index < names.length():
		match names.get(index):
			Some(name):
				if name.text != "_":
					elem_type = compiler_tuple_binding_type(element_types, index)
					next_env = compiler_env_add_var_with_details(
						next_env,
						name.text,
						compiler_type_copy(elem_type),
						Some(compiler_type_copy(elem_type)),
						CompilerImmutableBinding,
						CompilerForLoopVar,
						compiler_unrefined_binding(),
					)
			None:
				void

		index += 1

	next_env


private pure func compiler_for_name_binding_type(
	loop_view: Option[CompilerTypedLoopView],
	iterable: CompilerTypedExpr,
	fallback: CompilerType,
) -> CompilerType:
	match loop_view:
		Some(view):
			compiler_typed_loop_view_element_type(view)
		None:
			match iterable:
				CompilerTypedRangeExpr(start_expr, end_expr, _, _):
					match compiler_typed_expr_semantic_type(start_expr):
						CompilerConstIntType(0):
							compiler_loop_index_type(compiler_typed_expr_semantic_type(end_expr))
						_:
							compiler_type_copy(fallback)
				_:
					compiler_type_copy(fallback)


private pure func compiler_infer_for_expr(
	context: CompilerInferContext,
	binder: ParsedForBinder,
	iterable: ParsedExpr,
	body: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	iter_result = compiler_infer_expr(compiler_infer_without_expected(context), iterable)
	iter_type = compiler_typed_expr_semantic_type(iter_result.expr)
	loop_view = compiler_typed_loop_view(iter_result.expr)

	match binder:
		ParsedForNameBinder(name):
			element_result = match loop_view:
				Some(view):
					Some(compiler_typed_loop_view_element_type(view))
				None:
					compiler_iterable_element_type(iter_type)

			binding_origin = compiler_iterable_binding_origin(iter_type)

			after_iter_context = match element_result:
				Some(_):
					compiler_infer_context_copy(iter_result.context)
				None:
					compiler_for_iterable_error(iter_result.context, iter_type)

			redeclared = if name.text == "_":
				False
			else:
				compiler_env_lookup_in_current_scope(
					after_iter_context.state.env,
					name.text,
				).is_some()

			checked_context = if redeclared:
				compiler_for_redeclaration_error(after_iter_context, name.text)
			else:
				compiler_infer_context_copy(after_iter_context)

			base_elem_type = match element_result:
				Some(typ):
					compiler_type_copy(typ)
				None:
					compiler_type_void()

			elem_type = compiler_for_name_binding_type(loop_view, iter_result.expr, base_elem_type)

			loop_env = compiler_env_push_scope(checked_context.state.env)

			bound_env = if name.text == "_":
				loop_env
			else:
				compiler_env_add_var_with_details(
					loop_env,
					name.text,
					compiler_type_copy(elem_type),
					Some(compiler_type_copy(elem_type)),
					CompilerImmutableBinding,
					binding_origin,
					compiler_unrefined_binding(),
				)

			loop_state = compiler_typecheck_state_with_env(checked_context.state, bound_env)
			loop_context = compiler_infer_inside_loop(
				compiler_infer_context_with_state(
					checked_context,
					loop_state,
				),
			)
			body_result = compiler_infer_expr(loop_context, body)
			outer_env = compiler_env_pop_scope(body_result.context.state.env)
			outer_state = compiler_typecheck_state_with_env(body_result.context.state, outer_env)
			result_context = compiler_infer_context_with_state(context, outer_state)
			typed = CompilerTypedForExpr(
				binder,
				iter_result.expr,
				loop_view,
				body_result.expr,
				span,
				compiler_inferred_info(result_context, compiler_type_void()),
			)
			compiler_infer_result(result_context, typed)
		ParsedForTupleBinder(names, _):
			tuple_elements = match loop_view:
				Some(view):
					compiler_for_tuple_elements_from_iterable_element(
						iter_result.context,
						compiler_typed_loop_view_element_type(view),
					)
				None:
					compiler_for_tuple_element_types(iter_result.context, iter_type)

			arity_context = if tuple_elements.ok:
				if names.length() == tuple_elements.elements.length():
					compiler_infer_context_copy(tuple_elements.context)
				else:
					compiler_for_tuple_arity_error(
						tuple_elements.context,
						names.length(),
						tuple_elements.elements.length(),
					)
			else:
				compiler_infer_context_copy(tuple_elements.context)

			checked_context = compiler_check_for_tuple_redeclarations(arity_context, names)
			loop_env = compiler_env_push_scope(checked_context.state.env)
			bound_env = compiler_add_tuple_for_bindings(loop_env, names, tuple_elements.elements)
			loop_state = compiler_typecheck_state_with_env(checked_context.state, bound_env)
			loop_context = compiler_infer_inside_loop(
				compiler_infer_context_with_state(
					checked_context,
					loop_state,
				),
			)
			body_result = compiler_infer_expr(loop_context, body)
			outer_env = compiler_env_pop_scope(body_result.context.state.env)
			outer_state = compiler_typecheck_state_with_env(body_result.context.state, outer_env)
			result_context = compiler_infer_context_with_state(context, outer_state)
			typed = CompilerTypedForExpr(
				binder,
				iter_result.expr,
				loop_view,
				body_result.expr,
				span,
				compiler_inferred_info(result_context, compiler_type_void()),
			)
			compiler_infer_result(result_context, typed)


private pure func compiler_binding_slot(is_mutable: Bool, typ: CompilerType) -> CompilerValueSlot:
	if is_mutable:
		compiler_mutable_binding_slot(typ)
	else:
		compiler_keep_value_slot(typ)


private pure func compiler_assign_to_non_var_error(
	context: CompilerInferContext,
	name: String,
	kind: CompilerSymbolKind,
) -> CompilerInferContext:
	error_message: String = match kind:
		CompilerFuncSymbolKind(_):
			"Cannot assign to function '" + name + "'"
		CompilerTypeSymbolKind(_):
			"Cannot assign to type name '" + name + "'"
		CompilerRecordSymbolKind(_):
			"Cannot assign to record type '" + name + "'"
		CompilerConstructorSymbolKind(_):
			"Cannot assign to constructor '" + name + "'"
		CompilerAliasSymbolKind(_):
			"Cannot assign to type alias '" + name + "'"
		CompilerOpaqueAliasSymbolKind(_):
			"Cannot assign to opaque type '" + name + "'"
		CompilerVarSymbolKind(_):
			"Cannot assign to variable '" + name + "'"

	compiler_infer_error(context, error_message)


private pure func compiler_assignment_type_mismatch_error(
	context: CompilerInferContext,
	name: String,
	expected: CompilerType,
	found: CompilerType,
) -> CompilerInferContext:
	compiler_infer_error(
		context,
		"Cannot assign to variable '" + name + "'\n    expected: " + compiler_type_to_string(
			expected,
		) + "\n       found: " + compiler_type_to_string(found),
	)


private pure func compiler_assignment_compatible_context(
	context: CompilerInferContext,
	expected: CompilerType,
	found: CompilerType,
) -> Option[CompilerInferContext]:
	if compiler_types_equal(expected, found):
		Some(compiler_infer_context_copy(context))
	else if compiler_type_contains_meta(expected) or compiler_type_contains_meta(found):
		resolved_expected = compiler_env_resolve_alias(context.state.env, expected)
		resolved_found = compiler_env_resolve_alias(context.state.env, found)

		match compiler_unify_symmetric(context.state.context, resolved_expected, resolved_found):
			Some(step):
				next_state = { context.state | context = step.context }
				Some(compiler_infer_context_with_state(context, next_state))
			None:
				None
	else:
		None


private pure func compiler_assign_scope_from_lookup(
	context: CompilerInferContext,
	lookup: CompilerSymbolLookup,
) -> CompilerTypedAssignScope:
	if compiler_env_lookup_is_outermost_scope(context.state.env, lookup):
		CompilerModuleAssignScope
	else:
		CompilerLocalAssignScope


private pure func compiler_infer_discard_assign_expr(
	context: CompilerInferContext,
	name: ParsedIdentifier,
	value: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	value_result = compiler_infer_expr(compiler_infer_without_expected(context), value)
	typed = CompilerTypedAssignExpr(
		name,
		CompilerLocalAssignScope,
		value_result.expr,
		span,
		compiler_inferred_info(value_result.context, compiler_type_void()),
	)

	compiler_infer_result(value_result.context, typed)


private pure func compiler_infer_implicit_assign_binding(
	context: CompilerInferContext,
	name: ParsedIdentifier,
	value: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	value_result = compiler_infer_expr(compiler_infer_without_expected(context), value)
	binding_type = compiler_typed_expr_semantic_type(value_result.expr)
	source_type = compiler_typed_expr_source_type(value_result.expr)
	initializer = compiler_typed_expr_with_slot(
		value_result.expr,
		compiler_binding_slot(False, compiler_type_copy(binding_type)),
	)
	checked_context = compiler_check_resource_capability_binding(
		value_result.context,
		name.text,
		binding_type,
		False,
		value,
	)
	binding_origin = compiler_binding_origin_for_initializer(checked_context, initializer)
	next_env = compiler_env_add_var_with_details(
		checked_context.state.env,
		name.text,
		compiler_type_copy(binding_type),
		compiler_optional_type_copy(source_type),
		CompilerImmutableBinding,
		binding_origin,
		compiler_unrefined_binding(),
	)
	next_state = compiler_typecheck_state_with_env(checked_context.state, next_env)
	next_context = compiler_infer_context_with_state(checked_context, next_state)
	typed = CompilerTypedVarDeclExpr(
		{
			name = name,
			annotation = Some(compiler_type_copy(binding_type)),
			initializer = initializer,
			is_mutable = False,
			span = span
		},
		compiler_inferred_info(
			next_context,
			compiler_type_void(),
		),
	)

	compiler_infer_result(next_context, typed)


private pure func compiler_infer_mutable_assign_expr(
	context: CompilerInferContext,
	name: ParsedIdentifier,
	value: ParsedExpr,
	span: CompilerSourceSpan,
	assign_scope: CompilerTypedAssignScope,
	var_type: CompilerType,
) -> CompilerInferResult:
	current_var_type = compiler_resolve_type_metas(context.state.context, var_type)
	value_result = compiler_infer_expr(
		compiler_infer_with_expected_value_slot(
			context,
			current_var_type,
			CompilerExpectedArgumentSlot,
		),
		value,
	)
	value_type = compiler_typed_expr_value_type(value_result.expr)

	next_context = match compiler_assignment_compatible_context(
		value_result.context,
		current_var_type,
		value_type,
	):
		Some(compatible_context):
			compatible_context
		None:
			compiler_assignment_type_mismatch_error(
				value_result.context,
				name.text,
				current_var_type,
				value_type,
			)

	typed = CompilerTypedAssignExpr(
		name,
		assign_scope,
		value_result.expr,
		span,
		compiler_inferred_info(next_context, compiler_type_void()),
	)

	compiler_infer_result(next_context, typed)


private pure func compiler_infer_invalid_assign_target_result(
	context: CompilerInferContext,
	name: ParsedIdentifier,
	value: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	typed_value = CompilerTypedUnsupportedExpr(
		"assignment value",
		parsed_expr_span(value),
		compiler_inferred_info(context, compiler_type_void()),
	)
	typed = CompilerTypedAssignExpr(
		name,
		CompilerLocalAssignScope,
		typed_value,
		span,
		compiler_inferred_info(context, compiler_type_void()),
	)

	compiler_infer_result(context, typed)


private pure func compiler_infer_assign_expr(
	context: CompilerInferContext,
	name: ParsedIdentifier,
	value: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	match compiler_env_lookup_with_scope_depth(context.state.env, name.text):
		None:
			if name.text == "_":
				compiler_infer_discard_assign_expr(context, name, value, span)
			else:
				compiler_infer_implicit_assign_binding(context, name, value, span)
		Some(lookup):
			match lookup.symbol.kind:
				CompilerVarSymbolKind(var_symbol):
					if compiler_var_mutability_is_mutable(var_symbol.mutability):
						compiler_infer_mutable_assign_expr(
							context,
							name,
							value,
							span,
							compiler_assign_scope_from_lookup(context, lookup),
							var_symbol.var_type,
						)
					else:
						next_context = compiler_infer_error(
							context,
							"Cannot assign to immutable variable '" + name.text + "'",
						)
						compiler_infer_invalid_assign_target_result(next_context, name, value, span)
				_:
					if compiler_env_lookup_in_current_scope(context.state.env, name.text).is_none():
						compiler_infer_implicit_assign_binding(context, name, value, span)
					else:
						next_context = compiler_assign_to_non_var_error(
							context,
							name.text,
							lookup.symbol.kind,
						)
						compiler_infer_invalid_assign_target_result(next_context, name, value, span)


private pure func compiler_compound_assign_binary_op(op: ParsedCompoundAssignOp) -> ParsedBinaryOp:
	match op:
		ParsedAssignAddOp:
			ParsedAddOp
		ParsedAssignSubtractOp:
			ParsedSubtractOp
		ParsedAssignMultiplyOp:
			ParsedMultiplyOp
		ParsedAssignDivideOp:
			ParsedDivideOp


private pure func compiler_infer_compound_assign_expr(
	context: CompilerInferContext,
	name: ParsedIdentifier,
	op: ParsedCompoundAssignOp,
	value: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	rhs = ParsedBinaryExpr(
		compiler_compound_assign_binary_op(op),
		ParsedNameExpr(name),
		value,
		span,
	)
	compiler_infer_assign_expr(context, name, rhs, span)


private pure func compiler_infer_var_decl_expr(
	context: CompilerInferContext,
	name: ParsedIdentifier,
	annotation: Option[ParsedTypeExpr],
	value: ParsedExpr,
	is_mutable: Bool,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	source_declared_type: Option[CompilerType] = annotation.map(compiler_type_from_parsed_type_expr)
	semantic_declared_type: Option[CompilerType] = source_declared_type.map(
		func(typ): compiler_infer_canonical_expected_type(context, typ),
	)

	value_context = match semantic_declared_type:
		Some(typ):
			compiler_infer_with_expected_value_slot(
				context,
				compiler_type_copy(typ),
				CompilerExpectedArgumentSlot,
			)
		None:
			compiler_infer_without_expected(context)

	value_result = compiler_infer_expr(value_context, value)
	value_type = compiler_typed_expr_value_type(value_result.expr)

	binding_type = match semantic_declared_type:
		Some(typ):
			compiler_type_copy(typ)
		None:
			compiler_type_copy(compiler_typed_expr_semantic_type(value_result.expr))

	source_type = match source_declared_type:
		Some(typ):
			Some(compiler_type_copy(typ))
		None:
			compiler_optional_type_copy(compiler_typed_expr_source_type(value_result.expr))

	checked_context = match (source_declared_type, semantic_declared_type):
		(Some(source_type), Some(semantic_type)):
			match compiler_assignment_compatible_context(
				value_result.context,
				semantic_type,
				value_type,
			):
				Some(compatible_context):
					compatible_context
				None:
					compiler_infer_error(
						value_result.context,
						"Binding `" + name.text + "` declared as `" + compiler_type_to_string(
							source_type,
						) + "` but initializer has type `" + compiler_type_to_string(
							value_type,
						) + "`",
					)
		_:
			compiler_infer_context_copy(value_result.context)

	initializer = compiler_typed_expr_with_slot(
		value_result.expr,
		compiler_binding_slot(is_mutable, compiler_type_copy(binding_type)),
	)
	binding_checked_context = compiler_check_resource_capability_binding(
		checked_context,
		name.text,
		binding_type,
		is_mutable,
		value,
	)

	binding_origin = if is_mutable:
		CompilerLetBinding
	else:
		compiler_binding_origin_for_initializer(binding_checked_context, initializer)

	next_env = compiler_env_add_var_with_details(
		binding_checked_context.state.env,
		name.text,
		compiler_type_copy(binding_type),
		compiler_optional_type_copy(source_type),
		compiler_var_mutability(is_mutable),
		binding_origin,
		compiler_unrefined_binding(),
	)
	next_state = compiler_typecheck_state_with_env(binding_checked_context.state, next_env)
	next_context = compiler_infer_context(next_state)
	typed = CompilerTypedVarDeclExpr(
		{
			name = name,
			annotation = compiler_optional_type_copy(source_declared_type),
			initializer = initializer,
			is_mutable = is_mutable,
			span = span
		},
		compiler_inferred_info(
			next_context,
			compiler_type_void(),
		),
	)

	compiler_infer_result(next_context, typed)


private pure func compiler_question_bind_carrier(
	context: CompilerInferContext,
	typ: CompilerType,
) -> CompilerQuestionBindCarrier:
	resolved = compiler_env_resolve_alias(context.state.env, typ)

	match resolved:
		CompilerNamedType(name, args):
			if name == "Option" and args.length() == 1:
				match args.get(0):
					Some(inner_type):
						CompilerQuestionBindOptionCarrier(compiler_type_copy(inner_type))
					None:
						CompilerQuestionBindNonCarrier
			else if name == "Result" and args.length() == 2:
				match (args.get(0), args.get(1)):
					(Some(ok_type), Some(error_type)):
						CompilerQuestionBindResultCarrier(
							compiler_type_copy(ok_type),
							compiler_type_copy(error_type),
						)
					_:
						CompilerQuestionBindNonCarrier
			else:
				CompilerQuestionBindNonCarrier
		_:
			CompilerQuestionBindNonCarrier


private pure func compiler_optional_question_bind_annotation_type(
	context: CompilerInferContext,
	annotation: Option[ParsedTypeExpr],
) -> Option[CompilerType]:
	match annotation:
		Some(type_expr):
			Some(
				compiler_infer_canonical_expected_type(
					context,
					compiler_type_from_parsed_type_expr(type_expr),
				),
			)
		None:
			None


private pure func compiler_question_bind_annotation_context(
	context: CompilerInferContext,
	annotation_type: Option[CompilerType],
	inner_type: CompilerType,
) -> CompilerInferContext:
	match annotation_type:
		Some(annotated_type):
			if compiler_types_equal(annotated_type, inner_type):
				compiler_infer_context_copy(context)
			else:
				compiler_infer_error(
					context,
					"Type annotation `" + compiler_type_to_string(
						annotated_type,
					) + "` does not match unwrapped type `" + compiler_type_to_string(
						inner_type,
					) + "`",
				)
		None:
			compiler_infer_context_copy(context)


private pure func compiler_question_bind_binding_type(
	annotation_type: Option[CompilerType],
	inner_type: CompilerType,
) -> CompilerType:
	match annotation_type:
		Some(annotated_type):
			compiler_type_copy(annotated_type)
		None:
			compiler_type_copy(inner_type)


private pure func compiler_question_bind_result(
	context: CompilerInferContext,
	name: ParsedIdentifier,
	annotation_type: Option[CompilerType],
	value: CompilerTypedExpr,
	binding_type: CompilerType,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	next_env = if name.text == "_":
		context.state.env
	else:
		compiler_env_add_var_with_details(
			context.state.env,
			name.text,
			compiler_type_copy(binding_type),
			Some(compiler_type_copy(binding_type)),
			CompilerImmutableBinding,
			CompilerLetBinding,
			compiler_unrefined_binding(),
		)

	next_state = compiler_typecheck_state_with_env(context.state, next_env)
	next_context = compiler_infer_context_with_state(context, next_state)
	typed = CompilerTypedQuestionBindExpr(
		name,
		compiler_optional_type_copy(annotation_type),
		value,
		span,
		compiler_inferred_info(next_context, binding_type),
	)

	compiler_infer_result(next_context, typed)


private pure func compiler_question_bind_error_result(
	context: CompilerInferContext,
	name: ParsedIdentifier,
	annotation_type: Option[CompilerType],
	value: CompilerTypedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	typed = CompilerTypedQuestionBindExpr(
		name,
		compiler_optional_type_copy(annotation_type),
		value,
		span,
		compiler_inferred_info(context, compiler_type_void()),
	)

	compiler_infer_result(context, typed)


private pure func compiler_validate_question_bind(
	context: CompilerInferContext,
	name: ParsedIdentifier,
	annotation_type: Option[CompilerType],
	value: CompilerTypedExpr,
	inner_type: CompilerType,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	annotated_context = compiler_question_bind_annotation_context(
		context,
		annotation_type,
		inner_type,
	)
	binding_type = compiler_question_bind_binding_type(annotation_type, inner_type)

	if annotated_context.state.errors.length() == context.state.errors.length():
		compiler_question_bind_result(
			annotated_context,
			name,
			annotation_type,
			value,
			binding_type,
			span,
		)
	else:
		compiler_question_bind_error_result(annotated_context, name, annotation_type, value, span)


private pure func compiler_infer_question_bind_statement(
	context: CompilerInferContext,
	name: ParsedIdentifier,
	annotation: Option[ParsedTypeExpr],
	value: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	annotation_type = compiler_optional_question_bind_annotation_type(context, annotation)
	value_result = compiler_infer_expr(compiler_infer_without_expected(context), value)
	value_context = compiler_infer_context_with_state(context, value_result.context.state)
	value_type = compiler_typed_expr_value_type(value_result.expr)

	if context.in_loop:
		next = compiler_infer_error(value_context, "?= cannot be used inside loop bodies")
		compiler_question_bind_error_result(next, name, annotation_type, value_result.expr, span)
	else:
		expected_carrier = match context.expected_type:
			Some(expected_type):
				compiler_question_bind_carrier(context, expected_type)
			None:
				CompilerQuestionBindNonCarrier

		value_carrier = compiler_question_bind_carrier(value_context, value_type)

		match (expected_carrier, value_carrier):
			(CompilerQuestionBindOptionCarrier(_), CompilerQuestionBindOptionCarrier(inner_type)):
				compiler_validate_question_bind(
					value_context,
					name,
					annotation_type,
					value_result.expr,
					inner_type,
					span,
				)
			(CompilerQuestionBindOptionCarrier(_), CompilerQuestionBindResultCarrier(_, _)):
				next = compiler_infer_error(
					value_context,
					(
						"Cannot use Result ?= in a block returning Option. Convert the Result to Option "
						+ "or return Result from the enclosing function"
					),
				)
				compiler_question_bind_error_result(
					next,
					name,
					annotation_type,
					value_result.expr,
					span,
				)
			(CompilerQuestionBindResultCarrier(_, expected_error_type), CompilerQuestionBindResultCarrier(inner_type, actual_error_type)):
				if compiler_types_equal(expected_error_type, actual_error_type):
					compiler_validate_question_bind(
						value_context,
						name,
						annotation_type,
						value_result.expr,
						inner_type,
						span,
					)
				else:
					next = compiler_infer_error(
						value_context,
						"Incompatible error type for ?=: enclosing block returns Result[..., " + compiler_type_to_string(
							expected_error_type,
						) + "], but expression returns Result[..., " + compiler_type_to_string(
							actual_error_type,
						) + "]",
					)
					compiler_question_bind_error_result(
						next,
						name,
						annotation_type,
						value_result.expr,
						span,
					)
			(CompilerQuestionBindResultCarrier(_, _), CompilerQuestionBindOptionCarrier(_)):
				next = compiler_infer_error(
					value_context,
					(
						"Cannot use Option ?= in a block returning Result. Convert the Option to Result "
						+ "with to_result(...) or return Option from the enclosing function"
					),
				)
				compiler_question_bind_error_result(
					next,
					name,
					annotation_type,
					value_result.expr,
					span,
				)
			(CompilerQuestionBindNonCarrier, CompilerQuestionBindOptionCarrier(_)):
				next = match context.expected_type:
					Some(expected_type):
						compiler_infer_error(
							value_context,
							(
								"?= requires the enclosing block to return the same carrier as the expression; "
								+ "enclosing block returns "
							) + compiler_type_to_string(expected_type),
						)
					None:
						compiler_infer_error(
							value_context,
							"?= requires an enclosing block returning Option[T] or Result[T, E]",
						)

				compiler_question_bind_error_result(
					next,
					name,
					annotation_type,
					value_result.expr,
					span,
				)
			(CompilerQuestionBindNonCarrier, CompilerQuestionBindResultCarrier(_, _)):
				next = match context.expected_type:
					Some(expected_type):
						compiler_infer_error(
							value_context,
							(
								"?= requires the enclosing block to return the same carrier as the expression; "
								+ "enclosing block returns "
							) + compiler_type_to_string(expected_type),
						)
					None:
						compiler_infer_error(
							value_context,
							"?= requires an enclosing block returning Option[T] or Result[T, E]",
						)

				compiler_question_bind_error_result(
					next,
					name,
					annotation_type,
					value_result.expr,
					span,
				)
			(_, CompilerQuestionBindNonCarrier):
				next = compiler_infer_error(
					value_context,
					"Cannot use `?=` on type `" + compiler_type_to_string(
						value_type,
					) + "` — only Option and Result support ?= bindings",
				)
				compiler_question_bind_error_result(
					next,
					name,
					annotation_type,
					value_result.expr,
					span,
				)


private pure func compiler_question_bind_final_result(
	context: CompilerInferContext,
	name: ParsedIdentifier,
	annotation: Option[ParsedTypeExpr],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	annotation_type = compiler_optional_question_bind_annotation_type(context, annotation)
	next = compiler_infer_error(context, "?= binding must be followed by a result expression")
	value = CompilerTypedMissingExpr(
		span,
		compiler_inferred_info(next, compiler_type_void()),
	)
	compiler_question_bind_error_result(next, name, annotation_type, value, span)


private pure func compiler_infer_block_items(
	context: CompilerInferContext,
	exprs: List[ParsedExpr],
	index: Int,
	typed_exprs: List[CompilerTypedExpr],
	block_span: CompilerSourceSpan,
) -> CompilerInferResult:
	if index >= exprs.length():
		typed = CompilerTypedBlockExpr(
			typed_exprs,
			block_span,
			compiler_inferred_info(context, compiler_type_void()),
		)
		compiler_infer_result(context, typed)
	else:
		match exprs.get(index):
			Some(ParsedQuestionBindExpr(name, annotation, value, span)):
				is_last: Bool = index == exprs.length() - 1

				if is_last:
					item_result = compiler_question_bind_final_result(
						context,
						name,
						annotation,
						span,
					)
					next_exprs = typed_exprs.append(item_result.expr)
					typed = CompilerTypedBlockExpr(
						next_exprs,
						block_span,
						compiler_inferred_info(item_result.context, compiler_type_void()),
					)
					compiler_infer_result(item_result.context, typed)
				else:
					item_result = compiler_infer_question_bind_statement(
						context,
						name,
						annotation,
						value,
						span,
					)
					next_exprs = typed_exprs.append(item_result.expr)
					compiler_infer_block_items(
						item_result.context,
						exprs,
						index + 1,
						next_exprs,
						block_span,
					)
			Some(expr):
				is_last: Bool = index == exprs.length() - 1

				item_context = if is_last:
					context
				else:
					compiler_infer_without_expected(context)

				item_result = compiler_infer_expr(item_context, expr)
				next_exprs = typed_exprs.append(item_result.expr)

				if is_last:
					typed = CompilerTypedBlockExpr(
						next_exprs,
						block_span,
						compiler_typed_expr_info(item_result.expr),
					)
					compiler_infer_result(item_result.context, typed)
				else:
					preserved_context = compiler_infer_context_with_state(
						context,
						item_result.context.state,
					)
					compiler_infer_block_items(
						preserved_context,
						exprs,
						index + 1,
						next_exprs,
						block_span,
					)
			None:
				typed = CompilerTypedBlockExpr(
					typed_exprs,
					block_span,
					compiler_inferred_info(context, compiler_type_void()),
				)
				compiler_infer_result(context, typed)


private pure func compiler_infer_block_expr(
	context: CompilerInferContext,
	exprs: List[ParsedExpr],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	inner_env = compiler_env_push_scope(context.state.env)
	inner_state = compiler_typecheck_state_with_env(context.state, inner_env)
	inner_context = compiler_infer_context_with_state(context, inner_state)

	result = if exprs.length() == 0:
		typed = CompilerTypedBlockExpr(
			[],
			span,
			compiler_inferred_info(inner_context, compiler_type_void()),
		)
		compiler_infer_result(inner_context, typed)
	else:
		compiler_infer_block_items(inner_context, exprs, 0, [], span)

	outer_env = compiler_env_pop_scope(result.context.state.env)
	outer_state = compiler_typecheck_state_with_env(result.context.state, outer_env)
	outer_context = compiler_infer_context_with_state(result.context, outer_state)

	block_items: List[CompilerTypedExpr] = match result.expr:
		CompilerTypedBlockExpr(items, _, _):
			items
		_:
			[]

	compiler_infer_result(
		outer_context,
		CompilerTypedBlockExpr(block_items, span, compiler_typed_expr_info(result.expr)),
	)


private pure func compiler_infer_debug_block_expr(
	context: CompilerInferContext,
	body: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	body_result = compiler_infer_expr(
		compiler_infer_inside_debug(compiler_infer_without_expected(context)),
		body,
	)
	result_context = compiler_infer_context_with_state(context, body_result.context.state)
	typed = CompilerTypedDebugBlockExpr(
		body_result.expr,
		span,
		compiler_inferred_info(result_context, compiler_type_void()),
	)

	compiler_infer_result(result_context, typed)


private pure func compiler_concurrent_param_allowed(name: String) -> Bool:
	name == CONCURRENT_PARAM_MAX_THREADS or name == CONCURRENT_PARAM_TIMEOUT


private pure func compiler_check_concurrent_param_names(
	context: CompilerInferContext,
	params: List[ParsedConcurrentParam],
) -> CompilerInferContext:
	var next_context = compiler_infer_context_copy(context)
	var seen: List[String] = []

	for param in params:
		name = param.name.text

		if not compiler_concurrent_param_allowed(name):
			next_context = compiler_infer_error(
				next_context,
				"Unknown concurrent parameter `" + name + "`",
			)
		else if seen.contains(name):
			next_context = compiler_infer_error(
				next_context,
				"Duplicate concurrent parameter `" + name + "`",
			)
		else:
			seen = seen.append(name)

	next_context


private pure func compiler_infer_concurrent_params_result(
	context: CompilerInferContext,
	params: List[CompilerTypedConcurrentParam],
) -> CompilerInferConcurrentParamsResult:
	{
		context = compiler_infer_context_copy(context),
		params = params
	}


private pure func compiler_infer_concurrent_params(
	context: CompilerInferContext,
	params: List[ParsedConcurrentParam],
) -> CompilerInferConcurrentParamsResult:
	var next_context = compiler_check_concurrent_param_names(context, params)
	var typed_params: List[CompilerTypedConcurrentParam] = []

	for param in params:
		param_context = compiler_infer_with_expected_value_slot(
			compiler_infer_without_expected(next_context),
			compiler_type_int(),
			CompilerExpectedArgumentSlot,
		)
		value_result = compiler_infer_expr(param_context, param.value)
		typed_params = typed_params.append({
			name = param.name,
			value = value_result.expr,
			span = param.span,
		})
		next_context = compiler_infer_context_with_state(next_context, value_result.context.state)

	compiler_infer_concurrent_params_result(next_context, typed_params)


private pure func compiler_check_concurrent_body_shape(
	context: CompilerInferContext,
	body: ParsedExpr,
) -> CompilerInferContext:
	match body:
		ParsedBlockExpr(items, _):
			if items.length() == 0:
				compiler_infer_error(context, "concurrent: block cannot be empty")
			else:
				var next_context = compiler_infer_context_copy(context)

				for item in items:
					match item:
						ParsedAssignExpr(_, _, _):
							void
						ParsedVarDeclExpr(_, _, _, False, _):
							void
						ParsedVarDeclExpr(_, _, _, True, _):
							next_context = compiler_infer_error(
								next_context,
								"concurrent bindings cannot be mutable (var)",
							)
						_:
							next_context = compiler_infer_error(
								next_context,
								"concurrent: block must contain only bindings (name = expr)",
							)

				next_context
		_:
			compiler_infer_error(context, "concurrent: body must be a block")


private pure func compiler_concurrent_binding_name(item: ParsedExpr) -> Option[String]:
	match item:
		ParsedAssignExpr(name, _, _):
			Some(name.text)
		ParsedVarDeclExpr(name, _, _, False, _):
			Some(name.text)
		_:
			None


private pure func compiler_concurrent_binding_value(item: ParsedExpr) -> Option[ParsedExpr]:
	match item:
		ParsedAssignExpr(_, value, _):
			Some(value)
		ParsedVarDeclExpr(_, _, value, False, _):
			Some(value)
		_:
			None


private pure func compiler_concurrent_binding_annotation(
	item: ParsedExpr,
) -> Option[ParsedTypeExpr]:
	match item:
		ParsedAssignExpr(_, _, _):
			None
		ParsedVarDeclExpr(_, annotation, _, False, _):
			annotation
		_:
			None


private pure func compiler_concurrent_binding_span(item: ParsedExpr) -> CompilerSourceSpan:
	parsed_expr_span(item)


private pure func compiler_concurrent_binding_identifier(
	item: ParsedExpr,
) -> Option[ParsedIdentifier]:
	match item:
		ParsedAssignExpr(name, _, _):
			Some(name)
		ParsedVarDeclExpr(name, _, _, False, _):
			Some(name)
		_:
			None


private pure func compiler_concurrent_binding_names(items: List[ParsedExpr]) -> List[String]:
	var result: List[String] = []

	for item in items:
		match compiler_concurrent_binding_name(item):
			Some(name):
				result = result.append(name)
			None:
				void

	result


private pure func compiler_check_duplicate_concurrent_bindings(
	context: CompilerInferContext,
	items: List[ParsedExpr],
) -> CompilerInferContext:
	var next_context = compiler_infer_context_copy(context)
	var seen: List[String] = []

	for item in items:
		match compiler_concurrent_binding_name(item):
			Some(name):
				if seen.contains(name):
					next_context = compiler_infer_error(
						next_context,
						"Duplicate concurrent binding `" + name + "`",
					)
				else:
					seen = seen.append(name)
			None:
				void

	next_context


private pure func compiler_unavailable_concurrent_binding_refs(
	env: CompilerEnv,
	binding_names: List[String],
	value: ParsedExpr,
) -> List[String]:
	refs = compiler_free_var_refs_in_expr(env, [], value)
	var result: List[String] = []

	for name in refs:
		if binding_names.contains(name) and compiler_env_lookup(env, name).is_none():
			result = compiler_name_list_add_unique(result, name)

	result


private pure func compiler_concurrent_sibling_ref_message(
	current_name: String,
	refs: List[String],
) -> String:
	if refs.length() == 1:
		name = refs.get_or(0, "")

		if name == current_name:
			"concurrent binding `" + name + "` is not available inside its own task"
		else:
			"concurrent binding `" + name + "` is not available inside another concurrent task"
	else:
		joined = compiler_join_names(refs)
		"concurrent bindings " + joined + " are not available inside sibling concurrent tasks"


private pure func compiler_check_concurrent_sibling_binding_refs(
	context: CompilerInferContext,
	binding_names: List[String],
	current_name: String,
	value: ParsedExpr,
) -> CompilerInferContext:
	refs = compiler_unavailable_concurrent_binding_refs(context.state.env, binding_names, value)

	if refs.length() == 0:
		compiler_infer_context_copy(context)
	else:
		compiler_infer_error(
			context,
			compiler_concurrent_sibling_ref_message(current_name, refs),
		)


private pure func compiler_task_capture_error(
	context: CompilerInferContext,
	task_label: String,
	capture_label: String,
	names: List[String],
) -> CompilerInferContext:
	plural = if names.length() == 1:
		""
	else:
		"s"

	compiler_infer_error(
		context,
		task_label + " cannot capture " + capture_label + plural + ": " + compiler_join_names(
			names,
		),
	)


private pure func compiler_check_task_captures(
	context: CompilerInferContext,
	task_label: String,
	bound: List[String],
	body: ParsedExpr,
) -> CompilerInferContext:
	free_refs = compiler_free_var_refs_in_expr(context.state.env, bound, body)
	resource_captures = compiler_scoped_resource_capture_names(context.state.env, free_refs)
	source_captures = compiler_capture_names_with_capability(
		context,
		free_refs,
		CompilerResourceSourceShape,
	)
	derived_captures = compiler_scoped_resource_derived_capture_names(context.state.env, free_refs)
	stream_captures = compiler_capture_names_with_capability(
		context,
		free_refs,
		CompilerOneShotStreamShape,
	)
	mutable_captures = compiler_mutable_capture_names(context.state.env, free_refs)

	if resource_captures.length() > 0:
		compiler_task_capture_error(context, task_label, "scoped resource", resource_captures)
	else if source_captures.length() > 0:
		compiler_task_capture_error(context, task_label, "resource source value", source_captures)
	else if derived_captures.length() > 0:
		compiler_task_capture_error(
			context,
			task_label,
			"scoped resource-derived value",
			derived_captures,
		)
	else if stream_captures.length() > 0:
		compiler_task_capture_error(context, task_label, "one-shot stream value", stream_captures)
	else if mutable_captures.length() > 0:
		compiler_task_capture_error(context, task_label, "mutable variable", mutable_captures)
	else:
		compiler_infer_context_copy(context)


private pure func compiler_check_concurrent_block_task_rules(
	context: CompilerInferContext,
	body: ParsedExpr,
) -> CompilerInferContext:
	match body:
		ParsedBlockExpr(items, _):
			binding_names = compiler_concurrent_binding_names(items)
			var next_context = compiler_check_duplicate_concurrent_bindings(context, items)

			for item in items:
				match (
					compiler_concurrent_binding_name(item),
					compiler_concurrent_binding_value(item),
				):
					(Some(name), Some(value)):
						sibling_context = compiler_check_concurrent_sibling_binding_refs(
							next_context,
							binding_names,
							name,
							value,
						)
						next_context = compiler_check_task_captures(
							sibling_context,
							"concurrent task",
							[],
							value,
						)
					_:
						void

			next_context
		_:
			compiler_infer_context_copy(context)


private pure func compiler_skip_concurrent_body_inference(
	params_context: CompilerInferContext,
	checked_context: CompilerInferContext,
) -> Bool:
	checked_context.state.errors.length() > params_context.state.errors.length()


private pure func compiler_type_concurrency_error() -> CompilerType:
	CompilerNamedType("ConcurrencyError", [])


private pure func compiler_type_result(
	ok_type: CompilerType,
	error_type: CompilerType,
) -> CompilerType:
	CompilerNamedType(
		"Result",
		[compiler_type_copy(ok_type), compiler_type_copy(error_type)],
	)


private pure func compiler_type_concurrent_result(value_type: CompilerType) -> CompilerType:
	compiler_type_result(value_type, compiler_type_concurrency_error())


private pure func compiler_concurrent_annotation_task_value_type(
	context: CompilerInferContext,
	annotation_type: Option[CompilerType],
) -> Option[CompilerType]:
	match annotation_type:
		Some(typ):
			resolved = compiler_env_resolve_alias(context.state.env, typ)

			match resolved:
				CompilerNamedType(name, args):
					if name == "Result" and args.length() == 2:
						match args.get(0):
							Some(value_type):
								Some(compiler_type_copy(value_type))
							None:
								None
					else:
						None
				_:
					None
		None:
			None


private pure func compiler_concurrent_binding_annotation_context(
	context: CompilerInferContext,
	annotation_type: Option[CompilerType],
	result_type: CompilerType,
) -> CompilerInferContext:
	match annotation_type:
		Some(typ):
			resolved = compiler_env_resolve_alias(context.state.env, typ)
			type_params = compiler_env_get_type_params(context.state.env)

			if compiler_types_compatible_with_params(type_params, resolved, result_type):
				compiler_infer_context_copy(context)
			else:
				compiler_infer_error(
					context,
					"Type annotation `" + compiler_type_to_string(
						resolved,
					) + "` does not match concurrent result type `" + compiler_type_to_string(
						result_type,
					) + "`",
				)
		None:
			compiler_infer_context_copy(context)


private pure func compiler_infer_concurrent_binding_value_context(
	context: CompilerInferContext,
	annotation_type: Option[CompilerType],
) -> CompilerInferContext:
	match compiler_concurrent_annotation_task_value_type(context, annotation_type):
		Some(value_type):
			compiler_infer_with_expected_value_slot(
				context,
				value_type,
				CompilerExpectedArgumentSlot,
			)
		None:
			compiler_infer_without_expected(context)


private pure func compiler_add_concurrent_result_binding(
	env: CompilerEnv,
	name: ParsedIdentifier,
	result_type: CompilerType,
) -> CompilerEnv:
	if name.text == "_":
		env
	else:
		compiler_env_add_var_with_details(
			env,
			name.text,
			compiler_type_copy(result_type),
			Some(compiler_type_copy(result_type)),
			CompilerImmutableBinding,
			CompilerLetBinding,
			compiler_unrefined_binding(),
		)


record CompilerInferConcurrentBindingsResult {
	context: CompilerInferContext,
	bindings: List[CompilerTypedConcurrentBinding]
}


private pure func compiler_infer_concurrent_bindings_result(
	context: CompilerInferContext,
	bindings: List[CompilerTypedConcurrentBinding],
) -> CompilerInferConcurrentBindingsResult:
	{
		context = compiler_infer_context_copy(context),
		bindings = bindings
	}


private pure func compiler_empty_typed_concurrent_bindings_result(
	context: CompilerInferContext,
) -> CompilerInferConcurrentBindingsResult:
	compiler_infer_concurrent_bindings_result(context, [])


private pure func compiler_infer_concurrent_bindings_from_items(
	context: CompilerInferContext,
	items: List[ParsedExpr],
	index: Int,
	base_env: CompilerEnv,
	typed_bindings: List[CompilerTypedConcurrentBinding],
) -> CompilerInferConcurrentBindingsResult:
	if index >= items.length():
		compiler_infer_concurrent_bindings_result(context, typed_bindings)
	else:
		match items.get(index):
			Some(item):
				match (
					compiler_concurrent_binding_identifier(item),
					compiler_concurrent_binding_value(item),
				):
					(Some(name), Some(value)):
						annotation_type = compiler_concurrent_binding_annotation(
							item,
						).map(compiler_type_from_parsed_type_expr)
						base_state = compiler_typecheck_state_with_env(context.state, base_env)
						base_context = compiler_infer_context_with_state(context, base_state)

						declared_context = if (
							name.text == "_"
							or not compiler_env_lookup_in_current_scope(
								base_env,
								name.text,
							).is_some()
						):
							base_context
						else:
							compiler_infer_error(
								base_context,
								"Cannot redeclare `" + name.text + "` in concurrent block",
							)

						value_context = compiler_infer_concurrent_binding_value_context(
							declared_context,
							annotation_type,
						)
						value_result = compiler_infer_expr(value_context, value)
						value_type = compiler_typed_expr_value_type(value_result.expr)
						result_type = compiler_type_concurrent_result(value_type)
						value_state = compiler_typecheck_state_with_env(
							value_result.context.state,
							base_env,
						)
						value_done_context = compiler_infer_context_with_state(context, value_state)
						checked_context = compiler_concurrent_binding_annotation_context(
							value_done_context,
							annotation_type,
							result_type,
						)
						result_env = compiler_add_concurrent_result_binding(
							context.state.env,
							name,
							result_type,
						)
						next_state = compiler_typecheck_state_with_env(
							checked_context.state,
							result_env,
						)
						next_context = compiler_infer_context_with_state(context, next_state)
						typed: CompilerTypedConcurrentBinding = {
							name = name,
							annotation = compiler_optional_type_copy(annotation_type),
							value = value_result.expr,
							span = compiler_concurrent_binding_span(item),
							info = compiler_inferred_info(next_context, result_type)
						}
						compiler_infer_concurrent_bindings_from_items(
							next_context,
							items,
							index + 1,
							base_env,
							typed_bindings.append(typed),
						)
					_:
						compiler_empty_typed_concurrent_bindings_result(context)
			None:
				compiler_empty_typed_concurrent_bindings_result(context)


private pure func compiler_infer_concurrent_block_bindings(
	context: CompilerInferContext,
	body: ParsedExpr,
) -> CompilerInferConcurrentBindingsResult:
	match body:
		ParsedBlockExpr(items, _):
			base_env = context.state.env
			compiler_infer_concurrent_bindings_from_items(context, items, 0, base_env, [])
		_:
			compiler_empty_typed_concurrent_bindings_result(context)


private pure func compiler_infer_concurrent_block_expr(
	context: CompilerInferContext,
	params: List[ParsedConcurrentParam],
	body: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	params_result = compiler_infer_concurrent_params(
		compiler_infer_without_expected(context),
		params,
	)
	checked_context = compiler_check_concurrent_body_shape(params_result.context, body)
	task_context = compiler_check_concurrent_block_task_rules(checked_context, body)

	bindings_result = if compiler_skip_concurrent_body_inference(
		params_result.context,
		task_context,
	):
		compiler_empty_typed_concurrent_bindings_result(task_context)
	else:
		compiler_infer_concurrent_block_bindings(
			compiler_infer_without_expected(task_context),
			body,
		)

	result_context = compiler_infer_context_with_state(context, bindings_result.context.state)
	typed = CompilerTypedConcurrentBlockExpr(
		params_result.params,
		bindings_result.bindings,
		span,
		compiler_inferred_info(result_context, compiler_type_void()),
	)

	compiler_infer_result(result_context, typed)


private pure func compiler_infer_detach_expr(
	context: CompilerInferContext,
	body: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	capture_context = compiler_check_task_captures(context, "detach", [], body)
	body_result = compiler_infer_expr(compiler_infer_without_expected(capture_context), body)
	result_context = compiler_infer_context_with_state(context, body_result.context.state)
	typed = CompilerTypedDetachExpr(
		body_result.expr,
		span,
		compiler_inferred_info(result_context, compiler_type_void()),
	)

	compiler_infer_result(result_context, typed)


private pure func compiler_type_contains_resource(
	context: CompilerInferContext,
	typ: CompilerType,
) -> Bool:
	resolved = compiler_env_resolve_alias(context.state.env, typ)

	match resolved:
		CompilerNamedType(name, args):
			(
				compiler_typecheck_state_has_known_resource_type_name(context.state, name)
				or compiler_env_get_type_contains_resource(context.state.env, name)
				or args.any(func(arg): compiler_type_contains_resource(context, arg))
			)
		CompilerArrayType(element, dims):
			(
				compiler_type_contains_resource(context, element)
				or dims.any(func(dim): compiler_type_contains_resource(context, dim))
			)
		CompilerFunctionType(_, params, return_type):
			(
				params.any(func(param): compiler_type_contains_resource(context, param))
				or compiler_type_contains_resource(context, return_type)
			)
		CompilerTupleType(elements):
			elements.any(func(element): compiler_type_contains_resource(context, element))
		CompilerRangeType(inner):
			compiler_type_contains_resource(context, inner)
		CompilerDimOpType(_, left, right):
			(
				compiler_type_contains_resource(context, left)
				or compiler_type_contains_resource(context, right)
			)
		_:
			False


private pure func compiler_is_resource_type(
	context: CompilerInferContext,
	typ: CompilerType,
) -> Bool:
	resolved = compiler_env_resolve_alias(context.state.env, typ)

	match resolved:
		CompilerNamedType(name, args):
			(
				args.length() == 0
				and compiler_typecheck_state_has_known_resource_type_name(context.state, name)
			)
		_:
			False


private pure func compiler_resource_binding_type_display(typ: CompilerType) -> String:
	match typ:
		CompilerConstIntType(_):
			"Int"
		_:
			compiler_type_to_string(typ)


private pure func compiler_check_with_binding_resource_type(
	context: CompilerInferContext,
	typ: CompilerType,
) -> CompilerInferContext:
	if compiler_is_resource_type(context, typ):
		compiler_infer_context_copy(context)
	else:
		compiler_infer_error(
			context,
			"with binding requires a resource type, got " + compiler_resource_binding_type_display(
				typ,
			),
		)


private pure func compiler_check_with_binding_annotation(
	context: CompilerInferContext,
	annotation_type: Option[CompilerType],
	acquisition_type: CompilerType,
) -> CompilerInferContext:
	match annotation_type:
		Some(annotated_type):
			if compiler_types_equal(annotated_type, acquisition_type):
				compiler_infer_context_copy(context)
			else:
				compiler_infer_error(
					context,
					"with binding annotation `" + compiler_type_to_string(
						annotated_type,
					) + "` does not match acquisition type `" + compiler_type_to_string(
						acquisition_type,
					) + "`",
				)
		None:
			compiler_infer_context_copy(context)


private pure func compiler_with_binding_type(
	annotation_type: Option[CompilerType],
	acquisition_type: CompilerType,
) -> CompilerType:
	match annotation_type:
		Some(annotated_type):
			compiler_type_copy(annotated_type)
		None:
			compiler_type_copy(acquisition_type)


private pure func compiler_check_with_body_resource_escape(
	context: CompilerInferContext,
	body_type: CompilerType,
	body: CompilerTypedExpr,
) -> CompilerInferContext:
	if compiler_type_contains_resource(context, body_type):
		compiler_infer_error(context, "scoped resource values cannot escape a with block")
	else:
		refs = compiler_typed_expr_resource_dependency_refs(context, body)

		if refs.length() > 0:
			compiler_infer_error(
				context,
				"scoped resource-derived values cannot escape a with block: " + refs.join(", "),
			)
		else:
			compiler_infer_context_copy(context)


private pure func compiler_dependent_resource_owner_name(name: String) -> String:
	if name == "_":
		"current dependent resource"
	else:
		name


private pure func compiler_unavailable_parent_resource_names(
	context: CompilerInferContext,
	acquisition: CompilerTypedExpr,
) -> List[String]:
	var result: List[String] = []

	for name in compiler_typed_expr_resource_dependency_refs(context, acquisition):
		if (
			compiler_env_is_scoped_resource_var(context.state.env, name)
			and not result.contains(name)
		):
			result = result.append(name)

	result


private pure func compiler_shadow_parent_resource_unavailable(
	env: CompilerEnv,
	owner: String,
	name: String,
) -> CompilerEnv:
	match compiler_env_lookup(env, name):
		Some(symbol):
			match symbol.kind:
				CompilerVarSymbolKind(var_symbol):
					if compiler_env_is_scoped_resource_var(env, name):
						compiler_env_add_var_with_details(
							env,
							name,
							var_symbol.var_type,
							var_symbol.source_type,
							var_symbol.mutability,
							CompilerScopedResourceUnavailable(owner),
							var_symbol.refinement,
						)
					else:
						env
				_:
					env
		None:
			env


private pure func compiler_typed_with_error_map(
	mapper: ParsedWithErrorMap,
	value: CompilerTypedExpr,
) -> CompilerTypedWithErrorMap:
	{
		name = mapper.name,
		value = value,
		span = mapper.span
	}


private pure func compiler_infer_with_try_binding_result(
	context: CompilerInferContext,
	inner_type: CompilerType,
	error_map: Option[CompilerTypedWithErrorMap],
) -> CompilerInferWithTryBindingResult:
	{
		context = compiler_infer_context_copy(context),
		inner_type = compiler_type_copy(inner_type),
		error_map = error_map
	}


private pure func compiler_infer_with_error_mapper(
	context: CompilerInferContext,
	mapper: ParsedWithErrorMap,
	actual_error_type: CompilerType,
	expected_error_type: CompilerType,
) -> CompilerInferWithTryBindingResult:
	mapper_env = compiler_env_push_scope(context.state.env)
	bound_env = compiler_env_add_var_with_details(
		mapper_env,
		mapper.name.text,
		compiler_type_copy(actual_error_type),
		Some(compiler_type_copy(actual_error_type)),
		CompilerImmutableBinding,
		CompilerLetBinding,
		compiler_unrefined_binding(),
	)
	mapper_state = compiler_typecheck_state_with_env(context.state, bound_env)
	mapper_context = compiler_infer_with_expected_value_slot(
		compiler_infer_context_with_state(context, mapper_state),
		compiler_type_copy(expected_error_type),
		CompilerExpectedArgumentSlot,
	)
	mapper_result = compiler_infer_expr(mapper_context, mapper.value)
	mapper_type = compiler_typed_expr_value_type(mapper_result.expr)

	checked_context = if compiler_types_equal(mapper_type, expected_error_type):
		compiler_infer_context_copy(mapper_result.context)
	else:
		compiler_infer_error(
			mapper_result.context,
			"with ?= error mapper must return " + compiler_type_to_string(
				expected_error_type,
			) + ", got " + compiler_type_to_string(mapper_type),
		)

	outer_env = compiler_env_pop_scope(checked_context.state.env)
	outer_state = compiler_typecheck_state_with_env(checked_context.state, outer_env)
	result_context = compiler_infer_context_with_state(context, outer_state)

	compiler_infer_with_try_binding_result(
		result_context,
		compiler_type_void(),
		Some(compiler_typed_with_error_map(mapper, mapper_result.expr)),
	)


private pure func compiler_infer_with_try_binding(
	context: CompilerInferContext,
	rhs_type: CompilerType,
	error_map: Option[ParsedWithErrorMap],
) -> CompilerInferWithTryBindingResult:
	expected_carrier = match context.expected_type:
		Some(expected_type):
			compiler_question_bind_carrier(context, expected_type)
		None:
			CompilerQuestionBindNonCarrier

	rhs_carrier = compiler_question_bind_carrier(context, rhs_type)

	match (expected_carrier, rhs_carrier, error_map):
		(CompilerQuestionBindOptionCarrier(_), CompilerQuestionBindOptionCarrier(inner_type), None):
			compiler_infer_with_try_binding_result(context, inner_type, None)
		(CompilerQuestionBindOptionCarrier(_), CompilerQuestionBindOptionCarrier(_), Some(_)):
			next = compiler_infer_error(
				context,
				"with ?= error mapping requires the enclosing block to return Result[T, E]",
			)
			compiler_infer_with_try_binding_result(next, compiler_type_void(), None)
		(CompilerQuestionBindOptionCarrier(_), CompilerQuestionBindResultCarrier(_, _), Some(_)):
			next = compiler_infer_error(
				context,
				"with ?= error mapping requires the enclosing block to return Result[T, E]",
			)
			compiler_infer_with_try_binding_result(next, compiler_type_void(), None)
		(CompilerQuestionBindOptionCarrier(_), CompilerQuestionBindResultCarrier(_, _), None):
			next = compiler_infer_error(
				context,
				(
					"Cannot use Result ?= in a with binding inside a block returning Option. Convert "
					+ "the Result to Option or return Result from the enclosing function"
				),
			)
			compiler_infer_with_try_binding_result(next, compiler_type_void(), None)
		(CompilerQuestionBindResultCarrier(_, expected_error_type), CompilerQuestionBindResultCarrier(inner_type, actual_error_type), None):
			if compiler_types_equal(expected_error_type, actual_error_type):
				compiler_infer_with_try_binding_result(context, inner_type, None)
			else:
				next = compiler_infer_error(
					context,
					"Incompatible error type for with ?=: enclosing block returns Result[..., " + compiler_type_to_string(
						expected_error_type,
					) + "], but expression returns Result[..., " + compiler_type_to_string(
						actual_error_type,
					) + "]",
				)
				compiler_infer_with_try_binding_result(next, compiler_type_void(), None)
		(CompilerQuestionBindResultCarrier(_, expected_error_type), CompilerQuestionBindResultCarrier(inner_type, actual_error_type), Some(mapper)):
			mapper_result = compiler_infer_with_error_mapper(
				context,
				mapper,
				actual_error_type,
				expected_error_type,
			)
			compiler_infer_with_try_binding_result(
				mapper_result.context,
				inner_type,
				mapper_result.error_map,
			)
		(CompilerQuestionBindResultCarrier(_, _), CompilerQuestionBindOptionCarrier(_), Some(_)):
			next = compiler_infer_error(
				context,
				"with ?= error mapping requires a Result acquisition expression",
			)
			compiler_infer_with_try_binding_result(next, compiler_type_void(), None)
		(CompilerQuestionBindResultCarrier(_, _), CompilerQuestionBindOptionCarrier(_), None):
			next = compiler_infer_error(
				context,
				(
					"Cannot use Option ?= in a with binding inside a block returning Result. Convert "
					+ "the Option to Result with to_result(...) or return Option from the enclosing "
					+ "function"
				),
			)
			compiler_infer_with_try_binding_result(next, compiler_type_void(), None)
		(CompilerQuestionBindNonCarrier, CompilerQuestionBindOptionCarrier(_), Some(_)):
			next = compiler_infer_error(
				context,
				"with ?= error mapping requires an enclosing block returning Result[T, E]",
			)
			compiler_infer_with_try_binding_result(next, compiler_type_void(), None)
		(CompilerQuestionBindNonCarrier, CompilerQuestionBindResultCarrier(_, _), Some(_)):
			next = compiler_infer_error(
				context,
				"with ?= error mapping requires an enclosing block returning Result[T, E]",
			)
			compiler_infer_with_try_binding_result(next, compiler_type_void(), None)
		(CompilerQuestionBindNonCarrier, CompilerQuestionBindOptionCarrier(_), None):
			next = match context.expected_type:
				Some(expected_type):
					compiler_infer_error(
						context,
						(
							"with ?= requires the enclosing block to return the same carrier as the "
							+ "acquisition expression; enclosing block returns "
						) + compiler_type_to_string(expected_type),
					)
				None:
					compiler_infer_error(
						context,
						"with ?= requires an enclosing block returning Option[T] or Result[T, E]",
					)

			compiler_infer_with_try_binding_result(next, compiler_type_void(), None)
		(CompilerQuestionBindNonCarrier, CompilerQuestionBindResultCarrier(_, _), None):
			next = match context.expected_type:
				Some(expected_type):
					compiler_infer_error(
						context,
						(
							"with ?= requires the enclosing block to return the same carrier as the "
							+ "acquisition expression; enclosing block returns "
						) + compiler_type_to_string(expected_type),
					)
				None:
					compiler_infer_error(
						context,
						"with ?= requires an enclosing block returning Option[T] or Result[T, E]",
					)

			compiler_infer_with_try_binding_result(next, compiler_type_void(), None)
		(_, CompilerQuestionBindNonCarrier, Some(_)):
			next = compiler_infer_error(
				context,
				"Cannot use `?=` error mapping in a with binding on type `" + compiler_type_to_string(
					rhs_type,
				) + "` — only Result supports error mapping",
			)
			compiler_infer_with_try_binding_result(next, compiler_type_void(), None)
		(_, CompilerQuestionBindNonCarrier, None):
			next = compiler_infer_error(
				context,
				"Cannot use `?=` in a with binding on type `" + compiler_type_to_string(
					rhs_type,
				) + "` — only Option and Result support ?= bindings",
			)
			compiler_infer_with_try_binding_result(next, compiler_type_void(), None)


private pure func compiler_infer_with_body(
	context: CompilerInferContext,
	name: ParsedIdentifier,
	binding_type: CompilerType,
	unavailable_parents: List[String],
	body: ParsedExpr,
) -> CompilerInferResult:
	body_env = compiler_env_push_scope(context.state.env)
	owner = compiler_dependent_resource_owner_name(name.text)
	var scoped_env = body_env

	for parent in unavailable_parents:
		scoped_env = compiler_shadow_parent_resource_unavailable(scoped_env, owner, parent)

	bound_env = if name.text == "_":
		scoped_env
	else:
		compiler_env_add_var_with_details(
			scoped_env,
			name.text,
			compiler_type_copy(binding_type),
			Some(compiler_type_copy(binding_type)),
			CompilerImmutableBinding,
			CompilerScopedResource,
			compiler_unrefined_binding(),
		)

	body_state = compiler_typecheck_state_with_env(context.state, bound_env)
	body_context = compiler_infer_context_with_state(context, body_state)
	body_result = compiler_infer_expr(body_context, body)
	body_type = compiler_typed_expr_value_type(body_result.expr)

	checked_context = if body_result.context.state.errors.length() == body_context.state.errors.length():
		compiler_check_with_body_resource_escape(body_result.context, body_type, body_result.expr)
	else:
		compiler_infer_context_copy(body_result.context)

	outer_env = compiler_env_pop_scope(checked_context.state.env)
	outer_state = compiler_typecheck_state_with_env(checked_context.state, outer_env)
	result_context = compiler_infer_context_with_state(context, outer_state)

	compiler_infer_result(result_context, body_result.expr)


private pure func compiler_typed_with_binding(
	binding: ParsedWithBinding,
	annotation_type: Option[CompilerType],
	value: CompilerTypedExpr,
	error_map: Option[CompilerTypedWithErrorMap],
	cleanup_function: Option[String],
) -> CompilerTypedWithBinding:
	{
		name = binding.name,
		annotation = compiler_optional_type_copy(annotation_type),
		value = value,
		kind = binding.kind,
		error_map = error_map,
		cleanup_function = cleanup_function,
		span = binding.span
	}


private pure func compiler_with_cleanup_function(
	context: CompilerInferContext,
	binding_type: CompilerType,
) -> Option[String]:
	resolved_type = compiler_env_resolve_alias(context.state.env, binding_type)

	match resolved_type:
		CompilerNamedType(name, _):
			compiler_find_resource_cleanup(context.state.context, name)
		_:
			None


private pure func compiler_infer_with_expr(
	context: CompilerInferContext,
	binding: ParsedWithBinding,
	body: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	annotation_type = compiler_optional_question_bind_annotation_type(context, binding.type_expr)
	value_result = compiler_infer_expr(compiler_infer_without_expected(context), binding.value)
	acquisition_type = compiler_typed_expr_value_type(value_result.expr)
	value_context = compiler_infer_context_with_state(context, value_result.context.state)

	match binding.kind:
		ParsedWithPlainBinding:
			annotation_context = compiler_check_with_binding_annotation(
				value_context,
				annotation_type,
				acquisition_type,
			)
			binding_type = compiler_with_binding_type(annotation_type, acquisition_type)

			checked_context = if annotation_context.state.errors.length() == value_context.state.errors.length():
				compiler_check_with_binding_resource_type(annotation_context, binding_type)
			else:
				compiler_infer_context_copy(annotation_context)

			unavailable_parents = compiler_unavailable_parent_resource_names(
				checked_context,
				value_result.expr,
			)
			body_result = compiler_infer_with_body(
				checked_context,
				binding.name,
				binding_type,
				unavailable_parents,
				body,
			)
			result_context = compiler_infer_context_with_state(context, body_result.context.state)
			typed = CompilerTypedWithExpr(
				compiler_typed_with_binding(
					binding,
					annotation_type,
					value_result.expr,
					None,
					compiler_with_cleanup_function(checked_context, binding_type),
				),
				body_result.expr,
				span,
				compiler_typed_expr_info(body_result.expr),
			)
			compiler_infer_result(result_context, typed)
		ParsedWithTryBinding:
			try_result = compiler_infer_with_try_binding(
				value_context,
				acquisition_type,
				binding.error_map,
			)

			binding_type = if try_result.context.state.errors.length() == value_context.state.errors.length():
				compiler_with_binding_type(annotation_type, try_result.inner_type)
			else:
				compiler_type_void()

			checked_context = if try_result.context.state.errors.length() == value_context.state.errors.length():
				annotation_context = compiler_check_with_binding_annotation(
					try_result.context,
					annotation_type,
					try_result.inner_type,
				)

				if annotation_context.state.errors.length() == try_result.context.state.errors.length():
					compiler_check_with_binding_resource_type(annotation_context, binding_type)
				else:
					compiler_infer_context_copy(annotation_context)
			else:
				compiler_infer_context_copy(try_result.context)

			unavailable_parents = compiler_unavailable_parent_resource_names(
				checked_context,
				value_result.expr,
			)
			body_result = compiler_infer_with_body(
				checked_context,
				binding.name,
				binding_type,
				unavailable_parents,
				body,
			)
			result_context = compiler_infer_context_with_state(context, body_result.context.state)
			typed = CompilerTypedWithExpr(
				compiler_typed_with_binding(
					binding,
					annotation_type,
					value_result.expr,
					try_result.error_map,
					compiler_with_cleanup_function(checked_context, binding_type),
				),
				body_result.expr,
				span,
				compiler_typed_expr_info(body_result.expr),
			)
			compiler_infer_result(result_context, typed)


private pure func compiler_int_type_ok(typ: CompilerType) -> Bool:
	match typ:
		CompilerConstIntType(_):
			True
		CompilerNamedType(name, args):
			name == "Int" and args.length() == 0
		_:
			False


private pure func compiler_timeout_type_ok(timeout_type: CompilerType) -> Bool:
	match timeout_type:
		CompilerConstIntType(_):
			True
		CompilerNamedType(name, args):
			(name == "Int" or name == "Duration") and args.length() == 0
		_:
			False


private pure func compiler_concurrent_for_param_allowed(name: String) -> Bool:
	name == CONCURRENT_FOR_PARAM_LIMIT or name == CONCURRENT_PARAM_TIMEOUT


private pure func compiler_check_concurrent_for_param_names(
	context: CompilerInferContext,
	params: List[ParsedConcurrentParam],
) -> CompilerInferContext:
	var next_context = compiler_infer_context_copy(context)
	var seen: List[String] = []

	for param in params:
		name = param.name.text

		if not compiler_concurrent_for_param_allowed(name):
			next_context = compiler_infer_error(
				next_context,
				"Unknown `for ... concurrently` parameter `" + name + "`",
			)
		else if seen.contains(name):
			next_context = compiler_infer_error(
				next_context,
				"Duplicate `for ... concurrently` parameter `" + name + "`",
			)
		else:
			seen = seen.append(name)

	next_context


private pure func compiler_check_concurrent_for_param_type(
	context: CompilerInferContext,
	name: String,
	value_type: CompilerType,
) -> CompilerInferContext:
	if name == CONCURRENT_FOR_PARAM_LIMIT:
		if compiler_int_type_ok(value_type):
			compiler_infer_context_copy(context)
		else:
			compiler_infer_error(context, "`for ... concurrently(...)` limit must be Int")
	else if name == CONCURRENT_PARAM_TIMEOUT:
		if compiler_timeout_type_ok(value_type):
			compiler_infer_context_copy(context)
		else:
			compiler_infer_error(
				context,
				"`for ... concurrently(...)` timeout must be Int milliseconds or Duration",
			)
	else:
		compiler_infer_context_copy(context)


private pure func compiler_infer_concurrent_for_params(
	context: CompilerInferContext,
	params: List[ParsedConcurrentParam],
) -> CompilerInferConcurrentParamsResult:
	var next_context = compiler_check_concurrent_for_param_names(context, params)
	var typed_params: List[CompilerTypedConcurrentParam] = []

	for param in params:
		value_result = compiler_infer_expr(
			compiler_infer_without_expected(next_context),
			param.value,
		)
		value_type = compiler_typed_expr_value_type(value_result.expr)
		checked_context = compiler_check_concurrent_for_param_type(
			value_result.context,
			param.name.text,
			value_type,
		)
		typed_params = typed_params.append({
			name = param.name,
			value = value_result.expr,
			span = param.span,
		})
		next_context = compiler_infer_context_with_state(next_context, checked_context.state)

	compiler_infer_concurrent_params_result(next_context, typed_params)


private pure func compiler_concurrent_for_iterable_type_result(
	context: CompilerInferContext,
	element_type: Option[CompilerType],
) -> CompilerConcurrentForIterableTypeResult:
	{
		context = compiler_infer_context_copy(context),
		element_type = element_type.map(compiler_type_copy)
	}


private pure func compiler_concurrent_for_iterable_element_type(
	context: CompilerInferContext,
	iterable_type: CompilerType,
) -> CompilerConcurrentForIterableTypeResult:
	match iterable_type:
		CompilerNamedType(name, args):
			if name == "List" and args.length() == 1:
				compiler_concurrent_for_iterable_type_result(
					context,
					args.get(0),
				)
			else if compiler_is_resource_source_type_name(name) and args.length() == 2:
				compiler_concurrent_for_iterable_type_result(
					context,
					args.get(0),
				)
			else:
				next = compiler_infer_error(
					context,
					"`for ... concurrently` requires a List or ResourceSource, got " + compiler_type_to_string(
						iterable_type,
					),
				)
				compiler_concurrent_for_iterable_type_result(next, None)
		_:
			next = compiler_infer_error(
				context,
				"`for ... concurrently` requires a List or ResourceSource, got " + compiler_type_to_string(
					iterable_type,
				),
			)
			compiler_concurrent_for_iterable_type_result(next, None)


private pure func compiler_check_concurrent_for_statement_context(
	context: CompilerInferContext,
) -> CompilerInferContext:
	match context.expected_type:
		Some(expected):
			if compiler_named_value_type_is(expected, "Void"):
				compiler_infer_context_copy(context)
			else:
				compiler_infer_error(
					context,
					"`for ... concurrently(...)` is statement-only and does not collect results",
				)
		None:
			compiler_infer_context_copy(context)


private pure func compiler_infer_concurrent_for_body(
	context: CompilerInferContext,
	name: ParsedIdentifier,
	element_type: CompilerType,
	binding_origin: CompilerVarOrigin,
	body: ParsedExpr,
) -> CompilerInferResult:
	loop_env = compiler_env_push_scope(context.state.env)

	bound_env = if name.text == "_":
		loop_env
	else:
		compiler_env_add_var_with_details(
			loop_env,
			name.text,
			compiler_type_copy(element_type),
			Some(compiler_type_copy(element_type)),
			CompilerImmutableBinding,
			binding_origin,
			compiler_unrefined_binding(),
		)

	loop_state = compiler_typecheck_state_with_env(context.state, bound_env)
	loop_context = compiler_infer_inside_loop(
		compiler_infer_context_with_state(
			context,
			loop_state,
		),
	)
	body_result = compiler_infer_expr(compiler_infer_without_expected(loop_context), body)
	outer_env = compiler_env_pop_scope(body_result.context.state.env)
	outer_state = compiler_typecheck_state_with_env(body_result.context.state, outer_env)
	result_context = compiler_infer_context_with_state(context, outer_state)

	compiler_infer_result(result_context, body_result.expr)


private pure func compiler_infer_concurrent_for_expr(
	context: CompilerInferContext,
	name: ParsedIdentifier,
	iterable: ParsedExpr,
	params: List[ParsedConcurrentParam],
	body: ParsedExpr,
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	statement_context = compiler_check_concurrent_for_statement_context(context)
	params_result = compiler_infer_concurrent_for_params(
		compiler_infer_without_expected(statement_context),
		params,
	)
	iterable_result = compiler_infer_expr(
		compiler_infer_without_expected(params_result.context),
		iterable,
	)
	iterable_type = compiler_typed_expr_semantic_type(iterable_result.expr)
	element_result = compiler_concurrent_for_iterable_element_type(
		iterable_result.context,
		iterable_type,
	)

	after_iter_context = if name.text == "_":
		compiler_infer_context_copy(element_result.context)
	else if compiler_env_lookup_in_current_scope(
		element_result.context.state.env,
		name.text,
	).is_some():
		compiler_for_redeclaration_error(element_result.context, name.text)
	else:
		compiler_infer_context_copy(element_result.context)

	element_type = match element_result.element_type:
		Some(typ):
			compiler_type_copy(typ)
		None:
			compiler_type_void()

	binding_origin = compiler_iterable_binding_origin(iterable_type)

	task_bound_names: List[String] = if name.text == "_":
		[]
	else:
		[name.text]

	capture_context = compiler_check_task_captures(
		after_iter_context,
		"`for ... concurrently` body",
		task_bound_names,
		body,
	)
	body_result = compiler_infer_concurrent_for_body(
		capture_context,
		name,
		element_type,
		binding_origin,
		body,
	)
	result_context = compiler_infer_context_with_state(context, body_result.context.state)
	typed = CompilerTypedConcurrentForExpr(
		name,
		iterable_result.expr,
		params_result.params,
		body_result.expr,
		span,
		compiler_inferred_info(result_context, compiler_type_void()),
	)

	compiler_infer_result(result_context, typed)


private pure func compiler_select_channel_type_result(
	context: CompilerInferContext,
	element_type: Option[CompilerType],
) -> CompilerSelectChannelTypeResult:
	{
		context = compiler_infer_context_copy(context),
		element_type = element_type.map(compiler_type_copy)
	}


private pure func compiler_select_channel_element_type(
	context: CompilerInferContext,
	channel_type: CompilerType,
	arm_label: String,
) -> CompilerSelectChannelTypeResult:
	match channel_type:
		CompilerNamedType(name, args):
			if name == "Channel" and args.length() == 1:
				compiler_select_channel_type_result(
					context,
					args.get(0),
				)
			else:
				next = compiler_infer_error(
					context,
					"select " + arm_label + " arm requires Channel[T], got " + compiler_type_to_string(
						channel_type,
					),
				)
				compiler_select_channel_type_result(next, None)
		_:
			next = compiler_infer_error(
				context,
				"select " + arm_label + " arm requires Channel[T], got " + compiler_type_to_string(
					channel_type,
				),
			)
			compiler_select_channel_type_result(next, None)


private pure func compiler_check_select_timeout(
	context: CompilerInferContext,
	timeout_type: CompilerType,
) -> CompilerInferContext:
	if compiler_timeout_type_ok(timeout_type):
		compiler_infer_context_copy(context)
	else:
		compiler_infer_error(context, "select after timeout must be Int milliseconds or Duration")


private pure func compiler_check_select_statement_context(
	context: CompilerInferContext,
) -> CompilerInferContext:
	match context.expected_type:
		Some(expected):
			if compiler_named_value_type_is(expected, "Void"):
				compiler_infer_context_copy(context)
			else:
				compiler_infer_error(context, "`select:` is statement-only")
		None:
			compiler_infer_context_copy(context)


private pure func compiler_infer_select_arms_result(
	context: CompilerInferContext,
	arms: List[CompilerTypedSelectArm],
) -> CompilerInferSelectArmsResult:
	{
		context = compiler_infer_context_copy(context),
		arms = arms
	}


private pure func compiler_infer_select_arm_result(
	context: CompilerInferContext,
	arm: CompilerTypedSelectArm,
) -> CompilerInferSelectArmResult:
	{
		context = compiler_infer_context_copy(context),
		arm = arm
	}


private pure func compiler_infer_select_arm_body(
	context: CompilerInferContext,
	body: ParsedExpr,
	binding_name: Option[ParsedIdentifier],
	binding_type: Option[CompilerType],
) -> CompilerInferResult:
	var body_env = compiler_env_push_scope(context.state.env)

	match (binding_name, binding_type):
		(Some(name), Some(typ)):
			if name.text != "_":
				body_env = compiler_env_add_var_with_details(
					body_env,
					name.text,
					typ,
					Some(typ),
					CompilerImmutableBinding,
					CompilerMatchBinding,
					compiler_unrefined_binding(),
				)
			else:
				void
		_:
			void

	body_state = compiler_typecheck_state_with_env(context.state, body_env)
	body_context = compiler_infer_context_with_state(context, body_state)
	body_result = compiler_infer_expr(compiler_infer_without_expected(body_context), body)
	outer_env = compiler_env_pop_scope(body_result.context.state.env)
	outer_state = compiler_typecheck_state_with_env(body_result.context.state, outer_env)
	result_context = compiler_infer_context_with_state(context, outer_state)

	compiler_infer_result(result_context, body_result.expr)


private pure func compiler_infer_select_arm(
	context: CompilerInferContext,
	arm: ParsedSelectArm,
) -> CompilerInferSelectArmResult:
	match arm.kind:
		ParsedSelectReceiveArm(name, channel):
			channel_result = compiler_infer_expr(compiler_infer_without_expected(context), channel)
			channel_type = compiler_typed_expr_value_type(channel_result.expr)
			element_result = compiler_select_channel_element_type(
				channel_result.context,
				channel_type,
				"receive",
			)

			element_type = match element_result.element_type:
				Some(typ):
					typ
				None:
					compiler_type_void()

			body_result = compiler_infer_select_arm_body(
				element_result.context,
				arm.body,
				Some(name),
				Some(element_type),
			)
			typed_arm: CompilerTypedSelectArm = {
				kind = CompilerTypedSelectReceiveArm(name, element_type, channel_result.expr),
				body = body_result.expr,
				span = arm.span
			}
			compiler_infer_select_arm_result(body_result.context, typed_arm)
		ParsedSelectSealedArm(channel):
			channel_result = compiler_infer_expr(compiler_infer_without_expected(context), channel)
			channel_type = compiler_typed_expr_value_type(channel_result.expr)
			element_result = compiler_select_channel_element_type(
				channel_result.context,
				channel_type,
				"sealed",
			)

			element_type = match element_result.element_type:
				Some(typ):
					typ
				None:
					compiler_type_void()

			body_result = compiler_infer_select_arm_body(
				element_result.context,
				arm.body,
				None,
				None,
			)
			typed_arm: CompilerTypedSelectArm = {
				kind = CompilerTypedSelectSealedArm(element_type, channel_result.expr),
				body = body_result.expr,
				span = arm.span
			}
			compiler_infer_select_arm_result(body_result.context, typed_arm)
		ParsedSelectAfterArm(timeout):
			timeout_result = compiler_infer_expr(compiler_infer_without_expected(context), timeout)
			timeout_type = compiler_typed_expr_value_type(timeout_result.expr)
			checked_context = compiler_check_select_timeout(timeout_result.context, timeout_type)
			body_result = compiler_infer_select_arm_body(checked_context, arm.body, None, None)
			typed_arm: CompilerTypedSelectArm = {
				kind = CompilerTypedSelectAfterArm(timeout_result.expr),
				body = body_result.expr,
				span = arm.span
			}
			compiler_infer_select_arm_result(body_result.context, typed_arm)


private pure func compiler_infer_select_arms(
	context: CompilerInferContext,
	arms: List[ParsedSelectArm],
) -> CompilerInferSelectArmsResult:
	var next_context = compiler_infer_context_copy(context)
	var typed_arms: List[CompilerTypedSelectArm] = []

	for arm in arms:
		arm_result = compiler_infer_select_arm(next_context, arm)
		typed_arms = typed_arms.append(arm_result.arm)
		next_context = compiler_infer_context_with_state(next_context, arm_result.context.state)

	compiler_infer_select_arms_result(next_context, typed_arms)


private pure func compiler_infer_select_expr(
	context: CompilerInferContext,
	arms: List[ParsedSelectArm],
	span: CompilerSourceSpan,
) -> CompilerInferResult:
	statement_context = compiler_check_select_statement_context(context)

	checked_context = if arms.length() == 0:
		compiler_infer_error(statement_context, "select: block cannot be empty")
	else:
		compiler_infer_context_copy(statement_context)

	arms_result = compiler_infer_select_arms(compiler_infer_without_expected(checked_context), arms)
	result_context = compiler_infer_context_with_state(context, arms_result.context.state)
	typed = CompilerTypedSelectExpr(
		arms_result.arms,
		span,
		compiler_inferred_info(result_context, compiler_type_void()),
	)

	compiler_infer_result(result_context, typed)


private pure func compiler_unsupported_expr(
	context: CompilerInferContext,
	expr: ParsedExpr,
	label: String,
) -> CompilerInferResult:
	next = compiler_infer_error(context, "Blorp inference does not yet support " + label)
	compiler_infer_result(
		next,
		CompilerTypedUnsupportedExpr(
			label,
			parsed_expr_span(expr),
			compiler_inferred_info(next, compiler_type_void()),
		),
	)


pure func compiler_infer_expr(
	context: CompilerInferContext,
	expr: ParsedExpr,
) -> CompilerInferResult:
	match expr:
		ParsedNameExpr(name):
			compiler_infer_name_expr(context, name)
		ParsedIntLiteralExpr(text, span):
			compiler_literal_result(
				context,
				CompilerTypedIntLiteralExpr(
					text,
					span,
					compiler_inferred_info(
						context,
						CompilerConstIntType(compiler_parse_int_literal(text)),
					),
				),
			)
		ParsedFloatLiteralExpr(text, span):
			compiler_literal_result(
				context,
				CompilerTypedFloatLiteralExpr(
					text,
					span,
					compiler_inferred_info(context, compiler_type_float()),
				),
			)
		ParsedStringLiteralExpr(text, _, span):
			compiler_literal_result(
				context,
				CompilerTypedStringLiteralExpr(
					text,
					span,
					compiler_inferred_info(context, compiler_inferred_string_literal_type(context)),
				),
			)
		ParsedStringInterpolationExpr(text, raw, span):
			compiler_literal_result(
				context,
				CompilerTypedStringInterpolationExpr(
					text,
					raw,
					span,
					compiler_inferred_info(context, compiler_type_string()),
				),
			)
		ParsedStringInterpolationPartsExpr(parts, is_multiline, span):
			compiler_infer_string_interpolation_parts_expr(context, parts, is_multiline, span)
		ParsedBoolLiteralExpr(value, span):
			compiler_literal_result(
				context,
				CompilerTypedBoolLiteralExpr(
					value,
					span,
					compiler_inferred_info(context, compiler_type_bool()),
				),
			)
		ParsedCharLiteralExpr(value, span):
			compiler_literal_result(
				context,
				CompilerTypedCharLiteralExpr(
					value,
					span,
					compiler_inferred_info(context, compiler_type_char()),
				),
			)
		ParsedUnaryExpr(op, operand, span):
			compiler_infer_unary_expr(context, op, operand, span)
		ParsedBinaryExpr(op, left, right, span):
			compiler_infer_binary_expr(context, op, left, right, span)
		ParsedLogicalExpr(op, left, right, span):
			compiler_infer_logical_expr(context, op, left, right, span)
		ParsedCallExpr(callee, args, span):
			compiler_infer_call_expr(context, callee, args, span)
		ParsedLambdaExpr(is_pure, params, return_type, body, span):
			compiler_infer_lambda_expr(context, is_pure, params, return_type, body, span)
		ParsedFieldAccessExpr(receiver, field, span):
			compiler_infer_field_access_expr(context, receiver, field, span)
		ParsedSubscriptExpr(receiver, indices, span):
			compiler_infer_subscript_expr(context, receiver, indices, span)
		ParsedSubscriptAssignExpr(target, indices, value, span):
			compiler_infer_subscript_assign_expr(context, target, indices, value, span)
		ParsedTupleExpr(items, span):
			compiler_infer_tuple_expr(context, items, span)
		ParsedTupleDestructExpr(names, value, span):
			compiler_infer_tuple_destruct_expr(context, names, value, span)
		ParsedListExpr(items, span):
			compiler_infer_list_expr(context, items, span)
		ParsedVectorExpr(items, span):
			compiler_infer_vector_expr(context, items, span)
		ParsedDictExpr(entries, span):
			compiler_infer_dict_expr(context, entries, span)
		ParsedRecordExpr(fields, span):
			compiler_infer_record_expr(context, fields, span)
		ParsedRecordUpdateExpr(base, fields, span):
			compiler_infer_record_update_expr(context, base, fields, span)
		ParsedOpaqueIntoExpr(type_expr, inner, span):
			compiler_infer_opaque_conversion_expr(
				context,
				CompilerOpaqueIntoConversion,
				type_expr,
				inner,
				span,
			)
		ParsedOpaqueFromExpr(type_expr, inner, span):
			compiler_infer_opaque_conversion_expr(
				context,
				CompilerOpaqueFromConversion,
				type_expr,
				inner,
				span,
			)
		ParsedRangeExpr(start_expr, end_expr, span):
			compiler_infer_range_expr(context, start_expr, end_expr, span)
		ParsedIfExpr(condition, then_branch, else_branch, span):
			compiler_infer_if_expr(context, condition, then_branch, else_branch, span)
		ParsedMatchExpr(scrutinee, cases, span):
			compiler_infer_match_expr(context, scrutinee, cases, span)
		ParsedSelectExpr(arms, span):
			compiler_infer_select_expr(context, arms, span)
		ParsedWhileExpr(condition, body, span):
			compiler_infer_while_expr(context, condition, body, span)
		ParsedForExpr(binder, iterable, body, span):
			compiler_infer_for_expr(context, binder, iterable, body, span)
		ParsedBreakExpr(span):
			compiler_infer_break_expr(context, span)
		ParsedContinueExpr(span):
			compiler_infer_continue_expr(context, span)
		ParsedAssignExpr(name, value, span):
			compiler_infer_assign_expr(context, name, value, span)
		ParsedCompoundAssignExpr(name, op, value, span):
			compiler_infer_compound_assign_expr(context, name, op, value, span)
		ParsedAscriptionExpr(inner, type_expr, span):
			compiler_infer_ascription_expr(context, inner, type_expr, span)
		ParsedQuestionBindExpr(name, annotation, value, span):
			annotation_type = compiler_optional_question_bind_annotation_type(context, annotation)
			value_result = compiler_infer_expr(compiler_infer_without_expected(context), value)
			next = compiler_infer_error(
				value_result.context,
				"?= binding must be used as a statement in a result-producing block",
			)
			compiler_question_bind_error_result(
				next,
				name,
				annotation_type,
				value_result.expr,
				span,
			)
		ParsedBlockExpr(exprs, span):
			compiler_infer_block_expr(context, exprs, span)
		ParsedWithExpr(binding, body, span):
			compiler_infer_with_expr(context, binding, body, span)
		ParsedDebugBlockExpr(body, span):
			compiler_infer_debug_block_expr(context, body, span)
		ParsedConcurrentBlockExpr(params, body, span):
			compiler_infer_concurrent_block_expr(context, params, body, span)
		ParsedConcurrentForExpr(name, iterable, params, body, span):
			compiler_infer_concurrent_for_expr(context, name, iterable, params, body, span)
		ParsedDetachExpr(body, span):
			compiler_infer_detach_expr(context, body, span)
		ParsedVoidExpr(span):
			compiler_literal_result(
				context,
				CompilerTypedVoidExpr(
					span,
					compiler_inferred_info(context, compiler_type_void()),
				),
			)
		ParsedBuiltinExpr(name, span):
			compiler_literal_result(
				context,
				CompilerTypedBuiltinExpr(
					name,
					span,
					compiler_inferred_info(context, compiler_type_void()),
				),
			)
		ParsedFunctionDeclExpr(function_decl):
			next = compiler_infer_error(
				context,
				"Nested function declaration `" + function_decl.name.text + "` reached expression inference before source finalization",
			)
			compiler_infer_result(
				next,
				CompilerTypedUnsupportedExpr(
					"nested function declaration",
					function_decl.span,
					compiler_inferred_info(next, compiler_type_void()),
				),
			)
		ParsedVarDeclExpr(name, annotation, value, is_mutable, span):
			compiler_infer_var_decl_expr(context, name, annotation, value, is_mutable, span)
		ParsedMissingExpr(span):
			compiler_literal_result(
				context,
				CompilerTypedMissingExpr(
					span,
					compiler_inferred_info(context, compiler_type_void()),
				),
			)
		_:
			compiler_unsupported_expr(context, expr, "expression form")
