private pure func compiler_typed_with_binding_has_assignment_inside_debug_block(
	binding: CompilerTypedWithBinding,
) -> Bool:
	if compiler_typed_expr_has_assignment_inside_debug_block(binding.value):
		True
	else:
		match binding.error_map:
			Some(mapper):
				compiler_typed_expr_has_assignment_inside_debug_block(mapper.value)
			None:
				False


private pure func compiler_typed_interpolation_parts_have_assignment_inside_debug_block(
	parts: List[CompilerTypedStringInterpolationPart],
) -> Bool:
	var found: Bool = False

	for part in parts:
		match part:
			CompilerTypedInterpolationLiteral(_):
				void
			CompilerTypedInterpolationExpr(expr):
				if compiler_typed_expr_has_assignment_inside_debug_block(expr):
					found = True
					break

	found


private pure func compiler_typed_match_cases_have_assignment_inside_debug_block(
	cases: List[CompilerTypedMatchCase],
) -> Bool:
	var found: Bool = False

	for case in cases:
		if compiler_typed_expr_has_assignment_inside_debug_block(case.body):
			found = True
			break

	found


private pure func compiler_typed_select_arm_kind_has_assignment_inside_debug_block(
	kind: CompilerTypedSelectArmKind,
) -> Bool:
	match kind:
		CompilerTypedSelectReceiveArm(_, _, channel):
			compiler_typed_expr_has_assignment_inside_debug_block(channel)
		CompilerTypedSelectSealedArm(_, channel):
			compiler_typed_expr_has_assignment_inside_debug_block(channel)
		CompilerTypedSelectAfterArm(timeout):
			compiler_typed_expr_has_assignment_inside_debug_block(timeout)


private pure func compiler_typed_select_arms_have_assignment_inside_debug_block(
	arms: List[CompilerTypedSelectArm],
) -> Bool:
	var found: Bool = False

	for arm in arms:
		if (
			compiler_typed_select_arm_kind_has_assignment_inside_debug_block(arm.kind)
			or compiler_typed_expr_has_assignment_inside_debug_block(arm.body)
		):
			found = True
			break

	found


pure func compiler_typed_expr_has_debug_block_assignment(expr: CompilerTypedExpr) -> Bool:
	match expr:
		CompilerTypedDebugBlockExpr(body, _, _):
			compiler_typed_expr_has_assignment_inside_debug_block(body)
		CompilerTypedLambdaExpr(_, _, _, body, _, _):
			compiler_typed_expr_has_debug_block_assignment(body)
		CompilerTypedBlockExpr(items, _, _):
			compiler_typed_expr_list_has_debug_block_assignment(items)
		CompilerTypedConcurrentBlockExpr(params, bindings, _, _):
			(
				compiler_typed_concurrent_params_have_debug_block_assignment(params)
				or compiler_typed_concurrent_bindings_have_debug_block_assignment(bindings)
			)
		CompilerTypedConcurrentForExpr(_, iterable, params, body, _, _):
			(
				compiler_typed_expr_has_debug_block_assignment(iterable)
				or compiler_typed_concurrent_params_have_debug_block_assignment(params)
				or compiler_typed_expr_has_debug_block_assignment(body)
			)
		CompilerTypedWithExpr(binding, body, _, _):
			(
				compiler_typed_with_binding_has_debug_block_assignment(binding)
				or compiler_typed_expr_has_debug_block_assignment(body)
			)
		CompilerTypedDetachExpr(body, _, _):
			compiler_typed_expr_has_debug_block_assignment(body)
		CompilerTypedIfExpr(condition, then_branch, else_branch, _, _):
			if (
				compiler_typed_expr_has_debug_block_assignment(condition)
				or compiler_typed_expr_has_debug_block_assignment(then_branch)
			):
				True
			else:
				match else_branch:
					Some(branch):
						compiler_typed_expr_has_debug_block_assignment(branch)
					None:
						False
		CompilerTypedMatchExpr(scrutinee, cases, _, _):
			(
				compiler_typed_expr_has_debug_block_assignment(scrutinee)
				or compiler_typed_match_cases_have_debug_block_assignment(cases)
			)
		CompilerTypedSelectExpr(arms, _, _):
			compiler_typed_select_arms_have_debug_block_assignment(arms)
		CompilerTypedWhileExpr(condition, body, _, _):
			(
				compiler_typed_expr_has_debug_block_assignment(condition)
				or compiler_typed_expr_has_debug_block_assignment(body)
			)
		CompilerTypedForExpr(_, iterable, _, body, _, _):
			(
				compiler_typed_expr_has_debug_block_assignment(iterable)
				or compiler_typed_expr_has_debug_block_assignment(body)
			)
		_:
			False


