pure func compiler_typecheck_state_definition_index(
	state: CompilerTypecheckState,
) -> CompilerDefinitionIndex:
	compiler_definition_index_advance_to_env(
		compiler_typecheck_module_scope_index(state.module_scope),
		state.env,
	)


pure func compiler_typecheck_state_source_definition_bindings_for_name(
	state: CompilerTypecheckState,
	name: String,
) -> List[(CompilerSourceDefinitionKey, Int)]:
	compiler_definition_index_source_definition_bindings(
		compiler_typecheck_module_scope_index(state.module_scope),
		name,
	)


pure func compiler_typecheck_state_enter_prepared_module_scope(
	state: CompilerTypecheckState,
	prepared_scope: CompilerPreparedModuleScope,
) -> CompilerTypecheckState:
	representation = compiler_typecheck_module_scope_rep(state.module_scope)

	match representation:
		CompilerUnscopedModuleScope(_, _):
			definition_index = compiler_prepared_module_scope_definition_index(prepared_scope)
			aligned_index = compiler_definition_index_advance_to_env(definition_index, state.env)
			{ state |
				env = { state.env |
					next_def_id = compiler_definition_index_next_def_id(aligned_index)
				},
				module_scope = compiler_typecheck_module_scope(
					CompilerReservedModuleScope(prepared_scope),
				)
			}
		CompilerExtensibleModuleScope(_, _, _):
			compiler_typecheck_state_add_error(
				state,
				(
					"internal typecheck error: cannot enter an indexed graph from an extensible "
					+ "module scope"
				),
			)
		CompilerReservedModuleScope(_):
			compiler_typecheck_state_add_error(
				state,
				"internal typecheck error: cannot replace an indexed graph scope",
			)


pure func compiler_typecheck_state_scope_to_graph_module(
	state: CompilerTypecheckState,
	canonical_path: String,
) -> CompilerTypecheckState:
	representation = compiler_typecheck_module_scope_rep(state.module_scope)

	match representation:
		CompilerReservedModuleScope(current_scope):
			match compiler_prepared_module_scope_find_module(current_scope, canonical_path):
				Some(prepared_scope):
					{ state |
						module_scope = compiler_typecheck_module_scope(
							CompilerReservedModuleScope(prepared_scope),
						)
					}
				None:
					compiler_typecheck_state_add_error(
						state,
						"internal typecheck error: module '" + canonical_path + "' is not in the indexed graph",
					)
		_:
			compiler_typecheck_state_add_error(
				state,
				"internal typecheck error: cannot select indexed graph module '" + canonical_path + "' before entering a graph scope",
			)


pure func compiler_typecheck_state_scope_to_imported_module(
	state: CompilerTypecheckState,
	imported_scope: CompilerPreparedModuleScope,
) -> CompilerTypecheckState:
	representation = compiler_typecheck_module_scope_rep(state.module_scope)

	match representation:
		CompilerUnscopedModuleScope(_, _):
			compiler_typecheck_state_add_error(
				state,
				(
					"internal typecheck error: cannot select an imported module before selecting the "
					+ "current module"
				),
			)
		CompilerExtensibleModuleScope(_, _, index):
			{ state |
				module_scope = compiler_typecheck_module_scope(
					CompilerExtensibleModuleScope(
						compiler_prepared_module_scope_origin(imported_scope),
						compiler_prepared_module_scope_identity(imported_scope),
						index,
					),
				)
			}
		CompilerReservedModuleScope(current_scope):
			if compiler_prepared_module_scopes_are_compatible(current_scope, imported_scope):
				compiler_typecheck_state_scope_to_graph_module(
					state,
					compiler_prepared_module_scope_canonical_path(imported_scope),
				)
			else:
				compiler_typecheck_state_add_error(
					state,
					(
						"internal typecheck error: imported module scope is incompatible with the "
						+ "current indexed graph"
					),
				)


pure func compiler_typecheck_state_accepts_imported_module_scope(
	state: CompilerTypecheckState,
	imported_scope: CompilerPreparedModuleScope,
) -> Bool:
	representation = compiler_typecheck_module_scope_rep(state.module_scope)

	match representation:
		CompilerUnscopedModuleScope(_, _):
			False
		CompilerExtensibleModuleScope(_, _, _):
			True
		CompilerReservedModuleScope(current_scope):
			compiler_prepared_module_scopes_are_compatible(current_scope, imported_scope)


pure func compiler_typecheck_state_restore_definition_scope(
	state: CompilerTypecheckState,
	target_scope: CompilerTypecheckState,
) -> CompilerTypecheckState:
	target_representation = compiler_typecheck_module_scope_rep(target_scope.module_scope)

	match target_representation:
		CompilerUnscopedModuleScope(_, _):
			compiler_typecheck_state_add_error(
				state,
				"internal typecheck error: cannot restore an unscoped definition context",
			)
		CompilerExtensibleModuleScope(origin, identity, _):
			restored = compiler_typecheck_state_scope_to_module(state, identity)
			representation = compiler_typecheck_module_scope_rep(restored.module_scope)

			match representation:
				CompilerExtensibleModuleScope(_, restored_identity, index):
					{ restored |
						module_scope = compiler_typecheck_module_scope(
							CompilerExtensibleModuleScope(
								origin,
								restored_identity,
								index,
							),
						)
					}
				_:
					restored
		CompilerReservedModuleScope(prepared_scope):
			compiler_typecheck_state_scope_to_graph_module(
				state,
				compiler_prepared_module_scope_canonical_path(prepared_scope),
			)


private pure func compiler_typecheck_state_mint_definition_id(
	state: CompilerTypecheckState,
) -> (CompilerTypecheckState, Int):
	match env_mint_def_id(state.env):
		(next_env, def_id):
			({ state | env = next_env }, def_id)


pure func compiler_typecheck_state_claim_func_callable_id(
	state: CompilerTypecheckState,
	key: CompilerFuncCallableKey,
) -> CompilerDefinitionIdClaim:
	if not compiler_module_identities_equal(
		compiler_typecheck_state_module_identity(state),
		compiler_func_callable_key_module_identity(key),
	):
		CompilerDefinitionIdMissing(
			compiler_typecheck_state_add_error(
				state,
				(
					"internal typecheck error: cannot claim a callable definition ID owned by a "
					+ "different module"
				),
			),
		)
	else:
		match compiler_typecheck_state_find_func_callable_id(state, key):
			Some(def_id):
				CompilerDefinitionIdClaimed(state, def_id)
			None:
				representation = compiler_typecheck_module_scope_rep(state.module_scope)

				match representation:
					CompilerReservedModuleScope(_):
						with_error = compiler_typecheck_state_add_error(
							state,
							"internal typecheck error: missing reserved definition ID for " + compiler_func_callable_key_description(
								key,
							),
						)
						CompilerDefinitionIdMissing(with_error)
					CompilerUnscopedModuleScope(_, _):
						with_error = compiler_typecheck_state_add_error(
							state,
							"internal typecheck error: cannot claim " + compiler_func_callable_key_description(
								key,
							) + " before selecting a module",
						)
						CompilerDefinitionIdMissing(with_error)
					CompilerExtensibleModuleScope(_, _, _):
						match compiler_typecheck_state_mint_definition_id(state):
							(with_id, def_id):
								compiler_typecheck_state_record_func_callable_id(
									with_id,
									key,
									def_id,
								)


pure func compiler_typecheck_state_claim_source_definition_id(
	state: CompilerTypecheckState,
	key: CompilerSourceDefinitionKey,
) -> CompilerDefinitionIdClaim:
	if not compiler_module_identities_equal(
		compiler_typecheck_state_module_identity(state),
		compiler_source_definition_key_module_identity(key),
	):
		CompilerDefinitionIdMissing(
			compiler_typecheck_state_add_error(
				state,
				(
					"internal typecheck error: cannot claim a source definition ID owned by a "
					+ "different module"
				),
			),
		)
	else:
		match compiler_typecheck_state_find_source_definition_id(state, key):
			Some(def_id):
				CompilerDefinitionIdClaimed(state, def_id)
			None:
				representation = compiler_typecheck_module_scope_rep(state.module_scope)

				match representation:
					CompilerReservedModuleScope(_):
						with_error = compiler_typecheck_state_add_error(
							state,
							"internal typecheck error: missing reserved definition ID for " + compiler_source_definition_key_description(
								key,
							),
						)
						CompilerDefinitionIdMissing(with_error)
					CompilerUnscopedModuleScope(_, _):
						with_error = compiler_typecheck_state_add_error(
							state,
							"internal typecheck error: cannot claim " + compiler_source_definition_key_description(
								key,
							) + " before selecting a module",
						)
						CompilerDefinitionIdMissing(with_error)
					CompilerExtensibleModuleScope(_, _, _):
						match compiler_typecheck_state_mint_definition_id(state):
							(with_id, def_id):
								compiler_typecheck_state_record_source_definition_id(
									with_id,
									key,
									def_id,
								)


pure func compiler_typecheck_state_add_private_impl(
	state: CompilerTypecheckState,
	instance: ImplInstance,
) -> CompilerTypecheckState:
	{ state | private_impls = state.private_impls.append(instance) }


pure func compiler_typecheck_state_find_private_impl_conflict(
	state: CompilerTypecheckState,
	candidate: ImplInstance,
) -> Option[ImplInstance]:
	var result: Option[ImplInstance] = None

	for existing in state.private_impls:
		if (
			not existing.is_builtin
			and not candidate.is_builtin
			and existing.trait_name == candidate.trait_name
			and types_equal(existing.for_type, candidate.for_type)
		):
			result = Some(existing)
			break

	result
