-- Compiler-owned source identities for type definitions and type annotations.
--
-- SemanticType intentionally omits source spans and definition IDs. Navigation
-- needs both, so typechecking records this compact side table while parsed
-- names, import bindings, and the graph-wide definition index are all present.
import:
	../stage_01_file_io/source: CompilerSourceSpan
	../stage_03_parse/parsed_ast:
		ParsedDecl(
			BuiltinTypeParsedDecl,
			ForeignBlockParsedDecl,
			FunctionParsedDecl,
			ImplParsedDecl,
			PrivateParsedDecl,
			RecordParsedDecl,
			TraitParsedDecl,
			TypeAliasParsedDecl,
			UnionParsedDecl,
			VarParsedDecl,
		),
		ParsedExpr(
			ParsedAscriptionExpr,
			ParsedFunctionDeclExpr,
			ParsedLambdaExpr,
			ParsedOpaqueFromExpr,
			ParsedOpaqueIntoExpr,
			ParsedQuestionBindExpr,
			ParsedVarDeclExpr,
			ParsedWithExpr,
		),
		ParsedForeignFunctionDecl,
		ParsedFunctionDecl,
		ParsedParam,
		ParsedProgram,
		ParsedTraitMethodDecl,
		ParsedTypeExpr(
			ParsedArrayType,
			ParsedBoundedType,
			ParsedDimBinaryType,
			ParsedFunctionType,
			ParsedNamedType,
			ParsedQualifiedNamedType,
			ParsedRangeType,
			ParsedTupleType,
		),
	../stage_03_parse/parsed_ast_traverse: fold_parsed_expr_children
	../stage_04_modules/loaded_module:
		CompilerModuleIdentity,
		compiler_module_identities_equal,
		compiler_module_identity_matches_canonical_path,
	graph/definition_identity:
		CompilerSourceDefinitionKey,
		CompilerSourceDefinitionKind(CompilerTypeDefinition),
		compiler_source_definition_key,
		compiler_source_definition_key_kind,
		compiler_source_definition_key_module_identity,
		compiler_source_definition_keys_equal,
	typecheck_state:
		CompilerTypecheckState,
		compiler_typecheck_state_find_imported_name,
		compiler_typecheck_state_find_module_alias,
		compiler_typecheck_state_module_identity,
		compiler_typecheck_state_source_definition_bindings_for_name,


record CompilerTypedTypeDefinition {
	definition_id: Option[Int],
	name: String,
	declaration_span: CompilerSourceSpan,
	selection_span: CompilerSourceSpan,
	is_private: Bool
}


record CompilerTypedTypeReference {
	definition_id: Int,
	span: CompilerSourceSpan
}


private pure func type_definition_id(
	state: CompilerTypecheckState,
	name: String,
	span: CompilerSourceSpan,
) -> Option[Int]:
	key: CompilerSourceDefinitionKey = compiler_source_definition_key(
		compiler_typecheck_state_module_identity(state),
		CompilerTypeDefinition,
		name,
		None,
		span,
	)

	var result: Option[Int] = None

	for binding in compiler_typecheck_state_source_definition_bindings_for_name(state, name):
		if compiler_source_definition_keys_equal(binding[0], key):
			result = Some(binding[1])
			break

	result


private pure func typed_type_definition(
	state: CompilerTypecheckState,
	name: String,
	declaration_span: CompilerSourceSpan,
	selection_span: CompilerSourceSpan,
	is_private: Bool,
) -> CompilerTypedTypeDefinition:
	{
		definition_id = type_definition_id(state, name, declaration_span),
		name = name,
		declaration_span = declaration_span,
		selection_span = selection_span,
		is_private = is_private
	}


private pure func type_definitions_in_decl(
	state: CompilerTypecheckState,
	decl: ParsedDecl,
	is_private: Bool,
) -> List[CompilerTypedTypeDefinition]:
	match decl:
		RecordParsedDecl(record_decl):
			[
				typed_type_definition(
					state,
					record_decl.name.text,
					record_decl.span,
					record_decl.name.span,
					is_private,
				),
			]
		UnionParsedDecl(union_decl):
			[
				typed_type_definition(
					state,
					union_decl.name.text,
					union_decl.span,
					union_decl.name.span,
					is_private,
				),
			]
		BuiltinTypeParsedDecl(type_decl):
			[
				typed_type_definition(
					state,
					type_decl.name.text,
					type_decl.span,
					type_decl.name.span,
					is_private,
				),
			]
		TypeAliasParsedDecl(alias_decl):
			[
				typed_type_definition(
					state,
					alias_decl.name.text,
					alias_decl.span,
					alias_decl.name.span,
					is_private,
				),
			]
		PrivateParsedDecl(inner, _):
			type_definitions_in_decl(state, inner, True)
		_:
			[]


private pure func local_type_binding_matches(
	key: CompilerSourceDefinitionKey,
	module_identity: CompilerModuleIdentity,
) -> Bool:
	(
		compiler_source_definition_key_kind(key) == CompilerTypeDefinition
		and compiler_module_identities_equal(
			compiler_source_definition_key_module_identity(key),
			module_identity,
		)
	)


private pure func imported_type_binding_matches(
	key: CompilerSourceDefinitionKey,
	module_path: String,
) -> Bool:
	(
		compiler_source_definition_key_kind(key) == CompilerTypeDefinition
		and compiler_module_identity_matches_canonical_path(
			compiler_source_definition_key_module_identity(key),
			module_path,
		)
	)


private pure func type_definition_id_for_owner(
	state: CompilerTypecheckState,
	name: String,
	local_module: Option[CompilerModuleIdentity],
	imported_path: Option[String],
) -> Option[Int]:
	var result: Option[Int] = None
	var matches: Int = 0

	for binding in compiler_typecheck_state_source_definition_bindings_for_name(state, name):
		owned = match (local_module, imported_path):
			(Some(module_identity), None):
				local_type_binding_matches(binding[0], module_identity)
			(None, Some(module_path)):
				imported_type_binding_matches(binding[0], module_path)
			_:
				False

		if owned:
			result = Some(binding[1])
			matches += 1

	if matches == 1:
		result
	else:
		None


private pure func resolved_type_definition_id(
	state: CompilerTypecheckState,
	visible_name: String,
	qualified_module: Option[String],
) -> Option[Int]:
	match qualified_module:
		Some(module_alias):
			match compiler_typecheck_state_find_module_alias(state, module_alias):
				Some(module_path):
					type_definition_id_for_owner(state, visible_name, None, Some(module_path))
				None:
					None
		None:
			match compiler_typecheck_state_find_imported_name(state, visible_name):
				Some(imported):
					type_definition_id_for_owner(
						state,
						imported.original_name,
						None,
						Some(imported.module_path),
					)
				None:
					type_definition_id_for_owner(
						state,
						visible_name,
						Some(compiler_typecheck_state_module_identity(state)),
						None,
					)


private pure func type_references(
	state: CompilerTypecheckState,
	type_expr: ParsedTypeExpr,
) -> List[CompilerTypedTypeReference]:
	match type_expr:
		ParsedNamedType(name, args, _):
			current: List[CompilerTypedTypeReference] = match resolved_type_definition_id(
				state,
				name.text,
				None,
			):
				Some(definition_id):
					[
						{
							definition_id = definition_id,
							span = name.span
						},
					]
				None:
					[]

			current + args.flat_map(func(arg): type_references(state, arg))
		ParsedQualifiedNamedType(module_name, name, args, _):
			current: List[CompilerTypedTypeReference] = match resolved_type_definition_id(
				state,
				name.text,
				Some(module_name.text),
			):
				Some(definition_id):
					[
						{
							definition_id = definition_id,
							span = name.span
						},
					]
				None:
					[]

			current + args.flat_map(func(arg): type_references(state, arg))
		ParsedDimBinaryType(_, left, right, _):
			type_references(state, left) + type_references(state, right)
		ParsedRangeType(inner, _):
			type_references(state, inner)
		ParsedTupleType(items, _):
			items.flat_map(func(item): type_references(state, item))
		ParsedFunctionType(_, params, return_type, _):
			params.flat_map(
				func(param): type_references(state, param),
			) + type_references(state, return_type)
		ParsedArrayType(element, dims, _):
			type_references(state, element) + dims.flat_map(func(dim):
				type_references(state, dim)
			)
		ParsedBoundedType(_, _, _):
			[]
		_:
			[]


private pure func optional_type_references(
	state: CompilerTypecheckState,
	type_expr: Option[ParsedTypeExpr],
) -> List[CompilerTypedTypeReference]:
	match type_expr:
		Some(found):
			type_references(state, found)
		None:
			[]


private pure func param_type_references(
	state: CompilerTypecheckState,
	params: List[ParsedParam],
) -> List[CompilerTypedTypeReference]:
	params.flat_map(func(param): optional_type_references(state, param.type_expr))


private pure func function_signature_type_references(
	state: CompilerTypecheckState,
	function_decl: ParsedFunctionDecl,
) -> List[CompilerTypedTypeReference]:
	param_type_references(
		state,
		function_decl.params,
	) + optional_type_references(state, function_decl.return_type)


private pure func foreign_signature_type_references(
	state: CompilerTypecheckState,
	function_decl: ParsedForeignFunctionDecl,
) -> List[CompilerTypedTypeReference]:
	param_type_references(
		state,
		function_decl.params,
	) + type_references(state, function_decl.return_type)


private pure func trait_method_type_references(
	state: CompilerTypecheckState,
	method: ParsedTraitMethodDecl,
) -> List[CompilerTypedTypeReference]:
	param_type_references(
		state,
		method.params,
	) + optional_type_references(
		state,
		method.return_type,
	) + optional_expr_type_references(state, method.body)


private pure func optional_expr_type_references(
	state: CompilerTypecheckState,
	expr: Option[ParsedExpr],
) -> List[CompilerTypedTypeReference]:
	match expr:
		Some(found):
			expr_type_references(state, found)
		None:
			[]


private pure func expr_immediate_type_references(
	state: CompilerTypecheckState,
	expr: ParsedExpr,
) -> List[CompilerTypedTypeReference]:
	match expr:
		ParsedAscriptionExpr(_, type_expr, _):
			type_references(state, type_expr)
		ParsedOpaqueIntoExpr(type_expr, _, _):
			type_references(state, type_expr)
		ParsedOpaqueFromExpr(type_expr, _, _):
			type_references(state, type_expr)
		ParsedWithExpr(binding, _, _):
			optional_type_references(state, binding.type_expr)
		ParsedLambdaExpr(_, params, return_type, _, _):
			params.flat_map(
				func(
					param,
				): optional_type_references(
					state,
					param.type_expr,
				),
			) + optional_type_references(state, return_type)
		ParsedFunctionDeclExpr(function_decl):
			function_signature_type_references(state, function_decl)
		ParsedVarDeclExpr(_, type_expr, _, _, _):
			optional_type_references(state, type_expr)
		ParsedQuestionBindExpr(_, type_expr, _, _):
			optional_type_references(state, type_expr)
		_:
			[]


private pure func expr_type_references(
	state: CompilerTypecheckState,
	expr: ParsedExpr,
) -> List[CompilerTypedTypeReference]:
	fold_parsed_expr_children(
		expr,
		expr_immediate_type_references(
			state,
			expr,
		),
		func(result, child): result + expr_type_references(state, child),
	)


private pure func decl_type_references(
	state: CompilerTypecheckState,
	decl: ParsedDecl,
) -> List[CompilerTypedTypeReference]:
	match decl:
		FunctionParsedDecl(function_decl):
			function_signature_type_references(
				state,
				function_decl,
			) + optional_expr_type_references(state, function_decl.body)
		ForeignBlockParsedDecl(_, functions, _):
			functions.flat_map(func(function_decl):
				foreign_signature_type_references(state, function_decl)
			)
		VarParsedDecl(var_decl):
			optional_type_references(
				state,
				var_decl.type_expr,
			) + expr_type_references(state, var_decl.value)
		RecordParsedDecl(record_decl):
			record_decl.fields.flat_map(func(field): type_references(state, field.type_expr))
		UnionParsedDecl(union_decl):
			union_decl.variants.flat_map(func(variant):
				variant.fields.flat_map(func(field): type_references(state, field))
			)
		TypeAliasParsedDecl(alias_decl):
			type_references(state, alias_decl.target)
		TraitParsedDecl(trait_decl):
			trait_decl.methods.flat_map(func(method): trait_method_type_references(state, method))
		ImplParsedDecl(impl_decl):
			type_references(state, impl_decl.for_type) + impl_decl.methods.flat_map(func(method):
				function_signature_type_references(
					state,
					method,
				) + optional_expr_type_references(state, method.body)
			)
		PrivateParsedDecl(inner, _):
			decl_type_references(state, inner)
		_:
			[]


pure func compiler_typed_type_definitions(
	state: CompilerTypecheckState,
	program: ParsedProgram,
) -> List[CompilerTypedTypeDefinition]:
	program.decls.flat_map(func(decl): type_definitions_in_decl(state, decl, False))


pure func compiler_typed_type_references(
	state: CompilerTypecheckState,
	program: ParsedProgram,
) -> List[CompilerTypedTypeReference]:
	var result: List[CompilerTypedTypeReference] = []

	for decl in program.decls:
		result += decl_type_references(state, decl)

	result
