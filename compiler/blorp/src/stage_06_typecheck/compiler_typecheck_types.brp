-- Source type-expression projection for the Blorp-owned typecheck pass.
--
-- This is the narrow boundary from parsed source syntax to the semantic
-- CompilerType model. Name resolution, alias expansion, and owner qualification
-- remain in compiler_type_resolution.brp.
import:
	../stage_03_parse/compiler_parsed_ast:
		ParsedDimBinaryOp(
			ParsedDimAddOp,
			ParsedDimDivideOp,
			ParsedDimMultiplyOp,
			ParsedDimSubtractOp,
		),
		ParsedTypeExpr(
			ParsedArrayType,
			ParsedBoundedType,
			ParsedDimBinaryType,
			ParsedDimLiteralType,
			ParsedDimNameType,
			ParsedFunctionType,
			ParsedMissingType,
			ParsedNamedType,
			ParsedQualifiedNamedType,
			ParsedRangeType,
			ParsedTupleType,
		),
		ParsedTypeParamDecl,
	../stage_05_types/compiler_generic_params:
		CompilerBoundTypeParam,
		compiler_make_bound_type_param,
	../stage_05_types/compiler_type:
		CompilerDimOp(CompilerDimAdd, CompilerDimDivide, CompilerDimMultiply, CompilerDimSubtract),
		CompilerType(
			CompilerArrayType,
			CompilerConstIntType,
			CompilerDimOpType,
			CompilerFunctionType,
			CompilerNamedType,
			CompilerRangeType,
			CompilerSelfType,
			CompilerTupleType,
			CompilerTypeVar,
			CompilerVarDimsType,
		),
		compiler_type_name_copy,
		compiler_type_void,


pure func compiler_type_param_name(param: ParsedTypeParamDecl) -> String:
	compiler_type_name_copy(param.name.text)


pure func compiler_type_param_names(params: List[ParsedTypeParamDecl]) -> List[String]:
	params.map(compiler_type_param_name)


pure func compiler_bound_type_param_from_parsed(
	param: ParsedTypeParamDecl,
) -> CompilerBoundTypeParam:
	compiler_make_bound_type_param(
		compiler_type_name_copy(param.name.text),
		param.bounds.map(func(bound): compiler_type_name_copy(bound.text)),
	)


pure func compiler_bound_type_params_from_parsed(
	params: List[ParsedTypeParamDecl],
) -> List[CompilerBoundTypeParam]:
	params.map(compiler_bound_type_param_from_parsed)


private pure func compiler_dim_op_from_parsed(op: ParsedDimBinaryOp) -> CompilerDimOp:
	match op:
		ParsedDimAddOp:
			CompilerDimAdd
		ParsedDimSubtractOp:
			CompilerDimSubtract
		ParsedDimMultiplyOp:
			CompilerDimMultiply
		ParsedDimDivideOp:
			CompilerDimDivide


pure func compiler_type_from_parsed_type_expr(type_expr: ParsedTypeExpr) -> CompilerType:
	match type_expr:
		ParsedNamedType(name, args, _):
			if name.text == "Self" and args.length() == 0:
				CompilerSelfType
			else:
				CompilerNamedType(
					compiler_type_name_copy(name.text),
					args.map(compiler_type_from_parsed_type_expr),
				)
		ParsedQualifiedNamedType(qualifier, name, args, _):
			CompilerNamedType(
				qualifier.text + "." + name.text,
				args.map(compiler_type_from_parsed_type_expr),
			)
		ParsedBoundedType(name, _, _):
			CompilerTypeVar(compiler_type_name_copy(name.text))
		ParsedDimNameType(name, is_variadic, _):
			if is_variadic:
				CompilerVarDimsType(compiler_type_name_copy(name.text))
			else:
				CompilerTypeVar(compiler_type_name_copy(name.text))
		ParsedDimLiteralType(value, _):
			match value.parse_int():
				Some(number):
					CompilerConstIntType(number)
				None:
					CompilerConstIntType(0)
		ParsedDimBinaryType(op, left, right, _):
			CompilerDimOpType(
				compiler_dim_op_from_parsed(op),
				compiler_type_from_parsed_type_expr(left),
				compiler_type_from_parsed_type_expr(right),
			)
		ParsedRangeType(inner, _):
			CompilerRangeType(compiler_type_from_parsed_type_expr(inner))
		ParsedTupleType(items, _):
			CompilerTupleType(items.map(compiler_type_from_parsed_type_expr))
		ParsedFunctionType(is_pure, params, return_type, _):
			CompilerFunctionType(
				is_pure,
				params.map(compiler_type_from_parsed_type_expr),
				compiler_type_from_parsed_type_expr(return_type),
			)
		ParsedArrayType(element, dims, _):
			CompilerArrayType(
				compiler_type_from_parsed_type_expr(element),
				dims.map(compiler_type_from_parsed_type_expr),
			)
		ParsedMissingType(_):
			compiler_type_void()
