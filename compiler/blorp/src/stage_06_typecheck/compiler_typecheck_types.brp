-- Source type-expression projection for the Blorp-owned typecheck pass.
--
-- This is the narrow boundary from parsed source syntax to the semantic
-- SemanticType model. Name resolution, alias expansion, and owner qualification
-- remain in compiler_type_resolution.brp.
import:
	../stage_03_parse/compiler_parsed_ast:
		ParsedDimBinaryOp(
			ParsedDimAddOp,
			ParsedDimDivideOp,
			ParsedDimMultiplyOp,
			ParsedDimSubtractOp,
		),
		ParsedTypeExpr(
			ParsedArrayType,
			ParsedBoundedType,
			ParsedDimBinaryType,
			ParsedDimLiteralType,
			ParsedDimNameType,
			ParsedFunctionType,
			ParsedMissingType,
			ParsedNamedType,
			ParsedQualifiedNamedType,
			ParsedRangeType,
			ParsedTupleType,
		),
		ParsedTypeParamDecl,
	../stage_05_types/compiler_generic_params: BoundTypeParam, make_bound_type_param
	../stage_05_types/compiler_type:
		SemanticDimOp(SemanticDimAdd, SemanticDimDivide, SemanticDimMultiply, SemanticDimSubtract),
		SemanticType(
			SemanticArrayType,
			SemanticConstIntType,
			SemanticDimOpType,
			SemanticFunctionType,
			SemanticNamedType,
			SemanticRangeType,
			SemanticSelfType,
			SemanticTupleType,
			SemanticTypeVar,
			SemanticVarDimsType,
		),
		type_void,


pure func compiler_type_param_name(param: ParsedTypeParamDecl) -> String:
	param.name.text


pure func compiler_type_param_names(params: List[ParsedTypeParamDecl]) -> List[String]:
	params.map(compiler_type_param_name)


pure func compiler_bound_type_param_from_parsed(param: ParsedTypeParamDecl) -> BoundTypeParam:
	make_bound_type_param(
		param.name.text,
		param.bounds.map(func(bound): bound.text),
	)


pure func compiler_bound_type_params_from_parsed(
	params: List[ParsedTypeParamDecl],
) -> List[BoundTypeParam]:
	params.map(compiler_bound_type_param_from_parsed)


private pure func compiler_dim_op_from_parsed(op: ParsedDimBinaryOp) -> SemanticDimOp:
	match op:
		ParsedDimAddOp:
			SemanticDimAdd
		ParsedDimSubtractOp:
			SemanticDimSubtract
		ParsedDimMultiplyOp:
			SemanticDimMultiply
		ParsedDimDivideOp:
			SemanticDimDivide


pure func compiler_type_from_parsed_type_expr(type_expr: ParsedTypeExpr) -> SemanticType:
	match type_expr:
		ParsedNamedType(name, args, _):
			if name.text == "Self" and args.length() == 0:
				SemanticSelfType
			else:
				SemanticNamedType(
					name.text,
					args.map(compiler_type_from_parsed_type_expr),
				)
		ParsedQualifiedNamedType(qualifier, name, args, _):
			SemanticNamedType(
				qualifier.text + "." + name.text,
				args.map(compiler_type_from_parsed_type_expr),
			)
		ParsedBoundedType(name, _, _):
			SemanticTypeVar(name.text)
		ParsedDimNameType(name, is_variadic, _):
			if is_variadic:
				SemanticVarDimsType(name.text)
			else:
				SemanticTypeVar(name.text)
		ParsedDimLiteralType(value, _):
			match value.parse_int():
				Some(number):
					SemanticConstIntType(number)
				None:
					SemanticConstIntType(0)
		ParsedDimBinaryType(op, left, right, _):
			SemanticDimOpType(
				compiler_dim_op_from_parsed(op),
				compiler_type_from_parsed_type_expr(left),
				compiler_type_from_parsed_type_expr(right),
			)
		ParsedRangeType(inner, _):
			SemanticRangeType(compiler_type_from_parsed_type_expr(inner))
		ParsedTupleType(items, _):
			SemanticTupleType(items.map(compiler_type_from_parsed_type_expr))
		ParsedFunctionType(is_pure, params, return_type, _):
			SemanticFunctionType(
				is_pure,
				params.map(compiler_type_from_parsed_type_expr),
				compiler_type_from_parsed_type_expr(return_type),
			)
		ParsedArrayType(element, dims, _):
			SemanticArrayType(
				compiler_type_from_parsed_type_expr(element),
				dims.map(compiler_type_from_parsed_type_expr),
			)
		ParsedMissingType(_):
			type_void()
