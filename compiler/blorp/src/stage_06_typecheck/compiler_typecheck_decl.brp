COMPILER_PRELUDE_TRAITS_MODULE_PATH: String = "std/traits"

COMPILER_PRELUDE_TRAITS_MODULE_NAME: String = "traits"

private COMPILER_AMBIENT_TUPLE_IMPL_MODULE_PATH: String = "std/tuple"


private record CompilerResourceTypeScanContext {
	env: CompilerEnv,
	known_resource_type_names: List[String]
}


private record CompilerFunctionBodySignature {
	callable_id: Option[Int],
	effective_type_params: List[CompilerBoundTypeParam],
	param_types: List[CompilerType],
	semantic_return_type: CompilerType
}


private pure func compiler_typecheck_state_with_env(
	state: CompilerTypecheckState,
	env: CompilerEnv,
) -> CompilerTypecheckState:
	{ state | env = env }


private pure func compiler_canonical_annotation_type(
	state: CompilerTypecheckState,
	typ: CompilerType,
) -> CompilerType:
	qualified = compiler_resolve_qualified_type_names(state.module_aliases, typ)
	imported = compiler_resolve_imported_type_aliases_from_bindings(
		state.imported_names,
		state.type_homes,
		qualified,
	)
	compiler_type_instantiate_type_params(
		compiler_env_get_type_params(state.env),
		compiler_env_resolve_alias(state.env, imported),
	)


private pure func compiler_canonical_function_annotation_type(
	state: CompilerTypecheckState,
	declared_type_param_names: List[String],
	typ: CompilerType,
) -> CompilerType:
	compiler_canonical_annotation_type(
		state,
		compiler_type_instantiate_type_params(declared_type_param_names, typ),
	)


private pure func compiler_canonical_return_type(
	state: CompilerTypecheckState,
	declared_type_param_names: List[String],
	return_type: Option[ParsedTypeExpr],
) -> Option[CompilerType]:
	return_type.map(
		func(
			type_expr,
		): compiler_canonical_function_annotation_type(
			state,
			declared_type_param_names,
			compiler_type_from_parsed_type_expr(type_expr),
		),
	)


private pure func compiler_canonical_imported_type_name(
	module_path: String,
	name: String,
) -> String:
	compiler_canonical_module_type_name(module_path, name)


private pure func compiler_imported_type_name_from_bindings(
	imported_names: List[CompilerImportedNameBinding],
	type_homes: List[CompilerTypecheckTypeHome],
	name: String,
) -> String:
	var result: String = name

	for binding in imported_names:
		if binding.local_name == name:
			for home in type_homes:
				if home.type_name == name and home.imported:
					result = compiler_canonical_imported_type_name(
						home.module_path,
						binding.original_name,
					)
					break
				else:
					void

			break

	result


private pure func compiler_resolve_imported_type_aliases_from_bindings(
	imported_names: List[CompilerImportedNameBinding],
	type_homes: List[CompilerTypecheckTypeHome],
	typ: CompilerType,
) -> CompilerType:
	match typ:
		CompilerNamedType(name, args):
			CompilerNamedType(
				compiler_imported_type_name_from_bindings(imported_names, type_homes, name),
				args.map(
					func(
						arg,
					): compiler_resolve_imported_type_aliases_from_bindings(
						imported_names,
						type_homes,
						arg,
					),
				),
			)
		CompilerArrayType(element, dims):
			CompilerArrayType(
				compiler_resolve_imported_type_aliases_from_bindings(
					imported_names,
					type_homes,
					element,
				),
				dims.map(
					func(
						dim,
					): compiler_resolve_imported_type_aliases_from_bindings(
						imported_names,
						type_homes,
						dim,
					),
				),
			)
		CompilerFunctionType(is_pure, params, return_type):
			CompilerFunctionType(
				is_pure,
				params.map(
					func(
						param,
					): compiler_resolve_imported_type_aliases_from_bindings(
						imported_names,
						type_homes,
						param,
					),
				),
				compiler_resolve_imported_type_aliases_from_bindings(
					imported_names,
					type_homes,
					return_type,
				),
			)
		CompilerTupleType(elements):
			CompilerTupleType(
				elements.map(func(element):
					compiler_resolve_imported_type_aliases_from_bindings(
						imported_names,
						type_homes,
						element,
					)
				),
			)
		CompilerRangeType(inner):
			CompilerRangeType(
				compiler_resolve_imported_type_aliases_from_bindings(
					imported_names,
					type_homes,
					inner,
				),
			)
		CompilerDimOpType(op, left, right):
			CompilerDimOpType(
				op,
				compiler_resolve_imported_type_aliases_from_bindings(
					imported_names,
					type_homes,
					left,
				),
				compiler_resolve_imported_type_aliases_from_bindings(
					imported_names,
					type_homes,
					right,
				),
			)
		_:
			typ


private pure func compiler_resolve_imported_type_aliases(
	import_state: CompilerTypecheckState,
	typ: CompilerType,
) -> CompilerType:
	compiler_resolve_imported_type_aliases_from_bindings(
		import_state.imported_names,
		import_state.type_homes,
		typ,
	)


private pure func compiler_qualify_imported_type(
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	typ: CompilerType,
) -> CompilerType:
	local_or_global = compiler_qualify_module_local_types(module_path, local_type_names, typ)
	qualified = compiler_resolve_qualified_type_names(import_state.module_aliases, local_or_global)
	compiler_resolve_imported_type_aliases(import_state, qualified)


private pure func compiler_imported_annotation_type(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	typ: CompilerType,
) -> CompilerType:
	compiler_canonical_annotation_type(
		state,
		compiler_qualify_imported_type(import_state, module_path, local_type_names, typ),
	)


private pure func compiler_imported_function_annotation_type(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	declared_type_param_names: List[String],
	typ: CompilerType,
) -> CompilerType:
	compiler_imported_annotation_type(
		state,
		import_state,
		module_path,
		local_type_names,
		compiler_type_instantiate_type_params(declared_type_param_names, typ),
	)


private pure func compiler_imported_type_alias_names(
	state: CompilerTypecheckState,
	module_path: String,
	original_name: String,
) -> List[String]:
	var names: List[String] = []

	for binding in state.imported_names:
		if binding.module_path == module_path and binding.original_name == original_name:
			names = names.append(binding.local_name)

	names


private pure func compiler_add_imported_type_aliases(
	state: CompilerTypecheckState,
	module_path: String,
	original_name: String,
	canonical_name: String,
	type_params: List[String],
) -> CompilerTypecheckState:
	var next = state

	for alias_name in compiler_imported_type_alias_names(state, module_path, original_name):
		if alias_name != canonical_name:
			env: CompilerEnv = compiler_env_add_alias(
				next.env,
				alias_name,
				type_params,
				CompilerNamedType(
					canonical_name,
					type_params.map(func(param): CompilerTypeVar(param)),
				),
			)
			next = compiler_typecheck_state_with_env(next, env)

	next


private pure func compiler_typecheck_with_body_env(
	state: CompilerTypecheckState,
	body_state: CompilerTypecheckState,
) -> CompilerTypecheckState:
	env = state.env
	{ body_state | env = env }


record CompilerTypedFunctionInfo {
	decl: ParsedFunctionDecl,
	callable_id: Option[Int],
	effective_type_params: List[CompilerBoundTypeParam],
	param_types: List[CompilerType],
	source_return_type: Option[CompilerType],
	semantic_return_type: CompilerType,
	body: Option[CompilerTypedExpr]
}


record CompilerTypedGlobalVarInfo {
	decl: ParsedVarDecl,
	binding_type: CompilerType,
	source_type: Option[CompilerType],
	value: CompilerTypedExpr
}


record CompilerTypedRecordFieldInfo {
	name: String,
	source_type: CompilerType,
	semantic_type: CompilerType
}


record CompilerTypedRecordInfo {
	decl: ParsedRecordDecl,
	fields: List[CompilerTypedRecordFieldInfo]
}


record CompilerTypedTypeAliasInfo {
	decl: ParsedTypeAliasDecl,
	source_target_type: CompilerType,
	semantic_target_type: CompilerType
}


record CompilerTypedTraitMethodInfo {
	decl: ParsedTraitMethodDecl,
	param_types: List[CompilerType],
	semantic_return_type: CompilerType
}


record CompilerTypedTraitInfo {
	decl: ParsedTraitDecl,
	methods: List[CompilerTypedTraitMethodInfo]
}


record CompilerTypedUnionVariantInfo {
	name: String,
	fields: List[CompilerType],
	tag: Int,
	def_id: Option[Int]
}


record CompilerTypedUnionInfo {
	decl: ParsedUnionDecl,
	variants: List[CompilerTypedUnionVariantInfo]
}


record CompilerTypedImplInfo {
	decl: ParsedImplDecl,
	for_type: CompilerType,
	type_params: List[CompilerBoundTypeParam],
	methods: List[CompilerTypedFunctionInfo]
}


enum CompilerTypedForeignLinkPlatform:
	CompilerTypedForeignLinux
	CompilerTypedForeignMacos


pure func compiler_typed_foreign_link_platform_to_string(
	platform: CompilerTypedForeignLinkPlatform,
) -> String:
	match platform:
		CompilerTypedForeignLinux:
			"linux"
		CompilerTypedForeignMacos:
			"macos"


record CompilerTypedForeignLinkFlag {
	platform: Option[CompilerTypedForeignLinkPlatform],
	flag: String
}


enum CompilerTypedForeignArgPassing:
	CompilerTypedForeignDefaultArgs
	CompilerTypedForeignBorrowArgs


pure func compiler_typed_foreign_arg_passing_borrows(
	arg_passing: CompilerTypedForeignArgPassing,
) -> Bool:
	match arg_passing:
		CompilerTypedForeignDefaultArgs:
			False
		CompilerTypedForeignBorrowArgs:
			True


record CompilerTypedForeignFunctionInfo {
	decl: ParsedForeignFunctionDecl,
	callable_id: Option[Int],
	param_types: List[CompilerType],
	semantic_return_type: CompilerType,
	c_name: String,
	includes: List[String],
	link_flags: List[CompilerTypedForeignLinkFlag],
	arg_passing: CompilerTypedForeignArgPassing,
	block_span: CompilerSourceSpan
}


union CompilerTypedDecl:
	CompilerTypedFunctionDecl(CompilerTypedFunctionInfo)
	CompilerTypedForeignFunctionDecl(CompilerTypedForeignFunctionInfo)
	CompilerTypedGlobalVarDecl(CompilerTypedGlobalVarInfo)
	CompilerTypedRecordDecl(CompilerTypedRecordInfo)
	CompilerTypedTypeAliasDecl(CompilerTypedTypeAliasInfo)
	CompilerTypedTraitDecl(CompilerTypedTraitInfo)
	CompilerTypedUnionDecl(CompilerTypedUnionInfo)
	CompilerTypedImplDecl(CompilerTypedImplInfo)
	CompilerTypedPrivateDecl(CompilerTypedDecl)
	CompilerTypedParsedDecl(ParsedDecl)


record CompilerTypedProgram {
	source: CompilerSourceFile,
	decls: List[CompilerTypedDecl],
	diagnostics: List[CompilerParseDiagnostic]
}


record CompilerTypecheckFunctionBodyResult {
	state: CompilerTypecheckState,
	typed: CompilerTypedFunctionInfo
}


record CompilerTypecheckGlobalVarBodyResult {
	state: CompilerTypecheckState,
	typed: CompilerTypedGlobalVarInfo
}


private union CompilerGlobalTypeExpectation:
	CompilerInferredGlobalType
	CompilerDeclaredGlobalType(CompilerType)


record CompilerTypecheckImplBodyResult {
	state: CompilerTypecheckState,
	typed: CompilerTypedImplInfo
}


record CompilerTypecheckDeclBodyResult {
	state: CompilerTypecheckState,
	decl: CompilerTypedDecl
}


record CompilerTypecheckProgramResult {
	state: CompilerTypecheckState,
	program: CompilerTypedProgram
}


private record CompilerTypedForeignBlockResult {
	state: CompilerTypecheckState,
	decls: List[CompilerTypedDecl]
}


private pure func compiler_typed_program_from_decls(
	program: ParsedProgram,
	decls: List[CompilerTypedDecl],
) -> CompilerTypedProgram:
	{
		source = program.source,
		decls = decls,
		diagnostics = program.diagnostics
	}


private pure func compiler_typecheck_unfinalized_type_error(
	state: CompilerTypecheckState,
	label: String,
	typ: CompilerType,
) -> CompilerTypecheckState:
	if compiler_type_contains_meta(typ):
		compiler_typecheck_state_add_error(
			state,
			"internal typecheck error: typed program contains unfinalized inference meta in " + label + ": " + compiler_type_to_string(
				typ,
			),
		)
	else:
		state


private pure func compiler_typecheck_validate_optional_typed_type(
	state: CompilerTypecheckState,
	label: String,
	typ: Option[CompilerType],
) -> CompilerTypecheckState:
	match typ:
		Some(value):
			compiler_typecheck_unfinalized_type_error(state, label, value)
		None:
			state


private pure func compiler_typecheck_validate_typed_expr(
	state: CompilerTypecheckState,
	label: String,
	expr: CompilerTypedExpr,
) -> CompilerTypecheckState:
	if compiler_typed_expr_contains_meta(expr):
		compiler_typecheck_state_add_error(
			state,
			(
				"internal typecheck error: typed expression contains unfinalized inference meta "
				+ "in "
			) + label,
		)
	else:
		match compiler_typed_expr_type_error(expr):
			Some(message):
				compiler_typecheck_state_add_error(
					state,
					"internal typecheck error: typed expression has incoherent type info " + "in " + label + ": " + message,
				)
			None:
				state


private pure func compiler_typecheck_validate_typed_function_info(
	state: CompilerTypecheckState,
	label: String,
	info: CompilerTypedFunctionInfo,
) -> CompilerTypecheckState:
	var next = state
	var index: Int = 0

	for param_type in info.param_types:
		next = compiler_typecheck_unfinalized_type_error(
			next,
			label + " parameter " + index.to_string(),
			param_type,
		)
		index += 1

	next = compiler_typecheck_validate_optional_typed_type(
		next,
		label + " source return type",
		info.source_return_type,
	)
	next = compiler_typecheck_unfinalized_type_error(
		next,
		label + " semantic return type",
		info.semantic_return_type,
	)

	match info.body:
		Some(body):
			compiler_typecheck_validate_typed_expr(next, label + " body", body)
		None:
			next


private pure func compiler_typecheck_validate_typed_global_info(
	state: CompilerTypecheckState,
	label: String,
	info: CompilerTypedGlobalVarInfo,
) -> CompilerTypecheckState:
	with_binding = compiler_typecheck_unfinalized_type_error(
		state,
		label + " binding type",
		info.binding_type,
	)
	with_source = compiler_typecheck_validate_optional_typed_type(
		with_binding,
		label + " source type",
		info.source_type,
	)

	compiler_typecheck_validate_typed_expr(with_source, label + " value", info.value)


private pure func compiler_typecheck_validate_typed_record_info(
	state: CompilerTypecheckState,
	label: String,
	info: CompilerTypedRecordInfo,
) -> CompilerTypecheckState:
	var next = state

	for field in info.fields:
		next = compiler_typecheck_unfinalized_type_error(
			next,
			label + " field '" + field.name + "' source type",
			field.source_type,
		)
		next = compiler_typecheck_unfinalized_type_error(
			next,
			label + " field '" + field.name + "' semantic type",
			field.semantic_type,
		)

	next


private pure func compiler_typecheck_validate_typed_alias_info(
	state: CompilerTypecheckState,
	label: String,
	info: CompilerTypedTypeAliasInfo,
) -> CompilerTypecheckState:
	with_source = compiler_typecheck_unfinalized_type_error(
		state,
		label + " source target type",
		info.source_target_type,
	)

	compiler_typecheck_unfinalized_type_error(
		with_source,
		label + " semantic target type",
		info.semantic_target_type,
	)


private pure func compiler_typecheck_validate_typed_trait_info(
	state: CompilerTypecheckState,
	label: String,
	info: CompilerTypedTraitInfo,
) -> CompilerTypecheckState:
	var next = state

	for method in info.methods:
		var index: Int = 0

		for param_type in method.param_types:
			next = compiler_typecheck_unfinalized_type_error(
				next,
				label + " method '" + method.decl.name.text + "' parameter " + index.to_string(),
				param_type,
			)
			index += 1

		next = compiler_typecheck_unfinalized_type_error(
			next,
			label + " method '" + method.decl.name.text + "' return type",
			method.semantic_return_type,
		)

	next


private pure func compiler_typecheck_validate_typed_union_info(
	state: CompilerTypecheckState,
	label: String,
	info: CompilerTypedUnionInfo,
) -> CompilerTypecheckState:
	var next = state

	for variant in info.variants:
		var index: Int = 0

		for field in variant.fields:
			next = compiler_typecheck_unfinalized_type_error(
				next,
				label + " variant '" + variant.name + "' field " + index.to_string(),
				field,
			)
			index += 1

	next


private pure func compiler_typecheck_validate_typed_impl_info(
	state: CompilerTypecheckState,
	label: String,
	info: CompilerTypedImplInfo,
) -> CompilerTypecheckState:
	var next = compiler_typecheck_unfinalized_type_error(
		state,
		label + " target type",
		info.for_type,
	)
	var index: Int = 0

	for method in info.methods:
		next = compiler_typecheck_validate_typed_function_info(
			next,
			label + " method " + index.to_string() + " '" + method.decl.name.text + "'",
			method,
		)
		index += 1

	next


private pure func compiler_typecheck_validate_typed_decl(
	state: CompilerTypecheckState,
	decl: CompilerTypedDecl,
) -> CompilerTypecheckState:
	match decl:
		CompilerTypedFunctionDecl(info):
			compiler_typecheck_validate_typed_function_info(
				state,
				"function '" + info.decl.name.text + "'",
				info,
			)
		CompilerTypedForeignFunctionDecl(info):
			var next = state
			var index: Int = 0

			for param_type in info.param_types:
				next = compiler_typecheck_unfinalized_type_error(
					next,
					"foreign function '" + info.decl.name.text + "' parameter " + index.to_string(),
					param_type,
				)
				index += 1

			compiler_typecheck_unfinalized_type_error(
				next,
				"foreign function '" + info.decl.name.text + "' return type",
				info.semantic_return_type,
			)
		CompilerTypedGlobalVarDecl(info):
			compiler_typecheck_validate_typed_global_info(
				state,
				"global '" + info.decl.name.text + "'",
				info,
			)
		CompilerTypedRecordDecl(info):
			compiler_typecheck_validate_typed_record_info(
				state,
				"record '" + info.decl.name.text + "'",
				info,
			)
		CompilerTypedTypeAliasDecl(info):
			compiler_typecheck_validate_typed_alias_info(
				state,
				"type alias '" + info.decl.name.text + "'",
				info,
			)
		CompilerTypedTraitDecl(info):
			compiler_typecheck_validate_typed_trait_info(
				state,
				"trait '" + info.decl.name.text + "'",
				info,
			)
		CompilerTypedUnionDecl(info):
			compiler_typecheck_validate_typed_union_info(
				state,
				"union '" + info.decl.name.text + "'",
				info,
			)
		CompilerTypedImplDecl(info):
			compiler_typecheck_validate_typed_impl_info(
				state,
				"impl '" + info.decl.trait_name.text + "'",
				info,
			)
		CompilerTypedPrivateDecl(inner):
			compiler_typecheck_validate_typed_decl(state, inner)
		CompilerTypedParsedDecl(_):
			state


pure func compiler_typecheck_validate_typed_program(
	result: CompilerTypecheckProgramResult,
) -> CompilerTypecheckProgramResult:
	var next_state = result.state

	for decl in result.program.decls:
		next_state = compiler_typecheck_validate_typed_decl(next_state, decl)

	{ result | state = next_state }


private pure func compiler_resource_type_scan_context(
	env: CompilerEnv,
	known_resource_type_names: List[String],
) -> CompilerResourceTypeScanContext:
	{
		env = env,
		known_resource_type_names = known_resource_type_names
	}


private pure func compiler_resource_type_scan_has_known_name(
	context: CompilerResourceTypeScanContext,
	name: String,
) -> Bool:
	context.known_resource_type_names.contains(name)


private pure func compiler_resource_type_scan_contains(
	context: CompilerResourceTypeScanContext,
	typ: CompilerType,
) -> Bool:
	resolved_type = compiler_env_resolve_alias_head(context.env, typ)

	match resolved_type:
		CompilerNamedType(name, args):
			(
				compiler_resource_type_scan_has_known_name(context, name)
				or compiler_env_type_is_resource(context.env, name)
				or args.any(func(arg): compiler_resource_type_scan_contains(context, arg))
			)
		CompilerArrayType(element, dims):
			(
				compiler_resource_type_scan_contains(context, element)
				or dims.any(func(dim): compiler_resource_type_scan_contains(context, dim))
			)
		CompilerFunctionType(_, params, return_type):
			(
				params.any(func(param): compiler_resource_type_scan_contains(context, param))
				or compiler_resource_type_scan_contains(context, return_type)
			)
		CompilerTupleType(elements):
			elements.any(func(element): compiler_resource_type_scan_contains(context, element))
		CompilerRangeType(inner):
			compiler_resource_type_scan_contains(context, inner)
		CompilerDimOpType(_, left, right):
			(
				compiler_resource_type_scan_contains(context, left)
				or compiler_resource_type_scan_contains(context, right)
			)
		_:
			False


private pure func compiler_typecheck_type_contains_resource(
	context: CompilerResourceTypeScanContext,
	typ: CompilerType,
) -> Bool:
	compiler_resource_type_scan_contains(context, typ)


private pure func compiler_field_from_parsed_with_type(
	field: ParsedFieldDecl,
	field_type: CompilerType,
) -> CompilerFieldDecl:
	{
		name = field.name.text,
		field_type = field_type
	}


private pure func compiler_field_from_parsed(
	state: CompilerTypecheckState,
	field: ParsedFieldDecl,
) -> CompilerFieldDecl:
	compiler_field_from_parsed_with_type(
		field,
		compiler_canonical_annotation_type(
			state,
			compiler_type_from_parsed_type_expr(field.type_expr),
		),
	)


private pure func compiler_typed_record_field_from_parsed(
	state: CompilerTypecheckState,
	type_params: List[String],
	field: ParsedFieldDecl,
) -> CompilerTypedRecordFieldInfo:
	field_type = compiler_type_from_parsed_type_expr(field.type_expr)
	semantic_type = compiler_type_instantiate_type_params(
		type_params,
		compiler_canonical_annotation_type(state, field_type),
	)
	{
		name = field.name.text,
		source_type = field_type,
		semantic_type = semantic_type
	}


private pure func compiler_typed_record_from_parsed(
	state: CompilerTypecheckState,
	record_decl: ParsedRecordDecl,
) -> CompilerTypedRecordInfo:
	type_params = compiler_type_param_names(record_decl.type_params)
	{
		decl = record_decl,
		fields = record_decl.fields.map(
			func(field): compiler_typed_record_field_from_parsed(state, type_params, field),
		)
	}


private pure func compiler_typed_type_alias_from_parsed(
	state: CompilerTypecheckState,
	alias_decl: ParsedTypeAliasDecl,
) -> CompilerTypedTypeAliasInfo:
	source_target = compiler_type_from_parsed_type_expr(alias_decl.target)
	semantic_target = compiler_type_instantiate_type_params(
		compiler_type_param_names(alias_decl.type_params),
		compiler_canonical_annotation_type(state, source_target),
	)
	{
		decl = alias_decl,
		source_target_type = source_target,
		semantic_target_type = semantic_target
	}


private pure func compiler_typed_trait_method_from_parsed(
	state: CompilerTypecheckState,
	type_params: List[String],
	method: ParsedTraitMethodDecl,
) -> CompilerTypedTraitMethodInfo:
	registered: CompilerTraitMethodSig = compiler_trait_method_from_parsed(method, type_params)
	{
		decl = method,
		param_types = registered.params.map(func(param_type): compiler_type_instantiate_type_params(
				type_params,
				compiler_canonical_annotation_type(state, param_type),
			)),
		semantic_return_type = compiler_type_instantiate_type_params(
			type_params,
			compiler_canonical_annotation_type(state, registered.return_type),
		)
	}


private pure func compiler_typed_trait_from_parsed(
	state: CompilerTypecheckState,
	trait_decl: ParsedTraitDecl,
) -> CompilerTypedTraitInfo:
	type_params = compiler_type_param_names(trait_decl.type_params)
	{
		decl = trait_decl,
		methods = trait_decl.methods.map(
			func(method): compiler_typed_trait_method_from_parsed(state, type_params, method),
		)
	}


private pure func compiler_variant_from_parsed(
	state: CompilerTypecheckState,
	variant: ParsedVariantDecl,
	tag: Int,
) -> CompilerVariantDef:
	{
		name = variant.name.text,
		fields = variant.fields.map(
			func(
				field,
			): compiler_canonical_annotation_type(
				state,
				compiler_type_from_parsed_type_expr(field),
			),
		),
		tag = tag
	}


private pure func compiler_variants_from_parsed(
	state: CompilerTypecheckState,
	variants: List[ParsedVariantDecl],
) -> List[CompilerVariantDef]:
	var result: List[CompilerVariantDef] = []
	var tag: Int = 0

	for variant in variants:
		result = result.append(compiler_variant_from_parsed(state, variant, tag))
		tag += 1

	result


private pure func compiler_typed_union_variant_from_def(
	state: CompilerTypecheckState,
	parent_type: String,
	variant: CompilerVariantDef,
) -> CompilerTypedUnionVariantInfo:
	def_id: Option[Int] = match compiler_env_get_constructor_for_parent(
		state.env,
		parent_type,
		variant.name,
	):
		Some(ctor):
			Some(ctor.constructor_id)
		None:
			None

	{
		name = variant.name,
		fields = variant.fields,
		tag = variant.tag,
		def_id = def_id
	}


private pure func compiler_typed_union_variants_from_defs(
	state: CompilerTypecheckState,
	parent_type: String,
	variants: List[CompilerVariantDef],
) -> List[CompilerTypedUnionVariantInfo]:
	variants.map(func(variant): compiler_typed_union_variant_from_def(state, parent_type, variant))


private pure func compiler_typed_union_from_parsed(
	state: CompilerTypecheckState,
	union_decl: ParsedUnionDecl,
) -> CompilerTypedUnionInfo:
	variants: List[CompilerVariantDef] = match compiler_env_get_type_decl(
		state.env,
		union_decl.name.text,
	):
		Some(pair):
			pair[1]
		None:
			compiler_variants_from_parsed(state, union_decl.variants)

	type_params = compiler_type_param_names(union_decl.type_params)
	typed_variants = compiler_typed_union_variants_from_defs(
		state,
		union_decl.name.text,
		variants,
	).map(
		func(
			variant,
		): { variant |
			fields = variant.fields.map(
				func(field): compiler_type_instantiate_type_params(type_params, field),
			)
		},
	)

	{
		decl = union_decl,
		variants = typed_variants
	}


private pure func compiler_imported_field_from_parsed(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	type_params: List[String],
	field: ParsedFieldDecl,
) -> CompilerFieldDecl:
	compiler_field_from_parsed_with_type(
		field,
		compiler_type_instantiate_type_params(
			type_params,
			compiler_imported_annotation_type(
				state,
				import_state,
				module_path,
				local_type_names,
				compiler_type_from_parsed_type_expr(field.type_expr),
			),
		),
	)


private pure func compiler_imported_variant_from_parsed(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	type_params: List[String],
	variant: ParsedVariantDecl,
	tag: Int,
) -> CompilerVariantDef:
	{
		name = variant.name.text,
		fields = variant.fields.map(func(field): compiler_type_instantiate_type_params(
				type_params,
				compiler_imported_annotation_type(
					state,
					import_state,
					module_path,
					local_type_names,
					compiler_type_from_parsed_type_expr(field),
				),
			)),
		tag = tag
	}


private pure func compiler_imported_variants_from_parsed(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	type_params: List[String],
	variants: List[ParsedVariantDecl],
) -> List[CompilerVariantDef]:
	var result: List[CompilerVariantDef] = []
	var tag: Int = 0

	for variant in variants:
		result = result.append(
			compiler_imported_variant_from_parsed(
				state,
				import_state,
				module_path,
				local_type_names,
				type_params,
				variant,
				tag,
			),
		)
		tag += 1

	result


private pure func compiler_variant_contains_resource(
	context: CompilerResourceTypeScanContext,
	variant: CompilerVariantDef,
) -> Bool:
	variant.fields.any(func(field):
		compiler_typecheck_type_contains_resource(context, field)
	)


private pure func compiler_variants_contain_resource(
	context: CompilerResourceTypeScanContext,
	variants: List[CompilerVariantDef],
) -> Bool:
	var result: Bool = False

	for variant in variants:
		if compiler_variant_contains_resource(context, variant):
			result = True
			break

	result


private pure func compiler_fields_contain_resource(
	context: CompilerResourceTypeScanContext,
	fields: List[CompilerFieldDecl],
) -> Bool:
	fields.any(func(field):
		compiler_typecheck_type_contains_resource(context, field.field_type)
	)


private pure func compiler_type_from_optional_parsed_type_expr(
	type_expr: Option[ParsedTypeExpr],
) -> CompilerType:
	match type_expr:
		Some(typ):
			compiler_type_from_parsed_type_expr(typ)
		None:
			compiler_type_void()


private pure func compiler_param_type_from_parsed(param: ParsedParam) -> CompilerType:
	compiler_type_from_optional_parsed_type_expr(param.type_expr)


private pure func compiler_param_name_from_parsed(param: ParsedParam) -> Option[String]:
	match param.binder:
		ParsedParamNameBinder(name):
			Some(name.text)
		ParsedParamWildcardBinder(_):
			None
		ParsedParamTupleBinder(_, _):
			None


private pure func compiler_param_types_from_parsed(params: List[ParsedParam]) -> List[CompilerType]:
	params.map(compiler_param_type_from_parsed)


private pure func compiler_param_names_from_parsed(
	params: List[ParsedParam],
) -> List[Option[String]]:
	params.map(compiler_param_name_from_parsed)


private pure func compiler_param_annotation_type(param: ParsedParam) -> Option[CompilerType]:
	param.type_expr.map(compiler_type_from_parsed_type_expr)


private pure func compiler_typed_param_types_from_parsed(
	params: List[ParsedParam],
) -> List[CompilerType]:
	params.filter_map(compiler_param_annotation_type)


private pure func compiler_dim_constraint_from_parsed(
	constraint: ParsedDimConstraint,
) -> (CompilerType, CompilerType):
	(
		compiler_type_from_parsed_type_expr(constraint.left),
		compiler_type_from_parsed_type_expr(constraint.right),
	)


private pure func compiler_dim_constraints_from_parsed(
	constraints: List[ParsedDimConstraint],
) -> List[(CompilerType, CompilerType)]:
	constraints.map(compiler_dim_constraint_from_parsed)


private pure func compiler_canonical_dim_constraint_from_parsed(
	state: CompilerTypecheckState,
	constraint: ParsedDimConstraint,
) -> (CompilerType, CompilerType):
	(
		compiler_canonical_annotation_type(
			state,
			compiler_type_from_parsed_type_expr(constraint.left),
		),
		compiler_canonical_annotation_type(
			state,
			compiler_type_from_parsed_type_expr(constraint.right),
		),
	)


private pure func compiler_canonical_dim_constraints_from_parsed(
	state: CompilerTypecheckState,
	constraints: List[ParsedDimConstraint],
) -> List[(CompilerType, CompilerType)]:
	constraints.map(
		func(constraint): compiler_canonical_dim_constraint_from_parsed(state, constraint),
	)


private pure func compiler_imported_dim_constraint_from_parsed(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	constraint: ParsedDimConstraint,
) -> (CompilerType, CompilerType):
	(
		compiler_imported_annotation_type(
			state,
			import_state,
			module_path,
			local_type_names,
			compiler_type_from_parsed_type_expr(constraint.left),
		),
		compiler_imported_annotation_type(
			state,
			import_state,
			module_path,
			local_type_names,
			compiler_type_from_parsed_type_expr(constraint.right),
		),
	)


private pure func compiler_imported_dim_constraints_from_parsed(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	constraints: List[ParsedDimConstraint],
) -> List[(CompilerType, CompilerType)]:
	constraints.map(
		func(
			constraint,
		): compiler_imported_dim_constraint_from_parsed(
			state,
			import_state,
			module_path,
			local_type_names,
			constraint,
		),
	)


private pure func compiler_purity_from_parsed(is_pure: Bool) -> CompilerPurity:
	if is_pure:
		CompilerPure
	else:
		CompilerImpure


private pure func compiler_annotation_is_debug_only(annotation: ParsedFunctionAnnotation) -> Bool:
	match annotation:
		ParsedDebugOnlyAnnotation:
			True
		_:
			False


private pure func compiler_function_debug_only(annotations: List[ParsedFunctionAnnotation]) -> Bool:
	annotations.any(compiler_annotation_is_debug_only)


private pure func compiler_annotation_is_tail_recursive(
	annotation: ParsedFunctionAnnotation,
) -> Bool:
	match annotation:
		ParsedTailRecursiveAnnotation:
			True
		_:
			False


private pure func compiler_function_tail_recursive(
	annotations: List[ParsedFunctionAnnotation],
) -> Bool:
	annotations.any(compiler_annotation_is_tail_recursive)


private pure func compiler_annotation_is_no_copy(annotation: ParsedFunctionAnnotation) -> Bool:
	match annotation:
		ParsedNoCopyAnnotation:
			True
		_:
			False


private pure func compiler_function_no_copy(annotations: List[ParsedFunctionAnnotation]) -> Bool:
	annotations.any(compiler_annotation_is_no_copy)


private pure func compiler_annotation_has_ordinary_resource_result(
	annotation: ParsedFunctionAnnotation,
) -> Bool:
	match annotation:
		ParsedResourceResultOrdinaryAnnotation:
			True
		_:
			False


private pure func compiler_function_resource_result_ordinary(
	annotations: List[ParsedFunctionAnnotation],
) -> Bool:
	annotations.any(compiler_annotation_has_ordinary_resource_result)


private pure func compiler_function_builtin_resource_result_policy(
	body: Option[ParsedExpr],
) -> CompilerResourceResultPolicy:
	match parsed_function_body_kind(body):
		ParsedFunctionBuiltinBody(Some(builtin_name)):
			compiler_builtin_resource_result_policy(builtin_name)
		_:
			CompilerResourceResultDependent


private pure func compiler_type_contains_scoped_dependency_carrier(typ: CompilerType) -> Bool:
	match typ:
		CompilerNamedType(name, args):
			(
				compiler_is_one_shot_stream_type_name(name)
				or compiler_is_resource_source_type_name(name)
				or args.any(compiler_type_contains_scoped_dependency_carrier)
			)
		CompilerFunctionType(_, params, return_type):
			(
				params.any(compiler_type_contains_scoped_dependency_carrier)
				or compiler_type_contains_scoped_dependency_carrier(return_type)
			)
		CompilerArrayType(element, dims):
			(
				compiler_type_contains_scoped_dependency_carrier(element)
				or dims.any(compiler_type_contains_scoped_dependency_carrier)
			)
		CompilerTupleType(elements):
			elements.any(compiler_type_contains_scoped_dependency_carrier)
		CompilerRangeType(inner):
			compiler_type_contains_scoped_dependency_carrier(inner)
		CompilerDimOpType(_, left, right):
			(
				compiler_type_contains_scoped_dependency_carrier(left)
				or compiler_type_contains_scoped_dependency_carrier(right)
			)
		_:
			False


private pure func compiler_function_resource_arg_policy(
	state: CompilerTypecheckState,
	param_types: List[CompilerType],
	annotations: List[ParsedFunctionAnnotation],
	body: Option[ParsedExpr],
) -> CompilerResourceArgPolicy:
	if not parsed_function_body_is_builtin(body):
		CompilerRejectResourceArgs
	else:
		var has_resource_param: Bool = False
		var has_scoped_dependency_param: Bool = False

		for param_type in param_types:
			if compiler_typecheck_type_contains_resource(
				compiler_resource_type_scan_context(state.env, state.known_resource_type_names),
				param_type,
			):
				has_resource_param = True

			if compiler_type_contains_scoped_dependency_carrier(param_type):
				has_scoped_dependency_param = True

			if has_resource_param and has_scoped_dependency_param:
				break

		if has_resource_param or has_scoped_dependency_param:
			result_policy: CompilerResourceResultPolicy = if compiler_function_resource_result_ordinary(
				annotations,
			):
				CompilerResourceResultOrdinary
			else:
				compiler_function_builtin_resource_result_policy(body)

			CompilerAllowResourceArgs(result_policy)
		else:
			CompilerRejectResourceArgs


private pure func compiler_validate_resource_result_annotation(
	state: CompilerTypecheckState,
	name: String,
	param_types: List[CompilerType],
	return_type: CompilerType,
	annotations: List[ParsedFunctionAnnotation],
	body: Option[ParsedExpr],
) -> CompilerTypecheckState:
	if not compiler_function_resource_result_ordinary(annotations):
		state
	else if not parsed_function_body_is_builtin(body):
		compiler_typecheck_state_add_error(
			state,
			(
				"@resource_result_ordinary can only be used on builtin resource operation "
				+ "declarations"
			),
		)
	else if compiler_typecheck_type_contains_resource(
		compiler_resource_type_scan_context(state.env, state.known_resource_type_names),
		return_type,
	):
		compiler_typecheck_state_add_error(
			state,
			"@resource_result_ordinary cannot be used on builtin '" + name + "' because its return type contains a resource",
		)
	else:
		var has_resource_param: Bool = False
		var has_scoped_dependency_param: Bool = False

		for param_type in param_types:
			if compiler_typecheck_type_contains_resource(
				compiler_resource_type_scan_context(state.env, state.known_resource_type_names),
				param_type,
			):
				has_resource_param = True

			if compiler_type_contains_scoped_dependency_carrier(param_type):
				has_scoped_dependency_param = True

			if has_resource_param or has_scoped_dependency_param:
				break

		if not (has_resource_param or has_scoped_dependency_param):
			compiler_typecheck_state_add_error(
				state,
				"@resource_result_ordinary requires builtin '" + name + "' to have a direct resource or scoped dependency parameter",
			)
		else:
			state


private pure func compiler_validate_resource_signature_boundary(
	state: CompilerTypecheckState,
	name: String,
	params: List[ParsedParam],
	param_types: List[CompilerType],
	return_type: CompilerType,
	body: Option[ParsedExpr],
) -> CompilerTypecheckState:
	if params.length() != param_types.length():
		compiler_typecheck_state_add_error(
			state,
			(
				"internal typecheck error: semantic parameter count does not match parsed "
				+ "parameter count for function '"
			) + name + "'",
		)
	else if parsed_function_body_is_builtin(body):
		state
	else:
		var next = state
		var param_index: Int = 0

		for param_type in param_types:
			if compiler_typecheck_type_contains_resource(
				compiler_resource_type_scan_context(next.env, next.known_resource_type_names),
				param_type,
			):
				param_name: String = match params.get(param_index):
					Some(param):
						compiler_param_name_from_parsed(param).get_or("_")
					None:
						"_"

				next = compiler_typecheck_state_add_error(
					next,
					"Function '" + name + "' parameter '" + param_name + "' cannot contain a resource type",
				)

			param_index += 1

		if compiler_typecheck_type_contains_resource(
			compiler_resource_type_scan_context(next.env, next.known_resource_type_names),
			return_type,
		):
			compiler_typecheck_state_add_error(
				next,
				"Function '" + name + "' return type cannot contain a resource type",
			)
		else:
			next


private pure func compiler_callable_key_from_span(
	name: String,
	span: CompilerSourceSpan,
) -> CompilerFuncCallableKey:
	compiler_func_callable_key(name, span)


private pure func compiler_supertrait_names_from_parsed(
	supertraits: List[ParsedIdentifier],
) -> List[String]:
	supertraits.map(func(name): name.text)


private pure func compiler_trait_method_from_parsed(
	method: ParsedTraitMethodDecl,
	type_params: List[String],
) -> CompilerTraitMethodSig:
	name: String = method.name.text
	params: List[CompilerType] = compiler_typed_param_types_from_parsed(
		method.params,
	).map(
		func(param): compiler_type_instantiate_type_params(type_params, param),
	)
	return_type: CompilerType = compiler_type_instantiate_type_params(
		type_params,
		compiler_type_from_optional_parsed_type_expr(method.return_type),
	)
	is_pure: Bool = method.is_pure
	has_default: Bool = method.body.is_some()
	param_names: List[Option[String]] = compiler_param_names_from_parsed(method.params)

	compiler_trait_method_sig_with_details(
		name,
		params,
		return_type,
		is_pure,
		has_default,
		param_names,
	)


private pure func compiler_trait_methods_from_parsed(
	methods: List[ParsedTraitMethodDecl],
	type_params: List[String],
) -> List[CompilerTraitMethodSig]:
	methods.map(func(method): compiler_trait_method_from_parsed(method, type_params))


pure func compiler_typecheck_prescan_decl(
	state: CompilerTypecheckState,
	decl: ParsedDecl,
) -> CompilerTypecheckState:
	match decl:
		RecordParsedDecl(record_decl):
			compiler_typecheck_state_remember_top_level_name(
				compiler_typecheck_state_add_known_type_name(state, record_decl.name.text),
				record_decl.name.text,
				CompilerTopLevelType,
			)
		UnionParsedDecl(union_decl):
			var next = compiler_typecheck_state_remember_top_level_name(
				compiler_typecheck_state_add_known_type_name(state, union_decl.name.text),
				union_decl.name.text,
				CompilerTopLevelType,
			)

			for variant in union_decl.variants:
				next = compiler_typecheck_state_remember_top_level_name(
					next,
					variant.name.text,
					CompilerTopLevelConstructor,
				)

			next
		BuiltinTypeParsedDecl(type_decl):
			with_type = if type_decl.is_resource:
				compiler_typecheck_state_add_known_resource_type_name(state, type_decl.name.text)
			else:
				compiler_typecheck_state_add_known_type_name(state, type_decl.name.text)

			compiler_typecheck_state_remember_top_level_name(
				with_type,
				type_decl.name.text,
				CompilerTopLevelType,
			)
		TypeAliasParsedDecl(alias_decl):
			compiler_typecheck_state_remember_top_level_name(
				compiler_typecheck_state_add_known_type_name(state, alias_decl.name.text),
				alias_decl.name.text,
				CompilerTopLevelType,
			)
		FunctionParsedDecl(function_decl):
			compiler_typecheck_state_remember_top_level_name(
				state,
				function_decl.name.text,
				CompilerTopLevelFunction,
			)
		VarParsedDecl(var_decl):
			compiler_typecheck_state_remember_top_level_name(
				state,
				var_decl.name.text,
				CompilerTopLevelVariable,
			)
		TraitParsedDecl(trait_decl):
			compiler_typecheck_state_remember_top_level_name(
				state,
				trait_decl.name.text,
				CompilerTopLevelTrait,
			)
		ForeignBlockParsedDecl(_, functions, _):
			var next = state

			for function_decl in functions:
				next = compiler_typecheck_state_remember_top_level_name(
					next,
					function_decl.name.text,
					CompilerTopLevelFunction,
				)

			next
		PrivateParsedDecl(inner, _):
			compiler_typecheck_prescan_decl(state, inner)
		ImportBlockParsedDecl(_, _):
			state
		ImplParsedDecl(_):
			state
		ParsedErrorDecl(_):
			state


pure func compiler_typecheck_prescan_decls(
	state: CompilerTypecheckState,
	decls: List[ParsedDecl],
) -> CompilerTypecheckState:
	var next = state

	for decl in decls:
		next = compiler_typecheck_prescan_decl(next, decl)

	next


pure func compiler_typecheck_prescan_program(
	state: CompilerTypecheckState,
	program: ParsedProgram,
) -> CompilerTypecheckState:
	compiler_typecheck_prescan_decls(state, program.decls)


pure func compiler_typecheck_register_program_import_decls(
	state: CompilerTypecheckState,
	program: ParsedProgram,
) -> CompilerTypecheckState:
	compiler_register_program_import_syntax(state, program)


private pure func compiler_reserved_constructor_ids(
	state: CompilerTypecheckState,
	union_decl: ParsedUnionDecl,
) -> List[Option[Int]]:
	var ids: List[Option[Int]] = []

	for variant in union_decl.variants:
		ids = ids.append(
			compiler_typecheck_state_find_source_definition_id(
				state,
				compiler_source_definition_key(
					CompilerConstructorDefinition,
					variant.name.text,
					Some(union_decl.name.text),
					variant.span,
				),
			),
		)

	ids


private pure func compiler_register_union_decl(
	state: CompilerTypecheckState,
	module_path: String,
	union_decl: ParsedUnionDecl,
) -> CompilerTypecheckState:
	var next = if union_decl.is_enum and union_decl.type_params.length() > 0:
		compiler_typecheck_state_add_error(
			state,
			"Enum '" + union_decl.name.text + "' cannot have type parameters",
		)
	else:
		state

	if union_decl.is_enum:
		for variant in union_decl.variants:
			if variant.fields.length() > 0:
				next = compiler_typecheck_state_add_error(
					next,
					"Enum variant '" + variant.name.text + "' cannot have fields; use 'union' instead",
				)

	type_params = compiler_type_param_names(union_decl.type_params)
	variants: List[CompilerVariantDef] = compiler_variants_from_parsed(
		next,
		union_decl.variants,
	).map(
		func(
			variant,
		): { variant |
			fields = variant.fields.map(
				func(field): compiler_type_instantiate_type_params(type_params, field),
			)
		},
	)

	type_kind: CompilerTypeKind = if union_decl.is_enum:
		CompilerTypeEnum
	else:
		CompilerTypeUnion

	contains_resource: Bool = compiler_variants_contain_resource(
		compiler_resource_type_scan_context(next.env, next.known_resource_type_names),
		variants,
	)
	constructor_ids = compiler_reserved_constructor_ids(next, union_decl)
	env: CompilerEnv = compiler_env_add_type_with_constructor_ids(
		next.env,
		union_decl.name.text,
		compiler_type_param_names(union_decl.type_params),
		variants,
		type_kind,
		contains_resource,
		True,
		constructor_ids,
	)
	with_env = compiler_typecheck_state_with_env(next, env)
	compiler_typecheck_state_record_type_home(with_env, union_decl.name.text, module_path, False)


private pure func compiler_register_builtin_type_decl(
	state: CompilerTypecheckState,
	module_path: String,
	type_decl: ParsedBuiltinTypeDecl,
) -> CompilerTypecheckState:
	var next = if compiler_typecheck_state_allows_builtin(state):
		state
	else:
		prefix: String = if type_decl.is_resource:
			"resource type "
		else:
			"type "

		compiler_typecheck_state_add_error(
			state,
			"'" + prefix + type_decl.name.text + " = builtin' can only be used in the standard library",
		)

	next = if type_decl.is_resource:
		compiler_typecheck_state_add_known_resource_type_name(next, type_decl.name.text)
	else:
		compiler_typecheck_state_add_known_type_name(next, type_decl.name.text)

	type_kind: CompilerTypeKind = if type_decl.is_resource:
		CompilerTypeResource
	else:
		CompilerTypeBuiltin

	env: CompilerEnv = compiler_env_add_type(
		next.env,
		type_decl.name.text,
		compiler_type_param_names(type_decl.type_params),
		[],
		type_kind,
		type_decl.is_resource,
		False,
	)
	with_env = compiler_typecheck_state_with_env(next, env)

	with_cleanup = match type_decl.cleanup:
		Some(cleanup):
			{ with_env |
				context = compiler_register_resource_cleanup(
					with_env.context,
					type_decl.name.text,
					cleanup.builtin_name,
				)
			}
		None:
			with_env

	compiler_typecheck_state_record_type_home(with_cleanup, type_decl.name.text, module_path, False)


private pure func compiler_register_record_decl(
	state: CompilerTypecheckState,
	module_path: String,
	record_decl: ParsedRecordDecl,
) -> CompilerTypecheckState:
	var next = state

	if record_decl.is_struct and record_decl.type_params.length() > 0:
		next = compiler_typecheck_state_add_error(
			next,
			"Struct '" + record_decl.name.text + "' cannot have type parameters",
		)

	if record_decl.is_struct and record_decl.fields.length() == 0:
		next = compiler_typecheck_state_add_error(
			next,
			"Struct '" + record_decl.name.text + "' must have at least one field",
		)

	type_params = compiler_type_param_names(record_decl.type_params)
	var fields: List[CompilerFieldDecl] = []

	for field in record_decl.fields:
		semantic_field = compiler_field_from_parsed(next, field)
		fields = fields.append(
			{ semantic_field |
				field_type = compiler_type_instantiate_type_params(
					type_params,
					semantic_field.field_type,
				)
			},
		)

	env: CompilerEnv = compiler_env_add_record(
		next.env,
		record_decl.name.text,
		type_params,
		fields,
		record_decl.is_struct,
		compiler_fields_contain_resource(
			compiler_resource_type_scan_context(next.env, next.known_resource_type_names),
			fields,
		),
	)
	with_env = compiler_typecheck_state_with_env(next, env)
	compiler_typecheck_state_record_type_home(with_env, record_decl.name.text, module_path, False)


private pure func compiler_register_type_alias_decl(
	state: CompilerTypecheckState,
	module_path: String,
	alias_decl: ParsedTypeAliasDecl,
) -> CompilerTypecheckState:
	type_params = compiler_type_param_names(alias_decl.type_params)
	target = compiler_type_instantiate_type_params(
		type_params,
		compiler_type_from_parsed_type_expr(alias_decl.target),
	)

	env: CompilerEnv = if alias_decl.is_opaque:
		compiler_env_add_opaque_alias(
			state.env,
			alias_decl.name.text,
			type_params,
			target,
			Some(module_path),
		)
	else:
		compiler_env_add_alias(state.env, alias_decl.name.text, type_params, target)

	with_env = compiler_typecheck_state_with_env(
		compiler_typecheck_state_add_known_type_name(state, alias_decl.name.text),
		env,
	)

	if alias_decl.is_opaque:
		compiler_typecheck_state_record_type_home(
			with_env,
			alias_decl.name.text,
			module_path,
			False,
		)
	else:
		with_env


pure func compiler_typecheck_register_type_decl(
	state: CompilerTypecheckState,
	module_path: String,
	decl: ParsedDecl,
) -> CompilerTypecheckState:
	match decl:
		RecordParsedDecl(record_decl):
			compiler_register_record_decl(state, module_path, record_decl)
		UnionParsedDecl(union_decl):
			compiler_register_union_decl(state, module_path, union_decl)
		BuiltinTypeParsedDecl(type_decl):
			compiler_register_builtin_type_decl(state, module_path, type_decl)
		TypeAliasParsedDecl(alias_decl):
			compiler_register_type_alias_decl(state, module_path, alias_decl)
		PrivateParsedDecl(inner, _):
			compiler_typecheck_register_type_decl(state, module_path, inner)
		_:
			state


pure func compiler_typecheck_register_type_decls(
	state: CompilerTypecheckState,
	module_path: String,
	decls: List[ParsedDecl],
) -> CompilerTypecheckState:
	var next = state

	for decl in decls:
		next = compiler_typecheck_register_type_decl(next, module_path, decl)

	next


pure func compiler_typecheck_register_program_type_decls(
	state: CompilerTypecheckState,
	program: ParsedProgram,
) -> CompilerTypecheckState:
	compiler_typecheck_register_type_decls(state, program.source.module_name, program.decls)


private pure func compiler_register_var_decl_with_type(
	state: CompilerTypecheckState,
	module_path: String,
	var_decl: ParsedVarDecl,
	var_type: CompilerType,
	source_type: Option[CompilerType],
) -> CompilerTypecheckState:
	env: CompilerEnv = compiler_env_add_var_with_module_details(
		state.env,
		var_decl.name.text,
		var_type,
		source_type,
		compiler_var_mutability(var_decl.is_mutable),
		CompilerLetBinding,
		compiler_unrefined_binding(),
		Some(module_path),
	)

	compiler_typecheck_state_with_env(state, env)


private pure func compiler_register_var_decl(
	state: CompilerTypecheckState,
	module_path: String,
	var_decl: ParsedVarDecl,
) -> CompilerTypecheckState:
	source_type: Option[CompilerType] = match var_decl.type_expr:
		Some(type_expr):
			Some(compiler_type_from_parsed_type_expr(type_expr))
		None:
			None

	var_type: CompilerType = compiler_canonical_annotation_type(
		state,
		compiler_type_from_optional_parsed_type_expr(var_decl.type_expr),
	)

	compiler_register_var_decl_with_type(state, module_path, var_decl, var_type, source_type)


private pure func compiler_register_imported_var_decl(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	var_decl: ParsedVarDecl,
) -> CompilerTypecheckState:
	source_type: Option[CompilerType] = match var_decl.type_expr:
		Some(type_expr):
			Some(
				compiler_imported_annotation_type(
					state,
					import_state,
					module_path,
					local_type_names,
					compiler_type_from_parsed_type_expr(type_expr),
				),
			)
		None:
			None

	var_type: CompilerType = match source_type:
		Some(typ):
			typ
		None:
			compiler_type_void()

	compiler_register_var_decl_with_type(state, module_path, var_decl, var_type, source_type)


private pure func compiler_register_function_signature(
	state: CompilerTypecheckState,
	name: String,
	params: List[ParsedParam],
	return_type: CompilerType,
	type_params: List[ParsedTypeParamDecl],
	dim_constraints: List[ParsedDimConstraint],
	is_pure: Bool,
	annotations: List[ParsedFunctionAnnotation],
	body: Option[ParsedExpr],
	span: CompilerSourceSpan,
	module_path: Option[String],
	origin: CompilerFuncOrigin,
) -> CompilerTypecheckState:
	declared_type_param_names = compiler_type_param_names(type_params)
	param_types: List[CompilerType] = compiler_param_types_from_parsed(
		params,
	).map(
		func(
			param_type,
		): compiler_canonical_function_annotation_type(
			state,
			declared_type_param_names,
			param_type,
		),
	)
	resolved_return_type: CompilerType = compiler_canonical_function_annotation_type(
		state,
		declared_type_param_names,
		return_type,
	)
	semantic_dim_constraints: List[(CompilerType, CompilerType)] = compiler_canonical_dim_constraints_from_parsed(
		state,
		dim_constraints,
	)

	compiler_register_function_signature_with_semantic_types(
		state,
		name,
		params,
		param_types,
		resolved_return_type,
		type_params,
		semantic_dim_constraints,
		is_pure,
		annotations,
		body,
		span,
		module_path,
		origin,
	)


private pure func compiler_type_param_candidate_name_is_valid(name: String) -> Bool:
	if name == "#_":
		True
	else:
		base = if name.length() > 1 and name.get_or(0, ' ') == '#':
			name.substring(1, name.length())
		else:
			name

		if base.length() == 0:
			False
		else:
			first = base.get_or(0, ' ')
			var valid = first >= 'A' and first <= 'Z'
			var index: Int = 1

			while valid and index < base.length():
				ch = base.get_or(index, ' ')
				valid = (
					ch >= 'A' and ch <= 'Z'
					or ch >= 'a' and ch <= 'z'
					or ch >= '0' and ch <= '9'
				)

				index += 1

			valid


private pure func compiler_type_param_candidates_from_types(
	types: List[CompilerType],
) -> List[String]:
	types.flat_map(compiler_type_param_candidates)


private pure func compiler_type_param_candidates(typ: CompilerType) -> List[String]:
	match typ:
		CompilerTypeVar(name):
			[name]
		CompilerNamedType(name, args):
			if args.length() == 0 and compiler_type_param_candidate_name_is_valid(name):
				[name]
			else:
				compiler_type_param_candidates_from_types(args)
		CompilerArrayType(element, dims):
			compiler_type_param_candidates(
				element,
			).concat(compiler_type_param_candidates_from_types(dims))
		CompilerFunctionType(_, params, return_type):
			compiler_type_param_candidates_from_types(
				params,
			).concat(compiler_type_param_candidates(return_type))
		CompilerTupleType(elements):
			compiler_type_param_candidates_from_types(elements)
		CompilerRangeType(inner):
			compiler_type_param_candidates(inner)
		CompilerDimOpType(_, left, right):
			compiler_type_param_candidates(left).concat(compiler_type_param_candidates(right))
		_:
			[]


private pure func compiler_state_has_type_name(state: CompilerTypecheckState, name: String) -> Bool:
	(
		compiler_is_global_abi_type_name(name)
		or state.known_type_names.contains(name)
		or compiler_env_get_type_decl(state.env, name).is_some()
		or compiler_env_get_record(state.env, name).is_some()
		or compiler_env_get_alias(state.env, name).is_some()
		or compiler_env_get_opaque_alias(state.env, name).is_some()
	)


private pure func compiler_effective_bound_type_params(
	state: CompilerTypecheckState,
	declared: List[ParsedTypeParamDecl],
	func_type: CompilerType,
) -> List[CompilerBoundTypeParam]:
	var result = compiler_bound_type_params_from_parsed(declared)
	var seen = result.map(func(param): param.name)

	for name in compiler_type_param_candidates(func_type):
		if (
			name != "#_"
			and not seen.contains(name)
			and not compiler_state_has_type_name(state, name)
		):
			seen = seen.append(name)
			result = result.append(compiler_make_bound_type_param(name, []))

	result


private pure func compiler_effective_function_type_params(
	state: CompilerTypecheckState,
	function_decl: ParsedFunctionDecl,
) -> List[CompilerBoundTypeParam]:
	declared_type_param_names = compiler_type_param_names(function_decl.type_params)
	param_types = compiler_param_types_from_parsed(
		function_decl.params,
	).map(
		func(
			param_type,
		): compiler_canonical_function_annotation_type(
			state,
			declared_type_param_names,
			param_type,
		),
	)
	return_type = compiler_canonical_return_type(
		state,
		declared_type_param_names,
		function_decl.return_type,
	).get_or(compiler_type_void())
	compiler_effective_bound_type_params(
		state,
		function_decl.type_params,
		CompilerFunctionType(function_decl.is_pure, param_types, return_type),
	)


private pure func compiler_function_body_signature_from_annotations(
	state: CompilerTypecheckState,
	function_decl: ParsedFunctionDecl,
	callable_id: Option[Int],
) -> CompilerFunctionBodySignature:
	effective_type_params = compiler_effective_function_type_params(state, function_decl)
	type_param_names = effective_type_params.map(func(param): param.name)
	declared_type_param_names = compiler_type_param_names(function_decl.type_params)
	param_types = compiler_param_types_from_parsed(
		function_decl.params,
	).map(
		func(param_type): compiler_type_instantiate_type_params(
			type_param_names,
			compiler_canonical_function_annotation_type(
				state,
				declared_type_param_names,
				param_type,
			),
		),
	)

	semantic_return_type = match compiler_canonical_return_type(
		state,
		declared_type_param_names,
		function_decl.return_type,
	):
		Some(return_type):
			compiler_type_instantiate_type_params(type_param_names, return_type)
		None:
			compiler_type_void()

	{
		callable_id = callable_id,
		effective_type_params = effective_type_params,
		param_types = param_types,
		semantic_return_type = semantic_return_type
	}


private pure func compiler_function_body_signature(
	state: CompilerTypecheckState,
	function_decl: ParsedFunctionDecl,
) -> CompilerFunctionBodySignature:
	callable_id = compiler_typecheck_state_find_func_callable_id(
		state,
		compiler_callable_key_from_span(function_decl.name.text, function_decl.span),
	)

	match callable_id:
		Some(def_id):
			match compiler_env_find_func_named_by_def_id(
				state.env,
				function_decl.name.text,
				def_id,
			):
				Some(symbol):
					match symbol.func_type:
						CompilerFunctionType(_, param_types, return_type):
							{
								callable_id = callable_id,
								effective_type_params = symbol.type_params,
								param_types = param_types,
								semantic_return_type = return_type
							}
						_:
							compiler_function_body_signature_from_annotations(
								state,
								function_decl,
								callable_id,
							)
				None:
					compiler_function_body_signature_from_annotations(
						state,
						function_decl,
						callable_id,
					)
		None:
			compiler_function_body_signature_from_annotations(state, function_decl, None)


private pure func compiler_function_declared_return_type(
	function_decl: ParsedFunctionDecl,
	signature: CompilerFunctionBodySignature,
) -> Option[CompilerType]:
	if function_decl.return_type.is_some():
		Some(signature.semantic_return_type)
	else:
		None


private pure func compiler_loop_producer_from_expr(
	expr: ParsedExpr,
) -> Option[CompilerLoopProducer]:
	match expr:
		ParsedBuiltinExpr(Some("std/tensor.indices"), _):
			Some(CompilerLoopProducerIndices)
		ParsedBuiltinExpr(Some("std/tensor.enumerate"), _):
			Some(CompilerLoopProducerEnumerate)
		ParsedBuiltinExpr(Some("std/tensor.enumerate2"), _):
			Some(CompilerLoopProducerEnumerate2)
		ParsedBuiltinExpr(Some("std/tensor.windows"), _):
			Some(CompilerLoopProducerWindows)
		ParsedBlockExpr(items, _):
			if items.length() == 1:
				match items.get(0):
					Some(item):
						compiler_loop_producer_from_expr(item)
					None:
						None
			else:
				None
		_:
			None


private pure func compiler_loop_producer_from_body(
	body: Option[ParsedExpr],
) -> Option[CompilerLoopProducer]:
	match body:
		Some(expr):
			compiler_loop_producer_from_expr(expr)
		None:
			None


private pure func compiler_register_function_signature_with_semantic_types(
	state: CompilerTypecheckState,
	name: String,
	params: List[ParsedParam],
	param_types: List[CompilerType],
	resolved_return_type: CompilerType,
	type_params: List[ParsedTypeParamDecl],
	dim_constraints: List[(CompilerType, CompilerType)],
	is_pure: Bool,
	annotations: List[ParsedFunctionAnnotation],
	body: Option[ParsedExpr],
	span: CompilerSourceSpan,
	module_path: Option[String],
	origin: CompilerFuncOrigin,
) -> CompilerTypecheckState:
	source_func_type: CompilerType = CompilerFunctionType(
		is_pure,
		param_types,
		resolved_return_type,
	)
	effective_type_params = compiler_effective_bound_type_params(
		state,
		type_params,
		source_func_type,
	)
	type_param_names = effective_type_params.map(func(param): param.name)
	semantic_param_types = param_types.map(
		func(param): compiler_type_instantiate_type_params(type_param_names, param),
	)
	semantic_return_type = compiler_type_instantiate_type_params(
		type_param_names,
		resolved_return_type,
	)
	func_type: CompilerType = CompilerFunctionType(
		is_pure,
		semantic_param_types,
		semantic_return_type,
	)
	semantic_dim_constraints = dim_constraints.map(
		func(
			constraint,
		): (
			compiler_type_instantiate_type_params(type_param_names, constraint[0]),
			compiler_type_instantiate_type_params(type_param_names, constraint[1]),
		),
	)
	with_resource_result = compiler_validate_resource_result_annotation(
		state,
		name,
		semantic_param_types,
		semantic_return_type,
		annotations,
		body,
	)
	with_resource_boundary = compiler_validate_resource_signature_boundary(
		with_resource_result,
		name,
		params,
		semantic_param_types,
		semantic_return_type,
		body,
	)
	resource_arg_policy = compiler_function_resource_arg_policy(
		with_resource_boundary,
		semantic_param_types,
		annotations,
		body,
	)
	loop_producer = compiler_loop_producer_from_body(body)

	callable_key = compiler_callable_key_from_span(name, span)

	match compiler_typecheck_state_find_func_callable_id(with_resource_boundary, callable_key):
		Some(reserved_id):
			compiler_register_function_with_id(
				with_resource_boundary,
				reserved_id,
				callable_key,
				name,
				func_type,
				effective_type_params,
				params,
				is_pure,
				origin,
				resource_arg_policy,
				module_path,
				semantic_dim_constraints,
				loop_producer,
				annotations,
			)
		None:
			match compiler_env_mint_def_id(with_resource_boundary.env):
				(next_env, def_id):
					compiler_register_function_with_id(
						compiler_typecheck_state_with_env(with_resource_boundary, next_env),
						def_id,
						callable_key,
						name,
						func_type,
						effective_type_params,
						params,
						is_pure,
						origin,
						resource_arg_policy,
						module_path,
						semantic_dim_constraints,
						loop_producer,
						annotations,
					)


private pure func compiler_register_function_with_id(
	state: CompilerTypecheckState,
	def_id: Int,
	callable_key: CompilerFuncCallableKey,
	name: String,
	func_type: CompilerType,
	effective_type_params: List[CompilerBoundTypeParam],
	params: List[ParsedParam],
	is_pure: Bool,
	origin: CompilerFuncOrigin,
	resource_arg_policy: CompilerResourceArgPolicy,
	module_path: Option[String],
	dim_constraints: List[(CompilerType, CompilerType)],
	loop_producer: Option[CompilerLoopProducer],
	annotations: List[ParsedFunctionAnnotation],
) -> CompilerTypecheckState:
	env: CompilerEnv = compiler_env_add_func_with_info(
		state.env,
		name,
		compiler_func_symbol(
			def_id,
			func_type,
			effective_type_params,
			compiler_param_names_from_parsed(params),
			compiler_purity_from_parsed(is_pure),
			origin,
			resource_arg_policy,
			module_path,
			dim_constraints,
			loop_producer,
			compiler_function_debug_only(annotations),
		),
	)
	with_env = compiler_typecheck_state_with_env(state, env)
	compiler_typecheck_state_record_func_callable_id(with_env, callable_key, def_id)


private pure func compiler_register_function_decl(
	state: CompilerTypecheckState,
	function_decl: ParsedFunctionDecl,
) -> CompilerTypecheckState:
	compiler_register_function_signature(
		state,
		function_decl.name.text,
		function_decl.params,
		compiler_type_from_optional_parsed_type_expr(function_decl.return_type),
		function_decl.type_params,
		function_decl.dim_constraints,
		function_decl.is_pure,
		function_decl.annotations,
		function_decl.body,
		function_decl.span,
		None,
		CompilerUserDefinedFunc,
	)


private pure func compiler_register_foreign_function_decl(
	state: CompilerTypecheckState,
	function_decl: ParsedForeignFunctionDecl,
) -> CompilerTypecheckState:
	next = if compiler_typecheck_state_allows_foreign(state):
		state
	else:
		message: String = if compiler_typecheck_state_is_stdlib(state):
			"'foreign' declarations cannot be used in the standard library"
		else:
			"'foreign' declarations cannot be used in source packages"

		compiler_typecheck_state_add_error(state, message)

	compiler_register_function_signature(
		next,
		function_decl.name.text,
		function_decl.params,
		compiler_type_from_parsed_type_expr(function_decl.return_type),
		[],
		[],
		function_decl.is_pure,
		function_decl.annotations,
		None,
		function_decl.span,
		None,
		CompilerForeignFunc,
	)


private pure func compiler_imported_param_types_from_parsed(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	declared_type_param_names: List[String],
	params: List[ParsedParam],
) -> List[CompilerType]:
	var result: List[CompilerType] = []

	for param_type in compiler_param_types_from_parsed(params):
		result = result.append(
			compiler_imported_function_annotation_type(
				state,
				import_state,
				module_path,
				local_type_names,
				declared_type_param_names,
				param_type,
			),
		)

	result


private pure func compiler_register_imported_function_decl(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	function_decl: ParsedFunctionDecl,
) -> CompilerTypecheckState:
	declared_type_param_names = compiler_type_param_names(function_decl.type_params)
	param_types: List[CompilerType] = compiler_imported_param_types_from_parsed(
		state,
		import_state,
		module_path,
		local_type_names,
		declared_type_param_names,
		function_decl.params,
	)
	resolved_return_type: CompilerType = compiler_imported_function_annotation_type(
		state,
		import_state,
		module_path,
		local_type_names,
		declared_type_param_names,
		compiler_type_from_optional_parsed_type_expr(function_decl.return_type),
	)
	semantic_dim_constraints: List[(CompilerType, CompilerType)] = compiler_imported_dim_constraints_from_parsed(
		state,
		import_state,
		module_path,
		local_type_names,
		function_decl.dim_constraints,
	)

	compiler_register_function_signature_with_semantic_types(
		state,
		function_decl.name.text,
		function_decl.params,
		param_types,
		resolved_return_type,
		function_decl.type_params,
		semantic_dim_constraints,
		function_decl.is_pure,
		function_decl.annotations,
		function_decl.body,
		function_decl.span,
		Some(module_path),
		CompilerUserDefinedFunc,
	)


private pure func compiler_register_imported_foreign_function_decl(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	function_decl: ParsedForeignFunctionDecl,
) -> CompilerTypecheckState:
	next = if compiler_typecheck_state_allows_foreign(state):
		state
	else:
		message: String = if compiler_typecheck_state_is_stdlib(state):
			"'foreign' declarations cannot be used in the standard library"
		else:
			"'foreign' declarations cannot be used in source packages"

		compiler_typecheck_state_add_error(state, message)

	param_types: List[CompilerType] = compiler_imported_param_types_from_parsed(
		next,
		import_state,
		module_path,
		local_type_names,
		[],
		function_decl.params,
	)
	resolved_return_type: CompilerType = compiler_imported_annotation_type(
		next,
		import_state,
		module_path,
		local_type_names,
		compiler_type_from_parsed_type_expr(function_decl.return_type),
	)

	compiler_register_function_signature_with_semantic_types(
		next,
		function_decl.name.text,
		function_decl.params,
		param_types,
		resolved_return_type,
		[],
		[],
		function_decl.is_pure,
		function_decl.annotations,
		None,
		function_decl.span,
		Some(module_path),
		CompilerForeignFunc,
	)


private pure func compiler_add_trait_function_checked(
	state: CompilerTypecheckState,
	func_name: String,
	trait_name: String,
) -> CompilerTypecheckState:
	match compiler_env_trait_function_collision(state.env, func_name, trait_name):
		Some(existing_trait):
			compiler_typecheck_state_add_error(
				state,
				"method '" + func_name + "' is already registered under trait '" + existing_trait + "'; cannot also register under '" + trait_name + "'",
			)
		None:
			if compiler_env_get_function_trait(state.env, func_name) == Some(trait_name):
				state
			else:
				compiler_typecheck_state_with_env(
					state,
					compiler_env_add_trait_function(state.env, func_name, trait_name),
				)


private pure func compiler_validate_trait_method_param_types(
	state: CompilerTypecheckState,
	trait_decl: ParsedTraitDecl,
) -> CompilerTypecheckState:
	var next = state

	for method in trait_decl.methods:
		for param in method.params:
			if param.type_expr.is_none():
				param_name: String = compiler_param_name_from_parsed(param).get_or("_")
				next = compiler_typecheck_state_add_error(
					next,
					"trait " + trait_decl.name.text + " method '" + method.name.text + "': parameter '" + param_name + "' must have an explicit type",
				)

	next


private pure func compiler_register_trait_decl(
	state: CompilerTypecheckState,
	module_path: String,
	trait_decl: ParsedTraitDecl,
) -> CompilerTypecheckState:
	next = compiler_validate_trait_method_param_types(state, trait_decl)

	definition_key = compiler_source_definition_key(
		CompilerTraitDefinition,
		trait_decl.name.text,
		None,
		trait_decl.span,
	)

	match compiler_typecheck_state_find_source_definition_id(next, definition_key):
		Some(reserved_id):
			compiler_register_trait_with_id(next, module_path, trait_decl, reserved_id)
		None:
			match compiler_env_mint_def_id(next.env):
				(next_env, def_id):
					compiler_register_trait_with_id(
						compiler_typecheck_state_with_env(next, next_env),
						module_path,
						trait_decl,
						def_id,
					)


private pure func compiler_register_trait_with_id(
	state: CompilerTypecheckState,
	module_path: String,
	trait_decl: ParsedTraitDecl,
	def_id: Int,
) -> CompilerTypecheckState:
	type_params = compiler_type_param_names(trait_decl.type_params)
	trait_def = compiler_trait_def_with_details(
		def_id,
		trait_decl.name.text,
		type_params,
		compiler_supertrait_names_from_parsed(trait_decl.supertraits),
		compiler_trait_methods_from_parsed(trait_decl.methods, type_params),
		Some(module_path),
	)
	env_with_trait = compiler_env_add_trait(state.env, trait_def)
	var with_trait = compiler_typecheck_state_with_env(state, env_with_trait)

	for method in trait_decl.methods:
		with_trait = compiler_add_trait_function_checked(
			with_trait,
			method.name.text,
			trait_decl.name.text,
		)

	for pair in compiler_env_trait_methods_with_declaring_trait(
		with_trait.env,
		trait_decl.name.text,
	):
		if pair[1] != trait_decl.name.text:
			with_trait = compiler_add_trait_function_checked(with_trait, pair[0], pair[1])

	with_trait


private pure func compiler_impl_type_head_name(for_type: CompilerType) -> Option[String]:
	match for_type:
		CompilerNamedType(name, _):
			Some(name)
		_:
			None


private pure func compiler_impl_target_label(for_type: CompilerType) -> String:
	compiler_impl_type_head_name(for_type).get_or("<non-named type>")


private pure func compiler_impl_orphan_error_message(
	state: CompilerTypecheckState,
	module_path: String,
	impl_decl: ParsedImplDecl,
	for_type: CompilerType,
) -> Option[String]:
	trait_home: Option[String] = match compiler_env_get_trait(state.env, impl_decl.trait_name.text):
		Some(trait_def):
			trait_def.module_path
		None:
			None

	type_home: Option[String] = match compiler_impl_type_head_name(for_type):
		Some(type_name):
			compiler_typecheck_state_find_type_home(state, type_name)
		None:
			None

	match (trait_home, type_home):
		(Some(trait_module), Some(type_module)):
			if (
				trait_module == module_path
				or compiler_typecheck_state_type_home_matches(
					state,
					compiler_impl_target_label(for_type),
					module_path,
				)
			):
				None
			else:
				Some(
					"orphan impl: '" + impl_decl.trait_name.text + " for " + compiler_impl_target_label(
						for_type,
					) + "' is not in the trait's module '" + trait_module + "' or the type's module '" + type_module + "'",
				)
		_:
			None


private pure func compiler_impl_conflict_message(instance: CompilerImplInstance) -> String:
	"conflicting implementation of trait '" + instance.trait_name + "' for type '" + compiler_impl_target_label(
		instance.for_type,
	) + "'"


private pure func compiler_add_source_impl_checked(
	state: CompilerTypecheckState,
	instance: CompilerImplInstance,
) -> CompilerTypecheckState:
	match compiler_env_find_conflicting_impl(state.env, instance):
		Some(_):
			compiler_typecheck_state_add_error(state, compiler_impl_conflict_message(instance))
		None:
			compiler_typecheck_state_with_env(
				state,
				compiler_env_add_impl(state.env, instance),
			)


private pure func compiler_add_private_impl_checked(
	state: CompilerTypecheckState,
	instance: CompilerImplInstance,
) -> CompilerTypecheckState:
	match compiler_env_find_conflicting_impl(state.env, instance):
		Some(_):
			compiler_typecheck_state_add_error(state, compiler_impl_conflict_message(instance))
		None:
			match compiler_typecheck_state_find_private_impl_conflict(state, instance):
				Some(_):
					compiler_typecheck_state_add_error(
						state,
						compiler_impl_conflict_message(instance),
					)
				None:
					compiler_typecheck_state_add_private_impl(state, instance)


private pure func compiler_impl_bound_name_is_candidate(
	state: CompilerTypecheckState,
	name: String,
) -> Bool:
	(
		name != "#_"
		and not name.starts_with("#")
		and not compiler_typecheck_state_has_known_type_name(state, name)
	)


private pure func compiler_impl_inline_bounds_from_type_exprs(
	type_exprs: List[ParsedTypeExpr],
) -> List[CompilerBoundTypeParam]:
	var result: List[CompilerBoundTypeParam] = []

	for type_expr in type_exprs:
		result = result.concat(compiler_impl_inline_bounds_from_type_expr(type_expr))

	result


private pure func compiler_impl_inline_bounds_from_type_expr(
	type_expr: ParsedTypeExpr,
) -> List[CompilerBoundTypeParam]:
	match type_expr:
		ParsedBoundedType(name, bounds, _):
			[compiler_make_bound_type_param(
					name.text,
					bounds.map(func(bound): bound.text),
				)]
		ParsedNamedType(_, args, _):
			compiler_impl_inline_bounds_from_type_exprs(args)
		ParsedQualifiedNamedType(_, _, args, _):
			compiler_impl_inline_bounds_from_type_exprs(args)
		ParsedTupleType(items, _):
			compiler_impl_inline_bounds_from_type_exprs(items)
		ParsedArrayType(element, dims, _):
			compiler_impl_inline_bounds_from_type_expr(
				element,
			).concat(compiler_impl_inline_bounds_from_type_exprs(dims))
		ParsedFunctionType(_, params, return_type, _):
			compiler_impl_inline_bounds_from_type_exprs(
				params,
			).concat(compiler_impl_inline_bounds_from_type_expr(return_type))
		ParsedRangeType(inner, _):
			compiler_impl_inline_bounds_from_type_expr(inner)
		ParsedDimBinaryType(_, left, right, _):
			compiler_impl_inline_bounds_from_type_expr(
				left,
			).concat(compiler_impl_inline_bounds_from_type_expr(right))
		ParsedDimLiteralType(_, _):
			[]
		ParsedDimNameType(_, _, _):
			[]
		ParsedMissingType(_):
			[]


private pure func compiler_impl_bounds_for_type(
	state: CompilerTypecheckState,
	explicit_bounds: List[CompilerBoundTypeParam],
	for_type: CompilerType,
) -> List[CompilerBoundTypeParam]:
	var result: List[CompilerBoundTypeParam] = explicit_bounds
	var seen: List[String] = explicit_bounds.map(func(bound): bound.name)

	for name in compiler_collect_type_vars(for_type):
		if compiler_impl_bound_name_is_candidate(state, name) and not seen.contains(name):
			seen = seen.append(name)
			result = result.append(compiler_make_bound_type_param(name, []))

	result


private pure func compiler_impl_bounds_for_decl_type(
	state: CompilerTypecheckState,
	type_expr: ParsedTypeExpr,
	for_type: CompilerType,
) -> List[CompilerBoundTypeParam]:
	compiler_impl_bounds_for_type(
		state,
		compiler_impl_inline_bounds_from_type_expr(type_expr),
		for_type,
	)


private pure func compiler_impl_parameterize_receiver_type(
	type_param_names: List[String],
	typ: CompilerType,
) -> CompilerType:
	match typ:
		CompilerNamedType(name, args):
			if args.length() == 0 and type_param_names.contains(name):
				CompilerTypeVar(name)
			else:
				CompilerNamedType(
					name,
					args.map(func(arg):
						compiler_impl_parameterize_receiver_type(type_param_names, arg)
					),
				)
		CompilerArrayType(element, dims):
			CompilerArrayType(
				compiler_impl_parameterize_receiver_type(
					type_param_names,
					element,
				),
				dims.map(func(dim):
					compiler_impl_parameterize_receiver_type(type_param_names, dim)
				),
			)
		CompilerFunctionType(is_pure, params, return_type):
			CompilerFunctionType(
				is_pure,
				params.map(func(param):
					compiler_impl_parameterize_receiver_type(type_param_names, param)
				),
				compiler_impl_parameterize_receiver_type(
					type_param_names,
					return_type,
				),
			)
		CompilerTupleType(items):
			CompilerTupleType(
				items.map(func(item):
					compiler_impl_parameterize_receiver_type(type_param_names, item)
				),
			)
		CompilerRangeType(inner):
			CompilerRangeType(compiler_impl_parameterize_receiver_type(type_param_names, inner))
		CompilerDimOpType(op, left, right):
			CompilerDimOpType(
				op,
				compiler_impl_parameterize_receiver_type(type_param_names, left),
				compiler_impl_parameterize_receiver_type(type_param_names, right),
			)
		CompilerTypeVar(name):
			CompilerTypeVar(name)
		CompilerConstIntType(value):
			CompilerConstIntType(value)
		CompilerSelfType:
			CompilerSelfType
		CompilerVarDimsType(name):
			CompilerVarDimsType(name)
		CompilerMetaType(id):
			CompilerMetaType(id)


private pure func compiler_impl_normalize_receiver_type(
	state: CompilerTypecheckState,
	type_expr: ParsedTypeExpr,
	for_type: CompilerType,
) -> CompilerType:
	type_param_names = compiler_impl_bounds_for_decl_type(
		state,
		type_expr,
		for_type,
	).map(
		func(bound): bound.name,
	)
	compiler_impl_parameterize_receiver_type(type_param_names, for_type)


private pure func compiler_impl_method_info_from_decl(
	state: CompilerTypecheckState,
	module_path: String,
	method: ParsedFunctionDecl,
) -> CompilerImplMethodInfo:
	declared_type_param_names = compiler_type_param_names(method.type_params)
	param_types: List[CompilerType] = compiler_param_types_from_parsed(
		method.params,
	).map(
		func(
			param_type,
		): compiler_canonical_function_annotation_type(
			state,
			declared_type_param_names,
			param_type,
		),
	)
	return_type: CompilerType = compiler_canonical_function_annotation_type(
		state,
		declared_type_param_names,
		compiler_type_from_optional_parsed_type_expr(method.return_type),
	)
	compiler_impl_method_info_from_semantic_types(
		state,
		module_path,
		method,
		param_types,
		return_type,
	)


private pure func compiler_impl_method_info_from_semantic_types(
	state: CompilerTypecheckState,
	module_path: String,
	method: ParsedFunctionDecl,
	param_types: List[CompilerType],
	return_type: CompilerType,
) -> CompilerImplMethodInfo:
	func_type: CompilerType = CompilerFunctionType(method.is_pure, param_types, return_type)
	target: Option[CompilerImplMethodTarget] = compiler_typecheck_state_find_func_callable_id(
		state,
		compiler_callable_key_from_span(method.name.text, method.span),
	).map(func(callable_id): {
			callable_id = callable_id,
			module_path = module_path
		})

	compiler_impl_method_info(
		method.name.text,
		target,
		func_type,
		compiler_effective_bound_type_params(state, method.type_params, func_type),
		compiler_param_names_from_parsed(method.params),
		compiler_purity_from_parsed(method.is_pure),
		compiler_function_resource_arg_policy(state, param_types, method.annotations, method.body),
		compiler_dim_constraints_from_parsed(method.dim_constraints),
		compiler_function_debug_only(method.annotations),
	)


private pure func compiler_impl_method_infos_from_decl(
	state: CompilerTypecheckState,
	module_path: String,
	methods: List[ParsedFunctionDecl],
) -> List[CompilerImplMethodInfo]:
	methods.map(func(method): compiler_impl_method_info_from_decl(state, module_path, method))


private pure func compiler_imported_impl_type(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	typ: CompilerType,
) -> CompilerType:
	compiler_imported_annotation_type(state, import_state, module_path, local_type_names, typ)


private pure func compiler_imported_impl_method_info_from_decl(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	method: ParsedFunctionDecl,
) -> CompilerImplMethodInfo:
	declared_type_param_names = compiler_type_param_names(method.type_params)
	param_types: List[CompilerType] = compiler_imported_param_types_from_parsed(
		state,
		import_state,
		module_path,
		local_type_names,
		declared_type_param_names,
		method.params,
	)
	return_type: CompilerType = compiler_imported_function_annotation_type(
		state,
		import_state,
		module_path,
		local_type_names,
		declared_type_param_names,
		compiler_type_from_optional_parsed_type_expr(method.return_type),
	)
	compiler_impl_method_info_from_semantic_types(
		state,
		module_path,
		method,
		param_types,
		return_type,
	)


private pure func compiler_imported_impl_method_infos_from_decl(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	methods: List[ParsedFunctionDecl],
) -> List[CompilerImplMethodInfo]:
	methods.map(
		func(
			method,
		): compiler_imported_impl_method_info_from_decl(
			state,
			import_state,
			module_path,
			local_type_names,
			method,
		),
	)


private pure func compiler_register_impl_decl_with_info(
	state: CompilerTypecheckState,
	module_path: String,
	impl_decl: ParsedImplDecl,
	for_type: CompilerType,
	method_infos: List[CompilerImplMethodInfo],
	is_private: Bool,
) -> CompilerTypecheckState:
	var next = match compiler_impl_orphan_error_message(state, module_path, impl_decl, for_type):
		Some(message):
			compiler_typecheck_state_add_error(state, message)
		None:
			state

	definition_key = compiler_source_definition_key(
		CompilerImplDefinition,
		impl_decl.trait_name.text,
		None,
		impl_decl.span,
	)

	match compiler_typecheck_state_find_source_definition_id(next, definition_key):
		Some(reserved_id):
			compiler_register_impl_with_id(
				next,
				impl_decl,
				for_type,
				method_infos,
				is_private,
				reserved_id,
			)
		None:
			match compiler_env_mint_def_id(next.env):
				(next_env, def_id):
					compiler_register_impl_with_id(
						compiler_typecheck_state_with_env(next, next_env),
						impl_decl,
						for_type,
						method_infos,
						is_private,
						def_id,
					)


private pure func compiler_register_impl_with_id(
	state: CompilerTypecheckState,
	impl_decl: ParsedImplDecl,
	for_type: CompilerType,
	method_infos: List[CompilerImplMethodInfo],
	is_private: Bool,
	def_id: Int,
) -> CompilerTypecheckState:
	instance = compiler_impl_instance_with_methods(
		def_id,
		impl_decl.trait_name.text,
		for_type,
		compiler_impl_bounds_for_decl_type(state, impl_decl.for_type, for_type),
		method_infos,
		False,
	)

	if is_private:
		compiler_add_private_impl_checked(state, instance)
	else:
		compiler_add_source_impl_checked(state, instance)


private pure func compiler_register_impl_decl(
	state: CompilerTypecheckState,
	module_path: String,
	impl_decl: ParsedImplDecl,
	is_private: Bool,
) -> CompilerTypecheckState:
	raw_for_type: CompilerType = compiler_canonical_annotation_type(
		state,
		compiler_type_from_parsed_type_expr(impl_decl.for_type),
	)
	for_type: CompilerType = compiler_impl_normalize_receiver_type(
		state,
		impl_decl.for_type,
		raw_for_type,
	)
	method_infos: List[CompilerImplMethodInfo] = compiler_impl_method_infos_from_decl(
		state,
		module_path,
		impl_decl.methods,
	)
	compiler_register_impl_decl_with_info(
		state,
		module_path,
		impl_decl,
		for_type,
		method_infos,
		is_private,
	)


private pure func compiler_register_imported_impl_decl(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	impl_decl: ParsedImplDecl,
) -> CompilerTypecheckState:
	raw_for_type: CompilerType = compiler_imported_impl_type(
		state,
		import_state,
		module_path,
		local_type_names,
		compiler_type_from_parsed_type_expr(impl_decl.for_type),
	)
	for_type: CompilerType = compiler_impl_normalize_receiver_type(
		state,
		impl_decl.for_type,
		raw_for_type,
	)
	method_infos: List[CompilerImplMethodInfo] = compiler_imported_impl_method_infos_from_decl(
		state,
		import_state,
		module_path,
		local_type_names,
		impl_decl.methods,
	)
	compiler_register_impl_decl_with_info(
		state,
		module_path,
		impl_decl,
		for_type,
		method_infos,
		False,
	)


pure func compiler_typecheck_register_signature_decl(
	state: CompilerTypecheckState,
	module_path: String,
	decl: ParsedDecl,
) -> CompilerTypecheckState:
	match decl:
		FunctionParsedDecl(function_decl):
			compiler_register_function_decl(state, function_decl)
		VarParsedDecl(var_decl):
			compiler_register_var_decl(state, module_path, var_decl)
		ForeignBlockParsedDecl(_, functions, _):
			var next = state

			for function_decl in functions:
				next = compiler_register_foreign_function_decl(next, function_decl)

			next
		TraitParsedDecl(trait_decl):
			compiler_register_trait_decl(state, module_path, trait_decl)
		PrivateParsedDecl(inner, _):
			compiler_typecheck_register_signature_decl(state, module_path, inner)
		_:
			state


pure func compiler_typecheck_register_signature_decls(
	state: CompilerTypecheckState,
	module_path: String,
	decls: List[ParsedDecl],
) -> CompilerTypecheckState:
	var next = state

	for decl in decls:
		next = compiler_typecheck_register_signature_decl(next, module_path, decl)

	next


pure func compiler_typecheck_register_program_signature_decls(
	state: CompilerTypecheckState,
	program: ParsedProgram,
) -> CompilerTypecheckState:
	compiler_typecheck_register_signature_decls(state, program.source.module_name, program.decls)


pure func compiler_typecheck_register_impl_decl(
	state: CompilerTypecheckState,
	module_path: String,
	decl: ParsedDecl,
) -> CompilerTypecheckState:
	match decl:
		ImplParsedDecl(impl_decl):
			compiler_register_impl_decl(state, module_path, impl_decl, False)
		PrivateParsedDecl(inner, _):
			match inner:
				ImplParsedDecl(impl_decl):
					compiler_register_impl_decl(state, module_path, impl_decl, True)
				_:
					state
		_:
			state


pure func compiler_typecheck_register_impl_decls(
	state: CompilerTypecheckState,
	module_path: String,
	decls: List[ParsedDecl],
) -> CompilerTypecheckState:
	var next = state

	for decl in decls:
		next = compiler_typecheck_register_impl_decl(next, module_path, decl)

	next


pure func compiler_typecheck_register_program_impl_decls(
	state: CompilerTypecheckState,
	program: ParsedProgram,
) -> CompilerTypecheckState:
	compiler_typecheck_register_impl_decls(state, program.source.module_name, program.decls)


private pure func compiler_typecheck_register_imported_union_decl(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	union_decl: ParsedUnionDecl,
) -> CompilerTypecheckState:
	canonical_name: String = compiler_canonical_imported_type_name(
		module_path,
		union_decl.name.text,
	)
	type_params = compiler_type_param_names(union_decl.type_params)
	variants: List[CompilerVariantDef] = compiler_imported_variants_from_parsed(
		state,
		import_state,
		module_path,
		local_type_names,
		type_params,
		union_decl.variants,
	)

	type_kind: CompilerTypeKind = if union_decl.is_enum:
		CompilerTypeEnum
	else:
		CompilerTypeUnion

	contains_resource: Bool = compiler_variants_contain_resource(
		compiler_resource_type_scan_context(state.env, state.known_resource_type_names),
		variants,
	)
	constructor_ids = compiler_reserved_constructor_ids(state, union_decl)
	env: CompilerEnv = compiler_env_add_type_with_constructor_ids(
		state.env,
		canonical_name,
		type_params,
		variants,
		type_kind,
		contains_resource,
		True,
		constructor_ids,
	)
	with_env = compiler_typecheck_state_with_env(state, env)
	with_home = compiler_typecheck_state_record_type_home(
		with_env,
		canonical_name,
		module_path,
		True,
	)
	compiler_add_imported_type_aliases(
		with_home,
		module_path,
		union_decl.name.text,
		canonical_name,
		type_params,
	)


private pure func compiler_typecheck_register_imported_record_decl(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	record_decl: ParsedRecordDecl,
) -> CompilerTypecheckState:
	canonical_name: String = compiler_canonical_imported_type_name(
		module_path,
		record_decl.name.text,
	)
	type_params = compiler_type_param_names(record_decl.type_params)
	fields: List[CompilerFieldDecl] = record_decl.fields.map(
		func(
			field,
		): compiler_imported_field_from_parsed(
			state,
			import_state,
			module_path,
			local_type_names,
			type_params,
			field,
		),
	)
	env: CompilerEnv = compiler_env_add_record(
		state.env,
		canonical_name,
		type_params,
		fields,
		record_decl.is_struct,
		compiler_fields_contain_resource(
			compiler_resource_type_scan_context(state.env, state.known_resource_type_names),
			fields,
		),
	)
	with_env = compiler_typecheck_state_with_env(state, env)
	with_home = compiler_typecheck_state_record_type_home(
		with_env,
		canonical_name,
		module_path,
		True,
	)
	compiler_add_imported_type_aliases(
		with_home,
		module_path,
		record_decl.name.text,
		canonical_name,
		type_params,
	)


private pure func compiler_typecheck_register_imported_builtin_type_decl(
	state: CompilerTypecheckState,
	module_path: String,
	type_decl: ParsedBuiltinTypeDecl,
) -> CompilerTypecheckState:
	canonical_name: String = compiler_canonical_imported_type_name(module_path, type_decl.name.text)

	type_kind: CompilerTypeKind = if type_decl.is_resource:
		CompilerTypeResource
	else:
		CompilerTypeBuiltin

	env: CompilerEnv = compiler_env_add_type(
		state.env,
		canonical_name,
		compiler_type_param_names(type_decl.type_params),
		[],
		type_kind,
		type_decl.is_resource,
		False,
	)

	with_resource = if type_decl.is_resource:
		compiler_typecheck_state_add_known_resource_type_name(state, canonical_name)
	else:
		state

	with_env = compiler_typecheck_state_with_env(with_resource, env)

	with_cleanup = match type_decl.cleanup:
		Some(cleanup):
			{ with_env |
				context = compiler_register_resource_cleanup(
					with_env.context,
					canonical_name,
					cleanup.builtin_name,
				)
			}
		None:
			with_env

	with_home = compiler_typecheck_state_record_type_home(
		with_cleanup,
		canonical_name,
		module_path,
		True,
	)
	compiler_add_imported_type_aliases(
		with_home,
		module_path,
		type_decl.name.text,
		canonical_name,
		compiler_type_param_names(type_decl.type_params),
	)


private pure func compiler_typecheck_register_imported_type_alias_decl(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	alias_decl: ParsedTypeAliasDecl,
) -> CompilerTypecheckState:
	canonical_name: String = compiler_canonical_imported_type_name(
		module_path,
		alias_decl.name.text,
	)
	type_params = compiler_type_param_names(alias_decl.type_params)
	target: CompilerType = compiler_type_instantiate_type_params(
		type_params,
		compiler_imported_annotation_type(
			state,
			import_state,
			module_path,
			local_type_names,
			compiler_type_from_parsed_type_expr(alias_decl.target),
		),
	)

	env: CompilerEnv = if alias_decl.is_opaque:
		compiler_env_add_opaque_alias(
			state.env,
			canonical_name,
			type_params,
			target,
			Some(module_path),
		)
	else:
		compiler_env_add_alias(state.env, canonical_name, type_params, target)

	with_env = compiler_typecheck_state_with_env(
		compiler_typecheck_state_add_known_type_name(state, canonical_name),
		env,
	)

	with_home = if alias_decl.is_opaque:
		compiler_typecheck_state_record_type_home(with_env, canonical_name, module_path, True)
	else:
		with_env

	compiler_add_imported_type_aliases(
		with_home,
		module_path,
		alias_decl.name.text,
		canonical_name,
		type_params,
	)


private pure func compiler_typecheck_register_imported_type_decl(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	decl: CompilerImportableTypeDecl,
) -> CompilerTypecheckState:
	match decl:
		CompilerImportableRecordDecl(record_decl):
			compiler_typecheck_register_imported_record_decl(
				state,
				import_state,
				module_path,
				local_type_names,
				record_decl,
			)
		CompilerImportableUnionDecl(union_decl):
			compiler_typecheck_register_imported_union_decl(
				state,
				import_state,
				module_path,
				local_type_names,
				union_decl,
			)
		CompilerImportableBuiltinTypeDecl(type_decl):
			compiler_typecheck_register_imported_builtin_type_decl(state, module_path, type_decl)
		CompilerImportableTypeAliasDecl(alias_decl):
			compiler_typecheck_register_imported_type_alias_decl(
				state,
				import_state,
				module_path,
				local_type_names,
				alias_decl,
			)


private pure func compiler_typecheck_register_imported_type_decls(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	decls: List[CompilerImportableTypeDecl],
) -> CompilerTypecheckState:
	var next = state

	for decl in decls:
		next = compiler_typecheck_register_imported_type_decl(
			next,
			import_state,
			module_path,
			local_type_names,
			decl,
		)

	next


private pure func compiler_typecheck_register_imported_signature_decl(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	decl: CompilerImportableSignatureDecl,
) -> CompilerTypecheckState:
	match decl:
		CompilerImportableFunctionDecl(function_decl):
			compiler_register_imported_function_decl(
				state,
				import_state,
				module_path,
				local_type_names,
				function_decl,
			)
		CompilerImportableVarDecl(var_decl):
			compiler_register_imported_var_decl(
				state,
				import_state,
				module_path,
				local_type_names,
				var_decl,
			)
		CompilerImportableForeignFunctionDecl(function_decl):
			compiler_register_imported_foreign_function_decl(
				state,
				import_state,
				module_path,
				local_type_names,
				function_decl,
			)
		CompilerImportableTraitDecl(trait_decl):
			compiler_register_trait_decl(state, module_path, trait_decl)


private pure func compiler_typecheck_register_imported_signature_decls(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	decls: List[CompilerImportableSignatureDecl],
) -> CompilerTypecheckState:
	var next = state

	for decl in decls:
		next = compiler_typecheck_register_imported_signature_decl(
			next,
			import_state,
			module_path,
			local_type_names,
			decl,
		)

	next


private pure func compiler_typecheck_register_imported_impl_decls(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	decls: List[ParsedImplDecl],
) -> CompilerTypecheckState:
	var next = state

	for decl in decls:
		next = compiler_register_imported_impl_decl(
			next,
			import_state,
			module_path,
			local_type_names,
			decl,
		)

	next


private pure func compiler_import_resolution_state_base(
	state: CompilerTypecheckState,
	module: CompilerImportableModule,
) -> CompilerTypecheckState:
	{ state |
		module_aliases = [],
		imported_names = [],
		imported_modules = [],
		import_bindings = [],
		module_origin = compiler_importable_module_origin(module),
		known_type_names = [],
		known_resource_type_names = [],
		top_level_names = [],
		type_homes = []
	}


private pure func compiler_import_resolution_state_for_module(
	state: CompilerTypecheckState,
	module: CompilerImportableModule,
	import_surfaces: List[CompilerImportableModuleSurface],
) -> CompilerTypecheckState:
	next = compiler_typecheck_prescan_decls(
		compiler_import_resolution_state_base(state, module),
		compiler_importable_module_decls(module),
	)
	compiler_register_import_decls(
		next,
		import_surfaces,
		compiler_importable_module_declared_imports(module),
	)


private pure func compiler_typecheck_register_import_module_types(
	state: CompilerTypecheckState,
	module: CompilerImportableModule,
	import_surfaces: List[CompilerImportableModuleSurface],
) -> CompilerTypecheckState:
	target_origin = state.module_origin
	module_state = { state | module_origin = compiler_importable_module_origin(module) }
	import_state = compiler_import_resolution_state_for_module(
		module_state,
		module,
		import_surfaces,
	)
	with_types = compiler_typecheck_register_imported_type_decls(
		module_state,
		import_state,
		compiler_importable_module_path(module),
		compiler_importable_module_local_type_names(module),
		compiler_importable_module_type_decls(module),
	)
	{ with_types | module_origin = target_origin }


private pure func compiler_typecheck_register_direct_import_module_decls(
	state: CompilerTypecheckState,
	module: CompilerImportableModule,
	import_surfaces: List[CompilerImportableModuleSurface],
) -> CompilerTypecheckState:
	target_origin = state.module_origin
	module_state = { state | module_origin = compiler_importable_module_origin(module) }
	import_state = compiler_import_resolution_state_for_module(
		module_state,
		module,
		import_surfaces,
	)
	with_signatures = compiler_typecheck_register_imported_signature_decls(
		module_state,
		import_state,
		compiler_importable_module_path(module),
		compiler_importable_module_local_type_names(module),
		compiler_importable_module_signature_decls(module),
	)
	with_impls = compiler_typecheck_register_imported_impl_decls(
		with_signatures,
		import_state,
		compiler_importable_module_path(module),
		compiler_importable_module_local_type_names(module),
		compiler_importable_module_impl_decls(module),
	)
	{ with_impls | module_origin = target_origin }


private pure func compiler_typecheck_register_import_modules(
	state: CompilerTypecheckState,
	all_modules: List[CompilerImportableModule],
	direct_modules: List[CompilerImportableModule],
	import_surfaces: List[CompilerImportableModuleSurface],
) -> CompilerTypecheckState:
	var next = state

	-- Canonical type declarations from the reachable dependency closure are
	-- graph metadata. Registering them does not
	-- introduce a bare source name; aliases are created only for actual import
	-- bindings in `state.imported_names`. This lets a direct dependency expose a
	-- record/union from one of its dependencies without leaking unrelated values.
	for module in all_modules:
		next = compiler_typecheck_register_import_module_types(next, module, import_surfaces)

	for module in direct_modules:
		next = compiler_typecheck_register_direct_import_module_decls(next, module, import_surfaces)

	next


private pure func compiler_importable_module_surfaces(
	modules: List[CompilerImportableModule],
) -> List[CompilerImportableModuleSurface]:
	modules.map(compiler_importable_module_to_surface)


private pure func compiler_import_module_matches_request(
	module: CompilerImportableModule,
	requested_path: String,
) -> Bool:
	compiler_importable_module_identity_matches_request(
		compiler_importable_module_path(module),
		compiler_importable_module_origin(module),
		compiler_importable_module_surface_value(module).module_name,
		requested_path,
	)


private pure func compiler_import_identity(
	modules: List[CompilerImportableModule],
	requested_path: String,
) -> String:
	var result: String = requested_path

	for module in modules:
		if compiler_import_module_matches_request(module, requested_path):
			result = compiler_importable_module_path(module)
			break

	result


private pure func compiler_importable_module_is_prelude(module: CompilerImportableModule) -> Bool:
	(
		compiler_importable_module_path(module) == "prelude"
		or compiler_importable_module_path(module) == "std/prelude"
		or compiler_importable_module_surface_value(module).module_name == "prelude"
		or compiler_importable_module_surface_value(module).module_name == "std/prelude"
	)


private pure func compiler_local_top_level_names_for_decl(decl: ParsedDecl) -> List[String]:
	match decl:
		FunctionParsedDecl(function_decl):
			[function_decl.name.text]
		VarParsedDecl(var_decl):
			[var_decl.name.text]
		RecordParsedDecl(record_decl):
			[record_decl.name.text]
		UnionParsedDecl(union_decl):
			var names: List[String] = [union_decl.name.text]

			for variant in union_decl.variants:
				names = names.append(variant.name.text)

			names
		BuiltinTypeParsedDecl(type_decl):
			[type_decl.name.text]
		TypeAliasParsedDecl(alias_decl):
			[alias_decl.name.text]
		TraitParsedDecl(trait_decl):
			[trait_decl.name.text]
		ForeignBlockParsedDecl(_, functions, _):
			var names: List[String] = []

			for function_decl in functions:
				names = names.append(function_decl.name.text)

			names
		PrivateParsedDecl(inner, _):
			compiler_local_top_level_names_for_decl(inner)
		_:
			[]


private pure func compiler_local_top_level_names(program: ParsedProgram) -> List[String]:
	var names: List[String] = []

	for decl in program.decls:
		names = names.concat(compiler_local_top_level_names_for_decl(decl))

	names


private pure func compiler_import_symbol_local_name(symbol: ParsedImportSymbol) -> String:
	match symbol.symbol_alias:
		Some(alias_name):
			alias_name.text
		None:
			symbol.name.text


private pure func compiler_prelude_import_without_local_conflicts(
	import_decl: ParsedImportDecl,
	local_names: List[String],
) -> Option[ParsedImportDecl]:
	match import_decl.symbols:
		Some(symbols):
			var filtered: List[ParsedImportSymbol] = []

			for symbol in symbols:
				if not local_names.contains(compiler_import_symbol_local_name(symbol)):
					filtered = filtered.append(symbol)

			if filtered.length() == 0:
				None
			else:
				Some({ import_decl | symbols = Some(filtered) })
		None:
			Some(import_decl)


private pure func compiler_prelude_import_decls(
	import_modules: List[CompilerImportableModule],
	local_names: List[String],
) -> List[ParsedDecl]:
	var result: List[ParsedDecl] = []
	var found: Bool = False

	for module in import_modules:
		if found:
			break
		else if compiler_importable_module_is_prelude(module):
			found = True

			for decl in compiler_importable_module_decls(module):
				match decl:
					ImportBlockParsedDecl(imports, span):
						var filtered_imports: List[ParsedImportDecl] = []

						for import_decl in imports:
							match compiler_prelude_import_without_local_conflicts(
								import_decl,
								local_names,
							):
								Some(filtered):
									filtered_imports = filtered_imports.append(filtered)
								None:
									void

						if filtered_imports.length() > 0:
							result = result.append(ImportBlockParsedDecl(filtered_imports, span))
					PrivateParsedDecl(ImportBlockParsedDecl(imports, span), _):
						var filtered_imports: List[ParsedImportDecl] = []

						for import_decl in imports:
							match compiler_prelude_import_without_local_conflicts(
								import_decl,
								local_names,
							):
								Some(filtered):
									filtered_imports = filtered_imports.append(filtered)
								None:
									void

						if filtered_imports.length() > 0:
							result = result.append(ImportBlockParsedDecl(filtered_imports, span))
					_:
						void

	result


private pure func compiler_decl_import_identities(
	import_modules: List[CompilerImportableModule],
	decls: List[ParsedDecl],
) -> List[String]:
	var identities: List[String] = []

	for decl in decls:
		match decl:
			ImportBlockParsedDecl(imports, _):
				for import_decl in imports:
					module_identity: String = compiler_import_identity(
						import_modules,
						import_decl.module_path,
					)

					if not identities.contains(module_identity):
						identities = identities.append(module_identity)
			PrivateParsedDecl(ImportBlockParsedDecl(imports, _), _):
				for import_decl in imports:
					module_identity: String = compiler_import_identity(
						import_modules,
						import_decl.module_path,
					)

					if not identities.contains(module_identity):
						identities = identities.append(module_identity)
			_:
				void

	identities


private pure func compiler_program_import_identities(
	import_modules: List[CompilerImportableModule],
	program: ParsedProgram,
) -> List[String]:
	compiler_decl_import_identities(import_modules, program.decls)


private pure func compiler_import_module_is_current(
	module_path: String,
	current_module_path: Option[String],
) -> Bool:
	match current_module_path:
		Some(current_path):
			module_path == current_path
		None:
			False


private pure func compiler_importable_modules_for_program(
	modules: List[CompilerImportableModule],
	program: ParsedProgram,
	current_module_path: Option[String],
) -> List[CompilerImportableModule]:
	identities: List[String] = compiler_program_import_identities(modules, program)
	var result: List[CompilerImportableModule] = []

	for module in modules:
		if (
			identities.contains(compiler_importable_module_path(module))
			and not compiler_import_module_is_current(
				compiler_importable_module_path(module),
				current_module_path,
			)
		):
			result = result.append(module)

	result


private pure func compiler_importable_module_dependency_closure(
	modules: List[CompilerImportableModule],
	roots: List[CompilerImportableModule],
	current_module_path: Option[String],
) -> List[CompilerImportableModule]:
	var identities: List[String] = []
	var index: Int = 0

	for root in roots:
		identities = identities.append(compiler_importable_module_path(root))

	while index < identities.length():
		current_identity = identities.get_or(index, "")

		for module in modules:
			if compiler_importable_module_path(module) == current_identity:
				for dependency in compiler_decl_import_identities(
					modules,
					compiler_importable_module_decls(module),
				):
					if (
						not identities.contains(dependency)
						and not compiler_import_module_is_current(dependency, current_module_path)
					):
						identities = identities.append(dependency)

				break

		index += 1

	var result: List[CompilerImportableModule] = []

	for module in modules:
		if (
			identities.contains(compiler_importable_module_path(module))
			and not compiler_import_module_is_current(
				compiler_importable_module_path(module),
				current_module_path,
			)
		):
			result = result.append(module)

	result


private pure func compiler_program_current_import_identities(
	state: CompilerTypecheckState,
	program: ParsedProgram,
) -> List[String]:
	module_name: String = program.source.module_name
	var identities: List[String] = [module_name]

	if compiler_typecheck_state_is_stdlib(state):
		if module_name.starts_with("std/"):
			identities = identities.append(module_name.substring(4, module_name.length() - 4))
		else:
			identities = identities.append("std/" + module_name)

	identities


private pure func compiler_import_symbols_contain_name(
	symbols: List[ParsedImportSymbol],
	name: String,
) -> Bool:
	var found: Bool = False

	for symbol in symbols:
		if symbol.name.text == name:
			found = True
			break

	found


private pure func compiler_prelude_symbols_for_identity(
	import_modules: List[CompilerImportableModule],
	prelude_decls: List[ParsedDecl],
	module_identity: String,
) -> List[ParsedImportSymbol]:
	var result: List[ParsedImportSymbol] = []

	for decl in prelude_decls:
		match decl:
			ImportBlockParsedDecl(imports, _):
				for import_decl in imports:
					if compiler_import_identity(
						import_modules,
						import_decl.module_path,
					) == module_identity:
						match import_decl.symbols:
							Some(symbols):
								for symbol in symbols:
									if not compiler_import_symbols_contain_name(
										result,
										symbol.name.text,
									):
										result = result.append(symbol)
							None:
								void
			_:
				void

	result


private pure func compiler_merge_prelude_import_symbols(
	import_modules: List[CompilerImportableModule],
	prelude_decls: List[ParsedDecl],
	import_decl: ParsedImportDecl,
) -> ParsedImportDecl:
	match import_decl.symbols:
		Some(user_symbols):
			module_identity: String = compiler_import_identity(
				import_modules,
				import_decl.module_path,
			)
			prelude_symbols: List[ParsedImportSymbol] = compiler_prelude_symbols_for_identity(
				import_modules,
				prelude_decls,
				module_identity,
			)
			var merged: List[ParsedImportSymbol] = user_symbols

			for symbol in prelude_symbols:
				if not compiler_import_symbols_contain_name(merged, symbol.name.text):
					merged = merged.append(symbol)

			if merged.length() == user_symbols.length():
				import_decl
			else:
				{ import_decl | symbols = Some(merged) }
		None:
			import_decl


private pure func compiler_merge_prelude_imports_into_decl(
	import_modules: List[CompilerImportableModule],
	prelude_decls: List[ParsedDecl],
	decl: ParsedDecl,
) -> ParsedDecl:
	match decl:
		ImportBlockParsedDecl(imports, span):
			ImportBlockParsedDecl(
				imports.map(
					func(
						import_decl,
					): compiler_merge_prelude_import_symbols(
						import_modules,
						prelude_decls,
						import_decl,
					),
				),
				span,
			)
		PrivateParsedDecl(ImportBlockParsedDecl(imports, span), private_span):
			PrivateParsedDecl(
				ImportBlockParsedDecl(
					imports.map(
						func(
							import_decl,
						): compiler_merge_prelude_import_symbols(
							import_modules,
							prelude_decls,
							import_decl,
						),
					),
					span,
				),
				private_span,
			)
		_:
			decl


private pure func compiler_filter_prelude_import_decls_for_missing_modules(
	import_modules: List[CompilerImportableModule],
	user_identities: List[String],
	prelude_decls: List[ParsedDecl],
) -> List[ParsedDecl]:
	var result: List[ParsedDecl] = []

	for decl in prelude_decls:
		match decl:
			ImportBlockParsedDecl(imports, span):
				var filtered: List[ParsedImportDecl] = []

				for import_decl in imports:
					module_identity: String = compiler_import_identity(
						import_modules,
						import_decl.module_path,
					)

					if not user_identities.contains(module_identity):
						filtered = filtered.append(import_decl)

				if filtered.length() > 0:
					result = result.append(ImportBlockParsedDecl(filtered, span))
			_:
				void

	result


private pure func compiler_program_with_prelude_imports(
	state: CompilerTypecheckState,
	program: ParsedProgram,
	import_modules: List[CompilerImportableModule],
) -> ParsedProgram:
	if program.source.module_name == "prelude" or program.source.module_name == "std/prelude":
		program
	else:
		local_names: List[String] = compiler_local_top_level_names(program)
		prelude_decls: List[ParsedDecl] = compiler_prelude_import_decls(import_modules, local_names)

		if prelude_decls.length() == 0:
			program
		else:
			user_identities: List[String] = compiler_program_import_identities(
				import_modules,
				program,
			).concat(compiler_program_current_import_identities(state, program))
			prepend_decls: List[ParsedDecl] = compiler_filter_prelude_import_decls_for_missing_modules(
				import_modules,
				user_identities,
				prelude_decls,
			)
			merged_decls: List[ParsedDecl] = program.decls.map(
				func(
					decl,
				): compiler_merge_prelude_imports_into_decl(import_modules, prelude_decls, decl),
			)

			{
				source = program.source,
				decls = prepend_decls.concat(merged_decls),
				diagnostics = program.diagnostics
			}


private pure func compiler_body_check_param_label(param: ParsedParam) -> String:
	match param.binder:
		ParsedParamNameBinder(name):
			name.text
		ParsedParamWildcardBinder(_):
			"_"
		ParsedParamTupleBinder(_, _):
			"tuple parameter"


private pure func compiler_body_check_missing_param_type_error(
	state: CompilerTypecheckState,
	function_name: String,
	param: ParsedParam,
) -> CompilerTypecheckState:
	compiler_typecheck_state_add_error(
		state,
		"Function '" + function_name + "' parameter '" + compiler_body_check_param_label(
			param,
		) + "' must have an explicit type to check the body",
	)


private pure func compiler_add_function_param_binding(
	state: CompilerTypecheckState,
	name: ParsedIdentifier,
	param_type: CompilerType,
) -> CompilerTypecheckState:
	compiler_typecheck_state_with_env(
		state,
		compiler_env_add_var_with_details(
			state.env,
			name.text,
			param_type,
			Some(param_type),
			CompilerImmutableBinding,
			CompilerFuncParam,
			compiler_unrefined_binding(),
		),
	)


private pure func compiler_add_tuple_function_param_bindings(
	state: CompilerTypecheckState,
	function_name: String,
	names: List[ParsedIdentifier],
	elements: List[CompilerType],
) -> CompilerTypecheckState:
	if names.length() != elements.length():
		compiler_typecheck_state_add_error(
			state,
			"Function '" + function_name + "' tuple parameter has " + names
				.length()
				.to_string() + " names but annotation has " + elements
				.length()
				.to_string() + " elements",
		)
	else:
		var next = state
		var index: Int = 0

		while index < names.length():
			match (names.get(index), elements.get(index)):
				(Some(name), Some(element_type)):
					next = compiler_add_function_param_binding(next, name, element_type)
				_:
					void

			index += 1

		next


private pure func compiler_prepare_function_param(
	state: CompilerTypecheckState,
	function_name: String,
	param: ParsedParam,
	param_type: CompilerType,
) -> CompilerTypecheckState:
	typed_state = match param.type_expr:
		Some(_):
			state
		None:
			compiler_body_check_missing_param_type_error(state, function_name, param)

	match param.binder:
		ParsedParamNameBinder(name):
			compiler_add_function_param_binding(typed_state, name, param_type)
		ParsedParamWildcardBinder(_):
			typed_state
		ParsedParamTupleBinder(names, _):
			match param_type:
				CompilerTupleType(elements):
					compiler_add_tuple_function_param_bindings(
						typed_state,
						function_name,
						names,
						elements,
					)
				_:
					compiler_typecheck_state_add_error(
						typed_state,
						"Function '" + function_name + "' tuple parameter requires a tuple annotation",
					)


private pure func compiler_prepare_function_body_state(
	state: CompilerTypecheckState,
	function_decl: ParsedFunctionDecl,
	signature: CompilerFunctionBodySignature,
) -> CompilerTypecheckState:
	env_with_scope = compiler_env_push_scope(state.env)
	env_with_type_params = compiler_env_extend_type_param_bounds(
		env_with_scope,
		signature.effective_type_params,
	)
	var next = compiler_typecheck_state_with_env(state, env_with_type_params)
	var index: Int = 0

	while index < function_decl.params.length():
		match function_decl.params.get(index):
			Some(param):
				next = compiler_prepare_function_param(
					next,
					function_decl.name.text,
					param,
					signature.param_types.get_or(index, compiler_type_void()),
				)
			None:
				void

		index += 1

	next


private pure func compiler_body_check_context_with_expected_type(
	state: CompilerTypecheckState,
	return_type: Option[CompilerType],
) -> CompilerInferContext:
	context = compiler_infer_context(state)

	match return_type:
		Some(expected_type):
			compiler_infer_with_expected_value_slot(
				context,
				expected_type,
				CompilerExpectedArgumentSlot,
			)
		None:
			compiler_infer_without_expected(context)


private pure func compiler_function_return_type_mismatch_error(
	state: CompilerTypecheckState,
	function_name: String,
	expected: CompilerType,
	found: CompilerType,
) -> CompilerTypecheckState:
	compiler_typecheck_state_add_error(
		state,
		"Function '" + function_name + "' returns wrong type\n    expected: " + compiler_type_to_string(
			expected,
		) + "  (declared return type)\n       found: " + compiler_type_to_string(
			found,
		) + "  (body expression)",
	)


private pure func compiler_function_missing_return_type_error(
	state: CompilerTypecheckState,
	function_name: String,
	found: CompilerType,
) -> CompilerTypecheckState:
	compiler_typecheck_state_add_error(
		state,
		"Function '" + function_name + "' body has type " + compiler_type_to_string(
			found,
		) + " but no return type is declared\n    help: add '-> " + compiler_type_to_string(
			found,
		) + "' to the function signature, or use '-> Void' if discarding the result",
	)


-- Registered signatures and finalized expression slots are canonical at this
-- boundary. Keeping the comparison environment-free prevents redundant alias
-- reconstruction and makes that caller invariant explicit.
private pure func compiler_canonical_return_types_compatible(
	type_params: List[String],
	expected: CompilerType,
	found: CompilerType,
) -> Bool:
	compiler_types_compatible_with_params(type_params, expected, found)


private pure func compiler_check_function_like_body_result(
	function_name: String,
	return_type: Option[CompilerType],
	value_matches_declared_return: Bool,
	result: CompilerInferResult,
) -> CompilerTypecheckState:
	found_type = compiler_typed_expr_value_type(result.expr)
	found_semantic_type = compiler_typed_expr_semantic_type(result.expr)

	match return_type:
		Some(expected_type):
			if (
				value_matches_declared_return
				or compiler_canonical_return_types_compatible(
					compiler_env_get_type_params(result.context.state.env),
					expected_type,
					found_semantic_type,
				)
			):
				result.context.state
			else:
				compiler_function_return_type_mismatch_error(
					result.context.state,
					function_name,
					expected_type,
					found_type,
				)
		None:
			if compiler_types_equal(found_type, compiler_type_void()):
				result.context.state
			else:
				compiler_function_missing_return_type_error(
					result.context.state,
					function_name,
					found_type,
				)


private MAIN_SIGNATURE_MESSAGE: String = "main must have signature: func main(args: List[String]) -> Int:"


private pure func compiler_main_param_type_valid(param: ParsedParam) -> Bool:
	match compiler_param_annotation_type(param):
		Some(typ):
			compiler_types_equal(typ, compiler_type_list(compiler_type_string()))
		None:
			False


private pure func compiler_main_return_type_valid(return_type: Option[ParsedTypeExpr]) -> Bool:
	match return_type:
		Some(type_expr):
			typ = compiler_type_from_parsed_type_expr(type_expr)

			(
				compiler_types_equal(typ, compiler_type_int())
				or compiler_types_equal(typ, compiler_type_void())
			)
		None:
			True


private pure func compiler_main_return_type_text(return_type: Option[ParsedTypeExpr]) -> String:
	match return_type:
		Some(type_expr):
			compiler_type_to_string(compiler_type_from_parsed_type_expr(type_expr))
		None:
			"Void"


private pure func compiler_check_main_signature(
	state: CompilerTypecheckState,
	function_decl: ParsedFunctionDecl,
) -> CompilerTypecheckState:
	if function_decl.name.text != "main":
		state
	else if function_decl.params.length() != 1:
		compiler_typecheck_state_add_error(state, MAIN_SIGNATURE_MESSAGE)
	else:
		match function_decl.params.get(0):
			Some(param):
				param_valid = compiler_main_param_type_valid(param)
				return_valid = compiler_main_return_type_valid(function_decl.return_type)

				if not param_valid and not return_valid:
					compiler_typecheck_state_add_error(state, MAIN_SIGNATURE_MESSAGE)
				else if not return_valid:
					compiler_typecheck_state_add_error(
						state,
						"main must return Int or Void, got " + compiler_main_return_type_text(
							function_decl.return_type,
						),
					)
				else if not param_valid:
					param_text = match compiler_param_annotation_type(param):
						Some(typ):
							compiler_type_to_string(typ)
						None:
							"untyped"

					compiler_typecheck_state_add_error(
						state,
						"main parameter must be List[String], got " + param_text,
					)
				else:
					state
			None:
				compiler_typecheck_state_add_error(state, MAIN_SIGNATURE_MESSAGE)


private pure func compiler_check_pure_function_body_calls(
	state: CompilerTypecheckState,
	function_decl: ParsedFunctionDecl,
	result: CompilerInferResult,
) -> CompilerTypecheckState:
	compiler_check_pure_function_like_body_calls(
		state,
		function_decl.name.text,
		function_decl.is_pure,
		result,
	)


private pure func compiler_check_pure_function_like_body_calls(
	state: CompilerTypecheckState,
	function_name: String,
	is_pure: Bool,
	result: CompilerInferResult,
) -> CompilerTypecheckState:
	if not is_pure:
		state
	else:
		var next = state

		for call_name in compiler_typed_expr_impure_call_names(result.expr):
			next = compiler_typecheck_state_add_error(
				next,
				"Pure function '" + function_name + "' cannot call impure function '" + call_name + "'",
			)

		next


private pure func compiler_check_pure_function_module_assignments(
	state: CompilerTypecheckState,
	function_decl: ParsedFunctionDecl,
	result: CompilerInferResult,
) -> CompilerTypecheckState:
	compiler_check_pure_function_like_module_assignments(
		state,
		function_decl.name.text,
		function_decl.is_pure,
		result,
	)


private pure func compiler_check_pure_function_like_module_assignments(
	state: CompilerTypecheckState,
	function_name: String,
	is_pure: Bool,
	result: CompilerInferResult,
) -> CompilerTypecheckState:
	if not is_pure:
		state
	else:
		var next = state

		for name in compiler_typed_expr_module_assign_names(result.expr):
			next = compiler_typecheck_state_add_error(
				next,
				"Pure function '" + function_name + "' cannot assign to module-level variable '" + name + "'",
			)

		next


private pure func compiler_check_debug_block_body(
	state: CompilerTypecheckState,
	result: CompilerInferResult,
) -> CompilerTypecheckState:
	with_assignments = if compiler_typed_expr_has_debug_block_assignment(result.expr):
		compiler_typecheck_state_add_error(state, "debug: blocks cannot assign")
	else:
		state

	var next = with_assignments

	for call_name in compiler_typed_expr_debug_block_impure_call_names(result.expr):
		next = compiler_typecheck_state_add_error(
			next,
			"debug: blocks cannot call impure function '" + call_name + "'",
		)

	next


private pure func compiler_type_is_impure_function_type(typ: CompilerType) -> Bool:
	match typ:
		CompilerFunctionType(is_pure, _, _):
			not is_pure
		_:
			False


private pure func compiler_check_pure_function_callback_params(
	state: CompilerTypecheckState,
	function_decl: ParsedFunctionDecl,
	param_types: List[CompilerType],
) -> CompilerTypecheckState:
	compiler_check_pure_function_like_callback_params(
		state,
		function_decl.name.text,
		function_decl.is_pure,
		function_decl.params,
		param_types,
	)


private pure func compiler_check_pure_function_like_callback_params(
	state: CompilerTypecheckState,
	function_name: String,
	is_pure: Bool,
	params: List[ParsedParam],
	param_types: List[CompilerType],
) -> CompilerTypecheckState:
	if not is_pure:
		state
	else:
		var next = state
		var index: Int = 0

		while index < params.length():
			match (params.get(index), param_types.get(index)):
				(Some(param), Some(param_type)):
					if compiler_type_is_impure_function_type(param_type):
						next = compiler_typecheck_state_add_error(
							next,
							"Pure function '" + function_name + "' has impure callback parameter '" + compiler_body_check_param_label(
								param,
							) + "'",
						)
				_:
					void

			index += 1

		next


private pure func compiler_check_nested_pure_lambda_body_calls(
	state: CompilerTypecheckState,
	result: CompilerInferResult,
) -> CompilerTypecheckState:
	var next = state

	for call_name in compiler_typed_expr_pure_lambda_impure_call_names(result.expr):
		next = compiler_typecheck_state_add_error(
			next,
			"Pure function '<lambda>' cannot call impure function '" + call_name + "'",
		)

	next


private pure func compiler_check_tail_recursive_function_body(
	state: CompilerTypecheckState,
	function_decl: ParsedFunctionDecl,
	result: CompilerInferResult,
) -> CompilerTypecheckState:
	if not compiler_function_tail_recursive(function_decl.annotations):
		state
	else if compiler_typed_expr_has_non_tail_recursive_call(result.expr, function_decl.name.text):
		compiler_typecheck_state_add_error(
			state,
			"@tail_recursive function '" + function_decl.name.text + "' has recursive call not in tail position",
		)
	else:
		state


private pure func compiler_typed_function_info(
	function_decl: ParsedFunctionDecl,
	signature: CompilerFunctionBodySignature,
	body: Option[CompilerTypedExpr],
) -> CompilerTypedFunctionInfo:
	source_return_type: Option[CompilerType] = function_decl.return_type.map(
		compiler_type_from_parsed_type_expr,
	)

	{
		decl = function_decl,
		callable_id = signature.callable_id,
		effective_type_params = signature.effective_type_params,
		param_types = signature.param_types,
		source_return_type = source_return_type,
		semantic_return_type = signature.semantic_return_type,
		body = body
	}


private pure func compiler_declared_return_value_slot(
	return_type: CompilerType,
) -> CompilerValueSlot:
	{
		semantic_type = return_type,
		decision = CompilerTypeKeep(return_type)
	}


private pure func compiler_materialize_declared_return_body(
	return_type: Option[CompilerType],
	body: CompilerTypedExpr,
	value_matches_declared_return: Bool,
) -> CompilerTypedExpr:
	match return_type:
		Some(expected):
			if value_matches_declared_return:
				compiler_typed_expr_with_slot(body, compiler_declared_return_value_slot(expected))
			else:
				body
		None:
			body


private pure func compiler_typecheck_materialize_function_body_with_options(
	state: CompilerTypecheckState,
	function_decl: ParsedFunctionDecl,
	should_check_main_signature: Bool,
) -> CompilerTypecheckFunctionBodyResult:
	signature_state = if should_check_main_signature:
		compiler_check_main_signature(state, function_decl)
	else:
		state

	signature = compiler_function_body_signature(signature_state, function_decl)
	declared_return_type = compiler_function_declared_return_type(function_decl, signature)

	match function_decl.body:
		Some(body):
			if parsed_function_body_is_builtin(function_decl.body):
				typed_info = compiler_typed_function_info(function_decl, signature, None)

				{
					state = signature_state,
					typed = typed_info
				}
			else:
				body_state = compiler_prepare_function_body_state(
					signature_state,
					function_decl,
					signature,
				)
				context = compiler_body_check_context_with_expected_type(
					body_state,
					declared_return_type,
				)
				raw_result = compiler_infer_expr(context, body)
				result = compiler_finalize_infer_result(raw_result)

				value_matches_declared_return = match declared_return_type:
					Some(expected_type):
						compiler_canonical_return_types_compatible(
							compiler_env_get_type_params(result.context.state.env),
							expected_type,
							compiler_typed_expr_value_type(result.expr),
						)
					None:
						False

				checked_state = compiler_check_function_like_body_result(
					function_decl.name.text,
					declared_return_type,
					value_matches_declared_return,
					result,
				)
				debug_checked_state = compiler_check_debug_block_body(checked_state, result)
				callback_checked_state = compiler_check_pure_function_callback_params(
					debug_checked_state,
					function_decl,
					signature.param_types,
				)
				lambda_checked_state = compiler_check_nested_pure_lambda_body_calls(
					callback_checked_state,
					result,
				)
				purity_checked_state = compiler_check_pure_function_body_calls(
					lambda_checked_state,
					function_decl,
					result,
				)
				module_assign_checked_state = compiler_check_pure_function_module_assignments(
					purity_checked_state,
					function_decl,
					result,
				)
				tail_checked_state = compiler_check_tail_recursive_function_body(
					module_assign_checked_state,
					function_decl,
					result,
				)
				typed_body = compiler_materialize_declared_return_body(
					declared_return_type,
					result.expr,
					value_matches_declared_return,
				)
				final_state = compiler_typecheck_with_body_env(signature_state, tail_checked_state)
				typed_info = compiler_typed_function_info(
					function_decl,
					signature,
					Some(typed_body),
				)

				{
					state = final_state,
					typed = typed_info
				}
		None:
			typed_info = compiler_typed_function_info(function_decl, signature, None)

			{
				state = signature_state,
				typed = typed_info
			}


private pure func compiler_typecheck_check_function_body_with_options(
	state: CompilerTypecheckState,
	function_decl: ParsedFunctionDecl,
	should_check_main_signature: Bool,
) -> CompilerTypecheckState:
	compiler_typecheck_materialize_function_body_with_options(
		state,
		function_decl,
		should_check_main_signature,
	).state


pure func compiler_typecheck_check_function_body(
	state: CompilerTypecheckState,
	function_decl: ParsedFunctionDecl,
) -> CompilerTypecheckState:
	compiler_typecheck_check_function_body_with_options(state, function_decl, True)


private pure func compiler_global_var_type_mismatch_error(
	state: CompilerTypecheckState,
	name: String,
) -> CompilerTypecheckState:
	compiler_typecheck_state_add_error(state, "Global variable '" + name + "' has wrong type")


private pure func compiler_register_checked_global_var(
	state: CompilerTypecheckState,
	module_path: String,
	var_decl: ParsedVarDecl,
	inferred_type: CompilerType,
	source_type: Option[CompilerType],
) -> CompilerTypecheckState:
	compiler_typecheck_state_with_env(
		state,
		compiler_env_add_var_with_module_details(
			state.env,
			var_decl.name.text,
			inferred_type,
			source_type,
			compiler_var_mutability(var_decl.is_mutable),
			CompilerLetBinding,
			compiler_unrefined_binding(),
			Some(module_path),
		),
	)


private pure func compiler_check_mutable_global_startup_work(
	state: CompilerTypecheckState,
	var_decl: ParsedVarDecl,
	result: CompilerInferResult,
) -> CompilerTypecheckState:
	if not var_decl.is_mutable:
		state
	else:
		var next = state

		for call_name in compiler_typed_expr_startup_call_names(result.expr):
			next = compiler_typecheck_state_add_error(
				next,
				"top-level initializer '" + var_decl.name.text + "' cannot call function '" + call_name + "'",
			)

		if compiler_typed_expr_has_startup_subscript(result.expr):
			next = compiler_typecheck_state_add_error(
				next,
				"top-level initializer '" + var_decl.name.text + "' cannot use a subscript expression",
			)

		next


private pure func compiler_typed_global_var_info(
	var_decl: ParsedVarDecl,
	binding_type: CompilerType,
	source_type: Option[CompilerType],
	value: CompilerTypedExpr,
) -> CompilerTypedGlobalVarInfo:
	{
		decl = var_decl,
		binding_type = binding_type,
		source_type = source_type,
		value = value
	}


pure func compiler_typecheck_materialize_global_var_body(
	state: CompilerTypecheckState,
	module_path: String,
	var_decl: ParsedVarDecl,
) -> CompilerTypecheckGlobalVarBodyResult:
	declared_source_type: Option[CompilerType] = var_decl.type_expr.map(
		compiler_type_from_parsed_type_expr,
	)

	type_expectation: CompilerGlobalTypeExpectation = match declared_source_type:
		Some(typ):
			CompilerDeclaredGlobalType(compiler_canonical_annotation_type(state, typ))
		None:
			CompilerInferredGlobalType

	context = match type_expectation:
		CompilerDeclaredGlobalType(expected):
			compiler_infer_with_expected_value_slot(
				compiler_infer_context(state),
				expected,
				CompilerExpectedArgumentSlot,
			)
		CompilerInferredGlobalType:
			compiler_infer_context(state)

	raw_result = compiler_infer_expr(context, var_decl.value)
	result = compiler_finalize_infer_result(raw_result)
	found_type = compiler_typed_expr_value_type(result.expr)

	type_matches = match type_expectation:
		CompilerDeclaredGlobalType(expected):
			compiler_types_compatible_with_params(
				compiler_env_get_type_params(result.context.state.env),
				expected,
				found_type,
			)
		CompilerInferredGlobalType:
			True

	checked_state = match type_expectation:
		CompilerDeclaredGlobalType(_):
			if type_matches:
				result.context.state
			else:
				compiler_global_var_type_mismatch_error(result.context.state, var_decl.name.text)
		CompilerInferredGlobalType:
			result.context.state

	startup_checked_state = if type_matches:
		compiler_check_mutable_global_startup_work(checked_state, var_decl, result)
	else:
		checked_state

	binding_type = match type_expectation:
		CompilerDeclaredGlobalType(expected):
			expected
		CompilerInferredGlobalType:
			compiler_typed_expr_semantic_type(result.expr)

	final_state = compiler_register_checked_global_var(
		startup_checked_state,
		module_path,
		var_decl,
		binding_type,
		declared_source_type,
	)

	{
		state = final_state,
		typed = compiler_typed_global_var_info(
			var_decl,
			binding_type,
			declared_source_type,
			result.expr,
		)
	}


private pure func compiler_impl_error_message(
	impl_decl: ParsedImplDecl,
	for_type: CompilerType,
	message: String,
) -> String:
	"impl " + impl_decl.trait_name.text + " for " + compiler_type_to_string(
		for_type,
	) + ": " + message


private pure func compiler_impl_method_names(methods: List[ParsedFunctionDecl]) -> List[String]:
	methods.map(func(method): method.name.text)


private pure func compiler_impl_has_method(methods: List[ParsedFunctionDecl], name: String) -> Bool:
	compiler_impl_method_names(methods).contains(name)


private pure func compiler_find_trait_method(
	methods: List[CompilerTraitMethodSig],
	name: String,
) -> Option[CompilerTraitMethodSig]:
	var result: Option[CompilerTraitMethodSig] = None

	for method in methods:
		if method.name == name:
			result = Some(method)
			break

	result


private pure func compiler_resolve_impl_method_sig(
	for_type: CompilerType,
	method: CompilerTraitMethodSig,
) -> CompilerTraitMethodSig:
	{
		name = method.name,
		params = method.params.map(func(param): compiler_resolve_self(for_type, param)),
		return_type = compiler_resolve_self(for_type, method.return_type),
		is_pure = method.is_pure,
		has_default = method.has_default,
		param_names = method.param_names
	}


private pure func compiler_impl_validate_required_methods(
	state: CompilerTypecheckState,
	impl_decl: ParsedImplDecl,
	for_type: CompilerType,
	methods: List[CompilerTraitMethodSig],
) -> CompilerTypecheckState:
	var next = state

	for method in methods:
		if not method.has_default and not compiler_impl_has_method(impl_decl.methods, method.name):
			next = compiler_typecheck_state_add_error(
				next,
				compiler_impl_error_message(
					impl_decl,
					for_type,
					"missing required method '" + method.name + "'",
				),
			)

	next


private pure func compiler_impl_validate_supertraits(
	state: CompilerTypecheckState,
	impl_decl: ParsedImplDecl,
	for_type: CompilerType,
	supertraits: List[String],
) -> CompilerTypecheckState:
	var next = state

	for supertrait in supertraits:
		if not compiler_env_has_direct_trait_evidence(
			next.env,
			compiler_trait_obligation(for_type, supertrait),
		):
			next = compiler_typecheck_state_add_error(
				next,
				compiler_impl_error_message(
					impl_decl,
					for_type,
					"supertrait '" + supertrait + "' is not implemented",
				),
			)

	next


private pure func compiler_impl_method_param_label(param: ParsedParam) -> String:
	compiler_param_name_from_parsed(param).get_or("_")


private pure func compiler_impl_validate_method_params(
	state: CompilerTypecheckState,
	impl_decl: ParsedImplDecl,
	for_type: CompilerType,
	method: ParsedFunctionDecl,
	expected_params: List[CompilerType],
	type_params: List[String],
) -> CompilerTypecheckState:
	if method.params.length() != expected_params.length():
		compiler_typecheck_state_add_error(
			state,
			compiler_impl_error_message(
				impl_decl,
				for_type,
				"method '" + method.name.text + "' has " + method.params
					.length()
					.to_string() + " parameters, trait requires " + expected_params
					.length()
					.to_string(),
			),
		)
	else:
		var next = state
		var index: Int = 0

		while index < method.params.length():
			match (method.params.get(index), expected_params.get(index)):
				(Some(param), Some(expected_type)):
					impl_type = compiler_param_type_from_parsed(param)

					if not compiler_types_compatible_with_params(
						type_params,
						expected_type,
						impl_type,
					):
						next = compiler_typecheck_state_add_error(
							next,
							compiler_impl_error_message(
								impl_decl,
								for_type,
								"method '" + method.name.text + "' parameter '" + compiler_impl_method_param_label(
									param,
								) + "' has type " + compiler_type_to_string(
									impl_type,
								) + ", trait requires " + compiler_type_to_string(expected_type),
							),
						)
				_:
					void

			index += 1

		next


private pure func compiler_impl_validate_method_signature(
	state: CompilerTypecheckState,
	impl_decl: ParsedImplDecl,
	for_type: CompilerType,
	method: ParsedFunctionDecl,
	trait_method: CompilerTraitMethodSig,
) -> CompilerTypecheckState:
	resolved = compiler_resolve_impl_method_sig(for_type, trait_method)

	purity_state = if resolved.is_pure and not method.is_pure:
		compiler_typecheck_state_add_error(
			state,
			compiler_impl_error_message(
				impl_decl,
				for_type,
				"method '" + method.name.text + "' must be pure",
			),
		)
	else:
		state

	return_state = match method.return_type:
		Some(return_type):
			impl_return = compiler_type_from_parsed_type_expr(return_type)
			type_params = compiler_collect_type_vars(
				for_type,
			).concat(compiler_type_param_names(method.type_params))

			if compiler_types_compatible_with_params(
				type_params,
				resolved.return_type,
				impl_return,
			):
				purity_state
			else:
				compiler_typecheck_state_add_error(
					purity_state,
					compiler_impl_error_message(
						impl_decl,
						for_type,
						"method '" + method.name.text + "' returns " + compiler_type_to_string(
							impl_return,
						) + ", trait requires " + compiler_type_to_string(resolved.return_type),
					),
				)
		None:
			purity_state

	type_params = compiler_collect_type_vars(
		for_type,
	).concat(compiler_type_param_names(method.type_params))
	compiler_impl_validate_method_params(
		return_state,
		impl_decl,
		for_type,
		method,
		resolved.params,
		type_params,
	)


private pure func compiler_impl_validate_method_signatures(
	state: CompilerTypecheckState,
	impl_decl: ParsedImplDecl,
	for_type: CompilerType,
	methods: List[CompilerTraitMethodSig],
) -> CompilerTypecheckState:
	var next = state

	for method in impl_decl.methods:
		match compiler_find_trait_method(methods, method.name.text):
			Some(trait_method):
				next = compiler_impl_validate_method_signature(
					next,
					impl_decl,
					for_type,
					method,
					trait_method,
				)
			None:
				void

	next


private pure func compiler_find_trait_decl_in_decl(
	decl: ParsedDecl,
	trait_name: String,
) -> Option[ParsedTraitDecl]:
	match decl:
		TraitParsedDecl(trait_decl):
			if trait_decl.name.text == trait_name:
				Some(trait_decl)
			else:
				None
		PrivateParsedDecl(inner, _):
			compiler_find_trait_decl_in_decl(inner, trait_name)
		_:
			None


private pure func compiler_find_trait_decl(
	decls: List[ParsedDecl],
	trait_name: String,
) -> Option[ParsedTraitDecl]:
	var result: Option[ParsedTraitDecl] = None

	for decl in decls:
		match compiler_find_trait_decl_in_decl(decl, trait_name):
			Some(trait_decl):
				result = Some(trait_decl)
				break
			None:
				void

	result


private pure func compiler_resolve_self_parsed_type(
	replacement: ParsedTypeExpr,
	type_expr: ParsedTypeExpr,
) -> ParsedTypeExpr:
	match type_expr:
		ParsedNamedType(name, args, span):
			if name.text == "Self" and args.length() == 0:
				replacement
			else:
				ParsedNamedType(
					name,
					args.map(func(arg): compiler_resolve_self_parsed_type(replacement, arg)),
					span,
				)
		ParsedQualifiedNamedType(qualifier, name, args, span):
			ParsedQualifiedNamedType(
				qualifier,
				name,
				args.map(func(arg): compiler_resolve_self_parsed_type(replacement, arg)),
				span,
			)
		ParsedTupleType(items, span):
			ParsedTupleType(
				items.map(func(item): compiler_resolve_self_parsed_type(replacement, item)),
				span,
			)
		ParsedArrayType(element, dims, span):
			ParsedArrayType(
				compiler_resolve_self_parsed_type(replacement, element),
				dims.map(func(dim): compiler_resolve_self_parsed_type(replacement, dim)),
				span,
			)
		ParsedFunctionType(is_pure, params, return_type, span):
			ParsedFunctionType(
				is_pure,
				params.map(func(param): compiler_resolve_self_parsed_type(replacement, param)),
				compiler_resolve_self_parsed_type(replacement, return_type),
				span,
			)
		ParsedRangeType(inner, span):
			ParsedRangeType(
				compiler_resolve_self_parsed_type(replacement, inner),
				span,
			)
		ParsedDimBinaryType(op, left, right, span):
			ParsedDimBinaryType(
				op,
				compiler_resolve_self_parsed_type(replacement, left),
				compiler_resolve_self_parsed_type(replacement, right),
				span,
			)
		_:
			type_expr


private pure func compiler_resolve_self_optional_parsed_type(
	replacement: ParsedTypeExpr,
	type_expr: Option[ParsedTypeExpr],
) -> Option[ParsedTypeExpr]:
	type_expr.map(func(value): compiler_resolve_self_parsed_type(replacement, value))


private pure func compiler_resolve_self_parsed_param(
	replacement: ParsedTypeExpr,
	param: ParsedParam,
) -> ParsedParam:
	{ param | type_expr = compiler_resolve_self_optional_parsed_type(replacement, param.type_expr) }


private pure func compiler_resolve_self_parsed_function(
	replacement: ParsedTypeExpr,
	decl: ParsedFunctionDecl,
) -> ParsedFunctionDecl:
	{ decl |
		params = decl.params.map(
			func(param): compiler_resolve_self_parsed_param(replacement, param),
		),
		return_type = compiler_resolve_self_optional_parsed_type(replacement, decl.return_type),
		body = decl.body.map(func(body): compiler_resolve_self_parsed_expr(replacement, body))
	}


private pure func compiler_resolve_self_parsed_expr(
	replacement: ParsedTypeExpr,
	expr: ParsedExpr,
) -> ParsedExpr:
	with_children = map_parsed_expr_children(
		expr,
		func(child): compiler_resolve_self_parsed_expr(replacement, child),
	)

	match with_children:
		ParsedAscriptionExpr(value, type_expr, span):
			ParsedAscriptionExpr(
				value,
				compiler_resolve_self_parsed_type(replacement, type_expr),
				span,
			)
		ParsedOpaqueIntoExpr(type_expr, value, span):
			ParsedOpaqueIntoExpr(
				compiler_resolve_self_parsed_type(replacement, type_expr),
				value,
				span,
			)
		ParsedOpaqueFromExpr(type_expr, value, span):
			ParsedOpaqueFromExpr(
				compiler_resolve_self_parsed_type(replacement, type_expr),
				value,
				span,
			)
		ParsedWithExpr(binding, body, span):
			ParsedWithExpr(
				{ binding |
					type_expr = compiler_resolve_self_optional_parsed_type(
						replacement,
						binding.type_expr,
					)
				},
				body,
				span,
			)
		ParsedLambdaExpr(is_pure, params, return_type, body, span):
			ParsedLambdaExpr(
				is_pure,
				params.map(
					func(
						param,
					): { param |
						type_expr = compiler_resolve_self_optional_parsed_type(
							replacement,
							param.type_expr,
						)
					},
				),
				compiler_resolve_self_optional_parsed_type(replacement, return_type),
				body,
				span,
			)
		ParsedFunctionDeclExpr(decl):
			ParsedFunctionDeclExpr(compiler_resolve_self_parsed_function(replacement, decl))
		ParsedVarDeclExpr(name, type_expr, value, is_mutable, span):
			ParsedVarDeclExpr(
				name,
				compiler_resolve_self_optional_parsed_type(replacement, type_expr),
				value,
				is_mutable,
				span,
			)
		ParsedQuestionBindExpr(name, type_expr, value, span):
			ParsedQuestionBindExpr(
				name,
				compiler_resolve_self_optional_parsed_type(replacement, type_expr),
				value,
				span,
			)
		_:
			with_children


private pure func compiler_default_impl_method_decl(
	impl_decl: ParsedImplDecl,
	method: ParsedTraitMethodDecl,
) -> ParsedFunctionDecl:
	replacement: ParsedTypeExpr = impl_decl.for_type
	{
		name = method.name,
		type_params = [],
		params = method.params.map(
			func(param): compiler_resolve_self_parsed_param(replacement, param),
		),
		return_type = compiler_resolve_self_optional_parsed_type(replacement, method.return_type),
		dim_constraints = [],
		body = method.body.map(func(body): compiler_resolve_self_parsed_expr(replacement, body)),
		is_pure = method.is_pure,
		annotations = [],
		doc = None,
		span = impl_decl.span
	}


private pure func compiler_find_imported_trait_decl(
	import_modules: List[CompilerImportableModule],
	module_path: String,
	trait_name: String,
) -> Option[ParsedTraitDecl]:
	var result: Option[ParsedTraitDecl] = None

	for module in import_modules:
		if compiler_importable_module_path(module) == module_path:
			result = compiler_find_trait_decl(compiler_importable_module_decls(module), trait_name)
			break

	result


private pure func compiler_importable_module_is_prelude_traits(
	module: CompilerImportableModule,
) -> Bool:
	(
		compiler_importable_module_path(module) == COMPILER_PRELUDE_TRAITS_MODULE_PATH
		or compiler_importable_module_path(module) == COMPILER_PRELUDE_TRAITS_MODULE_NAME
		or compiler_importable_module_surface_value(
			module,
		).module_name == COMPILER_PRELUDE_TRAITS_MODULE_PATH
		or compiler_importable_module_surface_value(
			module,
		).module_name == COMPILER_PRELUDE_TRAITS_MODULE_NAME
	)


private pure func compiler_find_prelude_trait_decl(
	import_modules: List[CompilerImportableModule],
	trait_name: String,
) -> Option[ParsedTraitDecl]:
	var result: Option[ParsedTraitDecl] = None

	for module in import_modules:
		if compiler_importable_module_is_prelude_traits(module):
			result = compiler_find_trait_decl(compiler_importable_module_decls(module), trait_name)
			break

	result


private pure func compiler_find_impl_trait_decl(
	state: CompilerTypecheckState,
	decls: List[ParsedDecl],
	import_modules: List[CompilerImportableModule],
	trait_name: String,
) -> Option[ParsedTraitDecl]:
	match compiler_find_trait_decl(decls, trait_name):
		Some(trait_decl):
			Some(trait_decl)
		None:
			match compiler_typecheck_state_find_imported_name(state, trait_name):
				Some(binding):
					compiler_find_imported_trait_decl(
						import_modules,
						binding.module_path,
						binding.original_name,
					)
				None:
					if compiler_builtin_trait_is_prelude(trait_name):
						compiler_find_prelude_trait_decl(import_modules, trait_name)
					else:
						None


private pure func compiler_add_impl_body_trait_functions(
	state: CompilerTypecheckState,
	trait_name: String,
) -> CompilerTypecheckState:
	var next = state

	for pair in compiler_env_trait_methods_with_declaring_trait(state.env, trait_name):
		next = compiler_typecheck_state_with_env(
			next,
			compiler_env_add_trait_function(next.env, pair[0], pair[1]),
		)
		next = compiler_typecheck_state_add_scoped_trait_function(next, pair[0], pair[1])

	next


private pure func compiler_typecheck_validate_impl_decl(
	state: CompilerTypecheckState,
	impl_decl: ParsedImplDecl,
	for_type: CompilerType,
) -> CompilerTypecheckState:
	if not compiler_trait_visible_for_impl(state, impl_decl.trait_name.text):
		compiler_typecheck_state_add_error(
			state,
			compiler_impl_error_message(
				impl_decl,
				for_type,
				"unknown trait '" + impl_decl.trait_name.text + "'",
			),
		)
	else:
		compiler_typecheck_validate_visible_impl_decl(state, impl_decl, for_type)


private pure func compiler_trait_visible_for_impl(
	state: CompilerTypecheckState,
	trait_name: String,
) -> Bool:
	match compiler_typecheck_state_find_top_level_name(state, trait_name):
		Some(kind):
			kind == CompilerTopLevelTrait
		None:
			match compiler_typecheck_state_find_imported_name(state, trait_name):
				Some(_):
					True
				None:
					match compiler_env_get_trait(state.env, trait_name):
						Some(trait_def):
							match trait_def.module_path:
								Some(module_path):
									module_path == "std/traits"
								None:
									True
						None:
							False


private pure func compiler_typecheck_validate_visible_impl_decl(
	state: CompilerTypecheckState,
	impl_decl: ParsedImplDecl,
	for_type: CompilerType,
) -> CompilerTypecheckState:
	match compiler_env_get_trait(state.env, impl_decl.trait_name.text):
		Some(trait_def):
			with_required = compiler_impl_validate_required_methods(
				state,
				impl_decl,
				for_type,
				trait_def.methods,
			)
			with_supertraits = compiler_impl_validate_supertraits(
				with_required,
				impl_decl,
				for_type,
				trait_def.supertraits,
			)
			compiler_impl_validate_method_signatures(
				with_supertraits,
				impl_decl,
				for_type,
				trait_def.methods,
			)
		None:
			compiler_typecheck_state_add_error(
				state,
				compiler_impl_error_message(
					impl_decl,
					for_type,
					"unknown trait '" + impl_decl.trait_name.text + "'",
				),
			)


private pure func compiler_typecheck_materialize_impl_body(
	state: CompilerTypecheckState,
	decls: List[ParsedDecl],
	import_modules: List[CompilerImportableModule],
	impl_decl: ParsedImplDecl,
) -> CompilerTypecheckImplBodyResult:
	raw_for_type: CompilerType = compiler_canonical_annotation_type(
		state,
		compiler_type_from_parsed_type_expr(impl_decl.for_type),
	)
	for_type: CompilerType = compiler_impl_normalize_receiver_type(
		state,
		impl_decl.for_type,
		raw_for_type,
	)
	bounds: List[CompilerBoundTypeParam] = compiler_impl_bounds_for_decl_type(
		state,
		impl_decl.for_type,
		for_type,
	)

	state_with_bounds = if bounds.length() == 0:
		state
	else:
		compiler_typecheck_state_with_env(
			state,
			compiler_env_extend_type_param_bounds(state.env, bounds),
		)

	validated = compiler_typecheck_validate_impl_decl(state_with_bounds, impl_decl, for_type)

	if validated.errors.length() > state.errors.length():
		{
			state = compiler_typecheck_state_with_env(validated, state.env),
			typed = {
				decl = impl_decl,
				for_type = for_type,
				type_params = bounds,
				methods = []
			}
		}
	else:
		body_state = compiler_add_impl_body_trait_functions(validated, impl_decl.trait_name.text)

		var next = body_state
		var typed_methods: List[CompilerTypedFunctionInfo] = []

		for method in impl_decl.methods:
			method_result = compiler_typecheck_materialize_function_body_with_options(
				next,
				method,
				False,
			)
			next = method_result.state
			typed_methods = typed_methods.append(method_result.typed)

		if compiler_collect_type_vars(for_type).length() == 0:
			match compiler_find_impl_trait_decl(
				next,
				decls,
				import_modules,
				impl_decl.trait_name.text,
			):
				Some(trait_decl):
					for method in trait_decl.methods:
						if (
							method.body.is_some()
							and not compiler_impl_has_method(impl_decl.methods, method.name.text)
						):
							default_decl = compiler_default_impl_method_decl(impl_decl, method)
							method_result = compiler_typecheck_materialize_function_body_with_options(
								next,
								default_decl,
								False,
							)
							next = method_result.state
							typed_methods = typed_methods.append(method_result.typed)
				None:
					void

		{
			state = compiler_typecheck_state_with_scoped_trait_functions(
				compiler_typecheck_state_with_env(next, state.env),
				state.scoped_trait_functions,
			),
			typed = {
				decl = impl_decl,
				for_type = for_type,
				type_params = bounds,
				methods = typed_methods
			}
		}


private pure func compiler_typed_foreign_includes(
	args: List[ParsedForeignBlockArg],
) -> List[String]:
	args
		.filter(func(arg): arg.name.text == "include")
		.map(func(arg): arg.value)


private pure func compiler_typed_foreign_link_flag(
	arg: ParsedForeignBlockArg,
) -> List[CompilerTypedForeignLinkFlag]:
	match arg.name.text:
		"link":
			[
				{
					platform = None,
					flag = arg.value
				},
			]
		"link_linux":
			[
				{
					platform = Some(CompilerTypedForeignLinux),
					flag = arg.value
				},
			]
		"link_macos":
			[
				{
					platform = Some(CompilerTypedForeignMacos),
					flag = arg.value
				},
			]
		_:
			[]


private pure func compiler_typed_foreign_link_flags(
	args: List[ParsedForeignBlockArg],
) -> List[CompilerTypedForeignLinkFlag]:
	args.flat_map(compiler_typed_foreign_link_flag)


private pure func compiler_typed_foreign_function_info(
	state: CompilerTypecheckState,
	block_args: List[ParsedForeignBlockArg],
	block_span: CompilerSourceSpan,
	decl: ParsedForeignFunctionDecl,
) -> CompilerTypedForeignFunctionInfo:
	name: String = decl.name.text
	param_types: List[CompilerType] = compiler_param_types_from_parsed(
		decl.params,
	).map(
		func(param_type): compiler_canonical_annotation_type(state, param_type),
	)
	return_type: CompilerType = compiler_canonical_annotation_type(
		state,
		compiler_type_from_parsed_type_expr(decl.return_type),
	)

	arg_passing: CompilerTypedForeignArgPassing = if (
		decl.is_pure
		or compiler_function_no_copy(decl.annotations)
	):
		CompilerTypedForeignBorrowArgs
	else:
		CompilerTypedForeignDefaultArgs

	{
		decl = decl,
		callable_id = compiler_typecheck_state_find_func_callable_id(
			state,
			compiler_callable_key_from_span(name, decl.span),
		),
		param_types = param_types,
		semantic_return_type = return_type,
		c_name = decl.c_name.get_or(name),
		includes = compiler_typed_foreign_includes(block_args),
		link_flags = compiler_typed_foreign_link_flags(block_args),
		arg_passing = arg_passing,
		block_span = block_span
	}


private pure func compiler_typed_foreign_block(
	state: CompilerTypecheckState,
	block_args: List[ParsedForeignBlockArg],
	functions: List[ParsedForeignFunctionDecl],
	block_span: CompilerSourceSpan,
) -> CompilerTypedForeignBlockResult:
	var next_state: CompilerTypecheckState = state
	var typed_decls: List[CompilerTypedDecl] = []

	for function_decl in functions:
		info: CompilerTypedForeignFunctionInfo = compiler_typed_foreign_function_info(
			state,
			block_args,
			block_span,
			function_decl,
		)

		for error in compiler_validate_foreign_function(
			state.env,
			block_args,
			function_decl,
			info.param_types,
			info.semantic_return_type,
			compiler_typed_foreign_arg_passing_borrows(info.arg_passing),
		):
			next_state = compiler_typecheck_state_add_error(next_state, error)

		typed_decls = typed_decls.append(CompilerTypedForeignFunctionDecl(info))

	{
		state = next_state,
		decls = typed_decls
	}


private pure func compiler_typecheck_materialize_decl_body(
	state: CompilerTypecheckState,
	module_path: String,
	decls: List[ParsedDecl],
	import_modules: List[CompilerImportableModule],
	decl: ParsedDecl,
) -> CompilerTypecheckDeclBodyResult:
	match decl:
		FunctionParsedDecl(function_decl):
			result = compiler_typecheck_materialize_function_body_with_options(
				state,
				function_decl,
				True,
			)
			{
				state = result.state,
				decl = CompilerTypedFunctionDecl(result.typed)
			}
		VarParsedDecl(var_decl):
			result = compiler_typecheck_materialize_global_var_body(state, module_path, var_decl)
			{
				state = result.state,
				decl = CompilerTypedGlobalVarDecl(result.typed)
			}
		RecordParsedDecl(record_decl):
			{
				state = state,
				decl = CompilerTypedRecordDecl(
					compiler_typed_record_from_parsed(
						state,
						record_decl,
					),
				)
			}
		UnionParsedDecl(union_decl):
			{
				state = state,
				decl = CompilerTypedUnionDecl(compiler_typed_union_from_parsed(state, union_decl))
			}
		TypeAliasParsedDecl(alias_decl):
			{
				state = state,
				decl = CompilerTypedTypeAliasDecl(
					compiler_typed_type_alias_from_parsed(
						state,
						alias_decl,
					),
				)
			}
		TraitParsedDecl(trait_decl):
			{
				state = state,
				decl = CompilerTypedTraitDecl(compiler_typed_trait_from_parsed(state, trait_decl))
			}
		ImplParsedDecl(impl_decl):
			result = compiler_typecheck_materialize_impl_body(
				state,
				decls,
				import_modules,
				impl_decl,
			)
			{
				state = result.state,
				decl = CompilerTypedImplDecl(result.typed)
			}
		PrivateParsedDecl(inner, _):
			result = compiler_typecheck_materialize_decl_body(
				state,
				module_path,
				decls,
				import_modules,
				inner,
			)
			{
				state = result.state,
				decl = CompilerTypedPrivateDecl(result.decl)
			}
		_:
			{
				state = state,
				decl = CompilerTypedParsedDecl(decl)
			}


pure func compiler_typecheck_check_program_bodies(
	state: CompilerTypecheckState,
	program: ParsedProgram,
) -> CompilerTypecheckState:
	compiler_typecheck_materialize_program_bodies(state, program).state


pure func compiler_typecheck_materialize_program_bodies(
	state: CompilerTypecheckState,
	program: ParsedProgram,
) -> CompilerTypecheckProgramResult:
	compiler_typecheck_materialize_program_bodies_with_import_modules(state, program, [])


private pure func compiler_typecheck_materialize_program_bodies_with_import_modules(
	state: CompilerTypecheckState,
	program: ParsedProgram,
	import_modules: List[CompilerImportableModule],
) -> CompilerTypecheckProgramResult:
	var next_state = state
	var typed_decls: List[CompilerTypedDecl] = []

	for decl in program.decls:
		next_state = compiler_typecheck_state_reset_type_shape_memo(next_state)

		match decl:
			ForeignBlockParsedDecl(block_args, functions, block_span):
				foreign_result: CompilerTypedForeignBlockResult = compiler_typed_foreign_block(
					next_state,
					block_args,
					functions,
					block_span,
				)
				next_state = foreign_result.state
				typed_decls = typed_decls.concat(foreign_result.decls)
			_:
				result = compiler_typecheck_materialize_decl_body(
					next_state,
					program.source.module_name,
					program.decls,
					import_modules,
					decl,
				)
				next_state = result.state
				typed_decls = typed_decls.append(result.decl)

	compiler_typecheck_validate_typed_program({
		state = compiler_typecheck_state_reset_type_shape_memo(next_state),
		program = compiler_typed_program_from_decls(program, typed_decls),
	})


private func compiler_typecheck_materialize_program_bodies_with_import_modules_with_trace(
	state: CompilerTypecheckState,
	program: ParsedProgram,
	import_modules: List[CompilerImportableModule],
	trace: (String) -> Void,
) -> CompilerTypecheckProgramResult:
	var next_state = state
	var typed_decls: List[CompilerTypedDecl] = []
	var decl_index: Int = 0

	for decl in program.decls:
		phase_prefix = "typecheck_body_decl_" + decl_index.to_string()
		trace(phase_prefix + "_start")
		next_state = compiler_typecheck_state_reset_type_shape_memo(next_state)

		match decl:
			ForeignBlockParsedDecl(block_args, functions, block_span):
				foreign_result: CompilerTypedForeignBlockResult = compiler_typed_foreign_block(
					next_state,
					block_args,
					functions,
					block_span,
				)
				next_state = foreign_result.state
				typed_decls = typed_decls.concat(foreign_result.decls)
			_:
				result = compiler_typecheck_materialize_decl_body(
					next_state,
					program.source.module_name,
					program.decls,
					import_modules,
					decl,
				)
				next_state = result.state
				typed_decls = typed_decls.append(result.decl)

		trace(phase_prefix + "_complete")
		decl_index += 1

	compiler_typecheck_validate_typed_program({
		state = compiler_typecheck_state_reset_type_shape_memo(next_state),
		program = compiler_typed_program_from_decls(program, typed_decls),
	})


private pure func compiler_typecheck_program_after_import_registration(
	state: CompilerTypecheckState,
	program: ParsedProgram,
	import_modules: List[CompilerImportableModule],
) -> CompilerTypecheckProgramResult:
	with_types = compiler_typecheck_register_program_type_decls(state, program)
	with_signatures = compiler_typecheck_register_program_signature_decls(with_types, program)
	with_impls = compiler_typecheck_register_program_impl_decls(with_signatures, program)

	compiler_typecheck_materialize_program_bodies_with_import_modules(
		with_impls,
		program,
		import_modules,
	)


pure func compiler_typecheck_program_with_import_surfaces(
	state: CompilerTypecheckState,
	program: ParsedProgram,
	import_surfaces: List[CompilerImportableModuleSurface],
) -> CompilerTypecheckProgramResult:
	with_names = compiler_typecheck_prescan_program(state, program)
	with_imports = compiler_register_program_imports(with_names, import_surfaces, program)

	compiler_typecheck_program_after_import_registration(with_imports, program, [])


private pure func compiler_reachable_importable_modules(
	program: ParsedProgram,
	import_modules: List[CompilerImportableModule],
	current_module_path: Option[String],
) -> List[CompilerImportableModule]:
	direct_import_modules = compiler_importable_modules_for_program(
		import_modules,
		program,
		current_module_path,
	)
	compiler_importable_module_dependency_closure(
		import_modules,
		direct_import_modules,
		current_module_path,
	)


private pure func compiler_with_ambient_impl_modules(
	modules: List[CompilerImportableModule],
	all_modules: List[CompilerImportableModule],
	current_module_path: Option[String],
) -> List[CompilerImportableModule]:
	var result = modules

	for module in all_modules:
		if (
			compiler_importable_module_path(module) == COMPILER_AMBIENT_TUPLE_IMPL_MODULE_PATH
			and not compiler_import_module_is_current(
				compiler_importable_module_path(module),
				current_module_path,
			)
			and not result.any(
				func(
					existing,
				): compiler_importable_module_path(
					existing,
				) == compiler_importable_module_path(module),
			)
		):
			result = result.append(module)

	result


pure func compiler_reachable_importable_modules_for_program(
	state: CompilerTypecheckState,
	program: ParsedProgram,
	import_modules: List[CompilerImportableModule],
	current_module_path: String,
) -> List[CompilerImportableModule]:
	program_with_prelude = compiler_program_with_prelude_imports(state, program, import_modules)
	compiler_with_ambient_impl_modules(
		compiler_reachable_importable_modules(
			program_with_prelude,
			import_modules,
			Some(current_module_path),
		),
		import_modules,
		Some(current_module_path),
	)


private pure func compiler_typecheck_program_with_import_modules_internal(
	state: CompilerTypecheckState,
	program: ParsedProgram,
	import_modules: List[CompilerImportableModule],
	current_module_path: Option[String],
) -> CompilerTypecheckProgramResult:
	program_with_prelude = compiler_program_with_prelude_imports(state, program, import_modules)
	type_import_modules = compiler_with_ambient_impl_modules(
		compiler_reachable_importable_modules(
			program_with_prelude,
			import_modules,
			current_module_path,
		),
		import_modules,
		current_module_path,
	)
	import_surfaces = compiler_importable_module_surfaces(type_import_modules)
	direct_import_modules = compiler_with_ambient_impl_modules(
		compiler_importable_modules_for_program(
			type_import_modules,
			program_with_prelude,
			current_module_path,
		),
		type_import_modules,
		current_module_path,
	)
	with_names = compiler_typecheck_prescan_program(state, program_with_prelude)
	with_imports = compiler_register_program_imports(
		with_names,
		import_surfaces,
		program_with_prelude,
	)
	with_import_decls = compiler_typecheck_register_import_modules(
		with_imports,
		type_import_modules,
		direct_import_modules,
		import_surfaces,
	)

	compiler_typecheck_program_after_import_registration(
		with_import_decls,
		program_with_prelude,
		import_modules,
	)


pure func compiler_typecheck_program_with_import_modules(
	state: CompilerTypecheckState,
	program: ParsedProgram,
	import_modules: List[CompilerImportableModule],
) -> CompilerTypecheckProgramResult:
	compiler_typecheck_program_with_import_modules_internal(state, program, import_modules, None)


pure func compiler_typecheck_program_with_import_modules_for_module(
	state: CompilerTypecheckState,
	program: ParsedProgram,
	import_modules: List[CompilerImportableModule],
	current_module_path: String,
) -> CompilerTypecheckProgramResult:
	compiler_typecheck_program_with_import_modules_internal(
		state,
		program,
		import_modules,
		Some(current_module_path),
	)


func compiler_typecheck_program_with_import_modules_for_module_with_trace(
	state: CompilerTypecheckState,
	program: ParsedProgram,
	import_modules: List[CompilerImportableModule],
	current_module_path: String,
	trace: (String) -> Void,
) -> CompilerTypecheckProgramResult:
	program_with_prelude = compiler_program_with_prelude_imports(state, program, import_modules)
	trace("typecheck_prelude_complete")
	type_import_modules = compiler_with_ambient_impl_modules(
		compiler_reachable_importable_modules(
			program_with_prelude,
			import_modules,
			Some(current_module_path),
		),
		import_modules,
		Some(current_module_path),
	)
	trace("typecheck_reachable_imports_complete")
	import_surfaces = compiler_importable_module_surfaces(type_import_modules)
	trace("typecheck_import_surfaces_complete")
	direct_import_modules = compiler_with_ambient_impl_modules(
		compiler_importable_modules_for_program(
			type_import_modules,
			program_with_prelude,
			Some(current_module_path),
		),
		type_import_modules,
		Some(current_module_path),
	)
	trace("typecheck_direct_imports_complete")
	with_names = compiler_typecheck_prescan_program(state, program_with_prelude)
	trace("typecheck_prescan_complete")
	with_imports = compiler_register_program_imports(
		with_names,
		import_surfaces,
		program_with_prelude,
	)
	trace("typecheck_import_syntax_complete")
	with_import_decls = compiler_typecheck_register_import_modules(
		with_imports,
		type_import_modules,
		direct_import_modules,
		import_surfaces,
	)
	trace("typecheck_import_decls_complete")
	with_types = compiler_typecheck_register_program_type_decls(
		with_import_decls,
		program_with_prelude,
	)
	trace("typecheck_local_types_complete")
	with_signatures = compiler_typecheck_register_program_signature_decls(
		with_types,
		program_with_prelude,
	)
	trace("typecheck_local_signatures_complete")
	with_impls = compiler_typecheck_register_program_impl_decls(
		with_signatures,
		program_with_prelude,
	)
	trace("typecheck_local_impls_complete")
	result = compiler_typecheck_materialize_program_bodies_with_import_modules_with_trace(
		with_impls,
		program_with_prelude,
		import_modules,
		trace,
	)
	trace("typecheck_bodies_complete")

	result


pure func compiler_typecheck_program(
	state: CompilerTypecheckState,
	program: ParsedProgram,
) -> CompilerTypecheckProgramResult:
	with_names = compiler_typecheck_prescan_program(state, program)
	with_imports = compiler_register_program_import_syntax(with_names, program)

	compiler_typecheck_program_after_import_registration(with_imports, program, [])
