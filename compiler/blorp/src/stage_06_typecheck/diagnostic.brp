-- Structured typecheck failures retained for tooling and later rendering.
--
-- The CLI still consumes the existing message list. Keeping the source span as
-- compiler data prevents tools from recovering locations from display text.
import:
	../stage_01_file_io/source: CompilerSourceSpan


record CompilerTypecheckDiagnostic {
	message: String,
	span: Option[CompilerSourceSpan]
}


pure func compiler_typecheck_diagnostic(
	message: String,
	span: Option[CompilerSourceSpan],
) -> CompilerTypecheckDiagnostic:
	{
		message = message,
		span = span
	}
