-- Typecheck compiler bridge dispatcher.
--
-- This bridge owns the first typed frontend artifact. It is intentionally
-- separate from the always-built parse bridge helper while the Blorp
-- typechecker continues to grow toward the production compile path.
import:
	../stage_01_file_io/compiler_source: CompilerSourceFile, compiler_source_file
	../stage_02_lex/compiler_lexer: compiler_lex
	../stage_02_lex/compiler_token: CompilerToken, CompilerTrivia, CompilerTriviaKind(CommentTrivia)
	../stage_03_parse/compiler_parsed_ast:
		ParsedDecl(ImportBlockParsedDecl, PrivateParsedDecl),
		ParsedImportDecl,
		ParsedProgram,
		ParsedProgramPhase(TypecheckSourceProgram),
		parsed_program_phase_name,
	../stage_03_parse/compiler_parser: parse_compiler_source
	../stage_03_parse/compiler_source_ast_finalize: finalize_typecheck_source_program
	../stage_04_modules/compiler_module_surface: module_surface_for_program
	../stage_04_modules/compiler_module_surface_json: module_surface_to_json
	../stage_05_types/compiler_context:
		CompilerModuleOrigin(
			CompilerNativePackageModule,
			CompilerSourcePackageModule,
			CompilerStdlibModule,
			CompilerUserModule,
		),
	../stage_07_ctfe/compiler_ctfe_context: CompilerCtfeImportedProgram
	../stage_07_ctfe/compiler_ctfe_eval: compiler_ctfe_eval_error_message
	../stage_07_ctfe/compiler_ctfe_globals: compiler_ctfe_evaluate_program_globals
	../stage_12_cli/compiler_bridge_protocol:
		BRIDGE_SCHEMA_VERSION,
		BridgeAction(TypecheckSourceAction, TypecheckSourcesAction),
		BridgeEnvelope,
		BridgeProtocolError(InvalidJson),
		bridge_action_name,
		bridge_error_json,
		bridge_success_json,
		decode_bridge_envelope_value,
	compiler_imports: CompilerImportableModule, compiler_importable_module
	compiler_typecheck_decl:
		CompilerTypecheckProgramResult,
		CompilerTypedDecl(CompilerTypedGlobalVarDecl, CompilerTypedPrivateDecl),
		CompilerTypedProgram,
		compiler_typecheck_program,
		compiler_typecheck_program_with_import_modules,
	compiler_typecheck_state:
		CompilerImportBinding,
		CompilerTypecheckState,
		compiler_typecheck_state_add_error,
		compiler_typecheck_state_for_origin,
		compiler_typecheck_state_with_debug_calls,
	compiler_typed_ast_json: compiler_typed_program_to_json
	json:
		JsonValue(JsonBool, JsonNull, JsonNumber, JsonObject, JsonString, JsonVector),
		as_array,
		as_bool,
		as_string,
		get_field,
		parse_json,


union TypecheckBridgeDispatchError:
	MissingStringField(String)
	ExpectedRequestField(String, String)
	UnsupportedBridgeAction(BridgeAction)


record TypecheckImportModule {
	path: String,
	module_name: String,
	module_path: String,
	text: String,
	origin: CompilerModuleOrigin
}


record TypecheckResolvedImport {
	from_path: String,
	from_module: String,
	import_path: String,
	resolved_module: String
}


union TypecheckCtfeStatus:
	TypecheckCtfeEvaluated
	TypecheckCtfeNotRun


record TypecheckCtfeArtifact {
	program: CompilerTypedProgram,
	state: CompilerTypecheckState,
	status: TypecheckCtfeStatus
}


private pure func owned_string(text: String) -> String:
	text.substring(0, text.length())


private pure func schema_json() -> JsonValue:
	JsonNumber(to_float(BRIDGE_SCHEMA_VERSION))


private pure func dispatch_error_code(error: TypecheckBridgeDispatchError) -> String:
	match error:
		MissingStringField(_):
			"invalid_request"
		ExpectedRequestField(_, _):
			"invalid_request"
		UnsupportedBridgeAction(_):
			"unsupported_action"


private pure func dispatch_error_message(error: TypecheckBridgeDispatchError) -> String:
	match error:
		MissingStringField(field_name):
			"missing string field `${field_name}`"
		ExpectedRequestField(field_name, expected):
			"field `${field_name}` must be ${expected}"
		UnsupportedBridgeAction(action):
			"unsupported Blorp typecheck bridge action: ${bridge_action_name(action)}"


private pure func dispatch_error_json(error: TypecheckBridgeDispatchError) -> JsonValue:
	JsonObject([("schema", schema_json()), ("ok", JsonBool(False)), ("error", JsonObject([
			("code", JsonString(dispatch_error_code(error))),
			("message", JsonString(dispatch_error_message(error))),
		]))])


private pure func request_body(envelope: BridgeEnvelope) -> JsonValue:
	envelope.payload


private pure func string_field(
	value: JsonValue,
	field_name: String,
) -> Result[String, TypecheckBridgeDispatchError]:
	field ?= get_field(value, field_name).to_result(MissingStringField(field_name))
	as_string(field)
		.map(owned_string)
		.to_result(ExpectedRequestField(field_name, "a string"))


private pure func optional_string_field(
	value: JsonValue,
	field_name: String,
) -> Result[Option[String], TypecheckBridgeDispatchError]:
	match get_field(value, field_name):
		Some(field):
			as_string(field)
				.map(func(text): Some(owned_string(text)))
				.to_result(ExpectedRequestField(field_name, "a string"))
		None:
			Ok(None)


private pure func optional_bool_field(value: JsonValue, field_name: String, default: Bool) -> Bool:
	match get_field(value, field_name):
		Some(field):
			as_bool(field).get_or(default)
		None:
			default


private pure func compiler_module_origin_from_json(
	value: JsonValue,
) -> Result[CompilerModuleOrigin, TypecheckBridgeDispatchError]:
	match value:
		JsonObject(_):
			kind ?= string_field(value, "kind")

			match kind:
				"user":
					Ok(CompilerUserModule)
				"std":
					Ok(CompilerStdlibModule)
				"source_package":
					package ?= string_field(value, "package")
					Ok(CompilerSourcePackageModule(package))
				"pkg":
					package ?= string_field(value, "package")
					Ok(CompilerNativePackageModule(package))
				"native_package":
					package ?= string_field(value, "package")
					Ok(CompilerNativePackageModule(package))
				_:
					Err(
						ExpectedRequestField(
							"origin.kind",
							"one of user, std, source_package, pkg",
						),
					)
		_:
			Err(ExpectedRequestField("origin", "an object"))


private pure func optional_origin_field(
	value: JsonValue,
) -> Result[CompilerModuleOrigin, TypecheckBridgeDispatchError]:
	match get_field(value, "origin"):
		Some(origin):
			compiler_module_origin_from_json(origin)
		None:
			Ok(CompilerUserModule)


private pure func import_module_from_json(
	value: JsonValue,
) -> Result[TypecheckImportModule, TypecheckBridgeDispatchError]:
	match value:
		JsonObject(_):
			path ?= string_field(value, "path")
			module_name ?= string_field(value, "module")
			maybe_module_path ?= optional_string_field(value, "module_path")
			text ?= string_field(value, "text")
			origin ?= optional_origin_field(value)

			Ok({
				path = path,
				module_name = module_name,
				module_path = maybe_module_path.get_or(module_name),
				text = text,
				origin = origin,
			})
		_:
			Err(ExpectedRequestField("import_modules item", "an object"))


private pure func import_modules_field(
	value: JsonValue,
) -> Result[List[TypecheckImportModule], TypecheckBridgeDispatchError]:
	match get_field(value, "import_modules"):
		None:
			Ok([])
		Some(field):
			items ?= as_array(field).to_result(ExpectedRequestField("import_modules", "an array"))
			var modules: List[TypecheckImportModule] = []
			var error: Option[TypecheckBridgeDispatchError] = None

			for item in items:
				match error:
					Some(_):
						break
					None:
						match import_module_from_json(item):
							Ok(module):
								modules = modules.append(module)
							Err(err):
								error = Some(err)

			match error:
				Some(err):
					Err(err)
				None:
					Ok(modules)


private pure func sources_field(
	value: JsonValue,
) -> Result[List[TypecheckImportModule], TypecheckBridgeDispatchError]:
	match get_field(value, "sources"):
		None:
			Err(ExpectedRequestField("sources", "an array"))
		Some(field):
			items ?= as_array(field).to_result(ExpectedRequestField("sources", "an array"))
			var modules: List[TypecheckImportModule] = []
			var error: Option[TypecheckBridgeDispatchError] = None

			for item in items:
				match error:
					Some(_):
						break
					None:
						match import_module_from_json(item):
							Ok(module):
								modules = modules.append(module)
							Err(err):
								error = Some(err)

			match error:
				Some(err):
					Err(err)
				None:
					Ok(modules)


private pure func resolved_import_from_json(
	value: JsonValue,
) -> Result[TypecheckResolvedImport, TypecheckBridgeDispatchError]:
	match value:
		JsonObject(_):
			from_path ?= string_field(value, "from_path")
			from_module ?= string_field(value, "from_module")
			import_path ?= string_field(value, "import_path")
			resolved_module ?= string_field(value, "resolved_module")

			Ok({
				from_path = from_path,
				from_module = from_module,
				import_path = import_path,
				resolved_module = resolved_module,
			})
		_:
			Err(ExpectedRequestField("resolved_imports item", "an object"))


private pure func resolved_imports_field(
	value: JsonValue,
) -> Result[List[TypecheckResolvedImport], TypecheckBridgeDispatchError]:
	match get_field(value, "resolved_imports"):
		None:
			Ok([])
		Some(field):
			items ?= as_array(field).to_result(ExpectedRequestField("resolved_imports", "an array"))
			var imports: List[TypecheckResolvedImport] = []
			var error: Option[TypecheckBridgeDispatchError] = None

			for item in items:
				match error:
					Some(_):
						break
					None:
						match resolved_import_from_json(item):
							Ok(resolved):
								imports = imports.append(resolved)
							Err(err):
								error = Some(err)

			match error:
				Some(err):
					Err(err)
				None:
					Ok(imports)


private pure func comment_json(trivia: CompilerTrivia, trailing: Bool) -> JsonValue:
	JsonObject([
		("text", JsonString(trivia.text)),
		("line", JsonNumber(to_float(trivia.span.start_line))),
		("column", JsonNumber(to_float(trivia.span.start_column))),
		("trailing", JsonBool(trailing)),
	])


private pure func append_comment_jsons(
	comments: List[JsonValue],
	trivia: List[CompilerTrivia],
	trailing: Bool,
) -> List[JsonValue]:
	var result: List[JsonValue] = comments

	for item in trivia:
		if item.kind == CommentTrivia:
			result = result.append(comment_json(item, trailing))

	result


private pure func token_comment_jsons(token: CompilerToken) -> List[JsonValue]:
	append_comment_jsons(
		append_comment_jsons([], token.leading_trivia, False),
		token.trailing_trivia,
		True,
	)


private pure func source_comment_jsons(source: CompilerSourceFile) -> JsonValue:
	lex_result = compiler_lex(source)
	var comments: List[JsonValue] = []

	for token in lex_result.tokens:
		for comment in token_comment_jsons(token):
			comments = comments.append(comment)

	JsonVector(comments)


private pure func optional_string_to_json(value: Option[String]) -> JsonValue:
	match value:
		Some(text):
			JsonString(text)
		None:
			JsonNull


private pure func import_binding_to_json(binding: CompilerImportBinding) -> JsonValue:
	JsonObject([
		("local_name", JsonString(binding.local_name)),
		("module_path", JsonString(binding.module_path)),
		("original_name", optional_string_to_json(binding.original_name)),
	])


private pure func owned_parsed_decl(decl: ParsedDecl) -> ParsedDecl:
	decl


private pure func parsed_program_with_owned_decls(program: ParsedProgram) -> ParsedProgram:
	{
		source = program.source,
		decls = program.decls.map(owned_parsed_decl),
		diagnostics = program.diagnostics
	}


private pure func resolved_module_for_import(
	from_path: String,
	from_module: String,
	resolved_imports: List[TypecheckResolvedImport],
	import_path: String,
) -> String:
	var result: String = import_path

	for resolved in resolved_imports:
		if (
			resolved.from_path == from_path
			and resolved.from_module == from_module
			and resolved.import_path == import_path
		):
			result = resolved.resolved_module
			break

	result


private pure func rewrite_import_decl_path(
	from_path: String,
	from_module: String,
	resolved_imports: List[TypecheckResolvedImport],
	import_decl: ParsedImportDecl,
) -> ParsedImportDecl:
	{ import_decl |
		module_path = resolved_module_for_import(
			from_path,
			from_module,
			resolved_imports,
			import_decl.module_path,
		)
	}


private pure func rewrite_import_decl_paths(
	from_path: String,
	from_module: String,
	resolved_imports: List[TypecheckResolvedImport],
	imports: List[ParsedImportDecl],
) -> List[ParsedImportDecl]:
	imports.map(
		func(
			import_decl,
		): rewrite_import_decl_path(from_path, from_module, resolved_imports, import_decl),
	)


private pure func rewrite_decl_import_paths(
	from_path: String,
	from_module: String,
	resolved_imports: List[TypecheckResolvedImport],
	decl: ParsedDecl,
) -> ParsedDecl:
	match decl:
		ImportBlockParsedDecl(imports, span):
			ImportBlockParsedDecl(
				rewrite_import_decl_paths(from_path, from_module, resolved_imports, imports),
				span,
			)
		PrivateParsedDecl(inner, span):
			PrivateParsedDecl(
				rewrite_decl_import_paths(from_path, from_module, resolved_imports, inner),
				span,
			)
		_:
			decl


private pure func rewrite_program_import_paths(
	from_path: String,
	from_module: String,
	resolved_imports: List[TypecheckResolvedImport],
	program: ParsedProgram,
) -> ParsedProgram:
	{ program |
		decls = program.decls.map(
			func(decl): rewrite_decl_import_paths(from_path, from_module, resolved_imports, decl),
		)
	}


private pure func import_program_from_request(
	module: TypecheckImportModule,
	resolved_imports: List[TypecheckResolvedImport],
) -> ParsedProgram:
	source = compiler_source_file(module.path, module.module_name, module.text)
	raw_program = parse_compiler_source(source)
	rewritten = rewrite_program_import_paths(
		module.path,
		module.module_name,
		resolved_imports,
		raw_program,
	)

	parsed_program_with_owned_decls(finalize_typecheck_source_program(rewritten))


private pure func importable_module_from_request(
	module: TypecheckImportModule,
	resolved_imports: List[TypecheckResolvedImport],
) -> CompilerImportableModule:
	final_program = import_program_from_request(module, resolved_imports)

	compiler_importable_module(
		module.module_path,
		module.origin,
		module_surface_for_program(final_program),
		final_program.decls,
	)


private pure func importable_modules_from_request(
	modules: List[TypecheckImportModule],
	resolved_imports: List[TypecheckResolvedImport],
) -> List[CompilerImportableModule]:
	modules.map(func(module): importable_module_from_request(module, resolved_imports))


private pure func typecheck_import_modules_except_path(
	modules: List[TypecheckImportModule],
	module_path: String,
) -> List[TypecheckImportModule]:
	modules.filter(func(module): module.module_path != module_path)


private pure func typecheck_import_modules_or_sources(
	request_import_modules: List[TypecheckImportModule],
	sources: List[TypecheckImportModule],
) -> List[TypecheckImportModule]:
	if request_import_modules.length() == 0:
		-- Do not alias the parsed sources list as the import list. The current
		-- generated ARC path can double-release that shared list when a batch
		-- request returns. Copying keeps the bridge conservative while the
		-- deeper list/value ownership hole is still open.
		sources.concat([])
	else:
		request_import_modules


private pure func typed_decl_has_ctfe_global(decl: CompilerTypedDecl) -> Bool:
	match decl:
		CompilerTypedGlobalVarDecl(info):
			not info.decl.is_mutable
		CompilerTypedPrivateDecl(inner):
			typed_decl_has_ctfe_global(inner)
		_:
			False


private pure func typed_program_has_ctfe_globals(program: CompilerTypedProgram) -> Bool:
	program.decls.any(typed_decl_has_ctfe_global)


private pure func importable_modules_except_path(
	modules: List[CompilerImportableModule],
	module_path: String,
) -> List[CompilerImportableModule]:
	modules.filter(func(module): module.module_path != module_path)


private pure func explicit_import_paths_from_imports(
	imports: List[ParsedImportDecl],
) -> List[String]:
	imports.map(func(import_decl): import_decl.module_path)


private pure func explicit_import_paths_from_decl(decl: ParsedDecl) -> List[String]:
	match decl:
		ImportBlockParsedDecl(imports, _):
			explicit_import_paths_from_imports(imports)
		PrivateParsedDecl(inner, _):
			explicit_import_paths_from_decl(inner)
		_:
			[]


private pure func explicit_import_paths_from_program(program: ParsedProgram) -> List[String]:
	program.decls.flat_map(explicit_import_paths_from_decl)


private pure func ctfe_imported_program_from_request(
	module: TypecheckImportModule,
	importable_modules: List[CompilerImportableModule],
	resolved_imports: List[TypecheckResolvedImport],
	allow_debug_only_calls: Bool,
) -> Option[CompilerCtfeImportedProgram]:
	program = import_program_from_request(module, resolved_imports)
	state = compiler_typecheck_state_with_debug_calls(
		compiler_typecheck_state_for_origin(module.origin),
		allow_debug_only_calls,
	)
	typed_result = compiler_typecheck_program_with_import_modules(
		state,
		program,
		importable_modules_except_path(importable_modules, module.module_path),
	)

	if typed_result.state.errors.length() == 0:
		Some({
			module_path = module.module_path,
			program = typed_result.program,
		})
	else:
		None


private pure func ctfe_imported_programs_from_request(
	modules: List[TypecheckImportModule],
	importable_modules: List[CompilerImportableModule],
	resolved_imports: List[TypecheckResolvedImport],
	allow_debug_only_calls: Bool,
) -> Option[List[CompilerCtfeImportedProgram]]:
	var result: List[CompilerCtfeImportedProgram] = []
	var failed: Bool = False

	for module in modules:
		match ctfe_imported_program_from_request(
			module,
			importable_modules,
			resolved_imports,
			allow_debug_only_calls,
		):
			Some(imported_program):
				result = result.append(imported_program)
			None:
				failed = True
				break

	if failed:
		None
	else:
		Some(result)


private pure func import_module_has_explicit_imports(
	module: TypecheckImportModule,
	resolved_imports: List[TypecheckResolvedImport],
) -> Bool:
	program = import_program_from_request(module, resolved_imports)
	explicit_import_paths_from_program(program).length() != 0


private pure func import_module_is_explicit_leaf_for_ctfe(
	module: TypecheckImportModule,
	explicit_import_paths: List[String],
	resolved_imports: List[TypecheckResolvedImport],
) -> Bool:
	match module.origin:
		CompilerUserModule:
			(
				explicit_import_paths.contains(module.module_path)
				and not import_module_has_explicit_imports(module, resolved_imports)
			)
		_:
			False


private pure func explicit_import_modules_for_ctfe(
	modules: List[TypecheckImportModule],
	explicit_import_paths: List[String],
	resolved_imports: List[TypecheckResolvedImport],
) -> List[TypecheckImportModule]:
	var result: List[TypecheckImportModule] = []

	for module in modules:
		if import_module_is_explicit_leaf_for_ctfe(module, explicit_import_paths, resolved_imports):
			result = result.append(module)

	result


private pure func ctfe_imported_programs_for_artifact(
	typed_result: CompilerTypecheckProgramResult,
	modules: List[TypecheckImportModule],
	importable_modules: List[CompilerImportableModule],
	resolved_imports: List[TypecheckResolvedImport],
	explicit_import_paths: List[String],
	allow_debug_only_calls: Bool,
) -> Option[List[CompilerCtfeImportedProgram]]:
	if typed_program_has_ctfe_globals(typed_result.program):
		if explicit_import_paths.length() == 0:
			Some([])
		else:
			ctfe_modules = explicit_import_modules_for_ctfe(
				modules,
				explicit_import_paths,
				resolved_imports,
			)
			ctfe_imported_programs_from_request(
				ctfe_modules,
				importable_modules,
				resolved_imports,
				allow_debug_only_calls,
			)
	else:
		Some([])


private pure func typecheck_ctfe_status_name(status: TypecheckCtfeStatus) -> String:
	match status:
		TypecheckCtfeEvaluated:
			"evaluated"
		TypecheckCtfeNotRun:
			"not_run"


private pure func typecheck_ctfe_artifact(
	typed_result: CompilerTypecheckProgramResult,
	imported_programs: Option[List[CompilerCtfeImportedProgram]],
) -> TypecheckCtfeArtifact:
	if typed_result.state.errors.length() != 0:
		{
			program = typed_result.program,
			state = typed_result.state,
			status = TypecheckCtfeNotRun
		}
	else:
		match imported_programs:
			Some(programs):
				match compiler_ctfe_evaluate_program_globals(
					typed_result.program,
					programs,
					typed_result.state.import_bindings,
				):
					Ok(program):
						{
							program = program,
							state = typed_result.state,
							status = TypecheckCtfeEvaluated
						}
					Err(error):
						{
							program = typed_result.program,
							status = TypecheckCtfeNotRun,
							state = compiler_typecheck_state_add_error(
								typed_result.state,
								compiler_ctfe_eval_error_message(error),
							)
						}
			None:
				{
					program = typed_result.program,
					state = compiler_typecheck_state_add_error(
						typed_result.state,
						"compile-time evaluation could not resolve all imported modules",
					),
					status = TypecheckCtfeNotRun
				}


private pure func typed_source_artifact(
	path: String,
	module_name: String,
	text: String,
	include_comments: Bool,
	allow_debug_only_calls: Bool,
	origin: CompilerModuleOrigin,
	import_modules: List[TypecheckImportModule],
	resolved_imports: List[TypecheckResolvedImport],
) -> JsonValue:
	source = compiler_source_file(path, module_name, text)
	raw_program = parse_compiler_source(source)
	rewritten = rewrite_program_import_paths(path, module_name, resolved_imports, raw_program)
	final_program = finalize_typecheck_source_program(rewritten)
	explicit_import_paths = explicit_import_paths_from_program(final_program)
	initial_state = compiler_typecheck_state_with_debug_calls(
		compiler_typecheck_state_for_origin(origin),
		allow_debug_only_calls,
	)
	importable_modules = importable_modules_from_request(import_modules, resolved_imports)

	typed_result = if importable_modules.length() == 0:
		compiler_typecheck_program(initial_state, final_program)
	else:
		compiler_typecheck_program_with_import_modules(
			initial_state,
			final_program,
			importable_modules,
		)

	imported_programs = ctfe_imported_programs_for_artifact(
		typed_result,
		import_modules,
		importable_modules,
		resolved_imports,
		explicit_import_paths,
		allow_debug_only_calls,
	)
	ctfe_artifact = typecheck_ctfe_artifact(typed_result, imported_programs)

	var fields: List[(String, JsonValue)] = [
		("path", JsonString(path)),
		("module", JsonString(module_name)),
		("ast_phase", JsonString(parsed_program_phase_name(TypecheckSourceProgram))),
		("typed_program", compiler_typed_program_to_json(ctfe_artifact.program)),
		("ctfe_status", JsonString(typecheck_ctfe_status_name(ctfe_artifact.status))),
		("type_errors", JsonVector(ctfe_artifact.state.errors.map(
				pure func(item: String): JsonString(item),
			))),
		(
			"import_bindings",
			JsonVector(ctfe_artifact.state.import_bindings.map(import_binding_to_json)),
		),
		("module_surface", module_surface_to_json(module_surface_for_program(final_program))),
	]

	if include_comments:
		fields = fields.append(("comments", source_comment_jsons(source)))

	JsonObject(fields)


private pure func handle_typecheck_source(
	body: JsonValue,
) -> Result[JsonValue, TypecheckBridgeDispatchError]:
	path ?= string_field(body, "path")
	module_name ?= string_field(body, "module")
	text ?= string_field(body, "text")
	import_modules ?= import_modules_field(body)
	resolved_imports ?= resolved_imports_field(body)
	include_comments = optional_bool_field(body, "include_comments", True)
	allow_debug_only_calls = optional_bool_field(body, "allow_debug_only_calls", False)
	origin ?= optional_origin_field(body)

	Ok(
		bridge_success_json(
			typed_source_artifact(
				path,
				module_name,
				text,
				include_comments,
				allow_debug_only_calls,
				origin,
				import_modules,
				resolved_imports,
			),
		),
	)


private pure func handle_typecheck_sources(
	body: JsonValue,
) -> Result[JsonValue, TypecheckBridgeDispatchError]:
	sources ?= sources_field(body)
	request_import_modules ?= import_modules_field(body)
	resolved_imports ?= resolved_imports_field(body)
	include_comments = optional_bool_field(body, "include_comments", False)
	allow_debug_only_calls = optional_bool_field(body, "allow_debug_only_calls", False)

	import_modules = typecheck_import_modules_or_sources(request_import_modules, sources)

	-- Keep the batch boundary at the bridge process/JSON layer, but rebuild
	-- importable modules per source. Sharing CompilerImportableModule values
	-- across several typecheck calls in one helper process currently crashes
	-- on the real compiler graph, which points to an ownership/representation
	-- hole below this bridge rather than a safe value to reuse here.
	artifacts = sources.map(func(module): typed_source_artifact(
			module.path,
			module.module_name,
			module.text,
			include_comments,
			allow_debug_only_calls,
			module.origin,
			typecheck_import_modules_except_path(import_modules, module.module_path),
			resolved_imports,
		))

	Ok(bridge_success_json(JsonObject([("sources", JsonVector(artifacts))])))


private pure func handle_envelope(
	envelope: BridgeEnvelope,
) -> Result[JsonValue, TypecheckBridgeDispatchError]:
	body: JsonValue = request_body(envelope)

	match envelope.action:
		TypecheckSourceAction:
			handle_typecheck_source(body)
		TypecheckSourcesAction:
			handle_typecheck_sources(body)
		_:
			Err(UnsupportedBridgeAction(envelope.action))


pure func handle_request_value(root: JsonValue) -> JsonValue:
	match decode_bridge_envelope_value(root):
		Ok(envelope):
			handle_envelope(envelope).get_or_else(dispatch_error_json)
		Err(error):
			bridge_error_json(error)


pure func handle_request(source: String) -> String:
	parse_json(source)
		.map(func(root): handle_request_value(root).to_string())
		.get_or_else(func(message): bridge_error_json(InvalidJson(message)).to_string())
