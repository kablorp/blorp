-- Low-overhead structural counts for diagnosing retained typecheck programs.
--
-- These counts deliberately describe logical AST size rather than allocator
-- bytes. They are only called by the opt-in typecheck inventory path.
import:
	compiler_infer:
		CompilerTypedExpr(
			CompilerTypedAscriptionExpr,
			CompilerTypedAssignExpr,
			CompilerTypedBinaryExpr,
			CompilerTypedBlockExpr,
			CompilerTypedBoolLiteralExpr,
			CompilerTypedBreakExpr,
			CompilerTypedBuiltinExpr,
			CompilerTypedCallExpr,
			CompilerTypedCharLiteralExpr,
			CompilerTypedConcurrentBlockExpr,
			CompilerTypedConcurrentForExpr,
			CompilerTypedContinueExpr,
			CompilerTypedDebugBlockExpr,
			CompilerTypedDetachExpr,
			CompilerTypedDictExpr,
			CompilerTypedFieldAccessExpr,
			CompilerTypedFloatLiteralExpr,
			CompilerTypedForExpr,
			CompilerTypedIfExpr,
			CompilerTypedIntLiteralExpr,
			CompilerTypedLambdaExpr,
			CompilerTypedListExpr,
			CompilerTypedLogicalExpr,
			CompilerTypedMatchExpr,
			CompilerTypedMissingExpr,
			CompilerTypedNameExpr,
			CompilerTypedOpaqueFromExpr,
			CompilerTypedOpaqueIntoExpr,
			CompilerTypedQuestionBindExpr,
			CompilerTypedRangeExpr,
			CompilerTypedRecordExpr,
			CompilerTypedRecordUpdateExpr,
			CompilerTypedSelectExpr,
			CompilerTypedStringInterpolationExpr,
			CompilerTypedStringInterpolationPartsExpr,
			CompilerTypedStringLiteralExpr,
			CompilerTypedSubscriptAssignExpr,
			CompilerTypedSubscriptExpr,
			CompilerTypedTupleDestructExpr,
			CompilerTypedTupleExpr,
			CompilerTypedUnaryExpr,
			CompilerTypedUnsupportedExpr,
			CompilerTypedVarDeclExpr,
			CompilerTypedVectorExpr,
			CompilerTypedVoidExpr,
			CompilerTypedWhileExpr,
			CompilerTypedWithExpr,
		),
		CompilerTypedSelectArmKind(
			CompilerTypedSelectAfterArm,
			CompilerTypedSelectReceiveArm,
			CompilerTypedSelectSealedArm,
		),
		CompilerTypedStringInterpolationPart(
			CompilerTypedInterpolationExpr,
			CompilerTypedInterpolationLiteral,
		),
	compiler_typecheck_decl:
		CompilerTypedDecl(
			CompilerTypedForeignFunctionDecl,
			CompilerTypedFunctionDecl,
			CompilerTypedGlobalVarDecl,
			CompilerTypedImplDecl,
			CompilerTypedParsedDecl,
			CompilerTypedPrivateDecl,
			CompilerTypedRecordDecl,
			CompilerTypedTraitDecl,
			CompilerTypedTypeAliasDecl,
			CompilerTypedUnionDecl,
		),
		CompilerTypedProgram,


record CompilerTypedProgramInventory {
	source_bytes: Int,
	typed_decls: Int,
	typed_expr_nodes: Int
}


private pure func optional_typed_expr_node_count(expr: Option[CompilerTypedExpr]) -> Int:
	match expr:
		Some(value):
			compiler_typed_expr_node_count(value)
		None:
			0


private pure func typed_expr_list_node_count(items: List[CompilerTypedExpr]) -> Int:
	var result: Int = 0

	for item in items:
		result += compiler_typed_expr_node_count(item)

	result


pure func compiler_typed_expr_node_count(expr: CompilerTypedExpr) -> Int:
	match expr:
		CompilerTypedNameExpr(_, _):
			1
		CompilerTypedIntLiteralExpr(_, _, _):
			1
		CompilerTypedFloatLiteralExpr(_, _, _):
			1
		CompilerTypedStringLiteralExpr(_, _, _):
			1
		CompilerTypedStringInterpolationExpr(_, _, _, _):
			1
		CompilerTypedStringInterpolationPartsExpr(parts, _, _, _):
			var result: Int = 1

			for part in parts:
				match part:
					CompilerTypedInterpolationExpr(value):
						result += compiler_typed_expr_node_count(value)
					CompilerTypedInterpolationLiteral(_):
						void

			result
		CompilerTypedBoolLiteralExpr(_, _, _):
			1
		CompilerTypedCharLiteralExpr(_, _, _):
			1
		CompilerTypedUnaryExpr(_, inner, _, _):
			1 + compiler_typed_expr_node_count(inner)
		CompilerTypedBinaryExpr(_, left, right, _, _):
			1 + compiler_typed_expr_node_count(left) + compiler_typed_expr_node_count(right)
		CompilerTypedLogicalExpr(_, left, right, _, _):
			1 + compiler_typed_expr_node_count(left) + compiler_typed_expr_node_count(right)
		CompilerTypedCallExpr(callee, args, _, _):
			1 + compiler_typed_expr_node_count(callee) + typed_expr_list_node_count(args)
		CompilerTypedTupleExpr(items, _, _):
			1 + typed_expr_list_node_count(items)
		CompilerTypedTupleDestructExpr(_, value, _, _):
			1 + compiler_typed_expr_node_count(value)
		CompilerTypedAssignExpr(_, _, value, _, _):
			1 + compiler_typed_expr_node_count(value)
		CompilerTypedSubscriptExpr(receiver, indices, _, _):
			1 + compiler_typed_expr_node_count(receiver) + typed_expr_list_node_count(indices)
		CompilerTypedSubscriptAssignExpr(_, receiver, indices, value, _, _):
			1 + compiler_typed_expr_node_count(
				receiver,
			) + typed_expr_list_node_count(indices) + compiler_typed_expr_node_count(value)
		CompilerTypedListExpr(items, _, _):
			1 + typed_expr_list_node_count(items)
		CompilerTypedVectorExpr(items, _, _):
			1 + typed_expr_list_node_count(items)
		CompilerTypedDictExpr(entries, _, _):
			var result: Int = 1

			for entry in entries:
				result += compiler_typed_expr_node_count(
					entry.key,
				) + compiler_typed_expr_node_count(entry.value)

			result
		CompilerTypedOpaqueIntoExpr(_, inner, _, _):
			1 + compiler_typed_expr_node_count(inner)
		CompilerTypedOpaqueFromExpr(_, inner, _, _):
			1 + compiler_typed_expr_node_count(inner)
		CompilerTypedRecordExpr(fields, _, _):
			var result: Int = 1

			for field in fields:
				result += compiler_typed_expr_node_count(field.value)

			result
		CompilerTypedRecordUpdateExpr(receiver, fields, _, _):
			var result: Int = 1 + compiler_typed_expr_node_count(receiver)

			for field in fields:
				result += compiler_typed_expr_node_count(field.value)

			result
		CompilerTypedFieldAccessExpr(receiver, _, _, _):
			1 + compiler_typed_expr_node_count(receiver)
		CompilerTypedLambdaExpr(_, _, _, body, _, _):
			1 + compiler_typed_expr_node_count(body)
		CompilerTypedRangeExpr(start_expr, end_expr, _, _):
			1 + compiler_typed_expr_node_count(
				start_expr,
			) + compiler_typed_expr_node_count(end_expr)
		CompilerTypedIfExpr(condition, then_branch, else_branch, _, _):
			1 + compiler_typed_expr_node_count(
				condition,
			) + compiler_typed_expr_node_count(
				then_branch,
			) + optional_typed_expr_node_count(else_branch)
		CompilerTypedMatchExpr(scrutinee, cases, _, _):
			var result: Int = 1 + compiler_typed_expr_node_count(scrutinee)

			for case in cases:
				result += compiler_typed_expr_node_count(case.body)

			result
		CompilerTypedSelectExpr(arms, _, _):
			var result: Int = 1

			for arm in arms:
				match arm.kind:
					CompilerTypedSelectReceiveArm(_, _, channel):
						result += compiler_typed_expr_node_count(channel)
					CompilerTypedSelectSealedArm(_, channel):
						result += compiler_typed_expr_node_count(channel)
					CompilerTypedSelectAfterArm(timeout):
						result += compiler_typed_expr_node_count(timeout)

				result += compiler_typed_expr_node_count(arm.body)

			result
		CompilerTypedWhileExpr(condition, body, _, _):
			1 + compiler_typed_expr_node_count(condition) + compiler_typed_expr_node_count(body)
		CompilerTypedForExpr(_, iterable, _, body, _, _):
			1 + compiler_typed_expr_node_count(iterable) + compiler_typed_expr_node_count(body)
		CompilerTypedConcurrentBlockExpr(params, bindings, _, _):
			var result: Int = 1

			for param in params:
				result += compiler_typed_expr_node_count(param.value)

			for binding in bindings:
				result += compiler_typed_expr_node_count(binding.value)

			result
		CompilerTypedConcurrentForExpr(_, iterable, params, body, _, _):
			var result: Int = 1 + compiler_typed_expr_node_count(iterable)

			for param in params:
				result += compiler_typed_expr_node_count(param.value)

			result + compiler_typed_expr_node_count(body)
		CompilerTypedDetachExpr(body, _, _):
			1 + compiler_typed_expr_node_count(body)
		CompilerTypedAscriptionExpr(inner, _, _, _):
			1 + compiler_typed_expr_node_count(inner)
		CompilerTypedBlockExpr(items, _, _):
			1 + typed_expr_list_node_count(items)
		CompilerTypedWithExpr(binding, body, _, _):
			var result: Int = 1 + compiler_typed_expr_node_count(binding.value)

			match binding.error_map:
				Some(error_map):
					result += compiler_typed_expr_node_count(error_map.value)
				None:
					void

			result + compiler_typed_expr_node_count(body)
		CompilerTypedDebugBlockExpr(body, _, _):
			1 + compiler_typed_expr_node_count(body)
		CompilerTypedVarDeclExpr(payload, _):
			1 + compiler_typed_expr_node_count(payload.initializer)
		CompilerTypedQuestionBindExpr(_, _, value, _, _):
			1 + compiler_typed_expr_node_count(value)
		CompilerTypedBreakExpr(_, _):
			1
		CompilerTypedContinueExpr(_, _):
			1
		CompilerTypedVoidExpr(_, _):
			1
		CompilerTypedBuiltinExpr(_, _, _):
			1
		CompilerTypedMissingExpr(_, _):
			1
		CompilerTypedUnsupportedExpr(_, _, _):
			1


private pure func compiler_typed_decl_expr_node_count(decl: CompilerTypedDecl) -> Int:
	match decl:
		CompilerTypedFunctionDecl(info):
			optional_typed_expr_node_count(info.body)
		CompilerTypedForeignFunctionDecl(_):
			0
		CompilerTypedGlobalVarDecl(info):
			compiler_typed_expr_node_count(info.value)
		CompilerTypedRecordDecl(_):
			0
		CompilerTypedTypeAliasDecl(_):
			0
		CompilerTypedTraitDecl(_):
			0
		CompilerTypedUnionDecl(_):
			0
		CompilerTypedImplDecl(info):
			var result: Int = 0

			for method in info.methods:
				result += optional_typed_expr_node_count(method.body)

			result
		CompilerTypedPrivateDecl(inner):
			compiler_typed_decl_expr_node_count(inner)
		CompilerTypedParsedDecl(_):
			0


pure func compiler_typed_program_inventory(
	program: CompilerTypedProgram,
) -> CompilerTypedProgramInventory:
	var typed_expr_nodes: Int = 0

	for decl in program.decls:
		typed_expr_nodes += compiler_typed_decl_expr_node_count(decl)

	{
		source_bytes = program.source.text.length(),
		typed_decls = program.decls.length(),
		typed_expr_nodes = typed_expr_nodes
	}
