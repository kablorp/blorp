-- Stable, category-safe declaration identities and source provenance.
--
-- Skeletons reserve declaration identity before any header resolves a type.
-- Runtime definition-bearing categories retain their graph-reserved integer
-- ID; categories without runtime IDs use an opaque structural identity rather
-- than an invented sentinel integer.
import:
	../../stage_01_file_io/source: CompilerSourceSpan, compiler_source_spans_equal
	../../stage_03_parse/parsed_ast:
		ParsedBuiltinTypeDecl,
		ParsedDecl(
			BuiltinTypeParsedDecl,
			ForeignBlockParsedDecl,
			FunctionParsedDecl,
			ImplParsedDecl,
			ImportBlockParsedDecl,
			ParsedErrorDecl,
			PrivateParsedDecl,
			RecordParsedDecl,
			TraitParsedDecl,
			TypeAliasParsedDecl,
			UnionParsedDecl,
			VarParsedDecl,
		),
		ParsedForeignFunctionDecl,
		ParsedFunctionDecl,
		ParsedImplDecl,
		ParsedRecordDecl,
		ParsedTraitDecl,
		ParsedTraitMethodDecl,
		ParsedTypeAliasDecl,
		ParsedUnionDecl,
		ParsedVarDecl,
		ParsedVariantDecl,
	../../stage_04_modules/loaded_module:
		CompilerModuleIdentity,
		compiler_module_identities_equal,
		compiler_module_identity_display_name,
	../graph/definition_identity:
		CompilerSourceDefinitionKind(
			CompilerConstructorDefinition,
			CompilerImplDefinition,
			CompilerTraitDefinition,
		),
		compiler_func_callable_key,
		compiler_func_callable_key_name,
		compiler_source_definition_key,
	../graph/definition_index:
		CompilerDefinitionIndex,
		compiler_definition_index_find_func_callable_id,
		compiler_definition_index_find_source_definition_id,
		compiler_definition_index_func_callables_at_span,
	../graph/indexed_graph: compiler_indexed_graph_definition_index
	../modules/bound_module_graph:
		CompilerBoundModule,
		CompilerBoundModuleGraph,
		compiler_bound_module_graph_indexed_graph,
		compiler_bound_module_graph_modules,
		compiler_bound_module_graph_target,
		compiler_bound_module_identity,
		compiler_bound_module_program,


enum CompilerDeclarationVisibility:
	CompilerPublicDeclaration
	CompilerPrivateDeclaration


enum CompilerDeclarationSkeletonKind:
	CompilerTypeSkeletonKind
	CompilerConstructorSkeletonKind
	CompilerCallableSkeletonKind
	CompilerTraitSkeletonKind
	CompilerTraitMethodSkeletonKind
	CompilerGlobalSkeletonKind
	CompilerImplementationSkeletonKind


private record CompilerStructuralDeclarationIdRep {
	module_identity: CompilerModuleIdentity,
	name: String,
	owner: Option[String],
	span: CompilerSourceSpan
}


private record CompilerRuntimeDeclarationIdRep {
	structural: CompilerStructuralDeclarationIdRep,
	definition_id: Int
}


opaque type CompilerTypeId = CompilerStructuralDeclarationIdRep

opaque type CompilerGlobalId = CompilerStructuralDeclarationIdRep

opaque type CompilerTraitMethodId = CompilerStructuralDeclarationIdRep

opaque type CompilerConstructorId = CompilerRuntimeDeclarationIdRep

opaque type CompilerCallableId = CompilerRuntimeDeclarationIdRep

opaque type CompilerTraitId = CompilerRuntimeDeclarationIdRep

opaque type CompilerImplId = CompilerRuntimeDeclarationIdRep


union CompilerDeclarationId:
	CompilerTypeDeclarationId(CompilerTypeId)
	CompilerConstructorDeclarationId(CompilerConstructorId)
	CompilerCallableDeclarationId(CompilerCallableId)
	CompilerTraitDeclarationId(CompilerTraitId)
	CompilerTraitMethodDeclarationId(CompilerTraitMethodId)
	CompilerGlobalDeclarationId(CompilerGlobalId)
	CompilerImplementationDeclarationId(CompilerImplId)


union CompilerTypeDeclarationSource:
	CompilerRecordTypeSource(ParsedRecordDecl)
	CompilerUnionTypeSource(ParsedUnionDecl)
	CompilerBuiltinTypeSource(ParsedBuiltinTypeDecl)
	CompilerAliasTypeSource(ParsedTypeAliasDecl)


union CompilerCallableDeclarationSource:
	CompilerFunctionCallableSource(ParsedFunctionDecl)
	CompilerForeignCallableSource(ParsedForeignFunctionDecl)
	CompilerImplementationMethodCallableSource(String, ParsedFunctionDecl)
	CompilerDefaultImplementationMethodCallableSource(String, String, ParsedImplDecl)


union CompilerDeclarationSource:
	CompilerTypeDeclarationSourceValue(CompilerTypeDeclarationSource)
	CompilerConstructorDeclarationSourceValue(CompilerTypeId, ParsedVariantDecl)
	CompilerCallableDeclarationSourceValue(CompilerCallableDeclarationSource)
	CompilerTraitDeclarationSourceValue(ParsedTraitDecl)
	CompilerTraitMethodDeclarationSourceValue(String, ParsedTraitMethodDecl)
	CompilerGlobalDeclarationSourceValue(ParsedVarDecl)
	CompilerImplementationDeclarationSourceValue(ParsedImplDecl)


union CompilerDeclarationSkeleton:
	CompilerTypeDeclarationSkeleton(CompilerTypeId, CompilerDeclarationVisibility, CompilerTypeDeclarationSource)
	CompilerConstructorDeclarationSkeleton(CompilerConstructorId, CompilerDeclarationVisibility, CompilerTypeId, ParsedVariantDecl)
	CompilerCallableDeclarationSkeleton(CompilerCallableId, CompilerDeclarationVisibility, CompilerCallableDeclarationSource)
	CompilerTraitDeclarationSkeleton(CompilerTraitId, CompilerDeclarationVisibility, ParsedTraitDecl)
	CompilerTraitMethodDeclarationSkeleton(CompilerTraitMethodId, CompilerDeclarationVisibility, String, ParsedTraitMethodDecl)
	CompilerGlobalDeclarationSkeleton(CompilerGlobalId, CompilerDeclarationVisibility, ParsedVarDecl)
	CompilerImplementationDeclarationSkeleton(CompilerImplId, CompilerDeclarationVisibility, ParsedImplDecl)


record CompilerTypeDeclarationSkeletonInfo {
	id: CompilerTypeId,
	visibility: CompilerDeclarationVisibility,
	source: CompilerTypeDeclarationSource
}


record CompilerConstructorDeclarationSkeletonInfo {
	id: CompilerConstructorId,
	visibility: CompilerDeclarationVisibility,
	parent_type_id: CompilerTypeId,
	source: ParsedVariantDecl
}


record CompilerTraitDeclarationSkeletonInfo {
	id: CompilerTraitId,
	visibility: CompilerDeclarationVisibility,
	source: ParsedTraitDecl
}


union CompilerDeclarationSkeletonGraphError:
	CompilerCallableSkeletonMissingDefinition(CompilerModuleIdentity, String, CompilerSourceSpan)
	CompilerConstructorSkeletonMissingDefinition(CompilerModuleIdentity, String, String, CompilerSourceSpan)
	CompilerTraitSkeletonMissingDefinition(CompilerModuleIdentity, String, CompilerSourceSpan)
	CompilerImplementationSkeletonMissingDefinition(CompilerModuleIdentity, String, CompilerSourceSpan)
	CompilerDuplicateTypeDeclaration(CompilerModuleIdentity, String, CompilerSourceSpan)
	CompilerDuplicateTraitDeclaration(CompilerModuleIdentity, String, CompilerSourceSpan)
	CompilerDuplicateConstructorDeclaration(CompilerTypeId, String, CompilerSourceSpan)
	CompilerDuplicateDeclarationSkeleton(CompilerDeclarationId)


-- Exact declaration identity includes source location. Namespace identity does
-- not: it describes the semantic slots whose occupants must be unique before
-- name-indexed header resolution can begin. Callable overloads deliberately do
-- not have a key here.
private union CompilerDeclarationNamespaceKey:
	CompilerTypeNamespaceKey(CompilerModuleIdentity, String)
	CompilerTraitNamespaceKey(CompilerModuleIdentity, String)
	CompilerConstructorNamespaceKey(CompilerTypeId, String)


private record CompilerDeclarationSkeletonGraphRep {
	bound_graph: CompilerBoundModuleGraph,
	skeletons: List[CompilerDeclarationSkeleton],
	skeletons_by_name: Dict[String, List[CompilerDeclarationSkeleton]]
}


opaque type CompilerDeclarationSkeletonGraph = CompilerDeclarationSkeletonGraphRep


private record CompilerDeclarationSkeletonBuildState {
	skeletons: List[CompilerDeclarationSkeleton],
	skeletons_by_name: Dict[String, List[CompilerDeclarationSkeleton]],
	errors: List[CompilerDeclarationSkeletonGraphError]
}


private record CompilerDeclarationSkeletonBuildContext {
	module_identity: CompilerModuleIdentity,
	definition_index: CompilerDefinitionIndex
}


private pure func structural_declaration_id(
	module_identity: CompilerModuleIdentity,
	name: String,
	owner: Option[String],
	span: CompilerSourceSpan,
) -> CompilerStructuralDeclarationIdRep:
	{
		module_identity = module_identity,
		name = name,
		owner = owner,
		span = span
	}


private pure func runtime_declaration_id(
	structural: CompilerStructuralDeclarationIdRep,
	definition_id: Int,
) -> CompilerRuntimeDeclarationIdRep:
	{
		structural = structural,
		definition_id = definition_id
	}


private pure func structural_declaration_ids_equal(
	left: CompilerStructuralDeclarationIdRep,
	right: CompilerStructuralDeclarationIdRep,
) -> Bool:
	(
		compiler_module_identities_equal(left.module_identity, right.module_identity)
		and left.name == right.name
		and left.owner == right.owner
		and compiler_source_spans_equal(left.span, right.span)
	)


private pure func runtime_declaration_ids_equal(
	left: CompilerRuntimeDeclarationIdRep,
	right: CompilerRuntimeDeclarationIdRep,
) -> Bool:
	(
		left.definition_id == right.definition_id
		and structural_declaration_ids_equal(left.structural, right.structural)
	)


pure func compiler_declaration_ids_equal(
	left: CompilerDeclarationId,
	right: CompilerDeclarationId,
) -> Bool:
	match (left, right):
		(CompilerTypeDeclarationId(left_id), CompilerTypeDeclarationId(right_id)):
			structural_declaration_ids_equal(
				from CompilerTypeId(left_id),
				from CompilerTypeId(right_id),
			)
		(CompilerGlobalDeclarationId(left_id), CompilerGlobalDeclarationId(right_id)):
			structural_declaration_ids_equal(
				from CompilerGlobalId(left_id),
				from CompilerGlobalId(right_id),
			)
		(CompilerTraitMethodDeclarationId(left_id), CompilerTraitMethodDeclarationId(right_id)):
			structural_declaration_ids_equal(
				from CompilerTraitMethodId(left_id),
				from CompilerTraitMethodId(right_id),
			)
		(CompilerConstructorDeclarationId(left_id), CompilerConstructorDeclarationId(right_id)):
			runtime_declaration_ids_equal(
				from CompilerConstructorId(left_id),
				from CompilerConstructorId(right_id),
			)
		(CompilerCallableDeclarationId(left_id), CompilerCallableDeclarationId(right_id)):
			runtime_declaration_ids_equal(
				from CompilerCallableId(left_id),
				from CompilerCallableId(right_id),
			)
		(CompilerTraitDeclarationId(left_id), CompilerTraitDeclarationId(right_id)):
			runtime_declaration_ids_equal(
				from CompilerTraitId(left_id),
				from CompilerTraitId(right_id),
			)
		(CompilerImplementationDeclarationId(left_id), CompilerImplementationDeclarationId(right_id)):
			runtime_declaration_ids_equal(
				from CompilerImplId(left_id),
				from CompilerImplId(right_id),
			)
		_:
			False


pure func compiler_type_ids_equal(left: CompilerTypeId, right: CompilerTypeId) -> Bool:
	structural_declaration_ids_equal(from CompilerTypeId(left), from CompilerTypeId(right))


pure func compiler_type_id_name(id: CompilerTypeId) -> String:
	from CompilerTypeId(id).name


pure func compiler_type_id_module_identity(id: CompilerTypeId) -> CompilerModuleIdentity:
	from CompilerTypeId(id).module_identity


pure func compiler_constructor_id_definition_id(id: CompilerConstructorId) -> Int:
	from CompilerConstructorId(id).definition_id


pure func compiler_trait_ids_equal(left: CompilerTraitId, right: CompilerTraitId) -> Bool:
	runtime_declaration_ids_equal(from CompilerTraitId(left), from CompilerTraitId(right))


pure func compiler_trait_id_name(id: CompilerTraitId) -> String:
	from CompilerTraitId(id).structural.name


pure func compiler_trait_id_module_identity(id: CompilerTraitId) -> CompilerModuleIdentity:
	from CompilerTraitId(id).structural.module_identity


private pure func declaration_id_structural(
	id: CompilerDeclarationId,
) -> CompilerStructuralDeclarationIdRep:
	match id:
		CompilerTypeDeclarationId(type_id):
			from CompilerTypeId(type_id)
		CompilerConstructorDeclarationId(constructor_id):
			from CompilerConstructorId(constructor_id).structural
		CompilerCallableDeclarationId(callable_id):
			from CompilerCallableId(callable_id).structural
		CompilerTraitDeclarationId(trait_id):
			from CompilerTraitId(trait_id).structural
		CompilerTraitMethodDeclarationId(method_id):
			from CompilerTraitMethodId(method_id)
		CompilerGlobalDeclarationId(global_id):
			from CompilerGlobalId(global_id)
		CompilerImplementationDeclarationId(impl_id):
			from CompilerImplId(impl_id).structural


private pure func skeleton_structural_id(
	skeleton: CompilerDeclarationSkeleton,
) -> CompilerStructuralDeclarationIdRep:
	declaration_id_structural(compiler_declaration_skeleton_id(skeleton))


pure func compiler_declaration_skeleton_id(
	skeleton: CompilerDeclarationSkeleton,
) -> CompilerDeclarationId:
	match skeleton:
		CompilerTypeDeclarationSkeleton(id, _, _):
			CompilerTypeDeclarationId(id)
		CompilerConstructorDeclarationSkeleton(id, _, _, _):
			CompilerConstructorDeclarationId(id)
		CompilerCallableDeclarationSkeleton(id, _, _):
			CompilerCallableDeclarationId(id)
		CompilerTraitDeclarationSkeleton(id, _, _):
			CompilerTraitDeclarationId(id)
		CompilerTraitMethodDeclarationSkeleton(id, _, _, _):
			CompilerTraitMethodDeclarationId(id)
		CompilerGlobalDeclarationSkeleton(id, _, _):
			CompilerGlobalDeclarationId(id)
		CompilerImplementationDeclarationSkeleton(id, _, _):
			CompilerImplementationDeclarationId(id)


pure func compiler_declaration_skeleton_kind(
	skeleton: CompilerDeclarationSkeleton,
) -> CompilerDeclarationSkeletonKind:
	match skeleton:
		CompilerTypeDeclarationSkeleton(_, _, _):
			CompilerTypeSkeletonKind
		CompilerConstructorDeclarationSkeleton(_, _, _, _):
			CompilerConstructorSkeletonKind
		CompilerCallableDeclarationSkeleton(_, _, _):
			CompilerCallableSkeletonKind
		CompilerTraitDeclarationSkeleton(_, _, _):
			CompilerTraitSkeletonKind
		CompilerTraitMethodDeclarationSkeleton(_, _, _, _):
			CompilerTraitMethodSkeletonKind
		CompilerGlobalDeclarationSkeleton(_, _, _):
			CompilerGlobalSkeletonKind
		CompilerImplementationDeclarationSkeleton(_, _, _):
			CompilerImplementationSkeletonKind


pure func compiler_declaration_skeleton_name(skeleton: CompilerDeclarationSkeleton) -> String:
	skeleton_structural_id(skeleton).name


pure func compiler_declaration_skeleton_visibility(
	skeleton: CompilerDeclarationSkeleton,
) -> CompilerDeclarationVisibility:
	match skeleton:
		CompilerTypeDeclarationSkeleton(_, visibility, _):
			visibility
		CompilerConstructorDeclarationSkeleton(_, visibility, _, _):
			visibility
		CompilerCallableDeclarationSkeleton(_, visibility, _):
			visibility
		CompilerTraitDeclarationSkeleton(_, visibility, _):
			visibility
		CompilerTraitMethodDeclarationSkeleton(_, visibility, _, _):
			visibility
		CompilerGlobalDeclarationSkeleton(_, visibility, _):
			visibility
		CompilerImplementationDeclarationSkeleton(_, visibility, _):
			visibility


pure func compiler_declaration_skeleton_source(
	skeleton: CompilerDeclarationSkeleton,
) -> CompilerDeclarationSource:
	match skeleton:
		CompilerTypeDeclarationSkeleton(_, _, source):
			CompilerTypeDeclarationSourceValue(source)
		CompilerConstructorDeclarationSkeleton(_, _, parent_type_id, source):
			CompilerConstructorDeclarationSourceValue(parent_type_id, source)
		CompilerCallableDeclarationSkeleton(_, _, source):
			CompilerCallableDeclarationSourceValue(source)
		CompilerTraitDeclarationSkeleton(_, _, source):
			CompilerTraitDeclarationSourceValue(source)
		CompilerTraitMethodDeclarationSkeleton(_, _, trait_name, source):
			CompilerTraitMethodDeclarationSourceValue(trait_name, source)
		CompilerGlobalDeclarationSkeleton(_, _, source):
			CompilerGlobalDeclarationSourceValue(source)
		CompilerImplementationDeclarationSkeleton(_, _, source):
			CompilerImplementationDeclarationSourceValue(source)


private pure func declaration_namespace_key(
	skeleton: CompilerDeclarationSkeleton,
) -> Option[CompilerDeclarationNamespaceKey]:
	match skeleton:
		CompilerTypeDeclarationSkeleton(id, _, _):
			Some(
				CompilerTypeNamespaceKey(
					compiler_type_id_module_identity(id),
					compiler_type_id_name(id),
				),
			)
		CompilerTraitDeclarationSkeleton(id, _, _):
			Some(
				CompilerTraitNamespaceKey(
					compiler_trait_id_module_identity(id),
					compiler_trait_id_name(id),
				),
			)
		CompilerConstructorDeclarationSkeleton(_, _, parent_type_id, source):
			Some(CompilerConstructorNamespaceKey(parent_type_id, source.name.text))
		_:
			None


private pure func declaration_namespace_keys_equal(
	left: CompilerDeclarationNamespaceKey,
	right: CompilerDeclarationNamespaceKey,
) -> Bool:
	match (left, right):
		(CompilerTypeNamespaceKey(left_module, left_name), CompilerTypeNamespaceKey(right_module, right_name)):
			left_name == right_name and compiler_module_identities_equal(left_module, right_module)
		(CompilerTraitNamespaceKey(left_module, left_name), CompilerTraitNamespaceKey(right_module, right_name)):
			left_name == right_name and compiler_module_identities_equal(left_module, right_module)
		(CompilerConstructorNamespaceKey(left_parent, left_name), CompilerConstructorNamespaceKey(right_parent, right_name)):
			left_name == right_name and compiler_type_ids_equal(left_parent, right_parent)
		_:
			False


private pure func duplicate_namespace_error(
	skeleton: CompilerDeclarationSkeleton,
) -> CompilerDeclarationSkeletonGraphError:
	structural = skeleton_structural_id(skeleton)

	match skeleton:
		CompilerTypeDeclarationSkeleton(_, _, _):
			CompilerDuplicateTypeDeclaration(
				structural.module_identity,
				structural.name,
				structural.span,
			)
		CompilerTraitDeclarationSkeleton(_, _, _):
			CompilerDuplicateTraitDeclaration(
				structural.module_identity,
				structural.name,
				structural.span,
			)
		CompilerConstructorDeclarationSkeleton(_, _, parent_type_id, _):
			CompilerDuplicateConstructorDeclaration(
				parent_type_id,
				structural.name,
				structural.span,
			)
		_:
			CompilerDuplicateDeclarationSkeleton(compiler_declaration_skeleton_id(skeleton))


private pure func append_skeleton(
	state: CompilerDeclarationSkeletonBuildState,
	skeleton: CompilerDeclarationSkeleton,
) -> CompilerDeclarationSkeletonBuildState:
	id = compiler_declaration_skeleton_id(skeleton)
	name = declaration_id_structural(id).name
	name_bucket = state.skeletons_by_name.get_or(name, [])
	exact_duplicate = name_bucket.any(
		func(
			existing,
		): compiler_declaration_ids_equal(compiler_declaration_skeleton_id(existing), id),
	)
	namespace_key = declaration_namespace_key(skeleton)

	namespace_duplicate = match namespace_key:
		None:
			False
		Some(key):
			name_bucket.any(func(existing):
				match declaration_namespace_key(existing):
					Some(existing_key):
						declaration_namespace_keys_equal(existing_key, key)
					None:
						False
			)

	if namespace_duplicate:
		{ state | errors = state.errors.append(duplicate_namespace_error(skeleton)) }
	else if exact_duplicate:
		{ state | errors = state.errors.append(CompilerDuplicateDeclarationSkeleton(id)) }
	else:
		{ state |
			skeletons = state.skeletons.append(skeleton),
			skeletons_by_name = state.skeletons_by_name.set(
				name,
				name_bucket.append(skeleton),
			)
		}


private pure func append_missing_callable_error(
	state: CompilerDeclarationSkeletonBuildState,
	context: CompilerDeclarationSkeletonBuildContext,
	name: String,
	span: CompilerSourceSpan,
) -> CompilerDeclarationSkeletonBuildState:
	{ state |
		errors = state.errors.append(
			CompilerCallableSkeletonMissingDefinition(
				context.module_identity,
				name,
				span,
			),
		)
	}


private pure func append_function_skeleton(
	state: CompilerDeclarationSkeletonBuildState,
	context: CompilerDeclarationSkeletonBuildContext,
	visibility: CompilerDeclarationVisibility,
	owner: Option[String],
	function_decl: ParsedFunctionDecl,
	source: CompilerCallableDeclarationSource,
) -> CompilerDeclarationSkeletonBuildState:
	key = compiler_func_callable_key(
		context.module_identity,
		function_decl.name.text,
		function_decl.span,
	)

	match compiler_definition_index_find_func_callable_id(context.definition_index, key):
		None:
			append_missing_callable_error(
				state,
				context,
				function_decl.name.text,
				function_decl.span,
			)
		Some(definition_id):
			structural = structural_declaration_id(
				context.module_identity,
				function_decl.name.text,
				owner,
				function_decl.span,
			)
			id = into CompilerCallableId(runtime_declaration_id(structural, definition_id))
			append_skeleton(
				state,
				CompilerCallableDeclarationSkeleton(id, visibility, source),
			)


private pure func append_foreign_function_skeleton(
	state: CompilerDeclarationSkeletonBuildState,
	context: CompilerDeclarationSkeletonBuildContext,
	visibility: CompilerDeclarationVisibility,
	function_decl: ParsedForeignFunctionDecl,
) -> CompilerDeclarationSkeletonBuildState:
	key = compiler_func_callable_key(
		context.module_identity,
		function_decl.name.text,
		function_decl.span,
	)

	match compiler_definition_index_find_func_callable_id(context.definition_index, key):
		None:
			append_missing_callable_error(
				state,
				context,
				function_decl.name.text,
				function_decl.span,
			)
		Some(definition_id):
			structural = structural_declaration_id(
				context.module_identity,
				function_decl.name.text,
				None,
				function_decl.span,
			)
			id = into CompilerCallableId(runtime_declaration_id(structural, definition_id))
			append_skeleton(
				state,
				CompilerCallableDeclarationSkeleton(
					id,
					visibility,
					CompilerForeignCallableSource(function_decl),
				),
			)


private pure func append_union_skeletons(
	state: CompilerDeclarationSkeletonBuildState,
	context: CompilerDeclarationSkeletonBuildContext,
	visibility: CompilerDeclarationVisibility,
	union_decl: ParsedUnionDecl,
) -> CompilerDeclarationSkeletonBuildState:
	type_structural = structural_declaration_id(
		context.module_identity,
		union_decl.name.text,
		None,
		union_decl.span,
	)
	type_id = into CompilerTypeId(type_structural)
	var next = append_skeleton(
		state,
		CompilerTypeDeclarationSkeleton(type_id, visibility, CompilerUnionTypeSource(union_decl)),
	)

	for variant in union_decl.variants:
		key = compiler_source_definition_key(
			context.module_identity,
			CompilerConstructorDefinition,
			variant.name.text,
			Some(union_decl.name.text),
			variant.span,
		)

		match compiler_definition_index_find_source_definition_id(context.definition_index, key):
			None:
				next = { next |
					errors = next.errors.append(
						CompilerConstructorSkeletonMissingDefinition(
							context.module_identity,
							union_decl.name.text,
							variant.name.text,
							variant.span,
						),
					)
				}
			Some(definition_id):
				structural = structural_declaration_id(
					context.module_identity,
					variant.name.text,
					Some(union_decl.name.text),
					variant.span,
				)
				id = into CompilerConstructorId(runtime_declaration_id(structural, definition_id))
				next = append_skeleton(
					next,
					CompilerConstructorDeclarationSkeleton(id, visibility, type_id, variant),
				)

	next


private pure func append_trait_skeletons(
	state: CompilerDeclarationSkeletonBuildState,
	context: CompilerDeclarationSkeletonBuildContext,
	visibility: CompilerDeclarationVisibility,
	trait_decl: ParsedTraitDecl,
) -> CompilerDeclarationSkeletonBuildState:
	key = compiler_source_definition_key(
		context.module_identity,
		CompilerTraitDefinition,
		trait_decl.name.text,
		None,
		trait_decl.span,
	)

	match compiler_definition_index_find_source_definition_id(context.definition_index, key):
		None:
			{ state |
				errors = state.errors.append(
					CompilerTraitSkeletonMissingDefinition(
						context.module_identity,
						trait_decl.name.text,
						trait_decl.span,
					),
				)
			}
		Some(definition_id):
			structural = structural_declaration_id(
				context.module_identity,
				trait_decl.name.text,
				None,
				trait_decl.span,
			)
			trait_id = into CompilerTraitId(runtime_declaration_id(structural, definition_id))
			var next = append_skeleton(
				state,
				CompilerTraitDeclarationSkeleton(trait_id, visibility, trait_decl),
			)

			for method in trait_decl.methods:
				method_structural = structural_declaration_id(
					context.module_identity,
					method.name.text,
					Some(trait_decl.name.text),
					method.span,
				)
				method_id = into CompilerTraitMethodId(method_structural)
				next = append_skeleton(
					next,
					CompilerTraitMethodDeclarationSkeleton(
						method_id,
						visibility,
						trait_decl.name.text,
						method,
					),
				)

			next


private pure func append_impl_skeletons(
	state: CompilerDeclarationSkeletonBuildState,
	context: CompilerDeclarationSkeletonBuildContext,
	visibility: CompilerDeclarationVisibility,
	impl_decl: ParsedImplDecl,
) -> CompilerDeclarationSkeletonBuildState:
	key = compiler_source_definition_key(
		context.module_identity,
		CompilerImplDefinition,
		impl_decl.trait_name.text,
		None,
		impl_decl.span,
	)

	match compiler_definition_index_find_source_definition_id(context.definition_index, key):
		None:
			{ state |
				errors = state.errors.append(
					CompilerImplementationSkeletonMissingDefinition(
						context.module_identity,
						impl_decl.trait_name.text,
						impl_decl.span,
					),
				)
			}
		Some(definition_id):
			structural = structural_declaration_id(
				context.module_identity,
				impl_decl.trait_name.text,
				None,
				impl_decl.span,
			)
			impl_id = into CompilerImplId(runtime_declaration_id(structural, definition_id))
			var next = append_skeleton(
				state,
				CompilerImplementationDeclarationSkeleton(impl_id, visibility, impl_decl),
			)

			for default_binding in compiler_definition_index_func_callables_at_span(
				context.definition_index,
				context.module_identity,
				impl_decl.span,
			):
				(default_key, default_definition_id) = default_binding
				method_name = compiler_func_callable_key_name(default_key)
				default_structural = structural_declaration_id(
					context.module_identity,
					method_name,
					Some(impl_decl.trait_name.text),
					impl_decl.span,
				)
				default_runtime_id = runtime_declaration_id(
					default_structural,
					default_definition_id,
				)
				default_id = into CompilerCallableId(default_runtime_id)
				next = append_skeleton(
					next,
					CompilerCallableDeclarationSkeleton(
						default_id,
						visibility,
						CompilerDefaultImplementationMethodCallableSource(
							impl_decl.trait_name.text,
							method_name,
							impl_decl,
						),
					),
				)

			for method in impl_decl.methods:
				next = append_function_skeleton(
					next,
					context,
					visibility,
					Some(impl_decl.trait_name.text),
					method,
					CompilerImplementationMethodCallableSource(impl_decl.trait_name.text, method),
				)

			next


private pure func append_type_skeleton(
	state: CompilerDeclarationSkeletonBuildState,
	context: CompilerDeclarationSkeletonBuildContext,
	visibility: CompilerDeclarationVisibility,
	name: String,
	span: CompilerSourceSpan,
	source: CompilerTypeDeclarationSource,
) -> CompilerDeclarationSkeletonBuildState:
	structural = structural_declaration_id(context.module_identity, name, None, span)
	id = into CompilerTypeId(structural)
	append_skeleton(
		state,
		CompilerTypeDeclarationSkeleton(id, visibility, source),
	)


private pure func append_decl_skeletons(
	state: CompilerDeclarationSkeletonBuildState,
	context: CompilerDeclarationSkeletonBuildContext,
	visibility: CompilerDeclarationVisibility,
	decl: ParsedDecl,
) -> CompilerDeclarationSkeletonBuildState:
	match decl:
		RecordParsedDecl(record_decl):
			append_type_skeleton(
				state,
				context,
				visibility,
				record_decl.name.text,
				record_decl.span,
				CompilerRecordTypeSource(record_decl),
			)
		UnionParsedDecl(union_decl):
			append_union_skeletons(state, context, visibility, union_decl)
		BuiltinTypeParsedDecl(type_decl):
			append_type_skeleton(
				state,
				context,
				visibility,
				type_decl.name.text,
				type_decl.span,
				CompilerBuiltinTypeSource(type_decl),
			)
		TypeAliasParsedDecl(alias_decl):
			append_type_skeleton(
				state,
				context,
				visibility,
				alias_decl.name.text,
				alias_decl.span,
				CompilerAliasTypeSource(alias_decl),
			)
		FunctionParsedDecl(function_decl):
			append_function_skeleton(
				state,
				context,
				visibility,
				None,
				function_decl,
				CompilerFunctionCallableSource(function_decl),
			)
		ForeignBlockParsedDecl(_, functions, _):
			var next = state

			for function_decl in functions:
				function_visibility = if (
					visibility == CompilerPrivateDeclaration
					or function_decl.is_private
				):
					CompilerPrivateDeclaration
				else:
					CompilerPublicDeclaration

				next = append_foreign_function_skeleton(
					next,
					context,
					function_visibility,
					function_decl,
				)

			next
		VarParsedDecl(var_decl):
			structural = structural_declaration_id(
				context.module_identity,
				var_decl.name.text,
				None,
				var_decl.span,
			)
			id = into CompilerGlobalId(structural)
			append_skeleton(
				state,
				CompilerGlobalDeclarationSkeleton(id, visibility, var_decl),
			)
		TraitParsedDecl(trait_decl):
			append_trait_skeletons(state, context, visibility, trait_decl)
		ImplParsedDecl(impl_decl):
			append_impl_skeletons(state, context, visibility, impl_decl)
		PrivateParsedDecl(inner, _):
			append_decl_skeletons(state, context, CompilerPrivateDeclaration, inner)
		ImportBlockParsedDecl(_, _):
			state
		ParsedErrorDecl(_):
			state


private pure func append_module_skeletons(
	state: CompilerDeclarationSkeletonBuildState,
	definition_index: CompilerDefinitionIndex,
	module: CompilerBoundModule,
) -> CompilerDeclarationSkeletonBuildState:
	context: CompilerDeclarationSkeletonBuildContext = {
		module_identity = compiler_bound_module_identity(module),
		definition_index = definition_index
	}
	var next = state

	for decl in compiler_bound_module_program(module).decls:
		next = append_decl_skeletons(next, context, CompilerPublicDeclaration, decl)

	next


pure func compiler_declaration_skeleton_graph_build(
	bound_graph: CompilerBoundModuleGraph,
) -> Result[CompilerDeclarationSkeletonGraph, List[CompilerDeclarationSkeletonGraphError]]:
	definition_index = compiler_indexed_graph_definition_index(
		compiler_bound_module_graph_indexed_graph(bound_graph),
	)
	var state: CompilerDeclarationSkeletonBuildState = {
		skeletons = [],
		skeletons_by_name = {},
		errors = []
	}
	state = append_module_skeletons(
		state,
		definition_index,
		compiler_bound_module_graph_target(bound_graph),
	)

	for module in compiler_bound_module_graph_modules(bound_graph):
		state = append_module_skeletons(state, definition_index, module)

	if state.errors.length() > 0:
		Err(state.errors)
	else:
		representation: CompilerDeclarationSkeletonGraphRep = {
			bound_graph = bound_graph,
			skeletons = state.skeletons,
			skeletons_by_name = state.skeletons_by_name
		}
		Ok(into CompilerDeclarationSkeletonGraph(representation))


private pure func declaration_skeleton_graph_rep(
	graph: CompilerDeclarationSkeletonGraph,
) -> CompilerDeclarationSkeletonGraphRep:
	from CompilerDeclarationSkeletonGraph(graph)


pure func compiler_declaration_skeleton_graph_bound_graph(
	graph: CompilerDeclarationSkeletonGraph,
) -> CompilerBoundModuleGraph:
	declaration_skeleton_graph_rep(graph).bound_graph


pure func compiler_declaration_skeleton_graph_skeletons(
	graph: CompilerDeclarationSkeletonGraph,
) -> List[CompilerDeclarationSkeleton]:
	declaration_skeleton_graph_rep(graph).skeletons


pure func compiler_declaration_skeleton_graph_type_skeletons(
	graph: CompilerDeclarationSkeletonGraph,
) -> List[CompilerTypeDeclarationSkeletonInfo]:
	var type_skeletons: List[CompilerTypeDeclarationSkeletonInfo] = []

	for skeleton in declaration_skeleton_graph_rep(graph).skeletons:
		match skeleton:
			CompilerTypeDeclarationSkeleton(id, visibility, source):
				type_skeletons = type_skeletons.append({
					id = id,
					visibility = visibility,
					source = source,
				})
			_:
				void

	type_skeletons


pure func compiler_declaration_skeleton_graph_constructor_skeletons(
	graph: CompilerDeclarationSkeletonGraph,
) -> List[CompilerConstructorDeclarationSkeletonInfo]:
	var constructor_skeletons: List[CompilerConstructorDeclarationSkeletonInfo] = []

	for skeleton in declaration_skeleton_graph_rep(graph).skeletons:
		match skeleton:
			CompilerConstructorDeclarationSkeleton(id, visibility, parent_type_id, source):
				constructor_skeletons = constructor_skeletons.append({
					id = id,
					visibility = visibility,
					parent_type_id = parent_type_id,
					source = source,
				})
			_:
				void

	constructor_skeletons


pure func compiler_declaration_skeleton_graph_trait_skeletons(
	graph: CompilerDeclarationSkeletonGraph,
) -> List[CompilerTraitDeclarationSkeletonInfo]:
	var trait_skeletons: List[CompilerTraitDeclarationSkeletonInfo] = []

	for skeleton in declaration_skeleton_graph_rep(graph).skeletons:
		match skeleton:
			CompilerTraitDeclarationSkeleton(id, visibility, source):
				trait_skeletons = trait_skeletons.append({
					id = id,
					visibility = visibility,
					source = source,
				})
			_:
				void

	trait_skeletons


pure func compiler_declaration_skeleton_graph_find_type(
	graph: CompilerDeclarationSkeletonGraph,
	module_identity: CompilerModuleIdentity,
	name: String,
) -> Option[CompilerTypeDeclarationSkeletonInfo]:
	var result: Option[CompilerTypeDeclarationSkeletonInfo] = None

	for skeleton in declaration_skeleton_graph_rep(graph).skeletons_by_name.get_or(name, []):
		match skeleton:
			CompilerTypeDeclarationSkeleton(id, visibility, source):
				if compiler_module_identities_equal(
					compiler_type_id_module_identity(id),
					module_identity,
				):
					result = Some({
						id = id,
						visibility = visibility,
						source = source,
					})
					break
			_:
				void

	result


pure func compiler_declaration_skeleton_graph_find_trait(
	graph: CompilerDeclarationSkeletonGraph,
	module_identity: CompilerModuleIdentity,
	name: String,
) -> Option[CompilerTraitDeclarationSkeletonInfo]:
	var result: Option[CompilerTraitDeclarationSkeletonInfo] = None

	for skeleton in declaration_skeleton_graph_rep(graph).skeletons_by_name.get_or(name, []):
		match skeleton:
			CompilerTraitDeclarationSkeleton(id, visibility, source):
				if compiler_module_identities_equal(
					compiler_trait_id_module_identity(id),
					module_identity,
				):
					result = Some({
						id = id,
						visibility = visibility,
						source = source,
					})
					break
			_:
				void

	result


pure func compiler_declaration_skeleton_graph_find(
	graph: CompilerDeclarationSkeletonGraph,
	id: CompilerDeclarationId,
) -> Option[CompilerDeclarationSkeleton]:
	var result: Option[CompilerDeclarationSkeleton] = None
	name = declaration_id_structural(id).name

	for skeleton in declaration_skeleton_graph_rep(graph).skeletons_by_name.get_or(name, []):
		if compiler_declaration_ids_equal(compiler_declaration_skeleton_id(skeleton), id):
			result = Some(skeleton)
			break

	result


pure func compiler_declaration_skeleton_graph_error_message(
	error: CompilerDeclarationSkeletonGraphError,
) -> String:
	match error:
		CompilerCallableSkeletonMissingDefinition(module_identity, name, _):
			"declaration skeleton is missing callable definition '" + name + "' in module '" + compiler_module_identity_display_name(
				module_identity,
			) + "'"
		CompilerConstructorSkeletonMissingDefinition(module_identity, owner, name, _):
			"declaration skeleton is missing constructor definition '" + owner + "." + name + "' in module '" + compiler_module_identity_display_name(
				module_identity,
			) + "'"
		CompilerTraitSkeletonMissingDefinition(module_identity, name, _):
			"declaration skeleton is missing trait definition '" + name + "' in module '" + compiler_module_identity_display_name(
				module_identity,
			) + "'"
		CompilerImplementationSkeletonMissingDefinition(module_identity, name, _):
			"declaration skeleton is missing implementation definition for '" + name + "' in module '" + compiler_module_identity_display_name(
				module_identity,
			) + "'"
		CompilerDuplicateTypeDeclaration(module_identity, name, _):
			"duplicate type declaration '" + name + "' in module '" + compiler_module_identity_display_name(
				module_identity,
			) + "'"
		CompilerDuplicateTraitDeclaration(module_identity, name, _):
			"duplicate trait declaration '" + name + "' in module '" + compiler_module_identity_display_name(
				module_identity,
			) + "'"
		CompilerDuplicateConstructorDeclaration(parent_type_id, name, _):
			"duplicate constructor '" + name + "' in union '" + compiler_type_id_name(
				parent_type_id,
			) + "' in module '" + compiler_module_identity_display_name(
				compiler_type_id_module_identity(parent_type_id),
			) + "'"
		CompilerDuplicateDeclarationSkeleton(_):
			"duplicate declaration skeleton identity"
