-- Installation boundary from immutable type headers to the transitional Env.
--
-- Definition-owned builtin and record facts come only from category-specific
-- accepted headers. The installation target carries importer-local naming
-- separately, so parsed declarations are not replayed at this boundary.
import:
	../../stage_04_modules/loaded_module: CompilerModuleIdentity, compiler_module_identities_equal
	../../stage_05_types/context: register_resource_cleanup
	../../stage_05_types/env:
		Env,
		FieldDecl,
		TypeKind(TypeBuiltin, TypeEnum, TypeResource, TypeScalarBuiltin, TypeUnion),
		VariantDef,
		env_add_alias,
		env_add_opaque_alias,
		env_add_record,
		env_add_type,
		env_add_type_with_constructor_ids,
	../../stage_05_types/language_surface_manifest: compiler_prelude_type_name
	../../stage_05_types/semantic_type:
		SemanticDimOp(SemanticDimAdd, SemanticDimDivide, SemanticDimMultiply, SemanticDimSubtract),
		SemanticType(
			SemanticArrayType,
			SemanticConstIntType,
			SemanticDimOpType,
			SemanticFunctionType,
			SemanticNamedType,
			SemanticRangeType,
			SemanticSelfType,
			SemanticTupleType,
			SemanticTypeVar,
			SemanticVarDimsType,
		),
		canonical_module_type_name,
	../typecheck_state:
		CompilerTypecheckState,
		compiler_typecheck_state_add_error,
		compiler_typecheck_state_add_known_resource_type_name,
		compiler_typecheck_state_add_known_type_name,
		compiler_typecheck_state_allows_builtin,
		compiler_typecheck_state_record_type_home,
	declaration_skeleton:
		CompilerTypeId,
		compiler_constructor_id_definition_id,
		compiler_type_id_module_identity,
		compiler_type_id_name,
	type_header_graph:
		CompilerAcceptedAliasHeader,
		CompilerAcceptedBuiltinHeader,
		CompilerAcceptedRecordHeader,
		CompilerAcceptedUnionHeader,
		CompilerAliasLayout(CompilerOpaqueAlias, CompilerTransparentAlias),
		CompilerBuiltinTypeLayout(
			CompilerManagedBuiltin,
			CompilerNoValueBuiltin,
			CompilerResourceBuiltin,
			CompilerScalarBuiltin,
			CompilerUnclassifiedBuiltin,
		),
		CompilerDeclaredTypeExpansion(
			CompilerNominalDeclaredType,
			CompilerTransparentAliasExpansion,
		),
		CompilerIntrinsicType(CompilerIntrinsicTaskResult),
		CompilerRecordLayout(CompilerHeapRecord, CompilerValueStruct),
		CompilerResolvedDimOp(
			CompilerResolvedDimAdd,
