	type_resolution: add_imported_type_aliases


private union CompilerBuiltinHeaderInstallation:
	CompilerLocalBuiltinInstallation(String)
	CompilerImportedBuiltinInstallation(String)


private union CompilerTypeHeaderInstallation:
	CompilerLocalTypeHeaderInstallation(CompilerModuleIdentity, String)
	CompilerImportedTypeHeaderInstallation(CompilerModuleIdentity, String)


-- These installation values own managed compiler data and therefore cannot be
-- value structs; their generated destructors must release nested payloads.
private record CompilerSemanticTypeSubstitution {
	parameter: CompilerTypeParameterId,
	replacement: SemanticType
}


private record CompilerInstalledUnionVariant {
	definition: VariantDef,
	constructor_id: Int
}


private pure func type_header_installation_identity(
	installation: CompilerTypeHeaderInstallation,
) -> CompilerModuleIdentity:
	match installation:
		CompilerLocalTypeHeaderInstallation(identity, _):
			identity
		CompilerImportedTypeHeaderInstallation(identity, _):
			identity


private pure func type_header_installation_path(
	installation: CompilerTypeHeaderInstallation,
) -> String:
	match installation:
		CompilerLocalTypeHeaderInstallation(_, path):
			path
		CompilerImportedTypeHeaderInstallation(_, path):
			path


private pure func installed_type_name(
	source_name: String,
	installation: CompilerTypeHeaderInstallation,
) -> String:
	match installation:
		CompilerLocalTypeHeaderInstallation(_, _):
			source_name
		CompilerImportedTypeHeaderInstallation(_, path):
			canonical_module_type_name(path, source_name)


private pure func finalize_installed_type(
	state: CompilerTypecheckState,
	source_name: String,
	type_name: String,
	type_parameters: List[String],
	installation: CompilerTypeHeaderInstallation,
) -> CompilerTypecheckState:
	module_path = type_header_installation_path(installation)

	with_home = match installation:
		CompilerLocalTypeHeaderInstallation(_, _):
			compiler_typecheck_state_record_type_home(state, type_name, module_path, False)
		CompilerImportedTypeHeaderInstallation(_, _):
			compiler_typecheck_state_record_type_home(state, type_name, module_path, True)

	match installation:
		CompilerLocalTypeHeaderInstallation(_, _):
			with_home
		CompilerImportedTypeHeaderInstallation(_, _):
			add_imported_type_aliases(
				with_home,
				module_path,
				source_name,
				type_name,
				type_parameters,
			)


private pure func resolved_declared_type_name(
	graph: CompilerTypeHeaderGraph,
	id: CompilerTypeId,
	installation: CompilerTypeHeaderInstallation,
) -> Option[String]:
	source_name = compiler_type_id_name(id)

	if compiler_module_identities_equal(
		compiler_type_id_module_identity(id),
		type_header_installation_identity(installation),
	):
		match installation:
			CompilerLocalTypeHeaderInstallation(_, _):
				Some(source_name)
			CompilerImportedTypeHeaderInstallation(_, path):
				Some(canonical_module_type_name(path, source_name))
	else:
		compiler_type_header_graph_type_module_path(
			graph,
			id,
		).map(
			func(path): canonical_module_type_name(path, source_name),
		)


private pure func semantic_dim_op(op: CompilerResolvedDimOp) -> SemanticDimOp:
	match op:
		CompilerResolvedDimAdd:
			SemanticDimAdd
		CompilerResolvedDimSubtract:
			SemanticDimSubtract
		CompilerResolvedDimMultiply:
			SemanticDimMultiply
		CompilerResolvedDimDivide:
			SemanticDimDivide


private pure func semantic_type_substitution_find(
	substitutions: List[CompilerSemanticTypeSubstitution],
	parameter: CompilerTypeParameterId,
) -> Option[SemanticType]:
	var result: Option[SemanticType] = None

	for substitution in substitutions:
		if compiler_type_parameter_ids_equal(substitution.parameter, parameter):
			result = Some(substitution.replacement)
			break

	result


private pure func semantic_types_from_resolved_shapes_with_substitutions(
	graph: CompilerTypeHeaderGraph,
	shapes: List[CompilerResolvedTypeShape],
	installation: CompilerTypeHeaderInstallation,
	substitutions: List[CompilerSemanticTypeSubstitution],
) -> Option[List[SemanticType]]:
	var result: List[SemanticType] = []
	var valid: Bool = True

	for shape in shapes:
		if valid:
			match semantic_type_from_resolved_shape_with_substitutions(
				graph,
				shape,
				installation,
				substitutions,
			):
				Some(semantic_type):
					result = result.append(semantic_type)
				None:
					valid = False

	if valid:
		Some(result)
	else:
		None


private pure func semantic_type_from_resolved_shape_with_substitutions(
	graph: CompilerTypeHeaderGraph,
	shape: CompilerResolvedTypeShape,
	installation: CompilerTypeHeaderInstallation,
	substitutions: List[CompilerSemanticTypeSubstitution],
) -> Option[SemanticType]:
	match shape:
		CompilerDeclaredTypeShape(id, args):
			semantic_args ?= semantic_types_from_resolved_shapes_with_substitutions(
				graph,
				args,
				installation,
				substitutions,
			)

			match compiler_type_header_graph_declared_type_expansion(graph, id):
				Some(expansion):
					match expansion:
						CompilerTransparentAliasExpansion(parameters, target):
							if parameters.length() != semantic_args.length():
								None
							else:
								var alias_substitutions = substitutions
								var index: Int = 0

								while index < parameters.length():
									match (parameters.get(index), semantic_args.get(index)):
										(Some(parameter), Some(replacement)):
											alias_substitutions = alias_substitutions.append({
												parameter = parameter.id,
												replacement = replacement,
											})
										_:
											void

									index += 1

								semantic_type_from_resolved_shape_with_substitutions(
									graph,
									target,
									installation,
									alias_substitutions,
								)
						CompilerNominalDeclaredType:
							name ?= resolved_declared_type_name(graph, id, installation)
							Some(SemanticNamedType(name, semantic_args))
				None:
					None
		CompilerIntrinsicTypeShape(intrinsic, args):
			semantic_args ?= semantic_types_from_resolved_shapes_with_substitutions(
				graph,
				args,
				installation,
				substitutions,
			)

			match intrinsic:
				CompilerIntrinsicTaskResult:
					-- TaskResult is a source-level alias retained in header shapes for
					-- layout analysis. The semantic environment must receive its
					-- canonical Result type so Result constructors remain valid.
					match semantic_args:
						[ok_type]:
							Some(
								SemanticNamedType(
									"Result",
									[ok_type, SemanticNamedType("ConcurrencyError", [])],
								),
							)
						_:
							None
				_:
					Some(SemanticNamedType(compiler_intrinsic_type_name(intrinsic), semantic_args))
		CompilerPreludeTypeShape(prelude, args):
			semantic_args ?= semantic_types_from_resolved_shapes_with_substitutions(
				graph,
				args,
				installation,
				substitutions,
			)
			prelude_name = compiler_prelude_type_name(prelude)

			semantic_name = if compiler_type_header_graph_owner_provides_prelude_type(
				graph,
				type_header_installation_identity(installation),
				prelude,
			):
				match installation:
					CompilerLocalTypeHeaderInstallation(_, _):
						prelude_name
					CompilerImportedTypeHeaderInstallation(_, path):
						canonical_module_type_name(path, prelude_name)
			else:
				prelude_name

			Some(SemanticNamedType(semantic_name, semantic_args))
		CompilerTypeParameterShape(id):
			Some(
				semantic_type_substitution_find(
					substitutions,
					id,
				).get_or(SemanticTypeVar(compiler_type_parameter_id_name(id))),
			)
		CompilerSelfTypeShape(_):
			Some(SemanticSelfType)
		CompilerTraitTypeParameterShape(id):
			Some(SemanticTypeVar(compiler_trait_type_parameter_id_name(id)))
		CompilerCallableTypeParameterShape(id):
			Some(SemanticTypeVar(compiler_callable_type_parameter_id_name(id)))
		CompilerImplementationTypeParameterShape(id):
			Some(SemanticTypeVar(compiler_implementation_type_parameter_id_name(id)))
		CompilerTraitSelfTypeShape(_):
			Some(SemanticSelfType)
		CompilerDimensionParameterShape(id, is_variadic):
			name = compiler_type_parameter_id_name(id)

			match semantic_type_substitution_find(substitutions, id):
				Some(replacement):
					Some(replacement)
				None:
					if is_variadic:
						Some(SemanticVarDimsType(name))
					else:
						Some(SemanticTypeVar(name))
		CompilerTraitDimensionParameterShape(id, is_variadic):
			name = compiler_trait_type_parameter_id_name(id)

			if is_variadic:
				Some(SemanticVarDimsType(name))
			else:
				Some(SemanticTypeVar(name))
		CompilerCallableDimensionParameterShape(id, is_variadic):
			name = compiler_callable_type_parameter_id_name(id)

			if is_variadic:
				Some(SemanticVarDimsType(name))
			else:
				Some(SemanticTypeVar(name))
		CompilerImplementationDimensionParameterShape(id, is_variadic):
			name = compiler_implementation_type_parameter_id_name(id)

			if is_variadic:
				Some(SemanticVarDimsType(name))
			else:
				Some(SemanticTypeVar(name))
		CompilerWildcardDimensionShape(is_variadic):
			if is_variadic:
				Some(SemanticVarDimsType("#_"))
			else:
				Some(SemanticTypeVar("#_"))
		CompilerDimensionLiteralShape(value):
			Some(SemanticConstIntType(value))
		CompilerDimensionBinaryShape(op, left, right):
			semantic_left ?= semantic_type_from_resolved_shape_with_substitutions(
				graph,
				left,
				installation,
				substitutions,
			)
			semantic_right ?= semantic_type_from_resolved_shape_with_substitutions(
				graph,
				right,
				installation,
				substitutions,
			)
			Some(SemanticDimOpType(semantic_dim_op(op), semantic_left, semantic_right))
		CompilerRangeTypeShape(inner):
			semantic_inner ?= semantic_type_from_resolved_shape_with_substitutions(
				graph,
				inner,
				installation,
				substitutions,
			)
			Some(SemanticRangeType(semantic_inner))
		CompilerTupleTypeShape(elements):
			semantic_elements ?= semantic_types_from_resolved_shapes_with_substitutions(
				graph,
				elements,
				installation,
				substitutions,
			)
			Some(SemanticTupleType(semantic_elements))
		CompilerFunctionTypeShape(is_pure, params, return_type):
			semantic_params ?= semantic_types_from_resolved_shapes_with_substitutions(
				graph,
				params,
				installation,
				substitutions,
			)
			semantic_return ?= semantic_type_from_resolved_shape_with_substitutions(
				graph,
				return_type,
				installation,
				substitutions,
			)
			Some(SemanticFunctionType(is_pure, semantic_params, semantic_return))
		CompilerArrayTypeShape(element, dims):
			semantic_element ?= semantic_type_from_resolved_shape_with_substitutions(
				graph,
				element,
				installation,
				substitutions,
			)
			semantic_dims ?= semantic_types_from_resolved_shapes_with_substitutions(
				graph,
				dims,
				installation,
				substitutions,
			)
			Some(SemanticArrayType(semantic_element, semantic_dims))


private pure func semantic_type_from_resolved_shape(
	graph: CompilerTypeHeaderGraph,
	shape: CompilerResolvedTypeShape,
	installation: CompilerTypeHeaderInstallation,
) -> Option[SemanticType]:
	semantic_type_from_resolved_shape_with_substitutions(graph, shape, installation, [])


-- Callable and implementation adapters use these category-specific entry
-- points so importer-local naming cannot be confused with owner-local naming.
-- The resolved shape remains definition-owned; only its legacy Env spelling
-- depends on the installation site.
pure func compiler_local_semantic_type_from_resolved_shape(
	graph: CompilerTypeHeaderGraph,
	owner_identity: CompilerModuleIdentity,
	owner_path: String,
	shape: CompilerResolvedTypeShape,
) -> Option[SemanticType]:
	semantic_type_from_resolved_shape(
		graph,
		shape,
		CompilerLocalTypeHeaderInstallation(owner_identity, owner_path),
	)


pure func compiler_imported_semantic_type_from_resolved_shape(
	graph: CompilerTypeHeaderGraph,
	owner_identity: CompilerModuleIdentity,
	owner_path: String,
	shape: CompilerResolvedTypeShape,
) -> Option[SemanticType]:
	semantic_type_from_resolved_shape(
		graph,
		shape,
		CompilerImportedTypeHeaderInstallation(owner_identity, owner_path),
	)


private pure func builtin_header_type_parameters(
	header: CompilerAcceptedBuiltinHeader,
) -> List[String]:
	compiler_builtin_type_header_parameters(
		header,
	).map(
		func(parameter): compiler_type_parameter_id_name(parameter.id),
	)


private pure func install_builtin_header(
	state: CompilerTypecheckState,
	header: CompilerAcceptedBuiltinHeader,
	installation: CompilerBuiltinHeaderInstallation,
) -> CompilerTypecheckState:
	source_name = compiler_type_id_name(compiler_builtin_type_header_id(header))

	module_path = match installation:
		CompilerLocalBuiltinInstallation(path):
			path
		CompilerImportedBuiltinInstallation(path):
			path

	type_name = match installation:
		CompilerLocalBuiltinInstallation(_):
			source_name
		CompilerImportedBuiltinInstallation(path):
			canonical_module_type_name(path, source_name)

	layout = compiler_builtin_type_header_layout(header)
	type_parameters = builtin_header_type_parameters(header)

	is_resource = match layout:
		CompilerScalarBuiltin | CompilerManagedBuiltin | CompilerNoValueBuiltin | CompilerUnclassifiedBuiltin:
			False
		CompilerResourceBuiltin(_):
			True

	var next = match installation:
		CompilerLocalBuiltinInstallation(_):
			if compiler_typecheck_state_allows_builtin(state):
				state
			else:
				prefix = if is_resource:
					"resource type "
				else:
					"type "

				compiler_typecheck_state_add_error(
					state,
					"'" + prefix + source_name + " = builtin' can only be used in the standard library",
				)
		CompilerImportedBuiltinInstallation(_):
			state

	next = if is_resource:
		compiler_typecheck_state_add_known_resource_type_name(next, type_name)
	else:
		match installation:
			CompilerLocalBuiltinInstallation(_):
				compiler_typecheck_state_add_known_type_name(next, type_name)
			CompilerImportedBuiltinInstallation(_):
				next

	type_kind = match layout:
		CompilerScalarBuiltin:
			TypeScalarBuiltin
		CompilerResourceBuiltin(_):
			TypeResource
		CompilerManagedBuiltin | CompilerNoValueBuiltin | CompilerUnclassifiedBuiltin:
			TypeBuiltin

	env: Env = env_add_type(next.env, type_name, type_parameters, [], type_kind, is_resource, False)
	with_env = { next | env = env }

	with_cleanup = match layout:
		CompilerResourceBuiltin(CompilerResourceWithCleanup(cleanup)):
			{ with_env | context = register_resource_cleanup(with_env.context, type_name, cleanup) }
		CompilerResourceBuiltin(CompilerResourceWithoutCleanup):
			with_env
		CompilerScalarBuiltin | CompilerManagedBuiltin | CompilerNoValueBuiltin | CompilerUnclassifiedBuiltin:
			with_env

	with_home = match installation:
		CompilerLocalBuiltinInstallation(_):
			compiler_typecheck_state_record_type_home(with_cleanup, type_name, module_path, False)
		CompilerImportedBuiltinInstallation(_):
			compiler_typecheck_state_record_type_home(with_cleanup, type_name, module_path, True)

	match installation:
		CompilerLocalBuiltinInstallation(_):
			with_home
		CompilerImportedBuiltinInstallation(_):
			add_imported_type_aliases(
				with_home,
				module_path,
				source_name,
				type_name,
				type_parameters,
			)


private pure func record_header_type_parameters(
	header: CompilerAcceptedRecordHeader,
) -> List[String]:
	compiler_record_type_header_parameters(
		header,
	).map(
		func(parameter): compiler_type_parameter_id_name(parameter.id),
	)


private pure func record_header_fields(
	graph: CompilerTypeHeaderGraph,
	header: CompilerAcceptedRecordHeader,
	installation: CompilerTypeHeaderInstallation,
) -> Option[List[FieldDecl]]:
	var result: List[FieldDecl] = []
	var valid: Bool = True

	for field in compiler_record_type_header_fields(header):
		if valid:
			match semantic_type_from_resolved_shape(graph, field.typ, installation):
				Some(field_type):
					result = result.append({
						name = field.name,
						field_type = field_type,
						definition_id = field.definition_id,
					})
				None:
					valid = False

	if valid:
		Some(result)
	else:
		None


private pure func install_record_header(
	state: CompilerTypecheckState,
	graph: CompilerTypeHeaderGraph,
	header: CompilerAcceptedRecordHeader,
	installation: CompilerTypeHeaderInstallation,
) -> CompilerTypecheckState:
	source_name = compiler_type_id_name(compiler_record_type_header_id(header))
	type_name = installed_type_name(source_name, installation)

	match record_header_fields(graph, header, installation):
		None:
			compiler_typecheck_state_add_error(
				state,
				"internal typecheck error: accepted record header '" + type_name + "' refers to a module absent from its type-header graph",
			)
		Some(fields):
			is_value = match compiler_record_type_header_layout(header):
				CompilerHeapRecord:
					False
				CompilerValueStruct:
					True

			env = env_add_record(
				state.env,
				type_name,
				record_header_type_parameters(header),
				fields,
				is_value,
				compiler_record_type_header_contains_resource(header),
			)
			finalize_installed_type(
				{ state | env = env },
				source_name,
				type_name,
				record_header_type_parameters(header),
				installation,
			)


private pure func union_header_type_parameters(header: CompilerAcceptedUnionHeader) -> List[String]:
	compiler_union_type_header_parameters(
		header,
	).map(
		func(parameter): compiler_type_parameter_id_name(parameter.id),
	)


private pure func installed_union_variant(
	graph: CompilerTypeHeaderGraph,
	variant: CompilerTypeHeaderVariant,
	installation: CompilerTypeHeaderInstallation,
) -> Option[CompilerInstalledUnionVariant]:
	fields ?= semantic_types_from_resolved_shapes_with_substitutions(
		graph,
		variant.fields,
		installation,
		[],
	)
	Some({
		definition = {
			name = variant.name,
			fields = fields,
			tag = variant.tag
		},
		constructor_id = compiler_constructor_id_definition_id(variant.id),
	})


private pure func installed_union_variants(
	graph: CompilerTypeHeaderGraph,
	header: CompilerAcceptedUnionHeader,
	installation: CompilerTypeHeaderInstallation,
) -> Option[List[CompilerInstalledUnionVariant]]:
	var result: List[CompilerInstalledUnionVariant] = []
	var valid: Bool = True

	for variant in compiler_union_type_header_variants(header):
		if valid:
			match installed_union_variant(graph, variant, installation):
				Some(installed):
					result = result.append(installed)
				None:
					valid = False

	if valid:
		Some(result)
	else:
		None


private pure func install_union_header(
	state: CompilerTypecheckState,
	graph: CompilerTypeHeaderGraph,
	header: CompilerAcceptedUnionHeader,
	installation: CompilerTypeHeaderInstallation,
) -> CompilerTypecheckState:
	source_name = compiler_type_id_name(compiler_union_type_header_id(header))
	type_name = installed_type_name(source_name, installation)

	match installed_union_variants(graph, header, installation):
		None:
			compiler_typecheck_state_add_error(
				state,
				"internal typecheck error: accepted union header '" + type_name + "' refers to a module absent from its type-header graph",
			)
		Some(installed_variants):
			type_kind = match compiler_union_type_header_layout(header):
				CompilerTaggedUnion:
					TypeUnion
				CompilerFieldlessEnum:
					TypeEnum

			type_parameters = union_header_type_parameters(header)
			env = env_add_type_with_constructor_ids(
				state.env,
				type_name,
				type_parameters,
				installed_variants.map(func(variant): variant.definition),
				type_kind,
				compiler_union_type_header_contains_resource(header),
				True,
				installed_variants.map(func(variant): Some(variant.constructor_id)),
			)
			finalize_installed_type(
				{ state | env = env },
				source_name,
				type_name,
				type_parameters,
				installation,
			)


private pure func alias_header_type_parameters(header: CompilerAcceptedAliasHeader) -> List[String]:
	compiler_alias_type_header_parameters(
		header,
	).map(
		func(parameter): compiler_type_parameter_id_name(parameter.id),
	)


private pure func finalize_installed_alias(
	state: CompilerTypecheckState,
	source_name: String,
	type_name: String,
	type_parameters: List[String],
	layout: CompilerAliasLayout,
	installation: CompilerTypeHeaderInstallation,
) -> CompilerTypecheckState:
	module_path = type_header_installation_path(installation)

	with_home = match layout:
		CompilerTransparentAlias:
			state
		CompilerOpaqueAlias:
			match installation:
				CompilerLocalTypeHeaderInstallation(_, _):
					compiler_typecheck_state_record_type_home(state, type_name, module_path, False)
				CompilerImportedTypeHeaderInstallation(_, _):
					compiler_typecheck_state_record_type_home(state, type_name, module_path, True)

	match installation:
		CompilerLocalTypeHeaderInstallation(_, _):
			with_home
		CompilerImportedTypeHeaderInstallation(_, _):
			add_imported_type_aliases(
				with_home,
				module_path,
				source_name,
				type_name,
				type_parameters,
			)


private pure func install_alias_header(
	state: CompilerTypecheckState,
	graph: CompilerTypeHeaderGraph,
	header: CompilerAcceptedAliasHeader,
	installation: CompilerTypeHeaderInstallation,
) -> CompilerTypecheckState:
	source_name = compiler_type_id_name(compiler_alias_type_header_id(header))
	type_name = installed_type_name(source_name, installation)
	type_parameters = alias_header_type_parameters(header)
	layout = compiler_alias_type_header_layout(header)

	match semantic_type_from_resolved_shape(
		graph,
		compiler_alias_type_header_target(header),
		installation,
	):
		None:
			compiler_typecheck_state_add_error(
				state,
				"internal typecheck error: accepted alias header '" + type_name + "' refers to a module absent from its type-header graph",
			)
		Some(target):
			env = match layout:
				CompilerTransparentAlias:
					env_add_alias(state.env, type_name, type_parameters, target)
				CompilerOpaqueAlias:
					env_add_opaque_alias(
						state.env,
						type_name,
						type_parameters,
						target,
						Some(type_header_installation_path(installation)),
					)

			with_env = { compiler_typecheck_state_add_known_type_name(state, type_name) |
				env = env
			}
			finalize_installed_alias(
				with_env,
				source_name,
				type_name,
				type_parameters,
				layout,
				installation,
			)


pure func typecheck_install_local_builtin_headers(
	state: CompilerTypecheckState,
	graph: CompilerTypeHeaderGraph,
	module_identity: CompilerModuleIdentity,
	module_path: String,
) -> CompilerTypecheckState:
	var next = state

	for header in compiler_type_header_graph_local_builtin_headers(graph, module_identity):
		next = install_builtin_header(next, header, CompilerLocalBuiltinInstallation(module_path))

	next


pure func typecheck_install_imported_builtin_headers(
	state: CompilerTypecheckState,
	graph: CompilerTypeHeaderGraph,
	module_identity: CompilerModuleIdentity,
	module_path: String,
) -> CompilerTypecheckState:
	var next = state

	for header in compiler_type_header_graph_public_builtin_headers(graph, module_identity):
		next = install_builtin_header(
			next,
			header,
			CompilerImportedBuiltinInstallation(module_path),
		)

	next


