		compiler_trait_type_parameter_id_name,
		compiler_type_header_graph_declared_type_expansion,
		compiler_type_header_graph_local_alias_headers,
		compiler_type_header_graph_local_builtin_headers,
		compiler_type_header_graph_local_record_headers,
		compiler_type_header_graph_local_union_headers,
