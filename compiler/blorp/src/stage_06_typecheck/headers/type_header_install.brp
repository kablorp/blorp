			CompilerArrayTypeShape,
			CompilerCallableDimensionParameterShape,
			CompilerCallableTypeParameterShape,
			CompilerDeclaredTypeShape,
			CompilerDimensionBinaryShape,
			CompilerDimensionLiteralShape,
			CompilerDimensionParameterShape,
			CompilerFunctionTypeShape,
			CompilerImplementationDimensionParameterShape,
			CompilerImplementationTypeParameterShape,
			CompilerIntrinsicTypeShape,
			CompilerPreludeTypeShape,
			CompilerRangeTypeShape,
			CompilerSelfTypeShape,
			CompilerTraitDimensionParameterShape,
			CompilerTraitSelfTypeShape,
			CompilerTraitTypeParameterShape,
			CompilerTupleTypeShape,
			CompilerTypeParameterShape,
			CompilerWildcardDimensionShape,
		),
		CompilerResourceCleanupPolicy(CompilerResourceWithCleanup, CompilerResourceWithoutCleanup),
		CompilerTypeHeaderField,
		CompilerTypeHeaderGraph,
		CompilerTypeHeaderVariant,
		CompilerUnionLayout(CompilerFieldlessEnum, CompilerTaggedUnion),
		compiler_alias_type_header_id,
		compiler_alias_type_header_layout,
		compiler_alias_type_header_parameters,
