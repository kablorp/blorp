-- Accepted callable signature facts shared by trait, function, and foreign
-- declaration headers. Source binders are retained for diagnostics and named
-- argument behavior; semantic types are already resolved exact shapes.
import:
	../../stage_03_parse/parsed_ast:
		ParsedParam,
		ParsedParamBinder(ParsedParamNameBinder, ParsedParamTupleBinder, ParsedParamWildcardBinder),
	type_header_graph: CompilerResolvedTypeShape


union CompilerCallableParameterBinder:
	CompilerNamedParameter(String)
	CompilerWildcardParameter
	CompilerTupleParameter(List[String])


record CompilerCallableParameter {
	binder: CompilerCallableParameterBinder,
	typ: CompilerResolvedTypeShape
}


private record CompilerCallableSignatureRep {
	parameters: List[CompilerCallableParameter],
	return_type: CompilerResolvedTypeShape,
	is_pure: Bool
}


opaque type CompilerCallableSignature = CompilerCallableSignatureRep


pure func compiler_callable_parameter_binder_from_parsed(
	param: ParsedParam,
) -> CompilerCallableParameterBinder:
	match param.binder:
		ParsedParamNameBinder(name):
			CompilerNamedParameter(name.text)
		ParsedParamWildcardBinder(_):
			CompilerWildcardParameter
		ParsedParamTupleBinder(names, _):
			CompilerTupleParameter(names.map(
				func(name): name.text,
			))


pure func compiler_callable_parameter(
	binder: CompilerCallableParameterBinder,
	typ: CompilerResolvedTypeShape,
) -> CompilerCallableParameter:
	{
		binder = binder,
		typ = typ
	}


pure func compiler_callable_signature(
	parameters: List[CompilerCallableParameter],
	return_type: CompilerResolvedTypeShape,
	is_pure: Bool,
) -> CompilerCallableSignature:
	into CompilerCallableSignature({
		parameters = parameters,
		return_type = return_type,
		is_pure = is_pure,
	})


pure func compiler_callable_parameter_binder(
	parameter: CompilerCallableParameter,
) -> CompilerCallableParameterBinder:
	parameter.binder


pure func compiler_callable_parameter_type(
	parameter: CompilerCallableParameter,
) -> CompilerResolvedTypeShape:
	parameter.typ


pure func compiler_callable_signature_parameters(
	signature: CompilerCallableSignature,
) -> List[CompilerCallableParameter]:
	from CompilerCallableSignature(signature).parameters


pure func compiler_callable_signature_return_type(
	signature: CompilerCallableSignature,
) -> CompilerResolvedTypeShape:
	from CompilerCallableSignature(signature).return_type


pure func compiler_callable_signature_is_pure(signature: CompilerCallableSignature) -> Bool:
	from CompilerCallableSignature(signature).is_pure
