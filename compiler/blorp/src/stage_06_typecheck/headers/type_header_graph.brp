pure func type_header_graph_type_module_path(graph: TypeHeaderGraph, id: TypeId) -> Option[String]:
	parameter_graph = type_header_graph_rep(graph).parameter_graph
	declaration_graph = acyclic_type_alias_dependency_graph_declaration_graph(
		resolved_type_parameter_graph_alias_dependencies(parameter_graph),
	)
	bound_graph = declaration_skeleton_graph_bound_graph(declaration_graph)
	bound_module_graph_find(
		bound_graph,
		type_id_module_identity(
			id,
		),
	).map(
		func(module): prepared_module_scope_canonical_path(bound_module_scope(module)),
	)


pure func type_header_graph_owner_provides_prelude_type(
	graph: TypeHeaderGraph,
	owner_identity: ModuleIdentity,
	prelude_type: PreludeType,
) -> Bool:
	parameter_graph = type_header_graph_rep(graph).parameter_graph
	declaration_graph = acyclic_type_alias_dependency_graph_declaration_graph(
		resolved_type_parameter_graph_alias_dependencies(parameter_graph),
	)
	bound_graph = declaration_skeleton_graph_bound_graph(declaration_graph)

	match bound_module_graph_find(bound_graph, owner_identity):
		None:
			False
		Some(module):
			scope = bound_module_scope(module)
			importable_module_request_aliases(
				prepared_module_scope_canonical_path(scope),
				prepared_module_scope_origin(scope),
				bound_module_program(
					module,
				).source.module_name,
			).contains(prelude_type_module_path(prelude_type))


