pure func compiler_type_header_graph_type_module_path(
	graph: CompilerTypeHeaderGraph,
	id: CompilerTypeId,
) -> Option[String]:
	parameter_graph = type_header_graph_rep(graph).parameter_graph
	declaration_graph = compiler_acyclic_type_alias_dependency_graph_declaration_graph(
		compiler_resolved_type_parameter_graph_alias_dependencies(parameter_graph),
	)
	bound_graph = compiler_declaration_skeleton_graph_bound_graph(declaration_graph)
	compiler_bound_module_graph_find(
		bound_graph,
		compiler_type_id_module_identity(
			id,
		),
	).map(
		func(
			module,
		): compiler_prepared_module_scope_canonical_path(compiler_bound_module_scope(module)),
	)


pure func compiler_type_header_graph_owner_provides_prelude_type(
	graph: CompilerTypeHeaderGraph,
	owner_identity: CompilerModuleIdentity,
	prelude_type: CompilerPreludeType,
) -> Bool:
	parameter_graph = type_header_graph_rep(graph).parameter_graph
	declaration_graph = compiler_acyclic_type_alias_dependency_graph_declaration_graph(
		compiler_resolved_type_parameter_graph_alias_dependencies(parameter_graph),
	)
	bound_graph = compiler_declaration_skeleton_graph_bound_graph(declaration_graph)

	match compiler_bound_module_graph_find(bound_graph, owner_identity):
		None:
			False
		Some(module):
			scope = compiler_bound_module_scope(module)
			compiler_importable_module_identity_matches_request(
				compiler_prepared_module_scope_canonical_path(scope),
				compiler_prepared_module_scope_origin(scope),
				compiler_bound_module_program(module).source.module_name,
				compiler_prelude_type_module_path(prelude_type),
			)


