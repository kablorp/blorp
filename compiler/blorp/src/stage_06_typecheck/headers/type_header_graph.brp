enum CompilerIntrinsicType:
	CompilerIntrinsicInt
	CompilerIntrinsicFloat
	CompilerIntrinsicBool
	CompilerIntrinsicString
	CompilerIntrinsicChar
	CompilerIntrinsicVoid
	CompilerIntrinsicBytes
	CompilerIntrinsicPtr
	CompilerIntrinsicFixed
	CompilerIntrinsicInt8
	CompilerIntrinsicInt16
	CompilerIntrinsicInt32
	CompilerIntrinsicInt64
	CompilerIntrinsicInt128
	CompilerIntrinsicUInt8
	CompilerIntrinsicUInt16
	CompilerIntrinsicUInt32
	CompilerIntrinsicUInt64
	CompilerIntrinsicUInt128
	CompilerIntrinsicFloat32
	CompilerIntrinsicFloat16
	CompilerIntrinsicTensor
	CompilerIntrinsicOption
	CompilerIntrinsicResult
	CompilerIntrinsicConcurrencyError
	CompilerIntrinsicTaskResult


enum CompilerResolvedDimOp:
	CompilerResolvedDimAdd
	CompilerResolvedDimSubtract
	CompilerResolvedDimMultiply
	CompilerResolvedDimDivide


union CompilerResolvedTypeShape:
	CompilerDeclaredTypeShape(CompilerTypeId, List[CompilerResolvedTypeShape])
	CompilerIntrinsicTypeShape(CompilerIntrinsicType, List[CompilerResolvedTypeShape])
	CompilerPreludeTypeShape(CompilerPreludeType, List[CompilerResolvedTypeShape])
	CompilerTypeParameterShape(CompilerTypeParameterId)
	CompilerSelfTypeShape(CompilerTypeId)
	CompilerDimensionParameterShape(CompilerTypeParameterId, Bool)
	CompilerDimensionLiteralShape(Int)
	CompilerDimensionBinaryShape(CompilerResolvedDimOp, CompilerResolvedTypeShape, CompilerResolvedTypeShape)
	CompilerRangeTypeShape(CompilerResolvedTypeShape)
	CompilerTupleTypeShape(List[CompilerResolvedTypeShape])
	CompilerFunctionTypeShape(Bool, List[CompilerResolvedTypeShape], CompilerResolvedTypeShape)
	CompilerArrayTypeShape(CompilerResolvedTypeShape, List[CompilerResolvedTypeShape])


enum CompilerRecordLayout:
	CompilerHeapRecord
	CompilerValueStruct


enum CompilerUnionLayout:
	CompilerTaggedUnion
	CompilerFieldlessEnum


enum CompilerAliasLayout:
	CompilerTransparentAlias
	CompilerOpaqueAlias


union CompilerResourceCleanupPolicy:
	CompilerResourceWithoutCleanup
	CompilerResourceWithCleanup(String)


-- Builtin declarations carry storage ownership explicitly after header
-- resolution, and installation preserves scalar storage in Env. Core still
-- has a transitional name-based ABI projection; do not add another frontend
-- name list while that representation boundary is being retired.
union CompilerBuiltinTypeLayout:
	CompilerScalarBuiltin
	CompilerManagedBuiltin
	CompilerNoValueBuiltin
	CompilerUnclassifiedBuiltin
	CompilerResourceBuiltin(CompilerResourceCleanupPolicy)


record CompilerTypeHeaderField {
	name: String,
	typ: CompilerResolvedTypeShape,
	definition_id: Option[Int]
}


record CompilerTypeHeaderVariant {
	id: CompilerConstructorId,
	parent_type_id: CompilerTypeId,
	name: String,
	tag: Int,
	fields: List[CompilerResolvedTypeShape]
}


union CompilerTypeHeaderShape:
	CompilerRecordTypeHeader(CompilerRecordLayout, List[CompilerTypeHeaderField])
	CompilerUnionTypeHeader(CompilerUnionLayout, List[CompilerTypeHeaderVariant])
	CompilerBuiltinTypeHeader(CompilerBuiltinTypeLayout)
	CompilerAliasTypeHeader(CompilerAliasLayout, CompilerResolvedTypeShape)


union CompilerDeclaredTypeExpansion:
	CompilerNominalDeclaredType
	CompilerTransparentAliasExpansion(List[CompilerResolvedTypeParameter], CompilerResolvedTypeShape)


record CompilerTypeHeader {
	id: CompilerTypeId,
	parameters: List[CompilerResolvedTypeParameter],
	shape: CompilerTypeHeaderShape,
	contains_resource: Bool
}


-- Category-specific projection used by environment installation. A caller
-- holding this value cannot accidentally install a record, union, or alias as
-- a builtin type.
private record CompilerAcceptedBuiltinHeaderRep {
	id: CompilerTypeId,
	parameters: List[CompilerResolvedTypeParameter],
	layout: CompilerBuiltinTypeLayout
}


opaque type CompilerAcceptedBuiltinHeader = CompilerAcceptedBuiltinHeaderRep


-- Category-specific projection used by environment installation. Resolved
-- field types retain declaration identities until the installation boundary;
-- callers cannot construct or accidentally pass another header category.
private record CompilerAcceptedRecordHeaderRep {
	id: CompilerTypeId,
	parameters: List[CompilerResolvedTypeParameter],
	layout: CompilerRecordLayout,
	fields: List[CompilerTypeHeaderField],
	contains_resource: Bool
}


opaque type CompilerAcceptedRecordHeader = CompilerAcceptedRecordHeaderRep


-- Constructor identity, tag, and payload shape remain one value through the
-- installation boundary, so the transitional Env cannot observe independently
-- reordered constructor-ID and variant lists.
private record CompilerAcceptedUnionHeaderRep {
	id: CompilerTypeId,
	parameters: List[CompilerResolvedTypeParameter],
	layout: CompilerUnionLayout,
	variants: List[CompilerTypeHeaderVariant],
	contains_resource: Bool
}


opaque type CompilerAcceptedUnionHeader = CompilerAcceptedUnionHeaderRep


-- Alias layout and target remain coupled in the accepted projection. This
-- prevents installation from treating a transparent alias as nominal or an
-- opaque alias as expandable.
private record CompilerAcceptedAliasHeaderRep {
	id: CompilerTypeId,
	parameters: List[CompilerResolvedTypeParameter],
	layout: CompilerAliasLayout,
	target: CompilerResolvedTypeShape
}


opaque type CompilerAcceptedAliasHeader = CompilerAcceptedAliasHeaderRep


private enum CompilerHeaderVisibilitySelection:
	CompilerAllModuleHeaders
	CompilerPublicModuleHeaders


-- This must remain ARC-managed: both fields own heap containers, and the table
-- is itself embedded in CompilerTypeHeaderGraphRep.
private record CompilerTypeHeaderTable {
	headers: List[CompilerTypeHeader],
	header_indices_by_name: Dict[String, List[Int]]
}


private record CompilerTypeHeaderGraphRep {
	parameter_graph: CompilerResolvedTypeParameterGraph,
	table: CompilerTypeHeaderTable
}


opaque type CompilerTypeHeaderGraph = CompilerTypeHeaderGraphRep


union CompilerTypeHeaderError:
	CompilerTypeHeaderOwnerModuleMissing(CompilerTypeId)
	CompilerTypeHeaderParametersMissing(CompilerTypeId)
	CompilerTypeHeaderUnknownType(CompilerTypeId, String)
	CompilerTypeHeaderUnknownQualifier(CompilerTypeId, String)
	CompilerTypeHeaderImportedModuleMissing(CompilerTypeId, String)
	CompilerTypeHeaderPrivateTypeReference(CompilerTypeId, CompilerTypeId)
	CompilerTypeHeaderArityMismatch(CompilerTypeId, String, Int, Int)
	CompilerTypeHeaderUnknownTypeParameter(CompilerTypeId, String)
	CompilerTypeHeaderInvalidDimension(CompilerTypeId, String)
	CompilerTypeHeaderMissingType(CompilerTypeId)
	CompilerTypeHeaderConstructorMissing(CompilerTypeId, String)
	CompilerTypeHeaderInvalidEnumTypeParameters(CompilerTypeId)
	CompilerTypeHeaderInvalidEnumVariantFields(CompilerTypeId, String)
	CompilerTypeHeaderInvalidStructTypeParameters(CompilerTypeId)
	CompilerTypeHeaderEmptyStruct(CompilerTypeId)
	CompilerTypeHeaderInvalidStructField(CompilerTypeId, String)
	CompilerTypeHeaderRecursiveValueLayout(CompilerTypeId, Bool)


private record CompilerTypeResolutionContext {
	declaration_graph: CompilerDeclarationSkeletonGraph,
	bound_graph: CompilerBoundModuleGraph,
	module: CompilerBoundModule,
	owner: CompilerTypeId,
	parameters: List[CompilerResolvedTypeParameter]
}


private union CompilerResolvedTypeResult:
	CompilerResolvedTypeReady(CompilerResolvedTypeShape)
	CompilerResolvedTypeRejected(List[CompilerTypeHeaderError])


private union CompilerResolvedTypesResult:
	CompilerResolvedTypesReady(List[CompilerResolvedTypeShape])
	CompilerResolvedTypesRejected(List[CompilerTypeHeaderError])


private union CompilerTypeHeaderBuildResult:
	CompilerTypeHeaderReady(CompilerTypeHeader)
	CompilerTypeHeaderRejected(List[CompilerTypeHeaderError])


private pure func compiler_intrinsic_type(name: String) -> Option[CompilerIntrinsicType]:
	match name:
		"Int":
			Some(CompilerIntrinsicInt)
		"Float":
			Some(CompilerIntrinsicFloat)
		"Bool":
			Some(CompilerIntrinsicBool)
		"String":
			Some(CompilerIntrinsicString)
		"Char":
			Some(CompilerIntrinsicChar)
		"Void":
			Some(CompilerIntrinsicVoid)
		"Bytes":
			Some(CompilerIntrinsicBytes)
		"Ptr":
			Some(CompilerIntrinsicPtr)
		"Fixed":
			Some(CompilerIntrinsicFixed)
		"Int8":
			Some(CompilerIntrinsicInt8)
		"Int16":
			Some(CompilerIntrinsicInt16)
		"Int32":
			Some(CompilerIntrinsicInt32)
		"Int64":
			Some(CompilerIntrinsicInt64)
		"Int128":
			Some(CompilerIntrinsicInt128)
		"UInt8":
			Some(CompilerIntrinsicUInt8)
		"UInt16":
			Some(CompilerIntrinsicUInt16)
		"UInt32":
			Some(CompilerIntrinsicUInt32)
		"UInt64":
			Some(CompilerIntrinsicUInt64)
		"UInt128":
			Some(CompilerIntrinsicUInt128)
		"Float32":
			Some(CompilerIntrinsicFloat32)
		"Float16":
			Some(CompilerIntrinsicFloat16)
		"Tensor":
			Some(CompilerIntrinsicTensor)
		"Option":
			Some(CompilerIntrinsicOption)
		"Result":
			Some(CompilerIntrinsicResult)
		"ConcurrencyError":
			Some(CompilerIntrinsicConcurrencyError)
		"TaskResult":
			Some(CompilerIntrinsicTaskResult)
		_:
			None


private pure func intrinsic_is_struct_scalar(intrinsic: CompilerIntrinsicType) -> Bool:
	match intrinsic:
		CompilerIntrinsicInt:
			True
		CompilerIntrinsicFloat:
			True
		CompilerIntrinsicBool:
			True
		CompilerIntrinsicChar:
			True
		CompilerIntrinsicPtr:
			True
		CompilerIntrinsicInt8:
			True
		CompilerIntrinsicInt16:
			True
		CompilerIntrinsicInt32:
			True
		CompilerIntrinsicInt64:
			True
		CompilerIntrinsicInt128:
			True
		CompilerIntrinsicUInt8:
			True
		CompilerIntrinsicUInt16:
			True
		CompilerIntrinsicUInt32:
			True
		CompilerIntrinsicUInt64:
			True
		CompilerIntrinsicUInt128:
			True
		CompilerIntrinsicFloat32:
			True
		CompilerIntrinsicFloat16:
			True
		_:
			False


private pure func compiler_intrinsic_type_arity(typ: CompilerIntrinsicType) -> Int:
	match typ:
		CompilerIntrinsicTensor:
			1
		CompilerIntrinsicOption:
			1
		CompilerIntrinsicResult:
			2
		CompilerIntrinsicTaskResult:
			1
		_:
			0


pure func compiler_intrinsic_type_name(typ: CompilerIntrinsicType) -> String:
	match typ:
		CompilerIntrinsicInt:
			"Int"
		CompilerIntrinsicFloat:
			"Float"
		CompilerIntrinsicBool:
			"Bool"
		CompilerIntrinsicString:
			"String"
		CompilerIntrinsicChar:
			"Char"
		CompilerIntrinsicVoid:
			"Void"
		CompilerIntrinsicBytes:
			"Bytes"
		CompilerIntrinsicPtr:
			"Ptr"
		CompilerIntrinsicFixed:
			"Fixed"
		CompilerIntrinsicInt8:
			"Int8"
		CompilerIntrinsicInt16:
			"Int16"
		CompilerIntrinsicInt32:
			"Int32"
		CompilerIntrinsicInt64:
			"Int64"
		CompilerIntrinsicInt128:
			"Int128"
		CompilerIntrinsicUInt8:
			"UInt8"
		CompilerIntrinsicUInt16:
			"UInt16"
		CompilerIntrinsicUInt32:
			"UInt32"
		CompilerIntrinsicUInt64:
			"UInt64"
		CompilerIntrinsicUInt128:
			"UInt128"
		CompilerIntrinsicFloat32:
			"Float32"
		CompilerIntrinsicFloat16:
			"Float16"
		CompilerIntrinsicTensor:
			"Tensor"
		CompilerIntrinsicOption:
			"Option"
		CompilerIntrinsicResult:
			"Result"
		CompilerIntrinsicConcurrencyError:
			"ConcurrencyError"
		CompilerIntrinsicTaskResult:
			"TaskResult"


private pure func type_parameter_by_name(
	parameters: List[CompilerResolvedTypeParameter],
	name: String,
) -> Option[CompilerTypeParameterId]:
	var result: Option[CompilerTypeParameterId] = None

	for parameter in parameters:
		if compiler_type_parameter_id_name(parameter.id) == name:
			result = Some(parameter.id)
			break

	result


private pure func parsed_dim_op(op: ParsedDimBinaryOp) -> CompilerResolvedDimOp:
	match op:
		ParsedDimAddOp:
			CompilerResolvedDimAdd
		ParsedDimSubtractOp:
			CompilerResolvedDimSubtract
		ParsedDimMultiplyOp:
			CompilerResolvedDimMultiply
		ParsedDimDivideOp:
			CompilerResolvedDimDivide


private pure func parsed_type_parameter_count(skeleton: CompilerTypeDeclarationSkeletonInfo) -> Int:
	match skeleton.source:
		CompilerRecordTypeSource(decl):
			decl.type_params.length()
		CompilerUnionTypeSource(decl):
			decl.type_params.length()
		CompilerBuiltinTypeSource(decl):
			decl.type_params.length()
		CompilerAliasTypeSource(decl):
			decl.type_params.length()


private pure func declared_type_at_path(
	context: CompilerTypeResolutionContext,
	module_path: String,
	name: String,
) -> Result[CompilerTypeDeclarationSkeletonInfo, CompilerTypeHeaderError]:
	match compiler_bound_module_graph_find_canonical_path(context.bound_graph, module_path):
		None:
			Err(CompilerTypeHeaderImportedModuleMissing(context.owner, module_path))
		Some(module):
			match compiler_declaration_skeleton_graph_find_type(
				context.declaration_graph,
				compiler_bound_module_identity(module),
				name,
			):
				None:
					Err(CompilerTypeHeaderUnknownType(context.owner, name))
				Some(skeleton):
					if (
						skeleton.visibility == CompilerPrivateDeclaration
						and not compiler_module_identities_equal(
							compiler_bound_module_identity(context.module),
							compiler_bound_module_identity(module),
						)
					):
						Err(CompilerTypeHeaderPrivateTypeReference(context.owner, skeleton.id))
					else:
						Ok(skeleton)


private pure func declared_unqualified_type(
	context: CompilerTypeResolutionContext,
	name: String,
) -> Result[Option[CompilerTypeDeclarationSkeletonInfo], CompilerTypeHeaderError]:
	match compiler_declaration_skeleton_graph_find_type(
		context.declaration_graph,
		compiler_bound_module_identity(context.module),
		name,
	):
		Some(local):
			Ok(Some(local))
		None:
			match compiler_module_view_find_imported_name(
				compiler_bound_module_view(context.module),
				name,
			):
				None:
					Ok(None)
				Some(binding):
					match declared_type_at_path(
						context,
						binding.module_path,
						binding.original_name,
					):
						Ok(skeleton):
							Ok(Some(skeleton))
						Err(error):
							Err(error)


private pure func validate_type_arity(
	owner: CompilerTypeId,
	name: String,
	expected: Int,
	args: List[CompilerResolvedTypeShape],
) -> Option[CompilerTypeHeaderError]:
	if expected == args.length():
		None
	else:
		Some(CompilerTypeHeaderArityMismatch(owner, name, expected, args.length()))


private pure func resolved_skeleton_type(
	context: CompilerTypeResolutionContext,
	skeleton: CompilerTypeDeclarationSkeletonInfo,
	name: String,
	args: List[CompilerResolvedTypeShape],
) -> CompilerResolvedTypeResult:
	match validate_type_arity(context.owner, name, parsed_type_parameter_count(skeleton), args):
		Some(error):
			CompilerResolvedTypeRejected([error])
		None:
			CompilerResolvedTypeReady(CompilerDeclaredTypeShape(skeleton.id, args))


private pure func resolved_implicit_prelude_type(
	context: CompilerTypeResolutionContext,
	name: String,
	args: List[CompilerResolvedTypeShape],
) -> Option[CompilerResolvedTypeResult]:
	match compiler_prelude_type(name):
		None:
			None
		Some(prelude_type):
			match validate_type_arity(
				context.owner,
				name,
				compiler_prelude_type_arity(prelude_type),
				args,
			):
				Some(error):
					Some(CompilerResolvedTypeRejected([error]))
				None:
					Some(CompilerResolvedTypeReady(CompilerPreludeTypeShape(prelude_type, args)))


private pure func resolve_type_exprs(
	context: CompilerTypeResolutionContext,
	types: List[ParsedTypeExpr],
) -> CompilerResolvedTypesResult:
	var resolved: List[CompilerResolvedTypeShape] = []
	var errors: List[CompilerTypeHeaderError] = []

	for typ in types:
		match resolve_type_expr(context, typ):
			CompilerResolvedTypeReady(shape):
				resolved = resolved.append(shape)
			CompilerResolvedTypeRejected(type_errors):
				errors = errors.concat(type_errors)

	if errors.is_empty():
		CompilerResolvedTypesReady(resolved)
	else:
		CompilerResolvedTypesRejected(errors)


private pure func resolve_named_type(
	context: CompilerTypeResolutionContext,
	name: String,
	args: List[ParsedTypeExpr],
) -> CompilerResolvedTypeResult:
	match resolve_type_exprs(context, args):
		CompilerResolvedTypesRejected(errors):
			CompilerResolvedTypeRejected(errors)
		CompilerResolvedTypesReady(resolved_args):
			if name == "Self" and resolved_args.is_empty():
				CompilerResolvedTypeReady(CompilerSelfTypeShape(context.owner))
			else:
				match type_parameter_by_name(context.parameters, name):
					Some(parameter_id):
						match validate_type_arity(context.owner, name, 0, resolved_args):
							Some(error):
								CompilerResolvedTypeRejected([error])
							None:
								CompilerResolvedTypeReady(CompilerTypeParameterShape(parameter_id))
					None:
						match declared_unqualified_type(context, name):
							Err(error):
								CompilerResolvedTypeRejected([error])
							Ok(Some(skeleton)):
								resolved_skeleton_type(context, skeleton, name, resolved_args)
							Ok(None):
								match resolved_implicit_prelude_type(context, name, resolved_args):
									Some(result):
										result
									None:
										match compiler_intrinsic_type(name):
											Some(intrinsic):
												match validate_type_arity(
													context.owner,
													name,
													compiler_intrinsic_type_arity(intrinsic),
													resolved_args,
												):
													Some(error):
														CompilerResolvedTypeRejected([error])
													None:
														CompilerResolvedTypeReady(
															CompilerIntrinsicTypeShape(
																intrinsic,
																resolved_args,
															),
														)
											None:
												CompilerResolvedTypeRejected(
													[
														CompilerTypeHeaderUnknownType(
															context.owner,
															name,
														),
													],
												)


private pure func resolve_qualified_named_type(
	context: CompilerTypeResolutionContext,
	qualifier: String,
	name: String,
	args: List[ParsedTypeExpr],
) -> CompilerResolvedTypeResult:
	match resolve_type_exprs(context, args):
		CompilerResolvedTypesRejected(errors):
			CompilerResolvedTypeRejected(errors)
		CompilerResolvedTypesReady(resolved_args):
			match compiler_module_view_find_module_alias(
				compiler_bound_module_view(context.module),
				qualifier,
			):
				None:
					CompilerResolvedTypeRejected(
						[CompilerTypeHeaderUnknownQualifier(context.owner, qualifier)],
					)
				Some(module_path):
					match declared_type_at_path(context, module_path, name):
						Err(error):
							CompilerResolvedTypeRejected([error])
						Ok(skeleton):
							resolved_skeleton_type(
								context,
								skeleton,
								qualifier + "." + name,
								resolved_args,
							)


private pure func combine_binary_dimension(
	op: ParsedDimBinaryOp,
	left: CompilerResolvedTypeResult,
	right: CompilerResolvedTypeResult,
) -> CompilerResolvedTypeResult:
	match (left, right):
		(CompilerResolvedTypeReady(left_shape), CompilerResolvedTypeReady(right_shape)):
			CompilerResolvedTypeReady(
				CompilerDimensionBinaryShape(
					parsed_dim_op(op),
					left_shape,
					right_shape,
				),
			)
		(CompilerResolvedTypeRejected(left_errors), CompilerResolvedTypeRejected(right_errors)):
			CompilerResolvedTypeRejected(left_errors.concat(right_errors))
		(CompilerResolvedTypeRejected(errors), _):
			CompilerResolvedTypeRejected(errors)
		(_, CompilerResolvedTypeRejected(errors)):
			CompilerResolvedTypeRejected(errors)


private pure func map_single_shape(
	result: CompilerResolvedTypeResult,
	mapper: pure (CompilerResolvedTypeShape) -> CompilerResolvedTypeShape,
) -> CompilerResolvedTypeResult:
	match result:
		CompilerResolvedTypeReady(shape):
			CompilerResolvedTypeReady(mapper(shape))
		CompilerResolvedTypeRejected(errors):
			CompilerResolvedTypeRejected(errors)


private pure func resolve_type_expr(
	context: CompilerTypeResolutionContext,
	type_expr: ParsedTypeExpr,
) -> CompilerResolvedTypeResult:
	match type_expr:
		ParsedNamedType(name, args, _):
			resolve_named_type(context, name.text, args)
		ParsedQualifiedNamedType(qualifier, name, args, _):
			resolve_qualified_named_type(context, qualifier.text, name.text, args)
		ParsedBoundedType(name, _, _):
			match type_parameter_by_name(context.parameters, name.text):
				Some(parameter_id):
					CompilerResolvedTypeReady(CompilerTypeParameterShape(parameter_id))
				None:
					CompilerResolvedTypeRejected(
						[CompilerTypeHeaderUnknownTypeParameter(context.owner, name.text)],
					)
		ParsedDimNameType(name, is_variadic, _):
			match type_parameter_by_name(context.parameters, name.text):
				Some(parameter_id):
					CompilerResolvedTypeReady(
						CompilerDimensionParameterShape(
							parameter_id,
							is_variadic,
						),
					)
				None:
					CompilerResolvedTypeRejected(
						[CompilerTypeHeaderUnknownTypeParameter(context.owner, name.text)],
					)
		ParsedDimLiteralType(value, _):
			match value.parse_int():
				Some(number):
					CompilerResolvedTypeReady(CompilerDimensionLiteralShape(number))
				None:
					CompilerResolvedTypeRejected(
						[CompilerTypeHeaderInvalidDimension(context.owner, value)],
					)
		ParsedDimBinaryType(op, left, right, _):
			combine_binary_dimension(
				op,
				resolve_type_expr(context, left),
				resolve_type_expr(context, right),
			)
		ParsedRangeType(inner, _):
			map_single_shape(
				resolve_type_expr(
					context,
					inner,
				),
				func(shape): CompilerRangeTypeShape(shape),
			)
		ParsedTupleType(elements, _):
			match resolve_type_exprs(context, elements):
				CompilerResolvedTypesReady(shapes):
					CompilerResolvedTypeReady(CompilerTupleTypeShape(shapes))
				CompilerResolvedTypesRejected(errors):
					CompilerResolvedTypeRejected(errors)
		ParsedFunctionType(is_pure, params, return_type, _):
			match (resolve_type_exprs(context, params), resolve_type_expr(context, return_type)):
				(CompilerResolvedTypesReady(param_shapes), CompilerResolvedTypeReady(return_shape)):
					CompilerResolvedTypeReady(
						CompilerFunctionTypeShape(
							is_pure,
							param_shapes,
							return_shape,
						),
					)
				(CompilerResolvedTypesRejected(errors), CompilerResolvedTypeRejected(return_errors)):
					CompilerResolvedTypeRejected(errors.concat(return_errors))
				(CompilerResolvedTypesRejected(errors), _):
					CompilerResolvedTypeRejected(errors)
				(_, CompilerResolvedTypeRejected(errors)):
					CompilerResolvedTypeRejected(errors)
		ParsedArrayType(element, dims, _):
			match (resolve_type_expr(context, element), resolve_type_exprs(context, dims)):
				(CompilerResolvedTypeReady(element_shape), CompilerResolvedTypesReady(dim_shapes)):
					CompilerResolvedTypeReady(CompilerArrayTypeShape(element_shape, dim_shapes))
				(CompilerResolvedTypeRejected(errors), CompilerResolvedTypesRejected(dim_errors)):
					CompilerResolvedTypeRejected(errors.concat(dim_errors))
				(CompilerResolvedTypeRejected(errors), _):
					CompilerResolvedTypeRejected(errors)
				(_, CompilerResolvedTypesRejected(errors)):
					CompilerResolvedTypeRejected(errors)
		ParsedMissingType(_):
			CompilerResolvedTypeRejected([CompilerTypeHeaderMissingType(context.owner)])


private pure func resolve_fields(
	context: CompilerTypeResolutionContext,
	fields: List[ParsedFieldDecl],
) -> Result[List[CompilerTypeHeaderField], List[CompilerTypeHeaderError]]:
	var resolved: List[CompilerTypeHeaderField] = []
	var errors: List[CompilerTypeHeaderError] = []
	definition_index = compiler_indexed_graph_definition_index(
		compiler_bound_module_graph_indexed_graph(context.bound_graph),
	)

	for field in fields:
		match resolve_type_expr(context, field.type_expr):
			CompilerResolvedTypeReady(shape):
				resolved = resolved.append({
					name = field.name.text,
					typ = shape,
					definition_id = compiler_definition_index_find_source_definition_id(
						definition_index,
						compiler_source_definition_key(
							compiler_type_id_module_identity(context.owner),
							CompilerFieldDefinition,
							field.name.text,
							Some(compiler_type_id_name(context.owner)),
							field.span,
						),
					),
				})
			CompilerResolvedTypeRejected(field_errors):
				errors = errors.concat(field_errors)

	if errors.is_empty():
		Ok(resolved)
	else:
		Err(errors)


private pure func constructor_for_variant(
	declaration_graph: CompilerDeclarationSkeletonGraph,
	parent_type_id: CompilerTypeId,
	variant: ParsedVariantDecl,
) -> Option[CompilerConstructorId]:
	var result: Option[CompilerConstructorId] = None

	for constructor in compiler_declaration_skeleton_graph_constructor_skeletons(declaration_graph):
		if (
			compiler_type_ids_equal(constructor.parent_type_id, parent_type_id)
			and constructor.source.name.text == variant.name.text
			and compiler_source_spans_equal(constructor.source.span, variant.span)
		):
			result = Some(constructor.id)
			break

	result


private pure func resolve_variants(
	context: CompilerTypeResolutionContext,
	variants: List[ParsedVariantDecl],
) -> Result[List[CompilerTypeHeaderVariant], List[CompilerTypeHeaderError]]:
	var resolved: List[CompilerTypeHeaderVariant] = []
	var errors: List[CompilerTypeHeaderError] = []
	var tag: Int = 0

	for variant in variants:
		constructor = constructor_for_variant(context.declaration_graph, context.owner, variant)
		fields = resolve_type_exprs(context, variant.fields)

		match (constructor, fields):
			(Some(constructor_id), CompilerResolvedTypesReady(field_shapes)):
				resolved = resolved.append({
					id = constructor_id,
					parent_type_id = context.owner,
					name = variant.name.text,
					tag = tag,
					fields = field_shapes,
				})
			(None, CompilerResolvedTypesReady(_)):
				errors = errors.append(
					CompilerTypeHeaderConstructorMissing(
						context.owner,
						variant.name.text,
					),
				)
			(Some(_), CompilerResolvedTypesRejected(field_errors)):
				errors = errors.concat(field_errors)
			(None, CompilerResolvedTypesRejected(field_errors)):
				errors = errors
					.append(CompilerTypeHeaderConstructorMissing(context.owner, variant.name.text))
					.concat(field_errors)

		tag += 1

	if errors.is_empty():
		Ok(resolved)
	else:
		Err(errors)


private pure func resource_cleanup_policy(
	cleanup: Option[ParsedResourceCleanup],
) -> CompilerResourceCleanupPolicy:
	match cleanup:
		Some(value):
			CompilerResourceWithCleanup(value.builtin_name)
		None:
			CompilerResourceWithoutCleanup


private pure func build_record_header(
	context: CompilerTypeResolutionContext,
	parameters: List[CompilerResolvedTypeParameter],
	decl: ParsedRecordDecl,
) -> CompilerTypeHeaderBuildResult:
	var errors: List[CompilerTypeHeaderError] = []

	if decl.is_struct and not parameters.is_empty():
		errors = errors.append(CompilerTypeHeaderInvalidStructTypeParameters(context.owner))

	if decl.is_struct and decl.fields.is_empty():
		errors = errors.append(CompilerTypeHeaderEmptyStruct(context.owner))

	match resolve_fields(context, decl.fields):
		Err(field_errors):
			CompilerTypeHeaderRejected(errors.concat(field_errors))
		Ok(fields):
			if errors.is_empty():
				layout = if decl.is_struct:
					CompilerValueStruct
				else:
					CompilerHeapRecord

				CompilerTypeHeaderReady({
					id = context.owner,
					parameters = parameters,
					shape = CompilerRecordTypeHeader(layout, fields),
					contains_resource = False,
				})
			else:
				CompilerTypeHeaderRejected(errors)


private pure func build_union_header(
	context: CompilerTypeResolutionContext,
	parameters: List[CompilerResolvedTypeParameter],
	decl: ParsedUnionDecl,
) -> CompilerTypeHeaderBuildResult:
	var errors: List[CompilerTypeHeaderError] = []

	if decl.is_enum and not parameters.is_empty():
		errors = errors.append(CompilerTypeHeaderInvalidEnumTypeParameters(context.owner))

	if decl.is_enum:
		for variant in decl.variants:
			if not variant.fields.is_empty():
				errors = errors.append(
					CompilerTypeHeaderInvalidEnumVariantFields(
						context.owner,
						variant.name.text,
					),
				)

	match resolve_variants(context, decl.variants):
		Err(variant_errors):
			CompilerTypeHeaderRejected(errors.concat(variant_errors))
		Ok(variants):
			if errors.is_empty():
				layout = if decl.is_enum:
					CompilerFieldlessEnum
				else:
					CompilerTaggedUnion

				CompilerTypeHeaderReady({
					id = context.owner,
					parameters = parameters,
					shape = CompilerUnionTypeHeader(layout, variants),
					contains_resource = False,
				})
			else:
				CompilerTypeHeaderRejected(errors)


private pure func build_builtin_header(
	context: CompilerTypeResolutionContext,
	parameters: List[CompilerResolvedTypeParameter],
	decl: ParsedBuiltinTypeDecl,
) -> CompilerTypeHeaderBuildResult:
	layout: CompilerBuiltinTypeLayout = if decl.is_resource:
		CompilerResourceBuiltin(resource_cleanup_policy(decl.cleanup))
	else:
		match compiler_builtin_value_storage(
			compiler_bound_module_program(context.module).source.module_name,
			compiler_type_id_name(context.owner),
		):
			Some(CompilerBuiltinInlineScalar):
				CompilerScalarBuiltin
			Some(CompilerBuiltinManagedReference):
				CompilerManagedBuiltin
			Some(CompilerBuiltinNoValue):
				CompilerNoValueBuiltin
			None:
				CompilerUnclassifiedBuiltin

	CompilerTypeHeaderReady({
		id = context.owner,
		parameters = parameters,
		shape = CompilerBuiltinTypeHeader(layout),
		contains_resource = decl.is_resource,
	})


private pure func build_alias_header(
	context: CompilerTypeResolutionContext,
	parameters: List[CompilerResolvedTypeParameter],
	decl: ParsedTypeAliasDecl,
) -> CompilerTypeHeaderBuildResult:
	match resolve_type_expr(context, decl.target):
		CompilerResolvedTypeRejected(errors):
			CompilerTypeHeaderRejected(errors)
		CompilerResolvedTypeReady(target):
			layout = if decl.is_opaque:
				CompilerOpaqueAlias
			else:
				CompilerTransparentAlias

			CompilerTypeHeaderReady({
				id = context.owner,
				parameters = parameters,
				shape = CompilerAliasTypeHeader(layout, target),
				contains_resource = False,
			})


private pure func build_type_header(
	parameter_graph: CompilerResolvedTypeParameterGraph,
	skeleton: CompilerTypeDeclarationSkeletonInfo,
) -> CompilerTypeHeaderBuildResult:
	declaration_graph = compiler_acyclic_type_alias_dependency_graph_declaration_graph(
		compiler_resolved_type_parameter_graph_alias_dependencies(parameter_graph),
	)
	bound_graph = compiler_declaration_skeleton_graph_bound_graph(declaration_graph)

	match compiler_bound_module_graph_find(
		bound_graph,
		compiler_type_id_module_identity(skeleton.id),
	):
		None:
			CompilerTypeHeaderRejected([CompilerTypeHeaderOwnerModuleMissing(skeleton.id)])
		Some(module):
			match compiler_resolved_type_parameter_graph_find(parameter_graph, skeleton.id):
				None:
					CompilerTypeHeaderRejected([CompilerTypeHeaderParametersMissing(skeleton.id)])
				Some(parameter_entry):
					context: CompilerTypeResolutionContext = {
						declaration_graph = declaration_graph,
						bound_graph = bound_graph,
						module = module,
						owner = skeleton.id,
						parameters = parameter_entry.parameters
					}

					match skeleton.source:
						CompilerRecordTypeSource(decl):
							build_record_header(context, parameter_entry.parameters, decl)
						CompilerUnionTypeSource(decl):
							build_union_header(context, parameter_entry.parameters, decl)
						CompilerBuiltinTypeSource(decl):
							build_builtin_header(context, parameter_entry.parameters, decl)
						CompilerAliasTypeSource(decl):
							build_alias_header(context, parameter_entry.parameters, decl)


private pure func type_header_table(headers: List[CompilerTypeHeader]) -> CompilerTypeHeaderTable:
	var header_indices_by_name: Dict[String, List[Int]] = {}
	var index: Int = 0

	for header in headers:
		name = compiler_type_id_name(header.id)
		header_indices_by_name = header_indices_by_name.set(
			name,
			header_indices_by_name
				.get_or(name, [])
				.append(index),
		)
		index += 1

	{
		headers = headers,
		header_indices_by_name = header_indices_by_name
	}


private pure func type_header_table_find_index(
	table: CompilerTypeHeaderTable,
	id: CompilerTypeId,
) -> Option[Int]:
	var result: Option[Int] = None

	for index in table.header_indices_by_name.get_or(compiler_type_id_name(id), []):
		match table.headers.get(index):
			Some(header):
				if compiler_type_ids_equal(header.id, id):
					result = Some(index)
					break
			None:
				void

	result


private pure func type_header_table_find(
	table: CompilerTypeHeaderTable,
	id: CompilerTypeId,
) -> Option[CompilerTypeHeader]:
	index ?= type_header_table_find_index(table, id)
	table.headers.get(index)


private record CompilerTypeShapeSubstitution {
	parameter: CompilerTypeParameterId,
	replacement: CompilerResolvedTypeShape
}


private pure func type_shape_substitution_find(
	substitutions: List[CompilerTypeShapeSubstitution],
	parameter: CompilerTypeParameterId,
) -> Option[CompilerResolvedTypeShape]:
	var result: Option[CompilerResolvedTypeShape] = None

	for substitution in substitutions:
		if compiler_type_parameter_ids_equal(substitution.parameter, parameter):
			result = Some(substitution.replacement)
			break

	result


private pure func resolved_shape_is_valid_struct_field(
	table: CompilerTypeHeaderTable,
	shape: CompilerResolvedTypeShape,
	substitutions: List[CompilerTypeShapeSubstitution],
) -> Bool:
	-- Alias cycles have already been rejected by the dependency graph. Walk
	-- the remaining single-target alias chain iteratively so a deep valid chain
	-- cannot exhaust the compiler stack.
	var current = shape
	var current_substitutions = substitutions
	var valid: Bool = False
	var complete: Bool = False

	while not complete:
		match current:
			CompilerIntrinsicTypeShape(intrinsic, args):
				valid = args.is_empty() and intrinsic_is_struct_scalar(intrinsic)
				complete = True
			CompilerPreludeTypeShape(prelude_type, args):
				valid = (
					args.is_empty()
					and compiler_prelude_type_has_inline_value_storage(prelude_type)
				)

				complete = True
			CompilerDeclaredTypeShape(id, args):
				match type_header_table_find(table, id):
					Some(header):
						match header.shape:
							CompilerBuiltinTypeHeader(CompilerScalarBuiltin):
								valid = args.is_empty()
								complete = True
							CompilerUnionTypeHeader(CompilerFieldlessEnum, _):
								valid = args.is_empty()
								complete = True
							CompilerRecordTypeHeader(CompilerValueStruct, _):
								valid = args.is_empty()
								complete = True
							CompilerAliasTypeHeader(_, target):
								match type_shape_substitutions(
									header.parameters,
									args,
									current_substitutions,
								):
									Some(alias_substitutions):
										current = target
										current_substitutions = alias_substitutions
									None:
										complete = True
							_:
								complete = True
					None:
						complete = True
			CompilerTypeParameterShape(parameter):
				match type_shape_substitution_find(current_substitutions, parameter):
					Some(replacement):
						current = replacement
					None:
						complete = True
			_:
				complete = True

	valid


private pure func invalid_struct_field_errors(
	table: CompilerTypeHeaderTable,
) -> List[CompilerTypeHeaderError]:
	var errors: List[CompilerTypeHeaderError] = []

	for header in table.headers:
		match header.shape:
			CompilerRecordTypeHeader(CompilerValueStruct, fields):
				for field in fields:
					if not resolved_shape_is_valid_struct_field(table, field.typ, []):
						errors = errors.append(
							CompilerTypeHeaderInvalidStructField(
								header.id,
								field.name,
							),
						)
			_:
				void

	errors


private pure func type_shape_substitutions(
	parameters: List[CompilerResolvedTypeParameter],
	args: List[CompilerResolvedTypeShape],
	parent: List[CompilerTypeShapeSubstitution],
) -> Option[List[CompilerTypeShapeSubstitution]]:
	if parameters.length() != args.length():
		None
	else:
		-- An inner instantiation of the same generic declaration must shadow its
		-- outer parameter mapping, as in `Box[Box[Int]]`.
		var result: List[CompilerTypeShapeSubstitution] = []
		var index: Int = 0

		while index < parameters.length():
			match (parameters.get(index), args.get(index)):
				(Some(parameter), Some(replacement)):
					result = result.append({
						parameter = parameter.id,
						replacement = replacement,
					})
				_:
					void

			index += 1

		Some(result.concat(parent))


private record CompilerPendingValueLayoutShape {
	shape: CompilerResolvedTypeShape,
	substitutions: List[CompilerTypeShapeSubstitution]
}


private pure func pending_record_fields(
	fields: List[CompilerTypeHeaderField],
	substitutions: List[CompilerTypeShapeSubstitution],
) -> List[CompilerPendingValueLayoutShape]:
	var pending: List[CompilerPendingValueLayoutShape] = []

	for field in fields:
		pending = pending.append({
			shape = field.typ,
			substitutions = substitutions,
		})

	pending


private pure func bool_at(values: List[Bool], index: Int) -> Bool:
	values
		.get(index)
		.get_or(False)


private record CompilerValueLayoutSummary {
	dependencies: List[Int],
	required_parameters: List[CompilerTypeParameterId]
}


private pure func append_unique_int(values: List[Int], value: Int) -> List[Int]:
	if values.contains(value):
		values
	else:
		values.append(value)


private pure func append_unique_type_parameter(
	values: List[CompilerTypeParameterId],
	value: CompilerTypeParameterId,
) -> List[CompilerTypeParameterId]:
	var present: Bool = False

	for existing in values:
		if compiler_type_parameter_ids_equal(existing, value):
			present = True
			break

	if present:
		values
	else:
		values.append(value)


private pure func append_value_layout_work(
	work: List[CompilerPendingValueLayoutShape],
	shapes: List[CompilerResolvedTypeShape],
	substitutions: List[CompilerTypeShapeSubstitution],
) -> List[CompilerPendingValueLayoutShape]:
	var result = work

	for shape in shapes:
		result = result.append({
			shape = shape,
			substitutions = substitutions,
		})

	result


private pure func empty_value_layout_summaries(
	table: CompilerTypeHeaderTable,
) -> List[CompilerValueLayoutSummary]:
	var summaries: List[CompilerValueLayoutSummary] = []

	for _ in table.headers:
		summaries = summaries.append({
			dependencies = [],
			required_parameters = [],
		})

	summaries


private pure func value_layout_summary_at(
	summaries: List[CompilerValueLayoutSummary],
	index: Int,
) -> CompilerValueLayoutSummary:
	summaries
		.get(index)
		.get_or({
			dependencies = [],
			required_parameters = [],
		})


private pure func record_value_layout_summary(
	table: CompilerTypeHeaderTable,
	summaries: List[CompilerValueLayoutSummary],
	fields: List[CompilerTypeHeaderField],
	initial: CompilerValueLayoutSummary,
) -> CompilerValueLayoutSummary:
	-- A generic argument contributes to product layout only when the referenced
	-- record requires that parameter inline. This distinguishes finite
	-- `Box[Box[Int]]` nesting from `Loop { value: Box[Loop] }`.
	var result = initial
	var work = pending_record_fields(fields, [])
	var work_index: Int = 0

	while work_index < work.length():
		match work.get(work_index):
			None:
				void
			Some(item):
				match item.shape:
					CompilerDeclaredTypeShape(id, args):
						match type_header_table_find_index(table, id):
							None:
								void
							Some(header_index):
								match table.headers.get(header_index):
									None:
										void
									Some(header):
										match header.shape:
											CompilerRecordTypeHeader(_, _):
												result = { result |
													dependencies = append_unique_int(
														result.dependencies,
														header_index,
													)
												}

												match type_shape_substitutions(
													header.parameters,
													args,
													item.substitutions,
												):
													Some(child_substitutions):
														callee = value_layout_summary_at(
															summaries,
															header_index,
														)

														for parameter in callee.required_parameters:
															match type_shape_substitution_find(
																child_substitutions,
																parameter,
															):
																Some(replacement):
																	work = append_value_layout_work(
																		work,
																		[replacement],
																		child_substitutions,
																	)
																None:
																	void
													None:
														void
											CompilerAliasTypeHeader(_, target):
												match type_shape_substitutions(
													header.parameters,
													args,
													item.substitutions,
												):
													Some(alias_substitutions):
														work = append_value_layout_work(
															work,
															[target],
															alias_substitutions,
														)
													None:
														void
											_:
												void
					CompilerTypeParameterShape(parameter):
						match type_shape_substitution_find(item.substitutions, parameter):
							Some(replacement):
								work = append_value_layout_work(
									work,
									[replacement],
									item.substitutions,
								)
							None:
								result = { result |
									required_parameters = append_unique_type_parameter(
										result.required_parameters,
										parameter,
									)
								}
					CompilerSelfTypeShape(id):
						match type_header_table_find_index(table, id):
							Some(header_index):
								result = { result |
									dependencies = append_unique_int(
										result.dependencies,
										header_index,
									)
								}
							None:
								void
					CompilerTupleTypeShape(elements):
						work = append_value_layout_work(work, elements, item.substitutions)
					_:
						void

		work_index += 1

	result


private pure func value_layout_references(
	table: CompilerTypeHeaderTable,
	fields: List[CompilerTypeHeaderField],
) -> List[Int]:
	-- This conservative reference set drives only worklist invalidation. It may
	-- include a generic argument that later proves non-mandatory, but it never
	-- changes the computed dependency graph.
	var references: List[Int] = []
	var work = pending_record_fields(fields, [])
	var work_index: Int = 0

	while work_index < work.length():
		match work.get(work_index):
			Some(item):
				match item.shape:
					CompilerDeclaredTypeShape(id, args):
						match type_header_table_find_index(table, id):
							Some(header_index):
								match table.headers.get(header_index):
									Some(header):
										match header.shape:
											CompilerRecordTypeHeader(_, _):
												references = append_unique_int(
													references,
													header_index,
												)
												work = append_value_layout_work(
													work,
													args,
													item.substitutions,
												)
											CompilerAliasTypeHeader(_, target):
												match type_shape_substitutions(
													header.parameters,
													args,
													item.substitutions,
												):
													Some(alias_substitutions):
														work = append_value_layout_work(
															work,
															[target],
															alias_substitutions,
														)
													None:
														void
											_:
												void
									None:
										void
							None:
								void
					CompilerTypeParameterShape(parameter):
						match type_shape_substitution_find(item.substitutions, parameter):
							Some(replacement):
								work = append_value_layout_work(
									work,
									[replacement],
									item.substitutions,
								)
							None:
								void
					CompilerSelfTypeShape(id):
						match type_header_table_find_index(table, id):
							Some(header_index):
								references = append_unique_int(references, header_index)
							None:
								void
					CompilerTupleTypeShape(elements):
						work = append_value_layout_work(work, elements, item.substitutions)
					_:
						void
			None:
				void

		work_index += 1

	references


private pure func empty_int_lists(length: Int) -> List[List[Int]]:
	var result: List[List[Int]] = []
	var index: Int = 0

	while index < length:
		result = result.append([])
		index += 1

	result


private pure func value_layout_summary_consumers(table: CompilerTypeHeaderTable) -> List[List[Int]]:
	var consumers = empty_int_lists(table.headers.length())
	var owner_index: Int = 0

	for header in table.headers:
		match header.shape:
			CompilerRecordTypeHeader(_, fields):
				for dependency in value_layout_references(table, fields):
					match consumers.get(dependency):
						Some(existing):
							consumers = consumers.set(
								dependency,
								append_unique_int(existing, owner_index),
							)
						None:
							void
			_:
				void

		owner_index += 1

	consumers


private pure func complete_value_layout_summaries(
	table: CompilerTypeHeaderTable,
) -> List[CompilerValueLayoutSummary]:
	-- Summaries grow monotonically over finite declaration and parameter sets,
	-- so this worklist terminates without a heuristic pass limit.
	consumers = value_layout_summary_consumers(table)
	var summaries = empty_value_layout_summaries(table)
	var queued = False.repeat(table.headers.length())
	var queue: List[Int] = []
	var queue_index: Int = 0
	var index: Int = 0

	for header in table.headers:
		match header.shape:
			CompilerRecordTypeHeader(_, _):
				queue = queue.append(index)
				queued = queued.set(index, True)
			_:
				void

		index += 1

	while queue_index < queue.length():
		match queue.get(queue_index):
			Some(header_index):
				queued = queued.set(header_index, False)

				match table.headers.get(header_index):
					Some(header):
						match header.shape:
							CompilerRecordTypeHeader(_, fields):
								before = value_layout_summary_at(summaries, header_index)
								after = record_value_layout_summary(
									table,
									summaries,
									fields,
									before,
								)

								if (
									before.dependencies.length() != after.dependencies.length()
									or before.required_parameters.length() != after.required_parameters.length()
								):
									summaries = summaries.set(header_index, after)

									for consumer in (
										consumers
											.get(header_index)
											.get_or([])
									):
										if not bool_at(queued, consumer):
											queue = queue.append(consumer)
											queued = queued.set(consumer, True)
							_:
								void
					None:
						void
			None:
				void

		queue_index += 1

	summaries


private pure func recursive_value_layout_errors(
	table: CompilerTypeHeaderTable,
) -> List[CompilerTypeHeaderError]:
	-- Kahn elimination leaves exactly records in mandatory product cycles and
	-- records that depend on those cycles. Collections, functions, and unions
	-- never enter this graph because they provide indirection or a base case.
	summaries = complete_value_layout_summaries(table)
	var errors: List[CompilerTypeHeaderError] = []
	var unresolved = 0.repeat(table.headers.length())
	var dependents = empty_int_lists(table.headers.length())
	var queue: List[Int] = []
	var queue_index: Int = 0
	var index: Int = 0

	for header in table.headers:
		match header.shape:
			CompilerRecordTypeHeader(_, _):
				summary = value_layout_summary_at(summaries, index)
				unresolved = unresolved.set(index, summary.dependencies.length())

				for dependency in summary.dependencies:
					match dependents.get(dependency):
						Some(existing):
							dependents = dependents.set(
								dependency,
								existing.append(index),
							)
						None:
							void
			_:
				void

		index += 1

	index = 0

	for header in table.headers:
		match header.shape:
			CompilerRecordTypeHeader(_, _):
				if (
					unresolved
						.get(index)
						.get_or(0) == 0
				):
					queue = queue.append(index)
			_:
				void

		index += 1

	while queue_index < queue.length():
		match queue.get(queue_index):
			Some(completed_index):
				for dependent in (
					dependents
						.get(completed_index)
						.get_or([])
				):
					remaining = unresolved
						.get(dependent)
						.get_or(0) - 1
					unresolved = unresolved.set(dependent, remaining)

					if remaining == 0:
						queue = queue.append(dependent)
			None:
				void

		queue_index += 1

	index = 0

	for header in table.headers:
		match header.shape:
			CompilerRecordTypeHeader(_, _):
				if (
					unresolved
						.get(index)
						.get_or(0) > 0
				):
					errors = errors.append(
						CompilerTypeHeaderRecursiveValueLayout(
							header.id,
							value_layout_summary_at(summaries, index).dependencies.contains(index),
						),
					)
			_:
				void

		index += 1

	errors


private pure func resolved_shape_contains_resource(
	table: CompilerTypeHeaderTable,
	shape: CompilerResolvedTypeShape,
) -> Bool:
	match shape:
		CompilerDeclaredTypeShape(id, args):
			(
				type_header_table_find(table, id)
					.map(func(header): header.contains_resource)
					.get_or(False)
				or args.any(func(arg): resolved_shape_contains_resource(table, arg))
			)
		CompilerIntrinsicTypeShape(_, args):
			args.any(func(arg): resolved_shape_contains_resource(table, arg))
		CompilerPreludeTypeShape(prelude_type, args):
			(
				compiler_prelude_type_is_resource(prelude_type)
				or args.any(func(arg): resolved_shape_contains_resource(table, arg))
			)
		CompilerTypeParameterShape(_):
			False
		CompilerSelfTypeShape(id):
			type_header_table_find(table, id)
				.map(func(header): header.contains_resource)
				.get_or(False)
		CompilerDimensionParameterShape(_, _):
			False
		CompilerDimensionLiteralShape(_):
			False
		CompilerDimensionBinaryShape(_, left, right):
			(
				resolved_shape_contains_resource(table, left)
				or resolved_shape_contains_resource(table, right)
			)
		CompilerRangeTypeShape(inner):
			resolved_shape_contains_resource(table, inner)
		CompilerTupleTypeShape(elements):
			elements.any(func(element): resolved_shape_contains_resource(table, element))
		CompilerFunctionTypeShape(_, params, return_type):
			(
				params.any(func(param): resolved_shape_contains_resource(table, param))
				or resolved_shape_contains_resource(table, return_type)
			)
		CompilerArrayTypeShape(element, dims):
			(
				resolved_shape_contains_resource(table, element)
				or dims.any(func(dim): resolved_shape_contains_resource(table, dim))
			)


private pure func header_shape_contains_resource(
	table: CompilerTypeHeaderTable,
	shape: CompilerTypeHeaderShape,
) -> Bool:
	match shape:
		CompilerRecordTypeHeader(_, fields):
			fields.any(func(field): resolved_shape_contains_resource(table, field.typ))
		CompilerUnionTypeHeader(_, variants):
			variants.any(func(variant):
				variant.fields.any(func(field): resolved_shape_contains_resource(table, field))
			)
		CompilerBuiltinTypeHeader(layout):
			match layout:
				CompilerResourceBuiltin(_):
					True
				CompilerScalarBuiltin | CompilerManagedBuiltin | CompilerNoValueBuiltin | CompilerUnclassifiedBuiltin:
					False
		CompilerAliasTypeHeader(_, target):
			resolved_shape_contains_resource(table, target)


private pure func complete_resource_containment(
	table: CompilerTypeHeaderTable,
) -> CompilerTypeHeaderTable:
	var result = table
	var changed: Bool = True
	var remaining_passes: Int = table.headers.length()

	while changed and remaining_passes > 0:
		changed = False
		var index: Int = 0

		for header in result.headers:
			contains_resource = (
				header.contains_resource
				or header_shape_contains_resource(result, header.shape)
			)

			if contains_resource != header.contains_resource:
				result = { result |
					headers = result.headers.set(
						index,
						{ header | contains_resource = contains_resource },
					)
				}
				changed = True

			index += 1

		remaining_passes -= 1

	result


pure func compiler_type_header_graph_build(
	parameter_graph: CompilerResolvedTypeParameterGraph,
) -> Result[CompilerTypeHeaderGraph, List[CompilerTypeHeaderError]]:
	declaration_graph = compiler_acyclic_type_alias_dependency_graph_declaration_graph(
		compiler_resolved_type_parameter_graph_alias_dependencies(parameter_graph),
	)
	var headers: List[CompilerTypeHeader] = []
	var errors: List[CompilerTypeHeaderError] = []

	for skeleton in compiler_declaration_skeleton_graph_type_skeletons(declaration_graph):
		match build_type_header(parameter_graph, skeleton):
			CompilerTypeHeaderReady(header):
				headers = headers.append(header)
			CompilerTypeHeaderRejected(header_errors):
				errors = errors.concat(header_errors)

	if not errors.is_empty():
		Err(errors)
	else:
		table = type_header_table(headers)
		struct_field_errors = invalid_struct_field_errors(table)
		recursive_layout_errors = recursive_value_layout_errors(table)
		validation_errors = struct_field_errors.concat(recursive_layout_errors)

		if not validation_errors.is_empty():
			Err(validation_errors)
		else:
			completed_table = complete_resource_containment(table)

			representation: CompilerTypeHeaderGraphRep = {
				parameter_graph = parameter_graph,
				table = completed_table
			}
			Ok(into CompilerTypeHeaderGraph(representation))


private pure func type_header_graph_rep(
	graph: CompilerTypeHeaderGraph,
) -> CompilerTypeHeaderGraphRep:
	from CompilerTypeHeaderGraph(graph)


pure func compiler_type_header_graph_parameter_graph(
	graph: CompilerTypeHeaderGraph,
) -> CompilerResolvedTypeParameterGraph:
	type_header_graph_rep(graph).parameter_graph


pure func compiler_type_header_graph_headers(
	graph: CompilerTypeHeaderGraph,
) -> List[CompilerTypeHeader]:
