enum CompilerIntrinsicType:
	CompilerIntrinsicInt
	CompilerIntrinsicFloat
	CompilerIntrinsicBool
	CompilerIntrinsicString
	CompilerIntrinsicLiteralString
	CompilerIntrinsicChar
	CompilerIntrinsicVoid
	CompilerIntrinsicBytes
	CompilerIntrinsicPtr
	CompilerIntrinsicFixed
	CompilerIntrinsicInt8
	CompilerIntrinsicInt16
	CompilerIntrinsicInt32
	CompilerIntrinsicInt64
	CompilerIntrinsicInt128
	CompilerIntrinsicUInt8
	CompilerIntrinsicUInt16
	CompilerIntrinsicUInt32
	CompilerIntrinsicUInt64
	CompilerIntrinsicUInt128
	CompilerIntrinsicFloat32
	CompilerIntrinsicFloat16
	CompilerIntrinsicTensor
	CompilerIntrinsicOption
	CompilerIntrinsicResult
	CompilerIntrinsicConcurrencyError
	CompilerIntrinsicTaskResult
	CompilerIntrinsicChannel


enum CompilerResolvedDimOp:
	CompilerResolvedDimAdd
	CompilerResolvedDimSubtract
	CompilerResolvedDimMultiply
	CompilerResolvedDimDivide


private record CompilerTraitTypeParameterIdRep {
	owner: CompilerTraitId,
	index: Int,
	name: String
}


opaque type CompilerTraitTypeParameterId = CompilerTraitTypeParameterIdRep


private record CompilerCallableTypeParameterIdRep {
	owner: CompilerCallableId,
	index: Int,
	name: String
}


opaque type CompilerCallableTypeParameterId = CompilerCallableTypeParameterIdRep


private record CompilerImplementationTypeParameterIdRep {
	owner: CompilerImplId,
	index: Int,
	name: String
}


opaque type CompilerImplementationTypeParameterId = CompilerImplementationTypeParameterIdRep


union CompilerResolvedTypeShape:
	CompilerDeclaredTypeShape(CompilerTypeId, List[CompilerResolvedTypeShape])
	CompilerIntrinsicTypeShape(CompilerIntrinsicType, List[CompilerResolvedTypeShape])
	CompilerPreludeTypeShape(CompilerPreludeType, List[CompilerResolvedTypeShape])
	CompilerTypeParameterShape(CompilerTypeParameterId)
	CompilerSelfTypeShape(CompilerTypeId)
	CompilerTraitTypeParameterShape(CompilerTraitTypeParameterId)
	CompilerCallableTypeParameterShape(CompilerCallableTypeParameterId)
	CompilerImplementationTypeParameterShape(CompilerImplementationTypeParameterId)
	CompilerTraitSelfTypeShape(CompilerTraitId)
	CompilerDimensionParameterShape(CompilerTypeParameterId, Bool)
	CompilerTraitDimensionParameterShape(CompilerTraitTypeParameterId, Bool)
	CompilerCallableDimensionParameterShape(CompilerCallableTypeParameterId, Bool)
	CompilerImplementationDimensionParameterShape(CompilerImplementationTypeParameterId, Bool)
	CompilerWildcardDimensionShape(Bool)
	CompilerDimensionLiteralShape(Int)
	CompilerDimensionBinaryShape(CompilerResolvedDimOp, CompilerResolvedTypeShape, CompilerResolvedTypeShape)
	CompilerRangeTypeShape(CompilerResolvedTypeShape)
	CompilerTupleTypeShape(List[CompilerResolvedTypeShape])
	CompilerFunctionTypeShape(Bool, List[CompilerResolvedTypeShape], CompilerResolvedTypeShape)
	CompilerArrayTypeShape(CompilerResolvedTypeShape, List[CompilerResolvedTypeShape])


union CompilerTypeResolutionOwner:
	CompilerTypeDeclarationResolutionOwner(CompilerTypeId)
	CompilerTraitMethodResolutionOwner(CompilerTraitMethodId)
	CompilerCallableResolutionOwner(CompilerCallableId)
	CompilerGlobalResolutionOwner(CompilerGlobalId)
	CompilerImplementationResolutionOwner(CompilerImplId)
	CompilerImplementationMethodResolutionOwner(CompilerImplId, CompilerCallableId, CompilerResolvedTypeShape)


private union CompilerResolutionTypeParameter:
	CompilerTypeDeclarationResolutionParameter(CompilerTypeParameterId)
	CompilerTraitResolutionParameter(CompilerTraitTypeParameterId)
	CompilerCallableResolutionParameter(CompilerCallableTypeParameterId)
	CompilerImplementationResolutionParameter(CompilerImplementationTypeParameterId)


union CompilerTypeShapeResolutionError:
	CompilerTypeShapeOwnerModuleMissing(CompilerTypeResolutionOwner, CompilerSourceSpan)
	CompilerTypeShapeForeignTraitParameter(CompilerTypeResolutionOwner, CompilerTraitTypeParameterId, CompilerSourceSpan)
	CompilerTypeShapeForeignCallableParameter(CompilerTypeResolutionOwner, CompilerCallableTypeParameterId, CompilerSourceSpan)
	CompilerTypeShapeForeignImplementationParameter(CompilerTypeResolutionOwner, CompilerImplementationTypeParameterId, CompilerSourceSpan)
	CompilerTypeShapeUnknownType(CompilerTypeResolutionOwner, String, CompilerSourceSpan)
	CompilerTypeShapeUnknownQualifier(CompilerTypeResolutionOwner, String, CompilerSourceSpan)
	CompilerTypeShapeImportedModuleMissing(CompilerTypeResolutionOwner, String, CompilerSourceSpan)
	CompilerTypeShapePrivateTypeReference(CompilerTypeResolutionOwner, CompilerTypeId, CompilerSourceSpan)
	CompilerTypeShapeArityMismatch(CompilerTypeResolutionOwner, String, Int, Int, CompilerSourceSpan)
	CompilerTypeShapeUnknownTypeParameter(CompilerTypeResolutionOwner, String, CompilerSourceSpan)
	CompilerTypeShapeInvalidDimension(CompilerTypeResolutionOwner, String, CompilerSourceSpan)
	CompilerTypeShapeMissingType(CompilerTypeResolutionOwner, CompilerSourceSpan)
	CompilerTypeShapeSelfNotAllowed(CompilerTypeResolutionOwner, CompilerSourceSpan)


enum CompilerRecordLayout:
	CompilerHeapRecord
	CompilerValueStruct


enum CompilerUnionLayout:
	CompilerTaggedUnion
	CompilerFieldlessEnum


enum CompilerAliasLayout:
	CompilerTransparentAlias
	CompilerOpaqueAlias


union CompilerResourceCleanupPolicy:
	CompilerResourceWithoutCleanup
	CompilerResourceWithCleanup(String)


-- Builtin declarations carry storage ownership explicitly after header
-- resolution, and installation preserves scalar storage in Env. Core still
-- has a transitional name-based ABI projection; do not add another frontend
-- name list while that representation boundary is being retired.
union CompilerBuiltinTypeLayout:
	CompilerScalarBuiltin
	CompilerManagedBuiltin
	CompilerNoValueBuiltin
	CompilerUnclassifiedBuiltin
	CompilerResourceBuiltin(CompilerResourceCleanupPolicy)


record CompilerTypeHeaderField {
	name: String,
	typ: CompilerResolvedTypeShape,
	definition_id: Option[Int]
}


record CompilerTypeHeaderVariant {
	id: CompilerConstructorId,
	parent_type_id: CompilerTypeId,
	name: String,
	tag: Int,
	fields: List[CompilerResolvedTypeShape]
}


union CompilerTypeHeaderShape:
	CompilerRecordTypeHeader(CompilerRecordLayout, List[CompilerTypeHeaderField])
	CompilerUnionTypeHeader(CompilerUnionLayout, List[CompilerTypeHeaderVariant])
	CompilerBuiltinTypeHeader(CompilerBuiltinTypeLayout)
	CompilerAliasTypeHeader(CompilerAliasLayout, CompilerResolvedTypeShape)


union CompilerDeclaredTypeExpansion:
	CompilerNominalDeclaredType
	CompilerTransparentAliasExpansion(List[CompilerResolvedTypeParameter], CompilerResolvedTypeShape)


record CompilerTypeHeader {
	id: CompilerTypeId,
	parameters: List[CompilerResolvedTypeParameter],
	shape: CompilerTypeHeaderShape,
	contains_resource: Bool
}


-- Category-specific projection used by environment installation. A caller
-- holding this value cannot accidentally install a record, union, or alias as
-- a builtin type.
private record CompilerAcceptedBuiltinHeaderRep {
	id: CompilerTypeId,
	parameters: List[CompilerResolvedTypeParameter],
	layout: CompilerBuiltinTypeLayout
}


opaque type CompilerAcceptedBuiltinHeader = CompilerAcceptedBuiltinHeaderRep


-- Category-specific projection used by environment installation. Resolved
-- field types retain declaration identities until the installation boundary;
-- callers cannot construct or accidentally pass another header category.
private record CompilerAcceptedRecordHeaderRep {
	id: CompilerTypeId,
	parameters: List[CompilerResolvedTypeParameter],
	layout: CompilerRecordLayout,
	fields: List[CompilerTypeHeaderField],
	contains_resource: Bool
}


opaque type CompilerAcceptedRecordHeader = CompilerAcceptedRecordHeaderRep


-- Constructor identity, tag, and payload shape remain one value through the
-- installation boundary, so the transitional Env cannot observe independently
-- reordered constructor-ID and variant lists.
private record CompilerAcceptedUnionHeaderRep {
	id: CompilerTypeId,
	parameters: List[CompilerResolvedTypeParameter],
	layout: CompilerUnionLayout,
	variants: List[CompilerTypeHeaderVariant],
	contains_resource: Bool
}


opaque type CompilerAcceptedUnionHeader = CompilerAcceptedUnionHeaderRep


-- Alias layout and target remain coupled in the accepted projection. This
-- prevents installation from treating a transparent alias as nominal or an
-- opaque alias as expandable.
private record CompilerAcceptedAliasHeaderRep {
	id: CompilerTypeId,
	parameters: List[CompilerResolvedTypeParameter],
	layout: CompilerAliasLayout,
	target: CompilerResolvedTypeShape
}


opaque type CompilerAcceptedAliasHeader = CompilerAcceptedAliasHeaderRep


private enum CompilerHeaderVisibilitySelection:
	CompilerAllModuleHeaders
	CompilerPublicModuleHeaders


-- Header order remains graph order inside both inventories. The public subset
-- is derived from exact declaration identities when the table is built, so
-- projection cannot disagree with declaration visibility later.
private record CompilerModuleTypeHeaderIndices {
	all_indices: List[Int],
	public_indices: List[Int]
}


-- This must remain ARC-managed: its fields own heap containers, and the table
-- is itself embedded in CompilerTypeHeaderGraphRep.
private record CompilerTypeHeaderTable {
	headers: List[CompilerTypeHeader],
	header_indices_by_name: Dict[String, List[Int]],
	header_indices_by_module: Dict[String, CompilerModuleTypeHeaderIndices]
}


private record CompilerTypeHeaderGraphRep {
	parameter_graph: CompilerResolvedTypeParameterGraph,
	table: CompilerTypeHeaderTable
}


opaque type CompilerTypeHeaderGraph = CompilerTypeHeaderGraphRep


union CompilerTypeHeaderError:
	CompilerTypeHeaderOwnerModuleMissing(CompilerTypeId)
	CompilerTypeHeaderParametersMissing(CompilerTypeId)
	CompilerTypeHeaderResolutionError(CompilerTypeShapeResolutionError)
	CompilerTypeHeaderConstructorMissing(CompilerTypeId, String)
	CompilerTypeHeaderInvalidEnumTypeParameters(CompilerTypeId)
	CompilerTypeHeaderInvalidEnumVariantFields(CompilerTypeId, String)
	CompilerTypeHeaderInvalidStructTypeParameters(CompilerTypeId)
	CompilerTypeHeaderEmptyStruct(CompilerTypeId)
	CompilerTypeHeaderInvalidStructField(CompilerTypeId, String)
	CompilerTypeHeaderRecursiveValueLayout(CompilerTypeId, Bool)
	CompilerTypeHeaderInlineStorageCycle(List[CompilerTypeId])


private record CompilerLayoutTypeSubstitution {
	parameter: CompilerTypeParameterId,
	replacement: CompilerResolvedTypeShape
}


private record CompilerInlineLayoutDependency {
	id: CompilerTypeId,
	dependency_indices: List[Int]
}


private enum CompilerInlineLayoutVisitState:
	CompilerInlineLayoutUnvisited
	CompilerInlineLayoutVisiting
	CompilerInlineLayoutComplete


private record CompilerInlineLayoutFrame {
	node_index: Int,
	next_dependency_index: Int
}


private record CompilerTypeResolutionContext {
	declaration_graph: CompilerDeclarationSkeletonGraph,
	bound_graph: CompilerBoundModuleGraph,
	module: CompilerBoundModule,
	owner: CompilerTypeResolutionOwner,
	parameters: List[CompilerResolutionTypeParameter]
}


-- Only the constructor in this module can wrap a generic resolution context
-- as callable-owned. Callers can therefore reuse it without repeating owner,
-- parameter, or module validation for every type expression in one signature.
opaque type CompilerCallableTypeResolutionContext = CompilerTypeResolutionContext


private record CompilerTypeHeaderBuildContext {
	owner: CompilerTypeId,
	resolution: CompilerTypeResolutionContext
}


private union CompilerResolvedTypeResult:
	CompilerResolvedTypeReady(CompilerResolvedTypeShape)
	CompilerResolvedTypeRejected(List[CompilerTypeShapeResolutionError])


private union CompilerResolvedTypesResult:
	CompilerResolvedTypesReady(List[CompilerResolvedTypeShape])
	CompilerResolvedTypesRejected(List[CompilerTypeShapeResolutionError])


private union CompilerTypeHeaderBuildResult:
	CompilerTypeHeaderReady(CompilerTypeHeader)
	CompilerTypeHeaderRejected(List[CompilerTypeHeaderError])


pure func compiler_trait_type_parameter_ids(
	owner: CompilerTraitId,
	names: List[String],
) -> List[CompilerTraitTypeParameterId]:
	var result: List[CompilerTraitTypeParameterId] = []
	var index: Int = 0

	for name in names:
		id: CompilerTraitTypeParameterId = into CompilerTraitTypeParameterId({
			owner = owner,
			index = index,
			name = name,
		})
		result = result.append(id)
		index += 1

	result


private pure func compiler_trait_type_parameter_id_rep(
	id: CompilerTraitTypeParameterId,
) -> CompilerTraitTypeParameterIdRep:
	from CompilerTraitTypeParameterId(id)


pure func compiler_trait_type_parameter_id_owner(
	id: CompilerTraitTypeParameterId,
) -> CompilerTraitId:
	compiler_trait_type_parameter_id_rep(id).owner


pure func compiler_trait_type_parameter_id_index(id: CompilerTraitTypeParameterId) -> Int:
	compiler_trait_type_parameter_id_rep(id).index


pure func compiler_trait_type_parameter_id_name(id: CompilerTraitTypeParameterId) -> String:
	compiler_trait_type_parameter_id_rep(id).name


pure func compiler_trait_type_parameter_ids_equal(
	left: CompilerTraitTypeParameterId,
	right: CompilerTraitTypeParameterId,
) -> Bool:
	(
		compiler_trait_ids_equal(
			compiler_trait_type_parameter_id_owner(left),
			compiler_trait_type_parameter_id_owner(right),
		)
		and compiler_trait_type_parameter_id_index(
			left,
		) == compiler_trait_type_parameter_id_index(right)
	)


pure func compiler_callable_type_parameter_ids(
	owner: CompilerCallableId,
	names: List[String],
) -> List[CompilerCallableTypeParameterId]:
	var result: List[CompilerCallableTypeParameterId] = []
	var index: Int = 0

	for name in names:
		id: CompilerCallableTypeParameterId = into CompilerCallableTypeParameterId({
			owner = owner,
			index = index,
			name = name,
		})
		result = result.append(id)
		index += 1

	result


private pure func compiler_callable_type_parameter_id_rep(
	id: CompilerCallableTypeParameterId,
) -> CompilerCallableTypeParameterIdRep:
	from CompilerCallableTypeParameterId(id)


pure func compiler_callable_type_parameter_id_owner(
	id: CompilerCallableTypeParameterId,
) -> CompilerCallableId:
	compiler_callable_type_parameter_id_rep(id).owner


pure func compiler_callable_type_parameter_id_index(id: CompilerCallableTypeParameterId) -> Int:
	compiler_callable_type_parameter_id_rep(id).index


pure func compiler_callable_type_parameter_id_name(id: CompilerCallableTypeParameterId) -> String:
	compiler_callable_type_parameter_id_rep(id).name


pure func compiler_callable_type_parameter_ids_equal(
	left: CompilerCallableTypeParameterId,
	right: CompilerCallableTypeParameterId,
) -> Bool:
	left_rep = compiler_callable_type_parameter_id_rep(left)
	right_rep = compiler_callable_type_parameter_id_rep(right)

	(
		compiler_callable_ids_equal(left_rep.owner, right_rep.owner)
		and left_rep.index == right_rep.index
		and left_rep.name == right_rep.name
	)


pure func compiler_implementation_type_parameter_ids(
	owner: CompilerImplId,
	names: List[String],
) -> List[CompilerImplementationTypeParameterId]:
	var result: List[CompilerImplementationTypeParameterId] = []
	var index: Int = 0

	for name in names:
		id: CompilerImplementationTypeParameterId = into CompilerImplementationTypeParameterId({
			owner = owner,
			index = index,
			name = name,
		})
		result = result.append(id)
		index += 1

	result


private pure func compiler_implementation_type_parameter_id_rep(
	id: CompilerImplementationTypeParameterId,
) -> CompilerImplementationTypeParameterIdRep:
	from CompilerImplementationTypeParameterId(id)


pure func compiler_implementation_type_parameter_id_owner(
	id: CompilerImplementationTypeParameterId,
) -> CompilerImplId:
	compiler_implementation_type_parameter_id_rep(id).owner


pure func compiler_implementation_type_parameter_id_index(
	id: CompilerImplementationTypeParameterId,
) -> Int:
	compiler_implementation_type_parameter_id_rep(id).index


pure func compiler_implementation_type_parameter_id_name(
	id: CompilerImplementationTypeParameterId,
) -> String:
	compiler_implementation_type_parameter_id_rep(id).name


pure func compiler_implementation_type_parameter_ids_equal(
	left: CompilerImplementationTypeParameterId,
	right: CompilerImplementationTypeParameterId,
) -> Bool:
	left_rep = compiler_implementation_type_parameter_id_rep(left)
	right_rep = compiler_implementation_type_parameter_id_rep(right)

	(
		compiler_impl_ids_equal(left_rep.owner, right_rep.owner)
		and left_rep.index == right_rep.index
		and left_rep.name == right_rep.name
	)


private pure func resolution_parameter_name(parameter: CompilerResolutionTypeParameter) -> String:
	match parameter:
		CompilerTypeDeclarationResolutionParameter(id):
			compiler_type_parameter_id_name(id)
		CompilerTraitResolutionParameter(id):
			compiler_trait_type_parameter_id_name(id)
		CompilerCallableResolutionParameter(id):
			compiler_callable_type_parameter_id_name(id)
		CompilerImplementationResolutionParameter(id):
			compiler_implementation_type_parameter_id_name(id)


private pure func resolution_parameter_shape(
	parameter: CompilerResolutionTypeParameter,
) -> CompilerResolvedTypeShape:
	match parameter:
		CompilerTypeDeclarationResolutionParameter(id):
			CompilerTypeParameterShape(id)
		CompilerTraitResolutionParameter(id):
			CompilerTraitTypeParameterShape(id)
		CompilerCallableResolutionParameter(id):
			CompilerCallableTypeParameterShape(id)
		CompilerImplementationResolutionParameter(id):
			CompilerImplementationTypeParameterShape(id)


private pure func resolution_owner_self_shape(
	owner: CompilerTypeResolutionOwner,
) -> Option[CompilerResolvedTypeShape]:
	match owner:
		CompilerTypeDeclarationResolutionOwner(id):
			Some(CompilerSelfTypeShape(id))
		CompilerTraitMethodResolutionOwner(method_id):
			Some(CompilerTraitSelfTypeShape(compiler_trait_method_id_owner(method_id)))
		CompilerCallableResolutionOwner(_):
			None
		CompilerGlobalResolutionOwner(_):
			None
		CompilerImplementationResolutionOwner(_):
			None
		CompilerImplementationMethodResolutionOwner(_, _, receiver):
			Some(receiver)


private pure func type_header_resolution_errors(
	errors: List[CompilerTypeShapeResolutionError],
) -> List[CompilerTypeHeaderError]:
	errors.map(func(error): CompilerTypeHeaderResolutionError(error))


private pure func compiler_intrinsic_type(name: String) -> Option[CompilerIntrinsicType]:
	match name:
		"Int":
			Some(CompilerIntrinsicInt)
		"Float":
			Some(CompilerIntrinsicFloat)
		"Bool":
			Some(CompilerIntrinsicBool)
		"String":
			Some(CompilerIntrinsicString)
		"LiteralString":
			Some(CompilerIntrinsicLiteralString)
		"Char":
			Some(CompilerIntrinsicChar)
		"Void":
			Some(CompilerIntrinsicVoid)
		"Bytes":
			Some(CompilerIntrinsicBytes)
		"Ptr":
			Some(CompilerIntrinsicPtr)
		"Fixed":
			Some(CompilerIntrinsicFixed)
		"Int8":
			Some(CompilerIntrinsicInt8)
		"Int16":
			Some(CompilerIntrinsicInt16)
		"Int32":
			Some(CompilerIntrinsicInt32)
		"Int64":
			Some(CompilerIntrinsicInt64)
		"Int128":
			Some(CompilerIntrinsicInt128)
		"UInt8":
			Some(CompilerIntrinsicUInt8)
		"UInt16":
			Some(CompilerIntrinsicUInt16)
		"UInt32":
			Some(CompilerIntrinsicUInt32)
		"UInt64":
			Some(CompilerIntrinsicUInt64)
		"UInt128":
			Some(CompilerIntrinsicUInt128)
		"Float32":
			Some(CompilerIntrinsicFloat32)
		"Float16":
			Some(CompilerIntrinsicFloat16)
		"Tensor":
			Some(CompilerIntrinsicTensor)
		"Option":
			Some(CompilerIntrinsicOption)
		"Result":
			Some(CompilerIntrinsicResult)
		"ConcurrencyError":
			Some(CompilerIntrinsicConcurrencyError)
		"TaskResult":
			Some(CompilerIntrinsicTaskResult)
		"Channel":
			Some(CompilerIntrinsicChannel)
		_:
			None


private pure func intrinsic_is_struct_scalar(intrinsic: CompilerIntrinsicType) -> Bool:
	match intrinsic:
		CompilerIntrinsicInt:
			True
		CompilerIntrinsicFloat:
			True
		CompilerIntrinsicBool:
			True
		CompilerIntrinsicChar:
			True
		CompilerIntrinsicPtr:
			True
		CompilerIntrinsicInt8:
			True
		CompilerIntrinsicInt16:
			True
		CompilerIntrinsicInt32:
			True
		CompilerIntrinsicInt64:
			True
		CompilerIntrinsicInt128:
			True
		CompilerIntrinsicUInt8:
			True
		CompilerIntrinsicUInt16:
			True
		CompilerIntrinsicUInt32:
			True
		CompilerIntrinsicUInt64:
			True
		CompilerIntrinsicUInt128:
			True
		CompilerIntrinsicFloat32:
			True
		CompilerIntrinsicFloat16:
			True
		_:
			False


private pure func compiler_intrinsic_type_arity(typ: CompilerIntrinsicType) -> Int:
	match typ:
		CompilerIntrinsicTensor:
			1
		CompilerIntrinsicOption:
			1
		CompilerIntrinsicResult:
			2
		CompilerIntrinsicTaskResult:
			1
		CompilerIntrinsicChannel:
			1
		_:
			0


pure func compiler_intrinsic_type_name(typ: CompilerIntrinsicType) -> String:
	match typ:
		CompilerIntrinsicInt:
			"Int"
		CompilerIntrinsicFloat:
			"Float"
		CompilerIntrinsicBool:
			"Bool"
		CompilerIntrinsicString:
			"String"
		CompilerIntrinsicLiteralString:
			"LiteralString"
		CompilerIntrinsicChar:
			"Char"
		CompilerIntrinsicVoid:
			"Void"
		CompilerIntrinsicBytes:
			"Bytes"
		CompilerIntrinsicPtr:
			"Ptr"
		CompilerIntrinsicFixed:
			"Fixed"
		CompilerIntrinsicInt8:
			"Int8"
		CompilerIntrinsicInt16:
			"Int16"
		CompilerIntrinsicInt32:
			"Int32"
		CompilerIntrinsicInt64:
			"Int64"
		CompilerIntrinsicInt128:
			"Int128"
		CompilerIntrinsicUInt8:
			"UInt8"
		CompilerIntrinsicUInt16:
			"UInt16"
		CompilerIntrinsicUInt32:
			"UInt32"
		CompilerIntrinsicUInt64:
			"UInt64"
		CompilerIntrinsicUInt128:
			"UInt128"
		CompilerIntrinsicFloat32:
			"Float32"
		CompilerIntrinsicFloat16:
			"Float16"
		CompilerIntrinsicTensor:
			"Tensor"
		CompilerIntrinsicOption:
			"Option"
		CompilerIntrinsicResult:
			"Result"
		CompilerIntrinsicConcurrencyError:
			"ConcurrencyError"
		CompilerIntrinsicTaskResult:
			"TaskResult"
		CompilerIntrinsicChannel:
			"Channel"


private pure func type_parameter_by_name(
	parameters: List[CompilerResolutionTypeParameter],
	name: String,
) -> Option[CompilerResolutionTypeParameter]:
	var result: Option[CompilerResolutionTypeParameter] = None

	for parameter in parameters:
		if resolution_parameter_name(parameter) == name:
			result = Some(parameter)
			break

	result


private pure func parsed_dim_op(op: ParsedDimBinaryOp) -> CompilerResolvedDimOp:
	match op:
		ParsedDimAddOp:
			CompilerResolvedDimAdd
		ParsedDimSubtractOp:
			CompilerResolvedDimSubtract
		ParsedDimMultiplyOp:
			CompilerResolvedDimMultiply
		ParsedDimDivideOp:
			CompilerResolvedDimDivide


private pure func parsed_type_parameter_count(skeleton: CompilerTypeDeclarationSkeletonInfo) -> Int:
	match skeleton.source:
		CompilerRecordTypeSource(decl):
			decl.type_params.length()
		CompilerUnionTypeSource(decl):
			decl.type_params.length()
		CompilerBuiltinTypeSource(decl):
			decl.type_params.length()
		CompilerAliasTypeSource(decl):
			decl.type_params.length()


private pure func declared_type_at_path(
	context: CompilerTypeResolutionContext,
	module_path: String,
	name: String,
	span: CompilerSourceSpan,
) -> Result[CompilerTypeDeclarationSkeletonInfo, CompilerTypeShapeResolutionError]:
	match compiler_bound_module_graph_find_canonical_path(context.bound_graph, module_path):
		None:
			Err(CompilerTypeShapeImportedModuleMissing(context.owner, module_path, span))
		Some(module):
			match compiler_declaration_skeleton_graph_find_type(
				context.declaration_graph,
				compiler_bound_module_identity(module),
				name,
			):
				None:
					Err(CompilerTypeShapeUnknownType(context.owner, name, span))
				Some(skeleton):
					if (
						skeleton.visibility == CompilerPrivateDeclaration
						and not compiler_module_identities_equal(
							compiler_bound_module_identity(context.module),
							compiler_bound_module_identity(module),
						)
					):
						Err(CompilerTypeShapePrivateTypeReference(context.owner, skeleton.id, span))
					else:
						Ok(skeleton)


private pure func declared_unqualified_type(
	context: CompilerTypeResolutionContext,
	name: String,
	span: CompilerSourceSpan,
) -> Result[Option[CompilerTypeDeclarationSkeletonInfo], CompilerTypeShapeResolutionError]:
	match compiler_declaration_skeleton_graph_find_type(
		context.declaration_graph,
		compiler_bound_module_identity(context.module),
		name,
	):
		Some(local):
			Ok(Some(local))
		None:
			match compiler_module_view_find_imported_name(
				compiler_bound_module_view(context.module),
				name,
			):
				None:
					Ok(None)
				Some(binding):
					is_prelude_binding = match compiler_prelude_type(name):
						Some(prelude_type):
							(
								binding.original_name == name
								and binding.module_path == compiler_prelude_type_module_path(
									prelude_type,
								)
							)
						None:
							False

					is_intrinsic_binding = (
						binding.original_name == name
						and compiler_intrinsic_type(name).is_some()
					)

					if (
						is_intrinsic_binding
						or (
							is_prelude_binding
							and compiler_bound_module_graph_find_canonical_path(
								context.bound_graph,
								binding.module_path,
							).is_none()
						)
					):
						Ok(None)
					else:
						match declared_type_at_path(
							context,
							binding.module_path,
							binding.original_name,
							span,
						):
							Ok(skeleton):
								Ok(Some(skeleton))
							Err(error):
								Err(error)


private pure func validate_type_arity(
	owner: CompilerTypeResolutionOwner,
	name: String,
	expected: Int,
	args: List[CompilerResolvedTypeShape],
	span: CompilerSourceSpan,
) -> Option[CompilerTypeShapeResolutionError]:
	if expected == args.length():
		None
	else:
		Some(CompilerTypeShapeArityMismatch(owner, name, expected, args.length(), span))


private pure func resolved_skeleton_type(
	context: CompilerTypeResolutionContext,
	skeleton: CompilerTypeDeclarationSkeletonInfo,
	name: String,
	args: List[CompilerResolvedTypeShape],
	span: CompilerSourceSpan,
) -> CompilerResolvedTypeResult:
	match validate_type_arity(
		context.owner,
		name,
		parsed_type_parameter_count(skeleton),
		args,
		span,
	):
		Some(error):
			CompilerResolvedTypeRejected([error])
		None:
			CompilerResolvedTypeReady(CompilerDeclaredTypeShape(skeleton.id, args))


private pure func resolved_implicit_prelude_type(
	context: CompilerTypeResolutionContext,
	name: String,
	args: List[CompilerResolvedTypeShape],
	span: CompilerSourceSpan,
) -> Option[CompilerResolvedTypeResult]:
	match compiler_prelude_type(name):
		None:
			None
		Some(prelude_type):
			match validate_type_arity(
				context.owner,
				name,
				compiler_prelude_type_arity(prelude_type),
				args,
				span,
			):
				Some(error):
					Some(CompilerResolvedTypeRejected([error]))
				None:
					Some(CompilerResolvedTypeReady(CompilerPreludeTypeShape(prelude_type, args)))


-- Implicit callable parameters are admitted only for names that have no
-- semantic type binding in the callable's module. A present but invalid import
-- still reserves the name so the later resolver reports the import error
-- instead of silently changing it into a generic parameter.
pure func compiler_type_header_graph_has_unqualified_type_name(
	graph: CompilerTypeHeaderGraph,
	module: CompilerBoundModule,
	name: String,
) -> Bool:
	declaration_graph = compiler_type_header_graph_declaration_graph(graph)
	bound_graph = compiler_type_header_graph_bound_graph(graph)

	match compiler_declaration_skeleton_graph_find_type(
		declaration_graph,
		compiler_bound_module_identity(module),
		name,
	):
		Some(_):
			True
		None:
			match compiler_module_view_find_imported_name(compiler_bound_module_view(module), name):
				Some(_):
					True
				None:
					compiler_prelude_type(name).is_some() or compiler_intrinsic_type(name).is_some()


private pure func resolve_type_exprs(
	context: CompilerTypeResolutionContext,
	types: List[ParsedTypeExpr],
) -> CompilerResolvedTypesResult:
	var resolved: List[CompilerResolvedTypeShape] = []
	var errors: List[CompilerTypeShapeResolutionError] = []

	for typ in types:
		match resolve_type_expr(context, typ):
			CompilerResolvedTypeReady(shape):
				resolved = resolved.append(shape)
			CompilerResolvedTypeRejected(type_errors):
				errors = errors.concat(type_errors)

	if errors.is_empty():
		CompilerResolvedTypesReady(resolved)
	else:
		CompilerResolvedTypesRejected(errors)


private pure func resolve_named_type(
	context: CompilerTypeResolutionContext,
	name: String,
	args: List[ParsedTypeExpr],
	span: CompilerSourceSpan,
) -> CompilerResolvedTypeResult:
	match resolve_type_exprs(context, args):
		CompilerResolvedTypesRejected(errors):
			CompilerResolvedTypeRejected(errors)
		CompilerResolvedTypesReady(resolved_args):
			if name == "Self" and resolved_args.is_empty():
				match resolution_owner_self_shape(context.owner):
					Some(shape):
						CompilerResolvedTypeReady(shape)
					None:
						CompilerResolvedTypeRejected(
							[CompilerTypeShapeSelfNotAllowed(context.owner, span)],
						)
			else:
				match type_parameter_by_name(context.parameters, name):
					Some(parameter):
						match validate_type_arity(context.owner, name, 0, resolved_args, span):
							Some(error):
								CompilerResolvedTypeRejected([error])
							None:
								CompilerResolvedTypeReady(resolution_parameter_shape(parameter))
					None:
						match declared_unqualified_type(context, name, span):
							Err(error):
								CompilerResolvedTypeRejected([error])
							Ok(Some(skeleton)):
								resolved_skeleton_type(context, skeleton, name, resolved_args, span)
							Ok(None):
								match resolved_implicit_prelude_type(
									context,
									name,
									resolved_args,
									span,
								):
									Some(result):
										result
									None:
										match compiler_intrinsic_type(name):
											Some(intrinsic):
												match validate_type_arity(
													context.owner,
													name,
													compiler_intrinsic_type_arity(intrinsic),
													resolved_args,
													span,
												):
													Some(error):
														CompilerResolvedTypeRejected([error])
													None:
														CompilerResolvedTypeReady(
															CompilerIntrinsicTypeShape(
																intrinsic,
																resolved_args,
															),
														)
											None:
												CompilerResolvedTypeRejected(
													[
														CompilerTypeShapeUnknownType(
															context.owner,
															name,
															span,
														),
													],
												)


private pure func resolve_qualified_named_type(
	context: CompilerTypeResolutionContext,
	qualifier: String,
	name: String,
	args: List[ParsedTypeExpr],
	span: CompilerSourceSpan,
) -> CompilerResolvedTypeResult:
	match resolve_type_exprs(context, args):
		CompilerResolvedTypesRejected(errors):
			CompilerResolvedTypeRejected(errors)
		CompilerResolvedTypesReady(resolved_args):
			match compiler_module_view_find_module_alias(
				compiler_bound_module_view(context.module),
				qualifier,
			):
				None:
					CompilerResolvedTypeRejected(
						[CompilerTypeShapeUnknownQualifier(context.owner, qualifier, span)],
					)
				Some(module_path):
					match declared_type_at_path(context, module_path, name, span):
						Err(error):
							CompilerResolvedTypeRejected([error])
						Ok(skeleton):
							resolved_skeleton_type(
								context,
								skeleton,
								qualifier + "." + name,
								resolved_args,
								span,
							)


private pure func combine_binary_dimension(
	op: ParsedDimBinaryOp,
	left: CompilerResolvedTypeResult,
	right: CompilerResolvedTypeResult,
) -> CompilerResolvedTypeResult:
	match (left, right):
		(CompilerResolvedTypeReady(left_shape), CompilerResolvedTypeReady(right_shape)):
			CompilerResolvedTypeReady(
				CompilerDimensionBinaryShape(
					parsed_dim_op(op),
					left_shape,
					right_shape,
				),
			)
		(CompilerResolvedTypeRejected(left_errors), CompilerResolvedTypeRejected(right_errors)):
			CompilerResolvedTypeRejected(left_errors.concat(right_errors))
		(CompilerResolvedTypeRejected(errors), _):
			CompilerResolvedTypeRejected(errors)
		(_, CompilerResolvedTypeRejected(errors)):
			CompilerResolvedTypeRejected(errors)


private pure func map_single_shape(
	result: CompilerResolvedTypeResult,
	mapper: pure (CompilerResolvedTypeShape) -> CompilerResolvedTypeShape,
) -> CompilerResolvedTypeResult:
	match result:
		CompilerResolvedTypeReady(shape):
			CompilerResolvedTypeReady(mapper(shape))
		CompilerResolvedTypeRejected(errors):
			CompilerResolvedTypeRejected(errors)


private pure func resolve_type_expr(
	context: CompilerTypeResolutionContext,
	type_expr: ParsedTypeExpr,
) -> CompilerResolvedTypeResult:
	match type_expr:
		ParsedNamedType(name, args, span):
			resolve_named_type(context, name.text, args, span)
		ParsedQualifiedNamedType(qualifier, name, args, span):
			resolve_qualified_named_type(context, qualifier.text, name.text, args, span)
		ParsedBoundedType(name, _, span):
			match type_parameter_by_name(context.parameters, name.text):
				Some(parameter):
					CompilerResolvedTypeReady(resolution_parameter_shape(parameter))
				None:
					CompilerResolvedTypeRejected(
						[CompilerTypeShapeUnknownTypeParameter(context.owner, name.text, span)],
					)
		ParsedDimNameType(name, is_variadic, span):
			if name.text == "#_":
				CompilerResolvedTypeReady(CompilerWildcardDimensionShape(is_variadic))
			else:
				match type_parameter_by_name(context.parameters, name.text):
					Some(CompilerTypeDeclarationResolutionParameter(parameter_id)):
						CompilerResolvedTypeReady(
							CompilerDimensionParameterShape(
								parameter_id,
								is_variadic,
							),
						)
					Some(CompilerTraitResolutionParameter(parameter_id)):
						CompilerResolvedTypeReady(
							CompilerTraitDimensionParameterShape(
								parameter_id,
								is_variadic,
							),
						)
					Some(CompilerCallableResolutionParameter(parameter_id)):
						CompilerResolvedTypeReady(
							CompilerCallableDimensionParameterShape(
								parameter_id,
								is_variadic,
							),
						)
					Some(CompilerImplementationResolutionParameter(parameter_id)):
						CompilerResolvedTypeReady(
							CompilerImplementationDimensionParameterShape(
								parameter_id,
								is_variadic,
							),
						)
					None:
						CompilerResolvedTypeRejected(
							[
								CompilerTypeShapeUnknownTypeParameter(
									context.owner,
									name.text,
									span,
								),
							],
						)
		ParsedDimLiteralType(value, span):
			match value.parse_int():
				Some(number):
					CompilerResolvedTypeReady(CompilerDimensionLiteralShape(number))
				None:
					CompilerResolvedTypeRejected(
						[CompilerTypeShapeInvalidDimension(context.owner, value, span)],
					)
		ParsedDimBinaryType(op, left, right, _):
			combine_binary_dimension(
				op,
				resolve_type_expr(context, left),
				resolve_type_expr(context, right),
			)
		ParsedRangeType(inner, _):
			map_single_shape(
				resolve_type_expr(
					context,
					inner,
				),
				func(shape): CompilerRangeTypeShape(shape),
			)
		ParsedTupleType(elements, _):
			match resolve_type_exprs(context, elements):
				CompilerResolvedTypesReady(shapes):
					CompilerResolvedTypeReady(CompilerTupleTypeShape(shapes))
				CompilerResolvedTypesRejected(errors):
					CompilerResolvedTypeRejected(errors)
		ParsedFunctionType(is_pure, params, return_type, _):
			match (resolve_type_exprs(context, params), resolve_type_expr(context, return_type)):
				(CompilerResolvedTypesReady(param_shapes), CompilerResolvedTypeReady(return_shape)):
					CompilerResolvedTypeReady(
						CompilerFunctionTypeShape(
							is_pure,
							param_shapes,
							return_shape,
						),
					)
				(CompilerResolvedTypesRejected(errors), CompilerResolvedTypeRejected(return_errors)):
					CompilerResolvedTypeRejected(errors.concat(return_errors))
				(CompilerResolvedTypesRejected(errors), _):
					CompilerResolvedTypeRejected(errors)
				(_, CompilerResolvedTypeRejected(errors)):
					CompilerResolvedTypeRejected(errors)
		ParsedArrayType(element, dims, _):
			match (resolve_type_expr(context, element), resolve_type_exprs(context, dims)):
				(CompilerResolvedTypeReady(element_shape), CompilerResolvedTypesReady(dim_shapes)):
					CompilerResolvedTypeReady(CompilerArrayTypeShape(element_shape, dim_shapes))
				(CompilerResolvedTypeRejected(errors), CompilerResolvedTypesRejected(dim_errors)):
					CompilerResolvedTypeRejected(errors.concat(dim_errors))
				(CompilerResolvedTypeRejected(errors), _):
					CompilerResolvedTypeRejected(errors)
				(_, CompilerResolvedTypesRejected(errors)):
					CompilerResolvedTypeRejected(errors)
		ParsedMissingType(span):
			CompilerResolvedTypeRejected([CompilerTypeShapeMissingType(context.owner, span)])


private pure func prepare_owned_type_resolution_context(
	graph: CompilerTypeHeaderGraph,
	owner_module_identity: CompilerModuleIdentity,
	owner: CompilerTypeResolutionOwner,
	parameters: List[CompilerResolutionTypeParameter],
	diagnostic_span: CompilerSourceSpan,
) -> Result[CompilerTypeResolutionContext, List[CompilerTypeShapeResolutionError]]:
	declaration_graph = compiler_type_header_graph_declaration_graph(graph)
	bound_graph = compiler_type_header_graph_bound_graph(graph)

	match compiler_bound_module_graph_find(bound_graph, owner_module_identity):
		None:
			Err([CompilerTypeShapeOwnerModuleMissing(owner, diagnostic_span)])
		Some(module):
			context: CompilerTypeResolutionContext = {
				declaration_graph = declaration_graph,
				bound_graph = bound_graph,
				module = module,
				owner = owner,
				parameters = parameters
			}
			Ok(context)


private pure func resolve_prepared_type_shape(
	context: CompilerTypeResolutionContext,
	type_expr: ParsedTypeExpr,
) -> Result[CompilerResolvedTypeShape, List[CompilerTypeShapeResolutionError]]:
	match resolve_type_expr(context, type_expr):
		CompilerResolvedTypeReady(shape):
			Ok(shape)
		CompilerResolvedTypeRejected(errors):
			Err(errors)


private pure func resolve_owned_type_shape(
	graph: CompilerTypeHeaderGraph,
	owner_module_identity: CompilerModuleIdentity,
	owner: CompilerTypeResolutionOwner,
	parameters: List[CompilerResolutionTypeParameter],
	type_expr: ParsedTypeExpr,
) -> Result[CompilerResolvedTypeShape, List[CompilerTypeShapeResolutionError]]:
	match prepare_owned_type_resolution_context(
		graph,
		owner_module_identity,
		owner,
		parameters,
		parsed_type_expr_span(type_expr),
	):
		Err(errors):
			Err(errors)
		Ok(context):
			resolve_prepared_type_shape(context, type_expr)


pure func compiler_prepare_callable_type_resolution_context(
	graph: CompilerTypeHeaderGraph,
	callable_id: CompilerCallableId,
	parameters: List[CompilerCallableTypeParameterId],
) -> Result[CompilerCallableTypeResolutionContext, List[CompilerTypeShapeResolutionError]]:
	owner = CompilerCallableResolutionOwner(callable_id)
	diagnostic_span = compiler_callable_id_source_span(callable_id)
	foreign_parameter = parameters.find(func(parameter):
		not compiler_callable_ids_equal(
			compiler_callable_type_parameter_id_owner(parameter),
			callable_id,
		)
	)

	match foreign_parameter:
		Some(parameter):
			Err([CompilerTypeShapeForeignCallableParameter(owner, parameter, diagnostic_span)])
		None:
			match prepare_owned_type_resolution_context(
				graph,
				compiler_callable_id_module_identity(callable_id),
				owner,
				parameters.map(func(parameter): CompilerCallableResolutionParameter(parameter)),
				diagnostic_span,
			):
				Err(errors):
					Err(errors)
				Ok(context):
					Ok(into CompilerCallableTypeResolutionContext(context))


pure func compiler_resolve_callable_type_shape_in_context(
	context: CompilerCallableTypeResolutionContext,
	type_expr: ParsedTypeExpr,
) -> Result[CompilerResolvedTypeShape, List[CompilerTypeShapeResolutionError]]:
	resolve_prepared_type_shape(from CompilerCallableTypeResolutionContext(context), type_expr)


pure func compiler_resolve_trait_method_type_shape(
	graph: CompilerTypeHeaderGraph,
	method_id: CompilerTraitMethodId,
	parameters: List[CompilerTraitTypeParameterId],
	type_expr: ParsedTypeExpr,
) -> Result[CompilerResolvedTypeShape, List[CompilerTypeShapeResolutionError]]:
	trait_id = compiler_trait_method_id_owner(method_id)
	owner = CompilerTraitMethodResolutionOwner(method_id)
	foreign_parameter = parameters.find(func(parameter):
		not compiler_trait_ids_equal(compiler_trait_type_parameter_id_owner(parameter), trait_id)
	)

	match foreign_parameter:
		Some(parameter):
			Err(
				[
					CompilerTypeShapeForeignTraitParameter(
						owner,
						parameter,
						parsed_type_expr_span(type_expr),
					),
				],
			)
		None:
			resolve_owned_type_shape(
				graph,
				compiler_trait_id_module_identity(trait_id),
				owner,
				parameters.map(func(parameter): CompilerTraitResolutionParameter(parameter)),
				type_expr,
			)


pure func compiler_resolve_global_type_shape(
	graph: CompilerTypeHeaderGraph,
	global_id: CompilerGlobalId,
	type_expr: ParsedTypeExpr,
) -> Result[CompilerResolvedTypeShape, List[CompilerTypeShapeResolutionError]]:
	resolve_owned_type_shape(
		graph,
		compiler_global_id_module_identity(global_id),
		CompilerGlobalResolutionOwner(global_id),
		[],
		type_expr,
	)


pure func compiler_resolve_implementation_type_shape(
	graph: CompilerTypeHeaderGraph,
	implementation_id: CompilerImplId,
	parameters: List[CompilerImplementationTypeParameterId],
	type_expr: ParsedTypeExpr,
) -> Result[CompilerResolvedTypeShape, List[CompilerTypeShapeResolutionError]]:
	owner = CompilerImplementationResolutionOwner(implementation_id)
	foreign_parameter = parameters.find(func(parameter):
		not compiler_impl_ids_equal(
			compiler_implementation_type_parameter_id_owner(parameter),
			implementation_id,
		)
	)

	match foreign_parameter:
		Some(parameter):
			Err(
				[
					CompilerTypeShapeForeignImplementationParameter(
						owner,
						parameter,
						parsed_type_expr_span(type_expr),
					),
				],
			)
		None:
			resolve_owned_type_shape(
				graph,
				compiler_impl_id_module_identity(implementation_id),
				owner,
				parameters.map(
					func(parameter): CompilerImplementationResolutionParameter(parameter),
				),
				type_expr,
			)


pure func compiler_resolve_implementation_method_type_shape(
	graph: CompilerTypeHeaderGraph,
	implementation_id: CompilerImplId,
	implementation_parameters: List[CompilerImplementationTypeParameterId],
	callable_id: CompilerCallableId,
	callable_parameters: List[CompilerCallableTypeParameterId],
	receiver: CompilerResolvedTypeShape,
	type_expr: ParsedTypeExpr,
) -> Result[CompilerResolvedTypeShape, List[CompilerTypeShapeResolutionError]]:
	owner = CompilerImplementationMethodResolutionOwner(implementation_id, callable_id, receiver)
	foreign_implementation_parameter = implementation_parameters.find(func(parameter):
		not compiler_impl_ids_equal(
			compiler_implementation_type_parameter_id_owner(parameter),
			implementation_id,
		)
	)
	foreign_callable_parameter = callable_parameters.find(func(parameter):
		not compiler_callable_ids_equal(
			compiler_callable_type_parameter_id_owner(parameter),
			callable_id,
		)
	)

	match (foreign_implementation_parameter, foreign_callable_parameter):
		(Some(parameter), _):
			Err(
				[
					CompilerTypeShapeForeignImplementationParameter(
						owner,
						parameter,
						parsed_type_expr_span(type_expr),
					),
				],
			)
		(_, Some(parameter)):
			Err(
				[
					CompilerTypeShapeForeignCallableParameter(
						owner,
						parameter,
						parsed_type_expr_span(type_expr),
					),
				],
			)
		(None, None):
			resolve_owned_type_shape(
				graph,
				compiler_impl_id_module_identity(implementation_id),
				owner,
				implementation_parameters
					.map(func(parameter): CompilerImplementationResolutionParameter(parameter))
					.concat(callable_parameters.map(
						func(parameter): CompilerCallableResolutionParameter(parameter),
					)),
				type_expr,
			)


private pure func resolve_fields(
	context: CompilerTypeHeaderBuildContext,
	fields: List[ParsedFieldDecl],
) -> Result[List[CompilerTypeHeaderField], List[CompilerTypeHeaderError]]:
	var resolved: List[CompilerTypeHeaderField] = []
	var errors: List[CompilerTypeHeaderError] = []
	definition_index = compiler_indexed_graph_definition_index(
		compiler_bound_module_graph_indexed_graph(context.resolution.bound_graph),
	)

	for field in fields:
		match resolve_type_expr(context.resolution, field.type_expr):
			CompilerResolvedTypeReady(shape):
				resolved = resolved.append({
					name = field.name.text,
					typ = shape,
					definition_id = compiler_definition_index_find_source_definition_id(
						definition_index,
						compiler_source_definition_key(
							compiler_type_id_module_identity(context.owner),
							CompilerFieldDefinition,
							field.name.text,
							Some(compiler_type_id_name(context.owner)),
							field.span,
						),
					),
				})
			CompilerResolvedTypeRejected(field_errors):
				errors = errors.concat(type_header_resolution_errors(field_errors))

	if errors.is_empty():
		Ok(resolved)
	else:
		Err(errors)


private pure func constructor_for_variant(
	declaration_graph: CompilerDeclarationSkeletonGraph,
	parent_type_id: CompilerTypeId,
	variant: ParsedVariantDecl,
) -> Option[CompilerConstructorId]:
	var result: Option[CompilerConstructorId] = None

	for constructor in compiler_declaration_skeleton_graph_constructor_skeletons(declaration_graph):
		if (
			compiler_type_ids_equal(constructor.parent_type_id, parent_type_id)
			and constructor.source.name.text == variant.name.text
			and compiler_source_spans_equal(constructor.source.span, variant.span)
		):
			result = Some(constructor.id)
			break

	result


private pure func resolve_variants(
	context: CompilerTypeHeaderBuildContext,
	variants: List[ParsedVariantDecl],
) -> Result[List[CompilerTypeHeaderVariant], List[CompilerTypeHeaderError]]:
	var resolved: List[CompilerTypeHeaderVariant] = []
	var errors: List[CompilerTypeHeaderError] = []
	var tag: Int = 0

	for variant in variants:
		constructor = constructor_for_variant(
			context.resolution.declaration_graph,
			context.owner,
			variant,
		)
		fields = resolve_type_exprs(context.resolution, variant.fields)

		match (constructor, fields):
			(Some(constructor_id), CompilerResolvedTypesReady(field_shapes)):
				resolved = resolved.append({
					id = constructor_id,
					parent_type_id = context.owner,
					name = variant.name.text,
					tag = tag,
					fields = field_shapes,
				})
			(None, CompilerResolvedTypesReady(_)):
				errors = errors.append(
					CompilerTypeHeaderConstructorMissing(
						context.owner,
						variant.name.text,
					),
				)
			(Some(_), CompilerResolvedTypesRejected(field_errors)):
				errors = errors.concat(type_header_resolution_errors(field_errors))
			(None, CompilerResolvedTypesRejected(field_errors)):
				errors = errors
					.append(CompilerTypeHeaderConstructorMissing(context.owner, variant.name.text))
					.concat(type_header_resolution_errors(field_errors))

		tag += 1

	if errors.is_empty():
		Ok(resolved)
	else:
		Err(errors)


private pure func resource_cleanup_policy(
	cleanup: Option[ParsedResourceCleanup],
) -> CompilerResourceCleanupPolicy:
	match cleanup:
		Some(value):
			CompilerResourceWithCleanup(value.builtin_name)
		None:
			CompilerResourceWithoutCleanup


private pure func build_record_header(
	context: CompilerTypeHeaderBuildContext,
	parameters: List[CompilerResolvedTypeParameter],
	decl: ParsedRecordDecl,
) -> CompilerTypeHeaderBuildResult:
	var errors: List[CompilerTypeHeaderError] = []

	if decl.is_struct and not parameters.is_empty():
		errors = errors.append(CompilerTypeHeaderInvalidStructTypeParameters(context.owner))

	if decl.is_struct and decl.fields.is_empty():
		errors = errors.append(CompilerTypeHeaderEmptyStruct(context.owner))

	match resolve_fields(context, decl.fields):
		Err(field_errors):
			CompilerTypeHeaderRejected(errors.concat(field_errors))
		Ok(fields):
			if errors.is_empty():
				layout = if decl.is_struct:
					CompilerValueStruct
				else:
					CompilerHeapRecord

				CompilerTypeHeaderReady({
					id = context.owner,
					parameters = parameters,
					shape = CompilerRecordTypeHeader(layout, fields),
					contains_resource = False,
				})
			else:
				CompilerTypeHeaderRejected(errors)


private pure func build_union_header(
	context: CompilerTypeHeaderBuildContext,
	parameters: List[CompilerResolvedTypeParameter],
	decl: ParsedUnionDecl,
) -> CompilerTypeHeaderBuildResult:
	var errors: List[CompilerTypeHeaderError] = []

	if decl.is_enum and not parameters.is_empty():
		errors = errors.append(CompilerTypeHeaderInvalidEnumTypeParameters(context.owner))

	if decl.is_enum:
		for variant in decl.variants:
			if not variant.fields.is_empty():
				errors = errors.append(
					CompilerTypeHeaderInvalidEnumVariantFields(
						context.owner,
						variant.name.text,
					),
				)

	match resolve_variants(context, decl.variants):
		Err(variant_errors):
			CompilerTypeHeaderRejected(errors.concat(variant_errors))
		Ok(variants):
			if errors.is_empty():
				layout = if decl.is_enum:
					CompilerFieldlessEnum
				else:
					CompilerTaggedUnion

				CompilerTypeHeaderReady({
					id = context.owner,
					parameters = parameters,
					shape = CompilerUnionTypeHeader(layout, variants),
					contains_resource = False,
				})
			else:
				CompilerTypeHeaderRejected(errors)


private pure func build_builtin_header(
	context: CompilerTypeHeaderBuildContext,
	parameters: List[CompilerResolvedTypeParameter],
	decl: ParsedBuiltinTypeDecl,
) -> CompilerTypeHeaderBuildResult:
	layout: CompilerBuiltinTypeLayout = if decl.is_resource:
		CompilerResourceBuiltin(resource_cleanup_policy(decl.cleanup))
	else:
		match compiler_builtin_value_storage(
			compiler_bound_module_program(context.resolution.module).source.module_name,
			compiler_type_id_name(context.owner),
		):
			Some(CompilerBuiltinInlineScalar):
				CompilerScalarBuiltin
			Some(CompilerBuiltinManagedReference):
				CompilerManagedBuiltin
			Some(CompilerBuiltinNoValue):
				CompilerNoValueBuiltin
			None:
				CompilerUnclassifiedBuiltin

	CompilerTypeHeaderReady({
		id = context.owner,
		parameters = parameters,
		shape = CompilerBuiltinTypeHeader(layout),
		contains_resource = decl.is_resource,
	})


private pure func build_alias_header(
	context: CompilerTypeHeaderBuildContext,
	parameters: List[CompilerResolvedTypeParameter],
	decl: ParsedTypeAliasDecl,
) -> CompilerTypeHeaderBuildResult:
	match resolve_type_expr(context.resolution, decl.target):
		CompilerResolvedTypeRejected(errors):
			CompilerTypeHeaderRejected(type_header_resolution_errors(errors))
		CompilerResolvedTypeReady(target):
			layout = if decl.is_opaque:
				CompilerOpaqueAlias
			else:
				CompilerTransparentAlias

			CompilerTypeHeaderReady({
				id = context.owner,
				parameters = parameters,
				shape = CompilerAliasTypeHeader(layout, target),
				contains_resource = False,
			})


private pure func build_type_header(
	parameter_graph: CompilerResolvedTypeParameterGraph,
	skeleton: CompilerTypeDeclarationSkeletonInfo,
) -> CompilerTypeHeaderBuildResult:
	declaration_graph = compiler_acyclic_type_alias_dependency_graph_declaration_graph(
		compiler_resolved_type_parameter_graph_alias_dependencies(parameter_graph),
	)
	bound_graph = compiler_declaration_skeleton_graph_bound_graph(declaration_graph)

	match compiler_bound_module_graph_find(
		bound_graph,
		compiler_type_id_module_identity(skeleton.id),
	):
		None:
			CompilerTypeHeaderRejected([CompilerTypeHeaderOwnerModuleMissing(skeleton.id)])
		Some(module):
			match compiler_resolved_type_parameter_graph_find(parameter_graph, skeleton.id):
				None:
					CompilerTypeHeaderRejected([CompilerTypeHeaderParametersMissing(skeleton.id)])
				Some(parameter_entry):
					resolution: CompilerTypeResolutionContext = {
						declaration_graph = declaration_graph,
						bound_graph = bound_graph,
						module = module,
						owner = CompilerTypeDeclarationResolutionOwner(skeleton.id),
						parameters = parameter_entry.parameters.map(
							func(
								parameter,
							): CompilerTypeDeclarationResolutionParameter(parameter.id),
						)
					}
					context: CompilerTypeHeaderBuildContext = {
						owner = skeleton.id,
						resolution = resolution
					}

					match skeleton.source:
						CompilerRecordTypeSource(decl):
							build_record_header(context, parameter_entry.parameters, decl)
						CompilerUnionTypeSource(decl):
							build_union_header(context, parameter_entry.parameters, decl)
						CompilerBuiltinTypeSource(decl):
							build_builtin_header(context, parameter_entry.parameters, decl)
						CompilerAliasTypeSource(decl):
							build_alias_header(context, parameter_entry.parameters, decl)


private pure func type_header_is_public(
	declaration_graph: CompilerDeclarationSkeletonGraph,
	header: CompilerTypeHeader,
) -> Bool:
	compiler_declaration_skeleton_graph_find_type(
		declaration_graph,
		compiler_type_id_module_identity(header.id),
		compiler_type_id_name(header.id),
	)
		.map(func(skeleton): skeleton.visibility == CompilerPublicDeclaration)
		.get_or(False)


private pure func module_type_header_indices_add(
	inventories: Dict[String, CompilerModuleTypeHeaderIndices],
	module_identity: CompilerModuleIdentity,
	header_index: Int,
	is_public: Bool,
) -> Dict[String, CompilerModuleTypeHeaderIndices]:
	key = compiler_module_identity_storage_key(module_identity)
	inventory: CompilerModuleTypeHeaderIndices = inventories.get_or(
		key,
		{
			all_indices = [],
			public_indices = []
		},
	)

	public_indices = if is_public:
		inventory.public_indices.append(header_index)
	else:
		inventory.public_indices

	inventories.set(
		key,
		{
			all_indices = inventory.all_indices.append(header_index),
			public_indices = public_indices
		},
	)


private pure func type_header_table(
	headers: List[CompilerTypeHeader],
	declaration_graph: CompilerDeclarationSkeletonGraph,
) -> CompilerTypeHeaderTable:
	var header_indices_by_name: Dict[String, List[Int]] = {}
	var header_indices_by_module: Dict[String, CompilerModuleTypeHeaderIndices] = {}
	var index: Int = 0

	for header in headers:
		name = compiler_type_id_name(header.id)
		header_indices_by_name = header_indices_by_name.set(
			name,
			header_indices_by_name
				.get_or(name, [])
				.append(index),
		)
		header_indices_by_module = module_type_header_indices_add(
			header_indices_by_module,
			compiler_type_id_module_identity(header.id),
			index,
			type_header_is_public(declaration_graph, header),
		)
		index += 1

	{
		headers = headers,
		header_indices_by_name = header_indices_by_name,
		header_indices_by_module = header_indices_by_module
	}


private pure func type_header_table_module_indices(
	table: CompilerTypeHeaderTable,
	module_identity: CompilerModuleIdentity,
	selection: CompilerHeaderVisibilitySelection,
) -> List[Int]:
	match table.header_indices_by_module.get(compiler_module_identity_storage_key(module_identity)):
		Some(inventory):
			match selection:
				CompilerAllModuleHeaders:
					inventory.all_indices
				CompilerPublicModuleHeaders:
					inventory.public_indices
		None:
			[]


private pure func type_header_table_index(
	table: CompilerTypeHeaderTable,
	id: CompilerTypeId,
) -> Option[Int]:
	var result: Option[Int] = None

	for index in table.header_indices_by_name.get_or(compiler_type_id_name(id), []):
		match table.headers.get(index):
			Some(header):
				if compiler_type_ids_equal(header.id, id):
					result = Some(index)
					break
			None:
				void

	result


private pure func type_header_table_find(
	table: CompilerTypeHeaderTable,
	id: CompilerTypeId,
) -> Option[CompilerTypeHeader]:
	match type_header_table_index(table, id):
		Some(index):
			table.headers.get(index)
		None:
			None


private pure func append_unique_type_id(
	ids: List[CompilerTypeId],
	id: CompilerTypeId,
) -> List[CompilerTypeId]:
	if ids.any(func(existing): compiler_type_ids_equal(existing, id)):
		ids
	else:
		ids.append(id)


private pure func concat_unique_type_ids(
	left: List[CompilerTypeId],
	right: List[CompilerTypeId],
) -> List[CompilerTypeId]:
	var result = left

	for id in right:
		result = append_unique_type_id(result, id)

	result


private pure func layout_substitution_find(
	substitutions: List[CompilerLayoutTypeSubstitution],
	parameter: CompilerTypeParameterId,
) -> Option[CompilerResolvedTypeShape]:
	var result: Option[CompilerResolvedTypeShape] = None

	for substitution in substitutions:
		if compiler_type_parameter_ids_equal(substitution.parameter, parameter):
			result = Some(substitution.replacement)
			break

	result


private pure func layout_alias_substitutions(
	parameters: List[CompilerResolvedTypeParameter],
	args: List[CompilerResolvedTypeShape],
	outer: List[CompilerLayoutTypeSubstitution],
) -> List[CompilerLayoutTypeSubstitution]:
	var result = outer
	var index: Int = 0

	while index < parameters.length():
		match (parameters.get(index), args.get(index)):
			(Some(parameter), Some(arg)):
				result = [
					{
						parameter = parameter.id,
						replacement = arg
					},
				].concat(result)
			_:
				void

		index += 1

	result


-- This classification mirrors the exhaustive stack/heap cases in
-- stage_09_core/core_c_type_layout.brp. Keep every variant explicit so adding
-- a new type representation fails compilation here until its storage edge is
-- deliberately classified. The codegen audit pins the accepted heap cases.
private pure func resolved_shape_supports_stack_option(
	table: CompilerTypeHeaderTable,
	shape: CompilerResolvedTypeShape,
	substitutions: List[CompilerLayoutTypeSubstitution],
) -> Bool:
	match shape:
		CompilerDeclaredTypeShape(id, args):
			match type_header_table_find(table, id):
				Some(header):
					match header.shape:
						CompilerRecordTypeHeader(CompilerValueStruct, _):
							True
						CompilerRecordTypeHeader(CompilerHeapRecord, _):
							False
						CompilerUnionTypeHeader(CompilerFieldlessEnum, _):
							True
						CompilerUnionTypeHeader(CompilerTaggedUnion, _):
							False
						CompilerAliasTypeHeader(_, target):
							resolved_shape_supports_stack_option(
								table,
								target,
								layout_alias_substitutions(header.parameters, args, substitutions),
							)
						CompilerBuiltinTypeHeader(_):
							False
				None:
					False
		CompilerIntrinsicTypeShape(intrinsic, args):
			if not args.is_empty():
				False
			else:
				match intrinsic:
					CompilerIntrinsicInt | CompilerIntrinsicFloat | CompilerIntrinsicBool | CompilerIntrinsicChar | CompilerIntrinsicVoid | CompilerIntrinsicInt8 | CompilerIntrinsicInt16 | CompilerIntrinsicInt32 | CompilerIntrinsicInt64 | CompilerIntrinsicInt128 | CompilerIntrinsicUInt8 | CompilerIntrinsicUInt16 | CompilerIntrinsicUInt32 | CompilerIntrinsicUInt64 | CompilerIntrinsicUInt128 | CompilerIntrinsicFloat32 | CompilerIntrinsicFloat16:
						True
					CompilerIntrinsicString | CompilerIntrinsicLiteralString | CompilerIntrinsicBytes | CompilerIntrinsicPtr | CompilerIntrinsicFixed | CompilerIntrinsicTensor | CompilerIntrinsicOption | CompilerIntrinsicResult | CompilerIntrinsicConcurrencyError | CompilerIntrinsicTaskResult | CompilerIntrinsicChannel:
						False
		CompilerTypeParameterShape(parameter):
			match layout_substitution_find(substitutions, parameter):
				Some(replacement):
					resolved_shape_supports_stack_option(table, replacement, substitutions)
				None:
					False
		CompilerSelfTypeShape(id):
			resolved_shape_supports_stack_option(
				table,
				CompilerDeclaredTypeShape(id, []),
				substitutions,
			)
		CompilerTraitTypeParameterShape(_) | CompilerTraitSelfTypeShape(_) | CompilerTraitDimensionParameterShape(_, _) | CompilerCallableTypeParameterShape(_) | CompilerCallableDimensionParameterShape(_, _) | CompilerImplementationTypeParameterShape(_) | CompilerImplementationDimensionParameterShape(_, _) | CompilerWildcardDimensionShape(_):
			False
		CompilerRangeTypeShape(_):
			True
		CompilerPreludeTypeShape(_, _) | CompilerDimensionParameterShape(_, _) | CompilerDimensionLiteralShape(_) | CompilerDimensionBinaryShape(_, _, _) | CompilerTupleTypeShape(_) | CompilerFunctionTypeShape(_, _, _) | CompilerArrayTypeShape(_, _):
			False


private pure func resolved_shape_inline_dependencies(
	table: CompilerTypeHeaderTable,
	shape: CompilerResolvedTypeShape,
	substitutions: List[CompilerLayoutTypeSubstitution],
) -> List[CompilerTypeId]:
	match shape:
		CompilerDeclaredTypeShape(id, args):
			match type_header_table_find(table, id):
				Some(header):
					match header.shape:
						CompilerRecordTypeHeader(CompilerValueStruct, _):
							[id]
						CompilerRecordTypeHeader(CompilerHeapRecord, _):
							[]
						CompilerAliasTypeHeader(_, target):
							resolved_shape_inline_dependencies(
								table,
								target,
								layout_alias_substitutions(header.parameters, args, substitutions),
							)
						CompilerUnionTypeHeader(_, _) | CompilerBuiltinTypeHeader(_):
							[]
				None:
					[]
		CompilerIntrinsicTypeShape(intrinsic, args):
			match intrinsic:
				CompilerIntrinsicResult | CompilerIntrinsicTaskResult:
					resolved_shapes_inline_dependencies(table, args, substitutions)
				CompilerIntrinsicOption:
					match args:
						[payload]:
							if resolved_shape_supports_stack_option(table, payload, substitutions):
								resolved_shape_inline_dependencies(table, payload, substitutions)
							else:
								[]
						_:
							[]
				CompilerIntrinsicInt | CompilerIntrinsicFloat | CompilerIntrinsicBool | CompilerIntrinsicString | CompilerIntrinsicLiteralString | CompilerIntrinsicChar | CompilerIntrinsicVoid | CompilerIntrinsicBytes | CompilerIntrinsicPtr | CompilerIntrinsicFixed | CompilerIntrinsicInt8 | CompilerIntrinsicInt16 | CompilerIntrinsicInt32 | CompilerIntrinsicInt64 | CompilerIntrinsicInt128 | CompilerIntrinsicUInt8 | CompilerIntrinsicUInt16 | CompilerIntrinsicUInt32 | CompilerIntrinsicUInt64 | CompilerIntrinsicUInt128 | CompilerIntrinsicFloat32 | CompilerIntrinsicFloat16 | CompilerIntrinsicTensor | CompilerIntrinsicConcurrencyError | CompilerIntrinsicChannel:
					[]
		CompilerTypeParameterShape(parameter):
			match layout_substitution_find(substitutions, parameter):
				Some(replacement):
					resolved_shape_inline_dependencies(table, replacement, substitutions)
				None:
					[]
		CompilerSelfTypeShape(id):
			resolved_shape_inline_dependencies(
				table,
				CompilerDeclaredTypeShape(id, []),
				substitutions,
			)
		CompilerTraitTypeParameterShape(_) | CompilerTraitSelfTypeShape(_) | CompilerTraitDimensionParameterShape(_, _) | CompilerCallableTypeParameterShape(_) | CompilerCallableDimensionParameterShape(_, _) | CompilerImplementationTypeParameterShape(_) | CompilerImplementationDimensionParameterShape(_, _) | CompilerWildcardDimensionShape(_):
			[]
		CompilerPreludeTypeShape(_, _) | CompilerDimensionParameterShape(_, _) | CompilerDimensionLiteralShape(_) | CompilerDimensionBinaryShape(_, _, _) | CompilerRangeTypeShape(_) | CompilerTupleTypeShape(_) | CompilerFunctionTypeShape(_, _, _) | CompilerArrayTypeShape(_, _):
			-- Tuples and tensors are ARC-managed heap layouts in current Core.
			-- Function values and every prelude container are indirect as well.
			[]


private pure func resolved_shapes_inline_dependencies(
	table: CompilerTypeHeaderTable,
	shapes: List[CompilerResolvedTypeShape],
	substitutions: List[CompilerLayoutTypeSubstitution],
) -> List[CompilerTypeId]:
	var result: List[CompilerTypeId] = []

	for shape in shapes:
		result = concat_unique_type_ids(
			result,
			resolved_shape_inline_dependencies(table, shape, substitutions),
		)

	result


private pure func type_header_inline_dependencies(
	table: CompilerTypeHeaderTable,
	header: CompilerTypeHeader,
) -> List[CompilerTypeId]:
	match header.shape:
		CompilerRecordTypeHeader(CompilerValueStruct, fields):
			resolved_shapes_inline_dependencies(
				table,
				fields.map(func(field): field.typ),
				[],
			)
		CompilerAliasTypeHeader(_, target):
			resolved_shape_inline_dependencies(table, target, [])
		CompilerRecordTypeHeader(CompilerHeapRecord, _) | CompilerUnionTypeHeader(_, _) | CompilerBuiltinTypeHeader(_):
			[]


private pure func inline_layout_dependencies(
	table: CompilerTypeHeaderTable,
) -> List[CompilerInlineLayoutDependency]:
	var result: List[CompilerInlineLayoutDependency] = []

	for header in table.headers:
		var dependency_indices: List[Int] = []

		for id in type_header_inline_dependencies(table, header):
			match type_header_table_index(table, id):
				Some(index):
					dependency_indices = dependency_indices.append(index)
				None:
					void

		node: CompilerInlineLayoutDependency = {
			id = header.id,
			dependency_indices = dependency_indices
		}
		result = result.append(node)

	result


private pure func inline_layout_cycle_from_path(
	path: List[CompilerTypeId],
	repeated_id: CompilerTypeId,
) -> List[CompilerTypeId]:
	var start_index: Int = 0
	var index: Int = 0

	while index < path.length():
		match path.get(index):
			Some(id):
				if compiler_type_ids_equal(id, repeated_id):
					start_index = index
					break
			None:
				void

		index += 1

	path
		.drop(start_index)
		.append(repeated_id)


private pure func inline_layout_cycle_from_stack(
	nodes: List[CompilerInlineLayoutDependency],
	stack: List[CompilerInlineLayoutFrame],
	repeated_index: Int,
) -> Option[List[CompilerTypeId]]:
	var path: List[CompilerTypeId] = []

	for frame in stack:
		match nodes.get(frame.node_index):
			Some(node):
				path = path.append(node.id)
			None:
				void

	match nodes.get(repeated_index):
		Some(node):
			Some(inline_layout_cycle_from_path(path, node.id))
		None:
			None


private pure func inline_layout_cycle(
	table: CompilerTypeHeaderTable,
) -> Option[List[CompilerTypeId]]:
	nodes = inline_layout_dependencies(table)
	var visit_states: List[CompilerInlineLayoutVisitState] = []

	for _ in nodes:
		visit_states = visit_states.append(CompilerInlineLayoutUnvisited)

	var cycle: Option[List[CompilerTypeId]] = None
	var root_index: Int = 0

	while root_index < nodes.length() and cycle.is_none():
		if visit_states.get_or(
			root_index,
			CompilerInlineLayoutUnvisited,
		) == CompilerInlineLayoutUnvisited:
			var stack: List[CompilerInlineLayoutFrame] = [
				{
					node_index = root_index,
					next_dependency_index = 0
				},
			]
			visit_states = visit_states.set(root_index, CompilerInlineLayoutVisiting)

			while not stack.is_empty() and cycle.is_none():
				frame_index = stack.length() - 1

				match stack.get(frame_index):
					None:
						stack = stack.take(frame_index)
					Some(frame):
						match nodes.get(frame.node_index):
							None:
								stack = stack.take(frame_index)
							Some(node):
								match node.dependency_indices.get(frame.next_dependency_index):
									Some(dependency_index):
										stack = stack.set(
											frame_index,
											{
												node_index = frame.node_index,
												next_dependency_index = frame.next_dependency_index + 1
											},
										)

										match visit_states.get_or(
											dependency_index,
											CompilerInlineLayoutUnvisited,
										):
											CompilerInlineLayoutVisiting:
												cycle = inline_layout_cycle_from_stack(
													nodes,
													stack,
													dependency_index,
												)
											CompilerInlineLayoutUnvisited:
												visit_states = visit_states.set(
													dependency_index,
													CompilerInlineLayoutVisiting,
												)
												stack = stack.append({
													node_index = dependency_index,
													next_dependency_index = 0,
												})
											CompilerInlineLayoutComplete:
												void
									None:
										visit_states = visit_states.set(
											frame.node_index,
											CompilerInlineLayoutComplete,
										)
										stack = stack.take(frame_index)

		root_index += 1

	cycle


private pure func resolved_shape_is_valid_struct_field(
	table: CompilerTypeHeaderTable,
	shape: CompilerResolvedTypeShape,
	substitutions: List[CompilerLayoutTypeSubstitution],
) -> Bool:
	-- Alias cycles have already been rejected by the dependency graph. Walk
	-- the remaining single-target alias chain iteratively so a deep valid chain
	-- cannot exhaust the compiler stack.
	var current = shape
	var current_substitutions = substitutions
	var valid: Bool = False
	var complete: Bool = False

	while not complete:
		match current:
			CompilerIntrinsicTypeShape(intrinsic, args):
				valid = args.is_empty() and intrinsic_is_struct_scalar(intrinsic)
				complete = True
			CompilerPreludeTypeShape(prelude_type, args):
				valid = (
					args.is_empty()
					and compiler_prelude_type_has_inline_value_storage(prelude_type)
				)

				complete = True
			CompilerDeclaredTypeShape(id, args):
				match type_header_table_find(table, id):
					Some(header):
						match header.shape:
							CompilerBuiltinTypeHeader(CompilerScalarBuiltin):
								valid = args.is_empty()
								complete = True
							CompilerUnionTypeHeader(CompilerFieldlessEnum, _):
								valid = args.is_empty()
								complete = True
							CompilerRecordTypeHeader(CompilerValueStruct, _):
								valid = args.is_empty()
								complete = True
							CompilerAliasTypeHeader(_, target):
								match type_shape_substitutions(
									header.parameters,
									args,
									current_substitutions,
								):
									Some(alias_substitutions):
										current = target
										current_substitutions = alias_substitutions
									None:
										complete = True
							_:
								complete = True
					None:
						complete = True
			CompilerTypeParameterShape(parameter):
				match layout_substitution_find(current_substitutions, parameter):
					Some(replacement):
						current = replacement
					None:
						complete = True
			_:
				complete = True

	valid


private pure func invalid_struct_field_errors(
	table: CompilerTypeHeaderTable,
) -> List[CompilerTypeHeaderError]:
	var errors: List[CompilerTypeHeaderError] = []

	for header in table.headers:
		match header.shape:
			CompilerRecordTypeHeader(CompilerValueStruct, fields):
				for field in fields:
					if not resolved_shape_is_valid_struct_field(table, field.typ, []):
						errors = errors.append(
							CompilerTypeHeaderInvalidStructField(
								header.id,
								field.name,
							),
						)
			_:
				void

	errors


private pure func type_shape_substitutions(
	parameters: List[CompilerResolvedTypeParameter],
	args: List[CompilerResolvedTypeShape],
	parent: List[CompilerLayoutTypeSubstitution],
) -> Option[List[CompilerLayoutTypeSubstitution]]:
	if parameters.length() != args.length():
		None
	else:
		-- An inner instantiation of the same generic declaration must shadow its
		-- outer parameter mapping, as in `Box[Box[Int]]`.
		var result: List[CompilerLayoutTypeSubstitution] = []
		var index: Int = 0

		while index < parameters.length():
			match (parameters.get(index), args.get(index)):
				(Some(parameter), Some(replacement)):
					result = result.append({
						parameter = parameter.id,
						replacement = replacement,
					})
				_:
					void

			index += 1

		Some(result.concat(parent))


private record CompilerPendingValueLayoutShape {
	shape: CompilerResolvedTypeShape,
	substitutions: List[CompilerLayoutTypeSubstitution]
}


private pure func pending_record_fields(
	fields: List[CompilerTypeHeaderField],
	substitutions: List[CompilerLayoutTypeSubstitution],
) -> List[CompilerPendingValueLayoutShape]:
	var pending: List[CompilerPendingValueLayoutShape] = []

	for field in fields:
		pending = pending.append({
			shape = field.typ,
			substitutions = substitutions,
		})

	pending


private pure func bool_at(values: List[Bool], index: Int) -> Bool:
	values
		.get(index)
		.get_or(False)


private record CompilerValueLayoutSummary {
	dependencies: List[Int],
	required_parameters: List[CompilerTypeParameterId]
}


private pure func append_unique_int(values: List[Int], value: Int) -> List[Int]:
	if values.contains(value):
		values
	else:
		values.append(value)


private pure func append_unique_type_parameter(
	values: List[CompilerTypeParameterId],
	value: CompilerTypeParameterId,
) -> List[CompilerTypeParameterId]:
	var present: Bool = False

	for existing in values:
		if compiler_type_parameter_ids_equal(existing, value):
			present = True
			break

	if present:
		values
	else:
		values.append(value)


private pure func append_value_layout_work(
	work: List[CompilerPendingValueLayoutShape],
	shapes: List[CompilerResolvedTypeShape],
	substitutions: List[CompilerLayoutTypeSubstitution],
) -> List[CompilerPendingValueLayoutShape]:
	var result = work

	for shape in shapes:
		result = result.append({
			shape = shape,
			substitutions = substitutions,
		})

	result


private pure func empty_value_layout_summaries(
	table: CompilerTypeHeaderTable,
) -> List[CompilerValueLayoutSummary]:
	var summaries: List[CompilerValueLayoutSummary] = []

	for _ in table.headers:
		summaries = summaries.append({
			dependencies = [],
			required_parameters = [],
		})

	summaries


private pure func value_layout_summary_at(
	summaries: List[CompilerValueLayoutSummary],
	index: Int,
) -> CompilerValueLayoutSummary:
	summaries
		.get(index)
		.get_or({
			dependencies = [],
			required_parameters = [],
		})


private pure func record_value_layout_summary(
	table: CompilerTypeHeaderTable,
	summaries: List[CompilerValueLayoutSummary],
	fields: List[CompilerTypeHeaderField],
	initial: CompilerValueLayoutSummary,
) -> CompilerValueLayoutSummary:
	-- A generic argument contributes to product layout only when the referenced
	-- record requires that parameter inline. This distinguishes finite
	-- `Box[Box[Int]]` nesting from `Loop { value: Box[Loop] }`.
	var result = initial
	var work = pending_record_fields(fields, [])
	var work_index: Int = 0

	while work_index < work.length():
		match work.get(work_index):
			None:
				void
			Some(item):
				match item.shape:
					CompilerDeclaredTypeShape(id, args):
						match type_header_table_index(table, id):
							None:
								void
							Some(header_index):
								match table.headers.get(header_index):
									None:
										void
									Some(header):
										match header.shape:
											CompilerRecordTypeHeader(_, _):
												result = { result |
													dependencies = append_unique_int(
														result.dependencies,
														header_index,
													)
												}

												match type_shape_substitutions(
													header.parameters,
													args,
													item.substitutions,
												):
													Some(child_substitutions):
														callee = value_layout_summary_at(
															summaries,
															header_index,
														)

														for parameter in callee.required_parameters:
															match layout_substitution_find(
																child_substitutions,
																parameter,
															):
																Some(replacement):
																	work = append_value_layout_work(
																		work,
																		[replacement],
																		child_substitutions,
																	)
																None:
																	void
													None:
														void
											CompilerAliasTypeHeader(_, target):
												match type_shape_substitutions(
													header.parameters,
													args,
													item.substitutions,
												):
													Some(alias_substitutions):
														work = append_value_layout_work(
															work,
															[target],
															alias_substitutions,
														)
													None:
														void
											_:
												void
					CompilerTypeParameterShape(parameter):
						match layout_substitution_find(item.substitutions, parameter):
							Some(replacement):
								work = append_value_layout_work(
									work,
									[replacement],
									item.substitutions,
								)
							None:
								result = { result |
									required_parameters = append_unique_type_parameter(
										result.required_parameters,
										parameter,
									)
								}
					CompilerSelfTypeShape(id):
						match type_header_table_index(table, id):
							Some(header_index):
								result = { result |
									dependencies = append_unique_int(
										result.dependencies,
										header_index,
									)
								}
							None:
								void
					CompilerTupleTypeShape(elements):
						work = append_value_layout_work(work, elements, item.substitutions)
					_:
						void

		work_index += 1

	result


private pure func value_layout_references(
	table: CompilerTypeHeaderTable,
	fields: List[CompilerTypeHeaderField],
) -> List[Int]:
	-- This conservative reference set drives only worklist invalidation. It may
	-- include a generic argument that later proves non-mandatory, but it never
	-- changes the computed dependency graph.
	var references: List[Int] = []
	var work = pending_record_fields(fields, [])
	var work_index: Int = 0

	while work_index < work.length():
		match work.get(work_index):
			Some(item):
				match item.shape:
					CompilerDeclaredTypeShape(id, args):
						match type_header_table_index(table, id):
							Some(header_index):
								match table.headers.get(header_index):
									Some(header):
										match header.shape:
											CompilerRecordTypeHeader(_, _):
												references = append_unique_int(
													references,
													header_index,
												)
												work = append_value_layout_work(
													work,
													args,
													item.substitutions,
												)
											CompilerAliasTypeHeader(_, target):
												match type_shape_substitutions(
													header.parameters,
													args,
													item.substitutions,
												):
													Some(alias_substitutions):
														work = append_value_layout_work(
															work,
															[target],
															alias_substitutions,
														)
													None:
														void
											_:
												void
									None:
										void
							None:
								void
					CompilerTypeParameterShape(parameter):
						match layout_substitution_find(item.substitutions, parameter):
							Some(replacement):
								work = append_value_layout_work(
									work,
									[replacement],
									item.substitutions,
								)
							None:
								void
					CompilerSelfTypeShape(id):
						match type_header_table_index(table, id):
							Some(header_index):
								references = append_unique_int(references, header_index)
							None:
								void
					CompilerTupleTypeShape(elements):
						work = append_value_layout_work(work, elements, item.substitutions)
					_:
						void
			None:
				void

		work_index += 1

	references


private pure func empty_int_lists(length: Int) -> List[List[Int]]:
	var result: List[List[Int]] = []
	var index: Int = 0

	while index < length:
		result = result.append([])
		index += 1

	result


private pure func value_layout_summary_consumers(table: CompilerTypeHeaderTable) -> List[List[Int]]:
	var consumers = empty_int_lists(table.headers.length())
	var owner_index: Int = 0

	for header in table.headers:
		match header.shape:
			CompilerRecordTypeHeader(_, fields):
				for dependency in value_layout_references(table, fields):
					match consumers.get(dependency):
						Some(existing):
							consumers = consumers.set(
								dependency,
								append_unique_int(existing, owner_index),
							)
						None:
							void
			_:
				void

		owner_index += 1

	consumers


private pure func complete_value_layout_summaries(
	table: CompilerTypeHeaderTable,
) -> List[CompilerValueLayoutSummary]:
	-- Summaries grow monotonically over finite declaration and parameter sets,
	-- so this worklist terminates without a heuristic pass limit.
	consumers = value_layout_summary_consumers(table)
	var summaries = empty_value_layout_summaries(table)
	var queued = False.repeat(table.headers.length())
	var queue: List[Int] = []
	var queue_index: Int = 0
	var index: Int = 0

	for header in table.headers:
		match header.shape:
			CompilerRecordTypeHeader(_, _):
				queue = queue.append(index)
				queued = queued.set(index, True)
			_:
				void

		index += 1

	while queue_index < queue.length():
		match queue.get(queue_index):
			Some(header_index):
				queued = queued.set(header_index, False)

				match table.headers.get(header_index):
					Some(header):
						match header.shape:
							CompilerRecordTypeHeader(_, fields):
								before = value_layout_summary_at(summaries, header_index)
								after = record_value_layout_summary(
									table,
									summaries,
									fields,
									before,
								)

								if (
									before.dependencies.length() != after.dependencies.length()
									or before.required_parameters.length() != after.required_parameters.length()
								):
									summaries = summaries.set(header_index, after)

									for consumer in (
										consumers
											.get(header_index)
											.get_or([])
									):
										if not bool_at(queued, consumer):
											queue = queue.append(consumer)
											queued = queued.set(consumer, True)
							_:
								void
					None:
						void
			None:
				void

		queue_index += 1

	summaries


private pure func recursive_value_layout_errors(
	table: CompilerTypeHeaderTable,
) -> List[CompilerTypeHeaderError]:
	-- Kahn elimination leaves exactly records in mandatory product cycles and
	-- records that depend on those cycles. Collections, functions, and unions
	-- never enter this graph because they provide indirection or a base case.
	summaries = complete_value_layout_summaries(table)
	var errors: List[CompilerTypeHeaderError] = []
	var unresolved = 0.repeat(table.headers.length())
	var dependents = empty_int_lists(table.headers.length())
	var queue: List[Int] = []
	var queue_index: Int = 0
	var index: Int = 0

	for header in table.headers:
		match header.shape:
			CompilerRecordTypeHeader(_, _):
				summary = value_layout_summary_at(summaries, index)
				unresolved = unresolved.set(index, summary.dependencies.length())

				for dependency in summary.dependencies:
					match dependents.get(dependency):
						Some(existing):
							dependents = dependents.set(
								dependency,
								existing.append(index),
							)
						None:
							void
			_:
				void

		index += 1

	index = 0

	for header in table.headers:
		match header.shape:
			CompilerRecordTypeHeader(_, _):
				if (
					unresolved
						.get(index)
						.get_or(0) == 0
				):
					queue = queue.append(index)
			_:
				void

		index += 1

	while queue_index < queue.length():
		match queue.get(queue_index):
			Some(completed_index):
				for dependent in (
					dependents
						.get(completed_index)
						.get_or([])
				):
					remaining = unresolved
						.get(dependent)
						.get_or(0) - 1
					unresolved = unresolved.set(dependent, remaining)

					if remaining == 0:
						queue = queue.append(dependent)
			None:
				void

		queue_index += 1

	index = 0

	for header in table.headers:
		match header.shape:
			CompilerRecordTypeHeader(_, _):
				if (
					unresolved
						.get(index)
						.get_or(0) > 0
				):
					errors = errors.append(
						CompilerTypeHeaderRecursiveValueLayout(
							header.id,
							value_layout_summary_at(summaries, index).dependencies.contains(index),
						),
					)
			_:
				void

		index += 1

	errors


private pure func resolved_shape_contains_resource(
	table: CompilerTypeHeaderTable,
	shape: CompilerResolvedTypeShape,
) -> Bool:
	match shape:
		CompilerDeclaredTypeShape(id, args):
			(
				type_header_table_find(table, id)
					.map(func(header): header.contains_resource)
					.get_or(False)
				or args.any(func(arg): resolved_shape_contains_resource(table, arg))
			)
		CompilerIntrinsicTypeShape(_, args):
			args.any(func(arg): resolved_shape_contains_resource(table, arg))
		CompilerPreludeTypeShape(prelude_type, args):
			(
				compiler_prelude_type_is_resource(prelude_type)
				or args.any(func(arg): resolved_shape_contains_resource(table, arg))
			)
		CompilerTypeParameterShape(_):
			False
		CompilerSelfTypeShape(id):
			type_header_table_find(table, id)
				.map(func(header): header.contains_resource)
				.get_or(False)
		CompilerTraitTypeParameterShape(_) | CompilerTraitSelfTypeShape(_) | CompilerCallableTypeParameterShape(_) | CompilerImplementationTypeParameterShape(_):
			False
		CompilerDimensionParameterShape(_, _):
			False
		CompilerTraitDimensionParameterShape(_, _):
			False
		CompilerCallableDimensionParameterShape(_, _):
			False
		CompilerImplementationDimensionParameterShape(_, _):
			False
		CompilerWildcardDimensionShape(_):
			False
		CompilerDimensionLiteralShape(_):
			False
		CompilerDimensionBinaryShape(_, left, right):
			(
				resolved_shape_contains_resource(table, left)
				or resolved_shape_contains_resource(table, right)
			)
		CompilerRangeTypeShape(inner):
			resolved_shape_contains_resource(table, inner)
		CompilerTupleTypeShape(elements):
			elements.any(func(element): resolved_shape_contains_resource(table, element))
		CompilerFunctionTypeShape(_, params, return_type):
			(
				params.any(func(param): resolved_shape_contains_resource(table, param))
				or resolved_shape_contains_resource(table, return_type)
			)
		CompilerArrayTypeShape(element, dims):
			(
				resolved_shape_contains_resource(table, element)
				or dims.any(func(dim): resolved_shape_contains_resource(table, dim))
			)


private pure func header_shape_contains_resource(
	table: CompilerTypeHeaderTable,
	shape: CompilerTypeHeaderShape,
) -> Bool:
	match shape:
		CompilerRecordTypeHeader(_, fields):
			fields.any(func(field): resolved_shape_contains_resource(table, field.typ))
		CompilerUnionTypeHeader(_, variants):
			variants.any(func(variant):
				variant.fields.any(func(field): resolved_shape_contains_resource(table, field))
			)
		CompilerBuiltinTypeHeader(layout):
			match layout:
				CompilerResourceBuiltin(_):
					True
				CompilerScalarBuiltin | CompilerManagedBuiltin | CompilerNoValueBuiltin | CompilerUnclassifiedBuiltin:
					False
		CompilerAliasTypeHeader(_, target):
			resolved_shape_contains_resource(table, target)


private pure func complete_resource_containment(
	table: CompilerTypeHeaderTable,
) -> CompilerTypeHeaderTable:
	var result = table
	var changed: Bool = True
	var remaining_passes: Int = table.headers.length()

	while changed and remaining_passes > 0:
		changed = False
		var index: Int = 0

		for header in result.headers:
			contains_resource = (
				header.contains_resource
				or header_shape_contains_resource(result, header.shape)
			)

			if contains_resource != header.contains_resource:
				result = { result |
					headers = result.headers.set(
						index,
						{ header | contains_resource = contains_resource },
					)
				}
				changed = True

			index += 1

		remaining_passes -= 1

	result


pure func compiler_type_header_graph_build(
	parameter_graph: CompilerResolvedTypeParameterGraph,
) -> Result[CompilerTypeHeaderGraph, List[CompilerTypeHeaderError]]:
	declaration_graph = compiler_acyclic_type_alias_dependency_graph_declaration_graph(
		compiler_resolved_type_parameter_graph_alias_dependencies(parameter_graph),
	)
	var headers: List[CompilerTypeHeader] = []
	var errors: List[CompilerTypeHeaderError] = []

	for skeleton in compiler_declaration_skeleton_graph_type_skeletons(declaration_graph):
		match build_type_header(parameter_graph, skeleton):
			CompilerTypeHeaderReady(header):
				headers = headers.append(header)
			CompilerTypeHeaderRejected(header_errors):
				errors = errors.concat(header_errors)

	if not errors.is_empty():
		Err(errors)
	else:
		table = type_header_table(headers, declaration_graph)

		match inline_layout_cycle(table):
			Some(cycle):
				Err([CompilerTypeHeaderInlineStorageCycle(cycle)])
			None:
				struct_field_errors = invalid_struct_field_errors(table)
				recursive_layout_errors = recursive_value_layout_errors(table)
				validation_errors = struct_field_errors.concat(recursive_layout_errors)

				if not validation_errors.is_empty():
					Err(validation_errors)
				else:
					completed_table = complete_resource_containment(table)
					representation: CompilerTypeHeaderGraphRep = {
						parameter_graph = parameter_graph,
						table = completed_table
					}
					Ok(into CompilerTypeHeaderGraph(representation))


private pure func type_header_graph_rep(
	graph: CompilerTypeHeaderGraph,
) -> CompilerTypeHeaderGraphRep:
	from CompilerTypeHeaderGraph(graph)


pure func compiler_type_header_graph_parameter_graph(
	graph: CompilerTypeHeaderGraph,
) -> CompilerResolvedTypeParameterGraph:
	type_header_graph_rep(graph).parameter_graph


pure func compiler_type_header_graph_declaration_graph(
	graph: CompilerTypeHeaderGraph,
) -> CompilerDeclarationSkeletonGraph:
	parameter_graph = type_header_graph_rep(graph).parameter_graph
	compiler_acyclic_type_alias_dependency_graph_declaration_graph(
		compiler_resolved_type_parameter_graph_alias_dependencies(parameter_graph),
	)


pure func compiler_type_header_graph_bound_graph(
	graph: CompilerTypeHeaderGraph,
) -> CompilerBoundModuleGraph:
	compiler_declaration_skeleton_graph_bound_graph(
		compiler_type_header_graph_declaration_graph(graph),
	)


pure func compiler_type_header_graph_headers(
	graph: CompilerTypeHeaderGraph,
) -> List[CompilerTypeHeader]:
	type_header_graph_rep(graph).table.headers


pure func compiler_type_header_graph_declaration_skeleton_count(
	graph: CompilerTypeHeaderGraph,
) -> Int:
	compiler_declaration_skeleton_graph_skeletons(
		compiler_type_header_graph_declaration_graph(graph),
	).length()


pure func compiler_type_header_graph_find(
	graph: CompilerTypeHeaderGraph,
	id: CompilerTypeId,
) -> Option[CompilerTypeHeader]:
	type_header_table_find(type_header_graph_rep(graph).table, id)


pure func compiler_type_header_graph_declared_type_expansion(
	graph: CompilerTypeHeaderGraph,
	id: CompilerTypeId,
) -> Option[CompilerDeclaredTypeExpansion]:
	compiler_type_header_graph_find(graph, id).map(func(header):
		match header.shape:
			CompilerAliasTypeHeader(CompilerTransparentAlias, target):
				CompilerTransparentAliasExpansion(header.parameters, target)
			_:
				CompilerNominalDeclaredType
	)


private pure func compiler_builtin_type_header(
	header: CompilerTypeHeader,
) -> Option[CompilerAcceptedBuiltinHeader]:
	match header.shape:
		CompilerBuiltinTypeHeader(layout):
			Some(into CompilerAcceptedBuiltinHeader({
					id = header.id,
					parameters = header.parameters,
					layout = layout,
				}))
		_:
			None


private pure func compiler_type_header_graph_builtin_headers_for_module(
	graph: CompilerTypeHeaderGraph,
	module_identity: CompilerModuleIdentity,
	selection: CompilerHeaderVisibilitySelection,
) -> List[CompilerAcceptedBuiltinHeader]:
	table = type_header_graph_rep(graph).table
	var result: List[CompilerAcceptedBuiltinHeader] = []

	for index in type_header_table_module_indices(table, module_identity, selection):
		match table.headers.get(index):
			Some(header):
				match compiler_builtin_type_header(header):
					Some(builtin_header):
						result = result.append(builtin_header)
					None:
						void
			None:
				void

	result


pure func compiler_type_header_graph_local_builtin_headers(
	graph: CompilerTypeHeaderGraph,
	module_identity: CompilerModuleIdentity,
) -> List[CompilerAcceptedBuiltinHeader]:
	compiler_type_header_graph_builtin_headers_for_module(
		graph,
		module_identity,
		CompilerAllModuleHeaders,
	)


pure func compiler_type_header_graph_public_builtin_headers(
	graph: CompilerTypeHeaderGraph,
	module_identity: CompilerModuleIdentity,
) -> List[CompilerAcceptedBuiltinHeader]:
	compiler_type_header_graph_builtin_headers_for_module(
		graph,
		module_identity,
		CompilerPublicModuleHeaders,
	)


private pure func compiler_record_type_header(
	header: CompilerTypeHeader,
) -> Option[CompilerAcceptedRecordHeader]:
	match header.shape:
		CompilerRecordTypeHeader(layout, fields):
			Some(into CompilerAcceptedRecordHeader({
					id = header.id,
					parameters = header.parameters,
					layout = layout,
					fields = fields,
					contains_resource = header.contains_resource,
				}))
		_:
			None


private pure func compiler_type_header_graph_record_headers_for_module(
	graph: CompilerTypeHeaderGraph,
	module_identity: CompilerModuleIdentity,
	selection: CompilerHeaderVisibilitySelection,
) -> List[CompilerAcceptedRecordHeader]:
	table = type_header_graph_rep(graph).table
	var result: List[CompilerAcceptedRecordHeader] = []

	for index in type_header_table_module_indices(table, module_identity, selection):
		match table.headers.get(index):
			Some(header):
				match compiler_record_type_header(header):
					Some(record_header):
						result = result.append(record_header)
					None:
						void
			None:
				void

	result


pure func compiler_type_header_graph_local_record_headers(
	graph: CompilerTypeHeaderGraph,
	module_identity: CompilerModuleIdentity,
) -> List[CompilerAcceptedRecordHeader]:
	compiler_type_header_graph_record_headers_for_module(
		graph,
		module_identity,
		CompilerAllModuleHeaders,
	)


pure func compiler_type_header_graph_public_record_headers(
	graph: CompilerTypeHeaderGraph,
	module_identity: CompilerModuleIdentity,
) -> List[CompilerAcceptedRecordHeader]:
	compiler_type_header_graph_record_headers_for_module(
		graph,
		module_identity,
		CompilerPublicModuleHeaders,
	)


private pure func compiler_union_type_header(
	header: CompilerTypeHeader,
) -> Option[CompilerAcceptedUnionHeader]:
	match header.shape:
		CompilerUnionTypeHeader(layout, variants):
			Some(into CompilerAcceptedUnionHeader({
					id = header.id,
					parameters = header.parameters,
					layout = layout,
					variants = variants,
					contains_resource = header.contains_resource,
				}))
		_:
			None


private pure func compiler_type_header_graph_union_headers_for_module(
	graph: CompilerTypeHeaderGraph,
	module_identity: CompilerModuleIdentity,
	selection: CompilerHeaderVisibilitySelection,
) -> List[CompilerAcceptedUnionHeader]:
	table = type_header_graph_rep(graph).table
	var result: List[CompilerAcceptedUnionHeader] = []

	for index in type_header_table_module_indices(table, module_identity, selection):
		match table.headers.get(index):
			Some(header):
				match compiler_union_type_header(header):
					Some(union_header):
						result = result.append(union_header)
					None:
						void
			None:
				void

	result


pure func compiler_type_header_graph_local_union_headers(
	graph: CompilerTypeHeaderGraph,
	module_identity: CompilerModuleIdentity,
) -> List[CompilerAcceptedUnionHeader]:
	compiler_type_header_graph_union_headers_for_module(
		graph,
		module_identity,
		CompilerAllModuleHeaders,
	)


pure func compiler_type_header_graph_public_union_headers(
	graph: CompilerTypeHeaderGraph,
	module_identity: CompilerModuleIdentity,
) -> List[CompilerAcceptedUnionHeader]:
	compiler_type_header_graph_union_headers_for_module(
		graph,
		module_identity,
		CompilerPublicModuleHeaders,
	)


private pure func compiler_alias_type_header(
	header: CompilerTypeHeader,
) -> Option[CompilerAcceptedAliasHeader]:
	match header.shape:
		CompilerAliasTypeHeader(layout, target):
			Some(into CompilerAcceptedAliasHeader({
					id = header.id,
					parameters = header.parameters,
					layout = layout,
					target = target,
				}))
		_:
			None


private pure func compiler_type_header_graph_alias_headers_for_module(
	graph: CompilerTypeHeaderGraph,
	module_identity: CompilerModuleIdentity,
	selection: CompilerHeaderVisibilitySelection,
) -> List[CompilerAcceptedAliasHeader]:
	table = type_header_graph_rep(graph).table
	var result: List[CompilerAcceptedAliasHeader] = []

	for index in type_header_table_module_indices(table, module_identity, selection):
		match table.headers.get(index):
			Some(header):
				match compiler_alias_type_header(header):
					Some(alias_header):
						result = result.append(alias_header)
					None:
						void
			None:
				void

	result


pure func compiler_type_header_graph_local_alias_headers(
	graph: CompilerTypeHeaderGraph,
	module_identity: CompilerModuleIdentity,
