-- Immutable, definition-owned type headers.
--
-- Named references are resolved to exact declaration identities. Compiler
-- intrinsics and owner-local type parameters have distinct identities, so a
-- later phase cannot confuse any of them by comparing source spellings.
import:
	../../stage_01_file_io/source: CompilerSourceSpan, compiler_source_spans_equal
	../../stage_03_parse/parsed_ast:
		ParsedBuiltinTypeDecl,
		ParsedDimBinaryOp(
			ParsedDimAddOp,
			ParsedDimDivideOp,
			ParsedDimMultiplyOp,
			ParsedDimSubtractOp,
		),
		ParsedFieldDecl,
		ParsedRecordDecl,
		ParsedResourceCleanup,
		ParsedTypeAliasDecl,
		ParsedTypeExpr(
			ParsedArrayType,
			ParsedBoundedType,
			ParsedDimBinaryType,
			ParsedDimLiteralType,
			ParsedDimNameType,
			ParsedFunctionType,
			ParsedMissingType,
			ParsedNamedType,
			ParsedQualifiedNamedType,
			ParsedRangeType,
			ParsedTupleType,
		),
		ParsedUnionDecl,
		ParsedVariantDecl,
		parsed_type_expr_span,
	../../stage_04_modules/loaded_module:
		CompilerModuleIdentity,
		compiler_module_identities_equal,
		compiler_module_identity_display_name,
		compiler_module_identity_storage_key,
	../../stage_05_types/language_surface_manifest:
		CompilerBuiltinValueStorage(
			CompilerBuiltinInlineScalar,
			CompilerBuiltinManagedReference,
			CompilerBuiltinNoValue,
		),
		CompilerPreludeType,
		compiler_builtin_value_storage,
		compiler_prelude_type,
		compiler_prelude_type_arity,
		compiler_prelude_type_has_inline_value_storage,
		compiler_prelude_type_is_resource,
		compiler_prelude_type_module_path,
	../graph/definition_identity:
		CompilerSourceDefinitionKind(CompilerFieldDefinition),
		compiler_source_definition_key,
	../graph/definition_index: compiler_definition_index_find_source_definition_id
	../graph/indexed_graph:
		compiler_indexed_graph_definition_index,
		compiler_prepared_module_scope_canonical_path,
		compiler_prepared_module_scope_origin,
	../modules/bound_module_graph:
		CompilerBoundModule,
		CompilerBoundModuleGraph,
		compiler_bound_module_graph_find,
		compiler_bound_module_graph_find_canonical_path,
		compiler_bound_module_graph_indexed_graph,
		compiler_bound_module_identity,
		compiler_bound_module_program,
		compiler_bound_module_scope,
		compiler_bound_module_view,
	../modules/module_binding: compiler_importable_module_request_aliases
	../modules/module_view:
		compiler_module_view_find_imported_name,
		compiler_module_view_find_module_alias,
	declaration_skeleton:
		CompilerCallableId,
		CompilerConstructorId,
		CompilerDeclarationSkeletonGraph,
		CompilerDeclarationVisibility(CompilerPrivateDeclaration, CompilerPublicDeclaration),
		CompilerGlobalId,
		CompilerImplId,
		CompilerTraitId,
		CompilerTraitMethodId,
		CompilerTypeDeclarationSkeletonInfo,
		CompilerTypeDeclarationSource(
			CompilerAliasTypeSource,
