pure func type_resolution_owner_display_name(owner: TypeResolutionOwner) -> String:
	match owner:
		TypeDeclarationResolutionOwner(id):
			type_id_name(id)
		TraitMethodResolutionOwner(method_id):
			trait_id_name(trait_method_id_owner(method_id)) + "." + trait_method_id_name(method_id)
		CallableResolutionOwner(id):
			callable_id_name(id)
		GlobalResolutionOwner(id):
			global_id_name(id)
		ImplementationResolutionOwner(id):
			"implementation of " + impl_id_name(id)
		ImplementationMethodResolutionOwner(_, callable_id, _):
			callable_id_name(callable_id)


pure func type_shape_resolution_error_message(error: TypeShapeResolutionError) -> String:
	match error:
		TypeShapeOwnerModuleMissing(owner, _):
			"Type resolution owner module is missing for '" + type_resolution_owner_display_name(
				owner,
			) + "'"
		TypeShapeForeignTraitParameter(owner, parameter, _):
			"Trait method '" + type_resolution_owner_display_name(
				owner,
			) + "' cannot use type parameter '" + trait_type_parameter_id_name(
				parameter,
			) + "' owned by another trait"
		TypeShapeForeignCallableParameter(owner, parameter, _):
			"Callable '" + type_resolution_owner_display_name(
				owner,
			) + "' cannot use type parameter '" + callable_type_parameter_id_name(
				parameter,
			) + "' owned by another callable"
		TypeShapeForeignImplementationParameter(owner, parameter, _):
			"Implementation '" + type_resolution_owner_display_name(
				owner,
			) + "' cannot use type parameter '" + implementation_type_parameter_id_name(
				parameter,
			) + "' owned by another implementation"
		TypeShapeUnknownType(owner, name, _):
			"Unknown type '" + name + "' while resolving '" + type_resolution_owner_display_name(
				owner,
			) + "'"
		TypeShapeUnknownQualifier(owner, qualifier, _):
			"Unknown module qualifier '" + qualifier + "' while resolving '" + type_resolution_owner_display_name(
				owner,
			) + "'"
		TypeShapeImportedModuleMissing(owner, module_path, _):
			"Imported module '" + module_path + "' is missing while resolving '" + type_resolution_owner_display_name(
				owner,
			) + "'"
		TypeShapePrivateTypeReference(owner, referenced, _):
			"Declaration '" + type_resolution_owner_display_name(
				owner,
			) + "' cannot reference private imported type '" + module_identity_display_name(
				type_id_module_identity(referenced),
			) + "." + type_id_name(referenced) + "'"
		TypeShapeArityMismatch(owner, name, expected, actual, _):
			"Type '" + name + "' expects " + expected.to_string() + " argument(s), got " + actual.to_string() + " while resolving '" + type_resolution_owner_display_name(
				owner,
			) + "'"
		TypeShapeUnknownTypeParameter(owner, name, _):
			"Unknown type parameter '" + name + "' while resolving '" + type_resolution_owner_display_name(
				owner,
			) + "'"
		TypeShapeInvalidDimension(owner, value, _):
			"Invalid dimension '" + value + "' while resolving '" + type_resolution_owner_display_name(
				owner,
			) + "'"
		TypeShapeMissingType(owner, _):
			"Missing type while resolving '" + type_resolution_owner_display_name(owner) + "'"
		TypeShapeSelfNotAllowed(owner, _):
			"'Self' is not available while resolving '" + type_resolution_owner_display_name(
				owner,
			) + "'"


pure func type_shape_resolution_error_span(error: TypeShapeResolutionError) -> SourceSpan:
	match error:
		TypeShapeOwnerModuleMissing(_, span) | TypeShapeForeignTraitParameter(_, _, span) | TypeShapeForeignCallableParameter(_, _, span) | TypeShapeForeignImplementationParameter(_, _, span) | TypeShapeUnknownType(_, _, span) | TypeShapeUnknownQualifier(_, _, span) | TypeShapeImportedModuleMissing(_, _, span) | TypeShapePrivateTypeReference(_, _, span) | TypeShapeArityMismatch(_, _, _, _, span) | TypeShapeUnknownTypeParameter(_, _, span) | TypeShapeInvalidDimension(_, _, span) | TypeShapeMissingType(_, span) | TypeShapeSelfNotAllowed(_, span):
			span


pure func type_header_error_message(error: TypeHeaderError) -> String:
	match error:
		TypeHeaderOwnerModuleMissing(id):
			"Type header owner module is missing for '" + type_id_name(id) + "'"
		TypeHeaderParametersMissing(id):
			"Resolved type parameters are missing for '" + type_id_name(id) + "'"
		TypeHeaderResolutionError(resolution_error):
			type_shape_resolution_error_message(resolution_error)
		TypeHeaderConstructorMissing(id, name):
			"Constructor '" + name + "' is missing for type '" + type_id_name(id) + "'"
		TypeHeaderInvalidEnumTypeParameters(id):
			"Enum '" + type_id_name(id) + "' cannot have type parameters"
		TypeHeaderInvalidEnumVariantFields(_, name):
			"Enum variant '" + name + "' cannot have fields; use 'union' instead"
		TypeHeaderInvalidStructTypeParameters(id):
			"Struct '" + type_id_name(id) + "' cannot have type parameters"
		TypeHeaderEmptyStruct(id):
			"Struct '" + type_id_name(id) + "' must have at least one field"
		TypeHeaderInvalidStructField(id, field_name):
			"Struct '" + type_id_name(
				id,
			) + "' field '" + field_name + ("' has invalid storage: struct fields must be scalar values, fieldless enums, " + "or other structs\n" + "help: Use a record for strings, collections, functions, payload unions, " + "records, and tuples")
		TypeHeaderRecursiveValueLayout(id, is_direct):
			if is_direct:
				"Type '" + type_id_name(
					id,
				) + "' is directly recursive — this would require infinite memory"
			else:
				"Type '" + type_id_name(
					id,
				) + "' has a recursive value layout — every construction path requires another product value"
		TypeHeaderInlineStorageCycle(cycle):
			match cycle.get(0):
				None:
					"Infinitely sized value layout"
				Some(first):
					first_module = type_id_module_identity(first)
					local = cycle.all(func(id):
						module_identities_equal(type_id_module_identity(id), first_module)
					)

					names = if local:
						cycle.map(type_id_name)
					else:
						cycle.map(func(id):
							module_identity_display_name(
								type_id_module_identity(id),
							) + "." + type_id_name(id)
						)

					"Infinitely sized value layout: " + names.join(" -> ")


pure func type_header_error_span(error: TypeHeaderError) -> Option[SourceSpan]:
	match error:
		TypeHeaderOwnerModuleMissing(id) | TypeHeaderParametersMissing(id) | TypeHeaderConstructorMissing(id, _) | TypeHeaderInvalidEnumTypeParameters(id) | TypeHeaderInvalidEnumVariantFields(id, _) | TypeHeaderInvalidStructTypeParameters(id) | TypeHeaderEmptyStruct(id) | TypeHeaderInvalidStructField(id, _) | TypeHeaderRecursiveValueLayout(id, _):
			Some(type_id_source_span(id))
		TypeHeaderResolutionError(resolution_error):
			Some(type_shape_resolution_error_span(resolution_error))
		TypeHeaderInlineStorageCycle(cycle):
			cycle
				.get(0)
				.map(type_id_source_span)
