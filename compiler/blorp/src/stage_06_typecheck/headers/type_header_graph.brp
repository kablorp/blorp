-- Immutable, definition-owned type headers.
--
-- Named references are resolved to exact declaration identities. Compiler
-- intrinsics and owner-local type parameters have distinct identities, so a
-- later phase cannot confuse any of them by comparing source spellings.
import:
	../../stage_01_file_io/source: SourceSpan, source_spans_equal
	../../stage_03_parse/parsed_ast:
		ParsedBuiltinTypeDecl,
		ParsedDimBinaryOp(
			ParsedDimAddOp,
			ParsedDimDivideOp,
			ParsedDimMultiplyOp,
			ParsedDimSubtractOp,
		),
		ParsedFieldDecl,
		ParsedRecordDecl,
		ParsedResourceCleanup,
		ParsedTypeAliasDecl,
		ParsedTypeExpr(
			ParsedArrayType,
			ParsedBoundedType,
			ParsedDimBinaryType,
			ParsedDimLiteralType,
			ParsedDimNameType,
			ParsedFunctionType,
			ParsedMissingType,
			ParsedNamedType,
			ParsedQualifiedNamedType,
			ParsedRangeType,
			ParsedTupleType,
		),
		ParsedUnionDecl,
		ParsedVariantDecl,
		parsed_type_expr_span,
	../../stage_04_modules/loaded_module:
		ModuleIdentity,
		ModuleOrigin(StdlibModule),
		module_identities_equal,
		module_identity_display_name,
		module_identity_storage_key,
	../../stage_05_types/language_surface_manifest:
		BuiltinValueStorage(BuiltinInlineScalar, BuiltinManagedReference, BuiltinNoValue),
		PreludeType,
		builtin_value_storage,
		prelude_type,
		prelude_type_arity,
		prelude_type_has_inline_value_storage,
		prelude_type_is_resource,
		prelude_type_module_path,
	../graph/definition_identity: SourceDefinitionKind(FieldDefinition), source_definition_key
	../graph/definition_index: definition_index_find_source_definition_id
	../graph/indexed_graph:
		indexed_graph_definition_index,
		prepared_module_scope_canonical_path,
		prepared_module_scope_origin,
	../modules/bound_module_graph:
		BoundModule,
		BoundModuleGraph,
		bound_module_graph_find,
		bound_module_graph_find_canonical_path,
		bound_module_graph_indexed_graph,
		bound_module_identity,
		bound_module_program,
		bound_module_scope,
		bound_module_view,
	../modules/module_binding: importable_module_request_aliases
	../modules/module_view: module_view_find_imported_name, module_view_find_module_alias
	declaration_skeleton:
		CallableId,
		ConstructorId,
		DeclarationSkeletonGraph,
		DeclarationVisibility(PrivateDeclaration, PublicDeclaration),
		GlobalId,
		ImplId,
		TraitId,
		TraitMethodId,
		TypeDeclarationSkeletonInfo,
		TypeDeclarationSource(
			AliasTypeSource,
			BuiltinTypeSource,
			RecordTypeSource,
			UnionTypeSource,
		),
		TypeId,
		callable_id_module_identity,
		callable_id_name,
		callable_id_source_span,
		callable_ids_equal,
		declaration_skeleton_graph_bound_graph,
		declaration_skeleton_graph_constructor_skeletons,
		declaration_skeleton_graph_find_type,
		declaration_skeleton_graph_skeletons,
		declaration_skeleton_graph_type_skeletons,
		global_id_module_identity,
		global_id_name,
		impl_id_module_identity,
		impl_id_name,
		impl_ids_equal,
		trait_id_module_identity,
		trait_id_name,
		trait_ids_equal,
		trait_method_id_name,
		trait_method_id_owner,
		type_id_module_identity,
		type_id_name,
		type_id_source_span,
		type_ids_equal,
	type_header_dependencies: acyclic_type_alias_dependency_graph_declaration_graph
	type_parameter_headers:
		ResolvedTypeParameter,
		ResolvedTypeParameterGraph,
		TypeParameterId,
		resolved_type_parameter_graph_alias_dependencies,
		resolved_type_parameter_graph_find,
		type_parameter_id_name,
		type_parameter_ids_equal,


enum IntrinsicType:
	IntrinsicInt
	IntrinsicFloat
	IntrinsicBool
	IntrinsicString
	IntrinsicLiteralString
	IntrinsicChar
	IntrinsicVoid
	IntrinsicBytes
	IntrinsicPtr
	IntrinsicFixed
	IntrinsicInt8
	IntrinsicInt16
	IntrinsicInt32
	IntrinsicInt64
	IntrinsicInt128
	IntrinsicUInt8
	IntrinsicUInt16
	IntrinsicUInt32
	IntrinsicUInt64
	IntrinsicUInt128
	IntrinsicFloat32
	IntrinsicFloat16
	IntrinsicTensor
	IntrinsicOption
	IntrinsicResult
	IntrinsicConcurrencyError
	IntrinsicTaskResult
	IntrinsicChannel


enum ResolvedDimOp:
	ResolvedDimAdd
	ResolvedDimSubtract
	ResolvedDimMultiply
	ResolvedDimDivide


private record TraitTypeParameterIdRep {
	owner: TraitId,
	index: Int,
	name: String
}


opaque type TraitTypeParameterId = TraitTypeParameterIdRep


private record CallableTypeParameterIdRep {
	owner: CallableId,
	index: Int,
	name: String
}


opaque type CallableTypeParameterId = CallableTypeParameterIdRep


private record ImplementationTypeParameterIdRep {
	owner: ImplId,
	index: Int,
	name: String
}


opaque type ImplementationTypeParameterId = ImplementationTypeParameterIdRep


union ResolvedTypeShape:
	DeclaredTypeShape(TypeId, List[ResolvedTypeShape])
	IntrinsicTypeShape(IntrinsicType, List[ResolvedTypeShape])
	PreludeTypeShape(PreludeType, List[ResolvedTypeShape])
	TypeParameterShape(TypeParameterId)
	SelfTypeShape(TypeId)
	TraitTypeParameterShape(TraitTypeParameterId)
	CallableTypeParameterShape(CallableTypeParameterId)
	ImplementationTypeParameterShape(ImplementationTypeParameterId)
	TraitSelfTypeShape(TraitId)
	DimensionParameterShape(TypeParameterId, Bool)
	TraitDimensionParameterShape(TraitTypeParameterId, Bool)
	CallableDimensionParameterShape(CallableTypeParameterId, Bool)
	ImplementationDimensionParameterShape(ImplementationTypeParameterId, Bool)
	WildcardDimensionShape(Bool)
	DimensionLiteralShape(Int)
	DimensionBinaryShape(ResolvedDimOp, ResolvedTypeShape, ResolvedTypeShape)
	RangeTypeShape(ResolvedTypeShape)
	TupleTypeShape(List[ResolvedTypeShape])
	FunctionTypeShape(Bool, List[ResolvedTypeShape], ResolvedTypeShape)
	ArrayTypeShape(ResolvedTypeShape, List[ResolvedTypeShape])


union TypeResolutionOwner:
	TypeDeclarationResolutionOwner(TypeId)
	TraitMethodResolutionOwner(TraitMethodId)
	CallableResolutionOwner(CallableId)
	GlobalResolutionOwner(GlobalId)
	ImplementationResolutionOwner(ImplId)
	ImplementationMethodResolutionOwner(ImplId, CallableId, ResolvedTypeShape)


private union ResolutionTypeParameter:
	TypeDeclarationResolutionParameter(TypeParameterId)
	TraitResolutionParameter(TraitTypeParameterId)
	CallableResolutionParameter(CallableTypeParameterId)
	ImplementationResolutionParameter(ImplementationTypeParameterId)


union TypeShapeResolutionError:
	TypeShapeOwnerModuleMissing(TypeResolutionOwner, SourceSpan)
	TypeShapeForeignTraitParameter(TypeResolutionOwner, TraitTypeParameterId, SourceSpan)
	TypeShapeForeignCallableParameter(TypeResolutionOwner, CallableTypeParameterId, SourceSpan)
	TypeShapeForeignImplementationParameter(TypeResolutionOwner, ImplementationTypeParameterId, SourceSpan)
	TypeShapeUnknownType(TypeResolutionOwner, String, SourceSpan)
	TypeShapeUnknownQualifier(TypeResolutionOwner, String, SourceSpan)
	TypeShapeImportedModuleMissing(TypeResolutionOwner, String, SourceSpan)
	TypeShapePrivateTypeReference(TypeResolutionOwner, TypeId, SourceSpan)
	TypeShapeArityMismatch(TypeResolutionOwner, String, Int, Int, SourceSpan)
	TypeShapeUnknownTypeParameter(TypeResolutionOwner, String, SourceSpan)
	TypeShapeInvalidDimension(TypeResolutionOwner, String, SourceSpan)
	TypeShapeMissingType(TypeResolutionOwner, SourceSpan)
	TypeShapeSelfNotAllowed(TypeResolutionOwner, SourceSpan)


enum RecordLayout:
	HeapRecord
	ValueStruct


enum UnionLayout:
	TaggedUnion
	FieldlessEnum


enum AliasLayout:
	TransparentAlias
	OpaqueAlias


union ResourceCleanupPolicy:
	ResourceWithoutCleanup
	ResourceWithCleanup(String)


-- Builtin declarations carry storage ownership explicitly after header
-- resolution, and installation preserves scalar storage in Env. Source
-- declarations with a runtime ABI identity use the separate closed metadata in
-- language_surface_manifest and carry that identity explicitly through Core.
union BuiltinTypeLayout:
	ScalarBuiltin
	ManagedBuiltin
	NoValueBuiltin
	UnclassifiedBuiltin
	ResourceBuiltin(ResourceCleanupPolicy)


record TypeHeaderField {
	name: String,
	typ: ResolvedTypeShape,
	definition_id: Option[Int]
}


record TypeHeaderVariant {
	id: ConstructorId,
	parent_type_id: TypeId,
	name: String,
	tag: Int,
	fields: List[ResolvedTypeShape]
}


union TypeHeaderShape:
	RecordTypeHeader(RecordLayout, List[TypeHeaderField])
	UnionTypeHeader(UnionLayout, List[TypeHeaderVariant])
	BuiltinTypeHeader(BuiltinTypeLayout)
	AliasTypeHeader(AliasLayout, ResolvedTypeShape)


union DeclaredTypeExpansion:
	NominalDeclaredType
	TransparentAliasExpansion(List[ResolvedTypeParameter], ResolvedTypeShape)


struct TypeContainmentFacts {
	contains_resource: Bool,
	may_contain_function: Bool,
	may_contain_one_shot_stream: Bool,
	may_contain_resource_source: Bool
}


record TypeHeader {
	id: TypeId,
	parameters: List[ResolvedTypeParameter],
	shape: TypeHeaderShape,
	containment: TypeContainmentFacts
}


-- Category-specific projection used by environment installation. A caller
-- holding this value cannot accidentally install a record, union, or alias as
-- a builtin type.
private record AcceptedBuiltinHeaderRep {
	id: TypeId,
	parameters: List[ResolvedTypeParameter],
	layout: BuiltinTypeLayout,
	containment: TypeContainmentFacts
}


opaque type AcceptedBuiltinHeader = AcceptedBuiltinHeaderRep


-- Category-specific projection used by environment installation. Resolved
-- field types retain declaration identities until the installation boundary;
-- callers cannot construct or accidentally pass another header category.
private record AcceptedRecordHeaderRep {
	id: TypeId,
	parameters: List[ResolvedTypeParameter],
	layout: RecordLayout,
	fields: List[TypeHeaderField],
	containment: TypeContainmentFacts
}


opaque type AcceptedRecordHeader = AcceptedRecordHeaderRep


-- Constructor identity, tag, and payload shape remain one value through the
-- installation boundary, so the transitional Env cannot observe independently
-- reordered constructor-ID and variant lists.
private record AcceptedUnionHeaderRep {
	id: TypeId,
	parameters: List[ResolvedTypeParameter],
	layout: UnionLayout,
	variants: List[TypeHeaderVariant],
	containment: TypeContainmentFacts
}


opaque type AcceptedUnionHeader = AcceptedUnionHeaderRep


-- Alias layout and target remain coupled in the accepted projection. This
-- prevents installation from treating a transparent alias as nominal or an
-- opaque alias as expandable.
private record AcceptedAliasHeaderRep {
	id: TypeId,
	parameters: List[ResolvedTypeParameter],
	layout: AliasLayout,
	target: ResolvedTypeShape,
	containment: TypeContainmentFacts
}


opaque type AcceptedAliasHeader = AcceptedAliasHeaderRep


private enum HeaderVisibilitySelection:
	AllModuleHeaders
	PublicModuleHeaders


-- Header order remains graph order inside both inventories. The public subset
-- is derived from exact declaration identities when the table is built, so
-- projection cannot disagree with declaration visibility later.
private record ModuleTypeHeaderIndices {
	all_indices: List[Int],
	public_indices: List[Int]
}


-- This must remain ARC-managed: its fields own heap containers, and the table
-- is itself embedded in TypeHeaderGraphRep.
private record TypeHeaderTable {
	headers: List[TypeHeader],
	header_indices_by_name: Dict[String, List[Int]],
	header_indices_by_module: Dict[String, ModuleTypeHeaderIndices]
}


private record TypeHeaderGraphRep {
	parameter_graph: ResolvedTypeParameterGraph,
	table: TypeHeaderTable
}


opaque type TypeHeaderGraph = TypeHeaderGraphRep


union TypeHeaderError:
	TypeHeaderOwnerModuleMissing(TypeId)
	TypeHeaderParametersMissing(TypeId)
	TypeHeaderResolutionError(TypeShapeResolutionError)
	TypeHeaderConstructorMissing(TypeId, String)
	TypeHeaderInvalidEnumTypeParameters(TypeId)
	TypeHeaderInvalidEnumVariantFields(TypeId, String)
	TypeHeaderInvalidStructTypeParameters(TypeId)
	TypeHeaderEmptyStruct(TypeId)
	TypeHeaderInvalidStructField(TypeId, String)
	TypeHeaderRecursiveValueLayout(TypeId, Bool)
	TypeHeaderInlineStorageCycle(List[TypeId])


private record LayoutTypeSubstitution {
	parameter: TypeParameterId,
	replacement: ResolvedTypeShape
}


private record InlineLayoutDependency {
	id: TypeId,
	dependency_indices: List[Int]
}


private enum InlineLayoutVisitState:
	InlineLayoutUnvisited
	InlineLayoutVisiting
	InlineLayoutComplete


private record InlineLayoutFrame {
	node_index: Int,
	next_dependency_index: Int
}


private record TypeResolutionContext {
	declaration_graph: DeclarationSkeletonGraph,
	bound_graph: BoundModuleGraph,
	module: BoundModule,
	owner: TypeResolutionOwner,
	parameters: List[ResolutionTypeParameter]
}


-- Only the constructor in this module can wrap a generic resolution context
-- as callable-owned. Callers can therefore reuse it without repeating owner,
-- parameter, or module validation for every type expression in one signature.
opaque type CallableTypeResolutionContext = TypeResolutionContext


private record TypeHeaderBuildContext {
	owner: TypeId,
	resolution: TypeResolutionContext
}


private union ResolvedTypeResult:
	ResolvedTypeReady(ResolvedTypeShape)
	ResolvedTypeRejected(List[TypeShapeResolutionError])


private union ResolvedTypesResult:
	ResolvedTypesReady(List[ResolvedTypeShape])
	ResolvedTypesRejected(List[TypeShapeResolutionError])


private union TypeHeaderBuildResult:
	TypeHeaderReady(TypeHeader)
	TypeHeaderRejected(List[TypeHeaderError])


pure func trait_type_parameter_ids(
	owner: TraitId,
	names: List[String],
) -> List[TraitTypeParameterId]:
	var result: List[TraitTypeParameterId] = []
	var index: Int = 0

	for name in names:
		id: TraitTypeParameterId = into_opaque TraitTypeParameterId({
				owner = owner,
				index = index,
				name = name
			})
		result = result.append(id)
		index += 1

	result


private pure func trait_type_parameter_id_rep(id: TraitTypeParameterId) -> TraitTypeParameterIdRep:
	from_opaque TraitTypeParameterId(id)


pure func trait_type_parameter_id_owner(id: TraitTypeParameterId) -> TraitId:
	trait_type_parameter_id_rep(id).owner


pure func trait_type_parameter_id_index(id: TraitTypeParameterId) -> Int:
	trait_type_parameter_id_rep(id).index


pure func trait_type_parameter_id_name(id: TraitTypeParameterId) -> String:
	trait_type_parameter_id_rep(id).name


pure func trait_type_parameter_ids_equal(
	left: TraitTypeParameterId,
	right: TraitTypeParameterId,
) -> Bool:
	(
		trait_ids_equal(trait_type_parameter_id_owner(left), trait_type_parameter_id_owner(right))
		and trait_type_parameter_id_index(left) == trait_type_parameter_id_index(right)
	)


pure func callable_type_parameter_ids(
	owner: CallableId,
	names: List[String],
) -> List[CallableTypeParameterId]:
	var result: List[CallableTypeParameterId] = []
	var index: Int = 0

	for name in names:
		id: CallableTypeParameterId = into_opaque CallableTypeParameterId({
				owner = owner,
				index = index,
				name = name
			})
		result = result.append(id)
		index += 1

	result


private pure func callable_type_parameter_id_rep(
	id: CallableTypeParameterId,
) -> CallableTypeParameterIdRep:
	from_opaque CallableTypeParameterId(id)


pure func callable_type_parameter_id_owner(id: CallableTypeParameterId) -> CallableId:
	callable_type_parameter_id_rep(id).owner


pure func callable_type_parameter_id_index(id: CallableTypeParameterId) -> Int:
	callable_type_parameter_id_rep(id).index


pure func callable_type_parameter_id_name(id: CallableTypeParameterId) -> String:
	callable_type_parameter_id_rep(id).name


pure func callable_type_parameter_ids_equal(
	left: CallableTypeParameterId,
	right: CallableTypeParameterId,
) -> Bool:
	left_rep = callable_type_parameter_id_rep(left)
	right_rep = callable_type_parameter_id_rep(right)

	(
		callable_ids_equal(left_rep.owner, right_rep.owner)
		and left_rep.index == right_rep.index
		and left_rep.name == right_rep.name
	)


pure func implementation_type_parameter_ids(
	owner: ImplId,
	names: List[String],
) -> List[ImplementationTypeParameterId]:
	var result: List[ImplementationTypeParameterId] = []
	var index: Int = 0

	for name in names:
		id: ImplementationTypeParameterId = into_opaque ImplementationTypeParameterId({
				owner = owner,
				index = index,
				name = name
			})
		result = result.append(id)
		index += 1

	result


private pure func implementation_type_parameter_id_rep(
	id: ImplementationTypeParameterId,
) -> ImplementationTypeParameterIdRep:
	from_opaque ImplementationTypeParameterId(id)


pure func implementation_type_parameter_id_owner(id: ImplementationTypeParameterId) -> ImplId:
	implementation_type_parameter_id_rep(id).owner


pure func implementation_type_parameter_id_index(id: ImplementationTypeParameterId) -> Int:
	implementation_type_parameter_id_rep(id).index


pure func implementation_type_parameter_id_name(id: ImplementationTypeParameterId) -> String:
	implementation_type_parameter_id_rep(id).name


pure func implementation_type_parameter_ids_equal(
	left: ImplementationTypeParameterId,
	right: ImplementationTypeParameterId,
) -> Bool:
	left_rep = implementation_type_parameter_id_rep(left)
	right_rep = implementation_type_parameter_id_rep(right)

	(
		impl_ids_equal(left_rep.owner, right_rep.owner)
		and left_rep.index == right_rep.index
		and left_rep.name == right_rep.name
	)


private pure func resolution_parameter_name(parameter: ResolutionTypeParameter) -> String:
	match parameter:
		TypeDeclarationResolutionParameter(id):
			type_parameter_id_name(id)
		TraitResolutionParameter(id):
			trait_type_parameter_id_name(id)
		CallableResolutionParameter(id):
			callable_type_parameter_id_name(id)
		ImplementationResolutionParameter(id):
			implementation_type_parameter_id_name(id)


private pure func resolution_parameter_shape(
	parameter: ResolutionTypeParameter,
) -> ResolvedTypeShape:
	match parameter:
		TypeDeclarationResolutionParameter(id):
			TypeParameterShape(id)
		TraitResolutionParameter(id):
			TraitTypeParameterShape(id)
		CallableResolutionParameter(id):
			CallableTypeParameterShape(id)
		ImplementationResolutionParameter(id):
			ImplementationTypeParameterShape(id)


private pure func resolution_owner_self_shape(
	owner: TypeResolutionOwner,
) -> Option[ResolvedTypeShape]:
	match owner:
		TypeDeclarationResolutionOwner(id):
			Some(SelfTypeShape(id))
		TraitMethodResolutionOwner(method_id):
			Some(TraitSelfTypeShape(trait_method_id_owner(method_id)))
		CallableResolutionOwner(_):
			None
		GlobalResolutionOwner(_):
			None
		ImplementationResolutionOwner(_):
			None
		ImplementationMethodResolutionOwner(_, _, receiver):
			Some(receiver)


private pure func type_header_resolution_errors(
	errors: List[TypeShapeResolutionError],
) -> List[TypeHeaderError]:
	errors.map(func(error): TypeHeaderResolutionError(error))


private pure func intrinsic_type(name: String) -> Option[IntrinsicType]:
	match name:
		"Int":
			Some(IntrinsicInt)
		"Float":
			Some(IntrinsicFloat)
		"Bool":
			Some(IntrinsicBool)
		"String":
			Some(IntrinsicString)
		"LiteralString":
			Some(IntrinsicLiteralString)
		"Char":
			Some(IntrinsicChar)
		"Void":
			Some(IntrinsicVoid)
		"Bytes":
			Some(IntrinsicBytes)
		"Ptr":
			Some(IntrinsicPtr)
		"Fixed":
			Some(IntrinsicFixed)
		"Int8":
			Some(IntrinsicInt8)
		"Int16":
			Some(IntrinsicInt16)
		"Int32":
			Some(IntrinsicInt32)
		"Int64":
			Some(IntrinsicInt64)
		"Int128":
			Some(IntrinsicInt128)
		"UInt8":
			Some(IntrinsicUInt8)
		"UInt16":
			Some(IntrinsicUInt16)
		"UInt32":
			Some(IntrinsicUInt32)
		"UInt64":
			Some(IntrinsicUInt64)
		"UInt128":
			Some(IntrinsicUInt128)
		"Float32":
			Some(IntrinsicFloat32)
		"Float16":
			Some(IntrinsicFloat16)
		"Tensor":
			Some(IntrinsicTensor)
		"Option":
			Some(IntrinsicOption)
		"Result":
			Some(IntrinsicResult)
		"ConcurrencyError":
			Some(IntrinsicConcurrencyError)
		"TaskResult":
			Some(IntrinsicTaskResult)
		"Channel":
			Some(IntrinsicChannel)
		_:
			None


private pure func intrinsic_is_struct_scalar(intrinsic: IntrinsicType) -> Bool:
	match intrinsic:
		IntrinsicInt:
			True
		IntrinsicFloat:
			True
		IntrinsicBool:
			True
		IntrinsicChar:
			True
		IntrinsicPtr:
			True
		IntrinsicInt8:
			True
		IntrinsicInt16:
			True
		IntrinsicInt32:
			True
		IntrinsicInt64:
			True
		IntrinsicInt128:
			True
		IntrinsicUInt8:
			True
		IntrinsicUInt16:
			True
		IntrinsicUInt32:
			True
		IntrinsicUInt64:
			True
		IntrinsicUInt128:
			True
		IntrinsicFloat32:
			True
		IntrinsicFloat16:
			True
		_:
			False


private pure func intrinsic_type_arity(typ: IntrinsicType) -> Int:
	match typ:
		IntrinsicTensor:
			1
		IntrinsicOption:
			1
		IntrinsicResult:
			2
		IntrinsicTaskResult:
			1
		IntrinsicChannel:
			1
		_:
			0


pure func intrinsic_type_name(typ: IntrinsicType) -> String:
	match typ:
		IntrinsicInt:
			"Int"
		IntrinsicFloat:
			"Float"
		IntrinsicBool:
			"Bool"
		IntrinsicString:
			"String"
		IntrinsicLiteralString:
			"LiteralString"
		IntrinsicChar:
			"Char"
		IntrinsicVoid:
			"Void"
		IntrinsicBytes:
			"Bytes"
		IntrinsicPtr:
			"Ptr"
		IntrinsicFixed:
			"Fixed"
		IntrinsicInt8:
			"Int8"
		IntrinsicInt16:
			"Int16"
		IntrinsicInt32:
			"Int32"
		IntrinsicInt64:
			"Int64"
		IntrinsicInt128:
			"Int128"
		IntrinsicUInt8:
			"UInt8"
		IntrinsicUInt16:
			"UInt16"
		IntrinsicUInt32:
			"UInt32"
		IntrinsicUInt64:
			"UInt64"
		IntrinsicUInt128:
			"UInt128"
		IntrinsicFloat32:
			"Float32"
		IntrinsicFloat16:
			"Float16"
		IntrinsicTensor:
			"Tensor"
		IntrinsicOption:
			"Option"
		IntrinsicResult:
			"Result"
		IntrinsicConcurrencyError:
			"ConcurrencyError"
		IntrinsicTaskResult:
			"TaskResult"
		IntrinsicChannel:
			"Channel"


private pure func type_parameter_by_name(
	parameters: List[ResolutionTypeParameter],
	name: String,
) -> Option[ResolutionTypeParameter]:
	var result: Option[ResolutionTypeParameter] = None

	for parameter in parameters:
		if resolution_parameter_name(parameter) == name:
			result = Some(parameter)
			break

	result


private pure func parsed_dim_op(op: ParsedDimBinaryOp) -> ResolvedDimOp:
	match op:
		ParsedDimAddOp:
			ResolvedDimAdd
		ParsedDimSubtractOp:
			ResolvedDimSubtract
		ParsedDimMultiplyOp:
			ResolvedDimMultiply
		ParsedDimDivideOp:
			ResolvedDimDivide


private pure func parsed_type_parameter_count(skeleton: TypeDeclarationSkeletonInfo) -> Int:
	match skeleton.source:
		RecordTypeSource(decl):
			decl.type_params.length()
		UnionTypeSource(decl):
			decl.type_params.length()
		BuiltinTypeSource(decl):
			decl.type_params.length()
		AliasTypeSource(decl):
			decl.type_params.length()


private pure func declared_type_at_path(
	context: TypeResolutionContext,
	module_path: String,
	name: String,
	span: SourceSpan,
) -> Result[TypeDeclarationSkeletonInfo, TypeShapeResolutionError]:
	match bound_module_graph_find_canonical_path(context.bound_graph, module_path):
		None:
			Err(TypeShapeImportedModuleMissing(context.owner, module_path, span))
		Some(module):
			match declaration_skeleton_graph_find_type(
				context.declaration_graph,
				bound_module_identity(module),
				name,
			):
				None:
					Err(TypeShapeUnknownType(context.owner, name, span))
				Some(skeleton):
					if (
						skeleton.visibility == PrivateDeclaration
						and not module_identities_equal(
							bound_module_identity(context.module),
							bound_module_identity(module),
						)
					):
						Err(TypeShapePrivateTypeReference(context.owner, skeleton.id, span))
					else:
						Ok(skeleton)


private pure func declared_unqualified_type(
	context: TypeResolutionContext,
	name: String,
	span: SourceSpan,
) -> Result[Option[TypeDeclarationSkeletonInfo], TypeShapeResolutionError]:
	match declaration_skeleton_graph_find_type(
		context.declaration_graph,
		bound_module_identity(context.module),
		name,
	):
		Some(local):
			Ok(Some(local))
		None:
			match module_view_find_imported_name(bound_module_view(context.module), name):
				None:
					Ok(None)
				Some(binding):
					is_prelude_binding = match prelude_type(name):
						Some(prelude_type):
							(
								binding.original_name == name
								and binding.module_path == prelude_type_module_path(prelude_type)
							)
						None:
							False

					is_intrinsic_binding = (
						binding.original_name == name
						and intrinsic_type(name).is_some()
					)

					if (
						is_intrinsic_binding
						or (
							is_prelude_binding
							and bound_module_graph_find_canonical_path(
								context.bound_graph,
								binding.module_path,
							).is_none()
						)
					):
						Ok(None)
					else:
						match declared_type_at_path(
							context,
							binding.module_path,
							binding.original_name,
							span,
						):
							Ok(skeleton):
								Ok(Some(skeleton))
							Err(error):
								Err(error)


private pure func validate_type_arity(
	owner: TypeResolutionOwner,
	name: String,
	expected: Int,
	args: List[ResolvedTypeShape],
	span: SourceSpan,
) -> Option[TypeShapeResolutionError]:
	if expected == args.length():
		None
	else:
		Some(TypeShapeArityMismatch(owner, name, expected, args.length(), span))


private pure func resolved_skeleton_type(
	context: TypeResolutionContext,
	skeleton: TypeDeclarationSkeletonInfo,
	name: String,
	args: List[ResolvedTypeShape],
	span: SourceSpan,
) -> ResolvedTypeResult:
	match validate_type_arity(
		context.owner,
		name,
		parsed_type_parameter_count(skeleton),
		args,
		span,
	):
		Some(error):
			ResolvedTypeRejected([error])
		None:
			ResolvedTypeReady(DeclaredTypeShape(skeleton.id, args))


private pure func resolved_implicit_prelude_type(
	context: TypeResolutionContext,
	name: String,
	args: List[ResolvedTypeShape],
	span: SourceSpan,
) -> Option[ResolvedTypeResult]:
	match prelude_type(name):
		None:
			None
		Some(prelude_type):
			match validate_type_arity(
				context.owner,
				name,
				prelude_type_arity(prelude_type),
				args,
				span,
			):
				Some(error):
					Some(ResolvedTypeRejected([error]))
				None:
					Some(ResolvedTypeReady(PreludeTypeShape(prelude_type, args)))


-- Implicit callable parameters are admitted only for names that have no
-- semantic type binding in the callable's module. A present but invalid import
-- still reserves the name so the later resolver reports the import error
-- instead of silently changing it into a generic parameter.
pure func type_header_graph_has_unqualified_type_name(
	graph: TypeHeaderGraph,
	module: BoundModule,
	name: String,
) -> Bool:
	declaration_graph = type_header_graph_declaration_graph(graph)
	bound_graph = type_header_graph_bound_graph(graph)

	match declaration_skeleton_graph_find_type(
		declaration_graph,
		bound_module_identity(module),
		name,
	):
		Some(_):
			True
		None:
			match module_view_find_imported_name(bound_module_view(module), name):
				Some(_):
					True
				None:
					prelude_type(name).is_some() or intrinsic_type(name).is_some()


private pure func resolve_type_exprs(
	context: TypeResolutionContext,
	types: List[ParsedTypeExpr],
) -> ResolvedTypesResult:
	var resolved: List[ResolvedTypeShape] = []
	var errors: List[TypeShapeResolutionError] = []

	for typ in types:
		match resolve_type_expr(context, typ):
			ResolvedTypeReady(shape):
				resolved = resolved.append(shape)
			ResolvedTypeRejected(type_errors):
				errors = errors.concat(type_errors)

	if errors.is_empty():
		ResolvedTypesReady(resolved)
	else:
		ResolvedTypesRejected(errors)


private pure func resolve_named_type(
	context: TypeResolutionContext,
	name: String,
	args: List[ParsedTypeExpr],
	span: SourceSpan,
) -> ResolvedTypeResult:
	match resolve_type_exprs(context, args):
		ResolvedTypesRejected(errors):
			ResolvedTypeRejected(errors)
		ResolvedTypesReady(resolved_args):
			if name == "Self" and resolved_args.is_empty():
				match resolution_owner_self_shape(context.owner):
					Some(shape):
						ResolvedTypeReady(shape)
					None:
						ResolvedTypeRejected([TypeShapeSelfNotAllowed(context.owner, span)])
			else:
				match type_parameter_by_name(context.parameters, name):
					Some(parameter):
						match validate_type_arity(context.owner, name, 0, resolved_args, span):
							Some(error):
								ResolvedTypeRejected([error])
							None:
								ResolvedTypeReady(resolution_parameter_shape(parameter))
					None:
						match declared_unqualified_type(context, name, span):
							Err(error):
								ResolvedTypeRejected([error])
							Ok(Some(skeleton)):
								resolved_skeleton_type(context, skeleton, name, resolved_args, span)
							Ok(None):
								match resolved_implicit_prelude_type(
									context,
									name,
									resolved_args,
									span,
								):
									Some(result):
										result
									None:
										match intrinsic_type(name):
											Some(intrinsic):
												match validate_type_arity(
													context.owner,
													name,
													intrinsic_type_arity(intrinsic),
													resolved_args,
													span,
												):
													Some(error):
														ResolvedTypeRejected([error])
													None:
														ResolvedTypeReady(
															IntrinsicTypeShape(
																intrinsic,
																resolved_args,
															),
														)
											None:
												ResolvedTypeRejected(
													[
														TypeShapeUnknownType(
															context.owner,
															name,
															span,
														),
													],
												)


private pure func resolve_qualified_named_type(
	context: TypeResolutionContext,
	qualifier: String,
	name: String,
	args: List[ParsedTypeExpr],
	span: SourceSpan,
) -> ResolvedTypeResult:
	match resolve_type_exprs(context, args):
		ResolvedTypesRejected(errors):
			ResolvedTypeRejected(errors)
		ResolvedTypesReady(resolved_args):
			match module_view_find_module_alias(bound_module_view(context.module), qualifier):
				None:
					ResolvedTypeRejected(
						[TypeShapeUnknownQualifier(context.owner, qualifier, span)],
					)
				Some(module_path):
					match declared_type_at_path(context, module_path, name, span):
						Err(error):
							ResolvedTypeRejected([error])
						Ok(skeleton):
							resolved_skeleton_type(
								context,
								skeleton,
								qualifier + "." + name,
								resolved_args,
								span,
							)


private pure func combine_binary_dimension(
	op: ParsedDimBinaryOp,
	left: ResolvedTypeResult,
	right: ResolvedTypeResult,
) -> ResolvedTypeResult:
	match (left, right):
		(ResolvedTypeReady(left_shape), ResolvedTypeReady(right_shape)):
			ResolvedTypeReady(DimensionBinaryShape(parsed_dim_op(op), left_shape, right_shape))
		(ResolvedTypeRejected(left_errors), ResolvedTypeRejected(right_errors)):
			ResolvedTypeRejected(left_errors.concat(right_errors))
		(ResolvedTypeRejected(errors), _):
			ResolvedTypeRejected(errors)
		(_, ResolvedTypeRejected(errors)):
			ResolvedTypeRejected(errors)


private pure func map_single_shape(
	result: ResolvedTypeResult,
	mapper: pure (ResolvedTypeShape) -> ResolvedTypeShape,
) -> ResolvedTypeResult:
	match result:
		ResolvedTypeReady(shape):
			ResolvedTypeReady(mapper(shape))
		ResolvedTypeRejected(errors):
			ResolvedTypeRejected(errors)


private pure func resolve_type_expr(
	context: TypeResolutionContext,
	type_expr: ParsedTypeExpr,
) -> ResolvedTypeResult:
	match type_expr:
		ParsedNamedType(name, args, span):
			resolve_named_type(context, name.text, args, span)
		ParsedQualifiedNamedType(qualifier, name, args, span):
			resolve_qualified_named_type(context, qualifier.text, name.text, args, span)
		ParsedBoundedType(name, _, span):
			match type_parameter_by_name(context.parameters, name.text):
				Some(parameter):
					ResolvedTypeReady(resolution_parameter_shape(parameter))
				None:
					ResolvedTypeRejected(
						[TypeShapeUnknownTypeParameter(context.owner, name.text, span)],
					)
		ParsedDimNameType(name, is_variadic, span):
			if name.text == "#_":
				ResolvedTypeReady(WildcardDimensionShape(is_variadic))
			else:
				match type_parameter_by_name(context.parameters, name.text):
					Some(TypeDeclarationResolutionParameter(parameter_id)):
						ResolvedTypeReady(DimensionParameterShape(parameter_id, is_variadic))
					Some(TraitResolutionParameter(parameter_id)):
						ResolvedTypeReady(TraitDimensionParameterShape(parameter_id, is_variadic))
					Some(CallableResolutionParameter(parameter_id)):
						ResolvedTypeReady(
							CallableDimensionParameterShape(
								parameter_id,
								is_variadic,
							),
						)
					Some(ImplementationResolutionParameter(parameter_id)):
						ResolvedTypeReady(
							ImplementationDimensionParameterShape(
								parameter_id,
								is_variadic,
							),
						)
					None:
						ResolvedTypeRejected(
							[TypeShapeUnknownTypeParameter(context.owner, name.text, span)],
						)
		ParsedDimLiteralType(value, span):
			match value.parse_int():
				Some(number):
					ResolvedTypeReady(DimensionLiteralShape(number))
				None:
					ResolvedTypeRejected([TypeShapeInvalidDimension(context.owner, value, span)])
		ParsedDimBinaryType(op, left, right, _):
			combine_binary_dimension(
				op,
				resolve_type_expr(context, left),
				resolve_type_expr(context, right),
			)
		ParsedRangeType(inner, _):
			map_single_shape(resolve_type_expr(context, inner), func(shape): RangeTypeShape(shape))
		ParsedTupleType(elements, _):
			match resolve_type_exprs(context, elements):
				ResolvedTypesReady(shapes):
					ResolvedTypeReady(TupleTypeShape(shapes))
				ResolvedTypesRejected(errors):
					ResolvedTypeRejected(errors)
		ParsedFunctionType(is_pure, params, return_type, _):
			match (resolve_type_exprs(context, params), resolve_type_expr(context, return_type)):
				(ResolvedTypesReady(param_shapes), ResolvedTypeReady(return_shape)):
					ResolvedTypeReady(FunctionTypeShape(is_pure, param_shapes, return_shape))
				(ResolvedTypesRejected(errors), ResolvedTypeRejected(return_errors)):
					ResolvedTypeRejected(errors.concat(return_errors))
				(ResolvedTypesRejected(errors), _):
					ResolvedTypeRejected(errors)
				(_, ResolvedTypeRejected(errors)):
					ResolvedTypeRejected(errors)
		ParsedArrayType(element, dims, _):
			match (resolve_type_expr(context, element), resolve_type_exprs(context, dims)):
				(ResolvedTypeReady(element_shape), ResolvedTypesReady(dim_shapes)):
					ResolvedTypeReady(ArrayTypeShape(element_shape, dim_shapes))
				(ResolvedTypeRejected(errors), ResolvedTypesRejected(dim_errors)):
					ResolvedTypeRejected(errors.concat(dim_errors))
				(ResolvedTypeRejected(errors), _):
					ResolvedTypeRejected(errors)
				(_, ResolvedTypesRejected(errors)):
					ResolvedTypeRejected(errors)
		ParsedMissingType(span):
			ResolvedTypeRejected([TypeShapeMissingType(context.owner, span)])


private pure func prepare_owned_type_resolution_context(
	graph: TypeHeaderGraph,
	owner_module_identity: ModuleIdentity,
	owner: TypeResolutionOwner,
	parameters: List[ResolutionTypeParameter],
	diagnostic_span: SourceSpan,
) -> Result[TypeResolutionContext, List[TypeShapeResolutionError]]:
	declaration_graph = type_header_graph_declaration_graph(graph)
	bound_graph = type_header_graph_bound_graph(graph)

	match bound_module_graph_find(bound_graph, owner_module_identity):
		None:
			Err([TypeShapeOwnerModuleMissing(owner, diagnostic_span)])
		Some(module):
			context: TypeResolutionContext = {
				declaration_graph = declaration_graph,
				bound_graph = bound_graph,
				module = module,
				owner = owner,
				parameters = parameters
			}
			Ok(context)


private pure func resolve_prepared_type_shape(
	context: TypeResolutionContext,
	type_expr: ParsedTypeExpr,
) -> Result[ResolvedTypeShape, List[TypeShapeResolutionError]]:
	match resolve_type_expr(context, type_expr):
		ResolvedTypeReady(shape):
			Ok(shape)
		ResolvedTypeRejected(errors):
			Err(errors)


private pure func resolve_owned_type_shape(
	graph: TypeHeaderGraph,
	owner_module_identity: ModuleIdentity,
	owner: TypeResolutionOwner,
	parameters: List[ResolutionTypeParameter],
	type_expr: ParsedTypeExpr,
) -> Result[ResolvedTypeShape, List[TypeShapeResolutionError]]:
	match prepare_owned_type_resolution_context(
		graph,
		owner_module_identity,
		owner,
		parameters,
		parsed_type_expr_span(type_expr),
	):
		Err(errors):
			Err(errors)
		Ok(context):
			resolve_prepared_type_shape(context, type_expr)


pure func prepare_callable_type_resolution_context(
	graph: TypeHeaderGraph,
	callable_id: CallableId,
	parameters: List[CallableTypeParameterId],
) -> Result[CallableTypeResolutionContext, List[TypeShapeResolutionError]]:
	owner = CallableResolutionOwner(callable_id)
	diagnostic_span = callable_id_source_span(callable_id)
	foreign_parameter = parameters.find(func(parameter):
		not callable_ids_equal(callable_type_parameter_id_owner(parameter), callable_id)
	)

	match foreign_parameter:
		Some(parameter):
			Err([TypeShapeForeignCallableParameter(owner, parameter, diagnostic_span)])
		None:
			match prepare_owned_type_resolution_context(
				graph,
				callable_id_module_identity(callable_id),
				owner,
				parameters.map(func(parameter): CallableResolutionParameter(parameter)),
				diagnostic_span,
			):
				Err(errors):
					Err(errors)
				Ok(context):
					Ok(into_opaque CallableTypeResolutionContext(context))


pure func resolve_callable_type_shape_in_context(
	context: CallableTypeResolutionContext,
	type_expr: ParsedTypeExpr,
) -> Result[ResolvedTypeShape, List[TypeShapeResolutionError]]:
	resolve_prepared_type_shape(from_opaque CallableTypeResolutionContext(context), type_expr)


pure func resolve_trait_method_type_shape(
	graph: TypeHeaderGraph,
	method_id: TraitMethodId,
	parameters: List[TraitTypeParameterId],
	type_expr: ParsedTypeExpr,
) -> Result[ResolvedTypeShape, List[TypeShapeResolutionError]]:
	trait_id = trait_method_id_owner(method_id)
	owner = TraitMethodResolutionOwner(method_id)
	foreign_parameter = parameters.find(func(parameter):
		not trait_ids_equal(trait_type_parameter_id_owner(parameter), trait_id)
	)

	match foreign_parameter:
		Some(parameter):
			Err(
				[
					TypeShapeForeignTraitParameter(
						owner,
						parameter,
						parsed_type_expr_span(type_expr),
					),
				],
			)
		None:
			resolve_owned_type_shape(
				graph,
				trait_id_module_identity(trait_id),
				owner,
				parameters.map(func(parameter): TraitResolutionParameter(parameter)),
				type_expr,
			)


pure func resolve_global_type_shape(
	graph: TypeHeaderGraph,
	global_id: GlobalId,
	type_expr: ParsedTypeExpr,
) -> Result[ResolvedTypeShape, List[TypeShapeResolutionError]]:
	resolve_owned_type_shape(
		graph,
		global_id_module_identity(global_id),
		GlobalResolutionOwner(global_id),
		[],
		type_expr,
	)


pure func resolve_implementation_type_shape(
	graph: TypeHeaderGraph,
	implementation_id: ImplId,
	parameters: List[ImplementationTypeParameterId],
	type_expr: ParsedTypeExpr,
) -> Result[ResolvedTypeShape, List[TypeShapeResolutionError]]:
	owner = ImplementationResolutionOwner(implementation_id)
	foreign_parameter = parameters.find(func(parameter):
		not impl_ids_equal(implementation_type_parameter_id_owner(parameter), implementation_id)
	)

	match foreign_parameter:
		Some(parameter):
			Err(
				[
					TypeShapeForeignImplementationParameter(
						owner,
						parameter,
						parsed_type_expr_span(type_expr),
					),
				],
			)
		None:
			resolve_owned_type_shape(
				graph,
				impl_id_module_identity(implementation_id),
				owner,
				parameters.map(func(parameter): ImplementationResolutionParameter(parameter)),
				type_expr,
			)


pure func resolve_implementation_method_type_shape(
	graph: TypeHeaderGraph,
	implementation_id: ImplId,
	implementation_parameters: List[ImplementationTypeParameterId],
	callable_id: CallableId,
	callable_parameters: List[CallableTypeParameterId],
	receiver: ResolvedTypeShape,
	type_expr: ParsedTypeExpr,
) -> Result[ResolvedTypeShape, List[TypeShapeResolutionError]]:
	owner = ImplementationMethodResolutionOwner(implementation_id, callable_id, receiver)
	foreign_implementation_parameter = implementation_parameters.find(func(parameter):
		not impl_ids_equal(implementation_type_parameter_id_owner(parameter), implementation_id)
	)
	foreign_callable_parameter = callable_parameters.find(func(parameter):
		not callable_ids_equal(callable_type_parameter_id_owner(parameter), callable_id)
	)

	match (foreign_implementation_parameter, foreign_callable_parameter):
		(Some(parameter), _):
			Err(
				[
					TypeShapeForeignImplementationParameter(
						owner,
						parameter,
						parsed_type_expr_span(type_expr),
					),
				],
			)
		(_, Some(parameter)):
			Err(
				[
					TypeShapeForeignCallableParameter(
						owner,
						parameter,
						parsed_type_expr_span(type_expr),
					),
				],
			)
		(None, None):
			resolve_owned_type_shape(
				graph,
				impl_id_module_identity(implementation_id),
				owner,
				implementation_parameters
					.map(func(parameter): ImplementationResolutionParameter(parameter))
					.concat(callable_parameters.map(
						func(parameter): CallableResolutionParameter(parameter),
					)),
				type_expr,
			)


private pure func resolve_fields(
	context: TypeHeaderBuildContext,
	fields: List[ParsedFieldDecl],
) -> Result[List[TypeHeaderField], List[TypeHeaderError]]:
	var resolved: List[TypeHeaderField] = []
	var errors: List[TypeHeaderError] = []
	definition_index = indexed_graph_definition_index(
		bound_module_graph_indexed_graph(context.resolution.bound_graph),
	)

	for field in fields:
		match resolve_type_expr(context.resolution, field.type_expr):
			ResolvedTypeReady(shape):
				resolved = resolved.append({
					name = field.name.text,
					typ = shape,
					definition_id = definition_index_find_source_definition_id(
						definition_index,
						source_definition_key(
							type_id_module_identity(context.owner),
							FieldDefinition,
							field.name.text,
							Some(type_id_name(context.owner)),
							field.span,
						),
					),
				})
			ResolvedTypeRejected(field_errors):
				errors = errors.concat(type_header_resolution_errors(field_errors))

	if errors.is_empty():
		Ok(resolved)
	else:
		Err(errors)


private pure func constructor_for_variant(
	declaration_graph: DeclarationSkeletonGraph,
	parent_type_id: TypeId,
	variant: ParsedVariantDecl,
) -> Option[ConstructorId]:
	var result: Option[ConstructorId] = None

	for constructor in declaration_skeleton_graph_constructor_skeletons(declaration_graph):
		if (
			type_ids_equal(constructor.parent_type_id, parent_type_id)
			and constructor.source.name.text == variant.name.text
			and source_spans_equal(constructor.source.span, variant.span)
		):
			result = Some(constructor.id)
			break

	result


private pure func resolve_variants(
	context: TypeHeaderBuildContext,
	variants: List[ParsedVariantDecl],
) -> Result[List[TypeHeaderVariant], List[TypeHeaderError]]:
	var resolved: List[TypeHeaderVariant] = []
	var errors: List[TypeHeaderError] = []
	var tag: Int = 0

	for variant in variants:
		constructor = constructor_for_variant(
			context.resolution.declaration_graph,
			context.owner,
			variant,
		)
		fields = resolve_type_exprs(context.resolution, variant.fields)

		match (constructor, fields):
			(Some(constructor_id), ResolvedTypesReady(field_shapes)):
				resolved = resolved.append({
					id = constructor_id,
					parent_type_id = context.owner,
					name = variant.name.text,
					tag = tag,
					fields = field_shapes,
				})
			(None, ResolvedTypesReady(_)):
				errors = errors.append(
					TypeHeaderConstructorMissing(
						context.owner,
						variant.name.text,
					),
				)
			(Some(_), ResolvedTypesRejected(field_errors)):
				errors = errors.concat(type_header_resolution_errors(field_errors))
			(None, ResolvedTypesRejected(field_errors)):
				errors = errors
					.append(TypeHeaderConstructorMissing(context.owner, variant.name.text))
					.concat(type_header_resolution_errors(field_errors))

		tag += 1

	if errors.is_empty():
		Ok(resolved)
	else:
		Err(errors)


private pure func resource_cleanup_policy(
	cleanup: Option[ParsedResourceCleanup],
) -> ResourceCleanupPolicy:
	match cleanup:
		Some(value):
			ResourceWithCleanup(value.builtin_name)
		None:
			ResourceWithoutCleanup


private EMPTY_TYPE_CONTAINMENT_FACTS: TypeContainmentFacts = {
	contains_resource = False,
	may_contain_function = False,
	may_contain_one_shot_stream = False,
	may_contain_resource_source = False
}


private pure func builtin_type_containment_facts(
	context: TypeHeaderBuildContext,
	is_resource: Bool,
) -> TypeContainmentFacts:
	is_stdlib_module = match prepared_module_scope_origin(
		bound_module_scope(context.resolution.module),
	):
		StdlibModule:
			True
		_:
			False

	-- Keep the managed canonical-path projection inside the comparison. Binding it
	-- to a local currently leaves one retained String in generated leak-check
	-- binaries; that ownership-lowering hole is separate from header facts.
	is_stream_module = (
		is_stdlib_module
		and prepared_module_scope_canonical_path(
			bound_module_scope(context.resolution.module),
		) == "std/stream"
	)

	(may_contain_one_shot_stream, may_contain_resource_source) = if is_stream_module:
		match type_id_name(context.owner):
			"Stream" | "FallibleStream":
				(True, False)
			"ResourceSource":
				(False, True)
			_:
				(False, False)
	else:
		(False, False)

	{
		contains_resource = is_resource,
		may_contain_function = False,
		may_contain_one_shot_stream = may_contain_one_shot_stream,
		may_contain_resource_source = may_contain_resource_source
	}


private pure func build_record_header(
	context: TypeHeaderBuildContext,
	parameters: List[ResolvedTypeParameter],
	decl: ParsedRecordDecl,
) -> TypeHeaderBuildResult:
	var errors: List[TypeHeaderError] = []

	if decl.is_struct and not parameters.is_empty():
		errors = errors.append(TypeHeaderInvalidStructTypeParameters(context.owner))

	if decl.is_struct and decl.fields.is_empty():
		errors = errors.append(TypeHeaderEmptyStruct(context.owner))

	match resolve_fields(context, decl.fields):
		Err(field_errors):
			TypeHeaderRejected(errors.concat(field_errors))
		Ok(fields):
			if errors.is_empty():
				layout = if decl.is_struct:
					ValueStruct
				else:
					HeapRecord

				TypeHeaderReady({
					id = context.owner,
					parameters = parameters,
					shape = RecordTypeHeader(layout, fields),
					containment = EMPTY_TYPE_CONTAINMENT_FACTS,
				})
			else:
				TypeHeaderRejected(errors)


private pure func build_union_header(
	context: TypeHeaderBuildContext,
	parameters: List[ResolvedTypeParameter],
	decl: ParsedUnionDecl,
) -> TypeHeaderBuildResult:
	var errors: List[TypeHeaderError] = []

	if decl.is_enum and not parameters.is_empty():
		errors = errors.append(TypeHeaderInvalidEnumTypeParameters(context.owner))

	if decl.is_enum:
		for variant in decl.variants:
			if not variant.fields.is_empty():
				errors = errors.append(
					TypeHeaderInvalidEnumVariantFields(
						context.owner,
						variant.name.text,
					),
				)

	match resolve_variants(context, decl.variants):
		Err(variant_errors):
			TypeHeaderRejected(errors.concat(variant_errors))
		Ok(variants):
			if errors.is_empty():
				layout = if decl.is_enum:
					FieldlessEnum
				else:
					TaggedUnion

				TypeHeaderReady({
					id = context.owner,
					parameters = parameters,
					shape = UnionTypeHeader(layout, variants),
					containment = EMPTY_TYPE_CONTAINMENT_FACTS,
				})
			else:
				TypeHeaderRejected(errors)


private pure func build_builtin_header(
	context: TypeHeaderBuildContext,
	parameters: List[ResolvedTypeParameter],
	decl: ParsedBuiltinTypeDecl,
) -> TypeHeaderBuildResult:
	layout: BuiltinTypeLayout = if decl.is_resource:
		ResourceBuiltin(resource_cleanup_policy(decl.cleanup))
	else:
		match builtin_value_storage(
			bound_module_program(context.resolution.module).source.module_name,
			type_id_name(context.owner),
		):
			Some(BuiltinInlineScalar):
				ScalarBuiltin
			Some(BuiltinManagedReference):
				ManagedBuiltin
			Some(BuiltinNoValue):
				NoValueBuiltin
			None:
				UnclassifiedBuiltin

	TypeHeaderReady({
		id = context.owner,
		parameters = parameters,
		shape = BuiltinTypeHeader(layout),
		containment = builtin_type_containment_facts(context, decl.is_resource),
	})


private pure func build_alias_header(
	context: TypeHeaderBuildContext,
	parameters: List[ResolvedTypeParameter],
	decl: ParsedTypeAliasDecl,
) -> TypeHeaderBuildResult:
	match resolve_type_expr(context.resolution, decl.target):
		ResolvedTypeRejected(errors):
			TypeHeaderRejected(type_header_resolution_errors(errors))
		ResolvedTypeReady(target):
			layout = if decl.is_opaque:
				OpaqueAlias
			else:
				TransparentAlias

			TypeHeaderReady({
				id = context.owner,
				parameters = parameters,
				shape = AliasTypeHeader(layout, target),
				containment = EMPTY_TYPE_CONTAINMENT_FACTS,
			})


private pure func build_type_header(
	parameter_graph: ResolvedTypeParameterGraph,
	skeleton: TypeDeclarationSkeletonInfo,
) -> TypeHeaderBuildResult:
	declaration_graph = acyclic_type_alias_dependency_graph_declaration_graph(
		resolved_type_parameter_graph_alias_dependencies(parameter_graph),
	)
	bound_graph = declaration_skeleton_graph_bound_graph(declaration_graph)

	match bound_module_graph_find(bound_graph, type_id_module_identity(skeleton.id)):
		None:
			TypeHeaderRejected([TypeHeaderOwnerModuleMissing(skeleton.id)])
		Some(module):
			match resolved_type_parameter_graph_find(parameter_graph, skeleton.id):
				None:
					TypeHeaderRejected([TypeHeaderParametersMissing(skeleton.id)])
				Some(parameter_entry):
					resolution: TypeResolutionContext = {
						declaration_graph = declaration_graph,
						bound_graph = bound_graph,
						module = module,
						owner = TypeDeclarationResolutionOwner(skeleton.id),
						parameters = parameter_entry.parameters.map(
							func(parameter): TypeDeclarationResolutionParameter(parameter.id),
						)
					}
					context: TypeHeaderBuildContext = {
						owner = skeleton.id,
						resolution = resolution
					}

					match skeleton.source:
						RecordTypeSource(decl):
							build_record_header(context, parameter_entry.parameters, decl)
						UnionTypeSource(decl):
							build_union_header(context, parameter_entry.parameters, decl)
						BuiltinTypeSource(decl):
							build_builtin_header(context, parameter_entry.parameters, decl)
						AliasTypeSource(decl):
							build_alias_header(context, parameter_entry.parameters, decl)


private pure func type_header_is_public(
	declaration_graph: DeclarationSkeletonGraph,
	header: TypeHeader,
) -> Bool:
	declaration_skeleton_graph_find_type(
		declaration_graph,
		type_id_module_identity(header.id),
		type_id_name(header.id),
	)
		.map(func(skeleton): skeleton.visibility == PublicDeclaration)
		.get_or(False)


private pure func module_type_header_indices_add(
	inventories: Dict[String, ModuleTypeHeaderIndices],
	module_identity: ModuleIdentity,
	header_index: Int,
	is_public: Bool,
) -> Dict[String, ModuleTypeHeaderIndices]:
	key = module_identity_storage_key(module_identity)
	inventory: ModuleTypeHeaderIndices = inventories.get_or(
		key,
		{
			all_indices = [],
			public_indices = []
		},
	)

	public_indices = if is_public:
		inventory.public_indices.append(header_index)
	else:
		inventory.public_indices

	inventories.set(
		key,
		{
			all_indices = inventory.all_indices.append(header_index),
			public_indices = public_indices
		},
	)


private pure func type_header_table(
	headers: List[TypeHeader],
	declaration_graph: DeclarationSkeletonGraph,
) -> TypeHeaderTable:
	var header_indices_by_name: Dict[String, List[Int]] = {}
	var header_indices_by_module: Dict[String, ModuleTypeHeaderIndices] = {}
	var index: Int = 0

	for header in headers:
		name = type_id_name(header.id)
		header_indices_by_name = header_indices_by_name.set(
			name,
			header_indices_by_name
				.get_or(name, [])
				.append(index),
		)
		header_indices_by_module = module_type_header_indices_add(
			header_indices_by_module,
			type_id_module_identity(header.id),
			index,
			type_header_is_public(declaration_graph, header),
		)
		index += 1

	{
		headers = headers,
		header_indices_by_name = header_indices_by_name,
		header_indices_by_module = header_indices_by_module
	}


private pure func type_header_table_module_indices(
	table: TypeHeaderTable,
	module_identity: ModuleIdentity,
	selection: HeaderVisibilitySelection,
) -> List[Int]:
	match table.header_indices_by_module.get(module_identity_storage_key(module_identity)):
		Some(inventory):
			match selection:
				AllModuleHeaders:
					inventory.all_indices
				PublicModuleHeaders:
					inventory.public_indices
		None:
			[]


private pure func type_header_table_index(table: TypeHeaderTable, id: TypeId) -> Option[Int]:
	var result: Option[Int] = None

	for index in table.header_indices_by_name.get_or(type_id_name(id), []):
		match table.headers.get(index):
			Some(header):
				if type_ids_equal(header.id, id):
					result = Some(index)
					break
			None:
				void

	result


private pure func type_header_table_find(table: TypeHeaderTable, id: TypeId) -> Option[TypeHeader]:
	match type_header_table_index(table, id):
		Some(index):
			table.headers.get(index)
		None:
			None


private pure func append_unique_type_id(ids: List[TypeId], id: TypeId) -> List[TypeId]:
	if ids.any(func(existing): type_ids_equal(existing, id)):
		ids
	else:
		ids.append(id)


private pure func concat_unique_type_ids(left: List[TypeId], right: List[TypeId]) -> List[TypeId]:
	var result = left

	for id in right:
		result = append_unique_type_id(result, id)

	result


private pure func layout_substitution_find(
	substitutions: List[LayoutTypeSubstitution],
	parameter: TypeParameterId,
) -> Option[ResolvedTypeShape]:
	var result: Option[ResolvedTypeShape] = None

	for substitution in substitutions:
		if type_parameter_ids_equal(substitution.parameter, parameter):
			result = Some(substitution.replacement)
			break

	result


private pure func layout_alias_substitutions(
	parameters: List[ResolvedTypeParameter],
	args: List[ResolvedTypeShape],
	outer: List[LayoutTypeSubstitution],
) -> List[LayoutTypeSubstitution]:
	var result = outer
	var index: Int = 0

	while index < parameters.length():
		match (parameters.get(index), args.get(index)):
			(Some(parameter), Some(arg)):
				result = [
					{
						parameter = parameter.id,
						replacement = arg
					},
				].concat(result)
			_:
				void

		index += 1

	result


-- This classification mirrors the exhaustive stack/heap cases in
-- stage_09_core/c_type_layout.brp. Keep every variant explicit so adding
-- a new type representation fails compilation here until its storage edge is
-- deliberately classified. The codegen audit pins the accepted heap cases.
private pure func resolved_shape_supports_stack_option(
	table: TypeHeaderTable,
	shape: ResolvedTypeShape,
	substitutions: List[LayoutTypeSubstitution],
) -> Bool:
	match shape:
		DeclaredTypeShape(id, args):
			match type_header_table_find(table, id):
				Some(header):
					match header.shape:
						RecordTypeHeader(ValueStruct, _):
							True
						RecordTypeHeader(HeapRecord, _):
							False
						UnionTypeHeader(FieldlessEnum, _):
							True
						UnionTypeHeader(TaggedUnion, _):
							False
						AliasTypeHeader(_, target):
							resolved_shape_supports_stack_option(
								table,
								target,
								layout_alias_substitutions(header.parameters, args, substitutions),
							)
						BuiltinTypeHeader(_):
							False
				None:
					False
		IntrinsicTypeShape(intrinsic, args):
			if not args.is_empty():
				False
			else:
				match intrinsic:
					IntrinsicInt | IntrinsicFloat | IntrinsicBool | IntrinsicChar | IntrinsicVoid | IntrinsicInt8 | IntrinsicInt16 | IntrinsicInt32 | IntrinsicInt64 | IntrinsicInt128 | IntrinsicUInt8 | IntrinsicUInt16 | IntrinsicUInt32 | IntrinsicUInt64 | IntrinsicUInt128 | IntrinsicFloat32 | IntrinsicFloat16:
						True
					IntrinsicString | IntrinsicLiteralString | IntrinsicBytes | IntrinsicPtr | IntrinsicFixed | IntrinsicTensor | IntrinsicOption | IntrinsicResult | IntrinsicConcurrencyError | IntrinsicTaskResult | IntrinsicChannel:
						False
		TypeParameterShape(parameter):
			match layout_substitution_find(substitutions, parameter):
				Some(replacement):
					resolved_shape_supports_stack_option(table, replacement, substitutions)
				None:
					False
		SelfTypeShape(id):
			resolved_shape_supports_stack_option(
				table,
				DeclaredTypeShape(id, []),
				substitutions,
			)
		TraitTypeParameterShape(_) | TraitSelfTypeShape(_) | TraitDimensionParameterShape(_, _) | CallableTypeParameterShape(_) | CallableDimensionParameterShape(_, _) | ImplementationTypeParameterShape(_) | ImplementationDimensionParameterShape(_, _) | WildcardDimensionShape(_):
			False
		RangeTypeShape(_):
			True
		PreludeTypeShape(_, _) | DimensionParameterShape(_, _) | DimensionLiteralShape(_) | DimensionBinaryShape(_, _, _) | TupleTypeShape(_) | FunctionTypeShape(_, _, _) | ArrayTypeShape(_, _):
			False


private pure func resolved_shape_inline_dependencies(
	table: TypeHeaderTable,
	shape: ResolvedTypeShape,
	substitutions: List[LayoutTypeSubstitution],
) -> List[TypeId]:
	match shape:
		DeclaredTypeShape(id, args):
			match type_header_table_find(table, id):
				Some(header):
					match header.shape:
						RecordTypeHeader(ValueStruct, _):
							[id]
						RecordTypeHeader(HeapRecord, _):
							[]
						AliasTypeHeader(_, target):
							resolved_shape_inline_dependencies(
								table,
								target,
								layout_alias_substitutions(header.parameters, args, substitutions),
							)
						UnionTypeHeader(_, _) | BuiltinTypeHeader(_):
							[]
				None:
					[]
		IntrinsicTypeShape(intrinsic, args):
			match intrinsic:
				IntrinsicResult | IntrinsicTaskResult:
					resolved_shapes_inline_dependencies(table, args, substitutions)
				IntrinsicOption:
					match args:
						[payload]:
							if resolved_shape_supports_stack_option(table, payload, substitutions):
								resolved_shape_inline_dependencies(table, payload, substitutions)
							else:
								[]
						_:
							[]
				IntrinsicInt | IntrinsicFloat | IntrinsicBool | IntrinsicString | IntrinsicLiteralString | IntrinsicChar | IntrinsicVoid | IntrinsicBytes | IntrinsicPtr | IntrinsicFixed | IntrinsicInt8 | IntrinsicInt16 | IntrinsicInt32 | IntrinsicInt64 | IntrinsicInt128 | IntrinsicUInt8 | IntrinsicUInt16 | IntrinsicUInt32 | IntrinsicUInt64 | IntrinsicUInt128 | IntrinsicFloat32 | IntrinsicFloat16 | IntrinsicTensor | IntrinsicConcurrencyError | IntrinsicChannel:
					[]
		TypeParameterShape(parameter):
			match layout_substitution_find(substitutions, parameter):
				Some(replacement):
					resolved_shape_inline_dependencies(table, replacement, substitutions)
				None:
					[]
		SelfTypeShape(id):
			resolved_shape_inline_dependencies(
				table,
				DeclaredTypeShape(id, []),
				substitutions,
			)
		TraitTypeParameterShape(_) | TraitSelfTypeShape(_) | TraitDimensionParameterShape(_, _) | CallableTypeParameterShape(_) | CallableDimensionParameterShape(_, _) | ImplementationTypeParameterShape(_) | ImplementationDimensionParameterShape(_, _) | WildcardDimensionShape(_):
			[]
		PreludeTypeShape(_, _) | DimensionParameterShape(_, _) | DimensionLiteralShape(_) | DimensionBinaryShape(_, _, _) | RangeTypeShape(_) | TupleTypeShape(_) | FunctionTypeShape(_, _, _) | ArrayTypeShape(_, _):
			-- Tuples and tensors are ARC-managed heap layouts in current Core.
			-- Function values and every prelude container are indirect as well.
			[]


private pure func resolved_shapes_inline_dependencies(
	table: TypeHeaderTable,
	shapes: List[ResolvedTypeShape],
	substitutions: List[LayoutTypeSubstitution],
) -> List[TypeId]:
	var result: List[TypeId] = []

	for shape in shapes:
		result = concat_unique_type_ids(
			result,
			resolved_shape_inline_dependencies(table, shape, substitutions),
		)

	result


private pure func type_header_inline_dependencies(
	table: TypeHeaderTable,
	header: TypeHeader,
) -> List[TypeId]:
	match header.shape:
		RecordTypeHeader(ValueStruct, fields):
			resolved_shapes_inline_dependencies(
				table,
				fields.map(func(field): field.typ),
				[],
			)
		AliasTypeHeader(_, target):
			resolved_shape_inline_dependencies(table, target, [])
		RecordTypeHeader(HeapRecord, _) | UnionTypeHeader(_, _) | BuiltinTypeHeader(_):
			[]


private pure func inline_layout_dependencies(
	table: TypeHeaderTable,
) -> List[InlineLayoutDependency]:
	var result: List[InlineLayoutDependency] = []

	for header in table.headers:
		var dependency_indices: List[Int] = []

		for id in type_header_inline_dependencies(table, header):
			match type_header_table_index(table, id):
				Some(index):
					dependency_indices = dependency_indices.append(index)
				None:
					void

		node: InlineLayoutDependency = {
			id = header.id,
			dependency_indices = dependency_indices
		}
		result = result.append(node)

	result


private pure func inline_layout_cycle_from_path(
	path: List[TypeId],
	repeated_id: TypeId,
) -> List[TypeId]:
	var start_index: Int = 0
	var index: Int = 0

	while index < path.length():
		match path.get(index):
			Some(id):
				if type_ids_equal(id, repeated_id):
					start_index = index
					break
			None:
				void

		index += 1

	path
		.drop(start_index)
		.append(repeated_id)


private pure func inline_layout_cycle_from_stack(
	nodes: List[InlineLayoutDependency],
	stack: List[InlineLayoutFrame],
	repeated_index: Int,
) -> Option[List[TypeId]]:
	var path: List[TypeId] = []

	for frame in stack:
		match nodes.get(frame.node_index):
			Some(node):
				path = path.append(node.id)
			None:
				void

	match nodes.get(repeated_index):
		Some(node):
			Some(inline_layout_cycle_from_path(path, node.id))
		None:
			None


private pure func inline_layout_cycle(table: TypeHeaderTable) -> Option[List[TypeId]]:
	nodes = inline_layout_dependencies(table)
	var visit_states: List[InlineLayoutVisitState] = []

	for _ in nodes:
		visit_states = visit_states.append(InlineLayoutUnvisited)

	var cycle: Option[List[TypeId]] = None
	var root_index: Int = 0

	while root_index < nodes.length() and cycle.is_none():
		if visit_states.get_or(root_index, InlineLayoutUnvisited) == InlineLayoutUnvisited:
			var stack: List[InlineLayoutFrame] = [
				{
					node_index = root_index,
					next_dependency_index = 0
				},
			]
			visit_states = visit_states.set(root_index, InlineLayoutVisiting)

			while not stack.is_empty() and cycle.is_none():
				frame_index = stack.length() - 1

				match stack.get(frame_index):
					None:
						stack = stack.take(frame_index)
					Some(frame):
						match nodes.get(frame.node_index):
							None:
								stack = stack.take(frame_index)
							Some(node):
								match node.dependency_indices.get(frame.next_dependency_index):
									Some(dependency_index):
										stack = stack.set(
											frame_index,
											{
												node_index = frame.node_index,
												next_dependency_index = frame.next_dependency_index + 1
											},
										)

										match visit_states.get_or(
											dependency_index,
											InlineLayoutUnvisited,
										):
											InlineLayoutVisiting:
												cycle = inline_layout_cycle_from_stack(
													nodes,
													stack,
													dependency_index,
												)
											InlineLayoutUnvisited:
												visit_states = visit_states.set(
													dependency_index,
													InlineLayoutVisiting,
												)
												stack = stack.append({
													node_index = dependency_index,
													next_dependency_index = 0,
												})
											InlineLayoutComplete:
												void
									None:
										visit_states = visit_states.set(
											frame.node_index,
											InlineLayoutComplete,
										)
										stack = stack.take(frame_index)

		root_index += 1

	cycle


private pure func resolved_shape_is_valid_struct_field(
	table: TypeHeaderTable,
	shape: ResolvedTypeShape,
	substitutions: List[LayoutTypeSubstitution],
) -> Bool:
	-- Alias cycles have already been rejected by the dependency graph. Walk
	-- the remaining single-target alias chain iteratively so a deep valid chain
	-- cannot exhaust the compiler stack.
	var current = shape
	var current_substitutions = substitutions
	var valid: Bool = False
	var complete: Bool = False

	while not complete:
		match current:
			IntrinsicTypeShape(intrinsic, args):
				valid = args.is_empty() and intrinsic_is_struct_scalar(intrinsic)
				complete = True
			PreludeTypeShape(prelude_type, args):
				valid = args.is_empty() and prelude_type_has_inline_value_storage(prelude_type)

				complete = True
			DeclaredTypeShape(id, args):
				match type_header_table_find(table, id):
					Some(header):
						match header.shape:
							BuiltinTypeHeader(ScalarBuiltin):
								valid = args.is_empty()
								complete = True
							UnionTypeHeader(FieldlessEnum, _):
								valid = args.is_empty()
								complete = True
							RecordTypeHeader(ValueStruct, _):
								valid = args.is_empty()
								complete = True
							AliasTypeHeader(_, target):
								match type_shape_substitutions(
									header.parameters,
									args,
									current_substitutions,
								):
									Some(alias_substitutions):
										current = target
										current_substitutions = alias_substitutions
									None:
										complete = True
							_:
								complete = True
					None:
						complete = True
			TypeParameterShape(parameter):
				match layout_substitution_find(current_substitutions, parameter):
					Some(replacement):
						current = replacement
					None:
						complete = True
			_:
				complete = True

	valid


private pure func invalid_struct_field_errors(table: TypeHeaderTable) -> List[TypeHeaderError]:
	var errors: List[TypeHeaderError] = []

	for header in table.headers:
		match header.shape:
			RecordTypeHeader(ValueStruct, fields):
				for field in fields:
					if not resolved_shape_is_valid_struct_field(table, field.typ, []):
						errors = errors.append(TypeHeaderInvalidStructField(header.id, field.name))
			_:
				void

	errors


private pure func type_shape_substitutions(
	parameters: List[ResolvedTypeParameter],
	args: List[ResolvedTypeShape],
	parent: List[LayoutTypeSubstitution],
) -> Option[List[LayoutTypeSubstitution]]:
	if parameters.length() != args.length():
		None
	else:
		-- An inner instantiation of the same generic declaration must shadow its
		-- outer parameter mapping, as in `Box[Box[Int]]`.
		var result: List[LayoutTypeSubstitution] = []
		var index: Int = 0

		while index < parameters.length():
			match (parameters.get(index), args.get(index)):
				(Some(parameter), Some(replacement)):
					result = result.append({
						parameter = parameter.id,
						replacement = replacement,
					})
				_:
					void

			index += 1

		Some(result.concat(parent))


private record PendingValueLayoutShape {
	shape: ResolvedTypeShape,
	substitutions: List[LayoutTypeSubstitution]
}


private pure func pending_record_fields(
	fields: List[TypeHeaderField],
	substitutions: List[LayoutTypeSubstitution],
) -> List[PendingValueLayoutShape]:
	var pending: List[PendingValueLayoutShape] = []

	for field in fields:
		pending = pending.append({
			shape = field.typ,
			substitutions = substitutions,
		})

	pending


private pure func bool_at(values: List[Bool], index: Int) -> Bool:
	values
		.get(index)
		.get_or(False)


private record ValueLayoutSummary {
	dependencies: List[Int],
	required_parameters: List[TypeParameterId]
}


private pure func append_unique_int(values: List[Int], value: Int) -> List[Int]:
	if values.contains(value):
		values
	else:
		values.append(value)


private pure func append_unique_type_parameter(
	values: List[TypeParameterId],
	value: TypeParameterId,
) -> List[TypeParameterId]:
	var present: Bool = False

	for existing in values:
		if type_parameter_ids_equal(existing, value):
			present = True
			break

	if present:
		values
	else:
		values.append(value)


private pure func append_value_layout_work(
	work: List[PendingValueLayoutShape],
	shapes: List[ResolvedTypeShape],
	substitutions: List[LayoutTypeSubstitution],
) -> List[PendingValueLayoutShape]:
	var result = work

	for shape in shapes:
		result = result.append({
			shape = shape,
			substitutions = substitutions,
		})

	result


private pure func empty_value_layout_summaries(table: TypeHeaderTable) -> List[ValueLayoutSummary]:
	var summaries: List[ValueLayoutSummary] = []

	for _ in table.headers:
		summaries = summaries.append({
			dependencies = [],
			required_parameters = [],
		})

	summaries


private pure func value_layout_summary_at(
	summaries: List[ValueLayoutSummary],
	index: Int,
) -> ValueLayoutSummary:
	summaries
		.get(index)
		.get_or({
			dependencies = [],
			required_parameters = [],
		})


private pure func record_value_layout_summary(
	table: TypeHeaderTable,
	summaries: List[ValueLayoutSummary],
	fields: List[TypeHeaderField],
	initial: ValueLayoutSummary,
) -> ValueLayoutSummary:
	-- A generic argument contributes to product layout only when the referenced
	-- record requires that parameter inline. This distinguishes finite
	-- `Box[Box[Int]]` nesting from `Loop { value: Box[Loop] }`.
	var result = initial
	var work = pending_record_fields(fields, [])
	var work_index: Int = 0

	while work_index < work.length():
		match work.get(work_index):
			None:
				void
			Some(item):
				match item.shape:
					DeclaredTypeShape(id, args):
						match type_header_table_index(table, id):
							None:
								void
							Some(header_index):
								match table.headers.get(header_index):
									None:
										void
									Some(header):
										match header.shape:
											RecordTypeHeader(_, _):
												result = { result |
													dependencies = append_unique_int(
														result.dependencies,
														header_index,
													)
												}

												match type_shape_substitutions(
													header.parameters,
													args,
													item.substitutions,
												):
													Some(child_substitutions):
														callee = value_layout_summary_at(
															summaries,
															header_index,
														)

														for parameter in callee.required_parameters:
															match layout_substitution_find(
																child_substitutions,
																parameter,
															):
																Some(replacement):
																	work = append_value_layout_work(
																		work,
																		[replacement],
																		child_substitutions,
																	)
																None:
																	void
													None:
														void
											AliasTypeHeader(_, target):
												match type_shape_substitutions(
													header.parameters,
													args,
													item.substitutions,
												):
													Some(alias_substitutions):
														work = append_value_layout_work(
															work,
															[target],
															alias_substitutions,
														)
													None:
														void
											_:
												void
					TypeParameterShape(parameter):
						match layout_substitution_find(item.substitutions, parameter):
							Some(replacement):
								work = append_value_layout_work(
									work,
									[replacement],
									item.substitutions,
								)
							None:
								result = { result |
									required_parameters = append_unique_type_parameter(
										result.required_parameters,
										parameter,
									)
								}
					SelfTypeShape(id):
						match type_header_table_index(table, id):
							Some(header_index):
								result = { result |
									dependencies = append_unique_int(
										result.dependencies,
										header_index,
									)
								}
							None:
								void
					TupleTypeShape(elements):
						work = append_value_layout_work(work, elements, item.substitutions)
					_:
						void

		work_index += 1

	result


private pure func value_layout_references(
	table: TypeHeaderTable,
	fields: List[TypeHeaderField],
) -> List[Int]:
	-- This conservative reference set drives only worklist invalidation. It may
	-- include a generic argument that later proves non-mandatory, but it never
	-- changes the computed dependency graph.
	var references: List[Int] = []
	var work = pending_record_fields(fields, [])
	var work_index: Int = 0

	while work_index < work.length():
		match work.get(work_index):
			Some(item):
				match item.shape:
					DeclaredTypeShape(id, args):
						match type_header_table_index(table, id):
							Some(header_index):
								match table.headers.get(header_index):
									Some(header):
										match header.shape:
											RecordTypeHeader(_, _):
												references = append_unique_int(
													references,
													header_index,
												)
												work = append_value_layout_work(
													work,
													args,
													item.substitutions,
												)
											AliasTypeHeader(_, target):
												match type_shape_substitutions(
													header.parameters,
													args,
													item.substitutions,
												):
													Some(alias_substitutions):
														work = append_value_layout_work(
															work,
															[target],
															alias_substitutions,
														)
													None:
														void
											_:
												void
									None:
										void
							None:
								void
					TypeParameterShape(parameter):
						match layout_substitution_find(item.substitutions, parameter):
							Some(replacement):
								work = append_value_layout_work(
									work,
									[replacement],
									item.substitutions,
								)
							None:
								void
					SelfTypeShape(id):
						match type_header_table_index(table, id):
							Some(header_index):
								references = append_unique_int(references, header_index)
							None:
								void
					TupleTypeShape(elements):
						work = append_value_layout_work(work, elements, item.substitutions)
					_:
						void
			None:
				void

		work_index += 1

	references


private pure func empty_int_lists(length: Int) -> List[List[Int]]:
	var result: List[List[Int]] = []
	var index: Int = 0

	while index < length:
		result = result.append([])
		index += 1

	result


private pure func value_layout_summary_consumers(table: TypeHeaderTable) -> List[List[Int]]:
	var consumers = empty_int_lists(table.headers.length())
	var owner_index: Int = 0

	for header in table.headers:
		match header.shape:
			RecordTypeHeader(_, fields):
				for dependency in value_layout_references(table, fields):
					match consumers.get(dependency):
						Some(existing):
							consumers = consumers.set(
								dependency,
								append_unique_int(existing, owner_index),
							)
						None:
							void
			_:
				void

		owner_index += 1

	consumers


private pure func complete_value_layout_summaries(
	table: TypeHeaderTable,
) -> List[ValueLayoutSummary]:
	-- Summaries grow monotonically over finite declaration and parameter sets,
	-- so this worklist terminates without a heuristic pass limit.
	consumers = value_layout_summary_consumers(table)
	var summaries = empty_value_layout_summaries(table)
	var queued = False.repeat(table.headers.length())
	var queue: List[Int] = []
	var queue_index: Int = 0
	var index: Int = 0

	for header in table.headers:
		match header.shape:
			RecordTypeHeader(_, _):
				queue = queue.append(index)
				queued = queued.set(index, True)
			_:
				void

		index += 1

	while queue_index < queue.length():
		match queue.get(queue_index):
			Some(header_index):
				queued = queued.set(header_index, False)

				match table.headers.get(header_index):
					Some(header):
						match header.shape:
							RecordTypeHeader(_, fields):
								before = value_layout_summary_at(summaries, header_index)
								after = record_value_layout_summary(
									table,
									summaries,
									fields,
									before,
								)

								if (
									before.dependencies.length() != after.dependencies.length()
									or before.required_parameters.length() != after.required_parameters.length()
								):
									summaries = summaries.set(header_index, after)

									for consumer in (
										consumers
											.get(header_index)
											.get_or([])
									):
										if not bool_at(queued, consumer):
											queue = queue.append(consumer)
											queued = queued.set(consumer, True)
							_:
								void
					None:
						void
			None:
				void

		queue_index += 1

	summaries


private pure func recursive_value_layout_errors(table: TypeHeaderTable) -> List[TypeHeaderError]:
	-- Kahn elimination leaves exactly records in mandatory product cycles and
	-- records that depend on those cycles. Collections, functions, and unions
	-- never enter this graph because they provide indirection or a base case.
	summaries = complete_value_layout_summaries(table)
	var errors: List[TypeHeaderError] = []
	var unresolved = 0.repeat(table.headers.length())
	var dependents = empty_int_lists(table.headers.length())
	var queue: List[Int] = []
	var queue_index: Int = 0
	var index: Int = 0

	for header in table.headers:
		match header.shape:
			RecordTypeHeader(_, _):
				summary = value_layout_summary_at(summaries, index)
				unresolved = unresolved.set(index, summary.dependencies.length())

				for dependency in summary.dependencies:
					match dependents.get(dependency):
						Some(existing):
							dependents = dependents.set(
								dependency,
								existing.append(index),
							)
						None:
							void
			_:
				void

		index += 1

	index = 0

	for header in table.headers:
		match header.shape:
			RecordTypeHeader(_, _):
				if (
					unresolved
						.get(index)
						.get_or(0) == 0
				):
					queue = queue.append(index)
			_:
				void

		index += 1

	while queue_index < queue.length():
		match queue.get(queue_index):
			Some(completed_index):
				for dependent in (
					dependents
						.get(completed_index)
						.get_or([])
				):
					remaining = unresolved
						.get(dependent)
						.get_or(0) - 1
					unresolved = unresolved.set(dependent, remaining)

					if remaining == 0:
						queue = queue.append(dependent)
			None:
				void

		queue_index += 1

	index = 0

	for header in table.headers:
		match header.shape:
			RecordTypeHeader(_, _):
				if (
					unresolved
						.get(index)
						.get_or(0) > 0
				):
					errors = errors.append(
						TypeHeaderRecursiveValueLayout(
							header.id,
							value_layout_summary_at(summaries, index).dependencies.contains(index),
						),
					)
			_:
				void

		index += 1

	errors


private pure func type_containment_facts_merge(
	left: TypeContainmentFacts,
	right: TypeContainmentFacts,
) -> TypeContainmentFacts:
	{
		contains_resource = left.contains_resource or right.contains_resource,
		may_contain_function = left.may_contain_function or right.may_contain_function,
		may_contain_one_shot_stream = (
			left.may_contain_one_shot_stream
			or right.may_contain_one_shot_stream
		),
		may_contain_resource_source = (
			left.may_contain_resource_source
			or right.may_contain_resource_source
		)
	}


private pure func type_containment_facts_equal(
	left: TypeContainmentFacts,
	right: TypeContainmentFacts,
) -> Bool:
	(
		left.contains_resource == right.contains_resource
		and left.may_contain_function == right.may_contain_function
		and left.may_contain_one_shot_stream == right.may_contain_one_shot_stream
		and left.may_contain_resource_source == right.may_contain_resource_source
	)


private pure func type_containment_facts_complete(facts: TypeContainmentFacts) -> Bool:
	(
		facts.contains_resource
		and facts.may_contain_function
		and facts.may_contain_one_shot_stream
		and facts.may_contain_resource_source
	)


private pure func resolved_shapes_containment_facts(
	table: TypeHeaderTable,
	shapes: List[ResolvedTypeShape],
) -> TypeContainmentFacts:
	var facts = EMPTY_TYPE_CONTAINMENT_FACTS

	for shape in shapes:
		facts = type_containment_facts_merge(
			facts,
			resolved_shape_containment_facts(table, shape),
		)

		if type_containment_facts_complete(facts):
			break

	facts


-- Concrete arguments are scanned at each use site. Until then a type parameter
-- cannot rule out capability carriers, but is not itself a resource.
private pure func resolved_shape_containment_facts(
	table: TypeHeaderTable,
	shape: ResolvedTypeShape,
) -> TypeContainmentFacts:
	match shape:
		DeclaredTypeShape(id, args):
			type_containment_facts_merge(
				type_header_table_find(table, id)
					.map(func(header): header.containment)
					.get_or(EMPTY_TYPE_CONTAINMENT_FACTS),
				resolved_shapes_containment_facts(
					table,
					args,
				),
			)
		IntrinsicTypeShape(_, args):
			resolved_shapes_containment_facts(table, args)
		PreludeTypeShape(prelude_type, args):
			type_containment_facts_merge(
				{ EMPTY_TYPE_CONTAINMENT_FACTS |
					contains_resource = prelude_type_is_resource(prelude_type)
				},
				resolved_shapes_containment_facts(table, args),
			)
		TypeParameterShape(_) | TraitTypeParameterShape(_) | CallableTypeParameterShape(_) | ImplementationTypeParameterShape(_) | TraitSelfTypeShape(_):
			{ EMPTY_TYPE_CONTAINMENT_FACTS |
				may_contain_function = True,
				may_contain_one_shot_stream = True,
				may_contain_resource_source = True
			}
		SelfTypeShape(id):
			type_header_table_find(table, id)
				.map(func(header): header.containment)
				.get_or(EMPTY_TYPE_CONTAINMENT_FACTS)
		DimensionParameterShape(_, _) | TraitDimensionParameterShape(_, _) | CallableDimensionParameterShape(_, _) | ImplementationDimensionParameterShape(_, _) | WildcardDimensionShape(_) | DimensionLiteralShape(_):
			EMPTY_TYPE_CONTAINMENT_FACTS
		DimensionBinaryShape(_, left, right):
			type_containment_facts_merge(
				resolved_shape_containment_facts(table, left),
				resolved_shape_containment_facts(table, right),
			)
		RangeTypeShape(inner):
			resolved_shape_containment_facts(table, inner)
		TupleTypeShape(elements):
			resolved_shapes_containment_facts(table, elements)
		FunctionTypeShape(_, params, return_type):
			signature_facts = type_containment_facts_merge(
				resolved_shapes_containment_facts(table, params),
				resolved_shape_containment_facts(table, return_type),
			)
			{ EMPTY_TYPE_CONTAINMENT_FACTS |
				contains_resource = signature_facts.contains_resource,
				may_contain_function = True
			}
		ArrayTypeShape(element, dims):
			type_containment_facts_merge(
				resolved_shape_containment_facts(table, element),
				resolved_shapes_containment_facts(table, dims),
			)


private pure func header_shape_containment_facts(
	table: TypeHeaderTable,
	shape: TypeHeaderShape,
) -> TypeContainmentFacts:
	match shape:
		RecordTypeHeader(_, fields):
			var facts = EMPTY_TYPE_CONTAINMENT_FACTS

			for field in fields:
				facts = type_containment_facts_merge(
					facts,
					resolved_shape_containment_facts(table, field.typ),
				)

				if type_containment_facts_complete(facts):
					break

			facts
		UnionTypeHeader(_, variants):
			var facts = EMPTY_TYPE_CONTAINMENT_FACTS

			for variant in variants:
				facts = type_containment_facts_merge(
					facts,
					resolved_shapes_containment_facts(table, variant.fields),
				)

				if type_containment_facts_complete(facts):
					break

			facts
		BuiltinTypeHeader(_):
			EMPTY_TYPE_CONTAINMENT_FACTS
		AliasTypeHeader(_, target):
			resolved_shape_containment_facts(table, target)


private pure func complete_type_containment(table: TypeHeaderTable) -> TypeHeaderTable:
	-- Facts only move from false to true. A fact can cross at most one declaration
	-- edge per pass, so the number of headers is a sufficient convergence bound.
	var result = table
	var changed: Bool = True
	var remaining_passes: Int = table.headers.length()

	while changed and remaining_passes > 0:
		changed = False
		var index: Int = 0

		for header in result.headers:
			containment = type_containment_facts_merge(
				header.containment,
				header_shape_containment_facts(result, header.shape),
			)

			if not type_containment_facts_equal(containment, header.containment):
				result = { result |
					headers = result.headers.set(index, { header | containment = containment })
				}
				changed = True

			index += 1

		remaining_passes -= 1

	result


pure func type_header_graph_build(
	parameter_graph: ResolvedTypeParameterGraph,
) -> Result[TypeHeaderGraph, List[TypeHeaderError]]:
	declaration_graph = acyclic_type_alias_dependency_graph_declaration_graph(
		resolved_type_parameter_graph_alias_dependencies(parameter_graph),
	)
	var headers: List[TypeHeader] = []
	var errors: List[TypeHeaderError] = []

	for skeleton in declaration_skeleton_graph_type_skeletons(declaration_graph):
		match build_type_header(parameter_graph, skeleton):
			TypeHeaderReady(header):
				headers = headers.append(header)
			TypeHeaderRejected(header_errors):
				errors = errors.concat(header_errors)

	if not errors.is_empty():
		Err(errors)
	else:
		table = type_header_table(headers, declaration_graph)

		match inline_layout_cycle(table):
			Some(cycle):
				Err([TypeHeaderInlineStorageCycle(cycle)])
			None:
				struct_field_errors = invalid_struct_field_errors(table)
				recursive_layout_errors = recursive_value_layout_errors(table)
				validation_errors = struct_field_errors.concat(recursive_layout_errors)

				if not validation_errors.is_empty():
					Err(validation_errors)
				else:
					completed_table = complete_type_containment(table)
					representation: TypeHeaderGraphRep = {
						parameter_graph = parameter_graph,
						table = completed_table
					}
					Ok(into_opaque TypeHeaderGraph(representation))


private pure func type_header_graph_rep(graph: TypeHeaderGraph) -> TypeHeaderGraphRep:
	from_opaque TypeHeaderGraph(graph)


pure func type_header_graph_parameter_graph(graph: TypeHeaderGraph) -> ResolvedTypeParameterGraph:
	type_header_graph_rep(graph).parameter_graph


pure func type_header_graph_declaration_graph(graph: TypeHeaderGraph) -> DeclarationSkeletonGraph:
	parameter_graph = type_header_graph_rep(graph).parameter_graph
	acyclic_type_alias_dependency_graph_declaration_graph(
		resolved_type_parameter_graph_alias_dependencies(parameter_graph),
	)


pure func type_header_graph_bound_graph(graph: TypeHeaderGraph) -> BoundModuleGraph:
	declaration_skeleton_graph_bound_graph(type_header_graph_declaration_graph(graph))


pure func type_header_graph_headers(graph: TypeHeaderGraph) -> List[TypeHeader]:
	type_header_graph_rep(graph).table.headers


pure func type_header_graph_declaration_skeleton_count(graph: TypeHeaderGraph) -> Int:
	declaration_skeleton_graph_skeletons(type_header_graph_declaration_graph(graph)).length()


pure func type_header_graph_find(graph: TypeHeaderGraph, id: TypeId) -> Option[TypeHeader]:
	type_header_table_find(type_header_graph_rep(graph).table, id)


pure func type_header_graph_declared_type_expansion(
	graph: TypeHeaderGraph,
	id: TypeId,
) -> Option[DeclaredTypeExpansion]:
	type_header_graph_find(graph, id).map(func(header):
		match header.shape:
			AliasTypeHeader(TransparentAlias, target):
				TransparentAliasExpansion(header.parameters, target)
			_:
				NominalDeclaredType
	)


private pure func builtin_type_header(header: TypeHeader) -> Option[AcceptedBuiltinHeader]:
	match header.shape:
		BuiltinTypeHeader(layout):
			Some(into_opaque AcceptedBuiltinHeader({
						id = header.id,
						parameters = header.parameters,
						layout = layout,
						containment = header.containment
					}))
		_:
			None


private pure func type_header_graph_builtin_headers_for_module(
	graph: TypeHeaderGraph,
	module_identity: ModuleIdentity,
	selection: HeaderVisibilitySelection,
) -> List[AcceptedBuiltinHeader]:
	table = type_header_graph_rep(graph).table
	var result: List[AcceptedBuiltinHeader] = []

	for index in type_header_table_module_indices(table, module_identity, selection):
		match table.headers.get(index):
			Some(header):
				match builtin_type_header(header):
					Some(builtin_header):
						result = result.append(builtin_header)
					None:
						void
			None:
				void

	result


pure func type_header_graph_local_builtin_headers(
	graph: TypeHeaderGraph,
	module_identity: ModuleIdentity,
) -> List[AcceptedBuiltinHeader]:
	type_header_graph_builtin_headers_for_module(graph, module_identity, AllModuleHeaders)


