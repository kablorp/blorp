pure func compiler_type_resolution_owner_display_name(owner: CompilerTypeResolutionOwner) -> String:
	match owner:
		CompilerTypeDeclarationResolutionOwner(id):
			compiler_type_id_name(id)
		CompilerTraitMethodResolutionOwner(method_id):
			compiler_trait_id_name(
				compiler_trait_method_id_owner(
					method_id,
				),
			) + "." + compiler_trait_method_id_name(method_id)
		CompilerCallableResolutionOwner(id):
			compiler_callable_id_name(id)
		CompilerGlobalResolutionOwner(id):
			compiler_global_id_name(id)
		CompilerImplementationResolutionOwner(id):
			"implementation of " + compiler_impl_id_name(id)
		CompilerImplementationMethodResolutionOwner(_, callable_id, _):
			compiler_callable_id_name(callable_id)


pure func compiler_type_shape_resolution_error_message(
	error: CompilerTypeShapeResolutionError,
) -> String:
	match error:
		CompilerTypeShapeOwnerModuleMissing(owner, _):
			"Type resolution owner module is missing for '" + compiler_type_resolution_owner_display_name(
				owner,
			) + "'"
		CompilerTypeShapeForeignTraitParameter(owner, parameter, _):
			"Trait method '" + compiler_type_resolution_owner_display_name(
				owner,
			) + "' cannot use type parameter '" + compiler_trait_type_parameter_id_name(
				parameter,
			) + "' owned by another trait"
		CompilerTypeShapeForeignCallableParameter(owner, parameter, _):
			"Callable '" + compiler_type_resolution_owner_display_name(
				owner,
			) + "' cannot use type parameter '" + compiler_callable_type_parameter_id_name(
				parameter,
			) + "' owned by another callable"
		CompilerTypeShapeForeignImplementationParameter(owner, parameter, _):
			"Implementation '" + compiler_type_resolution_owner_display_name(
				owner,
			) + "' cannot use type parameter '" + compiler_implementation_type_parameter_id_name(
				parameter,
			) + "' owned by another implementation"
		CompilerTypeShapeUnknownType(owner, name, _):
			"Unknown type '" + name + "' while resolving '" + compiler_type_resolution_owner_display_name(
				owner,
			) + "'"
		CompilerTypeShapeUnknownQualifier(owner, qualifier, _):
			"Unknown module qualifier '" + qualifier + "' while resolving '" + compiler_type_resolution_owner_display_name(
				owner,
			) + "'"
		CompilerTypeShapeImportedModuleMissing(owner, module_path, _):
			"Imported module '" + module_path + "' is missing while resolving '" + compiler_type_resolution_owner_display_name(
				owner,
			) + "'"
		CompilerTypeShapePrivateTypeReference(owner, referenced, _):
			"Declaration '" + compiler_type_resolution_owner_display_name(
				owner,
			) + "' cannot reference private imported type '" + compiler_module_identity_display_name(
				compiler_type_id_module_identity(
					referenced,
				),
			) + "." + compiler_type_id_name(referenced) + "'"
		CompilerTypeShapeArityMismatch(owner, name, expected, actual, _):
			"Type '" + name + "' expects " + expected.to_string() + " argument(s), got " + actual.to_string() + " while resolving '" + compiler_type_resolution_owner_display_name(
				owner,
			) + "'"
		CompilerTypeShapeUnknownTypeParameter(owner, name, _):
			"Unknown type parameter '" + name + "' while resolving '" + compiler_type_resolution_owner_display_name(
				owner,
			) + "'"
		CompilerTypeShapeInvalidDimension(owner, value, _):
			"Invalid dimension '" + value + "' while resolving '" + compiler_type_resolution_owner_display_name(
				owner,
			) + "'"
		CompilerTypeShapeMissingType(owner, _):
			"Missing type while resolving '" + compiler_type_resolution_owner_display_name(
				owner,
			) + "'"
		CompilerTypeShapeSelfNotAllowed(owner, _):
			"'Self' is not available while resolving '" + compiler_type_resolution_owner_display_name(
				owner,
			) + "'"


pure func compiler_type_shape_resolution_error_span(
	error: CompilerTypeShapeResolutionError,
) -> CompilerSourceSpan:
	match error:
		CompilerTypeShapeOwnerModuleMissing(_, span) | CompilerTypeShapeForeignTraitParameter(_, _, span) | CompilerTypeShapeForeignCallableParameter(_, _, span) | CompilerTypeShapeForeignImplementationParameter(_, _, span) | CompilerTypeShapeUnknownType(_, _, span) | CompilerTypeShapeUnknownQualifier(_, _, span) | CompilerTypeShapeImportedModuleMissing(_, _, span) | CompilerTypeShapePrivateTypeReference(_, _, span) | CompilerTypeShapeArityMismatch(_, _, _, _, span) | CompilerTypeShapeUnknownTypeParameter(_, _, span) | CompilerTypeShapeInvalidDimension(_, _, span) | CompilerTypeShapeMissingType(_, span) | CompilerTypeShapeSelfNotAllowed(_, span):
			span


pure func compiler_type_header_error_message(error: CompilerTypeHeaderError) -> String:
	match error:
		CompilerTypeHeaderOwnerModuleMissing(id):
			"Type header owner module is missing for '" + compiler_type_id_name(id) + "'"
		CompilerTypeHeaderParametersMissing(id):
			"Resolved type parameters are missing for '" + compiler_type_id_name(id) + "'"
		CompilerTypeHeaderResolutionError(resolution_error):
			compiler_type_shape_resolution_error_message(resolution_error)
		CompilerTypeHeaderConstructorMissing(id, name):
			"Constructor '" + name + "' is missing for type '" + compiler_type_id_name(id) + "'"
		CompilerTypeHeaderInvalidEnumTypeParameters(id):
			"Enum '" + compiler_type_id_name(id) + "' cannot have type parameters"
		CompilerTypeHeaderInvalidEnumVariantFields(_, name):
			"Enum variant '" + name + "' cannot have fields; use 'union' instead"
		CompilerTypeHeaderInvalidStructTypeParameters(id):
			"Struct '" + compiler_type_id_name(id) + "' cannot have type parameters"
		CompilerTypeHeaderEmptyStruct(id):
			"Struct '" + compiler_type_id_name(id) + "' must have at least one field"
		CompilerTypeHeaderInvalidStructField(id, field_name):
			"Struct '" + compiler_type_id_name(
				id,
			) + "' field '" + field_name + ("' has invalid storage: struct fields must be scalar values, fieldless enums, " + "or other structs\n" + "help: Use a record for strings, collections, functions, payload unions, " + "records, and tuples")
		CompilerTypeHeaderRecursiveValueLayout(id, is_direct):
			if is_direct:
				"Type '" + compiler_type_id_name(
					id,
				) + "' is directly recursive — this would require infinite memory"
			else:
				"Type '" + compiler_type_id_name(
					id,
				) + "' has a recursive value layout — every construction path requires another product value"
		CompilerTypeHeaderInlineStorageCycle(cycle):
			match cycle.get(0):
				None:
					"Infinitely sized value layout"
				Some(first):
					first_module = compiler_type_id_module_identity(first)
					local = cycle.all(func(id):
						compiler_module_identities_equal(
							compiler_type_id_module_identity(id),
							first_module,
						)
					)

					names = if local:
						cycle.map(compiler_type_id_name)
					else:
						cycle.map(func(id):
							compiler_module_identity_display_name(
								compiler_type_id_module_identity(
									id,
								),
							) + "." + compiler_type_id_name(id)
						)

					"Infinitely sized value layout: " + names.join(" -> ")


pure func compiler_type_header_error_span(
	error: CompilerTypeHeaderError,
) -> Option[CompilerSourceSpan]:
	match error:
		CompilerTypeHeaderOwnerModuleMissing(id) | CompilerTypeHeaderParametersMissing(id) | CompilerTypeHeaderConstructorMissing(id, _) | CompilerTypeHeaderInvalidEnumTypeParameters(id) | CompilerTypeHeaderInvalidEnumVariantFields(id, _) | CompilerTypeHeaderInvalidStructTypeParameters(id) | CompilerTypeHeaderEmptyStruct(id) | CompilerTypeHeaderInvalidStructField(id, _) | CompilerTypeHeaderRecursiveValueLayout(id, _):
			Some(compiler_type_id_source_span(id))
		CompilerTypeHeaderResolutionError(resolution_error):
			Some(compiler_type_shape_resolution_error_span(resolution_error))
		CompilerTypeHeaderInlineStorageCycle(cycle):
			cycle
				.get(0)
				.map(compiler_type_id_source_span)
