pure func compiler_type_header_error_message(error: CompilerTypeHeaderError) -> String:
	match error:
		CompilerTypeHeaderOwnerModuleMissing(id):
			"Type header owner module is missing for '" + compiler_type_id_name(id) + "'"
		CompilerTypeHeaderParametersMissing(id):
			"Resolved type parameters are missing for '" + compiler_type_id_name(id) + "'"
		CompilerTypeHeaderUnknownType(id, name):
			"Unknown type '" + name + "' in header for '" + compiler_type_id_name(id) + "'"
		CompilerTypeHeaderUnknownQualifier(id, qualifier):
			"Unknown module qualifier '" + qualifier + "' in header for '" + compiler_type_id_name(
				id,
			) + "'"
		CompilerTypeHeaderImportedModuleMissing(id, module_path):
			"Imported module '" + module_path + "' is missing while resolving '" + compiler_type_id_name(
				id,
			) + "'"
		CompilerTypeHeaderPrivateTypeReference(id, referenced):
			"Type '" + compiler_type_id_name(
				id,
			) + "' cannot reference private imported type '" + compiler_module_identity_display_name(
				compiler_type_id_module_identity(
					referenced,
				),
			) + "." + compiler_type_id_name(referenced) + "'"
		CompilerTypeHeaderArityMismatch(id, name, expected, actual):
			"Type '" + name + "' expects " + expected.to_string() + " argument(s), got " + actual.to_string() + " while resolving '" + compiler_type_id_name(
				id,
			) + "'"
		CompilerTypeHeaderUnknownTypeParameter(id, name):
			"Unknown type parameter '" + name + "' in header for '" + compiler_type_id_name(
				id,
			) + "'"
		CompilerTypeHeaderInvalidDimension(id, value):
			"Invalid dimension '" + value + "' in header for '" + compiler_type_id_name(id) + "'"
		CompilerTypeHeaderMissingType(id):
			"Missing type in header for '" + compiler_type_id_name(id) + "'"
		CompilerTypeHeaderConstructorMissing(id, name):
			"Constructor '" + name + "' is missing for type '" + compiler_type_id_name(id) + "'"
		CompilerTypeHeaderInvalidEnumTypeParameters(id):
			"Enum '" + compiler_type_id_name(id) + "' cannot have type parameters"
		CompilerTypeHeaderInvalidEnumVariantFields(_, name):
			"Enum variant '" + name + "' cannot have fields; use 'union' instead"
		CompilerTypeHeaderInvalidStructTypeParameters(id):
			"Struct '" + compiler_type_id_name(id) + "' cannot have type parameters"
		CompilerTypeHeaderEmptyStruct(id):
			"Struct '" + compiler_type_id_name(id) + "' must have at least one field"
		CompilerTypeHeaderInvalidStructField(id, field_name):
			"Struct '" + compiler_type_id_name(
				id,
			) + "' field '" + field_name + ("' has invalid storage: struct fields must be scalar values, fieldless enums, " + "or other structs\n" + "help: Use a record for strings, collections, functions, payload unions, " + "records, and tuples")
		CompilerTypeHeaderRecursiveValueLayout(id, is_direct):
			if is_direct:
				"Type '" + compiler_type_id_name(
					id,
				) + "' is directly recursive — this would require infinite memory"
			else:
				"Type '" + compiler_type_id_name(
					id,
				) + "' has a recursive value layout — every construction path requires another product value"
