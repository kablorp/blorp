-- Definition-owned type parameters with trait bounds resolved to exact IDs.
--
-- Construction requires an already-acyclic alias graph. The resulting opaque
-- graph therefore cannot represent parsed bounds, unresolved trait spellings,
-- or type headers whose alias prerequisites were never validated.
import:
	../../stage_03_parse/parsed_ast: ParsedTypeParamDecl
	../../stage_04_modules/loaded_module: ModuleIdentity, module_identity_display_name
	../modules/bound_module_graph:
		BoundModule,
		BoundModuleGraph,
		bound_module_graph_find,
		bound_module_identity,
	declaration_skeleton:
		DeclarationSkeletonGraph,
		TraitId,
		TypeDeclarationSkeletonInfo,
		TypeDeclarationSource(
			AliasTypeSource,
			BuiltinTypeSource,
			RecordTypeSource,
			UnionTypeSource,
		),
		TypeId,
		declaration_skeleton_graph_bound_graph,
		declaration_skeleton_graph_type_skeletons,
		trait_ids_equal,
		type_id_module_identity,
		type_id_name,
		type_ids_equal,
	trait_reference_resolution: resolve_visible_trait_id
	type_header_dependencies:
		AcyclicTypeAliasDependencyGraph,
		acyclic_type_alias_dependency_graph_declaration_graph,


private record TypeParameterIdRep {
	owner: TypeId,
	index: Int,
	name: String
}


opaque type TypeParameterId = TypeParameterIdRep


record ResolvedTypeParameter {
	id: TypeParameterId,
	bounds: List[TraitId]
}


record ResolvedTypeParameterEntry {
	type_id: TypeId,
	parameters: List[ResolvedTypeParameter]
}


private record ResolvedTypeParameterGraphRep {
	alias_dependencies: AcyclicTypeAliasDependencyGraph,
	entries: List[ResolvedTypeParameterEntry],
	entry_indices_by_name: Dict[String, List[Int]]
}


opaque type ResolvedTypeParameterGraph = ResolvedTypeParameterGraphRep


union ResolvedTypeParameterGraphError:
	TypeParameterOwnerModuleMissing(TypeId)
	TypeParameterBoundNotFound(TypeId, String, String)


private pure func parsed_type_parameters(
	skeleton: TypeDeclarationSkeletonInfo,
) -> List[ParsedTypeParamDecl]:
	match skeleton.source:
		RecordTypeSource(decl):
			decl.type_params
		UnionTypeSource(decl):
			decl.type_params
		BuiltinTypeSource(decl):
			decl.type_params
		AliasTypeSource(decl):
			decl.type_params


private pure func append_unique_trait_id(ids: List[TraitId], id: TraitId) -> List[TraitId]:
	if ids.any(func(existing): trait_ids_equal(existing, id)):
		ids
	else:
		ids.append(id)


private pure func type_parameter_id(owner: TypeId, index: Int, name: String) -> TypeParameterId:
	into TypeParameterId({
			owner = owner,
			index = index,
			name = name
		})


private pure func type_parameter_id_rep(id: TypeParameterId) -> TypeParameterIdRep:
	from TypeParameterId(id)


pure func type_parameter_id_owner(id: TypeParameterId) -> TypeId:
	type_parameter_id_rep(id).owner


pure func type_parameter_id_index(id: TypeParameterId) -> Int:
	type_parameter_id_rep(id).index


pure func type_parameter_id_name(id: TypeParameterId) -> String:
	type_parameter_id_rep(id).name


pure func type_parameter_ids_equal(left: TypeParameterId, right: TypeParameterId) -> Bool:
	(
		type_ids_equal(type_parameter_id_owner(left), type_parameter_id_owner(right))
		and type_parameter_id_index(left) == type_parameter_id_index(right)
	)


private pure func resolve_type_parameters(
	declaration_graph: DeclarationSkeletonGraph,
	bound_graph: BoundModuleGraph,
	module: BoundModule,
	skeleton: TypeDeclarationSkeletonInfo,
) -> Result[List[ResolvedTypeParameter], List[ResolvedTypeParameterGraphError]]:
	var parameters: List[ResolvedTypeParameter] = []
	var errors: List[ResolvedTypeParameterGraphError] = []
	var parameter_index: Int = 0

	for parsed_parameter in parsed_type_parameters(skeleton):
		var bounds: List[TraitId] = []

		for parsed_bound in parsed_parameter.bounds:
			match resolve_visible_trait_id(
				declaration_graph,
				bound_graph,
				module,
				parsed_bound.text,
			):
				Some(bound_id):
					bounds = append_unique_trait_id(bounds, bound_id)
				None:
					errors = errors.append(
						TypeParameterBoundNotFound(
							skeleton.id,
							parsed_parameter.name.text,
							parsed_bound.text,
						),
					)

		parameters = parameters.append({
			id = type_parameter_id(skeleton.id, parameter_index, parsed_parameter.name.text),
			bounds = bounds,
		})
		parameter_index += 1

	if errors.is_empty():
		Ok(parameters)
	else:
		Err(errors)


pure func resolved_type_parameter_graph_build(
	alias_dependencies: AcyclicTypeAliasDependencyGraph,
) -> Result[ResolvedTypeParameterGraph, List[ResolvedTypeParameterGraphError]]:
	declaration_graph = acyclic_type_alias_dependency_graph_declaration_graph(alias_dependencies)
	bound_graph = declaration_skeleton_graph_bound_graph(declaration_graph)
	var entries: List[ResolvedTypeParameterEntry] = []
	var entry_indices_by_name: Dict[String, List[Int]] = {}
	var errors: List[ResolvedTypeParameterGraphError] = []

	for skeleton in declaration_skeleton_graph_type_skeletons(declaration_graph):
		match bound_module_graph_find(bound_graph, type_id_module_identity(skeleton.id)):
			None:
				errors = errors.append(TypeParameterOwnerModuleMissing(skeleton.id))
			Some(module):
				match resolve_type_parameters(declaration_graph, bound_graph, module, skeleton):
					Err(parameter_errors):
						errors = errors.concat(parameter_errors)
					Ok(parameters):
						entry_index = entries.length()
						name = type_id_name(skeleton.id)
						entries = entries.append({
							type_id = skeleton.id,
							parameters = parameters,
						})
						entry_indices_by_name = entry_indices_by_name.set(
							name,
							entry_indices_by_name
								.get_or(name, [])
								.append(entry_index),
						)

	if errors.is_empty():
		representation: ResolvedTypeParameterGraphRep = {
			alias_dependencies = alias_dependencies,
			entries = entries,
			entry_indices_by_name = entry_indices_by_name
		}
		Ok(into ResolvedTypeParameterGraph(representation))
	else:
		Err(errors)


private pure func resolved_type_parameter_graph_rep(
	graph: ResolvedTypeParameterGraph,
) -> ResolvedTypeParameterGraphRep:
	from ResolvedTypeParameterGraph(graph)


pure func resolved_type_parameter_graph_alias_dependencies(
	graph: ResolvedTypeParameterGraph,
) -> AcyclicTypeAliasDependencyGraph:
	resolved_type_parameter_graph_rep(graph).alias_dependencies


pure func resolved_type_parameter_graph_entries(
	graph: ResolvedTypeParameterGraph,
) -> List[ResolvedTypeParameterEntry]:
	resolved_type_parameter_graph_rep(graph).entries


pure func resolved_type_parameter_graph_find(
	graph: ResolvedTypeParameterGraph,
	id: TypeId,
) -> Option[ResolvedTypeParameterEntry]:
	representation = resolved_type_parameter_graph_rep(graph)
	var result: Option[ResolvedTypeParameterEntry] = None

	for entry_index in representation.entry_indices_by_name.get_or(type_id_name(id), []):
		match representation.entries.get(entry_index):
			Some(entry):
				if type_ids_equal(entry.type_id, id):
					result = Some(entry)
					break
			None:
				void

	result


pure func resolved_type_parameter_graph_error_message(
	error: ResolvedTypeParameterGraphError,
) -> String:
	match error:
		TypeParameterOwnerModuleMissing(type_id):
			"type parameter header graph is missing owning module '" + module_identity_display_name(
				type_id_module_identity(type_id),
			) + "' for type '" + type_id_name(type_id) + "'"
		TypeParameterBoundNotFound(type_id, parameter_name, bound_name):
			"Type parameter '" + parameter_name + "' on type '" + type_id_name(
				type_id,
			) + "' has unknown trait bound '" + bound_name + "'"
