-- Definition-owned callable and global declaration headers.
--
-- This Phase 4B graph resolves ordinary functions and foreign declarations.
-- Implementation-owned callables remain explicit skeleton categories for the
-- Phase 4C implementation graph; they are never represented here as partial
-- ordinary callable headers.
import:
	../../stage_01_file_io/source: SourceSpan, source_spans_equal
	../../stage_03_parse/parsed_ast:
		ParsedDimConstraint,
		ParsedForeignFunctionDecl,
		ParsedFunctionBodyKind(
			ParsedFunctionBuiltinBody,
			ParsedFunctionForwardDecl,
			ParsedFunctionSourceBody,
		),
		ParsedFunctionDecl,
		ParsedIdentifier,
		ParsedParam,
		ParsedTypeExpr,
		ParsedTypeParamDecl,
		ParsedVarDecl,
		parsed_function_body_kind,
	../../stage_04_modules/loaded_module:
		ModuleIdentity,
		module_identities_equal,
		module_identity_display_name,
	../modules/bound_module_graph: BoundModule, bound_module_graph_find, bound_module_identity
	callable_signature:
		CallableParameter,
		CallableSignature,
		callable_parameter,
		callable_parameter_binder_from_parsed,
		callable_signature,
	declaration_skeleton:
		CallableDeclarationSkeletonInfo,
		CallableDeclarationSource(
			DefaultImplementationMethodCallableSource,
			ForeignCallableSource,
			FunctionCallableSource,
			ImplementationMethodCallableSource,
		),
		CallableId,
		DeclarationVisibility,
		GlobalDeclarationSkeletonInfo,
		GlobalId,
		TraitId,
		callable_id_definition_id,
		callable_id_module_identity,
		callable_id_name,
		callable_id_source_span,
		callable_ids_equal,
		declaration_skeleton_graph_callable_skeletons,
		declaration_skeleton_graph_global_skeletons,
		global_id_module_identity,
		global_id_name,
		global_id_source_span,
		trait_id_name,
		trait_ids_equal,
	trait_headers: TraitTopologyGraph, trait_topology_graph_type_headers
	trait_reference_resolution: resolve_visible_trait_id
	type_header_graph:
		CallableTypeParameterId,
		CallableTypeResolutionContext,
		IntrinsicType(IntrinsicVoid),
		ResolvedTypeShape(IntrinsicTypeShape),
		TypeHeaderGraph,
		TypeShapeResolutionError,
		callable_type_parameter_id_name,
		callable_type_parameter_ids,
		prepare_callable_type_resolution_context,
		resolve_callable_type_shape_in_context,
		resolve_global_type_shape,
		type_header_graph_bound_graph,
		type_header_graph_declaration_graph,
		type_header_graph_has_unqualified_type_name,
		type_shape_resolution_error_message,
		type_shape_resolution_error_span,
	type_parameter_discovery: discover_implicit_type_parameters_in_type


enum CallableHeaderCategory:
	FunctionCallableHeader
	ForeignCallableHeader


enum CallableBodyCategory:
	SourceCallableBody
	BuiltinCallableBody
	ForwardCallableBody
	ForeignCallableBody


union CallableHeaderSource:
	FunctionCallableHeaderSource(ParsedFunctionDecl)
	ForeignCallableHeaderSource(ParsedForeignFunctionDecl)


private record ResolvedCallableTypeParameterRep {
	id: CallableTypeParameterId,
	bounds: List[TraitId]
}


opaque type ResolvedCallableTypeParameter = ResolvedCallableTypeParameterRep


private record CallableHeaderRep {
	id: CallableId,
	visibility: DeclarationVisibility,
	source: CallableHeaderSource,
	parameters: List[ResolvedCallableTypeParameter],
	signature: CallableSignature,
	dimension_constraints: List[(ResolvedTypeShape, ResolvedTypeShape)]
}


opaque type CallableHeader = CallableHeaderRep


private record AnnotatedGlobalHeaderRep {
	id: GlobalId,
	visibility: DeclarationVisibility,
	typ: ResolvedTypeShape,
	source: ParsedVarDecl
}


opaque type AcceptedAnnotatedGlobalHeader = AnnotatedGlobalHeaderRep


private record PendingGlobalInitializerRep {
	id: GlobalId,
	visibility: DeclarationVisibility,
	source: ParsedVarDecl
}


opaque type PendingGlobalInitializerHeader = PendingGlobalInitializerRep


union GlobalHeader:
	AnnotatedGlobalHeader(AcceptedAnnotatedGlobalHeader)
	PendingGlobalInitializer(PendingGlobalInitializerHeader)


private record CallableHeaderGraphRep {
	trait_topology: TraitTopologyGraph,
	callables: List[CallableHeader],
	callable_index_by_definition_id: Dict[Int, Int],
	globals: List[GlobalHeader]
}


opaque type CallableHeaderGraph = CallableHeaderGraphRep


union CallableHeaderGraphError:
	CallableOwnerModuleMissing(CallableId)
	GlobalOwnerModuleMissing(GlobalId)
	CallableDuplicateTypeParameter(CallableId, ParsedIdentifier)
	CallableTypeParameterUnknownBound(CallableId, ParsedIdentifier, ParsedIdentifier)
	CallableMissingParameterType(CallableId, Int, SourceSpan)
	CallableTypeResolutionError(TypeShapeResolutionError)
	GlobalTypeResolutionError(TypeShapeResolutionError)


private record CallableTypeParameterResolution {
	parameters: List[ResolvedCallableTypeParameter],
	errors: List[CallableHeaderGraphError]
}


private record CallableSignatureResolution {
	signature: CallableSignature,
	dimension_constraints: List[(ResolvedTypeShape, ResolvedTypeShape)],
	errors: List[CallableHeaderGraphError]
}


private record CallableHeaderBuildState {
	callables: List[CallableHeader],
	callable_index_by_definition_id: Dict[Int, Int],
	globals: List[GlobalHeader],
	errors: List[CallableHeaderGraphError]
}


pure func callable_type_parameter_id(
	parameter: ResolvedCallableTypeParameter,
) -> CallableTypeParameterId:
	from ResolvedCallableTypeParameter(parameter).id


pure func callable_type_parameter_bounds(parameter: ResolvedCallableTypeParameter) -> List[TraitId]:
	from ResolvedCallableTypeParameter(parameter).bounds


pure func callable_header_id(header: CallableHeader) -> CallableId:
	from CallableHeader(header).id


pure func callable_header_name(header: CallableHeader) -> String:
	callable_id_name(callable_header_id(header))


pure func callable_header_category(header: CallableHeader) -> CallableHeaderCategory:
	match from CallableHeader(header).source:
		FunctionCallableHeaderSource(_):
			FunctionCallableHeader
		ForeignCallableHeaderSource(_):
			ForeignCallableHeader


pure func callable_header_body_category(header: CallableHeader) -> CallableBodyCategory:
	match from CallableHeader(header).source:
		FunctionCallableHeaderSource(decl):
			callable_body_category(decl)
		ForeignCallableHeaderSource(_):
			ForeignCallableBody


pure func callable_header_source(header: CallableHeader) -> CallableHeaderSource:
	from CallableHeader(header).source


pure func callable_header_visibility(header: CallableHeader) -> DeclarationVisibility:
	from CallableHeader(header).visibility


pure func callable_header_parameters(header: CallableHeader) -> List[ResolvedCallableTypeParameter]:
	from CallableHeader(header).parameters


pure func callable_header_signature(header: CallableHeader) -> CallableSignature:
	from CallableHeader(header).signature


pure func callable_header_dimension_constraints(
	header: CallableHeader,
) -> List[(ResolvedTypeShape, ResolvedTypeShape)]:
	from CallableHeader(header).dimension_constraints


private pure func annotated_global_rep(
	header: AcceptedAnnotatedGlobalHeader,
) -> AnnotatedGlobalHeaderRep:
	from AcceptedAnnotatedGlobalHeader(header)


private pure func pending_global_rep(
	header: PendingGlobalInitializerHeader,
) -> PendingGlobalInitializerRep:
	from PendingGlobalInitializerHeader(header)


pure func global_header_name(header: GlobalHeader) -> String:
	match header:
		AnnotatedGlobalHeader(annotated):
			global_id_name(annotated_global_rep(annotated).id)
		PendingGlobalInitializer(pending):
			global_id_name(pending_global_rep(pending).id)


pure func global_header_id(header: GlobalHeader) -> GlobalId:
	match header:
		AnnotatedGlobalHeader(annotated):
			annotated_global_rep(annotated).id
		PendingGlobalInitializer(pending):
			pending_global_rep(pending).id


pure func global_header_source(header: GlobalHeader) -> ParsedVarDecl:
	match header:
		AnnotatedGlobalHeader(annotated):
			annotated_global_rep(annotated).source
		PendingGlobalInitializer(pending):
			pending_global_rep(pending).source


pure func global_header_visibility(header: GlobalHeader) -> DeclarationVisibility:
	match header:
		AnnotatedGlobalHeader(annotated):
			annotated_global_rep(annotated).visibility
		PendingGlobalInitializer(pending):
			pending_global_rep(pending).visibility


pure func annotated_global_header_type(header: GlobalHeader) -> Option[ResolvedTypeShape]:
	match header:
		AnnotatedGlobalHeader(annotated):
			Some(annotated_global_rep(annotated).typ)
		PendingGlobalInitializer(_):
			None


private pure func callable_body_category(decl: ParsedFunctionDecl) -> CallableBodyCategory:
	match parsed_function_body_kind(decl.body):
		ParsedFunctionSourceBody:
			SourceCallableBody
		ParsedFunctionBuiltinBody(_):
			BuiltinCallableBody
		ParsedFunctionForwardDecl:
			ForwardCallableBody


private pure func effective_callable_type_parameters(
	type_headers: TypeHeaderGraph,
	module: BoundModule,
	declared: List[ParsedTypeParamDecl],
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	dimension_constraints: List[ParsedDimConstraint],
) -> List[ParsedTypeParamDecl]:
	var candidates: List[ParsedTypeParamDecl] = []

	for param in params:
		match param.type_expr:
			Some(type_expr):
				candidates = candidates.concat(discover_implicit_type_parameters_in_type(type_expr))
			None:
				void

	match return_type:
		Some(type_expr):
			candidates = candidates.concat(discover_implicit_type_parameters_in_type(type_expr))
		None:
			void

	for constraint in dimension_constraints:
		candidates = candidates.concat(discover_implicit_type_parameters_in_type(constraint.left))
		candidates = candidates.concat(discover_implicit_type_parameters_in_type(constraint.right))

	var result = declared
	var names: Dict[String, Bool] = {}

	for parameter in declared:
		names = names.set(parameter.name.text, True)

	for candidate in candidates:
		name = candidate.name.text

		if (
			not names.contains(name)
			and ((
				name.starts_with("#")
				or not type_header_graph_has_unqualified_type_name(type_headers, module, name)
			))
		):
			names = names.set(name, True)
			result = result.append(candidate)

	result


private pure func resolve_callable_type_parameters(
	type_headers: TypeHeaderGraph,
	module: BoundModule,
	owner: CallableId,
	parsed_parameters: List[ParsedTypeParamDecl],
) -> CallableTypeParameterResolution:
	declaration_graph = type_header_graph_declaration_graph(type_headers)
	bound_graph = type_header_graph_bound_graph(type_headers)
	parameter_ids = callable_type_parameter_ids(
		owner,
		parsed_parameters.map(func(parameter): parameter.name.text),
	)
	var parameters: List[ResolvedCallableTypeParameter] = []
	var names: List[String] = []
	var errors: List[CallableHeaderGraphError] = []

	for pair in parsed_parameters.zip(parameter_ids):
		parsed = pair[0]
		id = pair[1]
		var bounds: List[TraitId] = []

		if names.contains(parsed.name.text):
			errors = errors.append(CallableDuplicateTypeParameter(owner, parsed.name))
		else:
			names = names.append(parsed.name.text)

		for bound in parsed.bounds:
			match resolve_visible_trait_id(declaration_graph, bound_graph, module, bound.text):
				None:
					errors = errors.append(
						CallableTypeParameterUnknownBound(
							owner,
							parsed.name,
							bound,
						),
					)
				Some(trait_id):
					if not bounds.any(func(existing): trait_ids_equal(existing, trait_id)):
						bounds = bounds.append(trait_id)

		parameter: ResolvedCallableTypeParameter = into ResolvedCallableTypeParameter({
				id = id,
				bounds = bounds
			})
		parameters = parameters.append(parameter)

	{
		parameters = parameters,
		errors = errors
	}


private pure func append_type_resolution_errors(
	errors: List[CallableHeaderGraphError],
	resolution_errors: List[TypeShapeResolutionError],
) -> List[CallableHeaderGraphError]:
	var result = errors

	for error in resolution_errors:
		converted: CallableHeaderGraphError = CallableTypeResolutionError(error)
		result = result.append(converted)

	result


-- Resolve the return slot on every path. Keeping the absent annotation inside
-- this helper gives the callable owner one unconditional final consumer after
-- parameter resolution; the caller never has to model an owner whose last use
-- depends on an Option branch.
private pure func resolve_callable_return_type(
	context: CallableTypeResolutionContext,
	parsed_return_type: Option[ParsedTypeExpr],
) -> Result[ResolvedTypeShape, List[TypeShapeResolutionError]]:
	match parsed_return_type:
		None:
			Ok(IntrinsicTypeShape(IntrinsicVoid, []))
		Some(type_expr):
			resolve_callable_type_shape_in_context(context, type_expr)


private pure func resolve_callable_signature(
	context: CallableTypeResolutionContext,
	owner: CallableId,
	parsed_params: List[ParsedParam],
	parsed_return_type: Option[ParsedTypeExpr],
	dimension_constraints: List[ParsedDimConstraint],
	is_pure: Bool,
) -> CallableSignatureResolution:
	var resolved_params: List[CallableParameter] = []
	var resolved_constraints: List[(ResolvedTypeShape, ResolvedTypeShape)] = []
	var errors: List[CallableHeaderGraphError] = []
	var parameter_index: Int = 0

	for param in parsed_params:
		match param.type_expr:
			None:
				errors = errors.append(
					CallableMissingParameterType(
						owner,
						parameter_index,
						param.span,
					),
				)
			Some(type_expr):
				match resolve_callable_type_shape_in_context(context, type_expr):
					Ok(typ):
						resolved_params = resolved_params.append(
							callable_parameter(
								callable_parameter_binder_from_parsed(param),
								typ,
							),
						)
					Err(resolution_errors):
						errors = append_type_resolution_errors(errors, resolution_errors)

		parameter_index += 1

	return_resolution = resolve_callable_return_type(context, parsed_return_type)

	return_type: ResolvedTypeShape = match return_resolution:
		Ok(typ):
			typ
		Err(resolution_errors):
			errors = append_type_resolution_errors(errors, resolution_errors)
			IntrinsicTypeShape(IntrinsicVoid, [])

	for constraint in dimension_constraints:
		left = resolve_callable_type_shape_in_context(context, constraint.left)
		right = resolve_callable_type_shape_in_context(context, constraint.right)

		match left:
			Ok(left_shape):
				match right:
					Ok(right_shape):
						resolved_constraints = resolved_constraints.append(
							(left_shape, right_shape),
						)
					Err(right_errors):
						errors = append_type_resolution_errors(errors, right_errors)
			Err(left_errors):
				errors = append_type_resolution_errors(errors, left_errors)

				match right:
					Err(right_errors):
						errors = append_type_resolution_errors(errors, right_errors)
					Ok(_):
						void

	{
		signature = callable_signature(resolved_params, return_type, is_pure),
		dimension_constraints = resolved_constraints,
		errors = errors
	}


private pure func append_callable_header(
	state: CallableHeaderBuildState,
	type_headers: TypeHeaderGraph,
	skeleton: CallableDeclarationSkeletonInfo,
	source: CallableHeaderSource,
	type_parameters: List[ParsedTypeParamDecl],
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	dimension_constraints: List[ParsedDimConstraint],
	is_pure: Bool,
) -> CallableHeaderBuildState:
	bound_graph = type_header_graph_bound_graph(type_headers)

	match bound_module_graph_find(bound_graph, callable_id_module_identity(skeleton.id)):
		None:
			{ state | errors = state.errors.append(CallableOwnerModuleMissing(skeleton.id)) }
		Some(module):
			effective_type_parameters = effective_callable_type_parameters(
				type_headers,
				module,
				type_parameters,
				params,
				return_type,
				dimension_constraints,
			)
			parameter_resolution = resolve_callable_type_parameters(
				type_headers,
				module,
				skeleton.id,
				effective_type_parameters,
			)
			parameter_ids = parameter_resolution.parameters.map(callable_type_parameter_id)
			context_resolution = prepare_callable_type_resolution_context(
				type_headers,
				skeleton.id,
				parameter_ids,
			)

			match context_resolution:
				Err(context_errors):
					callable_errors = append_type_resolution_errors(
						parameter_resolution.errors,
						context_errors,
					)
					{ state | errors = state.errors.concat(callable_errors) }
				Ok(context):
					signature_resolution = resolve_callable_signature(
						context,
						skeleton.id,
						params,
						return_type,
						dimension_constraints,
						is_pure,
					)
					all_errors = parameter_resolution.errors.concat(signature_resolution.errors)

					if all_errors.is_empty():
						header: CallableHeader = into CallableHeader({
								id = skeleton.id,
								visibility = skeleton.visibility,
								source = source,
								parameters = parameter_resolution.parameters,
								signature = signature_resolution.signature,
								dimension_constraints = signature_resolution.dimension_constraints
							})
						index = state.callables.length()
						{ state |
							callables = state.callables.append(header),
							callable_index_by_definition_id = state.callable_index_by_definition_id.set(
								callable_id_definition_id(skeleton.id),
								index,
							)
						}
					else:
						{ state | errors = state.errors.concat(all_errors) }


private pure func append_global_header(
	state: CallableHeaderBuildState,
	type_headers: TypeHeaderGraph,
	skeleton: GlobalDeclarationSkeletonInfo,
) -> CallableHeaderBuildState:
	match bound_module_graph_find(
		type_header_graph_bound_graph(type_headers),
		global_id_module_identity(skeleton.id),
	):
		None:
			{ state | errors = state.errors.append(GlobalOwnerModuleMissing(skeleton.id)) }
		Some(_):
			match skeleton.source.type_expr:
				None:
					pending: PendingGlobalInitializerHeader = into PendingGlobalInitializerHeader({
							id = skeleton.id,
							visibility = skeleton.visibility,
							source = skeleton.source
						})
					{ state | globals = state.globals.append(PendingGlobalInitializer(pending)) }
				Some(type_expr):
					match resolve_global_type_shape(type_headers, skeleton.id, type_expr):
						Ok(typ):
							annotated: AcceptedAnnotatedGlobalHeader = into AcceptedAnnotatedGlobalHeader(
								{
									id = skeleton.id,
									visibility = skeleton.visibility,
									typ = typ,
									source = skeleton.source
								}
							)
							{ state |
								globals = state.globals.append(AnnotatedGlobalHeader(annotated))
							}
						Err(resolution_errors):
							var errors = state.errors

							for error in resolution_errors:
								converted: CallableHeaderGraphError = GlobalTypeResolutionError(
									error,
								)
								errors = errors.append(converted)

							{ state | errors = errors }


pure func callable_header_graph_build(
	trait_topology: TraitTopologyGraph,
) -> Result[CallableHeaderGraph, List[CallableHeaderGraphError]]:
	type_headers = trait_topology_graph_type_headers(trait_topology)
	declaration_graph = type_header_graph_declaration_graph(type_headers)
	var state: CallableHeaderBuildState = {
		callables = [],
		callable_index_by_definition_id = {},
		globals = [],
		errors = []
	}

	for skeleton in declaration_skeleton_graph_callable_skeletons(declaration_graph):
		match skeleton.source:
			FunctionCallableSource(decl):
				state = append_callable_header(
					state,
					type_headers,
					skeleton,
					FunctionCallableHeaderSource(decl),
					decl.type_params,
					decl.params,
					decl.return_type,
					decl.dim_constraints,
					decl.is_pure,
				)
			ForeignCallableSource(decl):
				state = append_callable_header(
					state,
					type_headers,
					skeleton,
					ForeignCallableHeaderSource(decl),
					[],
					decl.params,
					Some(decl.return_type),
					[],
					decl.is_pure,
				)
			ImplementationMethodCallableSource(_, _) | DefaultImplementationMethodCallableSource(_, _, _):
				void

	for skeleton in declaration_skeleton_graph_global_skeletons(declaration_graph):
		state = append_global_header(state, type_headers, skeleton)

	if state.errors.is_empty():
		representation: CallableHeaderGraphRep = {
			trait_topology = trait_topology,
			callables = state.callables,
			callable_index_by_definition_id = state.callable_index_by_definition_id,
			globals = state.globals
		}
		Ok(into CallableHeaderGraph(representation))
	else:
		Err(state.errors)


private pure func callable_header_graph_rep(graph: CallableHeaderGraph) -> CallableHeaderGraphRep:
	from CallableHeaderGraph(graph)


pure func callable_header_graph_trait_topology(graph: CallableHeaderGraph) -> TraitTopologyGraph:
	callable_header_graph_rep(graph).trait_topology


pure func callable_header_graph_callables(graph: CallableHeaderGraph) -> List[CallableHeader]:
	callable_header_graph_rep(graph).callables


pure func callable_header_graph_globals(graph: CallableHeaderGraph) -> List[GlobalHeader]:
	callable_header_graph_rep(graph).globals


pure func callable_header_graph_find_global_source(
	graph: CallableHeaderGraph,
	owner_identity: ModuleIdentity,
	name: String,
	span: SourceSpan,
) -> Option[GlobalHeader]:
	representation = callable_header_graph_rep(graph)
	representation.globals.find(func(header):
		id = global_header_id(header)

		(
			module_identities_equal(global_id_module_identity(id), owner_identity)
			and global_id_name(id) == name
			and source_spans_equal(global_id_source_span(id), span)
		)
	)


pure func callable_header_graph_find(
	graph: CallableHeaderGraph,
	id: CallableId,
) -> Option[CallableHeader]:
	representation = callable_header_graph_rep(graph)
	index ?= representation.callable_index_by_definition_id.get(callable_id_definition_id(id))
	header ?= representation.callables.get(index)

	if callable_ids_equal(callable_header_id(header), id):
		Some(header)
	else:
		None


-- Definition IDs are allocated once for the complete indexed graph and are
-- therefore unique within this header graph. Transitional Env installation
-- uses this query after claiming the same reserved ID from its module scope.
pure func callable_header_graph_find_definition_id(
	graph: CallableHeaderGraph,
	definition_id: Int,
) -> Option[CallableHeader]:
	representation = callable_header_graph_rep(graph)
	index ?= representation.callable_index_by_definition_id.get(definition_id)
	header ?= representation.callables.get(index)

	if callable_id_definition_id(callable_header_id(header)) == definition_id:
		Some(header)
	else:
		None


pure func callable_header_graph_error_message(error: CallableHeaderGraphError) -> String:
	match error:
		CallableOwnerModuleMissing(id):
			"callable '" + callable_id_name(
				id,
			) + "' has no bound owner module '" + module_identity_display_name(
				callable_id_module_identity(id),
			) + "'"
		GlobalOwnerModuleMissing(id):
			"global '" + global_id_name(
				id,
			) + "' has no bound owner module '" + module_identity_display_name(
				global_id_module_identity(id),
			) + "'"
		CallableDuplicateTypeParameter(id, name):
			"callable '" + callable_id_name(
				id,
			) + "' declares type parameter '" + name.text + "' more than once"
		CallableTypeParameterUnknownBound(id, parameter, bound):
			"callable '" + callable_id_name(
				id,
			) + "' type parameter '" + parameter.text + "' has unknown bound '" + bound.text + "'"
		CallableMissingParameterType(id, parameter_index, _):
			"callable '" + callable_id_name(
				id,
			) + "' parameter " + (parameter_index + 1).to_string() + " must have an explicit type"
		CallableTypeResolutionError(resolution_error) | GlobalTypeResolutionError(resolution_error):
			type_shape_resolution_error_message(resolution_error)


pure func callable_header_graph_error_span(error: CallableHeaderGraphError) -> Option[SourceSpan]:
	match error:
		CallableOwnerModuleMissing(id):
			Some(callable_id_source_span(id))
		GlobalOwnerModuleMissing(id):
			Some(global_id_source_span(id))
		CallableDuplicateTypeParameter(_, name):
			Some(name.span)
		CallableTypeParameterUnknownBound(_, _, bound):
			Some(bound.span)
		CallableMissingParameterType(_, _, span):
			Some(span)
		CallableTypeResolutionError(resolution_error) | GlobalTypeResolutionError(resolution_error):
			Some(type_shape_resolution_error_span(resolution_error))
