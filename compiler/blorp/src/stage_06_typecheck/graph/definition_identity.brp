-- Stable source identities shared by graph indexing and typechecking.
--
-- These keys describe source declarations, not mutable typecheck state. Keeping
-- them graph-owned prevents the definition index from depending on the broad
-- state record that later phases consume.
import:
	../../stage_01_file_io/source: CompilerSourceSpan, compiler_source_spans_equal
	../../stage_04_modules/loaded_module:
		CompilerModuleIdentity,
		compiler_module_identities_equal,
		compiler_module_identity_display_name,
		compiler_module_identity_storage_key,
	../../stage_05_types/generic_params: BoundTypeParam
	../../stage_05_types/semantic_type:
		SemanticDimOp(SemanticDimAdd, SemanticDimDivide, SemanticDimMultiply, SemanticDimSubtract),
		SemanticType(
			SemanticArrayType,
			SemanticConstIntType,
			SemanticDimOpType,
			SemanticFunctionType,
			SemanticMetaType,
			SemanticNamedType,
			SemanticRangeType,
			SemanticSelfType,
			SemanticTupleType,
			SemanticTypeVar,
			SemanticVarDimsType,
		),


private record CompilerFuncCallableKeyRep {
	module_identity: CompilerModuleIdentity,
	name: String,
	span: CompilerSourceSpan
}


opaque type CompilerFuncCallableKey = CompilerFuncCallableKeyRep


enum CompilerSourceDefinitionKind:
	CompilerConstructorDefinition
	CompilerTraitDefinition
	CompilerImplDefinition
	CompilerGlobalDefinition
	CompilerTypeDefinition
	CompilerFieldDefinition


private record CompilerSourceDefinitionKeyRep {
	module_identity: CompilerModuleIdentity,
	kind: CompilerSourceDefinitionKind,
	name: String,
	owner: Option[String],
	span: CompilerSourceSpan
}


opaque type CompilerSourceDefinitionKey = CompilerSourceDefinitionKeyRep


enum CompilerExportedSymbolKind:
	CompilerExportedFunction
	CompilerExportedGlobal
	CompilerExportedType
	CompilerExportedConstructor
	CompilerExportedTrait
	CompilerExportedMethod
	CompilerExportedField


-- Artifact-local semantic identities need the same category precision as
-- exported keys. Definition integers are unique today, but carrying kind here
-- lets downstream capability boundaries reject structurally valid symbols
-- from the wrong category without trusting the extractor that produced them.
enum CompilerSemanticSymbolKind:
	CompilerSemanticFunction
	CompilerSemanticForeignFunction
	CompilerSemanticMethod
	CompilerSemanticGlobal
	CompilerSemanticType
	CompilerSemanticConstructor
	CompilerSemanticTrait
	CompilerSemanticField
	CompilerSemanticParameter
	CompilerSemanticLocal


enum CompilerExportedCallableKind:
	CompilerExportedCallableFunction
	CompilerExportedCallableMethod


enum CompilerExportedNamedKind:
	CompilerExportedNamedGlobal
	CompilerExportedNamedType
	CompilerExportedNamedConstructor
	CompilerExportedNamedTrait
	CompilerExportedNamedField


private union CompilerExportedTypeShape:
	CompilerExportedNamedTypeShape(String, List[CompilerExportedTypeShape])
	CompilerExportedArrayTypeShape(CompilerExportedTypeShape, List[CompilerExportedTypeShape])
	CompilerExportedFunctionTypeShape(Bool, List[CompilerExportedTypeShape], CompilerExportedTypeShape)
	CompilerExportedTypeParameterShape(Int)
	CompilerExportedConstIntTypeShape(Int)
	CompilerExportedTupleTypeShape(List[CompilerExportedTypeShape])
	CompilerExportedSelfTypeShape
	CompilerExportedDimParameterShape(Int)
	CompilerExportedRangeTypeShape(CompilerExportedTypeShape)
	CompilerExportedDimOpTypeShape(SemanticDimOp, CompilerExportedTypeShape, CompilerExportedTypeShape)


private record CompilerExportedCallableSignature {
	type_parameter_bounds: List[List[String]],
	function_type: CompilerExportedTypeShape
}


-- Cross-artifact identity uses only declaration-owned semantic facts.
-- Callable signatures are structured and alpha-normalized; implementation
-- text, source position, declaration order, and artifact-local IDs are absent.
private record CompilerExportedSymbolKeyRep {
	module_identity: CompilerModuleIdentity,
	kind: CompilerExportedSymbolKind,
	owner: Option[String],
	name: String,
	callable_signature: Option[CompilerExportedCallableSignature]
}


opaque type CompilerExportedSymbolKey = CompilerExportedSymbolKeyRep


pure func compiler_func_callable_key(
	module_identity: CompilerModuleIdentity,
	name: String,
	span: CompilerSourceSpan,
) -> CompilerFuncCallableKey:
	representation: CompilerFuncCallableKeyRep = {
		module_identity = module_identity,
		name = name,
		span = span
	}
	into CompilerFuncCallableKey(representation)


pure func compiler_source_definition_key(
	module_identity: CompilerModuleIdentity,
	kind: CompilerSourceDefinitionKind,
	name: String,
	owner: Option[String],
	span: CompilerSourceSpan,
) -> CompilerSourceDefinitionKey:
	representation: CompilerSourceDefinitionKeyRep = {
		module_identity = module_identity,
		kind = kind,
		name = name,
		owner = owner,
		span = span
	}
	into CompilerSourceDefinitionKey(representation)


private pure func exported_type_shape_list(
	types: List[SemanticType],
	type_parameter_indexes: Dict[String, Int],
) -> Option[List[CompilerExportedTypeShape]]:
	var shapes: List[CompilerExportedTypeShape] = []
	var valid: Bool = True

	for typ in types:
		if valid:
			match exported_type_shape(typ, type_parameter_indexes):
				Some(shape):
					shapes = shapes.append(shape)
				None:
					valid = False

	if valid:
		Some(shapes)
	else:
		None


private pure func exported_type_shape(
	typ: SemanticType,
	type_parameter_indexes: Dict[String, Int],
) -> Option[CompilerExportedTypeShape]:
	match typ:
		SemanticNamedType(name, args):
			match (type_parameter_indexes.get(name), args):
				(Some(index), []):
					Some(CompilerExportedTypeParameterShape(index))
				_:
					shapes ?= exported_type_shape_list(args, type_parameter_indexes)
					Some(CompilerExportedNamedTypeShape(name, shapes))
		SemanticArrayType(element, dims):
			element_shape ?= exported_type_shape(element, type_parameter_indexes)
			dim_shapes ?= exported_type_shape_list(dims, type_parameter_indexes)
			Some(CompilerExportedArrayTypeShape(element_shape, dim_shapes))
		SemanticFunctionType(is_pure, params, return_type):
			param_shapes ?= exported_type_shape_list(params, type_parameter_indexes)
			return_shape ?= exported_type_shape(return_type, type_parameter_indexes)
			Some(CompilerExportedFunctionTypeShape(is_pure, param_shapes, return_shape))
		SemanticTypeVar(name):
			type_parameter_indexes
				.get(name)
				.map(func(index): CompilerExportedTypeParameterShape(index))
		SemanticConstIntType(value):
			Some(CompilerExportedConstIntTypeShape(value))
		SemanticTupleType(elements):
			shapes ?= exported_type_shape_list(elements, type_parameter_indexes)
			Some(CompilerExportedTupleTypeShape(shapes))
		SemanticSelfType:
			Some(CompilerExportedSelfTypeShape)
		SemanticVarDimsType(name):
			type_parameter_indexes
				.get(name)
				.map(func(index): CompilerExportedDimParameterShape(index))
		SemanticRangeType(inner):
			inner_shape ?= exported_type_shape(inner, type_parameter_indexes)
			Some(CompilerExportedRangeTypeShape(inner_shape))
		SemanticDimOpType(op, left, right):
			left_shape ?= exported_type_shape(left, type_parameter_indexes)
			right_shape ?= exported_type_shape(right, type_parameter_indexes)
			Some(CompilerExportedDimOpTypeShape(op, left_shape, right_shape))
		SemanticMetaType(_):
			None


private pure func exported_callable_signature(
	type_parameters: List[BoundTypeParam],
	function_type: SemanticType,
) -> Option[CompilerExportedCallableSignature]:
	var indexes: Dict[String, Int] = {}
	var bounds: List[List[String]] = []
	var valid: Bool = True

	for entry in type_parameters.enumerate():
		parameter = entry[1]

		if indexes.contains(parameter.name):
			valid = False
		else:
			indexes = indexes.set(parameter.name, entry[0])
			bounds = bounds.append(parameter.bounds.sort())

	if not valid:
		None
	else:
		shape ?= exported_type_shape(function_type, indexes)

		match shape:
			CompilerExportedFunctionTypeShape(_, _, _):
				Some({
					type_parameter_bounds = bounds,
					function_type = shape,
				})
			_:
				None


private pure func exported_symbol_key(
	module_identity: CompilerModuleIdentity,
	kind: CompilerExportedSymbolKind,
	owner: Option[String],
	name: String,
	callable_signature: Option[CompilerExportedCallableSignature],
) -> CompilerExportedSymbolKey:
	representation: CompilerExportedSymbolKeyRep = {
		module_identity = module_identity,
		kind = kind,
		owner = owner,
		name = name,
		callable_signature = callable_signature
	}
	into CompilerExportedSymbolKey(representation)


pure func compiler_exported_callable_symbol_key(
	module_identity: CompilerModuleIdentity,
	kind: CompilerExportedCallableKind,
	owner: Option[String],
	name: String,
	type_parameters: List[BoundTypeParam],
	function_type: SemanticType,
) -> Option[CompilerExportedSymbolKey]:
	signature ?= exported_callable_signature(type_parameters, function_type)

	exported_kind = match kind:
		CompilerExportedCallableFunction:
			CompilerExportedFunction
		CompilerExportedCallableMethod:
			CompilerExportedMethod

	Some(exported_symbol_key(module_identity, exported_kind, owner, name, Some(signature)))


pure func compiler_exported_named_symbol_key(
	module_identity: CompilerModuleIdentity,
	kind: CompilerExportedNamedKind,
	owner: Option[String],
	name: String,
) -> CompilerExportedSymbolKey:
	exported_kind = match kind:
		CompilerExportedNamedGlobal:
			CompilerExportedGlobal
		CompilerExportedNamedType:
			CompilerExportedType
		CompilerExportedNamedConstructor:
			CompilerExportedConstructor
		CompilerExportedNamedTrait:
			CompilerExportedTrait
		CompilerExportedNamedField:
			CompilerExportedField

	exported_symbol_key(module_identity, exported_kind, owner, name, None)


pure func compiler_exported_symbol_key_module_identity(
	key: CompilerExportedSymbolKey,
) -> CompilerModuleIdentity:
	representation: CompilerExportedSymbolKeyRep = from CompilerExportedSymbolKey(key)
	representation.module_identity


pure func compiler_exported_symbol_key_kind(
	key: CompilerExportedSymbolKey,
) -> CompilerExportedSymbolKind:
	representation: CompilerExportedSymbolKeyRep = from CompilerExportedSymbolKey(key)
	representation.kind


pure func compiler_exported_symbol_key_owner(key: CompilerExportedSymbolKey) -> Option[String]:
	representation: CompilerExportedSymbolKeyRep = from CompilerExportedSymbolKey(key)
	representation.owner


pure func compiler_exported_symbol_key_name(key: CompilerExportedSymbolKey) -> String:
	representation: CompilerExportedSymbolKeyRep = from CompilerExportedSymbolKey(key)
	representation.name


private pure func exported_identity_component(value: String) -> String:
	value
		.length()
		.to_string() + ":" + value


private pure func exported_dim_op_storage_key(op: SemanticDimOp) -> String:
	match op:
		SemanticDimAdd:
			"add"
		SemanticDimSubtract:
			"subtract"
		SemanticDimMultiply:
			"multiply"
		SemanticDimDivide:
			"divide"


private pure func exported_type_shape_list_storage_key(
	shapes: List[CompilerExportedTypeShape],
) -> String:
	var result: String = shapes
		.length()
		.to_string() + ":"

	for shape in shapes:
		result += exported_identity_component(exported_type_shape_storage_key(shape))

	result


private pure func exported_type_shape_storage_key(shape: CompilerExportedTypeShape) -> String:
	match shape:
		CompilerExportedNamedTypeShape(name, args):
			"named:" + exported_identity_component(
				name,
			) + exported_type_shape_list_storage_key(args)
		CompilerExportedArrayTypeShape(element, dims):
			"array:" + exported_identity_component(
				exported_type_shape_storage_key(
					element,
				),
			) + exported_type_shape_list_storage_key(dims)
		CompilerExportedFunctionTypeShape(is_pure, params, return_type):
			purity = if is_pure:
				"pure"
			else:
				"impure"

			"function:" + purity + exported_type_shape_list_storage_key(
				params,
			) + exported_identity_component(exported_type_shape_storage_key(return_type))
		CompilerExportedTypeParameterShape(index):
			"type-parameter:" + index.to_string()
		CompilerExportedConstIntTypeShape(value):
			"const-int:" + value.to_string()
		CompilerExportedTupleTypeShape(elements):
			"tuple:" + exported_type_shape_list_storage_key(elements)
		CompilerExportedSelfTypeShape:
			"self"
		CompilerExportedDimParameterShape(index):
			"dim-parameter:" + index.to_string()
		CompilerExportedRangeTypeShape(inner):
			"range:" + exported_identity_component(exported_type_shape_storage_key(inner))
		CompilerExportedDimOpTypeShape(op, left, right):
			"dim-op:" + exported_dim_op_storage_key(
				op,
			) + exported_identity_component(
				exported_type_shape_storage_key(
					left,
				),
			) + exported_identity_component(exported_type_shape_storage_key(right))


private pure func exported_bound_list_storage_key(bounds: List[List[String]]) -> String:
	var result: String = bounds
		.length()
		.to_string() + ":"

	for parameter_bounds in bounds:
		var parameter_key: String = parameter_bounds
			.length()
			.to_string() + ":"

		for bound in parameter_bounds:
			parameter_key += exported_identity_component(bound)

		result += exported_identity_component(parameter_key)

	result


private pure func exported_signature_storage_key(
	signature: Option[CompilerExportedCallableSignature],
) -> String:
	match signature:
		None:
			"not-callable"
		Some(found):
			"callable:" + exported_bound_list_storage_key(
				found.type_parameter_bounds,
			) + exported_identity_component(exported_type_shape_storage_key(found.function_type))


private pure func exported_symbol_kind_storage_key(kind: CompilerExportedSymbolKind) -> String:
	match kind:
		CompilerExportedFunction:
			"function"
		CompilerExportedGlobal:
			"global"
		CompilerExportedType:
			"type"
		CompilerExportedConstructor:
			"constructor"
		CompilerExportedTrait:
			"trait"
		CompilerExportedMethod:
			"method"
		CompilerExportedField:
			"field"


pure func compiler_exported_symbol_key_storage_key(key: CompilerExportedSymbolKey) -> String:
	representation: CompilerExportedSymbolKeyRep = from CompilerExportedSymbolKey(key)

	owner_key = match representation.owner:
		None:
			"no-owner"
		Some(owner):
			"owner:" + exported_identity_component(owner)

	"exported-symbol:" + exported_identity_component(
		compiler_module_identity_storage_key(
			representation.module_identity,
		),
	) + exported_identity_component(
		exported_symbol_kind_storage_key(
			representation.kind,
		),
	) + exported_identity_component(
		owner_key,
	) + exported_identity_component(
		representation.name,
	) + exported_identity_component(
		exported_signature_storage_key(representation.callable_signature),
	)


private pure func exported_type_shape_lists_equal(
	left: List[CompilerExportedTypeShape],
	right: List[CompilerExportedTypeShape],
) -> Bool:
	(
		left.length() == right.length()
		and left
			.zip(right)
			.all(func(pair): exported_type_shapes_equal(pair[0], pair[1]))
	)


private pure func exported_type_shapes_equal(
	left: CompilerExportedTypeShape,
	right: CompilerExportedTypeShape,
) -> Bool:
	match (left, right):
		(CompilerExportedNamedTypeShape(left_name, left_args), CompilerExportedNamedTypeShape(right_name, right_args)):
			left_name == right_name and exported_type_shape_lists_equal(left_args, right_args)
		(CompilerExportedArrayTypeShape(left_element, left_dims), CompilerExportedArrayTypeShape(right_element, right_dims)):
			(
				exported_type_shapes_equal(left_element, right_element)
				and exported_type_shape_lists_equal(left_dims, right_dims)
			)
		(CompilerExportedFunctionTypeShape(left_pure, left_params, left_return), CompilerExportedFunctionTypeShape(right_pure, right_params, right_return)):
			(
				left_pure == right_pure
				and exported_type_shape_lists_equal(left_params, right_params)
				and exported_type_shapes_equal(left_return, right_return)
			)
		(CompilerExportedTypeParameterShape(left_index), CompilerExportedTypeParameterShape(right_index)):
			left_index == right_index
		(CompilerExportedConstIntTypeShape(left_value), CompilerExportedConstIntTypeShape(right_value)):
			left_value == right_value
		(CompilerExportedTupleTypeShape(left_elements), CompilerExportedTupleTypeShape(right_elements)):
			exported_type_shape_lists_equal(left_elements, right_elements)
		(CompilerExportedSelfTypeShape, CompilerExportedSelfTypeShape):
			True
		(CompilerExportedDimParameterShape(left_index), CompilerExportedDimParameterShape(right_index)):
			left_index == right_index
		(CompilerExportedRangeTypeShape(left_inner), CompilerExportedRangeTypeShape(right_inner)):
			exported_type_shapes_equal(left_inner, right_inner)
		(CompilerExportedDimOpTypeShape(left_op, left_a, left_b), CompilerExportedDimOpTypeShape(right_op, right_a, right_b)):
			(
				left_op == right_op
				and exported_type_shapes_equal(left_a, right_a)
				and exported_type_shapes_equal(left_b, right_b)
			)
		_:
			False


private pure func exported_callable_signatures_equal(
	left: Option[CompilerExportedCallableSignature],
	right: Option[CompilerExportedCallableSignature],
) -> Bool:
	match (left, right):
		(None, None):
			True
		(Some(left_signature), Some(right_signature)):
			(
				exported_bound_lists_equal(
					left_signature.type_parameter_bounds,
					right_signature.type_parameter_bounds,
				)
				and exported_type_shapes_equal(
					left_signature.function_type,
					right_signature.function_type,
				)
			)
		_:
			False


private pure func exported_bound_lists_equal(
	left: List[List[String]],
	right: List[List[String]],
) -> Bool:
	(
		left.length() == right.length()
		and left
			.zip(right)
			.all(func(bound_pair):
				(
					bound_pair[0].length() == bound_pair[1].length()
					and bound_pair[0]
						.zip(bound_pair[1])
						.all(func(name_pair):
							name_pair[0] == name_pair[1]
						)
				)
			)
	)


pure func compiler_exported_symbol_keys_equal(
	left: CompilerExportedSymbolKey,
	right: CompilerExportedSymbolKey,
) -> Bool:
	left_representation: CompilerExportedSymbolKeyRep = from CompilerExportedSymbolKey(left)
	right_representation: CompilerExportedSymbolKeyRep = from CompilerExportedSymbolKey(right)

	(
		compiler_module_identities_equal(
			left_representation.module_identity,
			right_representation.module_identity,
		)
		and left_representation.kind == right_representation.kind
		and left_representation.owner == right_representation.owner
		and left_representation.name == right_representation.name
		and exported_callable_signatures_equal(
			left_representation.callable_signature,
			right_representation.callable_signature,
		)
	)


pure func compiler_func_callable_key_module_identity(
	key: CompilerFuncCallableKey,
) -> CompilerModuleIdentity:
	representation: CompilerFuncCallableKeyRep = from CompilerFuncCallableKey(key)
	representation.module_identity


pure func compiler_func_callable_key_name(key: CompilerFuncCallableKey) -> String:
	representation: CompilerFuncCallableKeyRep = from CompilerFuncCallableKey(key)
	representation.name


pure func compiler_func_callable_key_span(key: CompilerFuncCallableKey) -> CompilerSourceSpan:
	representation: CompilerFuncCallableKeyRep = from CompilerFuncCallableKey(key)
	representation.span


pure func compiler_source_definition_key_module_identity(
	key: CompilerSourceDefinitionKey,
) -> CompilerModuleIdentity:
	representation: CompilerSourceDefinitionKeyRep = from CompilerSourceDefinitionKey(key)
	representation.module_identity


pure func compiler_source_definition_key_name(key: CompilerSourceDefinitionKey) -> String:
	representation: CompilerSourceDefinitionKeyRep = from CompilerSourceDefinitionKey(key)
	representation.name


pure func compiler_source_definition_key_kind(
	key: CompilerSourceDefinitionKey,
) -> CompilerSourceDefinitionKind:
	representation: CompilerSourceDefinitionKeyRep = from CompilerSourceDefinitionKey(key)
	representation.kind


pure func compiler_source_definition_key_owner(key: CompilerSourceDefinitionKey) -> Option[String]:
	representation: CompilerSourceDefinitionKeyRep = from CompilerSourceDefinitionKey(key)
	representation.owner


pure func compiler_source_definition_key_span(
	key: CompilerSourceDefinitionKey,
) -> CompilerSourceSpan:
	representation: CompilerSourceDefinitionKeyRep = from CompilerSourceDefinitionKey(key)
	representation.span


pure func compiler_func_callable_keys_equal(
	left: CompilerFuncCallableKey,
	right: CompilerFuncCallableKey,
) -> Bool:
	left_representation: CompilerFuncCallableKeyRep = from CompilerFuncCallableKey(left)
	right_representation: CompilerFuncCallableKeyRep = from CompilerFuncCallableKey(right)

	(
		compiler_module_identities_equal(
			left_representation.module_identity,
			right_representation.module_identity,
		)
		and left_representation.name == right_representation.name
		and compiler_source_spans_equal(left_representation.span, right_representation.span)
	)


pure func compiler_source_definition_keys_equal(
	left: CompilerSourceDefinitionKey,
	right: CompilerSourceDefinitionKey,
) -> Bool:
	left_representation: CompilerSourceDefinitionKeyRep = from CompilerSourceDefinitionKey(left)
	right_representation: CompilerSourceDefinitionKeyRep = from CompilerSourceDefinitionKey(right)

	(
		compiler_module_identities_equal(
			left_representation.module_identity,
			right_representation.module_identity,
		)
		and left_representation.kind == right_representation.kind
		and left_representation.name == right_representation.name
		and left_representation.owner == right_representation.owner
		and compiler_source_spans_equal(left_representation.span, right_representation.span)
	)


pure func compiler_func_callable_key_description(key: CompilerFuncCallableKey) -> String:
	representation: CompilerFuncCallableKeyRep = from CompilerFuncCallableKey(key)
	"callable '" + representation.name + "' in module '" + compiler_module_identity_display_name(
		representation.module_identity,
	) + "'"


private pure func compiler_source_definition_kind_description(
	kind: CompilerSourceDefinitionKind,
) -> String:
	match kind:
		CompilerConstructorDefinition:
			"constructor"
		CompilerTraitDefinition:
			"trait"
		CompilerImplDefinition:
			"implementation"
		CompilerGlobalDefinition:
			"global"
		CompilerTypeDefinition:
			"type"
		CompilerFieldDefinition:
			"field"


pure func compiler_source_definition_key_description(key: CompilerSourceDefinitionKey) -> String:
	representation: CompilerSourceDefinitionKeyRep = from CompilerSourceDefinitionKey(key)
	compiler_source_definition_kind_description(
		representation.kind,
	) + " '" + representation.name + "' in module '" + compiler_module_identity_display_name(
		representation.module_identity,
	) + "'"
