-- Stable source identities shared by graph indexing and typechecking.
--
-- These keys describe source declarations, not mutable typecheck state. Keeping
-- them graph-owned prevents the definition index from depending on the broad
-- state record that later phases consume.
import:
	../../stage_01_file_io/source: CompilerSourceSpan
	../../stage_04_modules/loaded_module:
		CompilerModuleIdentity,
		compiler_module_identities_equal,
		compiler_module_identity_display_name,


private record CompilerFuncCallableKeyRep {
	module_identity: CompilerModuleIdentity,
	name: String,
	span: CompilerSourceSpan
}


opaque type CompilerFuncCallableKey = CompilerFuncCallableKeyRep


enum CompilerSourceDefinitionKind:
	CompilerConstructorDefinition
	CompilerTraitDefinition
	CompilerImplDefinition


private record CompilerSourceDefinitionKeyRep {
	module_identity: CompilerModuleIdentity,
	kind: CompilerSourceDefinitionKind,
	name: String,
	owner: Option[String],
	span: CompilerSourceSpan
}


opaque type CompilerSourceDefinitionKey = CompilerSourceDefinitionKeyRep


pure func compiler_func_callable_key(
	module_identity: CompilerModuleIdentity,
	name: String,
	span: CompilerSourceSpan,
) -> CompilerFuncCallableKey:
	representation: CompilerFuncCallableKeyRep = {
		module_identity = module_identity,
		name = name,
		span = span
	}
	into CompilerFuncCallableKey(representation)


pure func compiler_source_definition_key(
	module_identity: CompilerModuleIdentity,
	kind: CompilerSourceDefinitionKind,
	name: String,
	owner: Option[String],
	span: CompilerSourceSpan,
) -> CompilerSourceDefinitionKey:
	representation: CompilerSourceDefinitionKeyRep = {
		module_identity = module_identity,
		kind = kind,
		name = name,
		owner = owner,
		span = span
	}
	into CompilerSourceDefinitionKey(representation)


pure func compiler_func_callable_key_module_identity(
	key: CompilerFuncCallableKey,
) -> CompilerModuleIdentity:
	representation: CompilerFuncCallableKeyRep = from CompilerFuncCallableKey(key)
	representation.module_identity


pure func compiler_func_callable_key_name(key: CompilerFuncCallableKey) -> String:
	representation: CompilerFuncCallableKeyRep = from CompilerFuncCallableKey(key)
	representation.name


pure func compiler_func_callable_key_span(key: CompilerFuncCallableKey) -> CompilerSourceSpan:
	representation: CompilerFuncCallableKeyRep = from CompilerFuncCallableKey(key)
	representation.span


pure func compiler_source_definition_key_module_identity(
	key: CompilerSourceDefinitionKey,
) -> CompilerModuleIdentity:
	representation: CompilerSourceDefinitionKeyRep = from CompilerSourceDefinitionKey(key)
	representation.module_identity


pure func compiler_source_definition_key_name(key: CompilerSourceDefinitionKey) -> String:
	representation: CompilerSourceDefinitionKeyRep = from CompilerSourceDefinitionKey(key)
	representation.name


pure func compiler_source_definition_key_span(
	key: CompilerSourceDefinitionKey,
) -> CompilerSourceSpan:
	representation: CompilerSourceDefinitionKeyRep = from CompilerSourceDefinitionKey(key)
	representation.span


private pure func definition_spans_equal(
	left: CompilerSourceSpan,
	right: CompilerSourceSpan,
) -> Bool:
	(
		left.start_line == right.start_line
		and left.start_column == right.start_column
		and left.end_line == right.end_line
		and left.end_column == right.end_column
		and left.path == right.path
	)


pure func compiler_func_callable_keys_equal(
	left: CompilerFuncCallableKey,
	right: CompilerFuncCallableKey,
) -> Bool:
	left_representation: CompilerFuncCallableKeyRep = from CompilerFuncCallableKey(left)
	right_representation: CompilerFuncCallableKeyRep = from CompilerFuncCallableKey(right)

	(
		compiler_module_identities_equal(
			left_representation.module_identity,
			right_representation.module_identity,
		)
		and left_representation.name == right_representation.name
		and definition_spans_equal(left_representation.span, right_representation.span)
	)


pure func compiler_source_definition_keys_equal(
	left: CompilerSourceDefinitionKey,
	right: CompilerSourceDefinitionKey,
) -> Bool:
	left_representation: CompilerSourceDefinitionKeyRep = from CompilerSourceDefinitionKey(left)
	right_representation: CompilerSourceDefinitionKeyRep = from CompilerSourceDefinitionKey(right)

	(
		compiler_module_identities_equal(
			left_representation.module_identity,
			right_representation.module_identity,
		)
		and left_representation.kind == right_representation.kind
		and left_representation.name == right_representation.name
		and left_representation.owner == right_representation.owner
		and definition_spans_equal(left_representation.span, right_representation.span)
	)


pure func compiler_func_callable_key_description(key: CompilerFuncCallableKey) -> String:
	representation: CompilerFuncCallableKeyRep = from CompilerFuncCallableKey(key)
	"callable '" + representation.name + "' in module '" + compiler_module_identity_display_name(
		representation.module_identity,
	) + "'"


private pure func compiler_source_definition_kind_description(
	kind: CompilerSourceDefinitionKind,
) -> String:
	match kind:
		CompilerConstructorDefinition:
			"constructor"
		CompilerTraitDefinition:
			"trait"
		CompilerImplDefinition:
			"implementation"


pure func compiler_source_definition_key_description(key: CompilerSourceDefinitionKey) -> String:
	representation: CompilerSourceDefinitionKeyRep = from CompilerSourceDefinitionKey(key)
	compiler_source_definition_kind_description(
		representation.kind,
	) + " '" + representation.name + "' in module '" + compiler_module_identity_display_name(
		representation.module_identity,
	) + "'"
