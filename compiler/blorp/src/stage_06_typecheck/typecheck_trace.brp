-- Typed phase identities for typecheck tracing.
--
-- Trace callbacks carry the phase and declaration index separately because
-- enums and Ints cross closure boundaries as C scalars. An aggregate trace
-- event would be boxed and would contaminate typecheck allocation profiles.
-- The index is only read for BodyDeclStart and BodyDeclComplete.
--
-- Known boundary: the pair can represent a body phase without a valid index,
-- or an indexed fixed phase. Keep construction inside the typecheck pipeline;
-- a payload-bearing scalar enum ABI would let this become one closed value.
enum TypecheckTracePhase:
	GraphPrepareStart
	GraphParseComplete
	GraphImportablesComplete
	GraphDefinitionIndexComplete
	GraphCtfePlanComplete
	GraphDeclarationSkeletonComplete
	GraphTypeAliasDependenciesComplete
	GraphTypeParameterHeadersComplete
	GraphTypeHeadersComplete
	GraphTraitTopologyComplete
	GraphCallableHeadersComplete
	GraphImplementationHeadersComplete
	GraphPrepareComplete
	CtfeDependencyTypecheckStart
	CtfeDependencyTypecheckComplete
	TypecheckStart
	PreludeComplete
	ReachableImportsComplete
	ImportSurfacesComplete
	DirectImportsComplete
	PrescanComplete
	ImportSyntaxComplete
	ImportDeclsComplete
	LocalTypesComplete
	LocalSignaturesComplete
	LocalImplsComplete
	BodyDeclStart
	BodyDeclComplete
	BodiesComplete
	HeaderModuleMismatch
	TypecheckComplete
	ProjectionComplete
	EmitComplete
	TypedArtifactScopeComplete


TYPECHECK_TRACE_UNINDEXED: Int = -1


pure func typecheck_trace_phase_name(phase: TypecheckTracePhase, declaration_index: Int) -> String:
	match phase:
		GraphPrepareStart:
			"graph_prepare_start"
		GraphParseComplete:
			"graph_parse_complete"
		GraphImportablesComplete:
			"graph_importables_complete"
		GraphDefinitionIndexComplete:
			"graph_definition_index_complete"
		GraphCtfePlanComplete:
			"graph_ctfe_plan_complete"
		GraphDeclarationSkeletonComplete:
			"graph_declaration_skeleton_complete"
		GraphTypeAliasDependenciesComplete:
			"graph_type_alias_dependencies_complete"
		GraphTypeParameterHeadersComplete:
			"graph_type_parameter_headers_complete"
		GraphTypeHeadersComplete:
			"graph_type_headers_complete"
		GraphTraitTopologyComplete:
			"graph_trait_topology_complete"
		GraphCallableHeadersComplete:
			"graph_callable_headers_complete"
		GraphImplementationHeadersComplete:
			"graph_implementation_headers_complete"
		GraphPrepareComplete:
			"graph_prepare_complete"
		CtfeDependencyTypecheckStart:
			"ctfe_dependency_typecheck_start"
		CtfeDependencyTypecheckComplete:
			"ctfe_dependency_typecheck_complete"
		TypecheckStart:
			"typecheck_start"
		PreludeComplete:
			"typecheck_prelude_complete"
		ReachableImportsComplete:
			"typecheck_reachable_imports_complete"
		ImportSurfacesComplete:
			"typecheck_import_surfaces_complete"
		DirectImportsComplete:
			"typecheck_direct_imports_complete"
		PrescanComplete:
			"typecheck_prescan_complete"
		ImportSyntaxComplete:
			"typecheck_import_syntax_complete"
		ImportDeclsComplete:
			"typecheck_import_decls_complete"
		LocalTypesComplete:
			"typecheck_local_types_complete"
		LocalSignaturesComplete:
			"typecheck_local_signatures_complete"
		LocalImplsComplete:
			"typecheck_local_impls_complete"
		BodyDeclStart:
			"typecheck_body_decl_${declaration_index.to_string()}_start"
		BodyDeclComplete:
			"typecheck_body_decl_${declaration_index.to_string()}_complete"
		BodiesComplete:
			"typecheck_bodies_complete"
		HeaderModuleMismatch:
			"typecheck_header_module_mismatch"
		TypecheckComplete:
			"typecheck_complete"
		ProjectionComplete:
			"projection_complete"
		EmitComplete:
			"emit_complete"
		TypedArtifactScopeComplete:
			"typed_artifact_scope_complete"
