private record ResourceTypeScanContext {
	env: Env,
	known_resource_type_names: List[String]
}


private record FunctionBodySignature {
	callable_id: Option[Int],
	effective_type_params: List[BoundTypeParam],
	param_types: List[SemanticType],
	semantic_return_type: SemanticType
}


private pure func typecheck_state_with_env(
	state: CompilerTypecheckState,
	env: Env,
) -> CompilerTypecheckState:
	{ state | env = env }


private pure func canonical_annotation_type(
	state: CompilerTypecheckState,
	typ: SemanticType,
) -> SemanticType:
	qualified = resolve_qualified_type_names(state.module_aliases, typ)
	imported = resolve_imported_type_aliases_from_bindings(
		state.imported_names,
		state.type_homes,
		qualified,
	)
	type_instantiate_type_params(
		env_get_type_params(state.env),
		env_resolve_alias(state.env, imported),
	)


private pure func canonical_function_annotation_type(
	state: CompilerTypecheckState,
	declared_type_param_names: List[String],
	typ: SemanticType,
) -> SemanticType:
	canonical_annotation_type(
		state,
		type_instantiate_type_params(declared_type_param_names, typ),
	)


private pure func canonical_return_type(
	state: CompilerTypecheckState,
	declared_type_param_names: List[String],
	return_type: Option[ParsedTypeExpr],
) -> Option[SemanticType]:
	return_type.map(
		func(
			type_expr,
		): canonical_function_annotation_type(
			state,
			declared_type_param_names,
			compiler_type_from_parsed_type_expr(type_expr),
		),
	)


private pure func imported_type_name_from_bindings_if_changed(
	imported_names: List[CompilerImportedNameBinding],
	type_homes: List[CompilerTypecheckTypeHome],
	name: String,
) -> Option[String]:
	var result: Option[String] = None

	for binding in imported_names:
		if binding.local_name == name:
			for home in type_homes:
				if home.type_name == name and home.imported:
					result = Some(
						canonical_module_type_name(
							home.module_path,
							binding.original_name,
						),
					)
					break
				else:
					void

			break

	result


private pure func resolve_imported_type_alias_list_from_bindings_if_changed(
	imported_names: List[CompilerImportedNameBinding],
	type_homes: List[CompilerTypecheckTypeHome],
	types: List[SemanticType],
) -> Option[List[SemanticType]]:
	var resolved: List[SemanticType] = types
	var changed: Bool = False
	var index: Int = 0

	for typ in types:
		match resolve_imported_type_aliases_from_bindings_if_changed(
			imported_names,
			type_homes,
			typ,
		):
			Some(resolved_type):
				resolved = resolved.set(index, resolved_type)
				changed = True
			None:
				void

		index += 1

	if changed:
		Some(resolved)
	else:
		None


private pure func resolve_imported_type_aliases_from_bindings_if_changed(
	imported_names: List[CompilerImportedNameBinding],
	type_homes: List[CompilerTypecheckTypeHome],
	typ: SemanticType,
) -> Option[SemanticType]:
	match typ:
		SemanticNamedType(name, args):
			name_result = imported_type_name_from_bindings_if_changed(
				imported_names,
				type_homes,
				name,
			)
			args_result = resolve_imported_type_alias_list_from_bindings_if_changed(
				imported_names,
				type_homes,
				args,
			)

			if name_result.is_some() or args_result.is_some():
				Some(SemanticNamedType(name_result.get_or(name), args_result.get_or(args)))
			else:
				None
		SemanticArrayType(element, dims):
			element_result = resolve_imported_type_aliases_from_bindings_if_changed(
				imported_names,
				type_homes,
				element,
			)
			dims_result = resolve_imported_type_alias_list_from_bindings_if_changed(
				imported_names,
				type_homes,
				dims,
			)

			if element_result.is_some() or dims_result.is_some():
				Some(SemanticArrayType(element_result.get_or(element), dims_result.get_or(dims)))
			else:
				None
		SemanticFunctionType(is_pure, params, return_type):
			params_result = resolve_imported_type_alias_list_from_bindings_if_changed(
				imported_names,
				type_homes,
				params,
			)
			return_result = resolve_imported_type_aliases_from_bindings_if_changed(
				imported_names,
				type_homes,
				return_type,
			)

			if params_result.is_some() or return_result.is_some():
				Some(
					SemanticFunctionType(
						is_pure,
						params_result.get_or(params),
						return_result.get_or(return_type),
					),
				)
			else:
				None
		SemanticTupleType(elements):
			match resolve_imported_type_alias_list_from_bindings_if_changed(
				imported_names,
				type_homes,
				elements,
			):
				Some(resolved_elements):
					Some(SemanticTupleType(resolved_elements))
				None:
					None
		SemanticRangeType(inner):
			match resolve_imported_type_aliases_from_bindings_if_changed(
				imported_names,
				type_homes,
				inner,
			):
				Some(resolved_inner):
					Some(SemanticRangeType(resolved_inner))
				None:
					None
		SemanticDimOpType(op, left, right):
			left_result = resolve_imported_type_aliases_from_bindings_if_changed(
				imported_names,
				type_homes,
				left,
			)
			right_result = resolve_imported_type_aliases_from_bindings_if_changed(
				imported_names,
				type_homes,
				right,
			)

			if left_result.is_some() or right_result.is_some():
				Some(SemanticDimOpType(op, left_result.get_or(left), right_result.get_or(right)))
			else:
				None
		SemanticTypeVar(_):
			None
		SemanticConstIntType(_):
			None
		SemanticSelfType:
			None
		SemanticVarDimsType(_):
			None
		SemanticMetaType(_):
			None


pure func resolve_imported_type_aliases_from_bindings(
	imported_names: List[CompilerImportedNameBinding],
	type_homes: List[CompilerTypecheckTypeHome],
	typ: SemanticType,
) -> SemanticType:
	if imported_names.is_empty() or type_homes.is_empty():
		typ
	else:
		match resolve_imported_type_aliases_from_bindings_if_changed(
			imported_names,
			type_homes,
			typ,
		):
			Some(resolved):
				resolved
			None:
				typ


private pure func resolve_imported_type_aliases(
	import_state: CompilerTypecheckState,
	typ: SemanticType,
) -> SemanticType:
	resolve_imported_type_aliases_from_bindings(
		import_state.imported_names,
		import_state.type_homes,
		typ,
	)


private pure func qualify_imported_type(
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	typ: SemanticType,
) -> SemanticType:
	local_or_global = qualify_module_local_types(module_path, local_type_names, typ)
	qualified = resolve_qualified_type_names(import_state.module_aliases, local_or_global)
	resolve_imported_type_aliases(import_state, qualified)


private pure func imported_annotation_type(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	typ: SemanticType,
) -> SemanticType:
	canonical_annotation_type(
		state,
		qualify_imported_type(import_state, module_path, local_type_names, typ),
	)


private pure func imported_function_annotation_type(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	declared_type_param_names: List[String],
	typ: SemanticType,
) -> SemanticType:
	imported_annotation_type(
		state,
		import_state,
		module_path,
		local_type_names,
		type_instantiate_type_params(declared_type_param_names, typ),
	)


private pure func imported_type_alias_names(
	state: CompilerTypecheckState,
	module_path: String,
	original_name: String,
) -> List[String]:
	var names: List[String] = []

	for binding in state.imported_names:
		if binding.module_path == module_path and binding.original_name == original_name:
			names = names.append(binding.local_name)

	names


private pure func add_imported_type_aliases(
	state: CompilerTypecheckState,
	module_path: String,
	original_name: String,
	canonical_name: String,
	type_params: List[String],
) -> CompilerTypecheckState:
	var next = state

	for alias_name in imported_type_alias_names(state, module_path, original_name):
		if alias_name != canonical_name:
			env: Env = env_add_alias(
				next.env,
				alias_name,
				type_params,
				SemanticNamedType(
					canonical_name,
					type_params.map(func(param): SemanticTypeVar(param)),
				),
			)
			next = typecheck_state_with_env(next, env)

	next


private pure func typecheck_with_body_env(
	state: CompilerTypecheckState,
	body_state: CompilerTypecheckState,
) -> CompilerTypecheckState:
	next_def_id = if body_state.env.next_def_id > state.env.next_def_id:
		body_state.env.next_def_id
	else:
		state.env.next_def_id

	env = { state.env | next_def_id = next_def_id }
	{ body_state | env = env }


record TypedFunctionInfo {
	decl: ParsedFunctionDecl,
	callable_id: Option[Int],
	effective_type_params: List[BoundTypeParam],
	param_types: List[SemanticType],
	source_return_type: Option[SemanticType],
	semantic_return_type: SemanticType,
	body: Option[TypedExpr]
}


record TypedGlobalVarInfo {
	decl: ParsedVarDecl,
	binding_type: SemanticType,
	source_type: Option[SemanticType],
	value: TypedExpr
}


record TypedRecordFieldInfo {
	name: String,
	source_type: SemanticType,
	semantic_type: SemanticType
}


record TypedRecordInfo {
	decl: ParsedRecordDecl,
	fields: List[TypedRecordFieldInfo]
}


record TypedTypeAliasInfo {
	decl: ParsedTypeAliasDecl,
	source_target_type: SemanticType,
	semantic_target_type: SemanticType
}


record TypedTraitMethodInfo {
	decl: ParsedTraitMethodDecl,
	param_types: List[SemanticType],
	semantic_return_type: SemanticType
}


record TypedTraitInfo {
	decl: ParsedTraitDecl,
	methods: List[TypedTraitMethodInfo]
}


record TypedUnionVariantInfo {
	name: String,
	fields: List[SemanticType],
	tag: Int,
	def_id: Option[Int]
}


record TypedUnionInfo {
	decl: ParsedUnionDecl,
	variants: List[TypedUnionVariantInfo]
}


record TypedImplInfo {
	decl: ParsedImplDecl,
	for_type: SemanticType,
	type_params: List[BoundTypeParam],
	methods: List[TypedFunctionInfo]
}


enum TypedForeignLinkPlatform:
	TypedForeignLinux
	TypedForeignMacos


pure func typed_foreign_link_platform_to_string(platform: TypedForeignLinkPlatform) -> String:
	match platform:
		TypedForeignLinux:
			"linux"
		TypedForeignMacos:
			"macos"


record TypedForeignLinkFlag {
	platform: Option[TypedForeignLinkPlatform],
	flag: String
}


enum TypedForeignArgPassing:
	TypedForeignDefaultArgs
	TypedForeignBorrowArgs


pure func typed_foreign_arg_passing_borrows(arg_passing: TypedForeignArgPassing) -> Bool:
	match arg_passing:
		TypedForeignDefaultArgs:
			False
		TypedForeignBorrowArgs:
			True


record TypedForeignFunctionInfo {
	decl: ParsedForeignFunctionDecl,
	callable_id: Option[Int],
	param_types: List[SemanticType],
	semantic_return_type: SemanticType,
	c_name: String,
	includes: List[String],
	link_flags: List[TypedForeignLinkFlag],
	arg_passing: TypedForeignArgPassing,
	block_span: CompilerSourceSpan
}


union TypedDecl:
	TypedFunctionDecl(TypedFunctionInfo)
	TypedForeignFunctionDecl(TypedForeignFunctionInfo)
	TypedGlobalVarDecl(TypedGlobalVarInfo)
	TypedRecordDecl(TypedRecordInfo)
	TypedTypeAliasDecl(TypedTypeAliasInfo)
	TypedTraitDecl(TypedTraitInfo)
	TypedUnionDecl(TypedUnionInfo)
	TypedImplDecl(TypedImplInfo)
	TypedPrivateDecl(TypedDecl)
	TypedParsedDecl(ParsedDecl)


record TypedProgram {
	source: CompilerSourceFile,
	decls: List[TypedDecl],
	diagnostics: List[CompilerParseDiagnostic]
}


record TypecheckFunctionBodyResult {
	state: CompilerTypecheckState,
	typed: TypedFunctionInfo
}


record TypecheckGlobalVarBodyResult {
	state: CompilerTypecheckState,
	typed: TypedGlobalVarInfo
}


private union GlobalTypeExpectation:
	InferredGlobalType
	DeclaredGlobalType(SemanticType)


record TypecheckImplBodyResult {
	state: CompilerTypecheckState,
	typed: TypedImplInfo
}


record TypecheckDeclBodyResult {
	state: CompilerTypecheckState,
	decl: TypedDecl
}


record TypecheckProgramResult {
	state: CompilerTypecheckState,
	program: TypedProgram
}


private record TypedForeignBlockResult {
	state: CompilerTypecheckState,
	decls: List[TypedDecl]
}


private pure func typed_program_from_decls(
	program: ParsedProgram,
	decls: List[TypedDecl],
) -> TypedProgram:
	{
		source = program.source,
		decls = decls,
		diagnostics = program.diagnostics
	}


private pure func typecheck_unfinalized_type_error(
	state: CompilerTypecheckState,
	label: String,
	typ: SemanticType,
) -> CompilerTypecheckState:
	if type_contains_meta(typ):
		compiler_typecheck_state_add_error(
			state,
			"internal typecheck error: typed program contains unfinalized inference meta in " + label + ": " + type_to_string(
				typ,
			),
		)
	else:
		state


private pure func typecheck_validate_optional_typed_type(
	state: CompilerTypecheckState,
	label: String,
	typ: Option[SemanticType],
) -> CompilerTypecheckState:
	match typ:
		Some(value):
			typecheck_unfinalized_type_error(state, label, value)
		None:
			state


private pure func typecheck_validate_typed_expr(
	state: CompilerTypecheckState,
	label: String,
	expr: TypedExpr,
) -> CompilerTypecheckState:
	if typed_expr_contains_meta(expr):
		compiler_typecheck_state_add_error(
			state,
			(
				"internal typecheck error: typed expression contains unfinalized inference meta "
				+ "in "
			) + label,
		)
	else:
		match typed_expr_type_error(expr):
			Some(message):
				compiler_typecheck_state_add_error(
					state,
					"internal typecheck error: typed expression has incoherent type info " + "in " + label + ": " + message,
				)
			None:
				state


private pure func typecheck_validate_typed_function_info(
	state: CompilerTypecheckState,
	label: String,
	info: TypedFunctionInfo,
) -> CompilerTypecheckState:
	var next = state
	var index: Int = 0

	for param_type in info.param_types:
		next = typecheck_unfinalized_type_error(
			next,
			label + " parameter " + index.to_string(),
			param_type,
		)
		index += 1

	next = typecheck_validate_optional_typed_type(
		next,
		label + " source return type",
		info.source_return_type,
	)
	next = typecheck_unfinalized_type_error(
		next,
		label + " semantic return type",
		info.semantic_return_type,
	)

	match info.body:
		Some(body):
			typecheck_validate_typed_expr(next, label + " body", body)
		None:
			next


private pure func typecheck_validate_typed_global_info(
	state: CompilerTypecheckState,
	label: String,
	info: TypedGlobalVarInfo,
) -> CompilerTypecheckState:
	with_binding = typecheck_unfinalized_type_error(
		state,
		label + " binding type",
		info.binding_type,
	)
	with_source = typecheck_validate_optional_typed_type(
		with_binding,
		label + " source type",
		info.source_type,
	)

	typecheck_validate_typed_expr(with_source, label + " value", info.value)


private pure func typecheck_validate_typed_record_info(
	state: CompilerTypecheckState,
	label: String,
	info: TypedRecordInfo,
) -> CompilerTypecheckState:
	var next = state

	for field in info.fields:
		next = typecheck_unfinalized_type_error(
			next,
			label + " field '" + field.name + "' source type",
			field.source_type,
		)
		next = typecheck_unfinalized_type_error(
			next,
			label + " field '" + field.name + "' semantic type",
			field.semantic_type,
		)

	next


private pure func typecheck_validate_typed_alias_info(
	state: CompilerTypecheckState,
	label: String,
	info: TypedTypeAliasInfo,
) -> CompilerTypecheckState:
	with_source = typecheck_unfinalized_type_error(
		state,
		label + " source target type",
		info.source_target_type,
	)

	typecheck_unfinalized_type_error(
		with_source,
		label + " semantic target type",
		info.semantic_target_type,
	)


private pure func typecheck_validate_typed_trait_info(
	state: CompilerTypecheckState,
	label: String,
	info: TypedTraitInfo,
) -> CompilerTypecheckState:
	var next = state

	for method in info.methods:
		var index: Int = 0

		for param_type in method.param_types:
			next = typecheck_unfinalized_type_error(
				next,
				label + " method '" + method.decl.name.text + "' parameter " + index.to_string(),
				param_type,
			)
			index += 1

		next = typecheck_unfinalized_type_error(
			next,
			label + " method '" + method.decl.name.text + "' return type",
			method.semantic_return_type,
		)

	next


private pure func typecheck_validate_typed_union_info(
	state: CompilerTypecheckState,
	label: String,
	info: TypedUnionInfo,
) -> CompilerTypecheckState:
	var next = state

	for variant in info.variants:
		var index: Int = 0

		for field in variant.fields:
			next = typecheck_unfinalized_type_error(
				next,
				label + " variant '" + variant.name + "' field " + index.to_string(),
				field,
			)
			index += 1

	next


private pure func typecheck_validate_typed_impl_info(
	state: CompilerTypecheckState,
	label: String,
	info: TypedImplInfo,
) -> CompilerTypecheckState:
	var next = typecheck_unfinalized_type_error(state, label + " target type", info.for_type)
	var index: Int = 0

	for method in info.methods:
		next = typecheck_validate_typed_function_info(
			next,
			label + " method " + index.to_string() + " '" + method.decl.name.text + "'",
			method,
		)
		index += 1

	next


private pure func typecheck_validate_typed_decl(
	state: CompilerTypecheckState,
	decl: TypedDecl,
) -> CompilerTypecheckState:
	match decl:
		TypedFunctionDecl(info):
			typecheck_validate_typed_function_info(
				state,
				"function '" + info.decl.name.text + "'",
				info,
			)
		TypedForeignFunctionDecl(info):
			var next = state
			var index: Int = 0

			for param_type in info.param_types:
				next = typecheck_unfinalized_type_error(
					next,
					"foreign function '" + info.decl.name.text + "' parameter " + index.to_string(),
					param_type,
				)
				index += 1

			typecheck_unfinalized_type_error(
				next,
				"foreign function '" + info.decl.name.text + "' return type",
				info.semantic_return_type,
			)
		TypedGlobalVarDecl(info):
			typecheck_validate_typed_global_info(
				state,
				"global '" + info.decl.name.text + "'",
				info,
			)
		TypedRecordDecl(info):
			typecheck_validate_typed_record_info(
				state,
				"record '" + info.decl.name.text + "'",
				info,
			)
		TypedTypeAliasDecl(info):
			typecheck_validate_typed_alias_info(
				state,
				"type alias '" + info.decl.name.text + "'",
				info,
			)
		TypedTraitDecl(info):
			typecheck_validate_typed_trait_info(state, "trait '" + info.decl.name.text + "'", info)
		TypedUnionDecl(info):
			typecheck_validate_typed_union_info(state, "union '" + info.decl.name.text + "'", info)
		TypedImplDecl(info):
			typecheck_validate_typed_impl_info(
				state,
				"impl '" + info.decl.trait_name.text + "'",
				info,
			)
		TypedPrivateDecl(inner):
			typecheck_validate_typed_decl(state, inner)
		TypedParsedDecl(_):
			state


pure func typecheck_validate_typed_program(
	result: TypecheckProgramResult,
) -> TypecheckProgramResult:
	var next_state = result.state

	for decl in result.program.decls:
		next_state = typecheck_validate_typed_decl(next_state, decl)

	{ result | state = next_state }


private pure func resource_type_scan_context(
	env: Env,
	known_resource_type_names: List[String],
) -> ResourceTypeScanContext:
	{
		env = env,
		known_resource_type_names = known_resource_type_names
	}


private pure func resource_type_scan_has_known_name(
	context: ResourceTypeScanContext,
	name: String,
) -> Bool:
	context.known_resource_type_names.contains(name)


private pure func resource_type_scan_contains(
	context: ResourceTypeScanContext,
	typ: SemanticType,
) -> Bool:
	resolved_type = env_resolve_alias_head(context.env, typ)

	match resolved_type:
		SemanticNamedType(name, args):
			(
				resource_type_scan_has_known_name(context, name)
				or env_type_is_resource(context.env, name)
				or args.any(func(arg): resource_type_scan_contains(context, arg))
			)
		SemanticArrayType(element, dims):
			(
				resource_type_scan_contains(context, element)
				or dims.any(func(dim): resource_type_scan_contains(context, dim))
			)
		SemanticFunctionType(_, params, return_type):
			(
				params.any(func(param): resource_type_scan_contains(context, param))
				or resource_type_scan_contains(context, return_type)
			)
		SemanticTupleType(elements):
			elements.any(func(element): resource_type_scan_contains(context, element))
		SemanticRangeType(inner):
			resource_type_scan_contains(context, inner)
		SemanticDimOpType(_, left, right):
			(
				resource_type_scan_contains(context, left)
				or resource_type_scan_contains(context, right)
			)
		_:
			False


private pure func field_from_parsed_with_type(
	field: ParsedFieldDecl,
	field_type: SemanticType,
) -> FieldDecl:
	{
		name = field.name.text,
		field_type = field_type
	}


private pure func field_from_parsed(
	state: CompilerTypecheckState,
	field: ParsedFieldDecl,
) -> FieldDecl:
	field_from_parsed_with_type(
		field,
		canonical_annotation_type(state, compiler_type_from_parsed_type_expr(field.type_expr)),
	)


private pure func typed_record_field_from_parsed(
	state: CompilerTypecheckState,
	type_params: List[String],
	field: ParsedFieldDecl,
) -> TypedRecordFieldInfo:
	field_type = compiler_type_from_parsed_type_expr(field.type_expr)
	semantic_type = type_instantiate_type_params(
		type_params,
		canonical_annotation_type(state, field_type),
	)
	{
		name = field.name.text,
		source_type = field_type,
		semantic_type = semantic_type
	}


private pure func typed_record_from_parsed(
	state: CompilerTypecheckState,
	record_decl: ParsedRecordDecl,
) -> TypedRecordInfo:
	type_params = compiler_type_param_names(record_decl.type_params)
	{
		decl = record_decl,
		fields = record_decl.fields.map(
			func(field): typed_record_field_from_parsed(state, type_params, field),
		)
	}


private pure func type_alias_semantic_target(
	state: CompilerTypecheckState,
	alias_decl: ParsedTypeAliasDecl,
) -> SemanticType:
	canonical_function_annotation_type(
		state,
		compiler_type_param_names(alias_decl.type_params),
		compiler_type_from_parsed_type_expr(alias_decl.target),
	)


private pure func typed_type_alias_from_parsed(
	state: CompilerTypecheckState,
	alias_decl: ParsedTypeAliasDecl,
) -> TypedTypeAliasInfo:
	source_target = compiler_type_from_parsed_type_expr(alias_decl.target)
	semantic_target = type_alias_semantic_target(state, alias_decl)
	{
		decl = alias_decl,
		source_target_type = source_target,
		semantic_target_type = semantic_target
	}


private pure func typed_trait_method_from_parsed(
	state: CompilerTypecheckState,
	type_params: List[String],
	method: ParsedTraitMethodDecl,
) -> TypedTraitMethodInfo:
	registered: TraitMethodSig = trait_method_from_parsed(method, type_params)
	{
		decl = method,
		param_types = registered.params.map(func(param_type): type_instantiate_type_params(
				type_params,
				canonical_annotation_type(state, param_type),
			)),
		semantic_return_type = type_instantiate_type_params(
			type_params,
			canonical_annotation_type(state, registered.return_type),
		)
	}


private pure func typed_trait_from_parsed(
	state: CompilerTypecheckState,
	trait_decl: ParsedTraitDecl,
) -> TypedTraitInfo:
	type_params = compiler_type_param_names(trait_decl.type_params)
	{
		decl = trait_decl,
		methods = trait_decl.methods.map(
			func(method): typed_trait_method_from_parsed(state, type_params, method),
		)
	}


private pure func variant_from_parsed(
	state: CompilerTypecheckState,
	variant: ParsedVariantDecl,
	tag: Int,
) -> VariantDef:
	{
		name = variant.name.text,
		fields = variant.fields.map(
			func(
				field,
			): canonical_annotation_type(state, compiler_type_from_parsed_type_expr(field)),
		),
		tag = tag
	}


private pure func variants_from_parsed(
	state: CompilerTypecheckState,
	variants: List[ParsedVariantDecl],
) -> List[VariantDef]:
	var result: List[VariantDef] = []
	var tag: Int = 0

	for variant in variants:
		result = result.append(variant_from_parsed(state, variant, tag))
		tag += 1

	result


private pure func typed_union_variant_from_def(
	state: CompilerTypecheckState,
	parent_type: String,
	variant: VariantDef,
) -> TypedUnionVariantInfo:
	def_id: Option[Int] = match env_get_constructor_for_parent(
		state.env,
		parent_type,
		variant.name,
	):
		Some(ctor):
			Some(ctor.constructor_id)
		None:
			None

	{
		name = variant.name,
		fields = variant.fields,
		tag = variant.tag,
		def_id = def_id
	}


private pure func typed_union_variants_from_defs(
	state: CompilerTypecheckState,
	parent_type: String,
	variants: List[VariantDef],
) -> List[TypedUnionVariantInfo]:
	variants.map(func(variant): typed_union_variant_from_def(state, parent_type, variant))


private pure func typed_union_from_parsed(
	state: CompilerTypecheckState,
	union_decl: ParsedUnionDecl,
) -> TypedUnionInfo:
	variants: List[VariantDef] = match env_get_type_decl(state.env, union_decl.name.text):
		Some(pair):
			pair[1]
		None:
			variants_from_parsed(state, union_decl.variants)

	type_params = compiler_type_param_names(union_decl.type_params)
	typed_variants = typed_union_variants_from_defs(
		state,
		union_decl.name.text,
		variants,
	).map(
		func(
			variant,
		): { variant |
			fields = variant.fields.map(
				func(field): type_instantiate_type_params(type_params, field),
			)
		},
	)

	{
		decl = union_decl,
		variants = typed_variants
	}


private pure func imported_field_from_parsed(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	type_params: List[String],
	field: ParsedFieldDecl,
) -> FieldDecl:
	field_from_parsed_with_type(
		field,
		type_instantiate_type_params(
			type_params,
			imported_annotation_type(
				state,
				import_state,
				module_path,
				local_type_names,
				compiler_type_from_parsed_type_expr(field.type_expr),
			),
		),
	)


private pure func imported_variant_from_parsed(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	type_params: List[String],
	variant: ParsedVariantDecl,
	tag: Int,
) -> VariantDef:
	{
		name = variant.name.text,
		fields = variant.fields.map(func(field): type_instantiate_type_params(
				type_params,
				imported_annotation_type(
					state,
					import_state,
					module_path,
					local_type_names,
					compiler_type_from_parsed_type_expr(field),
				),
			)),
		tag = tag
	}


private pure func imported_variants_from_parsed(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	type_params: List[String],
	variants: List[ParsedVariantDecl],
) -> List[VariantDef]:
	var result: List[VariantDef] = []
	var tag: Int = 0

	for variant in variants:
		result = result.append(
			imported_variant_from_parsed(
				state,
				import_state,
				module_path,
				local_type_names,
				type_params,
				variant,
				tag,
			),
		)
		tag += 1

	result


private pure func variant_contains_resource(
	context: ResourceTypeScanContext,
	variant: VariantDef,
) -> Bool:
	variant.fields.any(func(field):
		resource_type_scan_contains(context, field)
	)


private pure func variants_contain_resource(
	context: ResourceTypeScanContext,
	variants: List[VariantDef],
) -> Bool:
	var result: Bool = False

	for variant in variants:
		if variant_contains_resource(context, variant):
			result = True
			break

	result


private pure func fields_contain_resource(
	context: ResourceTypeScanContext,
	fields: List[FieldDecl],
) -> Bool:
	fields.any(func(field):
		resource_type_scan_contains(context, field.field_type)
	)


private pure func type_from_optional_parsed_type_expr(
	type_expr: Option[ParsedTypeExpr],
) -> SemanticType:
	match type_expr:
		Some(typ):
			compiler_type_from_parsed_type_expr(typ)
		None:
			type_void()


private pure func param_type_from_parsed(param: ParsedParam) -> SemanticType:
	type_from_optional_parsed_type_expr(param.type_expr)


private pure func param_name_from_parsed(param: ParsedParam) -> Option[String]:
	match param.binder:
		ParsedParamNameBinder(name):
			Some(name.text)
		ParsedParamWildcardBinder(_):
			None
		ParsedParamTupleBinder(_, _):
			None


private pure func param_types_from_parsed(params: List[ParsedParam]) -> List[SemanticType]:
	params.map(param_type_from_parsed)


private pure func param_names_from_parsed(params: List[ParsedParam]) -> List[Option[String]]:
	params.map(param_name_from_parsed)


private pure func param_annotation_type(param: ParsedParam) -> Option[SemanticType]:
	param.type_expr.map(compiler_type_from_parsed_type_expr)


private pure func dim_constraint_from_parsed(
	constraint: ParsedDimConstraint,
) -> (SemanticType, SemanticType):
	(
		compiler_type_from_parsed_type_expr(constraint.left),
		compiler_type_from_parsed_type_expr(constraint.right),
	)


private pure func dim_constraints_from_parsed(
	constraints: List[ParsedDimConstraint],
) -> List[(SemanticType, SemanticType)]:
	constraints.map(dim_constraint_from_parsed)


private pure func canonical_dim_constraint_from_parsed(
	state: CompilerTypecheckState,
	constraint: ParsedDimConstraint,
) -> (SemanticType, SemanticType):
	(
		canonical_annotation_type(state, compiler_type_from_parsed_type_expr(constraint.left)),
		canonical_annotation_type(state, compiler_type_from_parsed_type_expr(constraint.right)),
	)


private pure func canonical_dim_constraints_from_parsed(
	state: CompilerTypecheckState,
	constraints: List[ParsedDimConstraint],
) -> List[(SemanticType, SemanticType)]:
	constraints.map(func(constraint): canonical_dim_constraint_from_parsed(state, constraint))


private pure func imported_dim_constraint_from_parsed(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	constraint: ParsedDimConstraint,
) -> (SemanticType, SemanticType):
	(
		imported_annotation_type(
			state,
			import_state,
			module_path,
			local_type_names,
			compiler_type_from_parsed_type_expr(constraint.left),
		),
		imported_annotation_type(
			state,
			import_state,
			module_path,
			local_type_names,
			compiler_type_from_parsed_type_expr(constraint.right),
		),
	)


private pure func imported_dim_constraints_from_parsed(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	constraints: List[ParsedDimConstraint],
) -> List[(SemanticType, SemanticType)]:
	constraints.map(
		func(
			constraint,
		): imported_dim_constraint_from_parsed(
			state,
			import_state,
			module_path,
			local_type_names,
			constraint,
		),
	)


private pure func purity_from_parsed(is_pure: Bool) -> Purity:
	if is_pure:
		Pure
	else:
		Impure


private pure func annotation_is_debug_only(annotation: ParsedFunctionAnnotation) -> Bool:
	match annotation:
		ParsedDebugOnlyAnnotation:
			True
		_:
			False


private pure func function_debug_only(annotations: List[ParsedFunctionAnnotation]) -> Bool:
	annotations.any(annotation_is_debug_only)


private pure func annotation_is_tail_recursive(annotation: ParsedFunctionAnnotation) -> Bool:
	match annotation:
		ParsedTailRecursiveAnnotation:
			True
		_:
			False


private pure func annotation_is_no_copy(annotation: ParsedFunctionAnnotation) -> Bool:
	match annotation:
		ParsedNoCopyAnnotation:
			True
		_:
			False


private pure func annotation_has_ordinary_resource_result(
	annotation: ParsedFunctionAnnotation,
) -> Bool:
	match annotation:
		ParsedResourceResultOrdinaryAnnotation:
			True
		_:
			False


private pure func function_resource_result_ordinary(
	annotations: List[ParsedFunctionAnnotation],
) -> Bool:
	annotations.any(annotation_has_ordinary_resource_result)


private pure func function_builtin_resource_result_policy(
	body: Option[ParsedExpr],
) -> ResourceResultPolicy:
	match parsed_function_body_kind(body):
		ParsedFunctionBuiltinBody(Some(builtin_name)):
			builtin_resource_result_policy(builtin_name)
		_:
			ResourceResultDependent


private pure func type_contains_scoped_dependency_carrier(typ: SemanticType) -> Bool:
	match typ:
		SemanticNamedType(name, args):
			(
				is_one_shot_stream_type_name(name)
				or is_resource_source_type_name(name)
				or args.any(type_contains_scoped_dependency_carrier)
			)
		SemanticFunctionType(_, params, return_type):
			(
				params.any(type_contains_scoped_dependency_carrier)
				or type_contains_scoped_dependency_carrier(return_type)
			)
		SemanticArrayType(element, dims):
			(
				type_contains_scoped_dependency_carrier(element)
				or dims.any(type_contains_scoped_dependency_carrier)
			)
		SemanticTupleType(elements):
			elements.any(type_contains_scoped_dependency_carrier)
		SemanticRangeType(inner):
			type_contains_scoped_dependency_carrier(inner)
		SemanticDimOpType(_, left, right):
			(
				type_contains_scoped_dependency_carrier(left)
				or type_contains_scoped_dependency_carrier(right)
			)
		_:
			False


private pure func function_resource_arg_policy(
	state: CompilerTypecheckState,
	param_types: List[SemanticType],
	annotations: List[ParsedFunctionAnnotation],
	body: Option[ParsedExpr],
) -> ResourceArgPolicy:
	if not parsed_function_body_is_builtin(body):
		RejectResourceArgs
	else:
		var has_resource_param: Bool = False
		var has_scoped_dependency_param: Bool = False

		for param_type in param_types:
			if resource_type_scan_contains(
				resource_type_scan_context(state.env, state.known_resource_type_names),
				param_type,
			):
				has_resource_param = True

			if type_contains_scoped_dependency_carrier(param_type):
				has_scoped_dependency_param = True

			if has_resource_param and has_scoped_dependency_param:
				break

		if has_resource_param or has_scoped_dependency_param:
			result_policy: ResourceResultPolicy = if function_resource_result_ordinary(annotations):
				ResourceResultOrdinary
			else:
				function_builtin_resource_result_policy(body)

			AllowResourceArgs(result_policy)
		else:
			RejectResourceArgs


private pure func validate_resource_result_annotation(
	state: CompilerTypecheckState,
	name: String,
	param_types: List[SemanticType],
	return_type: SemanticType,
	annotations: List[ParsedFunctionAnnotation],
	body: Option[ParsedExpr],
) -> CompilerTypecheckState:
	if not function_resource_result_ordinary(annotations):
		state
	else if not parsed_function_body_is_builtin(body):
		compiler_typecheck_state_add_error(
			state,
			(
				"@resource_result_ordinary can only be used on builtin resource operation "
				+ "declarations"
			),
		)
	else if resource_type_scan_contains(
		resource_type_scan_context(state.env, state.known_resource_type_names),
		return_type,
	):
		compiler_typecheck_state_add_error(
			state,
			"@resource_result_ordinary cannot be used on builtin '" + name + "' because its return type contains a resource",
		)
	else:
		var has_resource_param: Bool = False
		var has_scoped_dependency_param: Bool = False

		for param_type in param_types:
			if resource_type_scan_contains(
				resource_type_scan_context(state.env, state.known_resource_type_names),
				param_type,
			):
				has_resource_param = True

			if type_contains_scoped_dependency_carrier(param_type):
				has_scoped_dependency_param = True

			if has_resource_param or has_scoped_dependency_param:
				break

		if not (has_resource_param or has_scoped_dependency_param):
			compiler_typecheck_state_add_error(
				state,
				"@resource_result_ordinary requires builtin '" + name + "' to have a direct resource or scoped dependency parameter",
			)
		else:
			state


private pure func validate_resource_signature_boundary(
	state: CompilerTypecheckState,
	name: String,
	params: List[ParsedParam],
	param_types: List[SemanticType],
	return_type: SemanticType,
	body: Option[ParsedExpr],
) -> CompilerTypecheckState:
	if params.length() != param_types.length():
		compiler_typecheck_state_add_error(
			state,
			(
				"internal typecheck error: semantic parameter count does not match parsed "
				+ "parameter count for function '"
			) + name + "'",
		)
	else if parsed_function_body_is_builtin(body):
		state
	else:
		var next = state
		var param_index: Int = 0

		for param_type in param_types:
			if resource_type_scan_contains(
				resource_type_scan_context(next.env, next.known_resource_type_names),
				param_type,
			):
				param_name: String = match params.get(param_index):
					Some(param):
						param_name_from_parsed(param).get_or("_")
					None:
						"_"

				next = compiler_typecheck_state_add_error(
					next,
					"Function '" + name + "' parameter '" + param_name + "' cannot contain a resource type",
				)

			param_index += 1

		if resource_type_scan_contains(
			resource_type_scan_context(next.env, next.known_resource_type_names),
			return_type,
		):
			compiler_typecheck_state_add_error(
				next,
				"Function '" + name + "' return type cannot contain a resource type",
			)
		else:
			next


private pure func callable_key_from_span(
	state: CompilerTypecheckState,
	name: String,
	span: CompilerSourceSpan,
) -> CompilerFuncCallableKey:
	compiler_func_callable_key(compiler_typecheck_state_module_identity(state), name, span)


private pure func trait_method_from_parsed(
	method: ParsedTraitMethodDecl,
	type_params: List[String],
) -> TraitMethodSig:
	name: String = method.name.text
	var params: List[SemanticType] = []

	for param in method.params:
		match param_annotation_type(param):
			Some(typ):
				params = params.append(type_instantiate_type_params(type_params, typ))
			None:
				void

	return_type: SemanticType = type_instantiate_type_params(
		type_params,
		type_from_optional_parsed_type_expr(method.return_type),
	)
	is_pure: Bool = method.is_pure
	has_default: Bool = method.body.is_some()
	param_names: List[Option[String]] = param_names_from_parsed(method.params)

	trait_method_sig_with_details(name, params, return_type, is_pure, has_default, param_names)


private pure func trait_methods_from_parsed(
	methods: List[ParsedTraitMethodDecl],
	type_params: List[String],
) -> List[TraitMethodSig]:
	methods.map(func(method): trait_method_from_parsed(method, type_params))


pure func typecheck_prescan_decl(
	state: CompilerTypecheckState,
	decl: ParsedDecl,
) -> CompilerTypecheckState:
	match decl:
		RecordParsedDecl(record_decl):
			compiler_typecheck_state_remember_top_level_name(
				compiler_typecheck_state_add_known_type_name(state, record_decl.name.text),
				record_decl.name.text,
				CompilerTopLevelType,
			)
		UnionParsedDecl(union_decl):
			var next = compiler_typecheck_state_remember_top_level_name(
				compiler_typecheck_state_add_known_type_name(state, union_decl.name.text),
				union_decl.name.text,
				CompilerTopLevelType,
			)

			for variant in union_decl.variants:
				next = compiler_typecheck_state_remember_top_level_name(
					next,
					variant.name.text,
					CompilerTopLevelConstructor,
				)

			next
		BuiltinTypeParsedDecl(type_decl):
			with_type = if type_decl.is_resource:
				compiler_typecheck_state_add_known_resource_type_name(state, type_decl.name.text)
			else:
				compiler_typecheck_state_add_known_type_name(state, type_decl.name.text)

			compiler_typecheck_state_remember_top_level_name(
				with_type,
				type_decl.name.text,
				CompilerTopLevelType,
			)
		TypeAliasParsedDecl(alias_decl):
			compiler_typecheck_state_remember_top_level_name(
				compiler_typecheck_state_add_known_type_name(state, alias_decl.name.text),
				alias_decl.name.text,
				CompilerTopLevelType,
			)
		FunctionParsedDecl(function_decl):
			compiler_typecheck_state_remember_top_level_name(
				state,
				function_decl.name.text,
				CompilerTopLevelFunction,
			)
		VarParsedDecl(var_decl):
			compiler_typecheck_state_remember_top_level_name(
				state,
				var_decl.name.text,
				CompilerTopLevelVariable,
			)
		TraitParsedDecl(trait_decl):
			compiler_typecheck_state_remember_top_level_name(
				state,
				trait_decl.name.text,
				CompilerTopLevelTrait,
			)
		ForeignBlockParsedDecl(_, functions, _):
			var next = state

			for function_decl in functions:
				next = compiler_typecheck_state_remember_top_level_name(
					next,
					function_decl.name.text,
					CompilerTopLevelFunction,
				)

			next
		PrivateParsedDecl(inner, _):
			typecheck_prescan_decl(state, inner)
		ImportBlockParsedDecl(_, _):
			state
		ImplParsedDecl(_):
			state
		ParsedErrorDecl(_):
			state


pure func typecheck_prescan_decls(
	state: CompilerTypecheckState,
	decls: List[ParsedDecl],
) -> CompilerTypecheckState:
	var next = state

	for decl in decls:
		next = typecheck_prescan_decl(next, decl)

	next


pure func typecheck_prescan_program(
	state: CompilerTypecheckState,
	program: ParsedProgram,
) -> CompilerTypecheckState:
	typecheck_prescan_decls(
		compiler_typecheck_state_scope_to_program(state, program),
		program.decls,
	)


pure func typecheck_register_program_import_decls(
	state: CompilerTypecheckState,
	program: ParsedProgram,
) -> CompilerTypecheckState:
	compiler_register_program_import_syntax(
		compiler_typecheck_state_scope_to_program(state, program),
		program,
	)


private union ConstructorIdPlan:
	ConstructorIdsReady(CompilerTypecheckState, List[Option[Int]])
	ConstructorIdsMissing(CompilerTypecheckState)


private pure func reserved_constructor_ids(
	state: CompilerTypecheckState,
	union_decl: ParsedUnionDecl,
) -> ConstructorIdPlan:
	var ids: List[Option[Int]] = []
	var next = state
	var missing: Bool = False

	for variant in union_decl.variants:
		definition_key = compiler_source_definition_key(
			compiler_typecheck_state_module_identity(next),
			CompilerConstructorDefinition,
			variant.name.text,
			Some(union_decl.name.text),
			variant.span,
		)

		match compiler_typecheck_state_claim_source_definition_id(next, definition_key):
			CompilerDefinitionIdClaimed(with_id, def_id):
				next = with_id
				ids = ids.append(Some(def_id))
			CompilerDefinitionIdMissing(with_error):
				next = with_error
				ids = ids.append(None)
				missing = True

	if missing:
		ConstructorIdsMissing(next)
	else:
		ConstructorIdsReady(next, ids)


private pure func register_union_decl(
	state: CompilerTypecheckState,
	module_path: String,
	union_decl: ParsedUnionDecl,
) -> CompilerTypecheckState:
	var next = if union_decl.is_enum and union_decl.type_params.length() > 0:
		compiler_typecheck_state_add_error(
			state,
			"Enum '" + union_decl.name.text + "' cannot have type parameters",
		)
	else:
		state

	if union_decl.is_enum:
		for variant in union_decl.variants:
			if variant.fields.length() > 0:
				next = compiler_typecheck_state_add_error(
					next,
					"Enum variant '" + variant.name.text + "' cannot have fields; use 'union' instead",
				)

	type_params = compiler_type_param_names(union_decl.type_params)
	variants: List[VariantDef] = variants_from_parsed(
		next,
		union_decl.variants,
	).map(
		func(
			variant,
		): { variant |
			fields = variant.fields.map(
				func(field): type_instantiate_type_params(type_params, field),
			)
		},
	)

	type_kind: TypeKind = if union_decl.is_enum:
		TypeEnum
	else:
		TypeUnion

	contains_resource: Bool = variants_contain_resource(
		resource_type_scan_context(next.env, next.known_resource_type_names),
		variants,
	)

	match reserved_constructor_ids(next, union_decl):
		ConstructorIdsMissing(with_errors):
			with_errors
		ConstructorIdsReady(with_ids, constructor_ids):
			env: Env = env_add_type_with_constructor_ids(
				with_ids.env,
				union_decl.name.text,
				compiler_type_param_names(union_decl.type_params),
				variants,
				type_kind,
				contains_resource,
				True,
				constructor_ids,
			)
			with_env = typecheck_state_with_env(with_ids, env)
			compiler_typecheck_state_record_type_home(
				with_env,
				union_decl.name.text,
				module_path,
				False,
			)


private pure func register_builtin_type_decl(
	state: CompilerTypecheckState,
	module_path: String,
	type_decl: ParsedBuiltinTypeDecl,
) -> CompilerTypecheckState:
	var next = if compiler_typecheck_state_allows_builtin(state):
		state
	else:
		prefix: String = if type_decl.is_resource:
			"resource type "
		else:
			"type "

		compiler_typecheck_state_add_error(
			state,
			"'" + prefix + type_decl.name.text + " = builtin' can only be used in the standard library",
		)

	next = if type_decl.is_resource:
		compiler_typecheck_state_add_known_resource_type_name(next, type_decl.name.text)
	else:
		compiler_typecheck_state_add_known_type_name(next, type_decl.name.text)

	type_kind: TypeKind = if type_decl.is_resource:
		TypeResource
	else:
		TypeBuiltin

	env: Env = env_add_type(
		next.env,
		type_decl.name.text,
		compiler_type_param_names(type_decl.type_params),
		[],
		type_kind,
		type_decl.is_resource,
		False,
	)
	with_env = typecheck_state_with_env(next, env)

	with_cleanup = match type_decl.cleanup:
		Some(cleanup):
			{ with_env |
				context = register_resource_cleanup(
					with_env.context,
					type_decl.name.text,
					cleanup.builtin_name,
				)
			}
		None:
			with_env

	compiler_typecheck_state_record_type_home(with_cleanup, type_decl.name.text, module_path, False)


private pure func register_record_decl(
	state: CompilerTypecheckState,
	module_path: String,
	record_decl: ParsedRecordDecl,
) -> CompilerTypecheckState:
	var next = state

	if record_decl.is_struct and record_decl.type_params.length() > 0:
		next = compiler_typecheck_state_add_error(
			next,
			"Struct '" + record_decl.name.text + "' cannot have type parameters",
		)

	if record_decl.is_struct and record_decl.fields.length() == 0:
		next = compiler_typecheck_state_add_error(
			next,
			"Struct '" + record_decl.name.text + "' must have at least one field",
		)

	type_params = compiler_type_param_names(record_decl.type_params)
	var fields: List[FieldDecl] = []

	for field in record_decl.fields:
		semantic_field = field_from_parsed(next, field)
		fields = fields.append(
			{ semantic_field |
				field_type = type_instantiate_type_params(type_params, semantic_field.field_type)
			},
		)

	env: Env = env_add_record(
		next.env,
		record_decl.name.text,
		type_params,
		fields,
		record_decl.is_struct,
		fields_contain_resource(
			resource_type_scan_context(next.env, next.known_resource_type_names),
			fields,
		),
	)
	with_env = typecheck_state_with_env(next, env)
	compiler_typecheck_state_record_type_home(with_env, record_decl.name.text, module_path, False)


private pure func register_type_alias_decl(
	state: CompilerTypecheckState,
	module_path: String,
	alias_decl: ParsedTypeAliasDecl,
) -> CompilerTypecheckState:
	type_params = compiler_type_param_names(alias_decl.type_params)
	target = type_alias_semantic_target(state, alias_decl)

	env: Env = if alias_decl.is_opaque:
		env_add_opaque_alias(
			state.env,
			alias_decl.name.text,
			type_params,
			target,
			Some(module_path),
		)
	else:
		env_add_alias(state.env, alias_decl.name.text, type_params, target)

	with_env = typecheck_state_with_env(
		compiler_typecheck_state_add_known_type_name(state, alias_decl.name.text),
		env,
	)

	if alias_decl.is_opaque:
		compiler_typecheck_state_record_type_home(
			with_env,
			alias_decl.name.text,
			module_path,
			False,
		)
	else:
		with_env


pure func typecheck_register_type_decl(
	state: CompilerTypecheckState,
	module_path: String,
	decl: ParsedDecl,
) -> CompilerTypecheckState:
	match decl:
		RecordParsedDecl(record_decl):
			register_record_decl(state, module_path, record_decl)
		UnionParsedDecl(union_decl):
			register_union_decl(state, module_path, union_decl)
		BuiltinTypeParsedDecl(type_decl):
			register_builtin_type_decl(state, module_path, type_decl)
		TypeAliasParsedDecl(alias_decl):
			register_type_alias_decl(state, module_path, alias_decl)
		PrivateParsedDecl(inner, _):
			typecheck_register_type_decl(state, module_path, inner)
		_:
			state


pure func typecheck_register_type_decls(
	state: CompilerTypecheckState,
	module_path: String,
	decls: List[ParsedDecl],
) -> CompilerTypecheckState:
	var next = state

	for decl in decls:
		next = typecheck_register_type_decl(next, module_path, decl)

	next


pure func typecheck_register_program_type_decls(
	state: CompilerTypecheckState,
	program: ParsedProgram,
) -> CompilerTypecheckState:
	typecheck_register_type_decls(
		compiler_typecheck_state_scope_to_program(state, program),
		program.source.module_name,
		program.decls,
	)


private pure func register_var_decl_with_type(
	state: CompilerTypecheckState,
	module_path: String,
	var_decl: ParsedVarDecl,
	var_type: SemanticType,
	source_type: Option[SemanticType],
) -> CompilerTypecheckState:
	env: Env = env_add_var_with_module_details(
		state.env,
		var_decl.name.text,
		var_type,
		source_type,
		var_mutability(var_decl.is_mutable),
		LetBinding,
		unrefined_binding(),
		Some(module_path),
	)

	typecheck_state_with_env(state, env)


private pure func register_var_decl(
	state: CompilerTypecheckState,
	module_path: String,
	var_decl: ParsedVarDecl,
) -> CompilerTypecheckState:
	source_type: Option[SemanticType] = match var_decl.type_expr:
		Some(type_expr):
			Some(compiler_type_from_parsed_type_expr(type_expr))
		None:
			None

	var_type: SemanticType = canonical_annotation_type(
		state,
		type_from_optional_parsed_type_expr(var_decl.type_expr),
	)

	register_var_decl_with_type(state, module_path, var_decl, var_type, source_type)


private pure func register_imported_var_decl(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	var_decl: ParsedVarDecl,
) -> CompilerTypecheckState:
	source_type: Option[SemanticType] = match var_decl.type_expr:
		Some(type_expr):
			Some(
				imported_annotation_type(
					state,
					import_state,
					module_path,
					local_type_names,
					compiler_type_from_parsed_type_expr(type_expr),
				),
			)
		None:
			None

	var_type: SemanticType = match source_type:
		Some(typ):
			typ
		None:
			type_void()

	register_var_decl_with_type(state, module_path, var_decl, var_type, source_type)


private pure func register_function_signature(
	state: CompilerTypecheckState,
	name: String,
	params: List[ParsedParam],
	return_type: SemanticType,
	type_params: List[ParsedTypeParamDecl],
	dim_constraints: List[ParsedDimConstraint],
	is_pure: Bool,
	annotations: List[ParsedFunctionAnnotation],
	body: Option[ParsedExpr],
	span: CompilerSourceSpan,
	module_path: Option[String],
	origin: FuncOrigin,
) -> CompilerTypecheckState:
	declared_type_param_names = compiler_type_param_names(type_params)
	param_types: List[SemanticType] = param_types_from_parsed(
		params,
	).map(
		func(
			param_type,
		): canonical_function_annotation_type(state, declared_type_param_names, param_type),
	)
	resolved_return_type: SemanticType = canonical_function_annotation_type(
		state,
		declared_type_param_names,
		return_type,
	)
	semantic_dim_constraints: List[(SemanticType, SemanticType)] = canonical_dim_constraints_from_parsed(
		state,
		dim_constraints,
	)

	register_function_signature_with_semantic_types(
		state,
		name,
		params,
		param_types,
		resolved_return_type,
		type_params,
		semantic_dim_constraints,
		is_pure,
		annotations,
		body,
		span,
		module_path,
		origin,
	)


private pure func type_param_candidate_name_is_valid(name: String) -> Bool:
	if name == "#_":
		True
	else:
		base = if name.length() > 1 and name.get_or(0, ' ') == '#':
			name.substring(1, name.length())
		else:
			name

		if base.length() == 0:
			False
		else:
			first = base.get_or(0, ' ')
			var valid = first >= 'A' and first <= 'Z'
			var index: Int = 1

			while valid and index < base.length():
				ch = base.get_or(index, ' ')
				valid = (
					ch >= 'A' and ch <= 'Z'
					or ch >= 'a' and ch <= 'z'
					or ch >= '0' and ch <= '9'
				)

				index += 1

			valid


private pure func type_param_candidates_from_types(types: List[SemanticType]) -> List[String]:
	types.flat_map(type_param_candidates)


private pure func type_param_candidates(typ: SemanticType) -> List[String]:
	match typ:
		SemanticTypeVar(name):
			[name]
		SemanticNamedType(name, args):
			if args.length() == 0 and type_param_candidate_name_is_valid(name):
				[name]
			else:
				type_param_candidates_from_types(args)
		SemanticArrayType(element, dims):
			type_param_candidates(element).concat(type_param_candidates_from_types(dims))
		SemanticFunctionType(_, params, return_type):
			type_param_candidates_from_types(params).concat(type_param_candidates(return_type))
		SemanticTupleType(elements):
			type_param_candidates_from_types(elements)
		SemanticRangeType(inner):
			type_param_candidates(inner)
		SemanticDimOpType(_, left, right):
			type_param_candidates(left).concat(type_param_candidates(right))
		_:
			[]


private pure func state_has_type_name(state: CompilerTypecheckState, name: String) -> Bool:
	(
		is_global_abi_type_name(name)
		or state.known_type_names.contains(name)
		or env_get_type_decl(state.env, name).is_some()
		or env_get_record(state.env, name).is_some()
		or env_get_alias(state.env, name).is_some()
		or env_get_opaque_alias(state.env, name).is_some()
	)


private pure func effective_bound_type_params(
	state: CompilerTypecheckState,
	declared: List[ParsedTypeParamDecl],
	func_type: SemanticType,
) -> List[BoundTypeParam]:
	var result = compiler_bound_type_params_from_parsed(declared)
	var seen = result.map(func(param): param.name)

	for name in type_param_candidates(func_type):
		if (
			name != "#_"
			and not seen.contains(name)
			and not state_has_type_name(state, name)
		):
			seen = seen.append(name)
			result = result.append(make_bound_type_param(name, []))

	result


private pure func effective_function_type_params(
	state: CompilerTypecheckState,
	function_decl: ParsedFunctionDecl,
) -> List[BoundTypeParam]:
	declared_type_param_names = compiler_type_param_names(function_decl.type_params)
	param_types = param_types_from_parsed(
		function_decl.params,
	).map(
		func(
			param_type,
		): canonical_function_annotation_type(state, declared_type_param_names, param_type),
	)
	return_type = canonical_return_type(
		state,
		declared_type_param_names,
		function_decl.return_type,
	).get_or(type_void())
	effective_bound_type_params(
		state,
		function_decl.type_params,
		SemanticFunctionType(function_decl.is_pure, param_types, return_type),
	)


private pure func function_body_signature_from_annotations(
	state: CompilerTypecheckState,
	function_decl: ParsedFunctionDecl,
	callable_id: Option[Int],
) -> FunctionBodySignature:
	effective_type_params = effective_function_type_params(state, function_decl)
	type_param_names = effective_type_params.map(func(param): param.name)
	declared_type_param_names = compiler_type_param_names(function_decl.type_params)
	param_types = param_types_from_parsed(
		function_decl.params,
	).map(
		func(param_type): type_instantiate_type_params(
			type_param_names,
			canonical_function_annotation_type(state, declared_type_param_names, param_type),
		),
	)

	semantic_return_type = match canonical_return_type(
		state,
		declared_type_param_names,
		function_decl.return_type,
	):
		Some(return_type):
			type_instantiate_type_params(type_param_names, return_type)
		None:
			type_void()

	{
		callable_id = callable_id,
		effective_type_params = effective_type_params,
		param_types = param_types,
		semantic_return_type = semantic_return_type
	}


private pure func function_body_signature(
	state: CompilerTypecheckState,
	function_decl: ParsedFunctionDecl,
) -> FunctionBodySignature:
	callable_id = compiler_typecheck_state_find_func_callable_id(
		state,
		callable_key_from_span(state, function_decl.name.text, function_decl.span),
	)

	match callable_id:
		Some(def_id):
			match env_find_func_named_by_def_id(state.env, function_decl.name.text, def_id):
				Some(symbol):
					match symbol.func_type:
						SemanticFunctionType(_, param_types, return_type):
							{
								callable_id = callable_id,
								effective_type_params = symbol.type_params,
								param_types = param_types,
								semantic_return_type = return_type
							}
						_:
							function_body_signature_from_annotations(
								state,
								function_decl,
								callable_id,
							)
				None:
					function_body_signature_from_annotations(state, function_decl, callable_id)
		None:
			function_body_signature_from_annotations(state, function_decl, None)


private pure func function_declared_return_type(
	function_decl: ParsedFunctionDecl,
	signature: FunctionBodySignature,
) -> Option[SemanticType]:
	if function_decl.return_type.is_some():
		Some(signature.semantic_return_type)
	else:
		None


private pure func loop_producer_from_expr(expr: ParsedExpr) -> Option[LoopProducer]:
	match expr:
		ParsedBuiltinExpr(Some("std/tensor.indices"), _):
			Some(LoopProducerIndices)
		ParsedBuiltinExpr(Some("std/tensor.enumerate"), _):
			Some(LoopProducerEnumerate)
		ParsedBuiltinExpr(Some("std/tensor.enumerate2"), _):
			Some(LoopProducerEnumerate2)
		ParsedBuiltinExpr(Some("std/tensor.windows"), _):
			Some(LoopProducerWindows)
		ParsedBlockExpr(items, _):
			if items.length() == 1:
				match items.get(0):
					Some(item):
						loop_producer_from_expr(item)
					None:
						None
			else:
				None
		_:
			None


private pure func loop_producer_from_body(body: Option[ParsedExpr]) -> Option[LoopProducer]:
	match body:
		Some(expr):
			loop_producer_from_expr(expr)
		None:
			None


private pure func register_function_signature_with_semantic_types(
	state: CompilerTypecheckState,
	name: String,
	params: List[ParsedParam],
	param_types: List[SemanticType],
	resolved_return_type: SemanticType,
	type_params: List[ParsedTypeParamDecl],
	dim_constraints: List[(SemanticType, SemanticType)],
	is_pure: Bool,
	annotations: List[ParsedFunctionAnnotation],
	body: Option[ParsedExpr],
	span: CompilerSourceSpan,
	module_path: Option[String],
	origin: FuncOrigin,
) -> CompilerTypecheckState:
	source_func_type: SemanticType = SemanticFunctionType(
		is_pure,
		param_types,
		resolved_return_type,
	)
	effective_type_params = effective_bound_type_params(state, type_params, source_func_type)
	type_param_names = effective_type_params.map(func(param): param.name)
	semantic_param_types = param_types.map(
		func(param): type_instantiate_type_params(type_param_names, param),
	)
	semantic_return_type = type_instantiate_type_params(type_param_names, resolved_return_type)
	func_type: SemanticType = SemanticFunctionType(
		is_pure,
		semantic_param_types,
		semantic_return_type,
	)
	semantic_dim_constraints = dim_constraints.map(
		func(
			constraint,
		): (
			type_instantiate_type_params(type_param_names, constraint[0]),
			type_instantiate_type_params(type_param_names, constraint[1]),
		),
	)
	with_resource_result = validate_resource_result_annotation(
		state,
		name,
		semantic_param_types,
		semantic_return_type,
		annotations,
		body,
	)
	with_resource_boundary = validate_resource_signature_boundary(
		with_resource_result,
		name,
		params,
		semantic_param_types,
		semantic_return_type,
		body,
	)
	resource_arg_policy = function_resource_arg_policy(
		with_resource_boundary,
		semantic_param_types,
		annotations,
		body,
	)
	loop_producer = loop_producer_from_body(body)

	callable_key = callable_key_from_span(with_resource_boundary, name, span)

	match compiler_typecheck_state_claim_func_callable_id(with_resource_boundary, callable_key):
		CompilerDefinitionIdClaimed(with_id, def_id):
			register_function_with_id(
				with_id,
				def_id,
				name,
				func_type,
				effective_type_params,
				params,
				is_pure,
				origin,
				resource_arg_policy,
				module_path,
				semantic_dim_constraints,
				loop_producer,
				annotations,
			)
		CompilerDefinitionIdMissing(with_error):
			with_error


private pure func register_function_with_id(
	state: CompilerTypecheckState,
	def_id: Int,
	name: String,
	func_type: SemanticType,
	effective_type_params: List[BoundTypeParam],
	params: List[ParsedParam],
	is_pure: Bool,
	origin: FuncOrigin,
	resource_arg_policy: ResourceArgPolicy,
	module_path: Option[String],
	dim_constraints: List[(SemanticType, SemanticType)],
	loop_producer: Option[LoopProducer],
	annotations: List[ParsedFunctionAnnotation],
) -> CompilerTypecheckState:
	env: Env = env_add_func_with_info(
		state.env,
		name,
		func_symbol(
			def_id,
			func_type,
			effective_type_params,
			param_names_from_parsed(params),
			purity_from_parsed(is_pure),
			origin,
			resource_arg_policy,
			module_path,
			dim_constraints,
			loop_producer,
			function_debug_only(annotations),
		),
	)
	with_env = typecheck_state_with_env(state, env)
	with_env


private pure func register_function_decl(
	state: CompilerTypecheckState,
	function_decl: ParsedFunctionDecl,
) -> CompilerTypecheckState:
	register_function_signature(
		state,
		function_decl.name.text,
		function_decl.params,
		type_from_optional_parsed_type_expr(function_decl.return_type),
		function_decl.type_params,
		function_decl.dim_constraints,
		function_decl.is_pure,
		function_decl.annotations,
		function_decl.body,
		function_decl.span,
		None,
		UserDefinedFunc,
	)


private pure func register_foreign_function_decl(
	state: CompilerTypecheckState,
	function_decl: ParsedForeignFunctionDecl,
) -> CompilerTypecheckState:
	next = if compiler_typecheck_state_allows_foreign(state):
		state
	else:
		message: String = if compiler_typecheck_state_is_stdlib(state):
			"'foreign' declarations cannot be used in the standard library"
		else:
			"'foreign' declarations cannot be used in source packages"

		compiler_typecheck_state_add_error(state, message)

	register_function_signature(
		next,
		function_decl.name.text,
		function_decl.params,
		compiler_type_from_parsed_type_expr(function_decl.return_type),
		[],
		[],
		function_decl.is_pure,
		function_decl.annotations,
		None,
		function_decl.span,
		None,
		ForeignFunc,
	)


private pure func imported_param_types_from_parsed(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	declared_type_param_names: List[String],
	params: List[ParsedParam],
) -> List[SemanticType]:
	var result: List[SemanticType] = []

	for param_type in param_types_from_parsed(params):
		result = result.append(
			imported_function_annotation_type(
				state,
				import_state,
				module_path,
				local_type_names,
				declared_type_param_names,
				param_type,
			),
		)

	result


private pure func register_imported_function_decl(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	function_decl: ParsedFunctionDecl,
) -> CompilerTypecheckState:
	declared_type_param_names = compiler_type_param_names(function_decl.type_params)
	param_types: List[SemanticType] = imported_param_types_from_parsed(
		state,
		import_state,
		module_path,
		local_type_names,
		declared_type_param_names,
		function_decl.params,
	)
	resolved_return_type: SemanticType = imported_function_annotation_type(
		state,
		import_state,
		module_path,
		local_type_names,
		declared_type_param_names,
		type_from_optional_parsed_type_expr(function_decl.return_type),
	)
	semantic_dim_constraints: List[(SemanticType, SemanticType)] = imported_dim_constraints_from_parsed(
		state,
		import_state,
		module_path,
		local_type_names,
		function_decl.dim_constraints,
	)

	register_function_signature_with_semantic_types(
		state,
		function_decl.name.text,
		function_decl.params,
		param_types,
		resolved_return_type,
		function_decl.type_params,
		semantic_dim_constraints,
		function_decl.is_pure,
		function_decl.annotations,
		function_decl.body,
		function_decl.span,
		Some(module_path),
		UserDefinedFunc,
	)


private pure func register_imported_foreign_function_decl(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	function_decl: ParsedForeignFunctionDecl,
) -> CompilerTypecheckState:
	next = if compiler_typecheck_state_allows_foreign(state):
		state
	else:
		message: String = if compiler_typecheck_state_is_stdlib(state):
			"'foreign' declarations cannot be used in the standard library"
		else:
			"'foreign' declarations cannot be used in source packages"

		compiler_typecheck_state_add_error(state, message)

	param_types: List[SemanticType] = imported_param_types_from_parsed(
		next,
		import_state,
		module_path,
		local_type_names,
		[],
		function_decl.params,
	)
	resolved_return_type: SemanticType = imported_annotation_type(
		next,
		import_state,
		module_path,
		local_type_names,
		compiler_type_from_parsed_type_expr(function_decl.return_type),
	)

	register_function_signature_with_semantic_types(
		next,
		function_decl.name.text,
		function_decl.params,
		param_types,
		resolved_return_type,
		[],
		[],
		function_decl.is_pure,
		function_decl.annotations,
		None,
		function_decl.span,
		Some(module_path),
		ForeignFunc,
	)


private pure func add_trait_function_checked(
	state: CompilerTypecheckState,
	func_name: String,
	trait_name: String,
) -> CompilerTypecheckState:
	match env_trait_function_collision(state.env, func_name, trait_name):
		Some(existing_trait):
			compiler_typecheck_state_add_error(
				state,
				"method '" + func_name + "' is already registered under trait '" + existing_trait + "'; cannot also register under '" + trait_name + "'",
			)
		None:
			if env_get_function_trait(state.env, func_name) == Some(trait_name):
				state
			else:
				typecheck_state_with_env(
					state,
					env_add_trait_function(state.env, func_name, trait_name),
				)


private pure func validate_trait_method_param_types(
	state: CompilerTypecheckState,
	trait_decl: ParsedTraitDecl,
) -> CompilerTypecheckState:
	var next = state

	for method in trait_decl.methods:
		for param in method.params:
			if param.type_expr.is_none():
				param_name: String = param_name_from_parsed(param).get_or("_")
				next = compiler_typecheck_state_add_error(
					next,
					"trait " + trait_decl.name.text + " method '" + method.name.text + "': parameter '" + param_name + "' must have an explicit type",
				)

	next


private pure func register_trait_decl(
	state: CompilerTypecheckState,
	module_path: String,
	trait_decl: ParsedTraitDecl,
) -> CompilerTypecheckState:
	next = validate_trait_method_param_types(state, trait_decl)

	definition_key = compiler_source_definition_key(
		compiler_typecheck_state_module_identity(next),
		CompilerTraitDefinition,
		trait_decl.name.text,
		None,
		trait_decl.span,
	)

	match compiler_typecheck_state_claim_source_definition_id(next, definition_key):
		CompilerDefinitionIdClaimed(with_id, def_id):
			register_trait_with_id(with_id, module_path, trait_decl, def_id)
		CompilerDefinitionIdMissing(with_error):
			with_error


private pure func register_trait_with_id(
	state: CompilerTypecheckState,
	module_path: String,
	trait_decl: ParsedTraitDecl,
	def_id: Int,
) -> CompilerTypecheckState:
	type_params = compiler_type_param_names(trait_decl.type_params)
	trait_def = trait_def_with_details(
		def_id,
		trait_decl.name.text,
		type_params,
		trait_decl.supertraits.map(func(name): name.text),
		trait_methods_from_parsed(trait_decl.methods, type_params),
		Some(module_path),
	)
	env_with_trait = env_add_trait(state.env, trait_def)
	var with_trait = typecheck_state_with_env(state, env_with_trait)

	for method in trait_decl.methods:
		with_trait = add_trait_function_checked(with_trait, method.name.text, trait_decl.name.text)

	for pair in env_trait_methods_with_declaring_trait(with_trait.env, trait_decl.name.text):
		if pair[1] != trait_decl.name.text:
			with_trait = add_trait_function_checked(with_trait, pair[0], pair[1])

	with_trait


private pure func impl_type_head_name(for_type: SemanticType) -> Option[String]:
	match for_type:
		SemanticNamedType(name, _):
			Some(name)
		_:
			None


private pure func impl_target_label(for_type: SemanticType) -> String:
	impl_type_head_name(for_type).get_or("<non-named type>")


private pure func impl_orphan_error_message(
	state: CompilerTypecheckState,
	module_path: String,
	impl_decl: ParsedImplDecl,
	for_type: SemanticType,
) -> Option[String]:
	trait_home: Option[String] = match env_get_trait(state.env, impl_decl.trait_name.text):
		Some(trait_def):
			trait_def.module_path
		None:
			None

	type_home: Option[String] = match impl_type_head_name(for_type):
		Some(type_name):
			compiler_typecheck_state_find_type_home(state, type_name)
		None:
			None

	match (trait_home, type_home):
		(Some(trait_module), Some(type_module)):
			if (
				trait_module == module_path
				or compiler_typecheck_state_type_home_matches(
					state,
					impl_target_label(for_type),
					module_path,
				)
			):
				None
			else:
				Some(
					"orphan impl: '" + impl_decl.trait_name.text + " for " + impl_target_label(
						for_type,
					) + "' is not in the trait's module '" + trait_module + "' or the type's module '" + type_module + "'",
				)
		_:
			None


private pure func impl_conflict_message(instance: ImplInstance) -> String:
	"conflicting implementation of trait '" + instance.trait_name + "' for type '" + impl_target_label(
		instance.for_type,
	) + "'"


private pure func add_source_impl_checked(
	state: CompilerTypecheckState,
	instance: ImplInstance,
) -> CompilerTypecheckState:
	match env_find_conflicting_impl(state.env, instance):
		Some(_):
			compiler_typecheck_state_add_error(state, impl_conflict_message(instance))
		None:
			typecheck_state_with_env(
				state,
				env_add_impl(state.env, instance),
			)


private pure func add_private_impl_checked(
	state: CompilerTypecheckState,
	instance: ImplInstance,
) -> CompilerTypecheckState:
	match env_find_conflicting_impl(state.env, instance):
		Some(_):
			compiler_typecheck_state_add_error(state, impl_conflict_message(instance))
		None:
			match compiler_typecheck_state_find_private_impl_conflict(state, instance):
				Some(_):
					compiler_typecheck_state_add_error(state, impl_conflict_message(instance))
				None:
					compiler_typecheck_state_add_private_impl(state, instance)


private pure func impl_bound_name_is_candidate(state: CompilerTypecheckState, name: String) -> Bool:
	(
		name != "#_"
		and not name.starts_with("#")
		and not compiler_typecheck_state_has_known_type_name(state, name)
	)


private pure func impl_inline_bounds_from_type_exprs(
	type_exprs: List[ParsedTypeExpr],
) -> List[BoundTypeParam]:
	var result: List[BoundTypeParam] = []

	for type_expr in type_exprs:
		result = result.concat(impl_inline_bounds_from_type_expr(type_expr))

	result


private pure func impl_inline_bounds_from_type_expr(
	type_expr: ParsedTypeExpr,
) -> List[BoundTypeParam]:
	match type_expr:
		ParsedBoundedType(name, bounds, _):
			[make_bound_type_param(
					name.text,
					bounds.map(func(bound): bound.text),
				)]
		ParsedNamedType(_, args, _):
			impl_inline_bounds_from_type_exprs(args)
		ParsedQualifiedNamedType(_, _, args, _):
			impl_inline_bounds_from_type_exprs(args)
		ParsedTupleType(items, _):
			impl_inline_bounds_from_type_exprs(items)
		ParsedArrayType(element, dims, _):
			impl_inline_bounds_from_type_expr(
				element,
			).concat(impl_inline_bounds_from_type_exprs(dims))
		ParsedFunctionType(_, params, return_type, _):
			impl_inline_bounds_from_type_exprs(
				params,
			).concat(impl_inline_bounds_from_type_expr(return_type))
		ParsedRangeType(inner, _):
			impl_inline_bounds_from_type_expr(inner)
		ParsedDimBinaryType(_, left, right, _):
			impl_inline_bounds_from_type_expr(left).concat(impl_inline_bounds_from_type_expr(right))
		ParsedDimLiteralType(_, _):
			[]
		ParsedDimNameType(_, _, _):
			[]
		ParsedMissingType(_):
			[]


private pure func impl_bounds_for_type(
	state: CompilerTypecheckState,
	explicit_bounds: List[BoundTypeParam],
	for_type: SemanticType,
) -> List[BoundTypeParam]:
	var result: List[BoundTypeParam] = explicit_bounds
	var seen: List[String] = explicit_bounds.map(func(bound): bound.name)

	for name in collect_type_vars(for_type):
		if impl_bound_name_is_candidate(state, name) and not seen.contains(name):
			seen = seen.append(name)
			result = result.append(make_bound_type_param(name, []))

	result


private pure func impl_bounds_for_decl_type(
	state: CompilerTypecheckState,
	type_expr: ParsedTypeExpr,
	for_type: SemanticType,
) -> List[BoundTypeParam]:
	impl_bounds_for_type(state, impl_inline_bounds_from_type_expr(type_expr), for_type)


private pure func impl_parameterize_receiver_type(
	type_param_names: List[String],
	typ: SemanticType,
) -> SemanticType:
	match typ:
		SemanticNamedType(name, args):
			if args.length() == 0 and type_param_names.contains(name):
				SemanticTypeVar(name)
			else:
				SemanticNamedType(
					name,
					args.map(func(arg):
						impl_parameterize_receiver_type(type_param_names, arg)
					),
				)
		SemanticArrayType(element, dims):
			SemanticArrayType(
				impl_parameterize_receiver_type(
					type_param_names,
					element,
				),
				dims.map(func(dim):
					impl_parameterize_receiver_type(type_param_names, dim)
				),
			)
		SemanticFunctionType(is_pure, params, return_type):
			SemanticFunctionType(
				is_pure,
				params.map(func(param):
					impl_parameterize_receiver_type(type_param_names, param)
				),
				impl_parameterize_receiver_type(
					type_param_names,
					return_type,
				),
			)
		SemanticTupleType(items):
			SemanticTupleType(
				items.map(func(item):
					impl_parameterize_receiver_type(type_param_names, item)
				),
			)
		SemanticRangeType(inner):
			SemanticRangeType(impl_parameterize_receiver_type(type_param_names, inner))
		SemanticDimOpType(op, left, right):
			SemanticDimOpType(
				op,
				impl_parameterize_receiver_type(type_param_names, left),
				impl_parameterize_receiver_type(type_param_names, right),
			)
		SemanticTypeVar(name):
			SemanticTypeVar(name)
		SemanticConstIntType(value):
			SemanticConstIntType(value)
		SemanticSelfType:
			SemanticSelfType
		SemanticVarDimsType(name):
			SemanticVarDimsType(name)
		SemanticMetaType(id):
			SemanticMetaType(id)


private pure func impl_normalize_receiver_type(
	state: CompilerTypecheckState,
	type_expr: ParsedTypeExpr,
	for_type: SemanticType,
) -> SemanticType:
	type_param_names = impl_bounds_for_decl_type(
		state,
		type_expr,
		for_type,
	).map(
		func(bound): bound.name,
	)
	impl_parameterize_receiver_type(type_param_names, for_type)


private union ImplMethodInfoClaim:
	ImplMethodInfoClaimed(CompilerTypecheckState, ImplMethodInfo)
	ImplMethodInfoMissing(CompilerTypecheckState)


private union ImplMethodInfosClaim:
	ImplMethodInfosClaimed(CompilerTypecheckState, List[ImplMethodInfo])
	ImplMethodInfosMissing(CompilerTypecheckState)


private pure func impl_method_info_from_decl(
	state: CompilerTypecheckState,
	module_path: String,
	method: ParsedFunctionDecl,
) -> ImplMethodInfoClaim:
	declared_type_param_names = compiler_type_param_names(method.type_params)
	param_types: List[SemanticType] = param_types_from_parsed(
		method.params,
	).map(
		func(
			param_type,
		): canonical_function_annotation_type(state, declared_type_param_names, param_type),
	)
	return_type: SemanticType = canonical_function_annotation_type(
		state,
		declared_type_param_names,
		type_from_optional_parsed_type_expr(method.return_type),
	)
	impl_method_info_from_semantic_types(state, module_path, method, param_types, return_type)


private pure func impl_method_info_from_semantic_types(
	state: CompilerTypecheckState,
	module_path: String,
	method: ParsedFunctionDecl,
	param_types: List[SemanticType],
	return_type: SemanticType,
) -> ImplMethodInfoClaim:
	func_type: SemanticType = SemanticFunctionType(method.is_pure, param_types, return_type)
	callable_key = callable_key_from_span(state, method.name.text, method.span)

	match compiler_typecheck_state_claim_func_callable_id(state, callable_key):
		CompilerDefinitionIdMissing(with_error):
			ImplMethodInfoMissing(with_error)
		CompilerDefinitionIdClaimed(with_id, callable_id):
			info = impl_method_info(
				method.name.text,
				Some({
					callable_id = callable_id,
					module_path = module_path,
				}),
				func_type,
				effective_bound_type_params(with_id, method.type_params, func_type),
				param_names_from_parsed(method.params),
				purity_from_parsed(method.is_pure),
				function_resource_arg_policy(with_id, param_types, method.annotations, method.body),
				dim_constraints_from_parsed(method.dim_constraints),
				function_debug_only(method.annotations),
			)
			ImplMethodInfoClaimed(with_id, info)


private pure func impl_method_infos_from_decl(
	state: CompilerTypecheckState,
	module_path: String,
	methods: List[ParsedFunctionDecl],
) -> ImplMethodInfosClaim:
	var result: ImplMethodInfosClaim = ImplMethodInfosClaimed(state, [])

	for method in methods:
		match result:
			ImplMethodInfosMissing(_):
				void
			ImplMethodInfosClaimed(next, infos):
				result = match impl_method_info_from_decl(next, module_path, method):
					ImplMethodInfoMissing(with_error):
						ImplMethodInfosMissing(with_error)
					ImplMethodInfoClaimed(with_method, info):
						ImplMethodInfosClaimed(
							with_method,
							infos.append(info),
						)

	result


private pure func imported_impl_method_info_from_decl(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	method: ParsedFunctionDecl,
) -> ImplMethodInfoClaim:
	declared_type_param_names = compiler_type_param_names(method.type_params)
	param_types: List[SemanticType] = imported_param_types_from_parsed(
		state,
		import_state,
		module_path,
		local_type_names,
		declared_type_param_names,
		method.params,
	)
	return_type: SemanticType = imported_function_annotation_type(
		state,
		import_state,
		module_path,
		local_type_names,
		declared_type_param_names,
		type_from_optional_parsed_type_expr(method.return_type),
	)
	impl_method_info_from_semantic_types(state, module_path, method, param_types, return_type)


private pure func imported_impl_method_infos_from_decl(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	methods: List[ParsedFunctionDecl],
) -> ImplMethodInfosClaim:
	var result: ImplMethodInfosClaim = ImplMethodInfosClaimed(state, [])

	for method in methods:
		match result:
			ImplMethodInfosMissing(_):
				void
			ImplMethodInfosClaimed(next, infos):
				result = match imported_impl_method_info_from_decl(
					next,
					import_state,
					module_path,
					local_type_names,
					method,
				):
					ImplMethodInfoMissing(with_error):
						ImplMethodInfosMissing(with_error)
					ImplMethodInfoClaimed(with_method, info):
						ImplMethodInfosClaimed(
							with_method,
							infos.append(info),
						)

	result


private pure func register_impl_decl_with_info(
	state: CompilerTypecheckState,
	module_path: String,
	impl_decl: ParsedImplDecl,
	for_type: SemanticType,
	method_infos: List[ImplMethodInfo],
	is_private: Bool,
) -> CompilerTypecheckState:
	var next = match impl_orphan_error_message(state, module_path, impl_decl, for_type):
		Some(message):
			compiler_typecheck_state_add_error(state, message)
		None:
			state

	definition_key = compiler_source_definition_key(
		compiler_typecheck_state_module_identity(next),
		CompilerImplDefinition,
		impl_decl.trait_name.text,
		None,
		impl_decl.span,
	)

	match compiler_typecheck_state_claim_source_definition_id(next, definition_key):
		CompilerDefinitionIdClaimed(with_id, def_id):
			register_impl_with_id(with_id, impl_decl, for_type, method_infos, is_private, def_id)
		CompilerDefinitionIdMissing(with_error):
			with_error


private pure func register_impl_with_id(
	state: CompilerTypecheckState,
	impl_decl: ParsedImplDecl,
	for_type: SemanticType,
	method_infos: List[ImplMethodInfo],
	is_private: Bool,
	def_id: Int,
) -> CompilerTypecheckState:
	instance = impl_instance_with_methods(
		def_id,
		impl_decl.trait_name.text,
		for_type,
		impl_bounds_for_decl_type(state, impl_decl.for_type, for_type),
		method_infos,
		False,
	)

	if is_private:
		add_private_impl_checked(state, instance)
	else:
		add_source_impl_checked(state, instance)


private pure func register_impl_decl(
	state: CompilerTypecheckState,
	module_path: String,
	impl_decl: ParsedImplDecl,
	is_private: Bool,
) -> CompilerTypecheckState:
	raw_for_type: SemanticType = canonical_annotation_type(
		state,
		compiler_type_from_parsed_type_expr(impl_decl.for_type),
	)
	for_type: SemanticType = impl_normalize_receiver_type(state, impl_decl.for_type, raw_for_type)

	match impl_method_infos_from_decl(state, module_path, impl_decl.methods):
		ImplMethodInfosMissing(with_error):
			with_error
		ImplMethodInfosClaimed(with_methods, method_infos):
			register_impl_decl_with_info(
				with_methods,
				module_path,
				impl_decl,
				for_type,
				method_infos,
				is_private,
			)


private pure func register_imported_impl_decl(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	impl_decl: ParsedImplDecl,
) -> CompilerTypecheckState:
	raw_for_type: SemanticType = imported_annotation_type(
		state,
		import_state,
		module_path,
		local_type_names,
		compiler_type_from_parsed_type_expr(impl_decl.for_type),
	)
	for_type: SemanticType = impl_normalize_receiver_type(state, impl_decl.for_type, raw_for_type)

	match imported_impl_method_infos_from_decl(
		state,
		import_state,
		module_path,
		local_type_names,
		impl_decl.methods,
	):
		ImplMethodInfosMissing(with_error):
			with_error
		ImplMethodInfosClaimed(with_methods, method_infos):
			register_impl_decl_with_info(
				with_methods,
				module_path,
				impl_decl,
				for_type,
				method_infos,
				False,
			)


pure func typecheck_register_signature_decl(
	state: CompilerTypecheckState,
	module_path: String,
	decl: ParsedDecl,
) -> CompilerTypecheckState:
	match decl:
		FunctionParsedDecl(function_decl):
			register_function_decl(state, function_decl)
		VarParsedDecl(var_decl):
			register_var_decl(state, module_path, var_decl)
		ForeignBlockParsedDecl(_, functions, _):
			var next = state

			for function_decl in functions:
				next = register_foreign_function_decl(next, function_decl)

			next
		TraitParsedDecl(trait_decl):
			register_trait_decl(state, module_path, trait_decl)
		PrivateParsedDecl(inner, _):
			typecheck_register_signature_decl(state, module_path, inner)
		_:
			state


pure func typecheck_register_signature_decls(
	state: CompilerTypecheckState,
	module_path: String,
	decls: List[ParsedDecl],
) -> CompilerTypecheckState:
	var next = state

	for decl in decls:
		next = typecheck_register_signature_decl(next, module_path, decl)

	next


pure func typecheck_register_program_signature_decls(
	state: CompilerTypecheckState,
	program: ParsedProgram,
) -> CompilerTypecheckState:
	typecheck_register_signature_decls(
		compiler_typecheck_state_scope_to_program(state, program),
		program.source.module_name,
		program.decls,
	)


pure func typecheck_register_impl_decl(
	state: CompilerTypecheckState,
	module_path: String,
	decl: ParsedDecl,
) -> CompilerTypecheckState:
	match decl:
		ImplParsedDecl(impl_decl):
			register_impl_decl(state, module_path, impl_decl, False)
		PrivateParsedDecl(inner, _):
			match inner:
				ImplParsedDecl(impl_decl):
					register_impl_decl(state, module_path, impl_decl, True)
				_:
					state
		_:
			state


pure func typecheck_register_impl_decls(
	state: CompilerTypecheckState,
	module_path: String,
	decls: List[ParsedDecl],
) -> CompilerTypecheckState:
	var next = state

	for decl in decls:
		next = typecheck_register_impl_decl(next, module_path, decl)

	next


pure func typecheck_register_program_impl_decls(
	state: CompilerTypecheckState,
	program: ParsedProgram,
) -> CompilerTypecheckState:
	typecheck_register_impl_decls(
		compiler_typecheck_state_scope_to_program(state, program),
		program.source.module_name,
		program.decls,
	)


private pure func typecheck_register_imported_union_decl(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	union_decl: ParsedUnionDecl,
) -> CompilerTypecheckState:
	canonical_name: String = canonical_module_type_name(module_path, union_decl.name.text)
	type_params = compiler_type_param_names(union_decl.type_params)
	variants: List[VariantDef] = imported_variants_from_parsed(
		state,
		import_state,
		module_path,
		local_type_names,
		type_params,
		union_decl.variants,
	)

	type_kind: TypeKind = if union_decl.is_enum:
		TypeEnum
	else:
		TypeUnion

	contains_resource: Bool = variants_contain_resource(
		resource_type_scan_context(state.env, state.known_resource_type_names),
		variants,
	)

	match reserved_constructor_ids(state, union_decl):
		ConstructorIdsMissing(with_errors):
			with_errors
		ConstructorIdsReady(with_ids, constructor_ids):
			env: Env = env_add_type_with_constructor_ids(
				with_ids.env,
				canonical_name,
				type_params,
				variants,
				type_kind,
				contains_resource,
				True,
				constructor_ids,
			)
			with_env = typecheck_state_with_env(with_ids, env)
			with_home = compiler_typecheck_state_record_type_home(
				with_env,
				canonical_name,
				module_path,
				True,
			)
			add_imported_type_aliases(
				with_home,
				module_path,
				union_decl.name.text,
				canonical_name,
				type_params,
			)


private pure func typecheck_register_imported_record_decl(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	record_decl: ParsedRecordDecl,
) -> CompilerTypecheckState:
	canonical_name: String = canonical_module_type_name(module_path, record_decl.name.text)
	type_params = compiler_type_param_names(record_decl.type_params)
	fields: List[FieldDecl] = record_decl.fields.map(
		func(
			field,
		): imported_field_from_parsed(
			state,
			import_state,
			module_path,
			local_type_names,
			type_params,
			field,
		),
	)
	env: Env = env_add_record(
		state.env,
		canonical_name,
		type_params,
		fields,
		record_decl.is_struct,
		fields_contain_resource(
			resource_type_scan_context(state.env, state.known_resource_type_names),
			fields,
		),
	)
	with_env = typecheck_state_with_env(state, env)
	with_home = compiler_typecheck_state_record_type_home(
		with_env,
		canonical_name,
		module_path,
		True,
	)
	add_imported_type_aliases(
		with_home,
		module_path,
		record_decl.name.text,
		canonical_name,
		type_params,
	)


private pure func typecheck_register_imported_builtin_type_decl(
	state: CompilerTypecheckState,
	module_path: String,
	type_decl: ParsedBuiltinTypeDecl,
) -> CompilerTypecheckState:
	canonical_name: String = canonical_module_type_name(module_path, type_decl.name.text)

	type_kind: TypeKind = if type_decl.is_resource:
		TypeResource
	else:
		TypeBuiltin

	env: Env = env_add_type(
		state.env,
		canonical_name,
		compiler_type_param_names(type_decl.type_params),
		[],
		type_kind,
		type_decl.is_resource,
		False,
	)

	with_resource = if type_decl.is_resource:
		compiler_typecheck_state_add_known_resource_type_name(state, canonical_name)
	else:
		state

	with_env = typecheck_state_with_env(with_resource, env)

	with_cleanup = match type_decl.cleanup:
		Some(cleanup):
			{ with_env |
				context = register_resource_cleanup(
					with_env.context,
					canonical_name,
					cleanup.builtin_name,
				)
			}
		None:
			with_env

	with_home = compiler_typecheck_state_record_type_home(
		with_cleanup,
		canonical_name,
		module_path,
		True,
	)
	add_imported_type_aliases(
		with_home,
		module_path,
		type_decl.name.text,
		canonical_name,
		compiler_type_param_names(type_decl.type_params),
	)


private pure func typecheck_register_imported_type_alias_decl(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	alias_decl: ParsedTypeAliasDecl,
) -> CompilerTypecheckState:
	canonical_name: String = canonical_module_type_name(module_path, alias_decl.name.text)
	type_params = compiler_type_param_names(alias_decl.type_params)
	target: SemanticType = type_instantiate_type_params(
		type_params,
		imported_annotation_type(
			state,
			import_state,
			module_path,
			local_type_names,
			compiler_type_from_parsed_type_expr(alias_decl.target),
		),
	)

	env: Env = if alias_decl.is_opaque:
		env_add_opaque_alias(state.env, canonical_name, type_params, target, Some(module_path))
	else:
		env_add_alias(state.env, canonical_name, type_params, target)

	with_env = typecheck_state_with_env(
		compiler_typecheck_state_add_known_type_name(state, canonical_name),
		env,
	)

	with_home = if alias_decl.is_opaque:
		compiler_typecheck_state_record_type_home(with_env, canonical_name, module_path, True)
	else:
		with_env

	add_imported_type_aliases(
		with_home,
		module_path,
		alias_decl.name.text,
		canonical_name,
		type_params,
	)


private pure func typecheck_register_imported_type_decl(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	decl: CompilerImportableTypeDecl,
) -> CompilerTypecheckState:
	match decl:
		CompilerImportableRecordDecl(record_decl):
			typecheck_register_imported_record_decl(
				state,
				import_state,
				module_path,
				local_type_names,
				record_decl,
			)
		CompilerImportableUnionDecl(union_decl):
			typecheck_register_imported_union_decl(
				state,
				import_state,
				module_path,
				local_type_names,
				union_decl,
			)
		CompilerImportableBuiltinTypeDecl(type_decl):
			typecheck_register_imported_builtin_type_decl(state, module_path, type_decl)
		CompilerImportableTypeAliasDecl(alias_decl):
			typecheck_register_imported_type_alias_decl(
				state,
				import_state,
				module_path,
				local_type_names,
				alias_decl,
			)


private pure func typecheck_register_imported_type_decls(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	decls: List[CompilerImportableTypeDecl],
) -> CompilerTypecheckState:
	var next = state

	for decl in decls:
		next = typecheck_register_imported_type_decl(
			next,
			import_state,
			module_path,
			local_type_names,
			decl,
		)

	next


private pure func typecheck_register_imported_signature_decl(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	decl: CompilerImportableSignatureDecl,
) -> CompilerTypecheckState:
	match decl:
		CompilerImportableFunctionDecl(function_decl):
			register_imported_function_decl(
				state,
				import_state,
				module_path,
				local_type_names,
				function_decl,
			)
		CompilerImportableVarDecl(var_decl):
			register_imported_var_decl(state, import_state, module_path, local_type_names, var_decl)
		CompilerImportableForeignFunctionDecl(function_decl):
			register_imported_foreign_function_decl(
				state,
				import_state,
				module_path,
				local_type_names,
				function_decl,
			)
		CompilerImportableTraitDecl(trait_decl):
			register_trait_decl(state, module_path, trait_decl)


private pure func typecheck_register_imported_signature_decls(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	decls: List[CompilerImportableSignatureDecl],
) -> CompilerTypecheckState:
	var next = state

	for decl in decls:
		next = typecheck_register_imported_signature_decl(
			next,
			import_state,
			module_path,
			local_type_names,
			decl,
		)

	next


private pure func typecheck_register_imported_impl_decls(
	state: CompilerTypecheckState,
	import_state: CompilerTypecheckState,
	module_path: String,
	local_type_names: List[String],
	decls: List[ParsedImplDecl],
) -> CompilerTypecheckState:
	var next = state

	for decl in decls:
		next = register_imported_impl_decl(next, import_state, module_path, local_type_names, decl)

	next


private pure func import_resolution_state_base(
	state: CompilerTypecheckState,
	module: CompilerImportableModule,
) -> CompilerTypecheckState:
	without_module_metadata = { state |
		module_aliases = [],
		imported_modules = [],
		import_bindings = [],
		known_type_names = [],
		known_resource_type_names = [],
		type_homes = []
	}
	without_name_indexes = compiler_typecheck_state_clear_module_name_indexes(
		without_module_metadata,
	)
	compiler_typecheck_state_scope_to_imported_module(
		without_name_indexes,
		compiler_importable_module_prepared_scope(module),
	)


private pure func import_resolution_state_for_module(
	state: CompilerTypecheckState,
	module: CompilerImportableModule,
	import_surfaces: List[CompilerImportableModuleSurface],
) -> CompilerTypecheckState:
	next = typecheck_prescan_decls(
		import_resolution_state_base(state, module),
		compiler_importable_module_decls(module),
	)
	compiler_register_import_decls(
		next,
		import_surfaces,
		compiler_importable_module_declared_imports(module),
	)


private pure func typecheck_register_import_module_types(
	state: CompilerTypecheckState,
	module: CompilerImportableModule,
	import_surfaces: List[CompilerImportableModuleSurface],
) -> CompilerTypecheckState:
	target_scope = state
	module_state = compiler_typecheck_state_scope_to_imported_module(
		state,
		compiler_importable_module_prepared_scope(module),
	)

	if module_state.errors.length() > state.errors.length():
		module_state
	else:
		import_state = import_resolution_state_for_module(module_state, module, import_surfaces)
		with_types = typecheck_register_imported_type_decls(
			module_state,
			import_state,
			compiler_importable_module_path(module),
			compiler_importable_module_local_type_names(module),
			compiler_importable_module_type_decls(module),
		)
		compiler_typecheck_state_restore_definition_scope(with_types, target_scope)


private pure func typecheck_register_direct_import_module_decls(
	state: CompilerTypecheckState,
	module: CompilerImportableModule,
	import_surfaces: List[CompilerImportableModuleSurface],
) -> CompilerTypecheckState:
	target_scope = state
	module_state = compiler_typecheck_state_scope_to_imported_module(
		state,
		compiler_importable_module_prepared_scope(module),
	)

	if module_state.errors.length() > state.errors.length():
		module_state
	else:
		import_state = import_resolution_state_for_module(module_state, module, import_surfaces)
		with_signatures = typecheck_register_imported_signature_decls(
			module_state,
			import_state,
			compiler_importable_module_path(module),
			compiler_importable_module_local_type_names(module),
			compiler_importable_module_signature_decls(module),
		)
		with_impls = typecheck_register_imported_impl_decls(
			with_signatures,
			import_state,
			compiler_importable_module_path(module),
			compiler_importable_module_local_type_names(module),
			compiler_importable_module_impl_decls(module),
		)
		compiler_typecheck_state_restore_definition_scope(with_impls, target_scope)


private pure func typecheck_register_import_modules(
	state: CompilerTypecheckState,
	all_modules: List[CompilerImportableModule],
	direct_modules: List[CompilerImportableModule],
	import_surfaces: List[CompilerImportableModuleSurface],
) -> CompilerTypecheckState:
	var next = state
	var compatible_modules: List[CompilerImportableModule] = []

	for module in all_modules:
		module_scope = compiler_importable_module_prepared_scope(module)

		if compiler_typecheck_state_accepts_imported_module_scope(state, module_scope):
			compatible_modules = compatible_modules.append(module)
		else:
			next = compiler_typecheck_state_scope_to_imported_module(next, module_scope)

	-- Canonical type declarations from the reachable dependency closure are
	-- graph metadata. Registering them does not
	-- introduce a bare source name; aliases are created only for actual import
	-- bindings in `state.imported_names`. This lets a direct dependency expose a
	-- record/union from one of its dependencies without leaking unrelated values.
	for module in compatible_modules:
		next = typecheck_register_import_module_types(next, module, import_surfaces)

	for module in direct_modules:
		if compiler_typecheck_state_accepts_imported_module_scope(
			state,
			compiler_importable_module_prepared_scope(module),
		):
			next = typecheck_register_direct_import_module_decls(next, module, import_surfaces)

	next


private pure func body_check_param_label(param: ParsedParam) -> String:
	match param.binder:
		ParsedParamNameBinder(name):
			name.text
		ParsedParamWildcardBinder(_):
			"_"
		ParsedParamTupleBinder(_, _):
			"tuple parameter"


private pure func body_check_missing_param_type_error(
	state: CompilerTypecheckState,
	function_name: String,
	param: ParsedParam,
) -> CompilerTypecheckState:
	compiler_typecheck_state_add_error(
		state,
		"Function '" + function_name + "' parameter '" + body_check_param_label(
			param,
		) + "' must have an explicit type to check the body",
	)


private pure func add_function_param_binding(
	state: CompilerTypecheckState,
	name: ParsedIdentifier,
	param_type: SemanticType,
) -> CompilerTypecheckState:
	typecheck_state_with_env(
		state,
		env_add_var_with_details(
			state.env,
			name.text,
			param_type,
			Some(param_type),
			ImmutableBinding,
			FuncParam,
			unrefined_binding(),
		),
	)


private pure func add_tuple_function_param_bindings(
	state: CompilerTypecheckState,
	function_name: String,
	names: List[ParsedIdentifier],
	elements: List[SemanticType],
) -> CompilerTypecheckState:
	if names.length() != elements.length():
		compiler_typecheck_state_add_error(
			state,
			"Function '" + function_name + "' tuple parameter has " + names
				.length()
				.to_string() + " names but annotation has " + elements
				.length()
				.to_string() + " elements",
		)
	else:
		var next = state
		var index: Int = 0

		while index < names.length():
			match (names.get(index), elements.get(index)):
				(Some(name), Some(element_type)):
					next = add_function_param_binding(next, name, element_type)
				_:
					void

			index += 1

		next


private pure func prepare_function_param(
	state: CompilerTypecheckState,
	function_name: String,
	param: ParsedParam,
	param_type: SemanticType,
) -> CompilerTypecheckState:
	typed_state = match param.type_expr:
		Some(_):
			state
		None:
			body_check_missing_param_type_error(state, function_name, param)

	match param.binder:
		ParsedParamNameBinder(name):
			add_function_param_binding(typed_state, name, param_type)
		ParsedParamWildcardBinder(_):
			typed_state
		ParsedParamTupleBinder(names, _):
			match param_type:
				SemanticTupleType(elements):
					add_tuple_function_param_bindings(typed_state, function_name, names, elements)
				_:
					compiler_typecheck_state_add_error(
						typed_state,
						"Function '" + function_name + "' tuple parameter requires a tuple annotation",
					)


private pure func prepare_function_body_state(
	state: CompilerTypecheckState,
	function_decl: ParsedFunctionDecl,
	signature: FunctionBodySignature,
) -> CompilerTypecheckState:
	env_with_scope = env_push_scope(state.env)
	env_with_type_params = env_extend_type_param_bounds(
		env_with_scope,
		signature.effective_type_params,
	)
	var next = typecheck_state_with_env(state, env_with_type_params)
	var index: Int = 0

	while index < function_decl.params.length():
		match function_decl.params.get(index):
			Some(param):
				next = prepare_function_param(
					next,
					function_decl.name.text,
					param,
					signature.param_types.get_or(index, type_void()),
				)
			None:
				void

		index += 1

	next


private pure func body_check_context_with_expected_type(
	state: CompilerTypecheckState,
	return_type: Option[SemanticType],
) -> InferContext:
	context = infer_context(state)

	match return_type:
		Some(expected_type):
			infer_with_expected_value_slot(context, expected_type, ExpectedArgumentSlot)
		None:
			infer_without_expected(context)


private pure func function_return_type_mismatch_error(
	state: CompilerTypecheckState,
	function_name: String,
	expected: SemanticType,
	found: SemanticType,
) -> CompilerTypecheckState:
	compiler_typecheck_state_add_error(
		state,
		"Function '" + function_name + "' returns wrong type\n    expected: " + type_to_string(
			expected,
		) + "  (declared return type)\n       found: " + type_to_string(
			found,
		) + "  (body expression)",
	)


private pure func function_missing_return_type_error(
	state: CompilerTypecheckState,
	function_name: String,
	found: SemanticType,
) -> CompilerTypecheckState:
	compiler_typecheck_state_add_error(
		state,
		"Function '" + function_name + "' body has type " + type_to_string(
			found,
		) + " but no return type is declared\n    help: add '-> " + type_to_string(
			found,
		) + "' to the function signature, or use '-> Void' if discarding the result",
	)


-- Registered signatures and finalized expression slots are canonical at this
-- boundary. Keeping the comparison environment-free prevents redundant alias
-- reconstruction and makes that caller invariant explicit.
private pure func check_function_like_body_result(
	function_name: String,
	return_type: Option[SemanticType],
	value_matches_declared_return: Bool,
	result: InferResult,
) -> CompilerTypecheckState:
	found_type = typed_expr_value_type(result.expr)
	found_semantic_type = typed_expr_semantic_type(result.expr)

	match return_type:
		Some(expected_type):
			if (
				value_matches_declared_return
				or types_compatible_with_params(
					env_get_type_params(result.context.state.env),
					expected_type,
					found_semantic_type,
				)
			):
				result.context.state
			else:
				function_return_type_mismatch_error(
					result.context.state,
					function_name,
					expected_type,
					found_type,
				)
		None:
			if types_equal(found_type, type_void()):
				result.context.state
			else:
				function_missing_return_type_error(result.context.state, function_name, found_type)


private MAIN_SIGNATURE_MESSAGE: String = "main must have signature: func main(args: List[String]) -> Int:"


private pure func main_param_type_valid(param: ParsedParam) -> Bool:
	match param_annotation_type(param):
		Some(typ):
			types_equal(typ, type_list(type_string()))
		None:
			False


private pure func main_return_type_valid(return_type: Option[ParsedTypeExpr]) -> Bool:
	match return_type:
		Some(type_expr):
			typ = compiler_type_from_parsed_type_expr(type_expr)

			types_equal(typ, type_int()) or types_equal(typ, type_void())
		None:
			True


private pure func main_return_type_text(return_type: Option[ParsedTypeExpr]) -> String:
	match return_type:
		Some(type_expr):
			type_to_string(compiler_type_from_parsed_type_expr(type_expr))
		None:
			"Void"


private pure func check_main_signature(
	state: CompilerTypecheckState,
	function_decl: ParsedFunctionDecl,
) -> CompilerTypecheckState:
	if function_decl.name.text != "main":
		state
	else if function_decl.params.length() != 1:
		compiler_typecheck_state_add_error(state, MAIN_SIGNATURE_MESSAGE)
	else:
		match function_decl.params.get(0):
			Some(param):
				param_valid = main_param_type_valid(param)
				return_valid = main_return_type_valid(function_decl.return_type)

				if not param_valid and not return_valid:
					compiler_typecheck_state_add_error(state, MAIN_SIGNATURE_MESSAGE)
				else if not return_valid:
					compiler_typecheck_state_add_error(
						state,
						"main must return Int or Void, got " + main_return_type_text(
							function_decl.return_type,
						),
					)
				else if not param_valid:
					param_text = match param_annotation_type(param):
						Some(typ):
							type_to_string(typ)
						None:
							"untyped"

					compiler_typecheck_state_add_error(
						state,
						"main parameter must be List[String], got " + param_text,
					)
				else:
					state
			None:
				compiler_typecheck_state_add_error(state, MAIN_SIGNATURE_MESSAGE)


private pure func check_pure_function_body_calls(
	state: CompilerTypecheckState,
	function_decl: ParsedFunctionDecl,
	result: InferResult,
) -> CompilerTypecheckState:
	check_pure_function_like_body_calls(
		state,
		function_decl.name.text,
		function_decl.is_pure,
		result,
	)


private pure func check_pure_function_like_body_calls(
	state: CompilerTypecheckState,
	function_name: String,
	is_pure: Bool,
	result: InferResult,
) -> CompilerTypecheckState:
	if not is_pure:
		state
	else:
		var next = state

		for call_name in typed_expr_impure_call_names(result.expr):
			next = compiler_typecheck_state_add_error(
				next,
				"Pure function '" + function_name + "' cannot call impure function '" + call_name + "'",
			)

		next


private pure func check_pure_function_module_assignments(
	state: CompilerTypecheckState,
	function_decl: ParsedFunctionDecl,
	result: InferResult,
) -> CompilerTypecheckState:
	check_pure_function_like_module_assignments(
		state,
		function_decl.name.text,
		function_decl.is_pure,
		result,
	)


private pure func check_pure_function_like_module_assignments(
	state: CompilerTypecheckState,
	function_name: String,
	is_pure: Bool,
	result: InferResult,
) -> CompilerTypecheckState:
	if not is_pure:
		state
	else:
		var next = state

		for name in typed_expr_module_assign_names(result.expr):
			next = compiler_typecheck_state_add_error(
				next,
				"Pure function '" + function_name + "' cannot assign to module-level variable '" + name + "'",
			)

		next


private pure func check_debug_block_body(
	state: CompilerTypecheckState,
	result: InferResult,
) -> CompilerTypecheckState:
	with_assignments = if typed_expr_has_debug_block_assignment(result.expr):
		compiler_typecheck_state_add_error(state, "debug: blocks cannot assign")
	else:
		state

	var next = with_assignments

	for call_name in typed_expr_debug_block_impure_call_names(result.expr):
		next = compiler_typecheck_state_add_error(
			next,
			"debug: blocks cannot call impure function '" + call_name + "'",
		)

	next


private pure func type_is_impure_function_type(typ: SemanticType) -> Bool:
	match typ:
		SemanticFunctionType(is_pure, _, _):
			not is_pure
		_:
			False


private pure func check_pure_function_callback_params(
	state: CompilerTypecheckState,
	function_decl: ParsedFunctionDecl,
	param_types: List[SemanticType],
) -> CompilerTypecheckState:
	check_pure_function_like_callback_params(
		state,
		function_decl.name.text,
		function_decl.is_pure,
		function_decl.params,
		param_types,
	)


private pure func check_pure_function_like_callback_params(
	state: CompilerTypecheckState,
	function_name: String,
	is_pure: Bool,
	params: List[ParsedParam],
	param_types: List[SemanticType],
) -> CompilerTypecheckState:
	if not is_pure:
		state
	else:
		var next = state
		var index: Int = 0

		while index < params.length():
			match (params.get(index), param_types.get(index)):
				(Some(param), Some(param_type)):
					if type_is_impure_function_type(param_type):
						next = compiler_typecheck_state_add_error(
							next,
							"Pure function '" + function_name + "' has impure callback parameter '" + body_check_param_label(
								param,
							) + "'",
						)
				_:
					void

			index += 1

		next


private pure func check_nested_pure_lambda_body_calls(
	state: CompilerTypecheckState,
	result: InferResult,
) -> CompilerTypecheckState:
	var next = state

	for call_name in typed_expr_pure_lambda_impure_call_names(result.expr):
		next = compiler_typecheck_state_add_error(
			next,
			"Pure function '<lambda>' cannot call impure function '" + call_name + "'",
		)

	next


private pure func check_tail_recursive_function_body(
	state: CompilerTypecheckState,
	function_decl: ParsedFunctionDecl,
	result: InferResult,
) -> CompilerTypecheckState:
	if not function_decl.annotations.any(annotation_is_tail_recursive):
		state
	else if typed_expr_has_non_tail_recursive_call(result.expr, function_decl.name.text):
		compiler_typecheck_state_add_error(
			state,
			"@tail_recursive function '" + function_decl.name.text + "' has recursive call not in tail position",
		)
	else:
		state


private pure func typed_function_info(
	function_decl: ParsedFunctionDecl,
	signature: FunctionBodySignature,
	body: Option[TypedExpr],
) -> TypedFunctionInfo:
	source_return_type: Option[SemanticType] = function_decl.return_type.map(
		compiler_type_from_parsed_type_expr,
	)

	{
		decl = function_decl,
		callable_id = signature.callable_id,
		effective_type_params = signature.effective_type_params,
		param_types = signature.param_types,
		source_return_type = source_return_type,
		semantic_return_type = signature.semantic_return_type,
		body = body
	}


private pure func materialize_declared_return_body(
	return_type: Option[SemanticType],
	body: TypedExpr,
	value_matches_declared_return: Bool,
) -> TypedExpr:
	match return_type:
		Some(expected):
			if value_matches_declared_return:
				typed_expr_with_slot(body, KeptValueSlot(expected))
			else:
				body
		None:
			body


private pure func typecheck_materialize_function_body_with_options(
	state: CompilerTypecheckState,
	function_decl: ParsedFunctionDecl,
	should_check_main_signature: Bool,
) -> TypecheckFunctionBodyResult:
	signature_state = if should_check_main_signature:
		check_main_signature(state, function_decl)
	else:
		state

	signature = function_body_signature(signature_state, function_decl)
	declared_return_type = function_declared_return_type(function_decl, signature)

	match function_decl.body:
		Some(body):
			if parsed_function_body_is_builtin(function_decl.body):
				typed_info = typed_function_info(function_decl, signature, None)

				{
					state = signature_state,
					typed = typed_info
				}
			else:
				body_state = prepare_function_body_state(signature_state, function_decl, signature)
				context = body_check_context_with_expected_type(body_state, declared_return_type)
				raw_result = infer_expr(context, body)
				result = finalize_infer_result(raw_result)

				value_matches_declared_return = match declared_return_type:
					Some(expected_type):
						types_compatible_with_params(
							env_get_type_params(result.context.state.env),
							expected_type,
							typed_expr_value_type(result.expr),
						)
					None:
						False

				checked_state = check_function_like_body_result(
					function_decl.name.text,
					declared_return_type,
					value_matches_declared_return,
					result,
				)
				debug_checked_state = check_debug_block_body(checked_state, result)
				callback_checked_state = check_pure_function_callback_params(
					debug_checked_state,
					function_decl,
					signature.param_types,
				)
				lambda_checked_state = check_nested_pure_lambda_body_calls(
					callback_checked_state,
					result,
				)
				purity_checked_state = check_pure_function_body_calls(
					lambda_checked_state,
					function_decl,
					result,
				)
				module_assign_checked_state = check_pure_function_module_assignments(
					purity_checked_state,
					function_decl,
					result,
				)
				tail_checked_state = check_tail_recursive_function_body(
					module_assign_checked_state,
					function_decl,
					result,
				)
				typed_body = materialize_declared_return_body(
					declared_return_type,
					result.expr,
					value_matches_declared_return,
				)
				final_state = typecheck_with_body_env(signature_state, tail_checked_state)
				typed_info = typed_function_info(function_decl, signature, Some(typed_body))

				{
					state = final_state,
					typed = typed_info
				}
		None:
			typed_info = typed_function_info(function_decl, signature, None)

			{
				state = signature_state,
				typed = typed_info
			}


private pure func typecheck_check_function_body_with_options(
	state: CompilerTypecheckState,
	function_decl: ParsedFunctionDecl,
	should_check_main_signature: Bool,
) -> CompilerTypecheckState:
	typecheck_materialize_function_body_with_options(
		state,
		function_decl,
		should_check_main_signature,
	).state


pure func typecheck_check_function_body(
	state: CompilerTypecheckState,
	function_decl: ParsedFunctionDecl,
) -> CompilerTypecheckState:
	typecheck_check_function_body_with_options(state, function_decl, True)


private pure func global_var_type_mismatch_error(
	state: CompilerTypecheckState,
	name: String,
) -> CompilerTypecheckState:
	compiler_typecheck_state_add_error(state, "Global variable '" + name + "' has wrong type")


private pure func register_checked_global_var(
	state: CompilerTypecheckState,
	module_path: String,
	var_decl: ParsedVarDecl,
	inferred_type: SemanticType,
	source_type: Option[SemanticType],
) -> CompilerTypecheckState:
	typecheck_state_with_env(
		state,
		env_add_var_with_module_details(
			state.env,
			var_decl.name.text,
			inferred_type,
			source_type,
			var_mutability(var_decl.is_mutable),
			LetBinding,
			unrefined_binding(),
			Some(module_path),
		),
	)


private pure func check_mutable_global_startup_work(
	state: CompilerTypecheckState,
	var_decl: ParsedVarDecl,
	result: InferResult,
) -> CompilerTypecheckState:
	if not var_decl.is_mutable:
		state
	else:
		var next = state

		for call_name in typed_expr_startup_call_names(result.expr):
			next = compiler_typecheck_state_add_error(
				next,
				"top-level initializer '" + var_decl.name.text + "' cannot call function '" + call_name + "'",
			)

		if typed_expr_has_startup_subscript(result.expr):
			next = compiler_typecheck_state_add_error(
				next,
				"top-level initializer '" + var_decl.name.text + "' cannot use a subscript expression",
			)

		next


private pure func typed_global_var_info(
	var_decl: ParsedVarDecl,
	binding_type: SemanticType,
	source_type: Option[SemanticType],
	value: TypedExpr,
) -> TypedGlobalVarInfo:
	{
		decl = var_decl,
		binding_type = binding_type,
		source_type = source_type,
		value = value
	}


pure func typecheck_materialize_global_var_body(
	state: CompilerTypecheckState,
	module_path: String,
	var_decl: ParsedVarDecl,
) -> TypecheckGlobalVarBodyResult:
	declared_source_type: Option[SemanticType] = var_decl.type_expr.map(
		compiler_type_from_parsed_type_expr,
	)

	type_expectation: GlobalTypeExpectation = match declared_source_type:
		Some(typ):
			DeclaredGlobalType(canonical_annotation_type(state, typ))
		None:
			InferredGlobalType

	context = match type_expectation:
		DeclaredGlobalType(expected):
			infer_with_expected_value_slot(infer_context(state), expected, ExpectedArgumentSlot)
		InferredGlobalType:
			infer_context(state)

	raw_result = infer_expr(context, var_decl.value)
	result = finalize_infer_result(raw_result)
	found_type = typed_expr_value_type(result.expr)

	type_matches = match type_expectation:
		DeclaredGlobalType(expected):
			types_compatible_with_params(
				env_get_type_params(result.context.state.env),
				expected,
				found_type,
			)
		InferredGlobalType:
			True

	checked_state = match type_expectation:
		DeclaredGlobalType(_):
			if type_matches:
				result.context.state
			else:
				global_var_type_mismatch_error(result.context.state, var_decl.name.text)
		InferredGlobalType:
			result.context.state

	startup_checked_state = if type_matches:
		check_mutable_global_startup_work(checked_state, var_decl, result)
	else:
		checked_state

	binding_type = match type_expectation:
		DeclaredGlobalType(expected):
			expected
		InferredGlobalType:
			typed_expr_semantic_type(result.expr)

	final_state = register_checked_global_var(
		startup_checked_state,
		module_path,
		var_decl,
		binding_type,
		declared_source_type,
	)

	{
		state = final_state,
		typed = typed_global_var_info(var_decl, binding_type, declared_source_type, result.expr)
	}


private pure func impl_error_message(
	impl_decl: ParsedImplDecl,
	for_type: SemanticType,
	message: String,
) -> String:
	"impl " + impl_decl.trait_name.text + " for " + type_to_string(for_type) + ": " + message


private pure func impl_has_method(methods: List[ParsedFunctionDecl], name: String) -> Bool:
	methods
		.map(func(method): method.name.text)
		.contains(name)


private pure func find_trait_method(
	methods: List[TraitMethodSig],
	name: String,
) -> Option[TraitMethodSig]:
	var result: Option[TraitMethodSig] = None

	for method in methods:
		if method.name == name:
			result = Some(method)
			break

	result


private pure func resolve_impl_method_sig(
	for_type: SemanticType,
	method: TraitMethodSig,
) -> TraitMethodSig:
	{
		name = method.name,
		params = method.params.map(func(param): resolve_self(for_type, param)),
		return_type = resolve_self(for_type, method.return_type),
		is_pure = method.is_pure,
		has_default = method.has_default,
		param_names = method.param_names
	}


private pure func impl_validate_required_methods(
	state: CompilerTypecheckState,
	impl_decl: ParsedImplDecl,
	for_type: SemanticType,
	methods: List[TraitMethodSig],
) -> CompilerTypecheckState:
	var next = state

	for method in methods:
		if not method.has_default and not impl_has_method(impl_decl.methods, method.name):
			next = compiler_typecheck_state_add_error(
				next,
				impl_error_message(
					impl_decl,
					for_type,
					"missing required method '" + method.name + "'",
				),
			)

	next


private pure func impl_validate_supertraits(
	state: CompilerTypecheckState,
	impl_decl: ParsedImplDecl,
	for_type: SemanticType,
	supertraits: List[String],
) -> CompilerTypecheckState:
	var next = state

	for supertrait in supertraits:
		if not env_has_direct_trait_evidence(
			next.env,
			trait_obligation(for_type, supertrait),
		):
			next = compiler_typecheck_state_add_error(
				next,
				impl_error_message(
					impl_decl,
					for_type,
					"supertrait '" + supertrait + "' is not implemented",
				),
			)

	next


private pure func impl_validate_method_params(
	state: CompilerTypecheckState,
	impl_decl: ParsedImplDecl,
	for_type: SemanticType,
	method: ParsedFunctionDecl,
	expected_params: List[SemanticType],
	type_params: List[String],
) -> CompilerTypecheckState:
	if method.params.length() != expected_params.length():
		compiler_typecheck_state_add_error(
			state,
			impl_error_message(
				impl_decl,
				for_type,
				"method '" + method.name.text + "' has " + method.params
					.length()
					.to_string() + " parameters, trait requires " + expected_params
					.length()
					.to_string(),
			),
		)
	else:
		var next = state
		var index: Int = 0

		while index < method.params.length():
			match (method.params.get(index), expected_params.get(index)):
				(Some(param), Some(expected_type)):
					impl_type = param_type_from_parsed(param)

					if not types_compatible_with_params(type_params, expected_type, impl_type):
						next = compiler_typecheck_state_add_error(
							next,
							impl_error_message(
								impl_decl,
								for_type,
								"method '" + method.name.text + "' parameter '" + param_name_from_parsed(
									param,
								).get_or(
									"_",
								) + "' has type " + type_to_string(
									impl_type,
								) + ", trait requires " + type_to_string(expected_type),
							),
						)
				_:
					void

			index += 1

		next


private pure func impl_validate_method_signature(
	state: CompilerTypecheckState,
	impl_decl: ParsedImplDecl,
	for_type: SemanticType,
	method: ParsedFunctionDecl,
	trait_method: TraitMethodSig,
) -> CompilerTypecheckState:
	resolved = resolve_impl_method_sig(for_type, trait_method)

	purity_state = if resolved.is_pure and not method.is_pure:
		compiler_typecheck_state_add_error(
			state,
			impl_error_message(
				impl_decl,
				for_type,
				"method '" + method.name.text + "' must be pure",
			),
		)
	else:
		state

	return_state = match method.return_type:
		Some(return_type):
			impl_return = compiler_type_from_parsed_type_expr(return_type)
			type_params = collect_type_vars(
				for_type,
			).concat(compiler_type_param_names(method.type_params))

			if types_compatible_with_params(type_params, resolved.return_type, impl_return):
				purity_state
			else:
				compiler_typecheck_state_add_error(
					purity_state,
					impl_error_message(
						impl_decl,
						for_type,
						"method '" + method.name.text + "' returns " + type_to_string(
							impl_return,
						) + ", trait requires " + type_to_string(resolved.return_type),
					),
				)
		None:
			purity_state

	type_params = collect_type_vars(for_type).concat(compiler_type_param_names(method.type_params))
	impl_validate_method_params(
		return_state,
		impl_decl,
		for_type,
		method,
		resolved.params,
		type_params,
	)


private pure func impl_validate_method_signatures(
	state: CompilerTypecheckState,
	impl_decl: ParsedImplDecl,
	for_type: SemanticType,
	methods: List[TraitMethodSig],
) -> CompilerTypecheckState:
	var next = state

	for method in impl_decl.methods:
		match find_trait_method(methods, method.name.text):
			Some(trait_method):
				next = impl_validate_method_signature(
					next,
					impl_decl,
					for_type,
					method,
					trait_method,
				)
			None:
				void

	next


private pure func find_trait_decl_in_decl(
	decl: ParsedDecl,
	trait_name: String,
) -> Option[ParsedTraitDecl]:
	match decl:
		TraitParsedDecl(trait_decl):
			if trait_decl.name.text == trait_name:
				Some(trait_decl)
			else:
				None
		PrivateParsedDecl(inner, _):
			find_trait_decl_in_decl(inner, trait_name)
		_:
			None


private pure func find_trait_decl(
	decls: List[ParsedDecl],
	trait_name: String,
) -> Option[ParsedTraitDecl]:
	var result: Option[ParsedTraitDecl] = None

	for decl in decls:
		match find_trait_decl_in_decl(decl, trait_name):
			Some(trait_decl):
				result = Some(trait_decl)
				break
			None:
				void

	result


private pure func resolve_self_parsed_type(
	replacement: ParsedTypeExpr,
	type_expr: ParsedTypeExpr,
) -> ParsedTypeExpr:
	match type_expr:
		ParsedNamedType(name, args, span):
			if name.text == "Self" and args.length() == 0:
				replacement
			else:
				ParsedNamedType(
					name,
					args.map(func(arg): resolve_self_parsed_type(replacement, arg)),
					span,
				)
		ParsedQualifiedNamedType(qualifier, name, args, span):
			ParsedQualifiedNamedType(
				qualifier,
				name,
				args.map(func(arg): resolve_self_parsed_type(replacement, arg)),
				span,
			)
		ParsedTupleType(items, span):
			ParsedTupleType(
				items.map(func(item): resolve_self_parsed_type(replacement, item)),
				span,
			)
		ParsedArrayType(element, dims, span):
			ParsedArrayType(
				resolve_self_parsed_type(replacement, element),
				dims.map(func(dim): resolve_self_parsed_type(replacement, dim)),
				span,
			)
		ParsedFunctionType(is_pure, params, return_type, span):
			ParsedFunctionType(
				is_pure,
				params.map(func(param): resolve_self_parsed_type(replacement, param)),
				resolve_self_parsed_type(replacement, return_type),
				span,
			)
		ParsedRangeType(inner, span):
			ParsedRangeType(
				resolve_self_parsed_type(replacement, inner),
				span,
			)
		ParsedDimBinaryType(op, left, right, span):
			ParsedDimBinaryType(
				op,
				resolve_self_parsed_type(replacement, left),
				resolve_self_parsed_type(replacement, right),
				span,
			)
		_:
			type_expr


private pure func resolve_self_optional_parsed_type(
	replacement: ParsedTypeExpr,
	type_expr: Option[ParsedTypeExpr],
) -> Option[ParsedTypeExpr]:
	type_expr.map(func(value): resolve_self_parsed_type(replacement, value))


private pure func resolve_self_parsed_param(
	replacement: ParsedTypeExpr,
	param: ParsedParam,
) -> ParsedParam:
	{ param | type_expr = resolve_self_optional_parsed_type(replacement, param.type_expr) }


private pure func resolve_self_parsed_function(
	replacement: ParsedTypeExpr,
	decl: ParsedFunctionDecl,
) -> ParsedFunctionDecl:
	{ decl |
		params = decl.params.map(func(param): resolve_self_parsed_param(replacement, param)),
		return_type = resolve_self_optional_parsed_type(replacement, decl.return_type),
		body = decl.body.map(func(body): resolve_self_parsed_expr(replacement, body))
	}


private pure func resolve_self_parsed_expr(
	replacement: ParsedTypeExpr,
	expr: ParsedExpr,
) -> ParsedExpr:
	with_children = map_parsed_expr_children(
		expr,
		func(child): resolve_self_parsed_expr(replacement, child),
	)

	match with_children:
		ParsedAscriptionExpr(value, type_expr, span):
			ParsedAscriptionExpr(
				value,
				resolve_self_parsed_type(replacement, type_expr),
				span,
			)
		ParsedOpaqueIntoExpr(type_expr, value, span):
			ParsedOpaqueIntoExpr(
				resolve_self_parsed_type(replacement, type_expr),
				value,
				span,
			)
		ParsedOpaqueFromExpr(type_expr, value, span):
			ParsedOpaqueFromExpr(
				resolve_self_parsed_type(replacement, type_expr),
				value,
				span,
			)
		ParsedWithExpr(binding, body, span):
			ParsedWithExpr(
				{ binding |
					type_expr = resolve_self_optional_parsed_type(replacement, binding.type_expr)
				},
				body,
				span,
			)
		ParsedLambdaExpr(is_pure, params, return_type, body, span):
			ParsedLambdaExpr(
				is_pure,
				params.map(
					func(
						param,
					): { param |
						type_expr = resolve_self_optional_parsed_type(replacement, param.type_expr)
					},
				),
				resolve_self_optional_parsed_type(replacement, return_type),
				body,
				span,
			)
		ParsedFunctionDeclExpr(decl):
			ParsedFunctionDeclExpr(resolve_self_parsed_function(replacement, decl))
		ParsedVarDeclExpr(name, type_expr, value, is_mutable, span):
			ParsedVarDeclExpr(
				name,
				resolve_self_optional_parsed_type(replacement, type_expr),
				value,
				is_mutable,
				span,
			)
		ParsedQuestionBindExpr(name, type_expr, value, span):
			ParsedQuestionBindExpr(
				name,
				resolve_self_optional_parsed_type(replacement, type_expr),
				value,
				span,
			)
		_:
			with_children


private pure func default_impl_method_decl(
	impl_decl: ParsedImplDecl,
	method: ParsedTraitMethodDecl,
) -> ParsedFunctionDecl:
	replacement: ParsedTypeExpr = impl_decl.for_type
	{
		name = method.name,
		keyword_span = None,
		type_params = [],
		params = method.params.map(func(param): resolve_self_parsed_param(replacement, param)),
		return_type = resolve_self_optional_parsed_type(replacement, method.return_type),
		dim_constraints = [],
		body = method.body.map(func(body): resolve_self_parsed_expr(replacement, body)),
		is_pure = method.is_pure,
		annotations = [],
		doc = None,
		span = impl_decl.span
	}


private pure func find_imported_trait_decl(
	import_modules: List[CompilerImportableModule],
	module_path: String,
	trait_name: String,
) -> Option[ParsedTraitDecl]:
	var result: Option[ParsedTraitDecl] = None

	for module in import_modules:
		if compiler_importable_module_path(module) == module_path:
			result = find_trait_decl(compiler_importable_module_decls(module), trait_name)
			break

	result


private pure func importable_module_is_prelude_traits(module: CompilerImportableModule) -> Bool:
	prelude_traits_module_matches(
		compiler_importable_module_origin(module),
		compiler_importable_module_path(module),
		compiler_importable_module_surface_value(module).module_name,
	)


private pure func find_prelude_trait_decl(
	import_modules: List[CompilerImportableModule],
	trait_name: String,
) -> Option[ParsedTraitDecl]:
	var result: Option[ParsedTraitDecl] = None

	for module in import_modules:
		if importable_module_is_prelude_traits(module):
			result = find_trait_decl(compiler_importable_module_decls(module), trait_name)
			break

	result


private pure func find_impl_trait_decl(
	state: CompilerTypecheckState,
	decls: List[ParsedDecl],
	import_modules: List[CompilerImportableModule],
	trait_name: String,
) -> Option[ParsedTraitDecl]:
	match find_trait_decl(decls, trait_name):
		Some(trait_decl):
			Some(trait_decl)
		None:
			match compiler_typecheck_state_find_imported_name(state, trait_name):
				Some(binding):
					find_imported_trait_decl(
						import_modules,
						binding.module_path,
						binding.original_name,
					)
				None:
					if builtin_trait_is_prelude(trait_name):
						find_prelude_trait_decl(import_modules, trait_name)
					else:
						None


private pure func add_impl_body_trait_functions(
	state: CompilerTypecheckState,
	trait_name: String,
) -> CompilerTypecheckState:
	var next = state

	for pair in env_trait_methods_with_declaring_trait(state.env, trait_name):
		next = typecheck_state_with_env(
			next,
			env_add_trait_function(next.env, pair[0], pair[1]),
		)
		next = compiler_typecheck_state_add_scoped_trait_function(next, pair[0], pair[1])

	next


private pure func typecheck_validate_impl_decl(
	state: CompilerTypecheckState,
	impl_decl: ParsedImplDecl,
	for_type: SemanticType,
) -> CompilerTypecheckState:
	if not trait_visible_for_impl(state, impl_decl.trait_name.text):
		compiler_typecheck_state_add_error(
			state,
			impl_error_message(
				impl_decl,
				for_type,
				"unknown trait '" + impl_decl.trait_name.text + "'",
			),
		)
	else:
		typecheck_validate_visible_impl_decl(state, impl_decl, for_type)


private pure func trait_visible_for_impl(state: CompilerTypecheckState, trait_name: String) -> Bool:
	match compiler_typecheck_state_find_top_level_name(state, trait_name):
		Some(kind):
			kind == CompilerTopLevelTrait
		None:
			match compiler_typecheck_state_find_imported_name(state, trait_name):
				Some(_):
					True
				None:
					match env_get_trait(state.env, trait_name):
						Some(trait_def):
							match trait_def.module_path:
								Some(module_path):
									module_path == "std/traits"
								None:
									True
						None:
							False


private pure func typecheck_validate_visible_impl_decl(
	state: CompilerTypecheckState,
	impl_decl: ParsedImplDecl,
	for_type: SemanticType,
) -> CompilerTypecheckState:
	match env_get_trait(state.env, impl_decl.trait_name.text):
		Some(trait_def):
			with_required = impl_validate_required_methods(
				state,
				impl_decl,
				for_type,
				trait_def.methods,
			)
			with_supertraits = impl_validate_supertraits(
				with_required,
				impl_decl,
				for_type,
				trait_def.supertraits,
			)
			impl_validate_method_signatures(
				with_supertraits,
				impl_decl,
				for_type,
				trait_def.methods,
			)
		None:
			compiler_typecheck_state_add_error(
				state,
				impl_error_message(
					impl_decl,
					for_type,
					"unknown trait '" + impl_decl.trait_name.text + "'",
				),
			)


private pure func typecheck_materialize_impl_body(
	state: CompilerTypecheckState,
	decls: List[ParsedDecl],
	import_modules: List[CompilerImportableModule],
	impl_decl: ParsedImplDecl,
) -> TypecheckImplBodyResult:
	raw_for_type: SemanticType = canonical_annotation_type(
		state,
		compiler_type_from_parsed_type_expr(impl_decl.for_type),
	)
	for_type: SemanticType = impl_normalize_receiver_type(state, impl_decl.for_type, raw_for_type)
	bounds: List[BoundTypeParam] = impl_bounds_for_decl_type(state, impl_decl.for_type, for_type)

	state_with_bounds = if bounds.length() == 0:
		state
	else:
		typecheck_state_with_env(
			state,
			env_extend_type_param_bounds(state.env, bounds),
		)

	validated = typecheck_validate_impl_decl(state_with_bounds, impl_decl, for_type)

	if validated.errors.length() > state.errors.length():
		{
			state = typecheck_with_body_env(state, validated),
			typed = {
				decl = impl_decl,
				for_type = for_type,
				type_params = bounds,
				methods = []
			}
		}
	else:
		body_state = add_impl_body_trait_functions(validated, impl_decl.trait_name.text)

		var next = body_state
		var typed_methods: List[TypedFunctionInfo] = []

		for method in impl_decl.methods:
			method_result = typecheck_materialize_function_body_with_options(next, method, False)
			next = method_result.state
			typed_methods = typed_methods.append(method_result.typed)

		if collect_type_vars(for_type).length() == 0:
			match find_impl_trait_decl(next, decls, import_modules, impl_decl.trait_name.text):
				Some(trait_decl):
					for method in trait_decl.methods:
						if (
							method.body.is_some()
							and not impl_has_method(impl_decl.methods, method.name.text)
						):
							default_decl = default_impl_method_decl(impl_decl, method)
							callable_key = callable_key_from_span(
								next,
								default_decl.name.text,
								default_decl.span,
							)

							match compiler_typecheck_state_claim_func_callable_id(
								next,
								callable_key,
							):
								CompilerDefinitionIdMissing(with_error):
									next = with_error
								CompilerDefinitionIdClaimed(with_id, _):
									method_result = typecheck_materialize_function_body_with_options(
										with_id,
										default_decl,
										False,
									)
									next = method_result.state
									typed_methods = typed_methods.append(method_result.typed)
				None:
					void

		{
			state = compiler_typecheck_state_with_scoped_trait_functions(
				typecheck_with_body_env(state, next),
				state.scoped_trait_functions,
			),
			typed = {
				decl = impl_decl,
				for_type = for_type,
				type_params = bounds,
				methods = typed_methods
			}
		}


private pure func typed_foreign_link_flag(arg: ParsedForeignBlockArg) -> List[TypedForeignLinkFlag]:
	match arg.name.text:
		"link":
			[
				{
					platform = None,
					flag = arg.value
				},
			]
		"link_linux":
			[
				{
					platform = Some(TypedForeignLinux),
					flag = arg.value
				},
			]
		"link_macos":
			[
				{
					platform = Some(TypedForeignMacos),
					flag = arg.value
				},
			]
		_:
			[]


private pure func typed_foreign_link_flags(
	args: List[ParsedForeignBlockArg],
) -> List[TypedForeignLinkFlag]:
	args.flat_map(typed_foreign_link_flag)


private pure func typed_foreign_function_info(
	state: CompilerTypecheckState,
	block_args: List[ParsedForeignBlockArg],
	block_span: CompilerSourceSpan,
	decl: ParsedForeignFunctionDecl,
) -> TypedForeignFunctionInfo:
	name: String = decl.name.text
	param_types: List[SemanticType] = param_types_from_parsed(
		decl.params,
	).map(
		func(param_type): canonical_annotation_type(state, param_type),
	)
	return_type: SemanticType = canonical_annotation_type(
		state,
		compiler_type_from_parsed_type_expr(decl.return_type),
	)

	arg_passing: TypedForeignArgPassing = if (
		decl.is_pure
		or decl.annotations.any(annotation_is_no_copy)
	):
		TypedForeignBorrowArgs
	else:
		TypedForeignDefaultArgs

	includes: List[String] = block_args.filter_map(func(arg):
		if arg.name.text == "include":
			Some(arg.value)
		else:
			None
	)

	{
		decl = decl,
		callable_id = compiler_typecheck_state_find_func_callable_id(
			state,
			callable_key_from_span(state, name, decl.span),
		),
		param_types = param_types,
		semantic_return_type = return_type,
		c_name = decl.c_name.get_or(name),
		includes = includes,
		link_flags = typed_foreign_link_flags(block_args),
		arg_passing = arg_passing,
		block_span = block_span
	}


private pure func typed_foreign_block(
	state: CompilerTypecheckState,
	block_args: List[ParsedForeignBlockArg],
	functions: List[ParsedForeignFunctionDecl],
	block_span: CompilerSourceSpan,
) -> TypedForeignBlockResult:
	var next_state: CompilerTypecheckState = state
	var typed_decls: List[TypedDecl] = []

	for function_decl in functions:
		info: TypedForeignFunctionInfo = typed_foreign_function_info(
			state,
			block_args,
			block_span,
			function_decl,
		)

		for error in compiler_validate_foreign_function(
			state.env,
			block_args,
			function_decl,
			info.param_types,
			info.semantic_return_type,
			typed_foreign_arg_passing_borrows(info.arg_passing),
		):
			next_state = compiler_typecheck_state_add_error(next_state, error)

		typed_decls = typed_decls.append(TypedForeignFunctionDecl(info))

	{
		state = next_state,
		decls = typed_decls
	}


private pure func typecheck_materialize_decl_body(
	state: CompilerTypecheckState,
	module_path: String,
	decls: List[ParsedDecl],
	import_modules: List[CompilerImportableModule],
	decl: ParsedDecl,
) -> TypecheckDeclBodyResult:
	match decl:
		FunctionParsedDecl(function_decl):
			result = typecheck_materialize_function_body_with_options(state, function_decl, True)
			{
				state = result.state,
				decl = TypedFunctionDecl(result.typed)
			}
		VarParsedDecl(var_decl):
			result = typecheck_materialize_global_var_body(state, module_path, var_decl)
			{
				state = result.state,
				decl = TypedGlobalVarDecl(result.typed)
			}
		RecordParsedDecl(record_decl):
			{
				state = state,
				decl = TypedRecordDecl(typed_record_from_parsed(state, record_decl))
			}
		UnionParsedDecl(union_decl):
			{
				state = state,
				decl = TypedUnionDecl(typed_union_from_parsed(state, union_decl))
			}
		TypeAliasParsedDecl(alias_decl):
			{
				state = state,
				decl = TypedTypeAliasDecl(typed_type_alias_from_parsed(state, alias_decl))
			}
		TraitParsedDecl(trait_decl):
			{
				state = state,
				decl = TypedTraitDecl(typed_trait_from_parsed(state, trait_decl))
			}
		ImplParsedDecl(impl_decl):
			result = typecheck_materialize_impl_body(state, decls, import_modules, impl_decl)
			{
				state = result.state,
				decl = TypedImplDecl(result.typed)
			}
		PrivateParsedDecl(inner, _):
			result = typecheck_materialize_decl_body(
				state,
				module_path,
				decls,
				import_modules,
				inner,
			)
			{
				state = result.state,
				decl = TypedPrivateDecl(result.decl)
			}
		_:
			{
				state = state,
				decl = TypedParsedDecl(decl)
			}


pure func typecheck_check_program_bodies(
	state: CompilerTypecheckState,
	program: ParsedProgram,
) -> CompilerTypecheckState:
	typecheck_materialize_program_bodies(state, program).state


pure func typecheck_materialize_program_bodies(
	state: CompilerTypecheckState,
	program: ParsedProgram,
) -> TypecheckProgramResult:
	typecheck_materialize_program_bodies_with_import_modules(state, program, [])


private pure func typecheck_materialize_program_bodies_with_import_modules(
	state: CompilerTypecheckState,
	program: ParsedProgram,
	import_modules: List[CompilerImportableModule],
) -> TypecheckProgramResult:
	var next_state = state
	var typed_decls: List[TypedDecl] = []

	for decl in program.decls:
		next_state = compiler_typecheck_state_reset_type_shape_memo(next_state)

		match decl:
			ForeignBlockParsedDecl(block_args, functions, block_span):
				foreign_result: TypedForeignBlockResult = typed_foreign_block(
					next_state,
					block_args,
					functions,
					block_span,
				)
				next_state = foreign_result.state
				typed_decls = typed_decls.concat(foreign_result.decls)
			_:
				result = typecheck_materialize_decl_body(
					next_state,
					program.source.module_name,
					program.decls,
					import_modules,
					decl,
				)
				next_state = result.state
				typed_decls = typed_decls.append(result.decl)

	typecheck_validate_typed_program({
		state = compiler_typecheck_state_reset_type_shape_memo(next_state),
		program = typed_program_from_decls(program, typed_decls),
	})


private func typecheck_materialize_program_bodies_with_import_modules_with_trace(
	state: CompilerTypecheckState,
	program: ParsedProgram,
	import_modules: List[CompilerImportableModule],
	trace: (String) -> Void,
) -> TypecheckProgramResult:
	var next_state = state
	var typed_decls: List[TypedDecl] = []
	var decl_index: Int = 0

	for decl in program.decls:
		phase_prefix = "typecheck_body_decl_" + decl_index.to_string()
		trace(phase_prefix + "_start")
		next_state = compiler_typecheck_state_reset_type_shape_memo(next_state)

		match decl:
			ForeignBlockParsedDecl(block_args, functions, block_span):
				foreign_result: TypedForeignBlockResult = typed_foreign_block(
					next_state,
					block_args,
					functions,
					block_span,
				)
				next_state = foreign_result.state
				typed_decls = typed_decls.concat(foreign_result.decls)
			_:
				result = typecheck_materialize_decl_body(
					next_state,
					program.source.module_name,
					program.decls,
					import_modules,
					decl,
				)
				next_state = result.state
				typed_decls = typed_decls.append(result.decl)

		trace(phase_prefix + "_complete")
		decl_index += 1

	typecheck_validate_typed_program({
		state = compiler_typecheck_state_reset_type_shape_memo(next_state),
		program = typed_program_from_decls(program, typed_decls),
	})


private pure func typecheck_program_after_import_registration(
	state: CompilerTypecheckState,
	program: ParsedProgram,
	import_modules: List[CompilerImportableModule],
) -> TypecheckProgramResult:
	with_types = typecheck_register_program_type_decls(state, program)
	with_signatures = typecheck_register_program_signature_decls(with_types, program)
	with_impls = typecheck_register_program_impl_decls(with_signatures, program)

	typecheck_materialize_program_bodies_with_import_modules(with_impls, program, import_modules)


pure func typecheck_program_with_import_surfaces(
	state: CompilerTypecheckState,
	program: ParsedProgram,
	import_surfaces: List[CompilerImportableModuleSurface],
) -> TypecheckProgramResult:
	module_state = compiler_typecheck_state_scope_to_program(state, program)
	with_names = typecheck_prescan_program(module_state, program)
	with_imports = compiler_register_program_imports(with_names, import_surfaces, program)

	typecheck_program_after_import_registration(with_imports, program, [])


private pure func typecheck_program_with_import_modules_internal(
	state: CompilerTypecheckState,
	program: ParsedProgram,
	import_modules: List[CompilerImportableModule],
	current_module_path: Option[String],
) -> TypecheckProgramResult:
	module_state = compiler_typecheck_state_scope_to_program(state, program)
	program_with_prelude = compiler_program_with_prelude_imports(state, program, import_modules)
	type_import_modules = compiler_visible_importable_modules_for_program(
		program_with_prelude,
		import_modules,
		current_module_path,
	)
	import_surfaces = compiler_importable_module_surfaces(type_import_modules)
	direct_import_modules = compiler_direct_importable_modules_for_program(
		program_with_prelude,
		type_import_modules,
		current_module_path,
	)
	with_names = typecheck_prescan_program(module_state, program_with_prelude)
	with_imports = compiler_register_program_imports(
		with_names,
		import_surfaces,
		program_with_prelude,
	)
	with_import_decls = typecheck_register_import_modules(
		with_imports,
		type_import_modules,
		direct_import_modules,
		import_surfaces,
	)

	typecheck_program_after_import_registration(
		with_import_decls,
		program_with_prelude,
		import_modules,
	)


pure func typecheck_program_with_import_modules(
	state: CompilerTypecheckState,
	program: ParsedProgram,
	import_modules: List[CompilerImportableModule],
) -> TypecheckProgramResult:
	typecheck_program_with_import_modules_internal(state, program, import_modules, None)


pure func typecheck_program_with_import_modules_for_module(
	state: CompilerTypecheckState,
	program: ParsedProgram,
	import_modules: List[CompilerImportableModule],
	current_module_path: String,
) -> TypecheckProgramResult:
	typecheck_program_with_import_modules_internal(
		state,
		program,
		import_modules,
		Some(current_module_path),
	)


func typecheck_program_with_import_modules_for_module_with_trace(
	state: CompilerTypecheckState,
	program: ParsedProgram,
	import_modules: List[CompilerImportableModule],
	current_module_path: String,
	trace: (String) -> Void,
) -> TypecheckProgramResult:
	module_state = compiler_typecheck_state_scope_to_program(state, program)
	program_with_prelude = compiler_program_with_prelude_imports(state, program, import_modules)
	trace("typecheck_prelude_complete")
	type_import_modules = compiler_visible_importable_modules_for_program(
		program_with_prelude,
		import_modules,
		Some(current_module_path),
	)
	trace("typecheck_reachable_imports_complete")
	import_surfaces = compiler_importable_module_surfaces(type_import_modules)
	trace("typecheck_import_surfaces_complete")
	direct_import_modules = compiler_direct_importable_modules_for_program(
		program_with_prelude,
		type_import_modules,
		Some(current_module_path),
	)
	trace("typecheck_direct_imports_complete")
	with_names = typecheck_prescan_program(module_state, program_with_prelude)
	trace("typecheck_prescan_complete")
	with_imports = compiler_register_program_imports(
		with_names,
		import_surfaces,
		program_with_prelude,
	)
	trace("typecheck_import_syntax_complete")
	with_import_decls = typecheck_register_import_modules(
		with_imports,
		type_import_modules,
		direct_import_modules,
		import_surfaces,
	)
	trace("typecheck_import_decls_complete")
	with_types = typecheck_register_program_type_decls(with_import_decls, program_with_prelude)
	trace("typecheck_local_types_complete")
	with_signatures = typecheck_register_program_signature_decls(with_types, program_with_prelude)
	trace("typecheck_local_signatures_complete")
	with_impls = typecheck_register_program_impl_decls(with_signatures, program_with_prelude)
	trace("typecheck_local_impls_complete")
	result = typecheck_materialize_program_bodies_with_import_modules_with_trace(
		with_impls,
		program_with_prelude,
		import_modules,
		trace,
	)
	trace("typecheck_bodies_complete")

	result


pure func typecheck_program(
	state: CompilerTypecheckState,
	program: ParsedProgram,
) -> TypecheckProgramResult:
	module_state = compiler_typecheck_state_scope_to_program(state, program)
	with_names = typecheck_prescan_program(module_state, program)
	with_imports = compiler_register_program_import_syntax(with_names, program)

	typecheck_program_after_import_registration(with_imports, program, [])
