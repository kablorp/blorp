-- JSON projection for Blorp-owned typed AST metadata.
--
-- This module owns the typed metadata transfer shape used by the temporary
-- Blorp-to-OCaml typed-program handoff. Keep these encoders structural:
-- display strings are useful for diagnostics, not for compiler boundaries.
import:
	../stage_01_file_io/compiler_source: CompilerSourceFile, CompilerSourceSpan
	../stage_03_parse/compiler_parsed_ast:
		ParsedBinaryOp(
			ParsedAddOp,
			ParsedDivideOp,
			ParsedEqualOp,
			ParsedGreaterEqualOp,
			ParsedGreaterOp,
			ParsedLessEqualOp,
			ParsedLessOp,
			ParsedModuloOp,
			ParsedMultiplyOp,
			ParsedNotEqualOp,
			ParsedSubtractOp,
		),
		ParsedDecl(ForeignBlockParsedDecl, TraitParsedDecl),
		ParsedForBinder(ParsedForNameBinder, ParsedForTupleBinder),
		ParsedForeignBlockArg,
		ParsedFunctionDecl,
		ParsedIdentifier,
		ParsedImplDecl,
		ParsedListPatternSpread(ParsedListSpreadName, ParsedListSpreadWildcard),
		ParsedLogicalOp(ParsedAndOp, ParsedOrOp),
		ParsedRecordDecl,
		ParsedTypeAliasDecl,
		ParsedUnaryOp(ParsedNegateOp, ParsedNotOp),
		ParsedUnionDecl,
		ParsedVarDecl,
		ParsedWithBindingKind(ParsedWithPlainBinding, ParsedWithTryBinding),
	../stage_03_parse/compiler_parsed_ast_json:
		parse_diagnostic_to_json,
		parsed_decl_to_json,
		parsed_function_decl_to_json,
		parsed_identifier_to_json,
		parsed_impl_decl_to_json,
		parsed_record_decl_to_json,
		parsed_source_file_to_json,
		parsed_source_span_to_json,
		parsed_type_alias_decl_to_json,
		parsed_union_decl_to_json,
		parsed_var_decl_to_json,
	../stage_05_types/compiler_env:
		ImplMethodTarget,
		Purity(Impure, Pure),
		ResourceArgPolicy(AllowResourceArgs, RejectResourceArgs),
		ResourceResultPolicy(
			ResourceResultDependent,
			ResourceResultIndependent,
			ResourceResultOrdinary,
		),
	../stage_05_types/compiler_generic_params: BoundTypeParam
	../stage_05_types/compiler_refinement:
		CompilerCollectionIdentity,
		CompilerDimensionIdentity,
		CompilerProofSource(
			CompilerProofSourceCondition,
			CompilerProofSourceLoopEnumerate,
			CompilerProofSourceLoopIndices,
			CompilerProofSourceLoopRange,
			CompilerProofSourceRangeTypeFallback,
			CompilerProofSourceUnknown,
		),
		CompilerProvenCollection(CompilerCollDim, CompilerCollSubscript, CompilerCollVar),
		CompilerRangeProof,
		CompilerRangeUpper(
			CompilerRangeUpperAtMostLength,
			CompilerRangeUpperDimension,
			CompilerRangeUpperLengthMinus,
			CompilerRangeUpperLit,
		),
		CompilerSubscriptProof,
		CompilerValueProofs,
		compiler_binding_range_proof,
		compiler_binding_subscript_proof,
		compiler_collection_identity_name,
		compiler_dimension_identity_name,
	../stage_05_types/compiler_type: CompilerType
	../stage_05_types/compiler_type_json:
		compiler_optional_type_to_json,
		compiler_type_list_to_json,
		compiler_type_to_json,
	../stage_05_types/compiler_type_widening:
		CollectionKind(DictLiteral, ListLiteral, SetLiteral, VectorLiteral),
		TypeWideningDecision(TypeKeep, TypeWiden),
		TypeWideningReason(
			ArgumentSlot,
			BitwiseOperator,
			CollectionElement,
			MethodReceiver,
			MutableBinding,
			NumericOperator,
			RangeProofErasure,
			TupleLiteral,
		),
		ValueSlot,
		widening_decision,
		widening_semantic_type,
	compiler_infer:
		CompilerCallableOrigin(
			CompilerCallableBuiltin,
			CompilerCallableConstructor,
			CompilerCallableForeign,
			CompilerCallableImported,
			CompilerCallableImplMethod,
			CompilerCallableLocal,
		),
		CompilerExprTypeOrigin(
			CompilerExplicitAnnotationOrigin,
			CompilerInferredOrigin,
			CompilerSynthesizedOrigin,
		),
		CompilerResolvedCallInfo,
		CompilerResolvedCallTarget(
			CompilerResolvedClosureCall,
			CompilerResolvedDirectCall,
			CompilerResolvedIntrinsicCall,
			CompilerResolvedTraitMethodCall,
		),
		CompilerTypedAssignScope(CompilerLocalAssignScope, CompilerModuleAssignScope),
		CompilerTypedAssignTarget,
		CompilerTypedConcurrentBinding,
		CompilerTypedConcurrentParam,
		CompilerTypedDictEntry,
		CompilerTypedExpr(
			CompilerTypedAscriptionExpr,
			CompilerTypedAssignExpr,
			CompilerTypedBinaryExpr,
			CompilerTypedBlockExpr,
			CompilerTypedBoolLiteralExpr,
			CompilerTypedBreakExpr,
			CompilerTypedBuiltinExpr,
			CompilerTypedCallExpr,
			CompilerTypedCharLiteralExpr,
			CompilerTypedConcurrentBlockExpr,
			CompilerTypedConcurrentForExpr,
			CompilerTypedContinueExpr,
			CompilerTypedDebugBlockExpr,
			CompilerTypedDetachExpr,
			CompilerTypedDictExpr,
			CompilerTypedFieldAccessExpr,
			CompilerTypedFloatLiteralExpr,
			CompilerTypedForExpr,
			CompilerTypedIfExpr,
			CompilerTypedIntLiteralExpr,
			CompilerTypedLambdaExpr,
			CompilerTypedListExpr,
			CompilerTypedLogicalExpr,
			CompilerTypedMatchExpr,
			CompilerTypedMissingExpr,
			CompilerTypedNameExpr,
			CompilerTypedOpaqueFromExpr,
			CompilerTypedOpaqueIntoExpr,
			CompilerTypedQuestionBindExpr,
			CompilerTypedRangeExpr,
			CompilerTypedRecordExpr,
			CompilerTypedRecordUpdateExpr,
			CompilerTypedSelectExpr,
			CompilerTypedStringInterpolationExpr,
			CompilerTypedStringInterpolationPartsExpr,
			CompilerTypedStringLiteralExpr,
			CompilerTypedSubscriptAssignExpr,
			CompilerTypedSubscriptExpr,
			CompilerTypedTupleDestructExpr,
			CompilerTypedTupleExpr,
			CompilerTypedUnaryExpr,
			CompilerTypedUnsupportedExpr,
			CompilerTypedVarDeclExpr,
			CompilerTypedVectorExpr,
			CompilerTypedVoidExpr,
			CompilerTypedWhileExpr,
			CompilerTypedWithExpr,
		),
		CompilerTypedExprInfo,
		CompilerTypedLambdaParam,
		CompilerTypedLoopView(
			CompilerTypedEnumerate2LoopView,
			CompilerTypedEnumerateLoopView,
			CompilerTypedIndicesLoopView,
			CompilerTypedWindowsLoopView,
		),
		CompilerTypedMatchCase,
		CompilerTypedPattern(
			CompilerTypedBoolPattern,
			CompilerTypedCharPattern,
			CompilerTypedConstructorPattern,
			CompilerTypedFloatPattern,
			CompilerTypedIntPattern,
			CompilerTypedListPattern,
			CompilerTypedNamePattern,
			CompilerTypedOrPattern,
			CompilerTypedQualifiedConstructorPattern,
			CompilerTypedStringPattern,
			CompilerTypedTuplePattern,
			CompilerTypedUnsupportedPattern,
			CompilerTypedWildcardPattern,
		),
		CompilerTypedRecordField,
		CompilerTypedSelectArm,
		CompilerTypedSelectArmKind(
			CompilerTypedSelectAfterArm,
			CompilerTypedSelectReceiveArm,
			CompilerTypedSelectSealedArm,
		),
		CompilerTypedStringInterpolationPart(
			CompilerTypedInterpolationExpr,
			CompilerTypedInterpolationLiteral,
		),
		CompilerTypedVarDeclPayload,
		CompilerTypedWithBinding,
		CompilerTypedWithErrorMap,
		compiler_typed_expr_info_semantic_type,
		compiler_typed_expr_info_value_type,
	compiler_typecheck_decl:
		CompilerTypedDecl(
			CompilerTypedFunctionDecl,
			CompilerTypedForeignFunctionDecl,
			CompilerTypedGlobalVarDecl,
			CompilerTypedImplDecl,
			CompilerTypedParsedDecl,
			CompilerTypedPrivateDecl,
			CompilerTypedRecordDecl,
			CompilerTypedTraitDecl,
			CompilerTypedTypeAliasDecl,
			CompilerTypedUnionDecl,
		),
		CompilerTypedForeignFunctionInfo,
		CompilerTypedForeignLinkFlag,
		CompilerTypedFunctionInfo,
		CompilerTypedGlobalVarInfo,
		CompilerTypedImplInfo,
		CompilerTypedProgram,
		CompilerTypedRecordFieldInfo,
		CompilerTypedRecordInfo,
		CompilerTypedTypeAliasInfo,
		CompilerTypedUnionInfo,
		CompilerTypedUnionVariantInfo,
		compiler_typed_foreign_link_platform_to_string,
	json:
		JsonValue(JsonBool, JsonNull, JsonNumber, JsonObject, JsonString, JsonVector),
		emit_json_chunks,


private KIND_FIELD: String = "kind"


private pure func typed_source_file_to_json(source: CompilerSourceFile) -> JsonValue:
	parsed_source_file_to_json(source)


private pure func typed_function_decl_to_json(decl: ParsedFunctionDecl) -> JsonValue:
	parsed_function_decl_to_json(decl)


private pure func typed_var_decl_to_json(decl: ParsedVarDecl) -> JsonValue:
	parsed_var_decl_to_json(decl)


private pure func typed_record_decl_to_json(decl: ParsedRecordDecl) -> JsonValue:
	parsed_record_decl_to_json(decl)


private pure func typed_type_alias_decl_to_json(decl: ParsedTypeAliasDecl) -> JsonValue:
	parsed_type_alias_decl_to_json(decl)


private pure func typed_union_decl_to_json(decl: ParsedUnionDecl) -> JsonValue:
	parsed_union_decl_to_json(decl)


private pure func typed_impl_decl_to_json(decl: ParsedImplDecl) -> JsonValue:
	parsed_impl_decl_to_json(decl)


private pure func typed_parsed_decl_to_json(decl: ParsedDecl) -> JsonValue:
	parsed_decl_to_json(decl)


private pure func json_int(value: Int) -> JsonValue:
	JsonNumber(to_float(value))


private pure func option_int_to_json(value: Option[Int]) -> JsonValue:
	match value:
		Some(n):
			json_int(n)
		None:
			JsonNull


private pure func parsed_binary_op_to_json(op: ParsedBinaryOp) -> JsonValue:
	match op:
		ParsedAddOp:
			JsonString("add")
		ParsedSubtractOp:
			JsonString("subtract")
		ParsedMultiplyOp:
			JsonString("multiply")
		ParsedDivideOp:
			JsonString("divide")
		ParsedModuloOp:
			JsonString("modulo")
		ParsedEqualOp:
			JsonString("equal")
		ParsedNotEqualOp:
			JsonString("not_equal")
		ParsedLessOp:
			JsonString("less")
		ParsedLessEqualOp:
			JsonString("less_equal")
		ParsedGreaterOp:
			JsonString("greater")
		ParsedGreaterEqualOp:
			JsonString("greater_equal")


pure func compiler_collection_kind_to_json(kind: CollectionKind) -> JsonValue:
	match kind:
		ListLiteral:
			JsonString("list")
		VectorLiteral:
			JsonString("vector")
		DictLiteral:
			JsonString("dict")
		SetLiteral:
			JsonString("set")


pure func compiler_widening_reason_to_json(reason: TypeWideningReason) -> JsonValue:
	match reason:
		MutableBinding:
			JsonObject([(KIND_FIELD, JsonString("mutable_binding"))])
		ArgumentSlot:
			JsonObject([(KIND_FIELD, JsonString("argument_slot"))])
		CollectionElement(kind):
			JsonObject([
				(KIND_FIELD, JsonString("collection_element")),
				("collection", compiler_collection_kind_to_json(kind)),
			])
		BitwiseOperator:
			JsonObject([(KIND_FIELD, JsonString("bitwise_operator"))])
		MethodReceiver:
			JsonObject([(KIND_FIELD, JsonString("method_receiver"))])
		RangeProofErasure:
			JsonObject([(KIND_FIELD, JsonString("range_proof_erasure"))])
		TupleLiteral:
			JsonObject([(KIND_FIELD, JsonString("tuple_literal"))])
		NumericOperator(op):
			JsonObject([
				(KIND_FIELD, JsonString("numeric_operator")),
				("op", parsed_binary_op_to_json(op)),
			])


pure func compiler_widening_decision_to_json(decision: TypeWideningDecision) -> JsonValue:
	match decision:
		TypeKeep(typ):
			JsonObject([
				(KIND_FIELD, JsonString("keep")),
				("type", compiler_type_to_json(typ)),
			])
		TypeWiden(from_type, to_type, reason):
			JsonObject([
				(KIND_FIELD, JsonString("widen")),
				("from_type", compiler_type_to_json(from_type)),
				("to_type", compiler_type_to_json(to_type)),
				("reason", compiler_widening_reason_to_json(reason)),
			])


pure func compiler_value_slot_to_json(slot: ValueSlot) -> JsonValue:
	JsonObject([
		("semantic_type", compiler_type_to_json(widening_semantic_type(slot))),
		("decision", compiler_widening_decision_to_json(widening_decision(slot))),
	])


pure func compiler_expr_type_origin_to_json(origin: CompilerExprTypeOrigin) -> JsonValue:
	match origin:
		CompilerInferredOrigin:
			JsonObject([(KIND_FIELD, JsonString("inferred"))])
		CompilerExplicitAnnotationOrigin(typ):
			JsonObject([
				(KIND_FIELD, JsonString("explicit_annotation")),
				("type", compiler_type_to_json(typ)),
			])
		CompilerSynthesizedOrigin(label):
			JsonObject([
				(KIND_FIELD, JsonString("synthesized")),
				("label", JsonString(label)),
			])


private pure func compiler_purity_to_json(purity: Purity) -> JsonValue:
	match purity:
		Pure:
			JsonString("pure")
		Impure:
			JsonString("impure")


private pure func compiler_resource_result_policy_to_json(
	policy: ResourceResultPolicy,
) -> JsonValue:
	match policy:
		ResourceResultDependent:
			JsonString("dependent")
		ResourceResultIndependent:
			JsonString("independent")
		ResourceResultOrdinary:
			JsonString("ordinary")


private pure func compiler_resource_arg_policy_to_json(policy: ResourceArgPolicy) -> JsonValue:
	match policy:
		RejectResourceArgs:
			JsonObject([(KIND_FIELD, JsonString("reject"))])
		AllowResourceArgs(result_policy):
			JsonObject([
				(KIND_FIELD, JsonString("allow")),
				("result_policy", compiler_resource_result_policy_to_json(result_policy)),
			])


private pure func compiler_dim_constraint_to_json(
	constraint: (CompilerType, CompilerType),
) -> JsonValue:
	JsonObject([
		("left", compiler_type_to_json(constraint[0])),
		("right", compiler_type_to_json(constraint[1])),
	])


private pure func compiler_callable_origin_to_json(origin: CompilerCallableOrigin) -> JsonValue:
	match origin:
		CompilerCallableLocal:
			JsonObject([(KIND_FIELD, JsonString("local"))])
		CompilerCallableImported(module_path):
			JsonObject([
				(KIND_FIELD, JsonString("imported")),
				("module", JsonString(module_path)),
			])
		CompilerCallableBuiltin:
			JsonObject([(KIND_FIELD, JsonString("builtin"))])
		CompilerCallableForeign:
			JsonObject([(KIND_FIELD, JsonString("foreign"))])
		CompilerCallableConstructor(parent_type):
			JsonObject([
				(KIND_FIELD, JsonString("constructor")),
				("parent_type", JsonString(parent_type)),
			])
		CompilerCallableImplMethod:
			JsonObject([(KIND_FIELD, JsonString("impl_method"))])


private pure func compiler_resolved_call_target_to_json(
	target: CompilerResolvedCallTarget,
) -> JsonValue:
	match target:
		CompilerResolvedDirectCall(callable_id, origin):
			JsonObject([
				(KIND_FIELD, JsonString("direct")),
				("callable_id", json_int(callable_id)),
				("origin", compiler_callable_origin_to_json(origin)),
			])
		CompilerResolvedTraitMethodCall(trait_name, impl_target):
			JsonObject([
				(KIND_FIELD, JsonString("trait_method")),
				("trait_name", JsonString(trait_name)),
				("impl_target", compiler_resolved_trait_method_target_to_json(impl_target)),
			])
		CompilerResolvedIntrinsicCall:
			JsonObject([(KIND_FIELD, JsonString("intrinsic"))])
		CompilerResolvedClosureCall:
			JsonObject([(KIND_FIELD, JsonString("closure"))])


private pure func compiler_resolved_trait_method_target_to_json(
	target: Option[ImplMethodTarget],
) -> JsonValue:
	match target:
		Some(value):
			JsonObject([
				("callable_id", json_int(value.callable_id)),
				("module_path", JsonString(value.module_path)),
			])
		None:
			JsonNull


pure func compiler_resolved_call_to_json(info: CompilerResolvedCallInfo) -> JsonValue:
	JsonObject([
		("callee_name", JsonString(info.callee_name)),
		("source_name", JsonString(info.source_name)),
		("purity", compiler_purity_to_json(info.purity)),
		("target", compiler_resolved_call_target_to_json(info.target)),
		("instantiated_params", compiler_type_list_to_json(info.instantiated_params)),
		("instantiated_return", compiler_type_to_json(info.instantiated_return)),
		("resource_args", compiler_resource_arg_policy_to_json(info.resource_args)),
		("dim_constraints", JsonVector(info.dim_constraints.map(compiler_dim_constraint_to_json))),
	])


private pure func optional_resolved_call_to_json(
	info: Option[CompilerResolvedCallInfo],
) -> JsonValue:
	match info:
		Some(value):
			compiler_resolved_call_to_json(value)
		None:
			JsonNull


private pure func collection_identity_to_json(identity: CompilerCollectionIdentity) -> JsonValue:
	JsonObject([("name", JsonString(compiler_collection_identity_name(identity)))])


private pure func dimension_identity_to_json(identity: CompilerDimensionIdentity) -> JsonValue:
	JsonObject([("name", JsonString(compiler_dimension_identity_name(identity)))])


private pure func proof_source_to_json(source: CompilerProofSource) -> JsonValue:
	match source:
		CompilerProofSourceUnknown:
			JsonString("unknown")
		CompilerProofSourceLoopRange:
			JsonString("loop_range")
		CompilerProofSourceLoopIndices:
			JsonString("loop_indices")
		CompilerProofSourceLoopEnumerate:
			JsonString("loop_enumerate")
		CompilerProofSourceCondition:
			JsonString("condition")
		CompilerProofSourceRangeTypeFallback:
			JsonString("range_type_fallback")


private pure func proven_collection_to_json(collection: CompilerProvenCollection) -> JsonValue:
	match collection:
		CompilerCollVar(identity):
			JsonObject([
				(KIND_FIELD, JsonString("var")),
				("identity", collection_identity_to_json(identity)),
			])
		CompilerCollSubscript(parent, identity):
			JsonObject([
				(KIND_FIELD, JsonString("subscript")),
				("parent", proven_collection_to_json(parent)),
				("identity", collection_identity_to_json(identity)),
			])
		CompilerCollDim(value):
			JsonObject([
				(KIND_FIELD, JsonString("dim")),
				("value", json_int(value)),
			])


private pure func range_upper_to_json(upper: CompilerRangeUpper) -> JsonValue:
	match upper:
		CompilerRangeUpperLit(value):
			JsonObject([
				(KIND_FIELD, JsonString("literal")),
				("value", json_int(value)),
			])
		CompilerRangeUpperDimension(identity):
			JsonObject([
				(KIND_FIELD, JsonString("dimension")),
				("identity", dimension_identity_to_json(identity)),
			])
		CompilerRangeUpperLengthMinus(identity, offset):
			JsonObject([
				(KIND_FIELD, JsonString("length_minus")),
				("identity", collection_identity_to_json(identity)),
				("offset", json_int(offset)),
			])
		CompilerRangeUpperAtMostLength(identity):
			JsonObject([
				(KIND_FIELD, JsonString("at_most_length")),
				("identity", collection_identity_to_json(identity)),
			])


private pure func range_proof_to_json(proof: CompilerRangeProof) -> JsonValue:
	JsonObject([
		("start", json_int(proof.range_start)),
		("upper", range_upper_to_json(proof.range_upper)),
		("source", proof_source_to_json(proof.range_source)),
	])


private pure func optional_range_proof_to_json(proof: Option[CompilerRangeProof]) -> JsonValue:
	match proof:
		Some(value):
			range_proof_to_json(value)
		None:
			JsonNull


private pure func subscript_proof_to_json(proof: CompilerSubscriptProof) -> JsonValue:
	JsonObject([
		("collection", proven_collection_to_json(proof.subscript_collection)),
		("source", proof_source_to_json(proof.subscript_source)),
	])


private pure func optional_subscript_proof_to_json(
	proof: Option[CompilerSubscriptProof],
) -> JsonValue:
	match proof:
		Some(value):
			subscript_proof_to_json(value)
		None:
			JsonNull


pure func compiler_value_proofs_to_json(proofs: CompilerValueProofs) -> JsonValue:
	JsonObject([
		("range", optional_range_proof_to_json(compiler_binding_range_proof(proofs))),
		("subscript", optional_subscript_proof_to_json(compiler_binding_subscript_proof(proofs))),
	])


pure func compiler_typed_expr_info_to_json(info: CompilerTypedExprInfo) -> JsonValue:
	JsonObject([
		("source_type", compiler_optional_type_to_json(info.source_type)),
		("semantic_type", compiler_type_to_json(compiler_typed_expr_info_semantic_type(info))),
		("value_type", compiler_type_to_json(compiler_typed_expr_info_value_type(info))),
		("origin", compiler_expr_type_origin_to_json(info.origin)),
		("value_slot", compiler_value_slot_to_json(info.value_slot)),
		("proofs", compiler_value_proofs_to_json(info.proofs)),
		("resolved_call", optional_resolved_call_to_json(info.resolved_call)),
		("resource_dependencies", JsonVector(info.resource_dependencies.map(
				func(item: String): JsonString(item),
			))),
	])


private pure func optional_string_to_json(value: Option[String]) -> JsonValue:
	match value:
		Some(text):
			JsonString(text)
		None:
			JsonNull


private pure func typed_expr_json(
	kind: String,
	span: CompilerSourceSpan,
	info: CompilerTypedExprInfo,
	fields: List[(String, JsonValue)],
) -> JsonValue:
	var result: List[(String, JsonValue)] = [
		(KIND_FIELD, JsonString(kind)),
		("span", parsed_source_span_to_json(span)),
		("info", compiler_typed_expr_info_to_json(info)),
	]

	for field in fields:
		result = result.append(field)

	JsonObject(result)


private pure func optional_typed_expr_to_json(expr: Option[CompilerTypedExpr]) -> JsonValue:
	match expr:
		Some(value):
			compiler_typed_expr_to_json(value)
		None:
			JsonNull


private pure func compiler_typed_loop_view_to_json(
	loop_view: Option[CompilerTypedLoopView],
	iterable: CompilerTypedExpr,
) -> JsonValue:
	match (loop_view, iterable):
		(Some(view), CompilerTypedCallExpr(_, args, _, _)):
			match (view, args.get(0)):
				(CompilerTypedIndicesLoopView(element_type), Some(source)):
					JsonObject([
						(KIND_FIELD, JsonString("indices")),
						("source", compiler_typed_expr_to_json(source)),
						("element_type", compiler_type_to_json(element_type)),
					])
				(CompilerTypedEnumerateLoopView(element_type), Some(source)):
					JsonObject([
						(KIND_FIELD, JsonString("enumerate")),
						("source", compiler_typed_expr_to_json(source)),
						("element_type", compiler_type_to_json(element_type)),
					])
				(CompilerTypedEnumerate2LoopView(element_type), Some(source)):
					JsonObject([
						(KIND_FIELD, JsonString("enumerate2")),
						("source", compiler_typed_expr_to_json(source)),
						("element_type", compiler_type_to_json(element_type)),
					])
				(CompilerTypedWindowsLoopView(size, element_type), Some(source)):
					match args.get(1):
						Some(size_arg):
							JsonObject([
								(KIND_FIELD, JsonString("windows")),
								("source", compiler_typed_expr_to_json(source)),
								("size_arg", compiler_typed_expr_to_json(size_arg)),
								("size", json_int(size)),
								("element_type", compiler_type_to_json(element_type)),
							])
						None:
							JsonNull
				_:
					JsonNull
		_:
			JsonNull


private pure func identifiers_to_json(items: List[ParsedIdentifier]) -> JsonValue:
	JsonVector(items.map(parsed_identifier_to_json))


private pure func parsed_unary_op_to_json(op: ParsedUnaryOp) -> JsonValue:
	match op:
		ParsedNegateOp:
			JsonString("negate")
		ParsedNotOp:
			JsonString("not")


private pure func parsed_logical_op_to_json(op: ParsedLogicalOp) -> JsonValue:
	match op:
		ParsedAndOp:
			JsonString("and")
		ParsedOrOp:
			JsonString("or")


private pure func parsed_for_binder_to_json(binder: ParsedForBinder) -> JsonValue:
	match binder:
		ParsedForNameBinder(name):
			JsonObject([
				(KIND_FIELD, JsonString("name")),
				("name", parsed_identifier_to_json(name)),
			])
		ParsedForTupleBinder(names, span):
			JsonObject([
				(KIND_FIELD, JsonString("tuple")),
				("names", identifiers_to_json(names)),
				("span", parsed_source_span_to_json(span)),
			])


private pure func parsed_list_pattern_spread_to_json(spread: ParsedListPatternSpread) -> JsonValue:
	match spread:
		ParsedListSpreadName(name):
			JsonObject([
				(KIND_FIELD, JsonString("name")),
				("name", parsed_identifier_to_json(name)),
			])
		ParsedListSpreadWildcard(span):
			JsonObject([
				(KIND_FIELD, JsonString("wildcard")),
				("span", parsed_source_span_to_json(span)),
			])


private pure func optional_list_pattern_spread_to_json(
	spread: Option[ParsedListPatternSpread],
) -> JsonValue:
	match spread:
		Some(value):
			parsed_list_pattern_spread_to_json(value)
		None:
			JsonNull


private pure func typed_patterns_to_json(patterns: List[CompilerTypedPattern]) -> JsonValue:
	JsonVector(patterns.map(compiler_typed_pattern_to_json))


pure func compiler_typed_pattern_to_json(pattern: CompilerTypedPattern) -> JsonValue:
	match pattern:
		CompilerTypedWildcardPattern(span):
			JsonObject([
				(KIND_FIELD, JsonString("wildcard")),
				("span", parsed_source_span_to_json(span)),
			])
		CompilerTypedNamePattern(name, typ):
			JsonObject([
				(KIND_FIELD, JsonString("name")),
				("name", parsed_identifier_to_json(name)),
				("type", compiler_type_to_json(typ)),
			])
		CompilerTypedBoolPattern(value, span):
			JsonObject([
				(KIND_FIELD, JsonString("bool")),
				("value", JsonBool(value)),
				("span", parsed_source_span_to_json(span)),
			])
		CompilerTypedIntPattern(value, span):
			JsonObject([
				(KIND_FIELD, JsonString("int")),
				("value", JsonString(value)),
				("span", parsed_source_span_to_json(span)),
			])
		CompilerTypedFloatPattern(value, span):
			JsonObject([
				(KIND_FIELD, JsonString("float")),
				("value", JsonString(value)),
				("span", parsed_source_span_to_json(span)),
			])
		CompilerTypedStringPattern(value, span):
			JsonObject([
				(KIND_FIELD, JsonString("string")),
				("value", JsonString(value)),
				("span", parsed_source_span_to_json(span)),
			])
		CompilerTypedCharPattern(value, span):
			JsonObject([
				(KIND_FIELD, JsonString("char")),
				("value", json_int(value)),
				("span", parsed_source_span_to_json(span)),
			])
		CompilerTypedConstructorPattern(name, args, span):
			JsonObject([
				(KIND_FIELD, JsonString("constructor")),
				("name", parsed_identifier_to_json(name)),
				("args", typed_patterns_to_json(args)),
				("span", parsed_source_span_to_json(span)),
			])
		CompilerTypedQualifiedConstructorPattern(module_name, name, args, span):
			JsonObject([
				(KIND_FIELD, JsonString("qualified_constructor")),
				("module", parsed_identifier_to_json(module_name)),
				("name", parsed_identifier_to_json(name)),
				("args", typed_patterns_to_json(args)),
				("span", parsed_source_span_to_json(span)),
			])
		CompilerTypedTuplePattern(items, span):
			JsonObject([
				(KIND_FIELD, JsonString("tuple")),
				("items", typed_patterns_to_json(items)),
				("span", parsed_source_span_to_json(span)),
			])
		CompilerTypedListPattern(items, spread, span):
			JsonObject([
				(KIND_FIELD, JsonString("list")),
				("items", typed_patterns_to_json(items)),
				("spread", optional_list_pattern_spread_to_json(spread)),
				("span", parsed_source_span_to_json(span)),
			])
		CompilerTypedOrPattern(items, span):
			JsonObject([
				(KIND_FIELD, JsonString("or")),
				("items", typed_patterns_to_json(items)),
				("span", parsed_source_span_to_json(span)),
			])
		CompilerTypedUnsupportedPattern(label, span):
			JsonObject([
				(KIND_FIELD, JsonString("unsupported")),
				("label", JsonString(label)),
				("span", parsed_source_span_to_json(span)),
			])


private pure func typed_match_case_to_json(case: CompilerTypedMatchCase) -> JsonValue:
	JsonObject([
		("pattern", compiler_typed_pattern_to_json(case.pattern)),
		("body", compiler_typed_expr_to_json(case.body)),
		("span", parsed_source_span_to_json(case.span)),
	])


private pure func typed_dict_entry_to_json(entry: CompilerTypedDictEntry) -> JsonValue:
	JsonObject([
		("key", compiler_typed_expr_to_json(entry.key)),
		("value", compiler_typed_expr_to_json(entry.value)),
	])


private pure func typed_record_field_to_json(field: CompilerTypedRecordField) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(field.name)),
		("value", compiler_typed_expr_to_json(field.value)),
		("span", parsed_source_span_to_json(field.span)),
	])


private pure func typed_record_fields_to_json(fields: List[CompilerTypedRecordField]) -> JsonValue:
	JsonVector(fields.map(typed_record_field_to_json))


private pure func typed_lambda_param_to_json(param: CompilerTypedLambdaParam) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(param.name)),
		("source_type", compiler_optional_type_to_json(param.source_type)),
		("param_type", compiler_type_to_json(param.param_type)),
	])


private pure func typed_select_arm_kind_to_json(kind: CompilerTypedSelectArmKind) -> JsonValue:
	match kind:
		CompilerTypedSelectReceiveArm(name, elem_type, channel):
			JsonObject([
				(KIND_FIELD, JsonString("receive")),
				("name", parsed_identifier_to_json(name)),
				("elem_type", compiler_type_to_json(elem_type)),
				("channel", compiler_typed_expr_to_json(channel)),
			])
		CompilerTypedSelectSealedArm(elem_type, channel):
			JsonObject([
				(KIND_FIELD, JsonString("sealed")),
				("elem_type", compiler_type_to_json(elem_type)),
				("channel", compiler_typed_expr_to_json(channel)),
			])
		CompilerTypedSelectAfterArm(timeout):
			JsonObject([
				(KIND_FIELD, JsonString("after")),
				("timeout", compiler_typed_expr_to_json(timeout)),
			])


private pure func typed_select_arm_to_json(arm: CompilerTypedSelectArm) -> JsonValue:
	JsonObject([
		("kind", typed_select_arm_kind_to_json(arm.kind)),
		("body", compiler_typed_expr_to_json(arm.body)),
		("span", parsed_source_span_to_json(arm.span)),
	])


private pure func typed_assign_scope_to_json(scope: CompilerTypedAssignScope) -> JsonValue:
	match scope:
		CompilerLocalAssignScope:
			JsonString("local")
		CompilerModuleAssignScope:
			JsonString("module")


private pure func typed_assign_target_to_json(target: CompilerTypedAssignTarget) -> JsonValue:
	JsonObject([
		("name", JsonString(target.name)),
		("scope", typed_assign_scope_to_json(target.scope)),
	])


private pure func optional_typed_assign_target_to_json(
	target: Option[CompilerTypedAssignTarget],
) -> JsonValue:
	match target:
		Some(value):
			typed_assign_target_to_json(value)
		None:
			JsonNull


private pure func typed_concurrent_param_to_json(param: CompilerTypedConcurrentParam) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(param.name)),
		("value", compiler_typed_expr_to_json(param.value)),
		("span", parsed_source_span_to_json(param.span)),
	])


private pure func typed_concurrent_params_to_json(
	params: List[CompilerTypedConcurrentParam],
) -> JsonValue:
	JsonVector(params.map(typed_concurrent_param_to_json))


private pure func typed_concurrent_binding_to_json(
	binding: CompilerTypedConcurrentBinding,
) -> JsonValue:
	typed_expr_json(
		"concurrent_bind",
		binding.span,
		binding.info,
		[
			("name", parsed_identifier_to_json(binding.name)),
			("annotation", compiler_optional_type_to_json(binding.annotation)),
			("value", compiler_typed_expr_to_json(binding.value)),
		],
	)


private pure func typed_concurrent_bindings_to_json(
	bindings: List[CompilerTypedConcurrentBinding],
) -> JsonValue:
	JsonVector(bindings.map(typed_concurrent_binding_to_json))


private pure func typed_with_binding_kind_to_json(kind: ParsedWithBindingKind) -> JsonValue:
	match kind:
		ParsedWithPlainBinding:
			JsonString("plain")
		ParsedWithTryBinding:
			JsonString("try")


private pure func typed_with_error_map_to_json(error_map: CompilerTypedWithErrorMap) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(error_map.name)),
		("value", compiler_typed_expr_to_json(error_map.value)),
		("span", parsed_source_span_to_json(error_map.span)),
	])


private pure func optional_typed_with_error_map_to_json(
	error_map: Option[CompilerTypedWithErrorMap],
) -> JsonValue:
	match error_map:
		Some(value):
			typed_with_error_map_to_json(value)
		None:
			JsonNull


private pure func typed_with_binding_to_json(binding: CompilerTypedWithBinding) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(binding.name)),
		("annotation", compiler_optional_type_to_json(binding.annotation)),
		("value", compiler_typed_expr_to_json(binding.value)),
		("kind", typed_with_binding_kind_to_json(binding.kind)),
		("error_map", optional_typed_with_error_map_to_json(binding.error_map)),
		("cleanup_function", optional_string_to_json(binding.cleanup_function)),
		("span", parsed_source_span_to_json(binding.span)),
	])


private pure func typed_string_interpolation_part_to_json(
	part: CompilerTypedStringInterpolationPart,
) -> JsonValue:
	match part:
		CompilerTypedInterpolationLiteral(text):
			JsonObject([
				(KIND_FIELD, JsonString("literal")),
				("text", JsonString(text)),
			])
		CompilerTypedInterpolationExpr(expr):
			JsonObject([
				(KIND_FIELD, JsonString("expr")),
				("expr", compiler_typed_expr_to_json(expr)),
			])


private pure func typed_var_decl_payload_to_json(payload: CompilerTypedVarDeclPayload) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(payload.name)),
		("annotation", compiler_optional_type_to_json(payload.annotation)),
		("initializer", compiler_typed_expr_to_json(payload.initializer)),
		("is_mutable", JsonBool(payload.is_mutable)),
		("span", parsed_source_span_to_json(payload.span)),
	])


private pure func typed_for_expr_to_json(
	binder: ParsedForBinder,
	iterable: CompilerTypedExpr,
	loop_view: Option[CompilerTypedLoopView],
	body: CompilerTypedExpr,
	span: CompilerSourceSpan,
	info: CompilerTypedExprInfo,
) -> JsonValue:
	typed_expr_json(
		"for",
		span,
		info,
		[
			("binder", parsed_for_binder_to_json(binder)),
			("iterable", compiler_typed_expr_to_json(iterable)),
			("loop_view", compiler_typed_loop_view_to_json(loop_view, iterable)),
			("body", compiler_typed_expr_to_json(body)),
		],
	)


private pure func typed_concurrent_for_expr_to_json(
	name: ParsedIdentifier,
	iterable: CompilerTypedExpr,
	params: List[CompilerTypedConcurrentParam],
	body: CompilerTypedExpr,
	span: CompilerSourceSpan,
	info: CompilerTypedExprInfo,
) -> JsonValue:
	typed_expr_json(
		"concurrent_for",
		span,
		info,
		[
			("name", parsed_identifier_to_json(name)),
			("iterable", compiler_typed_expr_to_json(iterable)),
			("params", typed_concurrent_params_to_json(params)),
			("body", compiler_typed_expr_to_json(body)),
		],
	)


pure func compiler_typed_expr_to_json(expr: CompilerTypedExpr) -> JsonValue:
	match expr:
		CompilerTypedNameExpr(name, info):
			JsonObject([
				(KIND_FIELD, JsonString("name")),
				("name", parsed_identifier_to_json(name)),
				("info", compiler_typed_expr_info_to_json(info)),
			])
		CompilerTypedIntLiteralExpr(value, span, info):
			typed_expr_json("int_literal", span, info, [("value", JsonString(value))])
		CompilerTypedFloatLiteralExpr(value, span, info):
			typed_expr_json("float_literal", span, info, [("value", JsonString(value))])
		CompilerTypedStringLiteralExpr(value, span, info):
			typed_expr_json("string_literal", span, info, [("value", JsonString(value))])
		CompilerTypedStringInterpolationExpr(value, raw, span, info):
			typed_expr_json(
				"string_interpolation_raw",
				span,
				info,
				[("value", JsonString(value)), ("raw", JsonBool(raw))],
			)
		CompilerTypedStringInterpolationPartsExpr(parts, multiline, span, info):
			typed_expr_json(
				"string_interpolation",
				span,
				info,
				[
					("parts", JsonVector(parts.map(typed_string_interpolation_part_to_json))),
					("multiline", JsonBool(multiline)),
				],
			)
		CompilerTypedBoolLiteralExpr(value, span, info):
			typed_expr_json("bool_literal", span, info, [("value", JsonBool(value))])
		CompilerTypedCharLiteralExpr(value, span, info):
			typed_expr_json("char_literal", span, info, [("value", json_int(value))])
		CompilerTypedUnaryExpr(op, inner, span, info):
			typed_expr_json(
				"unary",
				span,
				info,
				[
					("op", parsed_unary_op_to_json(op)),
					("inner", compiler_typed_expr_to_json(inner)),
				],
			)
		CompilerTypedBinaryExpr(op, left, right, span, info):
			typed_expr_json(
				"binary",
				span,
				info,
				[
					("op", parsed_binary_op_to_json(op)),
					("left", compiler_typed_expr_to_json(left)),
					("right", compiler_typed_expr_to_json(right)),
				],
			)
		CompilerTypedLogicalExpr(op, left, right, span, info):
			typed_expr_json(
				"logical",
				span,
				info,
				[
					("op", parsed_logical_op_to_json(op)),
					("left", compiler_typed_expr_to_json(left)),
					("right", compiler_typed_expr_to_json(right)),
				],
			)
		CompilerTypedCallExpr(callee, args, span, info):
			typed_expr_json(
				"call",
				span,
				info,
				[
					("callee", compiler_typed_expr_to_json(callee)),
					("args", JsonVector(args.map(compiler_typed_expr_to_json))),
				],
			)
		CompilerTypedTupleExpr(items, span, info):
			typed_expr_json(
				"tuple",
				span,
				info,
				[("items", JsonVector(items.map(compiler_typed_expr_to_json)))],
			)
		CompilerTypedTupleDestructExpr(names, value, span, info):
			typed_expr_json(
				"tuple_destruct",
				span,
				info,
				[
					("names", identifiers_to_json(names)),
					("value", compiler_typed_expr_to_json(value)),
				],
			)
		CompilerTypedAssignExpr(name, scope, value, span, info):
			typed_expr_json(
				"assign",
				span,
				info,
				[
					("name", parsed_identifier_to_json(name)),
					("scope", typed_assign_scope_to_json(scope)),
					("value", compiler_typed_expr_to_json(value)),
				],
			)
		CompilerTypedSubscriptExpr(receiver, indices, span, info):
			typed_expr_json(
				"subscript",
				span,
				info,
				[
					("receiver", compiler_typed_expr_to_json(receiver)),
					("indices", JsonVector(indices.map(compiler_typed_expr_to_json))),
				],
			)
		CompilerTypedSubscriptAssignExpr(target, receiver, indices, value, span, info):
			typed_expr_json(
				"subscript_assign",
				span,
				info,
				[
					("target", optional_typed_assign_target_to_json(target)),
					("receiver", compiler_typed_expr_to_json(receiver)),
					("indices", JsonVector(indices.map(compiler_typed_expr_to_json))),
					("value", compiler_typed_expr_to_json(value)),
				],
			)
		CompilerTypedListExpr(items, span, info):
			typed_expr_json(
				"list",
				span,
				info,
				[("items", JsonVector(items.map(compiler_typed_expr_to_json)))],
			)
		CompilerTypedVectorExpr(items, span, info):
			typed_expr_json(
				"vector",
				span,
				info,
				[("items", JsonVector(items.map(compiler_typed_expr_to_json)))],
			)
		CompilerTypedDictExpr(entries, span, info):
			typed_expr_json(
				"dict",
				span,
				info,
				[("entries", JsonVector(entries.map(typed_dict_entry_to_json)))],
			)
		CompilerTypedOpaqueIntoExpr(target_type, inner, span, info):
			typed_expr_json(
				"opaque_into",
				span,
				info,
				[
					("target_type", compiler_type_to_json(target_type)),
					("inner", compiler_typed_expr_to_json(inner)),
				],
			)
		CompilerTypedOpaqueFromExpr(source_type, inner, span, info):
			typed_expr_json(
				"opaque_from",
				span,
				info,
				[
					("source_type", compiler_type_to_json(source_type)),
					("inner", compiler_typed_expr_to_json(inner)),
				],
			)
		CompilerTypedRecordExpr(fields, span, info):
			typed_expr_json("record", span, info, [("fields", typed_record_fields_to_json(fields))])
		CompilerTypedRecordUpdateExpr(receiver, fields, _, span, info):
			typed_expr_json(
				"record_update",
				span,
				info,
				[
					("receiver", compiler_typed_expr_to_json(receiver)),
					("fields", typed_record_fields_to_json(fields)),
				],
			)
		CompilerTypedFieldAccessExpr(receiver, field, span, info):
			typed_expr_json(
				"field_access",
				span,
				info,
				[
					("receiver", compiler_typed_expr_to_json(receiver)),
					("field", parsed_identifier_to_json(field)),
				],
			)
		CompilerTypedLambdaExpr(is_pure, params, return_annotation, body, span, info):
			typed_expr_json(
				"lambda",
				span,
				info,
				[
					("is_pure", JsonBool(is_pure)),
					("params", JsonVector(params.map(typed_lambda_param_to_json))),
					("return_annotation", compiler_optional_type_to_json(return_annotation)),
					("body", compiler_typed_expr_to_json(body)),
				],
			)
		CompilerTypedRangeExpr(start_expr, end_expr, span, info):
			typed_expr_json(
				"range",
				span,
				info,
				[
					("start", compiler_typed_expr_to_json(start_expr)),
					("end", compiler_typed_expr_to_json(end_expr)),
				],
			)
		CompilerTypedIfExpr(condition, then_branch, else_branch, span, info):
			typed_expr_json(
				"if",
				span,
				info,
				[
					("condition", compiler_typed_expr_to_json(condition)),
					("then", compiler_typed_expr_to_json(then_branch)),
					("else", optional_typed_expr_to_json(else_branch)),
				],
			)
		CompilerTypedMatchExpr(scrutinee, cases, span, info):
			typed_expr_json(
				"match",
				span,
				info,
				[
					("scrutinee", compiler_typed_expr_to_json(scrutinee)),
					("cases", JsonVector(cases.map(typed_match_case_to_json))),
				],
			)
		CompilerTypedSelectExpr(arms, span, info):
			typed_expr_json(
				"select",
				span,
				info,
				[("arms", JsonVector(arms.map(typed_select_arm_to_json)))],
			)
		CompilerTypedWhileExpr(condition, body, span, info):
			typed_expr_json(
				"while",
				span,
				info,
				[
					("condition", compiler_typed_expr_to_json(condition)),
					("body", compiler_typed_expr_to_json(body)),
				],
			)
		CompilerTypedForExpr(binder, iterable, loop_view, body, span, info):
			match (binder, body):
				(ParsedForNameBinder(item_name), CompilerTypedWithExpr(binding, scoped_body, _, _)):
					match binding.resource_loop_item_name:
						Some(resource_item_name):
							if resource_item_name == item_name.text:
								typed_expr_json(
									"for",
									span,
									info,
									[
										(
											"binder",
											parsed_for_binder_to_json(
												ParsedForNameBinder(binding.name),
											),
										),
										("iterable", compiler_typed_expr_to_json(iterable)),
										(
											"loop_view",
											compiler_typed_loop_view_to_json(loop_view, iterable),
										),
										("body", compiler_typed_expr_to_json(scoped_body)),
									],
								)
							else:
								typed_for_expr_to_json(
									binder,
									iterable,
									loop_view,
									body,
									span,
									info,
								)
						None:
							typed_for_expr_to_json(binder, iterable, loop_view, body, span, info)
				_:
					typed_for_expr_to_json(binder, iterable, loop_view, body, span, info)
		CompilerTypedConcurrentBlockExpr(params, bindings, span, info):
			typed_expr_json(
				"concurrent_block",
				span,
				info,
				[
					("params", typed_concurrent_params_to_json(params)),
					("bindings", typed_concurrent_bindings_to_json(bindings)),
				],
			)
		CompilerTypedConcurrentForExpr(name, iterable, params, body, span, info):
			match body:
				CompilerTypedWithExpr(binding, scoped_body, _, _):
					match binding.resource_loop_item_name:
						Some(resource_item_name):
							if resource_item_name == name.text:
								typed_concurrent_for_expr_to_json(
									binding.name,
									iterable,
									params,
									scoped_body,
									span,
									info,
								)
							else:
								typed_concurrent_for_expr_to_json(
									name,
									iterable,
									params,
									body,
									span,
									info,
								)
						None:
							typed_concurrent_for_expr_to_json(
								name,
								iterable,
								params,
								body,
								span,
								info,
							)
				_:
					typed_concurrent_for_expr_to_json(name, iterable, params, body, span, info)
		CompilerTypedDetachExpr(body, span, info):
			typed_expr_json("detach", span, info, [("body", compiler_typed_expr_to_json(body))])
		CompilerTypedAscriptionExpr(inner, target_type, span, info):
			typed_expr_json(
				"ascription",
				span,
				info,
				[
					("inner", compiler_typed_expr_to_json(inner)),
					("target_type", compiler_type_to_json(target_type)),
				],
			)
		CompilerTypedBlockExpr(items, span, info):
			typed_expr_json(
				"block",
				span,
				info,
				[("items", JsonVector(items.map(compiler_typed_expr_to_json)))],
			)
		CompilerTypedWithExpr(binding, body, span, info):
			typed_expr_json(
				"with",
				span,
				info,
				[
					("binding", typed_with_binding_to_json(binding)),
					("body", compiler_typed_expr_to_json(body)),
				],
			)
		CompilerTypedDebugBlockExpr(body, span, info):
			typed_expr_json(
				"debug_block",
				span,
				info,
				[("body", compiler_typed_expr_to_json(body))],
			)
		CompilerTypedVarDeclExpr(payload, info):
			typed_expr_json(
				"var_decl",
				payload.span,
				info,
				[("payload", typed_var_decl_payload_to_json(payload))],
			)
		CompilerTypedQuestionBindExpr(name, annotation, value, span, info):
			typed_expr_json(
				"question_bind",
				span,
				info,
				[
					("name", parsed_identifier_to_json(name)),
					("annotation", compiler_optional_type_to_json(annotation)),
					("value", compiler_typed_expr_to_json(value)),
				],
			)
		CompilerTypedBreakExpr(span, info):
			typed_expr_json("break", span, info, [])
		CompilerTypedContinueExpr(span, info):
			typed_expr_json("continue", span, info, [])
		CompilerTypedVoidExpr(span, info):
			typed_expr_json("void", span, info, [])
		CompilerTypedBuiltinExpr(name, span, info):
			typed_expr_json("builtin", span, info, [("name", optional_string_to_json(name))])
		CompilerTypedMissingExpr(span, info):
			typed_expr_json("missing", span, info, [])
		CompilerTypedUnsupportedExpr(label, span, info):
			typed_expr_json("unsupported", span, info, [("label", JsonString(label))])


private pure func optional_typed_body_to_json(body: Option[CompilerTypedExpr]) -> JsonValue:
	optional_typed_expr_to_json(body)


private pure func compiler_bound_type_param_to_json(param: BoundTypeParam) -> JsonValue:
	JsonObject([
		("name", JsonString(param.name)),
		("bounds", JsonVector(param.bounds.map(
				func(bound): JsonString(bound),
			))),
	])


pure func compiler_typed_function_info_to_json(info: CompilerTypedFunctionInfo) -> JsonValue:
	JsonObject([
		("decl", typed_function_decl_to_json(info.decl)),
		("callable_id", option_int_to_json(info.callable_id)),
		(
			"effective_type_params",
			JsonVector(info.effective_type_params.map(compiler_bound_type_param_to_json)),
		),
		("param_types", compiler_type_list_to_json(info.param_types)),
		("source_return_type", compiler_optional_type_to_json(info.source_return_type)),
		("semantic_return_type", compiler_type_to_json(info.semantic_return_type)),
		("body", optional_typed_body_to_json(info.body)),
	])


private pure func compiler_typed_foreign_link_arg_name(
	link_flag: CompilerTypedForeignLinkFlag,
) -> String:
	match link_flag.platform:
		None:
			"link"
		Some(platform):
			"link_" + compiler_typed_foreign_link_platform_to_string(platform)


private pure func compiler_typed_foreign_function_to_bridge_json(
	info: CompilerTypedForeignFunctionInfo,
) -> JsonValue:
	include_args: List[ParsedForeignBlockArg] = info.includes.map(
		func(include_path: String) -> ParsedForeignBlockArg: {
			name = {
				text = "include",
				span = info.block_span
			},
			value = include_path,
			span = info.block_span
		},
	)
	link_args: List[ParsedForeignBlockArg] = info.link_flags.map(
		func(link_flag: CompilerTypedForeignLinkFlag) -> ParsedForeignBlockArg: {
			name = {
				text = compiler_typed_foreign_link_arg_name(link_flag),
				span = info.block_span
			},
			value = link_flag.flag,
			span = info.block_span
		},
	)

	JsonObject([
		(KIND_FIELD, JsonString("parsed")),
		(
			"decl",
			typed_parsed_decl_to_json(
				ForeignBlockParsedDecl(
					include_args.concat(link_args),
					[info.decl],
					info.block_span,
				),
			),
		),
	])


pure func compiler_typed_global_var_info_to_json(info: CompilerTypedGlobalVarInfo) -> JsonValue:
	JsonObject([
		("decl", typed_var_decl_to_json(info.decl)),
		("binding_type", compiler_type_to_json(info.binding_type)),
		("source_type", compiler_optional_type_to_json(info.source_type)),
		("value", compiler_typed_expr_to_json(info.value)),
	])


pure func compiler_typed_record_field_info_to_json(info: CompilerTypedRecordFieldInfo) -> JsonValue:
	JsonObject([
		("name", JsonString(info.name)),
		("source_type", compiler_type_to_json(info.source_type)),
		("semantic_type", compiler_type_to_json(info.semantic_type)),
	])


pure func compiler_typed_record_info_to_json(info: CompilerTypedRecordInfo) -> JsonValue:
	JsonObject([
		("decl", typed_record_decl_to_json(info.decl)),
		("fields", JsonVector(info.fields.map(compiler_typed_record_field_info_to_json))),
	])


pure func compiler_typed_type_alias_info_to_json(info: CompilerTypedTypeAliasInfo) -> JsonValue:
	JsonObject([
		("decl", typed_type_alias_decl_to_json(info.decl)),
		("source_target_type", compiler_type_to_json(info.source_target_type)),
		("semantic_target_type", compiler_type_to_json(info.semantic_target_type)),
	])


pure func compiler_typed_union_variant_info_to_json(
	info: CompilerTypedUnionVariantInfo,
) -> JsonValue:
	JsonObject([
		("name", JsonString(info.name)),
		("fields", compiler_type_list_to_json(info.fields)),
		("tag", json_int(info.tag)),
		("def_id", option_int_to_json(info.def_id)),
	])


pure func compiler_typed_union_info_to_json(info: CompilerTypedUnionInfo) -> JsonValue:
	JsonObject([
		("decl", typed_union_decl_to_json(info.decl)),
		("variants", JsonVector(info.variants.map(compiler_typed_union_variant_info_to_json))),
	])


pure func compiler_typed_impl_info_to_json(info: CompilerTypedImplInfo) -> JsonValue:
	JsonObject([
		("decl", typed_impl_decl_to_json(info.decl)),
		("for_type", compiler_type_to_json(info.for_type)),
		("type_params", JsonVector(info.type_params.map(compiler_bound_type_param_to_json))),
		("methods", JsonVector(info.methods.map(compiler_typed_function_info_to_json))),
	])


pure func compiler_typed_decl_to_json(decl: CompilerTypedDecl) -> JsonValue:
	match decl:
		CompilerTypedFunctionDecl(info):
			JsonObject([
				(KIND_FIELD, JsonString("function")),
				("info", compiler_typed_function_info_to_json(info)),
			])
		CompilerTypedForeignFunctionDecl(info):
			compiler_typed_foreign_function_to_bridge_json(info)
		CompilerTypedGlobalVarDecl(info):
			JsonObject([
				(KIND_FIELD, JsonString("global_var")),
				("info", compiler_typed_global_var_info_to_json(info)),
			])
		CompilerTypedRecordDecl(info):
			JsonObject([
				(KIND_FIELD, JsonString("record")),
				("info", compiler_typed_record_info_to_json(info)),
			])
		CompilerTypedTypeAliasDecl(info):
			JsonObject([
				(KIND_FIELD, JsonString("type_alias")),
				("info", compiler_typed_type_alias_info_to_json(info)),
			])
		CompilerTypedTraitDecl(info):
			-- OCaml still models trait signatures as DeclOther. Preserve the
			-- temporary bridge shape while Blorp consumes the typed payload directly.
			JsonObject([
				(KIND_FIELD, JsonString("parsed")),
				("decl", typed_parsed_decl_to_json(TraitParsedDecl(info.decl))),
			])
		CompilerTypedUnionDecl(info):
			JsonObject([
				(KIND_FIELD, JsonString("union")),
				("info", compiler_typed_union_info_to_json(info)),
			])
		CompilerTypedImplDecl(info):
			JsonObject([
				(KIND_FIELD, JsonString("impl")),
				("info", compiler_typed_impl_info_to_json(info)),
			])
		CompilerTypedPrivateDecl(inner):
			JsonObject([
				(KIND_FIELD, JsonString("private")),
				("inner", compiler_typed_decl_to_json(inner)),
			])
		CompilerTypedParsedDecl(parsed):
			JsonObject([
				(KIND_FIELD, JsonString("parsed")),
				("decl", typed_parsed_decl_to_json(parsed)),
			])


pure func compiler_typed_program_to_json(program: CompilerTypedProgram) -> JsonValue:
	JsonObject([
		(KIND_FIELD, JsonString("typed_program")),
		("source", typed_source_file_to_json(program.source)),
		("decls", JsonVector(program.decls.map(compiler_typed_decl_to_json))),
		("diagnostics", JsonVector(program.diagnostics.map(parse_diagnostic_to_json))),
	])


---
Emit the typed-program bridge shape one declaration at a time. This keeps the
schema owned by the existing declaration encoders while avoiding a second
program-sized JsonValue tree.
---
func emit_compiler_typed_program_json_chunks(
	program: CompilerTypedProgram,
	emit: (String) -> Void,
) -> Void:
	emit("{\"kind\":\"typed_program\",\"source\":")
	emit_json_chunks(typed_source_file_to_json(program.source), emit)
	emit(",\"decls\":[")
	var first: Bool = True

	for decl in program.decls:
		if first:
			first = False
		else:
			emit(",")

		emit_json_chunks(compiler_typed_decl_to_json(decl), emit)

	emit("],\"diagnostics\":[")
	first = True

	for diagnostic in program.diagnostics:
		if first:
			first = False
		else:
			emit(",")

		emit_json_chunks(parse_diagnostic_to_json(diagnostic), emit)

	emit("]}")
