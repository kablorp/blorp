-- Module selection and dependency visibility for Blorp-owned typechecking.
--
-- This module decides which already-prepared modules are directly imported or
-- transitively visible. It does not register semantic declarations or mutate
-- a typechecking environment.
import:
	../../stage_03_parse/compiler_parsed_ast:
		ParsedDecl(ImportBlockParsedDecl, PrivateParsedDecl),
		ParsedProgram,
	compiler_module_binding:
		CompilerImportableModule,
		CompilerImportableModuleSurface,
		compiler_importable_module_decls,
		compiler_importable_module_identity_matches_request,
		compiler_importable_module_origin,
		compiler_importable_module_path,
		compiler_importable_module_surface_value,
		compiler_importable_module_to_surface,


private COMPILER_AMBIENT_TUPLE_IMPL_MODULE_PATH: String = "std/tuple"


union CompilerImportIdentityResolution:
	CompilerImportIdentityMissing
	CompilerImportIdentityFound(String)
	CompilerImportIdentityAmbiguous(List[String])


pure func compiler_importable_module_surfaces(
	modules: List[CompilerImportableModule],
) -> List[CompilerImportableModuleSurface]:
	modules.map(compiler_importable_module_to_surface)


private pure func compiler_import_module_matches_request(
	module: CompilerImportableModule,
	requested_path: String,
) -> Bool:
	compiler_importable_module_identity_matches_request(
		compiler_importable_module_path(module),
		compiler_importable_module_origin(module),
		compiler_importable_module_surface_value(module).module_name,
		requested_path,
	)


pure func compiler_resolve_import_identity(
	modules: List[CompilerImportableModule],
	requested_path: String,
) -> CompilerImportIdentityResolution:
	var exact_match: Option[String] = None
	var alias_matches: List[String] = []

	for module in modules:
		module_path = compiler_importable_module_path(module)

		if module_path == requested_path:
			exact_match = Some(module_path)
		else if compiler_import_module_matches_request(module, requested_path):
			if not alias_matches.contains(module_path):
				alias_matches = alias_matches.append(module_path)

	match exact_match:
		Some(identity):
			CompilerImportIdentityFound(identity)
		None:
			sorted_alias_matches = alias_matches.sort()

			match sorted_alias_matches:
				[]:
					CompilerImportIdentityMissing
				[identity]:
					CompilerImportIdentityFound(identity)
				_:
					CompilerImportIdentityAmbiguous(sorted_alias_matches)


pure func compiler_matching_import_identities(
	modules: List[CompilerImportableModule],
	requested_path: String,
) -> List[String]:
	match compiler_resolve_import_identity(modules, requested_path):
		CompilerImportIdentityMissing:
			[]
		CompilerImportIdentityFound(identity):
			[identity]
		CompilerImportIdentityAmbiguous(identities):
			identities


private pure func compiler_decl_import_identities(
	import_modules: List[CompilerImportableModule],
	decls: List[ParsedDecl],
) -> List[String]:
	var identities: List[String] = []

	for decl in decls:
		match decl:
			ImportBlockParsedDecl(imports, _):
				for import_decl in imports:
					for module_identity in compiler_matching_import_identities(
						import_modules,
						import_decl.module_path,
					):
						if not identities.contains(module_identity):
							identities = identities.append(module_identity)
			PrivateParsedDecl(ImportBlockParsedDecl(imports, _), _):
				for import_decl in imports:
					for module_identity in compiler_matching_import_identities(
						import_modules,
						import_decl.module_path,
					):
						if not identities.contains(module_identity):
							identities = identities.append(module_identity)
			_:
				void

	identities


pure func compiler_program_import_identities(
	import_modules: List[CompilerImportableModule],
	program: ParsedProgram,
) -> List[String]:
	compiler_decl_import_identities(import_modules, program.decls)


private pure func compiler_import_module_is_current(
	module_path: String,
	current_module_path: Option[String],
) -> Bool:
	match current_module_path:
		Some(current_path):
			module_path == current_path
		None:
			False


pure func compiler_importable_modules_for_program(
	modules: List[CompilerImportableModule],
	program: ParsedProgram,
	current_module_path: Option[String],
) -> List[CompilerImportableModule]:
	identities: List[String] = compiler_program_import_identities(modules, program)
	var result: List[CompilerImportableModule] = []

	for module in modules:
		if (
			identities.contains(compiler_importable_module_path(module))
			and not compiler_import_module_is_current(
				compiler_importable_module_path(module),
				current_module_path,
			)
		):
			result = result.append(module)

	result


private pure func compiler_importable_module_dependency_closure(
	modules: List[CompilerImportableModule],
	roots: List[CompilerImportableModule],
	current_module_path: Option[String],
) -> List[CompilerImportableModule]:
	var identities: List[String] = []
	var index: Int = 0

	for root in roots:
		identities = identities.append(compiler_importable_module_path(root))

	while index < identities.length():
		current_identity = identities.get_or(index, "")

		for module in modules:
			if compiler_importable_module_path(module) == current_identity:
				for dependency in compiler_decl_import_identities(
					modules,
					compiler_importable_module_decls(module),
				):
					if (
						not identities.contains(dependency)
						and not compiler_import_module_is_current(dependency, current_module_path)
					):
						identities = identities.append(dependency)

				break

		index += 1

	var result: List[CompilerImportableModule] = []

	for module in modules:
		if (
			identities.contains(compiler_importable_module_path(module))
			and not compiler_import_module_is_current(
				compiler_importable_module_path(module),
				current_module_path,
			)
		):
			result = result.append(module)

	result


pure func compiler_reachable_importable_modules(
	program: ParsedProgram,
	import_modules: List[CompilerImportableModule],
	current_module_path: Option[String],
) -> List[CompilerImportableModule]:
	direct_import_modules = compiler_importable_modules_for_program(
		import_modules,
		program,
		current_module_path,
	)
	compiler_importable_module_dependency_closure(
		import_modules,
		direct_import_modules,
		current_module_path,
	)


pure func compiler_with_ambient_impl_modules(
	modules: List[CompilerImportableModule],
	all_modules: List[CompilerImportableModule],
	current_module_path: Option[String],
) -> List[CompilerImportableModule]:
	var result = modules

	for module in all_modules:
		if (
			compiler_importable_module_path(module) == COMPILER_AMBIENT_TUPLE_IMPL_MODULE_PATH
			and not compiler_import_module_is_current(
				compiler_importable_module_path(module),
				current_module_path,
			)
			and not result.any(
				func(
					existing,
				): compiler_importable_module_path(
					existing,
				) == compiler_importable_module_path(module),
			)
		):
			result = result.append(module)

	result
