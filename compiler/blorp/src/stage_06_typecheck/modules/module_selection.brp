-- Module-selection orchestration for Blorp-owned typechecking.
import:
	../../stage_03_parse/parsed_ast: ParsedProgram
	module_binding: CompilerImportableModule
	module_visibility:
		compiler_importable_modules_for_program,
		compiler_reachable_importable_modules,
		compiler_with_ambient_impl_modules,


pure func compiler_visible_importable_modules_for_program(
	program_with_prelude: ParsedProgram,
	import_modules: List[CompilerImportableModule],
	current_module_path: Option[String],
) -> List[CompilerImportableModule]:
	compiler_with_ambient_impl_modules(
		compiler_reachable_importable_modules(
			program_with_prelude,
			import_modules,
			current_module_path,
		),
		import_modules,
		current_module_path,
	)


pure func compiler_direct_importable_modules_for_program(
	program_with_prelude: ParsedProgram,
	visible_modules: List[CompilerImportableModule],
	current_module_path: Option[String],
) -> List[CompilerImportableModule]:
	compiler_with_ambient_impl_modules(
		compiler_importable_modules_for_program(
			visible_modules,
			program_with_prelude,
			current_module_path,
		),
		visible_modules,
		current_module_path,
	)
