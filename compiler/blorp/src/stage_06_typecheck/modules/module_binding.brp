	module_view: CompilerModuleView, compiler_module_view_imported_names


record CompilerImportableModuleSurface {
	module_path: String,
	origin: CompilerModuleOrigin,
	surface: ModuleSurface
}


union CompilerImportableSignatureDecl:
	CompilerImportableFunctionDecl(ParsedFunctionDecl)
	CompilerImportableVarDecl(ParsedVarDecl)
	CompilerImportableForeignFunctionDecl(ParsedForeignFunctionDecl)
	CompilerImportableTraitDecl(ParsedTraitDecl)


private record CompilerAcceptedImportableModuleContents {
	surface: ModuleSurface,
	local_type_names: List[String],
	declared_imports: List[ParsedImportDecl],
	signature_decls: List[CompilerImportableSignatureDecl],
	impl_decls: List[ParsedImplDecl],
	decls: List[ParsedDecl]
}


private union CompilerImportableModuleContents:
	CompilerAcceptedImportableModuleContentsValue(CompilerAcceptedImportableModuleContents)
	CompilerRecoveryImportableModuleContents(ModuleSurface)


private record CompilerImportableModuleRep {
	prepared_scope: CompilerPreparedModuleScope,
	module_path: String,
	origin: CompilerModuleOrigin,
	contents: CompilerImportableModuleContents
}


opaque type CompilerImportableModule = CompilerImportableModuleRep


private record CompilerImportableModuleIndexRep {
	modules: List[CompilerImportableModule],
	modules_by_path: Dict[String, CompilerImportableModule],
	module_ordinals_by_path: Dict[String, Int],
	candidate_paths_by_request: Dict[String, List[String]],
	dependency_paths_by_path: Dict[String, List[String]],
	prelude_path: Option[String]
}


opaque type CompilerImportableModuleIndex = CompilerImportableModuleIndexRep


private record CompilerImportableModuleGraphRep {
	target_scope: CompilerPreparedModuleScope,
	dependency_index: CompilerImportableModuleIndex,
	all_index: CompilerImportableModuleIndex
}


opaque type CompilerImportableModuleGraph = CompilerImportableModuleGraphRep


private record CompilerImportableDeclarationFacts {
	declared_imports: List[ParsedImportDecl],
	signature_decls: List[CompilerImportableSignatureDecl],
	impl_decls: List[ParsedImplDecl]
}


pure func compiler_importable_module_surface(
	module_path: String,
	origin: CompilerModuleOrigin,
	surface: ModuleSurface,
) -> CompilerImportableModuleSurface:
	{
		module_path = module_path,
		origin = origin,
		surface = surface
	}


private EMPTY_IMPORTABLE_DECLARATION_FACTS: CompilerImportableDeclarationFacts = {
	declared_imports = [],
	signature_decls = [],
	impl_decls = []
}


private pure func compiler_collect_private_importable_declaration_facts(
	facts: CompilerImportableDeclarationFacts,
	decl: ParsedDecl,
) -> CompilerImportableDeclarationFacts:
	match decl:
		ImportBlockParsedDecl(imports, _):
			{ facts | declared_imports = facts.declared_imports.concat(imports) }
		PrivateParsedDecl(inner, _):
			compiler_collect_private_importable_declaration_facts(facts, inner)
		FunctionParsedDecl(_):
			facts
		VarParsedDecl(_):
			facts
		ForeignBlockParsedDecl(_, _, _):
			facts
		RecordParsedDecl(_):
			facts
		UnionParsedDecl(_):
			facts
		BuiltinTypeParsedDecl(_):
			facts
		TypeAliasParsedDecl(_):
			facts
		TraitParsedDecl(_):
			facts
		ImplParsedDecl(_):
			facts
		ParsedErrorDecl(_):
			facts


private pure func compiler_collect_importable_declaration_facts(
	facts: CompilerImportableDeclarationFacts,
	decl: ParsedDecl,
) -> CompilerImportableDeclarationFacts:
	match decl:
		FunctionParsedDecl(function_decl):
			{ facts |
				signature_decls = facts.signature_decls.append(
					CompilerImportableFunctionDecl(function_decl),
				)
			}
		VarParsedDecl(var_decl):
			{ facts |
				signature_decls = facts.signature_decls.append(CompilerImportableVarDecl(var_decl))
			}
		ImportBlockParsedDecl(imports, _):
			{ facts | declared_imports = facts.declared_imports.concat(imports) }
		ForeignBlockParsedDecl(_, functions, _):
			var next = facts

			for function_decl in functions:
				if not function_decl.is_private:
					next = { next |
						signature_decls = next.signature_decls.append(
							CompilerImportableForeignFunctionDecl(function_decl),
						)
					}

			next
		RecordParsedDecl(_):
			facts
		UnionParsedDecl(_):
			facts
		BuiltinTypeParsedDecl(_):
			facts
		TypeAliasParsedDecl(_):
			facts
		TraitParsedDecl(trait_decl):
			{ facts |
				signature_decls = facts.signature_decls.append(
					CompilerImportableTraitDecl(trait_decl),
				)
			}
		ImplParsedDecl(impl_decl):
			{ facts | impl_decls = facts.impl_decls.append(impl_decl) }
		PrivateParsedDecl(inner, _):
			compiler_collect_private_importable_declaration_facts(facts, inner)
		ParsedErrorDecl(_):
			facts


private pure func compiler_importable_declaration_facts(
	decls: List[ParsedDecl],
) -> CompilerImportableDeclarationFacts:
	var facts = EMPTY_IMPORTABLE_DECLARATION_FACTS

	for decl in decls:
		facts = compiler_collect_importable_declaration_facts(facts, decl)

	facts


private pure func compiler_recovery_module_surface(program: ParsedProgram) -> ModuleSurface:
	{
		module_name = program.source.module_name,
		import_paths = [],
		exports = [],
		private_names = [],
		private_traits = []
	}


pure func compiler_importable_module(
	prepared_scope: CompilerPreparedModuleScope,
) -> CompilerImportableModule:
	module = compiler_prepared_module_scope_module(prepared_scope)
	program = prepared_module_program(module)

	contents: CompilerImportableModuleContents = if parsed_program_has_errors(program):
		CompilerRecoveryImportableModuleContents(compiler_recovery_module_surface(program))
	else:
		decls = program.decls
		facts = compiler_importable_declaration_facts(decls)
		CompilerAcceptedImportableModuleContentsValue({
			surface = module_surface_for_program(program),
			local_type_names = compiler_local_type_names_from_decls(decls),
			declared_imports = facts.declared_imports,
			signature_decls = facts.signature_decls,
			impl_decls = facts.impl_decls,
			decls = decls,
		})

	representation: CompilerImportableModuleRep = {
		prepared_scope = prepared_scope,
		module_path = prepared_module_canonical_path(module),
		origin = prepared_module_origin(module),
		contents = contents
	}
	into CompilerImportableModule(representation)


pure func compiler_importable_module_graph(
	indexed_graph: CompilerIndexedGraph,
) -> CompilerImportableModuleGraph:
	target_scope = compiler_indexed_graph_target_scope(indexed_graph)
	dependency_modules = compiler_indexed_graph_module_scopes(
		indexed_graph,
	).map(compiler_importable_module)
	all_modules = dependency_modules.append(compiler_importable_module(target_scope))
	representation: CompilerImportableModuleGraphRep = {
		target_scope = target_scope,
		dependency_index = compiler_importable_module_index(dependency_modules),
		all_index = compiler_importable_module_index(all_modules)
	}
	into CompilerImportableModuleGraph(representation)


private pure func compiler_importable_module_graph_rep(
	graph: CompilerImportableModuleGraph,
) -> CompilerImportableModuleGraphRep:
	from CompilerImportableModuleGraph(graph)


pure func compiler_importable_module_graph_dependencies(
	graph: CompilerImportableModuleGraph,
) -> List[CompilerImportableModule]:
	compiler_importable_module_index_modules(
		compiler_importable_module_graph_rep(graph).dependency_index,
	)


pure func compiler_importable_module_graph_all(
	graph: CompilerImportableModuleGraph,
) -> List[CompilerImportableModule]:
	compiler_importable_module_index_modules(compiler_importable_module_graph_rep(graph).all_index)


pure func compiler_importable_module_graph_dependency_index(
	graph: CompilerImportableModuleGraph,
) -> CompilerImportableModuleIndex:
	compiler_importable_module_graph_rep(graph).dependency_index


pure func compiler_importable_module_graph_all_index(
	graph: CompilerImportableModuleGraph,
) -> CompilerImportableModuleIndex:
	compiler_importable_module_graph_rep(graph).all_index


pure func compiler_importable_module_graph_matches_scope(
	graph: CompilerImportableModuleGraph,
	scope: CompilerPreparedModuleScope,
) -> Bool:
	compiler_prepared_module_scopes_are_compatible(
		compiler_importable_module_graph_rep(graph).target_scope,
		scope,
	)


private pure func compiler_importable_module_has_accepted_contents(
	module: CompilerImportableModule,
) -> Bool:
	match compiler_importable_module_contents(module):
		CompilerAcceptedImportableModuleContentsValue(_):
			True
		CompilerRecoveryImportableModuleContents(_):
			False


-- Body checking is only valid for a parser-accepted module owned by this
-- graph. Recovery modules remain available for diagnostics but cannot be
-- refined into a semantic typecheck input.
pure func compiler_importable_module_graph_accepts_scope(
	graph: CompilerImportableModuleGraph,
	scope: CompilerPreparedModuleScope,
) -> Bool:
	if not compiler_importable_module_graph_matches_scope(graph, scope):
		False
	else:
		identity = compiler_prepared_module_scope_identity(scope)
		module_path = prepared_module_canonical_path(compiler_prepared_module_scope_module(scope))

		match compiler_importable_module_index_find(
			compiler_importable_module_graph_all_index(graph),
			module_path,
		):
			Some(module):
				(
					compiler_module_identities_equal(
						compiler_prepared_module_scope_identity(
							compiler_importable_module_prepared_scope(module),
						),
						identity,
					)
					and compiler_importable_module_has_accepted_contents(module)
				)
			None:
				False


pure func compiler_importable_module_path(module: CompilerImportableModule) -> String:
	representation: CompilerImportableModuleRep = from CompilerImportableModule(module)
	representation.module_path


pure func compiler_importable_module_prepared_scope(
	module: CompilerImportableModule,
) -> CompilerPreparedModuleScope:
	representation: CompilerImportableModuleRep = from CompilerImportableModule(module)
	representation.prepared_scope


pure func compiler_importable_module_origin(
	module: CompilerImportableModule,
) -> CompilerModuleOrigin:
	representation: CompilerImportableModuleRep = from CompilerImportableModule(module)
	representation.origin


private pure func compiler_importable_module_contents(
	module: CompilerImportableModule,
) -> CompilerImportableModuleContents:
	representation: CompilerImportableModuleRep = from CompilerImportableModule(module)
	representation.contents


pure func compiler_importable_module_surface_value(
	module: CompilerImportableModule,
) -> ModuleSurface:
	match compiler_importable_module_contents(module):
		CompilerAcceptedImportableModuleContentsValue(contents):
			contents.surface
		CompilerRecoveryImportableModuleContents(surface):
			surface


pure func compiler_importable_module_local_type_names(
	module: CompilerImportableModule,
) -> List[String]:
	match compiler_importable_module_contents(module):
		CompilerAcceptedImportableModuleContentsValue(contents):
			contents.local_type_names
		CompilerRecoveryImportableModuleContents(_):
			[]


pure func compiler_importable_module_declared_imports(
	module: CompilerImportableModule,
) -> List[ParsedImportDecl]:
	match compiler_importable_module_contents(module):
		CompilerAcceptedImportableModuleContentsValue(contents):
			contents.declared_imports
		CompilerRecoveryImportableModuleContents(_):
			[]


pure func compiler_importable_module_signature_decls(
	module: CompilerImportableModule,
) -> List[CompilerImportableSignatureDecl]:
	match compiler_importable_module_contents(module):
		CompilerAcceptedImportableModuleContentsValue(contents):
			contents.signature_decls
		CompilerRecoveryImportableModuleContents(_):
			[]


pure func compiler_importable_module_impl_decls(
	module: CompilerImportableModule,
) -> List[ParsedImplDecl]:
	match compiler_importable_module_contents(module):
		CompilerAcceptedImportableModuleContentsValue(contents):
			contents.impl_decls
		CompilerRecoveryImportableModuleContents(_):
			[]


pure func compiler_importable_module_decls(module: CompilerImportableModule) -> List[ParsedDecl]:
	match compiler_importable_module_contents(module):
		CompilerAcceptedImportableModuleContentsValue(contents):
			contents.decls
		CompilerRecoveryImportableModuleContents(_):
			[]


pure func compiler_importable_module_to_surface(
	module: CompilerImportableModule,
) -> CompilerImportableModuleSurface:
	compiler_importable_module_surface(
		compiler_importable_module_path(module),
		compiler_importable_module_origin(module),
		compiler_importable_module_surface_value(module),
	)


pure func compiler_import_default_alias(module_path: String) -> String:
	parts: List[String] = module_path.split("/")

	raw_name: String = match parts.last():
		Some(name):
			name
		None:
			module_path

	if raw_name.ends_with(".brp"):
		raw_name.substring(0, raw_name.length() - 4)
	else:
		raw_name


pure func compiler_importable_module_request_aliases(
	module_path: String,
	origin: CompilerModuleOrigin,
	module_name: String,
) -> List[String]:
	var aliases: List[String] = []

	for identity in [module_path, module_name]:
		if not aliases.contains(identity):
			aliases = aliases.append(identity)

		alternate: Option[String] = if identity.starts_with("std/"):
			Some(identity.drop_left(4))
		else if module_origin_is_std(origin):
			Some("std/" + identity)
		else:
			None

		match alternate:
			Some(request_alias):
				if not aliases.contains(request_alias):
					aliases = aliases.append(request_alias)
			None:
				void

	aliases


pure func compiler_importable_module_identity_is_std_prelude(
	module_path: String,
	origin: CompilerModuleOrigin,
	module_name: String,
) -> Bool:
	(
		module_origin_is_std(origin)
		and compiler_importable_module_request_aliases(
			module_path,
			origin,
			module_name,
		).contains("prelude")
	)


private pure func compiler_importable_module_index_rep(
	index: CompilerImportableModuleIndex,
) -> CompilerImportableModuleIndexRep:
	from CompilerImportableModuleIndex(index)


pure func compiler_importable_module_index_modules(
	index: CompilerImportableModuleIndex,
) -> List[CompilerImportableModule]:
	compiler_importable_module_index_rep(index).modules


pure func compiler_importable_module_index_find(
	index: CompilerImportableModuleIndex,
	canonical_path: String,
) -> Option[CompilerImportableModule]:
	compiler_importable_module_index_rep(index).modules_by_path.get(canonical_path)


pure func compiler_importable_module_index_modules_for_paths(
	index: CompilerImportableModuleIndex,
	canonical_paths: List[String],
) -> List[CompilerImportableModule]:
	representation = compiler_importable_module_index_rep(index)
	var ordered: List[(Int, CompilerImportableModule)] = []

	for canonical_path in canonical_paths:
		match (
			representation.module_ordinals_by_path.get(canonical_path),
			representation.modules_by_path.get(canonical_path),
		):
			(Some(ordinal), Some(module)):
				ordered = ordered.append((ordinal, module))
			_:
				void

	ordered
		.sort_by(func(entry): entry[0])
		.map(func(entry): entry[1])


pure func compiler_importable_module_index_prelude(
	index: CompilerImportableModuleIndex,
) -> Option[CompilerImportableModule]:
	representation = compiler_importable_module_index_rep(index)

	match representation.prelude_path:
		Some(module_path):
			representation.modules_by_path.get(module_path)
		None:
			None


pure func compiler_importable_module_index_matching_paths(
	index: CompilerImportableModuleIndex,
	requested_path: String,
) -> List[String]:
	representation = compiler_importable_module_index_rep(index)

	match representation.modules_by_path.get(requested_path):
		Some(_):
			[requested_path]
		None:
			candidates = representation.candidate_paths_by_request
				.get(requested_path)
				.get_or([])

			if candidates.length() > 1:
				candidates.sort()
			else:
				candidates


pure func compiler_importable_module_index_dependency_paths(
	index: CompilerImportableModuleIndex,
	canonical_path: String,
) -> List[String]:
	compiler_importable_module_index_rep(index).dependency_paths_by_path
		.get(canonical_path)
		.get_or([])


private pure func compiler_importable_module_index(
	modules: List[CompilerImportableModule],
) -> CompilerImportableModuleIndex:
	var modules_by_path: Dict[String, CompilerImportableModule] = {}
	var module_ordinals_by_path: Dict[String, Int] = {}
	var candidate_paths_by_request: Dict[String, List[String]] = {}
	var module_ordinal: Int = 0

	for module in modules:
		module_path = compiler_importable_module_path(module)
		modules_by_path = modules_by_path.set(module_path, module)
		module_ordinals_by_path = module_ordinals_by_path.set(module_path, module_ordinal)

		for request_alias in compiler_importable_module_request_aliases(
			module_path,
			compiler_importable_module_origin(module),
			compiler_importable_module_surface_value(module).module_name,
		):
			existing = candidate_paths_by_request
				.get(request_alias)
				.get_or([])

			if not existing.contains(module_path):
				candidate_paths_by_request = candidate_paths_by_request.set(
					request_alias,
					existing.append(module_path),
				)

		module_ordinal += 1

	var prelude_path: Option[String] = None

	for canonical_path in ["std/prelude", "prelude"]:
		match modules_by_path.get(canonical_path):
			Some(module):
				if compiler_importable_module_identity_is_std_prelude(
					compiler_importable_module_path(module),
					compiler_importable_module_origin(module),
					compiler_importable_module_surface_value(module).module_name,
				):
					prelude_path = Some(canonical_path)
					break
			None:
				void

	match prelude_path:
		Some(_):
			void
		None:
			for module in modules:
				module_name = compiler_importable_module_surface_value(module).module_name

				if compiler_importable_module_identity_is_std_prelude(
					compiler_importable_module_path(module),
					compiler_importable_module_origin(module),
					module_name,
				):
					prelude_path = Some(compiler_importable_module_path(module))
					break

	base_representation: CompilerImportableModuleIndexRep = {
		modules = modules,
		modules_by_path = modules_by_path,
		module_ordinals_by_path = module_ordinals_by_path,
		candidate_paths_by_request = candidate_paths_by_request,
		dependency_paths_by_path = {},
		prelude_path = prelude_path
	}
	base = into CompilerImportableModuleIndex(base_representation)
	var dependency_paths_by_path: Dict[String, List[String]] = {}

	for module in modules:
		var dependencies: List[String] = []

		for import_decl in compiler_importable_module_declared_imports(module):
			for dependency in compiler_importable_module_index_matching_paths(
				base,
				import_decl.module_path,
			):
				if not dependencies.contains(dependency):
					dependencies = dependencies.append(dependency)

		dependency_paths_by_path = dependency_paths_by_path.set(
			compiler_importable_module_path(module),
			dependencies,
		)

	indexed_representation = { base_representation |
		dependency_paths_by_path = dependency_paths_by_path
	}
	into CompilerImportableModuleIndex(indexed_representation)


private union CompilerImportModuleLookup:
	CompilerImportModuleMissing
	CompilerImportModuleFound(CompilerImportableModuleSurface)
	CompilerImportModuleAmbiguous(List[String])


private record CompilerImportModuleIndex {
	exact_by_path: Dict[String, List[CompilerImportableModuleSurface]],
	candidates_by_request: Dict[String, List[CompilerImportableModuleSurface]]
}


private pure func compiler_import_module_index(
	modules: List[CompilerImportableModuleSurface],
) -> CompilerImportModuleIndex:
	var exact_by_path: Dict[String, List[CompilerImportableModuleSurface]] = {}
	var candidates_by_request: Dict[String, List[CompilerImportableModuleSurface]] = {}

	for module in modules:
		exact_by_path = exact_by_path.set(
			module.module_path,
			exact_by_path
				.get(module.module_path)
				.get_or([])
				.append(module),
		)

		for request_alias in compiler_importable_module_request_aliases(
			module.module_path,
			module.origin,
			module.surface.module_name,
		):
			candidates_by_request = candidates_by_request.set(
				request_alias,
				candidates_by_request
					.get(request_alias)
					.get_or([])
					.append(module),
			)

	{
		exact_by_path = exact_by_path,
		candidates_by_request = candidates_by_request
	}


private pure func compiler_find_importable_module(
	index: CompilerImportModuleIndex,
	requested_path: String,
) -> CompilerImportModuleLookup:
	exact_matches = index.exact_by_path
		.get(requested_path)
		.get_or([])

	matches = if exact_matches.length() > 0:
		exact_matches
	else:
		index.candidates_by_request
			.get(requested_path)
			.get_or([])

	match matches:
		[]:
			CompilerImportModuleMissing
		[module]:
			CompilerImportModuleFound(module)
		_:
			CompilerImportModuleAmbiguous(
				matches
					.map(func(module): module.module_path)
					.sort(),
			)


private pure func compiler_find_surface_symbol(
	symbols: List[ModuleSurfaceSymbol],
	name: String,
) -> Option[ModuleSurfaceSymbol]:
	var result: Option[ModuleSurfaceSymbol] = None

	for symbol in symbols:
		if symbol.name == name:
			result = Some(symbol)
			break

	result


private pure func compiler_import_symbol_kind_is_type_like(kind: ModuleSurfaceSymbolKind) -> Bool:
	match kind:
		TypeSurfaceSymbol:
			True
		RecordSurfaceSymbol:
			True
		TypeAliasSurfaceSymbol:
			True
		_:
			False


private pure func compiler_import_symbol_local_name(symbol: ParsedImportSymbol) -> String:
	match symbol.symbol_alias:
		Some(alias_name):
			alias_name.text
		None:
			symbol.name.text


private pure func compiler_import_decl_explicit_alias(decl: ParsedImportDecl) -> Option[String]:
	match decl.module_alias:
		Some(alias_name):
			Some(alias_name.text)
		None:
			None


private pure func compiler_register_import_symbol_syntax(
	state: CompilerTypecheckState,
	module_path: String,
	symbol: ParsedImportSymbol,
) -> CompilerTypecheckState:
	registration = compiler_typecheck_state_register_imported_name(
		state,
		compiler_import_symbol_local_name(symbol),
		module_path,
		symbol.name.text,
	)
	var next: CompilerTypecheckState = registration.state

	if registration.registered:
		for constructor in symbol.constructors:
			next = compiler_register_import_constructor(next, module_path, constructor)

	next


private pure func compiler_register_import_constructor(
	state: CompilerTypecheckState,
	module_path: String,
	constructor: ParsedIdentifier,
) -> CompilerTypecheckState:
	registration = compiler_typecheck_state_register_imported_name(
		state,
		constructor.text,
		module_path,
		constructor.text,
	)
	registration.state


private pure func compiler_register_import_symbols_syntax(
	state: CompilerTypecheckState,
	module_path: String,
	symbols: List[ParsedImportSymbol],
) -> CompilerTypecheckState:
	var next: CompilerTypecheckState = state

	for symbol in symbols:
		next = compiler_register_import_symbol_syntax(next, module_path, symbol)

	next


pure func compiler_register_import_decl_syntax(
	state: CompilerTypecheckState,
	import_decl: ParsedImportDecl,
) -> CompilerTypecheckState:
	module_path: String = import_decl.module_path
	var next: CompilerTypecheckState = compiler_typecheck_state_add_imported_module(
		state,
		module_path,
	)

	match import_decl.symbols:
		Some(symbols):
			next = compiler_register_import_symbols_syntax(next, module_path, symbols)

			match compiler_import_decl_explicit_alias(import_decl):
				Some(alias_name):
					compiler_typecheck_state_register_module_alias(next, alias_name, module_path)
				None:
					next
		None:
			alias_name: String = compiler_import_decl_explicit_alias(
				import_decl,
			).get_or(compiler_import_default_alias(module_path))

			compiler_typecheck_state_register_module_alias(next, alias_name, module_path)


private pure func compiler_register_imports_decl_syntax(
	state: CompilerTypecheckState,
	decl: ParsedDecl,
) -> CompilerTypecheckState:
	match decl:
		ImportBlockParsedDecl(imports, _):
			var next: CompilerTypecheckState = state

			for import_decl in imports:
				next = compiler_register_import_decl_syntax(next, import_decl)

			next
		PrivateParsedDecl(inner, _):
			compiler_register_imports_decl_syntax(state, inner)
		_:
			state


pure func compiler_register_program_import_syntax(
	state: CompilerTypecheckState,
	program: ParsedProgram,
) -> CompilerTypecheckState:
	var current: CompilerTypecheckState = state

	for decl in program.decls:
		current = compiler_register_imports_decl_syntax(current, decl)

	current


private pure func compiler_import_not_loaded_error(
	state: CompilerTypecheckState,
	module_path: String,
	span: CompilerSourceSpan,
) -> CompilerTypecheckState:
	compiler_typecheck_state_add_error_at(
		state,
		span,
		"module '" + module_path + "' is not loaded for import registration",
	)


private pure func compiler_import_ambiguous_module_error(
	state: CompilerTypecheckState,
	module_path: String,
	canonical_paths: List[String],
	span: CompilerSourceSpan,
) -> CompilerTypecheckState:
	quoted_paths = canonical_paths.map(func(path): "'" + path + "'")
	compiler_typecheck_state_add_error_at(
		state,
		span,
		"module '" + module_path + "' is ambiguous; it matches " + quoted_paths.join(" and "),
	)


private pure func compiler_import_duplicate_module_error(
	state: CompilerTypecheckState,
	module_path: String,
	span: CompilerSourceSpan,
) -> CompilerTypecheckState:
	compiler_typecheck_state_add_error_at(
		state,
		span,
		"module '" + compiler_import_default_alias(module_path) + "' is already imported",
	)


private pure func compiler_import_std_package_error(
	state: CompilerTypecheckState,
	span: CompilerSourceSpan,
) -> CompilerTypecheckState:
	compiler_typecheck_state_add_error_at(
		state,
		span,
		"standard library modules cannot import package modules",
	)


private pure func compiler_import_private_symbol_error(
	state: CompilerTypecheckState,
	module_path: String,
	symbol_name: String,
) -> CompilerTypecheckState:
	compiler_typecheck_state_add_error(
		state,
		"'" + symbol_name + "' is private in module '" + module_path + "' and cannot be imported",
	)


private pure func compiler_import_missing_symbol_error(
	state: CompilerTypecheckState,
	module_path: String,
	symbol_name: String,
) -> CompilerTypecheckState:
	compiler_typecheck_state_add_error(
		state,
		"'" + symbol_name + "' is not exported by module '" + module_path + "'",
	)


private pure func compiler_import_duplicate_symbol_error(
	state: CompilerTypecheckState,
	local_name: String,
) -> CompilerTypecheckState:
	compiler_typecheck_state_add_error(
		state,
		"'" + local_name + "' is already imported from this module",
	)


private pure func compiler_record_imported_type_symbol(
	state: CompilerTypecheckState,
	module_path: String,
	local_name: String,
	symbol: ModuleSurfaceSymbol,
) -> CompilerTypecheckState:
	if compiler_import_symbol_kind_is_type_like(symbol.kind):
		compiler_typecheck_state_record_type_home(
			compiler_typecheck_state_add_known_type_name(state, local_name),
			local_name,
			module_path,
			True,
		)
	else:
		state


pure func compiler_register_module_view_type_facts(
	state: CompilerTypecheckState,
	modules: List[CompilerImportableModuleSurface],
	view: CompilerModuleView,
) -> CompilerTypecheckState:
	var next = state

	for binding in compiler_module_view_imported_names(view):
		match modules.find(func(module): module.module_path == binding.module_path):
			Some(module):
				match compiler_find_surface_symbol(module.surface.exports, binding.original_name):
					Some(symbol):
						next = compiler_record_imported_type_symbol(
							next,
							binding.module_path,
							binding.local_name,
							symbol,
						)
					None:
						void
			None:
				void

	next


private pure func compiler_register_import_symbol(
	state: CompilerTypecheckState,
	imported_module: CompilerImportableModuleSurface,
	symbol: ParsedImportSymbol,
) -> CompilerTypecheckState:
	module_path: String = imported_module.module_path
	original_name: String = symbol.name.text
	local_name: String = compiler_import_symbol_local_name(symbol)

	match compiler_find_surface_symbol(imported_module.surface.exports, original_name):
		Some(exported_symbol):
			registration = compiler_typecheck_state_register_imported_name(
				state,
				local_name,
				module_path,
				original_name,
			)

			if registration.registered:
				var next: CompilerTypecheckState = compiler_record_imported_type_symbol(
					registration.state,
					module_path,
					local_name,
					exported_symbol,
				)

				for constructor in symbol.constructors:
					next = compiler_register_import_constructor(next, module_path, constructor)

				next
			else:
				registration.state
		None:
			match compiler_find_surface_symbol(
				imported_module.surface.private_names,
				original_name,
			):
				Some(_):
					compiler_import_private_symbol_error(state, module_path, original_name)
				None:
					compiler_import_missing_symbol_error(state, module_path, original_name)


private pure func compiler_register_import_symbols(
	state: CompilerTypecheckState,
	imported_module: CompilerImportableModuleSurface,
	symbols: List[ParsedImportSymbol],
) -> CompilerTypecheckState:
	var current: CompilerTypecheckState = state
	var seen_local_names: List[String] = []

	for symbol in symbols:
		local_name: String = compiler_import_symbol_local_name(symbol)

		if seen_local_names.contains(local_name):
			current = compiler_import_duplicate_symbol_error(current, local_name)
		else:
			seen_local_names = seen_local_names.append(local_name)
			current = compiler_register_import_symbol(current, imported_module, symbol)

	current


private pure func compiler_register_import_alias_if_present(
	state: CompilerTypecheckState,
	imported_module: CompilerImportableModuleSurface,
	maybe_alias: Option[String],
) -> CompilerTypecheckState:
	match maybe_alias:
		Some(alias_name):
			compiler_typecheck_state_register_module_alias(
				state,
				alias_name,
				imported_module.module_path,
			)
		None:
			state


private pure func compiler_register_import_decl_indexed(
	state: CompilerTypecheckState,
	index: CompilerImportModuleIndex,
	decl: ParsedImportDecl,
) -> CompilerTypecheckState:
	match compiler_find_importable_module(index, decl.module_path):
		CompilerImportModuleMissing:
			compiler_import_not_loaded_error(state, decl.module_path, decl.module_path_span)
		CompilerImportModuleAmbiguous(canonical_paths):
			compiler_import_ambiguous_module_error(
				state,
				decl.module_path,
				canonical_paths,
				decl.module_path_span,
			)
		CompilerImportModuleFound(imported_module):
			if (
				compiler_typecheck_state_is_stdlib(state)
				and module_origin_is_package(imported_module.origin)
			):
				compiler_import_std_package_error(state, decl.module_path_span)
			else if compiler_typecheck_state_has_imported_module(
				state,
				imported_module.module_path,
			):
				compiler_import_duplicate_module_error(
					state,
					decl.module_path,
					decl.module_path_span,
				)
			else:
				with_module = compiler_typecheck_state_add_imported_module(
					state,
					imported_module.module_path,
				)

				match decl.symbols:
					Some(symbols):
						with_symbols = compiler_register_import_symbols(
							with_module,
							imported_module,
							symbols,
						)
						compiler_register_import_alias_if_present(
							with_symbols,
							imported_module,
							compiler_import_decl_explicit_alias(decl),
						)
					None:
						alias_name: String = match compiler_import_decl_explicit_alias(decl):
							Some(explicit_alias):
								explicit_alias
							None:
								compiler_import_default_alias(decl.module_path)

						compiler_typecheck_state_register_module_alias(
							with_module,
							alias_name,
							imported_module.module_path,
						)


private pure func compiler_register_import_decls_indexed(
	state: CompilerTypecheckState,
	index: CompilerImportModuleIndex,
	imports: List[ParsedImportDecl],
) -> CompilerTypecheckState:
	var current: CompilerTypecheckState = state

	for import_decl in imports:
		current = compiler_register_import_decl_indexed(current, index, import_decl)

	current


pure func compiler_register_import_decls(
	state: CompilerTypecheckState,
	modules: List[CompilerImportableModuleSurface],
	imports: List[ParsedImportDecl],
) -> CompilerTypecheckState:
	compiler_register_import_decls_indexed(state, compiler_import_module_index(modules), imports)


pure func compiler_register_program_imports(
	state: CompilerTypecheckState,
	modules: List[CompilerImportableModuleSurface],
	program: ParsedProgram,
) -> CompilerTypecheckState:
	var current: CompilerTypecheckState = state
	index = compiler_import_module_index(modules)

	for decl in program.decls:
		match decl:
			ImportBlockParsedDecl(imports, _):
				current = compiler_register_import_decls_indexed(current, index, imports)
			_:
				void

	current
