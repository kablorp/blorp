-- Pure import registration substrate for the Blorp-owned typecheck pass.
--
-- This consumes parsed import declarations. The syntax-only collector records
-- source import bindings for single-source artifacts; the graph-aware
-- collector additionally validates against already-loaded module surfaces.
-- Both paths intentionally record only import bookkeeping here: imported
-- modules, aliases, imported-name bindings, imported type homes, and
-- diagnostics. The semantic env effects for imported declarations belong to
-- the declaration registration slice.
import:
	../../stage_01_file_io/source: CompilerSourceSpan
	../../stage_03_parse/parsed_ast:
		ParsedDecl(
			BuiltinTypeParsedDecl,
			ForeignBlockParsedDecl,
			FunctionParsedDecl,
			ImplParsedDecl,
			ImportBlockParsedDecl,
			ParsedErrorDecl,
			PrivateParsedDecl,
			RecordParsedDecl,
			TraitParsedDecl,
			TypeAliasParsedDecl,
			UnionParsedDecl,
			VarParsedDecl,
		),
		ParsedForeignFunctionDecl,
		ParsedFunctionDecl,
		ParsedIdentifier,
		ParsedImplDecl,
		ParsedImportDecl,
		ParsedImportSymbol,
		ParsedProgram,
		ParsedTraitDecl,
		ParsedVarDecl,
		parsed_program_has_errors,
	../../stage_04_modules/loaded_module: CompilerModuleOrigin, compiler_module_identities_equal
	../../stage_04_modules/module_surface:
		ModuleSurface,
		ModuleSurfaceSymbol,
		ModuleSurfaceSymbolKind(RecordSurfaceSymbol, TypeAliasSurfaceSymbol, TypeSurfaceSymbol),
		module_surface_for_program,
	../../stage_04_modules/module_type_identity: compiler_local_type_names_from_decls
	../../stage_05_types/context: module_origin_is_package, module_origin_is_std
