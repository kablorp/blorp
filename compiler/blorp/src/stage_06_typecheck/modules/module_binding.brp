-- Pure import registration substrate for the Blorp-owned typecheck pass.
--
-- This consumes parsed import declarations. The syntax-only collector records
-- source import bindings for single-source bridge artifacts; the graph-aware
-- collector additionally validates against already-loaded module surfaces.
-- Both paths intentionally record only import bookkeeping here: imported
-- modules, aliases, imported-name bindings, imported type homes, and
-- diagnostics. The semantic env effects for imported declarations belong to
-- the declaration registration slice, matching the current OCaml phase
-- boundary.
import:
	../../stage_03_parse/parsed_ast:
		ParsedBuiltinTypeDecl,
		ParsedDecl(
			BuiltinTypeParsedDecl,
			ForeignBlockParsedDecl,
			FunctionParsedDecl,
			ImplParsedDecl,
			ImportBlockParsedDecl,
			ParsedErrorDecl,
			PrivateParsedDecl,
			RecordParsedDecl,
			TraitParsedDecl,
			TypeAliasParsedDecl,
			UnionParsedDecl,
			VarParsedDecl,
		),
		ParsedForeignFunctionDecl,
		ParsedFunctionDecl,
		ParsedIdentifier,
		ParsedImplDecl,
		ParsedImportDecl,
		ParsedImportSymbol,
		ParsedProgram,
		ParsedRecordDecl,
		ParsedTraitDecl,
		ParsedTypeAliasDecl,
		ParsedUnionDecl,
		ParsedVarDecl,
	../../stage_04_modules/loaded_module: CompilerModuleOrigin
	../../stage_04_modules/module_surface:
		ModuleSurface,
		ModuleSurfaceSymbol,
		ModuleSurfaceSymbolKind(RecordSurfaceSymbol, TypeAliasSurfaceSymbol, TypeSurfaceSymbol),
		module_surface_for_program,
	../../stage_04_modules/module_type_identity: compiler_local_type_names_from_decls
	../../stage_05_types/context: module_origin_is_package, module_origin_is_std
	../graph/indexed_graph:
		CompilerPreparedModuleScope,
		compiler_prepared_module_scope_module,
		prepared_module_canonical_path,
		prepared_module_origin,
		prepared_module_program,
	../typecheck_state:
		CompilerTypecheckState,
		compiler_typecheck_state_add_error,
		compiler_typecheck_state_add_imported_module,
		compiler_typecheck_state_add_known_type_name,
		compiler_typecheck_state_has_imported_module,
		compiler_typecheck_state_is_stdlib,
		compiler_typecheck_state_record_type_home,
		compiler_typecheck_state_register_imported_name,
		compiler_typecheck_state_register_module_alias,


record CompilerImportableModuleSurface {
	module_path: String,
	origin: CompilerModuleOrigin,
	surface: ModuleSurface
}


union CompilerImportableTypeDecl:
	CompilerImportableRecordDecl(ParsedRecordDecl)
	CompilerImportableUnionDecl(ParsedUnionDecl)
	CompilerImportableBuiltinTypeDecl(ParsedBuiltinTypeDecl)
	CompilerImportableTypeAliasDecl(ParsedTypeAliasDecl)


union CompilerImportableSignatureDecl:
	CompilerImportableFunctionDecl(ParsedFunctionDecl)
	CompilerImportableVarDecl(ParsedVarDecl)
	CompilerImportableForeignFunctionDecl(ParsedForeignFunctionDecl)
	CompilerImportableTraitDecl(ParsedTraitDecl)


private record CompilerImportableModuleRep {
	prepared_scope: CompilerPreparedModuleScope,
	module_path: String,
	origin: CompilerModuleOrigin,
	surface: ModuleSurface,
	local_type_names: List[String],
	declared_imports: List[ParsedImportDecl],
	type_decls: List[CompilerImportableTypeDecl],
	signature_decls: List[CompilerImportableSignatureDecl],
	impl_decls: List[ParsedImplDecl],
	decls: List[ParsedDecl]
}


opaque type CompilerImportableModule = CompilerImportableModuleRep


private record CompilerImportableDeclarationFacts {
	declared_imports: List[ParsedImportDecl],
	type_decls: List[CompilerImportableTypeDecl],
	signature_decls: List[CompilerImportableSignatureDecl],
	impl_decls: List[ParsedImplDecl]
}


pure func compiler_importable_module_surface(
	module_path: String,
	origin: CompilerModuleOrigin,
	surface: ModuleSurface,
) -> CompilerImportableModuleSurface:
	{
		module_path = module_path,
		origin = origin,
		surface = surface
	}


private EMPTY_IMPORTABLE_DECLARATION_FACTS: CompilerImportableDeclarationFacts = {
	declared_imports = [],
	type_decls = [],
	signature_decls = [],
	impl_decls = []
}


private pure func compiler_collect_private_importable_declaration_facts(
	facts: CompilerImportableDeclarationFacts,
	decl: ParsedDecl,
) -> CompilerImportableDeclarationFacts:
	match decl:
		ImportBlockParsedDecl(imports, _):
			{ facts | declared_imports = facts.declared_imports.concat(imports) }
		PrivateParsedDecl(inner, _):
			compiler_collect_private_importable_declaration_facts(facts, inner)
		FunctionParsedDecl(_):
			facts
		VarParsedDecl(_):
			facts
		ForeignBlockParsedDecl(_, _, _):
			facts
		RecordParsedDecl(_):
			facts
		UnionParsedDecl(_):
			facts
		BuiltinTypeParsedDecl(_):
			facts
		TypeAliasParsedDecl(_):
			facts
		TraitParsedDecl(_):
			facts
		ImplParsedDecl(_):
			facts
		ParsedErrorDecl(_):
			facts


private pure func compiler_collect_importable_declaration_facts(
	facts: CompilerImportableDeclarationFacts,
	decl: ParsedDecl,
) -> CompilerImportableDeclarationFacts:
	match decl:
		FunctionParsedDecl(function_decl):
			{ facts |
				signature_decls = facts.signature_decls.append(
					CompilerImportableFunctionDecl(function_decl),
				)
			}
		VarParsedDecl(var_decl):
			{ facts |
				signature_decls = facts.signature_decls.append(CompilerImportableVarDecl(var_decl))
			}
		ImportBlockParsedDecl(imports, _):
			{ facts | declared_imports = facts.declared_imports.concat(imports) }
		ForeignBlockParsedDecl(_, functions, _):
			var next = facts

			for function_decl in functions:
				if not function_decl.is_private:
					next = { next |
						signature_decls = next.signature_decls.append(
							CompilerImportableForeignFunctionDecl(function_decl),
						)
					}

			next
		RecordParsedDecl(record_decl):
			{ facts |
				type_decls = facts.type_decls.append(CompilerImportableRecordDecl(record_decl))
			}
		UnionParsedDecl(union_decl):
			{ facts |
				type_decls = facts.type_decls.append(CompilerImportableUnionDecl(union_decl))
			}
		BuiltinTypeParsedDecl(type_decl):
			{ facts |
				type_decls = facts.type_decls.append(CompilerImportableBuiltinTypeDecl(type_decl))
			}
		TypeAliasParsedDecl(alias_decl):
			{ facts |
				type_decls = facts.type_decls.append(CompilerImportableTypeAliasDecl(alias_decl))
			}
		TraitParsedDecl(trait_decl):
			{ facts |
				signature_decls = facts.signature_decls.append(
					CompilerImportableTraitDecl(trait_decl),
				)
			}
		ImplParsedDecl(impl_decl):
			{ facts | impl_decls = facts.impl_decls.append(impl_decl) }
		PrivateParsedDecl(inner, _):
			compiler_collect_private_importable_declaration_facts(facts, inner)
		ParsedErrorDecl(_):
			facts


private pure func compiler_importable_declaration_facts(
	decls: List[ParsedDecl],
) -> CompilerImportableDeclarationFacts:
	var facts = EMPTY_IMPORTABLE_DECLARATION_FACTS

	for decl in decls:
		facts = compiler_collect_importable_declaration_facts(facts, decl)

	facts


pure func compiler_importable_module(
	prepared_scope: CompilerPreparedModuleScope,
) -> CompilerImportableModule:
	module = compiler_prepared_module_scope_module(prepared_scope)
	program = prepared_module_program(module)
	decls = program.decls
	facts = compiler_importable_declaration_facts(decls)
	representation: CompilerImportableModuleRep = {
		prepared_scope = prepared_scope,
		module_path = prepared_module_canonical_path(module),
		origin = prepared_module_origin(module),
		surface = module_surface_for_program(program),
		local_type_names = compiler_local_type_names_from_decls(decls),
		declared_imports = facts.declared_imports,
		type_decls = facts.type_decls,
		signature_decls = facts.signature_decls,
		impl_decls = facts.impl_decls,
		decls = decls
	}
	into CompilerImportableModule(representation)


pure func compiler_importable_module_path(module: CompilerImportableModule) -> String:
	representation: CompilerImportableModuleRep = from CompilerImportableModule(module)
	representation.module_path


pure func compiler_importable_module_prepared_scope(
	module: CompilerImportableModule,
) -> CompilerPreparedModuleScope:
	representation: CompilerImportableModuleRep = from CompilerImportableModule(module)
	representation.prepared_scope


pure func compiler_importable_module_origin(
	module: CompilerImportableModule,
) -> CompilerModuleOrigin:
	representation: CompilerImportableModuleRep = from CompilerImportableModule(module)
	representation.origin


pure func compiler_importable_module_surface_value(
	module: CompilerImportableModule,
) -> ModuleSurface:
	representation: CompilerImportableModuleRep = from CompilerImportableModule(module)
	representation.surface


pure func compiler_importable_module_local_type_names(
	module: CompilerImportableModule,
) -> List[String]:
	representation: CompilerImportableModuleRep = from CompilerImportableModule(module)
	representation.local_type_names


pure func compiler_importable_module_declared_imports(
	module: CompilerImportableModule,
) -> List[ParsedImportDecl]:
	representation: CompilerImportableModuleRep = from CompilerImportableModule(module)
	representation.declared_imports


pure func compiler_importable_module_type_decls(
	module: CompilerImportableModule,
) -> List[CompilerImportableTypeDecl]:
	representation: CompilerImportableModuleRep = from CompilerImportableModule(module)
	representation.type_decls


pure func compiler_importable_module_signature_decls(
	module: CompilerImportableModule,
) -> List[CompilerImportableSignatureDecl]:
	representation: CompilerImportableModuleRep = from CompilerImportableModule(module)
	representation.signature_decls


pure func compiler_importable_module_impl_decls(
	module: CompilerImportableModule,
) -> List[ParsedImplDecl]:
	representation: CompilerImportableModuleRep = from CompilerImportableModule(module)
	representation.impl_decls


pure func compiler_importable_module_decls(module: CompilerImportableModule) -> List[ParsedDecl]:
	representation: CompilerImportableModuleRep = from CompilerImportableModule(module)
	representation.decls


pure func compiler_importable_module_to_surface(
	module: CompilerImportableModule,
) -> CompilerImportableModuleSurface:
	compiler_importable_module_surface(
		compiler_importable_module_path(module),
		compiler_importable_module_origin(module),
		compiler_importable_module_surface_value(module),
	)


pure func compiler_import_default_alias(module_path: String) -> String:
	parts: List[String] = module_path.split("/")

	raw_name: String = match parts.last():
		Some(name):
			name
		None:
			module_path

	if raw_name.ends_with(".brp"):
		raw_name.substring(0, raw_name.length() - 4)
	else:
		raw_name


pure func compiler_importable_module_identity_matches_request(
	module_path: String,
	origin: CompilerModuleOrigin,
	module_name: String,
	requested_path: String,
) -> Bool:
	requested_std_path: String = if requested_path.starts_with("std/"):
		requested_path
	else:
		"std/" + requested_path

	requested_std_relative: String = requested_std_path.drop_left(4)
	stdlib_relative_match: Bool = (
		module_origin_is_std(origin)
		and ((
			not module_path.starts_with("std/") and module_path == requested_std_relative
			or not module_name.starts_with("std/") and module_name == requested_std_relative
		))
	)

	(
		module_path == requested_path
		or module_name == requested_path
		or module_path == requested_std_path
		or module_name == requested_std_path
		or stdlib_relative_match
	)


private pure func compiler_import_module_matches(
	imported_module: CompilerImportableModuleSurface,
	requested_path: String,
) -> Bool:
	compiler_importable_module_identity_matches_request(
		imported_module.module_path,
		imported_module.origin,
		imported_module.surface.module_name,
		requested_path,
	)


private union CompilerImportModuleLookup:
	CompilerImportModuleMissing
	CompilerImportModuleFound(CompilerImportableModuleSurface)
	CompilerImportModuleAmbiguous(List[String])


private record CompilerImportModuleIndex {
	modules: List[CompilerImportableModuleSurface],
	exact_by_path: Dict[String, List[CompilerImportableModuleSurface]]
}


private pure func compiler_import_module_index(
	modules: List[CompilerImportableModuleSurface],
) -> CompilerImportModuleIndex:
	var exact_by_path: Dict[String, List[CompilerImportableModuleSurface]] = {}

	for module in modules:
		exact_by_path = exact_by_path.set(
			module.module_path,
			exact_by_path
				.get(module.module_path)
				.get_or([])
				.append(module),
		)

	{
		modules = modules,
		exact_by_path = exact_by_path
	}


private pure func compiler_find_importable_module(
	index: CompilerImportModuleIndex,
	requested_path: String,
) -> CompilerImportModuleLookup:
	exact_matches = index.exact_by_path
		.get(requested_path)
		.get_or([])

	matches = if exact_matches.length() > 0:
		exact_matches
	else:
		index.modules.filter(
			func(imported_module): compiler_import_module_matches(imported_module, requested_path),
		)

	match matches:
		[]:
			CompilerImportModuleMissing
		[module]:
			CompilerImportModuleFound(module)
		_:
			CompilerImportModuleAmbiguous(
				matches
					.map(func(module): module.module_path)
					.sort(),
			)


private pure func compiler_find_surface_symbol(
	symbols: List[ModuleSurfaceSymbol],
	name: String,
) -> Option[ModuleSurfaceSymbol]:
	var result: Option[ModuleSurfaceSymbol] = None

	for symbol in symbols:
		if symbol.name == name:
			result = Some(symbol)
			break

	result


private pure func compiler_import_symbol_kind_is_type_like(kind: ModuleSurfaceSymbolKind) -> Bool:
	match kind:
		TypeSurfaceSymbol:
			True
		RecordSurfaceSymbol:
			True
		TypeAliasSurfaceSymbol:
			True
		_:
			False


private pure func compiler_import_symbol_local_name(symbol: ParsedImportSymbol) -> String:
	match symbol.symbol_alias:
		Some(alias_name):
			alias_name.text
		None:
			symbol.name.text


private pure func compiler_import_decl_explicit_alias(decl: ParsedImportDecl) -> Option[String]:
	match decl.module_alias:
		Some(alias_name):
			Some(alias_name.text)
		None:
			None


private pure func compiler_register_import_symbol_syntax(
	state: CompilerTypecheckState,
	module_path: String,
	symbol: ParsedImportSymbol,
) -> CompilerTypecheckState:
	registration = compiler_typecheck_state_register_imported_name(
		state,
		compiler_import_symbol_local_name(symbol),
		module_path,
		symbol.name.text,
	)
	var next: CompilerTypecheckState = registration.state

	if registration.registered:
		for constructor in symbol.constructors:
			next = compiler_register_import_constructor(next, module_path, constructor)

	next


private pure func compiler_register_import_constructor(
	state: CompilerTypecheckState,
	module_path: String,
	constructor: ParsedIdentifier,
) -> CompilerTypecheckState:
	registration = compiler_typecheck_state_register_imported_name(
		state,
		constructor.text,
		module_path,
		constructor.text,
	)
	registration.state


private pure func compiler_register_import_symbols_syntax(
	state: CompilerTypecheckState,
	module_path: String,
	symbols: List[ParsedImportSymbol],
) -> CompilerTypecheckState:
	var next: CompilerTypecheckState = state

	for symbol in symbols:
		next = compiler_register_import_symbol_syntax(next, module_path, symbol)

	next


pure func compiler_register_import_decl_syntax(
	state: CompilerTypecheckState,
	import_decl: ParsedImportDecl,
) -> CompilerTypecheckState:
	module_path: String = import_decl.module_path
	var next: CompilerTypecheckState = compiler_typecheck_state_add_imported_module(
		state,
		module_path,
	)

	match import_decl.symbols:
		Some(symbols):
			next = compiler_register_import_symbols_syntax(next, module_path, symbols)

			match compiler_import_decl_explicit_alias(import_decl):
				Some(alias_name):
					compiler_typecheck_state_register_module_alias(next, alias_name, module_path)
				None:
					next
		None:
			alias_name: String = compiler_import_decl_explicit_alias(
				import_decl,
			).get_or(compiler_import_default_alias(module_path))

			compiler_typecheck_state_register_module_alias(next, alias_name, module_path)


private pure func compiler_register_imports_decl_syntax(
	state: CompilerTypecheckState,
	decl: ParsedDecl,
) -> CompilerTypecheckState:
	match decl:
		ImportBlockParsedDecl(imports, _):
			var next: CompilerTypecheckState = state

			for import_decl in imports:
				next = compiler_register_import_decl_syntax(next, import_decl)

			next
		PrivateParsedDecl(inner, _):
			compiler_register_imports_decl_syntax(state, inner)
		_:
			state


pure func compiler_register_program_import_syntax(
	state: CompilerTypecheckState,
	program: ParsedProgram,
) -> CompilerTypecheckState:
	var current: CompilerTypecheckState = state

	for decl in program.decls:
		current = compiler_register_imports_decl_syntax(current, decl)

	current


private pure func compiler_import_not_loaded_error(
	state: CompilerTypecheckState,
	module_path: String,
) -> CompilerTypecheckState:
	compiler_typecheck_state_add_error(
		state,
		"module '" + module_path + "' is not loaded for import registration",
	)


private pure func compiler_import_ambiguous_module_error(
	state: CompilerTypecheckState,
	module_path: String,
	canonical_paths: List[String],
) -> CompilerTypecheckState:
	quoted_paths = canonical_paths.map(func(path): "'" + path + "'")
	compiler_typecheck_state_add_error(
		state,
		"module '" + module_path + "' is ambiguous; it matches " + quoted_paths.join(" and "),
	)


private pure func compiler_import_duplicate_module_error(
	state: CompilerTypecheckState,
	module_path: String,
) -> CompilerTypecheckState:
	compiler_typecheck_state_add_error(
		state,
		"module '" + compiler_import_default_alias(module_path) + "' is already imported",
	)


private pure func compiler_import_std_package_error(
	state: CompilerTypecheckState,
) -> CompilerTypecheckState:
	compiler_typecheck_state_add_error(
		state,
		"standard library modules cannot import package modules",
	)


private pure func compiler_import_private_symbol_error(
	state: CompilerTypecheckState,
	module_path: String,
	symbol_name: String,
) -> CompilerTypecheckState:
	compiler_typecheck_state_add_error(
		state,
		"'" + symbol_name + "' is private in module '" + module_path + "' and cannot be imported",
	)


private pure func compiler_import_missing_symbol_error(
	state: CompilerTypecheckState,
	module_path: String,
	symbol_name: String,
) -> CompilerTypecheckState:
	compiler_typecheck_state_add_error(
		state,
		"'" + symbol_name + "' is not exported by module '" + module_path + "'",
	)


private pure func compiler_import_duplicate_symbol_error(
	state: CompilerTypecheckState,
	local_name: String,
) -> CompilerTypecheckState:
	compiler_typecheck_state_add_error(
		state,
		"'" + local_name + "' is already imported from this module",
	)


private pure func compiler_record_imported_type_symbol(
	state: CompilerTypecheckState,
	module_path: String,
	local_name: String,
	symbol: ModuleSurfaceSymbol,
) -> CompilerTypecheckState:
	if compiler_import_symbol_kind_is_type_like(symbol.kind):
		compiler_typecheck_state_record_type_home(
			compiler_typecheck_state_add_known_type_name(state, local_name),
			local_name,
			module_path,
			True,
		)
	else:
		state


private pure func compiler_register_import_symbol(
	state: CompilerTypecheckState,
	imported_module: CompilerImportableModuleSurface,
	symbol: ParsedImportSymbol,
) -> CompilerTypecheckState:
	module_path: String = imported_module.module_path
	original_name: String = symbol.name.text
	local_name: String = compiler_import_symbol_local_name(symbol)

	match compiler_find_surface_symbol(imported_module.surface.exports, original_name):
		Some(exported_symbol):
			registration = compiler_typecheck_state_register_imported_name(
				state,
				local_name,
				module_path,
				original_name,
			)

			if registration.registered:
				var next: CompilerTypecheckState = compiler_record_imported_type_symbol(
					registration.state,
					module_path,
					local_name,
					exported_symbol,
				)

				for constructor in symbol.constructors:
					next = compiler_register_import_constructor(next, module_path, constructor)

				next
			else:
				registration.state
		None:
			match compiler_find_surface_symbol(
				imported_module.surface.private_names,
				original_name,
			):
				Some(_):
					compiler_import_private_symbol_error(state, module_path, original_name)
				None:
					compiler_import_missing_symbol_error(state, module_path, original_name)


private pure func compiler_register_import_symbols(
	state: CompilerTypecheckState,
	imported_module: CompilerImportableModuleSurface,
	symbols: List[ParsedImportSymbol],
) -> CompilerTypecheckState:
	var current: CompilerTypecheckState = state
	var seen_local_names: List[String] = []

	for symbol in symbols:
		local_name: String = compiler_import_symbol_local_name(symbol)

		if seen_local_names.contains(local_name):
			current = compiler_import_duplicate_symbol_error(current, local_name)
		else:
			seen_local_names = seen_local_names.append(local_name)
			current = compiler_register_import_symbol(current, imported_module, symbol)

	current


private pure func compiler_register_import_alias_if_present(
	state: CompilerTypecheckState,
	imported_module: CompilerImportableModuleSurface,
	maybe_alias: Option[String],
) -> CompilerTypecheckState:
	match maybe_alias:
		Some(alias_name):
			compiler_typecheck_state_register_module_alias(
				state,
				alias_name,
				imported_module.module_path,
			)
		None:
			state


private pure func compiler_register_import_decl_indexed(
	state: CompilerTypecheckState,
	index: CompilerImportModuleIndex,
	decl: ParsedImportDecl,
) -> CompilerTypecheckState:
	match compiler_find_importable_module(index, decl.module_path):
		CompilerImportModuleMissing:
			compiler_import_not_loaded_error(state, decl.module_path)
		CompilerImportModuleAmbiguous(canonical_paths):
			compiler_import_ambiguous_module_error(state, decl.module_path, canonical_paths)
		CompilerImportModuleFound(imported_module):
			if (
				compiler_typecheck_state_is_stdlib(state)
				and module_origin_is_package(imported_module.origin)
			):
				compiler_import_std_package_error(state)
			else if compiler_typecheck_state_has_imported_module(
				state,
				imported_module.module_path,
			):
				compiler_import_duplicate_module_error(state, decl.module_path)
			else:
				with_module = compiler_typecheck_state_add_imported_module(
					state,
					imported_module.module_path,
				)

				match decl.symbols:
					Some(symbols):
						with_symbols = compiler_register_import_symbols(
							with_module,
							imported_module,
							symbols,
						)
						compiler_register_import_alias_if_present(
							with_symbols,
							imported_module,
							compiler_import_decl_explicit_alias(decl),
						)
					None:
						alias_name: String = match compiler_import_decl_explicit_alias(decl):
							Some(explicit_alias):
								explicit_alias
							None:
								compiler_import_default_alias(decl.module_path)

						compiler_typecheck_state_register_module_alias(
							with_module,
							alias_name,
							imported_module.module_path,
						)


private pure func compiler_register_import_decls_indexed(
	state: CompilerTypecheckState,
	index: CompilerImportModuleIndex,
	imports: List[ParsedImportDecl],
) -> CompilerTypecheckState:
	var current: CompilerTypecheckState = state

	for import_decl in imports:
		current = compiler_register_import_decl_indexed(current, index, import_decl)

	current


pure func compiler_register_import_decls(
	state: CompilerTypecheckState,
	modules: List[CompilerImportableModuleSurface],
	imports: List[ParsedImportDecl],
) -> CompilerTypecheckState:
	compiler_register_import_decls_indexed(state, compiler_import_module_index(modules), imports)


pure func compiler_register_program_imports(
	state: CompilerTypecheckState,
	modules: List[CompilerImportableModuleSurface],
	program: ParsedProgram,
) -> CompilerTypecheckState:
	var current: CompilerTypecheckState = state
	index = compiler_import_module_index(modules)

	for decl in program.decls:
		match decl:
			ImportBlockParsedDecl(imports, _):
				current = compiler_register_import_decls_indexed(current, index, imports)
			_:
				void

	current
