-- All-or-nothing module-view product built from an accepted indexed graph.
--
-- View binding remains an explicit callback boundary while ordinary and CTFE
-- preparation are migrated onto one policy. The graph owner controls module
-- order and identity association, so callers cannot pair views and modules by
-- maintaining parallel lists.
import:
	../../stage_03_parse/parsed_ast: ParsedProgram
	../../stage_04_modules/loaded_module:
		ModuleIdentity,
		module_identities_equal,
		module_identity_display_name,
	../diagnostic: TypecheckDiagnostic
	../graph/indexed_graph:
		IndexedGraph,
		IndexedGraphError,
		PreparedModule,
		PreparedModuleScope,
		indexed_graph_error_message,
		indexed_graph_select_dependency_scopes,
		indexed_graph_target_scope,
		prepared_module_identity,
		prepared_module_scope_canonical_path,
		prepared_module_scope_identity,
	module_binding: ImportableModule, importable_module_path
	module_view: ModuleView


private record BoundModuleVisibilityRep {
	visible_import_modules: List[ImportableModule],
	direct_import_modules: List[ImportableModule]
}


opaque type BoundModuleVisibility = BoundModuleVisibilityRep


union BoundModuleVisibilityBuild:
	BoundModuleVisibilityReady(BoundModuleVisibility)
	BoundModuleVisibilityDuplicateVisible(String)
	BoundModuleVisibilityDuplicateDirect(String)
	BoundModuleVisibilityDirectNotVisible(String)


private EMPTY_BOUND_MODULE_VISIBILITY_REP: BoundModuleVisibilityRep = {
	visible_import_modules = [],
	direct_import_modules = []
}


private pure func bound_module_visibility_from_rep(
	representation: BoundModuleVisibilityRep,
) -> BoundModuleVisibility:
	into BoundModuleVisibility(representation)


COMPILER_BOUND_MODULE_VISIBILITY_EMPTY: BoundModuleVisibility = bound_module_visibility_from_rep(
	EMPTY_BOUND_MODULE_VISIBILITY_REP,
)


private record BoundModuleRep {
	scope: PreparedModuleScope,
	view: ModuleView,
	program: ParsedProgram,
	visibility: BoundModuleVisibility,
	binding_diagnostics: List[TypecheckDiagnostic]
}


opaque type BoundModule = BoundModuleRep


private record BoundModuleGraphRep {
	indexed_graph: IndexedGraph,
	target: BoundModule,
	modules: List[BoundModule],
	modules_by_canonical_path: Dict[String, BoundModule]
}


opaque type BoundModuleGraph = BoundModuleGraphRep


-- A rejected binding always has at least one diagnostic. This avoids the
-- contradictory state `Err([])` while preserving deterministic follow-ups.
union BoundModuleViewBinding:
	BoundModuleViewReady(ModuleView, ParsedProgram, BoundModuleVisibility, List[TypecheckDiagnostic])
	BoundModuleViewRejected(String, List[String])


union BoundModuleGraphError:
	BoundModuleSelectionError(IndexedGraphError)
	BoundModuleBindingError(ModuleIdentity, String)


pure func bound_module_graph_error_message(error: BoundModuleGraphError) -> String:
	match error:
		BoundModuleSelectionError(selection_error):
			indexed_graph_error_message(selection_error)
		BoundModuleBindingError(identity, message):
			"Failed to bind module '" + module_identity_display_name(identity) + "': " + message


private pure func bound_module_rep(module: BoundModule) -> BoundModuleRep:
	from BoundModule(module)


private pure func bound_module_from_scope(
	scope: PreparedModuleScope,
	view: ModuleView,
	program: ParsedProgram,
	visibility: BoundModuleVisibility,
	binding_diagnostics: List[TypecheckDiagnostic],
) -> BoundModule:
	representation: BoundModuleRep = {
		scope = scope,
		view = view,
		program = program,
		visibility = visibility,
		binding_diagnostics = binding_diagnostics
	}
	into BoundModule(representation)


private pure func bound_module_graph_rep(graph: BoundModuleGraph) -> BoundModuleGraphRep:
	from BoundModuleGraph(graph)


private pure func bound_module_graph_from_rep(
	representation: BoundModuleGraphRep,
) -> BoundModuleGraph:
	into BoundModuleGraph(representation)


pure func bound_module_scope(module: BoundModule) -> PreparedModuleScope:
	bound_module_rep(module).scope


pure func bound_module_view(module: BoundModule) -> ModuleView:
	bound_module_rep(module).view


pure func bound_module_program(module: BoundModule) -> ParsedProgram:
	bound_module_rep(module).program


pure func bound_module_binding_diagnostics(module: BoundModule) -> List[TypecheckDiagnostic]:
	bound_module_rep(module).binding_diagnostics


pure func bound_module_visibility(
	visible_import_modules: List[ImportableModule],
	direct_import_modules: List[ImportableModule],
) -> BoundModuleVisibilityBuild:
	var visible_paths: Dict[String, Bool] = {}
	var issue: Option[BoundModuleVisibilityBuild] = None

	for module in visible_import_modules:
		if issue.is_none():
			path = importable_module_path(module)

			if visible_paths.contains(path):
				issue = Some(BoundModuleVisibilityDuplicateVisible(path))
			else:
				visible_paths = visible_paths.set(path, True)

	var direct_paths: Dict[String, Bool] = {}

	for module in direct_import_modules:
		if issue.is_none():
			path = importable_module_path(module)

			if direct_paths.contains(path):
				issue = Some(BoundModuleVisibilityDuplicateDirect(path))
			else if not visible_paths.contains(path):
				issue = Some(BoundModuleVisibilityDirectNotVisible(path))
			else:
				direct_paths = direct_paths.set(path, True)

	match issue:
		Some(problem):
			problem
		None:
			representation: BoundModuleVisibilityRep = {
				visible_import_modules = visible_import_modules,
				direct_import_modules = direct_import_modules
			}
			BoundModuleVisibilityReady(bound_module_visibility_from_rep(representation))


private pure func bound_module_visibility_rep(
	visibility: BoundModuleVisibility,
) -> BoundModuleVisibilityRep:
	from BoundModuleVisibility(visibility)


pure func bound_module_visible_import_modules(module: BoundModule) -> List[ImportableModule]:
	bound_module_visibility_rep(bound_module_rep(module).visibility).visible_import_modules


pure func bound_module_direct_import_modules(module: BoundModule) -> List[ImportableModule]:
	bound_module_visibility_rep(bound_module_rep(module).visibility).direct_import_modules


pure func bound_module_identity(module: BoundModule) -> ModuleIdentity:
	prepared_module_scope_identity(bound_module_scope(module))


pure func bound_module_canonical_path(module: BoundModule) -> String:
	prepared_module_scope_canonical_path(bound_module_scope(module))


pure func bound_module_graph_indexed_graph(graph: BoundModuleGraph) -> IndexedGraph:
	bound_module_graph_rep(graph).indexed_graph


pure func bound_module_graph_target(graph: BoundModuleGraph) -> BoundModule:
	bound_module_graph_rep(graph).target


pure func bound_module_graph_modules(graph: BoundModuleGraph) -> List[BoundModule]:
	bound_module_graph_rep(graph).modules


pure func bound_module_graph_find(
	graph: BoundModuleGraph,
	identity: ModuleIdentity,
) -> Option[BoundModule]:
	key = module_identity_display_name(identity)

	match bound_module_graph_rep(graph).modules_by_canonical_path.get(key):
		Some(module):
			if module_identities_equal(bound_module_identity(module), identity):
				Some(module)
			else:
				None
		None:
			None


pure func bound_module_graph_find_canonical_path(
	graph: BoundModuleGraph,
	canonical_path: String,
) -> Option[BoundModule]:
	match bound_module_graph_rep(graph).modules_by_canonical_path.get(canonical_path):
		Some(module):
			if bound_module_canonical_path(module) == canonical_path:
				Some(module)
			else:
				None
		None:
			None


pure func bound_module_graph_modules_for_prepared(
	graph: BoundModuleGraph,
	prepared_modules: List[PreparedModule],
) -> Result[List[BoundModule], List[BoundModuleGraphError]]:
	var modules: List[BoundModule] = []
	var errors: List[BoundModuleGraphError] = []

	for prepared in prepared_modules:
		identity = prepared_module_identity(prepared)

		match bound_module_graph_find(graph, identity):
			Some(module):
				modules = modules.append(module)
			None:
				errors = errors.append(
					BoundModuleBindingError(
						identity,
						"internal typecheck error: prepared module is absent from the bound graph",
					),
				)

	if errors.length() == 0:
		Ok(modules)
	else:
		Err(errors)


private pure func bound_module_binding_errors(
	scope: PreparedModuleScope,
	first_message: String,
	additional_messages: List[String],
) -> List[BoundModuleGraphError]:
	identity = prepared_module_scope_identity(scope)
	var errors: List[BoundModuleGraphError] = [BoundModuleBindingError(identity, first_message)]

	for message in additional_messages:
		errors = errors.append(BoundModuleBindingError(identity, message))

	errors


private pure func bind_module_scope(
	scope: PreparedModuleScope,
	bind_view: pure (PreparedModuleScope) -> BoundModuleViewBinding,
) -> Result[BoundModule, List[BoundModuleGraphError]]:
	match bind_view(scope):
		BoundModuleViewReady(view, program, visibility, diagnostics):
			Ok(bound_module_from_scope(scope, view, program, visibility, diagnostics))
		BoundModuleViewRejected(first_message, additional_messages):
			Err(bound_module_binding_errors(scope, first_message, additional_messages))


pure func bound_module_build(
	scope: PreparedModuleScope,
	bind_view: pure (PreparedModuleScope) -> BoundModuleViewBinding,
) -> Result[BoundModule, List[BoundModuleGraphError]]:
	bind_module_scope(scope, bind_view)


pure func bound_module_graph_build(
	indexed_graph: IndexedGraph,
	module_paths: List[String],
	bind_view: pure (PreparedModuleScope) -> BoundModuleViewBinding,
) -> Result[BoundModuleGraph, List[BoundModuleGraphError]]:
	match indexed_graph_select_dependency_scopes(indexed_graph, module_paths):
		Err(selection_errors):
			Err(selection_errors.map(
				func(error): BoundModuleSelectionError(error),
			))
		Ok(module_scopes):
			target_scope = indexed_graph_target_scope(indexed_graph)
			target_binding = bind_module_scope(target_scope, bind_view)
			var modules: List[BoundModule] = []
			var modules_by_canonical_path: Dict[String, BoundModule] = {}
			var module_errors: List[BoundModuleGraphError] = []

			match target_binding:
				Ok(bound_target):
					modules_by_canonical_path = modules_by_canonical_path.set(
						bound_module_canonical_path(bound_target),
						bound_target,
					)
				Err(_):
					void

			for scope in module_scopes:
				match bind_module_scope(scope, bind_view):
					Ok(module):
						modules = modules.append(module)
						modules_by_canonical_path = modules_by_canonical_path.set(
							bound_module_canonical_path(module),
							module,
						)
					Err(errors):
						module_errors = module_errors.concat(errors)

			match target_binding:
				Err(target_errors):
					Err(target_errors.concat(module_errors))
				Ok(bound_target):
					if module_errors.length() > 0:
						Err(module_errors)
					else:
						Ok(bound_module_graph_from_rep({
							indexed_graph = indexed_graph,
							target = bound_target,
							modules = modules,
							modules_by_canonical_path = modules_by_canonical_path,
						}))
