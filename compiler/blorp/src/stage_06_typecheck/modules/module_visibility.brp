-- Module selection and dependency visibility for Blorp-owned typechecking.
--
-- This module decides which already-prepared modules are directly imported or
-- transitively visible. It does not register semantic declarations or mutate
-- a typechecking environment.
import:
	../../stage_03_parse/parsed_ast:
		ParsedDecl(ImportBlockParsedDecl, PrivateParsedDecl),
		ParsedProgram,
	module_binding:
		CompilerImportableModule,
		CompilerImportableModuleIndex,
		CompilerImportableModuleSurface,
		compiler_importable_module_index_dependency_paths,
		compiler_importable_module_index_find,
		compiler_importable_module_index_matching_paths,
		compiler_importable_module_index_modules_for_paths,
		compiler_importable_module_path,
		compiler_importable_module_to_surface,
	set as Sets


private COMPILER_AMBIENT_TUPLE_IMPL_MODULE_PATH: String = "std/tuple"


union CompilerImportIdentityResolution:
	CompilerImportIdentityMissing
	CompilerImportIdentityFound(String)
	CompilerImportIdentityAmbiguous(List[String])


pure func compiler_importable_module_surfaces(
	modules: List[CompilerImportableModule],
) -> List[CompilerImportableModuleSurface]:
	modules.map(compiler_importable_module_to_surface)


pure func compiler_resolve_import_identity(
	index: CompilerImportableModuleIndex,
	requested_path: String,
) -> CompilerImportIdentityResolution:
	matches = compiler_importable_module_index_matching_paths(index, requested_path)

	match matches:
		[]:
			CompilerImportIdentityMissing
		[identity]:
			CompilerImportIdentityFound(identity)
		_:
			CompilerImportIdentityAmbiguous(matches)


pure func compiler_matching_import_identities(
	index: CompilerImportableModuleIndex,
	requested_path: String,
) -> List[String]:
	match compiler_resolve_import_identity(index, requested_path):
		CompilerImportIdentityMissing:
			[]
		CompilerImportIdentityFound(identity):
			[identity]
		CompilerImportIdentityAmbiguous(identities):
			identities


private pure func compiler_decl_import_identities(
	index: CompilerImportableModuleIndex,
	decls: List[ParsedDecl],
) -> List[String]:
	var identities: List[String] = []
	var seen: Set[String] = Sets.set()

	for decl in decls:
		match decl:
			ImportBlockParsedDecl(imports, _):
				for import_decl in imports:
					for module_identity in compiler_matching_import_identities(
						index,
						import_decl.module_path,
					):
						if not Sets.contains(seen, module_identity):
							identities = identities.append(module_identity)
							seen = Sets.add(seen, module_identity)
			PrivateParsedDecl(ImportBlockParsedDecl(imports, _), _):
				for import_decl in imports:
					for module_identity in compiler_matching_import_identities(
						index,
						import_decl.module_path,
					):
						if not Sets.contains(seen, module_identity):
							identities = identities.append(module_identity)
							seen = Sets.add(seen, module_identity)
			_:
				void

	identities


pure func compiler_program_import_identities(
	index: CompilerImportableModuleIndex,
	program: ParsedProgram,
) -> List[String]:
	compiler_decl_import_identities(index, program.decls)


private pure func compiler_import_module_is_current(
	module_path: String,
	current_module_path: Option[String],
) -> Bool:
	match current_module_path:
		Some(current_path):
			module_path == current_path
		None:
			False


pure func compiler_importable_modules_for_program(
	index: CompilerImportableModuleIndex,
	program: ParsedProgram,
	current_module_path: Option[String],
) -> List[CompilerImportableModule]:
	var identities: List[String] = []

	for identity in compiler_program_import_identities(index, program):
		if not compiler_import_module_is_current(identity, current_module_path):
			identities = identities.append(identity)

	compiler_importable_module_index_modules_for_paths(index, identities)


private pure func compiler_importable_module_dependency_closure(
	module_index: CompilerImportableModuleIndex,
	roots: List[CompilerImportableModule],
	current_module_path: Option[String],
) -> List[CompilerImportableModule]:
	var identities: List[String] = []
	var seen: Set[String] = Sets.set()
	var index: Int = 0

	for root in roots:
		root_identity = compiler_importable_module_path(root)

		if not Sets.contains(seen, root_identity):
			identities = identities.append(root_identity)
			seen = Sets.add(seen, root_identity)

	while index < identities.length():
		current_identity = identities.get_or(index, "")

		for dependency in compiler_importable_module_index_dependency_paths(
			module_index,
			current_identity,
		):
			if (
				not Sets.contains(seen, dependency)
				and not compiler_import_module_is_current(dependency, current_module_path)
			):
				identities = identities.append(dependency)
				seen = Sets.add(seen, dependency)

		index += 1

	compiler_importable_module_index_modules_for_paths(module_index, identities)


pure func compiler_reachable_importable_modules(
	program: ParsedProgram,
	index: CompilerImportableModuleIndex,
	current_module_path: Option[String],
) -> List[CompilerImportableModule]:
	direct_import_modules = compiler_importable_modules_for_program(
		index,
		program,
		current_module_path,
	)
	compiler_importable_module_dependency_closure(index, direct_import_modules, current_module_path)


pure func compiler_with_ambient_impl_modules(
	modules: List[CompilerImportableModule],
	index: CompilerImportableModuleIndex,
	current_module_path: Option[String],
) -> List[CompilerImportableModule]:
	match compiler_importable_module_index_find(index, COMPILER_AMBIENT_TUPLE_IMPL_MODULE_PATH):
		Some(module):
			if (
				not compiler_import_module_is_current(
					compiler_importable_module_path(module),
					current_module_path,
				)
				and not modules.any(
					func(
						existing,
					): compiler_importable_module_path(
						existing,
					) == compiler_importable_module_path(module),
				)
			):
				modules.append(module)
			else:
				modules
		None:
			modules
