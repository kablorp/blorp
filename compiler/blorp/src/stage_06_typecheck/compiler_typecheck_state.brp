-- Explicit state for the Blorp-owned typecheck first pass.
--
-- Declaration/indexing slices extend this value instead of growing separate
-- side tables.
import:
	../stage_01_file_io/compiler_source: CompilerSourceSpan
	../stage_05_types/compiler_builtins: compiler_env_with_builtins
	../stage_05_types/compiler_context:
		CompilerContext,
		CompilerModuleOrigin(CompilerStdlibModule, CompilerUserModule),
		compiler_context_empty,
		compiler_module_origin_allows_builtin,
		compiler_module_origin_allows_foreign,
		compiler_module_origin_is_package,
		compiler_module_origin_is_std,
	../stage_05_types/compiler_env: CompilerEnv, CompilerImplInstance, compiler_env_empty
	../stage_05_types/compiler_type: CompilerType, compiler_types_equal


enum CompilerTopLevelNameKind:
	CompilerTopLevelType
	CompilerTopLevelConstructor
	CompilerTopLevelFunction
	CompilerTopLevelVariable
	CompilerTopLevelTrait


enum CompilerResourceShapeTarget:
	CompilerOneShotStreamShape
	CompilerResourceSourceShape


enum CompilerValueCapabilityShape:
	CompilerOrdinaryValueCapability
	CompilerResourceValueCapability
	CompilerOneShotStreamValueCapability
	CompilerResourceSourceValueCapability


record CompilerImportedNameBinding {
	local_name: String,
	module_path: String,
	original_name: String
}


record CompilerImportBinding {
	local_name: String,
	module_path: String,
	original_name: Option[String]
}


record CompilerTopLevelName {
	name: String,
	kind: CompilerTopLevelNameKind
}


record CompilerTypecheckTypeHome {
	type_name: String,
	module_path: String,
	imported: Bool
}


record CompilerCallableSourceLoc {
	line: Int,
	column: Int,
	end_line: Int,
	end_column: Int,
	file: Option[String]
}


record CompilerFuncCallableKey {
	name: String,
	loc: CompilerCallableSourceLoc
}


record CompilerFuncCallableIdEntry {
	key: CompilerFuncCallableKey,
	def_id: Int
}


enum CompilerSourceDefinitionKind:
	CompilerConstructorDefinition
	CompilerTraitDefinition
	CompilerImplDefinition


record CompilerSourceDefinitionKey {
	kind: CompilerSourceDefinitionKind,
	name: String,
	owner: Option[String],
	loc: CompilerCallableSourceLoc
}


record CompilerSourceDefinitionIdEntry {
	key: CompilerSourceDefinitionKey,
	def_id: Int
}


record CompilerNamedComponentsMemoEntry {
	type_name: String,
	args: List[CompilerType],
	components: Option[List[CompilerType]]
}


record CompilerRecordFieldTypesMemoEntry {
	type_name: String,
	args: List[CompilerType],
	fields: Option[List[(String, CompilerType)]]
}


record CompilerRecordFieldTypeMemoEntry {
	type_name: String,
	args: List[CompilerType],
	field_name: String,
	field_type: Option[CompilerType]
}


record CompilerContainsTargetMemoEntry {
	target: CompilerResourceShapeTarget,
	rigid_type_params: List[String],
	typ: CompilerType,
	contains: Bool
}


record CompilerFunctionCarrierMemoEntry {
	target: CompilerResourceShapeTarget,
	rigid_type_params: List[String],
	typ: CompilerType,
	contains: Bool
}


record CompilerValueCapabilityMemoEntry {
	typ: CompilerType,
	capability: CompilerValueCapabilityShape
}


record CompilerTypeShapeMemo {
	named_components: List[CompilerNamedComponentsMemoEntry],
	record_field_types: List[CompilerRecordFieldTypesMemoEntry],
	record_field_type: List[CompilerRecordFieldTypeMemoEntry],
	contains_target: List[CompilerContainsTargetMemoEntry],
	function_carrier: List[CompilerFunctionCarrierMemoEntry],
	value_capabilities: List[CompilerValueCapabilityMemoEntry]
}


record CompilerTypecheckState {
	context: CompilerContext,
	env: CompilerEnv,
	errors: List[String],
	module_aliases: List[(String, String)],
	imported_names: List[CompilerImportedNameBinding],
	imported_modules: List[String],
	import_bindings: List[CompilerImportBinding],
	module_origin: CompilerModuleOrigin,
	allow_debug_only_calls: Bool,
	private_impls: List[CompilerImplInstance],
	known_type_names: List[String],
	known_resource_type_names: List[String],
	top_level_names: List[CompilerTopLevelName],
	scoped_trait_functions: List[(String, String)],
	type_homes: List[CompilerTypecheckTypeHome],
	func_callable_ids: List[CompilerFuncCallableIdEntry],
	func_callable_ids_by_name: Dict[String, List[CompilerFuncCallableIdEntry]],
	source_definition_ids: List[CompilerSourceDefinitionIdEntry],
	source_definition_ids_by_name: Dict[String, List[CompilerSourceDefinitionIdEntry]],
	type_shape_memo: CompilerTypeShapeMemo
}


record CompilerImportedNameRegistration {
	state: CompilerTypecheckState,
	registered: Bool
}


pure func compiler_type_shape_memo_empty() -> CompilerTypeShapeMemo:
	{
		named_components = [],
		record_field_types = [],
		record_field_type = [],
		contains_target = [],
		function_carrier = [],
		value_capabilities = []
	}


pure func compiler_callable_source_loc(
	line: Int,
	column: Int,
	end_line: Int,
	end_column: Int,
	file: Option[String],
) -> CompilerCallableSourceLoc:
	{
		line = line,
		column = column,
		end_line = end_line,
		end_column = end_column,
		file = file
	}


pure func compiler_func_callable_key(
	name: String,
	loc: CompilerCallableSourceLoc,
) -> CompilerFuncCallableKey:
	{
		name = name,
		loc = loc
	}


pure func compiler_callable_source_loc_from_span(
	span: CompilerSourceSpan,
) -> CompilerCallableSourceLoc:
	compiler_callable_source_loc(
		span.start_line,
		span.start_column,
		span.end_line,
		span.end_column,
		Some(span.path),
	)


pure func compiler_source_definition_key(
	kind: CompilerSourceDefinitionKind,
	name: String,
	owner: Option[String],
	span: CompilerSourceSpan,
) -> CompilerSourceDefinitionKey:
	{
		kind = kind,
		name = name,
		owner = owner,
		loc = compiler_callable_source_loc_from_span(span)
	}


pure func compiler_top_level_name_kind_label(kind: CompilerTopLevelNameKind) -> String:
	match kind:
		CompilerTopLevelType:
			"type"
		CompilerTopLevelConstructor:
			"constructor"
		CompilerTopLevelFunction:
			"function"
		CompilerTopLevelVariable:
			"variable"
		CompilerTopLevelTrait:
			"trait"


pure func compiler_top_level_name_kind_is_trait(kind: CompilerTopLevelNameKind) -> Bool:
	match kind:
		CompilerTopLevelTrait:
			True
		_:
			False


pure func compiler_typecheck_state_for_origin(
	origin: CompilerModuleOrigin,
) -> CompilerTypecheckState:
	{
		context = compiler_context_empty(),
		env = compiler_env_with_builtins(compiler_env_empty()),
		errors = [],
		module_aliases = [],
		imported_names = [],
		imported_modules = [],
		import_bindings = [],
		module_origin = origin,
		allow_debug_only_calls = False,
		private_impls = [],
		known_type_names = [],
		known_resource_type_names = [],
		top_level_names = [],
		scoped_trait_functions = [],
		type_homes = [],
		func_callable_ids = [],
		func_callable_ids_by_name = {},
		source_definition_ids = [],
		source_definition_ids_by_name = {},
		type_shape_memo = compiler_type_shape_memo_empty()
	}


pure func compiler_typecheck_state_empty() -> CompilerTypecheckState:
	compiler_typecheck_state_for_origin(CompilerUserModule)


pure func compiler_typecheck_state_stdlib() -> CompilerTypecheckState:
	compiler_typecheck_state_for_origin(CompilerStdlibModule)


pure func compiler_typecheck_state_with_debug_calls(
	state: CompilerTypecheckState,
	allow_debug_only_calls: Bool,
) -> CompilerTypecheckState:
	{ state | allow_debug_only_calls = allow_debug_only_calls }


pure func compiler_typecheck_state_with_scoped_trait_functions(
	state: CompilerTypecheckState,
	functions: List[(String, String)],
) -> CompilerTypecheckState:
	{ state | scoped_trait_functions = functions }


pure func compiler_typecheck_state_allows_scoped_trait_function(
	state: CompilerTypecheckState,
	function_name: String,
	trait_name: String,
) -> Bool:
	var found: Bool = False

	for pair in state.scoped_trait_functions:
		if pair[0] == function_name and pair[1] == trait_name:
			found = True
			break

	found


pure func compiler_typecheck_state_add_scoped_trait_function(
	state: CompilerTypecheckState,
	function_name: String,
	trait_name: String,
) -> CompilerTypecheckState:
	if compiler_typecheck_state_allows_scoped_trait_function(state, function_name, trait_name):
		state
	else:
		{ state |
			scoped_trait_functions = state.scoped_trait_functions.append(
				(function_name, trait_name),
			)
		}


pure func compiler_typecheck_state_add_error(
	state: CompilerTypecheckState,
	message: String,
) -> CompilerTypecheckState:
	{ state | errors = state.errors.append(message) }


pure func compiler_typecheck_state_allows_builtin(state: CompilerTypecheckState) -> Bool:
	compiler_module_origin_allows_builtin(state.module_origin)


pure func compiler_typecheck_state_allows_foreign(state: CompilerTypecheckState) -> Bool:
	compiler_module_origin_allows_foreign(state.module_origin)


pure func compiler_typecheck_state_is_stdlib(state: CompilerTypecheckState) -> Bool:
	compiler_module_origin_is_std(state.module_origin)


pure func compiler_typecheck_state_is_package(state: CompilerTypecheckState) -> Bool:
	compiler_module_origin_is_package(state.module_origin)


private pure func add_unique_string(values: List[String], value: String) -> List[String]:
	if values.contains(value):
		values
	else:
		values.append(value)


pure func compiler_typecheck_state_add_imported_module(
	state: CompilerTypecheckState,
	module_path: String,
) -> CompilerTypecheckState:
	{ state | imported_modules = add_unique_string(state.imported_modules, module_path) }


pure func compiler_typecheck_state_has_imported_module(
	state: CompilerTypecheckState,
	module_path: String,
) -> Bool:
	state.imported_modules.contains(module_path)


private pure func find_module_alias(
	state: CompilerTypecheckState,
	alias_name: String,
) -> Option[String]:
	var result: Option[String] = None

	for entry in state.module_aliases:
		if entry[0] == alias_name:
			result = Some(entry[1])
			break

	result


pure func compiler_typecheck_state_find_module_alias(
	state: CompilerTypecheckState,
	alias_name: String,
) -> Option[String]:
	find_module_alias(state, alias_name)


private pure func find_imported_name(
	state: CompilerTypecheckState,
	local_name: String,
) -> Option[CompilerImportedNameBinding]:
	var result: Option[CompilerImportedNameBinding] = None

	for binding in state.imported_names:
		if binding.local_name == local_name:
			result = Some(binding)
			break

	result


pure func compiler_typecheck_state_find_imported_name(
	state: CompilerTypecheckState,
	local_name: String,
) -> Option[CompilerImportedNameBinding]:
	find_imported_name(state, local_name)


private pure func find_top_level_name(
	state: CompilerTypecheckState,
	name: String,
) -> Option[CompilerTopLevelNameKind]:
	var result: Option[CompilerTopLevelNameKind] = None

	for entry in state.top_level_names:
		if entry.name == name:
			result = Some(entry.kind)
			break

	result


pure func compiler_typecheck_state_find_top_level_name(
	state: CompilerTypecheckState,
	name: String,
) -> Option[CompilerTopLevelNameKind]:
	find_top_level_name(state, name)


private pure func import_binding_matches(
	binding: CompilerImportBinding,
	local_name: String,
	module_path: String,
	original_name: Option[String],
) -> Bool:
	(
		binding.local_name == local_name
		and binding.module_path == module_path
		and binding.original_name == original_name
	)


pure func compiler_typecheck_state_has_import_binding(
	state: CompilerTypecheckState,
	local_name: String,
	module_path: String,
	original_name: Option[String],
) -> Bool:
	var found: Bool = False

	for binding in state.import_bindings:
		if import_binding_matches(binding, local_name, module_path, original_name):
			found = True
			break

	found


pure func compiler_typecheck_state_add_import_binding(
	state: CompilerTypecheckState,
	local_name: String,
	module_path: String,
	original_name: Option[String],
) -> CompilerTypecheckState:
	if compiler_typecheck_state_has_import_binding(state, local_name, module_path, original_name):
		state
	else:
		{ state | import_bindings = state.import_bindings.append({
				local_name = local_name,
				module_path = module_path,
				original_name = original_name,
			}) }


pure func compiler_typecheck_state_remember_top_level_name(
	state: CompilerTypecheckState,
	name: String,
	kind: CompilerTopLevelNameKind,
) -> CompilerTypecheckState:
	if compiler_typecheck_state_find_top_level_name(state, name).is_none():
		{ state | top_level_names = state.top_level_names.append({
				name = name,
				kind = kind,
			}) }
	else:
		state


private pure func module_alias_collision_message(
	state: CompilerTypecheckState,
	alias_name: String,
	canonical_name: String,
) -> Option[String]:
	match find_module_alias(state, alias_name):
		Some(existing_module):
			if existing_module == canonical_name:
				None
			else:
				Some(
					"module alias '" + alias_name + "' already used for module '" + existing_module + "'",
				)
		None:
			match find_imported_name(state, alias_name):
				Some(binding):
					Some(
						"module alias '" + alias_name + "' conflicts with imported name from '" + binding.module_path + "'",
					)
				None:
					match find_top_level_name(state, alias_name):
						Some(kind):
							Some(
								"module alias '" + alias_name + "' conflicts with " + compiler_top_level_name_kind_label(
									kind,
								) + " '" + alias_name + "' declared in this module",
							)
						None:
							None


pure func compiler_typecheck_state_register_module_alias(
	state: CompilerTypecheckState,
	alias_name: String,
	canonical_name: String,
) -> CompilerTypecheckState:
	match module_alias_collision_message(state, alias_name, canonical_name):
		Some(message):
			compiler_typecheck_state_add_error(state, message)
		None:
			updated = if find_module_alias(state, alias_name).is_none():
				{ state |
					module_aliases = state.module_aliases.append((alias_name, canonical_name))
				}
			else:
				state

			compiler_typecheck_state_add_import_binding(updated, alias_name, canonical_name, None)


private pure func imported_name_collision_message(
	state: CompilerTypecheckState,
	local_name: String,
	module_path: String,
	original_name: String,
) -> Option[String]:
	match find_imported_name(state, local_name):
		Some(binding):
			if (
				binding.original_name == local_name
				and original_name == local_name
				and binding.module_path != module_path
			):
				Some(
					"Ambiguous import: '" + local_name + "' is already imported from '" + binding.module_path + "'",
				)
			else:
				Some(
					"imported name '" + local_name + "' is already imported from '" + binding.module_path + "'; use a distinct alias",
				)
		None:
			match find_module_alias(state, local_name):
				Some(existing_module):
					Some(
						"imported name '" + local_name + "' is already used as module alias for '" + existing_module + "'",
					)
				None:
					match find_top_level_name(state, local_name):
						Some(kind):
							Some(
								"imported name '" + local_name + "' conflicts with " + compiler_top_level_name_kind_label(
									kind,
								) + " '" + local_name + "' declared in this module",
							)
						None:
							None


pure func compiler_typecheck_state_register_imported_name(
	state: CompilerTypecheckState,
	local_name: String,
	module_path: String,
	original_name: String,
) -> CompilerImportedNameRegistration:
	match imported_name_collision_message(state, local_name, module_path, original_name):
		Some(message):
			{
				state = compiler_typecheck_state_add_error(state, message),
				registered = False
			}
		None:
			with_name = { state | imported_names = state.imported_names.append({
					local_name = local_name,
					module_path = module_path,
					original_name = original_name,
				}) }
			{
				state = compiler_typecheck_state_add_import_binding(
					with_name,
					local_name,
					module_path,
					Some(original_name),
				),
				registered = True
			}


pure func compiler_typecheck_state_add_known_type_name(
	state: CompilerTypecheckState,
	name: String,
) -> CompilerTypecheckState:
	{ state | known_type_names = add_unique_string(state.known_type_names, name) }


pure func compiler_typecheck_state_add_known_resource_type_name(
	state: CompilerTypecheckState,
	name: String,
) -> CompilerTypecheckState:
	{ compiler_typecheck_state_add_known_type_name(state, name) |
		known_resource_type_names = add_unique_string(state.known_resource_type_names, name)
	}


pure func compiler_typecheck_state_has_known_type_name(
	state: CompilerTypecheckState,
	name: String,
) -> Bool:
	state.known_type_names.contains(name)


pure func compiler_typecheck_state_has_known_resource_type_name(
	state: CompilerTypecheckState,
	name: String,
) -> Bool:
	state.known_resource_type_names.contains(name)


private pure func type_home_matches(home: CompilerTypecheckTypeHome, name: String) -> Bool:
	home.type_name == name


private pure func replace_type_home(
	homes: List[CompilerTypecheckTypeHome],
	replacement: CompilerTypecheckTypeHome,
) -> List[CompilerTypecheckTypeHome]:
	var result: List[CompilerTypecheckTypeHome] = []
	var replaced: Bool = False

	for home in homes:
		if type_home_matches(home, replacement.type_name):
			result = result.append(replacement)
			replaced = True
		else:
			result = result.append(home)

	if replaced:
		result
	else:
		result.append(replacement)


private pure func find_type_home_entry(
	state: CompilerTypecheckState,
	type_name: String,
) -> Option[CompilerTypecheckTypeHome]:
	var result: Option[CompilerTypecheckTypeHome] = None

	for home in state.type_homes:
		if home.type_name == type_name:
			result = Some(home)
			break

	result


pure func compiler_typecheck_state_find_type_home(
	state: CompilerTypecheckState,
	type_name: String,
) -> Option[String]:
	find_type_home_entry(state, type_name).map(func(home): home.module_path)


pure func compiler_typecheck_state_type_home_is_imported(
	state: CompilerTypecheckState,
	type_name: String,
) -> Bool:
	match find_type_home_entry(state, type_name):
		Some(home):
			home.imported
		None:
			False


pure func compiler_typecheck_state_type_home_matches(
	state: CompilerTypecheckState,
	type_name: String,
	module_path: String,
) -> Bool:
	compiler_typecheck_state_find_type_home(state, type_name) == Some(module_path)


pure func compiler_typecheck_state_record_type_home(
	state: CompilerTypecheckState,
	type_name: String,
	module_path: String,
	imported: Bool,
) -> CompilerTypecheckState:
	match compiler_typecheck_state_find_type_home(state, type_name):
		Some(_):
			if imported:
				state
			else:
				{ state | type_homes = replace_type_home(
						state.type_homes,
						{
							type_name = type_name,
							module_path = module_path,
							imported = False
						},
					) }
		None:
			{ state | type_homes = state.type_homes.append({
					type_name = type_name,
					module_path = module_path,
					imported = imported,
				}) }


private pure func callable_locs_equal(
	left: CompilerCallableSourceLoc,
	right: CompilerCallableSourceLoc,
) -> Bool:
	(
		left.line == right.line
		and left.column == right.column
		and left.end_line == right.end_line
		and left.end_column == right.end_column
		and left.file == right.file
	)


pure func compiler_func_callable_keys_equal(
	left: CompilerFuncCallableKey,
	right: CompilerFuncCallableKey,
) -> Bool:
	left.name == right.name and callable_locs_equal(left.loc, right.loc)


private pure func replace_callable_id(
	entries: List[CompilerFuncCallableIdEntry],
	replacement: CompilerFuncCallableIdEntry,
) -> List[CompilerFuncCallableIdEntry]:
	var result: List[CompilerFuncCallableIdEntry] = []
	var replaced: Bool = False

	for entry in entries:
		if compiler_func_callable_keys_equal(entry.key, replacement.key):
			result = result.append(replacement)
			replaced = True
		else:
			result = result.append(entry)

	if replaced:
		result
	else:
		result.append(replacement)


private pure func index_callable_ids_by_name(
	entries: List[CompilerFuncCallableIdEntry],
) -> Dict[String, List[CompilerFuncCallableIdEntry]]:
	var result: Dict[String, List[CompilerFuncCallableIdEntry]] = {}

	for entry in entries:
		result = result.set(
			entry.key.name,
			result
				.get(entry.key.name)
				.get_or([])
				.append(entry),
		)

	result


pure func compiler_typecheck_state_record_func_callable_id(
	state: CompilerTypecheckState,
	key: CompilerFuncCallableKey,
	def_id: Int,
) -> CompilerTypecheckState:
	match compiler_typecheck_state_find_func_callable_id(state, key):
		Some(existing_id):
			if existing_id == def_id:
				state
			else:
				replacement: CompilerFuncCallableIdEntry = {
					key = key,
					def_id = def_id
				}
				{ state |
					func_callable_ids = replace_callable_id(state.func_callable_ids, replacement),
					func_callable_ids_by_name = state.func_callable_ids_by_name.set(
						key.name,
						replace_callable_id(
							state.func_callable_ids_by_name
								.get(key.name)
								.get_or([]),
							replacement,
						),
					)
				}
		None:
			entry: CompilerFuncCallableIdEntry = {
				key = key,
				def_id = def_id
			}
			{ state |
				func_callable_ids = state.func_callable_ids.append(entry),
				func_callable_ids_by_name = state.func_callable_ids_by_name.set(
					key.name,
					state.func_callable_ids_by_name
						.get(key.name)
						.get_or([])
						.append(entry),
				)
			}


pure func compiler_typecheck_state_find_func_callable_id(
	state: CompilerTypecheckState,
	key: CompilerFuncCallableKey,
) -> Option[Int]:
	var result: Option[Int] = None

	for entry in (
		state.func_callable_ids_by_name
			.get(key.name)
			.get_or([])
	):
		if compiler_func_callable_keys_equal(entry.key, key):
			result = Some(entry.def_id)
			break

	result


pure func compiler_source_definition_keys_equal(
	left: CompilerSourceDefinitionKey,
	right: CompilerSourceDefinitionKey,
) -> Bool:
	(
		left.kind == right.kind
		and left.name == right.name
		and left.owner == right.owner
		and callable_locs_equal(left.loc, right.loc)
	)


private pure func replace_source_definition_id(
	entries: List[CompilerSourceDefinitionIdEntry],
	replacement: CompilerSourceDefinitionIdEntry,
) -> List[CompilerSourceDefinitionIdEntry]:
	var result: List[CompilerSourceDefinitionIdEntry] = []
	var replaced: Bool = False

	for entry in entries:
		if compiler_source_definition_keys_equal(entry.key, replacement.key):
			result = result.append(replacement)
			replaced = True
		else:
			result = result.append(entry)

	if replaced:
		result
	else:
		result.append(replacement)


private pure func index_source_definition_ids_by_name(
	entries: List[CompilerSourceDefinitionIdEntry],
) -> Dict[String, List[CompilerSourceDefinitionIdEntry]]:
	var result: Dict[String, List[CompilerSourceDefinitionIdEntry]] = {}

	for entry in entries:
		result = result.set(
			entry.key.name,
			result
				.get(entry.key.name)
				.get_or([])
				.append(entry),
		)

	result


pure func compiler_typecheck_state_record_source_definition_id(
	state: CompilerTypecheckState,
	key: CompilerSourceDefinitionKey,
	def_id: Int,
) -> CompilerTypecheckState:
	match compiler_typecheck_state_find_source_definition_id(state, key):
		Some(existing_id):
			if existing_id == def_id:
				state
			else:
				replacement: CompilerSourceDefinitionIdEntry = {
					key = key,
					def_id = def_id
				}
				{ state |
					source_definition_ids = replace_source_definition_id(
						state.source_definition_ids,
						replacement,
					),
					source_definition_ids_by_name = state.source_definition_ids_by_name.set(
						key.name,
						replace_source_definition_id(
							state.source_definition_ids_by_name
								.get(key.name)
								.get_or([]),
							replacement,
						),
					)
				}
		None:
			entry: CompilerSourceDefinitionIdEntry = {
				key = key,
				def_id = def_id
			}
			{ state |
				source_definition_ids = state.source_definition_ids.append(entry),
				source_definition_ids_by_name = state.source_definition_ids_by_name.set(
					key.name,
					state.source_definition_ids_by_name
						.get(key.name)
						.get_or([])
						.append(entry),
				)
			}


pure func compiler_typecheck_state_find_source_definition_id(
	state: CompilerTypecheckState,
	key: CompilerSourceDefinitionKey,
) -> Option[Int]:
	var result: Option[Int] = None

	for entry in (
		state.source_definition_ids_by_name
			.get(key.name)
			.get_or([])
	):
		if compiler_source_definition_keys_equal(entry.key, key):
			result = Some(entry.def_id)
			break

	result


pure func compiler_typecheck_state_with_reserved_definition_ids(
	state: CompilerTypecheckState,
	func_callable_ids: List[CompilerFuncCallableIdEntry],
	source_definition_ids: List[CompilerSourceDefinitionIdEntry],
	next_def_id: Int,
) -> CompilerTypecheckState:
	{ state |
		env = { state.env | next_def_id = next_def_id },
		func_callable_ids = func_callable_ids,
		func_callable_ids_by_name = index_callable_ids_by_name(func_callable_ids),
		source_definition_ids = source_definition_ids,
		source_definition_ids_by_name = index_source_definition_ids_by_name(source_definition_ids)
	}


pure func compiler_typecheck_state_add_private_impl(
	state: CompilerTypecheckState,
	instance: CompilerImplInstance,
) -> CompilerTypecheckState:
	{ state | private_impls = state.private_impls.append(instance) }


pure func compiler_typecheck_state_find_private_impl_conflict(
	state: CompilerTypecheckState,
	candidate: CompilerImplInstance,
) -> Option[CompilerImplInstance]:
	var result: Option[CompilerImplInstance] = None

	for existing in state.private_impls:
		if (
			not existing.is_builtin
			and not candidate.is_builtin
			and existing.trait_name == candidate.trait_name
			and compiler_types_equal(existing.for_type, candidate.for_type)
		):
			result = Some(existing)
			break

	result
