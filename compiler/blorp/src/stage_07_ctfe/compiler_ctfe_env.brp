-- Lexical environment operations for compile-time evaluation.
--
-- The OCaml evaluator stores mutable cells in bindings. In Blorp we keep the
-- same semantic model but return updated environments from assignment, so
-- local CTFE execution stays value-oriented.
import:
	../stage_01_file_io/compiler_source: CompilerSourceSpan
	compiler_ctfe_value:
		CompilerCtfeBinding,
		CompilerCtfeBindingScope(CompilerCtfeGlobalBinding, CompilerCtfeLocalBinding),
		CompilerCtfeBindingValue(CompilerCtfeAvailableValue, CompilerCtfeUnavailableGlobal),
		CompilerCtfeEnv,
		CompilerCtfeUnavailableGlobalReason,
		CompilerCtfeValue,
		compiler_ctfe_env_unsafe_from_representation,
		compiler_ctfe_env_unsafe_representation,
		compiler_ctfe_void,


union CompilerCtfeEnvError:
	CompilerCtfeUnknownBinding(String)
	CompilerCtfeUnavailableBinding(String, CompilerCtfeUnavailableGlobalReason)
	CompilerCtfeImmutableAssignment(String)


record CompilerCtfeAssignResult {
	env: CompilerCtfeEnv,
	value: CompilerCtfeValue
}


pure func compiler_ctfe_env_empty() -> CompilerCtfeEnv:
	compiler_ctfe_env_unsafe_from_representation([])


pure func compiler_ctfe_env_length(env: CompilerCtfeEnv) -> Int:
	compiler_ctfe_env_unsafe_representation(env).length()


pure func compiler_ctfe_env_concat(
	nearer: CompilerCtfeEnv,
	farther: CompilerCtfeEnv,
) -> CompilerCtfeEnv:
	compiler_ctfe_env_unsafe_from_representation(
		compiler_ctfe_env_unsafe_representation(
			nearer,
		).concat(compiler_ctfe_env_unsafe_representation(farther)),
	)


pure func compiler_ctfe_available_binding(
	scope: CompilerCtfeBindingScope,
	is_mutable: Bool,
	value: CompilerCtfeValue,
) -> CompilerCtfeBinding:
	{
		scope = scope,
		is_mutable = is_mutable,
		value = CompilerCtfeAvailableValue(value)
	}


pure func compiler_ctfe_unavailable_global_binding(
	reason: CompilerCtfeUnavailableGlobalReason,
) -> CompilerCtfeBinding:
	{
		scope = CompilerCtfeGlobalBinding,
		is_mutable = False,
		value = CompilerCtfeUnavailableGlobal(reason)
	}


private pure func compiler_ctfe_should_bind_name(name: String) -> Bool:
	name != "_"


private pure func compiler_ctfe_env_cons_binding(
	env: CompilerCtfeEnv,
	name: String,
	binding: CompilerCtfeBinding,
) -> CompilerCtfeEnv:
	if compiler_ctfe_should_bind_name(name):
		compiler_ctfe_env_unsafe_from_representation(
			[(name, binding)].concat(compiler_ctfe_env_unsafe_representation(env)),
		)
	else:
		env


pure func compiler_ctfe_bind_local_value(
	env: CompilerCtfeEnv,
	name: String,
	value: CompilerCtfeValue,
) -> CompilerCtfeEnv:
	compiler_ctfe_env_cons_binding(
		env,
		name,
		compiler_ctfe_available_binding(CompilerCtfeLocalBinding, False, value),
	)


pure func compiler_ctfe_bind_mutable_local_value(
	env: CompilerCtfeEnv,
	name: String,
	value: CompilerCtfeValue,
) -> CompilerCtfeEnv:
	compiler_ctfe_env_cons_binding(
		env,
		name,
		compiler_ctfe_available_binding(CompilerCtfeLocalBinding, True, value),
	)


pure func compiler_ctfe_bind_global_value(
	env: CompilerCtfeEnv,
	name: String,
	value: CompilerCtfeValue,
) -> CompilerCtfeEnv:
	compiler_ctfe_env_cons_binding(
		env,
		name,
		compiler_ctfe_available_binding(CompilerCtfeGlobalBinding, False, value),
	)


pure func compiler_ctfe_bind_unavailable_global(
	env: CompilerCtfeEnv,
	name: String,
	reason: CompilerCtfeUnavailableGlobalReason,
) -> CompilerCtfeEnv:
	compiler_ctfe_env_cons_binding(env, name, compiler_ctfe_unavailable_global_binding(reason))


pure func compiler_ctfe_global_bindings(env: CompilerCtfeEnv) -> CompilerCtfeEnv:
	compiler_ctfe_env_unsafe_from_representation(
		compiler_ctfe_env_unsafe_representation(
			env,
		).filter(func(entry: (String, CompilerCtfeBinding)):
			(_, binding) = entry
			binding.scope == CompilerCtfeGlobalBinding
		),
	)


pure func compiler_ctfe_project_existing_bindings(
	scoped_env: CompilerCtfeEnv,
	base_env: CompilerCtfeEnv,
) -> CompilerCtfeEnv:
	scoped_len = compiler_ctfe_env_length(scoped_env)
	base_len = compiler_ctfe_env_length(base_env)

	if scoped_len <= base_len:
		scoped_env
	else:
		extra_bindings = scoped_len - base_len
		var index: Int = 0
		var projected: List[(String, CompilerCtfeBinding)] = []

		for binding in compiler_ctfe_env_unsafe_representation(scoped_env):
			if index >= extra_bindings:
				projected = projected.append(binding)

			index += 1

		compiler_ctfe_env_unsafe_from_representation(projected)


pure func compiler_ctfe_has_local_bindings(env: CompilerCtfeEnv) -> Bool:
	compiler_ctfe_env_unsafe_representation(env).any(func(entry: (String, CompilerCtfeBinding)):
		(_, binding) = entry
		binding.scope == CompilerCtfeLocalBinding
	)


pure func compiler_ctfe_env_has_binding(env: CompilerCtfeEnv, name: String) -> Bool:
	compiler_ctfe_env_unsafe_representation(env).any(func(entry: (String, CompilerCtfeBinding)):
		(candidate_name, _) = entry
		candidate_name == name
	)


pure func compiler_ctfe_lookup_binding(
	env: CompilerCtfeEnv,
	name: String,
) -> Result[CompilerCtfeBinding, CompilerCtfeEnvError]:
	var result: Option[CompilerCtfeBinding] = None

	for (candidate_name, binding) in compiler_ctfe_env_unsafe_representation(env):
		if result.is_none() and candidate_name == name:
			result = Some(binding)

	match result:
		Some(binding):
			match binding.value:
				CompilerCtfeAvailableValue(_):
					Ok(binding)
				CompilerCtfeUnavailableGlobal(reason):
					Err(CompilerCtfeUnavailableBinding(name, reason))
		None:
			Err(CompilerCtfeUnknownBinding(name))


pure func compiler_ctfe_lookup_value(
	env: CompilerCtfeEnv,
	name: String,
) -> Result[CompilerCtfeValue, CompilerCtfeEnvError]:
	binding ?= compiler_ctfe_lookup_binding(env, name)

	match binding.value:
		CompilerCtfeAvailableValue(value):
			Ok(value)
		CompilerCtfeUnavailableGlobal(reason):
			Err(CompilerCtfeUnavailableBinding(name, reason))


private pure func compiler_ctfe_replace_binding(
	env: CompilerCtfeEnv,
	name: String,
	replacement: CompilerCtfeBinding,
) -> CompilerCtfeEnv:
	var replaced: Bool = False
	var result: List[(String, CompilerCtfeBinding)] = []

	for (candidate_name, binding) in compiler_ctfe_env_unsafe_representation(env):
		if not replaced and candidate_name == name:
			result = result.append((candidate_name, replacement))
			replaced = True
		else:
			result = result.append((candidate_name, binding))

	compiler_ctfe_env_unsafe_from_representation(result)


pure func compiler_ctfe_assign_value(
	env: CompilerCtfeEnv,
	span: CompilerSourceSpan,
	name: String,
	value: CompilerCtfeValue,
) -> Result[CompilerCtfeAssignResult, CompilerCtfeEnvError]:
	binding ?= compiler_ctfe_lookup_binding(env, name)

	if not binding.is_mutable:
		Err(CompilerCtfeImmutableAssignment(name))
	else:
		replacement: CompilerCtfeBinding = { binding | value = CompilerCtfeAvailableValue(value) }
		Ok({
			env = compiler_ctfe_replace_binding(env, name, replacement),
			value = compiler_ctfe_void(span),
		})


pure func compiler_ctfe_unavailable_global_message(
	name: String,
	reason: CompilerCtfeUnavailableGlobalReason,
) -> String:
	match reason:
		CompilerCtfeCurrentGlobal:
			"global constant initializer cannot reference itself: '${name}'"
		CompilerCtfeLaterGlobal:
			"global constant initializer cannot reference later global constant '${name}'"
		CompilerCtfeRuntimeInitializedGlobal:
			"global constant initializer cannot reference global '${name}' because it is not a compile-time constant"
		CompilerCtfeImportedRuntimeInitializedGlobal(module_path, original_name):
			"global constant initializer cannot reference imported value '${module_path}.${original_name}' because it is not a compile-time constant"


pure func compiler_ctfe_env_error_message(error: CompilerCtfeEnvError) -> String:
	match error:
		CompilerCtfeUnknownBinding(name):
			"global constant initializer cannot reference '${name}' before it is evaluated"
		CompilerCtfeUnavailableBinding(name, reason):
			compiler_ctfe_unavailable_global_message(name, reason)
		CompilerCtfeImmutableAssignment(name):
			"compile-time assignment target '${name}' is immutable"
