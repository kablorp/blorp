-- Compiler-owned std operations admitted to compile-time evaluation.
--
-- Keep source-name admission centralized here so CTFE support does not spread
-- across evaluator branches as ad-hoc string checks.
STD_LIST_MODULE_PATH: String = "std/list"

STD_OPTION_MODULE_PATH: String = "std/option"

STD_RESULT_MODULE_PATH: String = "std/result"

STD_STRING_MODULE_PATH: String = "std/string"


enum CompilerCtfeBuiltinIntrinsic:
	CompilerCtfeToFloat16Intrinsic
	CompilerCtfeToFloat32Intrinsic


pure func compiler_ctfe_builtin_intrinsic(
	source_name: String,
) -> Option[CompilerCtfeBuiltinIntrinsic]:
	match source_name:
		"to_float16":
			Some(CompilerCtfeToFloat16Intrinsic)
		"to_float32":
			Some(CompilerCtfeToFloat32Intrinsic)
		_:
			None


union CompilerCtfeListIntrinsic:
	CompilerCtfeListAll
	CompilerCtfeListAppend
	CompilerCtfeListAny
	CompilerCtfeListConcat
	CompilerCtfeListContains
	CompilerCtfeListFilter
	CompilerCtfeListFilterMap
	CompilerCtfeListFlatMap
	CompilerCtfeListFoldLeft
	CompilerCtfeListFoldRight
	CompilerCtfeListGet
	CompilerCtfeListGetOr
	CompilerCtfeListJoin
	CompilerCtfeListLength
	CompilerCtfeListMake
	CompilerCtfeListMap
	CompilerCtfeListMapIndexed
	CompilerCtfeListSet


union CompilerCtfeOptionIntrinsic:
	CompilerCtfeOptionAndThen
	CompilerCtfeOptionFilter
	CompilerCtfeOptionGetOr
	CompilerCtfeOptionGetOrElse
	CompilerCtfeOptionIsNone
	CompilerCtfeOptionIsSome
	CompilerCtfeOptionMap


union CompilerCtfeResultIntrinsic:
	CompilerCtfeResultAndThen
	CompilerCtfeResultGetOr
	CompilerCtfeResultGetOrElse
	CompilerCtfeResultIsErr
	CompilerCtfeResultIsOk
	CompilerCtfeResultMap
	CompilerCtfeResultMapErr


union CompilerCtfeStringIntrinsic:
	CompilerCtfeStringContains
	CompilerCtfeStringEndsWith
	CompilerCtfeStringGet
	CompilerCtfeStringGetOr
	CompilerCtfeStringIndexOf
	CompilerCtfeStringLength
	CompilerCtfeStringRawIndexOf
	CompilerCtfeStringRepeat
	CompilerCtfeStringReplace
	CompilerCtfeStringSplit
	CompilerCtfeStringStartsWith
	CompilerCtfeStringSubstring
	CompilerCtfeStringTrim


union CompilerCtfeImportedIntrinsic:
	CompilerCtfeImportedListIntrinsic(CompilerCtfeListIntrinsic)
	CompilerCtfeImportedOptionIntrinsic(CompilerCtfeOptionIntrinsic)
	CompilerCtfeImportedResultIntrinsic(CompilerCtfeResultIntrinsic)
	CompilerCtfeImportedStringIntrinsic(CompilerCtfeStringIntrinsic)


private pure func compiler_ctfe_list_intrinsic(
	source_name: String,
) -> Option[CompilerCtfeListIntrinsic]:
	match source_name:
		"all":
			Some(CompilerCtfeListAll)
		"append":
			Some(CompilerCtfeListAppend)
		"any":
			Some(CompilerCtfeListAny)
		"concat":
			Some(CompilerCtfeListConcat)
		"contains":
			Some(CompilerCtfeListContains)
		"filter":
			Some(CompilerCtfeListFilter)
		"filter_map":
			Some(CompilerCtfeListFilterMap)
		"flat_map":
			Some(CompilerCtfeListFlatMap)
		"fold_left":
			Some(CompilerCtfeListFoldLeft)
		"fold_right":
			Some(CompilerCtfeListFoldRight)
		"get":
			Some(CompilerCtfeListGet)
		"get_or":
			Some(CompilerCtfeListGetOr)
		"join":
			Some(CompilerCtfeListJoin)
		"length":
			Some(CompilerCtfeListLength)
		"list":
			Some(CompilerCtfeListMake)
		"map":
			Some(CompilerCtfeListMap)
		"map_indexed":
			Some(CompilerCtfeListMapIndexed)
		"set":
			Some(CompilerCtfeListSet)
		_:
			None


private pure func compiler_ctfe_option_intrinsic(
	source_name: String,
) -> Option[CompilerCtfeOptionIntrinsic]:
	match source_name:
		"and_then":
			Some(CompilerCtfeOptionAndThen)
		"filter":
			Some(CompilerCtfeOptionFilter)
		"get_or":
			Some(CompilerCtfeOptionGetOr)
		"get_or_else":
			Some(CompilerCtfeOptionGetOrElse)
		"is_none":
			Some(CompilerCtfeOptionIsNone)
		"is_some":
			Some(CompilerCtfeOptionIsSome)
		"map":
			Some(CompilerCtfeOptionMap)
		_:
			None


private pure func compiler_ctfe_result_intrinsic(
	source_name: String,
) -> Option[CompilerCtfeResultIntrinsic]:
	match source_name:
		"and_then":
			Some(CompilerCtfeResultAndThen)
		"get_or":
			Some(CompilerCtfeResultGetOr)
		"get_or_else":
			Some(CompilerCtfeResultGetOrElse)
		"is_err":
			Some(CompilerCtfeResultIsErr)
		"is_ok":
			Some(CompilerCtfeResultIsOk)
		"map":
			Some(CompilerCtfeResultMap)
		"map_err":
			Some(CompilerCtfeResultMapErr)
		_:
			None


private pure func compiler_ctfe_string_intrinsic(
	source_name: String,
) -> Option[CompilerCtfeStringIntrinsic]:
	match source_name:
		"contains":
			Some(CompilerCtfeStringContains)
		"ends_with":
			Some(CompilerCtfeStringEndsWith)
		"get":
			Some(CompilerCtfeStringGet)
		"get_or":
			Some(CompilerCtfeStringGetOr)
		"index_of":
			Some(CompilerCtfeStringIndexOf)
		"length":
			Some(CompilerCtfeStringLength)
		"raw_index_of":
			Some(CompilerCtfeStringRawIndexOf)
		"repeat":
			Some(CompilerCtfeStringRepeat)
		"replace":
			Some(CompilerCtfeStringReplace)
		"split":
			Some(CompilerCtfeStringSplit)
		"starts_with":
			Some(CompilerCtfeStringStartsWith)
		"substring":
			Some(CompilerCtfeStringSubstring)
		"trim":
			Some(CompilerCtfeStringTrim)
		_:
			None


pure func compiler_ctfe_imported_intrinsic(
	module_path: String,
	source_name: String,
) -> Option[CompilerCtfeImportedIntrinsic]:
	if module_path == STD_LIST_MODULE_PATH:
		match compiler_ctfe_list_intrinsic(source_name):
			Some(op):
				Some(CompilerCtfeImportedListIntrinsic(op))
			None:
				None
	else if module_path == STD_OPTION_MODULE_PATH:
		match compiler_ctfe_option_intrinsic(source_name):
			Some(op):
				Some(CompilerCtfeImportedOptionIntrinsic(op))
			None:
				None
	else if module_path == STD_RESULT_MODULE_PATH:
		match compiler_ctfe_result_intrinsic(source_name):
			Some(op):
				Some(CompilerCtfeImportedResultIntrinsic(op))
			None:
				None
	else if module_path == STD_STRING_MODULE_PATH:
		match compiler_ctfe_string_intrinsic(source_name):
			Some(op):
				Some(CompilerCtfeImportedStringIntrinsic(op))
			None:
				None
	else:
		None
