-- Compile-time evaluator context construction and lookup.
--
-- This is the metadata layer for CTFE. It indexes typed functions,
-- constructor metadata, and module global environments without performing
-- evaluation.
import:
	../stage_03_parse/compiler_parsed_ast:
		ParsedDecl(ImportBlockParsedDecl, PrivateParsedDecl, UnionParsedDecl),
		ParsedImportDecl,
		ParsedUnionDecl,
	../stage_06_typecheck/compiler_typecheck_decl:
		CompilerTypedDecl(
			CompilerTypedFunctionDecl,
			CompilerTypedImplDecl,
			CompilerTypedParsedDecl,
			CompilerTypedPrivateDecl,
			CompilerTypedUnionDecl,
		),
		CompilerTypedFunctionInfo,
		CompilerTypedProgram,
		CompilerTypedUnionInfo,
	../stage_06_typecheck/compiler_typecheck_state: CompilerImportBinding
	../stage_06_typecheck/modules/compiler_module_binding: compiler_import_default_alias
	compiler_ctfe_env:
		compiler_ctfe_env_empty,
		compiler_ctfe_env_has_binding,
		compiler_ctfe_lookup_value,
	compiler_ctfe_value:
		CompilerCtfeConstructorInfo,
		CompilerCtfeEnv,
		CompilerCtfeValue,
		compiler_ctfe_constructor_info,


record CompilerCtfeFunction {
	info: CompilerTypedFunctionInfo,
	source_name: String,
	module_path: Option[String]
}


record CompilerCtfeImportedProgram {
	module_path: String,
	program: CompilerTypedProgram,
	import_bindings: List[CompilerImportBinding]
}


record CompilerCtfeImportedFunctionGroup {
	module_path: String,
	source_name: String,
	functions: List[CompilerCtfeFunction]
}


record CompilerCtfeModuleGlobalEnv {
	module_path: String,
	env: CompilerCtfeEnv
}


record CompilerCtfeModuleAlias {
	owner_module_path: Option[String],
	local_name: String,
	module_path: String
}


record CompilerCtfeNullaryConstructorReference {
	name: String,
	parent_type: String,
	callable_id: Option[Int]
}


record CompilerCtfeContext {
	functions: List[(Int, CompilerCtfeFunction)],
	imported_functions: List[CompilerCtfeImportedFunctionGroup],
	constructors: List[(String, CompilerCtfeConstructorInfo)],
	module_aliases: List[CompilerCtfeModuleAlias],
	module_global_envs: List[CompilerCtfeModuleGlobalEnv],
	active_module_path: Option[String]
}


pure func compiler_ctfe_context_empty() -> CompilerCtfeContext:
	{
		functions = [],
		imported_functions = [],
		constructors = [],
		module_aliases = [],
		module_global_envs = [],
		active_module_path = None
	}


pure func compiler_ctfe_context_constructor_info(
	context: CompilerCtfeContext,
	name: String,
) -> Option[CompilerCtfeConstructorInfo]:
	var result: Option[CompilerCtfeConstructorInfo] = None

	for (constructor_name, info) in context.constructors:
		if result.is_none() and constructor_name == name:
			result = Some(info)
			break

	result


pure func compiler_ctfe_context_constructor_arity(
	context: CompilerCtfeContext,
	name: String,
) -> Option[Int]:
	match compiler_ctfe_context_constructor_info(context, name):
		Some(info):
			Some(info.arity)
		None:
			None


pure func compiler_ctfe_context_constructor_is_nullary(
	context: CompilerCtfeContext,
	name: String,
) -> Bool:
	compiler_ctfe_context_constructor_arity(context, name) == Some(0)


pure func compiler_ctfe_context_nullary_constructor_reference(
	context: CompilerCtfeContext,
	name: String,
) -> Option[CompilerCtfeNullaryConstructorReference]:
	match compiler_ctfe_context_constructor_info(context, name):
		Some(info):
			if info.arity == 0:
				Some({
					name = name,
					parent_type = info.parent_type,
					callable_id = info.callable_id,
				})
			else:
				None
		None:
			None


pure func compiler_ctfe_context_function_by_callable_id(
	context: CompilerCtfeContext,
	callable_id: Int,
) -> Option[CompilerCtfeFunction]:
	var result: Option[CompilerCtfeFunction] = None

	for (id, ctfe_function) in context.functions:
		if (
			result.is_none()
			and id == callable_id
			and ctfe_function.module_path == context.active_module_path
		):
			result = Some(ctfe_function)
			break

	result


pure func compiler_ctfe_context_imported_functions_by_source(
	context: CompilerCtfeContext,
	module_path: String,
	source_name: String,
) -> List[CompilerCtfeFunction]:
	var result: Option[List[CompilerCtfeFunction]] = None

	for group in context.imported_functions:
		if (
			result.is_none()
			and group.module_path == module_path
			and group.source_name == source_name
		):
			result = Some(group.functions)
			break

	result.get_or([])


pure func compiler_ctfe_context_imported_function_by_callable_id(
	context: CompilerCtfeContext,
	module_path: String,
	source_name: String,
	callable_id: Int,
) -> Option[CompilerCtfeFunction]:
	functions = compiler_ctfe_context_imported_functions_by_source(
		context,
		module_path,
		source_name,
	)
	var result: Option[CompilerCtfeFunction] = None

	for ctfe_function in functions:
		if result.is_none() and ctfe_function.info.callable_id == Some(callable_id):
			result = Some(ctfe_function)
			break

	if result.is_some():
		result
	else if functions.length() == 1:
		functions.get(0)
	else:
		None


pure func compiler_ctfe_context_module_global_env(
	context: CompilerCtfeContext,
	module_path: String,
) -> CompilerCtfeEnv:
	var result: Option[CompilerCtfeEnv] = None

	for module_env in context.module_global_envs:
		if result.is_none() and module_env.module_path == module_path:
			result = Some(module_env.env)
			break

	result.get_or(compiler_ctfe_env_empty())


pure func compiler_ctfe_context_module_global_value(
	context: CompilerCtfeContext,
	module_path: String,
	name: String,
) -> Option[CompilerCtfeValue]:
	match compiler_ctfe_lookup_value(
		compiler_ctfe_context_module_global_env(context, module_path),
		name,
	):
		Ok(value):
			Some(value)
		Err(_):
			None


pure func compiler_ctfe_context_module_alias(
	context: CompilerCtfeContext,
	local_name: String,
) -> Option[String]:
	var result: Option[String] = None

	for module_alias in context.module_aliases:
		if (
			result.is_none()
			and module_alias.owner_module_path == context.active_module_path
			and module_alias.local_name == local_name
		):
			result = Some(module_alias.module_path)
			break

	result


pure func compiler_ctfe_context_module_has_global_binding(
	context: CompilerCtfeContext,
	module_path: String,
	name: String,
) -> Bool:
	compiler_ctfe_env_has_binding(
		compiler_ctfe_context_module_global_env(context, module_path),
		name,
	)


pure func compiler_ctfe_context_with_module_alias(
	context: CompilerCtfeContext,
	local_name: String,
	module_path: String,
) -> CompilerCtfeContext:
	var replaced: Bool = False
	var aliases: List[CompilerCtfeModuleAlias] = []

	for module_alias in context.module_aliases:
		if (
			not replaced
			and module_alias.owner_module_path == context.active_module_path
			and module_alias.local_name == local_name
		):
			aliases = aliases.append({
				owner_module_path = context.active_module_path,
				local_name = local_name,
				module_path = module_path,
			})
			replaced = True
		else:
			aliases = aliases.append(module_alias)

	if not replaced:
		aliases = aliases.append({
			owner_module_path = context.active_module_path,
			local_name = local_name,
			module_path = module_path,
		})

	{ context | module_aliases = aliases }


pure func compiler_ctfe_context_with_module_global_env(
	context: CompilerCtfeContext,
	module_path: String,
	env: CompilerCtfeEnv,
) -> CompilerCtfeContext:
	var replaced: Bool = False
	var module_envs: List[CompilerCtfeModuleGlobalEnv] = []

	for module_env in context.module_global_envs:
		if not replaced and module_env.module_path == module_path:
			module_envs = module_envs.append({
				module_path = module_path,
				env = env,
			})
			replaced = True
		else:
			module_envs = module_envs.append(module_env)

	if not replaced:
		module_envs = module_envs.append({
			module_path = module_path,
			env = env,
		})

	{ context | module_global_envs = module_envs }


private pure func compiler_ctfe_import_alias(import_decl: ParsedImportDecl) -> String:
	match import_decl.module_alias:
		Some(alias_name):
			alias_name.text
		None:
			compiler_import_default_alias(import_decl.module_path)


private pure func compiler_ctfe_import_registers_module_alias(
	import_decl: ParsedImportDecl,
) -> Bool:
	match import_decl.symbols:
		Some(_):
			import_decl.module_alias.is_some()
		None:
			True


private pure func compiler_ctfe_collect_import_aliases_from_imports(
	aliases: List[CompilerCtfeModuleAlias],
	imports: List[ParsedImportDecl],
	owner_module_path: Option[String],
) -> List[CompilerCtfeModuleAlias]:
	var result = aliases

	for import_decl in imports:
		if compiler_ctfe_import_registers_module_alias(import_decl):
			result = result.append({
				owner_module_path = owner_module_path,
				local_name = compiler_ctfe_import_alias(import_decl),
				module_path = import_decl.module_path,
			})

	result


private pure func compiler_ctfe_collect_decl_import_aliases(
	aliases: List[CompilerCtfeModuleAlias],
	decl: CompilerTypedDecl,
	owner_module_path: Option[String],
) -> List[CompilerCtfeModuleAlias]:
	match decl:
		CompilerTypedParsedDecl(parsed_decl):
			match parsed_decl:
				ImportBlockParsedDecl(imports, _):
					compiler_ctfe_collect_import_aliases_from_imports(
						aliases,
						imports,
						owner_module_path,
					)
				PrivateParsedDecl(inner, _):
					compiler_ctfe_collect_decl_import_aliases(
						aliases,
						CompilerTypedParsedDecl(inner),
						owner_module_path,
					)
				_:
					aliases
		CompilerTypedPrivateDecl(inner):
			compiler_ctfe_collect_decl_import_aliases(aliases, inner, owner_module_path)
		_:
			aliases


private pure func compiler_ctfe_collect_program_import_aliases(
	aliases: List[CompilerCtfeModuleAlias],
	program: CompilerTypedProgram,
	owner_module_path: Option[String],
) -> List[CompilerCtfeModuleAlias]:
	var result = aliases

	for decl in program.decls:
		result = compiler_ctfe_collect_decl_import_aliases(result, decl, owner_module_path)

	result


private pure func compiler_ctfe_function_from_info(
	info: CompilerTypedFunctionInfo,
	module_path: Option[String],
) -> Option[CompilerCtfeFunction]:
	match info.callable_id:
		Some(_):
			Some({
				info = info,
				source_name = info.decl.name.text,
				module_path = module_path,
			})
		None:
			None


private pure func compiler_ctfe_collect_function(
	functions: List[(Int, CompilerCtfeFunction)],
	info: CompilerTypedFunctionInfo,
	module_path: Option[String],
) -> List[(Int, CompilerCtfeFunction)]:
	match (info.callable_id, compiler_ctfe_function_from_info(info, module_path)):
		(Some(callable_id), Some(ctfe_function)):
			functions.append((callable_id, ctfe_function))
		_:
			functions


private pure func compiler_ctfe_collect_decl_functions(
	functions: List[(Int, CompilerCtfeFunction)],
	decl: CompilerTypedDecl,
	module_path: Option[String],
) -> List[(Int, CompilerCtfeFunction)]:
	match decl:
		CompilerTypedFunctionDecl(info):
			compiler_ctfe_collect_function(functions, info, module_path)
		CompilerTypedImplDecl(info):
			var result = functions

			for method in info.methods:
				result = compiler_ctfe_collect_function(result, method, module_path)

			result
		CompilerTypedPrivateDecl(inner):
			compiler_ctfe_collect_decl_functions(functions, inner, module_path)
		_:
			functions


private pure func compiler_ctfe_collect_program_functions(
	functions: List[(Int, CompilerCtfeFunction)],
	program: CompilerTypedProgram,
	module_path: Option[String],
) -> List[(Int, CompilerCtfeFunction)]:
	var result = functions

	for decl in program.decls:
		result = compiler_ctfe_collect_decl_functions(result, decl, module_path)

	result


private pure func compiler_ctfe_add_imported_function_group(
	groups: List[CompilerCtfeImportedFunctionGroup],
	module_path: String,
	ctfe_function: CompilerCtfeFunction,
) -> List[CompilerCtfeImportedFunctionGroup]:
	var replaced: Bool = False
	var result: List[CompilerCtfeImportedFunctionGroup] = []

	for group in groups:
		if (
			not replaced
			and group.module_path == module_path
			and group.source_name == ctfe_function.source_name
		):
			result = result.append({
				module_path = group.module_path,
				source_name = group.source_name,
				functions = group.functions.append(ctfe_function),
			})
			replaced = True
		else:
			result = result.append(group)

	if not replaced:
		result = result.append({
			module_path = module_path,
			source_name = ctfe_function.source_name,
			functions = [ctfe_function],
		})

	result


private pure func compiler_ctfe_collect_imported_function_groups(
	groups: List[CompilerCtfeImportedFunctionGroup],
	imported: CompilerCtfeImportedProgram,
) -> List[CompilerCtfeImportedFunctionGroup]:
	var result = groups

	for decl in imported.program.decls:
		result = compiler_ctfe_collect_imported_decl_function_groups(
			result,
			imported.module_path,
			decl,
		)

	result


private pure func compiler_ctfe_add_imported_function_info(
	groups: List[CompilerCtfeImportedFunctionGroup],
	module_path: String,
	info: CompilerTypedFunctionInfo,
) -> List[CompilerCtfeImportedFunctionGroup]:
	match compiler_ctfe_function_from_info(info, Some(module_path)):
		Some(ctfe_function):
			compiler_ctfe_add_imported_function_group(groups, module_path, ctfe_function)
		None:
			groups


private pure func compiler_ctfe_collect_imported_decl_function_groups(
	groups: List[CompilerCtfeImportedFunctionGroup],
	module_path: String,
	decl: CompilerTypedDecl,
) -> List[CompilerCtfeImportedFunctionGroup]:
	match decl:
		CompilerTypedFunctionDecl(info):
			compiler_ctfe_add_imported_function_info(groups, module_path, info)
		CompilerTypedImplDecl(info):
			var result = groups

			for method in info.methods:
				result = compiler_ctfe_add_imported_function_info(result, module_path, method)

			result
		CompilerTypedPrivateDecl(inner):
			compiler_ctfe_collect_imported_decl_function_groups(groups, module_path, inner)
		_:
			groups


private pure func compiler_ctfe_collect_union_constructors(
	constructors: List[(String, CompilerCtfeConstructorInfo)],
	union_decl: ParsedUnionDecl,
) -> List[(String, CompilerCtfeConstructorInfo)]:
	var result = constructors

	for variant in union_decl.variants:
		result = result.append(
			(
				variant.name.text,
				compiler_ctfe_constructor_info(
					union_decl.name.text,
					variant.fields.length(),
					None,
				),
			),
		)

	result


private pure func compiler_ctfe_collect_typed_union_constructors(
	constructors: List[(String, CompilerCtfeConstructorInfo)],
	info: CompilerTypedUnionInfo,
) -> List[(String, CompilerCtfeConstructorInfo)]:
	var result = constructors

	for variant in info.variants:
		result = result.append(
			(
				variant.name,
				compiler_ctfe_constructor_info(
					info.decl.name.text,
					variant.fields.length(),
					variant.def_id,
				),
			),
		)

	result


private pure func compiler_ctfe_collect_decl_constructors(
	constructors: List[(String, CompilerCtfeConstructorInfo)],
	decl: CompilerTypedDecl,
) -> List[(String, CompilerCtfeConstructorInfo)]:
	match decl:
		CompilerTypedUnionDecl(info):
			compiler_ctfe_collect_typed_union_constructors(constructors, info)
		CompilerTypedParsedDecl(parsed_decl):
			match parsed_decl:
				UnionParsedDecl(union_decl):
					compiler_ctfe_collect_union_constructors(constructors, union_decl)
				PrivateParsedDecl(inner, _):
					compiler_ctfe_collect_decl_constructors(
						constructors,
						CompilerTypedParsedDecl(inner),
					)
				_:
					constructors
		CompilerTypedPrivateDecl(inner):
			compiler_ctfe_collect_decl_constructors(constructors, inner)
		_:
			constructors


private pure func compiler_ctfe_collect_program_constructors(
	constructors: List[(String, CompilerCtfeConstructorInfo)],
	program: CompilerTypedProgram,
) -> List[(String, CompilerCtfeConstructorInfo)]:
	var result = constructors

	for decl in program.decls:
		result = compiler_ctfe_collect_decl_constructors(result, decl)

	result


pure func compiler_ctfe_context_from_program(
	program: CompilerTypedProgram,
	imported_programs: List[CompilerCtfeImportedProgram],
) -> CompilerCtfeContext:
	var constructors = compiler_ctfe_collect_program_constructors([], program)

	for imported in imported_programs:
		constructors = compiler_ctfe_collect_program_constructors(constructors, imported.program)

	var functions = compiler_ctfe_collect_program_functions([], program, None)

	for imported in imported_programs:
		functions = compiler_ctfe_collect_program_functions(
			functions,
			imported.program,
			Some(imported.module_path),
		)

	var imported_groups: List[CompilerCtfeImportedFunctionGroup] = []

	for imported in imported_programs:
		imported_groups = compiler_ctfe_collect_imported_function_groups(imported_groups, imported)

	var aliases = compiler_ctfe_collect_program_import_aliases([], program, None)

	for imported in imported_programs:
		aliases = compiler_ctfe_collect_program_import_aliases(
			aliases,
			imported.program,
			Some(imported.module_path),
		)

	{
		functions = functions,
		imported_functions = imported_groups,
		constructors = constructors,
		module_aliases = aliases,
		module_global_envs = [],
		active_module_path = None
	}
