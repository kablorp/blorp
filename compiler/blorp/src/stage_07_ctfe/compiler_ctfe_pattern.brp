-- Pattern matching over compile-time values.
--
-- This stays independent from expression evaluation so function-call
-- parameter-pattern binding can reuse the same behavior later.
import:
	../stage_03_parse/compiler_parsed_ast:
		ParsedListPatternSpread(ParsedListSpreadName, ParsedListSpreadWildcard),
	../stage_06_typecheck/compiler_infer:
		TypedPattern(
			TypedBoolPattern,
			TypedCharPattern,
			TypedConstructorPattern,
			TypedFloatPattern,
			TypedIntPattern,
			TypedListPattern,
			TypedNamePattern,
			TypedOrPattern,
			TypedQualifiedConstructorPattern,
			TypedStringPattern,
			TypedTuplePattern,
			TypedUnsupportedPattern,
			TypedWildcardPattern,
		),
	compiler_ctfe_context: CompilerCtfeContext, compiler_ctfe_context_constructor_is_nullary
	compiler_ctfe_value:
		CompilerCtfeError(CompilerCtfeUnsupported),
		CompilerCtfeValue,
		CompilerCtfeValueDesc(
			CompilerCtfeBoolValue,
			CompilerCtfeCharValue,
			CompilerCtfeConstructorValue,
			CompilerCtfeFloatValue,
			CompilerCtfeIntValue,
			CompilerCtfeListValue,
			CompilerCtfeStringValue,
			CompilerCtfeTupleValue,
		),
		compiler_ctfe_value,


pure func compiler_ctfe_pattern_bind(
	context: CompilerCtfeContext,
	pattern: TypedPattern,
	value: CompilerCtfeValue,
) -> Result[Option[List[(String, CompilerCtfeValue)]], CompilerCtfeError]:
	match pattern:
		TypedWildcardPattern(_):
			Ok(Some([]))
		TypedNamePattern(name, _):
			if compiler_ctfe_context_constructor_is_nullary(context, name.text):
				match value.desc:
					CompilerCtfeConstructorValue(payload):
						if payload.name == name.text and payload.args.length() == 0:
							Ok(Some([]))
						else:
							Ok(None)
					_:
						Ok(None)
			else:
				Ok(Some([(name.text, value)]))
		TypedBoolPattern(expected, _):
			match value.desc:
				CompilerCtfeBoolValue(actual):
					if actual == expected:
						Ok(Some([]))
					else:
						Ok(None)
				_:
					Ok(None)
		TypedIntPattern(expected, _):
			match value.desc:
				CompilerCtfeIntValue(actual):
					if expected.parse_int() == Some(actual):
						Ok(Some([]))
					else:
						Ok(None)
				_:
					Ok(None)
		TypedFloatPattern(expected, _):
			match value.desc:
				CompilerCtfeFloatValue(actual):
					if expected.parse_float() == Some(actual):
						Ok(Some([]))
					else:
						Ok(None)
				_:
					Ok(None)
		TypedStringPattern(expected, _):
			match value.desc:
				CompilerCtfeStringValue(actual):
					if actual == expected:
						Ok(Some([]))
					else:
						Ok(None)
				_:
					Ok(None)
		TypedCharPattern(expected, _):
			match value.desc:
				CompilerCtfeCharValue(actual):
					if actual == to_char(expected):
						Ok(Some([]))
					else:
						Ok(None)
				_:
					Ok(None)
		TypedTuplePattern(patterns, _):
			match value.desc:
				CompilerCtfeTupleValue(values):
					compiler_ctfe_pattern_bind_list(context, patterns, values)
				_:
					Ok(None)
		TypedConstructorPattern(name, patterns, _):
			compiler_ctfe_pattern_bind_constructor(context, name.text, patterns, value)
		TypedQualifiedConstructorPattern(_, name, patterns, _):
			compiler_ctfe_pattern_bind_constructor(context, name.text, patterns, value)
		TypedListPattern(patterns, spread, _):
			match value.desc:
				CompilerCtfeListValue(values):
					compiler_ctfe_pattern_bind_list_pattern(
						context,
						patterns,
						spread,
						value,
						values,
					)
				_:
					Ok(None)
		TypedOrPattern(patterns, _):
			compiler_ctfe_pattern_bind_or(context, patterns, value)
		TypedUnsupportedPattern(label, _):
			Err(CompilerCtfeUnsupported("pattern " + label))


private pure func compiler_ctfe_pattern_bind_constructor(
	context: CompilerCtfeContext,
	name: String,
	patterns: List[TypedPattern],
	value: CompilerCtfeValue,
) -> Result[Option[List[(String, CompilerCtfeValue)]], CompilerCtfeError]:
	match value.desc:
		CompilerCtfeConstructorValue(payload):
			if payload.name == name and patterns.length() == payload.args.length():
				compiler_ctfe_pattern_bind_list(context, patterns, payload.args)
			else:
				Ok(None)
		_:
			Ok(None)


private pure func compiler_ctfe_pattern_bind_list(
	context: CompilerCtfeContext,
	patterns: List[TypedPattern],
	values: List[CompilerCtfeValue],
) -> Result[Option[List[(String, CompilerCtfeValue)]], CompilerCtfeError]:
	if patterns.length() != values.length():
		Ok(None)
	else:
		var bindings: List[(String, CompilerCtfeValue)] = []
		var matched: Bool = True
		var failure: Option[CompilerCtfeError] = None
		var index: Int = 0

		for pattern in patterns:
			match values.get(index):
				Some(value):
					match compiler_ctfe_pattern_bind(context, pattern, value):
						Ok(Some(next_bindings)):
							bindings = bindings.concat(next_bindings)
						Ok(None):
							matched = False
							break
						Err(error):
							failure = Some(error)
							break
				None:
					matched = False
					break

			index += 1

		match failure:
			Some(error):
				Err(error)
			None:
				if matched:
					Ok(Some(bindings))
				else:
					Ok(None)


private pure func compiler_ctfe_pattern_prefix_values(
	values: List[CompilerCtfeValue],
	count: Int,
) -> List[CompilerCtfeValue]:
	var result: List[CompilerCtfeValue] = []
	var index: Int = 0

	while index < count:
		match values.get(index):
			Some(value):
				result = result.append(value)
			None:
				void

		index += 1

	result


private pure func compiler_ctfe_pattern_drop_values(
	values: List[CompilerCtfeValue],
	count: Int,
) -> List[CompilerCtfeValue]:
	var result: List[CompilerCtfeValue] = []
	var index: Int = 0

	for value in values:
		if index >= count:
			result = result.append(value)

		index += 1

	result


private pure func compiler_ctfe_pattern_bind_spread(
	spread: Option[ParsedListPatternSpread],
	original: CompilerCtfeValue,
	remaining_values: List[CompilerCtfeValue],
) -> Option[List[(String, CompilerCtfeValue)]]:
	match spread:
		None:
			if remaining_values.length() == 0:
				Some([])
			else:
				None
		Some(ParsedListSpreadName(name)):
			Some(
				[
					(
						name.text,
						compiler_ctfe_value(
							original.typ,
							CompilerCtfeListValue(remaining_values),
							original.span,
						),
					),
				],
			)
		Some(ParsedListSpreadWildcard(_)):
			Some([])


private pure func compiler_ctfe_pattern_bind_list_pattern(
	context: CompilerCtfeContext,
	patterns: List[TypedPattern],
	spread: Option[ParsedListPatternSpread],
	original: CompilerCtfeValue,
	values: List[CompilerCtfeValue],
) -> Result[Option[List[(String, CompilerCtfeValue)]], CompilerCtfeError]:
	if values.length() < patterns.length():
		Ok(None)
	else:
		prefix_values = compiler_ctfe_pattern_prefix_values(values, patterns.length())
		remaining_values = compiler_ctfe_pattern_drop_values(values, patterns.length())

		match compiler_ctfe_pattern_bind_list(context, patterns, prefix_values):
			Ok(Some(prefix_bindings)):
				match compiler_ctfe_pattern_bind_spread(spread, original, remaining_values):
					Some(spread_bindings):
						Ok(Some(prefix_bindings.concat(spread_bindings)))
					None:
						Ok(None)
			Ok(None):
				Ok(None)
			Err(error):
				Err(error)


private pure func compiler_ctfe_pattern_bind_or(
	context: CompilerCtfeContext,
	patterns: List[TypedPattern],
	value: CompilerCtfeValue,
) -> Result[Option[List[(String, CompilerCtfeValue)]], CompilerCtfeError]:
	var result: Option[List[(String, CompilerCtfeValue)]] = None
	var failure: Option[CompilerCtfeError] = None

	for pattern in patterns:
		if result.is_some():
			break

		match compiler_ctfe_pattern_bind(context, pattern, value):
			Ok(Some(bindings)):
				result = Some(bindings)
			Ok(None):
				void
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(result)
