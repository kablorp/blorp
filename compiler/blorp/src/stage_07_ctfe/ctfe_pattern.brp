-- Pattern matching over compile-time values.
--
-- This stays independent from expression evaluation so function-call
-- parameter-pattern binding can reuse the same behavior later.
import:
	../stage_03_parse/parsed_ast:
		ParsedListPatternSpread(ParsedListSpreadName, ParsedListSpreadWildcard),
	../stage_06_typecheck/infer:
		TypedPattern(
			TypedBoolPattern,
			TypedCharPattern,
			TypedConstructorPattern,
			TypedFloatPattern,
			TypedIntPattern,
			TypedListPattern,
			TypedNamePattern,
			TypedOrPattern,
			TypedQualifiedConstructorPattern,
			TypedStringPattern,
			TypedTuplePattern,
			TypedUnsupportedPattern,
			TypedWildcardPattern,
		),
	ctfe_context: CtfeContext, ctfe_context_constructor_is_nullary
	ctfe_value:
		CtfeError(CtfeUnsupported),
		CtfeValue,
		CtfeValueDesc(
			CtfeBoolValue,
			CtfeCharValue,
			CtfeConstructorValue,
			CtfeFloatValue,
			CtfeIntValue,
			CtfeListValue,
			CtfeStringValue,
			CtfeTupleValue,
		),
		ctfe_value,


pure func ctfe_pattern_bind(
	context: CtfeContext,
	pattern: TypedPattern,
	value: CtfeValue,
) -> Result[Option[List[(String, CtfeValue)]], CtfeError]:
	match pattern:
		TypedWildcardPattern(_):
			Ok(Some([]))
		TypedNamePattern(name, _):
			if ctfe_context_constructor_is_nullary(context, name.text):
				match value.desc:
					CtfeConstructorValue(payload):
						if payload.name == name.text and payload.args.length() == 0:
							Ok(Some([]))
						else:
							Ok(None)
					_:
						Ok(None)
			else:
				Ok(Some([(name.text, value)]))
		TypedBoolPattern(expected, _):
			match value.desc:
				CtfeBoolValue(actual):
					if actual == expected:
						Ok(Some([]))
					else:
						Ok(None)
				_:
					Ok(None)
		TypedIntPattern(expected, _):
			match value.desc:
				CtfeIntValue(actual):
					if expected.parse_int() == Some(actual):
						Ok(Some([]))
					else:
						Ok(None)
				_:
					Ok(None)
		TypedFloatPattern(expected, _):
			match value.desc:
				CtfeFloatValue(actual):
					if expected.parse_float() == Some(actual):
						Ok(Some([]))
					else:
						Ok(None)
				_:
					Ok(None)
		TypedStringPattern(expected, _):
			match value.desc:
				CtfeStringValue(actual):
					if actual == expected:
						Ok(Some([]))
					else:
						Ok(None)
				_:
					Ok(None)
		TypedCharPattern(expected, _):
			match value.desc:
				CtfeCharValue(actual):
					if actual == to_char(expected):
						Ok(Some([]))
					else:
						Ok(None)
				_:
					Ok(None)
		TypedTuplePattern(patterns, _):
			match value.desc:
				CtfeTupleValue(values):
					ctfe_pattern_bind_list(context, patterns, values)
				_:
					Ok(None)
		TypedConstructorPattern(name, patterns, _):
			ctfe_pattern_bind_constructor(context, name.text, patterns, value)
		TypedQualifiedConstructorPattern(_, name, patterns, _):
			ctfe_pattern_bind_constructor(context, name.text, patterns, value)
		TypedListPattern(patterns, spread, _):
			match value.desc:
				CtfeListValue(values):
					ctfe_pattern_bind_list_pattern(context, patterns, spread, value, values)
				_:
					Ok(None)
		TypedOrPattern(patterns, _):
			ctfe_pattern_bind_or(context, patterns, value)
		TypedUnsupportedPattern(label, _):
			Err(CtfeUnsupported("pattern " + label))


private pure func ctfe_pattern_bind_constructor(
	context: CtfeContext,
	name: String,
	patterns: List[TypedPattern],
	value: CtfeValue,
) -> Result[Option[List[(String, CtfeValue)]], CtfeError]:
	match value.desc:
		CtfeConstructorValue(payload):
			if payload.name == name and patterns.length() == payload.args.length():
				ctfe_pattern_bind_list(context, patterns, payload.args)
			else:
				Ok(None)
		_:
			Ok(None)


private pure func ctfe_pattern_bind_list(
	context: CtfeContext,
	patterns: List[TypedPattern],
	values: List[CtfeValue],
) -> Result[Option[List[(String, CtfeValue)]], CtfeError]:
	if patterns.length() != values.length():
		Ok(None)
	else:
		var bindings: List[(String, CtfeValue)] = []
		var matched: Bool = True
		var failure: Option[CtfeError] = None
		var index: Int = 0

		for pattern in patterns:
			match values.get(index):
				Some(value):
					match ctfe_pattern_bind(context, pattern, value):
						Ok(Some(next_bindings)):
							bindings = bindings.concat(next_bindings)
						Ok(None):
							matched = False
							break
						Err(error):
							failure = Some(error)
							break
				None:
					matched = False
					break

			index += 1

		match failure:
			Some(error):
				Err(error)
			None:
				if matched:
					Ok(Some(bindings))
				else:
					Ok(None)


private pure func ctfe_pattern_prefix_values(
	values: List[CtfeValue],
	count: Int,
) -> List[CtfeValue]:
	var result: List[CtfeValue] = []
	var index: Int = 0

	while index < count:
		match values.get(index):
			Some(value):
				result = result.append(value)
			None:
				void

		index += 1

	result


private pure func ctfe_pattern_bind_spread(
	spread: Option[ParsedListPatternSpread],
	original: CtfeValue,
	remaining_values: List[CtfeValue],
) -> Option[List[(String, CtfeValue)]]:
	match spread:
		None:
			if remaining_values.length() == 0:
				Some([])
			else:
				None
		Some(ParsedListSpreadName(name)):
			Some(
				[
					(
						name.text,
						ctfe_value(
							original.typ,
							CtfeListValue(remaining_values),
							original.span,
						),
					),
				],
			)
		Some(ParsedListSpreadWildcard(_)):
			Some([])


private pure func ctfe_pattern_bind_list_pattern(
	context: CtfeContext,
	patterns: List[TypedPattern],
	spread: Option[ParsedListPatternSpread],
	original: CtfeValue,
	values: List[CtfeValue],
) -> Result[Option[List[(String, CtfeValue)]], CtfeError]:
	if values.length() < patterns.length():
		Ok(None)
	else:
		prefix_values = ctfe_pattern_prefix_values(values, patterns.length())
		remaining_values = values.drop(patterns.length())

		match ctfe_pattern_bind_list(context, patterns, prefix_values):
			Ok(Some(prefix_bindings)):
				match ctfe_pattern_bind_spread(spread, original, remaining_values):
					Some(spread_bindings):
						Ok(Some(prefix_bindings.concat(spread_bindings)))
					None:
						Ok(None)
			Ok(None):
				Ok(None)
			Err(error):
				Err(error)


private pure func ctfe_pattern_bind_or(
	context: CtfeContext,
	patterns: List[TypedPattern],
	value: CtfeValue,
) -> Result[Option[List[(String, CtfeValue)]], CtfeError]:
	var result: Option[List[(String, CtfeValue)]] = None
	var failure: Option[CtfeError] = None

	for pattern in patterns:
		if result.is_some():
			break

		match ctfe_pattern_bind(context, pattern, value):
			Ok(Some(bindings)):
				result = Some(bindings)
			Ok(None):
				void
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(result)
