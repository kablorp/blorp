-- Rewrites evaluated CTFE values back into source-shaped and typed artifacts.
--
-- The global-var helper keeps parsed and typed initializer payloads coherent
-- when CTFE replaces a top-level constant initializer.
import:
	../stage_03_parse/compiler_parsed_ast:
		ParsedDictEntry,
		ParsedExpr(
			ParsedBoolLiteralExpr,
			ParsedCallExpr,
			ParsedCharLiteralExpr,
			ParsedDictExpr,
			ParsedFloatLiteralExpr,
			ParsedIntLiteralExpr,
			ParsedListExpr,
			ParsedNameExpr,
			ParsedRangeExpr,
			ParsedRecordExpr,
			ParsedStringLiteralExpr,
			ParsedTupleExpr,
			ParsedVectorExpr,
			ParsedVoidExpr,
		),
		ParsedRecordExprField,
		ParsedStringLiteralForm(ParsedPlainStringLiteral),
		ParsedVarDecl,
		parsed_identifier,
	../stage_05_types/compiler_env:
		CompilerPurity(CompilerImpure, CompilerPure),
		CompilerResourceArgPolicy(CompilerRejectResourceArgs),
	../stage_05_types/compiler_refinement: compiler_unrefined_binding
	../stage_05_types/compiler_type:
		CompilerType(CompilerFunctionType),
		compiler_type_copy,
		compiler_type_void,
	../stage_05_types/compiler_type_widening: CompilerTypeWideningDecision(CompilerTypeKeep)
	../stage_06_typecheck/compiler_infer:
		CompilerCallableOrigin(CompilerCallableConstructor, CompilerCallableLocal),
		CompilerExprTypeOrigin(CompilerSynthesizedOrigin),
		CompilerResolvedCallInfo,
		CompilerResolvedCallTarget(CompilerResolvedDirectCall),
		CompilerTypedDictEntry,
		CompilerTypedExpr(
			CompilerTypedBoolLiteralExpr,
			CompilerTypedCallExpr,
			CompilerTypedCharLiteralExpr,
			CompilerTypedDictExpr,
			CompilerTypedFloatLiteralExpr,
			CompilerTypedIntLiteralExpr,
			CompilerTypedLambdaExpr,
			CompilerTypedListExpr,
			CompilerTypedNameExpr,
			CompilerTypedRangeExpr,
			CompilerTypedRecordExpr,
			CompilerTypedStringLiteralExpr,
			CompilerTypedTupleExpr,
			CompilerTypedVectorExpr,
			CompilerTypedVoidExpr,
		),
		CompilerTypedExprInfo,
		CompilerTypedRecordField,
	../stage_06_typecheck/compiler_typecheck_decl: CompilerTypedGlobalVarInfo
	compiler_ctfe_env: compiler_ctfe_has_local_bindings
	compiler_ctfe_value:
		CompilerCtfeConstructorInfo,
		CompilerCtfeValue,
		CompilerCtfeValueDesc(
			CompilerCtfeBoolValue,
			CompilerCtfeCharValue,
			CompilerCtfeConstructorValue,
			CompilerCtfeDictValue,
			CompilerCtfeFloatValue,
			CompilerCtfeFunctionReferenceValue,
			CompilerCtfeIntValue,
			CompilerCtfeLambdaValue,
			CompilerCtfeListValue,
			CompilerCtfeRangeValue,
			CompilerCtfeRecordValue,
			CompilerCtfeStringValue,
			CompilerCtfeTupleValue,
			CompilerCtfeVectorValue,
			CompilerCtfeVoidValue,
		),
	float: format_float, is_finite


enum CompilerCtfeMaterializeError:
	CompilerCtfeCapturedLambda
	CompilerCtfeFloatPrecisionUnavailable
	CompilerCtfeLambdaSourceUnavailable


pure func compiler_ctfe_materialize_error_message(error: CompilerCtfeMaterializeError) -> String:
	match error:
		CompilerCtfeCapturedLambda:
			(
				"compile-time function values that capture local bindings cannot be materialized "
				+ "as global data"
			)
		CompilerCtfeFloatPrecisionUnavailable:
			(
				"compile-time floating-point value cannot be materialized without changing its "
				+ "value"
			)
		CompilerCtfeLambdaSourceUnavailable:
			(
				"internal compile-time constant evaluation error: parsed lambda source is "
				+ "unavailable"
			)


-- Bootstrap compilers before round-tripping Float.to_string support emit only
-- six significant digits. Verify compact output and use the existing fixed
-- formatter as a compatibility path; never silently materialize a different
-- floating-point value.
private pure func compiler_ctfe_float_literal_text(
	value: Float,
) -> Result[String, CompilerCtfeMaterializeError]:
	compact = value.to_string()

	if not is_finite(value):
		-- Internal typed literals use the C spellings emitted by Float.to_string
		-- for IEEE infinity and NaN values.
		Ok(compact)
	else if to_float(compact) == value:
		Ok(compact)
	else:
		fixed_text = format_float(value, 20)

		if to_float(fixed_text) == value:
			Ok(fixed_text)
		else:
			Err(CompilerCtfeFloatPrecisionUnavailable)


private pure func compiler_ctfe_materialize_info(
	typ: CompilerType,
	resolved_call: Option[CompilerResolvedCallInfo],
) -> CompilerTypedExprInfo:
	{
		source_type = None,
		semantic_type = compiler_type_copy(typ),
		value_type = compiler_type_copy(typ),
		origin = CompilerSynthesizedOrigin("ctfe_materialize"),
		value_slot = {
			semantic_type = compiler_type_copy(typ),
			decision = CompilerTypeKeep(compiler_type_copy(typ))
		},
		proofs = compiler_unrefined_binding(),
		resolved_call = resolved_call,
		resource_dependencies = []
	}


private pure func compiler_ctfe_materialize_direct_constructor_call(
	name: String,
	info: CompilerCtfeConstructorInfo,
	params: List[CompilerType],
	return_type: CompilerType,
) -> Option[CompilerResolvedCallInfo]:
	match info.callable_id:
		Some(callable_id):
			Some({
				callee_name = name,
				source_name = name,
				purity = CompilerPure,
				target = CompilerResolvedDirectCall(
					callable_id,
					CompilerCallableConstructor(info.parent_type),
				),
				instantiated_params = params.map(compiler_type_copy),
				instantiated_return = compiler_type_copy(return_type),
				resource_args = CompilerRejectResourceArgs,
				dim_constraints = [],
				loop_producer = None,
			})
		None:
			None


private pure func compiler_ctfe_materialize_function_reference_params(
	typ: CompilerType,
) -> List[CompilerType]:
	match typ:
		CompilerFunctionType(_, params, _):
			params.map(compiler_type_copy)
		_:
			[]


private pure func compiler_ctfe_materialize_function_reference_return(
	typ: CompilerType,
) -> CompilerType:
	match typ:
		CompilerFunctionType(_, _, return_type):
			compiler_type_copy(return_type)
		_:
			compiler_type_void()


private pure func compiler_ctfe_materialize_exprs(
	values: List[CompilerCtfeValue],
) -> Result[List[CompilerTypedExpr], CompilerCtfeMaterializeError]:
	var result: List[CompilerTypedExpr] = []
	var failure: Option[CompilerCtfeMaterializeError] = None

	for value in values:
		match compiler_ctfe_materialize_value(value):
			Ok(materialized):
				result = result.append(materialized)
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(result)


private pure func compiler_ctfe_materialize_record_fields(
	fields: List[(String, CompilerCtfeValue)],
) -> Result[List[CompilerTypedRecordField], CompilerCtfeMaterializeError]:
	var result: List[CompilerTypedRecordField] = []
	var failure: Option[CompilerCtfeMaterializeError] = None

	for (name, value) in fields:
		match compiler_ctfe_materialize_value(value):
			Ok(materialized):
				result = result.append({
					name = parsed_identifier(name, value.span),
					value = materialized,
					span = value.span,
				})
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(result)


private pure func compiler_ctfe_materialize_dict_entries(
	entries: List[(CompilerCtfeValue, CompilerCtfeValue)],
) -> Result[List[CompilerTypedDictEntry], CompilerCtfeMaterializeError]:
	var result: List[CompilerTypedDictEntry] = []
	var failure: Option[CompilerCtfeMaterializeError] = None

	for (key, value) in entries:
		match compiler_ctfe_materialize_value(key):
			Ok(materialized_key):
				match compiler_ctfe_materialize_value(value):
					Ok(materialized_value):
						result = result.append({
							key = materialized_key,
							value = materialized_value,
						})
					Err(error):
						failure = Some(error)
						break
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(result)


private pure func compiler_ctfe_materialize_parsed_exprs(
	values: List[CompilerCtfeValue],
) -> Result[List[ParsedExpr], CompilerCtfeMaterializeError]:
	var result: List[ParsedExpr] = []
	var failure: Option[CompilerCtfeMaterializeError] = None

	for value in values:
		match compiler_ctfe_materialize_parsed_expr(value):
			Ok(materialized):
				result = result.append(materialized)
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(result)


private pure func compiler_ctfe_materialize_parsed_record_fields(
	fields: List[(String, CompilerCtfeValue)],
) -> Result[List[ParsedRecordExprField], CompilerCtfeMaterializeError]:
	var result: List[ParsedRecordExprField] = []
	var failure: Option[CompilerCtfeMaterializeError] = None

	for (name, value) in fields:
		match compiler_ctfe_materialize_parsed_expr(value):
			Ok(materialized):
				result = result.append({
					name = parsed_identifier(name, value.span),
					value = materialized,
					span = value.span,
				})
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(result)


private pure func compiler_ctfe_materialize_parsed_dict_entries(
	entries: List[(CompilerCtfeValue, CompilerCtfeValue)],
) -> Result[List[ParsedDictEntry], CompilerCtfeMaterializeError]:
	var result: List[ParsedDictEntry] = []
	var failure: Option[CompilerCtfeMaterializeError] = None

	for (key, value) in entries:
		match compiler_ctfe_materialize_parsed_expr(key):
			Ok(materialized_key):
				match compiler_ctfe_materialize_parsed_expr(value):
					Ok(materialized_value):
						result = result.append({
							key = materialized_key,
							value = materialized_value,
							span = key.span,
						})
					Err(error):
						failure = Some(error)
						break
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(result)


private pure func compiler_ctfe_materialize_parsed_constructor_value(
	value: CompilerCtfeValue,
	name: String,
	args: List[CompilerCtfeValue],
) -> Result[ParsedExpr, CompilerCtfeMaterializeError]:
	callee = ParsedNameExpr(parsed_identifier(name, value.span))

	if args.length() == 0:
		Ok(callee)
	else:
		materialized_args ?= compiler_ctfe_materialize_parsed_exprs(args)
		Ok(ParsedCallExpr(callee, materialized_args, value.span))


private pure func compiler_ctfe_materialize_constructor_value(
	value: CompilerCtfeValue,
	name: String,
	args: List[CompilerCtfeValue],
	info: CompilerCtfeConstructorInfo,
) -> Result[CompilerTypedExpr, CompilerCtfeMaterializeError]:
	arg_exprs ?= compiler_ctfe_materialize_exprs(args)

	if arg_exprs.length() == 0:
		Ok(
			CompilerTypedNameExpr(
				parsed_identifier(name, value.span),
				compiler_ctfe_materialize_info(value.typ, None),
			),
		)
	else:
		params = args.map(func(arg): compiler_type_copy(arg.typ))
		resolved_call = compiler_ctfe_materialize_direct_constructor_call(
			name,
			info,
			params,
			value.typ,
		)
		callee_type = CompilerFunctionType(True, params, compiler_type_copy(value.typ))
		callee = CompilerTypedNameExpr(
			parsed_identifier(name, value.span),
			compiler_ctfe_materialize_info(callee_type, resolved_call),
		)
		Ok(
			CompilerTypedCallExpr(
				callee,
				arg_exprs,
				value.span,
				compiler_ctfe_materialize_info(value.typ, resolved_call),
			),
		)


pure func compiler_ctfe_materialize_value(
	value: CompilerCtfeValue,
) -> Result[CompilerTypedExpr, CompilerCtfeMaterializeError]:
	info = compiler_ctfe_materialize_info(value.typ, None)

	match value.desc:
		CompilerCtfeIntValue(raw):
			Ok(CompilerTypedIntLiteralExpr(raw.to_string(), value.span, info))
		CompilerCtfeFloatValue(raw):
			text ?= compiler_ctfe_float_literal_text(raw)
			Ok(CompilerTypedFloatLiteralExpr(text, value.span, info))
		CompilerCtfeBoolValue(raw):
			Ok(CompilerTypedBoolLiteralExpr(raw, value.span, info))
		CompilerCtfeCharValue(raw):
			Ok(CompilerTypedCharLiteralExpr(to_int(raw), value.span, info))
		CompilerCtfeStringValue(raw):
			Ok(CompilerTypedStringLiteralExpr(raw, value.span, info))
		CompilerCtfeTupleValue(values):
			items ?= compiler_ctfe_materialize_exprs(values)
			Ok(CompilerTypedTupleExpr(items, value.span, info))
		CompilerCtfeListValue(values):
			items ?= compiler_ctfe_materialize_exprs(values)
			Ok(CompilerTypedListExpr(items, value.span, info))
		CompilerCtfeVectorValue(values):
			items ?= compiler_ctfe_materialize_exprs(values)
			Ok(CompilerTypedVectorExpr(items, value.span, info))
		CompilerCtfeDictValue(entries):
			items ?= compiler_ctfe_materialize_dict_entries(entries)
			Ok(CompilerTypedDictExpr(items, value.span, info))
		CompilerCtfeRecordValue(fields):
			items ?= compiler_ctfe_materialize_record_fields(fields)
			Ok(CompilerTypedRecordExpr(items, value.span, info))
		CompilerCtfeRangeValue(start_value, end_value):
			start_expr ?= compiler_ctfe_materialize_value(start_value)
			end_expr ?= compiler_ctfe_materialize_value(end_value)
			Ok(CompilerTypedRangeExpr(start_expr, end_expr, value.span, info))
		CompilerCtfeVoidValue:
			Ok(CompilerTypedVoidExpr(value.span, info))
		CompilerCtfeConstructorValue(payload):
			compiler_ctfe_materialize_constructor_value(
				value,
				payload.name,
				payload.args,
				payload.constructor_info,
			)
		CompilerCtfeFunctionReferenceValue(payload):
			purity: CompilerPurity = if payload.is_pure:
				CompilerPure
			else:
				CompilerImpure

			resolved_call = Some({
				callee_name = payload.source_name,
				source_name = payload.source_name,
				purity = purity,
				target = CompilerResolvedDirectCall(payload.callable_id, CompilerCallableLocal),
				instantiated_params = compiler_ctfe_materialize_function_reference_params(
					value.typ,
				),
				instantiated_return = compiler_ctfe_materialize_function_reference_return(
					value.typ,
				),
				resource_args = CompilerRejectResourceArgs,
				dim_constraints = [],
				loop_producer = None,
			})
			Ok(
				CompilerTypedNameExpr(
					parsed_identifier(payload.source_name, value.span),
					compiler_ctfe_materialize_info(value.typ, resolved_call),
				),
			)
		CompilerCtfeLambdaValue(closure):
			if compiler_ctfe_has_local_bindings(closure.env):
				Err(CompilerCtfeCapturedLambda)
			else:
				source = closure.source
				Ok(
					CompilerTypedLambdaExpr(
						source.is_pure,
						source.params,
						source.return_annotation,
						source.body,
						source.span,
						source.info,
					),
				)


pure func compiler_ctfe_validate_materializable_value(
	value: CompilerCtfeValue,
) -> Result[Void, CompilerCtfeMaterializeError]:
	match compiler_ctfe_materialize_value(value):
		Ok(_):
			Ok(void)
		Err(error):
			Err(error)


pure func compiler_ctfe_materialize_parsed_expr(
	value: CompilerCtfeValue,
) -> Result[ParsedExpr, CompilerCtfeMaterializeError]:
	match value.desc:
		CompilerCtfeIntValue(raw):
			Ok(ParsedIntLiteralExpr(raw.to_string(), value.span))
		CompilerCtfeFloatValue(raw):
			text ?= compiler_ctfe_float_literal_text(raw)
			Ok(ParsedFloatLiteralExpr(text, value.span))
		CompilerCtfeBoolValue(raw):
			Ok(ParsedBoolLiteralExpr(raw, value.span))
		CompilerCtfeCharValue(raw):
			Ok(ParsedCharLiteralExpr(to_int(raw), value.span))
		CompilerCtfeStringValue(raw):
			Ok(ParsedStringLiteralExpr(raw, ParsedPlainStringLiteral, value.span))
		CompilerCtfeTupleValue(values):
			items ?= compiler_ctfe_materialize_parsed_exprs(values)
			Ok(ParsedTupleExpr(items, value.span))
		CompilerCtfeListValue(values):
			items ?= compiler_ctfe_materialize_parsed_exprs(values)
			Ok(ParsedListExpr(items, value.span))
		CompilerCtfeVectorValue(values):
			items ?= compiler_ctfe_materialize_parsed_exprs(values)
			Ok(ParsedVectorExpr(items, value.span))
		CompilerCtfeDictValue(entries):
			items ?= compiler_ctfe_materialize_parsed_dict_entries(entries)
			Ok(ParsedDictExpr(items, value.span))
		CompilerCtfeRecordValue(fields):
			items ?= compiler_ctfe_materialize_parsed_record_fields(fields)
			Ok(ParsedRecordExpr(items, value.span))
		CompilerCtfeRangeValue(start_value, end_value):
			start_expr ?= compiler_ctfe_materialize_parsed_expr(start_value)
			end_expr ?= compiler_ctfe_materialize_parsed_expr(end_value)
			Ok(ParsedRangeExpr(start_expr, end_expr, value.span))
		CompilerCtfeVoidValue:
			Ok(ParsedVoidExpr(value.span))
		CompilerCtfeConstructorValue(payload):
			compiler_ctfe_materialize_parsed_constructor_value(value, payload.name, payload.args)
		CompilerCtfeFunctionReferenceValue(payload):
			Ok(ParsedNameExpr(parsed_identifier(payload.source_name, value.span)))
		CompilerCtfeLambdaValue(_):
			Err(CompilerCtfeLambdaSourceUnavailable)


private pure func compiler_ctfe_materialized_global_var_info(
	info: CompilerTypedGlobalVarInfo,
	typed_value: CompilerTypedExpr,
	parsed_value: ParsedExpr,
) -> CompilerTypedGlobalVarInfo:
	decl: ParsedVarDecl = { info.decl |
		value = parsed_value,
		is_mutable = False
	}

	{ info |
		decl = decl,
		value = typed_value
	}


pure func compiler_ctfe_materialize_global_var_info(
	info: CompilerTypedGlobalVarInfo,
	value: CompilerCtfeValue,
) -> Result[CompilerTypedGlobalVarInfo, CompilerCtfeMaterializeError]:
	match compiler_ctfe_materialize_value(value):
		Err(error):
			Err(error)
		Ok(typed_value):
			match compiler_ctfe_materialize_parsed_expr(value):
				Ok(parsed_value):
					Ok(compiler_ctfe_materialized_global_var_info(info, typed_value, parsed_value))
				Err(CompilerCtfeLambdaSourceUnavailable):
					-- Typed lambdas do not retain a lossless ParsedExpr. Keep the original
					-- source initializer while the typed initializer carries the CTFE value.
					Ok(
						compiler_ctfe_materialized_global_var_info(
							info,
							typed_value,
							info.decl.value,
						),
					)
				Err(error):
					Err(error)
