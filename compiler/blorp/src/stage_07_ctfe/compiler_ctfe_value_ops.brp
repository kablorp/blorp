-- Operations over compile-time values that are shared by CTFE evaluators and
-- std intrinsic evaluation.
import:
	../stage_01_file_io/compiler_source: CompilerSourceSpan
	../stage_05_types/compiler_type: SemanticType
	compiler_ctfe_value:
		CompilerCtfeError(CompilerCtfeUnsupported),
		CompilerCtfeValue,
		CompilerCtfeValueDesc(
			CompilerCtfeBoolValue,
			CompilerCtfeCharValue,
			CompilerCtfeConstructorValue,
			CompilerCtfeFloatValue,
			CompilerCtfeIntValue,
			CompilerCtfeStringValue,
		),
		compiler_ctfe_constructor_info,
		compiler_ctfe_value,
		compiler_ctfe_value_kind,


OPTION_TYPE_NAME: String = "Option"

OPTION_SOME_NAME: String = "Some"

OPTION_NONE_NAME: String = "None"

RESULT_TYPE_NAME: String = "Result"

RESULT_OK_NAME: String = "Ok"

RESULT_ERR_NAME: String = "Err"


union CompilerCtfeOptionState:
	CompilerCtfeOptionSome(CompilerCtfeValue)
	CompilerCtfeOptionNone


union CompilerCtfeResultState:
	CompilerCtfeResultOk(CompilerCtfeValue)
	CompilerCtfeResultErr(CompilerCtfeValue)


pure func compiler_ctfe_construct_value(
	typ: SemanticType,
	span: CompilerSourceSpan,
	parent_type: String,
	name: String,
	args: List[CompilerCtfeValue],
) -> CompilerCtfeValue:
	compiler_ctfe_value(typ, CompilerCtfeConstructorValue({
			name = name,
			args = args,
			constructor_info = compiler_ctfe_constructor_info(parent_type, args.length(), None),
		}), span)


pure func compiler_ctfe_option_some_value(
	typ: SemanticType,
	span: CompilerSourceSpan,
	value: CompilerCtfeValue,
) -> CompilerCtfeValue:
	compiler_ctfe_construct_value(typ, span, OPTION_TYPE_NAME, OPTION_SOME_NAME, [value])


pure func compiler_ctfe_option_none_value(
	typ: SemanticType,
	span: CompilerSourceSpan,
) -> CompilerCtfeValue:
	compiler_ctfe_construct_value(typ, span, OPTION_TYPE_NAME, OPTION_NONE_NAME, [])


pure func compiler_ctfe_result_ok_value(
	typ: SemanticType,
	span: CompilerSourceSpan,
	value: CompilerCtfeValue,
) -> CompilerCtfeValue:
	compiler_ctfe_construct_value(typ, span, RESULT_TYPE_NAME, RESULT_OK_NAME, [value])


pure func compiler_ctfe_result_err_value(
	typ: SemanticType,
	span: CompilerSourceSpan,
	value: CompilerCtfeValue,
) -> CompilerCtfeValue:
	compiler_ctfe_construct_value(typ, span, RESULT_TYPE_NAME, RESULT_ERR_NAME, [value])


private pure func compiler_ctfe_carrier_unsupported(form: String) -> CompilerCtfeError:
	CompilerCtfeUnsupported(form)


pure func compiler_ctfe_option_state(
	value: CompilerCtfeValue,
) -> Result[CompilerCtfeOptionState, CompilerCtfeError]:
	match value.desc:
		CompilerCtfeConstructorValue(payload):
			if (
				payload.constructor_info.parent_type == OPTION_TYPE_NAME
				and payload.name == OPTION_SOME_NAME
				and payload.args.length() == 1
			):
				match payload.args.get(0):
					Some(inner):
						Ok(CompilerCtfeOptionSome(inner))
					None:
						Err(compiler_ctfe_carrier_unsupported("Option helper on non-Option values"))
			else if (
				payload.constructor_info.parent_type == OPTION_TYPE_NAME
				and payload.name == OPTION_NONE_NAME
				and payload.args.length() == 0
			):
				Ok(CompilerCtfeOptionNone)
			else:
				Err(compiler_ctfe_carrier_unsupported("Option helper on non-Option values"))
		_:
			Err(compiler_ctfe_carrier_unsupported("Option helper on non-Option values"))


pure func compiler_ctfe_result_state(
	value: CompilerCtfeValue,
) -> Result[CompilerCtfeResultState, CompilerCtfeError]:
	match value.desc:
		CompilerCtfeConstructorValue(payload):
			if (
				payload.constructor_info.parent_type == RESULT_TYPE_NAME
				and payload.name == RESULT_OK_NAME
				and payload.args.length() == 1
			):
				match payload.args.get(0):
					Some(inner):
						Ok(CompilerCtfeResultOk(inner))
					None:
						Err(compiler_ctfe_carrier_unsupported("Result helper on non-Result values"))
			else if (
				payload.constructor_info.parent_type == RESULT_TYPE_NAME
				and payload.name == RESULT_ERR_NAME
				and payload.args.length() == 1
			):
				match payload.args.get(0):
					Some(inner):
						Ok(CompilerCtfeResultErr(inner))
					None:
						Err(compiler_ctfe_carrier_unsupported("Result helper on non-Result values"))
			else:
				Err(compiler_ctfe_carrier_unsupported("Result helper on non-Result values"))
		_:
			Err(compiler_ctfe_carrier_unsupported("Result helper on non-Result values"))


pure func compiler_ctfe_string_text_of_value(
	value: CompilerCtfeValue,
) -> Result[String, CompilerCtfeError]:
	match value.desc:
		CompilerCtfeStringValue(text):
			Ok(text)
		CompilerCtfeIntValue(number):
			Ok(number.to_string())
		CompilerCtfeFloatValue(number):
			Ok(number.to_string())
		CompilerCtfeBoolValue(flag):
			Ok(flag.to_string())
		CompilerCtfeCharValue(char):
			Ok(char.to_string())
		_:
			Err(
				CompilerCtfeUnsupported(
					"String interpolation for " + compiler_ctfe_value_kind(value) + " values",
				),
			)
