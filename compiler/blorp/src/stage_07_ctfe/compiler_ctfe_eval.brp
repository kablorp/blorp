-- Compile-time evaluator for normalized CTFE IR.
--
-- This evaluator covers the expression forms already normalized by
-- compiler_ctfe_ir.brp. Production materialization remains a separate slice.
import:
	../stage_01_file_io/compiler_source: CompilerSourceSpan
	../stage_03_parse/compiler_parsed_ast:
		ParsedBinaryOp,
		ParsedLogicalOp(ParsedAndOp, ParsedOrOp),
		ParsedParam,
		ParsedParamBinder(ParsedParamNameBinder, ParsedParamTupleBinder, ParsedParamWildcardBinder),
		ParsedUnaryOp,
	../stage_05_types/compiler_type: CompilerType
	../stage_06_typecheck/compiler_infer: CompilerTypedExpr, CompilerTypedLambdaParam
	compiler_ctfe_context:
		CompilerCtfeContext,
		CompilerCtfeFunction,
		compiler_ctfe_context_empty,
		compiler_ctfe_context_function_by_callable_id,
		compiler_ctfe_context_imported_functions_by_source,
		compiler_ctfe_context_module_global_env,
		compiler_ctfe_context_module_global_value,
	compiler_ctfe_env:
