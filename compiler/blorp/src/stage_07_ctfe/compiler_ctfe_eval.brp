			CompilerCtfeIrLiteralExpr,
			CompilerCtfeIrLogicalExpr,
			CompilerCtfeIrMatchExpr,
			CompilerCtfeIrRecordExpr,
			CompilerCtfeIrRecordUpdateExpr,
			CompilerCtfeIrRangeExpr,
			CompilerCtfeIrBreakExpr,
			CompilerCtfeIrContinueExpr,
			CompilerCtfeIrStringInterpolationExpr,
