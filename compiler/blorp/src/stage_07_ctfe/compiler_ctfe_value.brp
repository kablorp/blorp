-- Compile-time value representation and primitive operations.
--
-- This module owns CTFE value data, including the recursive closure/environment
-- shape. Environment operations and evaluation remain in their dedicated
-- modules; materialization owns rewriting values back into typed declarations.
import:
	../stage_01_file_io/compiler_source: CompilerSourceSpan
	../stage_03_parse/compiler_parsed_ast:
		ParsedBinaryOp(
			ParsedAddOp,
			ParsedDivideOp,
			ParsedEqualOp,
			ParsedGreaterEqualOp,
			ParsedGreaterOp,
			ParsedLessEqualOp,
			ParsedLessOp,
			ParsedModuloOp,
			ParsedMultiplyOp,
			ParsedNotEqualOp,
			ParsedSubtractOp,
		),
		ParsedUnaryOp(ParsedNegateOp, ParsedNotOp),
	../stage_05_types/compiler_type:
		CompilerType(CompilerNamedType),
		compiler_type_bool,
		compiler_type_char,
		compiler_type_float,
		compiler_type_int,
		compiler_type_string,
		compiler_type_to_string,
		compiler_type_void,
	../stage_06_typecheck/compiler_infer:
		CompilerTypedExpr,
		CompilerTypedExprInfo,
		CompilerTypedLambdaParam,


record CompilerCtfeConstructorInfo {
	parent_type: String,
	arity: Int,
	callable_id: Option[Int]
}


record CompilerCtfeConstructorPayload {
	name: String,
	args: List[CompilerCtfeValue],
	constructor_info: CompilerCtfeConstructorInfo
}


record CompilerCtfeFunctionReferencePayload {
	callable_id: Int,
	source_name: String,
	is_pure: Bool
}


-- Binding data lives with CTFE values because lambda values close over an
-- environment. Keeping both sides of that recursive relationship in one
-- module avoids making the value and environment modules import each other.
enum CompilerCtfeBindingScope:
	CompilerCtfeGlobalBinding
	CompilerCtfeLocalBinding


union CompilerCtfeUnavailableGlobalReason:
	CompilerCtfeCurrentGlobal
	CompilerCtfeLaterGlobal
	CompilerCtfeRuntimeInitializedGlobal
	CompilerCtfeImportedRuntimeInitializedGlobal(String, String)


union CompilerCtfeBindingValue:
	CompilerCtfeAvailableValue(CompilerCtfeValue)
	CompilerCtfeUnavailableGlobal(CompilerCtfeUnavailableGlobalReason)


record CompilerCtfeBinding {
	scope: CompilerCtfeBindingScope,
	is_mutable: Bool,
	value: CompilerCtfeBindingValue
}


record CompilerCtfeEnv {
	bindings: List[(String, CompilerCtfeBinding)]
}


record CompilerCtfeLambdaSource {
	is_pure: Bool,
	params: List[CompilerTypedLambdaParam],
	return_annotation: Option[CompilerType],
	body: CompilerTypedExpr,
	span: CompilerSourceSpan,
	info: CompilerTypedExprInfo
}


record CompilerCtfeLambdaPayload {
	source: CompilerCtfeLambdaSource,
	env: CompilerCtfeEnv
}


union CompilerCtfeValueDesc:
	CompilerCtfeIntValue(Int)
	CompilerCtfeFloatValue(Float)
	CompilerCtfeBoolValue(Bool)
	CompilerCtfeCharValue(Char)
	CompilerCtfeStringValue(String)
	CompilerCtfeTupleValue(List[CompilerCtfeValue])
	CompilerCtfeListValue(List[CompilerCtfeValue])
	CompilerCtfeVectorValue(List[CompilerCtfeValue])
	CompilerCtfeDictValue(List[(CompilerCtfeValue, CompilerCtfeValue)])
	CompilerCtfeRecordValue(List[(String, CompilerCtfeValue)])
	CompilerCtfeRangeValue(CompilerCtfeValue, CompilerCtfeValue)
	CompilerCtfeVoidValue
	CompilerCtfeConstructorValue(CompilerCtfeConstructorPayload)
	CompilerCtfeFunctionReferenceValue(CompilerCtfeFunctionReferencePayload)
	CompilerCtfeLambdaValue(CompilerCtfeLambdaPayload)


record CompilerCtfeValue {
	typ: CompilerType,
	desc: CompilerCtfeValueDesc,
	span: CompilerSourceSpan
}


union CompilerCtfeError:
	CompilerCtfeExpectedValue(String, String)
	CompilerCtfeUnsupported(String)
	CompilerCtfeInvalidOperator(String)


pure func compiler_ctfe_constructor_info(
	parent_type: String,
	arity: Int,
	callable_id: Option[Int],
) -> CompilerCtfeConstructorInfo:
	{
		parent_type = parent_type,
		arity = arity,
		callable_id = callable_id
	}


pure func compiler_ctfe_value(
	typ: CompilerType,
	desc: CompilerCtfeValueDesc,
	span: CompilerSourceSpan,
) -> CompilerCtfeValue:
	{
		typ = typ,
		desc = desc,
		span = span
	}


pure func compiler_ctfe_int(span: CompilerSourceSpan, value: Int) -> CompilerCtfeValue:
	compiler_ctfe_value(compiler_type_int(), CompilerCtfeIntValue(value), span)


pure func compiler_ctfe_float(span: CompilerSourceSpan, value: Float) -> CompilerCtfeValue:
	compiler_ctfe_value(compiler_type_float(), CompilerCtfeFloatValue(value), span)


pure func compiler_ctfe_bool(span: CompilerSourceSpan, value: Bool) -> CompilerCtfeValue:
	compiler_ctfe_value(compiler_type_bool(), CompilerCtfeBoolValue(value), span)


pure func compiler_ctfe_char(span: CompilerSourceSpan, value: Char) -> CompilerCtfeValue:
	compiler_ctfe_value(compiler_type_char(), CompilerCtfeCharValue(value), span)


pure func compiler_ctfe_string(span: CompilerSourceSpan, value: String) -> CompilerCtfeValue:
	compiler_ctfe_value(compiler_type_string(), CompilerCtfeStringValue(value), span)


pure func compiler_ctfe_function_reference(
	typ: CompilerType,
	span: CompilerSourceSpan,
	callable_id: Int,
	source_name: String,
	is_pure: Bool,
) -> CompilerCtfeValue:
	compiler_ctfe_value(typ, CompilerCtfeFunctionReferenceValue({
			callable_id = callable_id,
			source_name = source_name,
			is_pure = is_pure,
		}), span)


pure func compiler_ctfe_void(span: CompilerSourceSpan) -> CompilerCtfeValue:
	compiler_ctfe_value(compiler_type_void(), CompilerCtfeVoidValue, span)


pure func compiler_ctfe_value_kind(value: CompilerCtfeValue) -> String:
	match value.desc:
		CompilerCtfeIntValue(_):
			"Int"
		CompilerCtfeFloatValue(_):
			"Float"
		CompilerCtfeBoolValue(_):
			"Bool"
		CompilerCtfeCharValue(_):
			"Char"
		CompilerCtfeStringValue(_):
			"String"
		CompilerCtfeTupleValue(_):
			"Tuple"
		CompilerCtfeListValue(_):
			"List"
		CompilerCtfeVectorValue(_):
			"Vector"
		CompilerCtfeDictValue(_):
			"Dict"
		CompilerCtfeRecordValue(_):
			"Record"
		CompilerCtfeRangeValue(_, _):
			"Range"
		CompilerCtfeVoidValue:
			"Void"
		CompilerCtfeConstructorValue(_):
			"Constructor"
		CompilerCtfeFunctionReferenceValue(_):
			"Function reference"
		CompilerCtfeLambdaValue(_):
			"Lambda"


pure func compiler_ctfe_error_message(error: CompilerCtfeError) -> String:
	match error:
		CompilerCtfeExpectedValue(expected, actual):
			"compile-time constant evaluation expected ${expected}, found ${actual}"
		CompilerCtfeUnsupported(form):
			"compile-time constant evaluation does not support ${form} yet"
		CompilerCtfeInvalidOperator(op):
			"internal CTFE error: invalid operator ${op}"


private pure func compiler_ctfe_expected_error(
	expected: String,
	value: CompilerCtfeValue,
) -> CompilerCtfeError:
	CompilerCtfeExpectedValue(expected, compiler_type_to_string(value.typ))


pure func compiler_ctfe_expect_int(value: CompilerCtfeValue) -> Result[Int, CompilerCtfeError]:
	match value.desc:
		CompilerCtfeIntValue(raw):
			Ok(raw)
		_:
			Err(compiler_ctfe_expected_error("Int", value))


pure func compiler_ctfe_expect_float(value: CompilerCtfeValue) -> Result[Float, CompilerCtfeError]:
	match value.desc:
		CompilerCtfeFloatValue(raw):
			Ok(raw)
		_:
			Err(compiler_ctfe_expected_error("Float", value))


pure func compiler_ctfe_expect_bool(value: CompilerCtfeValue) -> Result[Bool, CompilerCtfeError]:
	match value.desc:
		CompilerCtfeBoolValue(raw):
			Ok(raw)
		_:
			Err(compiler_ctfe_expected_error("Bool", value))


pure func compiler_ctfe_expect_char(value: CompilerCtfeValue) -> Result[Char, CompilerCtfeError]:
	match value.desc:
		CompilerCtfeCharValue(raw):
			Ok(raw)
		_:
			Err(compiler_ctfe_expected_error("Char", value))


pure func compiler_ctfe_expect_string(
	value: CompilerCtfeValue,
) -> Result[String, CompilerCtfeError]:
	match value.desc:
		CompilerCtfeStringValue(raw):
			Ok(raw)
		_:
			Err(compiler_ctfe_expected_error("String", value))


pure func compiler_ctfe_values_equal(left: CompilerCtfeValue, right: CompilerCtfeValue) -> Bool:
	match left.desc:
		CompilerCtfeIntValue(left_value):
			match right.desc:
				CompilerCtfeIntValue(right_value):
					left_value == right_value
				_:
					False
		CompilerCtfeFloatValue(left_value):
			match right.desc:
				CompilerCtfeFloatValue(right_value):
					left_value == right_value
				_:
					False
		CompilerCtfeBoolValue(left_value):
			match right.desc:
				CompilerCtfeBoolValue(right_value):
					left_value == right_value
				_:
					False
		CompilerCtfeCharValue(left_value):
			match right.desc:
				CompilerCtfeCharValue(right_value):
					left_value == right_value
				_:
					False
		CompilerCtfeStringValue(left_value):
			match right.desc:
				CompilerCtfeStringValue(right_value):
					left_value == right_value
				_:
					False
		CompilerCtfeTupleValue(left_values):
			match right.desc:
				CompilerCtfeTupleValue(right_values):
					compiler_ctfe_value_lists_equal(left_values, right_values)
				_:
					False
		CompilerCtfeListValue(left_values):
			match right.desc:
				CompilerCtfeListValue(right_values):
					compiler_ctfe_value_lists_equal(left_values, right_values)
				_:
					False
		CompilerCtfeVectorValue(left_values):
			match right.desc:
				CompilerCtfeVectorValue(right_values):
					compiler_ctfe_value_lists_equal(left_values, right_values)
				_:
					False
		CompilerCtfeDictValue(left_pairs):
			match right.desc:
				CompilerCtfeDictValue(right_pairs):
					compiler_ctfe_dict_entries_equal(left_pairs, right_pairs)
				_:
					False
		CompilerCtfeRecordValue(left_fields):
			match right.desc:
				CompilerCtfeRecordValue(right_fields):
					compiler_ctfe_record_fields_equal(left_fields, right_fields)
				_:
					False
		CompilerCtfeRangeValue(left_start, left_end):
			match right.desc:
				CompilerCtfeRangeValue(right_start, right_end):
					(
						compiler_ctfe_values_equal(left_start, right_start)
						and compiler_ctfe_values_equal(left_end, right_end)
					)
				_:
					False
		CompilerCtfeVoidValue:
			match right.desc:
				CompilerCtfeVoidValue:
					True
				_:
					False
		CompilerCtfeConstructorValue(left_ctor):
			match right.desc:
				CompilerCtfeConstructorValue(right_ctor):
					compiler_ctfe_constructor_values_equal(left_ctor, right_ctor)
				_:
					False
		CompilerCtfeFunctionReferenceValue(left_ref):
			match right.desc:
				CompilerCtfeFunctionReferenceValue(right_ref):
					(
						left_ref.callable_id == right_ref.callable_id
						and left_ref.source_name == right_ref.source_name
					)
				_:
					False
		CompilerCtfeLambdaValue(_):
			False


private pure func compiler_ctfe_constructor_values_equal(
	left: CompilerCtfeConstructorPayload,
	right: CompilerCtfeConstructorPayload,
) -> Bool:
	(
		left.name == right.name
		and left.constructor_info.parent_type == right.constructor_info.parent_type
		and compiler_ctfe_value_lists_equal(left.args, right.args)
	)


private pure func compiler_ctfe_value_lists_equal(
	left: List[CompilerCtfeValue],
	right: List[CompilerCtfeValue],
) -> Bool:
	if not (left.length() == right.length()):
		False
	else:
		var equal: Bool = True
		var index: Int = 0

		for left_value in left:
			right_value: CompilerCtfeValue = right.get_or(index, left_value)

			if not compiler_ctfe_values_equal(left_value, right_value):
				equal = False
				break

			index += 1

		equal


private pure func compiler_ctfe_dict_entries_equal(
	left: List[(CompilerCtfeValue, CompilerCtfeValue)],
	right: List[(CompilerCtfeValue, CompilerCtfeValue)],
) -> Bool:
	if not (left.length() == right.length()):
		False
	else:
		var equal: Bool = True
		var index: Int = 0

		for (left_key, left_value) in left:
			right_pair: (CompilerCtfeValue, CompilerCtfeValue) = right.get_or(
				index,
				(left_key, left_value),
			)
			(right_key, right_value) = right_pair

			if not ((
				compiler_ctfe_values_equal(left_key, right_key)
				and compiler_ctfe_values_equal(left_value, right_value)
			)):
				equal = False
				break

			index += 1

		equal


private pure func compiler_ctfe_record_fields_equal(
	left: List[(String, CompilerCtfeValue)],
	right: List[(String, CompilerCtfeValue)],
) -> Bool:
	if not (left.length() == right.length()):
		False
	else:
		var equal: Bool = True
		var index: Int = 0

		for (left_name, left_value) in left:
			right_pair: (String, CompilerCtfeValue) = right.get_or(index, (left_name, left_value))
			(right_name, right_value) = right_pair

			if not ((
				left_name == right_name
				and compiler_ctfe_values_equal(left_value, right_value)
			)):
				equal = False
				break

			index += 1

		equal


private pure func compiler_ctfe_compare_int(op: ParsedBinaryOp, left: Int, right: Int) -> Bool:
	match op:
		ParsedLessOp:
			left < right
		ParsedGreaterOp:
			left > right
		ParsedLessEqualOp:
			left <= right
		ParsedGreaterEqualOp:
			left >= right
		_:
			False


private pure func compiler_ctfe_compare_float(
	op: ParsedBinaryOp,
	left: Float,
	right: Float,
) -> Bool:
	match op:
		ParsedLessOp:
			left < right
		ParsedGreaterOp:
			left > right
		ParsedLessEqualOp:
			left <= right
		ParsedGreaterEqualOp:
			left >= right
		_:
			False


private pure func compiler_ctfe_value_desc_error(
	error: CompilerCtfeError,
) -> Result[CompilerCtfeValueDesc, CompilerCtfeError]:
	-- A concrete adapter keeps the current backend away from generic Result
	-- tuple matches and nested `?= match` forms it cannot emit reliably.
	Err(error)


private pure func compiler_ctfe_eval_int_binary_values(
	op: ParsedBinaryOp,
	left_value: Int,
	right_value: Int,
) -> Result[CompilerCtfeValueDesc, CompilerCtfeError]:
	match op:
		ParsedAddOp:
			Ok(CompilerCtfeIntValue(left_value + right_value))
		ParsedSubtractOp:
			Ok(CompilerCtfeIntValue(left_value - right_value))
		ParsedMultiplyOp:
			Ok(CompilerCtfeIntValue(left_value * right_value))
		ParsedDivideOp:
			if right_value == 0:
				Ok(CompilerCtfeIntValue(0))
			else:
				Ok(CompilerCtfeIntValue(left_value / right_value))
		ParsedModuloOp:
			if right_value == 0:
				Ok(CompilerCtfeIntValue(0))
			else:
				Ok(CompilerCtfeIntValue(left_value % right_value))
		ParsedLessOp:
			Ok(CompilerCtfeBoolValue(compiler_ctfe_compare_int(op, left_value, right_value)))
		ParsedGreaterOp:
			Ok(CompilerCtfeBoolValue(compiler_ctfe_compare_int(op, left_value, right_value)))
		ParsedLessEqualOp:
			Ok(CompilerCtfeBoolValue(compiler_ctfe_compare_int(op, left_value, right_value)))
		ParsedGreaterEqualOp:
			Ok(CompilerCtfeBoolValue(compiler_ctfe_compare_int(op, left_value, right_value)))
		ParsedEqualOp:
			Ok(CompilerCtfeBoolValue(left_value == right_value))
		ParsedNotEqualOp:
			Ok(CompilerCtfeBoolValue(left_value != right_value))


private pure func compiler_ctfe_eval_int_binary_desc(
	op: ParsedBinaryOp,
	left: CompilerCtfeValue,
	right: CompilerCtfeValue,
) -> Result[CompilerCtfeValueDesc, CompilerCtfeError]:
	match compiler_ctfe_expect_int(left):
		Err(error):
			compiler_ctfe_value_desc_error(error)
		Ok(left_value):
			match compiler_ctfe_expect_int(right):
				Ok(right_value):
					compiler_ctfe_eval_int_binary_values(op, left_value, right_value)
				Err(error):
					compiler_ctfe_value_desc_error(error)


private pure func compiler_ctfe_eval_float_binary_values(
	op: ParsedBinaryOp,
	left_value: Float,
	right_value: Float,
) -> Result[CompilerCtfeValueDesc, CompilerCtfeError]:
	match op:
		ParsedAddOp:
			Ok(CompilerCtfeFloatValue(left_value + right_value))
		ParsedSubtractOp:
			Ok(CompilerCtfeFloatValue(left_value - right_value))
		ParsedMultiplyOp:
			Ok(CompilerCtfeFloatValue(left_value * right_value))
		ParsedDivideOp:
			Ok(CompilerCtfeFloatValue(left_value / right_value))
		ParsedModuloOp:
			Err(CompilerCtfeUnsupported("Float modulo"))
		ParsedLessOp:
			Ok(CompilerCtfeBoolValue(compiler_ctfe_compare_float(op, left_value, right_value)))
		ParsedGreaterOp:
			Ok(CompilerCtfeBoolValue(compiler_ctfe_compare_float(op, left_value, right_value)))
		ParsedLessEqualOp:
			Ok(CompilerCtfeBoolValue(compiler_ctfe_compare_float(op, left_value, right_value)))
		ParsedGreaterEqualOp:
			Ok(CompilerCtfeBoolValue(compiler_ctfe_compare_float(op, left_value, right_value)))
		ParsedEqualOp:
			Ok(CompilerCtfeBoolValue(left_value == right_value))
		ParsedNotEqualOp:
			Ok(CompilerCtfeBoolValue(left_value != right_value))


private pure func compiler_ctfe_eval_float_binary_desc(
	op: ParsedBinaryOp,
	left: CompilerCtfeValue,
	right: CompilerCtfeValue,
) -> Result[CompilerCtfeValueDesc, CompilerCtfeError]:
	match compiler_ctfe_expect_float(left):
		Err(error):
			compiler_ctfe_value_desc_error(error)
		Ok(left_value):
			match compiler_ctfe_expect_float(right):
				Ok(right_value):
					compiler_ctfe_eval_float_binary_values(op, left_value, right_value)
				Err(error):
					compiler_ctfe_value_desc_error(error)


private pure func compiler_ctfe_eval_string_binary_desc(
	op: ParsedBinaryOp,
	left: CompilerCtfeValue,
	right: CompilerCtfeValue,
) -> Result[CompilerCtfeValueDesc, CompilerCtfeError]:
	match op:
		ParsedAddOp:
			match compiler_ctfe_expect_string(left):
				Err(error):
					compiler_ctfe_value_desc_error(error)
				Ok(left_value):
					match compiler_ctfe_expect_string(right):
						Ok(right_value):
							Ok(CompilerCtfeStringValue(left_value + right_value))
						Err(error):
							compiler_ctfe_value_desc_error(error)
		ParsedEqualOp:
			Ok(CompilerCtfeBoolValue(compiler_ctfe_values_equal(left, right)))
		ParsedNotEqualOp:
			Ok(CompilerCtfeBoolValue(not compiler_ctfe_values_equal(left, right)))
		_:
			Err(CompilerCtfeUnsupported("String binary operator"))


private pure func compiler_ctfe_binary_result_type(
	op: ParsedBinaryOp,
	left: CompilerCtfeValue,
) -> CompilerType:
	match op:
		ParsedEqualOp:
			compiler_type_bool()
		ParsedNotEqualOp:
			compiler_type_bool()
		ParsedLessOp:
			compiler_type_bool()
		ParsedLessEqualOp:
			compiler_type_bool()
		ParsedGreaterOp:
			compiler_type_bool()
		ParsedGreaterEqualOp:
			compiler_type_bool()
		_:
			left.typ


private pure func compiler_ctfe_round_float_desc(
	typ: CompilerType,
	desc: CompilerCtfeValueDesc,
) -> CompilerCtfeValueDesc:
	match desc:
		CompilerCtfeFloatValue(raw):
			match typ:
				CompilerNamedType(name, args):
					if args.length() != 0:
						desc
					else if name == "Float16":
						CompilerCtfeFloatValue(to_float(to_float16(raw)))
					else if name == "Float32":
						CompilerCtfeFloatValue(to_float(to_float32(raw)))
					else:
						desc
				_:
					desc
		_:
			desc


pure func compiler_ctfe_eval_binary(
	op: ParsedBinaryOp,
	left: CompilerCtfeValue,
	right: CompilerCtfeValue,
) -> Result[CompilerCtfeValue, CompilerCtfeError]:
	desc_result: Result[CompilerCtfeValueDesc, CompilerCtfeError] = match left.desc:
		CompilerCtfeStringValue(_):
			compiler_ctfe_eval_string_binary_desc(op, left, right)
		CompilerCtfeFloatValue(_):
			compiler_ctfe_eval_float_binary_desc(op, left, right)
		_:
			match op:
				ParsedEqualOp:
					Ok(CompilerCtfeBoolValue(compiler_ctfe_values_equal(left, right)))
				ParsedNotEqualOp:
					Ok(CompilerCtfeBoolValue(not compiler_ctfe_values_equal(left, right)))
				_:
					compiler_ctfe_eval_int_binary_desc(op, left, right)

	match desc_result:
		Ok(desc):
			result_type = compiler_ctfe_binary_result_type(op, left)
			Ok(
				compiler_ctfe_value(
					result_type,
					compiler_ctfe_round_float_desc(result_type, desc),
					left.span,
				),
			)
		Err(error):
			Err(error)


pure func compiler_ctfe_eval_unary(
	op: ParsedUnaryOp,
	value: CompilerCtfeValue,
) -> Result[CompilerCtfeValue, CompilerCtfeError]:
	match op:
		ParsedNegateOp:
			match value.desc:
				CompilerCtfeFloatValue(raw):
					Ok(
						compiler_ctfe_value(
							value.typ,
							compiler_ctfe_round_float_desc(
								value.typ,
								CompilerCtfeFloatValue(0.0 - raw),
							),
							value.span,
						),
					)
				_:
					raw ?= compiler_ctfe_expect_int(value)
					Ok(compiler_ctfe_int(value.span, 0 - raw))
		ParsedNotOp:
			raw ?= compiler_ctfe_expect_bool(value)
			Ok(compiler_ctfe_bool(value.span, not raw))
