-- Compile-time evaluator for normalized CTFE IR.
--
-- This evaluator covers the expression forms already normalized by
-- ctfe_ir.brp. Production materialization remains a separate slice.
import:
	../stage_01_file_io/source: CompilerSourceSpan
	../stage_03_parse/parsed_ast:
		ParsedBinaryOp,
		ParsedLogicalOp(ParsedAndOp, ParsedOrOp),
		ParsedParam,
		ParsedParamBinder(ParsedParamNameBinder, ParsedParamTupleBinder, ParsedParamWildcardBinder),
		ParsedUnaryOp,
	../stage_05_types/semantic_type: SemanticType, array_type, array_type_parts
	../stage_06_typecheck/infer: TypedExpr, TypedLambdaParam
	ctfe_context:
		CtfeContext,
		CtfeFunction,
		ctfe_context_function_by_callable_id,
		ctfe_context_imported_function_by_callable_id,
		ctfe_context_imported_functions_by_source,
		ctfe_context_module_global_env,
		ctfe_context_module_global_value,
	ctfe_env:
		CtfeEnvError,
		ctfe_assign_value,
		ctfe_bind_local_value,
		ctfe_bind_mutable_local_value,
		ctfe_env_concat,
		ctfe_env_empty,
		ctfe_env_error_message,
		ctfe_global_bindings,
		ctfe_lookup_value,
		ctfe_project_existing_bindings,
	ctfe_intrinsic:
		CtfeBuiltinIntrinsic(
			CtfeFromCharIntrinsic,
			CtfeFromCharsIntrinsic,
			CtfeTensorFillIntrinsic,
			CtfeToFloat16Intrinsic,
			CtfeToFloat32Intrinsic,
			CtfeToStringIntrinsic,
		),
		CtfeDictIntrinsic(
			CtfeDictContains,
			CtfeDictFromList,
			CtfeDictGet,
			CtfeDictGetOr,
			CtfeDictIsEmpty,
			CtfeDictLength,
			CtfeDictSet,
		),
		CtfeImportedIntrinsic(
			CtfeImportedBuiltinIntrinsic,
			CtfeImportedDictIntrinsic,
			CtfeImportedListIntrinsic,
			CtfeImportedMatrixIntrinsic,
			CtfeImportedOptionIntrinsic,
			CtfeImportedResultIntrinsic,
			CtfeImportedStringIntrinsic,
		),
		CtfeListIntrinsic(
			CtfeListAll,
			CtfeListAppend,
			CtfeListAny,
			CtfeListConcat,
			CtfeListContains,
			CtfeListFilter,
			CtfeListFilterMap,
			CtfeListFlatMap,
			CtfeListFoldLeft,
			CtfeListFoldRight,
			CtfeListGet,
			CtfeListGetOr,
			CtfeListJoin,
			CtfeListLength,
			CtfeListMake,
			CtfeListMap,
			CtfeListMapIndexed,
			CtfeListSet,
		),
		CtfeMatrixIntrinsic(CtfeMatrixColumnCount, CtfeMatrixRowCount),
		CtfeOptionIntrinsic(
			CtfeOptionAndThen,
			CtfeOptionFilter,
			CtfeOptionGetOr,
			CtfeOptionGetOrElse,
			CtfeOptionIsNone,
			CtfeOptionIsSome,
			CtfeOptionMap,
			CtfeOptionToResult,
		),
		CtfeResultIntrinsic(
			CtfeResultAndThen,
			CtfeResultGetOr,
			CtfeResultGetOrElse,
			CtfeResultIsErr,
			CtfeResultIsOk,
			CtfeResultMap,
			CtfeResultMapErr,
		),
		CtfeStringIntrinsic(
			CtfeStringChars,
			CtfeStringCount,
			CtfeStringContains,
			CtfeStringDropLeft,
			CtfeStringEndsWith,
			CtfeStringFromChar,
			CtfeStringFromChars,
			CtfeStringGet,
			CtfeStringGetOr,
			CtfeStringIndexOf,
			CtfeStringLength,
			CtfeStringLower,
			CtfeStringRawIndexOf,
			CtfeStringRepeat,
			CtfeStringReplace,
			CtfeStringReverse,
			CtfeStringSplit,
			CtfeStringStartsWith,
			CtfeStringSubstring,
			CtfeStringTakeLeft,
			CtfeStringTrim,
			CtfeStringTrimLeft,
			CtfeStringTrimRight,
			CtfeStringUpper,
		),
		ctfe_imported_intrinsic,
	ctfe_ir:
		CtfeIrAssignTarget(CtfeIrDiscardAssign, CtfeIrLocalAssign, CtfeIrModuleAssign),
		CtfeIrBlock,
		CtfeIrBlockItem(
			CtfeIrAssignItem,
			CtfeIrBindQuestionItem,
			CtfeIrBindTupleItem,
			CtfeIrBindValueItem,
			CtfeIrDiscardItem,
		),
		CtfeIrCall,
		CtfeIrCallKind(
			CtfeIrBuiltinCall,
			CtfeIrClosureCall,
			CtfeIrConstructorCall,
			CtfeIrImpureCall,
			CtfeIrImportedCall,
			CtfeIrIntrinsicCall,
			CtfeIrLocalCall,
			CtfeIrUnresolvedCall,
			CtfeIrUnsupportedCall,
		),
		CtfeIrDictEntry,
		CtfeIrExpr,
		CtfeIrExprDesc(
			CtfeIrBinaryExpr,
			CtfeIrBlockExpr,
			CtfeIrCallExpr,
			CtfeIrDictExpr,
			CtfeIrFieldAccessExpr,
			CtfeIrForExpr,
			CtfeIrForTupleExpr,
			CtfeIrIfExpr,
			CtfeIrImportedGlobalExpr,
			CtfeIrIdentExpr,
			CtfeIrListExpr,
			CtfeIrLambdaExpr,
			CtfeIrLiteralExpr,
			CtfeIrLogicalExpr,
			CtfeIrMatchExpr,
			CtfeIrRecordExpr,
			CtfeIrRecordUpdateExpr,
			CtfeIrRangeExpr,
			CtfeIrBreakExpr,
			CtfeIrContinueExpr,
			CtfeIrStringInterpolationExpr,
			CtfeIrTransparentExpr,
			CtfeIrTupleExpr,
			CtfeIrUnaryExpr,
			CtfeIrVectorExpr,
			CtfeIrWhileExpr,
			CtfeIrVoidExpr,
		),
		CtfeIrField,
		CtfeIrFieldAccess,
