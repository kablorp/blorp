			CtfeIrRangeEndField,
			CtfeIrRangeInvalidField,
			CtfeIrRangeStartField,
			CtfeIrRecordField,
			CtfeIrTupleField,
			CtfeIrTupleInvalidField,
		),
		CtfeIrIdentifier,
		CtfeIrImportedGlobal,
		CtfeIrLiteral(
			CtfeIrBoolLiteral,
			CtfeIrCharLiteral,
			CtfeIrFloatLiteral,
			CtfeIrIntLiteral,
			CtfeIrStringLiteral,
		),
		CtfeIrMatchCase,
		CtfeIrReferenceKind(
			CtfeIrImpureFunctionReference,
			CtfeIrLocalFunctionReference,
			CtfeIrNullaryConstructorReference,
			CtfeIrUnsupportedFunctionReference,
			CtfeIrValueReference,
		),
		CtfeIrStringPart(CtfeIrStringExpr, CtfeIrStringText),
		CtfeIrTranslateError,
		ctfe_ir_from_typed_expr,
		ctfe_ir_translate_error_message,
	ctfe_pattern: ctfe_pattern_bind
	ctfe_value:
		CtfeEnv,
		CtfeError,
		CtfeLambdaPayload,
		CtfeValue,
		CtfeValueDesc(
			CtfeConstructorValue,
			CtfeDictValue,
			CtfeFloatValue,
			CtfeFunctionReferenceValue,
			CtfeIntValue,
			CtfeLambdaValue,
			CtfeListValue,
			CtfeRangeValue,
			CtfeRecordValue,
			CtfeStringValue,
			CtfeTupleValue,
			CtfeVectorValue,
			CtfeVoidValue,
		),
		ctfe_bool,
		ctfe_char,
		ctfe_constructor_info,
		ctfe_error_message,
		ctfe_eval_binary,
		ctfe_eval_unary,
		ctfe_expect_bool,
		ctfe_expect_char,
		ctfe_expect_int,
		ctfe_expect_string,
		ctfe_float,
		ctfe_function_reference,
		ctfe_int,
		ctfe_string,
		ctfe_value,
		ctfe_values_equal,
	ctfe_value_ops:
		CtfeOptionState(CtfeOptionNone, CtfeOptionSome),
		CtfeResultState(CtfeResultErr, CtfeResultOk),
		ctfe_option_none_value,
		ctfe_option_some_value,
		ctfe_option_state,
		ctfe_result_err_value,
		ctfe_result_ok_value,
		ctfe_result_state,
		ctfe_string_text_of_value,
	string as StringOps


union CtfeEvalError:
	CtfeEvalTranslateError(CtfeIrTranslateError)
	CtfeEvalEnvError(CtfeEnvError)
	CtfeEvalValueError(CtfeError)
	CtfeEvalInvalid(String)
	CtfeEvalUnsupported(String)


private union CtfeBlockItemResult:
	CtfeBlockItemContinue(CtfeEnv)
	CtfeBlockItemReturn(CtfeValue)


private union CtfeLoopBodyResult:
	CtfeLoopBodyValue(CtfeEnv, CtfeValue)
	CtfeLoopBodyBreak(CtfeEnv)
	CtfeLoopBodyContinue(CtfeEnv)


private union CtfeCallback:
	CtfeNamedCallback(Int, String)
	CtfeLambdaCallback(CtfeLambdaPayload)


pure func ctfe_eval_error_message(error: CtfeEvalError) -> String:
	match error:
		CtfeEvalTranslateError(translate_error):
			ctfe_ir_translate_error_message(translate_error)
		CtfeEvalEnvError(env_error):
			ctfe_env_error_message(env_error)
		CtfeEvalValueError(value_error):
			ctfe_error_message(value_error)
		CtfeEvalInvalid(message):
			message
		CtfeEvalUnsupported(form):
			"compile-time constant evaluation does not support ${form} yet"


private pure func ctfe_eval_value_result(
	result: Result[CtfeValue, CtfeError],
) -> Result[CtfeValue, CtfeEvalError]:
	-- Keep error adaptation concrete here. The current self-hosted compiler
	-- cannot reliably specialize Result.map_err throughout this large module.
	match result:
		Ok(value):
			Ok(value)
		Err(error):
			Err(CtfeEvalValueError(error))


private pure func ctfe_eval_bool_result(
	result: Result[Bool, CtfeError],
) -> Result[Bool, CtfeEvalError]:
	match result:
		Ok(value):
			Ok(value)
		Err(error):
			Err(CtfeEvalValueError(error))


private pure func ctfe_eval_int_result(
	result: Result[Int, CtfeError],
) -> Result[Int, CtfeEvalError]:
	match result:
		Ok(value):
			Ok(value)
		Err(error):
			Err(CtfeEvalValueError(error))


private pure func ctfe_eval_void_value(expr: CtfeIrExpr) -> CtfeValue:
	ctfe_value(ctfe_ir_eval_type(expr), CtfeVoidValue, ctfe_ir_eval_span(expr))


private pure func ctfe_eval_bindings_result(
	result: Result[Option[List[(String, CtfeValue)]], CtfeError],
) -> Result[Option[List[(String, CtfeValue)]], CtfeEvalError]:
	match result:
		Ok(value):
			Ok(value)
		Err(error):
			Err(CtfeEvalValueError(error))


private pure func ctfe_eval_string_result(
	result: Result[String, CtfeError],
) -> Result[String, CtfeEvalError]:
	match result:
		Ok(value):
			Ok(value)
		Err(error):
			Err(CtfeEvalValueError(error))


private pure func ctfe_eval_char_result(
	result: Result[Char, CtfeError],
) -> Result[Char, CtfeEvalError]:
	match result:
		Ok(value):
			Ok(value)
		Err(error):
			Err(CtfeEvalValueError(error))


private pure func ctfe_eval_option_state_result(
	result: Result[CtfeOptionState, CtfeError],
) -> Result[CtfeOptionState, CtfeEvalError]:
	match result:
		Ok(value):
			Ok(value)
		Err(error):
			Err(CtfeEvalValueError(error))


private pure func ctfe_eval_result_state_result(
	result: Result[CtfeResultState, CtfeError],
) -> Result[CtfeResultState, CtfeEvalError]:
	match result:
		Ok(value):
			Ok(value)
		Err(error):
			Err(CtfeEvalValueError(error))


private pure func ctfe_eval_translate_result(
	result: Result[CtfeIrExpr, CtfeIrTranslateError],
) -> Result[CtfeIrExpr, CtfeEvalError]:
	match result:
		Ok(expr):
			Ok(expr)
		Err(error):
			Err(CtfeEvalTranslateError(error))


private pure func ctfe_ir_eval_span(expr: CtfeIrExpr) -> CompilerSourceSpan:
	expr.span


private pure func ctfe_ir_eval_type(expr: CtfeIrExpr) -> SemanticType:
	expr.value_type


private pure func ctfe_eval_lookup(env: CtfeEnv, name: String) -> Result[CtfeValue, CtfeEvalError]:
	match ctfe_lookup_value(env, name):
		Ok(value):
			Ok(value)
		Err(error):
			Err(CtfeEvalEnvError(error))


private pure func ctfe_eval_literal(expr: CtfeIrExpr, literal: CtfeIrLiteral) -> CtfeValue:
	match literal:
		CtfeIrIntLiteral(text):
			ctfe_int(
				ctfe_ir_eval_span(expr),
				text
					.parse_int()
					.get_or(0),
			)
		CtfeIrFloatLiteral(text):
			ctfe_float(
				ctfe_ir_eval_span(expr),
				text
					.parse_float()
					.get_or(0.0),
			)
		CtfeIrStringLiteral(text):
			ctfe_string(ctfe_ir_eval_span(expr), text)
		CtfeIrBoolLiteral(value):
			ctfe_bool(ctfe_ir_eval_span(expr), value)
		CtfeIrCharLiteral(value):
			ctfe_char(ctfe_ir_eval_span(expr), to_char(value))


private pure func ctfe_eval_identifier(
	env: CtfeEnv,
	expr: CtfeIrExpr,
	identifier: CtfeIrIdentifier,
) -> Result[CtfeValue, CtfeEvalError]:
	match identifier.reference_kind:
		CtfeIrValueReference:
			ctfe_eval_lookup(env, identifier.name)
		CtfeIrNullaryConstructorReference(constructor):
			Ok(ctfe_value(
				ctfe_ir_eval_type(expr),
				CtfeConstructorValue({
					name = constructor.name,
					args = [],
					constructor_info = {
						parent_type = constructor.parent_type,
						arity = 0,
						callable_id = constructor.callable_id
					},
				}),
				ctfe_ir_eval_span(expr),
			))
		CtfeIrLocalFunctionReference(call):
			Ok(
				ctfe_function_reference(
					ctfe_ir_eval_type(expr),
					ctfe_ir_eval_span(expr),
					call.callable_id,
					call.source_name,
					call.is_pure,
				),
			)
		CtfeIrUnsupportedFunctionReference(source_name):
			Err(CtfeEvalUnsupported("function reference '" + source_name + "'"))
		CtfeIrImpureFunctionReference:
			Err(CtfeEvalUnsupported("impure function references"))


private pure func ctfe_eval_exprs(
	context: CtfeContext,
	env: CtfeEnv,
	exprs: List[CtfeIrExpr],
) -> Result[List[CtfeValue], CtfeEvalError]:
	var values: List[CtfeValue] = []
	var failure: Option[CtfeEvalError] = None

	for item in exprs:
		match ctfe_eval_ir_in_context(context, env, item):
			Ok(value):
				values = values.append(value)
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(values)


private pure func ctfe_eval_fields(
	context: CtfeContext,
	env: CtfeEnv,
	fields: List[CtfeIrField],
) -> Result[List[(String, CtfeValue)], CtfeEvalError]:
	var values: List[(String, CtfeValue)] = []
	var failure: Option[CtfeEvalError] = None

	for field in fields:
		match ctfe_eval_ir_in_context(context, env, field.value):
			Ok(value):
				values = values.append((field.name, value))
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(values)


private pure func ctfe_eval_dict_entries(
	context: CtfeContext,
	env: CtfeEnv,
	entries: List[CtfeIrDictEntry],
) -> Result[List[(CtfeValue, CtfeValue)], CtfeEvalError]:
	var values: List[(CtfeValue, CtfeValue)] = []
	var failure: Option[CtfeEvalError] = None

	for entry in entries:
		match ctfe_eval_ir_in_context(context, env, entry.key):
			Ok(key):
				match ctfe_eval_ir_in_context(context, env, entry.value):
					Ok(value):
						values = values.append((key, value))
					Err(error):
						failure = Some(error)
						break
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(values)


private pure func ctfe_eval_logical(
	context: CtfeContext,
	env: CtfeEnv,
	expr: CtfeIrExpr,
	op: ParsedLogicalOp,
	left: CtfeIrExpr,
	right: CtfeIrExpr,
) -> Result[CtfeValue, CtfeEvalError]:
	left_value ?= ctfe_eval_ir_in_context(context, env, left)
	left_bool ?= ctfe_eval_bool_result(ctfe_expect_bool(left_value))

	match op:
		ParsedAndOp:
			if not left_bool:
				Ok(ctfe_bool(ctfe_ir_eval_span(expr), False))
			else:
				right_value ?= ctfe_eval_ir_in_context(context, env, right)
				right_bool ?= ctfe_eval_bool_result(ctfe_expect_bool(right_value))
				Ok(ctfe_bool(ctfe_ir_eval_span(expr), right_bool))
		ParsedOrOp:
			if left_bool:
				Ok(ctfe_bool(ctfe_ir_eval_span(expr), True))
			else:
				right_value ?= ctfe_eval_ir_in_context(context, env, right)
				right_bool ?= ctfe_eval_bool_result(ctfe_expect_bool(right_value))
				Ok(ctfe_bool(ctfe_ir_eval_span(expr), right_bool))


private pure func ctfe_eval_unary_expr(
	context: CtfeContext,
	env: CtfeEnv,
	op: ParsedUnaryOp,
	inner: CtfeIrExpr,
) -> Result[CtfeValue, CtfeEvalError]:
	value ?= ctfe_eval_ir_in_context(context, env, inner)
	ctfe_eval_value_result(ctfe_eval_unary(op, value))


private pure func ctfe_eval_binary_expr(
	context: CtfeContext,
	env: CtfeEnv,
	op: ParsedBinaryOp,
	left: CtfeIrExpr,
	right: CtfeIrExpr,
) -> Result[CtfeValue, CtfeEvalError]:
	left_value ?= ctfe_eval_ir_in_context(context, env, left)
	right_value ?= ctfe_eval_ir_in_context(context, env, right)
	ctfe_eval_value_result(ctfe_eval_binary(op, left_value, right_value))


private pure func ctfe_eval_if(
	context: CtfeContext,
	env: CtfeEnv,
	expr: CtfeIrExpr,
	condition: CtfeIrExpr,
	then_expr: CtfeIrExpr,
	else_expr: Option[CtfeIrExpr],
) -> Result[CtfeValue, CtfeEvalError]:
	condition_value ?= ctfe_eval_ir_in_context(context, env, condition)
	condition_bool ?= ctfe_eval_bool_result(ctfe_expect_bool(condition_value))

	if condition_bool:
		ctfe_eval_ir_in_context(context, env, then_expr)
	else:
		match else_expr:
			Some(value):
				ctfe_eval_ir_in_context(context, env, value)
			None:
				Ok(ctfe_value(ctfe_ir_eval_type(expr), CtfeVoidValue, ctfe_ir_eval_span(expr)))


private pure func ctfe_eval_record_field(
	fields: List[(String, CtfeValue)],
	field_name: String,
) -> Result[CtfeValue, CtfeEvalError]:
	var result: Option[CtfeValue] = None

	for (name, value) in fields:
		if result.is_none() and name == field_name:
			result = Some(value)
			break

	match result:
		Some(value):
			Ok(value)
		None:
			Err(CtfeEvalInvalid("compile-time record value has no field '" + field_name + "'"))


private pure func ctfe_eval_tuple_field(
	values: List[CtfeValue],
	index: Int,
	field_name: String,
) -> Result[CtfeValue, CtfeEvalError]:
	match values.get(index):
		Some(value):
			Ok(value)
		None:
			Err(CtfeEvalInvalid("compile-time tuple value has no field '" + field_name + "'"))


private pure func ctfe_eval_field_access_kind(
	kind: CtfeIrFieldAccessKind,
	value: CtfeValue,
) -> Result[CtfeValue, CtfeEvalError]:
	match kind:
		CtfeIrRecordField(field_name):
			match value.desc:
				CtfeRecordValue(fields):
					ctfe_eval_record_field(fields, field_name)
				_:
					Err(CtfeEvalUnsupported("field access on this value"))
		CtfeIrTupleField(index, field_name):
			match value.desc:
				CtfeTupleValue(values):
					ctfe_eval_tuple_field(values, index, field_name)
				_:
					Err(CtfeEvalUnsupported("field access on this value"))
		CtfeIrTupleInvalidField(field_name):
			match value.desc:
				CtfeTupleValue(_):
					Err(CtfeEvalUnsupported("tuple field access '" + field_name + "'"))
				_:
					Err(CtfeEvalUnsupported("field access on this value"))
		CtfeIrRangeStartField:
			match value.desc:
				CtfeRangeValue(start_value, _):
					Ok(start_value)
				_:
					Err(CtfeEvalUnsupported("field access on this value"))
		CtfeIrRangeEndField:
			match value.desc:
				CtfeRangeValue(_, end_value):
					Ok(end_value)
				_:
					Err(CtfeEvalUnsupported("field access on this value"))
		CtfeIrRangeInvalidField(field_name):
			match value.desc:
				CtfeRangeValue(_, _):
					Err(
						CtfeEvalInvalid(
							"compile-time Range value has no field '" + field_name + "'",
						),
					)
				_:
					Err(CtfeEvalUnsupported("field access on this value"))


private pure func ctfe_eval_field_access(
	context: CtfeContext,
	env: CtfeEnv,
	access: CtfeIrFieldAccess,
) -> Result[CtfeValue, CtfeEvalError]:
	receiver_value ?= ctfe_eval_ir_in_context(context, env, access.receiver)
	ctfe_eval_field_access_kind(access.kind, receiver_value)


private pure func ctfe_eval_imported_global(
	context: CtfeContext,
	imported: CtfeIrImportedGlobal,
) -> Result[CtfeValue, CtfeEvalError]:
	match ctfe_context_module_global_value(context, imported.module_path, imported.name):
		Some(value):
			Ok(value)
		None:
			Err(
				CtfeEvalInvalid(
					"global constant initializer cannot reference imported value '" + imported.module_path + "." + imported.name + "' because it is not a compile-time constant",
				),
			)


private pure func ctfe_replace_record_field(
	fields: List[(String, CtfeValue)],
	update: (String, CtfeValue),
) -> Result[List[(String, CtfeValue)], CtfeEvalError]:
	(update_name, update_value) = update
	var replaced: Bool = False
	var result: List[(String, CtfeValue)] = []

	for (name, value) in fields:
		if not replaced and name == update_name:
			result = result.append((name, update_value))
			replaced = True
		else:
			result = result.append((name, value))

	if replaced:
		Ok(result)
	else:
		Err(CtfeEvalInvalid("compile-time record value has no field '" + update_name + "'"))


private pure func ctfe_apply_record_updates(
	fields: List[(String, CtfeValue)],
	updates: List[(String, CtfeValue)],
) -> Result[List[(String, CtfeValue)], CtfeEvalError]:
	var result = fields
	var failure: Option[CtfeEvalError] = None

	for update in updates:
		match ctfe_replace_record_field(result, update):
			Ok(next):
				result = next
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(result)


private pure func ctfe_eval_record_update(
	context: CtfeContext,
	env: CtfeEnv,
	expr: CtfeIrExpr,
	base: CtfeIrExpr,
	updates: List[CtfeIrField],
) -> Result[CtfeValue, CtfeEvalError]:
	base_value ?= ctfe_eval_ir_in_context(context, env, base)
	update_values ?= ctfe_eval_fields(context, env, updates)

	match base_value.desc:
		CtfeRecordValue(fields):
			updated ?= ctfe_apply_record_updates(fields, update_values)
			Ok(
				ctfe_value(
					ctfe_ir_eval_type(expr),
					CtfeRecordValue(updated),
					ctfe_ir_eval_span(expr),
				),
			)
		_:
			Err(CtfeEvalUnsupported("record update on non-record values"))


private pure func ctfe_eval_range(
	context: CtfeContext,
	env: CtfeEnv,
	expr: CtfeIrExpr,
	start_expr: CtfeIrExpr,
	end_expr: CtfeIrExpr,
) -> Result[CtfeValue, CtfeEvalError]:
	start_value ?= ctfe_eval_ir_in_context(context, env, start_expr)
	end_value ?= ctfe_eval_ir_in_context(context, env, end_expr)
	start_int ?= ctfe_eval_int_result(ctfe_expect_int(start_value))
	end_int ?= ctfe_eval_int_result(ctfe_expect_int(end_value))

	Ok(
		ctfe_value(
			ctfe_ir_eval_type(expr),
			CtfeRangeValue(start_value, end_value),
			ctfe_ir_eval_span(expr),
		),
	)


private pure func ctfe_eval_string_interpolation(
	context: CtfeContext,
	env: CtfeEnv,
	expr: CtfeIrExpr,
	parts: List[CtfeIrStringPart],
) -> Result[CtfeValue, CtfeEvalError]:
	var text: String = ""
	var failure: Option[CtfeEvalError] = None

	for part in parts:
		match part:
			CtfeIrStringText(value):
				text += value
			CtfeIrStringExpr(part_expr):
				match ctfe_eval_ir_in_context(context, env, part_expr):
					Ok(value):
						match ctfe_eval_string_result(ctfe_string_text_of_value(value)):
							Ok(part_text):
								text += part_text
							Err(error):
								failure = Some(error)
								break
					Err(error):
						failure = Some(error)
						break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(ctfe_string(ctfe_ir_eval_span(expr), text))


private pure func ctfe_eval_block_item(
	context: CtfeContext,
	env: CtfeEnv,
	block_expr: CtfeIrExpr,
	item: CtfeIrBlockItem,
) -> Result[CtfeBlockItemResult, CtfeEvalError]:
	match item:
		CtfeIrDiscardItem(expr):
			match expr.desc:
				CtfeIrWhileExpr(condition, body):
					next_env ?= ctfe_eval_while_env(context, env, condition, body)
					Ok(CtfeBlockItemContinue(next_env))
				CtfeIrForExpr(name, iterable, body):
					next_env ?= ctfe_eval_for_env(context, env, name, iterable, body)
					Ok(CtfeBlockItemContinue(next_env))
				CtfeIrForTupleExpr(names, iterable, body):
					next_env ?= ctfe_eval_for_tuple_env(context, env, names, iterable, body)
					Ok(CtfeBlockItemContinue(next_env))
				CtfeIrBreakExpr:
					Err(CtfeEvalUnsupported("break expressions"))
				CtfeIrContinueExpr:
					Err(CtfeEvalUnsupported("continue expressions"))
				_:
					ignored ?= ctfe_eval_ir_in_context(context, env, expr)
					Ok(CtfeBlockItemContinue(env))
		CtfeIrBindValueItem(name, _, init, is_mutable):
			value ?= ctfe_eval_ir_in_context(context, env, init)

			if is_mutable:
				Ok(CtfeBlockItemContinue(ctfe_bind_mutable_local_value(env, name, value)))
			else:
				Ok(CtfeBlockItemContinue(ctfe_bind_local_value(env, name, value)))
		CtfeIrBindTupleItem(names, init):
			value ?= ctfe_eval_ir_in_context(context, env, init)

			match value.desc:
				CtfeTupleValue(values):
					if names.length() == values.length():
						var next_env = env
						var index: Int = 0

						for name in names:
							match values.get(index):
								Some(item_value):
									next_env = ctfe_bind_local_value(next_env, name, item_value)
								None:
									void

							index += 1

						Ok(CtfeBlockItemContinue(next_env))
					else:
						Err(CtfeEvalInvalid("compile-time tuple destructuring expected " + names
									.length()
									.to_string() + " values, found " + values
									.length()
									.to_string()))
				_:
					Err(CtfeEvalUnsupported("tuple destructuring on non-tuple values"))
		CtfeIrBindQuestionItem(name, _, rhs):
			carrier ?= ctfe_eval_ir_in_context(context, env, rhs)

			match ctfe_option_state(carrier):
				Ok(CtfeOptionSome(value)):
					Ok(CtfeBlockItemContinue(ctfe_bind_local_value(env, name, value)))
				Ok(CtfeOptionNone):
					Ok(
						CtfeBlockItemReturn(
							ctfe_option_none_value(
								ctfe_ir_eval_type(block_expr),
								ctfe_ir_eval_span(block_expr),
							),
						),
					)
				Err(_):
					match ctfe_result_state(carrier):
						Ok(CtfeResultOk(value)):
							Ok(CtfeBlockItemContinue(ctfe_bind_local_value(env, name, value)))
						Ok(CtfeResultErr(error_value)):
							Ok(
								CtfeBlockItemReturn(
									ctfe_result_err_value(
										ctfe_ir_eval_type(block_expr),
										ctfe_ir_eval_span(block_expr),
										error_value,
									),
								),
							)
						Err(_):
							Err(CtfeEvalUnsupported("?= on non-Option/non-Result values"))
		CtfeIrAssignItem(target, value_expr, span):
			value ?= ctfe_eval_ir_in_context(context, env, value_expr)

			match target:
				CtfeIrDiscardAssign:
					Ok(CtfeBlockItemContinue(env))
				CtfeIrLocalAssign(name):
					match ctfe_assign_value(env, span, name, value):
						Ok(assign_result):
							Ok(CtfeBlockItemContinue(assign_result.env))
						Err(error):
							Err(CtfeEvalEnvError(error))
				CtfeIrModuleAssign(name):
					Err(CtfeEvalUnsupported("module-scope assignment to '" + name + "'"))


private pure func ctfe_eval_block(
	context: CtfeContext,
	env: CtfeEnv,
	block_expr: CtfeIrExpr,
	block: CtfeIrBlock,
) -> Result[CtfeValue, CtfeEvalError]:
	var block_env = env
	var failure: Option[CtfeEvalError] = None
	var early_return: Option[CtfeValue] = None

	for item in block.items:
		match ctfe_eval_block_item(context, block_env, block_expr, item):
			Ok(CtfeBlockItemContinue(next_env)):
				block_env = next_env
			Ok(CtfeBlockItemReturn(value)):
				early_return = Some(value)
				break
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			match early_return:
				Some(value):
					Ok(value)
				None:
					ctfe_eval_ir_in_context(context, block_env, block.result)


private pure func ctfe_function_global_env(
	context: CtfeContext,
	caller_env: CtfeEnv,
	ctfe_function: CtfeFunction,
) -> CtfeEnv:
	match ctfe_function.module_path:
		Some(module_path):
			ctfe_context_module_global_env(context, module_path)
		None:
			ctfe_global_bindings(caller_env)


private pure func ctfe_bind_tuple_param_values(
	env: CtfeEnv,
	names: List[String],
	values: List[CtfeValue],
) -> Result[CtfeEnv, CtfeEvalError]:
	if names.length() != values.length():
		Err(CtfeEvalInvalid("compile-time tuple parameter expected " + names
					.length()
					.to_string() + " values, found " + values
					.length()
					.to_string()))
	else:
		var next_env = env
		var index: Int = 0

		for name in names:
			match values.get(index):
				Some(value):
					next_env = ctfe_bind_local_value(next_env, name, value)
				None:
					void

			index += 1

		Ok(next_env)


private pure func ctfe_bind_function_param(
	env: CtfeEnv,
	param: ParsedParam,
	value: CtfeValue,
) -> Result[CtfeEnv, CtfeEvalError]:
	match param.binder:
		ParsedParamNameBinder(name):
			Ok(ctfe_bind_local_value(env, name.text, value))
		ParsedParamWildcardBinder(_):
			Ok(env)
		ParsedParamTupleBinder(names, _):
			match value.desc:
				CtfeTupleValue(values):
					ctfe_bind_tuple_param_values(
						env,
						names.map(func(name): name.text),
						values,
					)
				_:
					Err(CtfeEvalUnsupported("tuple parameters on non-tuple values"))


private pure func ctfe_bind_function_params(
	params: List[ParsedParam],
	arg_values: List[CtfeValue],
) -> Result[CtfeEnv, CtfeEvalError]:
	if params.length() != arg_values.length():
		Err(CtfeEvalInvalid("compile-time function call expected " + params
					.length()
					.to_string() + " argument(s), found " + arg_values
					.length()
					.to_string()))
	else:
		var env: CtfeEnv = ctfe_env_empty()
		var failure: Option[CtfeEvalError] = None
		var index: Int = 0

		for param in params:
			match arg_values.get(index):
				Some(value):
					match ctfe_bind_function_param(env, param, value):
						Ok(next_env):
							env = next_env
						Err(error):
							failure = Some(error)
							break
				None:
					failure = Some(CtfeEvalInvalid("compile-time function call missing argument"))
					break

			index += 1

		match failure:
			Some(error):
				Err(error)
			None:
				Ok(env)


private pure func ctfe_bind_lambda_params(
	params: List[TypedLambdaParam],
	arg_values: List[CtfeValue],
) -> Result[CtfeEnv, CtfeEvalError]:
	if params.length() != arg_values.length():
		Err(CtfeEvalInvalid("compile-time lambda call expected " + params
					.length()
					.to_string() + " argument(s), found " + arg_values
					.length()
					.to_string()))
	else:
		var env: CtfeEnv = ctfe_env_empty()
		var failure: Option[CtfeEvalError] = None
		var index: Int = 0

		for param in params:
			match arg_values.get(index):
				Some(value):
					env = ctfe_bind_local_value(env, param.name.text, value)
				None:
					failure = Some(CtfeEvalInvalid("compile-time lambda call missing argument"))
					break

			index += 1

		match failure:
			Some(error):
				Err(error)
			None:
				Ok(env)


private pure func ctfe_eval_lambda_call(
	context: CtfeContext,
	closure: CtfeLambdaPayload,
	arg_values: List[CtfeValue],
) -> Result[CtfeValue, CtfeEvalError]:
	if not closure.source.is_pure:
		Err(CtfeEvalUnsupported("impure closure calls"))
	else:
		param_env ?= ctfe_bind_lambda_params(closure.source.params, arg_values)
		body_ir ?= ctfe_eval_translate_result(ctfe_ir_from_typed_expr(context, closure.source.body))
		ctfe_eval_ir_in_context(
			context,
			ctfe_env_concat(param_env, closure.env),
			body_ir,
		)


private pure func ctfe_function_call_env(
	context: CtfeContext,
	caller_env: CtfeEnv,
	ctfe_function: CtfeFunction,
	arg_values: List[CtfeValue],
) -> Result[CtfeEnv, CtfeEvalError]:
	param_env ?= ctfe_bind_function_params(ctfe_function.info.decl.params, arg_values)
	global_env = ctfe_function_global_env(context, caller_env, ctfe_function)
	Ok(ctfe_env_concat(param_env, global_env))


private pure func ctfe_eval_ctfe_function_call(
	context: CtfeContext,
	caller_env: CtfeEnv,
	ctfe_function: CtfeFunction,
	arg_values: List[CtfeValue],
) -> Result[CtfeValue, CtfeEvalError]:
	if not ctfe_function.info.decl.is_pure:
		Err(CtfeEvalUnsupported("impure function calls"))
	else:
		match ctfe_function.info.body:
			Some(body):
				function_context = { context | active_module_path = ctfe_function.module_path }
				body_ir ?= ctfe_eval_translate_result(
					ctfe_ir_from_typed_expr(
						function_context,
						body,
					),
				)

				function_env ?= ctfe_function_call_env(
					function_context,
					caller_env,
					ctfe_function,
					arg_values,
				)
				ctfe_eval_ir_in_context(function_context, function_env, body_ir)
			None:
				Err(CtfeEvalUnsupported("function declarations without bodies"))


private pure func ctfe_eval_function_call(
	context: CtfeContext,
	caller_env: CtfeEnv,
	callable_id: Int,
	source_name: String,
	arg_values: List[CtfeValue],
) -> Result[CtfeValue, CtfeEvalError]:
	match ctfe_context_function_by_callable_id(context, callable_id):
		Some(ctfe_function):
			ctfe_eval_ctfe_function_call(context, caller_env, ctfe_function, arg_values)
		None:
			Err(
				CtfeEvalInvalid(
					"internal compile-time constant evaluation error: cannot find function '" + source_name + "'",
				),
			)


private pure func ctfe_eval_imported_function_call(
	context: CtfeContext,
	caller_env: CtfeEnv,
	module_path: String,
	callable_id: Int,
	source_name: String,
	arg_values: List[CtfeValue],
) -> Result[CtfeValue, CtfeEvalError]:
	match ctfe_context_imported_function_by_callable_id(
		context,
		module_path,
		source_name,
		callable_id,
	):
		Some(ctfe_function):
			ctfe_eval_ctfe_function_call(context, caller_env, ctfe_function, arg_values)
		None:
			functions = ctfe_context_imported_functions_by_source(context, module_path, source_name)

			if functions.length() == 1:
				match functions.get(0):
					Some(ctfe_function):
						ctfe_eval_ctfe_function_call(context, caller_env, ctfe_function, arg_values)
					None:
						Err(CtfeEvalInvalid((
									"internal compile-time constant evaluation error: imported function group was "
									+ "empty"
								)))
			else if functions.length() == 0:
				Err(
					CtfeEvalUnsupported(
						"imported function call '" + module_path + "." + source_name + "'",
					),
				)
			else:
				Err(
					CtfeEvalInvalid(
						"compile-time imported function call '" + module_path + "." + source_name + "' is ambiguous",
					),
				)


private pure func ctfe_eval_constructor_call(
	expr: CtfeIrExpr,
	callable_id: Int,
	source_name: String,
	parent_type: String,
	arg_values: List[CtfeValue],
) -> Result[CtfeValue, CtfeEvalError]:
	Ok(ctfe_value(
		ctfe_ir_eval_type(expr),
		CtfeConstructorValue({
			name = source_name,
			args = arg_values,
			constructor_info = ctfe_constructor_info(
				parent_type,
				arg_values.length(),
				Some(callable_id),
			),
		}),
		ctfe_ir_eval_span(expr),
	))


private pure func ctfe_eval_return_value(expr: CtfeIrExpr, value: CtfeValue) -> CtfeValue:
	{ value |
		typ = ctfe_ir_eval_type(expr),
		span = ctfe_ir_eval_span(expr)
	}


private pure func ctfe_eval_expect_list(value: CtfeValue) -> Result[List[CtfeValue], CtfeEvalError]:
	match value.desc:
		CtfeListValue(values):
			Ok(values)
		_:
			Err(CtfeEvalUnsupported("List intrinsic on non-List values"))


private pure func ctfe_eval_expect_dict(
	value: CtfeValue,
) -> Result[List[(CtfeValue, CtfeValue)], CtfeEvalError]:
	match value.desc:
		CtfeDictValue(entries):
			Ok(entries)
		_:
			Err(CtfeEvalUnsupported("Dict intrinsic on non-Dict values"))


private pure func ctfe_eval_dict_get(
	entries: List[(CtfeValue, CtfeValue)],
	key: CtfeValue,
) -> Option[CtfeValue]:
	var result: Option[CtfeValue] = None

	for entry in entries:
		if result.is_none() and ctfe_values_equal(entry[0], key):
			result = Some(entry[1])
			break

	result


private pure func ctfe_eval_dict_set(
	entries: List[(CtfeValue, CtfeValue)],
	key: CtfeValue,
	value: CtfeValue,
) -> List[(CtfeValue, CtfeValue)]:
	var result: List[(CtfeValue, CtfeValue)] = []
	var replaced: Bool = False

	for entry in entries:
		if not replaced and ctfe_values_equal(entry[0], key):
			result = result.append((key, value))
			replaced = True
		else:
			result = result.append(entry)

	if not replaced:
		result = result.append((key, value))

	result


private pure func ctfe_eval_dict_from_list(
	values: List[CtfeValue],
) -> Result[List[(CtfeValue, CtfeValue)], CtfeEvalError]:
	var entries: List[(CtfeValue, CtfeValue)] = []
	var failure: Option[CtfeEvalError] = None

	for value in values:
		match value.desc:
			CtfeTupleValue(items):
				match (items.get(0), items.get(1)):
					(Some(key), Some(item)):
						if items.length() == 2:
							entries = ctfe_eval_dict_set(entries, key, item)
						else:
							failure = Some(
								CtfeEvalUnsupported("std/dict.from_list expects key-value pairs"),
							)
					_:
						failure = Some(
							CtfeEvalUnsupported("std/dict.from_list expects key-value pairs"),
						)
			_:
				failure = Some(CtfeEvalUnsupported("std/dict.from_list expects key-value pairs"))

		if failure.is_some():
			break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(entries)


private pure func ctfe_eval_option_value(expr: CtfeIrExpr, value: Option[CtfeValue]) -> CtfeValue:
	match value:
		Some(inner):
			ctfe_option_some_value(ctfe_ir_eval_type(expr), ctfe_ir_eval_span(expr), inner)
		None:
			ctfe_option_none_value(ctfe_ir_eval_type(expr), ctfe_ir_eval_span(expr))


private pure func ctfe_eval_int_option_value(expr: CtfeIrExpr, value: Option[Int]) -> CtfeValue:
	match value:
		Some(inner):
			ctfe_eval_option_value(expr, Some(ctfe_int(ctfe_ir_eval_span(expr), inner)))
		None:
			ctfe_eval_option_value(expr, None)


private pure func ctfe_eval_char_option_value(expr: CtfeIrExpr, value: Option[Char]) -> CtfeValue:
	match value:
		Some(inner):
			ctfe_eval_option_value(expr, Some(ctfe_char(ctfe_ir_eval_span(expr), inner)))
		None:
			ctfe_eval_option_value(expr, None)


private pure func ctfe_eval_list_contains(values: List[CtfeValue], needle: CtfeValue) -> Bool:
	values.any(func(value): ctfe_values_equal(value, needle))


private pure func ctfe_eval_list_join_values(
	values: List[CtfeValue],
	separator: String,
) -> Result[String, CtfeEvalError]:
	var text: String = ""
	var first: Bool = True
	var failure: Option[CtfeEvalError] = None

	for value in values:
		if failure.is_none():
			match ctfe_eval_string_result(ctfe_expect_string(value)):
				Ok(part):
					if first:
						text = part
						first = False
					else:
						text = text + separator + part
				Err(error):
					failure = Some(error)
					break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(text)


private pure func ctfe_eval_callback(value: CtfeValue) -> Result[CtfeCallback, CtfeEvalError]:
	match value.desc:
		CtfeFunctionReferenceValue(reference):
			if reference.is_pure:
				Ok(CtfeNamedCallback(reference.callable_id, reference.source_name))
			else:
				Err(CtfeEvalUnsupported("impure callback calls"))
		CtfeLambdaValue(closure):
			Ok(CtfeLambdaCallback(closure))
		_:
			Err(CtfeEvalUnsupported("callback calls on non-function values"))


private pure func ctfe_eval_callback_call(
	context: CtfeContext,
	caller_env: CtfeEnv,
	callback: CtfeValue,
	arg_values: List[CtfeValue],
) -> Result[CtfeValue, CtfeEvalError]:
	callback_kind ?= ctfe_eval_callback(callback)

	match callback_kind:
		CtfeNamedCallback(callable_id, source_name):
			ctfe_eval_function_call(context, caller_env, callable_id, source_name, arg_values)
		CtfeLambdaCallback(closure):
			ctfe_eval_lambda_call(context, closure, arg_values)


private pure func ctfe_eval_list_map_values(
	context: CtfeContext,
	env: CtfeEnv,
	values: List[CtfeValue],
	callback: CtfeValue,
) -> Result[List[CtfeValue], CtfeEvalError]:
	var mapped: List[CtfeValue] = []
	var failure: Option[CtfeEvalError] = None

	for value in values:
		if failure.is_none():
			match ctfe_eval_callback_call(context, env, callback, [value]):
				Ok(item):
					mapped = mapped.append(item)
				Err(error):
					failure = Some(error)
					break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(mapped)


private pure func ctfe_eval_list_filter_values(
	context: CtfeContext,
	env: CtfeEnv,
	values: List[CtfeValue],
	callback: CtfeValue,
) -> Result[List[CtfeValue], CtfeEvalError]:
	var filtered: List[CtfeValue] = []
	var failure: Option[CtfeEvalError] = None

	for value in values:
		if failure.is_none():
			match ctfe_eval_callback_call(context, env, callback, [value]):
				Ok(keep_value):
					match ctfe_eval_bool_result(ctfe_expect_bool(keep_value)):
						Ok(keep):
							if keep:
								filtered = filtered.append(value)
						Err(error):
							failure = Some(error)
							break
				Err(error):
					failure = Some(error)
					break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(filtered)


private pure func ctfe_eval_list_filter_map_values(
	context: CtfeContext,
	env: CtfeEnv,
	values: List[CtfeValue],
	callback: CtfeValue,
) -> Result[List[CtfeValue], CtfeEvalError]:
	var mapped: List[CtfeValue] = []
	var failure: Option[CtfeEvalError] = None

	for value in values:
		if failure.is_none():
			match ctfe_eval_callback_call(context, env, callback, [value]):
				Ok(option_value):
					match ctfe_eval_option_state_result(ctfe_option_state(option_value)):
						Ok(CtfeOptionSome(item)):
							mapped = mapped.append(item)
						Ok(CtfeOptionNone):
							void
						Err(error):
							failure = Some(error)
							break
				Err(error):
					failure = Some(error)
					break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(mapped)


private pure func ctfe_eval_list_flat_map_values(
	context: CtfeContext,
	env: CtfeEnv,
	values: List[CtfeValue],
	callback: CtfeValue,
) -> Result[List[CtfeValue], CtfeEvalError]:
	var mapped: List[CtfeValue] = []
	var failure: Option[CtfeEvalError] = None

	for value in values:
		if failure.is_none():
			match ctfe_eval_callback_call(context, env, callback, [value]):
				Ok(list_value):
					match ctfe_eval_expect_list(list_value):
						Ok(items):
							mapped = mapped.concat(items)
						Err(error):
							failure = Some(error)
							break
				Err(error):
					failure = Some(error)
					break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(mapped)


private pure func ctfe_eval_list_map_indexed_values(
	context: CtfeContext,
	env: CtfeEnv,
	values: List[CtfeValue],
	callback: CtfeValue,
	span: CompilerSourceSpan,
) -> Result[List[CtfeValue], CtfeEvalError]:
	var mapped: List[CtfeValue] = []
	var failure: Option[CtfeEvalError] = None
	var index: Int = 0

	for value in values:
		if failure.is_none():
			index_value = ctfe_int(span, index)

			match (
				ctfe_eval_callback_call(
					context,
					env,
					callback,
					[index_value, value],
				)
			):
				Ok(item):
					mapped = mapped.append(item)
				Err(error):
					failure = Some(error)
					break

		index += 1

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(mapped)


private pure func ctfe_eval_list_fold_left_value(
	context: CtfeContext,
	env: CtfeEnv,
	values: List[CtfeValue],
	initial: CtfeValue,
	callback: CtfeValue,
) -> Result[CtfeValue, CtfeEvalError]:
	var acc: CtfeValue = initial
	var failure: Option[CtfeEvalError] = None

	for value in values:
		if failure.is_none():
			match (
				ctfe_eval_callback_call(
					context,
					env,
					callback,
					[acc, value],
				)
			):
				Ok(next):
					acc = next
				Err(error):
					failure = Some(error)
					break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(acc)


private pure func ctfe_eval_list_fold_right_value(
	context: CtfeContext,
	env: CtfeEnv,
	values: List[CtfeValue],
	initial: CtfeValue,
	callback: CtfeValue,
) -> Result[CtfeValue, CtfeEvalError]:
	var acc: CtfeValue = initial
	var failure: Option[CtfeEvalError] = None
	var index: Int = values.length() - 1

	while index >= 0:
		if failure.is_none():
			match values.get(index):
				Some(value):
					match (
						ctfe_eval_callback_call(
							context,
							env,
							callback,
							[value, acc],
						)
					):
						Ok(next):
							acc = next
						Err(error):
							failure = Some(error)
							break
				None:
					void

		index -= 1

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(acc)


private pure func ctfe_eval_list_all_value(
	context: CtfeContext,
	env: CtfeEnv,
	values: List[CtfeValue],
	callback: CtfeValue,
) -> Result[Bool, CtfeEvalError]:
	var result: Bool = True
	var failure: Option[CtfeEvalError] = None

	for value in values:
		if failure.is_none() and result:
			match ctfe_eval_callback_call(context, env, callback, [value]):
				Ok(test_value):
					match ctfe_eval_bool_result(ctfe_expect_bool(test_value)):
						Ok(keep):
							if not keep:
								result = False
								break
						Err(error):
							failure = Some(error)
							break
				Err(error):
					failure = Some(error)
					break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(result)


private pure func ctfe_eval_list_any_value(
	context: CtfeContext,
	env: CtfeEnv,
	values: List[CtfeValue],
	callback: CtfeValue,
) -> Result[Bool, CtfeEvalError]:
	var result: Bool = False
	var failure: Option[CtfeEvalError] = None

	for value in values:
		if failure.is_none() and not result:
			match ctfe_eval_callback_call(context, env, callback, [value]):
				Ok(test_value):
					match ctfe_eval_bool_result(ctfe_expect_bool(test_value)):
						Ok(keep):
							if keep:
								result = True
								break
						Err(error):
							failure = Some(error)
							break
				Err(error):
					failure = Some(error)
					break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(result)


private pure func ctfe_eval_imported_list_intrinsic(
	context: CtfeContext,
	env: CtfeEnv,
	expr: CtfeIrExpr,
	op: CtfeListIntrinsic,
	arg_values: List[CtfeValue],
) -> Result[CtfeValue, CtfeEvalError]:
	match (op, arg_values):
		(CtfeListAll, [receiver, callback]):
			values ?= ctfe_eval_expect_list(receiver)
			all ?= ctfe_eval_list_all_value(context, env, values, callback)
			Ok(ctfe_bool(ctfe_ir_eval_span(expr), all))
		(CtfeListMake, [capacity]):
			_capacity ?= ctfe_eval_int_result(ctfe_expect_int(capacity))
			Ok(ctfe_value(ctfe_ir_eval_type(expr), CtfeListValue([]), ctfe_ir_eval_span(expr)))
		(CtfeListAppend, [receiver, elem]):
			values ?= ctfe_eval_expect_list(receiver)
			Ok(
				ctfe_value(
					ctfe_ir_eval_type(expr),
					CtfeListValue(values.append(elem)),
					ctfe_ir_eval_span(expr),
				),
			)
		(CtfeListAny, [receiver, callback]):
			values ?= ctfe_eval_expect_list(receiver)
			any ?= ctfe_eval_list_any_value(context, env, values, callback)
			Ok(ctfe_bool(ctfe_ir_eval_span(expr), any))
		(CtfeListConcat, [left, right]):
			left_values ?= ctfe_eval_expect_list(left)
			right_values ?= ctfe_eval_expect_list(right)
			Ok(
				ctfe_value(
					ctfe_ir_eval_type(expr),
					CtfeListValue(left_values.concat(right_values)),
					ctfe_ir_eval_span(expr),
				),
			)
		(CtfeListContains, [receiver, elem]):
			values ?= ctfe_eval_expect_list(receiver)
			Ok(ctfe_bool(ctfe_ir_eval_span(expr), ctfe_eval_list_contains(values, elem)))
		(CtfeListFilter, [receiver, callback]):
			values ?= ctfe_eval_expect_list(receiver)
			filtered ?= ctfe_eval_list_filter_values(context, env, values, callback)
			Ok(
				ctfe_value(
					ctfe_ir_eval_type(expr),
					CtfeListValue(filtered),
					ctfe_ir_eval_span(expr),
				),
			)
		(CtfeListFilterMap, [receiver, callback]):
			values ?= ctfe_eval_expect_list(receiver)
			mapped ?= ctfe_eval_list_filter_map_values(context, env, values, callback)
			Ok(ctfe_value(ctfe_ir_eval_type(expr), CtfeListValue(mapped), ctfe_ir_eval_span(expr)))
		(CtfeListFlatMap, [receiver, callback]):
			values ?= ctfe_eval_expect_list(receiver)
			mapped ?= ctfe_eval_list_flat_map_values(context, env, values, callback)
			Ok(ctfe_value(ctfe_ir_eval_type(expr), CtfeListValue(mapped), ctfe_ir_eval_span(expr)))
		(CtfeListFoldLeft, [receiver, initial, callback]):
			values ?= ctfe_eval_expect_list(receiver)
			result ?= ctfe_eval_list_fold_left_value(context, env, values, initial, callback)
			Ok(ctfe_eval_return_value(expr, result))
		(CtfeListFoldRight, [receiver, initial, callback]):
			values ?= ctfe_eval_expect_list(receiver)
			result ?= ctfe_eval_list_fold_right_value(context, env, values, initial, callback)
			Ok(ctfe_eval_return_value(expr, result))
		(CtfeListGet, [receiver, index_value]):
			values ?= ctfe_eval_expect_list(receiver)
			index ?= ctfe_eval_int_result(ctfe_expect_int(index_value))
			Ok(ctfe_eval_option_value(expr, values.get(index)))
		(CtfeListGetOr, [receiver, index_value, default_value]):
			values ?= ctfe_eval_expect_list(receiver)
			index ?= ctfe_eval_int_result(ctfe_expect_int(index_value))
			Ok(ctfe_eval_return_value(expr, values.get_or(index, default_value)))
		(CtfeListJoin, [receiver, separator_value]):
			values ?= ctfe_eval_expect_list(receiver)
			separator ?= ctfe_eval_string_result(ctfe_expect_string(separator_value))
			text: String ?= ctfe_eval_list_join_values(values, separator)
			Ok(ctfe_string(ctfe_ir_eval_span(expr), text))
		(CtfeListLength, [receiver]):
			values ?= ctfe_eval_expect_list(receiver)
			Ok(ctfe_int(ctfe_ir_eval_span(expr), values.length()))
		(CtfeListMap, [receiver, callback]):
			values ?= ctfe_eval_expect_list(receiver)
			mapped ?= ctfe_eval_list_map_values(context, env, values, callback)
			Ok(ctfe_value(ctfe_ir_eval_type(expr), CtfeListValue(mapped), ctfe_ir_eval_span(expr)))
		(CtfeListMapIndexed, [receiver, callback]):
			values ?= ctfe_eval_expect_list(receiver)
			mapped ?= ctfe_eval_list_map_indexed_values(
				context,
				env,
				values,
				callback,
				ctfe_ir_eval_span(expr),
			)
			Ok(ctfe_value(ctfe_ir_eval_type(expr), CtfeListValue(mapped), ctfe_ir_eval_span(expr)))
		(CtfeListSet, [receiver, index_value, elem]):
			values ?= ctfe_eval_expect_list(receiver)
			index ?= ctfe_eval_int_result(ctfe_expect_int(index_value))
			Ok(
				ctfe_value(
					ctfe_ir_eval_type(expr),
					CtfeListValue(values.set(index, elem)),
					ctfe_ir_eval_span(expr),
				),
			)
		_:
			Err(CtfeEvalUnsupported("std/list compile-time intrinsic call"))


private pure func ctfe_eval_imported_dict_intrinsic(
	expr: CtfeIrExpr,
	op: CtfeDictIntrinsic,
	arg_values: List[CtfeValue],
) -> Result[CtfeValue, CtfeEvalError]:
	match (op, arg_values):
		(CtfeDictContains, [receiver, key]):
			entries ?= ctfe_eval_expect_dict(receiver)
			Ok(ctfe_bool(ctfe_ir_eval_span(expr), ctfe_eval_dict_get(entries, key).is_some()))
		(CtfeDictFromList, [pairs]):
			values ?= ctfe_eval_expect_list(pairs)
			entries ?= ctfe_eval_dict_from_list(values)
			Ok(ctfe_value(ctfe_ir_eval_type(expr), CtfeDictValue(entries), ctfe_ir_eval_span(expr)))
		(CtfeDictGet, [receiver, key]):
			entries ?= ctfe_eval_expect_dict(receiver)
			Ok(ctfe_eval_option_value(expr, ctfe_eval_dict_get(entries, key)))
		(CtfeDictGetOr, [receiver, key, default_value]):
			entries ?= ctfe_eval_expect_dict(receiver)
			Ok(ctfe_eval_return_value(expr, ctfe_eval_dict_get(entries, key).get_or(default_value)))
		(CtfeDictIsEmpty, [receiver]):
			entries ?= ctfe_eval_expect_dict(receiver)
			Ok(ctfe_bool(ctfe_ir_eval_span(expr), entries.length() == 0))
		(CtfeDictLength, [receiver]):
			entries ?= ctfe_eval_expect_dict(receiver)
			Ok(ctfe_int(ctfe_ir_eval_span(expr), entries.length()))
		(CtfeDictSet, [receiver, key, value]):
			entries ?= ctfe_eval_expect_dict(receiver)
			Ok(
				ctfe_value(
					ctfe_ir_eval_type(expr),
					CtfeDictValue(ctfe_eval_dict_set(entries, key, value)),
					ctfe_ir_eval_span(expr),
				),
			)
		_:
			Err(CtfeEvalUnsupported("std/dict compile-time intrinsic call"))


private pure func ctfe_eval_imported_option_intrinsic(
	context: CtfeContext,
	env: CtfeEnv,
	expr: CtfeIrExpr,
	op: CtfeOptionIntrinsic,
	arg_values: List[CtfeValue],
) -> Result[CtfeValue, CtfeEvalError]:
	match (op, arg_values):
		(CtfeOptionAndThen, [receiver, callback]):
			state ?= ctfe_eval_option_state_result(ctfe_option_state(receiver))

			match state:
				CtfeOptionSome(value):
					result ?= ctfe_eval_callback_call(context, env, callback, [value])
					Ok(ctfe_eval_return_value(expr, result))
				CtfeOptionNone:
					Ok(ctfe_option_none_value(ctfe_ir_eval_type(expr), ctfe_ir_eval_span(expr)))
		(CtfeOptionFilter, [receiver, callback]):
			state ?= ctfe_eval_option_state_result(ctfe_option_state(receiver))

			match state:
				CtfeOptionSome(value):
					keep_value ?= ctfe_eval_callback_call(context, env, callback, [value])
					keep ?= ctfe_eval_bool_result(ctfe_expect_bool(keep_value))

					if keep:
						Ok(ctfe_eval_return_value(expr, receiver))
					else:
						Ok(ctfe_option_none_value(ctfe_ir_eval_type(expr), ctfe_ir_eval_span(expr)))
				CtfeOptionNone:
					Ok(ctfe_eval_return_value(expr, receiver))
		(CtfeOptionGetOr, [receiver, default_value]):
			state ?= ctfe_eval_option_state_result(ctfe_option_state(receiver))

			match state:
				CtfeOptionSome(value):
					Ok(ctfe_eval_return_value(expr, value))
				CtfeOptionNone:
					Ok(ctfe_eval_return_value(expr, default_value))
		(CtfeOptionGetOrElse, [receiver, default_fn]):
			state ?= ctfe_eval_option_state_result(ctfe_option_state(receiver))

			match state:
				CtfeOptionSome(value):
					Ok(ctfe_eval_return_value(expr, value))
				CtfeOptionNone:
					result ?= ctfe_eval_callback_call(context, env, default_fn, [])
					Ok(ctfe_eval_return_value(expr, result))
		(CtfeOptionIsNone, [receiver]):
			state ?= ctfe_eval_option_state_result(ctfe_option_state(receiver))

			match state:
				CtfeOptionSome(_):
					Ok(ctfe_bool(ctfe_ir_eval_span(expr), False))
				CtfeOptionNone:
					Ok(ctfe_bool(ctfe_ir_eval_span(expr), True))
		(CtfeOptionIsSome, [receiver]):
			state ?= ctfe_eval_option_state_result(ctfe_option_state(receiver))

			match state:
				CtfeOptionSome(_):
					Ok(ctfe_bool(ctfe_ir_eval_span(expr), True))
				CtfeOptionNone:
					Ok(ctfe_bool(ctfe_ir_eval_span(expr), False))
		(CtfeOptionMap, [receiver, callback]):
			state ?= ctfe_eval_option_state_result(ctfe_option_state(receiver))

			match state:
				CtfeOptionSome(value):
					mapped ?= ctfe_eval_callback_call(context, env, callback, [value])
					Ok(
						ctfe_option_some_value(
							ctfe_ir_eval_type(expr),
							ctfe_ir_eval_span(expr),
							mapped,
						),
					)
				CtfeOptionNone:
					Ok(ctfe_option_none_value(ctfe_ir_eval_type(expr), ctfe_ir_eval_span(expr)))
		(CtfeOptionToResult, [receiver, error_value]):
			state ?= ctfe_eval_option_state_result(ctfe_option_state(receiver))

			match state:
				CtfeOptionSome(value):
					Ok(
						ctfe_result_ok_value(
							ctfe_ir_eval_type(expr),
							ctfe_ir_eval_span(expr),
							value,
						),
					)
				CtfeOptionNone:
					Ok(
						ctfe_result_err_value(
							ctfe_ir_eval_type(expr),
							ctfe_ir_eval_span(expr),
							error_value,
						),
					)
		_:
			Err(CtfeEvalUnsupported("std/option compile-time intrinsic call"))


private pure func ctfe_eval_imported_result_intrinsic(
	context: CtfeContext,
	env: CtfeEnv,
	expr: CtfeIrExpr,
	op: CtfeResultIntrinsic,
	arg_values: List[CtfeValue],
) -> Result[CtfeValue, CtfeEvalError]:
	match (op, arg_values):
		(CtfeResultAndThen, [receiver, callback]):
			state ?= ctfe_eval_result_state_result(ctfe_result_state(receiver))

			match state:
				CtfeResultOk(value):
					result ?= ctfe_eval_callback_call(context, env, callback, [value])
					Ok(ctfe_eval_return_value(expr, result))
				CtfeResultErr(error_value):
					Ok(
						ctfe_result_err_value(
							ctfe_ir_eval_type(expr),
							ctfe_ir_eval_span(expr),
							error_value,
						),
					)
		(CtfeResultFromOption, [receiver, error_value]):
			state ?= ctfe_eval_option_state_result(ctfe_option_state(receiver))

			match state:
				CtfeOptionSome(value):
					Ok(
						ctfe_result_ok_value(
							ctfe_ir_eval_type(expr),
							ctfe_ir_eval_span(expr),
							value,
						),
					)
				CtfeOptionNone:
					Ok(
						ctfe_result_err_value(
							ctfe_ir_eval_type(expr),
							ctfe_ir_eval_span(expr),
							error_value,
						),
					)
		(CtfeResultGetOr, [receiver, default_value]):
			state ?= ctfe_eval_result_state_result(ctfe_result_state(receiver))

			match state:
				CtfeResultOk(value):
					Ok(ctfe_eval_return_value(expr, value))
				CtfeResultErr(_):
					Ok(ctfe_eval_return_value(expr, default_value))
		(CtfeResultGetOrElse, [receiver, default_fn]):
			state ?= ctfe_eval_result_state_result(ctfe_result_state(receiver))

			match state:
				CtfeResultOk(value):
					Ok(ctfe_eval_return_value(expr, value))
				CtfeResultErr(error_value):
					result ?= ctfe_eval_callback_call(context, env, default_fn, [error_value])
					Ok(ctfe_eval_return_value(expr, result))
		(CtfeResultIsErr, [receiver]):
			state ?= ctfe_eval_result_state_result(ctfe_result_state(receiver))

			match state:
				CtfeResultOk(_):
					Ok(ctfe_bool(ctfe_ir_eval_span(expr), False))
				CtfeResultErr(_):
					Ok(ctfe_bool(ctfe_ir_eval_span(expr), True))
		(CtfeResultIsOk, [receiver]):
			state ?= ctfe_eval_result_state_result(ctfe_result_state(receiver))

			match state:
				CtfeResultOk(_):
					Ok(ctfe_bool(ctfe_ir_eval_span(expr), True))
				CtfeResultErr(_):
					Ok(ctfe_bool(ctfe_ir_eval_span(expr), False))
		(CtfeResultMap, [receiver, callback]):
			state ?= ctfe_eval_result_state_result(ctfe_result_state(receiver))

			match state:
				CtfeResultOk(value):
					mapped ?= ctfe_eval_callback_call(context, env, callback, [value])
					Ok(
						ctfe_result_ok_value(
							ctfe_ir_eval_type(expr),
							ctfe_ir_eval_span(expr),
							mapped,
						),
					)
				CtfeResultErr(error_value):
					Ok(
						ctfe_result_err_value(
							ctfe_ir_eval_type(expr),
							ctfe_ir_eval_span(expr),
							error_value,
						),
					)
		(CtfeResultMapErr, [receiver, callback]):
			state ?= ctfe_eval_result_state_result(ctfe_result_state(receiver))

			match state:
				CtfeResultOk(value):
					Ok(
						ctfe_result_ok_value(
							ctfe_ir_eval_type(expr),
							ctfe_ir_eval_span(expr),
							value,
						),
					)
				CtfeResultErr(error_value):
					mapped ?= ctfe_eval_callback_call(context, env, callback, [error_value])
					Ok(
						ctfe_result_err_value(
							ctfe_ir_eval_type(expr),
							ctfe_ir_eval_span(expr),
							mapped,
						),
					)
		(CtfeResultToOption, [receiver]):
			state ?= ctfe_eval_result_state_result(ctfe_result_state(receiver))

			match state:
				CtfeResultOk(value):
					Ok(
						ctfe_option_some_value(
							ctfe_ir_eval_type(expr),
							ctfe_ir_eval_span(expr),
							value,
						),
					)
				CtfeResultErr(_):
					Ok(ctfe_option_none_value(ctfe_ir_eval_type(expr), ctfe_ir_eval_span(expr)))
		_:
			Err(CtfeEvalUnsupported("std/result compile-time intrinsic call"))


private pure func ctfe_eval_chars(values: List[CtfeValue]) -> Result[List[Char], CtfeEvalError]:
	var chars: List[Char] = []
	var failure: Option[CtfeEvalError] = None

	for value in values:
		match ctfe_eval_char_result(ctfe_expect_char(value)):
			Ok(char_value):
				chars = chars.append(char_value)
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(chars)


private pure func ctfe_eval_imported_string_intrinsic(
	expr: CtfeIrExpr,
	op: CtfeStringIntrinsic,
	arg_values: List[CtfeValue],
) -> Result[CtfeValue, CtfeEvalError]:
	match (op, arg_values):
		(CtfeStringChars, [receiver]):
			receiver_text ?= ctfe_eval_string_result(ctfe_expect_string(receiver))
			values = receiver_text
				.chars()
				.map(pure func(value): ctfe_char(ctfe_ir_eval_span(expr), value))
			Ok(ctfe_value(ctfe_ir_eval_type(expr), CtfeListValue(values), ctfe_ir_eval_span(expr)))
		(CtfeStringCount, [receiver, needle_value]):
			receiver_text ?= ctfe_eval_string_result(ctfe_expect_string(receiver))
			needle ?= ctfe_eval_string_result(ctfe_expect_string(needle_value))
			var occurrences: Int = 0
			var index: Int = 0

			if needle.length() > 0:
				while index + needle.length() <= receiver_text.length():
					if receiver_text.substring(index, needle.length()) == needle:
						occurrences += 1
						index += needle.length()
					else:
						index += 1

			Ok(ctfe_int(ctfe_ir_eval_span(expr), occurrences))
		(CtfeStringContains, [receiver, needle_value]):
			receiver_text ?= ctfe_eval_string_result(ctfe_expect_string(receiver))
			needle ?= ctfe_eval_string_result(ctfe_expect_string(needle_value))
			Ok(ctfe_bool(ctfe_ir_eval_span(expr), receiver_text.contains(needle)))
		(CtfeStringDropLeft, [receiver, count_value]):
			receiver_text ?= ctfe_eval_string_result(ctfe_expect_string(receiver))
			count ?= ctfe_eval_int_result(ctfe_expect_int(count_value))

			start = if count < 0:
				0
			else:
				count

			remaining = if start >= receiver_text.length():
				""
			else:
				receiver_text.substring(start, receiver_text.length() - start)

			Ok(ctfe_string(ctfe_ir_eval_span(expr), remaining))
		(CtfeStringTakeLeft, [receiver, count_value]):
			receiver_text ?= ctfe_eval_string_result(ctfe_expect_string(receiver))
			count ?= ctfe_eval_int_result(ctfe_expect_int(count_value))

			prefix_length = if count < 0:
				0
			else if count > receiver_text.length():
				receiver_text.length()
			else:
				count

			Ok(ctfe_string(ctfe_ir_eval_span(expr), receiver_text.substring(0, prefix_length)))
		(CtfeStringEndsWith, [receiver, suffix_value]):
			receiver_text ?= ctfe_eval_string_result(ctfe_expect_string(receiver))
			suffix ?= ctfe_eval_string_result(ctfe_expect_string(suffix_value))
			Ok(ctfe_bool(ctfe_ir_eval_span(expr), receiver_text.ends_with(suffix)))
		(CtfeStringFromChar, [char_value]):
			value ?= ctfe_eval_char_result(ctfe_expect_char(char_value))
			Ok(ctfe_string(ctfe_ir_eval_span(expr), StringOps.from_char(value)))
		(CtfeStringFromChars, [chars_value]):
			values ?= ctfe_eval_expect_list(chars_value)
			chars ?= ctfe_eval_chars(values)

			Ok(ctfe_string(ctfe_ir_eval_span(expr), StringOps.from_chars(chars)))
		(CtfeStringGet, [receiver, index_value]):
			receiver_text ?= ctfe_eval_string_result(ctfe_expect_string(receiver))
			index ?= ctfe_eval_int_result(ctfe_expect_int(index_value))
			Ok(ctfe_eval_char_option_value(expr, receiver_text.get(index)))
		(CtfeStringGetOr, [receiver, index_value, default_value]):
			receiver_text ?= ctfe_eval_string_result(ctfe_expect_string(receiver))
			index ?= ctfe_eval_int_result(ctfe_expect_int(index_value))
			default_char ?= ctfe_eval_char_result(ctfe_expect_char(default_value))
			Ok(ctfe_char(ctfe_ir_eval_span(expr), receiver_text.get_or(index, default_char)))
		(CtfeStringIndexOf, [receiver, needle_value]):
			receiver_text ?= ctfe_eval_string_result(ctfe_expect_string(receiver))
			needle ?= ctfe_eval_string_result(ctfe_expect_string(needle_value))
			Ok(ctfe_eval_int_option_value(expr, receiver_text.index_of(needle)))
		(CtfeStringLength, [receiver]):
			receiver_text ?= ctfe_eval_string_result(ctfe_expect_string(receiver))
			Ok(ctfe_int(ctfe_ir_eval_span(expr), receiver_text.length()))
		(CtfeStringLower, [receiver]):
			receiver_text ?= ctfe_eval_string_result(ctfe_expect_string(receiver))

			if receiver_text.is_ascii():
				Ok(ctfe_string(ctfe_ir_eval_span(expr), receiver_text.lower()))
			else:
				Err(
					CtfeEvalInvalid(
						"compile-time string case conversion currently supports ASCII input only",
					),
				)
		(CtfeStringRawIndexOf, [receiver, needle_value]):
			receiver_text ?= ctfe_eval_string_result(ctfe_expect_string(receiver))
			needle ?= ctfe_eval_string_result(ctfe_expect_string(needle_value))
			Ok(ctfe_int(ctfe_ir_eval_span(expr), receiver_text.raw_index_of(needle)))
		(CtfeStringRepeat, [receiver, count_value]):
			receiver_text ?= ctfe_eval_string_result(ctfe_expect_string(receiver))
			count ?= ctfe_eval_int_result(ctfe_expect_int(count_value))
			Ok(ctfe_string(ctfe_ir_eval_span(expr), StringOps.repeat(receiver_text, count)))
		(CtfeStringReplace, [receiver, old_value, new_value]):
			receiver_text ?= ctfe_eval_string_result(ctfe_expect_string(receiver))
			old ?= ctfe_eval_string_result(ctfe_expect_string(old_value))
			new_text ?= ctfe_eval_string_result(ctfe_expect_string(new_value))
			Ok(ctfe_string(ctfe_ir_eval_span(expr), receiver_text.replace(old, new_text)))
		(CtfeStringReverse, [receiver]):
			receiver_text ?= ctfe_eval_string_result(ctfe_expect_string(receiver))
			Ok(ctfe_string(ctfe_ir_eval_span(expr), receiver_text.reverse()))
		(CtfeStringSplit, [receiver, delimiter_value]):
			receiver_text ?= ctfe_eval_string_result(ctfe_expect_string(receiver))
			delimiter ?= ctfe_eval_string_result(ctfe_expect_string(delimiter_value))
			parts: List[String] = receiver_text.split(delimiter)
			var values: List[CtfeValue] = []

			for part in parts:
				values = values.append(ctfe_string(ctfe_ir_eval_span(expr), part))

			Ok(ctfe_value(ctfe_ir_eval_type(expr), CtfeListValue(values), ctfe_ir_eval_span(expr)))
		(CtfeStringStartsWith, [receiver, prefix_value]):
			receiver_text ?= ctfe_eval_string_result(ctfe_expect_string(receiver))
			prefix ?= ctfe_eval_string_result(ctfe_expect_string(prefix_value))
			Ok(ctfe_bool(ctfe_ir_eval_span(expr), receiver_text.starts_with(prefix)))
		(CtfeStringSubstring, [receiver, start_value, length_value]):
			receiver_text ?= ctfe_eval_string_result(ctfe_expect_string(receiver))
			start ?= ctfe_eval_int_result(ctfe_expect_int(start_value))
			length ?= ctfe_eval_int_result(ctfe_expect_int(length_value))
			Ok(ctfe_string(ctfe_ir_eval_span(expr), receiver_text.substring(start, length)))
		(CtfeStringTrim, [receiver]):
			receiver_text ?= ctfe_eval_string_result(ctfe_expect_string(receiver))
			Ok(ctfe_string(ctfe_ir_eval_span(expr), receiver_text.trim()))
		(CtfeStringTrimLeft, [receiver]):
			receiver_text ?= ctfe_eval_string_result(ctfe_expect_string(receiver))
			Ok(ctfe_string(ctfe_ir_eval_span(expr), receiver_text.trim_left()))
		(CtfeStringTrimRight, [receiver]):
			receiver_text ?= ctfe_eval_string_result(ctfe_expect_string(receiver))
			Ok(ctfe_string(ctfe_ir_eval_span(expr), receiver_text.trim_right()))
		(CtfeStringUpper, [receiver]):
			receiver_text ?= ctfe_eval_string_result(ctfe_expect_string(receiver))

			if receiver_text.is_ascii():
				Ok(ctfe_string(ctfe_ir_eval_span(expr), receiver_text.upper()))
			else:
				Err(
					CtfeEvalInvalid(
						"compile-time string case conversion currently supports ASCII input only",
					),
				)
		_:
			Err(CtfeEvalUnsupported("std/string compile-time intrinsic call"))


private pure func ctfe_value_length(value: CtfeValue) -> Option[Int]:
	match value.desc:
		CtfeVectorValue(values):
			Some(values.length())
		CtfeListValue(values):
			Some(values.length())
		CtfeStringValue(text):
			Some(text.length())
		CtfeDictValue(entries):
			Some(entries.length())
		_:
			None


private pure func ctfe_eval_imported_matrix_intrinsic(
	expr: CtfeIrExpr,
	op: CtfeMatrixIntrinsic,
	arg_values: List[CtfeValue],
) -> Result[CtfeValue, CtfeEvalError]:
	match (op, arg_values):
		(CtfeMatrixRowCount, [matrix_value]):
			match ctfe_value_length(matrix_value):
				Some(length):
					Ok(ctfe_int(ctfe_ir_eval_span(expr), length))
				None:
					Err(CtfeEvalUnsupported("matrix row_count on non-tensor value"))
		(CtfeMatrixColumnCount, [matrix_value]):
			match matrix_value.desc:
				CtfeVectorValue(rows):
					match rows.get(0):
						Some(row):
							match ctfe_value_length(row):
								Some(length):
									Ok(ctfe_int(ctfe_ir_eval_span(expr), length))
								None:
									Err(
										CtfeEvalUnsupported(
											"matrix column_count on malformed tensor value",
										),
									)
						None:
							Ok(ctfe_int(ctfe_ir_eval_span(expr), 0))
				_:
					Err(CtfeEvalUnsupported("matrix column_count on non-tensor value"))
		_:
			Err(CtfeEvalUnsupported("matrix shape intrinsic with invalid arguments"))


private pure func ctfe_eval_imported_intrinsic(
	context: CtfeContext,
	env: CtfeEnv,
	expr: CtfeIrExpr,
	intrinsic: CtfeImportedIntrinsic,
	arg_values: List[CtfeValue],
) -> Result[CtfeValue, CtfeEvalError]:
	match intrinsic:
		CtfeImportedBuiltinIntrinsic(op):
			ctfe_eval_builtin_intrinsic(expr, op, arg_values)
		CtfeImportedDictIntrinsic(op):
			ctfe_eval_imported_dict_intrinsic(expr, op, arg_values)
		CtfeImportedListIntrinsic(op):
			ctfe_eval_imported_list_intrinsic(context, env, expr, op, arg_values)
		CtfeImportedMatrixIntrinsic(op):
			ctfe_eval_imported_matrix_intrinsic(expr, op, arg_values)
		CtfeImportedOptionIntrinsic(op):
			ctfe_eval_imported_option_intrinsic(context, env, expr, op, arg_values)
		CtfeImportedResultIntrinsic(op):
			ctfe_eval_imported_result_intrinsic(context, env, expr, op, arg_values)
		CtfeImportedStringIntrinsic(op):
			ctfe_eval_imported_string_intrinsic(expr, op, arg_values)


private pure func ctfe_eval_sized_float_conversion(
	expr: CtfeIrExpr,
	intrinsic: CtfeBuiltinIntrinsic,
	arg_values: List[CtfeValue],
) -> Result[CtfeValue, CtfeEvalError]:
	match arg_values:
		[arg]:
			numeric_value: Option[Float] = match arg.desc:
				CtfeFloatValue(raw):
					Some(raw)
				CtfeIntValue(raw):
					Some(to_float(raw))
				_:
					None

			match numeric_value:
				Some(raw):
					rounded: Float = match intrinsic:
						CtfeToFloat16Intrinsic:
							to_float(to_float16(raw))
						CtfeToFloat32Intrinsic:
							to_float(to_float32(raw))
						_:
							raw

					Ok(
						ctfe_value(
							ctfe_ir_eval_type(expr),
							CtfeFloatValue(rounded),
							ctfe_ir_eval_span(expr),
						),
					)
				None:
					Err(CtfeEvalUnsupported("sized float conversion from non-numeric value"))
		_:
			Err(CtfeEvalUnsupported("sized float conversion with invalid argument count"))


private pure func ctfe_dims_after_first(dims: List[SemanticType]) -> List[SemanticType]:
	var result: List[SemanticType] = []
	var index: Int = 1

	while index < dims.length():
		match dims.get(index):
			Some(dim):
				result = result.append(dim)
			None:
				void

		index += 1

	result


private pure func ctfe_tensor_child_type(typ: SemanticType) -> SemanticType:
	match array_type_parts(typ):
		Some((element_type, dims)):
			array_type(element_type, ctfe_dims_after_first(dims))
		None:
			typ


private pure func ctfe_eval_tensor_fill_at(
	expr: CtfeIrExpr,
	fill_value: CtfeValue,
	dimensions: List[CtfeValue],
	dimension_index: Int,
	result_type: SemanticType,
) -> Result[CtfeValue, CtfeEvalError]:
	if dimension_index >= dimensions.length():
		Ok({ fill_value |
				typ = result_type,
				span = ctfe_ir_eval_span(expr)
			})
	else:
		dimension_value ?= match dimensions.get(dimension_index):
			Some(value):
				Ok(value)
			None:
				Err(CtfeEvalUnsupported("tensor constructor dimension is missing"))

		size ?= ctfe_eval_int_result(ctfe_expect_int(dimension_value))

		if size < 0:
			Err(CtfeEvalInvalid("compile-time tensor dimensions cannot be negative"))
		else:
			child ?= ctfe_eval_tensor_fill_at(
				expr,
				fill_value,
				dimensions,
				dimension_index + 1,
				ctfe_tensor_child_type(result_type),
			)
			var values: List[CtfeValue] = []
			var index: Int = 0

			while index < size:
				values = values.append(child)
				index += 1

			Ok(ctfe_value(result_type, CtfeVectorValue(values), ctfe_ir_eval_span(expr)))


private pure func ctfe_values_after_first(values: List[CtfeValue]) -> List[CtfeValue]:
	var result: List[CtfeValue] = []
	var index: Int = 1

	while index < values.length():
		match values.get(index):
			Some(value):
				result = result.append(value)
			None:
				void

		index += 1

	result


private pure func ctfe_eval_tensor_fill(
	expr: CtfeIrExpr,
	rank: Int,
	arg_values: List[CtfeValue],
) -> Result[CtfeValue, CtfeEvalError]:
	if arg_values.length() != rank + 1:
		Err(CtfeEvalUnsupported("tensor constructor with invalid argument count"))
	else:
		match arg_values.get(0):
			Some(fill_value):
				ctfe_eval_tensor_fill_at(
					expr,
					fill_value,
					ctfe_values_after_first(arg_values),
					0,
					ctfe_ir_eval_type(expr),
				)
			None:
				Err(CtfeEvalUnsupported("tensor constructor without a fill value"))


private pure func ctfe_eval_builtin_intrinsic(
	expr: CtfeIrExpr,
	intrinsic: CtfeBuiltinIntrinsic,
	arg_values: List[CtfeValue],
) -> Result[CtfeValue, CtfeEvalError]:
	match intrinsic:
		CtfeToFloat16Intrinsic:
			ctfe_eval_sized_float_conversion(expr, intrinsic, arg_values)
		CtfeToFloat32Intrinsic:
			ctfe_eval_sized_float_conversion(expr, intrinsic, arg_values)
		CtfeFromCharIntrinsic:
			match arg_values:
				[char_value]:
					value ?= ctfe_eval_char_result(ctfe_expect_char(char_value))
					Ok(ctfe_string(ctfe_ir_eval_span(expr), StringOps.from_char(value)))
				_:
					Err(CtfeEvalUnsupported("from_char with invalid argument count"))
		CtfeFromCharsIntrinsic:
			match arg_values:
				[chars_value]:
					values ?= ctfe_eval_expect_list(chars_value)
					chars ?= ctfe_eval_chars(values)
					Ok(ctfe_string(ctfe_ir_eval_span(expr), StringOps.from_chars(chars)))
				_:
					Err(CtfeEvalUnsupported("from_chars with invalid argument count"))
		CtfeLengthIntrinsic:
			match arg_values:
				[receiver]:
					match ctfe_value_length(receiver):
						Some(value):
							Ok(ctfe_int(ctfe_ir_eval_span(expr), value))
						None:
							Err(CtfeEvalUnsupported("length on unsupported compile-time value"))
				_:
					Err(CtfeEvalUnsupported("length with invalid argument count"))
		CtfeTensorFillIntrinsic(rank):
			ctfe_eval_tensor_fill(expr, rank, arg_values)
		CtfeToStringIntrinsic:
			match arg_values:
				[value]:
					text ?= ctfe_eval_string_result(ctfe_string_text_of_value(value))
					Ok(ctfe_string(ctfe_ir_eval_span(expr), text))
				_:
					Err(CtfeEvalUnsupported("to_string with invalid argument count"))


private pure func ctfe_is_checked_get_intrinsic(name: String) -> Bool:
	match name:
		"checked_get":
			True
		"matrix_checked_get":
			True
		"tensor3_checked_get":
			True
		"tensor4_checked_get":
			True
		"tensor5_checked_get":
			True
		"tensor_peel":
			True
		_:
			False


private pure func ctfe_eval_vector_indices(
	expr: CtfeIrExpr,
	value: CtfeValue,
	arg_values: List[CtfeValue],
	arg_index: Int,
) -> Result[CtfeValue, CtfeEvalError]:
	if arg_index >= arg_values.length():
		Ok(ctfe_eval_return_value(expr, value))
	else:
		index_value ?= match arg_values.get(arg_index):
			Some(arg):
				ctfe_eval_int_result(ctfe_expect_int(arg))
			None:
				Err(CtfeEvalUnsupported("checked tensor read with missing index"))

		match value.desc:
			CtfeVectorValue(values):
				normalized_index = if index_value < 0:
					values.length() + index_value
				else:
					index_value

				match values.get(normalized_index):
					Some(selected):
						ctfe_eval_vector_indices(expr, selected, arg_values, arg_index + 1)
					None:
						Err(CtfeEvalInvalid("compile-time tensor index is out of bounds"))
			_:
				Err(CtfeEvalUnsupported("checked tensor read on a non-tensor value"))


private pure func ctfe_eval_intrinsic_call(
	expr: CtfeIrExpr,
	name: String,
	arg_values: List[CtfeValue],
) -> Result[CtfeValue, CtfeEvalError]:
	if ctfe_is_checked_get_intrinsic(name):
		match arg_values.get(0):
			Some(receiver):
				ctfe_eval_vector_indices(expr, receiver, arg_values, 1)
			None:
				Err(CtfeEvalUnsupported("checked tensor read without a receiver"))
	else if name == "length" or name == "vector_length":
		match arg_values:
			[receiver]:
				match ctfe_value_length(receiver):
					Some(value):
						Ok(ctfe_int(ctfe_ir_eval_span(expr), value))
					None:
						Err(CtfeEvalUnsupported("length on unsupported compile-time value"))
			_:
				Err(CtfeEvalUnsupported("length with invalid argument count"))
	else if name == "to_string":
		match arg_values:
			[value]:
				text ?= ctfe_eval_string_result(ctfe_string_text_of_value(value))
				Ok(ctfe_string(ctfe_ir_eval_span(expr), text))
			_:
				Err(CtfeEvalUnsupported("to_string with invalid argument count"))
	else:
		Err(CtfeEvalUnsupported("intrinsic function call '" + name + "'"))


private pure func ctfe_eval_call(
	context: CtfeContext,
	env: CtfeEnv,
	expr: CtfeIrExpr,
	call: CtfeIrCall,
) -> Result[CtfeValue, CtfeEvalError]:
	match call.kind:
		CtfeIrUnresolvedCall:
			Err(CtfeEvalUnsupported("unresolved function calls"))
		CtfeIrClosureCall:
			callee_value ?= ctfe_eval_ir_in_context(context, env, call.callee)
			arg_values ?= ctfe_eval_exprs(context, env, call.args)
			ctfe_eval_callback_call(context, env, callee_value, arg_values)
		CtfeIrImpureCall:
			Err(CtfeEvalUnsupported("impure function calls"))
		CtfeIrIntrinsicCall(name):
			arg_values ?= ctfe_eval_exprs(context, env, call.args)
			ctfe_eval_intrinsic_call(expr, name, arg_values)
		CtfeIrUnsupportedCall(form):
			Err(CtfeEvalUnsupported(form))
		CtfeIrBuiltinCall(_, intrinsic):
			arg_values ?= ctfe_eval_exprs(context, env, call.args)
			ctfe_eval_builtin_intrinsic(expr, intrinsic, arg_values)
		CtfeIrLocalCall(direct):
			if not direct.is_pure:
				Err(CtfeEvalUnsupported("impure function calls"))
			else:
				arg_values ?= ctfe_eval_exprs(context, env, call.args)
				ctfe_eval_function_call(
					context,
					env,
					direct.callable_id,
					direct.source_name,
					arg_values,
				)
		CtfeIrImportedCall(direct, module_path):
			if not direct.is_pure:
				Err(CtfeEvalUnsupported("impure function calls"))
			else:
				arg_values ?= ctfe_eval_exprs(context, env, call.args)

				match ctfe_imported_intrinsic(module_path, direct.source_name):
					Some(intrinsic):
						ctfe_eval_imported_intrinsic(context, env, expr, intrinsic, arg_values)
					None:
						ctfe_eval_imported_function_call(
							context,
							env,
							module_path,
							direct.callable_id,
							direct.source_name,
							arg_values,
						)
		CtfeIrConstructorCall(direct, parent_type):
			if not direct.is_pure:
				Err(CtfeEvalUnsupported("impure function calls"))
			else:
				arg_values ?= ctfe_eval_exprs(context, env, call.args)
				ctfe_eval_constructor_call(
					expr,
					direct.callable_id,
					direct.source_name,
					parent_type,
					arg_values,
				)


private pure func ctfe_bind_pattern_values(
	env: CtfeEnv,
	bindings: List[(String, CtfeValue)],
) -> CtfeEnv:
	var next_env = env

	for (name, value) in bindings:
		next_env = ctfe_bind_local_value(next_env, name, value)

	next_env


private pure func ctfe_eval_match(
	context: CtfeContext,
	env: CtfeEnv,
	scrutinee: CtfeIrExpr,
	cases: List[CtfeIrMatchCase],
) -> Result[CtfeValue, CtfeEvalError]:
	scrutinee_value ?= ctfe_eval_ir_in_context(context, env, scrutinee)
	var result: Option[CtfeValue] = None
	var failure: Option[CtfeEvalError] = None

	for case in cases:
		if result.is_some():
			break

		match ctfe_eval_bindings_result(ctfe_pattern_bind(context, case.pattern, scrutinee_value)):
			Ok(Some(bindings)):
				case_env = ctfe_bind_pattern_values(env, bindings)

				match ctfe_eval_ir_in_context(context, case_env, case.body):
					Ok(value):
						result = Some(value)
					Err(error):
						failure = Some(error)
						break
			Ok(None):
				void
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			match result:
				Some(value):
					Ok(value)
				None:
					Err(CtfeEvalInvalid("compile-time match expression was not exhaustive"))


private pure func ctfe_project_loop_body_result(
	result: CtfeLoopBodyResult,
	base_env: CtfeEnv,
) -> CtfeLoopBodyResult:
	match result:
		CtfeLoopBodyValue(env, value):
			CtfeLoopBodyValue(
				ctfe_project_existing_bindings(env, base_env),
				value,
			)
		CtfeLoopBodyBreak(env):
			CtfeLoopBodyBreak(ctfe_project_existing_bindings(env, base_env))
		CtfeLoopBodyContinue(env):
			CtfeLoopBodyContinue(ctfe_project_existing_bindings(env, base_env))


private pure func ctfe_eval_loop_match(
	context: CtfeContext,
	env: CtfeEnv,
	scrutinee: CtfeIrExpr,
	cases: List[CtfeIrMatchCase],
) -> Result[CtfeLoopBodyResult, CtfeEvalError]:
	scrutinee_value ?= ctfe_eval_ir_in_context(context, env, scrutinee)
	var result: Option[CtfeLoopBodyResult] = None
	var failure: Option[CtfeEvalError] = None

	for case in cases:
		if result.is_some():
			break

		match ctfe_eval_bindings_result(ctfe_pattern_bind(context, case.pattern, scrutinee_value)):
			Ok(Some(bindings)):
				case_env = ctfe_bind_pattern_values(env, bindings)

				match ctfe_eval_loop_body(context, case_env, case.body):
					Ok(loop_result):
						result = Some(ctfe_project_loop_body_result(loop_result, env))
						break
					Err(error):
						failure = Some(error)
						break
			Ok(None):
				void
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			match result:
				Some(loop_result):
					Ok(loop_result)
				None:
					Err(CtfeEvalInvalid("compile-time match expression was not exhaustive"))


private pure func ctfe_eval_loop_block(
	context: CtfeContext,
	env: CtfeEnv,
	block_expr: CtfeIrExpr,
	block: CtfeIrBlock,
) -> Result[CtfeLoopBodyResult, CtfeEvalError]:
	var block_env = env
	var failure: Option[CtfeEvalError] = None
	var control: Option[CtfeLoopBodyResult] = None

	for item in block.items:
		if control.is_some():
			break

		match item:
			CtfeIrDiscardItem(expr):
				match ctfe_eval_loop_body(context, block_env, expr):
					Ok(CtfeLoopBodyValue(next_env, _)):
						block_env = next_env
					Ok(CtfeLoopBodyBreak(next_env)):
						control = Some(CtfeLoopBodyBreak(next_env))
						break
					Ok(CtfeLoopBodyContinue(next_env)):
						control = Some(CtfeLoopBodyContinue(next_env))
						break
					Err(error):
						failure = Some(error)
						break
			_:
				match ctfe_eval_block_item(context, block_env, block_expr, item):
					Ok(CtfeBlockItemContinue(next_env)):
						block_env = next_env
					Ok(CtfeBlockItemReturn(value)):
						control = Some(CtfeLoopBodyValue(block_env, value))
						break
					Err(error):
						failure = Some(error)
						break

	match failure:
		Some(error):
			Err(error)
		None:
			match control:
				Some(loop_result):
					Ok(ctfe_project_loop_body_result(loop_result, env))
				None:
					result ?= ctfe_eval_loop_body(context, block_env, block.result)
					Ok(ctfe_project_loop_body_result(result, env))


private pure func ctfe_eval_loop_body(
	context: CtfeContext,
	env: CtfeEnv,
	expr: CtfeIrExpr,
) -> Result[CtfeLoopBodyResult, CtfeEvalError]:
	match expr.desc:
		CtfeIrBreakExpr:
			Ok(CtfeLoopBodyBreak(env))
		CtfeIrContinueExpr:
			Ok(CtfeLoopBodyContinue(env))
		CtfeIrBlockExpr(block):
			ctfe_eval_loop_block(context, env, expr, block)
		CtfeIrIfExpr(condition, then_expr, else_expr):
			condition_value ?= ctfe_eval_ir_in_context(context, env, condition)
			condition_bool ?= ctfe_eval_bool_result(ctfe_expect_bool(condition_value))

			if condition_bool:
				ctfe_eval_loop_body(context, env, then_expr)
			else:
				match else_expr:
					Some(value):
						ctfe_eval_loop_body(context, env, value)
					None:
						Ok(CtfeLoopBodyValue(env, ctfe_eval_void_value(expr)))
		CtfeIrMatchExpr(scrutinee, cases):
			ctfe_eval_loop_match(context, env, scrutinee, cases)
		CtfeIrWhileExpr(condition, body):
			next_env ?= ctfe_eval_while_env(context, env, condition, body)
			Ok(CtfeLoopBodyValue(next_env, ctfe_eval_void_value(expr)))
		CtfeIrForExpr(name, iterable, body):
			next_env ?= ctfe_eval_for_env(context, env, name, iterable, body)
			Ok(CtfeLoopBodyValue(next_env, ctfe_eval_void_value(expr)))
		CtfeIrForTupleExpr(names, iterable, body):
			next_env ?= ctfe_eval_for_tuple_env(context, env, names, iterable, body)
			Ok(CtfeLoopBodyValue(next_env, ctfe_eval_void_value(expr)))
		_:
			value ?= ctfe_eval_ir_in_context(context, env, expr)
			Ok(CtfeLoopBodyValue(env, value))


private pure func ctfe_eval_while_env(
	context: CtfeContext,
	env: CtfeEnv,
	condition: CtfeIrExpr,
	body: CtfeIrExpr,
) -> Result[CtfeEnv, CtfeEvalError]:
	var loop_env = env
	var done: Bool = False
	var failure: Option[CtfeEvalError] = None

	while not done and failure.is_none():
		match ctfe_eval_ir_in_context(context, loop_env, condition):
			Ok(condition_value):
				match ctfe_eval_bool_result(ctfe_expect_bool(condition_value)):
					Ok(keep_going):
						if keep_going:
							match ctfe_eval_loop_body(context, loop_env, body):
								Ok(CtfeLoopBodyValue(next_env, _)):
									loop_env = next_env
								Ok(CtfeLoopBodyContinue(next_env)):
									loop_env = next_env
								Ok(CtfeLoopBodyBreak(next_env)):
									loop_env = next_env
									done = True
								Err(error):
									failure = Some(error)
						else:
							done = True
					Err(error):
						failure = Some(error)
			Err(error):
				failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(loop_env)


private pure func ctfe_eval_for_body_iteration(
	context: CtfeContext,
	outer_env: CtfeEnv,
	iteration_env: CtfeEnv,
	body: CtfeIrExpr,
) -> Result[CtfeLoopBodyResult, CtfeEvalError]:
	result ?= ctfe_eval_loop_body(context, iteration_env, body)
	Ok(ctfe_project_loop_body_result(result, outer_env))


private pure func ctfe_eval_for_range_env(
	context: CtfeContext,
	env: CtfeEnv,
	name: String,
	iterable: CtfeIrExpr,
	start_value: CtfeValue,
	end_value: CtfeValue,
	body: CtfeIrExpr,
) -> Result[CtfeEnv, CtfeEvalError]:
	start_int ?= ctfe_eval_int_result(ctfe_expect_int(start_value))
	end_int ?= ctfe_eval_int_result(ctfe_expect_int(end_value))

	step = if start_int <= end_int:
		1
	else:
		-1

	var current = start_int
	var loop_env = env
	var done: Bool = False
	var failure: Option[CtfeEvalError] = None

	while not done and failure.is_none():
		outside_range = if start_int <= end_int:
			current >= end_int
		else:
			current <= end_int

		if outside_range:
			done = True
		else:
			item = ctfe_int(ctfe_ir_eval_span(iterable), current)
			iteration_env = ctfe_bind_local_value(loop_env, name, item)

			match ctfe_eval_for_body_iteration(context, loop_env, iteration_env, body):
				Ok(CtfeLoopBodyValue(next_env, _)):
					loop_env = next_env
					current += step
				Ok(CtfeLoopBodyContinue(next_env)):
					loop_env = next_env
					current += step
				Ok(CtfeLoopBodyBreak(next_env)):
					loop_env = next_env
					done = True
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(loop_env)


private pure func ctfe_eval_for_list_env(
	context: CtfeContext,
	env: CtfeEnv,
	name: String,
	values: List[CtfeValue],
	body: CtfeIrExpr,
) -> Result[CtfeEnv, CtfeEvalError]:
	var loop_env = env
	var done: Bool = False
	var failure: Option[CtfeEvalError] = None

	for item in values:
		if done or failure.is_some():
			break

		iteration_env = ctfe_bind_local_value(loop_env, name, item)

		match ctfe_eval_for_body_iteration(context, loop_env, iteration_env, body):
			Ok(CtfeLoopBodyValue(next_env, _)):
				loop_env = next_env
			Ok(CtfeLoopBodyContinue(next_env)):
				loop_env = next_env
			Ok(CtfeLoopBodyBreak(next_env)):
				loop_env = next_env
				done = True
			Err(error):
				failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(loop_env)


private pure func ctfe_bind_loop_tuple_values(
	env: CtfeEnv,
	names: List[String],
	values: List[CtfeValue],
) -> Result[CtfeEnv, CtfeEvalError]:
	if names.length() != values.length():
		Err(CtfeEvalUnsupported("tuple for loops over non-tuples"))
	else:
		var next_env = env
		var index: Int = 0
		var failure: Option[CtfeEvalError] = None

		for name in names:
			match values.get(index):
				Some(value):
					next_env = ctfe_bind_local_value(next_env, name, value)
				None:
					failure = Some(CtfeEvalUnsupported("tuple for loops over non-tuples"))
					break

			index += 1

		match failure:
			Some(error):
				Err(error)
			None:
				Ok(next_env)


private pure func ctfe_eval_for_tuple_list_env(
	context: CtfeContext,
	env: CtfeEnv,
	names: List[String],
	values: List[CtfeValue],
	body: CtfeIrExpr,
) -> Result[CtfeEnv, CtfeEvalError]:
	var loop_env = env
	var done: Bool = False
	var failure: Option[CtfeEvalError] = None

	for item in values:
		if done or failure.is_some():
			break

		match item.desc:
			CtfeTupleValue(items):
				match ctfe_bind_loop_tuple_values(loop_env, names, items):
					Ok(iteration_env):
						match ctfe_eval_for_body_iteration(context, loop_env, iteration_env, body):
							Ok(CtfeLoopBodyValue(next_env, _)):
								loop_env = next_env
							Ok(CtfeLoopBodyContinue(next_env)):
								loop_env = next_env
							Ok(CtfeLoopBodyBreak(next_env)):
								loop_env = next_env
								done = True
							Err(error):
								failure = Some(error)
					Err(error):
						failure = Some(error)
						break
			_:
				failure = Some(CtfeEvalUnsupported("tuple for loops over non-tuples"))
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(loop_env)


private pure func ctfe_eval_for_env(
	context: CtfeContext,
	env: CtfeEnv,
	name: String,
	iterable: CtfeIrExpr,
	body: CtfeIrExpr,
) -> Result[CtfeEnv, CtfeEvalError]:
	iterable_value ?= ctfe_eval_ir_in_context(context, env, iterable)

	match iterable_value.desc:
		CtfeRangeValue(start_value, end_value):
			ctfe_eval_for_range_env(context, env, name, iterable, start_value, end_value, body)
		CtfeListValue(values):
			ctfe_eval_for_list_env(context, env, name, values, body)
		_:
			Err(CtfeEvalUnsupported("for loops over this iterable"))


private pure func ctfe_eval_for_tuple_env(
	context: CtfeContext,
	env: CtfeEnv,
	names: List[String],
	iterable: CtfeIrExpr,
	body: CtfeIrExpr,
) -> Result[CtfeEnv, CtfeEvalError]:
	iterable_value ?= ctfe_eval_ir_in_context(context, env, iterable)

	match iterable_value.desc:
		CtfeListValue(values):
			ctfe_eval_for_tuple_list_env(context, env, names, values, body)
		_:
			Err(CtfeEvalUnsupported("tuple for loops over this iterable"))


private pure func ctfe_eval_ir_in_context(
	context: CtfeContext,
	env: CtfeEnv,
	expr: CtfeIrExpr,
) -> Result[CtfeValue, CtfeEvalError]:
	match expr.desc:
		CtfeIrLiteralExpr(literal):
			Ok(ctfe_eval_literal(expr, literal))
		CtfeIrIdentExpr(identifier):
			ctfe_eval_identifier(env, expr, identifier)
		CtfeIrTransparentExpr(inner):
			ctfe_eval_ir_in_context(context, env, inner)
		CtfeIrUnaryExpr(op, inner):
			ctfe_eval_unary_expr(context, env, op, inner)
		CtfeIrBinaryExpr(op, left, right):
			ctfe_eval_binary_expr(context, env, op, left, right)
		CtfeIrLogicalExpr(op, left, right):
			ctfe_eval_logical(context, env, expr, op, left, right)
		CtfeIrIfExpr(condition, then_expr, else_expr):
			ctfe_eval_if(context, env, expr, condition, then_expr, else_expr)
		CtfeIrCallExpr(call):
			ctfe_eval_call(context, env, expr, call)
		CtfeIrTupleExpr(items):
			values ?= ctfe_eval_exprs(context, env, items)
			Ok(ctfe_value(ctfe_ir_eval_type(expr), CtfeTupleValue(values), ctfe_ir_eval_span(expr)))
		CtfeIrListExpr(items):
			values ?= ctfe_eval_exprs(context, env, items)
			Ok(ctfe_value(ctfe_ir_eval_type(expr), CtfeListValue(values), ctfe_ir_eval_span(expr)))
		CtfeIrVectorExpr(items):
			values ?= ctfe_eval_exprs(context, env, items)
			Ok(
				ctfe_value(
					ctfe_ir_eval_type(expr),
					CtfeVectorValue(values),
					ctfe_ir_eval_span(expr),
				),
			)
		CtfeIrRecordExpr(fields):
			values ?= ctfe_eval_fields(context, env, fields)
			Ok(
				ctfe_value(
					ctfe_ir_eval_type(expr),
					CtfeRecordValue(values),
					ctfe_ir_eval_span(expr),
				),
			)
		CtfeIrRecordUpdateExpr(base, updates):
			ctfe_eval_record_update(context, env, expr, base, updates)
		CtfeIrDictExpr(entries):
			values ?= ctfe_eval_dict_entries(context, env, entries)
			Ok(ctfe_value(ctfe_ir_eval_type(expr), CtfeDictValue(values), ctfe_ir_eval_span(expr)))
		CtfeIrLambdaExpr(lambda):
			Ok(ctfe_value(
				ctfe_ir_eval_type(expr),
				CtfeLambdaValue({
					source = lambda,
					env = env,
				}),
				ctfe_ir_eval_span(expr),
			))
		CtfeIrFieldAccessExpr(access):
			ctfe_eval_field_access(context, env, access)
		CtfeIrImportedGlobalExpr(imported):
			ctfe_eval_imported_global(context, imported)
		CtfeIrRangeExpr(start_expr, end_expr):
			ctfe_eval_range(context, env, expr, start_expr, end_expr)
		CtfeIrMatchExpr(scrutinee, cases):
			ctfe_eval_match(context, env, scrutinee, cases)
		CtfeIrWhileExpr(condition, body):
			match ctfe_eval_while_env(context, env, condition, body):
				Ok(_):
					Ok(ctfe_eval_void_value(expr))
				Err(error):
					Err(error)
		CtfeIrForExpr(name, iterable, body):
			match ctfe_eval_for_env(context, env, name, iterable, body):
				Ok(_):
					Ok(ctfe_eval_void_value(expr))
				Err(error):
					Err(error)
		CtfeIrForTupleExpr(names, iterable, body):
			match ctfe_eval_for_tuple_env(context, env, names, iterable, body):
				Ok(_):
					Ok(ctfe_eval_void_value(expr))
				Err(error):
					Err(error)
		CtfeIrBreakExpr:
			Err(CtfeEvalUnsupported("break expressions"))
		CtfeIrContinueExpr:
			Err(CtfeEvalUnsupported("continue expressions"))
		CtfeIrBlockExpr(block):
			ctfe_eval_block(context, env, expr, block)
		CtfeIrStringInterpolationExpr(parts, _):
			ctfe_eval_string_interpolation(context, env, expr, parts)
		CtfeIrVoidExpr:
			Ok(ctfe_eval_void_value(expr))


pure func ctfe_eval_typed_expr(
	context: CtfeContext,
	env: CtfeEnv,
	expr: TypedExpr,
) -> Result[CtfeValue, CtfeEvalError]:
	match ctfe_ir_from_typed_expr(context, expr):
		Ok(ir):
			ctfe_eval_ir_in_context(context, env, ir)
		Err(error):
			Err(CtfeEvalTranslateError(error))
