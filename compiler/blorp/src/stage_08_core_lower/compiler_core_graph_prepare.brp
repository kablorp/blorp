-- Assemble the typed module graph into the one prepared Core program accepted
-- by the semantic middle.
--
-- This is the checkpoint-8 ownership boundary. It lowers each module, flattens
-- module-owned names, lowers the unprefixed root program, and attaches the FFI
-- and list-layout facts required by the first middle-Core pass.
import:
	../stage_06_typecheck/compiler_typecheck_decl: TypedProgram
	../stage_09_core/compiler_core_json: CoreProgram
	compiler_core_ffi_boundary:
		CoreFfiBoundaryError,
		annotate_ffi_boundaries,
		core_ffi_boundary_error_to_string,
	compiler_core_flatten:
		CoreCallableAlias,
		prefix_module_names_with_aliases,
		rewrite_program_callable_aliases,
	compiler_core_list_layout: annotate_list_layouts
	compiler_core_lower:
		CompilerCoreLowerContext,
		CompilerCoreLowerError,
		compiler_core_lower_context,
		compiler_core_lower_error_to_string,
		lower_typed_program,


record CompilerCoreGraphUnit {
	module_name: String,
	typed_program: TypedProgram
}


record CompilerCorePreparedGraph {
	program: CoreProgram,
	next_def_id: Int
}


union CompilerCoreGraphPrepareError:
	CompilerCoreGraphLowerError(String, CompilerCoreLowerError)
	CompilerCoreGraphFfiError(CoreFfiBoundaryError)


private record LoweredCoreModules {
	context: CompilerCoreLowerContext,
	programs: List[CoreProgram],
	callable_aliases: List[CoreCallableAlias]
}


pure func compiler_core_graph_prepare_error_to_string(
	error: CompilerCoreGraphPrepareError,
) -> String:
	match error:
		CompilerCoreGraphLowerError(module_name, lower_error):
			"${module_name}: ${compiler_core_lower_error_to_string(lower_error)}"
		CompilerCoreGraphFfiError(ffi_error):
			core_ffi_boundary_error_to_string(ffi_error)


private pure func lower_core_modules(
	modules: List[CompilerCoreGraphUnit],
	context: CompilerCoreLowerContext,
) -> Result[LoweredCoreModules, CompilerCoreGraphPrepareError]:
	match modules:
		[]:
			Ok({
				context = context,
				programs = [],
				callable_aliases = [],
			})
		[unit, ...remaining]:
			module_context = compiler_core_lower_context(
				context.next_def_id,
				Some(unit.module_name),
			)

			lowered_result ?= match lower_typed_program(module_context, unit.typed_program):
				Ok(result):
					Ok(result)
				Err(error):
					Err(CompilerCoreGraphLowerError(unit.module_name, error))

			prefixed = prefix_module_names_with_aliases(unit.module_name, lowered_result.program)
			rest ?= lower_core_modules(remaining, lowered_result.context)

			Ok({
				context = rest.context,
				programs = [prefixed.program].concat(rest.programs),
				callable_aliases = prefixed.callable_aliases.concat(rest.callable_aliases),
			})


private pure func assemble_core_program(
	modules: List[CoreProgram],
	target: CoreProgram,
) -> CoreProgram:
	module_decls = modules.flat_map(func(program): program.decls)
	module_includes = modules.flat_map(func(program): program.foreign_includes)

	{
		decls = module_decls.concat(target.decls),
		foreign_includes = module_includes
			.concat(target.foreign_includes)
			.unique()
	}


pure func prepare_core_graph(
	target: TypedProgram,
	modules: List[CompilerCoreGraphUnit],
	next_def_id: Int,
) -> Result[CompilerCorePreparedGraph, CompilerCoreGraphPrepareError]:
	initial_context = compiler_core_lower_context(next_def_id, None)
	lowered_modules ?= lower_core_modules(modules, initial_context)
	target_context = compiler_core_lower_context(lowered_modules.context.next_def_id, None)

	lowered_target_result ?= match lower_typed_program(target_context, target):
		Ok(result):
			Ok(result)
		Err(error):
			Err(CompilerCoreGraphLowerError("target", error))

	assembled = assemble_core_program(lowered_modules.programs, lowered_target_result.program)
	aliased = rewrite_program_callable_aliases(assembled, lowered_modules.callable_aliases)

	ffi_program ?= match annotate_ffi_boundaries(aliased):
		Ok(program):
			Ok(program)
		Err(error):
			Err(CompilerCoreGraphFfiError(error))

	Ok({
		program = annotate_list_layouts(ffi_program),
		next_def_id = lowered_target_result.context.next_def_id,
	})
