private pure func lower_core_patterns(
	patterns: List[CompilerTypedPattern],
) -> Result[List[CorePattern], CompilerCoreLowerError]:
	var lowered: List[CorePattern] = []
	var failure: Option[CompilerCoreLowerError] = None

	for pattern in patterns:
		if failure.is_none():
			match lower_core_pattern(pattern):
				Ok(lowered_pattern):
					lowered = lowered.append(lowered_pattern)
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func lower_core_pattern(
	pattern: CompilerTypedPattern,
) -> Result[CorePattern, CompilerCoreLowerError]:
	match pattern:
		CompilerTypedWildcardPattern(_):
			Ok(WildcardPattern)
		CompilerTypedNamePattern(name, _):
			Ok(NamePattern(name.text))
		CompilerTypedBoolPattern(value, _):
			Ok(LiteralPattern(BoolLiteral(value)))
		CompilerTypedIntPattern(value, _):
			Ok(LiteralPattern(compiler_core_literal_int(value)))
		CompilerTypedFloatPattern(value, _):
			Ok(LiteralPattern(FloatTextLiteral(value)))
		CompilerTypedStringPattern(value, _):
			Ok(LiteralPattern(StringLiteral(value)))
		CompilerTypedCharPattern(value, _):
			Ok(LiteralPattern(CharLiteral(value)))
		CompilerTypedConstructorPattern(name, args, _):
			lowered_args ?= lower_core_patterns(args)
			Ok(ConstructorPattern(name.text, lowered_args))
		CompilerTypedQualifiedConstructorPattern(module_name, name, args, _):
			lowered_args ?= lower_core_patterns(args)
			Ok(QualifiedConstructorPattern(module_name.text, name.text, lowered_args))
		CompilerTypedTuplePattern(items, _):
			lowered_items ?= lower_core_patterns(items)
			Ok(TuplePattern(lowered_items))
		CompilerTypedListPattern(items, spread, _):
			lowered_items ?= lower_core_patterns(items)

			lowered_spread = match spread:
				Some(ParsedListSpreadName(name)):
					Some(NamePattern(name.text))
				Some(ParsedListSpreadWildcard(_)):
					Some(WildcardPattern)
				None:
					None

			Ok(ListPattern(lowered_items, lowered_spread))
		CompilerTypedOrPattern(items, _):
			lowered_items ?= lower_core_patterns(items)
			Ok(OrPattern(lowered_items))
		CompilerTypedUnsupportedPattern(label, _):
			Err(CompilerCoreLowerUnsupported("match pattern: " + label))


private pure func compiler_core_binary_op(op: ParsedBinaryOp) -> CoreBinaryOp:
	match op:
		ParsedAddOp:
			AddOp
		ParsedSubtractOp:
			SubtractOp
		ParsedMultiplyOp:
			MultiplyOp
		ParsedDivideOp:
			DivideOp
		ParsedModuloOp:
			ModuloOp
		ParsedEqualOp:
			EqualOp
		ParsedNotEqualOp:
			NotEqualOp
		ParsedLessOp:
			LessOp
		ParsedLessEqualOp:
			LessEqualOp
		ParsedGreaterOp:
			GreaterOp
		ParsedGreaterEqualOp:
			GreaterEqualOp


private pure func compiler_core_unary_op(op: ParsedUnaryOp) -> CoreUnaryOp:
	match op:
		ParsedNegateOp:
			NegateOp
		ParsedNotOp:
			NotOp


private pure func compiler_core_logical_op(op: ParsedLogicalOp) -> CoreLogicalOp:
	match op:
		ParsedAndOp:
			AndOp
		ParsedOrOp:
			OrOp


private pure func is_decimal_digit(ch: Char) -> Bool:
	ch >= '0' and ch <= '9'


private pure func decimal_magnitude_text(text: String) -> String:
	start: Int = if text.starts_with("-") or text.starts_with("+"):
		1
	else:
		0

	var index: Int = start

	while index < text.length() and text.get_or(index, '0') == '0':
		index += 1

	var result: String = ""

	while index < text.length():
		ch: Char = text.get_or(index, ' ')

		if is_decimal_digit(ch):
			result += ch.to_string()

		index += 1

	if result.length() == 0:
		"0"
	else:
		result


private pure func decimal_text_leq_same_length(left: String, right: String) -> Bool:
	var index: Int = 0
	var decided: Bool = False
	var result: Bool = True

	while index < left.length() and not decided:
		left_ch: Char = left.get_or(index, '0')
		right_ch: Char = right.get_or(index, '0')

		if left_ch < right_ch:
			decided = True
			result = True
		else if left_ch > right_ch:
			decided = True
			result = False

		index += 1

	result


private pure func decimal_text_leq(left: String, right: String) -> Bool:
	if left.length() < right.length():
		True
	else if left.length() > right.length():
		False
	else:
		decimal_text_leq_same_length(left, right)


private pure func int_literal_fits_core_int(text: String) -> Bool:
	magnitude: String = decimal_magnitude_text(text)

	limit: String = if text.starts_with("-"):
		CORE_INT_MIN_MAGNITUDE_DECIMAL
	else:
		CORE_INT_MAX_DECIMAL

	decimal_text_leq(magnitude, limit)


private pure func compiler_core_literal_int(text: String) -> CoreLiteral:
	if int_literal_fits_core_int(text):
		match text.parse_int():
			Some(value):
				IntLiteral(value)
			None:
				WideIntLiteral(text)
	else:
		WideIntLiteral(text)


private pure func lower_typed_exprs(
	exprs: List[CompilerTypedExpr],
) -> Result[List[CoreExpr], CompilerCoreLowerError]:
	var lowered: List[CoreExpr] = []
	var failure: Option[CompilerCoreLowerError] = None

	for expr in exprs:
		if failure.is_none():
			match lower_typed_expr(expr):
				Ok(lowered_expr):
					lowered = lowered.append(lowered_expr)
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func core_primitive_box_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			if args.length() != 0:
				False
			else if name == "Int":
				True
			else if name == "Int8":
				True
			else if name == "Int16":
				True
			else if name == "Int32":
				True
			else if name == "Int64":
				True
			else if name == "UInt8":
				True
			else if name == "UInt16":
				True
			else if name == "UInt32":
				True
			else if name == "UInt64":
				True
			else if name == "Bool":
				True
			else if name == "Char":
				True
			else:
				False
		RangeType:
			True
		_:
			False


private pure func core_box_kind_for_type(typ: CoreType) -> CoreBoxKind:
	match typ:
		VoidType:
			VoidBox
		NamedType(name, args):
			if name == "Float" and args.length() == 0:
				FloatBox
			else if name == "Float32" and args.length() == 0:
				Float32Box
			else if name == "Float16" and args.length() == 0:
				Float16Box
			else if name == "Int128" and args.length() == 0:
				Int128Box
			else if name == "UInt128" and args.length() == 0:
				UInt128Box
			else if core_primitive_box_type(typ):
				PrimBox
			else:
				PointerBox
		_:
			if core_primitive_box_type(typ):
				PrimBox
			else:
				PointerBox


private pure func core_boxed_value_needs_release_type(typ: CoreType, kind: CoreBoxKind) -> Bool:
	match kind:
		PointerBox:
			match typ:
				NamedType(name, args):
					if name == "String" and args.length() == 0:
						True
					else if name == "Bytes" and args.length() == 0:
						True
					else if name == "Fixed" and args.length() == 0:
						True
					else if name == "Closure" and args.length() == 0:
						True
					else if name == "List" and args.length() == 1:
						True
					else if name == "Dict" and args.length() == 2:
						True
					else if name == "Set" and args.length() == 1:
						True
					else if name == "Channel" and args.length() == 1:
						True
					else if name == "Result" and args.length() == 2:
						True
					else:
						False
				TupleType(_):
					True
				TensorType(_):
					True
				_:
					False
		Int128Box:
			True
		UInt128Box:
			True
		_:
			False


private pure func core_boxed_storage_value_for_expr(
	expr: CoreExpr,
	typ: CoreType,
) -> CoreBoxedStorageValue:
	kind: CoreBoxKind = core_box_kind_for_type(typ)

	{
		kind = kind,
		value = expr,
		needs_release = core_boxed_value_needs_release_type(typ, kind),
		transfers_ownership = False
	}


private pure func lower_typed_list_items(
	items: List[CompilerTypedExpr],
) -> Result[List[CoreBoxedStorageValue], CompilerCoreLowerError]:
	var lowered: List[CoreBoxedStorageValue] = []
	var failure: Option[CompilerCoreLowerError] = None

	for item in items:
		if failure.is_none():
			match lower_typed_expr(item):
				Ok(lowered_expr):
					match compiler_core_lower_value_type(compiler_typed_expr_value_type(item)):
						Ok(item_type):
							lowered = lowered.append(
								core_boxed_storage_value_for_expr(
									lowered_expr,
									item_type,
								),
							)
						Err(error):
							failure = Some(error)
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func lower_typed_dict_entries(
	entries: List[CompilerTypedDictEntry],
) -> Result[List[CoreDictLiteralEntry], CompilerCoreLowerError]:
	var lowered: List[CoreDictLiteralEntry] = []
	var failure: Option[CompilerCoreLowerError] = None

	for entry in entries:
		if failure.is_none():
			match lower_typed_expr(entry.key):
				Ok(key):
					match lower_typed_expr(entry.value):
						Ok(value):
							lowered = lowered.append({
								key = key,
								value = value,
							})
						Err(error):
							failure = Some(error)
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func lower_typed_record_fields(
	fields: List[CompilerTypedRecordField],
) -> Result[List[CoreRecordFieldValue], CompilerCoreLowerError]:
	var lowered: List[CoreRecordFieldValue] = []
	var failure: Option[CompilerCoreLowerError] = None

	for field in fields:
		if failure.is_none():
			match lower_typed_expr(field.value):
				Ok(value):
					lowered = lowered.append({
						name = field.name.text,
						value = value,
					})
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func lower_record_update_field(
	field: CompilerFieldDecl,
	updates: List[CoreRecordFieldValue],
	base_ref: CoreExpr,
	loc: CoreSourceLoc,
) -> Result[CoreRecordFieldValue, CompilerCoreLowerError]:
	field_type ?= compiler_core_lower_type(field.field_type)

	match updates.find(func(update): update.name == field.name):
		Some(update):
			Ok(update)
		None:
			Ok({
				name = field.name,
				value = FieldExpr(base_ref, field.name, field_type, loc),
			})


private pure func lower_record_update_fields(
	record_fields: List[CompilerFieldDecl],
	updates: List[CoreRecordFieldValue],
	base_ref: CoreExpr,
	loc: CoreSourceLoc,
) -> Result[List[CoreRecordFieldValue], CompilerCoreLowerError]:
	match record_fields:
		[]:
			Ok([])
		[field, ...rest]:
			lowered ?= lower_record_update_field(field, updates, base_ref, loc)
			lowered_rest ?= lower_record_update_fields(rest, updates, base_ref, loc)
			Ok([lowered].concat(lowered_rest))


private pure func lower_typed_record_update(
	receiver: CompilerTypedExpr,
	updates: List[CompilerTypedRecordField],
	record_fields: List[CompilerFieldDecl],
	span: CompilerSourceSpan,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CompilerCoreLowerError]:
	match typ:
		VoidType:
			Err(CompilerCoreLowerInvalidType("record update is missing its checked record shape"))
		_:
			lowered_receiver ?= lower_typed_expr(receiver)
			lowered_updates ?= lower_typed_record_fields(updates)
			temp_var: CoreVar = {
				name = "__record_update_" + span.start_offset.to_string(),
				uniq = span.start_offset,
				def_id = None
			}
			base_ref = VarExpr(temp_var, typ, loc)
			fields ?= lower_record_update_fields(record_fields, lowered_updates, base_ref, loc)

			Ok(
				LetExpr(
					temp_var,
					False,
					typ,
					lowered_receiver,
					RecordUpdateExpr(base_ref, fields, typ, loc),
				),
			)


private pure func core_string_type() -> CoreType:
	NamedType("String", [])


private pure func interpolation_to_string_function(typ: CoreType) -> Option[String]:
	match typ:
		NamedType(name, args):
			if args.length() != 0:
				Some("blorp_to_string")
			else:
				match name:
					"String":
						None
					"Float":
						Some("blorp_float_to_string")
					"Float32":
						Some("blorp_float32_to_string")
					"Float16":
						Some("blorp_float16_to_string")
					"Bool":
						Some("blorp_bool_to_string")
					"Char":
						Some("blorp_from_char")
					"Int128":
						Some("blorp_int128_to_string")
					"UInt128":
						Some("blorp_uint128_to_string")
					_:
						Some("blorp_to_string")
		_:
			Some("blorp_to_string")


private pure func interpolation_builtin_call(
	name: String,
	args: List[CoreExpr],
	loc: CoreSourceLoc,
) -> CoreExpr:
	CallExpr(
		BuiltinCall(name),
		VoidExpr(VoidType, loc),
		args,
		core_string_type(),
		loc,
	)


private pure func lower_string_interpolation_part(
	part: CompilerTypedStringInterpolationPart,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CompilerCoreLowerError]:
	match part:
		CompilerTypedInterpolationLiteral(text):
			Ok(LiteralExpr(StringLiteral(text), core_string_type(), loc))
		CompilerTypedInterpolationExpr(expr):
			lowered ?= lower_typed_expr(expr)
			expr_type ?= compiler_core_lower_value_type(compiler_typed_expr_value_type(expr))

			match interpolation_to_string_function(expr_type):
				Some(function_name):
					Ok(interpolation_builtin_call(function_name, [lowered], loc))
				None:
					Ok(lowered)


private pure func lower_string_interpolation_parts(
	parts: List[CompilerTypedStringInterpolationPart],
	loc: CoreSourceLoc,
) -> Result[List[CoreExpr], CompilerCoreLowerError]:
	match parts:
		[]:
			Ok([])
		[part, ...rest]:
			lowered ?= lower_string_interpolation_part(part, loc)
			lowered_rest ?= lower_string_interpolation_parts(rest, loc)
			Ok([lowered].concat(lowered_rest))


private pure func lower_string_interpolation(
	parts: List[CompilerTypedStringInterpolationPart],
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CompilerCoreLowerError]:
	lowered ?= lower_string_interpolation_parts(parts, loc)

	match lowered:
		[]:
			Ok(LiteralExpr(StringLiteral(""), core_string_type(), loc))
		[single]:
			Ok(single)
		[first, second]:
			Ok(
				interpolation_builtin_call(
					"blorp_string_concat_consume",
					[first, second],
					loc,
				),
			)
		_:
			count = LiteralExpr(
				IntLiteral(lowered.length()),
				NamedType("Int", []),
				loc,
			)
			Ok(interpolation_builtin_call("blorp_string_concat_many", [count].concat(lowered), loc))


private pure func lower_typed_field_access(
	receiver: CompilerTypedExpr,
	field: ParsedIdentifier,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CompilerCoreLowerError]:
	lowered_receiver ?= lower_typed_expr(receiver)
	receiver_type ?= compiler_core_lower_value_type(compiler_typed_expr_value_type(receiver))

	match receiver_type:
		TupleType(items):
			match field.text.parse_int():
				Some(index):
					if index >= 0 and index < items.length():
						Ok(TupleFieldExpr(lowered_receiver, index, typ, loc))
					else:
						Err(
							CompilerCoreLowerInvalidType(
								"tuple field index " + index.to_string() + " is out of bounds for tuple arity " + items
									.length()
									.to_string(),
							),
						)
				None:
					Err(
						CompilerCoreLowerInvalidType(
							"tuple field access requires numeric field name",
						),
					)
		NamedType(name, args):
			if name == "Tuple":
				match field.text.parse_int():
					Some(index):
						if index >= 0 and index < args.length():
							Ok(TupleFieldExpr(lowered_receiver, index, typ, loc))
						else:
							Err(
								CompilerCoreLowerInvalidType(
									"tuple field index " + index.to_string() + " is out of bounds for tuple arity " + args
										.length()
										.to_string(),
								),
							)
					None:
						Err(
							CompilerCoreLowerInvalidType(
								"tuple field access requires numeric field name",
							),
						)
			else:
				Ok(FieldExpr(lowered_receiver, field.text, typ, loc))
		_:
			Ok(FieldExpr(lowered_receiver, field.text, typ, loc))


private pure func lower_raw_match_cases(
	cases: List[CompilerTypedMatchCase],
) -> Result[List[CoreRawMatchCase], CompilerCoreLowerError]:
	var lowered: List[CoreRawMatchCase] = []
	var failure: Option[CompilerCoreLowerError] = None

	for match_case in cases:
		if failure.is_none():
			match lower_core_pattern(match_case.pattern):
				Err(error):
					failure = Some(error)
				Ok(pattern):
					match lower_typed_expr(match_case.body):
						Err(error):
							failure = Some(error)
						Ok(body):
							lowered = lowered.append({
								pattern = pattern,
								body = body,
							})

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func lower_typed_concurrent_binding(
	binding: CompilerTypedConcurrentBinding,
) -> Result[CorePreClosureConcurrentBinding, CompilerCoreLowerError]:
	typ ?= compiler_core_lower_value_type(binding.info.value_type)
	rhs ?= lower_typed_expr(binding.value)

	Ok({
		variable = core_var(binding.name.text, None),
		typ = typ,
		rhs = rhs,
	})


private pure func lower_typed_concurrent_bindings(
	bindings: List[CompilerTypedConcurrentBinding],
) -> Result[List[CorePreClosureConcurrentBinding], CompilerCoreLowerError]:
	var lowered: List[CorePreClosureConcurrentBinding] = []
	var failure: Option[CompilerCoreLowerError] = None

	for binding in bindings:
		if failure.is_none():
			match lower_typed_concurrent_binding(binding):
				Ok(lowered_binding):
					lowered = lowered.append(lowered_binding)
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func positive_int_literal_from_typed_expr(
	label: String,
	expr: CompilerTypedExpr,
) -> Result[Int, CompilerCoreLowerError]:
	match expr:
		CompilerTypedIntLiteralExpr(text, _, _):
			match text.parse_int():
				Some(value):
					if value > 0:
						Ok(value)
					else:
						Err(CompilerCoreLowerInvalidType(label + " must be positive"))
				None:
					Err(CompilerCoreLowerInvalidType(label + " is too large"))
		_:
			Err(CompilerCoreLowerInvalidType(label + " must be an integer literal"))


private pure func lower_typed_timeout_expr(
	label: String,
	timeout: CompilerTypedExpr,
) -> Result[CoreExpr, CompilerCoreLowerError]:
	timeout_type = compiler_typed_expr_value_type(timeout)

	if compiler_core_timeout_is_int(timeout_type):
		lower_typed_expr(timeout)
	else if compiler_core_timeout_is_duration(timeout_type):
		duration_type ?= compiler_core_lower_value_type(timeout_type)
		lowered_duration ?= lower_typed_expr(timeout)
		Ok(
			lower_duration_timeout_milliseconds(
				lowered_duration,
				duration_type,
				typed_expr_span(timeout),
			),
		)
	else:
		Err(
			CompilerCoreLowerInvalidType(
				label + " expected Int milliseconds or Duration, got " + compiler_type_to_string(
					timeout_type,
				),
			),
		)


private pure func lower_typed_concurrent_params(
	params: List[CompilerTypedConcurrentParam],
) -> Result[CompilerCoreLowerConcurrentParams, CompilerCoreLowerError]:
	var timeout: Option[CoreExpr] = None
	var max_threads: Option[Int] = None
	var failure: Option[CompilerCoreLowerError] = None

	for param in params:
		if failure.is_none():
			name = param.name.text

			if name == "timeout":
				if timeout.is_some():
					failure = Some(CompilerCoreLowerInvalidType("duplicate concurrent timeout"))
				else:
					match lower_typed_timeout_expr("concurrent timeout", param.value):
						Ok(lowered_timeout):
							timeout = Some(lowered_timeout)
						Err(error):
							failure = Some(error)
			else if name == "max_threads":
				if max_threads.is_some():
					failure = Some(CompilerCoreLowerInvalidType("duplicate concurrent max_threads"))
				else:
					match positive_int_literal_from_typed_expr(
						"concurrent max_threads",
						param.value,
					):
						Ok(value):
							max_threads = Some(value)
						Err(error):
							failure = Some(error)
			else:
				failure = Some(CompilerCoreLowerUnsupported("concurrent parameter " + name))

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({
				timeout = timeout,
				max_threads = max_threads,
			})


private pure func lower_typed_concurrent_block(
	params: List[CompilerTypedConcurrentParam],
	bindings: List[CompilerTypedConcurrentBinding],
	body: CoreExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CompilerCoreLowerError]:
	lowered_params ?= lower_typed_concurrent_params(params)
	lowered_bindings ?= lower_typed_concurrent_bindings(bindings)
	block: CorePreClosureConcurrentBlock = {
		bindings = lowered_bindings,
		body = body,
		timeout = lowered_params.timeout,
		max_threads = lowered_params.max_threads
	}
	Ok(PreClosureConcurrentExpr(block, typ, loc))


private pure func compiler_core_timeout_is_int(typ: CompilerType) -> Bool:
	match typ:
		CompilerConstIntType(_):
			True
		CompilerNamedType(name, args):
			compiler_normalize_type_name(name) == "Int" and args.length() == 0
		_:
			False


private pure func compiler_core_timeout_is_duration(typ: CompilerType) -> Bool:
	match typ:
		CompilerNamedType(name, args):
			(
				name == compiler_canonical_module_type_name("std/units", "Duration")
				and args.length() == 0
			)
		_:
			False


private pure func timeout_binding_name(label: String, span: CompilerSourceSpan) -> String:
	"__timeout_" + label + "_" + span.start_line.to_string() + "_" + span.start_column.to_string()


private pure func timeout_binary(
	op: CoreBinaryOp,
	left: CoreExpr,
	right: CoreExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	BinaryExpr(op, left, right, typ, loc)


private pure func lower_duration_timeout_milliseconds(
	duration: CoreExpr,
	duration_type: CoreType,
	span: CompilerSourceSpan,
) -> CoreExpr:
	loc = compiler_core_source_loc(span)
	duration_name = timeout_binding_name("duration", span)
	microseconds_name = timeout_binding_name("microseconds", span)
	whole_ms_name = timeout_binding_name("whole_ms", span)

	duration_microseconds = VarExpr(
		core_var(duration_name, None),
		core_int_type(),
		loc,
	)
	microseconds_ref = VarExpr(
		core_var(microseconds_name, None),
		core_int_type(),
		loc,
	)
	whole_ms_ref = VarExpr(
		core_var(whole_ms_name, None),
		core_int_type(),
		loc,
	)
	microseconds_per_ms = core_int_literal(MICROSECONDS_PER_MILLISECOND, loc)
	zero = core_int_literal(0, loc)
	one = core_int_literal(1, loc)

	whole_ms_rhs = timeout_binary(
		DivideOp,
		microseconds_ref,
		microseconds_per_ms,
		core_int_type(),
		loc,
	)
	rounded_ms = IfExpr(
		timeout_binary(
			EqualOp,
			timeout_binary(ModuloOp, microseconds_ref, microseconds_per_ms, core_int_type(), loc),
			zero,
			core_bool_type(),
			loc,
		),
		whole_ms_ref,
		timeout_binary(AddOp, whole_ms_ref, one, core_int_type(), loc),
		core_int_type(),
		loc,
	)
	positive_ms = LetExpr(
		core_var(whole_ms_name, None),
		False,
		core_int_type(),
		whole_ms_rhs,
		rounded_ms,
	)
	clamped_ms = IfExpr(
		timeout_binary(LessEqualOp, microseconds_ref, zero, core_bool_type(), loc),
		zero,
		positive_ms,
		core_int_type(),
		loc,
	)
	converted = LetExpr(
		core_var(microseconds_name, None),
		False,
		core_int_type(),
		duration_microseconds,
		clamped_ms,
	)

	LetExpr(
		core_var(duration_name, None),
		False,
		duration_type,
		duration,
		converted,
	)


private pure func lower_typed_select_timeout(
	timeout: CompilerTypedExpr,
) -> Result[CoreExpr, CompilerCoreLowerError]:
	lower_typed_timeout_expr("select after timeout", timeout)


private pure func lower_typed_select_arm_kind(
	kind: CompilerTypedSelectArmKind,
) -> Result[CoreSelectArmKind, CompilerCoreLowerError]:
	match kind:
		CompilerTypedSelectReceiveArm(name, element_type, channel):
			elem_type ?= compiler_core_lower_type(element_type)
			lowered_channel ?= lower_typed_expr(channel)
			recv: CoreSelectRecvArm = {
				binder = core_var(name.text, None),
				elem_type = elem_type,
				channel = lowered_channel
			}
			Ok(SelectRecvArm(recv))
		CompilerTypedSelectSealedArm(_, channel):
			lowered_channel ?= lower_typed_expr(channel)
			Ok(SelectSealedArm(lowered_channel))
		CompilerTypedSelectAfterArm(timeout):
			lowered_timeout ?= lower_typed_select_timeout(timeout)
			Ok(SelectAfterArm(lowered_timeout))


private pure func lower_typed_select_arm(
	arm: CompilerTypedSelectArm,
) -> Result[CoreSelectArm, CompilerCoreLowerError]:
	kind ?= lower_typed_select_arm_kind(arm.kind)
	body ?= lower_typed_expr(arm.body)

	Ok({
		kind = kind,
		body = body,
		loc = compiler_core_source_loc(arm.span),
	})


private pure func lower_typed_select_arms(
	arms: List[CompilerTypedSelectArm],
) -> Result[List[CoreSelectArm], CompilerCoreLowerError]:
	var lowered: List[CoreSelectArm] = []
	var failure: Option[CompilerCoreLowerError] = None

	for arm in arms:
		if failure.is_none():
			match lower_typed_select_arm(arm):
				Ok(lowered_arm):
					lowered = lowered.append(lowered_arm)
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func lower_typed_lambda_params(
	params: List[CompilerTypedLambdaParam],
) -> Result[List[CoreParam], CompilerCoreLowerError]:
	var lowered: List[CoreParam] = []
	var failure: Option[CompilerCoreLowerError] = None

	for param in params:
		if failure.is_none():
			match compiler_core_lower_type(param.param_type):
				Ok(param_type):
					lowered = lowered.append({
						name = core_var(param.name.text, None),
						typ = param_type,
						loc = compiler_core_source_loc(param.name.span),
					})
				Err(CompilerCoreLowerInvalidType(message)):
					failure = Some(
						CompilerCoreLowerInvalidType(
							"lambda parameter `" + param.name.text + "` has an invalid type: " + message,
						),
					)
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func lower_for_name_binder(
	binder: ParsedForBinder,
	element_type: CompilerType,
) -> Result[CoreLoopBinder, CompilerCoreLowerError]:
	match binder:
		ParsedForNameBinder(name):
			typ ?= compiler_core_lower_value_type(element_type)
			Ok({
				variable = core_var(name.text, None),
				typ = typ,
				range_direction = RangeMayRunBackward,
			})
		ParsedForTupleBinder(_, _):
			Err(CompilerCoreLowerUnsupported("tuple for binder"))


private pure func lower_typed_for_binding(
	binder: ParsedForBinder,
	element_type: CompilerType,
	body: CompilerTypedExpr,
) -> Result[CompilerCoreLowerLoopBinding, CompilerCoreLowerError]:
	lowered_body ?= lower_typed_expr(body)

	match binder:
		ParsedForNameBinder(_):
			lowered_binder ?= lower_for_name_binder(binder, element_type)
			Ok({
				binder = lowered_binder,
				body = lowered_body,
			})
		ParsedForTupleBinder(names, span):
			match element_type:
				CompilerTupleType(element_types):
					if names.length() != element_types.length():
						Err(
							CompilerCoreLowerInvalidType(
								"tuple for binder has ${names.length()} names but element type has ${element_types.length()} fields",
							),
						)
					else:
						field_types ?= compiler_core_lower_type_list(element_types)
						tuple_type: CoreType = TupleType(field_types)
						tuple_var = core_var(tuple_destruct_name(span), None)
						tuple_ref = VarExpr(
							clone_core_var(tuple_var),
							clone_core_type(tuple_type),
							compiler_core_source_loc(span),
						)
						body_with_bindings ?= lower_tuple_destruct_bindings(
							names,
							0,
							tuple_ref,
							field_types,
							lowered_body,
							compiler_core_source_loc(span),
						)
						Ok({
							binder = {
								variable = tuple_var,
								typ = tuple_type,
								range_direction = RangeMayRunBackward
							},
							body = body_with_bindings,
						})
				_:
					Err(
						CompilerCoreLowerInvalidType(
							"tuple for binder requires a tuple element type",
						),
					)


private pure func lower_typed_range_for(
	binder: ParsedForBinder,
	iterable: CompilerTypedExpr,
	start_expr: CompilerTypedExpr,
	end_expr: CompilerTypedExpr,
	body: CompilerTypedExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CompilerCoreLowerError]:
	iterable_type = compiler_typed_expr_value_type(iterable)

	is_range: Bool = match iterable_type:
		CompilerRangeType(_):
			True
		CompilerNamedType(name, args):
			compiler_normalize_type_name(name) == "Range" and args.length() == 0
		_:
			False

	if not is_range:
		Err(
			CompilerCoreLowerInvalidType(
				"range for expected a Range iterable, got " + compiler_type_to_string(
					iterable_type,
				),
			),
		)
	else:
		element_type = compiler_typed_expr_value_type(start_expr)
		lowered_binder ?= lower_for_name_binder(binder, element_type)
		lowered_start ?= lower_typed_expr(start_expr)
		lowered_end ?= lower_typed_expr(end_expr)
		lowered_body ?= lower_typed_expr(body)
		Ok(ForRangeExpr(lowered_binder, lowered_start, lowered_end, lowered_body, typ, loc))


private pure func lower_typed_for_parts(
	binder: ParsedForBinder,
	element_type: CompilerType,
	iterable: CompilerTypedExpr,
	body: CompilerTypedExpr,
) -> Result[CompilerCoreLowerForParts, CompilerCoreLowerError]:
	iterable_type: CompilerType = compiler_typed_expr_value_type(iterable)
	iterable_core_type ?= compiler_core_lower_type(iterable_type)
	lowered_binding ?= lower_typed_for_binding(binder, element_type, body)
	lowered_iterable ?= lower_typed_expr(iterable)

	Ok({
		binder = lowered_binding.binder,
		iterable = lowered_iterable,
		iterable_release_policy = CoreTypePolicy.cleanup_release_policy_for_type(
			iterable_core_type,
		),
		body = lowered_binding.body,
	})


private pure func lower_typed_range_value_for(
	binder: ParsedForBinder,
	iterable: CompilerTypedExpr,
	body: CompilerTypedExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CompilerCoreLowerError]:
	lowered_binder ?= lower_for_name_binder(binder, compiler_type_int())
	lowered_iterable ?= lower_typed_expr(iterable)
	lowered_body ?= lower_typed_expr(body)
	range_type ?= compiler_core_lower_type(compiler_typed_expr_value_type(iterable))
	range_var = core_var(
		loop_view_internal_name("range_source", for_binder_span(binder)),
		None,
	)
	range_ref = VarExpr(
		clone_core_var(range_var),
		clone_core_type(range_type),
		clone_core_source_loc(loc),
	)
	start_expr = FieldExpr(range_ref, "start", core_int_type(), clone_core_source_loc(loc))
	end_expr = FieldExpr(
		VarExpr(clone_core_var(range_var), clone_core_type(range_type), clone_core_source_loc(loc)),
		"end",
		core_int_type(),
		clone_core_source_loc(loc),
	)
	loop_expr = ForRangeExpr(
		lowered_binder,
		start_expr,
		end_expr,
		lowered_body,
		typ,
		clone_core_source_loc(loc),
	)

	Ok(LetExpr(range_var, False, range_type, lowered_iterable, loop_expr))


private pure func lower_typed_named_iterable_for(
	binder: ParsedForBinder,
	iterable: CompilerTypedExpr,
	body: CompilerTypedExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
	name: String,
	args: List[CompilerType],
) -> Result[CoreExpr, CompilerCoreLowerError]:
	normalized_name: String = compiler_normalize_type_name(name)

	if normalized_name == "Range" and args.length() == 0:
		lower_typed_range_value_for(binder, iterable, body, typ, loc)
	else if normalized_name == "List":
		match args:
			[element_type]:
				parts ?= lower_typed_for_parts(binder, element_type, iterable, body)
				for_list: CoreForList = {
					binder = parts.binder,
					layout = PointerListStorage,
					iterable = parts.iterable,
					iterable_release_policy = parts.iterable_release_policy,
					body = parts.body
				}
				Ok(ForListExpr(for_list, typ, loc))
			_:
				Err(CompilerCoreLowerUnsupported("for over " + normalized_name))
	else if normalized_name == "String" and args.length() == 0:
		parts ?= lower_typed_for_parts(binder, compiler_type_char(), iterable, body)
		for_string: CoreForString = {
			binder = parts.binder,
			iterable = parts.iterable,
			iterable_release_policy = parts.iterable_release_policy,
			body = parts.body
		}
		Ok(ForStringExpr(for_string, typ, loc))
	else if normalized_name == "Dict":
		match args:
			[key_type, value_type]:
				element_type: CompilerType = match binder:
					ParsedForTupleBinder(_, _):
						CompilerTupleType([key_type, value_type])
					ParsedForNameBinder(_):
						key_type

				parts ?= lower_typed_for_parts(binder, element_type, iterable, body)
				for_dict: CoreForDict = {
					binder = parts.binder,
					iterable = parts.iterable,
					iterable_release_policy = parts.iterable_release_policy,
					body = parts.body
				}
				Ok(ForDictExpr(for_dict, typ, loc))
			_:
				Err(CompilerCoreLowerUnsupported("for over " + normalized_name))
	else if normalized_name == "Channel":
		match args:
			[element_type]:
				lowered_binder ?= lower_for_name_binder(binder, element_type)
				lowered_iterable ?= lower_typed_expr(iterable)
				lowered_body ?= lower_typed_expr(body)
				for_channel: CoreForChannel = {
					binder = lowered_binder,
					iterable = lowered_iterable,
					body = lowered_body
				}
				Ok(ForChannelExpr(for_channel, typ, loc))
			_:
				Err(CompilerCoreLowerUnsupported("for over " + normalized_name))
	else if normalized_name == "Set":
		match args:
			[element_type]:
				parts ?= lower_typed_for_parts(binder, element_type, iterable, body)
				for_set: CoreForSet = {
					binder = parts.binder,
					iterable = parts.iterable,
					iterable_release_policy = parts.iterable_release_policy,
					body = parts.body
				}
				Ok(ForSetExpr(for_set, typ, loc))
			_:
				Err(CompilerCoreLowerUnsupported("for over " + normalized_name))
	else if compiler_is_stream_type_name(name):
		match args:
			[element_type]:
				parts ?= lower_typed_for_parts(binder, element_type, iterable, body)
				for_stream: CoreForStream = {
					binder = parts.binder,
					iterable = parts.iterable,
					iterable_release_policy = parts.iterable_release_policy,
					body = parts.body
				}
				Ok(ForStreamExpr(for_stream, typ, loc))
			_:
				Err(CompilerCoreLowerUnsupported("for over " + normalized_name))
	else if compiler_is_resource_source_type_name(name):
		match args:
			[resource_type, _]:
				parts ?= lower_typed_for_parts(binder, resource_type, iterable, body)
				for_resource_source: CoreForResourceSource = {
					binder = parts.binder,
					iterable = parts.iterable,
					iterable_release_policy = parts.iterable_release_policy,
					body = parts.body
				}
				Ok(ForResourceSourceExpr(for_resource_source, typ, loc))
			_:
				Err(CompilerCoreLowerUnsupported("for over " + normalized_name))
	else:
		Err(CompilerCoreLowerUnsupported("for over " + normalized_name))


private pure func typed_loop_view_source(
	iterable: CompilerTypedExpr,
	view_name: String,
) -> Result[CompilerTypedExpr, CompilerCoreLowerError]:
	match iterable:
		CompilerTypedCallExpr(_, args, _, _):
			match args.get(0):
				Some(source):
					Ok(source)
				None:
					Err(
						CompilerCoreLowerInvalidType(
							view_name + " loop view is missing its source argument",
						),
					)
		_:
			Err(
				CompilerCoreLowerInvalidType(
					view_name + " loop view is not attached to a call expression",
				),
			)


private pure func unknown_named_core_call(
	name: String,
	args: List[CoreExpr],
	return_type: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	CallExpr(
		UnknownCall,
		VarExpr(
			core_var(name, None),
			NamedType("Closure", []),
			clone_core_source_loc(loc),
		),
		args,
		return_type,
		clone_core_source_loc(loc),
	)


private pure func lower_typed_indices_for(
	binder: ParsedForBinder,
	iterable: CompilerTypedExpr,
	element_type: CompilerType,
	body: CompilerTypedExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CompilerCoreLowerError]:
	source ?= typed_loop_view_source(iterable, "indices")
	lowered_binder ?= lower_for_name_binder(binder, element_type)
	lowered_source ?= lower_typed_expr(source)
	lowered_body ?= lower_typed_expr(body)
	length_call = unknown_named_core_call(
		"length",
		[lowered_source],
		core_int_type(),
		clone_core_source_loc(loc),
	)

	Ok(
		ForRangeExpr(
			lowered_binder,
			core_int_literal(0, clone_core_source_loc(loc)),
			length_call,
			lowered_body,
			typ,
			loc,
		),
	)


private pure func lower_typed_windows_for(
	binder: ParsedForBinder,
	iterable: CompilerTypedExpr,
	window_size: Int,
	window_source_type: CompilerType,
	body: CompilerTypedExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CompilerCoreLowerError]:
	if window_size <= 0:
		Err(CompilerCoreLowerInvalidType("windows loop size must be positive"))
	else:
		match binder:
			ParsedForTupleBinder(_, _):
				Err(CompilerCoreLowerInvalidType("windows loop requires a name binder"))
			ParsedForNameBinder(window_name):
				source ?= typed_loop_view_source(iterable, "windows")
				source_type ?= compiler_core_lower_type(compiler_typed_expr_value_type(source))
				window_type ?= compiler_core_lower_type(window_source_type)
				lowered_source ?= lower_typed_expr(source)
				lowered_body ?= lower_typed_expr(body)
				span: CompilerSourceSpan = for_binder_span(binder)
				source_var = core_var(
					loop_view_internal_name("windows_source", span),
					None,
				)
				index_var = core_var(
					loop_view_internal_name("windows_index", span),
					None,
				)
				index_type = core_int_type()
				length_call = unknown_named_core_call(
					"length",
					[
						VarExpr(
							clone_core_var(source_var),
							clone_core_type(source_type),
							clone_core_source_loc(loc),
						),
					],
					core_int_type(),
					clone_core_source_loc(loc),
				)
				window_size_expr = core_int_literal(window_size, clone_core_source_loc(loc))
				end_expr = BinaryExpr(
					AddOp,
					BinaryExpr(
						SubtractOp,
						length_call,
						window_size_expr,
						core_int_type(),
						clone_core_source_loc(loc),
					),
					core_int_literal(1, clone_core_source_loc(loc)),
					core_int_type(),
					clone_core_source_loc(loc),
				)
				index_ref = VarExpr(
					clone_core_var(index_var),
					clone_core_type(index_type),
					clone_core_source_loc(loc),
				)
				slice_expr = unknown_named_core_call(
					"checked_slice",
					[
						VarExpr(
							clone_core_var(source_var),
							clone_core_type(source_type),
							clone_core_source_loc(loc),
						),
						index_ref,
						BinaryExpr(
							AddOp,
							VarExpr(
								clone_core_var(index_var),
								clone_core_type(index_type),
								clone_core_source_loc(loc),
							),
							core_int_literal(window_size, clone_core_source_loc(loc)),
							core_int_type(),
							clone_core_source_loc(loc),
						),
					],
					clone_core_type(window_type),
					clone_core_source_loc(loc),
				)

				loop_body = if window_name.text == "_":
					lowered_body
				else:
					LetExpr(
						core_var(window_name.text, None),
						False,
						window_type,
						slice_expr,
						lowered_body,
					)

				loop_expr = ForRangeExpr(
					{
						variable = index_var,
						typ = index_type,
						range_direction = RangeMayRunBackward
					},
					core_int_literal(
						0,
						clone_core_source_loc(loc),
					),
					end_expr,
					loop_body,
					typ,
					clone_core_source_loc(loc),
				)

				Ok(LetExpr(source_var, False, source_type, lowered_source, loop_expr))


private pure func lower_enumerate_loop_body(
	binder: ParsedForBinder,
	span: CompilerSourceSpan,
	index_var: CoreVar,
	index_type: CoreType,
	element_expr: CoreExpr,
	element_type: CoreType,
	body: CompilerTypedExpr,
) -> Result[CoreExpr, CompilerCoreLowerError]:
	lowered_body ?= lower_typed_expr(body)

	match binder:
		ParsedForTupleBinder(names, _):
			if names.length() != 2:
				Err(
					CompilerCoreLowerInvalidType(
						"enumerate tuple loop requires exactly two binders",
					),
				)
			else:
				match (names.get(0), names.get(1)):
					(Some(index_name), Some(element_name)):
						if index_name.text != "_" and index_name.text != index_var.name:
							Err(
								CompilerCoreLowerInvalidType(
									"enumerate index binder does not match its Core loop variable",
								),
							)
						else if element_name.text == "_":
							Ok(lowered_body)
						else:
							Ok(
								LetExpr(
									core_var(element_name.text, None),
									False,
									element_type,
									element_expr,
									lowered_body,
								),
							)
					_:
						Err(
							CompilerCoreLowerInvalidType(
								"enumerate tuple loop has incomplete binder metadata",
							),
						)
		ParsedForNameBinder(name):
			if name.text == "_":
				Ok(lowered_body)
			else:
				tuple_type: CoreType = TupleType(
					[clone_core_type(index_type), clone_core_type(element_type)],
				)
				index_ref = VarExpr(
					clone_core_var(index_var),
					clone_core_type(index_type),
					compiler_core_source_loc(span),
				)

				Ok(
					LetExpr(
						core_var(
							name.text,
							None,
						),
						False,
						tuple_type,
						TupleExpr(
							[index_ref, element_expr],
							clone_core_type(tuple_type),
							compiler_core_source_loc(span),
						),
						lowered_body,
					),
				)


private pure func static_tensor_dim_product(dims: List[CompilerType]) -> Option[Int]:
	match dims:
		[]:
			Some(1)
		[CompilerConstIntType(value), ...rest]:
			static_tensor_dim_product(rest).map(func(product): value * product)
		_:
			None


private pure func lower_typed_enumerate_element(
	source_var: CoreVar,
	source_type: CoreType,
	index_var: CoreVar,
	index_type: CoreType,
	element_type: CoreType,
	dims: List[CompilerType],
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CompilerCoreLowerError]:
	source_ref = VarExpr(
		clone_core_var(source_var),
		clone_core_type(source_type),
		clone_core_source_loc(loc),
	)
	index_ref = VarExpr(
		clone_core_var(index_var),
		clone_core_type(index_type),
		clone_core_source_loc(loc),
	)

	match dims:
		[_]:
			Ok(
				unknown_named_core_call(
					"checked_get",
					[source_ref, index_ref],
					clone_core_type(element_type),
					clone_core_source_loc(loc),
				),
			)
		[_, first_inner, ...rest]:
			match (first_inner, static_tensor_dim_product(rest)):
				(CompilerConstIntType(first_inner_value), Some(remaining_size)):
					row_size: Int = first_inner_value * remaining_size
					Ok(
						builtin_core_call(
							"blorp_tensor_slice_row",
							[
								source_ref,
								index_ref,
								core_int_literal(row_size, clone_core_source_loc(loc)),
								core_int_literal(first_inner_value, clone_core_source_loc(loc)),
							],
							clone_core_type(element_type),
							clone_core_source_loc(loc),
						),
					)
				_:
					Err(
						CompilerCoreLowerUnsupported(
							"enumerate over a multidimensional tensor with non-literal inner dimensions",
						),
					)
		[]:
			Err(CompilerCoreLowerInvalidType("enumerate tensor source has no dimensions"))


private pure func lower_typed_tensor_enumerate_for(
	binder: ParsedForBinder,
	source: CompilerTypedExpr,
	source_type: CompilerType,
	dims: List[CompilerType],
	index_source_type: CompilerType,
	element_source_type: CompilerType,
	body: CompilerTypedExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CompilerCoreLowerError]:
	span: CompilerSourceSpan = for_binder_span(binder)

	index_name: String = loop_view_binder_name(binder, 0, "enumerate_index", span)

	index_type ?= compiler_core_lower_type(index_source_type)
	element_type ?= compiler_core_lower_type(element_source_type)
	lowered_source ?= lower_typed_expr(source)
	lowered_source_type ?= compiler_core_lower_type(source_type)
	source_var = core_var(
		loop_view_internal_name("enumerate_source", span),
		None,
	)
	index_var = core_var(index_name, None)
	element_expr ?= lower_typed_enumerate_element(
		source_var,
		lowered_source_type,
		index_var,
		index_type,
		element_type,
		dims,
		loc,
	)
	loop_body ?= lower_enumerate_loop_body(
		binder,
		span,
		index_var,
		index_type,
		element_expr,
		element_type,
		body,
	)
	length_call = unknown_named_core_call(
		"length",
		[
			VarExpr(
				clone_core_var(source_var),
				clone_core_type(lowered_source_type),
				clone_core_source_loc(loc),
			),
		],
		core_int_type(),
		clone_core_source_loc(loc),
	)
	loop_expr = ForRangeExpr(
		{
			variable = index_var,
			typ = index_type,
			range_direction = RangeMayRunBackward
		},
		core_int_literal(
			0,
			clone_core_source_loc(loc),
		),
		length_call,
		loop_body,
		typ,
		clone_core_source_loc(loc),
	)

	Ok(LetExpr(source_var, False, lowered_source_type, lowered_source, loop_expr))


private pure func lower_typed_enumerate_for(
	binder: ParsedForBinder,
	iterable: CompilerTypedExpr,
	loop_element_type: CompilerType,
	body: CompilerTypedExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CompilerCoreLowerError]:
	source ?= typed_loop_view_source(iterable, "enumerate")
	source_type: CompilerType = compiler_typed_expr_value_type(source)

	match loop_element_type:
		CompilerTupleType(elements):
			if elements.length() != 2:
				Err(
					CompilerCoreLowerInvalidType(
						"enumerate loop view must yield an (index, element) tuple",
					),
				)
			else:
				match compiler_array_type_parts(source_type):
					Some((_, dims)):
						match (elements.get(0), elements.get(1)):
							(Some(index_type), Some(element_type)):
								lower_typed_tensor_enumerate_for(
									binder,
									source,
									source_type,
									dims,
									index_type,
									element_type,
									body,
									typ,
									loc,
								)
							_:
								Err(
									CompilerCoreLowerInvalidType(
										"enumerate loop view has incomplete element metadata",
									),
								)
					None:
						Err(CompilerCoreLowerInvalidType("enumerate requires a tensor source"))
		_:
			Err(
				CompilerCoreLowerInvalidType(
					"enumerate loop view must yield an (index, element) tuple",
				),
			)


private pure func lower_enumerate2_loop_body(
	binder: ParsedForBinder,
	span: CompilerSourceSpan,
	row_var: CoreVar,
	row_type: CoreType,
	column_var: CoreVar,
	column_type: CoreType,
	element_expr: CoreExpr,
	element_type: CoreType,
	body: CompilerTypedExpr,
) -> Result[CoreExpr, CompilerCoreLowerError]:
	lowered_body ?= lower_typed_expr(body)

	match binder:
		ParsedForTupleBinder(names, _):
			if names.length() != 3:
				Err(
					CompilerCoreLowerInvalidType(
						"enumerate2 tuple loop requires exactly three binders",
					),
				)
			else:
				match (names.get(0), names.get(1), names.get(2)):
					(Some(row_name), Some(column_name), Some(element_name)):
						if row_name.text != "_" and row_name.text != row_var.name:
							Err(
								CompilerCoreLowerInvalidType(
									"enumerate2 row binder does not match its Core loop variable",
								),
							)
						else if column_name.text != "_" and column_name.text != column_var.name:
							Err(
								CompilerCoreLowerInvalidType(
									"enumerate2 column binder does not match its Core loop variable",
								),
							)
						else if element_name.text == "_":
							Ok(lowered_body)
						else:
							Ok(
								LetExpr(
									core_var(element_name.text, None),
									False,
									element_type,
									element_expr,
									lowered_body,
								),
							)
					_:
						Err(
							CompilerCoreLowerInvalidType(
								"enumerate2 tuple loop has incomplete binder metadata",
							),
						)
		ParsedForNameBinder(name):
			if name.text == "_":
				Ok(lowered_body)
			else:
				tuple_type: CoreType = TupleType([
					clone_core_type(row_type),
					clone_core_type(column_type),
					clone_core_type(element_type),
				])
				row_ref = VarExpr(
					clone_core_var(row_var),
					clone_core_type(row_type),
					compiler_core_source_loc(span),
				)
				column_ref = VarExpr(
					clone_core_var(column_var),
					clone_core_type(column_type),
					compiler_core_source_loc(span),
				)

				Ok(
					LetExpr(
						core_var(
							name.text,
							None,
						),
						False,
						tuple_type,
						TupleExpr(
							[row_ref, column_ref, element_expr],
							clone_core_type(tuple_type),
							compiler_core_source_loc(span),
						),
						lowered_body,
					),
				)


private pure func lower_typed_2d_enumerate2_for(
	binder: ParsedForBinder,
	source: CompilerTypedExpr,
	source_type: CompilerType,
	row_source_type: CompilerType,
	column_source_type: CompilerType,
	element_source_type: CompilerType,
	column_dim: CompilerType,
	body: CompilerTypedExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CompilerCoreLowerError]:
	span: CompilerSourceSpan = for_binder_span(binder)
	row_name: String = loop_view_binder_name(binder, 0, "enumerate2_row", span)
	column_name: String = loop_view_binder_name(binder, 1, "enumerate2_column", span)
	row_type ?= compiler_core_lower_type(row_source_type)
	column_type ?= compiler_core_lower_type(column_source_type)
	element_type ?= compiler_core_lower_type(element_source_type)
	lowered_source ?= lower_typed_expr(source)
	lowered_source_type ?= compiler_core_lower_type(source_type)
	source_var = core_var(
		loop_view_internal_name("enumerate2_source", span),
		None,
	)
	row_var = core_var(row_name, None)
	column_var = core_var(column_name, None)
	row_ref = VarExpr(
		clone_core_var(row_var),
		clone_core_type(row_type),
		clone_core_source_loc(loc),
	)
	column_ref = VarExpr(
		clone_core_var(column_var),
		clone_core_type(column_type),
		clone_core_source_loc(loc),
	)
	element_expr = unknown_named_core_call(
		"matrix_checked_get",
		[
			VarExpr(
				clone_core_var(source_var),
				clone_core_type(lowered_source_type),
				clone_core_source_loc(loc),
			),
			row_ref,
			column_ref,
		],
		clone_core_type(element_type),
		clone_core_source_loc(loc),
	)
	loop_body ?= lower_enumerate2_loop_body(
		binder,
		span,
		row_var,
		row_type,
		column_var,
		column_type,
		element_expr,
		element_type,
		body,
	)
	rows_call = unknown_named_core_call(
		"length",
		[
			VarExpr(
				clone_core_var(source_var),
				clone_core_type(lowered_source_type),
				clone_core_source_loc(loc),
			),
		],
		core_int_type(),
		clone_core_source_loc(loc),
	)

	column_count: CoreExpr = match column_dim:
		CompilerConstIntType(value):
			core_int_literal(value, clone_core_source_loc(loc))
		_:
			capacity_call = CallExpr(
				IntrinsicCall("tensor_capacity"),
				VoidExpr(VoidType, clone_core_source_loc(loc)),
				[
					VarExpr(
						clone_core_var(source_var),
						clone_core_type(lowered_source_type),
						clone_core_source_loc(loc),
					),
				],
				core_int_type(),
				clone_core_source_loc(loc),
			)
			column_rows_call = unknown_named_core_call(
				"length",
				[
					VarExpr(
						clone_core_var(source_var),
						clone_core_type(lowered_source_type),
						clone_core_source_loc(loc),
					),
				],
				core_int_type(),
				clone_core_source_loc(loc),
			)

			BinaryExpr(
				DivideOp,
				capacity_call,
				column_rows_call,
				core_int_type(),
				clone_core_source_loc(loc),
			)

	inner_loop = ForRangeExpr(
		{
			variable = column_var,
			typ = column_type,
			range_direction = RangeMayRunBackward
		},
		core_int_literal(
			0,
			clone_core_source_loc(loc),
		),
		column_count,
		loop_body,
		typ,
		clone_core_source_loc(loc),
	)
	outer_loop = ForRangeExpr(
		{
			variable = row_var,
			typ = row_type,
			range_direction = RangeMayRunBackward
		},
		core_int_literal(
			0,
			clone_core_source_loc(loc),
		),
		rows_call,
		inner_loop,
		typ,
		clone_core_source_loc(loc),
	)

	Ok(LetExpr(source_var, False, lowered_source_type, lowered_source, outer_loop))


private pure func lower_typed_enumerate2_for(
	binder: ParsedForBinder,
	iterable: CompilerTypedExpr,
	loop_element_type: CompilerType,
	body: CompilerTypedExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CompilerCoreLowerError]:
	source ?= typed_loop_view_source(iterable, "enumerate2")
	source_type: CompilerType = compiler_typed_expr_value_type(source)

	match loop_element_type:
		CompilerTupleType(elements):
			if elements.length() != 3:
				Err(
					CompilerCoreLowerInvalidType(
						"enumerate2 loop view must yield a (row, column, element) tuple",
					),
				)
			else:
				match compiler_array_type_parts(source_type):
					Some((_, dims)):
						if dims.length() != 2:
							Err(
								CompilerCoreLowerUnsupported(
									"enumerate2 requires a two-dimensional tensor",
								),
							)
						else:
							match (elements.get(0), elements.get(1), elements.get(2), dims.get(1)):
								(Some(row_source_type), Some(column_source_type), Some(element_source_type), Some(column_dim)):
									lower_typed_2d_enumerate2_for(
										binder,
										source,
										source_type,
										row_source_type,
										column_source_type,
										element_source_type,
										column_dim,
										body,
										typ,
										loc,
									)
								_:
									Err(
										CompilerCoreLowerInvalidType(
											"enumerate2 loop view has incomplete element or dimension metadata",
										),
									)
					None:
						Err(CompilerCoreLowerInvalidType("enumerate2 requires a tensor source"))
		_:
			Err(
				CompilerCoreLowerInvalidType(
					"enumerate2 loop view must yield a (row, column, element) tuple",
				),
			)


private pure func tensor_runtime_read_storage(
	element_type: CoreType,
) -> Option[CoreTensorForElementStorage]:
	match element_type:
		NamedType(name, args):
			if args.length() != 0:
				None
			else if name == "Float":
				Some(TensorForRuntimeReadElement({
					value_c_type = TypeLayout.c_type_name(element_type),
					helper = TensorRuntimeReadF64,
				}))
			else if name == "Float32":
				Some(TensorForRuntimeReadElement({
					value_c_type = TypeLayout.c_type_name(element_type),
					helper = TensorRuntimeReadF32,
				}))
			else if name == "Float16":
				Some(TensorForRuntimeReadElement({
					value_c_type = TypeLayout.c_type_name(element_type),
					helper = TensorRuntimeReadF16,
				}))
			else if (
				name == "Int"
				or name == "Int8"
				or name == "Int16"
				or name == "Int32"
				or name == "Int64"
				or name == "UInt8"
				or name == "UInt16"
				or name == "UInt32"
				or name == "UInt64"
				or name == "Bool"
				or name == "Char"
			):
				Some(TensorForRuntimeReadElement({
					value_c_type = TypeLayout.c_type_name(element_type),
					helper = TensorRuntimeReadI64,
				}))
			else:
				None
		RangeType:
			Some(TensorForRuntimeReadElement({
				value_c_type = TypeLayout.c_type_name(element_type),
				helper = TensorRuntimeReadI64,
			}))
		EnumType(_):
			Some(TensorForRuntimeReadElement({
				value_c_type = TypeLayout.c_type_name(element_type),
				helper = TensorRuntimeReadI64,
			}))
		_:
			None


private pure func one_dimensional_tensor_element_storage(
	element_type: CoreType,
) -> CoreTensorForElementStorage:
	match tensor_runtime_read_storage(element_type):
		Some(storage):
			storage
		None:
			match element_type:
				ValueRecordType(_):
					TensorForInlineStructElement(TypeLayout.c_type_name(element_type))
				_:
					TensorForBoxedElement(TypeLayout.c_type_name(element_type))


private pure func tensor_row_slice_storage(
	dims: List[CompilerType],
) -> Result[CoreTensorForElementStorage, CompilerCoreLowerError]:
	match dims:
		[_, CompilerConstIntType(inner_size)]:
			Ok(TensorForRowSliceElement({
				row_size = inner_size.to_string() + "L",
				result_first_dim = inner_size.to_string() + "L",
				runtime_derived = False,
			}))
		[_, _]:
			Ok(TensorForRowSliceElement({
				row_size = "",
				result_first_dim = "",
				runtime_derived = True,
			}))
		[_, CompilerConstIntType(first_inner), ...rest]:
			match static_tensor_dim_product(rest):
				Some(remaining_size):
					Ok(TensorForRowSliceElement({
						row_size = (first_inner * remaining_size).to_string() + "L",
						result_first_dim = first_inner.to_string() + "L",
						runtime_derived = False,
					}))
				None:
					Err(
						CompilerCoreLowerUnsupported(
							"cannot peel a 3D or higher tensor with non-literal inner dimensions",
						),
					)
		_:
			Err(CompilerCoreLowerInvalidType("tensor row loop requires at least two dimensions"))


private pure func lower_typed_tensor_for(
	binder: ParsedForBinder,
	iterable: CompilerTypedExpr,
	body: CompilerTypedExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
	element_type: CompilerType,
	dims: List[CompilerType],
) -> Result[CoreExpr, CompilerCoreLowerError]:
	match dims:
		[]:
			Err(CompilerCoreLowerInvalidType("tensor for loop source has no dimensions"))
		[_]:
			parts ?= lower_typed_for_parts(binder, element_type, iterable, body)
			lowered_element_type ?= compiler_core_lower_type(element_type)
			for_tensor: CoreForTensor = {
				binder = parts.binder,
				element_storage = one_dimensional_tensor_element_storage(lowered_element_type),
				iterable = parts.iterable,
				iterable_release_policy = parts.iterable_release_policy,
				body = parts.body
			}
			Ok(ForTensorExpr(for_tensor, typ, loc))
		[_, ...inner_dims]:
			row_type: CompilerType = CompilerArrayType(element_type, inner_dims)
			parts ?= lower_typed_for_parts(binder, row_type, iterable, body)
			storage ?= tensor_row_slice_storage(dims)
			for_tensor: CoreForTensor = {
				binder = parts.binder,
				element_storage = storage,
				iterable = parts.iterable,
				iterable_release_policy = parts.iterable_release_policy,
				body = parts.body
			}
			Ok(ForTensorExpr(for_tensor, typ, loc))


private pure func lower_typed_for(
	binder: ParsedForBinder,
	iterable: CompilerTypedExpr,
	loop_view: Option[CompilerTypedLoopView],
	body: CompilerTypedExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CompilerCoreLowerError]:
	match loop_view:
		Some(CompilerTypedIndicesLoopView(element_type)):
			lower_typed_indices_for(binder, iterable, element_type, body, typ, loc)
		Some(CompilerTypedEnumerateLoopView(element_type)):
			lower_typed_enumerate_for(binder, iterable, element_type, body, typ, loc)
		Some(CompilerTypedEnumerate2LoopView(element_type)):
			lower_typed_enumerate2_for(binder, iterable, element_type, body, typ, loc)
		Some(CompilerTypedWindowsLoopView(window_size, element_type)):
			lower_typed_windows_for(binder, iterable, window_size, element_type, body, typ, loc)
		None:
			match iterable:
				CompilerTypedRangeExpr(start_expr, end_expr, _, _):
					lower_typed_range_for(binder, iterable, start_expr, end_expr, body, typ, loc)
				_:
					iterable_type = compiler_typed_expr_value_type(iterable)

					match compiler_array_type_parts(iterable_type):
						Some((element_type, dims)):
							lower_typed_tensor_for(
								binder,
								iterable,
								body,
								typ,
								loc,
								element_type,
								dims,
							)
						None:
							match iterable_type:
								CompilerNamedType(name, args):
									lower_typed_named_iterable_for(
										binder,
										iterable,
										body,
										typ,
										loc,
										name,
										args,
									)
								_:
									Err(
										CompilerCoreLowerUnsupported(
											"for over " + compiler_type_to_string(iterable_type),
										),
									)


private pure func concurrent_for_item(
	iterable_type: CompilerType,
) -> Result[CompilerCoreLowerConcurrentForItem, CompilerCoreLowerError]:
	match iterable_type:
		CompilerNamedType(name, args):
			normalized_name: String = compiler_normalize_type_name(name)

			if normalized_name == "List":
				match args:
					[element_type]:
						item_type ?= compiler_core_lower_type(element_type)
						Ok({
							item_type = item_type,
							item_mode = ConcurrentlyLoopCopyItem,
						})
					_:
						Err(
							CompilerCoreLowerUnsupported(
								"for ... concurrently over " + normalized_name,
							),
						)
			else if compiler_is_resource_source_type_name(name):
				match args:
					[resource_source_type, error_source_type]:
						resource_type ?= compiler_core_lower_type(resource_source_type)
						error_type ?= compiler_core_lower_type(error_source_type)
						move_item: CoreConcurrentlyLoopMoveResourceItem = {
							resource_type = resource_type,
							error_type = error_type
						}
						Ok({
							item_type = resource_type,
							item_mode = ConcurrentlyLoopMoveResourceItem(move_item),
						})
					_:
						Err(
							CompilerCoreLowerUnsupported(
								"for ... concurrently over ResourceSource",
							),
						)
			else:
				Err(CompilerCoreLowerUnsupported("for ... concurrently over " + normalized_name))
		_:
			Err(
				CompilerCoreLowerUnsupported(
					"for ... concurrently over " + compiler_type_to_string(iterable_type),
				),
			)


private pure func lower_typed_concurrent_for_params(
	params: List[CompilerTypedConcurrentParam],
	loc: CoreSourceLoc,
) -> Result[CompilerCoreLowerConcurrentForParams, CompilerCoreLowerError]:
	var timeout: Option[CoreExpr] = None
	var limit: Option[CoreExpr] = None
	var failure: Option[CompilerCoreLowerError] = None

	for param in params:
		if failure.is_none():
			name = param.name.text

			if name == "timeout":
				if timeout.is_some():
					failure = Some(CompilerCoreLowerInvalidType("duplicate timeout parameter"))
				else:
					match lower_typed_timeout_expr("for ... concurrently timeout", param.value):
						Ok(lowered_timeout):
							timeout = Some(lowered_timeout)
						Err(error):
							failure = Some(error)
			else if name == "limit":
				if limit.is_some():
					failure = Some(CompilerCoreLowerInvalidType("duplicate concurrently limit"))
				else:
					match positive_int_literal_from_typed_expr("concurrently limit", param.value):
						Ok(value):
							limit = Some(core_int_literal(value, loc))
						Err(error):
							failure = Some(error)
			else if name == "max_threads":
				failure = Some(CompilerCoreLowerInvalidType((
							"use `limit: N` in `concurrently(...)`; `max_threads` is only valid on "
							+ "`concurrent(...)` blocks"
						)))
			else:
				failure = Some(
					CompilerCoreLowerUnsupported(
						"unknown concurrently parameter `" + name + "` (expected `limit` or `timeout`)",
					),
				)

	match failure:
		Some(error):
			Err(error)
		None:
			match limit:
				Some(limit_value):
					Ok({
						timeout = timeout,
						limit = limit_value,
					})
				None:
					Err(
						CompilerCoreLowerInvalidType(
							"`for ... concurrently(...)` requires `limit: N`",
						),
					)


private pure func discard_concurrent_for_body_if_needed(
	body: CoreExpr,
	body_type: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	if core_type_is_void(body_type):
		body
	else:
		SeqExpr(
			body,
			VoidExpr(VoidType, loc),
		)


private pure func lower_typed_concurrent_for(
	name: ParsedIdentifier,
	iterable: CompilerTypedExpr,
	params: List[CompilerTypedConcurrentParam],
	body: CompilerTypedExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CompilerCoreLowerError]:
	iterable_type = compiler_typed_expr_value_type(iterable)
	item ?= concurrent_for_item(iterable_type)
	lowered_iterable ?= lower_typed_expr(iterable)
	lowered_body ?= lower_typed_expr(body)
	body_type ?= compiler_core_lower_value_type(compiler_typed_expr_value_type(body))
	lowered_params ?= lower_typed_concurrent_for_params(params, loc)
	loop: CorePreClosureConcurrentlyLoop = {
		variable = core_var(name.text, None),
		item_type = item.item_type,
		item_mode = item.item_mode,
		iterable = lowered_iterable,
		body = discard_concurrent_for_body_if_needed(lowered_body, body_type, loc),
		timeout = lowered_params.timeout,
		limit = lowered_params.limit,
		output = ConcurrentlyLoopDiscard
	}
	Ok(PreClosureConcurrentlyLoopExpr(loop, typ, loc))


private pure func lower_user_call_kind(
	info: CompilerResolvedCallInfo,
	callable_id: Int,
	callee: CoreExpr,
) -> Result[CoreCallKind, CompilerCoreLowerError]:
	match callee:
		VarExpr(variable, _, _):
			match variable.def_id:
				Some(existing_id):
					if existing_id == callable_id:
						Ok(SelectedDirectCall(callable_id))
					else:
						Err(
							CompilerCoreLowerInvalidCall(
								"conflicting callable ids for " + info.callee_name + ": callee carried " + existing_id.to_string() + " but resolved_call carried " + callable_id.to_string(),
							),
						)
				None:
					Ok(SelectedDirectCall(callable_id))
		_:
			Ok(UnknownCall)


private pure func lower_builtin_call_kind(info: CompilerResolvedCallInfo) -> CoreCallKind:
	if info.source_name == TO_STRING_BUILTIN_NAME:
		BuiltinCall(TO_STRING_CORE_SENTINEL)
	else:
		UnknownCall


private pure func lower_resolved_call_kind(
	resolved: Option[CompilerResolvedCallInfo],
	callee: CoreExpr,
) -> Result[CoreCallKind, CompilerCoreLowerError]:
	match resolved:
		Some(info):
			match info.target:
				CompilerResolvedDirectCall(callable_id, origin):
					match origin:
						CompilerCallableLocal:
							lower_user_call_kind(info, callable_id, callee)
						CompilerCallableBuiltin:
							Ok(lower_builtin_call_kind(info))
						CompilerCallableImported(_):
							lower_user_call_kind(info, callable_id, callee)
						CompilerCallableConstructor(_):
							Ok(UnknownCall)
						CompilerCallableImplMethod:
							lower_user_call_kind(info, callable_id, callee)
						CompilerCallableForeign:
							Ok(UnknownCall)
				CompilerResolvedTraitMethodCall(trait_name, impl_target):
					match impl_target:
						Some(target):
							Ok(
								SelectedTraitCall(
									trait_name,
									info.callee_name,
									target.module_path,
									target.callable_id,
								),
							)
						None:
							Ok(DeferredTraitCall(trait_name, info.callee_name))
				CompilerResolvedIntrinsicCall:
					if info.source_name == "type_name" or info.source_name == "is_heap":
						Ok(IntrinsicCall(info.source_name))
					else:
						Ok(UnknownCall)
				CompilerResolvedClosureCall:
					Ok(UnknownCall)
		None:
			Ok(UnknownCall)


private pure func lower_question_bind_success_type(
	rhs_type: CoreType,
) -> Result[CoreType, CompilerCoreLowerError]:
	success_type ?= core_carrier_success_type(rhs_type)
	Ok(clone_core_type(success_type))


private pure func lower_question_bind_success_case(
	name: ParsedIdentifier,
	success_type: CoreType,
	kind: CompilerCoreLowerCarrierKind,
	rhs_type: CoreType,
	success_body: CoreExpr,
) -> Result[CoreConstructorMatchCase, CompilerCoreLowerError]:
	test ?= carrier_success_test(kind, rhs_type)
	accessor ?= carrier_success_accessor(kind, rhs_type)

	constructor: String = match kind:
		CompilerCoreLowerOptionCarrier:
			"Some"
		CompilerCoreLowerResultCarrier:
			"Ok"

	Ok({
		constructor = constructor,
		accessor = RootAccessor,
		test = test,
		bindings = [
			{
				variable = core_var(name.text, None),
				typ = success_type,
				accessor = clone_core_accessor(accessor),
				mode = MatchBorrowBindingMode
			},
		],
		body = ConstructorMatchBodyExpr(success_body),
	})


private pure func lower_question_bind_failure_case(
	kind: CompilerCoreLowerCarrierKind,
	rhs_type: CoreType,
	block_type: CoreType,
	span: CompilerSourceSpan,
	loc: CoreSourceLoc,
) -> Result[CoreConstructorMatchCase, CompilerCoreLowerError]:
	test ?= carrier_failure_test(kind, rhs_type)

	constructor: String = match kind:
		CompilerCoreLowerOptionCarrier:
			"None"
		CompilerCoreLowerResultCarrier:
			"Err"

	failure_var = core_var(
		question_bind_name("failure", span),
		None,
	)

	failure_type ?= match kind:
		CompilerCoreLowerOptionCarrier:
			Ok(VoidType)
		CompilerCoreLowerResultCarrier:
			match core_carrier_failure_type(rhs_type):
				Ok(result_type):
					Ok(clone_core_type(result_type))
				Err(error):
					Err(error)

	failure_bindings ?= match kind:
		CompilerCoreLowerOptionCarrier:
			bindings: List[CoreMatchBinding] = []
			Ok(bindings)
		CompilerCoreLowerResultCarrier:
			match carrier_failure_accessor(kind, rhs_type):
				Ok(accessor):
					Ok(
						[
							{
								variable = clone_core_var(failure_var),
								typ = clone_core_type(failure_type),
								accessor = clone_core_accessor(accessor),
								mode = MatchBorrowBindingMode
							},
						],
					)
				Err(err):
					Err(err)

	Ok({
		constructor = constructor,
		accessor = RootAccessor,
		test = test,
		bindings = failure_bindings,
		body = ConstructorMatchBodyExpr(
			carrier_failure_expr(
				kind,
				clone_core_type(block_type),
				failure_var,
				failure_type,
				clone_core_source_loc(loc),
			),
		),
	})


private pure func lower_typed_question_bind(
	name: ParsedIdentifier,
	rhs: CompilerTypedExpr,
	span: CompilerSourceSpan,
	rest: List[CompilerTypedExpr],
	block_type: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CompilerCoreLowerError]:
	if rest.length() == 0:
		Err(
			CompilerCoreLowerInvalidType(
				"EQuestionBind reached lowering without a success continuation",
			),
		)
	else:
		block_kind ?= core_carrier_kind(block_type)
		lowered_rhs ?= lower_typed_expr(rhs)
		rhs_type ?= compiler_core_lower_value_type(compiler_typed_expr_value_type(rhs))
		rhs_kind ?= core_carrier_kind(rhs_type)

		if block_kind != rhs_kind:
			Err(
				CompilerCoreLowerInvalidType(
					"?= carrier kind changed between inference and lowering",
				),
			)
		else:
			success_type ?= lower_question_bind_success_type(clone_core_type(rhs_type))
			success_body ?= lower_typed_block_expr(
				rest,
				clone_core_type(block_type),
				clone_core_source_loc(loc),
			)
			success_case ?= lower_question_bind_success_case(
				name,
				success_type,
				rhs_kind,
				clone_core_type(rhs_type),
				success_body,
			)
			failure_case ?= lower_question_bind_failure_case(
				rhs_kind,
				clone_core_type(rhs_type),
				clone_core_type(block_type),
				span,
				clone_core_source_loc(loc),
			)
			tmp_var = core_var(
				question_bind_name("value", span),
				None,
			)
			tmp_ref = VarExpr(
				clone_core_var(tmp_var),
				clone_core_type(rhs_type),
				clone_core_source_loc(loc),
			)
			match_expr = ConstructorMatchExpr(
				tmp_ref,
				NoReleasePolicy,
				[success_case, failure_case],
				ConstructorMatchFallbackFail,
				clone_core_type(block_type),
				clone_core_source_loc(loc),
			)

			Ok(
				LetExpr(
					clone_core_var(tmp_var),
					False,
					clone_core_type(rhs_type),
					lowered_rhs,
					match_expr,
				),
			)


private pure func with_resource_name(binding: CompilerTypedWithBinding) -> String:
	if binding.name.text == "_":
		question_bind_name("resource", binding.span)
	else:
		binding.name.text


private pure func with_resource_type(
	is_try: Bool,
	acquisition_type: CoreType,
) -> Result[CoreType, CompilerCoreLowerError]:
	if is_try:
		match core_carrier_success_type(acquisition_type):
			Ok(resource_type):
				Ok(clone_core_type(resource_type))
			Err(error):
				Err(error)
	else:
		Ok(clone_core_type(acquisition_type))


private pure func resource_cleanup_call(
	binding: CompilerTypedWithBinding,
	resource_var: CoreVar,
	resource_type: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	resource_ref = VarExpr(
		clone_core_var(resource_var),
		clone_core_type(resource_type),
		clone_core_source_loc(loc),
	)

	match binding.cleanup_function:
		Some(cleanup_function):
			builtin_core_call(
				cleanup_function,
				[resource_ref],
				VoidType,
				clone_core_source_loc(loc),
			)
		None:
			CallExpr(
				UnknownCall,
				VarExpr(
					core_var("close", None),
					NamedType("Closure", []),
					clone_core_source_loc(loc),
				),
				[resource_ref],
				VoidType,
				clone_core_source_loc(loc),
			)


private pure func resource_scope_expr(
	binding: CompilerTypedWithBinding,
	resource_type: CoreType,
	acquire: CoreExpr,
	body: CoreExpr,
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	resource_var = core_var(with_resource_name(binding), None)
	scope: CoreResourceScope = {
		variable = clone_core_var(resource_var),
		typ = clone_core_type(resource_type),
		acquire = acquire,
		body = body,
		cleanup = resource_cleanup_call(
			binding,
			resource_var,
			clone_core_type(resource_type),
			clone_core_source_loc(loc),
		)
	}
	ResourceScopeExpr(scope, result_type, loc)


private pure func lower_with_mapped_failure_case(
	mapper: CompilerTypedWithErrorMap,
	kind: CompilerCoreLowerCarrierKind,
	acquisition_type: CoreType,
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreConstructorMatchCase, CompilerCoreLowerError]:
	test ?= carrier_failure_test(kind, acquisition_type)
	failure_type ?= core_carrier_failure_type(acquisition_type)
	accessor ?= carrier_failure_accessor(kind, acquisition_type)
	mapped_error ?= lower_typed_expr(mapper.value)

	failure_var = if mapper.name.text == "_":
		core_var(
			question_bind_name("with_failure", mapper.span),
			None,
		)
	else:
		core_var(mapper.name.text, None)

	Ok({
		constructor = "Err",
		accessor = RootAccessor,
		test = test,
		bindings = [
			{
				variable = failure_var,
				typ = clone_core_type(failure_type),
				accessor = clone_core_accessor(accessor),
				mode = MatchBorrowBindingMode
			},
		],
		body = ConstructorMatchBodyExpr(
			builtin_core_call(
				"blorp_result_err",
				[mapped_error],
				result_type,
				loc,
			),
		),
	})


private pure func lower_with_failure_case(
	binding: CompilerTypedWithBinding,
	kind: CompilerCoreLowerCarrierKind,
	acquisition_type: CoreType,
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreConstructorMatchCase, CompilerCoreLowerError]:
	match binding.error_map:
		None:
			lower_question_bind_failure_case(kind, acquisition_type, result_type, binding.span, loc)
		Some(mapper):
			match kind:
				CompilerCoreLowerOptionCarrier:
					Err(
						CompilerCoreLowerInvalidType(
							"with ?= error mapping reached lowering for Option",
						),
					)
				CompilerCoreLowerResultCarrier:
					lower_with_mapped_failure_case(mapper, kind, acquisition_type, result_type, loc)


private pure func lower_typed_with(
	binding: CompilerTypedWithBinding,
	body: CompilerTypedExpr,
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CompilerCoreLowerError]:
	acquisition ?= lower_typed_expr(binding.value)
	acquisition_type ?= compiler_core_lower_value_type(
		compiler_typed_expr_value_type(binding.value),
	)
	is_try = compiler_typed_with_binding_is_try(binding)
	resource_type ?= with_resource_type(is_try, clone_core_type(acquisition_type))
	lowered_body ?= lower_typed_expr(body)

	if is_try:
		acquisition_kind ?= core_carrier_kind(acquisition_type)
		result_kind ?= core_carrier_kind(result_type)

		if acquisition_kind != result_kind:
			Err(
				CompilerCoreLowerInvalidType(
					"with ?= carrier kind changed between inference and lowering",
				),
			)
		else:
			payload_name: ParsedIdentifier = {
				text = question_bind_name("with_payload", binding.span),
				span = binding.span
			}
			payload_var = core_var(payload_name.text, None)
			payload_ref = VarExpr(
				clone_core_var(payload_var),
				clone_core_type(resource_type),
				clone_core_source_loc(loc),
			)
			success_scope = resource_scope_expr(
				binding,
				clone_core_type(resource_type),
				payload_ref,
				lowered_body,
				clone_core_type(result_type),
				clone_core_source_loc(loc),
			)
			success_case ?= lower_question_bind_success_case(
				payload_name,
				clone_core_type(resource_type),
				acquisition_kind,
				clone_core_type(acquisition_type),
				success_scope,
			)
			failure_case ?= lower_with_failure_case(
				binding,
				acquisition_kind,
				clone_core_type(acquisition_type),
				clone_core_type(result_type),
				clone_core_source_loc(loc),
			)
			temp_var = core_var(
				question_bind_name("with_value", binding.span),
				None,
			)
			temp_ref = VarExpr(
				clone_core_var(temp_var),
				clone_core_type(acquisition_type),
				clone_core_source_loc(loc),
			)
			match_expr = ConstructorMatchExpr(
				temp_ref,
				NoReleasePolicy,
				[success_case, failure_case],
				ConstructorMatchFallbackFail,
				clone_core_type(result_type),
				clone_core_source_loc(loc),
			)

			Ok(LetExpr(temp_var, False, acquisition_type, acquisition, match_expr))
	else:
		Ok(resource_scope_expr(binding, resource_type, acquisition, lowered_body, result_type, loc))


private pure func lower_tuple_destruct_bindings(
	names: List[ParsedIdentifier],
	index: Int,
	tuple_ref: CoreExpr,
	field_types: List[CoreType],
	body: CoreExpr,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CompilerCoreLowerError]:
	match names.get(index):
		None:
			Ok(body)
		Some(name):
			field_type ?= match field_types.get(index):
				Some(typ):
					Ok(typ)
				None:
					Err(
						CompilerCoreLowerInvalidType(
							"tuple destructure field type missing at index " + index.to_string(),
						),
					)

			inner ?= lower_tuple_destruct_bindings(
				names,
				index + 1,
				tuple_ref,
				field_types,
				body,
				loc,
			)

			if name.text == "_":
				Ok(inner)
			else:
				Ok(
					LetExpr(
						core_var(name.text, None),
						False,
						field_type,
						TupleFieldExpr(tuple_ref, index, field_type, loc),
						inner,
					),
				)


private pure func lower_typed_tuple_destruct(
	names: List[ParsedIdentifier],
	value: CompilerTypedExpr,
	span: CompilerSourceSpan,
	rest: List[CompilerTypedExpr],
	block_type: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CompilerCoreLowerError]:
	lowered_value ?= lower_typed_expr(value)
	value_type ?= compiler_core_lower_value_type(compiler_typed_expr_value_type(value))

	field_types ?= match value_type:
		TupleType(items):
			if items.length() == names.length():
				Ok(items)
			else:
				Err(CompilerCoreLowerInvalidType("tuple destructure has " + names
							.length()
							.to_string() + " names but tuple type has " + items
							.length()
							.to_string() + " fields"))
		_:
			Err(CompilerCoreLowerInvalidType("tuple destructure value must have tuple type"))

	body ?= lower_typed_block_expr(rest, block_type, loc)
	temp_var = core_var(tuple_destruct_name(span), None)
	temp_ref = VarExpr(temp_var, value_type, loc)
	body_with_bindings ?= lower_tuple_destruct_bindings(names, 0, temp_ref, field_types, body, loc)

	Ok(LetExpr(temp_var, False, value_type, lowered_value, body_with_bindings))


private pure func lower_typed_block_expr(
	items: List[CompilerTypedExpr],
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Result[CoreExpr, CompilerCoreLowerError]:
	match items.get(0):
		None:
			Ok(VoidExpr(typ, loc))
		Some(first):
			rest: List[CompilerTypedExpr] = items.tail()
			first_loc: CoreSourceLoc = compiler_core_source_loc(typed_expr_span(first))

			match first:
				CompilerTypedVarDeclExpr(payload, _):
					lowered_init ?= lower_typed_expr(payload.initializer)
					-- Typechecking has already validated any source annotation.
					-- The initializer's value type carries the resolved module
					-- identity and widening decision that Core must preserve.
					bind_type ?= compiler_core_lower_value_type(
						compiler_typed_expr_value_type(payload.initializer),
					)
					body ?= lower_typed_block_expr(
						rest,
						typ,
						compiler_core_source_loc(payload.span),
					)

					Ok(
						LetExpr(
							core_var(payload.name.text, None),
							payload.is_mutable,
							bind_type,
							lowered_init,
							body,
						),
					)
				CompilerTypedQuestionBindExpr(name, _, value, span, _):
					lower_typed_question_bind(name, value, span, rest, typ, first_loc)
				CompilerTypedTupleDestructExpr(names, value, span, _):
					lower_typed_tuple_destruct(names, value, span, rest, typ, first_loc)
				CompilerTypedConcurrentBlockExpr(params, bindings, _, _):
					body ?= if rest.length() == 0:
						Ok(VoidExpr(typ, loc))
					else:
						lower_typed_block_expr(rest, typ, first_loc)

					lower_typed_concurrent_block(params, bindings, body, typ, first_loc)
				_:
					lowered_first ?= lower_typed_expr(first)

					if rest.length() == 0:
						Ok(lowered_first)
					else:
						lowered_rest ?= lower_typed_block_expr(rest, typ, loc)
						Ok(SeqExpr(lowered_first, lowered_rest))


pure func lower_typed_expr(expr: CompilerTypedExpr) -> Result[CoreExpr, CompilerCoreLowerError]:
	typ ?= compiler_core_lower_value_type(compiler_typed_expr_value_type(expr))

	lower_typed_expr_as_type(expr, typ)


private pure func lower_typed_expr_as_type(
	expr: CompilerTypedExpr,
	typ: CoreType,
) -> Result[CoreExpr, CompilerCoreLowerError]:
	loc: CoreSourceLoc = compiler_core_source_loc(typed_expr_span(expr))

	match expr:
		CompilerTypedNameExpr(name, info):
			identity ?= lower_name_expr_identity(name, info)
			(clean_name, def_id) = identity
			Ok(VarExpr(core_var(clean_name, def_id), typ, loc))
		CompilerTypedIntLiteralExpr(text, _, _):
			Ok(LiteralExpr(compiler_core_literal_int(text), typ, loc))
		CompilerTypedFloatLiteralExpr(text, _, _):
			Ok(LiteralExpr(FloatTextLiteral(text), typ, loc))
		CompilerTypedStringLiteralExpr(text, _, _):
			Ok(LiteralExpr(StringLiteral(text), typ, loc))
		CompilerTypedStringInterpolationExpr(_, _, _, _):
			Err(
				CompilerCoreLowerUnsupported(
					"raw string interpolation reached Core lowering before interpolation parsing",
				),
			)
		CompilerTypedStringInterpolationPartsExpr(parts, _, _, _):
			lower_string_interpolation(parts, loc)
		CompilerTypedBoolLiteralExpr(value, _, _):
			Ok(LiteralExpr(BoolLiteral(value), typ, loc))
		CompilerTypedCharLiteralExpr(value, _, _):
			Ok(LiteralExpr(CharLiteral(value), typ, loc))
		CompilerTypedVoidExpr(_, _):
			Ok(VoidExpr(typ, loc))
		CompilerTypedBreakExpr(_, _):
			Ok(BreakExpr(typ, loc))
		CompilerTypedContinueExpr(_, _):
			Ok(ContinueExpr(typ, loc))
		CompilerTypedAscriptionExpr(inner, _, _, _):
			lower_typed_expr(inner)
		CompilerTypedOpaqueIntoExpr(_, inner, _, _):
			lower_typed_expr(inner)
		CompilerTypedOpaqueFromExpr(_, inner, _, _):
			lower_typed_expr_as_type(inner, typ)
		CompilerTypedAssignExpr(name, _, value, _, _):
			lowered_value ?= lower_typed_expr(value)
			Ok(AssignExpr(core_var(name.text, None), lowered_value, typ, loc))
		CompilerTypedUnaryExpr(op, inner, _, _):
			lowered_inner ?= lower_typed_expr(inner)
			Ok(UnaryExpr(compiler_core_unary_op(op), lowered_inner, typ, loc))
		CompilerTypedBinaryExpr(op, left, right, _, _):
			lowered_left ?= lower_typed_expr(left)
			lowered_right ?= lower_typed_expr(right)
			Ok(BinaryExpr(compiler_core_binary_op(op), lowered_left, lowered_right, typ, loc))
		CompilerTypedLogicalExpr(op, left, right, _, _):
			lowered_left ?= lower_typed_expr(left)
			lowered_right ?= lower_typed_expr(right)
			Ok(LogicalExpr(compiler_core_logical_op(op), lowered_left, lowered_right, typ, loc))
		CompilerTypedCallExpr(callee, args, _, info):
			raw_callee ?= lower_typed_expr(callee)
			lowered_callee: CoreExpr = apply_resolved_callee_identity(
				info.resolved_call,
				raw_callee,
			)
			lowered_args ?= lower_typed_exprs(args)
			call_kind ?= lower_resolved_call_kind(info.resolved_call, lowered_callee)
			Ok(CallExpr(call_kind, lowered_callee, lowered_args, typ, loc))
		CompilerTypedTupleExpr(items, _, _):
			lowered_items ?= lower_typed_exprs(items)
			Ok(TupleExpr(lowered_items, typ, loc))
		CompilerTypedListExpr(items, _, _):
			lowered_items ?= lower_typed_list_items(items)
			construct: CoreListConstruct = {
				layout = PointerListStorage,
				elements = lowered_items,
				elem_needs_release = lowered_items.any(
					pure func(item: CoreBoxedStorageValue): item.needs_release,
				)
			}
			Ok(ListConstructExpr(construct, typ, loc))
		CompilerTypedVectorExpr(items, _, _):
			lowered_items ?= lower_typed_exprs(items)
			Ok(VectorExpr(lowered_items, typ, loc))
		CompilerTypedDictExpr(entries, _, _):
			lowered_entries ?= lower_typed_dict_entries(entries)
			Ok(DictExpr(lowered_entries, typ, loc))
		CompilerTypedFieldAccessExpr(receiver, field, _, _):
			lower_typed_field_access(receiver, field, typ, loc)
		CompilerTypedRangeExpr(start_expr, end_expr, _, _):
			lowered_start ?= lower_typed_expr(start_expr)
			lowered_end ?= lower_typed_expr(end_expr)
			Ok(RangeExpr(lowered_start, lowered_end, typ, loc))
		CompilerTypedRecordExpr(fields, _, _):
			lowered_fields ?= lower_typed_record_fields(fields)
			Ok(RecordExpr(lowered_fields, typ, loc))
		CompilerTypedRecordUpdateExpr(receiver, updates, record_fields, span, _):
			lower_typed_record_update(receiver, updates, record_fields, span, typ, loc)
		CompilerTypedIfExpr(condition, then_branch, else_branch, _, _):
			lowered_condition ?= lower_typed_expr(condition)
			lowered_then ?= lower_typed_expr(then_branch)

			lowered_else ?= match else_branch:
				Some(branch):
					lower_typed_expr(branch)
				None:
					Ok(VoidExpr(typ, loc))

			Ok(IfExpr(lowered_condition, lowered_then, lowered_else, typ, loc))
		CompilerTypedMatchExpr(scrutinee, cases, _, _):
			lowered_scrutinee ?= lower_typed_expr(scrutinee)
			lowered_cases ?= lower_raw_match_cases(cases)
			Ok(RawMatchExpr(lowered_scrutinee, lowered_cases, typ, loc))
		CompilerTypedSelectExpr(arms, _, _):
			lowered_arms ?= lower_typed_select_arms(arms)
			Ok(SelectExpr(lowered_arms, typ, loc))
		CompilerTypedLambdaExpr(is_pure, params, _, body, _, _):
			lowered_params ?= lower_typed_lambda_params(params)
			lowered_return_type ?= compiler_core_lower_value_type(
				compiler_typed_expr_value_type(body),
			)
			lowered_body ?= lower_typed_expr(body)
			Ok(LambdaExpr(lowered_params, lowered_return_type, lowered_body, is_pure, typ, loc))
		CompilerTypedBlockExpr(items, _, _):
			lower_typed_block_expr(items, typ, loc)
		CompilerTypedDebugBlockExpr(body, _, _):
			lowered_body ?= lower_typed_expr(body)
			Ok(DebugBlockExpr(lowered_body, typ, loc))
		CompilerTypedWithExpr(binding, body, _, _):
			lower_typed_with(binding, body, typ, loc)
		CompilerTypedWhileExpr(condition, body, _, _):
			lowered_condition ?= lower_typed_expr(condition)
			lowered_body ?= lower_typed_expr(body)
			Ok(WhileExpr(lowered_condition, lowered_body, typ, loc))
		CompilerTypedDetachExpr(body, _, _):
			lowered_body ?= lower_typed_expr(body)
			Ok(PreClosureDetachExpr(lowered_body, typ, loc))
		CompilerTypedForExpr(binder, iterable, loop_view, body, _, _):
			lower_typed_for(binder, iterable, loop_view, body, typ, loc)
		CompilerTypedConcurrentBlockExpr(params, bindings, _, _):
			lower_typed_concurrent_block(
				params,
				bindings,
				VoidExpr(typ, loc),
				typ,
				loc,
			)
		CompilerTypedConcurrentForExpr(name, iterable, params, body, _, _):
			lower_typed_concurrent_for(name, iterable, params, body, typ, loc)
		CompilerTypedVarDeclExpr(_, _):
			lower_typed_block_expr([expr], typ, loc)
		_:
			Err(CompilerCoreLowerUnsupported(typed_expr_label(expr)))


private pure func compiler_core_type_param_names(params: List[ParsedTypeParamDecl]) -> List[String]:
	params.map(func(param: ParsedTypeParamDecl): param.name.text)


private pure func compiler_core_lower_param(
	param: ParsedParam,
	param_type: CompilerType,
	index: Int,
) -> Result[CompilerCoreLowerParamResult, CompilerCoreLowerError]:
	typ ?= compiler_core_lower_value_type(param_type)

	match param.binder:
		ParsedParamNameBinder(name):
			Ok({
				param = {
					name = core_var(name.text, None),
					typ = typ,
					loc = compiler_core_source_loc(name.span)
				},
				destructure = None,
			})
		ParsedParamWildcardBinder(span):
			Ok({
				param = {
					name = core_var(
						"__pattern_param_${index}_${span.start_line}_${span.start_column}",
						None,
					),
					typ = typ,
					loc = compiler_core_source_loc(span)
				},
				destructure = None,
			})
		ParsedParamTupleBinder(names, span):
			match typ:
				TupleType(field_types):
					if field_types.length() != names.length():
						Err(
							CompilerCoreLowerInvalidParam(
								"tuple parameter has ${names.length()} names but its type has " + "${field_types.length()} fields",
							),
						)
					else:
						lowered_param: CoreParam = {
							name = core_var(
								"__pattern_param_${index}_${span.start_line}_${span.start_column}",
								None,
							),
							typ = typ,
							loc = compiler_core_source_loc(span)
						}
						Ok({
							param = lowered_param,
							destructure = Some({
								param = lowered_param,
								names = names,
							}),
						})
				_:
					Err(
						CompilerCoreLowerInvalidParam(
							"tuple parameter requires a tuple type, got " + compiler_type_to_string(
								param_type,
							),
						),
					)


private pure func compiler_core_lower_params(
	params: List[ParsedParam],
	param_types: List[CompilerType],
) -> Result[CompilerCoreLowerParams, CompilerCoreLowerError]:
	if params.length() != param_types.length():
		Err(CompilerCoreLowerInvalidParam("function parameter count " + params
					.length()
					.to_string() + " does not match typed parameter count " + param_types
					.length()
					.to_string()))
	else:
		var lowered: List[CoreParam] = []
		var destructures: List[CompilerCoreLowerParamDestructure] = []
		var index: Int = 0
		var failure: Option[CompilerCoreLowerError] = None

		while index < params.length() and failure.is_none():
			match (params.get(index), param_types.get(index)):
				(Some(param), Some(param_type)):
					match compiler_core_lower_param(param, param_type, index):
						Ok(lowered_param):
							lowered = lowered.append(lowered_param.param)

							match lowered_param.destructure:
								Some(destructure):
									destructures = destructures.append(destructure)
								None:
									void
						Err(error):
							failure = Some(error)
				_:
					failure = Some(
						CompilerCoreLowerInvalidParam(
							"function parameter metadata is missing at index " + index.to_string(),
						),
					)

			index += 1

		match failure:
			Some(error):
				Err(error)
			None:
				Ok({
					params = lowered,
					destructures = destructures,
				})


private pure func lower_param_destructures(
	destructures: List[CompilerCoreLowerParamDestructure],
	index: Int,
	body: CoreExpr,
) -> Result[CoreExpr, CompilerCoreLowerError]:
	match destructures.get(index):
		None:
			Ok(body)
		Some(destructure):
			inner ?= lower_param_destructures(destructures, index + 1, body)

			match destructure.param.typ:
				TupleType(field_types):
					lower_tuple_destruct_bindings(
						destructure.names,
						0,
						VarExpr(
							destructure.param.name,
							destructure.param.typ,
							destructure.param.loc,
						),
						field_types,
						inner,
						destructure.param.loc,
					)
				_:
					Err(
						CompilerCoreLowerInvalidParam(
							"validated tuple parameter lost its tuple type during lowering",
						),
					)


private pure func lower_typed_function_body(
	info: CompilerTypedFunctionInfo,
	params: CompilerCoreLowerParams,
	return_type: CoreType,
) -> Result[CompilerCoreLowerFunctionBody, CompilerCoreLowerError]:
	match parsed_function_body_kind(info.decl.body):
		ParsedFunctionSourceBody:
			match info.body:
				Some(body):
					match lower_typed_expr(body):
						Ok(lowered_body):
							wrapped_body ?= lower_param_destructures(
								params.destructures,
								0,
								lowered_body,
							)
							Ok(CompilerCoreLowerUserFunctionBody(wrapped_body))
						Err(error):
							Err(error)
				None:
					Err(
						CompilerCoreLowerUnsupported(
							"typed source function has no body: " + info.decl.name.text,
						),
					)
		ParsedFunctionForwardDecl:
			if info.body.is_some():
				Err(
					CompilerCoreLowerUnsupported(
						"forward function has a typed body: " + info.decl.name.text,
					),
				)
			else:
				Ok(CompilerCoreLowerForwardDeclaration)
		ParsedFunctionBuiltinBody(name):
			if info.body.is_some():
				Err(
					CompilerCoreLowerUnsupported(
						"builtin function has a typed body: " + info.decl.name.text,
					),
				)
			else:
				match name:
					None:
						Ok(CompilerCoreLowerBuiltinDeclaration)
					Some(builtin_name):
						if builtin_name.starts_with("std/"):
							Ok(CompilerCoreLowerBuiltinDeclaration)
						else:
							Ok(
								lower_runtime_helper_body(
									builtin_name,
									params.params,
									return_type,
									compiler_core_source_loc(info.decl.span),
								),
							)


private pure func lower_typed_function_info(
	context: CompilerCoreLowerContext,
	info: CompilerTypedFunctionInfo,
) -> Result[CompilerCoreLowerFunctionResult, CompilerCoreLowerError]:
	params ?= compiler_core_lower_params(info.decl.params, info.param_types)
	return_type ?= compiler_core_lower_value_type(info.semantic_return_type)
	lowered_function_body ?= lower_typed_function_body(info, params, clone_core_type(return_type))

	body: Option[CoreExpr] = match lowered_function_body:
		CompilerCoreLowerUserFunctionBody(lowered_body):
			Some(lowered_body)
		CompilerCoreLowerForwardDeclaration:
			None
		CompilerCoreLowerBuiltinDeclaration:
			None

	function_kind: CoreFunctionKind = lowered_function_kind(lowered_function_body)

	(next_context, def_id) = match info.callable_id:
		Some(callable_id):
			(context, callable_id)
		None:
			mint_def_id(context)

	Ok({
		context = next_context,
		function_info = {
			name = info.decl.name.text,
			source_module = context.source_module,
			type_params = info.effective_type_params.map(pure func(param): param.name),
			params = params.params,
			return_type = return_type,
			body = body,
			is_pure = info.decl.is_pure,
			function_kind = function_kind,
			def_id = def_id,
			loc = compiler_core_source_loc(info.decl.span)
		},
	})


private pure func lower_typed_function(
	context: CompilerCoreLowerContext,
	info: CompilerTypedFunctionInfo,
) -> Result[CompilerCoreLowerDeclResult, CompilerCoreLowerError]:
	result ?= lower_typed_function_info(context, info)
	Ok({
		context = result.context,
		decl = FunctionDecl(result.function_info),
	})


private pure func lower_typed_foreign_function(
	context: CompilerCoreLowerContext,
	info: CompilerTypedForeignFunctionInfo,
) -> Result[CompilerCoreLowerDeclResult, CompilerCoreLowerError]:
	params ?= compiler_core_lower_params(info.decl.params, info.param_types)
	return_type ?= compiler_core_lower_value_type(info.semantic_return_type)

	(next_context, def_id) = match info.callable_id:
		Some(callable_id):
			(context, callable_id)
		None:
			mint_def_id(context)

	arg_passing: CoreForeignArgPassing = if compiler_typed_foreign_arg_passing_borrows(
		info.arg_passing,
	):
		ForeignBorrowArgs
	else:
		ForeignDefaultArgs([])

	link_flags: List[CoreForeignLinkFlag] = info.link_flags.map(
		pure func(link_flag: CompilerTypedForeignLinkFlag) -> CoreForeignLinkFlag: {
			platform = link_flag.platform.map(compiler_typed_foreign_link_platform_to_string),
			flag = link_flag.flag
		},
	)

	Ok({
		context = next_context,
		decl = FunctionDecl({
			name = info.decl.name.text,
			source_module = context.source_module,
			type_params = [],
			params = params.params,
			return_type = return_type,
			body = None,
			is_pure = info.decl.is_pure,
			function_kind = ForeignFunction({
				c_name = info.c_name,
				includes = info.includes,
				link_flags = link_flags,
				arg_passing = arg_passing,
			}),
			def_id = def_id,
			loc = compiler_core_source_loc(info.decl.span),
		}),
	})


private pure func lower_typed_global(
	context: CompilerCoreLowerContext,
	info: CompilerTypedGlobalVarInfo,
	is_private: Bool,
) -> Result[CompilerCoreLowerDeclResult, CompilerCoreLowerError]:
	(next_context, def_id) = mint_def_id(context)
	init ?= lower_typed_expr(info.value)
	typ ?= compiler_core_lower_value_type(info.binding_type)

	Ok({
		context = next_context,
		decl = GlobalDecl({
			name = core_var(info.decl.name.text, Some(def_id)),
			source_module = context.source_module,
			typ = typ,
			init = init,
			is_mutable = info.decl.is_mutable,
			is_const = not info.decl.is_mutable,
			is_private = is_private,
			def_id = def_id,
			loc = compiler_core_source_loc(info.decl.span),
		}),
	})


private pure func lower_value_record_field(
	field: CompilerTypedRecordFieldInfo,
) -> Result[CoreValueRecordField, CompilerCoreLowerError]:
	typ ?= compiler_core_lower_type(field.semantic_type)
	Ok({
		name = field.name,
		typ = typ,
	})


private pure func lower_value_record_fields(
	fields: List[CompilerTypedRecordFieldInfo],
) -> Result[List[CoreValueRecordField], CompilerCoreLowerError]:
	var lowered: List[CoreValueRecordField] = []
	var failure: Option[CompilerCoreLowerError] = None

	for field in fields:
		if failure.is_none():
			match lower_value_record_field(field):
				Ok(lowered_field):
					lowered = lowered.append(lowered_field)
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func lower_heap_record_field(
	field: CompilerTypedRecordFieldInfo,
) -> Result[CoreHeapRecordField, CompilerCoreLowerError]:
	typ ?= compiler_core_lower_type(field.semantic_type)
	Ok({
		name = field.name,
		typ = typ,
		release_policy = CoreTypePolicy.cleanup_release_policy_for_type(typ),
	})


private pure func lower_heap_record_fields(
	fields: List[CompilerTypedRecordFieldInfo],
) -> Result[List[CoreHeapRecordField], CompilerCoreLowerError]:
	var lowered: List[CoreHeapRecordField] = []
	var failure: Option[CompilerCoreLowerError] = None

	for field in fields:
		if failure.is_none():
			match lower_heap_record_field(field):
				Ok(lowered_field):
					lowered = lowered.append(lowered_field)
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func lower_typed_record(
	context: CompilerCoreLowerContext,
	info: CompilerTypedRecordInfo,
) -> Result[CompilerCoreLowerDeclResult, CompilerCoreLowerError]:
	if info.decl.is_struct:
		fields ?= lower_value_record_fields(info.fields)
		Ok({
			context = context,
			decl = ValueRecordDecl({
				name = info.decl.name.text,
				type_params = compiler_core_type_param_names(info.decl.type_params),
				fields = fields,
				loc = compiler_core_source_loc(info.decl.span),
			}),
		})
	else:
		fields ?= lower_heap_record_fields(info.fields)
		Ok({
			context = context,
			decl = HeapRecordDecl({
				name = info.decl.name.text,
				type_params = compiler_core_type_param_names(info.decl.type_params),
				fields = fields,
				loc = compiler_core_source_loc(info.decl.span),
			}),
		})


private pure func constructor_c_name(name: String, def_id: Option[Int]) -> String:
	match def_id:
		Some(id):
			"__def_" + id.to_string() + "_" + name
		None:
			name


private pure func union_variant_tag_c_name(type_name: String, variant_name: String) -> String:
	"TAG_" + type_name + "_" + variant_name


private pure func source_union_typed_payload_field_supported(typ: CompilerType) -> Bool:
	match typ:
		CompilerNamedType(name, args):
			if args.length() != 0:
				False
			else:
				normalized_name = compiler_normalize_type_name(name)

				(
					normalized_name == "Int"
					or normalized_name == "Int8"
					or normalized_name == "Int16"
					or normalized_name == "Int32"
					or normalized_name == "Int64"
					or normalized_name == "Int128"
					or normalized_name == "UInt8"
					or normalized_name == "UInt16"
					or normalized_name == "UInt32"
					or normalized_name == "UInt64"
					or normalized_name == "UInt128"
					or normalized_name == "Float"
					or normalized_name == "Float32"
					or normalized_name == "Float16"
					or normalized_name == "Bool"
					or normalized_name == "Char"
					or normalized_name == "Fixed"
					or normalized_name == "Range"
				)
		CompilerRangeType(_):
			True
		_:
			False


private pure func source_union_typed_payload_supported(
	variants: List[CompilerTypedUnionVariantInfo],
) -> Bool:
	variants.all(func(variant): variant.fields.all(source_union_typed_payload_field_supported))


private pure func lower_union_payload_storage(
	info: CompilerTypedUnionInfo,
) -> CoreUnionPayloadStorage:
	if (
		info.decl.type_params.length() == 0
		and not CoreTypePolicy.is_runtime_erased_union_payload_type_name(info.decl.name.text)
		and source_union_typed_payload_supported(info.variants)
	):
		TypedUnionPayloadStorage
	else:
		ErasedUnionPayloadStorage


private pure func lower_enum_variant(
	variant: CompilerTypedUnionVariantInfo,
) -> Result[CoreEnumVariant, CompilerCoreLowerError]:
	if variant.fields.length() == 0:
		Ok({
			name = variant.name,
			c_name = constructor_c_name(variant.name, variant.def_id),
			tag = variant.tag,
			def_id = variant.def_id,
		})
	else:
		Err(CompilerCoreLowerUnsupported("enum variant payload"))


private pure func lower_enum_variants(
	variants: List[CompilerTypedUnionVariantInfo],
) -> Result[List[CoreEnumVariant], CompilerCoreLowerError]:
	var lowered: List[CoreEnumVariant] = []
	var failure: Option[CompilerCoreLowerError] = None

	for variant in variants:
		if failure.is_none():
			match lower_enum_variant(variant):
				Ok(lowered_variant):
					lowered = lowered.append(lowered_variant)
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func lower_union_field(
	typ: CompilerType,
) -> Result[CoreUnionField, CompilerCoreLowerError]:
	core_type ?= compiler_core_lower_type(typ)

	Ok({
		typ = core_type,
		release_policy = CoreTypePolicy.cleanup_release_policy_for_type(core_type),
	})


private pure func lower_union_fields(
	fields: List[CompilerType],
) -> Result[List[CoreUnionField], CompilerCoreLowerError]:
	var lowered: List[CoreUnionField] = []
	var failure: Option[CompilerCoreLowerError] = None

	for field in fields:
		if failure.is_none():
			match lower_union_field(field):
				Ok(lowered_field):
					lowered = lowered.append(lowered_field)
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func lower_union_variant(
	type_name: String,
	variant: CompilerTypedUnionVariantInfo,
) -> Result[CoreUnionVariant, CompilerCoreLowerError]:
	fields ?= lower_union_fields(variant.fields)

	Ok({
		name = variant.name,
		c_name = constructor_c_name(variant.name, variant.def_id),
		tag_c_name = union_variant_tag_c_name(type_name, variant.name),
		tag = variant.tag,
		fields = fields,
		def_id = variant.def_id,
	})


private pure func lower_union_variants(
	type_name: String,
	variants: List[CompilerTypedUnionVariantInfo],
) -> Result[List[CoreUnionVariant], CompilerCoreLowerError]:
	var lowered: List[CoreUnionVariant] = []
	var failure: Option[CompilerCoreLowerError] = None

	for variant in variants:
		if failure.is_none():
			match lower_union_variant(type_name, variant):
				Ok(lowered_variant):
					lowered = lowered.append(lowered_variant)
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func lower_typed_union(
	context: CompilerCoreLowerContext,
	info: CompilerTypedUnionInfo,
) -> Result[CompilerCoreLowerDeclResult, CompilerCoreLowerError]:
	if info.decl.is_enum:
		variants ?= lower_enum_variants(info.variants)
		Ok({
			context = context,
			decl = EnumDecl({
				name = info.decl.name.text,
				type_params = compiler_core_type_param_names(info.decl.type_params),
				variants = variants,
				loc = compiler_core_source_loc(info.decl.span),
			}),
		})
	else:
		storage = lower_union_payload_storage(info)
		variants ?= lower_union_variants(info.decl.name.text, info.variants)
		Ok({
			context = context,
			decl = UnionDecl({
				name = info.decl.name.text,
				type_params = compiler_core_type_param_names(info.decl.type_params),
				payload_storage = storage,
				variants = variants,
				loc = compiler_core_source_loc(info.decl.span),
			}),
		})


private pure func lower_typed_type_alias(
	context: CompilerCoreLowerContext,
	info: CompilerTypedTypeAliasInfo,
) -> Result[CompilerCoreLowerDeclResult, CompilerCoreLowerError]:
	target ?= compiler_core_lower_type(info.semantic_target_type)

	Ok({
		context = context,
		decl = TypeAliasDecl({
			name = info.decl.name.text,
			type_params = compiler_core_type_param_names(info.decl.type_params),
			target = target,
			is_opaque = info.decl.is_opaque,
			loc = compiler_core_source_loc(info.decl.span),
		}),
	})


private pure func lower_typed_trait_method(
	method: CompilerTypedTraitMethodInfo,
) -> Result[CoreTraitMethod, CompilerCoreLowerError]:
	params ?= compiler_core_lower_params(method.decl.params, method.param_types)
	return_type ?= compiler_core_lower_value_type(method.semantic_return_type)

	Ok({
		name = method.decl.name.text,
		params = params.params,
		return_type = return_type,
		is_pure = method.decl.is_pure,
		loc = compiler_core_source_loc(method.decl.span),
	})


private pure func lower_typed_trait_methods(
	methods: List[CompilerTypedTraitMethodInfo],
) -> Result[List[CoreTraitMethod], CompilerCoreLowerError]:
	match methods:
		[]:
			Ok([])
		[method, ...rest]:
			lowered ?= lower_typed_trait_method(method)
			lowered_rest ?= lower_typed_trait_methods(rest)
			Ok([lowered].concat(lowered_rest))


private pure func lower_typed_trait(
	context: CompilerCoreLowerContext,
	info: CompilerTypedTraitInfo,
) -> Result[CompilerCoreLowerDeclResult, CompilerCoreLowerError]:
	methods ?= lower_typed_trait_methods(info.methods)

	Ok({
		context = context,
		decl = TraitDecl({
			name = info.decl.name.text,
			type_params = compiler_core_type_param_names(info.decl.type_params),
			supertraits = info.decl.supertraits.map(func(name): name.text),
			methods = methods,
			loc = compiler_core_source_loc(info.decl.span),
		}),
	})


private pure func lower_typed_impl_methods_at(
	context: CompilerCoreLowerContext,
	methods: List[CompilerTypedFunctionInfo],
	index: Int,
	lowered: List[CoreFunction],
) -> Result[(CompilerCoreLowerContext, List[CoreFunction]), CompilerCoreLowerError]:
	match methods.get(index):
		Some(method):
			result ?= lower_typed_function_info(context, method)
			lower_typed_impl_methods_at(
				result.context,
				methods,
				index + 1,
				lowered.append(result.function_info),
			)
		None:
			Ok((context, lowered))


private pure func lower_typed_impl(
	context: CompilerCoreLowerContext,
	info: CompilerTypedImplInfo,
) -> Result[CompilerCoreLowerDeclResult, CompilerCoreLowerError]:
	for_type ?= compiler_core_lower_type(info.for_type)
	lowered_methods ?= lower_typed_impl_methods_at(context, info.methods, 0, [])
	(next_context, methods) = lowered_methods

	Ok({
		context = next_context,
		decl = ImplDecl({
			trait_name = info.decl.trait_name.text,
			for_type = for_type,
			type_params = info.type_params.map(pure func(param) -> CoreTypeParam: {
					name = param.name,
					bounds = param.bounds
				}),
			methods = methods,
			loc = compiler_core_source_loc(info.decl.span),
		}),
	})


private pure func lower_typed_decl_with_visibility(
	context: CompilerCoreLowerContext,
	decl: CompilerTypedDecl,
	is_private: Bool,
) -> Result[CompilerCoreLowerDeclResult, CompilerCoreLowerError]:
	match decl:
		CompilerTypedFunctionDecl(info):
			lower_typed_function(context, info)
		CompilerTypedForeignFunctionDecl(info):
			lower_typed_foreign_function(context, info)
		CompilerTypedGlobalVarDecl(info):
			lower_typed_global(context, info, is_private)
		CompilerTypedPrivateDecl(inner):
			lower_typed_decl_with_visibility(context, inner, True)
		CompilerTypedRecordDecl(info):
			lower_typed_record(context, info)
		CompilerTypedUnionDecl(info):
			lower_typed_union(context, info)
		CompilerTypedTypeAliasDecl(info):
			lower_typed_type_alias(context, info)
		CompilerTypedTraitDecl(info):
			lower_typed_trait(context, info)
		CompilerTypedImplDecl(info):
			lower_typed_impl(context, info)
		CompilerTypedParsedDecl(_):
			Err(CompilerCoreLowerUnsupported("untyped parsed declaration"))


pure func lower_typed_decl(
	context: CompilerCoreLowerContext,
	decl: CompilerTypedDecl,
) -> Result[CompilerCoreLowerDeclResult, CompilerCoreLowerError]:
	lower_typed_decl_with_visibility(context, decl, False)


-- Imports have already become explicit graph/import-table metadata, while
-- builtin type declarations define stable ABI types rather than emitted Core
-- declarations. These are the only typed-program declarations intentionally
-- consumed without producing a Core declaration.
private pure func typed_decl_is_compile_time_only(decl: CompilerTypedDecl) -> Bool:
	match decl:
		CompilerTypedParsedDecl(parsed):
			match parsed:
				ImportBlockParsedDecl(_, _):
					True
				BuiltinTypeParsedDecl(_):
					True
				PrivateParsedDecl(inner, _):
					typed_decl_is_compile_time_only(CompilerTypedParsedDecl(inner))
				_:
					False
		CompilerTypedPrivateDecl(inner):
			typed_decl_is_compile_time_only(inner)
		_:
			False


pure func lower_typed_program(
	context: CompilerCoreLowerContext,
	program: CompilerTypedProgram,
) -> Result[CompilerCoreLowerProgramResult, CompilerCoreLowerError]:
	var current: CompilerCoreLowerContext = context
	var decls: List[CoreDecl] = []
	var foreign_includes: List[String] = []
	var failure: Option[CompilerCoreLowerError] = None

	for decl in program.decls:
		if failure.is_none():
			if typed_decl_is_compile_time_only(decl):
				void
			else:
				match decl:
					CompilerTypedForeignFunctionDecl(info):
						foreign_includes = foreign_includes
							.concat(info.includes)
							.unique()
					_:
						void

				match lower_typed_decl(current, decl):
					Ok(result):
						current = result.context
						decls = decls.append(result.decl)
					Err(error):
						failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({
				context = current,
				program = {
					decls = decls,
					foreign_includes = foreign_includes
				},
			})
