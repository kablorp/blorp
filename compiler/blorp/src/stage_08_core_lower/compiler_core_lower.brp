private pure func lower_literal_match_pattern(
	pattern: CompilerTypedPattern,
) -> Result[Option[CoreLiteral], CompilerCoreLowerError]:
	match pattern:
		CompilerTypedWildcardPattern(_):
			Ok(None)
		CompilerTypedBoolPattern(value, _):
			Ok(Some(BoolLiteral(value)))
		CompilerTypedIntPattern(value, _):
			Ok(Some(compiler_core_literal_int(value)))
		CompilerTypedFloatPattern(value, _):
			Ok(Some(FloatTextLiteral(value)))
		CompilerTypedStringPattern(value, _):
			Ok(Some(StringLiteral(value)))
		CompilerTypedCharPattern(value, _):
			Ok(Some(CharLiteral(value)))
		_:
			Err(CompilerCoreLowerUnsupported("match " + typed_pattern_label(pattern)))


