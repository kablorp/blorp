private CALLABLE_ID_SEPARATOR: String = "#"

private CORE_INT_MAX_DECIMAL: String = "9223372036854775807"

private CORE_INT_MIN_MAGNITUDE_DECIMAL: String = "9223372036854775808"

private MICROSECONDS_PER_MILLISECOND: Int = 1000

private PARALLEL_VECTOR_TYPE_NAME: String = "ParallelVector"

private CANONICAL_PARALLEL_VECTOR_TYPE_NAME: String = "std/vector::ParallelVector"

private PARALLEL_MATRIX_TYPE_NAME: String = "ParallelMatrix"

private CANONICAL_PARALLEL_MATRIX_TYPE_NAME: String = "std/matrix::ParallelMatrix"

private TO_STRING_BUILTIN_NAME: String = "to_string"

private TO_STRING_CORE_SENTINEL: String = "blorp_to_string"


union CompilerCoreLowerError:
	CompilerCoreLowerUnsupported(String)
	CompilerCoreLowerInvalidType(String)
	CompilerCoreLowerInvalidParam(String)
	CompilerCoreLowerInvalidCall(String)


private union CompilerCoreLowerFunctionBody:
	CompilerCoreLowerUserFunctionBody(CoreExpr)
	CompilerCoreLowerForwardDeclaration
	CompilerCoreLowerBuiltinDeclaration


private record CompilerCoreLowerParamDestructure {
	param: CoreParam,
	names: List[ParsedIdentifier]
}


private record CompilerCoreLowerParamResult {
	param: CoreParam,
	destructure: Option[CompilerCoreLowerParamDestructure]
}


private record CompilerCoreLowerParams {
	params: List[CoreParam],
	destructures: List[CompilerCoreLowerParamDestructure]
}


private pure func lowered_function_kind(body: CompilerCoreLowerFunctionBody) -> CoreFunctionKind:
	match body:
		CompilerCoreLowerBuiltinDeclaration:
			UnresolvedBuiltinFunction
		CompilerCoreLowerForwardDeclaration:
			UserFunction
		CompilerCoreLowerUserFunctionBody(_):
			UserFunction


enum CompilerCoreLowerCarrierKind:
	CompilerCoreLowerOptionCarrier
	CompilerCoreLowerResultCarrier


record CompilerCoreLowerContext {
	next_def_id: Int,
	source_module: Option[String]
}


record CompilerCoreLowerDeclResult {
	context: CompilerCoreLowerContext,
	decl: CoreDecl
}


record CompilerCoreLowerFunctionResult {
	context: CompilerCoreLowerContext,
	function_info: CoreFunction
}


record CompilerCoreLowerProgramResult {
	context: CompilerCoreLowerContext,
	program: CoreProgram
}


record CompilerCoreLowerForParts {
	binder: CoreLoopBinder,
	iterable: CoreExpr,
	iterable_release_policy: CoreReleasePolicy,
	body: CoreExpr
}


private record CompilerCoreLowerLoopBinding {
	binder: CoreLoopBinder,
	body: CoreExpr
}


private record CompilerCoreLowerConcurrentForItem {
	item_type: CoreType,
	item_mode: CoreConcurrentlyLoopItemMode
}


record CompilerCoreLowerConcurrentParams {
	timeout: Option[CoreExpr],
	max_threads: Option[Int]
}


record CompilerCoreLowerConcurrentForParams {
	timeout: Option[CoreExpr],
	limit: CoreExpr
}


pure func compiler_core_lower_error_to_string(error: CompilerCoreLowerError) -> String:
	match error:
		CompilerCoreLowerUnsupported(message):
			"unsupported Core lowering shape: " + message
		CompilerCoreLowerInvalidType(message):
			"invalid Core lowering type: " + message
		CompilerCoreLowerInvalidParam(message):
			"invalid Core lowering parameter: " + message
		CompilerCoreLowerInvalidCall(message):
			"invalid Core lowering call: " + message


pure func compiler_core_lower_context(
	next_def_id: Int,
	source_module: Option[String],
) -> CompilerCoreLowerContext:
	{
		next_def_id = next_def_id,
		source_module = source_module
	}


private pure func mint_def_id(context: CompilerCoreLowerContext) -> (CompilerCoreLowerContext, Int):
	({ context | next_def_id = context.next_def_id + 1 }, context.next_def_id)


pure func compiler_core_source_loc(span: CompilerSourceSpan) -> CoreSourceLoc:
	KnownSourceLoc({
		file = span.path,
		line = span.start_line,
		column = span.start_column,
		end_line = span.end_line,
		end_column = span.end_column,
	})


private pure func core_var(name: String, def_id: Option[Int]) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = def_id
	}


private pure func split_var_callable_id(name: String) -> (String, Option[Int]):
	if is_core_ufcs_function_name(name):
		hash_index: Int = name.raw_index_of(CALLABLE_ID_SEPARATOR)

		if hash_index < 0:
			(name, None)
		else:
			clean: String = name.substring(0, hash_index)
			suffix: String = name.substring(hash_index + 1, name.length() - hash_index - 1)

			match suffix.parse_int():
				Some(def_id):
					(clean, Some(def_id))
				None:
					(name, None)
	else:
		(name, None)


private pure func resolved_call_explicit_name(resolved: CompilerResolvedCallInfo) -> Option[String]:
	match resolved.target:
		CompilerResolvedTraitMethodCall(_, Some(target)):
			Some(core_ufcs_function_name(target.module_path, resolved.source_name))
		CompilerResolvedDirectCall(_, CompilerCallableImported(module_path)):
			Some(core_ufcs_function_name(module_path, resolved.source_name))
		_:
			None


private pure func lowered_name_expr_name(
	name: ParsedIdentifier,
	info: CompilerTypedExprInfo,
) -> String:
	match info.resolved_call:
		Some(resolved):
			resolved_call_explicit_name(resolved).get_or(name.text)
		None:
			name.text


private pure func resolved_core_decl_callable_id(resolved: CompilerResolvedCallInfo) -> Option[Int]:
	match resolved.target:
		CompilerResolvedDirectCall(callable_id, origin):
			match origin:
				CompilerCallableLocal:
					Some(callable_id)
				CompilerCallableImported(_):
					Some(callable_id)
				CompilerCallableImplMethod:
					Some(callable_id)
				_:
					None
		CompilerResolvedTraitMethodCall(_, impl_target):
			match impl_target:
				Some(target):
					Some(target.callable_id)
				None:
					None
		_:
			None


private pure func lower_name_expr_identity(
	name: ParsedIdentifier,
	info: CompilerTypedExprInfo,
) -> Result[(String, Option[Int]), CompilerCoreLowerError]:
	(clean_name, encoded_id) = split_var_callable_id(lowered_name_expr_name(name, info))

	resolved_id: Option[Int] = match info.resolved_call:
		Some(resolved):
			resolved_core_decl_callable_id(resolved)
		None:
			None

	match (encoded_id, resolved_id):
		(Some(encoded), Some(resolved)):
			if encoded == resolved:
				Ok((clean_name, encoded_id))
			else:
				Err(
					CompilerCoreLowerInvalidCall(
						"conflicting callable ids for ${name.text}: name carried ${encoded} but resolved_call carried ${resolved}",
					),
				)
		(Some(_), None):
			Ok((clean_name, encoded_id))
		(None, _):
			Ok((clean_name, resolved_id))


private pure func apply_resolved_callee_identity(
	resolved: Option[CompilerResolvedCallInfo],
	callee: CoreExpr,
) -> CoreExpr:
	match resolved:
		Some(info):
			match resolved_call_explicit_name(info):
				Some(name):
					match callee:
						VarExpr(variable, typ, loc):
							VarExpr({ variable | name = name }, typ, loc)
						FieldExpr(_, _, typ, loc):
							VarExpr(
								core_var(name, None),
								typ,
								loc,
							)
						_:
							callee
				None:
					callee
		None:
			callee


private pure func compiler_core_dim_op(op: CompilerDimOp) -> CoreDimOp:
	match op:
		CompilerDimAdd:
			DimAdd
		CompilerDimSubtract:
			DimSubtract
		CompilerDimMultiply:
			DimMultiply
		CompilerDimDivide:
			DimDivide


private pure func compiler_core_tensor_dim(
	dim: CompilerType,
) -> Result[CoreTensorDim, CompilerCoreLowerError]:
	match dim:
		CompilerConstIntType(value):
			Ok(TensorStaticDim(value))
		CompilerTypeVar(name):
			Ok(TensorRuntimeDim(name))
		CompilerVarDimsType(name):
			Ok(TensorVariadicDim(name))
		CompilerDimOpType(op, left, right):
			lowered_left ?= compiler_core_tensor_dim(left)
			lowered_right ?= compiler_core_tensor_dim(right)
			Ok(TensorDimOperation(compiler_core_dim_op(op), lowered_left, lowered_right))
		_:
			Err(
				CompilerCoreLowerInvalidType(
					"tensor dimension must be a const int or dimension variable, got " + compiler_type_to_string(
						dim,
					),
				),
			)


private pure func compiler_core_tensor_dims(
	dims: List[CompilerType],
) -> Result[List[CoreTensorDim], CompilerCoreLowerError]:
	var lowered: List[CoreTensorDim] = []
	var failure: Option[CompilerCoreLowerError] = None

	for dim in dims:
		if failure.is_none():
			match compiler_core_tensor_dim(dim):
				Ok(lowered_dim):
					lowered = lowered.append(lowered_dim)
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func compiler_core_lower_type_list(
	types: List[CompilerType],
) -> Result[List[CoreType], CompilerCoreLowerError]:
	var lowered: List[CoreType] = []
	var failure: Option[CompilerCoreLowerError] = None

	for typ in types:
		if failure.is_none():
			match compiler_core_lower_type(typ):
				Ok(lowered_type):
					lowered = lowered.append(lowered_type)
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


private pure func compiler_core_lower_tensor_type(
	element: CompilerType,
	dims: List[CompilerType],
) -> Result[CoreType, CompilerCoreLowerError]:
	element_type ?= compiler_core_lower_value_type(element)
	core_dims ?= compiler_core_tensor_dims(dims)

	Ok(TensorType({
		element_type = element_type,
		dims = core_dims,
	}))


private pure func malformed_parallel_tensor_type(
	typ: CompilerType,
	expected: String,
) -> Result[CoreType, CompilerCoreLowerError]:
	Err(
		CompilerCoreLowerInvalidType(
			"scoped parallel tensor type " + compiler_type_to_string(
				typ,
			) + " must have " + expected,
		),
	)


private pure func compiler_core_lower_value_type_list(
	types: List[CompilerType],
) -> Result[List[CoreType], CompilerCoreLowerError]:
	var lowered: List[CoreType] = []
	var failure: Option[CompilerCoreLowerError] = None

	for typ in types:
		if failure.is_none():
			match compiler_core_lower_value_type(typ):
				Ok(lowered_type):
					lowered = lowered.append(lowered_type)
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(lowered)


pure func compiler_core_lower_type(typ: CompilerType) -> Result[CoreType, CompilerCoreLowerError]:
	match compiler_array_type_parts(typ):
		Some((element, dims)):
			compiler_core_lower_tensor_type(element, dims)
		None:
			match typ:
				CompilerNamedType(name, args):
					normalized: String = flatten_canonical_core_type_name(
						compiler_normalize_type_name(name),
					)

					if normalized == TYPE_NAME_VOID and args.length() == 0:
						Ok(VoidType)
					else if (
						name == PARALLEL_VECTOR_TYPE_NAME
						or name == CANONICAL_PARALLEL_VECTOR_TYPE_NAME
					):
						match args:
							[element, dim]:
								compiler_core_lower_tensor_type(element, [dim])
							_:
								malformed_parallel_tensor_type(
									typ,
									"an element type and one dimension",
								)
					else if (
						name == PARALLEL_MATRIX_TYPE_NAME
						or name == CANONICAL_PARALLEL_MATRIX_TYPE_NAME
					):
						match args:
							[element, rows, columns]:
								compiler_core_lower_tensor_type(
									element,
									[rows, columns],
								)
							_:
								malformed_parallel_tensor_type(
									typ,
									"an element type and two dimensions",
								)
					else if (
						normalized == TYPE_NAME_TENSOR
						or normalized == TYPE_NAME_VECTOR
						or normalized == TYPE_NAME_MATRIX
					):
						Err(
							CompilerCoreLowerInvalidType(
								"tensor type " + compiler_type_to_string(
									typ,
								) + " is missing element or dimensions",
							),
						)
					else:
						match compiler_core_lower_value_type_list(args):
							Ok(lowered_args):
								Ok(NamedType(normalized, lowered_args))
							Err(CompilerCoreLowerInvalidType(message)):
								Err(
									CompilerCoreLowerInvalidType(
										"type " + compiler_type_to_string(
											typ,
										) + " has an invalid argument: " + message,
									),
								)
							Err(error):
								Err(error)
				CompilerTupleType(elements):
					lowered_elements ?= compiler_core_lower_value_type_list(elements)
					Ok(TupleType(lowered_elements))
				CompilerRangeType(_):
					Ok(RangeType)
				CompilerTypeVar(name):
					Ok(TypeParameterType(name))
				CompilerSelfType:
					Ok(SelfType)
				CompilerConstIntType(_):
					Err(
						CompilerCoreLowerInvalidType(
							"dimension literal cannot be used as a value type: " + compiler_type_to_string(
								typ,
							),
						),
					)
				CompilerFunctionType(is_pure, params, return_type):
					lowered_params ?= compiler_core_lower_value_type_list(params)
					lowered_return ?= compiler_core_lower_value_type(return_type)
					Ok(FunctionType(is_pure, lowered_params, lowered_return))
				CompilerArrayType(_, _):
					Err(
						CompilerCoreLowerInvalidType(
							"array type lowering failed unexpectedly: " + compiler_type_to_string(
								typ,
							),
						),
					)
				CompilerVarDimsType(_):
					Err(
						CompilerCoreLowerInvalidType(
							"dimension variable cannot be used as a value type: " + compiler_type_to_string(
								typ,
							),
						),
					)
				CompilerDimOpType(_, _, _):
					Err(
						CompilerCoreLowerInvalidType(
							"dimension expression cannot be used as a value type: " + compiler_type_to_string(
								typ,
							),
						),
					)
				CompilerMetaType(_):
					Err(
						CompilerCoreLowerInvalidType(
							"unresolved meta type reached Core lowering: " + compiler_type_to_string(
								typ,
							),
						),
					)


private pure func compiler_core_lower_value_type(
	typ: CompilerType,
) -> Result[CoreType, CompilerCoreLowerError]:
	match typ:
		CompilerConstIntType(_):
			Ok(NamedType("Int", []))
		_:
			compiler_core_lower_type(typ)


private pure func core_int_type() -> CoreType:
	NamedType("Int", [])


private pure func core_bool_type() -> CoreType:
	NamedType("Bool", [])


private pure func core_type_is_void(typ: CoreType) -> Bool:
	match typ:
		VoidType:
			True
		_:
			False


private pure func core_int_literal(value: Int, loc: CoreSourceLoc) -> CoreExpr:
	LiteralExpr(IntLiteral(value), core_int_type(), loc)


private pure func question_bind_name(label: String, span: CompilerSourceSpan) -> String:
	"__qb_" + label + "_" + span.start_line.to_string() + "_" + span.start_column.to_string()


private pure func tuple_destruct_name(span: CompilerSourceSpan) -> String:
	"__td_" + span.start_line.to_string() + "_" + span.start_column.to_string()


private pure func loop_view_internal_name(label: String, span: CompilerSourceSpan) -> String:
	"__loop_" + label + "_" + span.start_line.to_string() + "_" + span.start_column.to_string()


private pure func for_binder_span(binder: ParsedForBinder) -> CompilerSourceSpan:
	match binder:
		ParsedForNameBinder(name):
			name.span
		ParsedForTupleBinder(_, span):
			span


private pure func loop_view_binder_name(
	binder: ParsedForBinder,
	position: Int,
	label: String,
	span: CompilerSourceSpan,
) -> String:
	match binder:
		ParsedForTupleBinder(names, _):
			match names.get(position):
				Some(name):
					if name.text == "_":
						loop_view_internal_name(label, span)
					else:
						name.text
				None:
					loop_view_internal_name(label, span)
		ParsedForNameBinder(_):
			loop_view_internal_name(label, span)


private pure func core_carrier_kind(
	typ: CoreType,
) -> Result[CompilerCoreLowerCarrierKind, CompilerCoreLowerError]:
	match typ:
		NamedType(name, args):
			if name == "Option" and args.length() == 1:
				Ok(CompilerCoreLowerOptionCarrier)
			else if name == "Result" and args.length() == 2:
				Ok(CompilerCoreLowerResultCarrier)
			else:
				Err(CompilerCoreLowerInvalidType("expected Option or Result carrier"))
		StackResultType(_, _):
			Ok(CompilerCoreLowerResultCarrier)
		BoxedResultType(_, _):
			Ok(CompilerCoreLowerResultCarrier)
		_:
			Err(CompilerCoreLowerInvalidType("expected Option or Result carrier"))


private pure func core_carrier_success_type(
	typ: CoreType,
) -> Result[CoreType, CompilerCoreLowerError]:
	match typ:
		NamedType(name, args):
			if name == "Option":
				match args:
					[payload]:
						Ok(payload)
					_:
						Err(
							CompilerCoreLowerInvalidType(
								"Option carrier expected one payload type",
							),
						)
			else if name == "Result":
				match args:
					[ok_type, _]:
						Ok(ok_type)
					_:
						Err(
							CompilerCoreLowerInvalidType(
								"Result carrier expected ok and error types",
							),
						)
			else:
				Err(CompilerCoreLowerInvalidType("expected Option or Result carrier"))
		StackResultType(ok_type, _):
			Ok(ok_type)
		BoxedResultType(ok_type, _):
			Ok(ok_type)
		_:
			Err(CompilerCoreLowerInvalidType("expected Option or Result carrier"))


private pure func core_carrier_failure_type(
	typ: CoreType,
) -> Result[CoreType, CompilerCoreLowerError]:
	match typ:
		NamedType(name, args):
			if name == "Result":
				match args:
					[_, err_type]:
						Ok(err_type)
					_:
						Err(
							CompilerCoreLowerInvalidType(
								"Result carrier expected ok and error types",
							),
						)
			else:
				Err(CompilerCoreLowerInvalidType("Option carrier has no failure payload"))
		StackResultType(_, err_type):
			Ok(err_type)
		BoxedResultType(_, err_type):
			Ok(err_type)
		_:
			Err(CompilerCoreLowerInvalidType("expected Result carrier"))


private pure func option_payload_uses_nullable_match(payload_type: CoreType) -> Bool:
	TypeLayout
		.nullable_managed_option_payload_type(NamedType("Option", [payload_type]))
		.is_some()


private pure func option_some_test(
	payload_type: CoreType,
) -> Result[CoreConstructorMatchTest, CompilerCoreLowerError]:
	match TypeLayout.stack_option_c_type(payload_type):
		Some(option_type):
			Ok(StackOptionSomeConstructorTest(option_type))
		None:
			if option_payload_uses_nullable_match(payload_type):
				Ok(NullableOptionSomeConstructorTest)
			else:
				Ok(UnionTagConstructorTest("TAG_Option_Some", "Option"))


private pure func option_none_test(
	payload_type: CoreType,
) -> Result[CoreConstructorMatchTest, CompilerCoreLowerError]:
	match TypeLayout.stack_option_c_type(payload_type):
		Some(option_type):
			Ok(StackOptionNoneConstructorTest(option_type))
		None:
			if option_payload_uses_nullable_match(payload_type):
				Ok(NullableOptionNoneConstructorTest)
			else:
				Ok(UnionTagConstructorTest("TAG_Option_None", "Option"))


private pure func option_payload_accessor(payload_type: CoreType) -> CoreAccessor:
	match TypeLayout.stack_option_c_type(payload_type):
		Some(_):
			StackOptionPayloadAccessor(RootAccessor)
		None:
			if option_payload_uses_nullable_match(payload_type):
				NullableOptionPayloadAccessor(RootAccessor)
			else:
				VariantFieldAccessor(RootAccessor, "Option", "Some", 0)


private pure func result_ok_test(carrier_type: CoreType) -> CoreConstructorMatchTest:
	if CoreTypePolicy.is_stack_result_type(carrier_type):
		StackResultOkConstructorTest("blorp_StackResult")
	else:
		BoxedResultOkConstructorTest


private pure func result_err_test(carrier_type: CoreType) -> CoreConstructorMatchTest:
	if CoreTypePolicy.is_stack_result_type(carrier_type):
		StackResultErrConstructorTest("blorp_StackResult")
	else:
		BoxedResultErrConstructorTest


private pure func result_ok_accessor(carrier_type: CoreType) -> CoreAccessor:
	if CoreTypePolicy.is_stack_result_type(carrier_type):
		StackResultOkPayloadAccessor(RootAccessor)
	else:
		BoxedResultOkPayloadAccessor(RootAccessor)


private pure func result_err_accessor(carrier_type: CoreType) -> CoreAccessor:
	if CoreTypePolicy.is_stack_result_type(carrier_type):
		StackResultErrPayloadAccessor(RootAccessor)
	else:
		BoxedResultErrPayloadAccessor(RootAccessor)


private pure func carrier_success_test(
	kind: CompilerCoreLowerCarrierKind,
	carrier_type: CoreType,
) -> Result[CoreConstructorMatchTest, CompilerCoreLowerError]:
	match kind:
		CompilerCoreLowerOptionCarrier:
			payload_type ?= core_carrier_success_type(carrier_type)
			option_some_test(payload_type)
		CompilerCoreLowerResultCarrier:
			Ok(result_ok_test(carrier_type))


private pure func carrier_failure_test(
	kind: CompilerCoreLowerCarrierKind,
	carrier_type: CoreType,
) -> Result[CoreConstructorMatchTest, CompilerCoreLowerError]:
	match kind:
		CompilerCoreLowerOptionCarrier:
			payload_type ?= core_carrier_success_type(carrier_type)
			option_none_test(payload_type)
		CompilerCoreLowerResultCarrier:
			Ok(result_err_test(carrier_type))


private pure func carrier_success_accessor(
	kind: CompilerCoreLowerCarrierKind,
	carrier_type: CoreType,
) -> Result[CoreAccessor, CompilerCoreLowerError]:
	match kind:
		CompilerCoreLowerOptionCarrier:
			payload_type ?= core_carrier_success_type(carrier_type)
			Ok(option_payload_accessor(payload_type))
		CompilerCoreLowerResultCarrier:
			Ok(result_ok_accessor(carrier_type))


private pure func carrier_failure_accessor(
	kind: CompilerCoreLowerCarrierKind,
	carrier_type: CoreType,
) -> Result[CoreAccessor, CompilerCoreLowerError]:
	match kind:
		CompilerCoreLowerOptionCarrier:
			Err(CompilerCoreLowerInvalidType("Option failure arm has no payload accessor"))
		CompilerCoreLowerResultCarrier:
			Ok(result_err_accessor(carrier_type))


private pure func builtin_core_call(
	name: String,
	args: List[CoreExpr],
	return_type: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	CallExpr(
		BuiltinCall(name),
		VarExpr(
			core_var(name, None),
			NamedType("Closure", []),
			clone_core_source_loc(loc),
		),
		args,
		return_type,
		clone_core_source_loc(loc),
	)


private pure func core_param_value(param: CoreParam) -> CoreExpr:
	VarExpr(
		clone_core_var(param.name),
		clone_core_type(param.typ),
		clone_core_source_loc(param.loc),
	)


private pure func lower_runtime_helper_body(
	name: String,
	params: List[CoreParam],
	return_type: CoreType,
	loc: CoreSourceLoc,
) -> CompilerCoreLowerFunctionBody:
	CompilerCoreLowerUserFunctionBody(
		builtin_core_call(
			name,
			params.map(core_param_value),
			return_type,
			loc,
		),
	)


private pure func carrier_failure_expr(
	kind: CompilerCoreLowerCarrierKind,
	carrier_type: CoreType,
	failure_var: CoreVar,
	failure_type: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	match kind:
		CompilerCoreLowerOptionCarrier:
			builtin_core_call("blorp_option_none", [], carrier_type, loc)
		CompilerCoreLowerResultCarrier:
			builtin_core_call(
				"blorp_result_err",
				[
					VarExpr(
						clone_core_var(failure_var),
						clone_core_type(failure_type),
						clone_core_source_loc(loc),
					),
				],
				carrier_type,
				clone_core_source_loc(loc),
			)


