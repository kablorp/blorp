import:
	../stage_01_file_io/compiler_source: CompilerSourceSpan, compiler_source_span_label


enum ParseDiagnosticSeverity:
	ParseErrorSeverity
	ParseWarningSeverity


record CompilerParseDiagnostic {
	severity: ParseDiagnosticSeverity,
	span: CompilerSourceSpan,
	message: String,
	expected: List[String],
	help: Option[String]
}


pure func compiler_parse_error(
	span: CompilerSourceSpan,
	message: String,
) -> CompilerParseDiagnostic:
	{
		severity = ParseErrorSeverity,
		span = span,
		message = message,
		expected = [],
		help = None
	}


pure func compiler_parse_warning(
	span: CompilerSourceSpan,
	message: String,
) -> CompilerParseDiagnostic:
	{
		severity = ParseWarningSeverity,
		span = span,
		message = message,
		expected = [],
		help = None
	}


pure func compiler_parse_error_expected(
	span: CompilerSourceSpan,
	message: String,
	expected: List[String],
	help: Option[String],
) -> CompilerParseDiagnostic:
	{
		severity = ParseErrorSeverity,
		span = span,
		message = message,
		expected = expected,
		help = help
	}


pure func compiler_parse_diagnostic_is_error(diagnostic: CompilerParseDiagnostic) -> Bool:
	match diagnostic.severity:
		ParseErrorSeverity:
			True
		ParseWarningSeverity:
			False


pure func compiler_parse_diagnostic_severity_text(severity: ParseDiagnosticSeverity) -> String:
	match severity:
		ParseErrorSeverity:
			"error"
		ParseWarningSeverity:
			"warning"


private pure func expected_summary(expected: List[String]) -> String:
	if expected.length() == 0:
		""
	else:
		var text: String = ""
		var i: Int = 0

		while i < expected.length():
			if i == 0:
				text = expected.get_or(i, "")
			else:
				text = text + ", " + expected.get_or(i, "")

			i += 1

		text


pure func compiler_parse_diagnostic_to_string(diagnostic: CompilerParseDiagnostic) -> String:
	base: String = compiler_source_span_label(
		diagnostic.span,
	) + ": " + compiler_parse_diagnostic_severity_text(
		diagnostic.severity,
	) + ": " + diagnostic.message

	expected: String = expected_summary(diagnostic.expected)

	with_expected: String = if expected.length() == 0:
		base
	else:
		base + " (expected " + expected + ")"

	match diagnostic.help:
		Some(help):
			with_expected + "\nhelp: " + help
		None:
			with_expected
