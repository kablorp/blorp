import:
	../stage_01_file_io/compiler_source: CompilerSourceFile, CompilerSourceSpan, compiler_source_span_text


enum CompilerKeyword:
	FuncKeyword
	PureKeyword
	VarKeyword
	UnionKeyword
	RecordKeyword
	VoidKeyword
	WhileKeyword
	ForKeyword
	InKeyword
	IfKeyword
	ElseKeyword
	AndKeyword
	OrKeyword
	NotKeyword
	OnKeyword
	MatchKeyword
	TrueKeyword
	FalseKeyword
	BreakKeyword
	ContinueKeyword
	DebugKeyword
	StructKeyword
	EnumKeyword
	WithKeyword
	ResourceKeyword
	ForeignKeyword
	PrivateKeyword
	BuiltinKeyword
	ConcurrentKeyword
	ConcurrentlyKeyword
	DetachKeyword
	SelectKeyword
	IntoKeyword
	FromKeyword
	AfterKeyword
	SealedKeyword
	OpaqueKeyword
	TryKeyword
	ImportKeyword
	AsKeyword
	TraitKeyword
	ImplementsKeyword
	SelfKeyword
	TypeKeyword
	AliasKeyword
	WhereKeyword


enum CompilerSymbol:
	LeftParenSymbol
	RightParenSymbol
	LeftBracketSymbol
	RightBracketSymbol
	LeftBraceSymbol
	RightBraceSymbol
	CommaSymbol
	ColonSymbol
	DotSymbol
	DotDotSymbol
	DotDotDotSymbol
	ArrowSymbol
	FatArrowSymbol
	EqualSymbol
	QuestionEqualsSymbol
	PlusSymbol
	MinusSymbol
	StarSymbol
	SlashSymbol
	PlusEqualSymbol
	MinusEqualSymbol
	StarEqualSymbol
	SlashEqualSymbol
	UnderscoreSymbol
	PercentSymbol
	HashSymbol
	AtSymbol
	PipeSymbol
	EqualEqualSymbol
	NotEqualSymbol
	LessSymbol
	LessEqualSymbol
	GreaterSymbol
	GreaterEqualSymbol


enum CompilerTriviaKind:
	WhitespaceTrivia
	CommentTrivia


enum CompilerStringLiteralKind:
	NormalStringLiteral
	RawStringLiteral
	InterpolatedStringLiteral
	PipeStringLiteral
	RawPipeStringLiteral
	InterpolatedPipeStringLiteral


record CompilerTrivia {
	kind: CompilerTriviaKind,
	text: String,
	span: CompilerSourceSpan
}


union CompilerTokenKind:
	IdentifierToken(String)
	KeywordToken(CompilerKeyword)
	SymbolToken(CompilerSymbol)
	IntLiteralToken(String)
	FloatLiteralToken(String)
	StringLiteralToken(CompilerStringLiteralKind, String)
	CharLiteralToken(Int)
	DocStringToken(String)
	NewlineToken
	IndentToken
	DedentToken
	EndOfFileToken


record CompilerToken {
	kind: CompilerTokenKind,
	span: CompilerSourceSpan,
	leading_trivia: List[CompilerTrivia],
	trailing_trivia: List[CompilerTrivia]
}


pure func compiler_keyword_text(keyword: CompilerKeyword) -> String:
	match keyword:
		FuncKeyword:
			"func"
		PureKeyword:
			"pure"
		VarKeyword:
			"var"
		UnionKeyword:
			"union"
		RecordKeyword:
			"record"
		VoidKeyword:
			"void"
		WhileKeyword:
			"while"
		ForKeyword:
			"for"
		InKeyword:
			"in"
		IfKeyword:
			"if"
		ElseKeyword:
			"else"
		AndKeyword:
			"and"
		OrKeyword:
			"or"
		NotKeyword:
			"not"
		OnKeyword:
			"on"
		MatchKeyword:
			"match"
		TrueKeyword:
			"True"
		FalseKeyword:
			"False"
		BreakKeyword:
			"break"
		ContinueKeyword:
			"continue"
		DebugKeyword:
			"debug"
		StructKeyword:
			"struct"
		EnumKeyword:
			"enum"
		WithKeyword:
			"with"
		ResourceKeyword:
			"resource"
		ForeignKeyword:
			"foreign"
		PrivateKeyword:
			"private"
		BuiltinKeyword:
			"builtin"
		ConcurrentKeyword:
			"concurrent"
		ConcurrentlyKeyword:
			"concurrently"
		DetachKeyword:
			"detach"
		SelectKeyword:
			"select"
		IntoKeyword:
			"into"
		FromKeyword:
			"from"
		AfterKeyword:
			"after"
		SealedKeyword:
			"sealed"
		OpaqueKeyword:
			"opaque"
		TryKeyword:
			"try"
		ImportKeyword:
			"import"
		AsKeyword:
			"as"
		TraitKeyword:
			"trait"
		ImplementsKeyword:
			"implements"
		SelfKeyword:
			"Self"
		TypeKeyword:
			"type"
		AliasKeyword:
			"alias"
		WhereKeyword:
			"where"


pure func compiler_symbol_text(symbol: CompilerSymbol) -> String:
	match symbol:
		LeftParenSymbol:
			"("
		RightParenSymbol:
			")"
		LeftBracketSymbol:
			"["
		RightBracketSymbol:
			"]"
		LeftBraceSymbol:
			"{"
		RightBraceSymbol:
			"}"
		CommaSymbol:
			","
		ColonSymbol:
			":"
		DotSymbol:
			"."
		DotDotSymbol:
			".."
		DotDotDotSymbol:
			"..."
		ArrowSymbol:
			"->"
		FatArrowSymbol:
			"=>"
		EqualSymbol:
			"="
		QuestionEqualsSymbol:
			"?="
		PlusSymbol:
			"+"
		MinusSymbol:
			"-"
		StarSymbol:
			"*"
		SlashSymbol:
			"/"
		PlusEqualSymbol:
			"+="
		MinusEqualSymbol:
			"-="
		StarEqualSymbol:
			"*="
		SlashEqualSymbol:
			"/="
		UnderscoreSymbol:
			"_"
		PercentSymbol:
			"%"
		HashSymbol:
			"#"
		AtSymbol:
			"@"
		PipeSymbol:
			"|"
		EqualEqualSymbol:
			"=="
		NotEqualSymbol:
			"!="
		LessSymbol:
			"<"
		LessEqualSymbol:
			"<="
		GreaterSymbol:
			">"
		GreaterEqualSymbol:
			">="


pure func compiler_string_literal_kind_name(kind: CompilerStringLiteralKind) -> String:
	match kind:
		NormalStringLiteral:
			"string literal"
		RawStringLiteral:
			"raw string literal"
		InterpolatedStringLiteral:
			"interpolated string literal"
		PipeStringLiteral:
			"pipe string literal"
		RawPipeStringLiteral:
			"raw pipe string literal"
		InterpolatedPipeStringLiteral:
			"interpolated pipe string literal"


pure func compiler_trivia(
	kind: CompilerTriviaKind,
	text: String,
	span: CompilerSourceSpan,
) -> CompilerTrivia:
	{
		kind = kind,
		text = text,
		span = span
	}


pure func compiler_token(kind: CompilerTokenKind, span: CompilerSourceSpan) -> CompilerToken:
	{
		kind = kind,
		span = span,
		leading_trivia = [],
		trailing_trivia = []
	}


pure func compiler_token_with_trivia(
	kind: CompilerTokenKind,
	span: CompilerSourceSpan,
	leading_trivia: List[CompilerTrivia],
	trailing_trivia: List[CompilerTrivia],
) -> CompilerToken:
	{
		kind = kind,
		span = span,
		leading_trivia = leading_trivia,
		trailing_trivia = trailing_trivia
	}


pure func compiler_token_text(src: CompilerSourceFile, token: CompilerToken) -> String:
	compiler_source_span_text(src, token.span)


pure func compiler_token_kind_name(kind: CompilerTokenKind) -> String:
	match kind:
		IdentifierToken(_):
			"identifier"
		KeywordToken(keyword):
			"keyword " + compiler_keyword_text(keyword)
		SymbolToken(symbol):
			"symbol " + compiler_symbol_text(symbol)
		IntLiteralToken(_):
			"integer literal"
		FloatLiteralToken(_):
			"float literal"
		StringLiteralToken(kind, _):
			compiler_string_literal_kind_name(kind)
		CharLiteralToken(_):
			"char literal"
		DocStringToken(_):
			"docstring"
		NewlineToken:
			"newline"
		IndentToken:
			"indent"
		DedentToken:
			"dedent"
		EndOfFileToken:
			"end of file"
