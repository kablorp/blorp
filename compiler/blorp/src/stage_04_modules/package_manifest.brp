-- Blorp-owned parser for portable source package manifests.
--
-- The accepted format intentionally mirrors compiler/lib/package_manifest.ml.
-- It is narrower than general TOML so unsupported package metadata cannot be
-- silently ignored while the source-package format is still evolving.
import:
	bytes: bytes, get as get_byte, set_index as set_byte, slice as slice_bytes
	system: file_exists, read_file


record CompilerPackageManifestError {
	path: Option[String],
	line: Option[Int],
	message: String
}


record CompilerPackageManifest {
	name: String,
	version: Option[String],
	license: Option[String],
	std_compat: String,
	exports: List[String]
}


private union CompilerPackageManifestTomlValue:
	PackageManifestStringValue(String)
	PackageManifestStringListValue(List[String])


private record CompilerPackageManifestField {
	value: CompilerPackageManifestTomlValue,
	line: Int
}


COMPILER_PACKAGE_MANIFEST_FILENAME: String = "package.toml"

COMPILER_PACKAGE_CURRENT_STD_COMPAT: String = "preview-1"


pure func compiler_package_manifest_error(
	path: Option[String],
	line: Option[Int],
	message: String,
) -> CompilerPackageManifestError:
	{
		path = path,
		line = line,
		message = message
	}


pure func compiler_package_manifest_error_text(error: CompilerPackageManifestError) -> String:
	match error.path:
		Some(path):
			match error.line:
				Some(line):
					path + ":" + line.to_string() + ": " + error.message
				None:
					path + ": " + error.message
		None:
			match error.line:
				Some(line):
					"line " + line.to_string() + ": " + error.message
				None:
					error.message


private pure func append_manifest_error(
	errors: List[CompilerPackageManifestError],
	path: Option[String],
	line: Option[Int],
	message: String,
) -> List[CompilerPackageManifestError]:
	errors.append(compiler_package_manifest_error(path, line, message))


private pure func package_manifest_errors_at_path(
	errors: List[CompilerPackageManifestError],
	path: String,
) -> List[CompilerPackageManifestError]:
	var located: List[CompilerPackageManifestError] = []

	for error in errors:
		located = located.append({
			path = Some(path),
			line = error.line,
			message = error.message,
		})

	located


private pure func package_manifest_strip_comment(line: String) -> String:
	var i: Int = 0
	var end: Int = line.length()
	var in_string: Bool = False
	var escaped: Bool = False

	while i < line.length() and end == line.length():
		ch: Char = line
			.get(i)
			.get_or('\0')

		if ch == '#' and not in_string:
			end = i
		else if ch == '\"' and not escaped:
			in_string = not in_string

		if (
			ch == '\\'
			and in_string
			and not escaped
		):
			escaped = True
		else:
			escaped = False

		i += 1

	line.substring(0, end)


private pure func package_manifest_is_trim_byte(value: Int) -> Bool:
	value == 32 or value == 12 or value == 10 or value == 13 or value == 9


private pure func package_manifest_trim(value: String) -> String:
	raw: Bytes = value.to_bytes()
	var start: Int = 0
	var end: Int = raw.length()

	while start < end and package_manifest_is_trim_byte(get_byte(raw, start).get_or(0)):
		start += 1

	while end > start and package_manifest_is_trim_byte(get_byte(raw, end - 1).get_or(0)):
		end -= 1

	slice_bytes(raw, start, end - start).to_string()


private pure func package_manifest_byte_string(value: Int) -> String:
	set_byte(bytes(1), 0, value).to_string()


private pure func parse_package_manifest_quoted_string(
	value: String,
	path: Option[String],
	line: Option[Int],
) -> Result[String, CompilerPackageManifestError]:
	value_bytes: Bytes = value.to_bytes()
	length: Int = value_bytes.length()

	if (
		length < 2
		or get_byte(value_bytes, 0) != Some(34)
		or get_byte(value_bytes, length - 1) != Some(34)
	):
		Err(compiler_package_manifest_error(path, line, "expected a quoted string"))
	else:
		var result: Bytes = bytes(length - 2)
		var result_length: Int = 0
		var i: Int = 1
		var error: Option[CompilerPackageManifestError] = None

		while i < length - 1 and error.is_none():
			byte: Int = get_byte(value_bytes, i).get_or(0)

			if byte == 92:
				if i + 1 >= length - 1:
					error = Some(
						compiler_package_manifest_error(
							path,
							line,
							"unterminated string escape",
						),
					)
				else:
					escaped: Int = get_byte(value_bytes, i + 1).get_or(0)

					if escaped == 34:
						result = set_byte(result, result_length, 34)
						result_length += 1
					else if escaped == 92:
						result = set_byte(result, result_length, 92)
						result_length += 1
					else if escaped == 110:
						result = set_byte(result, result_length, 10)
						result_length += 1
					else if escaped == 116:
						result = set_byte(result, result_length, 9)
						result_length += 1
					else:
						error = Some(
							compiler_package_manifest_error(
								path,
								line,
								"unsupported string escape \\" + package_manifest_byte_string(
									escaped,
								),
							),
						)

					i += 2
			else:
				result = set_byte(result, result_length, byte)
				result_length += 1
				i += 1

		match error:
			Some(found):
				Err(found)
			None:
				Ok(slice_bytes(result, 0, result_length).to_string())


private pure func skip_package_manifest_array_spaces(value: String, start: Int) -> Int:
	var i: Int = start

	while i < value.length() and (value.get(i) == Some(' ') or value.get(i) == Some('\t')):
		i += 1

	i


private pure func parse_package_manifest_string_list(
	value: String,
	path: Option[String],
	line: Option[Int],
) -> Result[List[String], CompilerPackageManifestError]:
	length: Int = value.length()

	if (
		length < 2
		or value.get(0) != Some('[')
		or value.get(length - 1) != Some(']')
	):
		Err(compiler_package_manifest_error(path, line, "expected an array of quoted strings"))
	else:
		inner: String = value.substring(1, length - 2)
		var items: List[String] = []
		var i: Int = 0
		var error: Option[CompilerPackageManifestError] = None

		while i < inner.length() and error.is_none():
			i = skip_package_manifest_array_spaces(inner, i)

			if i < inner.length():
				if inner.get(i) != Some('\"'):
					error = Some(
						compiler_package_manifest_error(
							path,
							line,
							"expected a quoted string in array",
						),
					)
				else:
					var end_index: Int = 0 - 1
					var j: Int = i + 1
					var escaped: Bool = False

					while j < inner.length() and end_index < 0:
						ch: Char = inner
							.get(j)
							.get_or('\0')

						if ch == '\"' and not escaped:
							end_index = j
						else:
							if ch == '\\' and not escaped:
								escaped = True
							else:
								escaped = False

							j += 1

					if end_index < 0:
						error = Some(
							compiler_package_manifest_error(
								path,
								line,
								"unterminated string in array",
							),
						)
					else:
						raw: String = inner.substring(i, end_index - i + 1)

						match parse_package_manifest_quoted_string(raw, path, line):
							Err(found):
								error = Some(found)
							Ok(item):
								after: Int = skip_package_manifest_array_spaces(
									inner,
									end_index + 1,
								)
								items = items.append(item)

								if after >= inner.length():
									i = inner.length()
								else if inner.get(after) == Some(','):
									i = after + 1
								else:
									error = Some(
										compiler_package_manifest_error(
											path,
											line,
											"expected ',' between array items",
										),
									)

		match error:
			Some(found):
				Err(found)
			None:
				Ok(items)


pure func compiler_parse_package_manifest_string_list(
	value: String,
) -> Result[List[String], CompilerPackageManifestError]:
	parse_package_manifest_string_list(package_manifest_trim(value), None, None)


private pure func package_manifest_supported_section(section: String) -> Bool:
	section == "package" or section == "compat" or section == "exports"


private pure func package_manifest_key_expects_list(section: String, key: String) -> Option[Bool]:
	if section == "package" and (key == "name" or key == "version" or key == "license"):
		Some(False)
	else if section == "compat" and key == "std":
		Some(False)
	else if section == "exports" and key == "modules":
		Some(True)
	else:
		None


private pure func package_manifest_field_key(section: String, key: String) -> String:
	section + "." + key


pure func compiler_package_identifier_is_valid(value: String) -> Bool:
	if value.length() == 0:
		False
	else:
		first: Char = value
			.get(0)
			.get_or('\0')
		first_ok: Bool = (
			first >= 'A' and first <= 'Z'
			or first >= 'a' and first <= 'z'
			or first == '_'
		)

		var valid: Bool = first_ok
		var i: Int = 1

		while i < value.length() and valid:
			ch: Char = value
				.get(i)
				.get_or('\0')
			valid = (
				ch >= 'A' and ch <= 'Z'
				or ch >= 'a' and ch <= 'z'
				or ch >= '0' and ch <= '9'
				or ch == '_'
			)

			i += 1

		valid


pure func compiler_package_root_is_reserved(value: String) -> Bool:
	value == "std" or value == "pkg"


pure func compiler_package_module_path_is_valid(value: String) -> Bool:
	parts: List[String] = value.split("/")
	var valid: Bool = parts.length() > 0

	for part in parts:
		if (
			part == "."
			or part == ".."
			or not compiler_package_identifier_is_valid(part)
		):
			valid = False

	valid and not value.starts_with("std/") and not value.starts_with("pkg/")


private pure func package_manifest_string_field(
	fields: Dict[String, CompilerPackageManifestField],
	section: String,
	key: String,
) -> Option[String]:
	match fields.get(package_manifest_field_key(section, key)):
		Some(field):
			match field.value:
				PackageManifestStringValue(value):
					Some(value)
				_:
					None
		None:
			None


private pure func package_manifest_string_list_field(
	fields: Dict[String, CompilerPackageManifestField],
	section: String,
	key: String,
) -> Option[List[String]]:
	match fields.get(package_manifest_field_key(section, key)):
		Some(field):
			match field.value:
				PackageManifestStringListValue(value):
					Some(value)
				_:
					None
		None:
			None


pure func compiler_package_manifest_quote(value: String) -> String:
	var quoted: String = "\""
	raw: Bytes = value.to_bytes()
	var i: Int = 0

	while i < raw.length():
		byte: Int = get_byte(raw, i).get_or(0)

		if byte == 34:
			quoted += "\\\""
		else if byte == 92:
			quoted += "\\\\"
		else if byte == 10:
			quoted += "\\n"
		else if byte == 9:
			quoted += "\\t"
		else if byte == 13:
			quoted += "\\r"
		else if byte == 8:
			quoted += "\\b"
		else if byte >= 32 and byte <= 126:
			quoted = quoted.append_char(to_char(byte))
		else:
			quoted += "\\" + (byte / 100).to_string() + (byte / 10 % 10).to_string() + (byte % 10).to_string()

		i += 1

	quoted + "\""


pure func compiler_parse_package_manifest(
	source: String,
) -> Result[CompilerPackageManifest, List[CompilerPackageManifestError]]:
	var fields: Dict[String, CompilerPackageManifestField] = {}
	var errors: List[CompilerPackageManifestError] = []
	var current_section: Option[String] = None
	var line_number: Int = 0

	for raw_line in source.split("\n"):
		line_number += 1
		line: String = package_manifest_trim(package_manifest_strip_comment(raw_line))

		if line != "":
			if line.get(0) == Some('['):
				length: Int = line.length()

				if length >= 3 and line.get(length - 1) == Some(']'):
					section: String = package_manifest_trim(line.substring(1, length - 2))
					current_section = Some(section)

					if not package_manifest_supported_section(section):
						errors = append_manifest_error(
							errors,
							None,
							Some(line_number),
							"unsupported package manifest section [" + section + "]",
						)
				else:
					errors = append_manifest_error(
						errors,
						None,
						Some(line_number),
						"invalid package manifest section header",
					)
			else:
				match line.index_of("="):
					None:
						errors = append_manifest_error(
							errors,
							None,
							Some(line_number),
							"expected key = value",
						)
					Some(equals_index):
						match current_section:
							None:
								errors = append_manifest_error(
									errors,
									None,
									Some(line_number),
									"package manifest keys must be inside a section",
								)
							Some(section):
								key: String = package_manifest_trim(line.substring(0, equals_index))
								raw_value: String = package_manifest_trim(
									line.substring(
										equals_index + 1,
										line.length() - equals_index - 1,
									),
								)

								match package_manifest_key_expects_list(section, key):
									None:
										if package_manifest_supported_section(section):
											errors = append_manifest_error(
												errors,
												None,
												Some(line_number),
												"unsupported key " + key + " in package manifest section [" + section + "]",
											)
									Some(expects_list):
										storage_key: String = package_manifest_field_key(
											section,
											key,
										)

										if fields.contains(storage_key):
											errors = append_manifest_error(
												errors,
												None,
												Some(line_number),
												"duplicate key " + key + " in package manifest section [" + section + "]",
											)
										else if expects_list:
											match parse_package_manifest_string_list(
												raw_value,
												None,
												Some(line_number),
											):
												Ok(items):
													fields = fields.set(
														storage_key,
														{
															value = PackageManifestStringListValue(
																items,
															),
															line = line_number
														},
													)
												Err(error):
													errors = errors.append(error)
										else:
											match parse_package_manifest_quoted_string(
												raw_value,
												None,
												Some(line_number),
											):
												Ok(value):
													fields = fields.set(
														storage_key,
														{
															value = PackageManifestStringValue(
																value,
															),
															line = line_number
														},
													)
												Err(error):
													errors = errors.append(error)

	name: Option[String] = package_manifest_string_field(fields, "package", "name")
	std_compat: Option[String] = package_manifest_string_field(fields, "compat", "std")
	exports: Option[List[String]] = package_manifest_string_list_field(fields, "exports", "modules")

	if name.is_none():
		errors = append_manifest_error(
			errors,
			None,
			None,
			"missing required package manifest key [package].name",
		)

	if std_compat.is_none():
		errors = append_manifest_error(
			errors,
			None,
			None,
			"missing required package manifest key [compat].std",
		)

	if exports.is_none():
		errors = append_manifest_error(
			errors,
			None,
			None,
			"missing required package manifest key [exports].modules",
		)

	match (name, std_compat, exports):
		(Some(package_name), Some(package_std_compat), Some(package_exports)):
			var validation_errors: List[CompilerPackageManifestError] = []

			if not compiler_package_identifier_is_valid(package_name):
				validation_errors = append_manifest_error(
					validation_errors,
					None,
					None,
					"package name must be a Blorp identifier such as json or json_tools",
				)

			if compiler_package_root_is_reserved(package_name):
				validation_errors = append_manifest_error(
					validation_errors,
					None,
					None,
					"package name " + compiler_package_manifest_quote(
						package_name,
					) + " is reserved by the module system",
				)

			if package_exports.length() == 0:
				validation_errors = append_manifest_error(
					validation_errors,
					None,
					None,
					"package must export at least one module",
				)

			var seen_exports: Dict[String, Bool] = {}

			for module_name in package_exports:
				if not compiler_package_module_path_is_valid(module_name):
					validation_errors = append_manifest_error(
						validation_errors,
						None,
						None,
						"exported module " + compiler_package_manifest_quote(
							module_name,
						) + " is not a valid module path",
					)
				else if (
					module_name != package_name
					and not module_name.starts_with(package_name + "/")
				):
					validation_errors = append_manifest_error(
						validation_errors,
						None,
						None,
						"exported module " + compiler_package_manifest_quote(
							module_name,
						) + " must be inside package " + compiler_package_manifest_quote(
							package_name,
						),
					)

				if seen_exports.contains(module_name):
					validation_errors = append_manifest_error(
						validation_errors,
						None,
						None,
						"duplicate exported module " + compiler_package_manifest_quote(
							module_name,
						),
					)
				else:
					seen_exports = seen_exports.set(module_name, True)

			all_errors: List[CompilerPackageManifestError] = errors + validation_errors

			if all_errors.length() > 0:
				Err(all_errors)
			else:
				Ok({
					name = package_name,
					version = package_manifest_string_field(fields, "package", "version"),
					license = package_manifest_string_field(fields, "package", "license"),
					std_compat = package_std_compat,
					exports = package_exports,
				})
		_:
			Err(errors)


-- Attach locations after parsing so a borrowed recursive Option[String] does
-- not cross the parser boundary and require defensive ownership bookkeeping.
pure func compiler_parse_package_manifest_at_path(
	source: String,
	path: String,
) -> Result[CompilerPackageManifest, List[CompilerPackageManifestError]]:
	match compiler_parse_package_manifest(source):
		Ok(manifest):
			Ok(manifest)
		Err(errors):
			Err(package_manifest_errors_at_path(errors, path))


func compiler_read_package_manifest(
	path: String,
) -> Result[CompilerPackageManifest, List[CompilerPackageManifestError]]:
	if not file_exists(path):
		Err([compiler_package_manifest_error(Some(path), None, "package manifest not found")])
	else:
		match read_file(path):
			Ok(source):
				compiler_parse_package_manifest_at_path(source, path)
			Err(message):
				Err([compiler_package_manifest_error(Some(path), None, message)])
