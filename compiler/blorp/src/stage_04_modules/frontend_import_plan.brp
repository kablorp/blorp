-- Canonical import lookup policy shared by every compiler client.
--
-- This layer decides precedence and confinement without performing I/O. Source
-- providers evaluate the resulting typed lookups against either the filesystem
-- (CLI) or one immutable selected-source snapshot (LSP).
import:
	frontend_graph_service: CompilerFrontendSourceCandidate
	loaded_module:
		CompilerModuleOrigin(CompilerSourcePackageModule, CompilerStdlibModule),
		compiler_resolved_module_origin,
	path: dirname, join, normalize


union CompilerFrontendImportLookup:
	CompilerFrontendNativePackageLookup(String)
	CompilerFrontendStandardLibraryLookup(String)
	CompilerFrontendRelativePathLookup(String, CompilerModuleOrigin)
	CompilerFrontendSourcePackageAliasLookup(String)
	CompilerFrontendSourcePackageInternalLookup(String, String)
	CompilerFrontendLocalPathLookup(String)


private pure func module_source_filename(module_path: String) -> String:
	if module_path.ends_with(".brp"):
		module_path
	else:
		module_path + ".brp"


private pure func source_path_for_import(
	importer: CompilerFrontendSourceCandidate,
	requested_path: String,
) -> String:
	normalize(join(dirname(importer.source.path), module_source_filename(requested_path)))


-- Ordering is language behavior. Keeping it here prevents editor analysis from
-- preferring a different module than a normal build when names overlap.
pure func compiler_frontend_import_lookup_plan(
	importer: CompilerFrontendSourceCandidate,
	requested_path: String,
) -> List[CompilerFrontendImportLookup]:
	origin = compiler_resolved_module_origin(importer.identity)

	if requested_path.starts_with("pkg/"):
		match origin:
			CompilerSourcePackageModule(_):
				[]
			CompilerStdlibModule:
				[]
			_:
				[CompilerFrontendNativePackageLookup(requested_path)]
	else if requested_path.starts_with("std/"):
		[CompilerFrontendStandardLibraryLookup(requested_path)]
	else if requested_path.starts_with("./") or requested_path.starts_with("../"):
		[CompilerFrontendRelativePathLookup(
				source_path_for_import(importer, requested_path),
				origin,
			)]
	else:
		match origin:
			CompilerSourcePackageModule(package_alias):
				[CompilerFrontendSourcePackageInternalLookup(package_alias, requested_path)]
			_:
				[
					CompilerFrontendSourcePackageAliasLookup(requested_path),
					CompilerFrontendStandardLibraryLookup("std/" + requested_path),
					CompilerFrontendLocalPathLookup(
						source_path_for_import(
							importer,
							requested_path,
						),
					),
				]
