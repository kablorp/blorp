import:
	../stage_03_parse/compiler_parsed_ast:
		ParsedDecl(PrivateParsedDecl, RecordParsedDecl, TypeAliasParsedDecl, UnionParsedDecl),


private pure func compiler_append_unique_type_name(
	names: List[String],
	name: String,
) -> List[String]:
	if names.contains(name):
		names
	else:
		names.append(name)


private pure func compiler_collect_local_type_name(
	names: List[String],
	decl: ParsedDecl,
) -> List[String]:
	match decl:
		RecordParsedDecl(record_decl):
			compiler_append_unique_type_name(names, record_decl.name.text)
		UnionParsedDecl(union_decl):
			compiler_append_unique_type_name(names, union_decl.name.text)
		TypeAliasParsedDecl(type_alias_decl):
			compiler_append_unique_type_name(names, type_alias_decl.name.text)
		PrivateParsedDecl(inner, _):
			compiler_collect_local_type_name(names, inner)
		_:
			names


pure func compiler_local_type_names_from_decls(decls: List[ParsedDecl]) -> List[String]:
	var names: List[String] = []

	for decl in decls:
		names = compiler_collect_local_type_name(names, decl)

	names.sort()
