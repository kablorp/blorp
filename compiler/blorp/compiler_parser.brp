private union ParsedInfixOp:
	ParsedBinaryInfix(ParsedBinaryOp)
	ParsedLogicalInfix(ParsedLogicalOp)
	ParsedRangeInfix


private enum TupleBinderIdentifierMode:
	TupleBinderNamesOnly
	TupleBinderNamesOrUnderscore


private record ParsedInfixInfo {
	precedence: Int,
	op: ParsedInfixOp
}


private pure func initial_state(
	source: CompilerSourceFile,
	tokens: List[CompilerToken],
	diagnostics: List[CompilerParseDiagnostic],
) -> CompilerParserState:
	{
		source = source,
		tokens = tokens,
		index = 0,
		diagnostics = diagnostics
	}


private pure func eof_token(source: CompilerSourceFile) -> CompilerToken:
	cursor = compiler_source_cursor_at(source, source.text.length())
	compiler_token(
		EndOfFileToken,
		compiler_source_empty_span(source, cursor),
	)


private pure func current_token(state: CompilerParserState) -> CompilerToken:
	match state.tokens.get(state.index):
		Some(token):
			token
		None:
			eof_token(state.source)


private pure func token_at(state: CompilerParserState, index: Int) -> CompilerToken:
	match state.tokens.get(index):
		Some(token):
			token
		None:
			eof_token(state.source)


private pure func current_span(state: CompilerParserState) -> CompilerSourceSpan:
	current_token(state).span


private pure func span_cover(
	start_span: CompilerSourceSpan,
	end_span: CompilerSourceSpan,
) -> CompilerSourceSpan:
	{
		path = start_span.path,
		module_name = start_span.module_name,
		start_offset = start_span.start_offset,
		start_line = start_span.start_line,
		start_column = start_span.start_column,
		end_offset = end_span.end_offset,
		end_line = end_span.end_line,
		end_column = end_span.end_column
	}


private pure func add_expected_error(
	state: CompilerParserState,
	span: CompilerSourceSpan,
	message: String,
	expected: List[String],
	help: Option[String],
) -> CompilerParserState:
	{ state |
		diagnostics = state.diagnostics.append(
			compiler_parse_error_expected(
				span,
				message,
				expected,
				help,
			),
		)
	}


private pure func current_is_eof(state: CompilerParserState) -> Bool:
	match current_token(state).kind:
		EndOfFileToken:
			True
		_:
			False


private pure func advance_parser(state: CompilerParserState) -> CompilerParserState:
	if current_is_eof(state):
		state
	else:
		{ state | index = state.index + 1 }


private pure func current_is_newline(state: CompilerParserState) -> Bool:
	match current_token(state).kind:
		NewlineToken:
			True
		_:
			False


private pure func current_is_indent(state: CompilerParserState) -> Bool:
	match current_token(state).kind:
		IndentToken:
			True
		_:
			False


private pure func current_is_dedent(state: CompilerParserState) -> Bool:
	match current_token(state).kind:
		DedentToken:
			True
		_:
			False


private pure func skip_newlines(state: CompilerParserState) -> CompilerParserState:
	var st: CompilerParserState = state

	while current_is_newline(st):
		st = advance_parser(st)

	st


private pure func current_is_keyword(state: CompilerParserState, expected: CompilerKeyword) -> Bool:
	match current_token(state).kind:
		KeywordToken(actual):
			actual == expected
		_:
			False


private pure func next_is_keyword(state: CompilerParserState, expected: CompilerKeyword) -> Bool:
	match token_at(state, state.index + 1).kind:
		KeywordToken(actual):
			actual == expected
		_:
			False


private pure func current_is_symbol(state: CompilerParserState, expected: CompilerSymbol) -> Bool:
	match current_token(state).kind:
		SymbolToken(actual):
			actual == expected
		_:
			False


private pure func token_kind_is_symbol(kind: CompilerTokenKind, expected: CompilerSymbol) -> Bool:
	match kind:
		SymbolToken(actual):
			actual == expected
		_:
			False


private pure func token_kind_is_tuple_binder_name(kind: CompilerTokenKind) -> Bool:
	match kind:
		IdentifierToken(_):
			True
		SymbolToken(UnderscoreSymbol):
			True
		_:
			False


private pure func parsed_function_annotation_from_name(
	name: String,
) -> Option[ParsedFunctionAnnotation]:
	match name:
		"tail_recursive":
			Some(ParsedTailRecursiveAnnotation)
		"no_copy":
			Some(ParsedNoCopyAnnotation)
		"debug_only":
			Some(ParsedDebugOnlyAnnotation)
		"resource_result_ordinary":
			Some(ParsedResourceResultOrdinaryAnnotation)
		_:
			None


private pure func add_unknown_function_annotation_error(
	state: CompilerParserState,
	span: CompilerSourceSpan,
	name: String,
) -> CompilerParserState:
	add_expected_error(
		state,
		span,
		"unknown function annotation `@${name}`",
		["@tail_recursive", "@debug_only", "@no_copy", "@resource_result_ordinary"],
		Some("use one of the known function annotations, or remove the annotation"),
	)


private pure func consume_annotation_argument_list(
	state: CompilerParserState,
) -> CompilerParserState:
	var st: CompilerParserState = add_expected_error(
		state,
		current_span(state),
		"function annotations do not take arguments",
		[],
		Some("remove the argument list from the function annotation"),
	)

	st = advance_parser(st)

	while (
		not current_is_eof(st)
		and not current_is_newline(st)
		and not current_is_symbol(st, RightParenSymbol)
	):
		st = advance_parser(st)

	if current_is_symbol(st, RightParenSymbol):
		advance_parser(st)
	else:
		st


private pure func parse_function_annotations(
	state: CompilerParserState,
	allow_newlines: Bool,
) -> ParseFunctionAnnotationsStep:
	var st: CompilerParserState = state
	var values: List[ParsedFunctionAnnotation] = []

	while current_is_symbol(st, AtSymbol):
		st = advance_parser(st)
		name_step: ParseIdentifierStep = parse_identifier_expected(st, EXPECTED_FUNCTION_ANNOTATION)
		st = name_step.state

		match parsed_function_annotation_from_name(name_step.value.text):
			Some(annotation):
				values = values.append(annotation)
			None:
				st = add_unknown_function_annotation_error(
					st,
					name_step.value.span,
					name_step.value.text,
				)

		if current_is_symbol(st, LeftParenSymbol):
			st = consume_annotation_argument_list(st)

		if allow_newlines and current_is_newline(st):
			st = skip_newlines(st)

	{
		state = st,
		values = values
	}


private pure func current_is_soft_boundary(state: CompilerParserState) -> Bool:
	if (
		current_is_eof(state)
		or current_is_newline(state)
		or current_is_dedent(state)
	):
		True
	else:
		match current_token(state).kind:
			SymbolToken(ColonSymbol):
				True
			SymbolToken(CommaSymbol):
				True
			SymbolToken(LeftParenSymbol):
				True
			SymbolToken(RightBracketSymbol):
				True
			SymbolToken(RightParenSymbol):
				True
			_:
				False


private pure func expect_symbol(
	state: CompilerParserState,
	symbol: CompilerSymbol,
	message: String,
) -> ParseSymbolStep:
	span: CompilerSourceSpan = current_span(state)

	if current_is_symbol(state, symbol):
		{
			state = advance_parser(state),
			matched = True,
			span = span
		}
	else:
		{
			state = add_expected_error(state, span, message, [compiler_symbol_text(symbol)], None),
			matched = False,
			span = span
		}


private pure func expect_newline(
	state: CompilerParserState,
	message: String,
) -> CompilerParserState:
	if current_is_newline(state):
		advance_parser(state)
	else:
		add_expected_error(state, current_span(state), message, ["newline"], None)


private pure func expect_keyword(
	state: CompilerParserState,
	keyword: CompilerKeyword,
	expected: String,
	message: String,
) -> CompilerParserState:
	if current_is_keyword(state, keyword):
		advance_parser(state)
	else:
		add_expected_error(state, current_span(state), message, [expected], None)


private pure func current_is_block_end(state: CompilerParserState) -> Bool:
	current_is_eof(state) or current_is_dedent(state)


private pure func type_keyword_identifier_text(state: CompilerParserState) -> Option[String]:
	match current_token(state).kind:
		KeywordToken(SelfKeyword):
			Some("Self")
		KeywordToken(VoidKeyword):
			Some("void")
		_:
			None


private pure func soft_keyword_identifier_text(keyword: CompilerKeyword) -> Option[String]:
	match keyword:
		DebugKeyword:
			Some("debug")
		WithKeyword:
			Some("with")
		ConcurrentKeyword:
			Some("concurrent")
		ConcurrentlyKeyword:
			Some("concurrently")
		SelectKeyword:
			Some("select")
		AfterKeyword:
			Some("after")
		SealedKeyword:
			Some("sealed")
		OnKeyword:
			Some("on")
		_:
			None


private pure func parse_identifier_expected(
	state: CompilerParserState,
	expected: String,
) -> ParseIdentifierStep:
	token: CompilerToken = current_token(state)

	match token.kind:
		IdentifierToken(text):
			{
				state = advance_parser(state),
				value = parsed_identifier(text, token.span)
			}
		KeywordToken(keyword):
			match soft_keyword_identifier_text(keyword):
				Some(text):
					{
						state = advance_parser(state),
						value = parsed_identifier(text, token.span)
					}
				None:
					next_state: CompilerParserState = add_expected_error(
						state,
						token.span,
						"expected ${expected}",
						[expected],
						None,
					)

					recovery_state: CompilerParserState = if current_is_soft_boundary(next_state):
						next_state
					else:
						advance_parser(next_state)

					{
						state = recovery_state,
						value = parsed_identifier("", token.span)
					}
		_:
			next_state: CompilerParserState = add_expected_error(
				state,
				token.span,
				"expected ${expected}",
				[expected],
				None,
			)

			recovery_state: CompilerParserState = if current_is_soft_boundary(next_state):
				next_state
			else:
				advance_parser(next_state)

			{
				state = recovery_state,
				value = parsed_identifier("", token.span)
			}


private pure func parse_type_identifier_expected(
	state: CompilerParserState,
	expected: String,
) -> ParseIdentifierStep:
	token: CompilerToken = current_token(state)

	match token.kind:
		IdentifierToken(_):
			parse_identifier_expected(state, expected)
		_:
			match type_keyword_identifier_text(state):
				Some(text):
					{
						state = advance_parser(state),
						value = parsed_identifier(text, token.span)
					}
				None:
					parse_identifier_expected(state, expected)


private pure func last_type_expr_span(
	items: List[ParsedTypeExpr],
	fallback: CompilerSourceSpan,
) -> CompilerSourceSpan:
	var span: CompilerSourceSpan = fallback

	for item in items:
		span = parsed_type_expr_span(item)

	span


private pure func last_dim_constraint_span(
	items: List[ParsedDimConstraint],
	fallback: CompilerSourceSpan,
) -> CompilerSourceSpan:
	var span: CompilerSourceSpan = fallback

	for item in items:
		span = item.span

	span


private pure func parsed_type_expr_is_dim(type_expr: ParsedTypeExpr) -> Bool:
	match type_expr:
		ParsedDimNameType(_, _, _):
			True
		ParsedDimLiteralType(_, _):
			True
		ParsedDimBinaryType(_, _, _, _):
			True
		_:
			False


private pure func parsed_type_exprs_all_dim(items: List[ParsedTypeExpr]) -> Bool:
	var all_dim: Bool = items.length() > 0

	for item in items:
		if not parsed_type_expr_is_dim(item):
			all_dim = False

	all_dim


private pure func last_identifier_span(
	items: List[ParsedIdentifier],
	fallback: CompilerSourceSpan,
) -> CompilerSourceSpan:
	var span: CompilerSourceSpan = fallback

	for item in items:
		span = item.span

	span


private pure func parse_bound_identifier_list(
	state: CompilerParserState,
	expected: String,
) -> ParseIdentifierListStep:
	var st: CompilerParserState = state
	var values: List[ParsedIdentifier] = []
	var parsing_values: Bool = True

	while parsing_values and not current_is_eof(st):
		name_step: ParseIdentifierStep = parse_identifier_expected(st, expected)
		values = values.append(name_step.value)
		st = name_step.state

		if current_is_symbol(st, PlusSymbol):
			st = advance_parser(st)
		else:
			parsing_values = False

	{
		state = st,
		values = values
	}


private pure func parse_hash_identifier_expected(
	state: CompilerParserState,
	expected: String,
) -> ParseIdentifierStep:
	start_span: CompilerSourceSpan = current_span(state)
	st: CompilerParserState = expect_symbol(
		state,
		HashSymbol,
		"expected `#` before ${expected}",
	).state

	match current_token(st).kind:
		IdentifierToken(text):
			{
				state = advance_parser(st),
				value = parsed_identifier(
					"#" + text,
					span_cover(start_span, current_span(st)),
				)
			}
		SymbolToken(UnderscoreSymbol):
			{
				state = advance_parser(st),
				value = parsed_identifier(
					"#_",
					span_cover(start_span, current_span(st)),
				)
			}
		_:
			next_state: CompilerParserState = add_expected_error(
				st,
				current_span(st),
				"expected ${expected}",
				[expected],
				None,
			)

			{
				state = next_state,
				value = parsed_identifier("#", start_span)
			}


private pure func parse_dim_atom(state: CompilerParserState) -> ParseTypeStep:
	token: CompilerToken = current_token(state)

	match token.kind:
		SymbolToken(HashSymbol):
			start_span: CompilerSourceSpan = token.span
			var st: CompilerParserState = advance_parser(state)

			match current_token(st).kind:
				IdentifierToken(text):
					name: ParsedIdentifier = parsed_identifier(
						"#" + text,
						span_cover(start_span, current_span(st)),
					)
					st = advance_parser(st)
					var is_variadic: Bool = False
					var end_span: CompilerSourceSpan = name.span

					if current_is_symbol(st, DotDotDotSymbol):
						is_variadic = True
						end_span = current_span(st)
						st = advance_parser(st)

					{
						state = st,
						value = ParsedDimNameType(
							name,
							is_variadic,
							span_cover(start_span, end_span),
						)
					}
				IntLiteralToken(text):
					{
						state = advance_parser(st),
						value = ParsedDimLiteralType(
							text,
							span_cover(start_span, current_span(st)),
						)
					}
				SymbolToken(UnderscoreSymbol):
					name: ParsedIdentifier = parsed_identifier(
						"#_",
						span_cover(start_span, current_span(st)),
					)
					st = advance_parser(st)
					var is_variadic: Bool = False
					var end_span: CompilerSourceSpan = name.span

					if current_is_symbol(st, DotDotDotSymbol):
						is_variadic = True
						end_span = current_span(st)
						st = advance_parser(st)

					{
						state = st,
						value = ParsedDimNameType(
							name,
							is_variadic,
							span_cover(start_span, end_span),
						)
					}
				_:
					next_state: CompilerParserState = add_expected_error(
						st,
						current_span(st),
						"expected dimension name or literal after `#`",
						["dimension"],
						None,
					)

					{
						state = next_state,
						value = ParsedMissingType(start_span)
					}
		IntLiteralToken(text):
			{
				state = advance_parser(state),
				value = ParsedDimLiteralType(text, token.span)
			}
		SymbolToken(LeftParenSymbol):
			dim_step: ParseTypeStep = parse_dim_expr(advance_parser(state))
			right_step: ParseSymbolStep = expect_symbol(
				dim_step.state,
				RightParenSymbol,
				"expected `)` after dimension expression",
			)

			{
				state = right_step.state,
				value = dim_step.value
			}
		_:
			next_state: CompilerParserState = add_expected_error(
				state,
				token.span,
				"expected dimension expression",
				["dimension"],
				None,
			)

			{
				state = next_state,
				value = ParsedMissingType(token.span)
			}


private pure func parse_dim_multiply(state: CompilerParserState) -> ParseTypeStep:
	left_step: ParseTypeStep = parse_dim_atom(state)
	var st: CompilerParserState = left_step.state
	var left: ParsedTypeExpr = left_step.value

	while current_is_symbol(st, StarSymbol) or current_is_symbol(st, SlashSymbol):
		op: ParsedDimBinaryOp = if current_is_symbol(st, StarSymbol):
			ParsedDimMultiplyOp
		else:
			ParsedDimDivideOp

		st = advance_parser(st)
		right_step: ParseTypeStep = parse_dim_atom(st)
		left = ParsedDimBinaryType(
			op,
			left,
			right_step.value,
			span_cover(parsed_type_expr_span(left), parsed_type_expr_span(right_step.value)),
		)
		st = right_step.state

	{
		state = st,
		value = left
	}


private pure func parse_dim_expr(state: CompilerParserState) -> ParseTypeStep:
	left_step: ParseTypeStep = parse_dim_multiply(state)
	var st: CompilerParserState = left_step.state
	var left: ParsedTypeExpr = left_step.value

	while current_is_symbol(st, PlusSymbol) or current_is_symbol(st, MinusSymbol):
		op: ParsedDimBinaryOp = if current_is_symbol(st, PlusSymbol):
			ParsedDimAddOp
		else:
			ParsedDimSubtractOp

		st = advance_parser(st)
		right_step: ParseTypeStep = parse_dim_multiply(st)
		left = ParsedDimBinaryType(
			op,
			left,
			right_step.value,
			span_cover(parsed_type_expr_span(left), parsed_type_expr_span(right_step.value)),
		)
		st = right_step.state

	{
		state = st,
		value = left
	}


private pure func parse_dim_constraint(state: CompilerParserState) -> ParseDimConstraintStep:
	left_step: ParseTypeStep = parse_dim_expr(state)
	equal_step: ParseSymbolStep = expect_symbol(
		left_step.state,
		EqualEqualSymbol,
		"expected `==` in dimension constraint",
	)
	right_step: ParseTypeStep = parse_dim_expr(equal_step.state)

	{
		state = right_step.state,
		value = {
			left = left_step.value,
			right = right_step.value,
			span = span_cover(
				parsed_type_expr_span(left_step.value),
				parsed_type_expr_span(right_step.value),
			)
		}
	}


private pure func parse_dim_constraints_opt(
	state: CompilerParserState,
) -> ParseDimConstraintListStep:
	var st: CompilerParserState = state
	var values: List[ParsedDimConstraint] = []

	if current_is_keyword(st, WhereKeyword):
		st = advance_parser(st)
		var parsing_constraints: Bool = True

		while parsing_constraints and not current_is_eof(st):
			constraint_step: ParseDimConstraintStep = parse_dim_constraint(st)
			values = values.append(constraint_step.value)
			st = constraint_step.state

			if current_is_symbol(st, CommaSymbol):
				st = advance_parser(st)
			else:
				parsing_constraints = False

	{
		state = st,
		values = values
	}


private pure func parse_type_array_suffixes(
	state: CompilerParserState,
	base: ParsedTypeExpr,
) -> ParseTypeStep:
	var st: CompilerParserState = state
	var value: ParsedTypeExpr = base

	while current_is_symbol(st, LeftBracketSymbol):
		dims_step: ParseTypeListStep = parse_type_expr_list_until(
			advance_parser(st),
			RightBracketSymbol,
			False,
		)
		right_step: ParseSymbolStep = expect_symbol(
			dims_step.state,
			RightBracketSymbol,
			"expected `]` after array dimensions",
		)
		st = right_step.state

		if not parsed_type_exprs_all_dim(dims_step.values):
			st = add_expected_error(
				st,
				last_type_expr_span(dims_step.values, parsed_type_expr_span(value)),
				"expected array dimensions",
				["dimension"],
				Some("generic type arguments belong on the named type before array dimensions"),
			)

		end_span: CompilerSourceSpan = if right_step.matched:
			right_step.span
		else:
			last_type_expr_span(dims_step.values, parsed_type_expr_span(value))

		value = ParsedArrayType(
			value,
			dims_step.values,
			span_cover(parsed_type_expr_span(value), end_span),
		)

	{
		state = st,
		value = value
	}


private pure func parse_named_type_expr_with_bounds(
	state: CompilerParserState,
	allow_bounds: Bool,
) -> ParseTypeStep:
	can_qualify: Bool = match current_token(state).kind:
		IdentifierToken(_):
			True
		_:
			False

	first_name_step: ParseIdentifierStep = parse_type_identifier_expected(state, EXPECTED_TYPE)
	var type_name: ParsedIdentifier = first_name_step.value
	var qualifier: Option[ParsedIdentifier] = None
	var st: CompilerParserState = first_name_step.state
	var args: List[ParsedTypeExpr] = []
	var end_span: CompilerSourceSpan = first_name_step.value.span

	if allow_bounds and current_is_symbol(st, ColonSymbol):
		bounds_step: ParseIdentifierListStep = parse_bound_identifier_list(
			advance_parser(st),
			"trait bound",
		)

		{
			state = bounds_step.state,
			value = ParsedBoundedType(
				type_name,
				bounds_step.values,
				span_cover(
					type_name.span,
					last_identifier_span(bounds_step.values, type_name.span),
				),
			)
		}
	else:
		if can_qualify and current_is_symbol(st, DotSymbol):
			qualified_name_step: ParseIdentifierStep = parse_identifier_expected(
				advance_parser(st),
				EXPECTED_TYPE,
			)
			qualifier = Some(first_name_step.value)
			type_name = qualified_name_step.value
			st = qualified_name_step.state
			end_span = type_name.span

		if current_is_symbol(st, LeftBracketSymbol):
			args_step: ParseTypeListStep = parse_type_expr_list_until(
				advance_parser(st),
				RightBracketSymbol,
				True,
			)
			right_step: ParseSymbolStep = expect_symbol(
				args_step.state,
				RightBracketSymbol,
				"expected `]` after type arguments",
			)
			st = right_step.state
			args = args_step.values
			end_span = last_type_expr_span(args, end_span)

			if right_step.matched:
				end_span = right_step.span

		base_type: ParsedTypeExpr = match qualifier:
			Some(module_name):
				ParsedQualifiedNamedType(
					module_name,
					type_name,
					[],
					span_cover(module_name.span, type_name.span),
				)
			None:
				ParsedNamedType(type_name, [], type_name.span)

		if parsed_type_exprs_all_dim(args):
			array_type: ParsedTypeExpr = ParsedArrayType(
				base_type,
				args,
				span_cover(parsed_type_expr_span(base_type), end_span),
			)
			parse_type_array_suffixes(st, array_type)
		else:
			named_type: ParsedTypeExpr = match qualifier:
				Some(module_name):
					ParsedQualifiedNamedType(
						module_name,
						type_name,
						args,
						span_cover(module_name.span, end_span),
					)
				None:
					ParsedNamedType(
						type_name,
						args,
						span_cover(type_name.span, end_span),
					)

			parse_type_array_suffixes(st, named_type)


private pure func parse_parenthesized_type_expr(state: CompilerParserState) -> ParseTypeStep:
	start_span: CompilerSourceSpan = current_span(state)
	var st: CompilerParserState = advance_parser(state)

	if current_is_symbol(st, RightParenSymbol):
		right_step: ParseSymbolStep = expect_symbol(st, RightParenSymbol, "expected `)` after type")
		st = right_step.state
		void_type: ParsedTypeExpr = ParsedNamedType(
			parsed_identifier(
				"Void",
				span_cover(start_span, right_step.span),
			),
			[],
			span_cover(start_span, right_step.span),
		)

		if current_is_symbol(st, ArrowSymbol):
			return_step: ParseTypeStep = parse_type_expr(advance_parser(st))

			{
				state = return_step.state,
				value = ParsedFunctionType(
					False,
					[],
					return_step.value,
					span_cover(start_span, parsed_type_expr_span(return_step.value)),
				)
			}
		else:
			parse_type_array_suffixes(st, void_type)
	else:
		items_step: ParseTypeListStep = parse_type_expr_list_until(st, RightParenSymbol, False)
		right_step: ParseSymbolStep = expect_symbol(
			items_step.state,
			RightParenSymbol,
			"expected `)` after type",
		)
		st = right_step.state

		if current_is_symbol(st, ArrowSymbol):
			return_step: ParseTypeStep = parse_type_expr(advance_parser(st))

			{
				state = return_step.state,
				value = ParsedFunctionType(
					False,
					items_step.values,
					return_step.value,
					span_cover(start_span, parsed_type_expr_span(return_step.value)),
				)
			}
		else:
			if items_step.values.length() > 4:
				st = add_tuple_arity_error(
					st,
					span_cover(start_span, right_step.span),
				)

			base_type: ParsedTypeExpr = if items_step.values.length() == 1:
				match items_step.values.get(0):
					Some(item):
						item
					None:
						ParsedMissingType(start_span)
			else:
				ParsedTupleType(
					items_step.values,
					span_cover(start_span, right_step.span),
				)

			parse_type_array_suffixes(st, base_type)


private pure func parse_pure_function_type_expr(state: CompilerParserState) -> ParseTypeStep:
	start_span: CompilerSourceSpan = current_span(state)
	var st: CompilerParserState = advance_parser(state)
	left_step: ParseSymbolStep = expect_symbol(
		st,
		LeftParenSymbol,
		"expected `(` after `pure` in function type",
	)
	st = left_step.state
	params_step: ParseTypeListStep = parse_type_expr_list_until(st, RightParenSymbol, True)
	right_step: ParseSymbolStep = expect_symbol(
		params_step.state,
		RightParenSymbol,
		"expected `)` after function type parameters",
	)
	st = right_step.state
	arrow_step: ParseSymbolStep = expect_symbol(
		st,
		ArrowSymbol,
		"expected `->` after function type parameters",
	)
	return_step: ParseTypeStep = parse_type_expr(arrow_step.state)

	{
		state = return_step.state,
		value = ParsedFunctionType(
			True,
			params_step.values,
			return_step.value,
			span_cover(start_span, parsed_type_expr_span(return_step.value)),
		)
	}


private pure func parse_range_type_expr(state: CompilerParserState) -> ParseTypeStep:
	start_span: CompilerSourceSpan = current_span(state)
	var st: CompilerParserState = advance_parser(state)

	if not current_is_symbol(st, HashSymbol) and not current_is_symbol(st, LeftParenSymbol):
		st = add_expected_error(
			st,
			current_span(st),
			"expected `#` dimension after `..`",
			["# dimension"],
			None,
		)

	dim_step: ParseTypeStep = parse_dim_expr(st)

	{
		state = dim_step.state,
		value = ParsedRangeType(
			dim_step.value,
			span_cover(start_span, parsed_type_expr_span(dim_step.value)),
		)
	}


private pure func token_index_starts_dim_atom(state: CompilerParserState, index: Int) -> Bool:
	match token_at(state, index).kind:
		SymbolToken(HashSymbol):
			True
		IntLiteralToken(_):
			True
		SymbolToken(LeftParenSymbol):
			token_index_starts_dim_atom(state, index + 1)
		_:
			False


private pure func starts_parenthesized_dim_expr(state: CompilerParserState) -> Bool:
	(
		current_is_symbol(state, LeftParenSymbol)
		and token_index_starts_dim_atom(state, state.index + 1)
	)


private pure func parse_type_expr_allow_bounds(
	state: CompilerParserState,
	allow_bounds: Bool,
) -> ParseTypeStep:
	token: CompilerToken = current_token(state)

	match token.kind:
		IdentifierToken(_):
			parse_named_type_expr_with_bounds(state, allow_bounds)
		KeywordToken(SelfKeyword):
			parse_named_type_expr_with_bounds(state, allow_bounds)
		KeywordToken(VoidKeyword):
			parse_named_type_expr_with_bounds(state, allow_bounds)
		KeywordToken(PureKeyword):
			parse_pure_function_type_expr(state)
		SymbolToken(HashSymbol):
			parse_dim_expr(state)
		IntLiteralToken(_):
			parse_dim_expr(state)
		SymbolToken(DotDotSymbol):
			parse_range_type_expr(state)
		SymbolToken(LeftParenSymbol):
			if starts_parenthesized_dim_expr(state):
				parse_dim_expr(state)
			else:
				parse_parenthesized_type_expr(state)
		_:
			next_state: CompilerParserState = add_expected_error(
				state,
				token.span,
				"expected type",
				[EXPECTED_TYPE],
				None,
			)

			recovery_state: CompilerParserState = if current_is_soft_boundary(next_state):
				next_state
			else:
				advance_parser(next_state)

			{
				state = recovery_state,
				value = ParsedMissingType(token.span)
			}


private pure func parse_type_expr(state: CompilerParserState) -> ParseTypeStep:
	parse_type_expr_allow_bounds(state, False)


private pure func param_span_from_start(
	start_span: CompilerSourceSpan,
	type_expr: Option[ParsedTypeExpr],
) -> CompilerSourceSpan:
	end_span: CompilerSourceSpan = match type_expr:
		Some(ty):
			parsed_type_expr_span(ty)
		None:
			start_span

	span_cover(start_span, end_span)


private pure func param_span(
	binder: ParsedParamBinder,
	type_expr: Option[ParsedTypeExpr],
) -> CompilerSourceSpan:
	param_span_from_start(parsed_param_binder_span(binder), type_expr)


private pure func parse_tuple_param(state: CompilerParserState) -> ParseParamStep:
	start_span: CompilerSourceSpan = current_span(state)
	binder_step: ParseTupleBinderStep = parse_tuple_binder_after_left_paren(
		advance_parser(state),
		start_span,
		TupleBinderNamesOnly,
		"tuple parameter name",
		"expected `,` between tuple parameter names",
		"expected tuple parameter name after `,`",
		"expected `)` after tuple parameter names",
	)
	type_step: ParseOptionalTypeStep = parse_optional_type_annotation(binder_step.state)
	binder: ParsedParamBinder = ParsedParamTupleBinder(binder_step.values, binder_step.span)

	{
		state = type_step.state,
		value = {
			binder = binder,
			type_expr = type_step.value,
			span = param_span(binder, type_step.value)
		}
	}


private pure func parse_named_or_wildcard_param(state: CompilerParserState) -> ParseParamStep:
	token: CompilerToken = current_token(state)

	match token.kind:
		SymbolToken(UnderscoreSymbol):
			underscore: ParsedIdentifier = parsed_identifier("_", token.span)
			type_step: ParseOptionalTypeStep = parse_optional_type_annotation(advance_parser(state))

			binder: ParsedParamBinder = match type_step.value:
				Some(_):
					ParsedParamNameBinder(underscore)
				None:
					ParsedParamWildcardBinder(token.span)

			{
				state = type_step.state,
				value = {
					binder = binder,
					type_expr = type_step.value,
					span = param_span(binder, type_step.value)
				}
			}
		_:
			name_step: ParseIdentifierStep = parse_identifier_expected(
				state,
				EXPECTED_PARAMETER_NAME,
			)
			type_step: ParseOptionalTypeStep = parse_optional_type_annotation(name_step.state)
			binder: ParsedParamBinder = ParsedParamNameBinder(name_step.value)

			{
				state = type_step.state,
				value = {
					binder = binder,
					type_expr = type_step.value,
					span = param_span(binder, type_step.value)
				}
			}


private pure func parse_param(state: CompilerParserState) -> ParseParamStep:
	if current_is_symbol(state, LeftParenSymbol):
		parse_tuple_param(state)
	else:
		parse_named_or_wildcard_param(state)


private pure func parse_params_after_left_paren(state: CompilerParserState) -> ParseParamsStep:
	var st: CompilerParserState = skip_newlines(state)
	var opened_indent: Bool = False
	var params: List[ParsedParam] = []

	if current_is_indent(st):
		opened_indent = True
		st = advance_parser(st)
		st = skip_newlines(st)

	if not current_is_symbol(st, RightParenSymbol):
		var parsing_params: Bool = True

		while parsing_params and not current_is_eof(st):
			param_step: ParseParamStep = parse_param(st)
			params = params.append(param_step.value)
			st = param_step.state

			if current_is_symbol(st, CommaSymbol):
				st = advance_parser(st)
				st = skip_newlines(st)

				if opened_indent and current_is_dedent(st):
					st = advance_parser(st)
					st = skip_newlines(st)

				if current_is_symbol(st, RightParenSymbol):
					parsing_params = False
			else:
				parsing_params = False

	st = skip_newlines(st)

	if opened_indent and current_is_dedent(st):
		st = advance_parser(st)
		st = skip_newlines(st)

	right_step: ParseSymbolStep = expect_symbol(
		st,
		RightParenSymbol,
		"expected `)` after function parameters",
	)

	{
		state = right_step.state,
		values = params
	}


private pure func parse_lambda_param(state: CompilerParserState) -> ParseLambdaParamStep:
	name_step: ParseIdentifierStep = parse_binder_identifier_expected(state, "lambda parameter")
	type_step: ParseOptionalTypeStep = parse_optional_type_annotation(name_step.state)

	{
		state = type_step.state,
		value = {
			name = name_step.value,
			type_expr = type_step.value,
			span = param_span_from_start(name_step.value.span, type_step.value)
		}
	}


private pure func parse_lambda_params_after_left_paren(
	state: CompilerParserState,
) -> ParseLambdaParamsStep:
	var st: CompilerParserState = skip_newlines(state)
	var opened_indent: Bool = False
	var params: List[ParsedLambdaParam] = []

	if current_is_indent(st):
		opened_indent = True
		st = advance_parser(st)
		st = skip_newlines(st)

	if not current_is_symbol(st, RightParenSymbol):
		var parsing_params: Bool = True

		while parsing_params and not current_is_eof(st):
			param_step: ParseLambdaParamStep = parse_lambda_param(st)
			params = params.append(param_step.value)
			st = param_step.state

			if current_is_symbol(st, CommaSymbol):
				st = advance_parser(st)
				st = skip_newlines(st)

				if opened_indent and current_is_dedent(st):
					st = advance_parser(st)
					st = skip_newlines(st)

				if current_is_symbol(st, RightParenSymbol):
					parsing_params = False
			else:
				parsing_params = False

	st = skip_newlines(st)

	if opened_indent and current_is_dedent(st):
		st = advance_parser(st)
		st = skip_newlines(st)

	right_step: ParseSymbolStep = expect_symbol(
		st,
		RightParenSymbol,
		"expected `)` after lambda parameters",
	)

	{
		state = right_step.state,
		values = params
	}


private pure func parse_identifier_list_until(
	state: CompilerParserState,
	end_symbol: CompilerSymbol,
	allow_empty: Bool,
	expected: String,
) -> ParseIdentifierListStep:
	var st: CompilerParserState = state
	var values: List[ParsedIdentifier] = []

	if allow_empty and current_is_symbol(st, end_symbol):
		{
			state = st,
			values = values
		}
	else:
		var parsing_values: Bool = True

		while parsing_values and not current_is_eof(st):
			item_step: ParseIdentifierStep = parse_identifier_expected(st, expected)
			values = values.append(item_step.value)
			st = item_step.state

			if current_is_symbol(st, CommaSymbol):
				st = advance_parser(st)

				if current_is_symbol(st, end_symbol):
					parsing_values = False
			else:
				parsing_values = False

		{
			state = st,
			values = values
		}


private pure func parse_type_expr_list_until(
	state: CompilerParserState,
	end_symbol: CompilerSymbol,
	allow_empty: Bool,
) -> ParseTypeListStep:
	var st: CompilerParserState = state
	var values: List[ParsedTypeExpr] = []

	if allow_empty and current_is_symbol(st, end_symbol):
		{
			state = st,
			values = values
		}
	else:
		var parsing_values: Bool = True

		while parsing_values and not current_is_eof(st):
			type_step: ParseTypeStep = parse_type_expr_allow_bounds(st, True)
			values = values.append(type_step.value)
			st = type_step.state

			if current_is_symbol(st, CommaSymbol):
				st = advance_parser(st)

				if current_is_symbol(st, end_symbol):
					parsing_values = False
			else:
				parsing_values = False

		{
			state = st,
			values = values
		}


private pure func parse_type_param_decl(state: CompilerParserState) -> ParseTypeParamStep:
	name_step: ParseIdentifierStep = if current_is_symbol(state, HashSymbol):
		parse_hash_identifier_expected(state, "dimension parameter")
	else:
		parse_identifier_expected(state, "type parameter")

	var st: CompilerParserState = name_step.state
	var bounds: List[ParsedIdentifier] = []
	var end_span: CompilerSourceSpan = name_step.value.span

	if current_is_symbol(st, ColonSymbol):
		bounds_step: ParseIdentifierListStep = parse_bound_identifier_list(
			advance_parser(st),
			"trait bound",
		)
		bounds = bounds_step.values
		st = bounds_step.state
		end_span = last_identifier_span(bounds, end_span)

	{
		state = st,
		value = {
			name = name_step.value,
			bounds = bounds,
			span = span_cover(name_step.value.span, end_span)
		}
	}


private pure func parse_type_param_list_until(
	state: CompilerParserState,
	end_symbol: CompilerSymbol,
	allow_empty: Bool,
) -> ParseTypeParamListStep:
	var st: CompilerParserState = state
	var values: List[ParsedTypeParamDecl] = []

	if allow_empty and current_is_symbol(st, end_symbol):
		{
			state = st,
			values = values
		}
	else:
		var parsing_values: Bool = True

		while parsing_values and not current_is_eof(st):
			item_step: ParseTypeParamStep = parse_type_param_decl(st)
			values = values.append(item_step.value)
			st = item_step.state

			if current_is_symbol(st, CommaSymbol):
				st = advance_parser(st)

				if current_is_symbol(st, end_symbol):
					parsing_values = False
			else:
				parsing_values = False

		{
			state = st,
			values = values
		}


private pure func parse_type_params_opt(state: CompilerParserState) -> ParseTypeParamListStep:
	if current_is_symbol(state, LeftBracketSymbol):
		items_step: ParseTypeParamListStep = parse_type_param_list_until(
			advance_parser(state),
			RightBracketSymbol,
			True,
		)
		right_step: ParseSymbolStep = expect_symbol(
			items_step.state,
			RightBracketSymbol,
			"expected `]` after type parameters",
		)

		{
			state = right_step.state,
			values = items_step.values
		}
	else:
		{
			state = state,
			values = []
		}


private pure func parse_binder_identifier_expected(
	state: CompilerParserState,
	expected: String,
) -> ParseIdentifierStep:
	token: CompilerToken = current_token(state)

	match token.kind:
		IdentifierToken(text):
			{
				state = advance_parser(state),
				value = parsed_identifier(text, token.span)
			}
		SymbolToken(UnderscoreSymbol):
			{
				state = advance_parser(state),
				value = parsed_identifier("_", token.span)
			}
		_:
			parse_identifier_expected(state, expected)


private pure func parse_select_receive_identifier_expected(
	state: CompilerParserState,
	expected: String,
) -> ParseIdentifierStep:
	token: CompilerToken = current_token(state)

	match token.kind:
		IdentifierToken(text):
			{
				state = advance_parser(state),
				value = parsed_identifier(text, token.span)
			}
		SymbolToken(UnderscoreSymbol):
			{
				state = advance_parser(state),
				value = parsed_identifier("_", token.span)
			}
		KeywordToken(AfterKeyword):
			{
				state = advance_parser(state),
				value = parsed_identifier("after", token.span)
			}
		KeywordToken(FromKeyword):
			{
				state = advance_parser(state),
				value = parsed_identifier("from", token.span)
			}
		_:
			parse_identifier_expected(state, expected)


private pure func current_infix_info(state: CompilerParserState) -> Option[ParsedInfixInfo]:
	match current_token(state).kind:
		KeywordToken(OrKeyword):
			Some({
				precedence = PREC_OR,
				op = ParsedLogicalInfix(ParsedOrOp),
			})
		KeywordToken(AndKeyword):
			Some({
				precedence = PREC_AND,
				op = ParsedLogicalInfix(ParsedAndOp),
			})
		SymbolToken(EqualEqualSymbol):
			Some({
				precedence = PREC_COMPARE,
				op = ParsedBinaryInfix(ParsedEqualOp),
			})
		SymbolToken(NotEqualSymbol):
			Some({
				precedence = PREC_COMPARE,
				op = ParsedBinaryInfix(ParsedNotEqualOp),
			})
		SymbolToken(LessSymbol):
			Some({
				precedence = PREC_COMPARE,
				op = ParsedBinaryInfix(ParsedLessOp),
			})
		SymbolToken(LessEqualSymbol):
			Some({
				precedence = PREC_COMPARE,
				op = ParsedBinaryInfix(ParsedLessEqualOp),
			})
		SymbolToken(GreaterSymbol):
			Some({
				precedence = PREC_COMPARE,
				op = ParsedBinaryInfix(ParsedGreaterOp),
			})
		SymbolToken(GreaterEqualSymbol):
			Some({
				precedence = PREC_COMPARE,
				op = ParsedBinaryInfix(ParsedGreaterEqualOp),
			})
		SymbolToken(DotDotSymbol):
			Some({
				precedence = PREC_RANGE,
				op = ParsedRangeInfix,
			})
		SymbolToken(PlusSymbol):
			Some({
				precedence = PREC_ADD,
				op = ParsedBinaryInfix(ParsedAddOp),
			})
		SymbolToken(MinusSymbol):
			Some({
				precedence = PREC_ADD,
				op = ParsedBinaryInfix(ParsedSubtractOp),
			})
		SymbolToken(StarSymbol):
			Some({
				precedence = PREC_MULTIPLY,
				op = ParsedBinaryInfix(ParsedMultiplyOp),
			})
		SymbolToken(SlashSymbol):
			Some({
				precedence = PREC_MULTIPLY,
				op = ParsedBinaryInfix(ParsedDivideOp),
			})
		SymbolToken(PercentSymbol):
			Some({
				precedence = PREC_MULTIPLY,
				op = ParsedBinaryInfix(ParsedModuloOp),
			})
		_:
			None


private pure func current_compound_assign_op(
	state: CompilerParserState,
) -> Option[ParsedCompoundAssignOp]:
	match current_token(state).kind:
		SymbolToken(PlusEqualSymbol):
			Some(ParsedAssignAddOp)
		SymbolToken(MinusEqualSymbol):
			Some(ParsedAssignSubtractOp)
		SymbolToken(StarEqualSymbol):
			Some(ParsedAssignMultiplyOp)
		SymbolToken(SlashEqualSymbol):
			Some(ParsedAssignDivideOp)
		_:
			None


private pure func current_can_start_assignment_tail(state: CompilerParserState) -> Bool:
	(
		current_is_symbol(state, EqualSymbol)
		or current_is_symbol(state, QuestionEqualsSymbol)
		or current_compound_assign_op(state).is_some()
	)


private pure func colon_starts_typed_assignment(state: CompilerParserState) -> Bool:
	var index: Int = state.index + 1
	var depth: Int = 0
	var found_assignment: Bool = False
	var scanning: Bool = True

	while scanning and not found_assignment:
		token: CompilerToken = token_at(state, index)

		match token.kind:
			EndOfFileToken:
				scanning = False
			NewlineToken:
				scanning = False
			DedentToken:
				scanning = False
			SymbolToken(EqualSymbol):
				if depth == 0:
					found_assignment = True
				else:
					index += 1
			SymbolToken(QuestionEqualsSymbol):
				if depth == 0:
					found_assignment = True
				else:
					index += 1
			SymbolToken(LeftParenSymbol):
				depth += 1
				index += 1
			SymbolToken(LeftBracketSymbol):
				depth += 1
				index += 1
			SymbolToken(LeftBraceSymbol):
				depth += 1
				index += 1
			SymbolToken(RightParenSymbol):
				if depth == 0:
					scanning = False
				else:
					depth -= 1
					index += 1
			SymbolToken(RightBracketSymbol):
				if depth == 0:
					scanning = False
				else:
					depth -= 1
					index += 1
			SymbolToken(RightBraceSymbol):
				if depth == 0:
					scanning = False
				else:
					depth -= 1
					index += 1
			SymbolToken(CommaSymbol):
				if depth == 0:
					scanning = False
				else:
					index += 1
			SymbolToken(ColonSymbol):
				if depth == 0:
					scanning = False
				else:
					index += 1
			_:
				index += 1

	found_assignment


private pure func expr_list_has_leading_dot_postfix_continuation(items: List[ParsedExpr]) -> Bool:
	var found: Bool = False

	for item in items:
		if parsed_expr_has_leading_dot_postfix_continuation(item):
			found = True
			break

	found


private pure func parsed_expr_has_leading_dot_postfix_continuation(expr: ParsedExpr) -> Bool:
	match expr:
		ParsedFieldAccessExpr(target, _, span):
			target_span: CompilerSourceSpan = parsed_expr_span(target)

			(
				span.end_line > target_span.end_line
				or parsed_expr_has_leading_dot_postfix_continuation(target)
			)
		ParsedCallExpr(callee, args, _):
			(
				parsed_expr_has_leading_dot_postfix_continuation(callee)
				or expr_list_has_leading_dot_postfix_continuation(args)
			)
		ParsedSubscriptExpr(target, indices, _):
			(
				parsed_expr_has_leading_dot_postfix_continuation(target)
				or expr_list_has_leading_dot_postfix_continuation(indices)
			)
		ParsedBinaryExpr(_, left, right, _):
			(
				parsed_expr_has_leading_dot_postfix_continuation(left)
				or parsed_expr_has_leading_dot_postfix_continuation(right)
			)
		ParsedLogicalExpr(_, left, right, _):
			(
				parsed_expr_has_leading_dot_postfix_continuation(left)
				or parsed_expr_has_leading_dot_postfix_continuation(right)
			)
		ParsedAscriptionExpr(value, _, _):
			parsed_expr_has_leading_dot_postfix_continuation(value)
		_:
			False


private pure func parsed_expr_needs_leading_dot_continuation_dedent(expr: ParsedExpr) -> Bool:
	match expr:
		ParsedBinaryExpr(_, left, right, _):
			(
				parsed_expr_has_leading_dot_postfix_continuation(left)
				or parsed_expr_needs_leading_dot_continuation_dedent(right)
			)
		ParsedLogicalExpr(_, left, right, _):
			(
				parsed_expr_has_leading_dot_postfix_continuation(left)
				or parsed_expr_needs_leading_dot_continuation_dedent(right)
			)
		ParsedAscriptionExpr(value, _, _):
			parsed_expr_has_leading_dot_postfix_continuation(value)
		_:
			False


private pure func consume_leading_dot_postfix_continuation_dedent(
	state: CompilerParserState,
	value: ParsedExpr,
) -> CompilerParserState:
	after_value: CompilerParserState = skip_newlines(state)

	if current_is_dedent(after_value) and parsed_expr_needs_leading_dot_continuation_dedent(value):
		advance_parser(after_value)
	else:
		after_value


private pure func parse_header_anchored_expression(
	state: CompilerParserState,
	header_span: CompilerSourceSpan,
) -> ParseExprStep:
	if current_is_keyword(state, IfKeyword):
		parse_if_expr_with_header_span(state, header_span)
	else if current_is_keyword(state, MatchKeyword):
		parse_match_expr_with_header_span(state, header_span)
	else if current_is_keyword(state, SelectKeyword):
		parse_select_expr_with_header_span(state, header_span)
	else if current_is_keyword(state, ForKeyword):
		parse_for_expr_with_header_span(state, header_span)
	else if current_is_keyword(state, FuncKeyword) or current_is_keyword(state, PureKeyword):
		parse_lambda_expr_with_header_span(state, header_span)
	else:
		parse_expression_with_header_span(state, PREC_LOWEST, header_span)


private pure func parse_assignment_inline_value_expr(
	state: CompilerParserState,
	header_span: CompilerSourceSpan,
) -> ParseExprStep:
	parse_header_anchored_expression(state, header_span)


private pure func parse_assignment_value_expr(
	state: CompilerParserState,
	header_span: CompilerSourceSpan,
) -> ParseExprStep:
	if current_is_newline(state):
		var st: CompilerParserState = advance_parser(state)

		if current_is_indent(st):
			st = advance_parser(st)
		else:
			st = add_expected_error(
				st,
				current_span(st),
				"expected indented assignment value",
				["indent"],
				None,
			)

		value_step: ParseExprStep = parse_expression(st, PREC_LOWEST)
		after_value: CompilerParserState = skip_newlines(value_step.state)

		final_state: CompilerParserState = if current_is_dedent(after_value):
			advance_parser(after_value)
		else:
			after_value

		{
			state = final_state,
			value = value_step.value
		}
	else:
		value_step: ParseExprStep = parse_assignment_inline_value_expr(state, header_span)

		{
			state = consume_leading_dot_postfix_continuation_dedent(
				value_step.state,
				value_step.value,
			),
			value = value_step.value
		}


private pure func parse_optional_type_annotation(
	state: CompilerParserState,
) -> ParseOptionalTypeStep:
	if current_is_symbol(state, ColonSymbol):
		type_step: ParseTypeStep = parse_type_expr(advance_parser(state))

		{
			state = type_step.state,
			value = Some(type_step.value)
		}
	else:
		{
			state = state,
			value = None
		}


private pure func make_infix_expr(
	info: ParsedInfixInfo,
	left: ParsedExpr,
	right: ParsedExpr,
) -> ParsedExpr:
	span: CompilerSourceSpan = span_cover(parsed_expr_span(left), parsed_expr_span(right))

	match info.op:
		ParsedBinaryInfix(op):
			ParsedBinaryExpr(op, left, right, span)
		ParsedLogicalInfix(op):
			ParsedLogicalExpr(op, left, right, span)
		ParsedRangeInfix:
			ParsedRangeExpr(left, right, span)


private pure func layout_reaches_end_symbol(
	state: CompilerParserState,
	end_symbol: CompilerSymbol,
) -> Bool:
	var index: Int = state.index
	var scanning: Bool = True

	while scanning:
		match token_at(state, index).kind:
			NewlineToken:
				index += 1
			DedentToken:
				index += 1
			_:
				scanning = False

	token_kind_is_symbol(token_at(state, index).kind, end_symbol)


private pure func consume_layout_before_end_symbol(
	state: CompilerParserState,
	end_symbol: CompilerSymbol,
) -> CompilerParserState:
	var st: CompilerParserState = state

	if layout_reaches_end_symbol(st, end_symbol):
		var consuming_layout: Bool = True

		while consuming_layout:
			if current_is_newline(st) or current_is_dedent(st):
				st = advance_parser(st)
			else:
				consuming_layout = False

	st


private pure func parse_expr_list_until(
	state: CompilerParserState,
	end_symbol: CompilerSymbol,
	allow_empty: Bool,
	header_span: CompilerSourceSpan,
) -> ParseExprListStep:
	var st: CompilerParserState = state
	var values: List[ParsedExpr] = []

	if allow_empty and current_is_symbol(st, end_symbol):
		{
			state = st,
			values = values
		}
	else:
		var parsing_values: Bool = True

		while parsing_values and not current_is_eof(st):
			expr_step: ParseExprStep = parse_header_anchored_expression(st, header_span)
			values = values.append(expr_step.value)
			st = expr_step.state

			if current_is_symbol(st, CommaSymbol):
				st = skip_newlines(advance_parser(st))
				st = consume_layout_before_end_symbol(st, end_symbol)

				if current_is_symbol(st, end_symbol):
					parsing_values = False
			else:
				parsing_values = False

		{
			state = st,
			values = values
		}


private pure func parse_pattern_list_until(
	state: CompilerParserState,
	end_symbol: CompilerSymbol,
	allow_empty: Bool,
) -> ParsePatternListStep:
	var st: CompilerParserState = state
	var values: List[ParsedPattern] = []

	if allow_empty and current_is_symbol(st, end_symbol):
		{
			state = st,
			values = values
		}
	else:
		var parsing_values: Bool = True

		while parsing_values and not current_is_eof(st):
			pattern_step: ParsePatternStep = parse_pattern(st)
			values = values.append(pattern_step.value)
			st = pattern_step.state

			if current_is_symbol(st, CommaSymbol):
				st = advance_parser(st)

				if current_is_symbol(st, end_symbol):
					parsing_values = False
			else:
				parsing_values = False

		{
			state = st,
			values = values
		}


private pure func add_tuple_pattern_arity_error(
	state: CompilerParserState,
	span: CompilerSourceSpan,
) -> CompilerParserState:
	add_expected_error(state, span, "Tuples support 2-4 elements", ["2-4 tuple elements"], None)


private pure func add_tuple_arity_error(
	state: CompilerParserState,
	span: CompilerSourceSpan,
) -> CompilerParserState:
	add_expected_error(state, span, "Tuples support 2-4 elements", ["2-4 tuple elements"], None)


private pure func parse_tuple_pattern_after_left_paren(
	state: CompilerParserState,
	start_span: CompilerSourceSpan,
) -> ParsePatternStep:
	first_step: ParsePatternStep = parse_pattern(state)
	var st: CompilerParserState = first_step.state
	var items: List[ParsedPattern] = [first_step.value]
	var end_span: CompilerSourceSpan = parsed_pattern_span(first_step.value)

	comma_step: ParseSymbolStep = expect_symbol(
		st,
		CommaSymbol,
		"expected `,` between tuple pattern items",
	)
	st = comma_step.state

	if comma_step.matched:
		rest_step: ParsePatternListStep = parse_pattern_list_until(st, RightParenSymbol, True)
		items = items.concat(rest_step.values)
		st = rest_step.state

		match rest_step.values.get(rest_step.values.length() - 1):
			Some(last):
				end_span = parsed_pattern_span(last)
			None:
				end_span = comma_step.span

	right_step: ParseSymbolStep = expect_symbol(
		st,
		RightParenSymbol,
		"expected `)` after tuple pattern",
	)
	st = right_step.state

	if right_step.matched:
		end_span = right_step.span

	if items.length() < 2 or items.length() > 4:
		st = add_tuple_pattern_arity_error(
			st,
			span_cover(start_span, end_span),
		)

	{
		state = st,
		value = ParsedTuplePattern(
			items,
			span_cover(start_span, end_span),
		)
	}


private pure func parse_list_pattern_spread_after_dotdotdot(
	state: CompilerParserState,
	start_span: CompilerSourceSpan,
) -> ParseListPatternSpreadStep:
	token: CompilerToken = current_token(state)

	match token.kind:
		IdentifierToken(text):
			name: ParsedIdentifier = parsed_identifier(text, token.span)
			{
				state = advance_parser(state),
				value = ParsedListSpreadName(name),
				span = span_cover(start_span, token.span)
			}
		SymbolToken(UnderscoreSymbol):
			{
				state = advance_parser(state),
				value = ParsedListSpreadWildcard(token.span),
				span = span_cover(start_span, token.span)
			}
		_:
			next_state: CompilerParserState = add_expected_error(
				state,
				token.span,
				"expected list pattern spread target",
				["identifier", "_"],
				None,
			)

			recovery_state: CompilerParserState = if current_is_soft_boundary(next_state):
				next_state
			else:
				advance_parser(next_state)

			{
				state = recovery_state,
				value = ParsedListSpreadWildcard(token.span),
				span = span_cover(start_span, token.span)
			}


private pure func parse_list_pattern_after_left_bracket(
	state: CompilerParserState,
	start_span: CompilerSourceSpan,
) -> ParsePatternStep:
	var st: CompilerParserState = state
	var items: List[ParsedPattern] = []
	var spread: Option[ParsedListPatternSpread] = None
	var end_span: CompilerSourceSpan = start_span

	if not current_is_symbol(st, RightBracketSymbol):
		if current_is_symbol(st, DotDotDotSymbol):
			dots_span: CompilerSourceSpan = current_span(st)
			spread_step: ParseListPatternSpreadStep = parse_list_pattern_spread_after_dotdotdot(
				advance_parser(st),
				dots_span,
			)
			spread = Some(spread_step.value)
			end_span = spread_step.span
			st = spread_step.state
		else:
			var parsing_items: Bool = True

			while parsing_items and not current_is_eof(st):
				pattern_step: ParsePatternStep = parse_pattern(st)
				items = items.append(pattern_step.value)
				st = pattern_step.state
				end_span = parsed_pattern_span(pattern_step.value)

				if current_is_symbol(st, CommaSymbol):
					st = advance_parser(st)

					if current_is_symbol(st, DotDotDotSymbol):
						dots_span: CompilerSourceSpan = current_span(st)
						spread_step: ParseListPatternSpreadStep = parse_list_pattern_spread_after_dotdotdot(
							advance_parser(st),
							dots_span,
						)
						spread = Some(spread_step.value)
						end_span = spread_step.span
						st = spread_step.state
						parsing_items = False
				else:
					parsing_items = False

	right_step: ParseSymbolStep = expect_symbol(
		st,
		RightBracketSymbol,
		"expected `]` after list pattern",
	)
	st = right_step.state

	if right_step.matched:
		end_span = right_step.span

	{
		state = st,
		value = ParsedListPattern(
			items,
			spread,
			span_cover(start_span, end_span),
		)
	}


private pure func parse_simple_pattern(state: CompilerParserState) -> ParsePatternStep:
	token: CompilerToken = current_token(state)

	match token.kind:
		SymbolToken(UnderscoreSymbol):
			{
				state = advance_parser(state),
				value = ParsedWildcardPattern(token.span)
			}
		IdentifierToken(text):
			name: ParsedIdentifier = parsed_identifier(text, token.span)
			var st: CompilerParserState = advance_parser(state)

			if current_is_symbol(st, DotSymbol):
				constructor_step: ParseIdentifierStep = parse_identifier_expected(
					advance_parser(st),
					EXPECTED_CONSTRUCTOR_NAME,
				)
				constructor_name: ParsedIdentifier = constructor_step.value
				st = constructor_step.state
				var args: List[ParsedPattern] = []
				var end_span: CompilerSourceSpan = constructor_name.span

				if current_is_symbol(st, LeftParenSymbol):
					args_step: ParsePatternListStep = parse_pattern_list_until(
						advance_parser(st),
						RightParenSymbol,
						True,
					)
					right_step: ParseSymbolStep = expect_symbol(
						args_step.state,
						RightParenSymbol,
						"expected `)` after constructor pattern",
					)
					st = right_step.state
					args = args_step.values

					if right_step.matched:
						end_span = right_step.span

				result: ParsePatternStep = {
					state = st,
					value = ParsedQualifiedConstructorPattern(
						name,
						constructor_name,
						args,
						span_cover(name.span, end_span),
					)
				}
				result
			else if current_is_symbol(st, LeftParenSymbol):
				args_step: ParsePatternListStep = parse_pattern_list_until(
					advance_parser(st),
					RightParenSymbol,
					True,
				)
				right_step: ParseSymbolStep = expect_symbol(
					args_step.state,
					RightParenSymbol,
					"expected `)` after constructor pattern",
				)

				end_span: CompilerSourceSpan = if right_step.matched:
					right_step.span
				else:
					name.span

				result: ParsePatternStep = {
					state = right_step.state,
					value = ParsedConstructorPattern(
						name,
						args_step.values,
						span_cover(name.span, end_span),
					)
				}
				result
			else:
				result: ParsePatternStep = {
					state = st,
					value = ParsedNamePattern(name)
				}
				result
		KeywordToken(keyword):
			match soft_keyword_identifier_text(keyword):
				Some(text):
					{
						state = advance_parser(state),
						value = ParsedNamePattern(parsed_identifier(text, token.span))
					}
				None:
					next_state: CompilerParserState = add_expected_error(
						state,
						token.span,
						"expected pattern",
						["pattern"],
						None,
					)

					recovery_state: CompilerParserState = if current_is_soft_boundary(next_state):
						next_state
					else:
						advance_parser(next_state)

					{
						state = recovery_state,
						value = ParsedMissingPattern(token.span)
					}
		SymbolToken(LeftParenSymbol):
			parse_tuple_pattern_after_left_paren(advance_parser(state), token.span)
		SymbolToken(LeftBracketSymbol):
			parse_list_pattern_after_left_bracket(advance_parser(state), token.span)
		IntLiteralToken(text):
			{
				state = advance_parser(state),
				value = ParsedIntPattern(text, token.span)
			}
		FloatLiteralToken(text):
			{
				state = advance_parser(state),
				value = ParsedFloatPattern(text, token.span)
			}
		StringLiteralToken(kind, text):
			{
				state = advance_parser(state),
				value = ParsedStringPattern(text, parsed_string_literal_form(kind), token.span)
			}
		CharLiteralToken(codepoint):
			{
				state = advance_parser(state),
				value = ParsedCharPattern(codepoint, token.span)
			}
		KeywordToken(TrueKeyword):
			{
				state = advance_parser(state),
				value = ParsedBoolPattern(True, token.span)
			}
		KeywordToken(FalseKeyword):
			{
				state = advance_parser(state),
				value = ParsedBoolPattern(False, token.span)
			}
		SymbolToken(MinusSymbol):
			next_token: CompilerToken = token_at(state, state.index + 1)

			match next_token.kind:
				IntLiteralToken(text):
					{
						state = advance_parser(advance_parser(state)),
						value = ParsedIntPattern(
							"-" + text,
							span_cover(token.span, next_token.span),
						)
					}
				FloatLiteralToken(text):
					{
						state = advance_parser(advance_parser(state)),
						value = ParsedFloatPattern(
							"-" + text,
							span_cover(token.span, next_token.span),
						)
					}
				_:
					next_state: CompilerParserState = add_expected_error(
						state,
						token.span,
						"expected numeric literal after `-` in pattern",
						["integer literal", "float literal"],
						None,
					)

					{
						state = advance_parser(next_state),
						value = ParsedMissingPattern(token.span)
					}
		_:
			next_state: CompilerParserState = add_expected_error(
				state,
				token.span,
				"expected pattern",
				["pattern"],
				None,
			)

			recovery_state: CompilerParserState = if current_is_soft_boundary(next_state):
				next_state
			else:
				advance_parser(next_state)

			{
				state = recovery_state,
				value = ParsedMissingPattern(token.span)
			}


private pure func parse_pattern(state: CompilerParserState) -> ParsePatternStep:
	first_step: ParsePatternStep = parse_simple_pattern(state)
	var st: CompilerParserState = first_step.state
	var patterns: List[ParsedPattern] = [first_step.value]
	var end_span: CompilerSourceSpan = parsed_pattern_span(first_step.value)

	while current_is_symbol(st, PipeSymbol) and not current_is_eof(st):
		next_step: ParsePatternStep = parse_simple_pattern(advance_parser(st))
		patterns = patterns.append(next_step.value)
		st = next_step.state
		end_span = parsed_pattern_span(next_step.value)

	if patterns.length() == 1:
		first_step
	else:
		{
			state = st,
			value = ParsedOrPattern(
				patterns,
				span_cover(parsed_pattern_span(first_step.value), end_span),
			)
		}


private pure func last_expr_span(
	items: List[ParsedExpr],
	fallback: CompilerSourceSpan,
) -> CompilerSourceSpan:
	var span: CompilerSourceSpan = fallback

	for item in items:
		span = parsed_expr_span(item)

	span


private pure func first_expr_span(
	items: List[ParsedExpr],
	fallback: CompilerSourceSpan,
) -> CompilerSourceSpan:
	match items.get(0):
		Some(item):
			parsed_expr_span(item)
		None:
			fallback


private pure func make_block_expr(
	items: List[ParsedExpr],
	start_span: CompilerSourceSpan,
	end_span: CompilerSourceSpan,
) -> ParsedExpr:
	ParsedBlockExpr(
		items,
		span_cover(start_span, end_span),
	)


private pure func current_token_is_indented_past(
	state: CompilerParserState,
	header_span: CompilerSourceSpan,
) -> Bool:
	(
		not current_is_eof(state)
		and not current_is_dedent(state)
		and current_span(state).start_line > header_span.start_line
		and current_span(state).start_column > header_span.start_column
	)


private pure func consume_block_indent(
	state: CompilerParserState,
	header_span: CompilerSourceSpan,
) -> CompilerParserState:
	st: CompilerParserState = skip_newlines(state)

	if current_is_indent(st):
		advance_parser(st)
	else if current_token_is_indented_past(st, header_span):
		st
	else:
		expect_indent(st)


private pure func parse_statement_list(
	state: CompilerParserState,
	header_span: CompilerSourceSpan,
) -> ParseExprListStep:
	var st: CompilerParserState = skip_newlines(state)
	var values: List[ParsedExpr] = []

	while current_token_is_indented_past(st, header_span) and not current_is_block_end(st):
		before_index: Int = st.index
		statement_step: ParseExprStep = parse_statement(st)
		values = values.append(statement_step.value)
		st = skip_newlines(statement_step.state)

		if (
			st.index == before_index
			and current_token_is_indented_past(st, header_span)
			and not current_is_block_end(st)
		):
			st = advance_parser(st)

	{
		state = st,
		values = values
	}


private pure func parse_indented_block_body(
	state: CompilerParserState,
	start_span: CompilerSourceSpan,
) -> ParseExprStep:
	var st: CompilerParserState = consume_block_indent(state, start_span)
	st = skip_newlines(st)
	items_step: ParseExprListStep = parse_statement_list(st, start_span)
	st = items_step.state

	block_start_span: CompilerSourceSpan = first_expr_span(items_step.values, start_span)
	block_end_span: CompilerSourceSpan = last_expr_span(items_step.values, block_start_span)

	if current_is_dedent(st):
		st = expect_dedent(st)

	{
		state = st,
		value = make_block_expr(items_step.values, block_start_span, block_end_span)
	}


private pure func parse_block_after_colon(
	state: CompilerParserState,
	start_span: CompilerSourceSpan,
) -> ParseExprStep:
	parse_indented_block_body(
		expect_newline(state, "expected newline before indented block"),
		start_span,
	)


private pure func parse_if_expr_with_header_span(
	state: CompilerParserState,
	header_span: CompilerSourceSpan,
) -> ParseExprStep:
	start_span: CompilerSourceSpan = current_span(state)
	cond_step: ParseExprStep = parse_expression(advance_parser(state), PREC_LOWEST)
	colon_step: ParseSymbolStep = expect_symbol(
		cond_step.state,
		ColonSymbol,
		"expected `:` after if condition",
	)
	then_step: ParseExprStep = parse_block_after_colon(colon_step.state, header_span)
	var st: CompilerParserState = then_step.state
	var else_branch: Option[ParsedExpr] = None
	var end_span: CompilerSourceSpan = parsed_expr_span(then_step.value)

	if current_is_keyword(st, ElseKeyword):
		else_span: CompilerSourceSpan = current_span(st)
		st = advance_parser(st)

		if current_is_keyword(st, IfKeyword):
			else_if_step: ParseExprStep = parse_if_expr_with_header_span(st, else_span)
			else_branch = Some(else_if_step.value)
			st = else_if_step.state
			end_span = parsed_expr_span(else_if_step.value)
		else:
			else_colon_step: ParseSymbolStep = expect_symbol(
				st,
				ColonSymbol,
				"expected `:` after else",
			)
			else_step: ParseExprStep = parse_block_after_colon(else_colon_step.state, else_span)
			else_branch = Some(else_step.value)
			st = else_step.state
			end_span = parsed_expr_span(else_step.value)

	{
		state = st,
		value = ParsedIfExpr(
			cond_step.value,
			then_step.value,
			else_branch,
			span_cover(start_span, end_span),
		)
	}


private pure func parse_if_expr(state: CompilerParserState) -> ParseExprStep:
	parse_if_expr_with_header_span(state, current_span(state))


private pure func parse_match_case(state: CompilerParserState) -> ParseMatchCaseStep:
	pattern_step: ParsePatternStep = parse_pattern(state)
	colon_step: ParseSymbolStep = expect_symbol(
		pattern_step.state,
		ColonSymbol,
		"expected `:` after match pattern",
	)

	body_step: ParseExprStep = if current_is_newline(colon_step.state):
		parse_block_after_colon(colon_step.state, parsed_pattern_span(pattern_step.value))
	else if current_is_keyword(colon_step.state, MatchKeyword):
		parse_match_expr_with_header_span(colon_step.state, parsed_pattern_span(pattern_step.value))
	else if current_is_keyword(colon_step.state, IfKeyword):
		parse_if_expr_with_header_span(colon_step.state, parsed_pattern_span(pattern_step.value))
	else:
		parse_statement(colon_step.state)

	{
		state = body_step.state,
		value = {
			pattern = pattern_step.value,
			body = body_step.value,
			span = span_cover(
				parsed_pattern_span(pattern_step.value),
				parsed_expr_span(body_step.value),
			)
		}
	}


private pure func parse_match_case_list(
	state: CompilerParserState,
	header_span: CompilerSourceSpan,
) -> ParseMatchCaseListStep:
	var st: CompilerParserState = skip_newlines(state)
	var cases: List[ParsedMatchCase] = []

	while current_token_is_indented_past(st, header_span) and not current_is_block_end(st):
		before_index: Int = st.index
		case_step: ParseMatchCaseStep = parse_match_case(st)
		cases = cases.append(case_step.value)
		st = skip_newlines(case_step.state)

		if (
			st.index == before_index
			and current_token_is_indented_past(st, header_span)
			and not current_is_block_end(st)
		):
			st = advance_parser(st)

	{
		state = st,
		values = cases
	}


private pure func parse_match_expr_with_header_span(
	state: CompilerParserState,
	header_span: CompilerSourceSpan,
) -> ParseExprStep:
	start_span: CompilerSourceSpan = current_span(state)
	scrutinee_step: ParseExprStep = parse_expression(advance_parser(state), PREC_LOWEST)
	colon_step: ParseSymbolStep = expect_symbol(
		scrutinee_step.state,
		ColonSymbol,
		"expected `:` after match expression",
	)
	var st: CompilerParserState = expect_newline(
		colon_step.state,
		"expected newline before match cases",
	)
	st = consume_block_indent(st, header_span)
	cases_step: ParseMatchCaseListStep = parse_match_case_list(st, header_span)
	st = cases_step.state

	end_span: CompilerSourceSpan = if current_is_dedent(st):
		current_span(st)
	else:
		start_span

	if current_is_dedent(st):
		st = expect_dedent(st)

	{
		state = st,
		value = ParsedMatchExpr(
			scrutinee_step.value,
			cases_step.values,
			span_cover(start_span, end_span),
		)
	}


private pure func parse_match_expr(state: CompilerParserState) -> ParseExprStep:
	parse_match_expr_with_header_span(state, current_span(state))


private pure func parse_select_receive_arm(
	state: CompilerParserState,
	start_span: CompilerSourceSpan,
) -> ParseSelectArmStep:
	binder_step: ParseIdentifierStep = parse_select_receive_identifier_expected(
		state,
		"select receive binding",
	)
	var st: CompilerParserState = expect_keyword(
		binder_step.state,
		FromKeyword,
		"from",
		"expected `from` after select receive binding",
	)
	channel_step: ParseExprStep = parse_expression(st, PREC_LOWEST)
	colon_step: ParseSymbolStep = expect_symbol(
		channel_step.state,
		ColonSymbol,
		"expected `:` after select receive channel",
	)
	body_step: ParseExprStep = parse_block_after_colon(colon_step.state, start_span)

	{
		state = body_step.state,
		value = {
			kind = ParsedSelectReceiveArm(binder_step.value, channel_step.value),
			body = body_step.value,
			span = span_cover(start_span, parsed_expr_span(body_step.value))
		}
	}


private pure func parse_select_sealed_arm(
	state: CompilerParserState,
	start_span: CompilerSourceSpan,
) -> ParseSelectArmStep:
	channel_step: ParseExprStep = parse_expression(advance_parser(state), PREC_LOWEST)
	colon_step: ParseSymbolStep = expect_symbol(
		channel_step.state,
		ColonSymbol,
		"expected `:` after sealed select channel",
	)
	body_step: ParseExprStep = parse_block_after_colon(colon_step.state, start_span)

	{
		state = body_step.state,
		value = {
			kind = ParsedSelectSealedArm(channel_step.value),
			body = body_step.value,
			span = span_cover(start_span, parsed_expr_span(body_step.value))
		}
	}


private pure func parse_select_after_arm(
	state: CompilerParserState,
	start_span: CompilerSourceSpan,
) -> ParseSelectArmStep:
	var st: CompilerParserState = advance_parser(state)
	st = expect_keyword(st, AfterKeyword, "after", "expected `after` in select timeout arm")
	timeout_step: ParseExprStep = parse_expression(st, PREC_LOWEST)
	colon_step: ParseSymbolStep = expect_symbol(
		timeout_step.state,
		ColonSymbol,
		"expected `:` after select timeout",
	)
	body_step: ParseExprStep = parse_block_after_colon(colon_step.state, start_span)

	{
		state = body_step.state,
		value = {
			kind = ParsedSelectAfterArm(timeout_step.value),
			body = body_step.value,
			span = span_cover(start_span, parsed_expr_span(body_step.value))
		}
	}


private pure func parse_select_arm(state: CompilerParserState) -> ParseSelectArmStep:
	start_span: CompilerSourceSpan = current_span(state)

	if current_is_keyword(state, SealedKeyword):
		parse_select_sealed_arm(state, start_span)
	else if current_is_symbol(state, UnderscoreSymbol) and next_is_keyword(state, AfterKeyword):
		parse_select_after_arm(state, start_span)
	else:
		parse_select_receive_arm(state, start_span)


private pure func parse_select_arm_list(
	state: CompilerParserState,
	header_span: CompilerSourceSpan,
) -> ParseSelectArmListStep:
	var st: CompilerParserState = skip_newlines(state)
	var values: List[ParsedSelectArm] = []

	while current_token_is_indented_past(st, header_span) and not current_is_block_end(st):
		before_index: Int = st.index
		arm_step: ParseSelectArmStep = parse_select_arm(st)
		values = values.append(arm_step.value)
		st = skip_newlines(arm_step.state)

		if (
			st.index == before_index
			and current_token_is_indented_past(st, header_span)
			and not current_is_block_end(st)
		):
			st = advance_parser(st)

	{
		state = st,
		values = values
	}


private pure func parse_select_expr_with_header_span(
	state: CompilerParserState,
	header_span: CompilerSourceSpan,
) -> ParseExprStep:
	start_span: CompilerSourceSpan = current_span(state)
	var st: CompilerParserState = advance_parser(state)
	colon_step: ParseSymbolStep = expect_symbol(st, ColonSymbol, "expected `:` after select")
	st = expect_newline(colon_step.state, "expected newline before select arms")
	st = consume_block_indent(st, header_span)
	arms_step: ParseSelectArmListStep = parse_select_arm_list(st, header_span)
	st = arms_step.state

	end_span: CompilerSourceSpan = if current_is_dedent(st):
		current_span(st)
	else:
		start_span

	if current_is_dedent(st):
		st = expect_dedent(st)

	{
		state = st,
		value = ParsedSelectExpr(
			arms_step.values,
			span_cover(start_span, end_span),
		)
	}


private pure func parse_select_expr(state: CompilerParserState) -> ParseExprStep:
	parse_select_expr_with_header_span(state, current_span(state))


private pure func parse_debug_block_expr(state: CompilerParserState) -> ParseExprStep:
	start_span: CompilerSourceSpan = current_span(state)
	colon_step: ParseSymbolStep = expect_symbol(
		advance_parser(state),
		ColonSymbol,
		"expected `:` after debug",
	)
	body_step: ParseExprStep = parse_block_after_colon(colon_step.state, start_span)

	{
		state = body_step.state,
		value = ParsedDebugBlockExpr(
			body_step.value,
			span_cover(start_span, parsed_expr_span(body_step.value)),
		)
	}


private pure func parse_with_error_map_opt(state: CompilerParserState) -> ParseWithErrorMapStep:
	if current_is_keyword(state, OnKeyword):
		var st: CompilerParserState = advance_parser(state)
		name_step: ParseIdentifierStep = parse_binder_identifier_expected(st, "with error name")
		st = name_step.state
		fat_arrow_step: ParseSymbolStep = expect_symbol(
			st,
			FatArrowSymbol,
			"expected `=>` after with error name",
		)
		value_step: ParseExprStep = parse_expression(fat_arrow_step.state, PREC_LOWEST)

		{
			state = value_step.state,
			value = Some({
				name = name_step.value,
				value = value_step.value,
				span = span_cover(name_step.value.span, parsed_expr_span(value_step.value)),
			})
		}
	else:
		{
			state = state,
			value = None
		}


private pure func parse_with_binding(state: CompilerParserState) -> ParseWithBindingStep:
	name_step: ParseIdentifierStep = parse_binder_identifier_expected(state, "with binding name")
	type_step: ParseOptionalTypeStep = parse_optional_type_annotation(name_step.state)
	var st: CompilerParserState = type_step.state
	var kind: ParsedWithBindingKind = ParsedWithPlainBinding

	if current_is_symbol(st, QuestionEqualsSymbol):
		kind = ParsedWithTryBinding
		st = advance_parser(st)
	else:
		st = expect_symbol(st, EqualSymbol, "expected `=` or `?=` after with binding").state

	value_step: ParseExprStep = parse_expression(st, PREC_LOWEST)
	st = value_step.state

	error_map_step: ParseWithErrorMapStep = if kind == ParsedWithTryBinding:
		parse_with_error_map_opt(st)
	else:
		{
			state = st,
			value = None
		}

	st = error_map_step.state

	end_span: CompilerSourceSpan = match error_map_step.value:
		Some(error_map):
			error_map.span
		None:
			parsed_expr_span(value_step.value)

	{
		state = st,
		value = {
			name = name_step.value,
			type_expr = type_step.value,
			value = value_step.value,
			kind = kind,
			error_map = error_map_step.value,
			span = span_cover(name_step.value.span, end_span)
		}
	}


private pure func add_with_multi_binding_error(
	state: CompilerParserState,
	span: CompilerSourceSpan,
) -> CompilerParserState:
	add_expected_error(
		state,
		span,
		(
			"Multiple resource bindings in one `with` header are not supported yet. Nested "
			+ "`with` blocks make resource close order explicit."
		),
		[":"],
		Some("use nested `with` blocks to make resource close order explicit"),
	)


private pure func parse_with_expr(state: CompilerParserState) -> ParseExprStep:
	start_span: CompilerSourceSpan = current_span(state)
	binding_step: ParseWithBindingStep = parse_with_binding(advance_parser(state))
	var st: CompilerParserState = binding_step.state

	if current_is_symbol(st, CommaSymbol):
		st = add_with_multi_binding_error(st, current_span(st))

		while (
			not current_is_eof(st)
			and not current_is_newline(st)
			and not current_is_symbol(st, ColonSymbol)
		):
			st = advance_parser(st)

	colon_step: ParseSymbolStep = expect_symbol(st, ColonSymbol, "expected `:` after with binding")
	body_step: ParseExprStep = parse_block_after_colon(colon_step.state, start_span)

	body: ParsedExpr = match body_step.value:
		ParsedBlockExpr(items, span):
			ParsedBlockExpr(
				items,
				span_cover(
					first_expr_span(items, span),
					span,
				),
			)
		_:
			body_step.value

	{
		state = body_step.state,
		value = ParsedWithExpr(
			binding_step.value,
			body,
			span_cover(start_span, parsed_expr_span(body)),
		)
	}


private pure func parse_concurrent_param(state: CompilerParserState) -> ParseConcurrentParamStep:
	name_step: ParseIdentifierStep = parse_identifier_expected(state, EXPECTED_CONCURRENT_PARAM)
	var st: CompilerParserState = name_step.state
	colon_step: ParseSymbolStep = expect_symbol(
		st,
		ColonSymbol,
		"expected `:` after concurrent parameter name",
	)
	value_step: ParseExprStep = parse_expression(colon_step.state, PREC_LOWEST)

	{
		state = value_step.state,
		value = {
			name = name_step.value,
			value = value_step.value,
			span = span_cover(name_step.value.span, parsed_expr_span(value_step.value))
		}
	}


private pure func parse_concurrent_param_list_after_left_paren(
	state: CompilerParserState,
	empty_help: String,
) -> ParseConcurrentParamListStep:
	var st: CompilerParserState = state
	var values: List[ParsedConcurrentParam] = []

	if current_is_symbol(st, RightParenSymbol):
		st = add_expected_error(
			st,
			current_span(st),
			"expected concurrent parameter",
			[EXPECTED_CONCURRENT_PARAM],
			Some(empty_help),
		)
	else:
		var parsing_params: Bool = True

		while parsing_params and not current_is_eof(st):
			before_index: Int = st.index
			param_step: ParseConcurrentParamStep = parse_concurrent_param(st)
			values = values.append(param_step.value)
			st = param_step.state

			if current_is_symbol(st, CommaSymbol):
				st = advance_parser(st)

				if current_is_symbol(st, RightParenSymbol):
					parsing_params = False
			else if current_is_symbol(st, RightParenSymbol):
				parsing_params = False
			else:
				st = add_expected_error(
					st,
					current_span(st),
					"expected `,` between concurrent parameters",
					[","],
					None,
				)

			if st.index == before_index and not current_is_symbol(st, RightParenSymbol):
				st = advance_parser(st)

	{
		state = st,
		values = values
	}


private pure func parse_concurrent_block_expr(state: CompilerParserState) -> ParseExprStep:
	start_span: CompilerSourceSpan = current_span(state)
	var st: CompilerParserState = advance_parser(state)
	var params: List[ParsedConcurrentParam] = []

	if current_is_symbol(st, LeftParenSymbol):
		params_step: ParseConcurrentParamListStep = parse_concurrent_param_list_after_left_paren(
			advance_parser(st),
			"omit the parentheses for a concurrent block with no parameters",
		)
		params = params_step.values
		right_step: ParseSymbolStep = expect_symbol(
			params_step.state,
			RightParenSymbol,
			"expected `)` after concurrent parameters",
		)
		st = right_step.state

	colon_step: ParseSymbolStep = expect_symbol(st, ColonSymbol, "expected `:` after concurrent")
	body_step: ParseExprStep = parse_block_after_colon(colon_step.state, start_span)

	{
		state = body_step.state,
		value = ParsedConcurrentBlockExpr(
			params,
			body_step.value,
			span_cover(start_span, parsed_expr_span(body_step.value)),
		)
	}


private pure func parse_concurrent_for_tail(
	state: CompilerParserState,
	binder: ParsedIdentifier,
	iterable: ParsedExpr,
	start_span: CompilerSourceSpan,
	header_span: CompilerSourceSpan,
) -> ParseExprStep:
	var st: CompilerParserState = advance_parser(state)
	var params: List[ParsedConcurrentParam] = []

	if current_is_symbol(st, LeftParenSymbol):
		params_step: ParseConcurrentParamListStep = parse_concurrent_param_list_after_left_paren(
			advance_parser(st),
			"write at least `limit: N` inside concurrently(...)",
		)
		params = params_step.values
		right_step: ParseSymbolStep = expect_symbol(
			params_step.state,
			RightParenSymbol,
			"expected `)` after concurrently parameters",
		)
		st = right_step.state
	else:
		st = add_expected_error(
			st,
			current_span(st),
			"expected `(` after concurrently",
			["("],
			Some("write `for x in xs concurrently(limit: N):`"),
		)

	colon_step: ParseSymbolStep = expect_symbol(
		st,
		ColonSymbol,
		"expected `:` after concurrently parameters",
	)
	body_step: ParseExprStep = parse_block_after_colon(colon_step.state, header_span)

	{
		state = body_step.state,
		value = ParsedConcurrentForExpr(
			binder,
			iterable,
			params,
			body_step.value,
			span_cover(start_span, parsed_expr_span(body_step.value)),
		)
	}


private pure func add_tuple_binder_arity_error(
	state: CompilerParserState,
	span: CompilerSourceSpan,
) -> CompilerParserState:
	add_expected_error(state, span, "Tuples support 2-4 elements", ["2-4 tuple elements"], None)


private pure func parse_tuple_binder_identifier_expected(
	state: CompilerParserState,
	expected: String,
	mode: TupleBinderIdentifierMode,
) -> ParseIdentifierStep:
	match mode:
		TupleBinderNamesOnly:
			parse_identifier_expected(state, expected)
		TupleBinderNamesOrUnderscore:
			parse_binder_identifier_expected(state, expected)


private pure func parse_tuple_binder_after_left_paren(
	state: CompilerParserState,
	start_span: CompilerSourceSpan,
	mode: TupleBinderIdentifierMode,
	item_expected: String,
	comma_message: String,
	missing_after_comma_message: String,
	close_message: String,
) -> ParseTupleBinderStep:
	var st: CompilerParserState = state
	var values: List[ParsedIdentifier] = []
	var end_span: CompilerSourceSpan = start_span

	first_step: ParseIdentifierStep = parse_tuple_binder_identifier_expected(
		st,
		item_expected,
		mode,
	)
	values = values.append(first_step.value)
	st = first_step.state
	end_span = first_step.value.span

	comma_step: ParseSymbolStep = expect_symbol(st, CommaSymbol, comma_message)
	st = comma_step.state

	if comma_step.matched:
		var parsing_values: Bool = True

		while parsing_values and not current_is_eof(st):
			if current_is_symbol(st, RightParenSymbol):
				st = add_expected_error(
					st,
					current_span(st),
					missing_after_comma_message,
					[item_expected],
					None,
				)
				parsing_values = False
			else:
				item_step: ParseIdentifierStep = parse_tuple_binder_identifier_expected(
					st,
					item_expected,
					mode,
				)
				values = values.append(item_step.value)
				st = item_step.state
				end_span = item_step.value.span

				if current_is_symbol(st, CommaSymbol):
					st = advance_parser(st)

					if current_is_symbol(st, RightParenSymbol):
						parsing_values = False
				else:
					parsing_values = False

	right_step: ParseSymbolStep = expect_symbol(st, RightParenSymbol, close_message)
	st = right_step.state

	if right_step.matched:
		end_span = right_step.span

	if values.length() < 2 or values.length() > 4:
		st = add_tuple_binder_arity_error(
			st,
			span_cover(start_span, end_span),
		)

	{
		state = st,
		values = values,
		span = span_cover(start_span, end_span)
	}


private pure func parse_for_tuple_binder_after_left_paren(
	state: CompilerParserState,
	start_span: CompilerSourceSpan,
) -> ParseForBinderStep:
	binder_step: ParseTupleBinderStep = parse_tuple_binder_after_left_paren(
		state,
		start_span,
		TupleBinderNamesOrUnderscore,
		"tuple loop variable",
		"expected `,` between tuple loop variables",
		"expected tuple loop variable after `,`",
		"expected `)` after tuple loop variables",
	)

	{
		state = binder_step.state,
		value = ParsedForTupleBinder(binder_step.values, binder_step.span)
	}


private pure func parse_for_binder(state: CompilerParserState) -> ParseForBinderStep:
	if current_is_symbol(state, LeftParenSymbol):
		parse_for_tuple_binder_after_left_paren(advance_parser(state), current_span(state))
	else:
		name_step: ParseIdentifierStep = parse_binder_identifier_expected(
			state,
			"for loop variable",
		)

		{
			state = name_step.state,
			value = ParsedForNameBinder(name_step.value)
		}


private pure func parse_while_expr(state: CompilerParserState) -> ParseExprStep:
	start_span: CompilerSourceSpan = current_span(state)
	cond_step: ParseExprStep = parse_expression(advance_parser(state), PREC_LOWEST)
	colon_step: ParseSymbolStep = expect_symbol(
		cond_step.state,
		ColonSymbol,
		"expected `:` after while condition",
	)
	body_step: ParseExprStep = parse_block_after_colon(colon_step.state, start_span)

	{
		state = body_step.state,
		value = ParsedWhileExpr(
			cond_step.value,
			body_step.value,
			span_cover(start_span, parsed_expr_span(body_step.value)),
		)
	}


private pure func parse_for_expr_with_header_span(
	state: CompilerParserState,
	header_span: CompilerSourceSpan,
) -> ParseExprStep:
	start_span: CompilerSourceSpan = current_span(state)
	binder_step: ParseForBinderStep = parse_for_binder(advance_parser(state))
	var st: CompilerParserState = expect_keyword(
		binder_step.state,
		InKeyword,
		"in",
		"expected `in` after for loop variable",
	)
	iter_step: ParseExprStep = parse_expression(st, PREC_LOWEST)

	if current_is_keyword(iter_step.state, ConcurrentlyKeyword):
		match binder_step.value:
			ParsedForNameBinder(name):
				parse_concurrent_for_tail(
					iter_step.state,
					name,
					iter_step.value,
					start_span,
					header_span,
				)
			ParsedForTupleBinder(_, _):
				error_state: CompilerParserState = add_expected_error(
					iter_step.state,
					current_span(iter_step.state),
					"`for ... concurrently` requires a single loop variable",
					["loop variable"],
					Some("write `for item in items concurrently(limit: N):`"),
				)
				parse_concurrent_for_tail(
					error_state,
					parsed_identifier("_", start_span),
					iter_step.value,
					start_span,
					header_span,
				)
	else:
		colon_step: ParseSymbolStep = expect_symbol(
			iter_step.state,
			ColonSymbol,
			"expected `:` after for loop iterable",
		)
		body_step: ParseExprStep = parse_block_after_colon(colon_step.state, header_span)

		{
			state = body_step.state,
			value = ParsedForExpr(
				binder_step.value,
				iter_step.value,
				body_step.value,
				span_cover(start_span, parsed_expr_span(body_step.value)),
			)
		}


private pure func parse_for_expr(state: CompilerParserState) -> ParseExprStep:
	parse_for_expr_with_header_span(state, current_span(state))


private pure func parse_var_decl_statement(state: CompilerParserState) -> ParseExprStep:
	start_span: CompilerSourceSpan = current_span(state)
	name_step: ParseIdentifierStep = parse_binder_identifier_expected(
		advance_parser(state),
		"variable name",
	)
	type_step: ParseOptionalTypeStep = parse_optional_type_annotation(name_step.state)
	var st: CompilerParserState = type_step.state

	equal_step: ParseSymbolStep = expect_symbol(
		st,
		EqualSymbol,
		"expected `=` after variable declaration",
	)
	value_step: ParseExprStep = parse_assignment_value_expr(equal_step.state, start_span)

	{
		state = value_step.state,
		value = ParsedVarDeclExpr(
			name_step.value,
			type_step.value,
			value_step.value,
			True,
			span_cover(start_span, parsed_expr_span(value_step.value)),
		)
	}


private pure func parse_named_assignment_tail(
	state: CompilerParserState,
	name: ParsedIdentifier,
	type_expr: Option[ParsedTypeExpr],
) -> ParseExprStep:
	if current_is_symbol(state, EqualSymbol):
		value_step: ParseExprStep = parse_assignment_value_expr(advance_parser(state), name.span)

		match type_expr:
			Some(ty):
				{
					state = value_step.state,
					value = ParsedVarDeclExpr(
						name,
						Some(ty),
						value_step.value,
						False,
						span_cover(name.span, parsed_expr_span(value_step.value)),
					)
				}
			None:
				{
					state = value_step.state,
					value = ParsedAssignExpr(
						name,
						value_step.value,
						span_cover(name.span, parsed_expr_span(value_step.value)),
					)
				}
	else if current_is_symbol(state, QuestionEqualsSymbol):
		value_step: ParseExprStep = parse_assignment_value_expr(advance_parser(state), name.span)

		if name.text == "_":
			next_state: CompilerParserState = add_expected_error(
				value_step.state,
				name.span,
				"`?=` cannot bind to `_`; use a name for the unwrapped value",
				["binding name"],
				None,
			)

			{
				state = next_state,
				value = ParsedQuestionBindExpr(
					name,
					type_expr,
					value_step.value,
					span_cover(name.span, parsed_expr_span(value_step.value)),
				)
			}
		else:
			{
				state = value_step.state,
				value = ParsedQuestionBindExpr(
					name,
					type_expr,
					value_step.value,
					span_cover(name.span, parsed_expr_span(value_step.value)),
				)
			}
	else:
		match current_compound_assign_op(state):
			Some(op):
				value_step: ParseExprStep = parse_assignment_value_expr(
					advance_parser(state),
					name.span,
				)

				{
					state = value_step.state,
					value = ParsedCompoundAssignExpr(
						name,
						op,
						value_step.value,
						span_cover(name.span, parsed_expr_span(value_step.value)),
					)
				}
			None:
				next_state: CompilerParserState = add_expected_error(
					state,
					current_span(state),
					"expected assignment operator",
					["=", "?=", "+=", "-=", "*=", "/="],
					None,
				)

				{
					state = next_state,
					value = ParsedMissingExpr(name.span)
				}


private pure func current_is_tuple_destruct_assignment_start(state: CompilerParserState) -> Bool:
	if not current_is_symbol(state, LeftParenSymbol):
		False
	else:
		var index: Int = state.index + 1
		var saw_comma: Bool = False
		var expecting_name: Bool = True
		var done: Bool = False
		var valid: Bool = True

		while valid and not done:
			token: CompilerToken = token_at(state, index)

			if expecting_name:
				if token_kind_is_tuple_binder_name(token.kind):
					index += 1
					expecting_name = False
				else:
					valid = False
			else:
				match token.kind:
					SymbolToken(CommaSymbol):
						saw_comma = True
						index += 1

						if token_kind_is_symbol(token_at(state, index).kind, RightParenSymbol):
							done = True
						else:
							expecting_name = True
					SymbolToken(RightParenSymbol):
						done = True
					_:
						valid = False

		(
			valid
			and done
			and saw_comma
			and token_kind_is_symbol(token_at(state, index + 1).kind, EqualSymbol)
		)


private pure func parse_tuple_destruct_assignment(state: CompilerParserState) -> ParseExprStep:
	start_span: CompilerSourceSpan = current_span(state)
	binder_step: ParseTupleBinderStep = parse_tuple_binder_after_left_paren(
		advance_parser(state),
		start_span,
		TupleBinderNamesOrUnderscore,
		"tuple destructuring name",
		"expected `,` between tuple destructuring names",
		"expected tuple destructuring name after `,`",
		"expected `)` after tuple destructuring names",
	)
	equal_step: ParseSymbolStep = expect_symbol(
		binder_step.state,
		EqualSymbol,
		"expected `=` after tuple destructuring",
	)
	value_step: ParseExprStep = parse_assignment_value_expr(equal_step.state, start_span)

	{
		state = value_step.state,
		value = ParsedTupleDestructExpr(
			binder_step.values,
			value_step.value,
			span_cover(start_span, parsed_expr_span(value_step.value)),
		)
	}


private pure func token_index_is_keyword(
	state: CompilerParserState,
	index: Int,
	expected: CompilerKeyword,
) -> Bool:
	match token_at(state, index).kind:
		KeywordToken(actual):
			actual == expected
		_:
			False


private pure func func_keyword_starts_nested_function_decl(
	state: CompilerParserState,
	index: Int,
) -> Bool:
	(
		token_index_is_keyword(state, index, FuncKeyword)
		and not token_kind_is_symbol(token_at(state, index + 1).kind, LeftParenSymbol)
	)


private pure func current_starts_nested_function_decl(state: CompilerParserState) -> Bool:
	if current_is_keyword(state, FuncKeyword):
		func_keyword_starts_nested_function_decl(state, state.index)
	else if current_is_keyword(state, PureKeyword):
		(
			token_index_is_keyword(state, state.index + 1, FuncKeyword)
			and not token_kind_is_symbol(token_at(state, state.index + 2).kind, LeftParenSymbol)
		)
	else:
		False


private pure func parse_nested_function_decl_expr(state: CompilerParserState) -> ParseExprStep:
	start_span: CompilerSourceSpan = current_span(state)
	var st: CompilerParserState = state
	var is_pure: Bool = False

	if current_is_keyword(st, PureKeyword):
		is_pure = True
		st = advance_parser(st)

	function_step: ParseFunctionStep = parse_function_decl_value(st, None, is_pure, [], start_span)

	{
		state = function_step.state,
		value = ParsedFunctionDeclExpr(function_step.value)
	}


private pure func parse_assignment_after_expression(expr_step: ParseExprStep) -> ParseExprStep:
	if current_is_symbol(expr_step.state, EqualSymbol):
		match expr_step.value:
			ParsedNameExpr(name):
				value_step: ParseExprStep = parse_assignment_value_expr(
					advance_parser(expr_step.state),
					name.span,
				)

				{
					state = value_step.state,
					value = ParsedAssignExpr(
						name,
						value_step.value,
						span_cover(name.span, parsed_expr_span(value_step.value)),
					)
				}
			ParsedSubscriptExpr(target, indices, left_span):
				value_step: ParseExprStep = parse_assignment_value_expr(
					advance_parser(expr_step.state),
					left_span,
				)

				{
					state = value_step.state,
					value = ParsedSubscriptAssignExpr(
						target,
						indices,
						value_step.value,
						span_cover(left_span, parsed_expr_span(value_step.value)),
					)
				}
			ParsedFieldAccessExpr(_, _, left_span):
				value_step: ParseExprStep = parse_assignment_value_expr(
					advance_parser(expr_step.state),
					left_span,
				)
				next_state: CompilerParserState = add_expected_error(
					value_step.state,
					left_span,
					(
						"Field assignment is not supported. Use record update syntax: { record | field = "
						+ "value }"
					),
					["record update"],
					None,
				)

				{
					state = next_state,
					value = ParsedMissingExpr(left_span)
				}
			_:
				expr_step
	else:
		expr_step


private pure func current_token_can_start_named_statement(state: CompilerParserState) -> Bool:
	match current_token(state).kind:
		IdentifierToken(_):
			True
		KeywordToken(keyword):
			match soft_keyword_identifier_text(keyword):
				Some(_):
					True
				None:
					False
		_:
			False


private pure func parse_named_statement_or_expression(state: CompilerParserState) -> ParseExprStep:
	if current_token_can_start_named_statement(state):
		name_step: ParseIdentifierStep = parse_binder_identifier_expected(state, "statement name")
		var st: CompilerParserState = name_step.state

		if current_is_symbol(st, ColonSymbol) and colon_starts_typed_assignment(st):
			type_step: ParseOptionalTypeStep = parse_optional_type_annotation(st)
			parse_named_assignment_tail(type_step.state, name_step.value, type_step.value)
		else if current_can_start_assignment_tail(st):
			parse_named_assignment_tail(st, name_step.value, None)
		else:
			parse_assignment_after_expression(parse_expression(state, PREC_LOWEST))
	else:
		match current_token(state).kind:
			SymbolToken(UnderscoreSymbol):
				name_step: ParseIdentifierStep = parse_binder_identifier_expected(
					state,
					"statement name",
				)
				var st: CompilerParserState = name_step.state

				if current_can_start_assignment_tail(st):
					parse_named_assignment_tail(st, name_step.value, None)
				else:
					parse_expression(state, PREC_LOWEST)
			_:
				parse_assignment_after_expression(parse_expression(state, PREC_LOWEST))


private pure func parse_statement(state: CompilerParserState) -> ParseExprStep:
	step: ParseExprStep = if current_starts_nested_function_decl(state):
		parse_nested_function_decl_expr(state)
	else if current_is_keyword(state, VarKeyword):
		parse_var_decl_statement(state)
	else if current_is_keyword(state, WhileKeyword):
		parse_while_expr(state)
	else if current_is_keyword(state, ForKeyword):
		parse_for_expr(state)
	else if current_is_tuple_destruct_assignment_start(state):
		parse_tuple_destruct_assignment(state)
	else:
		parse_named_statement_or_expression(state)

	{
		state = consume_leading_dot_postfix_continuation_dedent(step.state, step.value),
		value = step.value
	}


private pure func parse_lambda_body(
	state: CompilerParserState,
	body_intro_span: CompilerSourceSpan,
	block_anchor_span: CompilerSourceSpan,
) -> ParseExprStep:
	if current_is_newline(state):
		parse_block_after_colon(state, block_anchor_span)
	else if (
		current_span(state).start_line > body_intro_span.start_line
		and current_token_is_indented_past(state, block_anchor_span)
	):
		parse_indented_block_body(state, block_anchor_span)
	else:
		parse_expr(state)


private pure func parse_lambda_expr_with_header_span(
	state: CompilerParserState,
	header_span: CompilerSourceSpan,
) -> ParseExprStep:
	start_span: CompilerSourceSpan = current_span(state)
	var st: CompilerParserState = state
	var is_pure: Bool = False

	if current_is_keyword(st, PureKeyword):
		is_pure = True
		st = advance_parser(st)
		st = expect_keyword(
			st,
			FuncKeyword,
			"func",
			"expected `func` after `pure` in lambda expression",
		)
	else:
		st = expect_keyword(st, FuncKeyword, "func", "expected `func` before lambda")

	left_step: ParseSymbolStep = expect_symbol(
		st,
		LeftParenSymbol,
		"expected `(` after lambda `func`",
	)
	st = left_step.state

	params_step: ParseLambdaParamsStep = if left_step.matched:
		parse_lambda_params_after_left_paren(st)
	else:
		{
			state = st,
			values = []
		}

	st = params_step.state
	var return_type: Option[ParsedTypeExpr] = None

	if current_is_symbol(st, ArrowSymbol):
		type_step: ParseTypeStep = parse_type_expr(advance_parser(st))
		return_type = Some(type_step.value)
		st = type_step.state

	colon_step: ParseSymbolStep = expect_symbol(st, ColonSymbol, "expected `:` before lambda body")
	body_step: ParseExprStep = parse_lambda_body(colon_step.state, colon_step.span, header_span)

	{
		state = body_step.state,
		value = ParsedLambdaExpr(
			is_pure,
			params_step.values,
			return_type,
			body_step.value,
			span_cover(start_span, parsed_expr_span(body_step.value)),
		)
	}


private pure func parse_lambda_expr(state: CompilerParserState) -> ParseExprStep:
	parse_lambda_expr_with_header_span(state, current_span(state))


private pure func parse_tuple_tail(
	state: CompilerParserState,
	first_item: ParsedExpr,
	start_span: CompilerSourceSpan,
) -> ParseExprStep:
	var st: CompilerParserState = state
	var items: List[ParsedExpr] = [first_item]
	var parsing_items: Bool = True

	while parsing_items and not current_is_eof(st):
		if current_is_symbol(st, CommaSymbol):
			st = advance_parser(st)

			if current_is_symbol(st, RightParenSymbol):
				parsing_items = False
			else:
				item_step: ParseExprStep = parse_expression_with_header_span(
					st,
					PREC_LOWEST,
					start_span,
				)
				items = items.append(item_step.value)
				st = item_step.state
		else:
			parsing_items = False

	right_step: ParseSymbolStep = expect_symbol(
		st,
		RightParenSymbol,
		"expected `)` after tuple expression",
	)
	st = right_step.state

	end_span: CompilerSourceSpan = if right_step.matched:
		right_step.span
	else:
		parsed_expr_span(first_item)

	if items.length() > 4:
		st = add_tuple_arity_error(
			st,
			span_cover(start_span, end_span),
		)

	{
		state = st,
		value = ParsedTupleExpr(
			items,
			span_cover(start_span, end_span),
		)
	}


private pure func parse_parenthesized_or_tuple_expr(
	state: CompilerParserState,
	start_span: CompilerSourceSpan,
) -> ParseExprStep:
	if current_is_symbol(state, RightParenSymbol):
		right_step: ParseSymbolStep = expect_symbol(
			state,
			RightParenSymbol,
			"expected `)` after void expression",
		)

		{
			state = right_step.state,
			value = ParsedVoidExpr(span_cover(start_span, right_step.span))
		}
	else:
		expr_step: ParseExprStep = parse_expression_with_header_span(state, PREC_LOWEST, start_span)

		if current_is_symbol(expr_step.state, CommaSymbol):
			parse_tuple_tail(expr_step.state, expr_step.value, start_span)
		else:
			right_step: ParseSymbolStep = expect_symbol(
				expr_step.state,
				RightParenSymbol,
				"expected `)` after expression",
			)

			{
				state = right_step.state,
				value = expr_step.value
			}


private pure func next_is_symbol(state: CompilerParserState, symbol: CompilerSymbol) -> Bool:
	match token_at(state, state.index + 1).kind:
		SymbolToken(actual):
			actual == symbol
		_:
			False


private pure func current_can_start_record_expr_field(state: CompilerParserState) -> Bool:
	match current_token(state).kind:
		IdentifierToken(_):
			next_is_symbol(state, EqualSymbol)
		KeywordToken(keyword):
			soft_keyword_identifier_text(keyword).is_some() and next_is_symbol(state, EqualSymbol)
		_:
			False


private pure func parse_record_expr_field(state: CompilerParserState) -> ParseRecordExprFieldStep:
	name_step: ParseIdentifierStep = parse_identifier_expected(state, "record field")
	equal_step: ParseSymbolStep = expect_symbol(
		name_step.state,
		EqualSymbol,
		"expected `=` after record field name",
	)
	value_step: ParseExprStep = parse_expression(equal_step.state, PREC_LOWEST)

	{
		state = value_step.state,
		value = {
			name = name_step.value,
			value = value_step.value,
			span = span_cover(name_step.value.span, parsed_expr_span(value_step.value))
		}
	}


private pure func parse_record_expr_field_list_until_right_brace(
	state: CompilerParserState,
	allow_empty: Bool,
) -> ParseRecordExprFieldListStep:
	var st: CompilerParserState = state
	var fields: List[ParsedRecordExprField] = []

	if allow_empty and current_is_symbol(st, RightBraceSymbol):
		{
			state = st,
			values = fields
		}
	else:
		var parsing_fields: Bool = True

		while parsing_fields and not current_is_eof(st):
			field_step: ParseRecordExprFieldStep = parse_record_expr_field(st)
			fields = fields.append(field_step.value)
			st = field_step.state

			if current_is_symbol(st, CommaSymbol):
				st = advance_parser(st)

				if current_is_symbol(st, RightBraceSymbol):
					parsing_fields = False
			else:
				parsing_fields = False

		{
			state = st,
			values = fields
		}


private pure func parse_record_literal_expr(
	state: CompilerParserState,
	start_span: CompilerSourceSpan,
) -> ParseExprStep:
	fields_step: ParseRecordExprFieldListStep = parse_record_expr_field_list_until_right_brace(
		state,
		True,
	)
	right_step: ParseSymbolStep = expect_symbol(
		fields_step.state,
		RightBraceSymbol,
		"expected `}` after record literal",
	)

	end_span: CompilerSourceSpan = if right_step.matched:
		right_step.span
	else:
		start_span

	{
		state = right_step.state,
		value = ParsedRecordExpr(
			fields_step.values,
			span_cover(start_span, end_span),
		)
	}


private pure func parse_dict_entry_after_key(
	state: CompilerParserState,
	key: ParsedExpr,
) -> ParseDictEntryStep:
	arrow_step: ParseSymbolStep = expect_symbol(
		state,
		FatArrowSymbol,
		"expected `=>` between dict key and value",
	)
	value_step: ParseExprStep = parse_expression(arrow_step.state, PREC_LOWEST)

	{
		state = value_step.state,
		value = {
			key = key,
			value = value_step.value,
			span = span_cover(parsed_expr_span(key), parsed_expr_span(value_step.value))
		}
	}


private pure func parse_dict_literal_tail(
	state: CompilerParserState,
	first_key: ParsedExpr,
	start_span: CompilerSourceSpan,
) -> ParseExprStep:
	first_entry_step: ParseDictEntryStep = parse_dict_entry_after_key(state, first_key)
	var st: CompilerParserState = first_entry_step.state
	var entries: List[ParsedDictEntry] = [first_entry_step.value]
	var parsing_entries: Bool = True

	while parsing_entries and not current_is_eof(st):
		if current_is_symbol(st, CommaSymbol):
			st = advance_parser(st)

			if current_is_symbol(st, RightBraceSymbol):
				parsing_entries = False
			else:
				key_step: ParseExprStep = parse_expression(st, PREC_LOWEST)
				entry_step: ParseDictEntryStep = parse_dict_entry_after_key(
					key_step.state,
					key_step.value,
				)
				entries = entries.append(entry_step.value)
				st = entry_step.state
		else:
			parsing_entries = False

	right_step: ParseSymbolStep = expect_symbol(
		st,
		RightBraceSymbol,
		"expected `}` after dict literal",
	)

	end_span: CompilerSourceSpan = if right_step.matched:
		right_step.span
	else:
		parsed_expr_span(first_key)

	{
		state = right_step.state,
		value = ParsedDictExpr(
			entries,
			span_cover(start_span, end_span),
		)
	}


private pure func parse_vector_literal_tail(
	state: CompilerParserState,
	first_item: ParsedExpr,
	start_span: CompilerSourceSpan,
) -> ParseExprStep:
	var st: CompilerParserState = state
	var items: List[ParsedExpr] = [first_item]
	var parsing_items: Bool = True

	while parsing_items and not current_is_eof(st):
		if current_is_symbol(st, CommaSymbol):
			st = advance_parser(st)

			if current_is_symbol(st, RightBraceSymbol):
				parsing_items = False
			else:
				item_step: ParseExprStep = parse_expression(st, PREC_LOWEST)
				items = items.append(item_step.value)
				st = item_step.state
		else:
			parsing_items = False

	right_step: ParseSymbolStep = expect_symbol(
		st,
		RightBraceSymbol,
		"expected `}` after vector literal",
	)

	end_span: CompilerSourceSpan = if right_step.matched:
		right_step.span
	else:
		parsed_expr_span(first_item)

	{
		state = right_step.state,
		value = ParsedVectorExpr(
			items,
			span_cover(start_span, end_span),
		)
	}


private pure func parse_record_update_tail(
	state: CompilerParserState,
	base: ParsedExpr,
	start_span: CompilerSourceSpan,
) -> ParseExprStep:
	pipe_step: ParseSymbolStep = expect_symbol(
		state,
		PipeSymbol,
		"expected `|` before record update fields",
	)
	fields_step: ParseRecordExprFieldListStep = parse_record_expr_field_list_until_right_brace(
		pipe_step.state,
		False,
	)
	right_step: ParseSymbolStep = expect_symbol(
		fields_step.state,
		RightBraceSymbol,
		"expected `}` after record update",
	)

	end_span: CompilerSourceSpan = if right_step.matched:
		right_step.span
	else:
		parsed_expr_span(base)

	{
		state = right_step.state,
		value = ParsedRecordUpdateExpr(
			base,
			fields_step.values,
			span_cover(start_span, end_span),
		)
	}


private pure func parse_braced_expr(
	state: CompilerParserState,
	start_span: CompilerSourceSpan,
) -> ParseExprStep:
	st: CompilerParserState = advance_parser(state)

	if current_is_symbol(st, RightBraceSymbol) or current_can_start_record_expr_field(st):
		parse_record_literal_expr(st, start_span)
	else:
		first_step: ParseExprStep = parse_expression(st, PREC_LOWEST)

		if current_is_symbol(first_step.state, FatArrowSymbol):
			parse_dict_literal_tail(first_step.state, first_step.value, start_span)
		else if current_is_symbol(first_step.state, PipeSymbol):
			parse_record_update_tail(first_step.state, first_step.value, start_span)
		else:
			parse_vector_literal_tail(first_step.state, first_step.value, start_span)


private pure func parse_builtin_expr(state: CompilerParserState) -> ParseExprStep:
	start_span: CompilerSourceSpan = current_span(state)
	var st: CompilerParserState = advance_parser(state)
	var name: Option[String] = None
	var end_span: CompilerSourceSpan = start_span

	if current_is_symbol(st, LeftParenSymbol):
		st = advance_parser(st)

		match current_token(st).kind:
			StringLiteralToken(_, text):
				name = Some(text)
				end_span = current_span(st)
				st = advance_parser(st)
			_:
				st = add_expected_error(
					st,
					current_span(st),
					"expected builtin name",
					["string literal"],
					Some("write builtin(\"runtime_helper_name\") or bare builtin"),
				)

				if not current_is_soft_boundary(st):
					st = advance_parser(st)

		right_step: ParseSymbolStep = expect_symbol(
			st,
			RightParenSymbol,
			"expected `)` after builtin name",
		)
		st = right_step.state

		if right_step.matched:
			end_span = right_step.span

	{
		state = st,
		value = ParsedBuiltinExpr(
			name,
			span_cover(start_span, end_span),
		)
	}


private pure func parse_opaque_conversion_expr(
	state: CompilerParserState,
	is_into: Bool,
) -> ParseExprStep:
	start_span: CompilerSourceSpan = current_span(state)
	type_step: ParseTypeStep = parse_type_expr(advance_parser(state))
	left_step: ParseSymbolStep = expect_symbol(
		type_step.state,
		LeftParenSymbol,
		"expected `(` after opaque conversion type",
	)
	value_step: ParseExprStep = parse_expression(left_step.state, PREC_LOWEST)
	right_step: ParseSymbolStep = expect_symbol(
		value_step.state,
		RightParenSymbol,
		"expected `)` after opaque conversion value",
	)

	end_span: CompilerSourceSpan = if right_step.matched:
		right_step.span
	else:
		parsed_expr_span(value_step.value)

	value: ParsedExpr = if is_into:
		ParsedOpaqueIntoExpr(
			type_step.value,
			value_step.value,
			span_cover(start_span, end_span),
		)
	else:
		ParsedOpaqueFromExpr(
			type_step.value,
			value_step.value,
			span_cover(start_span, end_span),
		)

	{
		state = right_step.state,
		value = value
	}


private pure func parse_primary_expr(state: CompilerParserState) -> ParseExprStep:
	token: CompilerToken = current_token(state)

	match token.kind:
		IdentifierToken(text):
			{
				state = advance_parser(state),
				value = ParsedNameExpr(parsed_identifier(text, token.span))
			}
		IntLiteralToken(text):
			{
				state = advance_parser(state),
				value = ParsedIntLiteralExpr(text, token.span)
			}
		FloatLiteralToken(text):
			{
				state = advance_parser(state),
				value = ParsedFloatLiteralExpr(text, token.span)
			}
		StringLiteralToken(kind, text):
			expr_value: ParsedExpr = if string_literal_kind_is_interpolated(kind):
				ParsedStringInterpolationExpr(
					text,
					string_literal_kind_is_multiline_interpolation(kind),
					token.span,
				)
			else:
				ParsedStringLiteralExpr(text, parsed_string_literal_form(kind), token.span)

			{
				state = advance_parser(state),
				value = expr_value
			}
		CharLiteralToken(codepoint):
			{
				state = advance_parser(state),
				value = ParsedCharLiteralExpr(codepoint, token.span)
			}
		KeywordToken(TrueKeyword):
			{
				state = advance_parser(state),
				value = ParsedBoolLiteralExpr(True, token.span)
			}
		KeywordToken(FalseKeyword):
			{
				state = advance_parser(state),
				value = ParsedBoolLiteralExpr(False, token.span)
			}
		KeywordToken(AfterKeyword):
			{
				state = advance_parser(state),
				value = ParsedNameExpr(parsed_identifier("after", token.span))
			}
		KeywordToken(SealedKeyword):
			{
				state = advance_parser(state),
				value = ParsedNameExpr(parsed_identifier("sealed", token.span))
			}
		KeywordToken(BreakKeyword):
			{
				state = advance_parser(state),
				value = ParsedBreakExpr(token.span)
			}
		KeywordToken(ContinueKeyword):
			{
				state = advance_parser(state),
				value = ParsedContinueExpr(token.span)
			}
		KeywordToken(VoidKeyword):
			{
				state = advance_parser(state),
				value = ParsedVoidExpr(token.span)
			}
		KeywordToken(BuiltinKeyword):
			parse_builtin_expr(state)
		KeywordToken(IntoKeyword):
			parse_opaque_conversion_expr(state, True)
		KeywordToken(FromKeyword):
			parse_opaque_conversion_expr(state, False)
		KeywordToken(FuncKeyword):
			parse_lambda_expr(state)
		KeywordToken(PureKeyword):
			parse_lambda_expr(state)
		KeywordToken(IfKeyword):
			parse_if_expr(state)
		KeywordToken(MatchKeyword):
			parse_match_expr(state)
		KeywordToken(SelectKeyword):
			parse_select_expr(state)
		KeywordToken(DebugKeyword):
			if next_is_symbol(state, DotSymbol):
				{
					state = advance_parser(state),
					value = ParsedNameExpr(parsed_identifier("debug", token.span))
				}
			else:
				parse_debug_block_expr(state)
		KeywordToken(WithKeyword):
			parse_with_expr(state)
		KeywordToken(ConcurrentKeyword):
			parse_concurrent_block_expr(state)
		SymbolToken(LeftParenSymbol):
			parse_parenthesized_or_tuple_expr(advance_parser(state), token.span)
		SymbolToken(LeftBracketSymbol):
			start_span: CompilerSourceSpan = token.span
			items_step: ParseExprListStep = parse_expr_list_until(
				advance_parser(state),
				RightBracketSymbol,
				True,
				start_span,
			)
			right_step: ParseSymbolStep = expect_symbol(
				items_step.state,
				RightBracketSymbol,
				"expected `]` after list literal",
			)

			end_span: CompilerSourceSpan = if right_step.matched:
				right_step.span
			else:
				start_span

			{
				state = right_step.state,
				value = ParsedListExpr(
					items_step.values,
					span_cover(start_span, end_span),
				)
			}
		SymbolToken(LeftBraceSymbol):
			parse_braced_expr(state, token.span)
		SymbolToken(UnderscoreSymbol):
			{
				state = advance_parser(state),
				value = ParsedVoidExpr(token.span)
			}
		_:
			next_state: CompilerParserState = add_expected_error(
				state,
				token.span,
				"expected expression",
				[EXPECTED_EXPRESSION],
				None,
			)

			recovery_state: CompilerParserState = if current_is_soft_boundary(next_state):
				next_state
			else:
				advance_parser(next_state)

			{
				state = recovery_state,
				value = ParsedMissingExpr(token.span)
			}


private pure func postfix_continuation_after_newline(
	state: CompilerParserState,
) -> ParsePostfixContinuationStep:
	if current_is_newline(state):
		after_newline: CompilerParserState = advance_parser(state)

		if current_is_indent(after_newline):
			after_indent: CompilerParserState = advance_parser(after_newline)

			if current_is_symbol(after_indent, DotSymbol):
				{
					state = after_indent,
					opened_indent = True
				}
			else:
				{
					state = state,
					opened_indent = False
				}
		else if current_is_symbol(after_newline, DotSymbol):
			{
				state = after_newline,
				opened_indent = False
			}
		else:
			{
				state = state,
				opened_indent = False
			}
	else:
		{
			state = state,
			opened_indent = False
		}


private pure func parse_postfix_expr(
	state: CompilerParserState,
	left: ParsedExpr,
	header_span: CompilerSourceSpan,
) -> ParseExprStep:
	var st: CompilerParserState = state
	var expr: ParsedExpr = left
	var parsing_postfix: Bool = True
	var continuation_indents: Int = 0

	while parsing_postfix and not current_is_eof(st):
		if continuation_indents > 0 and current_is_dedent(st):
			st = advance_parser(st)
			continuation_indents -= 1
		else if continuation_indents > 0 and current_is_newline(st):
			after_newline: CompilerParserState = advance_parser(st)

			if current_is_dedent(after_newline):
				st = advance_parser(after_newline)
				continuation_indents -= 1
			else:
				continuation_step: ParsePostfixContinuationStep = postfix_continuation_after_newline(
					st,
				)
				st = continuation_step.state

				if continuation_step.opened_indent:
					continuation_indents += 1
		else:
			continuation_step: ParsePostfixContinuationStep = postfix_continuation_after_newline(st)
			st = continuation_step.state

			if continuation_step.opened_indent:
				continuation_indents += 1

			if current_is_symbol(st, DotSymbol):
				st = advance_parser(st)
				field_step: ParseIdentifierStep = parse_identifier_expected(st, "field name")
				st = field_step.state
				expr = ParsedFieldAccessExpr(
					expr,
					field_step.value,
					span_cover(parsed_expr_span(expr), field_step.value.span),
				)
			else if current_is_symbol(st, LeftParenSymbol):
				start_span: CompilerSourceSpan = parsed_expr_span(expr)
				args_step: ParseExprListStep = parse_expr_list_until(
					advance_parser(st),
					RightParenSymbol,
					True,
					header_span,
				)
				right_step: ParseSymbolStep = expect_symbol(
					args_step.state,
					RightParenSymbol,
					"expected `)` after call arguments",
				)
				st = right_step.state

				end_span: CompilerSourceSpan = if right_step.matched:
					right_step.span
				else:
					start_span

				expr = ParsedCallExpr(
					expr,
					args_step.values,
					span_cover(start_span, end_span),
				)
			else if current_is_symbol(st, LeftBracketSymbol):
				start_span: CompilerSourceSpan = parsed_expr_span(expr)
				indices_step: ParseExprListStep = parse_expr_list_until(
					advance_parser(st),
					RightBracketSymbol,
					False,
					header_span,
				)
				right_step: ParseSymbolStep = expect_symbol(
					indices_step.state,
					RightBracketSymbol,
					"expected `]` after subscript",
				)
				st = right_step.state

				end_span: CompilerSourceSpan = if right_step.matched:
					right_step.span
				else:
					start_span

				expr = ParsedSubscriptExpr(
					expr,
					indices_step.values,
					span_cover(start_span, end_span),
				)
			else:
				parsing_postfix = False

	{
		state = st,
		value = expr
	}


private pure func parse_prefix_expr_with_header_span(
	state: CompilerParserState,
	header_span: CompilerSourceSpan,
) -> ParseExprStep:
	token: CompilerToken = current_token(state)

	match token.kind:
		SymbolToken(MinusSymbol):
			operand_step: ParseExprStep = parse_prefix_expr_with_header_span(
				advance_parser(state),
				header_span,
			)
			{
				state = operand_step.state,
				value = ParsedUnaryExpr(
					ParsedNegateOp,
					operand_step.value,
					span_cover(token.span, parsed_expr_span(operand_step.value)),
				)
			}
		KeywordToken(NotKeyword):
			operand_step: ParseExprStep = parse_prefix_expr_with_header_span(
				advance_parser(state),
				header_span,
			)
			{
				state = operand_step.state,
				value = ParsedUnaryExpr(
					ParsedNotOp,
					operand_step.value,
					span_cover(token.span, parsed_expr_span(operand_step.value)),
				)
			}
		KeywordToken(DetachKeyword):
			operand_step: ParseExprStep = parse_prefix_expr_with_header_span(
				advance_parser(state),
				header_span,
			)
			{
				state = operand_step.state,
				value = ParsedDetachExpr(
					operand_step.value,
					span_cover(token.span, parsed_expr_span(operand_step.value)),
				)
			}
		KeywordToken(FuncKeyword):
			parse_lambda_expr_with_header_span(state, header_span)
		KeywordToken(PureKeyword):
			parse_lambda_expr_with_header_span(state, header_span)
		KeywordToken(IfKeyword):
			parse_if_expr_with_header_span(state, header_span)
		KeywordToken(MatchKeyword):
			parse_match_expr_with_header_span(state, header_span)
		KeywordToken(SelectKeyword):
			parse_select_expr_with_header_span(state, header_span)
		KeywordToken(ForKeyword):
			parse_for_expr_with_header_span(state, header_span)
		_:
			primary_step: ParseExprStep = parse_primary_expr(state)
			parse_postfix_expr(primary_step.state, primary_step.value, header_span)


private pure func parse_expression_with_header_span(
	state: CompilerParserState,
	min_precedence: Int,
	header_span: CompilerSourceSpan,
) -> ParseExprStep:
	prefix_step: ParseExprStep = parse_prefix_expr_with_header_span(state, header_span)
	var st: CompilerParserState = prefix_step.state
	var left: ParsedExpr = prefix_step.value
	var parsing_infix: Bool = True

	while parsing_infix and not current_is_eof(st):
		if current_is_keyword(st, AsKeyword):
			if PREC_ASCRIPTION < min_precedence:
				parsing_infix = False
			else:
				type_step: ParseTypeStep = parse_type_expr(advance_parser(st))
				left = ParsedAscriptionExpr(
					left,
					type_step.value,
					span_cover(parsed_expr_span(left), parsed_type_expr_span(type_step.value)),
				)
				st = type_step.state
		else:
			match current_infix_info(st):
				Some(info):
					if info.precedence < min_precedence:
						parsing_infix = False
					else:
						st = advance_parser(st)
						st = skip_newlines(st)
						right_step: ParseExprStep = parse_expression_with_header_span(
							st,
							info.precedence + 1,
							header_span,
						)
						left = make_infix_expr(info, left, right_step.value)
						st = right_step.state
				None:
					parsing_infix = False

	result: ParseExprStep = {
		state = st,
		value = left
	}

	if min_precedence <= PREC_LOWEST:
		parse_assignment_after_expression(result)
	else:
		result


private pure func parse_expression(
	state: CompilerParserState,
	min_precedence: Int,
) -> ParseExprStep:
	parse_expression_with_header_span(state, min_precedence, current_span(state))


private pure func parse_expr(state: CompilerParserState) -> ParseExprStep:
	parse_expression(state, PREC_LOWEST)


private pure func expect_indent(state: CompilerParserState) -> CompilerParserState:
	if current_is_indent(state):
		advance_parser(state)
	else:
		add_expected_error(
			state,
			current_span(state),
			"expected indented function body",
			["indent"],
			None,
		)


private pure func expect_dedent(state: CompilerParserState) -> CompilerParserState:
	if current_is_dedent(state):
		advance_parser(state)
	else:
		add_expected_error(
			state,
			current_span(state),
			"expected dedent after function body",
			["dedent"],
			None,
		)


private pure func parse_function_body(
	state: CompilerParserState,
	start_span: CompilerSourceSpan,
) -> ParseBodyStep:
	if current_is_newline(state):
		block_step: ParseExprStep = parse_block_after_colon(state, start_span)

		{
			state = block_step.state,
			body = Some(block_step.value)
		}
	else:
		expr_step: ParseExprStep = parse_expr(state)

		{
			state = expr_step.state,
			body = Some(expr_step.value)
		}


private pure func parse_function_decl_value(
	state: CompilerParserState,
	doc: Option[String],
	is_pure: Bool,
	annotations: List[ParsedFunctionAnnotation],
	start_span: CompilerSourceSpan,
) -> ParseFunctionStep:
	func_span: CompilerSourceSpan = current_span(state)
	var st: CompilerParserState = advance_parser(state)
	name_step: ParseIdentifierStep = parse_identifier_expected(st, EXPECTED_FUNCTION_NAME)
	st = name_step.state
	type_params_step: ParseTypeParamListStep = parse_type_params_opt(st)
	st = type_params_step.state

	left_step: ParseSymbolStep = expect_symbol(
		st,
		LeftParenSymbol,
		"expected `(` after function name",
	)
	st = left_step.state

	params_step: ParseParamsStep = if left_step.matched:
		parse_params_after_left_paren(st)
	else:
		{
			state = st,
			values = []
		}

	st = params_step.state

	var return_type: Option[ParsedTypeExpr] = None
	var end_span: CompilerSourceSpan = name_step.value.span

	if current_is_symbol(st, ArrowSymbol):
		st = advance_parser(st)
		type_step: ParseTypeStep = parse_type_expr(st)
		return_type = Some(type_step.value)
		st = type_step.state
		end_span = parsed_type_expr_span(type_step.value)

	dim_constraints_step: ParseDimConstraintListStep = parse_dim_constraints_opt(st)
	st = dim_constraints_step.state
	end_span = last_dim_constraint_span(dim_constraints_step.values, end_span)

	body_step: ParseBodyStep = if current_is_symbol(st, ColonSymbol):
		colon_step: ParseSymbolStep = expect_symbol(
			st,
			ColonSymbol,
			"expected `:` before function body",
		)
		st = colon_step.state

		if current_is_eof(st) or current_is_dedent(st):
			{
				state = st,
				body = None
			}
		else if current_is_newline(st) and not current_is_indent(advance_parser(st)):
			{
				state = st,
				body = None
			}
		else if (
			not current_is_newline(st)
			and current_span(st).start_line > colon_step.span.start_line
		):
			{
				state = st,
				body = None
			}
		else:
			parse_function_body(st, start_span)
	else if (
		current_is_newline(st)
		or current_is_dedent(st)
		or current_is_eof(st)
	):
		{
			state = st,
			body = None
		}
	else:
		error_state: CompilerParserState = add_expected_error(
			st,
			current_span(st),
			"expected `:` before function body",
			[":"],
			None,
		)
		{
			state = error_state,
			body = None
		}

	st = body_step.state

	match body_step.body:
		Some(body):
			end_span = parsed_expr_span(body)
		None:
			if end_span.start_offset == name_step.value.span.start_offset:
				end_span = func_span

	{
		state = st,
		value = {
			name = name_step.value,
			type_params = type_params_step.values,
			params = params_step.values,
			return_type = return_type,
			dim_constraints = dim_constraints_step.values,
			body = body_step.body,
			is_pure = is_pure,
			annotations = annotations,
			doc = doc,
			span = span_cover(start_span, end_span)
		}
	}


private pure func parse_function_decl(
	state: CompilerParserState,
	doc: Option[String],
	is_pure: Bool,
	annotations: List[ParsedFunctionAnnotation],
	start_span: CompilerSourceSpan,
) -> ParseDeclStep:
	function_step: ParseFunctionStep = parse_function_decl_value(
		state,
		doc,
		is_pure,
		annotations,
		start_span,
	)

	{
		state = function_step.state,
		value = FunctionParsedDecl(function_step.value)
	}


private pure func parse_import_symbol(state: CompilerParserState) -> ParseImportSymbolStep:
	name_step: ParseIdentifierStep = parse_identifier_expected(state, "import symbol")
	var st: CompilerParserState = name_step.state
	var constructors: List[ParsedIdentifier] = []
	var symbol_alias: Option[ParsedIdentifier] = None
	var end_span: CompilerSourceSpan = name_step.value.span

	if current_is_symbol(st, LeftParenSymbol):
		ctors_step: ParseIdentifierListStep = parse_identifier_list_until(
			advance_parser(st),
			RightParenSymbol,
			True,
			"constructor name",
		)
		constructors = ctors_step.values
		var ctors_state: CompilerParserState = ctors_step.state

		if constructors.length() == 0:
			ctors_state = add_expected_error(
				ctors_state,
				current_span(ctors_state),
				"expected constructor name",
				[EXPECTED_CONSTRUCTOR_NAME],
				None,
			)

		right_step: ParseSymbolStep = expect_symbol(
			ctors_state,
			RightParenSymbol,
			"expected `)` after imported constructors",
		)
		st = right_step.state

		if right_step.matched:
			end_span = right_step.span

	if current_is_keyword(st, AsKeyword):
		alias_step: ParseIdentifierStep = parse_identifier_expected(
			advance_parser(st),
			"import symbol alias",
		)
		symbol_alias = Some(alias_step.value)
		st = alias_step.state
		end_span = alias_step.value.span

	{
		state = st,
		value = {
			name = name_step.value,
			symbol_alias = symbol_alias,
			constructors = constructors,
			span = span_cover(name_step.value.span, end_span)
		}
	}


private pure func parse_import_symbols_until_line_end(
	state: CompilerParserState,
) -> ParseImportSymbolListStep:
	var st: CompilerParserState = state
	var symbols: List[ParsedImportSymbol] = []

	while not current_is_newline(st) and not current_is_block_end(st):
		before_index: Int = st.index
		symbol_step: ParseImportSymbolStep = parse_import_symbol(st)
		symbols = symbols.append(symbol_step.value)
		st = symbol_step.state

		if current_is_symbol(st, CommaSymbol):
			st = advance_parser(st)
		else if not current_is_newline(st) and not current_is_block_end(st):
			st = add_expected_error(
				st,
				current_span(st),
				"expected `,` between imported symbols",
				[","],
				None,
			)

		if (
			st.index == before_index
			and not current_is_newline(st)
			and not current_is_block_end(st)
		):
			st = advance_parser(st)

	{
		state = st,
		values = symbols
	}


private pure func parse_import_symbols_block(
	state: CompilerParserState,
) -> ParseImportSymbolListStep:
	var st: CompilerParserState = expect_indent(state)
	st = skip_newlines(st)
	var symbols: List[ParsedImportSymbol] = []

	while not current_is_block_end(st):
		before_index: Int = st.index
		line_step: ParseImportSymbolListStep = parse_import_symbols_until_line_end(st)
		symbols = symbols.concat(line_step.values)
		st = skip_newlines(line_step.state)

		if st.index == before_index and not current_is_block_end(st):
			st = advance_parser(st)

	if current_is_dedent(st):
		st = advance_parser(st)

	{
		state = st,
		values = symbols
	}


private pure func parse_module_path(state: CompilerParserState) -> ParseModulePathStep:
	var st: CompilerParserState = state
	var prefix: String = ""
	var start_span: CompilerSourceSpan = current_span(state)

	if current_is_symbol(st, DotSymbol) and next_is_symbol(st, SlashSymbol):
		prefix = "./"
		st = advance_parser(advance_parser(st))
	else:
		var parsing_parent_prefix: Bool = True

		while parsing_parent_prefix:
			if current_is_symbol(st, DotDotSymbol) and next_is_symbol(st, SlashSymbol):
				prefix += "../"
				st = advance_parser(advance_parser(st))
			else:
				parsing_parent_prefix = False

	first_step: ParseIdentifierStep = parse_identifier_expected(st, "module path")
	st = first_step.state
	var path: String = prefix + first_step.value.text
	var end_span: CompilerSourceSpan = first_step.value.span

	while current_is_symbol(st, SlashSymbol):
		st = advance_parser(st)
		part_step: ParseIdentifierStep = parse_identifier_expected(st, "module path")
		part_text: String = part_step.value.text
		path = "${path}/${part_text}"
		st = part_step.state
		end_span = part_step.value.span

	{
		state = st,
		value = path,
		span = span_cover(start_span, end_span)
	}


private pure func parse_import_item(state: CompilerParserState) -> ParseImportItemStep:
	path_step: ParseModulePathStep = parse_module_path(state)
	var st: CompilerParserState = path_step.state
	var module_alias: Option[ParsedIdentifier] = None
	var symbols: Option[List[ParsedImportSymbol]] = None
	var end_span: CompilerSourceSpan = path_step.span

	if current_is_keyword(st, AsKeyword):
		alias_step: ParseIdentifierStep = parse_identifier_expected(
			advance_parser(st),
			"module alias",
		)
		module_alias = Some(alias_step.value)
		st = alias_step.state
		end_span = alias_step.value.span

	if current_is_symbol(st, ColonSymbol):
		st = advance_parser(st)

		if current_is_newline(st):
			block_start: CompilerParserState = skip_newlines(st)

			if current_is_indent(block_start):
				symbols_step: ParseImportSymbolListStep = parse_import_symbols_block(block_start)
				symbols = Some(symbols_step.values)
				st = symbols_step.state

				match symbols_step.values.get(symbols_step.values.length() - 1):
					Some(last_symbol):
						end_span = last_symbol.span
					None:
						void
			else:
				st = add_expected_error(
					st,
					current_span(st),
					"expected import symbols after `:`",
					["import symbol"],
					None,
				)
				symbols = Some([])
		else:
			symbols_step: ParseImportSymbolListStep = parse_import_symbols_until_line_end(st)
			symbols = Some(symbols_step.values)
			st = symbols_step.state

			match symbols_step.values.get(symbols_step.values.length() - 1):
				Some(last_symbol):
					end_span = last_symbol.span
				None:
					void

	{
		state = st,
		value = {
			module_path = path_step.value,
			module_alias = module_alias,
			symbols = symbols,
			span = span_cover(path_step.span, end_span)
		}
	}


private pure func parse_import_item_list(state: CompilerParserState) -> ParseImportItemListStep:
	var st: CompilerParserState = skip_newlines(state)
	var items: List[ParsedImportDecl] = []

	while not current_is_block_end(st):
		before_index: Int = st.index
		item_step: ParseImportItemStep = parse_import_item(st)
		items = items.append(item_step.value)
		st = skip_newlines(item_step.state)

		if st.index == before_index and not current_is_block_end(st):
			st = advance_parser(st)

	{
		state = st,
		values = items
	}


private pure func parse_import_block_decl(
	state: CompilerParserState,
	start_span: CompilerSourceSpan,
) -> ParseDeclStep:
	var st: CompilerParserState = advance_parser(state)
	colon_step: ParseSymbolStep = expect_symbol(st, ColonSymbol, "expected `:` after import")
	st = expect_newline(colon_step.state, "expected newline after import header")
	st = expect_indent(st)
	items_step: ParseImportItemListStep = parse_import_item_list(st)
	st = items_step.state

	end_span: CompilerSourceSpan = if current_is_dedent(st):
		current_span(st)
	else:
		start_span

	st = expect_dedent(st)

	{
		state = st,
		value = ImportBlockParsedDecl(
			items_step.values,
			span_cover(start_span, end_span),
		)
	}


private pure func add_foreign_block_only_error(
	state: CompilerParserState,
	span: CompilerSourceSpan,
) -> CompilerParserState:
	add_expected_error(
		state,
		span,
		(
			"foreign declarations must use a foreign: block; write `foreign:` and indent "
			+ "`func ...` inside it"
		),
		["foreign:"],
		Some("write `foreign:` followed by an indented function signature"),
	)


private pure func parse_foreign_block_arg(state: CompilerParserState) -> ParseForeignBlockArgStep:
	name_step: ParseIdentifierStep = parse_identifier_expected(state, EXPECTED_FOREIGN_BLOCK_ARG)
	var st: CompilerParserState = name_step.state
	colon_step: ParseSymbolStep = expect_symbol(
		st,
		ColonSymbol,
		"expected `:` after foreign block argument name",
	)
	st = colon_step.state
	var value: String = ""
	var end_span: CompilerSourceSpan = name_step.value.span

	match current_token(st).kind:
		StringLiteralToken(_, text):
			value = text
			end_span = current_span(st)
			st = advance_parser(st)
		_:
			st = add_expected_error(
				st,
				current_span(st),
				"expected foreign block argument value",
				["string literal"],
				Some("write foreign block arguments as name: \"value\""),
			)

			if not current_is_soft_boundary(st):
				st = advance_parser(st)

	{
		state = st,
		value = {
			name = name_step.value,
			value = value,
			span = span_cover(name_step.value.span, end_span)
		}
	}


private pure func parse_foreign_block_arg_list_until_right_paren(
	state: CompilerParserState,
) -> ParseForeignBlockArgListStep:
	var st: CompilerParserState = state
	var values: List[ParsedForeignBlockArg] = []

	if current_is_symbol(st, RightParenSymbol):
		st = add_expected_error(
			st,
			current_span(st),
			"expected foreign block argument",
			[EXPECTED_FOREIGN_BLOCK_ARG],
			Some("omit the parentheses for a foreign block with no arguments"),
		)
	else:
		var parsing_args: Bool = True

		while parsing_args and not current_is_eof(st):
			before_index: Int = st.index
			arg_step: ParseForeignBlockArgStep = parse_foreign_block_arg(st)
			values = values.append(arg_step.value)
			st = arg_step.state

			if current_is_symbol(st, CommaSymbol):
				st = advance_parser(st)

				if current_is_symbol(st, RightParenSymbol):
					parsing_args = False
			else if current_is_symbol(st, RightParenSymbol):
				parsing_args = False
			else:
				st = add_expected_error(
					st,
					current_span(st),
					"expected `,` between foreign block arguments",
					[","],
					None,
				)

			if st.index == before_index and not current_is_symbol(st, RightParenSymbol):
				st = advance_parser(st)

	{
		state = st,
		values = values
	}


private pure func current_can_start_foreign_function(state: CompilerParserState) -> Bool:
	(
		current_is_keyword(state, PrivateKeyword)
		or current_is_keyword(state, PureKeyword)
		or current_is_keyword(state, FuncKeyword)
		or current_is_symbol(state, AtSymbol)
	)


private pure func parse_foreign_function_decl(
	state: CompilerParserState,
) -> ParseForeignFunctionStep:
	var st: CompilerParserState = state
	start_span: CompilerSourceSpan = current_span(st)
	var is_private: Bool = False

	if current_is_keyword(st, PrivateKeyword):
		is_private = True
		st = advance_parser(st)

	annotations_step: ParseFunctionAnnotationsStep = parse_function_annotations(st, False)
	st = annotations_step.state
	var is_pure: Bool = False

	if current_is_keyword(st, PureKeyword):
		is_pure = True
		st = advance_parser(st)

	st = expect_keyword(st, FuncKeyword, "func", "expected `func` in foreign block item")
	name_step: ParseIdentifierStep = parse_identifier_expected(st, EXPECTED_FUNCTION_NAME)
	st = name_step.state
	left_step: ParseSymbolStep = expect_symbol(
		st,
		LeftParenSymbol,
		"expected `(` after foreign function name",
	)
	st = left_step.state

	params_step: ParseParamsStep = if left_step.matched:
		parse_params_after_left_paren(st)
	else:
		{
			state = st,
			values = []
		}

	st = params_step.state
	var return_type: ParsedTypeExpr = ParsedMissingType(current_span(st))
	var end_span: CompilerSourceSpan = name_step.value.span
	arrow_step: ParseSymbolStep = expect_symbol(
		st,
		ArrowSymbol,
		"expected `->` before foreign function return type",
	)
	st = arrow_step.state

	if arrow_step.matched:
		type_step: ParseTypeStep = parse_type_expr(st)
		return_type = type_step.value
		st = type_step.state
		end_span = parsed_type_expr_span(type_step.value)
	else:
		end_span = arrow_step.span

	var c_name: Option[String] = None

	if current_is_symbol(st, EqualSymbol):
		st = advance_parser(st)

		match current_token(st).kind:
			StringLiteralToken(_, text):
				c_name = Some(text)
				end_span = current_span(st)
				st = advance_parser(st)
			_:
				st = add_expected_error(
					st,
					current_span(st),
					"expected foreign C function name",
					["string literal"],
					Some("write = \"c_function_name\" or omit the C name to use the Blorp name"),
				)

				if not current_is_soft_boundary(st):
					st = advance_parser(st)

	{
		state = st,
		value = {
			name = name_step.value,
			params = params_step.values,
			return_type = return_type,
			c_name = c_name,
			is_pure = is_pure,
			is_private = is_private,
			annotations = annotations_step.values,
			span = span_cover(start_span, end_span)
		}
	}


private pure func parse_foreign_function_list(
	state: CompilerParserState,
) -> ParseForeignFunctionListStep:
	var st: CompilerParserState = skip_newlines(state)
	var values: List[ParsedForeignFunctionDecl] = []

	while not current_is_block_end(st):
		before_index: Int = st.index

		if current_can_start_foreign_function(st):
			function_step: ParseForeignFunctionStep = parse_foreign_function_decl(st)
			values = values.append(function_step.value)
			st = skip_newlines(function_step.state)
		else:
			st = add_expected_error(
				st,
				current_span(st),
				"expected foreign function declaration",
				["func"],
				Some("write a bodyless function signature inside the foreign block"),
			)

			if not current_is_block_end(st):
				st = advance_parser(st)

			st = skip_newlines(st)

		if st.index == before_index and not current_is_block_end(st):
			st = advance_parser(st)

	{
		state = st,
		values = values
	}


private pure func parse_foreign_block_decl(
	state: CompilerParserState,
	start_span: CompilerSourceSpan,
) -> ParseDeclStep:
	var st: CompilerParserState = advance_parser(state)

	if current_is_keyword(st, PureKeyword) or current_is_keyword(st, FuncKeyword):
		error_state: CompilerParserState = add_foreign_block_only_error(st, start_span)

		{
			state = advance_parser(error_state),
			value = ParsedErrorDecl(start_span)
		}
	else:
		var args: List[ParsedForeignBlockArg] = []

		if current_is_symbol(st, LeftParenSymbol):
			args_step: ParseForeignBlockArgListStep = parse_foreign_block_arg_list_until_right_paren(
				advance_parser(st),
			)
			args = args_step.values
			right_step: ParseSymbolStep = expect_symbol(
				args_step.state,
				RightParenSymbol,
				"expected `)` after foreign block arguments",
			)
			st = right_step.state

		colon_step: ParseSymbolStep = expect_symbol(st, ColonSymbol, "expected `:` after foreign")
		st = expect_newline(colon_step.state, "expected newline after foreign header")
		st = expect_indent(st)
		functions_step: ParseForeignFunctionListStep = parse_foreign_function_list(st)
		st = functions_step.state

		end_span: CompilerSourceSpan = if current_is_dedent(st):
			current_span(st)
		else:
			start_span

		st = expect_dedent(st)

		{
			state = st,
			value = ForeignBlockParsedDecl(
				args,
				functions_step.values,
				span_cover(start_span, end_span),
			)
		}


private pure func parse_field_decl(state: CompilerParserState) -> ParseFieldStep:
	name_step: ParseIdentifierStep = parse_identifier_expected(state, "field name")
	colon_step: ParseSymbolStep = expect_symbol(
		name_step.state,
		ColonSymbol,
		"expected `:` after field name",
	)
	type_step: ParseTypeStep = parse_type_expr(colon_step.state)

	{
		state = type_step.state,
		value = {
			name = name_step.value,
			type_expr = type_step.value,
			span = span_cover(name_step.value.span, parsed_type_expr_span(type_step.value))
		}
	}


private pure func parse_field_list_until_right_brace(
	state: CompilerParserState,
) -> ParseFieldListStep:
	var st: CompilerParserState = state
	var fields: List[ParsedFieldDecl] = []

	if not current_is_symbol(st, RightBraceSymbol):
		var parsing_fields: Bool = True

		while parsing_fields and not current_is_eof(st):
			field_step: ParseFieldStep = parse_field_decl(st)
			fields = fields.append(field_step.value)
			st = field_step.state

			if current_is_symbol(st, CommaSymbol):
				st = advance_parser(st)

				if current_is_symbol(st, RightBraceSymbol):
					parsing_fields = False
			else:
				parsing_fields = False

	{
		state = st,
		values = fields
	}


private pure func parse_record_decl(
	state: CompilerParserState,
	doc: Option[String],
	is_struct: Bool,
	start_span: CompilerSourceSpan,
) -> ParseDeclStep:
	var st: CompilerParserState = advance_parser(state)
	name_step: ParseIdentifierStep = parse_identifier_expected(st, "record name")
	st = name_step.state

	type_params_step: ParseTypeParamListStep = if is_struct:
		{
			state = st,
			values = []
		}
	else:
		parse_type_params_opt(st)

	st = type_params_step.state
	left_step: ParseSymbolStep = expect_symbol(
		st,
		LeftBraceSymbol,
		"expected `{` before record fields",
	)
	fields_step: ParseFieldListStep = parse_field_list_until_right_brace(left_step.state)
	right_step: ParseSymbolStep = expect_symbol(
		fields_step.state,
		RightBraceSymbol,
		"expected `}` after record fields",
	)

	{
		state = right_step.state,
		value = RecordParsedDecl({
			name = name_step.value,
			type_params = type_params_step.values,
			fields = fields_step.values,
			is_struct = is_struct,
			doc = doc,
			span = span_cover(start_span, right_step.span),
		})
	}


private pure func parse_variant_identifier_expected(
	state: CompilerParserState,
) -> ParseIdentifierStep:
	token: CompilerToken = current_token(state)

	match token.kind:
		KeywordToken(TrueKeyword):
			{
				state = advance_parser(state),
				value = parsed_identifier("True", token.span)
			}
		KeywordToken(FalseKeyword):
			{
				state = advance_parser(state),
				value = parsed_identifier("False", token.span)
			}
		_:
			parse_identifier_expected(state, "variant name")


private pure func parse_variant_decl(state: CompilerParserState) -> ParseVariantStep:
	name_step: ParseIdentifierStep = parse_variant_identifier_expected(state)
	var st: CompilerParserState = name_step.state
	var fields: List[ParsedTypeExpr] = []
	var end_span: CompilerSourceSpan = name_step.value.span

	if current_is_symbol(st, LeftParenSymbol):
		fields_step: ParseTypeListStep = parse_type_expr_list_until(
			advance_parser(st),
			RightParenSymbol,
			True,
		)
		fields = fields_step.values
		right_step: ParseSymbolStep = expect_symbol(
			fields_step.state,
			RightParenSymbol,
			"expected `)` after variant fields",
		)
		st = right_step.state

		if right_step.matched:
			end_span = right_step.span

	{
		state = st,
		value = {
			name = name_step.value,
			fields = fields,
			span = span_cover(name_step.value.span, end_span)
		}
	}


private pure func parse_variant_list(state: CompilerParserState) -> ParseVariantListStep:
	var st: CompilerParserState = skip_newlines(state)
	var variants: List[ParsedVariantDecl] = []

	while not current_is_block_end(st):
		before_index: Int = st.index
		variant_step: ParseVariantStep = parse_variant_decl(st)
		variants = variants.append(variant_step.value)
		st = skip_newlines(variant_step.state)

		if st.index == before_index and not current_is_block_end(st):
			st = advance_parser(st)

	{
		state = st,
		values = variants
	}


private pure func parse_union_decl(
	state: CompilerParserState,
	doc: Option[String],
	is_enum: Bool,
	start_span: CompilerSourceSpan,
) -> ParseDeclStep:
	var st: CompilerParserState = advance_parser(state)
	name_step: ParseIdentifierStep = parse_identifier_expected(st, "type name")
	st = name_step.state

	type_params_step: ParseTypeParamListStep = if is_enum:
		{
			state = st,
			values = []
		}
	else:
		parse_type_params_opt(st)

	st = type_params_step.state
	colon_step: ParseSymbolStep = expect_symbol(st, ColonSymbol, "expected `:` before variants")
	st = expect_newline(colon_step.state, "expected newline before variants")
	st = expect_indent(st)
	variants_step: ParseVariantListStep = parse_variant_list(st)
	st = variants_step.state

	end_span: CompilerSourceSpan = if current_is_dedent(st):
		current_span(st)
	else:
		name_step.value.span

	st = expect_dedent(st)

	{
		state = st,
		value = UnionParsedDecl({
			name = name_step.value,
			type_params = type_params_step.values,
			variants = variants_step.values,
			is_enum = is_enum,
			doc = doc,
			span = span_cover(start_span, end_span),
		})
	}


private pure func consume_builtin_type_argument_list(
	state: CompilerParserState,
) -> CompilerParserState:
	var st: CompilerParserState = add_expected_error(
		state,
		current_span(state),
		"builtin type declarations do not take arguments",
		[],
		Some("use `resource type Name = builtin(\"cleanup\")` for resource cleanup metadata"),
	)

	st = advance_parser(st)

	while (
		not current_is_eof(st)
		and not current_is_newline(st)
		and not current_is_symbol(st, RightParenSymbol)
	):
		st = advance_parser(st)

	if current_is_symbol(st, RightParenSymbol):
		advance_parser(st)
	else:
		st


private pure func parse_builtin_type_decl(
	state: CompilerParserState,
	doc: Option[String],
	is_resource: Bool,
	start_span: CompilerSourceSpan,
) -> ParseDeclStep:
	var st: CompilerParserState = if is_resource:
		advance_parser(state)
	else:
		state

	st = expect_keyword(st, TypeKeyword, "type", "expected `type` in builtin type declaration")
	name_step: ParseIdentifierStep = parse_identifier_expected(st, "type name")
	st = name_step.state
	type_params_step: ParseTypeParamListStep = parse_type_params_opt(st)
	st = type_params_step.state
	equal_step: ParseSymbolStep = expect_symbol(
		st,
		EqualSymbol,
		"expected `=` before builtin type marker",
	)
	builtin_span: CompilerSourceSpan = current_span(equal_step.state)
	st = expect_keyword(equal_step.state, BuiltinKeyword, "builtin", "expected `builtin` after `=`")
	var cleanup: Option[ParsedResourceCleanup] = None
	var end_span: CompilerSourceSpan = builtin_span

	if current_is_symbol(st, LeftParenSymbol):
		if is_resource:
			st = advance_parser(st)

			match current_token(st).kind:
				StringLiteralToken(_, text):
					cleanup = Some({
						builtin_name = text,
						span = current_span(st),
					})
					end_span = current_span(st)
					st = advance_parser(st)
				_:
					st = add_expected_error(
						st,
						current_span(st),
						"expected resource cleanup builtin name",
						["string literal"],
						Some("write resource type Name = builtin(\"cleanup_function\")"),
					)

					if not current_is_soft_boundary(st):
						st = advance_parser(st)

			right_step: ParseSymbolStep = expect_symbol(
				st,
				RightParenSymbol,
				"expected `)` after resource cleanup builtin name",
			)
			st = right_step.state

			if right_step.matched:
				end_span = right_step.span
		else:
			st = consume_builtin_type_argument_list(st)

	{
		state = st,
		value = BuiltinTypeParsedDecl({
			name = name_step.value,
			type_params = type_params_step.values,
			is_resource = is_resource,
			cleanup = cleanup,
			doc = doc,
			span = span_cover(start_span, end_span),
		})
	}


private pure func parse_type_alias_decl(
	state: CompilerParserState,
	doc: Option[String],
	is_opaque: Bool,
	start_span: CompilerSourceSpan,
) -> ParseDeclStep:
	var st: CompilerParserState = advance_parser(state)

	if is_opaque:
		st = expect_keyword(st, TypeKeyword, "type", "expected `type` after `opaque`")
	else:
		st = expect_keyword(st, AliasKeyword, "alias", "expected `alias` after `type`")

	name_step: ParseIdentifierStep = parse_identifier_expected(st, "type alias name")
	st = name_step.state
	type_params_step: ParseTypeParamListStep = parse_type_params_opt(st)
	st = type_params_step.state
	equal_step: ParseSymbolStep = expect_symbol(
		st,
		EqualSymbol,
		"expected `=` before type alias target",
	)
	target_step: ParseTypeStep = parse_type_expr(equal_step.state)

	{
		state = target_step.state,
		value = TypeAliasParsedDecl({
			name = name_step.value,
			type_params = type_params_step.values,
			target = target_step.value,
			is_opaque = is_opaque,
			doc = doc,
			span = span_cover(start_span, parsed_type_expr_span(target_step.value)),
		})
	}


private pure func parse_supertrait_list(state: CompilerParserState) -> ParseIdentifierListStep:
	var st: CompilerParserState = state
	var values: List[ParsedIdentifier] = []
	var parsing_values: Bool = True

	while parsing_values and not current_is_eof(st):
		name_step: ParseIdentifierStep = parse_identifier_expected(st, "supertrait name")
		values = values.append(name_step.value)
		st = name_step.state

		if current_is_symbol(st, PlusSymbol):
			st = advance_parser(st)
		else:
			parsing_values = False

	{
		state = st,
		values = values
	}


private pure func parse_trait_method(state: CompilerParserState) -> ParseTraitMethodStep:
	var st: CompilerParserState = state
	var is_pure: Bool = False
	start_span: CompilerSourceSpan = current_span(st)

	if current_is_keyword(st, PureKeyword):
		is_pure = True
		st = advance_parser(st)

	st = expect_keyword(st, FuncKeyword, "func", "expected `func` before trait method")
	name_step: ParseIdentifierStep = parse_identifier_expected(st, "trait method name")
	st = name_step.state
	left_step: ParseSymbolStep = expect_symbol(
		st,
		LeftParenSymbol,
		"expected `(` after trait method name",
	)
	st = left_step.state

	params_step: ParseParamsStep = if left_step.matched:
		parse_params_after_left_paren(st)
	else:
		{
			state = st,
			values = []
		}

	st = params_step.state
	var return_type: Option[ParsedTypeExpr] = None
	var body: Option[ParsedExpr] = None
	var end_span: CompilerSourceSpan = name_step.value.span

	if current_is_symbol(st, ArrowSymbol):
		st = advance_parser(st)
		type_step: ParseTypeStep = parse_type_expr(st)
		return_type = Some(type_step.value)
		st = type_step.state
		end_span = parsed_type_expr_span(type_step.value)

	if current_is_symbol(st, ColonSymbol):
		colon_step: ParseSymbolStep = expect_symbol(
			st,
			ColonSymbol,
			"expected `:` before trait method body",
		)
		body_step: ParseBodyStep = parse_function_body(colon_step.state, start_span)
		body = body_step.body
		st = body_step.state

		match body_step.body:
			Some(body_expr):
				end_span = parsed_expr_span(body_expr)
			None:
				end_span = colon_step.span

	{
		state = st,
		value = {
			name = name_step.value,
			params = params_step.values,
			return_type = return_type,
			body = body,
			is_pure = is_pure,
			span = span_cover(start_span, end_span)
		}
	}


private pure func parse_trait_method_list(state: CompilerParserState) -> ParseTraitMethodListStep:
	var st: CompilerParserState = skip_newlines(state)
	var values: List[ParsedTraitMethodDecl] = []

	while not current_is_block_end(st):
		before_index: Int = st.index
		method_step: ParseTraitMethodStep = parse_trait_method(st)
		values = values.append(method_step.value)
		st = skip_newlines(method_step.state)

		if st.index == before_index and not current_is_block_end(st):
			st = advance_parser(st)

	{
		state = st,
		values = values
	}


private pure func parse_trait_decl(
	state: CompilerParserState,
	doc: Option[String],
	start_span: CompilerSourceSpan,
) -> ParseDeclStep:
	var st: CompilerParserState = advance_parser(state)
	name_step: ParseIdentifierStep = parse_identifier_expected(st, "trait name")
	st = name_step.state
	type_params_step: ParseTypeParamListStep = parse_type_params_opt(st)
	st = type_params_step.state
	colon_step: ParseSymbolStep = expect_symbol(st, ColonSymbol, "expected `:` after trait name")
	st = colon_step.state
	var supertraits: List[ParsedIdentifier] = []
	var methods: List[ParsedTraitMethodDecl] = []
	var has_method_block: Bool = False
	var end_span: CompilerSourceSpan = name_step.value.span

	if current_is_newline(st):
		has_method_block = True
	else if current_is_block_end(st):
		st = add_expected_error(
			st,
			current_span(st),
			"expected supertrait or trait method block",
			["supertrait", "trait method block"],
			None,
		)
	else:
		supertraits_step: ParseIdentifierListStep = parse_supertrait_list(st)
		supertraits = supertraits_step.values
		st = supertraits_step.state
		end_span = last_identifier_span(supertraits, end_span)

		if current_is_symbol(st, ColonSymbol):
			second_colon_step: ParseSymbolStep = expect_symbol(
				st,
				ColonSymbol,
				"expected `:` before trait methods",
			)
			st = second_colon_step.state
			has_method_block = True

	if has_method_block:
		st = expect_newline(st, "expected newline before trait methods")
		st = expect_indent(st)
		methods_step: ParseTraitMethodListStep = parse_trait_method_list(st)
		methods = methods_step.values
		st = methods_step.state

		if current_is_dedent(st):
			end_span = current_span(st)

		st = expect_dedent(st)

	{
		state = st,
		value = TraitParsedDecl({
			name = name_step.value,
			type_params = type_params_step.values,
			supertraits = supertraits,
			methods = methods,
			doc = doc,
			span = span_cover(start_span, end_span),
		})
	}


private pure func parse_impl_method_list(state: CompilerParserState) -> ParseImplMethodListStep:
	var st: CompilerParserState = skip_newlines(state)
	var values: List[ParsedFunctionDecl] = []

	while not current_is_block_end(st):
		before_index: Int = st.index
		var method_start_span: CompilerSourceSpan = current_span(st)
		annotations_step: ParseFunctionAnnotationsStep = parse_function_annotations(st, True)

		if annotations_step.values.length() > 0:
			method_start_span = current_span(st)

		st = annotations_step.state
		var is_pure: Bool = False

		if current_is_keyword(st, PureKeyword):
			is_pure = True

			if annotations_step.values.length() == 0:
				method_start_span = current_span(st)

			st = advance_parser(st)

		if current_is_keyword(st, FuncKeyword):
			function_step: ParseFunctionStep = parse_function_decl_value(
				st,
				None,
				is_pure,
				annotations_step.values,
				method_start_span,
			)
			values = values.append(function_step.value)
			st = skip_newlines(function_step.state)
		else:
			st = add_expected_error(
				st,
				current_span(st),
				"expected implementation method",
				["func"],
				Some("write a function declaration inside the implements block"),
			)

			if not current_is_block_end(st):
				st = advance_parser(st)

		if st.index == before_index and not current_is_block_end(st):
			st = advance_parser(st)

	{
		state = st,
		values = values
	}


private pure func parse_impl_decl(
	state: CompilerParserState,
	doc: Option[String],
	start_span: CompilerSourceSpan,
) -> ParseDeclStep:
	var st: CompilerParserState = advance_parser(state)
	trait_name_step: ParseIdentifierStep = parse_identifier_expected(st, "trait name")
	st = trait_name_step.state
	st = expect_keyword(st, ForKeyword, "for", "expected `for` after trait name")
	for_type_step: ParseTypeStep = parse_type_expr(st)
	st = for_type_step.state
	colon_step: ParseSymbolStep = expect_symbol(
		st,
		ColonSymbol,
		"expected `:` before implementation methods",
	)
	st = expect_newline(colon_step.state, "expected newline before implementation methods")
	st = expect_indent(st)
	methods_step: ParseImplMethodListStep = parse_impl_method_list(st)
	st = methods_step.state

	end_span: CompilerSourceSpan = if current_is_dedent(st):
		current_span(st)
	else:
		parsed_type_expr_span(for_type_step.value)

	st = expect_dedent(st)

	{
		state = st,
		value = ImplParsedDecl({
			trait_name = trait_name_step.value,
			for_type = for_type_step.value,
			methods = methods_step.values,
			doc = doc,
			span = span_cover(start_span, end_span),
		})
	}


private pure func parse_top_level_var_decl(
	state: CompilerParserState,
	is_mutable: Bool,
	start_span: CompilerSourceSpan,
) -> ParseDeclStep:
	var st: CompilerParserState = if is_mutable:
		advance_parser(state)
	else:
		state

	name_step: ParseIdentifierStep = parse_binder_identifier_expected(st, "variable name")
	type_step: ParseOptionalTypeStep = parse_optional_type_annotation(name_step.state)
	st = type_step.state

	equal_step: ParseSymbolStep = expect_symbol(
		st,
		EqualSymbol,
		"expected `=` after top-level variable declaration",
	)
	value_step: ParseExprStep = parse_assignment_value_expr(equal_step.state, start_span)

	{
		state = value_step.state,
		value = VarParsedDecl({
			name = name_step.value,
			type_expr = type_step.value,
			value = value_step.value,
			is_mutable = is_mutable,
			span = span_cover(start_span, parsed_expr_span(value_step.value)),
		})
	}


private pure func parse_private_decl(
	state: CompilerParserState,
	doc: Option[String],
	start_span: CompilerSourceSpan,
) -> ParseDeclStep:
	var st: CompilerParserState = advance_parser(state)
	var inner_start_span: CompilerSourceSpan = start_span

	annotations_step: ParseFunctionAnnotationsStep = parse_function_annotations(st, False)

	st = annotations_step.state

	var is_pure: Bool = False

	if current_is_keyword(st, PureKeyword):
		is_pure = True

		st = advance_parser(st)

	if annotations_step.values.length() > 0 and not current_is_keyword(st, FuncKeyword):
		st = add_expected_error(
			st,
			current_span(st),
			"function annotations must be followed by a function declaration",
			["func"],
			Some("move the annotation onto a function declaration, or remove it"),
		)

	inner_step: ParseDeclStep = if current_is_keyword(st, FuncKeyword):
		parse_function_decl(st, doc, is_pure, annotations_step.values, inner_start_span)
	else if current_is_keyword(st, VarKeyword):
		parse_top_level_var_decl(st, True, inner_start_span)
	else if current_is_keyword(st, RecordKeyword):
		parse_record_decl(st, doc, False, inner_start_span)
	else if current_is_keyword(st, StructKeyword):
		parse_record_decl(st, doc, True, inner_start_span)
	else if current_is_keyword(st, UnionKeyword):
		parse_union_decl(st, doc, False, inner_start_span)
	else if current_is_keyword(st, EnumKeyword):
		parse_union_decl(st, doc, True, inner_start_span)
	else if current_is_keyword(st, TypeKeyword):
		if next_is_keyword(st, AliasKeyword):
			parse_type_alias_decl(st, doc, False, inner_start_span)
		else:
			parse_builtin_type_decl(st, doc, False, inner_start_span)
	else if current_is_keyword(st, OpaqueKeyword):
		parse_type_alias_decl(st, doc, True, inner_start_span)
	else if current_is_keyword(st, ResourceKeyword):
		parse_builtin_type_decl(st, doc, True, inner_start_span)
	else if current_is_keyword(st, TraitKeyword):
		parse_trait_decl(st, doc, inner_start_span)
	else if current_is_keyword(st, ImplementsKeyword):
		parse_impl_decl(st, doc, inner_start_span)
	else:
		match current_token(st).kind:
			IdentifierToken(_):
				parse_top_level_var_decl(st, False, inner_start_span)
			_:
				parse_error_decl(st)

	{
		state = inner_step.state,
		value = PrivateParsedDecl(
			inner_step.value,
			span_cover(start_span, parsed_decl_span(inner_step.value)),
		)
	}


private pure func parse_decl(state: CompilerParserState) -> ParseDeclStep:
	var st: CompilerParserState = skip_newlines(state)
	var doc: Option[String] = None
	var start_span: CompilerSourceSpan = current_span(st)

	match current_token(st).kind:
		DocStringToken(text):
			doc = Some(text)
			start_span = current_span(st)
			st = advance_parser(st)
			st = skip_newlines(st)
		_:
			void

	annotations_step: ParseFunctionAnnotationsStep = parse_function_annotations(st, True)

	if annotations_step.values.length() > 0 and doc.is_none():
		start_span = current_span(st)

	st = annotations_step.state

	var is_pure: Bool = False

	if current_is_keyword(st, PureKeyword):
		is_pure = True

		if doc.is_none() and annotations_step.values.length() == 0:
			start_span = current_span(st)

		st = advance_parser(st)

	if annotations_step.values.length() > 0 and not current_is_keyword(st, FuncKeyword):
		st = add_expected_error(
			st,
			current_span(st),
			"function annotations must be followed by a function declaration",
			["func"],
			Some("move the annotation onto a function declaration, or remove it"),
		)

	if current_is_keyword(st, PrivateKeyword):
		parse_private_decl(st, doc, start_span)
	else if current_is_keyword(st, ImportKeyword):
		parse_import_block_decl(st, start_span)
	else if current_is_keyword(st, ForeignKeyword):
		parse_foreign_block_decl(st, start_span)
	else if current_is_keyword(st, FuncKeyword):
		parse_function_decl(st, doc, is_pure, annotations_step.values, start_span)
	else if current_is_keyword(st, VarKeyword):
		parse_top_level_var_decl(st, True, start_span)
	else if current_is_keyword(st, RecordKeyword):
		parse_record_decl(st, doc, False, start_span)
	else if current_is_keyword(st, StructKeyword):
		parse_record_decl(st, doc, True, start_span)
	else if current_is_keyword(st, UnionKeyword):
		parse_union_decl(st, doc, False, start_span)
	else if current_is_keyword(st, EnumKeyword):
		parse_union_decl(st, doc, True, start_span)
	else if current_is_keyword(st, TypeKeyword):
		if next_is_keyword(st, AliasKeyword):
			parse_type_alias_decl(st, doc, False, start_span)
		else:
			parse_builtin_type_decl(st, doc, False, start_span)
	else if current_is_keyword(st, OpaqueKeyword):
		parse_type_alias_decl(st, doc, True, start_span)
	else if current_is_keyword(st, ResourceKeyword):
		parse_builtin_type_decl(st, doc, True, start_span)
	else if current_is_keyword(st, TraitKeyword):
		parse_trait_decl(st, doc, start_span)
	else if current_is_keyword(st, ImplementsKeyword):
		parse_impl_decl(st, doc, start_span)
	else:
		match current_token(st).kind:
			IdentifierToken(_):
				parse_top_level_var_decl(st, False, start_span)
			_:
				parse_error_decl(st)


private pure func parse_error_decl(state: CompilerParserState) -> ParseDeclStep:
	error_span: CompilerSourceSpan = current_span(state)
	next_state: CompilerParserState = add_expected_error(
		state,
		error_span,
		"expected declaration",
		[EXPECTED_DECLARATION],
		Some("start a function declaration with `func`"),
	)

	recovery_state: CompilerParserState = if current_is_eof(next_state):
		next_state
	else:
		advance_parser(next_state)

	{
		state = recovery_state,
		value = ParsedErrorDecl(error_span)
	}


pure func parse_compiler_source(source: CompilerSourceFile) -> ParsedProgram:
	lex_result = compiler_lex(source)
	var st: CompilerParserState = initial_state(source, lex_result.tokens, lex_result.diagnostics)
	var decls: List[ParsedDecl] = []

	st = skip_newlines(st)

	while not current_is_eof(st):
		before_index: Int = st.index
		decl_step: ParseDeclStep = parse_decl(st)
		decls = decls.append(decl_step.value)
		st = skip_newlines(decl_step.state)

		if st.index == before_index and not current_is_eof(st):
			st = advance_parser(st)

	{
		source = source,
		decls = decls,
		diagnostics = st.diagnostics
	}
