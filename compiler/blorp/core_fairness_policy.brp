-- Blorp-owned policy table for cooperative-fairness checkpoint insertion.
--
-- OCaml still owns Core AST traversal and node-shape classification. This
-- module owns the named policy answers consumed by Core_fairness through the
-- single JSON bridge.
import:
	codegen_template_registry:
		render_template_arity_error,
		render_template_manifest_line,
		render_unsupported_template_error,


enum FairnessTemplate:
	BodyCheckpointTemplate
	BodySeqCheckpointTemplate
	BodyOtherTemplate


record FairnessTemplateInfo {
	template: FairnessTemplate,
	name: String,
	arity: Int
}


union FairnessOp:
	BodyCheckpoint
	BodySeqCheckpoint
	BodyOther


union RenderError:
	WrongArity(FairnessTemplateInfo, Int)
	UnsupportedFairnessOp(String)


private pure func templates_by_name(
	templates: List[FairnessTemplateInfo],
) -> Dict[String, FairnessTemplateInfo]:
	var dict: Dict[String, FairnessTemplateInfo] = {}

	for info in templates:
		dict = dict.set(info.name, info)

	dict


ALL_TEMPLATES: List[FairnessTemplateInfo] = [{
		template = BodyCheckpointTemplate,
		name = "fairness_body_checkpoint",
		arity = 0
	}, {
		template = BodySeqCheckpointTemplate,
		name = "fairness_body_seq_checkpoint",
		arity = 0
	}, {
		template = BodyOtherTemplate,
		name = "fairness_body_other",
		arity = 0
	}]

private TEMPLATES_BY_NAME: Dict[String, FairnessTemplateInfo] = templates_by_name(ALL_TEMPLATES)


pure func fairness_template_name(info: FairnessTemplateInfo) -> String:
	info.name


pure func fairness_template_arity(info: FairnessTemplateInfo) -> Int:
	info.arity


pure func parse_fairness_template(name: String) -> Option[FairnessTemplateInfo]:
	TEMPLATES_BY_NAME.get(name)


private pure func wrong_arity_for_args(
	info: FairnessTemplateInfo,
	args: List[String],
) -> RenderError:
	WrongArity(info, args.length())


pure func render_error_to_string(error: RenderError) -> String:
	match error:
		WrongArity(info, actual):
			render_template_arity_error(
				"fairness op",
				fairness_template_name(info),
				fairness_template_arity(info),
				actual,
			)
		UnsupportedFairnessOp(name):
			render_unsupported_template_error("fairness op", name)


private pure func parse_zero_arg_op(
	info: FairnessTemplateInfo,
	args: List[String],
	op: FairnessOp,
) -> Result[FairnessOp, RenderError]:
	match args:
		[]:
			Ok(op)
		_:
			Err(wrong_arity_for_args(info, args))


pure func render_fairness_op(op: FairnessOp) -> String:
	match op:
		BodyCheckpoint:
			"true"
		BodySeqCheckpoint:
			"true"
		BodyOther:
			"false"


pure func build_fairness_op(
	info: FairnessTemplateInfo,
	args: List[String],
) -> Result[FairnessOp, RenderError]:
	match info.template:
		BodyCheckpointTemplate:
			parse_zero_arg_op(info, args, BodyCheckpoint)
		BodySeqCheckpointTemplate:
			parse_zero_arg_op(info, args, BodySeqCheckpoint)
		BodyOtherTemplate:
			parse_zero_arg_op(info, args, BodyOther)


pure func render_fairness(name: String, args: List[String]) -> Result[String, RenderError]:
	match parse_fairness_template(name):
		Some(info):
			match build_fairness_op(info, args):
				Ok(op):
					Ok(render_fairness_op(op))
				Err(error):
					Err(error)
		None:
			Err(UnsupportedFairnessOp(name))


private pure func placeholder_fairness_op(info: FairnessTemplateInfo) -> FairnessOp:
	match info.template:
		BodyCheckpointTemplate:
			BodyCheckpoint
		BodySeqCheckpointTemplate:
			BodySeqCheckpoint
		BodyOtherTemplate:
			BodyOther


pure func render_manifest_line(info: FairnessTemplateInfo) -> String:
	name: String = fairness_template_name(info)
	arity: Int = fairness_template_arity(info)
	body: String = render_fairness_op(placeholder_fairness_op(info))
	render_template_manifest_line(name, arity, body)


pure func render_manifest_lines() -> List[String]:
	ALL_TEMPLATES.map(render_manifest_line)
