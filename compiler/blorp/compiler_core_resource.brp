		),
		CoreType,
		clone_tensor_for_element_storage,


private pure func prepend_cleanup(cleanup: CoreExpr, cleanups: List[CoreExpr]) -> List[CoreExpr]:
	var result: List[CoreExpr] = [cleanup]

	for existing_cleanup in cleanups:
		result = result.append(existing_cleanup)

	result


private pure func break_or_cleanup_exit(
	cleanups: List[CoreExpr],
	typ: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	if cleanups.length() == 0:
		BreakExpr(typ, loc)
	else:
		ResourceCleanupExitExpr(
			{
				cleanups = cleanups,
				exit = ResourceBreakExit
			},
			typ,
			loc,
		)


private pure func continue_or_cleanup_exit(
	cleanups: List[CoreExpr],
	typ: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	if cleanups.length() == 0:
		ContinueExpr(typ, loc)
	else:
		ResourceCleanupExitExpr(
			{
				cleanups = cleanups,
				exit = ResourceContinueExit
			},
			typ,
			loc,
		)


private pure func rewrite_resource_expr_list_with_cleanups(
	exprs: List[CoreExpr],
	cleanups: List[CoreExpr],
) -> List[CoreExpr]:
	var result: List[CoreExpr] = []

	for expr in exprs:
		result = result.append(rewrite_resource_expr_with_cleanups(expr, cleanups))

	result


private pure func rewrite_tuple_elements_with_cleanups(
	elements: List[CoreTupleElement],
	cleanups: List[CoreExpr],
) -> List[CoreTupleElement]:
	var result: List[CoreTupleElement] = []

	for element in elements:
		match element:
			TuplePrimElement(value):
				result = result.append(
					TuplePrimElement(rewrite_resource_expr_with_cleanups(value, cleanups)),
				)
			TuplePointerElement(value):
				result = result.append(
					TuplePointerElement(rewrite_resource_expr_with_cleanups(value, cleanups)),
				)
			TupleStructElement(value, c_type):
				result = result.append(
					TupleStructElement(
						rewrite_resource_expr_with_cleanups(value, cleanups),
						c_type,
					),
				)
			TupleVoidElement:
				result = result.append(TupleVoidElement)
			TupleFloatElement(value):
				result = result.append(
					TupleFloatElement(rewrite_resource_expr_with_cleanups(value, cleanups)),
				)
			TupleFloat32Element(value):
				result = result.append(
					TupleFloat32Element(rewrite_resource_expr_with_cleanups(value, cleanups)),
				)
			TupleFloat16Element(value):
				result = result.append(
					TupleFloat16Element(rewrite_resource_expr_with_cleanups(value, cleanups)),
				)

	result


private pure func rewrite_tailrec_list_spread_rebind_with_cleanups(
	rebind: CoreTailrecListSpreadRebind,
	cleanups: List[CoreExpr],
) -> CoreTailrecListSpreadRebind:
	{
		param_index = rebind.param_index,
		value = rewrite_resource_expr_with_cleanups(rebind.value, cleanups)
	}


private pure func rewrite_tailrec_list_spread_rebinds_with_cleanups(
	rebinds: List[CoreTailrecListSpreadRebind],
	cleanups: List[CoreExpr],
) -> List[CoreTailrecListSpreadRebind]:
	var result: List[CoreTailrecListSpreadRebind] = []

	for rebind in rebinds:
		result = result.append(rewrite_tailrec_list_spread_rebind_with_cleanups(rebind, cleanups))

	result


private pure func rewrite_tailrec_list_spread_loop_with_cleanups(
	loop: CoreTailrecListSpreadLoop,
) -> CoreTailrecListSpreadLoop:
	{
		params = loop.params,
		return_type = loop.return_type,
		list_index = loop.list_index,
		list_param = loop.list_param,
		cursor = loop.cursor,
		layout = loop.layout,
		body = rewrite_resource_expr_with_cleanups(loop.body, [])
	}


private pure func rewrite_boxed_storage_value_with_cleanups(
	value: CoreBoxedStorageValue,
	cleanups: List[CoreExpr],
) -> CoreBoxedStorageValue:
	{
		kind = value.kind,
		value = rewrite_resource_expr_with_cleanups(value.value, cleanups),
		needs_release = value.needs_release,
		transfers_ownership = value.transfers_ownership
	}


private pure func rewrite_box_op_with_cleanups(
	box: CoreBoxOp,
	cleanups: List[CoreExpr],
) -> CoreBoxOp:
	{
		kind = box.kind,
		value = rewrite_resource_expr_with_cleanups(box.value, cleanups),
		source_type = box.source_type
	}


private pure func rewrite_boxed_storage_values_with_cleanups(
	values: List[CoreBoxedStorageValue],
	cleanups: List[CoreExpr],
) -> List[CoreBoxedStorageValue]:
	var result: List[CoreBoxedStorageValue] = []

	for value in values:
		result = result.append(rewrite_boxed_storage_value_with_cleanups(value, cleanups))

	result


private pure func rewrite_dict_entry_with_cleanups(
	entry: CoreDictEntry,
	cleanups: List[CoreExpr],
) -> CoreDictEntry:
	{
		key = rewrite_boxed_storage_value_with_cleanups(entry.key, cleanups),
		value = rewrite_boxed_storage_value_with_cleanups(entry.value, cleanups)
	}


private pure func rewrite_dict_entries_with_cleanups(
	entries: List[CoreDictEntry],
	cleanups: List[CoreExpr],
) -> List[CoreDictEntry]:
	var result: List[CoreDictEntry] = []

	for entry in entries:
		result = result.append(rewrite_dict_entry_with_cleanups(entry, cleanups))

	result


private pure func rewrite_dict_construct_with_cleanups(
	construct: CoreDictConstruct,
	cleanups: List[CoreExpr],
) -> CoreDictConstruct:
	{
		constructor = construct.constructor,
		entries = rewrite_dict_entries_with_cleanups(construct.entries, cleanups),
		value_needs_release = construct.value_needs_release
	}


private pure func rewrite_set_alloc_with_cleanups(
	alloc: CoreSetAlloc,
	cleanups: List[CoreExpr],
) -> CoreSetAlloc:
	alloc


private pure func rewrite_list_construct_with_cleanups(
	construct: CoreListConstruct,
	cleanups: List[CoreExpr],
) -> CoreListConstruct:
	{
		layout = construct.layout,
		elements = rewrite_boxed_storage_values_with_cleanups(construct.elements, cleanups),
		elem_needs_release = construct.elem_needs_release
	}


private pure func rewrite_list_alloc_with_cleanups(
	alloc: CoreListAlloc,
	cleanups: List[CoreExpr],
) -> CoreListAlloc:
	{
		layout = alloc.layout,
		capacity = rewrite_resource_expr_with_cleanups(alloc.capacity, cleanups),
		elem_needs_release = alloc.elem_needs_release
	}


private pure func rewrite_list_get_with_cleanups(
	get: CoreListGet,
	cleanups: List[CoreExpr],
) -> CoreListGet:
	{
		layout = get.layout,
		list = rewrite_resource_expr_with_cleanups(get.list, cleanups),
		index = rewrite_resource_expr_with_cleanups(get.index, cleanups),
		bounds = get.bounds
	}


private pure func rewrite_list_handoff_with_cleanups(
	handoff: CoreListHandoff,
	cleanups: List[CoreExpr],
) -> CoreListHandoff:
	{
		mode = handoff.mode,
		layout = handoff.layout,
		elem_needs_release = handoff.elem_needs_release,
		source = rewrite_resource_expr_with_cleanups(handoff.source, cleanups),
		source_var = handoff.source_var,
		source_type = handoff.source_type,
		result_type = handoff.result_type,
		capacity = rewrite_resource_expr_with_cleanups(handoff.capacity, cleanups),
		result_var = handoff.result_var,
		len_var = handoff.len_var,
		out_var = handoff.out_var,
		body = rewrite_resource_expr_with_cleanups(handoff.body, cleanups),
		write_order = handoff.write_order
	}


private pure func rewrite_list_handoff_set_source_slot_with_cleanups(
	slot: CoreListHandoffSetSourceSlot,
	cleanups: List[CoreExpr],
) -> CoreListHandoffSetSourceSlot:
	{
		result = rewrite_resource_expr_with_cleanups(slot.result, cleanups),
		out_index = rewrite_resource_expr_with_cleanups(slot.out_index, cleanups),
		source = rewrite_resource_expr_with_cleanups(slot.source, cleanups),
		source_index = rewrite_resource_expr_with_cleanups(slot.source_index, cleanups)
	}


