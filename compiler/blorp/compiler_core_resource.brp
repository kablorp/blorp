	write: CoreTensorRawWrite,
	cleanups: List[CoreExpr],
) -> CoreTensorRawWrite:
	{
		view = write.view,
		kind = write.kind,
		index = rewrite_resource_expr_with_cleanups(write.index, cleanups),
