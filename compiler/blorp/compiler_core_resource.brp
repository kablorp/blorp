-- Resource-scope cleanup edge rewriting for the Blorp-owned Core tail.
--
-- A break or continue that exits an active resource scope must run the
-- scope's cleanup before transferring control. Nested loop bodies reset the
-- active cleanup stack because their break/continue targets are local to that
-- loop.
import:
	compiler_core_json:
		CoreBoxOp,
		CoreBoxedStorageValue,
		CoreConcurrentBinding,
		CoreConcurrentBlock,
		CoreConcurrentlyLoop,
		CoreConstructorLengthMatch,
		CoreConstructorLengthMatchBranch,
		CoreConstructorLengthMatchCase,
		CoreConstructorLengthMatchGeq,
		CoreConstructorLiteralMatch,
		CoreConstructorMatchBody(
			ConstructorMatchBodyExpr,
			ConstructorMatchBodyLength,
			ConstructorMatchBodyLiteral,
		),
		CoreConstructorMatchCase,
		CoreConstructorMatchFallback(
			ConstructorMatchFallbackBindings,
			ConstructorMatchFallbackBody,
			ConstructorMatchFallbackFail,
		),
		CoreDecl(EnumDecl, FunctionDecl, GlobalDecl, HeapRecordDecl, UnionDecl, ValueRecordDecl),
		CoreDictConstruct,
		CoreDictEntry,
		CoreExpr(
			AccessorLiteralMatchExpr,
			AssignExpr,
			BinaryExpr,
			BoxExpr,
			BreakExpr,
			BorrowLetExpr,
			CastExpr,
			CallExpr,
			ClosureCreateExpr,
			ConcurrentlyLoopExpr,
			ConcurrentExpr,
			ConstructorMatchExpr,
			ContinueExpr,
			CooperativeCheckpointExpr,
			DetachExpr,
			DictConstructExpr,
			DupExpr,
			DropExpr,
			FieldExpr,
			ForChannelExpr,
			ForDictExpr,
			ForListExpr,
			ForRangeExpr,
			ForResourceSourceExpr,
			ForSetExpr,
			ForStreamExpr,
			ForStringExpr,
			ForTensorExpr,
			IfExpr,
			LetExpr,
			ListAllocExpr,
			ListConstructExpr,
			ListGetExpr,
			ListHandoffExpr,
			ListHandoffSetOwnedExpr,
			ListHandoffSetSourceSlotExpr,
			ListRetainExpr,
			ListSetExpr,
			ListSwapExpr,
			LengthMatchExpr,
			LiteralExpr,
			LiteralMatchExpr,
			LogicalExpr,
			RangeExpr,
			RecordExpr,
			RecordConstructExpr,
			ResourceCleanupExitExpr,
			ResourceScopeExpr,
			SelectExpr,
			SeqExpr,
			SetAllocExpr,
			StringByteCopyExpr,
			StringByteReadExpr,
			StringByteWriteExpr,
			StringSetLenExpr,
			TailrecListSpreadLoopExpr,
			TailrecListSpreadRecurExpr,
			TailrecLoopExpr,
			TailrecRecurExpr,
			TensorBoxedLiteralExpr,
			TensorLiteralExpr,
			TensorPackedLiteralExpr,
			TensorRawFillExpr,
			TensorRawReadExpr,
			TensorRawViewLetExpr,
			TensorRawWriteExpr,
			TupleExpr,
			TupleConstructExpr,
			TupleFieldExpr,
			UnaryExpr,
			UnionConstructExpr,
			UnionReuseConstructExpr,
			VarExpr,
			VoidExpr,
			WhileExpr,
		),
		CoreFunction,
		CoreGlobal,
		CoreListAlloc,
		CoreListConstruct,
		CoreListGet,
		CoreListHandoff,
		CoreListHandoffSetSourceSlot,
		CoreListRetain,
		CoreListSet,
		CoreListSwap,
		CoreLiteralMatchCase,
		CoreLiteralMatchFallback(
			LiteralMatchFallbackBindings,
			LiteralMatchFallbackBody,
			LiteralMatchFallbackFail,
		),
		CoreProgram,
		CoreRecordFieldValue,
		CoreResourceExit(ResourceBreakExit, ResourceContinueExit),
		CoreSelect,
		CoreSelectArm,
		CoreSelectArmKind(SelectAfterArm, SelectRecvArm, SelectSealedArm),
		CoreSelectRecvArm,
		CoreSetAlloc,
		CoreSourceLoc,
		CoreStringByteCopy,
		CoreStringByteRead,
		CoreStringByteWrite,
		CoreStringSetLen,
		CoreTailrecListSpreadLoop,
		CoreTailrecListSpreadRebind,
		CoreTensorBoxedLiteral,
		CoreTensorLiteral,
		CoreTensorLiteralPayload(TensorInlineStructLiteralPayload, TensorRawLiteralPayload),
		CoreTensorPackedLiteral,
