private pure func rewrite_tensor_literal_with_cleanups(
	literal: CoreTensorLiteral,
	cleanups: List[CoreExpr],
) -> CoreTensorLiteral:
	{
		shape = literal.shape,
		payload = rewrite_tensor_literal_payload_with_cleanups(literal.payload, cleanups)
	}


private pure func rewrite_tensor_literal_payload_with_cleanups(
	payload: CoreTensorLiteralPayload,
	cleanups: List[CoreExpr],
) -> CoreTensorLiteralPayload:
	match payload:
		TensorRawLiteralPayload(raw):
			TensorRawLiteralPayload({
				raw_kind = raw.raw_kind,
				elements = rewrite_resource_expr_list_with_cleanups(raw.elements, cleanups),
			})
		TensorInlineStructLiteralPayload(inline_struct):
			TensorInlineStructLiteralPayload({
				struct_c_type = inline_struct.struct_c_type,
				elements = rewrite_resource_expr_list_with_cleanups(
					inline_struct.elements,
					cleanups,
				),
			})


private pure func rewrite_tensor_boxed_literal_with_cleanups(
	literal: CoreTensorBoxedLiteral,
	cleanups: List[CoreExpr],
) -> CoreTensorBoxedLiteral:
	{
		shape = literal.shape,
		elements = rewrite_boxed_storage_values_with_cleanups(literal.elements, cleanups),
		elem_needs_release = literal.elem_needs_release
	}


private pure func rewrite_tensor_packed_literal_with_cleanups(
	literal: CoreTensorPackedLiteral,
	cleanups: List[CoreExpr],
) -> CoreTensorPackedLiteral:
	{
		shape = literal.shape,
		elem_size = literal.elem_size,
		elements = rewrite_resource_expr_list_with_cleanups(literal.elements, cleanups)
	}


private pure func rewrite_tensor_raw_fill_with_cleanups(
	fill: CoreTensorRawFill,
	cleanups: List[CoreExpr],
) -> CoreTensorRawFill:
	{
		raw_kind = fill.raw_kind,
		value = rewrite_resource_expr_with_cleanups(fill.value, cleanups),
		dims = rewrite_resource_expr_list_with_cleanups(fill.dims, cleanups)
	}


private pure func rewrite_string_set_len_with_cleanups(
	set_len: CoreStringSetLen,
	cleanups: List[CoreExpr],
) -> CoreStringSetLen:
	{
		target = rewrite_resource_expr_with_cleanups(set_len.target, cleanups),
		len = rewrite_resource_expr_with_cleanups(set_len.len, cleanups)
	}


private pure func rewrite_list_set_with_cleanups(
	set: CoreListSet,
	cleanups: List[CoreExpr],
) -> CoreListSet:
	{
		layout = set.layout,
		list = rewrite_resource_expr_with_cleanups(set.list, cleanups),
		index = rewrite_resource_expr_with_cleanups(set.index, cleanups),
		value = rewrite_boxed_storage_value_with_cleanups(set.value, cleanups),
		value_is_stack_result = set.value_is_stack_result
	}


private pure func rewrite_list_swap_with_cleanups(
	swap: CoreListSwap,
	cleanups: List[CoreExpr],
) -> CoreListSwap:
	{
		layout = swap.layout,
		list = rewrite_resource_expr_with_cleanups(swap.list, cleanups),
		left_index = rewrite_resource_expr_with_cleanups(swap.left_index, cleanups),
		right_index = rewrite_resource_expr_with_cleanups(swap.right_index, cleanups)
	}


private pure func rewrite_list_retain_with_cleanups(
	retain: CoreListRetain,
	cleanups: List[CoreExpr],
) -> CoreListRetain:
	{
		list = rewrite_resource_expr_with_cleanups(retain.list, cleanups),
		value = rewrite_boxed_storage_value_with_cleanups(retain.value, cleanups)
	}


private pure func rewrite_record_fields_with_cleanups(
	fields: List[CoreRecordFieldValue],
	cleanups: List[CoreExpr],
) -> List[CoreRecordFieldValue]:
	var result: List[CoreRecordFieldValue] = []

	for field in fields:
		result = result.append({
			name = field.name,
			value = rewrite_resource_expr_with_cleanups(field.value, cleanups),
		})

	result


private pure func rewrite_concurrent_binding_with_cleanups(
	binding: CoreConcurrentBinding,
	cleanups: List[CoreExpr],
) -> CoreConcurrentBinding:
	{
		variable = binding.variable,
		typ = binding.typ,
		rhs = rewrite_resource_expr_with_cleanups(binding.rhs, []),
		task = binding.task
	}


private pure func rewrite_concurrent_bindings_with_cleanups(
	bindings: List[CoreConcurrentBinding],
	cleanups: List[CoreExpr],
) -> List[CoreConcurrentBinding]:
	var result: List[CoreConcurrentBinding] = []

	for binding in bindings:
		result = result.append(rewrite_concurrent_binding_with_cleanups(binding, cleanups))

	result


private pure func rewrite_optional_expr_with_cleanups(
	expr: Option[CoreExpr],
	cleanups: List[CoreExpr],
) -> Option[CoreExpr]:
	match expr:
		Some(value):
			Some(rewrite_resource_expr_with_cleanups(value, cleanups))
		None:
			None


private pure func rewrite_concurrently_loop_with_cleanups(
	loop: CoreConcurrentlyLoop,
	cleanups: List[CoreExpr],
) -> CoreConcurrentlyLoop:
	{
		variable = loop.variable,
		item_type = loop.item_type,
		item_mode = loop.item_mode,
		iterable = rewrite_resource_expr_with_cleanups(loop.iterable, cleanups),
		body = rewrite_resource_expr_with_cleanups(loop.body, []),
		timeout = rewrite_optional_expr_with_cleanups(loop.timeout, cleanups),
		limit = rewrite_resource_expr_with_cleanups(loop.limit, cleanups),
		output = loop.output,
		task = loop.task
	}


private pure func rewrite_concurrent_with_cleanups(
	block: CoreConcurrentBlock,
	cleanups: List[CoreExpr],
) -> CoreConcurrentBlock:
	{
		bindings = rewrite_concurrent_bindings_with_cleanups(block.bindings, cleanups),
		body = rewrite_resource_expr_with_cleanups(block.body, cleanups),
		timeout = rewrite_optional_expr_with_cleanups(block.timeout, cleanups),
		max_threads = block.max_threads
	}


private pure func rewrite_select_recv_arm_with_cleanups(
	recv: CoreSelectRecvArm,
	cleanups: List[CoreExpr],
) -> CoreSelectRecvArm:
	{
		binder = recv.binder,
		elem_type = recv.elem_type,
		channel = rewrite_resource_expr_with_cleanups(recv.channel, cleanups)
	}


private pure func rewrite_select_arm_kind_with_cleanups(
	kind: CoreSelectArmKind,
	cleanups: List[CoreExpr],
) -> CoreSelectArmKind:
	match kind:
		SelectRecvArm(recv):
			SelectRecvArm(rewrite_select_recv_arm_with_cleanups(recv, cleanups))
		SelectSealedArm(channel):
			SelectSealedArm(rewrite_resource_expr_with_cleanups(channel, cleanups))
		SelectAfterArm(timeout):
			SelectAfterArm(rewrite_resource_expr_with_cleanups(timeout, cleanups))


private pure func rewrite_select_arm_with_cleanups(
	arm: CoreSelectArm,
	cleanups: List[CoreExpr],
) -> CoreSelectArm:
	{
		kind = rewrite_select_arm_kind_with_cleanups(arm.kind, cleanups),
		body = rewrite_resource_expr_with_cleanups(arm.body, []),
		loc = arm.loc
	}


private pure func rewrite_select_arms_with_cleanups(
	arms: List[CoreSelectArm],
	cleanups: List[CoreExpr],
) -> List[CoreSelectArm]:
	var result: List[CoreSelectArm] = []

	for arm in arms:
		result = result.append(rewrite_select_arm_with_cleanups(arm, cleanups))

	result


private pure func rewrite_select_with_cleanups(
	select_expr: CoreSelect,
	cleanups: List[CoreExpr],
) -> CoreSelect:
	{arms = rewrite_select_arms_with_cleanups(select_expr.arms, cleanups)}


private pure func rewrite_literal_match_cases_with_cleanups(
	cases: List[CoreLiteralMatchCase],
	cleanups: List[CoreExpr],
) -> List[CoreLiteralMatchCase]:
	var result: List[CoreLiteralMatchCase] = []

	for match_case in cases:
		result = result.append({
			literal = match_case.literal,
			bindings = match_case.bindings,
			body = rewrite_resource_expr_with_cleanups(match_case.body, cleanups),
		})

	result


private pure func rewrite_literal_match_fallback_with_cleanups(
	fallback: CoreLiteralMatchFallback,
	cleanups: List[CoreExpr],
) -> CoreLiteralMatchFallback:
	match fallback:
		LiteralMatchFallbackBody(body):
			LiteralMatchFallbackBody(rewrite_resource_expr_with_cleanups(body, cleanups))
		LiteralMatchFallbackBindings(bindings, body):
			LiteralMatchFallbackBindings(
				bindings,
				rewrite_resource_expr_with_cleanups(body, cleanups),
			)
		LiteralMatchFallbackFail:
			LiteralMatchFallbackFail


private pure func rewrite_constructor_literal_match_with_cleanups(
	match_expr: CoreConstructorLiteralMatch,
	cleanups: List[CoreExpr],
) -> CoreConstructorLiteralMatch:
	{
		accessor = match_expr.accessor,
		scrutinee_type = match_expr.scrutinee_type,
		cases = rewrite_literal_match_cases_with_cleanups(match_expr.cases, cleanups),
		fallback = rewrite_literal_match_fallback_with_cleanups(match_expr.fallback, cleanups),
		result_type = match_expr.result_type,
		loc = match_expr.loc
	}


private pure func rewrite_constructor_length_match_branch_with_cleanups(
	branch: CoreConstructorLengthMatchBranch,
	cleanups: List[CoreExpr],
) -> CoreConstructorLengthMatchBranch:
	{
		bindings = branch.bindings,
		body = rewrite_constructor_match_body_with_cleanups(branch.body, cleanups)
	}


private pure func rewrite_constructor_length_match_cases_with_cleanups(
	cases: List[CoreConstructorLengthMatchCase],
	cleanups: List[CoreExpr],
) -> List[CoreConstructorLengthMatchCase]:
	var result: List[CoreConstructorLengthMatchCase] = []

	for match_case in cases:
		result = result.append({
			length = match_case.length,
			branch = rewrite_constructor_length_match_branch_with_cleanups(
				match_case.branch,
				cleanups,
			),
		})

	result


private pure func rewrite_constructor_length_match_geq_with_cleanups(
	geq_case: Option[CoreConstructorLengthMatchGeq],
	cleanups: List[CoreExpr],
) -> Option[CoreConstructorLengthMatchGeq]:
	match geq_case:
		Some(existing_case):
			Some({
				minimum_length = existing_case.minimum_length,
				branch = rewrite_constructor_length_match_branch_with_cleanups(
					existing_case.branch,
					cleanups,
				),
			})
		None:
			None


private pure func rewrite_constructor_length_match_fallback_with_cleanups(
	fallback: Option[CoreConstructorLengthMatchBranch],
	cleanups: List[CoreExpr],
) -> Option[CoreConstructorLengthMatchBranch]:
	match fallback:
		Some(branch):
			Some(rewrite_constructor_length_match_branch_with_cleanups(branch, cleanups))
		None:
			None


private pure func rewrite_constructor_length_match_with_cleanups(
	match_expr: CoreConstructorLengthMatch,
	cleanups: List[CoreExpr],
) -> CoreConstructorLengthMatch:
	{
		accessor = match_expr.accessor,
		cases = rewrite_constructor_length_match_cases_with_cleanups(match_expr.cases, cleanups),
		geq = rewrite_constructor_length_match_geq_with_cleanups(match_expr.geq, cleanups),
		fallback = rewrite_constructor_length_match_fallback_with_cleanups(
			match_expr.fallback,
			cleanups,
		),
		result_type = match_expr.result_type,
		loc = match_expr.loc
	}


private pure func rewrite_constructor_match_body_with_cleanups(
	body: CoreConstructorMatchBody,
	cleanups: List[CoreExpr],
) -> CoreConstructorMatchBody:
	match body:
		ConstructorMatchBodyExpr(expr):
			ConstructorMatchBodyExpr(rewrite_resource_expr_with_cleanups(expr, cleanups))
		ConstructorMatchBodyLiteral(match_expr):
			ConstructorMatchBodyLiteral(
				rewrite_constructor_literal_match_with_cleanups(
					match_expr,
					cleanups,
				),
			)
		ConstructorMatchBodyLength(match_expr):
			ConstructorMatchBodyLength(
				rewrite_constructor_length_match_with_cleanups(
					match_expr,
					cleanups,
				),
			)


private pure func rewrite_constructor_match_cases_with_cleanups(
	cases: List[CoreConstructorMatchCase],
	cleanups: List[CoreExpr],
) -> List[CoreConstructorMatchCase]:
	var result: List[CoreConstructorMatchCase] = []

	for match_case in cases:
		result = result.append({
			constructor = match_case.constructor,
			accessor = match_case.accessor,
			test = match_case.test,
			bindings = match_case.bindings,
			body = rewrite_constructor_match_body_with_cleanups(match_case.body, cleanups),
		})

	result


private pure func rewrite_constructor_match_fallback_with_cleanups(
	fallback: CoreConstructorMatchFallback,
	cleanups: List[CoreExpr],
) -> CoreConstructorMatchFallback:
	match fallback:
		ConstructorMatchFallbackBody(body):
			ConstructorMatchFallbackBody(rewrite_resource_expr_with_cleanups(body, cleanups))
		ConstructorMatchFallbackBindings(bindings, body):
			ConstructorMatchFallbackBindings(
				bindings,
				rewrite_resource_expr_with_cleanups(body, cleanups),
			)
		ConstructorMatchFallbackFail:
			ConstructorMatchFallbackFail


private pure func rewrite_resource_expr_with_cleanups(
	expr: CoreExpr,
	cleanups: List[CoreExpr],
) -> CoreExpr:
	match expr:
		BreakExpr(typ, loc):
			break_or_cleanup_exit(cleanups, typ, loc)
		ContinueExpr(typ, loc):
			continue_or_cleanup_exit(cleanups, typ, loc)
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			expr
		ResourceScopeExpr(scope, typ, loc):
			active_cleanups: List[CoreExpr] = prepend_cleanup(scope.cleanup, cleanups)
			ResourceScopeExpr(
				{
					variable = scope.variable,
					typ = scope.typ,
					acquire = rewrite_resource_expr_with_cleanups(scope.acquire, cleanups),
					body = rewrite_resource_expr_with_cleanups(scope.body, active_cleanups),
					cleanup = rewrite_resource_expr_with_cleanups(scope.cleanup, cleanups)
				},
				typ,
				loc,
			)
		WhileExpr(cond, body, typ, loc):
			WhileExpr(
				rewrite_resource_expr_with_cleanups(cond, cleanups),
				rewrite_resource_expr_with_cleanups(body, []),
				typ,
				loc,
			)
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			ForRangeExpr(
				binder,
				rewrite_resource_expr_with_cleanups(start, cleanups),
				rewrite_resource_expr_with_cleanups(end_value, cleanups),
				rewrite_resource_expr_with_cleanups(body, []),
				typ,
				loc,
			)
		ForChannelExpr(for_channel, typ, loc):
			ForChannelExpr(
				{
					binder = for_channel.binder,
					iterable = rewrite_resource_expr_with_cleanups(for_channel.iterable, cleanups),
					body = rewrite_resource_expr_with_cleanups(for_channel.body, [])
				},
				typ,
				loc,
			)
		ForListExpr(for_list, typ, loc):
			ForListExpr(
				{
					binder = for_list.binder,
					layout = for_list.layout,
					iterable = rewrite_resource_expr_with_cleanups(for_list.iterable, cleanups),
					iterable_release_policy = for_list.iterable_release_policy,
					body = rewrite_resource_expr_with_cleanups(for_list.body, [])
				},
				typ,
				loc,
			)
		ForStringExpr(for_string, typ, loc):
			ForStringExpr(
				{
					binder = for_string.binder,
					iterable = rewrite_resource_expr_with_cleanups(for_string.iterable, cleanups),
					iterable_release_policy = for_string.iterable_release_policy,
					body = rewrite_resource_expr_with_cleanups(for_string.body, [])
				},
				typ,
				loc,
			)
		ForDictExpr(for_dict, typ, loc):
			ForDictExpr(
				{
					binder = for_dict.binder,
					iterable = rewrite_resource_expr_with_cleanups(for_dict.iterable, cleanups),
					iterable_release_policy = for_dict.iterable_release_policy,
					body = rewrite_resource_expr_with_cleanups(for_dict.body, [])
				},
				typ,
				loc,
			)
		ForSetExpr(for_set, typ, loc):
			ForSetExpr(
				{
					binder = for_set.binder,
					iterable = rewrite_resource_expr_with_cleanups(for_set.iterable, cleanups),
					iterable_release_policy = for_set.iterable_release_policy,
					body = rewrite_resource_expr_with_cleanups(for_set.body, [])
				},
				typ,
				loc,
			)
		ForResourceSourceExpr(for_resource_source, typ, loc):
			ForResourceSourceExpr(
				{
					binder = for_resource_source.binder,
					iterable = rewrite_resource_expr_with_cleanups(
						for_resource_source.iterable,
						cleanups,
					),
					iterable_release_policy = for_resource_source.iterable_release_policy,
					body = rewrite_resource_expr_with_cleanups(for_resource_source.body, [])
				},
				typ,
				loc,
			)
		ForStreamExpr(for_stream, typ, loc):
			ForStreamExpr(
				{
					binder = for_stream.binder,
					iterable = rewrite_resource_expr_with_cleanups(for_stream.iterable, cleanups),
					iterable_release_policy = for_stream.iterable_release_policy,
					body = rewrite_resource_expr_with_cleanups(for_stream.body, [])
				},
				typ,
				loc,
			)
		ForTensorExpr(for_tensor, typ, loc):
			ForTensorExpr(
				{
					binder = for_tensor.binder,
					element_storage = clone_tensor_for_element_storage(for_tensor.element_storage),
					iterable = rewrite_resource_expr_with_cleanups(for_tensor.iterable, cleanups),
					iterable_release_policy = for_tensor.iterable_release_policy,
					body = rewrite_resource_expr_with_cleanups(for_tensor.body, [])
				},
				typ,
				loc,
			)
		DetachExpr(detached, typ, loc):
			expr
		ConcurrentlyLoopExpr(loop, typ, loc):
			ConcurrentlyLoopExpr(
				rewrite_concurrently_loop_with_cleanups(loop, cleanups),
				typ,
				loc,
			)
		ConcurrentExpr(block, typ, loc):
			ConcurrentExpr(
				rewrite_concurrent_with_cleanups(block, cleanups),
				typ,
				loc,
			)
		SelectExpr(select_expr, typ, loc):
			SelectExpr(
				rewrite_select_with_cleanups(select_expr, cleanups),
				typ,
				loc,
			)
		TailrecLoopExpr(params, return_type, body, loc):
			TailrecLoopExpr(
				params,
				return_type,
				rewrite_resource_expr_with_cleanups(body, []),
				loc,
			)
		TailrecListSpreadLoopExpr(loop, loc):
			TailrecListSpreadLoopExpr(rewrite_tailrec_list_spread_loop_with_cleanups(loop), loc)
		CallExpr(kind, callee, args, typ, loc):
			CallExpr(
				kind,
				rewrite_resource_expr_with_cleanups(callee, cleanups),
				rewrite_resource_expr_list_with_cleanups(args, cleanups),
				typ,
				loc,
			)
		BinaryExpr(op, left, right, typ, loc):
			BinaryExpr(
				op,
				rewrite_resource_expr_with_cleanups(left, cleanups),
				rewrite_resource_expr_with_cleanups(right, cleanups),
				typ,
				loc,
			)
		UnaryExpr(op, expr_value, typ, loc):
			UnaryExpr(
				op,
				rewrite_resource_expr_with_cleanups(expr_value, cleanups),
				typ,
				loc,
			)
		LogicalExpr(op, left, right, typ, loc):
			LogicalExpr(
				op,
				rewrite_resource_expr_with_cleanups(left, cleanups),
				rewrite_resource_expr_with_cleanups(right, cleanups),
				typ,
				loc,
			)
		AssignExpr(variable, rhs, typ, loc):
			AssignExpr(
				variable,
				rewrite_resource_expr_with_cleanups(rhs, cleanups),
				typ,
				loc,
			)
		CastExpr(expr_value, typ, loc):
			CastExpr(
				rewrite_resource_expr_with_cleanups(expr_value, cleanups),
				typ,
				loc,
			)
		BoxExpr(box, typ, loc):
			BoxExpr(
				rewrite_box_op_with_cleanups(box, cleanups),
				typ,
				loc,
			)
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			UnboxExpr(
				unbox_kind,
				rewrite_resource_expr_with_cleanups(expr_value, cleanups),
				typ,
				loc,
			)
		FieldExpr(expr_value, field_name, typ, loc):
			FieldExpr(
				rewrite_resource_expr_with_cleanups(expr_value, cleanups),
				field_name,
				typ,
				loc,
			)
		TupleFieldExpr(expr_value, field_index, typ, loc):
			TupleFieldExpr(
				rewrite_resource_expr_with_cleanups(expr_value, cleanups),
				field_index,
				typ,
				loc,
			)
		TupleExpr(items, typ, loc):
			TupleExpr(
				rewrite_resource_expr_list_with_cleanups(items, cleanups),
				typ,
				loc,
			)
		TupleConstructExpr(tuple_construct, typ, loc):
			TupleConstructExpr(
				{
					elements = rewrite_tuple_elements_with_cleanups(
						tuple_construct.elements,
						cleanups,
					),
					release_mask = tuple_construct.release_mask,
					retain_mask = tuple_construct.retain_mask
				},
				typ,
				loc,
			)
		ClosureCreateExpr(closure, typ, loc):
			ClosureCreateExpr(closure, typ, loc)
		ListConstructExpr(construct, typ, loc):
			ListConstructExpr(
				rewrite_list_construct_with_cleanups(construct, cleanups),
				typ,
				loc,
			)
		ListAllocExpr(alloc, typ, loc):
			ListAllocExpr(
				rewrite_list_alloc_with_cleanups(alloc, cleanups),
				typ,
				loc,
			)
		ListGetExpr(get, typ, loc):
			ListGetExpr(
				rewrite_list_get_with_cleanups(get, cleanups),
				typ,
				loc,
			)
		ListHandoffExpr(handoff, typ, loc):
			ListHandoffExpr(
				rewrite_list_handoff_with_cleanups(handoff, cleanups),
				typ,
				loc,
			)
		ListHandoffSetOwnedExpr(set, typ, loc):
			ListHandoffSetOwnedExpr(
				rewrite_list_set_with_cleanups(set, cleanups),
				typ,
				loc,
			)
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			ListHandoffSetSourceSlotExpr(
				rewrite_list_handoff_set_source_slot_with_cleanups(slot, cleanups),
				typ,
				loc,
			)
		StringByteReadExpr(read, typ, loc):
			StringByteReadExpr(
				rewrite_string_byte_read_with_cleanups(read, cleanups),
				typ,
				loc,
			)
		StringByteWriteExpr(write, typ, loc):
			StringByteWriteExpr(
				rewrite_string_byte_write_with_cleanups(write, cleanups),
				typ,
				loc,
			)
		StringByteCopyExpr(copy, typ, loc):
			StringByteCopyExpr(
				rewrite_string_byte_copy_with_cleanups(copy, cleanups),
				typ,
				loc,
			)
		StringSetLenExpr(set_len, typ, loc):
			StringSetLenExpr(
				rewrite_string_set_len_with_cleanups(set_len, cleanups),
				typ,
				loc,
			)
		TensorLiteralExpr(literal, typ, loc):
			TensorLiteralExpr(
				rewrite_tensor_literal_with_cleanups(literal, cleanups),
				typ,
				loc,
			)
		TensorBoxedLiteralExpr(literal, typ, loc):
			TensorBoxedLiteralExpr(
				rewrite_tensor_boxed_literal_with_cleanups(literal, cleanups),
				typ,
				loc,
			)
		TensorPackedLiteralExpr(literal, typ, loc):
			TensorPackedLiteralExpr(
				rewrite_tensor_packed_literal_with_cleanups(literal, cleanups),
				typ,
				loc,
			)
		TensorRawFillExpr(fill, typ, loc):
			TensorRawFillExpr(
				rewrite_tensor_raw_fill_with_cleanups(fill, cleanups),
				typ,
				loc,
			)
		TensorRawReadExpr(read, typ, loc):
			TensorRawReadExpr(
				rewrite_tensor_raw_read_with_cleanups(read, cleanups),
				typ,
				loc,
			)
		TensorRawWriteExpr(write, typ, loc):
			TensorRawWriteExpr(
				rewrite_tensor_raw_write_with_cleanups(write, cleanups),
				typ,
				loc,
			)
		TensorRawViewLetExpr(binding, body, typ, loc):
			TensorRawViewLetExpr(
				rewrite_tensor_raw_view_binding_with_cleanups(binding, cleanups),
				rewrite_resource_expr_with_cleanups(body, cleanups),
				typ,
				loc,
			)
		DictConstructExpr(construct, typ, loc):
			DictConstructExpr(
				rewrite_dict_construct_with_cleanups(construct, cleanups),
				typ,
				loc,
			)
		SetAllocExpr(alloc, typ, loc):
			SetAllocExpr(
				rewrite_set_alloc_with_cleanups(alloc, cleanups),
				typ,
				loc,
			)
		ListRetainExpr(retain, typ, loc):
			ListRetainExpr(
				rewrite_list_retain_with_cleanups(retain, cleanups),
				typ,
				loc,
			)
		ListSetExpr(set, typ, loc):
			ListSetExpr(
				rewrite_list_set_with_cleanups(set, cleanups),
				typ,
				loc,
			)
		ListSwapExpr(swap, typ, loc):
			ListSwapExpr(
				rewrite_list_swap_with_cleanups(swap, cleanups),
				typ,
				loc,
			)
		RecordExpr(fields, typ, loc):
			RecordExpr(
				rewrite_record_fields_with_cleanups(fields, cleanups),
				typ,
				loc,
			)
		RecordConstructExpr(type_name, fields, typ, loc):
			RecordConstructExpr(
				type_name,
				rewrite_record_fields_with_cleanups(fields, cleanups),
				typ,
				loc,
			)
		UnionConstructExpr(construct, typ, loc):
			UnionConstructExpr(
				{
					type_name = construct.type_name,
					constructor_name = construct.constructor_name,
					constructor_c_name = construct.constructor_c_name,
					representation = construct.representation,
					payload_storage = construct.payload_storage,
					uses_release_mask = construct.uses_release_mask,
					release_mask = construct.release_mask,
					args = rewrite_boxed_storage_values_with_cleanups(construct.args, cleanups)
				},
				typ,
				loc,
			)
		UnionReuseConstructExpr(construct, typ, loc):
			UnionReuseConstructExpr(
				{
					source = rewrite_resource_expr_with_cleanups(construct.source, cleanups),
					type_name = construct.type_name,
					constructor_name = construct.constructor_name,
					constructor_c_name = construct.constructor_c_name,
					reuse_constructor_c_name = construct.reuse_constructor_c_name,
					representation = construct.representation,
					payload_storage = construct.payload_storage,
					uses_release_mask = construct.uses_release_mask,
					release_mask = construct.release_mask,
					args = rewrite_boxed_storage_values_with_cleanups(construct.args, cleanups)
				},
				typ,
				loc,
			)
		DetachExpr(detached, typ, loc):
			expr
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			DupExpr(
				variable,
				value_type,
				retain_policy,
				rewrite_resource_expr_with_cleanups(body, cleanups),
				typ,
				loc,
			)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			DropExpr(
				variable,
				value_type,
				release_policy,
				rewrite_resource_expr_with_cleanups(body, cleanups),
				typ,
				loc,
			)
		LetExpr(name, is_mutable, typ, rhs, body):
			LetExpr(
				name,
				is_mutable,
				typ,
				rewrite_resource_expr_with_cleanups(rhs, cleanups),
				rewrite_resource_expr_with_cleanups(body, cleanups),
			)
		BorrowLetExpr(name, typ, rhs, body):
			BorrowLetExpr(
				name,
				typ,
				rewrite_resource_expr_with_cleanups(rhs, cleanups),
				rewrite_resource_expr_with_cleanups(body, cleanups),
			)
		SeqExpr(first, second):
			SeqExpr(
				rewrite_resource_expr_with_cleanups(first, cleanups),
				rewrite_resource_expr_with_cleanups(second, cleanups),
			)
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			AccessorLiteralMatchExpr(
				rewrite_resource_expr_with_cleanups(scrutinee, cleanups),
				scrutinee_release_policy,
				rewrite_constructor_literal_match_with_cleanups(match_expr, cleanups),
				typ,
				loc,
			)
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			LengthMatchExpr(
				rewrite_resource_expr_with_cleanups(scrutinee, cleanups),
				scrutinee_release_policy,
				rewrite_constructor_length_match_with_cleanups(match_expr, cleanups),
				typ,
				loc,
			)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			LiteralMatchExpr(
				rewrite_resource_expr_with_cleanups(scrutinee, cleanups),
				rewrite_literal_match_cases_with_cleanups(cases, cleanups),
				rewrite_literal_match_fallback_with_cleanups(fallback, cleanups),
				typ,
				loc,
			)
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, fallback, typ, loc):
			ConstructorMatchExpr(
				rewrite_resource_expr_with_cleanups(scrutinee, cleanups),
				scrutinee_release_policy,
				rewrite_constructor_match_cases_with_cleanups(cases, cleanups),
				rewrite_constructor_match_fallback_with_cleanups(fallback, cleanups),
				typ,
				loc,
			)
		RangeExpr(start, end_value, typ, loc):
			RangeExpr(
				rewrite_resource_expr_with_cleanups(start, cleanups),
				rewrite_resource_expr_with_cleanups(end_value, cleanups),
				typ,
				loc,
			)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			IfExpr(
				rewrite_resource_expr_with_cleanups(cond, cleanups),
				rewrite_resource_expr_with_cleanups(then_expr, cleanups),
				rewrite_resource_expr_with_cleanups(else_expr, cleanups),
				typ,
				loc,
			)
		LiteralExpr(literal, typ, loc):
			expr
		VarExpr(variable, typ, loc):
			expr
		VoidExpr(typ, loc):
			expr
		CooperativeCheckpointExpr(typ, loc):
			expr
		TailrecRecurExpr(args, typ, loc):
			TailrecRecurExpr(
				rewrite_resource_expr_list_with_cleanups(args, cleanups),
				typ,
				loc,
			)
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			TailrecListSpreadRecurExpr(
				rewrite_tailrec_list_spread_rebinds_with_cleanups(rebinds, cleanups),
				cursor_advance,
				typ,
				loc,
			)


pure func rewrite_resource_expr(expr: CoreExpr) -> CoreExpr:
	rewrite_resource_expr_with_cleanups(expr, [])


pure func rewrite_resource_function(func_info: CoreFunction) -> CoreFunction:
	match func_info.body:
		Some(body):
			{ func_info | body = Some(rewrite_resource_expr(body)) }
		None:
			func_info


pure func rewrite_resource_global(global: CoreGlobal) -> CoreGlobal:
	{ global | init = rewrite_resource_expr(global.init) }


pure func rewrite_resource_decl(decl: CoreDecl) -> CoreDecl:
	match decl:
		FunctionDecl(func_info):
			FunctionDecl(rewrite_resource_function(func_info))
		GlobalDecl(global):
			GlobalDecl(rewrite_resource_global(global))
		EnumDecl(enum_decl):
			decl
		UnionDecl(union_decl):
			decl
		ValueRecordDecl(record_decl):
			decl
		HeapRecordDecl(record_decl):
			decl


pure func rewrite_resource_program(program: CoreProgram) -> CoreProgram:
	var decls: List[CoreDecl] = []

	for decl in program.decls:
		decls = decls.append(rewrite_resource_decl(decl))

	{
		decls = decls,
		foreign_includes = program.foreign_includes
	}
