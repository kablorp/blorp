-- Blorp-authored renderer for prepared tuple emission.
--
-- OCaml still decides tuple layout details and renders child Core
-- expressions. This module owns the final C shape for tuple snippets once
-- that data crosses the JSON boundary.
import:
	codegen_template_registry:
		render_template_arity_error,
		render_template_manifest_line,
		render_unsupported_template_error,
	json: JsonValue, as_string, get_field, parse_json


enum PreparedTupleTemplate:
	TupleNameTemplate
	TupleArgTemplate
	TupleConstructTemplate
	TupleRetainElemTemplate
	TupleConstructWithRcTemplate
	TupleFieldElementTemplate
	TupleFieldAccessTemplate


record PreparedTupleTemplateInfo {
	template: PreparedTupleTemplate,
	name: String
}


record TupleConstructArgs {
	arity: String,
	args: String
}


record TupleRetainElemArgs {
	tuple: String,
	index: String
}


record TupleConstructWithRcArgs {
	tuple: String,
	arity: String,
	args: String,
	retain_statements: String,
	release_mask: String
}


record TupleFieldElementArgs {
	tuple: String,
	field: String
}


record TupleFieldAccessArgs {
	tuple: String,
	source: String,
	read: String
}


union PreparedTupleOp:
	TupleName(String)
	TupleArg(String)
	TupleConstruct(TupleConstructArgs)
	TupleRetainElem(TupleRetainElemArgs)
	TupleConstructWithRc(TupleConstructWithRcArgs)
	TupleFieldElement(TupleFieldElementArgs)
	TupleFieldAccess(TupleFieldAccessArgs)


union RenderError:
	WrongArity(PreparedTupleTemplateInfo, Int)
	UnsupportedPreparedTupleOp(String)
	InvalidPreparedTupleJson(String)


private pure func templates_by_name(
	templates: List[PreparedTupleTemplateInfo],
) -> Dict[String, PreparedTupleTemplateInfo]:
	var dict: Dict[String, PreparedTupleTemplateInfo] = {}

	for info in templates:
		dict = dict.set(info.name, info)

	dict


ALL_TEMPLATES: List[PreparedTupleTemplateInfo] = [{
		template = TupleNameTemplate,
		name = "backend_tuple_name"
	}, {
		template = TupleArgTemplate,
		name = "backend_tuple_arg"
	}, {
		template = TupleConstructTemplate,
		name = "backend_tuple_construct"
	}, {
		template = TupleRetainElemTemplate,
		name = "backend_tuple_retain_elem"
	}, {
		template = TupleConstructWithRcTemplate,
		name = "backend_tuple_construct_with_rc"
	}, {
		template = TupleFieldElementTemplate,
		name = "backend_tuple_field_element"
	}, {
		template = TupleFieldAccessTemplate,
		name = "backend_tuple_field_access"
	}]

private TEMPLATES_BY_NAME: Dict[String, PreparedTupleTemplateInfo] = templates_by_name(
	ALL_TEMPLATES,
)


pure func prepared_tuple_template_name(info: PreparedTupleTemplateInfo) -> String:
	info.name


TEMPLATE_NAMES: List[String] = ALL_TEMPLATES.map(prepared_tuple_template_name)


pure func prepared_tuple_template_arity(info: PreparedTupleTemplateInfo) -> Int:
	match info.template:
		TupleNameTemplate:
			1
		TupleArgTemplate:
			1
		TupleConstructTemplate:
			2
		TupleRetainElemTemplate:
			2
		TupleConstructWithRcTemplate:
			5
		TupleFieldElementTemplate:
			2
		TupleFieldAccessTemplate:
			3


pure func parse_prepared_tuple_template(name: String) -> Option[PreparedTupleTemplateInfo]:
	TEMPLATES_BY_NAME.get(name)


private pure func wrong_arity_for_args(
	info: PreparedTupleTemplateInfo,
	args: List[String],
) -> RenderError:
	WrongArity(info, args.length())


pure func render_error_to_string(error: RenderError) -> String:
	match error:
		WrongArity(info, actual):
			render_template_arity_error(
				"prepared tuple op",
				prepared_tuple_template_name(info),
				prepared_tuple_template_arity(info),
				actual,
			)
		UnsupportedPreparedTupleOp(name):
			render_unsupported_template_error("prepared tuple op", name)
		InvalidPreparedTupleJson(message):
			"invalid prepared tuple JSON: " + message


private pure func missing_field_message(field: String) -> String:
	"missing string field: " + field


private pure func string_field(value: JsonValue, field: String) -> Result[String, RenderError]:
	field_value ?= get_field(
		value,
		field,
	).to_result(InvalidPreparedTupleJson(missing_field_message(field)))
	as_string(field_value).to_result(InvalidPreparedTupleJson(missing_field_message(field)))


private pure func parse_tuple_construct_args(args: List[String]) -> Option[TupleConstructArgs]:
	match args:
		[arity, tuple_args]:
			Some({
				arity = arity,
				args = tuple_args,
			})
		_:
			None


private pure func parse_tuple_retain_elem_args(args: List[String]) -> Option[TupleRetainElemArgs]:
	match args:
		[tuple, index]:
			Some({
				tuple = tuple,
				index = index,
			})
		_:
			None


private pure func parse_tuple_construct_with_rc_args(
	args: List[String],
) -> Option[TupleConstructWithRcArgs]:
	match args:
		[tuple, arity, tuple_args, retain_statements, release_mask]:
			Some({
				tuple = tuple,
				arity = arity,
				args = tuple_args,
				retain_statements = retain_statements,
				release_mask = release_mask,
			})
		_:
			None


private pure func parse_tuple_field_element_args(
	args: List[String],
) -> Option[TupleFieldElementArgs]:
	match args:
		[tuple, field]:
			Some({
				tuple = tuple,
				field = field,
			})
		_:
			None


private pure func parse_tuple_field_access_args(args: List[String]) -> Option[TupleFieldAccessArgs]:
	match args:
		[tuple, source, read]:
			Some({
				tuple = tuple,
				source = source,
				read = read,
			})
		_:
			None


pure func render_tuple_name(temp_seed: String) -> String:
	"__tup_" + temp_seed


pure func render_tuple_arg(value: String) -> String:
	", " + value


pure func render_tuple_construct(args: TupleConstructArgs) -> String:
	"blorp_tuple_new(" + args.arity + args.args + ")"


pure func render_tuple_retain_elem(args: TupleRetainElemArgs) -> String:
	"if (" + args.tuple + "->elem[" + args.index + "]) blorp_retain(" + args.tuple + "->elem[" + args.index + "]);"


pure func render_tuple_construct_with_rc(args: TupleConstructWithRcArgs) -> String:
	"({ blorp_Tuple* " + args.tuple + " = blorp_tuple_new(" + args.arity + args.args + "); " + args.retain_statements + " blorp_tuple_set_rc(" + args.tuple + ", " + args.release_mask + "UL); " + args.tuple + "; })"


pure func render_tuple_field_element(args: TupleFieldElementArgs) -> String:
	"((blorp_Tuple*)" + args.tuple + ")->elem[" + args.field + "]"


pure func render_tuple_field_access(args: TupleFieldAccessArgs) -> String:
	"({ void* " + args.tuple + " = (void*)" + args.source + "; " + args.read + "; })"


pure func render_prepared_tuple_op(op: PreparedTupleOp) -> String:
	match op:
		TupleName(temp_seed):
			render_tuple_name(temp_seed)
		TupleArg(value):
			render_tuple_arg(value)
		TupleConstruct(args):
			render_tuple_construct(args)
		TupleRetainElem(args):
			render_tuple_retain_elem(args)
		TupleConstructWithRc(args):
			render_tuple_construct_with_rc(args)
		TupleFieldElement(args):
			render_tuple_field_element(args)
		TupleFieldAccess(args):
			render_tuple_field_access(args)


pure func decode_prepared_tuple_json_value(
	value: JsonValue,
) -> Result[PreparedTupleOp, RenderError]:
	op ?= string_field(value, "op")

	match op:
		"tuple_name":
			temp_seed ?= string_field(value, "temp_seed")
			Ok(TupleName(temp_seed))
		"tuple_arg":
			arg_value ?= string_field(value, "value")
			Ok(TupleArg(arg_value))
		"tuple_construct":
			arity ?= string_field(value, "arity")
			tuple_args ?= string_field(value, "args")
			Ok(TupleConstruct({
				arity = arity,
				args = tuple_args,
			}))
		"tuple_retain_elem":
			tuple ?= string_field(value, "tuple")
			index ?= string_field(value, "index")
			Ok(TupleRetainElem({
				tuple = tuple,
				index = index,
			}))
		"tuple_construct_with_rc":
			tuple ?= string_field(value, "tuple")
			arity ?= string_field(value, "arity")
			tuple_args ?= string_field(value, "args")
			retain_statements ?= string_field(value, "retain_statements")
			release_mask ?= string_field(value, "release_mask")
			Ok(TupleConstructWithRc({
				tuple = tuple,
				arity = arity,
				args = tuple_args,
				retain_statements = retain_statements,
				release_mask = release_mask,
			}))
		"tuple_field_element":
			tuple ?= string_field(value, "tuple")
			field ?= string_field(value, "field")
			Ok(TupleFieldElement({
				tuple = tuple,
				field = field,
			}))
		"tuple_field_access":
			tuple ?= string_field(value, "tuple")
			source ?= string_field(value, "source")
			read ?= string_field(value, "read")
			Ok(TupleFieldAccess({
				tuple = tuple,
				source = source,
				read = read,
			}))
		other:
			Err(InvalidPreparedTupleJson("unknown tuple op: " + other))


pure func render_prepared_tuple_json(source: String) -> Result[String, RenderError]:
	value ?= parse_json(source).map_err(func(message): InvalidPreparedTupleJson(message))
	op ?= decode_prepared_tuple_json_value(value)
	Ok(render_prepared_tuple_op(op))


pure func build_prepared_tuple_op(
	info: PreparedTupleTemplateInfo,
	args: List[String],
) -> Result[PreparedTupleOp, RenderError]:
	match info.template:
		TupleNameTemplate:
			match args:
				[temp_seed]:
					Ok(TupleName(temp_seed))
				_:
					Err(wrong_arity_for_args(info, args))
		TupleArgTemplate:
			match args:
				[value]:
					Ok(TupleArg(value))
				_:
					Err(wrong_arity_for_args(info, args))
		TupleConstructTemplate:
			parsed ?= parse_tuple_construct_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(TupleConstruct(parsed))
		TupleRetainElemTemplate:
			parsed ?= parse_tuple_retain_elem_args(args).to_result(wrong_arity_for_args(info, args))
			Ok(TupleRetainElem(parsed))
		TupleConstructWithRcTemplate:
			parsed ?= parse_tuple_construct_with_rc_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TupleConstructWithRc(parsed))
		TupleFieldElementTemplate:
			parsed ?= parse_tuple_field_element_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TupleFieldElement(parsed))
		TupleFieldAccessTemplate:
			parsed ?= parse_tuple_field_access_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TupleFieldAccess(parsed))


pure func render_prepared_tuple(name: String, args: List[String]) -> Result[String, RenderError]:
	match parse_prepared_tuple_template(name):
		Some(info):
			match build_prepared_tuple_op(info, args):
				Ok(op):
					Ok(render_prepared_tuple_op(op))
				Err(error):
					Err(error)
		None:
			Err(UnsupportedPreparedTupleOp(name))


private pure func placeholder_prepared_tuple_op(info: PreparedTupleTemplateInfo) -> PreparedTupleOp:
	match info.template:
		TupleNameTemplate:
			TupleName("@0@")
		TupleArgTemplate:
			TupleArg("@0@")
		TupleConstructTemplate:
			TupleConstruct({
				arity = "@0@",
				args = "@1@",
			})
		TupleRetainElemTemplate:
			TupleRetainElem({
				tuple = "@0@",
				index = "@1@",
			})
		TupleConstructWithRcTemplate:
			TupleConstructWithRc({
				tuple = "@0@",
				arity = "@1@",
				args = "@2@",
				retain_statements = "@3@",
				release_mask = "@4@",
			})
		TupleFieldElementTemplate:
			TupleFieldElement({
				tuple = "@0@",
				field = "@1@",
			})
		TupleFieldAccessTemplate:
			TupleFieldAccess({
				tuple = "@0@",
				source = "@1@",
				read = "@2@",
			})


pure func render_manifest_line(info: PreparedTupleTemplateInfo) -> String:
	name: String = prepared_tuple_template_name(info)
	arity: Int = prepared_tuple_template_arity(info)
	body: String = render_prepared_tuple_op(placeholder_prepared_tuple_op(info))
	render_template_manifest_line(name, arity, body)


pure func render_manifest_lines() -> List[String]:
	ALL_TEMPLATES.map(render_manifest_line)
