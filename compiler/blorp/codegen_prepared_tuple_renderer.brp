-- Blorp-authored renderer for tuple-related Core emission.
--
-- OCaml still owns Core traversal, child expression emission, release-mask
-- analysis, and fresh temp seeds. This module owns tuple construction C shapes
-- tuple field-access C shapes, and local temp-name conventions.
enum CompilerCommand:
	RenderPreparedTupleCommand
	RenderManifestCommand
	UnknownCommand


enum PreparedTupleTemplate:
	TupleNameTemplate
	TupleArgTemplate
	TupleConstructTemplate
	TupleRetainElemTemplate
	TupleConstructWithRcTemplate
	TupleFieldElementTemplate
	TupleFieldAccessTemplate


record PreparedTupleTemplateInfo {
	template: PreparedTupleTemplate,
	name: String,
	arity: Int
}


record TupleConstructWithRcArgs {
	tuple: String,
	arity: String,
	args: String,
	retain_statements: String,
	release_mask: String
}


record TupleFieldAccessArgs {
	tuple: String,
	source: String,
	read: String
}


union PreparedTupleOp:
	TupleName(String)
	TupleArg(String)
	TupleConstruct(String, String)
	TupleRetainElem(String, String)
	TupleConstructWithRc(TupleConstructWithRcArgs)
	TupleFieldElement(String, String)
	TupleFieldAccess(TupleFieldAccessArgs)


union RenderError:
	WrongArity(PreparedTupleTemplateInfo, Int)
	UnsupportedPreparedTupleOp(String)


ALL_TEMPLATES: List[PreparedTupleTemplateInfo] = [{
		template = TupleNameTemplate,
		name = "tuple_name",
		arity = 1
	}, {
		template = TupleArgTemplate,
		name = "tuple_arg",
		arity = 1
	}, {
		template = TupleConstructTemplate,
		name = "tuple_construct",
		arity = 2
	}, {
		template = TupleRetainElemTemplate,
		name = "tuple_retain_elem",
		arity = 2
	}, {
		template = TupleConstructWithRcTemplate,
		name = "tuple_construct_with_rc",
		arity = 5
	}, {
		template = TupleFieldElementTemplate,
		name = "tuple_field_element",
		arity = 2
	}, {
		template = TupleFieldAccessTemplate,
		name = "tuple_field_access",
		arity = 3
	}]

USAGE: String = (
	"Usage: codegen_prepared_tuple_renderer prepared-tuple <name> [rendered-arg...] "
	+ "| manifest"
)

private OPEN_BRACE: String = "{"

private CLOSE_BRACE: String = "}"


private pure func c_block(body: String) -> String:
	OPEN_BRACE + " " + body + " " + CLOSE_BRACE


private pure func c_statement_expr(body: String) -> String:
	"(" + c_block(body) + ")"


pure func parse_command(command: String) -> CompilerCommand:
	match command:
		"prepared-tuple":
			RenderPreparedTupleCommand
		"manifest":
			RenderManifestCommand
		_:
			UnknownCommand


pure func prepared_tuple_template_name(info: PreparedTupleTemplateInfo) -> String:
	info.name


pure func prepared_tuple_template_arity(info: PreparedTupleTemplateInfo) -> Int:
	info.arity


pure func parse_prepared_tuple_template(name: String) -> Option[PreparedTupleTemplateInfo]:
	var found: Option[PreparedTupleTemplateInfo] = None

	for info in ALL_TEMPLATES:
		if found.is_none() and info.name == name:
			found = Some(info)

	found


pure func render_error_to_string(error: RenderError) -> String:
	match error:
		WrongArity(info, got):
			"prepared tuple op ${info.name} expected ${info.arity} arg(s), got ${got}"
		UnsupportedPreparedTupleOp(name):
			"unsupported prepared tuple op: ${name}"


pure func wrong_arity_for_args(info: PreparedTupleTemplateInfo, args: List[String]) -> RenderError:
	WrongArity(info, args.length())


private pure func parse_single_arg(args: List[String]) -> Option[String]:
	match args:
		[value]:
			Some(value)
		_:
			None


private pure func parse_tuple_construct(args: List[String]) -> Option[PreparedTupleOp]:
	match args:
		[arity, tuple_args]:
			Some(TupleConstruct(arity, tuple_args))
		_:
			None


private pure func parse_tuple_retain_elem(args: List[String]) -> Option[PreparedTupleOp]:
	match args:
		[tuple, index]:
			Some(TupleRetainElem(tuple, index))
		_:
			None


private pure func parse_tuple_construct_with_rc_args(
	args: List[String],
) -> Option[TupleConstructWithRcArgs]:
	match args:
		[tuple, arity, tuple_args, retain_statements, release_mask]:
			Some({
				tuple = tuple,
				arity = arity,
				args = tuple_args,
				retain_statements = retain_statements,
				release_mask = release_mask,
			})
		_:
			None


private pure func parse_tuple_field_element(args: List[String]) -> Option[PreparedTupleOp]:
	match args:
		[tuple, field]:
			Some(TupleFieldElement(tuple, field))
		_:
			None


private pure func parse_tuple_field_access_args(args: List[String]) -> Option[TupleFieldAccessArgs]:
	match args:
		[tuple, source, read]:
			Some({
				tuple = tuple,
				source = source,
				read = read,
			})
		_:
			None


private pure func tuple_tmp(temp_seed: String) -> String:
	"__tup_${temp_seed}"


private pure func render_tuple_name(temp_seed: String) -> String:
	tuple_tmp(temp_seed)


private pure func render_tuple_arg(value: String) -> String:
	", ${value}"


private pure func render_tuple_construct(arity: String, args: String) -> String:
	"blorp_tuple_new(${arity}${args})"


private pure func render_tuple_retain_elem(tuple: String, index: String) -> String:
	"if (${tuple}->elem[${index}]) blorp_retain(${tuple}->elem[${index}]);"


private pure func retain_statements_with_separator(statements: String) -> String:
	if statements == "":
		""
	else:
		statements + " "


private pure func render_tuple_construct_with_rc(args: TupleConstructWithRcArgs) -> String:
	retains: String = retain_statements_with_separator(args.retain_statements)
	c_statement_expr(
		"blorp_Tuple* ${args.tuple} = blorp_tuple_new(${args.arity}${args.args}); " + "${retains}blorp_tuple_set_rc(${args.tuple}, ${args.release_mask}UL); " + "${args.tuple};",
	)


private pure func render_tuple_field_element(tuple: String, field: String) -> String:
	"((blorp_Tuple*)${tuple})->elem[${field}]"


private pure func render_tuple_field_access(args: TupleFieldAccessArgs) -> String:
	c_statement_expr("void* ${args.tuple} = (void*)${args.source}; ${args.read};")


pure func render_prepared_tuple_op(op: PreparedTupleOp) -> String:
	match op:
		TupleName(temp_seed):
			render_tuple_name(temp_seed)
		TupleArg(value):
			render_tuple_arg(value)
		TupleConstruct(arity, args):
			render_tuple_construct(arity, args)
		TupleRetainElem(tuple, index):
			render_tuple_retain_elem(tuple, index)
		TupleConstructWithRc(args):
			render_tuple_construct_with_rc(args)
		TupleFieldElement(tuple, field):
			render_tuple_field_element(tuple, field)
		TupleFieldAccess(args):
			render_tuple_field_access(args)


pure func build_prepared_tuple_op(
	info: PreparedTupleTemplateInfo,
	args: List[String],
) -> Result[PreparedTupleOp, RenderError]:
	match info.template:
		TupleNameTemplate:
			temp_seed ?= parse_single_arg(args).to_result(wrong_arity_for_args(info, args))
			Ok(TupleName(temp_seed))
		TupleArgTemplate:
			value ?= parse_single_arg(args).to_result(wrong_arity_for_args(info, args))
			Ok(TupleArg(value))
		TupleConstructTemplate:
			op ?= parse_tuple_construct(args).to_result(wrong_arity_for_args(info, args))
			Ok(op)
		TupleRetainElemTemplate:
			op ?= parse_tuple_retain_elem(args).to_result(wrong_arity_for_args(info, args))
			Ok(op)
		TupleConstructWithRcTemplate:
			parsed ?= parse_tuple_construct_with_rc_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TupleConstructWithRc(parsed))
		TupleFieldElementTemplate:
			op ?= parse_tuple_field_element(args).to_result(wrong_arity_for_args(info, args))
			Ok(op)
		TupleFieldAccessTemplate:
			parsed ?= parse_tuple_field_access_args(
				args,
			).to_result(wrong_arity_for_args(info, args))
			Ok(TupleFieldAccess(parsed))


pure func render_prepared_tuple(name: String, args: List[String]) -> Result[String, RenderError]:
	match parse_prepared_tuple_template(name):
		Some(info):
			match build_prepared_tuple_op(info, args):
				Ok(op):
					Ok(render_prepared_tuple_op(op))
				Err(error):
					Err(error)
		None:
			Err(UnsupportedPreparedTupleOp(name))


private pure func placeholder_prepared_tuple_op(info: PreparedTupleTemplateInfo) -> PreparedTupleOp:
	match info.template:
		TupleNameTemplate:
			TupleName("@0@")
		TupleArgTemplate:
			TupleArg("@0@")
		TupleConstructTemplate:
			TupleConstruct("@0@", "@1@")
		TupleRetainElemTemplate:
			TupleRetainElem("@0@", "@1@")
		TupleConstructWithRcTemplate:
			TupleConstructWithRc({
				tuple = "@0@",
				arity = "@1@",
				args = "@2@",
				retain_statements = "@3@",
				release_mask = "@4@",
			})
		TupleFieldElementTemplate:
			TupleFieldElement("@0@", "@1@")
		TupleFieldAccessTemplate:
			TupleFieldAccess({
				tuple = "@0@",
				source = "@1@",
				read = "@2@",
			})


pure func render_manifest_line(info: PreparedTupleTemplateInfo) -> String:
	name: String = prepared_tuple_template_name(info)
	arity: Int = prepared_tuple_template_arity(info)
	body: String = render_prepared_tuple_op(placeholder_prepared_tuple_op(info))
	"${name}\t${arity}\t${body}"


pure func render_manifest_lines() -> List[String]:
	ALL_TEMPLATES.map(render_manifest_line)


func print_manifest() -> Void:
	for line in render_manifest_lines():
		print(line)


func print_result(result: Result[String, RenderError]) -> Int:
	match result:
		Ok(rendered):
			puts(rendered)
			0
		Err(error):
			print(render_error_to_string(error))
			1


func main(args: List[String]) -> Int:
	match args:
		[program_name, command_name, ...command_args]:
			match parse_command(command_name):
				RenderPreparedTupleCommand:
					match command_args:
						[name, ...rendered_args]:
							print_result(render_prepared_tuple(name, rendered_args))
						[]:
							print(USAGE)
							1
				RenderManifestCommand:
					print_manifest()
					0
				UnknownCommand:
					print(USAGE)
					1
		[program_name]:
			print(USAGE)
			1
		[]:
			print(USAGE)
			1
