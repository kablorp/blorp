-- Parser-only compiler bridge dispatcher.
--
-- The cached backend bridge helper is intentionally bootstrap-small. Parser
-- requests import the Blorp lexer/parser here so the parser helper can be
-- compiled by the current compiler while using the small backend helper for
-- its own C emission.
import:
	compiler_bridge_protocol:
		BRIDGE_SCHEMA_VERSION,
		BridgeAction(
			CompileSourceAction,
			EmitPostClosureCAction,
			LowerAndCompileAction,
			ParseSourceAction,
			ParseSourcesAction,
			PrepareAndEmitCAction,
			RendererTemplatesAction,
			RenderManyAction,
			RunCliAction,
			RunCorePipelineAction,
			TypecheckAndCompileAction,
		),
		BridgeEnvelope,
		BridgeProtocolError(InvalidJson),
		bridge_action_name,
		bridge_error_json,
		bridge_success_json,
		decode_bridge_envelope_value,
	compiler_lexer: compiler_lex
	compiler_parsed_ast_json: parsed_program_to_json
	compiler_parser: parse_compiler_source
	compiler_source: CompilerSourceFile, compiler_source_file
	compiler_token: CompilerToken, CompilerTrivia, CompilerTriviaKind(CommentTrivia)
	json:
		JsonValue(JsonBool, JsonNumber, JsonObject, JsonString, JsonVector),
		as_array,
		as_bool,
		as_string,
		get_field,
		parse_json,


union ParserBridgeDispatchError:
	ProtocolError(BridgeProtocolError)
	MissingStringField(String)
	ExpectedRequestField(String, String)
	UnsupportedBridgeAction(BridgeAction)


private pure func owned_string(text: String) -> String:
	text.substring(0, text.length())


private pure func schema_json() -> JsonValue:
	JsonNumber(to_float(BRIDGE_SCHEMA_VERSION))


private pure func dispatch_error_code(error: ParserBridgeDispatchError) -> String:
	match error:
		ProtocolError(_):
			"invalid_request"
		MissingStringField(_):
			"invalid_request"
		ExpectedRequestField(_, _):
			"invalid_request"
		UnsupportedBridgeAction(_):
			"unsupported_action"


private pure func dispatch_error_message(error: ParserBridgeDispatchError) -> String:
	match error:
		ProtocolError(_):
			"invalid bridge request"
		MissingStringField(field_name):
			"missing string field `${field_name}`"
		ExpectedRequestField(field_name, expected):
			"field `${field_name}` must be ${expected}"
		UnsupportedBridgeAction(action):
			"unsupported Blorp parser bridge action: ${bridge_action_name(action)}"


private pure func dispatch_error_json(error: ParserBridgeDispatchError) -> JsonValue:
	match error:
		ProtocolError(protocol_error):
			bridge_error_json(protocol_error)
		_:
			JsonObject([("schema", schema_json()), ("ok", JsonBool(False)), ("error", JsonObject([
						("code", JsonString(dispatch_error_code(error))),
						("message", JsonString(dispatch_error_message(error))),
					]))])


private pure func request_body(envelope: BridgeEnvelope) -> JsonValue:
	envelope.payload


private pure func string_field(
	value: JsonValue,
	field_name: String,
) -> Result[String, ParserBridgeDispatchError]:
	field ?= get_field(value, field_name).to_result(MissingStringField(field_name))
	as_string(field)
		.map(owned_string)
		.to_result(ExpectedRequestField(field_name, "a string"))


private pure func optional_bool_field(value: JsonValue, field_name: String, default: Bool) -> Bool:
	match get_field(value, field_name):
		Some(field):
			as_bool(field).get_or(default)
		None:
			default


private pure func comment_json(trivia: CompilerTrivia, trailing: Bool) -> JsonValue:
	JsonObject([
		("text", JsonString(trivia.text)),
		("line", JsonNumber(to_float(trivia.span.start_line))),
		("column", JsonNumber(to_float(trivia.span.start_column))),
		("trailing", JsonBool(trailing)),
	])


private pure func append_comment_jsons(
	comments: List[JsonValue],
	trivia: List[CompilerTrivia],
	trailing: Bool,
) -> List[JsonValue]:
	var result: List[JsonValue] = comments

	for item in trivia:
		if item.kind == CommentTrivia:
			result = result.append(comment_json(item, trailing))

	result


private pure func token_comment_jsons(token: CompilerToken) -> List[JsonValue]:
	append_comment_jsons(
		append_comment_jsons([], token.leading_trivia, False),
		token.trailing_trivia,
		True,
	)


private pure func source_comment_jsons(source: CompilerSourceFile) -> JsonValue:
	lex_result = compiler_lex(source)
	var comments: List[JsonValue] = []

	for token in lex_result.tokens:
		for comment in token_comment_jsons(token):
			comments = comments.append(comment)

	JsonVector(comments)


private pure func parsed_source_artifact(
	path: String,
	module_name: String,
	text: String,
	include_comments: Bool,
) -> JsonValue:
	source = compiler_source_file(path, module_name, text)
	program = parse_compiler_source(source)
	var fields: List[(String, JsonValue)] = [
		("path", JsonString(path)),
		("module", JsonString(module_name)),
		("parsed_ast", parsed_program_to_json(program)),
	]

	if include_comments:
		fields = fields.append(("comments", source_comment_jsons(source)))

	JsonObject(fields)


private pure func handle_parse_source(
	body: JsonValue,
) -> Result[JsonValue, ParserBridgeDispatchError]:
	path ?= string_field(body, "path")
	module_name ?= string_field(body, "module")
	text ?= string_field(body, "text")
	include_comments = optional_bool_field(body, "include_comments", True)

	Ok(bridge_success_json(parsed_source_artifact(path, module_name, text, include_comments)))


private pure func source_items_field(
	value: JsonValue,
	field_name: String,
) -> Result[List[JsonValue], ParserBridgeDispatchError]:
	field ?= get_field(value, field_name).to_result(MissingStringField(field_name))
	as_array(field).to_result(ExpectedRequestField(field_name, "an array"))


private pure func parse_source_item(
	value: JsonValue,
	include_comments: Bool,
) -> Result[JsonValue, ParserBridgeDispatchError]:
	path ?= string_field(value, "path")
	module_name ?= string_field(value, "module")
	text ?= string_field(value, "text")

	Ok(parsed_source_artifact(path, module_name, text, include_comments))


private pure func parse_source_items_at(
	sources: List[JsonValue],
	index: Int,
	parsed_sources: List[JsonValue],
	include_comments: Bool,
) -> Result[List[JsonValue], ParserBridgeDispatchError]:
	if index >= sources.length():
		Ok(parsed_sources)
	else:
		match sources.get(index):
			Some(source):
				match parse_source_item(source, include_comments):
					Ok(parsed):
						parse_source_items_at(
							sources,
							index + 1,
							parsed_sources.append(parsed),
							include_comments,
						)
					Err(error):
						Err(error)
			None:
				Ok(parsed_sources)


private pure func handle_parse_sources(
	body: JsonValue,
) -> Result[JsonValue, ParserBridgeDispatchError]:
	sources ?= source_items_field(body, "sources")
	include_comments = optional_bool_field(body, "include_comments", False)
	parsed_sources ?= parse_source_items_at(sources, 0, [], include_comments)

	Ok(bridge_success_json(JsonObject([("sources", JsonVector(parsed_sources))])))


private pure func handle_envelope(
	envelope: BridgeEnvelope,
) -> Result[JsonValue, ParserBridgeDispatchError]:
	body: JsonValue = request_body(envelope)

	match envelope.action:
		ParseSourceAction:
			handle_parse_source(body)
		ParseSourcesAction:
			handle_parse_sources(body)
		RunCliAction:
			Err(UnsupportedBridgeAction(envelope.action))
		RenderManyAction:
			Err(UnsupportedBridgeAction(envelope.action))
		RendererTemplatesAction:
			Err(UnsupportedBridgeAction(envelope.action))
		PrepareAndEmitCAction:
			Err(UnsupportedBridgeAction(envelope.action))
		EmitPostClosureCAction:
			Err(UnsupportedBridgeAction(envelope.action))
		RunCorePipelineAction:
			Err(UnsupportedBridgeAction(envelope.action))
		LowerAndCompileAction:
			Err(UnsupportedBridgeAction(envelope.action))
		TypecheckAndCompileAction:
			Err(UnsupportedBridgeAction(envelope.action))
		CompileSourceAction:
			Err(UnsupportedBridgeAction(envelope.action))


pure func handle_request_value(root: JsonValue) -> JsonValue:
	match decode_bridge_envelope_value(root):
		Ok(envelope):
			handle_envelope(envelope).get_or_else(dispatch_error_json)
		Err(error):
			bridge_error_json(error)


pure func handle_request(source: String) -> String:
	parse_json(source)
		.map(func(root): handle_request_value(root).to_string())
		.get_or_else(func(message): bridge_error_json(InvalidJson(message)).to_string())
