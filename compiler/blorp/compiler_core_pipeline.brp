-- Blorp-owned Core-to-Core pipeline slices.
--
-- This module is the home for contiguous IR stage ownership after the OCaml
-- handoff. The bridge should decode protocol JSON and call these pure
-- functions; pass ordering should live here instead of in the dispatcher or C
-- emitter.
import:
	compiler_core_fairness: insert_cooperative_checkpoints
	compiler_core_json: CoreProgram
	compiler_core_prepare as CorePrepare
	compiler_core_resource: rewrite_resource_program


TAIL_RESOURCE_FAIRNESS_PREPARE_STAGE: String = "tail_resource_fairness_prepare"


enum CorePipelineStage:
	TailResourceFairnessPrepareStage


pure func parse_core_pipeline_stage(name: String) -> Option[CorePipelineStage]:
	if name == TAIL_RESOURCE_FAIRNESS_PREPARE_STAGE:
		Some(TailResourceFairnessPrepareStage)
	else:
		None


pure func run_tail_resource_fairness_prepare(program: CoreProgram) -> CoreProgram:
	resource_program: CoreProgram = rewrite_resource_program(program)
	checked_program: CoreProgram = insert_cooperative_checkpoints(resource_program)

	CorePrepare.prepare_program(checked_program)


pure func run_core_pipeline_stage(stage: CorePipelineStage, program: CoreProgram) -> CoreProgram:
	match stage:
		TailResourceFairnessPrepareStage:
			run_tail_resource_fairness_prepare(program)
