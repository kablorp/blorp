opam-version: "2.0"
name: "blorp"
version: "0.0.1"
synopsis: "Blorp - A safe programming language"
description:
  "A functional programming language with pure/impure tracking, ADTs, and pattern matching."
maintainer: "dev@example.com"
authors: "Blorp Contributors"
license: "MIT"
depends: [
  "alcotest" {= "1.9.1" & with-test}
  "astring" {= "0.8.5" & with-test}
  "base" {= "v0.16.5" & with-test}
  "base-bigarray" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "bisect_ppx" {= "2.8.3" & with-test}
  "camlp-streams" {= "5.0.1" & with-test}
  "cmdliner" {= "1.3.0" & with-test}
  "csexp" {= "1.5.2" & with-test}
  "dune" {= "3.23.1"}
  "dune-build-info" {= "3.23.1" & with-test}
  "dune-configurator" {= "3.23.1" & with-test}
  "either" {= "1.0.0" & with-test}
  "fix" {= "20250919" & with-test}
  "fmt" {= "0.11.0" & with-test}
  "fpath" {= "0.7.3" & with-test}
  "menhir" {= "20260209"}
  "menhirCST" {= "20260209"}
  "menhirGLR" {= "20260209"}
  "menhirLib" {= "20260209"}
  "menhirSdk" {= "20260209"}
  "ocaml" {= "4.14.2"}
  "ocaml-base-compiler" {= "4.14.2"}
  "ocaml-compiler-libs" {= "v0.12.4" & with-test}
  "ocaml-config" {= "2"}
  "ocaml-options-vanilla" {= "1"}
  "ocaml-syntax-shims" {= "1.0.0" & with-test}
  "ocaml-version" {= "4.1.1" & with-test}
  "ocamlbuild" {= "0.16.1" & with-test}
  "ocamlfind" {= "1.9.8" & with-test}
  "ocp-indent" {= "1.9.0" & with-test}
  "ppx_derivers" {= "1.2.1" & with-test}
  "ppxlib" {= "0.35.0" & with-test}
  "re" {= "1.14.0" & with-test}
  "sexplib0" {= "v0.16.0" & with-test}
  "stdio" {= "v0.16.0" & with-test}
  "stdlib-shims" {= "0.3.0" & with-test}
  "topkg" {= "1.1.1" & with-test}
  "uucp" {= "17.0.0" & with-test}
  "uuseg" {= "17.0.0" & with-test}
  "uutf" {= "1.0.4" & with-test}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
