(include_subdirs unqualified)

(library
 (name blorp)
 (public_name blorp)
 (libraries unix)
 (instrumentation
  (backend bisect_ppx)))

(rule
 (target runtime.ml)
 (deps runtime.c runtime_decl.c minicoro.h)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo
     "let runtime_code = {runtime_c|\n#define _GNU_SOURCE\n#define MINICORO_IMPL\n")
    (cat minicoro.h)
    (echo "\n")
    (cat runtime.c)
    (echo
     "|runtime_c}\n\nlet runtime_decl = {runtime_decl_c|\n#define _GNU_SOURCE\n")
    (cat minicoro.h)
    (echo "\n")
    (cat runtime_decl.c)
    (echo "|runtime_decl_c}\n")))))

(rule
 (target runtime_raylib.ml)
 (deps runtime_raylib.c)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let runtime_raylib_code = {runtime_raylib_c|\n")
    (cat %{deps})
    (echo "|runtime_raylib_c}\n")))))

(rule
 (target embedded_std.ml)
 (mode fallback)
 (action
  (with-stdout-to
   %{target}
   (echo
    "(* Stub — run 'make' to embed the real std library *)\nlet digest = \"missing\"\nlet modules = []\nlet find _ = None\n"))))

(rule
 (target build_info.ml)
 (deps
  ../tools/gen_build_info.ml
  (env_var BLORP_BUILD_VERSION)
  (env_var BLORP_BUILD_COMMIT)
  (env_var BLORP_BUILD_TARGET)
  (env_var BLORP_BUILD_CHANNEL)
  (env_var BLORP_BUILD_DIRTY))
 (action
  (with-stdout-to
   %{target}
   (run ocaml ../tools/gen_build_info.ml))))
