(include_subdirs unqualified)

(library
 (name blorp)
 (public_name blorp)
 (modules :standard embedded_codegen_intrinsic_templates)
 (libraries unix)
 (instrumentation
  (backend bisect_ppx)))

(ocamllex lexer)

(menhir
 (modules parser)
 (flags --explain --strict))

(rule
 (target runtime.ml)
 (deps runtime.c runtime_decl.c minicoro.h)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo
     "let runtime_code = {runtime_c|\n#define _GNU_SOURCE\n#define MINICORO_IMPL\n")
    (cat minicoro.h)
    (echo "\n")
    (cat runtime.c)
    (echo
     "|runtime_c}\n\nlet runtime_decl = {runtime_decl_c|\n#define _GNU_SOURCE\n")
    (cat minicoro.h)
    (echo "\n")
    (cat runtime_decl.c)
    (echo "|runtime_decl_c}\n")))))

(rule
 (target runtime_raylib.ml)
 (deps runtime_raylib.c)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let runtime_raylib_code = {runtime_raylib_c|\n")
    (cat %{deps})
    (echo "|runtime_raylib_c}\n")))))

(rule
 (target embedded_std.ml)
 (mode fallback)
 (action
  (with-stdout-to
   %{target}
   (echo
    "(* Stub — run 'make' to embed the real std library *)\nlet digest = \"missing\"\nlet modules = []\nlet find _ = None\n"))))

(rule
 (target build_info.ml)
 (deps
  ../tools/gen_build_info.ml
  (env_var BLORP_BUILD_VERSION)
  (env_var BLORP_BUILD_COMMIT)
  (env_var BLORP_BUILD_TARGET)
  (env_var BLORP_BUILD_CHANNEL)
  (env_var BLORP_BUILD_DIRTY))
 (action
  (with-stdout-to
   %{target}
   (run ocaml ../tools/gen_build_info.ml))))

(rule
 (target embedded_formatter.ml)
 (mode fallback)
 (action
  (with-stdout-to
   %{target}
   (echo
    "(* Stub — run 'make' to embed the real formatter sources *)\n\n[@@@ocamlformat \"disable\"]\nlet main_path = \"tools/formatter/formatter.brp\"\nlet digest = \"missing\"\nlet files = []\nlet find _ = None\n"))))

(rule
 (target embedded_codegen_intrinsic_templates.ml)
 (deps core_emit_blorp_intrinsic_templates.tsv)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo
     "(* Generated from core_emit_blorp_intrinsic_templates.tsv - do not edit *)\n\nlet tsv = {|")
    (cat %{deps})
    (echo "|}\n")))))
