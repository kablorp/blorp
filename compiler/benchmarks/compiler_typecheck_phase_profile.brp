-- Isolated function profile for migrated typechecking phases.
--
-- Usage:
--   benchmarks/compiler_typecheck_phase_profile headers
--   benchmarks/compiler_typecheck_phase_profile skeleton 20 8 32 64 4
--
-- Positional controls are stage, iterations, modules, shapes per module,
-- probes per module, and import fan-out. Fixture construction validates the
-- complete Phase 1-4 chain before the selected pure phase enters the profile
-- window.
import:
	compiler_type_header_mixed_profile_fixture:
		CompilerMixedTypeHeaderBenchmarkConfig,
		compiler_mixed_type_header_phase_profile_fixture,
	compiler_typecheck_phase_profile_fixture:
		CompilerTypecheckPhaseProfileRun(
			CompilerTypecheckPhaseProfileCompleted,
			CompilerTypecheckPhaseProfileInvariantFailed,
		),
		CompilerTypecheckProfileStage(
			CompilerProfileAcceptedGraph,
			CompilerProfileAliasDependencies,
			CompilerProfileBoundModules,
			CompilerProfileCallableHeaders,
			CompilerProfileDeclarationSkeletons,
			CompilerProfileImplementationHeaders,
			CompilerProfileIndexedGraph,
			CompilerProfileImportableModules,
			CompilerProfileResolvedTypeParameters,
			CompilerProfileTraitTopology,
			CompilerProfileTypeHeaders,
		),
		compiler_typecheck_phase_profile_execute,
		compiler_typecheck_phase_profile_observe,
		compiler_typecheck_phase_profile_plan,
		compiler_typecheck_phase_profile_stage_name,
	instrumentation: begin_function_profile_window, end_function_profile_window
	string: parse_int
	system: now_microseconds


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value > 0:
						value
					else:
						default
				None:
					default
		None:
			default


private pure func profile_stage_argument(text: String) -> Option[CompilerTypecheckProfileStage]:
	match text:
		"indexed":
			Some(CompilerProfileIndexedGraph)
		"importable":
			Some(CompilerProfileImportableModules)
		"bound":
			Some(CompilerProfileBoundModules)
		"skeleton":
			Some(CompilerProfileDeclarationSkeletons)
		"aliases":
			Some(CompilerProfileAliasDependencies)
		"parameters":
			Some(CompilerProfileResolvedTypeParameters)
		"headers":
			Some(CompilerProfileTypeHeaders)
		"topology":
			Some(CompilerProfileTraitTopology)
		"callables":
			Some(CompilerProfileCallableHeaders)
		"implementations":
			Some(CompilerProfileImplementationHeaders)
		"accepted":
			Some(CompilerProfileAcceptedGraph)
		_:
			None


private func run_phase_profile(args: List[String], stage: CompilerTypecheckProfileStage) -> Int:
	iterations = positive_argument(args, 2, 10)
	config: CompilerMixedTypeHeaderBenchmarkConfig = {
		iterations = 1,
		module_count = positive_argument(args, 3, 8),
		shapes_per_module = positive_argument(args, 4, 32),
		probes_per_module = positive_argument(args, 5, 64),
		import_fanout = positive_argument(args, 6, 4),
		retain_parsed_programs = True
	}
	setup_started = now_microseconds()
	fixture_result = compiler_mixed_type_header_phase_profile_fixture(config)
	setup_microseconds = now_microseconds() - setup_started

	match (fixture_result, compiler_typecheck_phase_profile_plan(stage, iterations)):
		(Err(errors), _):
			print("typecheck phase profile fixture failed: " + errors.join("; "))
			1
		(_, None):
			print("typecheck phase profile iterations must be positive")
			2
		(Ok(fixture), Some(plan)):
			started = now_microseconds()
			begin_function_profile_window()
			execution = compiler_typecheck_phase_profile_execute(fixture, plan)
			end_function_profile_window()
			window_elapsed_microseconds = now_microseconds() - started
			result = compiler_typecheck_phase_profile_observe(execution)

			match result:
				CompilerTypecheckPhaseProfileInvariantFailed(errors):
					print("typecheck phase profile invariant failed: " + errors.join("; "))
					1
				CompilerTypecheckPhaseProfileCompleted(observation):
					print(
						"TYPECHECK_PHASE_PROFILE" + " stage=" + compiler_typecheck_phase_profile_stage_name(
							observation.stage,
						) + " iterations=" + observation.iterations.to_string() + " modules=" + config.module_count.to_string() + " shapes_per_module=" + config.shapes_per_module.to_string() + " probes_per_module=" + config.probes_per_module.to_string() + " import_fanout=" + config.import_fanout.to_string() + " primary_outputs=" + observation.primary_output_count.to_string() + " secondary_outputs=" + observation.secondary_output_count.to_string() + " checksum=" + observation.checksum.to_string() + " setup_microseconds=" + setup_microseconds.to_string() + " window_elapsed_microseconds=" + window_elapsed_microseconds.to_string(),
					)
					0


private func print_usage() -> Int:
	print((
			"usage: compiler_typecheck_phase_profile indexed|importable|bound|skeleton|aliase"
			+ "s|parameters|headers|topology|callables|implementations|accepted [iterations] "
			+ "[modules] [shapes] [probes] [fanout]"
		))
	2


func main(args: List[String]) -> Int:
	match args.get(1):
		None:
			print_usage()
		Some(text):
			match profile_stage_argument(text):
				None:
					print_usage()
				Some(stage):
					run_phase_profile(args, stage)
