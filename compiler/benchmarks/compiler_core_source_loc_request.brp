import:
	../../blorp/src/compiler/stage_09_core/ir:
		CoreDecl(FunctionDecl),
		CoreExpr(SeqExpr, VoidExpr),
		CoreFunctionKind(UserFunction),
		CoreProgram,
		CoreSourceLoc(KnownSourceLoc),
		CoreType(VoidType),
		core_program_to_json,
	io: print
	json: JsonValue(JsonBool, JsonNumber, JsonObject, JsonString)


FUNCTION_COUNT: Int = 100

LOCATIONS_PER_FUNCTION: Int = 100


pure func source_loc(index: Int) -> CoreSourceLoc:
	KnownSourceLoc("source_loc_fixture.brp", index + 1, 1, index + 1, 2)


pure func fixture_body(start: Int) -> CoreExpr:
	var result: CoreExpr = VoidExpr(VoidType, source_loc(start + LOCATIONS_PER_FUNCTION))
	var index: Int = LOCATIONS_PER_FUNCTION - 1

	while index >= 0:
		result = SeqExpr(
			VoidExpr(VoidType, source_loc(start + index)),
			result,
		)
		index -= 1

	result


pure func fixture_program() -> CoreProgram:
	var decls: List[CoreDecl] = []
	var index: Int = 0

	while index < FUNCTION_COUNT:
		start: Int = index * LOCATIONS_PER_FUNCTION
		decls = decls.append(FunctionDecl({
			name = "source_loc_fixture_${index}",
			source_module = None,
			type_params = [],
			params = [],
			return_type = VoidType,
			body = Some(fixture_body(start)),
			is_pure = True,
			function_kind = UserFunction,
			def_id = index + 1,
			loc = source_loc(start + LOCATIONS_PER_FUNCTION + 1),
		}))
		index += 1

	{
		decls = decls,
		foreign_includes = []
	}


func main(args: List[String]) -> Int:
	request: JsonValue = JsonObject([
		("schema", JsonNumber(1.0)),
		("domain", JsonString("compiler")),
		("action", JsonString("emit_core_c")),
		("payload", JsonObject([
			("core", core_program_to_json(fixture_program())),
			("profile", JsonBool(False)),
		])),
	])
	print(request.to_string())
	0
