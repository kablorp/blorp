-- Fast source import-binding benchmark.
--
-- Positional controls: iterations, modules, and exports per module. Parsing
-- and module-surface construction are reported as setup time and excluded from
-- the measured import-registration loop.
import:
	compiler_module_binding_profile_fixture:
		CompilerModuleBindingBenchmarkConfig,
		compiler_module_binding_benchmark_execute,
		compiler_module_binding_benchmark_input,
		compiler_module_binding_benchmark_result,
	string: parse_int
	system: now_microseconds


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value > 0:
						value
					else:
						default
				None:
					default
		None:
			default


func main(args: List[String]) -> Int:
	config: CompilerModuleBindingBenchmarkConfig = {
		iterations = positive_argument(args, 1, 100),
		module_count = positive_argument(args, 2, 64),
		exports_per_module = positive_argument(args, 3, 16)
	}
	setup_started = now_microseconds()
	input = compiler_module_binding_benchmark_input(config)
	setup_microseconds = now_microseconds() - setup_started
	started = now_microseconds()
	execution = compiler_module_binding_benchmark_execute(input)
	elapsed_microseconds = now_microseconds() - started
	result = compiler_module_binding_benchmark_result(execution)
	print(
		"MODULE_BINDING_PROFILE_BENCH" + " iterations=" + config.iterations.to_string() + " modules=" + config.module_count.to_string() + " exports_per_module=" + config.exports_per_module.to_string() + " module_path_probes=" + result.module_path_probe_count.to_string() + " exact_path_probes=" + result.exact_path_probe_count.to_string() + " alternate_name_probes=" + result.alternate_name_probe_count.to_string() + " baseline_alternate_candidate_pressure=" + result.baseline_alternate_name_candidate_pressure.to_string() + " baseline_surface_symbol_comparison_pressure=" + result.baseline_surface_symbol_comparison_pressure.to_string() + " baseline_import_binding_comparison_pressure=" + result.baseline_import_binding_comparison_pressure.to_string() + " exported_symbols=" + result.exported_symbol_count.to_string() + " module_aliases=" + result.module_alias_count.to_string() + " imported_names=" + result.imported_name_count.to_string() + " import_bindings=" + result.import_binding_count.to_string() + " errors=" + result.error_count.to_string() + " workload_valid=" + result.workload_valid.to_string() + " checksum=" + result.checksum.to_string() + " setup_microseconds=" + setup_microseconds.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string(),
	)

	if result.error_count == 0 and result.workload_valid:
		0
	else:
		1
