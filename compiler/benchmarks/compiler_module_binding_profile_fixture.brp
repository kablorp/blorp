-- Deterministic workload for timing source import binding in isolation.
-- Parsing and module-surface construction belong to setup. The measured loop
-- calls the same graph-aware import registrar used by production typechecking.
import:
	../../blorp/src/compiler/stage_01_file_io/source: source_file
	../../blorp/src/compiler/stage_03_parse/language_parser: parse_compiler_source
	../../blorp/src/compiler/stage_03_parse/parsed_ast: ParsedProgram
	../../blorp/src/compiler/stage_03_parse/source_ast_finalize: finalize_typecheck_source_program
	../../blorp/src/compiler/stage_04_modules/loaded_module: ModuleOrigin(UserModule)
	../../blorp/src/compiler/stage_04_modules/module_surface: module_surface_for_program
	../../blorp/src/compiler/stage_06_typecheck/modules/module_binding:
		ImportableModuleSurface,
		importable_module_surface,
		register_program_imports,
	../../blorp/src/compiler/stage_06_typecheck/modules/module_view:
		module_view_import_bindings,
		module_view_imported_names,
		module_view_module_aliases,
	../../blorp/src/compiler/stage_06_typecheck/state:
		TYPECHECK_USER_ORIGIN,
		TypecheckState,
		typecheck_state_find_imported_name,
		typecheck_state_find_module_alias,
		typecheck_state_for_origin,
		typecheck_state_has_qualified_module_binding,
		typecheck_state_has_selective_definition_binding,


struct CompilerModuleBindingBenchmarkConfig {
	iterations: Int,
	module_count: Int,
	exports_per_module: Int
}


private record ModuleBindingBenchmarkInputRep {
	config: CompilerModuleBindingBenchmarkConfig,
	program: ParsedProgram,
	modules: List[ImportableModuleSurface]
}


opaque type CompilerModuleBindingBenchmarkInput = ModuleBindingBenchmarkInputRep


private record ModuleBindingRunRep {
	input: CompilerModuleBindingBenchmarkInput,
	last_state: TypecheckState,
	error_count: Int,
	checksum: Int,
	workload_counts_valid: Bool
}


opaque type CompilerModuleBindingBenchmarkExecution = ModuleBindingRunRep


record CompilerModuleBindingBenchmarkResult {
	module_path_probe_count: Int,
	exact_path_probe_count: Int,
	alternate_name_probe_count: Int,
	baseline_alternate_name_candidate_pressure: Int,
	baseline_surface_symbol_comparison_pressure: Int,
	baseline_import_binding_comparison_pressure: Int,
	exported_symbol_count: Int,
	module_alias_count: Int,
	imported_name_count: Int,
	import_binding_count: Int,
	error_count: Int,
	checksum: Int,
	workload_valid: Bool
}


private pure func benchmark_module_path(module_index: Int) -> String:
	"bench/module_binding_" + module_index.to_string()


private pure func benchmark_alternate_module_name(module_index: Int) -> String:
	"bench/module_binding_alias_" + module_index.to_string()


private pure func benchmark_export_name(module_index: Int, export_index: Int) -> String:
	"module_binding_" + module_index.to_string() + "_export_" + export_index.to_string()


private pure func benchmark_module_alias(module_index: Int) -> String:
	"Module" + module_index.to_string()


private pure func benchmark_selected_name(module_index: Int) -> String:
	"selected_module_binding_" + module_index.to_string()


private pure func benchmark_program(module_name: String, source: String) -> ParsedProgram:
	finalize_typecheck_source_program(
		parse_compiler_source(source_file("/" + module_name + ".brp", module_name, source)),
	)


private pure func benchmark_module_source(module_index: Int, exports_per_module: Int) -> String:
	var declarations: List[String] = []

	for export_index in 0..exports_per_module:
		declarations = declarations.append(
			"pure func " + benchmark_export_name(
				module_index,
				export_index,
			) + "(value: Int) -> Int:\n\tvalue",
		)

	declarations.join("\n\n") + "\n"


private pure func benchmark_import_path(module_index: Int) -> String:
	if module_index % 2 == 0:
		benchmark_module_path(module_index)
	else:
		benchmark_alternate_module_name(module_index)


private pure func benchmark_target_source(module_count: Int, exports_per_module: Int) -> String:
	var imports: List[String] = []
	selected_export_index: Int = exports_per_module - 1

	for module_index in 0..module_count:
		imports = imports.append(
			"\t" + benchmark_import_path(
				module_index,
			) + " as " + benchmark_module_alias(
				module_index,
			) + ":\n\t\t" + benchmark_export_name(
				module_index,
				selected_export_index,
			) + " as " + benchmark_selected_name(module_index),
		)

	"import:\n" + imports.join("\n") + "\n\nfunc main(args: List[String]) -> Int:\n\t0\n"


pure func compiler_module_binding_benchmark_input(
	config: CompilerModuleBindingBenchmarkConfig,
) -> CompilerModuleBindingBenchmarkInput:
	var modules: List[ImportableModuleSurface] = []

	for module_index in 0..config.module_count:
		canonical_path = benchmark_module_path(module_index)
		module_name = benchmark_alternate_module_name(module_index)
		program = benchmark_program(
			module_name,
			benchmark_module_source(module_index, config.exports_per_module),
		)
		modules = modules.append(
			importable_module_surface(
				canonical_path,
				UserModule,
				module_surface_for_program(program),
			),
		)

	representation: ModuleBindingBenchmarkInputRep = {
		config = config,
		program = benchmark_program(
			"bench/module_binding_main",
			benchmark_target_source(config.module_count, config.exports_per_module),
		),
		modules = modules
	}
	into CompilerModuleBindingBenchmarkInput(representation)


private pure func compiler_module_binding_state_matches(
	state: TypecheckState,
	module_count: Int,
	exports_per_module: Int,
) -> Bool:
	var matches: Bool = True
	imported_names = module_view_imported_names(state.module_view)
	selected_export_index: Int = exports_per_module - 1
	var module_index: Int = 0

	while matches and module_index < module_count:
		canonical_path = benchmark_module_path(module_index)
		selected_name = benchmark_selected_name(module_index)
		original_name = benchmark_export_name(module_index, selected_export_index)
		module_alias = benchmark_module_alias(module_index)
		ordered_imported_name = imported_names.get(module_index)
		indexed_imported_name = typecheck_state_find_imported_name(state, selected_name)

		matches = match (ordered_imported_name, indexed_imported_name):
			(Some(ordered), Some(indexed)):
				(
					ordered.local_name == selected_name
					and ordered.module_path == canonical_path
					and ordered.original_name == original_name
					and indexed == ordered
					and typecheck_state_find_module_alias(
						state,
						module_alias,
					) == Some(canonical_path)
					and typecheck_state_has_selective_definition_binding(
						state,
						selected_name,
						canonical_path,
						original_name,
					)
					and typecheck_state_has_qualified_module_binding(
						state,
						module_alias,
						canonical_path,
					)
				)
			_:
				False

		module_index += 1

	matches


pure func compiler_module_binding_benchmark_execute(
	input: CompilerModuleBindingBenchmarkInput,
) -> CompilerModuleBindingBenchmarkExecution:
	representation: ModuleBindingBenchmarkInputRep = from CompilerModuleBindingBenchmarkInput(input)
	config = representation.config
	module_path_probe_count: Int = config.module_count
	expected_exact_path_probes: Int = (config.module_count + 1) / 2
	expected_alternate_name_probes: Int = config.module_count / 2
	expected_exported_symbols: Int = config.module_count * config.exports_per_module
	expected_import_bindings: Int = config.module_count * 2
	baseline_alternate_name_candidate_pressure: Int = expected_alternate_name_probes * config.module_count

	baseline_surface_symbol_comparison_pressure: Int = config.module_count * config.exports_per_module
	baseline_import_binding_comparison_pressure: Int = expected_import_bindings * (expected_import_bindings - 1) / 2

	var module_alias_count: Int = 0
	var imported_name_count: Int = 0
	var import_binding_count: Int = 0
	var error_count: Int = 0
	var checksum: Int = 0
	var last_state: TypecheckState = typecheck_state_for_origin(TYPECHECK_USER_ORIGIN)
	var workload_valid: Bool = (
		config.iterations > 0
		and config.module_count > 0
		and config.exports_per_module > 0
	)

	for _ in 0..config.iterations:
		state = register_program_imports(
			typecheck_state_for_origin(TYPECHECK_USER_ORIGIN),
			representation.modules,
			representation.program,
		)
		last_state = state
		module_alias_count = module_view_module_aliases(state.module_view).length()
		imported_name_count = module_view_imported_names(state.module_view).length()
		import_binding_count = module_view_import_bindings(state.module_view).length()
		iteration_error_count = state.errors.length()
		error_count += iteration_error_count
		iteration_checksum = module_path_probe_count + expected_exact_path_probes + expected_alternate_name_probes + baseline_alternate_name_candidate_pressure + baseline_surface_symbol_comparison_pressure + baseline_import_binding_comparison_pressure + expected_exported_symbols + module_alias_count + imported_name_count + import_binding_count

		checksum += iteration_checksum
		workload_valid = (
			workload_valid
			and iteration_error_count == 0
			and module_alias_count == config.module_count
			and imported_name_count == config.module_count
			and import_binding_count == expected_import_bindings
		)

	run: ModuleBindingRunRep = {
		input = input,
		last_state = last_state,
		error_count = error_count,
		checksum = checksum,
		workload_counts_valid = workload_valid
	}
	into CompilerModuleBindingBenchmarkExecution(run)


pure func compiler_module_binding_benchmark_result(
	execution: CompilerModuleBindingBenchmarkExecution,
) -> CompilerModuleBindingBenchmarkResult:
	run: ModuleBindingRunRep = from CompilerModuleBindingBenchmarkExecution(execution)
	input: ModuleBindingBenchmarkInputRep = from CompilerModuleBindingBenchmarkInput(run.input)
	config = input.config
	module_path_probe_count: Int = config.module_count
	expected_exact_path_probes: Int = (config.module_count + 1) / 2
	expected_alternate_name_probes: Int = config.module_count / 2
	expected_exported_symbols: Int = config.module_count * config.exports_per_module
	expected_import_bindings: Int = config.module_count * 2
	baseline_alternate_name_candidate_pressure: Int = expected_alternate_name_probes * config.module_count
	baseline_surface_symbol_comparison_pressure: Int = config.module_count * config.exports_per_module
	baseline_import_binding_comparison_pressure: Int = expected_import_bindings * (expected_import_bindings - 1) / 2

	state = run.last_state
	module_alias_count: Int = module_view_module_aliases(state.module_view).length()
	imported_name_count: Int = module_view_imported_names(state.module_view).length()
	import_binding_count: Int = module_view_import_bindings(state.module_view).length()
	workload_valid = (
		run.workload_counts_valid
		and compiler_module_binding_state_matches(
			state,
			config.module_count,
			config.exports_per_module,
		)
	)

	{
		module_path_probe_count = module_path_probe_count,
		exact_path_probe_count = expected_exact_path_probes,
		alternate_name_probe_count = expected_alternate_name_probes,
		baseline_alternate_name_candidate_pressure = baseline_alternate_name_candidate_pressure,
		baseline_surface_symbol_comparison_pressure = baseline_surface_symbol_comparison_pressure,
		baseline_import_binding_comparison_pressure = baseline_import_binding_comparison_pressure,
		exported_symbol_count = expected_exported_symbols,
		module_alias_count = module_alias_count,
		imported_name_count = imported_name_count,
		import_binding_count = import_binding_count,
		error_count = run.error_count,
		checksum = run.checksum,
		workload_valid = workload_valid
	}


pure func compiler_module_binding_benchmark(
	config: CompilerModuleBindingBenchmarkConfig,
) -> CompilerModuleBindingBenchmarkResult:
	input = compiler_module_binding_benchmark_input(config)
	execution = compiler_module_binding_benchmark_execute(input)
	compiler_module_binding_benchmark_result(execution)
