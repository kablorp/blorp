-- Measure accepted-module declaration preparation using the production path.
--
-- Usage:
--   benchmarks/compiler_frontend_declaration_catalog_profile dense 1 64 16 16 0
-- Args: graph-shape iterations modules declarations/module import-fanout body-count
import:
	compiler_frontend_declaration_catalog_profile_fixture:
		CompilerFrontendDeclarationCatalogProfileConfig,
		FrontendDeclarationCatalogGraphShape(
			FrontendCatalogChainGraph,
			FrontendCatalogDenseGraph,
			FrontendCatalogLayeredGraph,
			FrontendCatalogStarGraph,
		),
		compiler_frontend_declaration_catalog_profile_fixture,
		compiler_frontend_declaration_catalog_profile_with_fixture,
		frontend_declaration_catalog_graph_shape_name,
	compiler_typecheck_phase_profile_fixture: CompilerTypecheckPhaseProfileFixture
	memory: get_mem_stats, reset_mem_stats
	string: parse_int
	system: now_microseconds


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value > 0:
						value
					else:
						default
				None:
					default
		None:
			default


private pure func nonnegative_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value >= 0:
						value
					else:
						default
				None:
					default
		None:
			default


private pure func shape_argument(text: String) -> Option[FrontendDeclarationCatalogGraphShape]:
	match text:
		"chain":
			Some(FrontendCatalogChainGraph)
		"star":
			Some(FrontendCatalogStarGraph)
		"layered":
			Some(FrontendCatalogLayeredGraph)
		"dense":
			Some(FrontendCatalogDenseGraph)
		_:
			None


private func run_profile(args: List[String], shape: FrontendDeclarationCatalogGraphShape) -> Int:
	config: CompilerFrontendDeclarationCatalogProfileConfig = {
		iterations = positive_argument(args, 2, 1),
		module_count = positive_argument(args, 3, 8),
		declarations_per_module = positive_argument(args, 4, 16),
		import_fanout = positive_argument(args, 5, 4),
		graph_shape = shape,
		body_count_per_module = nonnegative_argument(args, 6, 0),
		ctfe_body_selection = False
	}

	setup_started = now_microseconds()
	-- Fixture construction validates the accepted graph but is excluded from
	-- the declaration-preparation measurement window.
	fixture_result = compiler_frontend_declaration_catalog_profile_fixture(config)
	setup_microseconds = now_microseconds() - setup_started

	match fixture_result:
		Err(errors):
			print(
				"FRONTEND_DECLARATION_CATALOG_PROFILE" + " shape=" + frontend_declaration_catalog_graph_shape_name(
					shape,
				) + " evidence=semantic_graph_preparation" + " iterations=" + config.iterations.to_string() + " modules=" + config.module_count.to_string() + " declarations_per_module=" + config.declarations_per_module.to_string() + " import_fanout=" + config.import_fanout.to_string() + " body_count_per_module=" + config.body_count_per_module.to_string() + " setup_error_count=" + errors
					.length()
					.to_string() + " workload_valid=false",
			)
			1
		Ok(fixture):
			run_profile_fixture(config, shape, fixture, setup_microseconds)


private func run_profile_fixture(
	config: CompilerFrontendDeclarationCatalogProfileConfig,
	shape: FrontendDeclarationCatalogGraphShape,
	fixture: CompilerTypecheckPhaseProfileFixture,
	setup_microseconds: Int,
) -> Int:
	reset_mem_stats()
	started = now_microseconds()
	result = compiler_frontend_declaration_catalog_profile_with_fixture(config, fixture)
	elapsed_microseconds = now_microseconds() - started
	stats = get_mem_stats()
	canonical = result.canonical_observation
	initializer = result.initializer_observation
	ctfe_artifact = result.ctfe_artifact_observation
	representation = result.representation_model

	print(
		"FRONTEND_DECLARATION_CATALOG_PROFILE" + " shape=" + frontend_declaration_catalog_graph_shape_name(
			shape,
		) + " evidence=semantic_graph_preparation" + " iterations=" + config.iterations.to_string() + " modules=" + config.module_count.to_string() + " declarations_per_module=" + config.declarations_per_module.to_string() + " import_fanout=" + config.import_fanout.to_string() + " body_count_per_module=" + config.body_count_per_module.to_string() + " accepted_modules_prepared=" + canonical.accepted_modules_prepared.to_string() + " unique_graph_declarations=" + canonical.unique_graph_declarations.to_string() + " unique_type_declarations=" + canonical.unique_type_declarations.to_string() + " unique_constructors=" + canonical.unique_constructors.to_string() + " unique_callables=" + canonical.unique_callables.to_string() + " unique_globals=" + canonical.unique_globals.to_string() + " global_header_installations=" + canonical.global_header_installations.to_string() + " unique_traits=" + canonical.unique_traits.to_string() + " unique_implementations=" + canonical.unique_implementations.to_string() + " visible_module_edges=" + canonical.visible_module_edges.to_string() + " direct_module_edges=" + canonical.direct_module_edges.to_string() + " total_graph_declaration_installation_attempts=" + canonical.total_graph_declaration_installations.to_string() + " duplicate_installation_factor_millis=" + canonical.duplicate_installation_factor_millis.to_string() + " setup_error_count=" + result.setup_error_count.to_string() + " error_count=" + canonical.error_count.to_string() + " checksum=" + canonical.checksum.to_string() + " setup_microseconds=" + setup_microseconds.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string() + " total_allocations=" + stats.total_allocations.to_string() + " total_releases=" + stats.total_releases.to_string() + " retained_objects=" + stats.current_objects.to_string() + " allocated_bytes=" + stats.bytes_allocated.to_string() + " workload_valid=" + result.workload_valid.to_string(),
	)
	print(
		"FRONTEND_DECLARATION_CATALOG_PROFILE" + " shape=" + frontend_declaration_catalog_graph_shape_name(
			shape,
		) + " evidence=semantic_initializer_preparation" + " accepted_modules_prepared=" + initializer.accepted_modules_prepared.to_string() + " unique_graph_declarations=" + initializer.unique_graph_declarations.to_string() + " unique_type_declarations=" + initializer.unique_type_declarations.to_string() + " unique_constructors=" + initializer.unique_constructors.to_string() + " unique_callables=" + initializer.unique_callables.to_string() + " unique_globals=" + initializer.unique_globals.to_string() + " global_header_installations=" + initializer.global_header_installations.to_string() + " unique_traits=" + initializer.unique_traits.to_string() + " unique_implementations=" + initializer.unique_implementations.to_string() + " visible_module_edges=" + initializer.visible_module_edges.to_string() + " direct_module_edges=" + initializer.direct_module_edges.to_string() + " total_graph_declaration_installation_attempts=" + initializer.total_graph_declaration_installations.to_string() + " error_count=" + initializer.error_count.to_string() + " checksum=" + initializer.checksum.to_string() + " workload_valid=" + result.workload_valid.to_string(),
	)
	print(
		"FRONTEND_DECLARATION_CATALOG_PROFILE" + " shape=" + frontend_declaration_catalog_graph_shape_name(
			shape,
		) + " evidence=semantic_ctfe_artifact_preparation" + " accepted_modules_prepared=" + ctfe_artifact.accepted_modules_prepared.to_string() + " unique_graph_declarations=" + ctfe_artifact.unique_graph_declarations.to_string() + " unique_type_declarations=" + ctfe_artifact.unique_type_declarations.to_string() + " unique_constructors=" + ctfe_artifact.unique_constructors.to_string() + " unique_callables=" + ctfe_artifact.unique_callables.to_string() + " unique_globals=" + ctfe_artifact.unique_globals.to_string() + " global_header_installations=" + ctfe_artifact.global_header_installations.to_string() + " unique_traits=" + ctfe_artifact.unique_traits.to_string() + " unique_implementations=" + ctfe_artifact.unique_implementations.to_string() + " visible_module_edges=" + ctfe_artifact.visible_module_edges.to_string() + " direct_module_edges=" + ctfe_artifact.direct_module_edges.to_string() + " total_graph_declaration_installation_attempts=" + ctfe_artifact.total_graph_declaration_installations.to_string() + " error_count=" + ctfe_artifact.error_count.to_string() + " checksum=" + ctfe_artifact.checksum.to_string() + " workload_valid=" + result.workload_valid.to_string(),
	)
	print(
		"FRONTEND_DECLARATION_CATALOG_PROFILE" + " shape=" + frontend_declaration_catalog_graph_shape_name(
			shape,
		) + " evidence=modeled_representation_direct_api" + " expected_scope_update_windows=" + representation.expected_scope_update_windows.to_string() + " expected_symbols_appended=" + representation.expected_symbols_appended.to_string() + " expected_env_values_published=" + representation.expected_env_values_published.to_string() + " expected_index_entries=" + representation.expected_index_entries.to_string() + " expected_auxiliary_publications=" + representation.expected_auxiliary_publications.to_string() + " semantic_checksum=" + representation.semantic_checksum.to_string() + " workload_valid=" + representation.workload_valid.to_string(),
	)

	if result.workload_valid:
		0
	else:
		1


private func print_usage() -> Int:
	print((
			"usage: compiler_frontend_declaration_catalog_profile chain|star|layered|dense "
			+ "[iterations] [modules] [declarations-per-module] [import-fanout] [body-count]"
		))
	2


func main(args: List[String]) -> Int:
	match args.get(1):
		None:
			print_usage()
		Some(text):
			match shape_argument(text):
				None:
					print_usage()
				Some(shape):
					run_profile(args, shape)
