-- Isolated profile for Core UFCS module-prefix reuse.
--
-- Usage:
--   bin/blorp run --profile compiler/benchmarks/compiler_core_ufcs_name_profile.brp -- 10 1 4096
--   bin/blorp run compiler/benchmarks/compiler_core_ufcs_name_profile.brp -- 10 16 4096
import:
	compiler_core_ufcs_name_profile_fixture:
		CompilerCoreUfcsNameProfileConfig,
		compiler_core_ufcs_name_profile_baseline_execute,
		compiler_core_ufcs_name_profile_execute,
		compiler_core_ufcs_name_profile_fixture,
	instrumentation: begin_function_profile_window, end_function_profile_window
	memory: get_mem_stats, reset_mem_stats
	string: parse_int
	system: now_microseconds


private DEFAULT_ITERATIONS: Int = 10

private DEFAULT_MODULE_COUNT: Int = 1

private DEFAULT_NAMES_PER_MODULE: Int = 4096


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value > 0:
						value
					else:
						default
				None:
					default
		None:
			default


func main(args: List[String]) -> Int:
	config: CompilerCoreUfcsNameProfileConfig = {
		iterations = positive_argument(args, 1, DEFAULT_ITERATIONS),
		module_count = positive_argument(args, 2, DEFAULT_MODULE_COUNT),
		names_per_module = positive_argument(args, 3, DEFAULT_NAMES_PER_MODULE)
	}
	fixture = compiler_core_ufcs_name_profile_fixture(config)
	baseline_warmup = compiler_core_ufcs_name_profile_baseline_execute(fixture)
	optimized_warmup = compiler_core_ufcs_name_profile_execute(fixture)

	reset_mem_stats()
	baseline_started: Int = now_microseconds()
	baseline = compiler_core_ufcs_name_profile_baseline_execute(fixture)
	baseline_elapsed_microseconds: Int = now_microseconds() - baseline_started
	baseline_memory = get_mem_stats()

	reset_mem_stats()
	begin_function_profile_window()
	optimized_started: Int = now_microseconds()
	optimized = compiler_core_ufcs_name_profile_execute(fixture)
	optimized_elapsed_microseconds: Int = now_microseconds() - optimized_started
	end_function_profile_window()
	optimized_memory = get_mem_stats()
	workload_valid: Bool = (
		baseline.workload_valid
		and optimized.workload_valid
		and baseline_warmup.output_checksum == baseline.output_checksum
		and optimized_warmup.output_checksum == optimized.output_checksum
		and baseline.output_checksum == optimized.output_checksum
		and baseline.total_output_bytes == optimized.total_output_bytes
	)

	print(
		"CORE_UFCS_NAME_PROFILE" + " iterations=" + config.iterations.to_string() + " modules=" + config.module_count.to_string() + " names_per_module=" + config.names_per_module.to_string() + " baseline_module_prefix_constructions=" + baseline.module_prefix_construction_count.to_string() + " optimized_module_prefix_constructions=" + optimized.module_prefix_construction_count.to_string() + " full_name_constructions=" + optimized.full_name_construction_count.to_string() + " total_output_bytes=" + optimized.total_output_bytes.to_string() + " output_checksum=" + optimized.output_checksum.to_string() + " baseline_elapsed_microseconds=" + baseline_elapsed_microseconds.to_string() + " optimized_elapsed_microseconds=" + optimized_elapsed_microseconds.to_string() + " baseline_total_allocations=" + baseline_memory.total_allocations.to_string() + " optimized_total_allocations=" + optimized_memory.total_allocations.to_string() + " baseline_total_releases=" + baseline_memory.total_releases.to_string() + " optimized_total_releases=" + optimized_memory.total_releases.to_string() + " baseline_retained_objects=" + baseline_memory.current_objects.to_string() + " optimized_retained_objects=" + optimized_memory.current_objects.to_string() + " baseline_allocated_bytes=" + baseline_memory.bytes_allocated.to_string() + " optimized_allocated_bytes=" + optimized_memory.bytes_allocated.to_string() + " workload_valid=" + workload_valid.to_string(),
	)

	if workload_valid:
		0
	else:
		1
