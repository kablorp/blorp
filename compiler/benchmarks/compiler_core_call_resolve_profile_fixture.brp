-- Deterministic workload for Core call-resolution environment construction.
-- Fixture creation is intentionally separate from execution so profile windows
-- measure the same private builder used by production resolve_core_program.
import:
	../src/stage_08_core_lower/identity: core_module_member_name
	../src/stage_09_core/ir:
		CoreCallKind(BuiltinCall),
		CoreDecl(EnumDecl, FunctionDecl, GlobalDecl, ImplDecl, UnionDecl),
		CoreEnumVariant,
		CoreExpr(CallExpr, LiteralExpr, VarExpr),
		CoreForeignArgPassing(ForeignBorrowArgs),
		CoreFunction,
		CoreFunctionKind(BuiltinFunction, ForeignFunction, UnresolvedBuiltinFunction, UserFunction),
		CoreLiteral(IntLiteral),
		CoreParam,
		CoreProgram,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType, TypeParameterType),
		CoreUnionPayloadStorage(TypedUnionPayloadStorage),
		CoreUnionVariant,
		CoreVar,
	../src/stage_09_core/resolve:
		CoreCallResolveEnvObservation,
		CoreResolveImportBinding(CoreQualifiedModuleImport, CoreSelectiveDefinitionImport),
		CoreResolveModuleImports,
		observe_core_call_resolve_env,


private BENCHMARK_FUNCTION_DEF_ID_BASE: Int = 100000

private BENCHMARK_GLOBAL_DEF_ID_BASE: Int = 200000

private BENCHMARK_CONSTRUCTOR_DEF_ID_BASE: Int = 300000

private BENCHMARK_SPECIAL_DEF_ID_BASE: Int = 400000


struct CompilerCoreCallResolveProfileConfig {
	iterations: Int,
	function_count: Int,
	module_count: Int,
	constructors_per_type: Int,
	duplicate_id_interval: Int,
	imports_per_module: Int
}


record CompilerCoreCallResolveBenchmarkInput {
	config: CompilerCoreCallResolveProfileConfig,
	program: CoreProgram,
	import_bindings: List[CoreResolveImportBinding],
	module_imports: List[CoreResolveModuleImports],
	expected_declaration_count: Int,
	expected_user_function_count: Int,
	expected_user_function_by_id_count: Int,
	expected_colliding_user_function_id_count: Int,
	expected_module_function_count: Int,
	expected_global_type_count: Int,
	expected_foreign_function_count: Int,
	expected_builtin_function_count: Int,
	expected_constructor_name_count: Int,
	expected_constructor_target_count: Int,
	expected_import_binding_count: Int,
	expected_module_import_count: Int,
	expected_module_import_binding_count: Int,
	expected_module_path_count: Int,
	module_path_membership_check_count: Int
}


record CompilerCoreCallResolveBenchmarkResult {
	observation: CoreCallResolveEnvObservation,
	declaration_count: Int,
	module_path_membership_check_count: Int,
	error_count: Int,
	checksum: Int,
	workload_valid: Bool
}


private pure func int_type() -> CoreType:
	NamedType("Int", [])


private pure func benchmark_module_count(config: CompilerCoreCallResolveProfileConfig) -> Int:
	if config.module_count > 0:
		config.module_count
	else:
		1


private pure func benchmark_module_path(module_index: Int) -> String:
	"bench/core_call_resolve_${module_index}"


private pure func benchmark_import_module_path(module_index: Int, import_index: Int) -> String:
	"bench/core_call_resolve_import_${module_index}_${import_index}"


private pure func benchmark_function_source_name(function_index: Int) -> String:
	"call_resolve_function_${function_index}"


private pure func benchmark_function_name(function_index: Int, module_count: Int) -> String:
	module_index: Int = function_index % module_count
	core_module_member_name(
		benchmark_module_path(module_index),
		benchmark_function_source_name(function_index),
	)


private pure func benchmark_function_def_id(function_index: Int, duplicate_id_interval: Int) -> Int:
	if (
		duplicate_id_interval > 0
		and function_index > 0
		and function_index % duplicate_id_interval == 0
	):
		BENCHMARK_FUNCTION_DEF_ID_BASE + function_index - 1
	else:
		BENCHMARK_FUNCTION_DEF_ID_BASE + function_index


private pure func benchmark_var(name: String, def_id: Option[Int]) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = def_id
	}


private pure func benchmark_param(name: String) -> CoreParam:
	{
		name = benchmark_var(name, None),
		typ = int_type(),
		loc = SyntheticSourceLoc
	}


private pure func benchmark_int_literal(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), int_type(), SyntheticSourceLoc)


private pure func benchmark_runtime_forward(runtime_name: String) -> CoreExpr:
	CallExpr(
		BuiltinCall(runtime_name),
		VarExpr(
			benchmark_var(runtime_name, None),
			int_type(),
			SyntheticSourceLoc,
		),
		[],
		int_type(),
		SyntheticSourceLoc,
	)


private pure func benchmark_function(
	name: String,
	source_module: Option[String],
	def_id: Int,
	body: Option[CoreExpr],
	function_kind: CoreFunctionKind,
) -> CoreFunction:
	{
		name = name,
		source_module = source_module,
		type_params = [],
		params = [benchmark_param("value")],
		return_type = int_type(),
		body = body,
		is_pure = True,
		function_kind = function_kind,
		def_id = def_id,
		loc = SyntheticSourceLoc
	}


private pure func benchmark_module_function_decl(
	function_index: Int,
	module_count: Int,
	duplicate_id_interval: Int,
) -> CoreDecl:
	module_path: String = benchmark_module_path(function_index % module_count)
	FunctionDecl(
		benchmark_function(
			benchmark_function_name(function_index, module_count),
			Some(module_path),
			benchmark_function_def_id(function_index, duplicate_id_interval),
			Some(benchmark_int_literal(function_index)),
			UserFunction,
		),
	)


private pure func benchmark_plain_function_decl() -> CoreDecl:
	FunctionDecl(
		benchmark_function(
			"call_resolve_plain",
			None,
			BENCHMARK_SPECIAL_DEF_ID_BASE,
			Some(benchmark_int_literal(1)),
			UserFunction,
		),
	)


private pure func benchmark_shadow_function_decl(ordinal: Int) -> CoreDecl:
	FunctionDecl(
		benchmark_function(
			"call_resolve_shadow",
			None,
			BENCHMARK_SPECIAL_DEF_ID_BASE + ordinal + 1,
			Some(benchmark_int_literal(ordinal)),
			UserFunction,
		),
	)


private pure func benchmark_first_foreign_function_decl() -> CoreDecl:
	FunctionDecl(benchmark_function(
		"call_resolve_first_foreign",
		None,
		BENCHMARK_SPECIAL_DEF_ID_BASE + 10,
		None,
		ForeignFunction({
			c_name = "blorp_call_resolve_first_foreign",
			includes = [],
			link_flags = [],
			arg_passing = ForeignBorrowArgs,
		}),
	))


private pure func benchmark_borrow_foreign_function_decl() -> CoreDecl:
	FunctionDecl(benchmark_function(
		"call_resolve_borrow_foreign",
		None,
		BENCHMARK_SPECIAL_DEF_ID_BASE + 14,
		None,
		ForeignFunction({
			c_name = "blorp_call_resolve_borrow_foreign",
			includes = [],
			link_flags = [],
			arg_passing = ForeignBorrowArgs,
		}),
	))


private pure func benchmark_builtin_function_decl() -> CoreDecl:
	FunctionDecl(
		benchmark_function(
			"call_resolve_builtin",
			None,
			BENCHMARK_SPECIAL_DEF_ID_BASE + 11,
			None,
			BuiltinFunction("blorp_call_resolve_builtin"),
		),
	)


private pure func benchmark_module_builtin_function_decl() -> CoreDecl:
	FunctionDecl(
		benchmark_function(
			core_module_member_name("std/list", "list"),
			Some("std/list"),
			BENCHMARK_SPECIAL_DEF_ID_BASE + 12,
			None,
			UnresolvedBuiltinFunction,
		),
	)


private pure func benchmark_materialized_builtin_forward_decl() -> CoreDecl:
	FunctionDecl(
		benchmark_function(
			core_module_member_name("std/string", "upper"),
			Some("std/string"),
			BENCHMARK_SPECIAL_DEF_ID_BASE + 13,
			Some(benchmark_runtime_forward("blorp_upper")),
			UserFunction,
		),
	)


private pure func benchmark_global_decl(module_index: Int) -> CoreDecl:
	module_path: String = benchmark_module_path(module_index)
	GlobalDecl({
		name = benchmark_var(
			core_module_member_name(module_path, "GLOBAL_${module_index}"),
			None,
		),
		source_module = Some(module_path),
		typ = int_type(),
		init = benchmark_int_literal(module_index),
		is_mutable = False,
		is_const = True,
		is_private = False,
		def_id = BENCHMARK_GLOBAL_DEF_ID_BASE + module_index,
		loc = SyntheticSourceLoc,
	})


private pure func benchmark_enum_decl(constructors_per_type: Int) -> CoreDecl:
	var variants: List[CoreEnumVariant] = []

	for constructor_index in 0..constructors_per_type:
		variants = variants.append({
			name = "SharedCallResolveCtor_${constructor_index}",
			c_name = "SharedCallResolveCtor_${constructor_index}",
			tag = constructor_index,
			def_id = Some(BENCHMARK_CONSTRUCTOR_DEF_ID_BASE + constructor_index),
		})

	EnumDecl({
		abi_type = None,
		name = "CallResolveEnum",
		type_params = [],
		variants = variants,
		loc = SyntheticSourceLoc,
	})


private pure func benchmark_union_decl(constructors_per_type: Int) -> CoreDecl:
	var variants: List[CoreUnionVariant] = []

	for constructor_index in 0..constructors_per_type:
		variants = variants.append({
			name = "SharedCallResolveCtor_${constructor_index}",
			c_name = "SharedCallResolveCtor_${constructor_index}",
			tag_c_name = "SharedCallResolveCtor_${constructor_index}_TAG",
			tag = constructor_index,
			fields = [],
			def_id = Some(
				BENCHMARK_CONSTRUCTOR_DEF_ID_BASE + constructors_per_type + constructor_index,
			),
		})

	UnionDecl({
		abi_type = None,
		name = "CallResolveUnion",
		type_params = [],
		payload_storage = TypedUnionPayloadStorage,
		variants = variants,
		loc = SyntheticSourceLoc,
	})


private pure func benchmark_impl_method(name: String, def_id: Int) -> CoreFunction:
	benchmark_function(name, None, def_id, Some(benchmark_int_literal(def_id)), UserFunction)


private pure func benchmark_concrete_impl_decl() -> CoreDecl:
	ImplDecl({
		trait_name = "Display",
		for_type = int_type(),
		type_params = [],
		methods = [benchmark_impl_method("display", BENCHMARK_SPECIAL_DEF_ID_BASE + 20)],
		loc = SyntheticSourceLoc,
	})


private pure func benchmark_unresolved_generic_impl_decl() -> CoreDecl:
	ImplDecl({
		trait_name = "Display",
		for_type = NamedType("List", [TypeParameterType("T")]),
		type_params = [
			{
				name = "T",
				bounds = []
			},
		],
		methods = [benchmark_impl_method("display", BENCHMARK_SPECIAL_DEF_ID_BASE + 21)],
		loc = SyntheticSourceLoc,
	})


private pure func benchmark_import_binding(
	module_index: Int,
	import_index: Int,
) -> CoreResolveImportBinding:
	local_name: String = "Imported${module_index}_${import_index}"
	module_path: String = benchmark_import_module_path(module_index, import_index)

	if import_index % 2 == 0:
		CoreSelectiveDefinitionImport(local_name, module_path, "source_${import_index}")
	else:
		CoreQualifiedModuleImport(local_name, module_path)


private pure func benchmark_top_import_bindings(
	config: CompilerCoreCallResolveProfileConfig,
) -> List[CoreResolveImportBinding]:
	var bindings: List[CoreResolveImportBinding] = []

	for module_index in 0..config.module_count:
		for import_index in 0..config.imports_per_module:
			bindings = bindings.append(benchmark_import_binding(module_index, import_index))

	bindings


private pure func benchmark_module_imports(
	config: CompilerCoreCallResolveProfileConfig,
) -> List[CoreResolveModuleImports]:
	var imports: List[CoreResolveModuleImports] = []

	for module_index in 0..config.module_count:
		var bindings: List[CoreResolveImportBinding] = []

		for import_index in 0..config.imports_per_module:
			bindings = bindings.append(benchmark_import_binding(module_index, import_index))

		imports = imports.append({
			module_name = benchmark_module_path(module_index),
			import_bindings = bindings,
		})

	imports


private pure func benchmark_program(config: CompilerCoreCallResolveProfileConfig) -> CoreProgram:
	module_count: Int = benchmark_module_count(config)
	var decls: List[CoreDecl] = [
		benchmark_plain_function_decl(),
		benchmark_shadow_function_decl(0),
		benchmark_shadow_function_decl(1),
		benchmark_first_foreign_function_decl(),
		benchmark_borrow_foreign_function_decl(),
		benchmark_builtin_function_decl(),
		benchmark_module_builtin_function_decl(),
		benchmark_materialized_builtin_forward_decl(),
	]

	for function_index in 0..config.function_count:
		decls = decls.append(
			benchmark_module_function_decl(
				function_index,
				module_count,
				config.duplicate_id_interval,
			),
		)

	for module_index in 0..config.module_count:
		decls = decls.append(benchmark_global_decl(module_index))

	if config.constructors_per_type > 0:
		decls = decls
			.append(benchmark_enum_decl(config.constructors_per_type))
			.append(benchmark_union_decl(config.constructors_per_type))

	decls = decls
		.append(benchmark_concrete_impl_decl())
		.append(benchmark_unresolved_generic_impl_decl())

	{
		decls = decls,
		foreign_includes = []
	}


private pure func duplicate_function_id_count(
	function_count: Int,
	duplicate_id_interval: Int,
) -> Int:
	var count: Int = 0
	var function_index: Int = 1

	while function_index < function_count:
		if duplicate_id_interval > 0 and function_index % duplicate_id_interval == 0:
			count += 1

		function_index += 1

	count


private pure func configured_import_binding_count(
	config: CompilerCoreCallResolveProfileConfig,
) -> Int:
	config.module_count * config.imports_per_module


private pure func module_path_membership_check_count(
	config: CompilerCoreCallResolveProfileConfig,
) -> Int:
	config.module_count + configured_import_binding_count(config) + config.function_count + 2


private pure func benchmark_input_from_parts(
	config: CompilerCoreCallResolveProfileConfig,
	program: CoreProgram,
	import_bindings: List[CoreResolveImportBinding],
	module_imports: List[CoreResolveModuleImports],
) -> CompilerCoreCallResolveBenchmarkInput:
	duplicate_ids = duplicate_function_id_count(config.function_count, config.duplicate_id_interval)
	import_binding_count = configured_import_binding_count(config)
	special_user_function_names: Int = 3
	special_user_function_ids: Int = 4
	special_builtin_entries: Int = 5
	special_foreign_entries: Int = 2
	special_non_collection_decls: Int = 10

	collection_decls: Int = if config.constructors_per_type > 0:
		2
	else:
		0

	{
		config = config,
		program = program,
		import_bindings = import_bindings,
		module_imports = module_imports,
		expected_declaration_count = config.function_count + config.module_count + special_non_collection_decls + collection_decls,
		expected_user_function_count = config.function_count + special_user_function_names,
		expected_user_function_by_id_count = config.function_count - duplicate_ids + special_user_function_ids,
		expected_colliding_user_function_id_count = duplicate_ids,
		expected_module_function_count = config.function_count,
		expected_global_type_count = config.module_count,
		expected_foreign_function_count = special_foreign_entries,
		expected_builtin_function_count = special_builtin_entries,
		expected_constructor_name_count = config.constructors_per_type,
		expected_constructor_target_count = config.constructors_per_type * 2,
		expected_import_binding_count = import_binding_count,
		expected_module_import_count = config.module_count,
		expected_module_import_binding_count = import_binding_count,
		expected_module_path_count = config.module_count + import_binding_count + 2,
		module_path_membership_check_count = module_path_membership_check_count(config)
	}


pure func compiler_core_call_resolve_benchmark_input(
	config: CompilerCoreCallResolveProfileConfig,
) -> CompilerCoreCallResolveBenchmarkInput:
	program = benchmark_program(config)
	benchmark_input_from_parts(
		config,
		program,
		benchmark_top_import_bindings(config),
		benchmark_module_imports(config),
	)


private pure func observation_matches_expected(
	input: CompilerCoreCallResolveBenchmarkInput,
	observation: CoreCallResolveEnvObservation,
) -> Bool:
	(
		observation.user_function_count == input.expected_user_function_count
		and observation.user_function_by_id_count == input.expected_user_function_by_id_count
		and observation.colliding_user_function_id_count == input.expected_colliding_user_function_id_count
		and observation.module_function_count == input.expected_module_function_count
		and observation.global_type_count == input.expected_global_type_count
		and observation.foreign_function_count == input.expected_foreign_function_count
		and observation.builtin_function_count == input.expected_builtin_function_count
		and observation.constructor_name_count == input.expected_constructor_name_count
		and observation.constructor_target_count == input.expected_constructor_target_count
		and observation.import_binding_count == input.expected_import_binding_count
		and observation.module_import_count == input.expected_module_import_count
		and observation.module_import_binding_count == input.expected_module_import_binding_count
		and observation.module_path_count == input.expected_module_path_count
	)


pure func compiler_core_call_resolve_benchmark_with_input(
	input: CompilerCoreCallResolveBenchmarkInput,
) -> CompilerCoreCallResolveBenchmarkResult:
	var observation: CoreCallResolveEnvObservation = {
		user_function_count = 0,
		user_function_by_id_count = 0,
		colliding_user_function_id_count = 0,
		module_function_count = 0,
		global_type_count = 0,
		foreign_function_count = 0,
		builtin_function_count = 0,
		constructor_name_count = 0,
		constructor_target_count = 0,
		import_binding_count = 0,
		module_import_count = 0,
		module_import_binding_count = 0,
		module_path_count = 0,
		module_path_order_checksum = 0,
		count_checksum = 0
	}
	var error_count: Int = 0
	var checksum: Int = 0
	var workload_valid: Bool = (
		input.config.iterations > 0
		and input.config.function_count > 0
		and input.config.module_count > 0
		and input.config.constructors_per_type >= 0
		and input.config.imports_per_module >= 0
	)

	for _ in 0..input.config.iterations:
		observation = observe_core_call_resolve_env(
			input.program,
			input.import_bindings,
			input.module_imports,
		)
		matches_expected: Bool = observation_matches_expected(input, observation)

		if matches_expected:
			void
		else:
			error_count += 1

		workload_valid = workload_valid and matches_expected
		checksum += observation.count_checksum

	{
		observation = observation,
		declaration_count = input.expected_declaration_count,
		module_path_membership_check_count = input.module_path_membership_check_count,
		error_count = error_count,
		checksum = checksum,
		workload_valid = workload_valid
	}


pure func compiler_core_call_resolve_benchmark(
	config: CompilerCoreCallResolveProfileConfig,
) -> CompilerCoreCallResolveBenchmarkResult:
	compiler_core_call_resolve_benchmark_with_input(
		compiler_core_call_resolve_benchmark_input(config),
	)
