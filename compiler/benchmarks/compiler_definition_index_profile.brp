-- Fast graph definition-indexing benchmark.
--
-- Positional controls: iterations, modules, functions per module, exact source
-- queries, broad source-name queries, and same-name matches. Parsing is
-- reported as setup time and excluded from the index measurement.
import:
	compiler_definition_index_profile_fixture:
		CompilerDefinitionIndexBenchmarkConfig,
		compiler_definition_index_benchmark_input,
		compiler_definition_index_benchmark_with_input,
	instrumentation: begin_function_profile_window, end_function_profile_window
	memory: get_mem_stats, reset_mem_stats
	string: parse_int
	system: now_microseconds


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value > 0:
						value
					else:
						default
				None:
					default
		None:
			default


private pure func non_negative_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value >= 0:
						value
					else:
						default
				None:
					default
		None:
			default


func main(args: List[String]) -> Int:
	config: CompilerDefinitionIndexBenchmarkConfig = {
		iterations = positive_argument(args, 1, 25),
		module_count = positive_argument(args, 2, 20),
		functions_per_module = positive_argument(args, 3, 32),
		source_query_count = non_negative_argument(args, 4, 1000),
		source_name_query_count = non_negative_argument(args, 5, 0),
		source_query_same_name_matches = non_negative_argument(args, 6, 1)
	}
	setup_started = now_microseconds()
	input = compiler_definition_index_benchmark_input(config)
	setup_microseconds = now_microseconds() - setup_started

	match input:
		None:
			print("DEFINITION_INDEX_PROFILE_BENCH workload_valid=false setup_failed=true")
			1
		Some(benchmark_input):
			begin_function_profile_window()
			reset_mem_stats()
			started = now_microseconds()
			result = compiler_definition_index_benchmark_with_input(config, benchmark_input)
			elapsed_microseconds = now_microseconds() - started
			end_function_profile_window()
			stats = get_mem_stats()

			print(
				"DEFINITION_INDEX_PROFILE_BENCH" + " iterations=" + config.iterations.to_string() + " modules=" + config.module_count.to_string() + " functions_per_module=" + config.functions_per_module.to_string() + " exact_source_queries=" + config.source_query_count.to_string() + " broad_source_name_queries=" + config.source_name_query_count.to_string() + " same_name_matches=" + config.source_query_same_name_matches.to_string() + " callable_ids=" + result.func_callable_id_count.to_string() + " source_ids=" + result.source_definition_id_count.to_string() + " allocated_ids=" + result.allocated_definition_count.to_string() + " workload_valid=" + result.workload_valid.to_string() + " checksum=" + result.checksum.to_string() + " query_checksum=" + result.query_checksum.to_string() + " source_query_keys=" + result.source_query_key_count.to_string() + " exact_source_lookups=" + result.exact_source_lookup_count.to_string() + " exact_source_lookup_hits=" + result.exact_source_lookup_hits.to_string() + " source_name_queries=" + result.source_name_query_count.to_string() + " source_name_query_module_buckets_visited=" + result.source_name_query_module_buckets_visited.to_string() + " source_name_query_sort_calls=" + result.source_name_query_sort_calls.to_string() + " source_name_query_returned_matches=" + result.source_name_query_returned_matches.to_string() + " allocations=" + stats.total_allocations.to_string() + " bytes_allocated=" + stats.bytes_allocated.to_string() + " setup_microseconds=" + setup_microseconds.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string(),
			)

			if result.workload_valid:
				0
			else:
				1
