import:
	../src/stage_12_cli/bridge_protocol:
		BridgeProtocolError(InvalidJson),
		bridge_error_json,
	compiler_backend_bridge: handle_request_value
	fs: message, open_read
	io: print_error
	json: parse_json


func read_request(path: String) -> Result[String, String]:
	with reader ?= open_read(path) on err => message(err):
		match reader.read_text():
			Ok(request):
				Ok(request)
			Err(err):
				Err(message(err))


pure func handle_request(request: String) -> String:
	parse_json(request)
		.map(func(root): handle_request_value(root).to_string())
		.get_or_else(func(message): bridge_error_json(InvalidJson(message)).to_string())


func main(args: List[String]) -> Int:
	if args.length() != 2:
		print_error("Usage: compiler_backend_worker <request.json>")
		1
	else:
		path: String = args
			.get(1)
			.get_or("")

		match read_request(path):
			Ok(request):
				print(handle_request(request))
				0
			Err(message):
				print_error(message)
				1
