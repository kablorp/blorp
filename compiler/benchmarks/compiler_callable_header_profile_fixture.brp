-- Bounded in-process workload for callable-header registration profiling.
--
-- The fixture keeps module count, header count, parameter count, and
-- dimension-constraint count independent so the profile counters can identify
-- whether registration is dominated by signature conversion or installation.
import:
	../../blorp/src/compiler/stage_03_parse/parser_bridge as ParserBridge
	../../blorp/src/compiler/stage_03_parse/source_ast_finalize: FinalizedTypecheckProgram
	../../blorp/src/compiler/stage_04_modules/loaded_module: ModuleOrigin(UserModule)
	../../blorp/src/compiler/stage_06_typecheck/bridge:
		TypecheckGraphRequest,
		TypecheckImportModule,
		TypecheckedGraph,
		typecheck_graph


struct CompilerCallableHeaderBenchmarkConfig {
	iterations: Int,
	module_count: Int,
	headers_per_module: Int,
	parameters_per_header: Int,
	dimension_constraints_per_header: Int,
	retain_parsed_programs: Bool
}


struct CompilerCallableHeaderBenchmarkResult {
	artifact_count: Int,
	valid_header_count: Int,
	source_declaration_count: Int,
	typed_declaration_count: Int,
	error_count: Int,
	checksum: Int,
	workload_valid: Bool
}


private pure func benchmark_module_name(module_index: Int) -> String:
	"bench/callable_header_profile_" + module_index.to_string()


private pure func benchmark_header_name(module_index: Int, header_index: Int) -> String:
	"callable_header_m" + module_index.to_string() + "_" + header_index.to_string()


private pure func benchmark_parameter_list(
	parameter_count: Int,
	dimension_constraint_count: Int,
) -> String:
	var parameters: List[String] = []
	parameter_type: String = if dimension_constraint_count > 0:
		"Int[#N]"
	else:
		"T"

	for parameter_index in 0..parameter_count:
		parameters = parameters.append(
			"value_" + parameter_index.to_string() + ": " + parameter_type,
		)

	parameters.join(", ")


private pure func benchmark_dimension_constraints(
	parameter_count: Int,
	dimension_constraint_count: Int,
) -> String:
	if dimension_constraint_count == 0:
		""
	else:
		constraint: String = if parameter_count == 0:
			"#N == #1"
		else:
			"#N == #N"
		var constraints: List[String] = []

		for _ in 0..dimension_constraint_count:
			constraints = constraints.append(constraint)

		" where " + constraints.join(", ")


private pure func benchmark_header_source(
	module_index: Int,
	header_index: Int,
	parameter_count: Int,
	dimension_constraint_count: Int,
) -> String:
	dimension_parameters: String = if dimension_constraint_count > 0:
		"[#N]"
	else:
		""
	parameters = benchmark_parameter_list(parameter_count, dimension_constraint_count)
	return_type: String = if parameter_count == 0:
		if dimension_constraint_count > 0:
			"Int[#1]"
		else:
			"Int"
	else if dimension_constraint_count > 0:
		"Int[#N]"
	else:
		"T"
	body: String = if parameter_count == 0:
		if dimension_constraint_count > 0:
			"[0]"
		else:
			"0"
	else:
		"value_0"

	(
		"pure func " + benchmark_header_name(module_index, header_index)
			+ dimension_parameters + "(" + parameters + ") -> " + return_type
			+ benchmark_dimension_constraints(parameter_count, dimension_constraint_count)
			+ ":\n\t" + body
	)


private pure func benchmark_module_source(
	module_index: Int,
	headers_per_module: Int,
	parameters_per_header: Int,
	dimension_constraints_per_header: Int,
) -> String:
	var declarations: List[String] = []

	for header_index in 0..headers_per_module:
		declarations = declarations.append(
			benchmark_header_source(
				module_index,
				header_index,
				parameters_per_header,
				dimension_constraints_per_header,
			),
		)

	declarations.join("\n\n") + "\n"


private pure func benchmark_module(
	module_index: Int,
	config: CompilerCallableHeaderBenchmarkConfig,
) -> TypecheckImportModule:
	module_name = benchmark_module_name(module_index)
	path = "/bench/callable_header_profile_" + module_index.to_string() + ".brp"
	source = benchmark_module_source(
		module_index,
		config.headers_per_module,
		config.parameters_per_header,
		config.dimension_constraints_per_header,
	)
	typecheck_program: Option[FinalizedTypecheckProgram] = if config.retain_parsed_programs:
		Some(ParserBridge.parsed_typecheck_source_bridge_artifact(path, module_name, source, False).program)
	else:
		None

	{
		path = path,
		module_name = module_name,
		module_path = module_name,
		text = source,
		typecheck_program = typecheck_program,
		origin = UserModule
	}


pure func compiler_callable_header_benchmark_request(
	config: CompilerCallableHeaderBenchmarkConfig,
) -> TypecheckGraphRequest:
	var modules: List[TypecheckImportModule] = []
	var module_targets: List[String] = []

	for module_index in 0..config.module_count:
		module = benchmark_module(module_index, config)
		modules = modules.append(module)
		module_targets = module_targets.append(module.module_path)

	target_path: String = "/bench/callable_header_profile_main.brp"
	target_module: String = "bench/callable_header_profile_main"
	target_source: String = "func main(args: List[String]) -> Int:\n\t0\n"
	target_program: Option[FinalizedTypecheckProgram] = if config.retain_parsed_programs:
		Some(
			ParserBridge.parsed_typecheck_source_bridge_artifact(
				target_path,
				target_module,
				target_source,
				False,
			).program,
		)
	else:
		None

	{
		target = {
			path = target_path,
			module_name = target_module,
			module_path = target_module,
			text = target_source,
			typecheck_program = target_program,
			origin = UserModule
		},
		modules = modules,
		module_targets = module_targets,
		resolved_imports = [],
		include_comments = False,
		allow_debug_only_calls = False
	}


private pure func typechecked_graph_error_count(graph: TypecheckedGraph) -> Int:
	var count: Int = graph.target.errors.length()

	for module in graph.modules:
		count += module.errors.length()

	count


private pure func typechecked_graph_declaration_count(graph: TypecheckedGraph) -> Int:
	var count: Int = graph.target.typed_program.decls.length()

	for module in graph.modules:
		count += module.typed_program.decls.length()

	count


private pure func typechecked_graph_source_declaration_count(graph: TypecheckedGraph) -> Int:
	var count: Int = graph.target.parsed_program.decls.length()

	for module in graph.modules:
		count += module.parsed_program.decls.length()

	count


pure func compiler_callable_header_benchmark_with_request(
	config: CompilerCallableHeaderBenchmarkConfig,
	request: TypecheckGraphRequest,
) -> CompilerCallableHeaderBenchmarkResult:
	expected_artifact_count = config.module_count + 1
	expected_header_count = config.module_count * config.headers_per_module
	expected_declaration_count = expected_header_count + 1
	var artifact_count: Int = 0
	var valid_header_count: Int = 0
	var source_declaration_count: Int = 0
	var typed_declaration_count: Int = 0
	var error_count: Int = 0
	var checksum: Int = 0
	var workload_valid = config.iterations > 0

	for _ in 0..config.iterations:
		graph = typecheck_graph(request)
		artifact_count = graph.modules.length() + 1
		valid_header_count = expected_header_count
		source_declaration_count = typechecked_graph_source_declaration_count(graph)
		typed_declaration_count = typechecked_graph_declaration_count(graph)
		error_count += typechecked_graph_error_count(graph)
		workload_valid = (
			workload_valid
			and artifact_count == expected_artifact_count
			and source_declaration_count == expected_declaration_count
			and typed_declaration_count == expected_declaration_count
		)
		checksum += artifact_count + valid_header_count + source_declaration_count + typed_declaration_count

	{
		artifact_count = artifact_count,
		valid_header_count = valid_header_count,
		source_declaration_count = source_declaration_count,
		typed_declaration_count = typed_declaration_count,
		error_count = error_count,
		checksum = checksum,
		workload_valid = workload_valid
	}


pure func compiler_callable_header_benchmark(
	config: CompilerCallableHeaderBenchmarkConfig,
) -> CompilerCallableHeaderBenchmarkResult:
	compiler_callable_header_benchmark_with_request(
		config,
		compiler_callable_header_benchmark_request(config),
	)
