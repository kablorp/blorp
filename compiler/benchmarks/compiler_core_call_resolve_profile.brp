-- Isolated profile for Core call-resolution environment construction.
--
-- Positional controls: iterations, functions, modules, constructors per type,
-- duplicate-ID interval, and imports per module. Fixture construction is
-- reported separately and excluded from the measured builder loop.
import:
	compiler_core_call_resolve_profile_fixture:
		CompilerCoreCallResolveBenchmarkInput,
		CompilerCoreCallResolveBenchmarkResult,
		CompilerCoreCallResolveProfileConfig,
		compiler_core_call_resolve_benchmark_input,
		compiler_core_call_resolve_benchmark_with_input,
	instrumentation: begin_function_profile_window, end_function_profile_window
	memory: get_mem_stats, reset_mem_stats
	string: parse_int
	system: now_microseconds


private pure func positive_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value > 0:
						value
					else:
						default
				None:
					default
		None:
			default


private pure func nonnegative_argument(args: List[String], index: Int, default: Int) -> Int:
	match args.get(index):
		Some(text):
			match parse_int(text):
				Some(value):
					if value >= 0:
						value
					else:
						default
				None:
					default
		None:
			default


func main(args: List[String]) -> Int:
	config: CompilerCoreCallResolveProfileConfig = {
		iterations = positive_argument(args, 1, 20),
		function_count = positive_argument(args, 2, 2048),
		module_count = positive_argument(args, 3, 16),
		constructors_per_type = nonnegative_argument(args, 4, 4),
		duplicate_id_interval = nonnegative_argument(args, 5, 64),
		imports_per_module = nonnegative_argument(args, 6, 4)
	}
	setup_started: Int = now_microseconds()
	input: CompilerCoreCallResolveBenchmarkInput = compiler_core_call_resolve_benchmark_input(
		config,
	)
	setup_microseconds: Int = now_microseconds() - setup_started

	reset_mem_stats()
	begin_function_profile_window()
	started: Int = now_microseconds()
	result: CompilerCoreCallResolveBenchmarkResult = compiler_core_call_resolve_benchmark_with_input(
		input,
	)
	elapsed_microseconds: Int = now_microseconds() - started
	end_function_profile_window()
	stats = get_mem_stats()
	observation = result.observation

	print(
		"CORE_CALL_RESOLVE_PROFILE" + " iterations=" + config.iterations.to_string() + " functions=" + config.function_count.to_string() + " modules=" + config.module_count.to_string() + " constructors_per_type=" + config.constructors_per_type.to_string() + " duplicate_id_interval=" + config.duplicate_id_interval.to_string() + " imports_per_module=" + config.imports_per_module.to_string() + " declarations=" + result.declaration_count.to_string() + " user_functions=" + observation.user_function_count.to_string() + " user_functions_by_id=" + observation.user_function_by_id_count.to_string() + " colliding_user_function_ids=" + observation.colliding_user_function_id_count.to_string() + " module_functions=" + observation.module_function_count.to_string() + " globals=" + observation.global_type_count.to_string() + " foreign_functions=" + observation.foreign_function_count.to_string() + " builtin_functions=" + observation.builtin_function_count.to_string() + " constructor_names=" + observation.constructor_name_count.to_string() + " constructor_targets=" + observation.constructor_target_count.to_string() + " import_bindings=" + observation.import_binding_count.to_string() + " module_imports=" + observation.module_import_count.to_string() + " module_import_bindings=" + observation.module_import_binding_count.to_string() + " module_paths=" + observation.module_path_count.to_string() + " module_path_membership_checks=" + result.module_path_membership_check_count.to_string() + " checksum=" + result.checksum.to_string() + " count_checksum=" + observation.count_checksum.to_string() + " module_path_order_checksum=" + observation.module_path_order_checksum.to_string() + " setup_microseconds=" + setup_microseconds.to_string() + " elapsed_microseconds=" + elapsed_microseconds.to_string() + " total_allocations=" + stats.total_allocations.to_string() + " total_releases=" + stats.total_releases.to_string() + " current_objects=" + stats.current_objects.to_string() + " bytes_allocated=" + stats.bytes_allocated.to_string() + " workload_valid=" + result.workload_valid.to_string() + " error_count=" + result.error_count.to_string(),
	)

	if result.error_count == 0 and result.workload_valid:
		0
	else:
		1
