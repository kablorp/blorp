import:
	int as IntOps
	lex: lex
	names: NameTable, name_spelling
	option: is_some, to_result
	result: and_then
	parse:
		ParsedProgram, ParsedModule, ParsedImport, ImportOrigin(RelativeImport, LibraryImport), append_module, assembly_names, begin_program, module_imports, module_names,
		parse_module, seal_program
	path as Path
	source:
		COMPILER_SOURCE, ModuleId, ModuleKind(UserModule, LibraryModule, FoundationTypesModule, FoundationPreludeModule), SourceId, module_id, module_source, root_module_id, same_module
	syntax: Diagnostic, Span
	system: getcwd, read_file
	text as Text


private FOUNDATION_TYPES_PATH: String = "_base/types.brp"

private FOUNDATION_PRELUDE_PATH: String = "_base/prelude.brp"

private FOUNDATION_TYPES_ORDINAL: Int = 1

private FOUNDATION_PRELUDE_ORDINAL: Int = 2


fixed record SourceFile {
	path: String,
	contents: String
}


-- Module source rows use the same order as the parser's module inventory.
fixed record SourceInputs {
	modules: List[SourceFile]
}


fixed record LoadedProgram {
	sources: SourceInputs,
	program: ParsedProgram
}


fixed record LoadFailure {
	sources: SourceInputs,
	diagnostic: Diagnostic
}


private pure func rejection(span: Span, message: String, help: String) -> Diagnostic:
	{ span = span, note = None, message = message, help = help }


private pure func internal_error(message: String) -> Diagnostic:
	rejection(
		{ source = COMPILER_SOURCE, start = 0, end = 0 },
		message,
		"report this compiler error with the input files",
	)


-- This projection belongs to source loading, where filesystem paths are needed.
-- Semantic import resolution receives ModuleId targets instead of these strings.
pure func import_path(
	importer: String,
	request: ParsedImport,
	names: NameTable,
	library_root: String,
) -> Result[String, Diagnostic]:
	base = match request.path.origin:
		LibraryImport:
			library_root
		RelativeImport(parents):
			var directory = Path.dirname(importer)
			var remaining = parents
			while IntOps.greater_than(remaining, 0):
				directory = Path.dirname(directory)
				remaining = IntOps.subtract(remaining, 1)
			directory
	var directory = base

	var failure: Option[Diagnostic] = None
	for part in request.path.parts:
		match name_spelling(names, part):
			None:
				failure = Some(internal_error("import path references an invalid spelling identity"))
				break
			Some(spelling):
				directory = Path.join(directory, spelling)

	match failure:
		Some(error): Err(error)
		None: Ok(Path.normalize(Text.concat(directory, ".brp")))


private fixed record RequestedModule {
	id: ModuleId,
	path: String,
	role: ModuleKind,
	site: Option[Span]
}


private pure func known_module(requests: List[RequestedModule], path: String) -> Option[ModuleId]:
	var found: Option[ModuleId] = None

	for request in requests:
		if Text.equals(request.path, path):
			found = Some(request.id)
			break

	found


private func read_module(path: String, id: ModuleId, site: Option[Span]) -> Result[String, Diagnostic]:
	match read_file(path):
		Ok(contents):
			Ok(contents)
		Err(error):
			span = match site:
				Some(span): span
				None: { source = module_source(id), start = 0, end = 0 }
			Err(rejection(
				span,
				Text.concat("could not read module ", path).concat(": ").concat(error),
				"check the import path and provide a readable .brp file under its source root",
			))


private fixed union ImportTarget:
	KnownTarget(ModuleId)
	DiscoveredTarget(RequestedModule)


-- Both paths are normalized. Designated inputs receive their kinds when seeded;
-- discovered dependencies use the configured directory boundary.
pure func dependency_kind(path: String, library_root: String) -> ModuleKind:
	if path.starts_with(Path.join(library_root, "")):
		LibraryModule
	else:
		UserModule


private pure func resolve_request(
	importer: String,
	request: ParsedImport,
	names: NameTable,
	requests: List[RequestedModule],
	library_root: String,
) -> Result[ImportTarget, Diagnostic]:
	path ?= import_path(importer, request, names, library_root)
	reserved ?= if Text.equals(path, Path.join(library_root, FOUNDATION_TYPES_PATH)) or Text.equals(path, Path.join(library_root, FOUNDATION_PRELUDE_PATH)):
		Err(rejection(request.span, "foundation modules cannot be imported explicitly", "remove this import; foundation types and the prelude are supplied by --library-root"))
	else:
		Ok(void)
	match known_module(requests, path):
		Some(id): Ok(KnownTarget(id))
		None:
			id ?= module_id(requests.length()).to_result(internal_error("module inventory is too large"))
			Ok(DiscoveredTarget({ id = id, path = path, role = dependency_kind(path, library_root), site = Some(request.span) }))


private fixed record ReadModule {
	request: RequestedModule,
	file: SourceFile,
	parsed: Result[ParsedModule, Diagnostic]
}


-- Preserve readable bytes even on a parse failure so its diagnostic has a source.
-- The queue and name table are borrowed; builders stay local to load_program.
private func read_requested(
	requests: List[RequestedModule],
	position: Int,
	names: NameTable,
	root_path: String,
) -> Result[ReadModule, Diagnostic]:
	current ?= requests.get(position).to_result(internal_error("missing queued module"))
	contents ?= read_module(current.path, current.id, current.site)
	display_path = if same_module(current.id, root_module_id()):
		root_path
	else:
		current.path
	parsed = lex(module_source(current.id), contents).and_then(
		pure func(lexed): parse_module(lexed, current.id, names),
	)
	Ok({ request = current, file = { path = display_path, contents = contents }, parsed = parsed })


-- Every queued path has one identity, policy role, read, and parse in this invocation.
func load_program(root_path: String, library_root: String) -> Result[LoadedProgram, LoadFailure]:
	working_directory = getcwd()
	normalized_library = Path.normalize(Path.join(working_directory, library_root))
	var modules: List[SourceFile] = []
	var assembly = begin_program()
	types_id ?= module_id(FOUNDATION_TYPES_ORDINAL).to_result({ sources = { modules = [] }, diagnostic = internal_error("foundation type module identity is unavailable") })
	prelude_id ?= module_id(FOUNDATION_PRELUDE_ORDINAL).to_result({ sources = { modules = [] }, diagnostic = internal_error("foundation prelude module identity is unavailable") })
	var requests: List[RequestedModule] = [{
		id = root_module_id(),
		path = Path.normalize(Path.join(working_directory, root_path)),
		role = UserModule,
		site = None
	}]
	root_request ?= requests.get(0).to_result({ sources = { modules = [] }, diagnostic = internal_error("root module request is unavailable") })
	root_input ?= if Text.equals(root_request.path, Path.join(normalized_library, FOUNDATION_TYPES_PATH)) or Text.equals(root_request.path, Path.join(normalized_library, FOUNDATION_PRELUDE_PATH)):
		Err({ sources = { modules = [{ path = root_path, contents = "" }] }, diagnostic = rejection({ source = module_source(root_module_id()), start = 0, end = 0 }, "foundation modules cannot be application roots", "choose an application module; foundation inputs are supplied by --library-root") })
	else:
		Ok(void)
	requests = requests.append({ id = types_id, path = Path.join(normalized_library, FOUNDATION_TYPES_PATH), role = FoundationTypesModule, site = None })
	requests = requests.append({ id = prelude_id, path = Path.join(normalized_library, FOUNDATION_PRELUDE_PATH), role = FoundationPreludeModule, site = None })
	var position = 0
	var failure: Option[Diagnostic] = None

	while IntOps.less_than(position, requests.length()):
		match read_requested(requests, position, assembly_names(assembly), root_path):
			Err(error):
				-- Missing designated inputs still have a path for source-aware diagnostics.
				match requests.get(position):
					Some(request): modules = modules.append({ path = request.path, contents = "" })
					None: void
				failure = Some(error)
				break
			Ok(loaded):
				modules = modules.append(loaded.file)
				match loaded.parsed:
					Err(error):
						failure = Some(error)
						break
					Ok(parsed):
						var targets: List[ModuleId] = []
						for request in module_imports(parsed):
							match resolve_request(loaded.request.path, request, module_names(parsed), requests, normalized_library):
								Err(error):
									failure = Some(error)
									break
								Ok(KnownTarget(id)):
									targets = targets.append(id)
								Ok(DiscoveredTarget(next)):
									requests = requests.append(next)
									targets = targets.append(next.id)
						if failure.is_some():
							break
						match append_module(assembly, parsed, targets, loaded.request.role):
							Err(error):
								failure = Some(error)
								break
							Ok(next):
								assembly = next
		position = IntOps.add(position, 1)

	sources: SourceInputs = { modules = modules }
	match failure:
		Some(error): Err({ sources = sources, diagnostic = error })
		None:
			match seal_program(assembly):
				Err(error): Err({ sources = sources, diagnostic = error })
				Ok(program): Ok({ sources = sources, program = program })
