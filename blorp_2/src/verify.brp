import:
	int as IntOps
	list: contains
	lower: MatchLabel(DefaultLabel, VariantLabel), ValueId, value_number
	option: is_some, to_result
	own:
		BorrowSource(ParameterBorrow, OwnerBorrow),
		BorrowedValue,
		OwnedArgument(UnmanagedArgument, BorrowedArgument),
		OwnedDefinition,
		OwnedExit(ReturnResult, RecurArguments),
		OwnedFunction,
		OwnedMatch,
		OwnedTail(ReturnTail, MatchTail),
		OwnedValueOperation(
			ParameterDefinition, IntegerDefinition, VariantDefinition, CallDefinition,
			ConstructDefinition, PayloadDefinition, ConstructRecordDefinition,
			ReadRecordFieldDefinition,
		),
		OwnerId,
		OwnershipOperation(DefineValue, AcquireOwner, DropOwner),
		OwnershipProgram,
		ResultOwnership(UnmanagedResult, BorrowedResult, OwnedResult),
		ReturnTransfer(UnmanagedReturn, OwnedReturn),
		ValueOwnership(NoOwnership, ManagedStringLeaf),
		owner_number,
		value_ownership,
	specialize:
		CallTarget(UserFunction, RuntimeFunction),
		ConcreteCall,
		ConcreteRecord,
		ConcreteUnion,
		FieldInstanceId,
		FunctionSignature,
		PayloadShape(NoPayload, IntPayload),
		RecordInstanceId,
		TypeRef(IntType, StringType, UnionType, RecordType),
		VariantInstanceId,
		field_number,
		field_owner,
		function_number,
		record_number,
		runtime_signature,
		same_type,
		union_number,
		variant_number,
		variant_owner,
	syntax: Diagnostic, FunctionExecution(OrdinaryCalls, SelfTailLoop), Span
	text: concat


-- This seal belongs to the exact operations and contracts checked below.
opaque type VerifiedProgram = OwnershipProgram


pure func verified_contents(program: VerifiedProgram) -> OwnershipProgram:
	from_opaque VerifiedProgram(program)


private pure func failure(span: Span, message: String) -> Diagnostic:
	{
		span = span,
		note = None,
		message = "ownership verification failed: ".concat(message),
		help = "report this compiler error with the input program"
	}


private fixed record KnownValue {
	value_type: TypeRef,
	span: Span
}


private fixed union OwnerState:
	ActiveOwner(ValueId)
	DischargedOwner


private fixed record VerificationState {
	prefix_values: List[KnownValue],
	first_value: Int,
	values: List[KnownValue],
	first_owner: Int,
	owners: List[OwnerState],
	parameters: List[ValueId]
}


private fixed union ProjectionContext:
	NoProjection
	PayloadProjection(ValueId, VariantInstanceId)


private pure func value(
	state: VerificationState,
	id: ValueId,
	span: Span,
) -> Result[KnownValue, Diagnostic]:
	error = failure(
		span,
		"value "
			.append_int(value_number(id))
			.concat(" is not defined before use"),
	)
	ordinal = value_number(id)

	entry = if (
		IntOps.greater_than_or_equal(ordinal, 0)
		and IntOps.less_than(ordinal, state.prefix_values.length())
	):
		state.prefix_values.get(ordinal)
	else if IntOps.greater_than_or_equal(ordinal, state.first_value):
		state.values.get(IntOps.subtract(ordinal, state.first_value))
	else:
		None

	entry.to_result(error)


private pure func owner(
	state: VerificationState,
	id: OwnerId,
	span: Span,
) -> Result[OwnerState, Diagnostic]:
	ordinal = owner_number(id)

	if IntOps.greater_than_or_equal(ordinal, 0) and IntOps.less_than(ordinal, state.first_owner):
		Err(
			failure(
				span,
				"owner "
					.append_int(ordinal)
					.concat(" is not available in this match arm"),
			),
		)
	else:
		entry = if IntOps.greater_than_or_equal(ordinal, state.first_owner):
			state.owners.get(IntOps.subtract(ordinal, state.first_owner))
		else:
			None

		entry.to_result(
			failure(
				span,
				"owner "
					.append_int(ordinal)
					.concat(" is not defined"),
			),
		)


private pure func introduce_owner(
	state: VerificationState,
	id: OwnerId,
	value: ValueId,
	span: Span,
) -> Result[List[OwnerState], Diagnostic]:
	ordinal = owner_number(id)
	next_owner = IntOps.add(state.first_owner, state.owners.length())

	if IntOps.less_than(ordinal, 0):
		Err(failure(span, "negative owner identity"))
	else if IntOps.less_than(ordinal, next_owner):
		Err(
			failure(
				span,
				"owner "
					.append_int(ordinal)
					.concat(" is defined more than once"),
			),
		)
	else if IntOps.not_equals(ordinal, next_owner):
		Err(failure(span, "owner identity is not the next function ordinal"))
	else:
		Ok(state.owners.append(ActiveOwner(value)))


private pure func verify_borrow(
	borrow: BorrowedValue,
	state: VerificationState,
	span: Span,
) -> Result[Bool, Diagnostic]:
	borrowed ?= value(state, borrow.value, span)

	match borrowed.value_type:
		StringType:
			match borrow.source:
				ParameterBorrow(source):
					if (
						IntOps.equals(value_number(source), value_number(borrow.value))
						and state.parameters.any(
							pure func(
								parameter: ValueId,
							) -> Bool: IntOps.equals(
								value_number(parameter),
								value_number(borrow.value),
							),
						)
					):
						Ok(True)
					else:
						Err(
							failure(
								span,
								"parameter borrow does not refer to the borrowed String parameter",
							),
						)
				OwnerBorrow(id):
					entry ?= owner(state, id, span)

					match entry:
						DischargedOwner:
							Err(
								failure(
									span,
									"borrow refers to discharged owner ".append_int(
										owner_number(id),
									),
								),
							)
						ActiveOwner(owned):
							if IntOps.equals(value_number(owned), value_number(borrow.value)):
								Ok(True)
							else:
								Err(
									failure(
										span,
										"owner "
											.append_int(owner_number(id))
											.concat(" does not own value ")
											.append_int(value_number(borrow.value)),
									),
								)
		_:
			Err(failure(span, "borrow requires a managed value"))


private pure func call_signature(
	call: ConcreteCall,
	functions: List[OwnedFunction],
) -> Result[FunctionSignature, Diagnostic]:
	match call.target:
		RuntimeFunction(operation):
			Ok(runtime_signature(operation))
		UserFunction(id):
			function ?= functions
				.get(function_number(id))
				.to_result(failure(call.span, "unknown called function"))
			Ok(function.signature)


private pure func verify_argument(
	argument: OwnedArgument,
	expected: TypeRef,
	state: VerificationState,
	unions: List[ConcreteUnion],
	span: Span,
	records: List[ConcreteRecord],
) -> Result[Bool, Diagnostic]:
	id = match argument:
		UnmanagedArgument(id):
			id
		BorrowedArgument(borrow):
			borrow.value

	known ?= value(state, id, span)

	if not same_type(known.value_type, expected):
		Err(failure(span, "call argument type does not match its contract"))
	else:
		match argument:
			UnmanagedArgument(_):
				plan ?= value_ownership(expected, unions, records)

				match plan:
					NoOwnership:
						Ok(True)
					ManagedStringLeaf:
						Err(
							failure(
								span,
								"managed call argument requires an owner-dependent borrow",
							),
						)
			BorrowedArgument(borrow):
				verify_borrow(borrow, state, span)


private pure func verify_arguments(
	arguments: List[OwnedArgument],
	parameters: List[TypeRef],
	state: VerificationState,
	unions: List[ConcreteUnion],
	span: Span,
	records: List[ConcreteRecord],
) -> Result[Bool, Diagnostic]:
	if IntOps.less_than(arguments.length(), parameters.length()):
		Err(failure(span, "call is missing its argument"))
	else if IntOps.greater_than(arguments.length(), parameters.length()):
		Err(failure(span, "call has an unexpected argument"))
	else:
		var index: Int = 0
		var invalid: Option[Diagnostic] = None

		for argument in arguments:
			match parameters.get(index):
				None:
					invalid = Some(failure(span, "missing call parameter contract"))
					break
				Some(expected):
					match verify_argument(argument, expected, state, unions, span, records):
						Err(error):
							invalid = Some(error)
							break
						Ok(_):
							void

			index = IntOps.add(index, 1)

		match invalid:
			Some(error):
				Err(error)
			None:
				Ok(True)


private pure func variant_shape(
	id: VariantInstanceId,
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[PayloadShape, Diagnostic]:
	declaration ?= unions
		.get(union_number(variant_owner(id)))
		.to_result(failure(span, "unknown variant owner"))
	declaration.variants
		.get(variant_number(id))
		.to_result(failure(span, "unknown variant identity"))


private pure func variant_type(
	id: VariantInstanceId,
	expected: PayloadShape,
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[TypeRef, Diagnostic]:
	shape ?= variant_shape(id, unions, span)

	valid = match expected:
		NoPayload:
			match shape:
				NoPayload:
					True
				_:
					False
		IntPayload:
			match shape:
				IntPayload:
					True
				_:
					False

	if valid:
		Ok(UnionType(variant_owner(id)))
	else:
		Err(failure(span, "variant payload does not match its operation"))


private pure func valid_record_layout(
	layout: ConcreteRecord,
	span: Span,
) -> Result[ConcreteRecord, Diagnostic]:
	var valid = IntOps.greater_than(layout.fields.length(), 0)

	for field in layout.fields:
		valid = valid and same_type(field, IntType)

	if valid:
		Ok(layout)
	else:
		Err(failure(span, "record layout must contain one or more Int fields"))


private pure func record_layout(
	owner: RecordInstanceId,
	records: List[ConcreteRecord],
	span: Span,
) -> Result[ConcreteRecord, Diagnostic]:
	layout ?= records
		.get(record_number(owner))
		.to_result(failure(span, "unknown record layout"))
	valid_record_layout(layout, span)


private pure func record_field_type(
	field: FieldInstanceId,
	owner: RecordInstanceId,
	layout: ConcreteRecord,
	span: Span,
) -> Result[TypeRef, Diagnostic]:
	if not IntOps.equals(record_number(field_owner(field)), record_number(owner)):
		Err(failure(span, "field belongs to a different record layout"))
	else:
		layout.fields
			.get(field_number(field))
			.to_result(failure(span, "unknown record field"))


private pure func operation_type(
	definition: OwnedDefinition,
	state: VerificationState,
	signature: FunctionSignature,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	projection: ProjectionContext,
	records: List[ConcreteRecord],
) -> Result[TypeRef, Diagnostic]:
	match definition.operation:
		ConstructRecordDefinition(owner, fields):
			layout ?= record_layout(owner, records, definition.span)

			complete ?= if IntOps.equals(fields.length(), layout.fields.length()):
				Ok(void)
			else:
				Err(
					failure(
						definition.span,
						"record construction must provide every field exactly once",
					),
				)

			var seen: List[Int] = []
			var invalid: Option[Diagnostic] = None

			for field in fields:
				if seen.contains(field_number(field.field)):
					invalid = Some(failure(definition.span, "record construction repeats a field"))
					break

				result = record_field_type(
					field.field,
					owner,
					layout,
					definition.span,
				).and_then(pure func(expected: TypeRef) -> Result[Bool, Diagnostic]:
					known ?= value(state, field.value, definition.span)

					if same_type(known.value_type, expected):
						Ok(True)
					else:
						Err(
							failure(
								definition.span,
								"record field value type does not match its layout",
							),
						)
				)

				match result:
					Err(error):
						invalid = Some(error)
						break
					Ok(_):
						seen = seen.append(field_number(field.field))

			match invalid:
				Some(error):
					Err(error)
				None:
					Ok(RecordType(owner))
		ReadRecordFieldDefinition(field, source):
			known ?= value(state, source, definition.span)

			owner ?= match known.value_type:
				RecordType(owner):
					Ok(owner)
				_:
					Err(failure(definition.span, "field projection requires a record value"))

			layout ?= record_layout(owner, records, definition.span)
			record_field_type(field, owner, layout, definition.span)
		ParameterDefinition(index):
			if IntOps.less_than(index, state.parameters.length()):
				Err(failure(definition.span, "function parameter is defined more than once"))
			else if IntOps.not_equals(index, state.parameters.length()):
				Err(
					failure(
						definition.span,
						"function parameter position is not the next signature position",
					),
				)
			else:
				signature.parameters
					.get(index)
					.to_result(
						failure(
							definition.span,
							"parameter value in a zero-argument function",
						),
					)
		IntegerDefinition(_):
			Ok(IntType)
		VariantDefinition(id):
			variant_type(id, NoPayload, unions, definition.span)
		CallDefinition(call, arguments):
			contract ?= call_signature(call, functions)
			valid ?= verify_arguments(
				arguments,
				contract.parameters,
				state,
				unions,
				definition.span,
				records,
			)

			if same_type(contract.return_type, definition.value_type):
				Ok(contract.return_type)
			else:
				Err(failure(definition.span, "call result type does not match its contract"))
		ConstructDefinition(id, argument):
			argument_value ?= value(state, argument, definition.span)

			if same_type(argument_value.value_type, IntType):
				variant_type(id, IntPayload, unions, definition.span)
			else:
				Err(failure(definition.span, "union constructor requires an Int payload"))
		PayloadDefinition(source):
			scrutinee ?= value(state, source, definition.span)

			match projection:
				NoProjection:
					Err(
						failure(
							definition.span,
							"payload projection outside its selected match arm",
						),
					)
				PayloadProjection(expected, variant):
					union_type ?= variant_type(variant, IntPayload, unions, definition.span)

					if (
						IntOps.equals(value_number(source), value_number(expected))
						and same_type(scrutinee.value_type, union_type)
					):
						Ok(IntType)
					else:
						Err(
							failure(
								definition.span,
								"payload projection does not belong to this match arm",
							),
						)


private pure func verify_definition(
	definition: OwnedDefinition,
	state: VerificationState,
	signature: FunctionSignature,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	projection: ProjectionContext,
	records: List[ConcreteRecord],
) -> Result[VerificationState, Diagnostic]:
	if IntOps.not_equals(
		value_number(definition.id),
		IntOps.add(state.first_value, state.values.length()),
	):
		Err(failure(definition.span, "value identity is not the next function ordinal"))
	else:
		expected ?= operation_type(
			definition,
			state,
			signature,
			functions,
			unions,
			projection,
			records,
		)

		if not same_type(expected, definition.value_type):
			Err(failure(definition.span, "definition type does not match its operation"))
		else:
			plan ?= match definition.value_type:
				RecordType(owner):
					record_layout(owner, records, definition.span).map(pure func(_): NoOwnership)
				_:
					value_ownership(definition.value_type, unions, records)

			ownership_result: Result[List[OwnerState], Diagnostic] = match plan:
				NoOwnership:
					match definition.result:
						UnmanagedResult:
							Ok(state.owners)
						_:
							Err(
								failure(
									definition.span,
									"unmanaged value carries an ownership obligation",
								),
							)
				ManagedStringLeaf:
					match definition.operation:
						ParameterDefinition(_):
							match definition.result:
								BorrowedResult:
									Ok(state.owners)
								_:
									Err(
										failure(
											definition.span,
											"managed parameter must be borrowed",
										),
									)
						CallDefinition(_, _):
							match definition.result:
								OwnedResult(owner):
									introduce_owner(state, owner, definition.id, definition.span)
								_:
									Err(
										failure(
											definition.span,
											"managed call result requires an owner",
										),
									)
						_:
							Err(failure(definition.span, "unsupported managed value operation"))

			owners ?= ownership_result

			parameters = match definition.operation:
				ParameterDefinition(_):
					state.parameters.append(definition.id)
				_:
					state.parameters

			Ok({ state |
					values = state.values.append({
						value_type = definition.value_type,
						span = definition.span,
					}),
					owners = owners,
					parameters = parameters
				})


private pure func verify_operation(
	operation: OwnershipOperation,
	state: VerificationState,
	signature: FunctionSignature,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	projection: ProjectionContext,
	records: List[ConcreteRecord],
) -> Result[VerificationState, Diagnostic]:
	match operation:
		DefineValue(definition):
			verify_definition(definition, state, signature, functions, unions, projection, records)
		AcquireOwner(id, borrow, span):
			valid ?= verify_borrow(borrow, state, span)
			owners ?= introduce_owner(state, id, borrow.value, span)
			Ok({ state | owners = owners })
		DropOwner(id, span):
			entry ?= owner(state, id, span)

			match entry:
				DischargedOwner:
					Err(
						failure(
							span,
							"owner "
								.append_int(owner_number(id))
								.concat(" has already been discharged"),
						),
					)
				ActiveOwner(_):
					Ok({ state | owners = state.owners.set(
								IntOps.subtract(owner_number(id), state.first_owner),
								DischargedOwner,
							) })


private pure func complete_owners(
	owners: List[OwnerState],
	first_owner: Int,
	span: Span,
) -> Result[Bool, Diagnostic]:
	var position = first_owner
	var failure_owner: Option[Int] = None

	for owner in owners:
		match owner:
			ActiveOwner(_):
				failure_owner = Some(position)
				break
			DischargedOwner:
				void

		position = IntOps.add(position, 1)

	match failure_owner:
		Some(id):
			Err(
				failure(
					span,
					"owner "
						.append_int(id)
						.concat(" remains live at return"),
				),
			)
		None:
			Ok(True)


private pure func verify_return(
	returned: ValueId,
	returned_owner: Option[OwnerId],
	state: VerificationState,
	return_type: TypeRef,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Bool, Diagnostic]:
	result ?= value(
		state,
		returned,
		{
			start = 0,
			end = 0
		},
	)

	if not same_type(result.value_type, return_type):
		Err(failure(result.span, "return type does not match its contract"))
	else:
		plan ?= value_ownership(return_type, unions, records)

		ownership_result: Result[List[OwnerState], Diagnostic] = match plan:
			NoOwnership:
				match returned_owner:
					None:
						Ok(state.owners)
					Some(_):
						Err(failure(result.span, "unmanaged return cannot transfer an owner"))
			ManagedStringLeaf:
				match returned_owner:
					None:
						Err(failure(result.span, "managed return requires an owner transfer"))
					Some(id):
						entry ?= owner(state, id, result.span)

						match entry:
							DischargedOwner:
								Err(
									failure(
										result.span,
										"return refers to discharged owner ".append_int(
											owner_number(id),
										),
									),
								)
							ActiveOwner(owned):
								if IntOps.equals(value_number(owned), value_number(returned)):
									Ok(
										state.owners.set(
											IntOps.subtract(owner_number(id), state.first_owner),
											DischargedOwner,
										),
									)
								else:
									Err(
										failure(
											result.span,
											"returned owner does not own the returned value",
										),
									)

		owners ?= ownership_result
		complete_owners(owners, state.first_owner, result.span)


private pure func verify_transfer(
	result: ReturnTransfer,
	state: VerificationState,
	return_type: TypeRef,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Bool, Diagnostic]:
	match result:
		UnmanagedReturn(value):
			verify_return(value, None, state, return_type, unions, records)
		OwnedReturn(value, owner):
			verify_return(value, Some(owner), state, return_type, unions, records)


private pure func verify_exit(
	exit: OwnedExit,
	state: VerificationState,
	signature: FunctionSignature,
	execution: FunctionExecution,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Bool, Diagnostic]:
	match exit:
		ReturnResult(result):
			verify_transfer(result, state, signature.return_type, unions, records)
		RecurArguments(arguments, span):
			mode ?= match execution:
				OrdinaryCalls:
					Err(failure(span, "recursive backedge outside a self-tail loop"))
				SelfTailLoop(_):
					Ok(True)

			arity ?= if IntOps.equals(arguments.length(), signature.parameters.length()):
				Ok(True)
			else:
				Err(failure(span, "recursive backedge arity does not match its function"))

			var invalid: Option[Diagnostic] = None
			var position: Int = 0

			for argument in arguments:
				parameter_position = position
				result: Result[Bool, Diagnostic] = value(
					state,
					argument,
					span,
				).and_then(pure func(known: KnownValue) -> Result[Bool, Diagnostic]:
					expected ?= signature.parameters
						.get(parameter_position)
						.to_result(failure(span, "missing recursive backedge parameter"))

					if not same_type(known.value_type, expected):
						Err(failure(span, "recursive backedge type does not match its parameter"))
					else:
						plan ?= value_ownership(known.value_type, unions, records)

						match plan:
							NoOwnership:
								Ok(True)
							ManagedStringLeaf:
								Err(failure(span, "managed value on a recursive backedge"))
				)

				match result:
					Err(error):
						invalid = Some(error)
						break
					Ok(_):
						position = IntOps.add(position, 1)

			match invalid:
				Some(error):
					Err(error)
				None:
					complete_owners(state.owners, state.first_owner, span)


private pure func is_backedge(exit: OwnedExit) -> Bool:
	match exit:
		ReturnResult(_):
			False
		RecurArguments(_, _):
			True


-- This preflight deliberately inspects raw definitions, including values whose
-- owners have already been dropped. The normal verifier still proves each type.
private pure func verify_loop_operations(
	operations: List[OwnershipOperation],
	current: Int,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Bool, Diagnostic]:
	var invalid: Option[Diagnostic] = None

	for operation in operations:
		match operation:
			DefineValue(definition):
				match value_ownership(definition.value_type, unions, records):
					Err(error):
						invalid = Some(error)
					Ok(ManagedStringLeaf):
						invalid = Some(
							failure(
								definition.span,
								"managed value appears in a self-tail loop",
							),
						)
					Ok(NoOwnership):
						void

				match definition.operation:
					CallDefinition(call, _):
						match call.target:
							UserFunction(id):
								if IntOps.equals(function_number(id), current):
									invalid = Some(
										failure(
											definition.span,
											"ordinary self call remains in a self-tail loop",
										),
									)
							RuntimeFunction(_):
								void
					_:
						void
			AcquireOwner(_, _, span):
				invalid = Some(failure(span, "owner operation appears in a self-tail loop"))
			DropOwner(_, span):
				invalid = Some(failure(span, "owner operation appears in a self-tail loop"))

		match invalid:
			Some(_):
				break
			None:
				void

	match invalid:
		Some(error):
			Err(error)
		None:
			Ok(True)


private pure func verify_execution(
	function: OwnedFunction,
	current: Int,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Bool, Diagnostic]:
	match function.execution:
		OrdinaryCalls:
			Ok(True)
		SelfTailLoop(annotation):
			var invalid: Option[Diagnostic] = None

			for value_type in function.signature.parameters.append(function.signature.return_type):
				match value_ownership(value_type, unions, records):
					Err(error):
						invalid = Some(error)
						break
					Ok(ManagedStringLeaf):
						invalid = Some(failure(annotation, "managed signature in a self-tail loop"))
						break
					Ok(NoOwnership):
						void

			valid ?= match invalid:
				Some(error):
					Err(error)
				None:
					Ok(True)

			prefix ?= verify_loop_operations(function.operations, current, unions, records)
			var found = False

			match function.tail:
				ReturnTail(exit):
					found = is_backedge(exit)
				MatchTail(matched):
					for arm in matched.arms:
						match verify_loop_operations(arm.operations, current, unions, records):
							Err(error):
								invalid = Some(error)
								break
							Ok(_):
								found = found or is_backedge(arm.exit)

			checked ?= match invalid:
				Some(error):
					Err(error)
				None:
					Ok(True)

			if found:
				Ok(True)
			else:
				Err(failure(annotation, "self-tail loop has no recursive backedge"))


-- OwnershipProgram is public raw data: its reconstructed arms do not retain
-- checking's sealed proof of coverage and usefulness. Re-establish that proof
-- here so emission can project the accepted labels without repairing them.
private pure func verify_match_arms(
	matched: OwnedMatch,
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[Bool, Diagnostic]:
	nonempty ?= if IntOps.equals(matched.arms.length(), 0):
		Err(failure(span, "match has no arms"))
	else:
		Ok(True)

	declaration ?= unions
		.get(union_number(matched.owner))
		.to_result(failure(span, "unknown match union"))
	var seen: List[Bool] = []

	for _ in declaration.variants:
		seen = seen.append(False)

	var remaining = seen.length()
	var has_default = False
	var invalid: Option[Diagnostic] = None

	for arm in matched.arms:
		match arm.label:
			DefaultLabel:
				if has_default:
					invalid = Some(failure(span, "match default appears more than once"))
					break
				else if IntOps.equals(remaining, 0):
					invalid = Some(failure(span, "match default covers no remaining variants"))
					break
				else:
					has_default = True
			VariantLabel(id):
				if IntOps.not_equals(union_number(variant_owner(id)), union_number(matched.owner)):
					invalid = Some(failure(span, "match variant belongs to another union"))
					break
				else:
					ordinal = variant_number(id)

					match seen.get(ordinal):
						None:
							invalid = Some(failure(span, "unknown variant identity"))
							break
						Some(already_seen):
							if already_seen:
								invalid = Some(
									failure(
										span,
										"match variant appears more than once",
									),
								)
								break
							else if has_default:
								invalid = Some(failure(span, "match default must be the final arm"))
								break
							else:
								seen = seen.set(ordinal, True)
								remaining = IntOps.subtract(remaining, 1)

	match invalid:
		Some(error):
			Err(error)
		None:
			if not has_default and IntOps.not_equals(remaining, 0):
				Err(failure(span, "match does not cover every variant"))
			else:
				Ok(True)


private pure func verify_match(
	matched: OwnedMatch,
	execution: FunctionExecution,
	state: VerificationState,
	signature: FunctionSignature,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Bool, Diagnostic]:
	scrutinee ?= value(
		state,
		matched.scrutinee,
		{
			start = 0,
			end = 0
		},
	)

	if not same_type(scrutinee.value_type, UnionType(matched.owner)):
		Err(failure(scrutinee.span, "match scrutinee does not belong to its union"))
	else:
		valid_arms ?= verify_match_arms(matched, unions, scrutinee.span)
		var next_value = IntOps.add(state.first_value, state.values.length())
		var next_owner = IntOps.add(state.first_owner, state.owners.length())
		var invalid: Option[Diagnostic] = None

		-- Arms return or recur: each borrows the function prefix and owns one local
		-- interval. The managed-prefix rejection below guarantees no prefix owners.
		for arm in matched.arms:
			var branch = { state |
				prefix_values = state.values,
				first_value = next_value,
				values = [],
				first_owner = next_owner,
				owners = []
			}

			projection = match arm.label:
				DefaultLabel:
					NoProjection
				VariantLabel(id):
					PayloadProjection(matched.scrutinee, id)

			for operation in arm.operations:
				match verify_operation(
					operation,
					branch,
					signature,
					functions,
					unions,
					projection,
					records,
				):
					Ok(updated):
						branch = updated
					Err(error):
						invalid = Some(error)
						break

			match invalid:
				Some(_):
					break
				None:
					match verify_exit(arm.exit, branch, signature, execution, unions, records):
						Ok(_):
							next_value = IntOps.add(branch.first_value, branch.values.length())
							next_owner = IntOps.add(branch.first_owner, branch.owners.length())
						Err(error):
							invalid = Some(error)
							break

		match invalid:
			Some(error):
				Err(error)
			None:
				Ok(True)


private pure func verify_function(
	function: OwnedFunction,
	current: Int,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Bool, Diagnostic]:
	execution ?= verify_execution(function, current, unions, records)
	var state: VerificationState = {
		prefix_values = [],
		first_value = 0,
		values = [],
		first_owner = 0,
		owners = [],
		parameters = []
	}
	var invalid: Option[Diagnostic] = None

	for operation in function.operations:
		match verify_operation(
			operation,
			state,
			function.signature,
			functions,
			unions,
			NoProjection,
			records,
		):
			Ok(updated):
				state = updated
			Err(error):
				invalid = Some(error)
				break

	match invalid:
		Some(error):
			Err(error)
		None:
			valid_parameter ?= if IntOps.equals(
				state.parameters.length(),
				function.signature.parameters.length(),
			):
				Ok(True)
			else:
				Err(
					failure(
						{
							start = 0,
							end = 0
						},
						"function parameter has no value definition",
					),
				)

			match function.tail:
				ReturnTail(result):
					verify_exit(
						result,
						state,
						function.signature,
						function.execution,
						unions,
						records,
					)
				MatchTail(matched):
					-- This restriction is checked independently of the inserter,
					-- including managed prefix values already dropped by the tail.
					var managed: Option[Span] = None

					for known in state.values:
						match known.value_type:
							StringType:
								managed = Some(known.span)
								break
							_:
								void

					match managed:
						Some(span):
							Err(failure(span, "managed value appears before a tail match"))
						None:
							verify_match(
								matched,
								function.execution,
								state,
								function.signature,
								functions,
								unions,
								records,
							)


-- C main calls the entry without arguments and consumes an Int. Enforcing
-- that contract here prevents a transferred managed result being discarded.
private pure func verify_entry(entry: OwnedFunction) -> Result[Bool, Diagnostic]:
	valid = (
		IntOps.equals(entry.signature.parameters.length(), 0)
		and same_type(entry.signature.return_type, IntType)
	)

	if valid:
		Ok(True)
	else:
		span: Span = match entry.operations.get(0):
			Some(operation):
				match operation:
					DefineValue(definition):
						definition.span
					AcquireOwner(_, _, occurrence):
						occurrence
					DropOwner(_, occurrence):
						occurrence
			None:
				{
					start = 0,
					end = 0
				}

		Err(failure(span, "entrypoint must take no parameters and return Int"))


pure func verify(program: OwnershipProgram) -> Result[VerifiedProgram, Diagnostic]:
	entry ?= program.functions
		.get(function_number(program.entrypoint))
		.to_result(
			failure(
				{
					start = 0,
					end = 0
				},
				"entrypoint function is not defined",
			),
		)
	var invalid: Option[Diagnostic] = None

	for layout in program.records:
		match (
			valid_record_layout(
				layout,
				{
					start = 0,
					end = 0
				},
			)
		):
			Ok(_):
				void
			Err(error):
				invalid = Some(error)
				break

	for layout in program.unions:
		if invalid.is_some():
			break

		if IntOps.equals(layout.variants.length(), 0):
			invalid = Some(
				failure(
					{
						start = 0,
						end = 0
					},
					"union layout must contain one or more variants",
				),
			)
			break

	var current: Int = 0

	for function in program.functions:
		if invalid.is_some():
			break

		match verify_function(
			function,
			current,
			program.functions,
			program.unions,
			program.records,
		):
			Ok(_):
				current = IntOps.add(current, 1)
			Err(error):
				invalid = Some(error)
				break

	match invalid:
		Some(error):
			Err(error)
		None:
			valid_entry ?= verify_entry(entry)
			Ok(into_opaque VerifiedProgram(program))
