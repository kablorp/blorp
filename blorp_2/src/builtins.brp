import:
	declarations: inventory_functions, inventory_records, inventory_unions
	names: InitialNames, NameId, same_name
	option: to_result
	assemble: ParsedContents, ParsedProgram, ParsedBuiltinDeclaration, parsed_contents
	source: same_module
	syntax:
		Diagnostic,
		ParsedBuiltinType(IntegerBuiltin, FloatBuiltin, StringBuiltin, VoidBuiltin, ListBuiltin),
		ParsedRuntimeOperation(
			IntegerAddBuiltin, IntegerSubtractBuiltin, IntegerMultiplyBuiltin, IntegerDivideBuiltin,
			IntegerRemainderBuiltin, IntegerToStringBuiltin, StringLengthBuiltin,
			FloatAddBuiltin, FloatSubtractBuiltin, FloatMultiplyBuiltin, FloatDivideBuiltin,
			FloatRemainderBuiltin, FloatToStringBuiltin, StringParseFloatBuiltin,
			StringPrintBuiltin, StringParseIntBuiltin, ListLengthBuiltin, ListGetBuiltin, StringEqualsBuiltin, IntegerEqualsBuiltin,
		),
		Purity(Pure, Impure),
		Span,
		WrittenName,
	text as Text


fixed record OptionalRoles[Variant] {
	present: Variant,
	absent: Variant
}


fixed record BooleanRoles[Variant] {
	equal: Variant,
	different: Variant
}


fixed union RuntimeOperation[Variant]:
	IntAdd
	IntSubtract
	IntMultiply
	IntDivide
	IntRemainder
	IntToString
	FloatAdd
	FloatSubtract
	FloatMultiply
	FloatDivide
	FloatRemainder
	FloatToString
	StringLength
	StringPrint
	StringParseInt(OptionalRoles[Variant])
	StringParseFloat(OptionalRoles[Variant])
	ListLength
	ListGet(OptionalRoles[Variant])
	StringEquals(BooleanRoles[Variant])
	IntEquals(BooleanRoles[Variant])


fixed union PrimitiveType:
	BuiltinInt
	BuiltinFloat
	BuiltinString
	BuiltinVoid


fixed union RuntimeResult[Variant]:
	PrimitiveResult(PrimitiveType)
	OptionalResult(PrimitiveType, OptionalRoles[Variant])
	BooleanResult(BooleanRoles[Variant])


-- These closed operations need one concrete container parameter, not generic
-- runtime functions or arbitrary element descriptors.
fixed union RuntimeParameter:
	PrimitiveParameter(PrimitiveType)
	StringListParameter


fixed record RuntimeContract[Variant] {
	purity: Purity,
	parameters: List[RuntimeParameter],
	return_type: RuntimeResult[Variant]
}


-- One closed contract authority, shared across declaration and instance roles.
pure func runtime_contract[Variant](
	operation: RuntimeOperation[Variant],
) -> RuntimeContract[Variant]:
	match operation:
		StringPrint:
			{ purity = Impure, parameters = [PrimitiveParameter(BuiltinString)], return_type = PrimitiveResult(BuiltinVoid) }
		IntAdd | IntSubtract | IntMultiply | IntDivide | IntRemainder:
			{ purity = Pure, parameters = [PrimitiveParameter(BuiltinInt), PrimitiveParameter(BuiltinInt)], return_type = PrimitiveResult(BuiltinInt) }
		FloatAdd | FloatSubtract | FloatMultiply | FloatDivide | FloatRemainder:
			{ purity = Pure, parameters = [PrimitiveParameter(BuiltinFloat), PrimitiveParameter(BuiltinFloat)], return_type = PrimitiveResult(BuiltinFloat) }
		FloatToString:
			{ purity = Pure, parameters = [PrimitiveParameter(BuiltinFloat)], return_type = PrimitiveResult(BuiltinString) }
		IntToString:
			{ purity = Pure, parameters = [PrimitiveParameter(BuiltinInt)], return_type = PrimitiveResult(BuiltinString) }
		StringLength:
			{ purity = Pure, parameters = [PrimitiveParameter(BuiltinString)], return_type = PrimitiveResult(BuiltinInt) }
		StringParseInt(roles):
			{ purity = Pure, parameters = [PrimitiveParameter(BuiltinString)], return_type = OptionalResult(BuiltinInt, roles) }
		StringParseFloat(roles):
			{ purity = Pure, parameters = [PrimitiveParameter(BuiltinString)], return_type = OptionalResult(BuiltinFloat, roles) }
		ListLength:
			{ purity = Pure, parameters = [StringListParameter], return_type = PrimitiveResult(BuiltinInt) }
		ListGet(roles):
			{ purity = Pure, parameters = [StringListParameter, PrimitiveParameter(BuiltinInt)], return_type = OptionalResult(BuiltinString, roles) }
		IntEquals(roles):
			{ purity = Pure, parameters = [PrimitiveParameter(BuiltinInt), PrimitiveParameter(BuiltinInt)], return_type = BooleanResult(roles) }
		StringEquals(roles):
			{ purity = Pure, parameters = [PrimitiveParameter(BuiltinString), PrimitiveParameter(BuiltinString)], return_type = BooleanResult(roles) }


pure func builtin_operation(parsed: ParsedRuntimeOperation) -> RuntimeOperation[WrittenName]:
	match parsed:
		IntegerAddBuiltin: IntAdd
		IntegerSubtractBuiltin: IntSubtract
		IntegerMultiplyBuiltin: IntMultiply
		IntegerDivideBuiltin: IntDivide
		IntegerRemainderBuiltin: IntRemainder
		FloatAddBuiltin: FloatAdd
		FloatSubtractBuiltin: FloatSubtract
		FloatMultiplyBuiltin: FloatMultiply
		FloatDivideBuiltin: FloatDivide
		FloatRemainderBuiltin: FloatRemainder
		FloatToStringBuiltin: FloatToString
		IntegerToStringBuiltin: IntToString
		StringLengthBuiltin: StringLength
		StringPrintBuiltin: StringPrint
		StringParseIntBuiltin(present, absent): StringParseInt({ present = present, absent = absent })
		StringParseFloatBuiltin(present, absent): StringParseFloat({ present = present, absent = absent })
		ListGetBuiltin(present, absent): ListGet({ present = present, absent = absent })
		ListLengthBuiltin: ListLength
		StringEqualsBuiltin(equal, different): StringEquals({ equal = equal, different = different })
		IntegerEqualsBuiltin(equal, different): IntEquals({ equal = equal, different = different })


-- Generic callers of this helper admit only operations without constructor roles.
pure func primitive_operation[Variant](parsed: ParsedRuntimeOperation) -> Option[RuntimeOperation[Variant]]:
	match parsed:
		IntegerAddBuiltin: Some(IntAdd)
		IntegerSubtractBuiltin: Some(IntSubtract)
		IntegerMultiplyBuiltin: Some(IntMultiply)
		IntegerDivideBuiltin: Some(IntDivide)
		IntegerRemainderBuiltin: Some(IntRemainder)
		FloatAddBuiltin: Some(FloatAdd)
		FloatSubtractBuiltin: Some(FloatSubtract)
		FloatMultiplyBuiltin: Some(FloatMultiply)
		FloatDivideBuiltin: Some(FloatDivide)
		FloatRemainderBuiltin: Some(FloatRemainder)
		FloatToStringBuiltin: Some(FloatToString)
		IntegerToStringBuiltin: Some(IntToString)
		StringLengthBuiltin: Some(StringLength)
		StringPrintBuiltin: Some(StringPrint)
		ListLengthBuiltin: Some(ListLength)
		StringParseIntBuiltin(_, _) | StringParseFloatBuiltin(_, _) | ListGetBuiltin(_, _) | StringEqualsBuiltin(_, _) | IntegerEqualsBuiltin(_, _): None


pure func runtime_declaration_help[Variant](operation: RuntimeOperation[Variant]) -> String:
	match operation:
		StringPrint: "declare an impure function with one String parameter returning Void"
		IntAdd | IntSubtract | IntMultiply | IntDivide | IntRemainder: "declare a pure function with two Int parameters returning Int"
		FloatAdd | FloatSubtract | FloatMultiply | FloatDivide | FloatRemainder: "declare a pure function with two Float parameters returning Float"
		FloatToString: "declare a pure function with one Float parameter returning String"
		IntToString: "declare a pure function with one Int parameter returning String"
		StringLength: "declare a pure function with one String parameter returning Int"
		StringParseInt(_): "declare a pure nongeneric function with one String parameter returning a two-variant union of Int and an empty case"
		StringParseFloat(_): "declare a pure nongeneric function with one String parameter returning a two-variant union of Float and an empty case"
		ListGet(_): "declare a pure nongeneric function with List[String] and Int parameters returning a two-variant union of String and an empty case"
		ListLength: "declare a pure function with one List[String] parameter returning Int"
		IntEquals(_): "declare a pure nongeneric function with two Int parameters returning a union of two empty variants"
		StringEquals(_): "declare a pure nongeneric function with two String parameters returning a union of two empty variants"


fixed union BuiltinTypeRole:
	IntegerType
	FloatType
	StringType
	VoidType
	ListType


fixed union BuiltinTypeErrorKind:
	DuplicateBuiltinType(BuiltinTypeRole)
	MissingBuiltinType(BuiltinTypeRole)
	BuiltinOutsideFoundation
	FoundationImports
	FoundationFunctions
	FoundationTypeConflict(BuiltinTypeRole)


fixed record BuiltinTypeError {
	span: Span,
	kind: BuiltinTypeErrorKind
}


private pure func builtin_type_error(span: Span, kind: BuiltinTypeErrorKind) -> BuiltinTypeError:
	{ span = span, kind = kind }


pure func builtin_type_name(declaration: ParsedBuiltinType) -> WrittenName:
	match declaration:
		IntegerBuiltin(name): name
		FloatBuiltin(name): name
		StringBuiltin(name): name
		VoidBuiltin(name): name
		ListBuiltin(name): name


private pure func builtin_type_role(declaration: ParsedBuiltinType) -> BuiltinTypeRole:
	match declaration:
		IntegerBuiltin(_): IntegerType
		FloatBuiltin(_): FloatType
		StringBuiltin(_): StringType
		VoidBuiltin(_): VoidType
		ListBuiltin(_): ListType


-- First-match scans read the whole list and keep the first hit; see type_conflict in namespace.brp.
private pure func foundation_type_conflict(name: WrittenName, builtins: List[ParsedBuiltinDeclaration]) -> Option[BuiltinTypeError]:
	var conflict: Option[BuiltinTypeError] = None
	for row in builtins:
		if conflict.is_none() and same_name(name.id, builtin_type_name(row.declaration).id):
			conflict = Some(builtin_type_error(name.span, FoundationTypeConflict(builtin_type_role(row.declaration))))
	conflict


-- Base declarations share the same type namespace as the primitive heads.
-- Other modules import base types, so the namespace reports their conflicts;
-- the base itself needs this check before its own declarations are published.
private pure func check_nominal_types(parsed: ParsedContents) -> Result[Void, BuiltinTypeError]:
	var conflict: Option[BuiltinTypeError] = None
	for declaration in inventory_unions(parsed.declarations):
		if conflict.is_none() and same_module(declaration.module, parsed.foundation.types):
			conflict = foundation_type_conflict(declaration.type_name, parsed.builtin_types)
	for row in inventory_records(parsed.declarations):
		declaration = row.declaration
		if conflict.is_none() and same_module(declaration.module, parsed.foundation.types):
			conflict = foundation_type_conflict(declaration.type_name, parsed.builtin_types)
	match conflict:
		Some(error): Err(error)
		None: Ok(void)


private pure func reject_at(found: Option[Span], kind: BuiltinTypeErrorKind) -> Result[Void, BuiltinTypeError]:
	match found:
		Some(span): Err(builtin_type_error(span, kind))
		None: Ok(void)


-- The foundation types module only declares types.
private pure func check_foundation_shape(parsed: ParsedContents) -> Result[Void, BuiltinTypeError]:
	var function_span: Option[Span] = None
	for row in inventory_functions(parsed.declarations):
		function = row.declaration
		if function_span.is_none() and same_module(function.module, parsed.foundation.types):
			function_span = Some(function.function_name.span)
	functionless ?= reject_at(function_span, FoundationFunctions)
	var import_span: Option[Span] = None
	for row in parsed.modules:
		if same_module(row.module, parsed.foundation.types):
			match row.imports.get(0):
				Some(request): import_span = Some(request.span)
				None: void
	reject_at(import_span, FoundationImports)


private pure func same_role(left: BuiltinTypeRole, right: BuiltinTypeRole) -> Bool:
	match left:
		IntegerType:
			match right:
				IntegerType: True
				_: False
		FloatType:
			match right:
				FloatType: True
				_: False
		StringType:
			match right:
				StringType: True
				_: False
		VoidType:
			match right:
				VoidType: True
				_: False
		ListType:
			match right:
				ListType: True
				_: False


-- Each builtin declaration must be in the foundation module and the first of its role.
private pure func accept_builtins(parsed: ParsedContents, accepted: List[ParsedBuiltinDeclaration]) -> Result[List[ParsedBuiltinDeclaration], BuiltinTypeError]:
	match parsed.builtin_types.get(accepted.length()):
		None:
			Ok(accepted)
		Some(row):
			role = builtin_type_role(row.declaration)
			span = builtin_type_name(row.declaration).span
			var repeated = False
			for earlier in accepted:
				repeated = repeated or same_role(builtin_type_role(earlier.declaration), role)
			valid ?= if not same_module(row.module, parsed.foundation.types):
				Err(builtin_type_error(span, BuiltinOutsideFoundation))
			else if repeated:
				Err(builtin_type_error(span, DuplicateBuiltinType(role)))
			else:
				Ok(void)
			accept_builtins(parsed, accepted.append(row))


-- Accepted declarations name each role at most once; a missing one ends the foundation module.
private pure func builtin_head(accepted: List[ParsedBuiltinDeclaration], role: BuiltinTypeRole, end: Span) -> Result[NameId, BuiltinTypeError]:
	var head: Option[NameId] = None
	for row in accepted:
		if same_role(builtin_type_role(row.declaration), role):
			head = Some(builtin_type_name(row.declaration).id)
	head.to_result(builtin_type_error(end, MissingBuiltinType(role)))


-- Primitive names are checked once from the sealed designated source inventory.
-- Ordinary unions remain nominal declarations owned by the normal namespace.
-- There is no invalid-name error: the parser assigns each builtin's role from its
-- spelling and append_module rejects a foreign name table, so every name id here
-- has a spelling and the five role names and the entrypoint are distinct.
pure func check_builtin_types(program: ParsedProgram) -> Result[InitialNames, BuiltinTypeError]:
	parsed = parsed_contents(program)
	-- A missing builtin declaration is reported at the end of the foundation types module.
	var end = parsed.end
	for row in parsed.modules:
		if same_module(row.module, parsed.foundation.types):
			end = row.end
	shaped ?= check_foundation_shape(parsed)
	accepted ?= accept_builtins(parsed, [])
	integer_id ?= builtin_head(accepted, IntegerType, end)
	string_id ?= builtin_head(accepted, StringType, end)
	unit_id ?= builtin_head(accepted, VoidType, end)
	float_id ?= builtin_head(accepted, FloatType, end)
	list_id ?= builtin_head(accepted, ListType, end)
	nominal ?= check_nominal_types(parsed)
	Ok({ names = parsed.names, special = {
		main = parsed.entrypoint, integer = integer_id, float = float_id, string = string_id,
		unit = unit_id, list = list_id,
	} })


private pure func builtin_type_spelling(role: BuiltinTypeRole) -> String:
	match role:
		IntegerType: "Int"
		FloatType: "Float"
		StringType: "String"
		VoidType: "Void"
		ListType: "List"


private pure func builtin_type_declaration(role: BuiltinTypeRole) -> String:
	match role:
		ListType: "type List[T] = builtin"
		_: Text.concat("type ", builtin_type_spelling(role)).concat(" = builtin")


pure func render_builtin_type_error(error: BuiltinTypeError) -> Diagnostic:
	message = match error.kind:
		DuplicateBuiltinType(_): "duplicate builtin type declaration"
		MissingBuiltinType(role): Text.concat("missing ", builtin_type_spelling(role)).concat(" builtin declaration")
		BuiltinOutsideFoundation: "builtin type declarations belong in the configured foundation module"
		FoundationImports: "foundation types cannot import modules"
		FoundationFunctions: "foundation types cannot declare functions"
		FoundationTypeConflict(_): "foundation type conflicts with a builtin declaration"
	help = match error.kind:
		DuplicateBuiltinType(role): Text.concat("declare ", builtin_type_declaration(role)).concat(" exactly once")
		MissingBuiltinType(role): Text.concat("add ", builtin_type_declaration(role)).concat(" to _base.brp")
		BuiltinOutsideFoundation: "remove this declaration; builtin types are supplied by _base.brp under --library-root"
		FoundationImports: "keep _base.brp independent; put operation imports in prelude.brp"
		FoundationFunctions: "move functions to a library operation module and select its methods in prelude.brp"
		FoundationTypeConflict(role): Text.concat("remove or rename this fixed union or record; ", builtin_type_spelling(role)).concat(" is owned by its builtin declaration")
	{ span = error.span, note = None, message = message, help = help }
