import:
	option: Option methods
	bool: not, and, or
	int: Int methods
	../utils/names: NameTable, intern_names
	../utils/source: compiler_source, SourceId
	string: String methods
	../utils/text as Text
	../utils/syntax:
		Diagnostic,
		Keyword(
			PureKeyword, FunctionKeyword, MatchKeyword, VarKeyword, VoidKeyword,
			IfKeyword, ElseKeyword, AndKeyword, OrKeyword, NotKeyword, WhileKeyword, ForKeyword, InKeyword,
			BreakKeyword, ContinueKeyword, ImportKeyword, TypeKeyword, PrivateKeyword, RecordKeyword, UnionKeyword,
			BuiltinKeyword, AsKeyword, OpaqueKeyword, IntoOpaqueKeyword, FromOpaqueKeyword,
			AliasKeyword, DebugKeyword, DetachKeyword, ForeignKeyword, FromKeyword, ImplementsKeyword, ResourceKeyword, SelectKeyword, TraitKeyword, TryKeyword, WhereKeyword,
		),
		LexedProgram,
		Spacing(Adjacent, Spaced),
		Symbol(
			Wildcard, LeftParen, RightParen, Dot, Arrow,
			Colon, Newline, Indent, Dedent, Equals, EqualsEquals, NotEquals, Less, Greater, LessEquals, GreaterEquals, QuestionEquals, LeftBracket,
			RightBracket, LeftBrace, RightBrace, Bar, Comma, AtSign, Slash, Star, Plus, DotDot, Ellipsis,
		),
		Token,
		TokenKind(IdentifierToken, KeywordToken, SymbolToken, IntegerLiteral, FloatLiteral, QuotedString, PipeString, StringStart, StringSegment, InterpolationOpen, InterpolationClose, StringEnd, CharLiteral),
		StringForm(QuotedStringForm, PipeStringForm),
		UTF8_CONTINUATION_END,
		UTF8_CONTINUATION_START,
		diagnostic,


-- The bytes being lexed and the source identity of every span made from them.
private fixed record SourceText {
	origin: SourceId,
	bytes: String
}


private fixed record ErrorText {
	message: String,
	help: String
}


private pure func invalid_indentation() -> ErrorText:
	{
		message = "invalid indentation",
		help = "use tabs only, or spaces in groups of four; do not mix tabs and spaces"
	}


private pure func inconsistent_indentation() -> ErrorText:
	{
		message = "inconsistent indentation",
		help = "indent every line of a block by the same amount, and dedent only to the indentation of an enclosing block (a tab counts as 4 columns)"
	}


private pure func line_ending() -> ErrorText:
	{
		message = "only LF line endings are supported",
		help = "replace CRLF or CR line endings with LF"
	}


private pure func separating_tab() -> ErrorText:
	{
		message = "tabs are allowed only in the body indentation",
		help = "separate tokens with spaces and indent the body deeper than its header"
	}


private pure func comment_byte() -> ErrorText:
	{
		message = "unsupported byte in comment",
		help = "use ASCII bytes in single-line comments"
	}


private pure func unsupported_character() -> ErrorText:
	{
		message = "unsupported character",
		help = "use ASCII function declarations and numeric literals, parameter names, or calls; keep -> adjacent"
	}


-- A comparison or lambda spelling from another language; the help names Blorp's.
private pure func foreign_operator(spelling: String, help: String) -> ErrorText:
	{ message = "'${spelling}' is not an operator", help = help }


private pure func plus_sign() -> ErrorText:
	{
		message = "source numeric literals cannot start with '+'",
		help = "remove the leading '+'; use an adjacent '-' for a negative literal"
	}


private pure func separated_minus() -> ErrorText:
	{
		message = "expected decimal digits immediately after '-'",
		help = "write a signed number such as -42 or -0.5; '-' is not an operator"
	}


private pure func numeric_suffix() -> ErrorText:
	{
		message = "numeric literals cannot have suffixes or separators",
		help = "write decimal digits with an optional fractional part or exponent; use no underscores or type suffixes"
	}


private pure func missing_exponent() -> ErrorText:
	{
		message = "expected decimal digits in Float exponent",
		help = "write a decimal Float such as 1.0, 0.5 or 1e2; an exponent needs at least one digit"
	}


private pure func missing_fraction() -> ErrorText:
	{
		message = "Float literals need digits after the decimal point",
		help = "write 1.0; otherwise use a UFCS function call after '.'"
	}


private pure func invalid_utf8() -> ErrorText:
	{
		message = "invalid UTF-8 in String literal",
		help = "use valid UTF-8 text or a Unicode escape such as \\u{E9}; surrogate code points are not Unicode scalars"
	}


private pure func string_line_break() -> ErrorText:
	{
		message = "String literals must stay on one line",
		help = "close the quote before LF; write \\n for a newline byte"
	}


private pure func raw_control_byte() -> ErrorText:
	{
		message = "unsupported raw byte in String literal",
		help = "use printable text and fixed escapes for control bytes"
	}


private pure func unterminated_string() -> ErrorText:
	{
		message = "unterminated String literal",
		help = "add a closing double quote on the same line"
	}


private pure func unterminated_escape() -> ErrorText:
	{
		message = "unterminated String escape",
		help = "complete the escape and close the double quote on the same line"
	}


private pure func char_width() -> ErrorText:
	{
		message = "Char literals hold one character",
		help = "write one character or one escape between single quotes, such as 'a' or '\\n'"
	}


private pure func unterminated_char() -> ErrorText:
	{
		message = "unterminated Char literal",
		help = "add the closing single quote on the same line"
	}


private pure func char_control_byte() -> ErrorText:
	{
		message = "unsupported raw byte in Char literal",
		help = "use a printable character or a fixed escape such as '\\t'"
	}


private pure func nested_interpolation() -> ErrorText:
	{
		message = "an interpolated String cannot appear inside an interpolation hole",
		help = "bind the inner interpolated String before the outer String, then use that binding in the hole"
	}


private pure func unclosed_interpolation() -> ErrorText:
	{
		message = "unterminated interpolation hole",
		help = "close the hole with '}' on the same line; each hole holds one expression"
	}


private pure func unclosed_hole_string() -> ErrorText:
	{
		message = "unterminated quoted String in interpolation hole",
		help = "close the nested quote and then close the hole with '}' on the same line"
	}


private pure func doc_block_in_brackets() -> ErrorText:
	{
		message = "documentation block inside brackets",
		help = "close the bracket before the --- fence, or put the block before a declaration"
	}


private pure func unterminated_doc_block() -> ErrorText:
	{
		message = "unterminated documentation block",
		help = "close the block with a line holding only --- at column 1"
	}


-- A documentation fence is three dashes alone on their line.
private DOC_FENCE_WIDTH: Int = 3


private SPACE_INDENT_WIDTH: Int = 4

-- Bytes below SPACE, and DEL, are ASCII controls.
private ASCII_SPACE: Int = 32

private ASCII_DEL: Int = 127

-- ASCII codes used by the source classifiers and punctuation dispatch.
private ASCII_TAB: Int = 9
private ASCII_LF: Int = 10
private ASCII_CR: Int = 13
private ASCII_DOUBLE_QUOTE: Int = 34
private ASCII_DOLLAR: Int = 36
private ASCII_SINGLE_QUOTE: Int = 39
private ASCII_LEFT_PAREN: Int = 40
private ASCII_RIGHT_PAREN: Int = 41
private ASCII_STAR: Int = 42
private ASCII_PLUS: Int = 43
private ASCII_COMMA: Int = 44
private ASCII_MINUS: Int = 45
private ASCII_DOT: Int = 46
private ASCII_SLASH: Int = 47
private ASCII_ZERO: Int = 48
private ASCII_NINE: Int = 57
private ASCII_COLON: Int = 58
private ASCII_EXCLAMATION: Int = 33

private ASCII_LESS: Int = 60
private ASCII_EQUALS: Int = 61
private ASCII_GREATER: Int = 62
private ASCII_QUESTION: Int = 63
private ASCII_AT_SIGN: Int = 64
private ASCII_UPPER_A: Int = 65
private ASCII_UPPER_E: Int = 69
private ASCII_UPPER_Z: Int = 90
private ASCII_LEFT_BRACKET: Int = 91
private ASCII_BACKSLASH: Int = 92
private ASCII_RIGHT_BRACKET: Int = 93
private ASCII_UNDERSCORE: Int = 95
private ASCII_LOWER_A: Int = 97
private ASCII_LOWER_E: Int = 101
private ASCII_LOWER_R: Int = 114
private ASCII_LOWER_W: Int = 119
private ASCII_LOWER_Z: Int = 122
private ASCII_LEFT_BRACE: Int = 123
private ASCII_BAR: Int = 124
private ASCII_RIGHT_BRACE: Int = 125

private UNICODE_SURROGATE_START: Int = 55296

private UNICODE_SURROGATE_END: Int = 57343

private UNICODE_MAX: Int = 1114111


-- One UTF-8 encoding width from RFC 3629 section 4. Its lead range excludes
-- the overlong leads C0 and C1 and every lead above F4; `minimum` rejects the
-- remaining overlong (non-shortest) encodings of that width.
private fixed record Utf8Form {
	width: Int,
	first_lead: Int,
	last_lead: Int,
	lead_marker: Int,
	minimum: Int
}


-- Leads C2..DF (110xxxxx) encode U+0080 through U+07FF.
private pure func utf8_two_bytes() -> Utf8Form:
	{ width = 2, first_lead = 194, last_lead = 223, lead_marker = 192, minimum = 128 }


-- Leads E0..EF (1110xxxx) encode U+0800 through U+FFFF.
private pure func utf8_three_bytes() -> Utf8Form:
	{ width = 3, first_lead = 224, last_lead = 239, lead_marker = 224, minimum = 2048 }


-- Leads F0..F4 (11110xxx) encode U+10000 through U+10FFFF.
private pure func utf8_four_bytes() -> Utf8Form:
	{ width = 4, first_lead = 240, last_lead = 244, lead_marker = 240, minimum = 65536 }


-- Each continuation byte carries six payload bits.
private UTF8_CONTINUATION_RADIX: Int = 64


-- The byte sets that runs of source bytes are scanned over.
private fixed union ByteClass:
	SpaceByte
	TabByte
	IndentationByte
	DecimalDigit
	IdentifierStart
	IdentifierByte


-- A line's start and the end of its indentation prefix.
private fixed record LinePrefix {
	start: Int,
	end: Int
}


-- A code line's indentation and level. At the end of the source it is an empty
-- line at level 0, which closes every open level. All-Int records are inline.
private fixed record CodeLine {
	prefix: LinePrefix,
	level: Int
}


private pure func within(value: Int, first: Int, last: Int) -> Bool:
	and(value.greater_than_or_equal(first), value.less_than_or_equal(last))


private pure func in_class(code: Int, class: ByteClass) -> Bool:
	match class:
		SpaceByte:
			code == ASCII_SPACE
		TabByte:
			code == ASCII_TAB
		IndentationByte:
			or(code == ASCII_SPACE, code == ASCII_TAB)
		DecimalDigit:
			within(code, ASCII_ZERO, ASCII_NINE)
		IdentifierStart:
			or(
				or(
					within(code, ASCII_LOWER_A, ASCII_LOWER_Z),
					within(code, ASCII_UPPER_A, ASCII_UPPER_Z),
				),
				code == ASCII_UNDERSCORE,
			)
		IdentifierByte:
			or(in_class(code, IdentifierStart), in_class(code, DecimalDigit))


-- Byte reads compare codes: a one-byte substring would allocate a String.
private pure func byte_is(text: SourceText, position: Int, expected: Int) -> Bool:
	match text.bytes.byte_at(position):
		Some(byte):
			byte == expected
		None:
			False


-- Whether a byte of `class` is at `position`; there is none at the end.
private pure func byte_in(text: SourceText, position: Int, class: ByteClass) -> Bool:
	match text.bytes.byte_at(position):
		Some(byte):
			in_class(byte, class)
		None:
			False


-- The first position at or after `start` whose byte is not in `class`.
private pure func run_end(text: SourceText, start: Int, class: ByteClass) -> Int:
	var end: Int = start

	while byte_in(text, end, class):
		end = end.add(1)

	end


private pure func error_at(text: SourceText, start: Int, end: Int, error: ErrorText) -> Diagnostic:
	diagnostic({ source = text.origin, start = start, end = end }, error.message, error.help)


private pure func byte_error(text: SourceText, position: Int, error: ErrorText) -> Diagnostic:
	error_at(text, position, position.add(1), error)


-- Layout tokens get spacing too; no syntax reads it there.
private pure func token(text: SourceText, kind: TokenKind, start: Int, end: Int) -> Token:
	previous = start.subtract(1)
	spacing: Spacing = if byte_in(text, previous, IndentationByte):
		Spaced
	else:
		Adjacent

	{
		kind = kind,
		span = { source = text.origin, start = start, end = end },
		spacing = spacing
	}


private pure func symbol(text: SourceText, value: Symbol, start: Int, end: Int) -> Token:
	token(text, SymbolToken(value), start, end)


private pure func utf8_form(lead: Int) -> Option[Utf8Form]:
	two_bytes = utf8_two_bytes()
	if within(lead, two_bytes.first_lead, two_bytes.last_lead):
		Some(two_bytes)
	else:
		three_bytes = utf8_three_bytes()
		if within(lead, three_bytes.first_lead, three_bytes.last_lead):
			Some(three_bytes)
		else:
			four_bytes = utf8_four_bytes()
			if within(lead, four_bytes.first_lead, four_bytes.last_lead):
				Some(four_bytes)
			else:
				None


-- Partial UTF-8 decoding: `scalar` holds the payload of the bytes before `cursor`.
private fixed record Utf8Scalar {
	start: Int,
	cursor: Int,
	end: Int,
	scalar: Int
}


-- Accumulates the remaining continuation bytes, at most three.
private pure func utf8_scalar(text: SourceText, partial: Utf8Scalar) -> Result[Int, Diagnostic]:
	if partial.cursor == partial.end:
		Ok(partial.scalar)
	else:
		match text.bytes.byte_at(partial.cursor):
			None:
				Err(error_at(text, partial.start, text.bytes.length(), invalid_utf8()))
			Some(byte):
				if within(byte, UTF8_CONTINUATION_START, UTF8_CONTINUATION_END):
					payload = byte.subtract(UTF8_CONTINUATION_START)
					shifted = partial.scalar.multiply(UTF8_CONTINUATION_RADIX)
					next = partial.cursor.add(1)
					utf8_scalar(text, { partial | cursor = next, scalar = shifted.add(payload) })
				else:
					Err(byte_error(text, partial.cursor, invalid_utf8()))


-- Validates the scalar whose lead byte is at `start` and returns its end.
-- Byte access does not decode or re-encode the source; the token retains it.
private pure func utf8_end(text: SourceText, start: Int, lead: Int) -> Result[Int, Diagnostic]:
	match utf8_form(lead):
		None:
			Err(byte_error(text, start, invalid_utf8()))
		Some(form):
			end = start.add(form.width)
			payload = lead.subtract(form.lead_marker)
			match utf8_scalar(text, { start = start, cursor = start.add(1), end = end, scalar = payload }):
				Ok(scalar):
					if (
						or(
							or(
								scalar.less_than(form.minimum),
								scalar.greater_than(UNICODE_MAX),
							),
							within(scalar, UNICODE_SURROGATE_START, UNICODE_SURROGATE_END),
						)
					):
						Err(error_at(text, start, end, invalid_utf8()))
					else:
						Ok(end)
				Err(error): Err(error)


-- Validates one raw String byte or UTF-8 scalar at `position`.
private pure func raw_character_end(text: SourceText, position: Int, byte: Int) -> Result[Int, Diagnostic]:
	if byte == ASCII_LF:
		Err(byte_error(text, position, string_line_break()))
	else if or(byte.less_than(ASCII_SPACE), byte == ASCII_DEL):
		Err(byte_error(text, position, raw_control_byte()))
	else if byte.greater_than(ASCII_DEL):
		utf8_end(text, position, byte)
	else:
		Ok(position.add(1))


-- Validates the character or escape pair at `cursor`, which is not the
-- closing quote, and returns where the next one starts. The parser decodes
-- escapes; the lexer only keeps an escaped byte from closing the literal.
private pure func quoted_character_end(text: SourceText, start: Int, cursor: Int) -> Result[Int, Diagnostic]:
	escaped = cursor.add(1)

	match text.bytes.byte_at(cursor):
		None:
			Err(error_at(text, start, cursor, unterminated_string()))
		Some(byte):
			if byte != ASCII_BACKSLASH:
				raw_character_end(text, cursor, byte)
			else:
				match text.bytes.byte_at(escaped):
					None:
						Err(byte_error(text, cursor, unterminated_escape()))
					Some(escaped_byte):
						raw_character_end(text, escaped, escaped_byte)


private pure func quoted_token(text: SourceText, start: Int) -> Result[Token, Diagnostic]:
	contents_start = start.add(1)
	-- One Result carries the scan to the closing quote or to the first error.
	var scan: Result[Int, Diagnostic] = Ok(contents_start)

	while True:
		match scan:
			Ok(cursor):
				if byte_is(text, cursor, ASCII_DOUBLE_QUOTE):
					break
				if or(cursor == text.bytes.length(), byte_is(text, cursor, ASCII_LF)):
					scan = Err(error_at(text, start, cursor, unclosed_hole_string()))
					break
				if and(byte_is(text, cursor, ASCII_DOLLAR), byte_is(text, cursor.add(1), ASCII_LEFT_BRACE)):
					scan = Err(error_at(text, cursor, cursor.add(2), nested_interpolation()))
					break

				scan = quoted_character_end(text, start, cursor)
			Err(_):
				break

	closing ?= scan
	-- The successful scan starts after ASCII quote and ends at ASCII quote,
	-- advancing only across complete UTF-8 scalars and escape pairs.
	contents = text.bytes.slice(contents_start, closing).get_or("")
	Ok(token(text, QuotedString(contents), start, closing.add(1)))


-- The end of the one character or escape pair at `cursor` in a Char literal
-- opened at `start`. An escaped byte cannot close the literal; decoding the
-- escape waits for the Char type.
private pure func char_content_end(text: SourceText, start: Int, cursor: Int) -> Result[Int, Diagnostic]:
	match text.bytes.byte_at(cursor):
		None:
			Err(error_at(text, start, cursor, unterminated_char()))
		Some(byte):
			escaped = cursor.add(1)

			if byte == ASCII_LF:
				Err(error_at(text, start, cursor, unterminated_char()))
			else if byte == ASCII_SINGLE_QUOTE:
				Err(error_at(text, start, escaped, char_width()))
			else if byte == ASCII_BACKSLASH:
				if or(escaped == text.bytes.length(), byte_is(text, escaped, ASCII_LF)):
					Err(error_at(text, start, escaped, unterminated_char()))
				else:
					Ok(escaped.add(1))
			else if or(byte.less_than(ASCII_SPACE), byte == ASCII_DEL):
				Err(byte_error(text, cursor, char_control_byte()))
			else if byte.greater_than(ASCII_DEL):
				utf8_end(text, cursor, byte)
			else:
				Ok(escaped)


-- A Char literal: a quote, one character or escape pair, and the closing quote.
private pure func char_token(text: SourceText, start: Int) -> Result[Token, Diagnostic]:
	contents_start = start.add(1)
	contents_end ?= char_content_end(text, start, contents_start)
	after = contents_end.add(1)

	if byte_is(text, contents_end, ASCII_SINGLE_QUOTE):
		Ok(token(text, CharLiteral, start, after))
	else if or(contents_end == text.bytes.length(), byte_is(text, contents_end, ASCII_LF)):
		Err(error_at(text, start, contents_end, unterminated_char()))
	else:
		Err(error_at(text, start, after, char_width()))


private pure func numeric_token_end(text: SourceText, start: Int, end: Int, is_float: Bool) -> Result[Token, Diagnostic]:
	if byte_in(text, end, IdentifierStart):
		Err(error_at(text, start, run_end(text, end, IdentifierByte), numeric_suffix()))
	else:
		-- The numeric scan stays within its ASCII run, so neither end splits a scalar.
		spelling = text.bytes.slice(start, end).get_or("")
		kind: TokenKind = if is_float:
			FloatLiteral(spelling)
		else:
			IntegerLiteral(spelling)
		Ok(token(text, kind, start, end))


-- Whether a field or function name follows `position` on its line.
private pure func name_follows(text: SourceText, position: Int) -> Bool:
	byte_in(text, run_end(text, position, SpaceByte), IdentifierStart)


private pure func exponent_token(text: SourceText, start: Int, marker: Int) -> Result[Token, Diagnostic]:
	sign = marker.add(1)
	digits = if or(byte_is(text, sign, ASCII_PLUS), byte_is(text, sign, ASCII_MINUS)):
		sign.add(1)
	else:
		sign

	if byte_in(text, digits, DecimalDigit):
		numeric_token_end(text, start, run_end(text, digits, DecimalDigit), True)
	else:
		Err(error_at(text, start, digits, missing_exponent()))


-- Only a dot followed immediately by a digit belongs to a number. An integer
-- receiver's UFCS dot remains an ordinary symbol token when a name follows it;
-- any other dot directly after an integer is a Float missing its fraction.
private pure func numeric_token(text: SourceText, start: Int) -> Result[Token, Diagnostic]:
	digit_start = if byte_is(text, start, ASCII_MINUS):
		start.add(1)
	else:
		start
	integer_end = run_end(text, digit_start, DecimalDigit)
	after_dot = integer_end.add(1)
	-- `0..n` is an integer and a range symbol, not a Float missing its fraction.
	dotted = and(byte_is(text, integer_end, ASCII_DOT), byte_is(text, after_dot, ASCII_DOT).not())
	fraction = and(dotted, byte_in(text, after_dot, DecimalDigit))
	mantissa_end = if fraction:
		run_end(text, after_dot, DecimalDigit)
	else:
		integer_end

	if integer_end == digit_start:
		Err(byte_error(text, start, separated_minus()))
	else if or(byte_is(text, mantissa_end, ASCII_LOWER_E), byte_is(text, mantissa_end, ASCII_UPPER_E)):
		exponent_token(text, start, mantissa_end)
	else:
		missing_fraction_digits = match dotted:
			True:
				match fraction.not():
					True: name_follows(text, after_dot).not()
					False: False
			False: False

		if missing_fraction_digits:
			Err(error_at(text, start, after_dot, missing_fraction()))
		else:
			numeric_token_end(text, start, mantissa_end, fraction)


-- Every reserved word stays a keyword token, including unsupported forms.
-- This is the sole spelling map; the parser admits only and/or/not as callable
-- names through their existing seeded IDs.
-- The words the parser still recognises by seeded id (`fixed`, `methods`,
-- `tail_recursive`, the base type names) are names in the host too, so they
-- stay identifiers, as do `True`, `False` and `Self` in this compiler.
private pure func word_kind(spelling: String) -> Option[TokenKind]:
	match spelling:
		"func":
			Some(KeywordToken(FunctionKeyword))
		"pure":
			Some(KeywordToken(PureKeyword))
		"void":
			Some(KeywordToken(VoidKeyword))
		"var":
			Some(KeywordToken(VarKeyword))
		"match":
			Some(KeywordToken(MatchKeyword))
		"_":
			Some(SymbolToken(Wildcard))
		"if":
			Some(KeywordToken(IfKeyword))
		"else":
			Some(KeywordToken(ElseKeyword))
		"and":
			Some(KeywordToken(AndKeyword))
		"or":
			Some(KeywordToken(OrKeyword))
		"not":
			Some(KeywordToken(NotKeyword))
		"while":
			Some(KeywordToken(WhileKeyword))
		"for":
			Some(KeywordToken(ForKeyword))
		"in":
			Some(KeywordToken(InKeyword))
		"break":
			Some(KeywordToken(BreakKeyword))
		"continue":
			Some(KeywordToken(ContinueKeyword))
		"import":
			Some(KeywordToken(ImportKeyword))
		"type":
			Some(KeywordToken(TypeKeyword))
		"private":
			Some(KeywordToken(PrivateKeyword))
		"record":
			Some(KeywordToken(RecordKeyword))
		"union":
			Some(KeywordToken(UnionKeyword))
		"builtin":
			Some(KeywordToken(BuiltinKeyword))
		"as":
			Some(KeywordToken(AsKeyword))
		"opaque":
			Some(KeywordToken(OpaqueKeyword))
		"into_opaque":
			Some(KeywordToken(IntoOpaqueKeyword))
		"from_opaque":
			Some(KeywordToken(FromOpaqueKeyword))
		"alias":
			Some(KeywordToken(AliasKeyword))
		"debug":
			Some(KeywordToken(DebugKeyword))
		"detach":
			Some(KeywordToken(DetachKeyword))
		"foreign":
			Some(KeywordToken(ForeignKeyword))
		"from":
			Some(KeywordToken(FromKeyword))
		"implements":
			Some(KeywordToken(ImplementsKeyword))
		"resource":
			Some(KeywordToken(ResourceKeyword))
		"select":
			Some(KeywordToken(SelectKeyword))
		"trait":
			Some(KeywordToken(TraitKeyword))
		"try":
			Some(KeywordToken(TryKeyword))
		"where":
			Some(KeywordToken(WhereKeyword))
		_:
			None


-- Identifier IDs are minted after the scan (see `lex`); until then an
-- identifier keeps its spelling and byte range. The scan's word arm reads the
-- spelling once, into the batch `intern_names` receives.
private fixed union ScannedToken:
	WordToken(String, Int, Int)
	ReadyToken(Token)


-- A flat batch shares the outer lexer's one identifier-interning operation.
private fixed record ScannedCode {
	tokens: List[ScannedToken],
	end: Int
}


private pure func punctuation(byte: Int) -> Option[Symbol]:
	if byte == ASCII_AT_SIGN:
		Some(AtSign)
	else if byte == ASCII_LEFT_PAREN:
		Some(LeftParen)
	else if byte == ASCII_RIGHT_PAREN:
		Some(RightParen)
	else if byte == ASCII_LEFT_BRACE:
		Some(LeftBrace)
	else if byte == ASCII_RIGHT_BRACE:
		Some(RightBrace)
	else if byte == ASCII_BAR:
		Some(Bar)
	else if byte == ASCII_LEFT_BRACKET:
		Some(LeftBracket)
	else if byte == ASCII_RIGHT_BRACKET:
		Some(RightBracket)
	else if byte == ASCII_COMMA:
		Some(Comma)
	else if byte == ASCII_DOT:
		Some(Dot)
	else if byte == ASCII_SLASH:
		Some(Slash)
	else if byte == ASCII_PLUS:
		Some(Plus)
	else if byte == ASCII_STAR:
		Some(Star)
	else if byte == ASCII_COLON:
		Some(Colon)
	else:
		None


-- Scans the code token at `cursor`; the caller handles spaces, comments and LF.
private pure func code_token(text: SourceText, cursor: Int) -> Result[ScannedToken, Diagnostic]:
	if byte_in(text, cursor, IdentifierStart):
		end = run_end(text, cursor.add(1), IdentifierByte)
		-- IdentifierByte accepts ASCII only; run_end cannot cross a scalar boundary.
		spelling = text.bytes.slice(cursor, end).get_or("")

		match word_kind(spelling):
			Some(kind):
				Ok(ReadyToken(token(text, kind, cursor, end)))
			None:
				Ok(WordToken(spelling, cursor, end))
	else:
		match literal_or_symbol(text, cursor):
			Ok(scanned):
				Ok(ReadyToken(scanned))
			Err(error):
				Err(error)


private pure func literal_or_symbol(text: SourceText, cursor: Int) -> Result[Token, Diagnostic]:
	next = cursor.add(1)

	if byte_is(text, cursor, ASCII_DOUBLE_QUOTE):
		quoted_token(text, cursor)
	else if byte_is(text, cursor, ASCII_SINGLE_QUOTE):
		char_token(text, cursor)
	else if and(byte_is(text, cursor, ASCII_MINUS), byte_is(text, next, ASCII_GREATER)):
		Ok(symbol(text, Arrow, cursor, cursor.add(2)))
	else if and(
		and(
			byte_is(text, cursor, ASCII_DOT),
			byte_is(text, next, ASCII_DOT),
		),
		byte_is(text, cursor.add(2), ASCII_DOT),
	):
		Ok(symbol(text, Ellipsis, cursor, cursor.add(3)))
	else if and(byte_is(text, cursor, ASCII_DOT), byte_is(text, next, ASCII_DOT)):
		Ok(symbol(text, DotDot, cursor, cursor.add(2)))
	-- A token starting with `=`, `<` or `>` is told apart by its second byte
	-- here, so other tokens pay one test per first byte, not one per spelling.
	else if byte_is(text, cursor, ASCII_EQUALS):
		if byte_is(text, next, ASCII_EQUALS):
			Ok(symbol(text, EqualsEquals, cursor, cursor.add(2)))
		else if byte_is(text, next, ASCII_GREATER):
			Err(error_at(text, cursor, cursor.add(2), foreign_operator("=>", "write '>=' to compare, or 'func(x): expr' for a lambda")))
		else if byte_is(text, next, ASCII_LESS):
			Err(error_at(text, cursor, cursor.add(2), foreign_operator("=<", "write '<='")))
		else:
			Ok(symbol(text, Equals, cursor, next))
	else if byte_is(text, cursor, ASCII_LESS):
		if byte_is(text, next, ASCII_EQUALS):
			Ok(symbol(text, LessEquals, cursor, cursor.add(2)))
		else if byte_is(text, next, ASCII_GREATER):
			Err(error_at(text, cursor, cursor.add(2), foreign_operator("<>", "write '!=' for inequality")))
		else:
			Ok(symbol(text, Less, cursor, next))
	else if byte_is(text, cursor, ASCII_GREATER):
		if byte_is(text, next, ASCII_EQUALS):
			Ok(symbol(text, GreaterEquals, cursor, cursor.add(2)))
		else:
			Ok(symbol(text, Greater, cursor, next))
	else if and(byte_is(text, cursor, ASCII_EXCLAMATION), byte_is(text, next, ASCII_EQUALS)):
		Ok(symbol(text, NotEquals, cursor, cursor.add(2)))
	else if and(byte_is(text, cursor, ASCII_QUESTION), byte_is(text, next, ASCII_EQUALS)):
		Ok(symbol(text, QuestionEquals, cursor, cursor.add(2)))
	else if and(byte_is(text, cursor, ASCII_PLUS), or(byte_in(text, next, DecimalDigit), byte_is(text, next, ASCII_DOT))):
		Err(byte_error(text, cursor, plus_sign()))
	else if or(byte_in(text, cursor, DecimalDigit), byte_is(text, cursor, ASCII_MINUS)):
		numeric_token(text, cursor)
	else if byte_is(text, cursor, ASCII_CR):
		Err(byte_error(text, cursor, line_ending()))
	else if byte_is(text, cursor, ASCII_TAB):
		Err(byte_error(text, cursor, separating_tab()))
	else:
		punctuator = match text.bytes.byte_at(cursor):
			Some(byte):
				punctuation(byte)
			None:
				None

		match punctuator:
			Some(value):
				Ok(symbol(text, value, cursor, next))
			None:
				Err(byte_error(text, cursor, unsupported_character()))


-- Braces belong to record expressions until the hole's own closing brace.
-- Quoted/Char tokens are scanned atomically, so their braces cannot close it.
private pure func interpolation_tokens(text: SourceText, opening: Int) -> Result[ScannedCode, Diagnostic]:
	var tokens: List[ScannedToken] = [ReadyToken(token(text, InterpolationOpen, opening, opening.add(2)))]
	var scan: Result[Int, Diagnostic] = Ok(opening.add(2))
	var braces = 0
	while True:
		match scan:
			Err(_): break
			Ok(cursor):
				if or(cursor == text.bytes.length(), byte_is(text, cursor, ASCII_LF)):
					scan = Err(error_at(text, opening, opening.add(2), unclosed_interpolation()))
				else if byte_is(text, cursor, ASCII_SPACE):
					scan = Ok(cursor.add(1))
				else if comment_starts(text, cursor):
					scan = comment_end(text, cursor)
				else if and(byte_is(text, cursor, ASCII_RIGHT_BRACE), braces == 0):
					end = cursor.add(1)
					tokens = tokens.append(ReadyToken(token(text, InterpolationClose, cursor, end)))
					scan = Ok(end)
					break
				else:
					scan = match code_token(text, cursor):
						Err(error): Err(error)
						Ok(scanned):
							tokens = tokens.append(scanned)
							match scanned:
								WordToken(_, _, end): Ok(end)
								ReadyToken(ready):
									match ready.kind:
										SymbolToken(LeftBrace): braces = braces.add(1)
										SymbolToken(RightBrace): braces = braces.subtract(1)
										_: void
									Ok(ready.span.end)
	end ?= scan
	Ok({ tokens = tokens, end = end })


private pure func quoted_tokens(text: SourceText, opening: Int) -> Result[ScannedCode, Diagnostic]:
	contents = opening.add(1)
	var scan: Result[Int, Diagnostic] = Ok(contents)
	var start = contents
	var tokens: List[ScannedToken] = []
	while True:
		match scan:
			Err(_): break
			Ok(cursor):
				if byte_is(text, cursor, ASCII_DOUBLE_QUOTE):
					end = cursor.add(1)
					if tokens.is_empty():
						bytes = text.bytes.slice(contents, cursor).get_or("")
						tokens = [ReadyToken(token(text, QuotedString(bytes), opening, end))]
					else:
						if start.less_than(cursor):
							bytes = text.bytes.slice(start, cursor).get_or("")
							tokens = tokens.append(ReadyToken(token(text, StringSegment(bytes), start, cursor)))
						tokens = tokens.append(ReadyToken(token(text, StringEnd, cursor, end)))
					scan = Ok(end)
					break
				else if and(byte_is(text, cursor, ASCII_DOLLAR), byte_is(text, cursor.add(1), ASCII_LEFT_BRACE)):
					if tokens.is_empty():
						tokens = tokens.append(ReadyToken(token(text, StringStart(QuotedStringForm), opening, contents)))
					if start.less_than(cursor):
						bytes = text.bytes.slice(start, cursor).get_or("")
						tokens = tokens.append(ReadyToken(token(text, StringSegment(bytes), start, cursor)))
					scan = match interpolation_tokens(text, cursor):
						Err(error): Err(error)
						Ok(hole):
							for item in hole.tokens:
								tokens = tokens.append(item)
							start = hole.end
							Ok(hole.end)
				else:
					scan = quoted_character_end(text, opening, cursor)
	end ?= scan
	Ok({ tokens = tokens, end = end })


-- A comment holds ASCII bytes other than CR, up to the LF or EOF ending its line.
private pure func comment_end(text: SourceText, start: Int) -> Result[Int, Diagnostic]:
	var end: Int = start.add(2)

	while and(end.less_than(text.bytes.length()), comment_continues(text, end)):
		end = end.add(1)

	if or(end == text.bytes.length(), byte_is(text, end, ASCII_LF)):
		Ok(end)
	else if byte_is(text, end, ASCII_CR):
		Err(byte_error(text, end, line_ending()))
	else:
		Err(byte_error(text, end, comment_byte()))


private pure func comment_continues(text: SourceText, position: Int) -> Bool:
	match text.bytes.byte_at(position):
		Some(code):
			and(
				and(
					code.less_than_or_equal(ASCII_DEL),
					code != ASCII_LF,
				),
				code != ASCII_CR,
			)
		None:
			False


private pure func comment_starts(text: SourceText, cursor: Int) -> Bool:
	and(byte_is(text, cursor, ASCII_MINUS), byte_is(text, cursor.add(1), ASCII_MINUS))


-- Whether a fence line starts at `start`: DOC_FENCE, spaces, then LF or EOF.
private pure func fence_at(text: SourceText, start: Int) -> Bool:
	after_fence = start.add(DOC_FENCE_WIDTH)
	after_spaces = run_end(text, after_fence, SpaceByte)
	and(
		and(
			and(
				byte_is(text, start, ASCII_MINUS),
				byte_is(text, start.add(1), ASCII_MINUS),
			),
			byte_is(text, start.add(2), ASCII_MINUS),
		),
		(or(after_spaces == text.bytes.length(), byte_is(text, after_spaces, ASCII_LF))),
	)


-- The start of the line after the one at `start`, or the end of the source.
-- Documentation text admits any byte but CR.
private pure func next_line_start(text: SourceText, start: Int) -> Result[Int, Diagnostic]:
	var end: Int = start

	while and(
		and(
			end.less_than(text.bytes.length()),
			byte_is(text, end, ASCII_LF).not(),
		),
		byte_is(text, end, ASCII_CR).not(),
	):
		end = end.add(1)

	if byte_is(text, end, ASCII_CR):
		Err(byte_error(text, end, line_ending()))
	else:
		Ok(end.add(1).min(text.bytes.length()))


-- A documentation block opens at the fence line at `fence` and ends after the
-- next fence line at column 1; the lines between are trivia.
private pure func doc_block_end(text: SourceText, fence: Int) -> Result[Int, Diagnostic]:
	-- One Result carries each line start inside the block, or the first error.
	var scan: Result[Int, Diagnostic] = next_line_start(text, fence)

	while True:
		match scan:
			Ok(line):
				if or(line == text.bytes.length(), fence_at(text, line)):
					break

				scan = next_line_start(text, line)
			Err(_):
				break

	closing ?= scan

	if closing == text.bytes.length():
		Err(error_at(text, fence, fence.add(DOC_FENCE_WIDTH), unterminated_doc_block()))
	else:
		next_line_start(text, closing)


-- Returns where the trivia at `start`, which is an LF, EOF or comment, ends:
-- `start` itself at LF or EOF, or the LF or EOF ending the comment there.
private pure func trivia_end(text: SourceText, start: Int) -> Result[Int, Diagnostic]:
	if byte_is(text, start, ASCII_MINUS):
		comment_end(text, start)
	else:
		Ok(start)


-- An indentation prefix is all tabs, or spaces in groups of four.
private pure func indentation_level(text: SourceText, prefix: LinePrefix) -> Result[Int, Diagnostic]:
	width = prefix.end.subtract(prefix.start)
	whole_groups = width.remainder(SPACE_INDENT_WIDTH) == 0

	if run_end(text, prefix.start, TabByte) == prefix.end:
		Ok(width)
	else if and(run_end(text, prefix.start, SpaceByte) == prefix.end, whole_groups):
		Ok(width.divide(SPACE_INDENT_WIDTH))
	else:
		Err(error_at(text, prefix.start, prefix.end, invalid_indentation()))


private pure func line_prefix(text: SourceText, start: Int) -> LinePrefix:
	{ start = start, end = run_end(text, start, IndentationByte) }


-- Skips blank, whitespace-only and comment-only lines from the line at `start`
-- to the next code line, with its indentation level.
private pure func next_code_line(text: SourceText, start: Int) -> Result[CodeLine, Diagnostic]:
	-- One Result carries the line past trivia lines, or the first error.
	var scan: Result[LinePrefix, Diagnostic] = Ok(line_prefix(text, start))

	while True:
		match scan:
			Ok(line):
				if or(
					line.end == text.bytes.length(),
					(or(byte_is(text, line.end, ASCII_LF), comment_starts(text, line.end))).not(),
				):
					break

				starts_doc_block = if line.start == line.end:
					fence_at(text, line.end)
				else:
					False
				scan = if starts_doc_block:
					match doc_block_end(text, line.end):
						Ok(after_block):
							Ok(line_prefix(text, after_block))
						Err(error):
							Err(error)
				else:
					match trivia_end(text, line.end):
						Ok(end):
							Ok(line_prefix(text, end.add(1).min(text.bytes.length())))
						Err(error):
							Err(error)
			Err(_):
				break

	prefix ?= scan
	end = text.bytes.length()

	if prefix.end == end:
		Ok({ prefix = { start = end, end = end }, level = 0 })
	else:
		match indentation_level(text, prefix):
			Ok(level): Ok({ prefix = prefix, level = level })
			Err(error): Err(error)


-- A pipe scan stops at an interpolation opener; a raw block keeps every byte. In both, a
-- line's text starts after its single marker, so `||` yields one bar.
private fixed union PipeForm:
	PipeMarkers
	RawText


-- A pipe String's joined value and where its last line's text ends: at the
-- LF that is the code line's Newline, or at the end of the source.
private fixed record PipeBlock {
	value: String,
	end: Int
}


-- A pipe line's text byte: a tab, a printable byte or a UTF-8 scalar.
private pure func pipe_byte_end(text: SourceText, position: Int, byte: Int) -> Result[Int, Diagnostic]:
	if byte == ASCII_TAB:
		Ok(position.add(1))
	else:
		raw_character_end(text, position, byte)


-- The end of the pipe line text starting at `start`: its LF or the end of
-- the source, or the first invalid byte.
private pure func pipe_line_end(text: SourceText, start: Int, form: PipeForm) -> Result[Int, Diagnostic]:
	-- One Result carries the scan across the line's text, or the first error.
	var scan: Result[Int, Diagnostic] = Ok(start)

	while True:
		match scan:
			Ok(cursor):
				match text.bytes.byte_at(cursor):
					None:
						break
					Some(byte):
						if byte == ASCII_LF:
							break

						opens_hole = match form:
							PipeMarkers:
								and(byte == ASCII_DOLLAR, byte_is(text, cursor.add(1), ASCII_LEFT_BRACE))
							RawText: False
						if opens_hole:
							break
						scan = pipe_byte_end(text, cursor, byte)
			Err(_):
				break

	scan


-- Whether the line starting at `line_start` begins with exactly the bytes
-- of the indentation prefix `first`. The prefix lies inside the source, so
-- the `None` arm cannot be reached; the host requires it, as elsewhere.
private pure func same_indentation(text: SourceText, first: LinePrefix, line_start: Int) -> Bool:
	var offset: Int = 0
	var same: Bool = True

	while and(same, offset.less_than(first.end.subtract(first.start))):
		same = match text.bytes.byte_at(first.start.add(offset)):
			Some(expected):
				byte_is(text, line_start.add(offset), expected)
			None:
				False
		offset = offset.add(1)

	same


-- The marker of the next line when it continues the block: the line after
-- the LF at `line_end` starts with the first marker's indentation bytes and
-- then `|`.
private pure func continuing_marker(text: SourceText, line_end: Int, first: LinePrefix) -> Option[Int]:
	line_start = line_end.add(1)
	marker = line_start.add(first.end.subtract(first.start))

	continues_block = match byte_is(text, line_end, ASCII_LF):
		True:
			match same_indentation(text, first, line_start):
				True: byte_is(text, marker, ASCII_BAR)
				False: False
		False: False

	if continues_block:
		Some(marker)
	else:
		None


-- Reads the block whose first marker ends the indentation prefix `first`,
-- joining the lines' text with LF.
private pure func pipe_block(text: SourceText, first: LinePrefix, form: PipeForm) -> Result[PipeBlock, Diagnostic]:
	var value: String = ""
	-- One Result carries the marker of each line to read, or the first error.
	var lines: Result[Int, Diagnostic] = Ok(first.end)
	var end: Int = first.end

	while True:
		match lines:
			Ok(marker):
				text_start = marker.add(1)

				match pipe_line_end(text, text_start, form):
					Err(error):
						lines = Err(error)
					Ok(line_end):
						-- A successful line scan starts after ASCII marker and consumes whole
						-- scalars through LF or source end; both endpoints are in bounds.
						line_text = text.bytes.slice(text_start, line_end).get_or("")
						value = Text.concat(value, line_text)
						end = line_end

						match continuing_marker(text, line_end, first):
							Some(next_marker):
								value = "${value}\n"
								lines = Ok(next_marker)
							None:
								break
			Err(_):
				break

	finished ?= lines
	Ok({ value = value, end = end })


-- A no-hole pipe keeps the existing joined token. Once a hole occurs, text
-- and code tokens retain original source offsets rather than joined offsets.
private pure func pipe_tokens(text: SourceText, first: LinePrefix) -> Result[ScannedCode, Diagnostic]:
	contents = first.end.add(1)
	var scan: Result[Int, Diagnostic] = Ok(contents)
	var prefix: List[String] = []
	var tokens: List[ScannedToken] = []
	var end = contents
	while True:
		match scan:
			Err(_): break
			Ok(start):
				match pipe_line_end(text, start, PipeMarkers):
					Err(error): scan = Err(error)
					Ok(stop):
						bytes = text.bytes.slice(start, stop).get_or("")
						if tokens.is_empty():
							prefix = prefix.append(bytes)
						else if start.less_than(stop):
							tokens = tokens.append(ReadyToken(token(text, StringSegment(bytes), start, stop)))
						if byte_is(text, stop, ASCII_DOLLAR):
							if tokens.is_empty():
								tokens = tokens.append(ReadyToken(token(text, StringStart(PipeStringForm), first.end, contents)))
								if prefix.is_empty().not():
									tokens = tokens.append(ReadyToken(token(text, StringSegment(prefix.join("")), contents, stop)))
								prefix = []
							scan = match interpolation_tokens(text, stop):
								Err(error): Err(error)
								Ok(hole):
									for item in hole.tokens:
										tokens = tokens.append(item)
									Ok(hole.end)
						else:
							end = stop
							match continuing_marker(text, stop, first):
								None: break
								Some(marker):
									if tokens.is_empty():
										prefix = prefix.append("\n")
									else:
										tokens = tokens.append(ReadyToken(token(text, StringSegment("\n"), stop, stop.add(1))))
									scan = Ok(marker.add(1))
	finished ?= scan
	if tokens.is_empty():
		Ok({ tokens = [ReadyToken(token(text, PipeString(prefix.join("")), first.end, end))], end = end })
	else:
		Ok({ tokens = tokens.append(ReadyToken(token(text, StringEnd, end, end))), end = end })


-- The word `raw` is compared byte by byte: a substring would allocate.
private RAW_WORD_WIDTH: Int = 3


-- The indentation prefix of the marker line that opens a raw block when the
-- code at `start` is the word `raw`, trailing spaces, a LF and then that
-- indented marker line.
private pure func raw_block_marker_line(text: SourceText, start: Int) -> Option[LinePrefix]:
	word_end = run_end(text, start, IdentifierByte)
	line_end = run_end(text, word_end, SpaceByte)
	marker_line = line_prefix(text, line_end.add(1))
	is_raw_word = (
		and(
			and(
				and(
					word_end == start.add(RAW_WORD_WIDTH),
					byte_is(text, start, ASCII_LOWER_R),
				),
				byte_is(text, start.add(1), ASCII_LOWER_A),
			),
			byte_is(text, start.add(2), ASCII_LOWER_W),
		)
	)

	if and(and(is_raw_word, byte_is(text, line_end, ASCII_LF)), byte_is(text, marker_line.end, ASCII_BAR)):
		Some(marker_line)
	else:
		None


-- What the code of a line is, after its indentation prefix: a pipe String
-- or raw block token, or ordinary code starting at the prefix's end.
private fixed union LineCode:
	PipeLine(ScannedCode)
	OrdinaryCode


-- The code of the line with `prefix`: a pipe String starts at a `|` first on
-- the line, on any line including a continuation line inside brackets.
private pure func line_code(text: SourceText, prefix: LinePrefix) -> Result[LineCode, Diagnostic]:
	if byte_is(text, prefix.end, ASCII_BAR):
		match pipe_tokens(text, prefix):
			Ok(block): Ok(PipeLine(block))
			Err(error): Err(error)
	else:
		match raw_block_marker_line(text, prefix.end):
			Some(marker_line):
				match pipe_block(text, marker_line, RawText):
					Ok(block): Ok(PipeLine({ tokens = [ReadyToken(token(text, PipeString(block.value), prefix.end, block.end))], end = block.end }))
					Err(error): Err(error)
			None:
				Ok(OrdinaryCode)


-- An open bracketed block (host GRAMMAR 2.2): `group` is the bracket depth
-- whose line breaks it makes significant, `base` the indentation level of
-- the line that opened it with a `:`.
private fixed record BracketedBlock {
	group: Int,
	base: Int
}


private pure func innermost_block(bodies: List[BracketedBlock]) -> Option[BracketedBlock]:
	bodies.get(bodies.length().subtract(1))


-- Host 2.2 `insignificant(depth)`: a line break inside brackets is trivia
-- unless a bracketed block is open at exactly this depth.
private pure func insignificant_break(brackets: Int, bodies: List[BracketedBlock]) -> Bool:
	match innermost_block(bodies):
		None:
			True
		Some(block):
			brackets != block.group


-- Host 2.2 `opens_block(depth)`: a `:` ending a line inside brackets opens
-- a bracketed block, unless one is already open at this depth or deeper.
private pure func opens_bracketed_block(brackets: Int, last_colon: Bool, bodies: List[BracketedBlock]) -> Bool:
	open_deeper: Bool = match innermost_block(bodies):
		None:
			True
		Some(block):
			brackets.greater_than(block.group)
	and(last_colon, open_deeper)


-- Host 2.3 DEDENT-TO: a line dedented to `level` closes every bracketed
-- block whose base is at or above it. Blocks open in stack order with
-- non-decreasing bases, so the survivors are a prefix.
private pure func blocks_open_below(bodies: List[BracketedBlock], level: Int) -> List[BracketedBlock]:
	var kept: List[BracketedBlock] = []

	for block in bodies:
		if block.base.less_than(level):
			kept = kept.append(block)
	kept


-- The innermost open level; `levels` always holds 0.
private pure func top_level(levels: List[Int]) -> Int:
	match levels.get(levels.length().subtract(1)):
		Some(level):
			level
		None:
			0


-- Host 2.3 L2 case 3: a line indented strictly between the open bracketed
-- block's base and the block's own level, at the block's bracket depth,
-- closes the block (the block's lines were deeper; this one belongs to the
-- enclosing brackets). `level` is then no open level: case 6 would report
-- it as inconsistent.
private pure func closes_bracketed_block(bodies: List[BracketedBlock], brackets: Int, level: Int, levels: List[Int]) -> Option[Int]:
	match innermost_block(bodies):
		None:
			None
		Some(block):
			between = and(block.base.less_than(level), level.less_than(top_level(levels)))

			closes_between_levels = if brackets == block.group:
				match between:
					True: levels.contains(level).not()
					False: False
			else:
				False

			if closes_between_levels:
				Some(block.base)
			else:
				None


private pure func is_colon(kind: TokenKind) -> Bool:
	match kind:
		SymbolToken(Colon):
			True
		_:
			False


-- Open brackets raise the depth and closing ones lower it, never below zero:
-- a closer with nothing open is the parser's error, not a layout change.
private pure func bracket_depth(depth: Int, kind: TokenKind) -> Int:
	match kind:
		SymbolToken(LeftParen) | SymbolToken(LeftBracket) | SymbolToken(LeftBrace):
			depth.add(1)
		SymbolToken(RightParen) | SymbolToken(RightBracket) | SymbolToken(RightBrace):
			depth.subtract(1).max(0)
		_:
			depth


-- The host's layout algorithm (GRAMMAR 2.2-2.3) over levels counted in
-- tabs or four-space groups. A code line deeper than the innermost open
-- level starts with an Indent and opens its level, whatever the step; a
-- shallower line emits one Dedent per level it closes and must land on an
-- open level, or it is inconsistent indentation. Each code line ends with
-- Newline: its LF, or empty at the end of a source without one. Inside an
-- open bracket a LF and the next line's indentation are trivia, so the code
-- line continues there without layout tokens, unless a bracketed block is
-- open at that depth: a `:` ending a line inside brackets opens one, its
-- lines are laid out like any block, and a line dedented to its base, or
-- indented strictly between its base and its level, closes it. A closing
-- bracket never closes a block; the Dedent comes with the next line, or
-- with the end of the input.
pure func lex(origin: SourceId, source: String, names: NameTable) -> Result[LexedProgram, Diagnostic]:
	text: SourceText = { origin = origin, bytes = source }
	var tokens: List[ScannedToken] = []
	var spellings: List[String] = []
	-- The open indentation levels, innermost last; host `levels`.
	var levels: List[Int] = [0]
	-- Bracket depth and the open bracketed blocks persist across code lines.
	var brackets: Int = 0
	var bodies: List[BracketedBlock] = []
	-- One Result carries each code line to lay out, or the first error.
	var lines: Result[CodeLine, Diagnostic] = next_code_line(text, 0)

	while True:
		match lines:
			Ok(line):
				if line.level.greater_than(top_level(levels)):
					tokens = tokens.append(ReadyToken(symbol(text, Indent, line.prefix.start, line.prefix.end)))
					levels = levels.append(line.level)
				else if line.level.less_than(top_level(levels)):
					-- Host DEDENT-TO: to the line's level, or to the base of the
					-- bracketed block the line closes (L2 case 3).
					target = match closes_bracketed_block(bodies, brackets, line.level, levels):
						Some(base):
							base
						None:
							line.level

					while top_level(levels).greater_than(target):
						tokens = tokens.append(ReadyToken(symbol(text, Dedent, line.prefix.start, line.prefix.end)))
						levels = levels.take(levels.length().subtract(1))

					if top_level(levels) != target:
						lines = Err(error_at(text, line.prefix.start, line.prefix.end, inconsistent_indentation()))
						break

					bodies = blocks_open_below(bodies, target)

				if line.prefix.end == source.length():
					break

				-- One Result carries the cursor across the line to its LF or EOF, or the first error.
				var code: Result[Int, Diagnostic] = match line_code(text, line.prefix):
					Ok(PipeLine(pipe)):
						for item in pipe.tokens:
							tokens = tokens.append(item)
							match item:
								WordToken(spelling, _, _): spellings = spellings.append(spelling)
								_: void
						Ok(pipe.end)
					Ok(OrdinaryCode):
						Ok(line.prefix.end)
					Err(error):
						Err(error)
				-- Whether the last token scanned on this code line is a `:`.
				var last_colon: Bool = False

				while True:
					match code:
						Ok(cursor):
							if cursor == source.length():
								break

							-- A LF ends the code line at depth zero, when it opens a
							-- bracketed block, or when it is inside the one open at
							-- this depth; any other LF inside brackets is trivia.
							line_ends: Bool = if byte_is(text, cursor, ASCII_LF).not():
								False
							else if brackets == 0:
								True
							else if opens_bracketed_block(brackets, last_colon, bodies):
								bodies = bodies.append({ group = brackets, base = top_level(levels) })
								True
							else:
								insignificant_break(brackets, bodies).not()

							if line_ends:
								break

							code = if byte_is(text, cursor, ASCII_LF):
								-- A continuation line inside brackets: its indentation is
								-- trivia, a column-1 fence is an error, and its code may be
								-- a pipe String as on any line.
								continued = line_prefix(text, cursor.add(1))

								bracketed_doc_block = if continued.start == continued.end:
									fence_at(text, continued.end)
								else:
									False

								if bracketed_doc_block:
									Err(error_at(text, continued.end, continued.end.add(DOC_FENCE_WIDTH), doc_block_in_brackets()))
								else:
									match line_code(text, continued):
										Ok(PipeLine(pipe)):
											for item in pipe.tokens:
												tokens = tokens.append(item)
												match item:
													WordToken(spelling, _, _): spellings = spellings.append(spelling)
													_: void
											last_colon = False
											Ok(pipe.end)
										Ok(OrdinaryCode):
											Ok(continued.end)
										Err(error):
											Err(error)
							else if byte_is(text, cursor, ASCII_SPACE):
								Ok(cursor.add(1))
							else if comment_starts(text, cursor):
								comment_end(text, cursor)
							else if byte_is(text, cursor, ASCII_DOUBLE_QUOTE):
								match quoted_tokens(text, cursor):
									Err(error): Err(error)
									Ok(quoted):
										for item in quoted.tokens:
											tokens = tokens.append(item)
											match item:
												WordToken(spelling, _, _): spellings = spellings.append(spelling)
												_: void
										last_colon = False
										Ok(quoted.end)
							else:
								match code_token(text, cursor):
									Ok(scanned):
										tokens = tokens.append(scanned)

										match scanned:
											WordToken(spelling, _, end):
												spellings = spellings.append(spelling)
												last_colon = False
												Ok(end)
											ReadyToken(ready):
												brackets = bracket_depth(brackets, ready.kind)
												last_colon = is_colon(ready.kind)
												Ok(ready.span.end)
									Err(error):
										Err(error)
						Err(_):
							break

				lines = match code:
					Ok(line_end):
						next = line_end.add(1).min(source.length())
						tokens = tokens.append(ReadyToken(symbol(text, Newline, line_end, next)))
						next_code_line(text, next)
					Err(error):
						Err(error)
			Err(_):
				break

	finished ?= lines
	-- Interning during the scan would extend a table the loop still holds,
	-- which the host copies for each new spelling, so the scan collects the
	-- spellings and one `intern_names` call mints all their IDs. Its `ids`
	-- hold one ID per WordToken in order, so the `None` arm never runs.
	interned = intern_names(names, spellings)
	var lexed: List[Token] = []
	var word_position: Int = 0
	var missing: Option[Diagnostic] = None

	for scanned in tokens:
		match scanned:
			ReadyToken(ready):
				lexed = lexed.append(ready)
			WordToken(_, start, end):
				match interned.ids.get(word_position):
					Some(id):
						lexed = lexed.append(token(text, IdentifierToken(id), start, end))
					None:
						missing = Some(diagnostic(
							{ source = compiler_source(), start = 0, end = 0 },
							"internal compiler error: a scanned identifier has no interned ID",
							"report this compiler error with the input files",
						))
						break

				word_position = word_position.add(1)

	_: Void ?= match missing:
		Some(error):
			Err(error)
		None:
			Ok(void)
	Ok({
		source_text = source,
		tokens = lexed,
		end = { source = origin, start = source.length(), end = source.length() },
		base_names = names,
		names = interned.names
	})
