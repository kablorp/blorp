import:
	int as IntOps
	../utils/source: SourceId
	string as StringOps
	../utils/syntax:
		Diagnostic,
		LexedProgram,
		Spacing(Adjacent, Spaced),
		Symbol(
			PureKeyword, FunctionKeyword, MatchKeyword, Wildcard, LeftParen, RightParen, Dot, Arrow,
			Colon, Newline, Indent, Dedent, VarKeyword, VoidKeyword, Equals, LeftBracket,
			RightBracket, LeftBrace, RightBrace, RecordUpdateBar, Comma, AtSign, Slash, Star,
		),
		Token,
		TokenKind(IdentifierToken, SymbolToken, IntegerLiteral, FloatLiteral, QuotedString),
		UTF8_CONTINUATION_END,
		UTF8_CONTINUATION_START,
		diagnostic,


-- The bytes being lexed and the source identity of every span made from them.
private fixed record SourceText {
	origin: SourceId,
	bytes: String
}


private fixed record ErrorText {
	message: String,
	help: String
}


private INVALID_INDENTATION: ErrorText = {
	message = "invalid indentation",
	help = "use tabs only, or spaces in groups of four; do not mix tabs and spaces"
}

private DEEP_INDENTATION: ErrorText = {
	message = "indentation increases by more than one level",
	help = "indent a block exactly one tab or four spaces deeper than the line that opens it"
}

private LINE_ENDING: ErrorText = {
	message = "only LF line endings are supported",
	help = "replace CRLF or CR line endings with LF"
}

private SEPARATING_TAB: ErrorText = {
	message = "tabs are allowed only in the body indentation",
	help = "separate tokens with spaces and indent the body with one tab or four spaces"
}

private COMMENT_BYTE: ErrorText = {
	message = "unsupported byte in comment",
	help = "use ASCII bytes in single-line comments"
}

private UNSUPPORTED_CHARACTER: ErrorText = {
	message = "unsupported character",
	help = "use ASCII function declarations and numeric literals, parameter names, or calls; keep -> adjacent"
}

private PLUS_SIGN: ErrorText = {
	message = "source numeric literals cannot start with '+'",
	help = "remove the leading '+'; use an adjacent '-' for a negative literal"
}

private SEPARATED_MINUS: ErrorText = {
	message = "expected decimal digits immediately after '-'",
	help = "write a signed number such as -42 or -0.5; '-' is not an operator"
}

private NUMERIC_SUFFIX: ErrorText = {
	message = "numeric literals cannot have suffixes or separators",
	help = "write decimal digits with an optional fractional part or exponent; use no underscores or type suffixes"
}

private MISSING_EXPONENT: ErrorText = {
	message = "expected decimal digits in Float exponent",
	help = "write a decimal Float such as 1.0, 0.5 or 1e2; an exponent needs at least one digit"
}

private MISSING_FRACTION: ErrorText = {
	message = "Float literals need digits after the decimal point",
	help = "write 1.0; otherwise use a UFCS function call after '.'"
}

private INVALID_UTF8: ErrorText = {
	message = "invalid UTF-8 in String literal",
	help = "use valid UTF-8 text or a Unicode escape such as \\u{E9}; surrogate code points are not Unicode scalars"
}

private STRING_LINE_BREAK: ErrorText = {
	message = "String literals must stay on one line",
	help = "close the quote before LF; write \\n for a newline byte"
}

private RAW_CONTROL_BYTE: ErrorText = {
	message = "unsupported raw byte in String literal",
	help = "use printable text and fixed escapes for control bytes"
}

private UNTERMINATED_STRING: ErrorText = {
	message = "unterminated String literal",
	help = "add a closing double quote on the same line"
}

private UNTERMINATED_ESCAPE: ErrorText = {
	message = "unterminated String escape",
	help = "complete the escape and close the double quote on the same line"
}


private SPACE_INDENT_WIDTH: Int = 4

-- Bytes below SPACE, and DEL, are ASCII controls.
private ASCII_SPACE: Int = 32

private ASCII_DEL: Int = 127

private UNICODE_SURROGATE_START: Int = 55296

private UNICODE_SURROGATE_END: Int = 57343

private UNICODE_MAX: Int = 1114111


-- One UTF-8 encoding width from RFC 3629 section 4. Its lead range excludes
-- the overlong leads C0 and C1 and every lead above F4; `minimum` rejects the
-- remaining overlong (non-shortest) encodings of that width.
private fixed record Utf8Form {
	width: Int,
	first_lead: Int,
	last_lead: Int,
	lead_marker: Int,
	minimum: Int
}


-- Leads C2..DF (110xxxxx) encode U+0080 through U+07FF.
private UTF8_TWO_BYTES: Utf8Form = { width = 2, first_lead = 194, last_lead = 223, lead_marker = 192, minimum = 128 }

-- Leads E0..EF (1110xxxx) encode U+0800 through U+FFFF.
private UTF8_THREE_BYTES: Utf8Form = { width = 3, first_lead = 224, last_lead = 239, lead_marker = 224, minimum = 2048 }

-- Leads F0..F4 (11110xxx) encode U+10000 through U+10FFFF.
private UTF8_FOUR_BYTES: Utf8Form = { width = 4, first_lead = 240, last_lead = 244, lead_marker = 240, minimum = 65536 }

-- Each continuation byte carries six payload bits.
private UTF8_CONTINUATION_RADIX: Int = 64


-- The byte sets that runs of source bytes are scanned over.
private fixed union ByteClass:
	SpaceByte
	TabByte
	IndentationByte
	DecimalDigit
	IdentifierStart
	IdentifierByte


-- A line's start and the end of its indentation prefix.
private fixed record LinePrefix {
	start: Int,
	end: Int
}


-- A code line's indentation and level. At the end of the source it is an empty
-- line at level 0, which closes every open level. All-Int records are inline.
private fixed record CodeLine {
	prefix: LinePrefix,
	level: Int
}


private pure func within(value: Int, first: Int, last: Int) -> Bool:
	IntOps.greater_than_or_equal(value, first) and IntOps.less_than_or_equal(value, last)


private pure func is_byte(code: Int, expected: Char) -> Bool:
	IntOps.equals(code, to_int(expected))


private pure func in_class(code: Int, class: ByteClass) -> Bool:
	match class:
		SpaceByte:
			is_byte(code, ' ')
		TabByte:
			is_byte(code, '\t')
		IndentationByte:
			is_byte(code, ' ') or is_byte(code, '\t')
		DecimalDigit:
			within(code, to_int('0'), to_int('9'))
		IdentifierStart:
			within(code, to_int('a'), to_int('z')) or within(code, to_int('A'), to_int('Z')) or is_byte(code, '_')
		IdentifierByte:
			in_class(code, IdentifierStart) or in_class(code, DecimalDigit)


-- Byte reads compare codes: a one-byte substring would allocate a String.
private pure func byte_is(text: SourceText, position: Int, expected: Char) -> Bool:
	match StringOps.get(text.bytes, position):
		Some(character):
			is_byte(to_int(character), expected)
		None:
			False


-- Whether a byte of `class` is at `position`; there is none at the end.
private pure func byte_in(text: SourceText, position: Int, class: ByteClass) -> Bool:
	match StringOps.get(text.bytes, position):
		Some(character):
			in_class(to_int(character), class)
		None:
			False


-- The first position at or after `start` whose byte is not in `class`.
private pure func run_end(text: SourceText, start: Int, class: ByteClass) -> Int:
	var end: Int = start

	while byte_in(text, end, class):
		end = IntOps.add(end, 1)

	end


private pure func error_at(text: SourceText, start: Int, end: Int, error: ErrorText) -> Diagnostic:
	diagnostic({ source = text.origin, start = start, end = end }, error.message, error.help)


private pure func byte_error(text: SourceText, position: Int, error: ErrorText) -> Diagnostic:
	error_at(text, position, IntOps.add(position, 1), error)


-- Layout tokens get spacing too; no syntax reads it there.
private pure func token(text: SourceText, kind: TokenKind, start: Int, end: Int) -> Token:
	previous = IntOps.subtract(start, 1)
	spacing = if byte_in(text, previous, IndentationByte):
		Spaced
	else:
		Adjacent

	{
		kind = kind,
		span = { source = text.origin, start = start, end = end },
		spacing = spacing
	}


private pure func symbol(text: SourceText, value: Symbol, start: Int, end: Int) -> Token:
	token(text, SymbolToken(value), start, end)


private pure func utf8_form(lead: Int) -> Option[Utf8Form]:
	if within(lead, UTF8_TWO_BYTES.first_lead, UTF8_TWO_BYTES.last_lead):
		Some(UTF8_TWO_BYTES)
	else if within(lead, UTF8_THREE_BYTES.first_lead, UTF8_THREE_BYTES.last_lead):
		Some(UTF8_THREE_BYTES)
	else if within(lead, UTF8_FOUR_BYTES.first_lead, UTF8_FOUR_BYTES.last_lead):
		Some(UTF8_FOUR_BYTES)
	else:
		None


-- Partial UTF-8 decoding: `scalar` holds the payload of the bytes before `cursor`.
private fixed record Utf8Scalar {
	start: Int,
	cursor: Int,
	end: Int,
	scalar: Int
}


-- Accumulates the remaining continuation bytes, at most three.
private pure func utf8_scalar(text: SourceText, partial: Utf8Scalar) -> Result[Int, Diagnostic]:
	if IntOps.equals(partial.cursor, partial.end):
		Ok(partial.scalar)
	else:
		match StringOps.get(text.bytes, partial.cursor):
			None:
				Err(error_at(text, partial.start, text.bytes.length(), INVALID_UTF8))
			Some(character):
				byte = to_int(character)

				if within(byte, UTF8_CONTINUATION_START, UTF8_CONTINUATION_END):
					payload = IntOps.subtract(byte, UTF8_CONTINUATION_START)
					shifted = IntOps.multiply(partial.scalar, UTF8_CONTINUATION_RADIX)
					next = IntOps.add(partial.cursor, 1)
					utf8_scalar(text, { partial | cursor = next, scalar = IntOps.add(shifted, payload) })
				else:
					Err(byte_error(text, partial.cursor, INVALID_UTF8))


-- Validates the scalar whose lead byte is at `start` and returns its end.
-- Byte access does not decode or re-encode the source; the token retains it.
private pure func utf8_end(text: SourceText, start: Int, lead: Int) -> Result[Int, Diagnostic]:
	match utf8_form(lead):
		None:
			Err(byte_error(text, start, INVALID_UTF8))
		Some(form):
			end = IntOps.add(start, form.width)
			payload = IntOps.subtract(lead, form.lead_marker)
			scalar ?= utf8_scalar(text, { start = start, cursor = IntOps.add(start, 1), end = end, scalar = payload })

			if (
				IntOps.less_than(scalar, form.minimum)
				or IntOps.greater_than(scalar, UNICODE_MAX)
				or within(scalar, UNICODE_SURROGATE_START, UNICODE_SURROGATE_END)
			):
				Err(error_at(text, start, end, INVALID_UTF8))
			else:
				Ok(end)


-- Validates one raw String byte or UTF-8 scalar at `position`.
private pure func raw_character_end(text: SourceText, position: Int, byte: Int) -> Result[Int, Diagnostic]:
	if is_byte(byte, '\n'):
		Err(byte_error(text, position, STRING_LINE_BREAK))
	else if IntOps.less_than(byte, ASCII_SPACE) or IntOps.equals(byte, ASCII_DEL):
		Err(byte_error(text, position, RAW_CONTROL_BYTE))
	else if IntOps.greater_than(byte, ASCII_DEL):
		utf8_end(text, position, byte)
	else:
		Ok(IntOps.add(position, 1))


-- Validates the character or escape pair at `cursor`, which is not the
-- closing quote, and returns where the next one starts. The parser decodes
-- escapes; the lexer only keeps an escaped byte from closing the literal.
private pure func quoted_character_end(text: SourceText, start: Int, cursor: Int) -> Result[Int, Diagnostic]:
	escaped = IntOps.add(cursor, 1)

	match StringOps.get(text.bytes, cursor):
		None:
			Err(error_at(text, start, cursor, UNTERMINATED_STRING))
		Some(character):
			if not is_byte(to_int(character), '\\'):
				raw_character_end(text, cursor, to_int(character))
			else:
				match StringOps.get(text.bytes, escaped):
					None:
						Err(byte_error(text, cursor, UNTERMINATED_ESCAPE))
					Some(escaped_character):
						raw_character_end(text, escaped, to_int(escaped_character))


private pure func quoted_token(text: SourceText, start: Int) -> Result[Token, Diagnostic]:
	contents_start = IntOps.add(start, 1)
	-- One Result carries the scan to the closing quote or to the first error.
	var scan: Result[Int, Diagnostic] = Ok(contents_start)

	while True:
		match scan:
			Ok(cursor):
				if byte_is(text, cursor, '"'):
					break

				scan = quoted_character_end(text, start, cursor)
			Err(_):
				break

	closing ?= scan
	contents = text.bytes.substring(contents_start, IntOps.subtract(closing, contents_start))
	Ok(token(text, QuotedString(contents), start, IntOps.add(closing, 1)))


private pure func numeric_token_end(text: SourceText, start: Int, end: Int, is_float: Bool) -> Result[Token, Diagnostic]:
	if byte_in(text, end, IdentifierStart):
		Err(error_at(text, start, run_end(text, end, IdentifierByte), NUMERIC_SUFFIX))
	else:
		spelling = text.bytes.substring(start, IntOps.subtract(end, start))
		kind = if is_float:
			FloatLiteral(spelling)
		else:
			IntegerLiteral(spelling)
		Ok(token(text, kind, start, end))


-- Whether a field or function name follows `position` on its line.
private pure func name_follows(text: SourceText, position: Int) -> Bool:
	byte_in(text, run_end(text, position, SpaceByte), IdentifierStart)


private pure func exponent_token(text: SourceText, start: Int, marker: Int) -> Result[Token, Diagnostic]:
	sign = IntOps.add(marker, 1)
	digits = if byte_is(text, sign, '+') or byte_is(text, sign, '-'):
		IntOps.add(sign, 1)
	else:
		sign

	if byte_in(text, digits, DecimalDigit):
		numeric_token_end(text, start, run_end(text, digits, DecimalDigit), True)
	else:
		Err(error_at(text, start, digits, MISSING_EXPONENT))


-- Only a dot followed immediately by a digit belongs to a number. An integer
-- receiver's UFCS dot remains an ordinary symbol token when a name follows it;
-- any other dot directly after an integer is a Float missing its fraction.
private pure func numeric_token(text: SourceText, start: Int) -> Result[Token, Diagnostic]:
	digit_start = if byte_is(text, start, '-'):
		IntOps.add(start, 1)
	else:
		start
	integer_end = run_end(text, digit_start, DecimalDigit)
	after_dot = IntOps.add(integer_end, 1)
	dotted = byte_is(text, integer_end, '.')
	fraction = dotted and byte_in(text, after_dot, DecimalDigit)
	mantissa_end = if fraction:
		run_end(text, after_dot, DecimalDigit)
	else:
		integer_end

	if IntOps.equals(integer_end, digit_start):
		Err(byte_error(text, start, SEPARATED_MINUS))
	else if byte_is(text, mantissa_end, 'e') or byte_is(text, mantissa_end, 'E'):
		exponent_token(text, start, mantissa_end)
	else if dotted and not fraction and not name_follows(text, after_dot):
		Err(error_at(text, start, after_dot, MISSING_FRACTION))
	else:
		numeric_token_end(text, start, mantissa_end, fraction)


private pure func word_kind(spelling: String) -> TokenKind:
	match spelling:
		"func":
			SymbolToken(FunctionKeyword)
		"pure":
			SymbolToken(PureKeyword)
		"void":
			SymbolToken(VoidKeyword)
		"var":
			SymbolToken(VarKeyword)
		"match":
			SymbolToken(MatchKeyword)
		"_":
			SymbolToken(Wildcard)
		_:
			IdentifierToken(spelling)


private pure func punctuation(byte: Char) -> Option[Symbol]:
	match byte:
		'@':
			Some(AtSign)
		'(':
			Some(LeftParen)
		')':
			Some(RightParen)
		'{':
			Some(LeftBrace)
		'}':
			Some(RightBrace)
		'|':
			Some(RecordUpdateBar)
		'[':
			Some(LeftBracket)
		']':
			Some(RightBracket)
		',':
			Some(Comma)
		'.':
			Some(Dot)
		'/':
			Some(Slash)
		'*':
			Some(Star)
		'=':
			Some(Equals)
		':':
			Some(Colon)
		_:
			None


-- Scans the code token at `cursor`; the caller handles spaces, comments and LF.
private pure func code_token(text: SourceText, cursor: Int) -> Result[Token, Diagnostic]:
	next = IntOps.add(cursor, 1)

	if byte_is(text, cursor, '"'):
		quoted_token(text, cursor)
	else if byte_in(text, cursor, IdentifierStart):
		end = run_end(text, next, IdentifierByte)
		spelling = text.bytes.substring(cursor, IntOps.subtract(end, cursor))
		Ok(token(text, word_kind(spelling), cursor, end))
	else if byte_is(text, cursor, '-') and byte_is(text, next, '>'):
		Ok(symbol(text, Arrow, cursor, IntOps.add(cursor, 2)))
	else if byte_is(text, cursor, '+'):
		Err(byte_error(text, cursor, PLUS_SIGN))
	else if byte_in(text, cursor, DecimalDigit) or byte_is(text, cursor, '-'):
		numeric_token(text, cursor)
	else if byte_is(text, cursor, '\r'):
		Err(byte_error(text, cursor, LINE_ENDING))
	else if byte_is(text, cursor, '\t'):
		Err(byte_error(text, cursor, SEPARATING_TAB))
	else:
		punctuator = match StringOps.get(text.bytes, cursor):
			Some(byte):
				punctuation(byte)
			None:
				None

		match punctuator:
			Some(value):
				Ok(symbol(text, value, cursor, next))
			None:
				Err(byte_error(text, cursor, UNSUPPORTED_CHARACTER))


-- A comment holds ASCII bytes other than CR, up to the LF or EOF ending its line.
private pure func comment_end(text: SourceText, start: Int) -> Result[Int, Diagnostic]:
	var end: Int = IntOps.add(start, 2)

	while IntOps.less_than(end, text.bytes.length()) and comment_continues(text, end):
		end = IntOps.add(end, 1)

	if IntOps.equals(end, text.bytes.length()) or byte_is(text, end, '\n'):
		Ok(end)
	else if byte_is(text, end, '\r'):
		Err(byte_error(text, end, LINE_ENDING))
	else:
		Err(byte_error(text, end, COMMENT_BYTE))


private pure func comment_continues(text: SourceText, position: Int) -> Bool:
	match StringOps.get(text.bytes, position):
		Some(character):
			code = to_int(character)
			IntOps.less_than_or_equal(code, ASCII_DEL) and not is_byte(code, '\n') and not is_byte(code, '\r')
		None:
			False


private pure func comment_starts(text: SourceText, cursor: Int) -> Bool:
	byte_is(text, cursor, '-') and byte_is(text, IntOps.add(cursor, 1), '-')


-- Returns where the trivia at `start`, which is an LF, EOF or comment, ends:
-- `start` itself at LF or EOF, or the LF or EOF ending the comment there.
private pure func trivia_end(text: SourceText, start: Int) -> Result[Int, Diagnostic]:
	if byte_is(text, start, '-'):
		comment_end(text, start)
	else:
		Ok(start)


-- An indentation prefix is all tabs, or spaces in groups of four.
private pure func indentation_level(text: SourceText, prefix: LinePrefix) -> Result[Int, Diagnostic]:
	width = IntOps.subtract(prefix.end, prefix.start)
	whole_groups = IntOps.equals(IntOps.remainder(width, SPACE_INDENT_WIDTH), 0)

	if IntOps.equals(run_end(text, prefix.start, TabByte), prefix.end):
		Ok(width)
	else if IntOps.equals(run_end(text, prefix.start, SpaceByte), prefix.end) and whole_groups:
		Ok(IntOps.divide(width, SPACE_INDENT_WIDTH))
	else:
		Err(error_at(text, prefix.start, prefix.end, INVALID_INDENTATION))


private pure func line_prefix(text: SourceText, start: Int) -> LinePrefix:
	{ start = start, end = run_end(text, start, IndentationByte) }


-- Skips blank, whitespace-only and comment-only lines from the line at `start`
-- to the next code line. A code line may open only one level beyond `depth`,
-- so the open levels are always 0..depth and every dedent lands on one.
private pure func next_code_line(text: SourceText, start: Int, depth: Int) -> Result[CodeLine, Diagnostic]:
	-- One Result carries the line past trivia lines, or the first error.
	var scan: Result[LinePrefix, Diagnostic] = Ok(line_prefix(text, start))

	while True:
		match scan:
			Ok(line):
				if IntOps.equals(line.end, text.bytes.length()) or not (byte_is(text, line.end, '\n') or comment_starts(text, line.end)):
					break

				scan = match trivia_end(text, line.end):
					Ok(end):
						Ok(line_prefix(text, IntOps.min(IntOps.add(end, 1), text.bytes.length())))
					Err(error):
						Err(error)
			Err(_):
				break

	prefix ?= scan
	end = text.bytes.length()

	if IntOps.equals(prefix.end, end):
		Ok({ prefix = { start = end, end = end }, level = 0 })
	else:
		level ?= indentation_level(text, prefix)

		if IntOps.greater_than(level, IntOps.add(depth, 1)):
			Err(error_at(text, prefix.start, prefix.end, DEEP_INDENTATION))
		else:
			Ok({ prefix = prefix, level = level })


-- Each code line starts with an Indent when it is one level deeper than the
-- last, or a Dedent for each level it closes, spanning its indentation, and
-- ends with Newline: its LF, or empty at the end of a source without one.
pure func lex(origin: SourceId, source: String) -> Result[LexedProgram, Diagnostic]:
	text: SourceText = { origin = origin, bytes = source }
	var tokens: List[Token] = []
	var depth = 0
	-- One Result carries each code line to lay out, or the first error.
	var lines: Result[CodeLine, Diagnostic] = next_code_line(text, 0, 0)

	while True:
		match lines:
			Ok(line):
				if IntOps.greater_than(line.level, depth):
					tokens = tokens.append(symbol(text, Indent, line.prefix.start, line.prefix.end))

				while IntOps.greater_than(depth, line.level):
					tokens = tokens.append(symbol(text, Dedent, line.prefix.start, line.prefix.end))
					depth = IntOps.subtract(depth, 1)

				depth = line.level

				if IntOps.equals(line.prefix.end, source.length()):
					break

				-- One Result carries the cursor across the line to its LF or EOF, or the first error.
				var code: Result[Int, Diagnostic] = Ok(line.prefix.end)

				while True:
					match code:
						Ok(cursor):
							if IntOps.equals(cursor, source.length()) or byte_is(text, cursor, '\n'):
								break

							code = if byte_is(text, cursor, ' '):
								Ok(IntOps.add(cursor, 1))
							else if comment_starts(text, cursor):
								comment_end(text, cursor)
							else:
								match code_token(text, cursor):
									Ok(token):
										tokens = tokens.append(token)
										Ok(token.span.end)
									Err(error):
										Err(error)
						Err(_):
							break

				lines = match code:
					Ok(line_end):
						next = IntOps.min(IntOps.add(line_end, 1), source.length())
						tokens = tokens.append(symbol(text, Newline, line_end, next))
						next_code_line(text, next, depth)
					Err(error):
						Err(error)
			Err(_):
				break

	finished ?= lines
	Ok({ tokens = tokens, end = { source = origin, start = source.length(), end = source.length() } })
