import:
	./prelude:
		CheckedPrelude,
		PrimitiveType(BuiltinInt, BuiltinString),
		RuntimeOperation,
		prelude_names,
		runtime_contract,
		runtime_operation,
	int as IntOps
	names: NameId, NameTable, SpecialNames, name_spelling, same_name
	option: is_some, to_result
	parse: ParsedProgram, parsed_contents
	result: and_then
	syntax:
		BindingSyntax(ImmutableBinding, MutableBinding),
		CallNotation(DirectCall, ReceiverCall),
		Diagnostic,
		DiagnosticNote(NoDiagnosticNote),
		ExpressionBase(IntegerExpression, NameExpression, ZeroArgumentApplication),
		FieldPattern(FieldName, FieldWildcard),
		ParameterList(EmptyParameters, SingleParameter),
		ParsedBinding,
		ParsedBody(ParsedValueBody, ParsedMatchBody),
		ParsedFunction,
		ParsedMatch,
		ParsedMatchArm,
		ParsedPattern(PatternName, PatternWildcard, PatternConstructor),
		ParsedUnion,
		PatternFields(NoPatternFields, OnePatternField),
		PayloadSyntax(NoPayloadSyntax, OnePayloadSyntax),
		Purity(Pure, Impure),
		Span,
		TypeParameterSyntax(NoTypeParameterSyntax, OneTypeParameterSyntax),
		TypeSyntax(AtomicType, AppliedType),
		UnaryApplication,
		ValueExpression,
		WrittenName,
		type_span,
	text as Text


-- A function's position in the parsed and checked lists is its identity.
-- Both lists retain declaration order; no second numbering table is published.
opaque type FunctionId = Int

opaque type UnionId = Int


fixed union TypeParameterOwner:
	FunctionDeclaration(FunctionId)
	UnionDeclaration(UnionId)


-- The supported declaration has exactly one parameter: the owner identifies
-- its sole position. Function and union declaration domains remain distinct.
opaque type TypeParameterId = TypeParameterOwner


fixed union TypeParameters:
	NoTypeParameter
	OneTypeParameter(TypeParameterId)


private fixed record VariantIdentity {
	owner: UnionId,
	position: Int
}


opaque type VariantId = VariantIdentity


fixed union TypeRef:
	IntType
	StringType
	UnionType(UnionId)
	AppliedUnionType(UnionId, TypeRef)
	ParameterType(TypeParameterId)


fixed union PayloadShape:
	NoPayload
	Payload(TypeUse)


fixed record CheckedUnion {
	type_parameters: TypeParameters,
	variants: List[PayloadShape]
}


fixed record TypeUse {
	value_type: TypeRef,
	span: Span
}


fixed union ParameterShape:
	NoParameter
	OneParameter(TypeUse)


fixed record FunctionSignature {
	type_parameters: TypeParameters,
	purity: Purity,
	parameters: ParameterShape,
	return_type: TypeUse
}


fixed union CallTarget:
	UserFunction(FunctionId, Instantiation)
	RuntimeFunction(RuntimeOperation)


fixed union Instantiation:
	NoInstantiation
	InstantiateWith(TypeRef)


fixed record CheckedCall {
	target: CallTarget,
	span: Span
}


private pure func primitive_ref(value_type: PrimitiveType) -> TypeRef:
	match value_type:
		BuiltinInt:
			IntType
		BuiltinString:
			StringType


private pure func runtime_signature(operation: RuntimeOperation, span: Span) -> FunctionSignature:
	contract = runtime_contract(operation)
	{
		type_parameters = NoTypeParameter,
		purity = contract.purity,
		parameters = OneParameter({
			value_type = primitive_ref(contract.parameter),
			span = span,
		}),
		return_type = {
			value_type = primitive_ref(contract.return_type),
			span = span
		}
	}


-- IDs are dense ordinals owned by one sealed checked function, never roles.
opaque type BindingId = Int


fixed union BindingOrigin:
	ParameterBinding
	BodyLocal
	MatchCapture


fixed union BindingMutability:
	Immutable
	Mutable


fixed record BindingDefinition {
	origin: BindingOrigin,
	mutability: BindingMutability,
	value_type: TypeRef,
	span: Span
}


pure func binding_number(id: BindingId) -> Int:
	from_opaque BindingId(id)


fixed union CheckedBase:
	ReturnInteger(Int)
	ReturnVariant(VariantId)
	ReturnBinding(BindingId)
	ReturnCall(CheckedCall)


fixed union CheckedOperation:
	InvokeFunction(CheckedCall)
	ConstructVariant(VariantId)


fixed record CheckedStep {
	operation: CheckedOperation,
	value_type: TypeRef,
	span: Span
}


fixed record CheckedValue {
	base: CheckedBase,
	base_type: TypeRef,
	base_span: Span,
	operations: List[CheckedStep]
}


fixed union CheckedAssignment:
	InitializeBinding(BindingId, CheckedValue)
	ReassignBinding(BindingId, CheckedValue)


fixed union PayloadBinding:
	NoPayloadBinding
	DiscardPayload
	BindPayload(BindingId)


fixed union CheckedPattern:
	VariantCase(VariantId, PayloadBinding)
	WildcardCase
	BindingCase(BindingId)


fixed record CheckedArm {
	pattern: CheckedPattern,
	assignments: List[CheckedAssignment],
	body: CheckedValue
}


fixed record CheckedMatch {
	scrutinee: CheckedValue,
	union_type: TypeRef,
	arms: List[CheckedArm]
}


fixed union CheckedBody:
	CheckedValueBody(CheckedValue)
	CheckedMatchBody(CheckedMatch)


fixed record CheckedFunction {
	signature: FunctionSignature,
	bindings: List[BindingDefinition],
	assignments: List[CheckedAssignment],
	body: CheckedBody
}


fixed record CheckedFunctions {
	unions: List[CheckedUnion],
	functions: List[CheckedFunction],
	entrypoint: FunctionId
}


opaque type CheckedProgram = CheckedFunctions


pure func union_number(id: UnionId) -> Int:
	from_opaque UnionId(id)


pure func variant_owner(id: VariantId) -> UnionId:
	from_opaque VariantId(id).owner


pure func variant_number(id: VariantId) -> Int:
	from_opaque VariantId(id).position


pure func same_type(left: TypeRef, right: TypeRef) -> Bool:
	match left:
		AppliedUnionType(left_owner, left_argument):
			match right:
				AppliedUnionType(right_owner, right_argument):
					(
						IntOps.equals(union_number(left_owner), union_number(right_owner))
						and same_type(left_argument, right_argument)
					)
				_:
					False
		ParameterType(left):
			match right:
				ParameterType(right):
					same_parameter(left, right)
				_:
					False
		IntType:
			match right:
				IntType:
					True
				_:
					False
		StringType:
			match right:
				StringType:
					True
				_:
					False
		UnionType(left):
			match right:
				UnionType(right):
					IntOps.equals(union_number(left), union_number(right))
				_:
					False


pure func function_number(id: FunctionId) -> Int:
	from_opaque FunctionId(id)


pure func parameter_owner(id: TypeParameterId) -> TypeParameterOwner:
	from_opaque TypeParameterId(id)


pure func same_parameter(left: TypeParameterId, right: TypeParameterId) -> Bool:
	match parameter_owner(left):
		FunctionDeclaration(left):
			match parameter_owner(right):
				FunctionDeclaration(right):
					IntOps.equals(function_number(left), function_number(right))
				_:
					False
		UnionDeclaration(left):
			match parameter_owner(right):
				UnionDeclaration(right):
					IntOps.equals(union_number(left), union_number(right))
				_:
					False


pure func checked_functions(program: CheckedProgram) -> CheckedFunctions:
	from_opaque CheckedProgram(program)


pure func declaration_id(program: CheckedProgram, position: Int) -> Option[FunctionId]:
	from_opaque CheckedProgram(program).functions
		.get(position)
		.map(pure func(_): into_opaque FunctionId(position))


pure func union_declaration_id(program: CheckedProgram, position: Int) -> Option[UnionId]:
	from_opaque CheckedProgram(program).unions
		.get(position)
		.map(pure func(_): into_opaque UnionId(position))


private pure func find_function(
	functions: List[ParsedFunction],
	name: NameId,
) -> Option[FunctionId]:
	var index: Int = 0
	var found: Option[FunctionId] = None

	for function in functions:
		if same_name(function.function_name.id, name):
			found = Some(into_opaque FunctionId(index))
			break

		index = IntOps.add(index, 1)

	found


private pure func rejection(span: Span, message: String, help: String) -> Diagnostic:
	{
		span = span,
		note = NoDiagnosticNote,
		message = message,
		help = help
	}


private pure func internal_error(span: Span, message: String) -> Diagnostic:
	rejection(span, message, "report this compiler error with the input program")


private pure func find_union(unions: List[ParsedUnion], name: NameId) -> Option[UnionId]:
	var index: Int = 0
	var found: Option[UnionId] = None

	for declaration in unions:
		if same_name(declaration.type_name.id, name):
			found = Some(into_opaque UnionId(index))
			break

		index = IntOps.add(index, 1)

	found


private pure func contains_variant(unions: List[ParsedUnion], name: NameId) -> Bool:
	var found = False

	for declaration in unions:
		for variant in declaration.variants:
			if same_name(variant.name.id, name):
				found = True
				break

		if found:
			break

	found


private pure func validate_union(
	declaration: ParsedUnion,
	functions: List[ParsedFunction],
) -> Result[Void, Diagnostic]:
	var previous: List[WrittenName] = []
	var failure: Option[Diagnostic] = None

	for written in declaration.variants:
		variant = written.name

		for known in previous:
			if same_name(known.id, variant.id):
				failure = Some(
					rejection(
						variant.span,
						"duplicate variant name",
						"give each variant in a union a distinct name",
					),
				)
				break

		if failure.is_some():
			break

		match find_function(functions, variant.id):
			None:
				void
			Some(id):
				match functions.get(function_number(id)):
					None:
						failure = Some(
							internal_error(
								variant.span,
								"invalid resolved function identity",
							),
						)
					Some(function):
						span = if IntOps.less_than(
							variant.span.start,
							function.function_name.span.start,
						):
							function.function_name.span
						else:
							variant.span

						failure = Some(
							rejection(
								span,
								"variant name conflicts with a function",
								"give functions and union variants distinct names",
							),
						)

		if failure.is_some():
			break

		previous = previous.append(variant)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)


private pure func validate_unions(
	unions: List[ParsedUnion],
	functions: List[ParsedFunction],
	special: SpecialNames,
) -> Result[List[CheckedUnion], Diagnostic]:
	var previous: List[ParsedUnion] = []
	var checked: List[CheckedUnion] = []
	var failure: Option[Diagnostic] = None

	for declaration in unions:
		if (
			same_name(declaration.type_name.id, special.integer)
			or same_name(declaration.type_name.id, special.string)
			or find_union(previous, declaration.type_name.id).is_some()
		):
			failure = Some(
				rejection(
					declaration.type_name.span,
					"duplicate union type name",
					"give union types distinct names; Int and String are declared by the prelude",
				),
			)
			break

		match validate_union(declaration, functions):
			Err(error):
				failure = Some(error)
				break
			Ok(_):
				parameter_result = local_type_parameter(
					declaration.type_parameters,
					UnionDeclaration(into_opaque UnionId(checked.length())),
					unions,
					special,
				)

				match parameter_result.and_then(
					pure func(parameter): resolve_payloads(declaration, parameter, special),
				):
					Err(error):
						failure = Some(error)
						break
					Ok(shapes):
						match parameter_result:
							Ok(parameter):
								checked = checked.append({
									type_parameters = declared_parameters(parameter),
									variants = shapes,
								})
							Err(error):
								failure = Some(error)

		previous = previous.append(declaration)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(checked)


private pure func payload_type_error(span: Span, parameter: Option[LocalTypeParameter]) -> Diagnostic:
	match parameter:
		None:
			rejection(span, "only Int payloads are supported", "declare a variant with no fields or one Int field, written Variant(Int)")
		Some(_):
			rejection(span, "only Int or the union's type parameter may be payloads", "declare no field, one Int field, or one field using this union's declared type ".concat("parameter"))


private pure func resolve_payloads(
	declaration: ParsedUnion,
	type_parameter: Option[LocalTypeParameter],
	special: SpecialNames,
) -> Result[List[PayloadShape], Diagnostic]:
	var shapes: List[PayloadShape] = []
	var failure: Option[Diagnostic] = None

	for variant in declaration.variants:
		match variant.payload:
			NoPayloadSyntax:
				shapes = shapes.append(NoPayload)
			OnePayloadSyntax(name):
				parameter = match type_parameter:
					Some(parameter):
						if same_name(name.id, parameter.name):
							Some(parameter.id)
						else:
							None
					None:
						None

				value_result: Result[TypeRef, Diagnostic] = if same_name(name.id, special.integer):
					Ok(IntType)
				else:
					match parameter:
						Some(id):
							Ok(ParameterType(id))
						None:
							Err(payload_type_error(name.span, type_parameter))

				match value_result:
					Ok(value):
						shapes = shapes.append(Payload({
							value_type = value,
							span = name.span,
						}))
					Err(error):
						failure = Some(error)
						break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(shapes)


private fixed record LocalTypeParameter {
	name: NameId,
	id: TypeParameterId
}


private pure func local_type_parameter(
	written: TypeParameterSyntax,
	owner: TypeParameterOwner,
	unions: List[ParsedUnion],
	special: SpecialNames,
) -> Result[Option[LocalTypeParameter], Diagnostic]:
	match written:
		NoTypeParameterSyntax:
			Ok(None)
		OneTypeParameterSyntax(name):
			if (
				same_name(name.id, special.integer)
				or same_name(name.id, special.string)
				or find_union(unions, name.id).is_some()
			):
				Err(
					rejection(
						name.span,
						"type parameter conflicts with a type name",
						"choose a distinct type parameter name, such as T",
					),
				)
			else:
				Ok(Some({
					name = name.id,
					id = into_opaque TypeParameterId(owner),
				}))


private pure func resolve_type_parameter(
	function: ParsedFunction,
	id: FunctionId,
	unions: List[ParsedUnion],
	special: SpecialNames,
) -> Result[Option[LocalTypeParameter], Diagnostic]:
	valid_main ?= match function.type_parameters:
		OneTypeParameterSyntax(name):
			if same_name(function.function_name.id, special.main):
				Err(
					rejection(
						name.span,
						"main cannot be generic",
						"declare main() -> Int: without type parameters",
					),
				)
			else:
				Ok(void)
		NoTypeParameterSyntax:
			Ok(void)

	local_type_parameter(function.type_parameters, FunctionDeclaration(id), unions, special)


private pure func declared_parameters(parameter: Option[LocalTypeParameter]) -> TypeParameters:
	match parameter:
		Some(parameter):
			OneTypeParameter(parameter.id)
		None:
			NoTypeParameter


private pure func resolve_atomic_type(
	unions: List[ParsedUnion],
	special: SpecialNames,
	name: WrittenName,
	type_parameter: Option[LocalTypeParameter],
) -> Result[TypeRef, Diagnostic]:
	local = match type_parameter:
		Some(parameter):
			if same_name(name.id, parameter.name):
				Some(parameter.id)
			else:
				None
		None:
			None

	match local:
		Some(id):
			Ok(ParameterType(id))
		None:
			if same_name(name.id, special.integer):
				Ok(IntType)
			else if same_name(name.id, special.string):
				Ok(StringType)
			else:
				match find_union(unions, name.id):
					Some(id):
						declaration ?= unions
							.get(union_number(id))
							.to_result(internal_error(name.span, "invalid union declaration"))

						match declaration.type_parameters:
							NoTypeParameterSyntax:
								Ok(UnionType(id))
							OneTypeParameterSyntax(_):
								Err(
									rejection(
										name.span,
										"generic union requires one type argument",
										"write a concrete or symbolic application, such as Box[Int] or Box[T]",
									),
								)
					None:
						Err(
							rejection(
								name.span,
								"unknown type",
								(
									"use Int, String, a declared type parameter, or a fixed union declared in this ".concat("file")
								),
							),
						)


private pure func resolve_type(
	unions: List[ParsedUnion],
	special: SpecialNames,
	written: TypeSyntax,
	type_parameter: Option[LocalTypeParameter],
) -> Result[TypeRef, Diagnostic]:
	match written:
		AtomicType(name):
			resolve_atomic_type(unions, special, name, type_parameter)
		AppliedType(name, argument, span):
			owner ?= find_union(
				unions,
				name.id,
			).to_result(
				rejection(
					name.span,
					"type does not accept a type argument",
					"apply a declared generic union, such as Box[Int]",
				),
			)
			declaration ?= unions
				.get(union_number(owner))
				.to_result(internal_error(span, "invalid union declaration"))

			arity ?= match declaration.type_parameters:
				OneTypeParameterSyntax(_):
					Ok(void)
				NoTypeParameterSyntax:
					Err(
						rejection(
							span,
							"ordinary union does not accept a type argument",
							"remove the type argument from this union type",
						),
					)

			value ?= resolve_atomic_type(unions, special, argument, type_parameter)
			Ok(AppliedUnionType(owner, value))


private fixed record CheckedSignatures {
	functions: List[FunctionSignature],
	entrypoint: FunctionId
}


private pure func resolve_parameters(
	parameters: ParameterList,
	function_name: NameId,
	unions: List[ParsedUnion],
	special: SpecialNames,
	type_parameter: Option[LocalTypeParameter],
) -> Result[ParameterShape, Diagnostic]:
	match parameters:
		EmptyParameters:
			Ok(NoParameter)
		SingleParameter(parameter):
			main_parameter ?= if same_name(function_name, special.main):
				Err(
					rejection(
						parameter.name.span,
						"main cannot have a parameter",
						"declare main() -> Int: with no parameters",
					),
				)
			else:
				Ok(void)

			parameter_type ?= resolve_type(unions, special, parameter.type_name, type_parameter)
			Ok(OneParameter({
				value_type = parameter_type,
				span = type_span(parameter.type_name),
			}))


private pure func resolve_signature(
	function: ParsedFunction,
	id: FunctionId,
	unions: List[ParsedUnion],
	special: SpecialNames,
) -> Result[FunctionSignature, Diagnostic]:
	type_parameter ?= resolve_type_parameter(function, id, unions, special)
	return_type ?= resolve_type(unions, special, function.return_type, type_parameter)

	main_type ?= if (
		same_name(function.function_name.id, special.main)
		and not same_type(return_type, IntType)
	):
		Err(
			rejection(
				type_span(function.return_type),
				"main must return Int",
				"declare main() -> Int: as the entrypoint",
			),
		)
	else:
		Ok(void)

	parameters ?= resolve_parameters(
		function.parameters,
		function.function_name.id,
		unions,
		special,
		type_parameter,
	)

	type_parameters = match type_parameter:
		Some(parameter):
			OneTypeParameter(parameter.id)
		None:
			NoTypeParameter

	Ok({
		type_parameters = type_parameters,
		purity = function.purity,
		parameters = parameters,
		return_type = {
			value_type = return_type,
			span = type_span(function.return_type)
		},
	})


private pure func validate_signatures(
	functions: List[ParsedFunction],
	unions: List[ParsedUnion],
	end: Span,
	special: SpecialNames,
) -> Result[CheckedSignatures, Diagnostic]:
	var previous: List[ParsedFunction] = []
	var signatures: List[FunctionSignature] = []
	var failure: Option[Diagnostic] = None

	for function in functions:
		if find_function(previous, function.function_name.id).is_some():
			failure = Some(
				rejection(
					function.function_name.span,
					"duplicate function name",
					"give every function a distinct name",
				),
			)
			break

		match resolve_signature(
			function,
			into_opaque FunctionId(previous.length()),
			unions,
			special,
		):
			Err(error):
				failure = Some(error)
				break
			Ok(signature):
				signatures = signatures.append(signature)

		previous = previous.append(function)

	match failure:
		Some(error):
			Err(error)
		None:
			match find_function(functions, special.main):
				Some(id):
					Ok({
						functions = signatures,
						entrypoint = id,
					})
				None:
					Err(
						rejection(
							end,
							"expected a main function",
							"declare func main() -> Int: as the entrypoint",
						),
					)


private pure func validate_call(
	caller: Purity,
	callee: Purity,
	span: Span,
) -> Result[Void, Diagnostic]:
	match caller:
		Impure:
			Ok(void)
		Pure:
			match callee:
				Pure:
					Ok(void)
				Impure:
					Err(
						rejection(
							span,
							"pure functions cannot call impure functions",
							"mark the callee pure or remove pure from the caller",
						),
					)


private fixed record LocalBinding {
	name: NameId,
	id: BindingId,
	definition: BindingDefinition
}


private pure func lookup_binding(scope: List[LocalBinding], name: NameId) -> Option[LocalBinding]:
	var found: Option[LocalBinding] = None

	for binding in scope:
		if same_name(binding.name, name):
			found = Some(binding)
			break

	found


private fixed record ResolutionContext {
	functions: List[ParsedFunction],
	signatures: List[FunctionSignature],
	unions: List[ParsedUnion],
	checked_unions: List[CheckedUnion],
	names: NameTable,
	prelude: CheckedPrelude
}


private fixed record ResolvedCall {
	call: CheckedCall,
	signature: FunctionSignature
}


private fixed record UnaryContract {
	type_parameters: TypeParameters,
	operation: CheckedOperation,
	parameter_type: TypeRef,
	return_type: TypeRef,
	span: Span
}


private fixed union PendingApplication:
	FunctionApplication(UnaryContract)
	ConstructorApplication(WrittenName)


private pure func non_callable(binding: LocalBinding, span: Span) -> Diagnostic:
	match binding.definition.origin:
		ParameterBinding:
			message = if same_type(binding.definition.value_type, IntType):
				"Int parameters cannot be called"
			else:
				"parameters cannot be called"

			rejection(
				span,
				message,
				"use the parameter as a value, or rename it to call the function",
			)
		MatchCapture:
			rejection(
				span,
				"match bindings cannot be called",
				"use the binding as a value, or rename it to call the function",
			)
		BodyLocal:
			rejection(
				span,
				"local bindings cannot be called",
				"use the binding as a value, or rename it to call the function",
			)


private pure func resolve_function_target(
	name: WrittenName,
	target: CallTarget,
	signatures: List[FunctionSignature],
) -> Result[ResolvedCall, Diagnostic]:
	signature ?= match target:
		UserFunction(id, _):
			signatures
				.get(function_number(id))
				.to_result(internal_error(name.span, "invalid resolved function identity"))
		RuntimeFunction(operation):
			Ok(runtime_signature(operation, name.span))

	Ok({
		call = {
			target = target,
			span = name.span
		},
		signature = signature,
	})


private pure func lookup_target(
	functions: List[ParsedFunction],
	prelude: CheckedPrelude,
	name: NameId,
) -> Option[CallTarget]:
	match find_function(functions, name):
		Some(id):
			Some(UserFunction(id, NoInstantiation))
		None:
			runtime_operation(prelude, name).map(pure func(operation): RuntimeFunction(operation))


private pure func unary_function(
	purity: Purity,
	call: UnaryApplication,
	resolved: ResolvedCall,
	names: NameTable,
) -> Result[UnaryContract, Diagnostic]:
	match resolved.signature.parameters:
		OneParameter(parameter_type):
			pure_call ?= validate_call(purity, resolved.signature.purity, call.callee.span)
			Ok({
				type_parameters = resolved.signature.type_parameters,
				operation = InvokeFunction(resolved.call),
				parameter_type = parameter_type.value_type,
				return_type = resolved.signature.return_type.value_type,
				span = call.callee.span,
			})
		NoParameter:
			error: Diagnostic = match call.notation:
				DirectCall:
					rejection(
						call.callee.span,
						"function takes no arguments",
						"remove the argument and call the function with ()",
					)
				ReceiverCall:
					match name_spelling(names, call.callee.id):
						None:
							internal_error(call.callee.span, "invalid parsed name identity")
						Some(spelling):
							rejection(
								call.callee.span,
								"function takes no arguments",
								Text
									.concat("call ", spelling)
									.concat("() directly, or choose a function with one parameter"),
							)

			Err(error)


private pure func classify_application(
	purity: Purity,
	scope: List[LocalBinding],
	call: UnaryApplication,
	context: ResolutionContext,
) -> Result[PendingApplication, Diagnostic]:
	local = match call.notation:
		DirectCall:
			lookup_binding(scope, call.callee.id)
		ReceiverCall:
			None

	match local:
		Some(binding):
			Err(non_callable(binding, call.callee.span))
		None:
			match lookup_target(context.functions, context.prelude, call.callee.id):
				Some(target):
					resolved ?= resolve_function_target(call.callee, target, context.signatures)
					contract ?= unary_function(purity, call, resolved, context.names)
					Ok(FunctionApplication(contract))
				None:
					if contains_variant(context.unions, call.callee.id):
						match call.notation:
							DirectCall:
								Ok(ConstructorApplication(call.callee))
							ReceiverCall:
								Err(
									rejection(
										call.callee.span,
										"constructors do not support UFCS in this increment",
										"write the constructor directly, such as Number(value)",
									),
								)
					else:
						Err(
							rejection(
								call.callee.span,
								"unknown function",
								"declare the called function in this file or the explicit prelude",
							),
						)


private fixed record VariantContract {
	variant: VariantId,
	result_type: TypeRef,
	payload: PayloadShape
}


private pure func type_union_owner(value: TypeRef) -> Option[UnionId]:
	match value:
		UnionType(id):
			Some(id)
		AppliedUnionType(id, _):
			Some(id)
		_:
			None


private pure func occurrence_payload(
	payload: PayloadShape,
	parameters: TypeParameters,
	union_type: TypeRef,
) -> PayloadShape:
	match payload:
		NoPayload:
			NoPayload
		Payload(written):
			match parameters:
				NoTypeParameter:
					payload
				OneTypeParameter(parameter):
					match union_type:
						AppliedUnionType(_, argument):
							Payload(
								{ written |
									value_type = substitute_type(
										written.value_type,
										parameter,
										argument,
									)
								},
							)
						_:
							payload


private pure func find_variant(
	context: ResolutionContext,
	union_type: TypeRef,
	name: WrittenName,
) -> Result[Option[VariantContract], Diagnostic]:
	owner ?= type_union_owner(
		union_type,
	).to_result(internal_error(name.span, "variant occurrence has no union type"))
	declaration ?= context.unions
		.get(union_number(owner))
		.to_result(internal_error(name.span, "invalid resolved union identity"))
	checked ?= context.checked_unions
		.get(union_number(owner))
		.to_result(internal_error(name.span, "invalid checked union identity"))
	var found: Option[VariantContract] = None
	var position: Int = 0
	var failure: Option[Diagnostic] = None

	for variant in declaration.variants:
		if same_name(variant.name.id, name.id):
			match checked.variants.get(position):
				None:
					failure = Some(internal_error(name.span, "invalid resolved variant identity"))
				Some(payload):
					found = Some({
						variant = into_opaque VariantId({
								owner = owner,
								position = position
							}),
						result_type = union_type,
						payload = occurrence_payload(payload, checked.type_parameters, union_type),
					})

			break

		position = IntOps.add(position, 1)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(found)


private pure func parameter_spelling(
	id: TypeParameterId,
	context: ResolutionContext,
	span: Span,
) -> Result[String, Diagnostic]:
	written ?= match parameter_owner(id):
		FunctionDeclaration(id):
			context.functions
				.get(function_number(id))
				.map(pure func(declaration): declaration.type_parameters)
				.to_result(internal_error(span, "invalid parameter declaration"))
		UnionDeclaration(id):
			context.unions
				.get(union_number(id))
				.map(pure func(declaration): declaration.type_parameters)
				.to_result(internal_error(span, "invalid parameter declaration"))

	match written:
		OneTypeParameterSyntax(name):
			name_spelling(
				context.names,
				name.id,
			).to_result(internal_error(span, "invalid parameter name"))
		NoTypeParameterSyntax:
			Err(internal_error(span, "parameter owner has no parameter"))


private pure func type_spelling(
	value: TypeRef,
	context: ResolutionContext,
	span: Span,
) -> Result[String, Diagnostic]:
	match value:
		IntType:
			Ok("Int")
		StringType:
			Ok("String")
		ParameterType(id):
			parameter_spelling(id, context, span)
		UnionType(id):
			declaration ?= context.unions
				.get(union_number(id))
				.to_result(internal_error(span, "invalid resolved union identity"))
			name_spelling(
				context.names,
				declaration.type_name.id,
			).to_result(internal_error(span, "invalid parsed name identity"))
		AppliedUnionType(id, argument):
			name ?= type_spelling(UnionType(id), context, span)
			argument ?= type_spelling(argument, context, span)
			Ok(
				name
					.concat("[")
					.concat(argument)
					.concat("]"),
			)


private pure func type_rejection(
	span: Span,
	message: String,
	expected_type: TypeRef,
	context: ResolutionContext,
) -> Diagnostic:
	match expected_type:
		ParameterType(_):
			rejection(
				span,
				message,
				"use a value already typed as this declaration's type parameter",
			)
		_:
			match type_spelling(expected_type, context, span):
				Err(error):
					error
				Ok(spelling):
					rejection(
						span,
						message,
						"use an expression of type "
							.concat(spelling)
							.concat(" here"),
					)


private pure func contextual_constructor(
	name: WrittenName,
	expected_type: Option[TypeRef],
	context: ResolutionContext,
) -> Result[VariantContract, Diagnostic]:
	match expected_type:
		None:
			Err(
				rejection(
					name.span,
					"constructor needs an expected union type",
					"pass an already-typed union value or call a concrete helper returning the union",
				),
			)
		Some(type_ref):
			found ?= match type_ref:
				IntType | StringType | ParameterType(_):
					Ok(None)
				AppliedUnionType(owner, _):
					find_variant(context, type_ref, name)
				UnionType(owner):
					find_variant(context, type_ref, name)

			match found:
				Some(contract):
					Ok(contract)
				None:
					Err(
						type_rejection(
							name.span,
							"variant does not belong to the expected type",
							type_ref,
							context,
						),
					)


private pure func unary_constructor(
	name: WrittenName,
	expected_type: Option[TypeRef],
	context: ResolutionContext,
) -> Result[UnaryContract, Diagnostic]:
	contract ?= contextual_constructor(name, expected_type, context)

	match contract.payload:
		NoPayload:
			Err(
				rejection(
					name.span,
					"payload-free variants cannot be called",
					"use the bare variant name without parentheses",
				),
			)
		Payload(payload):
			Ok({
				type_parameters = NoTypeParameter,
				operation = ConstructVariant(contract.variant),
				parameter_type = payload.value_type,
				return_type = contract.result_type,
				span = name.span,
			})


private fixed record ResolvedBase {
	base: CheckedBase,
	value_type: TypeRef
}


private pure func constructor_base(
	name: WrittenName,
	expected_type: Option[TypeRef],
	called: Bool,
	context: ResolutionContext,
) -> Result[ResolvedBase, Diagnostic]:
	contract ?= contextual_constructor(name, expected_type, context)

	match contract.payload:
		Payload(payload):
			message = if same_type(payload.value_type, IntType):
				"constructor requires one Int argument"
			else:
				"constructor requires one payload argument"

			help = if same_type(payload.value_type, IntType):
				"pass one Int expression, such as Number(42)"
			else:
				"pass a value of the constructor's declared payload type"

			Err(rejection(name.span, message, help))
		NoPayload:
			if called:
				Err(
					rejection(
						name.span,
						"payload-free variants cannot be called",
						"use the bare variant name without parentheses",
					),
				)
			else:
				Ok({
					base = ReturnVariant(contract.variant),
					value_type = contract.result_type,
				})


private pure func resolve_base(
	purity: Purity,
	scope: List[LocalBinding],
	base: ExpressionBase,
	expected_type: Option[TypeRef],
	context: ResolutionContext,
) -> Result[ResolvedBase, Diagnostic]:
	match base:
		IntegerExpression(value):
			Ok({
				base = ReturnInteger(value),
				value_type = IntType,
			})
		NameExpression(name):
			match lookup_binding(scope, name.id):
				Some(binding):
					Ok({
						base = ReturnBinding(binding.id),
						value_type = binding.definition.value_type,
					})
				None:
					if contains_variant(context.unions, name.id):
						constructor_base(name, expected_type, False, context)
					else:
						Err(
							rejection(
								name.span,
								"unknown value",
								"use this function's parameter name, a declared variant, or a call",
							),
						)
		ZeroArgumentApplication(name):
			match lookup_binding(scope, name.id):
				Some(binding):
					Err(non_callable(binding, name.span))
				None:
					match lookup_target(context.functions, context.prelude, name.id):
						None:
							if contains_variant(context.unions, name.id):
								constructor_base(name, expected_type, True, context)
							else:
								Err(
									rejection(
										name.span,
										"unknown function",
										"declare the called function in this file or the explicit prelude",
									),
								)
						Some(target):
							resolved ?= resolve_function_target(name, target, context.signatures)

							match resolved.signature.parameters:
								OneParameter(_):
									Err(
										rejection(
											name.span,
											"function requires one argument",
											"pass one expression of the declared parameter type",
										),
									)
								NoParameter:
									inferred ?= match resolved.signature.type_parameters:
										NoTypeParameter:
											Ok(void)
										OneTypeParameter(_):
											Err(uninferable(name.span))

									pure_call ?= validate_call(
										purity,
										resolved.signature.purity,
										name.span,
									)
									Ok({
										base = ReturnCall(resolved.call),
										value_type = resolved.signature.return_type.value_type,
									})


private fixed record ResolvedValue {
	value: CheckedValue,
	value_type: TypeRef
}


private pure func resolve_value(
	purity: Purity,
	scope: List[LocalBinding],
	body: ValueExpression,
	expected_type: Option[TypeRef],
	context: ResolutionContext,
) -> Result[ResolvedValue, Diagnostic]:
	-- Preserve the established function-contract diagnostic order before the base.
	var pending: List[PendingApplication] = []
	var failure: Option[Diagnostic] = None

	for call in body.applications:
		match classify_application(purity, scope, call, context):
			Err(error):
				failure = Some(error)
				break
			Ok(application):
				pending = pending.append(application)

	var expectation = expected_type
	var outside_in: List[UnaryContract] = []

	if not failure.is_some():
		for application in pending.reverse():
			match complete_application(application, expectation, context):
				Err(error):
					failure = Some(error)
					break
				Ok(contract):
					outside_in = outside_in.append(contract)

					expectation = match contract.type_parameters:
						NoTypeParameter:
							Some(contract.parameter_type)
						OneTypeParameter(_):
							None

	validated ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(outside_in.reverse())

	base ?= resolve_base(purity, scope, body.base, expectation, context)
	var current_type = base.value_type
	var operations: List[CheckedStep] = []

	for pending_contract in validated:
		match instantiate_contract(pending_contract, current_type):
			Err(error):
				failure = Some(error)
				break
			Ok(contract):
				if not same_type(current_type, contract.parameter_type):
					failure = Some(
						type_rejection(
							contract.span,
							"argument type does not match the parameter type",
							contract.parameter_type,
							context,
						),
					)
					break

				operations = operations.append({
					operation = contract.operation,
					value_type = contract.return_type,
					span = contract.span,
				})
				current_type = contract.return_type

	finished ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	accepted ?= match expected_type:
		None:
			Ok(void)
		Some(type_ref):
			if same_type(current_type, type_ref):
				Ok(void)
			else:
				Err(
					type_rejection(
						body.span,
						"expression does not match the expected type",
						type_ref,
						context,
					),
				)

	Ok({
		value = {
			base = base.base,
			base_type = base.value_type,
			base_span = body.base_span,
			operations = operations
		},
		value_type = current_type,
	})


private pure func uninferable(span: Span) -> Diagnostic:
	rejection(
		span,
		"cannot infer the type parameter from the argument",
		Text.concat(
			"pass a value whose type determines the declared type parameter; use a concrete ",
			"helper when no argument can determine it",
		),
	)


private pure func substitute_type(
	value_type: TypeRef,
	parameter: TypeParameterId,
	argument: TypeRef,
) -> TypeRef:
	match value_type:
		AppliedUnionType(owner, value):
			AppliedUnionType(
				owner,
				substitute_type(value, parameter, argument),
			)
		ParameterType(id):
			if same_parameter(id, parameter):
				argument
			else:
				value_type
		_:
			value_type


private pure func infer_type_argument(
	expected: TypeRef,
	actual: TypeRef,
	parameter: TypeParameterId,
) -> Option[TypeRef]:
	match expected:
		ParameterType(id):
			if same_parameter(id, parameter):
				Some(actual)
			else:
				None
		AppliedUnionType(owner, expected_argument):
			match actual:
				AppliedUnionType(actual_owner, actual_argument):
					if IntOps.equals(union_number(owner), union_number(actual_owner)):
						infer_type_argument(expected_argument, actual_argument, parameter)
					else:
						None
				_:
					None
		_:
			None


private pure func instantiate_contract(
	contract: UnaryContract,
	actual: TypeRef,
) -> Result[UnaryContract, Diagnostic]:
	match contract.type_parameters:
		NoTypeParameter:
			Ok(contract)
		OneTypeParameter(parameter):
			argument ?= infer_type_argument(
				contract.parameter_type,
				actual,
				parameter,
			).to_result(uninferable(contract.span))

			operation ?= match contract.operation:
				InvokeFunction(call):
					match call.target:
						UserFunction(id, _):
							Ok(
								InvokeFunction(
									{ call |
										target = UserFunction(id, InstantiateWith(argument))
									},
								),
							)
						RuntimeFunction(_):
							Err(internal_error(contract.span, "runtime call has a type parameter"))
				ConstructVariant(_):
					Err(internal_error(contract.span, "generic constructor contract"))

			Ok({ contract |
					type_parameters = NoTypeParameter,
					operation = operation,
					parameter_type = substitute_type(contract.parameter_type, parameter, argument),
					return_type = substitute_type(contract.return_type, parameter, argument)
				})


private pure func complete_application(
	application: PendingApplication,
	expected_type: Option[TypeRef],
	context: ResolutionContext,
) -> Result[UnaryContract, Diagnostic]:
	match application:
		FunctionApplication(contract):
			Ok(contract)
		ConstructorApplication(name):
			unary_constructor(name, expected_type, context)


private fixed record ResolvedPattern {
	pattern: CheckedPattern,
	scope: List[LocalBinding],
	binding: Option[BindingDefinition]
}


private pure func bound_pattern(
	name: WrittenName,
	type_ref: TypeRef,
	ordinal: Int,
	scope: List[LocalBinding],
	pattern: CheckedPattern,
) -> ResolvedPattern:
	{
		pattern = pattern,
		scope = [
			{
				name = name.id,
				id = into_opaque BindingId(ordinal),
				definition = {
					origin = MatchCapture,
					mutability = Immutable,
					value_type = type_ref,
					span = name.span
				}
			},
		].concat(scope),
		binding = Some({
			origin = MatchCapture,
			mutability = Immutable,
			value_type = type_ref,
			span = name.span,
		})
	}


private pure func resolve_variant_pattern(
	contract: VariantContract,
	fields: PatternFields,
	span: Span,
	ordinal: Int,
	scope: List[LocalBinding],
) -> Result[ResolvedPattern, Diagnostic]:
	match contract.payload:
		NoPayload:
			match fields:
				NoPatternFields:
					Ok({
						pattern = VariantCase(contract.variant, NoPayloadBinding),
						scope = scope,
						binding = None,
					})
				OnePatternField(_):
					Err(
						rejection(
							span,
							"constructor pattern takes no fields",
							"use the bare variant name or Variant() without field patterns",
						),
					)
		Payload(payload):
			match fields:
				NoPatternFields:
					help = if same_type(payload.value_type, IntType):
						"write Variant(name) to bind the Int field, or Variant(_) to ignore it"
					else:
						"write Variant(name) to bind the payload, or Variant(_) to ignore it"

					Err(rejection(span, "constructor pattern requires one field", help))
				OnePatternField(field):
					match field:
						FieldWildcard(_):
							Ok({
								pattern = VariantCase(contract.variant, DiscardPayload),
								scope = scope,
								binding = None,
							})
						FieldName(name):
							Ok(
								bound_pattern(
									name,
									payload.value_type,
									ordinal,
									scope,
									VariantCase(
										contract.variant,
										BindPayload(into_opaque BindingId(ordinal)),
									),
								),
							)


private pure func resolve_pattern(
	pattern: ParsedPattern,
	union_type: TypeRef,
	ordinal: Int,
	scope: List[LocalBinding],
	context: ResolutionContext,
) -> Result[ResolvedPattern, Diagnostic]:
	match pattern:
		PatternWildcard(_):
			Ok({
				pattern = WildcardCase,
				scope = scope,
				binding = None,
			})
		PatternName(name):
			contract ?= if lookup_binding(scope, name.id).is_some():
				Ok(None)
			else:
				find_variant(context, union_type, name)

			match contract:
				Some(contract):
					resolve_variant_pattern(contract, NoPatternFields, name.span, ordinal, scope)
				None:
					Ok(
						bound_pattern(
							name,
							union_type,
							ordinal,
							scope,
							BindingCase(into_opaque BindingId(ordinal)),
						),
					)
		PatternConstructor(name, fields, span):
			contract ?= if lookup_binding(scope, name.id).is_some():
				Ok(None)
			else:
				find_variant(context, union_type, name)

			match contract:
				Some(contract):
					resolve_variant_pattern(contract, fields, span, ordinal, scope)
				None:
					Err(
						rejection(
							span,
							"unknown constructor pattern",
							"use an unshadowed variant of the matched union; rename a shadowing local binding",
						),
					)


private pure func same_variant(left: VariantId, right: VariantId) -> Bool:
	(
		IntOps.equals(union_number(variant_owner(left)), union_number(variant_owner(right)))
		and IntOps.equals(variant_number(left), variant_number(right))
	)


private pure func remaining_after(
	pattern: CheckedPattern,
	remaining: List[VariantId],
	span: Span,
) -> Result[List[VariantId], Diagnostic]:
	var next: List[VariantId] = []
	var useful = False

	match pattern:
		VariantCase(id, _):
			for known in remaining:
				if same_variant(id, known):
					useful = True
				else:
					next = next.append(known)
		WildcardCase:
			useful = not IntOps.equals(remaining.length(), 0)
		BindingCase(_):
			useful = not IntOps.equals(remaining.length(), 0)

	if useful:
		Ok(next)
	else:
		Err(
			rejection(
				span,
				"match arm is unreachable",
				"remove this arm; earlier arms already cover all values it could match",
			),
		)


private pure func missing_coverage(
	remaining: List[VariantId],
	span: Span,
	context: ResolutionContext,
) -> Diagnostic:
	var names: String = ""
	var failure: Option[Diagnostic] = None

	for id in remaining:
		match missing_variant_name(id, span, context):
			Err(error):
				failure = Some(error)
				break
			Ok(name):
				if not IntOps.equals(names.length(), 0):
					names = names.concat(", ")

				names = names.concat(name)

	match failure:
		Some(error):
			error
		None:
			prefix = if IntOps.equals(remaining.length(), 1):
				"add an arm for the missing variant: "
			else:
				"add arms for the missing variants: "

			rejection(
				span,
				"non-exhaustive match",
				Text.concat(prefix, names),
			)


private pure func missing_variant_name(
	id: VariantId,
	span: Span,
	context: ResolutionContext,
) -> Result[String, Diagnostic]:
	declaration ?= context.unions
		.get(union_number(variant_owner(id)))
		.to_result(internal_error(span, "invalid resolved union identity"))
	variant ?= declaration.variants
		.get(variant_number(id))
		.to_result(internal_error(span, "invalid resolved variant identity"))
	name ?= name_spelling(
		context.names,
		variant.name.id,
	).to_result(internal_error(span, "invalid parsed name identity"))

	match variant.payload:
		NoPayloadSyntax:
			Ok(name)
		OnePayloadSyntax(_):
			Ok(name.concat("(_)"))


private fixed record ResolvedMatch {
	body: CheckedMatch,
	bindings: List[BindingDefinition]
}


private pure func resolve_match(
	purity: Purity,
	return_type: TypeRef,
	scope: List[LocalBinding],
	body: ParsedMatch,
	bindings: List[BindingDefinition],
	context: ResolutionContext,
) -> Result[ResolvedMatch, Diagnostic]:
	scrutinee ?= resolve_value(purity, scope, body.scrutinee, None, context)

	owner_result: Result[UnionId, Diagnostic] = match scrutinee.value_type:
		AppliedUnionType(id, _):
			Ok(id)
		UnionType(id):
			Ok(id)
		IntType | StringType | ParameterType(_):
			Err(
				rejection(
					body.scrutinee.span,
					"match requires a union value",
					"match a typed union parameter or a call returning a declared union",
				),
			)

	owner ?= owner_result
	declaration ?= context.checked_unions
		.get(union_number(owner))
		.to_result(internal_error(body.keyword_span, "invalid checked union identity"))
	var remaining: List[VariantId] = []
	var position: Int = 0

	for shape in declaration.variants:
		id: VariantId = into_opaque VariantId({
				owner = owner,
				position = position
			})
		remaining = remaining.append(id)
		position = IntOps.add(position, 1)

	var arms: List[CheckedArm] = []
	var failure: Option[Diagnostic] = None
	var definitions = bindings

	for arm in body.arms:
		match resolve_arm(
			purity,
			return_type,
			scrutinee.value_type,
			definitions,
			scope,
			arm,
			remaining,
			context,
		):
			Err(error):
				failure = Some(error)
				break
			Ok(resolved):
				arms = arms.append(resolved.arm)
				remaining = resolved.remaining

				definitions = resolved.bindings

	match failure:
		Some(error):
			Err(error)
		None:
			if IntOps.equals(remaining.length(), 0):
				Ok({
					body = {
						scrutinee = scrutinee.value,
						union_type = scrutinee.value_type,
						arms = arms
					},
					bindings = definitions,
				})
			else:
				Err(missing_coverage(remaining, body.keyword_span, context))


private fixed record ResolvedArm {
	arm: CheckedArm,
	remaining: List[VariantId],
	bindings: List[BindingDefinition]
}


private pure func resolve_arm(
	purity: Purity,
	return_type: TypeRef,
	union_type: TypeRef,
	bindings: List[BindingDefinition],
	scope: List[LocalBinding],
	arm: ParsedMatchArm,
	remaining: List[VariantId],
	context: ResolutionContext,
) -> Result[ResolvedArm, Diagnostic]:
	pattern ?= resolve_pattern(arm.pattern, union_type, bindings.length(), scope, context)
	remaining ?= remaining_after(pattern.pattern, remaining, pattern_span(arm.pattern))

	definitions = match pattern.binding:
		Some(definition):
			bindings.append(definition)
		None:
			bindings

	prefix ?= resolve_bindings(arm.bindings, purity, pattern.scope, definitions, context)
	value ?= resolve_value(purity, prefix.scope, arm.body, Some(return_type), context)
	Ok({
		arm = {
			pattern = pattern.pattern,
			assignments = prefix.assignments,
			body = value.value
		},
		remaining = remaining,
		bindings = prefix.bindings,
	})


private pure func pattern_span(pattern: ParsedPattern) -> Span:
	match pattern:
		PatternName(name):
			name.span
		PatternWildcard(span):
			span
		PatternConstructor(_, _, span):
			span


private pure func function_scope(
	function: ParsedFunction,
	signature: FunctionSignature,
) -> Result[List[LocalBinding], Diagnostic]:
	match function.parameters:
		EmptyParameters:
			Ok([])
		SingleParameter(parameter):
			match signature.parameters:
				OneParameter(type_ref):
					Ok([
						{
							name = parameter.name.id,
							id = into_opaque BindingId(0),
							definition = {
								origin = ParameterBinding,
								mutability = Immutable,
								value_type = type_ref.value_type,
								span = parameter.name.span
							}
						},
					])
				NoParameter:
					Err(internal_error(parameter.name.span, "invalid resolved parameter"))


private fixed record ResolvedBody {
	bindings: List[BindingDefinition],
	assignments: List[CheckedAssignment],
	body: CheckedBody
}


private fixed record ResolvedAssignment {
	assignment: CheckedAssignment,
	scope: List[LocalBinding],
	definition: Option[BindingDefinition]
}


private pure func resolve_assignment(
	written: ParsedBinding,
	purity: Purity,
	scope: List[LocalBinding],
	ordinal: Int,
	block_start: Int,
	context: ResolutionContext,
) -> Result[ResolvedAssignment, Diagnostic]:
	previous = lookup_binding(scope, written.name.id)
	empty: Option[LocalBinding] = None

	decision: Result[Option[LocalBinding], Diagnostic] = match written.mutability:
		MutableBinding:
			match previous:
				Some(binding):
					match binding.definition.origin:
						BodyLocal:
							if IntOps.greater_than_or_equal(
								binding_number(binding.id),
								block_start,
							):
								Err(
									rejection(
										written.name.span,
										"duplicate local binding",
										Text.concat(
											"give each body-local declaration a distinct name; ",
											"omit var to reassign a mutable binding",
										),
									),
								)
							else:
								Ok(empty)
						_:
							Ok(empty)
				None:
					Ok(empty)
		ImmutableBinding:
			match previous:
				Some(binding):
					match binding.definition.mutability:
						Mutable:
							Ok(Some(binding))
						Immutable:
							Err(
								rejection(
									written.name.span,
									"cannot assign to an immutable binding",
									"declare the binding with var to allow reassignment",
								),
							)
				None:
					Ok(empty)

	reassign ?= decision
	value ?= resolve_value(
		purity,
		scope,
		written.initializer,
		reassign.map(pure func(binding: LocalBinding) -> TypeRef: binding.definition.value_type),
		context,
	)

	match reassign:
		Some(binding):
			Ok({
				assignment = ReassignBinding(binding.id, value.value),
				scope = scope,
				definition = None,
			})
		None:
			mutability = match written.mutability:
				MutableBinding:
					Mutable
				ImmutableBinding:
					Immutable

			definition: BindingDefinition = {
				origin = BodyLocal,
				mutability = mutability,
				value_type = value.value_type,
				span = written.name.span
			}
			id = into_opaque BindingId(ordinal)
			Ok({
				assignment = InitializeBinding(id, value.value),
				scope = [
					{
						name = written.name.id,
						id = id,
						definition = definition
					},
				].concat(scope),
				definition = Some(definition),
			})


private fixed record ResolvedBindings {
	bindings: List[BindingDefinition],
	scope: List[LocalBinding],
	assignments: List[CheckedAssignment]
}


private pure func resolve_bindings(
	written_bindings: List[ParsedBinding],
	purity: Purity,
	initial: List[LocalBinding],
	bindings: List[BindingDefinition],
	context: ResolutionContext,
) -> Result[ResolvedBindings, Diagnostic]:
	var scope = initial
	var definitions = bindings
	var assignments: List[CheckedAssignment] = []
	var failure: Option[Diagnostic] = None

	-- Function-owned ordinals distinguish this block's declarations from outer
	-- bindings and the arm capture. Only explicit var may shadow those bindings.
	for written in written_bindings:
		match resolve_assignment(
			written,
			purity,
			scope,
			definitions.length(),
			bindings.length(),
			context,
		):
			Err(error):
				failure = Some(error)
				break
			Ok(resolved):
				assignments = assignments.append(resolved.assignment)
				scope = resolved.scope

				match resolved.definition:
					Some(definition):
						definitions = definitions.append(definition)
					None:
						void

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({
				bindings = definitions,
				scope = scope,
				assignments = assignments,
			})


private pure func resolve_body(
	function: ParsedFunction,
	signature: FunctionSignature,
	context: ResolutionContext,
) -> Result[ResolvedBody, Diagnostic]:
	initial ?= function_scope(function, signature)
	prefix ?= resolve_bindings(
		function.bindings,
		signature.purity,
		initial,
		initial.map(pure func(binding: LocalBinding) -> BindingDefinition: binding.definition),
		context,
	)

	match function.body:
		ParsedValueBody(body):
			value ?= resolve_value(
				signature.purity,
				prefix.scope,
				body,
				Some(signature.return_type.value_type),
				context,
			)
			Ok({
				bindings = prefix.bindings,
				assignments = prefix.assignments,
				body = CheckedValueBody(value.value),
			})
		ParsedMatchBody(body):
			matched ?= resolve_match(
				signature.purity,
				signature.return_type.value_type,
				prefix.scope,
				body,
				prefix.bindings,
				context,
			)
			Ok({
				bindings = matched.bindings,
				assignments = prefix.assignments,
				body = CheckedMatchBody(matched.body),
			})


private pure func resolve_functions(
	context: ResolutionContext,
) -> Result[List[CheckedFunction], Diagnostic]:
	var functions: List[CheckedFunction] = []
	var failure: Option[Diagnostic] = None
	var index: Int = 0

	for function in context.functions:
		match resolve_function(function, index, context):
			Err(error):
				failure = Some(error)
				break
			Ok(checked):
				functions = functions.append(checked)

		index = IntOps.add(index, 1)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(functions)


private pure func resolve_function(
	function: ParsedFunction,
	index: Int,
	context: ResolutionContext,
) -> Result[CheckedFunction, Diagnostic]:
	signature ?= context.signatures
		.get(index)
		.to_result(
			internal_error(
				function.function_name.span,
				"invalid resolved function identity",
			),
		)
	body ?= resolve_body(function, signature, context)
	Ok({
		signature = signature,
		bindings = body.bindings,
		assignments = body.assignments,
		body = body.body,
	})


private pure func is_settled(id: FunctionId, settled: List[FunctionId]) -> Bool:
	var found: Bool = False

	for known in settled:
		if IntOps.equals(function_number(id), function_number(known)):
			found = True
			break

	found


private pure func target_is_settled(target: CallTarget, settled: List[FunctionId]) -> Bool:
	match target:
		UserFunction(id, _):
			is_settled(id, settled)
		RuntimeFunction(_):
			True


private pure func unsettled_value(body: CheckedValue, settled: List[FunctionId]) -> Option[Span]:
	var found: Option[Span] = match body.base:
		ReturnInteger(_):
			None
		ReturnVariant(_):
			None
		ReturnBinding(_):
			None
		ReturnCall(call):
			if target_is_settled(call.target, settled):
				None
			else:
				Some(call.span)

	for operation in body.operations:
		if found.is_some():
			break

		match operation.operation:
			InvokeFunction(call):
				if not target_is_settled(call.target, settled):
					found = Some(call.span)
			ConstructVariant(_):
				void

	found


private pure func unsettled_assignments(
	assignments: List[CheckedAssignment],
	settled: List[FunctionId],
) -> Option[Span]:
	var found: Option[Span] = None

	for assignment in assignments:
		value = match assignment:
			InitializeBinding(_, value):
				value
			ReassignBinding(_, value):
				value

		found = unsettled_value(value, settled)

		if found.is_some():
			break

	found


private pure func unsettled_edge(
	function: CheckedFunction,
	settled: List[FunctionId],
) -> Option[Span]:
	match unsettled_assignments(function.assignments, settled):
		Some(span):
			Some(span)
		None:
			unsettled_body(function.body, settled)


private pure func unsettled_body(body: CheckedBody, settled: List[FunctionId]) -> Option[Span]:
	match body:
		CheckedValueBody(value):
			unsettled_value(value, settled)
		CheckedMatchBody(matched):
			var found = unsettled_value(matched.scrutinee, settled)

			for arm in matched.arms:
				if found.is_some():
					break

				found = unsettled_assignments(arm.assignments, settled)

				if not found.is_some():
					found = unsettled_value(arm.body, settled)

			found


private pure func validate_acyclic(functions: List[CheckedFunction]) -> Result[Void, Diagnostic]:
	-- Settle only functions whose complete base/wrapper callee set is settled.
	-- Every successful step adds a distinct identity; leftovers contain or reach
	-- a cycle. Repeating an acyclic callee inside one body does not form a cycle.
	var settled: List[FunctionId] = []
	var changed: Bool = True

	while changed:
		changed = False
		var index: Int = 0

		for function in functions:
			id = into_opaque FunctionId(index)

			if not is_settled(id, settled) and not unsettled_edge(function, settled).is_some():
				settled = settled.append(id)
				changed = True

			index = IntOps.add(index, 1)

	var failure: Option[Diagnostic] = None

	for function in functions:
		match unsettled_edge(function, settled):
			Some(span):
				failure = Some(
					rejection(
						span,
						"call chain contains recursion",
						"use an acyclic call chain; recursion is not supported in this increment",
					),
				)
				break
			None:
				void

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)


private pure func validate_prelude_conflicts(
	functions: List[ParsedFunction],
	unions: List[ParsedUnion],
	prelude: CheckedPrelude,
) -> Result[Void, Diagnostic]:
	var failure: Option[Diagnostic] = None

	for function in functions:
		if runtime_operation(prelude, function.function_name.id).is_some():
			failure = Some(
				rejection(
					function.function_name.span,
					"function name conflicts with the prelude",
					"rename this function or change the explicit prelude declaration",
				),
			)
			break

	if not failure.is_some():
		for declaration in unions:
			for variant in declaration.variants:
				if runtime_operation(prelude, variant.name.id).is_some():
					failure = Some(
						rejection(
							variant.name.span,
							"variant name conflicts with a prelude function",
							"give functions and union variants distinct names",
						),
					)
					break

			if failure.is_some():
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)


pure func check(program: ParsedProgram) -> Result[CheckedProgram, Diagnostic]:
	parsed = parsed_contents(program)
	prelude = parsed.prelude
	special = prelude_names(prelude).special
	conflicts ?= validate_prelude_conflicts(parsed.functions, parsed.unions, prelude)
	unions ?= validate_unions(parsed.unions, parsed.functions, special)
	signatures ?= validate_signatures(parsed.functions, parsed.unions, parsed.end, special)
	functions ?= resolve_functions({
		functions = parsed.functions,
		signatures = signatures.functions,
		unions = parsed.unions,
		checked_unions = unions,
		names = parsed.names,
		prelude = prelude,
	})
	acyclic ?= validate_acyclic(functions)
	Ok(into_opaque CheckedProgram({
				unions = unions,
				functions = functions,
				entrypoint = signatures.entrypoint
			}))
