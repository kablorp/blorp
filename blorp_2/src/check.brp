import:
	./builtins as Prelude:
		BooleanRoles,
		BuiltinTypeError,
		OptionalRoles,
		PrimitiveType(BuiltinInt, BuiltinFloat, BuiltinString, BuiltinVoid),
		RuntimeOperation,
		RuntimeParameter(PrimitiveParameter, StringListParameter),
		RuntimeResult(PrimitiveResult, OptionalResult, BooleanResult),
		builtin_operation,
		check_builtin_types,
		primitive_operation,
		runtime_contract,
	declarations:
		FunctionId,
		RecordId,
		UnionId,
		VariantId,
		function_id,
		function_number,
		record_id,
		record_number,
		union_id,
		union_number,
		variant_id,
		variant_number,
		variant_owner,
	int as IntOps
	list: contains
	names: NameId, same_name
	namespace:
		FunctionOrigin(LocalFunction, ImportedFunction),
		ImportProblem,
		ImportedFunctionBinding,
		Namespace,
		TypeCandidate(PrimitiveCandidate, ListCandidate, UnionCandidate, RecordCandidate),
		build_namespace,
		function_candidates,
		import_problem_span,
		import_problems,
		imported_functions,
		imported_variants,
		local_function_candidates,
		method_selection_requests,
		same_type_candidate,
		type_candidates,
		variant_candidates,
	option: is_some, to_result
	parse: ParsedContents, ParsedProgram, parsed_contents
	result: and_then
	source: COMPILER_SOURCE, ModuleId, module_number, root_module_id, same_module
	syntax:
		BindingSyntax(ImmutableBinding, MutableBinding),
		CallNotation(DirectCall, ReceiverCall),
		Entrypoint(NoArguments, WithArguments),
		EntryResult(IntegerExitStatus, SuccessfulExit),
		ExpressionBase(
			VoidExpression, IntegerExpression, FloatExpression, StringExpression, NameExpression,
			DirectApplication, RecordExpression,
		),
		FieldPattern(FieldName, FieldWildcard),
		FunctionExecution(OrdinaryCalls, SelfTailLoop),
		ParsedBinding,
		ParsedBody(ParsedBuiltinBody, ParsedValueBody, ParsedMatchBody),
		ParsedFunction,
		ParsedMatch,
		ParsedMatchArm,
		ParsedParameter,
		ParsedPattern(PatternName, PatternWildcard, PatternConstructor),
		ParsedRecord,
		ParsedRecordField,
		ParsedRuntimeOperation(
			StringParseIntBuiltin, StringParseFloatBuiltin, ListGetBuiltin, StringEqualsBuiltin,
			IntegerEqualsBuiltin,
		),
		ParsedStatement(BindingStatement, ExpressionStatement),
		ParsedUnion,
		PostfixOperation(ReceiverInvocation, FieldAccess),
		Purity(Pure, Impure),
		ReceiverApplication,
		Span,
		TypeSyntax(AtomicType, AppliedType),
		ValueExpression,
		WrittenName,
		same_purity,
		same_span,
		type_span,


private fixed record FieldIdentity {
	owner: RecordId,
	position: Int
}


opaque type FieldId = FieldIdentity


fixed record CheckedRecord {
	fields: List[TypeUse]
}


fixed union TypeParameterOwner:
	FunctionDeclaration(FunctionId)
	UnionDeclaration(UnionId)


-- Owner and declaration position identify a rigid parameter within this compilation.
private fixed record TypeParameterIdentity {
	owner: TypeParameterOwner,
	position: Int
}


opaque type TypeParameterId = TypeParameterIdentity


fixed union TypeRef:
	VoidType
	IntType
	FloatType
	StringType
	ListType(TypeRef)
	RecordType(RecordId)
	UnionType(UnionId)
	AppliedUnionType(UnionId, List[TypeRef])
	ParameterType(TypeParameterId)


fixed record CheckedUnion {
	type_parameters: List[TypeParameterId],
	variants: List[Option[TypeUse]]
}


fixed record TypeUse {
	value_type: TypeRef,
	span: Span
}


fixed record FunctionSignature {
	type_parameters: List[TypeParameterId],
	purity: Purity,
	parameters: List[TypeUse],
	return_type: TypeUse
}


fixed union CallTarget:
	UserFunction(FunctionId, List[TypeRef])
	RuntimeFunction(RuntimeOperation[VariantId])


fixed record CheckedCall {
	target: CallTarget,
	span: Span
}


private pure func primitive_ref(value_type: PrimitiveType) -> TypeRef:
	match value_type:
		BuiltinVoid:
			VoidType
		BuiltinInt:
			IntType
		BuiltinFloat:
			FloatType
		BuiltinString:
			StringType


private pure func runtime_parameter_ref(parameter: RuntimeParameter) -> TypeRef:
	match parameter:
		PrimitiveParameter(primitive):
			primitive_ref(primitive)
		StringListParameter:
			ListType(StringType)


-- IDs are dense ordinals owned by one sealed checked function, never roles.
opaque type BindingId = Int


fixed union BindingOrigin:
	ParameterBinding(Int)
	BodyLocal
	MatchCapture


fixed union BindingMutability:
	Immutable
	Mutable


fixed record BindingDefinition {
	origin: BindingOrigin,
	mutability: BindingMutability,
	value_type: TypeRef,
	span: Span
}


pure func binding_number(id: BindingId) -> Int:
	from_opaque BindingId(id)


fixed record CheckedRecordField {
	field: FieldId,
	value: CheckedValue,
	span: Span
}


fixed union CheckedBase:
	ReturnRecord(RecordId, List[CheckedRecordField])
	ReturnVoid
	ReturnInteger(Int)
	ReturnFloat(Float)
	ReturnString(String)
	ReturnVariant(VariantId)
	ReturnBinding(BindingId)
	ReturnCall(CheckedCall, List[CheckedValue])


fixed union CheckedOperation:
	InvokeFunction(CheckedCall, List[CheckedValue])
	ConstructVariant(VariantId)
	ReadRecordField(FieldId)


fixed record CheckedStep {
	operation: CheckedOperation,
	value_type: TypeRef,
	span: Span
}


fixed record CheckedValue {
	base: CheckedBase,
	base_type: TypeRef,
	base_span: Span,
	operations: List[CheckedStep]
}


fixed union CheckedStatement:
	InitializeBinding(BindingId, CheckedValue)
	ReassignBinding(BindingId, CheckedValue)
	DiscardExpression(CheckedValue)


fixed union PayloadBinding:
	NoPayloadBinding
	DiscardPayload
	BindPayload(BindingId)


fixed union CheckedPattern:
	VariantCase(VariantId, PayloadBinding)
	WildcardCase
	BindingCase(BindingId)


fixed record CheckedArm {
	pattern: CheckedPattern,
	statements: List[CheckedStatement],
	body: CheckedExit
}


fixed record CheckedMatch {
	scrutinee: CheckedValue,
	union_type: TypeRef,
	arms: List[CheckedArm]
}


fixed union CheckedExit:
	ReturnExpression(CheckedValue)
	RecurWith(List[CheckedValue], Span)


fixed union CheckedBody:
	CheckedValueBody(CheckedExit)
	CheckedMatchBody(CheckedMatch)


fixed record CheckedFunction {
	execution: FunctionExecution,
	signature: FunctionSignature,
	bindings: List[BindingDefinition],
	statements: List[CheckedStatement],
	body: CheckedBody
}


fixed record CheckedFunctions {
	records: List[CheckedRecord],
	unions: List[CheckedUnion],
	functions: List[CheckedFunction],
	entrypoint: Entrypoint[FunctionId]
}


opaque type CheckedProgram = CheckedFunctions


pure func field_owner(id: FieldId) -> RecordId:
	from_opaque FieldId(id).owner


pure func field_number(id: FieldId) -> Int:
	from_opaque FieldId(id).position


pure func same_type(left: TypeRef, right: TypeRef) -> Bool:
	match left:
		ListType(left):
			match right:
				ListType(right):
					same_type(left, right)
				_:
					False
		RecordType(left):
			match right:
				RecordType(right):
					IntOps.equals(record_number(left), record_number(right))
				_:
					False
		AppliedUnionType(left_owner, left_argument):
			match right:
				AppliedUnionType(right_owner, right_argument):
					(
						IntOps.equals(union_number(left_owner), union_number(right_owner))
						and same_types(left_argument, right_argument)
					)
				_:
					False
		ParameterType(left):
			match right:
				ParameterType(right):
					same_parameter(left, right)
				_:
					False
		VoidType:
			match right:
				VoidType:
					True
				_:
					False
		IntType:
			match right:
				IntType:
					True
				_:
					False
		FloatType:
			match right:
				FloatType:
					True
				_:
					False
		StringType:
			match right:
				StringType:
					True
				_:
					False
		UnionType(left):
			match right:
				UnionType(right):
					IntOps.equals(union_number(left), union_number(right))
				_:
					False


private pure func same_types(left: List[TypeRef], right: List[TypeRef]) -> Bool:
	var matches = IntOps.equals(left.length(), right.length())
	var index: Int = 0

	for value in left:
		match right.get(index):
			Some(other):
				matches = matches and same_type(value, other)
			None:
				matches = False

		if not matches:
			break

		index = IntOps.add(index, 1)

	matches


pure func parameter_owner(id: TypeParameterId) -> TypeParameterOwner:
	from_opaque TypeParameterId(id).owner


pure func parameter_position(id: TypeParameterId) -> Int:
	from_opaque TypeParameterId(id).position


pure func same_parameter(left: TypeParameterId, right: TypeParameterId) -> Bool:
	owner_matches = match parameter_owner(left):
		FunctionDeclaration(left):
			match parameter_owner(right):
				FunctionDeclaration(right):
					IntOps.equals(function_number(left), function_number(right))
				_:
					False
		UnionDeclaration(left):
			match parameter_owner(right):
				UnionDeclaration(right):
					IntOps.equals(union_number(left), union_number(right))
				_:
					False

	owner_matches and IntOps.equals(parameter_position(left), parameter_position(right))


pure func checked_functions(program: CheckedProgram) -> CheckedFunctions:
	from_opaque CheckedProgram(program)


pure func declaration_id(program: CheckedProgram, position: Int) -> Option[FunctionId]:
	from_opaque CheckedProgram(program).functions
		.get(position)
		.map(pure func(_): function_id(position))


pure func record_declaration_id(program: CheckedProgram, position: Int) -> Option[RecordId]:
	from_opaque CheckedProgram(program).records
		.get(position)
		.map(pure func(_): record_id(position))


pure func union_declaration_id(program: CheckedProgram, position: Int) -> Option[UnionId]:
	from_opaque CheckedProgram(program).unions
		.get(position)
		.map(pure func(_): union_id(position))


private pure func find_function(
	namespace: Namespace,
	module: ModuleId,
	name: NameId,
) -> Option[FunctionId]:
	-- Declaration validation retains the first source occurrence for diagnostics.
	-- Accepted call lookup below requires a unique namespace candidate instead.
	local_function_candidates(namespace, module, name).get(0)


fixed record BindingSite {
	function: FunctionId,
	binding: BindingId,
	name: NameId,
	span: Span
}


fixed union ExpectedTypeSite:
	SourceAnnotation(Span)
	InferredBindingDeclaration(BindingSite)
	RuntimeContract(RuntimeOperation[VariantId])


fixed record ArgumentMismatch {
	expected: TypeRef,
	actual: TypeUse,
	argument_position: Int,
	expected_site: ExpectedTypeSite
}


fixed record ExpressionMismatch {
	expected: TypeRef,
	actual: TypeUse,
	expected_site: ExpectedTypeSite
}


fixed record GenericConflict {
	mismatch: ArgumentMismatch,
	parameter: TypeParameterId,
	previous: TypeUse,
	current: TypeUse
}


fixed record ArityMismatch {
	callee: NameId,
	expected: Int,
	actual: Int,
	notation: CallNotation,
	target: CallTarget
}


fixed union PayloadRule:
	IntegerPayload
	IntegerOrParameterPayload


fixed union PreviousTypeDeclaration:
	SourceTypeDeclaration(Span)


-- Source locations explain candidates; availability remains scope-owned.
fixed record MethodCandidateSite {
	function: FunctionId,
	declaration: Span,
	import_site: Option[Span]
}


fixed union CheckErrorKind:
	NonVoidStatement(TypeRef)
	BuiltinTypesRejected(BuiltinTypeError)
	AmbiguousMethod(NameId, TypeRef, List[MethodCandidateSite])
	NoApplicableMethod(NameId, TypeRef, List[MethodCandidateSite])
	MethodArgumentCounts(NameId, Int, List[Int], List[MethodCandidateSite])
	MethodReceiverNeedsType(NameId, List[MethodCandidateSite])
	BuiltinContractMismatch(RuntimeOperation[WrittenName])
	BuiltinResultUnion
	BuiltinRoleNotInResult(NameId, TypeRef)
	BuiltinRolePayload
	BuiltinBooleanPayload
	BuiltinRoleCoverage
	BuiltinTailAnnotation
	DuplicateRecordType(NameId, PreviousTypeDeclaration)
	DuplicateRecordField(NameId, Span)
	UnsupportedRecordField(TypeRef)
	RecordNeedsExpectedType
	UnknownRecordField(NameId, RecordId)
	DuplicateLiteralField(NameId, Span)
	MissingRecordField(FieldId, Span)
	RecordFieldTypeMismatch(FieldId, TypeUse, Span)
	FieldRequiresRecord(TypeRef)
	DuplicateVariant(NameId, Span)
	DuplicateUnion(NameId, PreviousTypeDeclaration)
	DuplicateFunction(NameId, Span)
	DuplicateParameter(NameId, Span)
	DuplicateTypeParameter(TypeParameterId, TypeParameterId, Span)
	DuplicateLocal(BindingSite)
	VariantFunctionConflict(NameId, Span, Span)
	ImportRejected(ImportProblem)
	ImportedFunctionConflict(NameId, Span)
	ImportedVariantConflict(NameId, Span)
	ImportedConstructorConflict(NameId, Span)
	GenericMain(TypeParameterId)
	MainHasParameters(Int)
	MainParameterType
	ListTypeArgumentCount
	UnsupportedListElement
	MainReturnType(TypeRef)
	PureVoidReturn
	MissingMain
	UnknownType(NameId)
	MissingUnionTypeArguments(UnionId, Int)
	UnionTypeArgumentCountMismatch(UnionId, Int, Int)
	OrdinaryUnionApplied(UnionId)
	NonApplicableType(NameId)
	TypeParameterTypeNameConflict(NameId)
	UnsupportedPayloadAnnotation(NameId, PayloadRule)
	UnknownValue(NameId)
	UnknownFunction(NameId)
	UncallableBinding(BindingSite, BindingOrigin, TypeRef)
	ArgumentCountMismatch(ArityMismatch)
	ImpureCall(FunctionId, CallTarget)
	ConstructorUFCS(NameId)
	ArgumentTypeMismatch(ArgumentMismatch)
	ExpressionTypeMismatch(ExpressionMismatch)
	GenericArgumentConflict(GenericConflict)
	UninferableTypeParameter(TypeParameterId)
	ConstructorNeedsExpectedType(NameId)
	VariantNotInExpectedType(NameId, TypeRef)
	PayloadFreeVariantCalled(VariantId)
	MissingConstructorPayload(VariantId, TypeRef)
	ConstructorPayloadArity(VariantId, Int)
	PatternUnexpectedField(VariantId)
	PatternMissingField(VariantId, TypeRef)
	UnknownConstructorPattern(NameId, TypeRef)
	UnreachableArm
	NonExhaustiveMatch(List[VariantId])
	MatchRequiresUnion(TypeRef)
	ImmutableAssignment(BindingSite)
	GrowingRecursiveInstantiation
	NonTailSelfCall(FunctionId)
	NoSelfRecursion
	GenericTailRecursionUnsupported
	InternalInvariant(CheckerInvariant)


fixed record CheckError {
	span: Span,
	kind: CheckErrorKind
}


fixed record CheckErrors {
	first: CheckError,
	remaining: List[CheckError]
}


private fixed record FailureContents {
	program: ParsedProgram,
	errors: CheckErrors
}


opaque type CheckFailure = FailureContents


private fixed record ExpectedValue {
	value_type: TypeRef,
	site: ExpectedTypeSite
}


private pure func find_union(
	namespace: Namespace,
	module: ModuleId,
	name: NameId,
) -> Option[UnionId]:
	var found: Option[UnionId] = None

	for candidate in type_candidates(namespace, module, name):
		match candidate:
			UnionCandidate(id):
				found = Some(id)
				break
			RecordCandidate(_) | PrimitiveCandidate(_) | ListCandidate:
				void

	found


private pure func contains_variant(namespace: Namespace, module: ModuleId, name: NameId) -> Bool:
	variant_candidates(namespace, module, name)
		.get(0)
		.is_some()


private pure func validate_union(
	declaration: ParsedUnion,
	functions: List[ParsedFunction],
	owner: UnionId,
	type_names: List[PreviousDeclaration],
	namespace: Namespace,
) -> Result[CheckedDeclaration, CheckError]:
	unique ?= validate_type_name(declaration.type_name, type_names, UnionKind, declaration.module)
	var previous: List[WrittenName] = []
	var failure: Option[CheckError] = None

	for written in declaration.variants:
		variant = written.name

		for known in previous:
			if same_name(known.id, variant.id):
				failure = Some(
					check_rejection(
						variant.span,
						DuplicateVariant(variant.id, known.span),
					),
				)
				break

		if failure.is_some():
			break

		match find_function(namespace, declaration.module, variant.id):
			None:
				void
			Some(id):
				match functions.get(function_number(id)):
					None:
						failure = Some(checker_invariant(variant.span, InvalidResolvedFunction(id)))
					Some(function):
						span = if IntOps.less_than(
							variant.span.start,
							function.function_name.span.start,
						):
							function.function_name.span
						else:
							variant.span

						failure = Some(
							check_rejection(
								span,
								VariantFunctionConflict(
									variant.id,
									variant.span,
									function.function_name.span,
								),
							),
						)

		if failure.is_some():
			break

		previous = previous.append(variant)

	valid ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	parameters ?= local_type_parameters(
		declaration.type_parameters,
		UnionDeclaration(owner),
		namespace,
		declaration.module,
	)
	shapes ?= resolve_payloads(declaration, parameters, namespace)
	Ok(
		UnionDeclarationResult(
			declaration.module,
			declaration.type_name,
			{
				type_parameters = declared_parameters(parameters),
				variants = shapes
			},
		),
	)


private fixed record CheckedDeclarations {
	unions: List[CheckedUnion],
	records: List[CheckedRecord]
}


private fixed union CheckedDeclaration:
	UnionDeclarationResult(ModuleId, WrittenName, CheckedUnion)
	RecordDeclarationResult(ModuleId, WrittenName, CheckedRecord)


private fixed union DeclarationKind:
	UnionKind
	RecordKind


private fixed record PreviousDeclaration {
	name: WrittenName,
	kind: DeclarationKind,
	module: ModuleId
}


private pure func validate_type_name(
	name: WrittenName,
	previous: List[PreviousDeclaration],
	kind: DeclarationKind,
	module: ModuleId,
) -> Result[Void, CheckError]:
	var earlier: Option[PreviousDeclaration] = None

	for declaration in previous:
		if same_module(module, declaration.module) and same_name(name.id, declaration.name.id):
			earlier = Some(declaration)
			break

	previous_type = earlier.map(
		pure func(declaration): SourceTypeDeclaration(declaration.name.span),
	)

	match previous_type:
		Some(first):
			record_conflict = match kind:
				RecordKind:
					True
				UnionKind:
					match earlier:
						Some(declaration):
							match declaration.kind:
								RecordKind:
									True
								UnionKind:
									False
						_:
							False

			if record_conflict:
				Err(check_rejection(name.span, DuplicateRecordType(name.id, first)))
			else:
				Err(check_rejection(name.span, DuplicateUnion(name.id, first)))
		None:
			Ok(void)


private pure func validate_declarations(
	unions: List[ParsedUnion],
	records: List[ParsedRecord],
	functions: List[ParsedFunction],
	namespace: Namespace,
) -> Result[CheckedDeclarations, CheckError]:
	var previous: List[PreviousDeclaration] = []
	var checked_unions: List[CheckedUnion] = []
	var checked_records: List[CheckedRecord] = []
	var union_position = 0
	var record_position = 0
	var failure: Option[CheckError] = None

	while (
		IntOps.less_than(union_position, unions.length())
		or IntOps.less_than(record_position, records.length())
	):
		union_next = unions.get(union_position)
		record_next = records.get(record_position)

		use_record = match record_next:
			Some(declaration):
				match union_next:
					Some(other):
						if same_module(declaration.module, other.module):
							IntOps.less_than(
								declaration.type_name.span.start,
								other.type_name.span.start,
							)
						else:
							IntOps.less_than(
								module_number(declaration.module),
								module_number(other.module),
							)
					None:
						True
			None:
				False

		result: Result[CheckedDeclaration, CheckError] = if use_record:
			match record_next:
				Some(declaration):
					check_record_declaration(declaration, previous, unions, namespace)
				None:
					Err(
						checker_invariant(
							{
								source = COMPILER_SOURCE,
								start = 0,
								end = 0
							},
							InvalidRecordDeclaration(record_id(record_position)),
						),
					)
		else:
			match union_next:
				Some(declaration):
					validate_union(
						declaration,
						functions,
						union_id(union_position),
						previous,
						namespace,
					)
				None:
					Err(
						checker_invariant(
							{
								source = COMPILER_SOURCE,
								start = 0,
								end = 0
							},
							InvalidUnionDeclaration(union_id(union_position)),
						),
					)

		match result:
			Err(error):
				failure = Some(error)
				break
			Ok(RecordDeclarationResult(module, name, declaration)):
				checked_records = checked_records.append(declaration)
				previous = previous.append({
					name = name,
					kind = RecordKind,
					module = module,
				})
				record_position = IntOps.add(record_position, 1)
			Ok(UnionDeclarationResult(module, name, declaration)):
				checked_unions = checked_unions.append(declaration)
				previous = previous.append({
					name = name,
					kind = UnionKind,
					module = module,
				})
				union_position = IntOps.add(union_position, 1)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({
				unions = checked_unions,
				records = checked_records,
			})


private pure func check_record_declaration(
	declaration: ParsedRecord,
	type_names: List[PreviousDeclaration],
	unions: List[ParsedUnion],
	namespace: Namespace,
) -> Result[CheckedDeclaration, CheckError]:
	unique ?= validate_type_name(declaration.type_name, type_names, RecordKind, declaration.module)
	var previous: List[WrittenName] = []
	var fields: List[TypeUse] = []
	var failure: Option[CheckError] = None

	for field in declaration.fields:
		result: Result[TypeUse, CheckError] = match previous_declaration(previous, field.name.id):
			Some(first):
				Err(
					check_rejection(
						field.name.span,
						DuplicateRecordField(field.name.id, first.span),
					),
				)
			None:
				resolve_type(
					unions,
					field.type_name,
					[],
					namespace,
					declaration.module,
				).and_then(pure func(value_type: TypeRef) -> Result[TypeUse, CheckError]:
					if same_type(value_type, IntType):
						Ok({
							value_type = value_type,
							span = type_span(field.type_name),
						})
					else:
						Err(
							check_rejection(
								type_span(field.type_name),
								UnsupportedRecordField(value_type),
							),
						)
				)

		match result:
			Err(error):
				failure = Some(error)
				break
			Ok(field_type):
				fields = fields.append(field_type)
				previous = previous.append(field.name)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(
				RecordDeclarationResult(
					declaration.module,
					declaration.type_name,
					{fields = fields},
				),
			)


private pure func resolve_payloads(
	declaration: ParsedUnion,
	type_parameters: List[LocalTypeParameter],
	namespace: Namespace,
) -> Result[List[Option[TypeUse]], CheckError]:
	var shapes: List[Option[TypeUse]] = []
	var failure: Option[CheckError] = None

	for variant in declaration.variants:
		match variant.payload:
			None:
				shapes = shapes.append(None)
			Some(name):
				parameter = lookup_type_parameter(
					type_parameters,
					name.id,
				).map(
					pure func(parameter: LocalTypeParameter): parameter.id,
				)

				value_result: Result[TypeRef, CheckError] = if visible_primitive(
					namespace,
					declaration.module,
					name.id,
					BuiltinInt,
				):
					Ok(IntType)
				else:
					match parameter:
						Some(id):
							Ok(ParameterType(id))
						None:
							Err(
								check_rejection(
									name.span,
									UnsupportedPayloadAnnotation(
										name.id,
										match type_parameters:
											[]:
												IntegerPayload
											_:
												IntegerOrParameterPayload
									),
								),
							)

				match value_result:
					Ok(value):
						shapes = shapes.append(Some({
							value_type = value,
							span = name.span,
						}))
					Err(error):
						failure = Some(error)
						break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(shapes)


private fixed record LocalTypeParameter {
	name: WrittenName,
	id: TypeParameterId
}


private pure func lookup_type_parameter(
	parameters: List[LocalTypeParameter],
	name: NameId,
) -> Option[LocalTypeParameter]:
	var found: Option[LocalTypeParameter] = None

	for parameter in parameters:
		if same_name(parameter.name.id, name):
			found = Some(parameter)
			break

	found


private pure func local_type_parameters(
	written: List[WrittenName],
	owner: TypeParameterOwner,
	namespace: Namespace,
	module: ModuleId,
) -> Result[List[LocalTypeParameter], CheckError]:
	var parameters: List[LocalTypeParameter] = []
	var failure: Option[CheckError] = None

	for name in written:
		id: TypeParameterId = into_opaque TypeParameterId({
				owner = owner,
				position = parameters.length()
			})

		match lookup_type_parameter(parameters, name.id):
			Some(previous):
				failure = Some(
					check_rejection(
						name.span,
						DuplicateTypeParameter(id, previous.id, previous.name.span),
					),
				)
			None:
				if not type_candidates(namespace, module, name.id).is_empty():
					failure = Some(
						check_rejection(
							name.span,
							TypeParameterTypeNameConflict(name.id),
						),
					)

		if failure.is_some():
			break

		parameters = parameters.append({
			name = name,
			id = id,
		})

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(parameters)


private fixed union FunctionRole:
	EntryFunction
	HelperFunction


private pure func resolve_type_parameters(
	function: ParsedFunction,
	id: FunctionId,
	namespace: Namespace,
	role: FunctionRole,
) -> Result[List[LocalTypeParameter], CheckError]:
	valid_main ?= match function.type_parameters.get(0):
		Some(name):
			match role:
				EntryFunction:
					Err(check_rejection(name.span, GenericMain(into_opaque TypeParameterId({
										owner = FunctionDeclaration(id),
										position = 0
									}))))
				HelperFunction:
					Ok(void)
		None:
			Ok(void)

	local_type_parameters(
		function.type_parameters,
		FunctionDeclaration(id),
		namespace,
		function.module,
	)


private pure func declared_parameters(
	parameters: List[LocalTypeParameter],
) -> List[TypeParameterId]:
	parameters.map(pure func(parameter: LocalTypeParameter): parameter.id)


private pure func visible_primitive(
	namespace: Namespace,
	module: ModuleId,
	name: NameId,
	primitive: PrimitiveType,
) -> Bool:
	match type_candidates(namespace, module, name):
		[PrimitiveCandidate(candidate)]:
			same_type(primitive_ref(candidate), primitive_ref(primitive))
		_:
			False


private pure func visible_list(namespace: Namespace, module: ModuleId, name: NameId) -> Bool:
	match type_candidates(namespace, module, name):
		[ListCandidate]:
			True
		_:
			False


private pure func resolve_atomic_type(
	unions: List[ParsedUnion],
	name: WrittenName,
	type_parameters: List[LocalTypeParameter],
	namespace: Namespace,
	module: ModuleId,
) -> Result[TypeRef, CheckError]:
	local = lookup_type_parameter(
		type_parameters,
		name.id,
	).map(
		pure func(parameter: LocalTypeParameter): parameter.id,
	)

	match local:
		Some(id):
			Ok(ParameterType(id))
		None:
			match type_candidates(namespace, module, name.id):
				[PrimitiveCandidate(primitive)]:
					Ok(primitive_ref(primitive))
				[ListCandidate]:
					Err(check_rejection(name.span, ListTypeArgumentCount))
				[RecordCandidate(id)]:
					Ok(RecordType(id))
				[UnionCandidate(id)]:
					declaration ?= unions
						.get(union_number(id))
						.to_result(checker_invariant(name.span, InvalidUnionDeclaration(id)))

					match declaration.type_parameters:
						[]:
							Ok(UnionType(id))
						_:
							Err(
								check_rejection(
									name.span,
									MissingUnionTypeArguments(
										id,
										declaration.type_parameters.length(),
									),
								),
							)
				_:
					Err(check_rejection(name.span, UnknownType(name.id)))


private pure func resolve_type(
	unions: List[ParsedUnion],
	written: TypeSyntax,
	type_parameters: List[LocalTypeParameter],
	namespace: Namespace,
	module: ModuleId,
) -> Result[TypeRef, CheckError]:
	match written:
		AtomicType(name):
			resolve_atomic_type(unions, name, type_parameters, namespace, module)
		AppliedType(name, arguments, span):
			if visible_list(namespace, module, name.id):
				match arguments:
					[element]:
						value ?= resolve_type(unions, element, type_parameters, namespace, module)

						match value:
							StringType | ParameterType(_):
								Ok(ListType(value))
							_:
								Err(check_rejection(type_span(element), UnsupportedListElement))
					_:
						Err(check_rejection(span, ListTypeArgumentCount))
			else:
				owner ?= match find_union(namespace, module, name.id):
					Some(owner):
						Ok(owner)
					None:
						Err(check_rejection(name.span, NonApplicableType(name.id)))

				declaration ?= match unions.get(union_number(owner)):
					Some(declaration):
						Ok(declaration)
					None:
						Err(checker_invariant(span, InvalidUnionDeclaration(owner)))

				arity ?= match declaration.type_parameters:
					[]:
						Err(check_rejection(span, OrdinaryUnionApplied(owner)))
					_:
						if IntOps.equals(declaration.type_parameters.length(), arguments.length()):
							Ok(void)
						else:
							Err(
								check_rejection(
									span,
									UnionTypeArgumentCountMismatch(
										owner,
										declaration.type_parameters.length(),
										arguments.length(),
									),
								),
							)

				var values: List[TypeRef] = []
				var failure: Option[CheckError] = None

				for argument in arguments:
					match resolve_type(unions, argument, type_parameters, namespace, module):
						Ok(value):
							values = values.append(value)
						Err(error):
							failure = Some(error)
							break

				match failure:
					Some(error):
						Err(error)
					None:
						Ok(AppliedUnionType(owner, values))


private fixed record AcceptedFunctionDeclaration {
	signature: FunctionSignature,
	runtime: Option[RuntimeOperation[VariantId]]
}


private fixed record CheckedSignatures {
	functions: List[AcceptedFunctionDeclaration],
	entrypoint: Entrypoint[FunctionId]
}


private pure func resolve_parameters(
	parameters: List[ParsedParameter],
	role: FunctionRole,
	unions: List[ParsedUnion],
	type_parameters: List[LocalTypeParameter],
	namespace: Namespace,
	module: ModuleId,
) -> Result[List[TypeUse], CheckError]:
	var resolved: List[TypeUse] = []
	var seen: List[WrittenName] = []
	var failure: Option[CheckError] = None

	if IntOps.greater_than(parameters.length(), 1):
		match role:
			EntryFunction:
				match parameters.get(1):
					Some(parameter):
						failure = Some(
							check_rejection(
								parameter.name.span,
								MainHasParameters(parameters.length()),
							),
						)
					None:
						void
			HelperFunction:
				void

	for parameter in parameters:
		if failure.is_some():
			break

		result = match previous_declaration(seen, parameter.name.id):
			Some(first):
				Err(
					check_rejection(
						parameter.name.span,
						DuplicateParameter(parameter.name.id, first.span),
					),
				)
			None:
				resolve_type(unions, parameter.type_name, type_parameters, namespace, module)

		match result:
			Err(error):
				failure = Some(error)
				break
			Ok(value_type):
				match role:
					EntryFunction:
						if not same_type(value_type, ListType(StringType)):
							failure = Some(
								check_rejection(
									type_span(parameter.type_name),
									MainParameterType,
								),
							)
							break
					HelperFunction:
						void

				resolved = resolved.append({
					value_type = value_type,
					span = type_span(parameter.type_name),
				})
				seen = seen.append(parameter.name)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(resolved)


private pure func validate_pure_result(purity: Purity, value_type: TypeRef, span: Span) -> Result[Void, CheckError]:
	if same_purity(purity, Pure) and same_type(value_type, VoidType):
		Err(check_rejection(span, PureVoidReturn))
	else:
		Ok(void)


private pure func resolve_signature(
	function: ParsedFunction,
	id: FunctionId,
	unions: List[ParsedUnion],
	namespace: Namespace,
	role: FunctionRole,
	checked_unions: List[CheckedUnion],
) -> Result[AcceptedFunctionDeclaration, CheckError]:
	local_parameters ?= resolve_type_parameters(function, id, namespace, role)
	return_type ?= match function.return_type:
		Some(written): resolve_type(unions, written, local_parameters, namespace, function.module)
		None: Ok(VoidType)
	return_span = match function.return_type:
		Some(written): type_span(written)
		None: function.function_name.span
	pure_result ?= validate_pure_result(function.purity, return_type, return_span)

	main_type ?= match role:
		EntryFunction:
			if same_type(return_type, IntType) or same_type(return_type, VoidType):
				Ok(void)
			else:
				Err(check_rejection(return_span, MainReturnType(return_type)))
		HelperFunction:
			Ok(void)

	parameters ?= resolve_parameters(
		function.parameters,
		role,
		unions,
		local_parameters,
		namespace,
		function.module,
	)

	type_parameters = declared_parameters(local_parameters)

	signature: FunctionSignature = {
		type_parameters = type_parameters,
		purity = function.purity,
		parameters = parameters,
		return_type = {
			value_type = return_type,
			span = return_span
		}
	}

	runtime ?= match function.body:
		ParsedBuiltinBody(operation, span):
			validate_builtin_body(
				function,
				signature,
				operation,
				span,
				checked_unions,
				namespace,
			).map(
				pure func(operation): Some(operation),
			)
		_:
			Ok(None)

	Ok({
		signature = signature,
		runtime = runtime,
	})


private pure func validate_signatures(
	functions: List[ParsedFunction],
	unions: List[ParsedUnion],
	end: Span,
	entrypoint_name: NameId,
	namespace: Namespace,
	checked_unions: List[CheckedUnion],
) -> Result[CheckedSignatures, CheckError]:
	var previous: List[PreviousFunction] = []
	var signatures: List[AcceptedFunctionDeclaration] = []
	var failure: Option[CheckError] = None
	entrypoint = find_function(namespace, root_module_id(), entrypoint_name)

	for function in functions:
		match previous_function(previous, function.module, function.function_name.id):
			Some(first):
				failure = Some(
					check_rejection(
						function.function_name.span,
						DuplicateFunction(function.function_name.id, first.name.span),
					),
				)
				break
			None:
				void

		id = function_id(previous.length())

		role = match entrypoint:
			Some(entry):
				if IntOps.equals(function_number(id), function_number(entry)):
					EntryFunction
				else:
					HelperFunction
			None:
				HelperFunction

		match resolve_signature(function, id, unions, namespace, role, checked_unions):
			Err(error):
				failure = Some(error)
				break
			Ok(signature):
				signatures = signatures.append(signature)

		previous = previous.append({
			module = function.module,
			name = function.function_name,
		})

	match failure:
		Some(error):
			Err(error)
		None:
			match entrypoint:
				Some(id):
					declaration ?= signatures
						.get(function_number(id))
						.to_result(checker_invariant(end, InvalidResolvedFunction(id)))

					result = if same_type(declaration.signature.return_type.value_type, VoidType):
						SuccessfulExit
					else:
						IntegerExitStatus
					accepted: Entrypoint[FunctionId] = match declaration.signature.parameters:
						[]:
							NoArguments(id, result)
						_:
							WithArguments(id, result)

					Ok({
						functions = signatures,
						entrypoint = accepted,
					})
				None:
					Err(check_rejection(end, MissingMain))


private fixed record PreviousFunction {
	module: ModuleId,
	name: WrittenName
}


private pure func previous_function(
	previous: List[PreviousFunction],
	module: ModuleId,
	name: NameId,
) -> Option[PreviousFunction]:
	var found: Option[PreviousFunction] = None

	for function in previous:
		if same_module(function.module, module) and same_name(function.name.id, name):
			found = Some(function)
			break

	found


private pure func validate_call(
	caller: Purity,
	callee: Purity,
	span: Span,
	function: FunctionId,
	target: CallTarget,
) -> Result[Void, CheckError]:
	match caller:
		Impure:
			Ok(void)
		Pure:
			match callee:
				Pure:
					Ok(void)
				Impure:
					Err(check_rejection(span, ImpureCall(function, target)))


private fixed record LocalBinding {
	name: NameId,
	id: BindingId,
	definition: BindingDefinition
}


private pure func lookup_binding(scope: List[LocalBinding], name: NameId) -> Option[LocalBinding]:
	var found: Option[LocalBinding] = None

	for binding in scope:
		if same_name(binding.name, name):
			found = Some(binding)
			break

	found


private fixed record ResolutionContext {
	function: FunctionId,
	module: ModuleId,
	namespace: Namespace,
	signatures: List[AcceptedFunctionDeclaration],
	unions: List[ParsedUnion],
	checked_unions: List[CheckedUnion],
	records: List[ParsedRecord],
	callables: List[CallableBinding],
	function_declarations: List[ParsedFunction]
}


private fixed record ResolvedCall {
	call: CheckedCall,
	signature: FunctionSignature
}


private fixed union CallOperation:
	FunctionCall(CheckedCall)
	VariantConstruction(VariantId)


private fixed record CallContract {
	purity: Purity,
	type_parameters: List[TypeParameterId],
	operation: CallOperation,
	parameter_types: List[TypeUse],
	return_type: TypeRef,
	span: Span
}


private fixed union ResolvedReceiver:
	UniqueReceiver(CallContract)
	ReceiverCandidates(List[CallableBinding])


private fixed union ResolvedPostfix:
	InvokeReceiver(ReceiverApplication, ResolvedReceiver)
	ReadField(WrittenName)


private fixed union ResolvedApplication:
	FunctionApplication(CallContract)
	ConstructorApplication(WrittenName)


private pure func resolve_function_target(
	name: WrittenName,
	id: FunctionId,
	signatures: List[AcceptedFunctionDeclaration],
) -> Result[ResolvedCall, CheckError]:
	accepted ?= signatures
		.get(function_number(id))
		.to_result(checker_invariant(name.span, InvalidResolvedFunction(id)))
	Ok({
		call = {
			target = UserFunction(id, []),
			span = name.span
		},
		signature = accepted.signature,
	})


private fixed union CallableVisibility:
	DirectAndUfcs
	UfcsOnly


private fixed record CallableBinding {
	module: ModuleId,
	name: NameId,
	function: FunctionId,
	visibility: CallableVisibility,
	origin: FunctionOrigin
}


private pure func callable_candidates(
	bindings: List[CallableBinding],
	module: ModuleId,
	name: NameId,
	notation: CallNotation,
) -> List[CallableBinding]:
	var candidates: List[CallableBinding] = []

	for binding in bindings:
		visible = match notation:
			ReceiverCall:
				True
			DirectCall:
				match binding.visibility:
					DirectAndUfcs:
						True
					UfcsOnly:
						False

		if (
			visible
			and same_module(binding.module, module)
			and same_name(binding.name, name)
		):
			candidates = candidates.append(binding)

	candidates


private pure func lookup_target(
	context: ResolutionContext,
	name: WrittenName,
) -> Result[Option[FunctionId], CheckError]:
	match callable_candidates(context.callables, context.module, name.id, DirectCall):
		[]:
			Ok(None)
		[candidate]:
			Ok(Some(candidate.function))
		[_, _, ..._]:
			Err(checker_invariant(name.span, AmbiguousResolvedFunction(name.id)))


private pure func receiver_head(value_type: TypeRef) -> Option[TypeCandidate]:
	match value_type:
		VoidType:
			Some(PrimitiveCandidate(BuiltinVoid))
		IntType:
			Some(PrimitiveCandidate(BuiltinInt))
		FloatType:
			Some(PrimitiveCandidate(BuiltinFloat))
		StringType:
			Some(PrimitiveCandidate(BuiltinString))
		ListType(_):
			Some(ListCandidate)
		RecordType(id):
			Some(RecordCandidate(id))
		UnionType(id):
			Some(UnionCandidate(id))
		AppliedUnionType(id, _):
			Some(UnionCandidate(id))
		ParameterType(_):
			None


private pure func append_callable(
	bindings: List[CallableBinding],
	incoming: CallableBinding,
) -> List[CallableBinding]:
	var result = bindings
	var position = 0
	var found = False

	for binding in bindings:
		if (
			same_module(binding.module, incoming.module)
			and IntOps.equals(function_number(binding.function), function_number(incoming.function))
		):
			-- Availability belongs to this scope. A named exposure promotes the
			-- existing identity without creating another overload candidate.
			match incoming.visibility:
				DirectAndUfcs:
					result = result.set(position, { incoming | visibility = DirectAndUfcs })
				UfcsOnly:
					void

			found = True
			break

		position = IntOps.add(position, 1)

	if found:
		result
	else:
		result.append(incoming)


private pure func build_callables(
	functions: List[ParsedFunction],
	namespace: Namespace,
	signatures: List[AcceptedFunctionDeclaration],
) -> Result[List[CallableBinding], CheckError]:
	-- Derived once after accepted signatures. Bindings retain only declaration
	-- identity, scope availability and provenance; signatures have one authority.
	var bindings: List[CallableBinding] = []
	var position = 0

	for function in functions:
		bindings = append_callable(
			bindings,
			{
				module = function.module,
				name = function.function_name.id,
				function = function_id(position),
				visibility = DirectAndUfcs,
				origin = LocalFunction
			},
		)
		position = IntOps.add(position, 1)

	for binding in imported_functions(namespace):
		bindings = append_callable(
			bindings,
			{
				module = binding.module,
				name = binding.name.id,
				function = binding.function,
				visibility = DirectAndUfcs,
				origin = ImportedFunction(binding.name.span)
			},
		)

	var failure: Option[CheckError] = None

	for request in method_selection_requests(namespace):
		position = 0

		for function in functions:
			if same_module(function.module, request.target):
				match signatures.get(position):
					None:
						failure = Some(
							checker_invariant(
								request.name.span,
								InvalidResolvedFunction(function_id(position)),
							),
						)
						break
					Some(accepted):
						match (
							accepted.signature.parameters
								.get(0)
								.and_then(pure func(parameter): receiver_head(parameter.value_type))
						):
							Some(head):
								if same_type_candidate(head, request.receiver):
									bindings = append_callable(
										bindings,
										{
											module = request.module,
											name = function.function_name.id,
											function = function_id(position),
											visibility = UfcsOnly,
											origin = ImportedFunction(request.name.span)
										},
									)
							None:
								void

			position = IntOps.add(position, 1)

		if failure.is_some():
			break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(bindings)


private pure func method_sites(
	candidates: List[CallableBinding],
	functions: List[ParsedFunction],
	span: Span,
) -> Result[List[MethodCandidateSite], CheckError]:
	var sites: List[MethodCandidateSite] = []
	var failure: Option[CheckError] = None

	for candidate in candidates:
		match functions.get(function_number(candidate.function)):
			None:
				failure = Some(checker_invariant(span, InvalidResolvedFunction(candidate.function)))
				break
			Some(declaration):
				import_site = match candidate.origin:
					LocalFunction:
						None
					ImportedFunction(site):
						Some(site)

				sites = sites.append({
					function = candidate.function,
					declaration = declaration.function_name.span,
					import_site = import_site,
				})

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(sites)


private pure func classify_receiver(
	purity: Purity,
	application: ReceiverApplication,
	context: ResolutionContext,
) -> Result[ResolvedReceiver, CheckError]:
	name = application.callee

	match callable_candidates(context.callables, context.module, name.id, ReceiverCall):
		[]:
			if contains_variant(context.namespace, context.module, name.id):
				Err(check_rejection(name.span, ConstructorUFCS(name.id)))
			else:
				Err(check_rejection(name.span, UnknownFunction(name.id)))
		[candidate]:
			resolved ?= resolve_function_target(name, candidate.function, context.signatures)
			contract ?= function_contract(
				purity,
				name,
				ReceiverCall,
				IntOps.add(application.arguments.length(), 1),
				resolved,
				context.function,
			)
			Ok(UniqueReceiver(contract))
		candidates:
			Ok(ReceiverCandidates(candidates))


private pure func receiver_expectation(
	receiver: ResolvedReceiver,
	signatures: List[AcceptedFunctionDeclaration],
	span: Span,
) -> Result[Option[TypeRef], CheckError]:
	match receiver:
		UniqueReceiver(contract):
			Ok(
				contract.parameter_types
					.get(0)
					.and_then(pure func(parameter):
						if not contract.type_parameters.is_empty() or contains_parameter(parameter.value_type):
							None
						else:
							Some(parameter.value_type)
					),
			)
		ReceiverCandidates(candidates):
			var expectation: Option[TypeRef] = None
			var common = True
			var failure: Option[CheckError] = None

			for candidate in candidates:
				match signatures.get(function_number(candidate.function)):
					None:
						failure = Some(
							checker_invariant(
								span,
								InvalidResolvedFunction(candidate.function),
							),
						)
						break
					Some(accepted):
						match accepted.signature.parameters.get(0):
							None:
								common = False
							Some(parameter):
								if not accepted.signature.type_parameters.is_empty() or contains_parameter(parameter.value_type):
									common = False
								else:
									match expectation:
										None:
											expectation = Some(parameter.value_type)
										Some(previous):
											common = (
												common
												and same_type(previous, parameter.value_type)
											)

			match failure:
				Some(error):
					Err(error)
				None:
					if common:
						Ok(expectation)
					else:
						Ok(None)


private pure func receiver_matches(
	signature: FunctionSignature,
	parameter: TypeUse,
	actual: TypeUse,
) -> Bool:
	if signature.type_parameters.is_empty():
		same_type(parameter.value_type, actual.value_type)
	else:
		inferred = signature.type_parameters.map(
			pure func(_: TypeParameterId) -> Option[TypeUse]: None,
		)

		match (
			infer_arguments(
				parameter.value_type,
				actual.value_type,
				signature.type_parameters,
				inferred,
				{
					expected = parameter.value_type,
					actual = actual,
					argument_position = 0,
					expected_site = SourceAnnotation(parameter.span)
				},
			)
		):
			Err(_):
				False
			Ok(inferred):
				var substitutions: List[ParameterArgument] = []

				for declared in signature.type_parameters:
					value = inferred
						.get(parameter_position(declared))
						.get_or(None)
					substitutions = substitutions.append({
						parameter = declared,
						value_type = value
							.map(pure func(value): value.value_type)
							.get_or(ParameterType(declared)),
					})

				match substitute_type(parameter.value_type, substitutions, actual.span):
					Err(_):
						False
					Ok(expected):
						same_type(expected, actual.value_type)


private pure func select_receiver_contract(
	purity: Purity,
	application: ReceiverApplication,
	receiver: ResolvedReceiver,
	actual: TypeUse,
	context: ResolutionContext,
) -> Result[CallContract, CheckError]:
	match receiver:
		UniqueReceiver(contract):
			Ok(contract)
		ReceiverCandidates(candidates):
			var compatible: List[CallableBinding] = []
			var matching_arity: List[CallableBinding] = []
			var counts: List[Int] = []
			var failure: Option[CheckError] = None
			arity = IntOps.add(application.arguments.length(), 1)

			for candidate in candidates:
				match context.signatures.get(function_number(candidate.function)):
					None:
						failure = Some(
							checker_invariant(
								application.callee.span,
								InvalidResolvedFunction(candidate.function),
							),
						)
						break
					Some(accepted):
						match accepted.signature.parameters.get(0):
							Some(parameter):
								if receiver_matches(accepted.signature, parameter, actual):
									compatible = compatible.append(candidate)
									count = accepted.signature.parameters.length()

									if IntOps.equals(count, arity):
										matching_arity = matching_arity.append(candidate)

									if not counts.contains(count):
										counts = counts.append(count)
							None:
								void

			ready ?= match failure:
				Some(error):
					Err(error)
				None:
					Ok(void)

			selection: Result[CallableBinding, CheckError] = match compatible:
				[]:
					sites ?= method_sites(
						candidates,
						context.function_declarations,
						application.callee.span,
					)
					Err(
						check_rejection(
							application.callee.span,
							NoApplicableMethod(application.callee.id, actual.value_type, sites),
						),
					)
				[candidate]:
					Ok(candidate)
				_:
					match matching_arity:
						[candidate]:
							Ok(candidate)
						[]:
							sites ?= method_sites(
								compatible,
								context.function_declarations,
								application.callee.span,
							)
							Err(
								check_rejection(
									application.callee.span,
									MethodArgumentCounts(
										application.callee.id,
										arity,
										counts,
										sites,
									),
								),
							)
						applicable:
							sites ?= method_sites(
								applicable,
								context.function_declarations,
								application.callee.span,
							)
							Err(
								check_rejection(
									application.callee.span,
									AmbiguousMethod(
										application.callee.id,
										actual.value_type,
										sites,
									),
								),
							)

			chosen ?= selection
			resolved ?= resolve_function_target(
				application.callee,
				chosen.function,
				context.signatures,
			)
			function_contract(
				purity,
				application.callee,
				ReceiverCall,
				arity,
				resolved,
				context.function,
			)


private pure func function_contract(
	purity: Purity,
	name: WrittenName,
	notation: CallNotation,
	arity: Int,
	resolved: ResolvedCall,
	function: FunctionId,
) -> Result[CallContract, CheckError]:
	count = resolved.signature.parameters.length()

	arity_check ?= if IntOps.equals(count, arity):
		Ok(void)
	else:
		Err(check_rejection(
			name.span,
			ArgumentCountMismatch({
				callee = name.id,
				expected = count,
				actual = arity,
				notation = notation,
				target = resolved.call.target,
			}),
		))

	pure_call ?= validate_call(
		purity,
		resolved.signature.purity,
		name.span,
		function,
		resolved.call.target,
	)
	Ok({
		purity = resolved.signature.purity,
		type_parameters = resolved.signature.type_parameters,
		operation = FunctionCall(resolved.call),
		parameter_types = resolved.signature.parameters,
		return_type = resolved.signature.return_type.value_type,
		span = name.span,
	})


private fixed record VariantContract {
	variant: VariantId,
	result_type: TypeRef,
	payload: Option[TypeUse]
}


private pure func type_union_owner(value: TypeRef) -> Option[UnionId]:
	match value:
		UnionType(id):
			Some(id)
		AppliedUnionType(id, _):
			Some(id)
		_:
			None


private pure func occurrence_payload(
	payload: Option[TypeUse],
	parameters: List[TypeParameterId],
	union_type: TypeRef,
) -> Result[Option[TypeUse], CheckError]:
	match payload:
		None:
			Ok(None)
		Some(written):
			owner ?= match type_union_owner(union_type):
				Some(owner):
					Ok(owner)
				None:
					Err(checker_invariant(written.span, VariantOccurrenceWithoutUnion(union_type)))

			values: List[TypeRef] = match union_type:
				AppliedUnionType(_, values):
					values
				_:
					[]

			if not IntOps.equals(parameters.length(), values.length()):
				Err(checker_invariant(written.span, GenericConstructorContract))
			else:
				var arguments: List[ParameterArgument] = []
				var failure: Option[CheckError] = None
				var position: Int = 0

				for parameter in parameters:
					owner_matches = match parameter_owner(parameter):
						UnionDeclaration(declaration):
							IntOps.equals(union_number(declaration), union_number(owner))
						_:
							False

					if (
						not owner_matches
						or not IntOps.equals(parameter_position(parameter), position)
					):
						failure = Some(
							checker_invariant(
								written.span,
								InvalidParameterDeclaration(parameter),
							),
						)
						break

					match values.get(position):
						Some(value):
							arguments = arguments.append({
								parameter = parameter,
								value_type = value,
							})
						None:
							failure = Some(
								checker_invariant(
									written.span,
									InvalidParameterDeclaration(parameter),
								),
							)
							break

					position = IntOps.add(position, 1)

				ready ?= match failure:
					Some(error):
						Err(error)
					None:
						Ok(void)

				value ?= substitute_type(written.value_type, arguments, written.span)
				Ok(Some({ written | value_type = value }))


private pure func find_variant(
	context: ResolutionContext,
	union_type: TypeRef,
	name: WrittenName,
) -> Result[Option[VariantContract], CheckError]:
	owner ?= match type_union_owner(union_type):
		Some(owner):
			Ok(owner)
		None:
			Err(checker_invariant(name.span, VariantOccurrenceWithoutUnion(union_type)))

	declaration ?= match context.unions.get(union_number(owner)):
		Some(declaration):
			Ok(declaration)
		None:
			Err(checker_invariant(name.span, InvalidResolvedUnion(owner)))

	checked ?= match context.checked_unions.get(union_number(owner)):
		Some(checked):
			Ok(checked)
		None:
			Err(checker_invariant(name.span, InvalidCheckedUnion(owner)))

	var found: Option[VariantContract] = None
	var position: Int = 0
	var failure: Option[CheckError] = None

	visible = variant_candidates(context.namespace, context.module, name.id)

	for variant in declaration.variants:
		id = variant_id(owner, position)
		var in_scope = False

		for candidate in visible:
			if same_variant(candidate, id):
				in_scope = True
				break

		if in_scope and same_name(variant.name.id, name.id):
			match checked.variants.get(position):
				None:
					failure = Some(
						checker_invariant(
							name.span,
							InvalidResolvedVariant(variant_id(owner, position)),
						),
					)
				Some(payload):
					match occurrence_payload(payload, checked.type_parameters, union_type):
						Err(error):
							failure = Some(error)
						Ok(resolved_payload):
							found = Some({
								variant = variant_id(owner, position),
								result_type = union_type,
								payload = resolved_payload,
							})

			break

		position = IntOps.add(position, 1)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(found)


private pure func contextual_constructor(
	name: WrittenName,
	expected_type: Option[TypeRef],
	context: ResolutionContext,
) -> Result[VariantContract, CheckError]:
	match expected_type:
		None:
			Err(check_rejection(name.span, ConstructorNeedsExpectedType(name.id)))
		Some(type_ref):
			found ?= match type_ref:
				VoidType | IntType | FloatType | StringType | ListType(_) | RecordType(_) | ParameterType(_):
					Ok(None)
				AppliedUnionType(owner, _):
					find_variant(context, type_ref, name)
				UnionType(owner):
					find_variant(context, type_ref, name)

			match found:
				Some(contract):
					Ok(contract)
				None:
					Err(check_rejection(name.span, VariantNotInExpectedType(name.id, type_ref)))


private pure func unary_constructor(
	name: WrittenName,
	expected_type: Option[TypeRef],
	context: ResolutionContext,
) -> Result[CallContract, CheckError]:
	contract ?= contextual_constructor(name, expected_type, context)

	match contract.payload:
		None:
			Err(check_rejection(name.span, PayloadFreeVariantCalled(contract.variant)))
		Some(payload):
			Ok({
				purity = Pure,
				type_parameters = [],
				operation = VariantConstruction(contract.variant),
				parameter_types = [payload],
				return_type = contract.result_type,
				span = name.span,
			})


private fixed record ResolvedBase {
	base: CheckedBase,
	value_type: TypeRef
}


private pure func constructor_base(
	name: WrittenName,
	expected_type: Option[TypeRef],
	called: Bool,
	context: ResolutionContext,
) -> Result[ResolvedBase, CheckError]:
	contract ?= contextual_constructor(name, expected_type, context)

	match contract.payload:
		Some(payload):
			Err(
				check_rejection(
					name.span,
					MissingConstructorPayload(contract.variant, payload.value_type),
				),
			)
		None:
			if called:
				Err(check_rejection(name.span, PayloadFreeVariantCalled(contract.variant)))
			else:
				Ok({
					base = ReturnVariant(contract.variant),
					value_type = contract.result_type,
				})


private pure func resolve_base(
	purity: Purity,
	scope: List[LocalBinding],
	base: ExpressionBase,
	span: Span,
	expected_type: Option[TypeRef],
	context: ResolutionContext,
) -> Result[ResolvedBase, CheckError]:
	match base:
		RecordExpression(fields):
			check_record_literal(purity, scope, fields, span, expected_type, context)
		VoidExpression:
			Ok({
				base = ReturnVoid,
				value_type = VoidType,
			})
		StringExpression(value):
			Ok({
				base = ReturnString(value),
				value_type = StringType,
			})
		IntegerExpression(value):
			Ok({
				base = ReturnInteger(value),
				value_type = IntType,
			})
		FloatExpression(value):
			Ok({
				base = ReturnFloat(value),
				value_type = FloatType,
			})
		NameExpression(name):
			match lookup_binding(scope, name.id):
				Some(binding):
					Ok({
						base = ReturnBinding(binding.id),
						value_type = binding.definition.value_type,
					})
				None:
					if contains_variant(context.namespace, context.module, name.id):
						constructor_base(name, expected_type, False, context)
					else:
						Err(check_rejection(name.span, UnknownValue(name.id)))
		DirectApplication(name, _):
			Err(checker_invariant(name.span, DirectCallInSimpleBase(name.id)))


private pure func resolve_record_field(
	name: WrittenName,
	owner: RecordId,
	context: ResolutionContext,
) -> Result[FieldId, CheckError]:
	declaration ?= context.records
		.get(record_number(owner))
		.to_result(checker_invariant(name.span, InvalidRecordDeclaration(owner)))
	var position = 0
	var found: Option[FieldId] = None

	for field in declaration.fields:
		if same_name(field.name.id, name.id):
			found = Some(into_opaque FieldId({
						owner = owner,
						position = position
					}))
			break

		position = IntOps.add(position, 1)

	found.to_result(check_rejection(name.span, UnknownRecordField(name.id, owner)))


private pure func resolve_field_read(
	name: WrittenName,
	current: ResolvedValue,
	context: ResolutionContext,
) -> Result[ResolvedValue, CheckError]:
	owner ?= match current.value_type:
		RecordType(owner):
			Ok(owner)
		_:
			Err(check_rejection(name.span, FieldRequiresRecord(current.value_type)))

	field ?= resolve_record_field(name, owner, context)
	Ok({
		value = { current.value | operations = current.value.operations.append({
				operation = ReadRecordField(field),
				value_type = IntType,
				span = name.span,
			}) },
		value_type = IntType,
	})


private fixed record ResolvedLiteralField {
	field: FieldId,
	written: ParsedRecordField
}


private pure func check_record_literal(
	purity: Purity,
	scope: List[LocalBinding],
	written: List[ParsedRecordField],
	span: Span,
	expectation: Option[TypeRef],
	context: ResolutionContext,
) -> Result[ResolvedBase, CheckError]:
	owner ?= match expectation:
		Some(RecordType(owner)):
			Ok(owner)
		_:
			Err(check_rejection(span, RecordNeedsExpectedType))

	declaration ?= context.records
		.get(record_number(owner))
		.to_result(checker_invariant(span, InvalidRecordDeclaration(owner)))
	var resolved: List[ResolvedLiteralField] = []
	var previous: List[WrittenName] = []
	var failure: Option[CheckError] = None

	for field in written:
		known_names = previous
		result = resolve_record_field(
			field.name,
			owner,
			context,
		).and_then(pure func(id: FieldId) -> Result[ResolvedLiteralField, CheckError]:
			match previous_declaration(known_names, field.name.id):
				Some(first):
					Err(
						check_rejection(
							field.name.span,
							DuplicateLiteralField(field.name.id, first.span),
						),
					)
				None:
					Ok({
						field = id,
						written = field,
					})
		)

		match result:
			Err(error):
				failure = Some(error)
				break
			Ok(field):
				resolved = resolved.append(field)
				previous = previous.append(field.written.name)

	names_ready ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	var position = 0

	for field in declaration.fields:
		if not previous_declaration(previous, field.name.id).is_some():
			failure = Some(
				check_rejection(
					span,
					MissingRecordField(
						into_opaque FieldId({
								owner = owner,
								position = position
							}),
						field.name.span,
					),
				),
			)
			break

		position = IntOps.add(position, 1)

	complete ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	var fields: List[CheckedRecordField] = []
	var obligation: Option[CheckError] = None

	for field in resolved:
		match synthesize_value(purity, scope, field.written.value, Some(IntType), context):
			Err(error):
				failure = Some(error)
				break
			Ok(value):
				fields = fields.append({
					field = field.field,
					value = value.value,
					span = field.written.value.span,
				})

				if not same_type(value.value_type, IntType) and not obligation.is_some():
					match declaration.fields.get(field_number(field.field)):
						Some(annotation):
							obligation = Some(
								check_rejection(
									field.written.value.span,
									RecordFieldTypeMismatch(
										field.field,
										{
											value_type = value.value_type,
											span = field.written.value.span
										},
										type_span(annotation.type_name),
									),
								),
							)
						None:
							failure = Some(
								checker_invariant(
									field.written.value.span,
									InvalidRecordField(field.field),
								),
							)

	children_ready ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	valid ?= match obligation:
		Some(error):
			Err(error)
		None:
			Ok(void)

	Ok({
		base = ReturnRecord(owner, fields),
		value_type = RecordType(owner),
	})


private fixed record ResolvedValue {
	value: CheckedValue,
	value_type: TypeRef
}


private fixed record ResolvedArguments {
	values: List[CheckedValue],
	contract: CallContract
}


private pure func check_arguments(
	purity: Purity,
	scope: List[LocalBinding],
	arguments: List[ValueExpression],
	receiver: Option[ResolvedValue],
	contract: CallContract,
	context: ResolutionContext,
) -> Result[ResolvedArguments, CheckError]:
	var types: List[TypeUse] = []
	var values: List[CheckedValue] = []

	match receiver:
		Some(value):
			types = [
				{
					value_type = value.value_type,
					span = contract.span
				},
			]
		None:
			void

	var failure: Option[CheckError] = None

	for argument in arguments:
		constructor_type = match contract.parameter_types.get(types.length()):
			Some(value_type):
				if contains_parameter(value_type.value_type):
					None
				else:
					Some(value_type.value_type)
			None:
				None

		match synthesize_value(purity, scope, argument, constructor_type, context):
			Err(error):
				failure = Some(error)
				break
			Ok(value):
				types = types.append({
					value_type = value.value_type,
					span = argument.span,
				})
				values = values.append(value.value)

	ready ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	-- Child errors precede argument mismatches; instantiate and validate after all children.
	instantiated ?= instantiate_contract(contract, types, context)
	var index: Int = 0

	for actual in types:
		match instantiated.parameter_types.get(index):
			None:
				failure = Some(checker_invariant(contract.span, MissingCallParameter(index)))
				break
			Some(expected):
				span = if IntOps.equals(types.length(), 1):
					contract.span
				else:
					actual.span

				if not same_type(actual.value_type, expected.value_type):
					failure = Some(check_rejection(
						span,
						ArgumentTypeMismatch({
							expected = expected.value_type,
							actual = actual,
							argument_position = index,
							expected_site = parameter_site(instantiated, expected),
						}),
					))
					break

		index = IntOps.add(index, 1)

	ready ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	Ok({
		values = values,
		contract = instantiated,
	})


private pure func synthesize_base(
	purity: Purity,
	scope: List[LocalBinding],
	body: ValueExpression,
	base_expectation: Option[TypeRef],
	context: ResolutionContext,
) -> Result[ResolvedValue, CheckError]:
	-- Keep child failures inside this result boundary so the caller can explain
	-- a missing receiver context without intercepting errors in nested values.
	match body.base:
		DirectApplication(name, arguments):
			classified ?= classify_direct_call(purity, name, arguments.length(), scope, context)

			match classified:
				ConstructorApplication(name):
					if IntOps.equals(arguments.length(), 0):
						constructor_base(
							name,
							base_expectation,
							True,
							context,
						).map(
							pure func(base: ResolvedBase) -> ResolvedValue: {
								value = {
									base = base.base,
									base_type = base.value_type,
									base_span = body.base_span,
									operations = []
								},
								value_type = base.value_type
							},
						)
					else:
						contract ?= unary_constructor(name, base_expectation, context)

						arity ?= if IntOps.equals(arguments.length(), 1):
							Ok(void)
						else:
							Err(
								check_rejection(
									name.span,
									match contract.operation:
										VariantConstruction(id):
											ConstructorPayloadArity(id, arguments.length())
										FunctionCall(_):
											InternalInvariant(InvalidFunctionContract)
								),
							)

						resolved ?= check_arguments(
							purity,
							scope,
							arguments,
							None,
							contract,
							context,
						)

						value ?= match resolved.values.get(0):
							Some(value):
								Ok(value)
							None:
								Err(
									checker_invariant(
										name.span,
										MissingConstructorArgument(name.id),
									),
								)

						operation ?= match contract.operation:
							VariantConstruction(id):
								Ok(ConstructVariant(id))
							FunctionCall(_):
								Err(checker_invariant(name.span, InvalidFunctionContract))

						Ok({
							value = { value | operations = value.operations.append({
									operation = operation,
									value_type = contract.return_type,
									span = name.span,
								}) },
							value_type = contract.return_type,
						})
				FunctionApplication(contract):
					resolved ?= check_arguments(purity, scope, arguments, None, contract, context)

					call ?= match resolved.contract.operation:
						FunctionCall(call):
							Ok(call)
						_:
							Err(checker_invariant(name.span, InvalidFunctionContract))

					Ok({
						value = {
							base = ReturnCall(call, resolved.values),
							base_type = resolved.contract.return_type,
							base_span = body.base_span,
							operations = []
						},
						value_type = resolved.contract.return_type,
					})
		_:
			base ?= resolve_base(
				purity,
				scope,
				body.base,
				body.base_span,
				base_expectation,
				context,
			)
			Ok({
				value = {
					base = base.base,
					base_type = base.value_type,
					base_span = body.base_span,
					operations = []
				},
				value_type = base.value_type,
			})



private pure func synthesize_value(
	purity: Purity,
	scope: List[LocalBinding],
	body: ValueExpression,
	constructor_type: Option[TypeRef],
	context: ResolutionContext,
) -> Result[ResolvedValue, CheckError]:
	-- Constructor context selects variants; callers validate expression/argument obligations.
	-- Resolve complete outer contracts once before checking their children.
	var contracts: List[ResolvedPostfix] = []
	var failure: Option[CheckError] = None

	for postfix in body.applications:
		match postfix:
			FieldAccess(name):
				contracts = contracts.append(ReadField(name))
			ReceiverInvocation(application):
				match classify_receiver(purity, application, context):
					Err(error):
						failure = Some(error)
						break
					Ok(receiver):
						contracts = contracts.append(InvokeReceiver(application, receiver))

	ready ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	base_expectation ?= match contracts.get(0):
		Some(InvokeReceiver(application, receiver)):
			receiver_expectation(receiver, context.signatures, application.callee.span)
		Some(ReadField(_)):
			Ok(None)
		None:
			Ok(constructor_type)

	base_result = synthesize_base(purity, scope, body, base_expectation, context)

	contextual_base: Result[ResolvedValue, CheckError] = match base_result:
		Ok(base):
			Ok(base)
		Err(error):
			needs_context = match error.kind:
				ConstructorNeedsExpectedType(_):
					match body.base:
						NameExpression(name): same_span(error.span, name.span)
						DirectApplication(name, _): same_span(error.span, name.span)
						_: False
				RecordNeedsExpectedType:
					match body.base:
						RecordExpression(_): same_span(error.span, body.base_span)
						_: False
				_:
					False
			if needs_context:
				match contracts.get(0):
					Some(InvokeReceiver(application, receiver)):
						match receiver:
							ReceiverCandidates(candidates):
								sites ?= method_sites(
									candidates,
									context.function_declarations,
									application.callee.span,
								)
								Err(check_rejection(application.callee.span, MethodReceiverNeedsType(application.callee.id, sites)))
							UniqueReceiver(_):
								Err(error)
					_:
						Err(error)
			else:
				Err(error)

	base ?= contextual_base
	var current = base

	for postfix in contracts:
		result = match postfix:
			InvokeReceiver(application, receiver):
				resolve_receiver(
					purity,
					scope,
					current,
					application,
					receiver,
					context,
					{
						source = body.base_span.source,
						start = body.base_span.start,
						end = application.span.end
					},
				)
			ReadField(name):
				resolve_field_read(name, current, context)

		match result:
			Err(error):
				failure = Some(error)
				break
			Ok(value):
				current = value

	ready ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	Ok(current)


private fixed record ParameterArgument {
	parameter: TypeParameterId,
	value_type: TypeRef
}


private pure func substitute_type(
	value_type: TypeRef,
	arguments: List[ParameterArgument],
	span: Span,
) -> Result[TypeRef, CheckError]:
	match value_type:
		ListType(element):
			value ?= substitute_type(element, arguments, span)

			match value:
				StringType | ParameterType(_):
					Ok(ListType(value))
				_:
					Err(check_rejection(span, UnsupportedListElement))
		AppliedUnionType(owner, values):
			var substituted: List[TypeRef] = []
			var failure: Option[CheckError] = None

			for value in values:
				match substitute_type(value, arguments, span):
					Ok(value):
						substituted = substituted.append(value)
					Err(error):
						failure = Some(error)
						break

			match failure:
				Some(error):
					Err(error)
				None:
					Ok(AppliedUnionType(owner, substituted))
		ParameterType(id):
			var replacement: Option[TypeRef] = None

			for argument in arguments:
				if same_parameter(id, argument.parameter):
					-- Simultaneous substitution: caller-owned replacements are terminal.
					replacement = Some(argument.value_type)
					break

			match replacement:
				Some(value):
					Ok(value)
				None:
					Err(checker_invariant(span, InvalidParameterDeclaration(id)))
		_:
			Ok(value_type)


private pure func infer_arguments(
	expected: TypeRef,
	actual: TypeRef,
	parameters: List[TypeParameterId],
	inferred: List[Option[TypeUse]],
	obligation: ArgumentMismatch,
) -> Result[List[Option[TypeUse]], CheckError]:
	match expected:
		ListType(element):
			match actual:
				ListType(actual):
					infer_arguments(element, actual, parameters, inferred, obligation)
				_:
					Ok(inferred)
		ParameterType(parameter):
			constrain_argument(parameters, inferred, parameter, actual, obligation)
		AppliedUnionType(owner, expected_arguments):
			match actual:
				AppliedUnionType(actual_owner, actual_arguments):
					var slots = inferred
					var position: Int = 0
					var failure: Option[CheckError] = None

					if (
						IntOps.equals(union_number(owner), union_number(actual_owner))
						and IntOps.equals(expected_arguments.length(), actual_arguments.length())
					):
						for argument in expected_arguments:
							match actual_arguments.get(position):
								Some(actual):
									match infer_arguments(
										argument,
										actual,
										parameters,
										slots,
										obligation,
									):
										Ok(next):
											slots = next
										Err(error):
											failure = Some(error)
											break
								None:
									void

							position = IntOps.add(position, 1)

					match failure:
						Some(error):
							Err(error)
						None:
							Ok(slots)
				_:
					Ok(inferred)
		_:
			Ok(inferred)


private pure func constrain_argument(
	parameters: List[TypeParameterId],
	inferred: List[Option[TypeUse]],
	requested: TypeParameterId,
	value_type: TypeRef,
	obligation: ArgumentMismatch,
) -> Result[List[Option[TypeUse]], CheckError]:
	position = parameter_position(requested)

	parameter ?= match parameters.get(position):
		Some(parameter):
			if same_parameter(parameter, requested):
				Ok(parameter)
			else:
				Err(
					checker_invariant(
						obligation.actual.span,
						InvalidParameterDeclaration(requested),
					),
				)
		None:
			Err(checker_invariant(obligation.actual.span, InvalidParameterDeclaration(requested)))

	current: TypeUse = {
		value_type = value_type,
		span = obligation.actual.span
	}

	match inferred.get(position):
		Some(None):
			Ok(inferred.set(position, Some(current)))
		Some(Some(first)):
			if same_type(first.value_type, current.value_type):
				Ok(inferred)
			else:
				-- Error-only expectation: uninferred accepted callee parameters stay rigid.
				var snapshot: List[ParameterArgument] = []
				var failure: Option[CheckError] = None

				for declared in parameters:
					match inferred.get(parameter_position(declared)):
						Some(candidate):
							snapshot = snapshot.append({
								parameter = declared,
								value_type = candidate
									.map(pure func(value: TypeUse): value.value_type)
									.get_or(ParameterType(declared)),
							})
						None:
							failure = Some(
								checker_invariant(
									current.span,
									InvalidParameterDeclaration(declared),
								),
							)
							break

				ready ?= match failure:
					Some(error):
						Err(error)
					None:
						Ok(void)

				expected ?= substitute_type(obligation.expected, snapshot, current.span)
				Err(check_rejection(
					current.span,
					GenericArgumentConflict({
						parameter = parameter,
						previous = first,
						current = current,
						mismatch = { obligation | expected = expected },
					}),
				))
		None:
			Err(checker_invariant(current.span, InvalidParameterDeclaration(parameter)))


private pure func instantiate_contract(
	contract: CallContract,
	actual: List[TypeUse],
	context: ResolutionContext,
) -> Result[CallContract, CheckError]:
	if IntOps.equals(contract.type_parameters.length(), 0):
		Ok(contract)
	else:
		var inferred: List[Option[TypeUse]] = contract.type_parameters.map(
			pure func(_: TypeParameterId) -> Option[TypeUse]: None,
		)
		var index: Int = 0
		var failure: Option[CheckError] = None

		-- Scan arguments, not parameters, so the earliest conflicting child wins.
		for value in actual:
			match contract.parameter_types.get(index):
				Some(written):
					match (
						infer_arguments(
							written.value_type,
							value.value_type,
							contract.type_parameters,
							inferred,
							{
								expected = written.value_type,
								actual = value,
								argument_position = index,
								expected_site = parameter_site(contract, written)
							},
						)
					):
						Ok(next):
							inferred = next
						Err(error):
							failure = Some(error)
				None:
					failure = Some(checker_invariant(contract.span, MissingGenericParameter(index)))

			if failure.is_some():
				break

			index = IntOps.add(index, 1)

		var arguments: List[ParameterArgument] = []
		var types: List[TypeRef] = []

		if failure.is_none():
			for parameter in contract.type_parameters:
				match inferred.get(parameter_position(parameter)):
					Some(Some(argument)):
						arguments = arguments.append({
							parameter = parameter,
							value_type = argument.value_type,
						})
						types = types.append(argument.value_type)
					Some(None):
						failure = Some(
							check_rejection(
								contract.span,
								UninferableTypeParameter(parameter),
							),
						)
						break
					None:
						failure = Some(
							checker_invariant(
								contract.span,
								InvalidParameterDeclaration(parameter),
							),
						)
						break

		complete ?= match failure:
			Some(error):
				Err(error)
			None:
				Ok(void)

		var parameters: List[TypeUse] = []

		for written in contract.parameter_types:
			match substitute_type(written.value_type, arguments, written.span):
				Ok(value):
					parameters = parameters.append({ written | value_type = value })
				Err(error):
					failure = Some(error)
					break

		valid ?= match failure:
			Some(error):
				Err(error)
			None:
				Ok(void)

		return_type ?= substitute_type(contract.return_type, arguments, contract.span)
		pure_result ?= validate_pure_result(contract.purity, return_type, contract.span)

		operation ?= match contract.operation:
			FunctionCall(call):
				match call.target:
					UserFunction(id, _):
						Ok(FunctionCall({ call | target = UserFunction(id, types) }))
					RuntimeFunction(_):
						Err(checker_invariant(contract.span, RuntimeGenericContract))
			VariantConstruction(_):
				Err(checker_invariant(contract.span, GenericConstructorContract))

		Ok({ contract |
				type_parameters = [],
				operation = operation,
				parameter_types = parameters,
				return_type = return_type
			})


private fixed record ResolvedPattern {
	pattern: CheckedPattern,
	scope: List[LocalBinding],
	binding: Option[BindingDefinition]
}


private pure func bound_pattern(
	name: WrittenName,
	type_ref: TypeRef,
	ordinal: Int,
	scope: List[LocalBinding],
	pattern: CheckedPattern,
) -> ResolvedPattern:
	{
		pattern = pattern,
		scope = [
			{
				name = name.id,
				id = into_opaque BindingId(ordinal),
				definition = {
					origin = MatchCapture,
					mutability = Immutable,
					value_type = type_ref,
					span = name.span
				}
			},
		].concat(scope),
		binding = Some({
			origin = MatchCapture,
			mutability = Immutable,
			value_type = type_ref,
			span = name.span,
		})
	}


private pure func resolve_variant_pattern(
	contract: VariantContract,
	fields: Option[FieldPattern],
	span: Span,
	ordinal: Int,
	scope: List[LocalBinding],
) -> Result[ResolvedPattern, CheckError]:
	match contract.payload:
		None:
			match fields:
				None:
					Ok({
						pattern = VariantCase(contract.variant, NoPayloadBinding),
						scope = scope,
						binding = None,
					})
				Some(_):
					Err(check_rejection(span, PatternUnexpectedField(contract.variant)))
		Some(payload):
			match fields:
				None:
					Err(
						check_rejection(
							span,
							PatternMissingField(contract.variant, payload.value_type),
						),
					)
				Some(field):
					match field:
						FieldWildcard(_):
							Ok({
								pattern = VariantCase(contract.variant, DiscardPayload),
								scope = scope,
								binding = None,
							})
						FieldName(name):
							Ok(
								bound_pattern(
									name,
									payload.value_type,
									ordinal,
									scope,
									VariantCase(
										contract.variant,
										BindPayload(into_opaque BindingId(ordinal)),
									),
								),
							)


private pure func resolve_pattern(
	pattern: ParsedPattern,
	union_type: TypeRef,
	ordinal: Int,
	scope: List[LocalBinding],
	context: ResolutionContext,
) -> Result[ResolvedPattern, CheckError]:
	match pattern:
		PatternWildcard(_):
			Ok({
				pattern = WildcardCase,
				scope = scope,
				binding = None,
			})
		PatternName(name):
			contract ?= if lookup_binding(scope, name.id).is_some():
				Ok(None)
			else:
				find_variant(context, union_type, name)

			match contract:
				Some(contract):
					resolve_variant_pattern(contract, None, name.span, ordinal, scope)
				None:
					Ok(
						bound_pattern(
							name,
							union_type,
							ordinal,
							scope,
							BindingCase(into_opaque BindingId(ordinal)),
						),
					)
		PatternConstructor(name, fields, span):
			contract ?= if lookup_binding(scope, name.id).is_some():
				Ok(None)
			else:
				find_variant(context, union_type, name)

			match contract:
				Some(contract):
					resolve_variant_pattern(contract, fields, span, ordinal, scope)
				None:
					Err(check_rejection(span, UnknownConstructorPattern(name.id, union_type)))


private pure func same_variant(left: VariantId, right: VariantId) -> Bool:
	(
		IntOps.equals(union_number(variant_owner(left)), union_number(variant_owner(right)))
		and IntOps.equals(variant_number(left), variant_number(right))
	)


private pure func remaining_after(
	pattern: CheckedPattern,
	remaining: List[VariantId],
	span: Span,
) -> Result[List[VariantId], CheckError]:
	var next: List[VariantId] = []
	var useful = False

	match pattern:
		VariantCase(id, _):
			for known in remaining:
				if same_variant(id, known):
					useful = True
				else:
					next = next.append(known)
		WildcardCase:
			useful = not IntOps.equals(remaining.length(), 0)
		BindingCase(_):
			useful = not IntOps.equals(remaining.length(), 0)

	if useful:
		Ok(next)
	else:
		Err(check_rejection(span, UnreachableArm))


private fixed record ResolvedMatch {
	body: CheckedMatch,
	bindings: List[BindingDefinition]
}


private pure func resolve_match(
	purity: Purity,
	return_type: TypeUse,
	scope: List[LocalBinding],
	body: ParsedMatch,
	bindings: List[BindingDefinition],
	context: ResolutionContext,
) -> Result[ResolvedMatch, CheckError]:
	scrutinee ?= synthesize_value(purity, scope, body.scrutinee, None, context)

	owner_result: Result[UnionId, CheckError] = match scrutinee.value_type:
		AppliedUnionType(id, _):
			Ok(id)
		UnionType(id):
			Ok(id)
		VoidType | IntType | FloatType | StringType | ListType(_) | RecordType(_) | ParameterType(_):
			Err(check_rejection(body.scrutinee.span, MatchRequiresUnion(scrutinee.value_type)))

	owner ?= owner_result

	declaration ?= match context.checked_unions.get(union_number(owner)):
		Some(declaration):
			Ok(declaration)
		None:
			Err(checker_invariant(body.keyword_span, InvalidCheckedUnion(owner)))

	var remaining: List[VariantId] = []
	var position: Int = 0

	for shape in declaration.variants:
		id = variant_id(owner, position)
		remaining = remaining.append(id)
		position = IntOps.add(position, 1)

	var arms: List[CheckedArm] = []
	var failure: Option[CheckError] = None
	var definitions = bindings

	for arm in body.arms:
		match resolve_arm(
			purity,
			return_type,
			scrutinee.value_type,
			definitions,
			scope,
			arm,
			remaining,
			context,
		):
			Err(error):
				failure = Some(error)
				break
			Ok(resolved):
				arms = arms.append(resolved.arm)
				remaining = resolved.remaining

				definitions = resolved.bindings

	match failure:
		Some(error):
			Err(error)
		None:
			if IntOps.equals(remaining.length(), 0):
				Ok({
					body = {
						scrutinee = scrutinee.value,
						union_type = scrutinee.value_type,
						arms = arms
					},
					bindings = definitions,
				})
			else:
				Err(check_rejection(body.keyword_span, NonExhaustiveMatch(remaining)))


private fixed record ResolvedArm {
	arm: CheckedArm,
	remaining: List[VariantId],
	bindings: List[BindingDefinition]
}


private pure func resolve_arm(
	purity: Purity,
	return_type: TypeUse,
	union_type: TypeRef,
	bindings: List[BindingDefinition],
	scope: List[LocalBinding],
	arm: ParsedMatchArm,
	remaining: List[VariantId],
	context: ResolutionContext,
) -> Result[ResolvedArm, CheckError]:
	pattern ?= resolve_pattern(arm.pattern, union_type, bindings.length(), scope, context)
	remaining ?= remaining_after(pattern.pattern, remaining, pattern_span(arm.pattern))

	definitions = match pattern.binding:
		Some(definition):
			bindings.append(definition)
		None:
			bindings

	prefix ?= resolve_statements(arm.statements, purity, pattern.scope, definitions, context)
	value ?= resolve_return_value(
		purity,
		prefix.scope,
		arm.body,
		return_type,
		context,
	)
	Ok({
		arm = {
			pattern = pattern.pattern,
			statements = prefix.statements,
			body = ReturnExpression(value.value)
		},
		remaining = remaining,
		bindings = prefix.bindings,
	})


private pure func pattern_span(pattern: ParsedPattern) -> Span:
	match pattern:
		PatternName(name):
			name.span
		PatternWildcard(span):
			span
		PatternConstructor(_, _, span):
			span


private pure func function_scope(
	function: ParsedFunction,
	signature: FunctionSignature,
) -> Result[List[LocalBinding], CheckError]:
	var scope: List[LocalBinding] = []
	var index: Int = 0
	var failure: Option[CheckError] = None

	for parameter in function.parameters:
		match signature.parameters.get(index):
			None:
				failure = Some(
					checker_invariant(
						parameter.name.span,
						InvalidResolvedParameter(index),
					),
				)
				break
			Some(value_type):
				scope = scope.append({
					name = parameter.name.id,
					id = into_opaque BindingId(index),
					definition = {
						origin = ParameterBinding(index),
						mutability = Immutable,
						value_type = value_type.value_type,
						span = parameter.name.span
					},
				})

		index = IntOps.add(index, 1)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(scope)


private fixed record ResolvedBody {
	bindings: List[BindingDefinition],
	statements: List[CheckedStatement],
	body: CheckedBody
}


private fixed record ResolvedStatement {
	statement: CheckedStatement,
	scope: List[LocalBinding],
	definition: Option[BindingDefinition]
}


private pure func resolve_assignment(
	written: ParsedBinding,
	purity: Purity,
	scope: List[LocalBinding],
	ordinal: Int,
	block_start: Int,
	context: ResolutionContext,
) -> Result[ResolvedStatement, CheckError]:
	previous = lookup_binding(scope, written.name.id)
	empty: Option[LocalBinding] = None

	decision: Result[Option[LocalBinding], CheckError] = match written.mutability:
		MutableBinding:
			match previous:
				Some(binding):
					match binding.definition.origin:
						BodyLocal:
							if IntOps.greater_than_or_equal(
								binding_number(binding.id),
								block_start,
							):
								Err(
									check_rejection(
										written.name.span,
										DuplicateLocal(binding_site(context.function, binding)),
									),
								)
							else:
								Ok(empty)
						_:
							Ok(empty)
				None:
					Ok(empty)
		ImmutableBinding:
			match previous:
				Some(binding):
					match binding.definition.mutability:
						Mutable:
							Ok(Some(binding))
						Immutable:
							Err(
								check_rejection(
									written.name.span,
									ImmutableAssignment(binding_site(context.function, binding)),
								),
							)
				None:
					Ok(empty)

	reassign ?= decision

	value ?= match reassign:
		Some(binding):
			check_value(
				purity,
				scope,
				written.initializer,
				{
					value_type = binding.definition.value_type,
					site = InferredBindingDeclaration(binding_site(context.function, binding))
				},
				context,
			)
		None:
			synthesize_value(purity, scope, written.initializer, None, context)

	match reassign:
		Some(binding):
			Ok({
				statement = ReassignBinding(binding.id, value.value),
				scope = scope,
				definition = None,
			})
		None:
			mutability = match written.mutability:
				MutableBinding:
					Mutable
				ImmutableBinding:
					Immutable

			definition: BindingDefinition = {
				origin = BodyLocal,
				mutability = mutability,
				value_type = value.value_type,
				span = written.name.span
			}
			id = into_opaque BindingId(ordinal)
			Ok({
				statement = InitializeBinding(id, value.value),
				scope = [
					{
						name = written.name.id,
						id = id,
						definition = definition
					},
				].concat(scope),
				definition = Some(definition),
			})


private fixed record ResolvedStatements {
	bindings: List[BindingDefinition],
	scope: List[LocalBinding],
	statements: List[CheckedStatement]
}


private pure func resolve_discard(
	written: ValueExpression,
	purity: Purity,
	scope: List[LocalBinding],
	context: ResolutionContext,
) -> Result[ResolvedStatement, CheckError]:
	value ?= synthesize_value(purity, scope, written, None, context)

	if same_type(value.value_type, VoidType):
		Ok({
			statement = DiscardExpression(value.value),
			scope = scope,
			definition = None,
		})
	else:
		Err(check_rejection(written.span, NonVoidStatement(value.value_type)))


private pure func resolve_statements(
	written_statements: List[ParsedStatement],
	purity: Purity,
	initial: List[LocalBinding],
	bindings: List[BindingDefinition],
	context: ResolutionContext,
) -> Result[ResolvedStatements, CheckError]:
	var scope = initial
	var definitions = bindings
	var statements: List[CheckedStatement] = []
	var failure: Option[CheckError] = None

	-- Function-owned ordinals distinguish this block's declarations from outer
	-- bindings and the arm capture. Only explicit var may shadow those bindings.
	for statement in written_statements:
		resolved_statement = match statement:
			BindingStatement(written):
				resolve_assignment(
					written,
					purity,
					scope,
					definitions.length(),
					bindings.length(),
					context,
				)
			ExpressionStatement(written):
				resolve_discard(written, purity, scope, context)

		match resolved_statement:
			Err(error):
				failure = Some(error)
				break
			Ok(resolved):
				statements = statements.append(resolved.statement)
				scope = resolved.scope

				match resolved.definition:
					Some(definition):
						definitions = definitions.append(definition)
					None:
						void

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({
				bindings = definitions,
				scope = scope,
				statements = statements,
			})


private pure func builtin_role(
	written: WrittenName,
	result_type: TypeRef,
	module: ModuleId,
	namespace: Namespace,
) -> Result[VariantId, CheckError]:
	owner ?= type_union_owner(
		result_type,
	).to_result(check_rejection(written.span, BuiltinResultUnion))
	var found: Option[VariantId] = None

	for candidate in variant_candidates(namespace, module, written.id):
		if IntOps.equals(union_number(variant_owner(candidate)), union_number(owner)):
			found = Some(candidate)
			break

	found.to_result(check_rejection(written.span, BuiltinRoleNotInResult(written.id, result_type)))


private pure func validate_builtin_body(
	function: ParsedFunction,
	signature: FunctionSignature,
	parsed: ParsedRuntimeOperation,
	span: Span,
	unions: List[CheckedUnion],
	namespace: Namespace,
) -> Result[RuntimeOperation[VariantId], CheckError]:
	annotation ?= match function.tail_annotation:
		Some(annotation):
			Err(check_rejection(annotation, BuiltinTailAnnotation))
		None:
			Ok(void)

	written = builtin_operation(parsed)
	contract = runtime_contract(written)

	valid_header ?= if (
		signature.type_parameters.is_empty()
		and same_purity(signature.purity, contract.purity)
		and same_types(
			signature.parameters.map(
				pure func(parameter: TypeUse) -> TypeRef: parameter.value_type,
			),
			contract.parameters.map(
				pure func(
					parameter: RuntimeParameter,
				) -> TypeRef: runtime_parameter_ref(parameter),
			),
		)
	):
		Ok(void)
	else:
		Err(check_rejection(span, BuiltinContractMismatch(written)))

	match contract.return_type:
		PrimitiveResult(expected):
			valid_result ?= if same_type(signature.return_type.value_type, primitive_ref(expected)):
				Ok(void)
			else:
				Err(check_rejection(span, BuiltinContractMismatch(written)))

			primitive_operation(parsed).to_result(checker_invariant(span, RuntimeGenericContract))
		OptionalResult(payload, written_roles):
			result_type = signature.return_type.value_type
			owner ?= type_union_owner(
				result_type,
			).to_result(check_rejection(signature.return_type.span, BuiltinResultUnion))
			declaration ?= unions
				.get(union_number(owner))
				.to_result(checker_invariant(span, InvalidCheckedUnion(owner)))
			present = written_roles.present
			absent = written_roles.absent
			present_id ?= builtin_role(present, result_type, function.module, namespace)
			absent_id ?= builtin_role(absent, result_type, function.module, namespace)

			coverage ?= if (
				declaration.variants.length() == 2
				and not same_variant(present_id, absent_id)
			):
				Ok(void)
			else:
				Err(check_rejection(span, BuiltinRoleCoverage))

			present_payload ?= declaration.variants
				.get(variant_number(present_id))
				.to_result(checker_invariant(present.span, InvalidResolvedVariant(present_id)))
			absent_payload ?= declaration.variants
				.get(variant_number(absent_id))
				.to_result(checker_invariant(absent.span, InvalidResolvedVariant(absent_id)))
			actual ?= occurrence_payload(present_payload, declaration.type_parameters, result_type)

			payload_valid ?= match actual:
				Some(actual):
					if same_type(actual.value_type, primitive_ref(payload)):
						Ok(void)
					else:
						Err(check_rejection(present.span, BuiltinRolePayload))
				None:
					Err(check_rejection(present.span, BuiltinRolePayload))

			empty ?= match absent_payload:
				None:
					Ok(void)
				Some(_):
					Err(check_rejection(absent.span, BuiltinRolePayload))

			roles: OptionalRoles[VariantId] = {
				present = present_id,
				absent = absent_id
			}

			match parsed:
				StringParseIntBuiltin(_, _):
					Ok(Prelude.StringParseInt(roles))
				StringParseFloatBuiltin(_, _):
					Ok(Prelude.StringParseFloat(roles))
				ListGetBuiltin(_, _):
					Ok(Prelude.ListGet(roles))
				_:
					Err(checker_invariant(span, RuntimeGenericContract))
		BooleanResult(written_roles):
			result_type = signature.return_type.value_type
			owner ?= type_union_owner(
				result_type,
			).to_result(check_rejection(signature.return_type.span, BuiltinResultUnion))
			declaration ?= unions
				.get(union_number(owner))
				.to_result(checker_invariant(span, InvalidCheckedUnion(owner)))
			equal_id ?= builtin_role(written_roles.equal, result_type, function.module, namespace)
			different_id ?= builtin_role(
				written_roles.different,
				result_type,
				function.module,
				namespace,
			)

			coverage ?= if (
				declaration.variants.length() == 2
				and not same_variant(equal_id, different_id)
			):
				Ok(void)
			else:
				Err(check_rejection(span, BuiltinRoleCoverage))

			equal_empty ?= validate_boolean_role(equal_id, written_roles.equal.span, declaration)
			different_empty ?= validate_boolean_role(
				different_id,
				written_roles.different.span,
				declaration,
			)
			roles: BooleanRoles[VariantId] = {
				equal = equal_id,
				different = different_id
			}

			match parsed:
				StringEqualsBuiltin(_, _):
					Ok(Prelude.StringEquals(roles))
				IntegerEqualsBuiltin(_, _):
					Ok(Prelude.IntEquals(roles))
				_:
					Err(checker_invariant(span, RuntimeGenericContract))


private pure func validate_boolean_role(
	id: VariantId,
	span: Span,
	declaration: CheckedUnion,
) -> Result[Void, CheckError]:
	payload ?= declaration.variants
		.get(variant_number(id))
		.to_result(checker_invariant(span, InvalidResolvedVariant(id)))

	match payload:
		None:
			Ok(void)
		Some(_):
			Err(check_rejection(span, BuiltinBooleanPayload))


-- Void tails have no expected value type: each expression is still fully checked,
-- then its value is discarded after tail-recursion analysis, before publication.
private pure func resolve_return_value(
	purity: Purity,
	scope: List[LocalBinding],
	written: ValueExpression,
	return_type: TypeUse,
	context: ResolutionContext,
) -> Result[ResolvedValue, CheckError]:
	if same_type(return_type.value_type, VoidType):
		synthesize_value(purity, scope, written, None, context)
	else:
		check_value(purity, scope, written, {
			value_type = return_type.value_type,
			site = SourceAnnotation(return_type.span)
		}, context)


private pure func resolve_body(
	function: ParsedFunction,
	signature: FunctionSignature,
	context: ResolutionContext,
	runtime: Option[RuntimeOperation[VariantId]],
) -> Result[ResolvedBody, CheckError]:
	initial ?= function_scope(function, signature)
	prefix ?= resolve_statements(
		function.statements,
		signature.purity,
		initial,
		initial.map(pure func(binding: LocalBinding) -> BindingDefinition: binding.definition),
		context,
	)

	match function.body:
		ParsedBuiltinBody(_, span):
			operation ?= runtime.to_result(checker_invariant(span, RuntimeGenericContract))
			-- Read the scope's actual binding identities, as ordinary parameter uses do.
			arguments = initial.map(pure func(binding: LocalBinding) -> CheckedValue:
				{
					base = ReturnBinding(binding.id),
					base_type = binding.definition.value_type,
					base_span = binding.definition.span,
					operations = []
				}
			)
			Ok({
				bindings = prefix.bindings,
				statements = prefix.statements,
				body = CheckedValueBody(ReturnExpression({
					base = ReturnCall(
						{
							target = RuntimeFunction(operation),
							span = span
						},
						arguments,
					),
					base_type = signature.return_type.value_type,
					base_span = span,
					operations = [],
				})),
			})
		ParsedValueBody(body):
			value ?= resolve_return_value(
				signature.purity,
				prefix.scope,
				body,
				signature.return_type,
				context,
			)
			Ok({
				bindings = prefix.bindings,
				statements = prefix.statements,
				body = CheckedValueBody(ReturnExpression(value.value)),
			})
		ParsedMatchBody(body):
			matched ?= resolve_match(
				signature.purity,
				signature.return_type,
				prefix.scope,
				body,
				prefix.bindings,
				context,
			)
			Ok({
				bindings = matched.bindings,
				statements = prefix.statements,
				body = CheckedMatchBody(matched.body),
			})


private pure func resolve_functions(
	parsed: ParsedContents,
	signatures: List[AcceptedFunctionDeclaration],
	declarations: CheckedDeclarations,
	namespace: Namespace,
	callables: List[CallableBinding],
) -> Result[List[CheckedFunction], CheckError]:
	var functions: List[CheckedFunction] = []
	var failure: Option[CheckError] = None
	var index: Int = 0

	for function in parsed.functions:
		context: ResolutionContext = {
			function = function_id(index),
			module = function.module,
			namespace = namespace,
			signatures = signatures,
			unions = parsed.unions,
			checked_unions = declarations.unions,
			records = parsed.records,
			callables = callables,
			function_declarations = parsed.functions
		}

		match resolve_function(function, index, context):
			Err(error):
				failure = Some(error)
				break
			Ok(checked):
				functions = functions.append(checked)

		index = IntOps.add(index, 1)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(functions)


private pure func resolve_function(
	function: ParsedFunction,
	index: Int,
	context: ResolutionContext,
) -> Result[CheckedFunction, CheckError]:
	declaration ?= match context.signatures.get(index):
		Some(signature):
			Ok(signature)
		None:
			Err(
				checker_invariant(
					function.function_name.span,
					InvalidResolvedFunction(context.function),
				),
			)

	signature = declaration.signature
	body ?= resolve_body(function, signature, context, declaration.runtime)
	checked ?= check_execution(function, body, context.function)
	normalized = if same_type(signature.return_type.value_type, VoidType):
		normalize_void_body(body.statements, checked.body)
	else:
		{ statements = body.statements, body = checked.body }
	Ok({
		execution = checked.execution,
		signature = signature,
		bindings = body.bindings,
		statements = normalized.statements,
		body = normalized.body,
	})


private fixed record NormalizedVoidExit {
	statements: List[CheckedStatement],
	exit: CheckedExit
}


private pure func normalize_void_exit(statements: List[CheckedStatement], exit: CheckedExit) -> NormalizedVoidExit:
	match exit:
		RecurWith(_, _): { statements = statements, exit = exit }
		ReturnExpression(value):
			canonical = match value.base:
				ReturnVoid: value.operations.is_empty()
				_: False
			if canonical:
				{ statements = statements, exit = exit }
			else:
				{
					statements = statements.append(DiscardExpression(value)),
					exit = ReturnExpression({
						base = ReturnVoid,
						base_type = VoidType,
						base_span = value.base_span,
						operations = [],
					}),
				}


private fixed record NormalizedVoidBody {
	statements: List[CheckedStatement],
	body: CheckedBody
}


private pure func normalize_void_body(statements: List[CheckedStatement], body: CheckedBody) -> NormalizedVoidBody:
	match body:
		CheckedValueBody(exit):
			normalized = normalize_void_exit(statements, exit)
			{ statements = normalized.statements, body = CheckedValueBody(normalized.exit) }
		CheckedMatchBody(matched):
			arms = matched.arms.map(pure func(arm: CheckedArm) -> CheckedArm:
				normalized = normalize_void_exit(arm.statements, arm.body)
				{ arm | statements = normalized.statements, body = normalized.exit }
			)
			{ statements = statements, body = CheckedMatchBody({ matched | arms = arms }) }


private pure func is_self_call(call: CheckedCall, current: FunctionId) -> Bool:
	match call.target:
		UserFunction(id, _):
			IntOps.equals(function_number(id), function_number(current))
		RuntimeFunction(_):
			False


-- These checks traverse evaluated children, never recovering identity from names.
private pure func reject_self_value(
	value: CheckedValue,
	current: FunctionId,
) -> Result[Void, CheckError]:
	base_valid ?= match value.base:
		ReturnCall(call, arguments):
			if is_self_call(call, current):
				Err(check_rejection(value.base_span, NonTailSelfCall(current)))
			else:
				reject_self_arguments(arguments, current)
		ReturnRecord(_, fields):
			reject_self_arguments(
				fields.map(pure func(field: CheckedRecordField) -> CheckedValue: field.value),
				current,
			)
		_:
			Ok(void)

	var invalid: Option[CheckError] = None

	for step in value.operations:
		match step.operation:
			InvokeFunction(call, arguments):
				result = if is_self_call(call, current):
					Err(check_rejection(step.span, NonTailSelfCall(current)))
				else:
					reject_self_arguments(arguments, current)

				match result:
					Err(error):
						invalid = Some(error)
						break
					Ok(_):
						void
			_:
				void

	match invalid:
		Some(error):
			Err(error)
		None:
			Ok(void)


private pure func reject_self_arguments(
	arguments: List[CheckedValue],
	current: FunctionId,
) -> Result[Void, CheckError]:
	var invalid: Option[CheckError] = None

	for argument in arguments:
		match reject_self_value(argument, current):
			Err(error):
				invalid = Some(error)
				break
			Ok(_):
				void

	match invalid:
		Some(error):
			Err(error)
		None:
			Ok(void)


private pure func reject_self_statements(
	statements: List[CheckedStatement],
	current: FunctionId,
) -> Result[Void, CheckError]:
	reject_self_arguments(
		statements.map(pure func(statement: CheckedStatement) -> CheckedValue:
			match statement:
				InitializeBinding(_, value):
					value
				DiscardExpression(value):
					value
				ReassignBinding(_, value):
					value
		),
		current,
	)


private pure func tail_exit(
	exit: CheckedExit,
	current: FunctionId,
) -> Result[CheckedExit, CheckError]:
	match exit:
		RecurWith(_, _):
			Ok(exit)
		ReturnExpression(value):
			last = value.operations.get(IntOps.subtract(value.operations.length(), 1))

			match last:
				Some(step):
					match step.operation:
						InvokeFunction(call, arguments):
							if is_self_call(call, current):
								receiver = { value |
									operations = value.operations.take(
										IntOps.subtract(
											value.operations.length(),
											1,
										),
									)
								}
								next = [receiver].concat(arguments)
								valid ?= reject_self_arguments(next, current)
								Ok(RecurWith(next, step.span))
							else:
								valid ?= reject_self_value(value, current)
								Ok(exit)
						_:
							valid ?= reject_self_value(value, current)
							Ok(exit)
				None:
					match value.base:
						ReturnCall(call, arguments):
							if is_self_call(call, current):
								valid ?= reject_self_arguments(arguments, current)
								Ok(RecurWith(arguments, value.base_span))
							else:
								valid ?= reject_self_value(value, current)
								Ok(exit)
						_:
							valid ?= reject_self_value(value, current)
							Ok(exit)


private pure func recurs(exit: CheckedExit) -> Bool:
	match exit:
		RecurWith(_, _):
			True
		ReturnExpression(_):
			False


private pure func check_arm_exit(
	arm: CheckedArm,
	current: FunctionId,
) -> Result[CheckedExit, CheckError]:
	prefix ?= reject_self_statements(arm.statements, current)
	tail_exit(arm.body, current)


private fixed record CheckedExecution {
	execution: FunctionExecution,
	body: CheckedBody
}


private pure func check_execution(
	function: ParsedFunction,
	resolved: ResolvedBody,
	current: FunctionId,
) -> Result[CheckedExecution, CheckError]:
	match function.tail_annotation:
		None:
			Ok({
				execution = OrdinaryCalls,
				body = resolved.body,
			})
		Some(annotation):
			nongeneric ?= if IntOps.equals(function.type_parameters.length(), 0):
				Ok(void)
			else:
				Err(check_rejection(annotation, GenericTailRecursionUnsupported))

			prefix ?= reject_self_statements(resolved.statements, current)
			var found = False

			body_result: Result[CheckedBody, CheckError] = match resolved.body:
				CheckedValueBody(value):
					exit ?= tail_exit(value, current)
					found = recurs(exit)
					Ok(CheckedValueBody(exit))
				CheckedMatchBody(matched):
					scrutinee ?= reject_self_value(matched.scrutinee, current)
					var arms: List[CheckedArm] = []
					var invalid: Option[CheckError] = None

					for arm in matched.arms:
						result = check_arm_exit(arm, current)

						match result:
							Err(error):
								invalid = Some(error)
								break
							Ok(exit):
								found = found or recurs(exit)
								arms = arms.append({ arm | body = exit })

					match invalid:
						Some(error):
							Err(error)
						None:
							Ok(CheckedMatchBody({ matched | arms = arms }))

			body ?= body_result

			if found:
				Ok({
					execution = SelfTailLoop(annotation),
					body = body,
				})
			else:
				Err(check_rejection(annotation, NoSelfRecursion))


private pure func append_exit_calls(
	collected: List[CheckedCall],
	exit: CheckedExit,
) -> List[CheckedCall]:
	match exit:
		ReturnExpression(value):
			append_value_calls(collected, value)
		RecurWith(arguments, _):
			var calls = collected

			for argument in arguments:
				calls = append_value_calls(calls, argument)

			calls


private pure func append_value_calls(
	collected: List[CheckedCall],
	value: CheckedValue,
) -> List[CheckedCall]:
	var calls = collected

	match value.base:
		ReturnRecord(_, fields):
			for field in fields:
				calls = append_value_calls(calls, field.value)
		ReturnCall(call, arguments):
			for argument in arguments:
				calls = append_value_calls(calls, argument)

			calls = calls.append(call)
		_:
			void

	for step in value.operations:
		match step.operation:
			InvokeFunction(call, arguments):
				for argument in arguments:
					calls = append_value_calls(calls, argument)

				calls = calls.append(call)
			_:
				void

	calls


private pure func append_statement_calls(
	collected: List[CheckedCall],
	statements: List[CheckedStatement],
) -> List[CheckedCall]:
	var calls = collected

	for statement in statements:
		match statement:
			InitializeBinding(_, value):
				calls = append_value_calls(calls, value)
			DiscardExpression(value):
				calls = append_value_calls(calls, value)
			ReassignBinding(_, value):
				calls = append_value_calls(calls, value)

	calls


pure func function_calls(function: CheckedFunction) -> List[CheckedCall]:
	var calls = append_statement_calls([], function.statements)

	match function.body:
		CheckedValueBody(value):
			append_exit_calls(calls, value)
		CheckedMatchBody(matched):
			calls = append_value_calls(calls, matched.scrutinee)

			for arm in matched.arms:
				calls = append_statement_calls(calls, arm.statements)
				calls = append_exit_calls(calls, arm.body)

			calls


private fixed union ParameterGrowth:
	PreservedParameter
	NestedParameter


private fixed record ParameterDependency {
	source: TypeParameterId,
	target: TypeParameterId,
	growth: ParameterGrowth,
	span: Span
}


private pure func append_dependencies(
	dependencies: List[ParameterDependency],
	argument: TypeRef,
	target: TypeParameterId,
	growth: ParameterGrowth,
	span: Span,
) -> List[ParameterDependency]:
	var collected = dependencies

	match argument:
		ParameterType(source):
			collected = collected.append({
				source = source,
				target = target,
				growth = growth,
				span = span,
			})
		ListType(element):
			collected = append_dependencies(collected, element, target, NestedParameter, span)
		AppliedUnionType(_, arguments):
			for child in arguments:
				collected = append_dependencies(collected, child, target, NestedParameter, span)
		_:
			void

	collected


private pure func contains_parameter_id(
	parameters: List[TypeParameterId],
	requested: TypeParameterId,
) -> Bool:
	var found = False

	for parameter in parameters:
		if same_parameter(parameter, requested):
			found = True
			break

	found


private pure func parameter_reaches(
	start: TypeParameterId,
	target: TypeParameterId,
	dependencies: List[ParameterDependency],
	span: Span,
) -> Result[Bool, CheckError]:
	var reached = [start]
	var cursor = 0
	var found = False
	var failure: Option[CheckError] = None

	while IntOps.less_than(cursor, reached.length()):
		match reached.get(cursor):
			Some(current):
				if same_parameter(current, target):
					found = True
					break

				for dependency in dependencies:
					if (
						same_parameter(dependency.source, current)
						and not contains_parameter_id(reached, dependency.target)
					):
						reached = reached.append(dependency.target)
			None:
				failure = Some(checker_invariant(span, InvalidParameterDeclaration(start)))
				break

		cursor = IntOps.add(cursor, 1)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(found)


private pure func validate_recursive_instantiation(
	functions: List[CheckedFunction],
) -> Result[Void, CheckError]:
	-- These transient edges relate declaration-owned parameter identities, using
	-- each checked call's simultaneous substitution. They are discarded before
	-- publication; CheckedCall remains the sole authority for that substitution.
	-- A concrete type can grow indefinitely only if a parameter flows around a
	-- dependency cycle beneath an application. Cycles of bare parameters merely
	-- permute finite inputs; concrete resets terminate a dependency path. Without
	-- a growing cycle, type-term depth is bounded. Finite constructors, arities
	-- and ground leaves therefore bound all concrete instance keys.
	var dependencies: List[ParameterDependency] = []

	for function in functions:
		for call in function_calls(function):
			match call.target:
				UserFunction(declaration, arguments):
					var position = 0

					for argument in arguments:
						target = into_opaque TypeParameterId({
								owner = FunctionDeclaration(declaration),
								position = position
							})
						dependencies = append_dependencies(
							dependencies,
							argument,
							target,
							PreservedParameter,
							call.span,
						)
						position = IntOps.add(position, 1)
				RuntimeFunction(_):
					void

	var failure: Option[CheckError] = None

	for dependency in dependencies:
		match dependency.growth:
			NestedParameter:
				match parameter_reaches(
					dependency.target,
					dependency.source,
					dependencies,
					dependency.span,
				):
					Err(error):
						failure = Some(error)
					Ok(cyclic):
						if cyclic:
							failure = Some(
								check_rejection(
									dependency.span,
									GrowingRecursiveInstantiation,
								),
							)
			PreservedParameter:
				void

		if failure.is_some():
			break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)


private pure func check_program(program: ParsedProgram) -> Result[CheckedProgram, CheckError]:
	parsed = parsed_contents(program)

	builtins ?= match check_builtin_types(program):
		Ok(_):
			Ok(void)
		Err(error):
			Err(check_rejection(error.span, BuiltinTypesRejected(error)))

	namespace = build_namespace(program)
	imports ?= validate_imports(parsed, namespace)
	declarations ?= validate_declarations(
		parsed.unions,
		parsed.records,
		parsed.functions,
		namespace,
	)
	signatures ?= validate_signatures(
		parsed.functions,
		parsed.unions,
		parsed.end,
		parsed.entrypoint,
		namespace,
		declarations.unions,
	)
	callables ?= build_callables(parsed.functions, namespace, signatures.functions)
	functions ?= resolve_functions(parsed, signatures.functions, declarations, namespace, callables)
	finite ?= validate_recursive_instantiation(functions)
	Ok(into_opaque CheckedProgram({
				unions = declarations.unions,
				records = declarations.records,
				functions = functions,
				entrypoint = signatures.entrypoint
			}))


private pure func validate_import_binding(
	parsed: ParsedContents,
	namespace: Namespace,
	binding: ImportedFunctionBinding,
) -> Result[Void, CheckError]:
	var failure: Option[CheckError] = None

	for candidate in function_candidates(namespace, binding.module, binding.name.id):
		if IntOps.equals(function_number(candidate.function), function_number(binding.function)):
			-- Namespace candidates preserve declaration/import order. Once this
			-- identity is reached, later imports will validate their own conflicts.
			break

		match candidate.origin:
			LocalFunction:
				failure = Some(
					match parsed.functions.get(function_number(candidate.function)):
						Some(function):
							check_rejection(
								binding.name.span,
								ImportedFunctionConflict(
									binding.name.id,
									function.function_name.span,
								),
							)
						None:
							checker_invariant(
								binding.name.span,
								InvalidResolvedFunction(candidate.function),
							)
				)
			ImportedFunction(span):
				failure = Some(
					check_rejection(
						binding.name.span,
						ImportedFunctionConflict(binding.name.id, span),
					),
				)

		if failure.is_some():
			break

	match failure:
		Some(error):
			Err(error)
		None:
			match variant_candidates(namespace, binding.module, binding.name.id).get(0):
				None:
					Ok(void)
				Some(variant):
					owner = variant_owner(variant)
					declaration ?= parsed.unions
						.get(union_number(owner))
						.to_result(
							checker_invariant(
								binding.name.span,
								InvalidResolvedUnion(owner),
							),
						)
					written ?= declaration.variants
						.get(variant_number(variant))
						.to_result(
							checker_invariant(
								binding.name.span,
								InvalidResolvedVariant(variant),
							),
						)
					Err(
						check_rejection(
							binding.name.span,
							ImportedVariantConflict(binding.name.id, written.name.span),
						),
					)


private pure func validate_imports(
	parsed: ParsedContents,
	namespace: Namespace,
) -> Result[Void, CheckError]:
	match import_problems(namespace).get(0):
		Some(problem):
			span = import_problem_span(problem)

			Err(check_rejection(span, ImportRejected(problem)))
		None:
			var failure: Option[CheckError] = None

			for binding in imported_variants(namespace):
				match function_candidates(namespace, binding.module, binding.name.id).get(0):
					Some(candidate):
						match candidate.origin:
							ImportedFunction(previous):
								failure = Some(
									check_rejection(
										binding.name.span,
										ImportedConstructorConflict(binding.name.id, previous),
									),
								)
							LocalFunction:
								match parsed.functions.get(function_number(candidate.function)):
									Some(function):
										failure = Some(
											check_rejection(
												binding.name.span,
												ImportedConstructorConflict(
													binding.name.id,
													function.function_name.span,
												),
											),
										)
									None:
										failure = Some(
											checker_invariant(
												binding.name.span,
												InvalidResolvedFunction(candidate.function),
											),
										)
					None:
						void

				if failure.is_some():
					break

			for binding in imported_functions(namespace):
				if failure.is_some():
					break

				match validate_import_binding(parsed, namespace, binding):
					Err(error):
						failure = Some(error)
						break
					Ok(_):
						void

			match failure:
				Some(error):
					Err(error)
				None:
					Ok(void)


private pure func resolve_receiver(
	purity: Purity,
	scope: List[LocalBinding],
	current: ResolvedValue,
	application: ReceiverApplication,
	receiver: ResolvedReceiver,
	context: ResolutionContext,
	span: Span,
) -> Result[ResolvedValue, CheckError]:
	contract ?= select_receiver_contract(
		purity,
		application,
		receiver,
		{value_type = current.value_type, span = current.value.base_span},
		context,
	)
	resolved ?= check_arguments(purity, scope, application.arguments, Some(current), contract, context)

	operation ?= match resolved.contract.operation:
		FunctionCall(call):
			Ok(InvokeFunction(call, resolved.values))
		_:
			Err(checker_invariant(contract.span, InvalidReceiverContract))

	Ok({
		value = { current.value | operations = current.value.operations.append({
				operation = operation,
				value_type = resolved.contract.return_type,
				span = span,
			}) },
		value_type = resolved.contract.return_type,
	})


private pure func classify_direct_call(
	purity: Purity,
	name: WrittenName,
	arity: Int,
	scope: List[LocalBinding],
	context: ResolutionContext,
) -> Result[ResolvedApplication, CheckError]:
	callable ?= match lookup_binding(scope, name.id):
		Some(binding):
			Err(non_callable(binding, name.span, context.function))
		None:
			Ok(void)

	target ?= lookup_target(context, name)

	match target:
		Some(target):
			resolved ?= resolve_function_target(name, target, context.signatures)
			contract ?= function_contract(
				purity,
				name,
				DirectCall,
				arity,
				resolved,
				context.function,
			)
			Ok(FunctionApplication(contract))
		None:
			if contains_variant(context.namespace, context.module, name.id):
				Ok(ConstructorApplication(name))
			else:
				Err(check_rejection(name.span, UnknownFunction(name.id)))


private pure func contains_parameter(value_type: TypeRef) -> Bool:
	match value_type:
		ListType(element):
			contains_parameter(element)
		ParameterType(_):
			True
		AppliedUnionType(_, arguments):
			var found = False

			for argument in arguments:
				if contains_parameter(argument):
					found = True
					break

			found
		_:
			False


private pure func check_value(
	purity: Purity,
	scope: List[LocalBinding],
	body: ValueExpression,
	expected: ExpectedValue,
	context: ResolutionContext,
) -> Result[ResolvedValue, CheckError]:
	value ?= synthesize_value(purity, scope, body, Some(expected.value_type), context)

	if same_type(value.value_type, expected.value_type):
		Ok(value)
	else:
		Err(check_rejection(
			body.span,
			ExpressionTypeMismatch({
				expected = expected.value_type,
				actual = {
					value_type = value.value_type,
					span = body.span
				},
				expected_site = expected.site,
			}),
		))


pure func check(program: ParsedProgram) -> Result[CheckedProgram, CheckFailure]:
	match check_program(program):
		Ok(checked):
			Ok(checked)
		Err(error):
			Err(into_opaque CheckFailure({
						program = program,
						errors = {
							first = error,
							remaining = []
						}
					}))


pure func check_errors(failure: CheckFailure) -> CheckErrors:
	from_opaque CheckFailure(failure).errors


pure func failure_program(failure: CheckFailure) -> ParsedProgram:
	from_opaque CheckFailure(failure).program


private pure func check_rejection(span: Span, kind: CheckErrorKind) -> CheckError:
	{
		span = span,
		kind = kind
	}


private pure func binding_site(function: FunctionId, binding: LocalBinding) -> BindingSite:
	{
		function = function,
		binding = binding.id,
		name = binding.name,
		span = binding.definition.span
	}


private pure func parameter_site(contract: CallContract, parameter: TypeUse) -> ExpectedTypeSite:
	match contract.operation:
		FunctionCall(call):
			match call.target:
				RuntimeFunction(operation):
					RuntimeContract(operation)
				UserFunction(_, _):
					SourceAnnotation(parameter.span)
		VariantConstruction(_):
			SourceAnnotation(parameter.span)


private pure func non_callable(
	binding: LocalBinding,
	span: Span,
	function: FunctionId,
) -> CheckError:
	check_rejection(
		span,
		UncallableBinding(
			binding_site(function, binding),
			binding.definition.origin,
			binding.definition.value_type,
		),
	)


fixed union CheckerInvariant:
	InvalidRecordDeclaration(RecordId)
	InvalidRecordField(FieldId)
	InvalidResolvedFunction(FunctionId)
	AmbiguousResolvedFunction(NameId)
	InvalidUnionDeclaration(UnionId)
	VariantOccurrenceWithoutUnion(TypeRef)
	InvalidResolvedUnion(UnionId)
	InvalidCheckedUnion(UnionId)
	InvalidResolvedVariant(VariantId)
	InvalidParameterDeclaration(TypeParameterId)
	InvalidParameterName(TypeParameterId)
	ParameterOwnerWithoutParameter(TypeParameterId)
	InvalidParsedName(NameId)
	DirectCallInSimpleBase(NameId)
	MissingCallParameter(Int)
	ConstructorReceiver(NameId)
	MissingConstructorArgument(NameId)
	InvalidFunctionContract
	MissingGenericParameter(Int)
	RuntimeGenericContract
	GenericConstructorContract
	InvalidResolvedParameter(Int)
	InvalidReceiverContract
	InvalidCallName(NameId)


private pure func checker_invariant(span: Span, invariant: CheckerInvariant) -> CheckError:
	check_rejection(span, InternalInvariant(invariant))


private pure func previous_declaration(
	previous: List[WrittenName],
	name: NameId,
) -> Option[WrittenName]:
	var found: Option[WrittenName] = None

	for known in previous:
		if same_name(known.id, name):
			found = Some(known)
			break

	found
