import:
	syntax: Diagnostic, ParsedProgram, ReturnExpression(ZeroExpression)


fixed union CheckedReturn:
	ReturnZero


opaque type CheckedProgram = CheckedReturn


pure func checked_return(program: CheckedProgram) -> CheckedReturn:
	from_opaque CheckedProgram(program)


pure func check(program: ParsedProgram) -> Result[CheckedProgram, Diagnostic]:
	if program.function_name.spelling != "main":
		Err({
			span = program.function_name.span,
			message = "expected exactly one main function",
			help = "name the entrypoint main",
		})
	else if program.return_type.spelling != "Int":
		Err({
			span = program.return_type.span,
			message = "expected Int as the main return type",
			help = "declare func main() -> Int:",
		})
	else:
		match program.body:
			ZeroExpression:
				Ok(into_opaque CheckedProgram(ReturnZero))
