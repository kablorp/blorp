import:
	int as IntOps
	names: NameId, NameTable, SpecialNames, name_spelling, same_name
	option: is_some, to_result
	parse: ParsedProgram, parsed_contents
	syntax:
		CallNotation(DirectCall, ReceiverCall),
		Diagnostic,
		ExpressionBase(IntegerExpression, NameExpression, CallExpression),
		IntegerValue,
		ParameterList(EmptyParameters, SingleParameter),
		ParsedFunction,
		Purity(Pure, Impure),
		ReturnExpression,
		Span,
		WrittenName,
	text as Text


-- A function's position in the parsed and checked lists is its identity.
-- Both lists retain declaration order; no second numbering table is published.
opaque type FunctionId = Int


fixed union ParameterShape:
	NoParameter
	IntParameter


fixed record CheckedCall {
	target: FunctionId,
	span: Span
}


fixed union CheckedBase:
	ReturnInteger(IntegerValue)
	ReturnParameter
	ReturnCall(CheckedCall)


fixed record CheckedReturn {
	base: CheckedBase,
	unary_calls: List[CheckedCall]
}


private fixed union ArgumentCount:
	NoArguments
	OneArgument(CallNotation)


fixed record CheckedFunction {
	purity: Purity,
	parameters: ParameterShape,
	body: CheckedReturn
}


fixed record CheckedFunctions {
	functions: List[CheckedFunction],
	entrypoint: FunctionId
}


opaque type CheckedProgram = CheckedFunctions


pure func function_number(id: FunctionId) -> Int:
	from_opaque FunctionId(id)


pure func checked_functions(program: CheckedProgram) -> CheckedFunctions:
	from_opaque CheckedProgram(program)


private pure func find_function(
	functions: List[ParsedFunction],
	name: NameId,
) -> Option[FunctionId]:
	var index: Int = 0
	var found: Option[FunctionId] = None

	for function in functions:
		if same_name(function.function_name.id, name):
			found = Some(into_opaque FunctionId(index))
			break

		index = IntOps.add(index, 1)

	found


private pure func rejection(span: Span, message: String, help: String) -> Diagnostic:
	{
		span = span,
		message = message,
		help = help
	}


private pure func validate_signatures(
	functions: List[ParsedFunction],
	end: Span,
	special: SpecialNames,
) -> Result[FunctionId, Diagnostic]:
	var previous: List[ParsedFunction] = []
	var failure: Option[Diagnostic] = None

	for function in functions:
		if find_function(previous, function.function_name.id).is_some():
			failure = Some(
				rejection(
					function.function_name.span,
					"duplicate function name",
					"give every function a distinct name",
				),
			)
			break

		if not same_name(function.return_type.id, special.integer):
			failure = Some(
				rejection(
					function.return_type.span,
					"expected Int as the function return type",
					"declare every function with -> Int:",
				),
			)
			break

		match function.parameters:
			EmptyParameters:
				void
			SingleParameter(parameter):
				if same_name(function.function_name.id, special.main):
					failure = Some(
						rejection(
							parameter.name.span,
							"main cannot have a parameter",
							"declare main() -> Int: with no parameters",
						),
					)
					break

				if not same_name(parameter.type_name.id, special.integer):
					failure = Some(
						rejection(
							parameter.type_name.span,
							"expected Int as the parameter type",
							"declare the parameter as name: Int",
						),
					)
					break

		previous = previous.append(function)

	match failure:
		Some(error):
			Err(error)
		None:
			match find_function(functions, special.main):
				Some(id):
					Ok(id)
				None:
					Err(
						rejection(
							end,
							"expected a main function",
							"declare func main() -> Int: as the entrypoint",
						),
					)


private pure func validate_call(
	caller: Purity,
	callee: Purity,
	span: Span,
) -> Result[Void, Diagnostic]:
	match caller:
		Impure:
			Ok(void)
		Pure:
			match callee:
				Pure:
					Ok(void)
				Impure:
					Err(
						rejection(
							span,
							"pure functions cannot call impure functions",
							"mark the callee pure or remove pure from the caller",
						),
					)


private pure func is_parameter(parameters: ParameterList, name: NameId) -> Bool:
	match parameters:
		EmptyParameters:
			False
		SingleParameter(parameter):
			same_name(parameter.name.id, name)


private pure func parameter_shape(parameters: ParameterList) -> ParameterShape:
	match parameters:
		EmptyParameters:
			NoParameter
		SingleParameter(_):
			IntParameter


private pure func resolve_call(
	purity: Purity,
	parameters: ParameterList,
	name: WrittenName,
	arguments: ArgumentCount,
	functions: List[ParsedFunction],
	names: NameTable,
) -> Result[CheckedCall, Diagnostic]:
	uses_local_name: Bool = match arguments:
		NoArguments:
			True
		OneArgument(notation):
			match notation:
				DirectCall:
					True
				ReceiverCall:
					False

	if uses_local_name and is_parameter(parameters, name.id):
		Err(
			rejection(
				name.span,
				"Int parameters cannot be called",
				"use the parameter as a value, or rename it to call the function",
			),
		)
	else:
		id ?= find_function(
			functions,
			name.id,
		).to_result(
			rejection(
				name.span,
				"unknown function",
				"declare the called function in this file",
			),
		)
		callee ?= functions
			.get(function_number(id))
			.to_result(
				rejection(
					name.span,
					"invalid resolved function identity",
					"report this compiler error with the input program",
				),
			)

		arity ?= match arguments:
			NoArguments:
				match callee.parameters:
					EmptyParameters:
						Ok(void)
					SingleParameter(_):
						Err(
							rejection(
								name.span,
								"function requires one argument",
								"pass one Int expression, such as identity(1)",
							),
						)
			OneArgument(notation):
				match callee.parameters:
					EmptyParameters:
						error: Diagnostic = match notation:
							DirectCall:
								rejection(
									name.span,
									"function takes no arguments",
									"remove the argument and call the function with ()",
								)
							ReceiverCall:
								match name_spelling(names, name.id):
									None:
										rejection(
											name.span,
											"invalid parsed name identity",
											"report this compiler error with the input program",
										)
									Some(spelling):
										rejection(
											name.span,
											"function takes no arguments",
											Text
												.concat("call ", spelling)
												.concat(
													"() directly, or choose a function with one Int parameter",
												),
										)

						Err(error)
					SingleParameter(_):
						Ok(void)

		validated ?= validate_call(purity, callee.purity, name.span)
		Ok({
			target = id,
			span = name.span,
		})


private pure func resolve_base(
	purity: Purity,
	parameters: ParameterList,
	base: ExpressionBase,
	functions: List[ParsedFunction],
	names: NameTable,
) -> Result[CheckedBase, Diagnostic]:
	match base:
		IntegerExpression(value):
			Ok(ReturnInteger(value))
		NameExpression(name):
			if is_parameter(parameters, name.id):
				Ok(ReturnParameter)
			else:
				Err(
					rejection(
						name.span,
						"unknown value",
						"use this function's parameter name or a call such as one()",
					),
				)
		CallExpression(name):
			call ?= resolve_call(purity, parameters, name, NoArguments, functions, names)
			Ok(ReturnCall(call))


private pure func resolve_body(
	purity: Purity,
	parameters: ParameterList,
	body: ReturnExpression,
	functions: List[ParsedFunction],
	names: NameTable,
) -> Result[CheckedReturn, Diagnostic]:
	base ?= resolve_base(purity, parameters, body.base, functions, names)
	var calls: List[CheckedCall] = []
	var failure: Option[Diagnostic] = None

	for call in body.unary_calls:
		match resolve_call(
			purity,
			parameters,
			call.callee,
			OneArgument(call.notation),
			functions,
			names,
		):
			Err(error):
				failure = Some(error)
				break
			Ok(call):
				calls = calls.append(call)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({
				base = base,
				unary_calls = calls,
			})


private pure func resolve_functions(
	parsed: List[ParsedFunction],
	names: NameTable,
) -> Result[List[CheckedFunction], Diagnostic]:
	var functions: List[CheckedFunction] = []
	var failure: Option[Diagnostic] = None

	for function in parsed:
		match resolve_body(function.purity, function.parameters, function.body, parsed, names):
			Err(error):
				failure = Some(error)
				break
			Ok(body):
				functions = functions.append({
					purity = function.purity,
					parameters = parameter_shape(function.parameters),
					body = body,
				})

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(functions)


private pure func is_settled(id: FunctionId, settled: List[FunctionId]) -> Bool:
	var found: Bool = False

	for known in settled:
		if IntOps.equals(function_number(id), function_number(known)):
			found = True
			break

	found


private pure func unsettled_edge(body: CheckedReturn, settled: List[FunctionId]) -> Option[Span]:
	var found: Option[Span] = match body.base:
		ReturnInteger(_):
			None
		ReturnParameter:
			None
		ReturnCall(call):
			if is_settled(call.target, settled):
				None
			else:
				Some(call.span)

	for call in body.unary_calls:
		if found.is_some():
			break

		if not is_settled(call.target, settled):
			found = Some(call.span)

	found


private pure func validate_acyclic(functions: List[CheckedFunction]) -> Result[Void, Diagnostic]:
	-- Settle only functions whose complete base/wrapper callee set is settled.
	-- Every successful step adds a distinct identity; leftovers contain or reach
	-- a cycle. Repeating an acyclic callee inside one body does not form a cycle.
	var settled: List[FunctionId] = []
	var changed: Bool = True

	while changed:
		changed = False
		var index: Int = 0

		for function in functions:
			id = into_opaque FunctionId(index)

			if not is_settled(id, settled) and not unsettled_edge(function.body, settled).is_some():
				settled = settled.append(id)
				changed = True

			index = IntOps.add(index, 1)

	var failure: Option[Diagnostic] = None

	for function in functions:
		match unsettled_edge(function.body, settled):
			Some(span):
				failure = Some(
					rejection(
						span,
						"call chain contains recursion",
						"use an acyclic call chain; recursion is not supported in this increment",
					),
				)
				break
			None:
				void

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)


pure func check(program: ParsedProgram) -> Result[CheckedProgram, Diagnostic]:
	parsed = parsed_contents(program)
	entrypoint ?= validate_signatures(parsed.functions, parsed.end, parsed.special)
	functions ?= resolve_functions(parsed.functions, parsed.names)
	acyclic ?= validate_acyclic(functions)
	Ok(into_opaque CheckedProgram({
				functions = functions,
				entrypoint = entrypoint
			}))
