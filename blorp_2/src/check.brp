import:
	./prelude:
		CheckedPrelude,
		PrimitiveType(BuiltinInt, BuiltinString),
		RuntimeOperation,
		prelude_names,
		runtime_contract,
		runtime_operation,
	int as IntOps
	names: NameId, SpecialNames, name_spelling, same_name
	option: is_some, to_result
	parse: ParsedContents, ParsedProgram, parsed_contents
	result: and_then
	syntax:
		BindingSyntax(ImmutableBinding, MutableBinding),
		CallNotation(DirectCall, ReceiverCall),
		Diagnostic,
		Diagnostics,
		ExpressionBase(IntegerExpression, NameExpression, DirectApplication),
		FieldPattern(FieldName, FieldWildcard),
		ParsedBinding,
		ParsedBody(ParsedValueBody, ParsedMatchBody),
		ParsedFunction,
		ParsedMatch,
		ParsedMatchArm,
		ParsedParameter,
		ParsedPattern(PatternName, PatternWildcard, PatternConstructor),
		ParsedUnion,
		Purity(Pure, Impure),
		ReceiverApplication,
		Span,
		TypeParameterSyntax(NoTypeParameterSyntax, OneTypeParameterSyntax),
		TypeSyntax(AtomicType, AppliedType),
		ValueExpression,
		WrittenName,
		type_span,
	text as Text


-- A function's position in the parsed and checked lists is its identity.
-- Both lists retain declaration order; no second numbering table is published.
opaque type FunctionId = Int

opaque type UnionId = Int


fixed union TypeParameterOwner:
	FunctionDeclaration(FunctionId)
	UnionDeclaration(UnionId)


-- The supported declaration has exactly one parameter: the owner identifies
-- its sole position. Function and union declaration domains remain distinct.
opaque type TypeParameterId = TypeParameterOwner


fixed union TypeParameters:
	NoTypeParameter
	OneTypeParameter(TypeParameterId)


private fixed record VariantIdentity {
	owner: UnionId,
	position: Int
}


opaque type VariantId = VariantIdentity


fixed union TypeRef:
	IntType
	StringType
	UnionType(UnionId)
	AppliedUnionType(UnionId, TypeRef)
	ParameterType(TypeParameterId)


fixed record CheckedUnion {
	type_parameters: TypeParameters,
	variants: List[Option[TypeUse]]
}


fixed record TypeUse {
	value_type: TypeRef,
	span: Span
}


fixed record FunctionSignature {
	type_parameters: TypeParameters,
	purity: Purity,
	parameters: List[TypeUse],
	return_type: TypeUse
}


fixed union CallTarget:
	UserFunction(FunctionId, Instantiation)
	RuntimeFunction(RuntimeOperation)


fixed union Instantiation:
	NoInstantiation
	InstantiateWith(TypeRef)


fixed record CheckedCall {
	target: CallTarget,
	span: Span
}


private pure func primitive_ref(value_type: PrimitiveType) -> TypeRef:
	match value_type:
		BuiltinInt:
			IntType
		BuiltinString:
			StringType


private pure func runtime_signature(operation: RuntimeOperation, span: Span) -> FunctionSignature:
	contract = runtime_contract(operation)
	{
		type_parameters = NoTypeParameter,
		purity = contract.purity,
		parameters = [
			{
				value_type = primitive_ref(contract.parameter),
				span = span
			},
		],
		return_type = {
			value_type = primitive_ref(contract.return_type),
			span = span
		}
	}


-- IDs are dense ordinals owned by one sealed checked function, never roles.
opaque type BindingId = Int


fixed union BindingOrigin:
	ParameterBinding(Int)
	BodyLocal
	MatchCapture


fixed union BindingMutability:
	Immutable
	Mutable


fixed record BindingDefinition {
	origin: BindingOrigin,
	mutability: BindingMutability,
	value_type: TypeRef,
	span: Span
}


pure func binding_number(id: BindingId) -> Int:
	from_opaque BindingId(id)


fixed union CheckedBase:
	ReturnInteger(Int)
	ReturnVariant(VariantId)
	ReturnBinding(BindingId)
	ReturnCall(CheckedCall, List[CheckedValue])


fixed union CheckedOperation:
	InvokeFunction(CheckedCall, List[CheckedValue])
	ConstructVariant(VariantId)


fixed record CheckedStep {
	operation: CheckedOperation,
	value_type: TypeRef,
	span: Span
}


fixed record CheckedValue {
	base: CheckedBase,
	base_type: TypeRef,
	base_span: Span,
	operations: List[CheckedStep]
}


fixed union CheckedAssignment:
	InitializeBinding(BindingId, CheckedValue)
	ReassignBinding(BindingId, CheckedValue)


fixed union PayloadBinding:
	NoPayloadBinding
	DiscardPayload
	BindPayload(BindingId)


fixed union CheckedPattern:
	VariantCase(VariantId, PayloadBinding)
	WildcardCase
	BindingCase(BindingId)


fixed record CheckedArm {
	pattern: CheckedPattern,
	assignments: List[CheckedAssignment],
	body: CheckedValue
}


fixed record CheckedMatch {
	scrutinee: CheckedValue,
	union_type: TypeRef,
	arms: List[CheckedArm]
}


fixed union CheckedBody:
	CheckedValueBody(CheckedValue)
	CheckedMatchBody(CheckedMatch)


fixed record CheckedFunction {
	signature: FunctionSignature,
	bindings: List[BindingDefinition],
	assignments: List[CheckedAssignment],
	body: CheckedBody
}


fixed record CheckedFunctions {
	unions: List[CheckedUnion],
	functions: List[CheckedFunction],
	entrypoint: FunctionId
}


opaque type CheckedProgram = CheckedFunctions


pure func union_number(id: UnionId) -> Int:
	from_opaque UnionId(id)


pure func variant_owner(id: VariantId) -> UnionId:
	from_opaque VariantId(id).owner


pure func variant_number(id: VariantId) -> Int:
	from_opaque VariantId(id).position


pure func same_type(left: TypeRef, right: TypeRef) -> Bool:
	match left:
		AppliedUnionType(left_owner, left_argument):
			match right:
				AppliedUnionType(right_owner, right_argument):
					(
						IntOps.equals(union_number(left_owner), union_number(right_owner))
						and same_type(left_argument, right_argument)
					)
				_:
					False
		ParameterType(left):
			match right:
				ParameterType(right):
					same_parameter(left, right)
				_:
					False
		IntType:
			match right:
				IntType:
					True
				_:
					False
		StringType:
			match right:
				StringType:
					True
				_:
					False
		UnionType(left):
			match right:
				UnionType(right):
					IntOps.equals(union_number(left), union_number(right))
				_:
					False


pure func function_number(id: FunctionId) -> Int:
	from_opaque FunctionId(id)


pure func parameter_owner(id: TypeParameterId) -> TypeParameterOwner:
	from_opaque TypeParameterId(id)


pure func same_parameter(left: TypeParameterId, right: TypeParameterId) -> Bool:
	match parameter_owner(left):
		FunctionDeclaration(left):
			match parameter_owner(right):
				FunctionDeclaration(right):
					IntOps.equals(function_number(left), function_number(right))
				_:
					False
		UnionDeclaration(left):
			match parameter_owner(right):
				UnionDeclaration(right):
					IntOps.equals(union_number(left), union_number(right))
				_:
					False


pure func checked_functions(program: CheckedProgram) -> CheckedFunctions:
	from_opaque CheckedProgram(program)


pure func declaration_id(program: CheckedProgram, position: Int) -> Option[FunctionId]:
	from_opaque CheckedProgram(program).functions
		.get(position)
		.map(pure func(_): into_opaque FunctionId(position))


pure func union_declaration_id(program: CheckedProgram, position: Int) -> Option[UnionId]:
	from_opaque CheckedProgram(program).unions
		.get(position)
		.map(pure func(_): into_opaque UnionId(position))


private pure func find_function(
	functions: List[ParsedFunction],
	name: NameId,
) -> Option[FunctionId]:
	var index: Int = 0
	var found: Option[FunctionId] = None

	for function in functions:
		if same_name(function.function_name.id, name):
			found = Some(into_opaque FunctionId(index))
			break

		index = IntOps.add(index, 1)

	found


fixed record BindingSite {
	function: FunctionId,
	binding: BindingId,
	name: NameId,
	span: Span
}


fixed union ExpectedTypeSite:
	SourceAnnotation(Span)
	InferredBindingDeclaration(BindingSite)
	RuntimeContract(RuntimeOperation)


fixed record ArgumentMismatch {
	expected: TypeRef,
	actual: TypeUse,
	argument_position: Int,
	expected_site: ExpectedTypeSite
}


fixed record ExpressionMismatch {
	expected: TypeRef,
	actual: TypeUse,
	expected_site: ExpectedTypeSite
}


fixed record GenericConflict {
	mismatch: ArgumentMismatch,
	parameter: TypeParameterId,
	previous: TypeUse,
	current: TypeUse
}


fixed record ArityMismatch {
	callee: NameId,
	expected: Int,
	actual: Int,
	notation: CallNotation,
	target: CallTarget
}


fixed union PayloadRule:
	IntegerPayload
	IntegerOrParameterPayload


fixed union PreviousTypeDeclaration:
	SourceTypeDeclaration(Span)
	PreludeTypeDeclaration(NameId)


fixed union CheckErrorKind:
	DuplicateVariant(NameId, Span)
	DuplicateUnion(NameId, PreviousTypeDeclaration)
	DuplicateFunction(NameId, Span)
	DuplicateParameter(NameId, Span)
	DuplicateLocal(BindingSite)
	VariantFunctionConflict(NameId, Span, Span)
	FunctionPreludeConflict(NameId)
	VariantPreludeConflict(NameId)
	GenericMain(TypeParameterId)
	MainHasParameters(Int)
	MainReturnType(TypeRef)
	MissingMain
	UnknownType(NameId)
	MissingUnionTypeArguments(UnionId)
	OrdinaryUnionApplied(UnionId)
	NonApplicableType(NameId)
	TypeParameterTypeNameConflict(NameId)
	UnsupportedPayloadAnnotation(NameId, PayloadRule)
	UnknownValue(NameId)
	UnknownFunction(NameId)
	UncallableBinding(BindingSite, BindingOrigin, TypeRef)
	ArgumentCountMismatch(ArityMismatch)
	ImpureCall(FunctionId, CallTarget)
	ConstructorUFCS(NameId)
	ArgumentTypeMismatch(ArgumentMismatch)
	ExpressionTypeMismatch(ExpressionMismatch)
	GenericArgumentConflict(GenericConflict)
	UninferableTypeParameter(TypeParameterId)
	ConstructorNeedsExpectedType(NameId)
	VariantNotInExpectedType(NameId, TypeRef)
	PayloadFreeVariantCalled(VariantId)
	MissingConstructorPayload(VariantId, TypeRef)
	ConstructorPayloadArity(VariantId, Int)
	PatternUnexpectedField(VariantId)
	PatternMissingField(VariantId, TypeRef)
	UnknownConstructorPattern(NameId, TypeRef)
	UnreachableArm
	NonExhaustiveMatch(List[VariantId])
	MatchRequiresUnion(TypeRef)
	ImmutableAssignment(BindingSite)
	RecursiveCallChain
	InternalInvariant(CheckerInvariant)


fixed record CheckError {
	span: Span,
	kind: CheckErrorKind
}


fixed record CheckErrors {
	first: CheckError,
	remaining: List[CheckError]
}


private fixed record FailureContents {
	program: ParsedProgram,
	errors: CheckErrors
}


opaque type CheckFailure = FailureContents


private fixed record ExpectedValue {
	value_type: TypeRef,
	site: ExpectedTypeSite
}


private pure func find_union(unions: List[ParsedUnion], name: NameId) -> Option[UnionId]:
	var index: Int = 0
	var found: Option[UnionId] = None

	for declaration in unions:
		if same_name(declaration.type_name.id, name):
			found = Some(into_opaque UnionId(index))
			break

		index = IntOps.add(index, 1)

	found


private pure func contains_variant(unions: List[ParsedUnion], name: NameId) -> Bool:
	var found = False

	for declaration in unions:
		for variant in declaration.variants:
			if same_name(variant.name.id, name):
				found = True
				break

		if found:
			break

	found


private pure func validate_union(
	declaration: ParsedUnion,
	functions: List[ParsedFunction],
) -> Result[Void, CheckError]:
	var previous: List[WrittenName] = []
	var failure: Option[CheckError] = None

	for written in declaration.variants:
		variant = written.name

		for known in previous:
			if same_name(known.id, variant.id):
				failure = Some(
					check_rejection(
						variant.span,
						DuplicateVariant(variant.id, known.span),
					),
				)
				break

		if failure.is_some():
			break

		match find_function(functions, variant.id):
			None:
				void
			Some(id):
				match functions.get(function_number(id)):
					None:
						failure = Some(checker_invariant(variant.span, InvalidResolvedFunction(id)))
					Some(function):
						span = if IntOps.less_than(
							variant.span.start,
							function.function_name.span.start,
						):
							function.function_name.span
						else:
							variant.span

						failure = Some(
							check_rejection(
								span,
								VariantFunctionConflict(
									variant.id,
									variant.span,
									function.function_name.span,
								),
							),
						)

		if failure.is_some():
			break

		previous = previous.append(variant)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)


private pure func validate_unions(
	unions: List[ParsedUnion],
	functions: List[ParsedFunction],
	special: SpecialNames,
) -> Result[List[CheckedUnion], CheckError]:
	var previous: List[WrittenName] = []
	var checked: List[CheckedUnion] = []
	var failure: Option[CheckError] = None

	for declaration in unions:
		earlier = previous_declaration(previous, declaration.type_name.id)

		duplicate: Option[PreviousTypeDeclaration] = if (
			same_name(declaration.type_name.id, special.integer)
			or same_name(declaration.type_name.id, special.string)
		):
			Some(PreludeTypeDeclaration(declaration.type_name.id))
		else:
			earlier.map(pure func(known): SourceTypeDeclaration(known.span))

		match duplicate:
			Some(first):
				failure = Some(
					check_rejection(
						declaration.type_name.span,
						DuplicateUnion(declaration.type_name.id, first),
					),
				)
				break
			None:
				void

		match validate_union(declaration, functions):
			Err(error):
				failure = Some(error)
				break
			Ok(_):
				parameter_result = local_type_parameter(
					declaration.type_parameters,
					UnionDeclaration(into_opaque UnionId(checked.length())),
					unions,
					special,
				)

				match parameter_result.and_then(
					pure func(parameter): resolve_payloads(declaration, parameter, special),
				):
					Err(error):
						failure = Some(error)
						break
					Ok(shapes):
						match parameter_result:
							Ok(parameter):
								checked = checked.append({
									type_parameters = declared_parameters(parameter),
									variants = shapes,
								})
							Err(error):
								failure = Some(error)

		previous = previous.append(declaration.type_name)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(checked)


private pure func resolve_payloads(
	declaration: ParsedUnion,
	type_parameter: Option[LocalTypeParameter],
	special: SpecialNames,
) -> Result[List[Option[TypeUse]], CheckError]:
	var shapes: List[Option[TypeUse]] = []
	var failure: Option[CheckError] = None

	for variant in declaration.variants:
		match variant.payload:
			None:
				shapes = shapes.append(None)
			Some(name):
				parameter = match type_parameter:
					Some(parameter):
						if same_name(name.id, parameter.name):
							Some(parameter.id)
						else:
							None
					None:
						None

				value_result: Result[TypeRef, CheckError] = if same_name(name.id, special.integer):
					Ok(IntType)
				else:
					match parameter:
						Some(id):
							Ok(ParameterType(id))
						None:
							Err(
								check_rejection(
									name.span,
									UnsupportedPayloadAnnotation(
										name.id,
										match type_parameter:
											None:
												IntegerPayload
											Some(_):
												IntegerOrParameterPayload
									),
								),
							)

				match value_result:
					Ok(value):
						shapes = shapes.append(Some({
							value_type = value,
							span = name.span,
						}))
					Err(error):
						failure = Some(error)
						break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(shapes)


private fixed record LocalTypeParameter {
	name: NameId,
	id: TypeParameterId
}


private pure func local_type_parameter(
	written: TypeParameterSyntax,
	owner: TypeParameterOwner,
	unions: List[ParsedUnion],
	special: SpecialNames,
) -> Result[Option[LocalTypeParameter], CheckError]:
	match written:
		NoTypeParameterSyntax:
			Ok(None)
		OneTypeParameterSyntax(name):
			if (
				same_name(name.id, special.integer)
				or same_name(name.id, special.string)
				or find_union(unions, name.id).is_some()
			):
				Err(check_rejection(name.span, TypeParameterTypeNameConflict(name.id)))
			else:
				Ok(Some({
					name = name.id,
					id = into_opaque TypeParameterId(owner),
				}))


private pure func resolve_type_parameter(
	function: ParsedFunction,
	id: FunctionId,
	unions: List[ParsedUnion],
	special: SpecialNames,
) -> Result[Option[LocalTypeParameter], CheckError]:
	valid_main ?= match function.type_parameters:
		OneTypeParameterSyntax(name):
			if same_name(function.function_name.id, special.main):
				Err(
					check_rejection(
						name.span,
						GenericMain(into_opaque TypeParameterId(FunctionDeclaration(id))),
					),
				)
			else:
				Ok(void)
		NoTypeParameterSyntax:
			Ok(void)

	local_type_parameter(function.type_parameters, FunctionDeclaration(id), unions, special)


private pure func declared_parameters(parameter: Option[LocalTypeParameter]) -> TypeParameters:
	match parameter:
		Some(parameter):
			OneTypeParameter(parameter.id)
		None:
			NoTypeParameter


private pure func resolve_atomic_type(
	unions: List[ParsedUnion],
	special: SpecialNames,
	name: WrittenName,
	type_parameter: Option[LocalTypeParameter],
) -> Result[TypeRef, CheckError]:
	local = match type_parameter:
		Some(parameter):
			if same_name(name.id, parameter.name):
				Some(parameter.id)
			else:
				None
		None:
			None

	match local:
		Some(id):
			Ok(ParameterType(id))
		None:
			if same_name(name.id, special.integer):
				Ok(IntType)
			else if same_name(name.id, special.string):
				Ok(StringType)
			else:
				match find_union(unions, name.id):
					Some(id):
						declaration ?= match unions.get(union_number(id)):
							Some(declaration):
								Ok(declaration)
							None:
								Err(checker_invariant(name.span, InvalidUnionDeclaration(id)))

						match declaration.type_parameters:
							NoTypeParameterSyntax:
								Ok(UnionType(id))
							OneTypeParameterSyntax(_):
								Err(check_rejection(name.span, MissingUnionTypeArguments(id)))
					None:
						Err(check_rejection(name.span, UnknownType(name.id)))


private pure func resolve_type(
	unions: List[ParsedUnion],
	special: SpecialNames,
	written: TypeSyntax,
	type_parameter: Option[LocalTypeParameter],
) -> Result[TypeRef, CheckError]:
	match written:
		AtomicType(name):
			resolve_atomic_type(unions, special, name, type_parameter)
		AppliedType(name, argument, span):
			owner ?= match find_union(unions, name.id):
				Some(owner):
					Ok(owner)
				None:
					Err(check_rejection(name.span, NonApplicableType(name.id)))

			declaration ?= match unions.get(union_number(owner)):
				Some(declaration):
					Ok(declaration)
				None:
					Err(checker_invariant(span, InvalidUnionDeclaration(owner)))

			arity ?= match declaration.type_parameters:
				OneTypeParameterSyntax(_):
					Ok(void)
				NoTypeParameterSyntax:
					Err(check_rejection(span, OrdinaryUnionApplied(owner)))

			value ?= resolve_atomic_type(unions, special, argument, type_parameter)
			Ok(AppliedUnionType(owner, value))


private fixed record CheckedSignatures {
	functions: List[FunctionSignature],
	entrypoint: FunctionId
}


private pure func resolve_parameters(
	parameters: List[ParsedParameter],
	function_name: NameId,
	unions: List[ParsedUnion],
	special: SpecialNames,
	type_parameter: Option[LocalTypeParameter],
) -> Result[List[TypeUse], CheckError]:
	var resolved: List[TypeUse] = []
	var seen: List[WrittenName] = []
	var failure: Option[CheckError] = None

	for parameter in parameters:
		result: Result[TypeRef, CheckError] = if same_name(function_name, special.main):
			Err(check_rejection(parameter.name.span, MainHasParameters(parameters.length())))
		else:
			match previous_declaration(seen, parameter.name.id):
				Some(first):
					Err(
						check_rejection(
							parameter.name.span,
							DuplicateParameter(parameter.name.id, first.span),
						),
					)
				None:
					resolve_type(unions, special, parameter.type_name, type_parameter)

		match result:
			Err(error):
				failure = Some(error)
				break
			Ok(value_type):
				resolved = resolved.append({
					value_type = value_type,
					span = type_span(parameter.type_name),
				})
				seen = seen.append(parameter.name)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(resolved)


private pure func resolve_signature(
	function: ParsedFunction,
	id: FunctionId,
	unions: List[ParsedUnion],
	special: SpecialNames,
) -> Result[FunctionSignature, CheckError]:
	type_parameter ?= resolve_type_parameter(function, id, unions, special)
	return_type ?= resolve_type(unions, special, function.return_type, type_parameter)

	main_type ?= if (
		same_name(function.function_name.id, special.main)
		and not same_type(return_type, IntType)
	):
		Err(check_rejection(type_span(function.return_type), MainReturnType(return_type)))
	else:
		Ok(void)

	parameters ?= resolve_parameters(
		function.parameters,
		function.function_name.id,
		unions,
		special,
		type_parameter,
	)

	type_parameters = match type_parameter:
		Some(parameter):
			OneTypeParameter(parameter.id)
		None:
			NoTypeParameter

	Ok({
		type_parameters = type_parameters,
		purity = function.purity,
		parameters = parameters,
		return_type = {
			value_type = return_type,
			span = type_span(function.return_type)
		},
	})


private pure func validate_signatures(
	functions: List[ParsedFunction],
	unions: List[ParsedUnion],
	end: Span,
	special: SpecialNames,
) -> Result[CheckedSignatures, CheckError]:
	var previous: List[WrittenName] = []
	var signatures: List[FunctionSignature] = []
	var failure: Option[CheckError] = None

	for function in functions:
		match previous_declaration(previous, function.function_name.id):
			Some(first):
				failure = Some(
					check_rejection(
						function.function_name.span,
						DuplicateFunction(function.function_name.id, first.span),
					),
				)
				break
			None:
				void

		match resolve_signature(
			function,
			into_opaque FunctionId(previous.length()),
			unions,
			special,
		):
			Err(error):
				failure = Some(error)
				break
			Ok(signature):
				signatures = signatures.append(signature)

		previous = previous.append(function.function_name)

	match failure:
		Some(error):
			Err(error)
		None:
			match find_function(functions, special.main):
				Some(id):
					Ok({
						functions = signatures,
						entrypoint = id,
					})
				None:
					Err(check_rejection(end, MissingMain))


private pure func validate_call(
	caller: Purity,
	callee: Purity,
	span: Span,
	function: FunctionId,
	target: CallTarget,
) -> Result[Void, CheckError]:
	match caller:
		Impure:
			Ok(void)
		Pure:
			match callee:
				Pure:
					Ok(void)
				Impure:
					Err(check_rejection(span, ImpureCall(function, target)))


private fixed record LocalBinding {
	name: NameId,
	id: BindingId,
	definition: BindingDefinition
}


private pure func lookup_binding(scope: List[LocalBinding], name: NameId) -> Option[LocalBinding]:
	var found: Option[LocalBinding] = None

	for binding in scope:
		if same_name(binding.name, name):
			found = Some(binding)
			break

	found


private fixed record ResolutionContext {
	function: FunctionId,
	functions: List[ParsedFunction],
	signatures: List[FunctionSignature],
	unions: List[ParsedUnion],
	checked_unions: List[CheckedUnion],
	prelude: CheckedPrelude
}


private fixed record ResolvedCall {
	call: CheckedCall,
	signature: FunctionSignature
}


private fixed record CallContract {
	type_parameters: TypeParameters,
	operation: CheckedOperation,
	parameter_types: List[TypeUse],
	return_type: TypeRef,
	span: Span
}


private fixed union ResolvedApplication:
	FunctionApplication(CallContract)
	ConstructorApplication(WrittenName)


private pure func resolve_function_target(
	name: WrittenName,
	target: CallTarget,
	signatures: List[FunctionSignature],
) -> Result[ResolvedCall, CheckError]:
	signature ?= match target:
		UserFunction(id, _):
			match signatures.get(function_number(id)):
				Some(signature):
					Ok(signature)
				None:
					Err(checker_invariant(name.span, InvalidResolvedFunction(id)))
		RuntimeFunction(operation):
			Ok(runtime_signature(operation, name.span))

	Ok({
		call = {
			target = target,
			span = name.span
		},
		signature = signature,
	})


private pure func lookup_target(
	functions: List[ParsedFunction],
	prelude: CheckedPrelude,
	name: NameId,
) -> Option[CallTarget]:
	match find_function(functions, name):
		Some(id):
			Some(UserFunction(id, NoInstantiation))
		None:
			runtime_operation(prelude, name).map(pure func(operation): RuntimeFunction(operation))


private pure func function_contract(
	purity: Purity,
	name: WrittenName,
	notation: CallNotation,
	arity: Int,
	resolved: ResolvedCall,
	context: ResolutionContext,
) -> Result[CallContract, CheckError]:
	count = resolved.signature.parameters.length()

	arity_check ?= if IntOps.equals(count, arity):
		Ok(void)
	else:
		Err(check_rejection(
			name.span,
			ArgumentCountMismatch({
				callee = name.id,
				expected = count,
				actual = arity,
				notation = notation,
				target = resolved.call.target,
			}),
		))

	pure_call ?= validate_call(
		purity,
		resolved.signature.purity,
		name.span,
		context.function,
		resolved.call.target,
	)
	Ok({
		type_parameters = resolved.signature.type_parameters,
		operation = InvokeFunction(resolved.call, []),
		parameter_types = resolved.signature.parameters,
		return_type = resolved.signature.return_type.value_type,
		span = name.span,
	})


private fixed record VariantContract {
	variant: VariantId,
	result_type: TypeRef,
	payload: Option[TypeUse]
}


private pure func type_union_owner(value: TypeRef) -> Option[UnionId]:
	match value:
		UnionType(id):
			Some(id)
		AppliedUnionType(id, _):
			Some(id)
		_:
			None


private pure func occurrence_payload(
	payload: Option[TypeUse],
	parameters: TypeParameters,
	union_type: TypeRef,
) -> Option[TypeUse]:
	match parameters:
		NoTypeParameter:
			payload
		OneTypeParameter(parameter):
			match union_type:
				AppliedUnionType(_, argument):
					payload.map(pure func(written):
						{ written |
							value_type = substitute_type(written.value_type, parameter, argument)
						}
					)
				_:
					payload


private pure func find_variant(
	context: ResolutionContext,
	union_type: TypeRef,
	name: WrittenName,
) -> Result[Option[VariantContract], CheckError]:
	owner ?= match type_union_owner(union_type):
		Some(owner):
			Ok(owner)
		None:
			Err(checker_invariant(name.span, VariantOccurrenceWithoutUnion(union_type)))

	declaration ?= match context.unions.get(union_number(owner)):
		Some(declaration):
			Ok(declaration)
		None:
			Err(checker_invariant(name.span, InvalidResolvedUnion(owner)))

	checked ?= match context.checked_unions.get(union_number(owner)):
		Some(checked):
			Ok(checked)
		None:
			Err(checker_invariant(name.span, InvalidCheckedUnion(owner)))

	var found: Option[VariantContract] = None
	var position: Int = 0
	var failure: Option[CheckError] = None

	for variant in declaration.variants:
		if same_name(variant.name.id, name.id):
			match checked.variants.get(position):
				None:
					failure = Some(
						checker_invariant(
							name.span,
							InvalidResolvedVariant(into_opaque VariantId({
										owner = owner,
										position = position
									})),
						),
					)
				Some(payload):
					found = Some({
						variant = into_opaque VariantId({
								owner = owner,
								position = position
							}),
						result_type = union_type,
						payload = occurrence_payload(payload, checked.type_parameters, union_type),
					})

			break

		position = IntOps.add(position, 1)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(found)


private pure func contextual_constructor(
	name: WrittenName,
	expected_type: Option[TypeRef],
	context: ResolutionContext,
) -> Result[VariantContract, CheckError]:
	match expected_type:
		None:
			Err(check_rejection(name.span, ConstructorNeedsExpectedType(name.id)))
		Some(type_ref):
			found ?= match type_ref:
				IntType | StringType | ParameterType(_):
					Ok(None)
				AppliedUnionType(owner, _):
					find_variant(context, type_ref, name)
				UnionType(owner):
					find_variant(context, type_ref, name)

			match found:
				Some(contract):
					Ok(contract)
				None:
					Err(check_rejection(name.span, VariantNotInExpectedType(name.id, type_ref)))


private pure func unary_constructor(
	name: WrittenName,
	expected_type: Option[TypeRef],
	context: ResolutionContext,
) -> Result[CallContract, CheckError]:
	contract ?= contextual_constructor(name, expected_type, context)

	match contract.payload:
		None:
			Err(check_rejection(name.span, PayloadFreeVariantCalled(contract.variant)))
		Some(payload):
			Ok({
				type_parameters = NoTypeParameter,
				operation = ConstructVariant(contract.variant),
				parameter_types = [payload],
				return_type = contract.result_type,
				span = name.span,
			})


private fixed record ResolvedBase {
	base: CheckedBase,
	value_type: TypeRef
}


private pure func constructor_base(
	name: WrittenName,
	expected_type: Option[TypeRef],
	called: Bool,
	context: ResolutionContext,
) -> Result[ResolvedBase, CheckError]:
	contract ?= contextual_constructor(name, expected_type, context)

	match contract.payload:
		Some(payload):
			Err(
				check_rejection(
					name.span,
					MissingConstructorPayload(contract.variant, payload.value_type),
				),
			)
		None:
			if called:
				Err(check_rejection(name.span, PayloadFreeVariantCalled(contract.variant)))
			else:
				Ok({
					base = ReturnVariant(contract.variant),
					value_type = contract.result_type,
				})


private pure func resolve_base(
	purity: Purity,
	scope: List[LocalBinding],
	base: ExpressionBase,
	expected_type: Option[TypeRef],
	context: ResolutionContext,
) -> Result[ResolvedBase, CheckError]:
	match base:
		IntegerExpression(value):
			Ok({
				base = ReturnInteger(value),
				value_type = IntType,
			})
		NameExpression(name):
			match lookup_binding(scope, name.id):
				Some(binding):
					Ok({
						base = ReturnBinding(binding.id),
						value_type = binding.definition.value_type,
					})
				None:
					if contains_variant(context.unions, name.id):
						constructor_base(name, expected_type, False, context)
					else:
						Err(check_rejection(name.span, UnknownValue(name.id)))
		DirectApplication(name, _):
			Err(checker_invariant(name.span, DirectCallInSimpleBase(name.id)))


private fixed record ResolvedValue {
	value: CheckedValue,
	value_type: TypeRef
}


private fixed record ResolvedArguments {
	values: List[CheckedValue],
	contract: CallContract
}


private pure func resolve_arguments(
	purity: Purity,
	scope: List[LocalBinding],
	arguments: List[ValueExpression],
	receiver: Option[ResolvedValue],
	contract: CallContract,
	context: ResolutionContext,
) -> Result[ResolvedArguments, CheckError]:
	var types: List[TypeUse] = []
	var values: List[CheckedValue] = []

	match receiver:
		Some(value):
			types = [
				{
					value_type = value.value_type,
					span = contract.span
				},
			]
		None:
			void

	var failure: Option[CheckError] = None

	for argument in arguments:
		expectation = match contract.parameter_types.get(types.length()):
			Some(value_type):
				if contains_parameter(value_type.value_type):
					None
				else:
					Some(value_type.value_type)
			None:
				None

		match resolve_expression(purity, scope, argument, expectation, context):
			Err(error):
				failure = Some(error)
				break
			Ok(value):
				types = types.append({
					value_type = value.value_type,
					span = argument.span,
				})
				values = values.append(value.value)

	ready ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	instantiated ?= instantiate_contract(contract, types, context)
	var index: Int = 0

	for actual in types:
		match instantiated.parameter_types.get(index):
			None:
				failure = Some(checker_invariant(contract.span, MissingCallParameter(index)))
				break
			Some(expected):
				span = if IntOps.equals(types.length(), 1):
					contract.span
				else:
					actual.span

				if not same_type(actual.value_type, expected.value_type):
					failure = Some(check_rejection(
						span,
						ArgumentTypeMismatch({
							expected = expected.value_type,
							actual = actual,
							argument_position = index,
							expected_site = parameter_site(instantiated, expected),
						}),
					))
					break

		index = IntOps.add(index, 1)

	ready ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	Ok({
		values = values,
		contract = instantiated,
	})


private pure func resolve_expression(
	purity: Purity,
	scope: List[LocalBinding],
	body: ValueExpression,
	expected_type: Option[TypeRef],
	context: ResolutionContext,
) -> Result[ResolvedValue, CheckError]:
	-- Resolve complete outer contracts once before checking their children.
	var contracts: List[CallContract] = []
	var failure: Option[CheckError] = None

	for application in body.applications:
		match classify_call(
			purity,
			application.callee,
			ReceiverCall,
			IntOps.add(application.arguments.length(), 1),
			scope,
			context,
		):
			Err(error):
				failure = Some(error)
				break
			Ok(FunctionApplication(contract)):
				contracts = contracts.append(contract)
			Ok(ConstructorApplication(name)):
				failure = Some(checker_invariant(name.span, ConstructorReceiver(name.id)))
				break

	ready ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	base_expectation = match contracts.get(0):
		Some(contract):
			match contract.type_parameters:
				NoTypeParameter:
					contract.parameter_types
						.get(0)
						.map(pure func(value: TypeUse): value.value_type)
				OneTypeParameter(_):
					None
		None:
			expected_type

	base_result: Result[ResolvedValue, CheckError] = match body.base:
		DirectApplication(name, arguments):
			classified ?= classify_call(
				purity,
				name,
				DirectCall,
				arguments.length(),
				scope,
				context,
			)

			match classified:
				ConstructorApplication(name):
					if IntOps.equals(arguments.length(), 0):
						constructor_base(
							name,
							base_expectation,
							True,
							context,
						).map(
							pure func(base: ResolvedBase) -> ResolvedValue: {
								value = {
									base = base.base,
									base_type = base.value_type,
									base_span = body.base_span,
									operations = []
								},
								value_type = base.value_type
							},
						)
					else:
						contract ?= unary_constructor(name, base_expectation, context)

						arity ?= if IntOps.equals(arguments.length(), 1):
							Ok(void)
						else:
							Err(
								check_rejection(
									name.span,
									match contract.operation:
										ConstructVariant(id):
											ConstructorPayloadArity(id, arguments.length())
										InvokeFunction(_, _):
											InternalInvariant(InvalidFunctionContract)
								),
							)

						resolved ?= resolve_arguments(
							purity,
							scope,
							arguments,
							None,
							contract,
							context,
						)

						value ?= match resolved.values.get(0):
							Some(value):
								Ok(value)
							None:
								Err(
									checker_invariant(
										name.span,
										MissingConstructorArgument(name.id),
									),
								)

						Ok({
							value = { value | operations = value.operations.append({
									operation = contract.operation,
									value_type = contract.return_type,
									span = name.span,
								}) },
							value_type = contract.return_type,
						})
				FunctionApplication(contract):
					resolved ?= resolve_arguments(purity, scope, arguments, None, contract, context)

					call ?= match resolved.contract.operation:
						InvokeFunction(call, _):
							Ok(call)
						_:
							Err(checker_invariant(name.span, InvalidFunctionContract))

					Ok({
						value = {
							base = ReturnCall(call, resolved.values),
							base_type = resolved.contract.return_type,
							base_span = body.base_span,
							operations = []
						},
						value_type = resolved.contract.return_type,
					})
		_:
			base ?= resolve_base(purity, scope, body.base, base_expectation, context)
			Ok({
				value = {
					base = base.base,
					base_type = base.value_type,
					base_span = body.base_span,
					operations = []
				},
				value_type = base.value_type,
			})

	base ?= base_result
	var current = base
	var index: Int = 0

	for application in body.applications:
		match contracts.get(index):
			None:
				failure = Some(
					checker_invariant(
						application.callee.span,
						MissingReceiverContract(index),
					),
				)
				break
			Some(contract):
				match resolve_receiver(
					purity,
					scope,
					current,
					application.arguments,
					contract,
					context,
				):
					Err(error):
						failure = Some(error)
						break
					Ok(value):
						current = value

		index = IntOps.add(index, 1)

	ready ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	Ok(current)


private pure func substitute_type(
	value_type: TypeRef,
	parameter: TypeParameterId,
	argument: TypeRef,
) -> TypeRef:
	match value_type:
		AppliedUnionType(owner, value):
			AppliedUnionType(
				owner,
				substitute_type(value, parameter, argument),
			)
		ParameterType(id):
			if same_parameter(id, parameter):
				argument
			else:
				value_type
		_:
			value_type


private pure func infer_type_argument(
	expected: TypeRef,
	actual: TypeRef,
	parameter: TypeParameterId,
) -> Option[TypeRef]:
	match expected:
		ParameterType(id):
			if same_parameter(id, parameter):
				Some(actual)
			else:
				None
		AppliedUnionType(owner, expected_argument):
			match actual:
				AppliedUnionType(actual_owner, actual_argument):
					if IntOps.equals(union_number(owner), union_number(actual_owner)):
						infer_type_argument(expected_argument, actual_argument, parameter)
					else:
						None
				_:
					None
		_:
			None


private pure func instantiate_contract(
	contract: CallContract,
	actual: List[TypeUse],
	context: ResolutionContext,
) -> Result[CallContract, CheckError]:
	match contract.type_parameters:
		NoTypeParameter:
			Ok(contract)
		OneTypeParameter(parameter):
			var inferred: Option[TypeUse] = None
			var index: Int = 0
			var failure: Option[CheckError] = None

			for value in actual:
				match contract.parameter_types.get(index):
					None:
						failure = Some(
							checker_invariant(
								contract.span,
								MissingGenericParameter(index),
							),
						)
						break
					Some(written):
						match infer_type_argument(written.value_type, value.value_type, parameter):
							None:
								void
							Some(argument):
								match inferred:
									None:
										inferred = Some({
											value_type = argument,
											span = value.span,
										})
									Some(previous):
										if not same_type(argument, previous.value_type):
											failure = Some(check_rejection(
												value.span,
												GenericArgumentConflict({
													parameter = parameter,
													previous = previous,
													current = {
														value_type = argument,
														span = value.span
													},
													mismatch = {
														expected = substitute_type(
															written.value_type,
															parameter,
															previous.value_type,
														),
														actual = value,
														argument_position = index,
														expected_site = parameter_site(
															contract,
															written,
														)
													},
												}),
											))
											break

				index = IntOps.add(index, 1)

			ready ?= match failure:
				Some(error):
					Err(error)
				None:
					Ok(void)

			argument ?= match inferred:
				Some(argument):
					Ok(argument)
				None:
					Err(check_rejection(contract.span, UninferableTypeParameter(parameter)))

			operation ?= match contract.operation:
				InvokeFunction(call, arguments):
					match call.target:
						UserFunction(id, _):
							Ok(
								InvokeFunction(
									{ call |
										target = UserFunction(
											id,
											InstantiateWith(argument.value_type),
										)
									},
									arguments,
								),
							)
						RuntimeFunction(_):
							Err(checker_invariant(contract.span, RuntimeGenericContract))
				ConstructVariant(_):
					Err(checker_invariant(contract.span, GenericConstructorContract))

			Ok({ contract |
					type_parameters = NoTypeParameter,
					operation = operation,
					parameter_types = contract.parameter_types.map(
						pure func(
							written: TypeUse,
						) -> TypeUse: { written |
							value_type = substitute_type(
								written.value_type,
								parameter,
								argument.value_type,
							)
						},
					),
					return_type = substitute_type(
						contract.return_type,
						parameter,
						argument.value_type,
					)
				})


private fixed record ResolvedPattern {
	pattern: CheckedPattern,
	scope: List[LocalBinding],
	binding: Option[BindingDefinition]
}


private pure func bound_pattern(
	name: WrittenName,
	type_ref: TypeRef,
	ordinal: Int,
	scope: List[LocalBinding],
	pattern: CheckedPattern,
) -> ResolvedPattern:
	{
		pattern = pattern,
		scope = [
			{
				name = name.id,
				id = into_opaque BindingId(ordinal),
				definition = {
					origin = MatchCapture,
					mutability = Immutable,
					value_type = type_ref,
					span = name.span
				}
			},
		].concat(scope),
		binding = Some({
			origin = MatchCapture,
			mutability = Immutable,
			value_type = type_ref,
			span = name.span,
		})
	}


private pure func resolve_variant_pattern(
	contract: VariantContract,
	fields: Option[FieldPattern],
	span: Span,
	ordinal: Int,
	scope: List[LocalBinding],
) -> Result[ResolvedPattern, CheckError]:
	match contract.payload:
		None:
			match fields:
				None:
					Ok({
						pattern = VariantCase(contract.variant, NoPayloadBinding),
						scope = scope,
						binding = None,
					})
				Some(_):
					Err(check_rejection(span, PatternUnexpectedField(contract.variant)))
		Some(payload):
			match fields:
				None:
					Err(
						check_rejection(
							span,
							PatternMissingField(contract.variant, payload.value_type),
						),
					)
				Some(field):
					match field:
						FieldWildcard(_):
							Ok({
								pattern = VariantCase(contract.variant, DiscardPayload),
								scope = scope,
								binding = None,
							})
						FieldName(name):
							Ok(
								bound_pattern(
									name,
									payload.value_type,
									ordinal,
									scope,
									VariantCase(
										contract.variant,
										BindPayload(into_opaque BindingId(ordinal)),
									),
								),
							)


private pure func resolve_pattern(
	pattern: ParsedPattern,
	union_type: TypeRef,
	ordinal: Int,
	scope: List[LocalBinding],
	context: ResolutionContext,
) -> Result[ResolvedPattern, CheckError]:
	match pattern:
		PatternWildcard(_):
			Ok({
				pattern = WildcardCase,
				scope = scope,
				binding = None,
			})
		PatternName(name):
			contract ?= if lookup_binding(scope, name.id).is_some():
				Ok(None)
			else:
				find_variant(context, union_type, name)

			match contract:
				Some(contract):
					resolve_variant_pattern(contract, None, name.span, ordinal, scope)
				None:
					Ok(
						bound_pattern(
							name,
							union_type,
							ordinal,
							scope,
							BindingCase(into_opaque BindingId(ordinal)),
						),
					)
		PatternConstructor(name, fields, span):
			contract ?= if lookup_binding(scope, name.id).is_some():
				Ok(None)
			else:
				find_variant(context, union_type, name)

			match contract:
				Some(contract):
					resolve_variant_pattern(contract, fields, span, ordinal, scope)
				None:
					Err(check_rejection(span, UnknownConstructorPattern(name.id, union_type)))


private pure func same_variant(left: VariantId, right: VariantId) -> Bool:
	(
		IntOps.equals(union_number(variant_owner(left)), union_number(variant_owner(right)))
		and IntOps.equals(variant_number(left), variant_number(right))
	)


private pure func remaining_after(
	pattern: CheckedPattern,
	remaining: List[VariantId],
	span: Span,
) -> Result[List[VariantId], CheckError]:
	var next: List[VariantId] = []
	var useful = False

	match pattern:
		VariantCase(id, _):
			for known in remaining:
				if same_variant(id, known):
					useful = True
				else:
					next = next.append(known)
		WildcardCase:
			useful = not IntOps.equals(remaining.length(), 0)
		BindingCase(_):
			useful = not IntOps.equals(remaining.length(), 0)

	if useful:
		Ok(next)
	else:
		Err(check_rejection(span, UnreachableArm))


private fixed record ResolvedMatch {
	body: CheckedMatch,
	bindings: List[BindingDefinition]
}


private pure func resolve_match(
	purity: Purity,
	return_type: TypeUse,
	scope: List[LocalBinding],
	body: ParsedMatch,
	bindings: List[BindingDefinition],
	context: ResolutionContext,
) -> Result[ResolvedMatch, CheckError]:
	scrutinee ?= resolve_value(purity, scope, body.scrutinee, None, context)

	owner_result: Result[UnionId, CheckError] = match scrutinee.value_type:
		AppliedUnionType(id, _):
			Ok(id)
		UnionType(id):
			Ok(id)
		IntType | StringType | ParameterType(_):
			Err(check_rejection(body.scrutinee.span, MatchRequiresUnion(scrutinee.value_type)))

	owner ?= owner_result

	declaration ?= match context.checked_unions.get(union_number(owner)):
		Some(declaration):
			Ok(declaration)
		None:
			Err(checker_invariant(body.keyword_span, InvalidCheckedUnion(owner)))

	var remaining: List[VariantId] = []
	var position: Int = 0

	for shape in declaration.variants:
		id: VariantId = into_opaque VariantId({
				owner = owner,
				position = position
			})
		remaining = remaining.append(id)
		position = IntOps.add(position, 1)

	var arms: List[CheckedArm] = []
	var failure: Option[CheckError] = None
	var definitions = bindings

	for arm in body.arms:
		match resolve_arm(
			purity,
			return_type,
			scrutinee.value_type,
			definitions,
			scope,
			arm,
			remaining,
			context,
		):
			Err(error):
				failure = Some(error)
				break
			Ok(resolved):
				arms = arms.append(resolved.arm)
				remaining = resolved.remaining

				definitions = resolved.bindings

	match failure:
		Some(error):
			Err(error)
		None:
			if IntOps.equals(remaining.length(), 0):
				Ok({
					body = {
						scrutinee = scrutinee.value,
						union_type = scrutinee.value_type,
						arms = arms
					},
					bindings = definitions,
				})
			else:
				Err(check_rejection(body.keyword_span, NonExhaustiveMatch(remaining)))


private fixed record ResolvedArm {
	arm: CheckedArm,
	remaining: List[VariantId],
	bindings: List[BindingDefinition]
}


private pure func resolve_arm(
	purity: Purity,
	return_type: TypeUse,
	union_type: TypeRef,
	bindings: List[BindingDefinition],
	scope: List[LocalBinding],
	arm: ParsedMatchArm,
	remaining: List[VariantId],
	context: ResolutionContext,
) -> Result[ResolvedArm, CheckError]:
	pattern ?= resolve_pattern(arm.pattern, union_type, bindings.length(), scope, context)
	remaining ?= remaining_after(pattern.pattern, remaining, pattern_span(arm.pattern))

	definitions = match pattern.binding:
		Some(definition):
			bindings.append(definition)
		None:
			bindings

	prefix ?= resolve_bindings(arm.bindings, purity, pattern.scope, definitions, context)
	value ?= resolve_value(purity, prefix.scope, arm.body, Some({
			value_type = return_type.value_type,
			site = SourceAnnotation(return_type.span),
		}), context)
	Ok({
		arm = {
			pattern = pattern.pattern,
			assignments = prefix.assignments,
			body = value.value
		},
		remaining = remaining,
		bindings = prefix.bindings,
	})


private pure func pattern_span(pattern: ParsedPattern) -> Span:
	match pattern:
		PatternName(name):
			name.span
		PatternWildcard(span):
			span
		PatternConstructor(_, _, span):
			span


private pure func function_scope(
	function: ParsedFunction,
	signature: FunctionSignature,
) -> Result[List[LocalBinding], CheckError]:
	var scope: List[LocalBinding] = []
	var index: Int = 0
	var failure: Option[CheckError] = None

	for parameter in function.parameters:
		match signature.parameters.get(index):
			None:
				failure = Some(
					checker_invariant(
						parameter.name.span,
						InvalidResolvedParameter(index),
					),
				)
				break
			Some(value_type):
				scope = scope.append({
					name = parameter.name.id,
					id = into_opaque BindingId(index),
					definition = {
						origin = ParameterBinding(index),
						mutability = Immutable,
						value_type = value_type.value_type,
						span = parameter.name.span
					},
				})

		index = IntOps.add(index, 1)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(scope)


private fixed record ResolvedBody {
	bindings: List[BindingDefinition],
	assignments: List[CheckedAssignment],
	body: CheckedBody
}


private fixed record ResolvedAssignment {
	assignment: CheckedAssignment,
	scope: List[LocalBinding],
	definition: Option[BindingDefinition]
}


private pure func resolve_assignment(
	written: ParsedBinding,
	purity: Purity,
	scope: List[LocalBinding],
	ordinal: Int,
	block_start: Int,
	context: ResolutionContext,
) -> Result[ResolvedAssignment, CheckError]:
	previous = lookup_binding(scope, written.name.id)
	empty: Option[LocalBinding] = None

	decision: Result[Option[LocalBinding], CheckError] = match written.mutability:
		MutableBinding:
			match previous:
				Some(binding):
					match binding.definition.origin:
						BodyLocal:
							if IntOps.greater_than_or_equal(
								binding_number(binding.id),
								block_start,
							):
								Err(
									check_rejection(
										written.name.span,
										DuplicateLocal(binding_site(context.function, binding)),
									),
								)
							else:
								Ok(empty)
						_:
							Ok(empty)
				None:
					Ok(empty)
		ImmutableBinding:
			match previous:
				Some(binding):
					match binding.definition.mutability:
						Mutable:
							Ok(Some(binding))
						Immutable:
							Err(
								check_rejection(
									written.name.span,
									ImmutableAssignment(binding_site(context.function, binding)),
								),
							)
				None:
					Ok(empty)

	reassign ?= decision
	value ?= resolve_value(
		purity,
		scope,
		written.initializer,
		reassign.map(pure func(binding: LocalBinding) -> ExpectedValue: {
				value_type = binding.definition.value_type,
				site = InferredBindingDeclaration(binding_site(context.function, binding))
			}),
		context,
	)

	match reassign:
		Some(binding):
			Ok({
				assignment = ReassignBinding(binding.id, value.value),
				scope = scope,
				definition = None,
			})
		None:
			mutability = match written.mutability:
				MutableBinding:
					Mutable
				ImmutableBinding:
					Immutable

			definition: BindingDefinition = {
				origin = BodyLocal,
				mutability = mutability,
				value_type = value.value_type,
				span = written.name.span
			}
			id = into_opaque BindingId(ordinal)
			Ok({
				assignment = InitializeBinding(id, value.value),
				scope = [
					{
						name = written.name.id,
						id = id,
						definition = definition
					},
				].concat(scope),
				definition = Some(definition),
			})


private fixed record ResolvedBindings {
	bindings: List[BindingDefinition],
	scope: List[LocalBinding],
	assignments: List[CheckedAssignment]
}


private pure func resolve_bindings(
	written_bindings: List[ParsedBinding],
	purity: Purity,
	initial: List[LocalBinding],
	bindings: List[BindingDefinition],
	context: ResolutionContext,
) -> Result[ResolvedBindings, CheckError]:
	var scope = initial
	var definitions = bindings
	var assignments: List[CheckedAssignment] = []
	var failure: Option[CheckError] = None

	-- Function-owned ordinals distinguish this block's declarations from outer
	-- bindings and the arm capture. Only explicit var may shadow those bindings.
	for written in written_bindings:
		match resolve_assignment(
			written,
			purity,
			scope,
			definitions.length(),
			bindings.length(),
			context,
		):
			Err(error):
				failure = Some(error)
				break
			Ok(resolved):
				assignments = assignments.append(resolved.assignment)
				scope = resolved.scope

				match resolved.definition:
					Some(definition):
						definitions = definitions.append(definition)
					None:
						void

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({
				bindings = definitions,
				scope = scope,
				assignments = assignments,
			})


private pure func resolve_body(
	function: ParsedFunction,
	signature: FunctionSignature,
	context: ResolutionContext,
) -> Result[ResolvedBody, CheckError]:
	initial ?= function_scope(function, signature)
	prefix ?= resolve_bindings(
		function.bindings,
		signature.purity,
		initial,
		initial.map(pure func(binding: LocalBinding) -> BindingDefinition: binding.definition),
		context,
	)

	match function.body:
		ParsedValueBody(body):
			value ?= resolve_value(signature.purity, prefix.scope, body, Some({
					value_type = signature.return_type.value_type,
					site = SourceAnnotation(signature.return_type.span),
				}), context)
			Ok({
				bindings = prefix.bindings,
				assignments = prefix.assignments,
				body = CheckedValueBody(value.value),
			})
		ParsedMatchBody(body):
			matched ?= resolve_match(
				signature.purity,
				signature.return_type,
				prefix.scope,
				body,
				prefix.bindings,
				context,
			)
			Ok({
				bindings = matched.bindings,
				assignments = prefix.assignments,
				body = CheckedMatchBody(matched.body),
			})


private pure func resolve_functions(
	parsed: ParsedContents,
	signatures: List[FunctionSignature],
	unions: List[CheckedUnion],
) -> Result[List[CheckedFunction], CheckError]:
	var functions: List[CheckedFunction] = []
	var failure: Option[CheckError] = None
	var index: Int = 0

	for function in parsed.functions:
		context: ResolutionContext = {
			function = into_opaque FunctionId(index),
			functions = parsed.functions,
			signatures = signatures,
			unions = parsed.unions,
			checked_unions = unions,
			prelude = parsed.prelude
		}

		match resolve_function(function, index, context):
			Err(error):
				failure = Some(error)
				break
			Ok(checked):
				functions = functions.append(checked)

		index = IntOps.add(index, 1)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(functions)


private pure func resolve_function(
	function: ParsedFunction,
	index: Int,
	context: ResolutionContext,
) -> Result[CheckedFunction, CheckError]:
	signature ?= match context.signatures.get(index):
		Some(signature):
			Ok(signature)
		None:
			Err(
				checker_invariant(
					function.function_name.span,
					InvalidResolvedFunction(context.function),
				),
			)

	body ?= resolve_body(function, signature, context)
	Ok({
		signature = signature,
		bindings = body.bindings,
		assignments = body.assignments,
		body = body.body,
	})


private pure func is_settled(id: FunctionId, settled: List[FunctionId]) -> Bool:
	var found: Bool = False

	for known in settled:
		if IntOps.equals(function_number(id), function_number(known)):
			found = True
			break

	found


private pure func target_is_settled(target: CallTarget, settled: List[FunctionId]) -> Bool:
	match target:
		UserFunction(id, _):
			is_settled(id, settled)
		RuntimeFunction(_):
			True


private pure func unsettled_value(body: CheckedValue, settled: List[FunctionId]) -> Option[Span]:
	var found: Option[Span] = match body.base:
		ReturnInteger(_):
			None
		ReturnVariant(_):
			None
		ReturnBinding(_):
			None
		ReturnCall(call, arguments):
			if target_is_settled(call.target, settled):
				None
			else:
				Some(call.span)

	children: List[CheckedValue] = match body.base:
		ReturnCall(_, arguments):
			arguments
		_:
			[]

	for child in children:
		if not found.is_some():
			found = unsettled_value(child, settled)

	for operation in body.operations:
		if found.is_some():
			break

		match operation.operation:
			InvokeFunction(call, arguments):
				for child in arguments:
					if not found.is_some():
						found = unsettled_value(child, settled)

				if not target_is_settled(call.target, settled):
					found = Some(call.span)
			ConstructVariant(_):
				void

	found


private pure func unsettled_assignments(
	assignments: List[CheckedAssignment],
	settled: List[FunctionId],
) -> Option[Span]:
	var found: Option[Span] = None

	for assignment in assignments:
		value = match assignment:
			InitializeBinding(_, value):
				value
			ReassignBinding(_, value):
				value

		found = unsettled_value(value, settled)

		if found.is_some():
			break

	found


private pure func unsettled_edge(
	function: CheckedFunction,
	settled: List[FunctionId],
) -> Option[Span]:
	match unsettled_assignments(function.assignments, settled):
		Some(span):
			Some(span)
		None:
			unsettled_body(function.body, settled)


private pure func unsettled_body(body: CheckedBody, settled: List[FunctionId]) -> Option[Span]:
	match body:
		CheckedValueBody(value):
			unsettled_value(value, settled)
		CheckedMatchBody(matched):
			var found = unsettled_value(matched.scrutinee, settled)

			for arm in matched.arms:
				if found.is_some():
					break

				found = unsettled_assignments(arm.assignments, settled)

				if not found.is_some():
					found = unsettled_value(arm.body, settled)

			found


private pure func validate_acyclic(functions: List[CheckedFunction]) -> Result[Void, CheckError]:
	-- Settle only functions whose complete base/wrapper callee set is settled.
	-- Every successful step adds a distinct identity; leftovers contain or reach
	-- a cycle. Repeating an acyclic callee inside one body does not form a cycle.
	var settled: List[FunctionId] = []
	var changed: Bool = True

	while changed:
		changed = False
		var index: Int = 0

		for function in functions:
			id = into_opaque FunctionId(index)

			if not is_settled(id, settled) and not unsettled_edge(function, settled).is_some():
				settled = settled.append(id)
				changed = True

			index = IntOps.add(index, 1)

	var failure: Option[CheckError] = None

	for function in functions:
		match unsettled_edge(function, settled):
			Some(span):
				failure = Some(check_rejection(span, RecursiveCallChain))
				break
			None:
				void

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)


private pure func validate_prelude_conflicts(
	functions: List[ParsedFunction],
	unions: List[ParsedUnion],
	prelude: CheckedPrelude,
) -> Result[Void, CheckError]:
	var failure: Option[CheckError] = None

	for function in functions:
		if runtime_operation(prelude, function.function_name.id).is_some():
			failure = Some(
				check_rejection(
					function.function_name.span,
					FunctionPreludeConflict(function.function_name.id),
				),
			)
			break

	if not failure.is_some():
		for declaration in unions:
			for variant in declaration.variants:
				if runtime_operation(prelude, variant.name.id).is_some():
					failure = Some(
						check_rejection(
							variant.name.span,
							VariantPreludeConflict(variant.name.id),
						),
					)
					break

			if failure.is_some():
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)


private pure func check_program(program: ParsedProgram) -> Result[CheckedProgram, CheckError]:
	parsed = parsed_contents(program)
	prelude = parsed.prelude
	special = prelude_names(prelude).special
	conflicts ?= validate_prelude_conflicts(parsed.functions, parsed.unions, prelude)
	unions ?= validate_unions(parsed.unions, parsed.functions, special)
	signatures ?= validate_signatures(parsed.functions, parsed.unions, parsed.end, special)
	functions ?= resolve_functions(parsed, signatures.functions, unions)
	acyclic ?= validate_acyclic(functions)
	Ok(into_opaque CheckedProgram({
				unions = unions,
				functions = functions,
				entrypoint = signatures.entrypoint
			}))


private pure func resolve_receiver(
	purity: Purity,
	scope: List[LocalBinding],
	current: ResolvedValue,
	arguments: List[ValueExpression],
	contract: CallContract,
	context: ResolutionContext,
) -> Result[ResolvedValue, CheckError]:
	resolved ?= resolve_arguments(purity, scope, arguments, Some(current), contract, context)

	operation ?= match resolved.contract.operation:
		InvokeFunction(call, _):
			Ok(InvokeFunction(call, resolved.values))
		_:
			Err(checker_invariant(contract.span, InvalidReceiverContract))

	Ok({
		value = { current.value | operations = current.value.operations.append({
				operation = operation,
				value_type = resolved.contract.return_type,
				span = contract.span,
			}) },
		value_type = resolved.contract.return_type,
	})


private pure func classify_call(
	purity: Purity,
	name: WrittenName,
	notation: CallNotation,
	arity: Int,
	scope: List[LocalBinding],
	context: ResolutionContext,
) -> Result[ResolvedApplication, CheckError]:
	local = match notation:
		DirectCall:
			lookup_binding(scope, name.id)
		ReceiverCall:
			None

	callable ?= match local:
		Some(binding):
			Err(non_callable(binding, name.span, context.function))
		None:
			Ok(void)

	match lookup_target(context.functions, context.prelude, name.id):
		Some(target):
			resolved ?= resolve_function_target(name, target, context.signatures)
			contract ?= function_contract(purity, name, notation, arity, resolved, context)
			Ok(FunctionApplication(contract))
		None:
			if contains_variant(context.unions, name.id):
				match notation:
					DirectCall:
						Ok(ConstructorApplication(name))
					ReceiverCall:
						Err(check_rejection(name.span, ConstructorUFCS(name.id)))
			else:
				Err(check_rejection(name.span, UnknownFunction(name.id)))


private pure func contains_parameter(value_type: TypeRef) -> Bool:
	match value_type:
		ParameterType(_):
			True
		AppliedUnionType(_, argument):
			contains_parameter(argument)
		_:
			False


private pure func resolve_value(
	purity: Purity,
	scope: List[LocalBinding],
	body: ValueExpression,
	expected_type: Option[ExpectedValue],
	context: ResolutionContext,
) -> Result[ResolvedValue, CheckError]:
	value ?= resolve_expression(
		purity,
		scope,
		body,
		expected_type.map(pure func(expected): expected.value_type),
		context,
	)

	accepted ?= match expected_type:
		None:
			Ok(void)
		Some(expected):
			if same_type(value.value_type, expected.value_type):
				Ok(void)
			else:
				Err(check_rejection(
					body.span,
					ExpressionTypeMismatch({
						expected = expected.value_type,
						actual = {
							value_type = value.value_type,
							span = body.span
						},
						expected_site = expected.site,
					}),
				))

	Ok(value)


pure func check(program: ParsedProgram) -> Result[CheckedProgram, CheckFailure]:
	match check_program(program):
		Ok(checked):
			Ok(checked)
		Err(error):
			Err(into_opaque CheckFailure({
						program = program,
						errors = {
							first = error,
							remaining = []
						}
					}))


pure func check_errors(failure: CheckFailure) -> CheckErrors:
	from_opaque CheckFailure(failure).errors


pure func render_failure(failure: CheckFailure) -> Diagnostics:
	contents = from_opaque CheckFailure(failure)
	render_check_errors(contents.program, contents.errors)


pure func render_check_errors(program: ParsedProgram, errors: CheckErrors) -> Diagnostics:
	var remaining: List[Diagnostic] = []

	for error in errors.remaining:
		remaining = remaining.append(render_check_error(program, error))

	{
		first = render_check_error(program, errors.first),
		remaining = remaining
	}


private pure func check_rejection(span: Span, kind: CheckErrorKind) -> CheckError:
	{
		span = span,
		kind = kind
	}


private pure func binding_site(function: FunctionId, binding: LocalBinding) -> BindingSite:
	{
		function = function,
		binding = binding.id,
		name = binding.name,
		span = binding.definition.span
	}


private pure func parameter_site(contract: CallContract, parameter: TypeUse) -> ExpectedTypeSite:
	match contract.operation:
		InvokeFunction(call, _):
			match call.target:
				RuntimeFunction(operation):
					RuntimeContract(operation)
				UserFunction(_, _):
					SourceAnnotation(parameter.span)
		ConstructVariant(_):
			SourceAnnotation(parameter.span)


private pure func non_callable(
	binding: LocalBinding,
	span: Span,
	function: FunctionId,
) -> CheckError:
	check_rejection(
		span,
		UncallableBinding(
			binding_site(function, binding),
			binding.definition.origin,
			binding.definition.value_type,
		),
	)


fixed union CheckerInvariant:
	InvalidResolvedFunction(FunctionId)
	InvalidUnionDeclaration(UnionId)
	VariantOccurrenceWithoutUnion(TypeRef)
	InvalidResolvedUnion(UnionId)
	InvalidCheckedUnion(UnionId)
	InvalidResolvedVariant(VariantId)
	InvalidParameterDeclaration(TypeParameterId)
	InvalidParameterName(TypeParameterId)
	ParameterOwnerWithoutParameter(TypeParameterId)
	InvalidParsedName(NameId)
	DirectCallInSimpleBase(NameId)
	MissingCallParameter(Int)
	ConstructorReceiver(NameId)
	MissingConstructorArgument(NameId)
	InvalidFunctionContract
	MissingReceiverContract(Int)
	MissingGenericParameter(Int)
	RuntimeGenericContract
	GenericConstructorContract
	InvalidResolvedParameter(Int)
	InvalidReceiverContract
	InvalidCallName(NameId)


private pure func invariant_message(invariant: CheckerInvariant) -> String:
	match invariant:
		InvalidResolvedFunction(_):
			"invalid resolved function identity"
		InvalidUnionDeclaration(_):
			"invalid union declaration"
		VariantOccurrenceWithoutUnion(_):
			"variant occurrence has no union type"
		InvalidResolvedUnion(_):
			"invalid resolved union identity"
		InvalidCheckedUnion(_):
			"invalid checked union identity"
		InvalidResolvedVariant(_):
			"invalid resolved variant identity"
		InvalidParameterDeclaration(_):
			"invalid parameter declaration"
		InvalidParameterName(_):
			"invalid parameter name"
		ParameterOwnerWithoutParameter(_):
			"parameter owner has no parameter"
		InvalidParsedName(_):
			"invalid parsed name identity"
		DirectCallInSimpleBase(_):
			"call reached simple base checking"
		MissingCallParameter(_):
			"missing call parameter"
		ConstructorReceiver(_):
			"constructor receiver passed resolution"
		MissingConstructorArgument(_):
			"missing constructor argument"
		InvalidFunctionContract:
			"invalid function contract"
		MissingReceiverContract(_):
			"missing receiver contract"
		MissingGenericParameter(_):
			"missing generic parameter"
		RuntimeGenericContract:
			"runtime call has a type parameter"
		GenericConstructorContract:
			"generic constructor contract"
		InvalidResolvedParameter(_):
			"invalid resolved parameter"
		InvalidReceiverContract:
			"invalid receiver contract"
		InvalidCallName(_):
			"invalid call name identity"


private pure func rendered(span: Span, message: String, help: String) -> Diagnostic:
	{
		span = span,
		note = None,
		message = message,
		help = help
	}


private pure func render_fault(span: Span, invariant: CheckerInvariant) -> Diagnostic:
	rendered(
		span,
		invariant_message(invariant),
		"report this compiler error with the input program",
	)


private pure func builtin_spelling(
	name: NameId,
	context: ParsedContents,
	span: Span,
) -> Result[String, Diagnostic]:
	name_spelling(context.names, name).to_result(render_fault(span, InvalidParsedName(name)))


pure func render_check_error(program: ParsedProgram, error: CheckError) -> Diagnostic:
	render_error(error, parsed_contents(program))


private pure func render_error(error: CheckError, context: ParsedContents) -> Diagnostic:
	match error.kind:
		DuplicateVariant(_, _):
			rendered(
				error.span,
				"duplicate variant name",
				"give each variant in a union a distinct name",
			)
		VariantFunctionConflict(_, _, _):
			rendered(
				error.span,
				"variant name conflicts with a function",
				"give functions and union variants distinct names",
			)
		DuplicateUnion(_, _):
			rendered(
				error.span,
				"duplicate union type name",
				"give union types distinct names; Int and String are declared by the prelude",
			)
		TypeParameterTypeNameConflict(_):
			rendered(
				error.span,
				"type parameter conflicts with a type name",
				"choose a distinct type parameter name, such as T",
			)
		GenericMain(_):
			rendered(
				error.span,
				"main cannot be generic",
				"declare main() -> Int: without type parameters",
			)
		MissingUnionTypeArguments(_):
			rendered(
				error.span,
				"generic union requires one type argument",
				"write a concrete or symbolic application, such as Box[Int] or Box[T]",
			)
		UnknownType(_):
			rendered(
				error.span,
				"unknown type",
				"use Int, String, a declared type parameter, or a fixed union declared in this ".concat(
					"file",
				),
			)
		NonApplicableType(_):
			rendered(
				error.span,
				"type does not accept a type argument",
				"apply a declared generic union, such as Box[Int]",
			)
		OrdinaryUnionApplied(_):
			rendered(
				error.span,
				"ordinary union does not accept a type argument",
				"remove the type argument from this union type",
			)
		MainHasParameters(_):
			rendered(
				error.span,
				"main cannot have a parameter",
				"declare main() -> Int: with no parameters",
			)
		DuplicateParameter(_, _):
			rendered(error.span, "duplicate parameter name", "give each parameter a distinct name")
		MainReturnType(_):
			rendered(error.span, "main must return Int", "declare main() -> Int: as the entrypoint")
		DuplicateFunction(_, _):
			rendered(error.span, "duplicate function name", "give every function a distinct name")
		MissingMain:
			rendered(
				error.span,
				"expected a main function",
				"declare func main() -> Int: as the entrypoint",
			)
		ImpureCall(_, _):
			rendered(
				error.span,
				"pure functions cannot call impure functions",
				"mark the callee pure or remove pure from the caller",
			)
		ConstructorNeedsExpectedType(_):
			rendered(
				error.span,
				"constructor needs an expected union type",
				"pass an already-typed union value or call a concrete helper returning the union",
			)
		PayloadFreeVariantCalled(_):
			rendered(
				error.span,
				"payload-free variants cannot be called",
				"use the bare variant name without parentheses",
			)
		UnknownValue(_):
			rendered(
				error.span,
				"unknown value",
				"use this function's parameter name, a declared variant, or a call",
			)
		ConstructorPayloadArity(_, _):
			rendered(
				error.span,
				"constructor requires one payload argument",
				"pass exactly one expression of the declared payload type",
			)
		PatternUnexpectedField(_):
			rendered(
				error.span,
				"constructor pattern takes no fields",
				"use the bare variant name or Variant() without field patterns",
			)
		UnknownConstructorPattern(_, _):
			rendered(
				error.span,
				"unknown constructor pattern",
				"use an unshadowed variant of the matched union; rename a shadowing local binding",
			)
		UnreachableArm:
			rendered(
				error.span,
				"match arm is unreachable",
				"remove this arm; earlier arms already cover all values it could match",
			)
		MatchRequiresUnion(_):
			rendered(
				error.span,
				"match requires a union value",
				"match a typed union parameter or a call returning a declared union",
			)
		DuplicateLocal(_):
			rendered(
				error.span,
				"duplicate local binding",
				Text.concat(
					"give each body-local declaration a distinct name; ",
					"omit var to reassign a mutable binding",
				),
			)
		ImmutableAssignment(_):
			rendered(
				error.span,
				"cannot assign to an immutable binding",
				"declare the binding with var to allow reassignment",
			)
		RecursiveCallChain:
			rendered(
				error.span,
				"call chain contains recursion",
				"use an acyclic call chain; recursion is not supported in this increment",
			)
		FunctionPreludeConflict(_):
			rendered(
				error.span,
				"function name conflicts with the prelude",
				"rename this function or change the explicit prelude declaration",
			)
		VariantPreludeConflict(_):
			rendered(
				error.span,
				"variant name conflicts with a prelude function",
				"give functions and union variants distinct names",
			)
		ConstructorUFCS(_):
			rendered(
				error.span,
				"constructors do not support UFCS in this increment",
				"write the constructor directly, such as Number(value)",
			)
		UnknownFunction(_):
			rendered(
				error.span,
				"unknown function",
				"declare the called function in this file or the explicit prelude",
			)
		ArgumentTypeMismatch(mismatch):
			type_diagnostic(
				error.span,
				"argument type does not match the parameter type",
				mismatch.expected,
				context,
			)
		GenericArgumentConflict(conflict):
			type_diagnostic(
				error.span,
				"argument type does not match the parameter type",
				conflict.mismatch.expected,
				context,
			)
		ExpressionTypeMismatch(mismatch):
			type_diagnostic(
				error.span,
				"expression does not match the expected type",
				mismatch.expected,
				context,
			)
		VariantNotInExpectedType(_, expected):
			type_diagnostic(
				error.span,
				"variant does not belong to the expected type",
				expected,
				context,
			)
		UnsupportedPayloadAnnotation(_, rule):
			match rule:
				IntegerPayload:
					rendered(
						error.span,
						"only Int payloads are supported",
						"declare a variant with no fields or one Int field, written Variant(Int)",
					)
				IntegerOrParameterPayload:
					rendered(
						error.span,
						"only Int or the union's type parameter may be payloads",
						(
							"declare no field, one Int field, or one field using this union's declared type "
							+ "parameter"
						),
					)
		UncallableBinding(_, origin, value_type):
			match origin:
				ParameterBinding(_):
					message = if same_type(value_type, IntType):
						"Int parameters cannot be called"
					else:
						"parameters cannot be called"

					rendered(
						error.span,
						message,
						"use the parameter as a value, or rename it to call the function",
					)
				MatchCapture:
					rendered(
						error.span,
						"match bindings cannot be called",
						"use the binding as a value, or rename it to call the function",
					)
				BodyLocal:
					rendered(
						error.span,
						"local bindings cannot be called",
						"use the binding as a value, or rename it to call the function",
					)
		ArgumentCountMismatch(arity):
			if IntOps.equals(arity.expected, 0):
				match arity.notation:
					DirectCall:
						rendered(
							error.span,
							"function takes no arguments",
							"remove the argument and call the function with ()",
						)
					ReceiverCall:
						match name_spelling(context.names, arity.callee):
							Some(name):
								rendered(
									error.span,
									"function takes no arguments",
									Text
										.concat("call ", name)
										.concat(
											"() directly, or choose a function with one parameter",
										),
								)
							None:
								render_fault(error.span, InvalidCallName(arity.callee))
			else if IntOps.equals(arity.expected, 1):
				rendered(
					error.span,
					"function requires one argument",
					"pass one expression of the declared parameter type",
				)
			else:
				rendered(
					error.span,
					"argument count does not match the function parameters",
					(
						"pass one expression for each declared parameter; UFCS supplies the receiver "
						+ "first"
					),
				)
		MissingConstructorPayload(_, payload):
			if same_type(payload, IntType):
				rendered(
					error.span,
					"constructor requires one Int argument",
					"pass one Int expression, such as Number(42)",
				)
			else:
				rendered(
					error.span,
					"constructor requires one payload argument",
					"pass a value of the constructor's declared payload type",
				)
		PatternMissingField(_, payload):
			help = if same_type(payload, IntType):
				"write Variant(name) to bind the Int field, or Variant(_) to ignore it"
			else:
				"write Variant(name) to bind the payload, or Variant(_) to ignore it"

			rendered(error.span, "constructor pattern requires one field", help)
		UninferableTypeParameter(_):
			rendered(
				error.span,
				"cannot infer the type parameter from the argument",
				(
					"pass a value whose type determines the declared type parameter; use a concrete "
					+ "helper when no argument can determine it"
				),
			)
		NonExhaustiveMatch(missing):
			missing_coverage(missing, error.span, context)
		InternalInvariant(invariant):
			render_fault(error.span, invariant)


private pure func parameter_spelling(
	id: TypeParameterId,
	context: ParsedContents,
	span: Span,
) -> Result[String, Diagnostic]:
	written ?= match parameter_owner(id):
		FunctionDeclaration(id):
			context.functions
				.get(function_number(id))
				.map(pure func(declaration): declaration.type_parameters)
				.to_result(
					render_fault(
						span,
						InvalidParameterDeclaration(
							into_opaque TypeParameterId(FunctionDeclaration(id)),
						),
					),
				)
		UnionDeclaration(id):
			context.unions
				.get(union_number(id))
				.map(pure func(declaration): declaration.type_parameters)
				.to_result(
					render_fault(
						span,
						InvalidParameterDeclaration(
							into_opaque TypeParameterId(UnionDeclaration(id)),
						),
					),
				)

	match written:
		OneTypeParameterSyntax(name):
			name_spelling(
				context.names,
				name.id,
			).to_result(render_fault(span, InvalidParameterName(id)))
		NoTypeParameterSyntax:
			Err(render_fault(span, ParameterOwnerWithoutParameter(id)))


private pure func type_spelling(
	value: TypeRef,
	context: ParsedContents,
	span: Span,
) -> Result[String, Diagnostic]:
	match value:
		IntType:
			builtin_spelling(prelude_names(context.prelude).special.integer, context, span)
		StringType:
			builtin_spelling(prelude_names(context.prelude).special.string, context, span)
		ParameterType(id):
			parameter_spelling(id, context, span)
		UnionType(id):
			declaration ?= context.unions
				.get(union_number(id))
				.to_result(render_fault(span, InvalidResolvedUnion(id)))
			name_spelling(
				context.names,
				declaration.type_name.id,
			).to_result(render_fault(span, InvalidParsedName(declaration.type_name.id)))
		AppliedUnionType(id, argument):
			name ?= type_spelling(UnionType(id), context, span)
			argument ?= type_spelling(argument, context, span)
			Ok(
				name
					.concat("[")
					.concat(argument)
					.concat("]"),
			)


private pure func missing_variant_name(
	id: VariantId,
	span: Span,
	context: ParsedContents,
) -> Result[String, Diagnostic]:
	declaration ?= context.unions
		.get(union_number(variant_owner(id)))
		.to_result(render_fault(span, InvalidResolvedUnion(variant_owner(id))))
	variant ?= declaration.variants
		.get(variant_number(id))
		.to_result(render_fault(span, InvalidResolvedVariant(id)))
	name ?= name_spelling(
		context.names,
		variant.name.id,
	).to_result(render_fault(span, InvalidParsedName(variant.name.id)))

	match variant.payload:
		None:
			Ok(name)
		Some(_):
			Ok(name.concat("(_)"))


private pure func missing_coverage(
	remaining: List[VariantId],
	span: Span,
	context: ParsedContents,
) -> Diagnostic:
	var names: String = ""
	var failure: Option[Diagnostic] = None

	for id in remaining:
		match missing_variant_name(id, span, context):
			Err(error):
				failure = Some(error)
				break
			Ok(name):
				if not IntOps.equals(names.length(), 0):
					names = names.concat(", ")

				names = names.concat(name)

	match failure:
		Some(error):
			error
		None:
			prefix = if IntOps.equals(remaining.length(), 1):
				"add an arm for the missing variant: "
			else:
				"add arms for the missing variants: "

			rendered(
				span,
				"non-exhaustive match",
				Text.concat(prefix, names),
			)


private pure func type_diagnostic(
	span: Span,
	message: String,
	expected_type: TypeRef,
	context: ParsedContents,
) -> Diagnostic:
	match expected_type:
		ParameterType(_):
			rendered(
				span,
				message,
				"use a value already typed as this declaration's type parameter",
			)
		_:
			match type_spelling(expected_type, context, span):
				Err(error):
					error
				Ok(spelling):
					rendered(
						span,
						message,
						"use an expression of type "
							.concat(spelling)
							.concat(" here"),
					)


private pure func checker_invariant(span: Span, invariant: CheckerInvariant) -> CheckError:
	check_rejection(span, InternalInvariant(invariant))


private pure func previous_declaration(
	previous: List[WrittenName],
	name: NameId,
) -> Option[WrittenName]:
	var found: Option[WrittenName] = None

	for known in previous:
		if same_name(known.id, name):
			found = Some(known)
			break

	found
