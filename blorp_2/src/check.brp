---
Checking's public boundary: composes the phases in order and seals either a
CheckedProgram or a CheckFailure carrying the first error.
---
import:
	./builtins: check_builtin_types
	./check_bodies: resolve_functions
	./check_errors: BuiltinError(BuiltinTypesRejected), CheckError, CheckErrors, builtin_error
	./check_imports: validate_imports
	./check_methods: build_callables
	./check_model: CheckedFunctions
	./check_recursion: validate_recursive_instantiation
	./check_signatures: validate_signatures
	./check_types: validate_declarations, validate_finite_declarations
	declarations: FunctionId, RecordId, UnionId, function_id, record_id, union_id
	namespace: build_namespace
	assemble: ParsedProgram, parsed_contents


opaque type CheckedProgram = CheckedFunctions


pure func checked_functions(program: CheckedProgram) -> CheckedFunctions:
	from_opaque CheckedProgram(program)


-- The identity of the function at a declaration position, when one exists.
pure func declaration_id(program: CheckedProgram, position: Int) -> Option[FunctionId]:
	match from_opaque CheckedProgram(program).functions.get(position):
		Some(_):
			Some(function_id(position))
		None:
			None


-- The identity of the record at a declaration position, when one exists.
pure func record_declaration_id(program: CheckedProgram, position: Int) -> Option[RecordId]:
	match from_opaque CheckedProgram(program).records.get(position):
		Some(_): Some(record_id(position))
		None: None


-- The identity of the union at a declaration position, when one exists.
pure func union_declaration_id(program: CheckedProgram, position: Int) -> Option[UnionId]:
	match from_opaque CheckedProgram(program).unions.get(position):
		Some(_):
			Some(union_id(position))
		None:
			None


private fixed record FailureContents {
	program: ParsedProgram,
	errors: CheckErrors
}


opaque type CheckFailure = FailureContents


private pure func check_program(program: ParsedProgram) -> Result[CheckedProgram, CheckError]:
	parsed = parsed_contents(program)

	builtins ?= match check_builtin_types(program):
		Ok(_):
			Ok(void)
		Err(error):
			Err(builtin_error(error.span, BuiltinTypesRejected(error)))

	namespace = build_namespace(program)
	imports ?= validate_imports(parsed, namespace)
	declarations ?= validate_declarations(parsed, namespace)
	admission ?= validate_finite_declarations(declarations)
	signatures ?= validate_signatures(parsed, namespace, declarations.unions, admission)
	callables = build_callables(namespace, signatures.functions)
	functions ?= resolve_functions(signatures.functions, declarations, namespace, callables, admission)
	finite ?= validate_recursive_instantiation(functions)
	Ok(into_opaque CheckedProgram({
				unions = declarations.unions,
				records = declarations.records,
				functions = functions,
				entrypoint = signatures.entrypoint
			}))


pure func check(program: ParsedProgram) -> Result[CheckedProgram, CheckFailure]:
	match check_program(program):
		Ok(checked):
			Ok(checked)
		Err(error):
			Err(into_opaque CheckFailure({
						program = program,
						errors = {
							first = error,
							remaining = []
						}
					}))


pure func check_errors(failure: CheckFailure) -> CheckErrors:
	from_opaque CheckFailure(failure).errors


pure func failure_program(failure: CheckFailure) -> ParsedProgram:
	from_opaque CheckFailure(failure).program
