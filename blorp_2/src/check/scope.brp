import:
	./errors: BindingSite, CheckError, BindingError(ModuleBindingConflict, LocalBindingConflict), binding_error
	./model: BindingDefinition, BindingId
	../namespace/namespace: Namespace, value_binding
	../utils/ids: FunctionId
	../utils/names: NameId, same_name
	../utils/source: ModuleId
	../utils/syntax: WrittenName


-- Only bind_local publishes a binding; later readers receive accepted facts.
opaque type LocalBinding = ScopedBinding


private fixed record ScopedBinding {
	name: NameId,
	id: BindingId,
	definition: BindingDefinition
}


pure func lookup_binding(scope: List[LocalBinding], name: NameId) -> Option[LocalBinding]:
	var found: Option[LocalBinding] = None

	for binding in scope:
		if same_name(from_opaque LocalBinding(binding).name, name):
			found = Some(binding)
			break

	found


pure func local_binding_id(binding: LocalBinding) -> BindingId:
	from_opaque LocalBinding(binding).id


pure func binding_definition(binding: LocalBinding) -> BindingDefinition:
	from_opaque LocalBinding(binding).definition


pure func binding_site(function: FunctionId, binding: LocalBinding) -> BindingSite:
	accepted = from_opaque LocalBinding(binding)
	{
		function = function,
		binding = accepted.id,
		name = accepted.name,
		span = accepted.definition.span
	}


pure func bind_local(
	scope: List[LocalBinding], namespace: Namespace, module: ModuleId,
	function: FunctionId, name: WrittenName, id: BindingId, definition: BindingDefinition,
) -> Result[LocalBinding, CheckError]:
	match value_binding(namespace, module, name.id):
		Some(previous): Err(binding_error(name.span, ModuleBindingConflict(previous)))
		None:
			match lookup_binding(scope, name.id):
				Some(previous): Err(binding_error(name.span, LocalBindingConflict(binding_site(function, previous), binding_definition(previous).origin)))
				None: Ok(into_opaque LocalBinding({ name = name.id, id = id, definition = definition }))
