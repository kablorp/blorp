import:
	./errors: BindingSite, CheckError, BindingError(ModuleBindingConflict, LocalBindingConflict, CallableBindingConflict), binding_error
	./model: BindingDefinition, BindingId, BodyOwner, ScopedBindingId, CallableParameterId, TypeRef, TypeUse
	../namespace/namespace: Namespace, value_binding
	../utils/names: NameId, same_name
	../utils/source: ModuleId
	../utils/syntax: Span, WrittenName


-- Only bind_local publishes a binding; later readers receive accepted facts.
opaque type LocalBinding = ScopedBinding


private fixed record ScopedBinding {
	name: NameId,
	id: ScopedBindingId,
	definition: BindingDefinition
}


fixed union ScopedValue:
	DataLocal(LocalBinding)
	CallableLocal(CallableBinding)


pure func lookup_binding(scope: List[ScopedValue], name: NameId) -> Option[ScopedValue]:
	var found: Option[ScopedValue] = None

	for binding in scope:
		binding_name = match binding:
			DataLocal(data): from_opaque LocalBinding(data).name
			CallableLocal(callable): callable_binding_name(callable).id
		if same_name(binding_name, name):
			found = Some(binding)
			break

	found


pure func local_binding_id(binding: LocalBinding) -> BindingId:
	from_opaque LocalBinding(binding).id.binding


pure func binding_definition(binding: LocalBinding) -> BindingDefinition:
	from_opaque LocalBinding(binding).definition


pure func binding_site(binding: LocalBinding) -> BindingSite:
	accepted = from_opaque LocalBinding(binding)
	{
		binding = accepted.id,
		name = accepted.name,
		span = accepted.definition.span
	}


pure func bind_local(
	scope: List[ScopedValue], namespace: Namespace, module: ModuleId,
	owner: BodyOwner, name: WrittenName, id: BindingId, definition: BindingDefinition,
) -> Result[ScopedValue, CheckError]:
	match value_binding(namespace, module, name.id):
		Some(previous): Err(binding_error(name.span, ModuleBindingConflict(previous)))
		None:
			match lookup_binding(scope, name.id):
				Some(DataLocal(previous)):
					Err(binding_error(name.span, LocalBindingConflict(
						binding_site(previous), binding_definition(previous).origin,
					)))
				Some(CallableLocal(previous)):
					Err(binding_error(name.span, CallableBindingConflict(
						callable_binding_id(previous), callable_binding_name(previous).span,
					)))
				None:
					Ok(DataLocal(into_opaque LocalBinding({
						name = name.id,
						id = { owner = owner, binding = id },
						definition = definition
					})))


pure func bind_callable(
	scope: List[ScopedValue],
	namespace: Namespace,
	module: ModuleId,
	name: WrittenName,
	id: CallableParameterId,
	parameters: List[TypeRef],
	result: TypeRef,
	annotation: Span,
) -> Result[ScopedValue, CheckError]:
	match value_binding(namespace, module, name.id):
		Some(previous): Err(binding_error(name.span, ModuleBindingConflict(previous)))
		None:
			match lookup_binding(scope, name.id):
				Some(DataLocal(previous)):
					Err(binding_error(name.span, LocalBindingConflict(
						binding_site(previous), binding_definition(previous).origin,
					)))
				Some(CallableLocal(previous)):
					Err(binding_error(name.span, CallableBindingConflict(
						callable_binding_id(previous), callable_binding_name(previous).span,
					)))
				None:
					Ok(CallableLocal(into_opaque CallableBinding({
						name = name,
						id = id,
						parameters = parameters.map(pure func(value): { value_type = value, span = annotation }),
						return_type = { value_type = result, span = annotation }
					})))


private fixed record ScopedCallable {
	name: WrittenName,
	id: CallableParameterId,
	parameters: List[TypeUse],
	return_type: TypeUse
}
opaque type CallableBinding = ScopedCallable


pure func callable_binding_id(binding: CallableBinding) -> CallableParameterId:
	from_opaque CallableBinding(binding).id


pure func callable_binding_name(binding: CallableBinding) -> WrittenName:
	from_opaque CallableBinding(binding).name


pure func callable_parameters(binding: CallableBinding) -> List[TypeUse]:
	from_opaque CallableBinding(binding).parameters


pure func callable_return_type(binding: CallableBinding) -> TypeUse:
	from_opaque CallableBinding(binding).return_type
