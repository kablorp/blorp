---
Receiver functions UFCS may select after signatures are accepted, chosen by
receiver type and argument count, and the call contracts that prove arity and
purity. Accepted-type matching supports method selection: Inference,
start_inference, inferred_substitution and infer_arguments match a callee's type
arguments against accepted receiver types. Expression-local inference and
publication belong to inference; direct-call visibility belongs to namespace.
---
import:
	./errors:
		ArgumentMismatch,
		CallError(ArgumentCountMismatch, GenericArgumentConflict, ImpureCall, UnknownFunction),
		CheckError,
		CheckerInvariant(InvalidParameterDeclaration, InvalidResolvedFunction),
		call_error,
		checker_invariant,
		ExpectedTypeSite(SourceAnnotation),
		MethodCandidateSite,
		MethodError(AmbiguousMethod, ConstructorUFCS, MethodArgumentCounts, NoApplicableMethod),
		method_error
	./model:
		FunctionSignature,
		TypeParameterId,
		TypeParameterOwner(FunctionDeclaration),
		TypeRef(AppliedUnionType, AppliedRecordType, ListType, ParameterType),
		TypeUse,
		parameter_owner,
		parameter_position,
		same_owner,
		same_type,
		type_parameter_id,
		CheckedRecord,
		CheckedUnion,
		type_head
	./signatures: AcceptedFunction
	./declarations: Substitution, substitute_type
	../utils/ids: FunctionId, function_number, record_number, union_number
	../utils/syntax:
		CallNotation(DirectCall, ReceiverCall),
		Purity(Impure, Pure),
		Span,
		ValueExpression,
		WrittenName,
		same_purity,
		ReceiverApplication
	../utils/names: NameId, same_name
	../namespace/namespace:
		FunctionOrigin(LocalFunction, ImportedFunction),
		Namespace,
		function_candidate,
		exported_functions,
		imported_functions,
		method_selection_requests,
		same_type_candidate,
		variant_candidates
	../utils/source: ModuleId, same_module
	int as IntOps
	option: to_result, is_some
	list: contains
	result: and_then


-- The function whose body contains a call.
fixed record Caller {
	function: FunctionId,
	purity: Purity
}


-- One explicit argument and the parameter it must satisfy.
fixed record ArgumentSlot {
	parameter: TypeUse,
	argument: ValueExpression
}


-- A resolved call before its arguments are checked: the callee, its one
-- published signature and each explicit argument paired with its parameter.
-- Pairing every argument is the arity proof; purity is proved with it.
fixed record FunctionContract {
	function: FunctionId,
	signature: FunctionSignature,
	arguments: List[ArgumentSlot],
	span: Span
}


-- A UFCS call's contract: the parameter its receiver satisfies, then the call.
fixed record ReceiverContract {
	receiver: TypeUse,
	call: FunctionContract
}


pure func function_contract(
	caller: Caller,
	name: WrittenName,
	arguments: List[ValueExpression],
	callee: FunctionId,
	signatures: List[AcceptedFunction],
) -> Result[FunctionContract, CheckError]:
	signature ?= callee_signature(name, callee, signatures)
	arity = arity_mismatch(name, DirectCall, arguments.length(), callee, signature)
	slots ?= paired_arguments(signature.parameters, arguments, []).to_result(arity)
	pure_call ?= validate_purity(caller, name, callee, signature)
	Ok({
		function = callee,
		signature = signature,
		arguments = slots,
		span = name.span,
	})


pure func receiver_contract(
	caller: Caller,
	name: WrittenName,
	arguments: List[ValueExpression],
	callee: FunctionId,
	signatures: List[AcceptedFunction],
) -> Result[ReceiverContract, CheckError]:
	signature ?= callee_signature(name, callee, signatures)
	arity = arity_mismatch(
		name,
		ReceiverCall,
		IntOps.add(arguments.length(), 1),
		callee,
		signature,
	)

	match signature.parameters:
		[]:
			Err(arity)
		[receiver, ...parameters]:
			slots ?= paired_arguments(parameters, arguments, []).to_result(arity)
			pure_call ?= validate_purity(caller, name, callee, signature)
			Ok({
				receiver = receiver,
				call = {
					function = callee,
					signature = signature,
					arguments = slots,
					span = name.span
				},
			})


private pure func callee_signature(
	name: WrittenName,
	callee: FunctionId,
	signatures: List[AcceptedFunction],
) -> Result[FunctionSignature, CheckError]:
	accepted ?= signatures
		.get(function_number(callee))
		.to_result(checker_invariant(name.span, InvalidResolvedFunction(callee)))
	Ok(accepted.signature)


private pure func arity_mismatch(
	name: WrittenName,
	notation: CallNotation,
	arity: Int,
	callee: FunctionId,
	signature: FunctionSignature,
) -> CheckError:
	call_error(name.span, ArgumentCountMismatch({
			callee = name.id,
			expected = signature.parameters.length(),
			actual = arity,
			notation = notation,
			function = callee,
		}))


private pure func validate_purity(
	caller: Caller,
	name: WrittenName,
	callee: FunctionId,
	signature: FunctionSignature,
) -> Result[Void, CheckError]:
	if same_purity(caller.purity, Pure) and same_purity(signature.purity, Impure):
		Err(call_error(name.span, ImpureCall(caller.function, callee)))
	else:
		Ok(void)


-- Pairs explicit arguments with parameters in order; None when the counts differ.
private pure func paired_arguments(
	parameters: List[TypeUse],
	arguments: List[ValueExpression],
	slots: List[ArgumentSlot],
) -> Option[List[ArgumentSlot]]:
	match parameters:
		[]:
			if arguments.is_empty():
				Some(slots)
			else:
				None
		[parameter, ...rest]:
			match arguments:
				[]:
					None
				[argument, ...others]:
					paired_arguments(
						rest,
						others,
						slots.append({
							parameter = parameter,
							argument = argument,
						}),
					)


-- Argument types inferred so far for one callee's rigid type parameters,
-- indexed by declaration position.
fixed record Inference {
	owner: TypeParameterOwner,
	inferred: List[Option[TypeUse]]
}


pure func start_inference(
	owner: TypeParameterOwner,
	parameters: List[TypeParameterId],
) -> Inference:
	var inferred: List[Option[TypeUse]] = []

	for _ in parameters:
		inferred = inferred.append(None)

	{
		owner = owner,
		inferred = inferred
	}


-- The substitution inferred so far; an uninferred parameter stays rigid.
pure func inferred_substitution(inference: Inference) -> Substitution:
	var values: List[TypeRef] = []

	for slot in inference.inferred:
		value = match slot:
			Some(inferred):
				inferred.value_type
			None:
				ParameterType(type_parameter_id(inference.owner, values.length()))

		values = values.append(value)

	{
		owner = inference.owner,
		values = values
	}


-- One-way structural matching of an expected parameter type against an actual
-- argument type, recording each rigid parameter's first inferred argument.
pure func infer_arguments(
	expected: TypeRef,
	actual: TypeRef,
	inference: Inference,
	obligation: ArgumentMismatch,
) -> Result[Inference, CheckError]:
	match expected:
		ListType(element):
			match actual:
				ListType(actual):
					infer_arguments(element, actual, inference, obligation)
				_:
					Ok(inference)
		ParameterType(parameter):
			constrain_argument(inference, parameter, actual, obligation)
		AppliedRecordType(owner, expected_arguments):
			match actual:
				AppliedRecordType(actual_owner, actual_arguments):
					if (
						IntOps.equals(record_number(owner), record_number(actual_owner))
						and IntOps.equals(expected_arguments.length(), actual_arguments.length())
					):
						infer_type_arguments(
							expected_arguments,
							actual_arguments,
							inference,
							obligation,
							0,
						)
					else:
						Ok(inference)
				_:
					Ok(inference)
		AppliedUnionType(owner, expected_arguments):
			match actual:
				AppliedUnionType(actual_owner, actual_arguments):
					if (
						IntOps.equals(union_number(owner), union_number(actual_owner))
						and IntOps.equals(expected_arguments.length(), actual_arguments.length())
					):
						infer_type_arguments(
							expected_arguments,
							actual_arguments,
							inference,
							obligation,
							0,
						)
					else:
						Ok(inference)
				_:
					Ok(inference)
		_:
			Ok(inference)


private pure func infer_type_arguments(
	expected: List[TypeRef],
	actual: List[TypeRef],
	inference: Inference,
	obligation: ArgumentMismatch,
	position: Int,
) -> Result[Inference, CheckError]:
	match expected.get(position):
		None:
			Ok(inference)
		Some(argument):
			match actual.get(position):
				None:
					Ok(inference)
				Some(value):
					next ?= infer_arguments(argument, value, inference, obligation)
					infer_type_arguments(
						expected,
						actual,
						next,
						obligation,
						IntOps.add(position, 1),
					)


private pure func constrain_argument(
	inference: Inference,
	requested: TypeParameterId,
	value_type: TypeRef,
	obligation: ArgumentMismatch,
) -> Result[Inference, CheckError]:
	position = parameter_position(requested)
	current: TypeUse = {
		value_type = value_type,
		span = obligation.actual.span
	}

	slot = if same_owner(parameter_owner(requested), inference.owner):
		inference.inferred.get(position)
	else:
		None

	match slot:
		None:
			Err(checker_invariant(current.span, InvalidParameterDeclaration(requested)))
		Some(None):
			Ok({ inference | inferred = inference.inferred.set(position, Some(current)) })
		Some(Some(first)):
			if same_type(first.value_type, current.value_type):
				Ok(inference)
			else:
				-- The expectation is for the error only: uninferred parameters stay rigid.
				expected ?= substitute_type(
					obligation.expected,
					inferred_substitution(inference),
					current.span,
				)
				Err(call_error(
					current.span,
					GenericArgumentConflict({
						parameter = requested,
						previous = first,
						current = current,
						mismatch = { obligation | expected = expected },
					}),
				))


pure func contains_parameter(value_type: TypeRef) -> Bool:
	match value_type:
		ListType(element):
			contains_parameter(element)
		ParameterType(_):
			True
		AppliedUnionType(_, arguments):
			var found = False

			for argument in arguments:
				if contains_parameter(argument):
					found = True
					break

			found
		AppliedRecordType(_, arguments):
			var found = False

			for argument in arguments:
				if contains_parameter(argument):
					found = True
					break

			found
		_:
			False


pure func contains_variant(namespace: Namespace, module: ModuleId, name: NameId) -> Bool:
	variant_candidates(namespace, module, name)
		.get(0)
		.is_some()


fixed record ResolutionContext {
	caller: Caller,
	module: ModuleId,
	namespace: Namespace,
	signatures: List[AcceptedFunction],
	unions: List[CheckedUnion],
	records: List[CheckedRecord],
	callables: List[CallableBinding],
}


-- A receiver function UFCS may select, with its accepted declaration.
fixed record ReceiverCandidate {
	binding: CallableBinding,
	function: AcceptedFunction
}


fixed union ResolvedReceiver:
	UniqueReceiver(ReceiverContract)
	ReceiverCandidates(List[ReceiverCandidate])


fixed record CallableBinding {
	module: ModuleId,
	name: NameId,
	function: FunctionId,
	origin: FunctionOrigin
}


private pure func callable_candidates(
	bindings: List[CallableBinding],
	module: ModuleId,
	name: NameId,
) -> List[CallableBinding]:
	var candidates: List[CallableBinding] = []
	for binding in bindings:
		if same_module(binding.module, module) and same_name(binding.name, name):
			candidates = candidates.append(binding)
	candidates


pure func lookup_target(
	context: ResolutionContext,
	name: WrittenName,
) -> Option[FunctionId]:
	function_candidate(context.namespace, context.module, name.id).map(pure func(candidate): candidate.function)


-- A named exposure promotes the identity's diagnostic origin, including a
-- direct assembly input that names its own declaration. Methods never do this.
private pure func append_callable(
	bindings: List[CallableBinding],
	incoming: CallableBinding,
) -> List[CallableBinding]:
	var result = bindings
	var position = 0
	var found = False
	for binding in bindings:
		if same_module(binding.module, incoming.module) and IntOps.equals(function_number(binding.function), function_number(incoming.function)):
			result = result.set(position, incoming)
			found = True
			break
		position = IntOps.add(position, 1)
	if found:
		result
	else:
		result.append(incoming)


private pure func append_method(
	bindings: List[CallableBinding],
	incoming: CallableBinding,
) -> List[CallableBinding]:
	var present = False
	for binding in bindings:
		if same_module(binding.module, incoming.module) and IntOps.equals(function_number(binding.function), function_number(incoming.function)):
			present = True
			break
	if present:
		bindings
	else:
		bindings.append(incoming)


pure func build_callables(
	namespace: Namespace,
	functions: List[AcceptedFunction],
) -> List[CallableBinding]:
	-- Derived once after accepted signatures. Bindings retain only declaration
	-- identity, scope availability and provenance; signatures have one authority.
	var bindings: List[CallableBinding] = []

	for function in functions:
		bindings = append_callable(
			bindings,
			{
				module = function.declaration.module,
				name = function.declaration.function_name.id,
				function = function.id,
				origin = LocalFunction
			},
		)

	for binding in imported_functions(namespace):
		bindings = append_callable(
			bindings,
			{
				module = binding.module,
				name = binding.name.id,
				function = binding.function,
				origin = ImportedFunction(binding.name.span)
			},
		)

	-- A method selection binds the target's public functions only: the
	-- namespace publishes that set, so visibility is never read here.
	for request in method_selection_requests(namespace):
		exported = exported_functions(namespace, request.target)
		for function in functions:
			if contains_function(exported, function.id):
				receiver = function.signature.parameters
					.get(0)
					.and_then(pure func(parameter): type_head(parameter.value_type))

				match receiver:
					Some(head):
						if same_type_candidate(head, request.receiver):
							bindings = append_method(
								bindings,
								{
									module = request.module,
									name = function.declaration.function_name.id,
									function = function.id,
									origin = ImportedFunction(request.name.span)
								},
							)
					None:
						void

	bindings


private pure func contains_function(functions: List[FunctionId], id: FunctionId) -> Bool:
	var present = False
	for candidate in functions:
		if IntOps.equals(function_number(candidate), function_number(id)):
			present = True
			break
	present


pure func method_sites(candidates: List[ReceiverCandidate]) -> List[MethodCandidateSite]:
	var sites: List[MethodCandidateSite] = []

	for candidate in candidates:
		import_site = match candidate.binding.origin:
			LocalFunction:
				None
			ImportedFunction(site):
				Some(site)

		sites = sites.append({
			function = candidate.binding.function,
			declaration = candidate.function.declaration.function_name.span,
			import_site = import_site,
		})

	sites


pure func classify_receiver(
	application: ReceiverApplication,
	context: ResolutionContext,
) -> Result[ResolvedReceiver, CheckError]:
	name = application.callee

	match callable_candidates(context.callables, context.module, name.id):
		[]:
			if contains_variant(context.namespace, context.module, name.id):
				Err(method_error(name.span, ConstructorUFCS(name.id)))
			else:
				Err(call_error(name.span, UnknownFunction(name.id)))
		[candidate]:
			contract ?= receiver_contract(
				context.caller,
				name,
				application.arguments,
				candidate.function,
				context.signatures,
			)
			Ok(UniqueReceiver(contract))
		candidates:
			resolved ?= receiver_candidates(candidates, context.signatures, name.span, [])
			Ok(ReceiverCandidates(resolved))


private pure func receiver_candidates(
	bindings: List[CallableBinding],
	signatures: List[AcceptedFunction],
	span: Span,
	resolved: List[ReceiverCandidate],
) -> Result[List[ReceiverCandidate], CheckError]:
	match bindings.get(resolved.length()):
		None:
			Ok(resolved)
		Some(binding):
			function ?= signatures
				.get(function_number(binding.function))
				.to_result(checker_invariant(span, InvalidResolvedFunction(binding.function)))
			receiver_candidates(
				bindings,
				signatures,
				span,
				resolved.append({
					binding = binding,
					function = function,
				}),
			)


-- A concrete first parameter can give a receiver constructor its type.
private pure func receiver_parameter(signature: FunctionSignature) -> Option[TypeRef]:
	match signature.parameters.get(0):
		None:
			None
		Some(parameter):
			if (
				signature.type_parameters.is_empty()
				and not contains_parameter(parameter.value_type)
			):
				Some(parameter.value_type)
			else:
				None


-- Competing receivers supply an expected type only when they all agree on it.
pure func receiver_expectation(receiver: ResolvedReceiver) -> Option[TypeRef]:
	match receiver:
		UniqueReceiver(contract):
			receiver_parameter(contract.call.signature)
		ReceiverCandidates(candidates):
			var expectation: Option[TypeRef] = None
			var common = True

			for candidate in candidates:
				match receiver_parameter(candidate.function.signature):
					None:
						common = False
					Some(value_type):
						match expectation:
							None:
								expectation = Some(value_type)
							Some(previous):
								common = common and same_type(previous, value_type)

			if common:
				expectation
			else:
				None


-- Whether a receiver of the actual type satisfies a candidate's first
-- parameter, inferring the candidate's type parameters from the receiver alone.
private pure func receiver_matches(
	function: FunctionId,
	signature: FunctionSignature,
	parameter: TypeUse,
	actual: TypeUse,
) -> Bool:
	inference = start_inference(FunctionDeclaration(function), signature.type_parameters)
	obligation: ArgumentMismatch = {
		expected = parameter.value_type,
		actual = actual,
		argument_position = 0,
		expected_site = SourceAnnotation(parameter.span)
	}

	match infer_arguments(parameter.value_type, actual.value_type, inference, obligation):
		Err(_):
			False
		Ok(inferred):
			match substitute_type(
				parameter.value_type,
				inferred_substitution(inferred),
				actual.span,
			):
				Err(_):
					False
				Ok(expected):
					same_type(expected, actual.value_type)


pure func select_receiver_contract(
	application: ReceiverApplication,
	receiver: ResolvedReceiver,
	actual: TypeUse,
	context: ResolutionContext,
) -> Result[ReceiverContract, CheckError]:
	match receiver:
		UniqueReceiver(contract):
			Ok(contract)
		ReceiverCandidates(candidates):
			arity = IntOps.add(application.arguments.length(), 1)
			chosen ?= choose_receiver(application.callee, candidates, actual, arity)
			receiver_contract(
				context.caller,
				application.callee,
				application.arguments,
				chosen.binding.function,
				context.signatures,
			)


-- Competing receivers are narrowed by receiver type, then by argument count;
-- import order never ranks them.
private pure func choose_receiver(
	callee: WrittenName,
	candidates: List[ReceiverCandidate],
	actual: TypeUse,
	arity: Int,
) -> Result[ReceiverCandidate, CheckError]:
	var compatible: List[ReceiverCandidate] = []
	var matching_arity: List[ReceiverCandidate] = []
	var counts: List[Int] = []

	for candidate in candidates:
		signature = candidate.function.signature

		match signature.parameters.get(0):
			Some(parameter):
				if receiver_matches(candidate.binding.function, signature, parameter, actual):
					compatible = compatible.append(candidate)
					count = signature.parameters.length()

					if IntOps.equals(count, arity):
						matching_arity = matching_arity.append(candidate)

					if not counts.contains(count):
						counts = counts.append(count)
			None:
				void

	match compatible:
		[]:
			Err(
				method_error(
					callee.span,
					NoApplicableMethod(callee.id, actual.value_type, method_sites(candidates)),
				),
			)
		[candidate]:
			Ok(candidate)
		_:
			match matching_arity:
				[candidate]:
					Ok(candidate)
				[]:
					Err(
						method_error(
							callee.span,
							MethodArgumentCounts(
								callee.id,
								arity,
								counts,
								method_sites(compatible),
							),
						),
					)
				applicable:
					Err(
						method_error(
							callee.span,
							AmbiguousMethod(callee.id, actual.value_type, method_sites(applicable)),
						),
					)
