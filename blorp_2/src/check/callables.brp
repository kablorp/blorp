---
Receiver visibility and accepted call contracts. Namespace owns which functions
a receiver call reaches; inference selects by type after declaration clashes
have been rejected. Contracts prove arity and purity once.
---
import:
	../utils/boolean: not, and
	../namespace/builtins: DesignatedBoolean, DesignatedOption
	./declarations: TypeScope
	./errors:
		CallError(ArgumentCountMismatch, ImpureCall, ImpureCallableCall, UnknownFunction),
		CheckError,
		CheckerInvariant(InvalidResolvedFunction, InvalidFunctionContract),
		call_error,
		checker_invariant, trait_error, TraitError(MissingImplementation, DifferentMethodFamilies, FamilyFunctionConflict),
		MethodCandidateSite,
		MethodError(ConstructorUFCS),
		method_error
	./model:
		BodyOwner, ScopedBindingId,
		AcceptedTraits, AcceptedMethodCall, accepted_method, method_body,
		CallIdentity(MethodTarget, DeclaredTarget, ParameterTarget),
		CheckedConstant,
		CheckedOpaque,
		FunctionSignature,
		TypeRef,
		CheckedRecord,
		CheckedUnion,
		type_head
	./scope: CallableBinding, callable_parameter_contract
	./signatures: AcceptedFunction
	../utils/ids: TraitMethodId, trait_method_owner, trait_method_number, trait_number, same_trait_method, FunctionId, OpaqueRow, VariantId, function_number
	../utils/syntax:
		CallNotation(DirectCall, ReceiverCall),
		Purity(Impure, Pure),
		Span,
		ValueExpression,
		WrittenName,
		same_purity,
		ReceiverApplication
	../namespace/namespace:
		FunctionSource(DeclaredHere, ImportedAt), Namespace, NamedValue(NamedMethod, NamedFunction, NamedConstructor), OfferedValue(OfferedMethod, OfferedFunction), TypeHead, MethodImport, ValueBinding(MethodName), value_binding,
		method_imports, named_value, offered_value, same_head,
	../utils/source: ModuleId, same_module, module_source, same_source
	int as IntOps
	option: to_result, is_some


-- The active body owns purity independently of its root declaration.
fixed record Caller {
	body: BodyOwner,
	purity: Purity
}


-- A resolved call whose complete arity and purity have been validated.
-- The accepted signature owns its ordered parameter types and result type.
fixed record FunctionContract {
	target: CallIdentity,
	signature: FunctionSignature,
	span: Span
}


pure func function_contract(
	caller: Caller,
	name: WrittenName,
	arguments: List[ValueExpression],
	callee: FunctionId,
	signatures: List[AcceptedFunction],
) -> Result[FunctionContract, CheckError]:
	signature ?= callee_signature(name, callee, signatures)
	arity ?= validate_arity(name, DirectCall, arguments.length(), DeclaredTarget(callee), signature)
	pure_call ?= validate_purity(caller, name, callee, signature)
	Ok({
		target = DeclaredTarget(callee),
		signature = signature,
		span = name.span,
	})


pure func receiver_contract(
	caller: Caller,
	name: WrittenName,
	arguments: List[ValueExpression],
	callee: FunctionId,
	signatures: List[AcceptedFunction],
) -> Result[FunctionContract, CheckError]:
	signature ?= callee_signature(name, callee, signatures)
	arity ?= validate_arity(
		name,
		ReceiverCall,
		IntOps.add(arguments.length(), 1),
		DeclaredTarget(callee),
		signature,
	)
	pure_call ?= validate_purity(caller, name, callee, signature)
	Ok({
		target = DeclaredTarget(callee),
		signature = signature,
		span = name.span,
	})


private pure func callee_signature(
	name: WrittenName,
	callee: FunctionId,
	signatures: List[AcceptedFunction],
) -> Result[FunctionSignature, CheckError]:
	accepted ?= signatures
		.get(function_number(callee))
		.to_result(checker_invariant(name.span, InvalidResolvedFunction(callee)))
	Ok(accepted.signature)


private pure func validate_arity(
	name: WrittenName,
	notation: CallNotation,
	actual: Int,
	callee: CallIdentity,
	signature: FunctionSignature,
) -> Result[Void, CheckError]:
	expected = signature.parameters.length()
	if IntOps.equals(expected, actual):
		Ok(void)
	else:
		Err(call_error(name.span, ArgumentCountMismatch({
			callee = name.id,
			expected = expected,
			actual = actual,
			notation = notation,
			target = callee,
		})))


private pure func validate_purity(
	caller: Caller,
	name: WrittenName,
	callee: FunctionId,
	signature: FunctionSignature,
) -> Result[Void, CheckError]:
	if and(same_purity(caller.purity, Pure), same_purity(signature.purity, Impure)):
		Err(call_error(name.span, ImpureCall(caller.body, callee)))
	else:
		Ok(void)


fixed union SourceLoopScope:
	OutsideSourceLoop
	WithinSourceLoop


fixed record ResolutionContext {
	traits: AcceptedTraits,
	caller: Caller,
	root_function: FunctionId,
	module: ModuleId,
	namespace: Namespace,
	body_types: TypeScope,
	signatures: List[AcceptedFunction],
	unions: List[CheckedUnion],
	records: List[CheckedRecord],
	opaque_declarations: List[OpaqueRow],
	opaques: List[CheckedOpaque],
	constants: List[CheckedConstant],
	boolean: DesignatedBoolean[VariantId],
	option: DesignatedOption[VariantId],
	loop_scope: SourceLoopScope,
}


-- A receiver function UFCS may select, with its accepted declaration and the
-- selection that brought it into the caller's module (None for its own).
fixed record ReceiverCandidate {
	function: AcceptedFunction,
	import_site: Option[Span]
}


fixed union ResolvedReceiver:
	UniqueReceiver(FunctionContract)
	ReceiverCandidates(List[ReceiverCandidate])


-- The head of `function`'s first parameter type, which UFCS dispatches on.
private pure func receiver_head(function: AcceptedFunction) -> Option[TypeHead]:
	match function.signature.parameters.get(0):
		Some(parameter): type_head(parameter.value_type)
		None: None


private pure func listed_function(candidates: List[ReceiverCandidate], id: FunctionId) -> Bool:
	var present: Bool = False
	for candidate in candidates:
		if IntOps.equals(function_number(candidate.function.id), function_number(id)):
			present = True
			break
	present


-- The receiver functions `name` reaches in the caller's module: its own value of
-- that name if it is a function, then, per method import in scope order, the
-- target's offered function of that name on the imported receiver type. A
-- function reached twice is listed once.
pure func receiver_bindings(namespace: Namespace, signatures: List[AcceptedFunction], module: ModuleId, name: WrittenName) -> Result[List[ReceiverCandidate], CheckError]:
	var found: List[ReceiverCandidate] = []
	var failure: Option[CheckError] = None
	match named_value(namespace, module, name.id):
		Some(NamedFunction(id, source)):
			site: Option[Span] = match source:
				DeclaredHere: None
				ImportedAt(span): Some(span)
			match signatures.get(function_number(id)):
				Some(function): found = found.append({ function = function, import_site = site })
				None: failure = Some(checker_invariant(name.span, InvalidResolvedFunction(id)))
		_: void
	for imported in method_imports(namespace, module):
		match offered_value(namespace, imported.target, name.id):
			Ok(OfferedFunction(id)):
				if listed_function(found, id).not():
					match signatures.get(function_number(id)):
						Some(function):
							match receiver_head(function):
								Some(head):
									if same_head(head, imported.receiver):
										found = found.append({ function = function, import_site = Some(imported.name.span) })
								None: void
						None: failure = Some(checker_invariant(name.span, InvalidResolvedFunction(id)))
			_: void
	match failure:
		Some(error): Err(error)
		None: Ok(found)


pure func method_sites(candidates: List[ReceiverCandidate]) -> List[MethodCandidateSite]:
	var sites: List[MethodCandidateSite] = []

	for candidate in candidates:
		sites = sites.append(method_site(candidate))

	sites


pure func method_site(candidate: ReceiverCandidate) -> MethodCandidateSite:
	{
		function = candidate.function.id,
		declaration = candidate.function.declaration.function_name.span,
		import_site = candidate.import_site
	}


pure func classify_receiver(
	application: ReceiverApplication,
	context: ResolutionContext,
) -> Result[ResolvedReceiver, CheckError]:
	name = application.callee

	method ?= visible_method(context.namespace, context.traits, context.signatures, context.module, name)
	match method:
		Some(id):
			match method_contract(name, IntOps.add(application.arguments.length(), 1), ReceiverCall, id, context.traits):
				Ok(contract): Ok(UniqueReceiver(contract))
				Err(error): Err(error)
		None: classify_function_receiver(application, context)


private pure func classify_function_receiver(application: ReceiverApplication, context: ResolutionContext) -> Result[ResolvedReceiver, CheckError]:
	name = application.callee
	candidates ?= receiver_bindings(context.namespace, context.signatures, context.module, name)
	match candidates:
		[]:
			match named_value(context.namespace, context.module, name.id):
				Some(NamedConstructor(_)): Err(method_error(name.span, ConstructorUFCS(name.id)))
				_: Err(call_error(name.span, UnknownFunction(name.id)))
		[candidate]:
			match receiver_contract(
				context.caller,
				name,
				application.arguments,
				candidate.function.id,
				context.signatures,
			):
				Ok(contract): Ok(UniqueReceiver(contract))
				Err(error): Err(error)
		_:
			Ok(ReceiverCandidates(candidates))


pure func callable_contract(
	caller: Caller,
	name: WrittenName,
	arguments: List[ValueExpression],
	binding: CallableBinding,
) -> Result[FunctionContract, CheckError]:
	accepted ?= callable_parameter_contract(binding)
	signature = accepted.signature
	target: CallIdentity = ParameterTarget(accepted.parameter)
	arity ?= validate_arity(name, DirectCall, arguments.length(), target, signature)
	pure_call: Void ?= if and(same_purity(caller.purity, Pure), same_purity(signature.purity, Impure)):
		Err(call_error(name.span, ImpureCallableCall(caller.body)))
	else:
		Ok(void)
	Ok({
		target = target,
		signature = signature,
		span = name.span
	})


-- The resolved binding, not its name, identifies an ordinary stored callable.
pure func value_callable_contract(
	caller: Caller, name: WrittenName, arguments: List[ValueExpression],
	target: CallIdentity, signature: FunctionSignature,
) -> Result[FunctionContract, CheckError]:
	arity ?= validate_arity(name, DirectCall, arguments.length(), target, signature)
	pure_call: Void ?= if and(same_purity(caller.purity, Pure), same_purity(signature.purity, Impure)):
		Err(call_error(name.span, ImpureCallableCall(caller.body)))
	else:
		Ok(void)
	Ok({ target = target, signature = signature, span = name.span })


pure func method_contract(name: WrittenName, count: Int, notation: CallNotation, method: TraitMethodId, traits: AcceptedTraits) -> Result[FunctionContract, CheckError]:
	owner ?= traits.declarations.get(trait_number(trait_method_owner(method))).to_result(checker_invariant(name.span, InvalidFunctionContract))
	accepted ?= owner.methods.get(trait_method_number(method)).to_result(checker_invariant(name.span, InvalidFunctionContract))
	arity ?= validate_arity(name, notation, count, MethodTarget(method), accepted.signature)
	Ok({ target = MethodTarget(method), signature = accepted.signature, span = name.span })


-- The receiver is already solved by ordinary equations. Implementation search
-- proves the obligation; it never supplies missing inference evidence.
pure func accept_method_call(traits: AcceptedTraits, method: TraitMethodId, receiver: TypeRef, span: Span) -> Result[AcceptedMethodCall, CheckError]:
	accepted = accepted_method(method, receiver)
	match method_body(traits, accepted):
		Some(_): Ok(accepted)
		None: Err(trait_error(span, MissingImplementation(method, receiver)))



private fixed record MethodBinding {
	method: TraitMethodId,
	span: Span
}


-- The selected type exposes this provider's own accepted implementation. Once
-- exposed, the family remains the same across every implementing Self type.
pure func provider_owns_method(traits: AcceptedTraits, edge: MethodImport, method: TraitMethodId) -> Bool:
	var owns: Bool = False
	for implementation in traits.implementations:
		if same_module(implementation.module, edge.target):
			match type_head(implementation.receiver):
				Some(head):
					member = implementation.methods.any(pure func(member): same_trait_method(member.method, method))
					if and(same_head(head, edge.receiver), member):
						owns = True
				None: void
	owns


private pure func add_family(previous: Option[MethodBinding], method: TraitMethodId, span: Span, module: ModuleId) -> Result[Option[MethodBinding], CheckError]:
	match previous:
		None: Ok(Some({ method = method, span = span }))
		Some(held):
			if same_trait_method(held.method, method):
				Ok(previous)
			else:
				if incoming_diagnostic_site(held.span, span, module):
					Err(trait_error(span, DifferentMethodFamilies(method, held.method, held.span)))
				else:
					Err(trait_error(held.span, DifferentMethodFamilies(held.method, method, span)))


pure func visible_method(namespace: Namespace, traits: AcceptedTraits, signatures: List[AcceptedFunction], module: ModuleId, name: WrittenName) -> Result[Option[TraitMethodId], CheckError]:
	var found: Option[MethodBinding] = match named_value(namespace, module, name.id):
		Some(NamedMethod(id)):
			match value_binding(namespace, module, name.id):
				Some(MethodName(written)): Some({ method = id, span = written.span })
				_: None
		_: None
	var failure: Option[CheckError] = None
	for imported in method_imports(namespace, module):
		match offered_value(namespace, imported.target, name.id):
			Ok(OfferedMethod(method)):
				if provider_owns_method(traits, imported, method):
					match add_family(found, method, imported.name.span, module):
						Ok(accepted): found = accepted
						Err(error): failure = Some(error)
			_: void
		if failure.is_some():
			break
	ready: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	functions ?= receiver_bindings(namespace, signatures, module, name)
	match found:
		None: Ok(None)
		Some(family):
			match functions:
				[]: Ok(Some(family.method))
				[function, ..._]:
					function_span = match function.import_site:
						Some(span): span
						None: function.function.declaration.function_name.span
					if incoming_diagnostic_site(family.span, function_span, module):
						Err(trait_error(function_span, FamilyFunctionConflict(family.method, function.function.id, family.span)))
					else:
						Err(trait_error(family.span, FamilyFunctionConflict(family.method, function.function.id, function_span)))


-- Local written order selects diagnostic sites only. Offsets in different
-- sources are unrelated; a local introduction takes priority over inheritance.
private pure func incoming_diagnostic_site(previous: Span, incoming: Span, module: ModuleId) -> Bool:
	if same_source(previous.source, incoming.source):
		IntOps.less_than(incoming.start, previous.start).not()
	else if same_source(incoming.source, module_source(module)):
		True
	else if same_source(previous.source, module_source(module)):
		False
	else:
		True
