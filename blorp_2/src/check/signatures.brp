---
Publishes one checked signature per function in declaration order and
identifies the entrypoint. A builtin body is accepted once its closed runtime
contract validates against the resolved signature, publishing the typed
runtime operation. Bool and Option results are the foundation's designated
unions, which the operation carries by constructor identity.
---
import:
	./declarations: TypeScope, type_access, declared_parameters, local_type_parameters, resolve_type, occurrence_fields
	./errors:
		CheckError,
		CheckerInvariant(InvalidResolvedFunction, RuntimeContractMismatch),
		SignatureError(GenericMain, MainHasParameters, MainParameterType, MainReturnType, MissingMain),
		checker_invariant,
		signature_error,
		BuiltinError(BuiltinContractMismatch, BuiltinTailAnnotation),
		builtin_error
	./model:
		FunctionSignature,
		TypeParameterOwner(FunctionDeclaration),
		TypeRef(IntType, ListType, StringType, VoidType, UnionType, AppliedUnionType),
		TypeUse,
		same_type,
		type_parameter_id,
		primitive_ref,
		same_types
	../namespace/builtins as Builtins:
		DesignatedUnions,
		RuntimeOperation,
		RuntimeType(PrimitiveRuntimeType, ElementRuntimeType, ListRuntimeType),
		RuntimeResult(ValueResult, OptionalResult, ResultResult, BooleanResult),
		primitive_operation,
		runtime_contract
	../namespace/namespace: Namespace, FunctionSource(DeclaredHere), NamedValue(NamedFunction), named_value
	../parse/assemble: ParsedContents
	../utils/ids:
		FunctionId,
		VariantId,
		function_number,
		inventory_functions,
		inventory_records,
		inventory_unions,
		variant_owner
	../utils/source: root_module_id
	../utils/syntax:
		EntryResult(IntegerExitStatus, SuccessfulExit),
		Entrypoint(NoArguments, WithArguments),
		ParsedBody(ParsedBuiltinBody, ParsedMatchBody, ParsedValueBody),
		ParsedFunction,
		ParsedMatch,
		ParsedParameter,
		Span,
		ValueExpression,
		same_purity,
		type_span,
		ParsedRuntimeOperation(
			StringParseIntBuiltin, StringParseFloatBuiltin, ListRepeatBuiltin, ListLengthBuiltin, ListGetBuiltin,
			StringByteAtBuiltin, StringFromCodepointBuiltin, GetCurrentDirectoryBuiltin, ReadFileBuiltin, WriteFileBuiltin,
			ListAppendBuiltin, ListSetBuiltin, ListConcatBuiltin, StringEqualsBuiltin, IntegerEqualsBuiltin,
		)
	int as IntOps
	option: to_result


private fixed union FunctionRole:
	EntryFunction
	HelperFunction


-- A function body after signature checking. A builtin body has been validated
-- against its runtime contract; source bodies are checked with the others.
fixed union AcceptedBody:
	BuiltinBody(RuntimeOperation[VariantId, TypeRef], Span)
	ValueBody(ValueExpression)
	MatchBody(ParsedMatch)


-- One function after signature checking: its declaration, its one published
-- signature and its accepted body. Rows follow declaration order, so a
-- FunctionId indexes them.
fixed record AcceptedFunction {
	id: FunctionId,
	declaration: ParsedFunction,
	signature: FunctionSignature,
	body: AcceptedBody
}


fixed record CheckedSignatures {
	functions: List[AcceptedFunction],
	entrypoint: Entrypoint[FunctionId]
}


pure func validate_signatures(
	parsed: ParsedContents,
	namespace: Namespace,
	designated: DesignatedUnions,
) -> Result[CheckedSignatures, CheckError]:
	-- Only a `main` the root declares is the entrypoint.
	entrypoint: Option[FunctionId] = match named_value(namespace, root_module_id(), parsed.entrypoint):
		Some(NamedFunction(id, DeclaredHere)): Some(id)
		_: None
	functions ?= accept_functions(parsed, namespace, designated, entrypoint, [])
	id ?= entrypoint.to_result(signature_error(parsed.end, MissingMain))
	main ?= functions
		.get(function_number(id))
		.to_result(checker_invariant(parsed.end, InvalidResolvedFunction(id)))

	result = if same_type(main.signature.return_type.value_type, VoidType):
		SuccessfulExit
	else:
		IntegerExitStatus

	accepted: Entrypoint[FunctionId] = match main.signature.parameters:
		[]:
			NoArguments(id, result)
		_:
			WithArguments(id, result)

	Ok({
		functions = functions,
		entrypoint = accepted,
	})


private pure func accept_functions(
	parsed: ParsedContents,
	namespace: Namespace,
	designated: DesignatedUnions,
	entrypoint: Option[FunctionId],
	accepted: List[AcceptedFunction],
) -> Result[List[AcceptedFunction], CheckError]:
	match inventory_functions(parsed.declarations).get(accepted.length()):
		None:
			Ok(accepted)
		Some(row):
			function = row.declaration

			id = row.id

			role = match entrypoint:
				Some(entry):
					if IntOps.equals(function_number(id), function_number(entry)):
						EntryFunction
					else:
						HelperFunction
				None:
					HelperFunction

			scope: TypeScope = {
				records = inventory_records(parsed.declarations),
				unions = inventory_unions(parsed.declarations),
				namespace = namespace,
				module = function.module,
				access = type_access(function.visibility, function.function_name.id),
				parameters = []
			}
			match resolve_signature(function, id, role, scope, designated):
				Ok(signature):
					accept_functions(
						parsed,
						namespace,
						designated,
						entrypoint,
						accepted.append(signature),
					)
				Err(error): Err(error)


private pure func resolve_signature(
	function: ParsedFunction,
	id: FunctionId,
	role: FunctionRole,
	module_scope: TypeScope,
	designated: DesignatedUnions,
) -> Result[AcceptedFunction, CheckError]:
	generic_main ?= match role:
		EntryFunction:
			match function.type_parameters.get(0):
				Some(name):
					Err(
						signature_error(
							name.span,
							GenericMain(type_parameter_id(FunctionDeclaration(id), 0)),
						),
					)
				None:
					Ok(void)
		HelperFunction:
			Ok(void)

	scope ?= local_type_parameters(function.type_parameters, FunctionDeclaration(id), module_scope)

	return_type ?= match function.return_type:
		Some(written):
			resolve_type(scope, written)
		None:
			Ok(VoidType)

	return_span = match function.return_type:
		Some(written):
			type_span(written)
		None:
			function.function_name.span

	main_type ?= match role:
		EntryFunction:
			if same_type(return_type, IntType) or same_type(return_type, VoidType):
				Ok(void)
			else:
				Err(signature_error(return_span, MainReturnType(return_type)))
		HelperFunction:
			Ok(void)

	single_main_parameter ?= match role:
		EntryFunction:
			match function.parameters:
				[_, second, ..._]:
					Err(
						signature_error(
							second.name.span,
							MainHasParameters(function.parameters.length()),
						),
					)
				_:
					Ok(void)
		HelperFunction:
			Ok(void)

	parameters ?= resolve_parameters(function.parameters, role, scope, [])
	signature: FunctionSignature = {
		type_parameters = declared_parameters(scope),
		purity = function.purity,
		parameters = parameters,
		return_type = {
			value_type = return_type,
			span = return_span
		}
	}
	body ?= accept_body(function, signature, designated)

	Ok({
		id = id,
		declaration = function,
		signature = signature,
		body = body,
	})


-- Resolves parameter types; the body scope validates every parameter name.
private pure func resolve_parameters(
	parameters: List[ParsedParameter],
	role: FunctionRole,
	scope: TypeScope,
	resolved: List[TypeUse],
) -> Result[List[TypeUse], CheckError]:
	position = resolved.length()

	match parameters.get(position):
		None:
			Ok(resolved)
		Some(parameter):
			match resolve_type(scope, parameter.type_name):
				Ok(value_type):
					span = type_span(parameter.type_name)

					entry_type_result: Result[Void, CheckError] = match role:
						EntryFunction:
							if same_type(value_type, ListType(StringType)):
								Ok(void)
							else:
								Err(signature_error(span, MainParameterType))
						HelperFunction:
							Ok(void)

					match entry_type_result:
						Ok(_):
							resolve_parameters(
								parameters,
								role,
								scope,
								resolved.append({
									value_type = value_type,
									span = span,
								}),
							)
						Err(error): Err(error)
				Err(error): Err(error)


-- A builtin body is accepted once its runtime contract is validated; source
-- bodies are checked with every other body.
private pure func accept_body(
	function: ParsedFunction,
	signature: FunctionSignature,
	designated: DesignatedUnions,
) -> Result[AcceptedBody, CheckError]:
	match function.body:
		ParsedBuiltinBody(operation, span):
			match validate_builtin_body(
				operation,
				{
					function = function,
					signature = signature,
					designated = designated,
					span = span
				},
			):
				Ok(runtime): Ok(BuiltinBody(runtime, span))
				Err(error): Err(error)
		ParsedValueBody(value):
			Ok(ValueBody(value))
		ParsedMatchBody(matched):
			Ok(MatchBody(matched))


private pure func runtime_type_ref(value_type: Builtins.RuntimeType[TypeRef]) -> TypeRef:
	match value_type:
		PrimitiveRuntimeType(primitive): primitive_ref(primitive)
		ElementRuntimeType(element): element
		ListRuntimeType(element): ListType(element)


-- A List operation's real E is the element of the header's first parameter.
private pure func first_list_element(site: BuiltinSite) -> Option[TypeRef]:
	match site.signature.parameters.get(0):
		Some(parameter):
			match parameter.value_type:
				ListType(element): Some(element)
				_: None
		None: None


-- Parsed List tags acquire their real element from the resolved header, and
-- designated results their constructors from the foundation designation. Other
-- operations have no Element payload, so their phantom type needs no placeholder.
private pure func accepted_operation(parsed: ParsedRuntimeOperation, site: BuiltinSite) -> Result[RuntimeOperation[VariantId, TypeRef], CheckError]:
	option = site.designated.option
	boolean = site.designated.boolean
	match parsed:
		ListRepeatBuiltin:
			match site.signature.parameters.get(0):
				Some(parameter): Ok(Builtins.ListRepeat(parameter.value_type))
				None: Err(builtin_error(site.span, BuiltinContractMismatch(parsed)))
		ListLengthBuiltin:
			match first_list_element(site):
				Some(element): Ok(Builtins.ListLength(element))
				None: Err(builtin_error(site.span, BuiltinContractMismatch(parsed)))
		ListGetBuiltin:
			match first_list_element(site):
				Some(element): Ok(Builtins.ListGet(element, option))
				None: Err(builtin_error(site.span, BuiltinContractMismatch(parsed)))
		ListAppendBuiltin:
			match first_list_element(site):
				Some(element): Ok(Builtins.ListAppend(element))
				None: Err(builtin_error(site.span, BuiltinContractMismatch(parsed)))
		ListSetBuiltin:
			match first_list_element(site):
				Some(element): Ok(Builtins.ListSet(element))
				None: Err(builtin_error(site.span, BuiltinContractMismatch(parsed)))
		ListConcatBuiltin:
			match first_list_element(site):
				Some(element): Ok(Builtins.ListConcat(element))
				None: Err(builtin_error(site.span, BuiltinContractMismatch(parsed)))
		StringParseIntBuiltin: Ok(Builtins.StringParseInt(option))
		StringParseFloatBuiltin: Ok(Builtins.StringParseFloat(option))
		StringByteAtBuiltin: Ok(Builtins.StringByteAt(option))
		StringFromCodepointBuiltin: Ok(Builtins.StringFromCodepoint(option))
		ReadFileBuiltin: Ok(Builtins.ReadFile(site.designated.result))
		WriteFileBuiltin: Ok(Builtins.WriteFile(site.designated.result))
		GetCurrentDirectoryBuiltin: Ok(Builtins.GetCurrentDirectory(site.designated.result))
		StringEqualsBuiltin: Ok(Builtins.StringEquals(boolean))
		IntegerEqualsBuiltin: Ok(Builtins.IntEquals(boolean))
		_:
			primitive: Option[RuntimeOperation[VariantId, TypeRef]] = primitive_operation(parsed)
			match primitive:
				Some(operation): Ok(operation)
				None: Err(checker_invariant(site.span, RuntimeContractMismatch))


-- What validating one builtin body needs: its declaration and signature, and
-- the foundation designation its Bool and Option results refer to.
fixed record BuiltinSite {
	function: ParsedFunction,
	signature: FunctionSignature,
	designated: DesignatedUnions,
	span: Span
}


-- The checked type a runtime result denotes. Designated Option and Bool are
-- their constructors' owner; the foundation check accepted Option as generic
-- in its one payload and Bool as nongeneric.
private pure func runtime_result_type(result: RuntimeResult[VariantId, TypeRef]) -> TypeRef:
	match result:
		ValueResult(value_type): runtime_type_ref(value_type)
		OptionalResult(payload, option): AppliedUnionType(variant_owner(option.some), [runtime_type_ref(payload)])
		ResultResult(success, error, constructors): AppliedUnionType(variant_owner(constructors.ok), [runtime_type_ref(success), runtime_type_ref(error)])
		BooleanResult(boolean): UnionType(variant_owner(boolean.true_variant))


pure func validate_builtin_body(
	parsed: ParsedRuntimeOperation,
	site: BuiltinSite,
) -> Result[RuntimeOperation[VariantId, TypeRef], CheckError]:
	annotation ?= match site.function.tail_annotation:
		Some(annotation):
			Err(builtin_error(annotation, BuiltinTailAnnotation))
		None:
			Ok(void)

	operation ?= accepted_operation(parsed, site)
	contract = runtime_contract(operation)
	signature = site.signature

	generic_header = match parsed:
		ListRepeatBuiltin | ListLengthBuiltin | ListGetBuiltin | ListAppendBuiltin | ListSetBuiltin | ListConcatBuiltin: True
		_: signature.type_parameters.is_empty()

	if (
		generic_header
		and same_purity(signature.purity, contract.purity)
		and same_types(
			signature.parameters.map(
				pure func(parameter: TypeUse) -> TypeRef: parameter.value_type,
			),
			contract.parameters.map(
				pure func(
					parameter: Builtins.RuntimeType[TypeRef],
				) -> TypeRef: runtime_type_ref(parameter),
			),
		)
		and same_type(signature.return_type.value_type, runtime_result_type(contract.return_type))
	):
		Ok(operation)
	else:
		Err(builtin_error(site.span, BuiltinContractMismatch(parsed)))
