---
Publishes one checked signature per function in declaration order and
identifies the entrypoint. A builtin body is accepted once its closed runtime
contract validates against the resolved signature, publishing the typed
runtime operation with resolved constructor roles.
---
import:
	./declarations: TypeScope, declared_parameters, local_type_parameters, resolve_type, occurrence_fields
	./errors:
		CheckError,
		CheckerInvariant(InvalidCheckedUnion, InvalidResolvedFunction, RuntimeContractMismatch),
		SignatureError(DuplicateParameter, GenericMain, MainHasParameters, MainParameterType, MainReturnType, MissingMain, PureVoidReturn),
		checker_invariant,
		signature_error,
		BuiltinError(BuiltinBooleanPayload, BuiltinContractMismatch, BuiltinResultUnion, BuiltinRoleCoverage, BuiltinRoleNotInResult, BuiltinRolePayload, BuiltinTailAnnotation),
		builtin_error
	./model:
		CheckedUnion,
		FunctionSignature,
		TypeParameterOwner(FunctionDeclaration),
		TypeRef(IntType, ListType, StringType, VoidType),
		TypeUse,
		same_type,
		type_parameter_id,
		CheckedVariant,
		UnionOccurrence,
		primitive_ref,
		same_types,
		same_variant,
		union_occurrence
	../namespace/builtins as Builtins:
		RuntimeOperation,
		BooleanRoles,
		OptionalRoles,
		RuntimeType(PrimitiveRuntimeType, ElementRuntimeType, ListRuntimeType),
		RuntimeResult(ValueResult, OptionalResult, BooleanResult),
		primitive_operation,
		runtime_contract
	../namespace/namespace: Namespace, local_function, variant_candidates
	../parse/assemble: ParsedContents
	../utils/ids:
		FunctionId,
		VariantId,
		function_number,
		inventory_functions,
		inventory_records,
		inventory_unions,
		union_number,
		variant_number
	../utils/names: same_name
	../utils/source: root_module_id
	../utils/syntax:
		EntryResult(IntegerExitStatus, SuccessfulExit),
		Entrypoint(NoArguments, WithArguments),
		ParsedBody(ParsedBuiltinBody, ParsedMatchBody, ParsedValueBody),
		ParsedFunction,
		ParsedMatch,
		ParsedParameter,
		Purity(Pure),
		Span,
		ValueExpression,
		same_purity,
		type_span,
		ParsedRuntimeOperation(
			StringParseIntBuiltin, StringParseFloatBuiltin, ListRepeatBuiltin, ListLengthBuiltin, ListGetBuiltin,
			ListAppendBuiltin, ListSetBuiltin, ListConcatBuiltin, StringEqualsBuiltin, IntegerEqualsBuiltin,
		),
		WrittenName
	int as IntOps
	option: to_result


private fixed union FunctionRole:
	EntryFunction
	HelperFunction


-- A function body after signature checking. A builtin body has been validated
-- against its runtime contract; source bodies are checked with the others.
fixed union AcceptedBody:
	BuiltinBody(RuntimeOperation[VariantId, TypeRef], Span)
	ValueBody(ValueExpression)
	MatchBody(ParsedMatch)


-- One function after signature checking: its declaration, its one published
-- signature and its accepted body. Rows follow declaration order, so a
-- FunctionId indexes them.
fixed record AcceptedFunction {
	id: FunctionId,
	declaration: ParsedFunction,
	signature: FunctionSignature,
	body: AcceptedBody
}


fixed record CheckedSignatures {
	functions: List[AcceptedFunction],
	entrypoint: Entrypoint[FunctionId]
}


pure func validate_pure_result(
	purity: Purity,
	value_type: TypeRef,
	span: Span,
) -> Result[Void, CheckError]:
	if same_purity(purity, Pure) and same_type(value_type, VoidType):
		Err(signature_error(span, PureVoidReturn))
	else:
		Ok(void)


pure func validate_signatures(
	parsed: ParsedContents,
	namespace: Namespace,
	unions: List[CheckedUnion],
) -> Result[CheckedSignatures, CheckError]:
	entrypoint = local_function(namespace, root_module_id(), parsed.entrypoint)
	functions ?= accept_functions(parsed, namespace, unions, entrypoint, [])
	id ?= entrypoint.to_result(signature_error(parsed.end, MissingMain))
	main ?= functions
		.get(function_number(id))
		.to_result(checker_invariant(parsed.end, InvalidResolvedFunction(id)))

	result = if same_type(main.signature.return_type.value_type, VoidType):
		SuccessfulExit
	else:
		IntegerExitStatus

	accepted: Entrypoint[FunctionId] = match main.signature.parameters:
		[]:
			NoArguments(id, result)
		_:
			WithArguments(id, result)

	Ok({
		functions = functions,
		entrypoint = accepted,
	})


private pure func accept_functions(
	parsed: ParsedContents,
	namespace: Namespace,
	unions: List[CheckedUnion],
	entrypoint: Option[FunctionId],
	accepted: List[AcceptedFunction],
) -> Result[List[AcceptedFunction], CheckError]:
	match inventory_functions(parsed.declarations).get(accepted.length()):
		None:
			Ok(accepted)
		Some(row):
			function = row.declaration

			id = row.id

			role = match entrypoint:
				Some(entry):
					if IntOps.equals(function_number(id), function_number(entry)):
						EntryFunction
					else:
						HelperFunction
				None:
					HelperFunction

			scope: TypeScope = {
				records = inventory_records(parsed.declarations),
				unions = inventory_unions(parsed.declarations),
				namespace = namespace,
				module = function.module,
				parameters = []
			}
			signature ?= resolve_signature(function, id, role, scope, unions)
			accept_functions(
				parsed,
				namespace,
				unions,
				entrypoint,
				accepted.append(signature),
			)


private pure func resolve_signature(
	function: ParsedFunction,
	id: FunctionId,
	role: FunctionRole,
	module_scope: TypeScope,
	unions: List[CheckedUnion],
) -> Result[AcceptedFunction, CheckError]:
	generic_main ?= match role:
		EntryFunction:
			match function.type_parameters.get(0):
				Some(name):
					Err(
						signature_error(
							name.span,
							GenericMain(type_parameter_id(FunctionDeclaration(id), 0)),
						),
					)
				None:
					Ok(void)
		HelperFunction:
			Ok(void)

	scope ?= local_type_parameters(function.type_parameters, FunctionDeclaration(id), module_scope)

	return_type ?= match function.return_type:
		Some(written):
			resolve_type(scope, written)
		None:
			Ok(VoidType)

	return_span = match function.return_type:
		Some(written):
			type_span(written)
		None:
			function.function_name.span

	pure_result ?= validate_pure_result(function.purity, return_type, return_span)

	main_type ?= match role:
		EntryFunction:
			if same_type(return_type, IntType) or same_type(return_type, VoidType):
				Ok(void)
			else:
				Err(signature_error(return_span, MainReturnType(return_type)))
		HelperFunction:
			Ok(void)

	single_main_parameter ?= match role:
		EntryFunction:
			match function.parameters:
				[_, second, ..._]:
					Err(
						signature_error(
							second.name.span,
							MainHasParameters(function.parameters.length()),
						),
					)
				_:
					Ok(void)
		HelperFunction:
			Ok(void)

	parameters ?= resolve_parameters(function.parameters, role, scope, [])
	signature: FunctionSignature = {
		type_parameters = declared_parameters(scope),
		purity = function.purity,
		parameters = parameters,
		return_type = {
			value_type = return_type,
			span = return_span
		}
	}
	body ?= accept_body(function, signature, unions, scope.namespace)

	Ok({
		id = id,
		declaration = function,
		signature = signature,
		body = body,
	})


-- Parameter names are distinct; main's only parameter is a List[String].
private pure func resolve_parameters(
	parameters: List[ParsedParameter],
	role: FunctionRole,
	scope: TypeScope,
	resolved: List[TypeUse],
) -> Result[List[TypeUse], CheckError]:
	position = resolved.length()

	match parameters.get(position):
		None:
			Ok(resolved)
		Some(parameter):
			var earlier: Option[ParsedParameter] = None

			for previous in parameters.take(position):
				if same_name(previous.name.id, parameter.name.id):
					earlier = Some(previous)
					break

			unique ?= match earlier:
				Some(first):
					Err(
						signature_error(
							parameter.name.span,
							DuplicateParameter(parameter.name.id, first.name.span),
						),
					)
				None:
					Ok(void)

			value_type ?= resolve_type(scope, parameter.type_name)
			span = type_span(parameter.type_name)

			entry_type ?= match role:
				EntryFunction:
					if same_type(value_type, ListType(StringType)):
						Ok(void)
					else:
						Err(signature_error(span, MainParameterType))
				HelperFunction:
					Ok(void)

			resolve_parameters(
				parameters,
				role,
				scope,
				resolved.append({
					value_type = value_type,
					span = span,
				}),
			)


-- A builtin body is accepted once its runtime contract is validated; source
-- bodies are checked with every other body.
private pure func accept_body(
	function: ParsedFunction,
	signature: FunctionSignature,
	unions: List[CheckedUnion],
	namespace: Namespace,
) -> Result[AcceptedBody, CheckError]:
	match function.body:
		ParsedBuiltinBody(operation, span):
			runtime ?= validate_builtin_body(
				operation,
				{
					function = function,
					signature = signature,
					unions = unions,
					namespace = namespace,
					span = span
				},
			)
			Ok(BuiltinBody(runtime, span))
		ParsedValueBody(value):
			Ok(ValueBody(value))
		ParsedMatchBody(matched):
			Ok(MatchBody(matched))


private pure func runtime_type_ref(value_type: Builtins.RuntimeType[TypeRef]) -> TypeRef:
	match value_type:
		PrimitiveRuntimeType(primitive): primitive_ref(primitive)
		ElementRuntimeType(element): element
		ListRuntimeType(element): ListType(element)


-- A List operation's real E is the element of the header's first parameter.
private pure func first_list_element(site: BuiltinSite) -> Option[TypeRef]:
	match site.signature.parameters.get(0):
		Some(parameter):
			match parameter.value_type:
				ListType(element): Some(element)
				_: None
		None: None


-- Parsed List tags acquire their real element from the resolved header. Other
-- operations have no Element payload, so their phantom type needs no placeholder.
private pure func written_operation(parsed: ParsedRuntimeOperation, site: BuiltinSite) -> Result[RuntimeOperation[WrittenName, TypeRef], CheckError]:
	mismatch = builtin_error(site.span, BuiltinContractMismatch(parsed))
	match parsed:
		ListRepeatBuiltin:
			match site.signature.parameters.get(0):
				Some(parameter): Ok(Builtins.ListRepeat(parameter.value_type))
				None: Err(mismatch)
		ListLengthBuiltin:
			match first_list_element(site):
				Some(element): Ok(Builtins.ListLength(element))
				None: Err(mismatch)
		ListGetBuiltin(present, absent):
			match first_list_element(site):
				Some(element): Ok(Builtins.ListGet(element, { present = present, absent = absent }))
				None: Err(mismatch)
		ListAppendBuiltin:
			match first_list_element(site):
				Some(element): Ok(Builtins.ListAppend(element))
				None: Err(mismatch)
		ListSetBuiltin:
			match first_list_element(site):
				Some(element): Ok(Builtins.ListSet(element))
				None: Err(mismatch)
		ListConcatBuiltin:
			match first_list_element(site):
				Some(element): Ok(Builtins.ListConcat(element))
				None: Err(mismatch)
		StringParseIntBuiltin(present, absent): Ok(Builtins.StringParseInt({ present = present, absent = absent }))
		StringParseFloatBuiltin(present, absent): Ok(Builtins.StringParseFloat({ present = present, absent = absent }))
		StringEqualsBuiltin(equal, different): Ok(Builtins.StringEquals({ equal = equal, different = different }))
		IntegerEqualsBuiltin(equal, different): Ok(Builtins.IntEquals({ equal = equal, different = different }))
		_:
			primitive: Option[RuntimeOperation[WrittenName, TypeRef]] = primitive_operation(parsed)
			primitive.to_result(checker_invariant(site.span, RuntimeContractMismatch))


-- What validating one builtin body needs: its declaration and signature, and
-- the checked unions and namespace its result constructors resolve against.
fixed record BuiltinSite {
	function: ParsedFunction,
	signature: FunctionSignature,
	unions: List[CheckedUnion],
	namespace: Namespace,
	span: Span
}


-- The two constructors a builtin result binds, resolved in its result union.
private fixed record ResultRoles {
	occurrence: UnionOccurrence,
	first: CheckedVariant,
	second: CheckedVariant
}


private pure func result_roles(
	first: WrittenName,
	second: WrittenName,
	site: BuiltinSite,
) -> Result[ResultRoles, CheckError]:
	result = site.signature.return_type
	occurrence ?= union_occurrence(
		result.value_type,
	).to_result(builtin_error(result.span, BuiltinResultUnion))
	declaration ?= site.unions
		.get(union_number(occurrence.owner))
		.to_result(checker_invariant(site.span, InvalidCheckedUnion(occurrence.owner)))
	first_variant ?= builtin_role(first, declaration, site)
	second_variant ?= builtin_role(second, declaration, site)

	if (
		IntOps.equals(declaration.variants.length(), 2)
		and not same_variant(first_variant.id, second_variant.id)
	):
		Ok({
			occurrence = occurrence,
			first = first_variant,
			second = second_variant,
		})
	else:
		Err(builtin_error(site.span, BuiltinRoleCoverage))


private pure func builtin_role(
	written: WrittenName,
	declaration: CheckedUnion,
	site: BuiltinSite,
) -> Result[CheckedVariant, CheckError]:
	var found: Option[CheckedVariant] = None

	for candidate in variant_candidates(site.namespace, site.function.module, written.id):
		match declaration.variants.get(variant_number(candidate)):
			Some(variant):
				if same_variant(candidate, variant.id):
					found = Some(variant)
					break
			None:
				void

	result_type = site.signature.return_type.value_type
	found.to_result(builtin_error(written.span, BuiltinRoleNotInResult(written.id, result_type)))


-- The present constructor carries the operation's payload; the absent one is empty.
private pure func optional_roles(
	payload: TypeRef,
	written: OptionalRoles[WrittenName],
	site: BuiltinSite,
) -> Result[OptionalRoles[VariantId], CheckError]:
	roles ?= result_roles(written.present, written.absent, site)
	actual ?= occurrence_fields(roles.first.fields, roles.occurrence)

	present = match actual:
		[actual]:
			same_type(actual.value_type, payload)
		_:
			False

	if not present:
		Err(builtin_error(written.present.span, BuiltinRolePayload))
	else if not roles.second.fields.is_empty():
		Err(builtin_error(written.absent.span, BuiltinRolePayload))
	else:
		Ok({
			present = roles.first.id,
			absent = roles.second.id,
		})


-- Both comparison constructors are empty.
private pure func boolean_roles(
	written: BooleanRoles[WrittenName],
	site: BuiltinSite,
) -> Result[BooleanRoles[VariantId], CheckError]:
	roles ?= result_roles(written.equal, written.different, site)

	if not roles.first.fields.is_empty():
		Err(builtin_error(written.equal.span, BuiltinBooleanPayload))
	else if not roles.second.fields.is_empty():
		Err(builtin_error(written.different.span, BuiltinBooleanPayload))
	else:
		Ok({
			equal = roles.first.id,
			different = roles.second.id,
		})


-- The parsed operation and its runtime contract's result kind come from one
-- table in builtins, so a mismatch between them is a checker invariant.
pure func validate_builtin_body(
	parsed: ParsedRuntimeOperation,
	site: BuiltinSite,
) -> Result[RuntimeOperation[VariantId, TypeRef], CheckError]:
	annotation ?= match site.function.tail_annotation:
		Some(annotation):
			Err(builtin_error(annotation, BuiltinTailAnnotation))
		None:
			Ok(void)

	written ?= written_operation(parsed, site)
	contract = runtime_contract(written)
	signature = site.signature
	mismatch = builtin_error(site.span, BuiltinContractMismatch(parsed))

	generic_header = match parsed:
		ListRepeatBuiltin | ListLengthBuiltin | ListGetBuiltin(_, _) | ListAppendBuiltin | ListSetBuiltin | ListConcatBuiltin: True
		_: signature.type_parameters.is_empty()

	valid_header ?= if (
		generic_header
		and same_purity(signature.purity, contract.purity)
		and same_types(
			signature.parameters.map(
				pure func(parameter: TypeUse) -> TypeRef: parameter.value_type,
			),
			contract.parameters.map(
				pure func(
					parameter: Builtins.RuntimeType[TypeRef],
				) -> TypeRef: runtime_type_ref(parameter),
			),
		)
	):
		Ok(void)
	else:
		Err(mismatch)

	disagreement = checker_invariant(site.span, RuntimeContractMismatch)

	match contract.return_type:
		ValueResult(expected):
			valid_result ?= if same_type(signature.return_type.value_type, runtime_type_ref(expected)):
				Ok(void)
			else:
				Err(mismatch)

			match written:
				Builtins.ListRepeat(element): Ok(Builtins.ListRepeat(element))
				Builtins.ListLength(element): Ok(Builtins.ListLength(element))
				Builtins.ListAppend(element): Ok(Builtins.ListAppend(element))
				Builtins.ListSet(element): Ok(Builtins.ListSet(element))
				Builtins.ListConcat(element): Ok(Builtins.ListConcat(element))
				_:
					primitive: Option[RuntimeOperation[VariantId, TypeRef]] = primitive_operation(parsed)
					primitive.to_result(disagreement)
		OptionalResult(payload, written_roles):
			roles ?= optional_roles(runtime_type_ref(payload), written_roles, site)

			match parsed:
				StringParseIntBuiltin(_, _):
					Ok(Builtins.StringParseInt(roles))
				StringParseFloatBuiltin(_, _):
					Ok(Builtins.StringParseFloat(roles))
				ListGetBuiltin(_, _):
					match written:
						Builtins.ListGet(element, _): Ok(Builtins.ListGet(element, roles))
						_: Err(disagreement)
				_:
					Err(disagreement)
		BooleanResult(written_roles):
			roles ?= boolean_roles(written_roles, site)

			match parsed:
				StringEqualsBuiltin(_, _):
					Ok(Builtins.StringEquals(roles))
				IntegerEqualsBuiltin(_, _):
					Ok(Builtins.IntEquals(roles))
				_:
					Err(disagreement)
