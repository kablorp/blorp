---
Publishes one checked signature per function in declaration order and
identifies the entrypoint. A builtin body is accepted once its closed runtime
contract validates against the resolved signature, publishing the typed
runtime operation. Bool and Option results are the foundation's designated
unions, which the operation carries by constructor identity.
---
import:
	../utils/boolean: or, and, not
	./declarations: TypeScope, LocalTypeParameter, Substitution, substitute_type, TypeAccess(PrivateTypeUse), type_access, declared_parameters, local_type_parameters, resolve_type, occurrence_fields, resolve_receiver_head, receiver_arity
	./errors:
		CheckError,
		CheckerInvariant(InvalidFunctionContract, InvalidResolvedFunction, RuntimeContractMismatch),
		SignatureError(GenericMain, MainHasParameters, MainParameterType, MainReturnType, MissingMain),
		checker_invariant, type_declaration_error, TypeDeclarationError(TypeParameterTypeNameConflict), trait_error, TraitError(InvalidTraitBound, DuplicateReceiverParameter, ReceiverParameterCount, IndependentImplementationParameters),
		signature_error,
		BuiltinError(BuiltinContractMismatch, BuiltinTailAnnotation),
		builtin_error
	./model:
		AcceptedTrait, AcceptedTraitMethod, FunctionSignature, ImplementationHeader, TraitRequirement, LocatedTrait, TypeParameterId, receiver_type,
		TypeParameterOwner(FunctionDeclaration, TraitDeclaration),
		TypeRef(ParameterType, CallableType, IntType, ListType, StringType, VoidType, UnionType, AppliedUnionType),
		TypeUse,
		same_type,
		type_parameter_id,
		primitive_ref,
		same_types
	../namespace/builtins as Builtins:
		DesignatedUnions,
		RuntimeOperation,
		RuntimeType(PrimitiveRuntimeType, ElementRuntimeType, ListRuntimeType),
		RuntimeResult(ValueResult, OptionalResult, ResultResult, BooleanResult),
		primitive_operation,
		runtime_contract
	../namespace/namespace: Namespace, resolve_trait, named_type, FunctionSource(DeclaredHere), NamedValue(NamedFunction), named_value
	../parse/assemble: ParsedContents
	../utils/ids:
		FunctionId, FunctionRow, ImplRow, FunctionRole(ImplementationBody, FreeFunctionBody, TraitDefaultBody), inventory_implementations, impl_number,
		VariantId,
		function_number,
		inventory_functions,
		inventory_records,
		inventory_unions,
		variant_owner
	../utils/source: root_module_id
	../utils/names: NameId, contextual_words, same_name
	../utils/syntax:
		TypeSyntax(CallableTypeSyntax, AtomicType, QualifiedType),
		EntryResult(IntegerExitStatus, SuccessfulExit),
		Entrypoint(NoArguments, WithArguments),
		ParsedBody(ParsedBuiltinBody, ParsedMatchBody, ParsedValueBody),
		ParsedFunction, ParsedTypeParameter, receiver_head_span, WrittenName,
		ParsedMatch,
		ParsedParameter,
		Span,
		ValueExpression,
		same_purity,
		type_span,
		ParsedRuntimeOperation(
			FloatEqualsBuiltin, FloatLessThanBuiltin, FloatIsNaNBuiltin, FloatIsFiniteBuiltin,
			StringParseIntBuiltin, StringParseFloatBuiltin, ListRepeatBuiltin, ListLengthBuiltin, ListGetBuiltin,
			StringByteAtBuiltin, StringFromCodepointBuiltin, StringSliceBuiltin, GetCurrentDirectoryBuiltin, ReadFileBuiltin, WriteFileBuiltin,
			ListAppendBuiltin, ListSetBuiltin, ListConcatBuiltin, StringEqualsBuiltin, IntegerEqualsBuiltin, IntegerLessThanBuiltin,
		)
	int as IntOps
	option: to_result, is_some, is_none


private fixed union SignatureRole:
	EntryFunction
	HelperFunction


-- A function body after signature checking. A builtin body has been validated
-- against its runtime contract; source bodies are checked with the others.
fixed union AcceptedBody:
	BuiltinBody(RuntimeOperation[VariantId, TypeRef], Span)
	ValueBody(ValueExpression)
	MatchBody(ParsedMatch)


-- One function after signature checking: its declaration, its one published
-- signature and its accepted body. Rows follow declaration order, so a
-- FunctionId indexes them.
-- Body checking borrows the same accepted type scope with private access;
-- CheckedFunction publication discards that scope.
fixed record AcceptedFunction {
	id: FunctionId,
	declaration: ParsedFunction,
	signature: FunctionSignature,
	body_types: TypeScope,
	body: AcceptedBody
}


fixed record CheckedSignatures {
	implementation_headers: List[ImplementationHeader],
	functions: List[AcceptedFunction],
	entrypoint: Entrypoint[FunctionId]
}


pure func validate_signatures(
	parsed: ParsedContents,
	namespace: Namespace,
	designated: DesignatedUnions,
	contracts: List[AcceptedTrait],
) -> Result[CheckedSignatures, CheckError]:
	-- Assembly selects the entry name: application main or the compiler-owned
	-- test wrapper. Only a function declared by the root has the process ABI.
	entrypoint: Option[FunctionId] = match named_value(namespace, root_module_id(), parsed.entrypoint):
		Some(NamedFunction(id, DeclaredHere)): Some(id)
		_: None
	headers ?= implementation_headers(parsed, namespace)
	functions ?= accept_functions(parsed, namespace, designated, entrypoint, headers, contracts, [])
	id ?= entrypoint.to_result(signature_error(parsed.end, MissingMain))
	main ?= functions
		.get(function_number(id))
		.to_result(checker_invariant(parsed.end, InvalidResolvedFunction(id)))

	result: EntryResult = if same_type(main.signature.return_type.value_type, VoidType):
		SuccessfulExit
	else:
		IntegerExitStatus

	accepted: Entrypoint[FunctionId] = match main.signature.parameters:
		[]:
			NoArguments(id, result)
		_:
			WithArguments(id, result)

	Ok({
		functions = functions,
		implementation_headers = headers,
		entrypoint = accepted,
	})


private pure func accept_functions(
	parsed: ParsedContents,
	namespace: Namespace,
	designated: DesignatedUnions,
	entrypoint: Option[FunctionId],
	headers: List[ImplementationHeader],
	contracts: List[AcceptedTrait],
	accepted: List[AcceptedFunction],
) -> Result[List[AcceptedFunction], CheckError]:
	match inventory_functions(parsed.declarations).get(accepted.length()):
		None:
			Ok(accepted)
		Some(row):
			function = row.declaration

			id = row.id

			role: SignatureRole = match entrypoint:
				Some(entry):
					if IntOps.equals(function_number(id), function_number(entry)):
						EntryFunction
					else:
						HelperFunction
				None:
					HelperFunction

			scope: TypeScope = {
				self_binding = None,
				records = inventory_records(parsed.declarations),
				unions = inventory_unions(parsed.declarations),
				namespace = namespace,
				module = function.module,
				access = type_access(function.visibility, function.function_name.id),
				parameters = []
			}
			match resolve_function(row, parsed, headers, contracts, role, scope, designated):
				Ok(signature):
					accept_functions(
						parsed,
						namespace,
						designated,
						entrypoint,
						headers,
						contracts,
						accepted.append(signature),
					)
				Err(error): Err(error)


private pure func resolve_signature(
	function: ParsedFunction,
	id: FunctionId,
	role: SignatureRole,
	scope: TypeScope,
	parameters: List[TypeParameterId],
	requirements: List[TraitRequirement],
	designated: DesignatedUnions,
) -> Result[AcceptedFunction, CheckError]:


	return_type ?= match function.return_type:
		Some(written):
			resolve_type(scope, written)
		None:
			Ok(VoidType)

	return_span = match function.return_type:
		Some(written):
			type_span(written)
		None:
			function.function_name.span

	main_type: Void ?= match role:
		EntryFunction:
			if or(same_type(return_type, IntType), same_type(return_type, VoidType)):
				Ok(void)
			else:
				Err(signature_error(return_span, MainReturnType(return_type)))
		HelperFunction:
			Ok(void)

	single_main_parameter: Void ?= match role:
		EntryFunction:
			match function.parameters:
				[_, second, ..._]:
					Err(
						signature_error(
							second.name.span,
							MainHasParameters(function.parameters.length()),
						),
					)
				_:
					Ok(void)
		HelperFunction:
			Ok(void)

	formal_parameters ?= resolve_parameters(function.parameters, role, scope, [])
	signature: FunctionSignature = {
		type_parameters = parameters,
		requirements = requirements,
		purity = function.purity,
		parameters = formal_parameters,
		return_type = {
			value_type = return_type,
			span = return_span
		}
	}
	body ?= accept_body(function, signature, designated)

	Ok({
		id = id,
		declaration = function,
		signature = signature,
		body_types = { scope | access = PrivateTypeUse },
		body = body,
	})


-- Resolves parameter types; the body scope validates every parameter name.
private pure func resolve_parameters(
	parameters: List[ParsedParameter],
	role: SignatureRole,
	scope: TypeScope,
	resolved: List[TypeUse],
) -> Result[List[TypeUse], CheckError]:
	position = resolved.length()

	match parameters.get(position):
		None:
			Ok(resolved)
		Some(parameter):
			match resolve_type(scope, parameter.type_name):
				Ok(value_type):
					span = type_span(parameter.type_name)

					entry_type_result: Result[Void, CheckError] = match role:
						EntryFunction:
							if same_type(value_type, ListType(StringType)):
								Ok(void)
							else:
								Err(signature_error(span, MainParameterType))
						HelperFunction:
							Ok(void)

					match entry_type_result:
						Ok(_):
							resolve_parameters(
								parameters,
								role,
								scope,
								resolved.append({
									value_type = value_type,
									span = span,
								}),
							)
						Err(error): Err(error)
				Err(error): Err(error)


-- A builtin body is accepted once its runtime contract is validated; source
-- bodies are checked with every other body.
private pure func accept_body(
	function: ParsedFunction,
	signature: FunctionSignature,
	designated: DesignatedUnions,
) -> Result[AcceptedBody, CheckError]:
	match function.body:
		ParsedBuiltinBody(operation, span):
			match validate_builtin_body(
				operation,
				{
					function = function,
					signature = signature,
					designated = designated,
					span = span
				},
			):
				Ok(runtime): Ok(BuiltinBody(runtime, span))
				Err(error): Err(error)
		ParsedValueBody(value):
			Ok(ValueBody(value))
		ParsedMatchBody(matched):
			Ok(MatchBody(matched))


private pure func runtime_type_ref(value_type: Builtins.RuntimeType[TypeRef]) -> TypeRef:
	match value_type:
		PrimitiveRuntimeType(primitive): primitive_ref(primitive)
		ElementRuntimeType(element): element
		ListRuntimeType(element): ListType(element)


-- A List operation's real E is the element of the header's first parameter.
private pure func first_list_element(site: BuiltinSite) -> Option[TypeRef]:
	match site.signature.parameters.get(0):
		Some(parameter):
			match parameter.value_type:
				ListType(element): Some(element)
				_: None
		None: None


-- Parsed List tags acquire their real element from the resolved header, and
-- designated results their constructors from the foundation designation. Other
-- operations have no Element payload, so their phantom type needs no placeholder.
private pure func accepted_operation(parsed: ParsedRuntimeOperation, site: BuiltinSite) -> Result[RuntimeOperation[VariantId, TypeRef], CheckError]:
	option = site.designated.option
	boolean = site.designated.boolean
	match parsed:
		ListRepeatBuiltin:
			match site.signature.parameters.get(0):
				Some(parameter): Ok(Builtins.ListRepeat(parameter.value_type))
				None: Err(builtin_error(site.span, BuiltinContractMismatch(parsed)))
		ListLengthBuiltin:
			match first_list_element(site):
				Some(element): Ok(Builtins.ListLength(element))
				None: Err(builtin_error(site.span, BuiltinContractMismatch(parsed)))
		ListGetBuiltin:
			match first_list_element(site):
				Some(element): Ok(Builtins.ListGet(element, option))
				None: Err(builtin_error(site.span, BuiltinContractMismatch(parsed)))
		ListAppendBuiltin:
			match first_list_element(site):
				Some(element): Ok(Builtins.ListAppend(element))
				None: Err(builtin_error(site.span, BuiltinContractMismatch(parsed)))
		ListSetBuiltin:
			match first_list_element(site):
				Some(element): Ok(Builtins.ListSet(element))
				None: Err(builtin_error(site.span, BuiltinContractMismatch(parsed)))
		ListConcatBuiltin:
			match first_list_element(site):
				Some(element): Ok(Builtins.ListConcat(element))
				None: Err(builtin_error(site.span, BuiltinContractMismatch(parsed)))
		StringParseIntBuiltin: Ok(Builtins.StringParseInt(option))
		StringParseFloatBuiltin: Ok(Builtins.StringParseFloat(option))
		StringByteAtBuiltin: Ok(Builtins.StringByteAt(option))
		StringFromCodepointBuiltin: Ok(Builtins.StringFromCodepoint(option))
		StringSliceBuiltin: Ok(Builtins.StringSlice(option))
		ReadFileBuiltin: Ok(Builtins.ReadFile(site.designated.result))
		WriteFileBuiltin: Ok(Builtins.WriteFile(site.designated.result))
		GetCurrentDirectoryBuiltin: Ok(Builtins.GetCurrentDirectory(site.designated.result))
		StringEqualsBuiltin: Ok(Builtins.StringEquals(boolean))
		IntegerEqualsBuiltin: Ok(Builtins.IntEquals(boolean))
		IntegerLessThanBuiltin: Ok(Builtins.IntLessThan(boolean))
		FloatEqualsBuiltin: Ok(Builtins.FloatEquals(boolean))
		FloatLessThanBuiltin: Ok(Builtins.FloatLessThan(boolean))
		FloatIsNaNBuiltin: Ok(Builtins.FloatIsNaN(boolean))
		FloatIsFiniteBuiltin: Ok(Builtins.FloatIsFinite(boolean))
		_:
			primitive: Option[RuntimeOperation[VariantId, TypeRef]] = primitive_operation(parsed)
			match primitive:
				Some(operation): Ok(operation)
				None: Err(checker_invariant(site.span, RuntimeContractMismatch))


-- What validating one builtin body needs: its declaration and signature, and
-- the foundation designation its Bool and Option results refer to.
fixed record BuiltinSite {
	function: ParsedFunction,
	signature: FunctionSignature,
	designated: DesignatedUnions,
	span: Span
}


-- The checked type a runtime result denotes. Designated Option and Bool are
-- their constructors' owner; the foundation check accepted Option as generic
-- in its one payload and Bool as nongeneric.
private pure func runtime_result_type(result: RuntimeResult[VariantId, TypeRef]) -> TypeRef:
	match result:
		ValueResult(value_type): runtime_type_ref(value_type)
		OptionalResult(payload, option): AppliedUnionType(variant_owner(option.some), [runtime_type_ref(payload)])
		ResultResult(success, error, constructors): AppliedUnionType(variant_owner(constructors.ok), [runtime_type_ref(success), runtime_type_ref(error)])
		BooleanResult(boolean): UnionType(variant_owner(boolean.true_variant))


pure func validate_builtin_body(
	parsed: ParsedRuntimeOperation,
	site: BuiltinSite,
) -> Result[RuntimeOperation[VariantId, TypeRef], CheckError]:
	annotation: Void ?= match site.function.tail_annotation:
		Some(annotation):
			Err(builtin_error(annotation, BuiltinTailAnnotation))
		None:
			Ok(void)

	operation ?= accepted_operation(parsed, site)
	contract = runtime_contract(operation)
	signature = site.signature

	generic_header: Bool = match parsed:
		ListRepeatBuiltin | ListLengthBuiltin | ListGetBuiltin | ListAppendBuiltin | ListSetBuiltin | ListConcatBuiltin: True
		_: signature.type_parameters.is_empty()

	matches_contract = match generic_header:
		True:
			match same_purity(signature.purity, contract.purity):
				True:
					match same_types(
						signature.parameters.map(
							pure func(parameter: TypeUse) -> TypeRef: parameter.value_type,
						),
						contract.parameters.map(
							pure func(
								parameter: Builtins.RuntimeType[TypeRef],
							) -> TypeRef: runtime_type_ref(parameter),
						),
					):
						True: same_type(signature.return_type.value_type, runtime_result_type(contract.return_type))
						False: False
				False: False
		False: False

	if matches_contract:
		Ok(operation)
	else:
		Err(builtin_error(site.span, BuiltinContractMismatch(parsed)))


-- Bounds are resolved once at their written declaration. Body normalization
-- only attaches these accepted traits to the body's genuine parameter domain.
private pure func resolve_bounds(parameters: List[ParsedTypeParameter], scope: TypeScope) -> Result[List[List[LocatedTrait]], CheckError]:
	var resolved: List[List[LocatedTrait]] = []
	var failure: Option[CheckError] = None
	for parameter in parameters:
		var bounds: List[LocatedTrait] = []
		for written in parameter.bounds:
			match resolve_trait(scope.namespace, scope.module, written):
				Some(id): bounds = bounds.append({ required_trait = id, span = type_span(written) })
				None:
					failure = Some(trait_error(type_span(written), InvalidTraitBound))
					break
		resolved = resolved.append(bounds)
		if failure.is_some():
			break
	match failure:
		Some(error): Err(error)
		None: Ok(resolved)


private pure func body_requirements(bounds: List[List[LocatedTrait]], function: FunctionId) -> List[TraitRequirement]:
	var requirements: List[TraitRequirement] = []
	var position = 0
	for parameter in bounds:
		for bound in parameter:
			requirements = requirements.append({ parameter = type_parameter_id(FunctionDeclaration(function), position), required_trait = bound.required_trait, span = bound.span })
		position = IntOps.add(position, 1)
	requirements


-- Families have no parameter identity domain. Validate their source names here;
-- each actual body receives its own identities only during normalization.
private pure func receiver_parameters(parameters: List[ParsedTypeParameter], scope: TypeScope, self_name: NameId) -> Result[Void, CheckError]:
	var seen: List[WrittenName] = []
	var failure: Option[CheckError] = None
	for parameter in parameters:
		for previous in seen:
			if same_name(previous.id, parameter.name.id):
				failure = Some(trait_error(parameter.name.span, DuplicateReceiverParameter(previous)))
		if failure.is_none():
			if same_name(parameter.name.id, self_name):
				failure = Some(type_declaration_error(parameter.name.span, TypeParameterTypeNameConflict(parameter.name.id)))
			else:
				match named_type(scope.namespace, scope.module, parameter.name.id):
					Some(_): failure = Some(type_declaration_error(parameter.name.span, TypeParameterTypeNameConflict(parameter.name.id)))
					None: seen = seen.append(parameter.name)
		if failure.is_some():
			break
	match failure:
		Some(error): Err(error)
		None: Ok(void)


private pure func implementation_header(row: ImplRow, scope: TypeScope, parsed: ParsedContents) -> Result[ImplementationHeader, CheckError]:
	head ?= resolve_receiver_head(scope, row.header.receiver)
	arity ?= receiver_arity(scope, head, receiver_head_span(row.header.receiver))
	complete: Void ?= if IntOps.equals(arity, row.header.type_parameters.length()):
		Ok(void)
	else:
		Err(trait_error(receiver_head_span(row.header.receiver), ReceiverParameterCount(arity, row.header.type_parameters.length())))
	fresh ?= receiver_parameters(row.header.type_parameters, scope, contextual_words(parsed.names).self_word)
	bounds ?= resolve_bounds(row.header.type_parameters, scope)
	Ok({ receiver_head = head, parameter_bounds = bounds })


private pure func implementation_headers(parsed: ParsedContents, namespace: Namespace) -> Result[List[ImplementationHeader], CheckError]:
	var headers: List[ImplementationHeader] = []
	var failure: Option[CheckError] = None
	for row in inventory_implementations(parsed.declarations):
		scope: TypeScope = {
			records = inventory_records(parsed.declarations), unions = inventory_unions(parsed.declarations),
			namespace = namespace, module = row.header.module, access = PrivateTypeUse,
			parameters = [], self_binding = None
		}
		match implementation_header(row, scope, parsed):
			Ok(header): headers = headers.append(header)
			Err(error):
				failure = Some(error)
				break
	match failure:
		Some(error): Err(error)
		None: Ok(headers)


private pure func resolve_implementation_function(row: FunctionRow, implementation: ImplRow, header: ImplementationHeader, parsed: ParsedContents, role: SignatureRole, scope: TypeScope, designated: DesignatedUnions) -> Result[AcceptedFunction, CheckError]:
	ordinary: Void ?= match row.declaration.type_parameters:
		[first, ..._]: Err(trait_error(first.name.span, IndependentImplementationParameters))
		[]: Ok(void)
	var parameters: List[LocalTypeParameter] = []
	for parameter in implementation.header.type_parameters:
		parameters = parameters.append({ name = parameter.name, id = type_parameter_id(FunctionDeclaration(row.id), parameters.length()) })
	body_scope = { scope | parameters = parameters }
	identities = declared_parameters(body_scope)
	receiver ?= receiver_type(header.receiver_head, identities.map(pure func(id): ParameterType(id)))
		.to_result(checker_invariant(implementation.header.span, InvalidFunctionContract))
	normalized = { body_scope | self_binding = Some({ name = contextual_words(parsed.names).self_word, value_type = receiver }) }
	resolve_signature(row.declaration, row.id, role, normalized, identities, body_requirements(header.parameter_bounds, row.id), designated)


-- The default's written contract is accepted once in its trait domain.
-- Normalization changes only that domain to this genuine body's Self; source
-- annotations are neither reconstructed nor resolved a second time.
private pure func resolve_default_function(
	row: FunctionRow,
	owner: AcceptedTrait,
	method: AcceptedTraitMethod,
	parsed: ParsedContents,
	scope: TypeScope,
	designated: DesignatedUnions,
) -> Result[AcceptedFunction, CheckError]:
	self = type_parameter_id(FunctionDeclaration(row.id), 0)
	substitution: Substitution = { owner = TraitDeclaration(owner.id), values = [ParameterType(self)] }
	var parameters: List[TypeUse] = []
	var failure: Option[CheckError] = None
	for parameter in method.signature.parameters:
		match substitute_type(parameter.value_type, substitution, parameter.span):
			Ok(value_type): parameters = parameters.append({ parameter | value_type = value_type })
			Err(error):
				failure = Some(error)
				break
	ready: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	result ?= substitute_type(method.signature.return_type.value_type, substitution, method.signature.return_type.span)
	requirement: TraitRequirement = { parameter = self, required_trait = owner.id, span = row.declaration.function_name.span }
	signature: FunctionSignature = {
		type_parameters = [self], requirements = [requirement],
		purity = method.signature.purity, parameters = parameters,
		return_type = { method.signature.return_type | value_type = result }
	}
	body ?= accept_body(row.declaration, signature, designated)
	Ok({
		id = row.id, declaration = row.declaration, signature = signature,
		body_types = { scope | access = PrivateTypeUse, self_binding = Some({ name = contextual_words(parsed.names).self_word, value_type = ParameterType(self) }) },
		body = body
	})


private pure func resolve_function(row: FunctionRow, parsed: ParsedContents, headers: List[ImplementationHeader], contracts: List[AcceptedTrait], role: SignatureRole, scope: TypeScope, designated: DesignatedUnions) -> Result[AcceptedFunction, CheckError]:
	match row.role:
		FreeFunctionBody:
			resolve_free_function(row, role, scope, designated)
		ImplementationBody:
			var accepted: Result[AcceptedFunction, CheckError] = Err(checker_invariant(row.declaration.function_name.span, InvalidResolvedFunction(row.id)))
			for implementation in inventory_implementations(parsed.declarations):
				for member in implementation.methods:
					if IntOps.equals(function_number(member), function_number(row.id)):
						match headers.get(impl_number(implementation.id)):
							Some(header): accepted = resolve_implementation_function(row, implementation, header, parsed, role, scope, designated)
							None: void
			accepted
		TraitDefaultBody:
			var accepted: Result[AcceptedFunction, CheckError] = Err(checker_invariant(row.declaration.function_name.span, InvalidResolvedFunction(row.id)))
			for owner in contracts:
				for method in owner.methods:
					match method.default_body:
						Some(function):
							if IntOps.equals(function_number(function), function_number(row.id)):
								accepted = resolve_default_function(row, owner, method, parsed, scope, designated)
						None: void
			accepted



private pure func resolve_free_function(row: FunctionRow, role: SignatureRole, scope: TypeScope, designated: DesignatedUnions) -> Result[AcceptedFunction, CheckError]:
	generic_main: Void ?= match role:
		EntryFunction:
			match row.declaration.type_parameters.get(0):
				Some(name):
					Err(
						signature_error(
							name.name.span,
							GenericMain(type_parameter_id(FunctionDeclaration(row.id), 0)),
						),
					)
				None:
					Ok(void)
		HelperFunction:
			Ok(void)

	parameters ?= local_type_parameters(row.declaration.type_parameters.map(pure func(parameter): parameter.name), FunctionDeclaration(row.id), scope)
	bounds ?= resolve_bounds(row.declaration.type_parameters, parameters)
	resolve_signature(row.declaration, row.id, role, parameters, declared_parameters(parameters), body_requirements(bounds, row.id), designated)
