---
Recursion analyses over checked bodies: guaranteed self tail calls, and the
rejection of recursive calls that grow type arguments without bound.
---
import:
	result: Result methods
	bool: Bool methods
	./errors:
		CheckError, checker_invariant, or_checker_invariant, CheckerInvariant(InvalidFunctionContract),
		RecursionError(
			GenericTailRecursionUnsupported, GrowingRecursiveInstantiation, UnprovenTraitInstantiation, NoSelfRecursion,
			NonTailSelfCall, TailCallInNestedMatch,
		),
		recursion_error,
	./model:
		BodyOwner(DeclaredBody, LambdaBody, DerivedEqualityBody), AggregateId(RecordAggregate, UnionAggregate), NominalId(AggregateNominal, OpaqueNominal), body_calls, CanonicalEquality, AcceptedTraits, AcceptedImplementation, ImplementationTable, AcceptedMethodCall, ImplementedBody(AuthoredMethod, TraitDefault, StructuralEquality),
		CallTarget(TraitMethod, RuntimeFunction, UserFunction, CallableParameter, ValueCall),
		CheckedArm,
		CheckedBody(CheckedMatchBody, CheckedValueBody),
		CheckedCallOperand(ValueOperand, CallableOperand),
		CheckedCall, CallableChoice(MethodCallable, NamedCallable, ForwardedCallable, LambdaCallable, StoredCallable),
		CheckedExit(RecurWith, ReturnExpression),
		CheckedExpr,
		CheckedForm(MakeCallable, InvokeFunction, Match),
		CheckedFunction, CheckedLambda, CheckedConstant,
		CheckedStatement,
		TypeParameterId,
		TypeParameterOwner(FunctionDeclaration),
		TypeRef(TupleType, CallableType, NominalType, ListType, ParameterType),
		statement_expressions, body_callable_creations,
		type_parameter_id,
	../utils/ids: FunctionId, TraitId, TraitMethodId
	../namespace/namespace: TypeHead(PrimitiveHead, ListHead, RecordHead, UnionHead, OpaqueHead)
	./declarations: Substitution, substitute_type
	./traits: checked_implementation_table
	./instantiation_paths: InstantiationPath, PathOperation(KeepPath, PushPath, PopPath), PathBoundedness(BoundedPaths, UnboundedPaths), bound_instantiation_paths
	int: Int methods
	option: Option methods
	../utils/syntax: FunctionExecution(OrdinaryCalls, SelfTailLoop), ParsedFunction, Span, Purity, compiler_span


private pure func is_self_call(call: CheckedCall, current: FunctionId, traits: AcceptedTraits) -> Bool:
	match call.target:
		TraitMethod(method):
			match traits.method_body(method):
				Some(selected):
					match selected.body:
						DeclaredBody(function): function == current
						_: False
				None: False
		UserFunction(id, _):
			id == current
		RuntimeFunction(_) | CallableParameter(_) | ValueCall(_):
			False


-- The first direct self call among evaluated values, in evaluation order.
-- These checks traverse evaluated children, never recovering identity from names.
private pure func first_self_call(values: List[CheckedExpr], current: FunctionId, traits: AcceptedTraits) -> Option[Span]:
	var found: Option[Span] = None

	for value in values:
		found = value.self_call_in(current, traits)

		if found.is_some():
			break

	found


-- A node's children are evaluated before the node, so a call's arguments,
-- receiver first, are searched before the call itself. A self call anywhere in
-- a non-tail match is a non-tail call, so its arms are children too.
private pure func self_call_in(value: CheckedExpr, current: FunctionId, traits: AcceptedTraits) -> Option[Span]:
	match value.form.child_expressions().first_self_call(current, traits):
		Some(span):
			Some(span)
		None:
			match value.form:
				InvokeFunction(call):
					if call.is_self_call(current, traits):
						Some(value.span)
					else:
						None
				_:
					None


private pure func reject_self_calls(
	values: List[CheckedExpr],
	current: FunctionId, traits: AcceptedTraits,
) -> Result[Void, CheckError]:
	match values.first_self_call(current, traits):
		Some(span):
			Err(recursion_error(span, NonTailSelfCall(current)))
		None:
			Ok(void)


-- A returned value that is a direct self call; its receiver, if written as one,
-- is already the first argument.
private record TailCall {
	arguments: List[CheckedExpr],
	span: Span
}


private pure func tail_call(value: CheckedExpr, current: FunctionId, traits: AcceptedTraits) -> Option[TailCall]:
	match value.form:
		InvokeFunction(call):
			if call.is_self_call(current, traits):
				var arguments: List[CheckedExpr] = []
				for operand in call.operands:
					match operand:
						ValueOperand(argument): arguments = arguments.append(argument)
						CallableOperand(_, _, _): void
				Some({
					arguments = arguments,
					span = value.span,
				})
			else:
				None
		_:
			None


private pure func tail_exit(
	exit: CheckedExit,
	current: FunctionId, traits: AcceptedTraits,
) -> Result[CheckedExit, CheckError]:
	match exit:
		RecurWith(_, _):
			Ok(exit)
		ReturnExpression(value):
			match value.tail_call(current, traits):
				Some(call):
					match call.arguments.reject_self_calls(current, traits):
						Ok(valid): Ok(RecurWith(call.arguments, call.span))
						Err(error): Err(error)
				None:
					match value.nested_tail(current, traits):
						Ok(valid): Ok(exit)
						Err(error): Err(error)


-- A tail value other than a direct self call. A match there passes the tail
-- to each arm's value: a self call that is such a value needs a backedge out
-- of a join, which does not exist yet; a self call anywhere else is an
-- ordinary non-tail call.
private pure func nested_tail(value: CheckedExpr, current: FunctionId, traits: AcceptedTraits) -> Result[Void, CheckError]:
	match value.tail_call(current, traits):
		Some(call):
			Err(recursion_error(call.span, TailCallInNestedMatch))
		None:
			match value.form:
				Match(join):
					var checked = reject_self_calls([join.scrutinee], current, traits)
					for arm in join.arms:
						if checked.is_ok():
							checked = arm.statements.statement_expressions().reject_self_calls(current, traits)
						if checked.is_ok():
							checked = arm.value.nested_tail(current, traits)
					checked
				_:
					reject_self_calls([value], current, traits)


private pure func tail_arms(
	arms: List[CheckedArm],
	current: FunctionId, traits: AcceptedTraits,
	checked: List[CheckedArm],
) -> Result[List[CheckedArm], CheckError]:
	match arms.get(checked.length()):
		None:
			Ok(checked)
		Some(arm):
			match arm.statements.statement_expressions().reject_self_calls(current, traits):
				Ok(prefix):
					match arm.body.tail_exit(current, traits):
						Ok(exit):
							arms.tail_arms(
								current, traits,
								checked.append({ arm | body = exit }),
							)
						Err(error): Err(error)
				Err(error): Err(error)


private pure func recurs(exit: CheckedExit) -> Bool:
	match exit:
		RecurWith(_, _):
			True
		ReturnExpression(_):
			False


private pure func body_recurs(body: CheckedBody) -> Bool:
	match body:
		CheckedValueBody(exit):
			exit.recurs()
		CheckedMatchBody(matched):
			var found: Bool = False

			for arm in matched.arms:
				found = match found:
					True: True
					False: arm.body.recurs()

			found


record CheckedExecution {
	execution: FunctionExecution,
	body: CheckedBody
}


pure func check_execution(
	function: ParsedFunction,
	parameters: List[TypeParameterId],
	statements: List[CheckedStatement],
	body: CheckedBody,
	current: FunctionId, traits: AcceptedTraits,
) -> Result[CheckedExecution, CheckError]:
	match function.tail_annotation:
		None:
			Ok({
				execution = OrdinaryCalls,
				body = body,
			})
		Some(annotation):
			if parameters.is_empty():
				match statements.statement_expressions().reject_self_calls(current, traits):
					Ok(prefix):

						tail_body: Result[CheckedBody, CheckError] = match body:
							CheckedValueBody(value):
								match value.tail_exit(current, traits):
									Ok(exit): Ok(CheckedValueBody(exit))
									Err(error): Err(error)
							CheckedMatchBody(matched):
								match reject_self_calls([matched.scrutinee], current, traits):
									Ok(scrutinee):
										match matched.arms.tail_arms(current, traits, []):
											Ok(arms): Ok(CheckedMatchBody({ matched | arms = arms }))
											Err(error): Err(error)
									Err(error): Err(error)

						match tail_body:
							Ok(loop_body):

								if loop_body.body_recurs():
									Ok({
										execution = SelfTailLoop(annotation),
										body = loop_body,
									})
								else:
									Err(recursion_error(annotation, NoSelfRecursion))
							Err(error): Err(error)
					Err(error): Err(error)
			else:
				Err(recursion_error(annotation, GenericTailRecursionUnsupported))


-- A slot identifies an actual semantic constructor and ordered child. These
-- are never declaration-number-only symbols or physical layout identities.
private union ConstructorSlot:
	ListElement
	NominalArgument(NominalId, Int)
	TupleElement(Int, Int)
	CallableElement(Purity, Int, Int)


private union ConstructorOperation:
	PushConstructor(ConstructorSlot)
	PopConstructor(ConstructorSlot)


private record ParameterDependency {
	source: TypeParameterId,
	target: TypeParameterId,
	operations: List[ConstructorOperation],
	trait_derived: Bool,
	automatic: List[AggregateId],
	span: Span
}


private pure func append_dependencies(
	dependencies: List[ParameterDependency], argument: TypeRef,
	target: TypeParameterId, operations: List[ConstructorOperation],
	trait_derived: Bool, automatic: List[AggregateId], span: Span,
) -> List[ParameterDependency]:
	var collected = dependencies
	match argument:
		ParameterType(source):
			collected = collected.append({ source = source, target = target, operations = operations, trait_derived = trait_derived, automatic = automatic, span = span })
		_:
			children: List[TypeRef] = match argument:
				CallableType(_, parameters, result): parameters.append(result)
				TupleType(elements): elements
				ListType(element): [element]
				NominalType(_, arguments): arguments
				_: []
			var position = 0
			for child in children:
				slot: Option[ConstructorSlot] = match argument:
					CallableType(purity, parameters, _): Some(CallableElement(purity, parameters.length(), position))
					TupleType(elements): Some(TupleElement(elements.length(), position))
					ListType(_): Some(ListElement)
					NominalType(owner, _): Some(NominalArgument(owner, position))
					_: None
				match slot:
					Some(constructor):
						-- A top-first written path is pushed inside-out.
						push: ConstructorOperation = PushConstructor(constructor)
						collected = collected.append_dependencies(child, target, [push].concat(operations), trait_derived, automatic, span)
					None: void
				position = position + 1
	collected


private pure func contains_parameter_id(
	parameters: List[TypeParameterId],
	requested: TypeParameterId,
) -> Bool:
	var found: Bool = False

	for parameter in parameters:
		if parameter == requested:
			found = True
			break

	found


-- Whether a dependency path leads from `start` to `target`.
private pure func parameter_reaches(
	start: TypeParameterId,
	target: TypeParameterId,
	dependencies: List[ParameterDependency],
) -> Bool:
	var reached = [start]
	var frontier = [start]

	while frontier.is_empty().not():
		var next: List[TypeParameterId] = []

		for current in frontier:
			for dependency in dependencies:
				unreached_dependency: Bool = match dependency.trait_derived.not().and(dependency.source == current):
					True: reached.contains_parameter_id(dependency.target).not()
					False: False

				if unreached_dependency:
					reached = reached.append(dependency.target)
					next = next.append(dependency.target)

		frontier = next

	reached.contains_parameter_id(target)


private pure func automatic_origin(implementation: AcceptedImplementation) -> List[AggregateId]:
	var origin: List[AggregateId] = []
	for member in implementation.methods:
		match member.body:
			StructuralEquality(aggregate, template):
				if template.signature.type_parameters.is_empty().not():
					origin = [aggregate]
			_: void
	origin


private pure func with_origins(previous: List[AggregateId], added: List[AggregateId]) -> List[AggregateId]:
	var result = previous
	for aggregate in added:
		if result.any(pure func(existing): existing == aggregate).not():
			result = result.append(aggregate)
	result


private pure func receiver_slot(head: TypeHead, position: Int) -> Option[ConstructorSlot]:
	match head:
		ListHead: Some(ListElement)
		RecordHead(owner): Some(NominalArgument(AggregateNominal(RecordAggregate(owner)), position))
		UnionHead(owner): Some(NominalArgument(AggregateNominal(UnionAggregate(owner)), position))
		OpaqueHead(owner): Some(NominalArgument(OpaqueNominal(owner), position))
		PrimitiveHead(_): None


private pure func append_method_dependencies(
	previous: List[ParameterDependency], method: AcceptedMethodCall,
	traits: AcceptedTraits, automatic: List[AggregateId], span: Span,
) -> List[ParameterDependency]:
	var dependencies = previous
	match traits.method_body(method):
		Some(selected):
			var origins = automatic
			match method.method_receiver().type_head():
				Some(head):
					match traits.family_for(method.method_identity().trait_method_owner(), head):
						Some(family): origins = origins.with_origins(family.automatic_origin())
						None: void
				None: void
			var position = 0
			for argument in selected.arguments:
				match selected.body:
					DeclaredBody(function): dependencies = dependencies.append_dependencies(argument, type_parameter_id(FunctionDeclaration(function), position), [], True, origins, span)
					DerivedEqualityBody(aggregate): dependencies = dependencies.append_dependencies(argument, type_parameter_id(aggregate.aggregate_owner(), position), [], True, origins, span)
					LambdaBody(_): void
				position = position + 1
		None:
			match method.method_receiver():
				ParameterType(_):
					for implementation in traits.implementations.implementation_rows():
						origins = automatic.with_origins(implementation.automatic_origin())
						for member in implementation.methods:
							if member.method == method.method_identity():
								for position in 0..implementation.parameter_bounds.length():
									match implementation.receiver_head.receiver_slot(position):
										Some(slot):
											pop: ConstructorOperation = PopConstructor(slot)
											match member.body:
												AuthoredMethod(function): dependencies = dependencies.append_dependencies(method.method_receiver(), type_parameter_id(FunctionDeclaration(function), position), [pop], True, origins, span)
												StructuralEquality(aggregate, _): dependencies = dependencies.append_dependencies(method.method_receiver(), type_parameter_id(aggregate.aggregate_owner(), position), [pop], True, origins, span)
												TraitDefault(function):
													-- Keep the complete Self, including phantom arguments,
													-- but only after matching this exact head/slot.
													push: ConstructorOperation = PushConstructor(slot)
													dependencies = dependencies.append_dependencies(method.method_receiver(), type_parameter_id(FunctionDeclaration(function), 0), [pop, push], True, origins, span)
										None: void
				_: void
	dependencies


private pure func append_named_dependencies(
	previous: List[ParameterDependency], id: FunctionId, types: List[TypeRef],
	automatic: List[AggregateId], span: Span,
) -> List[ParameterDependency]:
	var dependencies = previous
	var position = 0
	for value in types:
		dependencies = dependencies.append_dependencies(value, type_parameter_id(FunctionDeclaration(id), position), [], False, automatic, span)
		position = position + 1
	dependencies


private pure func append_choice_dependencies(
	previous: List[ParameterDependency], choice: CallableChoice, traits: AcceptedTraits,
	automatic: List[AggregateId], span: Span,
) -> List[ParameterDependency]:
	match choice:
		MethodCallable(method): previous.append_method_dependencies(method, traits, automatic, span)
		NamedCallable(id, types): previous.append_named_dependencies(id, types, automatic, span)
		ForwardedCallable(_) | StoredCallable(_) | LambdaCallable(_, _): previous


private pure func append_call_dependencies(
	previous: List[ParameterDependency], calls: List[CheckedCall],
	traits: AcceptedTraits, automatic: List[AggregateId],
) -> List[ParameterDependency]:
	var dependencies = previous
	for call in calls:
		match call.target:
			TraitMethod(method): dependencies = dependencies.append_method_dependencies(method, traits, automatic, call.span)
			UserFunction(declaration, arguments): dependencies = dependencies.append_named_dependencies(declaration, arguments, automatic, call.span)
			RuntimeFunction(_) | CallableParameter(_) | ValueCall(_): void
		-- Callable creation is independent of the target accepting the callback.
		for operand in call.operands:
			match operand:
				CallableOperand(_, choice, span): dependencies = dependencies.append_choice_dependencies(choice, traits, automatic, span)
				ValueOperand(_): void
	dependencies


private pure func append_creation_dependencies(
	previous: List[ParameterDependency], creations: List[CheckedExpr],
	traits: AcceptedTraits, automatic: List[AggregateId],
) -> List[ParameterDependency]:
	var dependencies = previous
	for value in creations:
		match value.form:
			MakeCallable(choice): dependencies = dependencies.append_choice_dependencies(choice, traits, automatic, value.span)
			_: void
	dependencies


private record IssuedDependency {
	path: InstantiationPath,
	trait_derived: Bool,
	automatic: List[AggregateId],
	span: Span
}


private record DependencyGraph {
	controls: Int,
	edges: List[IssuedDependency]
}


private pure func parameter_index(parameters: List[TypeParameterId], requested: TypeParameterId) -> Int:
	var position = 0
	for parameter in parameters:
		if parameter == requested:
			break
		position = position + 1
	position


-- Each genuine parameter receives one control. Private intermediate controls
-- belong to one written operation word; no semantic ID is manufactured.
private pure func dependency_graph(dependencies: List[ParameterDependency]) -> DependencyGraph:
	var parameters: List[TypeParameterId] = []
	for dependency in dependencies:
		for parameter in [dependency.source, dependency.target]:
			if parameters.contains_parameter_id(parameter).not():
				parameters = parameters.append(parameter)
	var symbols: List[ConstructorSlot] = []
	var controls = parameters.length()
	var edges: List[IssuedDependency] = []
	for dependency in dependencies:
		var source = parameters.parameter_index(dependency.source)
		target = parameters.parameter_index(dependency.target)
		if dependency.operations.is_empty():
			edges = edges.append({ path = { source = source, target = target, operation = KeepPath }, trait_derived = dependency.trait_derived, automatic = dependency.automatic, span = dependency.span })
		else:
			var position = 0
			for written in dependency.operations:
				slot: ConstructorSlot = match written:
					PushConstructor(value): value
					PopConstructor(value): value
				var symbol = 0
				for existing in symbols:
					if existing == slot:
						break
					symbol = symbol + 1
				if symbol == symbols.length():
					symbols = symbols.append(slot)
				operation: PathOperation = match written:
					PushConstructor(_): PushPath(symbol)
					PopConstructor(_): PopPath(symbol)
				position = position + 1
				var next_control = target
				if position < dependency.operations.length():
					next_control = controls
					controls = controls + 1
				edges = edges.append({ path = { source = source, target = next_control, operation = operation }, trait_derived = dependency.trait_derived, automatic = dependency.automatic, span = dependency.span })
				source = next_control
	{ controls = controls, edges = edges }


private pure func bound_dependencies(graph: DependencyGraph) -> Result[PathBoundedness, CheckError]:
	paths: List[InstantiationPath] = graph.edges.map(pure func(edge): edge.path)
	bound_instantiation_paths(graph.controls, paths).or_checker_invariant(compiler_span(), InvalidFunctionContract)


private pure func validate_base_dependencies(dependencies: List[ParameterDependency]) -> Result[Void, CheckError]:
	var growing: Option[Span] = None
	for dependency in dependencies:
		-- Ordinary substitutions contain only pushes, so a nonempty
		-- word is exactly the original positive-growth condition.
		if dependency.trait_derived.not().and(dependency.operations.is_empty().not().and(dependency.target.parameter_reaches(dependency.source, dependencies))):
			growing = Some(dependency.span)
			break
	_: Void ?= match growing:
		Some(span): Err(recursion_error(span, GrowingRecursiveInstantiation))
		None: Ok(void)
	-- Trait-free inputs need only the existing ordinary check, not closure.
	if dependencies.any(pure func(dependency) -> Bool: dependency.trait_derived):
		graph = dependencies.dependency_graph()
		match graph.bound_dependencies():
			Err(error): Err(error)
			Ok(BoundedPaths): Ok(void)
			Ok(UnboundedPaths(marked)):
				var failure: Option[Span] = None
				var position = 0
				for edge in graph.edges:
					edge_position = position
					if edge.trait_derived.and(marked.any(pure func(found): found == edge_position)):
						failure = Some(edge.span)
						break
					position = position + 1
				match failure:
					Some(span): Err(recursion_error(span, UnprovenTraitInstantiation))
					None: Err(checker_invariant(compiler_span(), InvalidFunctionContract))
	else:
		Ok(void)


-- This returns only candidate-specific finite causes. Check's final use
-- validation must consume them before publishing the pruned accepted rows.
pure func validate_recursive_instantiation(
	functions: List[CheckedFunction], lambdas: List[CheckedLambda], traits: AcceptedTraits,
) -> Result[List[AggregateId], CheckError]:
	var dependencies: List[ParameterDependency] = []
	for function in functions:
		dependencies = dependencies.append_call_dependencies(function.function_calls(), traits, [])
		dependencies = dependencies.append_creation_dependencies(function.statements.body_callable_creations(function.body), traits, [])
	for lambda in lambdas:
		dependencies = dependencies.append_call_dependencies(lambda.lambda_calls(), traits, [])
		dependencies = dependencies.append_creation_dependencies(lambda.statements.body_callable_creations(lambda.body), traits, [])
	for implementation in traits.implementations.implementation_rows():
		for member in implementation.methods:
			match member.body:
				StructuralEquality(_, template):
					origins = implementation.automatic_origin()
					dependencies = dependencies.append_call_dependencies(body_calls([], template.body), traits, origins)
					dependencies = dependencies.append_creation_dependencies(body_callable_creations([], template.body), traits, origins)
				_: void
	base = dependencies.filter(pure func(dependency): dependency.automatic.is_empty())
	_: Void ?= base.validate_base_dependencies()
	if dependencies.any(pure func(dependency): dependency.automatic.is_empty().not()):
		graph = dependencies.dependency_graph()
		match graph.bound_dependencies():
			Err(error): Err(error)
			Ok(BoundedPaths): Ok([])
			Ok(UnboundedPaths(marked)):
				var unavailable: List[AggregateId] = []
				var invalid: Option[CheckError] = None
				for position in marked:
					match graph.edges.get(position):
						Some(edge): unavailable = unavailable.with_origins(edge.automatic)
						None: invalid = Some(checker_invariant(compiler_span(), InvalidFunctionContract))
				match invalid:
					Some(error): Err(error)
					None: Ok(unavailable)
	else:
		Ok([])


-- Earlier Check already proved these obligations. This projection asks ONLY
-- whether one reaches a newly unavailable automatic family, never reproves
-- ordinary capability or infers an assumption on a rigid parameter.
private pure func unavailable_goal(
	traits: AcceptedTraits, unavailable: List[AggregateId],
	required: TraitId, receiver: TypeRef, span: Span,
) -> Result[Bool, CheckError]:
	var blocked: Bool = False
	var invalid: Option[CheckError] = None
	match receiver.type_head():
		None: void
		Some(head):
			canonical: Bool = match traits.canonical.equality:
				Some(owner): owner.canonical_owner() == required
				None: False
			blocked = canonical.and(unavailable.any(pure func(aggregate): head == aggregate.aggregate_head()))
			if blocked.not():
				match traits.family_for(required, head):
					None: void
					Some(family):
						arguments = receiver.receiver_arguments()
						var position = 0
						for bounds in family.parameter_bounds:
							match arguments.get(position):
								None: invalid = Some(checker_invariant(span, InvalidFunctionContract))
								Some(argument):
									for bound in bounds:
										match traits.unavailable_goal(unavailable, bound.required_trait, argument, span):
											Ok(value): blocked = value
											Err(error): invalid = Some(error)
										if blocked.or(invalid.is_some()):
											break
							if blocked.or(invalid.is_some()):
								break
							position = position + 1
	match invalid:
		Some(error): Err(error)
		None: Ok(blocked)


private pure func unavailable_named(
	functions: List[CheckedFunction], traits: AcceptedTraits, unavailable: List[AggregateId],
	id: FunctionId, arguments: List[TypeRef], span: Span,
) -> Result[Bool, CheckError]:
	function ?= functions.get(id.function_number()).or_checker_invariant(span, InvalidFunctionContract)
	var blocked: Bool = False
	var invalid: Option[CheckError] = None
	for required in function.signature.requirements:
		substitution: Substitution = { owner = required.parameter.parameter_owner(), values = arguments }
		match substitute_type(ParameterType(required.parameter), substitution, span):
			Err(error): invalid = Some(error)
			Ok(receiver):
				match traits.unavailable_goal(unavailable, required.required_trait, receiver, span):
					Ok(value): blocked = value
					Err(error): invalid = Some(error)
		if blocked.or(invalid.is_some()):
			break
	match invalid:
		Some(error): Err(error)
		None: Ok(blocked)


private pure func unavailable_choice(
	functions: List[CheckedFunction], traits: AcceptedTraits, unavailable: List[AggregateId],
	choice: CallableChoice, span: Span,
) -> Result[Bool, CheckError]:
	match choice:
		MethodCallable(method): traits.unavailable_goal(unavailable, method.method_identity().trait_method_owner(), method.method_receiver(), span)
		NamedCallable(id, arguments): functions.unavailable_named(traits, unavailable, id, arguments, span)
		ForwardedCallable(_) | StoredCallable(_) | LambdaCallable(_, _): Ok(False)


private pure func earlier_unproven(previous: Option[CheckError], span: Span) -> Option[CheckError]:
	match previous:
		None: Some(recursion_error(span, UnprovenTraitInstantiation))
		Some(error):
			if (error.span.source == span.source).and(span.start < error.span.start):
				Some(recursion_error(span, UnprovenTraitInstantiation))
			else:
				previous


private pure func unavailable_uses(
	functions: List[CheckedFunction], traits: AcceptedTraits, unavailable: List[AggregateId],
	calls: List[CheckedCall], creations: List[CheckedExpr],
) -> Result[Option[CheckError], CheckError]:
	var first: Option[CheckError] = None
	var invalid: Option[CheckError] = None
	for call in calls:
		blocked: Result[Bool, CheckError] = match call.target:
			UserFunction(id, arguments): functions.unavailable_named(traits, unavailable, id, arguments, call.span)
			TraitMethod(method): traits.unavailable_goal(unavailable, method.method_identity().trait_method_owner(), method.method_receiver(), call.span)
			RuntimeFunction(_) | CallableParameter(_) | ValueCall(_): Ok(False)
		match blocked:
			Err(error): invalid = Some(error)
			Ok(True): first = first.earlier_unproven(call.span)
			Ok(False): void
		for operand in call.operands:
			match operand:
				ValueOperand(_): void
				CallableOperand(_, choice, span):
					match functions.unavailable_choice(traits, unavailable, choice, span):
						Err(error): invalid = Some(error)
						Ok(True): first = first.earlier_unproven(span)
						Ok(False): void
	for value in creations:
		match value.form:
			MakeCallable(choice):
				match functions.unavailable_choice(traits, unavailable, choice, value.span):
					Err(error): invalid = Some(error)
					Ok(True): first = first.earlier_unproven(value.span)
					Ok(False): void
			_: void
	match invalid:
		Some(error): Err(error)
		None: Ok(first)


-- The surviving implementations and the removed automatic equalities. Only
-- finalize_trait_instances builds one; supertraits.brp says why that matters.
private record FinalTraitContents {
	traits: AcceptedTraits,
	removed: List[AggregateId]
}
opaque type FinalTraits = FinalTraitContents


pure func final_traits(final: FinalTraits) -> AcceptedTraits:
	from_opaque FinalTraits(final).traits


pure func removed_equalities(final: FinalTraits) -> List[AggregateId]:
	from_opaque FinalTraits(final).removed


private pure func blocked_by_unavailable_equality(implementation: AcceptedImplementation, unavailable: List[AggregateId]) -> Bool:
	implementation.methods.any(pure func(member) -> Bool:
		match member.body:
			StructuralEquality(aggregate, _): unavailable.any(pure func(existing): existing == aggregate)
			_: False
	)


-- Complete the new-auto availability once, then validate source uses before
-- sealing. Generated templates propagate failure privately; authored/default
-- bodies, constants and lambdas remain checked even without a reachable caller.
pure func finalize_trait_instances(
	constants: List[CheckedConstant], functions: List[CheckedFunction],
	lambdas: List[CheckedLambda], traits: AcceptedTraits,
	initially_unavailable: List[AggregateId],
) -> Result[FinalTraits, CheckError]:
	var unavailable = initially_unavailable
	var invalid: Option[CheckError] = None
	var changed: Bool = initially_unavailable.is_empty().not()
	while changed.and(invalid.is_none()):
		changed = False
		for implementation in traits.implementations.implementation_rows():
			for member in implementation.methods:
				match member.body:
					StructuralEquality(aggregate, template):
						if unavailable.any(pure func(existing): existing == aggregate).not():
							match functions.unavailable_uses(traits, unavailable, body_calls([], template.body), body_callable_creations([], template.body)):
								Err(error): invalid = Some(error)
								Ok(Some(_)):
									unavailable = unavailable.append(aggregate)
									changed = True
								Ok(None): void
					_: void
	_: Void ?= match invalid:
		Some(error): Err(error)
		None: Ok(void)
	var first: Option[CheckError] = None
	if unavailable.is_empty().not():
		for constant in constants:
			if first.is_none():
				match functions.unavailable_uses(traits, unavailable, constant.value.expression_calls(), constant.value.expression_callable_creations()):
					Err(error): invalid = Some(error)
					Ok(error): first = error
		for function in functions:
			if first.is_none():
				match functions.unavailable_uses(traits, unavailable, function.function_calls(), function.statements.body_callable_creations(function.body)):
					Err(error): invalid = Some(error)
					Ok(error): first = error
		for lambda in lambdas:
			if first.is_none():
				match functions.unavailable_uses(traits, unavailable, lambda.lambda_calls(), lambda.statements.body_callable_creations(lambda.body)):
					Err(error): invalid = Some(error)
					Ok(error): first = error
	_: Void ?= match invalid:
		Some(error): Err(error)
		None:
			match first:
				Some(error): Err(error)
				None: Ok(void)
	final_unavailable = unavailable
	implementations: ImplementationTable ?= if final_unavailable.is_empty():
		Ok(traits.implementations)
	else:
		checked_implementation_table(traits.implementations.implementation_rows().filter(pure func(implementation): implementation.blocked_by_unavailable_equality(final_unavailable).not()))
	Ok(into_opaque FinalTraits({ traits = { traits | implementations = implementations }, removed = final_unavailable }))
