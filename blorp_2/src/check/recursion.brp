---
Recursion analyses over checked bodies: guaranteed self tail calls, and the
rejection of recursive calls that grow type arguments without bound.
---
import:
	result: is_ok
	../utils/boolean: not
	./errors:
		CheckError,
		RecursionError(
			GenericTailRecursionUnsupported, GrowingRecursiveInstantiation, NoSelfRecursion,
			NonTailSelfCall, TailCallInNestedMatch,
		),
		recursion_error,
	./model:
		CallTarget(RuntimeFunction, UserFunction, CallableParameter, ValueCall),
		CheckedArm,
		CheckedBody(CheckedMatchBody, CheckedValueBody),
		CheckedCallOperand(ValueOperand, CallableOperand),
		CheckedCall, CallableChoice(NamedCallable, ForwardedCallable, LambdaCallable, StoredCallable),
		CheckedExit(RecurWith, ReturnExpression),
		CheckedExpr,
		CheckedForm(
			MakeCallable,
			ConstructOpaque, ProjectOpaque,
			ConstructRecord, ConstructVariant, ConstructList, InvokeFunction, LiteralFloat, LiteralInteger,
			LiteralString, LiteralVoid, Match, ReadBinding, ReadCapture, ReadRecordField, UpdateRecord,
		),
		CheckedFunction, CheckedLambda,
		CheckedStatement(DiscardExpression, InitializeBinding, ReassignBinding, RunWhile, RunFor, BreakSourceLoop, ContinueSourceLoop),
		CheckedIteration(ListIteration, AscendingIntRange),
		TypeParameterId,
		TypeParameterOwner(FunctionDeclaration),
		TypeRef(CallableType, AppliedUnionType, AppliedRecordType, ListType, ParameterType),
		function_calls, lambda_calls, body_callable_creations,
		same_parameter,
		type_parameter_id,
	../utils/ids: FunctionId, function_number
	int as IntOps
	option: is_some, is_none
	../utils/syntax: FunctionExecution(OrdinaryCalls, SelfTailLoop), ParsedFunction, Span


private pure func is_self_call(call: CheckedCall, current: FunctionId) -> Bool:
	match call.target:
		UserFunction(id, _):
			IntOps.equals(function_number(id), function_number(current))
		RuntimeFunction(_) | CallableParameter(_) | ValueCall(_):
			False


-- The first direct self call among evaluated values, in evaluation order.
-- These checks traverse evaluated children, never recovering identity from names.
private pure func first_self_call(values: List[CheckedExpr], current: FunctionId) -> Option[Span]:
	var found: Option[Span] = None

	for value in values:
		found = self_call_in(value, current)

		if found.is_some():
			break

	found


-- A node's children are evaluated before the node, so a call's arguments,
-- receiver first, are searched before the call itself.
private pure func self_call_in(value: CheckedExpr, current: FunctionId) -> Option[Span]:
	match value.form:
		ConstructOpaque(_, child):
			self_call_in(child, current)
		ProjectOpaque(_, child):
			self_call_in(child, current)
		InvokeFunction(call):
			var found: Option[Span] = match call.target:
				ValueCall(callee): self_call_in(callee, current)
				UserFunction(_, _) | RuntimeFunction(_) | CallableParameter(_): None
			for operand in call.operands:
				if found.is_some():
					break
				match operand:
					ValueOperand(argument): found = self_call_in(argument, current)
					CallableOperand(_, choice, _):
						match choice:
							StoredCallable(child): found = self_call_in(child, current)
							NamedCallable(_, _) | ForwardedCallable(_) | LambdaCallable(_, _): void
			match found:
				Some(span):
					Some(span)
				None:
					if is_self_call(call, current):
						Some(value.span)
					else:
						None
		ConstructVariant(_, fields):
			first_self_call(fields, current)
		ConstructList(elements):
			first_self_call(elements, current)
		Match(join):
			-- A self call anywhere in a non-tail match is a non-tail call.
			var found = self_call_in(join.scrutinee, current)
			for arm in join.arms:
				if found.is_none():
					found = first_self_call(statement_values(arm.statements).append(arm.value), current)
			found
		ConstructRecord(_, fields):
			var found: Option[Span] = None
			for field in fields:
				if found.is_some():
					break
				found = self_call_in(field.value, current)
			found
		UpdateRecord(_, update):
			var found = self_call_in(update.base, current)
			for field in update.replacements:
				if found.is_some():
					break
				found = self_call_in(field.value, current)
			found
		ReadRecordField(receiver, _):
			self_call_in(receiver, current)
		MakeCallable(choice):
			match choice:
				StoredCallable(operand): self_call_in(operand, current)
				NamedCallable(_, _) | ForwardedCallable(_) | LambdaCallable(_, _): None
		LiteralVoid | LiteralInteger(_) | LiteralFloat(_) | LiteralString(_) | ReadBinding(_) | ReadCapture(_):
			None


private pure func reject_self_calls(
	values: List[CheckedExpr],
	current: FunctionId,
) -> Result[Void, CheckError]:
	match first_self_call(values, current):
		Some(span):
			Err(recursion_error(span, NonTailSelfCall(current)))
		None:
			Ok(void)


private pure func statement_values(statements: List[CheckedStatement]) -> List[CheckedExpr]:
	var values: List[CheckedExpr] = []
	for statement in statements:
		match statement:
			InitializeBinding(_, value):
				values = values.append(value)
			ReassignBinding(_, value):
				values = values.append(value)
			DiscardExpression(value):
				values = values.append(value)
			RunWhile(loop):
				values = values.append(loop.condition).concat(statement_values(loop.body))
			BreakSourceLoop(_) | ContinueSourceLoop(_): void
			RunFor(loop):
				match loop.iteration:
					ListIteration(iterable, _, _): values = values.append(iterable)
					AscendingIntRange(start, end, _): values = values.append(start).append(end)
				values = values.concat(statement_values(loop.body))
	values


-- A returned value that is a direct self call; its receiver, if written as one,
-- is already the first argument.
private fixed record TailCall {
	arguments: List[CheckedExpr],
	span: Span
}


private pure func tail_call(value: CheckedExpr, current: FunctionId) -> Option[TailCall]:
	match value.form:
		InvokeFunction(call):
			if is_self_call(call, current):
				var arguments: List[CheckedExpr] = []
				for operand in call.operands:
					match operand:
						ValueOperand(argument): arguments = arguments.append(argument)
						CallableOperand(_, _, _): void
				Some({
					arguments = arguments,
					span = value.span,
				})
			else:
				None
		_:
			None


private pure func tail_exit(
	exit: CheckedExit,
	current: FunctionId,
) -> Result[CheckedExit, CheckError]:
	match exit:
		RecurWith(_, _):
			Ok(exit)
		ReturnExpression(value):
			match tail_call(value, current):
				Some(call):
					match reject_self_calls(call.arguments, current):
						Ok(valid): Ok(RecurWith(call.arguments, call.span))
						Err(error): Err(error)
				None:
					match nested_tail(value, current):
						Ok(valid): Ok(exit)
						Err(error): Err(error)


-- A tail value other than a direct self call. A match there passes the tail
-- to each arm's value: a self call that is such a value needs a backedge out
-- of a join, which does not exist yet; a self call anywhere else is an
-- ordinary non-tail call.
private pure func nested_tail(value: CheckedExpr, current: FunctionId) -> Result[Void, CheckError]:
	match tail_call(value, current):
		Some(call):
			Err(recursion_error(call.span, TailCallInNestedMatch))
		None:
			match value.form:
				Match(join):
					var checked = reject_self_calls([join.scrutinee], current)
					for arm in join.arms:
						if checked.is_ok():
							checked = reject_self_calls(statement_values(arm.statements), current)
						if checked.is_ok():
							checked = nested_tail(arm.value, current)
					checked
				_:
					reject_self_calls([value], current)


private pure func tail_arms(
	arms: List[CheckedArm],
	current: FunctionId,
	checked: List[CheckedArm],
) -> Result[List[CheckedArm], CheckError]:
	match arms.get(checked.length()):
		None:
			Ok(checked)
		Some(arm):
			match reject_self_calls(statement_values(arm.statements), current):
				Ok(prefix):
					match tail_exit(arm.body, current):
						Ok(exit):
							tail_arms(
								arms,
								current,
								checked.append({ arm | body = exit }),
							)
						Err(error): Err(error)
				Err(error): Err(error)


private pure func recurs(exit: CheckedExit) -> Bool:
	match exit:
		RecurWith(_, _):
			True
		ReturnExpression(_):
			False


private pure func body_recurs(body: CheckedBody) -> Bool:
	match body:
		CheckedValueBody(exit):
			recurs(exit)
		CheckedMatchBody(matched):
			var found: Bool = False

			for arm in matched.arms:
				found = match found:
					True: True
					False: recurs(arm.body)

			found


fixed record CheckedExecution {
	execution: FunctionExecution,
	body: CheckedBody
}


pure func check_execution(
	function: ParsedFunction,
	statements: List[CheckedStatement],
	body: CheckedBody,
	current: FunctionId,
) -> Result[CheckedExecution, CheckError]:
	match function.tail_annotation:
		None:
			Ok({
				execution = OrdinaryCalls,
				body = body,
			})
		Some(annotation):
			if IntOps.equals(function.type_parameters.length(), 0):
				match reject_self_calls(statement_values(statements), current):
					Ok(prefix):

						tail_body: Result[CheckedBody, CheckError] = match body:
							CheckedValueBody(value):
								match tail_exit(value, current):
									Ok(exit): Ok(CheckedValueBody(exit))
									Err(error): Err(error)
							CheckedMatchBody(matched):
								match reject_self_calls([matched.scrutinee], current):
									Ok(scrutinee):
										match tail_arms(matched.arms, current, []):
											Ok(arms): Ok(CheckedMatchBody({ matched | arms = arms }))
											Err(error): Err(error)
									Err(error): Err(error)

						match tail_body:
							Ok(loop_body):

								if body_recurs(loop_body):
									Ok({
										execution = SelfTailLoop(annotation),
										body = loop_body,
									})
								else:
									Err(recursion_error(annotation, NoSelfRecursion))
							Err(error): Err(error)
					Err(error): Err(error)
			else:
				Err(recursion_error(annotation, GenericTailRecursionUnsupported))


private fixed union ParameterGrowth:
	PreservedParameter
	NestedParameter


private fixed record ParameterDependency {
	source: TypeParameterId,
	target: TypeParameterId,
	growth: ParameterGrowth,
	span: Span
}


private pure func append_dependencies(
	dependencies: List[ParameterDependency],
	argument: TypeRef,
	target: TypeParameterId,
	growth: ParameterGrowth,
	span: Span,
) -> List[ParameterDependency]:
	var collected = dependencies

	match argument:
		ParameterType(source):
			collected = collected.append({
				source = source,
				target = target,
				growth = growth,
				span = span,
			})
		CallableType(purity, parameters, result):
			for value in parameters.append(result):
				collected = append_dependencies(collected, value, target, NestedParameter, span)
		ListType(element):
			collected = append_dependencies(collected, element, target, NestedParameter, span)
		AppliedRecordType(_, arguments):
			for child in arguments:
				collected = append_dependencies(collected, child, target, NestedParameter, span)
		AppliedUnionType(_, arguments):
			for child in arguments:
				collected = append_dependencies(collected, child, target, NestedParameter, span)
		_:
			void

	collected


private pure func contains_parameter_id(
	parameters: List[TypeParameterId],
	requested: TypeParameterId,
) -> Bool:
	var found: Bool = False

	for parameter in parameters:
		if same_parameter(parameter, requested):
			found = True
			break

	found


-- Whether a dependency path leads from `start` to `target`.
private pure func parameter_reaches(
	start: TypeParameterId,
	target: TypeParameterId,
	dependencies: List[ParameterDependency],
) -> Bool:
	var reached = [start]
	var frontier = [start]

	while frontier.is_empty().not():
		var next: List[TypeParameterId] = []

		for current in frontier:
			for dependency in dependencies:
				unreached_dependency = match same_parameter(dependency.source, current):
					True: contains_parameter_id(reached, dependency.target).not()
					False: False

				if unreached_dependency:
					reached = reached.append(dependency.target)
					next = next.append(dependency.target)

		frontier = next

	contains_parameter_id(reached, target)


pure func validate_recursive_instantiation(
	functions: List[CheckedFunction], lambdas: List[CheckedLambda],
) -> Result[Void, CheckError]:
	-- These transient edges relate declaration-owned parameter identities, using
	-- each checked call's simultaneous substitution. They are discarded before
	-- publication; CheckedCall remains the sole authority for that substitution.
	-- A concrete type can grow indefinitely only if a parameter flows around a
	-- dependency cycle beneath an application. Cycles of bare parameters merely
	-- permute finite inputs; concrete resets terminate a dependency path. Without
	-- a growing cycle, type-term depth is bounded. Finite constructors, arities
	-- and ground leaves therefore bound all concrete instance keys.
	var dependencies: List[ParameterDependency] = []

	for function in functions:
		dependencies = append_call_dependencies(dependencies, function_calls(function))
		dependencies = append_creation_dependencies(dependencies, body_callable_creations(function.statements, function.body))
	-- Potential calls include ignored and nested lambdas, independently of runtime selection.
	for lambda in lambdas:
		dependencies = append_call_dependencies(dependencies, lambda_calls(lambda))
		dependencies = append_creation_dependencies(dependencies, body_callable_creations(lambda.statements, lambda.body))

	var growing: Option[ParameterDependency] = None

	for dependency in dependencies:
		match dependency.growth:
			NestedParameter:
				if parameter_reaches(dependency.target, dependency.source, dependencies):
					growing = Some(dependency)
					break
			PreservedParameter:
				void

	match growing:
		Some(dependency):
			Err(recursion_error(dependency.span, GrowingRecursiveInstantiation))
		None:
			Ok(void)


private pure func append_call_dependencies(
	previous: List[ParameterDependency], calls: List[CheckedCall],
) -> List[ParameterDependency]:
	var dependencies = previous
	for call in calls:
		match call.target:
			UserFunction(declaration, arguments):
				var position = 0

				for argument in arguments:
					target = type_parameter_id(FunctionDeclaration(declaration), position)
					dependencies = append_dependencies(
						dependencies,
						argument,
						target,
						PreservedParameter,
						call.span,
					)
					position = IntOps.add(position, 1)
				for operand in call.operands:
					match operand:
						ValueOperand(_): void
						CallableOperand(_, choice, span):
							match choice:
								NamedCallable(id, types):
									dependencies = append_named_dependencies(dependencies, id, types, span)
								ForwardedCallable(_) | StoredCallable(_) | LambdaCallable(_, _): void

			RuntimeFunction(_) | CallableParameter(_) | ValueCall(_):
				void

	dependencies


-- Creating a named value requests its body specialization without executing it.
-- The issued substitution contributes the same finite-instantiation edges as a
-- named callback argument; executable call/tail-call inventories stay separate.
private pure func append_creation_dependencies(
	previous: List[ParameterDependency], creations: List[CheckedExpr],
) -> List[ParameterDependency]:
	var dependencies = previous
	for value in creations:
		match value.form:
			MakeCallable(NamedCallable(id, types)):
				dependencies = append_named_dependencies(dependencies, id, types, value.span)
			_: void
	dependencies


private pure func append_named_dependencies(
	previous: List[ParameterDependency], id: FunctionId, types: List[TypeRef], span: Span,
) -> List[ParameterDependency]:
	var dependencies = previous
	var position = 0
	for value in types:
		dependencies = append_dependencies(
			dependencies, value, type_parameter_id(FunctionDeclaration(id), position),
			PreservedParameter, span,
		)
		position = IntOps.add(position, 1)
	dependencies
