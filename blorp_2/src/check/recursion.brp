---
Recursion analyses over checked bodies: guaranteed self tail calls, and the
rejection of recursive calls that grow type arguments without bound.
---
import:
	result: Result methods
	bool: not, and, or
	./errors:
		CheckError, checker_invariant, CheckerInvariant(InvalidFunctionContract),
		RecursionError(
			GenericTailRecursionUnsupported, GrowingRecursiveInstantiation, UnprovenTraitInstantiation, NoSelfRecursion,
			NonTailSelfCall, TailCallInNestedMatch,
		),
		recursion_error,
	./model:
		BodyOwner(DeclaredBody, LambdaBody, DerivedEqualityBody), AggregateId(RecordAggregate, UnionAggregate), NominalId(AggregateNominal, OpaqueNominal), aggregate_head, aggregate_owner, same_aggregate, same_nominal, type_head, body_calls, canonical_owner, AcceptedTraits, AcceptedImplementation, ImplementationTable, AcceptedMethodCall, method_body, family_for, implementation_rows, method_receiver, method_identity, ImplementedBody(AuthoredMethod, TraitDefault, StructuralEquality),
		CallTarget(TraitMethod, RuntimeFunction, UserFunction, CallableParameter, ValueCall),
		CheckedArm,
		CheckedBody(CheckedMatchBody, CheckedValueBody),
		CheckedCallOperand(ValueOperand, CallableOperand),
		CheckedCall, CallableChoice(MethodCallable, NamedCallable, ForwardedCallable, LambdaCallable, StoredCallable),
		CheckedExit(RecurWith, ReturnExpression),
		CheckedExpr,
		CheckedForm(
			MakeCallable,
			ConstructOpaque, ProjectOpaque,
			ConstructTuple, ReadTupleElement, ConstructRecord, ConstructVariant, ConstructList, InvokeFunction, LiteralFloat, LiteralInteger,
			LiteralString, LiteralVoid, Match, ReadBinding, ReadCapture, ReadRecordField, UpdateRecord,
		),
		CheckedFunction, CheckedLambda, CheckedConstant,
		CheckedStatement(DiscardExpression, InitializeBinding, ReassignBinding, RunWhile, RunFor, BreakSourceLoop, ContinueSourceLoop),
		CheckedIteration(ListIteration, AscendingIntRange),
		TypeParameterId,
		TypeParameterOwner(FunctionDeclaration),
		TypeRef(TupleType, CallableType, NominalType, ListType, ParameterType),
		function_calls, lambda_calls, body_callable_creations, expression_calls, expression_callable_creations, receiver_arguments, parameter_owner,
		same_parameter,
		type_parameter_id,
	../utils/ids: FunctionId, function_number, TraitId, trait_method_owner
	../namespace/namespace: TypeHead(PrimitiveHead, ListHead, RecordHead, UnionHead, OpaqueHead), same_head
	./declarations: Substitution, substitute_type
	./traits: checked_implementation_table
	./instantiation_paths: InstantiationPath, PathOperation(KeepPath, PushPath, PopPath), PathBoundedness(BoundedPaths, UnboundedPaths), bound_instantiation_paths
	int: Int methods
	option: Option methods
	../utils/syntax: FunctionExecution(OrdinaryCalls, SelfTailLoop), ParsedFunction, Span, Purity, same_purity, compiler_span


private pure func is_self_call(call: CheckedCall, current: FunctionId, traits: AcceptedTraits) -> Bool:
	match call.target:
		TraitMethod(method):
			match method_body(traits, method):
				Some(selected):
					match selected.body:
						DeclaredBody(function): function == current
						_: False
				None: False
		UserFunction(id, _):
			id == current
		RuntimeFunction(_) | CallableParameter(_) | ValueCall(_):
			False


-- The first direct self call among evaluated values, in evaluation order.
-- These checks traverse evaluated children, never recovering identity from names.
private pure func first_self_call(values: List[CheckedExpr], current: FunctionId, traits: AcceptedTraits) -> Option[Span]:
	var found: Option[Span] = None

	for value in values:
		found = self_call_in(value, current, traits)

		if found.is_some():
			break

	found


-- A node's children are evaluated before the node, so a call's arguments,
-- receiver first, are searched before the call itself.
private pure func self_call_in(value: CheckedExpr, current: FunctionId, traits: AcceptedTraits) -> Option[Span]:
	match value.form:
		ConstructOpaque(_, child):
			self_call_in(child, current, traits)
		ProjectOpaque(_, child):
			self_call_in(child, current, traits)
		InvokeFunction(call):
			var found: Option[Span] = match call.target:
				ValueCall(callee): self_call_in(callee, current, traits)
				TraitMethod(_) | UserFunction(_, _) | RuntimeFunction(_) | CallableParameter(_): None
			for operand in call.operands:
				if found.is_some():
					break
				match operand:
					ValueOperand(argument): found = self_call_in(argument, current, traits)
					CallableOperand(_, choice, _):
						match choice:
							StoredCallable(child): found = self_call_in(child, current, traits)
							MethodCallable(_) | NamedCallable(_, _) | ForwardedCallable(_) | LambdaCallable(_, _): void
			match found:
				Some(span):
					Some(span)
				None:
					if is_self_call(call, current, traits):
						Some(value.span)
					else:
						None
		ConstructVariant(_, fields):
			first_self_call(fields, current, traits)
		ConstructTuple(elements):
			first_self_call(elements, current, traits)
		ConstructList(elements):
			first_self_call(elements, current, traits)
		Match(join):
			-- A self call anywhere in a non-tail match is a non-tail call.
			var found = self_call_in(join.scrutinee, current, traits)
			for arm in join.arms:
				if found.is_some():
					break
				found = first_self_call(statement_values(arm.statements).append(arm.value), current, traits)
			found
		ConstructRecord(_, fields):
			var found: Option[Span] = None
			for field in fields:
				if found.is_some():
					break
				found = self_call_in(field.value, current, traits)
			found
		UpdateRecord(_, update):
			var found = self_call_in(update.base, current, traits)
			for field in update.replacements:
				if found.is_some():
					break
				found = self_call_in(field.value, current, traits)
			found
		ReadTupleElement(receiver, _):
			self_call_in(receiver, current, traits)
		ReadRecordField(receiver, _):
			self_call_in(receiver, current, traits)
		MakeCallable(choice):
			match choice:
				StoredCallable(operand): self_call_in(operand, current, traits)
				MethodCallable(_) | NamedCallable(_, _) | ForwardedCallable(_) | LambdaCallable(_, _): None
		LiteralVoid | LiteralInteger(_) | LiteralFloat(_) | LiteralString(_) | ReadBinding(_) | ReadCapture(_):
			None


private pure func reject_self_calls(
	values: List[CheckedExpr],
	current: FunctionId, traits: AcceptedTraits,
) -> Result[Void, CheckError]:
	match first_self_call(values, current, traits):
		Some(span):
			Err(recursion_error(span, NonTailSelfCall(current)))
		None:
			Ok(void)


private pure func statement_values(statements: List[CheckedStatement]) -> List[CheckedExpr]:
	var values: List[CheckedExpr] = []
	for statement in statements:
		match statement:
			InitializeBinding(_, value):
				values = values.append(value)
			ReassignBinding(_, value):
				values = values.append(value)
			DiscardExpression(value):
				values = values.append(value)
			RunWhile(loop):
				values = values.append(loop.condition).concat(statement_values(loop.body))
			BreakSourceLoop(_) | ContinueSourceLoop(_): void
			RunFor(loop):
				match loop.iteration:
					ListIteration(iterable, _, _): values = values.append(iterable)
					AscendingIntRange(start, end, _): values = values.append(start).append(end)
				values = values.concat(statement_values(loop.body))
	values


-- A returned value that is a direct self call; its receiver, if written as one,
-- is already the first argument.
private record TailCall {
	arguments: List[CheckedExpr],
	span: Span
}


private pure func tail_call(value: CheckedExpr, current: FunctionId, traits: AcceptedTraits) -> Option[TailCall]:
	match value.form:
		InvokeFunction(call):
			if is_self_call(call, current, traits):
				var arguments: List[CheckedExpr] = []
				for operand in call.operands:
					match operand:
						ValueOperand(argument): arguments = arguments.append(argument)
						CallableOperand(_, _, _): void
				Some({
					arguments = arguments,
					span = value.span,
				})
			else:
				None
		_:
			None


private pure func tail_exit(
	exit: CheckedExit,
	current: FunctionId, traits: AcceptedTraits,
) -> Result[CheckedExit, CheckError]:
	match exit:
		RecurWith(_, _):
			Ok(exit)
		ReturnExpression(value):
			match tail_call(value, current, traits):
				Some(call):
					match reject_self_calls(call.arguments, current, traits):
						Ok(valid): Ok(RecurWith(call.arguments, call.span))
						Err(error): Err(error)
				None:
					match nested_tail(value, current, traits):
						Ok(valid): Ok(exit)
						Err(error): Err(error)


-- A tail value other than a direct self call. A match there passes the tail
-- to each arm's value: a self call that is such a value needs a backedge out
-- of a join, which does not exist yet; a self call anywhere else is an
-- ordinary non-tail call.
private pure func nested_tail(value: CheckedExpr, current: FunctionId, traits: AcceptedTraits) -> Result[Void, CheckError]:
	match tail_call(value, current, traits):
		Some(call):
			Err(recursion_error(call.span, TailCallInNestedMatch))
		None:
			match value.form:
				Match(join):
					var checked = reject_self_calls([join.scrutinee], current, traits)
					for arm in join.arms:
						if checked.is_ok():
							checked = reject_self_calls(statement_values(arm.statements), current, traits)
						if checked.is_ok():
							checked = nested_tail(arm.value, current, traits)
					checked
				_:
					reject_self_calls([value], current, traits)


private pure func tail_arms(
	arms: List[CheckedArm],
	current: FunctionId, traits: AcceptedTraits,
	checked: List[CheckedArm],
) -> Result[List[CheckedArm], CheckError]:
	match arms.get(checked.length()):
		None:
			Ok(checked)
		Some(arm):
			match reject_self_calls(statement_values(arm.statements), current, traits):
				Ok(prefix):
					match tail_exit(arm.body, current, traits):
						Ok(exit):
							tail_arms(
								arms,
								current, traits,
								checked.append({ arm | body = exit }),
							)
						Err(error): Err(error)
				Err(error): Err(error)


private pure func recurs(exit: CheckedExit) -> Bool:
	match exit:
		RecurWith(_, _):
			True
		ReturnExpression(_):
			False


private pure func body_recurs(body: CheckedBody) -> Bool:
	match body:
		CheckedValueBody(exit):
			recurs(exit)
		CheckedMatchBody(matched):
			var found: Bool = False

			for arm in matched.arms:
				found = match found:
					True: True
					False: recurs(arm.body)

			found


record CheckedExecution {
	execution: FunctionExecution,
	body: CheckedBody
}


pure func check_execution(
	function: ParsedFunction,
	parameters: List[TypeParameterId],
	statements: List[CheckedStatement],
	body: CheckedBody,
	current: FunctionId, traits: AcceptedTraits,
) -> Result[CheckedExecution, CheckError]:
	match function.tail_annotation:
		None:
			Ok({
				execution = OrdinaryCalls,
				body = body,
			})
		Some(annotation):
			if parameters.is_empty():
				match reject_self_calls(statement_values(statements), current, traits):
					Ok(prefix):

						tail_body: Result[CheckedBody, CheckError] = match body:
							CheckedValueBody(value):
								match tail_exit(value, current, traits):
									Ok(exit): Ok(CheckedValueBody(exit))
									Err(error): Err(error)
							CheckedMatchBody(matched):
								match reject_self_calls([matched.scrutinee], current, traits):
									Ok(scrutinee):
										match tail_arms(matched.arms, current, traits, []):
											Ok(arms): Ok(CheckedMatchBody({ matched | arms = arms }))
											Err(error): Err(error)
									Err(error): Err(error)

						match tail_body:
							Ok(loop_body):

								if body_recurs(loop_body):
									Ok({
										execution = SelfTailLoop(annotation),
										body = loop_body,
									})
								else:
									Err(recursion_error(annotation, NoSelfRecursion))
							Err(error): Err(error)
					Err(error): Err(error)
			else:
				Err(recursion_error(annotation, GenericTailRecursionUnsupported))


private union DependencyOrigin:
	OrdinaryDependency
	TraitDependency


-- A slot identifies an actual semantic constructor and ordered child. These
-- are never declaration-number-only symbols or physical layout identities.
private union ConstructorSlot:
	ListElement
	NominalArgument(NominalId, Int)
	TupleElement(Int, Int)
	CallableElement(Purity, Int, Int)


private union ConstructorOperation:
	PushConstructor(ConstructorSlot)
	PopConstructor(ConstructorSlot)


private record ParameterDependency {
	source: TypeParameterId,
	target: TypeParameterId,
	operations: List[ConstructorOperation],
	origin: DependencyOrigin,
	automatic: List[AggregateId],
	span: Span
}


private pure func append_dependencies(
	dependencies: List[ParameterDependency], argument: TypeRef,
	target: TypeParameterId, operations: List[ConstructorOperation],
	origin: DependencyOrigin, automatic: List[AggregateId], span: Span,
) -> List[ParameterDependency]:
	var collected = dependencies
	match argument:
		ParameterType(source):
			collected = collected.append({ source = source, target = target, operations = operations, origin = origin, automatic = automatic, span = span })
		_:
			children: List[TypeRef] = match argument:
				CallableType(_, parameters, result): parameters.append(result)
				TupleType(elements): elements
				ListType(element): [element]
				NominalType(_, arguments): arguments
				_: []
			var position = 0
			for child in children:
				slot: Option[ConstructorSlot] = match argument:
					CallableType(purity, parameters, _): Some(CallableElement(purity, parameters.length(), position))
					TupleType(elements): Some(TupleElement(elements.length(), position))
					ListType(_): Some(ListElement)
					NominalType(owner, _): Some(NominalArgument(owner, position))
					_: None
				match slot:
					Some(constructor):
						-- A top-first written path is pushed inside-out.
						push: ConstructorOperation = PushConstructor(constructor)
						collected = append_dependencies(collected, child, target, [push].concat(operations), origin, automatic, span)
					None: void
				position = position.add(1)
	collected


private pure func contains_parameter_id(
	parameters: List[TypeParameterId],
	requested: TypeParameterId,
) -> Bool:
	var found: Bool = False

	for parameter in parameters:
		if same_parameter(parameter, requested):
			found = True
			break

	found


-- Whether a dependency path leads from `start` to `target`.
private pure func parameter_reaches(
	start: TypeParameterId,
	target: TypeParameterId,
	dependencies: List[ParameterDependency],
) -> Bool:
	var reached = [start]
	var frontier = [start]

	while frontier.is_empty().not():
		var next: List[TypeParameterId] = []

		for current in frontier:
			for dependency in dependencies:
				ordinary: Bool = match dependency.origin:
					OrdinaryDependency: True
					TraitDependency: False
				unreached_dependency: Bool = match and(ordinary, same_parameter(dependency.source, current)):
					True: contains_parameter_id(reached, dependency.target).not()
					False: False

				if unreached_dependency:
					reached = reached.append(dependency.target)
					next = next.append(dependency.target)

		frontier = next

	contains_parameter_id(reached, target)


private pure func automatic_origin(implementation: AcceptedImplementation) -> List[AggregateId]:
	var origin: List[AggregateId] = []
	for member in implementation.methods:
		match member.body:
			StructuralEquality(aggregate, template):
				if template.signature.type_parameters.is_empty().not():
					origin = [aggregate]
			_: void
	origin


private pure func with_origins(previous: List[AggregateId], added: List[AggregateId]) -> List[AggregateId]:
	var result = previous
	for aggregate in added:
		if result.any(pure func(existing): same_aggregate(existing, aggregate)).not():
			result = result.append(aggregate)
	result


private pure func receiver_slot(head: TypeHead, position: Int) -> Option[ConstructorSlot]:
	match head:
		ListHead: Some(ListElement)
		RecordHead(owner): Some(NominalArgument(AggregateNominal(RecordAggregate(owner)), position))
		UnionHead(owner): Some(NominalArgument(AggregateNominal(UnionAggregate(owner)), position))
		OpaqueHead(owner): Some(NominalArgument(OpaqueNominal(owner), position))
		PrimitiveHead(_): None


private pure func append_method_dependencies(
	previous: List[ParameterDependency], method: AcceptedMethodCall,
	traits: AcceptedTraits, automatic: List[AggregateId], span: Span,
) -> List[ParameterDependency]:
	var dependencies = previous
	match method_body(traits, method):
		Some(selected):
			var origins = automatic
			match type_head(method_receiver(method)):
				Some(head):
					match family_for(traits, trait_method_owner(method_identity(method)), head):
						Some(family): origins = with_origins(origins, automatic_origin(family))
						None: void
				None: void
			var position = 0
			for argument in selected.arguments:
				match selected.body:
					DeclaredBody(function): dependencies = append_dependencies(dependencies, argument, type_parameter_id(FunctionDeclaration(function), position), [], TraitDependency, origins, span)
					DerivedEqualityBody(aggregate): dependencies = append_dependencies(dependencies, argument, type_parameter_id(aggregate_owner(aggregate), position), [], TraitDependency, origins, span)
					LambdaBody(_): void
				position = position.add(1)
		None:
			match method_receiver(method):
				ParameterType(_):
					for implementation in implementation_rows(traits.implementations):
						origins = with_origins(automatic, automatic_origin(implementation))
						for member in implementation.methods:
							if member.method == method_identity(method):
								for position in 0..implementation.parameter_bounds.length():
									match receiver_slot(implementation.receiver_head, position):
										Some(slot):
											pop: ConstructorOperation = PopConstructor(slot)
											match member.body:
												AuthoredMethod(function): dependencies = append_dependencies(dependencies, method_receiver(method), type_parameter_id(FunctionDeclaration(function), position), [pop], TraitDependency, origins, span)
												StructuralEquality(aggregate, _): dependencies = append_dependencies(dependencies, method_receiver(method), type_parameter_id(aggregate_owner(aggregate), position), [pop], TraitDependency, origins, span)
												TraitDefault(function):
													-- Keep the complete Self, including phantom arguments,
													-- but only after matching this exact head/slot.
													push: ConstructorOperation = PushConstructor(slot)
													dependencies = append_dependencies(dependencies, method_receiver(method), type_parameter_id(FunctionDeclaration(function), 0), [pop, push], TraitDependency, origins, span)
										None: void
				_: void
	dependencies


private pure func append_named_dependencies(
	previous: List[ParameterDependency], id: FunctionId, types: List[TypeRef],
	automatic: List[AggregateId], span: Span,
) -> List[ParameterDependency]:
	var dependencies = previous
	var position = 0
	for value in types:
		dependencies = append_dependencies(dependencies, value, type_parameter_id(FunctionDeclaration(id), position), [], OrdinaryDependency, automatic, span)
		position = position.add(1)
	dependencies


private pure func append_choice_dependencies(
	previous: List[ParameterDependency], choice: CallableChoice, traits: AcceptedTraits,
	automatic: List[AggregateId], span: Span,
) -> List[ParameterDependency]:
	match choice:
		MethodCallable(method): append_method_dependencies(previous, method, traits, automatic, span)
		NamedCallable(id, types): append_named_dependencies(previous, id, types, automatic, span)
		ForwardedCallable(_) | StoredCallable(_) | LambdaCallable(_, _): previous


private pure func append_call_dependencies(
	previous: List[ParameterDependency], calls: List[CheckedCall],
	traits: AcceptedTraits, automatic: List[AggregateId],
) -> List[ParameterDependency]:
	var dependencies = previous
	for call in calls:
		match call.target:
			TraitMethod(method): dependencies = append_method_dependencies(dependencies, method, traits, automatic, call.span)
			UserFunction(declaration, arguments): dependencies = append_named_dependencies(dependencies, declaration, arguments, automatic, call.span)
			RuntimeFunction(_) | CallableParameter(_) | ValueCall(_): void
		-- Callable creation is independent of the target accepting the callback.
		for operand in call.operands:
			match operand:
				CallableOperand(_, choice, span): dependencies = append_choice_dependencies(dependencies, choice, traits, automatic, span)
				ValueOperand(_): void
	dependencies


private pure func append_creation_dependencies(
	previous: List[ParameterDependency], creations: List[CheckedExpr],
	traits: AcceptedTraits, automatic: List[AggregateId],
) -> List[ParameterDependency]:
	var dependencies = previous
	for value in creations:
		match value.form:
			MakeCallable(choice): dependencies = append_choice_dependencies(dependencies, choice, traits, automatic, value.span)
			_: void
	dependencies


private pure func same_constructor_slot(left: ConstructorSlot, right: ConstructorSlot) -> Bool:
	match left:
		ListElement:
			match right:
				ListElement: True
				_: False
		NominalArgument(owner, position):
			match right:
				NominalArgument(other, slot): and(same_nominal(owner, other), position == slot)
				_: False
		TupleElement(arity, position):
			match right:
				TupleElement(other, slot): and(arity == other, position == slot)
				_: False
		CallableElement(purity, arity, position):
			match right:
				CallableElement(other_purity, other_arity, slot): and(same_purity(purity, other_purity), and(arity == other_arity, position == slot))
				_: False


private record IssuedDependency {
	path: InstantiationPath,
	origin: DependencyOrigin,
	automatic: List[AggregateId],
	span: Span
}


private record DependencyGraph {
	controls: Int,
	edges: List[IssuedDependency]
}


private pure func parameter_index(parameters: List[TypeParameterId], requested: TypeParameterId) -> Int:
	var position = 0
	for parameter in parameters:
		if same_parameter(parameter, requested):
			break
		position = position.add(1)
	position


-- Each genuine parameter receives one control. Private intermediate controls
-- belong to one written operation word; no semantic ID is manufactured.
private pure func dependency_graph(dependencies: List[ParameterDependency]) -> DependencyGraph:
	var parameters: List[TypeParameterId] = []
	for dependency in dependencies:
		for parameter in [dependency.source, dependency.target]:
			if contains_parameter_id(parameters, parameter).not():
				parameters = parameters.append(parameter)
	var symbols: List[ConstructorSlot] = []
	var controls = parameters.length()
	var edges: List[IssuedDependency] = []
	for dependency in dependencies:
		var source = parameter_index(parameters, dependency.source)
		target = parameter_index(parameters, dependency.target)
		if dependency.operations.is_empty():
			edges = edges.append({ path = { source = source, target = target, operation = KeepPath }, origin = dependency.origin, automatic = dependency.automatic, span = dependency.span })
		else:
			var position = 0
			for written in dependency.operations:
				slot: ConstructorSlot = match written:
					PushConstructor(value): value
					PopConstructor(value): value
				var symbol = 0
				for existing in symbols:
					if same_constructor_slot(existing, slot):
						break
					symbol = symbol.add(1)
				if symbol == symbols.length():
					symbols = symbols.append(slot)
				operation: PathOperation = match written:
					PushConstructor(_): PushPath(symbol)
					PopConstructor(_): PopPath(symbol)
				position = position.add(1)
				var next_control = target
				if position.less_than(dependency.operations.length()):
					next_control = controls
					controls = controls.add(1)
				edges = edges.append({ path = { source = source, target = next_control, operation = operation }, origin = dependency.origin, automatic = dependency.automatic, span = dependency.span })
				source = next_control
	{ controls = controls, edges = edges }


private pure func bound_dependencies(graph: DependencyGraph) -> Result[PathBoundedness, CheckError]:
	paths: List[InstantiationPath] = graph.edges.map(pure func(edge): edge.path)
	bound_instantiation_paths(graph.controls, paths).to_result(checker_invariant(compiler_span(), InvalidFunctionContract))


private pure func validate_base_dependencies(dependencies: List[ParameterDependency]) -> Result[Void, CheckError]:
	var growing: Option[Span] = None
	for dependency in dependencies:
		match dependency.origin:
			OrdinaryDependency:
				-- Ordinary substitutions contain only pushes, so a nonempty
				-- word is exactly the original positive-growth condition.
				if and(dependency.operations.is_empty().not(), parameter_reaches(dependency.target, dependency.source, dependencies)):
					growing = Some(dependency.span)
					break
			TraitDependency: void
	_: Void ?= match growing:
		Some(span): Err(recursion_error(span, GrowingRecursiveInstantiation))
		None: Ok(void)
	-- Trait-free inputs need only the existing ordinary check, not closure.
	if dependencies.any(pure func(dependency) -> Bool:
		match dependency.origin:
			TraitDependency: True
			OrdinaryDependency: False
	):
		graph = dependency_graph(dependencies)
		match bound_dependencies(graph):
			Err(error): Err(error)
			Ok(BoundedPaths): Ok(void)
			Ok(UnboundedPaths(marked)):
				var failure: Option[Span] = None
				var position = 0
				for edge in graph.edges:
					edge_position = position
					trait_edge: Bool = match edge.origin:
						TraitDependency: True
						OrdinaryDependency: False
					if and(trait_edge, marked.any(pure func(found): found == edge_position)):
						failure = Some(edge.span)
						break
					position = position.add(1)
				match failure:
					Some(span): Err(recursion_error(span, UnprovenTraitInstantiation))
					None: Err(checker_invariant(compiler_span(), InvalidFunctionContract))
	else:
		Ok(void)


-- This returns only candidate-specific finite causes. Check's final use
-- validation must consume them before publishing the pruned accepted rows.
pure func validate_recursive_instantiation(
	functions: List[CheckedFunction], lambdas: List[CheckedLambda], traits: AcceptedTraits,
) -> Result[List[AggregateId], CheckError]:
	var dependencies: List[ParameterDependency] = []
	for function in functions:
		dependencies = append_call_dependencies(dependencies, function_calls(function), traits, [])
		dependencies = append_creation_dependencies(dependencies, body_callable_creations(function.statements, function.body), traits, [])
	for lambda in lambdas:
		dependencies = append_call_dependencies(dependencies, lambda_calls(lambda), traits, [])
		dependencies = append_creation_dependencies(dependencies, body_callable_creations(lambda.statements, lambda.body), traits, [])
	for implementation in implementation_rows(traits.implementations):
		for member in implementation.methods:
			match member.body:
				StructuralEquality(_, template):
					origins = automatic_origin(implementation)
					dependencies = append_call_dependencies(dependencies, body_calls([], template.body), traits, origins)
					dependencies = append_creation_dependencies(dependencies, body_callable_creations([], template.body), traits, origins)
				_: void
	base = dependencies.filter(pure func(dependency): dependency.automatic.is_empty())
	_: Void ?= validate_base_dependencies(base)
	if dependencies.any(pure func(dependency): dependency.automatic.is_empty().not()):
		graph = dependency_graph(dependencies)
		match bound_dependencies(graph):
			Err(error): Err(error)
			Ok(BoundedPaths): Ok([])
			Ok(UnboundedPaths(marked)):
				var unavailable: List[AggregateId] = []
				var invalid: Option[CheckError] = None
				for position in marked:
					match graph.edges.get(position):
						Some(edge): unavailable = with_origins(unavailable, edge.automatic)
						None: invalid = Some(checker_invariant(compiler_span(), InvalidFunctionContract))
				match invalid:
					Some(error): Err(error)
					None: Ok(unavailable)
	else:
		Ok([])


-- Earlier Check already proved these obligations. This projection asks ONLY
-- whether one reaches a newly unavailable automatic family, never reproves
-- ordinary capability or infers an assumption on a rigid parameter.
private pure func unavailable_goal(
	traits: AcceptedTraits, unavailable: List[AggregateId],
	required: TraitId, receiver: TypeRef, span: Span,
) -> Result[Bool, CheckError]:
	var blocked: Bool = False
	var invalid: Option[CheckError] = None
	match type_head(receiver):
		None: void
		Some(head):
			canonical: Bool = match traits.canonical.equality:
				Some(owner): canonical_owner(owner) == required
				None: False
			blocked = and(canonical, unavailable.any(pure func(aggregate): same_head(head, aggregate_head(aggregate))))
			if blocked.not():
				match family_for(traits, required, head):
					None: void
					Some(family):
						arguments = receiver_arguments(receiver)
						var position = 0
						for bounds in family.parameter_bounds:
							match arguments.get(position):
								None: invalid = Some(checker_invariant(span, InvalidFunctionContract))
								Some(argument):
									for bound in bounds:
										match unavailable_goal(traits, unavailable, bound.required_trait, argument, span):
											Ok(value): blocked = value
											Err(error): invalid = Some(error)
										if or(blocked, invalid.is_some()):
											break
							if or(blocked, invalid.is_some()):
								break
							position = position.add(1)
	match invalid:
		Some(error): Err(error)
		None: Ok(blocked)


private pure func unavailable_named(
	functions: List[CheckedFunction], traits: AcceptedTraits, unavailable: List[AggregateId],
	id: FunctionId, arguments: List[TypeRef], span: Span,
) -> Result[Bool, CheckError]:
	function ?= functions.get(function_number(id)).to_result(checker_invariant(span, InvalidFunctionContract))
	var blocked: Bool = False
	var invalid: Option[CheckError] = None
	for required in function.signature.requirements:
		substitution: Substitution = { owner = parameter_owner(required.parameter), values = arguments }
		match substitute_type(ParameterType(required.parameter), substitution, span):
			Err(error): invalid = Some(error)
			Ok(receiver):
				match unavailable_goal(traits, unavailable, required.required_trait, receiver, span):
					Ok(value): blocked = value
					Err(error): invalid = Some(error)
		if or(blocked, invalid.is_some()):
			break
	match invalid:
		Some(error): Err(error)
		None: Ok(blocked)


private pure func unavailable_choice(
	functions: List[CheckedFunction], traits: AcceptedTraits, unavailable: List[AggregateId],
	choice: CallableChoice, span: Span,
) -> Result[Bool, CheckError]:
	match choice:
		MethodCallable(method): unavailable_goal(traits, unavailable, trait_method_owner(method_identity(method)), method_receiver(method), span)
		NamedCallable(id, arguments): unavailable_named(functions, traits, unavailable, id, arguments, span)
		ForwardedCallable(_) | StoredCallable(_) | LambdaCallable(_, _): Ok(False)


private pure func earlier_unproven(previous: Option[CheckError], span: Span) -> Option[CheckError]:
	match previous:
		None: Some(recursion_error(span, UnprovenTraitInstantiation))
		Some(error):
			if and(error.span.source == span.source, span.start.less_than(error.span.start)):
				Some(recursion_error(span, UnprovenTraitInstantiation))
			else:
				previous


private pure func unavailable_uses(
	functions: List[CheckedFunction], traits: AcceptedTraits, unavailable: List[AggregateId],
	calls: List[CheckedCall], creations: List[CheckedExpr],
) -> Result[Option[CheckError], CheckError]:
	var first: Option[CheckError] = None
	var invalid: Option[CheckError] = None
	for call in calls:
		blocked: Result[Bool, CheckError] = match call.target:
			UserFunction(id, arguments): unavailable_named(functions, traits, unavailable, id, arguments, call.span)
			TraitMethod(method): unavailable_goal(traits, unavailable, trait_method_owner(method_identity(method)), method_receiver(method), call.span)
			RuntimeFunction(_) | CallableParameter(_) | ValueCall(_): Ok(False)
		match blocked:
			Err(error): invalid = Some(error)
			Ok(True): first = earlier_unproven(first, call.span)
			Ok(False): void
		for operand in call.operands:
			match operand:
				ValueOperand(_): void
				CallableOperand(_, choice, span):
					match unavailable_choice(functions, traits, unavailable, choice, span):
						Err(error): invalid = Some(error)
						Ok(True): first = earlier_unproven(first, span)
						Ok(False): void
	for value in creations:
		match value.form:
			MakeCallable(choice):
				match unavailable_choice(functions, traits, unavailable, choice, value.span):
					Err(error): invalid = Some(error)
					Ok(True): first = earlier_unproven(first, value.span)
					Ok(False): void
			_: void
	match invalid:
		Some(error): Err(error)
		None: Ok(first)


-- The surviving implementations and the removed automatic equalities. Only
-- finalize_trait_instances builds one; supertraits.brp says why that matters.
private record FinalTraitContents {
	traits: AcceptedTraits,
	removed: List[AggregateId]
}
opaque type FinalTraits = FinalTraitContents


pure func final_traits(final: FinalTraits) -> AcceptedTraits:
	from_opaque FinalTraits(final).traits


pure func removed_equalities(final: FinalTraits) -> List[AggregateId]:
	from_opaque FinalTraits(final).removed


private pure func blocked_by_unavailable_equality(implementation: AcceptedImplementation, unavailable: List[AggregateId]) -> Bool:
	implementation.methods.any(pure func(member) -> Bool:
		match member.body:
			StructuralEquality(aggregate, _): unavailable.any(pure func(existing): same_aggregate(existing, aggregate))
			_: False
	)


-- Complete the new-auto availability once, then validate source uses before
-- sealing. Generated templates propagate failure privately; authored/default
-- bodies, constants and lambdas remain checked even without a reachable caller.
pure func finalize_trait_instances(
	constants: List[CheckedConstant], functions: List[CheckedFunction],
	lambdas: List[CheckedLambda], traits: AcceptedTraits,
	initially_unavailable: List[AggregateId],
) -> Result[FinalTraits, CheckError]:
	var unavailable = initially_unavailable
	var invalid: Option[CheckError] = None
	var changed: Bool = initially_unavailable.is_empty().not()
	while and(changed, invalid.is_none()):
		changed = False
		for implementation in implementation_rows(traits.implementations):
			for member in implementation.methods:
				match member.body:
					StructuralEquality(aggregate, template):
						if unavailable.any(pure func(existing): same_aggregate(existing, aggregate)).not():
							match unavailable_uses(functions, traits, unavailable, body_calls([], template.body), body_callable_creations([], template.body)):
								Err(error): invalid = Some(error)
								Ok(Some(_)):
									unavailable = unavailable.append(aggregate)
									changed = True
								Ok(None): void
					_: void
	_: Void ?= match invalid:
		Some(error): Err(error)
		None: Ok(void)
	var first: Option[CheckError] = None
	if unavailable.is_empty().not():
		for constant in constants:
			if first.is_none():
				match unavailable_uses(functions, traits, unavailable, expression_calls(constant.value), expression_callable_creations(constant.value)):
					Err(error): invalid = Some(error)
					Ok(error): first = error
		for function in functions:
			if first.is_none():
				match unavailable_uses(functions, traits, unavailable, function_calls(function), body_callable_creations(function.statements, function.body)):
					Err(error): invalid = Some(error)
					Ok(error): first = error
		for lambda in lambdas:
			if first.is_none():
				match unavailable_uses(functions, traits, unavailable, lambda_calls(lambda), body_callable_creations(lambda.statements, lambda.body)):
					Err(error): invalid = Some(error)
					Ok(error): first = error
	_: Void ?= match invalid:
		Some(error): Err(error)
		None:
			match first:
				Some(error): Err(error)
				None: Ok(void)
	final_unavailable = unavailable
	implementations: ImplementationTable ?= if final_unavailable.is_empty():
		Ok(traits.implementations)
	else:
		checked_implementation_table(implementation_rows(traits.implementations).filter(pure func(implementation): blocked_by_unavailable_equality(implementation, final_unavailable).not()))
	Ok(into_opaque FinalTraits({ traits = { traits | implementations = implementations }, removed = final_unavailable }))
