---
Checking's public boundary: composes the phases in order and seals either a
CheckedProgram or a CheckFailure carrying the first error.
---
import:
	../namespace/builtins: CheckedFoundation, check_builtin_types
	./bodies: resolve_functions
	./constants: constant_annotations, validate_constants
	./errors: BuiltinError(BuiltinTypesRejected), CheckError, CheckErrors, builtin_error, namespace_rejection
	./traits: prepare_equality_availability, accepted_traits, designated_trait, accept_trait_contracts, validate_implementations
	./model: CheckedFunctions
	./recursion: validate_recursive_instantiation
	./receiver_clashes: reject_receiver_clashes
	./signatures: AcceptedFunction, validate_signatures
	result: map_err
	./declarations: validate_declarations, validate_finite_declarations
	../utils/ids: FunctionId, RecordId, UnionId, inventory_opaques
	../namespace/namespace: Namespace, build_namespace, namespace_problem_span
	../parse/assemble: ParsedProgram, parsed_contents


opaque type CheckedProgram = CheckedFunctions


pure func checked_functions(program: CheckedProgram) -> CheckedFunctions:
	from_opaque CheckedProgram(program)


-- The identity of the function at a declaration position, when one exists.
pure func declaration_id(program: CheckedProgram, position: Int) -> Option[FunctionId]:
	match from_opaque CheckedProgram(program).functions.get(position):
		Some(row):
			Some(row.id)
		None:
			None


-- The identity of the record at a declaration position, when one exists.
pure func record_declaration_id(program: CheckedProgram, position: Int) -> Option[RecordId]:
	match from_opaque CheckedProgram(program).records.get(position):
		Some(row): Some(row.id)
		None: None


-- The identity of the union at a declaration position, when one exists.
pure func union_declaration_id(program: CheckedProgram, position: Int) -> Option[UnionId]:
	match from_opaque CheckedProgram(program).unions.get(position):
		Some(row):
			Some(row.id)
		None:
			None


private fixed record FailureContents {
	program: ParsedProgram,
	errors: CheckErrors,
	functions: List[AcceptedFunction]
}


opaque type CheckFailure = FailureContents


private pure func check_program(program: ParsedProgram) -> Result[CheckedProgram, CheckFailure]:
	parsed = parsed_contents(program)

	foundation_result: Result[CheckedFoundation, CheckError] = match check_builtin_types(program):
		Ok(accepted):
			Ok(accepted)
		Err(error):
			Err(builtin_error(error.span, BuiltinTypesRejected(error)))

	foundation ?= foundation_result.map_err(pure func(error): failed(program, error, []))
	namespace_result: Result[Namespace, CheckError] = match build_namespace(program):
		Ok(accepted): Ok(accepted)
		Err(problem): Err(namespace_rejection(namespace_problem_span(problem), problem))
	namespace ?= namespace_result.map_err(pure func(error): failed(program, error, []))
	declarations ?= validate_declarations(parsed, namespace).map_err(pure func(error): failed(program, error, []))
	declarations_finite ?= validate_finite_declarations(declarations).map_err(pure func(error): failed(program, error, []))
	annotations ?= constant_annotations(parsed, namespace).map_err(pure func(error): failed(program, error, []))
	canonical = designated_trait(parsed, namespace)
	contracts ?= accept_trait_contracts(parsed, namespace, foundation.designated.boolean, canonical).map_err(pure func(error): failed(program, error, []))
	signatures ?= validate_signatures(parsed, namespace, foundation.designated, contracts).map_err(pure func(error): failed(program, error, []))
	authored ?= validate_implementations(parsed, namespace, signatures.implementation_headers, signatures.functions, contracts, canonical).map_err(pure func(error): failed(program, error, signatures.functions))
	availability ?= prepare_equality_availability(parsed, authored, declarations.records, declarations.unions, foundation.designated.boolean).map_err(pure func(error): failed(program, error, signatures.functions))
	traits = accepted_traits(availability)
	receivers ?= reject_receiver_clashes(namespace, signatures.functions, parsed.dependency_order, traits).map_err(pure func(error): failed(program, error, signatures.functions))
	constants ?= validate_constants(parsed, namespace, annotations, declarations.records, declarations.unions, signatures.functions, availability).map_err(pure func(error): failed(program, error, signatures.functions))
	functions ?= resolve_functions(
		signatures.functions, declarations, inventory_opaques(parsed.declarations),
		namespace, constants, availability, foundation.designated.result, foundation.designated.boolean, foundation.designated.option,
	).map_err(pure func(error): failed(program, error, signatures.functions))
	finite ?= validate_recursive_instantiation(functions.functions, functions.lambdas, traits).map_err(pure func(error): failed(program, error, signatures.functions))
	Ok(into_opaque CheckedProgram({
				traits = traits,
				unions = declarations.unions,
				records = declarations.records,
				opaques = declarations.opaques,
				functions = functions.functions,
				lambdas = functions.lambdas,
				entrypoint = signatures.entrypoint
			}))


private pure func failed(program: ParsedProgram, error: CheckError, functions: List[AcceptedFunction]) -> CheckFailure:
	into_opaque CheckFailure({ program = program, errors = { first = error, remaining = [] }, functions = functions })


pure func check(program: ParsedProgram) -> Result[CheckedProgram, CheckFailure]:
	check_program(program)


-- Only failed post-signature checking keeps this borrowed accepted view for
-- normalized binder spelling. Successful checked programs discard the scopes.
pure func failure_functions(failure: CheckFailure) -> List[AcceptedFunction]:
	from_opaque CheckFailure(failure).functions


pure func check_errors(failure: CheckFailure) -> CheckErrors:
	from_opaque CheckFailure(failure).errors


pure func failure_program(failure: CheckFailure) -> ParsedProgram:
	from_opaque CheckFailure(failure).program
