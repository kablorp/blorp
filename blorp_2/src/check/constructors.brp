---
Plans and validates record literals, record updates and variant applications from
their expected types, producing the pending records and variants that freezing later
publishes.
---
import:
	bool: not, and, or
	./callables: FunctionContract, ResolutionContext
	./declarations: aliased_module, find_field, occurrence_fields, previous_declaration
	./model:
		FieldId,
		CheckedRecord, CheckedUnion, CheckedOpaque,
		CheckedField,
		TypeParameterId,
		TypeRef(NominalType, ListType),
		AggregateId(RecordAggregate, UnionAggregate),
		NominalId(AggregateNominal),
		TypeUse, CheckedExpr,
		UnionOccurrence,
		same_type,
		field_number
	./errors:
		CheckError,
		ExpectedTypeSite(SourceAnnotation),
		CallError(ArgumentTypeMismatch),
		MatchError(UnimportedConstructorPattern),
		QualifiedError(QualifiedNotOffered),
		match_error,
		qualified_error,
		ConstructorError(ConstructorNeedsExpectedType, VariantNotInExpectedType, PayloadFreeVariantCalled, ConstructorFieldCountMismatch),
		RecordError(UpdateRequiresRecord, DuplicateUpdateField, RecordNeedsExpectedType, UnknownRecordField, DuplicateLiteralField, MissingRecordField, RecordFieldTypeMismatch),
		ValueError(EmptyListNeedsElementType, ListElementTypeMismatch),
		ListElementReference(EarlierElement, ExpectedElement),
		CheckerInvariant(InvalidCheckedUnion, InvalidRecordDeclaration, InvalidRecordField, GenericConstructorContract, InvalidInferenceWorklist),
		call_error,
		constructor_error,
		record_error,
		value_error,
		checker_invariant
	./inference:
		PendingBase(PendingConstructRecord, PendingConstructVariant, PendingUpdateRecord, PendingConstructList),
		ListElementSource(ExpectedElementType, FirstElementType),
		InferenceType(AcceptedType, CallVariable, InferredNominal, InferredList),
		InferenceReadiness(ClosedInference, DeferredInference),
		InferencePublication(CompleteInference, DiagnosticInference),
		InferenceSlot,
		InferenceUse,
		PendingOperations(NoPendingOperations),
		PendingRecordField,
		PendingRetainedField,
		PendingValue,
		PendingVariantContract,
		apply_type_hint,
		inference_complete,
		inference_head,
		inference_shape,
		list_inference_type,
		pending_type,
		publish_inference_type
	../utils/ids: RecordId, UnionId, VariantId, variant_owner, record_number, union_number, variant_number
	../utils/source: ModuleId
	../namespace/namespace: Namespace, NamedValue(NamedConstructor), OfferedValue(OfferedConstructor), named_value, offered_value
	../utils/syntax: Span, ValueExpression, WrittenName, ParsedRecordField, ParsedQualified
	int: Int methods
	option: Option methods
	result: Result methods


-- Construction reads declarations and module visibility, never a body owner.
record ConstructionContext {
	module: ModuleId,
	namespace: Namespace,
	records: List[CheckedRecord],
	unions: List[CheckedUnion]
}


pure func construction_context(context: ResolutionContext) -> ConstructionContext:
	{ module = context.module, namespace = context.namespace, records = context.records, unions = context.unions }


record VariantContract {
	variant: VariantId,
	result_type: TypeRef,
	fields: List[TypeUse]
}


record DeclaredVariantContract {
	variant: VariantId,
	fields: List[TypeUse],
	parameters: List[TypeParameterId]
}


-- The one reader of a variant's declaration: its fields and the union's
-- parameters, for a variant identity the caller has already established.
private pure func declared_variant_contract(context: ConstructionContext, owner: UnionId, variant: VariantId, span: Span) -> Result[Option[DeclaredVariantContract], CheckError]:
	declaration ?= context.unions.get(union_number(owner)).to_result(checker_invariant(span, InvalidCheckedUnion(owner)))
	found: Option[DeclaredVariantContract] = match declaration.variants.get(variant_number(variant)):
		Some(declared):
			if variant == declared.id:
				Some({ variant = declared.id, fields = declared.fields, parameters = declaration.type_parameters })
			else:
				None
		None: None
	Ok(found)


-- A bare constructor is the one the caller's module sees under its name, and
-- it must belong to `owner`; an unimported constructor of the union is not found.
private pure func find_declared_variant(context: ConstructionContext, owner: UnionId, name: WrittenName) -> Result[Option[DeclaredVariantContract], CheckError]:
	match named_value(context.namespace, context.module, name.id):
		Some(NamedConstructor(variant)): declared_variant_contract(context, owner, variant, name.span)
		_: Ok(None)


pure func find_variant(context: ConstructionContext, occurrence: UnionOccurrence, name: WrittenName) -> Result[Option[VariantContract], CheckError]:
	found ?= find_declared_variant(context, occurrence.owner, name)
	match found:
		None:
			match context.unions.get(union_number(occurrence.owner)):
				None: Err(checker_invariant(name.span, InvalidCheckedUnion(occurrence.owner)))
				Some(declaration):
					var failure: Option[CheckError] = None
					for variant in declaration.variants:
						if variant.name.id == name.id:
							failure = Some(match_error(name.span, UnimportedConstructorPattern(variant.id)))
							break
					match failure:
						Some(error): Err(error)
						None: Ok(None)
		Some(variant):
			match instantiate_pattern_variant(variant, occurrence):
				Ok(contract): Ok(Some(contract))
				Err(error): Err(error)


-- Qualification selects an exported declaration, then the same membership
-- authority as a bare head checks it against the scrutinee's union.
pure func find_qualified_variant(context: ConstructionContext, occurrence: UnionOccurrence, qualified: ParsedQualified) -> Result[Option[VariantContract], CheckError]:
	aliased ?= aliased_module(context.namespace, context.module, qualified.module)
	declared ?= match offered_value(context.namespace, aliased.target, qualified.name.id):
		Ok(OfferedConstructor(variant)):
			declared_variant_contract(context, occurrence.owner, variant, qualified.name.span)
		Ok(_): Ok(None)
		Err(reason):
			Err(qualified_error(qualified.name.span, QualifiedNotOffered(qualified.module.id, qualified.name.id, aliased.path, reason)))
	match declared:
		None: Ok(None)
		Some(variant):
			match instantiate_pattern_variant(variant, occurrence):
				Ok(contract): Ok(Some(contract))
				Err(error): Err(error)


private pure func instantiate_pattern_variant(variant: DeclaredVariantContract, occurrence: UnionOccurrence) -> Result[VariantContract, CheckError]:
	fields ?= occurrence_fields(variant.fields, occurrence)
	Ok({ variant = variant.variant, result_type = NominalType(AggregateNominal(UnionAggregate(occurrence.owner)), occurrence.arguments), fields = fields })


pure func resolve_record_field(
	name: WrittenName,
	owner: RecordId,
	context: ConstructionContext,
) -> Result[CheckedField, CheckError]:
	declaration ?= context.records
		.get(record_number(owner))
		.to_result(checker_invariant(name.span, InvalidRecordDeclaration(owner)))
	find_field(
		declaration.fields,
		name.id,
	).to_result(record_error(name.span, UnknownRecordField(name.id, owner)))


record PlannedRecordField {
	field: FieldId,
	written: ValueExpression,
	expected: InferenceUse
}


-- Literal and update fields share one RHS/constraint engine; only their origins differ.
union RecordOrigin:
	LiteralRecord(RecordId)
	UpdatedRecord(RecordId, PendingValue, Span, List[PendingRetainedField])


record PlannedRecordFields {
	origin: RecordOrigin,
	value_type: InferenceType,
	fields: List[PlannedRecordField],
	span: Span
}


record RecordOccurrence {
	owner: RecordId,
	arguments: List[InferenceType]
}


pure func record_occurrence(value: InferenceType) -> Option[RecordOccurrence]:
	match inference_shape(value):
		InferredNominal(AggregateNominal(RecordAggregate(owner)), arguments): Some({ owner = owner, arguments = arguments })
		_: None


pure func record_argument_hints(arguments: List[InferenceType]) -> List[Option[InferenceType]]:
	arguments.map(pure func(value): Some(value))


record ResolvedLiteralField {
	field: CheckedField,
	written: ParsedRecordField
}


-- Structural admission precedes child planning and preserves written order.
-- Only missing-field selection follows the declaration's field order.
pure func admit_record_fields(
	written: List[ParsedRecordField],
	span: Span,
	declaration: CheckedRecord,
) -> Result[List[ResolvedLiteralField], CheckError]:
	var resolved: List[ResolvedLiteralField] = []
	var previous: List[WrittenName] = []
	var failure: Option[CheckError] = None

	for field in written:
		result: Result[ResolvedLiteralField, CheckError] = match find_field(declaration.fields, field.name.id):
			None:
				Err(record_error(field.name.span, UnknownRecordField(field.name.id, declaration.id)))
			Some(declared):
				match previous_declaration(previous, field.name.id):
					Some(first):
						Err(
							record_error(
								field.name.span,
								DuplicateLiteralField(field.name.id, first.span),
							),
						)
					None:
						Ok({
							field = declared,
							written = field,
						})

		match result:
			Err(error):
				failure = Some(error)
				break
			Ok(resolved_field):
				resolved = resolved.append(resolved_field)
				previous = previous.append(resolved_field.written.name)

	_: Void ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	for field in declaration.fields:
		if previous_declaration(previous, field.name.id).is_some().not():
			failure = Some(
				record_error(
					span,
					MissingRecordField(
						field.id,
						field.name.span,
					),
				),
			)
			break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(resolved)


pure func plan_record_literal(
	written: List[ParsedRecordField],
	span: Span,
	expectation: Option[InferenceType],
	context: ConstructionContext,
	slots: List[InferenceSlot],
) -> Result[PlannedBase, CheckError]:
	written_term ?= expectation.to_result(record_error(span, RecordNeedsExpectedType))
	term ?= inference_head(written_term, slots, span)
	match term:
		CallVariable(_):
			Ok(PlannedContext(SuspendedRecord(written, span), term))
		_: plan_known_record(written, span, term, context)


private pure func plan_known_record(written: List[ParsedRecordField], span: Span, term: InferenceType, context: ConstructionContext) -> Result[PlannedBase, CheckError]:
	occurrence ?= record_occurrence(term).to_result(record_error(span, RecordNeedsExpectedType))
	owner = occurrence.owner
	declaration ?= context.records
		.get(record_number(owner))
		.to_result(checker_invariant(span, InvalidRecordDeclaration(owner)))
	resolved ?= admit_record_fields(written, span, declaration)

	accepted = declaration
	if accepted.type_parameters.length() != occurrence.arguments.length():
		Err(checker_invariant(span, InvalidRecordDeclaration(owner)))
	else:
		hints = record_argument_hints(occurrence.arguments)
		var fields: List[PlannedRecordField] = []
		var found_error: Option[CheckError] = None

		for field in resolved:
			result = plan_record_field(field, accepted, hints)
			match result:
				Ok(planned_field): fields = fields.append(planned_field)
				Err(field_error):
					found_error = Some(field_error)
					break

		match found_error:
			Some(error): Err(error)
			None:
				Ok(PlannedRecord({ origin = LiteralRecord(owner), value_type = term, fields = fields, span = span }))


pure func plan_record_update(base: PendingValue, written: List[ParsedRecordField], span: Span, expression_span: Span, context: ConstructionContext, slots: List[InferenceSlot]) -> Result[PlannedRecordFields, CheckError]:
	head ?= inference_head(pending_type(base), slots, expression_span)
	occurrence_result: Result[RecordOccurrence, CheckError] = match record_occurrence(head):
		Some(value): Ok(value)
		None:
			match publish_inference_type(head, slots, DiagnosticInference, expression_span):
				Ok(actual): Err(record_error(expression_span, UpdateRequiresRecord(actual)))
				Err(error): Err(error)
	occurrence ?= occurrence_result
	declaration ?= context.records.get(record_number(occurrence.owner)).to_result(checker_invariant(span, InvalidRecordDeclaration(occurrence.owner)))
	hints = record_argument_hints(occurrence.arguments)
	var replaced: List[Option[Span]] = []
	for _ in declaration.fields:
		replaced = replaced.append(None)
	var fields: List[PlannedRecordField] = []
	var failure: Option[CheckError] = None
	for written_field in written:
		planned: Result[PlannedRecordField, CheckError] = match resolve_record_field(written_field.name, occurrence.owner, context):
			Err(error): Err(error)
			Ok(field):
				match replaced.get(field_number(field.id)):
					Some(Some(first)): Err(record_error(written_field.name.span, DuplicateUpdateField(written_field.name.id, first)))
					Some(None): plan_record_field({ field = field, written = written_field }, declaration, hints)
					None: Err(checker_invariant(span, InvalidRecordField(field.id)))
		match planned:
			Err(error):
				failure = Some(error)
				break
			Ok(field):
				fields = fields.append(field)
				replaced = replaced.set(field_number(field.field), Some(written_field.name.span))
	_: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	var inherited: List[PendingRetainedField] = []
	for field in declaration.fields:
		match replaced.get(field_number(field.id)):
			Some(None):
				annotation = field.value_type
				match apply_type_hint(annotation.value_type, declaration.type_parameters, hints):
					Some(value_type): inherited = inherited.append({ field = field.id, value_type = value_type })
					None:
						failure = Some(checker_invariant(annotation.span, InvalidRecordField(field.id)))
						break
			Some(Some(_)): void
			None:
				failure = Some(checker_invariant(span, InvalidRecordField(field.id)))
				break
	_: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	Ok({ origin = UpdatedRecord(occurrence.owner, base, expression_span, inherited), value_type = pending_type(base), fields = fields, span = span })


private pure func plan_record_field(field: ResolvedLiteralField, accepted: CheckedRecord, hints: List[Option[InferenceType]]) -> Result[PlannedRecordField, CheckError]:
	annotation = field.field.value_type
	value_type ?= apply_type_hint(annotation.value_type, accepted.type_parameters, hints).to_result(checker_invariant(annotation.span, InvalidRecordField(field.field.id)))
	Ok({ field = field.field.id, written = field.written.value, expected = { value_type = value_type, span = annotation.span } })


private pure func validate_record_field(field: PendingRecordField, slots: List[InferenceSlot]) -> Result[Void, CheckError]:
	expected ?= publish_inference_type(field.expected.value_type, slots, CompleteInference, field.expected.span)
	actual ?= publish_inference_type(pending_type(field.value), slots, CompleteInference, field.value.span)
	if same_type(expected, actual):
		Ok(void)
	else:
		Err(record_error(field.value.span, RecordFieldTypeMismatch(field.field, { value_type = actual, span = field.value.span }, { value_type = expected, span = field.expected.span })))


pure func validate_record_fields(fields: List[PendingRecordField], slots: List[InferenceSlot]) -> Result[Void, CheckError]:
	var failure: Option[CheckError] = None

	for field in fields:
		result = validate_record_field(field, slots)
		match result:
			Ok(_): void
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error): Err(error)
		None: Ok(void)


-- Closed construction checks establish an actual type, not just a repeated
-- contextual term. Retain it as argument evidence just as closed calls do.
private pure func construction_result_type(term: InferenceType, readiness: InferenceReadiness, slots: List[InferenceSlot], span: Span) -> Result[InferenceType, CheckError]:
	match readiness:
		ClosedInference: publish_inference_type(term, slots, CompleteInference, span).map(pure func(accepted): AcceptedType(accepted))
		DeferredInference: Ok(term)


private pure func is_deferred(value: PendingValue) -> Bool:
	match value.readiness:
		DeferredInference: True
		ClosedInference: False


-- A construction is closed only when every operand is closed and its own type
-- is fully inferred.
private pure func construction_readiness(operand_deferred: Bool, term: InferenceType, slots: List[InferenceSlot], span: Span) -> Result[InferenceReadiness, CheckError]:
	complete ?= inference_complete(term, slots, span)
	if and(complete, operand_deferred.not()):
		Ok(ClosedInference)
	else:
		Ok(DeferredInference)


pure func finish_pending_record(plan: PlannedRecordFields, fields: List[PendingRecordField], slots: List[InferenceSlot]) -> Result[PendingValue, CheckError]:
	field_deferred = fields.any(pure func(field: PendingRecordField) -> Bool: is_deferred(field.value))
	operand_deferred = match plan.origin:
		LiteralRecord(_): field_deferred
		UpdatedRecord(_, base, _, _): or(field_deferred, is_deferred(base))
	readiness ?= construction_readiness(operand_deferred, plan.value_type, slots, plan.span)
	_: Void ?= match readiness:
		ClosedInference: validate_record_fields(fields, slots)
		DeferredInference: Ok(void)
	value_type ?= construction_result_type(plan.value_type, readiness, slots, plan.span)
	base: PendingBase = match plan.origin:
		LiteralRecord(owner): PendingConstructRecord(owner, fields)
		UpdatedRecord(owner, base, expression_span, inherited): PendingUpdateRecord(owner, base, expression_span, fields, inherited)
	Ok({ span = plan.span, readiness = readiness, base = base, base_type = value_type, base_span = plan.span, operations = NoPendingOperations })


private pure func pending_variant(
	variant_id: VariantId,
	name: WrittenName,
	expected: Option[InferenceType],
	slots: List[InferenceSlot],
	context: ConstructionContext,
) -> Result[PendingVariantContract, CheckError]:
	term ?= expected.to_result(constructor_error(name.span, ConstructorNeedsExpectedType(name.id)))
	head ?= inference_head(term, slots, name.span)
	shape = inference_shape(head)
	owner_result: Result[UnionId, CheckError] = match shape:
		InferredNominal(AggregateNominal(UnionAggregate(owner)), _): Ok(owner)
		CallVariable(_): Err(constructor_error(name.span, ConstructorNeedsExpectedType(name.id)))
		_:
			match publish_inference_type(head, slots, DiagnosticInference, name.span):
				Ok(snapshot): Err(constructor_error(name.span, VariantNotInExpectedType(name.id, snapshot)))
				Err(error): Err(error)
	owner ?= owner_result
	declared ?= declared_variant_contract(context, owner, variant_id, name.span)
	variant_result: Result[DeclaredVariantContract, CheckError] = match declared:
		Some(variant): Ok(variant)
		None:
			match publish_inference_type(head, slots, DiagnosticInference, name.span):
				Ok(snapshot): Err(constructor_error(name.span, VariantNotInExpectedType(name.id, snapshot)))
				Err(error): Err(error)
	variant ?= variant_result
	arguments: List[InferenceType] = match shape:
		InferredNominal(AggregateNominal(UnionAggregate(_)), arguments): arguments
		_: []
	instantiate_variant(variant, head, arguments, name)


-- The contract of one declared variant under the union's type arguments
-- (empty for a nongeneric union). Bare and qualified constructors share it.
private pure func instantiate_variant(
	variant: DeclaredVariantContract,
	head: InferenceType,
	arguments: List[InferenceType],
	name: WrittenName,
) -> Result[PendingVariantContract, CheckError]:
	hints = record_argument_hints(arguments)
	var fields: List[InferenceUse] = []
	var failure: Option[CheckError] = None
	for annotation in variant.fields:
		match apply_type_hint(annotation.value_type, variant.parameters, hints):
			Some(value_type):
				fields = fields.append({
					value_type = value_type,
					span = annotation.span,
				})
			None:
				failure = Some(checker_invariant(name.span, GenericConstructorContract))
				break
	_: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	Ok({
		variant = variant.variant,
		result_type = head,
		fields = fields,
		span = name.span,
	})


-- `Alias.Variant` names its union through the alias row, so no expected type
-- is needed to find the owner; a generic union still takes its arguments
-- from the expectation, as a bare constructor does.
private pure func pending_qualified_variant(
	declared: DeclaredVariantContract,
	name: WrittenName,
	expected: Option[InferenceType],
) -> Result[PendingVariantContract, CheckError]:
	owner = variant_owner(declared.variant)
	arguments: List[InferenceType] = match expected:
		Some(hint):
			match inference_shape(hint):
				InferredNominal(AggregateNominal(UnionAggregate(expected_owner)), values):
					if expected_owner == owner:
						values
					else:
						[]
				_: []
		None: []
	head: InferenceType = if arguments.is_empty():
		AcceptedType(NominalType(AggregateNominal(UnionAggregate(owner)), []))
	else:
		InferredNominal(AggregateNominal(UnionAggregate(owner)), arguments)
	_: Void ?= if or(declared.parameters.is_empty(), arguments.is_empty().not()):
		Ok(void)
	else:
		Err(constructor_error(name.span, ConstructorNeedsExpectedType(name.id)))
	instantiate_variant(declared, head, arguments, name)


pure func plan_qualified_variant(
	owner: UnionId,
	variant: VariantId,
	name: WrittenName,
	arguments: List[ValueExpression],
	called: Bool,
	expected: Option[InferenceType],
	context: ConstructionContext,
	slots: List[InferenceSlot],
) -> Result[PlannedBase, CheckError]:
	contract ?= declared_variant_contract(context, owner, variant, name.span)
	declared ?= contract.to_result(checker_invariant(name.span, InvalidCheckedUnion(owner)))
	normalized: Result[Option[InferenceType], CheckError] = match expected:
		Some(term):
			match inference_head(term, slots, name.span):
				Ok(head): Ok(Some(head))
				Err(error): Err(error)
		None: Ok(None)
	head ?= normalized
	match head:
		Some(term):
			match term:
				CallVariable(_):
					if declared.parameters.is_empty():
						plan_known_qualified_variant(declared, name, arguments, called, head)
					else:
						Ok(PlannedContext(SuspendedQualifiedVariant(declared, name, arguments, called), term))
				_: plan_known_qualified_variant(declared, name, arguments, called, head)
		_: plan_known_qualified_variant(declared, name, arguments, called, head)


private pure func plan_known_qualified_variant(declared: DeclaredVariantContract, name: WrittenName, arguments: List[ValueExpression], called: Bool, expected: Option[InferenceType]) -> Result[PlannedBase, CheckError]:
	contract ?= pending_qualified_variant(declared, name, expected)
	plan_variant_arguments(contract, name, arguments, called)


pure func plan_variant(
	variant: VariantId,
	name: WrittenName,
	arguments: List[ValueExpression],
	called: Bool,
	expected: Option[InferenceType],
	slots: List[InferenceSlot],
	context: ConstructionContext,
) -> Result[PlannedBase, CheckError]:
	term ?= expected.to_result(constructor_error(name.span, ConstructorNeedsExpectedType(name.id)))
	head ?= inference_head(term, slots, name.span)
	match head:
		CallVariable(_): Ok(PlannedContext(SuspendedVariant(variant, name, arguments, called), head))
		_: plan_known_variant(variant, name, arguments, called, head, slots, context)


private pure func plan_known_variant(variant: VariantId, name: WrittenName, arguments: List[ValueExpression], called: Bool, expected: InferenceType, slots: List[InferenceSlot], context: ConstructionContext) -> Result[PlannedBase, CheckError]:
	contract ?= pending_variant(variant, name, Some(expected), slots, context)
	plan_variant_arguments(contract, name, arguments, called)


-- A payload-free variant takes no call, and a payload variant takes one
-- argument per field.
private pure func plan_variant_arguments(contract: PendingVariantContract, name: WrittenName, arguments: List[ValueExpression], called: Bool) -> Result[PlannedBase, CheckError]:
	if and(contract.fields.is_empty(), called):
		Err(constructor_error(name.span, PayloadFreeVariantCalled(contract.variant)))
	else if contract.fields.length() != arguments.length():
		Err(constructor_error(name.span, ConstructorFieldCountMismatch(contract.variant, contract.fields.length(), arguments.length())))
	else:
		Ok(PlannedVariant(contract, arguments))


private pure func validate_variant_field(
	contract: PendingVariantContract,
	annotation: InferenceUse,
	value: PendingValue,
	position: Int,
	slots: List[InferenceSlot],
) -> Result[Void, CheckError]:
	expected ?= publish_inference_type(annotation.value_type, slots, CompleteInference, annotation.span)
	actual ?= publish_inference_type(pending_type(value), slots, CompleteInference, value.span)
	if same_type(expected, actual):
		Ok(void)
	else:
		Err(call_error(
			contract.span,
			ArgumentTypeMismatch({
				expected = expected,
				actual = { value_type = actual, span = value.span },
				argument_position = position,
				expected_site = SourceAnnotation(annotation.span),
			}),
		))


pure func validate_variant_fields(
	contract: PendingVariantContract,
	values: List[PendingValue],
	slots: List[InferenceSlot],
) -> Result[Void, CheckError]:
	var position = 0
	var failure: Option[CheckError] = None
	for value in values:
		result: Result[Void, CheckError] = match contract.fields.get(position):
			Some(annotation): validate_variant_field(contract, annotation, value, position, slots)
			None: Err(checker_invariant(contract.span, GenericConstructorContract))
		match result:
			Ok(_): void
			Err(error):
				failure = Some(error)
				break
		position = position.add(1)
	match failure:
		Some(error): Err(error)
		None: Ok(void)


pure func finish_pending_variant(
	contract: PendingVariantContract,
	values: List[PendingValue],
	span: Span,
	slots: List[InferenceSlot],
) -> Result[PendingValue, CheckError]:
	readiness ?= construction_readiness(values.any(is_deferred), contract.result_type, slots, span)
	_: Void ?= match readiness:
		ClosedInference: validate_variant_fields(contract, values, slots)
		DeferredInference: Ok(void)
	value_type ?= construction_result_type(contract.result_type, readiness, slots, span)
	Ok({
		span = span,
		readiness = readiness,
		base = PendingConstructVariant(contract, values),
		base_type = value_type,
		base_span = contract.span,
		operations = NoPendingOperations,
	})


-- A list literal is a construction of n stored occurrences. The expected List
-- type supplies E when the context establishes one; otherwise the first
-- element decides, so an empty literal without a List context is rejected.
pure func plan_list_literal(
	elements: List[ValueExpression],
	expectation: Option[InferenceType],
	span: Span,
) -> Result[PlannedBase, CheckError]:
	source: ListElementSource = match expectation:
		Some(hint):
			match inference_shape(hint):
				InferredList(element): ExpectedElementType(element)
				_: FirstElementType
		None: FirstElementType
	match source:
		ExpectedElementType(_): Ok(PlannedList(elements, source))
		FirstElementType:
			if elements.is_empty():
				Err(value_error(span, EmptyListNeedsElementType))
			else:
				Ok(PlannedList(elements, source))


pure func list_element_type(
	source: ListElementSource,
	values: List[PendingValue],
	span: Span,
) -> Result[InferenceType, CheckError]:
	match source:
		ExpectedElementType(element): Ok(element)
		FirstElementType:
			match values.get(0).to_result(checker_invariant(span, InvalidInferenceWorklist)):
				Ok(first): Ok(pending_type(first))
				Err(error): Err(error)


-- Every element's published type must equal the published E; the first
-- mismatch is reported at that element, naming what it had to agree with.
pure func validate_list_elements(
	source: ListElementSource,
	values: List[PendingValue],
	slots: List[InferenceSlot],
	span: Span,
) -> Result[TypeRef, CheckError]:
	element ?= list_element_type(source, values, span)
	expected ?= publish_inference_type(element, slots, CompleteInference, span)
	reference: ListElementReference = match source:
		ExpectedElementType(_): ExpectedElement
		FirstElementType: EarlierElement
	var position = 1
	var failure: Option[CheckError] = None
	for value in values:
		match publish_inference_type(pending_type(value), slots, CompleteInference, value.span):
			Err(error):
				failure = Some(error)
				break
			Ok(actual):
				if same_type(expected, actual).not():
					failure = Some(value_error(value.span, ListElementTypeMismatch({
						position = position, actual = actual, expected = expected, reference = reference,
					})))
					break
		position = position.add(1)
	match failure:
		Some(error): Err(error)
		None: Ok(expected)


pure func finish_pending_list(
	source: ListElementSource,
	values: List[PendingValue],
	span: Span,
	base_span: Span,
	slots: List[InferenceSlot],
) -> Result[PendingValue, CheckError]:
	element ?= list_element_type(source, values, base_span)
	readiness ?= construction_readiness(values.any(is_deferred), element, slots, base_span)
	value_type: InferenceType ?= match readiness:
		ClosedInference: validate_list_elements(source, values, slots, base_span).map(pure func(accepted): AcceptedType(ListType(accepted)))
		DeferredInference: Ok(list_inference_type(element))
	Ok({
		span = span,
		readiness = readiness,
		base = PendingConstructList(source, values),
		base_type = value_type,
		base_span = base_span,
		operations = NoPendingOperations,
	})


union CallPlacement:
	ReturnPlacement(Span, Span)
	ReceiverPlacement(PendingValue, Span)


-- A construct whose nominal expected head is still a call-local variable.
-- Names already resolved to variants retain that identity while waiting.
union SuspendedConstruction:
	SuspendedRecord(List[ParsedRecordField], Span)
	SuspendedVariant(VariantId, WrittenName, List[ValueExpression], Bool)
	SuspendedQualifiedVariant(DeclaredVariantContract, WrittenName, List[ValueExpression], Bool)


pure func resume_construction(written: SuspendedConstruction, head: InferenceType, context: ConstructionContext, slots: List[InferenceSlot]) -> Result[PlannedBase, CheckError]:
	match written:
		SuspendedRecord(fields, span): plan_known_record(fields, span, head, context)
		SuspendedVariant(variant, name, arguments, called): plan_known_variant(variant, name, arguments, called, head, slots, context)
		SuspendedQualifiedVariant(declared, name, arguments, called): plan_known_qualified_variant(declared, name, arguments, called, Some(head))


pure func construction_context_error(written: SuspendedConstruction) -> CheckError:
	match written:
		SuspendedRecord(_, span): record_error(span, RecordNeedsExpectedType)
		SuspendedVariant(_, name, _, _):
			constructor_error(name.span, ConstructorNeedsExpectedType(name.id))
		SuspendedQualifiedVariant(_, name, _, _):
			constructor_error(name.span, ConstructorNeedsExpectedType(name.id))


union PlannedBase:
	PlannedContext(SuspendedConstruction, InferenceType)
	PlannedCallable(ValueExpression, Option[InferenceType])
	PlannedLeaf(PendingBase, TypeRef)
	PlannedConstructOpaque(CheckedOpaque, ValueExpression)
	PlannedProjectOpaque(CheckedOpaque, ValueExpression)
	PlannedRecord(PlannedRecordFields)
	PlannedUpdate(ValueExpression, List[ParsedRecordField], Option[InferenceType])
	PlannedVariant(PendingVariantContract, List[ValueExpression])
	PlannedTuple(List[ValueExpression], List[Option[InferenceType]])
	PlannedInterpolation(List[ValueExpression])
	PlannedList(List[ValueExpression], ListElementSource)
	PlannedCall(FunctionContract, List[ValueExpression], CallPlacement, Option[InferenceType])
	PlannedStoredCall(CheckedExpr, FunctionContract, List[ValueExpression], CallPlacement, Option[InferenceType])
