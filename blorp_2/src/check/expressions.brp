										None: failure = Some(checker_invariant(span, InvalidInferenceWorklist))
					SolveConstraint(equality):
						var inspect: Bool = True

						match equality.origin:
							ResultConstraint(_):
								match result_state:
									IncompatibleResultInference: inspect = False
									_: void
							LambdaConstraint(_): void
							ArgumentConstraint(_, _, _, _): void
							OpaqueOperandConstraint(_, _): void
							InterpolationConstraint(_): void
							VariantConstraint(_, _): void
							RecordFieldConstraint(_, _, _): void
							ListElementConstraint(_, _): void
							ReceiverOverlapConstraint(_): void

						if inspect:
							match record_argument_origin(equality, slots):
								Err(error): failure = Some(error)
								Ok(Some(update)): slots = slots.set(update.position, update.slot)
								Ok(None): void

							if failure.is_none():
								match inspect_inference_equality(equality, slots):
									Err(error): failure = Some(error)
									Ok(step):
										match step:
											IncompatibleResult: result_state = IncompatibleResultInference
											CompleteEquality: void
											UpdateInferenceSlots(updates):
												inference_revision = inference_revision.add(1)
												for update in updates:
													slots = slots.set(update.position, update.slot)
											ExpandInferenceList(child):
												work = push_expression_work(work, work_count, SolveConstraint(child))
												work_count = work_count.add(1)
											ExpandInferenceArguments(current, left, right):
												var position = left.length()

												while position.greater_than(0):
													position = position.subtract(1)

													match inference_child(current, left, right, position):
														Err(error):
															failure = Some(error)
															break
														Ok(child):
															work = push_expression_work(work, work_count, SolveConstraint(child))
															work_count = work_count.add(1)
					ResolveContexts(position, revision):
						match context_work.get(position):
							None:
								work = push_expression_work(work, work_count, ResolveLambdas(0, revision))
								work_count = work_count.add(1)
							Some(item):
								work = push_expression_work(work, work_count, ResolveContexts(position.add(1), revision))
								work_count = work_count.add(1)
								match item:
									CompletedContext(_): void
									AwaitingContext(construct, expected, local_scope, local_site, span):
										match inference_head(expected, slots, span):
											Err(error): failure = Some(error)
											Ok(CallVariable(_)): void
											Ok(head):
												match resume_construction(construct, head, site_construction(local_site), slots):
													Err(error): failure = Some(error)
													Ok(plan):
														work = push_expression_work(work, work_count, FinishContext(position, scope, site, operand_count))
														work_count = work_count.add(1)
														scope = local_scope
														site = local_site
														match plan:
															PlannedRecord(literal):
																work = push_expression_work(work, work_count, ScheduleRecord(literal))
																work_count = work_count.add(1)
															PlannedVariant(contract, arguments):
																work = push_expression_work(work, work_count, ScheduleVariant(contract, arguments, span))
																work_count = work_count.add(1)
															_: failure = Some(checker_invariant(span, InvalidInferenceWorklist))
					FinishContext(position, parent_scope, parent_site, start):
						match expression_operand(operands, start, body.span):
							Err(error): failure = Some(error)
							Ok(value): context_work = context_work.set(position, CompletedContext(value))
						operands = operands.set(start, None)
						operand_count = start
						scope = parent_scope
						site = parent_site
						inference_revision = inference_revision.add(1)

					ResolveLambdas(position, revision):
						match site:
							ConstantInitializer(_, _, _): void
							BodyExpression(context, resolve_block):
								match lambda_work.get(position):
									None:
										if revision != inference_revision:
											next_resolution: ExpressionWork = if context_work.is_empty():
												ResolveLambdas(0, inference_revision)
											else:
												ResolveContexts(0, inference_revision)
											work = push_expression_work(work, work_count, next_resolution)
											work_count = work_count.add(1)
										else:
											for pending in context_work:
												match pending:
													AwaitingContext(construct, _, _, _, _):
														error = construction_context_error(construct)
														match failure:
															None: failure = Some(error)
															Some(previous):
																if error.span.start.less_than(previous.span.start):
																	failure = Some(error)
													CompletedContext(_): void

											has_unready = lambda_work.any(pure func(item):
												match item:
													AwaitingLambda(_): True
													_: False
											)
											if has_unready:
												match reject_unready_lambdas(lambda_work, slots, context.caller.body):
													Err(error):
														match failure:
															None: failure = Some(error)
															Some(context_error):
																-- Span order chooses diagnostics within this expression;
																-- it establishes no semantic identity or inference fact.
																if error.span.start.less_than(context_error.span.start):
																	failure = Some(error)
													Ok(_): void
									Some(item):
										work = push_expression_work(work, work_count, ResolveLambdas(position.add(1), revision))
										work_count = work_count.add(1)
										match item:
											AwaitingLambda(admission):
												match lambda_ready(admission, slots):
													Err(error): failure = Some(error)
													Ok(False): void
													Ok(True):
														match lambda_scope(admission, slots):
															Err(error): failure = Some(error)
															Ok(local):
																lambda_context = { admission.context | caller = { body = Checked.LambdaBody(admission.id), purity = admission.written.purity }, in_source_loop = False }
																match admission.written.body:
																	InlineBody(value):
																		finish: LambdaFinish = { position = position, scope = scope, context = context, bindings = bindings, operand_start = operand_count }
																		work = push_expression_work(work, work_count, FinishLambda(finish))
																		work_count = work_count.add(1)
																		work = push_expression_work(work, work_count, EnterExpression(value, Some(admission.result)))
																		work_count = work_count.add(1)
																		scope = local.scope
																		site = BodyExpression(lambda_context, resolve_block)
																		bindings = local.bindings
																	BlockBody(block):
																		match publish_inference_type(admission.result, slots, CompleteInference, admission.written.span):
																			Err(error): failure = Some(error)
																			Ok(result):
																				match resolve_block(local.scope, local.bindings, block, { value_type = result, span = admission.written.span }, lambda_context, lambdas):
																					Err(error): failure = Some(error)
																					Ok(resolved):
																						lambdas = resolved.lambdas
																						match checked_lambda(admission, resolved.bindings, resolved.statements, resolved.body, slots, lambdas):
																							Err(error): failure = Some(error)
																							Ok(row):
																								lambdas = lambdas.set(lambda_number(admission.id), CheckedLambdaRow(row))
																								lambda_work = lambda_work.set(position, CompletedLambda)
											InferredLambda(_, _, _): void
											CompletedLambda: void

					FinishLambda(finish):
						value_result = expression_operand(operands, finish.operand_start, body.span)
						completed_bindings = bindings
						if operand_count != finish.operand_start.add(1):
							failure = Some(checker_invariant(body.span, InvalidInferenceWorklist))
						operands = operands.set(finish.operand_start, None)
						operand_count = finish.operand_start
						scope = finish.scope
						match site:
							BodyExpression(_, resolve_block): site = BodyExpression(finish.context, resolve_block)
							ConstantInitializer(_, _, _): failure = Some(checker_invariant(body.span, InvalidInferenceWorklist))
						bindings = finish.bindings
						match lambda_work.get(finish.position):
							Some(AwaitingLambda(admission)):
								match value_result:
									Err(error): failure = Some(error)
									Ok(value):
										lambda_work = lambda_work.set(finish.position, InferredLambda(admission, completed_bindings, value))
										inference_revision = inference_revision.add(1)
										match inference_head(admission.result, slots, value.span):
											Err(error): failure = Some(error)
											Ok(AcceptedType(VoidType)): void
											Ok(_):
												equality: InferenceEquality = { expected = admission.result, actual = pending_type(value), origin = LambdaConstraint(value.span), relation = RequireEquality, parameter = None }
												work = push_expression_work(work, work_count, SolveConstraint(equality))
												work_count = work_count.add(1)
							_: failure = Some(checker_invariant(body.span, InvalidInferenceWorklist))
					FinishRoot:
						operand_count = operand_count.subtract(1)
						value_result = expression_operand(operands, operand_count, body.span)
						operands = operands.set(operand_count, None)

						match value_result:
							Err(error): failure = Some(error)
							Ok(value):
								work = push_expression_work(work, work_count, FreezeRoot(value))
								work_count = work_count.add(1)
								progress: ExpressionWork = if context_work.is_empty():
									ResolveLambdas(0, inference_revision)
								else:
									ResolveContexts(0, inference_revision)
								work = push_expression_work(work, work_count, progress)
								work_count = work_count.add(1)

								match result_context:
									Some(result):
										if slots.is_empty().not():
											equality: InferenceEquality = { expected = pending_type(value), actual = inference_type(result.expected.value_type, [], 0), origin = ResultConstraint(result), relation = RequireEquality, parameter = None }
											work = push_expression_work(work, work_count, SolveConstraint(equality))
											work_count = work_count.add(1)
											result_state = SolvingResultInference
									None: void
					FreezeRoot(value):
						match freeze_lambdas(lambda_work, slots, lambdas, context_work, assumptions, site_traits(site)):
							Err(error): failure = Some(error)
							Ok(rows):
								lambdas = rows
								captures: CaptureScope = match site:
									BodyExpression(context, _): BodyCaptures(context.caller.body, lambdas)
									ConstantInitializer(_, _, _): NoCaptures
								match freeze_pending_value(value, slots, captures, context_work, assumptions, site_traits(site)):
									Err(error): failure = Some(error)
									Ok(frozen_value): accepted = Some(frozen_value)
			_: failure = Some(checker_invariant(body.span, InvalidInferenceWorklist))

	match failure:
		Some(error): Err(error)
		None:
			match accepted:
				Some(value): Ok({ value = value, lambdas = lambdas })
				None: Err(checker_invariant(body.span, InvalidInferenceWorklist))


private pure func freeze_pending_values(values: List[PendingValue], slots: List[InferenceSlot], captures: CaptureScope, constructions: List[ContextWork], assumptions: List[Checked.TraitRequirement], traits: TraitAvailability) -> Result[List[CheckedExpr], CheckError]:
	var frozen: List[CheckedExpr] = []
	var failure: Option[CheckError] = None

	for value in values:
		match freeze_pending_value(value, slots, captures, constructions, assumptions, traits):
			Err(error):
				failure = Some(error)
				break
			Ok(frozen_value):
				frozen = frozen.append(frozen_value)

	match failure:
		Some(error): Err(error)
		None: Ok(frozen)


-- A receiver is written formal0. Its declared formal decides value versus
-- callable operand; both remain in actual typechecking at the same position.
private pure func freeze_pending_call(call: PendingCall, values: List[PendingValue], receiver: Option[CheckedExpr], slots: List[InferenceSlot], captures: CaptureScope, constructions: List[ContextWork], assumptions: List[Checked.TraitRequirement], traits: TraitAvailability) -> Result[CheckedCall, CheckError]:
	var actual = pending_arguments(values)
	var operands: List[CheckedCallOperand] = []
	var written_position = if receiver.is_some():
		1
	else:
		0
	var failure: Option[CheckError] = None

	match receiver:
		Some(frozen_receiver):
			receiver_use: InferenceUse = { value_type = AcceptedType(frozen_receiver.value_type), span = call.span }
			actual = [receiver_use].concat(actual)
			match call.target:
				PendingDeclared(owner):
					match call.signature.parameters.get(0):
						None: failure = Some(checker_invariant(call.span, MissingCallParameter(0)))
						Some(parameter):
							match parameter.value_type:
								CallableType(_, _, _): operands = [CallableOperand(callable_parameter(owner, 0), StoredCallable(frozen_receiver), call.span)]
								_: operands = [ValueOperand(frozen_receiver)]
				PendingRuntime(_) | PendingMethod(_) | PendingParameter(_) | PendingStored(_): operands = [ValueOperand(frozen_receiver)]
		None: void

	for value in values:
		if failure.is_some():
			break
		match call.signature.parameters.get(written_position):
			None:
				failure = Some(checker_invariant(value.span, MissingCallParameter(written_position)))
				break
			Some(parameter):
				match call.target:
					PendingDeclared(owner):
						match parameter.value_type:
							CallableType(_, _, _):
								match freeze_callable_choice(value, slots, captures, constructions, assumptions, traits):
									Ok(choice): operands = operands.append(CallableOperand(callable_parameter(owner, written_position), choice, value.span))
									Err(error): failure = Some(error)
							_:
								match freeze_pending_value(value, slots, captures, constructions, assumptions, traits):
									Ok(frozen): operands = operands.append(ValueOperand(frozen))
									Err(error): failure = Some(error)
					PendingRuntime(_) | PendingMethod(_) | PendingParameter(_) | PendingStored(_):
						match freeze_pending_value(value, slots, captures, constructions, assumptions, traits):
							Ok(frozen): operands = operands.append(ValueOperand(frozen))
							Err(error): failure = Some(error)
		written_position = written_position.add(1)

	_: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	checked_call ?= publish_pending_call(call, operands, slots, traits, assumptions)
	parameters ?= admit_call_parameters(call, slots)
	return_type ?= admit_call_type(call.signature.return_type.value_type, call, slots, call.span)
	valid ?= validate_complete_arguments(call, parameters, return_type, actual, slots)
	Ok(checked_call)


private pure func freeze_retained_fields(fields: List[PendingRetainedField], slots: List[InferenceSlot], span: Span) -> Result[List[RetainedRecordField], CheckError]:
	var frozen: List[RetainedRecordField] = []
	var failure: Option[CheckError] = None
	for field in fields:
		match publish_inference_type(field.value_type, slots, CompleteInference, span):
			Ok(value_type): frozen = frozen.append({ field = field.field, value_type = value_type })
			Err(error):
				failure = Some(error)
				break
	match failure:
		Some(error): Err(error)
		None: Ok(frozen)


private pure func freeze_opaque_operand(operand: PendingValue, operand_type: InferenceType, site: ExpectedTypeSite, slots: List[InferenceSlot], captures: CaptureScope, constructions: List[ContextWork], assumptions: List[Checked.TraitRequirement], traits: TraitAvailability) -> Result[CheckedExpr, CheckError]:
	value ?= freeze_pending_value(operand, slots, captures, constructions, assumptions, traits)
	expected ?= publish_inference_type(operand_type, slots, CompleteInference, operand.span)
	if same_type(value.value_type, expected):
		Ok(value)
	else:
		Err(value_error(operand.span, ExpressionTypeMismatch({ expected = expected, actual = { value_type = value.value_type, span = operand.span }, expected_site = site })))


-- Steps fold over their frozen receiver in source order. The loop keeps the
-- checker from recursing on chain length.
private pure func freeze_callable_choice(
	value: PendingValue, slots: List[InferenceSlot], captures: CaptureScope, constructions: List[ContextWork], assumptions: List[Checked.TraitRequirement], traits: TraitAvailability,
) -> Result[Checked.CallableChoice, CheckError]:
	match value.base:
		PendingNamedCallable(id, signature, start):
			var arguments: List[TypeRef] = []
			var failure: Option[CheckError] = None
			for parameter in signature.type_parameters:
				match publish_inference_type(inference_type(ParameterType(parameter), signature.type_parameters, start), slots, CompleteInference, value.span):
					Ok(argument): arguments = arguments.append(argument)
					Err(error):
						failure = Some(error)
						break
			match failure:
				Some(error): Err(error)
				None:
					match prove_requirements(traits, signature, arguments, assumptions, value.span):
						Err(error): Err(error)
						Ok(_): Ok(NamedCallable(id, arguments))
		PendingMethodCallable(method, signature, start):
			freeze_method_callable(method, signature, start, value.span, slots, assumptions, traits)
		PendingForwardedCallable(parameter): Ok(ForwardedCallable(parameter))
		PendingLambda(id):
			match captures:
				NoCaptures: Err(constant_error(value.span, NonClosedInitializer))
				BodyCaptures(owner, lambdas):
					match capture_operands(id, owner, lambdas, value.span):
						Ok(environment): Ok(LambdaCallable(id, environment))
						Err(error): Err(error)
		_:
			freeze_pending_value(value, slots, captures, constructions, assumptions, traits).map(pure func(frozen): StoredCallable(frozen))


private pure func freeze_method_callable(method: TraitMethodId, signature: FunctionSignature, start: Int, span: Span, slots: List[InferenceSlot], assumptions: List[Checked.TraitRequirement], traits: TraitAvailability) -> Result[Checked.CallableChoice, CheckError]:
	parameter ?= signature.type_parameters.get(0).to_result(checker_invariant(span, InvalidFunctionContract))
	published = publish_inference_type(inference_type(ParameterType(parameter), signature.type_parameters, start), slots, CompleteInference, span)
	receiver: TypeRef ?= match published:
		Ok(value_type): Ok(value_type)
		Err(error):
			context_error: CheckError = match error.kind:
				Errors.CallRejection(Errors.UninferableTypeParameter(_)): Errors.trait_error(span, Errors.MethodNeedsExpectedType(method))
				_: error
			Err(context_error)
	selected ?= accept_method_call(traits, method, receiver, assumptions, span)
	Ok(MethodCallable(selected))


private pure func freeze_record_update(
	base: PendingValue,
	expression_span: Span,
	fields: List[PendingRecordField],
	inherited: List[PendingRetainedField],
	slots: List[InferenceSlot],
	captures: CaptureScope, constructions: List[ContextWork], assumptions: List[Checked.TraitRequirement], traits: TraitAvailability,
) -> Result[CheckedRecordUpdate, CheckError]:
	frozen_base ?= freeze_pending_value(base, slots, captures, constructions, assumptions, traits)
	replacements ?= freeze_record_fields(fields, slots, captures, constructions, assumptions, traits)
	frozen_inherited ?= freeze_retained_fields(inherited, slots, expression_span)
	Ok({ base = frozen_base, base_expression_span = expression_span, replacements = replacements, inherited = frozen_inherited })


-- Balancing keeps the existing binary runtime operation while bounding recursive
-- consumers' depth. Its leaves still evaluate once, in written order.
private pure func concat_checked_parts(parts: List[CheckedExpr], first: Int, count: Int, span: Span) -> Result[CheckedExpr, CheckError]:
	if count == 0:
		Ok({ form = LiteralString(""), value_type = StringType, span = span })
	else if count == 1:
		match parts.get(first):
			Some(part): Ok(part)
			None: Err(checker_invariant(span, InvalidInferenceWorklist))
	else:
		left_count = count.divide(2)
		match concat_checked_parts(parts, first, left_count, span):
			Err(error): Err(error)
			Ok(left):
				match concat_checked_parts(parts, first.add(left_count), count.subtract(left_count), span):
					Err(error): Err(error)
					Ok(right):
						operation: RuntimeOperation[VariantId, TypeRef] = Builtins.StringConcat
						call: CheckedCall = { target = RuntimeFunction(operation), operands = [ValueOperand(left), ValueOperand(right)], span = span }
						Ok({ form = InvokeFunction(call), value_type = StringType, span = span })


private pure func freeze_interpolated(parts: List[PendingValue], slots: List[InferenceSlot], captures: CaptureScope, constructions: List[ContextWork], assumptions: List[Checked.TraitRequirement], traits: TraitAvailability, span: Span) -> Result[CheckedExpr, CheckError]:
	var checked: List[CheckedExpr] = []
	var failure: Option[CheckError] = None
	for part in parts:
		match freeze_pending_value(part, slots, captures, constructions, assumptions, traits):
			Err(error):
				failure = Some(error)
				break
			Ok(value):
				if same_type(value.value_type, StringType):
					checked = checked.append(value)
				else:
					failure = Some(value_error(part.span, InterpolationRequiresString(value.value_type)))
					break
	_: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	concat_checked_parts(checked, 0, checked.length(), span)


private pure func freeze_pending_value(value: PendingValue, slots: List[InferenceSlot], captures: CaptureScope, constructions: List[ContextWork], assumptions: List[Checked.TraitRequirement], traits: TraitAvailability) -> Result[CheckedExpr, CheckError]:
	base_result: Result[CheckedForm, CheckError] = match value.base:
		PendingContext(id):
			match constructions.get(construction_number(id)):
				Some(CompletedContext(completed)):
					freeze_pending_value(completed, slots, captures, constructions, assumptions, traits).map(pure func(frozen): frozen.form)
				_: Err(checker_invariant(value.span, InvalidInferenceWorklist))

		PendingNamedCallable(_, _, _) | PendingMethodCallable(_, _, _) | PendingForwardedCallable(_) | PendingLambda(_):
			freeze_callable_choice(value, slots, captures, constructions, assumptions, traits).map(pure func(choice): MakeCallable(choice))
		AcceptedVoid: Ok(LiteralVoid)
		AcceptedInteger(integer): Ok(LiteralInteger(integer))
		AcceptedFloat(number): Ok(LiteralFloat(number))
		AcceptedString(text): Ok(LiteralString(text))
		AcceptedConstant(template): Ok(template.form)
		AcceptedBinding(id): Ok(ReadBinding(id))
		AcceptedCapture(id): Ok(ReadCapture(id))
		PendingCapture(_): Err(checker_invariant(value.span, InvalidInferenceWorklist))
		PendingConstructOpaque(conversion, operand):
			match freeze_opaque_operand(operand, conversion.underlying_type, OpaqueConstruction(conversion.id), slots, captures, constructions, assumptions, traits):
				Ok(frozen_operand): Ok(ConstructOpaque(conversion.id, frozen_operand))
				Err(error): Err(error)
		PendingProjectOpaque(conversion, operand):
			match freeze_opaque_operand(operand, conversion.opaque_type, OpaqueProjection(conversion.id), slots, captures, constructions, assumptions, traits):
				Ok(frozen_operand): Ok(ProjectOpaque(conversion.id, frozen_operand))
				Err(error): Err(error)
		PendingConstructRecord(owner, fields):
			match freeze_record_fields(fields, slots, captures, constructions, assumptions, traits):
				Ok(frozen): Ok(ConstructRecord(owner, frozen))
				Err(error): Err(error)
		PendingUpdateRecord(owner, base, expression_span, fields, inherited):
			match freeze_record_update(base, expression_span, fields, inherited, slots, captures, constructions, assumptions, traits):
				Ok(update): Ok(UpdateRecord(owner, update))
				Err(error): Err(error)
		PendingConstructVariant(contract, values):
			match freeze_pending_values(values, slots, captures, constructions, assumptions, traits):
				Ok(frozen):
					match validate_variant_fields(contract, values, slots):
						Ok(valid): Ok(ConstructVariant(contract.variant, frozen))
						Err(error): Err(error)
				Err(error): Err(error)
		PendingInterpolatedString(values):
			freeze_interpolated(values, slots, captures, constructions, assumptions, traits, value.base_span).map(pure func(joined): joined.form)
		PendingConstructTuple(values):
			freeze_pending_values(values, slots, captures, constructions, assumptions, traits).map(pure func(frozen): ConstructTuple(frozen))
		PendingConstructList(source, values):
			match freeze_pending_values(values, slots, captures, constructions, assumptions, traits):
				Ok(frozen):
					match validate_list_elements(source, values, slots, value.base_span):
						Ok(valid): Ok(ConstructList(frozen))
						Err(error): Err(error)
				Err(error): Err(error)
		PendingDirectCall(call, arguments):
			freeze_pending_call(call, arguments, None, slots, captures, constructions, assumptions, traits).map(pure func(resolved): InvokeFunction(resolved))
	base ?= base_result
	base_type ?= publish_inference_type(value.base_type, slots, CompleteInference, value.base_span)
	var current: CheckedExpr = { form = base, value_type = base_type, span = value.base_span }
	var failure: Option[CheckError] = None

	var steps: List[PendingStep] = []
	var cursor = value.operations
	var complete: Bool = False

	while complete.not():
		match cursor:
			NoPendingOperations: complete = True
			PendingOperationLink(step, previous):
				steps = steps.append(step)
				cursor = previous

	var position = steps.length()

	while position.greater_than(0):
		position = position.subtract(1)

		match steps.get(position):
			None:
				failure = Some(checker_invariant(value.span, InvalidInferenceWorklist))
				break
			Some(step):
				match freeze_pending_step(step, current, slots, captures, constructions, assumptions, traits):
					Err(error):
						failure = Some(error)
						break
					Ok(next):
						current = next

	_: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	Ok(current)


private pure func freeze_pending_step(step: PendingStep, receiver: CheckedExpr, slots: List[InferenceSlot], captures: CaptureScope, constructions: List[ContextWork], assumptions: List[Checked.TraitRequirement], traits: TraitAvailability) -> Result[CheckedExpr, CheckError]:
	form_result: Result[CheckedForm, CheckError] = match step.operation:
		AcceptedTupleElement(position): Ok(ReadTupleElement(receiver, position))
		AcceptedField(field): Ok(ReadRecordField(receiver, field))
		PendingInvocation(call, values):
			match freeze_pending_call(call, values, Some(receiver), slots, captures, constructions, assumptions, traits):
				Ok(resolved): Ok(InvokeFunction(resolved))
				Err(error): Err(error)
	form ?= form_result
	value_type ?= publish_inference_type(step.value_type, slots, CompleteInference, step.span)
	Ok({ form = form, value_type = value_type, span = step.span })


pure func synthesize_value(
	scope: List[ScopedValue], body: ValueExpression, constructor_type: Option[TypeRef], context: ResolutionContext,
	lambdas: List[LambdaRow],
	resolve_block: pure (
		List[ScopedValue], List[BindingDefinition], ParsedBlock,
		TypeUse, ResolutionContext, List[LambdaRow],
	) -> Result[ResolvedBody, CheckError],
) -> Result[CheckedValueResult, CheckError]:
	elaborate_value(scope, body, constructor_type, None, BodyExpression(context, resolve_block), lambdas)


pure func check_value(
	scope: List[ScopedValue], body: ValueExpression, expected: TypeRef, site: ExpectedTypeSite, context: ResolutionContext,
	lambdas: List[LambdaRow],
	resolve_block: pure (
		List[ScopedValue], List[BindingDefinition], ParsedBlock,
		TypeUse, ResolutionContext, List[LambdaRow],
	) -> Result[ResolvedBody, CheckError],
) -> Result[CheckedValueResult, CheckError]:
	obligation: ExpectedValue = { value_type = expected, site = site }
	value ?= elaborate_value(scope, body, Some(expected), Some({ expected = obligation, span = body.span }), BodyExpression(context, resolve_block), lambdas)
	if same_type(value.value.value_type, expected):
		Ok(value)
	else:
		Err(value_error(body.span, ExpressionTypeMismatch({ expected = expected, actual = { value_type = value.value.value_type, span = body.span }, expected_site = site })))


pure func check_constant_initializer(
	body: ValueExpression, annotation: TypeUse, construction: ConstructionContext, signatures: List[AcceptedFunction], traits: TraitAvailability,
) -> Result[CheckedExpr, CheckError]:
	obligation: ExpectedValue = { value_type = annotation.value_type, site = SourceAnnotation(annotation.span) }
	checked ?= elaborate_value([], body, Some(annotation.value_type), Some({ expected = obligation, span = body.span }), ConstantInitializer(construction, signatures, traits), [])
	-- The shared elaborator already publishes the receiving annotation's view.
	if same_type(checked.value.value_type, annotation.value_type):
		Ok({ checked.value | span = body.span })
	else:
		Err(value_error(body.span, ExpressionTypeMismatch({ expected = annotation.value_type, actual = { value_type = checked.value.value_type, span = body.span }, expected_site = SourceAnnotation(annotation.span) })))


-- Stored calls read the same scoped binding as an ordinary data expression.
private pure func data_callable_application(
	name: WrittenName, arguments: List[ValueExpression], binding: LocalBinding,
	context: ResolutionContext,
) -> Result[ResolvedApplication, CheckError]:
	definition = binding_definition(binding)
	match definition.value_type:
		CallableType(purity, parameters, result):
			immutable_capture_result: Result[Void, CheckError] = if same_body(binding_site(binding).binding.owner, context.caller.body):
				Ok(void)
			else:
				if definition.mutable:
					Err(value_error(name.span, MutableCapture(binding_site(binding).binding)))
				else:
					Ok(void)
			match immutable_capture_result:
				Err(error): Err(error)
				Ok(immutable_capture):
					contract: FunctionSignature = {
						type_parameters = [], requirements = [], purity = purity,
						parameters = parameters.map(pure func(value) -> TypeUse: { value_type = value, span = definition.span }),
						return_type = { value_type = result, span = definition.span },
					}
					match value_callable_contract(context.caller, name, arguments, ValueTarget(binding_site(binding).binding), contract):
						Ok(accepted): Ok(FunctionApplication(accepted))
						Err(error): Err(error)
		_: Err(non_callable(binding, name.span))


private pure func constant_application(
	row: Checked.CheckedConstant, name: WrittenName, arguments: List[ValueExpression], read_span: Span, context: ResolutionContext,
) -> Result[ResolvedApplication, CheckError]:
	match row.value.value_type:
		CallableType(purity, parameters, result):
			signature: FunctionSignature = {
				type_parameters = [], requirements = [], purity = purity,
				parameters = parameters.map(pure func(value) -> TypeUse: { value_type = value, span = row.annotation }),
				return_type = { value_type = result, span = row.annotation },
			}
			value_callable_contract(context.caller, name, arguments, ConstantTarget(row.id), signature).map(
				pure func(contract): StoredApplication({ row.value | span = read_span }, contract),
			)
		_: Err(constant_error(name.span, ConstantCalled(row.id)))


private pure func classify_direct_call(
	name: WrittenName,
	arguments: List[ValueExpression],
	scope: List[ScopedValue],
	context: ResolutionContext,
) -> Result[ResolvedApplication, CheckError]:
	match lookup_binding(scope, name.id):
		Some(DataLocal(binding)): data_callable_application(name, arguments, binding, context)
		Some(CallableLocal(binding)):
			if same_body(binding_site(callable_local(binding)).binding.owner, context.caller.body):
				match callable_contract(context.caller, name, arguments, binding):
					Ok(contract): Ok(FunctionApplication(contract))
					Err(error): Err(error)
			else:
				data_callable_application(name, arguments, callable_local(binding), context)
		None:

			match named_value(context.namespace, context.module, name.id):
				Some(NamedConstant(id)):
					match constant_row(context.constants, id).to_result(checker_invariant(name.span, InvalidConstantDeclaration(id))):
						Err(error): Err(error)
						Ok(row): constant_application(row, name, arguments, name.span, context)
				Some(NamedMethod(method)):
					method_contract(name, arguments.length(), False, method, accepted_traits(context.traits)).map(pure func(contract): FunctionApplication(contract))
				Some(NamedFunction(target, _)):
					match function_contract(
						context.caller,
						name,
						False,
						arguments,
						target,
						context.signatures,
					):
						Ok(contract): Ok(FunctionApplication(contract))
						Err(error): Err(error)
				Some(NamedConstructor(variant)):
					Ok(ConstructorApplication(variant, name))
				_:
					Err(call_error(name.span, UnknownFunction(name.id)))


private pure func non_callable(
	binding: LocalBinding,
	span: Span,
) -> CheckError:
	call_error(
		span,
		UncallableBinding(
			binding_site(binding),
			binding_definition(binding).origin,
			binding_definition(binding).value_type,
		),
	)


private pure func named_callable_operand(
	id: FunctionId,
	written: ValueExpression,
	site: ExpressionSite,
	start: Int,
) -> Result[PendingValue, CheckError]:
	span = written.base_span
	accepted ?= site_signatures(site).get(function_number(id)).to_result(checker_invariant(span, InvalidInferenceWorklist))
	_: Void ?= match site:
		ConstantInitializer(_, _, _): Ok(void)
		BodyExpression(context, _):
			if and(same_body(DeclaredBody(id), context.caller.body), accepted.declaration.tail_annotation.is_some()):
				rejection: Result[Void, CheckError] = if accepted.signature.type_parameters.is_empty():
					Err(recursion_error(span, AnnotatedSelfCallback))
				else:
					Err(recursion_error(span, GenericTailRecursionUnsupported))
				rejection
			else:
				Ok(void)
	Ok(named_callable_value(accepted, written, start))


-- Instantiation needs the accepted declaration, not a caller or capture scope.
private pure func named_callable_value(accepted: AcceptedFunction, written: ValueExpression, start: Int) -> PendingValue:
	{
		span = written.span,
		readiness = DeferredInference,
		base = PendingNamedCallable(accepted.id, accepted.signature, start),
		base_type = inference_type(
			CallableType(
				accepted.signature.purity,
				accepted.signature.parameters.map(pure func(value): value.value_type),
				accepted.signature.return_type.value_type,
			),
			accepted.signature.type_parameters, start,
		),
		base_span = written.base_span,
		operations = NoPendingOperations
	}


private pure func method_callable_operand(method: TraitMethodId, written: ValueExpression, site: ExpressionSite, start: Int) -> Result[PendingValue, CheckError]:
	traits = site_traits(site)
	owner ?= accepted_traits(traits).declarations.get(trait_number(trait_method_owner(method))).to_result(checker_invariant(written.base_span, InvalidFunctionContract))
	accepted ?= owner.methods.get(trait_method_number(method)).to_result(checker_invariant(written.base_span, InvalidFunctionContract))
	Ok({
		span = written.span, readiness = DeferredInference,
		base = PendingMethodCallable(method, accepted.signature, start),
		base_type = inference_type(CallableType(accepted.signature.purity, accepted.signature.parameters.map(pure func(parameter): parameter.value_type), accepted.signature.return_type.value_type), accepted.signature.type_parameters, start),
		base_span = written.base_span, operations = NoPendingOperations
	})


private union CallableInput:
	KnownCallableOperand(PendingValue)
	StoredCallableOperand


private pure func resolve_callable_operand(written: ValueExpression, scope: List[ScopedValue], site: ExpressionSite, start: Int) -> Result[CallableInput, CheckError]:
	match site:
		BodyExpression(context, _): resolve_body_callable_operand(written, scope, context, site, start)
		ConstantInitializer(construction, _, _):
			match written.base:
				NameExpression(name):
					match named_value(construction.namespace, construction.module, name.id):
						Some(NamedMethod(method)): method_callable_operand(method, written, site, start).map(pure func(value): KnownCallableOperand(value))
						Some(NamedFunction(id, _)): named_callable_operand(id, written, site, start).map(pure func(value): KnownCallableOperand(value))
						_: Ok(StoredCallableOperand)
				QualifiedName(qualified):
					match aliased_module(construction.namespace, construction.module, qualified.module):
						Err(error): Err(error)
						Ok(aliased):
							match offered_value(construction.namespace, aliased.target, qualified.name.id):
								Ok(OfferedMethod(method)): method_callable_operand(method, written, site, start).map(pure func(value): KnownCallableOperand(value))
								Ok(OfferedFunction(id)): named_callable_operand(id, written, site, start).map(pure func(value): KnownCallableOperand(value))
								_: Ok(StoredCallableOperand)
				_: Err(constant_error(written.span, NonClosedInitializer))


private pure func resolve_body_callable_operand(
	written: ValueExpression, scope: List[ScopedValue], context: ResolutionContext, site: ExpressionSite, start: Int,
) -> Result[CallableInput, CheckError]:
	if written.applications.is_empty().not():
		Ok(StoredCallableOperand)
	else:
		match written.base:
			NameExpression(name):
				match lookup_binding(scope, name.id):
					Some(CallableLocal(binding)):
						if same_body(binding_site(callable_local(binding)).binding.owner, context.caller.body):
							match callable_parameter_contract(binding):
								Err(error): Err(error)
								Ok(accepted): Ok(KnownCallableOperand({
									span = written.span, readiness = DeferredInference,
									base = PendingForwardedCallable(accepted.parameter),
									base_type = AcceptedType(binding_definition(callable_local(binding)).value_type),
									base_span = written.base_span, operations = NoPendingOperations,
								}))
						else:
							Ok(StoredCallableOperand)
					Some(DataLocal(_)): Ok(StoredCallableOperand)
					None:
						match named_value(context.namespace, context.module, name.id):
							Some(NamedMethod(method)): method_callable_operand(method, written, site, start).map(pure func(value): KnownCallableOperand(value))
							Some(NamedFunction(id, _)): named_callable_operand(id, written, site, start).map(pure func(value): KnownCallableOperand(value))
							Some(NamedAlias(_)): Err(qualified_error(name.span, BareModuleAlias(name.id)))
							_: Ok(StoredCallableOperand)
			QualifiedName(qualified):
				match aliased_module(context.namespace, context.module, qualified.module):
					Err(error): Err(error)
					Ok(aliased):
						match offered_value(context.namespace, aliased.target, qualified.name.id):
							Ok(OfferedMethod(method)): method_callable_operand(method, written, site, start).map(pure func(value): KnownCallableOperand(value))
							Ok(OfferedFunction(id)): named_callable_operand(id, written, site, start).map(pure func(value): KnownCallableOperand(value))
							_: Ok(StoredCallableOperand)
			_: Ok(StoredCallableOperand)



-- Annotations constrain the existing caller terms; they introduce no slots.
private pure func admit_lambda(
	id: LambdaId, written: ParsedLambda, expectation: Option[InferenceType],
	scope: List[ScopedValue], context: ResolutionContext, slots: List[InferenceSlot], postfixes: List[PostfixOperation],
) -> Result[AdmittedLambda, CheckError]:
	_: Void ?= if postfixes.is_empty():
		Ok(void)
	else:
		Err(call_error(written.span, CallableValueRequired))
	match expectation:
		None: admit_standalone_lambda(id, written, scope, context)
		Some(expected):
			match inference_head(expected, slots, written.span):
				Err(error): Err(error)
				Ok(head):
					match head:
						InferredCallable(_, _, _) | AcceptedType(CallableType(_, _, _)):
							admit_contextual_lambda(id, written, expected, head, scope, context, slots)
						_: admit_standalone_lambda(id, written, scope, context)


-- The inspected callable head keeps contextual propagation at function scope.
private pure func admit_contextual_lambda(
	id: LambdaId, written: ParsedLambda, expected: InferenceType, head: InferenceType,
	scope: List[ScopedValue], context: ResolutionContext, slots: List[InferenceSlot],
) -> Result[AdmittedLambda, CheckError]:
	_: Void ?= match head:
		InferredCallable(purity, _, _):
			if permits_purity(purity, written.purity):
				Ok(void)
			else:
				Err(call_error(written.span, ImpureLambda))
		AcceptedType(CallableType(purity, _, _)):
			if permits_purity(purity, written.purity):
				Ok(void)
			else:
				Err(call_error(written.span, ImpureLambda))
		_: Err(checker_invariant(written.span, InvalidInferenceWorklist))
	shape_result: Result[LambdaAdmission, CheckError] = match head:
		InferredCallable(purity, parameters, result): Ok({ id = id, written = written, parameters = parameters, result = result, scope = scope, context = context })
		AcceptedType(CallableType(purity, parameters, result)):
			Ok({ id = id, written = written, parameters = parameters.map(pure func(value): AcceptedType(value)), result = AcceptedType(result), scope = scope, context = context })
		_: Err(checker_invariant(written.span, InvalidInferenceWorklist))
	shape ?= shape_result
	_: Void ?= if shape.parameters.length() == written.parameters.length():
		Ok(void)
	else:
		Err(call_error(written.span, LambdaArityMismatch(shape.parameters.length(), written.parameters.length())))
	var constraints: List[InferenceEquality] = []
	var position = 0
	var failure: Option[CheckError] = None
	for parameter in written.parameters:
		match parameter.annotation:
			None: void
			Some(annotation):
				match resolve_type(context.body_types, annotation):
					Err(error): failure = Some(error)
					Ok(value_type):
						match shape.parameters.get(position):
							None: failure = Some(checker_invariant(written.span, InvalidInferenceWorklist))
							Some(parameter_expected):
								constraints = constraints.append({
									expected = parameter_expected, actual = AcceptedType(value_type),
									origin = LambdaConstraint(type_span(annotation)), relation = RequireEquality, parameter = None
								})
		if failure.is_some():
			break
		position = position.add(1)
	_: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	result_annotation: Option[TypeRef] ?= match written.return_type:
		None: Ok(None)
		Some(annotation): resolve_type(context.body_types, annotation).map(pure func(value): Some(value))
	match result_annotation:
		None: void
		Some(value_type):
			constraints = constraints.append({ expected = shape.result, actual = AcceptedType(value_type), origin = LambdaConstraint(written.span), relation = RequireEquality, parameter = None })
	body_result: InferenceType = match result_annotation:
		None: shape.result
		Some(value_type): AcceptedType(value_type)
	Ok({ admission = { shape | result = body_result }, value_type = expected, constraints = constraints })


-- Without context, written annotations establish the callable shape once.
private pure func admit_standalone_lambda(
	id: LambdaId, written: ParsedLambda, scope: List[ScopedValue], context: ResolutionContext,
) -> Result[AdmittedLambda, CheckError]:
	var parameters: List[InferenceType] = []
	var failure: Option[CheckError] = None
	for parameter in written.parameters:
		match parameter.annotation:
			None: failure = Some(call_error(written.span, LambdaInputNeedsType))
			Some(annotation):
				match resolve_type(context.body_types, annotation):
					Err(error): failure = Some(error)
					Ok(value): parameters = parameters.append(AcceptedType(value))
		if failure.is_some():
			break
	_: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	result: TypeRef ?= match written.return_type:
		Some(annotation): resolve_type(context.body_types, annotation)
		None:
			missing: Result[TypeRef, CheckError] = match written.body:
				InlineBody(_): Err(call_error(written.span, LambdaResultNeedsType))
				BlockBody(_): Err(call_error(written.span, LambdaBlockNeedsResult))
			missing
	Ok({ admission = { id = id, written = written, parameters = parameters,
		result = AcceptedType(result), scope = scope, context = context },
		value_type = InferredCallable(written.purity, parameters, AcceptedType(result)), constraints = [] })


private pure func lambda_ready(admission: LambdaAdmission, slots: List[InferenceSlot]) -> Result[Bool, CheckError]:
	needed = match admission.written.body:
		InlineBody(_): admission.parameters
		BlockBody(_): admission.parameters.append(admission.result)
	inference_complete(InferredCallable(admission.written.purity, needed, AcceptedType(VoidType)), slots, admission.written.span)


-- Parameters keep dense runtime positions, including discarded arguments.
private pure func lambda_scope(admission: LambdaAdmission, slots: List[InferenceSlot]) -> Result[LambdaScope, CheckError]:
	var scope = admission.scope
	var definitions: List[BindingDefinition] = []
	var failure: Option[CheckError] = None
	for parameter in admission.written.parameters:
		position = definitions.length()
		span = match parameter.binder:
			NamedBinder(name): name.span
			DiscardBinder(span): span
		parameter_type = match admission.parameters.get(position):
			Some(expected): publish_inference_type(expected, slots, CompleteInference, span)
			None: Err(checker_invariant(span, InvalidInferenceWorklist))
		match parameter_type:
			Err(error): failure = Some(error)
			Ok(value_type):
				definition: BindingDefinition = { origin = ParameterBinding(position), mutable = False, value_type = value_type, span = span }
				definitions = definitions.append(definition)
				match parameter.binder:
					DiscardBinder(_): void
					NamedBinder(name):
						match bind_local(scope, admission.context.namespace, admission.context.module, Checked.LambdaBody(admission.id), name, binding_id(position), definition):
							Ok(binding): scope = scope.append(binding)
							Err(error): failure = Some(error)
		if failure.is_some():
			break
	match failure:
		Some(error): Err(error)
		None: Ok({ scope = scope, bindings = definitions })


private pure func checked_lambda(
	admission: LambdaAdmission, bindings: List[BindingDefinition], statements: List[Checked.CheckedStatement],
	body: Checked.CheckedBody, slots: List[InferenceSlot], lambdas: List[LambdaRow],
) -> Result[CheckedLambda, CheckError]:
	var parameters: List[TypeUse] = []
	var failure: Option[CheckError] = None
	for position in 0..admission.parameters.length():
		match bindings.get(position):
			None: failure = Some(checker_invariant(admission.written.span, InvalidInferenceWorklist))
			Some(definition):
				parameters = parameters.append({ value_type = definition.value_type, span = definition.span })
		if failure.is_some():
			break
	_: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	result ?= publish_inference_type(admission.result, slots, CompleteInference, admission.written.span)
	captures ?= lambda_captures(lambdas, admission.id, admission.written.span)
	Ok({ purity = admission.written.purity, root = admission.context.root_function, parameters = parameters,
		return_type = { value_type = result, span = admission.written.span },
		bindings = bindings, captures = captures, statements = statements, body = body })


-- Inline bodies share their caller's inference slots until the whole expression settles.
private pure func freeze_lambdas(
	pending: List[LambdaWork], slots: List[InferenceSlot], rows: List[LambdaRow], constructions: List[ContextWork], assumptions: List[Checked.TraitRequirement], traits: TraitAvailability,
) -> Result[List[LambdaRow], CheckError]:
	var complete = rows
	var failure: Option[CheckError] = None
	for item in pending:
		match item:
			CompletedLambda: void
			AwaitingLambda(admission):
				failure = Some(call_error(admission.written.span, LambdaInputNeedsType))
			InferredLambda(admission, bindings, value):
				match freeze_pending_value(value, slots, BodyCaptures(Checked.LambdaBody(admission.id), complete), constructions, assumptions, traits):
					Err(error): failure = Some(error)
					Ok(frozen):
						match checked_lambda(admission, bindings, [], CheckedValueBody(ReturnExpression(frozen)), slots, complete):
							Err(error): failure = Some(error)
							Ok(row):
								var published = row
								if same_type(row.return_type.value_type, VoidType):
									match frozen.form:
										LiteralVoid: void
										_:
											published = { row | statements = [DiscardExpression(frozen)],
												body = CheckedValueBody(ReturnExpression({ form = LiteralVoid, value_type = VoidType, span = frozen.span })) }
								complete = complete.set(lambda_number(admission.id), CheckedLambdaRow(published))
		if failure.is_some():
			break
	match failure:
		Some(error): Err(error)
		None: Ok(complete)


-- Diagnose structural written order after solver progress stops. Parent owners
-- are already retained by admission; global LambdaIds keep their issuance order.
private pure func reject_unready_lambdas(
	pending: List[LambdaWork], slots: List[InferenceSlot], parent: BodyOwner,
) -> Result[Void, CheckError]:
	var failure: Option[CheckError] = None
	for item in pending:
		match item:
			AwaitingLambda(admission):
				if same_body(admission.context.caller.body, parent):
					match inference_complete(InferredCallable(admission.written.purity, admission.parameters, AcceptedType(VoidType)), slots, admission.written.span):
						Err(error): failure = Some(error)
						Ok(inputs):
							reason: CallError = if inputs:
								LambdaBlockNeedsResult
							else:
								LambdaInputNeedsType
							failure = Some(call_error(admission.written.span, reason))
			InferredLambda(admission, _, _):
				if same_body(admission.context.caller.body, parent):
					match reject_unready_lambdas(pending, slots, Checked.LambdaBody(admission.id)):
						Err(error): failure = Some(error)
						Ok(_): void
			CompletedLambda: void
		if failure.is_some():
			break
	match failure:
		Some(error): Err(error)
		None: Ok(void)
