		CheckErrorKind(ConstructorRejection, RecordRejection),
		CallError(CallableReceiverSyntax, CallableCandidateHasCallableParameters, ImpureCallback, CallableValueRequired, CallableValueEscapes, UnknownFunction, UncallableBinding),
		ConstantError(ConstantCalled), constant_error,
		ConstructorError(ConstructorNeedsExpectedType),
		RecordError(RecordNeedsExpectedType, FieldRequiresRecord),
		ValueError(UnknownValue, ExpressionTypeMismatch, UnknownOpaqueType, NonOpaqueConversionType, ForeignOpaqueConstruction, ForeignOpaqueProjection),
		MethodError(MethodReceiverNeedsType),
		CheckerInvariant(InvalidOpaqueDeclaration, InvalidRecordDeclaration, InvalidRecordField, GenericConstructorContract, InvalidInferenceWorklist, MissingCallParameter),
