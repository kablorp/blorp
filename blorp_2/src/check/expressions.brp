	result: Result methods
	bool: not, and
	./traits: TraitAvailability, accepted_traits, prove_requirements
	./scope: CallableBinding, callable_local, callable_parameter_contract, ScopedValue(DataLocal, CallableLocal), LocalBinding, binding_site, binding_definition, local_binding_id, lookup_binding, bind_local
