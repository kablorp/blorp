---
Elaborates one value expression: plans its calls and constructors, drives the work
loop that solves their constraints, and freezes the result into a CheckedExpr. Only
complete checked facts leave this module; temporary inference variables never become
published TypeRefs.
---
import:
	./scope: ScopedValue(DataLocal, CallableLocal), LocalBinding, callable_binding_id, callable_binding_name, callable_parameters, callable_return_type, binding_site, binding_definition, local_binding_id, lookup_binding
	./constants: constant_row
	./callables:
		FunctionContract, callable_contract,
		function_contract,
		ResolutionContext,
		ResolvedReceiver(ReceiverCandidates, UniqueReceiver),
		ReceiverCandidate,
		classify_receiver,
		method_sites,
	./model:
		CheckedForm(UpdateRecord, ConstructRecord, ConstructVariant, ConstructList, ConstructOpaque, ProjectOpaque, LiteralVoid, LiteralInteger, LiteralFloat, LiteralString, ReadBinding, InvokeFunction, ReadRecordField),
