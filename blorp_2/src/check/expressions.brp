private fixed union ResolvedPostfix:
	InvokeReceiver(ReceiverApplication, ResolvedReceiver)
	ReadField(WrittenName)


private fixed union ResolvedApplication:
	FunctionApplication(FunctionContract)
	ConstructorApplication(WrittenName)


private pure func freeze_record_fields(fields: List[PendingRecordField], slots: List[InferenceSlot]) -> Result[List[CheckedRecordField], CheckError]:
	var frozen: List[CheckedRecordField] = []
	var failure: Option[CheckError] = None

	-- All child errors precede ordinary field mismatches, including later children.
	for field in fields:
		match freeze_pending_value(field.value, slots):
			Ok(value): frozen = frozen.append({ field = field.field, value = value, span = field.value.span })
			Err(error):
				failure = Some(error)
				break
	ready ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	valid ?= validate_record_fields(fields, slots)
	Ok(frozen)


private fixed record ResolvedArguments {
	values: List[CheckedExpr],
	call: CheckedCall
}


private fixed record PostfixHints {
	base: Option[InferenceType],
	results: List[Option[InferenceType]]
}


private pure func postfix_hints(postfixes: List[PendingPostfix], result_hint: Option[InferenceType], context: ResolutionContext, slots: List[InferenceSlot]) -> Result[PostfixHints, CheckError]:
	var results: List[Option[InferenceType]] = []

	for postfix in postfixes:
		results = results.append(None)

	var hint = result_hint
	var position = postfixes.length()
	var failure: Option[CheckError] = None

	while IntOps.greater_than(position, 0):
		position = IntOps.subtract(position, 1)
		results = results.set(position, hint)

		match postfixes.get(position):
			Some(PendingReceiverInvocation(_, call)):
				match call_argument_hints(call, hint, slots):
					Ok(arguments): hint = arguments.get(0).get_or(None)
					Err(error):
						failure = Some(error)
						break
			Some(PendingOverloadInvocation(_, _)):
				-- A common concrete receiver hint would prove a declaration clash.
				hint = None
			Some(PendingField(_)): hint = None
			None:
				failure = Some(checker_invariant({ source = compiler_source(), start = 0, end = 0 }, InvalidInferenceWorklist))
				break

	match failure:
		Some(error): Err(error)
		None: Ok({ base = hint, results = results })


private fixed union PendingPostfix:
	PendingField(WrittenName)
	PendingReceiverInvocation(ReceiverApplication, PendingCall)
	PendingOverloadInvocation(ReceiverApplication, List[ReceiverCandidate])


private fixed record ExpressionPlan {
	base: PlannedBase,
	postfixes: List[PendingPostfix],
	hints: List[Option[InferenceType]]
}


private fixed record OperandRange {
	start: Int,
	count: Int
}


private fixed union ExpressionWork:
	EnterExpression(ValueExpression, Option[InferenceType])
	EnterCallable(ValueExpression)
	FinishConstructOpaque(OpaqueId, TypeRef, Span)
	FinishProjectOpaque(OpaqueId, TypeRef, Span)
	ContinuePostfix(List[PendingPostfix], List[Option[InferenceType]], Int, Span, Span)
	ScheduleCall(FunctionContract, List[ValueExpression], CallPlacement, Option[InferenceType])
	StartCall(PendingCall, List[ValueExpression], CallPlacement, Option[InferenceType])
	FinishVariant(PendingVariantContract, OperandRange, Span)
	CheckVariant(PendingVariantContract, List[PendingValue], Span)
	FinishCall(PendingCall, OperandRange, CallPlacement)
	CheckCall(PendingCall, List[PendingValue], CallPlacement)
	PlanRecordUpdate(List[ParsedRecordField], Span, Span)
	ScheduleRecord(PlannedRecordFields)
	FinishRecord(PlannedRecordFields, OperandRange)
	CheckRecord(PlannedRecordFields, List[PendingRecordField])
	ContinueList(ListProgress)
	FinishList(ListElementSource, OperandRange, Span, Span)
	CheckList(ListElementSource, List[PendingValue], Span, Span)
	SolveConstraint(InferenceEquality)
	FinishRoot
	FreezeRoot(PendingValue)


-- A list literal's elements entered so far: `position` is the next element to
-- enter and `start` the operand index of the first, which decides E when no
-- context supplies one.
private fixed record ListProgress {
	source: ListElementSource,
	elements: List[ValueExpression],
	position: Int,
	start: Int,
	base_span: Span,
	span: Span
}


private fixed union ResultInferenceState:
	NoResultInference
	SolvingResultInference
	IncompatibleResultInference


private pure func push_expression_work(work: List[Option[ExpressionWork]], depth: Int, action: ExpressionWork) -> List[Option[ExpressionWork]]:
	if IntOps.less_than(depth, work.length()):
		work.set(depth, Some(action))
	else:
		work.append(Some(action))


private pure func push_operand(values: List[Option[PendingValue]], depth: Int, value: PendingValue) -> List[Option[PendingValue]]:
	if IntOps.less_than(depth, values.length()):
		values.set(depth, Some(value))
	else:
		values.append(Some(value))


private pure func expression_operand(values: List[Option[PendingValue]], position: Int, span: Span) -> Result[PendingValue, CheckError]:
	match values.get(position):
		Some(Some(value)): Ok(value)
		_: Err(checker_invariant(span, InvalidInferenceWorklist))


private pure func call_operands(values: List[Option[PendingValue]], range: OperandRange, span: Span) -> Result[List[PendingValue], CheckError]:
	var arguments: List[PendingValue] = []
	var failure: Option[CheckError] = None

	for position in range.start..IntOps.add(range.start, range.count):
		match expression_operand(values, position, span):
			Err(error):
				failure = Some(error)
				break
			Ok(value):
				arguments = arguments.append(value)

	match failure:
		Some(error): Err(error)
		None: Ok(arguments)


private pure func record_operands(values: List[Option[PendingValue]], range: OperandRange, literal: PlannedRecordFields) -> Result[List[PendingRecordField], CheckError]:
	var fields: List[PendingRecordField] = []
	var position = range.start
	var failure: Option[CheckError] = None
	for planned in literal.fields:
		match expression_operand(values, position, literal.span):
			Ok(value): fields = fields.append({ field = planned.field, expected = planned.expected, value = value })
			Err(error):
				failure = Some(error)
				break
		position = IntOps.add(position, 1)
	match failure:
		Some(error): Err(error)
		None: Ok(fields)


private pure func argument_work(call: PendingCall, arguments: List[ValueExpression], placement: CallPlacement, hints: List[Option[InferenceType]], position: Int) -> Result[ExpressionWork, CheckError]:
	argument ?= arguments.get(position).to_result(checker_invariant(call.contract.span, MissingCallParameter(position)))
	argument_position = match placement:
		ReceiverPlacement(_, _): IntOps.add(position, 1)
		_: position
	hint ?= hints.get(argument_position).to_result(checker_invariant(call.contract.span, MissingCallParameter(argument_position)))
	written ?= call.contract.signature.parameters.get(argument_position).to_result(checker_invariant(call.contract.span, MissingCallParameter(argument_position)))
	match written.value_type:
		PureCallableType(_, _): Ok(EnterCallable(argument))
		_: Ok(EnterExpression(argument, hint))


private pure func conversion_declaration(name: WrittenName, context: ResolutionContext) -> Result[OpaqueRow, CheckError]:
	match named_type(context.namespace, context.module, name.id):
		None: Err(value_error(name.span, UnknownOpaqueType(name.id)))
		Some(named):
			match named.head:
				OpaqueHead(id): context.opaque_declarations.get(opaque_number(id)).to_result(checker_invariant(name.span, InvalidOpaqueDeclaration(id)))
				_: Err(value_error(name.span, NonOpaqueConversionType(name.id)))


private pure func constant_base(value: ClosedConstant) -> PendingBase:
	match value:
		IntegerConstant(integer): AcceptedInteger(integer)
		FloatConstant(number): AcceptedFloat(number)
		StringConstant(text): AcceptedString(text)


private pure func plan_base(scope: List[ScopedValue], body: ValueExpression, expectation: Option[InferenceType], context: ResolutionContext, slots: List[InferenceSlot]) -> Result[PlannedBase, CheckError]:
	match body.base:
		RecordExpression(fields): plan_record_literal(fields, body.base_span, expectation, context)
		RecordUpdateExpression(base, fields): Ok(PlannedUpdate(base, fields, expectation))
		DirectApplication(name, arguments):
			match classify_direct_call(name, arguments, scope, context):
				Ok(classified):
					match classified:
						FunctionApplication(contract): Ok(PlannedCall(contract, arguments, ReturnPlacement(body.base_span, body.span), expectation))
						ConstructorApplication(constructor_name): plan_variant(constructor_name, arguments, True, expectation, slots, context)
				Err(error): Err(error)
		NameExpression(name):
			match lookup_binding(scope, name.id):
				Some(DataLocal(binding)): Ok(PlannedLeaf(AcceptedBinding(local_binding_id(binding)), binding_definition(binding).value_type))
				Some(CallableLocal(binding)): Err(call_error(name.span, CallableValueEscapes(ParameterTarget(callable_binding_id(binding)))))
				None:
					match named_value(context.namespace, context.module, name.id):
						Some(NamedFunction(id, _)): Err(call_error(name.span, CallableValueEscapes(DeclaredTarget(id))))
						Some(NamedConstant(id)):
							constant_row(context.constants, id, name.span)
								.map(pure func(row): PlannedLeaf(constant_base(row.value), row.value_type.value_type))
						Some(NamedConstructor(_)): plan_variant(name, [], False, expectation, slots, context)
						Some(NamedAlias(_)): Err(qualified_error(name.span, BareModuleAlias(name.id)))
						_: Err(value_error(name.span, UnknownValue(name.id)))
		QualifiedName(qualified): plan_qualified(qualified, [], False, expectation, slots, context, body)
		QualifiedApplication(qualified, arguments): plan_qualified(qualified, arguments, True, expectation, slots, context, body)
		OpaqueWrap(name, operand):
			match conversion_declaration(name, context):
				Err(error): Err(error)
				Ok(declaration):
					if not same_module(declaration.declaration.module, context.module):
						Err(value_error(name.span, ForeignOpaqueConstruction(declaration.id)))
					else:
						match context.opaques.get(opaque_number(declaration.id)):
							None: Err(checker_invariant(name.span, InvalidOpaqueDeclaration(declaration.id)))
							Some(accepted): Ok(PlannedConstructOpaque(declaration.id, accepted.underlying_type.value_type, operand))
		OpaqueUnwrap(name, operand):
			match conversion_declaration(name, context):
				Err(error): Err(error)
				Ok(declaration):
					if not same_module(declaration.declaration.module, context.module):
						Err(value_error(name.span, ForeignOpaqueProjection(declaration.id)))
					else:
						match context.opaques.get(opaque_number(declaration.id)):
							None: Err(checker_invariant(name.span, InvalidOpaqueDeclaration(declaration.id)))
							Some(accepted): Ok(PlannedProjectOpaque(declaration.id, accepted.underlying_type.value_type, operand))
		ListExpression(elements): plan_list_literal(elements, expectation, body.base_span)
		RangeExpression(_, _): Err(unsupported_form(body.base_span, RangeValue))
		LogicalExpression(_, _, _): Err(unsupported_form(body.base_span, AndOrOperator))
		NotExpression(_): Err(unsupported_form(body.base_span, NotOperator))
		IfExpression(_): Err(unsupported_form(body.base_span, IfValue))
		-- Bodies resolve a bare match as a join; one reaching the planner is
		-- nested inside a larger expression.
		MatchExpression(_): Err(unsupported_form(body.base_span, MatchInExpression))
		LambdaExpression(_): Err(unsupported_form(body.base_span, LambdaValue))
		VoidExpression: Ok(PlannedLeaf(AcceptedVoid, VoidType))
		StringExpression(value): Ok(PlannedLeaf(AcceptedString(value), StringType))
		IntegerExpression(value): Ok(PlannedLeaf(AcceptedInteger(value), IntType))
		FloatExpression(value): Ok(PlannedLeaf(AcceptedFloat(value), FloatType))


-- `Alias.name` resolves through the alias row to the target's own exported
-- declarations: a constructor builds that union's variant; a function is a
-- direct call to it. Imports of the target are not reexported.
private pure func plan_qualified(
	qualified: ParsedQualified,
	arguments: List[ValueExpression],
	called: Bool,
	expectation: Option[InferenceType],
	slots: List[InferenceSlot],
	context: ResolutionContext,
	body: ValueExpression,
) -> Result[PlannedBase, CheckError]:
	aliased ?= aliased_module(context.namespace, context.module, qualified.module)
	name = qualified.name
	match offered_value(context.namespace, aliased.target, name.id):
		Ok(OfferedConstant(id)):
			if called:
				Err(constant_error(name.span, ConstantCalled(id)))
			else:
				constant_row(context.constants, id, name.span)
					.map(pure func(row): PlannedLeaf(constant_base(row.value), row.value_type.value_type))
		Ok(OfferedConstructor(variant)):
			plan_qualified_variant(variant_owner(variant), variant, name, arguments, called, expectation, context)
		Ok(OfferedFunction(function)):
			if called:
				match function_contract(context.caller, name, arguments, function, context.signatures):
					Ok(contract): Ok(PlannedCall(contract, arguments, ReturnPlacement(body.base_span, body.span), expectation))
					Err(error): Err(error)
			else:
				Err(qualified_error(body.base_span, QualifiedFunctionNotCalled(qualified.module.id, name.id)))
		Err(reason):
			Err(qualified_error(name.span, QualifiedNotOffered(qualified.module.id, name.id, aliased.path, reason)))


private pure func resolve_postfixes(scope: List[ScopedValue], body: ValueExpression, context: ResolutionContext) -> Result[List[ResolvedPostfix], CheckError]:
	receiver_decision: Result[Void, CheckError] = if body.applications.is_empty():
		Ok(void)
	else:
		match body.base:
			NameExpression(name):
				match lookup_binding(scope, name.id):
					Some(CallableLocal(binding)):
						Err(call_error(name.span, CallableReceiverSyntax(ParameterTarget(callable_binding_id(binding)))))
					Some(DataLocal(_)): Ok(void)
					None:
						match named_value(context.namespace, context.module, name.id):
							Some(NamedFunction(id, _)): Err(call_error(name.span, CallableReceiverSyntax(DeclaredTarget(id))))
							_: Ok(void)
			_: Ok(void)
	data_receiver ?= receiver_decision
	var contracts: List[ResolvedPostfix] = []
	var failure: Option[CheckError] = None

	for postfix in body.applications:
		match postfix:
			FieldAccess(name): contracts = contracts.append(ReadField(name))
			ReceiverInvocation(application):
				match lookup_binding(scope, application.callee.id):
					Some(CallableLocal(binding)):
						failure = Some(call_error(application.callee.span, CallableReceiverSyntax(ParameterTarget(callable_binding_id(binding)))))
						break
					_: void
				match classify_receiver(application, context):
					Err(error):
						failure = Some(error)
						break
					Ok(receiver): contracts = contracts.append(InvokeReceiver(application, receiver))

	match failure:
		Some(error): Err(error)
		None: Ok(contracts)


private pure func plan_expression(scope: List[ScopedValue], body: ValueExpression, hint: Option[InferenceType], context: ResolutionContext, slots: List[InferenceSlot], contracts: List[PendingPostfix]) -> Result[ExpressionPlan, CheckError]:
	projected ?= postfix_hints(contracts, hint, context, slots)
	base_expectation = projected.base
	base_result = plan_base(scope, body, base_expectation, context, slots)
	contextual_base: Result[PlannedBase, CheckError] = match base_result:
		Ok(base): Ok(base)
		Err(error):
			context_error = match error.kind:
				ConstructorRejection(ConstructorNeedsExpectedType(_)):
					match body.base:
						NameExpression(name): same_span(error.span, name.span)
						DirectApplication(name, _): same_span(error.span, name.span)
						_: same_span(error.span, body.base_span)
				RecordRejection(RecordNeedsExpectedType): same_span(error.span, body.base_span)
				_: False

			if context_error:
				match contracts.get(0):
					Some(PendingOverloadInvocation(application, candidates)):
						sites = method_sites(candidates)
						Err(method_error(application.callee.span, MethodReceiverNeedsType(application.callee.id, sites)))
					_: Err(error)
			else:
				Err(error)
	base ?= contextual_base
	Ok({ base = base, postfixes = contracts, hints = projected.results })


private pure func pending_receiver_contract(current: PendingValue, application: ReceiverApplication, receiver: ResolvedReceiver, context: ResolutionContext, slots: List[InferenceSlot]) -> Result[FunctionContract, CheckError]:
	match receiver:
		UniqueReceiver(contract): Ok(contract)
		ReceiverCandidates(_):
			match publish_inference_type(pending_type(current), slots, CompleteInference, application.callee.span):
				Ok(actual): select_receiver_contract(application, receiver, { value_type = actual, span = current.base_span }, context)
				Err(error): Err(error)


private pure func pending_field(name: WrittenName, current: PendingValue, slots: List[InferenceSlot], context: ResolutionContext) -> Result[PendingValue, CheckError]:
	head ?= inference_head(pending_type(current), slots, name.span)
	occurrence_result: Result[RecordOccurrence, CheckError] = match record_occurrence(head):
		Some(value): Ok(value)
		None:
			match publish_inference_type(head, slots, DiagnosticInference, name.span):
				Ok(actual): Err(record_error(name.span, FieldRequiresRecord(actual)))
				Err(error): Err(error)
	occurrence ?= occurrence_result
	field ?= resolve_record_field(name, occurrence.owner, context)
	accepted ?= context.records.get(record_number(occurrence.owner)).to_result(checker_invariant(name.span, InvalidRecordDeclaration(occurrence.owner)))
	annotation = field.value_type
	value_type ?= apply_type_hint(annotation.value_type, accepted.type_parameters, record_argument_hints(occurrence.arguments)).to_result(checker_invariant(name.span, InvalidRecordField(field.id)))
	Ok({ current | operations = PendingOperationLink({ operation = AcceptedField(field.id), value_type = value_type, span = name.span }, current.operations) })


private pure func placed_arguments(arguments: List[PendingValue], placement: CallPlacement, span: Span) -> List[InferenceUse]:
	values = pending_arguments(arguments)

	match placement:
		ReceiverPlacement(receiver, _):
			actual: InferenceUse = { value_type = pending_type(receiver), span = span }
			[actual].concat(values)
		_: values


private pure func placed_readiness(arguments: List[PendingValue], placement: CallPlacement) -> InferenceReadiness:
	var readiness = match placement:
		ReceiverPlacement(receiver, _): receiver.readiness
		_: ClosedInference

	for argument in arguments:
		match argument.readiness:
			DeferredInference:
				readiness = DeferredInference
				break
			ClosedInference: void

	readiness


private pure func finish_pending_call(call: PendingCall, arguments: List[PendingValue], placement: CallPlacement, slots: List[InferenceSlot]) -> Result[PendingValue, CheckError]:
	children = placed_readiness(arguments, placement)
	closed_result: Result[Option[TypeRef], CheckError] = match children:
		DeferredInference: Ok(None)
		ClosedInference:
			match call_inference_ready(call, slots):
				Ok(complete):

					if complete:
						match admit_call_parameters(call, slots):
							Ok(parameters):
								match admit_call_type(call.contract.signature.return_type.value_type, call, slots, call.contract.span):
									Ok(return_type): validate_complete_arguments(call.contract, parameters, return_type, placed_arguments(arguments, placement, call.contract.span), slots).map(pure func(value): Some(value))
									Err(error): Err(error)
							Err(error): Err(error)
					else:
						Ok(None)
				Err(error): Err(error)
	accepted ?= closed_result
	readiness = match accepted:
		Some(_): ClosedInference
		None: DeferredInference

	-- Reuse the result already published for Closed-call validation. Deferred
	-- descendants keep their original terms and child-first diagnostic ordering.
	value_type = match accepted:
		Some(value): AcceptedType(value)
		None: inference_type(call.contract.signature.return_type.value_type, call.contract.signature.type_parameters, call.variable_start)

	match placement:
		ReturnPlacement(base_span, span):
			Ok({ span = span, readiness = readiness, base = PendingDirectCall(call, arguments), base_type = value_type, base_span = base_span, operations = NoPendingOperations })
		ReceiverPlacement(receiver, span):
			Ok({ receiver | readiness = readiness, operations = PendingOperationLink({ operation = PendingInvocation(call, arguments), value_type = value_type, span = span }, receiver.operations) })


private pure func elaborate_value(
	scope: List[ScopedValue],
	body: ValueExpression,
	constructor_type: Option[TypeRef],
	result_context: Option[CallResultContext],
	context: ResolutionContext,
) -> Result[CheckedExpr, CheckError]:
	var slots: List[InferenceSlot] = []
	var work: List[Option[ExpressionWork]] = [Some(FinishRoot), Some(EnterExpression(body, constructor_type.map(pure func(value): inference_type(value, [], 0))))]
	var work_count = 2
	var operands: List[Option[PendingValue]] = []
	var operand_count = 0
	var result_state = NoResultInference
	var accepted: Option[CheckedExpr] = None
	var failure: Option[CheckError] = None

	while IntOps.greater_than(work_count, 0) and failure.is_none():
		work_count = IntOps.subtract(work_count, 1)
		next = work.get(work_count)
		work = work.set(work_count, None)

		match next:
			Some(Some(action)):
				match action:
					EnterCallable(written):
						match resolve_callable_operand(written, scope, context, slots.length()):
							Err(error): failure = Some(error)
							Ok(value):
								match value.base:
									PendingNamedCallable(_, signature, _):
										for parameter in signature.type_parameters:
											slots = slots.append({ parameter = parameter, call_span = written.span, first_argument = None, state = UnboundVariable(0) })
									_: void
								operands = push_operand(operands, operand_count, value)
								operand_count = IntOps.add(operand_count, 1)
					EnterExpression(written, hint):
						match resolve_postfixes(scope, written, context):
							Err(error): failure = Some(error)
							Ok(resolved):
								var postfixes: List[PendingPostfix] = []

								for postfix in resolved:
									match postfix:
										ReadField(name): postfixes = postfixes.append(PendingField(name))
										InvokeReceiver(application, receiver):
											match receiver:
												ReceiverCandidates(candidates): postfixes = postfixes.append(PendingOverloadInvocation(application, candidates))
												UniqueReceiver(contract):
													call: PendingCall = { contract = contract, variable_start = slots.length() }

													for parameter in contract.signature.type_parameters:
														slots = slots.append({ parameter = parameter, call_span = contract.span, first_argument = None, state = UnboundVariable(0) })

													postfixes = postfixes.append(PendingReceiverInvocation(application, call))

								match plan_expression(scope, written, hint, context, slots, postfixes):
									Err(error): failure = Some(error)
									Ok(plan):
										work = push_expression_work(work, work_count, ContinuePostfix(plan.postfixes, plan.hints, 0, written.base_span, written.span))
										work_count = IntOps.add(work_count, 1)

										match plan.base:
											PlannedLeaf(base, value_type):
												value: PendingValue = { span = written.span, readiness = ClosedInference, base = base, base_type = inference_type(value_type, [], 0), base_span = written.base_span, operations = NoPendingOperations }
												operands = push_operand(operands, operand_count, value)
												operand_count = IntOps.add(operand_count, 1)
											PlannedConstructOpaque(id, underlying, operand):
												work = push_expression_work(work, work_count, FinishConstructOpaque(id, underlying, written.base_span))
												work_count = IntOps.add(work_count, 1)
												work = push_expression_work(work, work_count, EnterExpression(operand, Some(AcceptedType(underlying))))
												work_count = IntOps.add(work_count, 1)
											PlannedProjectOpaque(id, underlying, operand):
												work = push_expression_work(work, work_count, FinishProjectOpaque(id, underlying, written.base_span))
												work_count = IntOps.add(work_count, 1)
												work = push_expression_work(work, work_count, EnterExpression(operand, Some(AcceptedType(OpaqueType(id)))))
												work_count = IntOps.add(work_count, 1)
											PlannedRecord(literal):
												work = push_expression_work(work, work_count, ScheduleRecord(literal))
												work_count = IntOps.add(work_count, 1)
											PlannedUpdate(base, fields, update_hint):
												work = push_expression_work(work, work_count, PlanRecordUpdate(fields, written.base_span, base.span))
												work_count = IntOps.add(work_count, 1)
												work = push_expression_work(work, work_count, EnterExpression(base, update_hint))
												work_count = IntOps.add(work_count, 1)
											PlannedVariant(contract, arguments):
												range: OperandRange = { start = operand_count, count = arguments.length() }
												work = push_expression_work(work, work_count, FinishVariant(contract, range, written.span))
												work_count = IntOps.add(work_count, 1)
												var position = arguments.length()
												while IntOps.greater_than(position, 0):
													position = IntOps.subtract(position, 1)
													match arguments.get(position):
														None: failure = Some(checker_invariant(contract.span, GenericConstructorContract))
														Some(argument):
															match contract.fields.get(position):
																None: failure = Some(checker_invariant(contract.span, GenericConstructorContract))
																Some(field):
																	work = push_expression_work(work, work_count, EnterExpression(argument, Some(field.value_type)))
																	work_count = IntOps.add(work_count, 1)
											PlannedCall(contract, arguments, placement, call_hint):
												work = push_expression_work(work, work_count, ScheduleCall(contract, arguments, placement, call_hint))
												work_count = IntOps.add(work_count, 1)
											PlannedList(elements, source):
												work = push_expression_work(work, work_count, ContinueList({ source = source, elements = elements, position = 0, start = operand_count, base_span = written.base_span, span = written.span }))
												work_count = IntOps.add(work_count, 1)
					FinishConstructOpaque(id, underlying, span):
						position = IntOps.subtract(operand_count, 1)
						match expression_operand(operands, position, span):
							Err(error): failure = Some(error)
							Ok(operand):
								value: PendingValue = {
									span = span,
									readiness = DeferredInference,
									base = PendingConstructOpaque(id, underlying, operand),
									base_type = AcceptedType(OpaqueType(id)),
									base_span = span,
									operations = NoPendingOperations,
								}
								operands = operands.set(position, Some(value))
								match operand.readiness:
									ClosedInference: void
									DeferredInference:
										expected: ExpectedValue = { value_type = underlying, site = OpaqueConstruction(id) }
										equality: InferenceEquality = {
											expected = pending_type(operand),
											actual = AcceptedType(expected.value_type),
											origin = OpaqueOperandConstraint(expected, operand.span),
											relation = RequireEquality,
											parameter = None
										}
										work = push_expression_work(work, work_count, SolveConstraint(equality))
										work_count = IntOps.add(work_count, 1)
					FinishProjectOpaque(id, underlying, span):
						position = IntOps.subtract(operand_count, 1)
						match expression_operand(operands, position, span):
							Err(error): failure = Some(error)
							Ok(operand):
								value: PendingValue = {
									span = span,
									readiness = DeferredInference,
									base = PendingProjectOpaque(id, operand),
									base_type = AcceptedType(underlying),
									base_span = span,
									operations = NoPendingOperations,
								}
								operands = operands.set(position, Some(value))
								match operand.readiness:
									ClosedInference: void
									DeferredInference:
										expected: ExpectedValue = { value_type = OpaqueType(id), site = OpaqueProjection(id) }
										equality: InferenceEquality = {
											expected = pending_type(operand),
											actual = AcceptedType(expected.value_type),
											origin = OpaqueOperandConstraint(expected, operand.span),
											relation = RequireEquality,
											parameter = None
										}
										work = push_expression_work(work, work_count, SolveConstraint(equality))
										work_count = IntOps.add(work_count, 1)
					PlanRecordUpdate(fields, span, expression_span):
						position = IntOps.subtract(operand_count, 1)
						match expression_operand(operands, position, expression_span):
							Err(error): failure = Some(error)
							Ok(base):
								match plan_record_update(base, fields, span, expression_span, context, slots):
									Err(error): failure = Some(error)
									Ok(plan):
										operands = operands.set(position, None)
										operand_count = position
										work = push_expression_work(work, work_count, ScheduleRecord(plan))
										work_count = IntOps.add(work_count, 1)
					ScheduleRecord(literal):
						work = push_expression_work(work, work_count, FinishRecord(literal, { start = operand_count, count = literal.fields.length() }))
						work_count = IntOps.add(work_count, 1)
						var position = literal.fields.length()
						while IntOps.greater_than(position, 0):
							position = IntOps.subtract(position, 1)
							match literal.fields.get(position):
								Some(field):
									work = push_expression_work(work, work_count, EnterExpression(field.written, Some(field.expected.value_type)))
									work_count = IntOps.add(work_count, 1)
								None: failure = Some(checker_invariant(literal.span, InvalidInferenceWorklist))
					FinishRecord(literal, range):
						match record_operands(operands, range, literal):
							Err(error): failure = Some(error)
							Ok(fields):
								for operand_position in range.start..operand_count:
									operands = operands.set(operand_position, None)
								operand_count = range.start
								work = push_expression_work(work, work_count, CheckRecord(literal, fields))
								work_count = IntOps.add(work_count, 1)
								var position = fields.length()
								while IntOps.greater_than(position, 0):
									position = IntOps.subtract(position, 1)
									match fields.get(position):
										Some(field):
											-- Accepted subtrees contain no local variables. Ordinary mismatches
											-- remain the field validator's responsibility after all children.
											settled = match field.expected.value_type:
												AcceptedType(_):
													match pending_type(field.value):
														AcceptedType(_): True
														_: False
												_: False
											if not settled:
												equality: InferenceEquality = { expected = field.expected.value_type, actual = pending_type(field.value), origin = RecordFieldConstraint(field.field, field.expected, field.value.span), relation = CollectArguments, parameter = None }
												work = push_expression_work(work, work_count, SolveConstraint(equality))
												work_count = IntOps.add(work_count, 1)
										None: failure = Some(checker_invariant(literal.span, InvalidInferenceWorklist))
					CheckRecord(literal, fields):
						match finish_pending_record(literal, fields, slots):
							Err(error): failure = Some(error)
							Ok(value):
								operands = push_operand(operands, operand_count, value)
								operand_count = IntOps.add(operand_count, 1)
					FinishVariant(contract, range, span):
						match call_operands(operands, range, span):
							Err(error): failure = Some(error)
							Ok(values):
								for position in range.start..operand_count:
									operands = operands.set(position, None)
								operand_count = range.start
								work = push_expression_work(work, work_count, CheckVariant(contract, values, span))
								work_count = IntOps.add(work_count, 1)
								var position = values.length()
								while IntOps.greater_than(position, 0):
									position = IntOps.subtract(position, 1)
									match contract.fields.get(position):
										None: failure = Some(checker_invariant(span, GenericConstructorContract))
										Some(expected):
											match values.get(position):
												None: failure = Some(checker_invariant(span, GenericConstructorContract))
												Some(actual):
													settled = match expected.value_type:
														AcceptedType(_):
															match pending_type(actual):
																AcceptedType(_): True
																_: False
														_: False
													if not settled:
														equality: InferenceEquality = { expected = expected.value_type, actual = pending_type(actual), origin = VariantConstraint(contract, position), relation = CollectArguments, parameter = None }
														work = push_expression_work(work, work_count, SolveConstraint(equality))
														work_count = IntOps.add(work_count, 1)
					CheckVariant(contract, values, span):
						match finish_pending_variant(contract, values, span, slots):
							Err(error): failure = Some(error)
							Ok(value):
								operands = push_operand(operands, operand_count, value)
								operand_count = IntOps.add(operand_count, 1)
					-- Elements enter one at a time so that, once E is known, every later
					-- element is checked under E as its expected type: a nested `[]`
					-- after a sibling receives its element type from E = List[T].
					ContinueList(progress):
						if IntOps.equals(progress.position, progress.elements.length()):
							work = push_expression_work(work, work_count, FinishList(progress.source, { start = progress.start, count = progress.position }, progress.base_span, progress.span))
							work_count = IntOps.add(work_count, 1)
						else:
							hint_result: Result[Option[InferenceType], CheckError] = match progress.source:
								ExpectedElementType(element): Ok(Some(element))
								FirstElementType:
									if IntOps.equals(progress.position, 0):
										Ok(None)
									else:
										match expression_operand(operands, progress.start, progress.base_span):
											Err(error): Err(error)
											Ok(first): Ok(Some(pending_type(first)))
							match hint_result:
								Err(error): failure = Some(error)
								Ok(hint):
									match progress.elements.get(progress.position):
										None: failure = Some(checker_invariant(progress.base_span, InvalidInferenceWorklist))
										Some(element):
											work = push_expression_work(work, work_count, ContinueList({ progress | position = IntOps.add(progress.position, 1) }))
											work_count = IntOps.add(work_count, 1)
											work = push_expression_work(work, work_count, EnterExpression(element, hint))
											work_count = IntOps.add(work_count, 1)
					FinishList(source, range, base_span, span):
						match call_operands(operands, range, base_span):
							Err(error): failure = Some(error)
							Ok(values):
								for position in range.start..operand_count:
									operands = operands.set(position, None)
								operand_count = range.start
								work = push_expression_work(work, work_count, CheckList(source, values, base_span, span))
								work_count = IntOps.add(work_count, 1)
								match list_element_type(source, values, base_span):
									Err(error): failure = Some(error)
									Ok(element):
										-- The first element is E itself when no context supplies E.
										first = match source:
											ExpectedElementType(_): 0
											FirstElementType: 1
										var position = values.length()
										while IntOps.greater_than(position, first):
											position = IntOps.subtract(position, 1)
											match values.get(position):
												None: failure = Some(checker_invariant(base_span, InvalidInferenceWorklist))
												Some(actual):
													settled = match element:
														AcceptedType(_):
															match pending_type(actual):
																AcceptedType(_): True
																_: False
														_: False
													if not settled:
														equality: InferenceEquality = { expected = element, actual = pending_type(actual), origin = ListElementConstraint(IntOps.add(position, 1), actual.span), relation = CollectArguments, parameter = None }
														work = push_expression_work(work, work_count, SolveConstraint(equality))
														work_count = IntOps.add(work_count, 1)
					CheckList(source, values, base_span, span):
						match finish_pending_list(source, values, span, base_span, slots):
							Err(error): failure = Some(error)
							Ok(value):
								operands = push_operand(operands, operand_count, value)
								operand_count = IntOps.add(operand_count, 1)
					ScheduleCall(contract, arguments, placement, hint):
						call: PendingCall = { contract = contract, variable_start = slots.length() }

						for parameter in contract.signature.type_parameters:
							slots = slots.append({ parameter = parameter, call_span = contract.span, first_argument = None, state = UnboundVariable(0) })

						work = push_expression_work(work, work_count, StartCall(call, arguments, placement, hint))
						work_count = IntOps.add(work_count, 1)
					StartCall(call, arguments, placement, hint):
						match call_argument_hints(call, hint, slots):
							Err(error): failure = Some(error)
							Ok(hints):
								work = push_expression_work(work, work_count, FinishCall(call, { start = operand_count, count = arguments.length() }, placement))
								work_count = IntOps.add(work_count, 1)
								var position = arguments.length()

								while IntOps.greater_than(position, 0):
									position = IntOps.subtract(position, 1)

									match argument_work(call, arguments, placement, hints, position):
										Err(error):
											failure = Some(error)
											break
										Ok(argument):
											work = push_expression_work(work, work_count, argument)
											work_count = IntOps.add(work_count, 1)
					FinishCall(call, range, placement):
						match call_operands(operands, range, call.contract.span):
							Err(error): failure = Some(error)
							Ok(arguments):
								for position in range.start..operand_count:
									operands = operands.set(position, None)

								operand_count = range.start
								work = push_expression_work(work, work_count, CheckCall(call, arguments, placement))
								work_count = IntOps.add(work_count, 1)
								actual = placed_arguments(arguments, placement, call.contract.span)
								var position = actual.length()

								while IntOps.greater_than(position, 0):
									position = IntOps.subtract(position, 1)

									match call_argument_constraint(call, actual, position):
										Err(error):
											failure = Some(error)
											break
										Ok(equality):
											work = push_expression_work(work, work_count, SolveConstraint(equality))
											work_count = IntOps.add(work_count, 1)
					CheckCall(call, arguments, placement):
						match finish_pending_call(call, arguments, placement, slots):
							Err(error): failure = Some(error)
							Ok(value):
								operands = push_operand(operands, operand_count, value)
								operand_count = IntOps.add(operand_count, 1)
					ContinuePostfix(postfixes, hints, position, base_span, span):
						operand_count = IntOps.subtract(operand_count, 1)
						current_result = expression_operand(operands, operand_count, span)
						operands = operands.set(operand_count, None)

						match current_result:
							Err(error): failure = Some(error)
							Ok(current):
								if IntOps.equals(position, postfixes.length()):
									operands = push_operand(operands, operand_count, { current | span = span })
									operand_count = IntOps.add(operand_count, 1)
								else:
									work = push_expression_work(work, work_count, ContinuePostfix(postfixes, hints, IntOps.add(position, 1), base_span, span))
									work_count = IntOps.add(work_count, 1)

									match postfixes.get(position):
										Some(PendingField(name)):
											match pending_field(name, current, slots, context):
												Err(error): failure = Some(error)
												Ok(value):
													operands = push_operand(operands, operand_count, value)
													operand_count = IntOps.add(operand_count, 1)
										Some(PendingReceiverInvocation(application, call)):
											work = push_expression_work(work, work_count, StartCall(call, application.arguments, ReceiverPlacement(current, { source = base_span.source, start = base_span.start, end = application.span.end }), hints.get(position).get_or(None)))
											work_count = IntOps.add(work_count, 1)
										Some(PendingOverloadInvocation(application, candidates)):
											match pending_receiver_contract(current, application, ReceiverCandidates(candidates), context, slots):
												Err(error): failure = Some(error)
												Ok(contract):
													work = push_expression_work(work, work_count, ScheduleCall(contract, application.arguments, ReceiverPlacement(current, { source = base_span.source, start = base_span.start, end = application.span.end }), hints.get(position).get_or(None)))
													work_count = IntOps.add(work_count, 1)
										None: failure = Some(checker_invariant(span, InvalidInferenceWorklist))
					SolveConstraint(equality):
						var inspect = True

						match equality.origin:
							ResultConstraint(_):
								match result_state:
									IncompatibleResultInference: inspect = False
									_: void
							ArgumentConstraint(_, _, _, _): void
							OpaqueOperandConstraint(_, _): void
							VariantConstraint(_, _): void
							RecordFieldConstraint(_, _, _): void
							ListElementConstraint(_, _): void
							ReceiverOverlapConstraint(_): void

						if inspect:
							match record_argument_origin(equality, slots):
								Err(error): failure = Some(error)
								Ok(Some(update)): slots = slots.set(update.position, update.slot)
								Ok(None): void

							if failure.is_none():
								match inspect_inference_equality(equality, slots):
									Err(error): failure = Some(error)
									Ok(step):
										match step:
											IncompatibleResult: result_state = IncompatibleResultInference
											CompleteEquality: void
											UpdateInferenceSlots(updates):
												for update in updates:
													slots = slots.set(update.position, update.slot)
											ExpandInferenceList(child):
												work = push_expression_work(work, work_count, SolveConstraint(child))
												work_count = IntOps.add(work_count, 1)
											ExpandInferenceArguments(current, left, right):
												var position = left.length()

												while IntOps.greater_than(position, 0):
													position = IntOps.subtract(position, 1)

													match inference_child(current, left, right, position):
														Err(error):
															failure = Some(error)
															break
														Ok(child):
															work = push_expression_work(work, work_count, SolveConstraint(child))
															work_count = IntOps.add(work_count, 1)
					FinishRoot:
						operand_count = IntOps.subtract(operand_count, 1)
						value_result = expression_operand(operands, operand_count, body.span)
						operands = operands.set(operand_count, None)

						match value_result:
							Err(error): failure = Some(error)
							Ok(value):
								work = push_expression_work(work, work_count, FreezeRoot(value))
								work_count = IntOps.add(work_count, 1)

								match result_context:
									Some(result):
										if not slots.is_empty():
											equality: InferenceEquality = { expected = pending_type(value), actual = inference_type(result.expected.value_type, [], 0), origin = ResultConstraint(result), relation = RequireEquality, parameter = None }
											work = push_expression_work(work, work_count, SolveConstraint(equality))
											work_count = IntOps.add(work_count, 1)
											result_state = SolvingResultInference
									None: void
					FreezeRoot(value):
						match freeze_pending_value(value, slots):
							Err(error): failure = Some(error)
							Ok(frozen_value): accepted = Some(frozen_value)
			_: failure = Some(checker_invariant(body.span, InvalidInferenceWorklist))

	match failure:
		Some(error): Err(error)
		None: accepted.to_result(checker_invariant(body.span, InvalidInferenceWorklist))


private pure func freeze_pending_values(values: List[PendingValue], slots: List[InferenceSlot]) -> Result[List[CheckedExpr], CheckError]:
	var frozen: List[CheckedExpr] = []
	var failure: Option[CheckError] = None

	for value in values:
		match freeze_pending_value(value, slots):
			Err(error):
				failure = Some(error)
				break
			Ok(frozen_value):
				frozen = frozen.append(frozen_value)

	match failure:
		Some(error): Err(error)
		None: Ok(frozen)


-- A receiver call's frozen receiver is its first argument. Seeding the list with
-- it, rather than concatenating, saves one list allocation per UFCS call.
private pure func freeze_pending_call(call: PendingCall, values: List[PendingValue], receiver: Option[CheckedExpr], slots: List[InferenceSlot]) -> Result[ResolvedArguments, CheckError]:
	var actual = pending_arguments(values)
	var arguments: List[CheckedExpr] = []
	var callable_arguments: List[CallableArgument] = []
	var written_position = if receiver.is_some():
		1
	else:
		0
	var failure: Option[CheckError] = None

	match receiver:
		Some(frozen_receiver):
			receiver_use: InferenceUse = { value_type = AcceptedType(frozen_receiver.value_type), span = call.contract.span }
			actual = [receiver_use].concat(actual)
			arguments = [frozen_receiver]
		None: void

	for value in values:
		match value.base:
			PendingNamedCallable(id, signature, start):
				var types: List[TypeRef] = []
				for parameter in signature.type_parameters:
					match publish_inference_type(
						inference_type(ParameterType(parameter), signature.type_parameters, start),
						slots, CompleteInference, value.span,
					):
						Ok(accepted): types = types.append(accepted)
						Err(error):
							failure = Some(error)
							break
				match call.contract.target:
					DeclaredTarget(owner):
						callable_arguments = callable_arguments.append({
							parameter = callable_parameter(owner, written_position),
							choice = NamedCallable(id, types),
							span = value.span
						})
					_: failure = Some(checker_invariant(value.span, InvalidInferenceWorklist))
			PendingForwardedCallable(id):
				match call.contract.target:
					DeclaredTarget(owner):
						callable_arguments = callable_arguments.append({
							parameter = callable_parameter(owner, written_position),
							choice = ForwardedCallable(id),
							span = value.span
						})
					_: failure = Some(checker_invariant(value.span, InvalidInferenceWorklist))
			_:
				match freeze_pending_value(value, slots):
					Err(error): failure = Some(error)
					Ok(frozen_value): arguments = arguments.append(frozen_value)
		if failure.is_some():
			break
		written_position = IntOps.add(written_position, 1)

	ready ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	checked_call ?= publish_pending_call(call, callable_arguments, slots)
	parameters ?= admit_call_parameters(call, slots)
	return_type ?= admit_call_type(call.contract.signature.return_type.value_type, call, slots, call.contract.span)
	valid ?= validate_complete_arguments(call.contract, parameters, return_type, actual, slots)
	Ok({ values = arguments, call = checked_call })


private pure func freeze_retained_fields(fields: List[PendingRetainedField], slots: List[InferenceSlot], span: Span) -> Result[List[RetainedRecordField], CheckError]:
	var frozen: List[RetainedRecordField] = []
	var failure: Option[CheckError] = None
	for field in fields:
		match publish_inference_type(field.value_type, slots, CompleteInference, span):
			Ok(value_type): frozen = frozen.append({ field = field.field, value_type = value_type })
			Err(error):
				failure = Some(error)
				break
	match failure:
		Some(error): Err(error)
		None: Ok(frozen)


private pure func freeze_opaque_operand(operand: PendingValue, expected: TypeRef, site: ExpectedTypeSite, slots: List[InferenceSlot]) -> Result[CheckedExpr, CheckError]:
	value ?= freeze_pending_value(operand, slots)
	if same_type(value.value_type, expected):
		Ok(value)
	else:
		Err(value_error(operand.span, ExpressionTypeMismatch({ expected = expected, actual = { value_type = value.value_type, span = operand.span }, expected_site = site })))


-- Steps fold over their frozen receiver in source order. The loop keeps the
-- checker from recursing on chain length.
private pure func freeze_pending_value(value: PendingValue, slots: List[InferenceSlot]) -> Result[CheckedExpr, CheckError]:
	base_result: Result[CheckedForm, CheckError] = match value.base:
		PendingNamedCallable(_, _, _) | PendingForwardedCallable(_): Err(call_error(value.span, CallableValueRequired))
		AcceptedVoid: Ok(LiteralVoid)
		AcceptedInteger(integer): Ok(LiteralInteger(integer))
		AcceptedFloat(number): Ok(LiteralFloat(number))
		AcceptedString(text): Ok(LiteralString(text))
		AcceptedBinding(id): Ok(ReadBinding(id))
		PendingConstructOpaque(id, underlying, operand):
			match freeze_opaque_operand(operand, underlying, OpaqueConstruction(id), slots):
				Ok(value): Ok(ConstructOpaque(id, value))
				Err(error): Err(error)
		PendingProjectOpaque(id, operand):
			match freeze_opaque_operand(operand, OpaqueType(id), OpaqueProjection(id), slots):
				Ok(value): Ok(ProjectOpaque(id, value))
				Err(error): Err(error)
		PendingConstructRecord(owner, fields):
			match freeze_record_fields(fields, slots):
				Ok(frozen): Ok(ConstructRecord(owner, frozen))
				Err(error): Err(error)
		PendingUpdateRecord(owner, base, expression_span, fields, inherited):
			match freeze_pending_value(base, slots):
				Ok(frozen_base):
					match freeze_record_fields(fields, slots):
						Ok(replacements):
							match freeze_retained_fields(inherited, slots, expression_span):
								Ok(frozen_inherited):
									update: CheckedRecordUpdate = { base = frozen_base, base_expression_span = expression_span, replacements = replacements, inherited = frozen_inherited }
									Ok(UpdateRecord(owner, update))
								Err(error): Err(error)
						Err(error): Err(error)
				Err(error): Err(error)
		PendingConstructVariant(contract, values):
			match freeze_pending_values(values, slots):
				Ok(frozen):
					match validate_variant_fields(contract, values, slots):
						Ok(valid): Ok(ConstructVariant(contract.variant, frozen))
						Err(error): Err(error)
				Err(error): Err(error)
		PendingConstructList(source, values):
			match freeze_pending_values(values, slots):
				Ok(frozen):
					match validate_list_elements(source, values, slots, value.base_span):
						Ok(valid): Ok(ConstructList(frozen))
						Err(error): Err(error)
				Err(error): Err(error)
		PendingDirectCall(call, arguments):
			match freeze_pending_call(call, arguments, None, slots):
				Ok(resolved): Ok(InvokeFunction(resolved.call, resolved.values))
				Err(error): Err(error)
	base ?= base_result
	base_type ?= publish_inference_type(value.base_type, slots, CompleteInference, value.base_span)
	var current: CheckedExpr = { form = base, value_type = base_type, span = value.base_span }
	var failure: Option[CheckError] = None

	var steps: List[PendingStep] = []
	var cursor = value.operations
	var complete = False

	while not complete:
		match cursor:
			NoPendingOperations: complete = True
			PendingOperationLink(step, previous):
				steps = steps.append(step)
				cursor = previous

	var position = steps.length()

	while IntOps.greater_than(position, 0):
		position = IntOps.subtract(position, 1)

		match steps.get(position):
			None:
				failure = Some(checker_invariant(value.span, InvalidInferenceWorklist))
				break
			Some(step):
				match freeze_pending_step(step, current, slots):
					Err(error):
						failure = Some(error)
						break
					Ok(next):
						current = next

	ready ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	Ok(current)


private pure func freeze_pending_step(step: PendingStep, receiver: CheckedExpr, slots: List[InferenceSlot]) -> Result[CheckedExpr, CheckError]:
	form_result: Result[CheckedForm, CheckError] = match step.operation:
		AcceptedField(field): Ok(ReadRecordField(receiver, field))
		PendingInvocation(call, values):
			match freeze_pending_call(call, values, Some(receiver), slots):
				Ok(resolved): Ok(InvokeFunction(resolved.call, resolved.values))
				Err(error): Err(error)
	form ?= form_result
	value_type ?= publish_inference_type(step.value_type, slots, CompleteInference, step.span)
	Ok({ form = form, value_type = value_type, span = step.span })


pure func synthesize_value(scope: List[ScopedValue], body: ValueExpression, constructor_type: Option[TypeRef], context: ResolutionContext) -> Result[CheckedExpr, CheckError]:
	elaborate_value(scope, body, constructor_type, None, context)


pure func check_value(scope: List[ScopedValue], body: ValueExpression, expected: TypeRef, site: ExpectedTypeSite, context: ResolutionContext) -> Result[CheckedExpr, CheckError]:
	obligation: ExpectedValue = { value_type = expected, site = site }
	value ?= elaborate_value(scope, body, Some(expected), Some({ expected = obligation, span = body.span }), context)
	if same_type(value.value_type, expected):
		Ok(value)
	else:
		Err(value_error(body.span, ExpressionTypeMismatch({ expected = expected, actual = { value_type = value.value_type, span = body.span }, expected_site = site })))


private pure func classify_direct_call(
	name: WrittenName,
	arguments: List[ValueExpression],
	scope: List[ScopedValue],
	context: ResolutionContext,
) -> Result[ResolvedApplication, CheckError]:
	match lookup_binding(scope, name.id):
		Some(DataLocal(binding)):
			Err(non_callable(binding, name.span, context.caller.function))
		Some(CallableLocal(binding)):
			callable_contract(name, arguments, binding)
				.map(pure func(contract): FunctionApplication(contract))
		None:

			match named_value(context.namespace, context.module, name.id):
				Some(NamedConstant(id)):
					Err(constant_error(name.span, ConstantCalled(id)))
				Some(NamedFunction(target, _)):
					match function_contract(
						context.caller,
						name,
						arguments,
						target,
						context.signatures,
					):
						Ok(contract): Ok(FunctionApplication(contract))
						Err(error): Err(error)
				Some(NamedConstructor(_)):
					Ok(ConstructorApplication(name))
				_:
					Err(call_error(name.span, UnknownFunction(name.id)))


private pure func non_callable(
	binding: LocalBinding,
	span: Span,
	function: FunctionId,
) -> CheckError:
	call_error(
		span,
		UncallableBinding(
			binding_site(function, binding),
			binding_definition(binding).origin,
			binding_definition(binding).value_type,
		),
	)


private pure func named_callable_operand(
	id: FunctionId,
	written: ValueExpression,
	context: ResolutionContext,
	start: Int,
) -> Result[PendingValue, CheckError]:
	span = written.base_span
	accepted ?= context.signatures.get(function_number(id)).to_result(checker_invariant(span, InvalidInferenceWorklist))
	if not same_purity(accepted.signature.purity, Pure):
		Err(call_error(span, ImpureCallback(id)))
	else if has_callable_parameters(accepted.signature):
		Err(call_error(span, CallableCandidateHasCallableParameters(id)))
	else if IntOps.equals(function_number(id), function_number(context.caller.function)) and accepted.declaration.tail_annotation.is_some():
		if accepted.signature.type_parameters.is_empty():
			Err(recursion_error(span, AnnotatedSelfCallback))
		else:
			Err(recursion_error(span, GenericTailRecursionUnsupported))
	else:
		Ok({
			span = written.span,
			readiness = DeferredInference,
			base = PendingNamedCallable(id, accepted.signature, start),
			base_type = inference_type(
				PureCallableType(
					accepted.signature.parameters.map(pure func(value): value.value_type),
					accepted.signature.return_type.value_type,
				),
				accepted.signature.type_parameters, start,
			),
			base_span = written.base_span,
			operations = NoPendingOperations
		})


private pure func resolve_callable_operand(
	written: ValueExpression,
	scope: List[ScopedValue],
	context: ResolutionContext,
	start: Int,
) -> Result[PendingValue, CheckError]:
	if not written.applications.is_empty():
		Err(call_error(written.span, CallableValueRequired))
	else:
		match written.base:
			NameExpression(name):
				match lookup_binding(scope, name.id):
					Some(CallableLocal(binding)):
						Ok({
							span = written.span,
							readiness = DeferredInference,
							base = PendingForwardedCallable(callable_binding_id(binding)),
							base_type = inference_type(
								PureCallableType(
									callable_parameters(binding).map(pure func(value): value.value_type),
									callable_return_type(binding).value_type,
								),
								[], 0,
							),
							base_span = written.base_span,
							operations = NoPendingOperations
						})
					Some(DataLocal(binding)): Err(non_callable(binding, name.span, context.caller.function))
					None:
						match named_value(context.namespace, context.module, name.id):
							Some(NamedFunction(id, _)): named_callable_operand(id, written, context, start)
							Some(NamedAlias(_)): Err(qualified_error(name.span, BareModuleAlias(name.id)))
							Some(_): Err(call_error(name.span, CallableValueRequired))
							None: Err(value_error(name.span, UnknownValue(name.id)))
			QualifiedName(qualified):
				match aliased_module(context.namespace, context.module, qualified.module):
					Err(error): Err(error)
					Ok(aliased):
						match offered_value(context.namespace, aliased.target, qualified.name.id):
							Ok(OfferedFunction(id)): named_callable_operand(id, written, context, start)
							Ok(_): Err(call_error(written.span, CallableValueRequired))
							Err(reason): Err(qualified_error(qualified.name.span, QualifiedNotOffered(qualified.module.id, qualified.name.id, aliased.path, reason)))
			LambdaExpression(_): Err(unsupported_form(written.base_span, LambdaValue))
			_: Err(call_error(written.span, CallableValueRequired))
