private union ExpressionSite:
	BodyExpression(ResolutionContext, pure (
		List[ScopedValue], List[BindingDefinition], ParsedBlock,
		TypeUse, ResolutionContext, List[LambdaRow],
	) -> Result[ResolvedBody, CheckError])
	ConstantInitializer(ConstructionContext, List[AcceptedFunction], TraitAvailability)


private pure func site_construction(site: ExpressionSite) -> ConstructionContext:
	match site:
		BodyExpression(context, _): construction_context(context)
		ConstantInitializer(context, _, _): context


private pure func site_signatures(site: ExpressionSite) -> List[AcceptedFunction]:
	match site:
		BodyExpression(context, _): context.signatures
		ConstantInitializer(_, signatures, _): signatures


private pure func site_traits(site: ExpressionSite) -> TraitAvailability:
	match site:
		BodyExpression(context, _): context.traits
		ConstantInitializer(_, _, traits): traits


private pure func site_requirements(site: ExpressionSite, span: Span) -> Result[List[Checked.TraitRequirement], CheckError]:
	match site:
		ConstantInitializer(_, _, _): Ok([])
		BodyExpression(context, _):
			match context.signatures.get(function_number(context.root_function)):
				Some(accepted): Ok(accepted.signature.requirements)
				None: Err(checker_invariant(span, InvalidFunctionContract))


private pure func body_context(site: ExpressionSite, span: Span) -> Result[ResolutionContext, CheckError]:
	match site:
		BodyExpression(context, _): Ok(context)
		ConstantInitializer(_, _, _): Err(constant_error(span, NonClosedInitializer))


private union ResolvedPostfix:
	InvokeReceiver(ReceiverApplication, ResolvedReceiver)
	ReadIndex(ValueExpression, Span)
	ReadField(WrittenName)


private union ResolvedApplication:
	FunctionApplication(FunctionContract)
	StoredApplication(CheckedExpr, FunctionContract)
	ConstructorApplication(VariantId, WrittenName)


private pure func freeze_record_fields(fields: List[PendingRecordField], slots: List[InferenceSlot], captures: CaptureScope, constructions: List[ContextWork], assumptions: List[Checked.TraitRequirement], traits: TraitAvailability) -> Result[List[CheckedRecordField], CheckError]:
	var frozen: List[CheckedRecordField] = []
	var failure: Option[CheckError] = None

	-- All child errors precede ordinary field mismatches, including later children.
	for field in fields:
		match freeze_pending_value(field.value, slots, captures, constructions, assumptions, traits):
			Ok(value): frozen = frozen.append({ field = field.field, value = value, span = field.value.span })
			Err(error):
				failure = Some(error)
				break
	_: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	valid ?= validate_record_fields(fields, slots)
	Ok(frozen)


private record PostfixHints {
	base: Option[InferenceType],
	results: List[Option[InferenceType]]
}


private pure func postfix_hints(postfixes: List[PendingPostfix], result_hint: Option[InferenceType], slots: List[InferenceSlot]) -> Result[PostfixHints, CheckError]:
	var results: List[Option[InferenceType]] = []

	for postfix in postfixes:
		results = results.append(None)

	var hint = result_hint
	var position = postfixes.length()
	var failure: Option[CheckError] = None

	while position.greater_than(0):
		position = position.subtract(1)
		results = results.set(position, hint)

		match postfixes.get(position):
			Some(PendingReceiverInvocation(_, call)):
				match call_argument_hints(call, hint, slots):
					Ok(arguments): hint = arguments.get(0).get_or(None)
					Err(error):
						failure = Some(error)
						break
			Some(PendingOverloadInvocation(_, _)):
				-- A common concrete receiver hint would prove a declaration clash.
				hint = None
			Some(PendingField(_)) | Some(PendingTupleIndex(_, _)): hint = None
			None:
				failure = Some(checker_invariant(compiler_span(), InvalidInferenceWorklist))
				break

	match failure:
		Some(error): Err(error)
		None: Ok({ base = hint, results = results })


private union PendingPostfix:
	PendingTupleIndex(ValueExpression, Span)
	PendingField(WrittenName)
	PendingReceiverInvocation(ReceiverApplication, PendingCall)
	PendingOverloadInvocation(ReceiverApplication, List[ReceiverCandidate])


private record ExpressionPlan {
	base: PlannedBase,
	postfixes: List[PendingPostfix],
	hints: List[Option[InferenceType]]
}


private fixed record OperandRange {
	start: Int,
	count: Int
}


private union ExpressionWork:
	EnterExpression(ValueExpression, Option[InferenceType])
	EnterCallable(ValueExpression, Option[InferenceType])
	ResolveContexts(Int, Int)
	FinishContext(Int, List[ScopedValue], ExpressionSite, Int)
	ScheduleVariant(PendingVariantContract, List[ValueExpression], Span)
	ResolveLambdas(Int, Int)
	FinishLambda(LambdaFinish)
	FinishConstructOpaque(OpaqueConversion, Span)
	FinishProjectOpaque(OpaqueConversion, Span)
	ContinuePostfix(List[PendingPostfix], List[Option[InferenceType]], Int, Span, Span, Option[InferenceType])
	ScheduleCall(FunctionContract, List[ValueExpression], CallPlacement, Option[InferenceType])
	StartCall(PendingCall, List[ValueExpression], CallPlacement, Option[InferenceType])
	FinishVariant(PendingVariantContract, OperandRange, Span)
	CheckVariant(PendingVariantContract, List[PendingValue], Span)
	FinishCall(PendingCall, OperandRange, CallPlacement)
	CheckCall(PendingCall, List[PendingValue], CallPlacement)
	PlanRecordUpdate(List[ParsedRecordField], Span, Span)
	ScheduleRecord(PlannedRecordFields)
	FinishRecord(PlannedRecordFields, OperandRange)
	CheckRecord(PlannedRecordFields, List[PendingRecordField])
	ContinueList(ListProgress)
	FinishTuple(OperandRange, Span, Span)
	FinishInterpolation(OperandRange, Span, Span)
	FinishList(ListElementSource, OperandRange, Span, Span)
	CheckList(ListElementSource, List[PendingValue], Span, Span)
	SolveConstraint(InferenceEquality)
	FinishRoot
	FreezeRoot(PendingValue)


-- A list literal's elements entered so far: `position` is the next element to
-- enter and `start` the operand index of the first, which decides E when no
-- context supplies one.
private record ListProgress {
	source: ListElementSource,
	elements: List[ValueExpression],
	position: Int,
	start: Int,
	base_span: Span,
	span: Span
}


private union ContextWork:
	AwaitingContext(SuspendedConstruction, InferenceType, List[ScopedValue], ExpressionSite, Span)
	CompletedContext(PendingValue)


private record LambdaAdmission {
	id: LambdaId,
	written: ParsedLambda,
	parameters: List[InferenceType],
	result: InferenceType,
	scope: List[ScopedValue],
	context: ResolutionContext
}


private record AdmittedLambda {
	admission: LambdaAdmission,
	value_type: InferenceType,
	constraints: List[InferenceEquality]
}


private record LambdaScope {
	scope: List[ScopedValue],
	bindings: List[BindingDefinition]
}


private union LambdaWork:
	AwaitingLambda(LambdaAdmission)
	InferredLambda(LambdaAdmission, List[BindingDefinition], PendingValue)
	CompletedLambda


private record LambdaFinish {
	position: Int,
	scope: List[ScopedValue],
	context: ResolutionContext,
	bindings: List[BindingDefinition],
	operand_start: Int
}


private union CaptureScope:
	NoCaptures
	BodyCaptures(BodyOwner, List[LambdaRow])


private record CaptureRegistration {
	id: CaptureId,
	lambdas: List[LambdaRow]
}


private pure func capture_position(captures: List[CheckedCapture], binding: ScopedBindingId) -> Option[Int]:
	var found: Option[Int] = None
	var position = 0
	for capture in captures:
		if same_scoped_binding(capture.binding, binding):
			found = Some(position)
			break
		position = position.add(1)
	found


-- Register a grandparent read in every intervening environment. The single
-- row inventory survives context restoration, so child completion cannot lose
-- an ancestor capture needed only to construct that child.
private pure func register_capture(
	lambdas: List[LambdaRow], owner: LambdaId, binding: ScopedBindingId, value_type: TypeUse,
) -> Result[CaptureRegistration, CheckError]:
	row ?= lambdas.get(lambda_number(owner)).to_result(checker_invariant(value_type.span, InvalidInferenceWorklist))
	match row:
		CheckedLambdaRow(_): Err(checker_invariant(value_type.span, InvalidInferenceWorklist))
		CollectingLambda(pending):
			match capture_position(pending.captures, binding):
				Some(position): Ok({ id = capture_id(owner, position), lambdas = lambdas })
				None:
					ancestors: Result[List[LambdaRow], CheckError] = if same_body(pending.parent, binding.owner):
						Ok(lambdas)
					else:
						match pending.parent:
							DeclaredBody(_) | Checked.DerivedEqualityBody(_): Err(checker_invariant(value_type.span, InvalidInferenceWorklist))
							Checked.LambdaBody(parent):
								match register_capture(lambdas, parent, binding, value_type):
									Ok(registered): Ok(registered.lambdas)
									Err(error): Err(error)
					match ancestors:
						Err(error): Err(error)
						Ok(rows): Ok({
							id = capture_id(owner, pending.captures.length()),
							lambdas = rows.set(lambda_number(owner), CollectingLambda({ pending |
								captures = pending.captures.append({ binding = binding, value_type = value_type })
							}))
						})


private pure func lambda_captures(lambdas: List[LambdaRow], owner: LambdaId, span: Span) -> Result[List[CheckedCapture], CheckError]:
	row ?= lambdas.get(lambda_number(owner)).to_result(checker_invariant(span, InvalidInferenceWorklist))
	match row:
		CollectingLambda(pending): Ok(pending.captures)
		CheckedLambdaRow(checked): Ok(checked.captures)


-- Creation occurs in the restored parent body. These operands read the
-- parent's own bindings or its already established captures, never a foreign
-- body's dense local ordinal.
private pure func capture_operands(id: LambdaId, parent_body: BodyOwner, lambdas: List[LambdaRow], span: Span) -> Result[List[CheckedExpr], CheckError]:
	captures ?= lambda_captures(lambdas, id, span)
	var operands: List[CheckedExpr] = []
	var failure: Option[CheckError] = None
	for capture in captures:
		form: Result[CheckedForm, CheckError] = if same_body(parent_body, capture.binding.owner):
			Ok(ReadBinding(capture.binding.binding))
		else:
			match parent_body:
				DeclaredBody(_) | Checked.DerivedEqualityBody(_): Err(checker_invariant(span, InvalidInferenceWorklist))
				Checked.LambdaBody(owner):
					match lambda_captures(lambdas, owner, span):
						Err(error): Err(error)
						Ok(parent):
							match capture_position(parent, capture.binding):
								Some(position): Ok(ReadCapture(capture_id(owner, position)))
								None: Err(checker_invariant(span, InvalidInferenceWorklist))
		match form:
			Ok(read): operands = operands.append({ form = read, value_type = capture.value_type.value_type, span = capture.value_type.span })
			Err(error):
				failure = Some(error)
				break
	match failure:
		Some(error): Err(error)
		None: Ok(operands)


private union ResultInferenceState:
	NoResultInference
	SolvingResultInference
	IncompatibleResultInference


private pure func push_expression_work(work: List[Option[ExpressionWork]], depth: Int, action: ExpressionWork) -> List[Option[ExpressionWork]]:
	if depth.less_than(work.length()):
		work.set(depth, Some(action))
	else:
		work.append(Some(action))


private pure func push_operand(values: List[Option[PendingValue]], depth: Int, value: PendingValue) -> List[Option[PendingValue]]:
	if depth.less_than(values.length()):
		values.set(depth, Some(value))
	else:
		values.append(Some(value))


private pure func expression_operand(values: List[Option[PendingValue]], position: Int, span: Span) -> Result[PendingValue, CheckError]:
	match values.get(position):
		Some(Some(value)): Ok(value)
		_: Err(checker_invariant(span, InvalidInferenceWorklist))


private pure func call_operands(values: List[Option[PendingValue]], range: OperandRange, span: Span) -> Result[List[PendingValue], CheckError]:
	var arguments: List[PendingValue] = []
	var failure: Option[CheckError] = None

	for position in range.start..range.start.add(range.count):
		match expression_operand(values, position, span):
			Err(error):
				failure = Some(error)
				break
			Ok(value):
				arguments = arguments.append(value)

	match failure:
		Some(error): Err(error)
		None: Ok(arguments)


private pure func record_operands(values: List[Option[PendingValue]], range: OperandRange, literal: PlannedRecordFields) -> Result[List[PendingRecordField], CheckError]:
	var fields: List[PendingRecordField] = []
	var position = range.start
	var failure: Option[CheckError] = None
	for planned in literal.fields:
		match expression_operand(values, position, literal.span):
			Ok(value): fields = fields.append({ field = planned.field, expected = planned.expected, value = value })
			Err(error):
				failure = Some(error)
				break
		position = position.add(1)
	match failure:
		Some(error): Err(error)
		None: Ok(fields)


-- Context can weaken outer purity; parameter/result equality stays exact.
private pure func callable_permission(
	value: PendingValue, expected: Option[InferenceType], slots: List[InferenceSlot],
) -> Result[PendingValue, CheckError]:
	match expected:
		None: Ok(value)
		Some(written):
			match inference_head(written, slots, value.span):
				Err(error): Err(error)
				Ok(head):
					match inference_shape(head):
						InferredCallable(Pure, _, _):
							match value.base:
								PendingNamedCallable(id, signature, _):
									if same_purity(signature.purity, Pure):
										Ok(value)
									else:
										Err(call_error(value.span, ImpureCallback(id)))
								_: Ok(value)
						InferredCallable(Impure, _, _):
							match inference_head(pending_type(value), slots, value.span):
								Err(error): Err(error)
								Ok(actual):
									view: InferenceType = match actual:
										AcceptedType(CallableType(Pure, parameters, result)): AcceptedType(CallableType(Impure, parameters, result))
										InferredCallable(Pure, parameters, result): InferredCallable(Impure, parameters, result)
										_: actual
									match value.operations:
										NoPendingOperations: Ok({ value | base_type = view })
										PendingOperationLink(step, previous):
											Ok({ value | operations = PendingOperationLink({ step | value_type = view }, previous) })
						_: Ok(value)


private pure func argument_work(call: PendingCall, arguments: List[ValueExpression], placement: CallPlacement, hints: List[Option[InferenceType]], position: Int) -> Result[ExpressionWork, CheckError]:
	argument ?= arguments.get(position).to_result(checker_invariant(call.span, MissingCallParameter(position)))
	argument_position = match placement:
		ReceiverPlacement(_, _): position.add(1)
		_: position
	hint ?= hints.get(argument_position).to_result(checker_invariant(call.span, MissingCallParameter(argument_position)))
	written ?= call.signature.parameters.get(argument_position).to_result(checker_invariant(call.span, MissingCallParameter(argument_position)))
	match written.value_type:
		CallableType(_, _, _): Ok(EnterCallable(argument, hint))
		_: Ok(EnterExpression(argument, hint))


-- The opaque type and its underlying type over fresh variables, one per type
-- parameter from `variable_start`; a nongeneric declaration has none.
private pure func opaque_conversion(declaration: CheckedOpaque, variable_start: Int) -> OpaqueConversion:
	parameters = declaration.type_parameters
	{
		id = declaration.id,
		opaque_type = inference_type(NominalType(OpaqueNominal(declaration.id), parameters.map(pure func(parameter): ParameterType(parameter))), parameters, variable_start),
		underlying_type = inference_type(declaration.underlying_type.value_type, parameters, variable_start),
	}


private pure func opaque_value(base: PendingBase, result_type: InferenceType, span: Span) -> PendingValue:
	{ span = span, readiness = DeferredInference, base = base, base_type = result_type, base_span = span, operations = NoPendingOperations }


-- A deferred operand, or one whose expected type has variables to solve,
-- meets that type; a closed operand of a complete type is checked when frozen.
private pure func opaque_operand_constraint(operand: PendingValue, expected: InferenceType, site: ExpectedTypeSite) -> Option[InferenceEquality]:
	checked_at_freeze: Bool = match expected:
		AcceptedType(_):
			match operand.readiness:
				ClosedInference: True
				DeferredInference: False
		_: False
	if checked_at_freeze:
		None
	else:
		Some({ expected = pending_type(operand), actual = expected, origin = OpaqueOperandConstraint(site, operand.span), relation = RequireEquality, parameter = None })


private pure func conversion_declaration(name: WrittenName, context: ResolutionContext) -> Result[OpaqueRow, CheckError]:
	match named_type(context.namespace, context.module, name.id):
		None: Err(value_error(name.span, UnknownOpaqueType(name.id)))
		Some(named):
			match named.head:
				OpaqueHead(id): context.opaque_declarations.get(opaque_number(id)).to_result(checker_invariant(name.span, InvalidOpaqueDeclaration(id)))
				_: Err(value_error(name.span, NonOpaqueConversionType(name.id)))


private pure func plan_base(
	scope: List[ScopedValue], body: ValueExpression, expectation: Option[InferenceType],
	site: ExpressionSite, construction: ConstructionContext, slots: List[InferenceSlot],
) -> Result[PlannedBase, CheckError]:
	match body.base:
		RecordExpression(fields): plan_record_literal(fields, body.base_span, expectation, construction, slots)

		ListExpression(elements): plan_list_literal(elements, expectation, body.base_span)
		VoidExpression: Ok(PlannedLeaf(AcceptedVoid, VoidType))
		StringExpression(value): Ok(PlannedLeaf(AcceptedString(value), StringType))
		InterpolatedString(parts):
			match site:
				ConstantInitializer(_, _, _): Err(constant_error(body.span, NonClosedInitializer))
				BodyExpression(_, _): Ok(PlannedInterpolation(parts))
		IntegerExpression(value): Ok(PlannedLeaf(AcceptedInteger(value), IntType))
		FloatExpression(value): Ok(PlannedLeaf(AcceptedFloat(value), FloatType))
		TupleExpression(elements):
			match tuple_hints(expectation, slots, body.base_span):
				Ok(hints): Ok(PlannedTuple(elements, hints))
				Err(error): Err(error)
		_:
			match site:
				BodyExpression(context, _): plan_body_base(scope, body, expectation, context, construction, slots)
				ConstantInitializer(_, _, _): plan_closed_base(body, expectation, construction, slots)


private pure func plan_closed_base(
	body: ValueExpression, expectation: Option[InferenceType], construction: ConstructionContext, slots: List[InferenceSlot],
) -> Result[PlannedBase, CheckError]:
	match body.base:
		NameExpression(name):
			match named_value(construction.namespace, construction.module, name.id):
				Some(NamedMethod(_)): Ok(PlannedCallable(body, expectation))
				Some(NamedFunction(_, _)): Ok(PlannedCallable(body, expectation))
				Some(NamedConstructor(variant)): plan_variant(variant, name, [], False, expectation, slots, construction)
				Some(NamedConstant(_)): Err(constant_error(body.span, NonClosedInitializer))
				_: Err(value_error(name.span, UnknownValue(name.id)))
		DirectApplication(name, arguments):
			match named_value(construction.namespace, construction.module, name.id):
				Some(NamedConstructor(variant)): plan_variant(variant, name, arguments, True, expectation, slots, construction)
				_: Err(constant_error(body.span, NonClosedInitializer))
		QualifiedName(qualified): plan_closed_qualified(qualified, [], False, body, expectation, construction, slots)
		QualifiedApplication(qualified, arguments): plan_closed_qualified(qualified, arguments, True, body, expectation, construction, slots)
		_: Err(constant_error(body.span, NonClosedInitializer))


private pure func plan_closed_qualified(
	qualified: ParsedQualified, arguments: List[ValueExpression], called: Bool, body: ValueExpression,
	expectation: Option[InferenceType], construction: ConstructionContext, slots: List[InferenceSlot],
) -> Result[PlannedBase, CheckError]:
	aliased ?= aliased_module(construction.namespace, construction.module, qualified.module)
	match offered_value(construction.namespace, aliased.target, qualified.name.id):
		Ok(OfferedConstructor(variant)):
			plan_qualified_variant(variant_owner(variant), variant, qualified.name, arguments, called, expectation, construction, slots)
		Ok(OfferedFunction(_)):
			if called:
				Err(constant_error(body.span, NonClosedInitializer))
			else:
				Ok(PlannedCallable(body, expectation))
		Ok(OfferedMethod(_)): Ok(PlannedCallable(body, expectation))
		Ok(OfferedConstant(_)): Err(constant_error(body.span, NonClosedInitializer))
		Err(reason): Err(qualified_error(qualified.name.span, QualifiedNotOffered(qualified.module.id, qualified.name.id, aliased.path, reason)))


-- An operator needs the prelude-selected trait of its family.
private pure func selected_contract[Contract](contract: Option[Contract], family: Errors.CanonicalFamily, span: Span) -> Result[Contract, CheckError]:
	match contract:
		Some(accepted): Ok(accepted)
		None: Err(Errors.trait_error(span, Errors.OperatorRequiresCanonical(family)))


-- Each operator invokes its own canonical member, so `!=`, `>` and `>=` never
-- become a negation or a swap at the call site.
private pure func comparison_contract(operator: ComparisonOperator, span: Span, traits: Checked.AcceptedTraits) -> Result[FunctionContract, CheckError]:
	equality = traits.canonical.equality
	ordering = traits.canonical.ordering
	method: TraitMethodId ?= match operator:
		EqualOperator: selected_contract(equality, Errors.EqualityFamily, span).map(Checked.canonical_equals)
		NotEqualOperator:
			match selected_contract(equality, Errors.EqualityFamily, span):
				Ok(contract): Checked.canonical_not_equals(contract).to_result(Errors.trait_error(span, Errors.MissingCanonicalInequality))
				Err(error): Err(error)
		LessOperator: selected_contract(ordering, Errors.OrderingFamily, span).map(Checked.canonical_less_than)
		GreaterOperator: selected_contract(ordering, Errors.OrderingFamily, span).map(Checked.canonical_greater_than)
		LessEqualOperator: selected_contract(ordering, Errors.OrderingFamily, span).map(Checked.canonical_less_than_or_equal)
		GreaterEqualOperator: selected_contract(ordering, Errors.OrderingFamily, span).map(Checked.canonical_greater_than_or_equal)
	method_id_contract(span, method, traits)


private pure func plan_body_base(scope: List[ScopedValue], body: ValueExpression, expectation: Option[InferenceType], context: ResolutionContext, construction: ConstructionContext, slots: List[InferenceSlot]) -> Result[PlannedBase, CheckError]:
	match body.base:
		ComparisonExpression(operator, span, left, right):
			comparison_contract(operator, span, accepted_traits(context.traits)).map(pure func(contract): PlannedCall(contract, [left, right], ReturnPlacement(body.base_span, body.span), expectation))
		RecordUpdateExpression(base, fields): Ok(PlannedUpdate(base, fields, expectation))
		DirectApplication(name, arguments):
			match classify_direct_call(name, arguments, scope, context):
				Ok(classified):
					match classified:
						FunctionApplication(contract): Ok(PlannedCall(contract, arguments, ReturnPlacement(body.base_span, body.span), expectation))
						StoredApplication(callee, contract): Ok(PlannedStoredCall(callee, contract, arguments, ReturnPlacement(body.base_span, body.span), expectation))
						ConstructorApplication(variant, constructor_name): plan_variant(variant, constructor_name, arguments, True, expectation, slots, construction)
				Err(error): Err(error)
		NameExpression(name):
			match lookup_binding(scope, name.id):
				Some(DataLocal(binding)):
					if same_body(binding_site(binding).binding.owner, context.caller.body):
						Ok(PlannedLeaf(AcceptedBinding(local_binding_id(binding)), binding_definition(binding).value_type))
					else:
						if binding_definition(binding).mutable:
							Err(value_error(name.span, MutableCapture(binding_site(binding).binding)))
						else:
							Ok(PlannedLeaf(PendingCapture(binding_site(binding).binding), binding_definition(binding).value_type))
				Some(CallableLocal(binding)):
					local = callable_local(binding)
					base: PendingBase = if same_body(binding_site(local).binding.owner, context.caller.body):
						AcceptedBinding(local_binding_id(local))
					else:
						PendingCapture(binding_site(local).binding)
					Ok(PlannedLeaf(base, binding_definition(local).value_type))
				None:
					match named_value(context.namespace, context.module, name.id):
						Some(NamedMethod(_)): Ok(PlannedCallable(body, expectation))
						Some(NamedFunction(_, _)): Ok(PlannedCallable(body, expectation))
						Some(NamedConstant(id)):
							constant_row(context.constants, id).to_result(checker_invariant(name.span, InvalidConstantDeclaration(id))).map(
								pure func(row): PlannedLeaf(AcceptedConstant(row.value), row.value.value_type),
							)
						Some(NamedConstructor(variant)): plan_variant(variant, name, [], False, expectation, slots, construction)
						Some(NamedAlias(_)): Err(qualified_error(name.span, BareModuleAlias(name.id)))
						_: Err(value_error(name.span, UnknownValue(name.id)))
		QualifiedName(qualified): plan_qualified(qualified, [], False, expectation, slots, context, construction, body)
		QualifiedApplication(qualified, arguments): plan_qualified(qualified, arguments, True, expectation, slots, context, construction, body)
		OpaqueWrap(name, operand):
			match conversion_declaration(name, context):
				Err(error): Err(error)
				Ok(declaration):
					if same_module(declaration.declaration.module, context.module).not():
						Err(value_error(name.span, ForeignOpaqueConstruction(declaration.id)))
					else:
						match context.opaques.get(opaque_number(declaration.id)):
							None: Err(checker_invariant(name.span, InvalidOpaqueDeclaration(declaration.id)))
							Some(accepted): Ok(PlannedConstructOpaque(accepted, operand))
		OpaqueUnwrap(name, operand):
			match conversion_declaration(name, context):
				Err(error): Err(error)
				Ok(declaration):
					if same_module(declaration.declaration.module, context.module).not():
						Err(value_error(name.span, ForeignOpaqueProjection(declaration.id)))
					else:
						match context.opaques.get(opaque_number(declaration.id)):
							None: Err(checker_invariant(name.span, InvalidOpaqueDeclaration(declaration.id)))
							Some(accepted): Ok(PlannedProjectOpaque(accepted, operand))
		RangeExpression(_, _): Err(unsupported_form(body.base_span, RangeValue))
		LogicalExpression(_, _, _): Err(unsupported_form(body.base_span, AndOrOperator))
		NotExpression(_): Err(unsupported_form(body.base_span, NotOperator))
		IfExpression(_): Err(unsupported_form(body.base_span, IfValue))
		-- Bodies resolve a bare match as a join; one reaching the planner is
		-- nested inside a larger expression.
		MatchExpression(_): Err(unsupported_form(body.base_span, MatchInExpression))
		LambdaExpression(_): Ok(PlannedCallable(body, expectation))

		RecordExpression(_) | ListExpression(_) | TupleExpression(_) | VoidExpression | InterpolatedString(_) | StringExpression(_) | IntegerExpression(_) | FloatExpression(_): Err(checker_invariant(body.span, InvalidInferenceWorklist))


-- `Alias.name` resolves through the alias row to the target's own exported
-- declarations: a constructor builds that union's variant; a function is a
-- direct call to it. Imports of the target are not reexported.
private pure func plan_qualified(
	qualified: ParsedQualified,
	arguments: List[ValueExpression],
	called: Bool,
	expectation: Option[InferenceType],
	slots: List[InferenceSlot],
	context: ResolutionContext,
	construction: ConstructionContext,
	body: ValueExpression,
) -> Result[PlannedBase, CheckError]:
	aliased ?= aliased_module(context.namespace, context.module, qualified.module)
	name = qualified.name
	match offered_value(context.namespace, aliased.target, name.id):
		Ok(OfferedConstant(id)):
			match constant_row(context.constants, id).to_result(checker_invariant(name.span, InvalidConstantDeclaration(id))):
				Err(error): Err(error)
				Ok(row):
					if called:
						match constant_application(row, name, arguments, { qualified.module.span | end = name.span.end }, context):
							Err(error): Err(error)
							Ok(StoredApplication(callee, contract)): Ok(PlannedStoredCall(callee, contract, arguments, ReturnPlacement(body.base_span, body.span), expectation))
							Ok(_): Err(checker_invariant(name.span, InvalidFunctionContract))
					else:
						Ok(PlannedLeaf(AcceptedConstant(row.value), row.value.value_type))
		Ok(OfferedConstructor(variant)):
			plan_qualified_variant(variant_owner(variant), variant, name, arguments, called, expectation, construction, slots)
		Ok(OfferedMethod(method)):
			if called:
				match method_contract(name, arguments.length(), False, method, accepted_traits(context.traits)):
					Ok(contract): Ok(PlannedCall(contract, arguments, ReturnPlacement(body.base_span, body.span), expectation))
					Err(error): Err(error)
			else:
				Ok(PlannedCallable(body, expectation))
		Ok(OfferedFunction(function)):
			if called:
				match function_contract(context.caller, name, False, arguments, function, context.signatures):
					Ok(contract): Ok(PlannedCall(contract, arguments, ReturnPlacement(body.base_span, body.span), expectation))
					Err(error): Err(error)
			else:
				Ok(PlannedCallable(body, expectation))
		Err(reason):
			Err(qualified_error(name.span, QualifiedNotOffered(qualified.module.id, name.id, aliased.path, reason)))


private pure func expression_postfixes(scope: List[ScopedValue], body: ValueExpression, site: ExpressionSite) -> Result[List[ResolvedPostfix], CheckError]:
	match site:
		BodyExpression(context, _): resolve_postfixes(scope, body, context)
		ConstantInitializer(_, _, _):
			if body.applications.is_empty():
				Ok([])
			else:
				Err(constant_error(body.span, NonClosedInitializer))


private pure func resolve_postfixes(scope: List[ScopedValue], body: ValueExpression, context: ResolutionContext) -> Result[List[ResolvedPostfix], CheckError]:
	receiver_decision: Result[Void, CheckError] = if body.applications.is_empty():
		Ok(void)
	else:
		match body.base:
			NameExpression(name):
				match lookup_binding(scope, name.id):
					Some(CallableLocal(binding)):
						match callable_parameter_contract(binding):
							Err(error): Err(error)
							Ok(accepted): Err(call_error(name.span, CallableReceiverSyntax(ParameterTarget(accepted.parameter))))
					Some(DataLocal(_)): Ok(void)
					None:
						match named_value(context.namespace, context.module, name.id):
							Some(NamedFunction(id, _)): Err(call_error(name.span, CallableReceiverSyntax(DeclaredTarget(id))))
							_: Ok(void)
			_: Ok(void)
	data_receiver ?= receiver_decision
	var contracts: List[ResolvedPostfix] = []
	var failure: Option[CheckError] = None

	for postfix in body.applications:
		match postfix:
			TupleIndex(index, span): contracts = contracts.append(ReadIndex(index, span))
			FieldAccess(name): contracts = contracts.append(ReadField(name))
			ReceiverInvocation(application):
				match lookup_binding(scope, application.callee.id):
					Some(CallableLocal(binding)):
						match callable_parameter_contract(binding):
							Err(error): failure = Some(error)
							Ok(accepted): failure = Some(call_error(application.callee.span, CallableReceiverSyntax(ParameterTarget(accepted.parameter))))
						break
					_: void
				match classify_receiver(application, context):
					Err(error):
						failure = Some(error)
						break
					Ok(receiver): contracts = contracts.append(InvokeReceiver(application, receiver))

	match failure:
		Some(error): Err(error)
		None: Ok(contracts)


private pure func plan_expression(scope: List[ScopedValue], body: ValueExpression, hint: Option[InferenceType], site: ExpressionSite, construction: ConstructionContext, slots: List[InferenceSlot], contracts: List[PendingPostfix]) -> Result[ExpressionPlan, CheckError]:
	projected ?= postfix_hints(contracts, hint, slots)
	base_expectation = projected.base
	base_result = plan_base(scope, body, base_expectation, site, construction, slots)
	contextual_base: Result[PlannedBase, CheckError] = match base_result:
		Ok(base): Ok(base)
		Err(error):
			context_error = match error.kind:
				ConstructorRejection(ConstructorNeedsExpectedType(_)):
					match body.base:
						NameExpression(name): same_span(error.span, name.span)
						DirectApplication(name, _): same_span(error.span, name.span)
						_: same_span(error.span, body.base_span)
				RecordRejection(RecordNeedsExpectedType): same_span(error.span, body.base_span)
				_: False

			if context_error:
				match contracts.get(0):
					Some(PendingOverloadInvocation(application, candidates)):
						sites = method_sites(candidates)
						Err(method_error(application.callee.span, MethodReceiverNeedsType(application.callee.id, sites)))
					_: Err(error)
			else:
				Err(error)
	base ?= contextual_base
	Ok({ base = base, postfixes = contracts, hints = projected.results })


private pure func pending_receiver_contract(current: PendingValue, application: ReceiverApplication, receiver: ResolvedReceiver, site: ExpressionSite, slots: List[InferenceSlot]) -> Result[FunctionContract, CheckError]:
	context ?= body_context(site, application.span)
	match receiver:
		UniqueReceiver(contract): Ok(contract)
		ReceiverCandidates(_):
			match publish_inference_type(pending_type(current), slots, CompleteInference, application.callee.span):
				Ok(actual): select_receiver_contract(application, receiver, { value_type = actual, span = current.base_span }, context)
				Err(error): Err(error)


private pure func tuple_hints(expectation: Option[InferenceType], slots: List[InferenceSlot], span: Span) -> Result[List[Option[InferenceType]], CheckError]:
	match expectation:
		None: Ok([])
		Some(expected):
			match inference_head(expected, slots, span):
				Err(error): Err(error)
				Ok(head):
					match inference_shape(head):
						InferredTuple(elements): Ok(elements.map(pure func(element): Some(element)))
						_: Ok([])


private pure func pending_tuple_index(index: ValueExpression, span: Span, current: PendingValue, slots: List[InferenceSlot]) -> Result[PendingValue, CheckError]:
	head ?= inference_head(pending_type(current), slots, index.span)
	element_result: Result[List[InferenceType], CheckError] = match inference_shape(head):
		InferredTuple(values): Ok(values)
		_:
			publish_inference_type(head, slots, DiagnosticInference, index.span).and_then(
				pure func(actual: TypeRef) -> Result[List[InferenceType], CheckError]: Err(value_error(index.span, TupleIndexRequiresTuple(actual)))
			)
	elements ?= element_result
	position_result: Result[Int, CheckError] = match index.base:
		IntegerExpression(value):
			if index.applications.is_empty():
				Ok(value)
			else:
				Err(value_error(index.span, TupleIndexMustBeLiteral))
		_: Err(value_error(index.span, TupleIndexMustBeLiteral))
	position ?= position_result
	selected ?= elements.get(position).to_result(value_error(index.span, TupleIndexOutOfRange(position, elements.length())))
	Ok({ current | operations = PendingOperationLink({ operation = AcceptedTupleElement(position), value_type = selected, span = span }, current.operations) })


private pure func pending_field(name: WrittenName, current: PendingValue, slots: List[InferenceSlot], context: ConstructionContext) -> Result[PendingValue, CheckError]:
	head ?= inference_head(pending_type(current), slots, name.span)
	occurrence_result: Result[RecordOccurrence, CheckError] = match record_occurrence(head):
		Some(value): Ok(value)
		None:
			match publish_inference_type(head, slots, DiagnosticInference, name.span):
				Ok(actual): Err(record_error(name.span, FieldRequiresRecord(actual)))
				Err(error): Err(error)
	occurrence ?= occurrence_result
	field ?= resolve_record_field(name, occurrence.owner, context)
	accepted ?= context.records.get(record_number(occurrence.owner)).to_result(checker_invariant(name.span, InvalidRecordDeclaration(occurrence.owner)))
	annotation = field.value_type
	value_type ?= apply_type_hint(annotation.value_type, accepted.type_parameters, record_argument_hints(occurrence.arguments)).to_result(checker_invariant(name.span, InvalidRecordField(field.id)))
	Ok({ current | operations = PendingOperationLink({ operation = AcceptedField(field.id), value_type = value_type, span = name.span }, current.operations) })


private pure func placed_arguments(arguments: List[PendingValue], placement: CallPlacement, span: Span) -> List[InferenceUse]:
	values = pending_arguments(arguments)

	match placement:
		ReceiverPlacement(receiver, _):
			actual: InferenceUse = { value_type = pending_type(receiver), span = span }
			[actual].concat(values)
		_: values


private pure func placed_readiness(arguments: List[PendingValue], placement: CallPlacement) -> InferenceReadiness:
	var readiness: InferenceReadiness = match placement:
		ReceiverPlacement(receiver, _): receiver.readiness
		_: ClosedInference

	for argument in arguments:
		match argument.readiness:
			DeferredInference:
				readiness = DeferredInference
				break
			ClosedInference: void

	readiness


private pure func finish_pending_call(call: PendingCall, arguments: List[PendingValue], placement: CallPlacement, slots: List[InferenceSlot]) -> Result[PendingValue, CheckError]:
	children = placed_readiness(arguments, placement)
	closed_result: Result[Option[TypeRef], CheckError] = match children:
		DeferredInference: Ok(None)
		ClosedInference:
			match call_inference_ready(call, slots):
				Ok(complete):

					if complete:
						match admit_call_parameters(call, slots):
							Ok(parameters):
								match admit_call_type(call.signature.return_type.value_type, call, slots, call.span):
									Ok(return_type): validate_complete_arguments(call, parameters, return_type, placed_arguments(arguments, placement, call.span), slots).map(pure func(value): Some(value))
									Err(error): Err(error)
							Err(error): Err(error)
					else:
						Ok(None)
				Err(error): Err(error)
	accepted ?= closed_result
	readiness: InferenceReadiness = match accepted:
		Some(_): ClosedInference
		None: DeferredInference

	-- Reuse the result already published for Closed-call validation. Deferred
	-- descendants keep their original terms and child-first diagnostic ordering.
	value_type: InferenceType = match accepted:
		Some(value): AcceptedType(value)
		None: inference_type(call.signature.return_type.value_type, call.signature.type_parameters, call.variable_start)

	match placement:
		ReturnPlacement(base_span, span):
			Ok({ span = span, readiness = readiness, base = PendingDirectCall(call, arguments), base_type = value_type, base_span = base_span, operations = NoPendingOperations })
		ReceiverPlacement(receiver, span):
			Ok({ receiver | readiness = readiness, operations = PendingOperationLink({ operation = PendingInvocation(call, arguments), value_type = value_type, span = span }, receiver.operations) })


private pure func elaborate_value(
	initial_scope: List[ScopedValue],
	body: ValueExpression,
	constructor_type: Option[TypeRef],
	result_context: Option[CallResultContext],
	initial_site: ExpressionSite,
	initial_lambdas: List[LambdaRow],
) -> Result[CheckedValueResult, CheckError]:
	assumptions ?= site_requirements(initial_site, body.span)
	var scope = initial_scope
	var site = initial_site
	construction = site_construction(initial_site)
	var bindings: List[BindingDefinition] = []
	var lambdas = initial_lambdas
	var lambda_work: List[LambdaWork] = []
	var context_work: List[ContextWork] = []
	var inference_revision = 0
	var slots: List[InferenceSlot] = []
	var work: List[Option[ExpressionWork]] = [Some(FinishRoot), Some(EnterExpression(body, constructor_type.map(pure func(value): inference_type(value, [], 0))))]
	var work_count = 2
	var operands: List[Option[PendingValue]] = []
	var operand_count = 0
	var result_state: ResultInferenceState = NoResultInference
	var accepted: Option[CheckedExpr] = None
	var failure: Option[CheckError] = None

	while and(work_count.greater_than(0), failure.is_none()):
		work_count = work_count.subtract(1)
		next = work.get(work_count)
		work = work.set(work_count, None)

		match next:
			Some(Some(action)):
				match action:
					EnterCallable(written, hint):
						match written.base:
							LambdaExpression(lambda):
								match body_context(site, written.span):
									Err(error): failure = Some(error)
									Ok(context):
										id = lambda_id(lambdas.length())
										match admit_lambda(id, lambda, hint, scope, context, slots, written.applications):
											Err(error): failure = Some(error)
											Ok(admitted):
												lambdas = lambdas.append(CollectingLambda({ parent = context.caller.body, captures = [] }))
												lambda_work = lambda_work.append(AwaitingLambda(admitted.admission))
												inference_revision = inference_revision.add(1)
												value: PendingValue = { span = written.span, readiness = DeferredInference, base = PendingLambda(id),
													base_type = admitted.value_type, base_span = written.base_span, operations = NoPendingOperations }
												operands = push_operand(operands, operand_count, value)
												operand_count = operand_count.add(1)
												var position = admitted.constraints.length()
												while position.greater_than(0):
													position = position.subtract(1)
													match admitted.constraints.get(position):
														None: failure = Some(checker_invariant(written.span, InvalidInferenceWorklist))
														Some(equality):
															work = push_expression_work(work, work_count, SolveConstraint(equality))
															work_count = work_count.add(1)

							_:
								match resolve_callable_operand(written, scope, site, slots.length()):
									Err(error): failure = Some(error)
									Ok(StoredCallableOperand):
										work = push_expression_work(work, work_count, EnterExpression(written, hint))
										work_count = work_count.add(1)
									Ok(KnownCallableOperand(value)):
										match value.base:
											PendingNamedCallable(_, signature, _):
												for parameter in signature.type_parameters:
													slots = slots.append({ parameter = parameter, call_span = written.span, first_argument = None, state = UnboundVariable(0) })
											PendingMethodCallable(_, signature, _):
												for parameter in signature.type_parameters:
													slots = slots.append({ parameter = parameter, call_span = written.span, first_argument = None, state = UnboundVariable(0) })
											_: void
										match callable_permission(value, hint, slots):
											Ok(viewed):
												operands = push_operand(operands, operand_count, viewed)
												operand_count = operand_count.add(1)
											Err(error): failure = Some(error)
					EnterExpression(written, hint):
						match expression_postfixes(scope, written, site):
							Err(error): failure = Some(error)
							Ok(resolved):
								var postfixes: List[PendingPostfix] = []

								for postfix in resolved:
									match postfix:
										ReadIndex(index, span): postfixes = postfixes.append(PendingTupleIndex(index, span))
										ReadField(name): postfixes = postfixes.append(PendingField(name))
										InvokeReceiver(application, receiver):
											match receiver:
												ReceiverCandidates(candidates): postfixes = postfixes.append(PendingOverloadInvocation(application, candidates))
												UniqueReceiver(contract):
													match static_pending_call(contract, slots.length()):
														Err(error): failure = Some(error)
														Ok(call):
															for parameter in contract.signature.type_parameters:
																slots = slots.append({ parameter = parameter, call_span = contract.span, first_argument = None, state = UnboundVariable(0) })
															postfixes = postfixes.append(PendingReceiverInvocation(application, call))

