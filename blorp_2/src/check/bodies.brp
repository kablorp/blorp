---
Checks function bodies: parameter scope, ordered statements, match arms
and patterns, and the canonical Void tail.
---
import:
	./errors:
		CheckError, RecursionError(CallableTailRecursionUnsupported, GenericTailRecursionUnsupported), recursion_error,
		CheckerInvariant(InvalidCheckedUnion, InvalidResolvedParameter, UnsupportedPatternReachedResolution, LoopControlOutsideLoop, JoinWithoutArms),
		ExpectedTypeSite(FirstArmValue, InferredBindingDeclaration, SourceAnnotation),
		MatchError(
			ArmWithoutValue, MatchRequiresUnion, NonExhaustiveMatch, PatternFieldCountMismatch, BarePatternName,
			UnknownConstructorPattern, UnreachableArm,
		),
		StatementError(CallableAssignment, ImmutableAssignment, NonVoidMatchArm, NonVoidStatement),
		checker_invariant,
		match_error,
		statement_error,
		UnsupportedForm(
			LocalAnnotation, NestedPattern, OrPattern, ListPattern, StringPattern, CharPattern, QualifiedPattern, Propagation,
			WhileStatement, ForStatement,
		),
		unsupported_form,
	./callables: ResolutionContext
	./model:
		CheckedConstant,
		BindingDefinition,
		BindingId,
		BindingMutability(Immutable, Mutable),
		BindingOrigin(BodyLocal, MatchCapture, ParameterBinding),
		CallTarget(RuntimeFunction),
		CheckedArm,
		CheckedBody(CheckedMatchBody, CheckedValueBody),
		CheckedExit(RecurWith, ReturnExpression),
		CheckedJoin,
		CheckedJoinArm,
		CheckedExpr,
		CheckedForm(InvokeFunction, LiteralVoid, Match, ReadBinding),
		CheckedFunction,
		CheckedMatch,
		CheckedPattern(VariantCase, WildcardCase),
		CheckedStatement(DiscardExpression, InitializeBinding, ReassignBinding),
		TypeRef(PureCallableType, VoidType),
		TypeUse,
		UnionOccurrence,
		callable_parameter,
		binding_id,
		binding_number,
		has_callable_parameters,
		same_type,
		same_variant,
		union_occurrence,
	./recursion: check_execution
	./signatures: AcceptedBody(BuiltinBody, MatchBody, ValueBody), AcceptedFunction
	./declarations: CheckedDeclarations
	./constructors: VariantContract, find_variant
	./expressions: check_value, synthesize_value
	./scope: ScopedValue(DataLocal, CallableLocal), LocalBinding, bind_callable, callable_binding_id, bind_local, binding_site, binding_definition, local_binding_id, lookup_binding
	../utils/ids: VariantId, union_number
	int as IntOps
	list: repeat, set
	../namespace/namespace: Namespace
	option: is_some, to_result
	../utils/syntax:
		BindingSyntax(ImmutableBinding, MutableBinding),
		ParsedBinding,
		ExpressionBase(MatchExpression),
		ParsedMatch,
		ParsedMatchArm,
		ParsedParameter,
		ParsedPattern(PatternName, PatternWildcard, PatternConstructor, PatternOr, PatternList, PatternString, PatternChar),
		PatternHead(BareHead, QualifiedHead),
		pattern_span,
		ParsedStatement(BindingStatement, PropagatingBinding, ExpressionStatement, WhileLoop, ForLoop, Break, Continue),
		type_span,
		Span,
		ValueExpression,
		WrittenName,


private fixed record ResolvedPattern {
	pattern: CheckedPattern,
	scope: List[ScopedValue],
	bindings: List[BindingDefinition]
}


-- A pattern that binds nothing new.
private pure func unbound(pattern: CheckedPattern, scope: List[ScopedValue]) -> ResolvedPattern:
	{
		pattern = pattern,
		scope = scope,
		bindings = []
	}


-- A visible constructor in a field is a nested pattern; a missing import
-- is diagnosed by find_variant before a field can be accepted as a binding.
private pure func names_a_field_constructor(
	name: WrittenName,
	field_type: TypeRef,
	context: ResolutionContext,
) -> Result[Bool, CheckError]:
	match union_occurrence(field_type):
		None:
			Ok(False)
		Some(occurrence):
			match find_variant(context, occurrence, name):
				Ok(found): Ok(found.is_some())
				Err(error): Err(error)


private pure func resolve_variant_pattern(
	contract: VariantContract,
	fields: List[ParsedPattern],
	span: Span,
	ordinal: Int,
	scope: List[ScopedValue],
	context: ResolutionContext,
) -> Result[ResolvedPattern, CheckError]:
	if not IntOps.equals(contract.fields.length(), fields.length()):
		Err(match_error(span, PatternFieldCountMismatch(contract.variant, contract.fields.length(), fields.length())))
	else:
		var bindings: List[BindingDefinition] = []
		var captures: List[Option[BindingId]] = []
		var field_scope = scope
		var position = 0
		var failure: Option[CheckError] = None
		for field in fields:
			match contract.fields.get(position):
				None: failure = Some(checker_invariant(span, GenericConstructorContract))
				Some(annotation):
					-- A field is one binder or wildcard; the match's pre-scan rejected
					-- anything deeper before resolution.
					match field:
						PatternWildcard(_): captures = captures.append(None)
						PatternName(name):
							match names_a_field_constructor(name, annotation.value_type, context):
								Err(error):
									failure = Some(error)
									break
								Ok(True):
									failure = Some(unsupported_form(name.span, NestedPattern))
									break
								Ok(False):
									void
							id = binding_id(IntOps.add(ordinal, bindings.length()))
							definition: BindingDefinition = {
								origin = MatchCapture,
								mutability = Immutable,
								value_type = annotation.value_type,
								span = name.span,
							}
							match bind_local(field_scope, context.namespace, context.module, context.caller.function, name, id, definition):
								Ok(binding): field_scope = field_scope.append(binding)
								Err(error):
									failure = Some(error)
									break
							bindings = bindings.append(definition)
							captures = captures.append(Some(id))
						_:
							failure = Some(checker_invariant(pattern_span(field), UnsupportedPatternReachedResolution))
							break
			if failure.is_some():
				break
			position = IntOps.add(position, 1)
		match failure:
			Some(error): Err(error)
			None:
				Ok({
					pattern = VariantCase(contract.variant, captures),
					scope = field_scope,
					bindings = bindings,
				})


-- What every arm of one match shares: the scrutinee's union type and
-- occurrence and the scope before the match.
private fixed record MatchContext {
	union_type: TypeRef,
	occurrence: UnionOccurrence,
	scope: List[ScopedValue]
}


-- A whole-arm name denotes a visible constructor; only `_` catches everything.
private pure func resolve_pattern(
	pattern: ParsedPattern,
	match_context: MatchContext,
	ordinal: Int,
	context: ResolutionContext,
) -> Result[ResolvedPattern, CheckError]:
	scope = match_context.scope

	match pattern:
		PatternWildcard(_):
			Ok(unbound(WildcardCase, scope))
		PatternName(name):
			match find_variant(context, match_context.occurrence, name):
				Ok(Some(contract)): resolve_variant_pattern(contract, [], name.span, ordinal, scope, context)
				Ok(None): Err(match_error(name.span, BarePatternName(name.id, match_context.union_type)))
				Err(error): Err(error)
		PatternConstructor(head, fields, span):
			match head:
				BareHead(name):
					match find_variant(context, match_context.occurrence, name):
						Ok(Some(contract)): resolve_variant_pattern(contract, fields, span, ordinal, scope, context)
						Ok(None): Err(match_error(span, UnknownConstructorPattern(name.id, match_context.union_type)))
						Err(error): Err(error)
				QualifiedHead(_): Err(checker_invariant(span, UnsupportedPatternReachedResolution))
		PatternOr(_, span):
			Err(checker_invariant(span, UnsupportedPatternReachedResolution))
		PatternList(_, _, span):
			Err(checker_invariant(span, UnsupportedPatternReachedResolution))
		PatternString(_, span):
			Err(checker_invariant(span, UnsupportedPatternReachedResolution))
		PatternChar(span):
			Err(checker_invariant(span, UnsupportedPatternReachedResolution))


private pure func remaining_after(
	pattern: CheckedPattern,
	remaining: List[VariantId],
	span: Span,
) -> Result[List[VariantId], CheckError]:
	var next: List[VariantId] = []
	var useful = False

	match pattern:
		VariantCase(id, _):
			for known in remaining:
				if same_variant(id, known):
					useful = True
				else:
					next = next.append(known)
		WildcardCase:
			useful = not IntOps.equals(remaining.length(), 0)

	if useful:
		Ok(next)
	else:
		Err(match_error(span, UnreachableArm))


private fixed record ResolvedMatch {
	body: CheckedMatch,
	bindings: List[BindingDefinition]
}


-- Arms resolved so far, the variants they leave uncovered and the function's
-- bindings including every earlier arm's.
private fixed record ArmProgress {
	arms: List[CheckedArm],
	remaining: List[VariantId],
	bindings: List[BindingDefinition]
}


-- The first pattern form in the arms that has no semantics yet, arms in
-- order and left to right, before the scrutinee is typed: a list pattern on
-- a List scrutinee is then reported as the form, not as a non-union match.
-- A constructor's fields are scanned one level down; a deeper pattern there
-- is a nested pattern.
private pure func unsupported_pattern_form(arms: List[ParsedMatchArm]) -> Option[CheckError]:
	var failure: Option[CheckError] = None

	for arm in arms:
		if failure.is_none():
			failure = pattern_form_rejection(arm.pattern)

	failure


private pure func pattern_form_rejection(pattern: ParsedPattern) -> Option[CheckError]:
	match pattern:
		PatternName(_) | PatternWildcard(_):
			None
		PatternConstructor(QualifiedHead(_), _, span):
			Some(unsupported_form(span, QualifiedPattern))
		PatternConstructor(BareHead(_), fields, _):
			var failure: Option[CheckError] = None

			for field in fields:
				if failure.is_none():
					failure = match field:
						PatternName(_) | PatternWildcard(_):
							None
						PatternConstructor(_, _, _) | PatternOr(_, _) | PatternList(_, _, _) | PatternString(_, _) | PatternChar(_):
							Some(unsupported_form(pattern_span(field), NestedPattern))

			failure
		PatternOr(_, span):
			Some(unsupported_form(span, OrPattern))
		PatternList(_, _, span):
			Some(unsupported_form(span, ListPattern))
		PatternString(_, span):
			Some(unsupported_form(span, StringPattern))
		PatternChar(span):
			Some(unsupported_form(span, CharPattern))


-- A match's typed scrutinee, its arms' shared context and every variant
-- its arms must cover.
private fixed record StartedMatch {
	scrutinee: CheckedExpr,
	match_context: MatchContext,
	remaining: List[VariantId]
}


private pure func start_match(
	scope: List[ScopedValue],
	body: ParsedMatch,
	context: ResolutionContext,
) -> Result[StartedMatch, CheckError]:
	supported ?= match unsupported_pattern_form(body.arms):
		Some(error): Err(error)
		None: Ok(void)
	scrutinee ?= synthesize_value(scope, body.scrutinee, None, context)
	occurrence ?= union_occurrence(
		scrutinee.value_type,
	).to_result(match_error(body.scrutinee.span, MatchRequiresUnion(scrutinee.value_type)))
	declaration ?= context.unions
		.get(union_number(occurrence.owner))
		.to_result(checker_invariant(body.keyword_span, InvalidCheckedUnion(occurrence.owner)))
	var remaining: List[VariantId] = []

	for variant in declaration.variants:
		remaining = remaining.append(variant.id)

	Ok({
		scrutinee = scrutinee,
		match_context = {
			union_type = scrutinee.value_type,
			occurrence = occurrence,
			scope = scope
		},
		remaining = remaining,
	})


private pure func exhaustive(remaining: List[VariantId], body: ParsedMatch) -> Result[Void, CheckError]:
	if remaining.is_empty():
		Ok(void)
	else:
		Err(match_error(body.keyword_span, NonExhaustiveMatch(remaining)))


-- One arm's pattern and statements, the variants still uncovered after it,
-- and the function's bindings including the arm's.
private fixed record ResolvedArmPrefix {
	pattern: CheckedPattern,
	remaining: List[VariantId],
	block: ResolvedStatements
}


private pure func resolve_arm_prefix(
	arm: ParsedMatchArm,
	match_context: MatchContext,
	remaining: List[VariantId],
	bindings: List[BindingDefinition],
	context: ResolutionContext,
) -> Result[ResolvedArmPrefix, CheckError]:
	pattern ?= resolve_pattern(arm.pattern, match_context, bindings.length(), context)
	uncovered ?= remaining_after(pattern.pattern, remaining, pattern_span(arm.pattern))
	definitions = bindings.concat(pattern.bindings)
	block ?= resolve_statements(
		arm.block.statements,
		{
			bindings = definitions,
			scope = pattern.scope,
			statements = [],
			reassigned = []
		},
		context,
	)
	Ok({ pattern = pattern.pattern, remaining = uncovered, block = block })


-- Every arm must be useful, and together the arms must cover every variant.
private pure func resolve_match(
	return_type: TypeUse,
	scope: List[ScopedValue],
	body: ParsedMatch,
	bindings: List[BindingDefinition],
	context: ResolutionContext,
) -> Result[ResolvedMatch, CheckError]:
	started ?= start_match(scope, body, context)
	resolved ?= resolve_arms(
		body.arms,
		started.match_context,
		return_type,
		{
			arms = [],
			remaining = started.remaining,
			bindings = bindings
		},
		context,
	)
	covered ?= exhaustive(resolved.remaining, body)
	Ok({
		body = {
			scrutinee = started.scrutinee,
			union_type = started.scrutinee.value_type,
			arms = resolved.arms
		},
		bindings = resolved.bindings,
	})


private pure func resolve_arms(
	written: List[ParsedMatchArm],
	match_context: MatchContext,
	return_type: TypeUse,
	progress: ArmProgress,
	context: ResolutionContext,
) -> Result[ArmProgress, CheckError]:
	match written.get(progress.arms.length()):
		None:
			Ok(progress)
		Some(arm):
			-- A tail arm has no continuation, so it may reassign any variable.
			match resolve_arm_prefix(arm, match_context, progress.remaining, progress.bindings, context):
				Ok(prefix):
					-- A tail match's arm must produce the function's value.
					match arm.block.value.to_result(match_error(arm.span, ArmWithoutValue)):
						Ok(body):
							match resolve_value(prefix.block, body, return_expectation(return_type), context):
								Ok(value):
									resolve_arms(
										written,
										match_context,
										return_type,
										{
											arms = progress.arms.append({
												pattern = prefix.pattern,
												statements = prefix.block.statements,
												body = ReturnExpression(value.value),
											}),
											remaining = prefix.remaining,
											bindings = value.bindings
										},
										context,
									)
								Err(error): Err(error)
						Err(error): Err(error)
				Err(error): Err(error)


-- What a block's value, an initializer or an expression statement must
-- produce. A bare match's arms take the expectation of the position it
-- stands in: a known type checks every arm; a statement requires Void, and
-- its arms may end with a statement; a Void function's tail discards each
-- arm's value, as it does a plain tail value. Only a new binding, or the
-- first arm of a match under one, has no expectation: there the first arm's
-- type decides the later arms'.
private fixed union ValueExpectation:
	UntypedValue
	CheckedAgainst(TypeRef, ExpectedTypeSite)
	StatementValue
	-- An arm of a statement match, or of a match nested as one's value.
	StatementArm
	-- A Void function's tail. The match there is Void; its arms keep their
	-- values' own types only until normalize_void_body discards them, after
	-- tail-recursion analysis has seen them at the tail. Like any tail arm,
	-- each arm still needs a value.
	VoidTail


-- A checked value with the function's bindings after it: a match's arms
-- add their captures and locals.
private fixed record ResolvedValue {
	value: CheckedExpr,
	bindings: List[BindingDefinition],
	reassigned: List[BindingId]
}


-- Arms resolved so far, the uncovered variants and what the next arm's
-- value must produce.
private fixed record JoinProgress {
	arms: List[CheckedJoinArm],
	remaining: List[VariantId],
	bindings: List[BindingDefinition],
	expectation: ValueExpectation,
	reassigned: List[BindingId]
}


private pure func return_expectation(return_type: TypeUse) -> ValueExpectation:
	-- Void tails have no expected value type: each expression is still fully
	-- checked, then its value is discarded after tail-recursion analysis.
	if same_type(return_type.value_type, VoidType):
		VoidTail
	else:
		CheckedAgainst(return_type.value_type, SourceAnnotation(return_type.span))


-- A bare match is the only expression resolved here rather than by the
-- expression planner, which rejects a match nested inside another expression.
private pure func bare_match(written: ValueExpression) -> Option[ParsedMatch]:
	match written.base:
		MatchExpression(matched):
			if written.applications.is_empty():
				Some(matched)
			else:
				None
		_:
			None


-- A block's final value, an initializer or an expression statement, in the
-- scope after `block`'s statements.
private pure func resolve_value(
	block: ResolvedStatements,
	written: ValueExpression,
	expectation: ValueExpectation,
	context: ResolutionContext,
) -> Result[ResolvedValue, CheckError]:
	match bare_match(written):
		Some(matched):
			resolve_join(block, matched, expectation, context)
		None:
			value_result: Result[CheckedExpr, CheckError] = match expectation:
				UntypedValue | VoidTail:
					synthesize_value(block.scope, written, None, context)
				CheckedAgainst(expected, site):
					check_value(block.scope, written, expected, site, context)
				StatementValue:
					statement_value(block.scope, written, ExpressionStatementValue, context)
				StatementArm:
					statement_value(block.scope, written, StatementMatchArmValue, context)
			match value_result:
				Ok(value): Ok({ value = value, bindings = block.bindings, reassigned = block.reassigned })
				Err(error): Err(error)


-- Non-final expression statements, and a statement match's arm values, must
-- have Void type.
-- Where a value must be Void: each position names its own rejection.
private fixed union VoidPosition:
	ExpressionStatementValue
	StatementMatchArmValue


private pure func statement_value(
	scope: List[ScopedValue],
	written: ValueExpression,
	position: VoidPosition,
	context: ResolutionContext,
) -> Result[CheckedExpr, CheckError]:
	value ?= synthesize_value(scope, written, None, context)
	if same_type(value.value_type, VoidType):
		Ok(value)
	else:
		rejection = match position:
			ExpressionStatementValue: NonVoidStatement(value.value_type)
			StatementMatchArmValue: NonVoidMatchArm(value.value_type)
		Err(statement_error(written.span, rejection))


-- A bound or statement match. Its arms resolve as a tail match's do, except
-- that each yields its value to the code after the match.
private pure func resolve_join(
	block: ResolvedStatements,
	body: ParsedMatch,
	expectation: ValueExpectation,
	context: ResolutionContext,
) -> Result[ResolvedValue, CheckError]:
	started ?= start_match(block.scope, body, context)
	-- A statement match's arms, and those of matches nested as their values,
	-- are statement arms.
	arm_expectation = match expectation:
		StatementValue | StatementArm: StatementArm
		UntypedValue | CheckedAgainst(_, _) | VoidTail: expectation
	resolved ?= resolve_join_arms(
		body.arms,
		started.match_context,
		{
			arms = [],
			remaining = started.remaining,
			bindings = block.bindings,
			expectation = arm_expectation,
			reassigned = []
		},
		context,
	)
	covered ?= exhaustive(resolved.remaining, body)
	decided: Result[TypeRef, CheckError] = match resolved.expectation:
		CheckedAgainst(expected, _): Ok(expected)
		StatementValue | StatementArm | VoidTail: Ok(VoidType)
		-- Only a match without arms leaves its type undecided.
		UntypedValue: Err(checker_invariant(body.keyword_span, JoinWithoutArms))
	value_type ?= decided
	carried: List[BindingId] = if resolved.reassigned.is_empty():
		[]
	else:
		carried_bindings(block, resolved.reassigned)
	Ok({
		value = {
			form = Match({
				scrutinee = started.scrutinee,
				union_type = started.scrutinee.value_type,
				arms = resolved.arms,
				carried = carried
			}),
			value_type = value_type,
			span = body.span,
		},
		bindings = resolved.bindings,
		reassigned = block.reassigned.concat(carried),
	})


private pure func resolve_join_arms(
	written: List[ParsedMatchArm],
	match_context: MatchContext,
	progress: JoinProgress,
	context: ResolutionContext,
) -> Result[JoinProgress, CheckError]:
	match written.get(progress.arms.length()):
		None:
			Ok(progress)
		Some(arm):
			match resolve_arm_prefix(
				arm,
				match_context,
				progress.remaining,
				progress.bindings,
				context,
			):
				Ok(prefix):
					resolved: Result[ResolvedValue, CheckError] = match arm.block.value:
						Some(body):
							resolve_value(prefix.block, body, progress.expectation, context)
						None:
							match progress.expectation:
								-- An arm of a statement match may end with a statement.
								StatementValue | StatementArm:
									Ok({
										value = { form = LiteralVoid, value_type = VoidType, span = arm.span },
										bindings = prefix.block.bindings,
										reassigned = prefix.block.reassigned,
									})
								UntypedValue | CheckedAgainst(_, _) | VoidTail:
									Err(match_error(arm.span, ArmWithoutValue))
					match resolved:
						Ok(value):
							expectation = match progress.expectation:
								UntypedValue:
									CheckedAgainst(value.value.value_type, FirstArmValue)
								CheckedAgainst(_, _) | StatementValue | StatementArm | VoidTail:
									progress.expectation
							resolve_join_arms(
								written,
								match_context,
								{
									arms = progress.arms.append({
										pattern = prefix.pattern,
										statements = prefix.block.statements,
										value = value.value,
									}),
									remaining = prefix.remaining,
									bindings = value.bindings,
									expectation = expectation,
									reassigned = progress.reassigned.concat(value.reassigned),
								},
								context,
							)
						Err(error): Err(error)
				Err(error): Err(error)


-- The signature was resolved from these parameters, one type each.
private pure func parameter_scope(
	parameters: List[ParsedParameter],
	types: List[TypeUse],
	scope: List[ScopedValue],
	context: ResolutionContext,
) -> Result[List[ScopedValue], CheckError]:
	var resolved = scope
	var data_ordinal = 0
	var position = 0
	var failure: Option[CheckError] = None
	for parameter in parameters:
		match types.get(position):
			None: failure = Some(checker_invariant(parameter.name.span, InvalidResolvedParameter(position)))
			Some(value_type):
				binding_result = match value_type.value_type:
					PureCallableType(parameters, result):
						bind_callable(
							resolved, context.namespace, context.module, context.caller.function,
							parameter.name, callable_parameter(context.caller.function, position),
							parameters, result, value_type.span,
						)
					_:
						definition: BindingDefinition = {
							origin = ParameterBinding(data_ordinal),
							mutability = Immutable,
							value_type = value_type.value_type,
							span = parameter.name.span
						}
						data_ordinal = IntOps.add(data_ordinal, 1)
						bind_local(
							resolved, context.namespace, context.module, context.caller.function,
							parameter.name, binding_id(IntOps.subtract(data_ordinal, 1)), definition,
						)
				match binding_result:
					Ok(binding): resolved = resolved.append(binding)
					Err(error): failure = Some(error)
		if failure.is_some():
			break
		position = IntOps.add(position, 1)
	match failure:
		Some(error): Err(error)
		None: Ok(resolved)


private fixed record ResolvedBody {
	bindings: List[BindingDefinition],
	statements: List[CheckedStatement],
	body: CheckedBody
}


-- A block's checked statements, the scope after them and the function's
-- bindings so far.
private fixed record ResolvedStatements {
	bindings: List[BindingDefinition],
	scope: List[ScopedValue],
	statements: List[CheckedStatement],
	reassigned: List[BindingId]
}


private fixed union JoinBindingState:
	OutsideJoinScope
	UntouchedJoinBinding
	ReassignedJoinBinding


-- Scope membership and write occurrences are already checked facts. This local
-- table filters arm locals and freezes each visible identity once, in ordinal
-- order even though the lexical lookup scope has most recent bindings first.
private pure func carried_bindings(entry: ResolvedStatements, written: List[BindingId]) -> List[BindingId]:
	var states = repeat(OutsideJoinScope, entry.bindings.length())
	for binding in entry.scope:
		match binding:
			DataLocal(data): states = states.set(binding_number(local_binding_id(data)), UntouchedJoinBinding)
			CallableLocal(_): void
	for id in written:
		position = binding_number(id)
		match states.get(position):
			Some(state):
				match state:
					UntouchedJoinBinding | ReassignedJoinBinding:
						states = states.set(position, ReassignedJoinBinding)
					OutsideJoinScope: void
			None: void
	var carried: List[BindingId] = []
	var ordinal = 0
	for state in states:
		match state:
			ReassignedJoinBinding: carried = carried.append(binding_id(ordinal))
			OutsideJoinScope | UntouchedJoinBinding: void
		ordinal = IntOps.add(ordinal, 1)
	carried


-- New bindings are validated once after their initializer is checked.
private pure func resolve_statements(
	written: List[ParsedStatement],
	block: ResolvedStatements,
	context: ResolutionContext,
) -> Result[ResolvedStatements, CheckError]:
	match written.get(block.statements.length()):
		None:
			Ok(block)
		Some(BindingStatement(binding)):
			match binding.annotation:
				Some(annotation): Err(unsupported_form(type_span(annotation), LocalAnnotation))
				None:
					match resolve_assignment(binding, block, context):
						Ok(next): resolve_statements(written, next, context)
						Err(error): Err(error)
		Some(PropagatingBinding(propagation)):
			Err(unsupported_form(propagation.span, Propagation))
		Some(WhileLoop(loop)):
			Err(unsupported_form(loop.span, WhileStatement))
		Some(ForLoop(loop)):
			Err(unsupported_form(loop.span, ForStatement))
		Some(Break(span)):
			Err(checker_invariant(span, LoopControlOutsideLoop))
		Some(Continue(span)):
			Err(checker_invariant(span, LoopControlOutsideLoop))
		Some(ExpressionStatement(expression)):
			match resolve_value(block, expression, StatementValue, context):
				Ok(resolved):
					resolve_statements(
						written,
						{ block |
							bindings = resolved.bindings,
							statements = block.statements.append(DiscardExpression(resolved.value)),
							reassigned = resolved.reassigned
						},
						context,
					)
				Err(error): Err(error)


private pure func resolve_assignment(
	written: ParsedBinding,
	block: ResolvedStatements,
	context: ResolutionContext,
) -> Result[ResolvedStatements, CheckError]:
	-- Existing assignment errors precede the RHS; an explicit var is a new declaration.
	decision: Result[Option[LocalBinding], CheckError] = match written.mutability:
		MutableBinding: Ok(None)
		ImmutableBinding:
			match lookup_binding(block.scope, written.name.id):
				None: Ok(None)
				Some(CallableLocal(binding)): Err(statement_error(written.name.span, CallableAssignment(callable_binding_id(binding))))
				Some(DataLocal(binding)):
					match binding_definition(binding).mutability:
						Mutable:
							Ok(Some(binding))
						Immutable:
							Err(statement_error(written.name.span, ImmutableAssignment(binding_site(context.caller.function, binding))))

	reassign ?= decision

	match reassign:
		Some(binding):
			site = InferredBindingDeclaration(binding_site(context.caller.function, binding))
			match resolve_value(block, written.initializer, CheckedAgainst(binding_definition(binding).value_type, site), context):
				Ok(resolved):
					Ok(
						{ block |
							bindings = resolved.bindings,
							statements = block.statements.append(ReassignBinding(local_binding_id(binding), resolved.value)),
							reassigned = resolved.reassigned.append(local_binding_id(binding))
						},
					)
				Err(error): Err(error)
		None:
			match resolve_value(block, written.initializer, UntypedValue, context):
				Ok(resolved):
					value = resolved.value

					mutability = match written.mutability:
						MutableBinding:
							Mutable
						ImmutableBinding:
							Immutable

					definition: BindingDefinition = {
						origin = BodyLocal,
						mutability = mutability,
						value_type = value.value_type,
						span = written.name.span
					}
					-- A match's arm captures and locals precede this binding's ordinal.
					id = binding_id(resolved.bindings.length())
					match bind_local(block.scope, context.namespace, context.module, context.caller.function, written.name, id, definition):
						Err(error): Err(error)
						Ok(binding):
							Ok({
								bindings = resolved.bindings.append(definition),
								scope = [binding].concat(block.scope),
								statements = block.statements.append(InitializeBinding(id, value)),
								reassigned = resolved.reassigned,
							})
				Err(error): Err(error)


private pure func resolve_body(
	accepted: AcceptedFunction,
	context: ResolutionContext,
) -> Result[ResolvedBody, CheckError]:
	signature = accepted.signature
	tail_decision: Result[Void, CheckError] = match accepted.declaration.tail_annotation:
		None: Ok(void)
		Some(annotation):
			if has_callable_parameters(signature):
				if signature.type_parameters.is_empty():
					Err(recursion_error(annotation, CallableTailRecursionUnsupported))
				else:
					Err(recursion_error(annotation, GenericTailRecursionUnsupported))
			else:
				Ok(void)
	tail_contract ?= tail_decision
	initial ?= parameter_scope(accepted.declaration.parameters, signature.parameters, [], context)
	var parameter_bindings: List[BindingDefinition] = []
	for binding in initial:
		match binding:
			DataLocal(data):
				definition = binding_definition(data)
				parameter_bindings = parameter_bindings.append(definition)
			CallableLocal(_): void
	prefix ?= resolve_statements(
		accepted.declaration.statements,
		{
			bindings = parameter_bindings,
			scope = initial,
			statements = [],
			reassigned = []
		},
		context,
	)

	match accepted.body:
		BuiltinBody(operation, span):
			-- Read the scope's actual binding identities, as ordinary parameter uses do.
			var arguments: List[CheckedExpr] = []
			for binding in initial:
				match binding:
					DataLocal(data):
						definition = binding_definition(data)
						arguments = arguments.append({
							form = ReadBinding(local_binding_id(data)),
							value_type = definition.value_type,
							span = definition.span
						})
					CallableLocal(_): void
			Ok({
				bindings = prefix.bindings,
				statements = prefix.statements,
				body = CheckedValueBody(ReturnExpression({
					form = InvokeFunction(
						{
							target = RuntimeFunction(operation),
							span = span
						},
						arguments,
					),
					value_type = signature.return_type.value_type,
					span = span,
				})),
			})
		ValueBody(body):
			match resolve_value(prefix, body, return_expectation(signature.return_type), context):
				Ok(value):
					Ok({
						bindings = value.bindings,
						statements = prefix.statements,
						body = CheckedValueBody(ReturnExpression(value.value)),
					})
				Err(error): Err(error)
		MatchBody(body):
			match resolve_match(
				signature.return_type,
				prefix.scope,
				body,
				prefix.bindings,
				context,
			):
				Ok(matched):
					Ok({
						bindings = matched.bindings,
						statements = prefix.statements,
						body = CheckedMatchBody(matched.body),
					})
				Err(error): Err(error)


-- Checks every function body in declaration order, including unreachable ones.
pure func resolve_functions(
	functions: List[AcceptedFunction],
	declarations: CheckedDeclarations,
	namespace: Namespace,
	constants: List[CheckedConstant],
) -> Result[List[CheckedFunction], CheckError]:
	check_functions(functions, declarations, namespace, constants, [])


private pure func check_functions(
	functions: List[AcceptedFunction],
	declarations: CheckedDeclarations,
	namespace: Namespace,
	constants: List[CheckedConstant],
	checked: List[CheckedFunction],
) -> Result[List[CheckedFunction], CheckError]:
	match functions.get(checked.length()):
		None:
			Ok(checked)
		Some(accepted):
			id = accepted.id
			context: ResolutionContext = {
				caller = {
					function = id,
					purity = accepted.signature.purity
				},
				module = accepted.declaration.module,
				namespace = namespace,
				signatures = functions,
				unions = declarations.unions,
				records = declarations.records,
				constants = constants,
			}
			signature = accepted.signature
			match resolve_body(accepted, context):
				Ok(body):
					match check_execution(accepted.declaration, body.statements, body.body, id):
						Ok(execution):

							executed: ResolvedBody = { body | body = execution.body }

							published = if same_type(signature.return_type.value_type, VoidType):
								normalize_void_body(executed)
							else:
								executed

							check_functions(
								functions,
								declarations,
								namespace,
								constants,
								checked.append({
									id = id,
									execution = execution.execution,
									signature = signature,
									bindings = published.bindings,
									statements = published.statements,
									body = published.body,
								}),
							)
						Err(error): Err(error)
				Err(error): Err(error)


private fixed record NormalizedVoidExit {
	statements: List[CheckedStatement],
	exit: CheckedExit
}


private pure func normalize_void_exit(
	statements: List[CheckedStatement],
	exit: CheckedExit,
) -> NormalizedVoidExit:
	match exit:
		RecurWith(_, _):
			{
				statements = statements,
				exit = exit
			}
		ReturnExpression(value):
			discarded = discard_tail_value(statements, value)
			{
				statements = discarded.statements,
				exit = ReturnExpression(discarded.value)
			}


-- A Void tail value after discarding: statements, then canonical void.
private fixed record DiscardedTail {
	statements: List[CheckedStatement],
	value: CheckedExpr
}


-- A match at a Void tail was resolved with VoidTail, so it is Void and its
-- arm values are tail values too: each is discarded the same way first.
private pure func discard_tail_value(statements: List[CheckedStatement], value: CheckedExpr) -> DiscardedTail:
	match value.form:
		LiteralVoid:
			{ statements = statements, value = value }
		_:
			{
				statements = statements.append(DiscardExpression(discard_arm_values(value))),
				value = { form = LiteralVoid, value_type = VoidType, span = value.span }
			}


private pure func discard_arm_values(value: CheckedExpr) -> CheckedExpr:
	match value.form:
		Match(join):
			var arms: List[CheckedJoinArm] = []
			for arm in join.arms:
				discarded = discard_tail_value(arm.statements, arm.value)
				arms = arms.append({ arm | statements = discarded.statements, value = discarded.value })
			{ value | form = Match({ join | arms = arms }) }
		_:
			value


-- A Void body's tails return canonical void after discarding their values.
private pure func normalize_void_body(resolved: ResolvedBody) -> ResolvedBody:
	match resolved.body:
		CheckedValueBody(exit):
			normalized = normalize_void_exit(resolved.statements, exit)
			{ resolved |
				statements = normalized.statements,
				body = CheckedValueBody(normalized.exit)
			}
		CheckedMatchBody(matched):
			arms = matched.arms.map(pure func(arm: CheckedArm) -> CheckedArm:
				normalized = normalize_void_exit(arm.statements, arm.body)
				{ arm |
					statements = normalized.statements,
					body = normalized.exit
				}
			)
			{ resolved | body = CheckedMatchBody({ matched | arms = arms }) }
