---
Admit complete receiver scopes before bodies are elaborated. Transient name-keyed
groups preserve rejection order and use introduction-route upper bounds. Each
unordered pair is checked once; only the exact inherited prelude subset reuses a proof.
---
import:
	option: Option methods
	bool: not, and
	./callables: accepted_function, candidate_span, method_site, receiver_functions, admit_method_family
	./errors: CheckError, CheckerInvariant(InvalidResolvedFunction, InvalidReceiverScope), MethodError(OverlappingReceivers), checker_invariant, method_error
	./inference: types_overlap
	./model: AcceptedTraits, ReceiverFunction, ReceiverLookup(VisibleMethod, VisibleFunctions), AdmittedReceiverScope, type_head
	./signatures: AcceptedFunction
	../namespace/namespace: Namespace, MethodImport, declared_function, method_imports, module_entries, offered_function, Entity(Method)
	../parse/assemble: ModuleImport, ParsedModuleRow
	../parse/parse: ImportSelection(NamedSelection)
	../utils/ids: FunctionId, function_number
	../utils/hash_map as HashMaps
	../utils/names: name_number
	../utils/source: module_number, ModuleKind(UserModule, FoundationPreludeModule)
	../utils/syntax: Span, WrittenName, compiler_span
	list: repeat, List methods
	int: Int methods


private fixed record IntroducedName {
	written: WrittenName,
	candidate_bound: Int
}


private pure func count_introduction(names: HashMaps.HashMap[Int, IntroducedName], written: WrittenName, inherited_count: Int) -> HashMaps.HashMap[Int, IntroducedName]:
	key = name_number(written.id)
	match HashMaps.get(names, key):
		None: HashMaps.set(names, key, { written = written, candidate_bound = inherited_count + 1 })
		Some(previous): HashMaps.set(names, key, { previous | candidate_bound = previous.candidate_bound + 1 })


private pure func name_counts(signatures: List[AcceptedFunction]) -> HashMaps.HashMap[Int, Int]:
	var counts: HashMaps.HashMap[Int, Int] = HashMaps.hash_map_with_capacity(signatures.length())
	for accepted in signatures:
		if accepted.signature.parameters.is_empty().not():
			key = name_number(accepted.declaration.function_name.id)
			counts = HashMaps.set(counts, key, HashMaps.get(counts, key).get_or(0) + 1)
	counts


-- Explicit function selections and the written suffix of the namespace's method
-- edges introduce candidates. The prelude prefix is already validated.
private pure func selected_receiver(request: ModuleImport, accepted: AcceptedFunction, methods: List[MethodImport], first_method: Int) -> Bool:
	var selected: Bool = False
	for selection in request.symbols:
		match selection:
			NamedSelection(written):
				if written.id == accepted.declaration.function_name.id:
					selected = True
			_: void
	match accepted.signature.parameters.get(0):
		None: void
		Some(parameter):
			match type_head(parameter.value_type):
				None: void
				Some(head):
					for position in first_method..methods.length():
						match methods.get(position):
							Some(edge):
								if and(edge.target == request.target, edge.receiver == head):
									selected = True
							None: void
	selected


private pure func introduced_names(namespace: Namespace, signatures: List[AcceptedFunction], counts: HashMaps.HashMap[Int, Int], row: ParsedModuleRow, first_method: Int, inherited: HashMaps.HashMap[Int, List[FunctionId]]) -> Result[HashMaps.HashMap[Int, IntroducedName], CheckError]:
	var names: HashMaps.HashMap[Int, IntroducedName] = HashMaps.empty_hash_map()
	none: List[FunctionId] = []
	var failure: Option[CheckError] = None
	for own_entry in module_entries(namespace, row.module):
		match declared_function(own_entry):
			None: void
			Some(own_id):
				match signatures.get(function_number(own_id)):
					None: failure = Some(checker_invariant(row.end, InvalidResolvedFunction(own_id)))
					Some(accepted):
						key = name_number(accepted.declaration.function_name.id)
						if and(accepted.signature.parameters.is_empty().not(), HashMaps.get(counts, key).get_or(0) > 1):
							names = count_introduction(names, accepted.declaration.function_name, HashMaps.get(inherited, key).get_or(none).length())
	methods = method_imports(namespace, row.module)
	for request in row.imports:
		for provider_entry in module_entries(namespace, request.target):
			match offered_function(provider_entry):
				None: void
				Some(offered_id):
					match signatures.get(function_number(offered_id)):
						None: failure = Some(checker_invariant(request.span, InvalidResolvedFunction(offered_id)))
						Some(accepted):
							key = name_number(accepted.declaration.function_name.id)
							if and(accepted.signature.parameters.is_empty().not(), HashMaps.get(counts, key).get_or(0) > 1):
								provided_ids = HashMaps.get(inherited, key).get_or(none)
								receiver_selected = match is_inherited(accepted.id, provided_ids).not():
									True: selected_receiver(request, accepted, methods, first_method)
									False: False

								if receiver_selected:
									names = count_introduction(names, accepted.declaration.function_name, provided_ids.length())
	match failure:
		Some(invariant): Err(invariant)
		None: Ok(names)


private pure func is_inherited(id: FunctionId, inherited: List[FunctionId]) -> Bool:
	var found: Bool = False
	for supplied in inherited:
		if id == supplied:
			found = True
			break
	found


private pure func reject_pair(name: WrittenName, left: ReceiverFunction, right: ReceiverFunction, inherited: List[FunctionId], signatures: List[AcceptedFunction]) -> Result[Void, CheckError]:
	left_function ?= accepted_function(name.span, left.id, signatures)
	right_function ?= accepted_function(name.span, right.id, signatures)
	left_inherited = and(inherited.is_empty().not(), is_inherited(left.id, inherited))
	right_inherited = and(inherited.is_empty().not(), is_inherited(right.id, inherited))
	if and(left_inherited, right_inherited):
		Ok(void)
	else:
		introduced = if right_inherited:
			left
		else:
			right
		other = if right_inherited:
			right
		else:
			left
		introduced_function = if right_inherited:
			left_function
		else:
			right_function
		other_function = if right_inherited:
			right_function
		else:
			left_function
		span = candidate_span(introduced, introduced_function.declaration.function_name.span)
		match introduced_function.signature.parameters.get(0):
			None: Ok(void)
			Some(introduced_parameter):
				match other_function.signature.parameters.get(0):
					None: Ok(void)
					Some(other_parameter):
						match types_overlap(other_parameter.value_type, other_function.signature.type_parameters, introduced_parameter.value_type, introduced_function.signature.type_parameters, span):
							Err(invariant): Err(invariant)
							Ok(False): Ok(void)
							Ok(True): Err(method_error(span, OverlappingReceivers(name.id, {
								introduced = method_site(introduced, introduced_function.declaration.function_name.span), introduced_receiver = introduced_parameter.value_type,
								other = method_site(other, other_function.declaration.function_name.span), other_receiver = other_parameter.value_type
							})))


private pure func reject_group(name: WrittenName, candidates: List[ReceiverFunction], inherited: List[FunctionId], signatures: List[AcceptedFunction]) -> Result[Void, CheckError]:
	var failure: Option[CheckError] = None
	var right_position = 0
	for right_candidate in candidates:
		var left_position = 0
		for left_candidate in candidates:
			if left_position == right_position:
				break
			match reject_pair(name, left_candidate, right_candidate, inherited, signatures):
				Ok(_): void
				Err(clash): failure = Some(clash)
			if failure.is_some():
				break
			left_position = left_position + 1
		if failure.is_some():
			break
		right_position = right_position + 1
	match failure:
		Some(clash): Err(clash)
		None: Ok(void)


-- Dependency order proves inherited overlap pairs first; the published table
-- uses module ordinals, which need not follow that order.
pure func admit_receivers(namespace: Namespace, signatures: List[AcceptedFunction], module_count: Int, modules: List[ParsedModuleRow], traits: AcceptedTraits) -> Result[List[AdmittedReceiverScope], CheckError]:
	counts = name_counts(signatures)
	unprovided: HashMaps.HashMap[Int, List[FunctionId]] = HashMaps.empty_hash_map()
	var supplied = unprovided
	var supplied_methods = 0
	var pending: List[Option[AdmittedReceiverScope]] = repeat(None, module_count)
	var failure: Option[CheckError] = None
	for row in modules:
		position = module_number(row.module)
		match pending.get(position):
			Some(None): void
			_:
				failure = Some(checker_invariant(row.end, InvalidReceiverScope))
				break
		var admitted: HashMaps.HashMap[Int, ReceiverLookup] = HashMaps.empty_hash_map()
		match receiver_functions(namespace, signatures, row.module):
			Err(error): failure = Some(error)
			Ok(names): admitted = names
		if failure.is_some():
			break
		-- Preserve the existing family-before-overlap order and both name orders.
		if traits.declarations.is_empty().not():
			match admit_module_families(namespace, traits, signatures, row, admitted):
				Err(error): failure = Some(error)
				Ok(names): admitted = names
			if failure.is_some():
				break
		first_method = match row.role:
			UserModule: supplied_methods
			_: 0
		inherited_names = match row.role:
			UserModule: supplied
			_: unprovided
		match introduced_names(namespace, signatures, counts, row, first_method, inherited_names):
			Err(invariant): failure = Some(invariant)
			Ok(names):
				for introduction in HashMaps.values(names):
					publishes_prelude: Bool = match row.role:
						FoundationPreludeModule: True
						_: False
					if and(publishes_prelude.not(), introduction.candidate_bound == 1):
						continue
					written = introduction.written
					key = name_number(written.id)
					match HashMaps.get(admitted, key):
						Some(VisibleFunctions(candidates)):
							none: List[FunctionId] = []
							inherited = HashMaps.get(inherited_names, key).get_or(none)
							match reject_group(written, candidates, inherited, signatures):
								Err(clash): failure = Some(clash)
								Ok(_): void
							match row.role:
								FoundationPreludeModule:
									var provided_ids: List[FunctionId] = []
									for candidate in candidates:
										if candidate.import_site.is_some():
											provided_ids = provided_ids.append(candidate.id)
									supplied = HashMaps.set(supplied, key, provided_ids)
								_: void
						Some(VisibleMethod(_)) | None: void
					if failure.is_some():
						break
		if failure.is_some():
			break
		pending = pending.set(position, Some({ names = admitted }))
		match row.role:
			FoundationPreludeModule: supplied_methods = method_imports(namespace, row.module).length()
			_: void
		if failure.is_some():
			break
	var scopes: List[AdmittedReceiverScope] = []
	for scope in pending:
		if failure.is_some():
			break
		match scope:
			Some(admitted): scopes = scopes.append(admitted)
			None: failure = Some(checker_invariant(compiler_span(), InvalidReceiverScope))
	match failure:
		Some(clash): Err(clash)
		None: Ok(scopes)


-- `names` with `name`, unless it holds the name already: the first
-- occurrence keeps its place and span.
private pure func with_receiver_name(names: HashMaps.HashMap[Int, WrittenName], name: WrittenName) -> HashMaps.HashMap[Int, WrittenName]:
	match HashMaps.get(names, name_number(name.id)):
		Some(_): names
		None: HashMaps.set(names, name_number(name.id), name)


-- Family clashes do not depend on a future receiver type or an actual call.
-- Query receiver visibility at admission, including type imports,
-- once per name: the answer depends only on the module and the name, and each
-- method edge to one target lists that target's names again.
private pure func admit_module_families(namespace: Namespace, traits: AcceptedTraits, signatures: List[AcceptedFunction], row: ParsedModuleRow, functions: HashMaps.HashMap[Int, ReceiverLookup]) -> Result[HashMaps.HashMap[Int, ReceiverLookup], CheckError]:
	var names: HashMaps.HashMap[Int, WrittenName] = HashMaps.empty_hash_map()
	for entry in module_entries(namespace, row.module):
		match entry.entity:
			Method(_): names = with_receiver_name(names, entry.name)
			_: void
	for imported in method_imports(namespace, row.module):
		for entry in module_entries(namespace, imported.target):
			match entry.entity:
				Method(_): names = with_receiver_name(names, entry.name)
				_: void
	var admitted = functions
	var failure: Option[CheckError] = None
	for name in HashMaps.values(names):
		ordinary: Result[List[ReceiverFunction], CheckError] = match HashMaps.get(admitted, name_number(name.id)):
			Some(VisibleFunctions(candidates)): Ok(candidates)
			None: Ok([])
			Some(VisibleMethod(_)): Err(checker_invariant(name.span, InvalidReceiverScope))
		match ordinary:
			Err(error): failure = Some(error)
			Ok(candidates):
				match admit_method_family(namespace, traits, signatures, row.module, name, candidates):
					Err(error): failure = Some(error)
					Ok(VisibleFunctions(_)): void
					Ok(lookup): admitted = HashMaps.set(admitted, name_number(name.id), lookup)
		if failure.is_some():
			break
	match failure:
		Some(error): Err(error)
		None: Ok(admitted)
