import:
	../utils/boolean: not
	../namespace/builtins: builtin_type_name, render_builtin_type_error, runtime_declaration_help
	./check: CheckFailure, check_errors, failure_program, failure_functions
	./signatures: AcceptedFunction
	./errors as Errors
	./model as Check
	../utils/ids:
		VariantId, trait_method_header, inventory_traits, trait_number, trait_method_owner, trait_method_number,
		constant_number,
		inventory_constants,
		inventory_functions,
		inventory_opaques,
		inventory_records,
		inventory_unions,
		function_number,
		opaque_number,
		record_number,
		union_number,
		variant_number,
		variant_owner,
	int as IntOps
	../parse/parse: ImportOrigin(RelativeImport, LibraryImport), ImportSelection(NamedSelection, ConstructorSelection, MethodsOnlySelection), ModulePath, selection_name
	../utils/names: NameId, NameTable, name_spelling
	../namespace/namespace:
		builtin_head,
		Conflict,
		Entity(Trait, Method, Function, Constant, Constructor, Type, Alias),
		NamespaceProblem(InvalidTraitInventory, InvalidImplementationTrait, NameConflict, SelectionFailure),
		Origin(Declared, Imported, Implicit),
		SelectionProblem(NotOffered, AlreadyFromPrelude, AlreadyImported, AmbiguousFunction, AmbiguousConstant, BareConstructor, NotAConstructor, ReceiverNotVisible),
		TypeHead(UnionHead, RecordHead, OpaqueHead),
		ValueBinding(MethodName, FunctionName, ConstantName, ConstructorName, ModuleAliasName),
		Unoffered(UnknownName, PrivateName, ImportedThere, ProvidedThere),
		same_head,
	option: to_result, map
	result as ResultOps: and_then
	../parse/assemble: ParsedContents, ParsedProgram, parsed_contents
	../utils/syntax:
		Purity(Pure, Impure),
		CallNotation(DirectCall, ReceiverCall),
		Diagnostic,
		DiagnosticNote(
			TypeDeclaration, UnionPayloadDeclaration, RecordFieldDeclaration, PreviousField, PreviousDeclaration,
			CompetingDeclarations, Declaration, NoteLines,
		),
		Diagnostics,
		ParsedBuiltinType(IntegerBuiltin, FloatBuiltin, StringBuiltin, VoidBuiltin, ListBuiltin),
		Span, type_span, NoteLine, WrittenName, same_span,
	../utils/text as Text: concat


private fixed record RenderContext {
	parsed: ParsedContents,
	functions: List[AcceptedFunction]
}


pure func render_failure(failure: CheckFailure) -> Diagnostics:
	render_errors(failure_program(failure), check_errors(failure), failure_functions(failure))


pure func render_check_errors(program: ParsedProgram, errors: Errors.CheckErrors) -> Diagnostics:
	render_errors(program, errors, [])


private pure func render_errors(program: ParsedProgram, errors: Errors.CheckErrors, functions: List[AcceptedFunction]) -> Diagnostics:
	context: RenderContext = { parsed = parsed_contents(program), functions = functions }
	var remaining: List[Diagnostic] = []
	for error in errors.remaining:
		remaining = remaining.append(render_context_error(context, error))
	{ first = render_context_error(context, errors.first), remaining = remaining }


private pure func invariant_message(invariant: Errors.CheckerInvariant) -> String:
	match invariant:
		Errors.InvalidRecordDeclaration(_):
			"invalid record declaration"
		Errors.InvalidOpaqueDeclaration(_):
			"invalid opaque declaration"
		Errors.InvalidConstantDeclaration(_):
			"invalid constant declaration"
		Errors.InvalidResolvedFunction(_):
			"invalid resolved function identity"
		Errors.InvalidUnionDeclaration(_):
			"invalid union declaration"
		Errors.InvalidResolvedUnion(_):
			"invalid resolved union identity"
		Errors.InvalidCheckedUnion(_):
			"invalid checked union identity"
		Errors.InvalidResolvedVariant(_):
			"invalid resolved variant identity"
		Errors.InvalidParameterDeclaration(_):
			"invalid parameter declaration"
		Errors.InvalidParameterName(_):
			"invalid parameter name"
		Errors.ParameterOwnerWithoutParameter(_):
			"parameter owner has no parameter"
		Errors.InvalidParsedName(_):
			"invalid parsed name identity"
		Errors.RuntimeContractMismatch:
			"builtin operation disagrees with its runtime contract"
		Errors.InvalidResolvedParameter(_):
			"invalid resolved parameter"
		Errors.GenericConstructorContract:
			"generic constructor contract"
		Errors.InvalidInferenceVariable(_):
			"invalid inference variable"
		Errors.InvalidInferenceWorklist:
			"invalid inference worklist"
		Errors.InvalidDeclarationVisit:
			"invalid declaration visit"
		Errors.InvalidRecordField(_):
			"invalid record field"
		Errors.VariantOccurrenceWithoutUnion(_):
			"variant occurrence without union"
		Errors.DirectCallInSimpleBase(_):
			"direct call in simple base"
		Errors.MissingCallParameter(_):
			"missing call parameter"
		Errors.ConstructorReceiver(_):
			"constructor receiver"
		Errors.MissingConstructorArgument(_):
			"missing constructor argument"
		Errors.InvalidFunctionContract:
			"invalid function contract"
		Errors.LoopControlOutsideLoop:
			"loop control outside a loop body"
		Errors.MissingGenericParameter(_):
			"missing generic parameter"
		Errors.RuntimeGenericContract:
			"runtime generic contract"
		Errors.InvalidCallName(_):
			"invalid call name identity"
		Errors.UnsupportedPatternReachedResolution:
			"unsupported pattern form reached resolution"
		Errors.JoinWithoutArms:
			"match without arms reached join resolution"


private pure func rendered(span: Span, message: String, help: String) -> Diagnostic:
	{
		span = span,
		note = None,
		message = message,
		help = help
	}


private pure func noted(
	span: Span,
	message: String,
	help: String,
	note: DiagnosticNote,
) -> Diagnostic:
	{ rendered(span, message, help) | note = Some(note) }


private pure func render_fault(span: Span, invariant: Errors.CheckerInvariant) -> Diagnostic:
	rendered(
		span,
		invariant_message(invariant),
		"report this compiler error with the input program",
	)


private pure func parsed_spelling(
	name: NameId,
	names: NameTable,
	span: Span,
) -> Result[String, Diagnostic]:
	name_spelling(names, name).to_result(render_fault(span, Errors.InvalidParsedName(name)))


pure func render_check_error(program: ParsedProgram, error: Errors.CheckError) -> Diagnostic:
	render_context_error({ parsed = parsed_contents(program), functions = [] }, error)


private pure func render_context_error(context: RenderContext, error: Errors.CheckError) -> Diagnostic:
	match error.kind:
		Errors.UnsupportedSyntax(form):
			render_unsupported_form(error.span, form)
		Errors.QualifiedRejection(rejection):
			render_qualified_error(error.span, rejection, context)
		Errors.NamespaceRejection(problem):
			render_namespace_problem(error.span, problem, context)
		Errors.TypeDeclarationRejection(rejection):
			render_type_declaration_error(error.span, rejection)
		Errors.TypeTermRejection(rejection):
			render_type_term_error(error.span, rejection, context)
		Errors.TraitRejection(rejection): render_trait_error(error.span, rejection, context)
		Errors.SignatureRejection(rejection):
			render_signature_error(error.span, rejection)
		Errors.BuiltinRejection(rejection):
			render_builtin_error(error.span, rejection)
		Errors.CallRejection(rejection):
			render_call_error(error.span, rejection, context)
		Errors.ConstantRejection(rejection):
			render_constant_error(error.span, rejection, context)
		Errors.MethodRejection(rejection):
			render_method_error(error.span, rejection, context)
		Errors.ConstructorRejection(rejection):
			render_constructor_error(error.span, rejection, context)
		Errors.RecordRejection(rejection):
			render_record_error(error.span, rejection, context)
		Errors.ValueRejection(rejection):
			render_value_error(error.span, rejection, context)
		Errors.BindingRejection(rejection):
			render_binding_error(error.span, rejection, context)
		Errors.StatementRejection(rejection):
			render_statement_error(error.span, rejection)
		Errors.MatchRejection(rejection):
			render_match_error(error.span, rejection, context)
		Errors.RecursionRejection(rejection):
			render_recursion_error(error.span, rejection)
		Errors.InternalInvariant(invariant):
			render_fault(error.span, invariant)


private pure func render_constant_error(span: Span, rejection: Errors.ConstantError, context: RenderContext) -> Diagnostic:
	match rejection:
		Errors.NonClosedInitializer:
			rendered(span, "constant initializer is not a closed value", "use literals, constructor data, or named function references; calls, constant references and lambdas are not allowed")
		Errors.ConstantCalled(id):
			spelling = inventory_constants(context.parsed.declarations).get(constant_number(id))
				.to_result(render_fault(span, Errors.InvalidConstantDeclaration(id)))
				.and_then(pure func(row): parsed_spelling(row.declaration.name.id, context.parsed.names, span))
			match spelling:
				Err(error): error
				Ok(name): rendered(span, "constant '${name}' cannot be called",
					"read the constant without parentheses, such as ${name}")


-- Each form names itself and the milestone that lands it.
private pure func render_unsupported_form(span: Span, form: Errors.UnsupportedForm) -> Diagnostic:
	match form:
		Errors.RangeValue:
			rendered(span, "ranges are not supported yet", "iterate with an explicit index; low..high arrives with the loops milestone")
		Errors.AndOrOperator:
			rendered(span, "`and`/`or` infix syntax is invalid", "call and(left, right) or left.and(right); call or(left, right) or left.or(right)")
		Errors.NotOperator:
			rendered(span, "`not value` is invalid", "call not(value) or value.not()")
		Errors.IfValue:
			rendered(span, "an if nested inside another expression is not supported yet", "bind the if result to a local before using it here")
		Errors.MatchInExpression:
			rendered(span, "a `match` inside a larger expression is not supported yet", "bind the match first with name = match ..., then use the name")
		Errors.Propagation:
			rendered(span, "`?=` is not supported yet", "match on the Option or Result and return its failing case; `?=` arrives with the join milestone")
		Errors.WhileStatement:
			rendered(span, "`while` is not supported yet", "write a recursive function; loops arrive with the loops milestone")
		Errors.CharPattern:
			rendered(span, "Char literal patterns are not supported yet", "compare the character in the arm; literal patterns arrive with the pattern-compilation milestone")


-- The written import path, as the source spelled it: `./a/b`, `../a` or `int`.
private pure func module_path_spelling(path: ModulePath, context: RenderContext, span: Span) -> Result[String, Diagnostic]:
	var text = match path.origin:
		LibraryImport: ""
		RelativeImport(parents):
			if IntOps.equals(parents, 0):
				"./"
			else:
				var prefix = ""
				var remaining = parents
				while IntOps.greater_than(remaining, 0):
					prefix = "${prefix}../"
					remaining = IntOps.subtract(remaining, 1)
				prefix
	var position = 0
	var failure: Option[Diagnostic] = None
	for part in path.parts:
		match parsed_spelling(part, context.parsed.names, span):
			Err(error):
				failure = Some(error)
				break
			Ok(spelling):
				if IntOps.greater_than(position, 0):
					text = "${text}/"
				text = text.concat(spelling)
		position = IntOps.add(position, 1)
	match failure:
		Some(error): Err(error)
		None: Ok(text)


private pure func render_qualified_error(span: Span, rejection: Errors.QualifiedError, context: RenderContext) -> Diagnostic:
	match rejection:
		Errors.UnknownModuleAlias(aliased):
			match parsed_spelling(aliased, context.parsed.names, span):
				Err(error): error
				Ok(spelling):
					rendered(span, "unknown module alias ${spelling}", "add path as ${spelling} to the import block")
		Errors.BareModuleAlias(aliased):
			match parsed_spelling(aliased, context.parsed.names, span):
				Err(error): error
				Ok(spelling):
					rendered(span, "${spelling} is a module alias", "write ${spelling}.name to use a declaration of that module")
		Errors.QualifiedNotOffered(aliased, name, path, reason):
			match parsed_spelling(aliased, context.parsed.names, span):
				Err(error): error
				Ok(alias_spelling):
					match parsed_spelling(name, context.parsed.names, span):
						Err(error): error
						Ok(selected_spelling):
							match module_path_spelling(path, context, span):
								Err(error): error
								Ok(module):
									match reason:
										PrivateName:
											rendered(span, "${selected_spelling} is private to ${module}", "remove private or qualify a public declaration")
										UnknownName | ImportedThere(_) | ProvidedThere(_):
											rendered(span, "module ${module} declares no public ${selected_spelling}", "${alias_spelling} names module ${module}; qualify a public function, constructor or type it declares; imports are not reexported")


-- Every namespace problem: a conflict in one table, a selection by its reason.
private pure func render_namespace_problem(span: Span, problem: NamespaceProblem, context: RenderContext) -> Diagnostic:
	match problem:
		InvalidTraitInventory(_): rendered(span, "internal compiler error: invalid trait method inventory", "report this compiler invariant failure")
		InvalidImplementationTrait(_): rendered(span, "implementation requires a visible trait name", "import a parameterless trait and name it after implements")
		NameConflict(conflict):
			render_conflict(span, conflict, context)
		SelectionFailure(path, selection, reason):
			render_selection(span, path, selection, reason, context)


private pure func entity_noun(entity: Entity) -> String:
	match entity:
		Trait(_): "trait"
		Method(_): "trait method"
		Function(_): "function"
		Constant(_): "constant"
		Constructor(_): "constructor"
		Type(_): "type"
		Alias(_): "module alias"


private pure func same_kind(left: Entity, right: Entity) -> Bool:
	match left:
		Trait(_):
			match right:
				Trait(_): True
				_: False
		Method(_):
			match right:
				Method(_): True
				_: False
		Function(_):
			match right:
				Function(_): True
				_: False
		Constant(_):
			match right:
				Constant(_): True
				_: False
		Constructor(_):
			match right:
				Constructor(_): True
				_: False
		Type(_):
			match right:
				Type(_): True
				_: False
		Alias(_):
			match right:
				Alias(_): True
				_: False


-- One table for every name conflict. The message says what already holds the
-- name; the help says how to change the incoming one. The note marks the
-- earlier name: a declaration, an import, or the prelude's selection.
private pure func render_conflict(span: Span, conflict: Conflict, context: RenderContext) -> Diagnostic:
	match parsed_spelling(conflict.incoming.name.id, context.parsed.names, span):
		Err(error):
			error
		Ok(name):
			incoming = entity_noun(conflict.incoming.entity)
			previous = entity_noun(conflict.previous.entity)
			alias_previous: Bool = match conflict.previous.entity:
				Alias(_): True
				Trait(_) | Method(_) | Function(_) | Constant(_) | Constructor(_) | Type(_): False
			message = match conflict.previous.origin:
				Implicit:
					"${name} is provided by the prelude"
				Imported:
					if alias_previous:
						"${name} is already a module alias"
					else:
						"${name} is already imported"
				Declared(_):
					if same_kind(conflict.incoming.entity, conflict.previous.entity):
						"duplicate ${incoming} name"
					else:
						"${incoming} name conflicts with a ${previous}"
			alias_incoming: Bool = match conflict.incoming.entity:
				Alias(_): True
				Trait(_) | Method(_) | Function(_) | Constant(_) | Constructor(_) | Type(_): False
			help = match conflict.incoming.origin:
				Declared(_):
					match conflict.previous.origin:
						Implicit:
							"give this ${incoming} another name; the prelude's ${previous} ${name} is always in scope"
						Imported:
							if alias_previous:
								"rename this ${incoming}, or choose another alias"
							else:
								"rename this ${incoming}, or remove ${name} from the import"
						Declared(_):
							if same_kind(conflict.incoming.entity, conflict.previous.entity):
								"give each ${incoming} in a module a distinct name"
							else:
								"functions and constructors share one name space; give them distinct names"
				Imported | Implicit:
					if alias_incoming:
						"choose another alias for this module"
					else if alias_previous:
						"choose another alias for that module, or omit ${name} from this selection"
					else:
						match conflict.previous.origin:
							Implicit: "omit ${name} from this selection, or reach it through a module alias"
							Imported | Declared(_): "select ${name} from one module only, and reach the other through a module alias"
			noted(span, message, help, PreviousDeclaration(conflict.previous.name.span))


-- Where `entity` is declared, for a note: ids name their inventory rows, and a
-- builtin type is the foundation's declaration of that head. Host `get` returns
-- an Option even for an issued id, which always has its row, so `None` never runs.
private pure func declaration_span(entity: Entity, context: RenderContext) -> Result[Option[Span], Diagnostic]:
	var found: Option[Span] = None
	var failure: Option[Diagnostic] = None
	match entity:
		Trait(id):
			match inventory_traits(context.parsed.declarations).get(trait_number(id)):
				Some(row): found = Some(row.type_name.span)
				None: void
		Method(id):
			match inventory_traits(context.parsed.declarations).get(trait_number(trait_method_owner(id))):
				Some(row):
					match row.methods.get(trait_method_number(id)):
						Some(method):
							match trait_method_header(method, context.parsed.declarations):
								Some(header): found = Some(header.function_name.span)
								None: failure = Some(render_fault(method.span, Errors.InvalidFunctionContract))
						None: void
				None: void
		Function(id):
			match inventory_functions(context.parsed.declarations).get(function_number(id)):
				Some(row): found = Some(row.declaration.function_name.span)
				None: void
		Constant(id):
			match inventory_constants(context.parsed.declarations).get(constant_number(id)):
				Some(row): found = Some(row.declaration.name.span)
				None: void
		Constructor(id):
			match inventory_unions(context.parsed.declarations).get(union_number(variant_owner(id))):
				Some(row):
					match row.variants.get(variant_number(id)):
						Some(variant): found = Some(variant.declaration.name.span)
						None: void
				None: void
		Type(UnionHead(id)):
			match inventory_unions(context.parsed.declarations).get(union_number(id)):
				Some(row): found = Some(row.type_name.span)
				None: void
		Type(RecordHead(id)):
			match inventory_records(context.parsed.declarations).get(record_number(id)):
				Some(row): found = Some(row.declaration.type_name.span)
				None: void
		Type(OpaqueHead(id)):
			match inventory_opaques(context.parsed.declarations).get(opaque_number(id)):
				Some(row): found = Some(row.declaration.type_name.span)
				None: void
		Type(candidate):
			for row in context.parsed.builtin_types:
				if same_head(builtin_head(row.declaration), candidate):
					found = Some(builtin_type_name(row.declaration).span)
		Alias(_):
			void
	match failure:
		Some(error): Err(error)
		None: Ok(found)


-- The " or write P: N methods_only ..." clause a type selection may add.
private pure func methods_hint(entity: Entity, name: String, module: String) -> String:
	match entity:
		Type(_): ", or write ${module}: ${name} methods_only to use the functions ${module} declares on ${name}"
		Trait(_) | Method(_) | Function(_) | Constant(_) | Constructor(_) | Alias(_): ""


-- A selection that binds nothing, named by the target's written path.
private pure func render_selection(span: Span, path: ModulePath, selection: ImportSelection, problem: SelectionProblem, context: RenderContext) -> Diagnostic:
	match parsed_spelling(selection_name(selection).id, context.parsed.names, span):
		Err(error):
			error
		Ok(name):
			match module_path_spelling(path, context, span):
				Err(error):
					error
				Ok(module):
					match problem:
						NotOffered(UnknownName):
							match selection:
								NamedSelection(_):
									rendered(span, "module ${module} declares no public function or type ${name}", "select a public function or type that ${module} declares")
								ConstructorSelection(_, _):
									rendered(span, "module ${module} declares no public union ${name}", "select a fixed union that ${module} declares")
								MethodsOnlySelection(_, _):
									rendered(span, "module ${module} has no type ${name}", "methods_only names a type that ${module} declares or imports")
						NotOffered(PrivateName):
							rendered(span, "${name} is private to ${module}", "remove private or import a public declaration")
						NotOffered(ImportedThere(entity)):
							message = "${name} is imported by ${module}, not declared there"
							help: Result[String, Diagnostic] = match entity:
								Constructor(id):
									match type_spelling(Check.UnionType(variant_owner(id)), context, span):
										Err(error): Err(error)
										Ok(union_name): Ok("import the union from the module that declares it, selecting ${union_name}(${name})")
								Trait(_) | Method(_) | Function(_) | Constant(_) | Type(_) | Alias(_):
									Ok("import ${name} from the module that declares it${methods_hint(entity, name, module)}")
							match help:
								Err(error): error
								Ok(text):
									match declaration_span(entity, context):
										Ok(Some(declared)): noted(span, message, text, Declaration(declared))
										Ok(None): rendered(span, message, text)
										Err(error): error
						NotOffered(ProvidedThere(entity)):
							rendered(span, "${module} receives ${name} from the prelude and does not declare it", "${name} is already in scope through the prelude; remove it from this selection${methods_hint(entity, name, module)}")
						AlreadyFromPrelude(entity):
							rendered(span, "${name} is already in scope through the prelude", "remove ${name} from this selection${methods_hint(entity, name, module)}")
						AlreadyImported(entity):
							rendered(span, "${name} is already imported, and ${module} does not declare it", "remove ${name} from this selection${methods_hint(entity, name, module)}")
						AmbiguousFunction:
							ambiguous_selection(span, module, "function")
						AmbiguousConstant:
							ambiguous_selection(span, module, "constant")
						BareConstructor(variant):
							match type_spelling(Check.UnionType(variant_owner(variant)), context, span):
								Err(error): error
								Ok(union_name):
									rendered(span, "${name} is a constructor of the union ${union_name}", "write ${union_name}(${name}) to select the union with this constructor")
						NotAConstructor(_):
							rendered(span, "constructor does not belong to the selected union", "select a constructor declared inside that union")
						ReceiverNotVisible:
							rendered(span, "method receiver type is not independently visible", "import the exact type with an ordinary type selection before using methods_only")


private pure func ambiguous_selection(span: Span, module: String, kind: String) -> Diagnostic:
	rendered(
		span,
		"import selection names both a type and a ${kind}",
		"rename the type or the ${kind} in ${module}; a bare selection names one declaration",
	)


private pure func render_type_declaration_error(
	span: Span,
	rejection: Errors.TypeDeclarationError,
) -> Diagnostic:
	match rejection:
		Errors.RecursiveOpaqueRepresentation(_):
			rendered(span, "recursive opaque representations are not supported yet", "wrap an independently recursive aggregate instead of referring back to the opaque type")
		Errors.RecursiveAggregateType(_):
			rendered(
				span,
				"recursive aggregate types are not supported yet",
				"use finite record and union fields; recursion is supported through a record field, a List element or one direct self payload of a non-generic union, such as Next(Node)",
			)
		Errors.DuplicateRecordField(_, first):
			noted(
				span,
				"duplicate record field name",
				"give each field in a record a distinct name",
				PreviousField(first),
			)

		Errors.DuplicateTypeParameter(_, _, _):
			rendered(
				span,
				"duplicate type parameter name",
				"choose a distinct name for each type parameter, such as A and B",
			)
		Errors.TypeParameterTypeNameConflict(_):
			rendered(
				span,
				"type parameter conflicts with a type name",
				"choose a distinct type parameter name, such as T",
			)



private pure func render_type_term_error(span: Span, rejection: Errors.TypeTermError, context: RenderContext) -> Diagnostic:
	match rejection:
		Errors.TraitUsedAsType(_): rendered(span, "a trait is not a value type", "use a concrete value type, or constrain a type parameter as T: TraitName")
		Errors.PrivateTypeInPublicDeclaration(private_type, declaration):
			match parsed_spelling(private_type, context.parsed.names, span):
				Err(error): error
				Ok(private_name):
					match parsed_spelling(declaration, context.parsed.names, span):
						Err(error): error
						Ok(public_name):
							rendered(span,
								"${private_name} is private but appears in public declaration ${public_name}",
								"make ${private_name} public, or make ${public_name} private",
							)
		Errors.MissingRecordTypeArguments(_, count):
			if IntOps.equals(count, 1):
				rendered(
					span,
					"generic record requires one type argument",
					"write a concrete or symbolic application, such as Box[Int] or Box[T]",
				)
			else:
				rendered(
					span,
					"generic record requires type arguments",
					"write ${IntOps.to_string(count)} type arguments in declaration order",
				)
		Errors.RecordTypeArgumentCountMismatch(_, expected, actual):
			rendered(
				span,
				"record type argument count does not match its declaration",
				"expected ${IntOps.to_string(expected)} type arguments, got ${IntOps.to_string(actual)}; supply types in declaration order",
			)
		Errors.MissingUnionTypeArguments(_, count):
			if IntOps.equals(count, 1):
				rendered(
					span,
					"generic union requires one type argument",
					"write a concrete or symbolic application, such as Box[Int] or Box[T]",
				)
			else:
				rendered(
					span,
					"generic union requires type arguments",
					"write ${IntOps.to_string(count)} type arguments in declaration order",
				)
		Errors.UnionTypeArgumentCountMismatch(_, expected, actual):
			rendered(
				span,
				"union type argument count does not match its declaration",
				"expected ${IntOps.to_string(expected)} type arguments, got ${IntOps.to_string(actual)}; supply types in declaration order",
			)
		Errors.UnknownType(_):
			rendered(
				span,
				"unknown type",
				"declare or import this type; builtin types and declared type parameters are also available",
			)
		Errors.NonApplicableType(_):
			rendered(
				span,
				"type does not accept a type argument",
				"apply a declared generic union or record, such as Box[Int]",
			)
		Errors.OrdinaryRecordApplied(_):
			rendered(
				span,
				"ordinary record does not accept a type argument",
				"remove the type argument from this record type",
			)
		Errors.OrdinaryUnionApplied(_):
			rendered(
				span,
				"ordinary union does not accept a type argument",
				"remove the type argument from this union type",
			)
		Errors.ListTypeArgumentCount:
			rendered(
				span,
				"List requires one type argument",
				"write List[String] for a list of Strings",
			)



private pure func render_signature_error(
	span: Span,
	rejection: Errors.SignatureError,
) -> Diagnostic:
	match rejection:
		Errors.GenericMain(_):
			rendered(
				span,
				"main cannot be generic",
				"declare main() -> Int: without type parameters",
			)
		Errors.MainHasParameters(_):
			rendered(
				span,
				"main accepts at most one parameter",
				"declare main() -> Int: or main(arguments: List[String]) -> Int:",
			)
		Errors.MainParameterType:
			rendered(
				span,
				"main parameter must have type List[String]",
				"declare main() -> Int: or main(arguments: List[String]) -> Int:",
			)
		Errors.MainReturnType(_):
			rendered(
				span,
				"main must return Int or Void",
				"return an Int exit status, or omit the return type for exit status 0",
			)
		Errors.MissingMain:
			rendered(
				span,
				"expected a main function",
				"declare func main() -> Int: as the entrypoint",
			)


private pure func render_builtin_error(span: Span, rejection: Errors.BuiltinError) -> Diagnostic:
	match rejection:
		Errors.BuiltinTypesRejected(error):
			render_builtin_type_error(error)
		Errors.BuiltinContractMismatch(operation):
			rendered(
				span,
				"builtin declaration does not match its runtime contract",
				runtime_declaration_help(operation),
			)
		Errors.BuiltinTailAnnotation:
			rendered(
				span,
				"builtin bodies cannot have a tail-recursion annotation",
				"remove @tail_recursive from the builtin declaration",
			)


private pure func render_call_error(
	span: Span,
	rejection: Errors.CallError,
	context: RenderContext,
) -> Diagnostic:
	match rejection:
		Errors.ImpureLambda:
			rendered(span, "pure callback requires a pure lambda", "write pure func for this callback")
		Errors.LambdaArityMismatch(expected, _):
			rendered(span, "lambda has the wrong number of parameters", "write ${IntOps.to_string(expected)} parameters for this callback")
		Errors.LambdaInputNeedsType:
			rendered(span, "cannot infer this lambda's input types", "annotate its parameters or supply a typed ordinary argument")
		Errors.LambdaBlockNeedsResult:
			rendered(span, "block lambda needs a complete result type", "write a return annotation or give the callback a complete result context")
		Errors.LambdaResultNeedsType:
			rendered(span, "standalone lambda needs a complete result type", "write a return annotation or give the lambda a callable type annotation")
		Errors.ImpureCall(_, _):
			rendered(
				span,
				"pure functions cannot call impure functions",
				"mark the callee pure or remove pure from the caller",
			)
		Errors.CallableReceiverSyntax(_):
			rendered(
				span, "callbacks require direct-call syntax",
				"invoke the callback as f(value), or forward it in a declared helper's argument list",
			)
		Errors.ImpureCallableCall(_):
			rendered(span, "pure functions cannot call an impure callable", "use a pure callable type, or remove pure from the calling function")
		Errors.ImpureCallback(_):
			rendered(
				span, "pure callback requires a pure function",
				"pass a pure named function; impure functions cannot satisfy a pure callable parameter",
			)
		Errors.CallableValueRequired:
			rendered(
				span, "callback argument must be a pure function",
				"pass a pure named function or pure func literal, or forward a callable parameter unchanged",
			)
		Errors.UnknownFunction(_):
			rendered(
				span,
				"unknown function",
				"declare the function locally or import it by name; type selections enable receiver calls only",
			)
		Errors.ArgumentTypeMismatch(mismatch):
			type_diagnostic(
				span,
				"argument type does not match the parameter type",
				mismatch.expected,
				context,
			)
		Errors.GenericArgumentConflict(conflict):
			type_diagnostic(
				span,
				"argument type does not match the parameter type",
				conflict.mismatch.expected,
				context,
			)
		Errors.UncallableBinding(_, origin, value_type):
			match origin:
				Check.ParameterBinding(_) | Check.CallableParameterBinding(_):
					message = if Check.same_type(value_type, Check.IntType):
						"Int parameters cannot be called"
					else:
						"parameters cannot be called"

					rendered(
						span,
						message,
						"use the parameter as a value, or rename it to call the function",
					)
				Check.MatchCapture:
					rendered(
						span,
						"match bindings cannot be called",
						"use the binding as a value, or rename it to call the function",
					)
				Check.BodyLocal:
					rendered(
						span,
						"local bindings cannot be called",
						"use the binding as a value, or rename it to call the function",
					)
		Errors.ArgumentCountMismatch(arity):
			render_arity_mismatch(span, arity, context)
		Errors.InfiniteTypeArgument(_):
			rendered(span, "inferred type would contain itself", "pass a value with a finite type, or use a concrete helper")
		Errors.UninferableTypeParameter(_):
			rendered(
				span,
				"cannot infer the type parameter from the argument",
				"pass a value whose type determines the declared type parameter; use a concrete helper when no argument can determine it",
			)


-- Arity wording teaches by the callee's parameter count and call notation.
private pure func render_arity_mismatch(
	span: Span,
	arity: Errors.ArityMismatch,
	context: RenderContext,
) -> Diagnostic:
	if IntOps.equals(arity.expected, 0):
		match arity.notation:
			DirectCall:
				rendered(
					span,
					"function takes no arguments",
					"remove the argument and call the function with ()",
				)
			ReceiverCall:
				match name_spelling(context.parsed.names, arity.callee):
					Some(name):
						rendered(
							span,
							"function takes no arguments",
							"call ${name}() directly, or choose a function with one parameter",
						)
					None:
						render_fault(
							span,
							Errors.InvalidCallName(arity.callee),
						)
	else if IntOps.equals(arity.expected, 1):
		rendered(
			span,
			"function requires one argument",
			"pass one expression of the declared parameter type",
		)
	else:
		rendered(
			span,
			"argument count does not match the function parameters",
			"pass one expression for each declared parameter; UFCS supplies the receiver first",
		)


private pure func render_method_error(span: Span, rejection: Errors.MethodError, context: RenderContext) -> Diagnostic:
	match rejection:
		Errors.OverlappingReceivers(name, overlap):
			match render_receiver_overlap(span, name, overlap, context):
				Ok(clash): clash
				Err(invariant): invariant
		Errors.AmbiguousMethod(_, _, sites):
			method_diagnostic(
				span,
				sites,
				"ambiguous method call",
				"rename one method or call a uniquely imported function directly; receiver type and argument count must identify one function",
			)
		Errors.NoApplicableMethod(_, _, sites):
			method_diagnostic(
				span,
				sites,
				"no method accepts this receiver type",
				"use a value of a declared receiver type, or import a function accepting this type",
			)
		Errors.MethodReceiverNeedsType(_, sites):
			method_diagnostic(
				span,
				sites,
				"method receiver needs an explicit type",
				"bind the receiver through a typed helper, or call a uniquely imported function directly",
			)
		Errors.MethodArgumentCounts(_, _, counts, sites):
			var expected: List[String] = []

			for count in counts:
				expected = expected.append(IntOps.to_string(count))

			method_diagnostic(
				span,
				sites,
				"method argument count does not match any receiver-compatible function",
				"pass one of these total argument counts, including the receiver: ${comma_separated(expected)}",
			)
		Errors.ConstructorUFCS(_):
			rendered(
				span,
				"constructors do not support UFCS in this increment",
				"write the constructor directly, such as Number(value)",
			)


private pure func render_constructor_error(
	span: Span,
	rejection: Errors.ConstructorError,
	context: RenderContext,
) -> Diagnostic:
	match rejection:
		Errors.ConstructorNeedsExpectedType(_):
			rendered(
				span,
				"constructor needs an expected union type",
				"pass an already-typed union value or call a concrete helper returning the union",
			)
		Errors.PayloadFreeVariantCalled(_):
			rendered(
				span,
				"payload-free variants cannot be called",
				"use the bare variant name without parentheses",
			)

		Errors.ConstructorFieldCountMismatch(_, expected, actual):
			rendered(
				span,
				"constructor field count does not match its declaration",
				"expected ${IntOps.to_string(expected)} fields, got ${IntOps.to_string(actual)}; pass one expression per declared field",
			)
		Errors.VariantNotInExpectedType(_, expected):
			type_diagnostic(span, "variant does not belong to the expected type", expected, context)



private pure func render_record_error(
	span: Span,
	rejection: Errors.RecordError,
	context: RenderContext,
) -> Diagnostic:
	match rejection:
		Errors.RecordNeedsExpectedType:
			rendered(
				span,
				"record literal needs an expected record type",
				"pass the literal to a concrete record parameter or return it from a helper declaring that record",
			)
		Errors.UnknownRecordField(name, owner):
			result: Result[Diagnostic, Diagnostic] = parsed_spelling(
				name,
				context.parsed.names,
				span,
			).and_then(
				pure func(field): ResultOps.map(type_spelling(
					Check.RecordType(owner),
					context,
					span,
				), pure func(record_name): rendered(
						span,
						"unknown field '${field}' in ${record_name}",
						"use a field declared by the receiving record",
					)),
			)

			match result:
				Ok(diagnostic):
					diagnostic
				Err(diagnostic):
					diagnostic
		Errors.DuplicateLiteralField(_, first):
			noted(
				span,
				"duplicate field in record literal",
				"write each record field exactly once",
				PreviousField(first),
			)
		Errors.DuplicateUpdateField(_, first):
			noted(span, "duplicate field in record update", "write each replacement field exactly once", PreviousField(first))
		Errors.MissingRecordField(_, declaration):
			noted(
				span,
				"missing field in record literal",
				"provide every declared record field exactly once",
				RecordFieldDeclaration(declaration),
			)
		Errors.RecordFieldTypeMismatch(_, _, annotation):
			match type_spelling(annotation.value_type, context, span):
				Ok(expected):
					{ rendered(
						span,
						"record field requires ${expected}",
						"use an expression of type ${expected} here",
					) | note = Some(RecordFieldDeclaration(annotation.span)) }
				Err(error):
					error
		Errors.FieldRequiresRecord(_):
			rendered(
				span,
				"field access requires a record value",
				"read a declared record field, or use parentheses for a UFCS function call",
			)
		Errors.UpdateRequiresRecord(_):
			rendered(span, "record update requires a record value", "write { existing_record | field = expression } with a record base")


private pure func render_value_error(
	span: Span,
	rejection: Errors.ValueError,
	context: RenderContext,
) -> Diagnostic:
	match rejection:
		Errors.TupleIndexRequiresTuple(_):
			rendered(span, "indexed field access requires a tuple", "use a tuple value with a literal index, such as value[0]")
		Errors.TupleIndexMustBeLiteral:
			rendered(span, "a tuple index must be an integer literal", "use a literal index such as value[0], or destructure the tuple")
		Errors.TupleIndexOutOfRange(_, arity):
			rendered(span, "tuple index is out of range", "use a literal index from 0 through ${IntOps.to_string(IntOps.subtract(arity, 1))}")
		Errors.MutableCapture(_):
			rendered(span, "lambda cannot capture a mutable binding", "copy its current value to an immutable binding before capturing it")
		Errors.MissingIfElse:
			rendered(span, "if without else must return Void", "add an else branch to produce a value, or finish the then block with a Void expression")
		Errors.IfBranchWithoutValue:
			rendered(span, "if branch has no final value", "finish the branch with a value expression on its own indented line")
		Errors.UnknownOpaqueType(_):
			rendered(span, "unknown opaque type", "import or declare an opaque type before converting it")
		Errors.NonOpaqueConversionType(_):
			rendered(span, "type is not opaque", "use into_opaque or from_opaque only with a declared opaque type")
		Errors.ForeignOpaqueConstruction(_):
			rendered(span, "opaque values can be constructed only in their declaring module", "call a public constructor from the declaring module")
		Errors.ForeignOpaqueProjection(_):
			rendered(span, "opaque values can be projected only in their declaring module", "call a public accessor from the declaring module")
		Errors.UnknownValue(_):
			rendered(
				span,
				"unknown value",
				"use this function's parameter name, a declared variant, or a call",
			)
		Errors.ExpressionTypeMismatch(mismatch):
			match mismatch.expected_site:
				Errors.FirstIfBranchValue:
					match type_spelling(mismatch.expected, context, span):
						Err(error): error
						Ok(expected):
							rendered(span, "expression does not match the expected type",
								"the then branch decides this if's type, ${expected}; give every branch a value of type ${expected}")
				Errors.OpaqueConstruction(_):
					rendered(span, "opaque construction value has the wrong type", "pass the declared underlying type to into_opaque")
				Errors.OpaqueProjection(_):
					rendered(span, "opaque projection value has the wrong type", "pass a value of the named opaque type to from_opaque")
				Errors.ForRangeBound:
					rendered(span, "range bound must have type Int", "use an Int expression for each bound in start..end")
				Errors.FirstArmValue:
					match type_spelling(mismatch.expected, context, span):
						Err(error): error
						Ok(expected):
							rendered(
								span,
								"expression does not match the expected type",
								"the first arm's value decides this match's type, ${expected}; give every arm a value of type ${expected}",
							)
				Errors.SourceAnnotation(_) | Errors.InferredBindingDeclaration(_):
					type_diagnostic(
						span,
						"expression does not match the expected type",
						mismatch.expected,
						context,
					)
		Errors.InterpolationRequiresString(actual):
			match type_spelling(actual, context, span):
				Err(error): error
				Ok(spelling):
					rendered(span, "interpolation hole has type ${spelling}; expected String", "convert Int or Float explicitly with to_string; every hole must produce a String")
		Errors.EmptyListNeedsElementType:
			rendered(
				span,
				"cannot infer the element type of an empty list literal",
				"give it a context with a List type, such as a List parameter, return type or append argument",
			)
		Errors.ListElementTypeMismatch(mismatch):
			match type_spelling(mismatch.actual, context, span):
				Err(error): error
				Ok(actual):
					match type_spelling(mismatch.expected, context, span):
						Err(error): error
						Ok(expected):
							reference = match mismatch.reference:
								Errors.EarlierElement: "element 1 is "
								Errors.ExpectedElement: "the expected List holds "
							rendered(
								span,
								"list elements must have one type: element ${IntOps.to_string(mismatch.position)} is ${actual}, ${reference}${expected}",
								"give every element the type ${expected}",
							)


private pure func binding_conflict(span: Span, name: NameId, kind: String, location: String, previous: Span, context: RenderContext) -> Diagnostic:
	match parsed_spelling(name, context.parsed.names, span):
		Err(error): error
		Ok(spelling):
			noted(span, "`${spelling}` is already a ${kind} in this ${location}",
				"choose a different name for this binding", PreviousDeclaration(previous),
			)


private pure func render_binding_error(span: Span, rejection: Errors.BindingError, context: RenderContext) -> Diagnostic:
	match rejection:
		Errors.ModuleBindingConflict(previous):
			match previous:
				MethodName(name): binding_conflict(span, name.id, "trait method", "module", name.span, context)
				FunctionName(name): binding_conflict(span, name.id, "function", "module", name.span, context)
				ConstantName(name): binding_conflict(span, name.id, "constant", "module", name.span, context)
				ConstructorName(name): binding_conflict(span, name.id, "constructor", "module", name.span, context)
				ModuleAliasName(name): binding_conflict(span, name.id, "module alias", "module", name.span, context)
		Errors.CallableBindingConflict(_, _):
			rendered(
				span, "binding conflicts with a callable parameter",
				"choose a different binding name in this function",
			)
		Errors.LocalBindingConflict(previous, origin):
			kind = match origin:
				Check.ParameterBinding(_) | Check.CallableParameterBinding(_): "parameter"
				Check.BodyLocal | Check.MatchCapture: "local"
			binding_conflict(span, previous.name, kind, "function", previous.span, context)


private pure func render_statement_error(
	span: Span,
	rejection: Errors.StatementError,
) -> Diagnostic:
	match rejection:
		Errors.NonBooleanCondition(_):
			rendered(span, "condition must have the designated Bool type", "use a Bool value as the condition")
		Errors.TupleBindingRequiresTuple(_):
			rendered(span, "tuple destructuring requires a tuple value", "destructure a structural tuple with one name or '_' per element")
		Errors.TupleBindingArityMismatch(expected, actual):
			rendered(span, "tuple binder count does not match the tuple", "expected ${IntOps.to_string(expected)} binders, got ${IntOps.to_string(actual)}; write one name or '_' per tuple element")
		Errors.NonIterableFor(_):
			rendered(span, "for iterable must be a List or an Int range", "iterate a List value, or write start..end with Int bounds")
		Errors.PropagationNeedsResultReturn(_):
			rendered(
				span, "`?=` requires a Result-returning function",
				"return Result[Value, Error] from this function, or match on the value explicitly",
			)
		Errors.PropagationNeedsResultValue(_):
			rendered(
				span, "`?=` requires a Result value",
				"use a Result value here, or match on the value explicitly",
			)

		Errors.NonVoidStatement(_):
			rendered(
				span,
				"expression statement must return Void",
				"bind this value with name = expression, or make it the final expression",
			)
		Errors.NonVoidMatchArm(_):
			rendered(span, "a statement match's arm must be Void", "bind the match's value with name = match ... to use it")
		Errors.CallableAssignment(_):
			rendered(
				span, "cannot assign to a callable parameter",
				"invoke this parameter, or forward it unchanged; callable parameters are immutable",
			)
		Errors.CapturedAssignment(_):
			rendered(span, "lambda cannot assign to an outer binding", "mutate a lambda-local variable or return the updated value explicitly")
		Errors.ImmutableAssignment(_):
			rendered(
				span,
				"cannot assign to an immutable binding",
				"declare the binding with var to allow reassignment",
			)


private pure func render_match_error(
	span: Span,
	rejection: Errors.MatchError,
	context: RenderContext,
) -> Diagnostic:
	match rejection:

		Errors.TuplePatternRequiresTuple(_):
			rendered(span, "tuple pattern requires a tuple value", "match a structural tuple, or use the named record's fields explicitly")
		Errors.TuplePatternArityMismatch(expected, actual):
			rendered(span, "tuple pattern element count does not match the tuple", "expected ${IntOps.to_string(expected)} elements, got ${IntOps.to_string(actual)}; write one pattern per tuple element")
		Errors.PatternFieldCountMismatch(_, expected, actual):
			rendered(
				span,
				"constructor pattern field count does not match its declaration",
				"expected ${IntOps.to_string(expected)} fields, got ${IntOps.to_string(actual)}; write one name or '_' per declared field",
			)
		Errors.BarePatternName(_, _):
			rendered(span, "a bare name in a match arm is a constructor; use `_` to match anything", "use a visible constructor of the matched union, or write `_` and use the match's scrutinee in the arm")
		Errors.UnimportedConstructorPattern(id):
			match inventory_unions(context.parsed.declarations).get(union_number(variant_owner(id))):
				None: render_fault(span, Errors.InvalidResolvedUnion(variant_owner(id)))
				Some(declaration):
					match declaration.variants.get(variant_number(id)):
						None: render_fault(span, Errors.InvalidResolvedVariant(id))
						Some(variant):
							match parsed_spelling(variant.declaration.name.id, context.parsed.names, span):
								Err(error): error
								Ok(name):
									match parsed_spelling(declaration.type_name.id, context.parsed.names, span):
										Err(error): error
										Ok(owner):
											noted(span,
												"${name} is a constructor of ${owner} but is not imported",
												"import ${name} with its union: ${owner}(${name}), from the module that declares ${owner}",
												PreviousDeclaration(variant.declaration.name.span),
											)
		Errors.UnknownConstructorPattern(_, _):
			rendered(
				span,
				"unknown constructor pattern",
				"use a constructor of the matched union that is declared or imported in this module",
			)
		Errors.ArmWithoutValue:
			rendered(span, "match arm has no final value", "finish the arm with a value expression on its own indented line")
		Errors.OrPatternBindingsDiffer:
			rendered(span, "or-pattern alternatives bind different names", "bind the same names in every alternative, or use '_' for fields the arm does not need")
		Errors.OrPatternBindingTypeMismatch(_, _, _):
			rendered(span, "or-pattern binding has different types", "bind each name to the same type in every alternative, or use separate match arms")
		Errors.UnreachableArm:
			rendered(
				span,
				"match arm is unreachable",
				"remove this arm; earlier arms already cover all values it could match",
			)
		Errors.InvalidMatchScrutinee(_):
			rendered(
				span,
				"match requires a union, List or String value",
				"match a union, List or String value; use if for a Boolean condition",
			)

		Errors.PatternTypeMismatch(_):
			rendered(span, "pattern does not match the value's type", "use a constructor of that union, a List pattern for a List, or a String literal for a String")
		Errors.NonExhaustiveStructuralMatch(witness):
			match render_pattern_witness(witness, span, context):
				Ok(pattern): rendered(span, "non-exhaustive match", "add an arm for the missing pattern: ${pattern}")
				Err(error): error
		Errors.NonExhaustiveMatch(missing):
			missing_coverage(missing, span, context)


private pure func render_recursion_error(
	span: Span,
	rejection: Errors.RecursionError,
) -> Diagnostic:
	match rejection:
		Errors.NonTailSelfCall(_):
			rendered(
				span,
				"recursive call is not in tail position",
				"return this call directly, or remove @tail_recursive",
			)
		Errors.NoSelfRecursion:
			rendered(
				span,
				"@tail_recursive function has no direct self call",
				"remove @tail_recursive; mutual recursion is not covered by this annotation",
			)
		Errors.PropagationTailRecursionUnsupported:
			rendered(
				span, "`?=` is not supported in @tail_recursive functions",
				"remove @tail_recursive, or match on the Result explicitly",
			)
		Errors.CallableTailRecursionUnsupported:
			rendered(
				span, "tail recursion with callable parameters is not supported yet",
				"remove @tail_recursive; callable parameters on recursive backedges are not supported yet",
			)
		Errors.AnnotatedSelfCallback:
			rendered(
				span, "tail-recursive function cannot reference itself as a callback",
				"pass a different callback or remove @tail_recursive",
			)
		Errors.GenericTailRecursionUnsupported:
			rendered(
				span,
				"generic @tail_recursive functions are not supported yet",
				"use a nongeneric helper, or remove @tail_recursive",
			)
		Errors.TailCallInNestedMatch:
			rendered(
				span,
				"a recursive call at the tail of a nested match is not supported yet",
				"make it an arm of the function's own match, or remove @tail_recursive; backedges from nested matches arrive with the loops milestone",
			)
		Errors.UnprovenTraitInstantiation:
			rendered(span, "cannot prove finite generic trait instantiation", "avoid recursively wrapping generic receivers through trait dispatch; this increment uses a conservative constructor-depth proof")
		Errors.GrowingRecursiveInstantiation:
			rendered(
				span,
				"recursive calls grow type arguments without bound",
				"pass recursive type arguments unchanged, permute them, or reset them to concrete types",
			)


private pure func method_diagnostic(
	span: Span,
	sites: List[Errors.MethodCandidateSite],
	message: String,
	help: String,
) -> Diagnostic:
	var locations: List[Span] = []

	for site in sites:
		locations = locations.append(site.declaration)

		match site.import_site:
			Some(import_site):
				locations = locations.append(import_site)
			None:
				void

	noted(span, message, help, CompetingDeclarations(locations))


private pure func builtin_spelling(
	value: Check.TypeRef,
	context: RenderContext,
	span: Span,
) -> Result[String, Diagnostic]:
	var found_name: Option[NameId] = None

	for declaration in context.parsed.builtin_types:
		selected = match declaration.declaration:
			IntegerBuiltin(_):
				Check.same_type(value, Check.IntType)
			FloatBuiltin(_):
				Check.same_type(value, Check.FloatType)
			StringBuiltin(_):
				Check.same_type(value, Check.StringType)
			VoidBuiltin(_):
				Check.same_type(value, Check.VoidType)
			ListBuiltin(_):
				match value:
					Check.ListType(_):
						True
					_:
						False

		if selected:
			found_name = Some(builtin_type_name(declaration.declaration).id)
			break

	match found_name:
		Some(name):
			parsed_spelling(name, context.parsed.names, span)
		None:
			Err(
				rendered(
					span,
					"missing builtin type declaration",
					"report this compiler error with the input program",
				),
			)


private pure func ordinary_parameter_spelling(
	id: Check.TypeParameterId,
	context: RenderContext,
	span: Span,
) -> Result[String, Diagnostic]:
	found_parameters: Option[List[WrittenName]] = match Check.parameter_owner(id):
		Check.TraitDeclaration(_): None
		Check.FunctionDeclaration(owner):
			inventory_functions(context.parsed.declarations)
				.get(function_number(owner))
				.map(pure func(row): row.declaration.type_parameters.map(pure func(parameter): parameter.name))
		Check.UnionDeclaration(owner):
			inventory_unions(context.parsed.declarations)
				.get(union_number(owner))
				.map(pure func(declaration): declaration.type_parameters)

		Check.RecordDeclaration(owner):
			inventory_records(context.parsed.declarations)
				.get(record_number(owner))
				.map(pure func(row): row.declaration.type_parameters)

	written: WrittenName ?= match found_parameters:
		Some(parameters):
			match parameters.get(Check.parameter_position(id)):
				Some(written):
					Ok(written)
				None:
					Err(render_fault(span, Errors.ParameterOwnerWithoutParameter(id)))
		None:
			Err(render_fault(span, Errors.InvalidParameterDeclaration(id)))

	match name_spelling(context.parsed.names, written.id):
		Some(spelling):
			Ok(spelling)
		None:
			Err(render_fault(span, Errors.InvalidParameterName(id)))



private pure func type_spelling(
	value: Check.TypeRef,
	context: RenderContext,
	span: Span,
) -> Result[String, Diagnostic]:
	match value:
		Check.CallableType(purity, parameters, result):
			match type_spellings(parameters, context, span, []):
				Err(error): Err(error)
				Ok(spelled):
					match type_spelling(result, context, span):
						Err(error): Err(error)
						Ok(returned):
							prefix: String = match purity:
								Pure: "pure ("
								Impure: "("
							Ok("${prefix}${comma_separated(spelled)}) -> ${returned}")
		Check.OpaqueType(id):
			match inventory_opaques(context.parsed.declarations).get(opaque_number(id)):
				Some(declaration): parsed_spelling(declaration.declaration.type_name.id, context.parsed.names, span)
				None: Err(render_fault(span, Errors.InvalidOpaqueDeclaration(id)))
		Check.RecordType(id):
			match inventory_records(context.parsed.declarations).get(record_number(id)):
				Some(declaration): parsed_spelling(declaration.declaration.type_name.id, context.parsed.names, span)
				None: Err(render_fault(span, Errors.InvalidRecordDeclaration(id)))
		Check.IntType | Check.FloatType | Check.VoidType | Check.StringType:
			builtin_spelling(value, context, span)
		Check.TupleType(elements):
			match type_spellings(elements, context, span, []):
				Ok(spelled): Ok("(${comma_separated(spelled)})")
				Err(error): Err(error)
		Check.ListType(element):
			match builtin_spelling(value, context, span):
				Ok(name):
					match type_spelling(element, context, span):
						Ok(child):
							Ok(
								"${name}[${child}]",
							)
						Err(error): Err(error)
				Err(error): Err(error)
		Check.ParameterType(id):
			parameter_spelling(id, context, span)
		Check.UnionType(id):
			match inventory_unions(context.parsed.declarations).get(union_number(id)):
				Some(declaration): parsed_spelling(declaration.type_name.id, context.parsed.names, span)
				None: Err(render_fault(span, Errors.InvalidResolvedUnion(id)))
		Check.AppliedUnionType(id, arguments):
			match type_spelling(
				Check.UnionType(id),
				context,
				span,
			):
				Ok(name):
					match type_spellings(arguments, context, span, []):
						Ok(spelled):
							Ok(
								"${name}[${comma_separated(spelled)}]",
							)
						Err(error): Err(error)
				Err(error): Err(error)
		Check.AppliedRecordType(id, arguments):
			match type_spelling(
				Check.RecordType(id),
				context,
				span,
			):
				Ok(name):
					var spelling = "${name}["
					var failure: Option[Diagnostic] = None
					var position: Int = 0

					for argument in arguments:
						match type_spelling(argument, context, span):
							Ok(argument_type):
								if IntOps.equals(position, 0).not():
									spelling = "${spelling}, "

								spelling = spelling.concat(argument_type)
							Err(error):
								failure = Some(error)
								break

						position = IntOps.add(position, 1)

					match failure:
						Some(error):
							Err(error)
						None:
							Ok("${spelling}]")
				Err(error): Err(error)


-- The parts in order, separated by commas.
private pure func comma_separated(parts: List[String]) -> String:
	match parts:
		[]:
			""
		[first, ...rest]:
			var text = first

			for part in rest:
				text = "${text}, ${part}"

			text


private pure func type_spellings(
	values: List[Check.TypeRef],
	context: RenderContext,
	span: Span,
	spelled: List[String],
) -> Result[List[String], Diagnostic]:
	match values:
		[]:
			Ok(spelled)
		[value, ...rest]:
			match type_spelling(value, context, span):
				Ok(spelling):
					type_spellings(
						rest,
						context,
						span,
						spelled.append(spelling),
					)
				Err(error): Err(error)


private pure func render_pattern_witness(witness: Errors.PatternWitness, span: Span, context: RenderContext) -> Result[String, Diagnostic]:
	match witness:
		Errors.AnyWitness | Errors.OtherStringWitness: Ok("_")
		Errors.EmptyListWitness: Ok("[]")
		Errors.ConsListWitness(_): render_list_witness(witness, span, context)
		Errors.VariantWitness(id, fields): render_variant_witness(id, fields, span, context)
		Errors.TupleWitness(fields):
			match witness_field_names(fields, span, context):
				Ok(parts): Ok("(${comma_separated(parts)})")
				Err(error): Err(error)


private pure func render_variant_witness(id: VariantId, fields: List[Errors.PatternWitness], span: Span, context: RenderContext) -> Result[String, Diagnostic]:
	declaration ?= inventory_unions(context.parsed.declarations).get(union_number(variant_owner(id))).to_result(render_fault(span, Errors.InvalidResolvedUnion(variant_owner(id))))
	variant ?= declaration.variants.get(variant_number(id)).to_result(render_fault(span, Errors.InvalidResolvedVariant(id)))
	name ?= parsed_spelling(variant.declaration.name.id, context.parsed.names, span)
	parts ?= witness_field_names(fields, span, context)
	if fields.is_empty():
		Ok(name)
	else:
		Ok("${name}(${comma_separated(parts)})")


private pure func witness_field_names(fields: List[Errors.PatternWitness], span: Span, context: RenderContext) -> Result[List[String], Diagnostic]:
	var names: List[String] = []
	var failure: Option[Diagnostic] = None
	for field in fields:
		match render_pattern_witness(field, span, context):
			Ok(name): names = names.append(name)
			Err(error):
				failure = Some(error)
				break
	ready: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	Ok(names)


private pure func list_witness_incomplete(complete: Bool) -> Bool:
	match complete:
		True: False
		False: True


private pure func render_list_witness(witness: Errors.PatternWitness, span: Span, context: RenderContext) -> Result[String, Diagnostic]:
	var names: List[String] = []
	var cursor = witness
	var failure: Option[Diagnostic] = None
	var complete: Bool = False
	while list_witness_incomplete(complete):
		match cursor:
			Errors.ConsListWitness(parts):
				match render_pattern_witness(parts.head, span, context):
					Ok(name): names = names.append(name)
					Err(error):
						failure = Some(error)
						complete = True
				cursor = parts.tail
			Errors.EmptyListWitness: complete = True
			_:
				names = names.append("..._")
				complete = True
	ready: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	Ok("[${comma_separated(names)}]")


private pure func missing_variant_name(
	id: VariantId,
	span: Span,
	context: RenderContext,
) -> Result[String, Diagnostic]:
	declaration ?= inventory_unions(context.parsed.declarations)
		.get(union_number(variant_owner(id)))
		.to_result(render_fault(span, Errors.InvalidResolvedUnion(variant_owner(id))))
	variant ?= declaration.variants
		.get(variant_number(id))
		.to_result(render_fault(span, Errors.InvalidResolvedVariant(id)))
	name ?= parsed_spelling(variant.declaration.name.id, context.parsed.names, span)

	if variant.declaration.fields.is_empty():
		Ok(name)
	else:
		var positions: List[String] = []

		for field in variant.declaration.fields:
			positions = positions.append("_")

		Ok("${name}(${comma_separated(positions)})")


private pure func variant_spellings(
	remaining: List[VariantId],
	context: RenderContext,
	span: Span,
	spelled: List[String],
) -> Result[List[String], Diagnostic]:
	match remaining:
		[]:
			Ok(spelled)
		[id, ...rest]:
			match missing_variant_name(id, span, context):
				Ok(name):
					variant_spellings(
						rest,
						context,
						span,
						spelled.append(name),
					)
				Err(error): Err(error)


private pure func missing_coverage(
	remaining: List[VariantId],
	span: Span,
	context: RenderContext,
) -> Diagnostic:
	match variant_spellings(remaining, context, span, []):
		Err(error):
			error
		Ok(names):
			prefix = if IntOps.equals(remaining.length(), 1):
				"add an arm for the missing variant: "
			else:
				"add arms for the missing variants: "

			rendered(
				span,
				"non-exhaustive match",
				Text.concat(prefix, comma_separated(names)),
			)


private pure func type_diagnostic(
	span: Span,
	message: String,
	expected_type: Check.TypeRef,
	context: RenderContext,
) -> Diagnostic:
	match expected_type:
		Check.ParameterType(_):
			rendered(
				span,
				message,
				"use a value already typed as this declaration's type parameter",
			)
		_:
			match type_spelling(expected_type, context, span):
				Err(error):
					error
				Ok(spelling):
					rendered(
						span,
						message,
						"use an expression of type ${spelling} here",
					)


private pure func overlap_notes(primary: Span, site: Errors.MethodCandidateSite, receiver: String) -> List[NoteLine]:
	var lines: List[NoteLine] = []
	if same_span(site.declaration, primary).not():
		lines = lines.append({ span = site.declaration, text = "receiver ${receiver} is declared here" })
	match site.import_site:
		None: void
		Some(selection):
			if same_span(selection, primary).not():
				lines = lines.append({ span = selection, text = "receiver ${receiver} is imported here" })
	lines


private pure func render_receiver_overlap(span: Span, name: NameId, overlap: Errors.ReceiverOverlap, context: RenderContext) -> Result[Diagnostic, Diagnostic]:
	spelling ?= parsed_spelling(name, context.parsed.names, span)
	introduced ?= type_spelling(overlap.introduced_receiver, context, span)
	other ?= type_spelling(overlap.other_receiver, context, span)
	Ok(noted(
		span,
		"two functions named ${spelling} can accept the same receiver",
		"rename one of them, or change a first parameter so that no value fits both receivers, ${introduced} and ${other}",
		NoteLines(overlap_notes(span, overlap.introduced, introduced).concat(overlap_notes(span, overlap.other, other))),
	))


private pure func render_trait_error(span: Span, rejection: Errors.TraitError, context: RenderContext) -> Diagnostic:
	match rejection:
		Errors.DuplicateRequirementParameter(_, previous): binding_conflict(span, previous.id, "parameter", "function", previous.span, context)
		Errors.DifferentMethodFamilies(_, _, previous): noted(span, "different trait method families share this name", "select one family, or reach the other through a module alias", PreviousDeclaration(previous))
		Errors.FamilyFunctionConflict(_, _, previous): noted(span, "trait method family conflicts with a free function", "rename the free function, or import one declaration through a module alias", PreviousDeclaration(previous))
		Errors.ImpureRequirement(_): rendered(span, "trait requirements must be pure", "declare a pure func requirement and a pure implementation")
		Errors.GenericRequirement(_): rendered(span, "trait methods cannot declare type parameters", "use Self and ordinary concrete parameter types")
		Errors.FirstParameterMustBeSelf(_): rendered(span, "a trait method's first parameter must be Self", "write a first parameter such as value: Self")
		Errors.CallableFormalDeferred(_): rendered(span, "trait callable parameters are not supported yet", "use ordinary value parameters; callable formal ownership requires a later increment")
		Errors.IndependentImplementationParameters: rendered(span, "implementation methods cannot introduce type parameters", "declare all parameters on the implementation receiver and use them in each method")
		Errors.InvalidTraitBound: rendered(span, "type parameter bound requires a visible trait", "import a parameterless trait and name it after ':' or '+'")
		Errors.DuplicateReceiverParameter(previous): noted(span, "implementation receiver repeats a type parameter", "introduce a distinct fresh parameter for every receiver argument", PreviousDeclaration(previous.span))
		Errors.ReceiverParameterCount(_, _): rendered(span, "implementation receiver must introduce its complete type parameter family", "write one distinct fresh parameter for every receiver argument; specialized or nested receiver patterns are not supported")
		Errors.MissingTraitBound(_, _): rendered(span, "type does not satisfy the required trait bound", "add the required trait to this function's type parameter bounds, or provide an implementation for the concrete receiver")
		Errors.OrphanImplementation(_, _): rendered(span, "implementation belongs to neither the trait nor receiver module", "declare it beside the trait or receiver type; foundation types may be implemented by their library")
		Errors.DuplicateImplementation(_, _, previous): noted(span, "this trait already has an implementation for the receiver", "keep one implementation for each trait and receiver head", PreviousDeclaration(previous))
		Errors.MissingImplementationMethod(_): rendered(span, "implementation is missing a required method", "provide each abstract requirement, or add a default body to the trait")
		Errors.UnknownImplementationMethod(_): rendered(span, "implementation method is not declared by the trait", "remove this method or add a matching requirement to the trait")
		Errors.DuplicateImplementationMethod(_, previous): noted(span, "implementation repeats a method", "provide each required method once", PreviousDeclaration(previous))
		Errors.ImplementationSignatureMismatch(_, _, _): rendered(span, "implementation signature does not match the trait requirement", "match the requirement's purity, parameter types and return type, replacing Self with the receiver")
		Errors.MalformedCanonicalTrait(_): rendered(span, "canonical Equatable requires pure equals(Self, Self) -> Bool as its sole abstract method", "keep equals abstract; additional pure methods require default bodies")
		Errors.MissingImplementation(_, _): rendered(span, "receiver does not implement this trait", "declare a matching implementation; generic functions must declare their required trait bounds")
		Errors.GenericEqualityDeferred(_, member):
			message = "automatic equality for generic aggregate heads is not supported yet"
			help = "write an explicit full-family Equatable implementation for this type; automatic generic equality is a later increment"
			match member:
				None: rendered(span, message, help)
				Some(site): equality_member_diagnostic(span, message, help, site, context)
		Errors.EqualityMemberUnsupported(_, _, member): equality_member_diagnostic(span,
			"automatic equality is unavailable for a field or payload",
			"provide the member's required trait implementation, or write an Equatable implementation for the containing type", member, context)
		Errors.MethodNeedsExpectedType(_): rendered(span, "trait method reference needs a callable type that determines Self", "add a callable type annotation or pass the method to a typed callable parameter")


private pure func equality_member_diagnostic(span: Span, message: String, help: String, member: Check.EqualityMember, context: RenderContext) -> Diagnostic:
	match member:
		Check.EqualityField(field):
			match inventory_records(context.parsed.declarations).get(record_number(Check.field_owner(field))):
				Some(record_row):
					match record_row.declaration.fields.get(Check.field_number(field)):
						Some(declaration): noted(span, message, help, RecordFieldDeclaration(type_span(declaration.type_name)))
						None: render_fault(span, Errors.InvalidFunctionContract)
				None: render_fault(span, Errors.InvalidFunctionContract)
		Check.EqualityPayload(variant, position):
			match inventory_unions(context.parsed.declarations).get(union_number(variant_owner(variant))):
				Some(union_row):
					match union_row.variants.get(variant_number(variant)):
						Some(row):
							match row.declaration.fields.get(position):
								Some(declaration): noted(span, message, help, UnionPayloadDeclaration(type_span(declaration)))
								None: render_fault(span, Errors.InvalidFunctionContract)
						None: render_fault(span, Errors.InvalidResolvedVariant(variant))
				None: render_fault(span, Errors.InvalidResolvedUnion(variant_owner(variant)))


-- A normalized Self alias spells only its exact bare parameter. Self=Box[T]
-- must leave the genuine header binder T named T inside other type expressions.
private pure func accepted_parameter_spelling(id: Check.TypeParameterId, function: AcceptedFunction, context: RenderContext, span: Span) -> Result[String, Diagnostic]:
	var written: Option[WrittenName] = None
	for parameter in function.body_types.parameters:
		if Check.same_parameter(parameter.id, id):
			written = Some(parameter.name)
	match written:
		Some(name): parsed_spelling(name.id, context.parsed.names, span)
		None:
			match function.body_types.self_binding:
				Some(binding):
					if Check.same_type(binding.value_type, Check.ParameterType(id)):
						Ok("Self")
					else:
						Err(render_fault(span, Errors.ParameterOwnerWithoutParameter(id)))
				None: Err(render_fault(span, Errors.ParameterOwnerWithoutParameter(id)))


private pure func parameter_spelling(id: Check.TypeParameterId, context: RenderContext, span: Span) -> Result[String, Diagnostic]:
	match Check.parameter_owner(id):
		Check.TraitDeclaration(_): Ok("Self")
		Check.FunctionDeclaration(owner):
			if context.functions.is_empty():
				ordinary_parameter_spelling(id, context, span)
			else:
				match context.functions.get(function_number(owner)):
					Some(function): accepted_parameter_spelling(id, function, context, span)
					None: Err(render_fault(span, Errors.InvalidParameterDeclaration(id)))
		_: ordinary_parameter_spelling(id, context, span)
