---
Accepts every constant annotation before signatures and closed construction templates.
The temporary headers disappear when the dense complete rows are published.
---
import:
	./traits: TraitAvailability, accepted_traits
	./declarations: TypeScope, resolve_type, type_access
	./errors:
		CheckError,
		CheckerInvariant(InvalidConstantDeclaration), checker_invariant,
	./model:
		CheckedConstant, CheckedRecord, CheckedUnion,
		TypeUse
	../namespace/namespace: Namespace
	../parse/assemble: ParsedContents
	result: Result methods
	../utils/ids: constant_number, inventory_constants, inventory_records, inventory_unions
	../utils/syntax: type_span
	./constructors: ConstructionContext
	./signatures: AcceptedFunction
	./expressions: check_constant_initializer


pure func constant_annotations(parsed: ParsedContents, namespace: Namespace) -> Result[List[TypeUse], CheckError]:
	var accepted: List[TypeUse] = []
	var failure: Option[CheckError] = None
	for row in inventory_constants(parsed.declarations):
		declaration = row.declaration
		scope: TypeScope = {
			self_binding = None,
			records = inventory_records(parsed.declarations),
			unions = inventory_unions(parsed.declarations),
			namespace = namespace,
			module = declaration.module,
			access = type_access(declaration.visibility, declaration.name.id),
			parameters = [],
		}
		match resolve_type(scope, declaration.type_name):
			Ok(value_type): accepted = accepted.append({ value_type = value_type, span = type_span(declaration.type_name) })
			Err(error):
				failure = Some(error)
				break
	match failure:
		Some(error): Err(error)
		None: Ok(accepted)


pure func validate_constants(
	parsed: ParsedContents, namespace: Namespace, annotations: List[TypeUse],
	records: List[CheckedRecord], unions: List[CheckedUnion], signatures: List[AcceptedFunction], traits: TraitAvailability,
) -> Result[List[CheckedConstant], CheckError]:
	var accepted: List[CheckedConstant] = []
	var failure: Option[CheckError] = None
	for row in inventory_constants(parsed.declarations):
		result = match annotations.get(constant_number(row.id)):
			Some(annotation):
				context: ConstructionContext = { module = row.declaration.module, namespace = namespace, records = records, unions = unions }
				check_constant_initializer(row.declaration.value, annotation, context, signatures, traits).map(pure func(value) -> CheckedConstant: {
					id = row.id, annotation = annotation.span, value = value
				})
			None: Err(checker_invariant(row.declaration.name.span, InvalidConstantDeclaration(row.id)))
		match result:
			Ok(constant): accepted = accepted.append(constant)
			Err(error):
				failure = Some(error)
				break
	match failure:
		Some(error): Err(error)
		None: Ok(accepted)
