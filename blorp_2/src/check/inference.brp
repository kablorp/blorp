---
Body-local inference state: variables, slots, unification, hint propagation, call
admission and the pending value tree. Only complete types leave through
publish_inference_type; temporary inference variables never become published TypeRefs.
---
import:
	result as ResultOps
	../utils/boolean: not, and, or
	./callables:
		FunctionContract, ReceiverCandidate, ResolvedReceiver(UniqueReceiver, ReceiverCandidates),
		ResolutionContext, method_sites, receiver_contract
	./model:
		CheckedExpr, BindingId, CaptureId, ScopedBindingId, LambdaId, CallableParameterId, CheckedCallOperand, FunctionSignature,
		CallIdentity(DeclaredTarget, ParameterTarget, ValueTarget),
		FieldId,
		CheckedCall,
		TypeParameterId,
		TypeRef(TupleType, CallableType, ListType, AppliedRecordType, AppliedUnionType, ParameterType),
		TypeUse,
		CallTarget(UserFunction, CallableParameter, ValueCall),
		same_type,
		same_parameter,
		parameter_position,
		type_head
	./errors:
		CheckError,
		MethodError(AmbiguousMethod, NoApplicableMethod), method_error,
		ExpectedTypeSite(SourceAnnotation),
		ValueError(ExpressionTypeMismatch), value_error,
		CallError(ArgumentTypeMismatch, GenericArgumentConflict, UninferableTypeParameter, InfiniteTypeArgument),
		CheckerInvariant(GenericConstructorContract, InvalidInferenceVariable, InvalidInferenceWorklist, InvalidFunctionContract, MissingCallParameter, MissingGenericParameter),
		call_error,
		checker_invariant
	../utils/ids: FunctionId, OpaqueId, RecordId, UnionId, VariantId, record_number, union_number
	../utils/syntax: Purity, same_purity, Span, WrittenName, ReceiverApplication
	../namespace/namespace: same_head
	int as IntOps
	option: to_result, map, get_or, is_none, is_some


fixed record ExpectedValue {
	value_type: TypeRef,
	site: ExpectedTypeSite
}


fixed record PendingRetainedField { field: FieldId, value_type: InferenceType }


fixed record PendingRecordField {
	field: FieldId,
	expected: InferenceUse,
	value: PendingValue
}


-- The scheduling boundary consumes the resolved identity. Stored callees are
-- already accepted local/capture reads, not another pending inference tree.
fixed union PendingCallTarget:
	PendingDeclared(FunctionId)
	PendingParameter(CallableParameterId)
	PendingStored(CheckedExpr)


fixed record PendingCall {
	target: PendingCallTarget,
	signature: FunctionSignature,
	span: Span,
	variable_start: Int
}


pure func static_pending_call(contract: FunctionContract, start: Int) -> Result[PendingCall, CheckError]:
	selected: Result[PendingCallTarget, CheckError] = match contract.target:
		DeclaredTarget(id): Ok(PendingDeclared(id))
		ParameterTarget(id): Ok(PendingParameter(id))
		ValueTarget(_): Err(checker_invariant(contract.span, InvalidFunctionContract))
	target ?= selected
	Ok({ target = target, signature = contract.signature, span = contract.span, variable_start = start })


-- Only leaves are accepted before freezing: they have no children to infer.
fixed union PendingBase:
	AcceptedVoid
	AcceptedInteger(Int)
	AcceptedFloat(Float)
	AcceptedString(String)
	AcceptedBinding(BindingId)
	AcceptedCapture(CaptureId)
	PendingCapture(ScopedBindingId)
	PendingNamedCallable(FunctionId, FunctionSignature, Int)
	PendingForwardedCallable(CallableParameterId)
	PendingLambda(LambdaId)
	PendingDirectCall(PendingCall, List[PendingValue])
	PendingConstructRecord(RecordId, List[PendingRecordField])
	PendingUpdateRecord(RecordId, PendingValue, Span, List[PendingRecordField], List[PendingRetainedField])
	PendingConstructVariant(PendingVariantContract, List[PendingValue])
	PendingConstructTuple(List[PendingValue])
	PendingConstructList(ListElementSource, List[PendingValue])
	PendingConstructOpaque(OpaqueId, TypeRef, PendingValue)
	PendingProjectOpaque(OpaqueId, PendingValue)


-- Where a list literal's element type comes from: the expected List's element
-- when the context establishes one, otherwise the literal's first element.
fixed union ListElementSource:
	ExpectedElementType(InferenceType)
	FirstElementType


fixed union PendingOperation:
	AcceptedTupleElement(Int)
	AcceptedField(FieldId)
	PendingInvocation(PendingCall, List[PendingValue])


fixed record PendingStep {
	operation: PendingOperation,
	value_type: InferenceType,
	span: Span
}


-- Extension shares one immutable link, rather than copying an operation prefix.
-- Freeze walks these links once and publishes the existing source-order vector.
fixed union PendingOperations:
	NoPendingOperations
	PendingOperationLink(PendingStep, PendingOperations)


fixed record PendingValue {
	span: Span,
	readiness: InferenceReadiness,
	base: PendingBase,
	base_type: InferenceType,
	base_span: Span,
	operations: PendingOperations
}


pure func pending_type(value: PendingValue) -> InferenceType:
	match value.operations:
		PendingOperationLink(step, _): step.value_type
		NoPendingOperations: value.base_type


private pure func parameter_in_type(parameter: TypeParameterId, value_type: TypeRef) -> Bool:
	match value_type:
		ParameterType(actual):
			same_parameter(parameter, actual)
		CallableType(purity, parameters, result):
			match parameters.any(pure func(value): parameter_in_type(parameter, value)):
				True: True
				False: parameter_in_type(parameter, result)
		TupleType(elements): elements.any(pure func(element): parameter_in_type(parameter, element))
		ListType(element):
			parameter_in_type(parameter, element)
		AppliedRecordType(_, arguments):
			var found: Bool = False

			for argument in arguments:
				if parameter_in_type(parameter, argument):
					found = True
					break

			found
		AppliedUnionType(_, arguments):
			var found: Bool = False

			for argument in arguments:
				if parameter_in_type(parameter, argument):
					found = True
					break

			found
		_:
			False


pure func inference_complete(value_type: InferenceType, slots: List[InferenceSlot], span: Span) -> Result[Bool, CheckError]:
	head ?= inference_head(value_type, slots, span)

	match head:
		CallVariable(_): Ok(False)
		AcceptedType(_): Ok(True)
		InferredCallable(purity, parameters, result):
			var complete: Bool = True
			var failure: Option[CheckError] = None
			for child in parameters.append(result):
				match inference_complete(child, slots, span):
					Ok(ready):
						if ready.not():
							complete = False
							break
					Err(error):
						failure = Some(error)
						break
			match failure:
				Some(error): Err(error)
				None: Ok(complete)
		InferredList(element): inference_complete(element, slots, span)
		InferredTuple(arguments):
			var complete: Bool = True
			var failure: Option[CheckError] = None

			for argument in arguments:
				match inference_complete(argument, slots, span):
					Err(error):
						failure = Some(error)
						break
					Ok(value):
						if value.not():
							complete = False
							break

			match failure:
				Some(error): Err(error)
				None: Ok(complete)
		InferredRecord(_, arguments):
			var complete: Bool = True
			var failure: Option[CheckError] = None

			for argument in arguments:
				match inference_complete(argument, slots, span):
					Err(error):
						failure = Some(error)
						break
					Ok(value):
						if value.not():
							complete = False
							break

			match failure:
				Some(error): Err(error)
				None: Ok(complete)
		InferredUnion(_, arguments):
			var complete: Bool = True
			var failure: Option[CheckError] = None

			for argument in arguments:
				match inference_complete(argument, slots, span):
					Err(error):
						failure = Some(error)
						break
					Ok(value):
						if value.not():
							complete = False
							break

			match failure:
				Some(error): Err(error)
				None: Ok(complete)


pure func call_inference_ready(call: PendingCall, slots: List[InferenceSlot]) -> Result[Bool, CheckError]:
	var complete: Bool = True
	var failure: Option[CheckError] = None

	for parameter in call.signature.type_parameters:
		variable: InferenceType = CallVariable(into_opaque InferenceVariableId(IntOps.add(call.variable_start, parameter_position(parameter))))

		match inference_complete(variable, slots, call.span):
			Err(error):
				failure = Some(error)
				break
			Ok(ready):
				if ready.not():
					complete = False

					if parameter_in_type(parameter, call.signature.return_type.value_type).not():
						failure = Some(call_error(call.span, UninferableTypeParameter(parameter)))
						break

	match failure:
		Some(error): Err(error)
		None: Ok(complete)


pure func pending_arguments(values: List[PendingValue]) -> List[InferenceUse]:
	var arguments: List[InferenceUse] = []

	for value in values:
		arguments = arguments.append({ value_type = pending_type(value), span = value.span })

	arguments


-- Traverse the written callee signature, never a complete substitution's
-- ancestry. Replacements remain terminal under simultaneous substitution.
pure func admit_call_type(written: TypeRef, call: PendingCall, slots: List[InferenceSlot], span: Span) -> Result[TypeRef, CheckError]:
	if call.signature.type_parameters.is_empty():
		Ok(written)
	else:
		match written:
			TupleType(_) | CallableType(_, _, _):
				publish_inference_type(inference_type(written, call.signature.type_parameters, call.variable_start), slots, CompleteInference, span)
			ListType(element):
				match admit_call_type(element, call, slots, span):
					Ok(value): Ok(ListType(value))
					Err(error): Err(error)
			AppliedRecordType(owner, arguments):
				var values: List[TypeRef] = []
				var failure: Option[CheckError] = None

				for argument in arguments:
					match admit_call_type(argument, call, slots, span):
						Ok(value): values = values.append(value)
						Err(error):
							failure = Some(error)
							break

				match failure:
					Some(error): Err(error)
					None: Ok(AppliedRecordType(owner, values))
			AppliedUnionType(owner, arguments):
				var values: List[TypeRef] = []
				var failure: Option[CheckError] = None

				for argument in arguments:
					match admit_call_type(argument, call, slots, span):
						Ok(value): values = values.append(value)
						Err(error):
							failure = Some(error)
							break

				match failure:
					Some(error): Err(error)
					None: Ok(AppliedUnionType(owner, values))
			ParameterType(_):
				publish_inference_type(inference_type(written, call.signature.type_parameters, call.variable_start), slots, CompleteInference, span)
			_: Ok(written)


pure func admit_call_parameters(call: PendingCall, slots: List[InferenceSlot]) -> Result[List[TypeUse], CheckError]:
	if call.signature.type_parameters.is_empty():
		Ok(call.signature.parameters)
	else:
		var parameters: List[TypeUse] = []
		var failure: Option[CheckError] = None

		for written in call.signature.parameters:
			match admit_call_type(written.value_type, call, slots, written.span):
				Ok(value): parameters = parameters.append({ written | value_type = value })
				Err(error):
					failure = Some(error)
					break

		match failure:
			Some(error): Err(error)
			None: Ok(parameters)


-- Called only after closed-child readiness and own-slot completion, or after
-- child-first freeze and call publication. Rechecking completeness here
-- would rescan every growing nested term without establishing another fact.
pure func validate_complete_arguments(contract: PendingCall, parameters: List[TypeUse], return_type: TypeRef, actual: List[InferenceUse], slots: List[InferenceSlot]) -> Result[TypeRef, CheckError]:
	var failure: Option[CheckError] = None
	var position = 0

	for value in actual:
		match validate_complete_argument(contract, parameters, position, value, slots):
			Err(error):
				failure = Some(error)
				break
			Ok(_):
				void

		position = IntOps.add(position, 1)

	match failure:
		Some(error): Err(error)
		None: Ok(return_type)


private pure func validate_complete_argument(contract: PendingCall, parameters: List[TypeUse], position: Int, actual: InferenceUse, slots: List[InferenceSlot]) -> Result[Void, CheckError]:
	written ?= parameters.get(position).to_result(checker_invariant(contract.span, MissingCallParameter(position)))
	expected = written.value_type
	value ?= publish_inference_type(actual.value_type, slots, CompleteInference, actual.span)

	if same_type(expected, value):
		Ok(void)
	else:
		span = if IntOps.equals(contract.signature.parameters.length(), 1):
			contract.span
		else:
			actual.span

		Err(call_error(span, ArgumentTypeMismatch({
			expected = expected,
			actual = { value_type = value, span = actual.span },
			argument_position = position,
			expected_site = SourceAnnotation(written.span),
		})))


-- These hints choose a constructor's already established nominal head. They are
-- advisory: only the expression's argument-first solver establishes call types.
-- Hints preserve common shape, never establish an equality between fresh slots.
-- Retain the first unresolved reference so diagnostic origins follow source order.
private pure func merge_hint(first: InferenceType, next: InferenceType, slots: List[InferenceSlot], span: Span) -> Result[Option[InferenceType], CheckError]:
	left ?= inference_head(first, slots, span)
	right ?= inference_head(next, slots, span)

	match inference_action(left, right):
		SameInference: Ok(Some(first))
		MergeInference(_, _): Ok(Some(first))
		BindInference(_, known): Ok(Some(known))
		CallableEquality(purity, parameters, others, result, other):
			var values: List[InferenceType] = []
			var complete: Bool = True
			var failure: Option[CheckError] = None
			var position = 0
			for parameter in parameters:
				match merge_hint_child(parameter, others, position, slots, span):
					Ok(Some(value)): values = values.append(value)
					Ok(None): complete = False
					Err(error): failure = Some(error)
				if or(complete.not(), failure.is_some()):
					break
				position = IntOps.add(position, 1)
			match failure:
				Some(error): Err(error)
				None:
					if complete.not():
						Ok(None)
					else:
						match merge_hint(result, other, slots, span):
							Err(error): Err(error)
							Ok(None): Ok(None)
							Ok(Some(value)):
								match retained_hint(left, right):
									Some(retained): Ok(Some(retained))
									None: Ok(Some(InferredCallable(purity, values, value)))
		ListEquality(left_element, right_element):
			match merge_hint(left_element, right_element, slots, span):
				Ok(merged):
					match merged:
						None: Ok(None)
						Some(value):
							match retained_hint(left, right):
								Some(retained): Ok(Some(retained))
								None: Ok(Some(list_inference_type(value)))
				Err(error): Err(error)
		TupleEquality(left_arguments, right_arguments):
			retained = retained_hint(left, right)
			var values: List[InferenceType] = []
			var position = 0
			var complete: Bool = True
			var failure: Option[CheckError] = None

			for argument in left_arguments:
				match merge_hint_child(argument, right_arguments, position, slots, span):
					Err(error):
						failure = Some(error)
						break
					Ok(None):
						complete = False
						break
					Ok(Some(value)):
						if retained.is_none():
							values = values.append(value)

				position = IntOps.add(position, 1)

			match failure:
				Some(error): Err(error)
				None:
					if complete:
						match retained:
							Some(value): Ok(Some(value))
							None: Ok(Some(tuple_inference_type(values)))
					else:
						Ok(None)
		RecordEquality(left_arguments, right_arguments):
			owner_result: Result[RecordId, CheckError] = match left:
				InferredRecord(owner, _): Ok(owner)
				AcceptedType(AppliedRecordType(owner, _)): Ok(owner)
				_: Err(checker_invariant(span, InvalidInferenceWorklist))
			match owner_result:
				Ok(owner):
					retained = retained_hint(left, right)
					var values: List[InferenceType] = []
					var position = 0
					var complete: Bool = True
					var failure: Option[CheckError] = None

					for argument in left_arguments:
						match merge_hint_child(argument, right_arguments, position, slots, span):
							Err(error):
								failure = Some(error)
								break
							Ok(None):
								complete = False
								break
							Ok(Some(value)):
								if retained.is_none():
									values = values.append(value)

						position = IntOps.add(position, 1)

					match failure:
						Some(error): Err(error)
						None:
							if complete:
								match retained:
									Some(value): Ok(Some(value))
									None: Ok(Some(substituted_record(owner, values)))
							else:
								Ok(None)
				Err(error): Err(error)
		UnionEquality(left_arguments, right_arguments):
			owner_result: Result[UnionId, CheckError] = match left:
				InferredUnion(owner, _): Ok(owner)
				AcceptedType(AppliedUnionType(owner, _)): Ok(owner)
				_: Err(checker_invariant(span, InvalidInferenceWorklist))
			match owner_result:
				Ok(owner):
					retained = retained_hint(left, right)
					var values: List[InferenceType] = []
					var position = 0
					var complete: Bool = True
					var failure: Option[CheckError] = None

					for argument in left_arguments:
						match merge_hint_child(argument, right_arguments, position, slots, span):
							Err(error):
								failure = Some(error)
								break
							Ok(None):
								complete = False
								break
							Ok(Some(value)):
								if retained.is_none():
									values = values.append(value)

						position = IntOps.add(position, 1)

					match failure:
						Some(error): Err(error)
						None:
							if complete:
								match retained:
									Some(value): Ok(Some(value))
									None: Ok(Some(substituted_union(owner, values)))
							else:
								Ok(None)
				Err(error): Err(error)
		InferenceMismatch: Ok(None)


private pure func retained_hint(left: InferenceType, right: InferenceType) -> Option[InferenceType]:
	match left:
		AcceptedType(_): Some(left)
		_:
			match right:
				AcceptedType(_): Some(right)
				_: None


private pure func merge_hint_child(first: InferenceType, next: List[InferenceType], position: Int, slots: List[InferenceSlot], span: Span) -> Result[Option[InferenceType], CheckError]:
	value ?= next.get(position).to_result(checker_invariant(span, InvalidInferenceWorklist))
	merge_hint(first, value, slots, span)


private pure func hint_atom_matches(expected: TypeRef, known: InferenceType) -> Bool:
	match known:
		AcceptedType(actual): same_type(expected, actual)
		CallVariable(_): True
		_: False


fixed record PendingVariantContract {
	variant: VariantId,
	result_type: InferenceType,
	fields: List[InferenceUse],
	span: Span
}


private fixed record HintEquality {
	pattern: TypeRef,
	known: InferenceType
}


private pure func push_hint_equality(work: List[HintEquality], depth: Int, equality: HintEquality) -> List[HintEquality]:
	if IntOps.less_than(depth, work.length()):
		work.set(depth, equality)
	else:
		work.append(equality)


private pure func hint_child(patterns: List[TypeRef], known: List[InferenceType], position: Int, span: Span) -> Result[HintEquality, CheckError]:
	pattern ?= patterns.get(position).to_result(checker_invariant(span, InvalidInferenceWorklist))
	value ?= known.get(position).to_result(checker_invariant(span, InvalidInferenceWorklist))
	Ok({ pattern = pattern, known = value })


private pure func project_result_hint(contract: PendingCall, result_hint: InferenceType, slots: List[InferenceSlot]) -> Result[Option[List[Option[InferenceType]]], CheckError]:
	var hints: List[Option[InferenceType]] = []

	for parameter in contract.signature.type_parameters:
		hints = hints.append(None)

	var work: List[HintEquality] = [{ pattern = contract.signature.return_type.value_type, known = result_hint }]
	var depth = 1
	var compatible: Bool = True
	var failure: Option[CheckError] = None

	while and(and(IntOps.greater_than(depth, 0), compatible), failure.is_none()):
		depth = IntOps.subtract(depth, 1)

		match work.get(depth):
			None: failure = Some(checker_invariant(contract.span, InvalidInferenceWorklist))
			Some(equality):
				match inference_head(equality.known, slots, contract.span):
					Err(error): failure = Some(error)
					Ok(known):
						match equality.pattern:
							ParameterType(parameter):
								position = parameter_position(parameter)

								match contract.signature.type_parameters.get(position):
									Some(declared):
										if same_parameter(parameter, declared):
											match hints.get(position):
												Some(Some(previous)):
													match merge_hint(previous, equality.known, slots, contract.span):
														Err(error): failure = Some(error)
														Ok(None): compatible = False
														Ok(Some(merged)): hints = hints.set(position, Some(merged))
												Some(None): hints = hints.set(position, Some(equality.known))
												None: failure = Some(checker_invariant(contract.span, InvalidInferenceWorklist))
										else:
											compatible = hint_atom_matches(equality.pattern, known)
									None: compatible = hint_atom_matches(equality.pattern, known)
							CallableType(purity, parameters, result):
								match inference_shape(known):
									InferredCallable(other_purity, others, other):
										compatible = and(same_purity(purity, other_purity), IntOps.equals(parameters.length(), others.length()))
										if compatible:
											work = push_hint_equality(work, depth, { pattern = result, known = other })
											depth = IntOps.add(depth, 1)
											var position = parameters.length()
											while IntOps.greater_than(position, 0):
												position = IntOps.subtract(position, 1)
												match hint_child(parameters, others, position, contract.span):
													Ok(child):
														work = push_hint_equality(work, depth, child)
														depth = IntOps.add(depth, 1)
													Err(error): failure = Some(error)
									_: compatible = False
							ListType(element):
								match inference_shape(known):
									InferredList(known_element):
										work = push_hint_equality(work, depth, { pattern = element, known = known_element })
										depth = IntOps.add(depth, 1)
									_: compatible = False
							TupleType(arguments):
								match inference_shape(known):
									InferredTuple(known_arguments):
										compatible = IntOps.equals(arguments.length(), known_arguments.length())

										if compatible:
											var position = arguments.length()

											-- LIFO pushes reverse so repeated parameters keep their first occurrence.
											while IntOps.greater_than(position, 0):
												position = IntOps.subtract(position, 1)

												match hint_child(arguments, known_arguments, position, contract.span):
													Err(error):
														failure = Some(error)
														break
													Ok(child):
														work = push_hint_equality(work, depth, child)
														depth = IntOps.add(depth, 1)
									_: compatible = False
							AppliedRecordType(owner, arguments):
								match inference_shape(known):
									InferredRecord(known_owner, known_arguments):
										compatible = and(
											IntOps.equals(record_number(owner), record_number(known_owner)),
											IntOps.equals(arguments.length(), known_arguments.length()),
										)

										if compatible:
											var position = arguments.length()

											-- LIFO pushes reverse so repeated parameters keep their first occurrence.
											while IntOps.greater_than(position, 0):
												position = IntOps.subtract(position, 1)

												match hint_child(arguments, known_arguments, position, contract.span):
													Err(error):
														failure = Some(error)
														break
													Ok(child):
														work = push_hint_equality(work, depth, child)
														depth = IntOps.add(depth, 1)
									_: compatible = False
							AppliedUnionType(owner, arguments):
								match inference_shape(known):
									InferredUnion(known_owner, known_arguments):
										compatible = and(
											IntOps.equals(union_number(owner), union_number(known_owner)),
											IntOps.equals(arguments.length(), known_arguments.length()),
										)

										if compatible:
											var position = arguments.length()

											-- LIFO pushes reverse so repeated parameters keep their first occurrence.
											while IntOps.greater_than(position, 0):
												position = IntOps.subtract(position, 1)

												match hint_child(arguments, known_arguments, position, contract.span):
													Err(error):
														failure = Some(error)
														break
													Ok(child):
														work = push_hint_equality(work, depth, child)
														depth = IntOps.add(depth, 1)
									_: compatible = False
							_: compatible = hint_atom_matches(equality.pattern, known)

	match failure:
		Some(error): Err(error)
		None:
			if compatible:
				Ok(Some(hints))
			else:
				Ok(None)


pure func apply_type_hint(value_type: TypeRef, parameters: List[TypeParameterId], hints: List[Option[InferenceType]]) -> Option[InferenceType]:
	if parameters.is_empty():
		Some(AcceptedType(value_type))
	else:
		match value_type:
			ParameterType(parameter):
				match parameters.get(parameter_position(parameter)):
					Some(declared):
						if same_parameter(parameter, declared):
							hints.get(parameter_position(parameter)).get_or(None)
						else:
							Some(inference_type(value_type, [], 0))
					None: Some(inference_type(value_type, [], 0))
			CallableType(purity, children, result):
				var values: List[InferenceType] = []
				var complete: Bool = True
				for child in children:
					match apply_type_hint(child, parameters, hints):
						Some(value): values = values.append(value)
						None: complete = False
				match apply_type_hint(result, parameters, hints):
					Some(value):
						if complete:
							Some(InferredCallable(purity, values, value))
						else:
							None
					None: None
			ListType(element):
				apply_type_hint(element, parameters, hints).map(list_inference_type)
			TupleType(arguments):
				var values: List[InferenceType] = []
				var complete: Bool = True

				for argument in arguments:
					match apply_type_hint(argument, parameters, hints):
						Some(value): values = values.append(value)
						None:
							complete = False
							break

				if complete:
					Some(tuple_inference_type(values))
				else:
					None
			AppliedRecordType(owner, arguments):
				var values: List[InferenceType] = []
				var complete: Bool = True

				for argument in arguments:
					match apply_type_hint(argument, parameters, hints):
						Some(value): values = values.append(value)
						None:
							complete = False
							break

				if complete:
					Some(substituted_record(owner, values))
				else:
					None
			AppliedUnionType(owner, arguments):
				var values: List[InferenceType] = []
				var complete: Bool = True

				for argument in arguments:
					match apply_type_hint(argument, parameters, hints):
						Some(value): values = values.append(value)
						None:
							complete = False
							break

				if complete:
					Some(substituted_union(owner, values))
				else:
					None
			_: Some(inference_type(value_type, [], 0))


pure func call_argument_hints(call: PendingCall, result_hint: Option[InferenceType], slots: List[InferenceSlot]) -> Result[List[Option[InferenceType]], CheckError]:
	projection_result: Result[List[Option[InferenceType]], CheckError] = match result_hint:
		None: Ok([])
		Some(known): ResultOps.map(project_result_hint(call, known, slots), pure func(value): value.get_or([]))
	projection ?= projection_result
	var candidates: List[Option[InferenceType]] = []

	no_projection: Option[InferenceType] = None
	for parameter in call.signature.type_parameters:
		candidate = projection.get(parameter_position(parameter)).get_or(no_projection).get_or(inference_type(ParameterType(parameter), call.signature.type_parameters, call.variable_start))
		candidates = candidates.append(Some(candidate))

	var hints: List[Option[InferenceType]] = []

	for parameter in call.signature.parameters:
		hints = hints.append(apply_type_hint(parameter.value_type, call.signature.type_parameters, candidates))

	Ok(hints)


-- Closed permits eager parent validation: child and own checks are complete.
-- A known result type alone is insufficient; otherwise retain child-first freezing.
fixed union InferenceReadiness:
	ClosedInference
	DeferredInference


pure func record_argument_origin(equality: InferenceEquality, slots: List[InferenceSlot]) -> Result[Option[InferenceSlotUpdate], CheckError]:
	match equality.origin:
		ResultConstraint(_) | LambdaConstraint(_): Ok(None)
		OpaqueOperandConstraint(_, _): Ok(None)
		VariantConstraint(_, _): Ok(None)
		RecordFieldConstraint(_, _, _): Ok(None)
		ListElementConstraint(_, _): Ok(None)
		ReceiverOverlapConstraint(_): Ok(None)
		ArgumentConstraint(_, _, actual, _):
			match equality.parameter:
				Some(_): Ok(None)
				None:
					match equality.expected:
						CallVariable(id):
							position = from_opaque InferenceVariableId(id)
							match slots.get(position).to_result(checker_invariant(actual.span, InvalidInferenceVariable(position))):
								Ok(slot):

									match slot.first_argument:
										Some(_): Ok(None)
										None: Ok(Some({ position = position, slot = { slot | first_argument = Some({ value_type = equality.actual, span = actual.span }) } }))
								Err(error): Err(error)
						_: Ok(None)


-- These variables live only while one expression is elaborated. They are distinct
-- from declaration-owned rigid parameters and never enter a checked TypeRef.
opaque type InferenceVariableId = Int


fixed union InferenceType:
	AcceptedType(TypeRef)
	CallVariable(InferenceVariableId)
	InferredCallable(Purity, List[InferenceType], InferenceType)
	InferredTuple(List[InferenceType])
	InferredList(InferenceType)
	InferredUnion(UnionId, List[InferenceType])
	InferredRecord(RecordId, List[InferenceType])


fixed record InferenceUse {
	value_type: InferenceType,
	span: Span
}


fixed union InferenceVariableState:
	UnboundVariable(Int)
	BoundVariable(InferenceType)
	LinkedVariable(InferenceVariableId)


fixed record InferenceSlot {
	parameter: TypeParameterId,
	call_span: Span,
	first_argument: Option[InferenceUse],
	state: InferenceVariableState
}


fixed record CallResultContext {
	expected: ExpectedValue,
	span: Span
}


fixed union ConstraintOrigin:
	ArgumentConstraint(PendingCall, Int, InferenceUse, TypeUse)
	ResultConstraint(CallResultContext)
	LambdaConstraint(Span)
	OpaqueOperandConstraint(ExpectedValue, Span)
	VariantConstraint(PendingVariantContract, Int)
	RecordFieldConstraint(FieldId, InferenceUse, Span)
	ListElementConstraint(Int, Span)
	ReceiverOverlapConstraint(Span)


fixed union InferenceRelation:
	CollectArguments
	RequireEquality


fixed record InferenceParameterConstraint {
	variable: InferenceVariableId,
	actual: InferenceType
}


fixed record InferenceEquality {
	expected: InferenceType,
	actual: InferenceType,
	origin: ConstraintOrigin,
	relation: InferenceRelation,
	parameter: Option[InferenceParameterConstraint]
}


fixed union InferencePublication:
	CompleteInference
	DiagnosticInference
	OccursInference(InferenceVariableId, TypeParameterId)


-- Complete accepted subtrees contain no expression-local variables. Retain them
-- intact; shape consumers open only one level when a mixed comparison needs it.
pure func inference_type(
	value_type: TypeRef,
	parameters_of_call: List[TypeParameterId],
	variable_start: Int,
) -> InferenceType:
	if parameters_of_call.is_empty():
		AcceptedType(value_type)
	else:
		match value_type:
			CallableType(purity, parameters, result):
				var values: List[InferenceType] = []
				var retained: Bool = True
				for parameter in parameters:
					value = inference_type(parameter, parameters_of_call, variable_start)
					values = values.append(value)
					match value:
						AcceptedType(_): void
						_: retained = False
				return_type = inference_type(result, parameters_of_call, variable_start)
				match return_type:
					AcceptedType(_): void
					_: retained = False
				if retained:
					AcceptedType(value_type)
				else:
					InferredCallable(purity, values, return_type)
			ListType(element):
				element_type = inference_type(element, parameters_of_call, variable_start)
				match element_type:
					AcceptedType(_): AcceptedType(value_type)
					_: InferredList(element_type)
			TupleType(arguments):
				var values: List[InferenceType] = []
				var retained: Bool = True

				for argument in arguments:
					value = inference_type(argument, parameters_of_call, variable_start)
					values = values.append(value)

					match value:
						AcceptedType(_): void
						_: retained = False

				if retained:
					AcceptedType(value_type)
				else:
					InferredTuple(values)
			AppliedRecordType(owner, arguments):
				var values: List[InferenceType] = []
				var retained: Bool = True

				for argument in arguments:
					value = inference_type(argument, parameters_of_call, variable_start)
					values = values.append(value)

					match value:
						AcceptedType(_): void
						_: retained = False

				if retained:
					AcceptedType(value_type)
				else:
					InferredRecord(owner, values)
			AppliedUnionType(owner, arguments):
				var values: List[InferenceType] = []
				var retained: Bool = True

				for argument in arguments:
					value = inference_type(argument, parameters_of_call, variable_start)
					values = values.append(value)

					match value:
						AcceptedType(_): void
						_: retained = False

				if retained:
					AcceptedType(value_type)
				else:
					InferredUnion(owner, values)
			ParameterType(parameter):
				match parameters_of_call.get(parameter_position(parameter)):
					Some(declared):
						if same_parameter(parameter, declared):
							CallVariable(into_opaque InferenceVariableId(IntOps.add(variable_start, parameter_position(parameter))))
						else:
							AcceptedType(value_type)
					None:
						AcceptedType(value_type)
			_:
				AcceptedType(value_type)


pure func inference_shape(value: InferenceType) -> InferenceType:
	match value:
		AcceptedType(CallableType(purity, parameters, result)):
			InferredCallable(purity, parameters.map(pure func(parameter_type): AcceptedType(parameter_type)), AcceptedType(result))
		AcceptedType(TupleType(elements)): InferredTuple(elements.map(pure func(element): AcceptedType(element)))
		AcceptedType(ListType(element)): InferredList(AcceptedType(element))
		AcceptedType(AppliedRecordType(owner, arguments)):
			var values: List[InferenceType] = []

			for argument in arguments:
				values = values.append(AcceptedType(argument))

			InferredRecord(owner, values)
		AcceptedType(AppliedUnionType(owner, arguments)):
			var values: List[InferenceType] = []

			for argument in arguments:
				values = values.append(AcceptedType(argument))

			InferredUnion(owner, values)
		_: value


-- Annotation substitution may change accepted children. Build that compound
-- once rather than retaining its unsubstituted callee-owned annotation.
pure func list_inference_type(element: InferenceType) -> InferenceType:
	match element:
		AcceptedType(value): AcceptedType(ListType(value))
		_: InferredList(element)


pure func tuple_inference_type(arguments: List[InferenceType]) -> InferenceType:
	var values: List[TypeRef] = []
	var complete: Bool = True

	for argument in arguments:
		match argument:
			AcceptedType(value): values = values.append(value)
			_:
				complete = False
				break

	if complete:
		AcceptedType(TupleType(values))
	else:
		InferredTuple(arguments)


private pure func substituted_record(owner: RecordId, arguments: List[InferenceType]) -> InferenceType:
	var values: List[TypeRef] = []
	var complete: Bool = True

	for argument in arguments:
		match argument:
			AcceptedType(value): values = values.append(value)
			_:
				complete = False
				break

	if complete:
		AcceptedType(AppliedRecordType(owner, values))
	else:
		InferredRecord(owner, arguments)


private pure func substituted_union(owner: UnionId, arguments: List[InferenceType]) -> InferenceType:
	var values: List[TypeRef] = []
	var complete: Bool = True

	for argument in arguments:
		match argument:
			AcceptedType(value): values = values.append(value)
			_:
				complete = False
				break

	if complete:
		AcceptedType(AppliedUnionType(owner, values))
	else:
		InferredUnion(owner, arguments)


pure func inference_head(
	value_type: InferenceType,
	slots: List[InferenceSlot],
	span: Span,
) -> Result[InferenceType, CheckError]:
	var current = value_type
	var complete: Bool = False
	var failure: Option[CheckError] = None

	while complete.not():
		match current:
			CallVariable(id):
				match slots.get(from_opaque InferenceVariableId(id)):
					Some(slot):
						match slot.state:
							UnboundVariable(_):
								complete = True
							BoundVariable(value):
								current = value
							LinkedVariable(next):
								current = CallVariable(next)
					None:
						failure = Some(checker_invariant(span, InvalidInferenceVariable(from_opaque InferenceVariableId(id))))
						complete = True
			_:
				complete = True

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(current)


private pure func push_inference_type(values: List[InferenceType], depth: Int, value: InferenceType) -> List[InferenceType]:
	if IntOps.less_than(depth, values.length()):
		values.set(depth, value)
	else:
		values.append(value)


private pure func inference_occurs(
	variable: InferenceVariableId,
	value_type: InferenceType,
	slots: List[InferenceSlot],
	span: Span,
) -> Result[Bool, CheckError]:
	var pending = [value_type]
	var pending_count = 1
	var found: Bool = False
	var failure: Option[CheckError] = None

	while and(IntOps.greater_than(pending_count, 0), found.not()):
		pending_count = IntOps.subtract(pending_count, 1)

		match pending.get(pending_count):
			None:
				failure = Some(checker_invariant(span, InvalidInferenceWorklist))
				break
			Some(value):
				match inference_head(value, slots, span):
					Err(error):
						failure = Some(error)
						break
					Ok(resolved_value):
						match resolved_value:
							CallVariable(id):
								found = IntOps.equals(from_opaque InferenceVariableId(id), from_opaque InferenceVariableId(variable))
							InferredCallable(purity, parameters, result):
								for child in parameters.append(result):
									pending = push_inference_type(pending, pending_count, child)
									pending_count = IntOps.add(pending_count, 1)
							InferredList(element):
								pending = push_inference_type(pending, pending_count, element)
								pending_count = IntOps.add(pending_count, 1)
							InferredTuple(arguments):
								for argument in arguments:
									pending = push_inference_type(pending, pending_count, argument)
									pending_count = IntOps.add(pending_count, 1)
							InferredRecord(_, arguments):
								for argument in arguments:
									pending = push_inference_type(pending, pending_count, argument)
									pending_count = IntOps.add(pending_count, 1)
							InferredUnion(_, arguments):
								for argument in arguments:
									pending = push_inference_type(pending, pending_count, argument)
									pending_count = IntOps.add(pending_count, 1)
							AcceptedType(_):
								void

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(found)


pure func publish_inference_type(
	value_type: InferenceType,
	slots: List[InferenceSlot],
	publication: InferencePublication,
	span: Span,
) -> Result[TypeRef, CheckError]:
	head ?= inference_head(value_type, slots, span)

	match head:
		AcceptedType(value):
			Ok(value)
		CallVariable(id):
			requested = match value_type:
				CallVariable(original): original
				_: id
			match slots.get(from_opaque InferenceVariableId(requested)).to_result(
				checker_invariant(span, InvalidInferenceVariable(from_opaque InferenceVariableId(requested))),
			):
				Ok(slot):

					match publication:
						CompleteInference:
							Err(call_error(slot.call_span, UninferableTypeParameter(slot.parameter)))
						DiagnosticInference:
							Ok(ParameterType(slot.parameter))
						OccursInference(root, parameter):
							if IntOps.equals(from_opaque InferenceVariableId(root), from_opaque InferenceVariableId(id)):
								Ok(ParameterType(parameter))
							else:
								Ok(ParameterType(slot.parameter))
				Err(error): Err(error)
		InferredCallable(purity, parameters, result):
			var values: List[TypeRef] = []
			var failure: Option[CheckError] = None
			for child in parameters:
				match publish_inference_type(child, slots, publication, span):
					Ok(value): values = values.append(value)
					Err(error):
						failure = Some(error)
						break
			match failure:
				Some(error): Err(error)
				None:
					match publish_inference_type(result, slots, publication, span):
						Ok(value): Ok(CallableType(purity, values, value))
						Err(error): Err(error)
		InferredList(element):
			match publish_inference_type(element, slots, publication, span):
				Ok(value): Ok(ListType(value))
				Err(error): Err(error)
		InferredTuple(arguments):
			var values: List[TypeRef] = []
			var failure: Option[CheckError] = None

			for argument in arguments:
				match publish_inference_type(argument, slots, publication, span):
					Err(error):
						failure = Some(error)
						break
					Ok(value):
						values = values.append(value)

			match failure:
				Some(error):
					Err(error)
				None:
					Ok(TupleType(values))
		InferredRecord(owner, arguments):
			var values: List[TypeRef] = []
			var failure: Option[CheckError] = None

			for argument in arguments:
				match publish_inference_type(argument, slots, publication, span):
					Err(error):
						failure = Some(error)
						break
					Ok(value):
						values = values.append(value)

			match failure:
				Some(error):
					Err(error)
				None:
					Ok(AppliedRecordType(owner, values))
		InferredUnion(owner, arguments):
			var values: List[TypeRef] = []
			var failure: Option[CheckError] = None

			for argument in arguments:
				match publish_inference_type(argument, slots, publication, span):
					Err(error):
						failure = Some(error)
						break
					Ok(value):
						values = values.append(value)

			match failure:
				Some(error):
					Err(error)
				None:
					Ok(AppliedUnionType(owner, values))


private pure func inference_origin_span(origin: ConstraintOrigin) -> Span:
	match origin:
		ArgumentConstraint(_, _, actual, _):
			actual.span
		ResultConstraint(result):
			result.span
		LambdaConstraint(span): span
		OpaqueOperandConstraint(_, span): span
		VariantConstraint(contract, _): contract.span
		RecordFieldConstraint(_, _, span): span
		ListElementConstraint(_, span): span
		ReceiverOverlapConstraint(span): span


private pure func inference_conflict(
	equality: InferenceEquality,
	slots: List[InferenceSlot],
) -> Result[CheckError, CheckError]:
	span = inference_origin_span(equality.origin)

	match equality.origin:
		ResultConstraint(_) | LambdaConstraint(_):
			Err(checker_invariant(span, InvalidInferenceWorklist))
		OpaqueOperandConstraint(_, _): Err(checker_invariant(span, InvalidInferenceWorklist))
		VariantConstraint(_, _): Err(checker_invariant(span, InvalidInferenceWorklist))
		RecordFieldConstraint(_, _, _): Err(checker_invariant(span, InvalidInferenceWorklist))
		ListElementConstraint(_, _): Err(checker_invariant(span, InvalidInferenceWorklist))
		ReceiverOverlapConstraint(_): Err(checker_invariant(span, InvalidInferenceWorklist))
		ArgumentConstraint(call, position, occurrence, written):
			generic_argument_conflict(call, position, occurrence, written, equality.parameter, slots)


-- A call's arguments gave one generic parameter different types: the error
-- names both and the position that disagreed.
private pure func generic_argument_conflict(
	call: PendingCall,
	position: Int,
	occurrence: InferenceUse,
	written: TypeUse,
	parameter: Option[InferenceParameterConstraint],
	slots: List[InferenceSlot],
) -> Result[CheckError, CheckError]:
	constraint ?= parameter.to_result(checker_invariant(occurrence.span, InvalidInferenceWorklist))
	id = constraint.variable
	slot ?= slots.get(from_opaque InferenceVariableId(id)).to_result(
		checker_invariant(occurrence.span, InvalidInferenceVariable(from_opaque InferenceVariableId(id))),
	)
	previous ?= slot.first_argument.to_result(checker_invariant(occurrence.span, InvalidInferenceWorklist))
	expected ?= publish_inference_type(inference_type(written.value_type, call.signature.type_parameters, call.variable_start), slots, DiagnosticInference, occurrence.span)
	first ?= publish_inference_type(previous.value_type, slots, DiagnosticInference, previous.span)
	current ?= publish_inference_type(constraint.actual, slots, DiagnosticInference, occurrence.span)
	actual_type ?= publish_inference_type(occurrence.value_type, slots, DiagnosticInference, occurrence.span)
	Ok(call_error(occurrence.span, GenericArgumentConflict({
		parameter = slot.parameter,
		previous = { value_type = first, span = previous.span },
		current = { value_type = current, span = occurrence.span },
		mismatch = {
			expected = expected,
			actual = { value_type = actual_type, span = occurrence.span },
			argument_position = position,
			expected_site = SourceAnnotation(written.span),
		},
	})))


private fixed union InferenceAction:
	SameInference
	BindInference(InferenceVariableId, InferenceType)
	MergeInference(InferenceVariableId, InferenceVariableId)
	ListEquality(InferenceType, InferenceType)
	UnionEquality(List[InferenceType], List[InferenceType])
	RecordEquality(List[InferenceType], List[InferenceType])
	TupleEquality(List[InferenceType], List[InferenceType])
	CallableEquality(Purity, List[InferenceType], List[InferenceType], InferenceType, InferenceType)
	InferenceMismatch


private pure func inference_action(left: InferenceType, right: InferenceType) -> InferenceAction:
	match left:
		CallVariable(left_id):
			match right:
				CallVariable(right_id):
					if IntOps.equals(from_opaque InferenceVariableId(left_id), from_opaque InferenceVariableId(right_id)):
						SameInference
					else:
						MergeInference(left_id, right_id)
				_:
					BindInference(left_id, right)
		_:
			match right:
				CallVariable(id): BindInference(id, left)
				_:
					match left:
						AcceptedType(left_type):
							match right:
								AcceptedType(right_type):
									if same_type(left_type, right_type):
										SameInference
									else:
										InferenceMismatch
								_: inference_shape_action(inference_shape(left), inference_shape(right))
						_: inference_shape_action(inference_shape(left), inference_shape(right))


private pure func inference_shape_action(left: InferenceType, right: InferenceType) -> InferenceAction:
	match left:
		InferredCallable(purity, parameters, result):
			match right:
				InferredCallable(other_purity, others, other):
					if and(same_purity(purity, other_purity), IntOps.equals(parameters.length(), others.length())):
						CallableEquality(purity, parameters, others, result, other)
					else:
						InferenceMismatch
				_: InferenceMismatch
		InferredList(left_shape):
			match right:
				InferredList(right_shape): ListEquality(left_shape, right_shape)
				_: InferenceMismatch
		InferredTuple(elements):
			match right:
				InferredTuple(others):
					if IntOps.equals(elements.length(), others.length()):
						TupleEquality(elements, others)
					else:
						InferenceMismatch
				_: InferenceMismatch
		InferredRecord(left_owner, left_arguments):
			match right:
				InferredRecord(right_owner, right_arguments):
					if and(
						IntOps.equals(record_number(left_owner), record_number(right_owner)),
						IntOps.equals(left_arguments.length(), right_arguments.length()),
					):
						RecordEquality(left_arguments, right_arguments)
					else:
						InferenceMismatch
				_: InferenceMismatch
		InferredUnion(left_owner, left_arguments):
			match right:
				InferredUnion(right_owner, right_arguments):
					if and(
						IntOps.equals(union_number(left_owner), union_number(right_owner)),
						IntOps.equals(left_arguments.length(), right_arguments.length()),
					):
						UnionEquality(left_arguments, right_arguments)
					else:
						InferenceMismatch
				_: InferenceMismatch
		_: InferenceMismatch


private pure func inference_rank(state: InferenceVariableState, span: Span) -> Result[Int, CheckError]:
	match state:
		UnboundVariable(rank): Ok(rank)
		_: Err(checker_invariant(span, InvalidInferenceWorklist))


fixed record InferenceSlotUpdate {
	position: Int,
	slot: InferenceSlot
}


fixed union InferenceStep:
	IncompatibleResult
	CompleteEquality
	UpdateInferenceSlots(List[InferenceSlotUpdate])
	ExpandInferenceList(InferenceEquality)
	ExpandInferenceArguments(InferenceEquality, List[InferenceType], List[InferenceType])


-- Borrow the slot vector and return only the validated changes. Its local owner
-- applies them after this call, with no retained old vector root.
pure func inspect_inference_equality(
	equality: InferenceEquality,
	slots: List[InferenceSlot],
) -> Result[InferenceStep, CheckError]:
	span = inference_origin_span(equality.origin)
	var origin = equality.parameter
	var relation = equality.relation

	match equality.expected:
		CallVariable(id):
			if origin.is_none():
				origin = Some({ variable = id, actual = equality.actual })

			relation = RequireEquality
		_:
			void

	left ?= inference_head(equality.expected, slots, span)
	right ?= inference_head(equality.actual, slots, span)
	current = { equality | parameter = origin, relation = relation }

	match inference_action(left, right):
		SameInference:
			Ok(CompleteEquality)
		MergeInference(left_id, right_id):
			link_inference_variables(left_id, right_id, slots, span)
		BindInference(id, value):
			position = from_opaque InferenceVariableId(id)
			match slots.get(position).to_result(checker_invariant(span, InvalidInferenceVariable(position))):
				Ok(slot):
					match inference_occurs(id, value, slots, span):
						Ok(occurs):

							if occurs:
								match current.origin:
									ReceiverOverlapConstraint(_): Ok(IncompatibleResult)
									_:
										match inference_occurs_error(current, id, value, slots):
											Ok(occurs_error): Err(occurs_error)
											Err(invariant): Err(invariant)
							else:
								Ok(UpdateInferenceSlots([{ position = position, slot = { slot | state = BoundVariable(value) } }]))
						Err(error): Err(error)
				Err(error): Err(error)
		CallableEquality(purity, parameters, others, result, other):
			Ok(ExpandInferenceArguments(current, parameters.append(result), others.append(other)))
		ListEquality(left_element, right_element):
			Ok(ExpandInferenceList({ current | expected = left_element, actual = right_element }))
		UnionEquality(left_arguments, right_arguments):
			Ok(ExpandInferenceArguments(current, left_arguments, right_arguments))
		TupleEquality(left_arguments, right_arguments):
			Ok(ExpandInferenceArguments(current, left_arguments, right_arguments))
		RecordEquality(left_arguments, right_arguments):
			Ok(ExpandInferenceArguments(current, left_arguments, right_arguments))
		InferenceMismatch:
			match relation:
				RequireEquality:
					match current.origin:
						LambdaConstraint(site):
							match lambda_constraint_error(current, slots, site):
								Ok(error): Err(error)
								Err(error): Err(error)
						ResultConstraint(_):
							-- The enclosing expression/field owns this mismatch diagnostic.
							Ok(IncompatibleResult)
						-- Operand freezing owns this mismatch; sibling constraints keep solving.
						OpaqueOperandConstraint(_, _): Ok(CompleteEquality)
						VariantConstraint(_, _): Ok(CompleteEquality)
						RecordFieldConstraint(_, _, _): Ok(CompleteEquality)
						ListElementConstraint(_, _): Ok(CompleteEquality)
						ReceiverOverlapConstraint(_): Ok(IncompatibleResult)
						ArgumentConstraint(_, _, _, _):
							match inference_conflict(current, slots):
								Ok(error): Err(error)
								Err(error): Err(error)
				CollectArguments:
					Ok(CompleteEquality)


-- Two unbound variables become one: the lower-ranked links to the other.
private pure func link_inference_variables(left_id: InferenceVariableId, right_id: InferenceVariableId, slots: List[InferenceSlot], span: Span) -> Result[InferenceStep, CheckError]:
	left_position = from_opaque InferenceVariableId(left_id)
	right_position = from_opaque InferenceVariableId(right_id)
	left_slot ?= slots.get(left_position).to_result(checker_invariant(span, InvalidInferenceVariable(left_position)))
	right_slot ?= slots.get(right_position).to_result(checker_invariant(span, InvalidInferenceVariable(right_position)))
	left_rank ?= inference_rank(left_slot.state, span)
	right_rank ?= inference_rank(right_slot.state, span)

	-- Union by rank bounds chains without repeatedly rewriting old terms.
	if IntOps.less_than(left_rank, right_rank):
		Ok(UpdateInferenceSlots([{ position = left_position, slot = { left_slot | state = LinkedVariable(right_id) } }]))
	else:
		var updates: List[InferenceSlotUpdate] = [
			{ position = right_position, slot = { right_slot | state = LinkedVariable(left_id) } },
		]

		if IntOps.equals(left_rank, right_rank):
			updates = updates.append({ position = left_position, slot = { left_slot | state = UnboundVariable(IntOps.add(left_rank, 1)) } })

		Ok(UpdateInferenceSlots(updates))


private pure func inference_occurs_error(equality: InferenceEquality, root: InferenceVariableId, value: InferenceType, slots: List[InferenceSlot]) -> Result[CheckError, CheckError]:
	span = inference_origin_span(equality.origin)
	origin_id = match equality.parameter:
		Some(parameter): parameter.variable
		None: root
	origin ?= slots.get(from_opaque InferenceVariableId(origin_id)).to_result(checker_invariant(span, InvalidInferenceVariable(from_opaque InferenceVariableId(origin_id))))
	snapshot ?= publish_inference_type(value, slots, OccursInference(root, origin.parameter), span)
	site_result: Result[ExpectedTypeSite, CheckError] = match equality.origin:
		ArgumentConstraint(call, _, _, written): Ok(SourceAnnotation(written.span))
		ResultConstraint(result): Ok(result.expected.site)
		LambdaConstraint(lambda_span): Ok(SourceAnnotation(lambda_span))
		OpaqueOperandConstraint(expected, _): Ok(expected.site)
		RecordFieldConstraint(_, expected, _): Ok(SourceAnnotation(expected.span))
		ListElementConstraint(_, element_span): Ok(SourceAnnotation(element_span))
		ReceiverOverlapConstraint(_): Err(checker_invariant(span, InvalidInferenceWorklist))
		VariantConstraint(contract, position):
			match contract.fields.get(position).to_result(checker_invariant(span, GenericConstructorContract)):
				Ok(field): Ok(SourceAnnotation(field.span))
				Err(error): Err(error)
	site ?= site_result
	Ok(call_error(span, InfiniteTypeArgument({ parameter = origin.parameter, call_span = origin.call_span, recursive_type = snapshot, expected_site = site })))


pure func inference_child(
	equality: InferenceEquality,
	left_arguments: List[InferenceType],
	right_arguments: List[InferenceType],
	position: Int,
) -> Result[InferenceEquality, CheckError]:
	span = inference_origin_span(equality.origin)
	left ?= left_arguments.get(position).to_result(checker_invariant(span, InvalidInferenceWorklist))
	right ?= right_arguments.get(position).to_result(checker_invariant(span, InvalidInferenceWorklist))
	Ok({ equality | expected = left, actual = right })


pure func call_argument_constraint(
	call: PendingCall,
	actual: List[InferenceUse],
	position: Int,
) -> Result[InferenceEquality, CheckError]:
	value ?= actual.get(position).to_result(checker_invariant(call.span, MissingGenericParameter(position)))
	written ?= call.signature.parameters.get(position).to_result(checker_invariant(call.span, MissingGenericParameter(position)))
	Ok({ expected = inference_type(written.value_type, call.signature.type_parameters, call.variable_start), actual = value.value_type, origin = ArgumentConstraint(call, position, value, written), relation = CollectArguments, parameter = None })


-- Publish solved arguments only; pure-result and argument checks
-- stay together in validate_complete_arguments after child-first freeze.
pure func publish_pending_call(
	call: PendingCall,
	operands: List[CheckedCallOperand],
	slots: List[InferenceSlot],
) -> Result[CheckedCall, CheckError]:
	var types: List[TypeRef] = []
	var failure: Option[CheckError] = None
	for parameter in call.signature.type_parameters:
		match publish_inference_type(inference_type(ParameterType(parameter), call.signature.type_parameters, call.variable_start), slots, CompleteInference, call.span):
			Err(error):
				failure = Some(error)
				break
			Ok(value): types = types.append(value)
	ready: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	target: CallTarget = match call.target:
		PendingDeclared(function): UserFunction(function, types)
		PendingParameter(parameter): CallableParameter(parameter)
		PendingStored(callee): ValueCall(callee)
	Ok({ target = target, operands = operands, span = call.span })


-- Different concrete constructors are the unifier's immediate mismatch rule.
private pure func disjoint_heads(left: TypeRef, right: TypeRef) -> Bool:
	match type_head(left):
		None: False
		Some(left_head):
			match type_head(right):
				None: False
				Some(right_head): same_head(left_head, right_head).not()


private pure func solve_overlap(equality: InferenceEquality, slots: List[InferenceSlot]) -> Result[Option[List[InferenceSlot]], CheckError]:
	step ?= inspect_inference_equality(equality, slots)
	match step:
		IncompatibleResult: Ok(None)
		CompleteEquality: Ok(Some(slots))
		UpdateInferenceSlots(updates):
			var updated_slots = slots
			for update in updates:
				updated_slots = updated_slots.set(update.position, update.slot)
			Ok(Some(updated_slots))
		ExpandInferenceList(child): solve_overlap(child, slots)
		ExpandInferenceArguments(parent, left_arguments, right_arguments):
			solve_overlap_arguments(parent, left_arguments, right_arguments, 0, slots)


private pure func solve_overlap_arguments(parent: InferenceEquality, left: List[InferenceType], right: List[InferenceType], position: Int, slots: List[InferenceSlot]) -> Result[Option[List[InferenceSlot]], CheckError]:
	if IntOps.equals(position, left.length()):
		Ok(Some(slots))
	else:
		match inference_child(parent, left, right, position):
			Err(invariant): Err(invariant)
			Ok(child):
				match solve_overlap(child, slots):
					Err(invariant): Err(invariant)
					Ok(None): Ok(None)
					Ok(Some(next_slots)):
						solve_overlap_arguments(parent, left, right, IntOps.add(position, 1), next_slots)


-- Both declarations' parameters are flexible in separate variable ranges.
-- A call supplies [] for its actual receiver, keeping caller parameters rigid.
pure func types_overlap(left: TypeRef, left_parameters: List[TypeParameterId], right: TypeRef, right_parameters: List[TypeParameterId], span: Span) -> Result[Bool, CheckError]:
	-- With no flexible parameters the solver compares accepted types directly.
	if and(left_parameters.is_empty(), right_parameters.is_empty()):
		Ok(same_type(left, right))
	else if disjoint_heads(left, right):
		Ok(False)
	else:
		var slots: List[InferenceSlot] = []
		for declared_parameter in left_parameters.concat(right_parameters):
			slots = slots.append({ parameter = declared_parameter, call_span = span, first_argument = None, state = UnboundVariable(0) })
		equality: InferenceEquality = {
			expected = inference_type(left, left_parameters, 0),
			actual = inference_type(right, right_parameters, left_parameters.length()),
			origin = ReceiverOverlapConstraint(span),
			relation = RequireEquality,
			parameter = None
		}
		match solve_overlap(equality, slots):
			Err(invariant): Err(invariant)
			Ok(unified): Ok(unified.is_some())


-- Declaration validation guarantees at most one type-compatible receiver.
private pure func choose_receiver(callee: WrittenName, candidates: List[ReceiverCandidate], actual: TypeUse) -> Result[ReceiverCandidate, CheckError]:
	var compatible: List[ReceiverCandidate] = []
	var failure: Option[CheckError] = None
	for candidate in candidates:
		match candidate.function.signature.parameters.get(0):
			None: void
			Some(receiver_parameter):
				match types_overlap(receiver_parameter.value_type, candidate.function.signature.type_parameters, actual.value_type, [], actual.span):
					Err(invariant): failure = Some(invariant)
					Ok(False): void
					Ok(True): compatible = compatible.append(candidate)
		if failure.is_some():
			break
	match failure:
		Some(invariant): Err(invariant)
		None:
			match compatible:
				[]: Err(method_error(callee.span, NoApplicableMethod(callee.id, actual.value_type, method_sites(candidates))))
				[selected]: Ok(selected)
				_: Err(method_error(callee.span, AmbiguousMethod(callee.id, actual.value_type, method_sites(compatible))))


pure func select_receiver_contract(application: ReceiverApplication, receiver: ResolvedReceiver, actual: TypeUse, context: ResolutionContext) -> Result[FunctionContract, CheckError]:
	match receiver:
		UniqueReceiver(contract): Ok(contract)
		ReceiverCandidates(candidates):
			match choose_receiver(application.callee, candidates, actual):
				Err(selection_error): Err(selection_error)
				Ok(selected): receiver_contract(context.caller, application.callee, application.arguments, selected.function.id, context.signatures)


private pure func lambda_constraint_error(equality: InferenceEquality, slots: List[InferenceSlot], span: Span) -> Result[CheckError, CheckError]:
	expected ?= publish_inference_type(equality.expected, slots, CompleteInference, span)
	actual ?= publish_inference_type(equality.actual, slots, CompleteInference, span)
	Ok(value_error(span, ExpressionTypeMismatch({
		expected = expected, actual = { value_type = actual, span = span }, expected_site = SourceAnnotation(span)
	})))
