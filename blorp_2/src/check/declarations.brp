---
Checks union and record declarations and resolves written type terms
against the frozen namespace, including declared type parameters.
---
import:
	result: Result methods
	bool: not, and, or
	./errors:
		CheckError,
		CheckerInvariant(
			InvalidParameterDeclaration, InvalidUnionDeclaration, InvalidRecordDeclaration, InvalidOpaqueDeclaration, InvalidDeclarationVisit,
		),
		TypeDeclarationError(
			DuplicateRecordField, DuplicateTypeParameter, TypeParameterTypeNameConflict, RecursiveAggregateType, RecursiveOpaqueRepresentation,
			NonFixedPayload, RecursiveFixedUnion,
		),
		TypeTermError(
			PrivateTypeInPublicDeclaration, TraitUsedAsType,
			ListTypeArgumentCount, NonApplicableType, MissingTypeArguments, TypeArgumentCountMismatch, OrdinaryTypeApplied, UnknownType,
		),
		QualifiedError(UnknownModuleAlias, QualifiedNotOffered),
		qualified_error,
		checker_invariant,
		type_declaration_error,
		type_term_error,
	./model:
		CheckedField,
		CheckedRecord,
		CheckedOpaque,
		CheckedUnion,
		CheckedVariant,
		TypeParameterId,
		TypeParameterOwner(UnionDeclaration, RecordDeclaration, OpaqueDeclaration),
		TypeRef(TupleType, CallableType, NominalType, VoidType, FloatType, IntType, ListType, ParameterType, StringType),
		AggregateId(RecordAggregate, UnionAggregate),
		NominalId(AggregateNominal, OpaqueNominal),
		same_nominal,
		TypeUse,
		UnionOccurrence,
		field_id,
		parameter_owner,
		parameter_position,
		primitive_ref,
		same_owner,
		same_types,
		same_type,
		type_parameter_id,
	../utils/ids:
		RecordRow,
		UnionRow,
		OpaqueRow,
		NominalRow(UnionDeclarationRow, RecordDeclarationRow, OpaqueDeclarationRow),
		inventory_functions,
		inventory_opaques,
		inventory_records,
		inventory_unions,
		next_nominal,
		RecordId,
		opaque_number,
		UnionId,
		record_number,
		union_number,
	int: Int methods
	list: repeat
	../utils/names: NameId, same_name
	../namespace/namespace:
		AliasedModule, Unoffered, Namespace, NamedValue(NamedAlias), TypeHead(PrimitiveHead, ListHead, UnionHead, RecordHead, OpaqueHead),
		Origin(Declared), named_trait, named_type, named_value, offered_type, offered_trait,
	option: Option methods
	../parse/assemble: ParsedContents
	../utils/source: ModuleId
	../utils/syntax:
		ParsedReceiverHead(ReceiverName, QualifiedReceiverName),
		ParsedQualified,
		ParsedRecord,
		Span,
		compiler_span,
		TypeSyntax(TupleTypeSyntax, AtomicType, AppliedType, QualifiedType, CallableTypeSyntax),
		WrittenName,
		Visibility(Private, Public),
		type_span,


pure func previous_declaration(previous: List[WrittenName], name: NameId) -> Option[WrittenName]:
	var found: Option[WrittenName] = None

	for known in previous:
		if same_name(known.id, name):
			found = Some(known)
			break

	found


fixed record SelfBinding {
	name: NameId,
	value_type: TypeRef
}


-- The type names visible where a type is written: the module's namespace, the
-- declared unions and the enclosing declaration's own type parameters.
fixed record TypeScope {
	self_binding: Option[SelfBinding],
	records: List[RecordRow],
	unions: List[UnionRow],
	opaques: List[OpaqueRow],
	namespace: Namespace,
	module: ModuleId,
	access: TypeAccess,
	parameters: List[LocalTypeParameter]
}


union TypeAccess:
	PrivateTypeUse
	PublicTypeUse(NameId)


pure func type_access(visibility: Visibility, declaration: NameId) -> TypeAccess:
	match visibility:
		Private(_): PrivateTypeUse
		Public: PublicTypeUse(declaration)


fixed record LocalTypeParameter {
	name: WrittenName,
	id: TypeParameterId
}


private pure func lookup_type_parameter(
	parameters: List[LocalTypeParameter],
	name: NameId,
) -> Option[LocalTypeParameter]:
	var found: Option[LocalTypeParameter] = None

	for parameter in parameters:
		if same_name(parameter.name.id, name):
			found = Some(parameter)
			break

	found


-- Declares a declaration's own type parameters in the scope of its module.
pure func local_type_parameters(
	written: List[WrittenName],
	owner: TypeParameterOwner,
	module_scope: TypeScope,
) -> Result[TypeScope, CheckError]:
	declare_type_parameters(written, owner, { module_scope | parameters = [] })


-- Declares the type parameters in order; each name is new and is not already
-- a visible type.
private pure func declare_type_parameters(
	written: List[WrittenName],
	owner: TypeParameterOwner,
	scope: TypeScope,
) -> Result[TypeScope, CheckError]:
	match written.get(scope.parameters.length()):
		None:
			Ok(scope)
		Some(name):
			id = type_parameter_id(owner, scope.parameters.length())

			match lookup_type_parameter(scope.parameters, name.id):
				Some(previous):
					Err(
						type_declaration_error(
							name.span,
							DuplicateTypeParameter(id, previous.id, previous.name.span),
						),
					)
				None:
					if named_type(scope.namespace, scope.module, name.id).is_none():
						declare_type_parameters(written, owner, { scope | parameters = scope.parameters.append({
									name = name,
									id = id,
								}) })
					else:
						Err(
							type_declaration_error(
								name.span,
								TypeParameterTypeNameConflict(name.id),
							),
						)


pure func declared_parameters(scope: TypeScope) -> List[TypeParameterId]:
	scope.parameters.map(pure func(parameter: LocalTypeParameter): parameter.id)


-- The number of type parameters a record, union or opaque type declares.
private pure func nominal_arity(scope: TypeScope, owner: NominalId, span: Span) -> Result[Int, CheckError]:
	match owner:
		AggregateNominal(RecordAggregate(id)):
			match scope.records.get(record_number(id)):
				Some(row): Ok(row.declaration.type_parameters.length())
				None: Err(checker_invariant(span, InvalidRecordDeclaration(id)))
		AggregateNominal(UnionAggregate(id)):
			match scope.unions.get(union_number(id)):
				Some(row): Ok(row.type_parameters.length())
				None: Err(checker_invariant(span, InvalidUnionDeclaration(id)))
		OpaqueNominal(id):
			match scope.opaques.get(opaque_number(id)):
				Some(row): Ok(row.declaration.type_parameters.length())
				None: Err(checker_invariant(span, InvalidOpaqueDeclaration(id)))


-- A nominal head written alone, which its declaration must not need arguments for.
private pure func unapplied_nominal(scope: TypeScope, owner: NominalId, span: Span) -> Result[TypeRef, CheckError]:
	arity ?= nominal_arity(scope, owner, span)
	if arity == 0:
		Ok(NominalType(owner, []))
	else:
		Err(type_term_error(span, MissingTypeArguments(owner, arity)))


-- A nominal head with written arguments, which must match its arity.
private pure func resolve_nominal(scope: TypeScope, owner: NominalId, arguments: List[TypeSyntax], span: Span) -> Result[TypeRef, CheckError]:
	arity ?= nominal_arity(scope, owner, span)
	if arity == arguments.length():
		match resolve_types(scope, arguments, []):
			Ok(values): Ok(NominalType(owner, values))
			Err(error): Err(error)
	else if arity == 0:
		Err(type_term_error(span, OrdinaryTypeApplied(owner)))
	else:
		Err(type_term_error(span, TypeArgumentCountMismatch(owner, arity, arguments.length())))


private pure func resolve_atomic_head(
	scope: TypeScope,
	head: TypeHead,
	name: WrittenName,
) -> Result[TypeRef, CheckError]:
	match head:
		PrimitiveHead(primitive):
			Ok(primitive_ref(primitive))
		ListHead:
			Err(type_term_error(name.span, ListTypeArgumentCount))
		OpaqueHead(id):
			unapplied_nominal(scope, OpaqueNominal(id), name.span)
		RecordHead(id):
			unapplied_nominal(scope, AggregateNominal(RecordAggregate(id)), name.span)
		UnionHead(id):
			unapplied_nominal(scope, AggregateNominal(UnionAggregate(id)), name.span)


-- One unqualified lookup validates access before publishing the head.
private pure func resolve_head(scope: TypeScope, name: WrittenName, missing: TypeTermError) -> Result[TypeHead, CheckError]:
	match named_type(scope.namespace, scope.module, name.id):
		None:
			match named_trait(scope.namespace, scope.module, name.id):
				Some(id): Err(type_term_error(name.span, TraitUsedAsType(id)))
				None: Err(type_term_error(name.span, missing))
		Some(found):
			match scope.access:
				PublicTypeUse(declaration):
					match found.origin:
						Declared(Private(_)): Err(type_term_error(name.span, PrivateTypeInPublicDeclaration(name.id, declaration)))
						_: Ok(found.head)
				PrivateTypeUse: Ok(found.head)


private pure func scoped_type(scope: TypeScope, name: WrittenName) -> Option[TypeRef]:
	match scope.self_binding:
		Some(binding):
			if same_name(binding.name, name.id):
				Some(binding.value_type)
			else:
				None
		None: None


private pure func resolve_atomic_type(
	scope: TypeScope,
	name: WrittenName,
) -> Result[TypeRef, CheckError]:
	match scoped_type(scope, name):
		Some(value_type): Ok(value_type)
		None:
			match lookup_type_parameter(scope.parameters, name.id):
				Some(parameter): Ok(ParameterType(parameter.id))
				None:
					match resolve_head(scope, name, UnknownType(name.id)):
						Ok(head): resolve_atomic_head(scope, head, name)
						Err(error): Err(error)

-- A head applied to written arguments; the head's own arity rules.
private pure func resolve_applied_head(
	scope: TypeScope,
	head: TypeHead,
	name: WrittenName,
	arguments: List[TypeSyntax],
	span: Span,
) -> Result[TypeRef, CheckError]:
	match head:
		ListHead:
			match arguments:
				[element]:
					match resolve_type(scope, element):
						Ok(value): Ok(ListType(value))
						Err(error): Err(error)
				_:
					Err(type_term_error(span, ListTypeArgumentCount))
		RecordHead(owner):
			resolve_nominal(scope, AggregateNominal(RecordAggregate(owner)), arguments, span)
		UnionHead(owner):
			resolve_nominal(scope, AggregateNominal(UnionAggregate(owner)), arguments, span)
		OpaqueHead(owner):
			resolve_nominal(scope, OpaqueNominal(owner), arguments, span)
		PrimitiveHead(_):
			Err(type_term_error(name.span, NonApplicableType(name.id)))


-- Receiver families name one head; their binders are accepted separately.
pure func resolve_receiver_head(scope: TypeScope, written: ParsedReceiverHead) -> Result[TypeHead, CheckError]:
	match written:
		ReceiverName(name): resolve_head(scope, name, UnknownType(name.id))
		QualifiedReceiverName(qualified):
			match aliased_module(scope.namespace, scope.module, qualified.module):
				Err(error): Err(error)
				Ok(aliased):
					match offered_type(scope.namespace, aliased.target, qualified.name.id):
						Ok(head): Ok(head)
						Err(reason): Err(qualified_type_rejection(scope, aliased, qualified, reason))


pure func receiver_arity(scope: TypeScope, head: TypeHead, span: Span) -> Result[Int, CheckError]:
	match head:
		ListHead: Ok(1)
		RecordHead(owner): nominal_arity(scope, AggregateNominal(RecordAggregate(owner)), span)
		UnionHead(owner): nominal_arity(scope, AggregateNominal(UnionAggregate(owner)), span)
		OpaqueHead(owner): nominal_arity(scope, OpaqueNominal(owner), span)
		PrimitiveHead(_): Ok(0)


-- The module `written` names as a module alias in `module`.
pure func aliased_module(namespace: Namespace, module: ModuleId, written: WrittenName) -> Result[AliasedModule, CheckError]:
	match named_value(namespace, module, written.id):
		Some(NamedAlias(aliased)): Ok(aliased)
		_: Err(qualified_error(written.span, UnknownModuleAlias(written.id)))


-- `Alias.Name[args]` names a type the aliased module offers.
private pure func resolve_qualified_type(
	scope: TypeScope,
	qualified: ParsedQualified,
	arguments: List[TypeSyntax],
	span: Span,
) -> Result[TypeRef, CheckError]:
	aliased ?= aliased_module(scope.namespace, scope.module, qualified.module)
	head: TypeHead ?= match offered_type(scope.namespace, aliased.target, qualified.name.id):
		Ok(head): Ok(head)
		Err(reason): Err(qualified_type_rejection(scope, aliased, qualified, reason))
	if arguments.is_empty():
		resolve_atomic_head(scope, head, qualified.name)
	else:
		resolve_applied_head(scope, head, qualified.name, arguments, span)


-- Produce the rejection fact before wrapping it in the caller's Result. This
-- keeps the two failed lookup cases on one ordinary publication boundary.
private pure func qualified_type_rejection(scope: TypeScope, aliased: AliasedModule, qualified: ParsedQualified, reason: Unoffered) -> CheckError:
	match offered_trait(scope.namespace, aliased.target, qualified.name.id):
		Ok(id): type_term_error(qualified.name.span, TraitUsedAsType(id))
		Err(_): qualified_error(qualified.name.span, QualifiedNotOffered(qualified.module.id, qualified.name.id, aliased.path, reason))


pure func resolve_type(scope: TypeScope, written: TypeSyntax) -> Result[TypeRef, CheckError]:
	match written:
		TupleTypeSyntax(elements, _):
			resolve_types(scope, elements, []).map(pure func(values): TupleType(values))
		CallableTypeSyntax(purity, parameters, result, _):
			match resolve_types(scope, parameters, []):
				Err(error): Err(error)
				Ok(values):
					match resolve_type(scope, result):
						Err(error): Err(error)
						Ok(returned):
							Ok(CallableType(purity, values, returned))
		QualifiedType(qualified, arguments, span):
			resolve_qualified_type(scope, qualified, arguments, span)
		AtomicType(name):
			resolve_atomic_type(scope, name)
		AppliedType(name, arguments, span):
			match scoped_type(scope, name):
				Some(_): Err(type_term_error(name.span, NonApplicableType(name.id)))
				None:
					match resolve_head(scope, name, NonApplicableType(name.id)):
						Ok(head): resolve_applied_head(scope, head, name, arguments, span)
						Err(error): Err(error)


private pure func resolve_types(
	scope: TypeScope,
	written: List[TypeSyntax],
	resolved: List[TypeRef],
) -> Result[List[TypeRef], CheckError]:
	match written.get(resolved.length()):
		None:
			Ok(resolved)
		Some(argument):
			match resolve_type(scope, argument):
				Ok(value):
					resolve_types(
						scope,
						written,
						resolved.append(value),
					)
				Err(error): Err(error)


fixed record CheckedDeclarations {
	unions: List[CheckedUnion],
	records: List[CheckedRecord],
	opaques: List[CheckedOpaque]
}




private pure func declared_module(declaration: NominalRow) -> ModuleId:
	match declaration:
		UnionDeclarationRow(parsed_union):
			parsed_union.module
		RecordDeclarationRow(parsed_record):
			parsed_record.declaration.module
		OpaqueDeclarationRow(parsed_opaque):
			parsed_opaque.declaration.module




pure func validate_declarations(
	parsed: ParsedContents,
	namespace: Namespace,
) -> Result[CheckedDeclarations, CheckError]:
	declare_types(
		parsed,
		namespace,
		{
			unions = [],
			records = [],
			opaques = []
		},
	)


private pure func declare_types(
	parsed: ParsedContents,
	namespace: Namespace,
	checked: CheckedDeclarations,
) -> Result[CheckedDeclarations, CheckError]:
	match next_nominal(parsed.declarations, checked.records.length(), checked.unions.length(), checked.opaques.length()):
		None:
			Ok(checked)
		Some(declaration):
			access = match declaration:
				UnionDeclarationRow(row): type_access(row.visibility, row.type_name.id)
				RecordDeclarationRow(row): type_access(row.declaration.visibility, row.declaration.type_name.id)
				OpaqueDeclarationRow(_): PrivateTypeUse
			scope: TypeScope = {
				self_binding = None,
				records = inventory_records(parsed.declarations),
				unions = inventory_unions(parsed.declarations),
				opaques = inventory_opaques(parsed.declarations),
				namespace = namespace,
				module = declared_module(declaration),
				access = access,
				parameters = []
			}

			declared: Result[CheckedDeclarations, CheckError] = match declaration:
				UnionDeclarationRow(parsed_union):
					owner = parsed_union.id
					match local_type_parameters(
						parsed_union.type_parameters,
						UnionDeclaration(owner),
						scope,
					):
						Ok(parameters):
							match declared_variants(parsed_union, parameters, []):
								Ok(variants):
									Ok({ checked | unions = checked.unions.append({
												id = owner,
												type_parameters = declared_parameters(parameters),
												variants = variants,
												fixed = parsed_union.fixed,
											}) })
								Err(error): Err(error)
						Err(error): Err(error)
				RecordDeclarationRow(parsed_record):
					owner = parsed_record.id
					match local_type_parameters(parsed_record.declaration.type_parameters, RecordDeclaration(owner), scope):
						Ok(parameters):
							match declared_fields(parsed_record.declaration, owner, parameters, []):
								Ok(fields):
									Ok({ checked | records = checked.records.append({
										id = owner,
										type_parameters = declared_parameters(parameters),
										fields = fields,
									}) })
								Err(error): Err(error)
						Err(error): Err(error)

				OpaqueDeclarationRow(parsed_opaque):
					match local_type_parameters(parsed_opaque.declaration.type_parameters, OpaqueDeclaration(parsed_opaque.id), scope):
						Ok(parameters):
							match resolve_type(parameters, parsed_opaque.declaration.underlying):
								Ok(underlying):
									accepted: CheckedOpaque = {
										id = parsed_opaque.id,
										type_parameters = declared_parameters(parameters),
										underlying_type = {
											value_type = underlying,
											span = type_span(parsed_opaque.declaration.underlying)
										}
									}
									Ok({ checked | opaques = checked.opaques.append(accepted) })
								Err(error): Err(error)
						Err(error): Err(error)

			match declared:
				Ok(updated):
					declare_types(
						parsed,
						namespace,
						updated,
					)
				Err(error): Err(error)




-- Resolves each variant's payload annotation, in declaration order.
private pure func declared_variants(
	declaration: UnionRow,
	scope: TypeScope,
	declared: List[CheckedVariant],
) -> Result[List[CheckedVariant], CheckError]:
	match declaration.variants.get(declared.length()):
		None:
			Ok(declared)
		Some(variant):
			match declared_variant_fields(scope, variant.declaration.fields):
				Ok(fields):

					declared_variants(
						declaration,
						scope,
						declared.append({
							id = variant.id,
							name = variant.declaration.name,
							fields = fields,
						}),
					)
				Err(error): Err(error)


private pure func declared_variant_fields(scope: TypeScope, written: List[TypeSyntax]) -> Result[List[TypeUse], CheckError]:
	var fields: List[TypeUse] = []
	var failure: Option[CheckError] = None
	for annotation in written:
		match resolve_type(scope, annotation):
			Ok(value): fields = fields.append({ value_type = value, span = type_span(annotation) })
			Err(error):
				failure = Some(error)
				break
	match failure:
		Some(error): Err(error)
		None: Ok(fields)


-- Resolves every field annotation in declaration order, retaining its identity and name.
private pure func declared_fields(
	declaration: ParsedRecord,
	owner: RecordId,
	scope: TypeScope,
	declared: List[CheckedField],
) -> Result[List[CheckedField], CheckError]:
	match declaration.fields.get(declared.length()):
		None:
			Ok(declared)
		Some(field):
			match find_field(declared, field.name.id):
				Some(first):
					Err(
						type_declaration_error(
							field.name.span,
							DuplicateRecordField(field.name.id, first.name.span),
						),
					)
				None:
					match resolve_type(scope, field.type_name):
						Ok(value_type):
							span = type_span(field.type_name)

							declared_fields(
								declaration,
								owner,
								scope,
								declared.append({
									id = field_id(owner, declared.length()),
									name = field.name,
									value_type = {
										value_type = value_type,
										span = span
									},
								}),
							)
						Err(error): Err(error)


pure func find_field(fields: List[CheckedField], name: NameId) -> Option[CheckedField]:
	var found: Option[CheckedField] = None

	for field in fields:
		if same_name(field.name.id, name):
			found = Some(field)
			break

	found


-- Every field at one nominal union occurrence, with simultaneous substitution.
pure func occurrence_fields(fields: List[TypeUse], occurrence: UnionOccurrence) -> Result[List[TypeUse], CheckError]:
	substitution: Substitution = { owner = UnionDeclaration(occurrence.owner), values = occurrence.arguments }
	var resolved: List[TypeUse] = []
	var failure: Option[CheckError] = None
	for written in fields:
		match substitute_type(written.value_type, substitution, written.span):
			Ok(value): resolved = resolved.append({ written | value_type = value })
			Err(error):
				failure = Some(error)
				break
	match failure:
		Some(error): Err(error)
		None: Ok(resolved)


-- One declaration's rigid type parameters replaced simultaneously, by
-- declaration position. Replacements are terminal: they are never substituted
-- again, so a caller's own parameters may appear among them.
fixed record Substitution {
	owner: TypeParameterOwner,
	values: List[TypeRef]
}


pure func substitute_type(
	value_type: TypeRef,
	substitution: Substitution,
	span: Span,
) -> Result[TypeRef, CheckError]:
	match value_type:
		TupleType(elements):
			substitute_types(elements, substitution, span, []).map(pure func(values): TupleType(values))
		CallableType(purity, parameters, result):
			match substitute_types(parameters, substitution, span, []):
				Err(error): Err(error)
				Ok(values):
					match substitute_type(result, substitution, span):
						Ok(value): Ok(CallableType(purity, values, value))
						Err(error): Err(error)
		ListType(element):
			substitute_type(element, substitution, span).map(pure func(value): ListType(value))
		NominalType(owner, values):
			match substitute_types(values, substitution, span, []):
				Ok(arguments): Ok(NominalType(owner, arguments))
				Err(error): Err(error)
		ParameterType(id):
			replacement = if same_owner(parameter_owner(id), substitution.owner):
				substitution.values.get(parameter_position(id))
			else:
				None

			replacement.to_result(checker_invariant(span, InvalidParameterDeclaration(id)))
		_:
			Ok(value_type)


private pure func substitute_types(
	values: List[TypeRef],
	substitution: Substitution,
	span: Span,
	substituted: List[TypeRef],
) -> Result[List[TypeRef], CheckError]:
	match values.get(substituted.length()):
		None:
			Ok(substituted)
		Some(value):
			match substitute_type(value, substitution, span):
				Ok(replaced):
					substitute_types(
						values,
						substitution,
						span,
						substituted.append(replaced),
					)
				Err(error): Err(error)


-- One instance on the by-value walk: a union declaration at the checked type
-- arguments its body is expanded with. Visiting is per instance, so
-- `Option[Option[Int]]` expands Option twice without closing a cycle.
private fixed record UnionInstanceVisit {
	declaration: UnionId,
	arguments: List[TypeRef]
}


private pure func same_instance_visit(left: UnionInstanceVisit, right: UnionInstanceVisit) -> Bool:
	if union_number(left.declaration) == union_number(right.declaration):
		same_types(left.arguments, right.arguments)
	else:
		False


private pure func contains_instance_visit(visits: List[UnionInstanceVisit], visit: UnionInstanceVisit) -> Bool:
	var found: Bool = False

	for known in visits:
		if same_instance_visit(known, visit):
			found = True
			break

	found


private pure func completed_instance(completed: List[List[List[TypeRef]]], instance: UnionInstanceVisit) -> Bool:
	var found: Bool = False

	match completed.get(union_number(instance.declaration)):
		Some(instances):
			for arguments in instances:
				if same_types(arguments, instance.arguments):
					found = True
					break
		None:
			void

	found


private union DeclarationVisitStep:
	VisitDeclaredType(TypeUse)
	-- A written payload field of the named union instance's own variant,
	-- already substituted with the instance arguments: the one position
	-- where a reference back to that union is a supported shape.
	VisitVariantPayload(UnionId, TypeUse)
	-- A union declaration walked at its own parameters (rigid for a
	-- generic declaration, none otherwise).
	VisitUnionRoot(UnionId)
	FinishUnionInstance


-- Where a payload of an expanded union body is reported if it closes a
-- cycle: at its own written span inside the declaration, or at the written
-- application that entered the body.
private union PayloadSpan:
	WrittenSpan
	ApplicationSpan(Span)


private pure func push_declaration_visit(
	steps: List[DeclarationVisitStep],
	depth: Int,
	step: DeclarationVisitStep,
) -> List[DeclarationVisitStep]:
	if depth.less_than(steps.length()):
		steps.set(depth, step)
	else:
		steps.append(step)


private pure func push_type_use(steps: List[TypeUse], depth: Int, step: TypeUse) -> List[TypeUse]:
	if depth.less_than(steps.length()):
		steps.set(depth, step)
	else:
		steps.append(step)


private pure func contains_parameter(value_type: TypeRef) -> Bool:
	match value_type:
		TupleType(elements): elements.any(contains_parameter)
		CallableType(purity, parameters, result):
			match parameters.any(contains_parameter):
				True: True
				False: contains_parameter(result)
		ParameterType(_):
			True
		ListType(element):
			contains_parameter(element)
		NominalType(_, arguments):
			arguments.any(contains_parameter)
		_:
			False


-- The parameters of a declaration as the rigid arguments it is walked at.
private pure func rigid_arguments(parameters: List[TypeParameterId]) -> List[TypeRef]:
	var arguments: List[TypeRef] = []

	for parameter in parameters:
		arguments = arguments.append(ParameterType(parameter))

	arguments


-- The written field and payload types of a record or union, with their own spans.
private pure func root_fields(root: AggregateId, declarations: CheckedDeclarations) -> Result[List[TypeUse], CheckError]:
	origin: Span = compiler_span()

	match root:
		UnionAggregate(id):
			match declarations.unions.get(union_number(id)).to_result(checker_invariant(origin, InvalidUnionDeclaration(id))):
				Ok(declaration):
					var fields: List[TypeUse] = []

					for variant in declaration.variants:
						fields = fields.concat(variant.fields)

					Ok(fields)
				Err(error): Err(error)
		RecordAggregate(id):
			match declarations.records.get(record_number(id)).to_result(checker_invariant(origin, InvalidRecordDeclaration(id))):
				Ok(declaration):
					var fields: List[TypeUse] = []

					for field in declaration.fields:
						fields = fields.append(field.value_type)

					Ok(fields)
				Err(error): Err(error)


-- Every generic declaration, each the root of one reinstantiation walk.
private pure func generic_roots(declarations: CheckedDeclarations) -> List[AggregateId]:
	var roots: List[AggregateId] = []

	for declaration in declarations.unions:
		if declaration.type_parameters.is_empty().not():
			roots = roots.append(UnionAggregate(declaration.id))

	for declaration in declarations.records:
		if declaration.type_parameters.is_empty().not():
			roots = roots.append(RecordAggregate(declaration.id))

	roots


-- Whether this written type applies the generic root to one of its own
-- parameters again: the recursion that could instantiate without bound.
private pure func reinstantiates_root(value_type: TypeRef, root: AggregateId) -> Bool:
	match value_type:
		NominalType(owner, arguments):
			if same_nominal(owner, AggregateNominal(root)):
				arguments.any(contains_parameter)
			else:
				False
		_: False


-- Walks every edge (payloads, fields, List elements, applied heads and
-- arguments) reachable from one generic declaration's body, expanding each
-- declaration once, and reports the written type that applies the root to a
-- parameter again. Pointer edges are followed: `Tree[T]` behind a List is
-- still unbounded.
private pure func generic_reinstantiation_edge(
	root: AggregateId,
	declarations: CheckedDeclarations,
) -> Result[Option[TypeUse], CheckError]:
	var union_expanded: List[Bool] = repeat(False, declarations.unions.length())
	var record_expanded: List[Bool] = repeat(False, declarations.records.length())
	var pending: List[TypeUse] = []
	var pending_count = 0
	var closing: Option[TypeUse] = None
	var failure: Option[CheckError] = None
	origin: Span = compiler_span()

	-- The root's own fields are the walk's seeds at their written spans; a
	-- declaration reached from them is expanded by the shared step below at
	-- the span of the root's written type that reached it.
	match root:
		UnionAggregate(id):
			union_expanded = union_expanded.set(union_number(id), True)
		RecordAggregate(id):
			record_expanded = record_expanded.set(record_number(id), True)

	fields ?= root_fields(root, declarations)
	for field in fields:
		pending = push_type_use(pending, pending_count, field)
		pending_count = pending_count.add(1)

	while and(and(pending_count.greater_than(0), failure.is_some().not()), closing.is_some().not()):
		pending_count = pending_count.subtract(1)

		match pending.get(pending_count):
			None:
				failure = Some(checker_invariant(origin, InvalidDeclarationVisit))
			Some(annotation):
				if reinstantiates_root(annotation.value_type, root):
					closing = Some(annotation)
				else:
					match annotation.value_type:
						VoidType | IntType | FloatType | StringType | ParameterType(_):
							void
						CallableType(purity, parameters, result):
							for child in parameters.append(result):
								pending = push_type_use(pending, pending_count, { annotation | value_type = child })
								pending_count = pending_count.add(1)
						TupleType(elements):
							for child in elements:
								pending = push_type_use(pending, pending_count, { annotation | value_type = child })
								pending_count = pending_count.add(1)
						ListType(element):
							pending = push_type_use(pending, pending_count, { annotation | value_type = element })
							pending_count = pending_count.add(1)
						NominalType(_, arguments):
							for argument in arguments:
								pending = push_type_use(pending, pending_count, { annotation | value_type = argument })
								pending_count = pending_count.add(1)

					match annotation.value_type:
						NominalType(AggregateNominal(RecordAggregate(id)), _):
							match record_expanded.get(record_number(id)):
								Some(False):
									record_expanded = record_expanded.set(record_number(id), True)
									match declarations.records.get(record_number(id)):
										None:
											failure = Some(checker_invariant(annotation.span, InvalidRecordDeclaration(id)))
										Some(declaration):
											for field in declaration.fields:
												pending = push_type_use(pending, pending_count, { annotation | value_type = field.value_type.value_type })
												pending_count = pending_count.add(1)
								Some(True):
									void
								None:
									failure = Some(checker_invariant(annotation.span, InvalidRecordDeclaration(id)))
						NominalType(AggregateNominal(UnionAggregate(id)), _):
							match union_expanded.get(union_number(id)):
								Some(False):
									union_expanded = union_expanded.set(union_number(id), True)
									match declarations.unions.get(union_number(id)):
										None:
											failure = Some(checker_invariant(annotation.span, InvalidUnionDeclaration(id)))
										Some(declaration):
											for variant in declaration.variants:
												for field in variant.fields:
													pending = push_type_use(pending, pending_count, { annotation | value_type = field.value_type })
													pending_count = pending_count.add(1)
								Some(True):
									void
								None:
									failure = Some(checker_invariant(annotation.span, InvalidUnionDeclaration(id)))
						_:
							void

	match failure:
		Some(error): Err(error)
		None: Ok(closing)


-- A generic declaration whose body reaches an application of itself to one
-- of its parameters is not supported yet and is rejected at the written type
-- that closes that cycle. A generic declaration elsewhere on a
-- cycle, such as `Option` in `record Node { next: Option[Node] }`, is not on
-- that cycle through its own body and is admitted.
private pure func validate_generic_cycles(declarations: CheckedDeclarations) -> Result[Void, CheckError]:
	var failure: Option[CheckError] = None

	for root in generic_roots(declarations):
		match generic_reinstantiation_edge(root, declarations):
			Err(error):
				failure = Some(error)
			Ok(Some(closing)):
				failure = Some(type_declaration_error(closing.span, RecursiveAggregateType(closing.value_type)))
			Ok(None):
				void

		if failure.is_some():
			break

	match failure:
		Some(error): Err(error)
		None: Ok(void)


-- A unary recursive union stores at most one self-reference per variant, so
-- a node has at most one child and its release can walk a chain. The second
-- written self payload of one variant is the rejected edge.
private pure func repeated_self_payload(owner: UnionId, fields: List[TypeUse]) -> Option[TypeUse]:
	var seen: Bool = False
	var repeated: Option[TypeUse] = None

	for field in fields:
		match field.value_type:
			NominalType(AggregateNominal(UnionAggregate(id)), []):
				if union_number(id) == union_number(owner):
					if seen:
						repeated = Some(field)
						break
					else:
						seen = True
			_:
				void

	repeated


-- An opaque type is stored as its underlying type at its arguments, as
-- specialization erases it. Opaque representation cycles are rejected before
-- this is used, so the chain of opaque types ends.
private pure func stored_type(value_type: TypeRef, span: Span, declarations: CheckedDeclarations) -> Result[TypeRef, CheckError]:
	match value_type:
		NominalType(OpaqueNominal(id), arguments):
			match declarations.opaques.get(opaque_number(id)):
				None:
					Err(checker_invariant(span, InvalidOpaqueDeclaration(id)))
				Some(declaration):
					match substitute_type(declaration.underlying_type.value_type, { owner = OpaqueDeclaration(id), values = arguments }, span):
						Ok(underlying): stored_type(underlying, span, declarations)
						Err(error): Err(error)
		_:
			Ok(value_type)


-- Specialization's rule for a field that keeps its record inline: a number,
-- or a record whose every field, at the record's arguments, is one. A record
-- already on `path` is a layout still in progress there, which is managed.
private pure func inline_record_field(
	value_type: TypeRef,
	path: List[TypeRef],
	span: Span,
	declarations: CheckedDeclarations,
) -> Result[Bool, CheckError]:
	stored ?= stored_type(value_type, span, declarations)
	match stored:
		IntType | FloatType:
			Ok(True)
		NominalType(AggregateNominal(RecordAggregate(id)), arguments):
			if path.any(pure func(entered: TypeRef) -> Bool: same_type(entered, stored)):
				Ok(False)
			else:
				match declarations.records.get(record_number(id)):
					None:
						Err(checker_invariant(span, InvalidRecordDeclaration(id)))
					Some(declaration):
						substitution: Substitution = { owner = RecordDeclaration(id), values = arguments }
						var inline: Result[Bool, CheckError] = Ok(True)
						for field in declaration.fields:
							inline = match substitute_type(field.value_type.value_type, substitution, span):
								Ok(field_type): inline_record_field(field_type, path.append(stored), span, declarations)
								Err(error): Err(error)
							match inline:
								Ok(True): void
								_: break
						inline
		_:
			Ok(False)


-- Whether a fixed union payload keeps the union inline with no counted child.
-- An ordinary union is not accepted even when it is unmanaged today: the
-- promise must be declared, so that editing that union cannot break this one.
private pure func fixed_payload(payload: TypeUse, declarations: CheckedDeclarations) -> Result[Bool, CheckError]:
	span = payload.span
	stored ?= stored_type(payload.value_type, span, declarations)
	match stored:
		VoidType:
			Ok(True)
		NominalType(AggregateNominal(UnionAggregate(id)), _):
			declarations.unions.get(union_number(id))
				.map(pure func(declaration: CheckedUnion) -> Bool: declaration.fixed)
				.to_result(checker_invariant(span, InvalidUnionDeclaration(id)))
		_:
			inline_record_field(stored, [], span, declarations)


private pure func contains_union(unions: List[UnionId], id: UnionId) -> Bool:
	unions.any(pure func(known: UnionId) -> Bool: union_number(known) == union_number(id))


-- Walks the fixed unions `owner` stores by value, depth first, and returns
-- the unions finished so far: those that reach no cycle. `path` holds the
-- unions being walked, so a payload stored as one of them closes a cycle.
-- Every payload has passed `fixed_payload`, so only fixed unions are walked.
private pure func walk_fixed_union(
	owner: CheckedUnion,
	path: List[UnionId],
	finished: List[UnionId],
	declarations: CheckedDeclarations,
) -> Result[List[UnionId], CheckError]:
	var walked = finished
	var failure: Option[CheckError] = None
	for variant in owner.variants:
		for payload in variant.fields:
			if failure.is_none():
				-- The Err and None arms are unreachable guards: every payload and
				-- the union it names were validated before this walk.
				match stored_type(payload.value_type, payload.span, declarations):
					Err(error):
						failure = Some(error)
					Ok(NominalType(AggregateNominal(UnionAggregate(id)), _)):
						if contains_union(path, id):
							failure = Some(type_declaration_error(payload.span, RecursiveFixedUnion(payload.value_type)))
						else if contains_union(walked, id).not():
							match declarations.unions.get(union_number(id)):
								None:
									failure = Some(checker_invariant(payload.span, InvalidUnionDeclaration(id)))
								Some(target):
									match walk_fixed_union(target, path.append(id), walked, declarations):
										Ok(next): walked = next
										Err(error): failure = Some(error)
					Ok(_):
						void
	match failure:
		Some(error): Err(error)
		None: Ok(walked.append(owner.id))


-- A fixed union promises the storage specialization gives a union whose
-- payloads are all unmanaged and none of which contains it: inline, with no
-- counted child. Every payload is checked before any cycle, so a cycle can
-- only pass through fixed unions. The by-value walk below rejects union-only
-- cycles too, but only until mutual cycles and several self payloads are
-- supported; containing itself stays wrong for a fixed union, so this check
-- does not rely on that walk.
private pure func validate_fixed_unions(declarations: CheckedDeclarations) -> Result[Void, CheckError]:
	var failure: Option[CheckError] = None
	for declaration in declarations.unions:
		if declaration.fixed:
			for variant in declaration.variants:
				for payload in variant.fields:
					if failure.is_none():
						failure = match fixed_payload(payload, declarations):
							Ok(True): None
							Ok(False): Some(type_declaration_error(payload.span, NonFixedPayload(payload.value_type)))
							Err(error): Some(error)
	var finished: List[UnionId] = []
	for declaration in declarations.unions:
		if and(and(declaration.fixed, failure.is_none()), contains_union(finished, declaration.id).not()):
			match walk_fixed_union(declaration, [declaration.id], finished, declarations):
				Ok(walked): finished = walked
				Err(error): failure = Some(error)
	match failure:
		Some(error): Err(error)
		None: Ok(void)


-- Every declared aggregate must have a finite layout: the by-value storage
-- graph must be acyclic. A union instance stores each direct payload by
-- value, including the payloads of an applied generic union's body at its
-- arguments; a record field, a List element and a non-generic union's one
-- direct self payload (stored boxed later) are pointer edges a cycle may pass
-- through. A record on a cycle is always managed, so records need no visit.
-- An opaque type is erased to its underlying type at its arguments, which is
-- stored where the opaque type is. A union-only cycle, two self payloads in
-- one variant, and a generic declaration reinstantiating itself are rejected.
-- Fixed unions are checked before the by-value walk, so a fixed union that
-- contains itself is reported by its own rule.
pure func validate_finite_declarations(
	declarations: CheckedDeclarations,
) -> Result[Void, CheckError]:
	generic ?= validate_generic_cycles(declarations)
	-- Expanding opaque types below terminates only once no opaque is on a cycle.
	_: Void ?= validate_opaque_representations(declarations)
	-- validate_fixed_unions expands records at their arguments, which
	-- terminates once no generic declaration reinstantiates itself.
	_: Void ?= validate_fixed_unions(declarations)
	-- These vectors stay in one local builder. Passing them through a shared
	-- record would retain their old roots and copy the entire vector on set.
	var visiting: List[UnionInstanceVisit] = []
	-- The instances already proven finite, as argument lists grouped by union
	-- declaration, so a lookup compares only that declaration's instances.
	var completed: List[List[List[TypeRef]]] = repeat([], declarations.unions.length())
	var pending: List[DeclarationVisitStep] = []
	var pending_count = 0
	var failure: Option[CheckError] = None
	origin: Span = compiler_span()
	-- Roots are walked one at a time with an empty path, in declaration
	-- order: every union at its own parameters (so a generic body's own
	-- instances are checked whether or not another declaration applies it),
	-- every record field, and every type found behind a pointer edge (a List
	-- element, an applied record's arguments), which must itself be finite
	-- but is not stored by value where it was found. The reinstantiation pass
	-- ran first, so the instances a generic body reaches stay finite.
	var roots: List[DeclarationVisitStep] = []

	for declaration in declarations.unions:
		roots = roots.append(VisitUnionRoot(declaration.id))

	for declaration in declarations.records:
		for field in declaration.fields:
			roots = roots.append(VisitDeclaredType(field.value_type))

	var next_root = 0

	while and((or(next_root.less_than(roots.length()), pending_count.greater_than(0))), failure.is_some().not()):
		if pending_count == 0:
			match roots.get(next_root):
				None:
					failure = Some(checker_invariant(origin, InvalidDeclarationVisit))
				Some(root):
					pending = push_declaration_visit(pending, pending_count, root)
					pending_count = pending_count.add(1)

			next_root = next_root.add(1)

		while and(pending_count.greater_than(0), failure.is_some().not()):
			pending_count = pending_count.subtract(1)

			match pending.get(pending_count):
				None:
					failure = Some(checker_invariant(origin, InvalidDeclarationVisit))
				Some(step):
					match step:
						FinishUnionInstance:
							last = visiting.length().subtract(1)
							match visiting.get(last):
								Some(instance):
									number = union_number(instance.declaration)
									match completed.get(number):
										Some(instances):
											completed = completed.set(number, instances.append(instance.arguments))
										None:
											failure = Some(checker_invariant(origin, InvalidUnionDeclaration(instance.declaration)))
									match visiting.remove(last):
										Some(rest):
											visiting = rest
										None:
											failure = Some(checker_invariant(origin, InvalidDeclarationVisit))
								None:
									failure = Some(checker_invariant(origin, InvalidDeclarationVisit))
						VisitUnionRoot(id):
							-- The root starts an empty path, so its own annotation is never
							-- reported; its payloads are reported at their written spans.
							match declarations.unions.get(union_number(id)):
								None:
									failure = Some(checker_invariant(origin, InvalidUnionDeclaration(id)))
								Some(declaration):
									instance: UnionInstanceVisit = { declaration = id, arguments = rigid_arguments(declaration.type_parameters) }
									match expand_union_instance(instance, { value_type = NominalType(AggregateNominal(UnionAggregate(id)), instance.arguments), span = origin }, WrittenSpan, declarations, visiting, completed, pending, pending_count):
										Err(error):
											failure = Some(error)
										Ok(expanded):
											visiting = expanded.visiting
											pending = expanded.pending
											pending_count = expanded.pending_count
						VisitVariantPayload(owner, annotation):
							-- The admitted direct self-reference needs no visit; a bare
							-- union name resolves only for a non-generic declaration. An
							-- opaque type wrapping the owner is not admitted: it is expanded
							-- by value like any other payload.
							admitted = match annotation.value_type:
								NominalType(AggregateNominal(UnionAggregate(id)), []): union_number(id) == union_number(owner)
								_: False

							if admitted.not():
								pending = push_declaration_visit(pending, pending_count, VisitDeclaredType(annotation))
								pending_count = pending_count.add(1)
						VisitDeclaredType(annotation):
							match annotation.value_type:
								VoidType | IntType | FloatType | StringType | ParameterType(_):
									void
								CallableType(purity, parameters, result):
									for child in parameters.append(result):
										roots = roots.append(VisitDeclaredType({ annotation | value_type = child }))
								TupleType(elements):
									for child in elements:
										roots = roots.append(VisitDeclaredType({ annotation | value_type = child }))
								ListType(element):
									roots = roots.append(VisitDeclaredType({ annotation | value_type = element }))
								NominalType(AggregateNominal(UnionAggregate(id)), arguments):
									-- A substituted body reports at the application that substituted it.
									reported: PayloadSpan = if arguments.is_empty():
										WrittenSpan
									else:
										ApplicationSpan(annotation.span)
									match expand_union_instance({ declaration = id, arguments = arguments }, annotation, reported, declarations, visiting, completed, pending, pending_count):
										Err(error):
											failure = Some(error)
										Ok(expanded):
											visiting = expanded.visiting
											pending = expanded.pending
											pending_count = expanded.pending_count
								NominalType(OpaqueNominal(id), arguments):
									match declarations.opaques.get(opaque_number(id)):
										None:
											failure = Some(checker_invariant(annotation.span, InvalidOpaqueDeclaration(id)))
										Some(declaration):
											match substitute_type(declaration.underlying_type.value_type, { owner = OpaqueDeclaration(id), values = arguments }, annotation.span):
												Err(error):
													failure = Some(error)
												Ok(underlying):
													pending = push_declaration_visit(pending, pending_count, VisitDeclaredType({ annotation | value_type = underlying }))
													pending_count = pending_count.add(1)
								-- A record stores its arguments behind a pointer.
								NominalType(_, arguments):
									for argument in arguments:
										roots = roots.append(VisitDeclaredType({ annotation | value_type = argument }))

	match failure:
		Some(error): Err(error)
		None: Ok(void)


-- Fixed-target reachability is fresh for every opaque. Mark a type only when
-- expanding it: all its children are then pending, so an aggregate revisit
-- needs no second expansion. Check target reentry before that shortcut. Every
-- opaque is walked as a target, so an opaque on any cycle is found by its own walk.
private pure func validate_opaque_representation(
	root: CheckedOpaque,
	declarations: CheckedDeclarations,
) -> Result[Void, CheckError]:
	var pending = [root.underlying_type]
	var depth = 1
	var visited: List[TypeRef] = []
	var failure: Option[CheckError] = None
	while and(depth.greater_than(0), failure.is_none()):
		depth = depth.subtract(1)
		match pending.get(depth):
			None: failure = Some(checker_invariant(root.underlying_type.span, InvalidDeclarationVisit))
			Some(annotation):
				reentry = match annotation.value_type:
					NominalType(OpaqueNominal(id), _): opaque_number(id) == opaque_number(root.id)
					_: False
				if reentry:
					failure = Some(type_declaration_error(annotation.span, RecursiveOpaqueRepresentation(root.id)))
				else:
					var seen: Bool = False
					for previous in visited:
						if same_type(previous, annotation.value_type):
							seen = True
							break
					if seen.not():
						visited = visited.append(annotation.value_type)
						children: Result[List[TypeUse], CheckError] = match annotation.value_type:
							TupleType(elements): Ok(elements.map(pure func(element): { annotation | value_type = element }))
							ListType(element): Ok([{ annotation | value_type = element }])
							CallableType(_, parameters, result): Ok(parameters.append(result).map(pure func(child): { annotation | value_type = child }))
							NominalType(owner, arguments): representation_children(owner, arguments, annotation.span, declarations)
							_: Ok([])
						match children:
							Err(error): failure = Some(error)
							Ok(ordered):
								var position = ordered.length()
								while position.greater_than(0):
									position = position.subtract(1)
									match ordered.get(position):
										Some(child):
											pending = push_type_use(pending, depth, child)
											depth = depth.add(1)
										None: failure = Some(checker_invariant(annotation.span, InvalidDeclarationVisit))
	match failure:
		Some(error): Err(error)
		None: Ok(void)


private pure func validate_opaque_representations(declarations: CheckedDeclarations) -> Result[Void, CheckError]:
	var failure: Option[CheckError] = None
	for declaration in declarations.opaques:
		match validate_opaque_representation(declaration, declarations):
			Ok(_): void
			Err(error):
				failure = Some(error)
				break
	match failure:
		Some(error): Err(error)
		None: Ok(void)


-- Arguments, including phantom ones, precede the declaration's written body.
-- The body is not substituted: its parameters are leaves, so the walk meets
-- only written types and is finite however a cycle would grow its arguments.
private pure func representation_children(
	owner: NominalId,
	arguments: List[TypeRef],
	span: Span,
	declarations: CheckedDeclarations,
) -> Result[List[TypeUse], CheckError]:
	body: List[TypeUse] ?= match owner:
		AggregateNominal(aggregate): root_fields(aggregate, declarations)
		OpaqueNominal(id):
			declarations.opaques.get(opaque_number(id)).map(pure func(declaration): [declaration.underlying_type])
				.to_result(checker_invariant(span, InvalidOpaqueDeclaration(id)))
	Ok(arguments.map(pure func(argument): { value_type = argument, span = span }).concat(body))


private fixed record ExpandedInstance {
	visiting: List[UnionInstanceVisit],
	pending: List[DeclarationVisitStep],
	pending_count: Int
}


-- Enters one union instance on the by-value walk: a repeated instance on the
-- current path is a union-only cycle; a completed one needs no second walk.
private pure func expand_union_instance(
	instance: UnionInstanceVisit,
	annotation: TypeUse,
	reported: PayloadSpan,
	declarations: CheckedDeclarations,
	visiting: List[UnionInstanceVisit],
	completed: List[List[List[TypeRef]]],
	pending: List[DeclarationVisitStep],
	pending_count: Int,
) -> Result[ExpandedInstance, CheckError]:
	if contains_instance_visit(visiting, instance):
		Err(type_declaration_error(annotation.span, RecursiveAggregateType(annotation.value_type)))
	else if completed_instance(completed, instance):
		Ok({ visiting = visiting, pending = pending, pending_count = pending_count })
	else:
		match declarations.unions.get(union_number(instance.declaration)):
			Some(declaration):
				substitution: Substitution = { owner = UnionDeclaration(instance.declaration), values = instance.arguments }
				var steps = push_declaration_visit(pending, pending_count, FinishUnionInstance)
				var count = pending_count.add(1)
				var failure: Option[CheckError] = None
				var index = declaration.variants.length()

				while index.greater_than(0):
					index = index.subtract(1)

					match declaration.variants.get(index):
						Some(variant):
							match repeated_self_payload(instance.declaration, variant.fields):
								Some(repeated):
									failure = Some(type_declaration_error(repeated.span, RecursiveAggregateType(repeated.value_type)))
									break
								None:
									void

							var field_position = variant.fields.length()

							while field_position.greater_than(0):
								field_position = field_position.subtract(1)

								match variant.fields.get(field_position):
									Some(field):
										match substitute_type(field.value_type, substitution, field.span):
											Err(error):
												failure = Some(error)
												break
											Ok(substituted):
												payload: TypeUse = match reported:
													WrittenSpan: { field | value_type = substituted }
													ApplicationSpan(span): { value_type = substituted, span = span }
												steps = push_declaration_visit(steps, count, VisitVariantPayload(instance.declaration, payload))
												count = count.add(1)
									None:
										failure = Some(checker_invariant(annotation.span, InvalidDeclarationVisit))
										break
						None:
							failure = Some(checker_invariant(annotation.span, InvalidDeclarationVisit))
							break

					if failure.is_some():
						break

				match failure:
					Some(error):
						Err(error)
					None:
						Ok({ visiting = visiting.append(instance), pending = steps, pending_count = count })
			None: Err(checker_invariant(annotation.span, InvalidUnionDeclaration(instance.declaration)))
