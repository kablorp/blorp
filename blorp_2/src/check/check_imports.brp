---
Translates namespace-owned failures into checking's diagnostic vocabulary.
No successful namespace is inspected or revalidated here.
---
import:
	./check_errors:
		CheckError,
		ImportError(ImportRejected, ImportedConstructorConflict, ImportedFunctionConflict, ImportedVariantConflict),
		PreviousTypeDeclaration(SourceTypeDeclaration),
		SignatureError(DuplicateFunction),
		TypeDeclarationError(DuplicateRecordType, DuplicateUnion, DuplicateVariant, VariantFunctionConflict),
		import_error, signature_error, type_declaration_error,
	../namespace/namespace:
		NamespaceProblem(
			ImportSelectionFailure, DuplicateFunctionName, DuplicateUnionName, DuplicateTypeName,
			DuplicateVariantName, VariantFunctionNameConflict, ImportedConstructorNameConflict,
			ImportedFunctionNameConflict, ImportedVariantNameConflict,
		),
		namespace_problem_span,


pure func namespace_error(problem: NamespaceProblem) -> CheckError:
	span = namespace_problem_span(problem)
	match problem:
		ImportSelectionFailure(rejection): import_error(span, ImportRejected(rejection))
		DuplicateFunctionName(name, previous): signature_error(span, DuplicateFunction(name.id, previous))
		DuplicateUnionName(name, previous): type_declaration_error(span, DuplicateUnion(name.id, SourceTypeDeclaration(previous)))
		DuplicateTypeName(name, previous): type_declaration_error(span, DuplicateRecordType(name.id, SourceTypeDeclaration(previous)))
		DuplicateVariantName(name, previous): type_declaration_error(span, DuplicateVariant(name.id, previous))
		VariantFunctionNameConflict(name, variant, function): type_declaration_error(span, VariantFunctionConflict(name, variant, function))
		ImportedConstructorNameConflict(name, previous): import_error(span, ImportedConstructorConflict(name.id, previous))
		ImportedFunctionNameConflict(name, previous): import_error(span, ImportedFunctionConflict(name.id, previous))
		ImportedVariantNameConflict(name, previous): import_error(span, ImportedVariantConflict(name.id, previous))
