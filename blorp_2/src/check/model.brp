---
The checked program model that checking publishes and specialization reads:
resolved types, signatures, bindings, values and function bodies.
---
import:
	../utils/boolean: not, and
	../namespace/builtins:
		PrimitiveType(BuiltinInt, BuiltinFloat, BuiltinString, BuiltinVoid),
		RuntimeOperation,
		DesignatedBoolean, DesignatedOption,
	../utils/ids:
		TraitId, TraitMethodId, trait_number, trait_method_owner, same_trait_method,
		ConstantId, constant_number,
		FunctionId,
		OpaqueId,
		RecordId,
		UnionId,
		VariantId,
		function_number,
		opaque_number,
		record_number,
		union_number,
		variant_number,
		variant_owner,
	int: Int methods_only
	../utils/source: ModuleId
	../namespace/namespace:
		TypeHead(ListHead, PrimitiveHead, RecordHead, UnionHead, OpaqueHead), same_head,
	../utils/syntax: Entrypoint, FunctionExecution, Purity(Pure, Impure), Span, WrittenName, same_purity


private fixed record FieldIdentity {
	owner: RecordId,
	position: Int
}


opaque type FieldId = FieldIdentity


-- A declared record field: its identity, written name and type annotation.
fixed record CheckedField {
	id: FieldId,
	name: WrittenName,
	value_type: TypeUse
}


fixed record CheckedRecord {
	id: RecordId,
	type_parameters: List[TypeParameterId],
	fields: List[CheckedField]
}


fixed union TypeParameterOwner:
	TraitDeclaration(TraitId)
	FunctionDeclaration(FunctionId)
	UnionDeclaration(UnionId)
	RecordDeclaration(RecordId)


-- Owner and declaration position identify a rigid parameter within this compilation.
private fixed record TypeParameterIdentity {
	owner: TypeParameterOwner,
	position: Int
}


opaque type TypeParameterId = TypeParameterIdentity


fixed union TypeRef:
	VoidType
	IntType
	FloatType
	StringType
	ListType(TypeRef)
	TupleType(List[TypeRef])
	RecordType(RecordId)
	AppliedRecordType(RecordId, List[TypeRef])
	UnionType(UnionId)
	AppliedUnionType(UnionId, List[TypeRef])
	OpaqueType(OpaqueId)
	ParameterType(TypeParameterId)
	CallableType(Purity, List[TypeRef], TypeRef)


-- A declared variant: its identity, written name and ordered field annotations.
fixed record CheckedVariant {
	id: VariantId,
	name: WrittenName,
	fields: List[TypeUse]
}


fixed record CheckedUnion {
	id: UnionId,
	type_parameters: List[TypeParameterId],
	variants: List[CheckedVariant]
}


fixed record CheckedOpaque {
	id: OpaqueId,
	underlying_type: TypeUse
}


fixed record TypeUse {
	value_type: TypeRef,
	span: Span
}


-- A declared bound belongs to one genuine parameter domain. Receiver goals
-- are substituted transiently at a call/reference, never retained in a registry.
fixed record TraitRequirement {
	parameter: TypeParameterId,
	required_trait: TraitId,
	span: Span
}


fixed record FunctionSignature {
	type_parameters: List[TypeParameterId],
	requirements: List[TraitRequirement],
	purity: Purity,
	parameters: List[TypeUse],
	return_type: TypeUse
}


fixed record AcceptedTraitMethod {
	id: TraitMethodId,
	signature: FunctionSignature,
	default_body: Option[FunctionId]
}


fixed record AcceptedTrait {
	id: TraitId,
	methods: List[AcceptedTraitMethod]
}


-- Full receiver families own head/argument positions, not a fabricated
-- generic owner. These located bounds are resolved once at the header.
fixed record LocatedTrait {
	required_trait: TraitId,
	span: Span
}


fixed record ImplementationHeader {
	receiver_head: TypeHead,
	parameter_bounds: List[List[LocatedTrait]]
}


-- Authored methods normalize each header argument into their own function
-- domain. A default normalizes only whole Self into its actual function domain.
fixed union ImplementedBody:
	AuthoredMethod(FunctionId)
	TraitDefault(FunctionId)
	StructuralEquality(AggregateId, CheckedEqualityBody)


fixed union EqualityMember:
	EqualityField(FieldId)
	EqualityPayload(VariantId, Int)


fixed union AggregateId:
	RecordAggregate(RecordId)
	UnionAggregate(UnionId)


-- One ordinary template, owned by its canonical equals member.
fixed record CheckedEqualityBody {
	signature: FunctionSignature,
	bindings: List[BindingDefinition],
	body: CheckedBody
}


fixed record ImplementedMethod {
	method: TraitMethodId,
	body: ImplementedBody
}


fixed record AcceptedImplementation {
	span: Span,
	trait_id: TraitId,
	receiver_head: TypeHead,
	parameter_bounds: List[List[LocatedTrait]],
	methods: List[ImplementedMethod],
	-- Written name-publication authority; None supplies automatic capability
	-- without publishing names, rather than denoting unknown body ownership.
	method_provider: Option[ModuleId]
}


private fixed record CanonicalEqualityContents {
	equals: TraitMethodId,
	not_equals: Option[TraitMethodId]
}
opaque type CanonicalEquality = CanonicalEqualityContents


-- Admission supplies validated members of one canonical trait. Consumers keep
-- identities only; the equals member owns the descriptor's trait identity.
pure func canonical_equality(equals: TraitMethodId, not_equals: Option[TraitMethodId]) -> CanonicalEquality:
	into_opaque CanonicalEquality({ equals = equals, not_equals = not_equals })


pure func canonical_equals(contract: CanonicalEquality) -> TraitMethodId:
	from_opaque CanonicalEquality(contract).equals


pure func canonical_not_equals(contract: CanonicalEquality) -> Option[TraitMethodId]:
	from_opaque CanonicalEquality(contract).not_equals


pure func canonical_owner(contract: CanonicalEquality) -> TraitId:
	trait_method_owner(canonical_equals(contract))


fixed record AcceptedTraitContracts {
	declarations: List[AcceptedTrait],
	canonical: Option[CanonicalEquality]
}


fixed record AcceptedTraits {
	declarations: List[AcceptedTrait],
	implementations: List[AcceptedImplementation],
	canonical: Option[CanonicalEquality]
}


private fixed record MethodCallContents {
	method: TraitMethodId,
	receiver: TypeRef
}
opaque type AcceptedMethodCall = MethodCallContents


pure func accepted_method(method: TraitMethodId, receiver: TypeRef) -> AcceptedMethodCall:
	into_opaque AcceptedMethodCall({ method = method, receiver = receiver })


pure func method_identity(call: AcceptedMethodCall) -> TraitMethodId:
	from_opaque AcceptedMethodCall(call).method


pure func method_receiver(call: AcceptedMethodCall) -> TypeRef:
	from_opaque AcceptedMethodCall(call).receiver


-- A transient projection into the ordinary function-request graph, not a
-- second dispatch table or a retained per-call proof.
fixed record SelectedMethodBody {
	body: BodyOwner,
	arguments: List[TypeRef]
}


pure func receiver_arguments(receiver: TypeRef) -> List[TypeRef]:
	match receiver:
		AppliedRecordType(_, arguments): arguments
		AppliedUnionType(_, arguments): arguments
		ListType(element): [element]
		_: []


pure func method_body(traits: AcceptedTraits, call: AcceptedMethodCall) -> Option[SelectedMethodBody]:
	var found: Option[SelectedMethodBody] = None
	receiver = method_receiver(call)
	match type_head(receiver):
		None: void
		Some(head):
			for implementation in traits.implementations:
				if same_head(implementation.receiver_head, head):
					for member in implementation.methods:
						if same_trait_method(member.method, method_identity(call)):
							match member.body:
								AuthoredMethod(function): found = Some({ body = DeclaredBody(function), arguments = receiver_arguments(receiver) })
								TraitDefault(function): found = Some({ body = DeclaredBody(function), arguments = [receiver] })
								StructuralEquality(aggregate, _): found = Some({ body = DerivedEqualityBody(aggregate), arguments = receiver_arguments(receiver) })
							break
					match found:
						Some(_): break
						None: void
	found


private fixed record CallableParameterIdentity {
	owner: FunctionId,
	position: Int
}
opaque type CallableParameterId = CallableParameterIdentity


pure func callable_parameter(owner: FunctionId, position: Int) -> CallableParameterId:
	into_opaque CallableParameterId({ owner = owner, position = position })


pure func callable_owner(id: CallableParameterId) -> FunctionId:
	from_opaque CallableParameterId(id).owner


pure func callable_position(id: CallableParameterId) -> Int:
	from_opaque CallableParameterId(id).position


pure func same_callable_parameter(left: CallableParameterId, right: CallableParameterId) -> Bool:
	and(
		function_number(callable_owner(left)).equals(function_number(callable_owner(right))),
		callable_position(left).equals(callable_position(right)),
	)


fixed union CallableChoice:
	MethodCallable(AcceptedMethodCall)
	NamedCallable(FunctionId, List[TypeRef])
	ForwardedCallable(CallableParameterId)
	LambdaCallable(LambdaId, List[CheckedExpr])
	StoredCallable(CheckedExpr)


fixed union CheckedCallOperand:
	ValueOperand(CheckedExpr)
	CallableOperand(CallableParameterId, CallableChoice, Span)


fixed union CallIdentity:
	RuntimeTarget(RuntimeOperation[VariantId, TypeRef])
	MethodTarget(TraitMethodId)
	DeclaredTarget(FunctionId)
	ParameterTarget(CallableParameterId)
	ValueTarget(ScopedBindingId)
	ConstantTarget(ConstantId)


fixed union CallTarget:
	TraitMethod(AcceptedMethodCall)
	UserFunction(FunctionId, List[TypeRef])
	CallableParameter(CallableParameterId)
	ValueCall(CheckedExpr)
	RuntimeFunction(RuntimeOperation[VariantId, TypeRef])


-- UFCS places its receiver first; values and callbacks retain written order.
-- Specialization erases callbacks or places their environments at those positions.
fixed record CheckedCall {
	target: CallTarget,
	operands: List[CheckedCallOperand],
	span: Span
}


pure func primitive_ref(value_type: PrimitiveType) -> TypeRef:
	match value_type:
		BuiltinVoid:
			VoidType
		BuiltinInt:
			IntType
		BuiltinFloat:
			FloatType
		BuiltinString:
			StringType


-- A dense ordinal within one checked function, issued in binding order by body
-- checking. binding_id is public only so the checking modules can issue them;
-- an ordinal names a binding, never a role.
opaque type BindingId = Int


opaque type LambdaId = Int


fixed union BodyOwner:
	DeclaredBody(FunctionId)
	LambdaBody(LambdaId)
	DerivedEqualityBody(AggregateId)


fixed record ScopedBindingId {
	owner: BodyOwner,
	binding: BindingId
}


private fixed record CaptureIdentity {
	owner: LambdaId,
	position: Int
}


opaque type CaptureId = CaptureIdentity


pure func capture_id(owner: LambdaId, position: Int) -> CaptureId:
	into_opaque CaptureId({ owner = owner, position = position })


pure func capture_owner(id: CaptureId) -> LambdaId:
	from_opaque CaptureId(id).owner


pure func capture_number(id: CaptureId) -> Int:
	from_opaque CaptureId(id).position


pure func lambda_id(ordinal: Int) -> LambdaId:
	into_opaque LambdaId(ordinal)


pure func lambda_number(id: LambdaId) -> Int:
	from_opaque LambdaId(id)


pure func same_body(left: BodyOwner, right: BodyOwner) -> Bool:
	match left:
		DeclaredBody(first):
			match right:
				DeclaredBody(second): function_number(first).equals(function_number(second))
				_: False
		LambdaBody(first):
			match right:
				LambdaBody(second): lambda_number(first).equals(lambda_number(second))
				_: False

		DerivedEqualityBody(first):
			match right:
				DerivedEqualityBody(second): same_aggregate(first, second)
				_: False


pure func same_aggregate(left: AggregateId, right: AggregateId) -> Bool:
	match left:
		RecordAggregate(first):
			match right:
				RecordAggregate(second): record_number(first).equals(record_number(second))
				_: False
		UnionAggregate(first):
			match right:
				UnionAggregate(second): union_number(first).equals(union_number(second))
				_: False


pure func aggregate_owner(aggregate: AggregateId) -> TypeParameterOwner:
	match aggregate:
		RecordAggregate(record_row): RecordDeclaration(record_row)
		UnionAggregate(union_row): UnionDeclaration(union_row)


pure func equality_body(traits: AcceptedTraits, aggregate: AggregateId) -> Option[CheckedEqualityBody]:
	var found: Option[CheckedEqualityBody] = None
	for implementation in traits.implementations:
		for member in implementation.methods:
			match member.body:
				StructuralEquality(owner, body):
					if same_aggregate(owner, aggregate):
						found = Some(body)
				_: void
	found


pure func same_scoped_binding(left: ScopedBindingId, right: ScopedBindingId) -> Bool:
	match same_body(left.owner, right.owner):
		True: binding_number(left.binding).equals(binding_number(right.binding))
		False: False


fixed union BindingOrigin:
	ParameterBinding(Int)
	CallableParameterBinding(CallableParameterId)
	BodyLocal
	MatchCapture


fixed record BindingDefinition {
	origin: BindingOrigin,
	mutable: Bool,
	value_type: TypeRef,
	span: Span
}


pure func binding_number(id: BindingId) -> Int:
	from_opaque BindingId(id)


fixed record CheckedRecordField {
	field: FieldId,
	value: CheckedExpr,
	span: Span
}


fixed record RetainedRecordField { field: FieldId, value_type: TypeRef }


-- `replacements` are the written fields in written order, which is their
-- evaluation order; `inherited` are the remaining fields in declaration order.
-- Checking guarantees at construction that together they name each of the
-- record's declared fields exactly once (`plan_record_update` in constructors.brp).
fixed record CheckedRecordUpdate {
	base: CheckedExpr,
	base_expression_span: Span,
	replacements: List[CheckedRecordField],
	inherited: List[RetainedRecordField]
}


-- What an expression computes. A payload-free variant has no arguments.
fixed union CheckedForm:
	MakeCallable(CallableChoice)
	LiteralVoid
	LiteralInteger(Int)
	LiteralFloat(Float)
	LiteralString(String)
	ReadBinding(BindingId)
	ReadCapture(CaptureId)
	ConstructVariant(VariantId, List[CheckedExpr])
	ConstructRecord(RecordId, List[CheckedRecordField])
	ConstructList(List[CheckedExpr])
	ConstructTuple(List[CheckedExpr])
	ConstructOpaque(OpaqueId, CheckedExpr)
	ProjectOpaque(OpaqueId, CheckedExpr)
	-- A value match, including an ordinary function's tail expression.
	Match(CheckedJoin)
	UpdateRecord(RecordId, CheckedRecordUpdate)
	InvokeFunction(CheckedCall)
	ReadRecordField(CheckedExpr, FieldId)
	ReadTupleElement(CheckedExpr, Int)


-- One checked expression. `span` is the node's own occurrence: a written base's
-- extent, or a postfix's extent from the written base to that postfix. A call's
-- callee anchor is a separate fact, the span of its CheckedCall.
fixed record CheckedExpr {
	form: CheckedForm,
	value_type: TypeRef,
	span: Span
}


fixed union CheckedStatement:
	InitializeBinding(BindingId, CheckedExpr)
	ReassignBinding(BindingId, CheckedExpr)
	DiscardExpression(CheckedExpr)
	RunWhile(CheckedWhile)
	RunFor(CheckedFor)
	BreakSourceLoop(Span)
	ContinueSourceLoop(Span)


-- Check owns the condition's designation and ordered enclosing writes. Locals
-- belong to the body; specialization decides header eligibility from layouts.
fixed record CheckedWhile {
	condition: CheckedExpr,
	body: List[CheckedStatement],
	carried: List[BindingId],
	boolean: DesignatedBoolean[VariantId],
	span: Span
}


fixed union CheckedIteration:
	ListIteration(CheckedExpr, TypeRef, DesignatedOption[VariantId])
	AscendingIntRange(CheckedExpr, CheckedExpr, DesignatedBoolean[VariantId])


fixed record CheckedFor {
	iteration: CheckedIteration,
	item: Option[BindingId],
	body: List[CheckedStatement],
	carried: List[BindingId],
	span: Span
}


-- Selection identities live within one checked match and survive specialization.
opaque type MatchArmId = Int


opaque type DecisionNodeId = Int


pure func match_arm_id(ordinal: Int) -> MatchArmId:
	into_opaque MatchArmId(ordinal)


pure func match_arm_number(id: MatchArmId) -> Int:
	from_opaque MatchArmId(id)


pure func decision_node_id(ordinal: Int) -> DecisionNodeId:
	into_opaque DecisionNodeId(ordinal)


pure func decision_node_number(id: DecisionNodeId) -> Int:
	from_opaque DecisionNodeId(id)


fixed record CheckedPatternPlace {
	value_type: TypeRef,
	route: CheckedPatternRoute
}


fixed union CheckedPatternRoute:
	MatchRoot
	UnionField(CheckedPatternPlace, VariantId, Int)
	ListElement(CheckedPatternPlace, Int)
	RecordField(CheckedPatternPlace, Int)


fixed union ListLengthTest:
	ExactLength(Int)
	MinimumLength(Int)


fixed union CheckedPatternArgument:
	BorrowPlace(CheckedPatternPlace)
	CopyListSuffix(CheckedPatternPlace, Int)


fixed union CheckedDecisionNode:
	TestVariant(CheckedPatternPlace, VariantId, DecisionNodeId, DecisionNodeId)
	EnterArm(MatchArmId, List[CheckedPatternArgument])
	TestListLength(CheckedPatternPlace, ListLengthTest, DecisionNodeId, DecisionNodeId)
	TestStringBytes(CheckedPatternPlace, String, DecisionNodeId, DecisionNodeId)


-- Successors precede their tests; exhaustive checking establishes the last entry.
fixed record CheckedSelection {
	nodes: List[CheckedDecisionNode],
	entry: DecisionNodeId
}


fixed record CheckedArm {
	id: MatchArmId,
	inputs: List[BindingId],
	statements: List[CheckedStatement],
	body: CheckedExit
}


fixed record CheckedMatch {
	scrutinee: CheckedExpr,
	selection: CheckedSelection,
	arms: List[CheckedArm]
}


fixed union CheckedExit:
	ReturnExpression(CheckedExpr)
	RecurWith(List[CheckedExpr], Span)


-- A value-match arm, including an ordinary function tail: after its
-- statements it yields `value` to the join, then the enclosing body continues.
fixed record CheckedJoinArm {
	id: MatchArmId,
	inputs: List[BindingId],
	statements: List[CheckedStatement],
	value: CheckedExpr
}


-- A value match: the enclosing body continues with the selected arm's value,
-- including the return after an ordinary function tail. The expression's type
-- is Void for a statement match; annotated root tails use CheckedMatchBody.
fixed record CheckedJoin {
	scrutinee: CheckedExpr,
	selection: CheckedSelection,
	arms: List[CheckedJoinArm],
	carried: List[BindingId]
}


fixed union CheckedBody:
	CheckedValueBody(CheckedExit)
	CheckedMatchBody(CheckedMatch)


fixed record CheckedFunction {
	id: FunctionId,
	execution: FunctionExecution,
	signature: FunctionSignature,
	bindings: List[BindingDefinition],
	statements: List[CheckedStatement],
	body: CheckedBody
}


-- One global row per admitted site; local bindings belong to this body only.
fixed record CheckedCapture {
	binding: ScopedBindingId,
	value_type: TypeUse
}


fixed record CheckedLambda {
	purity: Purity,
	root: FunctionId,
	parameters: List[TypeUse],
	return_type: TypeUse,
	bindings: List[BindingDefinition],
	captures: List[CheckedCapture],
	statements: List[CheckedStatement],
	body: CheckedBody
}


-- Construction rows retain the lexical parent while descendants resolve free
-- reads. Only CheckedLambda rows pass the final Check publication boundary.
fixed record PendingLambdaRow {
	parent: BodyOwner,
	captures: List[CheckedCapture]
}


fixed union LambdaRow:
	CollectingLambda(PendingLambdaRow)
	CheckedLambdaRow(CheckedLambda)


fixed record CheckedValueResult {
	value: CheckedExpr,
	lambdas: List[LambdaRow]
}


fixed record ResolvedBody {
	bindings: List[BindingDefinition],
	statements: List[CheckedStatement],
	body: CheckedBody,
	lambdas: List[LambdaRow]
}


fixed record CheckedBodies {
	functions: List[CheckedFunction],
	lambdas: List[CheckedLambda]
}


-- A checked construction template; every runtime read gets ordinary value identities.
fixed record CheckedConstant {
	id: ConstantId,
	annotation: Span,
	value: CheckedExpr
}


pure func constant_row(constants: List[CheckedConstant], id: ConstantId) -> Option[CheckedConstant]:
	constants.get(constant_number(id))


fixed record CheckedFunctions {
	traits: AcceptedTraits,
	records: List[CheckedRecord],
	unions: List[CheckedUnion],
	opaques: List[CheckedOpaque],
	functions: List[CheckedFunction],
	lambdas: List[CheckedLambda],
	entrypoint: Entrypoint[FunctionId]
}


pure func field_owner(id: FieldId) -> RecordId:
	from_opaque FieldId(id).owner


pure func field_number(id: FieldId) -> Int:
	from_opaque FieldId(id).position


-- The namespace's identity for a type's outermost constructor. A rigid type
-- parameter names no visible type.
pure func type_head(value_type: TypeRef) -> Option[TypeHead]:
	match value_type:
		VoidType:
			Some(PrimitiveHead(BuiltinVoid))
		IntType:
			Some(PrimitiveHead(BuiltinInt))
		FloatType:
			Some(PrimitiveHead(BuiltinFloat))
		StringType:
			Some(PrimitiveHead(BuiltinString))
		ListType(_):
			Some(ListHead)
		RecordType(id):
			Some(RecordHead(id))
		AppliedRecordType(id, _):
			Some(RecordHead(id))
		UnionType(id):
			Some(UnionHead(id))
		AppliedUnionType(id, _):
			Some(UnionHead(id))
		OpaqueType(id):
			Some(OpaqueHead(id))
		ParameterType(_) | CallableType(_, _, _) | TupleType(_):
			None


-- Header arity is established before this semantic application is requested.
pure func receiver_type(head: TypeHead, arguments: List[TypeRef]) -> Option[TypeRef]:
	match head:
		PrimitiveHead(primitive): Some(primitive_ref(primitive))
		OpaqueHead(owner): Some(OpaqueType(owner))
		RecordHead(owner):
			if arguments.is_empty():
				Some(RecordType(owner))
			else:
				Some(AppliedRecordType(owner, arguments))
		UnionHead(owner):
			if arguments.is_empty():
				Some(UnionType(owner))
			else:
				Some(AppliedUnionType(owner, arguments))
		ListHead:
			match arguments:
				[element]: Some(ListType(element))
				_: None


-- Composite types compare their children. The remaining leaf types are equal
-- exactly when they name the same type.
pure func same_type(left: TypeRef, right: TypeRef) -> Bool:
	match left:
		TupleType(elements):
			match right:
				TupleType(others): same_types(elements, others)
				_: False
		ListType(element):
			match right:
				ListType(other):
					same_type(element, other)
				_:
					False
		AppliedRecordType(owner, arguments):
			match right:
				AppliedRecordType(other_owner, others):
					match record_number(owner).equals(record_number(other_owner)):
						True: same_types(arguments, others)
						False: False
				_:
					False
		AppliedUnionType(owner, arguments):
			match right:
				AppliedUnionType(other_owner, others):
					match union_number(owner).equals(union_number(other_owner)):
						True: same_types(arguments, others)
						False: False
				_:
					False
		CallableType(purity, parameters, result):
			match right:
				CallableType(other_purity, others, other):
					match and(same_purity(purity, other_purity), same_types(parameters, others)):
						True: same_type(result, other)
						False: False
				_: False
		ParameterType(parameter):
			match right:
				ParameterType(other):
					same_parameter(parameter, other)
				_:
					False
		VoidType:
			match right:
				VoidType: True
				_: False
		IntType:
			match right:
				IntType: True
				_: False
		FloatType:
			match right:
				FloatType: True
				_: False
		StringType:
			match right:
				StringType: True
				_: False
		RecordType(owner):
			match right:
				RecordType(other_owner): record_number(owner).equals(record_number(other_owner))
				_: False
		UnionType(owner):
			match right:
				UnionType(other_owner): union_number(owner).equals(union_number(other_owner))
				_: False
		OpaqueType(owner):
			match right:
				OpaqueType(other_owner): opaque_number(owner).equals(opaque_number(other_owner))
				_: False


-- Compare ordered children without materializing list-pattern tails. Nested
-- nominal equality visits this boundary at every application depth.
pure func same_types(left: List[TypeRef], right: List[TypeRef]) -> Bool:
	var matches = left.length().equals(right.length())
	var index: Int = 0

	for value in left:
		match right.get(index):
			Some(other):
				matches = match matches:
					True: same_type(value, other)
					False: False
			None:
				matches = False

		if matches.not():
			break

		index = index.add(1)

	matches


pure func parameter_owner(id: TypeParameterId) -> TypeParameterOwner:
	from_opaque TypeParameterId(id).owner


pure func parameter_position(id: TypeParameterId) -> Int:
	from_opaque TypeParameterId(id).position


pure func same_owner(left: TypeParameterOwner, right: TypeParameterOwner) -> Bool:
	match left:
		TraitDeclaration(left_trait):
			match right:
				TraitDeclaration(right_trait): trait_number(left_trait).equals(trait_number(right_trait))
				_: False
		FunctionDeclaration(left_function):
			match right:
				FunctionDeclaration(right_function):
					function_number(left_function).equals(function_number(right_function))
				_:
					False
		UnionDeclaration(left_union):
			match right:
				UnionDeclaration(right_union):
					union_number(left_union).equals(union_number(right_union))
				_:
					False
		RecordDeclaration(left_record):
			match right:
				RecordDeclaration(right_record):
					record_number(left_record).equals(record_number(right_record))
				_:
					False

pure func same_parameter(left: TypeParameterId, right: TypeParameterId) -> Bool:
	and(
		same_owner(parameter_owner(left), parameter_owner(right)),
		parameter_position(left).equals(parameter_position(right)),
	)


-- A union type's declaration and its ordered type arguments; a nongeneric
-- union occurrence has none.
fixed record UnionOccurrence {
	owner: UnionId,
	arguments: List[TypeRef]
}


pure func union_occurrence(value: TypeRef) -> Option[UnionOccurrence]:
	match value:
		UnionType(id):
			Some({
				owner = id,
				arguments = [],
			})
		AppliedUnionType(id, arguments):
			Some({
				owner = id,
				arguments = arguments,
			})
		_:
			None


pure func same_variant(left: VariantId, right: VariantId) -> Bool:
	and(
		union_number(variant_owner(left)).equals(union_number(variant_owner(right))),
		variant_number(left).equals(variant_number(right)),
	)


private pure func append_exit_calls(
	collected: List[CheckedCall],
	exit: CheckedExit,
) -> List[CheckedCall]:
	match exit:
		ReturnExpression(value):
			append_value_calls(collected, value)
		RecurWith(arguments, _):
			var calls = collected

			for argument in arguments:
				calls = append_value_calls(calls, argument)

			calls


-- Calls in evaluation order: a node's children left to right, then the node.
private pure func append_value_calls(
	collected: List[CheckedCall],
	value: CheckedExpr,
) -> List[CheckedCall]:
	var calls = collected

	match value.form:
		ConstructOpaque(_, child):
			calls = append_value_calls(calls, child)
		ProjectOpaque(_, child):
			calls = append_value_calls(calls, child)
		UpdateRecord(_, update):
			calls = append_value_calls(calls, update.base)
			for field in update.replacements:
				calls = append_value_calls(calls, field.value)
		ConstructRecord(_, fields):
			for field in fields:
				calls = append_value_calls(calls, field.value)
		ConstructVariant(_, fields):
			for field in fields:
				calls = append_value_calls(calls, field)
		ConstructTuple(elements):
			for element in elements:
				calls = append_value_calls(calls, element)
		ConstructList(elements):
			for element in elements:
				calls = append_value_calls(calls, element)
		Match(join):
			calls = append_value_calls(calls, join.scrutinee)
			for arm in join.arms:
				calls = append_statement_calls(calls, arm.statements)
				calls = append_value_calls(calls, arm.value)
		InvokeFunction(call):
			match call.target:
				ValueCall(callee): calls = append_value_calls(calls, callee)
				TraitMethod(_) | UserFunction(_, _) | CallableParameter(_) | RuntimeFunction(_): void
			for operand in call.operands:
				match operand:
					ValueOperand(argument): calls = append_value_calls(calls, argument)
					CallableOperand(_, choice, _):
						match choice:
							StoredCallable(child): calls = append_value_calls(calls, child)
							MethodCallable(_) | NamedCallable(_, _) | ForwardedCallable(_) | LambdaCallable(_, _): void

			calls = calls.append(call)
		ReadTupleElement(receiver, _):
			calls = append_value_calls(calls, receiver)
		ReadRecordField(receiver, _):
			calls = append_value_calls(calls, receiver)
		MakeCallable(choice):
			match choice:
				StoredCallable(child): calls = append_value_calls(calls, child)
				MethodCallable(_) | NamedCallable(_, _) | ForwardedCallable(_) | LambdaCallable(_, _): void
		LiteralVoid | LiteralInteger(_) | LiteralFloat(_) | LiteralString(_) | ReadBinding(_) | ReadCapture(_):
			void

	calls


private pure func append_statement_calls(
	collected: List[CheckedCall],
	statements: List[CheckedStatement],
) -> List[CheckedCall]:
	var calls = collected

	for statement in statements:
		match statement:
			InitializeBinding(_, value):
				calls = append_value_calls(calls, value)
			DiscardExpression(value):
				calls = append_value_calls(calls, value)
			ReassignBinding(_, value):
				calls = append_value_calls(calls, value)
			RunWhile(loop):
				calls = append_statement_calls(append_value_calls(calls, loop.condition), loop.body)
			BreakSourceLoop(_) | ContinueSourceLoop(_): void
			RunFor(loop):
				match loop.iteration:
					ListIteration(iterable, _, _): calls = append_value_calls(calls, iterable)
					AscendingIntRange(start, end, _):
						calls = append_value_calls(append_value_calls(calls, start), end)
				calls = append_statement_calls(calls, loop.body)

	calls


pure func expression_calls(value: CheckedExpr) -> List[CheckedCall]:
	append_value_calls([], value)


pure func function_calls(function: CheckedFunction) -> List[CheckedCall]:
	body_calls(function.statements, function.body)


pure func lambda_calls(lambda: CheckedLambda) -> List[CheckedCall]:
	body_calls(lambda.statements, lambda.body)


pure func body_calls(statements: List[CheckedStatement], body: CheckedBody) -> List[CheckedCall]:
	var calls = append_statement_calls([], statements)

	match body:
		CheckedValueBody(value):
			append_exit_calls(calls, value)
		CheckedMatchBody(matched):
			calls = append_value_calls(calls, matched.scrutinee)

			for arm in matched.arms:
				calls = append_statement_calls(calls, arm.statements)
				calls = append_exit_calls(calls, arm.body)

			calls


pure func field_id(owner: RecordId, position: Int) -> FieldId:
	into_opaque FieldId({
			owner = owner,
			position = position
		})


pure func type_parameter_id(owner: TypeParameterOwner, position: Int) -> TypeParameterId:
	into_opaque TypeParameterId({
			owner = owner,
			position = position
		})


pure func binding_id(ordinal: Int) -> BindingId:
	into_opaque BindingId(ordinal)


pure func has_callable_parameters(signature: FunctionSignature) -> Bool:
	signature.parameters.any(pure func(parameter):
		match parameter.value_type:
			CallableType(_, _, _): True
			_: False
	)


-- Value creation requests a body instance but does not execute it. This walk
-- follows only evaluated operands; each lambda's body is a separate request.
private pure func callable_creations(values: List[CheckedExpr]) -> List[CheckedExpr]:
	var found: List[CheckedExpr] = []
	for value in values:
		var children: List[CheckedExpr] = []
		match value.form:
			MakeCallable(choice):
				found = found.append(value)
				match choice:
					LambdaCallable(_, captures): children = captures
					StoredCallable(child): children = [child]
					MethodCallable(_) | NamedCallable(_, _) | ForwardedCallable(_): void
			InvokeFunction(call):
				match call.target:
					ValueCall(callee): children = [callee]
					TraitMethod(_) | UserFunction(_, _) | CallableParameter(_) | RuntimeFunction(_): void
				for operand in call.operands:
					match operand:
						ValueOperand(argument): children = children.append(argument)
						CallableOperand(_, choice, _):
							match choice:
								StoredCallable(child): children = children.append(child)
								LambdaCallable(_, captures): children = children.concat(captures)
								MethodCallable(_) | NamedCallable(_, _) | ForwardedCallable(_): void
			ConstructTuple(elements): children = elements
			ConstructList(elements): children = elements
			ConstructVariant(_, elements): children = elements
			ConstructRecord(_, fields): children = fields.map(pure func(field): field.value)
			UpdateRecord(_, update): children = [update.base].concat(update.replacements.map(pure func(field): field.value))
			ConstructOpaque(_, child): children = [child]
			ProjectOpaque(_, child): children = [child]
			ReadTupleElement(child, _): children = [child]
			ReadRecordField(child, _): children = [child]
			Match(join):
				found = found.concat(callable_creations([join.scrutinee]))
				for arm in join.arms:
					found = found.concat(statement_creations(arm.statements)).concat(callable_creations([arm.value]))
			LiteralVoid | LiteralInteger(_) | LiteralFloat(_) | LiteralString(_) | ReadBinding(_) | ReadCapture(_): void
		found = found.concat(callable_creations(children))
	found


private pure func statement_creations(statements: List[CheckedStatement]) -> List[CheckedExpr]:
	var found: List[CheckedExpr] = []
	for statement in statements:
		match statement:
			InitializeBinding(_, value): found = found.concat(callable_creations([value]))
			ReassignBinding(_, value): found = found.concat(callable_creations([value]))
			DiscardExpression(value): found = found.concat(callable_creations([value]))
			RunWhile(loop): found = found.concat(callable_creations([loop.condition])).concat(statement_creations(loop.body))
			RunFor(loop):
				match loop.iteration:
					ListIteration(value, _, _): found = found.concat(callable_creations([value]))
					AscendingIntRange(start, end, _): found = found.concat(callable_creations([start, end]))
				found = found.concat(statement_creations(loop.body))
			BreakSourceLoop(_) | ContinueSourceLoop(_): void
	found


private pure func exit_creations(exit: CheckedExit) -> List[CheckedExpr]:
	match exit:
		ReturnExpression(value): callable_creations([value])
		RecurWith(arguments, _): callable_creations(arguments)


pure func body_callable_creations(statements: List[CheckedStatement], body: CheckedBody) -> List[CheckedExpr]:
	var found = statement_creations(statements)
	match body:
		CheckedValueBody(exit): found = found.concat(exit_creations(exit))
		CheckedMatchBody(matched):
			found = found.concat(callable_creations([matched.scrutinee]))
			for arm in matched.arms:
				found = found.concat(statement_creations(arm.statements)).concat(exit_creations(arm.body))
	found


pure func expression_callable_creations(value: CheckedExpr) -> List[CheckedExpr]:
	callable_creations([value])
