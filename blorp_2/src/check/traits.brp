---
Accepts abstract requirements and concrete authored implementations once, before
any body can use them. Inventory owns member identities; this phase publishes
the resolved requirement-to-body mapping consumed by checking and specialization.
---
import:
	./declarations: TypeScope, type_access, previous_declaration, resolve_type, Substitution, substitute_type
	./errors: CheckError, checker_invariant, CheckerInvariant(InvalidFunctionContract), TraitError(EqualityMemberUnsupported, DuplicateRequirementParameter, ImpureRequirement, GenericRequirement, FirstParameterMustBeSelf, CallableFormalDeferred, OrphanImplementation, DuplicateImplementation, MissingImplementationMethod, MissingTraitBound, UnknownImplementationMethod, DuplicateImplementationMethod, ImplementationSignatureMismatch, MalformedCanonicalTrait, MalformedCanonicalInequality), trait_error
	./model: AggregateId(RecordAggregate, UnionAggregate), EqualityMember(EqualityField, EqualityPayload), CheckedRecord, CheckedUnion, AcceptedTraits, AcceptedTraitContracts, CanonicalEquality, canonical_equality, canonical_owner, AcceptedTrait, AcceptedTraitMethod, AcceptedImplementation, ImplementedMethod, ImplementedBody(AuthoredMethod, TraitDefault, StructuralEquality), TypeParameterId, LocatedTrait, TraitRequirement, aggregate_owner, same_owner, receiver_arguments, receiver_type, type_head, parameter_owner, same_parameter, ImplementationHeader, FunctionSignature, TypeUse, TypeRef(ListType, AppliedRecordType, AppliedUnionType, ParameterType, VoidType, IntType, FloatType, StringType, CallableType, UnionType, RecordType, OpaqueType), TypeParameterOwner(TraitDeclaration), type_parameter_id, same_type, same_types
	./equality: equality_template
	./signatures: AcceptedFunction
	../namespace/builtins: DesignatedBoolean
	../namespace/namespace: Namespace, TypeHead(PrimitiveHead, ListHead, RecordHead, UnionHead, OpaqueHead), same_head, named_trait, implementation_trait
	../parse/assemble: ParsedContents
	../utils/ids: RecordRow, UnionRow, FunctionId, VariantId, TraitMethodId, TraitMethodDeclaration(RequiredMethod, DefaultMethod), trait_method_header, trait_method_number, trait_method_owner, TraitRow, TraitMethodRow, ImplRow, TraitId, inventory_traits, inventory_implementations, inventory_functions, inventory_records, inventory_unions, inventory_opaques, trait_number, impl_number, function_number, record_number, union_number, opaque_number, variant_owner, same_trait_method
	../utils/names: contextual_words, foundation_words, same_name
	../utils/source: ModuleId, compiler_source, same_module, module_number, ModuleKind(LibraryModule)
	../utils/syntax: FunctionHeader, WrittenName, TypeSyntax(CallableTypeSyntax), Purity(Pure), type_span, same_purity, Span
	list: List methods_only
	int: Int methods_only
	option: Option methods_only
	../utils/boolean: not, and, or


private pure func requirement(row: TraitMethodRow, scope: TypeScope, owner: TraitId, parsed: ParsedContents) -> Result[AcceptedTraitMethod, CheckError]:
	header ?= trait_method_header(row, parsed.declarations).to_result(checker_invariant(row.span, InvalidFunctionContract))
	pure_requirement: Void ?= if same_purity(header.purity, Pure):
		Ok(void)
	else:
		Err(trait_error(header.function_name.span, ImpureRequirement(row.id)))
	monomorphic: Void ?= if header.type_parameters.is_empty():
		Ok(void)
	else:
		Err(trait_error(header.function_name.span, GenericRequirement(row.id)))
	var parameters: List[TypeUse] = []
	var failure: Option[CheckError] = None
	for parameter in header.parameters:
		resolved: Result[TypeRef, CheckError] = match parameter.type_name:
			CallableTypeSyntax(_, _, _, _): Err(trait_error(type_span(parameter.type_name), CallableFormalDeferred(row.id)))
			_: resolve_type(scope, parameter.type_name)
		match resolved:
			Ok(value_type): parameters = parameters.append({ value_type = value_type, span = type_span(parameter.type_name) })
			Err(error):
				failure = Some(error)
				break
	ready: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	self = type_parameter_id(TraitDeclaration(owner), 0)
	first: Void ?= match parameters:
		[value, ..._]:
			if same_type(value.value_type, ParameterType(self)):
				Ok(void)
			else:
				Err(trait_error(value.span, FirstParameterMustBeSelf(row.id)))
		[]: Err(trait_error(header.function_name.span, FirstParameterMustBeSelf(row.id)))
	result ?= match header.return_type:
		Some(written): resolve_type(scope, written)
		None: Ok(VoidType)
	result_span = match header.return_type:
		Some(written): type_span(written)
		None: header.function_name.span
	unique ?= unique_requirement_parameters(row.id, header)
	default_body: Option[FunctionId] = match row.declaration:
		RequiredMethod(_): None
		DefaultMethod(function): Some(function)
	Ok({ id = row.id, default_body = default_body, signature = { type_parameters = [self], requirements = [], purity = Pure, parameters = parameters, return_type = { value_type = result, span = result_span } } })


private pure func accept_trait(row: TraitRow, parsed: ParsedContents, namespace: Namespace) -> Result[AcceptedTrait, CheckError]:
	self = type_parameter_id(TraitDeclaration(row.id), 0)
	scope: TypeScope = {
		records = inventory_records(parsed.declarations), unions = inventory_unions(parsed.declarations),
		namespace = namespace, module = row.module, access = type_access(row.visibility, row.type_name.id), parameters = [],
		self_binding = Some({ name = contextual_words(parsed.names).self_word, value_type = ParameterType(self) })
	}
	var methods: List[AcceptedTraitMethod] = []
	var failure: Option[CheckError] = None
	for method in row.methods:
		match requirement(method, scope, row.id, parsed):
			Ok(accepted): methods = methods.append(accepted)
			Err(error):
				failure = Some(error)
				break
	ready: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	Ok({ id = row.id, methods = methods })


private pure func canonical_header(row: TraitRow, method: TraitMethodId, parsed: ParsedContents) -> Result[FunctionHeader, CheckError]:
	written ?= row.methods.get(trait_method_number(method)).to_result(checker_invariant(row.type_name.span, InvalidFunctionContract))
	trait_method_header(written, parsed.declarations).to_result(checker_invariant(row.type_name.span, InvalidFunctionContract))


-- Ordinary method signatures have already succeeded. The sole abstract equals
-- contract precedes validation of an optional reserved inequality default.
private pure func accept_canonical(row: TraitRow, accepted: AcceptedTrait, parsed: ParsedContents, boolean: DesignatedBoolean[VariantId]) -> Result[CanonicalEquality, CheckError]:
	self: TypeRef = ParameterType(type_parameter_id(TraitDeclaration(row.id), 0))
	boolean_type: TypeRef = UnionType(variant_owner(boolean.true_variant))
	abstract_methods = accepted.methods.filter(pure func(method): method.default_body.is_none())
	equals: TraitMethodId ?= match abstract_methods:
		[method]:
			match canonical_header(row, method.id, parsed):
				Ok(header):
					if and(same_name(header.function_name.id, foundation_words(parsed.names).equals_word), and(same_types(method.signature.parameters.map(pure func(parameter): parameter.value_type), [self, self]), same_type(method.signature.return_type.value_type, boolean_type))):
						Ok(method.id)
					else:
						Err(trait_error(row.type_name.span, MalformedCanonicalTrait(row.id)))
				Err(error): Err(error)
		_: Err(trait_error(row.type_name.span, MalformedCanonicalTrait(row.id)))
	var inequality: Option[TraitMethodId] = None
	var failure: Option[CheckError] = None
	for method in accepted.methods:
		match canonical_header(row, method.id, parsed):
			Err(error): failure = Some(error)
			Ok(header):
				if same_name(header.function_name.id, foundation_words(parsed.names).not_equals_word):
					if and(method.default_body.is_some(), and(same_types(method.signature.parameters.map(pure func(parameter): parameter.value_type), [self, self]), same_type(method.signature.return_type.value_type, boolean_type))):
						inequality = Some(method.id)
					else:
						failure = Some(trait_error(header.function_name.span, MalformedCanonicalInequality(method.id)))
		if failure.is_some():
			break
	match failure:
		Some(error): Err(error)
		None: Ok(canonical_equality(equals, inequality))


private pure func receiver_module(receiver: TypeHead, parsed: ParsedContents) -> Option[ModuleId]:
	match receiver:
		PrimitiveHead(_) | ListHead: Some(parsed.foundation.types)
		RecordHead(id):
			inventory_records(parsed.declarations).get(record_number(id)).map(pure func(owner): owner.declaration.module)
		UnionHead(id):
			inventory_unions(parsed.declarations).get(union_number(id)).map(pure func(owner): owner.module)
		OpaqueHead(id):
			inventory_opaques(parsed.declarations).get(opaque_number(id)).map(pure func(owner): owner.declaration.module)

private pure func accept_implementation(
	row: ImplRow,
	header: ImplementationHeader,
	parsed: ParsedContents,
	namespace: Namespace,
	traits: List[AcceptedTrait],
	functions: List[AcceptedFunction],
	previous: List[AcceptedImplementation],
	canonical: Option[TraitId],
) -> Result[AcceptedImplementation, CheckError]:
	owner ?= implementation_trait(namespace, row.header.module, row.id).to_result(checker_invariant(row.header.span, InvalidFunctionContract))
	written ?= inventory_traits(parsed.declarations).get(trait_number(owner)).to_result(checker_invariant(row.header.span, InvalidFunctionContract))
	declaration ?= traits.get(trait_number(owner)).to_result(checker_invariant(row.header.span, InvalidFunctionContract))
	receiver_owner = receiver_module(header.receiver_head, parsed)
	own_receiver = match receiver_owner:
		Some(module): same_module(module, row.header.module)
		None: False
	foundation_receiver = match receiver_owner:
		Some(module): same_module(module, parsed.foundation.types)
		None: False
	canonical_library: Bool = match canonical:
		Some(selected):
			if trait_number(selected).equals(trait_number(owner)):
				match parsed.modules.get(module_number(written.module)):
					Some(module):
						match module.role:
							LibraryModule: True
							_: False
					None: False
			else:
				False
		None: False
	library = match parsed.modules.get(module_number(row.header.module)):
		Some(module):
			match module.role:
				LibraryModule: and(foundation_receiver, or(same_module(written.module, parsed.foundation.types), canonical_library))
				_: False
		None: False
	orphan: Void ?= if or(same_module(written.module, row.header.module), or(own_receiver, library)):
		Ok(void)
	else:
		Err(trait_error(row.header.span, OrphanImplementation(owner, header.receiver_head)))
	var failure: Option[CheckError] = None
	for existing in previous:
		if and(trait_number(existing.trait_id).equals(trait_number(owner)), same_head(existing.receiver_head, header.receiver_head)):
			failure = Some(trait_error(row.header.span, DuplicateImplementation(owner, header.receiver_head, existing.span)))
	var members: List[ImplementedMethod] = []
	var seen: List[AcceptedFunction] = []
	for body in row.methods:
		if failure.is_some():
			break
		match functions.get(function_number(body)):
			Some(function):
				var method: Option[AcceptedTraitMethod] = None
				for required in declaration.methods:
					match written.methods.get(trait_method_number(required.id)):
						Some(source):
							match trait_method_header(source, parsed.declarations):
								Some(source_header):
									if same_name(source_header.function_name.id, function.declaration.function_name.id):
										method = Some(required)
								None: failure = Some(checker_invariant(source.span, InvalidFunctionContract))
						None: failure = Some(checker_invariant(row.header.span, InvalidFunctionContract))
				for earlier in seen:
					if same_name(earlier.declaration.function_name.id, function.declaration.function_name.id):
						failure = Some(trait_error(function.declaration.function_name.span, DuplicateImplementationMethod(function.declaration.function_name.id, earlier.declaration.function_name.span)))
				if failure.is_none():
					match method:
						None: failure = Some(trait_error(function.declaration.function_name.span, UnknownImplementationMethod(function.declaration.function_name.id)))
						Some(required):
							match member_contract(required, header, function):
								Err(error): failure = Some(error)
								Ok(_):
									member: ImplementedMethod = { method = required.id, body = AuthoredMethod(body) }
									members = members.append(member)
				seen = seen.append(function)
			None: failure = Some(checker_invariant(row.header.span, InvalidFunctionContract))
		if failure.is_some():
			break
	for required in declaration.methods:
		implemented = members.any(pure func(member): same_trait_method(member.method, required.id))
		if and(implemented.not(), failure.is_none()):
			match required.default_body:
				Some(function): members = members.append({ method = required.id, body = TraitDefault(function) })
				None: failure = Some(trait_error(row.header.span, MissingImplementationMethod(required.id)))
	match failure:
		Some(error): Err(error)
		None: Ok({ trait_id = owner, receiver_head = header.receiver_head, parameter_bounds = header.parameter_bounds, methods = members, method_provider = Some(row.header.module), span = row.header.span })


private pure func member_contract(
	required: AcceptedTraitMethod,
	header: ImplementationHeader,
	function: AcceptedFunction,
) -> Result[Void, CheckError]:
	receiver ?= receiver_type(header.receiver_head, function.signature.type_parameters.map(pure func(parameter): ParameterType(parameter)))
		.to_result(checker_invariant(function.declaration.function_name.span, InvalidFunctionContract))
	substitution: Substitution = { owner = TraitDeclaration(trait_method_owner(required.id)), values = [receiver] }
	var parameters: List[TypeUse] = []
	var failure: Option[CheckError] = None
	for parameter in required.signature.parameters:
		match substitute_type(parameter.value_type, substitution, parameter.span):
			Ok(value_type): parameters = parameters.append({ parameter | value_type = value_type })
			Err(error): failure = Some(error)
	ready: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	result ?= substitute_type(required.signature.return_type.value_type, substitution, required.signature.return_type.span)
	expected: FunctionSignature = {
		type_parameters = function.signature.type_parameters,
		requirements = function.signature.requirements,
		purity = required.signature.purity,
		parameters = parameters,
		return_type = { required.signature.return_type | value_type = result }
	}
	parameter_types = parameters.map(pure func(parameter): parameter.value_type)
	actual_types = function.signature.parameters.map(pure func(parameter): parameter.value_type)
	valid = and(
		function.signature.type_parameters.length().equals(header.parameter_bounds.length()),
		and(
			same_purity(expected.purity, function.signature.purity),
			and(
				same_types(parameter_types, actual_types),
				same_type(result, function.signature.return_type.value_type),
			),
		),
	)
	if valid:
		Ok(void)
	else:
		Err(trait_error(function.declaration.function_name.span, ImplementationSignatureMismatch(required.id, expected, function.signature)))


-- The configured prelude selects this semantic identity through its ordinary
-- binding. Later shape checking and dispatch compare the accepted TraitId.
pure func designated_trait(parsed: ParsedContents, namespace: Namespace) -> Option[TraitId]:
	named_trait(namespace, parsed.foundation.prelude, foundation_words(parsed.names).equatable_word)


pure func accept_trait_contracts(
	parsed: ParsedContents,
	namespace: Namespace,
	boolean: DesignatedBoolean[VariantId],
	canonical: Option[TraitId],
) -> Result[AcceptedTraitContracts, CheckError]:
	var accepted_canonical: Option[CanonicalEquality] = None
	var declarations: List[AcceptedTrait] = []
	var failure: Option[CheckError] = None
	for row in inventory_traits(parsed.declarations):
		match accept_trait(row, parsed, namespace):
			Ok(accepted):
				declarations = declarations.append(accepted)
				designated: Bool = match canonical:
					Some(owner): trait_number(owner).equals(trait_number(row.id))
					None: False
				if designated:
					match accept_canonical(row, accepted, parsed, boolean):
						Ok(contract): accepted_canonical = Some(contract)
						Err(error):
							failure = Some(error)
							break
			Err(error):
				failure = Some(error)
				break
	match failure:
		Some(error): Err(error)
		None: Ok({ declarations = declarations, canonical = accepted_canonical })


-- Method contracts are already accepted. Authored implementation signatures
-- and default identities now complete this same authority without reacceptance.
pure func validate_implementations(
	parsed: ParsedContents,
	namespace: Namespace,
	headers: List[ImplementationHeader],
	functions: List[AcceptedFunction],
	contracts: AcceptedTraitContracts,
) -> Result[AcceptedTraits, CheckError]:
	canonical: Option[TraitId] = match contracts.canonical:
		Some(contract): Some(canonical_owner(contract))
		None: None
	var implementations: List[AcceptedImplementation] = []
	var failure: Option[CheckError] = None
	for row in inventory_implementations(parsed.declarations):
		match headers.get(impl_number(row.id)):
			Some(header):
				match accept_implementation(row, header, parsed, namespace, contracts.declarations, functions, implementations, canonical):
					Ok(accepted): implementations = implementations.append(accepted)
					Err(error): failure = Some(error)
			None: failure = Some(checker_invariant(row.header.span, InvalidFunctionContract))
		if failure.is_some():
			break
	match failure:
		Some(error): Err(error)
		None: Ok({ declarations = contracts.declarations, implementations = implementations, canonical = contracts.canonical })


-- Abstract signatures have no body owner. Check their formal names only after
-- all annotations resolve, without manufacturing local binding identities.
private pure func unique_requirement_parameters(method: TraitMethodId, header: FunctionHeader) -> Result[Void, CheckError]:
	var names: List[WrittenName] = []
	var failure: Option[CheckError] = None
	for parameter in header.parameters:
		match previous_declaration(names, parameter.name.id):
			Some(previous):
				failure = Some(trait_error(parameter.name.span, DuplicateRequirementParameter(method, previous)))
				break
			None: names = names.append(parameter.name)
	match failure:
		Some(error): Err(error)
		None: Ok(void)


-- A rigid parameter is justified only by its declaration. A family checks each
-- bound on a strict child of the actual receiver, so proof always terminates.
pure func prove_trait(availability: TraitAvailability, required: TraitId, receiver: TypeRef, assumptions: List[TraitRequirement], span: Span) -> Result[Void, CheckError]:
	match receiver:
		ParameterType(parameter):
			known = assumptions.any(pure func(assumption): and(same_parameter(assumption.parameter, parameter), trait_number(assumption.required_trait).equals(trait_number(required))))
			if known:
				Ok(void)
			else:
				Err(trait_error(span, MissingTraitBound(required, receiver)))
		_:
			prove_family(availability, required, receiver, assumptions, span)


private pure func prove_family(availability: TraitAvailability, required: TraitId, receiver: TypeRef, assumptions: List[TraitRequirement], span: Span) -> Result[Void, CheckError]:
	traits = accepted_traits(availability)
	head ?= type_head(receiver).to_result(trait_error(span, MissingTraitBound(required, receiver)))
	family = family_for(traits, required, head)
	selected: Result[AcceptedImplementation, CheckError] = match family:
		Some(implementation): Ok(implementation)
		None:
			rejection: CheckError = match equality_error(availability, required, receiver, span):
				Some(error): error
				None: trait_error(span, MissingTraitBound(required, receiver))
			Err(rejection)
	accepted ?= selected
	arguments = receiver_arguments(receiver)
	var position = 0
	var failure: Option[CheckError] = None
	for bounds in accepted.parameter_bounds:
		match arguments.get(position):
			None: failure = Some(checker_invariant(span, InvalidFunctionContract))
			Some(argument):
				for bound in bounds:
					match prove_trait(availability, bound.required_trait, argument, assumptions, span):
						Ok(_): void
						Err(error):
							failure = Some(error)
							break
		position = position.add(1)
		if failure.is_some():
			break
	match failure:
		Some(error): Err(error)
		None: Ok(void)


-- Source construction seals a callable's obligations. Invoking a stored or
-- forwarded callable later consumes that sealed callable type without reproving.
pure func prove_requirements(availability: TraitAvailability, signature: FunctionSignature, arguments: List[TypeRef], assumptions: List[TraitRequirement], span: Span) -> Result[Void, CheckError]:
	var failure: Option[CheckError] = None
	for required in signature.requirements:
		substitution: Substitution = { owner = parameter_owner(required.parameter), values = arguments }
		match substitute_type(ParameterType(required.parameter), substitution, span):
			Err(error): failure = Some(error)
			Ok(receiver):
				match prove_trait(availability, required.required_trait, receiver, assumptions, span):
					Ok(_): void
					Err(error): failure = Some(error)
		if failure.is_some():
			break
	match failure:
		Some(error): Err(error)
		None: Ok(void)


-- Negative causes are checker-local. Successful publication keeps only the
-- same accepted view; no partially supported body or proof cache escapes.
private fixed record EqualityUnavailable {
	aggregate: AggregateId,
	member: EqualityMember,
	required_trait: TraitId,
	receiver: TypeRef
}


private fixed union EqualityOutcome:
	SupportedEquality(AcceptedImplementation)
	UnsupportedEquality(EqualityUnavailable)


private fixed record AvailabilityContents {
	accepted: AcceptedTraits,
	unavailable: List[EqualityUnavailable]
}

opaque type TraitAvailability = AvailabilityContents


pure func accepted_traits(availability: TraitAvailability) -> AcceptedTraits:
	from_opaque TraitAvailability(availability).accepted


-- Signature-only test observers may deliberately have no derivation candidates.
pure func authored_traits(traits: AcceptedTraits) -> TraitAvailability:
	into_opaque TraitAvailability({ accepted = traits, unavailable = [] })


private pure func aggregate_head(aggregate: AggregateId) -> TypeHead:
	match aggregate:
		RecordAggregate(record_row): RecordHead(record_row)
		UnionAggregate(union_row): UnionHead(union_row)


pure func family_for(traits: AcceptedTraits, required: TraitId, head: TypeHead) -> Option[AcceptedImplementation]:
	var family: Option[AcceptedImplementation] = None
	for implementation in traits.implementations:
		if and(trait_number(implementation.trait_id).equals(trait_number(required)), same_head(implementation.receiver_head, head)):
			family = Some(implementation)
	family


-- Each candidate owns only its actual member requirements. Recursive goals
-- read the preceding round's summary, substituting real ordered arguments;
-- they never recursively reopen another declaration's fields.
private fixed record EqualityCandidate {
	aggregate: AggregateId,
	requirements: List[TraitRequirement]
}


private fixed record EqualitySummary {
	requirements: List[TraitRequirement],
	failure: Option[EqualityUnavailable]
}


private pure func summarize_goal(
	traits: AcceptedTraits,
	required: TraitId,
	receiver: TypeRef,
	possible: List[EqualityCandidate],
	owner: AggregateId,
	member: EqualityMember,
	summary: EqualitySummary,
	span: Span,
) -> Result[EqualitySummary, CheckError]:
	match receiver:
		ParameterType(parameter):
			if same_owner(parameter_owner(parameter), aggregate_owner(owner)):
				var requirements = summary.requirements
				var known: Bool = False
				var position = 0
				for bound in requirements:
					if and(same_parameter(bound.parameter, parameter), trait_number(bound.required_trait).equals(trait_number(required))):
						known = True
						-- Both spans are this aggregate's own member annotations.
						-- Preserve atom order; refine only its outer provenance.
						if span.start.less_than(bound.span.start):
							requirements = requirements.set(position, { bound | span = span })
						break
					position = position.add(1)
				if known:
					Ok({ summary | requirements = requirements })
				else:
					inferred: TraitRequirement = { parameter = parameter, required_trait = required, span = span }
					Ok({ summary | requirements = requirements.append(inferred) })
			else:
				Err(checker_invariant(span, InvalidFunctionContract))
		_:
			summarize_family(traits, required, receiver, possible, owner, member, summary, span)


private pure func summarize_family(
	traits: AcceptedTraits,
	required: TraitId,
	receiver: TypeRef,
	possible: List[EqualityCandidate],
	owner: AggregateId,
	member: EqualityMember,
	summary: EqualitySummary,
	span: Span,
) -> Result[EqualitySummary, CheckError]:
	var result = summary
	var invalid: Option[CheckError] = None
	match type_head(receiver):
		None: result = { result | failure = Some({ aggregate = owner, member = member, required_trait = required, receiver = receiver }) }
		Some(head):
			arguments = receiver_arguments(receiver)
			match family_for(traits, required, head):
				Some(family):
					var position = 0
					for bounds in family.parameter_bounds:
						match arguments.get(position):
							Some(argument):
								for bound in bounds:
									match summarize_goal(traits, bound.required_trait, argument, possible, owner, member, result, span):
										Ok(updated): result = updated
										Err(error): invalid = Some(error)
									if or(result.failure.is_some(), invalid.is_some()):
										break
							None: invalid = Some(checker_invariant(span, InvalidFunctionContract))
						if or(result.failure.is_some(), invalid.is_some()):
							break
						position = position.add(1)
				None:
					var provisional: Option[EqualityCandidate] = None
					canonical: Bool = match traits.canonical:
						Some(canonical): trait_number(canonical_owner(canonical)).equals(trait_number(required))
						None: False
					if canonical:
						for candidate in possible:
							if same_head(aggregate_head(candidate.aggregate), head):
								provisional = Some(candidate)
					match provisional:
						None: result = { result | failure = Some({ aggregate = owner, member = member, required_trait = required, receiver = receiver }) }
						Some(candidate):
							substitution: Substitution = { owner = aggregate_owner(candidate.aggregate), values = arguments }
							for bound in candidate.requirements:
								match substitute_type(ParameterType(bound.parameter), substitution, span):
									Err(error): invalid = Some(error)
									Ok(argument):
										match summarize_goal(traits, bound.required_trait, argument, possible, owner, member, result, span):
											Ok(updated): result = updated
											Err(error): invalid = Some(error)
								if or(result.failure.is_some(), invalid.is_some()):
									break
	match invalid:
		Some(error): Err(error)
		None: Ok(result)


private pure func summarize_members(
	traits: AcceptedTraits,
	required: TraitId,
	candidate: EqualityCandidate,
	records: List[CheckedRecord],
	unions: List[CheckedUnion],
	possible: List[EqualityCandidate],
) -> Result[EqualitySummary, CheckError]:
	-- Atom order is first-established and never oscillates through recursive
	-- summaries. The written member walk can refine an atom's earlier span.
	var summary: EqualitySummary = { requirements = candidate.requirements, failure = None }
	var invalid: Option[CheckError] = None
	match candidate.aggregate:
		RecordAggregate(record_row):
			match records.get(record_number(record_row)):
				Some(row):
					for field in row.fields:
						match summarize_goal(traits, required, field.value_type.value_type, possible, candidate.aggregate, EqualityField(field.id), summary, field.value_type.span):
							Ok(updated): summary = updated
							Err(error): invalid = Some(error)
						if or(summary.failure.is_some(), invalid.is_some()):
							break
				None: invalid = Some(checker_invariant(compiler_span(), InvalidFunctionContract))
		UnionAggregate(union_row):
			match unions.get(union_number(union_row)):
				Some(row):
					for variant in row.variants:
						var position = 0
						for field in variant.fields:
							match summarize_goal(traits, required, field.value_type, possible, candidate.aggregate, EqualityPayload(variant.id, position), summary, field.span):
								Ok(updated): summary = updated
								Err(error): invalid = Some(error)
							if or(summary.failure.is_some(), invalid.is_some()):
								break
							position = position.add(1)
						if or(summary.failure.is_some(), invalid.is_some()):
							break
				None: invalid = Some(checker_invariant(compiler_span(), InvalidFunctionContract))
	match invalid:
		Some(error): Err(error)
		None: Ok(summary)


pure func prepare_equality_availability(parsed: ParsedContents, traits: AcceptedTraits, records: List[CheckedRecord], unions: List[CheckedUnion], boolean: DesignatedBoolean[VariantId]) -> Result[TraitAvailability, CheckError]:
	match traits.canonical:
		None: Ok(authored_traits(traits))
		Some(canonical): complete_equality_availability(parsed, traits, records, unions, boolean, canonical_owner(canonical))


private pure func complete_equality_availability(parsed: ParsedContents, traits: AcceptedTraits, records: List[CheckedRecord], unions: List[CheckedUnion], boolean: DesignatedBoolean[VariantId], canonical: TraitId) -> Result[TraitAvailability, CheckError]:
	var possible: List[EqualityCandidate] = []
	for record_row in records:
		if family_for(traits, canonical, RecordHead(record_row.id)).is_none():
			possible = possible.append({ aggregate = RecordAggregate(record_row.id), requirements = [] })
	for union_row in unions:
		if family_for(traits, canonical, UnionHead(union_row.id)).is_none():
			possible = possible.append({ aggregate = UnionAggregate(union_row.id), requirements = [] })
	var unavailable: List[EqualityUnavailable] = []
	var invalid: Option[CheckError] = None
	var changed: Bool = True
	while and(changed, invalid.is_none()):
		changed = False
		var retained: List[EqualityCandidate] = []
		for candidate in possible:
			match summarize_members(traits, canonical, candidate, records, unions, possible):
				Ok(summary):
					match summary.failure:
						Some(failure):
							unavailable = unavailable.append(failure)
							changed = True
						None:
							if summary.requirements.length().equals(candidate.requirements.length()).not():
								changed = True
							retained = retained.append({ candidate | requirements = summary.requirements })
				Err(error): invalid = Some(error)
		possible = retained
	valid: Void ?= match invalid:
		Some(error): Err(error)
		None: Ok(void)
	contract ?= traits.declarations.get(trait_number(canonical)).to_result(checker_invariant(compiler_span(), InvalidFunctionContract))
	written_records = inventory_records(parsed.declarations)
	written_unions = inventory_unions(parsed.declarations)
	var outcomes: List[EqualityOutcome] = unavailable.map(pure func(failure) -> EqualityOutcome: UnsupportedEquality(failure))
	var error: Option[CheckError] = None
	for candidate in possible:
		match supported_implementation(written_records, written_unions, candidate, records, unions, contract, boolean, canonical):
			Ok(implementation): outcomes = outcomes.append(SupportedEquality(implementation))
			Err(failure): error = Some(failure)
	ready: Void ?= match error:
		Some(failure): Err(failure)
		None: Ok(void)
	-- Exactly one tagged result for each original candidate; partition once.
	var implementations = traits.implementations
	var rejected: List[EqualityUnavailable] = []
	for outcome in outcomes:
		match outcome:
			SupportedEquality(implementation): implementations = implementations.append(implementation)
			UnsupportedEquality(failure): rejected = rejected.append(failure)
	Ok(into_opaque TraitAvailability({ accepted = { traits | implementations = implementations }, unavailable = rejected }))


private pure func supported_implementation(
	written_records: List[RecordRow],
	written_unions: List[UnionRow],
	candidate: EqualityCandidate,
	records: List[CheckedRecord],
	unions: List[CheckedUnion],
	contract: AcceptedTrait,
	boolean: DesignatedBoolean[VariantId],
	canonical: TraitId,
) -> Result[AcceptedImplementation, CheckError]:
	aggregate = candidate.aggregate
	span ?= aggregate_span(written_records, written_unions, aggregate)
	declared_parameters: Option[List[TypeParameterId]] = match aggregate:
		RecordAggregate(record_row): records.get(record_number(record_row)).map(pure func(row): row.type_parameters)
		UnionAggregate(union_row): unions.get(union_number(union_row)).map(pure func(row): row.type_parameters)
	parameters ?= declared_parameters.to_result(checker_invariant(span, InvalidFunctionContract))
	var parameter_bounds: List[List[LocatedTrait]] = []
	for parameter in parameters:
		var bounds: List[LocatedTrait] = []
		for inferred_bound in candidate.requirements:
			if same_parameter(inferred_bound.parameter, parameter):
				bounds = bounds.append({ required_trait = inferred_bound.required_trait, span = inferred_bound.span })
		parameter_bounds = parameter_bounds.append(bounds)
	var methods: List[ImplementedMethod] = []
	var error: Option[CheckError] = None
	for method in contract.methods:
		match method.default_body:
			Some(function): methods = methods.append({ method = method.id, body = TraitDefault(function) })
			None:
				match equality_template(aggregate, parameters, candidate.requirements, records, unions, method, boolean, span):
					Ok(template): methods = methods.append({ method = method.id, body = StructuralEquality(aggregate, template) })
					Err(failure): error = Some(failure)
	ready: Void ?= match error:
		Some(failure): Err(failure)
		None: Ok(void)
	Ok({ trait_id = canonical, receiver_head = aggregate_head(aggregate), parameter_bounds = parameter_bounds, methods = methods, method_provider = None, span = span })


private pure func aggregate_span(written_records: List[RecordRow], written_unions: List[UnionRow], aggregate: AggregateId) -> Result[Span, CheckError]:
	match aggregate:
		RecordAggregate(record_row):
			match written_records.get(record_number(record_row)):
				Some(row): Ok(row.declaration.type_name.span)
				None: Err(checker_invariant(compiler_span(), InvalidFunctionContract))
		UnionAggregate(union_row):
			match written_unions.get(union_number(union_row)):
				Some(row): Ok(row.type_name.span)
				None: Err(checker_invariant(compiler_span(), InvalidFunctionContract))


private pure func compiler_span() -> Span:
	{ source = compiler_source(), start = 0, end = 0 }


-- Canonical identity is checked before following checker-local negative
-- causes. Each cause points into an earlier removal round; substitute its
-- aggregate-owned parameters under the actual receiver before following it.
pure func equality_error(availability: TraitAvailability, required: TraitId, receiver: TypeRef, span: Span) -> Option[CheckError]:
	contents = from_opaque TraitAvailability(availability)
	canonical: Bool = match contents.accepted.canonical:
		Some(owner): trait_number(canonical_owner(owner)).equals(trait_number(required))
		None: False
	var terminal: Option[EqualityUnavailable] = None
	var current = receiver
	var current_trait = required
	var searching = canonical
	var invalid: Option[CheckError] = None
	while searching:
		searching = False
		match type_head(current):
			None: void
			Some(head):
				if trait_number(current_trait).equals(trait_number(required)):
					for failure in contents.unavailable:
						if same_head(aggregate_head(failure.aggregate), head):
							substitution: Substitution = { owner = aggregate_owner(failure.aggregate), values = receiver_arguments(current) }
							match substitute_type(failure.receiver, substitution, span):
								Err(error): invalid = Some(error)
								Ok(actual):
									terminal = Some({ failure | receiver = actual })
									current = actual
									current_trait = failure.required_trait
									searching = True
							break
	match invalid:
		Some(error): Some(error)
		None:
			match terminal:
				None: None
				Some(failure): Some(trait_error(span, EqualityMemberUnsupported(failure.required_trait, failure.receiver, failure.member)))
