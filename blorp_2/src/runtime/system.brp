import:
	./fs: FS_ENTRY_KIND_RUNTIME, FS_READ_TEXT_RUNTIME, FS_WRITE_TEXT_RUNTIME
	./process: process_runtime
	../utils/syntax: SystemOperation(GetCurrentDirectory, ReadFile, WriteFile, RunToFiles, FsReadText, FsWriteText, FsEntryKind)


-- The failure helpers the system fragments share. A failure publishes one
-- fresh counted String into the error out-parameter, which its branch owns.
SYSTEM_FAILURE_RUNTIME: String =
	raw
		|enum {BLORP_SYSTEM_FAILED=0,BLORP_SYSTEM_SUCCEEDED=1};
		|static uint8_t blorp_system_failure(struct blorp_string **result,const char *message){
		|*result=blorp_string_from_bytes(message,(int64_t)strlen(message));
		|return BLORP_SYSTEM_FAILED;
		|}
		|/* The String is sized to the formatted text, so no prefix can overflow it. */
		|static uint8_t blorp_system_error(struct blorp_string **result,const char *prefix,int error){
		|const int length=snprintf(NULL,0,"%s%d",prefix,error);
		|if(length<0){abort();}
		|struct blorp_string *message=blorp_string_allocate(length);
		|(void)snprintf(message->bytes,(size_t)length+1,"%s%d",prefix,error);
		|*result=message;
		|return BLORP_SYSTEM_FAILED;
		|}
		|

-- Private native staging becomes exactly one owned String on either branch,
-- in the out-parameter of that branch.
SYSTEM_CURRENT_DIRECTORY_RUNTIME: String =
	raw
		|#include <errno.h>
		|#include <limits.h>
		|#include <unistd.h>
		|enum {BLORP_CURRENT_DIRECTORY_INITIAL_CAPACITY=256};
		|uint8_t blorp_get_current_directory(struct blorp_string **directory,struct blorp_string **error){
		|const size_t maximum_capacity=blorp_string_maximum_capacity()+1;
		|size_t capacity=BLORP_CURRENT_DIRECTORY_INITIAL_CAPACITY;
		|char *buffer=blorp_memory_allocate(capacity);
		|if(buffer==NULL){abort();}
		|for(;;){
		|errno=0;
		|if(getcwd(buffer,capacity)!=NULL){
		|const size_t length=strlen(buffer);
		|if(length==0||buffer[0]!='/'){
		|blorp_memory_release(buffer);
		|return blorp_system_failure(error,"get_current_directory: native path must be nonempty and absolute");
		|}
		|if(!blorp_utf8_is_valid(buffer,length)){
		|blorp_memory_release(buffer);
		|return blorp_system_failure(error,"get_current_directory: invalid UTF-8; use a working directory with a UTF-8 path");
		|}
		|*directory=blorp_string_from_bytes(buffer,(int64_t)length);
		|blorp_memory_release(buffer);
		|return BLORP_SYSTEM_SUCCEEDED;
		|}
		|const int saved_errno=errno;
		|if(saved_errno!=ERANGE){
		|blorp_memory_release(buffer);
		|return blorp_system_error(error,"get_current_directory: failed; errno=",saved_errno);
		|}
		|if(capacity==maximum_capacity){
		|blorp_memory_release(buffer);
		|return blorp_system_error(error,"get_current_directory: failed; errno=",EOVERFLOW);
		|}
		|const size_t grown_capacity=capacity>maximum_capacity/2?maximum_capacity:capacity*2;
		|char *grown=blorp_memory_resize(buffer,grown_capacity);
		|if(grown==NULL){abort();}
		|buffer=grown;
		|capacity=grown_capacity;
		|}
		|}
		|

-- One stable regular-file snapshot. Every normal return publishes one fresh
-- counted UTF-8 String; private native storage never escapes this boundary.
SYSTEM_READ_FILE_RUNTIME: String =
	raw
		|#include <errno.h>
		|#include <limits.h>
		|/* On supported LP64, positive ftell cannot reach the String size guard. */
		|_Static_assert(LONG_MAX==INT64_MAX&&(uintmax_t)LONG_MAX<(uintmax_t)(SIZE_MAX-sizeof(struct blorp_string)-1),"read_file requires supported LP64 bounds");
		|uint8_t blorp_read_file(const struct blorp_string *path,struct blorp_string **text,struct blorp_string **error){
		|/* Every String ends in a NUL, so once no NUL is embedded its bytes are the C path. */
		|if(memchr(path->bytes,'\0',(size_t)path->length)!=NULL){
		|return blorp_system_failure(error,"read_file: path contains embedded NUL; use a path without NUL");
		|}
		|FILE *stream=fopen(path->bytes,"rb");
		|const int open_errno=errno;
		|if(stream==NULL){return blorp_system_error(error,"read_file: open failed; errno=",open_errno);}
		|if(fseek(stream,0,SEEK_END)!=0){
		|const int saved_errno=errno;
		|(void)fclose(stream);
		|return blorp_system_error(error,"read_file: seek end failed; errno=",saved_errno);
		|}
		|const long measured_length=ftell(stream);
		|if(measured_length<0){
		|const int saved_errno=errno;
		|(void)fclose(stream);
		|return blorp_system_error(error,"read_file: tell failed; errno=",saved_errno);
		|}
		|if((uintmax_t)measured_length>(uintmax_t)blorp_string_maximum_capacity()){
		|(void)fclose(stream);
		|return blorp_system_error(error,"read_file: size failed; errno=",EOVERFLOW);
		|}
		|if(fseek(stream,0,SEEK_SET)!=0){
		|const int saved_errno=errno;
		|(void)fclose(stream);
		|return blorp_system_error(error,"read_file: seek start failed; errno=",saved_errno);
		|}
		|const size_t length=(size_t)measured_length;
		|char *contents=NULL;
		|if(length!=0){
		|contents=blorp_memory_allocate(length);
		|if(contents==NULL){abort();}
		|const size_t received=fread(contents,1,length,stream);
		|if(received!=length){
		|const int saved_errno=errno;
		|const int read_failed=ferror(stream);
		|(void)fclose(stream);
		|blorp_memory_release(contents);
		|if(read_failed){return blorp_system_error(error,"read_file: read failed; errno=",saved_errno);}
		|return blorp_system_failure(error,"read_file: short read");
		|}
		|}
		|if(fclose(stream)!=0){
		|const int saved_errno=errno;
		|blorp_memory_release(contents);
		|return blorp_system_error(error,"read_file: close failed; errno=",saved_errno);
		|}
		|if(length!=0&&!blorp_utf8_is_valid(contents,length)){
		|blorp_memory_release(contents);
		|return blorp_system_failure(error,"read_file: invalid UTF-8; save the file as UTF-8");
		|}
		|*text=blorp_string_from_bytes(length==0?"":contents,(int64_t)length);
		|blorp_memory_release(contents);
		|return BLORP_SYSTEM_SUCCEEDED;
		|}
		|


-- Both inputs remain borrowed. Only failure publishes a fresh owned String;
-- success has no child payload for the caller's ordinary Result[Void, String].
SYSTEM_WRITE_FILE_RUNTIME: String =
	raw
		|#include <errno.h>
		|#include <limits.h>
		|/* Valid String lengths fit size_t, so the length casts below are exact. */
		|_Static_assert(LONG_MAX==INT64_MAX&&(uintmax_t)INT64_MAX<(uintmax_t)(SIZE_MAX-sizeof(struct blorp_string)-1),"write_file requires supported LP64 bounds");
		|uint8_t blorp_write_file(const struct blorp_string *path,const struct blorp_string *contents,struct blorp_string **error){
		|*error=NULL;
		|/* Every String ends in a NUL, so once no NUL is embedded its bytes are the C path. */
		|if(memchr(path->bytes,'\0',(size_t)path->length)!=NULL){
		|return blorp_system_failure(error,"write_file: path contains embedded NUL; use a path without NUL");
		|}
		|FILE *stream=fopen(path->bytes,"wb");
		|const int open_errno=errno;
		|if(stream==NULL){return blorp_system_error(error,"write_file: open failed; errno=",open_errno);}
		|const size_t contents_length=(size_t)contents->length;
		|if(contents_length!=0){
		|const size_t written=fwrite(contents->bytes,1,contents_length,stream);
		|if(written!=contents_length){
		|const int write_errno=errno;
		|(void)fclose(stream);
		|return blorp_system_error(error,"write_file: short write; errno=",write_errno);
		|}
		|}
		|if(fclose(stream)!=0){
		|const int close_errno=errno;
		|return blorp_system_error(error,"write_file: close failed; errno=",close_errno);
		|}
		|return BLORP_SYSTEM_SUCCEEDED;
		|}
		|


-- The C symbol each system operation calls. Its fragment defines it with the
-- emitter's one shape: borrowed arguments, then one out-parameter per non-Void
-- Result payload, success first, returning whether the call succeeded.
pure func system_symbol(operation: SystemOperation) -> String:
	match operation:
		GetCurrentDirectory: "blorp_get_current_directory"
		ReadFile: "blorp_read_file"
		WriteFile: "blorp_write_file"
		RunToFiles: "blorp_process_run_to_files"
		FsReadText: "blorp_fs_read_text"
		FsWriteText: "blorp_fs_write_text"
		FsEntryKind: "blorp_fs_entry_kind"


-- `posix_declarations` requests POSIX.1-2008, with the XSI and Darwin
-- extensions, before any header;
-- `failure_helpers` needs SYSTEM_FAILURE_RUNTIME emitted before the fragment,
-- and `fs_helpers` needs FS_HELPERS_RUNTIME.
record SystemRuntime {
	fragment: String,
	posix_declarations: Bool,
	failure_helpers: Bool,
	fs_helpers: Bool
}


-- The emitter supplies the String-list C type from its existing typed key.
pure func system_runtime(operation: SystemOperation, string_list_type: String) -> SystemRuntime:
	match operation:
		GetCurrentDirectory: { fragment = SYSTEM_CURRENT_DIRECTORY_RUNTIME, posix_declarations = False, failure_helpers = True, fs_helpers = False }
		ReadFile: { fragment = SYSTEM_READ_FILE_RUNTIME, posix_declarations = False, failure_helpers = True, fs_helpers = False }
		WriteFile: { fragment = SYSTEM_WRITE_FILE_RUNTIME, posix_declarations = False, failure_helpers = True, fs_helpers = False }
		RunToFiles: { fragment = process_runtime(string_list_type), posix_declarations = True, failure_helpers = False, fs_helpers = False }
		FsReadText: { fragment = FS_READ_TEXT_RUNTIME, posix_declarations = True, failure_helpers = False, fs_helpers = True }
		FsWriteText: { fragment = FS_WRITE_TEXT_RUNTIME, posix_declarations = True, failure_helpers = False, fs_helpers = True }
		FsEntryKind: { fragment = FS_ENTRY_KIND_RUNTIME, posix_declarations = True, failure_helpers = False, fs_helpers = True }
