import:
	./fs:
		FS_ENTRY_KIND_RUNTIME, FS_READ_TEXT_RUNTIME, FS_WRITE_TEXT_RUNTIME, fs_list_directory_runtime, FS_CREATE_DIRECTORY_RUNTIME,
		FS_CREATE_DIRECTORIES_RUNTIME, FS_REMOVE_FILE_RUNTIME, FS_REMOVE_DIRECTORY_RUNTIME, FS_RENAME_RUNTIME,
	./process: process_runtime
	../utils/syntax:
		SystemOperation(
			GetCurrentDirectory, RunToFiles, FsReadText, FsWriteText, FsEntryKind,
			FsListDirectory, FsCreateDirectory, FsCreateDirectories, FsRemoveFile, FsRemoveDirectory, FsRename,
		),


-- The failure helpers the system fragments share. A failure publishes one
-- fresh counted String into the error out-parameter, which its branch owns.
SYSTEM_FAILURE_RUNTIME: String =
	raw
		|enum {BLORP_SYSTEM_FAILED=0,BLORP_SYSTEM_SUCCEEDED=1};
		|static uint8_t blorp_system_failure(struct blorp_string **result,const char *message){
		|*result=blorp_string_from_bytes(message,(int64_t)strlen(message));
		|return BLORP_SYSTEM_FAILED;
		|}
		|/* The String is sized to the formatted text, so no prefix can overflow it. */
		|static uint8_t blorp_system_error(struct blorp_string **result,const char *prefix,int error){
		|const int length=snprintf(NULL,0,"%s%d",prefix,error);
		|if(length<0){abort();}
		|struct blorp_string *message=blorp_string_allocate(length);
		|(void)snprintf(message->bytes,(size_t)length+1,"%s%d",prefix,error);
		|*result=message;
		|return BLORP_SYSTEM_FAILED;
		|}
		|

-- Private native staging becomes exactly one owned String on either branch,
-- in the out-parameter of that branch.
SYSTEM_CURRENT_DIRECTORY_RUNTIME: String =
	raw
		|#include <errno.h>
		|#include <limits.h>
		|#include <unistd.h>
		|enum {BLORP_CURRENT_DIRECTORY_INITIAL_CAPACITY=256};
		|uint8_t blorp_get_current_directory(struct blorp_string **directory,struct blorp_string **error){
		|const size_t maximum_capacity=blorp_string_maximum_capacity()+1;
		|size_t capacity=BLORP_CURRENT_DIRECTORY_INITIAL_CAPACITY;
		|char *buffer=blorp_memory_allocate(capacity);
		|if(buffer==NULL){abort();}
		|for(;;){
		|errno=0;
		|if(getcwd(buffer,capacity)!=NULL){
		|const size_t length=strlen(buffer);
		|if(length==0||buffer[0]!='/'){
		|blorp_memory_release(buffer);
		|return blorp_system_failure(error,"get_current_directory: native path must be nonempty and absolute");
		|}
		|if(!blorp_utf8_is_valid(buffer,length)){
		|blorp_memory_release(buffer);
		|return blorp_system_failure(error,"get_current_directory: invalid UTF-8; use a working directory with a UTF-8 path");
		|}
		|*directory=blorp_string_from_bytes(buffer,(int64_t)length);
		|blorp_memory_release(buffer);
		|return BLORP_SYSTEM_SUCCEEDED;
		|}
		|const int saved_errno=errno;
		|if(saved_errno!=ERANGE){
		|blorp_memory_release(buffer);
		|return blorp_system_error(error,"get_current_directory: failed; errno=",saved_errno);
		|}
		|if(capacity==maximum_capacity){
		|blorp_memory_release(buffer);
		|return blorp_system_error(error,"get_current_directory: failed; errno=",EOVERFLOW);
		|}
		|const size_t grown_capacity=capacity>maximum_capacity/2?maximum_capacity:capacity*2;
		|char *grown=blorp_memory_resize(buffer,grown_capacity);
		|if(grown==NULL){abort();}
		|buffer=grown;
		|capacity=grown_capacity;
		|}
		|}
		|


-- The C symbol each system operation calls. Its fragment defines it with the
-- emitter's one shape: borrowed arguments, then one out-parameter per non-Void
-- Result payload, success first, returning whether the call succeeded.
pure func system_symbol(operation: SystemOperation) -> String:
	match operation:
		GetCurrentDirectory: "blorp_get_current_directory"
		RunToFiles: "blorp_process_run_to_files"
		FsReadText: "blorp_fs_read_text"
		FsWriteText: "blorp_fs_write_text"
		FsEntryKind: "blorp_fs_entry_kind"
		FsListDirectory: "blorp_fs_list_directory"
		FsCreateDirectory: "blorp_fs_create_directory"
		FsCreateDirectories: "blorp_fs_create_directories"
		FsRemoveFile: "blorp_fs_remove_file"
		FsRemoveDirectory: "blorp_fs_remove_directory"
		FsRename: "blorp_fs_rename"


-- `posix_declarations` requests POSIX.1-2008, with the XSI and Darwin
-- extensions, before any header;
-- `failure_helpers` needs SYSTEM_FAILURE_RUNTIME emitted before the fragment,
-- and `fs_helpers` needs FS_HELPERS_RUNTIME.
record SystemRuntime {
	fragment: String,
	posix_declarations: Bool,
	failure_helpers: Bool,
	fs_helpers: Bool
}


-- The emitter supplies the String-list C type from its existing typed key.
pure func system_runtime(operation: SystemOperation, string_list_type: String) -> SystemRuntime:
	match operation:
		GetCurrentDirectory: { fragment = SYSTEM_CURRENT_DIRECTORY_RUNTIME, posix_declarations = False, failure_helpers = True, fs_helpers = False }
		RunToFiles: { fragment = process_runtime(string_list_type), posix_declarations = True, failure_helpers = False, fs_helpers = False }
		FsReadText: { fragment = FS_READ_TEXT_RUNTIME, posix_declarations = True, failure_helpers = False, fs_helpers = True }
		FsWriteText: { fragment = FS_WRITE_TEXT_RUNTIME, posix_declarations = True, failure_helpers = False, fs_helpers = True }
		FsEntryKind: { fragment = FS_ENTRY_KIND_RUNTIME, posix_declarations = True, failure_helpers = False, fs_helpers = True }
		FsListDirectory: { fragment = fs_list_directory_runtime(string_list_type), posix_declarations = True, failure_helpers = False, fs_helpers = True }
		FsCreateDirectory: { fragment = FS_CREATE_DIRECTORY_RUNTIME, posix_declarations = True, failure_helpers = False, fs_helpers = True }
		FsCreateDirectories: { fragment = FS_CREATE_DIRECTORIES_RUNTIME, posix_declarations = True, failure_helpers = False, fs_helpers = True }
		FsRemoveFile: { fragment = FS_REMOVE_FILE_RUNTIME, posix_declarations = True, failure_helpers = False, fs_helpers = True }
		FsRemoveDirectory: { fragment = FS_REMOVE_DIRECTORY_RUNTIME, posix_declarations = True, failure_helpers = False, fs_helpers = True }
		FsRename: { fragment = FS_RENAME_RUNTIME, posix_declarations = True, failure_helpers = False, fs_helpers = True }
