-- Standalone generated programs keep C's startup locale and default rounding.
-- No target operation mutates either. Arithmetic uses only this binary64 model.
pure func float_runtime() -> String:
	raw
		|#include <float.h>
		|#include <math.h>
		|#include <stdint.h>
		|#if defined(__FAST_MATH__)
		|#error "Blorp Float requires ordinary IEEE arithmetic without fast math"
		|#endif
		|_Static_assert(FLT_RADIX==2&&DBL_MANT_DIG==53&&DBL_MIN_EXP==(-1021)&&DBL_MAX_EXP==1024&&DBL_DECIMAL_DIG==17&&DBL_HAS_SUBNORM==1&&FLT_EVAL_METHOD==0&&sizeof(double)==sizeof(uint64_t),"Blorp Float requires binary64 with subnormals and evaluation in its declared type");
		|#pragma STDC FP_CONTRACT OFF
		|double blorp_float_add(double first,double second){return first+second;}
		|double blorp_float_subtract(double first,double second){return first-second;}
		|double blorp_float_multiply(double first,double second){return first*second;}
		|/* Zero divisors return positive zero by the pilot's arithmetic contract.
		|   This deliberately differs from the host Float library's IEEE division. */
		|double blorp_float_divide(double first,double second){return second==0.0?0.0:first/second;}
		|double blorp_float_remainder(double first,double second){return second==0.0?0.0:fmod(first,second);}
		|


-- Requires float_runtime and the ordinary String base. Fixed ASCII output fits
-- this buffer for every binary64; a failed snprintf is an unsupported libc.
pure func float_string_runtime() -> String:
	raw
		|enum {BLORP_FLOAT_TEXT_CAPACITY=64,BLORP_FLOAT_DEFAULT_PRECISION=6};
		|struct blorp_string *blorp_float_to_string(double value) {
		|if(isnan(value)){return blorp_string_from_bytes("nan",INT64_C(3));}
		|if(isinf(value)){return signbit(value)?blorp_string_from_bytes("-inf",INT64_C(4)):blorp_string_from_bytes("inf",INT64_C(3));}
		|char buffer[BLORP_FLOAT_TEXT_CAPACITY];
		|int length=0;
		|uint64_t original_bits=0;
		|memcpy(&original_bits,&value,sizeof original_bits);
		|for(int precision=BLORP_FLOAT_DEFAULT_PRECISION;precision<=DBL_DECIMAL_DIG;precision++){
		|length=snprintf(buffer,sizeof buffer,"%.*g",precision,value);
		|if(length<=0||(size_t)length>=sizeof buffer){abort();}
		|char *end=NULL;
		|double parsed=strtod(buffer,&end);
		|uint64_t parsed_bits=0;
		|memcpy(&parsed_bits,&parsed,sizeof parsed_bits);
		|if(end==buffer+length&&original_bits==parsed_bits){break;}
		|}
		|return blorp_string_from_bytes(buffer,(int64_t)length);
		|}
		|


-- Requires float_runtime and the String base. Grammar uses the complete byte
-- length before libc conversion; an embedded NUL cannot hide a suffix.
pure func float_parse_runtime() -> String:
	raw
		|static int blorp_float_decimal_digit(char byte){return byte>='0'&&byte<='9';}
		|int blorp_string_parse_float(const struct blorp_string *value,double *result) {
		|const char *bytes=value->bytes;
		|const int64_t length=value->length;
		|if(length==0){return 0;}
		|int64_t cursor=0;
		|if(bytes[cursor]=='+'||bytes[cursor]=='-'){cursor++;}
		|int64_t digits=cursor;
		|while(cursor<length&&blorp_float_decimal_digit(bytes[cursor])){cursor++;}
		|if(cursor==digits){return 0;}
		|if(cursor<length&&bytes[cursor]=='.'){
		|cursor++;
		|digits=cursor;
		|while(cursor<length&&blorp_float_decimal_digit(bytes[cursor])){cursor++;}
		|if(cursor==digits){return 0;}
		|}
		|if(cursor<length&&(bytes[cursor]=='e'||bytes[cursor]=='E')){
		|cursor++;
		|if(cursor<length&&(bytes[cursor]=='+'||bytes[cursor]=='-')){cursor++;}
		|digits=cursor;
		|while(cursor<length&&blorp_float_decimal_digit(bytes[cursor])){cursor++;}
		|if(cursor==digits){return 0;}
		|}
		|if(cursor!=length){return 0;}
		|char *end=NULL;
		|double parsed=strtod(bytes,&end);
		|if(end!=bytes+length||!isfinite(parsed)){return 0;}
		|*result=parsed;
		|return 1;
		|}
		|
