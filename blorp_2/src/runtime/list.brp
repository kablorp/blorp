import:
	../utils/boolean: and
	int as IntOps
	../specialize/specialize:
		RecordInstanceId,
		TypeRef(VoidType, IntType, FloatType, StringType, ListType, CallableType, RecordType, UnionType),
		same_type,
		UnionInstanceId,
		record_number,
		union_number,
	../utils/text: concat


private fixed union ElementTerminal:
	VoidElement
	IntElement
	FloatElement
	StringElement
	RecordElement(RecordInstanceId)
	UnionElement(UnionInstanceId)
	CallableElement(List[TypeRef], TypeRef)


private fixed record ElementKey {
	depth: Int,
	terminal: ElementTerminal
}


-- A disposable emission key, never a type or layout authority. Its factory
-- retains full nominal instance identity and counts only outer List layers.
opaque type ListElementKey = ElementKey


private pure func terminal_key(terminal: ElementTerminal, depth: Int) -> ListElementKey:
	into_opaque ListElementKey({ depth = depth, terminal = terminal })


private pure func element_key_at_depth(element: TypeRef, depth: Int) -> ListElementKey:
	match element:
		ListType(child): element_key_at_depth(child, IntOps.add(depth, 1))
		VoidType: terminal_key(VoidElement, depth)
		IntType: terminal_key(IntElement, depth)
		FloatType: terminal_key(FloatElement, depth)
		StringType: terminal_key(StringElement, depth)
		RecordType(id): terminal_key(RecordElement(id), depth)
		UnionType(id): terminal_key(UnionElement(id), depth)
		CallableType(parameters, result): terminal_key(CallableElement(parameters, result), depth)


pure func list_element_key(element: TypeRef) -> ListElementKey:
	element_key_at_depth(element, 0)


pure func list_key_depth(key: ListElementKey) -> Int:
	from_opaque ListElementKey(key).depth


-- Consumers peel exactly the depth produced by the factory. A terminal key
-- is unchanged; this total projection does not invent an element or layout.
pure func list_child_key(key: ListElementKey) -> ListElementKey:
	contents = from_opaque ListElementKey(key)
	if IntOps.greater_than(contents.depth, 0):
		into_opaque ListElementKey({ contents | depth = IntOps.subtract(contents.depth, 1) })
	else:
		key


private VOID_RANK: Int = 0
private INT_RANK: Int = 1
private FLOAT_RANK: Int = 2
private STRING_RANK: Int = 3
private RECORD_RANK: Int = 4
private UNION_RANK: Int = 5
private CALLABLE_RANK: Int = 6
private NO_NOMINAL_ORDINAL: Int = 0


pure func list_key_rank(key: ListElementKey) -> Int:
	match from_opaque ListElementKey(key).terminal:
		VoidElement: VOID_RANK
		IntElement: INT_RANK
		FloatElement: FLOAT_RANK
		StringElement: STRING_RANK
		RecordElement(_): RECORD_RANK
		UnionElement(_): UNION_RANK
		CallableElement(_, _): CALLABLE_RANK


pure func list_key_is_callable(key: ListElementKey) -> Bool:
	match from_opaque ListElementKey(key).terminal:
		CallableElement(_, _): True
		_: False


pure func list_key_ordinal(key: ListElementKey) -> Int:
	match from_opaque ListElementKey(key).terminal:
		RecordElement(id): record_number(id)
		UnionElement(id): union_number(id)
		VoidElement | IntElement | FloatElement | StringElement | CallableElement(_, _): NO_NOMINAL_ORDINAL


pure func same_list_key(left: ListElementKey, right: ListElementKey) -> Bool:
	ordinals: Bool = match from_opaque ListElementKey(left).terminal:
		CallableElement(parameters, result):
			match from_opaque ListElementKey(right).terminal:
				CallableElement(others, other): same_type(CallableType(parameters, result), CallableType(others, other))
				_: False
		_: IntOps.equals(list_key_ordinal(left), list_key_ordinal(right))
	and(
		and(
			IntOps.equals(list_key_depth(left), list_key_depth(right)),
			IntOps.equals(list_key_rank(left), list_key_rank(right)),
		),
		ordinals,
	)


pure func list_suffix(key: ListElementKey) -> String:
	terminal = match from_opaque ListElementKey(key).terminal:
		VoidElement: "v"
		IntElement: "i"
		FloatElement: "f"
		StringElement: "s"
		RecordElement(id): "r".append_int(record_number(id))
		UnionElement(id): "u".append_int(union_number(id))
		CallableElement(parameters, result): "c".concat(callable_suffix(parameters, result))
	"".append_int(list_key_depth(key)).concat("_").concat(terminal)


-- Serialization happens after typed equality; delimiters retain every kind,
-- arity, nesting boundary and nominal instance ordinal without a hash identity.
private pure func type_suffix(value: TypeRef) -> String:
	match value:
		VoidType: "v"
		IntType: "i"
		FloatType: "f"
		StringType: "s"
		ListType(element): "l".concat(type_suffix(element)).concat("e")
		RecordType(id): "r".append_int(record_number(id)).concat("e")
		UnionType(id): "u".append_int(union_number(id)).concat("e")
		CallableType(parameters, result): "c".concat(callable_suffix(parameters, result))


pure func callable_suffix(parameters: List[TypeRef], result: TypeRef) -> String:
	var suffix = "p".append_int(parameters.length()).concat("_")
	for parameter in parameters:
		suffix = suffix.concat(type_suffix(parameter)).concat("_")
	suffix.concat("r_").concat(type_suffix(result)).concat("_e")


pure func list_c_type(key: ListElementKey) -> String:
	"struct blorp_l_".concat(list_suffix(key)).concat("*")


-- A fresh root named `name` with `count` slots, published empty; callers
-- initialize each slot through list_slot_store so length never exceeds
-- initialized storage. Helpers and inline literal construction share it.
pure func list_root_allocation(declaration: String, name: String, count: String) -> String:
	declaration.concat(" ").concat(name).concat("=blorp_memory_allocate(sizeof *").concat(name)
		.concat("+(size_t)").concat(count).concat("*sizeof *").concat(name)
		.concat("->values);if(!").concat(name).concat(")abort();")
		.concat("atomic_init(&").concat(name).concat("->references,1);").concat(name).concat("->length=0;")


private pure func allocate_root(type_name: String, count: String) -> String:
	list_root_allocation(type_name, "result", count)


-- Stores one occurrence the caller already owns into `name`'s next slot.
pure func list_slot_store(name: String, slot: String, value: String) -> String:
	name.concat("->values[").concat(slot).concat("]=").concat(value).concat(";").concat(name).concat("->length++;")


-- `acquire` refers to the C local `element`; the slot owns that occurrence.
private pure func store_occurrence(acquire: String, slot: String) -> String:
	acquire.concat(list_slot_store("result", slot, "element"))


-- The supplied element ABI and dup/drop fragments come from accepted concrete
-- layouts. A root owns every initialized slot, including equal occurrences.
pure func list_runtime(
	key: ListElementKey,
	element_type: String,
	acquire: String,
	destroy: String,
) -> String:
	suffix = list_suffix(key)
	type_name = list_c_type(key)
	"struct blorp_l_".concat(suffix).concat("{atomic_size_t references;int64_t length;")
		.concat(element_type).concat(" values[];};void blorp_list_dup_").concat(suffix)
		.concat("(").concat(type_name).concat(" value){atomic_fetch_add_explicit(&value->references,1,memory_order_relaxed);}")
		.concat("void blorp_list_drop_").concat(suffix).concat("(").concat(type_name)
		.concat(" value){if(atomic_fetch_sub_explicit(&value->references,1,memory_order_acq_rel)!=1)return;")
		.concat("for(int64_t index=0;index<value->length;index++){").concat(element_type)
		.concat(" element=value->values[index];(void)element;").concat(destroy).concat("}blorp_memory_release(value);}")
		.concat(type_name).concat(" blorp_list_repeat_").concat(suffix).concat("(")
		.concat(element_type).concat(" element,int64_t count){const uint64_t requested=count<=0?UINT64_C(0):(uint64_t)count;")
		.concat("if(requested>(SIZE_MAX-sizeof(struct blorp_l_").concat(suffix)
		.concat("))/sizeof(").concat(element_type).concat("))abort();")
		.concat(allocate_root(type_name, "requested"))
		.concat("for(uint64_t index=0;index<requested;index++){").concat(store_occurrence(acquire, "index"))
		.concat("}return result;}")
		.concat("int64_t blorp_list_length_").concat(suffix).concat("(const struct blorp_l_")
		.concat(suffix).concat(" *value){return value->length;}")
		.concat("int blorp_list_get_").concat(suffix).concat("(const struct blorp_l_")
		.concat(suffix).concat(" *value,int64_t index,").concat(element_type)
		.concat(" *result){if(index<0||index>=value->length)return 0;").concat(element_type)
		.concat(" element=value->values[index];").concat(acquire).concat("*result=element;return 1;}")


fixed union ListUpdate:
	AppendUpdate
	SetUpdate
	ConcatUpdate
	SuffixUpdate


pure func list_update_name(update: ListUpdate, key: ListElementKey) -> String:
	prefix = match update:
		AppendUpdate: "blorp_list_append_"
		SetUpdate: "blorp_list_set_"
		ConcatUpdate: "blorp_list_concat_"
		SuffixUpdate: "blorp_list_suffix_"
	prefix.concat(list_suffix(key))


-- Updates borrow their inputs and build one fresh root: unmanaged slots are
-- copied and every stored occurrence, surviving or replacement, is acquired.
-- Old roots keep every alias. `set` outside the range copies unchanged and
-- reuses an allocation size that already succeeded; `append` and `concat`
-- check that `length` stays within int64_t and the allocation within size_t.
pure func list_update_runtime(
	update: ListUpdate,
	key: ListElementKey,
	element_type: String,
	acquire: String,
) -> String:
	suffix = list_suffix(key)
	type_name = list_c_type(key)
	name = list_update_name(update, key)
	borrowed = "const struct blorp_l_".concat(suffix).concat(" *")
	capacity = "(SIZE_MAX-sizeof(struct blorp_l_".concat(suffix).concat("))/sizeof(").concat(element_type).concat(")")
	match update:
		AppendUpdate:
			type_name.concat(" ").concat(name).concat("(").concat(borrowed).concat("values,")
				.concat(element_type).concat(" value){const uint64_t count=(uint64_t)values->length;")
				.concat("if(count>=(uint64_t)INT64_MAX||count>=").concat(capacity).concat(")abort();")
				.concat(allocate_root(type_name, "(count+1)"))
				.concat("for(uint64_t index=0;index<count;index++){").concat(element_type)
				.concat(" element=values->values[index];").concat(store_occurrence(acquire, "index")).concat("}")
				.concat(element_type).concat(" element=value;").concat(store_occurrence(acquire, "count"))
				.concat("return result;}")
		SetUpdate:
			type_name.concat(" ").concat(name).concat("(").concat(borrowed).concat("values,int64_t index,")
				.concat(element_type).concat(" value){const uint64_t count=(uint64_t)values->length;")
				.concat(allocate_root(type_name, "count"))
				.concat("for(uint64_t slot=0;slot<count;slot++){").concat(element_type)
				.concat(" element=(index>=0&&(uint64_t)index==slot)?value:values->values[slot];")
				.concat(store_occurrence(acquire, "slot")).concat("}return result;}")
		SuffixUpdate:
			-- Selection verification proves 0 <= start <= length. The new
			-- root is no larger than its source, whose allocation succeeded.
			type_name.concat(" ").concat(name).concat("(").concat(borrowed).concat("values,int64_t start){")
				.concat("const uint64_t count=(uint64_t)(values->length-start);")
				.concat(allocate_root(type_name, "count"))
				.concat("for(uint64_t index=0;index<count;index++){").concat(element_type)
				.concat(" element=values->values[(uint64_t)start+index];").concat(store_occurrence(acquire, "index"))
				.concat("}return result;}")
		ConcatUpdate:
			type_name.concat(" ").concat(name).concat("(").concat(borrowed).concat("left,").concat(borrowed)
				.concat("right){const uint64_t first=(uint64_t)left->length;const uint64_t second=(uint64_t)right->length;")
				.concat("if(second>(uint64_t)INT64_MAX-first||first+second>").concat(capacity).concat(")abort();")
				.concat(allocate_root(type_name, "(first+second)"))
				.concat("for(uint64_t index=0;index<first;index++){").concat(element_type)
				.concat(" element=left->values[index];").concat(store_occurrence(acquire, "index")).concat("}")
				.concat("for(uint64_t index=0;index<second;index++){").concat(element_type)
				.concat(" element=right->values[index];").concat(store_occurrence(acquire, "first+index")).concat("}")
				.concat("return result;}")


-- argv uses the same concrete String list root and destruction as source Lists.
pure func arguments_runtime() -> String:
	raw
		|struct blorp_l_0_s *blorp_list_from_argv(int argc,char **argv){
		|if(argc<0){abort();}
		|const size_t count=(size_t)argc;
		|if(count>(SIZE_MAX-sizeof(struct blorp_l_0_s))/sizeof(struct blorp_string *)){abort();}
		|struct blorp_l_0_s *result=blorp_memory_allocate(sizeof *result+count*sizeof *result->values);
		|if(result==NULL){abort();}
		|atomic_init(&result->references,1);result->length=0;
		|for(size_t index=0;index<count;index++){
		|const size_t length=strlen(argv[index]);
		|if(length>(size_t)INT64_MAX||length>SIZE_MAX-sizeof(struct blorp_string)-1){abort();}
		|if(!blorp_utf8_is_valid(argv[index],length)){
		|blorp_list_drop_0_s(result);
		|return NULL;
		|}
		|result->values[index]=blorp_string_from_bytes(argv[index],(int64_t)length);
		|result->length++;
		|}
		|return result;
		|}
		|
