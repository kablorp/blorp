import:
	check_model: BindingId, BindingOrigin(ParameterBinding, BodyLocal, MatchCapture), binding_number
	int as IntOps
	list: set
	option: to_result
	specialize:
		ConcreteArm,
		ConcreteBase(
			ReturnVoid, ReturnInteger, ReturnFloat, ReturnString, ReturnVariant, ReturnConstructedVariant, ReturnBinding, ReturnCall,
			ReturnRecord, ReturnRecordUpdate,
		),
		ConcreteBinding,
		ConcreteBody(ConcreteValueBody, ConcreteMatchBody),
		ConcreteCall,
		ConcreteExit(ReturnExpression, RecurWith),
		ConcreteFunction,
		ConcreteMatch,
		ConcreteOperation(InvokeFunction, ReadRecordField),
		ConcretePattern(VariantCase, WildcardCase, BindingCase),
		ConcreteRecord,
		ConcreteRecordField,
		ConcreteRecordUpdate,
		ConcreteStatement(InitializeBinding, ReassignBinding, DiscardExpression),
		ConcreteUnion, VariantFieldInstanceId, variant_field,
		ConcreteValue,
		FieldInstanceId,
		FunctionInstanceId,
		FunctionSignature,
		RecordInstanceId,
		field_number,
		SpecializedProgram,
		TypeRef(IntType, RecordType),
		UnionInstanceId,
		VariantInstanceId,
		specialized_contents,
	syntax: Diagnostic, Entrypoint, FunctionExecution, Span


-- A value identity belongs to one lowered function, including its branches.
opaque type ValueId = Int


pure func value_number(id: ValueId) -> Int:
	from_opaque ValueId(id)


fixed record RecordFieldValue {
	field: FieldInstanceId,
	value: ValueId
}


fixed union ValueOperation:
	ConstructRecordValue(RecordInstanceId, List[RecordFieldValue])
	ReadRecordFieldValue(FieldInstanceId, ValueId)
	ParameterValue(Int)
	VoidValue
	IntegerValue(Int)
	FloatValue(Float)
	StringValue(String)
	VariantValue(VariantInstanceId)
	CallValue(ConcreteCall, List[ValueId])
	ConstructValue(VariantInstanceId, List[ValueId])
	-- Selected member identity is retained for verification and C projection.
	PayloadValue(VariantFieldInstanceId, ValueId)


fixed record ValueDefinition {
	id: ValueId,
	value_type: TypeRef,
	operation: ValueOperation,
	span: Span
}


fixed record ValueBlock {
	definitions: List[ValueDefinition],
	exit: LoweredExit
}


fixed union MatchLabel:
	VariantLabel(VariantInstanceId)
	DefaultLabel


fixed record LoweredArm {
	label: MatchLabel,
	body: ValueBlock
}


fixed record LoweredMatch {
	scrutinee: ValueId,
	owner: UnionInstanceId,
	arms: List[LoweredArm]
}


fixed union LoweredExit:
	ReturnValue(ValueId)
	RecurValues(List[ValueId], Span)


fixed union LoweredTail:
	ExitValue(LoweredExit)
	MatchValue(LoweredMatch)


fixed record LoweredFunction {
	execution: FunctionExecution,
	signature: FunctionSignature,
	definitions: List[ValueDefinition],
	tail: LoweredTail
}


fixed record LoweredFunctions {
	records: List[ConcreteRecord],
	unions: List[ConcreteUnion],
	functions: List[LoweredFunction],
	entrypoint: Entrypoint[FunctionInstanceId]
}


-- Only lowering can publish ordered definitions with resolved value uses.
opaque type LoweredProgram = LoweredFunctions


pure func lowered_functions(program: LoweredProgram) -> LoweredFunctions:
	from_opaque LoweredProgram(program)


-- This builder is confined to one expression; read-only bindings are separate.
-- Its inherited traversal still shares a growing vector, without a block prefix.
private fixed record ExpressionBuilder {
	next_value: Int,
	definitions: List[ValueDefinition]
}


private fixed record BuiltValue {
	builder: ExpressionBuilder,
	value: ValueId
}


private pure func invalid_binding(span: Span) -> Diagnostic:
	{
		span = span,
		note = None,
		message = "internal compiler error: invalid checked binding identity",
		help = "report this compiler error with the input program"
	}


private pure func define_value(
	builder: ExpressionBuilder,
	operation: ValueOperation,
	value_type: TypeRef,
	span: Span,
) -> BuiltValue:
	id = into_opaque ValueId(builder.next_value)
	{
		builder = { builder |
			next_value = IntOps.add(builder.next_value, 1),
			definitions = builder.definitions.append({
				id = id,
				operation = operation,
				value_type = value_type,
				span = span,
			})
		},
		value = id
	}


private pure func read_binding(
	bindings: List[Option[ValueId]],
	id: BindingId,
	span: Span,
) -> Result[ValueId, Diagnostic]:
	entry ?= bindings
		.get(binding_number(id))
		.to_result(invalid_binding(span))
	entry.to_result(invalid_binding(span))


private fixed record BuiltArguments {
	builder: ExpressionBuilder,
	values: List[ValueId]
}


private pure func lower_arguments(
	builder: ExpressionBuilder,
	bindings: List[Option[ValueId]],
	arguments: List[ConcreteValue],
	prefix: List[ValueId],
) -> Result[BuiltArguments, Diagnostic]:
	var current = builder
	var values = prefix
	var failure: Option[Diagnostic] = None

	for argument in arguments:
		match lower_value(current, bindings, argument):
			Err(error):
				failure = Some(error)
				break
			Ok(built):
				current = built.builder
				values = values.append(built.value)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({
				builder = current,
				values = values,
			})


private pure func lower_record(
	builder: ExpressionBuilder,
	bindings: List[Option[ValueId]],
	fields: List[ConcreteRecordField],
	owner: RecordInstanceId,
	value_type: TypeRef,
	span: Span,
) -> Result[BuiltValue, Diagnostic]:
	var current = builder
	var values: List[RecordFieldValue] = []
	var failure: Option[Diagnostic] = None

	for field in fields:
		match lower_value(current, bindings, field.value):
			Err(error):
				failure = Some(error)
				break
			Ok(child):
				current = child.builder
				values = values.append({
					field = field.field,
					value = child.value,
				})

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(define_value(current, ConstructRecordValue(owner, values), value_type, span))


private pure func invalid_update(span: Span) -> Diagnostic:
	{ span = span, note = None, message = "internal compiler error: incomplete record update field plan", help = "report this compiler error with the input program" }


private pure func lower_record_update(
	builder: ExpressionBuilder,
	bindings: List[Option[ValueId]],
	update: ConcreteRecordUpdate,
	owner: RecordInstanceId,
	value_type: TypeRef,
	span: Span,
) -> Result[BuiltValue, Diagnostic]:
	base ?= lower_value(builder, bindings, update.base)
	var current = base.builder
	var slots: List[Option[RecordFieldValue]] = []
	for _ in 0..IntOps.add(update.replacements.length(), update.inherited.length()):
		slots = slots.append(None)
	var failure: Option[Diagnostic] = None
	for field in update.replacements:
		match lower_value(current, bindings, field.value):
			Err(error):
				failure = Some(error)
				break
			Ok(child):
				current = child.builder
				slots = slots.set(field_number(field.field), Some({ field = field.field, value = child.value }))
	ready ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	var fields: List[RecordFieldValue] = []
	var inherited_position = 0
	-- Replacement slots are complete. Inherited rows already have declaration
	-- order, so project and append them without another ordinal-table write.
	for slot in slots:
		match slot:
			Some(field): fields = fields.append(field)
			None:
				match update.inherited.get(inherited_position):
					None:
						failure = Some(invalid_update(span))
						break
					Some(field):
						child = define_value(current, ReadRecordFieldValue(field.field, base.value), field.value_type, update.base_expression_span)
						current = child.builder
						fields = fields.append({ field = field.field, value = child.value })
						inherited_position = IntOps.add(inherited_position, 1)
	complete ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	Ok(define_value(current, ConstructRecordValue(owner, fields), value_type, span))


private pure func lower_value(
	builder: ExpressionBuilder,
	bindings: List[Option[ValueId]],
	value: ConcreteValue,
) -> Result[BuiltValue, Diagnostic]:
	base ?= match value.base:
		ReturnRecordUpdate(update):
			match value.base_type:
				RecordType(owner): lower_record_update(builder, bindings, update, owner, value.base_type, value.base_span)
				_: Err(invalid_update(value.base_span))
		ReturnConstructedVariant(variant, values):
			lower_arguments(builder, bindings, values, []).map(pure func(children): define_value(children.builder, ConstructValue(variant, children.values), value.base_type, value.base_span))
		ReturnRecord(owner, fields):
			lower_record(builder, bindings, fields, owner, value.base_type, value.base_span)
		ReturnBinding(id):
			read_binding(
				bindings,
				id,
				value.base_span,
			).map(
				pure func(id: ValueId) -> BuiltValue: {
					builder = builder,
					value = id
				},
			)
		ReturnVoid:
			Ok(define_value(builder, VoidValue, value.base_type, value.base_span))
		ReturnString(bytes):
			Ok(define_value(builder, StringValue(bytes), value.base_type, value.base_span))
		ReturnInteger(integer):
			Ok(define_value(builder, IntegerValue(integer), value.base_type, value.base_span))
		ReturnFloat(number):
			Ok(define_value(builder, FloatValue(number), value.base_type, value.base_span))
		ReturnVariant(id):
			Ok(define_value(builder, VariantValue(id), value.base_type, value.base_span))
		ReturnCall(call, arguments):
			lower_arguments(
				builder,
				bindings,
				arguments,
				[],
			).map(
				pure func(children: BuiltArguments) -> BuiltValue: define_value(
					children.builder,
					CallValue(call, children.values),
					value.base_type,
					value.base_span,
				),
			)

	var built = base
	var failure: Option[Diagnostic] = None

	for step in value.operations:
		match step.operation:
			InvokeFunction(call, arguments):
				match lower_arguments(built.builder, bindings, arguments, [built.value]):
					Err(error):
						failure = Some(error)
						break
					Ok(children):
						built = define_value(
							children.builder,
							CallValue(call, children.values),
							step.value_type,
							step.span,
						)
			ReadRecordField(field):
				built = define_value(
					built.builder,
					ReadRecordFieldValue(field, built.value),
					step.value_type,
					step.span,
				)


	match failure:
		Some(error):
			Err(error)
		None:
			Ok(built)


private fixed record BuiltBlock {
	next_value: Int,
	definitions: List[ValueDefinition],
	bindings: List[Option[ValueId]]
}


private fixed record BuiltExit {
	next_value: Int,
	definitions: List[ValueDefinition],
	exit: LoweredExit
}


private fixed record BuiltMatch {
	definitions: List[ValueDefinition],
	matched: LoweredMatch
}


private fixed record BuiltTail {
	definitions: List[ValueDefinition],
	tail: LoweredTail
}


private fixed record BuiltArm {
	arm: LoweredArm,
	next_value: Int
}


private pure func binding_slot(bindings: List[Option[ValueId]], id: BindingId, span: Span) -> Result[Int, Diagnostic]:
	position = binding_number(id)
	match bindings.get(position):
		Some(_): Ok(position)
		None: Err(invalid_binding(span))


private pure func exit_span(exit: ConcreteExit) -> Span:
	match exit:
		ReturnExpression(value):
			value.base_span
		RecurWith(_, span):
			span


private pure func lower_exit(
	next_value: Int,
	bindings: List[Option[ValueId]],
	exit: ConcreteExit,
) -> Result[BuiltExit, Diagnostic]:
	match exit:
		ReturnExpression(value):
			result ?= lower_value({ next_value = next_value, definitions = [] }, bindings, value)
			Ok({
				next_value = result.builder.next_value,
				definitions = result.builder.definitions,
				exit = ReturnValue(result.value),
			})
		RecurWith(arguments, span):
			var cursor = next_value
			var definitions: List[ValueDefinition] = []
			var values: List[ValueId] = []
			var failure: Option[Diagnostic] = None
			for argument in arguments:
				match lower_value({ next_value = cursor, definitions = [] }, bindings, argument):
					Err(error):
						failure = Some(error)
						break
					Ok(result):
						for definition in result.builder.definitions:
							definitions = definitions.append(definition)
						values = values.append(result.value)
						cursor = result.builder.next_value
			match failure:
				Some(error): Err(error)
				None: Ok({
					next_value = cursor,
					definitions = definitions,
					exit = RecurValues(values, span),
				})


private pure func lower_statements(
	next_value: Int,
	bindings: List[Option[ValueId]],
	statements: List[ConcreteStatement],
) -> Result[BuiltBlock, Diagnostic]:
	var cursor = next_value
	var values = bindings
	var definitions: List[ValueDefinition] = []
	var failure: Option[Diagnostic] = None
	for statement in statements:
		value = match statement:
			InitializeBinding(_, value): value
			ReassignBinding(_, value): value
			DiscardExpression(value): value
		match lower_value({ next_value = cursor, definitions = [] }, values, value):
			Err(error):
				failure = Some(error)
				break
			Ok(result):
				for definition in result.builder.definitions:
					definitions = definitions.append(definition)
				cursor = result.builder.next_value
				assigned = match statement:
					InitializeBinding(id, _): Some(id)
					ReassignBinding(id, _): Some(id)
					DiscardExpression(_): None
				match assigned:
					None:
						void
					Some(id):
						match binding_slot(values, id, value.base_span):
							Ok(position): values = values.set(position, Some(result.value))
							Err(error):
								failure = Some(error)
								break
	match failure:
		Some(error): Err(error)
		None: Ok({
			next_value = cursor,
			definitions = definitions,
			bindings = values,
		})


private pure func lower_arm(
	initial_value: Int,
	outer: List[Option[ValueId]],
	arm: ConcreteArm,
	scrutinee: ValueId,
	bindings: List[ConcreteBinding],
	unions: List[ConcreteUnion],
) -> Result[BuiltArm, Diagnostic]:
	var next_value = initial_value
	var values = outer
	var definitions: List[ValueDefinition] = []
	var failure: Option[Diagnostic] = None
	label = match arm.pattern:
		VariantCase(id, _): VariantLabel(id)
		_: DefaultLabel
	match arm.pattern:
		BindingCase(id):
			match binding_slot(values, id, exit_span(arm.body)):
				Ok(position): values = values.set(position, Some(scrutinee))
				Err(error): failure = Some(error)
		VariantCase(variant, captures):
			var position = 0
			for capture in captures:
				match capture:
					None:
						void
					Some(id):
						field_result = variant_field(variant, position, unions, exit_span(arm.body))
						binding = bindings.get(binding_number(id))
						match field_result:
							Err(error):
								failure = Some(error)
								break
							Ok(field):
								match binding:
									Some(binding):
										value = into_opaque ValueId(next_value)
										next_value = IntOps.add(next_value, 1)
										definitions = definitions.append({
											id = value,
											operation = PayloadValue(field, scrutinee),
											value_type = binding.value_type,
											span = binding.span,
										})
										values = values.set(binding_number(id), Some(value))
									None:
										failure = Some(invalid_binding(exit_span(arm.body)))
										break
				position = IntOps.add(position, 1)
		WildcardCase:
			void
	match failure:
		Some(error): Err(error)
		None:
			prefix ?= lower_statements(next_value, values, arm.statements)
			result ?= lower_exit(prefix.next_value, prefix.bindings, arm.body)
			var completed_definitions = definitions
			for definition in prefix.definitions:
				completed_definitions = completed_definitions.append(definition)
			for definition in result.definitions:
				completed_definitions = completed_definitions.append(definition)
			Ok({
				arm = {
					label = label,
					body = { definitions = completed_definitions, exit = result.exit },
				},
				next_value = result.next_value,
			})


private pure func lower_match(
	next_value: Int,
	values: List[Option[ValueId]],
	matched: ConcreteMatch,
	bindings: List[ConcreteBinding],
	unions: List[ConcreteUnion],
) -> Result[BuiltMatch, Diagnostic]:
	scrutinee ?= lower_value({ next_value = next_value, definitions = [] }, values, matched.scrutinee)
	var cursor = scrutinee.builder.next_value
	var arms: List[LoweredArm] = []
	var failure: Option[Diagnostic] = None
	for arm in matched.arms:
		match lower_arm(cursor, values, arm, scrutinee.value, bindings, unions):
			Err(error):
				failure = Some(error)
				break
			Ok(lowered):
				arms = arms.append(lowered.arm)
				cursor = lowered.next_value
	match failure:
		Some(error): Err(error)
		None: Ok({
			definitions = scrutinee.builder.definitions,
			matched = { scrutinee = scrutinee.value, owner = matched.owner, arms = arms },
		})


private pure func lower_function(
	function: ConcreteFunction,
	unions: List[ConcreteUnion],
) -> Result[LoweredFunction, Diagnostic]:
	var next_value = 0
	var parameter_definitions: List[ValueDefinition] = []
	var values = function.bindings.map(pure func(_: ConcreteBinding) -> Option[ValueId]: None)
	var ordinal = 0
	for binding in function.bindings:
		match binding.origin:
			ParameterBinding(index):
				definition: ValueDefinition = {
					id = into_opaque ValueId(next_value),
					operation = ParameterValue(index),
					value_type = binding.value_type,
					span = binding.span,
				}
				next_value = IntOps.add(next_value, 1)
				parameter_definitions = parameter_definitions.append(definition)
				values = values.set(ordinal, Some(definition.id))
			_:
				void
		ordinal = IntOps.add(ordinal, 1)
	prefix ?= lower_statements(next_value, values, function.statements)
	body_result: Result[BuiltTail, Diagnostic] = match function.body:
		ConcreteValueBody(value):
			result ?= lower_exit(prefix.next_value, prefix.bindings, value)
			Ok({ definitions = result.definitions, tail = ExitValue(result.exit) })
		ConcreteMatchBody(matched):
			result ?= lower_match(prefix.next_value, prefix.bindings, matched, function.bindings, unions)
			Ok({ definitions = result.definitions, tail = MatchValue(result.matched) })
	body ?= body_result
	var definitions = parameter_definitions
	for definition in prefix.definitions:
		definitions = definitions.append(definition)
	for definition in body.definitions:
		definitions = definitions.append(definition)
	Ok({
		execution = function.execution,
		signature = function.signature,
		definitions = definitions,
		tail = body.tail,
	})


pure func lower(program: SpecializedProgram) -> Result[LoweredProgram, Diagnostic]:
	checked = specialized_contents(program)
	var functions: List[LoweredFunction] = []
	var failure: Option[Diagnostic] = None

	for function in checked.functions:
		match lower_function(function, checked.unions):
			Err(error):
				failure = Some(error)
				break
			Ok(lowered):
				functions = functions.append(lowered)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(into_opaque LoweredProgram({
						records = checked.records,
						unions = checked.unions,
						functions = functions,
						entrypoint = checked.entrypoint
					}))
