import:
	check: BindingId, BindingOrigin(ParameterBinding, BodyLocal, MatchCapture), binding_number
	int as IntOps
	list: set_index
	option: to_result
	specialize:
		ConcreteArm,
		ConcreteAssignment(InitializeBinding, ReassignBinding),
		ConcreteBase(ReturnInteger, ReturnVariant, ReturnBinding, ReturnCall, ReturnRecord),
		ConcreteBinding,
		ConcreteBody(ConcreteValueBody, ConcreteMatchBody),
		ConcreteCall,
		ConcreteExit(ReturnExpression, RecurWith),
		ConcreteFunction,
		ConcreteMatch,
		ConcreteOperation(InvokeFunction, ConstructVariant, ReadRecordField),
		ConcretePattern(VariantCase, WildcardCase, BindingCase),
		ConcreteRecord,
		ConcreteRecordField,
		ConcreteUnion,
		ConcreteValue,
		FieldInstanceId,
		FunctionInstanceId,
		FunctionSignature,
		PayloadBinding(NoPayloadBinding, DiscardPayload, BindPayload),
		RecordInstanceId,
		SpecializedProgram,
		TypeRef(IntType),
		UnionInstanceId,
		VariantInstanceId,
		specialized_contents,
	syntax: Diagnostic, FunctionExecution, Span


-- A value identity belongs to one lowered function, including its branches.
opaque type ValueId = Int


pure func value_number(id: ValueId) -> Int:
	from_opaque ValueId(id)


fixed record RecordFieldValue {
	field: FieldInstanceId,
	value: ValueId
}


fixed union ValueOperation:
	ConstructRecordValue(RecordInstanceId, List[RecordFieldValue])
	ReadRecordFieldValue(FieldInstanceId, ValueId)
	ParameterValue(Int)
	IntegerValue(Int)
	VariantValue(VariantInstanceId)
	CallValue(ConcreteCall, List[ValueId])
	ConstructValue(VariantInstanceId, ValueId)
	-- Selected member identity is retained for verification and C projection.
	PayloadValue(VariantInstanceId, ValueId)


fixed record ValueDefinition {
	id: ValueId,
	value_type: TypeRef,
	operation: ValueOperation,
	span: Span
}


fixed record ValueBlock {
	definitions: List[ValueDefinition],
	exit: LoweredExit
}


fixed union MatchLabel:
	VariantLabel(VariantInstanceId)
	DefaultLabel


fixed record LoweredArm {
	label: MatchLabel,
	body: ValueBlock
}


fixed record LoweredMatch {
	scrutinee: ValueId,
	owner: UnionInstanceId,
	arms: List[LoweredArm]
}


fixed union LoweredExit:
	ReturnValue(ValueId)
	RecurValues(List[ValueId], Span)


fixed union LoweredTail:
	ExitValue(LoweredExit)
	MatchValue(LoweredMatch)


fixed record LoweredFunction {
	execution: FunctionExecution,
	signature: FunctionSignature,
	definitions: List[ValueDefinition],
	tail: LoweredTail
}


fixed record LoweredFunctions {
	records: List[ConcreteRecord],
	unions: List[ConcreteUnion],
	functions: List[LoweredFunction],
	entrypoint: FunctionInstanceId
}


-- Only lowering can publish ordered definitions with resolved value uses.
opaque type LoweredProgram = LoweredFunctions


pure func lowered_functions(program: LoweredProgram) -> LoweredFunctions:
	from_opaque LoweredProgram(program)


private fixed record ValueBuilder {
	next_value: Int,
	definitions: List[ValueDefinition],
	bindings: List[Option[ValueId]]
}


private fixed record BuiltValue {
	builder: ValueBuilder,
	value: ValueId
}


private pure func invalid_binding(span: Span) -> Diagnostic:
	{
		span = span,
		note = None,
		message = "internal compiler error: invalid checked binding identity",
		help = "report this compiler error with the input program"
	}


private pure func define_value(
	builder: ValueBuilder,
	operation: ValueOperation,
	value_type: TypeRef,
	span: Span,
) -> BuiltValue:
	id = into_opaque ValueId(builder.next_value)
	{
		builder = { builder |
			next_value = IntOps.add(builder.next_value, 1),
			definitions = builder.definitions.append({
				id = id,
				operation = operation,
				value_type = value_type,
				span = span,
			})
		},
		value = id
	}


private pure func read_binding(
	bindings: List[Option[ValueId]],
	id: BindingId,
	span: Span,
) -> Result[ValueId, Diagnostic]:
	entry ?= bindings
		.get(binding_number(id))
		.to_result(invalid_binding(span))
	entry.to_result(invalid_binding(span))


private fixed record BuiltArguments {
	builder: ValueBuilder,
	values: List[ValueId]
}


private pure func lower_arguments(
	builder: ValueBuilder,
	arguments: List[ConcreteValue],
	prefix: List[ValueId],
) -> Result[BuiltArguments, Diagnostic]:
	var current = builder
	var values = prefix
	var failure: Option[Diagnostic] = None

	for argument in arguments:
		match lower_value(current, argument):
			Err(error):
				failure = Some(error)
				break
			Ok(built):
				current = built.builder
				values = values.append(built.value)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({
				builder = current,
				values = values,
			})


private pure func lower_record(
	builder: ValueBuilder,
	fields: List[ConcreteRecordField],
	owner: RecordInstanceId,
	value_type: TypeRef,
	span: Span,
) -> Result[BuiltValue, Diagnostic]:
	var current = builder
	var values: List[RecordFieldValue] = []
	var failure: Option[Diagnostic] = None

	for field in fields:
		match lower_value(current, field.value):
			Err(error):
				failure = Some(error)
				break
			Ok(child):
				current = child.builder
				values = values.append({
					field = field.field,
					value = child.value,
				})

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(define_value(current, ConstructRecordValue(owner, values), value_type, span))


private pure func lower_value(
	builder: ValueBuilder,
	value: ConcreteValue,
) -> Result[BuiltValue, Diagnostic]:
	base ?= match value.base:
		ReturnRecord(owner, fields):
			lower_record(builder, fields, owner, value.base_type, value.base_span)
		ReturnBinding(id):
			read_binding(
				builder.bindings,
				id,
				value.base_span,
			).map(
				pure func(id: ValueId) -> BuiltValue: {
					builder = builder,
					value = id
				},
			)
		ReturnInteger(integer):
			Ok(define_value(builder, IntegerValue(integer), value.base_type, value.base_span))
		ReturnVariant(id):
			Ok(define_value(builder, VariantValue(id), value.base_type, value.base_span))
		ReturnCall(call, arguments):
			lower_arguments(
				builder,
				arguments,
				[],
			).map(
				pure func(children: BuiltArguments) -> BuiltValue: define_value(
					children.builder,
					CallValue(call, children.values),
					value.base_type,
					value.base_span,
				),
			)

	var built = base
	var failure: Option[Diagnostic] = None

	for step in value.operations:
		match step.operation:
			InvokeFunction(call, arguments):
				match lower_arguments(built.builder, arguments, [built.value]):
					Err(error):
						failure = Some(error)
						break
					Ok(children):
						built = define_value(
							children.builder,
							CallValue(call, children.values),
							step.value_type,
							step.span,
						)
			ReadRecordField(field):
				built = define_value(
					built.builder,
					ReadRecordFieldValue(field, built.value),
					step.value_type,
					step.span,
				)
			ConstructVariant(id):
				built = define_value(
					built.builder,
					ConstructValue(id, built.value),
					step.value_type,
					step.span,
				)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(built)


private pure func assign_value(
	builder: ValueBuilder,
	id: BindingId,
	value: ValueId,
	span: Span,
) -> Result[ValueBuilder, Diagnostic]:
	bindings ?= builder.bindings
		.set_index(binding_number(id), Some(value))
		.to_result(invalid_binding(span))
	Ok({ builder | bindings = bindings })


private fixed record BuiltMatch {
	builder: ValueBuilder,
	matched: LoweredMatch
}


private fixed record BuiltArm {
	arm: LoweredArm,
	next_value: Int
}


private pure func lower_capture(
	builder: ValueBuilder,
	id: BindingId,
	variant: VariantInstanceId,
	scrutinee: ValueId,
	bindings: List[ConcreteBinding],
	span: Span,
) -> Result[ValueBuilder, Diagnostic]:
	definition ?= bindings
		.get(binding_number(id))
		.to_result(invalid_binding(span))
	projection = define_value(
		builder,
		PayloadValue(variant, scrutinee),
		definition.value_type,
		definition.span,
	)
	assign_value(projection.builder, id, projection.value, definition.span)


private pure func exit_span(exit: ConcreteExit) -> Span:
	match exit:
		ReturnExpression(value):
			value.base_span
		RecurWith(_, span):
			span


private fixed record BuiltExit {
	builder: ValueBuilder,
	exit: LoweredExit
}


private pure func lower_exit(
	builder: ValueBuilder,
	exit: ConcreteExit,
) -> Result[BuiltExit, Diagnostic]:
	match exit:
		ReturnExpression(value):
			result ?= lower_value(builder, value)
			Ok({
				builder = result.builder,
				exit = ReturnValue(result.value),
			})
		RecurWith(arguments, span):
			result ?= lower_arguments(builder, arguments, [])
			Ok({
				builder = result.builder,
				exit = RecurValues(result.values, span),
			})


private pure func lower_arm(
	builder: ValueBuilder,
	arm: ConcreteArm,
	scrutinee: ValueId,
	bindings: List[ConcreteBinding],
) -> Result[BuiltArm, Diagnostic]:
	var branch = { builder | definitions = [] }

	label = match arm.pattern:
		VariantCase(id, _):
			VariantLabel(id)
		_:
			DefaultLabel

	bound ?= match arm.pattern:
		BindingCase(id):
			assign_value(branch, id, scrutinee, exit_span(arm.body))
		VariantCase(variant, payload):
			match payload:
				BindPayload(id):
					lower_capture(branch, id, variant, scrutinee, bindings, exit_span(arm.body))
				_:
					Ok(branch)
		WildcardCase:
			Ok(branch)

	prefix ?= lower_assignments(bound, arm.assignments)
	result ?= lower_exit(prefix, arm.body)
	Ok({
		arm = {
			label = label,
			body = {
				definitions = result.builder.definitions,
				exit = result.exit
			}
		},
		next_value = result.builder.next_value,
	})


private pure func lower_match(
	builder: ValueBuilder,
	matched: ConcreteMatch,
	bindings: List[ConcreteBinding],
) -> Result[BuiltMatch, Diagnostic]:
	scrutinee ?= lower_value(builder, matched.scrutinee)
	var current = scrutinee.builder
	var arms: List[LoweredArm] = []
	var failure: Option[Diagnostic] = None

	for arm in matched.arms:
		match lower_arm(current, arm, scrutinee.value, bindings):
			Err(error):
				failure = Some(error)
				break
			Ok(lowered):
				arms = arms.append(lowered.arm)
				current = { current | next_value = lowered.next_value }

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({
				builder = current,
				matched = {
					scrutinee = scrutinee.value,
					owner = matched.owner,
					arms = arms
				},
			})


private pure func lower_assignment(
	builder: ValueBuilder,
	assignment: ConcreteAssignment,
) -> Result[ValueBuilder, Diagnostic]:
	match assignment:
		InitializeBinding(id, value):
			result ?= lower_value(builder, value)
			assign_value(result.builder, id, result.value, value.base_span)
		ReassignBinding(id, value):
			result ?= lower_value(builder, value)
			assign_value(result.builder, id, result.value, value.base_span)


private pure func lower_assignments(
	initial: ValueBuilder,
	assignments: List[ConcreteAssignment],
) -> Result[ValueBuilder, Diagnostic]:
	var builder = initial
	var failure: Option[Diagnostic] = None

	for assignment in assignments:
		match lower_assignment(builder, assignment):
			Err(error):
				failure = Some(error)
				break
			Ok(assigned):
				builder = assigned

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(builder)


private pure func lower_function(function: ConcreteFunction) -> Result[LoweredFunction, Diagnostic]:
	var builder: ValueBuilder = {
		next_value = 0,
		definitions = [],
		bindings = function.bindings.map(pure func(_: ConcreteBinding) -> Option[ValueId]: None)
	}
	var ordinal: Int = 0

	-- The checked definition table owns parameter identity and its source span.
	for definition in function.bindings:
		match definition.origin:
			ParameterBinding(index):
				parameter = define_value(
					builder,
					ParameterValue(index),
					definition.value_type,
					definition.span,
				)
				builder = { parameter.builder |
					bindings = parameter.builder.bindings.set(ordinal, Some(parameter.value))
				}
			_:
				void

		ordinal = IntOps.add(ordinal, 1)

	prefix ?= lower_assignments(builder, function.assignments)

	match function.body:
		ConcreteValueBody(value):
			result ?= lower_exit(prefix, value)
			Ok({
				execution = function.execution,
				signature = function.signature,
				definitions = result.builder.definitions,
				tail = ExitValue(result.exit),
			})
		ConcreteMatchBody(matched):
			result ?= lower_match(prefix, matched, function.bindings)
			Ok({
				execution = function.execution,
				signature = function.signature,
				definitions = result.builder.definitions,
				tail = MatchValue(result.matched),
			})


pure func lower(program: SpecializedProgram) -> Result[LoweredProgram, Diagnostic]:
	checked = specialized_contents(program)
	var functions: List[LoweredFunction] = []
	var failure: Option[Diagnostic] = None

	for function in checked.functions:
		match lower_function(function):
			Err(error):
				failure = Some(error)
				break
			Ok(lowered):
				functions = functions.append(lowered)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(into_opaque LoweredProgram({
						records = checked.records,
						unions = checked.unions,
						functions = functions,
						entrypoint = checked.entrypoint
					}))
