import:
	check: check
	check_render: render_failure
	emit: emit
	int as IntOps
	load: SourceFile, SourceInputs, load_program
	lower: lower
	own: own
	parse: ParsedProgram
	result: map_err
	source:
		SourceRole(CompilerRole, ModuleRole, InvalidRole), module_number, source_module,
		source_role
	specialize: specialize
	syntax:
		Diagnostic,
		DiagnosticNote(
			UnionPayloadDeclaration, TypeDeclaration, RecordFieldDeclaration, PreviousField,
			PreviousDeclaration, CompetingDeclarations,
		),
		Diagnostics, Span, singleton_diagnostic
	system: write_file
	text: concat, equals
	verify: verify


-- Source loading publishes complete syntax and identities. Every stage here is pure.
pure func compile(program: ParsedProgram) -> Result[String, Diagnostics]:
	checked ?= check(program).map_err(render_failure)
	specialized ?= specialize(checked).map_err(singleton_diagnostic)
	lowered ?= lower(specialized).map_err(singleton_diagnostic)
	owned ?= own(lowered).map_err(singleton_diagnostic)
	verified ?= verify(owned).map_err(singleton_diagnostic)
	emit(verified).map_err(singleton_diagnostic)


private pure func render_file_location(file: SourceFile, span: Span) -> String:
	var line: Int = 1
	var column: Int = 1
	var cursor: Int = 0

	while IntOps.less_than(cursor, span.start):
		if equals(file.contents.substring(cursor, 1), "\n"):
			line = IntOps.add(line, 1)
			column = 1
		else:
			column = IntOps.add(column, 1)

		cursor = IntOps.add(cursor, 1)

	file.path.concat(":").concat("".append_int(line)).concat(":").concat("".append_int(column))


private pure func render_location(inputs: SourceInputs, span: Span) -> Result[String, String]:
	match source_role(span.source):
		CompilerRole:
			Ok("blorp_2")
		ModuleRole:
			match source_module(span.source):
				Some(id):
					match inputs.modules.get(module_number(id)):
						Some(file): Ok(render_file_location(file, span))
						None: Err("diagnostic references a missing module source")
				None:
					Err("invalid module source identity in diagnostic")
		InvalidRole:
			Err("invalid source identity in diagnostic")


private pure func note_spans(note: DiagnosticNote) -> List[Span]:
	match note:
		UnionPayloadDeclaration(span): [span]
		TypeDeclaration(span): [span]
		RecordFieldDeclaration(span): [span]
		PreviousField(span): [span]
		PreviousDeclaration(span): [span]
		CompetingDeclarations(spans): spans


private pure func note_text(note: DiagnosticNote) -> String:
	match note:
		UnionPayloadDeclaration(_): ": note: union payload declared here"
		TypeDeclaration(_): ": note: type declared here"
		RecordFieldDeclaration(_): ": note: record field declared here"
		PreviousField(_): ": note: previous field written here"
		PreviousDeclaration(_): ": note: previous declaration or import here"
		CompetingDeclarations(_): ": note: candidate declaration or import here"


private pure func render_diagnostic(inputs: SourceInputs, diagnostic: Diagnostic) -> Result[String, String]:
	location ?= render_location(inputs, diagnostic.span)
	message = location.concat(": error: ").concat(diagnostic.message).concat("\nhelp: ").concat(diagnostic.help)

	match diagnostic.note:
		None:
			Ok(message)
		Some(note):
			var rendered = message
			var failure: Option[String] = None
			for span in note_spans(note):
				match render_location(inputs, span):
					Err(error):
						failure = Some(error)
						break
					Ok(location):
						rendered = rendered.concat("\n").concat(location).concat(note_text(note))
			match failure:
				Some(error): Err(error)
				None: Ok(rendered)


pure func render_diagnostics(inputs: SourceInputs, errors: Diagnostics) -> String:
	var rendered: List[String] = []
	var failure: Option[String] = None

	for error in [errors.first].concat(errors.remaining):
		match render_diagnostic(inputs, error):
			Ok(text): rendered = rendered.append(text)
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			"blorp_2: error: ".concat(error).concat("\nhelp: report this compiler error with the input files")
		None:
			rendered.join("\n")


func main(args: List[String]) -> Int:
	match args:
		[_, "--library-root", library_root, input_path, output_path]:
			compile_file(input_path, output_path, library_root)
		_:
			usage_error()


private func usage_error() -> Int:
	print_error("blorp_2: error: expected a library root, input and output paths\nhelp: run blorp_2 --library-root DIRECTORY INPUT.brp OUTPUT.c")
	1


private func publish(path: String, generated_c: String) -> Int:
	match write_file(path, generated_c):
		Err(error):
			print_error("blorp_2: error: could not write ".concat(path).concat(": ").concat(error).concat("\nhelp: provide a writable output path"))
			1
		Ok(_):
			0


private func compile_file(input_path: String, output_path: String, library_root: String) -> Int:
	match load_program(input_path, library_root):
		Err(failure):
			print_error(render_diagnostics(failure.sources, singleton_diagnostic(failure.diagnostic)))
			1
		Ok(loaded):
			match compile(loaded.program):
				Err(errors):
					print_error(render_diagnostics(loaded.sources, errors))
					1
				Ok(generated_c):
					publish(output_path, generated_c)
