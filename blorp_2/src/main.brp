import:
	./prelude: CheckedPrelude, check_prelude
	check: check
	check_render: render_failure
	emit: emit
	int as IntOps
	lex: lex
	lower: lower
	own: own
	parse: parse, parse_prelude
	result: map_err
	specialize: specialize
	syntax:
		Diagnostic,
		DiagnosticNote(UnionPayloadDeclaration),
		Diagnostics,
		Span,
		singleton_diagnostic,
	system: read_file, write_file
	text: concat, equals
	verify: verify


fixed record CompilationInputs {
	prelude: String,
	program: String
}


fixed union CompilationDiagnostic:
	PreludeDiagnostics(Diagnostics)
	ProgramDiagnostics(Diagnostics)


private pure func prepare_prelude(source: String) -> Result[CheckedPrelude, Diagnostic]:
	lexed ?= lex(source)
	parsed ?= parse_prelude(lexed)
	check_prelude(parsed)


private pure func compile_program(
	source: String,
	prelude: CheckedPrelude,
) -> Result[String, Diagnostics]:
	lexed ?= lex(source).map_err(singleton_diagnostic)
	parsed ?= parse(lexed, prelude).map_err(singleton_diagnostic)
	checked ?= check(parsed).map_err(render_failure)
	specialized ?= specialize(checked).map_err(singleton_diagnostic)
	lowered ?= lower(specialized).map_err(singleton_diagnostic)
	owned ?= own(lowered).map_err(singleton_diagnostic)
	verified ?= verify(owned).map_err(singleton_diagnostic)
	emit(verified).map_err(singleton_diagnostic)


pure func compile(inputs: CompilationInputs) -> Result[String, CompilationDiagnostic]:
	prelude ?= prepare_prelude(
		inputs.prelude,
	).map_err(
		pure func(
			error: Diagnostic,
		) -> CompilationDiagnostic: PreludeDiagnostics(singleton_diagnostic(error)),
	)
	compile_program(
		inputs.program,
		prelude,
	).map_err(
		pure func(errors: Diagnostics) -> CompilationDiagnostic: ProgramDiagnostics(errors),
	)


private pure func render_location(path: String, source: String, span: Span) -> String:
	var line: Int = 1
	var column: Int = 1
	var cursor: Int = 0

	while IntOps.less_than(cursor, span.start):
		if equals(
			source.substring(cursor, 1),
			"\n",
		):
			line = IntOps.add(line, 1)
			column = 1
		else:
			column = IntOps.add(column, 1)

		cursor = IntOps.add(cursor, 1)

	path
		.concat(":")
		.concat("".append_int(line))
		.concat(":")
		.concat("".append_int(column))


private pure func render_diagnostic(path: String, source: String, diagnostic: Diagnostic) -> String:
	message = render_location(path, source, diagnostic.span)
		.concat(": error: ")
		.concat(diagnostic.message)
		.concat("\nhelp: ")
		.concat(diagnostic.help)

	match diagnostic.note:
		None:
			message
		Some(UnionPayloadDeclaration(span)):
			message
				.concat("\n")
				.concat(render_location(path, source, span))
				.concat(": note: union payload declared here")


func main(args: List[String]) -> Int:
	match args:
		[_, prelude_path, input_path, output_path]:
			match read_file(prelude_path):
				Err(error):
					print_error(read_error(prelude_path, error))
					1
				Ok(prelude):
					compile_file(prelude_path, prelude, input_path, output_path)
		_:
			print_error(
				"blorp_2: error: expected prelude, input and output paths\nhelp: run blorp_2 PRELUDE.brp INPUT.brp OUTPUT.c",
			)
			1


private pure func read_error(path: String, error: String) -> String:
	"blorp_2: error: could not read "
		.concat(path)
		.concat(": ")
		.concat(error)
		.concat("\nhelp: provide a readable input file")


private func compile_file(
	prelude_path: String,
	prelude: String,
	input_path: String,
	output_path: String,
) -> Int:
	match read_file(input_path):
		Err(error):
			print_error(read_error(input_path, error))
			1
		Ok(source):
			match compile({
				prelude = prelude,
				program = source,
			}):
				Err(failure):
					match failure:
						PreludeDiagnostics(errors):
							print_error(render_diagnostics(prelude_path, prelude, errors))
						ProgramDiagnostics(errors):
							print_error(render_diagnostics(input_path, source, errors))

					1
				Ok(generated_c):
					match write_file(output_path, generated_c):
						Err(error):
							print_error(
								"blorp_2: error: could not write "
									.concat(output_path)
									.concat(": ")
									.concat(error)
									.concat("\nhelp: provide a writable output path"),
							)
							1
						Ok(_):
							0


pure func render_diagnostics(path: String, source: String, errors: Diagnostics) -> String:
	var output = render_diagnostic(path, source, errors.first)

	for error in errors.remaining:
		output = output
			.concat("\n")
			.concat(render_diagnostic(path, source, error))

	output
