import:
	./check/check: check
	./check/render: render_failure
	./emit/emit: emit
	int: Int methods
	io: print_error
	./load/load: LoadedProgram, LoadFailure, SourceFile, SourceInputs, load_program, load_test_program
	./lower/lower: lower
	./own/own: own
	./parse/assemble: ParsedProgram
	option: Option methods
	result: Result methods
	string: String methods
	./utils/source:
		SourceRole(CompilerRole, ModuleRole, InvalidRole), module_number, source_module,
		source_role
	./specialize/specialize: specialize
	./utils/syntax:
		Diagnostic,
		DiagnosticNote(
			UnionPayloadDeclaration, RecordFieldDeclaration, PreviousField,
			PreviousDeclaration, CompetingDeclarations, Declaration, NoteLines,
		),
		Diagnostics, NoteLine, Span, singleton_diagnostic
	system: write_file
	./utils/text: concat
	./verify/verify: verify


-- Source loading publishes complete syntax and identities. Every stage here is pure.
pure func compile(program: ParsedProgram) -> Result[String, Diagnostics]:
	checked ?= check(program).map_err(render_failure)
	specialized ?= specialize(checked).map_err(singleton_diagnostic)
	lowered ?= lower(specialized).map_err(singleton_diagnostic)
	owned ?= own(lowered).map_err(singleton_diagnostic)
	verified ?= verify(owned).map_err(singleton_diagnostic)
	emit(verified).map_err(singleton_diagnostic)


private LINE_FEED_BYTE: Int = 10


private pure func render_file_location(file: SourceFile, span: Span) -> String:
	var line: Int = 1
	var column: Int = 1
	var cursor: Int = 0

	while cursor.less_than(span.start):
		line_feed = match file.contents.byte_at(cursor):
			Some(byte): byte == LINE_FEED_BYTE
			None: False
		if line_feed:
			line = line.add(1)
			column = 1
		else:
			column = column.add(1)

		cursor = cursor.add(1)

	"${file.path}:${line.to_string()}:${column.to_string()}"


private pure func render_location(inputs: SourceInputs, span: Span) -> Result[String, String]:
	match source_role(span.source):
		CompilerRole:
			Ok("blorp_2")
		ModuleRole:
			match source_module(span.source).to_result("invalid module source identity in diagnostic"):
				Ok(id):
					match inputs.modules.get(module_number(id)).to_result("diagnostic references a missing module source"):
						Ok(file): Ok(render_file_location(file, span))
						Err(error): Err(error)
				Err(error): Err(error)
		InvalidRole:
			Err("invalid source identity in diagnostic")


private pure func note_lines(note: DiagnosticNote) -> List[NoteLine]:
	match note:
		NoteLines(lines): lines
		UnionPayloadDeclaration(span): [{ span = span, text = "union payload declared here" }]
		Declaration(span): [{ span = span, text = "declared here" }]
		RecordFieldDeclaration(span): [{ span = span, text = "record field declared here" }]
		PreviousField(span): [{ span = span, text = "previous field written here" }]
		PreviousDeclaration(span): [{ span = span, text = "previous declaration or import here" }]
		CompetingDeclarations(spans): spans.map(pure func(location: Span) -> NoteLine: { span = location, text = "candidate declaration or import here" })


-- Every rendered line is a source location followed by its text, so a diagnostic
-- and its notes render the same way.
private record LocatedText {
	span: Span,
	text: String
}


private pure func located_texts(diagnostic: Diagnostic) -> List[LocatedText]:
	headline = ": error: ${diagnostic.message}\nhelp: ${diagnostic.help}"
	var lines: List[LocatedText] = [{ span = diagnostic.span, text = headline }]
	match diagnostic.note:
		None: void
		Some(note):
			for note_line in note_lines(note):
				lines = lines.append({ span = note_line.span, text = ": note: ${note_line.text}" })
	lines


-- Recursion depth is the line count: each phase reports its first error, so a
-- compilation yields a handful. The host handles tens of thousands of frames
-- (30,000 ran, 50,000 overflowed the stack).
private pure func render_lines(inputs: SourceInputs, lines: List[LocatedText], rendered: List[String]) -> Result[List[String], String]:
	match lines.get(rendered.length()):
		None:
			Ok(rendered)
		Some(line):
			match render_location(inputs, line.span):
				Ok(location): render_lines(inputs, lines, rendered.append(location.concat(line.text)))
				Err(error): Err(error)


pure func render_diagnostics(inputs: SourceInputs, errors: Diagnostics) -> String:
	var lines: List[LocatedText] = []
	for error in [errors.first].concat(errors.remaining):
		lines = lines.concat(located_texts(error))
	match render_lines(inputs, lines, []):
		Ok(rendered):
			rendered.join("\n")
		Err(error):
			"blorp_2: error: ${error}\nhelp: report this compiler error with the input program"


func main(args: List[String]) -> Int:
	match args:
		-- The last path is the output; any paths before it are later suite roots.
		[_, "--library-root", library_root, "--test-suite", root_path, ...later_and_output]:
			match later_and_output.last():
				None: usage_error()
				Some(output_path): compile_loaded(load_test_program(root_path, later_and_output.take(later_and_output.length().subtract(1)), library_root), output_path)
		[_, "--library-root", library_root, input_path, output_path]:
			compile_loaded(load_program(input_path, library_root), output_path)
		_:
			usage_error()


private func usage_error() -> Int:
	print_error("blorp_2: error: expected a library root, input and output paths\nhelp: run blorp_2 --library-root DIRECTORY INPUT.brp OUTPUT.c, or --library-root DIRECTORY --test-suite SUITE.brp [SUITE.brp ...] OUTPUT.c")
	1


private func publish(path: String, generated_c: String) -> Int:
	match write_file(path, generated_c):
		Err(error):
			print_error("blorp_2: error: could not write ${path}: ${error}\nhelp: provide a writable output path")
			1
		Ok(_):
			0


private func compile_loaded(input: Result[LoadedProgram, LoadFailure], output_path: String) -> Int:
	match input:
		Err(failure):
			print_error(render_diagnostics(failure.sources, singleton_diagnostic(failure.diagnostic)))
			1
		Ok(loaded):
			match compile(loaded.program):
				Err(errors):
					print_error(render_diagnostics(loaded.sources, errors))
					1
				Ok(generated_c):
					publish(output_path, generated_c)
