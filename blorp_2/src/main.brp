import:
	check: check
	emit: emit
	int as IntOps
	lex: lex
	parse: parse
	syntax: Diagnostic
	system: read_file, write_file
	text: concat, equals


pure func compile(source: String) -> Result[String, Diagnostic]:
	lexed ?= lex(source)
	parsed ?= parse(lexed)
	checked ?= check(parsed)
	emit(checked)


private pure func render_diagnostic(path: String, source: String, diagnostic: Diagnostic) -> String:
	var line: Int = 1
	var column: Int = 1
	var cursor: Int = 0

	while IntOps.less_than(cursor, diagnostic.span.start):
		if equals(
			source.substring(cursor, 1),
			"\n",
		):
			line = IntOps.add(line, 1)
			column = 1
		else:
			column = IntOps.add(column, 1)

		cursor = IntOps.add(cursor, 1)

	path
		.concat(":")
		.concat("".append_int(line))
		.concat(":")
		.concat("".append_int(column))
		.concat(": error: ")
		.concat(diagnostic.message)
		.concat("\nhelp: ")
		.concat(diagnostic.help)


func main(args: List[String]) -> Int:
	match args:
		[_, input_path, output_path]:
			match read_file(input_path):
				Err(error):
					print_error(
						"blorp_2: error: could not read "
							.concat(input_path)
							.concat(": ")
							.concat(error)
							.concat("\nhelp: provide a readable input file"),
					)
					1
				Ok(source):
					match compile(source):
						Err(diagnostic):
							print_error(render_diagnostic(input_path, source, diagnostic))
							1
						Ok(generated_c):
							match write_file(output_path, generated_c):
								Err(error):
									print_error(
										"blorp_2: error: could not write "
											.concat(output_path)
											.concat(": ")
											.concat(error)
											.concat("\nhelp: provide a writable output path"),
									)
									1
								Ok(_):
									0
		_:
			print_error(
				"blorp_2: error: expected an input path and an output path\nhelp: run blorp_2 INPUT.brp OUTPUT.c",
			)
			1
