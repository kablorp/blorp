import:
	../namespace/builtins:
		DesignatedBoolean,
		DesignatedOption,
		DesignatedResult,
		RuntimeOperation(
			IntAdd, IntSubtract, IntMultiply, IntDivide, IntRemainder, IntToString, StringLength, StringConcat,
			StringPrint, StringPrintError, StringParseInt, StringParseFloat, ListRepeat, ListLength, ListGet, ListAppend, ListSet,
			StringByteAt, StringFromCodepoint, GetCurrentDirectory, ReadFile, WriteFile,
			ListConcat, StringEquals,
			IntEquals, FloatAdd, FloatSubtract, FloatMultiply, FloatDivide, FloatRemainder,
			FloatToString,
		),
	./float_literal: c_float_literal
	./diagnostics:
		AggregateKind(RecordAggregate, UnionAggregate),
		EmissionFailure(
			MissingUnionLayout, MissingRecordLayout, MissingOwnerType, MissingValueType,
			MissingRuntimeArgument, StatementOnlyValue, MissingAggregateWorkItem,
			MissingAggregateVisit, CyclicByValueAggregate, MissingAggregateLayout,
			MissingAggregateMember, MissingUnionPayloadField,
		), render,
	../runtime/float: float_parse_runtime, float_runtime, float_string_runtime
	../runtime/system: SYSTEM_CURRENT_DIRECTORY_RUNTIME, SYSTEM_READ_FILE_RUNTIME, SYSTEM_WRITE_FILE_RUNTIME
	../runtime/string_concat: STRING_CONCAT_RUNTIME
	int as IntOps
	list: join
	../runtime/list:
		ListElementKey, ListUpdate(AppendUpdate, SetUpdate, ConcatUpdate), arguments_runtime,
		list_c_type, list_child_key, list_element_key, list_key_depth, list_key_ordinal,
		list_key_rank, list_root_allocation, list_runtime, list_slot_store, list_suffix,
		list_update_name, list_update_runtime, same_list_key
	../lower/lower: MatchLabel(VariantLabel, DefaultLabel), ValueId, value_number
	../own/own as Own:
		OwnedArgument(UnmanagedArgument, BorrowedArgument),
		OwnedArm,
		OwnedDefinition,
		OwnedExit(ReturnResult, RecurArguments),
		OwnedFunction,
		OwnedJoin,
		OwnedJoinParameter(UnmanagedJoinParameter, ManagedJoinParameter),
		join_parameter,
		OwnedMatch,
		OwnedTail(ReturnTail, MatchTail),
		OwnedValueOperation(
			ParameterDefinition, VoidDefinition, IntegerDefinition, FloatDefinition,
			StringDefinition, CallDefinition, ConstructDefinition, ConstructListDefinition,
			PayloadDefinition, ConstructRecordDefinition, ReadRecordFieldDefinition,
		),
		OwnerId,
		OwnershipOperation(DefineValue, ExecuteJoin, AcquireOwner, DropOwner),
		OwnershipProgram,
		ResultOwnership(UnmanagedResult, BorrowedResult, OwnedResult),
		ReturnTransfer(UnmanagedReturn, OwnedReturn),
		StoredPayload(UnmanagedPayload, OwnedPayload),
		owner_number,
	../utils/source: compiler_source
	../specialize/specialize:
		CallTarget(UserFunction, RuntimeFunction),
		ConcreteRecord,
		ConcreteUnion,
		FieldInstanceId,
		RecordInstanceId,
		RecordRepresentation(InlineRecord, ManagedRecord),
		TypeRef(VoidType, IntType, FloatType, StringType, ListType, UnionType, RecordType),
		UnionInstanceId,
		UnionRepresentation(InlineUnmanaged, InlineOwningPayload, BoxedRecursive),
		VariantInstanceId, variant_field_variant, variant_field_number,
		field_number,
		field_owner,
		function_number,
		record_number,
		union_number,
		variant_number,
		variant_owner,
		value_ownership, ValueOwnership(NoOwnership),
	string as StringOps
	../runtime/string:
		string_equals_runtime,
		string_parse_int_runtime,
		string_print_runtime, STRING_PRINT_ERROR_RUNTIME,
		string_runtime,
	../utils/syntax:
		Diagnostic,
		EntryResult(IntegerExitStatus, SuccessfulExit),
		Entrypoint(NoArguments, WithArguments),
		FunctionExecution(OrdinaryCalls, SelfTailLoop),
		Span,
		entry_function,
	../utils/text: concat
	../verify/verify: VerifiedProgram, verified_contents


-- Type and layout products have no source occurrence; this marks that origin.
private pure func internal_span() -> Span:
	{
		source = compiler_source(),
		start = 0,
		end = 0
	}


private pure func c_parameter(index: Int) -> String:
	"blorp_p_".append_int(index)


private pure func c_name(index: Int) -> String:
	"blorp_f_".append_int(index)


private pure func c_value(id: ValueId) -> String:
	"blorp_vl_".append_int(value_number(id))


private pure func c_owner(id: OwnerId) -> String:
	"blorp_owner_".append_int(owner_number(id))


private pure func c_callable(target: CallTarget) -> String:
	match target:
		UserFunction(id):
			c_name(function_number(id))
		RuntimeFunction(operation):
			match operation:
				StringPrint:
					"blorp_string_print"
				StringPrintError:
					"blorp_string_print_error"
				IntAdd:
					"blorp_int_add"
				IntSubtract:
					"blorp_int_subtract"
				IntMultiply:
					"blorp_int_multiply"
				IntDivide:
					"blorp_int_divide"
				IntRemainder:
					"blorp_int_remainder"
				IntToString:
					"blorp_int_to_string"
				FloatAdd:
					"blorp_float_add"
				FloatSubtract:
					"blorp_float_subtract"
				FloatMultiply:
					"blorp_float_multiply"
				FloatDivide:
					"blorp_float_divide"
				FloatRemainder:
					"blorp_float_remainder"
				FloatToString:
					"blorp_float_to_string"
				StringLength:
					"blorp_string_length"
				StringConcat:
					"blorp_string_concat"
				StringParseInt(_):
					"blorp_string_parse_int"
				StringParseFloat(_):
					"blorp_string_parse_float"
				StringByteAt(_):
					"blorp_string_byte_at"
				StringFromCodepoint(_):
					"blorp_string_from_codepoint"
				ReadFile(_):
					"blorp_read_file"
				WriteFile(_):
					"blorp_write_file"
				GetCurrentDirectory(_):
					"blorp_get_current_directory"
				ListRepeat(element):
					"blorp_list_repeat_".concat(list_suffix(list_element_key(element)))
				ListLength(element):
					"blorp_list_length_".concat(list_suffix(list_element_key(element)))
				ListGet(element, _):
					"blorp_list_get_".concat(list_suffix(list_element_key(element)))
				ListAppend(element):
					list_update_name(AppendUpdate, list_element_key(element))
				ListSet(element):
					list_update_name(SetUpdate, list_element_key(element))
				ListConcat(element):
					list_update_name(ConcatUpdate, list_element_key(element))
				StringEquals(_):
					"blorp_string_equals"
				IntEquals(_):
					"blorp_int_equals"


private pure func append_integer(output: String, value: Int) -> String:
	if IntOps.equals(value, IntOps.INT_MIN):
		output.concat("INT64_MIN")
	else if IntOps.less_than(value, 0):
		output
			.concat("(-INT64_C(")
			.append_int(IntOps.subtract(0, value))
			.concat("))")
	else:
		output
			.concat("INT64_C(")
			.append_int(value)
			.concat(")")


-- Function-local static data has fixed syntactic depth and no C string-token
-- length limit or automatic array storage. Existing ValueIds distinguish the
-- backing bytes; each evaluation still constructs an ordinary fresh String.
private pure func c_literal_bytes(id: ValueId) -> String:
	"blorp_bytes_".append_int(value_number(id))


private pure func append_string_bytes(output: String, id: ValueId, bytes: String) -> String:
	var projected = output
		.concat("static const unsigned char ")
		.concat(c_literal_bytes(id))
		.concat("[]={")
	var position = 0

	while True:
		match StringOps.byte_at(bytes, position):
			Some(byte):
				if IntOps.greater_than(position, 0):
					projected = projected.concat(",")

				projected = projected.append_int(byte)
				position = IntOps.add(position, 1)
			None:
				break

	if IntOps.equals(position, 0):
		-- ISO C forbids an empty initializer; logical length remains zero.
		projected = projected.concat("0")

	projected.concat("};")


private pure func has_payload(declaration: ConcreteUnion) -> Bool:
	declaration.variants.any(pure func(fields): not fields.is_empty())


private pure func boxed_union_struct(index: Int) -> String:
	"struct blorp_u_".append_int(index)


-- A boxed union value is a pointer to its counted node.
private pure func union_c_type(id: UnionInstanceId, declaration: ConcreteUnion) -> String:
	match declaration.representation:
		BoxedRecursive:
			boxed_union_struct(union_number(id)).concat("*")
		InlineUnmanaged | InlineOwningPayload:
			prefix = if has_payload(declaration):
				"struct blorp_u_"
			else:
				"enum blorp_u_"

			prefix.append_int(union_number(id))


-- Every value local is const except a join's, which its arms assign.
private fixed union LocalAssignment:
	InitializedLocal
	JoinLocal


-- A local holding a pointer is itself const, so const follows a pointer type.
-- String, List and boxed union carriers spell their pointer in the C type.
private pure func c_local_declaration(
	value_type: TypeRef,
	assignment: LocalAssignment,
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[String, Diagnostic]:
	type_name ?= c_type(value_type, unions, span)
	pointer_carrier ?= match value_type:
		StringType | ListType(_):
			Ok(True)
		UnionType(id):
			match unions.get(union_number(id)):
				None:
					Err(render(span, MissingUnionLayout(id)))
				Some(layout):
					boxed_pointer: Bool = match layout.representation:
						BoxedRecursive: True
						InlineUnmanaged | InlineOwningPayload: False
					Ok(boxed_pointer)
		_:
			Ok(False)
	declaration: String = match assignment:
		JoinLocal:
			type_name.concat(" ")
		InitializedLocal:
			if pointer_carrier:
				type_name.concat(" const ")
			else:
				"const ".concat(type_name).concat(" ")
	Ok(declaration)


private pure func record_c_type(id: RecordInstanceId) -> String:
	"blorp_r_".append_int(record_number(id))


private pure func c_field(id: FieldInstanceId) -> String:
	"blorp_rf_"
		.append_int(record_number(field_owner(id)))
		.concat("_")
		.append_int(field_number(id))


private pure func append_record(
	output: String,
	layout: ConcreteRecord,
	index: Int,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	var result = output
		.concat("struct blorp_r_")
		.append_int(index)
		.concat("{")

	match layout.representation:
		ManagedRecord:
			result = result.concat("_Atomic uint64_t references;")
		InlineRecord:
			void

	var position = 0
	var invalid: Option[Diagnostic] = None

	for field in layout.fields:
		match c_type(field, unions, internal_span()):
			Ok(name):
				result = result
					.concat(name)
					.concat(" blorp_rf_")
					.append_int(index)
					.concat("_")
					.append_int(position)
					.concat(";")
			Err(error):
				invalid = Some(error)
				break

		position = IntOps.add(position, 1)

	match invalid:
		Some(error):
			Err(error)
		None:
			Ok(result.concat("};"))


private pure func c_type(
	type_ref: TypeRef,
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[String, Diagnostic]:
	match type_ref:
		RecordType(id):
			Ok(record_c_type(id))
		VoidType:
			Ok("uint8_t")
		IntType:
			Ok("int64_t")
		FloatType:
			Ok("double")
		StringType:
			Ok("struct blorp_string*")
		ListType(element):
			Ok(list_c_type(list_element_key(element)))
		UnionType(id):
			match unions.get(union_number(id)):
				Some(declaration): Ok(union_c_type(id, declaration))
				None: Err(render(span, MissingUnionLayout(id)))


private pure func c_variant(id: VariantInstanceId) -> String:
	"blorp_v_"
		.append_int(union_number(variant_owner(id)))
		.concat("_")
		.append_int(variant_number(id))


private pure func c_parameters(
	parameters: List[TypeRef],
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	if IntOps.equals(parameters.length(), 0):
		Ok("(void)")
	else:
		var output: String = "("
		var index: Int = 0
		var invalid: Option[Diagnostic] = None

		for parameter in parameters:
			match c_type(parameter, unions, internal_span()):
				Err(error):
					invalid = Some(error)
					break
				Ok(name):
					if IntOps.greater_than(index, 0):
						output = output.concat(",")

					output = output
						.concat(name)
						.concat(" ")
						.concat(c_parameter(index))

			index = IntOps.add(index, 1)

		match invalid:
			Some(error):
				Err(error)
			None:
				Ok(output.concat(")"))


-- Inline unions are read by value; boxed unions through their node pointer.
private pure func union_member_selector(declaration: ConcreteUnion) -> String:
	match declaration.representation:
		BoxedRecursive: "->"
		InlineUnmanaged | InlineOwningPayload: "."


private pure func c_payload(id: VariantInstanceId) -> String:
	"blorp_up_".append_int(variant_number(id))


private pure func c_payload_field(variant: VariantInstanceId, position: Int) -> String:
	c_payload(variant).concat(".blorp_uf_").append_int(position)


private pure func append_union(
	output: String,
	declaration: ConcreteUnion,
	index: Int,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	payload = has_payload(declaration)

	prefix = if payload:
		"enum blorp_tag_"
	else:
		"enum blorp_u_"

	var result = output
		.concat(prefix)
		.append_int(index)
		.concat("{")
	var position: Int = 0

	for shape in declaration.variants:
		if IntOps.not_equals(position, 0):
			result = result.concat(",")

		result = result
			.concat("blorp_v_")
			.append_int(index)
			.concat("_")
			.append_int(position)
		position = IntOps.add(position, 1)

	result = result.concat("};")

	if payload:
		struct_prefix: String = result
			.concat("struct blorp_u_")
			.append_int(index)
			.concat("{")
		reference_header: String = match declaration.representation:
			BoxedRecursive: "_Atomic uint64_t references;"
			InlineUnmanaged | InlineOwningPayload: ""
		result = struct_prefix
			.concat(reference_header)
			.concat("enum blorp_tag_")
			.append_int(index)
			.concat(" tag;union{")
		position = 0
		var failure: Option[Diagnostic] = None

		for fields in declaration.variants:
			if not fields.is_empty():
				result = result.concat("struct{")
				var field_position = 0
				for value_type in fields:
					match c_type(value_type, unions, internal_span()):
						Err(error):
							failure = Some(error)
							break
						Ok(name):
							result = result
								.concat(name)
								.concat(" blorp_uf_")
								.append_int(field_position)
								.concat(";")
					field_position = IntOps.add(field_position, 1)
				if failure.is_some():
					break
				result = result
					.concat("} blorp_up_")
					.append_int(position)
					.concat(";")
			position = IntOps.add(position, 1)

		match failure:
			Some(error):
				Err(error)
			None:
				append_union_ownership(
					result.concat("}payload;};"),
					declaration,
					index,
					unions,
				)
	else:
		Ok(result)


private fixed union AggregateDefinition:
	RecordDefinition(Int)
	UnionDefinition(Int)


private fixed union AggregateVisit:
	UnvisitedAggregate
	VisitingAggregate
	EmittedAggregate


private fixed union AggregateVisitStep:
	PrepareAggregate(AggregateDefinition)
	EmitAggregate(AggregateDefinition)


private pure func push_aggregate_visit(
	steps: List[AggregateVisitStep],
	depth: Int,
	step: AggregateVisitStep,
) -> List[AggregateVisitStep]:
	if IntOps.less_than(depth, steps.length()):
		steps.set(depth, step)
	else:
		steps.append(step)


-- Whether a stored type must be defined before its parent: only storage by
-- value (an inline record or inline union) is a definition dependency. A
-- managed record, a boxed union and a List are pointers to forward-declared
-- types, which is what lets a layout group refer back to itself.
private pure func stored_by_value(value_type: TypeRef, records: List[ConcreteRecord], unions: List[ConcreteUnion]) -> Option[AggregateDefinition]:
	match value_type:
		RecordType(id):
			match records.get(record_number(id)):
				Some(layout):
					match layout.representation:
						InlineRecord: Some(RecordDefinition(record_number(id)))
						ManagedRecord: None
				None: None
		UnionType(id):
			match unions.get(union_number(id)):
				Some(layout):
					match layout.representation:
						InlineUnmanaged | InlineOwningPayload: Some(UnionDefinition(union_number(id)))
						BoxedRecursive: None
				None: None
		_:
			None


private pure func append_aggregate_definitions(
	records: List[ConcreteRecord],
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	-- State vectors and fragments remain local owners while dependencies are
	-- visited. No recursive carrier retains their previous roots.
	var record_visits = records.map(pure func(_): UnvisitedAggregate)
	var union_visits = unions.map(pure func(_): UnvisitedAggregate)
	var fragments: List[String] = []
	var pending: List[AggregateVisitStep] = []
	var pending_count = 0
	var position = unions.length()

	while IntOps.greater_than(position, 0):
		position = IntOps.subtract(position, 1)
		pending = push_aggregate_visit(
			pending,
			pending_count,
			PrepareAggregate(UnionDefinition(position)),
		)
		pending_count = IntOps.add(pending_count, 1)

	position = records.length()

	while IntOps.greater_than(position, 0):
		position = IntOps.subtract(position, 1)
		pending = push_aggregate_visit(
			pending,
			pending_count,
			PrepareAggregate(RecordDefinition(position)),
		)
		pending_count = IntOps.add(pending_count, 1)

	var invalid: Option[Diagnostic] = None

	while IntOps.greater_than(pending_count, 0) and not invalid.is_some():
		pending_count = IntOps.subtract(pending_count, 1)

		match pending.get(pending_count):
			None:
				invalid = Some(render(internal_span(), MissingAggregateWorkItem(pending_count)))
			Some(step):
				match step:
					PrepareAggregate(definition):
						status = match definition:
							RecordDefinition(index):
								record_visits.get(index)
							UnionDefinition(index):
								union_visits.get(index)

						match status:
							None:
								missing = match definition:
									RecordDefinition(index): MissingAggregateVisit(RecordAggregate, index)
									UnionDefinition(index): MissingAggregateVisit(UnionAggregate, index)
								invalid = Some(render(internal_span(), missing))
							Some(EmittedAggregate):
								void
							Some(VisitingAggregate):
								cycle = match definition:
									RecordDefinition(index): CyclicByValueAggregate(RecordAggregate, index)
									UnionDefinition(index): CyclicByValueAggregate(UnionAggregate, index)
								invalid = Some(render(internal_span(), cycle))
							Some(UnvisitedAggregate):
								pending = push_aggregate_visit(
									pending,
									pending_count,
									EmitAggregate(definition),
								)
								pending_count = IntOps.add(pending_count, 1)

								match definition:
									RecordDefinition(index):
										record_visits = record_visits.set(index, VisitingAggregate)

										match records.get(index):
											None:
												invalid = Some(render(internal_span(), MissingAggregateLayout(RecordAggregate, index)))
											Some(layout):
												var child = layout.fields.length()

												while IntOps.greater_than(child, 0):
													child = IntOps.subtract(child, 1)

													match layout.fields.get(child):
														Some(field):
															match stored_by_value(field, records, unions):
																Some(dependency):
																	pending = push_aggregate_visit(pending, pending_count, PrepareAggregate(dependency))
																	pending_count = IntOps.add(pending_count, 1)
																None:
																	void
														None:
															invalid = Some(render(internal_span(), MissingAggregateMember(RecordAggregate, index, child)))
															break
									UnionDefinition(index):
										union_visits = union_visits.set(index, VisitingAggregate)

										match unions.get(index):
											None:
												invalid = Some(render(internal_span(), MissingAggregateLayout(UnionAggregate, index)))
											Some(layout):
												var child = layout.variants.length()

												while IntOps.greater_than(child, 0):
													child = IntOps.subtract(child, 1)

													match layout.variants.get(child):
														Some(fields):
															var field_position = fields.length()
															while IntOps.greater_than(field_position, 0):
																field_position = IntOps.subtract(field_position, 1)
																match fields.get(field_position):
																	Some(field):
																		match stored_by_value(field, records, unions):
																			Some(dependency):
																				pending = push_aggregate_visit(pending, pending_count, PrepareAggregate(dependency))
																				pending_count = IntOps.add(pending_count, 1)
																			None:
																				void
																	None:
																		invalid = Some(render(internal_span(), MissingUnionPayloadField(index, child, field_position)))
																		break
														None:
															invalid = Some(render(internal_span(), MissingAggregateMember(UnionAggregate, index, child)))
															break
					EmitAggregate(definition):
						match definition:
							RecordDefinition(index):
								match records.get(index):
									None:
										invalid = Some(render(internal_span(), MissingAggregateLayout(RecordAggregate, index)))
									Some(layout):
										match append_record("", layout, index, unions):
											Ok(record_definition):
												fragments = fragments.append(record_definition)
												record_visits = record_visits.set(
													index,
													EmittedAggregate,
												)
											Err(error):
												invalid = Some(error)
							UnionDefinition(index):
								match unions.get(index):
									None:
										invalid = Some(render(internal_span(), MissingAggregateLayout(UnionAggregate, index)))
									Some(layout):
										match append_union("", layout, index, unions):
											Ok(union_definition):
												fragments = fragments.append(union_definition)
												union_visits = union_visits.set(
													index,
													EmittedAggregate,
												)
											Err(error):
												invalid = Some(error)

	match invalid:
		Some(error):
			Err(error)
		None:
			Ok(fragments.join("\n"))


private pure func append_record_prototypes(output: String, index: Int) -> String:
	output
		.concat("void blorp_record_dup_")
		.append_int(index)
		.concat("(blorp_r_")
		.append_int(index)
		.concat(");")
		.concat("void blorp_record_drop_")
		.append_int(index)
		.concat("(blorp_r_")
		.append_int(index)
		.concat(");")


private pure func append_record_ownership(
	output: String,
	layout: ConcreteRecord,
	index: Int,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	prefix = output
		.concat("void blorp_record_dup_")
		.append_int(index)
		.concat("(blorp_r_")
		.append_int(index)
		.concat(" value){")

	match layout.representation:
		InlineRecord:
			Ok(
				prefix
					.concat("(void)value;}void blorp_record_drop_")
					.append_int(index)
					.concat("(blorp_r_")
					.append_int(index)
					.concat(" value){(void)value;}"),
			)
		ManagedRecord:
			var result = prefix
				.concat(
					"(void)atomic_fetch_add_explicit(&value->references,UINT64_C(1),"
						.concat("memory_order_relaxed);}"),
				)
				.concat("void blorp_record_drop_")
				.append_int(index)
				.concat("(blorp_r_")
				.append_int(index)
				.concat(
					" value){if(atomic_fetch_sub_explicit(&value->references,UINT64_C(1),"
						.concat("memory_order_acq_rel)!=UINT64_C(1))return;"),
				)
			var position = 0
			var invalid: Option[Diagnostic] = None

			for field in layout.fields:
				match (
					append_storage_operation(
						result,
						field,
						DestroyValue,
						"value->blorp_rf_"
							.append_int(index)
							.concat("_")
							.append_int(position),
						unions,
						internal_span(),
					)
				):
					Ok(updated):
						result = updated
					Err(error):
						invalid = Some(error)
						break

				position = IntOps.add(position, 1)

			match invalid:
				Some(error):
					Err(error)
				None:
					result = result
						.concat("free(value);}")
						.concat("blorp_r_")
						.append_int(index)
						.concat(" blorp_record_make_")
						.append_int(index)
						.concat("(struct blorp_r_")
						.append_int(index)
						.concat(" fields){blorp_r_")
						.append_int(index)
						.concat(
							" value=malloc(sizeof *value);if(!value)abort();atomic_init(&value->references,"
								.concat("UINT64_C(1));"),
						)
					position = 0

					for _ in layout.fields:
						field = "blorp_rf_"
							.append_int(index)
							.concat("_")
							.append_int(position)
						result = result
							.concat("value->")
							.concat(field)
							.concat("=fields.")
							.concat(field)
							.concat(";")
						position = IntOps.add(position, 1)

					Ok(result.concat("return value;}"))


private pure func append_operation(
	output: String,
	id: ValueId,
	operation: OwnedValueOperation,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
	span: Span,
) -> Result[String, Diagnostic]:
	match operation:
		ConstructRecordDefinition(owner, fields):
			match records.get(record_number(owner)):
				Some(layout):

					var result = match layout.representation:
						InlineRecord:
							output.concat("((")
						ManagedRecord:
							output
								.concat("blorp_record_make_")
								.append_int(record_number(owner))
								.concat("((")

					result = result
						.concat("struct blorp_r_")
						.append_int(record_number(owner))
						.concat("){")
					var position = 0

					for field in fields:
						if IntOps.greater_than(position, 0):
							result = result.concat(",")

						stored = match field.value:
							UnmanagedPayload(value):
								value
							OwnedPayload(value, _):
								value

						result = result
							.concat(".")
							.concat(c_field(field.field))
							.concat("=")
							.concat(c_value(stored))
						position = IntOps.add(position, 1)

					Ok(result.concat("})"))
				None: Err(render(span, MissingRecordLayout(owner)))
		ReadRecordFieldDefinition(field, argument):
			match records.get(record_number(field_owner(field))):
				Some(layout):

					value = match argument:
						UnmanagedArgument(value):
							value
						BorrowedArgument(borrow):
							borrow.value

					selector = match layout.representation:
						InlineRecord:
							"."
						ManagedRecord:
							"->"

					Ok(
						output
							.concat(c_value(value))
							.concat(selector)
							.concat(c_field(field)),
					)
				None: Err(render(span, MissingRecordLayout(field_owner(field))))
		ParameterDefinition(index):
			Ok(output.concat(c_parameter(index)))
		VoidDefinition:
			Ok(output.concat("((uint8_t)0)"))
		IntegerDefinition(value):
			Ok(append_integer(output, value))
		FloatDefinition(value):
			Ok(output.concat(c_float_literal(value)))
		StringDefinition(bytes):
			constructor = output
				.concat("blorp_string_from_bytes((const char *)")
				.concat(c_literal_bytes(id))
			length = append_integer(
				constructor.concat(","),
				bytes.length(),
			)
			Ok(length.concat(")"))
		CallDefinition(call, arguments):
			var prefix = output
				.concat(c_callable(call.target))
				.concat("(")
			var index: Int = 0

			for argument in arguments:
				if IntOps.greater_than(index, 0):
					prefix = prefix.concat(",")

				value = match argument:
					UnmanagedArgument(argument_id):
						argument_id
					BorrowedArgument(borrow):
						borrow.value

				prefix = prefix.concat(c_value(value))
				index = IntOps.add(index, 1)

			Ok(prefix.concat(")"))
		ConstructDefinition(variant_id, fields):
			var operands: List[String] = []
			for field in fields:
				operand = match field:
					UnmanagedPayload(value): c_value(value)
					OwnedPayload(_, owner): c_owner(owner)
				operands = operands.append(operand)
			match c_union_value(variant_id, operands, unions, span):
				Ok(value): Ok(output.concat(value))
				Err(error): Err(error)
		ConstructListDefinition(_):
			-- List construction and joins are written as statements, by
			-- append_list_construction and append_join; never as expressions.
			Err(render(span, StatementOnlyValue(id)))
		PayloadDefinition(field, source_id):
			match unions.get(union_number(variant_owner(variant_field_variant(field)))):
				Some(declaration):
					Ok(
						output
							.concat(c_value(source_id))
							.concat(union_member_selector(declaration))
							.concat("payload.")
							.concat(c_payload_field(
								variant_field_variant(field),
								variant_field_number(field),
							)),
					)
				None: Err(render(span, MissingUnionLayout(variant_owner(variant_field_variant(field)))))


-- The one C rendering of a union value, for source constructions and runtime
-- results alike, so every union value local follows its layout. A union with
-- no payload anywhere is a bare C enum and a variant is its tag; any other
-- value is a compound literal, from which a boxed union allocates its counted
-- node. Each operand is an occurrence the new value owns.
private pure func c_union_value(
	variant: VariantInstanceId,
	operands: List[String],
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[String, Diagnostic]:
	index = union_number(variant_owner(variant))
	declaration ?= match unions.get(index):
		Some(found): Ok(found)
		None: Err(render(span, MissingUnionLayout(variant_owner(variant))))

	if has_payload(declaration):
		opening = match declaration.representation:
			BoxedRecursive:
				"blorp_union_make_".append_int(index).concat("((").concat(boxed_union_struct(index))
			InlineUnmanaged | InlineOwningPayload:
				"((".concat(union_c_type(variant_owner(variant), declaration))
		tagged = opening
			.concat("){.tag=")
			.concat(c_variant(variant))
		-- A variant without fields omits the payload initializer.
		if operands.is_empty():
			Ok(tagged.concat("})"))
		else:
			Ok(append_payload_initializer(tagged, variant, operands).concat("})"))
	else:
		Ok(c_variant(variant))


private pure func append_payload_initializer(
	output: String,
	id: VariantInstanceId,
	operands: List[String],
) -> String:
	var result = output
		.concat(",.payload.")
		.concat(c_payload(id))
		.concat("={")
	var position = 0
	for operand in operands:
		if IntOps.greater_than(position, 0):
			result = result.concat(",")
		result = result
			.concat(".blorp_uf_")
			.append_int(position)
			.concat("=")
			.concat(operand)
		position = IntOps.add(position, 1)
	result.concat("}")


private pure func argument_value(argument: OwnedArgument) -> ValueId:
	match argument:
		UnmanagedArgument(id):
			id
		BorrowedArgument(borrow):
			borrow.value


private pure func append_optional_value(
	output: String,
	id: ValueId,
	option: DesignatedOption[VariantInstanceId],
	condition: String,
	payload: String,
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[String, Diagnostic]:
	declaration ?= c_local_declaration(UnionType(variant_owner(option.some)), InitializedLocal, unions, span)
	some ?= c_union_value(option.some, [payload], unions, span)
	none ?= c_union_value(option.none, [], unions, span)
	name = c_value(id)
	Ok(
		output
			.concat(declaration)
			.concat(name)
			.concat("=")
			.concat(condition)
			.concat("?")
			.concat(some)
			.concat(":")
			.concat(none)
			.concat(";(void)")
			.concat(name)
			.concat(";"),
	)


private pure func append_parse_number(
	output: String,
	id: ValueId,
	option: DesignatedOption[VariantInstanceId],
	arguments: List[OwnedArgument],
	unions: List[ConcreteUnion],
	scalar_type: String,
	runtime: String,
	span: Span,
) -> Result[String, Diagnostic]:
	argument ?= match arguments.get(0):
		Some(found): Ok(found)
		None: Err(render(span, MissingRuntimeArgument(id, 0)))
	scratch = "blorp_runtime_".append_int(value_number(id))
	prefix = output
		.concat(scalar_type)
		.concat(" ")
		.concat(scratch)
		.concat("=0;const uint8_t ")
		.concat(scratch)
		.concat("_some=")
		.concat(runtime)
		.concat("(")
		.concat(c_value(argument_value(argument)))
		.concat(",&")
		.concat(scratch)
		.concat(");")
	append_optional_value(
		prefix,
		id,
		option,
		scratch.concat("_some"),
		scratch,
		unions,
		span,
	)


private pure func append_string_byte_at(
	output: String,
	id: ValueId,
	option: DesignatedOption[VariantInstanceId],
	arguments: List[OwnedArgument],
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[String, Diagnostic]:
	text ?= match arguments.get(0):
		Some(found): Ok(found)
		None: Err(render(span, MissingRuntimeArgument(id, 0)))
	index ?= match arguments.get(1):
		Some(found): Ok(found)
		None: Err(render(span, MissingRuntimeArgument(id, 1)))
	scratch = "blorp_runtime_".append_int(value_number(id))
	prefix = output
		.concat("int64_t ").concat(scratch).concat("=0;const uint8_t ")
		.concat(scratch).concat("_some=blorp_string_byte_at(")
		.concat(c_value(argument_value(text))).concat(",")
		.concat(c_value(argument_value(index))).concat(",&").concat(scratch).concat(");")
	append_optional_value(prefix, id, option, scratch.concat("_some"), scratch, unions, span)


private pure func append_string_from_codepoint(
	output: String,
	id: ValueId,
	option: DesignatedOption[VariantInstanceId],
	arguments: List[OwnedArgument],
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[String, Diagnostic]:
	scalar ?= match arguments.get(0):
		Some(found): Ok(found)
		None: Err(render(span, MissingRuntimeArgument(id, 0)))
	scratch = "blorp_runtime_".append_int(value_number(id))
	prefix = output
		.concat("struct blorp_string *").concat(scratch).concat("=NULL;const uint8_t ")
		.concat(scratch).concat("_some=blorp_string_from_codepoint(")
		.concat(c_value(argument_value(scalar))).concat(",&").concat(scratch).concat(");")
	-- Some takes the fresh root. Scratch is neither retained nor released here.
	append_optional_value(prefix, id, option, scratch.concat("_some"), scratch, unions, span)


private pure func append_current_directory(
	output: String,
	id: ValueId,
	result: DesignatedResult[VariantInstanceId],
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[String, Diagnostic]:
	declaration ?= c_local_declaration(UnionType(variant_owner(result.ok)), InitializedLocal, unions, span)
	scratch = "blorp_runtime_".append_int(value_number(id))
	ok ?= c_union_value(result.ok, [scratch], unions, span)
	error ?= c_union_value(result.err, [scratch], unions, span)
	-- Both branches take the one fresh String. Scratch has no separate obligation.
	Ok(output.concat("struct blorp_string *").concat(scratch).concat("=NULL;const uint8_t ")
		.concat(scratch).concat("_ok=blorp_get_current_directory(&").concat(scratch).concat(");")
		.concat(declaration).concat(c_value(id)).concat("=").concat(scratch).concat("_ok?")
		.concat(ok).concat(":").concat(error).concat(";(void)").concat(c_value(id)).concat(";"))


private pure func append_read_file(
	output: String,
	id: ValueId,
	result: DesignatedResult[VariantInstanceId],
	arguments: List[OwnedArgument],
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[String, Diagnostic]:
	path ?= match arguments.get(0):
		Some(found): Ok(found)
		None: Err(render(span, MissingRuntimeArgument(id, 0)))
	declaration ?= c_local_declaration(UnionType(variant_owner(result.ok)), InitializedLocal, unions, span)
	scratch = "blorp_runtime_".append_int(value_number(id))
	ok ?= c_union_value(result.ok, [scratch], unions, span)
	error ?= c_union_value(result.err, [scratch], unions, span)
	-- The path is borrowed; either constructor takes the one fresh String.
	Ok(output.concat("struct blorp_string *").concat(scratch).concat("=NULL;const uint8_t ")
		.concat(scratch).concat("_ok=blorp_read_file(").concat(c_value(argument_value(path)))
		.concat(",&").concat(scratch).concat(");")
		.concat(declaration).concat(c_value(id)).concat("=").concat(scratch).concat("_ok?")
		.concat(ok).concat(":").concat(error).concat(";(void)").concat(c_value(id)).concat(";"))


private pure func append_write_file(
	output: String,
	id: ValueId,
	result: DesignatedResult[VariantInstanceId],
	arguments: List[OwnedArgument],
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[String, Diagnostic]:
	path ?= match arguments.get(0):
		Some(found): Ok(found)
		None: Err(render(span, MissingRuntimeArgument(id, 0)))
	contents ?= match arguments.get(1):
		Some(found): Ok(found)
		None: Err(render(span, MissingRuntimeArgument(id, 1)))
	declaration ?= c_local_declaration(UnionType(variant_owner(result.ok)), InitializedLocal, unions, span)
	scratch = "blorp_runtime_".append_int(value_number(id))
	ok ?= c_union_value(result.ok, ["(uint8_t)0"], unions, span)
	error ?= c_union_value(result.err, [scratch], unions, span)
	-- Only Err takes a String root; Ok stores the actual unmanaged Void payload.
	Ok(output.concat("struct blorp_string *").concat(scratch).concat("=NULL;const uint8_t ")
		.concat(scratch).concat("_ok=blorp_write_file(").concat(c_value(argument_value(path)))
		.concat(",").concat(c_value(argument_value(contents))).concat(",&").concat(scratch).concat(");")
		.concat(declaration).concat(c_value(id)).concat("=").concat(scratch).concat("_ok?")
		.concat(ok).concat(":").concat(error).concat(";(void)").concat(c_value(id)).concat(";"))


private pure func append_list_get(
	output: String,
	id: ValueId,
	option: DesignatedOption[VariantInstanceId],
	element: TypeRef,
	arguments: List[OwnedArgument],
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[String, Diagnostic]:
	values ?= match arguments.get(0):
		Some(found): Ok(found)
		None: Err(render(span, MissingRuntimeArgument(id, 0)))
	index ?= match arguments.get(1):
		Some(found): Ok(found)
		None: Err(render(span, MissingRuntimeArgument(id, 1)))
	scratch = "blorp_runtime_".append_int(value_number(id))
	element_type ?= c_type(element, unions, span)
	prefix = output
		.concat(element_type).concat(" ").concat(scratch).concat("={0};const uint8_t ")
		.concat(scratch).concat("_some=blorp_list_get_")
		.concat(list_suffix(list_element_key(element))).concat("(")
		.concat(c_value(argument_value(values))).concat(",")
		.concat(c_value(argument_value(index))).concat(",&").concat(scratch).concat(");")
	append_optional_value(
		prefix,
		id,
		option,
		scratch.concat("_some"),
		scratch,
		unions,
		span,
	)


private pure func append_value(
	output: String,
	id: ValueId,
	value_type: TypeRef,
	operation: OwnedValueOperation,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
	span: Span,
) -> Result[String, Diagnostic]:
	match operation:
		CallDefinition(call, arguments):
			match call.target:
				RuntimeFunction(StringParseInt(option)):
					append_parse_number(
						output,
						id,
						option,
						arguments,
						unions,
						"int64_t",
						"blorp_string_parse_int",
						span,
					)
				RuntimeFunction(StringParseFloat(option)):
					append_parse_number(
						output,
						id,
						option,
						arguments,
						unions,
						"double",
						"blorp_string_parse_float",
						span,
					)
				RuntimeFunction(ListGet(element, option)):
					append_list_get(output, id, option, element, arguments, unions, span)
				RuntimeFunction(StringByteAt(option)):
					append_string_byte_at(output, id, option, arguments, unions, span)
				RuntimeFunction(StringFromCodepoint(option)):
					append_string_from_codepoint(output, id, option, arguments, unions, span)
				RuntimeFunction(ReadFile(result)):
					append_read_file(output, id, result, arguments, unions, span)
				RuntimeFunction(WriteFile(result)):
					append_write_file(output, id, result, arguments, unions, span)
				RuntimeFunction(GetCurrentDirectory(result)):
					append_current_directory(output, id, result, unions, span)
				RuntimeFunction(StringEquals(boolean)):
					append_equals(output, id, boolean, arguments, unions, StringComparison, span)
				RuntimeFunction(IntEquals(boolean)):
					append_equals(output, id, boolean, arguments, unions, IntegerComparison, span)
				_:
					append_regular_value(output, id, value_type, operation, unions, records, span)
		ConstructListDefinition(payloads):
			append_list_construction(output, id, value_type, payloads, unions, span)
		_:
			append_regular_value(output, id, value_type, operation, unions, records, span)


-- A literal is one fresh root of exactly n slots, written inline at its site
-- like record construction: the elements' acquisitions precede it, so each
-- store moves an owner or copies an unmanaged value, publishing length per slot.
private pure func append_list_construction(
	output: String,
	id: ValueId,
	value_type: TypeRef,
	payloads: List[StoredPayload],
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[String, Diagnostic]:
	type_name ?= c_type(value_type, unions, span)
	name = c_value(id)
	var result = output.concat(list_root_allocation(
		type_name.concat(" const"), name, "".append_int(payloads.length()),
	))
	var slot = 0
	for payload in payloads:
		stored = match payload:
			UnmanagedPayload(value): c_value(value)
			OwnedPayload(_, owner): c_owner(owner)
		result = result.concat(list_slot_store(name, "".append_int(slot), stored))
		slot = IntOps.add(slot, 1)
	Ok(result.concat("(void)").concat(name).concat(";"))


private fixed union EqualityComparison:
	StringComparison
	IntegerComparison


private pure func append_equals(
	output: String,
	id: ValueId,
	boolean: DesignatedBoolean[VariantInstanceId],
	arguments: List[OwnedArgument],
	unions: List[ConcreteUnion],
	comparison: EqualityComparison,
	span: Span,
) -> Result[String, Diagnostic]:
	left ?= match arguments.get(0):
		Some(found): Ok(found)
		None: Err(render(span, MissingRuntimeArgument(id, 0)))
	right ?= match arguments.get(1):
		Some(found): Ok(found)
		None: Err(render(span, MissingRuntimeArgument(id, 1)))
	declaration ?= c_local_declaration(UnionType(variant_owner(boolean.true_variant)), InitializedLocal, unions, span)
	equal ?= c_union_value(boolean.true_variant, [], unions, span)
	different ?= c_union_value(boolean.false_variant, [], unions, span)
	name = c_value(id)
	left_value = c_value(argument_value(left))
	right_value = c_value(argument_value(right))

	condition = match comparison:
		StringComparison:
			"blorp_string_equals("
				.concat(left_value)
				.concat(",")
				.concat(right_value)
				.concat(")")
		IntegerComparison:
			"("
				.concat(left_value)
				.concat("==")
				.concat(right_value)
				.concat(")")

	Ok(
		output
			.concat(declaration)
			.concat(name)
			.concat("=")
			.concat(condition)
			.concat("?")
			.concat(equal)
			.concat(":")
			.concat(different)
			.concat(";(void)")
			.concat(name)
			.concat(";"),
	)


private pure func append_regular_value(
	output: String,
	id: ValueId,
	value_type: TypeRef,
	operation: OwnedValueOperation,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
	span: Span,
) -> Result[String, Diagnostic]:
	declaration ?= c_local_declaration(value_type, InitializedLocal, unions, span)
	name = c_value(id)

	prepared = match operation:
		StringDefinition(bytes):
			append_string_bytes(output, id, bytes)
		_:
			output

	value ?= append_operation(
		prepared
			.concat(declaration)
			.concat(name)
			.concat("="),
		id,
		operation,
		unions,
		records,
		span,
	)
	Ok(
		value
			.concat(";(void)")
			.concat(name)
			.concat(";"),
	)


private pure func append_owner_alias(
	output: String,
	owner: OwnerId,
	value: ValueId,
	value_type: TypeRef,
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[String, Diagnostic]:
	name = c_owner(owner)
	declaration ?= c_local_declaration(value_type, InitializedLocal, unions, span)

	Ok(
		output
			.concat(declaration)
			.concat(name)
			.concat("=")
			.concat(c_value(value))
			.concat(";(void)")
			.concat(name)
			.concat(";"),
	)


private pure func append_owned_definition(
	output: String,
	definition: OwnedDefinition,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[String, Diagnostic]:
	value ?= append_value(
		output,
		definition.id,
		definition.value_type,
		definition.operation,
		unions,
		records,
		definition.span,
	)

	match definition.result:
		UnmanagedResult | BorrowedResult(_):
			Ok(value)
		OwnedResult(owner):
			append_owner_alias(value, owner, definition.id, definition.value_type, unions, definition.span)


-- Disposable owner-type projection of accepted IR; value types stay local.
private pure func owner_types(function: OwnedFunction) -> Result[List[TypeRef], Diagnostic]:
	blocks = function_blocks(function)
	var values: List[TypeRef] = []
	var owners: List[TypeRef] = []
	var failure: Option[Diagnostic] = None

	for operations in blocks:
		for operation in operations:
			match operation:
				DefineValue(definition):
					values = values.append(definition.value_type)

					match definition.result:
						OwnedResult(_):
							owners = owners.append(definition.value_type)
						_:
							void
				ExecuteJoin(join):
					parameter = join_parameter(join.result)
					values = values.append(parameter.value_type)
					match join.result:
						UnmanagedJoinParameter(_): void
						ManagedJoinParameter(_, _): owners = owners.append(parameter.value_type)

				AcquireOwner(_, borrowed, span):
					match values.get(value_number(borrowed.value)):
						Some(value_type):
							owners = owners.append(value_type)
						None:
							failure = Some(render(span, MissingValueType(borrowed.value)))
							break
				DropOwner(_, _):
					void

		if failure.is_some():
			break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(owners)


private fixed union OwnershipAction:
	DuplicateValue
	DestroyValue


private pure func append_storage_operation(
	output: String,
	value_type: TypeRef,
	action: OwnershipAction,
	expression: String,
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[String, Diagnostic]:
	name_result: Result[Option[String], Diagnostic] = match value_type:
		RecordType(id):
			prefix = match action:
				DuplicateValue:
					"blorp_record_dup_"
				DestroyValue:
					"blorp_record_drop_"

			Ok(Some(prefix.append_int(record_number(id))))
		ListType(element):
			prefix = match action:
				DuplicateValue: "blorp_list_dup_"
				DestroyValue: "blorp_list_drop_"
			Ok(Some(prefix.concat(list_suffix(list_element_key(element)))))
		StringType:
			storage_helper: String = match action:
				DuplicateValue:
					"blorp_string_retain"
				DestroyValue:
					"blorp_string_release"
			Ok(Some(storage_helper))
		UnionType(id):
			match unions.get(union_number(id)):
				Some(layout):
					union_helper: Option[String] = match layout.representation:
						InlineUnmanaged:
							None
						InlineOwningPayload | BoxedRecursive:
							prefix = match action:
								DuplicateValue:
									"blorp_union_dup_"
								DestroyValue:
									"blorp_union_drop_"

							Some(prefix.append_int(union_number(id)))
					Ok(union_helper)
				None: Err(render(span, MissingUnionLayout(id)))
		_:
			Ok(None)

	found_name ?= name_result
	operation: String = match found_name:
		Some(name):
			output
				.concat(name)
				.concat("(")
				.concat(expression)
				.concat(");")
		None:
			output
	Ok(operation)


private pure func append_union_action(
	output: String,
	layout: ConcreteUnion,
	index: Int,
	unions: List[ConcreteUnion],
	action: OwnershipAction,
) -> Result[String, Diagnostic]:
	prefix = match action:
		DuplicateValue:
			"void blorp_union_dup_"
		DestroyValue:
			"void blorp_union_drop_"

	var result = output
		.concat(prefix)
		.append_int(index)
		.concat("(struct blorp_u_")
		.append_int(index)
		.concat(" value){switch(value.tag){")
	var position = 0
	var failure: Option[Diagnostic] = None

	for fields in layout.variants:
		result = result
			.concat("case blorp_v_")
			.append_int(index)
			.concat("_")
			.append_int(position)
			.concat(":")
		var field_position = 0
		for value_type in fields:
			path = "value.payload.blorp_up_"
				.append_int(position)
				.concat(".blorp_uf_")
				.append_int(field_position)
			match append_storage_operation(result, value_type, action, path, unions, internal_span()):
				Ok(updated): result = updated
				Err(error):
					failure = Some(error)
					break
			field_position = IntOps.add(field_position, 1)
		if failure.is_some():
			break
		result = result.concat("break;")
		position = IntOps.add(position, 1)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(result.concat("}}"))


-- One counted node per constructed value: the compound literal's payload
-- already holds acquired children, so the node takes them without retains.
private pure func append_boxed_union_constructor(output: String, index: Int) -> String:
	node = boxed_union_struct(index)
	output
		.concat(node)
		.concat("* blorp_union_make_")
		.append_int(index)
		.concat("(")
		.concat(node)
		.concat(" fields){")
		.concat(node)
		.concat("* value=malloc(sizeof *value);if(!value)abort();")
		.concat("atomic_init(&value->references,UINT64_C(1));")
		.concat("value->tag=fields.tag;value->payload=fields.payload;return value;}")


private pure func append_boxed_union_retain(output: String, index: Int) -> String:
	output
		.concat("void blorp_union_dup_")
		.append_int(index)
		.concat("(")
		.concat(boxed_union_struct(index))
		.concat("* value){(void)atomic_fetch_add_explicit(&value->references,UINT64_C(1),memory_order_relaxed);}")


-- A boxed union is stored by pointer, so any layout may retain and release
-- it before its definition; its tag and helpers are declared up front with
-- the record and List prototypes.
private pure func append_boxed_union_prototypes(output: String, unions: List[ConcreteUnion]) -> String:
	var fragments: List[String] = [output]
	var index = 0

	for layout in unions:
		match layout.representation:
			BoxedRecursive:
				node = boxed_union_struct(index)
				fragments = fragments.append(
					node.concat(";void blorp_union_dup_").append_int(index).concat("(").concat(node)
						.concat("*);void blorp_union_drop_").append_int(index).concat("(").concat(node).concat("*);"),
				)
			InlineUnmanaged | InlineOwningPayload:
				void

		index = IntOps.add(index, 1)

	fragments.join("")


-- Final release walks the chain instead of recursing: a node whose count
-- reaches zero releases its other payloads, saves its one self child, is
-- freed, and the walk continues with that child while it also dies. C stack
-- use is therefore constant however deep the chain is.
private pure func append_boxed_union_release(
	output: String,
	layout: ConcreteUnion,
	index: Int,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	node = boxed_union_struct(index)
	var result = output
		.concat("void blorp_union_drop_")
		.append_int(index)
		.concat("(")
		.concat(node)
		.concat("* value){")
		.concat(node)
		.concat("* node=value;while(node!=NULL){")
		.concat("if(atomic_fetch_sub_explicit(&node->references,UINT64_C(1),memory_order_acq_rel)!=UINT64_C(1))return;")
		.concat(node)
		.concat("* child=NULL;switch(node->tag){")
	var position = 0
	var failure: Option[Diagnostic] = None

	for fields in layout.variants:
		result = result
			.concat("case blorp_v_")
			.append_int(index)
			.concat("_")
			.append_int(position)
			.concat(":")
		var field_position = 0
		for value_type in fields:
			path = "node->payload.blorp_up_"
				.append_int(position)
				.concat(".blorp_uf_")
				.append_int(field_position)
			self_child = match value_type:
				UnionType(id): IntOps.equals(union_number(id), index)
				_: False
			if self_child:
				result = result.concat("child=").concat(path).concat(";")
			else:
				match append_storage_operation(result, value_type, DestroyValue, path, unions, internal_span()):
					Ok(updated): result = updated
					Err(error):
						failure = Some(error)
						break
			field_position = IntOps.add(field_position, 1)
		if failure.is_some():
			break
		result = result.concat("break;")
		position = IntOps.add(position, 1)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(result.concat("}free(node);node=child;}}"))


private pure func append_union_ownership(
	output: String,
	layout: ConcreteUnion,
	index: Int,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	match layout.representation:
		InlineUnmanaged:
			Ok(output)
		InlineOwningPayload:
			match append_union_action(output, layout, index, unions, DuplicateValue):
				Ok(duplicated): append_union_action(duplicated, layout, index, unions, DestroyValue)
				Err(error): Err(error)
		BoxedRecursive:
			constructed = append_boxed_union_constructor(output, index)
			append_boxed_union_release(append_boxed_union_retain(constructed, index), layout, index, unions)


private pure func append_ownership_operation(
	output: String,
	operation: OwnershipOperation,
	unions: List[ConcreteUnion],
	types: List[TypeRef],
	records: List[ConcreteRecord],
) -> Result[String, Diagnostic]:
	match operation:
		DefineValue(definition):
			append_owned_definition(output, definition, unions, records)
		ExecuteJoin(matched_join):
			append_join(output, matched_join, unions, types, records)
		AcquireOwner(owner, borrowed, span):
			match types.get(owner_number(owner)):
				Some(value_type):
					match append_storage_operation(
						output,
						value_type,
						DuplicateValue,
						c_value(borrowed.value),
						unions,
						span,
					):
						Ok(retained): append_owner_alias(retained, owner, borrowed.value, value_type, unions, span)
						Err(error): Err(error)
				None: Err(render(span, MissingOwnerType(owner)))
		DropOwner(owner, span):
			match types.get(owner_number(owner)):
				Some(value_type): append_storage_operation(output, value_type, DestroyValue, c_owner(owner), unions, span)
				None: Err(render(span, MissingOwnerType(owner)))


private pure func append_ownership_operations(
	output: String,
	operations: List[OwnershipOperation],
	unions: List[ConcreteUnion],
	types: List[TypeRef],
	records: List[ConcreteRecord],
) -> Result[String, Diagnostic]:
	var fragments: List[String] = [output]
	var failure: Option[Diagnostic] = None

	for operation in operations:
		match append_ownership_operation("", operation, unions, types, records):
			Err(error):
				failure = Some(error)
				break
			Ok(emitted):
				fragments = fragments.append(emitted)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(fragments.join(""))


-- A switch on a match's scrutinee tag, up to its first case.
private pure func append_switch(
	output: String,
	scrutinee: OwnedArgument,
	owner: UnionInstanceId,
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[String, Diagnostic]:
	declaration ?= match unions.get(union_number(owner)):
		Some(found): Ok(found)
		None: Err(render(span, MissingUnionLayout(owner)))
	opening = output.concat("switch(").concat(c_value(argument_value(scrutinee)))

	if has_payload(declaration):
		Ok(opening.concat(union_member_selector(declaration)).concat("tag").concat("){"))
	else:
		Ok(opening.concat("){"))


-- Without a written default the final arm is also `default`, so every path
-- through the switch reaches an arm.
private pure func append_case(output: String, label: MatchLabel, final_default: Bool) -> String:
	var result = match label:
		VariantLabel(id):
			output
				.concat("case ")
				.concat(c_variant(id))
				.concat(":")
		DefaultLabel:
			output.concat("default:")

	if final_default:
		result = result.concat("default:")

	result


private pure func labels_have_default(labels: List[MatchLabel]) -> Bool:
	var found = False
	for label in labels:
		match label:
			DefaultLabel: found = True
			_: void
	found


-- One case of a switch: its label, its operations and the statements that
-- leave it.
private fixed record SwitchCase {
	label: MatchLabel,
	operations: List[OwnershipOperation],
	ending: String
}


-- A switch's cases after its opening, then its closing brace.
private pure func append_cases(
	opening: String,
	cases: List[SwitchCase],
	unions: List[ConcreteUnion],
	types: List[TypeRef],
	records: List[ConcreteRecord],
) -> Result[String, Diagnostic]:
	var fragments: List[String] = [opening]
	var labels: List[MatchLabel] = []

	for switch_case in cases:
		labels = labels.append(switch_case.label)

	has_default = labels_have_default(labels)
	var position: Int = 0
	var failure: Option[Diagnostic] = None

	for switch_case in cases:
		final_default = not has_default and IntOps.equals(IntOps.add(position, 1), cases.length())
		match append_ownership_operations(append_case("", switch_case.label, final_default).concat("{"), switch_case.operations, unions, types, records):
			Err(error):
				failure = Some(error)
				break
			Ok(body):
				fragments = fragments.append(body.concat(switch_case.ending).concat("}"))
		position = IntOps.add(position, 1)

	match failure:
		Some(error): Err(error)
		None: Ok(fragments.append("}").join(""))


private pure func append_match(
	matched: OwnedMatch,
	unions: List[ConcreteUnion],
	types: List[TypeRef],
	records: List[ConcreteRecord],
) -> Result[String, Diagnostic]:
	opening ?= append_switch("", matched.scrutinee, matched.owner, unions, internal_span())
	var cases: List[SwitchCase] = []
	for arm in matched.arms:
		cases = cases.append({ label = arm.label, operations = arm.operations, ending = append_exit("", arm.exit) })
	append_cases(opening, cases, unions, types, records)


-- A join's local is declared before its switch and assigned by each arm,
-- which then leaves the switch. A managed value moves in its owner, which
-- the join's own owner takes over after the switch.
private pure func append_join(
	output: String,
	matched_join: OwnedJoin,
	unions: List[ConcreteUnion],
	types: List[TypeRef],
	records: List[ConcreteRecord],
) -> Result[String, Diagnostic]:
	parameter = join_parameter(matched_join.result)
	name = c_value(parameter.id)
	declaration ?= c_local_declaration(parameter.value_type, JoinLocal, unions, parameter.span)
	opening ?= append_switch(output.concat(declaration).concat(name).concat(";"), matched_join.scrutinee, matched_join.owner, unions, parameter.span)
	var cases: List[SwitchCase] = []
	for arm in matched_join.arms:
		moved = match arm.transfer:
			UnmanagedReturn(value): c_value(value)
			OwnedReturn(_, owner): c_owner(owner)
		cases = cases.append({ label = arm.label, operations = arm.operations, ending = name.concat("=").concat(moved).concat(";break;") })
	switched ?= append_cases(opening, cases, unions, types, records)
	-- Like every value local, the join's is marked used: a statement match's
	-- Void local is assigned but never read.
	joined = switched.concat("(void)").concat(name).concat(";")
	match matched_join.result:
		UnmanagedJoinParameter(_):
			Ok(joined)
		ManagedJoinParameter(_, owner):
			append_owner_alias(joined, owner, parameter.id, parameter.value_type, unions, parameter.span)


private pure func append_signature(
	output: String,
	function: OwnedFunction,
	index: Int,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	type_name ?= c_type(function.signature.return_type, unions, internal_span())
	parameters ?= c_parameters(function.signature.parameters, unions)
	Ok(
		output
			.concat(type_name)
			.concat(" ")
			.concat(c_name(index))
			.concat(parameters),
	)


private pure func append_return(output: String, result: ReturnTransfer) -> String:
	value = match result:
		UnmanagedReturn(id):
			c_value(id)
		OwnedReturn(_, owner):
			c_owner(owner)

	output
		.concat("return ")
		.concat(value)
		.concat(";")


private pure func append_exit(output: String, exit: OwnedExit) -> String:
	match exit:
		ReturnResult(result):
			append_return(output, result)
		RecurArguments(arguments, _):
			var result = output
			var position: Int = 0

			-- Every operand is already an immutable value local. Replacing slots
			-- from these captures preserves swaps and repeated arguments.
			for argument in arguments:
				result = result
					.concat(c_parameter(position))
					.concat("=")
					.concat(c_value(argument))
					.concat(";")
				position = IntOps.add(position, 1)

			result.concat("continue;")


private pure func append_function(
	function: OwnedFunction,
	index: Int,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[String, Diagnostic]:
	header ?= append_signature("", function, index, unions)
	types ?= owner_types(function)

	opening = match function.execution:
		OrdinaryCalls:
			header.concat("{")
		SelfTailLoop(_):
			header.concat("{while (1){")

	body ?= append_ownership_operations("", function.operations, unions, types, records)

	tail ?= match function.tail:
		ReturnTail(exit):
			Ok(append_exit("", exit))
		MatchTail(matched):
			append_match(matched, unions, types, records)

	closing = match function.execution:
		OrdinaryCalls:
			"}"
		SelfTailLoop(_):
			"}}"

	Ok([opening, body, tail, closing].join(""))


-- Unsigned addition wraps. Both signed casts below receive representable values;
-- the negative branch also stays within Int64 at UINT64_MAX - sum == INT64_MAX.
INTEGER_ADD_RUNTIME: String =
	|static int64_t blorp_int_add(int64_t first,int64_t second){uint64_t sum=(uint64_t)first+(uint64_t)second;return sum<=INT64_MAX?(int64_t)sum:-INT64_C(1)-(int64_t)(UINT64_MAX-sum);}
	|

-- Convert wrapped unsigned bits using only representable signed casts. Division
-- and remainder guard both zero and the sole overflowing signed quotient.
INTEGER_ARITHMETIC_RUNTIME: String =
	|int64_t blorp_int_signed(uint64_t value){return value<=INT64_MAX?(int64_t)value:-INT64_C(1)-(int64_t)(UINT64_MAX-value);}
	|int64_t blorp_int_subtract(int64_t first,int64_t second){return blorp_int_signed((uint64_t)first-(uint64_t)second);}
	|int64_t blorp_int_multiply(int64_t first,int64_t second){return blorp_int_signed((uint64_t)first*(uint64_t)second);}
	|int64_t blorp_int_divide(int64_t first,int64_t second){if(second==0)return 0;if(first==INT64_MIN&&second==-1)return INT64_MIN;return first/second;}
	|int64_t blorp_int_remainder(int64_t first,int64_t second){if(second==0||(first==INT64_MIN&&second==-1))return 0;return first%second;}
	|


-- The type under any List layers. A String or Float there, anywhere in a record,
-- union or function that specialization kept, selects its ABI prelude even when
-- no value of it is ever built: a phantom type argument keeps its record
-- (blorp_2/test/e2e/fixtures/record/phantom_union_fields.brp).
private pure func innermost_element(value_type: TypeRef) -> TypeRef:
	match value_type:
		ListType(element): innermost_element(element)
		_: value_type


-- The scalar helper preludes a program selects, read from its inventory: a
-- String or Float type selects its ABI prelude, and each runtime operation called
-- selects its own helper. Allocation headers follow from the layouts and the
-- argument vector from the entrypoint, which already own those facts.
private fixed record RuntimeRequirements {
	current_directory: Bool,
	file_read: Bool,
	file_write: Bool,
	string_types: Bool,
	float_types: Bool,
	integer_addition: Bool,
	integer_arithmetic: Bool,
	string_output: Bool,
	string_error_output: Bool,
	integer_parsing: Bool,
	string_equality: Bool,
	string_concatenation: Bool,
	float_formatting: Bool,
	float_parsing: Bool
}


private pure func runtime_requirements(inventory: ProgramInventory) -> RuntimeRequirements:
	var requirements: RuntimeRequirements = {
		current_directory = False,
		file_read = False,
		file_write = False,
		string_types = False,
		float_types = False,
		integer_addition = False,
		integer_arithmetic = False,
		string_output = False,
		string_error_output = False,
		integer_parsing = False,
		string_equality = False,
		string_concatenation = False,
		float_formatting = False,
		float_parsing = False,
	}

	for value_type in inventory.types:
		match innermost_element(value_type):
			StringType: requirements = { requirements | string_types = True }
			FloatType: requirements = { requirements | float_types = True }
			_: void

	for operation in inventory.runtime_calls:
		match operation:
			ReadFile(_): requirements = { requirements | file_read = True }
			WriteFile(_): requirements = { requirements | file_write = True }
			GetCurrentDirectory(_): requirements = { requirements | current_directory = True }
			IntAdd: requirements = { requirements | integer_addition = True }
			IntSubtract | IntMultiply | IntDivide | IntRemainder:
				requirements = { requirements | integer_arithmetic = True }
			StringPrint: requirements = { requirements | string_output = True }
			StringPrintError: requirements = { requirements | string_error_output = True }
			StringParseInt(_): requirements = { requirements | integer_parsing = True }
			StringEquals(_): requirements = { requirements | string_equality = True }
			StringConcat: requirements = { requirements | string_concatenation = True }
			FloatToString: requirements = { requirements | float_formatting = True }
			StringParseFloat(_): requirements = { requirements | float_parsing = True }
			ListRepeat(_) | ListLength(_) | ListGet(_, _) | ListAppend(_) | ListSet(_) | ListConcat(_):
				void
			IntEquals(_) | FloatAdd | FloatSubtract | FloatMultiply | FloatDivide | FloatRemainder | IntToString | StringLength | StringByteAt(_) | StringFromCodepoint(_):
				void

	requirements


-- This table lives for one emission only. Its complete key is a projection
-- of concrete TypeRefs, not an ownership or layout authority. Stable sorting
-- and adjacent key equality avoid scanning existing helpers at each occurrence.
private fixed record ListLayout {
	element: TypeRef,
	key: ListElementKey
}


private pure func strip_list_layer(value_type: TypeRef) -> TypeRef:
	match value_type:
		ListType(element): element
		_: value_type


private pure func element_list_layouts(element: TypeRef) -> List[ListLayout]:
	var current = element
	var key = list_element_key(element)
	var remaining = list_key_depth(key)
	var layouts: List[ListLayout] = []
	layouts = layouts.append({ element = current, key = key })

	while IntOps.greater_than(remaining, 0):
		current = strip_list_layer(current)
		key = list_child_key(key)
		remaining = IntOps.subtract(remaining, 1)
		layouts = layouts.append({ element = current, key = key })

	layouts


private pure func type_list_layouts(value_type: TypeRef) -> List[ListLayout]:
	match value_type:
		ListType(element): element_list_layouts(element)
		_: []


-- A function's blocks in the order their values and owners are numbered:
-- its prefix, then each match arm, each block followed by its joins' arms.
-- Owner types and the program inventory walk exactly these blocks.
private pure func function_blocks(function: OwnedFunction) -> List[List[OwnershipOperation]]:
	var blocks = append_block([], function.operations)
	match function.tail:
		ReturnTail(_): void
		MatchTail(matched):
			for arm in matched.arms:
				blocks = append_block(blocks, arm.operations)
	blocks


private pure func append_block(
	blocks: List[List[OwnershipOperation]],
	operations: List[OwnershipOperation],
) -> List[List[OwnershipOperation]]:
	var collected = blocks.append(operations)
	for operation in operations:
		match operation:
			ExecuteJoin(join):
				for arm in join.arms:
					collected = append_block(collected, arm.operations)
			DefineValue(_) | AcquireOwner(_, _, _) | DropOwner(_, _):
				void
	collected


-- What emission inventories, found in one walk of the verified program: the
-- type of every declared field and payload and of every defined value, and
-- every runtime operation called. The list layouts read the types, the list
-- update helpers read the calls and the runtime requirements read both, so none
-- of them walks the program again. A signature type needs no entry of its own
-- because the verifier ties it to a defined value: a parameter's definition
-- takes its type from the signature, a call result must match the callee's
-- return type, and the returned value must match the function's.
private fixed record ProgramInventory {
	types: List[TypeRef],
	runtime_calls: List[RuntimeOperation[VariantInstanceId, TypeRef]]
}


private pure func program_inventory(program: OwnershipProgram) -> ProgramInventory:
	var types: List[TypeRef] = []
	var runtime_calls: List[RuntimeOperation[VariantInstanceId, TypeRef]] = []

	for layout in program.records:
		for field in layout.fields:
			types = types.append(field)

	for layout in program.unions:
		for fields in layout.variants:
			for value_type in fields:
				types = types.append(value_type)

	for function in program.functions:
		for block in function_blocks(function):
			for operation in block:
				match operation:
					DefineValue(definition):
						types = types.append(definition.value_type)
						match definition.operation:
							CallDefinition(call, _):
								match call.target:
									RuntimeFunction(runtime): runtime_calls = runtime_calls.append(runtime)
									_: void
							_: void
					ExecuteJoin(join):
						types = types.append(join_parameter(join.result).value_type)
					AcquireOwner(_, _, _) | DropOwner(_, _):
						void

	{ types = types, runtime_calls = runtime_calls }


private pure func list_layouts(inventory: ProgramInventory) -> List[ListLayout]:
	var layouts: List[ListLayout] = []

	for value_type in inventory.types:
		for layout in type_list_layouts(value_type):
			layouts = layouts.append(layout)

	ordered = layouts
		.sort_by(pure func(layout): list_key_ordinal(layout.key))
		.sort_by(pure func(layout): list_key_rank(layout.key))
		.sort_by(pure func(layout): list_key_depth(layout.key))
	var unique: List[ListLayout] = []
	var previous: Option[ListElementKey] = None
	for layout in ordered:
		duplicate = match previous:
			Some(key): same_list_key(key, layout.key)
			None: False
		if not duplicate:
			unique = unique.append(layout)
			previous = Some(layout.key)
	unique


-- An update helper is emitted only where its operation is called. The
-- helper list is deduplicated by scanning its own entries: there are at most
-- three per element layout, so the scan stays small for any call count.
private fixed record ListUpdateHelper {
	update: ListUpdate,
	layout: ListLayout
}


private pure func same_list_update(left: ListUpdate, right: ListUpdate) -> Bool:
	match left:
		AppendUpdate:
			match right:
				AppendUpdate: True
				_: False
		SetUpdate:
			match right:
				SetUpdate: True
				_: False
		ConcatUpdate:
			match right:
				ConcatUpdate: True
				_: False


private pure func update_helper(update: ListUpdate, element: TypeRef) -> ListUpdateHelper:
	{ update = update, layout = { element = element, key = list_element_key(element) } }


private pure func call_list_update(operation: RuntimeOperation[VariantInstanceId, TypeRef]) -> Option[ListUpdateHelper]:
	match operation:
		ListAppend(element): Some(update_helper(AppendUpdate, element))
		ListSet(element): Some(update_helper(SetUpdate, element))
		ListConcat(element): Some(update_helper(ConcatUpdate, element))
		_: None


private pure func list_update_helpers(inventory: ProgramInventory) -> List[ListUpdateHelper]:
	var unique: List[ListUpdateHelper] = []
	for operation in inventory.runtime_calls:
		match call_list_update(operation):
			None: void
			Some(helper):
				var known = False
				for existing in unique:
					if same_list_update(existing.update, helper.update) and same_list_key(existing.layout.key, helper.layout.key):
						known = True
						break
				if not known:
					unique = unique.append(helper)
	unique


private pure func append_list_prototypes(output: String, layouts: List[ListLayout]) -> String:
	if layouts.is_empty():
		output
	else:
		var fragments: List[String] = [output]
		for layout in layouts:
			suffix = list_suffix(layout.key)
			type_name = list_c_type(layout.key)
			fragment = "struct blorp_l_".concat(suffix).concat(";")
				.concat("void blorp_list_dup_").concat(suffix).concat("(").concat(type_name).concat(");")
				.concat("void blorp_list_drop_").concat(suffix).concat("(").concat(type_name).concat(");")
			fragments = fragments.append(fragment)
		fragments.join("")


-- The element C type and the stored-occurrence fragments every helper of one
-- List layout stores and destroys through.
private fixed record ElementFragments {
	type_name: String,
	acquire: String,
	destroy: String
}


private pure func element_fragments(
	layout: ListLayout,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[ElementFragments, Diagnostic]:
	-- Nested helpers use the precomputed suffix key. Rewalking the TypeRef at
	-- every suffix would make a single deeply nested List require quadratic work.
	if IntOps.greater_than(list_key_depth(layout.key), 0):
		child = list_child_key(layout.key)
		suffix = list_suffix(child)
		Ok({
			type_name = list_c_type(child),
			acquire = "blorp_list_dup_".concat(suffix).concat("(element);"),
			destroy = "blorp_list_drop_".concat(suffix).concat("(element);"),
		})
	else:
		match c_type(layout.element, unions, internal_span()):
			Ok(type_name):
				match value_ownership(layout.element, unions, records):
					Ok(ownership):
						acquire_result: Result[String, Diagnostic] = match ownership:
							NoOwnership: Ok("")
							_: append_storage_operation("", layout.element, DuplicateValue, "element", unions, internal_span())
						match acquire_result:
							Ok(acquire):
								destroy_result: Result[String, Diagnostic] = match ownership:
									NoOwnership: Ok("")
									_: append_storage_operation("", layout.element, DestroyValue, "element", unions, internal_span())
								match destroy_result:
									Ok(destroy): Ok({ type_name = type_name, acquire = acquire, destroy = destroy })
									Err(error): Err(error)
							Err(error): Err(error)
					Err(error): Err(error)
			Err(error): Err(error)


private pure func list_runtime_fragment(
	layout: ListLayout,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[String, Diagnostic]:
	element ?= element_fragments(layout, unions, records)
	Ok(list_runtime(layout.key, element.type_name, element.acquire, element.destroy))


private pure func append_list_updates(
	output: String,
	helpers: List[ListUpdateHelper],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[String, Diagnostic]:
	if helpers.is_empty():
		Ok(output)
	else:
		var fragments: List[String] = [output]
		var failure: Option[Diagnostic] = None
		-- At most three helpers share one layout, so recomputing its few
		-- fragments costs less than keying them from the layout table.
		for helper in helpers:
			match element_fragments(helper.layout, unions, records):
				Err(error):
					failure = Some(error)
					break
				Ok(element):
					fragments = fragments.append(list_update_runtime(helper.update, helper.layout.key, element.type_name, element.acquire))
		match failure:
			Some(error): Err(error)
			None: Ok(fragments.join("\n"))


private pure func append_list_runtime(
	output: String,
	layouts: List[ListLayout],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[String, Diagnostic]:
	if layouts.is_empty():
		Ok(output)
	else:
		var fragments: List[String] = [output]
		var failure: Option[Diagnostic] = None
		for layout in layouts:
			fragment = list_runtime_fragment(layout, unions, records)
			match fragment:
				Err(error):
					failure = Some(error)
					break
				Ok(completed):
					fragments = fragments.append(completed)
		match failure:
			Some(error): Err(error)
			None: Ok(fragments.join("\n"))


private pure func aggregate_runtime_contents(
	checked: OwnershipProgram,
	lists: List[ListLayout],
	helpers: List[ListUpdateHelper],
) -> Result[String, Diagnostic]:
	-- The host copies a `var` list on each append after a `?=` that follows its declaration.
	-- Both `?=` therefore precede `fragments`; `ready ?=` follows the loops and costs one copy.
	ordered ?= append_aggregate_definitions(checked.records, checked.unions)
	completed ?= append_list_runtime("", lists, checked.unions, checked.records)
	updates ?= append_list_updates("", helpers, checked.unions, checked.records)
	var fragments: List[String] = [append_list_prototypes("", lists)]
	var index: Int = 0

	-- Complete declarations and helper groups end physical C lines so GCC can
	-- retain column tracking and its diagnostics for the generated runtime.
	for layout in checked.records:
		typedef_prefix: String = "typedef struct blorp_r_"
			.append_int(index)
		pointer_marker: String = match layout.representation:
			InlineRecord:
				" "
			ManagedRecord:
				"* "
		fragments = fragments.append(typedef_prefix
			.concat(pointer_marker)
			.concat("blorp_r_")
			.append_int(index)
			.concat(";\n"))
		index = IntOps.add(index, 1)

	index = 0

	for _ in checked.records:
		fragments = fragments.append(append_record_prototypes("", index).concat("\n"))
		index = IntOps.add(index, 1)

	fragments = fragments.append(append_boxed_union_prototypes("", checked.unions))
	fragments = fragments.append(ordered)
	index = 0
	var failure: Option[Diagnostic] = None

	for layout in checked.records:
		match append_record_ownership("", layout, index, checked.unions):
			Ok(ownership):
				fragments = fragments.append(ownership.concat("\n"))
			Err(error):
				failure = Some(error)
				break

		index = IntOps.add(index, 1)

	ready ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	arguments = match checked.entrypoint:
		WithArguments(_, _): arguments_runtime()
		NoArguments(_, _): ""
	fragments = fragments.concat([completed, updates, arguments])
	Ok(fragments.join(""))


-- Boxed union nodes need the allocation and atomic headers like managed records.
private pure func has_boxed_union(unions: List[ConcreteUnion]) -> Bool:
	var boxed = False

	for layout in unions:
		match layout.representation:
			BoxedRecursive:
				boxed = True
				break
			InlineUnmanaged | InlineOwningPayload:
				void

	boxed


pure func aggregate_runtime(program: VerifiedProgram) -> Result[String, Diagnostic]:
	checked = verified_contents(program)
	inventory = program_inventory(checked)
	aggregate_runtime_contents(checked, list_layouts(inventory), list_update_helpers(inventory))


pure func emit(program: VerifiedProgram) -> Result[String, Diagnostic]:
	checked = verified_contents(program)
	records = checked.records
	inventory = program_inventory(checked)
	requirements = runtime_requirements(inventory)
	lists = list_layouts(inventory)
	aggregates ?= aggregate_runtime_contents(checked, lists, list_update_helpers(inventory))

	-- C is collected as fragments and joined once; appending each one to the
	-- whole output would copy everything emitted so far at every step. The host
	-- compiler copies a `var` list on every append that comes after a `?=`
	-- placed between the list's declaration and that append, so no `?=` may sit
	-- between this declaration and the loops below.
	prelude = if requirements.string_types:
		string_runtime()
	else:
		"#include <stdint.h>\n"
	var fragments: List[String] = [prelude]

	if (
		not lists.is_empty() or checked.records.any(pure func(layout):
			match layout.representation:
				ManagedRecord:
					True
				InlineRecord:
					False
		) or has_boxed_union(checked.unions)
	):
		fragments = fragments.append("#include <stdlib.h>\n#include <stdatomic.h>\n")

	if requirements.float_types:
		fragments = fragments.append(float_runtime())

	if requirements.float_formatting:
		fragments = fragments.append(float_string_runtime())

	if requirements.float_parsing:
		fragments = fragments.append(float_parse_runtime())

	if requirements.integer_addition:
		fragments = fragments.append(INTEGER_ADD_RUNTIME)

	if requirements.integer_arithmetic:
		fragments = fragments.append(INTEGER_ARITHMETIC_RUNTIME)

	if requirements.string_output:
		fragments = fragments.append(string_print_runtime())

	if requirements.string_error_output:
		fragments = fragments.append(STRING_PRINT_ERROR_RUNTIME)

	if requirements.file_read:
		fragments = fragments.append(SYSTEM_READ_FILE_RUNTIME)

	if requirements.file_write:
		fragments = fragments.append(SYSTEM_WRITE_FILE_RUNTIME)

	if requirements.current_directory:
		fragments = fragments.append(SYSTEM_CURRENT_DIRECTORY_RUNTIME)

	if requirements.integer_parsing:
		fragments = fragments.append(string_parse_int_runtime())

	if requirements.string_equality:
		fragments = fragments.append(string_equals_runtime())

	if requirements.string_concatenation:
		fragments = fragments.append(STRING_CONCAT_RUNTIME)

	fragments = fragments.append(aggregates)
	var index: Int = 0
	var failure: Option[Diagnostic] = None

	index = 0

	for function in checked.functions:
		match append_signature("", function, index, checked.unions):
			Err(error):
				failure = Some(error)
				break
			Ok(signature):
				fragments = fragments.append(signature.concat(";"))

		index = IntOps.add(index, 1)

	if not failure.is_some():
		index = 0

		for function in checked.functions:
			match append_function(function, index, checked.unions, records):
				Err(error):
					failure = Some(error)
					break
				Ok(function_code):
					fragments = fragments.append(function_code)

			index = IntOps.add(index, 1)

	match failure:
		Some(error):
			Err(error)
		None:
			output = fragments.join("")
			name = c_name(function_number(entry_function(checked.entrypoint)))

			wrapper = match checked.entrypoint:
				NoArguments(_, IntegerExitStatus):
					output
						.concat("int main(void){return (int)")
						.concat(name)
						.concat("();}\n")
				NoArguments(_, SuccessfulExit):
					output
						.concat("int main(void){(void)")
						.concat(name)
						.concat("();return 0;}\n")
				WithArguments(_, result):
					prefix = output.concat(
						"int main(int argc,char **argv){struct blorp_l_0_s *const blorp_arguments=blorp_list_from_argv(argc,argv);",
					).concat(
						"if(blorp_arguments==NULL){fputs(\"error: command-line argument is not valid UTF-8\\nhelp: pass UTF-8 encoded arguments\\n\",stderr);return 1;}",
					)

					match result:
						IntegerExitStatus:
							prefix
								.concat("const int64_t blorp_result=")
								.concat(name)
								.concat(
									"(blorp_arguments);blorp_list_drop_0_s(blorp_arguments);return (int)blorp_result;}\n",
								)
						SuccessfulExit:
							prefix
								.concat("(void)")
								.concat(name)
								.concat(
									"(blorp_arguments);blorp_list_drop_0_s(blorp_arguments);return 0;}\n",
								)

			Ok(wrapper)
