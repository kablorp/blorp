import:
	option: Option methods_only
	result: Result methods_only
	bool: not, and, or
	../namespace/builtins:
		DesignatedBoolean,
		DesignatedOption,
		DesignatedResult,
		RuntimeOperation(
			FloatCopySign, FloatEquals, FloatLessThan, FloatIsNaN, FloatIsFinite,
			IntAdd, IntSubtract, IntMultiply, IntDivide, IntRemainder, IntToString, StringLength, StringConcat, StringAppendInt,
			StringPrint, StringPrintError, StringParseInt, StringParseFloat, ListRepeat, ListLength, ListGet, ListAppend, ListSet,
			StringByteAt, StringFromCodepoint, StringSlice, GetCurrentDirectory, ReadFile, WriteFile, RunToFiles,
			ListConcat, StringEquals,
			IntEquals, IntLessThan, FloatAdd, FloatSubtract, FloatMultiply, FloatDivide, FloatRemainder,
			FloatToString,
		),
	./float_literal: c_float_literal
	./diagnostics:
		AggregateKind(RecordAggregate, UnionAggregate),
		EmissionFailure(
			MissingUnionLayout, MissingRecordLayout, MissingOwnerType, MissingValueType,
			MissingRuntimeArgument, MissingJoinTransfer, StatementOnlyValue, MissingAggregateWorkItem,
			MissingAggregateVisit, CyclicByValueAggregate, MissingAggregateLayout,
			MissingAggregateMember, MissingUnionPayloadField,
		), render,
	../runtime/float: float_parse_runtime, float_runtime, float_string_runtime
	../runtime/system: SYSTEM_CURRENT_DIRECTORY_RUNTIME, SYSTEM_READ_FILE_RUNTIME, SYSTEM_WRITE_FILE_RUNTIME
	../runtime/string_concat: STRING_CONCAT_RUNTIME, STRING_APPEND_INT_RUNTIME
	../runtime/memory: MEMORY_RUNTIME
	../runtime/process: PROCESS_POSIX_PRELUDE, process_runtime
	int: INT_MIN, Int methods_only
	../runtime/list:
		ListElementKey, ListUpdate(AppendUpdate, SetUpdate, ConcatUpdate, SuffixUpdate), arguments_runtime,
		callable_suffix, list_c_type, list_child_key, list_element_key, list_key_depth, list_key_ordinal,
		list_key_rank, list_key_is_callable, list_root_allocation, list_runtime, list_slot_store, list_suffix,
		list_update_name, list_update_runtime, same_list_key, LIST_CAPACITY_RUNTIME
	../lower/lower as Lower: ValueId, value_number
	../check/model: MatchArmId, DecisionNodeId, match_arm_number, decision_node_number, ListLengthTest(ExactLength, MinimumLength)
	../own/own as Own:
		OwnedArgument(UnmanagedArgument, BorrowedArgument, ConsumedArgument),
		OwnedDefinition,
		OwnedFunction,
		OwnedJoin,
		OwnedJoinParameter(UnmanagedJoinParameter, ManagedJoinParameter),
		join_parameter,
		OwnedValueOperation(
			ParameterDefinition, VoidDefinition, IntegerDefinition, FloatDefinition,
			StringDefinition, CallDefinition, InvokeCallableDefinition, FreeCallableDefinition, CapturedCallableDefinition, ConstructDefinition, ConstructListDefinition,
			PayloadDefinition, ListElementDefinition, ListSuffixDefinition, ConstructRecordDefinition, ReadRecordFieldDefinition,
		),
		OwnerId,
		OwnershipOperation(DefineValue, ExecuteJoin, ExecuteLoop, AcquireOwner, DropOwner),
		OwnershipProgram,
		ResultOwnership(UnmanagedResult, BorrowedResult, OwnedResult),
		ReturnTransfer(UnmanagedReturn, OwnedReturn),
		StoredPayload(UnmanagedPayload, OwnedPayload),
		owner_number,
	../utils/source: compiler_source
	../specialize/specialize as Concrete:
		CallTarget(UserFunction, RuntimeFunction),
		ConcreteRecord(InlineFields, CountedFields), ConcretePatternPlace,
		ConcreteUnion(PlainCases, OwningCases, BoxedCases),
		FieldInstanceId,
		RecordInstanceId,
		TypeRef(VoidType, IntType, FloatType, StringType, ListType, CallableType, UnionType, RecordType),
		UnionInstanceId,
		VariantInstanceId, variant_field_variant, variant_field_number,
		field_number,
		field_owner,
		function_number,
		record_fields,
		record_number,
		union_number,
		union_variants,
		variant_number,
		variant_owner,
		value_needs_ownership,
	string: String methods_only
	../runtime/string:
		string_equals_runtime,
		STRING_SLICE_RUNTIME,
		string_parse_int_runtime,
		string_print_runtime, STRING_PRINT_ERROR_RUNTIME,
		string_runtime,
	../utils/syntax:
		Diagnostic,
		EntryResult(IntegerExitStatus, SuccessfulExit),
		Entrypoint(NoArguments, WithArguments),
		Span,
		entry_function,
	../utils/text: concat
	../verify/verify: VerifiedProgram, verified_contents


-- Type and layout products have no source occurrence; this marks that origin.
private pure func internal_span() -> Span:
	{
		source = compiler_source(),
		start = 0,
		end = 0
	}


private pure func c_parameter(index: Int) -> String:
	"blorp_p_".append_int(index)


private pure func c_name(index: Int) -> String:
	"blorp_f_".append_int(index)


private pure func c_value(id: ValueId) -> String:
	"blorp_vl_".append_int(value_number(id))


private pure func c_header(id: ValueId) -> String:
	"blorp_h_".append_int(value_number(id))


private pure func c_loop_header(target: Lower.LoopTarget) -> String:
	"blorp_loop_${value_number(Lower.loop_target_value(target)).to_string()}_header"


private pure func c_loop_break(target: Lower.LoopTarget) -> String:
	"blorp_loop_${value_number(Lower.loop_target_value(target)).to_string()}_break"


private pure func c_loop_transfer(target: Lower.LoopTarget, position: Int) -> String:
	"blorp_loop_${value_number(Lower.loop_target_value(target)).to_string()}_transfer_${position.to_string()}"


private pure func c_owner(id: OwnerId) -> String:
	"blorp_owner_".append_int(owner_number(id))


-- Designated-Bool operations use statement dispatch and constructor publication,
-- not the ordinary expression-callable symbol path.
private pure func c_callable(target: CallTarget) -> Option[String]:
	match target:
		UserFunction(id):
			Some(c_name(function_number(id)))
		RuntimeFunction(operation):
			match operation:
				StringPrint:
					Some("blorp_string_print")
				StringPrintError:
					Some("blorp_string_print_error")
				IntAdd:
					Some("blorp_int_add")
				IntSubtract:
					Some("blorp_int_subtract")
				IntMultiply:
					Some("blorp_int_multiply")
				IntDivide:
					Some("blorp_int_divide")
				IntRemainder:
					Some("blorp_int_remainder")
				IntToString:
					Some("blorp_int_to_string")
				FloatAdd:
					Some("blorp_float_add")
				FloatSubtract:
					Some("blorp_float_subtract")
				FloatMultiply:
					Some("blorp_float_multiply")
				FloatDivide:
					Some("blorp_float_divide")
				FloatRemainder:
					Some("blorp_float_remainder")
				FloatToString:
					Some("blorp_float_to_string")
				FloatCopySign:
					Some("copysign")
				StringLength:
					Some("blorp_string_length")
				StringConcat:
					Some("blorp_string_concat")
				StringAppendInt:
					Some("blorp_string_append_int")
				StringParseInt(_):
					Some("blorp_string_parse_int")
				StringParseFloat(_):
					Some("blorp_string_parse_float")
				StringByteAt(_):
					Some("blorp_string_byte_at")
				StringFromCodepoint(_):
					Some("blorp_string_from_codepoint")
				StringSlice(_):
					Some("blorp_string_slice")
				RunToFiles(_):
					Some("blorp_process_run_to_files")
				ReadFile(_):
					Some("blorp_read_file")
				WriteFile(_):
					Some("blorp_write_file")
				GetCurrentDirectory(_):
					Some("blorp_get_current_directory")
				ListRepeat(element):
					Some("blorp_list_repeat_${list_suffix(list_element_key(element))}")
				ListLength(element):
					Some("blorp_list_length_${list_suffix(list_element_key(element))}")
				ListGet(element, _):
					Some("blorp_list_get_${list_suffix(list_element_key(element))}")
				ListAppend(element):
					Some(list_update_name(AppendUpdate, list_element_key(element)))
				ListSet(element):
					Some(list_update_name(SetUpdate, list_element_key(element)))
				ListConcat(element):
					Some(list_update_name(ConcatUpdate, list_element_key(element)))
				StringEquals(_) | IntEquals(_) | IntLessThan(_) | FloatEquals(_) | FloatLessThan(_) | FloatIsNaN(_) | FloatIsFinite(_):
					None


private pure func append_integer(output: String, value: Int) -> String:
	if value == INT_MIN:
		"${output}INT64_MIN"
	else if value.less_than(0):
		"${output}(-INT64_C(${0.subtract(value).to_string()}))"
	else:
		"${output}INT64_C(${value.to_string()})"


-- Function-local static data has fixed syntactic depth and no C string-token
-- length limit or automatic array storage. Existing ValueIds distinguish the
-- backing bytes; each evaluation still constructs an ordinary fresh String.
private pure func c_literal_bytes(id: ValueId) -> String:
	"blorp_bytes_".append_int(value_number(id))


private pure func append_string_bytes(output: String, id: ValueId, bytes: String) -> String:
	append_byte_array(output, c_literal_bytes(id), bytes)


private pure func append_byte_array(output: String, name: String, bytes: String) -> String:
	var projected = "${output}static const unsigned char ${name}[]={"
	var position = 0

	while True:
		match bytes.byte_at(position):
			Some(byte):
				if position.greater_than(0):
					projected = "${projected},"

				projected = projected.append_int(byte)
				position = position.add(1)
			None:
				break

	if position == 0:
		-- ISO C forbids an empty initializer; logical length remains zero.
		projected = "${projected}0"

	"${projected}};"


private pure func has_payload(declaration: ConcreteUnion) -> Bool:
	union_variants(declaration).any(pure func(fields): fields.is_empty().not())


private pure func boxed_union_struct(index: Int) -> String:
	"struct blorp_u_".append_int(index)


private pure func union_is_boxed(layout: ConcreteUnion) -> Bool:
	match layout:
		BoxedCases(_): True
		PlainCases(_) | OwningCases(_): False


-- A boxed union value is a pointer to its counted node.
private pure func union_c_type(id: UnionInstanceId, declaration: ConcreteUnion) -> String:
	match union_is_boxed(declaration):
		True:
			"${boxed_union_struct(union_number(id))}*"
		False:
			prefix = if has_payload(declaration):
				"struct blorp_u_"
			else:
				"enum blorp_u_"

			prefix.append_int(union_number(id))


-- Every value local is const except a join's, which its arms assign.
private fixed union LocalAssignment:
	InitializedLocal
	JoinLocal


-- A local holding a pointer is itself const, so const follows a pointer type.
-- String, List and boxed union carriers spell their pointer in the C type.
private pure func c_local_declaration(
	value_type: TypeRef,
	assignment: LocalAssignment,
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[String, Diagnostic]:
	type_name ?= c_type(value_type, unions, span)
	pointer_carrier: Bool ?= match value_type:
		StringType | ListType(_):
			Ok(True)
		UnionType(id):
			match unions.get(union_number(id)):
				None:
					Err(render(span, MissingUnionLayout(id)))
				Some(layout):
					Ok(union_is_boxed(layout))
		_:
			Ok(False)
	declaration: String = match assignment:
		JoinLocal:
			"${type_name} "
		InitializedLocal:
			if pointer_carrier:
				"${type_name} const "
			else:
				"const ${type_name} "
	Ok(declaration)


private pure func record_c_type(id: RecordInstanceId) -> String:
	"blorp_r_".append_int(record_number(id))


private pure func c_field(id: FieldInstanceId) -> String:
	"blorp_rf_${record_number(field_owner(id)).to_string()}_${field_number(id).to_string()}"


private pure func append_record(
	output: String,
	layout: ConcreteRecord,
	index: Int,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	var result = "${output}struct blorp_r_${index.to_string()}{"

	match layout:
		CountedFields(_):
			result = "${result}_Atomic uint64_t references;"
		InlineFields(_):
			void

	var position = 0
	var invalid: Option[Diagnostic] = None

	for field in record_fields(layout):
		match field:
			VoidType:
				position = position.add(1)
				continue
			_: void
		match c_type(field, unions, internal_span()):
			Ok(name):
				result = "${result}${name} blorp_rf_${index.to_string()}_${position.to_string()};"
			Err(error):
				invalid = Some(error)
				break

		position = position.add(1)

	match invalid:
		Some(error):
			Err(error)
		None:
			Ok("${result}};")


-- These names serialize already sealed concrete types. Equality and catalogue
-- deduplication use TypeRefs, never the generated C spelling.
private pure func callable_c_type(parameters: List[TypeRef], result: TypeRef) -> String:
	"struct blorp_c_${callable_suffix(parameters, result)}"


private pure func callable_entry_name(body: Concrete.FunctionInstanceId, value_type: TypeRef) -> String:
	"blorp_ce_${function_number(body).to_string()}_${list_suffix(list_element_key(value_type))}"


private pure func callable_types(values: List[TypeRef]) -> List[TypeRef]:
	var found: List[TypeRef] = []
	for value in values:
		match value:
			ListType(element):
				for child in callable_types([element]):
					if found.any(pure func(other): Concrete.same_type(child, other)).not():
						found = found.append(child)
			CallableType(parameters, result):
				if found.any(pure func(other): Concrete.same_type(value, other)).not():
					found = found.append(value)
				for child in callable_types(parameters.append(result)):
					if found.any(pure func(other): Concrete.same_type(child, other)).not():
						found = found.append(child)
			_: void
	found


private pure func callable_parameters(parameters: List[TypeRef], unions: List[ConcreteUnion]) -> Result[String, Diagnostic]:
	var output = "(void* environment"
	var failure: Option[Diagnostic] = None
	var ordinal = 0
	for parameter in parameters:
		match c_type(parameter, unions, internal_span()):
			Ok(name): output = "${output},${name} ${c_parameter(ordinal)}"
			Err(error):
				failure = Some(error)
				break
		ordinal = ordinal.add(1)
	match failure:
		Some(error): Err(error)
		None: Ok("${output})")


-- Complete every pair before any aggregate or function ABI mentions it. Ops
-- tags may be incomplete here; their function members follow aggregate bodies.
private pure func callable_declarations(types: List[TypeRef]) -> String:
	var fragments: List[String] = []
	for value in types:
		match value:
			CallableType(parameters, result):
				suffix = callable_suffix(parameters, result)
				name = callable_c_type(parameters, result)
				ops_forward = "struct blorp_co_${suffix};"
				pair_definition = "${name}{const struct blorp_co_${suffix}* ops;void* environment;};"
				retain_declaration = "void blorp_callable_dup_${suffix}(${name});"
				drop_declaration = "void blorp_callable_drop_${suffix}(${name});\n"
				fragments = fragments.append(ops_forward.concat(pair_definition).concat(retain_declaration).concat(drop_declaration))
			_: void
	fragments.join("")


private pure func callable_ops(types: List[TypeRef], unions: List[ConcreteUnion]) -> Result[String, Diagnostic]:
	var fragments: List[String] = []
	var failure: Option[Diagnostic] = None
	for value in types:
		match value:
			CallableType(parameters, result):
				signature: Result[String, Diagnostic] = c_type(result, unions, internal_span()).and_then(pure func(returned):
					callable_parameters(parameters, unions).map(pure func(arguments):
						suffix = callable_suffix(parameters, result)
						name = callable_c_type(parameters, result)
						ops_definition = "struct blorp_co_${suffix}{${returned} (*invoke)${arguments};void (*retain)(void*);void (*drop)(void*);};"
						retain_definition = "void blorp_callable_dup_${suffix}(${name} value){value.ops->retain(value.environment);}"
						drop_definition = "void blorp_callable_drop_${suffix}(${name} value){value.ops->drop(value.environment);}\n"
						ops_definition.concat(retain_definition).concat(drop_definition)
					)
				)
				match signature:
					Ok(text): fragments = fragments.append(text)
					Err(error): failure = Some(error)
			_: void
		if failure.is_some():
			break
	match failure:
		Some(error): Err(error)
		None: Ok(fragments.join(""))


private pure func append_callable_entry(
	definition: OwnedDefinition, program: OwnershipProgram,
) -> Result[String, Diagnostic]:
	selected: Result[Concrete.FunctionInstanceId, Diagnostic] = match definition.operation:
		FreeCallableDefinition(id): Ok(id)
		CapturedCallableDefinition(id, _): Ok(id)
		_: Err(render(definition.span, StatementOnlyValue(definition.id)))
	body ?= selected
	function ?= program.functions.get(function_number(body)).to_result(render(definition.span, MissingValueType(definition.id)))
	match definition.value_type:
		CallableType(parameters, result):
			name = callable_entry_name(body, definition.value_type)
			match c_type(result, program.unions, definition.span):
				Err(error): Err(error)
				Ok(returned):
					match callable_parameters(parameters, program.unions):
						Err(error): Err(error)
						Ok(arguments):
							var invocation = "${c_name(function_number(body))}("
							var retain = "(void)environment;"
							var drop = retain
							var prefix = "(void)environment;"
							match definition.operation:
								CapturedCallableDefinition(_, _):
									match function.signature.parameters.get(0):
										Some(RecordType(owner)):
											cast = "(${record_c_type(owner)})environment"
											invocation = invocation.concat(cast)
											retain = "blorp_record_dup_${record_number(owner).to_string()}(${cast});"
											drop = "blorp_record_drop_${record_number(owner).to_string()}(${cast});"
											prefix = ""
										_: void
								_: void
							var separator: Bool = match definition.operation:
								CapturedCallableDefinition(_, _): True
								_: False
							var ordinal = 0
							for _ in parameters:
								if separator:
									invocation = "${invocation},"
								invocation = invocation.concat(c_parameter(ordinal))
								separator = True
								ordinal = ordinal.add(1)
							invoke_adapter = "${returned} ${name}_invoke${arguments}{${prefix}return ${invocation});}"
							retain_adapter = "void ${name}_retain(void* environment){${retain}}"
							drop_adapter = "void ${name}_drop(void* environment){${drop}}"
							ops_type = "const struct blorp_co_${callable_suffix(parameters, result)} ${name}"
							ops_initializer = "${ops_type}={${name}_invoke,${name}_retain,${name}_drop};\n"
							Ok(invoke_adapter.concat(retain_adapter).concat(drop_adapter).concat(ops_initializer))
		_: Err(render(definition.span, StatementOnlyValue(definition.id)))


private pure func c_type(
	type_ref: TypeRef,
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[String, Diagnostic]:
	match type_ref:
		RecordType(id):
			Ok(record_c_type(id))
		VoidType:
			Ok("uint8_t")
		IntType:
			Ok("int64_t")
		FloatType:
			Ok("double")
		StringType:
			Ok("struct blorp_string*")
		CallableType(parameters, result): Ok(callable_c_type(parameters, result))
		ListType(element):
			Ok(list_c_type(list_element_key(element)))
		UnionType(id):
			match unions.get(union_number(id)):
				Some(declaration): Ok(union_c_type(id, declaration))
				None: Err(render(span, MissingUnionLayout(id)))


private pure func c_variant(id: VariantInstanceId) -> String:
	"blorp_v_${union_number(variant_owner(id)).to_string()}_${variant_number(id).to_string()}"


private pure func c_parameters(
	parameters: List[TypeRef],
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	if parameters.length() == 0:
		Ok("(void)")
	else:
		var output: String = "("
		var index: Int = 0
		var invalid: Option[Diagnostic] = None

		for parameter in parameters:
			match c_type(parameter, unions, internal_span()):
				Err(error):
					invalid = Some(error)
					break
				Ok(name):
					if index.greater_than(0):
						output = "${output},"

					output = "${output}${name} ${c_parameter(index)}"

			index = index.add(1)

		match invalid:
			Some(error):
				Err(error)
			None:
				Ok("${output})")


-- Inline unions are read by value; boxed unions through their node pointer.
private pure func union_member_selector(declaration: ConcreteUnion) -> String:
	match union_is_boxed(declaration):
		True: "->"
		False: "."


private pure func c_payload(id: VariantInstanceId) -> String:
	"blorp_up_".append_int(variant_number(id))


private pure func c_payload_field(variant: VariantInstanceId, position: Int) -> String:
	"${c_payload(variant)}.blorp_uf_${position.to_string()}"


private pure func append_union(
	output: String,
	declaration: ConcreteUnion,
	index: Int,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	variants = union_variants(declaration)
	payload = has_payload(declaration)

	prefix = if payload:
		"enum blorp_tag_"
	else:
		"enum blorp_u_"

	var result = "${output}${prefix}${index.to_string()}{"
	var position: Int = 0

	for shape in variants:
		if position != 0:
			result = "${result},"

		result = "${result}blorp_v_${index.to_string()}_${position.to_string()}"
		position = position.add(1)

	result = "${result}};"

	if payload:
		struct_prefix: String = "${result}struct blorp_u_${index.to_string()}{"
		reference_header: String = match union_is_boxed(declaration):
			True: "_Atomic uint64_t references;"
			False: ""
		result = "${struct_prefix}${reference_header}enum blorp_tag_${index.to_string()} tag;union{"
		position = 0
		var failure: Option[Diagnostic] = None

		for fields in variants:
			if fields.is_empty().not():
				result = "${result}struct{"
				var field_position = 0
				for value_type in fields:
					match c_type(value_type, unions, internal_span()):
						Err(error):
							failure = Some(error)
							break
						Ok(name):
							result = "${result}${name} blorp_uf_${field_position.to_string()};"
					field_position = field_position.add(1)
				if failure.is_some():
					break
				result = "${result}} blorp_up_${position.to_string()};"
			position = position.add(1)

		match failure:
			Some(error):
				Err(error)
			None:
				append_union_ownership(
					"${result}}payload;};",
					declaration,
					index,
					unions,
				)
	else:
		Ok(result)


private fixed union AggregateDefinition:
	RecordDefinition(Int)
	UnionDefinition(Int)


private fixed union AggregateVisit:
	UnvisitedAggregate
	VisitingAggregate
	EmittedAggregate


private fixed union AggregateVisitStep:
	PrepareAggregate(AggregateDefinition)
	EmitAggregate(AggregateDefinition)


private pure func push_aggregate_visit(
	steps: List[AggregateVisitStep],
	depth: Int,
	step: AggregateVisitStep,
) -> List[AggregateVisitStep]:
	if depth.less_than(steps.length()):
		steps.set(depth, step)
	else:
		steps.append(step)


-- Whether a stored type must be defined before its parent: only storage by
-- value (an inline record or inline union) is a definition dependency. A
-- managed record, a boxed union and a List are pointers to forward-declared
-- types, which is what lets a layout group refer back to itself.
private pure func stored_by_value(value_type: TypeRef, records: List[ConcreteRecord], unions: List[ConcreteUnion]) -> Option[AggregateDefinition]:
	match value_type:
		RecordType(id):
			match records.get(record_number(id)):
				Some(layout):
					match layout:
						InlineFields(_): Some(RecordDefinition(record_number(id)))
						CountedFields(_): None
				None: None
		UnionType(id):
			match unions.get(union_number(id)):
				Some(layout):
					match union_is_boxed(layout):
						False: Some(UnionDefinition(union_number(id)))
						True: None
				None: None
		_:
			None


private pure func append_aggregate_definitions(
	records: List[ConcreteRecord],
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	-- State vectors and fragments remain local owners while dependencies are
	-- visited. No recursive carrier retains their previous roots.
	var record_visits = records.map(pure func(_) -> AggregateVisit: UnvisitedAggregate)
	var union_visits = unions.map(pure func(_) -> AggregateVisit: UnvisitedAggregate)
	var fragments: List[String] = []
	var pending: List[AggregateVisitStep] = []
	var pending_count = 0
	var position = unions.length()

	while position.greater_than(0):
		position = position.subtract(1)
		pending = push_aggregate_visit(
			pending,
			pending_count,
			PrepareAggregate(UnionDefinition(position)),
		)
		pending_count = pending_count.add(1)

	position = records.length()

	while position.greater_than(0):
		position = position.subtract(1)
		pending = push_aggregate_visit(
			pending,
			pending_count,
			PrepareAggregate(RecordDefinition(position)),
		)
		pending_count = pending_count.add(1)

	var invalid: Option[Diagnostic] = None

	while and(pending_count.greater_than(0), invalid.is_some().not()):
		pending_count = pending_count.subtract(1)

		match pending.get(pending_count):
			None:
				invalid = Some(render(internal_span(), MissingAggregateWorkItem(pending_count)))
			Some(step):
				match step:
					PrepareAggregate(definition):
						status = match definition:
							RecordDefinition(index):
								record_visits.get(index)
							UnionDefinition(index):
								union_visits.get(index)

						match status:
							None:
								missing: EmissionFailure = match definition:
									RecordDefinition(index): MissingAggregateVisit(RecordAggregate, index)
									UnionDefinition(index): MissingAggregateVisit(UnionAggregate, index)
								invalid = Some(render(internal_span(), missing))
							Some(EmittedAggregate):
								void
							Some(VisitingAggregate):
								cycle: EmissionFailure = match definition:
									RecordDefinition(index): CyclicByValueAggregate(RecordAggregate, index)
									UnionDefinition(index): CyclicByValueAggregate(UnionAggregate, index)
								invalid = Some(render(internal_span(), cycle))
							Some(UnvisitedAggregate):
								pending = push_aggregate_visit(
									pending,
									pending_count,
									EmitAggregate(definition),
								)
								pending_count = pending_count.add(1)

								match definition:
									RecordDefinition(index):
										record_visits = record_visits.set(index, VisitingAggregate)

										match records.get(index):
											None:
												invalid = Some(render(internal_span(), MissingAggregateLayout(RecordAggregate, index)))
											Some(layout):
												fields = record_fields(layout)
												var child = fields.length()

												while child.greater_than(0):
													child = child.subtract(1)

													match fields.get(child):
														Some(field):
															match stored_by_value(field, records, unions):
																Some(dependency):
																	pending = push_aggregate_visit(pending, pending_count, PrepareAggregate(dependency))
																	pending_count = pending_count.add(1)
																None:
																	void
														None:
															invalid = Some(render(internal_span(), MissingAggregateMember(RecordAggregate, index, child)))
															break
									UnionDefinition(index):
										union_visits = union_visits.set(index, VisitingAggregate)

										match unions.get(index):
											None:
												invalid = Some(render(internal_span(), MissingAggregateLayout(UnionAggregate, index)))
											Some(layout):
												variants = union_variants(layout)
												var child = variants.length()

												while child.greater_than(0):
													child = child.subtract(1)

													match variants.get(child):
														Some(fields):
															var field_position = fields.length()
															while field_position.greater_than(0):
																field_position = field_position.subtract(1)
																match fields.get(field_position):
																	Some(field):
																		match stored_by_value(field, records, unions):
																			Some(dependency):
																				pending = push_aggregate_visit(pending, pending_count, PrepareAggregate(dependency))
																				pending_count = pending_count.add(1)
																			None:
																				void
																	None:
																		invalid = Some(render(internal_span(), MissingUnionPayloadField(index, child, field_position)))
																		break
														None:
															invalid = Some(render(internal_span(), MissingAggregateMember(UnionAggregate, index, child)))
															break
					EmitAggregate(definition):
						match definition:
							RecordDefinition(index):
								match records.get(index):
									None:
										invalid = Some(render(internal_span(), MissingAggregateLayout(RecordAggregate, index)))
									Some(layout):
										match append_record("", layout, index, unions):
											Ok(record_definition):
												fragments = fragments.append(record_definition)
												record_visits = record_visits.set(
													index,
													EmittedAggregate,
												)
											Err(error):
												invalid = Some(error)
							UnionDefinition(index):
								match unions.get(index):
									None:
										invalid = Some(render(internal_span(), MissingAggregateLayout(UnionAggregate, index)))
									Some(layout):
										match append_union("", layout, index, unions):
											Ok(union_definition):
												fragments = fragments.append(union_definition)
												union_visits = union_visits.set(
													index,
													EmittedAggregate,
												)
											Err(error):
												invalid = Some(error)

	match invalid:
		Some(error):
			Err(error)
		None:
			Ok(fragments.join("\n"))


private pure func append_record_prototypes(output: String, index: Int) -> String:
	"${output}void blorp_record_dup_${index.to_string()}(blorp_r_${index.to_string()});"
		.concat("void blorp_record_drop_${index.to_string()}(blorp_r_${index.to_string()});")


private pure func append_record_ownership(
	output: String,
	layout: ConcreteRecord,
	index: Int,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	prefix = "${output}void blorp_record_dup_${index.to_string()}(blorp_r_${index.to_string()} value){"

	match layout:
		InlineFields(_):
			Ok(
				"${prefix}(void)value;}void blorp_record_drop_${index.to_string()}(blorp_r_${index.to_string()} value){"
					.concat("(void)value;}"),
			)
		CountedFields(fields):
			var result = "${prefix}(void)atomic_fetch_add_explicit(&value->references,UINT64_C(1),memory_order_relaxed);}"
				.concat("void blorp_record_drop_${index.to_string()}(blorp_r_${index.to_string()} value){")
				.concat("if(atomic_fetch_sub_explicit(&value->references,UINT64_C(1),memory_order_acq_rel)!=UINT64_C(1))return;")
			var position = 0
			var invalid: Option[Diagnostic] = None

			for field in fields:
				match (
					append_storage_operation(
						result,
						field,
						DestroyValue,
						"value->blorp_rf_${index.to_string()}_${position.to_string()}",
						unions,
						internal_span(),
					)
				):
					Ok(updated):
						result = updated
					Err(error):
						invalid = Some(error)
						break

				position = position.add(1)

			match invalid:
				Some(error):
					Err(error)
				None:
					result = "${result}blorp_memory_release(value);}"
						.concat("blorp_r_${index.to_string()} blorp_record_make_${index.to_string()}(struct blorp_r_${index.to_string()} fields){")
						.concat("(void)fields;blorp_r_${index.to_string()} value=blorp_memory_allocate(sizeof *value);if(!value)abort();")
						.concat("atomic_init(&value->references,UINT64_C(1));")
					position = 0

					for value_type in fields:
						match value_type:
							VoidType:
								position = position.add(1)
								continue
							_: void
						field = "blorp_rf_${index.to_string()}_${position.to_string()}"
						result = "${result}value->${field}=fields.${field};"
						position = position.add(1)

					Ok("${result}return value;}")


private pure func append_operation(
	output: String,
	id: ValueId,
	value_type: TypeRef,
	operation: OwnedValueOperation,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
	span: Span,
) -> Result[String, Diagnostic]:
	match operation:
		ConstructRecordDefinition(owner, fields):
			match records.get(record_number(owner)):
				Some(layout):

					var result = match layout:
						InlineFields(_):
							"${output}(("
						CountedFields(_):
							"${output}blorp_record_make_${record_number(owner).to_string()}(("

					result = "${result}struct blorp_r_${record_number(owner).to_string()}){"
					var position = 0
					layout_fields = record_fields(layout)

					for field in fields:
						match layout_fields.get(field_number(field.field)):
							Some(VoidType): continue
							_: void
						if position.greater_than(0):
							result = "${result},"

						stored = match field.value:
							UnmanagedPayload(value):
								value
							OwnedPayload(value, _):
								value

						result = "${result}.${c_field(field.field)}=${c_value(stored)}"
						position = position.add(1)

					if position == 0:
						result = "${result}0"
					Ok("${result}})")
				None: Err(render(span, MissingRecordLayout(owner)))
		ReadRecordFieldDefinition(field, argument):
			match records.get(record_number(field_owner(field))):
				Some(layout):

					match value_type:
						VoidType: Ok("${output}0")
						_:
							value = match argument:
								UnmanagedArgument(value):
									value
								ConsumedArgument(value, _):
									value
								BorrowedArgument(borrow):
									borrow.value

							selector = match layout:
								InlineFields(_):
									"."
								CountedFields(_):
									"->"

							Ok(
								output
									.concat(c_value(value))
									.concat(selector)
									.concat(c_field(field)),
							)
				None: Err(render(span, MissingRecordLayout(field_owner(field))))
		ParameterDefinition(index):
			Ok(output.concat(c_parameter(index)))
		VoidDefinition:
			Ok("${output}((uint8_t)0)")
		IntegerDefinition(value):
			Ok(append_integer(output, value))
		FloatDefinition(value):
			Ok(output.concat(c_float_literal(value)))
		StringDefinition(bytes):
			constructor = "${output}blorp_string_from_bytes((const char *)${c_literal_bytes(id)}"
			length = append_integer(
				"${constructor},",
				bytes.length(),
			)
			Ok("${length})")
		FreeCallableDefinition(body):
			match c_type(value_type, unions, span):
				Err(error): Err(error)
				Ok(name):
					Ok("${output}((${name}){&${callable_entry_name(body, value_type)},(void*)0})")
		CapturedCallableDefinition(body, payload):
			match c_type(value_type, unions, span):
				Err(error): Err(error)
				Ok(name):
					value = match payload:
						UnmanagedPayload(stored): stored
						OwnedPayload(stored, _): stored
					Ok("${output}((${name}){&${callable_entry_name(body, value_type)},${c_value(value)}})")
		InvokeCallableDefinition(callee, arguments):
			value = c_value(argument_value(callee))
			var invocation = "${output}${value}.ops->invoke(${value}.environment"
			for argument in arguments:
				invocation = "${invocation},${c_value(argument_value(argument))}"
			Ok("${invocation})")
		CallDefinition(target, arguments):
			match c_callable(target):
				None: Err(render(span, StatementOnlyValue(id)))
				Some(callable):
					name = match target:
						RuntimeFunction(StringConcat):
							match arguments.get(0):
								Some(ConsumedArgument(_, _)): "blorp_string_concat_take_left"
								_: callable
						RuntimeFunction(ListAppend(element)):
							match arguments.get(0):
								Some(ConsumedArgument(_, _)): "blorp_list_append_take_left_${list_suffix(list_element_key(element))}"
								_: callable
						RuntimeFunction(ListSet(element)):
							match arguments.get(0):
								Some(ConsumedArgument(_, _)): "blorp_list_set_take_left_${list_suffix(list_element_key(element))}"
								_: callable
						RuntimeFunction(ListConcat(element)):
							match arguments.get(0):
								Some(ConsumedArgument(_, _)): "blorp_list_concat_take_left_${list_suffix(list_element_key(element))}"
								_: callable
						RuntimeFunction(StringAppendInt):
							match arguments.get(0):
								Some(ConsumedArgument(_, _)): "blorp_string_append_int_take_left"
								_: callable
						_: callable
					var prefix = "${output}${name}("
					var index: Int = 0

					for argument in arguments:
						if index.greater_than(0):
							prefix = "${prefix},"

						value = match argument:
							UnmanagedArgument(argument_id):
								argument_id
							ConsumedArgument(argument_id, _):
								argument_id
							BorrowedArgument(borrow):
								borrow.value

						prefix = prefix.concat(c_value(value))
						index = index.add(1)

					Ok("${prefix})")
		ConstructDefinition(variant_id, fields):
			var operands: List[String] = []
			for field in fields:
				operand = match field:
					UnmanagedPayload(value): c_value(value)
					OwnedPayload(_, owner): c_owner(owner)
				operands = operands.append(operand)
			match c_union_value(variant_id, operands, unions, span):
				Ok(value): Ok(output.concat(value))
				Err(error): Err(error)
		ConstructListDefinition(_):
			-- List construction and joins are written as statements, by
			-- append_list_construction and append_join; never as expressions.
			Err(render(span, StatementOnlyValue(id)))
		ListElementDefinition(index, parent):
			Ok("${output}${c_value(parent)}->values[${index.to_string()}]")
		ListSuffixDefinition(parent, skipped):
			match value_type:
				ListType(element):
					Ok("${output}${list_update_name(SuffixUpdate, list_element_key(element))}(${c_value(argument_value(parent))},INT64_C(${skipped.to_string()}))")
				_: Err(render(span, StatementOnlyValue(id)))
		PayloadDefinition(field, source_id):
			match unions.get(union_number(variant_owner(variant_field_variant(field)))):
				Some(declaration):
					Ok(
						"${output}${c_value(source_id)}${union_member_selector(declaration)}payload.${c_payload_field( variant_field_variant(field), variant_field_number(field), )}",
					)
				None: Err(render(span, MissingUnionLayout(variant_owner(variant_field_variant(field)))))


-- The one C rendering of a union value, for source constructions and runtime
-- results alike, so every union value local follows its layout. A union with
-- no payload anywhere is a bare C enum and a variant is its tag; any other
-- value is a compound literal, from which a boxed union allocates its counted
-- node. Each operand is an occurrence the new value owns.
private pure func c_union_value(
	variant: VariantInstanceId,
	operands: List[String],
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[String, Diagnostic]:
	index = union_number(variant_owner(variant))
	declaration: ConcreteUnion ?= match unions.get(index):
		Some(found): Ok(found)
		None: Err(render(span, MissingUnionLayout(variant_owner(variant))))

	if has_payload(declaration):
		opening = match union_is_boxed(declaration):
			True:
				"blorp_union_make_${index.to_string()}((${boxed_union_struct(index)}"
			False:
				"((${union_c_type(variant_owner(variant), declaration)}"
		tagged = "${opening}){.tag=${c_variant(variant)}"
		-- A variant without fields omits the payload initializer.
		if operands.is_empty():
			Ok("${tagged}})")
		else:
			Ok("${append_payload_initializer(tagged, variant, operands)}})")
	else:
		Ok(c_variant(variant))


private pure func append_payload_initializer(
	output: String,
	id: VariantInstanceId,
	operands: List[String],
) -> String:
	var result = "${output},.payload.${c_payload(id)}={"
	var position = 0
	for operand in operands:
		if position.greater_than(0):
			result = "${result},"
		result = "${result}.blorp_uf_${position.to_string()}=${operand}"
		position = position.add(1)
	"${result}}"


private pure func argument_value(argument: OwnedArgument) -> ValueId:
	match argument:
		UnmanagedArgument(id):
			id
		ConsumedArgument(id, _):
			id
		BorrowedArgument(borrow):
			borrow.value


private pure func append_optional_value(
	output: String,
	id: ValueId,
	option: DesignatedOption[VariantInstanceId],
	condition: String,
	payload: String,
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[String, Diagnostic]:
	declaration ?= c_local_declaration(UnionType(variant_owner(option.some)), InitializedLocal, unions, span)
	some ?= c_union_value(option.some, [payload], unions, span)
	none ?= c_union_value(option.none, [], unions, span)
	name = c_value(id)
	Ok(
		"${output}${declaration}${name}=${condition}?${some}:${none};(void)${name};",
	)


private pure func append_parse_number(
	output: String,
	id: ValueId,
	option: DesignatedOption[VariantInstanceId],
	arguments: List[OwnedArgument],
	unions: List[ConcreteUnion],
	scalar_type: String,
	runtime: String,
	span: Span,
) -> Result[String, Diagnostic]:
	argument: OwnedArgument ?= match arguments.get(0):
		Some(found): Ok(found)
		None: Err(render(span, MissingRuntimeArgument(id, 0)))
	scratch = "blorp_runtime_".append_int(value_number(id))
	prefix = "${output}${scalar_type} ${scratch}=0;"
		.concat("const uint8_t ${scratch}_some=${runtime}(${c_value(argument_value(argument))},&${scratch});")
	append_optional_value(
		prefix,
		id,
		option,
		"${scratch}_some",
		scratch,
		unions,
		span,
	)


private pure func append_string_byte_at(
	output: String,
	id: ValueId,
	option: DesignatedOption[VariantInstanceId],
	arguments: List[OwnedArgument],
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[String, Diagnostic]:
	text: OwnedArgument ?= match arguments.get(0):
		Some(found): Ok(found)
		None: Err(render(span, MissingRuntimeArgument(id, 0)))
	index: OwnedArgument ?= match arguments.get(1):
		Some(found): Ok(found)
		None: Err(render(span, MissingRuntimeArgument(id, 1)))
	scratch = "blorp_runtime_".append_int(value_number(id))
	prefix = "${output}int64_t ${scratch}=0;"
		.concat("const uint8_t ${scratch}_some=blorp_string_byte_at(${c_value(argument_value(text))},${c_value(argument_value(index))},&${scratch});")
	append_optional_value(prefix, id, option, "${scratch}_some", scratch, unions, span)


private pure func append_string_from_codepoint(
	output: String,
	id: ValueId,
	option: DesignatedOption[VariantInstanceId],
	arguments: List[OwnedArgument],
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[String, Diagnostic]:
	scalar: OwnedArgument ?= match arguments.get(0):
		Some(found): Ok(found)
		None: Err(render(span, MissingRuntimeArgument(id, 0)))
	scratch = "blorp_runtime_".append_int(value_number(id))
	prefix = "${output}struct blorp_string *${scratch}=NULL;"
		.concat("const uint8_t ${scratch}_some=blorp_string_from_codepoint(${c_value(argument_value(scalar))},&${scratch});")
	-- Some takes the fresh root. Scratch is neither retained nor released here.
	append_optional_value(prefix, id, option, "${scratch}_some", scratch, unions, span)


private pure func append_string_slice(
	output: String,
	id: ValueId,
	option: DesignatedOption[VariantInstanceId],
	arguments: List[OwnedArgument],
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[String, Diagnostic]:
	text: OwnedArgument ?= match arguments.get(0):
		Some(found): Ok(found)
		None: Err(render(span, MissingRuntimeArgument(id, 0)))
	start: OwnedArgument ?= match arguments.get(1):
		Some(found): Ok(found)
		None: Err(render(span, MissingRuntimeArgument(id, 1)))
	end: OwnedArgument ?= match arguments.get(2):
		Some(found): Ok(found)
		None: Err(render(span, MissingRuntimeArgument(id, 2)))

	scratch = "blorp_runtime_".append_int(value_number(id))
	prefix = "${output}struct blorp_string *${scratch}=NULL;"
		.concat("const uint8_t ${scratch}_some=blorp_string_slice(${c_value(argument_value(text))},${c_value(argument_value(start))},${c_value(argument_value(end))},&${scratch});")
	-- Some takes the fresh root. Scratch has no separate ownership obligation.
	append_optional_value(prefix, id, option, "${scratch}_some", scratch, unions, span)


private pure func append_current_directory(
	output: String,
	id: ValueId,
	result: DesignatedResult[VariantInstanceId],
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[String, Diagnostic]:
	declaration ?= c_local_declaration(UnionType(variant_owner(result.ok)), InitializedLocal, unions, span)
	scratch = "blorp_runtime_".append_int(value_number(id))
	ok ?= c_union_value(result.ok, [scratch], unions, span)
	error ?= c_union_value(result.err, [scratch], unions, span)
	-- Both branches take the one fresh String. Scratch has no separate obligation.
	Ok("${output}struct blorp_string *${scratch}=NULL;const uint8_t ${scratch}_ok=blorp_get_current_directory(&${scratch});"
		.concat("${declaration}${c_value(id)}=${scratch}_ok?${ok}:${error};(void)${c_value(id)};"))


private pure func append_read_file(
	output: String,
	id: ValueId,
	result: DesignatedResult[VariantInstanceId],
	arguments: List[OwnedArgument],
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[String, Diagnostic]:
	path: OwnedArgument ?= match arguments.get(0):
		Some(found): Ok(found)
		None: Err(render(span, MissingRuntimeArgument(id, 0)))
	declaration ?= c_local_declaration(UnionType(variant_owner(result.ok)), InitializedLocal, unions, span)
	scratch = "blorp_runtime_".append_int(value_number(id))
	ok ?= c_union_value(result.ok, [scratch], unions, span)
	error ?= c_union_value(result.err, [scratch], unions, span)
	-- The path is borrowed; either constructor takes the one fresh String.
	Ok("${output}struct blorp_string *${scratch}=NULL;"
		.concat("const uint8_t ${scratch}_ok=blorp_read_file(${c_value(argument_value(path))},&${scratch});")
		.concat("${declaration}${c_value(id)}=${scratch}_ok?${ok}:${error};(void)${c_value(id)};"))


-- Native outputs stay private; only the designated ordinary Result escapes.
private pure func append_run_to_files(
	output: String, id: ValueId, result: DesignatedResult[VariantInstanceId],
	arguments: List[OwnedArgument], unions: List[ConcreteUnion], span: Span,
) -> Result[String, Diagnostic]:
	values = arguments.map(pure func(argument: OwnedArgument) -> String: c_value(argument_value(argument))).join(",")
	declaration ?= c_local_declaration(UnionType(variant_owner(result.ok)), InitializedLocal, unions, span)
	scratch = "blorp_runtime_".append_int(value_number(id))
	ok ?= c_union_value(result.ok, ["${scratch}_status"], unions, span)
	error ?= c_union_value(result.err, ["${scratch}_error"], unions, span)
	Ok("${output}int64_t ${scratch}_status=0;struct blorp_string *${scratch}_error=NULL;"
		.concat("const uint8_t ${scratch}_ok=blorp_process_run_to_files(${values},&${scratch}_status,&${scratch}_error);")
		.concat("${declaration}${c_value(id)}=${scratch}_ok?${ok}:${error};(void)${c_value(id)};"))


private pure func append_write_file(
	output: String,
	id: ValueId,
	result: DesignatedResult[VariantInstanceId],
	arguments: List[OwnedArgument],
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[String, Diagnostic]:
	path: OwnedArgument ?= match arguments.get(0):
		Some(found): Ok(found)
		None: Err(render(span, MissingRuntimeArgument(id, 0)))
	contents: OwnedArgument ?= match arguments.get(1):
		Some(found): Ok(found)
		None: Err(render(span, MissingRuntimeArgument(id, 1)))
	declaration ?= c_local_declaration(UnionType(variant_owner(result.ok)), InitializedLocal, unions, span)
	scratch = "blorp_runtime_".append_int(value_number(id))
	ok ?= c_union_value(result.ok, ["(uint8_t)0"], unions, span)
	error ?= c_union_value(result.err, [scratch], unions, span)
	-- Only Err takes a String root; Ok stores the actual unmanaged Void payload.
	Ok("${output}struct blorp_string *${scratch}=NULL;"
		.concat("const uint8_t ${scratch}_ok=blorp_write_file(${c_value(argument_value(path))},${c_value(argument_value(contents))},&${scratch});")
		.concat("${declaration}${c_value(id)}=${scratch}_ok?${ok}:${error};(void)${c_value(id)};"))


private pure func append_list_get(
	output: String,
	id: ValueId,
	option: DesignatedOption[VariantInstanceId],
	element: TypeRef,
	arguments: List[OwnedArgument],
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[String, Diagnostic]:
	values: OwnedArgument ?= match arguments.get(0):
		Some(found): Ok(found)
		None: Err(render(span, MissingRuntimeArgument(id, 0)))
	index: OwnedArgument ?= match arguments.get(1):
		Some(found): Ok(found)
		None: Err(render(span, MissingRuntimeArgument(id, 1)))
	scratch = "blorp_runtime_".append_int(value_number(id))
	element_type ?= c_type(element, unions, span)
	prefix = "${output}${element_type} ${scratch}={0};"
		.concat("const uint8_t ${scratch}_some=blorp_list_get_${list_suffix(list_element_key(element))}(${c_value(argument_value(values))},${c_value(argument_value(index))},&${scratch});")
	append_optional_value(
		prefix,
		id,
		option,
		"${scratch}_some",
		scratch,
		unions,
		span,
	)


private pure func append_value(
	output: String,
	id: ValueId,
	value_type: TypeRef,
	operation: OwnedValueOperation,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
	span: Span,
) -> Result[String, Diagnostic]:
	match operation:
		CallDefinition(target, arguments):
			match target:
				RuntimeFunction(StringParseInt(option)):
					append_parse_number(
						output,
						id,
						option,
						arguments,
						unions,
						"int64_t",
						"blorp_string_parse_int",
						span,
					)
				RuntimeFunction(StringParseFloat(option)):
					append_parse_number(
						output,
						id,
						option,
						arguments,
						unions,
						"double",
						"blorp_string_parse_float",
						span,
					)
				RuntimeFunction(ListGet(element, option)):
					append_list_get(output, id, option, element, arguments, unions, span)
				RuntimeFunction(StringByteAt(option)):
					append_string_byte_at(output, id, option, arguments, unions, span)
				RuntimeFunction(StringFromCodepoint(option)):
					append_string_from_codepoint(output, id, option, arguments, unions, span)
				RuntimeFunction(StringSlice(option)):
					append_string_slice(output, id, option, arguments, unions, span)
				RuntimeFunction(RunToFiles(result)):
					append_run_to_files(output, id, result, arguments, unions, span)
				RuntimeFunction(ReadFile(result)):
					append_read_file(output, id, result, arguments, unions, span)
				RuntimeFunction(WriteFile(result)):
					append_write_file(output, id, result, arguments, unions, span)
				RuntimeFunction(GetCurrentDirectory(result)):
					append_current_directory(output, id, result, unions, span)
				RuntimeFunction(StringEquals(boolean)):
					append_comparison(output, id, boolean, arguments, unions, StringEquality, span)
				RuntimeFunction(IntEquals(boolean)):
					append_comparison(output, id, boolean, arguments, unions, ScalarEquality, span)
				RuntimeFunction(IntLessThan(boolean)):
					append_comparison(output, id, boolean, arguments, unions, ScalarLessThan, span)
				RuntimeFunction(FloatEquals(boolean)):
					append_comparison(output, id, boolean, arguments, unions, ScalarEquality, span)
				RuntimeFunction(FloatLessThan(boolean)):
					append_comparison(output, id, boolean, arguments, unions, ScalarLessThan, span)
				RuntimeFunction(FloatIsNaN(boolean)):
					append_classification(output, id, boolean, arguments, unions, NaNClassification, span)
				RuntimeFunction(FloatIsFinite(boolean)):
					append_classification(output, id, boolean, arguments, unions, FiniteClassification, span)
				_:
					append_regular_value(output, id, value_type, operation, unions, records, span)
		ConstructListDefinition(payloads):
			append_list_construction(output, id, value_type, payloads, unions, span)
		_:
			append_regular_value(output, id, value_type, operation, unions, records, span)


-- Literals reserve exactly their known number of element slots, including zero.
-- Elements' acquisitions precede the inline construction, so each store
-- moves an owner or copies an unmanaged value, publishing length per slot.
private pure func append_list_construction(
	output: String,
	id: ValueId,
	value_type: TypeRef,
	payloads: List[StoredPayload],
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[String, Diagnostic]:
	type_name ?= c_type(value_type, unions, span)
	name = c_value(id)
	capacity = "".append_int(payloads.length())
	checked_capacity = "${name}_capacity"
	var result = "${output}const size_t ${checked_capacity}=${capacity};"
		.concat("if((uintmax_t)${checked_capacity}>(uintmax_t)INT64_MAX||${checked_capacity}>(SIZE_MAX-sizeof *((${type_name})0))/sizeof ((${type_name})0)->values[0])abort();")
		.concat(list_root_allocation(type_name.concat(" const"), name, checked_capacity))
	var slot = 0
	for payload in payloads:
		stored = match payload:
			UnmanagedPayload(value): c_value(value)
			OwnedPayload(_, owner): c_owner(owner)
		result = result.concat(list_slot_store(name, "".append_int(slot), stored))
		slot = slot.add(1)
	Ok("${result}(void)${name};")


private fixed union Comparison:
	StringEquality
	ScalarEquality
	ScalarLessThan


private fixed union FloatClassification:
	NaNClassification
	FiniteClassification


private pure func append_comparison(
	output: String,
	id: ValueId,
	boolean: DesignatedBoolean[VariantInstanceId],
	arguments: List[OwnedArgument],
	unions: List[ConcreteUnion],
	comparison: Comparison,
	span: Span,
) -> Result[String, Diagnostic]:
	left: OwnedArgument ?= match arguments.get(0):
		Some(found): Ok(found)
		None: Err(render(span, MissingRuntimeArgument(id, 0)))
	right: OwnedArgument ?= match arguments.get(1):
		Some(found): Ok(found)
		None: Err(render(span, MissingRuntimeArgument(id, 1)))
	left_value = c_value(argument_value(left))
	right_value = c_value(argument_value(right))

	condition = match comparison:
		StringEquality:
			"blorp_string_equals(${left_value},${right_value})"
		ScalarEquality:
			"(${left_value}==${right_value})"
		ScalarLessThan:
			"(${left_value}<${right_value})"

	append_boolean(output, id, boolean, condition, unions, span)


private pure func append_classification(
	output: String,
	id: ValueId,
	boolean: DesignatedBoolean[VariantInstanceId],
	arguments: List[OwnedArgument],
	unions: List[ConcreteUnion],
	classification: FloatClassification,
	span: Span,
) -> Result[String, Diagnostic]:
	argument: OwnedArgument ?= match arguments.get(0):
		Some(found): Ok(found)
		None: Err(render(span, MissingRuntimeArgument(id, 0)))
	value = c_value(argument_value(argument))
	condition = match classification:
		NaNClassification: "isnan(${value})"
		FiniteClassification: "isfinite(${value})"
	append_boolean(output, id, boolean, condition, unions, span)


private pure func append_boolean(
	output: String,
	id: ValueId,
	boolean: DesignatedBoolean[VariantInstanceId],
	condition: String,
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[String, Diagnostic]:
	declaration ?= c_local_declaration(UnionType(variant_owner(boolean.true_variant)), InitializedLocal, unions, span)
	true_value ?= c_union_value(boolean.true_variant, [], unions, span)
	false_value ?= c_union_value(boolean.false_variant, [], unions, span)
	name = c_value(id)

	Ok(
		"${output}${declaration}${name}=${condition}?${true_value}:${false_value};(void)${name};",
	)


private pure func append_regular_value(
	output: String,
	id: ValueId,
	value_type: TypeRef,
	operation: OwnedValueOperation,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
	span: Span,
) -> Result[String, Diagnostic]:
	declaration ?= c_local_declaration(value_type, InitializedLocal, unions, span)
	name = c_value(id)

	prepared = match operation:
		StringDefinition(bytes):
			append_string_bytes(output, id, bytes)
		_:
			output

	value ?= append_operation(
		"${prepared}${declaration}${name}=",
		id,
		value_type,
		operation,
		unions,
		records,
		span,
	)
	Ok(
		"${value};(void)${name};",
	)


private pure func append_owner_alias(
	output: String,
	owner: OwnerId,
	value: ValueId,
	value_type: TypeRef,
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[String, Diagnostic]:
	name = c_owner(owner)
	declaration ?= c_local_declaration(value_type, InitializedLocal, unions, span)

	Ok(
		"${output}${declaration}${name}=${c_value(value)};(void)${name};",
	)


private pure func append_owned_definition(
	output: String,
	definition: OwnedDefinition,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[String, Diagnostic]:
	value ?= append_value(
		output,
		definition.id,
		definition.value_type,
		definition.operation,
		unions,
		records,
		definition.span,
	)

	match definition.result:
		UnmanagedResult | BorrowedResult(_):
			Ok(value)
		OwnedResult(owner):
			append_owner_alias(value, owner, definition.id, definition.value_type, unions, definition.span)


-- Disposable owner-type projection of accepted IR; value types stay local.
private pure func owner_types(function: OwnedFunction) -> Result[List[TypeRef], Diagnostic]:
	blocks = function_blocks(function)
	var values: List[TypeRef] = []
	var owners: List[TypeRef] = []
	var failure: Option[Diagnostic] = None

	for block in blocks:
		for header in block.headers:
			fact = join_parameter(header.parameter)
			values = values.append(fact.value_type)
			match header.parameter:
				UnmanagedJoinParameter(_): void
				ManagedJoinParameter(_, _): owners = owners.append(fact.value_type)
		for input in block.inputs:
			fact = join_parameter(input)
			values = values.append(fact.value_type)
			match input:
				UnmanagedJoinParameter(_): void
				ManagedJoinParameter(_, _): owners = owners.append(fact.value_type)
		for operation in block.operations:
			match operation:
				DefineValue(definition):
					values = values.append(definition.value_type)

					match definition.result:
						OwnedResult(_):
							owners = owners.append(definition.value_type)
						_:
							void
				ExecuteJoin(join):
					for output in [join.result].concat(join.carried):
						parameter = join_parameter(output)
						values = values.append(parameter.value_type)
						match output:
							UnmanagedJoinParameter(_): void
							ManagedJoinParameter(_, _): owners = owners.append(parameter.value_type)

				ExecuteLoop(loop):
					for output in [loop.result].concat(loop.carried):
						parameter = join_parameter(output)
						values = values.append(parameter.value_type)
						match output:
							UnmanagedJoinParameter(_): void
							ManagedJoinParameter(_, _): owners = owners.append(parameter.value_type)

				AcquireOwner(_, borrowed, span):
					match values.get(value_number(borrowed.value)):
						Some(value_type):
							owners = owners.append(value_type)
						None:
							failure = Some(render(span, MissingValueType(borrowed.value)))
							break
				DropOwner(_, _):
					void

		if failure.is_some():
			break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(owners)


private fixed union OwnershipAction:
	DuplicateValue
	DestroyValue


private pure func append_storage_operation(
	output: String,
	value_type: TypeRef,
	action: OwnershipAction,
	expression: String,
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[String, Diagnostic]:
	name_result: Result[Option[String], Diagnostic] = match value_type:
		CallableType(parameters, result):
			prefix = match action:
				DuplicateValue: "blorp_callable_dup_"
				DestroyValue: "blorp_callable_drop_"
			Ok(Some(prefix.concat(callable_suffix(parameters, result))))
		RecordType(id):
			prefix = match action:
				DuplicateValue:
					"blorp_record_dup_"
				DestroyValue:
					"blorp_record_drop_"

			Ok(Some(prefix.append_int(record_number(id))))
		ListType(element):
			prefix = match action:
				DuplicateValue: "blorp_list_dup_"
				DestroyValue: "blorp_list_drop_"
			Ok(Some(prefix.concat(list_suffix(list_element_key(element)))))
		StringType:
			storage_helper: String = match action:
				DuplicateValue:
					"blorp_string_retain"
				DestroyValue:
					"blorp_string_release"
			Ok(Some(storage_helper))
		UnionType(id):
			match unions.get(union_number(id)):
				Some(layout):
					union_helper: Option[String] = match layout:
						PlainCases(_):
							None
						OwningCases(_) | BoxedCases(_):
							prefix = match action:
								DuplicateValue:
									"blorp_union_dup_"
								DestroyValue:
									"blorp_union_drop_"

							Some(prefix.append_int(union_number(id)))
					Ok(union_helper)
				None: Err(render(span, MissingUnionLayout(id)))
		_:
			Ok(None)

	found_name ?= name_result
	operation: String = match found_name:
		Some(name):
			"${output}${name}(${expression});"
		None:
			output
	Ok(operation)


private pure func append_union_action(
	output: String,
	layout: ConcreteUnion,
	index: Int,
	unions: List[ConcreteUnion],
	action: OwnershipAction,
) -> Result[String, Diagnostic]:
	prefix = match action:
		DuplicateValue:
			"void blorp_union_dup_"
		DestroyValue:
			"void blorp_union_drop_"

	var result = "${output}${prefix}${index.to_string()}(struct blorp_u_${index.to_string()} value){switch(value.tag){"
	var position = 0
	var failure: Option[Diagnostic] = None

	for fields in union_variants(layout):
		result = "${result}case blorp_v_${index.to_string()}_${position.to_string()}:"
		var field_position = 0
		for value_type in fields:
			path = "value.payload.blorp_up_${position.to_string()}.blorp_uf_${field_position.to_string()}"
			match append_storage_operation(result, value_type, action, path, unions, internal_span()):
				Ok(updated): result = updated
				Err(error):
					failure = Some(error)
					break
			field_position = field_position.add(1)
		if failure.is_some():
			break
		result = "${result}break;"
		position = position.add(1)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok("${result}}}")


-- One counted node per constructed value: the compound literal's payload
-- already holds acquired children, so the node takes them without retains.
private pure func append_boxed_union_constructor(output: String, index: Int) -> String:
	node = boxed_union_struct(index)
	"${output}${node}* blorp_union_make_${index.to_string()}(${node} fields){"
		.concat("${node}* value=blorp_memory_allocate(sizeof *value);if(!value)abort();atomic_init(&value->references,UINT64_C(1));")
		.concat("value->tag=fields.tag;value->payload=fields.payload;return value;}")


private pure func append_boxed_union_retain(output: String, index: Int) -> String:
	"${output}void blorp_union_dup_${index.to_string()}(${boxed_union_struct(index)}* value){"
		.concat("(void)atomic_fetch_add_explicit(&value->references,UINT64_C(1),memory_order_relaxed);}")


-- A boxed union is stored by pointer, so any layout may retain and release
-- it before its definition; its tag and helpers are declared up front with
-- the record and List prototypes.
private pure func append_boxed_union_prototypes(output: String, unions: List[ConcreteUnion]) -> String:
	var fragments: List[String] = [output]
	var index = 0

	for layout in unions:
		if union_is_boxed(layout):
			node = boxed_union_struct(index)
			fragments = fragments.append(
				"${node};void blorp_union_dup_${index.to_string()}(${node}*);"
					.concat("void blorp_union_drop_${index.to_string()}(${node}*);"),
			)

		index = index.add(1)

	fragments.join("")


-- Final release walks the chain instead of recursing: a node whose count
-- reaches zero releases its other payloads, saves its one self child, is
-- freed, and the walk continues with that child while it also dies. C stack
-- use is therefore constant however deep the chain is.
private pure func append_boxed_union_release(
	output: String,
	layout: ConcreteUnion,
	index: Int,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	node = boxed_union_struct(index)
	var result = "${output}void blorp_union_drop_${index.to_string()}(${node}* value){${node}* node=value;while(node!=NULL){"
		.concat("if(atomic_fetch_sub_explicit(&node->references,UINT64_C(1),memory_order_acq_rel)!=UINT64_C(1))return;")
		.concat("${node}* child=NULL;switch(node->tag){")
	var position = 0
	var failure: Option[Diagnostic] = None

	for fields in union_variants(layout):
		result = "${result}case blorp_v_${index.to_string()}_${position.to_string()}:"
		var field_position = 0
		for value_type in fields:
			path = "node->payload.blorp_up_${position.to_string()}.blorp_uf_${field_position.to_string()}"
			self_child = match value_type:
				UnionType(id): union_number(id) == index
				_: False
			if self_child:
				result = "${result}child=${path};"
			else:
				match append_storage_operation(result, value_type, DestroyValue, path, unions, internal_span()):
					Ok(updated): result = updated
					Err(error):
						failure = Some(error)
						break
			field_position = field_position.add(1)
		if failure.is_some():
			break
		result = "${result}break;"
		position = position.add(1)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok("${result}}blorp_memory_release(node);node=child;}}")


private pure func append_union_ownership(
	output: String,
	layout: ConcreteUnion,
	index: Int,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	match layout:
		PlainCases(_):
			Ok(output)
		OwningCases(_):
			match append_union_action(output, layout, index, unions, DuplicateValue):
				Ok(duplicated): append_union_action(duplicated, layout, index, unions, DestroyValue)
				Err(error): Err(error)
		BoxedCases(_):
			constructed = append_boxed_union_constructor(output, index)
			append_boxed_union_release(append_boxed_union_retain(constructed, index), layout, index, unions)


-- Exit destinations are prepared once; nested emission does not need the body.
private fixed record LoopEmissionContext {
	break_parameters: List[Own.OwnedJoinParameter],
	recur_parameters: List[Own.OwnedJoinParameter],
	target: Lower.LoopTarget
}


private pure func append_ownership_operation(
	output: String,
	operation: OwnershipOperation,
	unions: List[ConcreteUnion],
	types: List[TypeRef],
	records: List[ConcreteRecord], nearest: Option[LoopEmissionContext],
) -> Result[String, Diagnostic]:
	match operation:
		DefineValue(definition):
			append_owned_definition(output, definition, unions, records)
		ExecuteJoin(matched_join):
			append_join(output, matched_join, unions, types, records, nearest)
		ExecuteLoop(loop):
			append_loop(output, loop, unions, types, records)
		AcquireOwner(owner, borrowed, span):
			match types.get(owner_number(owner)):
				Some(value_type):
					match append_storage_operation(
						output,
						value_type,
						DuplicateValue,
						c_value(borrowed.value),
						unions,
						span,
					):
						Ok(retained): append_owner_alias(retained, owner, borrowed.value, value_type, unions, span)
						Err(error): Err(error)
				None: Err(render(span, MissingOwnerType(owner)))
		DropOwner(owner, span):
			match types.get(owner_number(owner)):
				Some(value_type): append_storage_operation(output, value_type, DestroyValue, c_owner(owner), unions, span)
				None: Err(render(span, MissingOwnerType(owner)))


private pure func append_ownership_operations(
	output: String,
	operations: List[OwnershipOperation],
	unions: List[ConcreteUnion],
	types: List[TypeRef],
	records: List[ConcreteRecord], nearest: Option[LoopEmissionContext],
) -> Result[String, Diagnostic]:
	var fragments: List[String] = [output]
	var failure: Option[Diagnostic] = None

	for operation in operations:
		match append_ownership_operation("", operation, unions, types, records, nearest):
			Err(error):
				failure = Some(error)
				break
			Ok(emitted):
				fragments = fragments.append(emitted)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(fragments.join(""))


-- Selection labels project existing value and arm identities. A terminal
-- selector's arm path distinguishes nested blocks that introduce no values.
private fixed record SelectionEmissionScope {
	root: ValueId,
	path: List[MatchArmId]
}


private pure func c_selection_scope(scope: SelectionEmissionScope) -> String:
	var name = "blorp_selection_".append_int(value_number(scope.root))
	for arm in scope.path:
		name = "${name}_in_${match_arm_number(arm).to_string()}"
	name


private pure func c_decision(scope: SelectionEmissionScope, node: DecisionNodeId) -> String:
	"${c_selection_scope(scope)}_node_${decision_node_number(node).to_string()}"


private pure func c_selection_arm(scope: SelectionEmissionScope, arm: MatchArmId) -> String:
	"${c_selection_scope(scope)}_arm_${match_arm_number(arm).to_string()}"


private pure func c_pattern_field(
	parent: ConcretePatternPlace, field: Concrete.VariantFieldInstanceId,
	scrutinee: ValueId, unions: List[ConcreteUnion], records: List[ConcreteRecord], span: Span,
) -> Result[String, Diagnostic]:
	base ?= c_pattern_place(parent, scrutinee, unions, records, span)
	owner = variant_owner(variant_field_variant(field))
	layout: ConcreteUnion ?= match unions.get(union_number(owner)):
		Some(found): Ok(found)
		None: Err(render(span, MissingUnionLayout(owner)))
	Ok("(${base})${union_member_selector(layout)}payload.${c_payload_field(variant_field_variant(field), variant_field_number(field))}")


private pure func c_pattern_place(
	place: ConcretePatternPlace, scrutinee: ValueId,
	unions: List[ConcreteUnion], records: List[ConcreteRecord], span: Span,
) -> Result[String, Diagnostic]:
	match place.route:
		Concrete.MatchRoot: Ok(c_value(scrutinee))
		Concrete.UnionField(parent, field): c_pattern_field(parent, field, scrutinee, unions, records, span)
		Concrete.RecordField(parent, field): c_pattern_record_field(place, parent, field, scrutinee, unions, records, span)
		Concrete.ListElement(parent, index):
			match c_pattern_place(parent, scrutinee, unions, records, span):
				Err(error): Err(error)
				Ok(base): Ok("(${base})->values[${index.to_string()}]")


private pure func c_pattern_record_field(
	place: ConcretePatternPlace, parent: ConcretePatternPlace, field: FieldInstanceId,
	scrutinee: ValueId, unions: List[ConcreteUnion], records: List[ConcreteRecord], span: Span,
) -> Result[String, Diagnostic]:
	base ?= c_pattern_place(parent, scrutinee, unions, records, span)
	layout ?= records.get(record_number(field_owner(field))).to_result(render(span, MissingRecordLayout(field_owner(field))))
	match place.value_type:
		VoidType: Ok("0")
		_:
			selector = match layout:
				InlineFields(_): "."
				CountedFields(_): "->"
			Ok("(${base})${selector}${c_field(field)}")


private pure func c_variant_test(
	place: ConcretePatternPlace, scrutinee: ValueId, variant: VariantInstanceId,
	unions: List[ConcreteUnion], records: List[ConcreteRecord], span: Span,
) -> Result[String, Diagnostic]:
	base ?= c_pattern_place(place, scrutinee, unions, records, span)
	owner = variant_owner(variant)
	layout: ConcreteUnion ?= match unions.get(union_number(owner)):
		Some(found): Ok(found)
		None: Err(render(span, MissingUnionLayout(owner)))
	tag = if has_payload(layout):
		"(${base})${union_member_selector(layout)}tag"
	else:
		base
	Ok("${tag}==${c_variant(variant)}")


private fixed record SelectionEmissionArm {
	id: MatchArmId,
	inputs: List[Own.OwnedJoinParameter],
	operations: List[OwnershipOperation],
	ending: String
}


private pure func append_input_declarations(
	output: String, inputs: List[Own.OwnedJoinParameter], unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	var result = output
	var failure: Option[Diagnostic] = None
	for input in inputs:
		fact = join_parameter(input)
		match c_local_declaration(fact.value_type, JoinLocal, unions, fact.span):
			Ok(declaration): result = "${result}${declaration}${c_value(fact.id)};"
			Err(error):
				failure = Some(error)
				break
	match failure:
		Some(error): Err(error)
		None: Ok(result)


private pure func append_input_owners(
	output: String, inputs: List[Own.OwnedJoinParameter], unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	var result = output
	var failure: Option[Diagnostic] = None
	for input in inputs:
		fact = join_parameter(input)
		result = "${result}(void)${c_value(fact.id)};"
		match input:
			UnmanagedJoinParameter(_): void
			ManagedJoinParameter(_, owner):
				match append_owner_alias(result, owner, fact.id, fact.value_type, unions, fact.span):
					Ok(aliased): result = aliased
					Err(error):
						failure = Some(error)
						break
	match failure:
		Some(error): Err(error)
		None: Ok(result)


private pure func append_selection_edge(
	output: String, scope: SelectionEmissionScope, edge: Own.OwnedSelectionEdge,
	arms: List[SelectionEmissionArm], unions: List[ConcreteUnion],
	types: List[TypeRef], records: List[ConcreteRecord], nearest: Option[LoopEmissionContext],
) -> Result[String, Diagnostic]:
	arm: SelectionEmissionArm ?= match arms.get(match_arm_number(edge.arm)):
		Some(found): Ok(found)
		None: Err(render(internal_span(), MissingJoinTransfer(scope.root)))
	operations ?= append_ownership_operations(output, edge.operations, unions, types, records, nearest)
	var result = operations
	var position = 0
	var failure: Option[Diagnostic] = None
	for input in arm.inputs:
		fact = join_parameter(input)
		match edge.transfers.get(position):
			Some(transfer): result = "${result}${c_value(fact.id)}=${transfer_value(transfer)};"
			None:
				failure = Some(render(fact.span, MissingJoinTransfer(fact.id)))
				break
		position = position.add(1)
	match failure:
		Some(error): Err(error)
		None: Ok("${result}goto ${c_selection_arm(scope, edge.arm)};")


private pure func c_selection_branch(
	scope: SelectionEmissionScope, test: String,
	yes: DecisionNodeId, no: DecisionNodeId,
) -> String:
	"if(${test})goto ${c_decision(scope, yes)};goto ${c_decision(scope, no)};"


private pure func append_selection_node(
	scope: SelectionEmissionScope, selection: Own.OwnedSelection,
	node: Own.OwnedDecisionNode, arms: List[SelectionEmissionArm],
	unions: List[ConcreteUnion], types: List[TypeRef], records: List[ConcreteRecord], nearest: Option[LoopEmissionContext],
) -> Result[String, Diagnostic]:
	match node:
		Own.TestVariant(place, variant, yes, no):
			match c_variant_test(place, argument_value(selection.scrutinee), variant, unions, records, internal_span()):
				Err(error): Err(error)
				Ok(test): Ok(c_selection_branch(scope, test, yes, no))
		Own.TestListLength(place, length, yes, no):
			match c_pattern_place(place, argument_value(selection.scrutinee), unions, records, internal_span()):
				Err(error): Err(error)
				Ok(base):
					test = match length:
						ExactLength(count): "(${base})->length==INT64_C(${count.to_string()})"
						MinimumLength(count): "(${base})->length>=INT64_C(${count.to_string()})"
					Ok(c_selection_branch(scope, test, yes, no))
		Own.TestStringBytes(place, bytes, yes, no):
			match c_pattern_place(place, argument_value(selection.scrutinee), unions, records, internal_span()):
				Err(error): Err(error)
				Ok(base):
					-- Each node has its own C scope. Static bytes preserve embedded
					-- NUL and UTF8, with no String construction during testing.
					name = "blorp_pattern_bytes"
					data = append_byte_array("", name, bytes)
					test = "(${base})->length==INT64_C(${bytes.length().to_string()})&&memcmp((${base})->bytes,${name},(size_t)${bytes.length().to_string()})==0"
					Ok(data.concat(c_selection_branch(scope, test, yes, no)))
		Own.EnterArm(edge): append_selection_edge("", scope, edge, arms, unions, types, records, nearest)


private pure func append_selection(
	output: String, scope: SelectionEmissionScope, selection: Own.OwnedSelection,
	arms: List[SelectionEmissionArm], unions: List[ConcreteUnion],
	types: List[TypeRef], records: List[ConcreteRecord], nearest: Option[LoopEmissionContext],
) -> Result[String, Diagnostic]:
	var result = output
	var failure: Option[Diagnostic] = None
	for arm in arms:
		match append_input_declarations(result, arm.inputs, unions):
			Ok(declared): result = declared
			Err(error):
				failure = Some(error)
				break
	declared: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	result = "${result}goto ${c_decision(scope, selection.entry)};"
	var position = 0
	for node in selection.nodes:
		match append_selection_node(scope, selection, node, arms, unions, types, records, nearest):
			Ok(emitted):
				label = "${c_selection_scope(scope)}_node_${position.to_string()}"
				result = "${result}${label}:{${emitted}}"
			Err(error):
				failure = Some(error)
				break
		position = position.add(1)
	nodes: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	for arm in arms:
		match append_selection_body(scope, arm, unions, types, records, nearest):
			Ok(body): result = result.concat(body)
			Err(error):
				failure = Some(error)
				break
	match failure:
		Some(error): Err(error)
		None: Ok(result)


private pure func append_selection_body(
	scope: SelectionEmissionScope, arm: SelectionEmissionArm,
	unions: List[ConcreteUnion], types: List[TypeRef], records: List[ConcreteRecord], nearest: Option[LoopEmissionContext],
) -> Result[String, Diagnostic]:
	opening = "${c_selection_arm(scope, arm.id)}:{"
	inputs ?= append_input_owners(opening, arm.inputs, unions)
	body ?= append_ownership_operations(inputs, arm.operations, unions, types, records, nearest)
	Ok("${body}${arm.ending}}")


-- Capture the complete outgoing batch before assigning any destination. The
-- producer has already acquired every owned occurrence and retired old owners.
private pure func append_loop_exit(
	output: String, exit: Own.OwnedLoopExit, context: LoopEmissionContext,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	parameters = match exit:
		Own.Break(_): context.break_parameters
		Own.Recur(_, _): context.recur_parameters
	transfers = match exit:
		Own.Break(outputs): [outputs.value].concat(outputs.carried)
		Own.Recur(arguments, _): arguments
	var result = output
	var position = 0
	var failure: Option[Diagnostic] = None
	for parameter in parameters:
		fact = join_parameter(parameter)
		match transfers.get(position):
			None:
				failure = Some(render(fact.span, MissingJoinTransfer(fact.id)))
				break
			Some(transfer):
				match c_local_declaration(fact.value_type, InitializedLocal, unions, fact.span):
					Err(error):
						failure = Some(error)
						break
					Ok(declaration):
						result = "${result}${declaration}${c_loop_transfer(context.target, position)}=${transfer_value(transfer)};"
		position = position.add(1)
	ready: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	position = 0
	for parameter in parameters:
		fact = join_parameter(parameter)
		name = match exit:
			Own.Break(_): c_value(fact.id)
			Own.Recur(_, _): c_header(fact.id)
		result = "${result}${name}=${c_loop_transfer(context.target, position)};"
		position = position.add(1)
	label = match exit:
		Own.Break(_): c_loop_break(context.target)
		Own.Recur(_, _): c_loop_header(context.target)
	Ok("${result}goto ${label};")


private pure func append_loop_block(
	output: String, block: Own.OwnedLoopBlock, context: LoopEmissionContext,
	scope: SelectionEmissionScope, unions: List[ConcreteUnion],
	types: List[TypeRef], records: List[ConcreteRecord],
) -> Result[String, Diagnostic]:
	body ?= append_ownership_operations(output, block.operations, unions, types, records, Some(context))
	append_loop_tail(body, block.tail, context, scope, unions, types, records)


private pure func append_loop_tail(
	output: String, tail: Own.OwnedLoopTail, context: LoopEmissionContext,
	scope: SelectionEmissionScope,
	unions: List[ConcreteUnion], types: List[TypeRef], records: List[ConcreteRecord],
) -> Result[String, Diagnostic]:
	match tail:
		Own.ExitLoop(exit): append_loop_exit(output, exit, context, unions)
		Own.MatchLoop(matched): append_loop_match(output, matched, context, scope, unions, types, records)


private pure func append_loop_match(
	output: String, matched: Own.OwnedLoopMatch, context: LoopEmissionContext,
	scope: SelectionEmissionScope, unions: List[ConcreteUnion],
	types: List[TypeRef], records: List[ConcreteRecord],
) -> Result[String, Diagnostic]:
	var arms: List[SelectionEmissionArm] = []
	var failure: Option[Diagnostic] = None
	for arm in matched.arms:
		child = { scope | path = scope.path.append(arm.id) }
		match append_loop_block("", arm.body, context, child, unions, types, records):
			Err(error):
				failure = Some(error)
				break
			Ok(ending): arms = arms.append({ id = arm.id, inputs = arm.inputs, operations = [], ending = ending })
	ready: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	append_selection(output, scope, matched.selection, arms, unions, types, records, Some(context))


private pure func append_loop(
	output: String,
	loop: Own.OwnedLoop,
	unions: List[ConcreteUnion],
	types: List[TypeRef],
	records: List[ConcreteRecord],
) -> Result[String, Diagnostic]:
	parameters = [loop.result].concat(loop.carried)
	output_declarations ?= append_input_declarations("", parameters, unions)
	var declarations = output_declarations
	var snapshots = ""
	var failure: Option[Diagnostic] = None
	for header in loop.headers:
		fact = join_parameter(header.parameter)
		match c_local_declaration(fact.value_type, JoinLocal, unions, fact.span):
			Err(error):
				failure = Some(error)
				break
			Ok(declaration):
				declarations = "${declarations}${declaration}${c_header(fact.id)}=${transfer_value(header.initial)};"
				match c_local_declaration(fact.value_type, InitializedLocal, unions, fact.span):
					Err(error):
						failure = Some(error)
						break
					Ok(snapshot): snapshots = "${snapshots}${snapshot}${c_value(fact.id)}=${c_header(fact.id)};(void)${c_value(fact.id)};"
				match header.parameter:
					UnmanagedJoinParameter(_): void
					ManagedJoinParameter(_, owner):
						match append_owner_alias(snapshots, owner, fact.id, fact.value_type, unions, fact.span):
							Ok(aliased): snapshots = aliased
							Err(error):
								failure = Some(error)
								break
	headers: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	scope: SelectionEmissionScope = { root = join_parameter(loop.result).id, path = [] }
	context: LoopEmissionContext = {
		break_parameters = parameters,
		recur_parameters = loop.headers.map(pure func(header): header.parameter),
		target = Lower.loop_target(scope.root)
	}
	var entered = output
	for acquisition in loop.entry_acquisitions:
		match append_ownership_operation(entered, AcquireOwner(acquisition.owner, acquisition.borrow, join_parameter(loop.result).span), unions, types, records, None):
			Ok(acquired): entered = acquired
			Err(error):
				failure = Some(error)
				break
	acquired: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	-- Acquisitions precede header initialization, which may move their aliases.
	declared = entered.concat(declarations)
	body ?= append_loop_block(snapshots, loop.body, context, scope, unions, types, records)
	-- Both labels have lexical uses even for a loop with only one exit kind.
	-- A sealed body always transfers before the final, unreachable goto.
	completed = "${declared}goto ${c_loop_header(context.target)};${c_loop_header(context.target)}:{${body}}"
		.concat("goto ${c_loop_break(context.target)};${c_loop_break(context.target)}:;")
	append_input_owners(completed, parameters, unions)

-- Verified ordinary joins have a yielding continuation. Abrupt arms transfer
-- directly to their typed loop target through the same selection emitter.
private pure func append_join(
	output: String,
	matched_join: OwnedJoin,
	unions: List[ConcreteUnion],
	types: List[TypeRef],
	records: List[ConcreteRecord], nearest: Option[LoopEmissionContext],
) -> Result[String, Diagnostic]:
	parameter = join_parameter(matched_join.result)
	name = c_value(parameter.id)
	parameters = [matched_join.result].concat(matched_join.carried)
	var declarations = output
	var failure: Option[Diagnostic] = None
	for output_parameter in parameters:
		fact = join_parameter(output_parameter)
		match c_local_declaration(fact.value_type, JoinLocal, unions, fact.span):
			Err(error):
				failure = Some(error)
				break
			Ok(declaration): declarations = "${declarations}${declaration}${c_value(fact.id)};"
	declared: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	scope: SelectionEmissionScope = { root = parameter.id, path = [] }
	done = "${c_selection_scope(scope)}_done"
	var arms: List[SelectionEmissionArm] = []
	for arm in matched_join.arms:
		ending: Result[String, Diagnostic] = match arm.exit:
			Own.TransferLoop(target, exit):
				match nearest:
					None: Err(render(parameter.span, MissingJoinTransfer(Lower.loop_target_value(target))))
					Some(context): append_loop_tail("", exit, context, { root = scope.root, path = scope.path.append(arm.id) }, unions, types, records)
			Own.Yield(outputs):
				var transferred = "${name}=${transfer_value(outputs.transfer)};"
				var position = 0
				for output_parameter in matched_join.carried:
					fact = join_parameter(output_parameter)
					match outputs.carried.get(position):
						None:
							failure = Some(render(fact.span, MissingJoinTransfer(fact.id)))
							break
						Some(transfer): transferred = "${transferred}${c_value(fact.id)}=${transfer_value(transfer)};"
					position = position.add(1)
				match failure:
					Some(error): Err(error)
					None: Ok("${transferred}goto ${done};")
		match ending:
			Err(error):
				failure = Some(error)
				break
			Ok(exit): arms = arms.append({ id = arm.id, inputs = arm.inputs, operations = arm.operations, ending = exit })

	transferred: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	selected ?= append_selection(declarations, scope, matched_join.selection, arms, unions, types, records, nearest)
	var joined = "${selected}${done}:;"
	for output_parameter in parameters:
		fact = join_parameter(output_parameter)
		-- Include Void and unused outputs, exactly as for ordinary value locals.
		joined = "${joined}(void)${c_value(fact.id)};"
		match output_parameter:
			UnmanagedJoinParameter(_): void
			ManagedJoinParameter(_, owner):
				match append_owner_alias(joined, owner, fact.id, fact.value_type, unions, fact.span):
					Ok(aliased): joined = aliased
					Err(error): failure = Some(error)
		if failure.is_some():
			break
	match failure:
		Some(error): Err(error)
		None: Ok(joined)


private pure func append_signature(
	output: String,
	function: OwnedFunction,
	index: Int,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	type_name ?= c_type(function.signature.return_type, unions, internal_span())
	parameters ?= c_parameters(function.signature.parameters, unions)
	Ok(
		"${output}${type_name} ${c_name(index)}${parameters}",
	)


private pure func transfer_value(result: ReturnTransfer) -> String:
	match result:
		UnmanagedReturn(id): c_value(id)
		OwnedReturn(_, owner): c_owner(owner)


private pure func append_return(output: String, result: ReturnTransfer) -> String:
	"${output}return ${transfer_value(result)};"


private pure func append_function(
	function: OwnedFunction,
	index: Int,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[String, Diagnostic]:
	header ?= append_signature("", function, index, unions)
	types ?= owner_types(function)
	body ?= append_ownership_operations("", function.operations, unions, types, records, None)
	Ok([header, "{", body, append_return("", function.result), "}"].join(""))


-- Unsigned addition wraps. Both signed casts below receive representable values;
-- the negative branch also stays within Int64 at UINT64_MAX - sum == INT64_MAX.
INTEGER_ADD_RUNTIME: String =
	|static int64_t blorp_int_add(int64_t first,int64_t second){uint64_t sum=(uint64_t)first+(uint64_t)second;return sum<=INT64_MAX?(int64_t)sum:-INT64_C(1)-(int64_t)(UINT64_MAX-sum);}
	|

-- Convert wrapped unsigned bits using only representable signed casts. Division
-- and remainder guard both zero and the sole overflowing signed quotient.
INTEGER_ARITHMETIC_RUNTIME: String =
	|int64_t blorp_int_signed(uint64_t value){return value<=INT64_MAX?(int64_t)value:-INT64_C(1)-(int64_t)(UINT64_MAX-value);}
	|int64_t blorp_int_subtract(int64_t first,int64_t second){return blorp_int_signed((uint64_t)first-(uint64_t)second);}
	|int64_t blorp_int_multiply(int64_t first,int64_t second){return blorp_int_signed((uint64_t)first*(uint64_t)second);}
	|int64_t blorp_int_divide(int64_t first,int64_t second){if(second==0)return 0;if(first==INT64_MIN&&second==-1)return INT64_MIN;return first/second;}
	|int64_t blorp_int_remainder(int64_t first,int64_t second){if(second==0||(first==INT64_MIN&&second==-1))return 0;return first%second;}
	|


-- The type under any List layers. A String or Float there, anywhere in a record,
-- union or function that specialization kept, selects its ABI prelude even when
-- no value of it is ever built: a phantom type argument keeps its record
-- (blorp_2/test/e2e/fixtures/record/phantom_union_fields.brp).
private pure func innermost_element(value_type: TypeRef) -> TypeRef:
	match value_type:
		ListType(element): innermost_element(element)
		_: value_type


-- The scalar helper preludes a program selects, read from its inventory: a
-- String or Float type selects its ABI prelude, and each runtime operation called
-- selects its own helper. Allocation headers follow from the layouts and the
-- argument vector from the entrypoint, which already own those facts.
private fixed record RuntimeRequirements {
	process: Bool,
	current_directory: Bool,
	file_read: Bool,
	file_write: Bool,
	string_types: Bool,
	float_types: Bool,
	integer_addition: Bool,
	integer_arithmetic: Bool,
	string_output: Bool,
	string_error_output: Bool,
	integer_parsing: Bool,
	string_equality: Bool,
	string_concatenation: Bool,
	string_integer_appending: Bool,
	string_slicing: Bool,
	float_formatting: Bool,
	float_parsing: Bool
}


private pure func runtime_requirements(inventory: ProgramInventory) -> RuntimeRequirements:
	var requirements: RuntimeRequirements = {
		process = False,
		current_directory = False,
		file_read = False,
		file_write = False,
		string_types = False,
		float_types = False,
		integer_addition = False,
		integer_arithmetic = False,
		string_output = False,
		string_error_output = False,
		integer_parsing = False,
		string_equality = False,
		string_concatenation = False,
		string_integer_appending = False,
		string_slicing = False,
		float_formatting = False,
		float_parsing = False,
	}

	for value_type in inventory.types:
		match innermost_element(value_type):
			StringType: requirements = { requirements | string_types = True }
			FloatType: requirements = { requirements | float_types = True }
			_: void

	for operation in inventory.runtime_calls:
		match operation:
			RunToFiles(_): requirements = { requirements | process = True }
			ReadFile(_): requirements = { requirements | file_read = True }
			WriteFile(_): requirements = { requirements | file_write = True }
			GetCurrentDirectory(_): requirements = { requirements | current_directory = True }
			IntAdd: requirements = { requirements | integer_addition = True }
			IntSubtract | IntMultiply | IntDivide | IntRemainder:
				requirements = { requirements | integer_arithmetic = True }
			StringPrint: requirements = { requirements | string_output = True }
			StringPrintError: requirements = { requirements | string_error_output = True }
			StringParseInt(_): requirements = { requirements | integer_parsing = True }
			StringEquals(_): requirements = { requirements | string_equality = True }
			StringConcat: requirements = { requirements | string_concatenation = True }
			StringAppendInt: requirements = { requirements | string_integer_appending = True }
			StringSlice(_): requirements = { requirements | string_slicing = True }
			FloatToString: requirements = { requirements | float_formatting = True }
			StringParseFloat(_): requirements = { requirements | float_parsing = True }
			ListRepeat(_) | ListLength(_) | ListGet(_, _) | ListAppend(_) | ListSet(_) | ListConcat(_):
				void
			IntEquals(_) | IntLessThan(_) | FloatAdd | FloatSubtract | FloatMultiply | FloatDivide | FloatRemainder | IntToString | StringLength | StringByteAt(_) | StringFromCodepoint(_):
				void
			FloatCopySign | FloatEquals(_) | FloatLessThan(_) | FloatIsNaN(_) | FloatIsFinite(_):
				void

	requirements


-- This table lives for one emission only. Its complete key is a projection
-- of concrete TypeRefs, not an ownership or layout authority. Stable sorting
-- and adjacent key equality avoid scanning existing helpers at each occurrence.
private fixed record ListLayout {
	element: TypeRef,
	key: ListElementKey
}


private pure func strip_list_layer(value_type: TypeRef) -> TypeRef:
	match value_type:
		ListType(element): element
		_: value_type


private pure func element_list_layouts(element: TypeRef) -> List[ListLayout]:
	var current = element
	var key = list_element_key(element)
	var remaining = list_key_depth(key)
	var layouts: List[ListLayout] = []
	layouts = layouts.append({ element = current, key = key })

	while remaining.greater_than(0):
		current = strip_list_layer(current)
		key = list_child_key(key)
		remaining = remaining.subtract(1)
		layouts = layouts.append({ element = current, key = key })

	layouts


private pure func type_list_layouts(value_type: TypeRef) -> List[ListLayout]:
	match value_type:
		ListType(element): element_list_layouts(element)
		_: []


-- One transient traversal item. H has no synthetic value definition, so its
-- types enter the value projection when this child interval is visited.
private fixed record EmissionBlock {
	headers: List[Own.OwnedLoopHeader],
	inputs: List[Own.OwnedJoinParameter],
	operations: List[OwnershipOperation]
}


private pure func function_blocks(function: OwnedFunction) -> List[EmissionBlock]:
	append_block([], function.operations, [], [])


private pure func append_selection_blocks(
	blocks: List[EmissionBlock], selection: Own.OwnedSelection,
) -> List[EmissionBlock]:
	var collected = blocks
	for node in selection.nodes:
		match node:
			Own.TestVariant(_, _, _, _) | Own.TestListLength(_, _, _, _) | Own.TestStringBytes(_, _, _, _): void
			Own.EnterArm(edge): collected = append_block(collected, edge.operations, [], [])
	collected


private pure func append_loop_blocks(
	blocks: List[EmissionBlock], block: Own.OwnedLoopBlock,
	headers: List[Own.OwnedLoopHeader], inputs: List[Own.OwnedJoinParameter],
) -> List[EmissionBlock]:
	append_loop_tail_blocks(append_block(blocks, block.operations, headers, inputs), block.tail)


private pure func append_loop_tail_blocks(
	blocks: List[EmissionBlock], tail: Own.OwnedLoopTail,
) -> List[EmissionBlock]:
	var collected = blocks
	match tail:
		Own.ExitLoop(_): void
		Own.MatchLoop(matched):
			collected = append_selection_blocks(collected, matched.selection)
			for arm in matched.arms:
				collected = append_loop_blocks(collected, arm.body, [], arm.inputs)
	collected


private pure func append_block(
	blocks: List[EmissionBlock], operations: List[OwnershipOperation],
	headers: List[Own.OwnedLoopHeader], inputs: List[Own.OwnedJoinParameter],
) -> List[EmissionBlock]:
	var collected: List[EmissionBlock] = blocks.append({ headers = headers, inputs = inputs, operations = operations })
	for operation in operations:
		match operation:
			ExecuteJoin(join):
				collected = append_selection_blocks(collected, join.selection)
				for arm in join.arms:
					collected = append_block(collected, arm.operations, [], arm.inputs)
					match arm.exit:
						Own.Yield(_): void
						Own.TransferLoop(_, tail): collected = append_loop_tail_blocks(collected, tail)
			ExecuteLoop(loop):
				acquisitions: List[OwnershipOperation] = loop.entry_acquisitions.map(pure func(acquisition):
					AcquireOwner(acquisition.owner, acquisition.borrow, join_parameter(loop.result).span)
				)
				collected = append_block(collected, acquisitions, [], [])
				collected = append_loop_blocks(collected, loop.body, loop.headers, [])
			DefineValue(_) | AcquireOwner(_, _, _) | DropOwner(_, _): void
	collected


-- What emission inventories, found in one walk of the verified program: the
-- type of every declared field and payload and of every defined value, and
-- every runtime operation called. The list layouts read the types, the list
-- update helpers read the calls and the runtime requirements read both, so none
-- of them walks the program again. A signature type needs no entry of its own
-- because the verifier ties it to a defined value: a parameter's definition
-- takes its type from the signature, a call result must match the callee's
-- return type, and the returned value must match the function's.
private fixed record ProgramInventory {
	types: List[TypeRef],
	runtime_calls: List[RuntimeOperation[VariantInstanceId, TypeRef]],
	list_updates: List[ListUpdateHelper],
	callable_entries: List[OwnedDefinition]
}


private pure func program_inventory(program: OwnershipProgram) -> ProgramInventory:
	var types: List[TypeRef] = []
	var runtime_calls: List[RuntimeOperation[VariantInstanceId, TypeRef]] = []
	var list_updates: List[ListUpdateHelper] = []
	var callable_entries: List[OwnedDefinition] = []

	for layout in program.records:
		for field in record_fields(layout):
			types = types.append(field)

	for layout in program.unions:
		for fields in union_variants(layout):
			for value_type in fields:
				types = types.append(value_type)

	for function in program.functions:
		for block in function_blocks(function):
			for header in block.headers:
				types = types.append(join_parameter(header.parameter).value_type)
			for input in block.inputs:
				types = types.append(join_parameter(input).value_type)
			for operation in block.operations:
				match operation:
					DefineValue(definition):
						types = types.append(definition.value_type)
						body: Option[Concrete.FunctionInstanceId] = match definition.operation:
							FreeCallableDefinition(id): Some(id)
							CapturedCallableDefinition(id, _): Some(id)
							_: None
						match body:
							None: void
							Some(id):
								-- These verified definitions are disposable emission entries,
								-- keyed by their code entry and full concrete signature.
								duplicate = callable_entries.any(pure func(previous):
									match previous.operation:
										FreeCallableDefinition(other): and(function_number(id) == function_number(other), Concrete.same_type(definition.value_type, previous.value_type))
										CapturedCallableDefinition(other, _): and(function_number(id) == function_number(other), Concrete.same_type(definition.value_type, previous.value_type))
										_: False
								)
								if duplicate.not():
									callable_entries = callable_entries.append(definition)
						match definition.operation:
							CallDefinition(target, _):
								match target:
									RuntimeFunction(runtime):
										runtime_calls = runtime_calls.append(runtime)
										match call_list_update(runtime):
											Some(helper): list_updates = list_updates.append(helper)
											None: void
									_: void
							ListSuffixDefinition(_, _):
								match definition.value_type:
									ListType(element): list_updates = list_updates.append(update_helper(SuffixUpdate, element))
									_: void
							_: void
					ExecuteJoin(join):
						for output in [join.result].concat(join.carried):
							types = types.append(join_parameter(output).value_type)
					ExecuteLoop(loop):
						for output in [loop.result].concat(loop.carried):
							types = types.append(join_parameter(output).value_type)
					AcquireOwner(_, _, _) | DropOwner(_, _):
						void

	for value in callable_types(types):
		match value:
			CallableType(parameters, result): types = types.concat(parameters).append(result)
			_: void
	{ types = types, runtime_calls = runtime_calls, list_updates = list_updates, callable_entries = callable_entries }


private pure func list_layouts(inventory: ProgramInventory) -> List[ListLayout]:
	var layouts: List[ListLayout] = []

	for value_type in inventory.types:
		for layout in type_list_layouts(value_type):
			layouts = layouts.append(layout)

	ordered = layouts
		.sort_by(pure func(layout): list_key_ordinal(layout.key))
		.sort_by(pure func(layout): list_key_rank(layout.key))
		.sort_by(pure func(layout): list_key_depth(layout.key))
	var unique: List[ListLayout] = []
	var previous: Option[ListElementKey] = None
	for layout in ordered:
		duplicate = if list_key_is_callable(layout.key):
			-- Structural signatures share the non-nominal sort ordinal; use the
			-- complete typed key, including nonadjacent equal signatures.
			unique.any(pure func(other): same_list_key(other.key, layout.key))
		else:
			match previous:
				Some(key): same_list_key(key, layout.key)
				None: False
		if duplicate.not():
			unique = unique.append(layout)
			previous = Some(layout.key)
	unique


-- An update helper is emitted only where its operation is called. The
-- helper list is deduplicated by scanning its own entries: there are at most
-- four per element layout, so the scan stays small for any call count.
private fixed record ListUpdateHelper {
	update: ListUpdate,
	layout: ListLayout
}


private pure func same_list_update(left: ListUpdate, right: ListUpdate) -> Bool:
	match left:
		AppendUpdate:
			match right:
				AppendUpdate: True
				_: False
		SetUpdate:
			match right:
				SetUpdate: True
				_: False
		ConcatUpdate:
			match right:
				ConcatUpdate: True
				_: False
		SuffixUpdate:
			match right:
				SuffixUpdate: True
				_: False


private pure func update_helper(update: ListUpdate, element: TypeRef) -> ListUpdateHelper:
	{ update = update, layout = { element = element, key = list_element_key(element) } }


private pure func call_list_update(operation: RuntimeOperation[VariantInstanceId, TypeRef]) -> Option[ListUpdateHelper]:
	match operation:
		ListAppend(element): Some(update_helper(AppendUpdate, element))
		ListSet(element): Some(update_helper(SetUpdate, element))
		ListConcat(element): Some(update_helper(ConcatUpdate, element))
		_: None


private pure func list_update_helpers(inventory: ProgramInventory) -> List[ListUpdateHelper]:
	var unique: List[ListUpdateHelper] = []
	for helper in inventory.list_updates:
		var known: Bool = False
		for existing in unique:
			match same_list_update(existing.update, helper.update):
				False: void
				True:
					if same_list_key(existing.layout.key, helper.layout.key):
						known = True
						break
		match known:
			True: void
			False: unique = unique.append(helper)
	unique


private pure func append_list_prototypes(output: String, layouts: List[ListLayout]) -> String:
	if layouts.is_empty():
		output
	else:
		var fragments: List[String] = [output]
		for layout in layouts:
			suffix = list_suffix(layout.key)
			type_name = list_c_type(layout.key)
			fragment = "struct blorp_l_${suffix};void blorp_list_dup_${suffix}(${type_name});void blorp_list_drop_${suffix}(${type_name});"
			fragments = fragments.append(fragment)
		fragments.join("")


-- The element C type and the stored-occurrence fragments every helper of one
-- List layout stores and destroys through.
private fixed record ElementFragments {
	type_name: String,
	acquire: String,
	destroy: String
}


private pure func element_fragments(
	layout: ListLayout,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[ElementFragments, Diagnostic]:
	-- Nested helpers use the precomputed suffix key. Rewalking the TypeRef at
	-- every suffix would make a single deeply nested List require quadratic work.
	if list_key_depth(layout.key).greater_than(0):
		child = list_child_key(layout.key)
		suffix = list_suffix(child)
		Ok({
			type_name = list_c_type(child),
			acquire = "blorp_list_dup_${suffix}(element);",
			destroy = "blorp_list_drop_${suffix}(element);",
		})
	else:
		terminal_element_fragments(layout.element, unions, records)


private pure func terminal_element_fragments(
	element: TypeRef,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[ElementFragments, Diagnostic]:
	type_name ?= c_type(element, unions, internal_span())
	needs_owner ?= value_needs_ownership(element, unions, records)
	acquire: String ?= match needs_owner:
		False: Ok("")
		True: append_storage_operation("", element, DuplicateValue, "element", unions, internal_span())
	destroy: String ?= match needs_owner:
		False: Ok("")
		True: append_storage_operation("", element, DestroyValue, "element", unions, internal_span())
	Ok({ type_name = type_name, acquire = acquire, destroy = destroy })


private pure func list_runtime_fragment(
	layout: ListLayout,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[String, Diagnostic]:
	element ?= element_fragments(layout, unions, records)
	Ok(list_runtime(layout.key, element.type_name, element.acquire, element.destroy))


private pure func append_list_updates(
	output: String,
	helpers: List[ListUpdateHelper],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[String, Diagnostic]:
	if helpers.is_empty():
		Ok(output)
	else:
		var fragments: List[String] = [output]
		var failure: Option[Diagnostic] = None
		-- At most four helpers share one layout, so recomputing its few
		-- fragments costs less than keying them from the layout table.
		for helper in helpers:
			match element_fragments(helper.layout, unions, records):
				Err(error):
					failure = Some(error)
					break
				Ok(element):
					fragments = fragments.append(list_update_runtime(helper.update, helper.layout.key, element.type_name, element.acquire, element.destroy))
		match failure:
			Some(error): Err(error)
			None: Ok(fragments.join("\n"))


private pure func append_list_runtime(
	output: String,
	layouts: List[ListLayout],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[String, Diagnostic]:
	if layouts.is_empty():
		Ok(output)
	else:
		var fragments: List[String] = [output, LIST_CAPACITY_RUNTIME]
		var failure: Option[Diagnostic] = None
		for layout in layouts:
			fragment = list_runtime_fragment(layout, unions, records)
			match fragment:
				Err(error):
					failure = Some(error)
					break
				Ok(completed):
					fragments = fragments.append(completed)
		match failure:
			Some(error): Err(error)
			None: Ok(fragments.join("\n"))


private pure func aggregate_runtime_contents(
	checked: OwnershipProgram,
	lists: List[ListLayout],
	helpers: List[ListUpdateHelper],
	callables: List[TypeRef],
) -> Result[String, Diagnostic]:
	-- The host copies a `var` list on each append after a `?=` that follows its declaration.
	-- Both `?=` therefore precede `fragments`; `ready ?=` follows the loops and costs one copy.
	ordered ?= append_aggregate_definitions(checked.records, checked.unions)
	completed ?= append_list_runtime("", lists, checked.unions, checked.records)
	updates ?= append_list_updates("", helpers, checked.unions, checked.records)
	ops ?= callable_ops(callables, checked.unions)
	var fragments: List[String] = [callable_declarations(callables), append_list_prototypes("", lists)]
	var index: Int = 0

	-- Complete declarations and helper groups end physical C lines so GCC can
	-- retain column tracking and its diagnostics for the generated runtime.
	for layout in checked.records:
		typedef_prefix: String = "typedef struct blorp_r_"
			.append_int(index)
		pointer_marker: String = match layout:
			InlineFields(_):
				" "
			CountedFields(_):
				"* "
		fragments = fragments.append("${typedef_prefix}${pointer_marker}blorp_r_${index.to_string()};\n")
		index = index.add(1)

	index = 0

	for _ in checked.records:
		fragments = fragments.append("${append_record_prototypes("", index)}\n")
		index = index.add(1)

	fragments = fragments.append(append_boxed_union_prototypes("", checked.unions))
	fragments = fragments.append(ordered)
	index = 0
	var failure: Option[Diagnostic] = None

	for layout in checked.records:
		match append_record_ownership("", layout, index, checked.unions):
			Ok(ownership):
				fragments = fragments.append("${ownership}\n")
			Err(error):
				failure = Some(error)
				break

		index = index.add(1)

	ready: Void ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	arguments = match checked.entrypoint:
		WithArguments(_, _): arguments_runtime()
		NoArguments(_, _): ""
	fragments = fragments.concat([completed, updates, arguments, ops])
	Ok(fragments.join(""))


-- Boxed union nodes need the allocation and atomic headers like managed records.
private pure func has_boxed_union(unions: List[ConcreteUnion]) -> Bool:
	var boxed: Bool = False

	for layout in unions:
		if union_is_boxed(layout):
			boxed = True
			break

	boxed


pure func aggregate_runtime(program: VerifiedProgram) -> Result[String, Diagnostic]:
	checked = verified_contents(program)
	inventory = program_inventory(checked)
	aggregate_runtime_contents(checked, list_layouts(inventory), list_update_helpers(inventory), callable_types(inventory.types))


pure func emit(program: VerifiedProgram) -> Result[String, Diagnostic]:
	checked = verified_contents(program)
	records = checked.records
	inventory = program_inventory(checked)
	requirements = runtime_requirements(inventory)
	lists = list_layouts(inventory)
	aggregates ?= aggregate_runtime_contents(checked, lists, list_update_helpers(inventory), callable_types(inventory.types))

	-- C is collected as fragments and joined once; appending each one to the
	-- whole output would copy everything emitted so far at every step. The host
	-- compiler copies a `var` list on every append that comes after a `?=`
	-- placed between the list's declaration and that append, so no `?=` may sit
	-- between this declaration and the loops below.
	prelude = if requirements.string_types:
		string_runtime()
	else:
		"#include <stdint.h>\n"
	var fragments: List[String] = if requirements.process:
		[PROCESS_POSIX_PRELUDE, MEMORY_RUNTIME, prelude]
	else:
		[MEMORY_RUNTIME, prelude]

	needs_allocation_headers: Bool = match lists.is_empty().not():
		True: True
		False:
			match checked.records.any(pure func(layout):
					match layout:
						CountedFields(_):
							True
						InlineFields(_):
							False
				):
				True: True
				False: has_boxed_union(checked.unions)
	if needs_allocation_headers:
		fragments = fragments.append("#include <stdlib.h>\n#include <stdatomic.h>\n")

	if requirements.float_types:
		fragments = fragments.append(float_runtime())

	if requirements.float_formatting:
		fragments = fragments.append(float_string_runtime())

	if requirements.float_parsing:
		fragments = fragments.append(float_parse_runtime())

	if requirements.integer_addition:
		fragments = fragments.append(INTEGER_ADD_RUNTIME)

	if requirements.integer_arithmetic:
		fragments = fragments.append(INTEGER_ARITHMETIC_RUNTIME)

	if requirements.string_output:
		fragments = fragments.append(string_print_runtime())

	if requirements.string_error_output:
		fragments = fragments.append(STRING_PRINT_ERROR_RUNTIME)

	if requirements.file_read:
		fragments = fragments.append(SYSTEM_READ_FILE_RUNTIME)

	if requirements.file_write:
		fragments = fragments.append(SYSTEM_WRITE_FILE_RUNTIME)

	if requirements.current_directory:
		fragments = fragments.append(SYSTEM_CURRENT_DIRECTORY_RUNTIME)

	if requirements.integer_parsing:
		fragments = fragments.append(string_parse_int_runtime())

	if requirements.string_equality:
		fragments = fragments.append(string_equals_runtime())

	if requirements.string_concatenation.or(requirements.string_integer_appending):
		fragments = fragments.append(STRING_CONCAT_RUNTIME)

	if requirements.string_integer_appending:
		fragments = fragments.append(STRING_APPEND_INT_RUNTIME)

	if requirements.string_slicing:
		fragments = fragments.append(STRING_SLICE_RUNTIME)

	fragments = fragments.append(aggregates)
	if requirements.process:
		fragments = fragments.append(process_runtime(list_c_type(list_element_key(StringType))))
	var index: Int = 0
	var failure: Option[Diagnostic] = None

	index = 0

	for function in checked.functions:
		match append_signature("", function, index, checked.unions):
			Err(error):
				failure = Some(error)
				break
			Ok(signature):
				fragments = fragments.append("${signature};")

		index = index.add(1)

	if failure.is_some().not():
		for entry in inventory.callable_entries:
			match append_callable_entry(entry, checked):
				Ok(adapter): fragments = fragments.append(adapter)
				Err(error):
					failure = Some(error)
					break

	if failure.is_some().not():
		index = 0

		for function in checked.functions:
			match append_function(function, index, checked.unions, records):
				Err(error):
					failure = Some(error)
					break
				Ok(function_code):
					-- Each definition ends its line. Clang's -Wmisleading-indentation
					-- slows sharply with line length, and one line of every body
					-- dominated test compile time. GCC skips that check on very
					-- long lines, so it now runs it and compiles somewhat slower.
					fragments = fragments.append("${function_code}\n")

			index = index.add(1)

	match failure:
		Some(error):
			Err(error)
		None:
			output = fragments.join("")
			name = c_name(function_number(entry_function(checked.entrypoint)))

			wrapper = match checked.entrypoint:
				NoArguments(_, IntegerExitStatus):
					"${output}int main(void){blorp_memory_start();return blorp_memory_finish((int)${name}());}\n"
				NoArguments(_, SuccessfulExit):
					"${output}int main(void){blorp_memory_start();(void)${name}();return blorp_memory_finish(0);}\n"
				WithArguments(_, result):
					prefix = output.concat(
						"int main(int argc,char **argv){blorp_memory_start();struct blorp_l_0_s *const blorp_arguments=blorp_list_from_argv(argc,argv);",
					).concat(
						"if(blorp_arguments==NULL){fputs(\"error: command-line argument is not valid UTF-8\\nhelp: pass UTF-8 encoded arguments\\n\",stderr);return blorp_memory_finish(1);}",
					)

					match result:
						IntegerExitStatus:
							"${prefix}const int64_t blorp_result=${name}(blorp_arguments);blorp_list_drop_0_s(blorp_arguments);"
								.concat("return blorp_memory_finish((int)blorp_result);}\n")
						SuccessfulExit:
							"${prefix}(void)${name}(blorp_arguments);blorp_list_drop_0_s(blorp_arguments);return blorp_memory_finish(0);}\n"

			Ok(wrapper)
