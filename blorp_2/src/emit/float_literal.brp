import:
	string: String methods_only
	option: Option methods_only
	bool: not
	float: Float methods_only
	int: Int methods_only
	../utils/text: concat


-- Binary64 has 52 fractional bits, exactly thirteen hexadecimal digits.
private HEX_FRACTION_DIGITS: Int = 13

private HEX_DIGITS: String = "0123456789abcdef"


-- Project the value, never its source spelling. Powers of two and the digit
-- extraction below are exact for finite binary64, including subnormals.
pure func c_float_literal(value: Float) -> String:
	negative = 1.0.copysign(value).less_than(
		0.0,
	)

	if value.is_nan():
		"NAN"
	else if value.is_finite().not():
		if negative:
			"(-INFINITY)"
		else:
			"INFINITY"
	else if value == 0.0:
		if negative:
			"-0x0p+0"
		else:
			"0x0p+0"
	else:
		var magnitude = value.abs()
		var exponent = 0

		-- At most 1,023 divisions or 1,074 multiplications normalize a
		-- finite nonzero binary64; there is no rounding during either loop.
		while magnitude.greater_than_or_equal(2.0):
			magnitude = magnitude.divide(2.0)
			exponent = exponent.add(1)

		while magnitude.less_than(1.0):
			magnitude = magnitude.multiply(2.0)
			exponent = exponent.subtract(1)

		var output = if negative:
			"-0x1."
		else:
			"0x1."

		var fraction = magnitude.subtract(1.0)
		var position = 0

		while position.less_than(HEX_FRACTION_DIGITS):
			fraction = fraction.multiply(16.0)
			-- Keep extraction in exact arithmetic: the host numeric cast
			-- wrappers currently resolve recursively. A digit needs at most
			-- fifteen subtractions and no conversion between primitive types.
			var digit = 0

			while fraction.greater_than_or_equal(1.0):
				fraction = fraction.subtract(1.0)
				digit = digit.add(1)

			-- At most fifteen subtractions select one of sixteen ASCII digits.
			digit_text = HEX_DIGITS.slice(digit, digit.add(1)).get_or("")
			output = output.concat(digit_text)
			position = position.add(1)

		output = "${output}p"

		if exponent.greater_than_or_equal(0):
			output = "${output}+"

		output.append_int(exponent)
