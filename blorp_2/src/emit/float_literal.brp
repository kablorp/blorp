import:
	float as FloatOps
	int as IntOps
	../utils/text: concat


-- Binary64 has 52 fractional bits, exactly thirteen hexadecimal digits.
private HEX_FRACTION_DIGITS: Int = 13

private HEX_DIGITS: String = "0123456789abcdef"


-- Project the value, never its source spelling. Powers of two and the digit
-- extraction below are exact for finite binary64, including subnormals.
pure func c_float_literal(value: Float) -> String:
	negative = FloatOps.less_than(
		FloatOps.copysign(1.0, value),
		0.0,
	)

	if FloatOps.is_nan(value):
		"NAN"
	else if not FloatOps.is_finite(value):
		if negative:
			"(-INFINITY)"
		else:
			"INFINITY"
	else if FloatOps.equals(value, 0.0):
		if negative:
			"-0x0p+0"
		else:
			"0x0p+0"
	else:
		var magnitude = FloatOps.abs(value)
		var exponent = 0

		-- At most 1,023 divisions or 1,074 multiplications normalize a
		-- finite nonzero binary64; there is no rounding during either loop.
		while FloatOps.greater_than_or_equal(magnitude, 2.0):
			magnitude = FloatOps.divide(magnitude, 2.0)
			exponent = IntOps.add(exponent, 1)

		while FloatOps.less_than(magnitude, 1.0):
			magnitude = FloatOps.multiply(magnitude, 2.0)
			exponent = IntOps.subtract(exponent, 1)

		var output = if negative:
			"-0x1."
		else:
			"0x1."

		var fraction = FloatOps.subtract(magnitude, 1.0)
		var position = 0

		while IntOps.less_than(position, HEX_FRACTION_DIGITS):
			fraction = FloatOps.multiply(fraction, 16.0)
			-- Keep extraction in exact arithmetic: the host numeric cast
			-- wrappers currently resolve recursively. A digit needs at most
			-- fifteen subtractions and no conversion between primitive types.
			var digit = 0

			while FloatOps.greater_than_or_equal(fraction, 1.0):
				fraction = FloatOps.subtract(fraction, 1.0)
				digit = IntOps.add(digit, 1)

			output = output.concat(HEX_DIGITS.substring(digit, 1))
			position = IntOps.add(position, 1)

		output = output.concat("p")

		if IntOps.greater_than_or_equal(exponent, 0):
			output = output.concat("+")

		output.append_int(exponent)
