import:
	string: String methods
	option: Option methods
	bool: not
	float: Float methods
	int: Int methods
	../utils/text: concat


-- Binary64 has 52 fractional bits, exactly thirteen hexadecimal digits.
private HEX_FRACTION_DIGITS: Int = 13

private HEX_DIGITS: String = "0123456789abcdef"


-- Project the value, never its source spelling. Powers of two and the digit
-- extraction below are exact for finite binary64, including subnormals.
pure func c_float_literal(value: Float) -> String:
	negative = 1.0.copysign(value) < 0.0

	if value.is_nan():
		"NAN"
	else if value.is_finite().not():
		if negative:
			"(-INFINITY)"
		else:
			"INFINITY"
	else if value == 0.0:
		if negative:
			"-0x0p+0"
		else:
			"0x0p+0"
	else:
		var magnitude = value.abs()
		var exponent = 0

		-- At most 1,023 divisions or 1,074 multiplications normalize a
		-- finite nonzero binary64; there is no rounding during either loop.
		while magnitude >= 2.0:
			magnitude = magnitude / 2.0
			exponent = exponent + 1

		while magnitude < 1.0:
			magnitude = magnitude * 2.0
			exponent = exponent - 1

		var output = if negative:
			"-0x1."
		else:
			"0x1."

		var fraction = magnitude - 1.0
		var position = 0

		while position < (HEX_FRACTION_DIGITS):
			fraction = fraction * 16.0
			-- Keep extraction in exact arithmetic: the host numeric cast
			-- wrappers currently resolve recursively. A digit needs at most
			-- fifteen subtractions and no conversion between primitive types.
			var digit = 0

			while fraction >= 1.0:
				fraction = fraction - 1.0
				digit = digit + 1

			-- At most fifteen subtractions select one of sixteen ASCII digits.
			digit_text = HEX_DIGITS.slice(digit, digit + 1).get_or("")
			output = output.concat(digit_text)
			position = position + 1

		output = "${output}p"

		if exponent >= 0:
			output = "${output}+"

		output.append_int(exponent)
