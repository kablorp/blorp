import:
	int: Int methods
	../lower/lower: ValueId, value_number
	../own/own: OwnerId, owner_number
	../specialize/specialize: RecordInstanceId, UnionInstanceId, record_number, union_number
	../utils/syntax: Diagnostic, Span
	../utils/text: concat


-- Aggregate worklists hold catalogue indices, not newly issued identities.
fixed union AggregateKind:
	RecordAggregate
	UnionAggregate


fixed union EmissionFailure:
	MissingUnionLayout(UnionInstanceId)
	MissingRecordLayout(RecordInstanceId)
	MissingOwnerType(OwnerId)
	MissingValueType(ValueId)
	MissingRuntimeArgument(ValueId, Int)
	MissingJoinTransfer(ValueId)
	StatementOnlyValue(ValueId)
	MissingAggregateWorkItem(Int)
	MissingAggregateVisit(AggregateKind, Int)
	CyclicByValueAggregate(AggregateKind, Int)
	MissingAggregateLayout(AggregateKind, Int)
	MissingAggregateMember(AggregateKind, Int, Int)
	MissingUnionPayloadField(Int, Int, Int)


private pure func aggregate_name(kind: AggregateKind) -> String:
	match kind:
		RecordAggregate: "record"
		UnionAggregate: "union"


pure func render(span: Span, failure: EmissionFailure) -> Diagnostic:
	message = match failure:
		MissingUnionLayout(id): "missing emitted union layout #".append_int(union_number(id))
		MissingRecordLayout(id): "missing emitted record layout #".append_int(record_number(id))
		MissingOwnerType(id): "missing emitted owner type #".append_int(owner_number(id))
		MissingValueType(id): "missing emitted value type #".append_int(value_number(id))
		MissingRuntimeArgument(id, argument): "missing runtime argument #${argument.to_string()} for value #${value_number(id).to_string()}"
		MissingJoinTransfer(id): "missing verified join transfer for value #".append_int(value_number(id))
		StatementOnlyValue(id): "value #${value_number(id).to_string()} requires statement emission"
		MissingAggregateWorkItem(index): "missing aggregate work item #".append_int(index)
		MissingAggregateVisit(kind, index): "missing ${aggregate_name(kind)} aggregate visit #${index.to_string()}"
		CyclicByValueAggregate(kind, index): "by-value dependency cycle at ${aggregate_name(kind)} aggregate #${index.to_string()}"
		MissingAggregateLayout(kind, index): "missing ${aggregate_name(kind)} aggregate layout #${index.to_string()}"
		MissingAggregateMember(kind, index, member):
			label = match kind:
				RecordAggregate: "field"
				UnionAggregate: "variant"
			"missing ${label} #${member.to_string()} of ${aggregate_name(kind)} aggregate #${index.to_string()}"
		MissingUnionPayloadField(owner, variant, field): "missing field #${field.to_string()} of variant #${variant.to_string()} of union aggregate #${owner.to_string()}"
	{
		span = span,
		note = None,
		message = "internal compiler error: ${message}",
		help = "report this compiler error with the input program"
	}
