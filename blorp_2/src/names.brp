import:
	int as IntOps
	text: equals


-- IDs are scoped to one table and its extensions, never to another parse.
opaque type NameId = Int


fixed record SpecialNames {
	main: NameId,
	integer: NameId
}


opaque type NameTable = List[String]


fixed record InitialNames {
	names: NameTable,
	special: SpecialNames
}


pure func initial_names() -> InitialNames:
	var spellings: List[String] = []
	main = into_opaque NameId(spellings.length())
	spellings = spellings.append("main")
	integer = into_opaque NameId(spellings.length())
	-- Bootstrap bridge until the pilot resolves prelude_temp's declaration.
	spellings = spellings.append("Int")
	{
		names = into_opaque NameTable(spellings),
		special = {
			main = main,
			integer = integer
		}
	}


pure func same_name(left: NameId, right: NameId) -> Bool:
	IntOps.equals(from_opaque NameId(left), from_opaque NameId(right))


pure func name_spelling(names: NameTable, id: NameId) -> Option[String]:
	from_opaque NameTable(names).get(from_opaque NameId(id))


-- String lookup belongs to the parser's local builder, before publication.
pure func find_name(names: NameTable, spelling: String) -> Option[NameId]:
	spellings = from_opaque NameTable(names)
	var index: Int = 0
	var found: Option[NameId] = None

	for known in spellings:
		if equals(known, spelling):
			found = Some(into_opaque NameId(index))
			break

		index = IntOps.add(index, 1)

	found


pure func intern_name(names: NameTable, spelling: String) -> NameTable:
	match find_name(names, spelling):
		Some(_):
			names
		None:
			into_opaque NameTable(from_opaque NameTable(names).append(spelling))
