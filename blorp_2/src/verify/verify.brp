import:
	../namespace/builtins as Builtins:
		RuntimeResult(ValueResult, OptionalResult, BooleanResult),
		runtime_contract,
	float as FloatOps
	int as IntOps
	list: contains
	../lower/lower: MatchLabel(DefaultLabel, VariantLabel), ValueId, value_number
