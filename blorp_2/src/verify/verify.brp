-- Concrete representation is an upstream fact, shared with insertion.
-- Verification independently validates the actual raw operations and layouts;
-- it does not consume insertion's decisions about owners or borrow lifetimes.
-- This seal belongs to the exact operations and contracts checked below.
opaque type VerifiedProgram = OwnershipProgram


pure func verified_contents(program: VerifiedProgram) -> OwnershipProgram:
	from_opaque VerifiedProgram(program)


private pure func verification_error(span: Span, message: String) -> Diagnostic:
	{
		span = span,
		note = None,
		message = "ownership verification failed: ".concat(message),
		help = "report this compiler error with the input program"
	}


-- List storage ownership is a root fact. Raw IR must also name a member of
-- each supplied concrete catalogue; do not expand nominal fields per query.
private pure func verify_type_membership(
	value_type: TypeRef,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
	span: Span,
) -> Result[Void, Diagnostic]:
	var terminal = value_type
	while True:
		match terminal:
			ListType(element): terminal = element
			VoidType | IntType | FloatType | StringType | RecordType(_) | UnionType(_): break
	match value_ownership(terminal, unions, records):
		Ok(_): Ok(void)
		Err(error): Err({ error | span = span })


private fixed record KnownValue {
	value_type: TypeRef,
	span: Span,
	result: ResultOwnership,
	projection_parent: Option[BorrowedValue]
}


private fixed union OwnerState:
	ActiveOwner(ValueId)
	DischargedOwner


-- One block enclosing the block being verified, as of the join or tail
-- match that entered it: the function's prefix or an enclosing arm, with its
-- consecutive values and owners. It is a shared view: a nested block flags
-- the enclosing owners it discharges instead of changing it.
private fixed record EnclosingScope {
	first_value: Int,
	values: List[KnownValue],
	first_owner: Int,
	owners: List[OwnerState]
}


-- Whether a block may discharge enclosing owners. A tail arm discharges the
-- function prefix's on its way out; a join arm continues into its join, so
-- every enclosing owner must stay live through it.
private fixed union EnclosingDischarge:
	MayDischargeEnclosing
	KeepsEnclosing


private fixed record VerificationFacts {
	enclosing: List[EnclosingScope],
	enclosing_discharge: EnclosingDischarge,
	first_value: Int,
	values: List[KnownValue],
	first_owner: Int,
	parameters: List[ValueId]
}


-- `discharged` flags the enclosing owners discharged so far, those the block
-- was entered with included, by owner number. A nested block shares its
-- parent's flags until its first discharge copies them.
private fixed record VerificationState {
	facts: VerificationFacts,
	discharged: List[Bool],
	owners: List[OwnerState]
}


private fixed union ProjectionContext:
	NoProjection
	PayloadProjection(OwnedArgument, VariantInstanceId)


private pure func known_value(
	state: VerificationFacts,
	id: ValueId,
	span: Span,
) -> Result[KnownValue, Diagnostic]:
	error = verification_error(
		span,
		"value "
			.append_int(value_number(id))
			.concat(" is not defined before use"),
	)
	ordinal = value_number(id)
	var entry: Option[KnownValue] = None

	if IntOps.greater_than_or_equal(ordinal, state.first_value):
		entry = state.values.get(IntOps.subtract(ordinal, state.first_value))
	else:
		for scope in state.enclosing:
			if IntOps.greater_than_or_equal(ordinal, scope.first_value) and IntOps.less_than(ordinal, IntOps.add(scope.first_value, scope.values.length())):
				entry = scope.values.get(IntOps.subtract(ordinal, scope.first_value))
				break

	entry.to_result(error)


-- An owner's slot: an enclosing owner by ordinal, or a local one by index.
private fixed union OwnerSlot:
	EnclosingSlot(Int)
	LocalSlot(Int)


-- An enclosing owner's state when its block was entered.
private pure func enclosing_owner(state: VerificationFacts, ordinal: Int) -> Option[OwnerState]:
	var found: Option[OwnerState] = None
	for scope in state.enclosing:
		if IntOps.greater_than_or_equal(ordinal, scope.first_owner) and IntOps.less_than(ordinal, IntOps.add(scope.first_owner, scope.owners.length())):
			found = scope.owners.get(IntOps.subtract(ordinal, scope.first_owner))
			break
	found


private pure func owner_slot(
	state: VerificationFacts,
	owner_count: Int,
	id: OwnerId,
	span: Span,
) -> Result[OwnerSlot, Diagnostic]:
	ordinal = owner_number(id)
	first_owner = state.first_owner

	match enclosing_owner(state, ordinal):
		Some(_):
			Ok(EnclosingSlot(ordinal))
		None:
			if IntOps.greater_than_or_equal(ordinal, 0) and IntOps.less_than(ordinal, first_owner):
				Err(
					verification_error(
						span,
						"owner "
							.append_int(ordinal)
							.concat(" is not available in this match arm"),
					),
				)
			else if IntOps.greater_than_or_equal(ordinal, first_owner) and IntOps.less_than(
				ordinal,
				IntOps.add(first_owner, owner_count),
			):
				Ok(LocalSlot(IntOps.subtract(ordinal, first_owner)))
			else:
				Err(
					verification_error(
						span,
						"owner "
							.append_int(ordinal)
							.concat(" is not defined"),
					),
				)


private pure func discharged_already(discharged: List[Bool], ordinal: Int) -> Bool:
	match discharged.get(ordinal):
		Some(flag): flag
		None: False


-- Discharges enclosing owner `ordinal`, which only a block that may do so can.
private pure func discharge(state: VerificationFacts, discharged: List[Bool], ordinal: Int, span: Span) -> Result[List[Bool], Diagnostic]:
	match state.enclosing_discharge:
		KeepsEnclosing:
			Err(verification_error(span, "owner ".append_int(ordinal).concat(" is discharged before its join")))
		MayDischargeEnclosing:
			var flags = discharged
			while IntOps.less_than(flags.length(), IntOps.add(ordinal, 1)):
				flags = flags.append(False)
			Ok(flags.set(ordinal, True))


private pure func known_owner(
	state: VerificationFacts,
	discharged: List[Bool],
	owners: List[OwnerState],
	id: OwnerId,
	span: Span,
) -> Result[OwnerState, Diagnostic]:
	slot ?= owner_slot(state, owners.length(), id, span)

	entry = match slot:
		EnclosingSlot(ordinal):
			if discharged_already(discharged, ordinal):
				Some(DischargedOwner)
			else:
				enclosing_owner(state, ordinal)
		LocalSlot(index):
			owners.get(index)

	entry.to_result(
		verification_error(
			span,
			"owner "
				.append_int(owner_number(id))
				.concat(" is not defined"),
		),
	)


private pure func validate_next_owner(
	first_owner: Int,
	owners: List[OwnerState],
	id: OwnerId,
	span: Span,
) -> Result[Void, Diagnostic]:
	ordinal = owner_number(id)
	next_owner = IntOps.add(first_owner, owners.length())

	if IntOps.less_than(ordinal, 0):
		Err(verification_error(span, "negative owner identity"))
	else if IntOps.less_than(ordinal, next_owner):
		Err(
			verification_error(
				span,
				"owner "
					.append_int(ordinal)
					.concat(" is defined more than once"),
			),
		)
	else if IntOps.not_equals(ordinal, next_owner):
		Err(verification_error(span, "owner identity is not the next function ordinal"))
	else:
		Ok(void)


private pure func argument_value(argument: OwnedArgument) -> ValueId:
	match argument:
		UnmanagedArgument(id):
			id
		BorrowedArgument(borrow):
			borrow.value


private pure func verify_borrow(
	borrow: BorrowedValue,
	state: VerificationFacts,
	span: Span,
	discharged: List[Bool],
	owners: List[OwnerState],
) -> Result[Void, Diagnostic]:
	borrowed ?= known_value(state, borrow.value, span)

	managed ?= match borrowed.result:
		UnmanagedResult:
			Err(verification_error(span, "borrow requires a managed value"))
		_:
			Ok(void)

	match borrow.source:
		ParameterBorrow(source):
			if (
				IntOps.equals(value_number(source), value_number(borrow.value))
				and state.parameters.any(
					pure func(
						parameter: ValueId,
					) -> Bool: IntOps.equals(value_number(parameter), value_number(source)),
				)
			):
				Ok(void)
			else:
				Err(verification_error(span, "parameter borrow does not refer to the borrowed parameter"))
		OwnerBorrow(id):
			match known_owner(state, discharged, owners, id, span):
				Ok(entry):

					match entry:
						DischargedOwner:
							Err(
								verification_error(
									span,
									"borrow refers to discharged owner ".append_int(owner_number(id)),
								),
							)
						ActiveOwner(owned):
							if IntOps.equals(value_number(owned), value_number(borrow.value)):
								Ok(void)
							else:
								Err(
									verification_error(
										span,
										"owner "
											.append_int(owner_number(id))
											.concat(" does not own value ")
											.append_int(value_number(borrow.value)),
									),
								)
				Err(error): Err(error)
		PayloadBorrow(parent):
			match borrowed.result:
				BorrowedResult(PayloadBorrow(expected)):
					if IntOps.equals(value_number(parent), value_number(expected)):
						match borrowed.projection_parent.to_result(
							verification_error(
								span,
								"projection has no parent lifetime",
							),
						):
							Ok(ancestor):

								if IntOps.equals(value_number(ancestor.value), value_number(parent)):
									verify_borrow(ancestor, state, span, discharged, owners)
								else:
									Err(verification_error(span, "payload borrow has the wrong parent value"))
							Err(error): Err(error)
					else:
						Err(verification_error(span, "payload borrow has the wrong parent value"))
				_:
					Err(verification_error(span, "payload borrow requires a borrowed projection"))


-- The signature a call's target declares, after its types are shown to exist.
private pure func call_signature(
	target: CallTarget,
	span: Span,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[FunctionSignature, Diagnostic]:
	match target:
		RuntimeFunction(operation):
			verify_runtime_signature(operation, span, unions, records)
		UserFunction(id):
			match functions.get(function_number(id)):
				Some(function): Ok(function.signature)
				None: Err(verification_error(span, "unknown called function"))


private pure func verify_runtime_signature(
	operation: RuntimeOperation[VariantInstanceId, TypeRef],
	span: Span,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[FunctionSignature, Diagnostic]:
	contract = runtime_signature(operation)
	var invalid: Option[Diagnostic] = None
	for parameter in contract.parameters:
		match verify_type_membership(parameter, unions, records, span):
			Ok(_): void
			Err(error):
				invalid = Some(error)
				break
	parameters ?= match invalid:
		None: Ok(void)
		Some(error): Err(error)
	validation: Result[Void, Diagnostic] = match runtime_contract(operation).return_type:
		ValueResult(_):
			Ok(void)
		OptionalResult(payload, option):
			verify_two_variant_union(
				option.some,
				[runtime_type_ref(payload)],
				option.none,
				[],
				unions,
				span,
				"runtime Option constructors do not cover one result union",
			)
		ResultResult(success, error, constructors):
			verify_two_variant_union(
				constructors.ok,
				[runtime_type_ref(success)],
				constructors.err,
				[runtime_type_ref(error)],
				unions,
				span,
				"runtime Result constructors do not cover one result union",
			)
		BooleanResult(boolean):
			verify_two_variant_union(
				boolean.true_variant,
				[],
				boolean.false_variant,
				[],
				unions,
				span,
				"runtime Bool constructors do not cover one result union",
			)

	valid ?= validation
	result ?= verify_type_membership(contract.return_type, unions, records, span)
	Ok(contract)


-- A runtime union result: its two constructors must be distinct
-- variants of one two-variant union. This sees specialized instances, not
-- declarations, so it checks only the owner, both payloads and the two variants.
-- That the union is the designated foundation union is enforced where the
-- checker's `runtime_result_type` builds each result from the designated
-- unions. Specialization maps those variants into the result instance and
-- treats a mismatch as a compiler invariant.
private pure func verify_two_variant_union(
	first: VariantInstanceId,
	first_payload: List[TypeRef],
	second: VariantInstanceId,
	second_payload: List[TypeRef],
	unions: List[ConcreteUnion],
	span: Span,
	message: String,
) -> Result[Void, Diagnostic]:
	first_type ?= variant_type(first, first_payload, unions, span)
	second_type ?= variant_type(second, second_payload, unions, span)
	layout ?= unions
		.get(union_number(variant_owner(first)))
		.to_result(verification_error(span, "unknown runtime result union"))

	if (
		same_type(first_type, second_type)
		and IntOps.equals(layout.variants.length(), 2)
		and not IntOps.equals(variant_number(first), variant_number(second))
	):
		Ok(void)
	else:
		Err(verification_error(span, message))


private pure func verify_argument(
	argument: OwnedArgument,
	expected: TypeRef,
	state: VerificationFacts,
	unions: List[ConcreteUnion],
	span: Span,
	records: List[ConcreteRecord],
	discharged: List[Bool],
	owners: List[OwnerState],
) -> Result[Void, Diagnostic]:
	id = match argument:
		UnmanagedArgument(id):
			id
		BorrowedArgument(borrow):
			borrow.value

	known ?= known_value(state, id, span)

	if not same_type(known.value_type, expected):
		Err(verification_error(span, "call argument type does not match its contract"))
	else:
		match argument:
			UnmanagedArgument(_):
				match value_ownership(expected, unions, records):
					Ok(plan):

						match plan:
							NoOwnership:
								Ok(void)
							ManagedStringLeaf | ManagedListRoot | ManagedRecordRoot(_) | InlineOwnedFields(_) | ManagedUnionRoot(_):
								Err(
									verification_error(
										span,
										"managed call argument requires an owner-dependent borrow",
									),
								)
					Err(error): Err(error)
			BorrowedArgument(borrow):
				verify_borrow(borrow, state, span, discharged, owners)


private pure func verify_arguments(
	arguments: List[OwnedArgument],
	parameters: List[TypeRef],
	state: VerificationFacts,
	unions: List[ConcreteUnion],
	span: Span,
	records: List[ConcreteRecord],
	discharged: List[Bool],
	owners: List[OwnerState],
) -> Result[Void, Diagnostic]:
	if IntOps.less_than(arguments.length(), parameters.length()):
		Err(verification_error(span, "call is missing its argument"))
	else if IntOps.greater_than(arguments.length(), parameters.length()):
		Err(verification_error(span, "call has an unexpected argument"))
	else:
		var index: Int = 0
		var invalid: Option[Diagnostic] = None

		for argument in arguments:
			match parameters.get(index):
				None:
					invalid = Some(verification_error(span, "missing call parameter contract"))
					break
				Some(expected):
					match verify_argument(
						argument,
						expected,
						state,
						unions,
						span,
						records,
						discharged,
						owners,
					):
						Err(error):
							invalid = Some(error)
							break
						Ok(_):
							void

			index = IntOps.add(index, 1)

		match invalid:
			Some(error):
				Err(error)
			None:
				Ok(void)


private pure func variant_shape(id: VariantInstanceId, unions: List[ConcreteUnion], span: Span) -> Result[List[TypeRef], Diagnostic]:
	declaration ?= unions.get(union_number(variant_owner(id))).to_result(verification_error(span, "unknown variant owner"))
	declaration.variants.get(variant_number(id)).to_result(verification_error(span, "unknown variant identity"))


private pure func variant_type(id: VariantInstanceId, expected: List[TypeRef], unions: List[ConcreteUnion], span: Span) -> Result[TypeRef, Diagnostic]:
	shape ?= variant_shape(id, unions, span)
	if not IntOps.equals(shape.length(), expected.length()):
		Err(verification_error(span, "variant field count does not match its operation"))
	else:
		var position = 0
		var valid = True
		for actual in expected:
			match shape.get(position):
				Some(field): valid = valid and same_type(field, actual)
				None: valid = False
			position = IntOps.add(position, 1)
		if valid:
			Ok(UnionType(variant_owner(id)))
		else:
			Err(verification_error(span, "variant payload does not match its operation"))


private pure func valid_union_layout(
	layout: ConcreteUnion,
	position: Int,
	records: List[ConcreteRecord],
	unions: List[ConcreteUnion],
) -> Result[Void, Diagnostic]:
	span: Span = {
		source = compiler_source(),
		start = 0,
		end = 0
	}

	if IntOps.equals(layout.variants.length(), 0):
		Err(verification_error(span, "union layout must contain one or more variants"))
	else:
		var invalid: Option[Diagnostic] = None
		var owning = False
		var self_referencing = False

		for fields in layout.variants:
			var self_payloads = 0

			for value_type in fields:
				valid = match value_type:
					VoidType | IntType | FloatType:
						True
					RecordType(id):
						match records.get(record_number(id)):
							Some(child):
								match child.representation:
									ManagedRecord:
										owning = True
									InlineRecord:
										void

								True
							None:
								False
					UnionType(id):
						if IntOps.equals(union_number(id), position):
							-- The unary recursive shape: a boxed node's pointer to
							-- at most one child of its own layout.
							self_referencing = True
							self_payloads = IntOps.add(self_payloads, 1)

							match layout.representation:
								BoxedRecursive:
									if IntOps.greater_than(self_payloads, 1):
										invalid = Some(verification_error(span, "boxed union variant may store at most one self-reference"))
								InlineUnmanaged | InlineOwningPayload:
									invalid = Some(verification_error(span, "recursive union payload requires the boxed representation"))

							True
						else:
							-- Any other layout in range: a boxed child is a pointer
							-- edge, an inline child is stored by value, and the
							-- layout graph walk below proves the by-value edges
							-- acyclic. Definition order is the emitter's concern.
							match unions.get(union_number(id)):
								Some(child):
									match child.representation:
										InlineOwningPayload | BoxedRecursive:
											owning = True
										InlineUnmanaged:
											void

									True
								None:
									False
					StringType:
						owning = True
						True
					ListType(_):
						owning = True
						True

				if invalid.is_some():
					break

				if not valid:
					invalid = Some(
						verification_error(
							span,
							"union payload must reference a supported layout",
						),
					)
					break
			if invalid.is_some():
				break

		match invalid:
			Some(error):
				Err(error)
			None:
				match layout.representation:
					BoxedRecursive:
						if self_referencing:
							Ok(void)
						else:
							Err(verification_error(span, "boxed union representation requires a self-referencing payload"))
					InlineUnmanaged:
						if owning:
							Err(verification_error(span, "union ownership summary does not match its payloads"))
						else:
							Ok(void)
					InlineOwningPayload:
						if owning:
							Ok(void)
						else:
							Err(verification_error(span, "union ownership summary does not match its payloads"))


private pure func valid_record_layout(
	layout: ConcreteRecord,
	span: Span,
) -> Result[ConcreteRecord, Diagnostic]:
	if IntOps.greater_than(layout.fields.length(), 0):
		Ok(layout)
	else:
		Err(verification_error(span, "record layout must contain one or more fields"))


private fixed union LayoutVisit:
	UnvisitedLayout
	VisitingLayout
	CompleteLayout


private fixed union LayoutVisitStep:
	VisitRecordLayout(Int)
	VisitUnionLayout(Int)
	VisitStoredType(TypeRef)
	FinishRecordLayout(Int)
	FinishUnionLayout(Int)


private pure func push_layout_visit(
	steps: List[LayoutVisitStep],
	depth: Int,
	step: LayoutVisitStep,
) -> List[LayoutVisitStep]:
	if IntOps.less_than(depth, steps.length()):
		steps.set(depth, step)
	else:
		steps.append(step)


private pure func list_terminal_presence(
	element: TypeRef,
	records: List[ConcreteRecord],
	unions: List[ConcreteUnion],
) -> Result[Void, Diagnostic]:
	span: Span = { source = compiler_source(), start = 0, end = 0 }
	var terminal = element
	while True:
		match terminal:
			ListType(inner): terminal = inner
			_: break
	match terminal:
		RecordType(id):
			match records.get(record_number(id)):
				Some(_): Ok(void)
				None: Err(verification_error(span, "unknown record layout"))
		UnionType(id):
			match unions.get(union_number(id)):
				Some(_): Ok(void)
				None: Err(verification_error(span, "unknown union layout"))
		_:
			Ok(void)


-- The by-value storage graph of the layouts must be acyclic: every cycle
-- passes through a managed record, a boxed union or a List, which the walk
-- does not follow. Each layout is also walked as a root, and a record's
-- storage summary is checked once its fields are known.
private pure func verify_layout_graph(
	records: List[ConcreteRecord],
	unions: List[ConcreteUnion],
) -> Result[Void, Diagnostic]:
	span: Span = {
		source = compiler_source(),
		start = 0,
		end = 0
	}
	-- A local traversal owns each state vector throughout every update.
	var record_visits = records.map(pure func(_): UnvisitedLayout)
	var union_visits = unions.map(pure func(_): UnvisitedLayout)
	var pending: List[LayoutVisitStep] = []
	var pending_count = 0
	var position = unions.length()

	while IntOps.greater_than(position, 0):
		position = IntOps.subtract(position, 1)
		pending = push_layout_visit(pending, pending_count, VisitUnionLayout(position))
		pending_count = IntOps.add(pending_count, 1)

	position = records.length()

	while IntOps.greater_than(position, 0):
		position = IntOps.subtract(position, 1)
		pending = push_layout_visit(pending, pending_count, VisitRecordLayout(position))
		pending_count = IntOps.add(pending_count, 1)

	var invalid: Option[Diagnostic] = None

	while IntOps.greater_than(pending_count, 0) and not invalid.is_some():
		pending_count = IntOps.subtract(pending_count, 1)

		match pending.get(pending_count):
			None:
				invalid = Some(verification_error(span, "invalid aggregate layout traversal state"))
			Some(step):
				match step:
					VisitStoredType(value_type):
						-- Only storage by value continues the walk: an inline record
						-- or inline union lies inside its parent. A managed record,
						-- a boxed union, a List and a String are pointer edges, and
						-- their layouts are walked as roots of their own.
						match value_type:
							RecordType(id):
								match records.get(record_number(id)):
									None:
										invalid = Some(verification_error(span, "unknown record layout"))
									Some(child):
										match child.representation:
											InlineRecord:
												pending = push_layout_visit(
													pending,
													pending_count,
													VisitRecordLayout(record_number(id)),
												)
												pending_count = IntOps.add(pending_count, 1)
											ManagedRecord:
												void
							UnionType(id):
								match unions.get(union_number(id)):
									None:
										invalid = Some(verification_error(span, "unknown union layout"))
									Some(child):
										match child.representation:
											InlineUnmanaged | InlineOwningPayload:
												pending = push_layout_visit(
													pending,
													pending_count,
													VisitUnionLayout(union_number(id)),
												)
												pending_count = IntOps.add(pending_count, 1)
											BoxedRecursive:
												void
							ListType(element):
								-- A pointer edge whose target must exist; its layout is
								-- walked as a root of its own, not from here.
								match list_terminal_presence(element, records, unions):
									Ok(_): void
									Err(error): invalid = Some(error)
							VoidType | IntType | FloatType | StringType:
								void
					VisitRecordLayout(index):
						match record_visits.get(index):
							None:
								invalid = Some(verification_error(span, "unknown record layout"))
							Some(CompleteLayout):
								void
							Some(VisitingLayout):
								invalid = Some(
									verification_error(
										span,
										"aggregate layouts form a by-value cycle",
									),
								)
							Some(UnvisitedLayout):
								match records.get(index):
									None:
										invalid = Some(verification_error(span, "unknown record layout"))
									Some(layout):
										record_visits = record_visits.set(index, VisitingLayout)
										pending = push_layout_visit(
											pending,
											pending_count,
											FinishRecordLayout(index),
										)
										pending_count = IntOps.add(pending_count, 1)
										var child = layout.fields.length()

										while IntOps.greater_than(child, 0):
											child = IntOps.subtract(child, 1)

											match layout.fields.get(child):
												Some(field):
													pending = push_layout_visit(
														pending,
														pending_count,
														VisitStoredType(field),
													)
													pending_count = IntOps.add(pending_count, 1)
												None:
													invalid = Some(
														verification_error(
															span,
															"invalid aggregate layout traversal state",
														),
													)
													break
					VisitUnionLayout(index):
						match union_visits.get(index):
							None:
								invalid = Some(verification_error(span, "unknown union layout"))
							Some(CompleteLayout):
								void
							Some(VisitingLayout):
								invalid = Some(
									verification_error(
										span,
										"aggregate layouts form a by-value cycle",
									),
								)
							Some(UnvisitedLayout):
								match unions.get(index):
									None:
										invalid = Some(verification_error(span, "unknown union layout"))
									Some(layout):
										union_visits = union_visits.set(index, VisitingLayout)
										pending = push_layout_visit(
											pending,
											pending_count,
											FinishUnionLayout(index),
										)
										pending_count = IntOps.add(pending_count, 1)
										var child = layout.variants.length()

										while IntOps.greater_than(child, 0):
											child = IntOps.subtract(child, 1)

											match layout.variants.get(child):
												Some(fields):
													var field_position = fields.length()
													while IntOps.greater_than(field_position, 0):
														field_position = IntOps.subtract(field_position, 1)
														match fields.get(field_position):
															Some(field):
																pending = push_layout_visit(pending, pending_count, VisitStoredType(field))
																pending_count = IntOps.add(pending_count, 1)
															None:
																invalid = Some(verification_error(span, "invalid aggregate layout traversal state"))
																break
												None:
													invalid = Some(
														verification_error(
															span,
															"invalid aggregate layout traversal state",
														),
													)
													break
					FinishUnionLayout(index):
						union_visits = union_visits.set(index, CompleteLayout)
					FinishRecordLayout(index):
						match records.get(index):
							None:
								invalid = Some(verification_error(span, "unknown record layout"))
							Some(layout):
								var inline = True

								for field in layout.fields:
									match field:
										IntType | FloatType:
											void
										RecordType(child):
											match records.get(record_number(child)):
												Some(child_layout):
													match child_layout.representation:
														InlineRecord:
															void
														ManagedRecord:
															inline = False
												None:
													invalid = Some(
														verification_error(
															span,
															"unknown record layout",
														),
													)
													break
										_:
											inline = False

								matches = match layout.representation:
									InlineRecord:
										inline
									ManagedRecord:
										not inline

								if not invalid.is_some():
									if matches:
										record_visits = record_visits.set(index, CompleteLayout)
									else:
										invalid = Some(
											verification_error(
												span,
												"record storage summary does not match its fields",
											),
										)

	match invalid:
		Some(error):
			Err(error)
		None:
			Ok(void)


private pure func record_layout(
	owner: RecordInstanceId,
	records: List[ConcreteRecord],
	span: Span,
) -> Result[ConcreteRecord, Diagnostic]:
	layout ?= records
		.get(record_number(owner))
		.to_result(verification_error(span, "unknown record layout"))
	valid_record_layout(layout, span)


private pure func record_field_type(
	field: FieldInstanceId,
	owner: RecordInstanceId,
	layout: ConcreteRecord,
	span: Span,
) -> Result[TypeRef, Diagnostic]:
	if not IntOps.equals(record_number(field_owner(field)), record_number(owner)):
		Err(verification_error(span, "field belongs to a different record layout"))
	else:
		layout.fields
			.get(field_number(field))
			.to_result(verification_error(span, "unknown record field"))


private pure func operation_type(
	definition: OwnedDefinition,
	state: VerificationFacts,
	signature: FunctionSignature,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	projection: ProjectionContext,
	records: List[ConcreteRecord],
	discharged: List[Bool],
	owners: List[OwnerState],
) -> Result[TypeRef, Diagnostic]:
	match definition.operation:
		ConstructRecordDefinition(owner, fields):
			match record_layout(owner, records, definition.span):
				Ok(layout):

					if IntOps.equals(fields.length(), layout.fields.length()):
						var seen: List[Int] = []
						var invalid: Option[Diagnostic] = None

						for field in fields:
							if seen.contains(field_number(field.field)):
								invalid = Some(verification_error(definition.span, "record construction repeats a field"))
								break

							result = record_field_type(
								field.field,
								owner,
								layout,
								definition.span,
							).and_then(pure func(expected: TypeRef) -> Result[Void, Diagnostic]:
								stored = match field.value:
									UnmanagedPayload(value):
										value
									OwnedPayload(value, _):
										value

								match known_value(state, stored, definition.span):
									Err(error):
										Err(error)
									Ok(known):
										if same_type(known.value_type, expected):
											Ok(void)
										else:
											Err(
												verification_error(
													definition.span,
													"record field value type does not match its layout",
												),
											)
							)

							match result:
								Err(error):
									invalid = Some(error)
									break
								Ok(_):
									seen = seen.append(field_number(field.field))

						match invalid:
							Some(error):
								Err(error)
							None:
								Ok(RecordType(owner))
					else:
						Err(
							verification_error(
								definition.span,
								"record construction must provide every field exactly once",
							),
						)
				Err(error): Err(error)
		ReadRecordFieldDefinition(field, argument):
			source = match argument:
				UnmanagedArgument(value):
					value
				BorrowedArgument(borrow):
					borrow.value

			match known_value(state, source, definition.span):
				Ok(known):

					match known.value_type:
						RecordType(owner):
							match record_layout(owner, records, definition.span):
								Ok(layout):
									match verify_arguments(
										[argument],
										[known.value_type],
										state,
										unions,
										definition.span,
										records,
										discharged,
										owners,
									):
										Ok(live): record_field_type(field, owner, layout, definition.span)
										Err(error): Err(error)
								Err(error): Err(error)
						_:
							Err(verification_error(definition.span, "field projection requires a record value"))
				Err(error): Err(error)
		ParameterDefinition(index):
			if IntOps.less_than(index, state.parameters.length()):
				Err(verification_error(definition.span, "function parameter is defined more than once"))
			else if IntOps.not_equals(index, state.parameters.length()):
				Err(
					verification_error(
						definition.span,
						"function parameter position is not the next signature position",
					),
				)
			else:
				signature.parameters
					.get(index)
					.to_result(
						verification_error(
							definition.span,
							"parameter value in a zero-argument function",
						),
					)
		VoidDefinition:
			Ok(VoidType)
		StringDefinition(_):
			Ok(StringType)
		IntegerDefinition(_):
			Ok(IntType)
		FloatDefinition(value):
			if FloatOps.is_finite(value):
				Ok(FloatType)
			else:
				Err(verification_error(definition.span, "Float literal must be finite"))
		CallDefinition(target, arguments):
			match call_signature(target, definition.span, functions, unions, records):
				Ok(contract):
					match verify_arguments(
						arguments,
						contract.parameters,
						state,
						unions,
						definition.span,
						records,
						discharged,
						owners,
					):
						Ok(valid):

							if same_type(contract.return_type, definition.value_type):
								Ok(contract.return_type)
							else:
								Err(verification_error(definition.span, "call result type does not match its contract"))
						Err(error): Err(error)
				Err(error): Err(error)
		ConstructDefinition(id, payloads):
			var types: List[TypeRef] = []
			var found_error: Option[Diagnostic] = None
			for payload in payloads:
				argument = match payload:
					UnmanagedPayload(value): value
					OwnedPayload(value, _): value
				match known_value(state, argument, definition.span):
					Ok(known): types = types.append(known.value_type)
					Err(failure):
						found_error = Some(failure)
						break
			match found_error:
				Some(error): Err(error)
				None:
					variant_type(id, types, unions, definition.span)
		ConstructListDefinition(payloads):
			-- The definition's List type is the one authority for E; every
			-- stored element must carry exactly that type.
			match definition.value_type:
				ListType(element):
					var found_error: Option[Diagnostic] = None
					for payload in payloads:
						argument = match payload:
							UnmanagedPayload(value): value
							OwnedPayload(value, _): value
						match known_value(state, argument, definition.span):
							Err(failure):
								found_error = Some(failure)
								break
							Ok(known):
								if not same_type(known.value_type, element):
									found_error = Some(verification_error(definition.span, "list element type does not match its List"))
									break
					match found_error:
						Some(error): Err(error)
						None: Ok(definition.value_type)
				_: Err(verification_error(definition.span, "list construction result must be a List"))

		PayloadDefinition(field, source):
			selected = variant_field_variant(field)
			match known_value(state, source, definition.span):
				Ok(scrutinee):

					match projection:
						NoProjection:
							Err(
								verification_error(
									definition.span,
									"payload projection outside its selected match arm",
								),
							)
						PayloadProjection(expected, variant):
							match variant_shape(variant, unions, definition.span):
								Ok(fields):
									match fields.get(variant_field_number(field)).to_result(verification_error(definition.span, "unknown variant field identity")):
										Ok(payload_type):

											if (
												IntOps.equals(value_number(source), value_number(argument_value(expected)))
												and same_type(scrutinee.value_type, UnionType(variant_owner(variant)))
												and IntOps.equals(
													union_number(variant_owner(selected)),
													union_number(variant_owner(variant)),
												)
												and IntOps.equals(variant_number(selected), variant_number(variant))
											):
												match verify_match_argument(
													expected,
													state,
													unions,
													records,
													definition.span,
													discharged,
													owners,
												):
													Ok(live): Ok(payload_type)
													Err(error): Err(error)
											else:
												Err(
													verification_error(
														definition.span,
														"payload projection does not belong to this match arm",
													),
												)
										Err(error): Err(error)
								Err(error): Err(error)
				Err(error): Err(error)


-- Owner slots after every stored payload of one construction discharged its
-- obligation into storage; variants, list literals and records share it.
private fixed record DischargedOwners {
	discharged: List[Bool],
	owners: List[OwnerState]
}


private pure func discharge_payloads(
	payloads: List[StoredPayload],
	state: VerificationFacts,
	discharged: List[Bool],
	owners: List[OwnerState],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
	span: Span,
) -> Result[DischargedOwners, Diagnostic]:
	var enclosing = discharged
	var local = owners
	var failure_slot: Option[Diagnostic] = None
	for payload in payloads:
		match stored_payload_transfer(payload, state, enclosing, local, unions, records, span):
			Err(error):
				failure_slot = Some(error)
				break
			Ok(Some(EnclosingSlot(ordinal))):
				match discharge(state, enclosing, ordinal, span):
					Ok(flags): enclosing = flags
					Err(error):
						failure_slot = Some(error)
						break
			Ok(Some(LocalSlot(index))): local = local.set(index, DischargedOwner)
			Ok(None): void
	match failure_slot:
		Some(error): Err(error)
		None: Ok({ discharged = enclosing, owners = local })


private pure func stored_payload_transfer(
	payload: StoredPayload,
	state: VerificationFacts,
	discharged: List[Bool],
	owners: List[OwnerState],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
	span: Span,
) -> Result[Option[OwnerSlot], Diagnostic]:
	id = match payload:
		UnmanagedPayload(id):
			id
		OwnedPayload(id, _):
			id

	known ?= known_value(state, id, span)
	plan ?= value_ownership(known.value_type, unions, records)

	match payload:
		UnmanagedPayload(_):
			match plan:
				NoOwnership:
					Ok(None)
				_:
					Err(verification_error(span, "managed payload requires an owner transfer"))
		OwnedPayload(value, transferred):
			match plan:
				NoOwnership:
					Err(verification_error(span, "unmanaged payload cannot transfer an owner"))
				_:
					match known_owner(state, discharged, owners, transferred, span):
						Ok(entry):

							match entry:
								DischargedOwner:
									Err(verification_error(span, "payload owner has already been discharged"))
								ActiveOwner(owned):
									if IntOps.equals(value_number(value), value_number(owned)):
										owner_slot(
											state,
											owners.length(),
											transferred,
											span,
										).map(
											pure func(slot): Some(slot),
										)
									else:
										Err(verification_error(span, "payload owner does not own the stored value"))
						Err(error): Err(error)


private pure func verify_definition_result(
	definition: OwnedDefinition,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Option[OwnerId], Diagnostic]:
	plan ?= value_ownership(definition.value_type, unions, records)

	ownership_result: Result[Option[OwnerId], Diagnostic] = match plan:
		NoOwnership:
			match definition.result:
				UnmanagedResult:
					Ok(None)
				_:
					Err(verification_error(definition.span, "unmanaged value carries an ownership obligation"))
		ManagedStringLeaf | ManagedListRoot | ManagedRecordRoot(_) | InlineOwnedFields(_) | ManagedUnionRoot(_):
			match definition.operation:
				ParameterDefinition(_):
					match definition.result:
						BorrowedResult(ParameterBorrow(source)):
							if IntOps.equals(value_number(source), value_number(definition.id)):
								Ok(None)
							else:
								Err(
									verification_error(
										definition.span,
										"managed parameter has the wrong borrow source",
									),
								)
						_:
							Err(verification_error(definition.span, "managed parameter must be borrowed"))
				PayloadDefinition(_, parent):
					match definition.result:
						BorrowedResult(PayloadBorrow(source)):
							if IntOps.equals(value_number(parent), value_number(source)):
								Ok(None)
							else:
								Err(
									verification_error(
										definition.span,
										"payload borrow has the wrong parent value",
									),
								)
						_:
							Err(
								verification_error(
									definition.span,
									"managed projection requires its parent borrow",
								),
							)
				ReadRecordFieldDefinition(_, argument):
					parent = match argument:
						UnmanagedArgument(value):
							value
						BorrowedArgument(borrow):
							borrow.value

					match definition.result:
						BorrowedResult(PayloadBorrow(source)):
							if IntOps.equals(value_number(parent), value_number(source)):
								Ok(None)
							else:
								Err(
									verification_error(
										definition.span,
										"payload borrow has the wrong parent value",
									),
								)
						_:
							Err(
								verification_error(
									definition.span,
									"managed projection requires its parent borrow",
								),
							)
				StringDefinition(_) | CallDefinition(_, _) | ConstructDefinition(_, _) | ConstructListDefinition(_) | ConstructRecordDefinition(_, _):
					match definition.result:
						OwnedResult(owner):
							Ok(Some(owner))
						_:
							Err(verification_error(definition.span, "managed result requires an owner"))
				_:
					Err(verification_error(definition.span, "unsupported managed value operation"))

	ownership_result


private pure func verify_match_argument(
	argument: OwnedArgument,
	state: VerificationFacts,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
	span: Span,
	discharged: List[Bool],
	owners: List[OwnerState],
) -> Result[Void, Diagnostic]:
	match argument:
		BorrowedArgument(borrow):
			verify_borrow(borrow, state, span, discharged, owners)
		UnmanagedArgument(id):
			match known_value(state, id, span):
				Ok(known):
					match value_ownership(known.value_type, unions, records):
						Ok(plan):

							match plan:
								NoOwnership:
									Ok(void)
								_:
									Err(verification_error(span, "managed match scrutinee requires an owner-dependent borrow"))
						Err(error): Err(error)
				Err(error): Err(error)


private pure func definition_parent(
	definition: OwnedDefinition,
	projection: ProjectionContext,
) -> Option[BorrowedValue]:
	match definition.operation:
		ReadRecordFieldDefinition(_, BorrowedArgument(parent)):
			Some(parent)
		PayloadDefinition(_, _):
			match projection:
				PayloadProjection(BorrowedArgument(parent), _):
					Some(parent)
				_:
					None
		_:
			None


private pure func verify_definition_type(
	definition: OwnedDefinition,
	state: VerificationFacts,
	signature: FunctionSignature,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	projection: ProjectionContext,
	records: List[ConcreteRecord],
	discharged: List[Bool],
	owners: List[OwnerState],
) -> Result[Void, Diagnostic]:
	if IntOps.not_equals(
		value_number(definition.id),
		IntOps.add(state.first_value, state.values.length()),
	):
		Err(verification_error(definition.span, "value identity is not the next function ordinal"))
	else:
		membership_result: Result[Void, Diagnostic] = match definition.value_type:
			ListType(element): verify_type_membership(element, unions, records, definition.span)
			VoidType | IntType | FloatType | StringType | RecordType(_) | UnionType(_): Ok(void)
		match membership_result:
			Ok(_):
				match operation_type(
					definition,
					state,
					signature,
					functions,
					unions,
					projection,
					records,
					discharged,
					owners,
				):
					Ok(expected):

						if same_type(expected, definition.value_type):
							Ok(void)
						else:
							Err(verification_error(definition.span, "definition type does not match its operation"))
					Err(error): Err(error)
			Err(error): Err(error)


private pure func verified_drop(
	id: OwnerId,
	span: Span,
	state: VerificationFacts,
	discharged: List[Bool],
	owners: List[OwnerState],
) -> Result[OwnerSlot, Diagnostic]:
	entry ?= known_owner(state, discharged, owners, id, span)

	match entry:
		DischargedOwner:
			Err(
				verification_error(
					span,
					"owner "
						.append_int(owner_number(id))
						.concat(" has already been discharged"),
				),
			)
		ActiveOwner(_):
			owner_slot(state, owners.length(), id, span)


-- A join whose arms are verified after its block, as they are numbered:
-- each arm starts from `start`, the block's state just before the join.
private fixed record PendingJoin {
	join: OwnedJoin,
	start: VerificationState
}


private fixed record VerifiedBlock {
	state: VerificationState,
	pending: List[PendingJoin]
}


private pure func verify_join_header(
	join: OwnedJoin,
	state: VerificationFacts,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
	discharged: List[Bool],
	owners: List[OwnerState],
) -> Result[Void, Diagnostic]:
	parameter = join_parameter(join.result)
	ordinal ?= if IntOps.equals(value_number(parameter.id), IntOps.add(state.first_value, state.values.length())):
		Ok(void)
	else:
		Err(verification_error(parameter.span, "value identity is not the next function ordinal"))
	membership ?= match parameter.value_type:
		ListType(element): verify_type_membership(element, unions, records, parameter.span)
		_: Ok(void)
	match known_value(state, argument_value(join.scrutinee), parameter.span):
		Ok(scrutinee):
			if same_type(scrutinee.value_type, UnionType(join.owner)):
				var labels: List[MatchLabel] = []
				for arm in join.arms:
					labels = labels.append(arm.label)
				match verify_match_labels(join.owner, labels, unions, parameter.span):
					Ok(covered):
						match verify_match_argument(join.scrutinee, state, unions, records, parameter.span, discharged, owners):
							Ok(live): Ok(void)
							Err(error): Err(error)
					Err(error): Err(error)
			else:
				Err(verification_error(parameter.span, "join scrutinee does not belong to its union"))
		Err(error): Err(error)


private pure func introduce_join_parameter(
	output: OwnedJoinParameter,
	initial: VerificationState,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[VerificationState, Diagnostic]:
	parameter = join_parameter(output)
	state = initial.facts

	plan ?= value_ownership(parameter.value_type, unions, records)
	var owners = initial.owners
	classification: Result[Void, Diagnostic] = match plan:
		NoOwnership:
			match output:
				UnmanagedJoinParameter(_): Ok(void)
				_: Err(verification_error(parameter.span, "unmanaged value carries an ownership obligation"))
		_:
			match output:
				UnmanagedJoinParameter(_): Err(verification_error(parameter.span, "managed result requires an owner"))
				ManagedJoinParameter(_, owner):
					match validate_next_owner(state.first_owner, owners, owner, parameter.span):
						Ok(_):
							owners = owners.append(ActiveOwner(parameter.id))
							Ok(void)
						Err(error): Err(error)
	classified ?= classification
	Ok({ initial |
		facts = { state | values = state.values.append({
			value_type = parameter.value_type,
			span = parameter.span,
			result = join_ownership(output),
			projection_parent = None,
		}) },
		owners = owners,
	})


private pure func introduce_carried_parameter(
	output: OwnedJoinParameter,
	start: VerificationState,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[VerificationState, Diagnostic]:
	parameter = join_parameter(output)
	ordinal ?= if IntOps.equals(value_number(parameter.id), IntOps.add(start.facts.first_value, start.facts.values.length())):
		Ok(void)
	else:
		Err(verification_error(parameter.span, "value identity is not the next function ordinal"))
	membership ?= verify_type_membership(parameter.value_type, unions, records, parameter.span)
	introduce_join_parameter(output, start, unions, records)


private pure func introduce_join(
	join: OwnedJoin,
	start: VerificationState,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[VerificationState, Diagnostic]:
	header ?= verify_join_header(join, start.facts, unions, records, start.discharged, start.owners)
	result ?= introduce_join_parameter(join.result, start, unions, records)
	var state = result
	var invalid: Option[Diagnostic] = None
	for output in join.carried:
		match introduce_carried_parameter(output, state, unions, records):
			Ok(introduced): state = introduced
			Err(error):
				invalid = Some(error)
				break
	match invalid:
		Some(error): Err(error)
		None: Ok(state)


-- Owner vectors belong to this traversal, not the per-definition facts carrier.
-- Enclosing owners are shared views: a block records the ones it discharges,
-- and its local owner vector stays uniquely held.
private pure func verify_operations(
	operations: List[OwnershipOperation],
	initial: VerificationState,
	signature: FunctionSignature,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	projection: ProjectionContext,
	records: List[ConcreteRecord],
) -> Result[VerifiedBlock, Diagnostic]:
	var discharged = initial.discharged
	var owners = initial.owners
	var state = initial.facts
	var pending: List[PendingJoin] = []
	var invalid: Option[Diagnostic] = None

	for operation in operations:
		checked: Result[Void, Diagnostic] = match operation:
			DefineValue(definition):

				match verify_definition_type(
					definition,
					state,
					signature,
					functions,
					unions,
					projection,
					records,
					discharged,
					owners,
				):
					Err(error):
						Err(error)
					Ok(_):
						stored: Result[Void, Diagnostic] = match definition.operation:
							ConstructListDefinition(payloads):
								match discharge_payloads(payloads, state, discharged, owners, unions, records, definition.span):
									Err(error): Err(error)
									Ok(moved):
										discharged = moved.discharged
										owners = moved.owners
										Ok(void)
							ConstructDefinition(_, payloads):
								match discharge_payloads(payloads, state, discharged, owners, unions, records, definition.span):
									Err(error): Err(error)
									Ok(moved):
										discharged = moved.discharged
										owners = moved.owners
										Ok(void)
							ConstructRecordDefinition(_, fields):
								var payloads: List[StoredPayload] = []
								for field in fields:
									payloads = payloads.append(field.value)
								match discharge_payloads(payloads, state, discharged, owners, unions, records, definition.span):
									Err(error): Err(error)
									Ok(moved):
										discharged = moved.discharged
										owners = moved.owners
										Ok(void)
							_:
								Ok(void)

						match stored:
							Err(error):
								Err(error)
							Ok(_):
								match verify_definition_result(definition, unions, records):
									Err(error):
										Err(error)
									Ok(introduced):
										valid_owner: Result[Void, Diagnostic] = match introduced:
											None:
												Ok(void)
											Some(id):
												match validate_next_owner(
													state.first_owner,
													owners,
													id,
													definition.span,
												):
													Err(error):
														Err(error)
													Ok(_):
														owners = owners.append(
															ActiveOwner(definition.id),
														)
														Ok(void)

										match valid_owner:
											Err(error):
												Err(error)
											Ok(_):
												parameters = match definition.operation:
													ParameterDefinition(_):
														state.parameters.append(definition.id)
													_:
														state.parameters

												state = { state |
													values = state.values.append({
														value_type = definition.value_type,
														span = definition.span,
														result = definition.result,
														projection_parent = definition_parent(
															definition,
															projection,
														),
													}),
													parameters = parameters
												}
												Ok(void)
			ExecuteJoin(join):
				start: VerificationState = { facts = state, discharged = discharged, owners = owners }
				match introduce_join(join, start, unions, records):
					Err(error): Err(error)
					Ok(introduced):
						pending = pending.append({ join = join, start = start })
						state = introduced.facts
						owners = introduced.owners
						Ok(void)

			AcquireOwner(id, borrow, span):
				match verify_borrow(borrow, state, span, discharged, owners):
					Err(error):
						Err(error)
					Ok(_):
						match validate_next_owner(state.first_owner, owners, id, span):
							Err(error):
								Err(error)
							Ok(_):
								owners = owners.append(ActiveOwner(borrow.value))
								Ok(void)
			DropOwner(id, span):
				match verified_drop(id, span, state, discharged, owners):
					Err(error):
						Err(error)
					Ok(EnclosingSlot(ordinal)):
						match discharge(state, discharged, ordinal, span):
							Err(error):
								Err(error)
							Ok(flags):
								discharged = flags
								Ok(void)
					Ok(LocalSlot(index)):
						owners = owners.set(index, DischargedOwner)
						Ok(void)

		match checked:
			Ok(_):
				void
			Err(error):
				invalid = Some(error)
				break

	match invalid:
		Some(error):
			Err(error)
		None:
			Ok({
				state = {
					facts = state,
					discharged = discharged,
					owners = owners,
				},
				pending = pending,
			})


-- The edge a block leaves by, which names an owner it leaves live.
private fixed union ExitEdge:
	ReturnEdge
	YieldEdge


private pure func complete_owners(
	owners: List[OwnerState],
	first_owner: Int,
	excluded: Option[OwnerId],
	edge: ExitEdge,
	span: Span,
) -> Result[Void, Diagnostic]:
	var position = first_owner
	var failure_owner: Option[Int] = None

	for owner in owners:
		match owner:
			ActiveOwner(_):
				transferred = match excluded:
					Some(id):
						IntOps.equals(owner_number(id), position)
					None:
						False

				if not transferred:
					failure_owner = Some(position)
					break
			DischargedOwner:
				void

		position = IntOps.add(position, 1)

	match failure_owner:
		Some(id):
			owner_prefix: String = "owner ".append_int(id)
			edge_description: String = match edge:
				ReturnEdge: " remains live at return"
				YieldEdge: " remains live at yield"
			Err(verification_error(span, owner_prefix.concat(edge_description)))
		None:
			Ok(void)


-- Every enclosing owner, function prefix and enclosing arms alike, is
-- discharged when the function returns from a nested block.
private pure func complete_enclosing(
	state: VerificationState,
	excluded: Option[OwnerId],
	span: Span,
) -> Result[Void, Diagnostic]:
	var failure_owner: Option[Int] = None
	for scope in state.facts.enclosing:
		var ordinal = scope.first_owner
		for entry in scope.owners:
			match entry:
				ActiveOwner(_):
					transferred = match excluded:
						Some(id): IntOps.equals(owner_number(id), ordinal)
						None: False
					if failure_owner.is_none() and not transferred and not discharged_already(state.discharged, ordinal):
						failure_owner = Some(ordinal)
				DischargedOwner:
					void
			ordinal = IntOps.add(ordinal, 1)
	match failure_owner:
		Some(id):
			Err(verification_error(span, "owner ".append_int(id).concat(" remains live at return")))
		None:
			Ok(void)


private pure func verify_return(
	returned: ValueId,
	returned_owner: Option[OwnerId],
	state: VerificationState,
	return_type: TypeRef,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	result ?= known_value(
		state.facts,
		returned,
		{
			source = compiler_source(),
			start = 0,
			end = 0
		},
	)

	if not same_type(result.value_type, return_type):
		Err(verification_error(result.span, "return type does not match its contract"))
	else:
		match value_ownership(return_type, unions, records):
			Ok(plan):

				ownership_result: Result[Void, Diagnostic] = match plan:
					NoOwnership:
						match returned_owner:
							None:
								Ok(void)
							Some(_):
								Err(verification_error(result.span, "unmanaged return cannot transfer an owner"))
					ManagedStringLeaf | ManagedListRoot | ManagedRecordRoot(_) | InlineOwnedFields(_) | ManagedUnionRoot(_):
						match returned_owner:
							None:
								Err(verification_error(result.span, "managed return requires an owner transfer"))
							Some(id):
								match known_owner(
									state.facts,
									state.discharged,
									state.owners,
									id,
									result.span,
								):
									Ok(entry):

										match entry:
											DischargedOwner:
												Err(
													verification_error(
														result.span,
														"return refers to discharged owner ".append_int(
															owner_number(id),
														),
													),
												)
											ActiveOwner(owned):
												if IntOps.equals(value_number(owned), value_number(returned)):
													Ok(void)
												else:
													Err(
														verification_error(
															result.span,
															"returned owner does not own the returned value",
														),
													)
									Err(error): Err(error)

				match ownership_result:
					Ok(transferred):
						match complete_enclosing(state, returned_owner, result.span):
							Ok(prefix): complete_owners(state.owners, state.facts.first_owner, returned_owner, ReturnEdge, result.span)
							Err(error): Err(error)
					Err(error): Err(error)
			Err(error): Err(error)


private pure func verify_transfer(
	result: ReturnTransfer,
	state: VerificationState,
	return_type: TypeRef,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	match result:
		UnmanagedReturn(value):
			verify_return(value, None, state, return_type, unions, records)
		OwnedReturn(value, owner):
			verify_return(value, Some(owner), state, return_type, unions, records)


private pure func verify_exit(
	exit: OwnedExit,
	state: VerificationState,
	signature: FunctionSignature,
	execution: FunctionExecution,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	match exit:
		ReturnResult(result):
			verify_transfer(result, state, signature.return_type, unions, records)
		RecurArguments(arguments, span):
			match execution:
				OrdinaryCalls:
					Err(verification_error(span, "recursive backedge outside a self-tail loop"))
				SelfTailLoop(_):
					if IntOps.equals(arguments.length(), signature.parameters.length()):
						var invalid: Option[Diagnostic] = None
						var position: Int = 0

						for argument in arguments:
							parameter_position = position
							result: Result[Void, Diagnostic] = known_value(
								state.facts,
								argument,
								span,
							).and_then(pure func(known: KnownValue) -> Result[Void, Diagnostic]:
								match signature.parameters.get(parameter_position):
									None:
										Err(verification_error(span, "missing recursive backedge parameter"))
									Some(expected):
										if not same_type(known.value_type, expected):
											Err(verification_error(span, "recursive backedge type does not match its parameter"))
										else:
											match value_ownership(known.value_type, unions, records):
												Err(error):
													Err(error)
												Ok(plan):
													match plan:
														NoOwnership:
															Ok(void)
														ManagedStringLeaf | ManagedListRoot | ManagedRecordRoot(_) | InlineOwnedFields(_) | ManagedUnionRoot(_):
															Err(verification_error(span, "managed value on a recursive backedge"))
							)

							match result:
								Err(error):
									invalid = Some(error)
									break
								Ok(_):
									position = IntOps.add(position, 1)

						match invalid:
							Some(error):
								Err(error)
							None:
								complete_owners(state.owners, state.facts.first_owner, None, ReturnEdge, span)
					else:
						Err(verification_error(span, "recursive backedge arity does not match its function"))


private pure func is_backedge(exit: OwnedExit) -> Bool:
	match exit:
		ReturnResult(_):
			False
		RecurArguments(_, _):
			True


private pure func verify_loop_type(
	value_type: TypeRef,
	span: Span,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	plan ?= value_ownership(value_type, unions, records)
	match plan:
		NoOwnership: Ok(void)
		_: Err(verification_error(span, "managed value appears in a self-tail loop"))


-- This preflight deliberately inspects raw definitions, including values whose
-- owners have already been dropped. The normal verifier still proves each type.
private pure func verify_loop_operations(
	operations: List[OwnershipOperation],
	current: Int,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	var invalid: Option[Diagnostic] = None

	for operation in operations:
		match operation:
			DefineValue(definition):
				match verify_loop_type(definition.value_type, definition.span, unions, records):
					Err(error): invalid = Some(error)
					Ok(_): void

				match definition.operation:
					CallDefinition(target, _):
						match target:
							UserFunction(id):
								if IntOps.equals(function_number(id), current):
									invalid = Some(
										verification_error(
											definition.span,
											"ordinary self call remains in a self-tail loop",
										),
									)
							RuntimeFunction(_):
								void

					_:
						void
			ExecuteJoin(join):
				parameter = join_parameter(join.result)
				match verify_loop_type(parameter.value_type, parameter.span, unions, records):
					Err(error): invalid = Some(error)
					Ok(_): void
				for output in join.carried:
					if invalid.is_some():
						break
					carried = join_parameter(output)
					match verify_loop_type(carried.value_type, carried.span, unions, records):
						Err(error): invalid = Some(error)
						Ok(_): void
				for arm in join.arms:
					if invalid.is_none():
						match verify_loop_operations(arm.operations, current, unions, records):
							Err(error): invalid = Some(error)
							Ok(_): void

			AcquireOwner(_, _, span):
				invalid = Some(verification_error(span, "owner operation appears in a self-tail loop"))
			DropOwner(_, span):
				invalid = Some(verification_error(span, "owner operation appears in a self-tail loop"))

		match invalid:
			Some(_):
				break
			None:
				void

	match invalid:
		Some(error):
			Err(error)
		None:
			Ok(void)


private pure func verify_execution(
	function: OwnedFunction,
	current: Int,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	match function.execution:
		OrdinaryCalls:
			Ok(void)
		SelfTailLoop(annotation):
			var invalid: Option[Diagnostic] = None

			for value_type in function.signature.parameters.append(function.signature.return_type):
				match value_ownership(value_type, unions, records):
					Err(error):
						invalid = Some(error)
						break
					Ok(ManagedStringLeaf) | Ok(ManagedListRoot) | Ok(ManagedRecordRoot(_)) | Ok(InlineOwnedFields(_)) | Ok(ManagedUnionRoot(_)):
						invalid = Some(verification_error(annotation, "managed signature in a self-tail loop"))
						break
					Ok(NoOwnership):
						void

			match invalid:
				Some(error):
					Err(error)
				None:
					match verify_loop_operations(function.operations, current, unions, records):
						Ok(prefix):
							var found = False

							match function.tail:
								ReturnTail(exit):
									found = is_backedge(exit)
								MatchTail(matched):
									for arm in matched.arms:
										match verify_loop_operations(arm.operations, current, unions, records):
											Err(error):
												invalid = Some(error)
												break
											Ok(_):
												found = found or is_backedge(arm.exit)

							match invalid:
								Some(error):
									Err(error)
								None:
									if found:
										Ok(void)
									else:
										Err(verification_error(annotation, "self-tail loop has no recursive backedge"))
						Err(error): Err(error)


-- OwnershipProgram is public raw data: its reconstructed arms do not retain
-- checking's sealed proof of coverage and usefulness. Re-establish that proof
-- here so emission can project the accepted labels without repairing them.
private pure func verify_match_labels(
	owner: UnionInstanceId,
	labels: List[MatchLabel],
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[Void, Diagnostic]:
	nonempty ?= if IntOps.equals(labels.length(), 0):
		Err(verification_error(span, "match has no arms"))
	else:
		Ok(void)

	declaration ?= unions
		.get(union_number(owner))
		.to_result(verification_error(span, "unknown match union"))
	var seen: List[Bool] = []

	for _ in declaration.variants:
		seen = seen.append(False)

	var remaining = seen.length()
	var has_default = False
	var invalid: Option[Diagnostic] = None

	for label in labels:
		match label:
			DefaultLabel:
				if has_default:
					invalid = Some(verification_error(span, "match default appears more than once"))
					break
				else if IntOps.equals(remaining, 0):
					invalid = Some(verification_error(span, "match default covers no remaining variants"))
					break
				else:
					has_default = True
			VariantLabel(id):
				if IntOps.not_equals(union_number(variant_owner(id)), union_number(owner)):
					invalid = Some(verification_error(span, "match variant belongs to another union"))
					break
				else:
					ordinal = variant_number(id)

					match seen.get(ordinal):
						None:
							invalid = Some(verification_error(span, "unknown variant identity"))
							break
						Some(already_seen):
							if already_seen:
								invalid = Some(
									verification_error(
										span,
										"match variant appears more than once",
									),
								)
								break
							else if has_default:
								invalid = Some(verification_error(span, "match default must be the final arm"))
								break
							else:
								seen = seen.set(ordinal, True)
								remaining = IntOps.subtract(remaining, 1)

	match invalid:
		Some(error):
			Err(error)
		None:
			if not has_default and IntOps.not_equals(remaining, 0):
				Err(verification_error(span, "match does not cover every variant"))
			else:
				Ok(void)


-- A nested block's starting state: the enclosing block's state `start`
-- becomes one more enclosing scope, shared rather than copied, and its own
-- values and owners begin at the given ordinals. Sibling ordinal gaps never
-- become visible.
private pure func enter(
	start: VerificationState,
	first_value: Int,
	first_owner: Int,
	enclosing_discharge: EnclosingDischarge,
) -> VerificationState:
	facts = start.facts
	{
		facts = { facts |
			enclosing = facts.enclosing.append({
				first_value = facts.first_value,
				values = facts.values,
				first_owner = facts.first_owner,
				owners = start.owners
			}),
			enclosing_discharge = enclosing_discharge,
			first_value = first_value,
			values = [],
			first_owner = first_owner
		},
		discharged = start.discharged,
		owners = []
	}


-- The ordinals after a block and the joins nested in it.
private fixed record BlockEnd {
	next_value: Int,
	next_owner: Int
}


private pure func block_end(state: VerificationState) -> BlockEnd:
	{
		next_value = IntOps.add(state.facts.first_value, state.facts.values.length()),
		next_owner = IntOps.add(state.facts.first_owner, state.owners.length())
	}


-- A yield moves the joined value into the join's own definition. It may
-- move only an owner made in its arm, and must have discharged the arm's
-- other owners. Every enclosing owner is still live: a join arm cannot
-- discharge one, so all edges into the join agree.
private pure func consume_yield(
	transfer: ReturnTransfer,
	state: VerificationState,
	join_type: TypeRef,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
	span: Span,
) -> Result[VerificationState, Diagnostic]:
	yielded = match transfer:
		UnmanagedReturn(value): value
		OwnedReturn(value, _): value
	moved = match transfer:
		UnmanagedReturn(_): None
		OwnedReturn(_, owner): Some(owner)
	known ?= known_value(state.facts, yielded, span)
	matching ?= if same_type(known.value_type, join_type):
		Ok(void)
	else:
		Err(verification_error(span, "yield type does not match its join"))
	plan ?= value_ownership(join_type, unions, records)
	transferred: Result[Option[Int], Diagnostic] = match plan:
		NoOwnership:
			match moved:
				None: Ok(None)
				Some(_): Err(verification_error(span, "unmanaged yield cannot transfer an owner"))
		ManagedStringLeaf | ManagedListRoot | ManagedRecordRoot(_) | InlineOwnedFields(_) | ManagedUnionRoot(_):
			match moved:
				None:
					Err(verification_error(span, "managed yield requires an owner transfer"))
				Some(id):
					match owner_slot(state.facts, state.owners.length(), id, span):
						Ok(slot):
							match slot:
								EnclosingSlot(_):
									Err(verification_error(span, "yield must transfer an owner made in its arm, not owner ".append_int(owner_number(id))))
								LocalSlot(position):
									match known_owner(state.facts, state.discharged, state.owners, id, span):
										Ok(entry):
											match entry:
												ActiveOwner(owned):
													if IntOps.equals(value_number(owned), value_number(yielded)):
														Ok(Some(position))
													else:
														Err(verification_error(span, "yielded owner does not own the yielded value"))
												DischargedOwner:
													Err(verification_error(span, "yield refers to discharged owner ".append_int(owner_number(id))))
										Err(error): Err(error)
						Err(error): Err(error)
	consumed ?= transferred
	match consumed:
		None: Ok(state)
		Some(position): Ok({ state | owners = state.owners.set(position, DischargedOwner) })


private pure func verify_yield(
	transfer: ReturnTransfer,
	state: VerificationState,
	join_type: TypeRef,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
	span: Span,
) -> Result[Void, Diagnostic]:
	consumed ?= consume_yield(transfer, state, join_type, unions, records, span)
	complete_owners(consumed.owners, state.facts.first_owner, None, YieldEdge, span)


private pure func verify_join_transfers(
	arm: OwnedJoinArm,
	join: OwnedJoin,
	state: VerificationState,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	result = join_parameter(join.result)
	if join.carried.is_empty():
		verify_yield(arm.transfer, state, result.value_type, unions, records, result.span)
	else:
		match consume_yield(arm.transfer, state, result.value_type, unions, records, result.span):
			Err(error): Err(error)
			Ok(first):
				var current = first
				var position = 0
				var invalid: Option[Diagnostic] = None
				for output in join.carried:
					parameter = join_parameter(output)
					match arm.carried.get(position):
						None: invalid = Some(verification_error(result.span, "join arm carries the wrong number of values"))
						Some(transfer):
							match consume_yield(transfer, current, parameter.value_type, unions, records, parameter.span):
								Ok(consumed): current = consumed
								Err(error): invalid = Some(error)
					if invalid.is_some():
						break
					position = IntOps.add(position, 1)
				match invalid:
					Some(error): Err(error)
					None: complete_owners(current.owners, state.facts.first_owner, None, YieldEdge, result.span)


-- Verifies every pending join's arms after their block, in the order their
-- values and owners are numbered, and returns the ordinals after them.
private pure func verify_joins(
	pending: List[PendingJoin],
	end: BlockEnd,
	signature: FunctionSignature,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[BlockEnd, Diagnostic]:
	var cursor = end
	var invalid: Option[Diagnostic] = None
	for join in pending:
		for arm in join.join.arms:
			match verify_join_arm(arm, join, cursor, signature, functions, unions, records):
				Err(error):
					invalid = Some(error)
					break
				Ok(after):
					cursor = after
		if invalid.is_some():
			break
	match invalid:
		Some(error): Err(error)
		None: Ok(cursor)


private pure func verify_join_arm(
	arm: OwnedJoinArm,
	join: PendingJoin,
	cursor: BlockEnd,
	signature: FunctionSignature,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[BlockEnd, Diagnostic]:
	result = join_parameter(join.join.result)
	admitted ?= if IntOps.equals(arm.carried.length(), join.join.carried.length()):
		Ok(void)
	else:
		Err(verification_error(result.span, "join arm carries the wrong number of values"))
	start = enter(join.start, cursor.next_value, cursor.next_owner, KeepsEnclosing)
	projection = match arm.label:
		DefaultLabel: NoProjection
		VariantLabel(id): PayloadProjection(join.join.scrutinee, id)
	verified ?= verify_operations(arm.operations, start, signature, functions, unions, projection, records)
	left ?= verify_join_transfers(arm, join.join, verified.state, unions, records)
	verify_joins(verified.pending, block_end(verified.state), signature, functions, unions, records)


private pure func verify_match(
	matched: OwnedMatch,
	execution: FunctionExecution,
	state: VerificationState,
	end: BlockEnd,
	signature: FunctionSignature,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	scrutinee ?= known_value(
		state.facts,
		argument_value(matched.scrutinee),
		{
			source = compiler_source(),
			start = 0,
			end = 0
		},
	)

	if not same_type(scrutinee.value_type, UnionType(matched.owner)):
		Err(verification_error(scrutinee.span, "match scrutinee does not belong to its union"))
	else:
		var labels: List[MatchLabel] = []
		for arm in matched.arms:
			labels = labels.append(arm.label)
		match verify_match_labels(matched.owner, labels, unions, scrutinee.span):
			Ok(valid_arms):
				match verify_match_argument(
					matched.scrutinee,
					state.facts,
					unions,
					records,
					scrutinee.span,
					state.discharged,
					state.owners,
				):
					Ok(live):
						var cursor = end
						var invalid: Option[Diagnostic] = None

						-- Each selected arm receives an independent prefix snapshot and a disjoint
						-- local owner interval, after the previous arm and its joins.
						for arm in matched.arms:
							branch_start = enter(state, cursor.next_value, cursor.next_owner, MayDischargeEnclosing)

							projection = match arm.label:
								DefaultLabel:
									NoProjection
								VariantLabel(id):
									PayloadProjection(matched.scrutinee, id)

							match verify_operations(
								arm.operations,
								branch_start,
								signature,
								functions,
								unions,
								projection,
								records,
							):
								Err(error):
									invalid = Some(error)
									break
								Ok(branch):
									match verify_exit(arm.exit, branch.state, signature, execution, unions, records):
										Err(error):
											invalid = Some(error)
											break
										Ok(_):
											match verify_joins(branch.pending, block_end(branch.state), signature, functions, unions, records):
												Ok(after):
													cursor = after
												Err(error):
													invalid = Some(error)
													break

						match invalid:
							Some(error):
								Err(error)
							None:
								Ok(void)
					Err(error): Err(error)
			Err(error): Err(error)


private pure func verify_function(
	function: OwnedFunction,
	current: Int,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	execution ?= verify_execution(function, current, unions, records)
	initial: VerificationState = {
		facts = {
			enclosing = [],
			enclosing_discharge = MayDischargeEnclosing,
			first_value = 0,
			values = [],
			first_owner = 0,
			parameters = []
		},
		discharged = [],
		owners = []
	}
	verified ?= verify_operations(
		function.operations,
		initial,
		function.signature,
		functions,
		unions,
		NoProjection,
		records,
	)
	state = verified.state

	valid_parameter ?= if IntOps.equals(
		state.facts.parameters.length(),
		function.signature.parameters.length(),
	):
		Ok(void)
	else:
		Err(
			verification_error(
				{
					source = compiler_source(),
					start = 0,
					end = 0
				},
				"function parameter has no value definition",
			),
		)

	match function.tail:
		ReturnTail(result):
			match verify_exit(result, state, function.signature, function.execution, unions, records):
				Ok(exit):
					match verify_joins(verified.pending, block_end(state), function.signature, functions, unions, records):
						Ok(joins): Ok(void)
						Err(error): Err(error)
				Err(error): Err(error)
		MatchTail(matched):
			-- The prefix's joins' arms precede the tail arms.
			match verify_joins(verified.pending, block_end(state), function.signature, functions, unions, records):
				Ok(end):
					verify_match(
						matched,
						function.execution,
						state,
						end,
						function.signature,
						functions,
						unions,
						records,
					)
				Err(error): Err(error)


-- Independently check the accepted wrapper convention against its target signature.
private pure func verify_entry(
	entry: OwnedFunction,
	convention: Entrypoint[FunctionInstanceId],
) -> Result[Void, Diagnostic]:
	parameters_match = match convention:
		NoArguments(_, _):
			entry.signature.parameters.is_empty()
		WithArguments(_, _):
			match entry.signature.parameters:
				[value]:
					same_type(value, ListType(StringType))
				_:
					False

	result = match convention:
		NoArguments(_, result):
			result
		WithArguments(_, result):
			result

	result_matches = match result:
		IntegerExitStatus:
			same_type(entry.signature.return_type, IntType)
		SuccessfulExit:
			same_type(entry.signature.return_type, VoidType)

	valid = parameters_match and result_matches

	if valid:
		Ok(void)
	else:
		span: Span = match entry.operations.get(0):
			Some(operation):
				match operation:
					DefineValue(definition):
						definition.span
					ExecuteJoin(join): join_parameter(join.result).span
					AcquireOwner(_, _, occurrence):
						occurrence
					DropOwner(_, occurrence):
						occurrence
			None:
				{
					source = compiler_source(),
					start = 0,
					end = 0
				}

		Err(
			verification_error(
				span,
				"entrypoint signature does not match its accepted argument and result conventions",
			),
		)


pure func verify(program: OwnershipProgram) -> Result[VerifiedProgram, Diagnostic]:
	entry ?= program.functions
		.get(function_number(entry_function(program.entrypoint)))
		.to_result(
			verification_error(
				{
					source = compiler_source(),
					start = 0,
					end = 0
				},
				"entrypoint function is not defined",
			),
		)
	var invalid: Option[Diagnostic] = None

	for layout in program.records:
		match (
			valid_record_layout(
				layout,
				{
					source = compiler_source(),
					start = 0,
					end = 0
				},
			)
		):
			Ok(_):
				void
			Err(error):
				invalid = Some(error)
				break

	var union_position = 0

	for layout in program.unions:
		if invalid.is_some():
			break

		match valid_union_layout(layout, union_position, program.records, program.unions):
			Err(error):
				invalid = Some(error)
				break
			Ok(_):
				union_position = IntOps.add(union_position, 1)

	complete_layouts ?= match invalid:
		Some(error):
			Err(error)
		None:
			verify_layout_graph(program.records, program.unions)

	var current: Int = 0

	for function in program.functions:
		for value_type in function.signature.parameters.append(function.signature.return_type):
			match verify_type_membership(value_type, program.unions, program.records, { source = compiler_source(), start = 0, end = 0 }):
				Ok(_):
					void
				Err(error):
					invalid = Some(error)

		if invalid.is_some():
			break

		match verify_function(
			function,
			current,
			program.functions,
			program.unions,
			program.records,
		):
			Ok(_):
				current = IntOps.add(current, 1)
			Err(error):
				invalid = Some(error)
				break

	match invalid:
		Some(error):
			Err(error)
		None:
			match verify_entry(entry, program.entrypoint):
				Ok(valid_entry): Ok(into_opaque VerifiedProgram(program))
				Err(error): Err(error)
