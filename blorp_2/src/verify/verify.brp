-- Concrete representation is an upstream fact, shared with insertion.
-- Verification independently validates the actual raw operations and layouts;
-- it does not consume insertion's decisions about owners or borrow lifetimes.
-- This seal belongs to the exact operations and contracts checked below.
opaque type VerifiedProgram = OwnershipProgram


pure func verified_contents(program: VerifiedProgram) -> OwnershipProgram:
	from_opaque VerifiedProgram(program)


private pure func failure(span: Span, message: String) -> Diagnostic:
	{
		span = span,
		note = None,
		message = "ownership verification failed: ".concat(message),
		help = "report this compiler error with the input program"
	}


-- List storage ownership is a root fact. Raw IR must also name a member of
-- each supplied concrete catalogue; do not expand nominal fields per query.
private pure func verify_type_membership(
	value_type: TypeRef,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
	span: Span,
) -> Result[Void, Diagnostic]:
	var terminal = value_type
	while True:
		match terminal:
			ListType(element): terminal = element
			VoidType | IntType | FloatType | StringType | RecordType(_) | UnionType(_): break
	match value_ownership(terminal, unions, records):
		Ok(_): Ok(void)
		Err(error): Err({ error | span = span })


private fixed record KnownValue {
	value_type: TypeRef,
	span: Span,
	result: ResultOwnership,
	projection_parent: Option[BorrowedValue]
}


private fixed union OwnerState:
	ActiveOwner(ValueId)
	DischargedOwner


private fixed record VerificationFacts {
	prefix_values: List[KnownValue],
	first_value: Int,
	values: List[KnownValue],
	first_owner: Int,
	parameters: List[ValueId]
}


private fixed record VerificationState {
	facts: VerificationFacts,
	prefix_owners: List[OwnerState],
	owners: List[OwnerState]
}


private fixed union ProjectionContext:
	NoProjection
	PayloadProjection(OwnedArgument, VariantInstanceId)


private pure func value(
	state: VerificationFacts,
	id: ValueId,
	span: Span,
) -> Result[KnownValue, Diagnostic]:
	error = failure(
		span,
		"value "
			.append_int(value_number(id))
			.concat(" is not defined before use"),
	)
	ordinal = value_number(id)

	entry = if (
		IntOps.greater_than_or_equal(ordinal, 0)
		and IntOps.less_than(ordinal, state.prefix_values.length())
	):
		state.prefix_values.get(ordinal)
	else if IntOps.greater_than_or_equal(ordinal, state.first_value):
		state.values.get(IntOps.subtract(ordinal, state.first_value))
	else:
		None

	entry.to_result(error)


private fixed union OwnerSlot:
	PrefixSlot(Int)
	LocalSlot(Int)


private pure func owner_slot(
	prefix_count: Int,
	first_owner: Int,
	owner_count: Int,
	id: OwnerId,
	span: Span,
) -> Result[OwnerSlot, Diagnostic]:
	ordinal = owner_number(id)

	if IntOps.greater_than_or_equal(ordinal, 0) and IntOps.less_than(ordinal, prefix_count):
		Ok(PrefixSlot(ordinal))
	else if IntOps.greater_than_or_equal(ordinal, 0) and IntOps.less_than(ordinal, first_owner):
		Err(
			failure(
				span,
				"owner "
					.append_int(ordinal)
					.concat(" is not available in this match arm"),
			),
		)
	else if IntOps.greater_than_or_equal(ordinal, first_owner) and IntOps.less_than(
		ordinal,
		IntOps.add(first_owner, owner_count),
	):
		Ok(LocalSlot(IntOps.subtract(ordinal, first_owner)))
	else:
		Err(
			failure(
				span,
				"owner "
					.append_int(ordinal)
					.concat(" is not defined"),
			),
		)


private pure func owner(
	prefix_owners: List[OwnerState],
	first_owner: Int,
	owners: List[OwnerState],
	id: OwnerId,
	span: Span,
) -> Result[OwnerState, Diagnostic]:
	slot ?= owner_slot(prefix_owners.length(), first_owner, owners.length(), id, span)

	entry = match slot:
		PrefixSlot(index):
			prefix_owners.get(index)
		LocalSlot(index):
			owners.get(index)

	entry.to_result(
		failure(
			span,
			"owner "
				.append_int(owner_number(id))
				.concat(" is not defined"),
		),
	)


private pure func validate_next_owner(
	first_owner: Int,
	owners: List[OwnerState],
	id: OwnerId,
	span: Span,
) -> Result[Void, Diagnostic]:
	ordinal = owner_number(id)
	next_owner = IntOps.add(first_owner, owners.length())

	if IntOps.less_than(ordinal, 0):
		Err(failure(span, "negative owner identity"))
	else if IntOps.less_than(ordinal, next_owner):
		Err(
			failure(
				span,
				"owner "
					.append_int(ordinal)
					.concat(" is defined more than once"),
			),
		)
	else if IntOps.not_equals(ordinal, next_owner):
		Err(failure(span, "owner identity is not the next function ordinal"))
	else:
		Ok(void)


private pure func argument_value(argument: OwnedArgument) -> ValueId:
	match argument:
		UnmanagedArgument(id):
			id
		BorrowedArgument(borrow):
			borrow.value


private pure func verify_borrow(
	borrow: BorrowedValue,
	state: VerificationFacts,
	span: Span,
	prefix_owners: List[OwnerState],
	owners: List[OwnerState],
) -> Result[Void, Diagnostic]:
	borrowed ?= value(state, borrow.value, span)

	managed ?= match borrowed.result:
		UnmanagedResult:
			Err(failure(span, "borrow requires a managed value"))
		_:
			Ok(void)

	match borrow.source:
		ParameterBorrow(source):
			if (
				IntOps.equals(value_number(source), value_number(borrow.value))
				and state.parameters.any(
					pure func(
						parameter: ValueId,
					) -> Bool: IntOps.equals(value_number(parameter), value_number(source)),
				)
			):
				Ok(void)
			else:
				Err(failure(span, "parameter borrow does not refer to the borrowed parameter"))
		OwnerBorrow(id):
			entry ?= owner(prefix_owners, state.first_owner, owners, id, span)

			match entry:
				DischargedOwner:
					Err(
						failure(
							span,
							"borrow refers to discharged owner ".append_int(owner_number(id)),
						),
					)
				ActiveOwner(owned):
					if IntOps.equals(value_number(owned), value_number(borrow.value)):
						Ok(void)
					else:
						Err(
							failure(
								span,
								"owner "
									.append_int(owner_number(id))
									.concat(" does not own value ")
									.append_int(value_number(borrow.value)),
							),
						)
		PayloadBorrow(parent):
			valid ?= match borrowed.result:
				BorrowedResult(PayloadBorrow(expected)):
					if IntOps.equals(value_number(parent), value_number(expected)):
						Ok(void)
					else:
						Err(failure(span, "payload borrow has the wrong parent value"))
				_:
					Err(failure(span, "payload borrow requires a borrowed projection"))

			ancestor ?= borrowed.projection_parent.to_result(
				failure(
					span,
					"projection has no parent lifetime",
				),
			)

			if IntOps.equals(value_number(ancestor.value), value_number(parent)):
				verify_borrow(ancestor, state, span, prefix_owners, owners)
			else:
				Err(failure(span, "payload borrow has the wrong parent value"))


private pure func call_signature(
	call: ConcreteCall,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[FunctionSignature, Diagnostic]:
	match call.target:
		RuntimeFunction(operation):
			contract = runtime_signature(operation)
			var invalid: Option[Diagnostic] = None
			for parameter in contract.parameters:
				match verify_type_membership(parameter, unions, records, call.span):
					Ok(_): void
					Err(error):
						invalid = Some(error)
						break
			parameters ?= match invalid:
				None: Ok(void)
				Some(error): Err(error)
			validation: Result[Void, Diagnostic] = match runtime_contract(operation).return_type:
				ValueResult(_):
					Ok(void)
				OptionalResult(payload, roles):
					expected_payload = runtime_type_ref(payload)

					present ?= variant_type(
						roles.present,
						[expected_payload],
						unions,
						call.span,
					)
					absent ?= variant_type(roles.absent, [], unions, call.span)
					owner = variant_owner(roles.present)
					layout ?= unions
						.get(union_number(owner))
						.to_result(failure(call.span, "unknown runtime result union"))

					if (
						same_type(present, absent)
						and IntOps.equals(layout.variants.length(), 2)
						and not IntOps.equals(variant_number(roles.present), variant_number(roles.absent))
					):
						Ok(void)
					else:
						Err(
							failure(
								call.span,
								"runtime constructor roles do not cover one result union",
							),
						)
				BooleanResult(roles):
					equal ?= variant_type(roles.equal, [], unions, call.span)
					different ?= variant_type(roles.different, [], unions, call.span)
					owner = variant_owner(roles.equal)
					layout ?= unions
						.get(union_number(owner))
						.to_result(failure(call.span, "unknown runtime result union"))

					if (
						same_type(equal, different)
						and IntOps.equals(layout.variants.length(), 2)
						and not IntOps.equals(variant_number(roles.equal), variant_number(roles.different))
					):
						Ok(void)
					else:
						Err(
							failure(
								call.span,
								"runtime comparison roles do not cover one result union",
							),
						)

			valid ?= validation
			result ?= verify_type_membership(contract.return_type, unions, records, call.span)
			Ok(contract)
		UserFunction(id):
			function ?= functions
				.get(function_number(id))
				.to_result(failure(call.span, "unknown called function"))
			Ok(function.signature)


private pure func verify_argument(
	argument: OwnedArgument,
	expected: TypeRef,
	state: VerificationFacts,
	unions: List[ConcreteUnion],
	span: Span,
	records: List[ConcreteRecord],
	prefix_owners: List[OwnerState],
	owners: List[OwnerState],
) -> Result[Void, Diagnostic]:
	id = match argument:
		UnmanagedArgument(id):
			id
		BorrowedArgument(borrow):
			borrow.value

	known ?= value(state, id, span)

	if not same_type(known.value_type, expected):
		Err(failure(span, "call argument type does not match its contract"))
	else:
		match argument:
			UnmanagedArgument(_):
				plan ?= value_ownership(expected, unions, records)

				match plan:
					NoOwnership:
						Ok(void)
					ManagedStringLeaf | ManagedListRoot | ManagedRecordRoot(_) | InlineOwnedFields(_) | ManagedUnionRoot(_):
						Err(
							failure(
								span,
								"managed call argument requires an owner-dependent borrow",
							),
						)
			BorrowedArgument(borrow):
				verify_borrow(borrow, state, span, prefix_owners, owners)


private pure func verify_arguments(
	arguments: List[OwnedArgument],
	parameters: List[TypeRef],
	state: VerificationFacts,
	unions: List[ConcreteUnion],
	span: Span,
	records: List[ConcreteRecord],
	prefix_owners: List[OwnerState],
	owners: List[OwnerState],
) -> Result[Void, Diagnostic]:
	if IntOps.less_than(arguments.length(), parameters.length()):
		Err(failure(span, "call is missing its argument"))
	else if IntOps.greater_than(arguments.length(), parameters.length()):
		Err(failure(span, "call has an unexpected argument"))
	else:
		var index: Int = 0
		var invalid: Option[Diagnostic] = None

		for argument in arguments:
			match parameters.get(index):
				None:
					invalid = Some(failure(span, "missing call parameter contract"))
					break
				Some(expected):
					match verify_argument(
						argument,
						expected,
						state,
						unions,
						span,
						records,
						prefix_owners,
						owners,
					):
						Err(error):
							invalid = Some(error)
							break
						Ok(_):
							void

			index = IntOps.add(index, 1)

		match invalid:
			Some(error):
				Err(error)
			None:
				Ok(void)


private pure func variant_shape(id: VariantInstanceId, unions: List[ConcreteUnion], span: Span) -> Result[List[TypeRef], Diagnostic]:
	declaration ?= unions.get(union_number(variant_owner(id))).to_result(failure(span, "unknown variant owner"))
	declaration.variants.get(variant_number(id)).to_result(failure(span, "unknown variant identity"))


private pure func variant_type(id: VariantInstanceId, expected: List[TypeRef], unions: List[ConcreteUnion], span: Span) -> Result[TypeRef, Diagnostic]:
	shape ?= variant_shape(id, unions, span)
	if not IntOps.equals(shape.length(), expected.length()):
		Err(failure(span, "variant field count does not match its operation"))
	else:
		var position = 0
		var valid = True
		for actual in expected:
			match shape.get(position):
				Some(field): valid = valid and same_type(field, actual)
				None: valid = False
			position = IntOps.add(position, 1)
		if valid:
			Ok(UnionType(variant_owner(id)))
		else:
			Err(failure(span, "variant payload does not match its operation"))


private pure func valid_union_layout(
	layout: ConcreteUnion,
	position: Int,
	records: List[ConcreteRecord],
	unions: List[ConcreteUnion],
) -> Result[Void, Diagnostic]:
	span: Span = {
		source = COMPILER_SOURCE,
		start = 0,
		end = 0
	}

	if IntOps.equals(layout.variants.length(), 0):
		Err(failure(span, "union layout must contain one or more variants"))
	else:
		var invalid: Option[Diagnostic] = None
		var owning = False
		var self_referencing = False

		for fields in layout.variants:
			var self_payloads = 0

			for value_type in fields:
				valid = match value_type:
					VoidType | IntType | FloatType:
						True
					RecordType(id):
						match records.get(record_number(id)):
							Some(child):
								match child.representation:
									ManagedRecord:
										owning = True
									InlineRecord:
										void

								True
							None:
								False
					UnionType(id):
						if IntOps.equals(union_number(id), position):
							-- The unary recursive shape: a boxed node's pointer to
							-- at most one child of its own layout.
							self_referencing = True
							self_payloads = IntOps.add(self_payloads, 1)

							match layout.representation:
								BoxedRecursive:
									if IntOps.greater_than(self_payloads, 1):
										invalid = Some(failure(span, "boxed union variant may store at most one self-reference"))
								InlineUnmanaged | InlineOwningPayload:
									invalid = Some(failure(span, "recursive union payload requires the boxed representation"))

							True
						else:
							-- Any other layout in range: a boxed child is a pointer
							-- edge, an inline child is stored by value, and the
							-- layout graph walk below proves the by-value edges
							-- acyclic. Definition order is the emitter's concern.
							match unions.get(union_number(id)):
								Some(child):
									match child.representation:
										InlineOwningPayload | BoxedRecursive:
											owning = True
										InlineUnmanaged:
											void

									True
								None:
									False
					StringType:
						owning = True
						True
					ListType(_):
						owning = True
						True

				if invalid.is_some():
					break

				if not valid:
					invalid = Some(
						failure(
							span,
							"union payload must reference a supported layout",
						),
					)
					break
			if invalid.is_some():
				break

		match invalid:
			Some(error):
				Err(error)
			None:
				match layout.representation:
					BoxedRecursive:
						if self_referencing:
							Ok(void)
						else:
							Err(failure(span, "boxed union representation requires a self-referencing payload"))
					InlineUnmanaged:
						if owning:
							Err(failure(span, "union ownership summary does not match its payloads"))
						else:
							Ok(void)
					InlineOwningPayload:
						if owning:
							Ok(void)
						else:
							Err(failure(span, "union ownership summary does not match its payloads"))


private pure func valid_record_layout(
	layout: ConcreteRecord,
	span: Span,
) -> Result[ConcreteRecord, Diagnostic]:
	if IntOps.greater_than(layout.fields.length(), 0):
		Ok(layout)
	else:
		Err(failure(span, "record layout must contain one or more fields"))


private fixed union LayoutVisit:
	UnvisitedLayout
	VisitingLayout
	CompleteLayout


private fixed union LayoutVisitStep:
	VisitRecordLayout(Int)
	VisitUnionLayout(Int)
	VisitStoredType(TypeRef)
	FinishRecordLayout(Int)
	FinishUnionLayout(Int)


private pure func push_layout_visit(
	steps: List[LayoutVisitStep],
	depth: Int,
	step: LayoutVisitStep,
) -> List[LayoutVisitStep]:
	if IntOps.less_than(depth, steps.length()):
		steps.set(depth, step)
	else:
		steps.append(step)


private pure func list_terminal_presence(
	element: TypeRef,
	records: List[ConcreteRecord],
	unions: List[ConcreteUnion],
) -> Result[Void, Diagnostic]:
	span: Span = { source = COMPILER_SOURCE, start = 0, end = 0 }
	var terminal = element
	while True:
		match terminal:
			ListType(inner): terminal = inner
			_: break
	match terminal:
		RecordType(id):
			match records.get(record_number(id)):
				Some(_): Ok(void)
				None: Err(failure(span, "unknown record layout"))
		UnionType(id):
			match unions.get(union_number(id)):
				Some(_): Ok(void)
				None: Err(failure(span, "unknown union layout"))
		_:
			Ok(void)


-- The by-value storage graph of the layouts must be acyclic: every cycle
-- passes through a managed record, a boxed union or a List, which the walk
-- does not follow. Each layout is also walked as a root, and a record's
-- storage summary is checked once its fields are known.
private pure func verify_layout_graph(
	records: List[ConcreteRecord],
	unions: List[ConcreteUnion],
) -> Result[Void, Diagnostic]:
	span: Span = {
		source = COMPILER_SOURCE,
		start = 0,
		end = 0
	}
	-- A local traversal owns each state vector throughout every update.
	var record_visits = records.map(pure func(_): UnvisitedLayout)
	var union_visits = unions.map(pure func(_): UnvisitedLayout)
	var pending: List[LayoutVisitStep] = []
	var pending_count = 0
	var position = unions.length()

	while IntOps.greater_than(position, 0):
		position = IntOps.subtract(position, 1)
		pending = push_layout_visit(pending, pending_count, VisitUnionLayout(position))
		pending_count = IntOps.add(pending_count, 1)

	position = records.length()

	while IntOps.greater_than(position, 0):
		position = IntOps.subtract(position, 1)
		pending = push_layout_visit(pending, pending_count, VisitRecordLayout(position))
		pending_count = IntOps.add(pending_count, 1)

	var invalid: Option[Diagnostic] = None

	while IntOps.greater_than(pending_count, 0) and not invalid.is_some():
		pending_count = IntOps.subtract(pending_count, 1)

		match pending.get(pending_count):
			None:
				invalid = Some(failure(span, "invalid aggregate layout traversal state"))
			Some(step):
				match step:
					VisitStoredType(value_type):
						-- Only storage by value continues the walk: an inline record
						-- or inline union lies inside its parent. A managed record,
						-- a boxed union, a List and a String are pointer edges, and
						-- their layouts are walked as roots of their own.
						match value_type:
							RecordType(id):
								match records.get(record_number(id)):
									None:
										invalid = Some(failure(span, "unknown record layout"))
									Some(child):
										match child.representation:
											InlineRecord:
												pending = push_layout_visit(
													pending,
													pending_count,
													VisitRecordLayout(record_number(id)),
												)
												pending_count = IntOps.add(pending_count, 1)
											ManagedRecord:
												void
							UnionType(id):
								match unions.get(union_number(id)):
									None:
										invalid = Some(failure(span, "unknown union layout"))
									Some(child):
										match child.representation:
											InlineUnmanaged | InlineOwningPayload:
												pending = push_layout_visit(
													pending,
													pending_count,
													VisitUnionLayout(union_number(id)),
												)
												pending_count = IntOps.add(pending_count, 1)
											BoxedRecursive:
												void
							ListType(element):
								-- A pointer edge whose target must exist; its layout is
								-- walked as a root of its own, not from here.
								match list_terminal_presence(element, records, unions):
									Ok(_): void
									Err(error): invalid = Some(error)
							VoidType | IntType | FloatType | StringType:
								void
					VisitRecordLayout(index):
						match record_visits.get(index):
							None:
								invalid = Some(failure(span, "unknown record layout"))
							Some(CompleteLayout):
								void
							Some(VisitingLayout):
								invalid = Some(
									failure(
										span,
										"aggregate layouts form a by-value cycle",
									),
								)
							Some(UnvisitedLayout):
								match records.get(index):
									None:
										invalid = Some(failure(span, "unknown record layout"))
									Some(layout):
										record_visits = record_visits.set(index, VisitingLayout)
										pending = push_layout_visit(
											pending,
											pending_count,
											FinishRecordLayout(index),
										)
										pending_count = IntOps.add(pending_count, 1)
										var child = layout.fields.length()

										while IntOps.greater_than(child, 0):
											child = IntOps.subtract(child, 1)

											match layout.fields.get(child):
												Some(field):
													pending = push_layout_visit(
														pending,
														pending_count,
														VisitStoredType(field),
													)
													pending_count = IntOps.add(pending_count, 1)
												None:
													invalid = Some(
														failure(
															span,
															"invalid aggregate layout traversal state",
														),
													)
													break
					VisitUnionLayout(index):
						match union_visits.get(index):
							None:
								invalid = Some(failure(span, "unknown union layout"))
							Some(CompleteLayout):
								void
							Some(VisitingLayout):
								invalid = Some(
									failure(
										span,
										"aggregate layouts form a by-value cycle",
									),
								)
							Some(UnvisitedLayout):
								match unions.get(index):
									None:
										invalid = Some(failure(span, "unknown union layout"))
									Some(layout):
										union_visits = union_visits.set(index, VisitingLayout)
										pending = push_layout_visit(
											pending,
											pending_count,
											FinishUnionLayout(index),
										)
										pending_count = IntOps.add(pending_count, 1)
										var child = layout.variants.length()

										while IntOps.greater_than(child, 0):
											child = IntOps.subtract(child, 1)

											match layout.variants.get(child):
												Some(fields):
													var field_position = fields.length()
													while IntOps.greater_than(field_position, 0):
														field_position = IntOps.subtract(field_position, 1)
														match fields.get(field_position):
															Some(field):
																pending = push_layout_visit(pending, pending_count, VisitStoredType(field))
																pending_count = IntOps.add(pending_count, 1)
															None:
																invalid = Some(failure(span, "invalid aggregate layout traversal state"))
																break
												None:
													invalid = Some(
														failure(
															span,
															"invalid aggregate layout traversal state",
														),
													)
													break
					FinishUnionLayout(index):
						union_visits = union_visits.set(index, CompleteLayout)
					FinishRecordLayout(index):
						match records.get(index):
							None:
								invalid = Some(failure(span, "unknown record layout"))
							Some(layout):
								var inline = True

								for field in layout.fields:
									match field:
										IntType | FloatType:
											void
										RecordType(child):
											match records.get(record_number(child)):
												Some(child_layout):
													match child_layout.representation:
														InlineRecord:
															void
														ManagedRecord:
															inline = False
												None:
													invalid = Some(
														failure(
															span,
															"unknown record layout",
														),
													)
													break
										_:
											inline = False

								matches = match layout.representation:
									InlineRecord:
										inline
									ManagedRecord:
										not inline

								if not invalid.is_some():
									if matches:
										record_visits = record_visits.set(index, CompleteLayout)
									else:
										invalid = Some(
											failure(
												span,
												"record storage summary does not match its fields",
											),
										)

	match invalid:
		Some(error):
			Err(error)
		None:
			Ok(void)


private pure func record_layout(
	owner: RecordInstanceId,
	records: List[ConcreteRecord],
	span: Span,
) -> Result[ConcreteRecord, Diagnostic]:
	layout ?= records
		.get(record_number(owner))
		.to_result(failure(span, "unknown record layout"))
	valid_record_layout(layout, span)


private pure func record_field_type(
	field: FieldInstanceId,
	owner: RecordInstanceId,
	layout: ConcreteRecord,
	span: Span,
) -> Result[TypeRef, Diagnostic]:
	if not IntOps.equals(record_number(field_owner(field)), record_number(owner)):
		Err(failure(span, "field belongs to a different record layout"))
	else:
		layout.fields
			.get(field_number(field))
			.to_result(failure(span, "unknown record field"))


private pure func operation_type(
	definition: OwnedDefinition,
	state: VerificationFacts,
	signature: FunctionSignature,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	projection: ProjectionContext,
	records: List[ConcreteRecord],
	prefix_owners: List[OwnerState],
	owners: List[OwnerState],
) -> Result[TypeRef, Diagnostic]:
	match definition.operation:
		ConstructRecordDefinition(owner, fields):
			layout ?= record_layout(owner, records, definition.span)

			complete ?= if IntOps.equals(fields.length(), layout.fields.length()):
				Ok(void)
			else:
				Err(
					failure(
						definition.span,
						"record construction must provide every field exactly once",
					),
				)

			var seen: List[Int] = []
			var invalid: Option[Diagnostic] = None

			for field in fields:
				if seen.contains(field_number(field.field)):
					invalid = Some(failure(definition.span, "record construction repeats a field"))
					break

				result = record_field_type(
					field.field,
					owner,
					layout,
					definition.span,
				).and_then(pure func(expected: TypeRef) -> Result[Void, Diagnostic]:
					stored = match field.value:
						UnmanagedPayload(value):
							value
						OwnedPayload(value, _):
							value

					match value(state, stored, definition.span):
						Err(error):
							Err(error)
						Ok(known):
							if same_type(known.value_type, expected):
								Ok(void)
							else:
								Err(
									failure(
										definition.span,
										"record field value type does not match its layout",
									),
								)
				)

				match result:
					Err(error):
						invalid = Some(error)
						break
					Ok(_):
						seen = seen.append(field_number(field.field))

			match invalid:
				Some(error):
					Err(error)
				None:
					Ok(RecordType(owner))
		ReadRecordFieldDefinition(field, argument):
			source = match argument:
				UnmanagedArgument(value):
					value
				BorrowedArgument(borrow):
					borrow.value

			known ?= value(state, source, definition.span)

			owner ?= match known.value_type:
				RecordType(owner):
					Ok(owner)
				_:
					Err(failure(definition.span, "field projection requires a record value"))

			layout ?= record_layout(owner, records, definition.span)
			live ?= verify_arguments(
				[argument],
				[known.value_type],
				state,
				unions,
				definition.span,
				records,
				prefix_owners,
				owners,
			)
			record_field_type(field, owner, layout, definition.span)
		ParameterDefinition(index):
			if IntOps.less_than(index, state.parameters.length()):
				Err(failure(definition.span, "function parameter is defined more than once"))
			else if IntOps.not_equals(index, state.parameters.length()):
				Err(
					failure(
						definition.span,
						"function parameter position is not the next signature position",
					),
				)
			else:
				signature.parameters
					.get(index)
					.to_result(
						failure(
							definition.span,
							"parameter value in a zero-argument function",
						),
					)
		VoidDefinition:
			Ok(VoidType)
		StringDefinition(_):
			Ok(StringType)
		IntegerDefinition(_):
			Ok(IntType)
		FloatDefinition(value):
			if FloatOps.is_finite(value):
				Ok(FloatType)
			else:
				Err(failure(definition.span, "Float literal must be finite"))
		CallDefinition(call, arguments):
			contract ?= call_signature(call, functions, unions, records)
			valid ?= verify_arguments(
				arguments,
				contract.parameters,
				state,
				unions,
				definition.span,
				records,
				prefix_owners,
				owners,
			)

			if same_type(contract.return_type, definition.value_type):
				Ok(contract.return_type)
			else:
				Err(failure(definition.span, "call result type does not match its contract"))
		ConstructDefinition(id, payloads):
			var types: List[TypeRef] = []
			var error: Option[Diagnostic] = None
			for payload in payloads:
				argument = match payload:
					UnmanagedPayload(value): value
					OwnedPayload(value, _): value
				match value(state, argument, definition.span):
					Ok(known): types = types.append(known.value_type)
					Err(failure):
						error = Some(failure)
						break
			ready ?= match error:
				Some(error): Err(error)
				None: Ok(void)
			variant_type(id, types, unions, definition.span)
		ConstructListDefinition(payloads):
			-- The definition's List type is the one authority for E; every
			-- stored element must carry exactly that type.
			element ?= match definition.value_type:
				ListType(element): Ok(element)
				_: Err(failure(definition.span, "list construction result must be a List"))
			var error: Option[Diagnostic] = None
			for payload in payloads:
				argument = match payload:
					UnmanagedPayload(value): value
					OwnedPayload(value, _): value
				match value(state, argument, definition.span):
					Err(failure):
						error = Some(failure)
						break
					Ok(known):
						if not same_type(known.value_type, element):
							error = Some(failure(definition.span, "list element type does not match its List"))
							break
			match error:
				Some(error): Err(error)
				None: Ok(definition.value_type)
		PayloadDefinition(field, source):
			selected = variant_field_variant(field)
			scrutinee ?= value(state, source, definition.span)

			match projection:
				NoProjection:
					Err(
						failure(
							definition.span,
							"payload projection outside its selected match arm",
						),
					)
				PayloadProjection(expected, variant):
					fields ?= variant_shape(variant, unions, definition.span)
					payload_type ?= fields.get(variant_field_number(field)).to_result(failure(definition.span, "unknown variant field identity"))

					if (
						IntOps.equals(value_number(source), value_number(argument_value(expected)))
						and same_type(scrutinee.value_type, UnionType(variant_owner(variant)))
						and IntOps.equals(
							union_number(variant_owner(selected)),
							union_number(variant_owner(variant)),
						)
						and IntOps.equals(variant_number(selected), variant_number(variant))
					):
						live ?= verify_match_argument(
							expected,
							state,
							unions,
							records,
							definition.span,
							prefix_owners,
							owners,
						)
						Ok(payload_type)
					else:
						Err(
							failure(
								definition.span,
								"payload projection does not belong to this match arm",
							),
						)


-- Owner slots after every stored payload of one construction discharged its
-- obligation into storage; variants, list literals and records share it.
private fixed record DischargedOwners {
	prefix_owners: List[OwnerState],
	owners: List[OwnerState]
}


private pure func discharge_payloads(
	payloads: List[StoredPayload],
	state: VerificationFacts,
	prefix_owners: List[OwnerState],
	owners: List[OwnerState],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
	span: Span,
) -> Result[DischargedOwners, Diagnostic]:
	var prefix = prefix_owners
	var local = owners
	var failure_slot: Option[Diagnostic] = None
	for payload in payloads:
		match stored_payload_transfer(payload, state, prefix, local, unions, records, span):
			Err(error):
				failure_slot = Some(error)
				break
			Ok(Some(PrefixSlot(index))): prefix = prefix.set(index, DischargedOwner)
			Ok(Some(LocalSlot(index))): local = local.set(index, DischargedOwner)
			Ok(None): void
	match failure_slot:
		Some(error): Err(error)
		None: Ok({ prefix_owners = prefix, owners = local })


private pure func stored_payload_transfer(
	payload: StoredPayload,
	state: VerificationFacts,
	prefix_owners: List[OwnerState],
	owners: List[OwnerState],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
	span: Span,
) -> Result[Option[OwnerSlot], Diagnostic]:
	id = match payload:
		UnmanagedPayload(id):
			id
		OwnedPayload(id, _):
			id

	known ?= value(state, id, span)
	plan ?= value_ownership(known.value_type, unions, records)

	match payload:
		UnmanagedPayload(_):
			match plan:
				NoOwnership:
					Ok(None)
				_:
					Err(failure(span, "managed payload requires an owner transfer"))
		OwnedPayload(value, transferred):
			managed ?= match plan:
				NoOwnership:
					Err(failure(span, "unmanaged payload cannot transfer an owner"))
				_:
					Ok(void)

			entry ?= owner(prefix_owners, state.first_owner, owners, transferred, span)

			match entry:
				DischargedOwner:
					Err(failure(span, "payload owner has already been discharged"))
				ActiveOwner(owned):
					if IntOps.equals(value_number(value), value_number(owned)):
						owner_slot(
							prefix_owners.length(),
							state.first_owner,
							owners.length(),
							transferred,
							span,
						).map(
							pure func(slot): Some(slot),
						)
					else:
						Err(failure(span, "payload owner does not own the stored value"))


private pure func verify_definition_result(
	definition: OwnedDefinition,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Option[OwnerId], Diagnostic]:
	plan ?= value_ownership(definition.value_type, unions, records)

	ownership_result: Result[Option[OwnerId], Diagnostic] = match plan:
		NoOwnership:
			match definition.result:
				UnmanagedResult:
					Ok(None)
				_:
					Err(failure(definition.span, "unmanaged value carries an ownership obligation"))
		ManagedStringLeaf | ManagedListRoot | ManagedRecordRoot(_) | InlineOwnedFields(_) | ManagedUnionRoot(_):
			match definition.operation:
				ParameterDefinition(_):
					match definition.result:
						BorrowedResult(ParameterBorrow(source)):
							if IntOps.equals(value_number(source), value_number(definition.id)):
								Ok(None)
							else:
								Err(
									failure(
										definition.span,
										"managed parameter has the wrong borrow source",
									),
								)
						_:
							Err(failure(definition.span, "managed parameter must be borrowed"))
				PayloadDefinition(_, parent):
					match definition.result:
						BorrowedResult(PayloadBorrow(source)):
							if IntOps.equals(value_number(parent), value_number(source)):
								Ok(None)
							else:
								Err(
									failure(
										definition.span,
										"payload borrow has the wrong parent value",
									),
								)
						_:
							Err(
								failure(
									definition.span,
									"managed projection requires its parent borrow",
								),
							)
				ReadRecordFieldDefinition(_, argument):
					parent = match argument:
						UnmanagedArgument(value):
							value
						BorrowedArgument(borrow):
							borrow.value

					match definition.result:
						BorrowedResult(PayloadBorrow(source)):
							if IntOps.equals(value_number(parent), value_number(source)):
								Ok(None)
							else:
								Err(
									failure(
										definition.span,
										"payload borrow has the wrong parent value",
									),
								)
						_:
							Err(
								failure(
									definition.span,
									"managed projection requires its parent borrow",
								),
							)
				StringDefinition(_) | CallDefinition(_, _) | ConstructDefinition(_, _) | ConstructListDefinition(_) | ConstructRecordDefinition(_, _):
					match definition.result:
						OwnedResult(owner):
							Ok(Some(owner))
						_:
							Err(failure(definition.span, "managed result requires an owner"))
				_:
					Err(failure(definition.span, "unsupported managed value operation"))

	ownership_result


private pure func verify_match_argument(
	argument: OwnedArgument,
	state: VerificationFacts,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
	span: Span,
	prefix_owners: List[OwnerState],
	owners: List[OwnerState],
) -> Result[Void, Diagnostic]:
	match argument:
		BorrowedArgument(borrow):
			verify_borrow(borrow, state, span, prefix_owners, owners)
		UnmanagedArgument(id):
			known ?= value(state, id, span)
			plan ?= value_ownership(known.value_type, unions, records)

			match plan:
				NoOwnership:
					Ok(void)
				_:
					Err(failure(span, "managed match scrutinee requires an owner-dependent borrow"))


private pure func definition_parent(
	definition: OwnedDefinition,
	projection: ProjectionContext,
) -> Option[BorrowedValue]:
	match definition.operation:
		ReadRecordFieldDefinition(_, BorrowedArgument(parent)):
			Some(parent)
		PayloadDefinition(_, _):
			match projection:
				PayloadProjection(BorrowedArgument(parent), _):
					Some(parent)
				_:
					None
		_:
			None


private pure func verify_definition_type(
	definition: OwnedDefinition,
	state: VerificationFacts,
	signature: FunctionSignature,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	projection: ProjectionContext,
	records: List[ConcreteRecord],
	prefix_owners: List[OwnerState],
	owners: List[OwnerState],
) -> Result[Void, Diagnostic]:
	if IntOps.not_equals(
		value_number(definition.id),
		IntOps.add(state.first_value, state.values.length()),
	):
		Err(failure(definition.span, "value identity is not the next function ordinal"))
	else:
		membership ?= match definition.value_type:
			ListType(element): verify_type_membership(element, unions, records, definition.span)
			VoidType | IntType | FloatType | StringType | RecordType(_) | UnionType(_): Ok(void)
		expected ?= operation_type(
			definition,
			state,
			signature,
			functions,
			unions,
			projection,
			records,
			prefix_owners,
			owners,
		)

		if same_type(expected, definition.value_type):
			Ok(void)
		else:
			Err(failure(definition.span, "definition type does not match its operation"))


private pure func verified_drop(
	id: OwnerId,
	span: Span,
	prefix_owners: List[OwnerState],
	first_owner: Int,
	owners: List[OwnerState],
) -> Result[OwnerSlot, Diagnostic]:
	entry ?= owner(prefix_owners, first_owner, owners, id, span)

	match entry:
		DischargedOwner:
			Err(
				failure(
					span,
					"owner "
						.append_int(owner_number(id))
						.concat(" has already been discharged"),
				),
			)
		ActiveOwner(_):
			owner_slot(prefix_owners.length(), first_owner, owners.length(), id, span)


-- Owner vectors belong to this traversal, not the per-definition facts carrier.
-- Each selected arm may make one initial copy of its prefix snapshot; subsequent
-- discharges consume the uniquely held local vectors.
private pure func verify_operations(
	operations: List[OwnershipOperation],
	initial: VerificationState,
	signature: FunctionSignature,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	projection: ProjectionContext,
	records: List[ConcreteRecord],
) -> Result[VerificationState, Diagnostic]:
	var prefix_owners = initial.prefix_owners
	var owners = initial.owners
	var state = initial.facts
	var invalid: Option[Diagnostic] = None

	for operation in operations:
		checked: Result[Void, Diagnostic] = match operation:
			DefineValue(definition):
				match verify_definition_type(
					definition,
					state,
					signature,
					functions,
					unions,
					projection,
					records,
					prefix_owners,
					owners,
				):
					Err(error):
						Err(error)
					Ok(_):
						stored: Result[Void, Diagnostic] = match definition.operation:
							ConstructListDefinition(payloads):
								match discharge_payloads(payloads, state, prefix_owners, owners, unions, records, definition.span):
									Err(error): Err(error)
									Ok(discharged):
										prefix_owners = discharged.prefix_owners
										owners = discharged.owners
										Ok(void)
							ConstructDefinition(_, payloads):
								match discharge_payloads(payloads, state, prefix_owners, owners, unions, records, definition.span):
									Err(error): Err(error)
									Ok(discharged):
										prefix_owners = discharged.prefix_owners
										owners = discharged.owners
										Ok(void)
							ConstructRecordDefinition(_, fields):
								var payloads: List[StoredPayload] = []
								for field in fields:
									payloads = payloads.append(field.value)
								match discharge_payloads(payloads, state, prefix_owners, owners, unions, records, definition.span):
									Err(error): Err(error)
									Ok(discharged):
										prefix_owners = discharged.prefix_owners
										owners = discharged.owners
										Ok(void)
							_:
								Ok(void)

						match stored:
							Err(error):
								Err(error)
							Ok(_):
								match verify_definition_result(definition, unions, records):
									Err(error):
										Err(error)
									Ok(introduced):
										valid_owner: Result[Void, Diagnostic] = match introduced:
											None:
												Ok(void)
											Some(id):
												match validate_next_owner(
													state.first_owner,
													owners,
													id,
													definition.span,
												):
													Err(error):
														Err(error)
													Ok(_):
														owners = owners.append(
															ActiveOwner(definition.id),
														)
														Ok(void)

										match valid_owner:
											Err(error):
												Err(error)
											Ok(_):
												parameters = match definition.operation:
													ParameterDefinition(_):
														state.parameters.append(definition.id)
													_:
														state.parameters

												state = { state |
													values = state.values.append({
														value_type = definition.value_type,
														span = definition.span,
														result = definition.result,
														projection_parent = definition_parent(
															definition,
															projection,
														),
													}),
													parameters = parameters
												}
												Ok(void)
			AcquireOwner(id, borrow, span):
				match verify_borrow(borrow, state, span, prefix_owners, owners):
					Err(error):
						Err(error)
					Ok(_):
						match validate_next_owner(state.first_owner, owners, id, span):
							Err(error):
								Err(error)
							Ok(_):
								owners = owners.append(ActiveOwner(borrow.value))
								Ok(void)
			DropOwner(id, span):
				match verified_drop(id, span, prefix_owners, state.first_owner, owners):
					Err(error):
						Err(error)
					Ok(slot):
						match slot:
							PrefixSlot(index):
								prefix_owners = prefix_owners.set(index, DischargedOwner)
							LocalSlot(index):
								owners = owners.set(index, DischargedOwner)

						Ok(void)

		match checked:
			Ok(_):
				void
			Err(error):
				invalid = Some(error)
				break

	match invalid:
		Some(error):
			Err(error)
		None:
			Ok({
				facts = state,
				prefix_owners = prefix_owners,
				owners = owners,
			})


private pure func complete_owners(
	owners: List[OwnerState],
	first_owner: Int,
	excluded: Option[OwnerId],
	span: Span,
) -> Result[Void, Diagnostic]:
	var position = first_owner
	var failure_owner: Option[Int] = None

	for owner in owners:
		match owner:
			ActiveOwner(_):
				transferred = match excluded:
					Some(id):
						IntOps.equals(owner_number(id), position)
					None:
						False

				if not transferred:
					failure_owner = Some(position)
					break
			DischargedOwner:
				void

		position = IntOps.add(position, 1)

	match failure_owner:
		Some(id):
			Err(
				failure(
					span,
					"owner "
						.append_int(id)
						.concat(" remains live at return"),
				),
			)
		None:
			Ok(void)


private pure func verify_return(
	returned: ValueId,
	returned_owner: Option[OwnerId],
	state: VerificationState,
	return_type: TypeRef,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	result ?= value(
		state.facts,
		returned,
		{
			source = COMPILER_SOURCE,
			start = 0,
			end = 0
		},
	)

	if not same_type(result.value_type, return_type):
		Err(failure(result.span, "return type does not match its contract"))
	else:
		plan ?= value_ownership(return_type, unions, records)

		ownership_result: Result[Void, Diagnostic] = match plan:
			NoOwnership:
				match returned_owner:
					None:
						Ok(void)
					Some(_):
						Err(failure(result.span, "unmanaged return cannot transfer an owner"))
			ManagedStringLeaf | ManagedListRoot | ManagedRecordRoot(_) | InlineOwnedFields(_) | ManagedUnionRoot(_):
				match returned_owner:
					None:
						Err(failure(result.span, "managed return requires an owner transfer"))
					Some(id):
						entry ?= owner(
							state.prefix_owners,
							state.facts.first_owner,
							state.owners,
							id,
							result.span,
						)

						match entry:
							DischargedOwner:
								Err(
									failure(
										result.span,
										"return refers to discharged owner ".append_int(
											owner_number(id),
										),
									),
								)
							ActiveOwner(owned):
								if IntOps.equals(value_number(owned), value_number(returned)):
									Ok(void)
								else:
									Err(
										failure(
											result.span,
											"returned owner does not own the returned value",
										),
									)

		transferred ?= ownership_result
		prefix ?= complete_owners(state.prefix_owners, 0, returned_owner, result.span)
		complete_owners(state.owners, state.facts.first_owner, returned_owner, result.span)


private pure func verify_transfer(
	result: ReturnTransfer,
	state: VerificationState,
	return_type: TypeRef,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	match result:
		UnmanagedReturn(value):
			verify_return(value, None, state, return_type, unions, records)
		OwnedReturn(value, owner):
			verify_return(value, Some(owner), state, return_type, unions, records)


private pure func verify_exit(
	exit: OwnedExit,
	state: VerificationState,
	signature: FunctionSignature,
	execution: FunctionExecution,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	match exit:
		ReturnResult(result):
			verify_transfer(result, state, signature.return_type, unions, records)
		RecurArguments(arguments, span):
			mode ?= match execution:
				OrdinaryCalls:
					Err(failure(span, "recursive backedge outside a self-tail loop"))
				SelfTailLoop(_):
					Ok(void)

			arity ?= if IntOps.equals(arguments.length(), signature.parameters.length()):
				Ok(void)
			else:
				Err(failure(span, "recursive backedge arity does not match its function"))

			var invalid: Option[Diagnostic] = None
			var position: Int = 0

			for argument in arguments:
				parameter_position = position
				result: Result[Void, Diagnostic] = value(
					state.facts,
					argument,
					span,
				).and_then(pure func(known: KnownValue) -> Result[Void, Diagnostic]:
					match signature.parameters.get(parameter_position):
						None:
							Err(failure(span, "missing recursive backedge parameter"))
						Some(expected):
							if not same_type(known.value_type, expected):
								Err(failure(span, "recursive backedge type does not match its parameter"))
							else:
								match value_ownership(known.value_type, unions, records):
									Err(error):
										Err(error)
									Ok(plan):
										match plan:
											NoOwnership:
												Ok(void)
											ManagedStringLeaf | ManagedListRoot | ManagedRecordRoot(_) | InlineOwnedFields(_) | ManagedUnionRoot(_):
												Err(failure(span, "managed value on a recursive backedge"))
				)

				match result:
					Err(error):
						invalid = Some(error)
						break
					Ok(_):
						position = IntOps.add(position, 1)

			match invalid:
				Some(error):
					Err(error)
				None:
					complete_owners(state.owners, state.facts.first_owner, None, span)


private pure func is_backedge(exit: OwnedExit) -> Bool:
	match exit:
		ReturnResult(_):
			False
		RecurArguments(_, _):
			True


-- This preflight deliberately inspects raw definitions, including values whose
-- owners have already been dropped. The normal verifier still proves each type.
private pure func verify_loop_operations(
	operations: List[OwnershipOperation],
	current: Int,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	var invalid: Option[Diagnostic] = None

	for operation in operations:
		match operation:
			DefineValue(definition):
				match value_ownership(definition.value_type, unions, records):
					Err(error):
						invalid = Some(error)
					Ok(ManagedStringLeaf) | Ok(ManagedListRoot) | Ok(ManagedRecordRoot(_)) | Ok(InlineOwnedFields(_)) | Ok(ManagedUnionRoot(_)):
						invalid = Some(
							failure(
								definition.span,
								"managed value appears in a self-tail loop",
							),
						)
					Ok(NoOwnership):
						void

				match definition.operation:
					CallDefinition(call, _):
						match call.target:
							UserFunction(id):
								if IntOps.equals(function_number(id), current):
									invalid = Some(
										failure(
											definition.span,
											"ordinary self call remains in a self-tail loop",
										),
									)
							RuntimeFunction(_):
								void
					_:
						void
			AcquireOwner(_, _, span):
				invalid = Some(failure(span, "owner operation appears in a self-tail loop"))
			DropOwner(_, span):
				invalid = Some(failure(span, "owner operation appears in a self-tail loop"))

		match invalid:
			Some(_):
				break
			None:
				void

	match invalid:
		Some(error):
			Err(error)
		None:
			Ok(void)


private pure func verify_execution(
	function: OwnedFunction,
	current: Int,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	match function.execution:
		OrdinaryCalls:
			Ok(void)
		SelfTailLoop(annotation):
			var invalid: Option[Diagnostic] = None

			for value_type in function.signature.parameters.append(function.signature.return_type):
				match value_ownership(value_type, unions, records):
					Err(error):
						invalid = Some(error)
						break
					Ok(ManagedStringLeaf) | Ok(ManagedListRoot) | Ok(ManagedRecordRoot(_)) | Ok(InlineOwnedFields(_)) | Ok(ManagedUnionRoot(_)):
						invalid = Some(failure(annotation, "managed signature in a self-tail loop"))
						break
					Ok(NoOwnership):
						void

			valid ?= match invalid:
				Some(error):
					Err(error)
				None:
					Ok(void)

			prefix ?= verify_loop_operations(function.operations, current, unions, records)
			var found = False

			match function.tail:
				ReturnTail(exit):
					found = is_backedge(exit)
				MatchTail(matched):
					for arm in matched.arms:
						match verify_loop_operations(arm.operations, current, unions, records):
							Err(error):
								invalid = Some(error)
								break
							Ok(_):
								found = found or is_backedge(arm.exit)

			checked ?= match invalid:
				Some(error):
					Err(error)
				None:
					Ok(void)

			if found:
				Ok(void)
			else:
				Err(failure(annotation, "self-tail loop has no recursive backedge"))


-- OwnershipProgram is public raw data: its reconstructed arms do not retain
-- checking's sealed proof of coverage and usefulness. Re-establish that proof
-- here so emission can project the accepted labels without repairing them.
private pure func verify_match_arms(
	matched: OwnedMatch,
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[Void, Diagnostic]:
	nonempty ?= if IntOps.equals(matched.arms.length(), 0):
		Err(failure(span, "match has no arms"))
	else:
		Ok(void)

	declaration ?= unions
		.get(union_number(matched.owner))
		.to_result(failure(span, "unknown match union"))
	var seen: List[Bool] = []

	for _ in declaration.variants:
		seen = seen.append(False)

	var remaining = seen.length()
	var has_default = False
	var invalid: Option[Diagnostic] = None

	for arm in matched.arms:
		match arm.label:
			DefaultLabel:
				if has_default:
					invalid = Some(failure(span, "match default appears more than once"))
					break
				else if IntOps.equals(remaining, 0):
					invalid = Some(failure(span, "match default covers no remaining variants"))
					break
				else:
					has_default = True
			VariantLabel(id):
				if IntOps.not_equals(union_number(variant_owner(id)), union_number(matched.owner)):
					invalid = Some(failure(span, "match variant belongs to another union"))
					break
				else:
					ordinal = variant_number(id)

					match seen.get(ordinal):
						None:
							invalid = Some(failure(span, "unknown variant identity"))
							break
						Some(already_seen):
							if already_seen:
								invalid = Some(
									failure(
										span,
										"match variant appears more than once",
									),
								)
								break
							else if has_default:
								invalid = Some(failure(span, "match default must be the final arm"))
								break
							else:
								seen = seen.set(ordinal, True)
								remaining = IntOps.subtract(remaining, 1)

	match invalid:
		Some(error):
			Err(error)
		None:
			if not has_default and IntOps.not_equals(remaining, 0):
				Err(failure(span, "match does not cover every variant"))
			else:
				Ok(void)


private pure func verify_match(
	matched: OwnedMatch,
	execution: FunctionExecution,
	state: VerificationState,
	signature: FunctionSignature,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	scrutinee ?= value(
		state.facts,
		argument_value(matched.scrutinee),
		{
			source = COMPILER_SOURCE,
			start = 0,
			end = 0
		},
	)

	if not same_type(scrutinee.value_type, UnionType(matched.owner)):
		Err(failure(scrutinee.span, "match scrutinee does not belong to its union"))
	else:
		valid_arms ?= verify_match_arms(matched, unions, scrutinee.span)
		live ?= verify_match_argument(
			matched.scrutinee,
			state.facts,
			unions,
			records,
			scrutinee.span,
			state.prefix_owners,
			state.owners,
		)
		var next_value = IntOps.add(state.facts.first_value, state.facts.values.length())
		var next_owner = IntOps.add(state.facts.first_owner, state.owners.length())
		var invalid: Option[Diagnostic] = None

		-- Each selected arm receives an independent prefix snapshot and a disjoint
		-- local owner interval. Sibling ordinal gaps never become visible.
		for arm in matched.arms:
			branch_start: VerificationState = {
				facts = { state.facts |
					prefix_values = state.facts.values,
					first_value = next_value,
					values = [],
					first_owner = next_owner
				},
				prefix_owners = state.owners,
				owners = []
			}

			projection = match arm.label:
				DefaultLabel:
					NoProjection
				VariantLabel(id):
					PayloadProjection(matched.scrutinee, id)

			match verify_operations(
				arm.operations,
				branch_start,
				signature,
				functions,
				unions,
				projection,
				records,
			):
				Err(error):
					invalid = Some(error)
					break
				Ok(branch):
					match verify_exit(arm.exit, branch, signature, execution, unions, records):
						Ok(_):
							next_value = IntOps.add(
								branch.facts.first_value,
								branch.facts.values.length(),
							)
							next_owner = IntOps.add(
								branch.facts.first_owner,
								branch.owners.length(),
							)
						Err(error):
							invalid = Some(error)
							break

		match invalid:
			Some(error):
				Err(error)
			None:
				Ok(void)


private pure func verify_function(
	function: OwnedFunction,
	current: Int,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	execution ?= verify_execution(function, current, unions, records)
	initial: VerificationState = {
		facts = {
			prefix_values = [],
			first_value = 0,
			values = [],
			first_owner = 0,
			parameters = []
		},
		prefix_owners = [],
		owners = []
	}
	state ?= verify_operations(
		function.operations,
		initial,
		function.signature,
		functions,
		unions,
		NoProjection,
		records,
	)

	valid_parameter ?= if IntOps.equals(
		state.facts.parameters.length(),
		function.signature.parameters.length(),
	):
		Ok(void)
	else:
		Err(
			failure(
				{
					source = COMPILER_SOURCE,
					start = 0,
					end = 0
				},
				"function parameter has no value definition",
			),
		)

	match function.tail:
		ReturnTail(result):
			verify_exit(result, state, function.signature, function.execution, unions, records)
		MatchTail(matched):
			verify_match(
				matched,
				function.execution,
				state,
				function.signature,
				functions,
				unions,
				records,
			)


-- Independently check the accepted wrapper convention against its target signature.
private pure func verify_entry(
	entry: OwnedFunction,
	convention: Entrypoint[FunctionInstanceId],
) -> Result[Void, Diagnostic]:
	parameters_match = match convention:
		NoArguments(_, _):
			entry.signature.parameters.is_empty()
		WithArguments(_, _):
			match entry.signature.parameters:
				[value]:
					same_type(value, ListType(StringType))
				_:
					False

	result = match convention:
		NoArguments(_, result):
			result
		WithArguments(_, result):
			result

	result_matches = match result:
		IntegerExitStatus:
			same_type(entry.signature.return_type, IntType)
		SuccessfulExit:
			same_type(entry.signature.return_type, VoidType)

	valid = parameters_match and result_matches

	if valid:
		Ok(void)
	else:
		span: Span = match entry.operations.get(0):
			Some(operation):
				match operation:
					DefineValue(definition):
						definition.span
					AcquireOwner(_, _, occurrence):
						occurrence
					DropOwner(_, occurrence):
						occurrence
			None:
				{
					source = COMPILER_SOURCE,
					start = 0,
					end = 0
				}

		Err(
			failure(
				span,
				"entrypoint signature does not match its accepted argument and result conventions",
			),
		)


pure func verify(program: OwnershipProgram) -> Result[VerifiedProgram, Diagnostic]:
	entry ?= program.functions
		.get(function_number(entry_function(program.entrypoint)))
		.to_result(
			failure(
				{
					source = COMPILER_SOURCE,
					start = 0,
					end = 0
				},
				"entrypoint function is not defined",
			),
		)
	var invalid: Option[Diagnostic] = None

	for layout in program.records:
		match (
			valid_record_layout(
				layout,
				{
					source = COMPILER_SOURCE,
					start = 0,
					end = 0
				},
			)
		):
			Ok(_):
				void
			Err(error):
				invalid = Some(error)
				break

	var union_position = 0

	for layout in program.unions:
		if invalid.is_some():
			break

		match valid_union_layout(layout, union_position, program.records, program.unions):
			Err(error):
				invalid = Some(error)
				break
			Ok(_):
				union_position = IntOps.add(union_position, 1)

	complete_layouts ?= match invalid:
		Some(error):
			Err(error)
		None:
			verify_layout_graph(program.records, program.unions)

	var current: Int = 0

	for function in program.functions:
		for value_type in function.signature.parameters.append(function.signature.return_type):
			match verify_type_membership(value_type, program.unions, program.records, { source = COMPILER_SOURCE, start = 0, end = 0 }):
				Ok(_):
					void
				Err(error):
					invalid = Some(error)

		if invalid.is_some():
			break

		match verify_function(
			function,
			current,
			program.functions,
			program.unions,
			program.records,
		):
			Ok(_):
				current = IntOps.add(current, 1)
			Err(error):
				invalid = Some(error)
				break

	match invalid:
		Some(error):
			Err(error)
		None:
			valid_entry ?= verify_entry(entry, program.entrypoint)
			Ok(into_opaque VerifiedProgram(program))
