-- Concrete representation is an upstream fact, shared with insertion.
-- Verification independently validates the actual raw operations and layouts;
-- it does not consume insertion's decisions about owners or borrow lifetimes.
-- This seal belongs to the exact operations and contracts checked below.
opaque type VerifiedProgram = OwnershipProgram


pure func verified_contents(program: VerifiedProgram) -> OwnershipProgram:
	from_opaque VerifiedProgram(program)


private pure func verification_error(span: Span, message: String) -> Diagnostic:
	{
		span = span,
		note = None,
		message = "ownership verification failed: ${message}",
		help = "report this compiler error with the input program"
	}


-- List storage ownership is a root fact. Raw IR must also name a member of
-- each supplied concrete catalogue; do not expand nominal fields per query.
private pure func verify_type_membership(
	value_type: TypeRef, unions: List[ConcreteUnion], records: List[ConcreteRecord], span: Span,
) -> Result[Void, Diagnostic]:
	match value_type:
		ListType(element): verify_type_membership(element, unions, records, span)
		CallableType(parameters, result):
			var failure: Option[Diagnostic] = None
			for parameter in parameters.append(result):
				match verify_type_membership(parameter, unions, records, span):
					Ok(_): void
					Err(error):
						failure = Some(error)
						break
			match failure:
				Some(error): Err(error)
				None: Ok(void)
		_:
			match value_needs_ownership(value_type, unions, records):
				Ok(_): Ok(void)
				Err(error): Err({ error | span = span })


private fixed record KnownValue {
	value_type: TypeRef,
	span: Span,
	result: ResultOwnership,
	projection_parent: Option[BorrowedValue],
	projection_place: Option[ConcretePatternPlace]
}


private fixed union OwnerOrigin:
	DefinedOwner
	AcquiredOwner


private fixed union OwnerState:
	ActiveOwner(ValueId, OwnerOrigin)
	DischargedOwner


-- One block enclosing the block being verified, as of the join or tail
-- match that entered it: the function's prefix or an enclosing arm, with its
-- consecutive values and owners. It is a shared view: a nested block flags
-- the enclosing owners it discharges instead of changing it.
private fixed record EnclosingScope {
	first_value: Int,
	values: List[KnownValue],
	first_owner: Int,
	owners: List[OwnerState]
}


private fixed record VerificationFacts {
	enclosing: List[EnclosingScope],
	first_value: Int,
	values: List[KnownValue],
	first_owner: Int,
	parameters: List[ValueId]
}


-- `discharged` flags the enclosing owners discharged so far, those the block
-- was entered with included, by owner number. A nested block shares its
-- parent's flags until its first discharge copies them.
private fixed record VerificationState {
	facts: VerificationFacts,
	discharged: List[Bool],
	owners: List[OwnerState]
}


-- The nearest lexical loop owns abrupt join exits. A nested loop replaces this
-- context; an outer or sibling target never becomes a permitted destination.
private fixed record ActiveLoop {
	loop: OwnedLoop,
	pre: VerificationState,
	first_owner: Int
}


private fixed union ProjectionContext:
	NoProjection
	SelectionProjection(OwnedArgument, List[PlaceFact])


private pure func known_value(
	state: VerificationFacts,
	id: ValueId,
	span: Span,
) -> Result[KnownValue, Diagnostic]:
	error = verification_error(
		span,
		"value ${value_number(id).to_string()} is not defined before use",
	)
	ordinal = value_number(id)
	var entry: Option[KnownValue] = None

	if ordinal.greater_than_or_equal(state.first_value):
		entry = state.values.get(ordinal.subtract(state.first_value))
	else:
		for scope in state.enclosing:
			if and(
				ordinal.greater_than_or_equal(scope.first_value),
				ordinal.less_than(scope.first_value.add(scope.values.length())),
			):
				entry = scope.values.get(ordinal.subtract(scope.first_value))
				break

	entry.to_result(error)


-- An owner's slot: an enclosing owner by ordinal, or a local one by index.
private fixed union OwnerSlot:
	EnclosingSlot(Int)
	LocalSlot(Int)


-- An enclosing owner's state when its block was entered.
private pure func enclosing_owner(state: VerificationFacts, ordinal: Int) -> Option[OwnerState]:
	var found: Option[OwnerState] = None
	for scope in state.enclosing:
		if and(
			ordinal.greater_than_or_equal(scope.first_owner),
			ordinal.less_than(scope.first_owner.add(scope.owners.length())),
		):
			found = scope.owners.get(ordinal.subtract(scope.first_owner))
			break
	found


private pure func owner_slot(
	state: VerificationFacts,
	owner_count: Int,
	id: OwnerId,
	span: Span,
) -> Result[OwnerSlot, Diagnostic]:
	ordinal = owner_number(id)
	first_owner = state.first_owner

	match enclosing_owner(state, ordinal):
		Some(_):
			Ok(EnclosingSlot(ordinal))
		None:
			if and(ordinal.greater_than_or_equal(0), ordinal.less_than(first_owner)):
				Err(
					verification_error(
						span,
						"owner ${ordinal.to_string()} is not available in this match arm",
					),
				)
			else if and(
				ordinal.greater_than_or_equal(first_owner),
				ordinal.less_than(first_owner.add(owner_count), ),
			):
				Ok(LocalSlot(ordinal.subtract(first_owner)))
			else:
				Err(
					verification_error(
						span,
						"owner ${ordinal.to_string()} is not defined",
					),
				)


private pure func discharged_already(discharged: List[Bool], ordinal: Int) -> Bool:
	match discharged.get(ordinal):
		Some(flag): flag
		None: False


-- Flags enclosing owner `ordinal` discharged. Which enclosing owners a block
-- may discharge is checked where it leaves: a yield against its join's
-- entering owners, a loop edge against PRE. Selection edges admit only local
-- drops and transfers, so they never reach this.
private pure func discharge(discharged: List[Bool], ordinal: Int) -> List[Bool]:
	var flags = discharged
	while flags.length().less_than(ordinal.add(1)):
		flags = flags.append(False)
	flags.set(ordinal, True)


private pure func known_owner(
	state: VerificationFacts,
	discharged: List[Bool],
	owners: List[OwnerState],
	id: OwnerId,
	span: Span,
) -> Result[OwnerState, Diagnostic]:
	slot ?= owner_slot(state, owners.length(), id, span)

	entry: Option[OwnerState] = match slot:
		EnclosingSlot(ordinal):
			if discharged_already(discharged, ordinal):
				Some(DischargedOwner)
			else:
				enclosing_owner(state, ordinal)
		LocalSlot(index):
			owners.get(index)

	entry.to_result(
		verification_error(
			span,
			"owner ${owner_number(id).to_string()} is not defined",
		),
	)


private pure func validate_next_owner(
	first_owner: Int,
	owners: List[OwnerState],
	id: OwnerId,
	span: Span,
) -> Result[Void, Diagnostic]:
	ordinal = owner_number(id)
	next_owner = first_owner.add(owners.length())

	if ordinal.less_than(0):
		Err(verification_error(span, "negative owner identity"))
	else if ordinal.less_than(next_owner):
		Err(
			verification_error(
				span,
				"owner ${ordinal.to_string()} is defined more than once",
			),
		)
	else if ordinal.not_equals(next_owner):
		Err(verification_error(span, "owner identity is not the next function ordinal"))
	else:
		Ok(void)


private pure func argument_value(argument: OwnedArgument) -> ValueId:
	match argument:
		UnmanagedArgument(id):
			id
		ConsumedArgument(id, _):
			id
		BorrowedArgument(borrow):
			borrow.value


private pure func verify_borrow(
	borrow: BorrowedValue,
	state: VerificationFacts,
	span: Span,
	discharged: List[Bool],
	owners: List[OwnerState],
) -> Result[Void, Diagnostic]:
	borrowed ?= known_value(state, borrow.value, span)

	managed: Void ?= match borrowed.result:
		UnmanagedResult:
			Err(verification_error(span, "borrow requires a managed value"))
		_:
			Ok(void)

	match borrow.source:
		ParameterBorrow(source):
			borrows_parameter = match value_number(source).equals(value_number(borrow.value)):
				True:
					state.parameters.any(
						pure func(
							parameter: ValueId,
						) -> Bool: value_number(parameter).equals(value_number(source)),
					)
				False: False

			if borrows_parameter:
				Ok(void)
			else:
				Err(verification_error(span, "parameter borrow does not refer to the borrowed parameter"))
		OwnerBorrow(id):
			match known_owner(state, discharged, owners, id, span):
				Ok(entry):

					match entry:
						DischargedOwner:
							Err(
								verification_error(
									span,
									"borrow refers to discharged owner ".append_int(owner_number(id)),
								),
							)
						ActiveOwner(owned, _):
							if value_number(owned).equals(value_number(borrow.value)):
								Ok(void)
							else:
								Err(
									verification_error(
										span,
										"owner ${owner_number(id).to_string()} does not own value ${value_number(borrow.value).to_string()}",
									),
								)
				Err(error): Err(error)
		PayloadBorrow(parent):
			match borrowed.result:
				BorrowedResult(PayloadBorrow(expected)):
					if value_number(parent).equals(value_number(expected)):
						match borrowed.projection_parent.to_result(
							verification_error(
								span,
								"projection has no parent lifetime",
							),
						):
							Ok(ancestor):

								if value_number(ancestor.value).equals(value_number(parent)):
									verify_borrow(ancestor, state, span, discharged, owners)
								else:
									Err(verification_error(span, "payload borrow has the wrong parent value"))
							Err(error): Err(error)
					else:
						Err(verification_error(span, "payload borrow has the wrong parent value"))
				_:
					Err(verification_error(span, "payload borrow requires a borrowed projection"))


-- The signature a call's target declares, after its types are shown to exist.
private pure func call_signature(
	target: CallTarget,
	span: Span,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[FunctionSignature, Diagnostic]:
	match target:
		RuntimeFunction(operation):
			verify_runtime_signature(operation, span, unions, records)
		UserFunction(id):
			match functions.get(function_number(id)):
				Some(function): Ok(function.signature)
				None: Err(verification_error(span, "unknown called function"))


private pure func verify_runtime_signature(
	operation: RuntimeOperation[VariantInstanceId, TypeRef],
	span: Span,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[FunctionSignature, Diagnostic]:
	contract = runtime_signature(operation)
	var invalid: Option[Diagnostic] = None
	for parameter in contract.parameters:
		match verify_type_membership(parameter, unions, records, span):
			Ok(_): void
			Err(error):
				invalid = Some(error)
				break
	parameters: Void ?= match invalid:
		None: Ok(void)
		Some(error): Err(error)
	validation: Result[Void, Diagnostic] = match runtime_contract(operation).return_type:
		ValueResult(_):
			Ok(void)
		OptionalResult(payload, option):
			verify_two_variant_union(
				option.some,
				[runtime_type_ref(payload)],
				option.none,
				[],
				unions,
				span,
				"runtime Option constructors do not cover one result union",
			)
		ResultResult(success, error, constructors):
			verify_two_variant_union(
				constructors.ok,
				[runtime_type_ref(success)],
				constructors.err,
				[runtime_type_ref(error)],
				unions,
				span,
				"runtime Result constructors do not cover one result union",
			)
		BooleanResult(boolean):
			verify_two_variant_union(
				boolean.true_variant,
				[],
				boolean.false_variant,
				[],
				unions,
				span,
				"runtime Bool constructors do not cover one result union",
			)

	valid ?= validation
	result ?= verify_type_membership(contract.return_type, unions, records, span)
	Ok(contract)


-- A runtime union result: its two constructors must be distinct
-- variants of one two-variant union. This sees specialized instances, not
-- declarations, so it checks only the owner, both payloads and the two variants.
-- That the union is the designated foundation union is enforced where the
-- checker's `runtime_result_type` builds each result from the designated
-- unions. Specialization maps those variants into the result instance and
-- treats a mismatch as a compiler invariant.
private pure func verify_two_variant_union(
	first: VariantInstanceId,
	first_payload: List[TypeRef],
	second: VariantInstanceId,
	second_payload: List[TypeRef],
	unions: List[ConcreteUnion],
	span: Span,
	message: String,
) -> Result[Void, Diagnostic]:
	first_type ?= variant_type(first, first_payload, unions, span)
	second_type ?= variant_type(second, second_payload, unions, span)
	layout ?= unions
		.get(union_number(variant_owner(first)))
		.to_result(verification_error(span, "unknown runtime result union"))

	if (
		and(
			and(
				same_type(first_type, second_type),
				union_variants(layout).length().equals(2),
			),
			variant_number(first).equals(variant_number(second)).not(),
		)
	):
		Ok(void)
	else:
		Err(verification_error(span, message))


private pure func verify_argument(
	argument: OwnedArgument,
	expected: TypeRef,
	state: VerificationFacts,
	unions: List[ConcreteUnion],
	span: Span,
	records: List[ConcreteRecord],
	discharged: List[Bool],
	owners: List[OwnerState],
) -> Result[Void, Diagnostic]:
	id = match argument:
		UnmanagedArgument(id):
			id
		ConsumedArgument(id, _):
			id
		BorrowedArgument(borrow):
			borrow.value

	known ?= known_value(state, id, span)

	if same_type(known.value_type, expected).not():
		Err(verification_error(span, "call argument type does not match its contract"))
	else:
		match argument:
			ConsumedArgument(_, _): Err(verification_error(span, "consumed argument requires the first supported update operand"))
			UnmanagedArgument(_):
				match value_needs_ownership(expected, unions, records):
					Ok(needs_owner):

						match needs_owner:
							False:
								Ok(void)
							True:
								Err(
									verification_error(
										span,
										"managed call argument requires an owner-dependent borrow",
									),
								)
					Err(error): Err(error)
			BorrowedArgument(borrow):
				verify_borrow(borrow, state, span, discharged, owners)


-- Borrow validation uses the complete pre-call state; only this typed target
-- and position may subsequently transfer the obligation.
private pure func consuming_update_borrows(target: CallTarget, arguments: List[OwnedArgument]) -> List[OwnedArgument]:
	match target:
		RuntimeFunction(Builtins.StringConcat) | RuntimeFunction(Builtins.StringAppendInt) | RuntimeFunction(Builtins.ListAppend(_)) | RuntimeFunction(Builtins.ListSet(_)) | RuntimeFunction(Builtins.ListConcat(_)):
			match arguments.get(0):
				Some(ConsumedArgument(value, owner)):
					arguments.set(0, BorrowedArgument({ value = value, source = OwnerBorrow(owner) }))
				_: arguments
		_: arguments


private pure func verify_arguments(
	arguments: List[OwnedArgument],
	parameters: List[TypeRef],
	state: VerificationFacts,
	unions: List[ConcreteUnion],
	span: Span,
	records: List[ConcreteRecord],
	discharged: List[Bool],
	owners: List[OwnerState],
) -> Result[Void, Diagnostic]:
	if arguments.length().less_than(parameters.length()):
		Err(verification_error(span, "call is missing its argument"))
	else if arguments.length().greater_than(parameters.length()):
		Err(verification_error(span, "call has an unexpected argument"))
	else:
		var index: Int = 0
		var invalid: Option[Diagnostic] = None

		for argument in arguments:
			match parameters.get(index):
				None:
					invalid = Some(verification_error(span, "missing call parameter contract"))
					break
				Some(expected):
					match verify_argument(
						argument,
						expected,
						state,
						unions,
						span,
						records,
						discharged,
						owners,
					):
						Err(error):
							invalid = Some(error)
							break
						Ok(_):
							void

			index = index.add(1)

		match invalid:
			Some(error):
				Err(error)
			None:
				Ok(void)


private pure func variant_shape(id: VariantInstanceId, unions: List[ConcreteUnion], span: Span) -> Result[List[TypeRef], Diagnostic]:
	declaration ?= unions.get(union_number(variant_owner(id))).to_result(verification_error(span, "unknown variant owner"))
	union_variants(declaration).get(variant_number(id)).to_result(verification_error(span, "unknown variant identity"))


private pure func variant_type(id: VariantInstanceId, expected: List[TypeRef], unions: List[ConcreteUnion], span: Span) -> Result[TypeRef, Diagnostic]:
	shape ?= variant_shape(id, unions, span)
	if shape.length().equals(expected.length()).not():
		Err(verification_error(span, "variant field count does not match its operation"))
	else:
		var position = 0
		var valid: Bool = True
		for actual in expected:
			match shape.get(position):
				Some(field):
					valid = match valid:
						True: same_type(field, actual)
						False: False
				None: valid = False
			position = position.add(1)
		if valid:
			Ok(UnionType(variant_owner(id)))
		else:
			Err(verification_error(span, "variant payload does not match its operation"))


private pure func valid_union_layout(
	layout: ConcreteUnion,
	position: Int,
	records: List[ConcreteRecord],
	unions: List[ConcreteUnion],
) -> Result[Void, Diagnostic]:
	span: Span = {
		source = compiler_source(),
		start = 0,
		end = 0
	}

	variants = union_variants(layout)

	if variants.length().equals(0):
		Err(verification_error(span, "union layout must contain one or more variants"))
	else:
		var invalid: Option[Diagnostic] = None
		var owning: Bool = False
		var self_referencing: Bool = False

		for fields in variants:
			var self_payloads = 0

			for value_type in fields:
				valid: Bool = match value_type:
					VoidType | IntType | FloatType:
						True
					RecordType(id):
						match records.get(record_number(id)):
							Some(child):
								match child:
									CountedFields(_):
										owning = True
									InlineFields(_):
										void

								True
							None:
								False
					UnionType(id):
						if union_number(id).equals(position):
							-- The unary recursive shape: a boxed node's pointer to
							-- at most one child of its own layout.
							self_referencing = True
							self_payloads = self_payloads.add(1)

							match layout:
								BoxedCases(_):
									if self_payloads.greater_than(1):
										invalid = Some(verification_error(span, "boxed union variant may store at most one self-reference"))
								PlainCases(_) | OwningCases(_):
									invalid = Some(verification_error(span, "recursive union payload requires the boxed representation"))

							True
						else:
							-- Any other layout in range: a boxed child is a pointer
							-- edge, an inline child is stored by value, and the
							-- layout graph walk below proves the by-value edges
							-- acyclic. Definition order is the emitter's concern.
							match unions.get(union_number(id)):
								Some(child):
									match child:
										OwningCases(_) | BoxedCases(_):
											owning = True
										PlainCases(_):
											void

									True
								None:
									False
					StringType:
						owning = True
						True
					ListType(_) | CallableType(_, _):
						owning = True
						True

				if invalid.is_some():
					break

				if valid.not():
					invalid = Some(
						verification_error(
							span,
							"union payload must reference a supported layout",
						),
					)
					break
			if invalid.is_some():
				break

		match invalid:
			Some(error):
				Err(error)
			None:
				match layout:
					BoxedCases(_):
						if self_referencing:
							Ok(void)
						else:
							Err(verification_error(span, "boxed union representation requires a self-referencing payload"))
					PlainCases(_):
						if owning:
							Err(verification_error(span, "union ownership summary does not match its payloads"))
						else:
							Ok(void)
					OwningCases(_):
						if owning:
							Ok(void)
						else:
							Err(verification_error(span, "union ownership summary does not match its payloads"))


private pure func valid_record_layout(
	layout: ConcreteRecord,
	span: Span,
) -> Result[ConcreteRecord, Diagnostic]:
	if record_fields(layout).length().greater_than(0):
		Ok(layout)
	else:
		Err(verification_error(span, "record layout must contain one or more fields"))


private fixed union LayoutVisit:
	UnvisitedLayout
	VisitingLayout
	CompleteLayout


private fixed union LayoutVisitStep:
	VisitRecordLayout(Int)
	VisitUnionLayout(Int)
	VisitStoredType(TypeRef)
	FinishRecordLayout(Int)
	FinishUnionLayout(Int)


private pure func push_layout_visit(
	steps: List[LayoutVisitStep],
	depth: Int,
	step: LayoutVisitStep,
) -> List[LayoutVisitStep]:
	if depth.less_than(steps.length()):
		steps.set(depth, step)
	else:
		steps.append(step)


private pure func list_terminal_presence(
	element: TypeRef,
	records: List[ConcreteRecord],
	unions: List[ConcreteUnion],
) -> Result[Void, Diagnostic]:
	span: Span = { source = compiler_source(), start = 0, end = 0 }
	var terminal = element
	while True:
		match terminal:
			ListType(inner): terminal = inner
			_: break
	match terminal:
		CallableType(_, _): verify_type_membership(terminal, unions, records, span)
		RecordType(id):
			match records.get(record_number(id)):
				Some(_): Ok(void)
				None: Err(verification_error(span, "unknown record layout"))
		UnionType(id):
			match unions.get(union_number(id)):
				Some(_): Ok(void)
				None: Err(verification_error(span, "unknown union layout"))
		_:
			Ok(void)


-- The by-value storage graph of the layouts must be acyclic: every cycle
-- passes through a managed record, a boxed union or a List, which the walk
-- does not follow. Each layout is also walked as a root, and a record's
-- storage summary is checked once its fields are known.
private pure func verify_layout_graph(
	records: List[ConcreteRecord],
	unions: List[ConcreteUnion],
) -> Result[Void, Diagnostic]:
	span: Span = {
		source = compiler_source(),
		start = 0,
		end = 0
	}
	-- A local traversal owns each state vector throughout every update.
	var record_visits = records.map(pure func(_) -> LayoutVisit: UnvisitedLayout)
	var union_visits = unions.map(pure func(_) -> LayoutVisit: UnvisitedLayout)
	var pending: List[LayoutVisitStep] = []
	var pending_count = 0
	var position = unions.length()

	while position.greater_than(0):
		position = position.subtract(1)
		pending = push_layout_visit(pending, pending_count, VisitUnionLayout(position))
		pending_count = pending_count.add(1)

	position = records.length()

	while position.greater_than(0):
		position = position.subtract(1)
		pending = push_layout_visit(pending, pending_count, VisitRecordLayout(position))
		pending_count = pending_count.add(1)

	var invalid: Option[Diagnostic] = None

	while and(pending_count.greater_than(0), invalid.is_some().not()):
		pending_count = pending_count.subtract(1)

		match pending.get(pending_count):
			None:
				invalid = Some(verification_error(span, "invalid aggregate layout traversal state"))
			Some(step):
				match step:
					VisitStoredType(value_type):
						-- Only storage by value continues the walk: an inline record
						-- or inline union lies inside its parent. A managed record,
						-- a boxed union, a List and a String are pointer edges, and
						-- their layouts are walked as roots of their own.
						match value_type:
							RecordType(id):
								match records.get(record_number(id)):
									None:
										invalid = Some(verification_error(span, "unknown record layout"))
									Some(child):
										match child:
											InlineFields(_):
												pending = push_layout_visit(
													pending,
													pending_count,
													VisitRecordLayout(record_number(id)),
												)
												pending_count = pending_count.add(1)
											CountedFields(_):
												void
							UnionType(id):
								match unions.get(union_number(id)):
									None:
										invalid = Some(verification_error(span, "unknown union layout"))
									Some(child):
										match child:
											PlainCases(_) | OwningCases(_):
												pending = push_layout_visit(
													pending,
													pending_count,
													VisitUnionLayout(union_number(id)),
												)
												pending_count = pending_count.add(1)
											BoxedCases(_):
												void
							ListType(element):
								-- A pointer edge whose target must exist; its layout is
								-- walked as a root of its own, not from here.
								match list_terminal_presence(element, records, unions):
									Ok(_): void
									Err(error): invalid = Some(error)
							CallableType(_, _):
								-- A callable stores an ops/environment pair, not its signature children.
								match verify_type_membership(value_type, unions, records, span):
									Ok(_): void
									Err(error): invalid = Some(error)
							VoidType | IntType | FloatType | StringType:
								void
					VisitRecordLayout(index):
						match record_visits.get(index):
							None:
								invalid = Some(verification_error(span, "unknown record layout"))
							Some(CompleteLayout):
								void
							Some(VisitingLayout):
								invalid = Some(
									verification_error(
										span,
										"aggregate layouts form a by-value cycle",
									),
								)
							Some(UnvisitedLayout):
								match records.get(index):
									None:
										invalid = Some(verification_error(span, "unknown record layout"))
									Some(layout):
										record_visits = record_visits.set(index, VisitingLayout)
										pending = push_layout_visit(
											pending,
											pending_count,
											FinishRecordLayout(index),
										)
										pending_count = pending_count.add(1)
										fields = record_fields(layout)
										var child = fields.length()

										while child.greater_than(0):
											child = child.subtract(1)

											match fields.get(child):
												Some(field):
													pending = push_layout_visit(
														pending,
														pending_count,
														VisitStoredType(field),
													)
													pending_count = pending_count.add(1)
												None:
													invalid = Some(
														verification_error(
															span,
															"invalid aggregate layout traversal state",
														),
													)
													break
					VisitUnionLayout(index):
						match union_visits.get(index):
							None:
								invalid = Some(verification_error(span, "unknown union layout"))
							Some(CompleteLayout):
								void
							Some(VisitingLayout):
								invalid = Some(
									verification_error(
										span,
										"aggregate layouts form a by-value cycle",
									),
								)
							Some(UnvisitedLayout):
								match unions.get(index):
									None:
										invalid = Some(verification_error(span, "unknown union layout"))
									Some(layout):
										union_visits = union_visits.set(index, VisitingLayout)
										pending = push_layout_visit(
											pending,
											pending_count,
											FinishUnionLayout(index),
										)
										pending_count = pending_count.add(1)
										variants = union_variants(layout)
										var child = variants.length()

										while child.greater_than(0):
											child = child.subtract(1)

											match variants.get(child):
												Some(fields):
													var field_position = fields.length()
													while field_position.greater_than(0):
														field_position = field_position.subtract(1)
														match fields.get(field_position):
															Some(field):
																pending = push_layout_visit(pending, pending_count, VisitStoredType(field))
																pending_count = pending_count.add(1)
															None:
																invalid = Some(verification_error(span, "invalid aggregate layout traversal state"))
																break
												None:
													invalid = Some(
														verification_error(
															span,
															"invalid aggregate layout traversal state",
														),
													)
													break
					FinishUnionLayout(index):
						union_visits = union_visits.set(index, CompleteLayout)
					FinishRecordLayout(index):
						match records.get(index):
							None:
								invalid = Some(verification_error(span, "unknown record layout"))
							Some(layout):
								var inline: Bool = True

								for field in record_fields(layout):
									match field:
										IntType | FloatType:
											void
										RecordType(child):
											match records.get(record_number(child)):
												Some(child_layout):
													match child_layout:
														InlineFields(_):
															void
														CountedFields(_):
															inline = False
												None:
													invalid = Some(
														verification_error(
															span,
															"unknown record layout",
														),
													)
													break
										_:
											inline = False

								matches = match layout:
									InlineFields(_):
										inline
									CountedFields(_):
										-- Counted storage also permits inline fields; Spec owns
										-- the storage choice. Only inline storage constrains fields.
										True

								if invalid.is_some().not():
									if matches:
										record_visits = record_visits.set(index, CompleteLayout)
									else:
										invalid = Some(
											verification_error(
												span,
												"record storage summary does not match its fields",
											),
										)

	match invalid:
		Some(error):
			Err(error)
		None:
			Ok(void)


private pure func record_layout(
	owner: RecordInstanceId,
	records: List[ConcreteRecord],
	span: Span,
) -> Result[ConcreteRecord, Diagnostic]:
	layout ?= records
		.get(record_number(owner))
		.to_result(verification_error(span, "unknown record layout"))
	valid_record_layout(layout, span)


private pure func record_field_type(
	field: FieldInstanceId,
	owner: RecordInstanceId,
	layout: ConcreteRecord,
	span: Span,
) -> Result[TypeRef, Diagnostic]:
	if record_number(field_owner(field)).equals(record_number(owner)).not():
		Err(verification_error(span, "field belongs to a different record layout"))
	else:
		record_fields(layout)
			.get(field_number(field))
			.to_result(verification_error(span, "unknown record field"))


private pure func definition_value(
	definition: OwnedDefinition, expected: TypeRef,
	projection_parent: Option[BorrowedValue],
	projection_place: Option[ConcretePatternPlace],
) -> Result[KnownValue, Diagnostic]:
	if same_type(expected, definition.value_type):
		Ok({
			value_type = definition.value_type,
			span = definition.span,
			result = definition.result,
			projection_parent = projection_parent,
			projection_place = projection_place
		})
	else:
		Err(verification_error(definition.span, "definition type does not match its operation"))


private pure func operation_value(
	definition: OwnedDefinition,
	state: VerificationFacts,
	signature: FunctionSignature,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	projection: ProjectionContext,
	records: List[ConcreteRecord],
	discharged: List[Bool],
	owners: List[OwnerState],
) -> Result[KnownValue, Diagnostic]:
	match definition.operation:
		ConstructRecordDefinition(owner, fields):
			match record_layout(owner, records, definition.span):
				Ok(layout):

					if fields.length().equals(record_fields(layout).length()):
						var seen: List[Int] = []
						var invalid: Option[Diagnostic] = None

						for field in fields:
							if seen.contains(field_number(field.field)):
								invalid = Some(verification_error(definition.span, "record construction repeats a field"))
								break

							result = record_field_type(
								field.field,
								owner,
								layout,
								definition.span,
							).and_then(pure func(expected: TypeRef) -> Result[Void, Diagnostic]:
								stored = match field.value:
									UnmanagedPayload(value):
										value
									OwnedPayload(value, _):
										value

								match known_value(state, stored, definition.span):
									Err(error):
										Err(error)
									Ok(known):
										if same_type(known.value_type, expected):
											Ok(void)
										else:
											Err(
												verification_error(
													definition.span,
													"record field value type does not match its layout",
												),
											)
							)

							match result:
								Err(error):
									invalid = Some(error)
									break
								Ok(_):
									seen = seen.append(field_number(field.field))

						match invalid:
							Some(error):
								Err(error)
							None:
								definition_value(definition, RecordType(owner), None, None)
					else:
						Err(
							verification_error(
								definition.span,
								"record construction must provide every field exactly once",
							),
						)
				Err(error): Err(error)
		ReadRecordFieldDefinition(field, argument):
			record_projection_value(field, argument, definition, state, unions, records, projection, discharged, owners)
		ParameterDefinition(index):
			if index.less_than(state.parameters.length()):
				Err(verification_error(definition.span, "function parameter is defined more than once"))
			else if index.not_equals(state.parameters.length()):
				Err(
					verification_error(
						definition.span,
						"function parameter position is not the next signature position",
					),
				)
			else:
				match signature.parameters.get(index).to_result(
					verification_error(definition.span, "parameter value in a zero-argument function"),
				):
					Err(error): Err(error)
					Ok(expected): definition_value(definition, expected, None, None)
		VoidDefinition:
			definition_value(definition, VoidType, None, None)
		StringDefinition(_):
			definition_value(definition, StringType, None, None)
		IntegerDefinition(_):
			definition_value(definition, IntType, None, None)
		FloatDefinition(value):
			if value.is_finite():
				definition_value(definition, FloatType, None, None)
			else:
				Err(verification_error(definition.span, "Float literal must be finite"))
		FreeCallableDefinition(id):
			match functions.get(function_number(id)).to_result(verification_error(definition.span, "unknown callable body")):
				Err(error): Err(error)
				Ok(function):
					definition_value(definition, CallableType(function.signature.parameters, function.signature.return_type), None, None)
		CapturedCallableDefinition(id, payload):
			stored = match payload:
				UnmanagedPayload(value): value
				OwnedPayload(value, _): value
			match known_value(state, stored, definition.span):
				Err(error): Err(error)
				Ok(environment):
					match functions.get(function_number(id)).to_result(verification_error(definition.span, "unknown callable body")):
						Err(error): Err(error)
						Ok(function):
							match environment.value_type:
								RecordType(owner):
									match function.signature.parameters:
										[]: Err(verification_error(definition.span, "captured callable requires an environment parameter"))
										[parameter, ...parameters]:
											match record_layout(owner, records, definition.span):
												Err(error): Err(error)
												Ok(layout):
													match layout:
														InlineFields(_): Err(verification_error(definition.span, "callable environment must be a managed record"))
														CountedFields(_):
															if same_type(parameter, environment.value_type):
																definition_value(definition, CallableType(parameters, function.signature.return_type), None, None)
															else:
																Err(verification_error(definition.span, "callable body environment type does not match its stored environment"))
								_: Err(verification_error(definition.span, "captured callable requires an environment parameter"))
		InvokeCallableDefinition(callee, arguments):
			match known_value(state, argument_value(callee), definition.span):
				Err(error): Err(error)
				Ok(known):
					match verify_argument(callee, known.value_type, state, unions, definition.span, records, discharged, owners):
						Err(error): Err(error)
						Ok(live):
							match known.value_type:
								CallableType(parameters, result):
									match verify_arguments(arguments, parameters, state, unions, definition.span, records, discharged, owners):
										Err(error): Err(error)
										Ok(valid):
											definition_value(definition, result, None, None)
								_: Err(verification_error(definition.span, "indirect call requires a callable value"))
		CallDefinition(target, arguments):
			borrows = consuming_update_borrows(target, arguments)
			match call_signature(target, definition.span, functions, unions, records):
				Ok(contract):
					match verify_arguments(
						borrows,
						contract.parameters,
						state,
						unions,
						definition.span,
						records,
						discharged,
						owners,
					):
						Ok(valid):

							if same_type(contract.return_type, definition.value_type):
								definition_value(definition, contract.return_type, None, None)
							else:
								Err(verification_error(definition.span, "call result type does not match its contract"))
						Err(error): Err(error)
				Err(error): Err(error)
		ConstructDefinition(id, payloads):
			var types: List[TypeRef] = []
			var found_error: Option[Diagnostic] = None
			for payload in payloads:
				argument = match payload:
					UnmanagedPayload(value): value
					OwnedPayload(value, _): value
				match known_value(state, argument, definition.span):
					Ok(known): types = types.append(known.value_type)
					Err(failure):
						found_error = Some(failure)
						break
			match found_error:
				Some(error): Err(error)
				None:
					match variant_type(id, types, unions, definition.span):
						Err(error): Err(error)
						Ok(expected): definition_value(definition, expected, None, None)
		ConstructListDefinition(payloads):
			-- The definition's List type is the one authority for E; every
			-- stored element must carry exactly that type.
			match definition.value_type:
				ListType(element):
					var found_error: Option[Diagnostic] = None
					for payload in payloads:
						argument = match payload:
							UnmanagedPayload(value): value
							OwnedPayload(value, _): value
						match known_value(state, argument, definition.span):
							Err(failure):
								found_error = Some(failure)
								break
							Ok(known):
								if same_type(known.value_type, element).not():
									found_error = Some(verification_error(definition.span, "list element type does not match its List"))
									break
					match found_error:
						Some(error): Err(error)
						None: definition_value(definition, definition.value_type, None, None)
				_: Err(verification_error(definition.span, "list construction result must be a List"))

		PayloadDefinition(field, source):
			payload_projection_value(field, source, state, projection, unions, records, definition, discharged, owners)
		ListElementDefinition(index, source):
			element_projection_value(index, source, state, projection, unions, records, definition, discharged, owners)
		ListSuffixDefinition(argument, skip):
			match suffix_projection_type(argument, skip, state, projection, unions, records, definition.span, discharged, owners):
				Err(error): Err(error)
				Ok(expected): definition_value(definition, expected, None, None)


-- Owner slots after every stored payload of one construction discharged its
-- obligation into storage; variants, list literals and records share it.
private fixed record DischargedOwners {
	discharged: List[Bool],
	owners: List[OwnerState]
}


private pure func discharge_payloads(
	payloads: List[StoredPayload],
	state: VerificationFacts,
	discharged: List[Bool],
	owners: List[OwnerState],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
	span: Span,
) -> Result[DischargedOwners, Diagnostic]:
	var enclosing = discharged
	var local = owners
	var failure_slot: Option[Diagnostic] = None
	for payload in payloads:
		match stored_payload_transfer(payload, state, enclosing, local, unions, records, span):
			Err(error):
				failure_slot = Some(error)
				break
			Ok(Some(EnclosingSlot(ordinal))): enclosing = discharge(enclosing, ordinal)
			Ok(Some(LocalSlot(index))): local = local.set(index, DischargedOwner)
			Ok(None): void
	match failure_slot:
		Some(error): Err(error)
		None: Ok({ discharged = enclosing, owners = local })


-- Revalidate every remaining operand after discharging, so projection ancestry
-- and direct same-owner borrows cannot survive a consuming call. Distinct counted
-- owners remain valid even when they reference the same runtime allocation.
private pure func discharge_update_argument(
	arguments: List[OwnedArgument], state: VerificationFacts,
	discharged: List[Bool], owners: List[OwnerState],
	unions: List[ConcreteUnion], records: List[ConcreteRecord], span: Span,
) -> Result[DischargedOwners, Diagnostic]:
	match arguments.get(0):
		Some(ConsumedArgument(value, owner)):
			match discharge_payloads([OwnedPayload(value, owner)], state, discharged, owners, unions, records, span):
				Err(error): Err(error)
				Ok(moved):
					var failure: Option[Diagnostic] = None
					var index = 0
					for argument in arguments:
						if index.greater_than(0):
							checked: Result[Void, Diagnostic] = match argument:
								BorrowedArgument(borrow): verify_borrow(borrow, state, span, moved.discharged, moved.owners)
								UnmanagedArgument(_): Ok(void)
								ConsumedArgument(_, _): Err(verification_error(span, "consumed argument requires the first supported update operand"))
							match checked:
								Err(error):
									failure = Some(error)
									break
								Ok(_): void
						index = index.add(1)
					match failure:
						Some(error): Err(error)
						None: Ok(moved)
		_: Ok({ discharged = discharged, owners = owners })


private pure func stored_payload_transfer(
	payload: StoredPayload,
	state: VerificationFacts,
	discharged: List[Bool],
	owners: List[OwnerState],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
	span: Span,
) -> Result[Option[OwnerSlot], Diagnostic]:
	id = match payload:
		UnmanagedPayload(id):
			id
		OwnedPayload(id, _):
			id

	known ?= known_value(state, id, span)
	needs_owner ?= value_needs_ownership(known.value_type, unions, records)

	match payload:
		UnmanagedPayload(_):
			match needs_owner:
				False:
					Ok(None)
				True:
					Err(verification_error(span, "managed payload requires an owner transfer"))
		OwnedPayload(value, transferred):
			match needs_owner:
				False:
					Err(verification_error(span, "unmanaged payload cannot transfer an owner"))
				True:
					match known_owner(state, discharged, owners, transferred, span):
						Ok(entry):

							match entry:
								DischargedOwner:
									Err(verification_error(span, "payload owner has already been discharged"))
								ActiveOwner(owned, _):
									if value_number(value).equals(value_number(owned)):
										owner_slot(
											state,
											owners.length(),
											transferred,
											span,
										).map(
											pure func(slot): Some(slot),
										)
									else:
										Err(verification_error(span, "payload owner does not own the stored value"))
						Err(error): Err(error)


private pure func verify_definition_result(
	definition: OwnedDefinition,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Option[OwnerId], Diagnostic]:
	needs_owner ?= value_needs_ownership(definition.value_type, unions, records)

	ownership_result: Result[Option[OwnerId], Diagnostic] = match needs_owner:
		False:
			match definition.result:
				UnmanagedResult:
					Ok(None)
				_:
					Err(verification_error(definition.span, "unmanaged value carries an ownership obligation"))
		True:
			match definition.operation:
				ParameterDefinition(_):
					match definition.result:
						BorrowedResult(ParameterBorrow(source)):
							if value_number(source).equals(value_number(definition.id)):
								Ok(None)
							else:
								Err(
									verification_error(
										definition.span,
										"managed parameter has the wrong borrow source",
									),
								)
						_:
							Err(verification_error(definition.span, "managed parameter must be borrowed"))
				PayloadDefinition(_, parent):
					match definition.result:
						BorrowedResult(PayloadBorrow(source)):
							if value_number(parent).equals(value_number(source)):
								Ok(None)
							else:
								Err(
									verification_error(
										definition.span,
										"payload borrow has the wrong parent value",
									),
								)
						_:
							Err(
								verification_error(
									definition.span,
									"managed projection requires its parent borrow",
								),
							)
				ListElementDefinition(_, parent):
					match definition.result:
						BorrowedResult(PayloadBorrow(source)):
							if value_number(parent).equals(value_number(source)):
								Ok(None)
							else:
								Err(
									verification_error(
										definition.span,
										"payload borrow has the wrong parent value",
									),
								)
						_:
							Err(
								verification_error(
									definition.span,
									"managed projection requires its parent borrow",
								),
							)
				ReadRecordFieldDefinition(_, argument):
					parent = match argument:
						UnmanagedArgument(value):
							value
						ConsumedArgument(value, _):
							value
						BorrowedArgument(borrow):
							borrow.value

					match definition.result:
						BorrowedResult(PayloadBorrow(source)):
							if value_number(parent).equals(value_number(source)):
								Ok(None)
							else:
								Err(
									verification_error(
										definition.span,
										"payload borrow has the wrong parent value",
									),
								)
						_:
							Err(
								verification_error(
									definition.span,
									"managed projection requires its parent borrow",
								),
							)
				StringDefinition(_) | CallDefinition(_, _) | InvokeCallableDefinition(_, _) | FreeCallableDefinition(_) | CapturedCallableDefinition(_, _) | ConstructDefinition(_, _) | ConstructListDefinition(_) | ConstructRecordDefinition(_, _) | ListSuffixDefinition(_, _):
					match definition.result:
						OwnedResult(owner):
							Ok(Some(owner))
						_:
							Err(verification_error(definition.span, "managed result requires an owner"))
				_:
					Err(verification_error(definition.span, "unsupported managed value operation"))

	ownership_result


private pure func verify_match_argument(
	argument: OwnedArgument,
	state: VerificationFacts,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
	span: Span,
	discharged: List[Bool],
	owners: List[OwnerState],
) -> Result[Void, Diagnostic]:
	match argument:
		ConsumedArgument(_, _): Err(verification_error(span, "match or projection cannot consume a call argument"))
		BorrowedArgument(borrow):
			verify_borrow(borrow, state, span, discharged, owners)
		UnmanagedArgument(id):
			match known_value(state, id, span):
				Ok(known):
					match value_needs_ownership(known.value_type, unions, records):
						Ok(needs_owner):

							match needs_owner:
								False:
									Ok(void)
								True:
									Err(verification_error(span, "managed match scrutinee requires an owner-dependent borrow"))
						Err(error): Err(error)
				Err(error): Err(error)


private pure func projection_includes(possible: List[Bool], ordinal: Int) -> Bool:
	match possible.get(ordinal):
		Some(included): included
		None: False


private pure func value_argument(value: ValueId, known: KnownValue) -> OwnedArgument:
	match known.result:
		UnmanagedResult: UnmanagedArgument(value)
		BorrowedResult(source): BorrowedArgument({ value = value, source = source })
		OwnedResult(owner): BorrowedArgument({ value = value, source = OwnerBorrow(owner) })


private pure func value_place(value: ValueId, state: VerificationFacts, projection: ProjectionContext, span: Span) -> Result[ConcretePatternPlace, Diagnostic]:
	known ?= known_value(state, value, span)
	match projection:
		NoProjection: Err(verification_error(span, "payload projection outside its selected match arm"))
		SelectionProjection(root, _):
			if value_number(value).equals(value_number(argument_value(root))):
				Ok({ value_type = known.value_type, route = MatchRoot })
			else:
				known.projection_place.to_result(verification_error(span, "selection projection parent is not one of its verified places"))


-- The selected root's explicit borrow may differ from its definition result.
-- Descendants instead depend on their already verified immediate parent.
private fixed record ProjectionParent {
	place: ConcretePatternPlace,
	borrow: Option[BorrowedValue]
}


private pure func verified_projection_parent(
	value: ValueId, state: VerificationFacts, projection: ProjectionContext,
	unions: List[ConcreteUnion], records: List[ConcreteRecord], span: Span,
	discharged: List[Bool], owners: List[OwnerState],
) -> Result[ProjectionParent, Diagnostic]:
	place ?= value_place(value, state, projection, span)
	known ?= known_value(state, value, span)
	parent_argument: OwnedArgument ?= match projection:
		NoProjection: Err(verification_error(span, "payload projection outside its selected match arm"))
		SelectionProjection(root, _):
			argument = if value_number(value).equals(value_number(argument_value(root))):
				root
			else:
				value_argument(value, known)
			match verify_match_argument(argument, state, unions, records, span, discharged, owners):
				Err(error): Err(error)
				Ok(_): Ok(argument)
	match projection:
		NoProjection: Err(verification_error(span, "payload projection outside its selected match arm"))
		SelectionProjection(root, facts):
			match known_value(state, argument_value(root), span):
				Err(error): Err(error)
				Ok(root_value):
					match verify_match_argument(root, state, unions, records, span, discharged, owners):
						Err(error): Err(error)
						Ok(_):
							match verify_pattern_place(place, root_value.value_type, facts, unions, span, records):
								Err(error): Err(error)
								Ok(_):
									borrow: Option[BorrowedValue] = match parent_argument:
										BorrowedArgument(parent): Some(parent)
										UnmanagedArgument(_) | ConsumedArgument(_, _): None
									Ok({ place = place, borrow = borrow })


-- Ordinary record reads and selected product fields use the same layout and
-- borrow checks. Selection reads additionally publish their verified path.
private pure func record_projection_value(
	field: FieldInstanceId, argument: OwnedArgument, definition: OwnedDefinition,
	state: VerificationFacts, unions: List[ConcreteUnion], records: List[ConcreteRecord],
	projection: ProjectionContext, discharged: List[Bool], owners: List[OwnerState],
) -> Result[KnownValue, Diagnostic]:
	source = argument_value(argument)
	known ?= known_value(state, source, definition.span)
	owner_result: Result[RecordInstanceId, Diagnostic] = match known.value_type:
		RecordType(id): Ok(id)
		_: Err(verification_error(definition.span, "field projection requires a record value"))
	owner ?= owner_result
	layout ?= record_layout(owner, records, definition.span)
	live ?= verify_arguments([argument], [known.value_type], state, unions, definition.span, records, discharged, owners)
	expected ?= record_field_type(field, owner, layout, definition.span)
	match projection:
		NoProjection:
			parent: Option[BorrowedValue] = match argument:
				BorrowedArgument(borrow): Some(borrow)
				UnmanagedArgument(_) | ConsumedArgument(_, _): None
			definition_value(definition, expected, parent, None)
		SelectionProjection(_, _):
			match verified_projection_parent(source, state, projection, unions, records, definition.span, discharged, owners):
				Err(error): Err(error)
				Ok(parent): definition_value(definition, expected, parent.borrow, Some({ value_type = expected, route = RecordField(parent.place, field) }))


private pure func payload_projection_value(
	field: VariantFieldInstanceId, source: ValueId, state: VerificationFacts,
	projection: ProjectionContext, unions: List[ConcreteUnion], records: List[ConcreteRecord],
	definition: OwnedDefinition, discharged: List[Bool], owners: List[OwnerState],
) -> Result[KnownValue, Diagnostic]:
	span = definition.span
	parent ?= verified_projection_parent(source, state, projection, unions, records, span, discharged, owners)
	selected = variant_field_variant(field)
	fields ?= variant_shape(selected, unions, span)
	payload_type ?= fields.get(variant_field_number(field)).to_result(verification_error(span, "unknown variant field identity"))
	nominal: Void ?= if same_type(parent.place.value_type, UnionType(variant_owner(selected))):
		Ok(void)
	else:
		Err(verification_error(span, "payload projection does not belong to this match arm"))
	match projection:
		NoProjection: Err(verification_error(span, "payload projection outside its selected match arm"))
		SelectionProjection(_, facts):
			match variant_possibilities(parent.place, facts, unions, span):
				Err(error): Err(error)
				Ok(possible):
					if projection_includes(possible, variant_number(selected)):
						if singleton_variant(possible, variant_number(selected)):
							definition_value(
								definition, payload_type, parent.borrow,
								Some({ value_type = definition.value_type, route = UnionField(parent.place, field) }),
							)
						else:
							Err(verification_error(span, "payload projection outside its selected match arm"))
					else:
						Err(verification_error(span, "payload projection does not belong to this match arm"))


private pure func element_projection_value(
	index: Int, source: ValueId, state: VerificationFacts, projection: ProjectionContext,
	unions: List[ConcreteUnion], records: List[ConcreteRecord], definition: OwnedDefinition,
	discharged: List[Bool], owners: List[OwnerState],
) -> Result[KnownValue, Diagnostic]:
	span = definition.span
	parent ?= verified_projection_parent(source, state, projection, unions, records, span, discharged, owners)
	element ?= list_element_type(parent.place.value_type, span)
	match projection:
		NoProjection: Err(verification_error(span, "list element outside its selected match arm"))
		SelectionProjection(_, facts):
			match verify_element_bound(parent.place, index, facts, span):
				Err(error): Err(error)
				Ok(_):
					definition_value(
						definition, element, parent.borrow,
						Some({ value_type = definition.value_type, route = ListElement(parent.place, index) }),
					)


private pure func suffix_projection_type(
	argument: OwnedArgument, skip: Int, state: VerificationFacts, projection: ProjectionContext,
	unions: List[ConcreteUnion], records: List[ConcreteRecord], span: Span,
	discharged: List[Bool], owners: List[OwnerState],
) -> Result[TypeRef, Diagnostic]:
	live ?= verify_match_argument(argument, state, unions, records, span, discharged, owners)
	parent ?= verified_projection_parent(argument_value(argument), state, projection, unions, records, span, discharged, owners)
	element ?= list_element_type(parent.place.value_type, span)
	nonnegative: Void ?= if skip.less_than(0):
		Err(verification_error(span, "list suffix skip must be nonnegative"))
	else:
		Ok(void)
	match projection:
		NoProjection: Err(verification_error(span, "list suffix outside its selected match arm"))
		SelectionProjection(_, facts):
			if length_bounds(parent.place, facts).minimum.greater_than_or_equal(skip):
				Ok(ListType(element))
			else:
				Err(verification_error(span, "list suffix lacks its required length guard"))


private pure func verify_definition_type(
	definition: OwnedDefinition,
	state: VerificationFacts,
	signature: FunctionSignature,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	projection: ProjectionContext,
	records: List[ConcreteRecord],
	discharged: List[Bool],
	owners: List[OwnerState],
) -> Result[KnownValue, Diagnostic]:
	ordinal: Void ?= if value_number(definition.id).not_equals(
		state.first_value.add(state.values.length()),
	):
		Err(verification_error(definition.span, "value identity is not the next function ordinal"))
	else:
		Ok(void)
	membership: Void ?= match definition.value_type:
		ListType(_) | CallableType(_, _): verify_type_membership(definition.value_type, unions, records, definition.span)
		VoidType | IntType | FloatType | StringType | RecordType(_) | UnionType(_): Ok(void)
	operation_value(
		definition,
		state,
		signature,
		functions,
		unions,
		projection,
		records,
		discharged,
		owners,
	)


private pure func verified_drop(
	id: OwnerId,
	span: Span,
	state: VerificationFacts,
	discharged: List[Bool],
	owners: List[OwnerState],
) -> Result[OwnerSlot, Diagnostic]:
	entry ?= known_owner(state, discharged, owners, id, span)

	match entry:
		DischargedOwner:
			Err(
				verification_error(
					span,
					"owner ${owner_number(id).to_string()} has already been discharged",
				),
			)
		ActiveOwner(_, _):
			owner_slot(state, owners.length(), id, span)


-- A header initial whose owner is not one of the loop's entry acquisitions
-- takes that existing obligation. Membership, not origin, decides: a
-- projection's owner is itself an acquisition made before the loop.
private pure func takes_existing_owner(loop: OwnedLoop, owner: OwnerId) -> Bool:
	loop.entry_acquisitions.all(pure func(acquisition): owner_number(acquisition.owner).not_equals(owner_number(owner)))


-- Each taken header owner must own its initial, as an owner borrow would, and
-- is then discharged by a drop at the loop step, checked as any other drop.
-- The loop and its continuation both start from that one post-transfer state,
-- so a later drop or a body read of a taken owner uses a discharged owner.
private pure func transfer_loop_entry(
	loop: OwnedLoop, state: VerificationState, signature: FunctionSignature, functions: List[OwnedFunction],
	unions: List[ConcreteUnion], projection: ProjectionContext, records: List[ConcreteRecord],
) -> Result[VerificationState, Diagnostic]:
	var drops: List[OwnershipOperation] = []
	var failure: Option[Diagnostic] = None
	for header in loop.headers:
		match header.initial:
			UnmanagedReturn(_): void
			OwnedReturn(value, owner):
				if takes_existing_owner(loop, owner):
					span = join_parameter(header.parameter).span
					match verify_borrow({ value = value, source = OwnerBorrow(owner) }, state.facts, span, state.discharged, state.owners):
						Err(error): failure = Some(error)
						Ok(_): drops = drops.append(DropOwner(owner, span))
		if failure.is_some():
			break
	match failure:
		Some(error): Err(error)
		None: verify_operations(drops, state, signature, functions, unions, projection, records).map(pure func(transferred): transferred.state)


-- Each entering owner is discharged at the join step, checked as a drop
-- there. The arms start from the state before it and the continuation from
-- the state after, so a later drop or read of an entering owner is rejected.
private pure func transfer_join_entry(
	join: OwnedJoin, state: VerificationState, signature: FunctionSignature, functions: List[OwnedFunction],
	unions: List[ConcreteUnion], projection: ProjectionContext, records: List[ConcreteRecord],
) -> Result[VerificationState, Diagnostic]:
	span = join_parameter(join.result).span
	drops = join.entering.map(pure func(owner: OwnerId) -> OwnershipOperation: DropOwner(owner, span))
	verify_operations(drops, state, signature, functions, unions, projection, records).map(pure func(entered): entered.state)


-- A join whose arms are verified after its block, as they are numbered:
-- each arm starts from `start`, the block's state just before the join.
private fixed record PendingJoin {
	join: OwnedJoin,
	start: VerificationState
}


private fixed union PendingControl:
	VerifyJoin(PendingJoin)
	VerifyLoop(OwnedLoop, VerificationState)


private fixed record VerifiedBlock {
	state: VerificationState,
	pending: List[PendingControl]
}


private pure func verify_join_header(
	join: OwnedJoin,
	state: VerificationFacts,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
	discharged: List[Bool],
	owners: List[OwnerState],
) -> Result[Void, Diagnostic]:
	parameter = join_parameter(join.result)
	var yielding: Bool = False
	for arm in join.arms:
		match arm.exit:
			Yield(_): yielding = True
			TransferLoop(_, _): void
	continuation: Void ?= if yielding:
		Ok(void)
	else:
		Err(verification_error(parameter.span, "join has no yielding arm"))
	ordinal: Void ?= if value_number(parameter.id).equals(state.first_value.add(state.values.length())):
		Ok(void)
	else:
		Err(verification_error(parameter.span, "value identity is not the next function ordinal"))
	membership: Void ?= match parameter.value_type:
		ListType(_) | CallableType(_, _): verify_type_membership(parameter.value_type, unions, records, parameter.span)
		_: Ok(void)
	verify_match_argument(join.selection.scrutinee, state, unions, records, parameter.span, discharged, owners)


private pure func introduce_join_parameter(
	output: OwnedJoinParameter,
	initial: VerificationState,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[VerificationState, Diagnostic]:
	parameter = join_parameter(output)
	state = initial.facts

	needs_owner ?= value_needs_ownership(parameter.value_type, unions, records)
	var owners = initial.owners
	classification: Result[Void, Diagnostic] = match needs_owner:
		False:
			match output:
				UnmanagedJoinParameter(_): Ok(void)
				_: Err(verification_error(parameter.span, "unmanaged value carries an ownership obligation"))
		True:
			match output:
				UnmanagedJoinParameter(_): Err(verification_error(parameter.span, "managed result requires an owner"))
				ManagedJoinParameter(_, owner):
					match validate_next_owner(state.first_owner, owners, owner, parameter.span):
						Ok(_):
							owners = owners.append(ActiveOwner(parameter.id, DefinedOwner))
							Ok(void)
						Err(error): Err(error)
	classified ?= classification
	Ok({ initial |
		facts = { state | values = state.values.append({
			value_type = parameter.value_type,
			span = parameter.span,
			result = join_ownership(output),
			projection_parent = None,
			projection_place = None,
		}) },
		owners = owners,
	})


private pure func introduce_carried_parameter(
	output: OwnedJoinParameter,
	start: VerificationState,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[VerificationState, Diagnostic]:
	parameter = join_parameter(output)
	ordinal: Void ?= if value_number(parameter.id).equals(start.facts.first_value.add(start.facts.values.length())):
		Ok(void)
	else:
		Err(verification_error(parameter.span, "value identity is not the next function ordinal"))
	membership ?= verify_type_membership(parameter.value_type, unions, records, parameter.span)
	introduce_join_parameter(output, start, unions, records)


private pure func introduce_outputs(
	outputs: List[OwnedJoinParameter],
	start: VerificationState,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[VerificationState, Diagnostic]:
	var state = start
	var invalid: Option[Diagnostic] = None
	for output in outputs:
		match introduce_carried_parameter(output, state, unions, records):
			Ok(introduced): state = introduced
			Err(error):
				invalid = Some(error)
				break
	match invalid:
		Some(error): Err(error)
		None: Ok(state)


-- Owner vectors belong to this traversal, not the per-definition facts carrier.
-- Enclosing owners are shared views: a block records the ones it discharges,
-- and its local owner vector stays uniquely held.
private pure func verify_operations(
	operations: List[OwnershipOperation],
	initial: VerificationState,
	signature: FunctionSignature,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	projection: ProjectionContext,
	records: List[ConcreteRecord],
) -> Result[VerifiedBlock, Diagnostic]:
	var discharged = initial.discharged
	var owners = initial.owners
	var state = initial.facts
	var pending: List[PendingControl] = []
	var invalid: Option[Diagnostic] = None

	for operation in operations:
		checked: Result[Void, Diagnostic] = match operation:
			DefineValue(definition):

				match verify_definition_type(
					definition,
					state,
					signature,
					functions,
					unions,
					projection,
					records,
					discharged,
					owners,
				):
					Err(error):
						Err(error)
					Ok(candidate):
						stored: Result[Void, Diagnostic] = match definition.operation:
							CallDefinition(_, arguments):
								match discharge_update_argument(arguments, state, discharged, owners, unions, records, definition.span):
									Err(error): Err(error)
									Ok(moved):
										discharged = moved.discharged
										owners = moved.owners
										Ok(void)
							ConstructListDefinition(payloads):
								match discharge_payloads(payloads, state, discharged, owners, unions, records, definition.span):
									Err(error): Err(error)
									Ok(moved):
										discharged = moved.discharged
										owners = moved.owners
										Ok(void)
							ConstructDefinition(_, payloads):
								match discharge_payloads(payloads, state, discharged, owners, unions, records, definition.span):
									Err(error): Err(error)
									Ok(moved):
										discharged = moved.discharged
										owners = moved.owners
										Ok(void)
							CapturedCallableDefinition(_, payload):
								match discharge_payloads([payload], state, discharged, owners, unions, records, definition.span):
									Err(error): Err(error)
									Ok(moved):
										discharged = moved.discharged
										owners = moved.owners
										Ok(void)
							ConstructRecordDefinition(_, fields):
								var payloads: List[StoredPayload] = []
								for field in fields:
									payloads = payloads.append(field.value)
								match discharge_payloads(payloads, state, discharged, owners, unions, records, definition.span):
									Err(error): Err(error)
									Ok(moved):
										discharged = moved.discharged
										owners = moved.owners
										Ok(void)
							_:
								Ok(void)

						match stored:
							Err(error):
								Err(error)
							Ok(_):
								match verify_definition_result(definition, unions, records):
									Err(error):
										Err(error)
									Ok(introduced):
										valid_owner: Result[Void, Diagnostic] = match introduced:
											None:
												Ok(void)
											Some(id):
												match validate_next_owner(
													state.first_owner,
													owners,
													id,
													definition.span,
												):
													Err(error):
														Err(error)
													Ok(_):
														owners = owners.append(
															ActiveOwner(definition.id, DefinedOwner),
														)
														Ok(void)

										match valid_owner:
											Err(error):
												Err(error)
											Ok(_):
												parameters = match definition.operation:
													ParameterDefinition(_):
														state.parameters.append(definition.id)
													_:
														state.parameters

												state = { state |
													values = state.values.append(candidate),
													parameters = parameters
												}
												Ok(void)
			ExecuteJoin(join):
				start: VerificationState = { facts = state, discharged = discharged, owners = owners }
				match verify_join_header(join, state, unions, records, discharged, owners):
					Err(error): Err(error)
					Ok(_):
						match transfer_join_entry(join, start, signature, functions, unions, projection, records):
							Err(error): Err(error)
							Ok(entered):
								match introduce_outputs([join.result].concat(join.carried), entered, unions, records):
									Err(error): Err(error)
									Ok(introduced):
										pending = pending.append(VerifyJoin({ join = join, start = start }))
										state = introduced.facts
										discharged = introduced.discharged
										owners = introduced.owners
										Ok(void)

			ExecuteLoop(loop):
				match transfer_loop_entry(loop, { facts = state, discharged = discharged, owners = owners }, signature, functions, unions, projection, records):
					Err(error): Err(error)
					Ok(start):
						match introduce_outputs([loop.result].concat(loop.carried), start, unions, records):
							Err(error): Err(error)
							Ok(introduced):
								pending = pending.append(VerifyLoop(loop, start))
								state = introduced.facts
								discharged = introduced.discharged
								owners = introduced.owners
								Ok(void)

			AcquireOwner(id, borrow, span):
				match verify_borrow(borrow, state, span, discharged, owners):
					Err(error):
						Err(error)
					Ok(_):
						match validate_next_owner(state.first_owner, owners, id, span):
							Err(error):
								Err(error)
							Ok(_):
								owners = owners.append(ActiveOwner(borrow.value, AcquiredOwner))
								Ok(void)
			DropOwner(id, span):
				match verified_drop(id, span, state, discharged, owners):
					Err(error):
						Err(error)
					Ok(EnclosingSlot(ordinal)):
						discharged = discharge(discharged, ordinal)
						Ok(void)
					Ok(LocalSlot(index)):
						owners = owners.set(index, DischargedOwner)
						Ok(void)

		match checked:
			Ok(_):
				void
			Err(error):
				invalid = Some(error)
				break

	match invalid:
		Some(error):
			Err(error)
		None:
			Ok({
				state = {
					facts = state,
					discharged = discharged,
					owners = owners,
				},
				pending = pending,
			})


-- The edge a block leaves by, which names an owner it leaves live.
private fixed union ExitEdge:
	ReturnEdge
	YieldEdge


private pure func complete_owners(
	owners: List[OwnerState],
	first_owner: Int,
	excluded: Option[OwnerId],
	edge: ExitEdge,
	span: Span,
) -> Result[Void, Diagnostic]:
	var position = first_owner
	var failure_owner: Option[Int] = None

	for owner in owners:
		match owner:
			ActiveOwner(_, _):
				transferred = match excluded:
					Some(id):
						owner_number(id).equals(position)
					None:
						False

				if transferred.not():
					failure_owner = Some(position)
					break
			DischargedOwner:
				void

		position = position.add(1)

	match failure_owner:
		Some(id):
			owner_prefix: String = "owner ".append_int(id)
			edge_description: String = match edge:
				ReturnEdge: " remains live at return"
				YieldEdge: " remains live at yield"
			Err(verification_error(span, owner_prefix.concat(edge_description)))
		None:
			Ok(void)


-- Every enclosing owner, function prefix and enclosing arms alike, is
-- discharged when the function returns from a nested block.
private pure func complete_enclosing(
	state: VerificationState,
	excluded: Option[OwnerId],
	span: Span,
) -> Result[Void, Diagnostic]:
	var failure_owner: Option[Int] = None
	for scope in state.facts.enclosing:
		var ordinal = scope.first_owner
		for entry in scope.owners:
			match entry:
				ActiveOwner(_, _):
					transferred = match excluded:
						Some(id): owner_number(id).equals(ordinal)
						None: False
					if and(and(failure_owner.is_none(), transferred.not()), discharged_already(state.discharged, ordinal).not()):
						failure_owner = Some(ordinal)
				DischargedOwner:
					void
			ordinal = ordinal.add(1)
	match failure_owner:
		Some(id):
			Err(verification_error(span, "owner ${id.to_string()} remains live at return"))
		None:
			Ok(void)


private pure func verify_return(
	returned: ValueId,
	returned_owner: Option[OwnerId],
	state: VerificationState,
	return_type: TypeRef,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	result ?= known_value(
		state.facts,
		returned,
		{
			source = compiler_source(),
			start = 0,
			end = 0
		},
	)

	if same_type(result.value_type, return_type).not():
		Err(verification_error(result.span, "return type does not match its contract"))
	else:
		match value_needs_ownership(return_type, unions, records):
			Ok(needs_owner):

				ownership_result: Result[Void, Diagnostic] = match needs_owner:
					False:
						match returned_owner:
							None:
								Ok(void)
							Some(_):
								Err(verification_error(result.span, "unmanaged return cannot transfer an owner"))
					True:
						match returned_owner:
							None:
								Err(verification_error(result.span, "managed return requires an owner transfer"))
							Some(id):
								match known_owner(
									state.facts,
									state.discharged,
									state.owners,
									id,
									result.span,
								):
									Ok(entry):

										match entry:
											DischargedOwner:
												Err(
													verification_error(
														result.span,
														"return refers to discharged owner ".append_int(
															owner_number(id),
														),
													),
												)
											ActiveOwner(owned, _):
												if value_number(owned).equals(value_number(returned)):
													Ok(void)
												else:
													Err(
														verification_error(
															result.span,
															"returned owner does not own the returned value",
														),
													)
									Err(error): Err(error)

				match ownership_result:
					Ok(transferred):
						match complete_enclosing(state, returned_owner, result.span):
							Ok(prefix): complete_owners(state.owners, state.facts.first_owner, returned_owner, ReturnEdge, result.span)
							Err(error): Err(error)
					Err(error): Err(error)
			Err(error): Err(error)


private pure func verify_transfer(
	result: ReturnTransfer,
	state: VerificationState,
	return_type: TypeRef,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	match result:
		UnmanagedReturn(value):
			verify_return(value, None, state, return_type, unions, records)
		OwnedReturn(value, owner):
			verify_return(value, Some(owner), state, return_type, unions, records)


-- A nested block's starting state: the enclosing block's state `start`
-- becomes one more enclosing scope, shared rather than copied, and its own
-- values and owners begin at the given ordinals. Sibling ordinal gaps never
-- become visible.
private pure func enter(
	start: VerificationState,
	first_value: Int,
	first_owner: Int,
) -> VerificationState:
	facts = start.facts
	{
		facts = { facts |
			enclosing = facts.enclosing.append({
				first_value = facts.first_value,
				values = facts.values,
				first_owner = facts.first_owner,
				owners = start.owners
			}),
			first_value = first_value,
			values = [],
			first_owner = first_owner
		},
		discharged = start.discharged,
		owners = []
	}


-- The ordinals after a block and the joins nested in it.
private fixed record BlockEnd {
	next_value: Int,
	next_owner: Int
}


private pure func block_end(state: VerificationState) -> BlockEnd:
	{
		next_value = state.facts.first_value.add(state.facts.values.length()),
		next_owner = state.facts.first_owner.add(state.owners.length())
	}


-- A yield moves the joined value into the join's own definition. It may
-- move only an owner made in its arm, and must have discharged the arm's
-- other owners. Its enclosing discharges are checked against the join's
-- entering owners, so all edges into the join agree.
private pure func consume_yield(
	transfer: ReturnTransfer,
	state: VerificationState,
	join_type: TypeRef,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
	span: Span,
) -> Result[VerificationState, Diagnostic]:
	yielded = match transfer:
		UnmanagedReturn(value): value
		OwnedReturn(value, _): value
	moved: Option[OwnerId] = match transfer:
		UnmanagedReturn(_): None
		OwnedReturn(_, owner): Some(owner)
	known ?= known_value(state.facts, yielded, span)
	matching: Void ?= if same_type(known.value_type, join_type):
		Ok(void)
	else:
		Err(verification_error(span, "yield type does not match its join"))
	needs_owner ?= value_needs_ownership(join_type, unions, records)
	transferred: Result[Option[Int], Diagnostic] = match needs_owner:
		False:
			match moved:
				None: Ok(None)
				Some(_): Err(verification_error(span, "unmanaged yield cannot transfer an owner"))
		True:
			match moved:
				None:
					Err(verification_error(span, "managed yield requires an owner transfer"))
				Some(id):
					match owner_slot(state.facts, state.owners.length(), id, span):
						Ok(slot):
							match slot:
								EnclosingSlot(_):
									Err(verification_error(span, "yield must transfer an owner made in its arm, not owner ".append_int(owner_number(id))))
								LocalSlot(position):
									match known_owner(state.facts, state.discharged, state.owners, id, span):
										Ok(entry):
											match entry:
												ActiveOwner(owned, _):
													if value_number(owned).equals(value_number(yielded)):
														Ok(Some(position))
													else:
														Err(verification_error(span, "yielded owner does not own the yielded value"))
												DischargedOwner:
													Err(verification_error(span, "yield refers to discharged owner ".append_int(owner_number(id))))
										Err(error): Err(error)
						Err(error): Err(error)
	consumed ?= transferred
	match consumed:
		None: Ok(state)
		Some(position): Ok({ state | owners = state.owners.set(position, DischargedOwner) })


private pure func verify_yield(
	transfer: ReturnTransfer,
	state: VerificationState,
	join_type: TypeRef,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
	span: Span,
) -> Result[Void, Diagnostic]:
	consumed ?= consume_yield(transfer, state, join_type, unions, records, span)
	complete_owners(consumed.owners, state.facts.first_owner, None, YieldEdge, span)


-- A yielding arm discharges exactly its join's entering owners, so every edge
-- into the continuation agrees on which enclosing owners remain live. `entry`
-- holds the flags the arm was entered with.
private pure func verify_entering_discharges(entering: List[OwnerId], entry: List[Bool], state: VerificationState, span: Span) -> Result[Void, Diagnostic]:
	var failure: Option[Diagnostic] = None
	for scope in state.facts.enclosing:
		var ordinal = scope.first_owner
		for owner in scope.owners:
			current = ordinal
			newly = discharged_already(state.discharged, current).and(discharged_already(entry, current).not())
			enters = entering.any(pure func(id): owner_number(id).equals(current))
			match owner:
				ActiveOwner(_, _):
					if failure.is_none():
						if and(enters, newly.not()):
							failure = Some(verification_error(span, "join arm leaves entering owner ${current.to_string()} live"))
						else if and(newly, enters.not()):
							failure = Some(verification_error(span, "join arm discharges owner ${current.to_string()}, which does not enter its join"))
				DischargedOwner: void
			ordinal = ordinal.add(1)
	match failure:
		Some(error): Err(error)
		None: Ok(void)


private pure func verify_join_transfers(
	outputs: OwnedJoinOutputs,
	join: OwnedJoin,
	entry: List[Bool],
	state: VerificationState,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	result = join_parameter(join.result)
	arity: Void ?= if outputs.carried.length().equals(join.carried.length()):
		Ok(void)
	else:
		Err(verification_error(result.span, "join arm carries the wrong number of values"))
	yielded: Void ?= if join.carried.is_empty():
		verify_yield(outputs.transfer, state, result.value_type, unions, records, result.span)
	else:
		match consume_yield(outputs.transfer, state, result.value_type, unions, records, result.span):
			Err(error): Err(error)
			Ok(first):
				var current = first
				var position = 0
				var invalid: Option[Diagnostic] = None
				for output in join.carried:
					parameter = join_parameter(output)
					match outputs.carried.get(position):
						None: invalid = Some(verification_error(result.span, "join arm carries the wrong number of values"))
						Some(transfer):
							match consume_yield(transfer, current, parameter.value_type, unions, records, parameter.span):
								Ok(consumed): current = consumed
								Err(error): invalid = Some(error)
					if invalid.is_some():
						break
					position = position.add(1)
				match invalid:
					Some(error): Err(error)
					None: complete_owners(current.owners, state.facts.first_owner, None, YieldEdge, result.span)
	verify_entering_discharges(join.entering, entry, state, result.span)


-- Canonical arm identity is independent of the variant route used to enter it.
private fixed record SelectionTarget {
	id: MatchArmId,
	inputs: List[OwnedJoinParameter]
}


private pure func selection_target(
	id: MatchArmId,
	targets: List[SelectionTarget],
	span: Span,
) -> Result[SelectionTarget, Diagnostic]:
	var found: Option[SelectionTarget] = None
	for target in targets:
		if match_arm_number(id).equals(match_arm_number(target.id)):
			found = Some(target)
			break
	found.to_result(verification_error(span, "selection enters an unknown arm"))


private pure func merge_possible(existing: List[Bool], incoming: List[Bool]) -> List[Bool]:
	if existing.is_empty():
		incoming
	else:
		var merged = existing
		var position = 0
		for possible in incoming:
			if possible:
				merged = merged.set(position, True)
			position = position.add(1)
		merged


private pure func has_possible(possible: List[Bool]) -> Bool:
	var found: Bool = False
	for included in possible:
		if included:
			found = True
			break
	found


private fixed record LengthBounds {
	minimum: Int,
	maximum: Option[Int],
	excluded: List[Int]
}


private fixed union PlaceConstraint:
	VariantPossibilities(List[Bool])
	ListLengths(LengthBounds)


private fixed record PlaceFact {
	place: ConcretePatternPlace,
	constraint: PlaceConstraint
}


private pure func same_variant(left: VariantInstanceId, right: VariantInstanceId) -> Bool:
	if union_number(variant_owner(left)).equals(union_number(variant_owner(right))):
		variant_number(left).equals(variant_number(right))
	else:
		False


private pure func same_place(left: ConcretePatternPlace, right: ConcretePatternPlace) -> Bool:
	if same_type(left.value_type, right.value_type):
		match left.route:
			MatchRoot:
				match right.route:
					MatchRoot: True
					_: False
			UnionField(parent, field):
				match right.route:
					UnionField(other_parent, other_field):
						if same_variant(variant_field_variant(field), variant_field_variant(other_field)):
							if variant_field_number(field).equals(variant_field_number(other_field)):
								same_place(parent, other_parent)
							else:
								False
						else:
							False
					_: False
			RecordField(parent, field):
				match right.route:
					RecordField(other_parent, other_field):
						if record_number(field_owner(field)).equals(record_number(field_owner(other_field))):
							if field_number(field).equals(field_number(other_field)):
								same_place(parent, other_parent)
							else:
								False
						else:
							False
					_: False
			ListElement(parent, index):
				match right.route:
					ListElement(other_parent, other_index):
						if index.equals(other_index):
							same_place(parent, other_parent)
						else:
							False
					_: False
	else:
		False


private pure func place_constraint(place: ConcretePatternPlace, facts: List[PlaceFact]) -> Option[PlaceConstraint]:
	var found: Option[PlaceConstraint] = None
	for fact in facts:
		if same_place(place, fact.place):
			found = Some(fact.constraint)
			break
	found


private pure func put_constraint(place: ConcretePatternPlace, constraint: PlaceConstraint, facts: List[PlaceFact]) -> List[PlaceFact]:
	var found: Option[Int] = None
	var position = 0
	for fact in facts:
		if same_place(place, fact.place):
			found = Some(position)
			break
		position = position.add(1)
	match found:
		Some(index): facts.set(index, { place = place, constraint = constraint })
		None: facts.append({ place = place, constraint = constraint })


private pure func variant_possibilities(place: ConcretePatternPlace, facts: List[PlaceFact], unions: List[ConcreteUnion], span: Span) -> Result[List[Bool], Diagnostic]:
	match place_constraint(place, facts):
		Some(VariantPossibilities(possible)): Ok(possible)
		_:
			match place.value_type:
				UnionType(owner):
					match unions.get(union_number(owner)):
						None: Err(verification_error(span, "unknown match union"))
						Some(layout):
							var possible: List[Bool] = []
							for _ in union_variants(layout):
								possible = possible.append(True)
							Ok(possible)
				_: Err(verification_error(span, "variant test requires a union place"))


private pure func length_bounds(place: ConcretePatternPlace, facts: List[PlaceFact]) -> LengthBounds:
	match place_constraint(place, facts):
		Some(ListLengths(bounds)): bounds
		_: { minimum = 0, maximum = None, excluded = [] }


private pure func singleton_variant(possible: List[Bool], ordinal: Int) -> Bool:
	var count = 0
	for included in possible:
		if included:
			count = count.add(1)
	if count.equals(1):
		projection_includes(possible, ordinal)
	else:
		False


-- Every ancestor is checked before the next borrowed field or element can be
-- evaluated. Equal ordinals in another nominal union prove nothing.
private pure func verify_pattern_place(place: ConcretePatternPlace, root_type: TypeRef, facts: List[PlaceFact], unions: List[ConcreteUnion], span: Span, records: List[ConcreteRecord]) -> Result[Void, Diagnostic]:
	match place.route:
		MatchRoot:
			if same_type(place.value_type, root_type):
				Ok(void)
			else:
				Err(verification_error(span, "pattern root type does not match its scrutinee"))
		UnionField(parent, field): verify_field_place(place, parent, field, root_type, facts, unions, span, records)
		RecordField(parent, field): verify_record_place(place, parent, field, root_type, facts, unions, span, records)
		ListElement(parent, index): verify_element_place(place, parent, index, root_type, facts, unions, span, records)


private pure func verify_record_place(
	place: ConcretePatternPlace, parent: ConcretePatternPlace, field: FieldInstanceId,
	root_type: TypeRef, facts: List[PlaceFact], unions: List[ConcreteUnion], span: Span,
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	ancestor ?= verify_pattern_place(parent, root_type, facts, unions, span, records)
	owner_result: Result[RecordInstanceId, Diagnostic] = match parent.value_type:
		RecordType(id): Ok(id)
		_: Err(verification_error(span, "pattern record projection requires a record parent"))
	owner ?= owner_result
	layout ?= record_layout(owner, records, span)
	expected ?= record_field_type(field, owner, layout, span)
	if same_type(expected, place.value_type):
		Ok(void)
	else:
		Err(verification_error(span, "pattern record field type does not match its layout"))


private pure func verify_field_place(place: ConcretePatternPlace, parent: ConcretePatternPlace, field: VariantFieldInstanceId, root_type: TypeRef, facts: List[PlaceFact], unions: List[ConcreteUnion], span: Span, records: List[ConcreteRecord]) -> Result[Void, Diagnostic]:
	ancestor ?= verify_pattern_place(parent, root_type, facts, unions, span, records)
	selected = variant_field_variant(field)
	nominal: Void ?= if same_type(parent.value_type, UnionType(variant_owner(selected))):
		Ok(void)
	else:
		Err(verification_error(span, "pattern field belongs to another union"))
	fields ?= variant_shape(selected, unions, span)
	expected ?= fields.get(variant_field_number(field)).to_result(verification_error(span, "unknown variant field identity"))
	typed: Void ?= if same_type(expected, place.value_type):
		Ok(void)
	else:
		Err(verification_error(span, "pattern field type does not match its layout"))
	possible ?= variant_possibilities(parent, facts, unions, span)
	if singleton_variant(possible, variant_number(selected)):
		Ok(void)
	else:
		Err(verification_error(span, "pattern field lacks its selected variant guard"))


private pure func verify_element_place(place: ConcretePatternPlace, parent: ConcretePatternPlace, index: Int, root_type: TypeRef, facts: List[PlaceFact], unions: List[ConcreteUnion], span: Span, records: List[ConcreteRecord]) -> Result[Void, Diagnostic]:
	ancestor ?= verify_pattern_place(parent, root_type, facts, unions, span, records)
	element ?= list_element_type(parent.value_type, span)
	typed: Void ?= if same_type(element, place.value_type):
		Ok(void)
	else:
		Err(verification_error(span, "pattern element type does not match its List"))
	verify_element_bound(parent, index, facts, span)


private pure func list_element_type(value_type: TypeRef, span: Span) -> Result[TypeRef, Diagnostic]:
	match value_type:
		ListType(element): Ok(element)
		_: Err(verification_error(span, "list pattern operation requires a List place"))


private pure func verify_element_bound(parent: ConcretePatternPlace, index: Int, facts: List[PlaceFact], span: Span) -> Result[Void, Diagnostic]:
	if index.less_than(0):
		Err(verification_error(span, "list element index must be nonnegative"))
	else if length_bounds(parent, facts).minimum.greater_than(index):
		Ok(void)
	else:
		Err(verification_error(span, "list element lacks its required length guard"))


private pure func merge_bounds(left: LengthBounds, right: LengthBounds) -> LengthBounds:
	minimum = if left.minimum.less_than(right.minimum):
		left.minimum
	else:
		right.minimum
	maximum: Option[Int] = match left.maximum:
		None: None
		Some(first):
			match right.maximum:
				None: None
				Some(second):
					if first.greater_than(second):
						Some(first)
					else:
						Some(second)
	var excluded: List[Int] = []
	for length in left.excluded:
		if right.excluded.contains(length):
			excluded = excluded.append(length)
	{ minimum = minimum, maximum = maximum, excluded = excluded }


private pure func merge_guards(left: List[PlaceFact], right: List[PlaceFact]) -> List[PlaceFact]:
	var merged: List[PlaceFact] = []
	for fact in left:
		match place_constraint(fact.place, right):
			Some(VariantPossibilities(other)):
				match fact.constraint:
					VariantPossibilities(possible): merged = merged.append({ fact | constraint = VariantPossibilities(merge_possible(possible, other)) })
					_: void
			Some(ListLengths(other)):
				match fact.constraint:
					ListLengths(bounds): merged = merged.append({ fact | constraint = ListLengths(merge_bounds(bounds, other)) })
					_: void
			None: void
	merged


private pure func normalize_bounds(bounds: LengthBounds) -> Option[LengthBounds]:
	var minimum = bounds.minimum
	var maximum = bounds.maximum
	var invalid: Bool = False
	while bounds.excluded.contains(minimum):
		next = minimum.add(1)
		if next.less_than(minimum):
			invalid = True
			break
		minimum = next
	match maximum:
		Some(limit):
			var last = limit
			while bounds.excluded.contains(last):
				if last.equals(0):
					invalid = True
					break
				last = last.subtract(1)
			if last.less_than(minimum):
				invalid = True
			maximum = Some(last)
		None: void
	if invalid:
		None
	else:
		Some({ bounds | minimum = minimum, maximum = maximum })


private pure func refine_lengths(place: ConcretePatternPlace, test: ListLengthTest, succeeds: Bool, facts: List[PlaceFact]) -> Option[List[PlaceFact]]:
	bounds = length_bounds(place, facts)
	var minimum = bounds.minimum
	var maximum = bounds.maximum
	var excluded = bounds.excluded
	var viable: Bool = True
	match test:
		ExactLength(length):
			if succeeds:
				if length.greater_than(minimum):
					minimum = length
				match maximum:
					None: maximum = Some(length)
					Some(limit):
						if length.less_than(limit):
							maximum = Some(length)
			else:
				excluded = excluded.append(length)
		MinimumLength(length):
			if succeeds:
				if length.greater_than(minimum):
					minimum = length
			else:
				if length.equals(0):
					viable = False
				else:
					limit = length.subtract(1)
					match maximum:
						None: maximum = Some(limit)
						Some(previous):
							if limit.less_than(previous):
								maximum = Some(limit)
	if viable:
		match normalize_bounds({ minimum = minimum, maximum = maximum, excluded = excluded }):
			None: None
			Some(refined): Some(put_constraint(place, ListLengths(refined), facts))
	else:
		None


private pure func refine_variants(place: ConcretePatternPlace, variant: VariantInstanceId, succeeds: Bool, facts: List[PlaceFact], unions: List[ConcreteUnion], span: Span) -> Result[Option[List[PlaceFact]], Diagnostic]:
	nominal: Void ?= if same_type(place.value_type, UnionType(variant_owner(variant))):
		Ok(void)
	else:
		Err(verification_error(span, "selection variant belongs to another union"))
	possible ?= variant_possibilities(place, facts, unions, span)
	declared ?= possible.get(variant_number(variant)).to_result(verification_error(span, "unknown variant identity"))
	var refined: List[Bool] = []
	var position = 0
	for included in possible:
		matching = position.equals(variant_number(variant))
		if matching:
			if succeeds:
				refined = refined.append(included)
			else:
				refined = refined.append(False)
		else:
			if succeeds:
				refined = refined.append(False)
			else:
				refined = refined.append(included)
		position = position.add(1)
	if has_possible(refined):
		Ok(Some(put_constraint(place, VariantPossibilities(refined), facts)))
	else:
		Ok(None)


private fixed record DecisionBranches {
	yes: Option[List[PlaceFact]],
	no: Option[List[PlaceFact]]
}


private pure func decision_branches(node: OwnedDecisionNode, root_type: TypeRef, facts: List[PlaceFact], unions: List[ConcreteUnion], span: Span, records: List[ConcreteRecord]) -> Result[DecisionBranches, Diagnostic]:
	match node:
		TestVariant(place, variant, _, _): variant_branches(place, variant, root_type, facts, unions, span, records)
		TestListLength(place, test, _, _): length_branches(place, test, root_type, facts, unions, span, records)
		TestStringBytes(place, _, _, _): string_branches(place, root_type, facts, unions, span, records)
		EnterArm(_): Ok({ yes = Some(facts), no = Some(facts) })


private pure func variant_branches(place: ConcretePatternPlace, variant: VariantInstanceId, root_type: TypeRef, facts: List[PlaceFact], unions: List[ConcreteUnion], span: Span, records: List[ConcreteRecord]) -> Result[DecisionBranches, Diagnostic]:
	valid ?= verify_pattern_place(place, root_type, facts, unions, span, records)
	yes ?= refine_variants(place, variant, True, facts, unions, span)
	no ?= refine_variants(place, variant, False, facts, unions, span)
	Ok({ yes = yes, no = no })


private pure func length_branches(place: ConcretePatternPlace, test: ListLengthTest, root_type: TypeRef, facts: List[PlaceFact], unions: List[ConcreteUnion], span: Span, records: List[ConcreteRecord]) -> Result[DecisionBranches, Diagnostic]:
	valid ?= verify_pattern_place(place, root_type, facts, unions, span, records)
	element ?= list_element_type(place.value_type, span)
	count = match test:
		ExactLength(length): length
		MinimumLength(length): length
	nonnegative: Void ?= if count.less_than(0):
		Err(verification_error(span, "list length test count must be nonnegative"))
	else:
		Ok(void)
	Ok({ yes = refine_lengths(place, test, True, facts), no = refine_lengths(place, test, False, facts) })


private pure func string_branches(place: ConcretePatternPlace, root_type: TypeRef, facts: List[PlaceFact], unions: List[ConcreteUnion], span: Span, records: List[ConcreteRecord]) -> Result[DecisionBranches, Diagnostic]:
	valid ?= verify_pattern_place(place, root_type, facts, unions, span, records)
	if same_type(place.value_type, StringType):
		Ok({ yes = Some(facts), no = Some(facts) })
	else:
		Err(verification_error(span, "string byte test requires a String place"))


-- All incoming paths arrive before a node is examined. Missing place facts
-- disappear at merges; possibilities are widened, never granted by one path.
private pure func selection_possibilities(
	selection: OwnedSelection,
	scrutinee: KnownValue,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[List[Option[List[PlaceFact]]], Diagnostic]:
	span = scrutinee.span
	var incoming: List[Option[List[PlaceFact]]] = []
	for _ in selection.nodes:
		incoming = incoming.append(None)
	entry = decision_node_number(selection.entry)
	valid_entry: Void ?= if entry.less_than(0):
		Err(verification_error(span, "selection entry is not a node"))
	else if entry.greater_than_or_equal(selection.nodes.length()):
		Err(verification_error(span, "selection entry is not a node"))
	else:
		Ok(void)
	incoming = incoming.set(entry, Some([]))
	var position = selection.nodes.length().subtract(1)
	var failure: Option[Diagnostic] = None
	while position.greater_than_or_equal(0):
		match selection.nodes.get(position):
			Some(node):
				match incoming.get(position):
					Some(Some(facts)):
						match decision_branches(node, scrutinee.value_type, facts, unions, span, records):
							Err(error): failure = Some(error)
							Ok(branches):
								match node:
									EnterArm(_): void
									TestVariant(_, _, yes, no):
										match propagate_selection(incoming, position, decision_node_number(yes), branches.yes, span):
											Err(error): failure = Some(error)
											Ok(first):
												match propagate_selection(first, position, decision_node_number(no), branches.no, span):
													Err(error): failure = Some(error)
													Ok(next): incoming = next
									TestListLength(_, _, yes, no):
										match propagate_selection(incoming, position, decision_node_number(yes), branches.yes, span):
											Err(error): failure = Some(error)
											Ok(first):
												match propagate_selection(first, position, decision_node_number(no), branches.no, span):
													Err(error): failure = Some(error)
													Ok(next): incoming = next
									TestStringBytes(_, _, yes, no):
										match propagate_selection(incoming, position, decision_node_number(yes), branches.yes, span):
											Err(error): failure = Some(error)
											Ok(first):
												match propagate_selection(first, position, decision_node_number(no), branches.no, span):
													Err(error): failure = Some(error)
													Ok(next): incoming = next
					_: failure = Some(verification_error(span, "selection contains an unreachable node"))
			None: failure = Some(verification_error(span, "selection node is missing"))
		if failure.is_some():
			break
		position = position.subtract(1)
	match failure:
		Some(error): Err(error)
		None: Ok(incoming)


private pure func propagate_selection(
	incoming: List[Option[List[PlaceFact]]],
	position: Int,
	target: Int,
	facts: Option[List[PlaceFact]],
	span: Span,
) -> Result[List[Option[List[PlaceFact]]], Diagnostic]:
	if target.less_than(0):
		Err(verification_error(span, "selection successor is not an earlier node"))
	else if target.greater_than_or_equal(position):
		Err(verification_error(span, "selection successor is not an earlier node"))
	else:
		match incoming.get(target):
			None: Err(verification_error(span, "selection successor is not a node"))
			Some(previous):
				match facts:
					None: Ok(incoming)
					Some(arriving):
						match previous:
							None: Ok(incoming.set(target, Some(arriving)))
							Some(existing): Ok(incoming.set(target, Some(merge_guards(existing, arriving))))


private pure func edge_value_allowed(id: ValueId, root: ValueId, first_value: Int) -> Bool:
	if value_number(id).equals(value_number(root)):
		True
	else:
		value_number(id).greater_than_or_equal(first_value)


-- The restricted edge cannot create calls/control or consume its enclosing
-- owners. Normal operation and transfer verification still checks every borrow,
-- actual projection identity, owner occurrence and local ordinal independently.
private pure func verify_selection_edge(
	edge: OwnedSelectionEdge,
	target: SelectionTarget,
	selection: OwnedSelection,
	initial: VerificationState,
	projection: ProjectionContext,
	signature: FunctionSignature,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
	span: Span,
) -> Result[BlockEnd, Diagnostic]:
	var failure: Option[Diagnostic] = None
	root = argument_value(selection.scrutinee)
	for operation in edge.operations:
		allowed = match operation:
			DefineValue(definition):
				match definition.operation:
					ReadRecordFieldDefinition(_, argument): edge_value_allowed(argument_value(argument), root, initial.facts.first_value)
					PayloadDefinition(_, source): edge_value_allowed(source, root, initial.facts.first_value)
					ListElementDefinition(_, source): edge_value_allowed(source, root, initial.facts.first_value)
					ListSuffixDefinition(source, _): edge_value_allowed(argument_value(source), root, initial.facts.first_value)
					_: False
			AcquireOwner(_, borrow, _): edge_value_allowed(borrow.value, root, initial.facts.first_value)
			DropOwner(owner, _): owner_number(owner).greater_than_or_equal(initial.facts.first_owner)
			ExecuteJoin(_) | ExecuteLoop(_): False
		match allowed:
			True: void
			False:
				failure = Some(verification_error(span, "selection edge contains an operation outside its local projections"))
				break
	restricted: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	verified ?= verify_operations(edge.operations, initial, signature, functions, unions, projection, records)
	arity: Void ?= if edge.transfers.length().equals(target.inputs.length()):
		Ok(void)
	else:
		Err(verification_error(span, "selection edge argument count does not match its arm inputs"))
	var current = verified.state
	var position = 0
	for transfer in edge.transfers:
		value = match transfer:
			UnmanagedReturn(id): id
			OwnedReturn(id, _): id
		if edge_value_allowed(value, root, initial.facts.first_value):
			match target.inputs.get(position):
				None: failure = Some(verification_error(span, "selection edge has no corresponding arm input"))
				Some(input):
					match consume_yield(transfer, current, join_parameter(input).value_type, unions, records, span):
						Err(error): failure = Some(error)
						Ok(consumed): current = consumed
		else:
			failure = Some(verification_error(span, "selection edge argument is outside its local projections"))
		if failure.is_some():
			break
		position = position.add(1)
	transferred: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	completed ?= complete_owners(current.owners, current.facts.first_owner, None, YieldEdge, span)
	Ok(block_end(current))


private pure func verify_selection(
	selection: OwnedSelection,
	targets: List[SelectionTarget],
	state: VerificationState,
	end: BlockEnd,
	signature: FunctionSignature,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[BlockEnd, Diagnostic]:
	span: Span = { source = compiler_source(), start = 0, end = 0 }
	scrutinee ?= known_value(state.facts, argument_value(selection.scrutinee), span)
	live ?= verify_match_argument(selection.scrutinee, state.facts, unions, records, scrutinee.span, state.discharged, state.owners)
	incoming ?= selection_possibilities(selection, scrutinee, unions, records)
	var seen: List[Int] = []
	var failure: Option[Diagnostic] = None
	var target_ordinal = 0
	for target in targets:
		identity = match_arm_number(target.id)
		if seen.contains(identity):
			failure = Some(verification_error(scrutinee.span, "selection arm identity appears more than once"))
			break
		if identity.not_equals(target_ordinal):
			failure = Some(verification_error(scrutinee.span, "selection arm identity is not its source ordinal"))
			break
		seen = seen.append(identity)
		target_ordinal = target_ordinal.add(1)
	var cursor = end
	var position = 0
	var entered: List[Int] = []
	for node in selection.nodes:
		if failure.is_some():
			break
		match node:
			TestVariant(_, _, _, _) | TestListLength(_, _, _, _) | TestStringBytes(_, _, _, _): void
			EnterArm(edge):
				match selection_target(edge.arm, targets, scrutinee.span):
					Err(error): failure = Some(error)
					Ok(target):
						match incoming.get(position):
							None: failure = Some(verification_error(scrutinee.span, "selection node is missing"))
							Some(None): failure = Some(verification_error(scrutinee.span, "selection contains an unreachable node"))
							Some(Some(facts)):
								initial = enter(state, cursor.next_value, cursor.next_owner)
								projection: ProjectionContext = SelectionProjection(selection.scrutinee, facts)
								match verify_selection_edge(edge, target, selection, initial, projection, signature, functions, unions, records, scrutinee.span):
									Err(error): failure = Some(error)
									Ok(after):
										cursor = after
										entered = entered.append(match_arm_number(edge.arm))
		position = position.add(1)
	match failure:
		Some(_): void
		None:
			for target in targets:
				match entered.contains(match_arm_number(target.id)):
					True: void
					False:
						failure = Some(verification_error(scrutinee.span, "selection arm has no incoming edge"))
						break
	match failure:
		Some(error): Err(error)
		None: Ok(cursor)


-- Verifies every pending join's arms after their block, in the order their
-- values and owners are numbered, and returns the ordinals after them.
private pure func verify_joins(
	pending: List[PendingControl],
	active: Option[ActiveLoop],
	end: BlockEnd,
	signature: FunctionSignature,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[BlockEnd, Diagnostic]:
	var cursor = end
	var invalid: Option[Diagnostic] = None
	for control in pending:
		checked: Result[BlockEnd, Diagnostic] = match control:
			VerifyLoop(loop, start): verify_loop(loop, start, cursor, signature, functions, unions, records)
			VerifyJoin(join):
				var targets: List[SelectionTarget] = []
				for arm in join.join.arms:
					targets = targets.append({ id = arm.id, inputs = arm.inputs })
				selected = verify_selection(join.join.selection, targets, join.start, cursor, signature, functions, unions, records)
				var after = cursor
				match selected:
					Err(error): invalid = Some(error)
					Ok(completed): after = completed
				for arm in join.join.arms:
					if invalid.is_some():
						break
					match verify_join_arm(arm, join, after, active, signature, functions, unions, records):
						Err(error):
							invalid = Some(error)
							break
						Ok(next): after = next
				match invalid:
					Some(error): Err(error)
					None: Ok(after)
		match checked:
			Ok(after): cursor = after
			Err(error):
				invalid = Some(error)
				break
	match invalid:
		Some(error): Err(error)
		None: Ok(cursor)


private pure func verify_join_arm(
	arm: OwnedJoinArm,
	join: PendingJoin,
	cursor: BlockEnd,
	active: Option[ActiveLoop],
	signature: FunctionSignature,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[BlockEnd, Diagnostic]:
	initial = enter(join.start, cursor.next_value, cursor.next_owner)
	start ?= introduce_outputs(arm.inputs, initial, unions, records)
	match arm.exit:
		Yield(outputs):
			match verify_operations(arm.operations, start, signature, functions, unions, NoProjection, records):
				Err(error): Err(error)
				Ok(verified):
					match verify_join_transfers(outputs, join.join, join.start.discharged, verified.state, unions, records):
						Err(error): Err(error)
						Ok(_): verify_joins(verified.pending, active, block_end(verified.state), signature, functions, unions, records)
		TransferLoop(target, tail):
			verify_abrupt_exit(target, { operations = arm.operations, tail = tail }, active, start, signature, functions, unions, records)


private pure func verify_abrupt_exit(
	target: LoopTarget,
	body: OwnedLoopBlock,
	active: Option[ActiveLoop],
	state: VerificationState,
	signature: FunctionSignature,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[BlockEnd, Diagnostic]:
	span = loop_tail_span(body.tail)
	scope ?= active.to_result(verification_error(span, "loop transfer has no active loop"))
	nearest: Void ?= if value_number(loop_target_value(target)).equals(value_number(join_parameter(scope.loop.result).id)):
		Ok(void)
	else:
		Err(verification_error(span, "loop transfer does not target the nearest active loop"))
	verify_loop_block(body, scope.loop, scope.pre, scope.first_owner, state, signature, functions, unions, records)


private pure func loop_exit_span(exit: OwnedLoopExit) -> Span:
	match exit:
		Recur(_, span): span
		Break(outputs): outputs.span


private pure func loop_tail_span(tail: OwnedLoopTail) -> Span:
	match tail:
		ExitLoop(exit): loop_exit_span(exit)
		MatchLoop(matched):
			match matched.arms.get(0):
				Some(arm): loop_tail_span(arm.body.tail)
				None: { source = compiler_source(), start = 0, end = 0 }


-- PRE is the actual state captured before publishing any loop output.
private pure func complete_loop_owners(
	pre: VerificationState,
	state: VerificationState,
	first_owner: Int,
	span: Span,
) -> Result[Void, Diagnostic]:
	captured: List[EnclosingScope] = pre.facts.enclosing.append({
		first_value = pre.facts.first_value, values = pre.facts.values,
		first_owner = pre.facts.first_owner, owners = pre.owners
	})
	var failure: Option[Diagnostic] = None
	for scope in captured:
		var ordinal = scope.first_owner
		for owner in scope.owners:
			match owner:
				ActiveOwner(_, _):
					newly_discharged: Bool = match discharged_already(pre.discharged, ordinal):
						True: False
						False: discharged_already(state.discharged, ordinal)
					if newly_discharged:
						failure = Some(verification_error(span, "loop edge discharges a captured owner"))
						break
				DischargedOwner: void
			ordinal = ordinal.add(1)
		if failure.is_some():
			break
	preserved: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	for scope in state.facts.enclosing:
		var ordinal = scope.first_owner
		for owner in scope.owners:
			match owner:
				ActiveOwner(_, _):
					missing_discharge = match ordinal.greater_than_or_equal(first_owner):
						True: discharged_already(state.discharged, ordinal).not()
						False: False
					if missing_discharge:
						failure = Some(verification_error(span, "loop-local owner remains live at an edge"))
						break
				DischargedOwner: void
			ordinal = ordinal.add(1)
		if failure.is_some():
			break
	retired: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	complete_owners(state.owners, state.facts.first_owner, None, YieldEdge, span)


private pure func verify_loop_exit(
	exit: OwnedLoopExit,
	loop: OwnedLoop,
	pre: VerificationState,
	first_owner: Int,
	state: VerificationState,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	var parameters: List[ValueParameter] = []
	match exit:
		Recur(_, _):
			for header in loop.headers:
				parameters = parameters.append(join_parameter(header.parameter))
		Break(_):
			for output in [loop.result].concat(loop.carried):
				parameters = parameters.append(join_parameter(output))
	transfers = match exit:
		Recur(arguments, _): arguments
		Break(outputs): [outputs.value].concat(outputs.carried)
	span = loop_exit_span(exit)
	arity: Void ?= if parameters.length().equals(transfers.length()):
		Ok(void)
	else:
		Err(verification_error(span, "loop edge has the wrong number of values"))
	var current = state
	var position = 0
	var failure: Option[Diagnostic] = None
	for parameter in parameters:
		match transfers.get(position):
			None:
				failure = Some(verification_error(span, "missing loop edge transfer"))
				break
			Some(transfer):
				match consume_loop_transfer(transfer, current, parameter.value_type, unions, records, span):
					Err(error):
						failure = Some(error)
						break
					Ok(consumed): current = consumed
		position = position.add(1)
	transferred: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	complete_loop_owners(pre, current, first_owner, span)


-- Loop transfers consume acquisition occurrences, independently of the source's
-- own obligation. This rejects direct old-H moves and repeated owner occurrences.
private pure func consume_loop_transfer(
	transfer: ReturnTransfer,
	state: VerificationState,
	value_type: TypeRef,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
	span: Span,
) -> Result[VerificationState, Diagnostic]:
	fresh: Result[Void, Diagnostic] = match transfer:
		UnmanagedReturn(_): Ok(void)
		OwnedReturn(_, owner):
			match known_owner(state.facts, state.discharged, state.owners, owner, span):
				Err(error): Err(error)
				Ok(DischargedOwner): Err(verification_error(span, "loop transfer refers to a discharged owner"))
				Ok(ActiveOwner(_, origin)):
					match origin:
						AcquiredOwner: Ok(void)
						DefinedOwner: Err(verification_error(span, "loop transfer must use a fresh acquisition"))
	ready ?= fresh
	consume_yield(transfer, state, value_type, unions, records, span)


-- PRE follows the loop step's header transfers and precedes entry acquisitions
-- and P. Acquisitions live only in this private interval; every other managed
-- initial consumes one before any fresh H is published.
private pure func initialize_loop(
	loop: OwnedLoop,
	pre: VerificationState,
	cursor: BlockEnd,
	signature: FunctionSignature,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[VerificationState, Diagnostic]:
	span = join_parameter(loop.result).span
	start = enter(pre, cursor.next_value, cursor.next_owner)
	var operations: List[OwnershipOperation] = []
	for acquisition in loop.entry_acquisitions:
		operations = operations.append(AcquireOwner(acquisition.owner, acquisition.borrow, span))
	acquired ?= verify_operations(operations, start, signature, functions, unions, NoProjection, records)
	var current = acquired.state
	var failure: Option[Diagnostic] = None
	for header in loop.headers:
		parameter = join_parameter(header.parameter)
		value = match header.initial:
			UnmanagedReturn(id): id
			OwnedReturn(id, _): id
		taken: Bool = match header.initial:
			UnmanagedReturn(_): False
			OwnedReturn(_, owner): takes_existing_owner(loop, owner)
		match known_value(pre.facts, value, parameter.span):
			Err(error): failure = Some(error)
			Ok(source):
				if same_type(source.value_type, parameter.value_type):
					-- ExecuteLoop already discharged a taken owner, before PRE.
					if taken:
						void
					else:
						match consume_loop_transfer(header.initial, current, parameter.value_type, unions, records, parameter.span):
							Err(error): failure = Some(error)
							Ok(consumed): current = consumed
				else:
					failure = Some(verification_error(parameter.span, "loop initial type does not match its header"))
		if failure.is_some():
			break
	transferred: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	complete ?= complete_owners(current.owners, current.facts.first_owner, None, YieldEdge, span)
	for header in loop.headers:
		parameter = join_parameter(header.parameter)
		next_value = current.facts.first_value.add(current.facts.values.length())
		if value_number(parameter.id).not_equals(next_value):
			failure = Some(verification_error(parameter.span, "loop header identity is not the next function ordinal"))
			break
		match introduce_carried_parameter(header.parameter, current, unions, records):
			Err(error):
				failure = Some(error)
				break
			Ok(introduced): current = introduced
	match failure:
		Some(error): Err(error)
		None: Ok(current)


private pure func verify_loop(
	loop: OwnedLoop,
	pre: VerificationState,
	cursor: BlockEnd,
	signature: FunctionSignature,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[BlockEnd, Diagnostic]:
	initial ?= initialize_loop(loop, pre, cursor, signature, functions, unions, records)
	verify_loop_block(loop.body, loop, pre, cursor.next_owner, initial, signature, functions, unions, records)


private pure func verify_loop_match(
	matched: OwnedLoopMatch,
	loop: OwnedLoop,
	pre: VerificationState,
	first_owner: Int,
	state: VerificationState,
	end: BlockEnd,
	signature: FunctionSignature,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[BlockEnd, Diagnostic]:
	var targets: List[SelectionTarget] = []
	for arm in matched.arms:
		targets = targets.append({ id = arm.id, inputs = arm.inputs })
	selected ?= verify_selection(matched.selection, targets, state, end, signature, functions, unions, records)
	var cursor = selected
	var invalid: Option[Diagnostic] = None
	for arm in matched.arms:
		initial = enter(state, cursor.next_value, cursor.next_owner)
		match introduce_outputs(arm.inputs, initial, unions, records):
			Err(error): invalid = Some(error)
			Ok(branch_start):
				match verify_loop_block(arm.body, loop, pre, first_owner, branch_start, signature, functions, unions, records):
					Err(error): invalid = Some(error)
					Ok(after): cursor = after
		if invalid.is_some():
			break
	match invalid:
		Some(error): Err(error)
		None: Ok(cursor)


private pure func verify_loop_block(
	body: OwnedLoopBlock,
	loop: OwnedLoop,
	pre: VerificationState,
	first_owner: Int,
	initial: VerificationState,
	signature: FunctionSignature,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[BlockEnd, Diagnostic]:
	active: Option[ActiveLoop] = Some({ loop = loop, pre = pre, first_owner = first_owner })
	verified ?= verify_operations(body.operations, initial, signature, functions, unions, NoProjection, records)
	match body.tail:
		ExitLoop(exit):
			match verify_loop_exit(exit, loop, pre, first_owner, verified.state, unions, records):
				Err(error): Err(error)
				Ok(_): verify_joins(verified.pending, active, block_end(verified.state), signature, functions, unions, records)
		MatchLoop(matched):
			match verify_joins(verified.pending, active, block_end(verified.state), signature, functions, unions, records):
				Err(error): Err(error)
				Ok(completed): verify_loop_match(matched, loop, pre, first_owner, verified.state, completed, signature, functions, unions, records)


private pure func verify_function(
	function: OwnedFunction,
	functions: List[OwnedFunction],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	initial: VerificationState = {
		facts = {
			enclosing = [],
			first_value = 0,
			values = [],
			first_owner = 0,
			parameters = []
		},
		discharged = [],
		owners = []
	}
	verified ?= verify_operations(
		function.operations,
		initial,
		function.signature,
		functions,
		unions,
		NoProjection,
		records,
	)
	state = verified.state

	valid_parameter: Void ?= if state.facts.parameters.length().equals(
		function.signature.parameters.length(),
	):
		Ok(void)
	else:
		Err(
			verification_error(
				{
					source = compiler_source(),
					start = 0,
					end = 0
				},
				"function parameter has no value definition",
			),
		)

	returned ?= verify_transfer(function.result, state, function.signature.return_type, unions, records)
	completed ?= verify_joins(verified.pending, None, block_end(state), function.signature, functions, unions, records)
	Ok(void)


-- Independently check the accepted wrapper convention against its target signature.
private pure func verify_entry(
	entry: OwnedFunction,
	convention: Entrypoint[FunctionInstanceId],
) -> Result[Void, Diagnostic]:
	parameters_match = match convention:
		NoArguments(_, _):
			entry.signature.parameters.is_empty()
		WithArguments(_, _):
			match entry.signature.parameters:
				[value]:
					same_type(value, ListType(StringType))
				_:
					False

	result = match convention:
		NoArguments(_, result):
			result
		WithArguments(_, result):
			result

	result_matches = match result:
		IntegerExitStatus:
			same_type(entry.signature.return_type, IntType)
		SuccessfulExit:
			same_type(entry.signature.return_type, VoidType)

	valid = and(parameters_match, result_matches)

	if valid:
		Ok(void)
	else:
		span: Span = match entry.operations.get(0):
			Some(operation):
				match operation:
					DefineValue(definition):
						definition.span
					ExecuteJoin(join): join_parameter(join.result).span
					ExecuteLoop(loop): join_parameter(loop.result).span
					AcquireOwner(_, _, occurrence):
						occurrence
					DropOwner(_, occurrence):
						occurrence
			None:
				{
					source = compiler_source(),
					start = 0,
					end = 0
				}

		Err(
			verification_error(
				span,
				"entrypoint signature does not match its accepted argument and result conventions",
			),
		)


pure func verify(program: OwnershipProgram) -> Result[VerifiedProgram, Diagnostic]:
	entry ?= program.functions
		.get(function_number(entry_function(program.entrypoint)))
		.to_result(
			verification_error(
				{
					source = compiler_source(),
					start = 0,
					end = 0
				},
				"entrypoint function is not defined",
			),
		)
	var invalid: Option[Diagnostic] = None

	for layout in program.records:
		match (
			valid_record_layout(
				layout,
				{
					source = compiler_source(),
					start = 0,
					end = 0
				},
			)
		):
			Ok(_):
				void
			Err(error):
				invalid = Some(error)
				break

	var union_position = 0

	for layout in program.unions:
		if invalid.is_some():
			break

		match valid_union_layout(layout, union_position, program.records, program.unions):
			Err(error):
				invalid = Some(error)
				break
			Ok(_):
				union_position = union_position.add(1)

	complete_layouts: Void ?= match invalid:
		Some(error):
			Err(error)
		None:
			verify_layout_graph(program.records, program.unions)

	for function in program.functions:
		for value_type in function.signature.parameters.append(function.signature.return_type):
			match verify_type_membership(value_type, program.unions, program.records, { source = compiler_source(), start = 0, end = 0 }):
				Ok(_):
					void
				Err(error):
					invalid = Some(error)

		if invalid.is_some():
			break

		match verify_function(
			function,
			program.functions,
			program.unions,
			program.records,
		):
			Ok(_):
				void
			Err(error):
				invalid = Some(error)
				break

	match invalid:
		Some(error):
			Err(error)
		None:
			match verify_entry(entry, program.entrypoint):
				Ok(valid_entry): Ok(into_opaque VerifiedProgram(program))
				Err(error): Err(error)
