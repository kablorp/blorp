import:
	result: map
	../check/model: MatchArmId, DecisionNodeId, ListLengthTest
	../utils/boolean: not, and
	int as IntOps
	list: repeat, set_index, contains
	../lower/lower as Lower:
		JoinArm,
		LoopExit,
		LoweredLoop,
		LoweredFunction,
		LoweredJoin,
		LoweredProgram,
		LoweredStep(Define, Join, Loop),
		LoweredSelection,
		SelectionEdge,
		SelectionDefinition(BorrowUnionField, BorrowRecordField, BorrowListElement, CopyListSuffix),
		ValueDefinition,
		ValueId,
		ValueParameter,
		ValueOperation(
			ParameterValue, VoidValue, IntegerValue, FloatValue, StringValue,
			CallValue, InvokeCallableValue, FreeCallableValue, CapturedCallableValue, ConstructValue, ConstructListValue, PayloadValue, ListElementValue, ListSuffixValue, ConstructRecordValue, ReadRecordFieldValue,
		),
		lowered_functions,
		block_value_count, step_reads, step_span, step_value_count, value_span,
		value_number,
	option: is_some, to_result
	../utils/source: compiler_source
	../specialize/specialize:
		CallTarget,
		ConcretePatternPlace,
		ConcreteRecord,
		ConcreteUnion,
		FieldInstanceId,
		FunctionInstanceId,
		FunctionSignature,
		RecordInstanceId,
		TypeRef,
		VariantInstanceId, VariantFieldInstanceId,
		value_needs_ownership,
	../utils/syntax: Diagnostic, Entrypoint, Span
	../utils/text: concat


-- This identity names an obligation in an unverified function body. Only the
-- independent verifier establishes its membership, lifetime and uniqueness.
opaque type OwnerId = Int


pure func owner_id(ordinal: Int) -> OwnerId:
	into_opaque OwnerId(ordinal)


pure func owner_number(id: OwnerId) -> Int:
	from_opaque OwnerId(id)


fixed union BorrowSource:
	ParameterBorrow(ValueId)
	OwnerBorrow(OwnerId)
	PayloadBorrow(ValueId)


fixed record BorrowedValue {
	value: ValueId,
	source: BorrowSource
}


fixed union OwnedArgument:
	UnmanagedArgument(ValueId)
	BorrowedArgument(BorrowedValue)


fixed union ResultOwnership:
	UnmanagedResult
	BorrowedResult(BorrowSource)
	OwnedResult(OwnerId)


fixed union StoredPayload:
	UnmanagedPayload(ValueId)
	OwnedPayload(ValueId, OwnerId)


fixed record OwnedRecordField {
	field: FieldInstanceId,
	value: StoredPayload
}


fixed union OwnedValueOperation:
	ConstructRecordDefinition(RecordInstanceId, List[OwnedRecordField])
	ReadRecordFieldDefinition(FieldInstanceId, OwnedArgument)
	ParameterDefinition(Int)
	VoidDefinition
	IntegerDefinition(Int)
	FloatDefinition(Float)
	StringDefinition(String)
	CallDefinition(CallTarget, List[OwnedArgument])
	InvokeCallableDefinition(OwnedArgument, List[OwnedArgument])
	FreeCallableDefinition(FunctionInstanceId)
	CapturedCallableDefinition(FunctionInstanceId, StoredPayload)
	ConstructDefinition(VariantInstanceId, List[StoredPayload])
	ConstructListDefinition(List[StoredPayload])
	PayloadDefinition(VariantFieldInstanceId, ValueId)
	ListElementDefinition(Int, ValueId)
	ListSuffixDefinition(OwnedArgument, Int)


fixed record OwnedDefinition {
	id: ValueId,
	value_type: TypeRef,
	operation: OwnedValueOperation,
	result: ResultOwnership,
	span: Span
}


fixed union OwnershipOperation:
	DefineValue(OwnedDefinition)
	ExecuteJoin(OwnedJoin)
	ExecuteLoop(OwnedLoop)
	AcquireOwner(OwnerId, BorrowedValue, Span)
	DropOwner(OwnerId, Span)


-- A value leaving its block on a return or yield edge, with the owner a
-- managed value moves.
fixed union ReturnTransfer:
	UnmanagedReturn(ValueId)
	OwnedReturn(ValueId, OwnerId)


fixed record OwnedJoinOutputs {
	transfer: ReturnTransfer,
	carried: List[ReturnTransfer]
}


fixed union OwnedJoinExit:
	Yield(OwnedJoinOutputs)
	TransferLoop(Lower.LoopTarget, OwnedLoopTail)


-- Only yielding arms move values into the join's continuation.
fixed record OwnedJoinArm {
	id: MatchArmId,
	inputs: List[OwnedJoinParameter],
	operations: List[OwnershipOperation],
	exit: OwnedJoinExit
}


fixed union OwnedJoinParameter:
	UnmanagedJoinParameter(ValueParameter)
	ManagedJoinParameter(ValueParameter, OwnerId)


pure func join_parameter(output: OwnedJoinParameter) -> ValueParameter:
	match output:
		UnmanagedJoinParameter(parameter): parameter
		ManagedJoinParameter(parameter, _): parameter


pure func join_ownership(output: OwnedJoinParameter) -> ResultOwnership:
	match output:
		UnmanagedJoinParameter(_): UnmanagedResult
		ManagedJoinParameter(_, owner): OwnedResult(owner)


-- Selection edges follow their enclosing block in decision-node order;
-- canonical arm inputs then precede ordinary arm values and nested controls.
fixed record OwnedJoin {
	result: OwnedJoinParameter,
	carried: List[OwnedJoinParameter],
	selection: OwnedSelection,
	arms: List[OwnedJoinArm]
}


fixed record OwnedLoopOutputs {
	value: ReturnTransfer,
	carried: List[ReturnTransfer],
	span: Span
}


fixed union OwnedLoopExit:
	Break(OwnedLoopOutputs)
	Recur(List[ReturnTransfer], Span)


fixed record OwnedSelectionEdge {
	arm: MatchArmId,
	operations: List[OwnershipOperation],
	transfers: List[ReturnTransfer]
}


fixed union OwnedDecisionNode:
	TestVariant(ConcretePatternPlace, VariantInstanceId, DecisionNodeId, DecisionNodeId)
	TestListLength(ConcretePatternPlace, ListLengthTest, DecisionNodeId, DecisionNodeId)
	TestStringBytes(ConcretePatternPlace, String, DecisionNodeId, DecisionNodeId)
	EnterArm(OwnedSelectionEdge)


fixed record OwnedSelection {
	scrutinee: OwnedArgument,
	nodes: List[OwnedDecisionNode],
	entry: DecisionNodeId
}


fixed record OwnedLoopArm {
	id: MatchArmId,
	inputs: List[OwnedJoinParameter],
	body: OwnedLoopBlock
}


fixed record OwnedLoopMatch {
	selection: OwnedSelection,
	arms: List[OwnedLoopArm]
}

fixed union OwnedLoopTail:
	ExitLoop(OwnedLoopExit)
	MatchLoop(OwnedLoopMatch)


fixed record OwnedLoopBlock {
	operations: List[OwnershipOperation],
	tail: OwnedLoopTail
}


fixed record OwnedLoopHeader {
	parameter: OwnedJoinParameter,
	initial: ReturnTransfer
}


fixed record OwnedLoop {
	entry_acquisitions: List[OwnerAcquisition],
	headers: List[OwnedLoopHeader],
	result: OwnedJoinParameter,
	carried: List[OwnedJoinParameter],
	body: OwnedLoopBlock
}


fixed record OwnedFunction {
	signature: FunctionSignature,
	operations: List[OwnershipOperation],
	result: ReturnTransfer
}


fixed record OwnershipProgram {
	records: List[ConcreteRecord],
	unions: List[ConcreteUnion],
	functions: List[OwnedFunction],
	entrypoint: Entrypoint[FunctionInstanceId]
}


-- Insertion errors with no source occurrence carry this compiler span.
private pure func internal_span() -> Span:
	{
		source = compiler_source(),
		start = 0,
		end = 0
	}


private pure func internal_error(span: Span, message: String) -> Diagnostic:
	{
		span = span,
		note = None,
		message = "internal compiler error: ".concat(message),
		help = "report this compiler error with the input program"
	}


-- Values of enclosing blocks that a block may read: each a consecutive
-- interval of one enclosing block's values before the nested arm.
private fixed record ValueInterval {
	first: Int,
	count: Int
}


private pure func in_interval(ordinal: Int, first: Int, count: Int) -> Bool:
	match IntOps.greater_than_or_equal(ordinal, first):
		False: False
		True: IntOps.less_than(ordinal, IntOps.add(first, count))


private pure func visible_outside(ordinal: Int, outer: List[ValueInterval]) -> Bool:
	var visible: Bool = False
	for interval in outer:
		if in_interval(ordinal, interval.first, interval.count):
			visible = True
			break
	visible


-- Last-use positions belong to this block; ValueIds remain function-wide.
-- Enclosing values are visible, but earlier sibling ordinals are not.
private pure func use_slot(
	value: ValueId,
	introduced_count: Int,
	outer: List[ValueInterval],
	first_value: Int,
	slot_count: Int,
	span: Span,
) -> Result[Option[Int], Diagnostic]:
	ordinal = value_number(value)

	if visible_outside(ordinal, outer):
		Ok(None)
	else if in_interval(ordinal, first_value, introduced_count):
		index = IntOps.subtract(ordinal, first_value)

		if in_interval(index, 0, slot_count):
			Ok(Some(index))
		else:
			Err(internal_error(span, "invalid value identity in ownership use analysis"))
	else:
		Err(internal_error(span, "invalid value identity in ownership use analysis"))


-- The span a block's terminal use reports: its local operand's definition.
private pure func terminal_span(
	steps: List[LoweredStep],
	result: ValueId,
	outer: List[ValueInterval],
) -> Result[Span, Diagnostic]:
	if visible_outside(value_number(result), outer):
		Ok(internal_span())
	else:
		match value_span(steps, result):
			Some(span): Ok(span)
			None: Err(internal_error(internal_span(), "invalid return value in ownership use analysis"))


-- A terminal reads one returned value, shared-span backedge arguments, or a
-- join result and ordered carriers with their existing parameter origins.
private fixed union BlockTerminal:
	TerminalValue(ValueId)
	TerminalArguments(List[ValueId], Span)
	TerminalJoin(ValueId, List[ValueId], List[ValueParameter])


-- Each definition's last use in this block, at the position of its last
-- reader; the terminal operands are read at the synthetic position after
-- the last definition.
private pure func block_uses(
	steps: List[LoweredStep],
	terminal: BlockTerminal,
	outer: List[ValueInterval],
	first_value: Int,
	seed_count: Int,
	span_result: Result[Span, Diagnostic],
) -> Result[List[Option[Int]], Diagnostic]:
	unused: Option[Int] = None
	var uses = repeat(unused, IntOps.add(seed_count, block_value_count(steps)))
	var step_position: Int = 0
	var introduced_count: Int = seed_count
	var failure: Option[Diagnostic] = None

	for step in steps:
		span = step_span(step)
		first = match step:
			Define(definition): definition.id
			Join(join): join.result.id
			Loop(loop): loop.result.id
		if IntOps.not_equals(value_number(first), IntOps.add(first_value, introduced_count)):
			failure = Some(internal_error(span, "nonconsecutive value identity in ownership use analysis"))
		else:
			carried: List[ValueParameter] = match step:
				Define(_): []
				Join(join): join.carried
				Loop(loop): loop.carried
			var ordinal = IntOps.add(IntOps.add(first_value, introduced_count), 1)
			for parameter in carried:
				if IntOps.not_equals(value_number(parameter.id), ordinal):
					failure = Some(internal_error(parameter.span, "nonconsecutive value identity in ownership use analysis"))
					break
				ordinal = IntOps.add(ordinal, 1)
		if failure.is_some():
			break

		-- Slot validation borrows only scalar bounds, so each write keeps the
		-- same local vector owner rather than sharing it through Result[List].
		for operand in step_reads(step):
			match use_slot(
				operand,
				introduced_count,
				outer,
				first_value,
				uses.length(),
				span,
			):
				Ok(Some(index)):
					uses = uses.set(index, Some(step_position))
				Ok(None):
					void
				Err(error):
					failure = Some(error)
					break

		if failure.is_some():
			break

		introduced_count = IntOps.add(introduced_count, step_value_count(step))
		step_position = IntOps.add(step_position, 1)

	ready: Void ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	operands = match terminal:
		TerminalValue(result): [result]
		TerminalArguments(arguments, _): arguments
		TerminalJoin(result, _, _): [result]
	-- Resolve once at the caller, but keep operand errors ahead of a bad exit.
	span ?= span_result

	-- Start this builder inside the successful span scope. The outer snapshot
	-- may cause one initial copy; subsequent writes keep the local vector owner.
	var terminal_uses = uses
	var invalid: Option[Diagnostic] = None

	for operand in operands:
		match use_slot(
			operand,
			introduced_count,
			outer,
			first_value,
			terminal_uses.length(),
			span,
		):
			Ok(Some(index)):
				terminal_uses = terminal_uses.set(index, Some(step_position))
			Ok(None):
				void
			Err(error):
				invalid = Some(error)
				break

	match terminal:
		TerminalValue(_) | TerminalArguments(_, _): void
		TerminalJoin(_, arguments, parameters):
			var position = 0
			for parameter in parameters:
				if invalid.is_some():
					break
				match arguments.get(position):
					None: invalid = Some(internal_error(span, "join arm carries the wrong number of values"))
					Some(operand):
						match use_slot(operand, introduced_count, outer, first_value, terminal_uses.length(), parameter.span):
							Ok(slot):
								match slot:
									Some(index): terminal_uses = terminal_uses.set(index, Some(step_position))
									None: void
							Err(error): invalid = Some(error)
				position = IntOps.add(position, 1)

	match invalid:
		Some(error):
			Err(error)
		None:
			Ok(terminal_uses)


-- A loop edge reads every outgoing occurrence before retiring any owner.
pure func exit_last_uses(
	steps: List[LoweredStep],
	exit: LoopExit,
	prefix_count: Int,
	first_value: Int,
) -> Result[List[Option[Int]], Diagnostic]:
	outer: List[ValueInterval] = [{ first = 0, count = prefix_count }]
	terminal: BlockTerminal = match exit:
		Lower.Recur(arguments, span): TerminalArguments(arguments, span)
		Lower.Break(outputs): TerminalArguments([outputs.value].concat(outputs.carried), outputs.span)
	span = match exit:
		Lower.Recur(_, span): span
		Lower.Break(outputs): outputs.span
	block_uses(steps, terminal, outer, first_value, 0, Ok(span))


pure func block_last_uses(
	steps: List[LoweredStep],
	result: ValueId,
	prefix_count: Int,
	first_value: Int,
) -> Result[List[Option[Int]], Diagnostic]:
	outer: List[ValueInterval] = [{ first = 0, count = prefix_count }]
	block_uses(steps, TerminalValue(result), outer, first_value, 0, terminal_span(steps, result, outer))


pure func last_uses(
	steps: List[LoweredStep],
	result: ValueId,
) -> Result[List[Option[Int]], Diagnostic]:
	block_last_uses(steps, result, 0, 0)


fixed record OwnerAcquisition {
	owner: OwnerId,
	borrow: BorrowedValue
}


private fixed union AcquisitionPlan:
	StoredAcquisitions(List[OwnerAcquisition])
	ProjectedAcquisition(OwnerAcquisition)


private fixed record BuiltDefinition {
	definition: OwnedDefinition,
	next_owner: Int,
	acquisitions: AcquisitionPlan
}


private pure func value_source(
	value: ValueId,
	sources: List[ResultOwnership],
	enclosing: List[EnclosingBlock],
	first_value: Int,
	span: Span,
) -> Result[ResultOwnership, Diagnostic]:
	ordinal = value_number(value)
	var entry: Option[ResultOwnership] = None

	if in_interval(ordinal, first_value, sources.length()):
		entry = sources.get(IntOps.subtract(ordinal, first_value))
	else:
		for block in enclosing:
			if in_interval(ordinal, block.first_value, block.sources.length()):
				entry = block.sources.get(IntOps.subtract(ordinal, block.first_value))
				break

	entry.to_result(internal_error(span, "value used before definition in ownership insertion"))


private pure func borrow_argument(
	value: ValueId,
	sources: List[ResultOwnership],
	enclosing: List[EnclosingBlock],
	first_value: Int,
	span: Span,
) -> Result[OwnedArgument, Diagnostic]:
	source ?= value_source(value, sources, enclosing, first_value, span)
	argument: OwnedArgument = match source:
		UnmanagedResult:
			UnmanagedArgument(value)
		BorrowedResult(borrow_source):
			BorrowedArgument({
				value = value,
				source = borrow_source,
			})
		OwnedResult(owner):
			BorrowedArgument({
				value = value,
				source = OwnerBorrow(owner),
			})
	Ok(argument)


-- Stored payloads of a variant or a list literal. Each stored occurrence
-- acquires independently, including Pair(x, x) and [x, x]: a unary last-use
-- transfer cannot safely generalize to repeated values.
private fixed record StoredPayloads {
	stored: List[StoredPayload],
	acquisitions: List[OwnerAcquisition],
	next: Int
}


private pure func store_payloads(
	values: List[ValueId],
	sources: List[ResultOwnership],
	enclosing: List[EnclosingBlock],
	first_value: Int,
	span: Span,
	acquisitions: List[OwnerAcquisition],
	next_owner: Int,
) -> Result[StoredPayloads, Diagnostic]:
	var stored: List[StoredPayload] = []
	var acquired = acquisitions
	var next = next_owner
	var failure: Option[Diagnostic] = None
	for value in values:
		match borrow_argument(value, sources, enclosing, first_value, span):
			Err(error):
				failure = Some(error)
				break
			Ok(UnmanagedArgument(unmanaged_value)): stored = stored.append(UnmanagedPayload(unmanaged_value))
			Ok(BorrowedArgument(borrow)):
				child_owner = owner_id(next)
				next = IntOps.add(next, 1)
				acquired = acquired.append({ owner = child_owner, borrow = borrow })
				stored = stored.append(OwnedPayload(value, child_owner))
	match failure:
		Some(error): Err(error)
		None: Ok({ stored = stored, acquisitions = acquired, next = next })


private pure func borrowed_arguments(
	values: List[ValueId], sources: List[ResultOwnership], enclosing: List[EnclosingBlock],
	first_value: Int, span: Span,
) -> Result[List[OwnedArgument], Diagnostic]:
	var arguments: List[OwnedArgument] = []
	var failure: Option[Diagnostic] = None
	for value in values:
		match borrow_argument(value, sources, enclosing, first_value, span):
			Ok(argument): arguments = arguments.append(argument)
			Err(error):
				failure = Some(error)
				break
	match failure:
		Some(error): Err(error)
		None: Ok(arguments)


private pure func build_definition(
	definition: ValueDefinition,
	sources: List[ResultOwnership],
	enclosing: List[EnclosingBlock],
	first_value: Int,
	next_owner: Int,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[BuiltDefinition, Diagnostic]:
	needs_owner ?= value_needs_ownership(definition.value_type, unions, records)
	var next = next_owner
	var acquisitions: List[OwnerAcquisition] = []

	operation_result: Result[OwnedValueOperation, Diagnostic] = match definition.operation:
		ConstructRecordValue(owner, fields):
			var stored: List[OwnedRecordField] = []
			var failure: Option[Diagnostic] = None

			for field in fields:
				match borrow_argument(field.value, sources, enclosing, first_value, definition.span):
					Err(error):
						failure = Some(error)
						break
					Ok(UnmanagedArgument(value)):
						stored = stored.append({
							field = field.field,
							value = UnmanagedPayload(value),
						})
					Ok(BorrowedArgument(borrow)):
						child_owner = owner_id(next)
						next = IntOps.add(next, 1)
						acquisitions = acquisitions.append({
							owner = child_owner,
							borrow = borrow,
						})
						stored = stored.append({
							field = field.field,
							value = OwnedPayload(field.value, child_owner),
						})

			match failure:
				Some(error):
					Err(error)
				None:
					Ok(ConstructRecordDefinition(owner, stored))
		ReadRecordFieldValue(field, value):
			borrow_argument(
				value,
				sources,
				enclosing,
				first_value,
				definition.span,
			).map(
				pure func(parent): ReadRecordFieldDefinition(field, parent),
			)
		ParameterValue(index):
			Ok(ParameterDefinition(index))
		VoidValue:
			Ok(VoidDefinition)
		StringValue(bytes):
			Ok(StringDefinition(bytes))
		IntegerValue(value):
			Ok(IntegerDefinition(value))
		FloatValue(value):
			Ok(FloatDefinition(value))
		ConstructValue(id, values):
			match store_payloads(values, sources, enclosing, first_value, definition.span, acquisitions, next):
				Err(error): Err(error)
				Ok(payloads):
					acquisitions = payloads.acquisitions
					next = payloads.next
					Ok(ConstructDefinition(id, payloads.stored))
		ConstructListValue(values):
			match store_payloads(values, sources, enclosing, first_value, definition.span, acquisitions, next):
				Err(error): Err(error)
				Ok(payloads):
					acquisitions = payloads.acquisitions
					next = payloads.next
					Ok(ConstructListDefinition(payloads.stored))
		PayloadValue(variant, value):
			Ok(PayloadDefinition(variant, value))
		ListElementValue(index, value):
			Ok(ListElementDefinition(index, value))
		ListSuffixValue(value, skipped):
			borrow_argument(value, sources, enclosing, first_value, definition.span).map(
				pure func(argument): ListSuffixDefinition(argument, skipped),
			)
		FreeCallableValue(body): Ok(FreeCallableDefinition(body))
		CapturedCallableValue(body, environment):
			match store_payloads([environment], sources, enclosing, first_value, definition.span, acquisitions, next):
				Err(error): Err(error)
				Ok(payloads):
					acquisitions = payloads.acquisitions
					next = payloads.next
					match payloads.stored.get(0).to_result(internal_error(definition.span, "missing callable environment payload")):
						Err(error): Err(error)
						Ok(payload):
							Ok(CapturedCallableDefinition(body, payload))
		InvokeCallableValue(callee, written):
			match borrow_argument(callee, sources, enclosing, first_value, definition.span):
				Err(error): Err(error)
				Ok(callable):
					match borrowed_arguments(written, sources, enclosing, first_value, definition.span):
						Err(error): Err(error)
						Ok(arguments):
							Ok(InvokeCallableDefinition(callable, arguments))
		CallValue(target, written):
			borrowed_arguments(written, sources, enclosing, first_value, definition.span).map(pure func(arguments): CallDefinition(target, arguments))

	operation ?= operation_result

	ownership_result: Result[ResultOwnership, Diagnostic] = match needs_owner:
		False:
			Ok(UnmanagedResult)
		True:
			match operation:
				ParameterDefinition(_):
					Ok(BorrowedResult(ParameterBorrow(definition.id)))
				PayloadDefinition(_, source):
					Ok(BorrowedResult(PayloadBorrow(source)))
				ListElementDefinition(_, source):
					Ok(BorrowedResult(PayloadBorrow(source)))
				ReadRecordFieldDefinition(_, argument):
					parent = match argument:
						UnmanagedArgument(value):
							value
						BorrowedArgument(borrow):
							borrow.value

					Ok(BorrowedResult(PayloadBorrow(parent)))
				StringDefinition(_) | CallDefinition(_, _) | InvokeCallableDefinition(_, _) | FreeCallableDefinition(_) | CapturedCallableDefinition(_, _) | ConstructDefinition(_, _) | ConstructListDefinition(_) | ListSuffixDefinition(_, _) | ConstructRecordDefinition(_, _):
					Ok(OwnedResult(owner_id(next)))
				_:
					Err(internal_error(definition.span, "unsupported managed value operation"))

	result ?= ownership_result

	var updated_owner = match result:
		OwnedResult(_):
			IntOps.add(next, 1)
		_:
			next

	acquisition_plan: AcquisitionPlan = match operation:
		ReadRecordFieldDefinition(_, _):
			match result:
				BorrowedResult(source):
					owner = owner_id(updated_owner)
					updated_owner = IntOps.add(updated_owner, 1)
					ProjectedAcquisition({
						owner = owner,
						borrow = {
							value = definition.id,
							source = source
						},
					})
				_:
					StoredAcquisitions(acquisitions)
		_:
			StoredAcquisitions(acquisitions)

	Ok({
		definition = {
			id = definition.id,
			value_type = definition.value_type,
			operation = operation,
			result = result,
			span = definition.span
		},
		next_owner = updated_owner,
		acquisitions = acquisition_plan,
	})


private fixed record ScheduledDrop {
	owner: OwnerId,
	span: Span,
	last: Int
}


-- A block enclosing a join arm, as of that join: its values before the join
-- with their ownership.
private fixed record EnclosingBlock {
	first_value: Int,
	sources: List[ResultOwnership],
	owners: List[ScheduledDrop],
	position: Int
}


-- The nearest loop owns cleanup only inside this lexical PRE boundary.
private fixed record LoopScope {
	target: Lower.LoopTarget,
	pre_blocks: Int
}


private pure func enclosing_intervals(enclosing: List[EnclosingBlock]) -> List[ValueInterval]:
	var intervals: List[ValueInterval] = []
	for block in enclosing:
		intervals = intervals.append({ first = block.first_value, count = block.sources.length() })
	intervals


-- How a block schedules its owners' drops. A tail match's prefix keeps every
-- owner until each arm's exit, which drops it.
private fixed union DropSchedule:
	DropAtLastUse(List[Option[Int]])
	DropInEachArm


-- A pending join sees the pre-output snapshot. Its arms follow the complete
-- block's values and owners, keeping both introduction intervals consecutive.
private fixed record PendingOwnedJoin {
	join: LoweredJoin,
	scrutinee: OwnedArgument,
	result: OwnedJoinParameter,
	carried: List[OwnedJoinParameter],
	enclosing: List[EnclosingBlock],
	loop_scope: Option[LoopScope]
}


private fixed record PendingOwnedLoop {
	loop: LoweredLoop,
	result: OwnedJoinParameter,
	carried: List[OwnedJoinParameter],
	enclosing: List[EnclosingBlock]
}


-- A block's operations while it is inserted: complete ones, and joins whose
-- definitions complete_joins builds once their arms are inserted.
private fixed union InsertedEntry:
	Inserted(OwnershipOperation)
	AwaitingArms(PendingOwnedJoin)
	AwaitingLoop(PendingOwnedLoop)


private fixed record InsertedSteps {
	entries: List[InsertedEntry],
	sources: List[ResultOwnership],
	owners: List[ScheduledDrop],
	next_owner: Int
}


-- The position after which the block drops an owner made at `position`.
private pure func drop_position(
	schedule: DropSchedule,
	value_slot: Int,
	step_position: Int,
	count: Int,
	span: Span,
) -> Result[Int, Diagnostic]:
	match schedule:
		DropInEachArm: Ok(count)
		DropAtLastUse(uses):
			match uses.get(value_slot):
				Some(Some(last)): Ok(last)
				Some(None): Ok(step_position)
				None: Err(internal_error(span, "missing value-use row"))


private fixed record BuiltOutputs {
	result: OwnedJoinParameter,
	carried: List[OwnedJoinParameter],
	next_owner: Int
}


private pure func owned_join_parameter(
	parameter: ValueParameter,
	next_owner: Int,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[OwnedJoinParameter, Diagnostic]:
	needs_owner ?= value_needs_ownership(parameter.value_type, unions, records)
	match needs_owner:
		False: Ok(UnmanagedJoinParameter(parameter))
		True: Ok(ManagedJoinParameter(parameter, owner_id(next_owner)))


private pure func build_outputs(
	result_parameter: ValueParameter,
	parameters: List[ValueParameter],
	next_owner: Int,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[BuiltOutputs, Diagnostic]:
	result ?= owned_join_parameter(result_parameter, next_owner, unions, records)
	var cursor = match result:
		UnmanagedJoinParameter(_): next_owner
		ManagedJoinParameter(_, _): IntOps.add(next_owner, 1)
	var carried: List[OwnedJoinParameter] = []
	var failure: Option[Diagnostic] = None
	for parameter in parameters:
		match owned_join_parameter(parameter, cursor, unions, records):
			Err(error):
				failure = Some(error)
				break
			Ok(output):
				carried = carried.append(output)
				match output:
					UnmanagedJoinParameter(_): void
					ManagedJoinParameter(_, _): cursor = IntOps.add(cursor, 1)
	match failure:
		Some(error): Err(error)
		None: Ok({ result = result, carried = carried, next_owner = cursor })


private fixed record BuiltInputs {
	parameters: List[OwnedJoinParameter],
	next_owner: Int
}


-- Canonical inputs own separate occurrences, even when an edge supplies the
-- same borrowed value more than once.
private pure func build_inputs(
	parameters: List[ValueParameter],
	initial_owner: Int,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[BuiltInputs, Diagnostic]:
	var inputs: List[OwnedJoinParameter] = []
	var next_owner = initial_owner
	var failure: Option[Diagnostic] = None
	for parameter in parameters:
		match owned_join_parameter(parameter, next_owner, unions, records):
			Err(error):
				failure = Some(error)
				break
			Ok(input):
				inputs = inputs.append(input)
				match input:
					UnmanagedJoinParameter(_): void
					ManagedJoinParameter(_, _): next_owner = IntOps.add(next_owner, 1)
	match failure:
		Some(error): Err(error)
		None: Ok({ parameters = inputs, next_owner = next_owner })


private pure func insert_steps(
	steps: List[LoweredStep],
	schedule: DropSchedule,
	enclosing: List[EnclosingBlock],
	first_value: Int,
	initial_owner: Int,
	seed_inputs: List[OwnedJoinParameter],
	loop_scope: Option[LoopScope],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[InsertedSteps, Diagnostic]:
	count = steps.length()
	var drops = steps.map(pure func(_: LoweredStep) -> List[ScheduledDrop]: [])
	var entries: List[InsertedEntry] = []
	var sources = seed_inputs.map(join_ownership)
	var owners: List[ScheduledDrop] = []
	var next_owner = initial_owner
	var step_position: Int = 0
	var failure: Option[Diagnostic] = None

	var input_slot = 0
	for input in seed_inputs:
		match join_ownership(input):
			OwnedResult(owner):
				span = join_parameter(input).span
				match schedule:
					DropInEachArm: owners = owners.append({ owner = owner, span = span, last = count })
					DropAtLastUse(uses):
						match uses.get(input_slot):
							None: failure = Some(internal_error(span, "missing input-use row"))
							Some(None): entries = entries.append(Inserted(DropOwner(owner, span)))
							Some(Some(last)):
								owners = owners.append({ owner = owner, span = span, last = last })
								if IntOps.less_than(last, count):
									match drops.get(last):
										Some(bucket): drops = drops.set(last, bucket.append({ owner = owner, span = span, last = last }))
										None: failure = Some(internal_error(span, "invalid input last-use position"))
			_: void
		input_slot = IntOps.add(input_slot, 1)

	for step in steps:
		if failure.is_some():
			break
		value_slot = sources.length()
		span = step_span(step)
		var carried: List[OwnedJoinParameter] = []
		available_result: Result[ResultOwnership, Diagnostic] = match step:
			Join(join):
				match build_outputs(join.result, join.carried, next_owner, unions, records):
					Err(error): Err(error)
					Ok(built):
						match borrow_argument(join.selection.scrutinee, sources, enclosing, first_value, join.result.span):
							Err(error): Err(error)
							Ok(scrutinee):
								entries = entries.append(AwaitingArms({
									join = join,
									scrutinee = scrutinee,
									result = built.result,
									carried = built.carried,
									enclosing = enclosing.append({ first_value = first_value, sources = sources, owners = owners, position = step_position }),
									loop_scope = loop_scope,
								}))
								next_owner = built.next_owner
								carried = built.carried
								Ok(join_ownership(built.result))
			Loop(loop):
				match build_outputs(loop.result, loop.carried, next_owner, unions, records):
					Err(error): Err(error)
					Ok(built):
						entries = entries.append(AwaitingLoop({
							loop = loop, result = built.result, carried = built.carried,
							enclosing = enclosing.append({ first_value = first_value, sources = sources, owners = owners, position = step_position })
						}))
						next_owner = built.next_owner
						carried = built.carried
						Ok(join_ownership(built.result))
			Define(definition):
				match build_definition(definition, sources, enclosing, first_value, next_owner, unions, records):
					Err(error): Err(error)
					Ok(built):
						next_owner = built.next_owner
						-- Stored payloads are acquired before the definition; a
						-- projection's own acquisition follows it and owns its value.
						match built.acquisitions:
							StoredAcquisitions(acquired):
								for acquisition in acquired:
									entries = entries.append(Inserted(AcquireOwner(acquisition.owner, acquisition.borrow, span)))
								entries = entries.append(Inserted(DefineValue(built.definition)))
								Ok(built.definition.result)
							ProjectedAcquisition(acquired):
								entries = entries.append(Inserted(DefineValue(built.definition)))
								entries = entries.append(Inserted(AcquireOwner(acquired.owner, acquired.borrow, span)))
								Ok(OwnedResult(acquired.owner))

		match available_result:
			Err(error):
				failure = Some(error)
				break
			Ok(available):
				sources = sources.append(available)

				match available:
					OwnedResult(owner):
						match drop_position(schedule, value_slot, step_position, count, span):
							Err(error):
								failure = Some(error)
								break
							Ok(until):
								owners = owners.append({ owner = owner, span = span, last = until })
								-- A use at the block's end transfers or keeps this obligation.
								if IntOps.less_than(until, count):
									match drops.get(until):
										None:
											failure = Some(internal_error(span, "missing drop schedule row"))
											break
										Some(bucket):
											match steps.get(until):
												None:
													failure = Some(internal_error(span, "invalid last-use position"))
													break
												Some(last):
													drops = drops.set(until, bucket.append({ owner = owner, span = step_span(last), last = until }))
					_:
						void

		-- Several outputs share one execution position, but each owns a value
		-- slot and, when managed, an independently scheduled obligation.
		for output in carried:
			parameter = join_parameter(output)
			slot = sources.length()
			sources = sources.append(join_ownership(output))
			match output:
				UnmanagedJoinParameter(_): void
				ManagedJoinParameter(_, owner):
					match drop_position(schedule, slot, step_position, count, parameter.span):
						Err(error): failure = Some(error)
						Ok(until):
							owners = owners.append({ owner = owner, span = parameter.span, last = until })
							if IntOps.less_than(until, count):
								match drops.get(until):
									None: failure = Some(internal_error(parameter.span, "missing drop schedule row"))
									Some(bucket):
										match steps.get(until):
											Some(last): drops = drops.set(until, bucket.append({ owner = owner, span = step_span(last), last = until }))
											None: failure = Some(internal_error(parameter.span, "invalid last-use position"))
			if failure.is_some():
				break
		if failure.is_some():
			break

		match drops.get(step_position):
			Some(bucket):
				for dropped in bucket:
					entries = entries.append(Inserted(DropOwner(dropped.owner, dropped.span)))
			None:
				failure = Some(internal_error(span, "missing drop schedule row"))
				break

		step_position = IntOps.add(step_position, 1)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({
				entries = entries,
				sources = sources,
				owners = owners,
				next_owner = next_owner,
			})


-- How a managed value leaves its block on a return or yield edge: an owner
-- it already holds, or one acquired from its borrow now.
private fixed record LeavingValue {
	entries: List[InsertedEntry],
	transfer: ReturnTransfer,
	next_owner: Int
}


-- Loop outputs and multiple join outputs acquire before their sources retire.
private pure func borrowed_result(source: ResultOwnership) -> ResultOwnership:
	match source:
		OwnedResult(owner): BorrowedResult(OwnerBorrow(owner))
		_: source


private pure func leave_with(
	value: ValueId,
	source: ResultOwnership,
	entries: List[InsertedEntry],
	next_owner: Int,
	span: Span,
) -> LeavingValue:
	match source:
		UnmanagedResult:
			{ entries = entries, transfer = UnmanagedReturn(value), next_owner = next_owner }
		OwnedResult(owner):
			{ entries = entries, transfer = OwnedReturn(value, owner), next_owner = next_owner }
		BorrowedResult(borrow):
			owner = owner_id(next_owner)
			{
				entries = entries.append(Inserted(AcquireOwner(owner, { value = value, source = borrow }, span))),
				transfer = OwnedReturn(value, owner),
				next_owner = IntOps.add(next_owner, 1),
			}




private fixed record InsertedSelectionEdge {
	edge: OwnedSelectionEdge,
	next_value: Int,
	next_owner: Int
}


-- Selection borrows enclosing values. Only newly acquired occurrences cross
-- the successful edge, so the complete enclosing owner snapshot stays live.
private pure func selection_value(definition: Lower.SelectionDefinition) -> ValueDefinition:
	match definition:
		BorrowRecordField(parameter, field, parent):
			{ id = parameter.id, value_type = parameter.value_type, operation = ReadRecordFieldValue(field, parent), span = parameter.span }
		BorrowUnionField(parameter, field, parent):
			{ id = parameter.id, value_type = parameter.value_type, operation = PayloadValue(field, parent), span = parameter.span }
		BorrowListElement(parameter, index, parent):
			{ id = parameter.id, value_type = parameter.value_type, operation = ListElementValue(index, parent), span = parameter.span }
		CopyListSuffix(parameter, parent, skipped):
			{ id = parameter.id, value_type = parameter.value_type, operation = ListSuffixValue(parent, skipped), span = parameter.span }


private pure func insert_selection_edge(
	edge: SelectionEdge,
	enclosing: List[EnclosingBlock],
	first_value: Int,
	initial_owner: Int,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[InsertedSelectionEdge, Diagnostic]:
	var sources: List[ResultOwnership] = []
	var operations: List[OwnershipOperation] = []
	var next_owner = initial_owner
	var failure: Option[Diagnostic] = None
	for definition in edge.definitions:
		lowered = selection_value(definition)
		match build_definition(lowered, sources, enclosing, first_value, next_owner, unions, records):
			Err(error):
				failure = Some(error)
				break
			Ok(built):
				match built.acquisitions:
					StoredAcquisitions(acquisitions):
						for acquired in acquisitions:
							operations = operations.append(AcquireOwner(acquired.owner, acquired.borrow, lowered.span))
						operations = operations.append(DefineValue(built.definition))
						sources = sources.append(built.definition.result)
					ProjectedAcquisition(acquired):
						operations = operations.append(DefineValue(built.definition))
						operations = operations.append(AcquireOwner(acquired.owner, acquired.borrow, lowered.span))
						sources = sources.append(OwnedResult(acquired.owner))
				next_owner = built.next_owner
	var transfers: List[ReturnTransfer] = []
	var moved: List[Int] = []
	for value in edge.arguments:
		if failure.is_some():
			break
		match value_source(value, sources, enclosing, first_value, internal_span()):
			Err(error): failure = Some(error)
			Ok(source):
				transferred_source = match source:
					OwnedResult(owner):
						if in_interval(value_number(value), first_value, sources.length()):
							if moved.contains(owner_number(owner)):
								borrowed_result(source)
							else:
								moved = moved.append(owner_number(owner))
								source
						else:
							borrowed_result(source)
					_: source
				leaving = leave_with(value, transferred_source, [], next_owner, internal_span())
				for entry in leaving.entries:
					match entry:
						Inserted(operation): operations = operations.append(operation)
						_: failure = Some(internal_error(internal_span(), "selection edge contains control flow"))
				transfers = transfers.append(leaving.transfer)
				next_owner = leaving.next_owner
	-- Fresh suffix roots and acquired record projections that are not transferred
	-- retire locally. Source wildcards never create a projection or acquisition.
	for source in sources:
		match source:
			OwnedResult(owner):
				if moved.contains(owner_number(owner)):
					void
				else:
					operations = operations.append(DropOwner(owner, internal_span()))
			_: void
	match failure:
		Some(error): Err(error)
		None: Ok({
			edge = { arm = edge.arm, operations = operations, transfers = transfers },
			next_value = IntOps.add(first_value, sources.length()),
			next_owner = next_owner,
		})


private fixed record InsertedSelection {
	selection: OwnedSelection,
	next_value: Int,
	next_owner: Int
}


private pure func insert_selection(
	selection: LoweredSelection,
	scrutinee: OwnedArgument,
	enclosing: List[EnclosingBlock],
	first_value: Int,
	initial_owner: Int,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[InsertedSelection, Diagnostic]:
	var nodes: List[OwnedDecisionNode] = []
	var next_value = first_value
	var next_owner = initial_owner
	var failure: Option[Diagnostic] = None
	for node in selection.nodes:
		match node:
			Lower.TestVariant(place, variant, yes, no):
				nodes = nodes.append(TestVariant(place, variant, yes, no))
			Lower.TestListLength(place, test, yes, no):
				nodes = nodes.append(TestListLength(place, test, yes, no))
			Lower.TestStringBytes(place, bytes, yes, no):
				nodes = nodes.append(TestStringBytes(place, bytes, yes, no))
			Lower.EnterArm(edge):
				match insert_selection_edge(edge, enclosing, next_value, next_owner, unions, records):
					Err(error):
						failure = Some(error)
						break
					Ok(inserted):
						nodes = nodes.append(EnterArm(inserted.edge))
						next_value = inserted.next_value
						next_owner = inserted.next_owner
	match failure:
		Some(error): Err(error)
		None: Ok({
			selection = { scrutinee = scrutinee, nodes = nodes, entry = selection.entry },
			next_value = next_value, next_owner = next_owner,
		})


private fixed record InsertedJoinArm {
	arm: OwnedJoinArm,
	next_owner: Int,
	next_value: Int
}


private fixed record LeavingJoin {
	entries: List[InsertedEntry],
	transfer: ReturnTransfer,
	carried: List[ReturnTransfer],
	next_owner: Int
}


-- Multiple outgoing occurrences each acquire an independent obligation. Only
-- after every acquisition may terminal-live arm-local sources retire. Sources
-- already dropped by insert_steps, and all enclosing owners, remain untouched.
private pure func retire_terminal_sources(
	entries: List[InsertedEntry],
	sources: List[ResultOwnership],
	uses: List[Option[Int]],
	position: Int,
	span: Span,
) -> Result[List[InsertedEntry], Diagnostic]:
	var retired = entries
	var slot = 0
	var failure: Option[Diagnostic] = None
	for source in sources:
		match uses.get(slot):
			None:
				failure = Some(internal_error(span, "missing value-use row"))
				break
			Some(last_use):
				match source:
					OwnedResult(owner):
						match last_use:
							Some(last):
								if IntOps.equals(last, position):
									retired = retired.append(Inserted(DropOwner(owner, span)))
							_: void
					_: void
		slot = IntOps.add(slot, 1)
	match failure:
		Some(error): Err(error)
		None: Ok(retired)


private pure func leave_join(
	outputs: Lower.JoinOutputs,
	step_count: Int,
	parameters: List[ValueParameter],
	inserted: InsertedSteps,
	uses: List[Option[Int]],
	enclosing: List[EnclosingBlock],
	first_value: Int,
	span: Span,
) -> Result[LeavingJoin, Diagnostic]:
	result_source ?= value_source(outputs.value, inserted.sources, enclosing, first_value, span)
	moved = match result_source:
		OwnedResult(owner):
			movable = if outputs.carried.is_empty():
				in_interval(value_number(outputs.value), first_value, inserted.sources.length())
			else:
				False
			if movable:
				result_source
			else:
				borrowed_result(result_source)
		_: result_source
	leaving = leave_with(outputs.value, moved, inserted.entries, inserted.next_owner, span)
	var entries = leaving.entries
	var next_owner = leaving.next_owner
	var carried: List[ReturnTransfer] = []
	var position = 0
	var failure: Option[Diagnostic] = None
	for parameter in parameters:
		match outputs.carried.get(position):
			None: failure = Some(internal_error(span, "join arm carries the wrong number of values"))
			Some(value):
				match value_source(value, inserted.sources, enclosing, first_value, parameter.span):
					Err(error): failure = Some(error)
					Ok(carrier_source):
						borrowed = borrowed_result(carrier_source)
						left = leave_with(value, borrowed, entries, next_owner, parameter.span)
						entries = left.entries
						next_owner = left.next_owner
						carried = carried.append(left.transfer)
		if failure.is_some():
			break
		position = IntOps.add(position, 1)
	ready: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	retired: List[InsertedEntry] ?= if outputs.carried.is_empty():
		Ok(entries)
	else:
		retire_terminal_sources(entries, inserted.sources, uses, step_count, span)

	match failure:
		Some(error): Err(error)
		None:
			Ok({
				entries = retired,
				transfer = leaving.transfer,
				carried = carried,
				next_owner = next_owner,
			})


private pure func join_terminal_span(arm: JoinArm, result: ValueId, outer: List[ValueInterval]) -> Result[Span, Diagnostic]:
	var input_span: Option[Span] = None
	for parameter in arm.inputs:
		if IntOps.equals(value_number(parameter.id), value_number(result)):
			input_span = Some(parameter.span)
			break
	match input_span:
		Some(span): Ok(span)
		None: terminal_span(arm.steps, result, outer)


private pure func insert_yielding_arm(
	arm: JoinArm,
	outputs: Lower.JoinOutputs,
	parameters: List[ValueParameter],
	result_span: Span,
	enclosing: List[EnclosingBlock],
	loop_scope: Option[LoopScope],
	first_value: Int,
	inputs: BuiltInputs,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[InsertedJoinArm, Diagnostic]:
	admitted: Void ?= if IntOps.equals(outputs.carried.length(), parameters.length()):
		Ok(void)
	else:
		Err(internal_error(result_span, "join arm carries the wrong number of values"))
	outer = enclosing_intervals(enclosing)
	span ?= join_terminal_span(arm, outputs.value, outer)
	terminal: BlockTerminal = TerminalJoin(outputs.value, outputs.carried, parameters)
	uses ?= block_uses(arm.steps, terminal, outer, first_value, arm.inputs.length(), Ok(span))
	inserted ?= insert_steps(arm.steps, DropAtLastUse(uses), enclosing, first_value, inputs.next_owner, inputs.parameters, loop_scope, unions, records)
	leaving ?= leave_join(outputs, arm.steps.length(), parameters, inserted, uses, enclosing, first_value, span)
	completed ?= complete_joins(leaving.entries, IntOps.add(first_value, inserted.sources.length()), leaving.next_owner, unions, records)
	Ok({
		arm = { id = arm.id, inputs = inputs.parameters, operations = completed.operations, exit = Yield({ transfer = leaving.transfer, carried = leaving.carried }) },
		next_owner = completed.next_owner, next_value = completed.next_value,
	})


private pure func insert_abrupt_arm(
	arm: JoinArm,
	target: Lower.LoopTarget,
	tail: Lower.LoopTail,
	result_span: Span,
	enclosing: List[EnclosingBlock],
	loop_scope: Option[LoopScope],
	first_value: Int,
	inputs: BuiltInputs,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[InsertedJoinArm, Diagnostic]:
	scope ?= require_loop_scope(loop_scope, target, result_span)
	body ?= insert_loop_block({ steps = arm.steps, tail = tail }, inputs.parameters, 0, enclosing, scope, first_value, inputs.next_owner, result_span, unions, records)
	Ok({
		arm = { id = arm.id, inputs = inputs.parameters, operations = body.body.operations, exit = TransferLoop(target, body.body.tail) },
		next_owner = body.next_owner, next_value = body.next_value,
	})


private pure func insert_join_arm(
	arm: JoinArm,
	parameters: List[ValueParameter],
	result_span: Span,
	enclosing: List[EnclosingBlock],
	loop_scope: Option[LoopScope],
	first_value: Int,
	initial_owner: Int,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[InsertedJoinArm, Diagnostic]:
	inputs ?= build_inputs(arm.inputs, initial_owner, unions, records)
	match arm.exit:
		Lower.Yield(outputs): insert_yielding_arm(arm, outputs, parameters, result_span, enclosing, loop_scope, first_value, inputs, unions, records)
		Lower.TransferLoop(target, tail): insert_abrupt_arm(arm, target, tail, result_span, enclosing, loop_scope, first_value, inputs, unions, records)


private fixed record CompletedOwnedJoin {
	join: OwnedJoin,
	next_value: Int,
	next_owner: Int
}


private pure func complete_pending_join(
	pending: PendingOwnedJoin,
	first_value: Int,
	initial_owner: Int,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[CompletedOwnedJoin, Diagnostic]:
	selected ?= insert_selection(pending.join.selection, pending.scrutinee, pending.enclosing, first_value, initial_owner, unions, records)
	var next_value = selected.next_value
	var next_owner = selected.next_owner
	var arms: List[OwnedJoinArm] = []
	var failure: Option[Diagnostic] = None
	for arm in pending.join.arms:
		match insert_join_arm(arm, pending.join.carried, pending.join.result.span, pending.enclosing, pending.loop_scope, next_value, next_owner, unions, records):
			Err(error):
				failure = Some(error)
				break
			Ok(inserted):
				arms = arms.append(inserted.arm)
				next_value = inserted.next_value
				next_owner = inserted.next_owner
	match failure:
		Some(error): Err(error)
		None: Ok({
			join = { result = pending.result, carried = pending.carried, selection = selected.selection, arms = arms },
			next_value = next_value, next_owner = next_owner,
		})


private fixed record CompletedJoins {
	operations: List[OwnershipOperation],
	next_owner: Int,
	next_value: Int
}


-- Builds each join's definition once its block is complete: its arms are
-- inserted after the block's own values and owners: selection edges first,
-- then canonical inputs and ordinary arm bodies in arm order.
private pure func complete_joins(
	entries: List[InsertedEntry],
	first_value: Int,
	first_owner: Int,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[CompletedJoins, Diagnostic]:
	var operations: List[OwnershipOperation] = []
	var next_value = first_value
	var next_owner = first_owner
	var failure: Option[Diagnostic] = None
	for entry in entries:
		match entry:
			Inserted(operation):
				operations = operations.append(operation)
			AwaitingLoop(pending):
				match insert_loop(pending.loop, pending.enclosing, next_value, next_owner, unions, records):
					Err(error):
						failure = Some(error)
						break
					Ok(built):
						operations = operations.append(ExecuteLoop({ entry_acquisitions = built.acquisitions, headers = built.headers, result = pending.result, carried = pending.carried, body = built.body }))
						next_value = built.next_value
						next_owner = built.next_owner
			AwaitingArms(join):
				match complete_pending_join(join, next_value, next_owner, unions, records):
					Err(error):
						failure = Some(error)
						break
					Ok(completed):
						operations = operations.append(ExecuteJoin(completed.join))
						next_value = completed.next_value
						next_owner = completed.next_owner
	match failure:
		Some(error): Err(error)
		None: Ok({ operations = operations, next_owner = next_owner, next_value = next_value })


private fixed record InsertedLoopBlock {
	body: OwnedLoopBlock,
	next_value: Int,
	next_owner: Int
}


private fixed record InsertedLoop {
	acquisitions: List[OwnerAcquisition],
	headers: List[OwnedLoopHeader],
	body: OwnedLoopBlock,
	next_value: Int,
	next_owner: Int
}


private fixed record LoopEdgeEntries {
	entries: List[InsertedEntry],
	exit: OwnedLoopExit,
	next_owner: Int
}


private pure func loop_exit_values(exit: LoopExit) -> List[ValueId]:
	match exit:
		Lower.Recur(arguments, _): arguments
		Lower.Break(outputs): [outputs.value].concat(outputs.carried)


private pure func loop_exit_span(exit: LoopExit) -> Span:
	match exit:
		Lower.Recur(_, span): span
		Lower.Break(outputs): outputs.span


private pure func require_loop_scope(scope: Option[LoopScope], target: Lower.LoopTarget, span: Span) -> Result[LoopScope, Diagnostic]:
	match scope:
		None: Err(internal_error(span, "loop transfer has no active loop"))
		Some(active):
			if IntOps.equals(value_number(Lower.loop_target_value(active.target)), value_number(Lower.loop_target_value(target))):
				Ok(active)
			else:
				Err(internal_error(span, "loop transfer does not target the nearest loop"))


-- Scheduling records are frozen at the exact occurrence. Earlier drops are
-- excluded without walking or reconstructing the enclosing source body.
private pure func retire_live(
	entries: List[InsertedEntry], owners: List[ScheduledDrop], position: Int,
) -> List[InsertedEntry]:
	var retired = entries
	for owner in owners:
		if IntOps.greater_than_or_equal(owner.last, position):
			retired = retired.append(Inserted(DropOwner(owner.owner, owner.span)))
	retired


private pure func leave_loop(
	exit: LoopExit,
	inserted: InsertedSteps,
	enclosing: List[EnclosingBlock],
	scope: LoopScope,
	first_value: Int,
	position: Int,
) -> Result[LoopEdgeEntries, Diagnostic]:
	span = loop_exit_span(exit)
	var entries = inserted.entries
	var next_owner = inserted.next_owner
	var transfers: List[ReturnTransfer] = []
	var failure: Option[Diagnostic] = None
	for value in loop_exit_values(exit):
		match value_source(value, inserted.sources, enclosing, first_value, span):
			Err(error):
				failure = Some(error)
				break
			Ok(source):
				leaving = leave_with(value, borrowed_result(source), entries, next_owner, span)
				entries = leaving.entries
				next_owner = leaving.next_owner
				transfers = transfers.append(leaving.transfer)
	ready: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	entries = retire_live(entries, inserted.owners, position)
	var ordinal = 0
	for block in enclosing:
		if IntOps.greater_than_or_equal(ordinal, scope.pre_blocks):
			entries = retire_live(entries, block.owners, block.position)
		ordinal = IntOps.add(ordinal, 1)
	owned_exit: OwnedLoopExit ?= match exit:
		Lower.Recur(_, occurrence): Ok(Recur(transfers, occurrence))
		Lower.Break(outputs):
			match transfers:
				[first, ...carried]: Ok(Break({ value = first, carried = carried, span = outputs.span }))
				[]: Err(internal_error(span, "missing loop result transfer"))
	Ok({ entries = entries, exit = owned_exit, next_owner = next_owner })


private pure func insert_loop_exit_block(
	steps: List[LoweredStep],
	exit: LoopExit,
	seed_inputs: List[OwnedJoinParameter],
	held_headers: Int,
	enclosing: List[EnclosingBlock],
	scope: LoopScope,
	first_value: Int,
	initial_owner: Int,
	span: Span,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[InsertedLoopBlock, Diagnostic]:
	uses ?= block_uses(steps, TerminalArguments(loop_exit_values(exit), loop_exit_span(exit)), enclosing_intervals(enclosing), first_value, seed_inputs.length(), Ok(span))
	-- Header obligations survive until the complete edge batch, including
	-- old values that are not outgoing. Arm inputs keep last-use scheduling.
	var held_uses = uses
	var input_slot = 0
	while IntOps.less_than(input_slot, held_headers):
		held_uses = held_uses.set(input_slot, Some(steps.length()))
		input_slot = IntOps.add(input_slot, 1)
	inserted ?= insert_steps(steps, DropAtLastUse(held_uses), enclosing, first_value, initial_owner, seed_inputs, Some(scope), unions, records)
	leaving ?= leave_loop(exit, inserted, enclosing, scope, first_value, steps.length())
	completed ?= complete_joins(leaving.entries, IntOps.add(first_value, inserted.sources.length()), leaving.next_owner, unions, records)
	Ok({ body = { operations = completed.operations, tail = ExitLoop(leaving.exit) }, next_value = completed.next_value, next_owner = completed.next_owner })


private pure func insert_loop_match_block(
	steps: List[LoweredStep],
	matched: Lower.LoopMatch,
	seed_inputs: List[OwnedJoinParameter],
	enclosing: List[EnclosingBlock],
	scope: LoopScope,
	first_value: Int,
	initial_owner: Int,
	span: Span,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[InsertedLoopBlock, Diagnostic]:
	prefix ?= insert_steps(steps, DropInEachArm, enclosing, first_value, initial_owner, seed_inputs, Some(scope), unions, records)
	scrutinee ?= borrow_argument(matched.selection.scrutinee, prefix.sources, enclosing, first_value, span)
	completed ?= complete_joins(prefix.entries, IntOps.add(first_value, prefix.sources.length()), prefix.next_owner, unions, records)
	outer: List[EnclosingBlock] = enclosing.append({ first_value = first_value, sources = prefix.sources, owners = prefix.owners, position = steps.length() })
	selected ?= insert_selection(matched.selection, scrutinee, outer, completed.next_value, completed.next_owner, unions, records)
	var next_value = selected.next_value
	var next_owner = selected.next_owner
	var arms: List[OwnedLoopArm] = []
	var failure: Option[Diagnostic] = None
	for arm in matched.arms:
		match build_inputs(arm.inputs, next_owner, unions, records):
			Err(error): failure = Some(error)
			Ok(inputs):
				match insert_loop_block(arm.body, inputs.parameters, 0, outer, scope, next_value, inputs.next_owner, span, unions, records):
					Err(error): failure = Some(error)
					Ok(built):
						arms = arms.append({ id = arm.id, inputs = inputs.parameters, body = built.body })
						next_value = built.next_value
						next_owner = built.next_owner
		if failure.is_some():
			break
	match failure:
		Some(error): Err(error)
		None: Ok({ body = { operations = completed.operations, tail = MatchLoop({ selection = selected.selection, arms = arms }) }, next_value = next_value, next_owner = next_owner })


private pure func insert_loop_block(
	block: Lower.LoopBlock,
	seed_inputs: List[OwnedJoinParameter],
	held_headers: Int,
	enclosing: List[EnclosingBlock],
	scope: LoopScope,
	first_value: Int,
	initial_owner: Int,
	span: Span,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[InsertedLoopBlock, Diagnostic]:
	match block.tail:
		Lower.ExitLoop(exit): insert_loop_exit_block(block.steps, exit, seed_inputs, held_headers, enclosing, scope, first_value, initial_owner, span, unions, records)
		Lower.MatchLoop(matched): insert_loop_match_block(block.steps, matched, seed_inputs, enclosing, scope, first_value, initial_owner, span, unions, records)


private pure func insert_loop(
	loop: LoweredLoop,
	enclosing: List[EnclosingBlock],
	first_value: Int,
	initial_owner: Int,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[InsertedLoop, Diagnostic]:
	var acquisitions: List[OwnerAcquisition] = []
	var initials: List[ReturnTransfer] = []
	var next_owner = initial_owner
	var failure: Option[Diagnostic] = None
	for header in loop.headers:
		match value_source(header.initial, [], enclosing, first_value, header.parameter.span):
			Err(error): failure = Some(error)
			Ok(source):
				left = leave_with(header.initial, borrowed_result(source), [], next_owner, header.parameter.span)
				for entry in left.entries:
					match entry:
						Inserted(AcquireOwner(owner, borrow, _)): acquisitions = acquisitions.append({ owner = owner, borrow = borrow })
						_: failure = Some(internal_error(header.parameter.span, "loop entry contains a non-acquisition operation"))
				initials = initials.append(left.transfer)
				next_owner = left.next_owner
		if failure.is_some():
			break
	ready: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	inputs ?= build_inputs(loop.headers.map(pure func(header): header.parameter), next_owner, unions, records)
	var headers: List[OwnedLoopHeader] = []
	var position = 0
	for parameter in inputs.parameters:
		match initials.get(position):
			None: failure = Some(internal_error(join_parameter(parameter).span, "missing loop initial transfer"))
			Some(initial): headers = headers.append({ parameter = parameter, initial = initial })
		position = IntOps.add(position, 1)
	headers_ready: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	scope: LoopScope = { target = Lower.loop_target(loop.result.id), pre_blocks = enclosing.length() }
	body ?= insert_loop_block(loop.body, inputs.parameters, loop.headers.length(), enclosing, scope, first_value, inputs.next_owner, loop.result.span, unions, records)
	Ok({ acquisitions = acquisitions, headers = headers, body = body.body, next_value = body.next_value, next_owner = body.next_owner })


pure func insert_function(
	function: LoweredFunction,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[OwnedFunction, Diagnostic]:
	span ?= terminal_span(function.steps, function.result, [])
	uses ?= block_uses(function.steps, TerminalValue(function.result), [], 0, 0, Ok(span))
	inserted ?= insert_steps(function.steps, DropAtLastUse(uses), [], 0, 0, [], None, unions, records)
	source ?= value_source(function.result, inserted.sources, [], 0, span)
	leaving = leave_with(function.result, source, inserted.entries, inserted.next_owner, span)
	completed ?= complete_joins(leaving.entries, inserted.sources.length(), leaving.next_owner, unions, records)
	Ok({ signature = function.signature, operations = completed.operations, result = leaving.transfer })


pure func own(program: LoweredProgram) -> Result[OwnershipProgram, Diagnostic]:
	contents = lowered_functions(program)
	var functions: List[OwnedFunction] = []
	var failure: Option[Diagnostic] = None

	for function in contents.functions:
		match insert_function(function, contents.unions, contents.records):
			Ok(owned):
				functions = functions.append(owned)
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({
				records = contents.records,
				unions = contents.unions,
				functions = functions,
				entrypoint = contents.entrypoint,
			})
