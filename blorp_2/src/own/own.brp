import:
	../namespace/builtins: reuses_first_operand
	result: Result methods
	../check/model: MatchArmId, DecisionNodeId, ListLengthTest, match_arm_number
	bool: not, and, or
	int: Int methods
	list: repeat, List methods
	../lower/lower as Lower:
		JoinArm,
		LoopExit,
		LoweredLoop,
		LoweredFunction,
		LoweredJoin,
		LoweredFunctions,
		LoweredProgram,
		LoweredStep(Define, Join, Loop),
		LoweredSelection,
		SelectionEdge,
		SelectionDefinition(BorrowUnionField, BorrowRecordField, BorrowListElement, CopyListSuffix),
		ValueDefinition,
		ValueId,
		ValueParameter,
		ValueOperation(
			ParameterValue, VoidValue, IntegerValue, FloatValue, StringValue,
			CallValue, InvokeCallableValue, FreeCallableValue, CapturedCallableValue, ConstructValue, ConstructListValue, PayloadValue, ListElementValue, ListSuffixValue, ConstructRecordValue, ReadRecordFieldValue,
		),
		lowered_functions,
		block_value_count, step_reads, step_span, step_value_count, value_span,
		value_number,
	option: Option methods
	../utils/source: compiler_source, FunctionLabel
	../specialize/specialize:
		CallTarget(RuntimeFunction, UserFunction),
		ConcretePatternPlace,
		ConcreteRecord,
		ConcreteUnion,
		FieldInstanceId,
		FunctionInstanceId,
		RecordInstanceId,
		TypeRef,
		VariantInstanceId, VariantFieldInstanceId,
		function_number,
		value_needs_ownership,
	../utils/syntax: Diagnostic, Entrypoint, Span, entry_function, internal_error
	../utils/text: concat


-- This identity names an obligation in an unverified function body. Only the
-- independent verifier establishes its membership, lifetime and uniqueness.
opaque type OwnerId = Int


pure func owner_id(ordinal: Int) -> OwnerId:
	into_opaque OwnerId(ordinal)


pure func owner_number(id: OwnerId) -> Int:
	from_opaque OwnerId(id)


union BorrowSource:
	ParameterBorrow(ValueId)
	OwnerBorrow(OwnerId)
	PayloadBorrow(ValueId)


record BorrowedValue {
	value: ValueId,
	source: BorrowSource
}


union OwnedArgument:
	UnmanagedArgument(ValueId)
	BorrowedArgument(BorrowedValue)
	ConsumedArgument(ValueId, OwnerId)


union ResultOwnership:
	UnmanagedResult
	BorrowedResult(BorrowSource)
	OwnedResult(OwnerId)


union StoredPayload:
	UnmanagedPayload(ValueId)
	OwnedPayload(ValueId, OwnerId)


record OwnedRecordField {
	field: FieldInstanceId,
	value: StoredPayload
}


union OwnedValueOperation:
	ConstructRecordDefinition(RecordInstanceId, List[OwnedRecordField])
	ReadRecordFieldDefinition(FieldInstanceId, OwnedArgument)
	ParameterDefinition(Int)
	VoidDefinition
	IntegerDefinition(Int)
	FloatDefinition(Float)
	StringDefinition(String)
	CallDefinition(CallTarget, List[OwnedArgument])
	InvokeCallableDefinition(OwnedArgument, List[OwnedArgument])
	FreeCallableDefinition(FunctionInstanceId)
	CapturedCallableDefinition(FunctionInstanceId, StoredPayload)
	ConstructDefinition(VariantInstanceId, List[StoredPayload])
	ConstructListDefinition(List[StoredPayload])
	PayloadDefinition(VariantFieldInstanceId, ValueId)
	ListElementDefinition(Int, ValueId)
	ListSuffixDefinition(OwnedArgument, Int)


record OwnedDefinition {
	id: ValueId,
	value_type: TypeRef,
	operation: OwnedValueOperation,
	result: ResultOwnership,
	span: Span
}


union OwnershipOperation:
	DefineValue(OwnedDefinition)
	ExecuteJoin(OwnedJoin)
	ExecuteLoop(OwnedLoop)
	AcquireOwner(OwnerId, BorrowedValue, Span)
	DropOwner(OwnerId, Span)


-- A value leaving its block on a return or yield edge, with the owner a
-- managed value moves.
union ReturnTransfer:
	UnmanagedReturn(ValueId)
	OwnedReturn(ValueId, OwnerId)


record OwnedJoinOutputs {
	transfer: ReturnTransfer,
	carried: List[ReturnTransfer]
}


union OwnedJoinExit:
	Yield(OwnedJoinOutputs)
	TransferLoop(Lower.LoopTarget, OwnedLoopTail)


-- Only yielding arms move values into the join's continuation.
record OwnedJoinArm {
	id: MatchArmId,
	inputs: List[OwnedJoinParameter],
	operations: List[OwnershipOperation],
	exit: OwnedJoinExit
}


union OwnedJoinParameter:
	UnmanagedJoinParameter(ValueParameter)
	ManagedJoinParameter(ValueParameter, OwnerId)


pure func join_parameter(output: OwnedJoinParameter) -> ValueParameter:
	match output:
		UnmanagedJoinParameter(parameter): parameter
		ManagedJoinParameter(parameter, _): parameter


pure func join_ownership(output: OwnedJoinParameter) -> ResultOwnership:
	match output:
		UnmanagedJoinParameter(_): UnmanagedResult
		ManagedJoinParameter(_, owner): OwnedResult(owner)


-- Selection edges follow their enclosing block in decision-node order;
-- canonical arm inputs then precede ordinary arm values and nested controls.
record OwnedJoin {
	result: OwnedJoinParameter,
	carried: List[OwnedJoinParameter],
	-- Obligations whose last enclosing use is this join; every yielding arm
	-- discharges each exactly once, and abrupt arms retire them at the edge.
	entering: List[OwnerId],
	selection: OwnedSelection,
	arms: List[OwnedJoinArm]
}


record OwnedLoopOutputs {
	value: ReturnTransfer,
	carried: List[ReturnTransfer],
	span: Span
}


union OwnedLoopExit:
	Break(OwnedLoopOutputs)
	Recur(List[ReturnTransfer], Span)


record OwnedSelectionEdge {
	arm: MatchArmId,
	operations: List[OwnershipOperation],
	transfers: List[ReturnTransfer]
}


union OwnedDecisionNode:
	TestVariant(ConcretePatternPlace, VariantInstanceId, DecisionNodeId, DecisionNodeId)
	TestListLength(ConcretePatternPlace, ListLengthTest, DecisionNodeId, DecisionNodeId)
	TestStringBytes(ConcretePatternPlace, String, DecisionNodeId, DecisionNodeId)
	EnterArm(OwnedSelectionEdge)


record OwnedSelection {
	scrutinee: OwnedArgument,
	nodes: List[OwnedDecisionNode],
	entry: DecisionNodeId
}


record OwnedLoopArm {
	id: MatchArmId,
	inputs: List[OwnedJoinParameter],
	body: OwnedLoopBlock
}


record OwnedLoopMatch {
	selection: OwnedSelection,
	arms: List[OwnedLoopArm]
}

union OwnedLoopTail:
	ExitLoop(OwnedLoopExit)
	MatchLoop(OwnedLoopMatch)


record OwnedLoopBlock {
	operations: List[OwnershipOperation],
	tail: OwnedLoopTail
}


record OwnedLoopHeader {
	parameter: OwnedJoinParameter,
	initial: ReturnTransfer
}


record OwnedLoop {
	entry_acquisitions: List[OwnerAcquisition],
	headers: List[OwnedLoopHeader],
	result: OwnedJoinParameter,
	carried: List[OwnedJoinParameter],
	body: OwnedLoopBlock
}


-- How the ownership stage passes one managed parameter.
record ManagedPassing {
	value_type: TypeRef,
	-- The caller transfers one obligation; the callee discharges it.
	owned: Bool
}


-- A function's parameter as the ownership stage passes it. These rows replace
-- the specialization signature's parameters, so a caller reads one contract.
union OwnedParameter:
	UnmanagedParameter(TypeRef)
	ManagedParameter(ManagedPassing)


pure func parameter_type(parameter: OwnedParameter) -> TypeRef:
	match parameter:
		UnmanagedParameter(value_type): value_type
		ManagedParameter(passing): passing.value_type


pure func parameter_owned(parameter: OwnedParameter) -> Bool:
	match parameter:
		UnmanagedParameter(_): False
		ManagedParameter(passing): passing.owned


record OwnedFunction {
	label: FunctionLabel,
	parameters: List[OwnedParameter],
	return_type: TypeRef,
	operations: List[OwnershipOperation],
	result: ReturnTransfer
}


record OwnershipProgram {
	records: List[ConcreteRecord],
	unions: List[ConcreteUnion],
	functions: List[OwnedFunction],
	entrypoint: Entrypoint[FunctionInstanceId]
}


-- Insertion errors with no source occurrence carry this compiler span.
private pure func internal_span() -> Span:
	{
		source = compiler_source(),
		start = 0,
		end = 0
	}


-- Values of enclosing blocks that a block may read: each a consecutive
-- interval of one enclosing block's values before the nested arm.
private fixed record ValueInterval {
	first: Int,
	count: Int
}


private pure func in_interval(ordinal: Int, first: Int, count: Int) -> Bool:
	match ordinal.greater_than_or_equal(first):
		False: False
		True: ordinal.less_than(first.add(count))


private pure func visible_outside(ordinal: Int, outer: List[ValueInterval]) -> Bool:
	var visible: Bool = False
	for interval in outer:
		if in_interval(ordinal, interval.first, interval.count):
			visible = True
			break
	visible


-- Last-use positions belong to this block; ValueIds remain function-wide.
-- Enclosing values are visible, but earlier sibling ordinals are not.
private pure func use_slot(
	value: ValueId,
	introduced_count: Int,
	outer: List[ValueInterval],
	first_value: Int,
	slot_count: Int,
	span: Span,
) -> Result[Option[Int], Diagnostic]:
	ordinal = value_number(value)

	if visible_outside(ordinal, outer):
		Ok(None)
	else if in_interval(ordinal, first_value, introduced_count):
		index = ordinal.subtract(first_value)

		if in_interval(index, 0, slot_count):
			Ok(Some(index))
		else:
			Err(internal_error(span, "invalid value identity in ownership use analysis"))
	else:
		Err(internal_error(span, "invalid value identity in ownership use analysis"))


-- The span a block's terminal use reports: its local operand's definition.
private pure func terminal_span(
	steps: List[LoweredStep],
	result: ValueId,
	outer: List[ValueInterval],
) -> Result[Span, Diagnostic]:
	if visible_outside(value_number(result), outer):
		Ok(internal_span())
	else:
		match value_span(steps, result):
			Some(span): Ok(span)
			None: Err(internal_error(internal_span(), "invalid return value in ownership use analysis"))


-- A terminal reads one returned value, shared-span backedge arguments, or a
-- join result and ordered carriers with their existing parameter origins.
private union BlockTerminal:
	TerminalValue(ValueId)
	TerminalArguments(List[ValueId], Span)
	TerminalJoin(ValueId, List[ValueId], List[ValueParameter])


-- Each definition's last use in this block, at the position of its last
-- reader; the terminal operands are read at the synthetic position after
-- the last definition.
private pure func block_uses(
	steps: List[LoweredStep],
	terminal: BlockTerminal,
	outer: List[ValueInterval],
	first_value: Int,
	seed_count: Int,
	span_result: Result[Span, Diagnostic],
) -> Result[List[Option[Int]], Diagnostic]:
	unused: Option[Int] = None
	var uses = repeat(unused, seed_count.add(block_value_count(steps)))
	var step_position: Int = 0
	var introduced_count: Int = seed_count
	var failure: Option[Diagnostic] = None

	for step in steps:
		span = step_span(step)
		first = match step:
			Define(definition): definition.id
			Join(join): join.result.id
			Loop(loop): loop.result.id
		if value_number(first) != first_value.add(introduced_count):
			failure = Some(internal_error(span, "nonconsecutive value identity in ownership use analysis"))
		else:
			carried: List[ValueParameter] = match step:
				Define(_): []
				Join(join): join.carried
				Loop(loop): loop.carried
			var ordinal = first_value.add(introduced_count).add(1)
			for parameter in carried:
				if value_number(parameter.id) != ordinal:
					failure = Some(internal_error(parameter.span, "nonconsecutive value identity in ownership use analysis"))
					break
				ordinal = ordinal.add(1)
		if failure.is_some():
			break

		-- Slot validation borrows only scalar bounds, so each write keeps the
		-- same local vector owner rather than sharing it through Result[List].
		for operand in step_reads(step):
			match use_slot(
				operand,
				introduced_count,
				outer,
				first_value,
				uses.length(),
				span,
			):
				Ok(Some(index)):
					uses = uses.set(index, Some(step_position))
				Ok(None):
					void
				Err(error):
					failure = Some(error)
					break

		if failure.is_some():
			break

		introduced_count = introduced_count.add(step_value_count(step))
		step_position = step_position.add(1)

	ready: Void ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	operands = match terminal:
		TerminalValue(result): [result]
		TerminalArguments(arguments, _): arguments
		TerminalJoin(result, _, _): [result]
	-- Resolve once at the caller, but keep operand errors ahead of a bad exit.
	span ?= span_result

	-- Start this builder inside the successful span scope. The outer snapshot
	-- may cause one initial copy; subsequent writes keep the local vector owner.
	var terminal_uses = uses
	var invalid: Option[Diagnostic] = None

	for operand in operands:
		match use_slot(
			operand,
			introduced_count,
			outer,
			first_value,
			terminal_uses.length(),
			span,
		):
			Ok(Some(index)):
				terminal_uses = terminal_uses.set(index, Some(step_position))
			Ok(None):
				void
			Err(error):
				invalid = Some(error)
				break

	match terminal:
		TerminalValue(_) | TerminalArguments(_, _): void
		TerminalJoin(_, arguments, parameters):
			var position = 0
			for parameter in parameters:
				if invalid.is_some():
					break
				match arguments.get(position):
					None: invalid = Some(internal_error(span, "join arm carries the wrong number of values"))
					Some(operand):
						match use_slot(operand, introduced_count, outer, first_value, terminal_uses.length(), parameter.span):
							Ok(slot):
								match slot:
									Some(index): terminal_uses = terminal_uses.set(index, Some(step_position))
									None: void
							Err(error): invalid = Some(error)
				position = position.add(1)

	match invalid:
		Some(error):
			Err(error)
		None:
			Ok(terminal_uses)


-- A loop edge reads every outgoing occurrence before retiring any owner.
pure func exit_last_uses(
	steps: List[LoweredStep],
	exit: LoopExit,
	prefix_count: Int,
	first_value: Int,
) -> Result[List[Option[Int]], Diagnostic]:
	outer: List[ValueInterval] = [{ first = 0, count = prefix_count }]
	terminal: BlockTerminal = match exit:
		Lower.Recur(arguments, span): TerminalArguments(arguments, span)
		Lower.Break(outputs): TerminalArguments([outputs.value].concat(outputs.carried), outputs.span)
	span = match exit:
		Lower.Recur(_, span): span
		Lower.Break(outputs): outputs.span
	block_uses(steps, terminal, outer, first_value, 0, Ok(span))


pure func block_last_uses(
	steps: List[LoweredStep],
	result: ValueId,
	prefix_count: Int,
	first_value: Int,
) -> Result[List[Option[Int]], Diagnostic]:
	outer: List[ValueInterval] = [{ first = 0, count = prefix_count }]
	block_uses(steps, TerminalValue(result), outer, first_value, 0, terminal_span(steps, result, outer))


pure func last_uses(
	steps: List[LoweredStep],
	result: ValueId,
) -> Result[List[Option[Int]], Diagnostic]:
	block_last_uses(steps, result, 0, 0)


record OwnerAcquisition {
	owner: OwnerId,
	borrow: BorrowedValue
}


private union AcquisitionPlan:
	StoredAcquisitions(List[OwnerAcquisition])
	ProjectedAcquisition(OwnerAcquisition)


private record BuiltDefinition {
	definition: OwnedDefinition,
	next_owner: Int,
	acquisitions: AcquisitionPlan
}


-- Each callee's rows, by instance number. Inserting one function on its own
-- treats every call as borrowing.
private union CalleeContracts:
	EveryCallBorrows
	InstanceRows(List[List[OwnedParameter]])


-- The contracts one insertion reads: its function's own rows and its callees'.
private record CallContracts {
	parameters: List[OwnedParameter],
	callees: CalleeContracts
}


private pure func value_source(
	value: ValueId,
	sources: List[ResultOwnership],
	enclosing: List[EnclosingBlock],
	first_value: Int,
	span: Span,
) -> Result[ResultOwnership, Diagnostic]:
	ordinal = value_number(value)
	var entry: Option[ResultOwnership] = None

	if in_interval(ordinal, first_value, sources.length()):
		entry = sources.get(ordinal.subtract(first_value))
	else:
		for block in enclosing:
			if in_interval(ordinal, block.first_value, block.sources.length()):
				entry = block.sources.get(ordinal.subtract(block.first_value))
				break

	entry.to_result(internal_error(span, "value used before definition in ownership insertion"))


private pure func borrow_argument(
	value: ValueId,
	sources: List[ResultOwnership],
	enclosing: List[EnclosingBlock],
	first_value: Int,
	span: Span,
) -> Result[OwnedArgument, Diagnostic]:
	source ?= value_source(value, sources, enclosing, first_value, span)
	argument: OwnedArgument = match source:
		UnmanagedResult:
			UnmanagedArgument(value)
		BorrowedResult(borrow_source):
			BorrowedArgument({
				value = value,
				source = borrow_source,
			})
		OwnedResult(owner):
			BorrowedArgument({
				value = value,
				source = OwnerBorrow(owner),
			})
	Ok(argument)


-- Stored payloads of a variant or a list literal. Each stored occurrence
-- acquires independently, including Pair(x, x) and [x, x]: a unary last-use
-- transfer cannot safely generalize to repeated values.
private record StoredPayloads {
	stored: List[StoredPayload],
	acquisitions: List[OwnerAcquisition],
	next: Int
}


private pure func store_payloads(
	values: List[ValueId],
	sources: List[ResultOwnership],
	enclosing: List[EnclosingBlock],
	first_value: Int,
	span: Span,
	acquisitions: List[OwnerAcquisition],
	next_owner: Int,
) -> Result[StoredPayloads, Diagnostic]:
	var stored: List[StoredPayload] = []
	var acquired = acquisitions
	var next = next_owner
	var failure: Option[Diagnostic] = None
	for value in values:
		match borrow_argument(value, sources, enclosing, first_value, span):
			Err(error):
				failure = Some(error)
				break
			Ok(ConsumedArgument(_, _)): failure = Some(internal_error(span, "stored payload cannot consume a call argument"))
			Ok(UnmanagedArgument(unmanaged_value)): stored = stored.append(UnmanagedPayload(unmanaged_value))
			Ok(BorrowedArgument(borrow)):
				child_owner = owner_id(next)
				next = next.add(1)
				acquired = acquired.append({ owner = child_owner, borrow = borrow })
				stored = stored.append(OwnedPayload(value, child_owner))
	match failure:
		Some(error): Err(error)
		None: Ok({ stored = stored, acquisitions = acquired, next = next })


private pure func borrowed_arguments(
	values: List[ValueId], sources: List[ResultOwnership], enclosing: List[EnclosingBlock],
	first_value: Int, span: Span,
) -> Result[List[OwnedArgument], Diagnostic]:
	var arguments: List[OwnedArgument] = []
	var failure: Option[Diagnostic] = None
	for value in values:
		match borrow_argument(value, sources, enclosing, first_value, span):
			Ok(argument): arguments = arguments.append(argument)
			Err(error):
				failure = Some(error)
				break
	match failure:
		Some(error): Err(error)
		None: Ok(arguments)


private pure func build_definition(
	definition: ValueDefinition,
	sources: List[ResultOwnership],
	enclosing: List[EnclosingBlock],
	first_value: Int,
	next_owner: Int,
	parameters: List[OwnedParameter],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[BuiltDefinition, Diagnostic]:
	needs_owner ?= value_needs_ownership(definition.value_type, unions, records)
	var next = next_owner
	var acquisitions: List[OwnerAcquisition] = []

	operation_result: Result[OwnedValueOperation, Diagnostic] = match definition.operation:
		ConstructRecordValue(owner, fields):
			var stored: List[OwnedRecordField] = []
			var failure: Option[Diagnostic] = None

			for field in fields:
				match borrow_argument(field.value, sources, enclosing, first_value, definition.span):
					Err(error):
						failure = Some(error)
						break
					Ok(UnmanagedArgument(value)):
						stored = stored.append({
							field = field.field,
							value = UnmanagedPayload(value),
						})
					Ok(ConsumedArgument(_, _)): failure = Some(internal_error(definition.span, "record field cannot consume a call argument"))
					Ok(BorrowedArgument(borrow)):
						child_owner = owner_id(next)
						next = next.add(1)
						acquisitions = acquisitions.append({
							owner = child_owner,
							borrow = borrow,
						})
						stored = stored.append({
							field = field.field,
							value = OwnedPayload(field.value, child_owner),
						})

			match failure:
				Some(error):
					Err(error)
				None:
					Ok(ConstructRecordDefinition(owner, stored))
		ReadRecordFieldValue(field, value):
			borrow_argument(
				value,
				sources,
				enclosing,
				first_value,
				definition.span,
			).map(
				pure func(parent): ReadRecordFieldDefinition(field, parent),
			)
		ParameterValue(index):
			Ok(ParameterDefinition(index))
		VoidValue:
			Ok(VoidDefinition)
		StringValue(bytes):
			Ok(StringDefinition(bytes))
		IntegerValue(value):
			Ok(IntegerDefinition(value))
		FloatValue(value):
			Ok(FloatDefinition(value))
		ConstructValue(id, values):
			match store_payloads(values, sources, enclosing, first_value, definition.span, acquisitions, next):
				Err(error): Err(error)
				Ok(payloads):
					acquisitions = payloads.acquisitions
					next = payloads.next
					Ok(ConstructDefinition(id, payloads.stored))
		ConstructListValue(values):
			match store_payloads(values, sources, enclosing, first_value, definition.span, acquisitions, next):
				Err(error): Err(error)
				Ok(payloads):
					acquisitions = payloads.acquisitions
					next = payloads.next
					Ok(ConstructListDefinition(payloads.stored))
		PayloadValue(variant, value):
			Ok(PayloadDefinition(variant, value))
		ListElementValue(index, value):
			Ok(ListElementDefinition(index, value))
		ListSuffixValue(value, skipped):
			borrow_argument(value, sources, enclosing, first_value, definition.span).map(
				pure func(argument): ListSuffixDefinition(argument, skipped),
			)
		FreeCallableValue(body): Ok(FreeCallableDefinition(body))
		CapturedCallableValue(body, environment):
			match store_payloads([environment], sources, enclosing, first_value, definition.span, acquisitions, next):
				Err(error): Err(error)
				Ok(payloads):
					acquisitions = payloads.acquisitions
					next = payloads.next
					match payloads.stored.get(0).to_result(internal_error(definition.span, "missing callable environment payload")):
						Err(error): Err(error)
						Ok(payload):
							Ok(CapturedCallableDefinition(body, payload))
		InvokeCallableValue(callee, written):
			match borrow_argument(callee, sources, enclosing, first_value, definition.span):
				Err(error): Err(error)
				Ok(callable):
					match borrowed_arguments(written, sources, enclosing, first_value, definition.span):
						Err(error): Err(error)
						Ok(arguments):
							Ok(InvokeCallableDefinition(callable, arguments))
		CallValue(target, written):
			borrowed_arguments(written, sources, enclosing, first_value, definition.span).map(pure func(arguments): CallDefinition(target, arguments))

	operation ?= operation_result

	ownership_result: Result[ResultOwnership, Diagnostic] = match needs_owner:
		False:
			Ok(UnmanagedResult)
		True:
			match operation:
				-- An owned parameter is an ordinary local obligation of the callee.
				ParameterDefinition(index):
					match parameters.get(index):
						Some(ManagedParameter(passing)):
							if passing.owned:
								Ok(OwnedResult(owner_id(next)))
							else:
								Ok(BorrowedResult(ParameterBorrow(definition.id)))
						_: Err(internal_error(definition.span, "managed parameter has no managed row"))
				PayloadDefinition(_, source):
					Ok(BorrowedResult(PayloadBorrow(source)))
				ListElementDefinition(_, source):
					Ok(BorrowedResult(PayloadBorrow(source)))
				ReadRecordFieldDefinition(_, argument):
					parent = match argument:
						UnmanagedArgument(value):
							value
						ConsumedArgument(value, _):
							value
						BorrowedArgument(borrow):
							borrow.value

					Ok(BorrowedResult(PayloadBorrow(parent)))
				StringDefinition(_) | CallDefinition(_, _) | InvokeCallableDefinition(_, _) | FreeCallableDefinition(_) | CapturedCallableDefinition(_, _) | ConstructDefinition(_, _) | ConstructListDefinition(_) | ListSuffixDefinition(_, _) | ConstructRecordDefinition(_, _):
					Ok(OwnedResult(owner_id(next)))
				_:
					Err(internal_error(definition.span, "unsupported managed value operation"))

	result ?= ownership_result

	var updated_owner = match result:
		OwnedResult(_):
			next.add(1)
		_:
			next

	acquisition_plan: AcquisitionPlan = match operation:
		ReadRecordFieldDefinition(_, _):
			match result:
				BorrowedResult(source):
					owner = owner_id(updated_owner)
					updated_owner = updated_owner.add(1)
					ProjectedAcquisition({
						owner = owner,
						borrow = {
							value = definition.id,
							source = source
						},
					})
				_:
					StoredAcquisitions(acquisitions)
		_:
			StoredAcquisitions(acquisitions)

	Ok({
		definition = {
			id = definition.id,
			value_type = definition.value_type,
			operation = operation,
			result = result,
			span = definition.span
		},
		next_owner = updated_owner,
		acquisitions = acquisition_plan,
	})


private fixed record ScheduledDrop {
	owner: OwnerId,
	span: Span,
	last: Int
}


-- A block enclosing a join arm, as of that join: its values before the join
-- with their ownership.
private record EnclosingBlock {
	first_value: Int,
	sources: List[ResultOwnership],
	owners: List[ScheduledDrop],
	position: Int,
	consumed: List[OwnerId]
}


-- The nearest loop owns cleanup only inside this lexical PRE boundary.
private fixed record LoopScope {
	target: Lower.LoopTarget,
	pre_blocks: Int
}


private pure func enclosing_intervals(enclosing: List[EnclosingBlock]) -> List[ValueInterval]:
	var intervals: List[ValueInterval] = []
	for block in enclosing:
		intervals = intervals.append({ first = block.first_value, count = block.sources.length() })
	intervals


-- How a block schedules its owners' drops. A tail match's prefix keeps every
-- owner until each arm's exit, which drops it.
private union DropSchedule:
	DropAtLastUse(List[Option[Int]])
	DropInEachArm


-- A pending join sees the pre-output snapshot. Its arms follow the complete
-- block's values and owners, keeping both introduction intervals consecutive.
-- `entering` rows are the obligations the join takes; the snapshot does not
-- count them consumed, so its arms can discharge them.
private record PendingOwnedJoin {
	join: LoweredJoin,
	scrutinee: OwnedArgument,
	result: OwnedJoinParameter,
	carried: List[OwnedJoinParameter],
	entering: List[ScheduledDrop],
	enclosing: List[EnclosingBlock],
	loop_scope: Option[LoopScope]
}


-- Where a yielding arm discharges an obligation entering its join: on entry
-- when the arm never reads it, else at its last read there, a step or the
-- yield at the block's end, whose acquisitions precede the retirement.
private union EnteringDischarge:
	DropOnEntry(OwnerId, Span)
	LastReadInArm(ScheduledDrop)


-- How a loop header receives its initial value, decided once at the loop step.
-- A header takes the obligation of an owner whose last use is this entry and
-- that nothing else in the loop depends on; any other initial acquires.
private union HeaderEntry:
	AcquireAtEntry
	TakeOwner(OwnerId)


private record EnteringHeader {
	header: Lower.LoopHeader,
	entry: HeaderEntry
}


-- `headers` are the loop's headers in order, each with its entry decision.
private record PendingOwnedLoop {
	loop: LoweredLoop,
	headers: List[EnteringHeader],
	result: OwnedJoinParameter,
	carried: List[OwnedJoinParameter],
	enclosing: List[EnclosingBlock]
}


-- A block's operations while it is inserted: complete ones, and joins whose
-- definitions complete_joins builds once their arms are inserted.
private union InsertedEntry:
	Inserted(OwnershipOperation)
	AwaitingArms(PendingOwnedJoin)
	AwaitingLoop(PendingOwnedLoop)


private record InsertedSteps {
	consumed: List[OwnerId],
	entries: List[InsertedEntry],
	sources: List[ResultOwnership],
	owners: List[ScheduledDrop],
	next_owner: Int
}


-- The position after which the block drops an owner made at `position`.
private pure func drop_position(
	schedule: DropSchedule,
	value_slot: Int,
	step_position: Int,
	count: Int,
	span: Span,
) -> Result[Int, Diagnostic]:
	match schedule:
		DropInEachArm: Ok(count)
		DropAtLastUse(uses):
			match uses.get(value_slot):
				Some(Some(last)): Ok(last)
				Some(None): Ok(step_position)
				None: Err(internal_error(span, "missing value-use row"))


private record BuiltOutputs {
	result: OwnedJoinParameter,
	carried: List[OwnedJoinParameter],
	next_owner: Int
}


private pure func owned_join_parameter(
	parameter: ValueParameter,
	next_owner: Int,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[OwnedJoinParameter, Diagnostic]:
	needs_owner ?= value_needs_ownership(parameter.value_type, unions, records)
	match needs_owner:
		False: Ok(UnmanagedJoinParameter(parameter))
		True: Ok(ManagedJoinParameter(parameter, owner_id(next_owner)))


private pure func build_outputs(
	result_parameter: ValueParameter,
	parameters: List[ValueParameter],
	next_owner: Int,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[BuiltOutputs, Diagnostic]:
	result ?= owned_join_parameter(result_parameter, next_owner, unions, records)
	var cursor = match result:
		UnmanagedJoinParameter(_): next_owner
		ManagedJoinParameter(_, _): next_owner.add(1)
	var carried: List[OwnedJoinParameter] = []
	var failure: Option[Diagnostic] = None
	for parameter in parameters:
		match owned_join_parameter(parameter, cursor, unions, records):
			Err(error):
				failure = Some(error)
				break
			Ok(output):
				carried = carried.append(output)
				match output:
					UnmanagedJoinParameter(_): void
					ManagedJoinParameter(_, _): cursor = cursor.add(1)
	match failure:
		Some(error): Err(error)
		None: Ok({ result = result, carried = carried, next_owner = cursor })


private record BuiltInputs {
	parameters: List[OwnedJoinParameter],
	next_owner: Int
}


-- Canonical inputs own separate occurrences, even when an edge supplies the
-- same borrowed value more than once.
private pure func build_inputs(
	parameters: List[ValueParameter],
	initial_owner: Int,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[BuiltInputs, Diagnostic]:
	var inputs: List[OwnedJoinParameter] = []
	var next_owner = initial_owner
	var failure: Option[Diagnostic] = None
	for parameter in parameters:
		match owned_join_parameter(parameter, next_owner, unions, records):
			Err(error):
				failure = Some(error)
				break
			Ok(input):
				inputs = inputs.append(input)
				match input:
					UnmanagedJoinParameter(_): void
					ManagedJoinParameter(_, _): next_owner = next_owner.add(1)
	match failure:
		Some(error): Err(error)
		None: Ok({ parameters = inputs, next_owner = next_owner })


-- Borrow dependencies follow their published provenance, including projections.
private pure func dependency_owner(
	value: ValueId, sources: List[ResultOwnership], enclosing: List[EnclosingBlock],
	first_value: Int, span: Span,
) -> Result[Option[OwnerId], Diagnostic]:
	source ?= value_source(value, sources, enclosing, first_value, span)
	match source:
		OwnedResult(owner): Ok(Some(owner))
		BorrowedResult(OwnerBorrow(owner)): Ok(Some(owner))
		BorrowedResult(PayloadBorrow(parent)): dependency_owner(parent, sources, enclosing, first_value, span)
		_: Ok(None)


private pure func has_consumed(consumed: List[OwnerId], owner: OwnerId) -> Bool:
	var found: Bool = False
	for previous in consumed:
		if owner_number(previous) == owner_number(owner):
			found = True
			break
	found


private pure func matches_last_use(rows: List[ScheduledDrop], owner: OwnerId, position: Int) -> Bool:
	var last: Bool = False
	for row in rows:
		if and(owner_number(row.owner) == owner_number(owner), row.last == position):
			last = True
			break
	last


-- An obligation may transfer at this step when the step is its last use, in
-- this block's drop bucket or an enclosing loop row, and it is not consumed.
private pure func transferable_here(
	step_drops: List[ScheduledDrop], loop_uses: List[ScheduledDrop], consumed: List[OwnerId], owner: OwnerId, position: Int,
) -> Bool:
	last_use_here = matches_last_use(step_drops, owner, position).or(matches_last_use(loop_uses, owner, position))
	and(last_use_here, has_consumed(consumed, owner).not())


-- A join takes every obligation that may transfer at its step: the step's
-- drop bucket, which holds an arm's entering rows, and the loop rows.
private pure func join_entering(
	pre_step_drops: Option[List[ScheduledDrop]], loop_uses: List[ScheduledDrop], consumed: List[OwnerId], position: Int, span: Span,
) -> Result[List[ScheduledDrop], Diagnostic]:
	step_drops ?= pre_step_drops.to_result(internal_error(span, "missing drop schedule row"))
	candidates = step_drops.concat(loop_uses)
	Ok(candidates.filter(pure func(row): transferable_here(step_drops, loop_uses, consumed, row.owner, position)))


-- How a call passes its operands, decided at its step: the owners it moves
-- into transferring positions, and the obligations it acquires for owned
-- positions whose owner may not move here. Acquisitions precede the call, so
-- they take the owner ordinals before its result.
private record PassedCall {
	definition: OwnedDefinition,
	acquisitions: List[OwnerAcquisition],
	taken: List[OwnerId],
	next_owner: Int
}


-- Which positions of a call may move their argument's owner, and what an
-- unmovable owner gets: an in-place operand stays borrowed and its helper
-- copies; an owned parameter receives a fresh acquisition.
private union PassingRule:
	InPlaceOperand              -- position 0 only; never acquires
	OwnedPositions(List[Bool])  -- one row per argument; acquires when unmovable


-- The one move rule. A position the `rule` marks moves its argument's owner
-- when that owner may transfer at this step, no borrowed position of the call
-- depends on it and no earlier position took it. Otherwise an owned parameter
-- receives a fresh acquisition: a reference count cannot see the caller's
-- remaining borrow, so passing the bare value would let the callee update a
-- live value in place. An in-place operand instead stays borrowed, and its
-- helper copies. None when the call transfers nothing.
private pure func pass_arguments(
	definition: OwnedDefinition, target: CallTarget, arguments: List[OwnedArgument], rule: PassingRule,
	first_owner: Int, pre_step_drops: Option[List[ScheduledDrop]], loop_uses: List[ScheduledDrop], consumed: List[OwnerId],
	position: Int, sources: List[ResultOwnership], enclosing: List[EnclosingBlock], first_value: Int,
) -> Result[Option[PassedCall], Diagnostic]:
	step_drops ?= pre_step_drops.to_result(internal_error(definition.span, "missing drop schedule row"))
	transfers = match rule:
		InPlaceOperand: arguments.map(pure func(_: OwnedArgument) -> Bool: False).set(0, True)
		OwnedPositions(rows): rows
	counted: Void ?= if arguments.length() == transfers.length():
		Ok(void)
	else:
		Err(internal_error(definition.span, "call argument count differs from its contract"))
	var borrowed_backers: List[Int] = []
	var failure: Option[Diagnostic] = None
	var index = 0
	for argument in arguments:
		match (argument, transfers.get(index)):
			(BorrowedArgument(borrow), Some(False)):
				match dependency_owner(borrow.value, sources, enclosing, first_value, definition.span):
					Ok(Some(owner)): borrowed_backers = borrowed_backers.append(owner_number(owner))
					Ok(None): void
					Err(error): failure = Some(error)
			_: void
		index = index.add(1)
	var passed: List[OwnedArgument] = []
	var acquisitions: List[OwnerAcquisition] = []
	var taken: List[OwnerId] = []
	var next = first_owner
	index = 0
	for argument in arguments:
		match (argument, transfers.get(index)):
			(BorrowedArgument(borrow), Some(True)):
				match value_source(borrow.value, sources, enclosing, first_value, definition.span):
					Err(error): failure = Some(error)
					Ok(source):
						movable: Option[OwnerId] = match source:
							OwnedResult(owner):
								independent = and(borrowed_backers.contains(owner_number(owner)).not(), has_consumed(taken, owner).not())
								if and(independent, transferable_here(step_drops, loop_uses, consumed, owner, position)):
									Some(owner)
								else:
									None
							_: None
						match (movable, rule):
							(Some(owner), _):
								passed = passed.append(ConsumedArgument(borrow.value, owner))
								taken = taken.append(owner)
							(None, OwnedPositions(_)):
								fresh = owner_id(next)
								next = next.add(1)
								acquisitions = acquisitions.append({ owner = fresh, borrow = borrow })
								passed = passed.append(ConsumedArgument(borrow.value, fresh))
							(None, InPlaceOperand): passed = passed.append(argument)
			-- An unmanaged value never fills an owned position; verify rejects one.
			_: passed = passed.append(argument)
		index = index.add(1)
	match failure:
		Some(error): Err(error)
		None:
			if and(taken.is_empty(), acquisitions.is_empty()):
				Ok(None)
			else:
				-- The result's owner follows the acquisitions made before the call.
				result: ResultOwnership = match definition.result:
					OwnedResult(_): OwnedResult(owner_id(next))
					_: definition.result
				after_result = match definition.result:
					OwnedResult(_): next.add(1)
					_: next
				Ok(Some({ definition = { definition | operation = CallDefinition(target, passed), result = result }, acquisitions = acquisitions, taken = taken, next_owner = after_result }))


-- A reusing runtime operand 0 may take its owner; an owned user position must
-- receive an obligation. Most definitions pass only borrows and return None
-- before any allocation; matches here avoid tuples, which allocate.
-- `first_owner` is the owner ordinal before the call's definition.
private pure func pass_call(
	definition: OwnedDefinition, callees: CalleeContracts, first_owner: Int, pre_step_drops: Option[List[ScheduledDrop]],
	loop_uses: List[ScheduledDrop], consumed: List[OwnerId], position: Int, sources: List[ResultOwnership],
	enclosing: List[EnclosingBlock], first_value: Int,
) -> Result[Option[PassedCall], Diagnostic]:
	unchanged: Option[PassedCall] = None
	match definition.operation:
		CallDefinition(RuntimeFunction(operation), arguments):
			if reuses_first_operand(operation):
				pass_arguments(definition, RuntimeFunction(operation), arguments, InPlaceOperand, first_owner, pre_step_drops, loop_uses, consumed, position, sources, enclosing, first_value)
			else:
				Ok(unchanged)
		CallDefinition(UserFunction(callee), arguments):
			match callees:
				EveryCallBorrows: Ok(unchanged)
				InstanceRows(rows):
					match rows.get(function_number(callee)):
						None: Err(internal_error(definition.span, "call to an instance with no contract"))
						Some(callee_rows):
							if callee_rows.any(parameter_owned):
								pass_arguments(definition, UserFunction(callee), arguments, OwnedPositions(callee_rows.map(parameter_owned)), first_owner, pre_step_drops, loop_uses, consumed, position, sources, enclosing, first_value)
							else:
								Ok(unchanged)
		_: Ok(unchanged)


-- The candidate enclosing obligations a block reads, directly or through a
-- borrow, each at its last read: a step, or the terminal after the last step.
-- Nested reads and outgoing occurrences participate in the same last use.
private pure func enclosing_owner_uses(
	steps: List[LoweredStep], terminal: List[ValueId], candidates: List[ScheduledDrop],
	enclosing: List[EnclosingBlock], span: Span,
) -> Result[List[ScheduledDrop], Diagnostic]:
	outer = enclosing_intervals(enclosing)
	var uses: List[ScheduledDrop] = []
	var failure: Option[Diagnostic] = None
	var position = 0
	for reads in steps.map(step_reads).append(terminal):
		for value in reads:
			if visible_outside(value_number(value), outer):
				match dependency_owner(value, [], enclosing, 0, span):
					Err(error): failure = Some(error)
					Ok(None): void
					Ok(Some(owner)):
						match candidates.find(pure func(row): owner_number(row.owner) == owner_number(owner)):
							None: void
							Some(row):
								var recorded: Option[Int] = None
								var index = 0
								for use in uses:
									if owner_number(use.owner) == owner_number(owner):
										recorded = Some(index)
										break
									index = index.add(1)
								read: ScheduledDrop = { row | last = position }
								match recorded:
									Some(at): uses = uses.set(at, read)
									None: uses = uses.append(read)
		position = position.add(1)
	match failure:
		Some(error): Err(error)
		None: Ok(uses)


-- Only the nearest loop's enclosing values receive rows, once for this terminal
-- block. A row the block never reads stays live to the edge, which retires it.
private pure func loop_consumption_uses(
	steps: List[LoweredStep], exit: LoopExit, enclosing: List[EnclosingBlock], scope: LoopScope,
) -> Result[List[ScheduledDrop], Diagnostic]:
	var candidates: List[ScheduledDrop] = []
	var block_position = 0
	for block in enclosing:
		if block_position.greater_than_or_equal(scope.pre_blocks):
			for owner in block.owners:
				if and(owner.last.greater_than_or_equal(block.position), has_consumed(block.consumed, owner.owner).not()):
					candidates = candidates.append(owner)
		block_position = block_position.add(1)
	enclosing_owner_uses(steps, loop_exit_values(exit), candidates, enclosing, loop_exit_span(exit))


-- A transferable owner moves into its header only when its own initial is
-- the one read of the loop step it backs: `reads` holds every header initial
-- and every body read. Two headers fed by one owner therefore both acquire.
private pure func sole_backer_entry(
	owner: OwnerId, reads: List[ValueId], sources: List[ResultOwnership],
	enclosing: List[EnclosingBlock], first_value: Int, span: Span,
) -> Result[HeaderEntry, Diagnostic]:
	var backed = 0
	var failure: Option[Diagnostic] = None
	for value in reads:
		match dependency_owner(value, sources, enclosing, first_value, span):
			Ok(Some(other)):
				if owner_number(other) == owner_number(owner):
					backed = backed.add(1)
			Ok(None): void
			Err(error):
				failure = Some(error)
				break
	match failure:
		Some(error): Err(error)
		None:
			if backed == 1:
				Ok(TakeOwner(owner))
			else:
				Ok(AcquireAtEntry)


-- A header takes its initial's obligation when the owner holds the initial
-- itself, may transfer at this step and backs no other read of the step.
private pure func header_entry(
	header: Lower.LoopHeader, reads: List[ValueId], step_drops: List[ScheduledDrop], loop_uses: List[ScheduledDrop],
	consumed: List[OwnerId], position: Int, sources: List[ResultOwnership], enclosing: List[EnclosingBlock], first_value: Int,
) -> Result[HeaderEntry, Diagnostic]:
	source ?= value_source(header.initial, sources, enclosing, first_value, header.parameter.span)
	match source:
		OwnedResult(owner):
			if transferable_here(step_drops, loop_uses, consumed, owner, position):
				sole_backer_entry(owner, reads, sources, enclosing, first_value, header.parameter.span)
			else:
				Ok(AcquireAtEntry)
		_: Ok(AcquireAtEntry)


private pure func entering_headers(
	loop: LoweredLoop, reads: List[ValueId], pre_step_drops: Option[List[ScheduledDrop]],
	loop_uses: List[ScheduledDrop], consumed: List[OwnerId], position: Int,
	sources: List[ResultOwnership], enclosing: List[EnclosingBlock], first_value: Int,
) -> Result[List[EnteringHeader], Diagnostic]:
	step_drops ?= pre_step_drops.to_result(internal_error(loop.result.span, "missing drop schedule row"))
	var entering: List[EnteringHeader] = []
	var failure: Option[Diagnostic] = None
	for header in loop.headers:
		match header_entry(header, reads, step_drops, loop_uses, consumed, position, sources, enclosing, first_value):
			Ok(entry): entering = entering.append({ header = header, entry = entry })
			Err(error):
				failure = Some(error)
				break
	match failure:
		Some(error): Err(error)
		None: Ok(entering)


private pure func insert_steps(
	steps: List[LoweredStep],
	schedule: DropSchedule,
	enclosing: List[EnclosingBlock],
	first_value: Int,
	initial_owner: Int,
	seed_inputs: List[OwnedJoinParameter],
	loop_scope: Option[LoopScope],
	loop_uses: List[ScheduledDrop],
	discharges: List[EnteringDischarge],
	contracts: CallContracts,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[InsertedSteps, Diagnostic]:
	count = steps.length()
	var drops = steps.map(pure func(_: LoweredStep) -> List[ScheduledDrop]: [])
	var consumed: List[OwnerId] = match enclosing.get(enclosing.length().subtract(1)):
		Some(block): block.consumed
		None: []
	var entries: List[InsertedEntry] = []
	var sources = seed_inputs.map(join_ownership)
	var owners: List[ScheduledDrop] = []
	var next_owner = initial_owner
	var step_position: Int = 0
	var failure: Option[Diagnostic] = None

	var input_slot = 0
	for input in seed_inputs:
		match join_ownership(input):
			OwnedResult(owner):
				span = join_parameter(input).span
				match schedule:
					DropInEachArm: owners = owners.append({ owner = owner, span = span, last = count })
					DropAtLastUse(uses):
						match uses.get(input_slot):
							None: failure = Some(internal_error(span, "missing input-use row"))
							Some(None): entries = entries.append(Inserted(DropOwner(owner, span)))
							Some(Some(last)):
								owners = owners.append({ owner = owner, span = span, last = last })
								if last.less_than(count):
									match drops.get(last):
										Some(bucket): drops = drops.set(last, bucket.append({ owner = owner, span = span, last = last }))
										None: failure = Some(internal_error(span, "invalid input last-use position"))
			_: void
		input_slot = input_slot.add(1)

	-- Entering obligations go into drop buckets, never into `owners`: the
	-- enclosing snapshot keeps the one row an abrupt edge retires. Each one
	-- discharged here joins `consumed`, so a later abrupt edge leaves it alone.
	for discharge in discharges:
		match discharge:
			DropOnEntry(owner, drop_span):
				entries = entries.append(Inserted(DropOwner(owner, drop_span)))
				consumed = consumed.append(owner)
			LastReadInArm(row):
				if row.last.less_than(count):
					match drops.get(row.last):
						Some(bucket): drops = drops.set(row.last, bucket.append(row))
						None: failure = Some(internal_error(row.span, "invalid entering last-use position"))

	for step in steps:
		if failure.is_some():
			break
		value_slot = sources.length()
		span = step_span(step)
		var carried: List[OwnedJoinParameter] = []
		var taken_here: List[OwnerId] = []
		-- Candidates use the pre-call bucket; current-result scheduling below may
		-- add a new drop, so retirement must read the updated bucket afterward.
		pre_step_drops = drops.get(step_position)
		available_result: Result[ResultOwnership, Diagnostic] = match step:
			Join(join):
				match build_outputs(join.result, join.carried, next_owner, unions, records):
					Err(error): Err(error)
					Ok(built):
						match borrow_argument(join.selection.scrutinee, sources, enclosing, first_value, join.result.span):
							Err(error): Err(error)
							Ok(scrutinee):
								match join_entering(pre_step_drops, loop_uses, consumed, step_position, span):
									Err(error): Err(error)
									Ok(taken):
										-- The arms' snapshot precedes the transfer, so they can discharge
										-- what enters; only the continuation counts it consumed.
										entries = entries.append(AwaitingArms({
											join = join,
											scrutinee = scrutinee,
											result = built.result,
											carried = built.carried,
											entering = taken,
											enclosing = enclosing.append({ first_value = first_value, sources = sources, owners = owners, position = step_position, consumed = consumed }),
											loop_scope = loop_scope,
										}))
										consumed = consumed.concat(taken.map(pure func(row): row.owner))
										next_owner = built.next_owner
										carried = built.carried
										Ok(join_ownership(built.result))
			Loop(loop):
				match build_outputs(loop.result, loop.carried, next_owner, unions, records):
					Err(error): Err(error)
					Ok(built):
						match entering_headers(loop, step_reads(step), pre_step_drops, loop_uses, consumed, step_position, sources, enclosing, first_value):
							Err(error): Err(error)
							Ok(entering):
								-- Taken owners belong to their headers: no drop after this step,
								-- and no retirement at an enclosing loop's edge.
								for decided in entering:
									match decided.entry:
										TakeOwner(owner): consumed = consumed.append(owner)
										AcquireAtEntry: void
								entries = entries.append(AwaitingLoop({
									loop = loop, headers = entering, result = built.result, carried = built.carried,
									enclosing = enclosing.append({ first_value = first_value, sources = sources, owners = owners, position = step_position, consumed = consumed })
								}))
								next_owner = built.next_owner
								carried = built.carried
								Ok(join_ownership(built.result))
			Define(definition):
				match build_definition(definition, sources, enclosing, first_value, next_owner, contracts.parameters, unions, records):
					Err(error): Err(error)
					Ok(built):
						match pass_call(built.definition, contracts.callees, next_owner, pre_step_drops, loop_uses, consumed, step_position, sources, enclosing, first_value):
							Err(error): Err(error)
							-- A call stores no payloads: transfers are its only acquisitions.
							Ok(Some(passed)):
								match built.acquisitions:
									StoredAcquisitions([]):
										taken_here = passed.taken
										for owner in passed.taken:
											if matches_last_use(loop_uses, owner, step_position):
												consumed = consumed.append(owner)
										next_owner = passed.next_owner
										for acquisition in passed.acquisitions:
											entries = entries.append(Inserted(AcquireOwner(acquisition.owner, acquisition.borrow, span)))
										entries = entries.append(Inserted(DefineValue(passed.definition)))
										Ok(passed.definition.result)
									_: Err(internal_error(span, "a call that transfers an obligation cannot store payloads"))
							Ok(None):
								next_owner = built.next_owner
								-- Stored payloads are acquired before the definition; a
								-- projection's own acquisition follows it and owns its value.
								match built.acquisitions:
									StoredAcquisitions(acquired):
										for acquisition in acquired:
											entries = entries.append(Inserted(AcquireOwner(acquisition.owner, acquisition.borrow, span)))
										entries = entries.append(Inserted(DefineValue(built.definition)))
										Ok(built.definition.result)
									ProjectedAcquisition(acquired):
										entries = entries.append(Inserted(DefineValue(built.definition)))
										entries = entries.append(Inserted(AcquireOwner(acquired.owner, acquired.borrow, span)))
										Ok(OwnedResult(acquired.owner))

		match available_result:
			Err(error):
				failure = Some(error)
				break
			Ok(available):
				sources = sources.append(available)

				match available:
					OwnedResult(owner):
						match drop_position(schedule, value_slot, step_position, count, span):
							Err(error):
								failure = Some(error)
								break
							Ok(until):
								owners = owners.append({ owner = owner, span = span, last = until })
								-- A use at the block's end transfers or keeps this obligation.
								if until.less_than(count):
									match drops.get(until):
										None:
											failure = Some(internal_error(span, "missing drop schedule row"))
											break
										Some(bucket):
											match steps.get(until):
												None:
													failure = Some(internal_error(span, "invalid last-use position"))
													break
												Some(last):
													drops = drops.set(until, bucket.append({ owner = owner, span = step_span(last), last = until }))
					_:
						void

		-- Several outputs share one execution position, but each owns a value
		-- slot and, when managed, an independently scheduled obligation.
		for output in carried:
			parameter = join_parameter(output)
			slot = sources.length()
			sources = sources.append(join_ownership(output))
			match output:
				UnmanagedJoinParameter(_): void
				ManagedJoinParameter(_, owner):
					match drop_position(schedule, slot, step_position, count, parameter.span):
						Err(error): failure = Some(error)
						Ok(until):
							owners = owners.append({ owner = owner, span = parameter.span, last = until })
							if until.less_than(count):
								match drops.get(until):
									None: failure = Some(internal_error(parameter.span, "missing drop schedule row"))
									Some(bucket):
										match steps.get(until):
											Some(last): drops = drops.set(until, bucket.append({ owner = owner, span = step_span(last), last = until }))
											None: failure = Some(internal_error(parameter.span, "invalid last-use position"))
			if failure.is_some():
				break
		if failure.is_some():
			break

		match drops.get(step_position):
			Some(bucket):
				for dropped in bucket:
					transferred_here = has_consumed(taken_here, dropped.owner)
					-- An entering obligation read here leaves the arm at this step.
					entering_here: Bool = discharges.any(pure func(discharge):
						match discharge:
							LastReadInArm(row): owner_number(row.owner) == owner_number(dropped.owner)
							DropOnEntry(_, _): False
					)
					if has_consumed(consumed, dropped.owner).not():
						if transferred_here.not():
							entries = entries.append(Inserted(DropOwner(dropped.owner, dropped.span)))
						if entering_here:
							consumed = consumed.append(dropped.owner)
			None:
				failure = Some(internal_error(span, "missing drop schedule row"))
				break

		step_position = step_position.add(1)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({
				consumed = consumed,
				entries = entries,
				sources = sources,
				owners = owners,
				next_owner = next_owner,
			})


-- How a managed value leaves its block on a return or yield edge: an owner
-- it already holds, or one acquired from its borrow now.
private record LeavingValue {
	entries: List[InsertedEntry],
	transfer: ReturnTransfer,
	next_owner: Int
}


-- An owned result read as a borrow of its owner, so the edge acquires a fresh
-- owner instead of moving the existing one. Selection edges and join results
-- use it only when the owner cannot move: it was already moved or belongs to
-- an enclosing block. Join carriers, loop exits and loop entries that acquire
-- at entry always use it, because the owner must stay live after the edge.
private pure func borrowed_result(source: ResultOwnership) -> ResultOwnership:
	match source:
		OwnedResult(owner): BorrowedResult(OwnerBorrow(owner))
		_: source


private pure func leave_with(
	value: ValueId,
	source: ResultOwnership,
	entries: List[InsertedEntry],
	next_owner: Int,
	span: Span,
) -> LeavingValue:
	match source:
		UnmanagedResult:
			{ entries = entries, transfer = UnmanagedReturn(value), next_owner = next_owner }
		OwnedResult(owner):
			{ entries = entries, transfer = OwnedReturn(value, owner), next_owner = next_owner }
		BorrowedResult(borrow):
			owner = owner_id(next_owner)
			{
				entries = entries.append(Inserted(AcquireOwner(owner, { value = value, source = borrow }, span))),
				transfer = OwnedReturn(value, owner),
				next_owner = next_owner.add(1),
			}




private record InsertedSelectionEdge {
	edge: OwnedSelectionEdge,
	next_value: Int,
	next_owner: Int
}


-- Selection borrows enclosing values. Only newly acquired occurrences cross
-- the successful edge, so the complete enclosing owner snapshot stays live.
private pure func selection_value(definition: Lower.SelectionDefinition) -> ValueDefinition:
	match definition:
		BorrowRecordField(parameter, field, parent):
			{ id = parameter.id, value_type = parameter.value_type, operation = ReadRecordFieldValue(field, parent), span = parameter.span }
		BorrowUnionField(parameter, field, parent):
			{ id = parameter.id, value_type = parameter.value_type, operation = PayloadValue(field, parent), span = parameter.span }
		BorrowListElement(parameter, index, parent):
			{ id = parameter.id, value_type = parameter.value_type, operation = ListElementValue(index, parent), span = parameter.span }
		CopyListSuffix(parameter, parent, skipped):
			{ id = parameter.id, value_type = parameter.value_type, operation = ListSuffixValue(parent, skipped), span = parameter.span }


private pure func insert_selection_edge(
	edge: SelectionEdge,
	enclosing: List[EnclosingBlock],
	first_value: Int,
	initial_owner: Int,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[InsertedSelectionEdge, Diagnostic]:
	var sources: List[ResultOwnership] = []
	var operations: List[OwnershipOperation] = []
	var next_owner = initial_owner
	var failure: Option[Diagnostic] = None
	for definition in edge.definitions:
		lowered = selection_value(definition)
		match build_definition(lowered, sources, enclosing, first_value, next_owner, [], unions, records):
			Err(error):
				failure = Some(error)
				break
			Ok(built):
				match built.acquisitions:
					StoredAcquisitions(acquisitions):
						for acquired in acquisitions:
							operations = operations.append(AcquireOwner(acquired.owner, acquired.borrow, lowered.span))
						operations = operations.append(DefineValue(built.definition))
						sources = sources.append(built.definition.result)
					ProjectedAcquisition(acquired):
						operations = operations.append(DefineValue(built.definition))
						operations = operations.append(AcquireOwner(acquired.owner, acquired.borrow, lowered.span))
						sources = sources.append(OwnedResult(acquired.owner))
				next_owner = built.next_owner
	var transfers: List[ReturnTransfer] = []
	var moved: List[Int] = []
	for value in edge.arguments:
		if failure.is_some():
			break
		match value_source(value, sources, enclosing, first_value, internal_span()):
			Err(error): failure = Some(error)
			Ok(source):
				transferred_source = match source:
					OwnedResult(owner):
						if in_interval(value_number(value), first_value, sources.length()):
							if moved.contains(owner_number(owner)):
								borrowed_result(source)
							else:
								moved = moved.append(owner_number(owner))
								source
						else:
							borrowed_result(source)
					_: source
				leaving = leave_with(value, transferred_source, [], next_owner, internal_span())
				for entry in leaving.entries:
					match entry:
						Inserted(operation): operations = operations.append(operation)
						_: failure = Some(internal_error(internal_span(), "selection edge contains control flow"))
				transfers = transfers.append(leaving.transfer)
				next_owner = leaving.next_owner
	-- Fresh suffix roots and acquired record projections that are not transferred
	-- retire locally. Source wildcards never create a projection or acquisition.
	for source in sources:
		match source:
			OwnedResult(owner):
				if moved.contains(owner_number(owner)):
					void
				else:
					operations = operations.append(DropOwner(owner, internal_span()))
			_: void
	match failure:
		Some(error): Err(error)
		None: Ok({
			edge = { arm = edge.arm, operations = operations, transfers = transfers },
			next_value = first_value.add(sources.length()),
			next_owner = next_owner,
		})


private record InsertedSelection {
	selection: OwnedSelection,
	next_value: Int,
	next_owner: Int
}


private pure func insert_selection(
	selection: LoweredSelection,
	scrutinee: OwnedArgument,
	enclosing: List[EnclosingBlock],
	first_value: Int,
	initial_owner: Int,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[InsertedSelection, Diagnostic]:
	var nodes: List[OwnedDecisionNode] = []
	var next_value = first_value
	var next_owner = initial_owner
	var failure: Option[Diagnostic] = None
	for node in selection.nodes:
		match node:
			Lower.TestVariant(place, variant, yes, no):
				nodes = nodes.append(TestVariant(place, variant, yes, no))
			Lower.TestListLength(place, test, yes, no):
				nodes = nodes.append(TestListLength(place, test, yes, no))
			Lower.TestStringBytes(place, bytes, yes, no):
				nodes = nodes.append(TestStringBytes(place, bytes, yes, no))
			Lower.EnterArm(edge):
				match insert_selection_edge(edge, enclosing, next_value, next_owner, unions, records):
					Err(error):
						failure = Some(error)
						break
					Ok(inserted):
						nodes = nodes.append(EnterArm(inserted.edge))
						next_value = inserted.next_value
						next_owner = inserted.next_owner
	match failure:
		Some(error): Err(error)
		None: Ok({
			selection = { scrutinee = scrutinee, nodes = nodes, entry = selection.entry },
			next_value = next_value, next_owner = next_owner,
		})


private record InsertedJoinArm {
	arm: OwnedJoinArm,
	next_owner: Int,
	next_value: Int
}


private record LeavingJoin {
	entries: List[InsertedEntry],
	transfer: ReturnTransfer,
	carried: List[ReturnTransfer],
	next_owner: Int
}


-- Multiple outgoing occurrences each acquire an independent obligation. Only
-- after every acquisition may terminal-live arm-local sources retire. Sources
-- already dropped by insert_steps, and all enclosing owners, remain untouched.
private pure func retire_terminal_sources(
	entries: List[InsertedEntry],
	sources: List[ResultOwnership],
	uses: List[Option[Int]],
	position: Int,
	span: Span,
) -> Result[List[InsertedEntry], Diagnostic]:
	var retired = entries
	var slot = 0
	var failure: Option[Diagnostic] = None
	for source in sources:
		match uses.get(slot):
			None:
				failure = Some(internal_error(span, "missing value-use row"))
				break
			Some(last_use):
				match source:
					OwnedResult(owner):
						match last_use:
							Some(last):
								if last == position:
									retired = retired.append(Inserted(DropOwner(owner, span)))
							_: void
					_: void
		slot = slot.add(1)
	match failure:
		Some(error): Err(error)
		None: Ok(retired)


private pure func leave_join(
	outputs: Lower.JoinOutputs,
	step_count: Int,
	parameters: List[ValueParameter],
	inserted: InsertedSteps,
	uses: List[Option[Int]],
	discharges: List[EnteringDischarge],
	enclosing: List[EnclosingBlock],
	first_value: Int,
	span: Span,
) -> Result[LeavingJoin, Diagnostic]:
	result_source ?= value_source(outputs.value, inserted.sources, enclosing, first_value, span)
	moved = match result_source:
		OwnedResult(owner):
			movable = if outputs.carried.is_empty():
				in_interval(value_number(outputs.value), first_value, inserted.sources.length())
			else:
				False
			if movable:
				result_source
			else:
				borrowed_result(result_source)
		_: result_source
	leaving = leave_with(outputs.value, moved, inserted.entries, inserted.next_owner, span)
	var entries = leaving.entries
	var next_owner = leaving.next_owner
	var carried: List[ReturnTransfer] = []
	var position = 0
	var failure: Option[Diagnostic] = None
	for parameter in parameters:
		match outputs.carried.get(position):
			None: failure = Some(internal_error(span, "join arm carries the wrong number of values"))
			Some(value):
				match value_source(value, inserted.sources, enclosing, first_value, parameter.span):
					Err(error): failure = Some(error)
					Ok(carrier_source):
						borrowed = borrowed_result(carrier_source)
						left = leave_with(value, borrowed, entries, next_owner, parameter.span)
						entries = left.entries
						next_owner = left.next_owner
						carried = carried.append(left.transfer)
		if failure.is_some():
			break
		position = position.add(1)
	ready: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	retired: List[InsertedEntry] ?= if outputs.carried.is_empty():
		Ok(entries)
	else:
		retire_terminal_sources(entries, inserted.sources, uses, step_count, span)
	-- An entering obligation the yield reads has no slot in this arm; it
	-- retires here, after the yield's acquisitions.
	var completed = retired
	for discharge in discharges:
		match discharge:
			LastReadInArm(row):
				if row.last == step_count:
					completed = completed.append(Inserted(DropOwner(row.owner, span)))
			DropOnEntry(_, _): void

	match failure:
		Some(error): Err(error)
		None:
			Ok({
				entries = completed,
				transfer = leaving.transfer,
				carried = carried,
				next_owner = next_owner,
			})


private pure func join_terminal_span(arm: JoinArm, result: ValueId, outer: List[ValueInterval]) -> Result[Span, Diagnostic]:
	var input_span: Option[Span] = None
	for parameter in arm.inputs:
		if value_number(parameter.id) == value_number(result):
			input_span = Some(parameter.span)
			break
	match input_span:
		Some(span): Ok(span)
		None: terminal_span(arm.steps, result, outer)


-- Where one yielding arm discharges each obligation entering its join.
private pure func entering_discharges(
	arm: JoinArm, outputs: Lower.JoinOutputs, entering: List[ScheduledDrop], enclosing: List[EnclosingBlock], span: Span,
) -> Result[List[EnteringDischarge], Diagnostic]:
	reads ?= enclosing_owner_uses(arm.steps, [outputs.value].concat(outputs.carried), entering, enclosing, span)
	var discharges: List[EnteringDischarge] = []
	for row in entering:
		match reads.find(pure func(read): owner_number(read.owner) == owner_number(row.owner)):
			Some(read): discharges = discharges.append(LastReadInArm(read))
			None: discharges = discharges.append(DropOnEntry(row.owner, row.span))
	Ok(discharges)


private pure func insert_yielding_arm(
	arm: JoinArm,
	outputs: Lower.JoinOutputs,
	parameters: List[ValueParameter],
	result_span: Span,
	entering: List[ScheduledDrop],
	enclosing: List[EnclosingBlock],
	loop_scope: Option[LoopScope],
	first_value: Int,
	inputs: BuiltInputs,
	contracts: CallContracts,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[InsertedJoinArm, Diagnostic]:
	admitted: Void ?= if outputs.carried.length() == parameters.length():
		Ok(void)
	else:
		Err(internal_error(result_span, "join arm carries the wrong number of values"))
	outer = enclosing_intervals(enclosing)
	span ?= join_terminal_span(arm, outputs.value, outer)
	terminal: BlockTerminal = TerminalJoin(outputs.value, outputs.carried, parameters)
	uses ?= block_uses(arm.steps, terminal, outer, first_value, arm.inputs.length(), Ok(span))
	discharges ?= entering_discharges(arm, outputs, entering, enclosing, span)
	inserted ?= insert_steps(arm.steps, DropAtLastUse(uses), enclosing, first_value, inputs.next_owner, inputs.parameters, loop_scope, [], discharges, contracts, unions, records)
	leaving ?= leave_join(outputs, arm.steps.length(), parameters, inserted, uses, discharges, enclosing, first_value, span)
	completed ?= complete_joins(leaving.entries, first_value.add(inserted.sources.length()), leaving.next_owner, contracts, unions, records)
	Ok({
		arm = { id = arm.id, inputs = inputs.parameters, operations = completed.operations, exit = Yield({ transfer = leaving.transfer, carried = leaving.carried }) },
		next_owner = completed.next_owner, next_value = completed.next_value,
	})


private pure func insert_abrupt_arm(
	arm: JoinArm,
	target: Lower.LoopTarget,
	tail: Lower.LoopTail,
	result_span: Span,
	enclosing: List[EnclosingBlock],
	loop_scope: Option[LoopScope],
	first_value: Int,
	inputs: BuiltInputs,
	contracts: CallContracts,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[InsertedJoinArm, Diagnostic]:
	scope ?= require_loop_scope(loop_scope, target, result_span)
	body ?= insert_loop_block({ steps = arm.steps, tail = tail }, inputs.parameters, 0, enclosing, scope, first_value, inputs.next_owner, result_span, contracts, unions, records)
	Ok({
		arm = { id = arm.id, inputs = inputs.parameters, operations = body.body.operations, exit = TransferLoop(target, body.body.tail) },
		next_owner = body.next_owner, next_value = body.next_value,
	})


-- Abrupt arms receive no entering obligations: their edge retires every
-- live loop-scope owner, and the snapshot does not count those consumed.
private pure func insert_join_arm(
	arm: JoinArm,
	parameters: List[ValueParameter],
	result_span: Span,
	entering: List[ScheduledDrop],
	enclosing: List[EnclosingBlock],
	loop_scope: Option[LoopScope],
	first_value: Int,
	initial_owner: Int,
	contracts: CallContracts,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[InsertedJoinArm, Diagnostic]:
	inputs ?= build_inputs(arm.inputs, initial_owner, unions, records)
	match arm.exit:
		Lower.Yield(outputs): insert_yielding_arm(arm, outputs, parameters, result_span, entering, enclosing, loop_scope, first_value, inputs, contracts, unions, records)
		Lower.TransferLoop(target, tail): insert_abrupt_arm(arm, target, tail, result_span, enclosing, loop_scope, first_value, inputs, contracts, unions, records)


private record CompletedOwnedJoin {
	join: OwnedJoin,
	next_value: Int,
	next_owner: Int
}


private pure func complete_pending_join(
	pending: PendingOwnedJoin,
	first_value: Int,
	initial_owner: Int,
	contracts: CallContracts,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[CompletedOwnedJoin, Diagnostic]:
	selected ?= insert_selection(pending.join.selection, pending.scrutinee, pending.enclosing, first_value, initial_owner, unions, records)
	var next_value = selected.next_value
	var next_owner = selected.next_owner
	var arms: List[OwnedJoinArm] = []
	var failure: Option[Diagnostic] = None
	for arm in pending.join.arms:
		match insert_join_arm(arm, pending.join.carried, pending.join.result.span, pending.entering, pending.enclosing, pending.loop_scope, next_value, next_owner, contracts, unions, records):
			Err(error):
				failure = Some(error)
				break
			Ok(inserted):
				arms = arms.append(inserted.arm)
				next_value = inserted.next_value
				next_owner = inserted.next_owner
	match failure:
		Some(error): Err(error)
		None: Ok({
			join = {
				result = pending.result, carried = pending.carried, entering = pending.entering.map(pure func(row): row.owner),
				selection = selected.selection, arms = arms,
			},
			next_value = next_value, next_owner = next_owner,
		})


private record CompletedJoins {
	operations: List[OwnershipOperation],
	next_owner: Int,
	next_value: Int
}


-- Builds each join's definition once its block is complete: its arms are
-- inserted after the block's own values and owners: selection edges first,
-- then canonical inputs and ordinary arm bodies in arm order.
private pure func complete_joins(
	entries: List[InsertedEntry],
	first_value: Int,
	first_owner: Int,
	contracts: CallContracts,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[CompletedJoins, Diagnostic]:
	var operations: List[OwnershipOperation] = []
	var next_value = first_value
	var next_owner = first_owner
	var failure: Option[Diagnostic] = None
	for entry in entries:
		match entry:
			Inserted(operation):
				operations = operations.append(operation)
			AwaitingLoop(pending):
				match insert_loop(pending.loop, pending.headers, pending.enclosing, next_value, next_owner, contracts, unions, records):
					Err(error):
						failure = Some(error)
						break
					Ok(built):
						operations = operations.append(ExecuteLoop({ entry_acquisitions = built.acquisitions, headers = built.headers, result = pending.result, carried = pending.carried, body = built.body }))
						next_value = built.next_value
						next_owner = built.next_owner
			AwaitingArms(join):
				match complete_pending_join(join, next_value, next_owner, contracts, unions, records):
					Err(error):
						failure = Some(error)
						break
					Ok(completed):
						operations = operations.append(ExecuteJoin(completed.join))
						next_value = completed.next_value
						next_owner = completed.next_owner
	match failure:
		Some(error): Err(error)
		None: Ok({ operations = operations, next_owner = next_owner, next_value = next_value })


private record InsertedLoopBlock {
	body: OwnedLoopBlock,
	next_value: Int,
	next_owner: Int
}


private record InsertedLoop {
	acquisitions: List[OwnerAcquisition],
	headers: List[OwnedLoopHeader],
	body: OwnedLoopBlock,
	next_value: Int,
	next_owner: Int
}


private record LoopEdgeEntries {
	entries: List[InsertedEntry],
	exit: OwnedLoopExit,
	next_owner: Int
}


private pure func loop_exit_values(exit: LoopExit) -> List[ValueId]:
	match exit:
		Lower.Recur(arguments, _): arguments
		Lower.Break(outputs): [outputs.value].concat(outputs.carried)


private pure func loop_exit_span(exit: LoopExit) -> Span:
	match exit:
		Lower.Recur(_, span): span
		Lower.Break(outputs): outputs.span


private pure func require_loop_scope(scope: Option[LoopScope], target: Lower.LoopTarget, span: Span) -> Result[LoopScope, Diagnostic]:
	match scope:
		None: Err(internal_error(span, "loop transfer has no active loop"))
		Some(active):
			if value_number(Lower.loop_target_value(active.target)) == value_number(Lower.loop_target_value(target)):
				Ok(active)
			else:
				Err(internal_error(span, "loop transfer does not target the nearest loop"))


-- Scheduling records are frozen at the exact occurrence. Earlier drops are
-- excluded without walking or reconstructing the enclosing source body.
private pure func retire_live(
	entries: List[InsertedEntry], owners: List[ScheduledDrop], position: Int, consumed: List[OwnerId],
) -> List[InsertedEntry]:
	var retired = entries
	for owner in owners:
		if and(owner.last.greater_than_or_equal(position), has_consumed(consumed, owner.owner).not()):
			retired = retired.append(Inserted(DropOwner(owner.owner, owner.span)))
	retired


private pure func leave_loop(
	exit: LoopExit,
	inserted: InsertedSteps,
	enclosing: List[EnclosingBlock],
	scope: LoopScope,
	first_value: Int,
	position: Int,
) -> Result[LoopEdgeEntries, Diagnostic]:
	span = loop_exit_span(exit)
	var entries = inserted.entries
	var next_owner = inserted.next_owner
	var transfers: List[ReturnTransfer] = []
	var failure: Option[Diagnostic] = None
	for value in loop_exit_values(exit):
		match value_source(value, inserted.sources, enclosing, first_value, span):
			Err(error):
				failure = Some(error)
				break
			Ok(source):
				leaving = leave_with(value, borrowed_result(source), entries, next_owner, span)
				entries = leaving.entries
				next_owner = leaving.next_owner
				transfers = transfers.append(leaving.transfer)
	ready: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	entries = retire_live(entries, inserted.owners, position, inserted.consumed)
	var ordinal = 0
	for block in enclosing:
		if ordinal.greater_than_or_equal(scope.pre_blocks):
			entries = retire_live(entries, block.owners, block.position, inserted.consumed)
		ordinal = ordinal.add(1)
	owned_exit: OwnedLoopExit ?= match exit:
		Lower.Recur(_, occurrence): Ok(Recur(transfers, occurrence))
		Lower.Break(outputs):
			match transfers:
				[first, ...carried]: Ok(Break({ value = first, carried = carried, span = outputs.span }))
				[]: Err(internal_error(span, "missing loop result transfer"))
	Ok({ entries = entries, exit = owned_exit, next_owner = next_owner })


private pure func insert_loop_exit_block(
	steps: List[LoweredStep],
	exit: LoopExit,
	seed_inputs: List[OwnedJoinParameter],
	held_headers: Int,
	enclosing: List[EnclosingBlock],
	scope: LoopScope,
	first_value: Int,
	initial_owner: Int,
	span: Span,
	contracts: CallContracts,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[InsertedLoopBlock, Diagnostic]:
	uses ?= block_uses(steps, TerminalArguments(loop_exit_values(exit), loop_exit_span(exit)), enclosing_intervals(enclosing), first_value, seed_inputs.length(), Ok(span))
	-- Header obligations survive until the complete edge batch, including
	-- old values that are not outgoing. Arm inputs keep last-use scheduling.
	var held_uses = uses
	enclosing_uses ?= loop_consumption_uses(steps, exit, enclosing, scope)
	var loop_uses = enclosing_uses
	var input_slot = 0
	while input_slot.less_than(held_headers):
		match seed_inputs.get(input_slot):
			Some(ManagedJoinParameter(parameter, owner)):
				match uses.get(input_slot):
					Some(Some(last)): loop_uses = loop_uses.append({ owner = owner, span = parameter.span, last = last })
					_: void
			_: void
		held_uses = held_uses.set(input_slot, Some(steps.length()))
		input_slot = input_slot.add(1)
	inserted ?= insert_steps(steps, DropAtLastUse(held_uses), enclosing, first_value, initial_owner, seed_inputs, Some(scope), loop_uses, [], contracts, unions, records)
	leaving ?= leave_loop(exit, inserted, enclosing, scope, first_value, steps.length())
	completed ?= complete_joins(leaving.entries, first_value.add(inserted.sources.length()), leaving.next_owner, contracts, unions, records)
	Ok({ body = { operations = completed.operations, tail = ExitLoop(leaving.exit) }, next_value = completed.next_value, next_owner = completed.next_owner })


private pure func insert_loop_match_block(
	steps: List[LoweredStep],
	matched: Lower.LoopMatch,
	seed_inputs: List[OwnedJoinParameter],
	enclosing: List[EnclosingBlock],
	scope: LoopScope,
	first_value: Int,
	initial_owner: Int,
	span: Span,
	contracts: CallContracts,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[InsertedLoopBlock, Diagnostic]:
	prefix ?= insert_steps(steps, DropInEachArm, enclosing, first_value, initial_owner, seed_inputs, Some(scope), [], [], contracts, unions, records)
	scrutinee ?= borrow_argument(matched.selection.scrutinee, prefix.sources, enclosing, first_value, span)
	completed ?= complete_joins(prefix.entries, first_value.add(prefix.sources.length()), prefix.next_owner, contracts, unions, records)
	outer: List[EnclosingBlock] = enclosing.append({ first_value = first_value, sources = prefix.sources, owners = prefix.owners, position = steps.length(), consumed = prefix.consumed })
	selected ?= insert_selection(matched.selection, scrutinee, outer, completed.next_value, completed.next_owner, unions, records)
	var next_value = selected.next_value
	var next_owner = selected.next_owner
	var arms: List[OwnedLoopArm] = []
	var failure: Option[Diagnostic] = None
	for arm in matched.arms:
		match build_inputs(arm.inputs, next_owner, unions, records):
			Err(error): failure = Some(error)
			Ok(inputs):
				match insert_loop_block(arm.body, inputs.parameters, 0, outer, scope, next_value, inputs.next_owner, span, contracts, unions, records):
					Err(error): failure = Some(error)
					Ok(built):
						arms = arms.append({ id = arm.id, inputs = inputs.parameters, body = built.body })
						next_value = built.next_value
						next_owner = built.next_owner
		if failure.is_some():
			break
	match failure:
		Some(error): Err(error)
		None: Ok({ body = { operations = completed.operations, tail = MatchLoop({ selection = selected.selection, arms = arms }) }, next_value = next_value, next_owner = next_owner })


private pure func insert_loop_block(
	block: Lower.LoopBlock,
	seed_inputs: List[OwnedJoinParameter],
	held_headers: Int,
	enclosing: List[EnclosingBlock],
	scope: LoopScope,
	first_value: Int,
	initial_owner: Int,
	span: Span,
	contracts: CallContracts,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[InsertedLoopBlock, Diagnostic]:
	match block.tail:
		Lower.ExitLoop(exit): insert_loop_exit_block(block.steps, exit, seed_inputs, held_headers, enclosing, scope, first_value, initial_owner, span, contracts, unions, records)
		Lower.MatchLoop(matched): insert_loop_match_block(block.steps, matched, seed_inputs, enclosing, scope, first_value, initial_owner, span, contracts, unions, records)


private pure func insert_loop(
	loop: LoweredLoop,
	entering: List[EnteringHeader],
	enclosing: List[EnclosingBlock],
	first_value: Int,
	initial_owner: Int,
	contracts: CallContracts,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[InsertedLoop, Diagnostic]:
	var acquisitions: List[OwnerAcquisition] = []
	var initials: List[ReturnTransfer] = []
	var next_owner = initial_owner
	var failure: Option[Diagnostic] = None
	for decided in entering:
		match decided.entry:
			TakeOwner(owner): initials = initials.append(OwnedReturn(decided.header.initial, owner))
			AcquireAtEntry:
				match value_source(decided.header.initial, [], enclosing, first_value, decided.header.parameter.span):
					Err(error): failure = Some(error)
					Ok(source):
						left = leave_with(decided.header.initial, borrowed_result(source), [], next_owner, decided.header.parameter.span)
						for entry in left.entries:
							match entry:
								Inserted(AcquireOwner(owner, borrow, _)): acquisitions = acquisitions.append({ owner = owner, borrow = borrow })
								_: failure = Some(internal_error(decided.header.parameter.span, "loop entry contains a non-acquisition operation"))
						initials = initials.append(left.transfer)
						next_owner = left.next_owner
		if failure.is_some():
			break
	ready: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	inputs ?= build_inputs(entering.map(pure func(decided): decided.header.parameter), next_owner, unions, records)
	var headers: List[OwnedLoopHeader] = []
	var position = 0
	for parameter in inputs.parameters:
		match initials.get(position):
			None: failure = Some(internal_error(join_parameter(parameter).span, "missing loop initial transfer"))
			Some(initial): headers = headers.append({ parameter = parameter, initial = initial })
		position = position.add(1)
	headers_ready: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	scope: LoopScope = { target = Lower.loop_target(loop.result.id), pre_blocks = enclosing.length() }
	body ?= insert_loop_block(loop.body, inputs.parameters, entering.length(), enclosing, scope, first_value, inputs.next_owner, loop.result.span, contracts, unions, records)
	Ok({ acquisitions = acquisitions, headers = headers, body = body.body, next_value = body.next_value, next_owner = body.next_owner })


-- One inserted function with its owner and value ordinal counts, which size
-- the reach walk's tables.
private record InsertedFunction {
	function: OwnedFunction,
	owner_count: Int,
	value_count: Int
}


private pure func insert_contracted_function(
	function: LoweredFunction,
	contracts: CallContracts,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[InsertedFunction, Diagnostic]:
	span ?= terminal_span(function.steps, function.result, [])
	uses ?= block_uses(function.steps, TerminalValue(function.result), [], 0, 0, Ok(span))
	inserted ?= insert_steps(function.steps, DropAtLastUse(uses), [], 0, 0, [], None, [], [], contracts, unions, records)
	source ?= value_source(function.result, inserted.sources, [], 0, span)
	leaving = leave_with(function.result, source, inserted.entries, inserted.next_owner, span)
	completed ?= complete_joins(leaving.entries, inserted.sources.length(), leaving.next_owner, contracts, unions, records)
	Ok({
		function = {
			label = function.label, parameters = contracts.parameters, return_type = function.signature.return_type,
			operations = completed.operations, result = leaving.transfer,
		},
		owner_count = completed.next_owner,
		value_count = completed.next_value,
	})


-- Every parameter borrowed: the rows insertion starts from.
private pure func borrowed_rows(parameters: List[TypeRef], unions: List[ConcreteUnion], records: List[ConcreteRecord]) -> Result[List[OwnedParameter], Diagnostic]:
	var rows: List[OwnedParameter] = []
	var failure: Option[Diagnostic] = None
	for value_type in parameters:
		match value_needs_ownership(value_type, unions, records):
			Ok(True): rows = rows.append(ManagedParameter({ value_type = value_type, owned = False }))
			Ok(False): rows = rows.append(UnmanagedParameter(value_type))
			Err(error):
				failure = Some(error)
				break
	match failure:
		Some(error): Err(error)
		None: Ok(rows)


-- Insertion of one function on its own, with every parameter and call
-- borrowed. A test entry point: production inserts through `own`.
pure func insert_function(
	function: LoweredFunction,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[OwnedFunction, Diagnostic]:
	rows ?= borrowed_rows(function.signature.parameters, unions, records)
	inserted ?= insert_contracted_function(function, { parameters = rows, callees = EveryCallBorrows }, unions, records)
	Ok(inserted.function)


-- The walk of one inserted function that finds which owned parameters reach
-- reuse. Blocks are walked in execution order along a path and alternatives
-- one after another, which can only add labels. `ReachInputs` moves each
-- transfer's obligation into its parameter's owner.
private union ReachWork:
	ReachOperations(List[OwnershipOperation], Int, Option[OwnedJoinParameter])
	ReachTail(OwnedLoopTail, Option[OwnedJoinParameter])
	ReachInputs(List[ReturnTransfer], List[OwnedJoinParameter])


-- Each arm after the selection edges that enter it, which bind its inputs.
private pure func arm_work(
	selection: OwnedSelection, arm: MatchArmId, inputs: List[OwnedJoinParameter], loop_result: Option[OwnedJoinParameter],
) -> List[ReachWork]:
	var work: List[ReachWork] = []
	for node in selection.nodes:
		match node:
			EnterArm(edge):
				if match_arm_number(edge.arm) == match_arm_number(arm):
					work = work.append(ReachOperations(edge.operations, 0, loop_result))
					work = work.append(ReachInputs(edge.transfers, inputs))
			_: void
	work


-- A row of an inference table, which is sized for every index it is read
-- at; a miss is a compiler defect.
private pure func row_at[T](rows: List[T], index: Int) -> Result[T, Diagnostic]:
	match rows.get(index):
		Some(row): Ok(row)
		None: Err(internal_error(internal_span(), "ownership inference row is missing"))


-- Parameter p reaches reuse when its owner, or an owner carrying its
-- obligation, is consumed at a reusing runtime operand or an owned user
-- position. An owner carries p's obligation when a loop header, join input
-- or join or loop result takes it, or when it was acquired from a carrier
-- that is then dropped before the acquisition is consumed: the acquisition
-- may then hold the only reference. An acquisition consumed while its
-- carrier is still live, or a carrier that is only dropped or returned,
-- reaches nothing.
private pure func reached_parameters(inserted: InsertedFunction) -> Result[List[Bool], Diagnostic]:
	unset: Option[Int] = None
	var carrier = repeat(unset, inserted.owner_count)
	var pending = repeat(unset, inserted.owner_count)
	-- An upper bound on the pending rows, so a drop can skip scanning them.
	var pending_count = 0
	var backing = repeat(unset, inserted.value_count)
	unreached: Bool = False
	var reached = repeat(unreached, inserted.function.parameters.length())
	var failure: Option[Diagnostic] = None
	start: ReachWork = ReachOperations(inserted.function.operations, 0, None)
	var work: List[ReachWork] = [start]
	var depth = 1
	while and(depth.greater_than(0), failure.is_none()):
		depth = depth.subtract(1)
		-- A list literal allocates, so an item that pushes nothing leaves this None.
		var nested: Option[List[ReachWork]] = None
		match work.get(depth):
			None: failure = Some(internal_error(internal_span(), "ownership reach work is missing"))
			Some(ReachInputs(transfers, parameters)):
				var position = 0
				for parameter in parameters:
					match parameter:
						ManagedJoinParameter(value, owner):
							match transfers.get(position):
								Some(OwnedReturn(_, source)):
									backing = backing.set(value_number(value.id), Some(owner_number(owner)))
									match row_at(carrier, owner_number(source)):
										Ok(Some(origin)): carrier = carrier.set(owner_number(owner), Some(origin))
										Ok(None): void
										Err(error): failure = Some(error)
									match row_at(pending, owner_number(source)):
										Ok(Some(acquired_from)):
											pending = pending.set(owner_number(owner), Some(acquired_from))
											pending_count = pending_count.add(1)
										Ok(None): void
										Err(error): failure = Some(error)
								_: void
						UnmanagedJoinParameter(_): void
					position = position.add(1)
			Some(ReachTail(tail, loop_result)):
				match tail:
					ExitLoop(Break(outputs)):
						match loop_result:
							-- Only the result is linked: break outputs are acquisitions, and
							-- missing a carried one can only leave a label borrowed.
							Some(result): nested = Some([ReachInputs([outputs.value], [result])])
							None: void
					ExitLoop(Recur(_, _)): void
					MatchLoop(matched):
						var arms: List[ReachWork] = []
						for arm in matched.arms:
							arms = arms.concat(arm_work(matched.selection, arm.id, arm.inputs, loop_result))
							arms = arms.append(ReachOperations(arm.body.operations, 0, loop_result))
							arms = arms.append(ReachTail(arm.body.tail, loop_result))
						nested = Some(arms)
			Some(ReachOperations(operations, first, loop_result)):
				var index = first
				while and(and(index.less_than(operations.length()), nested.is_none()), failure.is_none()):
					operation_at = operations.get(index)
					index = index.add(1)
					match operation_at:
						None: failure = Some(internal_error(internal_span(), "ownership reach operation is missing"))
						Some(DefineValue(definition)):
							backed: Result[Option[Int], Diagnostic] = match definition.result:
								OwnedResult(owner): Ok(Some(owner_number(owner)))
								BorrowedResult(OwnerBorrow(owner)): Ok(Some(owner_number(owner)))
								BorrowedResult(PayloadBorrow(parent)): row_at(backing, value_number(parent))
								_: Ok(None)
							match backed:
								Err(error): failure = Some(error)
								Ok(backer): backing = backing.set(value_number(definition.id), backer)
							match definition.operation:
								ParameterDefinition(position):
									match definition.result:
										OwnedResult(owner): carrier = carrier.set(owner_number(owner), Some(position))
										_: void
								CallDefinition(_, arguments):
									for argument in arguments:
										match argument:
											ConsumedArgument(_, owner):
												match row_at(carrier, owner_number(owner)):
													Ok(Some(origin)): reached = reached.set(origin, True)
													Ok(None): void
													Err(error): failure = Some(error)
											_: void
								_: void
						Some(AcquireOwner(owner, borrow, _)):
							backer: Result[Option[Int], Diagnostic] = match borrow.source:
								OwnerBorrow(source): Ok(Some(owner_number(source)))
								PayloadBorrow(parent): row_at(backing, value_number(parent))
								ParameterBorrow(_): Ok(None)
							match backer:
								Err(error): failure = Some(error)
								Ok(None): void
								Ok(Some(source)):
									match row_at(carrier, source):
										Ok(Some(_)):
											pending = pending.set(owner_number(owner), Some(source))
											pending_count = pending_count.add(1)
										Ok(None): void
										Err(error): failure = Some(error)
						-- Dropping a carrier leaves the acquisitions still pending
						-- on it as possibly the only reference to its value.
						Some(DropOwner(owner, _)):
							match row_at(carrier, owner_number(owner)):
								Err(error): failure = Some(error)
								Ok(None): void
								Ok(Some(origin)):
									if pending_count.greater_than(0):
										var acquired = 0
										for acquired_from in pending:
											match acquired_from:
												Some(source):
													if source == owner_number(owner):
														carrier = carrier.set(acquired, Some(origin))
														pending = pending.set(acquired, None)
														pending_count = pending_count.subtract(1)
												None: void
											acquired = acquired.add(1)
						Some(ExecuteJoin(join)):
							for output in [join.result].concat(join.carried):
								match output:
									ManagedJoinParameter(value, owner): backing = backing.set(value_number(value.id), Some(owner_number(owner)))
									UnmanagedJoinParameter(_): void
							var arms: List[ReachWork] = []
							for arm in join.arms:
								arms = arms.concat(arm_work(join.selection, arm.id, arm.inputs, loop_result))
								arms = arms.append(ReachOperations(arm.operations, 0, loop_result))
								match arm.exit:
									Yield(outputs): arms = arms.append(ReachInputs([outputs.transfer].concat(outputs.carried), [join.result].concat(join.carried)))
									TransferLoop(_, tail): arms = arms.append(ReachTail(tail, loop_result))
							nested = Some(arms.append(ReachOperations(operations, index, loop_result)))
						Some(ExecuteLoop(loop)):
							for output in [loop.result].concat(loop.carried):
								match output:
									ManagedJoinParameter(value, owner): backing = backing.set(value_number(value.id), Some(owner_number(owner)))
									UnmanagedJoinParameter(_): void
							nested = Some([
								-- Entry acquisitions precede the headers, as acquisitions do.
								ReachOperations(loop.entry_acquisitions.map(pure func(entry: OwnerAcquisition) -> OwnershipOperation: AcquireOwner(entry.owner, entry.borrow, join_parameter(loop.result).span)), 0, loop_result),
								ReachInputs(loop.headers.map(pure func(header): header.initial), loop.headers.map(pure func(header): header.parameter)),
								ReachOperations(loop.body.operations, 0, Some(loop.result)),
								ReachTail(loop.body.tail, Some(loop.result)),
								ReachOperations(operations, index, loop_result),
							])
		match nested:
			None: void
			-- The stack pops its last entry, so nested work goes on in reverse.
			Some(items):
				var remaining = items.length()
				while remaining.greater_than(0):
					remaining = remaining.subtract(1)
					match items.get(remaining):
						Some(item):
							if depth.less_than(work.length()):
								work = work.set(depth, item)
							else:
								work = work.append(item)
							depth = depth.add(1)
						None: failure = Some(internal_error(internal_span(), "ownership reach work is missing"))
	match failure:
		Some(error): Err(error)
		None: Ok(reached)


-- Which parameters a value may carry an obligation of. It over-approximates
-- the owners the reach walk lets carry one: the parameter and its
-- projections; a loop header, what its initial carries; a join or loop
-- output, everything the join or loop reads; and an arm input, what its
-- scrutinee carries. Calls, literals and constructions carry nothing.
private union Carried:
	CarriesNothing
	CarriesParameter(Int)
	-- More than one parameter, which the inference counts as every parameter.
	CarriesSeveral


private pure func carried_union(left: Carried, right: Carried) -> Carried:
	match (left, right):
		(CarriesNothing, _): right
		(_, CarriesNothing): left
		(CarriesParameter(first), CarriesParameter(second)):
			if first == second:
				left
			else:
				CarriesSeveral
		_: CarriesSeveral


private pure func mark_carried(rows: List[Bool], carried: Carried) -> List[Bool]:
	match carried:
		CarriesNothing: rows
		CarriesParameter(index): rows.set(index, True)
		CarriesSeveral: rows.map(pure func(_: Bool) -> Bool: True)


-- A user call from one instance to another, with what each argument carries.
private record CallEdge {
	caller: Int,
	callee: Int,
	arguments: List[Carried]
}


-- One function's calls as the inference reads them: the parameters that may
-- reach a reusing runtime operand, its user calls, and the instances it takes
-- as callables, which keep the borrowed callable ABI.
private record CallFacts {
	reusing: List[Bool],
	calls: List[CallEdge],
	taken: List[Int]
}


-- What the scan writes for one value a join or loop introduces.
private record CarriedValue {
	value: ValueId,
	carried: Carried
}


-- A block the scan visits, then its loop tail, if it ends in one.
private record ScannedBlock {
	steps: List[LoweredStep],
	tail: Option[Lower.LoopTail]
}


private pure func carried_by(table: List[Carried], values: List[ValueId]) -> Result[Carried, Diagnostic]:
	var carried: Carried = CarriesNothing
	var failure: Option[Diagnostic] = None
	for value in values:
		match row_at(table, value_number(value)):
			Ok(found): carried = carried_union(carried, found)
			Err(error): failure = Some(error)
	match failure:
		Some(error): Err(error)
		None: Ok(carried)


-- Blocks are visited breadth first, each after the block that encloses it,
-- so every value a step reads is already written. Values are numbered depth
-- first, so the table grows past values that are written later; until then
-- those rows hold the lattice's bottom.
private pure func call_facts(function: LoweredFunction, caller: Int) -> Result[CallFacts, Diagnostic]:
	unreached: Bool = False
	var reusing = repeat(unreached, function.signature.parameters.length())
	var calls: List[CallEdge] = []
	var taken: List[Int] = []
	var table: List[Carried] = []
	var failure: Option[Diagnostic] = None
	start: ScannedBlock = { steps = function.steps, tail = None }
	var blocks: List[ScannedBlock] = [start]
	var next = 0
	while and(next.less_than(blocks.length()), failure.is_none()):
		var block: Option[ScannedBlock] = blocks.get(next)
		next = next.add(1)
		match block:
			None: failure = Some(internal_error(internal_span(), "ownership scan block is missing"))
			Some(scanned):
				for step in scanned.steps:
					match step:
						Define(definition):
							produced: Result[Carried, Diagnostic] = match definition.operation:
								ParameterValue(position): Ok(CarriesParameter(position))
								ReadRecordFieldValue(_, parent) | PayloadValue(_, parent) | ListElementValue(_, parent): row_at(table, value_number(parent))
								CallValue(RuntimeFunction(operation), arguments):
									if reuses_first_operand(operation):
										match arguments.get(0):
											Some(operand):
												match row_at(table, value_number(operand)):
													Ok(carried):
														reusing = mark_carried(reusing, carried)
														Ok(CarriesNothing)
													Err(error): Err(error)
											None: Ok(CarriesNothing)
									else:
										Ok(CarriesNothing)
								CallValue(UserFunction(callee), arguments):
									var carried: List[Carried] = []
									var missing: Option[Diagnostic] = None
									for argument in arguments:
										match row_at(table, value_number(argument)):
											Ok(found): carried = carried.append(found)
											Err(error): missing = Some(error)
									calls = calls.append({ caller = caller, callee = function_number(callee), arguments = carried })
									match missing:
										Some(error): Err(error)
										None: Ok(CarriesNothing)
								FreeCallableValue(body) | CapturedCallableValue(body, _):
									taken = taken.append(function_number(body))
									Ok(CarriesNothing)
								_: Ok(CarriesNothing)
							match produced:
								Ok(carried):
									while table.length().less_than_or_equal(value_number(definition.id)):
										table = table.append(CarriesNothing)
									table = table.set(value_number(definition.id), carried)
								Err(error): failure = Some(error)
						Join(join):
							match (carried_by(table, join.reads), row_at(table, value_number(join.selection.scrutinee))):
								(Ok(read), Ok(matched)):
									var introduced: List[CarriedValue] = [join.result].concat(join.carried).map(pure func(output: ValueParameter) -> CarriedValue: { value = output.id, carried = read })
									for arm in join.arms:
										introduced = introduced.concat(arm.inputs.map(pure func(input: ValueParameter) -> CarriedValue: { value = input.id, carried = matched }))
										exit_tail: Option[Lower.LoopTail] = match arm.exit:
											Lower.Yield(_): None
											Lower.TransferLoop(_, tail): Some(tail)
										blocks = blocks.append({ steps = arm.steps, tail = exit_tail })
									for written in introduced:
										while table.length().less_than_or_equal(value_number(written.value)):
											table = table.append(CarriesNothing)
										table = table.set(value_number(written.value), written.carried)
								(Err(error), _): failure = Some(error)
								(_, Err(error)): failure = Some(error)
						Loop(loop):
							match carried_by(table, loop.headers.map(pure func(header: Lower.LoopHeader) -> ValueId: header.initial).concat(loop.body_reads)):
								Err(error): failure = Some(error)
								Ok(read):
									var introduced: List[CarriedValue] = [loop.result].concat(loop.carried).map(pure func(output: ValueParameter) -> CarriedValue: { value = output.id, carried = read })
									for header in loop.headers:
										match row_at(table, value_number(header.initial)):
											Ok(carried): introduced = introduced.append({ value = header.parameter.id, carried = carried })
											Err(error): failure = Some(error)
									for written in introduced:
										while table.length().less_than_or_equal(value_number(written.value)):
											table = table.append(CarriesNothing)
										table = table.set(value_number(written.value), written.carried)
									blocks = blocks.append({ steps = loop.body.steps, tail = Some(loop.body.tail) })
				match scanned.tail:
					Some(Lower.MatchLoop(matched)):
						match row_at(table, value_number(matched.selection.scrutinee)):
							Err(error): failure = Some(error)
							Ok(carried):
								for arm in matched.arms:
									for input in arm.inputs:
										while table.length().less_than_or_equal(value_number(input.id)):
											table = table.append(CarriesNothing)
										table = table.set(value_number(input.id), carried)
									blocks = blocks.append({ steps = arm.body.steps, tail = Some(arm.body.tail) })
					_: void
	match failure:
		Some(error): Err(error)
		None: Ok({ reusing = reusing, calls = calls, taken = taken })


-- Labels only add owned positions, so two rows of one function compare by
-- how many positions they own.
private pure func owned_count(rows: List[OwnedParameter]) -> Int:
	var count = 0
	for row in rows:
		if parameter_owned(row):
			count = count.add(1)
	count


-- Marks the parameters a call's arguments carry into the positions `owned`
-- flags, which are the callee's, so they match the arguments.
private pure func mark_owned_positions(rows: List[Bool], arguments: List[Carried], owned: List[Bool]) -> Result[List[Bool], Diagnostic]:
	var marked = rows
	var failure: Option[Diagnostic] = None
	var position = 0
	for argument in arguments:
		match row_at(owned, position):
			Ok(True): marked = mark_carried(marked, argument)
			Ok(False): void
			Err(error): failure = Some(error)
		position = position.add(1)
	match failure:
		Some(error): Err(error)
		None: Ok(marked)


-- `rows` with the managed parameters `owning` flags owned.
private pure func owning_rows(rows: List[OwnedParameter], owning: List[Bool]) -> Result[List[OwnedParameter], Diagnostic]:
	var owned = rows
	var failure: Option[Diagnostic] = None
	var position = 0
	for row in rows:
		match (row, row_at(owning, position)):
			(ManagedParameter(passing), Ok(True)): owned = owned.set(position, ManagedParameter({ passing | owned = True }))
			(_, Err(error)): failure = Some(error)
			_: void
		position = position.add(1)
	match failure:
		Some(error): Err(error)
		None: Ok(owned)


-- One analysis: the insertion with provisional rows, and the labels the
-- reach walk's consumed parameters give.
private record Analysis {
	inserted: InsertedFunction,
	-- The current labels plus the parameters found consumed.
	merged: List[OwnedParameter]
}


private pure func analyse(
	function: LoweredFunction, tried: List[OwnedParameter], current: List[OwnedParameter], labels: List[List[OwnedParameter]],
	unions: List[ConcreteUnion], records: List[ConcreteRecord],
) -> Result[Analysis, Diagnostic]:
	inserted ?= insert_contracted_function(function, { parameters = tried, callees = InstanceRows(labels) }, unions, records)
	reached ?= reached_parameters(inserted)
	merged ?= owning_rows(current, reached)
	Ok({ inserted = inserted, merged = merged })


-- One function instance as the inference reads it: its body, its call facts,
-- and whether it is pinned borrowed. Instances taken as callables keep the
-- borrowed callable ABI, and the entry wrapper passes its arguments borrowed.
private record Instance {
	function: LoweredFunction,
	facts: CallFacts,
	pinned: Bool
}


-- The labels of every instance, solved. Each instance is analysed with its
-- labels plus every managed parameter of an unpinned instance that the scan
-- says may reach an in-place operand provisionally owned, and keeps those
-- whose owners the reach walk finds consumed. Labels only flip from borrowed
-- to owned, so each parameter flips at most once. A flip re-analyses only the
-- callers that pass a parameter into the flipped position, and every caller
-- drops its kept insertion, whose calls to the flipped instance changed.
private record SolvedLabels {
	labels: List[List[OwnedParameter]],
	-- An analysis insertion whose rows equal the final labels, by instance.
	kept: List[Option[InsertedFunction]]
}


-- The solver's worklist, with the highest instance it may still visit, as
-- `requeue_callers` receives and returns it.
private record LabelQueue {
	queued: List[Bool],
	kept: List[Option[InsertedFunction]],
	cursor: Int
}


-- Whether `call` passes one of its caller's parameters into an `owned` position.
private pure func passes_a_parameter(call: CallEdge, instances: List[Instance], owned: List[Bool]) -> Result[Bool, Diagnostic]:
	caller ?= row_at(instances, call.caller)
	reaches_nothing: Bool = False
	no_parameters = repeat(reaches_nothing, caller.facts.reusing.length())
	fed ?= mark_owned_positions(no_parameters, call.arguments, owned)
	Ok(fed.any(pure func(row): row))


-- After an instance flips to `owned`, its callers' calls to it pass
-- obligations, so no caller's kept insertion stays final. A caller passing a
-- parameter into a newly owned position may flip too: it is queued again, and
-- the cursor rises to reach it.
private pure func requeue_callers(queue: LabelQueue, incoming: List[CallEdge], instances: List[Instance], owned: List[Bool]) -> Result[LabelQueue, Diagnostic]:
	var queued = queue.queued
	var kept = queue.kept
	var cursor = queue.cursor
	var failure: Option[Diagnostic] = None
	for call in incoming:
		kept = kept.set(call.caller, None)
		match passes_a_parameter(call, instances, owned):
			Err(error): failure = Some(error)
			Ok(False): void
			Ok(True):
				queued = queued.set(call.caller, True)
				cursor = call.caller.max(cursor)
	match failure:
		Some(error): Err(error)
		None: Ok({ queued = queued, kept = kept, cursor = cursor })


private pure func solve_labels(
	instances: List[Instance], borrowed: List[List[OwnedParameter]], unions: List[ConcreteUnion], records: List[ConcreteRecord],
) -> Result[SolvedLabels, Diagnostic]:
	count = instances.length()
	var labels = borrowed
	no_insertion: Option[InsertedFunction] = None
	var kept = repeat(no_insertion, count)
	unqueued: Bool = False
	var queued = repeat(unqueued, count)
	-- Each instance's incoming calls.
	no_callers: List[CallEdge] = []
	var callers = repeat(no_callers, count)
	var failure: Option[Diagnostic] = None
	var index = 0
	for instance in instances:
		for call in instance.facts.calls:
			match callers.get(call.callee):
				Some(found): callers = callers.set(call.callee, found.append(call))
				None: failure = Some(internal_error(internal_span(), "call to an unknown instance"))
		if and(instance.pinned.not(), instance.facts.reusing.any(pure func(row): row)):
			queued = queued.set(index, True)
		index = index.add(1)

	-- Instances are numbered as specialization reaches them from the entry,
	-- so a callee usually follows its callers. Visiting the highest queued
	-- number first settles callees before their callers more often; the order
	-- changes only the work, never the fixpoint.
	var cursor = count.subtract(1)
	while and(cursor.greater_than_or_equal(0), failure.is_none()):
		analysed = cursor
		match (queued.get(analysed), instances.get(analysed), labels.get(analysed), callers.get(analysed)):
			(Some(False), _, _, _): cursor = analysed.subtract(1)
			(Some(True), Some(instance), Some(current), Some(incoming)):
				queued = queued.set(analysed, False)
				-- Try the borrowed parameters that may reach reuse, directly or
				-- through an owned callee position.
				var reaching = instance.facts.reusing
				for call in instance.facts.calls:
					match row_at(labels, call.callee):
						Err(error): failure = Some(error)
						Ok(callee):
							match mark_owned_positions(reaching, call.arguments, callee.map(parameter_owned)):
								Ok(marked): reaching = marked
								Err(error): failure = Some(error)
				match owning_rows(current, reaching):
					Err(error): failure = Some(error)
					Ok(tried):
						-- A pinned caller re-queued by a flip tries nothing.
						if and(and(failure.is_none(), instance.pinned.not()), owned_count(tried).greater_than(owned_count(current))):
							match analyse(instance.function, tried, current, labels, unions, records):
								Err(error): failure = Some(error)
								Ok(analysis):
									merged = analysis.merged
									-- Keep the insertion only when its rows are final.
									if owned_count(merged) == owned_count(tried):
										kept = kept.set(analysed, Some(analysis.inserted))
									else:
										kept = kept.set(analysed, no_insertion)
									if owned_count(merged).greater_than(owned_count(current)):
										labels = labels.set(analysed, merged)
										match requeue_callers({ queued = queued, kept = kept, cursor = cursor }, incoming, instances, merged.map(parameter_owned)):
											Err(error): failure = Some(error)
											Ok(requeued):
												queued = requeued.queued
												kept = requeued.kept
												cursor = requeued.cursor
			_: failure = Some(internal_error(internal_span(), "analysed instance is missing a row"))
	match failure:
		Some(error): Err(error)
		None: Ok({ labels = labels, kept = kept })


-- Which parameters own. Production infers them from insertion's own
-- transfers; tests use the other two to show labels never change behaviour.
union Labelling:
	InferredLabels
	AllBorrowed
	AllOwnedExceptPinned


-- Every instance inserted with its solved labels, in instance order.
private pure func inserted_instances(contents: LoweredFunctions, labelling: Labelling) -> Result[List[InsertedFunction], Diagnostic]:
	count = contents.functions.length()
	unpinned: Bool = False
	var pinned = repeat(unpinned, count).set(function_number(entry_function(contents.entrypoint)), True)
	var scanned: List[CallFacts] = []
	var borrowed: List[List[OwnedParameter]] = []
	var failure: Option[Diagnostic] = None
	for function in contents.functions:
		match (call_facts(function, scanned.length()), borrowed_rows(function.signature.parameters, contents.unions, contents.records)):
			(Ok(found), Ok(rows)):
				for body in found.taken:
					pinned = pinned.set(body, True)
				scanned = scanned.append(found)
				borrowed = borrowed.append(rows)
			(Err(error), _) | (_, Err(error)):
				failure = Some(error)
				break
	var instances: List[Instance] = []
	var index = 0
	for function in contents.functions:
		match (row_at(scanned, index), row_at(pinned, index)):
			(Ok(found), Ok(is_pinned)): instances = instances.append({ function = function, facts = found, pinned = is_pinned })
			(Err(error), _) | (_, Err(error)): failure = Some(error)
		index = index.add(1)
	gathered: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)

	no_insertion: Option[InsertedFunction] = None
	solved: SolvedLabels ?= match labelling:
		InferredLabels: solve_labels(instances, borrowed, contents.unions, contents.records)
		AllBorrowed: Ok({ labels = borrowed, kept = repeat(no_insertion, count) })
		AllOwnedExceptPinned:
			var owned: List[List[OwnedParameter]] = []
			for instance in instances:
				pin = instance.pinned
				match row_at(borrowed, owned.length()):
					Err(error): failure = Some(error)
					Ok(rows):
						keep = rows.map(pure func(_: OwnedParameter) -> Bool: pin.not())
						match owning_rows(rows, keep):
							Ok(all_owned): owned = owned.append(all_owned)
							Err(error): failure = Some(error)
			Ok({ labels = owned, kept = repeat(no_insertion, count) })

	var functions: List[InsertedFunction] = []
	index = 0
	for instance in instances:
		match (row_at(solved.kept, index), row_at(solved.labels, index)):
			(Ok(Some(kept)), _): functions = functions.append(kept)
			(Ok(None), Ok(rows)):
				match insert_contracted_function(instance.function, { parameters = rows, callees = InstanceRows(solved.labels) }, contents.unions, contents.records):
					Ok(inserted): functions = functions.append(inserted)
					Err(error): failure = Some(error)
			(Err(error), _) | (_, Err(error)): failure = Some(error)
		if failure.is_some():
			break
		index = index.add(1)
	match failure:
		Some(error): Err(error)
		None: Ok(functions)


pure func insert_ownership(program: LoweredProgram, labelling: Labelling) -> Result[OwnershipProgram, Diagnostic]:
	contents = lowered_functions(program)
	inserted ?= inserted_instances(contents, labelling)
	Ok({
		records = contents.records,
		unions = contents.unions,
		functions = inserted.map(pure func(function): function.function),
		entrypoint = contents.entrypoint,
	})


-- For tests: how many owned labels of the inferred program its final
-- insertion never consumes. Each would cost every caller an acquisition.
pure func unconsumed_owned_labels(program: LoweredProgram) -> Result[Int, Diagnostic]:
	inserted ?= inserted_instances(lowered_functions(program), InferredLabels)
	var unconsumed = 0
	var failure: Option[Diagnostic] = None
	for function in inserted:
		match reached_parameters(function):
			Err(error): failure = Some(error)
			-- Only owned parameters have carriers, so reached ones are owned.
			Ok(reached): unconsumed = unconsumed.add(owned_count(function.function.parameters)).subtract(reached.filter(pure func(row): row).length())
	match failure:
		Some(error): Err(error)
		None: Ok(unconsumed)


pure func own(program: LoweredProgram) -> Result[OwnershipProgram, Diagnostic]:
	insert_ownership(program, InferredLabels)
