import:
	int as IntOps
	list: set_index
	../lower/lower:
		JoinArm,
		LoweredExit(ReturnValue, RecurValues),
		LoweredFunction,
		LoweredJoin,
		LoweredMatch,
		LoweredProgram,
		LoweredTail(ExitValue, MatchValue),
		MatchLabel,
		ValueDefinition,
		ValueId,
		ValueOperation(
			ParameterValue, VoidValue, IntegerValue, FloatValue, StringValue,
			CallValue, ConstructValue, ConstructListValue, PayloadValue, ConstructRecordValue, ReadRecordFieldValue,
			JoinValue,
		),
		lowered_functions,
		value_reads,
		value_number,
	option: is_some, to_result
	../utils/source: compiler_source
	../specialize/specialize:
		ConcreteCall,
		ConcreteRecord,
		ConcreteUnion,
		FieldInstanceId,
		FunctionInstanceId,
		FunctionSignature,
		RecordInstanceId,
		TypeRef,
		UnionInstanceId,
		ValueOwnership(
			NoOwnership, ManagedStringLeaf, ManagedListRoot, ManagedRecordRoot,
			InlineOwnedFields, ManagedUnionRoot,
		),
		VariantInstanceId, VariantFieldInstanceId,
		value_ownership,
	../utils/syntax: Diagnostic, Entrypoint, FunctionExecution(OrdinaryCalls, SelfTailLoop), Span
	../utils/text: concat


-- This identity names an obligation in an unverified function body. Only the
-- independent verifier establishes its membership, lifetime and uniqueness.
opaque type OwnerId = Int


pure func owner_id(ordinal: Int) -> OwnerId:
	into_opaque OwnerId(ordinal)


pure func owner_number(id: OwnerId) -> Int:
	from_opaque OwnerId(id)


fixed union BorrowSource:
	ParameterBorrow(ValueId)
	OwnerBorrow(OwnerId)
	PayloadBorrow(ValueId)


fixed record BorrowedValue {
	value: ValueId,
	source: BorrowSource
}


fixed union OwnedArgument:
	UnmanagedArgument(ValueId)
	BorrowedArgument(BorrowedValue)


fixed union ResultOwnership:
	UnmanagedResult
	BorrowedResult(BorrowSource)
	OwnedResult(OwnerId)


fixed union StoredPayload:
	UnmanagedPayload(ValueId)
	OwnedPayload(ValueId, OwnerId)


fixed record OwnedRecordField {
	field: FieldInstanceId,
	value: StoredPayload
}


fixed union OwnedValueOperation:
	ConstructRecordDefinition(RecordInstanceId, List[OwnedRecordField])
	ReadRecordFieldDefinition(FieldInstanceId, OwnedArgument)
	ParameterDefinition(Int)
	VoidDefinition
	IntegerDefinition(Int)
	FloatDefinition(Float)
	StringDefinition(String)
	CallDefinition(ConcreteCall, List[OwnedArgument])
	ConstructDefinition(VariantInstanceId, List[StoredPayload])
	ConstructListDefinition(List[StoredPayload])
	PayloadDefinition(VariantFieldInstanceId, ValueId)
	-- A bound or statement match; its definition is the joined value.
	JoinDefinition(OwnedJoin)


fixed record OwnedDefinition {
	id: ValueId,
	value_type: TypeRef,
	operation: OwnedValueOperation,
	result: ResultOwnership,
	span: Span
}


fixed union OwnershipOperation:
	DefineValue(OwnedDefinition)
	AcquireOwner(OwnerId, BorrowedValue, Span)
	DropOwner(OwnerId, Span)


-- A value leaving its block on a return or yield edge, with the owner a
-- managed value moves.
fixed union ReturnTransfer:
	UnmanagedReturn(ValueId)
	OwnedReturn(ValueId, OwnerId)


-- A join arm moves its value into the join.
fixed record OwnedJoinArm {
	label: MatchLabel,
	operations: List[OwnershipOperation],
	transfer: ReturnTransfer
}


-- A join's arms follow its block's values and owners, in arm order: each
-- arm's own interval, then its joins' arms.
fixed record OwnedJoin {
	scrutinee: OwnedArgument,
	owner: UnionInstanceId,
	arms: List[OwnedJoinArm]
}


fixed union OwnedExit:
	ReturnResult(ReturnTransfer)
	RecurArguments(List[ValueId], Span)


fixed record OwnedArm {
	label: MatchLabel,
	operations: List[OwnershipOperation],
	exit: OwnedExit
}


fixed record OwnedMatch {
	scrutinee: OwnedArgument,
	owner: UnionInstanceId,
	arms: List[OwnedArm]
}


fixed union OwnedTail:
	ReturnTail(OwnedExit)
	MatchTail(OwnedMatch)


fixed record OwnedFunction {
	execution: FunctionExecution,
	signature: FunctionSignature,
	operations: List[OwnershipOperation],
	tail: OwnedTail
}


fixed record OwnershipProgram {
	records: List[ConcreteRecord],
	unions: List[ConcreteUnion],
	functions: List[OwnedFunction],
	entrypoint: Entrypoint[FunctionInstanceId]
}


-- Insertion errors with no source occurrence carry this compiler span.
private pure func internal_span() -> Span:
	{
		source = compiler_source(),
		start = 0,
		end = 0
	}


private pure func internal_error(span: Span, message: String) -> Diagnostic:
	{
		span = span,
		note = None,
		message = "internal compiler error: ".concat(message),
		help = "report this compiler error with the input program"
	}


-- Values of enclosing blocks that a block may read: each a consecutive
-- interval of one enclosing block's values before the nested arm.
private fixed record ValueInterval {
	first: Int,
	count: Int
}


private pure func in_interval(ordinal: Int, first: Int, count: Int) -> Bool:
	IntOps.greater_than_or_equal(ordinal, first) and IntOps.less_than(ordinal, IntOps.add(first, count))


private pure func visible_outside(ordinal: Int, outer: List[ValueInterval]) -> Bool:
	var visible = False
	for interval in outer:
		if in_interval(ordinal, interval.first, interval.count):
			visible = True
			break
	visible


-- Last-use positions belong to this block; ValueIds remain function-wide.
-- Enclosing values are visible, but earlier sibling ordinals are not.
private pure func use_slot(
	value: ValueId,
	position: Int,
	outer: List[ValueInterval],
	first_value: Int,
	slot_count: Int,
	span: Span,
) -> Result[Option[Int], Diagnostic]:
	ordinal = value_number(value)

	if visible_outside(ordinal, outer):
		Ok(None)
	else if in_interval(ordinal, first_value, position):
		index = IntOps.subtract(ordinal, first_value)

		if IntOps.greater_than_or_equal(index, 0) and IntOps.less_than(index, slot_count):
			Ok(Some(index))
		else:
			Err(internal_error(span, "invalid value identity in ownership use analysis"))
	else:
		Err(internal_error(span, "invalid value identity in ownership use analysis"))


-- The span a block's terminal use reports: its local operand's definition.
private pure func terminal_span(
	definitions: List[ValueDefinition],
	result: ValueId,
	outer: List[ValueInterval],
	first_value: Int,
) -> Result[Span, Diagnostic]:
	ordinal = value_number(result)

	if visible_outside(ordinal, outer):
		Ok(internal_span())
	else:
		match definitions.get(IntOps.subtract(ordinal, first_value)):
			Some(definition): Ok(definition.span)
			None: Err(internal_error(internal_span(), "invalid return value in ownership use analysis"))


-- What a block's exit reads: one returned or yielded value, or a backedge's
-- arguments at their own span.
private fixed union BlockTerminal:
	TerminalValue(ValueId)
	TerminalArguments(List[ValueId], Span)


-- Each definition's last use in this block, at the position of its last
-- reader; the terminal operands are read at the synthetic position after
-- the last definition.
private pure func block_uses(
	definitions: List[ValueDefinition],
	terminal: BlockTerminal,
	outer: List[ValueInterval],
	first_value: Int,
) -> Result[List[Option[Int]], Diagnostic]:
	var uses = definitions.map(pure func(_: ValueDefinition) -> Option[Int]: None)
	var position: Int = 0
	var failure: Option[Diagnostic] = None

	for definition in definitions:
		if IntOps.not_equals(
			value_number(definition.id),
			IntOps.add(first_value, position),
		):
			failure = Some(
				internal_error(
					definition.span,
					"nonconsecutive value identity in ownership use analysis",
				),
			)
			break

		-- Slot validation borrows only scalar bounds, so each write keeps the
		-- same local vector owner rather than sharing it through Result[List].
		for operand in value_reads(definition.operation):
			match use_slot(
				operand,
				position,
				outer,
				first_value,
				uses.length(),
				definition.span,
			):
				Ok(Some(index)):
					uses = uses.set(index, Some(position))
				Ok(None):
					void
				Err(error):
					failure = Some(error)
					break

		if failure.is_some():
			break

		position = IntOps.add(position, 1)

	ready ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	operands = match terminal:
		TerminalValue(result): [result]
		TerminalArguments(arguments, _): arguments
	span ?= match terminal:
		TerminalValue(result): terminal_span(definitions, result, outer, first_value)
		TerminalArguments(_, span): Ok(span)

	-- Start this builder inside the successful span scope. The outer snapshot
	-- may cause one initial copy; subsequent writes keep the local vector owner.
	var terminal_uses = uses
	var invalid: Option[Diagnostic] = None

	for operand in operands:
		match use_slot(
			operand,
			position,
			outer,
			first_value,
			terminal_uses.length(),
			span,
		):
			Ok(Some(index)):
				terminal_uses = terminal_uses.set(index, Some(position))
			Ok(None):
				void
			Err(error):
				invalid = Some(error)
				break

	match invalid:
		Some(error):
			Err(error)
		None:
			Ok(terminal_uses)


private pure func exit_uses(
	definitions: List[ValueDefinition],
	exit: LoweredExit,
	outer: List[ValueInterval],
	first_value: Int,
) -> Result[List[Option[Int]], Diagnostic]:
	terminal = match exit:
		RecurValues(arguments, span): TerminalArguments(arguments, span)
		ReturnValue(result): TerminalValue(result)
	block_uses(definitions, terminal, outer, first_value)


-- A block read after a dense prefix of `prefix_count` values.
pure func exit_last_uses(
	definitions: List[ValueDefinition],
	exit: LoweredExit,
	prefix_count: Int,
	first_value: Int,
) -> Result[List[Option[Int]], Diagnostic]:
	exit_uses(definitions, exit, [{ first = 0, count = prefix_count }], first_value)


pure func block_last_uses(
	definitions: List[ValueDefinition],
	result: ValueId,
	prefix_count: Int,
	first_value: Int,
) -> Result[List[Option[Int]], Diagnostic]:
	exit_last_uses(definitions, ReturnValue(result), prefix_count, first_value)


pure func last_uses(
	definitions: List[ValueDefinition],
	result: ValueId,
) -> Result[List[Option[Int]], Diagnostic]:
	block_last_uses(definitions, result, 0, 0)


private fixed record ChildAcquisition {
	owner: OwnerId,
	borrow: BorrowedValue
}


private fixed union AcquisitionPlan:
	StoredAcquisitions(List[ChildAcquisition])
	ProjectedAcquisition(ChildAcquisition)


private fixed record BuiltDefinition {
	definition: OwnedDefinition,
	next_owner: Int,
	acquisitions: AcquisitionPlan
}


private pure func value_source(
	value: ValueId,
	sources: List[ResultOwnership],
	enclosing: List[EnclosingBlock],
	first_value: Int,
	span: Span,
) -> Result[ResultOwnership, Diagnostic]:
	ordinal = value_number(value)
	var entry: Option[ResultOwnership] = None

	if in_interval(ordinal, first_value, sources.length()):
		entry = sources.get(IntOps.subtract(ordinal, first_value))
	else:
		for block in enclosing:
			if in_interval(ordinal, block.first_value, block.sources.length()):
				entry = block.sources.get(IntOps.subtract(ordinal, block.first_value))
				break

	entry.to_result(internal_error(span, "value used before definition in ownership insertion"))


private pure func borrow_argument(
	value: ValueId,
	sources: List[ResultOwnership],
	enclosing: List[EnclosingBlock],
	first_value: Int,
	span: Span,
) -> Result[OwnedArgument, Diagnostic]:
	source ?= value_source(value, sources, enclosing, first_value, span)
	Ok(
		match source:
			UnmanagedResult:
				UnmanagedArgument(value)
			BorrowedResult(borrow_source):
				BorrowedArgument({
					value = value,
					source = borrow_source,
				})
			OwnedResult(owner):
				BorrowedArgument({
					value = value,
					source = OwnerBorrow(owner),
				})
	)


-- Stored payloads of a variant or a list literal. Each stored occurrence
-- acquires independently, including Pair(x, x) and [x, x]: a unary last-use
-- transfer cannot safely generalize to repeated values.
private fixed record StoredPayloads {
	stored: List[StoredPayload],
	acquisitions: List[ChildAcquisition],
	next: Int
}


private pure func store_payloads(
	values: List[ValueId],
	sources: List[ResultOwnership],
	enclosing: List[EnclosingBlock],
	first_value: Int,
	span: Span,
	acquisitions: List[ChildAcquisition],
	next_owner: Int,
) -> Result[StoredPayloads, Diagnostic]:
	var stored: List[StoredPayload] = []
	var acquired = acquisitions
	var next = next_owner
	var failure: Option[Diagnostic] = None
	for value in values:
		match borrow_argument(value, sources, enclosing, first_value, span):
			Err(error):
				failure = Some(error)
				break
			Ok(UnmanagedArgument(unmanaged_value)): stored = stored.append(UnmanagedPayload(unmanaged_value))
			Ok(BorrowedArgument(borrow)):
				child_owner = owner_id(next)
				next = IntOps.add(next, 1)
				acquired = acquired.append({ owner = child_owner, borrow = borrow })
				stored = stored.append(OwnedPayload(value, child_owner))
	match failure:
		Some(error): Err(error)
		None: Ok({ stored = stored, acquisitions = acquired, next = next })


private pure func build_definition(
	definition: ValueDefinition,
	sources: List[ResultOwnership],
	enclosing: List[EnclosingBlock],
	first_value: Int,
	next_owner: Int,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[BuiltDefinition, Diagnostic]:
	plan ?= value_ownership(definition.value_type, unions, records)
	var next = next_owner
	var acquisitions: List[ChildAcquisition] = []

	operation_result: Result[OwnedValueOperation, Diagnostic] = match definition.operation:
		ConstructRecordValue(owner, fields):
			var stored: List[OwnedRecordField] = []
			var failure: Option[Diagnostic] = None

			for field in fields:
				match borrow_argument(field.value, sources, enclosing, first_value, definition.span):
					Err(error):
						failure = Some(error)
						break
					Ok(UnmanagedArgument(value)):
						stored = stored.append({
							field = field.field,
							value = UnmanagedPayload(value),
						})
					Ok(BorrowedArgument(borrow)):
						child_owner = owner_id(next)
						next = IntOps.add(next, 1)
						acquisitions = acquisitions.append({
							owner = child_owner,
							borrow = borrow,
						})
						stored = stored.append({
							field = field.field,
							value = OwnedPayload(field.value, child_owner),
						})

			match failure:
				Some(error):
					Err(error)
				None:
					Ok(ConstructRecordDefinition(owner, stored))
		ReadRecordFieldValue(field, value):
			borrow_argument(
				value,
				sources,
				enclosing,
				first_value,
				definition.span,
			).map(
				pure func(parent): ReadRecordFieldDefinition(field, parent),
			)
		ParameterValue(index):
			Ok(ParameterDefinition(index))
		VoidValue:
			Ok(VoidDefinition)
		StringValue(bytes):
			Ok(StringDefinition(bytes))
		IntegerValue(value):
			Ok(IntegerDefinition(value))
		FloatValue(value):
			Ok(FloatDefinition(value))
		ConstructValue(id, values):
			match store_payloads(values, sources, enclosing, first_value, definition.span, acquisitions, next):
				Err(error): Err(error)
				Ok(payloads):
					acquisitions = payloads.acquisitions
					next = payloads.next
					Ok(ConstructDefinition(id, payloads.stored))
		ConstructListValue(values):
			match store_payloads(values, sources, enclosing, first_value, definition.span, acquisitions, next):
				Err(error): Err(error)
				Ok(payloads):
					acquisitions = payloads.acquisitions
					next = payloads.next
					Ok(ConstructListDefinition(payloads.stored))
		PayloadValue(variant, value):
			Ok(PayloadDefinition(variant, value))
		JoinValue(_):
			-- insert_definitions builds a join with its pending arms.
			Err(internal_error(definition.span, "join reached single-definition ownership"))
		CallValue(call, written):
			var converted: List[OwnedArgument] = []
			var failure: Option[Diagnostic] = None

			for value in written:
				match borrow_argument(value, sources, enclosing, first_value, definition.span):
					Err(error):
						failure = Some(error)
						break
					Ok(argument):
						converted = converted.append(argument)

			match failure:
				Some(error):
					Err(error)
				None:
					Ok(CallDefinition(call, converted))

	operation ?= operation_result

	ownership_result: Result[ResultOwnership, Diagnostic] = match plan:
		NoOwnership:
			Ok(UnmanagedResult)
		ManagedStringLeaf | ManagedListRoot | ManagedRecordRoot(_) | InlineOwnedFields(_) | ManagedUnionRoot(_):
			match operation:
				ParameterDefinition(_):
					Ok(BorrowedResult(ParameterBorrow(definition.id)))
				PayloadDefinition(_, source):
					Ok(BorrowedResult(PayloadBorrow(source)))
				ReadRecordFieldDefinition(_, argument):
					parent = match argument:
						UnmanagedArgument(value):
							value
						BorrowedArgument(borrow):
							borrow.value

					Ok(BorrowedResult(PayloadBorrow(parent)))
				StringDefinition(_) | CallDefinition(_, _) | ConstructDefinition(_, _) | ConstructListDefinition(_) | ConstructRecordDefinition(_, _):
					Ok(OwnedResult(owner_id(next)))
				_:
					Err(internal_error(definition.span, "unsupported managed value operation"))

	result ?= ownership_result

	var updated_owner = match result:
		OwnedResult(_):
			IntOps.add(next, 1)
		_:
			next

	acquisition_plan = match operation:
		ReadRecordFieldDefinition(_, _):
			match result:
				BorrowedResult(source):
					owner = owner_id(updated_owner)
					updated_owner = IntOps.add(updated_owner, 1)
					ProjectedAcquisition({
						owner = owner,
						borrow = {
							value = definition.id,
							source = source
						},
					})
				_:
					StoredAcquisitions(acquisitions)
		_:
			StoredAcquisitions(acquisitions)

	Ok({
		definition = {
			id = definition.id,
			value_type = definition.value_type,
			operation = operation,
			result = result,
			span = definition.span
		},
		next_owner = updated_owner,
		acquisitions = acquisition_plan,
	})


private fixed record ScheduledDrop {
	owner: OwnerId,
	span: Span
}


-- A block enclosing a join arm, as of that join: its values before the join
-- with their ownership.
private fixed record EnclosingBlock {
	first_value: Int,
	sources: List[ResultOwnership]
}


private pure func enclosing_intervals(enclosing: List[EnclosingBlock]) -> List[ValueInterval]:
	var intervals: List[ValueInterval] = []
	for block in enclosing:
		intervals = intervals.append({ first = block.first_value, count = block.sources.length() })
	intervals


-- How a block schedules its owners' drops. A tail match's prefix keeps every
-- owner until each arm's exit, which drops it.
private fixed union DropSchedule:
	DropAtLastUse(List[Option[Int]])
	DropInEachArm


-- A join whose arms are inserted after its block, so that every block's
-- owners stay one consecutive interval, as its values do. `definition`
-- is the lowered join value; its arms see `enclosing`.
private fixed record PendingOwnedJoin {
	definition: ValueDefinition,
	join: LoweredJoin,
	scrutinee: OwnedArgument,
	result: ResultOwnership,
	enclosing: List[EnclosingBlock]
}


-- A block's operations while it is inserted: complete ones, and joins whose
-- definitions complete_joins builds once their arms are inserted.
private fixed union InsertedEntry:
	Inserted(OwnershipOperation)
	AwaitingArms(PendingOwnedJoin)


private fixed record InsertedDefinitions {
	entries: List[InsertedEntry],
	sources: List[ResultOwnership],
	owners: List[ScheduledDrop],
	next_owner: Int
}


-- The position after which the block drops an owner made at `position`.
private pure func drop_position(
	schedule: DropSchedule,
	position: Int,
	count: Int,
	span: Span,
) -> Result[Int, Diagnostic]:
	match schedule:
		DropInEachArm:
			Ok(count)
		DropAtLastUse(uses):
			match uses.get(position):
				Some(last_use):
					Ok(
						match last_use:
							Some(last): last
							None: position
					)
				None: Err(internal_error(span, "missing value-use row"))


-- A join's own value: its result is a fresh owner when managed, like a
-- call's; its arms move their values into it.
private fixed record BuiltJoin {
	scrutinee: OwnedArgument,
	result: ResultOwnership,
	next_owner: Int
}


private pure func build_join(
	definition: ValueDefinition,
	join: LoweredJoin,
	sources: List[ResultOwnership],
	enclosing: List[EnclosingBlock],
	first_value: Int,
	next_owner: Int,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[BuiltJoin, Diagnostic]:
	plan ?= value_ownership(definition.value_type, unions, records)
	scrutinee ?= borrow_argument(join.scrutinee, sources, enclosing, first_value, definition.span)
	Ok(
		match plan:
			NoOwnership:
				{ scrutinee = scrutinee, result = UnmanagedResult, next_owner = next_owner }
			ManagedStringLeaf | ManagedListRoot | ManagedRecordRoot(_) | InlineOwnedFields(_) | ManagedUnionRoot(_):
				{ scrutinee = scrutinee, result = OwnedResult(owner_id(next_owner)), next_owner = IntOps.add(next_owner, 1) }
	)


private pure func insert_definitions(
	definitions: List[ValueDefinition],
	schedule: DropSchedule,
	enclosing: List[EnclosingBlock],
	first_value: Int,
	initial_owner: Int,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[InsertedDefinitions, Diagnostic]:
	count = definitions.length()
	var drops = definitions.map(pure func(_: ValueDefinition) -> List[ScheduledDrop]: [])
	var entries: List[InsertedEntry] = []
	var sources: List[ResultOwnership] = []
	var owners: List[ScheduledDrop] = []
	var next_owner = initial_owner
	var position: Int = 0
	var failure: Option[Diagnostic] = None

	for definition in definitions:
		available_result: Result[ResultOwnership, Diagnostic] = match definition.operation:
			JoinValue(join):
				match build_join(definition, join, sources, enclosing, first_value, next_owner, unions, records):
					Err(error): Err(error)
					Ok(built):
						entries = entries.append(AwaitingArms({
							definition = definition,
							join = join,
							scrutinee = built.scrutinee,
							result = built.result,
							enclosing = enclosing.append({ first_value = first_value, sources = sources }),
						}))
						next_owner = built.next_owner
						Ok(built.result)
			_:
				match build_definition(definition, sources, enclosing, first_value, next_owner, unions, records):
					Err(error): Err(error)
					Ok(built):
						next_owner = built.next_owner
						-- Stored payloads are acquired before the definition; a
						-- projection's own acquisition follows it and owns its value.
						match built.acquisitions:
							StoredAcquisitions(acquired):
								for acquisition in acquired:
									entries = entries.append(Inserted(AcquireOwner(acquisition.owner, acquisition.borrow, definition.span)))
								entries = entries.append(Inserted(DefineValue(built.definition)))
								Ok(built.definition.result)
							ProjectedAcquisition(acquired):
								entries = entries.append(Inserted(DefineValue(built.definition)))
								entries = entries.append(Inserted(AcquireOwner(acquired.owner, acquired.borrow, definition.span)))
								Ok(OwnedResult(acquired.owner))

		match available_result:
			Err(error):
				failure = Some(error)
				break
			Ok(available):
				sources = sources.append(available)

				match available:
					OwnedResult(owner):
						match drop_position(schedule, position, count, definition.span):
							Err(error):
								failure = Some(error)
								break
							Ok(until):
								owners = owners.append({ owner = owner, span = definition.span })
								-- A use at the block's end transfers or keeps this obligation.
								if IntOps.less_than(until, count):
									match drops.get(until):
										None:
											failure = Some(internal_error(definition.span, "missing drop schedule row"))
											break
										Some(bucket):
											match definitions.get(until):
												None:
													failure = Some(internal_error(definition.span, "invalid last-use position"))
													break
												Some(last):
													drops = drops.set(until, bucket.append({ owner = owner, span = last.span }))
					_:
						void

		match drops.get(position):
			Some(bucket):
				for dropped in bucket:
					entries = entries.append(Inserted(DropOwner(dropped.owner, dropped.span)))
			None:
				failure = Some(internal_error(definition.span, "missing drop schedule row"))
				break

		position = IntOps.add(position, 1)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({
				entries = entries,
				sources = sources,
				owners = owners,
				next_owner = next_owner,
			})


-- How a managed value leaves its block on a return or yield edge: an owner
-- it already holds, or one acquired from its borrow now.
private fixed record LeavingValue {
	entries: List[InsertedEntry],
	transfer: ReturnTransfer,
	next_owner: Int
}


private pure func leave_with(
	value: ValueId,
	source: ResultOwnership,
	entries: List[InsertedEntry],
	next_owner: Int,
	span: Span,
) -> LeavingValue:
	match source:
		UnmanagedResult:
			{ entries = entries, transfer = UnmanagedReturn(value), next_owner = next_owner }
		OwnedResult(owner):
			{ entries = entries, transfer = OwnedReturn(value, owner), next_owner = next_owner }
		BorrowedResult(borrow):
			owner = owner_id(next_owner)
			{
				entries = entries.append(Inserted(AcquireOwner(owner, { value = value, source = borrow }, span))),
				transfer = OwnedReturn(value, owner),
				next_owner = IntOps.add(next_owner, 1),
			}


private pure func returned_span(
	definitions: List[ValueDefinition],
	value: ValueId,
	first_value: Int,
) -> Span:
	match definitions.get(IntOps.subtract(value_number(value), first_value)):
		Some(definition): definition.span
		None: internal_span()


-- A block's entries through its exit, before its joins' arms.
private fixed record BlockExitEntries {
	entries: List[InsertedEntry],
	next_owner: Int,
	exit: OwnedExit
}


private fixed record InsertedBlock {
	operations: List[OwnershipOperation],
	exit: OwnedExit,
	next_owner: Int,
	next_value: Int
}


-- A function's block, or a tail match's arm. Its joins' arms follow its own
-- values and owners.
private pure func insert_block(
	definitions: List[ValueDefinition],
	exit: LoweredExit,
	enclosing: List[EnclosingBlock],
	first_value: Int,
	initial_owner: Int,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[InsertedBlock, Diagnostic]:
	uses ?= exit_uses(definitions, exit, enclosing_intervals(enclosing), first_value)
	inserted ?= insert_definitions(definitions, DropAtLastUse(uses), enclosing, first_value, initial_owner, unions, records)
	exit_result: Result[BlockExitEntries, Diagnostic] = match exit:
		RecurValues(arguments, span):
			Ok({ entries = inserted.entries, next_owner = inserted.next_owner, exit = RecurArguments(arguments, span) })
		ReturnValue(result):
			span = returned_span(definitions, result, first_value)
			match value_source(result, inserted.sources, enclosing, first_value, span):
				Ok(source):
					leaving = leave_with(result, source, inserted.entries, inserted.next_owner, span)
					Ok({ entries = leaving.entries, next_owner = leaving.next_owner, exit = ReturnResult(leaving.transfer) })
				Err(error): Err(error)
	left ?= exit_result
	completed ?= complete_joins(
		left.entries,
		IntOps.add(first_value, definitions.length()),
		left.next_owner,
		unions,
		records,
	)
	Ok({
		operations = completed.operations,
		exit = left.exit,
		next_owner = completed.next_owner,
		next_value = completed.next_value,
	})


private fixed record InsertedJoinArm {
	arm: OwnedJoinArm,
	next_owner: Int,
	next_value: Int
}


-- A yield moves only an owner made in its arm, so every edge into the join
-- leaves the same enclosing owners live; a yielded enclosing value is
-- acquired again first.
private pure func insert_join_arm(
	arm: JoinArm,
	enclosing: List[EnclosingBlock],
	first_value: Int,
	initial_owner: Int,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[InsertedJoinArm, Diagnostic]:
	result = arm.value
	span = returned_span(arm.definitions, result, first_value)
	outer = enclosing_intervals(enclosing)
	uses ?= block_uses(arm.definitions, TerminalValue(result), outer, first_value)
	inserted ?= insert_definitions(arm.definitions, DropAtLastUse(uses), enclosing, first_value, initial_owner, unions, records)
	source ?= value_source(result, inserted.sources, enclosing, first_value, span)
	moved = match source:
		OwnedResult(owner):
			if in_interval(value_number(result), first_value, arm.definitions.length()):
				source
			else:
				BorrowedResult(OwnerBorrow(owner))
		_:
			source
	leaving = leave_with(result, moved, inserted.entries, inserted.next_owner, span)
	completed ?= complete_joins(
		leaving.entries,
		IntOps.add(first_value, arm.definitions.length()),
		leaving.next_owner,
		unions,
		records,
	)
	Ok({
		arm = { label = arm.label, operations = completed.operations, transfer = leaving.transfer },
		next_owner = completed.next_owner,
		next_value = completed.next_value,
	})


private fixed record CompletedJoins {
	operations: List[OwnershipOperation],
	next_owner: Int,
	next_value: Int
}


-- Builds each join's definition once its block is complete: its arms are
-- inserted after the block's own values and owners, in join and arm order.
private pure func complete_joins(
	entries: List[InsertedEntry],
	first_value: Int,
	first_owner: Int,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[CompletedJoins, Diagnostic]:
	var operations: List[OwnershipOperation] = []
	var next_value = first_value
	var next_owner = first_owner
	var failure: Option[Diagnostic] = None
	for entry in entries:
		match entry:
			Inserted(operation):
				operations = operations.append(operation)
			AwaitingArms(join):
				var arms: List[OwnedJoinArm] = []
				for arm in join.join.arms:
					match insert_join_arm(arm, join.enclosing, next_value, next_owner, unions, records):
						Err(error):
							failure = Some(error)
							break
						Ok(inserted):
							arms = arms.append(inserted.arm)
							next_value = inserted.next_value
							next_owner = inserted.next_owner
				if failure.is_some():
					break
				operations = operations.append(DefineValue({
					id = join.definition.id,
					value_type = join.definition.value_type,
					operation = JoinDefinition({ scrutinee = join.scrutinee, owner = join.join.owner, arms = arms }),
					result = join.result,
					span = join.definition.span,
				}))
	match failure:
		Some(error): Err(error)
		None: Ok({ operations = operations, next_owner = next_owner, next_value = next_value })


private pure func insert_match(
	function: LoweredFunction,
	matched: LoweredMatch,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[OwnedFunction, Diagnostic]:
	prefix ?= insert_definitions(function.definitions, DropInEachArm, [], 0, 0, unions, records)
	prefix_owners = prefix.owners
	scrutinee_definition ?= function.definitions
		.get(value_number(matched.scrutinee))
		.to_result(internal_error(internal_span(), "missing match scrutinee definition"))
	scrutinee ?= borrow_argument(matched.scrutinee, prefix.sources, [], 0, scrutinee_definition.span)
	joined ?= complete_joins(prefix.entries, function.definitions.length(), prefix.next_owner, unions, records)
	enclosing: List[EnclosingBlock] = [{ first_value = 0, sources = prefix.sources }]
	var next_value = joined.next_value
	var next_owner = joined.next_owner
	var arms: List[OwnedArm] = []
	var failure: Option[Diagnostic] = None

	for arm in matched.arms:
		match insert_block(
			arm.body.definitions,
			arm.body.exit,
			enclosing,
			next_value,
			next_owner,
			unions,
			records,
		):
			Ok(built):
				var arm_operations = built.operations

				returned = match built.exit:
					ReturnResult(OwnedReturn(_, owner)):
						Some(owner)
					_:
						None

				-- Prefix obligations remain live until this selected arm exits.
				-- Return acquisition has already run, before any ancestor cleanup.
				for pending in prefix_owners:
					transferred = match returned:
						Some(owner):
							IntOps.equals(owner_number(owner), owner_number(pending.owner))
						None:
							False

					if not transferred:
						arm_operations = arm_operations.append(
							DropOwner(
								pending.owner,
								pending.span,
							),
						)

				arms = arms.append({
					label = arm.label,
					operations = arm_operations,
					exit = built.exit,
				})
				next_value = built.next_value
				next_owner = built.next_owner
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({
				execution = function.execution,
				signature = function.signature,
				operations = joined.operations,
				tail = MatchTail({
					scrutinee = scrutinee,
					owner = matched.owner,
					arms = arms,
				}),
			})


private pure func managed_loop(span: Span) -> Diagnostic:
	{
		span = span,
		note = None,
		message = "managed values in @tail_recursive functions are not supported yet",
		help = "use an unmanaged helper, or remove @tail_recursive"
	}


-- A self-tail loop admits only unmanaged values, including those in its
-- joins' arms.
private pure func admit_loop_values(
	definitions: List[ValueDefinition],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	var invalid: Option[Diagnostic] = None

	for definition in definitions:
		match value_ownership(definition.value_type, unions, records):
			Err(error):
				invalid = Some(error)
				break
			Ok(ManagedStringLeaf) | Ok(ManagedListRoot) | Ok(ManagedRecordRoot(_)) | Ok(InlineOwnedFields(_)) | Ok(ManagedUnionRoot(_)):
				invalid = Some(managed_loop(definition.span))
				break
			Ok(NoOwnership):
				void

		match definition.operation:
			JoinValue(join):
				for arm in join.arms:
					match admit_loop_values(arm.definitions, unions, records):
						Err(error):
							invalid = Some(error)
							break
						Ok(_):
							void
			_:
				void

		if invalid.is_some():
			break

	match invalid:
		Some(error):
			Err(error)
		None:
			Ok(void)


private pure func admit_loop(
	function: LoweredFunction,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	match function.execution:
		OrdinaryCalls:
			Ok(void)
		SelfTailLoop(annotation):
			var invalid: Option[Diagnostic] = None

			for value_type in function.signature.parameters.append(function.signature.return_type):
				match value_ownership(value_type, unions, records):
					Err(error):
						invalid = Some(error)
						break
					Ok(ManagedStringLeaf) | Ok(ManagedListRoot) | Ok(ManagedRecordRoot(_)) | Ok(InlineOwnedFields(_)) | Ok(ManagedUnionRoot(_)):
						invalid = Some(managed_loop(annotation))
						break
					Ok(NoOwnership):
						void

			match invalid:
				Some(error):
					Err(error)
				None:
					match admit_loop_values(function.definitions, unions, records):
						Ok(prefix):

							match function.tail:
								ExitValue(_):
									Ok(void)
								MatchValue(matched):
									for arm in matched.arms:
										match admit_loop_values(arm.body.definitions, unions, records):
											Err(error):
												invalid = Some(error)
												break
											Ok(_):
												void

									match invalid:
										Some(error):
											Err(error)
										None:
											Ok(void)
						Err(error): Err(error)


pure func insert_function(
	function: LoweredFunction,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[OwnedFunction, Diagnostic]:
	admitted ?= admit_loop(function, unions, records)

	match function.tail:
		ExitValue(exit):
			match insert_block(function.definitions, exit, [], 0, 0, unions, records):
				Ok(built):
					Ok({
						execution = function.execution,
						signature = function.signature,
						operations = built.operations,
						tail = ReturnTail(built.exit),
					})
				Err(error): Err(error)
		MatchValue(matched):
			insert_match(function, matched, unions, records)


pure func own(program: LoweredProgram) -> Result[OwnershipProgram, Diagnostic]:
	contents = lowered_functions(program)
	var functions: List[OwnedFunction] = []
	var failure: Option[Diagnostic] = None

	for function in contents.functions:
		match insert_function(function, contents.unions, contents.records):
			Ok(owned):
				functions = functions.append(owned)
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({
				records = contents.records,
				unions = contents.unions,
				functions = functions,
				entrypoint = contents.entrypoint,
			})
