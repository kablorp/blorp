import:
	int as IntOps
	string as TextOps


-- The host library has no ordinary String equality function. Equal byte
-- lengths plus an exact prefix comparison define equality without traits.
pure func equals(left: String, right: String) -> Bool:
	IntOps.equals(left.length(), right.length()) and left.starts_with(right)


pure func concat(left: String, right: String) -> String:
	TextOps.add(left, right)
