import:
	dict as D: DictKey


-- IDs are scoped to one table and its extensions, never to another parse.
opaque type NameId = Int


implements Equatable for NameId:
	pure func equals(left: Self, right: Self) -> Bool:
		from_opaque NameId(left) == from_opaque NameId(right)


implements Hashable for NameId:
	pure func hash(value: Self) -> Int:
		from_opaque NameId(value)


implements DictKey for NameId


fixed record SpecialNames {
	main: NameId,
	integer: NameId,
	float: NameId,
	string: NameId,
	unit: NameId,
	list: NameId
}


-- Identifiers the parser recognises by identity where a declaration or
-- annotation begins: words the host also treats as names (GRAMMAR 1.4
-- reserves none of them). The program seed mints them, so every table
-- extended from it has these IDs.
fixed record ContextualWords {
	self_word: NameId,
	fixed_word: NameId,
	methods_word: NameId,
	int_word: NameId,
	float_word: NameId,
	string_word: NameId,
	void_word: NameId,
	list_word: NameId,
	tail_recursive_word: NameId
}


-- The wired-in names of the foundation's designated unions and their
-- constructors, and of the canonical operator traits and their members. The
-- foundation check finds Bool, Option and Result by these IDs in the foundation
-- module only, and the prelude selects Equatable, Orderable, the arithmetic
-- traits and Dict by them. A Dict literal calls the functions of these names
-- that Dict's own module declares. Elsewhere they are ordinary names.
fixed record FoundationWords {
	equatable_word: NameId,
	equals_word: NameId,
	not_equals_word: NameId,
	orderable_word: NameId,
	less_than_word: NameId,
	greater_than_word: NameId,
	less_than_or_equal_word: NameId,
	greater_than_or_equal_word: NameId,
	addable_word: NameId,
	add_word: NameId,
	subtractable_word: NameId,
	subtract_word: NameId,
	multipliable_word: NameId,
	multiply_word: NameId,
	divisible_word: NameId,
	divide_word: NameId,
	modulable_word: NameId,
	remainder_word: NameId,
	negatable_word: NameId,
	negate_word: NameId,
	bool_word: NameId,
	true_word: NameId,
	false_word: NameId,
	option_word: NameId,
	some_word: NameId,
	none_word: NameId,
	result_word: NameId,
	ok_word: NameId,
	err_word: NameId,
	dict_word: NameId,
	empty_word: NameId,
	-- The function `dict`; `dict_word` is the type `Dict`.
	dict_function_word: NameId,
	set_word: NameId
}


-- An ID is its spelling's position among `by_spelling`'s keys, and the
-- spelling's value is that same ID. Only `seed_word` and `intern_names` add
-- keys, each taking the ID from the length before its `set`; the seed's
-- spellings are distinct and `intern_names` sets only absent ones. Never
-- remove a name: positions would shift and `keys()` would copy. The table and
-- the seed's `words` live as long as the compilation.
private record NameRows {
	by_spelling: Dict[String, NameId],
	words: ContextualWords,
	foundation: FoundationWords
}


opaque type NameTable = NameRows


-- `ids` holds the ID of each given spelling, in the given order.
record InternedNames {
	names: NameTable,
	ids: List[NameId]
}


record InitialNames {
	names: NameTable,
	special: SpecialNames
}


record EntrypointNames {
	names: NameTable,
	main: NameId
}


private record SeededWord {
	by_spelling: Dict[String, NameId],
	id: NameId
}


-- Adds `spelling` to the seed and returns the ID it receives there.
private pure func seed_word(by_spelling: Dict[String, NameId], spelling: String) -> SeededWord:
	id = into_opaque NameId(by_spelling.length())
	{ by_spelling = by_spelling.set(spelling, id), id = id }


pure func program_names() -> EntrypointNames:
	-- The executable entrypoint is an ABI spelling. Types come from the designated foundation module.
	main = seed_word(D.empty(), "main")
	fixed_word = seed_word(main.by_spelling, "fixed")
	methods_word = seed_word(fixed_word.by_spelling, "methods")
	int_word = seed_word(methods_word.by_spelling, "Int")
	float_word = seed_word(int_word.by_spelling, "Float")
	string_word = seed_word(float_word.by_spelling, "String")
	void_word = seed_word(string_word.by_spelling, "Void")
	list_word = seed_word(void_word.by_spelling, "List")
	tail_recursive_word = seed_word(list_word.by_spelling, "tail_recursive")
	bool_word = seed_word(tail_recursive_word.by_spelling, "Bool")
	true_word = seed_word(bool_word.by_spelling, "True")
	false_word = seed_word(true_word.by_spelling, "False")
	option_word = seed_word(false_word.by_spelling, "Option")
	some_word = seed_word(option_word.by_spelling, "Some")
	none_word = seed_word(some_word.by_spelling, "None")
	result_word = seed_word(none_word.by_spelling, "Result")
	ok_word = seed_word(result_word.by_spelling, "Ok")
	err_word = seed_word(ok_word.by_spelling, "Err")
	self_word = seed_word(err_word.by_spelling, "Self")
	equatable_word = seed_word(self_word.by_spelling, "Equatable")
	equals_word = seed_word(equatable_word.by_spelling, "equals")
	not_equals_word = seed_word(equals_word.by_spelling, "not_equals")
	orderable_word = seed_word(not_equals_word.by_spelling, "Orderable")
	less_than_word = seed_word(orderable_word.by_spelling, "less_than")
	greater_than_word = seed_word(less_than_word.by_spelling, "greater_than")
	less_than_or_equal_word = seed_word(greater_than_word.by_spelling, "less_than_or_equal")
	greater_than_or_equal_word = seed_word(less_than_or_equal_word.by_spelling, "greater_than_or_equal")
	addable_word = seed_word(greater_than_or_equal_word.by_spelling, "Addable")
	add_word = seed_word(addable_word.by_spelling, "add")
	subtractable_word = seed_word(add_word.by_spelling, "Subtractable")
	subtract_word = seed_word(subtractable_word.by_spelling, "subtract")
	multipliable_word = seed_word(subtract_word.by_spelling, "Multipliable")
	multiply_word = seed_word(multipliable_word.by_spelling, "multiply")
	divisible_word = seed_word(multiply_word.by_spelling, "Divisible")
	divide_word = seed_word(divisible_word.by_spelling, "divide")
	modulable_word = seed_word(divide_word.by_spelling, "Modulable")
	remainder_word = seed_word(modulable_word.by_spelling, "remainder")
	negatable_word = seed_word(remainder_word.by_spelling, "Negatable")
	negate_word = seed_word(negatable_word.by_spelling, "negate")
	dict_word = seed_word(negate_word.by_spelling, "Dict")
	empty_word = seed_word(dict_word.by_spelling, "empty")
	dict_function_word = seed_word(empty_word.by_spelling, "dict")
	set_word = seed_word(dict_function_word.by_spelling, "set")
	words: ContextualWords = {
		self_word = self_word.id,
		fixed_word = fixed_word.id,
		methods_word = methods_word.id,
		int_word = int_word.id,
		float_word = float_word.id,
		string_word = string_word.id,
		void_word = void_word.id,
		list_word = list_word.id,
		tail_recursive_word = tail_recursive_word.id
	}
	foundation: FoundationWords = {
		equatable_word = equatable_word.id, equals_word = equals_word.id, not_equals_word = not_equals_word.id,
		orderable_word = orderable_word.id, less_than_word = less_than_word.id, greater_than_word = greater_than_word.id,
		less_than_or_equal_word = less_than_or_equal_word.id, greater_than_or_equal_word = greater_than_or_equal_word.id,
		addable_word = addable_word.id, add_word = add_word.id, subtractable_word = subtractable_word.id, subtract_word = subtract_word.id,
		multipliable_word = multipliable_word.id, multiply_word = multiply_word.id, divisible_word = divisible_word.id, divide_word = divide_word.id,
		modulable_word = modulable_word.id, remainder_word = remainder_word.id, negatable_word = negatable_word.id, negate_word = negate_word.id,
		bool_word = bool_word.id, true_word = true_word.id, false_word = false_word.id,
		option_word = option_word.id, some_word = some_word.id, none_word = none_word.id,
		result_word = result_word.id, ok_word = ok_word.id, err_word = err_word.id,
		dict_word = dict_word.id, empty_word = empty_word.id, dict_function_word = dict_function_word.id, set_word = set_word.id
	}
	{
		names = into_opaque NameTable({ by_spelling = set_word.by_spelling, words = words, foundation = foundation }),
		main = main.id
	}


pure func contextual_words(names: NameTable) -> ContextualWords:
	from_opaque NameTable(names).words


pure func foundation_words(names: NameTable) -> FoundationWords:
	from_opaque NameTable(names).foundation


-- An ID's position in its table: a dense key for tables indexed by spelling identity.
pure func name_number(id: NameId) -> Int:
	from_opaque NameId(id)


-- Assembly checks the complete spelling-to-ID mapping before accepting a
-- lexer extension. Independent or stale extensions cannot silently mix IDs.
-- IDs are key positions, so equal key lists are equal mappings.
pure func same_name_table(left: NameTable, right: NameTable) -> Bool:
	from_opaque NameTable(left).by_spelling.keys() == from_opaque NameTable(right).by_spelling.keys()


pure func name_spelling(names: NameTable, id: NameId) -> Option[String]:
	from_opaque NameTable(names).by_spelling.keys().get(from_opaque NameId(id))


-- Builds one extension locally: the first new spelling copies the shared
-- input table, and later ones grow the private copy in place.
pure func intern_names(names: NameTable, spellings: List[String]) -> InternedNames:
	rows = from_opaque NameTable(names)
	var known = rows.by_spelling
	var ids: List[NameId] = []

	for spelling in spellings:
		match known.get(spelling):
			Some(id):
				ids = ids.append(id)
			None:
				id = into_opaque NameId(known.length())
				ids = ids.append(id)
				known = known.set(spelling, id)

	{ names = into_opaque NameTable({ rows | by_spelling = known }), ids = ids }
