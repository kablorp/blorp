import:
	int as IntOps
	string as StringOps
	./text: equals


-- IDs are scoped to one table and its extensions, never to another parse.
opaque type NameId = Int


fixed record SpecialNames {
	main: NameId,
	integer: NameId,
	float: NameId,
	string: NameId,
	unit: NameId,
	list: NameId
}


-- Identifiers the parser recognises by identity where a declaration or
-- annotation begins: words the host also treats as names (GRAMMAR 1.4
-- reserves none of them). The program seed mints them, so every table
-- extended from it has these IDs. Reserved words are symbol tokens instead.
fixed record ContextualWords {
	fixed_word: NameId,
	methods_only_word: NameId,
	int_word: NameId,
	float_word: NameId,
	string_word: NameId,
	void_word: NameId,
	list_word: NameId,
	tail_recursive_word: NameId
}


-- `spellings` is the authority: an ID is its spelling's position. `buckets` is
-- an index derived only from `spellings` and written only while extending: a
-- spelling's bucket lists the IDs whose spellings hash there, and a lookup
-- compares complete spellings within that one bucket, so a collision costs a
-- comparison and never a wrong ID. Both live as long as the compilation, and
-- so do the seed's `words`.
private fixed record NameRows {
	spellings: List[String],
	buckets: List[List[NameId]],
	words: ContextualWords
}


opaque type NameTable = NameRows


-- `ids` holds the ID of each given spelling, in the given order.
fixed record InternedNames {
	names: NameTable,
	ids: List[NameId]
}


fixed record InitialNames {
	names: NameTable,
	special: SpecialNames
}


fixed record EntrypointNames {
	names: NameTable,
	main: NameId
}


-- Extending grows the bucket count from n to 2n+1 whenever names outnumber
-- buckets, so a bucket holds fewer than two IDs on average. Counts stay odd
-- because a remainder by a power of two would read only the hash's low bits,
-- which the multiplication below leaves poorly mixed.
private MINIMUM_BUCKETS: Int = 31

-- The 64-bit FNV offset basis and prime, adding each byte where FNV uses xor
-- (the subset has no bit operations). Int multiplication wraps.
private SPELLING_HASH_BASIS: Int = -3750763034362895579

private SPELLING_HASH_PRIME: Int = 1099511628211


-- Host `get` returns an Option even where the index is known to be in range.
-- Every `None` arm in `spelling_bucket`, `lookup` and `with_bucket_entry` is
-- unreachable: byte positions stay below the spelling's length, bucket
-- positions are remainders by the bucket count, and IDs are positions in
-- `spellings`.
private pure func spelling_bucket(spelling: String, bucket_count: Int) -> Int:
	var hash = SPELLING_HASH_BASIS
	var position: Int = 0

	while IntOps.less_than(position, spelling.length()):
		match StringOps.get(spelling, position):
			Some(byte):
				hash = IntOps.multiply(IntOps.add(hash, to_int(byte)), SPELLING_HASH_PRIME)
			None:
				void

		position = IntOps.add(position, 1)

	bucket = IntOps.remainder(hash, bucket_count)

	if IntOps.less_than(bucket, 0):
		IntOps.add(bucket, bucket_count)
	else:
		bucket


private pure func lookup(spellings: List[String], buckets: List[List[NameId]], spelling: String) -> Option[NameId]:
	var found: Option[NameId] = None

	match buckets.get(spelling_bucket(spelling, buckets.length())):
		Some(bucket):
			for id in bucket:
				match spellings.get(from_opaque NameId(id)):
					Some(known):
						if equals(known, spelling):
							found = Some(id)
							break
					None:
						void
		None:
			void

	found


private pure func with_bucket_entry(buckets: List[List[NameId]], spelling: String, id: NameId) -> List[List[NameId]]:
	bucket = spelling_bucket(spelling, buckets.length())
	empty: List[NameId] = []
	listed = match buckets.get(bucket):
		Some(ids): ids
		None: empty
	buckets.set(bucket, listed.append(id))


private pure func index_spellings(spellings: List[String], bucket_count: Int) -> List[List[NameId]]:
	var buckets: List[List[NameId]] = []

	while IntOps.less_than(buckets.length(), bucket_count):
		buckets = buckets.append([])

	var position: Int = 0

	for spelling in spellings:
		buckets = with_bucket_entry(buckets, spelling, into_opaque NameId(position))
		position = IntOps.add(position, 1)

	buckets


private fixed record SeededWord {
	spellings: List[String],
	id: NameId
}


-- Appends `spelling` to the seed and returns the ID it receives there.
private pure func seed_word(spellings: List[String], spelling: String) -> SeededWord:
	id = into_opaque NameId(spellings.length())
	{ spellings = spellings.append(spelling), id = id }


pure func program_names() -> EntrypointNames:
	-- The executable entrypoint is an ABI spelling. Types come from the designated foundation module.
	main = seed_word([], "main")
	fixed_word = seed_word(main.spellings, "fixed")
	methods_only_word = seed_word(fixed_word.spellings, "methods_only")
	int_word = seed_word(methods_only_word.spellings, "Int")
	float_word = seed_word(int_word.spellings, "Float")
	string_word = seed_word(float_word.spellings, "String")
	void_word = seed_word(string_word.spellings, "Void")
	list_word = seed_word(void_word.spellings, "List")
	tail_recursive_word = seed_word(list_word.spellings, "tail_recursive")
	spellings = tail_recursive_word.spellings
	words: ContextualWords = {
		fixed_word = fixed_word.id,
		methods_only_word = methods_only_word.id,
		int_word = int_word.id,
		float_word = float_word.id,
		string_word = string_word.id,
		void_word = void_word.id,
		list_word = list_word.id,
		tail_recursive_word = tail_recursive_word.id
	}
	{
		names = into_opaque NameTable({ spellings = spellings, buckets = index_spellings(spellings, MINIMUM_BUCKETS), words = words }),
		main = main.id
	}


pure func contextual_words(names: NameTable) -> ContextualWords:
	from_opaque NameTable(names).words


pure func same_name(left: NameId, right: NameId) -> Bool:
	IntOps.equals(from_opaque NameId(left), from_opaque NameId(right))


-- Assembly checks the complete spelling-to-ID mapping before accepting a
-- lexer extension. Independent or stale extensions cannot silently mix IDs.
-- The buckets are derived from the spellings, so the spellings decide.
pure func same_name_table(left: NameTable, right: NameTable) -> Bool:
	left_names = from_opaque NameTable(left).spellings
	right_names = from_opaque NameTable(right).spellings
	var equal = IntOps.equals(left_names.length(), right_names.length())
	var position: Int = 0
	for spelling in left_names:
		match right_names.get(position):
			Some(other):
				equal = equal and equals(spelling, other)
			None:
				equal = False
		position = IntOps.add(position, 1)
	equal


pure func name_spelling(names: NameTable, id: NameId) -> Option[String]:
	from_opaque NameTable(names).spellings.get(from_opaque NameId(id))


-- Builds one extension locally: after the first change copies the shared
-- input, the private lists grow in place, and the index is rebuilt only when
-- the bucket count grows.
pure func intern_names(names: NameTable, spellings: List[String]) -> InternedNames:
	rows = from_opaque NameTable(names)
	var known = rows.spellings
	var buckets = rows.buckets
	var ids: List[NameId] = []

	for spelling in spellings:
		match lookup(known, buckets, spelling):
			Some(id):
				ids = ids.append(id)
			None:
				id = into_opaque NameId(known.length())
				ids = ids.append(id)
				known = known.append(spelling)

				if IntOps.greater_than(known.length(), buckets.length()):
					grown_count = IntOps.add(IntOps.multiply(buckets.length(), 2), 1)
					buckets = index_spellings(known, grown_count)
				else:
					buckets = with_bucket_entry(buckets, spelling, id)

	{ names = into_opaque NameTable({ spellings = known, buckets = buckets, words = rows.words }), ids = ids }
