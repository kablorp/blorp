---
An insertion-ordered map from Hashable, Equatable keys to values, for compiler
tables; today every caller keys by Int ids such as `name_number`. It is a
stopgap: once Blorp has a dict implementation, this module is deleted and its
users move to it.

Keys and values keep insertion order in parallel lists and never move;
replacing a key keeps its position. An open-addressing index over the keys
finds one: its home slot is the key's Hashable hash modulo the slot count,
made non-negative, and probing is linear. The index doubles, rebuilt from the
keys, before it is
2/3 full, so a probe always ends at the key or at an empty slot. Like a List, a
map is a value: updated in place when unique, copied on write when shared.

`HashMap` is a plain record, so any importer can reach its fields: the host
miscompiles unwrapping a generic opaque value (CF-030 in
docs/COMPILER_FAULTS.md). Only this module builds or updates one. It becomes
opaque once CF-030 is fixed, unless the dict replaces it first.
---
import:
	bool: not
	int: Int methods
	list: repeat, List methods


-- A slot that holds no key's position. Slots are plain Ints because an
-- `Option[Int]` per slot boxed every position (9,724 allocations on a
-- one-line program, against 8,452).
private EMPTY_SLOT: Int = -1

-- At most LOAD_NUMERATOR / LOAD_DENOMINATOR of the slots hold keys.
private LOAD_NUMERATOR: Int = 2

private LOAD_DENOMINATOR: Int = 3

private MINIMUM_SLOTS: Int = 8


-- `values[i]` belongs to `keys[i]`. `slots[s]` is the position of the key whose
-- probe stops at s, or EMPTY_SLOT. A record declaration takes no bounds, so
-- the functions that create or search a map bound its key type. The
-- constructors' bound is the only check on what a map holds: importers can
-- still write this plain record directly (see CF-030 above).
record HashMap[K, V] {
	keys: List[K],
	values: List[V],
	slots: List[Int]
}


-- The fewest slots, doubling from MINIMUM_SLOTS, that hold `count` keys within
-- the load factor.
private pure func slot_count(count: Int) -> Int:
	var slots = MINIMUM_SLOTS
	while count.multiply(LOAD_DENOMINATOR).greater_than(slots.multiply(LOAD_NUMERATOR)):
		slots = slots.multiply(2)
	slots


pure func empty_hash_map[K: Hashable + Equatable, V]() -> HashMap[K, V]:
	hash_map_with_capacity(0)


-- A map that holds `capacity` keys before its index grows.
pure func hash_map_with_capacity[K: Hashable + Equatable, V](capacity: Int) -> HashMap[K, V]:
	no_values: List[V] = []
	{ keys = [], values = no_values, slots = repeat(EMPTY_SLOT, slot_count(capacity)) }


-- The slot holding `key`, or the empty slot where it belongs. Host `get`
-- returns an Option even in range: slots are remainders by the slot count and
-- hold key positions, so the defaults are never read.
private pure func probe[K: Hashable + Equatable, V](map: HashMap[K, V], key: K) -> Int:
	size = map.slots.length()
	remainder = key.hash().remainder(size)
	var slot = if remainder.less_than(0):
		remainder.add(size)
	else:
		remainder
	var searching: Bool = True
	while searching:
		searching = match map.keys.get(map.slots.get_or(slot, EMPTY_SLOT)):
			Some(found): found != key
			None: False
		if searching:
			slot = slot.add(1).remainder(size)
	slot


-- `map` with a new index of `size` slots, filled in key order.
private pure func reindexed[K: Hashable + Equatable, V](map: HashMap[K, V], size: Int) -> HashMap[K, V]:
	var rebuilt: HashMap[K, V] = { map | slots = repeat(EMPTY_SLOT, size) }
	var position = 0
	for key in map.keys:
		rebuilt = { rebuilt | slots = rebuilt.slots.set(probe(rebuilt, key), position) }
		position = position.add(1)
	rebuilt


pure func get[K: Hashable + Equatable, V](map: HashMap[K, V], key: K) -> Option[V]:
	map.values.get(map.slots.get_or(probe(map, key), EMPTY_SLOT))


-- Inserts `key` at the end of the order, or replaces its value in place. The
-- appending path builds a new record: one allocation, where an update of `map`
-- there makes the host copy all three lists.
pure func set[K: Hashable + Equatable, V](map: HashMap[K, V], key: K, value: V) -> HashMap[K, V]:
	slot = probe(map, key)
	position = map.slots.get_or(slot, EMPTY_SLOT)
	count = map.keys.length().add(1)
	size = map.slots.length()
	if position != EMPTY_SLOT:
		{ map | values = map.values.set(position, value) }
	else if count.multiply(LOAD_DENOMINATOR).greater_than(size.multiply(LOAD_NUMERATOR)):
		reindexed({ map | keys = map.keys.append(key), values = map.values.append(value) }, size.multiply(2))
	else:
		{ keys = map.keys.append(key), values = map.values.append(value), slots = map.slots.set(slot, map.keys.length()) }


-- Every value, in its key's insertion order.
pure func values[K, V](map: HashMap[K, V]) -> List[V]:
	map.values
