import:
	bool: and, not
	int: Int methods
	./source: ModuleId, module_number, same_module
	./syntax: ParsedConstant, ParsedFunction, ParsedTrait, ParsedTraitMethod(DefaultTraitMethod, AbstractTraitMethod), function_header, trait_method_span, FunctionHeader, ParsedImplementationHeader, ParsedFunctionGroup(FreeFunction, ImplementationGroup), function_group_module, ParsedOpaque, ParsedRecord, ParsedUnion, ParsedVariant, Visibility, WrittenName, TypeSyntax, Span


-- Declaration identities are dense ordinals in one sealed parsed program.
-- Import bindings retain these identities; they never issue another declaration.
opaque type FunctionId = Int

opaque type UnionId = Int

opaque type RecordId = Int

opaque type OpaqueId = Int

opaque type ConstantId = Int


opaque type TraitId = Int

opaque type ImplId = Int


private fixed record TraitMethodIdentity {
	owner: TraitId,
	position: Int
}


opaque type TraitMethodId = TraitMethodIdentity


pure func trait_number(id: TraitId) -> Int:
	from_opaque TraitId(id)


pure func impl_number(id: ImplId) -> Int:
	from_opaque ImplId(id)


pure func trait_method_owner(id: TraitMethodId) -> TraitId:
	from_opaque TraitMethodId(id).owner


pure func trait_method_number(id: TraitMethodId) -> Int:
	from_opaque TraitMethodId(id).position


pure func same_trait_method(left: TraitMethodId, right: TraitMethodId) -> Bool:
	and(trait_number(trait_method_owner(left)) == trait_number(trait_method_owner(right)), trait_method_number(left) == trait_method_number(right))


private fixed record VariantIdentity {
	owner: UnionId,
	position: Int
}


opaque type VariantId = VariantIdentity


private pure func function_id(position: Int) -> FunctionId:
	into_opaque FunctionId(position)


private pure func union_id(position: Int) -> UnionId:
	into_opaque UnionId(position)


private pure func record_id(position: Int) -> RecordId:
	into_opaque RecordId(position)


private pure func opaque_id(position: Int) -> OpaqueId:
	into_opaque OpaqueId(position)


private pure func constant_id(position: Int) -> ConstantId:
	into_opaque ConstantId(position)


private pure func variant_id(owner: UnionId, position: Int) -> VariantId:
	into_opaque VariantId({ owner = owner, position = position })


pure func function_number(id: FunctionId) -> Int:
	from_opaque FunctionId(id)


pure func union_number(id: UnionId) -> Int:
	from_opaque UnionId(id)


pure func record_number(id: RecordId) -> Int:
	from_opaque RecordId(id)


pure func opaque_number(id: OpaqueId) -> Int:
	from_opaque OpaqueId(id)


pure func constant_number(id: ConstantId) -> Int:
	from_opaque ConstantId(id)


pure func variant_owner(id: VariantId) -> UnionId:
	from_opaque VariantId(id).owner


pure func variant_number(id: VariantId) -> Int:
	from_opaque VariantId(id).position


union FunctionRole:
	FreeFunctionBody
	ImplementationBody
	TraitDefaultBody


record FunctionRow {
	id: FunctionId,
	role: FunctionRole,
	declaration: ParsedFunction
}


-- Required methods own their written header. A default refers to the sole
-- actual FunctionRow; it does not retain a second header or source body.
union TraitMethodDeclaration:
	RequiredMethod(FunctionHeader)
	DefaultMethod(FunctionId)


record TraitMethodRow {
	id: TraitMethodId,
	declaration: TraitMethodDeclaration,
	span: Span
}


record TraitRow {
	id: TraitId,
	module: ModuleId,
	visibility: Visibility,
	type_name: WrittenName,
	supertraits: List[TypeSyntax],
	methods: List[TraitMethodRow],
	span: Span
}


-- The sole implementation-to-body membership authority. A function's role only
-- prevents offering the body as an ordinary free function, with no backpointer.
record ImplRow {
	id: ImplId,
	header: ParsedImplementationHeader,
	methods: List[FunctionId]
}


record RecordRow {
	id: RecordId,
	declaration: ParsedRecord
}


record OpaqueRow {
	id: OpaqueId,
	declaration: ParsedOpaque
}


record ConstantRow {
	id: ConstantId,
	declaration: ParsedConstant
}


record VariantRow {
	id: VariantId,
	declaration: ParsedVariant
}


-- Replaces raw union syntax at publication, retaining only one variant vector.
record UnionRow {
	id: UnionId,
	module: ModuleId,
	visibility: Visibility,
	type_name: WrittenName,
	type_parameters: List[WrittenName],
	variants: List[VariantRow],
	fixed: Bool
}


private record DeclarationRows {
	functions: List[FunctionRow],
	traits: List[TraitRow],
	implementations: List[ImplRow],
	records: List[RecordRow],
	unions: List[UnionRow],
	opaques: List[OpaqueRow],
	constants: List[ConstantRow]
}


opaque type DeclarationInventory = DeclarationRows


-- The genuine inventory owns both alternatives. Missing/wrong-role defaults
-- remain explicit so callers can report a compiler invariant, never fabricate
-- an abstract header or infer one from a spelling.
pure func trait_method_header(method: TraitMethodRow, inventory: DeclarationInventory) -> Option[FunctionHeader]:
	match method.declaration:
		RequiredMethod(header): Some(header)
		DefaultMethod(id):
			match from_opaque DeclarationInventory(inventory).functions.get(function_number(id)):
				None: None
				Some(row):
					match row.role:
						TraitDefaultBody: Some(function_header(row.declaration))
						_: None


-- Assembly calls this once with complete syntax. Each local builder issues its
-- dense ordinal before appending, then the complete inventory freezes once.
pure func issue_inventory(
	functions: List[ParsedFunctionGroup],
	records: List[ParsedRecord],
	unions: List[ParsedUnion],
	opaques: List[ParsedOpaque],
	constants: List[ParsedConstant],
	traits: List[ParsedTrait],
) -> DeclarationInventory:
	var function_rows: List[FunctionRow] = []
	var trait_rows: List[TraitRow] = []
	var impl_rows: List[ImplRow] = []
	var record_rows: List[RecordRow] = []
	var union_rows: List[UnionRow] = []
	var opaque_rows: List[OpaqueRow] = []
	var constant_rows: List[ConstantRow] = []
	-- Both syntax lists follow module inventory order. Merge their cursors so a
	-- module's authored groups precede its defaults, including modules that have
	-- only traits. Relative authored and trait/member order never changes.
	var function_position = 0
	var trait_position = 0
	while True:
		next_module: Option[ModuleId] = match functions.get(function_position):
			None:
				match traits.get(trait_position):
					None: None
					Some(declaration): Some(declaration.module)
			Some(group):
				group_module = function_group_module(group)
				match traits.get(trait_position):
					None: Some(group_module)
					Some(declaration):
						if module_number(group_module).less_than_or_equal(module_number(declaration.module)):
							Some(group_module)
						else:
							Some(declaration.module)
		match next_module:
			None: break
			Some(module):
				while True:
					match functions.get(function_position):
						None: break
						Some(group):
							if same_module(function_group_module(group), module).not():
								break
							match group:
								FreeFunction(declaration):
									row: FunctionRow = { id = function_id(function_rows.length()), role = FreeFunctionBody, declaration = declaration }
									function_rows = function_rows.append(row)
								ImplementationGroup(header, methods):
									var method_ids: List[FunctionId] = []
									for declaration in methods:
										id = function_id(function_rows.length())
										row: FunctionRow = { id = id, role = ImplementationBody, declaration = declaration }
										function_rows = function_rows.append(row)
										method_ids = method_ids.append(id)
									implementation: ImplRow = { id = into_opaque ImplId(impl_rows.length()), header = header, methods = method_ids }
									impl_rows = impl_rows.append(implementation)
							function_position = function_position.add(1)
				while True:
					match traits.get(trait_position):
						None: break
						Some(declaration):
							if same_module(declaration.module, module).not():
								break
							owner = into_opaque TraitId(trait_rows.length())
							var methods: List[TraitMethodRow] = []
							for method in declaration.methods:
								id = into_opaque TraitMethodId({ owner = owner, position = methods.length() })
								written: TraitMethodDeclaration = match method:
									AbstractTraitMethod(header, _): RequiredMethod(header)
									DefaultTraitMethod(function, _):
										body_id = function_id(function_rows.length())
										function_row: FunctionRow = { id = body_id, role = TraitDefaultBody, declaration = function }
										function_rows = function_rows.append(function_row)
										DefaultMethod(body_id)
								row: TraitMethodRow = { id = id, declaration = written, span = trait_method_span(method) }
								methods = methods.append(row)
							trait_row: TraitRow = {
								id = owner, module = declaration.module, visibility = declaration.visibility,
								type_name = declaration.type_name, supertraits = declaration.supertraits, methods = methods, span = declaration.span
							}
							trait_rows = trait_rows.append(trait_row)
							trait_position = trait_position.add(1)
	for declaration in records:
		record_rows = record_rows.append({ id = record_id(record_rows.length()), declaration = declaration })
	for declaration in unions:
		owner = union_id(union_rows.length())
		var variants: List[VariantRow] = []
		for variant in declaration.variants:
			variants = variants.append({ id = variant_id(owner, variants.length()), declaration = variant })
		union_rows = union_rows.append({
			id = owner,
			module = declaration.module,
			visibility = declaration.visibility,
			type_name = declaration.type_name,
			type_parameters = declaration.type_parameters,
			variants = variants,
			fixed = declaration.fixed,
		})
	for declaration in opaques:
		opaque_rows = opaque_rows.append({ id = opaque_id(opaque_rows.length()), declaration = declaration })
	for declaration in constants:
		constant_rows = constant_rows.append({ id = constant_id(constant_rows.length()), declaration = declaration })
	into_opaque DeclarationInventory({
		functions = function_rows,
		traits = trait_rows,
		implementations = impl_rows,
		records = record_rows,
		unions = union_rows,
		opaques = opaque_rows,
		constants = constant_rows,
	})


pure func inventory_functions(inventory: DeclarationInventory) -> List[FunctionRow]:
	from_opaque DeclarationInventory(inventory).functions


pure func inventory_traits(inventory: DeclarationInventory) -> List[TraitRow]:
	from_opaque DeclarationInventory(inventory).traits


pure func inventory_implementations(inventory: DeclarationInventory) -> List[ImplRow]:
	from_opaque DeclarationInventory(inventory).implementations


pure func inventory_records(inventory: DeclarationInventory) -> List[RecordRow]:
	from_opaque DeclarationInventory(inventory).records


pure func inventory_unions(inventory: DeclarationInventory) -> List[UnionRow]:
	from_opaque DeclarationInventory(inventory).unions


pure func inventory_opaques(inventory: DeclarationInventory) -> List[OpaqueRow]:
	from_opaque DeclarationInventory(inventory).opaques


pure func inventory_constants(inventory: DeclarationInventory) -> List[ConstantRow]:
	from_opaque DeclarationInventory(inventory).constants


union NominalRow:
	UnionDeclarationRow(UnionRow)
	RecordDeclarationRow(RecordRow)
	OpaqueDeclarationRow(OpaqueRow)


private pure func declaration_precedes(first_module: ModuleId, first_start: Int, second_module: ModuleId, second_start: Int) -> Bool:
	if same_module(first_module, second_module):
		first_start.less_than(second_start)
	else:
		module_number(first_module).less_than(module_number(second_module))


-- Source-order projection without a second declaration-order table. The three
-- counters are traversal positions, never identities. Read at most three rows.
pure func next_nominal(inventory: DeclarationInventory, records_seen: Int, unions_seen: Int, opaques_seen: Int) -> Option[NominalRow]:
	rows = from_opaque DeclarationInventory(inventory)
	match rows.records.get(records_seen):
		None:
			match rows.unions.get(unions_seen):
				None:
					match rows.opaques.get(opaques_seen):
						None: None
						Some(row): Some(OpaqueDeclarationRow(row))
				Some(union_row):
					match rows.opaques.get(opaques_seen):
						None: Some(UnionDeclarationRow(union_row))
						Some(opaque_row):
							if declaration_precedes(union_row.module, union_row.type_name.span.start, opaque_row.declaration.module, opaque_row.declaration.type_name.span.start):
								Some(UnionDeclarationRow(union_row))
							else:
								Some(OpaqueDeclarationRow(opaque_row))
		Some(record_row):
			match rows.unions.get(unions_seen):
				None:
					match rows.opaques.get(opaques_seen):
						None: Some(RecordDeclarationRow(record_row))
						Some(opaque_row):
							if declaration_precedes(record_row.declaration.module, record_row.declaration.type_name.span.start, opaque_row.declaration.module, opaque_row.declaration.type_name.span.start):
								Some(RecordDeclarationRow(record_row))
							else:
								Some(OpaqueDeclarationRow(opaque_row))
				Some(union_row):
					record_first = declaration_precedes(record_row.declaration.module, record_row.declaration.type_name.span.start, union_row.module, union_row.type_name.span.start)
					match rows.opaques.get(opaques_seen):
						None:
							if record_first:
								Some(RecordDeclarationRow(record_row))
							else:
								Some(UnionDeclarationRow(union_row))
						Some(opaque_row):
							if and(
								record_first,
								declaration_precedes(record_row.declaration.module, record_row.declaration.type_name.span.start, opaque_row.declaration.module, opaque_row.declaration.type_name.span.start),
							):
								Some(RecordDeclarationRow(record_row))
							else if declaration_precedes(union_row.module, union_row.type_name.span.start, opaque_row.declaration.module, opaque_row.declaration.type_name.span.start):
								Some(UnionDeclarationRow(union_row))
							else:
								Some(OpaqueDeclarationRow(opaque_row))
