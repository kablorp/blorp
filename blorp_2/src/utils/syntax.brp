import:
	./boolean: not, and
	int: Int methods_only
	./names: NameId, NameTable
	./source: compiler_source, ModuleId, SourceId, same_source


-- Source spans are half-open byte ranges; spelling belongs to the name table.
fixed record Span {
	source: SourceId,
	start: Int,
	end: Int
}


pure func same_span(left: Span, right: Span) -> Bool:
	and(
		and(
			same_source(left.source, right.source),
			left.start.equals(right.start),
		),
		left.end.equals(right.end),
	)


fixed union DiagnosticNote:
	NoteLines(List[NoteLine])
	PreviousDeclaration(Span)
	CompetingDeclarations(List[Span])
	UnionPayloadDeclaration(Span)
	TypeDeclaration(Span)
	RecordFieldDeclaration(Span)
	PreviousField(Span)
	Declaration(Span)


fixed record NoteLine {
	span: Span,
	text: String
}


fixed record Diagnostic {
	span: Span,
	note: Option[DiagnosticNote],
	message: String,
	help: String
}


-- Every phase builds its noteless diagnostics through this one shape.
pure func diagnostic(span: Span, message: String, help: String) -> Diagnostic:
	{
		span = span,
		note = None,
		message = message,
		help = help
	}


-- An inconsistent source bundle is a compiler input error, not a source error.
pure func source_bundle_error(message: String) -> Diagnostic:
	diagnostic(
		{ source = compiler_source(), start = 0, end = 0 },
		message,
		"load each module once in inventory order and supply every import target",
	)


fixed record Diagnostics {
	first: Diagnostic,
	remaining: List[Diagnostic]
}


pure func singleton_diagnostic(error: Diagnostic) -> Diagnostics:
	{
		first = error,
		remaining = []
	}


fixed union Keyword:
	PureKeyword
	FunctionKeyword
	MatchKeyword
	VarKeyword
	VoidKeyword
	-- The declaration words the host reserves (GRAMMAR 1.4).
	ImportKeyword
	TypeKeyword
	PrivateKeyword
	RecordKeyword
	UnionKeyword
	BuiltinKeyword
	AsKeyword
	OpaqueKeyword
	IntoOpaqueKeyword
	FromOpaqueKeyword
	-- The reserved words of the expression forms, read ahead of their
	-- semantics: `if else and or not while for in break continue`.
	IfKeyword
	ElseKeyword
	AndKeyword
	OrKeyword
	NotKeyword
	WhileKeyword
	ForKeyword
	InKeyword
	BreakKeyword
	ContinueKeyword
	ImplementsKeyword
	TraitKeyword
	-- Reserved by the host for forms this compiler does not read; they are
	-- keywords so that they can never be names.
	AliasKeyword
	DebugKeyword
	DetachKeyword
	ForeignKeyword
	FromKeyword
	ResourceKeyword
	SelectKeyword
	TryKeyword
	WhereKeyword


fixed union Symbol:
	AtSign
	Equals
	EqualsEquals
	NotEquals
	-- `?=`, the propagating binding's operator.
	QuestionEquals
	Wildcard
	LeftParen
	RightParen
	LeftBracket
	RightBracket
	LeftBrace
	RightBrace
	-- `|`: the record update bar, or the separator of or-pattern alternatives.
	Bar
	Dot
	Slash
	Star
	Plus
	Comma
	Arrow
	Colon
	-- `..` between two operands is a range.
	DotDot
	-- `...` before a list pattern's rest.
	Ellipsis
	-- Layout: each code line ends with Newline; a line deeper than the
	-- innermost open level starts with Indent and opens its level, and a
	-- shallower line starts with one Dedent per closed level and must land on
	-- an open level. The lexer owns every depth decision.
	Newline
	Indent
	Dedent


-- QuotedString holds the raw contents the parser decodes; PipeString holds
-- the joined lines of a pipe or raw block, which have no escapes to decode.
-- An interpolated value instead has flat boundaries, source-located text
-- segments and ordinary code tokens between each hole's open and close.
-- CharLiteral carries no contents until a Char type reads them.
fixed union TokenKind:
	IdentifierToken(NameId)
	KeywordToken(Keyword)
	SymbolToken(Symbol)
	IntegerLiteral(String)
	FloatLiteral(String)
	QuotedString(String)
	PipeString(String)
	StringStart(StringForm)
	StringSegment(String)
	InterpolationOpen
	InterpolationClose
	StringEnd
	CharLiteral


fixed union StringForm:
	QuotedStringForm
	PipeStringForm


-- Whether a space or tab byte immediately precedes the token's first byte.
-- Syntax that requires or forbids separation reads this instead of offsets.
fixed union Spacing:
	Adjacent
	Spaced


-- UTF-8 continuation bytes 80..BF (10xxxxxx) follow a scalar's lead byte.
UTF8_CONTINUATION_START: Int = 128

UTF8_CONTINUATION_END: Int = 191


fixed record Token {
	kind: TokenKind,
	span: Span,
	spacing: Spacing
}


-- `base_names` is the table lexing was given; `names` adds the source's
-- identifier spellings, so an identifier's ID is fixed when its token is made.
-- Source text is shared until parsing finishes, only for written diagnostics.
fixed record LexedProgram {
	source_text: String,
	tokens: List[Token],
	end: Span,
	base_names: NameTable,
	names: NameTable
}


fixed record WrittenName {
	id: NameId,
	span: Span
}


-- A name written as `Module.name`. In a value the parser mints it only when
-- Module is a module alias of the import block; in a type a dot can only
-- qualify, so no alias check is needed. Nothing recovers it from a spelling.
fixed record ParsedQualified {
	module: WrittenName,
	name: WrittenName
}


fixed union TypeSyntax:
	AtomicType(WrittenName)
	AppliedType(WrittenName, List[TypeSyntax], Span)
	QualifiedType(ParsedQualified, List[TypeSyntax], Span)
	CallableTypeSyntax(Purity, List[TypeSyntax], TypeSyntax, Span)
	TupleTypeSyntax(List[TypeSyntax], Span)


pure func type_span(written: TypeSyntax) -> Span:
	match written:
		AtomicType(name):
			name.span
		AppliedType(_, _, span):
			span
		QualifiedType(_, _, span):
			span
		CallableTypeSyntax(_, _, _, span):
			span
		TupleTypeSyntax(_, span):
			span


fixed record ParsedParameter {
	name: WrittenName,
	type_name: TypeSyntax
}


-- Closed equality punctuation; canonical method selection belongs to Check.
fixed union EqualityOperator:
	EqualOperator
	NotEqualOperator


-- The binary Boolean operators, lowest precedence first: `or`, then `and`.
fixed union LogicalOperator:
	OrOperator
	AndOperator


fixed union ExpressionBase:
	VoidExpression
	IntegerExpression(Int)
	FloatExpression(Float)
	StringExpression(String)
	-- Decoded located text expressions and ordinary hole expressions, in order.
	InterpolatedString(List[ValueExpression])
	NameExpression(WrittenName)
	DirectApplication(WrittenName, List[ValueExpression])
	QualifiedName(ParsedQualified)
	QualifiedApplication(ParsedQualified, List[ValueExpression])
	-- `into_opaque Name(value)` and `from_opaque Name(value)`.
	OpaqueWrap(WrittenName, ValueExpression)
	OpaqueUnwrap(WrittenName, ValueExpression)
	-- `[a, b]` or `[]`: one fresh List of these elements, checked to one element type.
	ListExpression(List[ValueExpression])
	-- Structural ordered fields; Parse admits exactly two to four elements.
	TupleExpression(List[ValueExpression])
	-- `low..high`; rejected until the loops milestone wires it into for.
	RangeExpression(ValueExpression, ValueExpression)
	-- The token span locates dispatch errors independently of operand spans.
	EqualityExpression(EqualityOperator, Span, ValueExpression, ValueExpression)
	-- Unsupported Boolean forms retain their syntax for diagnostics.
	LogicalExpression(LogicalOperator, ValueExpression, ValueExpression)
	NotExpression(ValueExpression)
	-- `if condition:` with its blocks, in value and statement positions
	-- alike; rejected until the join milestone.
	IfExpression(ParsedIf)
	-- A bound, nested or statement `match`; the function's tail match stays
	-- ParsedMatchBody. Rejected until the join milestone.
	MatchExpression(ParsedMatch)
	-- `[pure] func(params) [-> Type]: body`; rejected until the lambdas milestone.
	LambdaExpression(ParsedLambda)
	RecordExpression(List[ParsedRecordField])
	RecordUpdateExpression(ValueExpression, List[ParsedRecordField])


fixed record ReceiverApplication {
	span: Span,
	callee: WrittenName,
	arguments: List[ValueExpression]
}


fixed union PostfixOperation:
	ReceiverInvocation(ReceiverApplication)
	FieldAccess(WrittenName)
	-- Check establishes tuple identity and a literal in-range ordinal.
	TupleIndex(ValueExpression, Span)


fixed record ParsedRecordField {
	name: WrittenName,
	value: ValueExpression
}


-- Direct call children and postfix explicit arguments retain source order.
fixed record ValueExpression {
	base: ExpressionBase,
	base_span: Span,
	applications: List[PostfixOperation],
	span: Span
}


-- Whether a declaration is visible outside its module. Private carries the
-- keyword's span; until the namespace milestone, checking rejects it there.
fixed union Visibility:
	Public
	Private(Span)


-- The function owns its execution contract; callable signatures do not.
fixed union FunctionExecution:
	OrdinaryCalls
	SelfTailLoop(Span)


fixed union Purity:
	Pure
	Impure


-- A pure value can be used with impure permission, never the reverse.
pure func permits_purity(expected: Purity, actual: Purity) -> Bool:
	match expected:
		Impure: True
		Pure: same_purity(actual, Pure)


-- Bounds are written only on function and implementation-receiver binders.
-- Nominal declaration parameters keep their existing unbounded syntax.
fixed record ParsedTypeParameter {
	name: WrittenName,
	bounds: List[TypeSyntax]
}


fixed record FunctionHeader {
	purity: Purity,
	function_name: WrittenName,
	type_parameters: List[ParsedTypeParameter],
	parameters: List[ParsedParameter],
	return_type: Option[TypeSyntax]
}


fixed union ParsedBuiltinType:
	IntegerBuiltin(WrittenName)
	FloatBuiltin(WrittenName)
	StringBuiltin(WrittenName)
	VoidBuiltin(WrittenName)
	ListBuiltin(WrittenName)


-- Signature acceptance owns the process ABI. Later phases translate only the
-- function identity; they do not infer an entry convention from its parameters.
fixed union EntryResult:
	IntegerExitStatus
	SuccessfulExit


fixed union Entrypoint[Function]:
	NoArguments(Function, EntryResult)
	WithArguments(Function, EntryResult)


pure func entry_function[Function](entry: Entrypoint[Function]) -> Function:
	match entry:
		NoArguments(function, _): function
		WithArguments(function, _): function


fixed union ParsedRuntimeOperation:
	IntegerAddBuiltin
	IntegerSubtractBuiltin
	IntegerMultiplyBuiltin
	IntegerDivideBuiltin
	IntegerRemainderBuiltin
	IntegerToStringBuiltin
	FloatAddBuiltin
	FloatSubtractBuiltin
	FloatMultiplyBuiltin
	FloatDivideBuiltin
	FloatRemainderBuiltin
	FloatToStringBuiltin
	FloatCopySignBuiltin
	FloatEqualsBuiltin
	FloatLessThanBuiltin
	FloatIsNaNBuiltin
	FloatIsFiniteBuiltin
	StringLengthBuiltin
	StringConcatBuiltin
	StringAppendIntBuiltin
	StringPrintBuiltin
	StringPrintErrorBuiltin
	StringParseIntBuiltin
	StringParseFloatBuiltin
	StringByteAtBuiltin
	StringFromCodepointBuiltin
	StringSliceBuiltin
	GetCurrentDirectoryBuiltin
	ReadFileBuiltin
	WriteFileBuiltin
	RunToFilesBuiltin
	ListRepeatBuiltin
	ListLengthBuiltin
	ListGetBuiltin
	ListAppendBuiltin
	ListSetBuiltin
	ListConcatBuiltin
	StringEqualsBuiltin
	IntegerEqualsBuiltin
	IntegerLessThanBuiltin


pure func same_purity(left: Purity, right: Purity) -> Bool:
	match left:
		Pure:
			is_pure(right)
		Impure:
			is_pure(right).not()


private pure func is_pure(purity: Purity) -> Bool:
	match purity:
		Pure:
			True
		Impure:
			False


-- A constructor pattern's head: bare, or qualified by a module alias. A bare
-- name's meaning (constructor or binding) is resolved by the checker
-- against the matched type, as in the host; no lexical class decides it.
fixed union PatternHead:
	BareHead(WrittenName)
	QualifiedHead(ParsedQualified)


-- `...rest` or `..._` ending a list pattern.
fixed union SpreadTarget:
	SpreadName(WrittenName)
	SpreadWildcard(Span)


-- Constructor and List fields contain recursive patterns. Check resolves
-- constructor identities, canonical alternative binders and exact String bytes.
-- PatternChar carries no contents until a Char type reads them.
fixed union ParsedPattern:
	PatternName(WrittenName)
	PatternWildcard(Span)
	PatternConstructor(PatternHead, List[ParsedPattern], Span)
	PatternOr(List[ParsedPattern], Span)
	PatternList(List[ParsedPattern], Option[SpreadTarget], Span)
	PatternTuple(List[ParsedPattern], Span)
	PatternString(String, Span)
	PatternChar(Span)


pure func pattern_span(pattern: ParsedPattern) -> Span:
	match pattern:
		PatternName(name):
			name.span
		PatternWildcard(span):
			span
		PatternConstructor(_, _, span):
			span
		PatternOr(_, span):
			span
		PatternList(_, _, span):
			span
		PatternTuple(_, span):
			span
		PatternString(_, span):
			span
		PatternChar(span):
			span


-- An indented block: its statements, then its value when the last item is
-- an expression. Whether a block without a value is allowed where it
-- stands is the checker's decision; the parser accepts it.
fixed record ParsedBlock {
	statements: List[ParsedStatement],
	value: Option[ValueExpression],
	span: Span
}


fixed record ParsedMatchArm {
	pattern: ParsedPattern,
	block: ParsedBlock,
	span: Span
}


-- A lambda parameter or loop variable binds a name or discards its value
-- with `_` (the host's binder_name).
fixed union ParsedBinder:
	NamedBinder(WrittenName)
	DiscardBinder(Span)


-- Tuple declarations and loops are flat: their elements cannot be tuples or
-- arbitrary patterns. Lambda parameters continue to use only ParsedBinder.
fixed union ForBinder:
	SingleForBinder(ParsedBinder)
	TupleForBinder(List[ParsedBinder], Span)


-- A lambda parameter's annotation is optional, unlike a function
-- parameter's.
fixed record LambdaParameter {
	binder: ParsedBinder,
	annotation: Option[TypeSyntax]
}


-- A lambda's body is one expression on the header's line, or an indented
-- block (a bracketed block when the lambda stands inside brackets).
fixed union LambdaBody:
	InlineBody(ValueExpression)
	BlockBody(ParsedBlock)


fixed record ParsedLambda {
	purity: Purity,
	parameters: List[LambdaParameter],
	return_type: Option[TypeSyntax],
	body: LambdaBody,
	span: Span
}


-- `if condition:` block, then nothing, `else:` block, or `else if ...`,
-- which nests the next if-expression (the host's else_branch). The span
-- runs from `if` to the end of the last block.
fixed record ParsedIf {
	condition: ValueExpression,
	then_block: ParsedBlock,
	else_branch: Option[ElseBranch],
	span: Span
}


fixed union ElseBranch:
	ElseIf(ParsedIf)
	ElseBlock(ParsedBlock)


fixed record ParsedMatch {
	scrutinee: ValueExpression,
	arms: List[ParsedMatchArm],
	keyword_span: Span,
	span: Span
}


fixed union ParsedBody:
	ParsedBuiltinBody(ParsedRuntimeOperation, Span)
	ParsedValueBody(ValueExpression)
	ParsedMatchBody(ParsedMatch)


-- `annotation` is the written type of `name: Type = value`; rejected until
-- the join milestone gives bindings an expected type. `mutable` is True when
-- the binding was written with `var`.
fixed record ParsedBinding {
	name: WrittenName,
	annotation: Option[TypeSyntax],
	mutable: Bool,
	initializer: ValueExpression
}


-- `name ?= value`: binds the success payload or returns the failure. A
-- statement kind of its own, not a binding, because it is control
-- flow; rejected until the join milestone.
fixed record ParsedPropagation {
	name: WrittenName,
	annotation: Option[TypeSyntax],
	value: ValueExpression,
	span: Span
}


-- `while condition:` and `for name in iterable:` with their bodies. Loops
-- are statements with no value, as are `break` and `continue`, which the
-- parser admits only inside a loop body; all are rejected by checking
-- until the loops milestone.
fixed record ParsedWhile {
	condition: ValueExpression,
	body: ParsedBlock,
	span: Span
}


fixed record ParsedFor {
	binder: ForBinder,
	iterable: ValueExpression,
	body: ParsedBlock,
	span: Span
}


fixed union ParsedStatement:
	BindingStatement(ParsedBinding)
	TupleBinding(List[ParsedBinder], ValueExpression, Span)
	PropagatingBinding(ParsedPropagation)
	ExpressionStatement(ValueExpression)
	WhileLoop(ParsedWhile)
	ForLoop(ParsedFor)
	Break(Span)
	Continue(Span)


fixed record ParsedFunction {
	module: ModuleId,
	visibility: Visibility,
	tail_annotation: Option[Span],
	purity: Purity,
	function_name: WrittenName,
	type_parameters: List[ParsedTypeParameter],
	parameters: List[ParsedParameter],
	return_type: Option[TypeSyntax],
	statements: List[ParsedStatement],
	body: ParsedBody
}


-- A default owns actual parsed function syntax until inventory publishes its
-- genuine body row. An abstract method never receives a function identity.
fixed union ParsedTraitMethod:
	AbstractTraitMethod(FunctionHeader, Span)
	DefaultTraitMethod(ParsedFunction, Span)


-- A borrowed source view of an actual parsed function; never retained again
-- alongside that function's genuine inventory identity.
pure func function_header(function: ParsedFunction) -> FunctionHeader:
	{
		purity = function.purity,
		function_name = function.function_name,
		type_parameters = function.type_parameters,
		parameters = function.parameters,
		return_type = function.return_type
	}


pure func trait_method_span(method: ParsedTraitMethod) -> Span:
	match method:
		AbstractTraitMethod(_, span): span
		DefaultTraitMethod(_, span): span


fixed record ParsedTrait {
	module: ModuleId,
	visibility: Visibility,
	type_name: WrittenName,
	methods: List[ParsedTraitMethod],
	span: Span
}


-- An implementation introduces binders, unlike an ordinary applied value type.
-- Check validates head arity, freshness and the full-family restriction.
fixed union ParsedReceiverHead:
	ReceiverName(WrittenName)
	QualifiedReceiverName(ParsedQualified)


pure func receiver_head_span(head: ParsedReceiverHead) -> Span:
	match head:
		ReceiverName(name): name.span
		QualifiedReceiverName(name): { name.module.span | end = name.name.span.end }


fixed record ParsedImplementationHeader {
	module: ModuleId,
	visibility: Visibility,
	trait_name: TypeSyntax,
	receiver: ParsedReceiverHead,
	type_parameters: List[ParsedTypeParameter],
	span: Span
}


-- Written order and one body owner survive Parse/assembly until inventory issues
-- real function IDs and replaces each implementation's bodies with those IDs.
fixed union ParsedFunctionGroup:
	FreeFunction(ParsedFunction)
	ImplementationGroup(ParsedImplementationHeader, List[ParsedFunction])


pure func function_group_module(group: ParsedFunctionGroup) -> ModuleId:
	match group:
		FreeFunction(function): function.module
		ImplementationGroup(header, _): header.module


fixed record ParsedVariant {
	name: WrittenName,
	fields: List[TypeSyntax]
}


fixed record ParsedUnion {
	module: ModuleId,
	visibility: Visibility,
	type_name: WrittenName,
	type_parameters: List[WrittenName],
	variants: List[ParsedVariant]
}


-- `NAME: Type = value` at module level, before assembly issues its identity.
fixed record ParsedConstant {
	module: ModuleId,
	visibility: Visibility,
	name: WrittenName,
	type_name: TypeSyntax,
	value: ValueExpression
}


-- `opaque type Name = Underlying`; assembly issues its declaration identity.
fixed record ParsedOpaque {
	module: ModuleId,
	visibility: Visibility,
	type_name: WrittenName,
	underlying: TypeSyntax
}


fixed record ParsedRecord {
	module: ModuleId,
	visibility: Visibility,
	type_name: WrittenName,
	type_parameters: List[WrittenName],
	fields: List[ParsedParameter]
}
