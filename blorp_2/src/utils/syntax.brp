import:
	int as IntOps
	./names: NameId, NameTable
	./source: COMPILER_SOURCE, ModuleId, SourceId, same_source


-- Source spans are half-open byte ranges; spelling belongs to the name table.
fixed record Span {
	source: SourceId,
	start: Int,
	end: Int
}


pure func same_span(left: Span, right: Span) -> Bool:
	(
		same_source(left.source, right.source)
		and IntOps.equals(left.start, right.start)
		and IntOps.equals(left.end, right.end)
	)


fixed union DiagnosticNote:
	PreviousDeclaration(Span)
	CompetingDeclarations(List[Span])
	UnionPayloadDeclaration(Span)
	TypeDeclaration(Span)
	RecordFieldDeclaration(Span)
	PreviousField(Span)


fixed record Diagnostic {
	span: Span,
	note: Option[DiagnosticNote],
	message: String,
	help: String
}


-- Every phase builds its noteless diagnostics through this one shape.
pure func diagnostic(span: Span, message: String, help: String) -> Diagnostic:
	{
		span = span,
		note = None,
		message = message,
		help = help
	}


-- An inconsistent source bundle is a compiler input error, not a source error.
pure func source_bundle_error(message: String) -> Diagnostic:
	diagnostic(
		{ source = COMPILER_SOURCE, start = 0, end = 0 },
		message,
		"load each module once in inventory order and supply every import target",
	)


fixed record Diagnostics {
	first: Diagnostic,
	remaining: List[Diagnostic]
}


pure func singleton_diagnostic(error: Diagnostic) -> Diagnostics:
	{
		first = error,
		remaining = []
	}


fixed union Symbol:
	AtSign
	PureKeyword
	FunctionKeyword
	MatchKeyword
	VarKeyword
	VoidKeyword
	Equals
	Wildcard
	LeftParen
	RightParen
	LeftBracket
	RightBracket
	LeftBrace
	RightBrace
	RecordUpdateBar
	Dot
	Slash
	Star
	Comma
	Arrow
	Colon
	-- Layout: each code line ends with Newline; a line one level deeper than
	-- the previous code line starts with Indent, and a shallower line starts
	-- with one Dedent per closed level. The lexer owns every depth decision.
	Newline
	Indent
	Dedent


-- QuotedString holds the raw contents the parser decodes; PipeString holds
-- the joined lines of a pipe or raw block, which have no escapes to decode.
-- CharLiteral carries no contents until a Char type reads them.
fixed union TokenKind:
	IdentifierToken(String)
	SymbolToken(Symbol)
	IntegerLiteral(String)
	FloatLiteral(String)
	QuotedString(String)
	PipeString(String)
	CharLiteral


-- Whether a space or tab byte immediately precedes the token's first byte.
-- Syntax that requires or forbids separation reads this instead of offsets.
fixed union Spacing:
	Adjacent
	Spaced


DECIMAL_DIGITS: String = "0123456789"

-- UTF-8 continuation bytes 80..BF (10xxxxxx) follow a scalar's lead byte.
UTF8_CONTINUATION_START: Int = 128

UTF8_CONTINUATION_END: Int = 191


fixed record Token {
	kind: TokenKind,
	span: Span,
	spacing: Spacing
}


fixed record LexedProgram {
	tokens: List[Token],
	end: Span
}


fixed record WrittenName {
	id: NameId,
	span: Span
}


fixed union TypeSyntax:
	AtomicType(WrittenName)
	AppliedType(WrittenName, List[TypeSyntax], Span)


pure func type_span(written: TypeSyntax) -> Span:
	match written:
		AtomicType(name):
			name.span
		AppliedType(_, _, span):
			span


fixed record ParsedParameter {
	name: WrittenName,
	type_name: TypeSyntax
}


fixed union ExpressionBase:
	VoidExpression
	IntegerExpression(Int)
	FloatExpression(Float)
	StringExpression(String)
	NameExpression(WrittenName)
	DirectApplication(WrittenName, List[ValueExpression])
	RecordExpression(List[ParsedRecordField])
	RecordUpdateExpression(ValueExpression, List[ParsedRecordField])


fixed union CallNotation:
	DirectCall
	ReceiverCall


fixed record ReceiverApplication {
	span: Span,
	callee: WrittenName,
	arguments: List[ValueExpression]
}


fixed union PostfixOperation:
	ReceiverInvocation(ReceiverApplication)
	FieldAccess(WrittenName)


fixed record ParsedRecordField {
	name: WrittenName,
	value: ValueExpression
}


-- Direct call children and postfix explicit arguments retain source order.
fixed record ValueExpression {
	base: ExpressionBase,
	base_span: Span,
	applications: List[PostfixOperation],
	span: Span
}


-- The function owns its execution contract; callable signatures do not.
fixed union FunctionExecution:
	OrdinaryCalls
	SelfTailLoop(Span)


fixed union Purity:
	Pure
	Impure


fixed record FunctionHeader {
	purity: Purity,
	function_name: WrittenName,
	type_parameters: List[WrittenName],
	parameters: List[ParsedParameter],
	return_type: Option[TypeSyntax]
}


fixed union ParsedBuiltinType:
	IntegerBuiltin(WrittenName)
	FloatBuiltin(WrittenName)
	StringBuiltin(WrittenName)
	VoidBuiltin(WrittenName)
	ListBuiltin(WrittenName)


-- Signature acceptance owns the process ABI. Later phases translate only the
-- function identity; they do not infer an entry convention from its parameters.
fixed union EntryResult:
	IntegerExitStatus
	SuccessfulExit


fixed union Entrypoint[Function]:
	NoArguments(Function, EntryResult)
	WithArguments(Function, EntryResult)


pure func entry_function[Function](entry: Entrypoint[Function]) -> Function:
	match entry:
		NoArguments(function, _): function
		WithArguments(function, _): function


fixed union ParsedRuntimeOperation:
	IntegerAddBuiltin
	IntegerSubtractBuiltin
	IntegerMultiplyBuiltin
	IntegerDivideBuiltin
	IntegerRemainderBuiltin
	IntegerToStringBuiltin
	FloatAddBuiltin
	FloatSubtractBuiltin
	FloatMultiplyBuiltin
	FloatDivideBuiltin
	FloatRemainderBuiltin
	FloatToStringBuiltin
	StringLengthBuiltin
	StringPrintBuiltin
	StringParseIntBuiltin(WrittenName, WrittenName)
	StringParseFloatBuiltin(WrittenName, WrittenName)
	ListRepeatBuiltin
	ListLengthBuiltin
	ListGetBuiltin(WrittenName, WrittenName)
	StringEqualsBuiltin(WrittenName, WrittenName)
	IntegerEqualsBuiltin(WrittenName, WrittenName)


pure func same_purity(left: Purity, right: Purity) -> Bool:
	match left:
		Pure:
			is_pure(right)
		Impure:
			not is_pure(right)


private pure func is_pure(purity: Purity) -> Bool:
	match purity:
		Pure:
			True
		Impure:
			False


fixed union FieldPattern:
	FieldName(WrittenName)
	FieldWildcard(Span)


fixed union ParsedPattern:
	PatternName(WrittenName)
	PatternWildcard(Span)
	PatternConstructor(WrittenName, List[FieldPattern], Span)


fixed record ParsedMatchArm {
	pattern: ParsedPattern,
	statements: List[ParsedStatement],
	body: ValueExpression,
	span: Span
}


fixed record ParsedMatch {
	scrutinee: ValueExpression,
	arms: List[ParsedMatchArm],
	keyword_span: Span,
	span: Span
}


fixed union ParsedBody:
	ParsedBuiltinBody(ParsedRuntimeOperation, Span)
	ParsedValueBody(ValueExpression)
	ParsedMatchBody(ParsedMatch)


fixed union BindingSyntax:
	ImmutableBinding
	MutableBinding


fixed record ParsedBinding {
	name: WrittenName,
	mutability: BindingSyntax,
	initializer: ValueExpression
}


fixed union ParsedStatement:
	BindingStatement(ParsedBinding)
	ExpressionStatement(ValueExpression)


fixed record ParsedFunction {
	module: ModuleId,
	tail_annotation: Option[Span],
	purity: Purity,
	function_name: WrittenName,
	type_parameters: List[WrittenName],
	parameters: List[ParsedParameter],
	return_type: Option[TypeSyntax],
	statements: List[ParsedStatement],
	body: ParsedBody
}


fixed record ParsedVariant {
	name: WrittenName,
	fields: List[TypeSyntax]
}


fixed record ParsedUnion {
	module: ModuleId,
	type_name: WrittenName,
	type_parameters: List[WrittenName],
	variants: List[ParsedVariant]
}


fixed record ParsedRecord {
	module: ModuleId,
	type_name: WrittenName,
	type_parameters: List[WrittenName],
	fields: List[ParsedParameter]
}
