-- Temporary bootstrap bridge until the host library exports ordinary Boolean calls.
pure func not(value: Bool) -> Bool:
	match value:
		True: False
		False: True


pure func and(left: Bool, right: Bool) -> Bool:
	match left:
		True: right
		False: False


pure func or(left: Bool, right: Bool) -> Bool:
	match left:
		True: True
		False: right
