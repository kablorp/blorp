import:
	./boolean: and
	int: INT_MAX, Int methods_only


-- Module IDs index one compilation's inventory; they never cross compilations.
-- The loader issues ordinals from the inventory's length before appending a row.
opaque type ModuleId = Int


-- Keep the span carrier scalar: a union field would make every Span managed.
-- Only this authority translates roles and inventory ordinals into source IDs.
opaque type SourceId = Int


fixed union ModuleKind:
	FoundationTypesModule
	FoundationPreludeModule
	LibraryModule
	UserModule


fixed union SourceRole:
	CompilerRole
	ModuleRole
	InvalidRole


private COMPILER_SOURCE_NUMBER: Int = 1

private FIRST_MODULE_SOURCE_NUMBER: Int = 2

-- The root is the first row, then the two designated foundation inputs; later
-- rows are discovered dependencies.
private ROOT_MODULE_ORDINAL: Int = 0

private FOUNDATION_TYPES_ORDINAL: Int = 1

private FOUNDATION_PRELUDE_ORDINAL: Int = 2


pure func compiler_source() -> SourceId:
	into_opaque SourceId(COMPILER_SOURCE_NUMBER)


pure func module_id(ordinal: Int) -> Option[ModuleId]:
	maximum = INT_MAX.subtract(FIRST_MODULE_SOURCE_NUMBER)
	if and(ordinal.greater_than_or_equal(0), ordinal.less_than_or_equal(maximum)):
		Some(into_opaque ModuleId(ordinal))
	else:
		None


pure func module_number(id: ModuleId) -> Int:
	from_opaque ModuleId(id)


pure func root_module_id() -> ModuleId:
	into_opaque ModuleId(ROOT_MODULE_ORDINAL)


pure func foundation_types_module_id() -> ModuleId:
	into_opaque ModuleId(FOUNDATION_TYPES_ORDINAL)


pure func foundation_prelude_module_id() -> ModuleId:
	into_opaque ModuleId(FOUNDATION_PRELUDE_ORDINAL)


pure func module_source(id: ModuleId) -> SourceId:
	into_opaque SourceId(FIRST_MODULE_SOURCE_NUMBER.add(module_number(id)))


pure func same_module(left: ModuleId, right: ModuleId) -> Bool:
	module_number(left).equals(module_number(right))


pure func same_source(left: SourceId, right: SourceId) -> Bool:
	from_opaque SourceId(left).equals(from_opaque SourceId(right))


pure func source_role(id: SourceId) -> SourceRole:
	if same_source(id, compiler_source()):
		CompilerRole
	else if from_opaque SourceId(id).less_than(FIRST_MODULE_SOURCE_NUMBER):
		InvalidRole
	else:
		ModuleRole


pure func source_module(id: SourceId) -> Option[ModuleId]:
	match source_role(id):
		CompilerRole | InvalidRole:
			None
		ModuleRole:
			module_id(from_opaque SourceId(id).subtract(FIRST_MODULE_SOURCE_NUMBER))
