import:
	./prelude: RuntimeOperation(IntToString, StringLength)
	int as IntOps
	lower:
		MatchLabel(VariantLabel, DefaultLabel),
		ValueId,
		ValueOperation(
			ParameterValue, IntegerValue, VariantValue, CallValue, ConstructValue, PayloadValue,
		),
		value_number,
	option: to_result
	own as Own:
		OwnedArgument(UnmanagedArgument, BorrowedArgument),
		OwnedArm,
		OwnedDefinition,
		OwnedFunction,
		OwnedMatch,
		OwnedTail(ReturnTail, MatchTail),
		OwnedValueOperation(
			ParameterDefinition, IntegerDefinition, VariantDefinition, CallDefinition,
			ConstructDefinition, PayloadDefinition,
		),
		OwnerId,
		OwnershipOperation(DefineValue, AcquireOwner, DropOwner),
		OwnershipProgram,
		ResultOwnership(UnmanagedResult, BorrowedResult, OwnedResult),
		ReturnTransfer(UnmanagedReturn, OwnedReturn),
		owner_number,
	specialize:
		CallTarget(UserFunction, RuntimeFunction),
		ConcreteUnion,
		PayloadShape(NoPayload, IntPayload),
		TypeRef(IntType, StringType, UnionType),
		UnionInstanceId,
		VariantInstanceId,
		function_number,
		union_number,
		variant_number,
		variant_owner,
	string_runtime: string_runtime
	syntax: Diagnostic, Span
	text: concat
	verify: VerifiedProgram, verified_contents


-- Checked-reference errors have no source occurrence; this marks that origin.
private INTERNAL_SPAN: Span = {
	start = 0,
	end = 0
}


private pure func c_parameter(index: Int) -> String:
	"blorp_p_".append_int(index)


private pure func internal_error() -> Diagnostic:
	{
		span = INTERNAL_SPAN,
		note = None,
		message = "internal compiler error: invalid checked union identity",
		help = "report this compiler error with the input program"
	}


private pure func c_name(index: Int) -> String:
	"blorp_f_".append_int(index)


private pure func c_value(id: ValueId) -> String:
	"blorp_vl_".append_int(value_number(id))


private pure func c_owner(id: OwnerId) -> String:
	"blorp_owner_".append_int(owner_number(id))


private pure func c_callable(target: CallTarget) -> String:
	match target:
		UserFunction(id):
			c_name(function_number(id))
		RuntimeFunction(operation):
			match operation:
				IntToString:
					"blorp_int_to_string"
				StringLength:
					"blorp_string_length"


private pure func append_integer(output: String, value: Int) -> String:
	if IntOps.equals(value, IntOps.INT_MIN):
		output.concat("INT64_MIN")
	else if IntOps.less_than(value, 0):
		output
			.concat("(-INT64_C(")
			.append_int(IntOps.subtract(0, value))
			.concat("))")
	else:
		output
			.concat("INT64_C(")
			.append_int(value)
			.concat(")")


private pure func has_payload(declaration: ConcreteUnion) -> Bool:
	var found = False

	for shape in declaration.variants:
		match shape:
			NoPayload:
				void
			IntPayload:
				found = True
				break

	found


private pure func union_c_type(id: UnionInstanceId, declaration: ConcreteUnion) -> String:
	prefix = if has_payload(declaration):
		"struct blorp_u_"
	else:
		"enum blorp_u_"

	prefix.append_int(union_number(id))


private pure func c_type(
	type_ref: TypeRef,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	match type_ref:
		IntType:
			Ok("int64_t")
		StringType:
			Ok("struct blorp_string*")
		UnionType(id):
			declaration ?= unions
				.get(union_number(id))
				.to_result(internal_error())
			Ok(union_c_type(id, declaration))


private pure func c_variant(id: VariantInstanceId) -> String:
	"blorp_v_"
		.append_int(union_number(variant_owner(id)))
		.concat("_")
		.append_int(variant_number(id))


private pure func c_parameters(
	parameters: List[TypeRef],
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	if IntOps.equals(parameters.length(), 0):
		Ok("(void)")
	else:
		var output: String = "("
		var index: Int = 0
		var invalid: Option[Diagnostic] = None

		for parameter in parameters:
			match c_type(parameter, unions):
				Err(error):
					invalid = Some(error)
					break
				Ok(name):
					if IntOps.greater_than(index, 0):
						output = output.concat(",")

					output = output
						.concat(name)
						.concat(" ")
						.concat(c_parameter(index))

			index = IntOps.add(index, 1)

		match invalid:
			Some(error):
				Err(error)
			None:
				Ok(output.concat(")"))


private pure func append_union(output: String, declaration: ConcreteUnion, index: Int) -> String:
	payload = has_payload(declaration)

	prefix = if payload:
		"enum blorp_tag_"
	else:
		"enum blorp_u_"

	var result = output
		.concat(prefix)
		.append_int(index)
		.concat("{")
	var position: Int = 0

	for shape in declaration.variants:
		if IntOps.not_equals(position, 0):
			result = result.concat(",")

		result = result
			.concat("blorp_v_")
			.append_int(index)
			.concat("_")
			.append_int(position)
		position = IntOps.add(position, 1)

	result = result.concat("};")

	if payload:
		result
			.concat("struct blorp_u_")
			.append_int(index)
			.concat("{enum blorp_tag_")
			.append_int(index)
			.concat(" tag;int64_t payload;};")
	else:
		result


private pure func append_operation(
	output: String,
	operation: ValueOperation,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	match operation:
		ParameterValue(index):
			Ok(output.concat(c_parameter(index)))
		IntegerValue(value):
			Ok(append_integer(output, value))
		VariantValue(id):
			declaration ?= unions
				.get(union_number(variant_owner(id)))
				.to_result(internal_error())

			if has_payload(declaration):
				Ok(
					output
						.concat("((")
						.concat(union_c_type(variant_owner(id), declaration))
						.concat("){.tag=")
						.concat(c_variant(id))
						.concat(",.payload=INT64_C(0)})"),
				)
			else:
				Ok(output.concat(c_variant(id)))
		CallValue(call, arguments):
			var prefix = output
				.concat(c_callable(call.target))
				.concat("(")
			var index: Int = 0

			for argument in arguments:
				if IntOps.greater_than(index, 0):
					prefix = prefix.concat(",")

				prefix = prefix.concat(c_value(argument))
				index = IntOps.add(index, 1)

			Ok(prefix.concat(")"))
		ConstructValue(id, argument):
			type_name ?= c_type(UnionType(variant_owner(id)), unions)
			Ok(
				output
					.concat("((")
					.concat(type_name)
					.concat("){.tag=")
					.concat(c_variant(id))
					.concat(",.payload=")
					.concat(c_value(argument))
					.concat("})"),
			)
		PayloadValue(id):
			Ok(
				output
					.concat(c_value(id))
					.concat(".payload"),
			)


private pure func append_value(
	output: String,
	id: ValueId,
	value_type: TypeRef,
	operation: ValueOperation,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	type_name ?= c_type(value_type, unions)
	name = c_value(id)

	declaration = match value_type:
		StringType:
			type_name.concat(" const ")
		_:
			"const "
				.concat(type_name)
				.concat(" ")

	value ?= append_operation(
		output
			.concat(declaration)
			.concat(name)
			.concat("="),
		operation,
		unions,
	)
	Ok(
		value
			.concat(";(void)")
			.concat(name)
			.concat(";"),
	)


private pure func expression_operation(operation: OwnedValueOperation) -> ValueOperation:
	match operation:
		ParameterDefinition(index):
			ParameterValue(index)
		IntegerDefinition(value):
			IntegerValue(value)
		VariantDefinition(id):
			VariantValue(id)
		CallDefinition(call, arguments):
			operands = arguments.map(pure func(argument: OwnedArgument) -> ValueId:
				match argument:
					UnmanagedArgument(id):
						id
					BorrowedArgument(borrow):
						borrow.value
			)

			CallValue(call, operands)
		ConstructDefinition(id, argument):
			ConstructValue(id, argument)
		PayloadDefinition(id):
			PayloadValue(id)


private pure func append_owner_alias(output: String, owner: OwnerId, value: ValueId) -> String:
	name = c_owner(owner)
	output
		.concat("struct blorp_string* const ")
		.concat(name)
		.concat("=")
		.concat(c_value(value))
		.concat(";(void)")
		.concat(name)
		.concat(";")


private pure func append_owned_definition(
	output: String,
	definition: OwnedDefinition,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	value ?= append_value(
		output,
		definition.id,
		definition.value_type,
		expression_operation(definition.operation),
		unions,
	)
	Ok(
		match definition.result:
			UnmanagedResult:
				value
			BorrowedResult:
				value
			OwnedResult(owner):
				append_owner_alias(value, owner, definition.id)
	)


private pure func append_ownership_operation(
	output: String,
	operation: OwnershipOperation,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	match operation:
		DefineValue(definition):
			append_owned_definition(output, definition, unions)
		AcquireOwner(owner, borrowed, _):
			retained = output
				.concat("blorp_string_retain(")
				.concat(c_value(borrowed.value))
				.concat(");")
			Ok(append_owner_alias(retained, owner, borrowed.value))
		DropOwner(owner, _):
			Ok(
				output
					.concat("blorp_string_release(")
					.concat(c_owner(owner))
					.concat(");"),
			)


private pure func append_ownership_operations(
	output: String,
	operations: List[OwnershipOperation],
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	var result = output
	var failure: Option[Diagnostic] = None

	for operation in operations:
		match append_ownership_operation(result, operation, unions):
			Err(error):
				failure = Some(error)
				break
			Ok(emitted):
				result = emitted

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(result)


private pure func append_arm(
	output: String,
	arm: OwnedArm,
	final_default: Bool,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	var result = match arm.label:
		VariantLabel(id):
			output
				.concat("case ")
				.concat(c_variant(id))
				.concat(":")
		DefaultLabel:
			output.concat("default:")

	if final_default:
		result = result.concat("default:")

	body ?= append_ownership_operations(
		result.concat("{"),
		arm.operations,
		unions,
	)
	Ok(append_return(body, arm.result).concat("}"))


private pure func append_match(
	output: String,
	matched: OwnedMatch,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	declaration ?= unions
		.get(union_number(matched.owner))
		.to_result(internal_error())
	var result = output
		.concat("switch(")
		.concat(c_value(matched.scrutinee))

	if has_payload(declaration):
		result = result.concat(".tag")

	result = result.concat("){")
	var has_default = False

	for arm in matched.arms:
		match arm.label:
			DefaultLabel:
				has_default = True
			_:
				void

	var position: Int = 0
	var failure: Option[Diagnostic] = None

	for arm in matched.arms:
		final_default = not has_default and IntOps.equals(
			IntOps.add(position, 1),
			matched.arms.length(),
		)

		match append_arm(result, arm, final_default, unions):
			Err(error):
				failure = Some(error)
				break
			Ok(emitted):
				result = emitted

		position = IntOps.add(position, 1)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(result.concat("}"))


private pure func append_signature(
	output: String,
	function: OwnedFunction,
	index: Int,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	type_name ?= c_type(function.signature.return_type, unions)
	parameters ?= c_parameters(function.signature.parameters, unions)
	Ok(
		output
			.concat(type_name)
			.concat(" ")
			.concat(c_name(index))
			.concat(parameters),
	)


private pure func append_return(output: String, result: ReturnTransfer) -> String:
	value = match result:
		UnmanagedReturn(id):
			c_value(id)
		OwnedReturn(_, owner):
			c_owner(owner)

	output
		.concat("return ")
		.concat(value)
		.concat(";")


private pure func append_function(
	output: String,
	function: OwnedFunction,
	index: Int,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	header ?= append_signature(output, function, index, unions)
	body ?= append_ownership_operations(
		header.concat("{"),
		function.operations,
		unions,
	)

	match function.tail:
		ReturnTail(result):
			Ok(append_return(body, result).concat("}"))
		MatchTail(matched):
			emitted ?= append_match(body, matched, unions)
			Ok(emitted.concat("}"))


private pure func is_string(type_ref: TypeRef) -> Bool:
	match type_ref:
		StringType:
			True
		_:
			False


private pure func operations_need_strings(operations: List[OwnershipOperation]) -> Bool:
	var needed = False

	for operation in operations:
		match operation:
			DefineValue(definition):
				if is_string(definition.value_type):
					needed = True
			AcquireOwner(_, _, _):
				needed = True
			DropOwner(_, _):
				needed = True

	needed


private pure func needs_string_runtime(program: OwnershipProgram) -> Bool:
	var needed = False

	for function in program.functions:
		if is_string(function.signature.return_type):
			needed = True

		for parameter in function.signature.parameters:
			if is_string(parameter):
				needed = True

		if operations_need_strings(function.operations):
			needed = True

		match function.tail:
			ReturnTail(_):
				void
			MatchTail(matched):
				for arm in matched.arms:
					if operations_need_strings(arm.operations):
						needed = True

	needed


pure func emit(program: VerifiedProgram) -> Result[String, Diagnostic]:
	checked = verified_contents(program)

	var output: String = if needs_string_runtime(checked):
		string_runtime()
	else:
		"#include <stdint.h>\n"

	var index: Int = 0

	for declaration in checked.unions:
		output = append_union(output, declaration, index)
		index = IntOps.add(index, 1)

	var failure: Option[Diagnostic] = None
	index = 0

	for function in checked.functions:
		match append_signature(output, function, index, checked.unions):
			Err(error):
				failure = Some(error)
				break
			Ok(signature):
				output = signature.concat(";")

		index = IntOps.add(index, 1)

	if not failure.is_some():
		index = 0

		for function in checked.functions:
			match append_function(output, function, index, checked.unions):
				Err(error):
					failure = Some(error)
					break
				Ok(function_code):
					output = function_code

			index = IntOps.add(index, 1)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(
				output
					.concat("int main(void){return (int)")
					.concat(c_name(function_number(checked.entrypoint)))
					.concat("();}\n"),
			)
