import:
	source: COMPILER_SOURCE
	./prelude: RuntimeOperation(IntAdd, IntToString, StringLength)
	int as IntOps
	lower: MatchLabel(VariantLabel, DefaultLabel), ValueId, value_number
	option: to_result
	own as Own:
		OwnedArgument(UnmanagedArgument, BorrowedArgument),
		OwnedArm,
		OwnedDefinition,
		OwnedExit(ReturnResult, RecurArguments),
		OwnedFunction,
		OwnedMatch,
		OwnedTail(ReturnTail, MatchTail),
		OwnedValueOperation(
			ParameterDefinition, IntegerDefinition, VariantDefinition, CallDefinition,
			ConstructDefinition, PayloadDefinition, ConstructRecordDefinition,
			ReadRecordFieldDefinition,
		),
		OwnerId,
		OwnershipOperation(DefineValue, AcquireOwner, DropOwner),
		OwnershipProgram,
		ResultOwnership(UnmanagedResult, BorrowedResult, OwnedResult),
		ReturnTransfer(UnmanagedReturn, OwnedReturn),
		StoredPayload(UnmanagedPayload, OwnedPayload),
		owner_number,
	specialize:
		CallTarget(UserFunction, RuntimeFunction),
		ConcreteRecord,
		ConcreteUnion,
		FieldInstanceId,
		RecordInstanceId,
		TypeRef(IntType, StringType, UnionType, RecordType),
		UnionInstanceId,
		UnionRepresentation(InlineUnmanaged, InlineOwningPayload),
		VariantInstanceId,
		field_number,
		field_owner,
		function_number,
		record_number,
		union_number,
		variant_number,
		variant_owner,
	string_runtime: string_runtime
	syntax: Diagnostic, FunctionExecution(OrdinaryCalls, SelfTailLoop), Span
	text: concat
	verify: VerifiedProgram, verified_contents


-- Checked-reference errors have no source occurrence; this marks that origin.
private INTERNAL_SPAN: Span = {
	source = COMPILER_SOURCE,
	start = 0,
	end = 0
}


private pure func c_parameter(index: Int) -> String:
	"blorp_p_".append_int(index)


private pure func internal_error() -> Diagnostic:
	{
		span = INTERNAL_SPAN,
		note = None,
		message = "internal compiler error: invalid checked union identity",
		help = "report this compiler error with the input program"
	}


private pure func c_name(index: Int) -> String:
	"blorp_f_".append_int(index)


private pure func c_value(id: ValueId) -> String:
	"blorp_vl_".append_int(value_number(id))


private pure func c_owner(id: OwnerId) -> String:
	"blorp_owner_".append_int(owner_number(id))


private pure func c_callable(target: CallTarget) -> String:
	match target:
		UserFunction(id):
			c_name(function_number(id))
		RuntimeFunction(operation):
			match operation:
				IntAdd:
					"blorp_int_add"
				IntToString:
					"blorp_int_to_string"
				StringLength:
					"blorp_string_length"


private pure func append_integer(output: String, value: Int) -> String:
	if IntOps.equals(value, IntOps.INT_MIN):
		output.concat("INT64_MIN")
	else if IntOps.less_than(value, 0):
		output
			.concat("(-INT64_C(")
			.append_int(IntOps.subtract(0, value))
			.concat("))")
	else:
		output
			.concat("INT64_C(")
			.append_int(value)
			.concat(")")


private pure func has_payload(declaration: ConcreteUnion) -> Bool:
	var found = False

	for shape in declaration.variants:
		match shape:
			None:
				void
			Some(_):
				found = True
				break

	found


private pure func union_c_type(id: UnionInstanceId, declaration: ConcreteUnion) -> String:
	prefix = if has_payload(declaration):
		"struct blorp_u_"
	else:
		"enum blorp_u_"

	prefix.append_int(union_number(id))


private pure func record_c_type(id: RecordInstanceId) -> String:
	"struct blorp_r_".append_int(record_number(id))


private pure func c_field(id: FieldInstanceId) -> String:
	"blorp_rf_"
		.append_int(record_number(field_owner(id)))
		.concat("_")
		.append_int(field_number(id))


private pure func append_record(output: String, layout: ConcreteRecord, index: Int) -> String:
	var result = output
		.concat("struct blorp_r_")
		.append_int(index)
		.concat("{")
	var position = 0

	for _ in layout.fields:
		result = result
			.concat("int64_t blorp_rf_")
			.append_int(index)
			.concat("_")
			.append_int(position)
			.concat(";")
		position = IntOps.add(position, 1)

	result.concat("};")


private pure func c_type(
	type_ref: TypeRef,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	match type_ref:
		RecordType(id):
			Ok(record_c_type(id))
		IntType:
			Ok("int64_t")
		StringType:
			Ok("struct blorp_string*")
		UnionType(id):
			declaration ?= unions
				.get(union_number(id))
				.to_result(internal_error())
			Ok(union_c_type(id, declaration))


private pure func c_variant(id: VariantInstanceId) -> String:
	"blorp_v_"
		.append_int(union_number(variant_owner(id)))
		.concat("_")
		.append_int(variant_number(id))


private pure func c_parameters(
	parameters: List[TypeRef],
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	if IntOps.equals(parameters.length(), 0):
		Ok("(void)")
	else:
		var output: String = "("
		var index: Int = 0
		var invalid: Option[Diagnostic] = None

		for parameter in parameters:
			match c_type(parameter, unions):
				Err(error):
					invalid = Some(error)
					break
				Ok(name):
					if IntOps.greater_than(index, 0):
						output = output.concat(",")

					output = output
						.concat(name)
						.concat(" ")
						.concat(c_parameter(index))

			index = IntOps.add(index, 1)

		match invalid:
			Some(error):
				Err(error)
			None:
				Ok(output.concat(")"))


private pure func c_payload(id: VariantInstanceId) -> String:
	"blorp_up_".append_int(variant_number(id))


private pure func append_union(
	output: String,
	declaration: ConcreteUnion,
	index: Int,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	payload = has_payload(declaration)

	prefix = if payload:
		"enum blorp_tag_"
	else:
		"enum blorp_u_"

	var result = output
		.concat(prefix)
		.append_int(index)
		.concat("{")
	var position: Int = 0

	for shape in declaration.variants:
		if IntOps.not_equals(position, 0):
			result = result.concat(",")

		result = result
			.concat("blorp_v_")
			.append_int(index)
			.concat("_")
			.append_int(position)
		position = IntOps.add(position, 1)

	result = result.concat("};")

	if payload:
		result = result
			.concat("struct blorp_u_")
			.append_int(index)
			.concat("{enum blorp_tag_")
			.append_int(index)
			.concat(" tag;union{")
		position = 0
		var failure: Option[Diagnostic] = None

		for shape in declaration.variants:
			match shape:
				None:
					void
				Some(value_type):
					match c_type(value_type, unions):
						Err(error):
							failure = Some(error)
							break
						Ok(name):
							result = result
								.concat(name)
								.concat(" blorp_up_")
								.append_int(position)
								.concat(";")

			position = IntOps.add(position, 1)

		match failure:
			Some(error):
				Err(error)
			None:
				append_union_ownership(
					result.concat("}payload;};"),
					declaration,
					index,
					unions,
				)
	else:
		Ok(result)


private pure func append_operation(
	output: String,
	operation: OwnedValueOperation,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	match operation:
		ConstructRecordDefinition(owner, fields):
			var result = output
				.concat("((")
				.concat(record_c_type(owner))
				.concat("){")
			var position = 0

			for field in fields:
				if IntOps.greater_than(position, 0):
					result = result.concat(",")

				result = result
					.concat(".")
					.concat(c_field(field.field))
					.concat("=")
					.concat(c_value(field.value))
				position = IntOps.add(position, 1)

			Ok(result.concat("})"))
		ReadRecordFieldDefinition(field, value):
			Ok(
				output
					.concat(c_value(value))
					.concat(".")
					.concat(c_field(field)),
			)
		ParameterDefinition(index):
			Ok(output.concat(c_parameter(index)))
		IntegerDefinition(value):
			Ok(append_integer(output, value))
		VariantDefinition(id):
			declaration ?= unions
				.get(union_number(variant_owner(id)))
				.to_result(internal_error())

			if has_payload(declaration):
				Ok(
					output
						.concat("((")
						.concat(union_c_type(variant_owner(id), declaration))
						.concat("){.tag=")
						.concat(c_variant(id))
						.concat("})"),
				)
			else:
				Ok(output.concat(c_variant(id)))
		CallDefinition(call, arguments):
			var prefix = output
				.concat(c_callable(call.target))
				.concat("(")
			var index: Int = 0

			for argument in arguments:
				if IntOps.greater_than(index, 0):
					prefix = prefix.concat(",")

				value = match argument:
					UnmanagedArgument(id):
						id
					BorrowedArgument(borrow):
						borrow.value

				prefix = prefix.concat(c_value(value))
				index = IntOps.add(index, 1)

			Ok(prefix.concat(")"))
		ConstructDefinition(id, argument):
			type_name ?= c_type(UnionType(variant_owner(id)), unions)

			stored = match argument:
				UnmanagedPayload(value):
					c_value(value)
				OwnedPayload(_, owner):
					c_owner(owner)

			Ok(
				output
					.concat("((")
					.concat(type_name)
					.concat("){.tag=")
					.concat(c_variant(id))
					.concat(",.payload.")
					.concat(c_payload(id))
					.concat("=")
					.concat(stored)
					.concat("})"),
			)
		PayloadDefinition(variant, id):
			Ok(
				output
					.concat(c_value(id))
					.concat(".payload.")
					.concat(c_payload(variant)),
			)


private pure func append_value(
	output: String,
	id: ValueId,
	value_type: TypeRef,
	operation: OwnedValueOperation,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	type_name ?= c_type(value_type, unions)
	name = c_value(id)

	declaration = match value_type:
		StringType:
			type_name.concat(" const ")
		_:
			"const "
				.concat(type_name)
				.concat(" ")

	value ?= append_operation(
		output
			.concat(declaration)
			.concat(name)
			.concat("="),
		operation,
		unions,
	)
	Ok(
		value
			.concat(";(void)")
			.concat(name)
			.concat(";"),
	)


private pure func append_owner_alias(
	output: String,
	owner: OwnerId,
	value: ValueId,
	value_type: TypeRef,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	name = c_owner(owner)
	type_name ?= c_type(value_type, unions)

	declaration = match value_type:
		StringType:
			type_name.concat(" const ")
		_:
			"const "
				.concat(type_name)
				.concat(" ")

	Ok(
		output
			.concat(declaration)
			.concat(name)
			.concat("=")
			.concat(c_value(value))
			.concat(";(void)")
			.concat(name)
			.concat(";"),
	)


private pure func append_owned_definition(
	output: String,
	definition: OwnedDefinition,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	value ?= append_value(
		output,
		definition.id,
		definition.value_type,
		definition.operation,
		unions,
	)

	match definition.result:
		UnmanagedResult | BorrowedResult(_):
			Ok(value)
		OwnedResult(owner):
			append_owner_alias(value, owner, definition.id, definition.value_type, unions)


-- Disposable owner-type projection of accepted IR; value types stay local.
private pure func owner_types(function: OwnedFunction) -> Result[List[TypeRef], Diagnostic]:
	var blocks = [function.operations]

	match function.tail:
		ReturnTail(_):
			void
		MatchTail(matched):
			for arm in matched.arms:
				blocks = blocks.append(arm.operations)

	var values: List[TypeRef] = []
	var owners: List[TypeRef] = []
	var failure: Option[Diagnostic] = None

	for operations in blocks:
		for operation in operations:
			match operation:
				DefineValue(definition):
					values = values.append(definition.value_type)

					match definition.result:
						OwnedResult(_):
							owners = owners.append(definition.value_type)
						_:
							void
				AcquireOwner(_, borrowed, _):
					match values.get(value_number(borrowed.value)):
						Some(value_type):
							owners = owners.append(value_type)
						None:
							failure = Some(internal_error())
							break
				DropOwner(_, _):
					void

		if failure.is_some():
			break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(owners)


private fixed union OwnershipAction:
	DuplicateValue
	DestroyValue


private pure func append_storage_operation(
	output: String,
	value_type: TypeRef,
	action: OwnershipAction,
	expression: String,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	name_result: Result[Option[String], Diagnostic] = match value_type:
		StringType:
			Ok(
				Some(
					match action:
						DuplicateValue:
							"blorp_string_retain"
						DestroyValue:
							"blorp_string_release"
				),
			)
		UnionType(id):
			layout ?= unions
				.get(union_number(id))
				.to_result(internal_error())
			Ok(
				match layout.representation:
					InlineUnmanaged:
						None
					InlineOwningPayload:
						prefix = match action:
							DuplicateValue:
								"blorp_union_dup_"
							DestroyValue:
								"blorp_union_drop_"

						Some(prefix.append_int(union_number(id)))
			)
		_:
			Ok(None)

	name ?= name_result
	Ok(
		match name:
			Some(name):
				output
					.concat(name)
					.concat("(")
					.concat(expression)
					.concat(");")
			None:
				output
	)


private pure func append_union_action(
	output: String,
	layout: ConcreteUnion,
	index: Int,
	unions: List[ConcreteUnion],
	action: OwnershipAction,
) -> Result[String, Diagnostic]:
	prefix = match action:
		DuplicateValue:
			"void blorp_union_dup_"
		DestroyValue:
			"void blorp_union_drop_"

	var result = output
		.concat(prefix)
		.append_int(index)
		.concat("(struct blorp_u_")
		.append_int(index)
		.concat(" value){switch(value.tag){")
	var position = 0
	var failure: Option[Diagnostic] = None

	for payload in layout.variants:
		result = result
			.concat("case blorp_v_")
			.append_int(index)
			.concat("_")
			.append_int(position)
			.concat(":")

		match payload:
			Some(value_type):
				match append_storage_operation(
					result,
					value_type,
					action,
					"value.payload.blorp_up_".append_int(position),
					unions,
				):
					Ok(updated):
						result = updated
					Err(error):
						failure = Some(error)
						break
			None:
				void

		result = result.concat("break;")
		position = IntOps.add(position, 1)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(result.concat("}}"))


private pure func append_union_ownership(
	output: String,
	layout: ConcreteUnion,
	index: Int,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	match layout.representation:
		InlineUnmanaged:
			Ok(output)
		InlineOwningPayload:
			duplicated ?= append_union_action(output, layout, index, unions, DuplicateValue)
			append_union_action(duplicated, layout, index, unions, DestroyValue)


private pure func append_ownership_operation(
	output: String,
	operation: OwnershipOperation,
	unions: List[ConcreteUnion],
	types: List[TypeRef],
) -> Result[String, Diagnostic]:
	match operation:
		DefineValue(definition):
			append_owned_definition(output, definition, unions)
		AcquireOwner(owner, borrowed, _):
			value_type ?= types
				.get(owner_number(owner))
				.to_result(internal_error())
			retained ?= append_storage_operation(
				output,
				value_type,
				DuplicateValue,
				c_value(borrowed.value),
				unions,
			)
			append_owner_alias(retained, owner, borrowed.value, value_type, unions)
		DropOwner(owner, _):
			value_type ?= types
				.get(owner_number(owner))
				.to_result(internal_error())
			append_storage_operation(output, value_type, DestroyValue, c_owner(owner), unions)


private pure func append_ownership_operations(
	output: String,
	operations: List[OwnershipOperation],
	unions: List[ConcreteUnion],
	types: List[TypeRef],
) -> Result[String, Diagnostic]:
	var result = output
	var failure: Option[Diagnostic] = None

	for operation in operations:
		match append_ownership_operation(result, operation, unions, types):
			Err(error):
				failure = Some(error)
				break
			Ok(emitted):
				result = emitted

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(result)


private pure func append_arm(
	output: String,
	arm: OwnedArm,
	final_default: Bool,
	unions: List[ConcreteUnion],
	types: List[TypeRef],
) -> Result[String, Diagnostic]:
	var result = match arm.label:
		VariantLabel(id):
			output
				.concat("case ")
				.concat(c_variant(id))
				.concat(":")
		DefaultLabel:
			output.concat("default:")

	if final_default:
		result = result.concat("default:")

	body ?= append_ownership_operations(
		result.concat("{"),
		arm.operations,
		unions,
		types,
	)
	Ok(append_exit(body, arm.exit).concat("}"))


private pure func append_match(
	output: String,
	matched: OwnedMatch,
	unions: List[ConcreteUnion],
	types: List[TypeRef],
) -> Result[String, Diagnostic]:
	declaration ?= unions
		.get(union_number(matched.owner))
		.to_result(internal_error())
	var result = output
		.concat("switch(")
		.concat(c_value(matched.scrutinee))

	if has_payload(declaration):
		result = result.concat(".tag")

	result = result.concat("){")
	var has_default = False

	for arm in matched.arms:
		match arm.label:
			DefaultLabel:
				has_default = True
			_:
				void

	var position: Int = 0
	var failure: Option[Diagnostic] = None

	for arm in matched.arms:
		final_default = not has_default and IntOps.equals(
			IntOps.add(position, 1),
			matched.arms.length(),
		)

		match append_arm(result, arm, final_default, unions, types):
			Err(error):
				failure = Some(error)
				break
			Ok(emitted):
				result = emitted

		position = IntOps.add(position, 1)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(result.concat("}"))


private pure func append_signature(
	output: String,
	function: OwnedFunction,
	index: Int,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	type_name ?= c_type(function.signature.return_type, unions)
	parameters ?= c_parameters(function.signature.parameters, unions)
	Ok(
		output
			.concat(type_name)
			.concat(" ")
			.concat(c_name(index))
			.concat(parameters),
	)


private pure func append_return(output: String, result: ReturnTransfer) -> String:
	value = match result:
		UnmanagedReturn(id):
			c_value(id)
		OwnedReturn(_, owner):
			c_owner(owner)

	output
		.concat("return ")
		.concat(value)
		.concat(";")


private pure func append_exit(output: String, exit: OwnedExit) -> String:
	match exit:
		ReturnResult(result):
			append_return(output, result)
		RecurArguments(arguments, _):
			var result = output
			var position: Int = 0

			-- Every operand is already an immutable value local. Replacing slots
			-- from these captures preserves swaps and repeated arguments.
			for argument in arguments:
				result = result
					.concat(c_parameter(position))
					.concat("=")
					.concat(c_value(argument))
					.concat(";")
				position = IntOps.add(position, 1)

			result.concat("continue;")


private pure func append_function(
	output: String,
	function: OwnedFunction,
	index: Int,
	unions: List[ConcreteUnion],
) -> Result[String, Diagnostic]:
	header ?= append_signature(output, function, index, unions)
	types ?= owner_types(function)

	opening = match function.execution:
		OrdinaryCalls:
			header.concat("{")
		SelfTailLoop(_):
			header.concat("{while (1){")

	body ?= append_ownership_operations(opening, function.operations, unions, types)

	emitted ?= match function.tail:
		ReturnTail(exit):
			Ok(append_exit(body, exit))
		MatchTail(matched):
			append_match(body, matched, unions, types)

	closing = match function.execution:
		OrdinaryCalls:
			"}"
		SelfTailLoop(_):
			"}}"

	Ok(emitted.concat(closing))


private pure func is_string(type_ref: TypeRef) -> Bool:
	match type_ref:
		StringType:
			True
		_:
			False


private pure func operations_need_strings(operations: List[OwnershipOperation]) -> Bool:
	var needed = False

	for operation in operations:
		match operation:
			DefineValue(definition):
				if is_string(definition.value_type):
					needed = True
			AcquireOwner(_, _, _):
				needed = True
			DropOwner(_, _):
				needed = True

	needed


private pure func operations_need_integer_add(operations: List[OwnershipOperation]) -> Bool:
	var needed = False
	for operation in operations:
		match operation:
			DefineValue(definition):
				match definition.operation:
					CallDefinition(call, _):
						match call.target:
							RuntimeFunction(IntAdd):
								needed = True
							_:
								void
					_:
						void
			_:
				void
	needed


private pure func needs_integer_add(program: OwnershipProgram) -> Bool:
	var needed = False
	for function in program.functions:
		if operations_need_integer_add(function.operations):
			needed = True
		match function.tail:
			ReturnTail(_):
				void
			MatchTail(matched):
				for arm in matched.arms:
					if operations_need_integer_add(arm.operations):
						needed = True
	needed


-- Unsigned addition wraps. Both signed casts below receive representable values;
-- the negative branch also stays within Int64 at UINT64_MAX - sum == INT64_MAX.
private INTEGER_ADD_RUNTIME: String =
	|static int64_t blorp_int_add(int64_t first,int64_t second){uint64_t sum=(uint64_t)first+(uint64_t)second;return sum<=INT64_MAX?(int64_t)sum:-INT64_C(1)-(int64_t)(UINT64_MAX-sum);}
	|


private pure func needs_string_runtime(program: OwnershipProgram) -> Bool:
	var needed = False

	for function in program.functions:
		if is_string(function.signature.return_type):
			needed = True

		for parameter in function.signature.parameters:
			if is_string(parameter):
				needed = True

		if operations_need_strings(function.operations):
			needed = True

		match function.tail:
			ReturnTail(_):
				void
			MatchTail(matched):
				for arm in matched.arms:
					if operations_need_strings(arm.operations):
						needed = True

	needed


pure func emit(program: VerifiedProgram) -> Result[String, Diagnostic]:
	checked = verified_contents(program)
	var owns_children = False

	for layout in checked.unions:
		match layout.representation:
			InlineOwningPayload:
				owns_children = True
			InlineUnmanaged:
				void

	var output: String = if owns_children or needs_string_runtime(checked):
		string_runtime()
	else:
		"#include <stdint.h>\n"
	if needs_integer_add(checked):
		output = output.concat(INTEGER_ADD_RUNTIME)

	var index: Int = 0

	for declaration in checked.records:
		output = append_record(output, declaration, index)
		index = IntOps.add(index, 1)

	index = 0
	var failure: Option[Diagnostic] = None

	for declaration in checked.unions:
		match append_union(output, declaration, index, checked.unions):
			Err(error):
				failure = Some(error)
				break
			Ok(updated):
				output = updated

		index = IntOps.add(index, 1)

	ready ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	index = 0

	for function in checked.functions:
		match append_signature(output, function, index, checked.unions):
			Err(error):
				failure = Some(error)
				break
			Ok(signature):
				output = signature.concat(";")

		index = IntOps.add(index, 1)

	if not failure.is_some():
		index = 0

		for function in checked.functions:
			match append_function(output, function, index, checked.unions):
				Err(error):
					failure = Some(error)
					break
				Ok(function_code):
					output = function_code

			index = IntOps.add(index, 1)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(
				output
					.concat("int main(void){return (int)")
					.concat(c_name(function_number(checked.entrypoint)))
					.concat("();}\n"),
			)
