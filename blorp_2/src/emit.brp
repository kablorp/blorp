import:
	check:
		CheckedBase(ReturnInteger, ReturnParameter, ReturnCall),
		CheckedProgram,
		ParameterShape(NoParameter, IntParameter),
		checked_functions,
		function_number,
	int as IntOps
	list: reverse
	text: concat


private pure func c_name(index: Int) -> String:
	"blorp_f_".append_int(index)


private C_PARAMETER: String = "blorp_p_0"


private pure func append_integer(output: String, value: Int) -> String:
	if IntOps.equals(value, IntOps.INT_MIN):
		output.concat("INT64_MIN")
	else if IntOps.less_than(value, 0):
		output
			.concat("(-INT64_C(")
			.append_int(IntOps.subtract(0, value))
			.concat("))")
	else:
		output
			.concat("INT64_C(")
			.append_int(value)
			.concat(")")


private pure func c_parameters(parameters: ParameterShape) -> String:
	match parameters:
		NoParameter:
			"(void)"
		IntParameter:
			"(int64_t "
				.concat(C_PARAMETER)
				.concat(")")


pure func emit(program: CheckedProgram) -> String:
	checked = program.checked_functions()
	var output: String = "#include <stdint.h>\n"
	var index: Int = 0

	for function in checked.functions:
		output = output
			.concat("int64_t ")
			.concat(c_name(index))
			.concat(c_parameters(function.parameters))
			.concat(";")
		index = IntOps.add(index, 1)

	index = 0

	for function in checked.functions:
		unused_parameter: String = match function.parameters:
			NoParameter:
				""
			IntParameter:
				match function.body.base:
					ReturnParameter:
						""
					_:
						"(void)"
							.concat(C_PARAMETER)
							.concat(";")

		output = output
			.concat("int64_t ")
			.concat(c_name(index))
			.concat(c_parameters(function.parameters))
			.concat("{")
			.concat(unused_parameter)
			.concat("return ")

		for call in function.body.unary_calls.reverse():
			output = output
				.concat(c_name(function_number(call.target)))
				.concat("(")

		output = match function.body.base:
			ReturnInteger(value):
				append_integer(output, value)
			ReturnParameter:
				output.concat(C_PARAMETER)
			ReturnCall(call):
				output
					.concat(c_name(function_number(call.target)))
					.concat("()")

		for call in function.body.unary_calls:
			output = output.concat(")")

		output = output.concat(";}")

		index = IntOps.add(index, 1)

	output
		.concat("int main(void){return (int)")
		.concat(c_name(function_number(checked.entrypoint)))
		.concat("();}\n")
