import:
	check:
		CheckedProgram,
		CheckedReturn(ReturnInteger, ReturnCall),
		checked_functions,
		function_number,
	int as IntOps
	syntax: IntegerValue(Zero, One)
	text: concat


private pure func c_name(index: Int) -> String:
	"blorp_f_".append_int(index)


pure func emit(program: CheckedProgram) -> String:
	checked = program.checked_functions()
	var output: String = "#include <stdint.h>\n"

	for index in 0..checked.functions.length():
		output = output
			.concat("int64_t ")
			.concat(c_name(index))
			.concat("(void);")

	var index: Int = 0

	for function in checked.functions:
		body: String = match function.body:
			ReturnInteger(value):
				match value:
					Zero:
						"INT64_C(0)"
					One:
						"INT64_C(1)"
			ReturnCall(id):
				c_name(function_number(id)).concat("()")

		output = output
			.concat("int64_t ")
			.concat(c_name(index))
			.concat("(void){return ")
			.concat(body)
			.concat(";}")

		index = IntOps.add(index, 1)

	output
		.concat("int main(void){return (int)")
		.concat(c_name(function_number(checked.entrypoint)))
		.concat("();}\n")
