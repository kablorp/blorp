---
The namespace: every module's scope, built once from the sealed parsed program
before checking. In one module a spelling denotes at most one entity per space,
and `enter` is the only place that rule is checked; `offer` is the only place
it is decided what a module offers its importers. Modules are built in
dependency order, so each import reads a finished scope. Building stops at the
first module with a problem: every later module depends on it or would be
reported after it, and checking reports one problem.

The sections run in this order: the data, identity, the rule and the offer,
building, selection, then the queries. Only `build_namespace`, the queries,
the identity helpers and the types they exchange are public; the rule, the
offer and the scopes being built stay private to this module.
---
import:
	../utils/ids:
		ConstantId, ConstantRow, FunctionId, FunctionRow, RecordId, UnionId, UnionRow, VariantId,
		constant_number, function_number, inventory_constants, inventory_functions, next_nominal, record_number,
		union_number, variant_number, variant_owner,
		NominalRow(UnionDeclarationRow, RecordDeclarationRow),
	int as IntOps
	list: repeat
	../utils/int_map as IntMaps
	../utils/names: NameId, name_number
	../parse/assemble: ModuleImport, ParsedContents, ParsedModuleRow, ParsedProgram, parsed_contents
	../parse/parse: ImportSelection(NamedSelection, ConstructorSelection, MethodsOnlySelection), ModulePath, selection_name
	./builtins: PrimitiveType(BuiltinInt, BuiltinFloat, BuiltinString, BuiltinVoid), builtin_type_name
	../utils/source: ModuleId, ModuleKind(UserModule, LibraryModule, FoundationTypesModule, FoundationPreludeModule), module_number, same_module
	../utils/syntax:
		ParsedBuiltinType(IntegerBuiltin, FloatBuiltin, StringBuiltin, VoidBuiltin, ListBuiltin),
		Span, Visibility(Public, Private), WrittenName,



-- Data: what a module's names denote, and why a name does not enter.


-- The head a type name denotes; accepted type arguments stay in checking.
fixed union TypeHead:
	PrimitiveHead(PrimitiveType)
	ListHead
	UnionHead(UnionId)
	RecordHead(RecordId)


-- `path as Alias`: the module it names, and its path as written, which
-- qualified-name diagnostics quote.
fixed record AliasedModule {
	target: ModuleId,
	path: ModulePath
}


-- What a written name denotes in a module.
fixed union Entity:
	Function(FunctionId)
	Constant(ConstantId)
	Constructor(VariantId)
	Type(TypeHead)
	Alias(AliasedModule)


-- How a name entered its module: declared there, written in its import block
-- (a selection or an alias), or supplied by the prelude.
fixed union Origin:
	Declared(Visibility)
	Imported
	Implicit


-- The visible type head and the existing entry's access authority.
fixed record NamedType {
	head: TypeHead,
	origin: Origin
}


-- A value-space name already claimed in this module, with its original site.
fixed union ValueBinding:
	FunctionName(WrittenName)
	ConstantName(WrittenName)
	ConstructorName(WrittenName)
	ModuleAliasName(WrittenName)


-- One name of a module. `name.span` is where diagnostics point: the
-- declaration, the selection or alias, or the prelude's own selection.
fixed record Entry {
	name: WrittenName,
	entity: Entity,
	origin: Origin
}


-- A module's two name spaces: values (functions, constants, constructors) and types.
-- A module alias claims its spelling in both.
private fixed union Space:
	Values
	Types


-- A type selection, or `T methods_only`, imports the target's public receiver
-- functions of `receiver`; checking resolves it after signatures.
fixed record MethodImport {
	target: ModuleId,
	receiver: TypeHead,
	name: WrittenName
}


-- One module's names, in the order they entered, keyed by `space_key`.
private fixed record ModuleScope {
	names: IntMaps.IntMap[Entry],
	methods: List[MethodImport]
}


-- Why a module does not offer a name: none of that kind, a private
-- declaration, or a name it imports or receives from the prelude.
fixed union Unoffered:
	UnknownName
	PrivateName
	ImportedThere(Entity)
	ProvidedThere(Entity)


-- Why a selection binds nothing. A name the target only imports may already be
-- in the selecting module's scope, through the prelude or an earlier import.
fixed union SelectionProblem:
	NotOffered(Unoffered)
	AlreadyFromPrelude(Entity)
	AlreadyImported(Entity)
	AmbiguousFunction
	AmbiguousConstant
	BareConstructor(VariantId)
	NotAConstructor(WrittenName)
	ReceiverNotVisible


-- `incoming` reached a space `previous` already holds for its spelling.
fixed record Conflict {
	incoming: Entry,
	previous: Entry
}


fixed union NamespaceProblem:
	NameConflict(Conflict)
	SelectionFailure(ModulePath, ImportSelection, SelectionProblem)


-- A module's scope as it is built, with its first problem in source order.
-- Its fields are flat so that each update can reuse them in place.
private fixed record BuiltScope {
	names: IntMaps.IntMap[Entry],
	methods: List[MethodImport],
	problem: Option[NamespaceProblem]
}


-- One scope per module, indexed by module number, for one compilation.
opaque type Namespace = List[ModuleScope]


-- Where a function a module names comes from: its own declaration, or the
-- selection that imported it, whose span diagnostics cite.
fixed union FunctionSource:
	DeclaredHere
	ImportedAt(Span)


-- What a name denotes in the value space.
fixed union NamedValue:
	NamedFunction(FunctionId, FunctionSource)
	NamedConstant(ConstantId)
	NamedConstructor(VariantId)
	NamedAlias(AliasedModule)


-- What a module offers importers in the value space: never an alias.
fixed union OfferedValue:
	OfferedFunction(FunctionId)
	OfferedConstant(ConstantId)
	OfferedConstructor(VariantId)


-- Identity of type heads and entities.


pure func same_head(left: TypeHead, right: TypeHead) -> Bool:
	match left:
		PrimitiveHead(BuiltinInt):
			match right:
				PrimitiveHead(BuiltinInt): True
				_: False
		PrimitiveHead(BuiltinFloat):
			match right:
				PrimitiveHead(BuiltinFloat): True
				_: False
		PrimitiveHead(BuiltinString):
			match right:
				PrimitiveHead(BuiltinString): True
				_: False
		PrimitiveHead(BuiltinVoid):
			match right:
				PrimitiveHead(BuiltinVoid): True
				_: False
		ListHead:
			match right:
				ListHead: True
				_: False
		UnionHead(first):
			match right:
				UnionHead(second): IntOps.equals(union_number(first), union_number(second))
				_: False
		RecordHead(first):
			match right:
				RecordHead(second): IntOps.equals(record_number(first), record_number(second))
				_: False


private pure func same_entity(left: Entity, right: Entity) -> Bool:
	match left:
		Function(first):
			match right:
				Function(second): IntOps.equals(function_number(first), function_number(second))
				_: False
		Constant(first):
			match right:
				Constant(second): IntOps.equals(constant_number(first), constant_number(second))
				_: False
		Constructor(first):
			match right:
				Constructor(second):
					IntOps.equals(union_number(variant_owner(first)), union_number(variant_owner(second))) and IntOps.equals(variant_number(first), variant_number(second))
				_: False
		Type(first):
			match right:
				Type(second): same_head(first, second)
				_: False
		Alias(first):
			match right:
				Alias(second): same_module(first.target, second.target)
				_: False


-- The head a builtin type declaration of the base declares.
pure func builtin_head(declaration: ParsedBuiltinType) -> TypeHead:
	match declaration:
		IntegerBuiltin(_): PrimitiveHead(BuiltinInt)
		FloatBuiltin(_): PrimitiveHead(BuiltinFloat)
		StringBuiltin(_): PrimitiveHead(BuiltinString)
		VoidBuiltin(_): PrimitiveHead(BuiltinVoid)
		ListBuiltin(_): ListHead


-- The rule and the offer.


private pure func empty_scope() -> ModuleScope:
	none: List[MethodImport] = []
	{ names = IntMaps.empty_int_map(), methods = none }


-- A spelling's entry in each space has its own key: 2n for values and 2n + 1
-- for types, where n is the spelling's `name_number`.
private pure func space_key(space: Space, name: NameId) -> Int:
	values_key = IntOps.multiply(name_number(name), 2)
	match space:
		Values: values_key
		Types: IntOps.add(values_key, 1)


-- The entry `names` holds for `name` in `space`; the rule leaves at most one.
private pure func holder(names: IntMaps.IntMap[Entry], space: Space, name: NameId) -> Option[Entry]:
	IntMaps.get(names, space_key(space, name))


-- A module reports its first problem in source order. Names do not enter in
-- source order (`methods_only` selections follow every row), but every
-- problem's span lies in the module's own source, so starts compare.
private pure func first_problem(found: Option[NamespaceProblem], later: NamespaceProblem) -> Option[NamespaceProblem]:
	match found:
		Some(earlier):
			if IntOps.less_than(namespace_problem_span(later).start, namespace_problem_span(earlier).start):
				Some(later)
			else:
				found
		None:
			Some(later)


-- What `names` already holds in a space that `entity` named `name` claims.
private pure func claimant(names: IntMaps.IntMap[Entry], name: NameId, entity: Entity) -> Option[Entry]:
	match entity:
		Function(_) | Constant(_) | Constructor(_):
			holder(names, Values, name)
		Type(_):
			holder(names, Types, name)
		Alias(_):
			match holder(names, Values, name):
				Some(held): Some(held)
				None: holder(names, Types, name)


-- `names` with `incoming` in each space it claims. This is a scope's only
-- writer, so a value key never holds a type, a type key never holds a function,
-- constant or constructor, and an alias, entered only by `import_row`, is always
-- `Imported`. The arms that read those states (in `named_value`, `named_type`,
-- `offered_value`, `offered_type`, `select_methods` and render) are
-- unreachable. Typed per-space entries would remove them, but measured they
-- cost a second copy of `enter` per space, about 37 more lines, and about 80
-- more allocations on a one-line program, so one `Entity` serves both spaces.
private pure func claimed(names: IntMaps.IntMap[Entry], incoming: Entry) -> IntMaps.IntMap[Entry]:
	name = incoming.name.id
	match incoming.entity:
		Function(_) | Constant(_) | Constructor(_):
			IntMaps.set(names, space_key(Values, name), incoming)
		Type(_):
			IntMaps.set(names, space_key(Types, name), incoming)
		Alias(_):
			IntMaps.set(IntMaps.set(names, space_key(Values, name), incoming), space_key(Types, name), incoming)


-- The scope rule. An import of an entity the module already sees (the
-- prelude's, and an explicit import of it) enters once; a declaration always
-- claims its spelling, so a second declaration of anything is a conflict.
-- Every path returns `built` or a record update of it: the host updates a
-- scope in place only then, and copies its map on every entry otherwise.
private pure func enter(built: BuiltScope, incoming: Entry) -> BuiltScope:
	match claimant(built.names, incoming.name.id, incoming.entity):
		None:
			{ built | names = claimed(built.names, incoming) }
		Some(held):
			arrives_again = match incoming.origin:
				Declared(_): False
				Imported | Implicit: same_entity(held.entity, incoming.entity)
			if arrives_again:
				built
			else:
				{ built | problem = first_problem(built.problem, NameConflict({ incoming = incoming, previous = held })) }


-- A module offers importers only its own public declarations (decided
-- 2026-10-15: a module never reexports), to selections, qualified names and
-- method imports alike. An alias is never offered.
private pure func offer(found: Option[Entry]) -> Result[Entity, Unoffered]:
	match found:
		Some(entry):
			match entry.entity:
				Alias(_): Err(UnknownName)
				Function(_) | Constant(_) | Constructor(_) | Type(_):
					match entry.origin:
						Declared(Public): Ok(entry.entity)
						Declared(Private(_)): Err(PrivateName)
						Imported: Err(ImportedThere(entry.entity))
						Implicit: Err(ProvidedThere(entry.entity))
		None:
			Err(UnknownName)


-- Building, in dependency order.


-- `entries` with a union's type, then each constructor with the union's visibility.
private pure func with_union(entries: List[Entry], row: UnionRow) -> List[Entry]:
	var grown = entries.append({ name = row.type_name, entity = Type(UnionHead(row.id)), origin = Declared(row.visibility) })
	for variant in row.variants:
		grown = grown.append({ name = variant.declaration.name, entity = Constructor(variant.id), origin = Declared(row.visibility) })
	grown


private pure func nominal_module(row: NominalRow) -> ModuleId:
	match row:
		UnionDeclarationRow(union_row): union_row.module
		RecordDeclarationRow(record_row): record_row.declaration.module


private pure func nominal_start(row: NominalRow) -> Int:
	match row:
		UnionDeclarationRow(union_row): union_row.type_name.span.start
		RecordDeclarationRow(record_row): record_row.declaration.type_name.span.start


-- Whether a module's next nominal declaration is written before its next
-- function, if it has one left.
private pure func written_before(nominal: NominalRow, function: Option[FunctionRow]) -> Bool:
	match function:
		Some(next): IntOps.less_than(nominal_start(nominal), next.declaration.function_name.span.start)
		None: True


-- Each module's declared entries in source order, indexed by module number.
-- Builtin types come first: the base owns them, so a union or record that
-- reuses a builtin's name is the one reported. Assembly appends each kind's
-- rows grouped by module in module order, so one cursor per kind reads each
-- row once; its next nominal declaration, function and constant are
-- taken in the order they are written.
private pure func declared_entries(parsed: ParsedContents) -> List[List[Entry]]:
	functions = inventory_functions(parsed.declarations)
	constants = inventory_constants(parsed.declarations)
	var builtins_seen = 0
	var functions_seen = 0
	var constants_seen = 0
	var records_seen = 0
	var unions_seen = 0
	var declared: List[List[Entry]] = []
	for row in parsed.modules:
		var entries: List[Entry] = []
		var reading = True
		while reading:
			match parsed.builtin_types.get(builtins_seen):
				Some(primitive):
					reading = same_module(primitive.module, row.module)
					if reading:
						entries = entries.append({ name = builtin_type_name(primitive.declaration), entity = Type(builtin_head(primitive.declaration)), origin = Declared(Public) })
						builtins_seen = IntOps.add(builtins_seen, 1)
				None:
					reading = False
		reading = True
		while reading:
			function: Option[FunctionRow] = match functions.get(functions_seen):
				Some(candidate):
					if same_module(candidate.declaration.module, row.module):
						Some(candidate)
					else:
						None
				None:
					None
			nominal: Option[NominalRow] = match next_nominal(parsed.declarations, records_seen, unions_seen):
				Some(candidate):
					if same_module(nominal_module(candidate), row.module) and written_before(candidate, function):
						Some(candidate)
					else:
						None
				None:
					None
			constant: Option[ConstantRow] = match constants.get(constants_seen):
				Some(candidate):
					before_function = match function:
						Some(next): IntOps.less_than(candidate.declaration.name.span.start, next.declaration.function_name.span.start)
						None: True
					before_nominal = match nominal:
						Some(next): IntOps.less_than(candidate.declaration.name.span.start, nominal_start(next))
						None: True
					if same_module(candidate.declaration.module, row.module) and before_function and before_nominal:
						Some(candidate)
					else:
						None
				None: None
			match constant:
				Some(constant_row):
					declaration = constant_row.declaration
					entries = entries.append({ name = declaration.name, entity = Constant(constant_row.id), origin = Declared(declaration.visibility) })
					constants_seen = IntOps.add(constants_seen, 1)
				None:
					match nominal:
						Some(UnionDeclarationRow(union_row)):
							entries = with_union(entries, union_row)
							unions_seen = IntOps.add(unions_seen, 1)
						Some(RecordDeclarationRow(record_row)):
							declaration = record_row.declaration
							entries = entries.append({ name = declaration.type_name, entity = Type(RecordHead(record_row.id)), origin = Declared(declaration.visibility) })
							records_seen = IntOps.add(records_seen, 1)
						None:
							match function:
								Some(function_row):
									entries = entries.append({ name = function_row.declaration.function_name, entity = Function(function_row.id), origin = Declared(function_row.declaration.visibility) })
									functions_seen = IntOps.add(functions_seen, 1)
								None:
									reading = False
		declared = declared.append(entries)
	declared


-- The prelude's selections, as every user module receives them. Its aliases
-- and declarations stay its own.
private pure func provided(prelude: ModuleScope) -> List[Entry]:
	var entries: List[Entry] = []
	for entry in IntMaps.values(prelude.names):
		match entry.entity:
			Alias(_): void
			Function(_) | Constant(_) | Constructor(_) | Type(_):
				match entry.origin:
					Imported: entries = entries.append({ entry | origin = Implicit })
					Declared(_) | Implicit: void
	entries


-- One module: the names it receives, then its import rows, its `methods_only`
-- selections, and its declarations, so a conflict is reported at the later
-- name, in this module. Each map is presized for the received and declared
-- names and one name per import row; a long selection list grows it. `empty`
-- is only the host `get` default: dependency order builds every target before
-- the modules that import it, so it is never read.
private pure func build_module(scopes: List[ModuleScope], empty: ModuleScope, row: ParsedModuleRow, declared: List[Entry], received: List[Entry], methods: List[MethodImport]) -> BuiltScope:
	expected = IntOps.add(IntOps.add(received.length(), declared.length()), row.imports.length())
	var built: BuiltScope = { names = IntMaps.int_map_with_capacity(expected), methods = methods, problem = None }
	for entry in received:
		built = enter(built, entry)
	for request in row.imports:
		built = import_row(built, scopes.get_or(module_number(request.target), empty), request)
	for request in row.imports:
		built = select_methods(built, scopes.get_or(module_number(request.target), empty), request)
	for entry in declared:
		built = enter(built, entry)
	built


-- Host `get` defaults are unreachable: every index is a sealed module number,
-- and the prelude precedes every user module in dependency order.
pure func build_namespace(program: ParsedProgram) -> Result[Namespace, NamespaceProblem]:
	parsed = parsed_contents(program)
	declared = declared_entries(parsed)
	none: List[MethodImport] = []
	nothing: List[Entry] = []
	empty = empty_scope()
	var scopes: List[ModuleScope] = repeat(empty, parsed.modules.length())
	var prelude_entries = nothing
	var prelude_methods = none
	var failure: Option[NamespaceProblem] = None
	for row in parsed.dependency_order:
		number = module_number(row.module)
		built = match row.role:
			UserModule: build_module(scopes, empty, row, declared.get_or(number, nothing), prelude_entries, prelude_methods)
			FoundationTypesModule | FoundationPreludeModule | LibraryModule: build_module(scopes, empty, row, declared.get_or(number, nothing), nothing, none)
		failure = built.problem
		scope: ModuleScope = { names = built.names, methods = built.methods }
		scopes = scopes.set(number, scope)
		if same_module(row.module, parsed.foundation.prelude):
			prelude_entries = provided(scope)
			prelude_methods = scope.methods
		if failure.is_some():
			break
	match failure:
		Some(problem): Err(problem)
		None: Ok(into_opaque Namespace(scopes))


-- Selection: how an import row enters names, its alias first and then each
-- selection, resolved against what the target offers. `methods_only`
-- selections are resolved after a module's rows, because a later row may
-- import the type they name.


-- A name the target only imports may already be in this module's scope.
private pure func seen_here(built: BuiltScope, name: NameId, problem: SelectionProblem) -> SelectionProblem:
	match problem:
		NotOffered(ImportedThere(entity)):
			match claimant(built.names, name, entity):
				Some(entry):
					if same_entity(entry.entity, entity):
						match entry.origin:
							Implicit: AlreadyFromPrelude(entity)
							Imported: AlreadyImported(entity)
							Declared(_): problem
					else:
						problem
				None:
					problem
		_:
			problem


private pure func fail(built: BuiltScope, request: ModuleImport, selection: ImportSelection, problem: SelectionProblem) -> BuiltScope:
	failure = SelectionFailure(request.path, selection, seen_here(built, selection_name(selection).id, problem))
	{ built | problem = first_problem(built.problem, failure) }


-- With nothing selected, the more specific reason is reported: a private
-- declaration, then any reason but a name the target does not have.
private pure func more_specific(value_reason: SelectionProblem, type_reason: SelectionProblem) -> SelectionProblem:
	match value_reason:
		NotOffered(PrivateName):
			value_reason
		_:
			match type_reason:
				NotOffered(UnknownName): value_reason
				_: type_reason


-- A bare name selects the target's public value or public type of that
-- name; both make it ambiguous, and a public constructor is named with its
-- union.
private pure func bare_selection(target: ModuleScope, name: NameId) -> Result[Entity, SelectionProblem]:
	value: Result[Entity, SelectionProblem] = match offer(holder(target.names, Values, name)):
		Ok(Constructor(variant)): Err(BareConstructor(variant))
		Ok(selected): Ok(selected)
		Err(reason): Err(NotOffered(reason))
	selected_type: Result[Entity, SelectionProblem] = match offer(holder(target.names, Types, name)):
		Ok(selected): Ok(selected)
		Err(reason): Err(NotOffered(reason))
	match value:
		Ok(selected):
			match selected_type:
				Ok(_):
					match selected:
						Function(_): Err(AmbiguousFunction)
						Constant(_): Err(AmbiguousConstant)
						Constructor(variant): Err(BareConstructor(variant))
						Type(_) | Alias(_): Err(NotOffered(UnknownName))
				Err(_): Ok(selected)
		Err(value_reason):
			match selected_type:
				Ok(selected): Ok(selected)
				Err(type_reason): Err(more_specific(value_reason, type_reason))


-- A selected name enters this module; a selected type also imports the
-- target's receiver functions of that type.
private pure func bind(built: BuiltScope, request: ModuleImport, name: WrittenName, entity: Entity) -> BuiltScope:
	entered = enter(built, { name = name, entity = entity, origin = Imported })
	match entity:
		Type(receiver):
			{ entered | methods = entered.methods.append({ target = request.target, receiver = receiver, name = name }) }
		Function(_) | Constant(_) | Constructor(_) | Alias(_):
			entered


-- `Union(First, ...)` selects a public union of the target and the listed
-- constructors, which the target declares with it. Kind comes before privacy:
-- a private record behind `Secret(Hidden)` is unknown, as a public one is.
private pure func select_union(built: BuiltScope, target: ModuleScope, request: ModuleImport, selection: ImportSelection, name: WrittenName, listed: List[WrittenName]) -> BuiltScope:
	found = holder(target.names, Types, name.id)
	match found:
		Some(entry):
			match entry.entity:
				Type(UnionHead(owner)):
					match offer(found):
						Err(reason):
							fail(built, request, selection, NotOffered(reason))
						Ok(union_type):
							var next = bind(built, request, name, union_type)
							for constructor in listed:
								next = match offer(holder(target.names, Values, constructor.id)):
									Ok(Constructor(variant)):
										if IntOps.equals(union_number(variant_owner(variant)), union_number(owner)):
											enter(next, { name = constructor, entity = Constructor(variant), origin = Imported })
										else:
											fail(next, request, selection, NotAConstructor(constructor))
									_:
										fail(next, request, selection, NotAConstructor(constructor))
							next
				_:
					fail(built, request, selection, NotOffered(UnknownName))
		None:
			fail(built, request, selection, NotOffered(UnknownName))


-- One `path [as Alias]: selections` row; its target was built first.
private pure func import_row(built: BuiltScope, target: ModuleScope, request: ModuleImport) -> BuiltScope:
	var next = built
	match request.module_alias:
		Some(written):
			next = enter(next, { name = written, entity = Alias({ target = request.target, path = request.path }), origin = Imported })
		None:
			void
	for selection in request.symbols:
		next = match selection:
			NamedSelection(name):
				match bare_selection(target, name.id):
					Ok(entity): bind(next, request, name, entity)
					Err(problem): fail(next, request, selection, problem)
			ConstructorSelection(name, listed):
				select_union(next, target, request, selection, name, listed)
			MethodsOnlySelection(_, _):
				next
	next


-- `T methods_only` enters no name. The target must hold the type, publicly or
-- by import, and this module must already see that same type.
private pure func select_methods(built: BuiltScope, target: ModuleScope, request: ModuleImport) -> BuiltScope:
	var next = built
	for selection in request.symbols:
		match selection:
			MethodsOnlySelection(name, _):
				offered = offer(holder(target.names, Types, name.id))
				holding: Result[Entity, Unoffered] = match offered:
					Err(ImportedThere(entity)): Ok(entity)
					Err(ProvidedThere(entity)): Ok(entity)
					_: offered
				next = match holding:
					Ok(Type(receiver)):
						seen = match holder(next.names, Types, name.id):
							Some(entry): same_entity(entry.entity, Type(receiver))
							None: False
						if seen:
							{ next | methods = next.methods.append({ target = request.target, receiver = receiver, name = name }) }
						else:
							fail(next, request, selection, ReceiverNotVisible)
					Ok(_):
						fail(next, request, selection, NotOffered(UnknownName))
					Err(reason):
						fail(next, request, selection, NotOffered(reason))
			NamedSelection(_) | ConstructorSelection(_, _):
				void
	next


-- Queries: the checker reads the namespace only through these.


-- What `module` holds for `name` in `space`. Host `get` returns an Option even
-- for a sealed module number, which always has a scope.
private pure func held_in(namespace: Namespace, module: ModuleId, space: Space, name: NameId) -> Option[Entry]:
	scopes: List[ModuleScope] = from_opaque Namespace(namespace)
	match scopes.get(module_number(module)):
		Some(scope): holder(scope.names, space, name)
		None: None


-- What `name` denotes as a value in `module`. The scope rule leaves one entry,
-- so no caller chooses.
pure func named_value(namespace: Namespace, module: ModuleId, name: NameId) -> Option[NamedValue]:
	match held_in(namespace, module, Values, name):
		Some(entry):
			match entry.entity:
				Function(id):
					source = match entry.origin:
						Declared(_): DeclaredHere
						Imported | Implicit: ImportedAt(entry.name.span)
					Some(NamedFunction(id, source))
				Constant(id): Some(NamedConstant(id))
				Constructor(variant): Some(NamedConstructor(variant))
				Alias(aliased): Some(NamedAlias(aliased))
				Type(_): None
		None:
			None


-- The value-space conflict fact; type-only names cannot conflict with a local.
pure func value_binding(namespace: Namespace, module: ModuleId, name: NameId) -> Option[ValueBinding]:
	match held_in(namespace, module, Values, name):
		None: None
		Some(entry):
			match entry.entity:
				Function(_): Some(FunctionName(entry.name))
				Constant(_): Some(ConstantName(entry.name))
				Constructor(_): Some(ConstructorName(entry.name))
				Alias(_): Some(ModuleAliasName(entry.name))
				Type(_): None


-- The type `name` denotes in `module`; a module alias, which also claims the
-- type space, denotes none.
pure func named_type(namespace: Namespace, module: ModuleId, name: NameId) -> Option[NamedType]:
	match held_in(namespace, module, Types, name):
		Some(entry):
			match entry.entity:
				Type(head): Some({ head = head, origin = entry.origin })
				Function(_) | Constant(_) | Constructor(_) | Alias(_): None
		None:
			None


-- The function, constant or constructor `target` offers as `name`.
pure func offered_value(namespace: Namespace, target: ModuleId, name: NameId) -> Result[OfferedValue, Unoffered]:
	match offer(held_in(namespace, target, Values, name)):
		Ok(Function(id)): Ok(OfferedFunction(id))
		Ok(Constant(id)): Ok(OfferedConstant(id))
		Ok(Constructor(variant)): Ok(OfferedConstructor(variant))
		Ok(_): Err(UnknownName)
		Err(reason): Err(reason)


-- The type `target` offers as `name`: `A.T`.
pure func offered_type(namespace: Namespace, target: ModuleId, name: NameId) -> Result[TypeHead, Unoffered]:
	match offer(held_in(namespace, target, Types, name)):
		Ok(Type(head)): Ok(head)
		Ok(_): Err(UnknownName)
		Err(reason): Err(reason)


-- Host `get` returns an Option even for a sealed module number, which always
-- has a scope.
pure func method_imports(namespace: Namespace, module: ModuleId) -> List[MethodImport]:
	scopes: List[ModuleScope] = from_opaque Namespace(namespace)
	match scopes.get(module_number(module)):
		Some(scope): scope.methods
		None: []


-- The sealed scope's existing entries in namespace insertion order. The list
-- has value semantics; consumers project through the function queries below.
pure func module_entries(namespace: Namespace, module: ModuleId) -> List[Entry]:
	scopes: List[ModuleScope] = from_opaque Namespace(namespace)
	match scopes.get(module_number(module)):
		Some(scope): IntMaps.values(scope.names)
		None: []


-- One of this module's declarations, including its private functions.
pure func declared_function(entry: Entry) -> Option[FunctionId]:
	match entry.origin:
		Declared(_):
			match entry.entity:
				Function(id): Some(id)
				_: None
		Imported | Implicit: None


-- The same declaration when the namespace's one offer rule makes it public.
pure func offered_function(entry: Entry) -> Option[FunctionId]:
	match declared_function(entry):
		None: None
		Some(id):
			match offer(Some(entry)):
				Ok(_): Some(id)
				Err(_): None


pure func namespace_problem_span(problem: NamespaceProblem) -> Span:
	match problem:
		NameConflict(conflict):
			conflict.incoming.name.span
		SelectionFailure(_, _, NotAConstructor(constructor)):
			constructor.span
		SelectionFailure(_, selection, _):
			selection_name(selection).span
