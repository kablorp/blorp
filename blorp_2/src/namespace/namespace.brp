import:
	../utils/ids:
		FunctionId, RecordId, UnionId, VariantId,
		function_number, record_number,
		union_number, variant_number, variant_owner,
		inventory_functions, inventory_records, inventory_unions,
		NominalRow(UnionDeclarationRow, RecordDeclarationRow), next_nominal,
	int as IntOps
	../utils/names: NameId, same_name
	../parse/assemble: ModuleImport, ParsedContents, ParsedModuleRow, ParsedProgram, parsed_contents
	../parse/parse: ImportSelection(NamedSelection, ConstructorSelection, MethodsOnlySelection), ModulePath
	./builtins: PrimitiveType(BuiltinInt, BuiltinFloat, BuiltinString, BuiltinVoid), builtin_type_name
	../utils/source: ModuleId, ModuleKind(UserModule), same_module
	../utils/syntax:
		ParsedBuiltinType(IntegerBuiltin, FloatBuiltin, StringBuiltin, VoidBuiltin, ListBuiltin),
		Span, Visibility(Public, Private), WrittenName,


fixed union FunctionOrigin:
	LocalFunction
	ImportedFunction(Span)


fixed record FunctionCandidate {
	function: FunctionId,
	origin: FunctionOrigin
}


fixed record ImportedFunctionBinding {
	module: ModuleId,
	name: WrittenName,
	function: FunctionId
}


-- A constructor name visible in a module, whether declared there or imported.
-- `visibility` is the declaring union's: constructors are exported with it.
private fixed record VariantBinding {
	module: ModuleId,
	name: WrittenName,
	variant: VariantId,
	declaration_span: Span,
	visibility: Visibility
}


-- `path as Alias` in one module's import block: the alias is a module name,
-- scoped to the importing module, never a value or type.
fixed record ModuleAlias {
	module: ModuleId,
	name: WrittenName,
	target: ModuleId,
	path: ModulePath
}


-- What a qualified name finds among a module's own declarations.
fixed union QualifiedLookup[A]:
	ExportedDeclaration(A)
	PrivateDeclaration(Span)
	NoDeclaration


-- These heads reserve declaration identity; accepted parameter types remain
-- solely in the checker. List has no primitive scalar representation.
fixed union TypeCandidate:
	PrimitiveCandidate(PrimitiveType)
	ListCandidate
	UnionCandidate(UnionId)
	RecordCandidate(RecordId)


fixed record MethodSelectionRequest {
	module: ModuleId,
	target: ModuleId,
	name: WrittenName,
	receiver: TypeCandidate
}


fixed union ImportProblem:
	RepeatedModuleImport(ModuleId, Span, Span)
	MissingImportedFunction(ModuleId, WrittenName)
	RepeatedImportedFunction(WrittenName, Span)
	AmbiguousImportSelection(ModuleId, WrittenName)
	MissingImportedType(ModuleId, WrittenName)
	AmbiguousImportedType(ModuleId, WrittenName)
	MethodTypeNotVisible(WrittenName)
	MissingImportedUnion(WrittenName)
	AmbiguousImportedUnion(WrittenName)
	MissingImportedVariant(WrittenName)
	RepeatedImportedVariant(WrittenName, Span)
	ImportedTypeConflict(WrittenName, Span)
	PrivateImportSelection(WrittenName, ModulePath)
	RepeatedModuleAlias(WrittenName, Span)
	ModuleAliasNameConflict(WrittenName, Span)


fixed union NamespaceProblem:
	ImportSelectionFailure(ImportProblem)
	DuplicateFunctionName(WrittenName, Span)
	DuplicateUnionName(WrittenName, Span)
	DuplicateTypeName(WrittenName, Span)
	DuplicateVariantName(WrittenName, Span)
	VariantFunctionNameConflict(NameId, Span, Span)
	ImportedConstructorNameConflict(WrittenName, Span)
	ImportedFunctionNameConflict(WrittenName, Span)
	ImportedVariantNameConflict(WrittenName, Span)


fixed record NamespaceFailure {
	first: NamespaceProblem,
	remaining: List[NamespaceProblem]
}


private fixed record LocalFunctionBinding {
	module: ModuleId,
	name: WrittenName,
	function: FunctionId,
	visibility: Visibility
}


-- A type name visible in `module`: declared there (builtins belong to the
-- foundation types module) with its visibility, or forwarded by an import,
-- which never exports.
private fixed union TypeOrigin:
	DeclaredType(Visibility)
	ImportedType


private fixed record TypeBinding {
	module: ModuleId,
	name: WrittenName,
	target: TypeCandidate,
	origin: TypeOrigin
}


private fixed union TypeSelectionKind:
	AnyTypeSelection
	UnionTypeSelection


-- Transient written requests supply type scope before signatures exist. Keeping
-- their importing module explicit also distinguishes prelude selections from
-- declarations that merely happen to live in the prelude module.
private fixed record TypeImportRequest {
	module: ModuleId,
	target: ModuleId,
	name: WrittenName,
	kind: TypeSelectionKind
}


private fixed record NamespaceContents {
	functions: List[LocalFunctionBinding],
	imports: List[ImportedFunctionBinding],
	constructors: List[VariantBinding],
	types: List[TypeBinding],
	variants: List[VariantBinding],
	methods: List[MethodSelectionRequest],
	aliases: List[ModuleAlias]
}


-- Derived once from a sealed parsed program. No accepted signatures or types
-- enter this product; the checker interprets method requests after signatures.
opaque type Namespace = NamespaceContents


pure func same_type_candidate(left: TypeCandidate, right: TypeCandidate) -> Bool:
	match left:
		PrimitiveCandidate(BuiltinInt):
			match right:
				PrimitiveCandidate(BuiltinInt): True
				_: False
		PrimitiveCandidate(BuiltinFloat):
			match right:
				PrimitiveCandidate(BuiltinFloat): True
				_: False
		PrimitiveCandidate(BuiltinString):
			match right:
				PrimitiveCandidate(BuiltinString): True
				_: False
		PrimitiveCandidate(BuiltinVoid):
			match right:
				PrimitiveCandidate(BuiltinVoid): True
				_: False
		ListCandidate:
			match right:
				ListCandidate: True
				_: False
		UnionCandidate(first):
			match right:
				UnionCandidate(second): same_union(first, second)
				_: False
		RecordCandidate(first):
			match right:
				RecordCandidate(second): IntOps.equals(record_number(first), record_number(second))
				_: False


private pure func local_functions(bindings: List[LocalFunctionBinding], module: ModuleId, name: NameId) -> List[FunctionId]:
	var candidates: List[FunctionId] = []
	for binding in bindings:
		if same_module(binding.module, module) and same_name(binding.name.id, name):
			candidates = candidates.append(binding.function)
	candidates


private pure func first_local_function(bindings: List[LocalFunctionBinding], module: ModuleId, name: NameId) -> Option[LocalFunctionBinding]:
	var found: Option[LocalFunctionBinding] = None
	for binding in bindings:
		if same_module(binding.module, module) and same_name(binding.name.id, name):
			found = Some(binding)
			break
	found


pure func local_function(namespace: Namespace, module: ModuleId, name: NameId) -> Option[FunctionId]:
	first_local_function(from_opaque Namespace(namespace).functions, module, name).map(pure func(binding): binding.function)


private pure func same_function(left: FunctionId, right: FunctionId) -> Bool:
	IntOps.equals(function_number(left), function_number(right))


private pure func same_union(left: UnionId, right: UnionId) -> Bool:
	IntOps.equals(union_number(left), union_number(right))


private pure func same_variant(left: VariantId, right: VariantId) -> Bool:
	same_union(variant_owner(left), variant_owner(right)) and IntOps.equals(variant_number(left), variant_number(right))


pure func function_candidate(namespace: Namespace, module: ModuleId, name: NameId) -> Option[FunctionCandidate]:
	contents = from_opaque Namespace(namespace)
	var found: Option[FunctionCandidate] = None
	match first_local_function(contents.functions, module, name):
		Some(binding): found = Some({ function = binding.function, origin = LocalFunction })
		None:
			for binding in contents.imports:
				if same_module(binding.module, module) and same_name(binding.name.id, name):
					found = Some({ function = binding.function, origin = ImportedFunction(binding.name.span) })
					break
	found


private pure func visible_types(bindings: List[TypeBinding], module: ModuleId, name: NameId) -> List[TypeCandidate]:
	var candidates: List[TypeCandidate] = []
	for binding in bindings:
		if same_module(binding.module, module) and same_name(binding.name.id, name):
			var present = False
			for candidate in candidates:
				present = present or same_type_candidate(candidate, binding.target)
			if not present:
				candidates = candidates.append(binding.target)
	candidates


pure func type_candidate(namespace: Namespace, module: ModuleId, name: NameId) -> Option[TypeCandidate]:
	var found: Option[TypeCandidate] = None
	for binding in from_opaque Namespace(namespace).types:
		if same_module(binding.module, module) and same_name(binding.name.id, name):
			found = Some(binding.target)
			break
	found


pure func variant_candidates(namespace: Namespace, module: ModuleId, name: NameId) -> List[VariantId]:
	contents = from_opaque Namespace(namespace)
	var candidates: List[VariantId] = []
	for binding in contents.variants:
		if same_module(binding.module, module) and same_name(binding.name.id, name):
			candidates = candidates.append(binding.variant)
	for binding in contents.constructors:
		if same_module(binding.module, module) and same_name(binding.name.id, name):
			var present = False
			for candidate in candidates:
				present = present or same_variant(candidate, binding.variant)
			if not present:
				candidates = candidates.append(binding.variant)
	candidates


pure func imported_functions(namespace: Namespace) -> List[ImportedFunctionBinding]:
	from_opaque Namespace(namespace).imports


pure func module_alias(namespace: Namespace, module: ModuleId, name: NameId) -> Option[ModuleAlias]:
	var found: Option[ModuleAlias] = None
	for row in from_opaque Namespace(namespace).aliases:
		if same_module(row.module, module) and same_name(row.name.id, name):
			found = Some(row)
			break
	found


private pure func exported[A](visibility: Visibility, declaration: A) -> QualifiedLookup[A]:
	match visibility:
		Public: ExportedDeclaration(declaration)
		Private(span): PrivateDeclaration(span)


-- The functions a module declares itself; imports are not reexported.
pure func qualified_function(namespace: Namespace, target: ModuleId, name: NameId) -> QualifiedLookup[FunctionId]:
	match first_local_function(from_opaque Namespace(namespace).functions, target, name):
		Some(binding): exported(binding.visibility, binding.function)
		None: NoDeclaration


pure func qualified_variant(namespace: Namespace, target: ModuleId, name: NameId) -> QualifiedLookup[VariantId]:
	var found: QualifiedLookup[VariantId] = NoDeclaration
	for binding in from_opaque Namespace(namespace).variants:
		if same_module(binding.module, target) and same_name(binding.name.id, name):
			found = exported(binding.visibility, binding.variant)
			break
	found


pure func qualified_type(namespace: Namespace, target: ModuleId, name: NameId) -> QualifiedLookup[TypeCandidate]:
	var found: QualifiedLookup[TypeCandidate] = NoDeclaration
	for binding in from_opaque Namespace(namespace).types:
		if same_module(binding.module, target) and same_name(binding.name.id, name):
			match binding.origin:
				DeclaredType(visibility):
					found = exported(visibility, binding.target)
					break
				ImportedType: void
	found


-- The public functions `module` declares itself: what an importer's method
-- selection may bind. Visibility is read here, not by the checker.
pure func exported_functions(namespace: Namespace, module: ModuleId) -> List[FunctionId]:
	var functions: List[FunctionId] = []
	for binding in from_opaque Namespace(namespace).functions:
		if same_module(binding.module, module):
			match binding.visibility:
				Public: functions = functions.append(binding.function)
				Private(_): void
	functions


-- The span of a private declaration `name` in `target`, if any.
private pure func private_declaration(scan: ImportScan, target: ModuleId, name: NameId) -> Option[Span]:
	var found: Option[Span] = None
	match first_local_function(scan.functions, target, name):
		Some(binding):
			match binding.visibility:
				Private(span): found = Some(span)
				Public: void
		None:
			for binding in scan.types:
				if same_module(binding.module, target) and same_name(binding.name.id, name):
					match binding.origin:
						DeclaredType(Private(span)):
							found = Some(span)
							break
						DeclaredType(Public) | ImportedType: void
	found


pure func method_selection_requests(namespace: Namespace) -> List[MethodSelectionRequest]:
	from_opaque Namespace(namespace).methods


pure func import_problem_span(problem: ImportProblem) -> Span:
	match problem:
		RepeatedModuleImport(_, _, occurrence): occurrence
		MissingImportedFunction(_, name): name.span
		RepeatedImportedFunction(name, _): name.span
		AmbiguousImportSelection(_, name): name.span
		MissingImportedType(_, name): name.span
		AmbiguousImportedType(_, name): name.span
		MethodTypeNotVisible(name): name.span
		MissingImportedUnion(name): name.span
		AmbiguousImportedUnion(name): name.span
		MissingImportedVariant(name): name.span
		RepeatedImportedVariant(name, _): name.span
		ImportedTypeConflict(name, _): name.span
		PrivateImportSelection(name, _): name.span
		RepeatedModuleAlias(name, _): name.span
		ModuleAliasNameConflict(name, _): name.span


pure func namespace_problem_span(problem: NamespaceProblem) -> Span:
	match problem:
		ImportSelectionFailure(rejection): import_problem_span(rejection)
		DuplicateFunctionName(name, _): name.span
		DuplicateUnionName(name, _): name.span
		DuplicateTypeName(name, _): name.span
		DuplicateVariantName(name, _): name.span
		ImportedConstructorNameConflict(name, _): name.span
		ImportedFunctionNameConflict(name, _): name.span
		ImportedVariantNameConflict(name, _): name.span
		VariantFunctionNameConflict(_, variant, function):
			if IntOps.less_than(variant.start, function.start):
				function
			else:
				variant


-- Row scans over the namespace's binding tables. A row is the same fact when
-- its module and declaration identity agree; a conflict keeps the spelling.
-- Two type rows name the same thing in the same module scope.
private pure func same_type_name(left: TypeBinding, right: TypeBinding) -> Bool:
	same_module(left.module, right.module) and same_name(left.name.id, right.name.id)


private pure func contains_type(bindings: List[TypeBinding], row: TypeBinding) -> Bool:
	var present = False
	for binding in bindings:
		present = present or (same_type_name(binding, row) and same_type_candidate(binding.target, row.target))
	present


private pure func with_type(bindings: List[TypeBinding], row: TypeBinding) -> List[TypeBinding]:
	if contains_type(bindings, row):
		bindings
	else:
		bindings.append(row)


-- First-match scans read the whole list and keep the first hit: the language has
-- no early return, and recursing per element would add a position parameter.
private pure func type_conflict(bindings: List[TypeBinding], row: TypeBinding) -> Option[Span]:
	var conflict: Option[Span] = None
	for binding in bindings:
		if conflict.is_none() and same_type_name(binding, row) and not same_type_candidate(binding.target, row.target):
			conflict = Some(binding.name.span)
	conflict


private pure func contains_variant(bindings: List[VariantBinding], row: VariantBinding) -> Bool:
	var present = False
	for binding in bindings:
		present = present or (same_module(binding.module, row.module) and same_variant(binding.variant, row.variant))
	present


private pure func earlier_function_import(bindings: List[ImportedFunctionBinding], row: ImportedFunctionBinding) -> Option[Span]:
	var earlier: Option[Span] = None
	for binding in bindings:
		if earlier.is_none() and same_module(binding.module, row.module) and same_function(binding.function, row.function):
			earlier = Some(binding.name.span)
	earlier


private pure func local_types(parsed: ParsedContents) -> List[TypeBinding]:
	var types: List[TypeBinding] = []
	for declaration in parsed.builtin_types:
		if same_module(declaration.module, parsed.foundation.types):
			target: TypeCandidate = match declaration.declaration:
				IntegerBuiltin(_): PrimitiveCandidate(BuiltinInt)
				FloatBuiltin(_): PrimitiveCandidate(BuiltinFloat)
				StringBuiltin(_): PrimitiveCandidate(BuiltinString)
				VoidBuiltin(_): PrimitiveCandidate(BuiltinVoid)
				ListBuiltin(_): ListCandidate
			types = types.append({ module = declaration.module, name = builtin_type_name(declaration.declaration), target = target, origin = DeclaredType(Public) })
	for declaration in inventory_unions(parsed.declarations):
		types = types.append({ module = declaration.module, name = declaration.type_name, target = UnionCandidate(declaration.id), origin = DeclaredType(declaration.visibility) })
	for row in inventory_records(parsed.declarations):
		declaration = row.declaration
		types = types.append({ module = declaration.module, name = declaration.type_name, target = RecordCandidate(row.id), origin = DeclaredType(declaration.visibility) })
	types


private pure func type_import_requests(
	modules: List[ParsedModuleRow],
	functions: List[LocalFunctionBinding],
) -> List[TypeImportRequest]:
	var requests: List[TypeImportRequest] = []
	for module in modules:
		for request in module.imports:
			for selection in request.symbols:
				match selection:
					NamedSelection(name):
						if local_functions(functions, request.target, name.id).is_empty():
							requests = requests.append({ module = module.module, target = request.target, name = name, kind = AnyTypeSelection })
					ConstructorSelection(name, _):
						requests = requests.append({ module = module.module, target = request.target, name = name, kind = UnionTypeSelection })
					MethodsOnlySelection(_, _): void
	requests


private pure func selected_head(kind: TypeSelectionKind, candidate: TypeCandidate) -> Bool:
	match kind:
		AnyTypeSelection: True
		UnionTypeSelection:
			match candidate:
				UnionCandidate(_): True
				_: False


-- Modules whose implicit scope includes the designated prelude's selections.
private pure func user_modules(parsed: ParsedContents) -> List[ModuleId]:
	var users: List[ModuleId] = []
	for module in parsed.modules:
		match module.role:
			UserModule: users = users.append(module.module)
			_: void
	users


-- The finite set is (scope, name, original head). Each round only adds a new
-- member, so forwarding cycles converge and cannot manufacture an origin.
private pure func complete_types(
	parsed: ParsedContents,
	requests: List[TypeImportRequest],
	local: List[TypeBinding],
) -> List[TypeBinding]:
	users = user_modules(parsed)
	var types = local
	var changed = True
	while changed:
		before = types.length()
		for request in requests:
			for candidate in visible_types(types, request.target, request.name.id):
				if selected_head(request.kind, candidate):
					row: TypeBinding = { module = request.module, name = request.name, target = candidate, origin = ImportedType }
					types = with_type(types, row)
					if same_module(request.module, parsed.foundation.prelude):
						for user in users:
							types = with_type(types, { row | module = user })
		changed = IntOps.greater_than(types.length(), before)
	types


private pure func implicit_types(
	parsed: ParsedContents,
	requests: List[TypeImportRequest],
	types: List[TypeBinding],
) -> List[TypeBinding]:
	var implicit: List[TypeBinding] = []
	for user in user_modules(parsed):
		for request in requests:
			if same_module(request.module, parsed.foundation.prelude):
				for candidate in visible_types(types, request.target, request.name.id):
					if selected_head(request.kind, candidate):
						implicit = with_type(implicit, { module = user, name = request.name, target = candidate, origin = ImportedType })
	implicit


private pure func written_name(selection: ImportSelection) -> WrittenName:
	match selection:
		NamedSelection(name): name
		ConstructorSelection(name, _): name
		MethodsOnlySelection(name, _): name


private pure func selected_type(
	types: List[TypeBinding],
	target: ModuleId,
	selection: ImportSelection,
) -> Result[TypeCandidate, ImportProblem]:
	name = written_name(selection)
	candidates = visible_types(types, target, name.id)
	match selection:
		ConstructorSelection(_, _):
			match candidates:
				[UnionCandidate(owner)]: Ok(UnionCandidate(owner))
				[] | [PrimitiveCandidate(_)] | [ListCandidate] | [RecordCandidate(_)]: Err(MissingImportedUnion(name))
				_: Err(AmbiguousImportedUnion(name))
		NamedSelection(_):
			match candidates:
				[candidate]: Ok(candidate)
				-- A bare name that is neither a function nor a type.
				[]: Err(MissingImportedFunction(target, name))
				_: Err(AmbiguousImportedType(target, name))
		MethodsOnlySelection(_, _):
			match candidates:
				[candidate]: Ok(candidate)
				[]: Err(MissingImportedType(target, name))
				_: Err(AmbiguousImportedType(target, name))


-- The first three fields are read-only scope that selections resolve against; the
-- rest accumulate rows and problems in source order. bound_types is the importing
-- scopes' type view, used only to detect conflicting type names.
private fixed record ImportScan {
	functions: List[LocalFunctionBinding],
	variants: List[VariantBinding],
	types: List[TypeBinding],
	imports: List[ImportedFunctionBinding],
	constructors: List[VariantBinding],
	methods: List[MethodSelectionRequest],
	problems: List[ImportProblem],
	bound_types: List[TypeBinding],
	aliases: List[ModuleAlias]
}


-- One written selection: the importing module, the module it selects from.
private fixed record ImportSite {
	module: ModuleId,
	target: ModuleId,
	path: ModulePath,
	selection: ImportSelection
}


-- A method-only selection adds no type name; it needs one already visible.
private pure func import_receiver(scan: ImportScan, site: ImportSite, receiver: TypeCandidate) -> ImportScan:
	name = written_name(site.selection)
	row: TypeBinding = { module = site.module, name = name, target = receiver, origin = ImportedType }
	request: MethodSelectionRequest = { module = site.module, target = site.target, name = name, receiver = receiver }
	match site.selection:
		MethodsOnlySelection(_, _):
			if contains_type(scan.types, row):
				{ scan | methods = scan.methods.append(request) }
			else:
				{ scan | problems = scan.problems.append(MethodTypeNotVisible(name)) }
		NamedSelection(_) | ConstructorSelection(_, _):
			problems = match type_conflict(scan.bound_types, row):
				Some(first): scan.problems.append(ImportedTypeConflict(name, first))
				None: scan.problems
			{ scan | methods = scan.methods.append(request), problems = problems, bound_types = with_type(scan.bound_types, row) }


-- Find the union's variant the selection names and import it.
private pure func import_variant(scan: ImportScan, site: ImportSite, owner: UnionId, written: WrittenName) -> ImportScan:
	var found: Option[VariantBinding] = None
	for variant in scan.variants:
		if found.is_none() and same_name(variant.name.id, written.id) and same_union(variant_owner(variant.variant), owner):
			found = Some({ variant | module = site.module, name = written })
	match found:
		None:
			{ scan | problems = scan.problems.append(MissingImportedVariant(written)) }
		Some(binding):
			if contains_variant(scan.constructors, binding):
				scan
			else:
				{ scan | constructors = scan.constructors.append(binding) }


-- Each selected constructor must belong to the union; naming one twice is reported too.
private pure func import_variants(scan: ImportScan, site: ImportSite, receiver: TypeCandidate) -> ImportScan:
	match site.selection:
		ConstructorSelection(_, selected):
			match receiver:
				UnionCandidate(owner):
					var next = scan
					var seen: List[WrittenName] = []
					for written in selected:
						var earlier: Option[Span] = None
						for first in seen:
							if earlier.is_none() and same_name(first.id, written.id):
								earlier = Some(first.span)
						match earlier:
							Some(span): next = { next | problems = next.problems.append(RepeatedImportedVariant(written, span)) }
							None: void
						seen = seen.append(written)
						next = import_variant(next, site, owner, written)
					next
				PrimitiveCandidate(_) | ListCandidate | RecordCandidate(_):
					scan
		NamedSelection(_) | MethodsOnlySelection(_, _):
			scan


-- A bare name selects a target-local function or a visible type; naming both is
-- ambiguous. A private declaration of the target is not selectable (GUIDE,
-- Visibility: "not visible to importers").
private pure func import_selection(scan: ImportScan, site: ImportSite) -> ImportScan:
	name = written_name(site.selection)
	match private_declaration(scan, site.target, name.id):
		Some(_): { scan | problems = scan.problems.append(PrivateImportSelection(name, site.path)) }
		None: select_visible(scan, site, name)


private pure func select_visible(scan: ImportScan, site: ImportSite, name: WrittenName) -> ImportScan:
	functions: List[FunctionId] = match site.selection:
		NamedSelection(_): local_functions(scan.functions, site.target, name.id)
		_: []
	if functions.is_empty():
		match selected_type(scan.types, site.target, site.selection):
			Err(problem): { scan | problems = scan.problems.append(problem) }
			Ok(receiver):
				bound = import_receiver(scan, site, receiver)
				import_variants(bound, site, receiver)
	else if visible_types(scan.types, site.target, name.id).is_empty():
		var next = scan
		for function in functions:
			row: ImportedFunctionBinding = { module = site.module, name = name, function = function }
			match earlier_function_import(next.imports, row):
				Some(first): next = { next | problems = next.problems.append(RepeatedImportedFunction(name, first)) }
				None: next = { next | imports = next.imports.append(row) }
		next
	else:
		{ scan | problems = scan.problems.append(AmbiguousImportSelection(site.target, name)) }


-- Each module may be imported once (GUIDE, One Import Per Module): an alias
-- and selections of one module share a row. An alias is unique in its module.
private pure func import_module(scan: ImportScan, row: ParsedModuleRow) -> ImportScan:
	var next = scan
	var previous: List[ModuleImport] = []
	for request in row.imports:
		var earlier: Option[Span] = None
		for first in previous:
			if earlier.is_none() and same_module(first.target, request.target):
				earlier = Some(first.span)
		match earlier:
			Some(span): next = { next | problems = next.problems.append(RepeatedModuleImport(request.target, span, request.span)) }
			None: void
		previous = previous.append(request)
		match request.module_alias:
			None: void
			Some(aliased):
				var repeated: Option[Span] = None
				for existing in next.aliases:
					if repeated.is_none() and same_module(existing.module, row.module) and same_name(existing.name.id, aliased.id):
						repeated = Some(existing.name.span)
				match repeated:
					Some(span): next = { next | problems = next.problems.append(RepeatedModuleAlias(aliased, span)) }
					None: next = { next | aliases = next.aliases.append({ module = row.module, name = aliased, target = request.target, path = request.path }) }
		for selection in request.symbols:
			next = import_selection(next, { module = row.module, target = request.target, path = request.path, selection = selection })
	next


-- Only the designated prelude supplies an implicit scope. Ordinary module
-- type forwarding deliberately never forwards imported functions or methods.
private pure func complete_scope(scan: ImportScan, parsed: ParsedContents) -> NamespaceContents:
	var imports = scan.imports
	var constructors = scan.constructors
	var methods = scan.methods
	for user in user_modules(parsed):
		for binding in scan.imports:
			if same_module(binding.module, parsed.foundation.prelude):
				row = { binding | module = user }
				if earlier_function_import(imports, row).is_none():
					imports = imports.append(row)
		for binding in scan.constructors:
			if same_module(binding.module, parsed.foundation.prelude):
				row = { binding | module = user }
				if not contains_variant(constructors, row):
					constructors = constructors.append(row)
		for request in scan.methods:
			if same_module(request.module, parsed.foundation.prelude):
				methods = methods.append({ request | module = user })
	{
			functions = scan.functions,
			imports = imports,
			constructors = constructors,
			types = scan.types,
			variants = scan.variants,
			methods = methods,
			aliases = scan.aliases
		}


-- The private scope includes implicit exposures before validation. No opaque
-- Namespace exists until all declaration and visibility facts are accepted.
pure func build_namespace(program: ParsedProgram) -> Result[Namespace, NamespaceFailure]:
	parsed = parsed_contents(program)
	var functions: List[LocalFunctionBinding] = []
	for row in inventory_functions(parsed.declarations):
		function = row.declaration
		functions = functions.append({ module = function.module, name = function.function_name, function = row.id, visibility = function.visibility })
	var variants: List[VariantBinding] = []
	for declaration in inventory_unions(parsed.declarations):
		for variant in declaration.variants:
			variants = variants.append({
				module = declaration.module, name = variant.declaration.name,
				variant = variant.id, declaration_span = variant.declaration.name.span,
				visibility = declaration.visibility
			})
	local = local_types(parsed)
	requests = type_import_requests(parsed.modules, functions)
	types = complete_types(parsed, requests, local)
	implicit = implicit_types(parsed, requests, types)
	var conflicts: List[ImportProblem] = []
	for binding in local:
		match type_conflict(implicit, binding):
			Some(previous): conflicts = conflicts.append(ImportedTypeConflict(binding.name, previous))
			None: void
	var scan: ImportScan = {
		functions = functions,
		variants = variants,
		types = types,
		imports = [],
		constructors = [],
		methods = [],
		problems = conflicts,
		bound_types = implicit.concat(local),
		aliases = []
	}
	for row in parsed.modules:
		scan = import_module(scan, row)
	scope = complete_scope(scan, parsed)
	problems: List[NamespaceProblem] = scan.problems.map(pure func(problem): ImportSelectionFailure(problem))
		.concat(import_scope_problems(scope))
		.concat(local_declaration_problems(parsed, scope))
	match problems:
		[]: Ok(into_opaque Namespace(scope))
		[first, ...remaining]: Err({ first = first, remaining = remaining })


private pure func visible_function_span(scope: NamespaceContents, module: ModuleId, name: NameId) -> Option[Span]:
	var found = first_local_function(scope.functions, module, name).map(pure func(binding): binding.name.span)
	if found.is_none():
		for binding in scope.imports:
			if same_module(binding.module, module) and same_name(binding.name.id, name):
				found = Some(binding.name.span)
				break
	found


-- The first visible identity wins; a later exposure of that same identity is
-- not a clash. Import ordering and local precedence match direct lookup.
private pure func function_import_conflict(scope: NamespaceContents, incoming: ImportedFunctionBinding) -> Option[Span]:
	var conflict: Option[Span] = None
	match first_local_function(scope.functions, incoming.module, incoming.name.id):
		Some(local):
			if not same_function(local.function, incoming.function):
				conflict = Some(local.name.span)
		None:
			for binding in scope.imports:
				if same_module(binding.module, incoming.module) and same_name(binding.name.id, incoming.name.id):
					if not same_function(binding.function, incoming.function):
						conflict = Some(binding.name.span)
					break
	conflict


private pure func visible_variant_span(scope: NamespaceContents, module: ModuleId, name: NameId) -> Option[Span]:
	var found: Option[Span] = None
	for binding in scope.variants:
		if same_module(binding.module, module) and same_name(binding.name.id, name):
			found = Some(binding.declaration_span)
			break
	if found.is_none():
		for binding in scope.constructors:
			if same_module(binding.module, module) and same_name(binding.name.id, name):
				found = Some(binding.declaration_span)
				break
	found


-- An alias shares the module's namespace with declared and imported names
-- (GUIDE, Qualified Imports: "an alias cannot reuse a name that already means
-- something else"); the earlier of the two names is reported as previous.
private pure func alias_name_conflict(scope: NamespaceContents, row: ModuleAlias) -> Option[Span]:
	var conflict = visible_function_span(scope, row.module, row.name.id)
	if conflict.is_none():
		conflict = visible_variant_span(scope, row.module, row.name.id)
	if conflict.is_none():
		for binding in scope.types:
			if conflict.is_none() and same_module(binding.module, row.module) and same_name(binding.name.id, row.name.id):
				conflict = Some(binding.name.span)
	conflict


private pure func import_scope_problems(scope: NamespaceContents) -> List[NamespaceProblem]:
	var problems: List[NamespaceProblem] = []
	for row in scope.aliases:
		match alias_name_conflict(scope, row):
			Some(previous): problems = problems.append(ImportSelectionFailure(ModuleAliasNameConflict(row.name, previous)))
			None: void
	for binding in scope.constructors:
		match visible_function_span(scope, binding.module, binding.name.id):
			Some(previous): problems = problems.append(ImportedConstructorNameConflict(binding.name, previous))
			None: void
	for binding in scope.imports:
		match function_import_conflict(scope, binding):
			Some(previous): problems = problems.append(ImportedFunctionNameConflict(binding.name, previous))
			None: void
		match visible_variant_span(scope, binding.module, binding.name.id):
			Some(previous): problems = problems.append(ImportedVariantNameConflict(binding.name, previous))
			None: void
	problems


private pure func previous_type(types: List[TypeBinding], incoming: TypeBinding) -> Option[TypeBinding]:
	var previous: Option[TypeBinding] = None
	for binding in types:
		if same_type_name(binding, incoming):
			previous = Some(binding)
			break
	previous


-- Nominal order is the declaration authority's projection, not a new index.
-- Constructors are unique within one union; different owners may share names.
private pure func local_declaration_problems(parsed: ParsedContents, scope: NamespaceContents) -> List[NamespaceProblem]:
	var problems: List[NamespaceProblem] = []
	var types: List[TypeBinding] = []
	var records_seen = 0
	var unions_seen = 0
	while True:
		match next_nominal(parsed.declarations, records_seen, unions_seen):
			None: break
			Some(declaration):
				incoming: TypeBinding = match declaration:
					UnionDeclarationRow(row): { module = row.module, name = row.type_name, target = UnionCandidate(row.id), origin = DeclaredType(row.visibility) }
					RecordDeclarationRow(row): { module = row.declaration.module, name = row.declaration.type_name, target = RecordCandidate(row.id), origin = DeclaredType(row.declaration.visibility) }
				match previous_type(types, incoming):
					Some(previous):
						problem = match incoming.target:
							UnionCandidate(_):
								match previous.target:
									UnionCandidate(_): DuplicateUnionName(incoming.name, previous.name.span)
									RecordCandidate(_) | PrimitiveCandidate(_) | ListCandidate: DuplicateTypeName(incoming.name, previous.name.span)
							RecordCandidate(_) | PrimitiveCandidate(_) | ListCandidate: DuplicateTypeName(incoming.name, previous.name.span)
						problems = problems.append(problem)
					None: void
				types = types.append(incoming)
				match declaration:
					RecordDeclarationRow(_): records_seen = IntOps.add(records_seen, 1)
					UnionDeclarationRow(row):
						unions_seen = IntOps.add(unions_seen, 1)
						var variants: List[WrittenName] = []
						for issued in row.variants:
							variant = issued.declaration.name
							var previous: Option[Span] = None
							for written in variants:
								if same_name(written.id, variant.id):
									previous = Some(written.span)
									break
							match previous:
								Some(first): problems = problems.append(DuplicateVariantName(variant, first))
								None: void
							match first_local_function(scope.functions, row.module, variant.id):
								Some(function): problems = problems.append(VariantFunctionNameConflict(variant.id, variant.span, function.name.span))
								None: void
							variants = variants.append(variant)
	var functions: List[LocalFunctionBinding] = []
	for binding in scope.functions:
		match first_local_function(functions, binding.module, binding.name.id):
			Some(previous): problems = problems.append(DuplicateFunctionName(binding.name, previous.name.span))
			None: void
		functions = functions.append(binding)
	problems
