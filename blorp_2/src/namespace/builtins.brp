import:
	../utils/ids: UnionRow, VariantId, inventory_functions, inventory_unions
	../utils/names: FoundationWords, InitialNames, NameId, foundation_words, same_name
	int as IntOps
	option: to_result
	../parse/assemble: ParsedContents, ParsedProgram, ParsedBuiltinDeclaration, parsed_contents
	../utils/source: same_module
	../utils/syntax:
		Diagnostic,
		ParsedBuiltinType(IntegerBuiltin, FloatBuiltin, StringBuiltin, VoidBuiltin, ListBuiltin),
		ParsedRuntimeOperation(
			IntegerAddBuiltin, IntegerSubtractBuiltin, IntegerMultiplyBuiltin, IntegerDivideBuiltin,
			IntegerRemainderBuiltin, IntegerToStringBuiltin, StringLengthBuiltin, StringConcatBuiltin,
			FloatAddBuiltin, FloatSubtractBuiltin, FloatMultiplyBuiltin, FloatDivideBuiltin,
			FloatRemainderBuiltin, FloatToStringBuiltin, StringParseFloatBuiltin,
			StringPrintBuiltin, StringPrintErrorBuiltin, StringParseIntBuiltin, ListRepeatBuiltin, ListLengthBuiltin, ListGetBuiltin,
			StringByteAtBuiltin, StringFromCodepointBuiltin, GetCurrentDirectoryBuiltin, ReadFileBuiltin, WriteFileBuiltin,
			ListAppendBuiltin, ListSetBuiltin, ListConcatBuiltin, StringEqualsBuiltin, IntegerEqualsBuiltin,
		),
		Purity(Pure, Impure),
		Span,
		TypeSyntax(AtomicType),
		WrittenName,
	../utils/text as Text


-- The constructors of the foundation's designated unions. The foundation check
-- establishes them once as declaration identities (`Variant` = VariantId);
-- specialization translates them per concrete instance. Each union's identity
-- is its constructors' owner, so no second field records it.
fixed record DesignatedBoolean[Variant] {
	true_variant: Variant,
	false_variant: Variant
}


fixed record DesignatedOption[Variant] {
	some: Variant,
	none: Variant
}


fixed record DesignatedResult[Variant] {
	ok: Variant,
	err: Variant
}


fixed record DesignatedUnions {
	boolean: DesignatedBoolean[VariantId],
	option: DesignatedOption[VariantId],
	result: DesignatedResult[VariantId]
}


-- An operation whose result is a designated union carries that union's
-- constructors; the checker supplies them from the one designation.
fixed union RuntimeOperation[Variant, Element]:
	IntAdd
	IntSubtract
	IntMultiply
	IntDivide
	IntRemainder
	IntToString
	FloatAdd
	FloatSubtract
	FloatMultiply
	FloatDivide
	FloatRemainder
	FloatToString
	StringLength
	StringConcat
	StringPrint
	StringPrintError
	StringParseInt(DesignatedOption[Variant])
	StringParseFloat(DesignatedOption[Variant])
	StringByteAt(DesignatedOption[Variant])
	StringFromCodepoint(DesignatedOption[Variant])
	GetCurrentDirectory(DesignatedResult[Variant])
	ReadFile(DesignatedResult[Variant])
	WriteFile(DesignatedResult[Variant])
	ListRepeat(Element)
	ListLength(Element)
	ListGet(Element, DesignatedOption[Variant])
	ListAppend(Element)
	ListSet(Element)
	ListConcat(Element)
	StringEquals(DesignatedBoolean[Variant])
	IntEquals(DesignatedBoolean[Variant])


fixed union PrimitiveType:
	BuiltinInt
	BuiltinFloat
	BuiltinString
	BuiltinVoid


fixed union RuntimeType[Element]:
	PrimitiveRuntimeType(PrimitiveType)
	ElementRuntimeType(Element)
	ListRuntimeType(Element)


-- Union results retain their designated constructors and exact payload types.
fixed union RuntimeResult[Variant, Element]:
	ValueResult(RuntimeType[Element])
	OptionalResult(RuntimeType[Element], DesignatedOption[Variant])
	ResultResult(RuntimeType[Element], RuntimeType[Element], DesignatedResult[Variant])
	BooleanResult(DesignatedBoolean[Variant])


fixed record RuntimeContract[Variant, Element] {
	purity: Purity,
	parameters: List[RuntimeType[Element]],
	return_type: RuntimeResult[Variant, Element]
}


-- The sole authority for runtime signatures. Element and designated
-- constructor identities are accepted before constructing an operation; no
-- phase supplies a missing E.
pure func runtime_contract[Variant, Element](
	operation: RuntimeOperation[Variant, Element],
) -> RuntimeContract[Variant, Element]:
	match operation:
		IntAdd | IntSubtract | IntMultiply | IntDivide | IntRemainder:
			{ purity = Pure, parameters = [PrimitiveRuntimeType(BuiltinInt), PrimitiveRuntimeType(BuiltinInt)], return_type = ValueResult(PrimitiveRuntimeType(BuiltinInt)) }
		FloatAdd | FloatSubtract | FloatMultiply | FloatDivide | FloatRemainder:
			{ purity = Pure, parameters = [PrimitiveRuntimeType(BuiltinFloat), PrimitiveRuntimeType(BuiltinFloat)], return_type = ValueResult(PrimitiveRuntimeType(BuiltinFloat)) }
		FloatToString:
			{ purity = Pure, parameters = [PrimitiveRuntimeType(BuiltinFloat)], return_type = ValueResult(PrimitiveRuntimeType(BuiltinString)) }
		IntToString:
			{ purity = Pure, parameters = [PrimitiveRuntimeType(BuiltinInt)], return_type = ValueResult(PrimitiveRuntimeType(BuiltinString)) }
		StringLength:
			{ purity = Pure, parameters = [PrimitiveRuntimeType(BuiltinString)], return_type = ValueResult(PrimitiveRuntimeType(BuiltinInt)) }
		StringConcat:
			{ purity = Pure, parameters = [PrimitiveRuntimeType(BuiltinString), PrimitiveRuntimeType(BuiltinString)], return_type = ValueResult(PrimitiveRuntimeType(BuiltinString)) }
		StringPrint | StringPrintError:
			{ purity = Impure, parameters = [PrimitiveRuntimeType(BuiltinString)], return_type = ValueResult(PrimitiveRuntimeType(BuiltinVoid)) }
		StringParseInt(option):
			{ purity = Pure, parameters = [PrimitiveRuntimeType(BuiltinString)], return_type = OptionalResult(PrimitiveRuntimeType(BuiltinInt), option) }
		StringParseFloat(option):
			{ purity = Pure, parameters = [PrimitiveRuntimeType(BuiltinString)], return_type = OptionalResult(PrimitiveRuntimeType(BuiltinFloat), option) }
		StringByteAt(option):
			{ purity = Pure, parameters = [PrimitiveRuntimeType(BuiltinString), PrimitiveRuntimeType(BuiltinInt)], return_type = OptionalResult(PrimitiveRuntimeType(BuiltinInt), option) }
		StringFromCodepoint(option):
			{ purity = Pure, parameters = [PrimitiveRuntimeType(BuiltinInt)], return_type = OptionalResult(PrimitiveRuntimeType(BuiltinString), option) }
		ReadFile(result):
			{ purity = Impure, parameters = [PrimitiveRuntimeType(BuiltinString)], return_type = ResultResult(PrimitiveRuntimeType(BuiltinString), PrimitiveRuntimeType(BuiltinString), result) }
		WriteFile(result):
			{ purity = Impure, parameters = [PrimitiveRuntimeType(BuiltinString), PrimitiveRuntimeType(BuiltinString)], return_type = ResultResult(PrimitiveRuntimeType(BuiltinVoid), PrimitiveRuntimeType(BuiltinString), result) }
		GetCurrentDirectory(result):
			{ purity = Impure, parameters = [], return_type = ResultResult(PrimitiveRuntimeType(BuiltinString), PrimitiveRuntimeType(BuiltinString), result) }
		ListRepeat(element):
			{ purity = Pure, parameters = [ElementRuntimeType(element), PrimitiveRuntimeType(BuiltinInt)], return_type = ValueResult(ListRuntimeType(element)) }
		ListLength(element):
			{ purity = Pure, parameters = [ListRuntimeType(element)], return_type = ValueResult(PrimitiveRuntimeType(BuiltinInt)) }
		ListGet(element, option):
			{ purity = Pure, parameters = [ListRuntimeType(element), PrimitiveRuntimeType(BuiltinInt)], return_type = OptionalResult(ElementRuntimeType(element), option) }
		ListAppend(element):
			{ purity = Pure, parameters = [ListRuntimeType(element), ElementRuntimeType(element)], return_type = ValueResult(ListRuntimeType(element)) }
		ListSet(element):
			{ purity = Pure, parameters = [ListRuntimeType(element), PrimitiveRuntimeType(BuiltinInt), ElementRuntimeType(element)], return_type = ValueResult(ListRuntimeType(element)) }
		ListConcat(element):
			{ purity = Pure, parameters = [ListRuntimeType(element), ListRuntimeType(element)], return_type = ValueResult(ListRuntimeType(element)) }
		StringEquals(boolean):
			{ purity = Pure, parameters = [PrimitiveRuntimeType(BuiltinString), PrimitiveRuntimeType(BuiltinString)], return_type = BooleanResult(boolean) }
		IntEquals(boolean):
			{ purity = Pure, parameters = [PrimitiveRuntimeType(BuiltinInt), PrimitiveRuntimeType(BuiltinInt)], return_type = BooleanResult(boolean) }


pure func primitive_operation[Variant, Element](parsed: ParsedRuntimeOperation) -> Option[RuntimeOperation[Variant, Element]]:
	match parsed:
		IntegerAddBuiltin: Some(IntAdd)
		IntegerSubtractBuiltin: Some(IntSubtract)
		IntegerMultiplyBuiltin: Some(IntMultiply)
		IntegerDivideBuiltin: Some(IntDivide)
		IntegerRemainderBuiltin: Some(IntRemainder)
		FloatAddBuiltin: Some(FloatAdd)
		FloatSubtractBuiltin: Some(FloatSubtract)
		FloatMultiplyBuiltin: Some(FloatMultiply)
		FloatDivideBuiltin: Some(FloatDivide)
		FloatRemainderBuiltin: Some(FloatRemainder)
		FloatToStringBuiltin: Some(FloatToString)
		IntegerToStringBuiltin: Some(IntToString)
		StringLengthBuiltin: Some(StringLength)
		StringConcatBuiltin: Some(StringConcat)
		StringPrintBuiltin: Some(StringPrint)
		StringPrintErrorBuiltin: Some(StringPrintError)
		ListRepeatBuiltin | ListLengthBuiltin | ListAppendBuiltin | ListSetBuiltin | ListConcatBuiltin | StringParseIntBuiltin | StringParseFloatBuiltin | StringByteAtBuiltin | StringFromCodepointBuiltin | GetCurrentDirectoryBuiltin | ReadFileBuiltin | WriteFileBuiltin | ListGetBuiltin | StringEqualsBuiltin | IntegerEqualsBuiltin: None


pure func runtime_declaration_help(operation: ParsedRuntimeOperation) -> String:
	match operation:
		StringPrintBuiltin | StringPrintErrorBuiltin: "declare an impure function with one String parameter returning Void"
		IntegerAddBuiltin | IntegerSubtractBuiltin | IntegerMultiplyBuiltin | IntegerDivideBuiltin | IntegerRemainderBuiltin: "declare a pure function with two Int parameters returning Int"
		FloatAddBuiltin | FloatSubtractBuiltin | FloatMultiplyBuiltin | FloatDivideBuiltin | FloatRemainderBuiltin: "declare a pure function with two Float parameters returning Float"
		FloatToStringBuiltin: "declare a pure function with one Float parameter returning String"
		IntegerToStringBuiltin: "declare a pure function with one Int parameter returning String"
		StringLengthBuiltin: "declare a pure function with one String parameter returning Int"
		StringConcatBuiltin: "declare a pure nongeneric function with two String parameters returning String"
		StringParseIntBuiltin: "declare a pure nongeneric function with one String parameter returning Option[Int]"
		StringParseFloatBuiltin: "declare a pure nongeneric function with one String parameter returning Option[Float]"
		StringByteAtBuiltin: "declare a pure nongeneric function with String and Int parameters returning Option[Int]"
		StringFromCodepointBuiltin: "declare a pure nongeneric function with one Int parameter returning Option[String]"
		ReadFileBuiltin: "declare an impure nongeneric function with one String parameter returning Result[String, String]"
		WriteFileBuiltin: "declare an impure nongeneric function with two String parameters returning Result[Void, String]"
		GetCurrentDirectoryBuiltin: "declare an impure nongeneric function with no parameters returning Result[String, String]"
		ListRepeatBuiltin: "declare a pure function with E and Int parameters returning List[E]"
		ListLengthBuiltin: "declare a pure function with one List[E] parameter returning Int"
		ListGetBuiltin: "declare a pure function with List[E] and Int parameters returning Option[E]"
		ListAppendBuiltin: "declare a pure function with List[E] and E parameters returning List[E]"
		ListSetBuiltin: "declare a pure function with List[E], Int and E parameters returning List[E]"
		ListConcatBuiltin: "declare a pure function with two List[E] parameters returning List[E]"
		IntegerEqualsBuiltin: "declare a pure nongeneric function with two Int parameters returning Bool"
		StringEqualsBuiltin: "declare a pure nongeneric function with two String parameters returning Bool"


fixed union BuiltinTypeRole:
	IntegerType
	FloatType
	StringType
	VoidType
	ListType


fixed union DesignatedUnionRole:
	BoolUnion
	OptionUnion
	ResultUnion


fixed union BuiltinTypeErrorKind:
	DuplicateBuiltinType(BuiltinTypeRole)
	MissingBuiltinType(BuiltinTypeRole)
	MissingDesignatedUnion(DesignatedUnionRole)
	MalformedDesignatedUnion(DesignatedUnionRole)
	BuiltinOutsideFoundation
	FoundationImports
	FoundationFunctions


fixed record BuiltinTypeError {
	span: Span,
	kind: BuiltinTypeErrorKind
}


private pure func builtin_type_error(span: Span, kind: BuiltinTypeErrorKind) -> BuiltinTypeError:
	{ span = span, kind = kind }


pure func builtin_type_name(declaration: ParsedBuiltinType) -> WrittenName:
	match declaration:
		IntegerBuiltin(name): name
		FloatBuiltin(name): name
		StringBuiltin(name): name
		VoidBuiltin(name): name
		ListBuiltin(name): name


private pure func builtin_type_role(declaration: ParsedBuiltinType) -> BuiltinTypeRole:
	match declaration:
		IntegerBuiltin(_): IntegerType
		FloatBuiltin(_): FloatType
		StringBuiltin(_): StringType
		VoidBuiltin(_): VoidType
		ListBuiltin(_): ListType


private pure func reject_at(found: Option[Span], kind: BuiltinTypeErrorKind) -> Result[Void, BuiltinTypeError]:
	match found:
		Some(span): Err(builtin_type_error(span, kind))
		None: Ok(void)


-- The foundation types module only declares types.
private pure func check_foundation_shape(parsed: ParsedContents) -> Result[Void, BuiltinTypeError]:
	var function_span: Option[Span] = None
	for row in inventory_functions(parsed.declarations):
		function = row.declaration
		if function_span.is_none() and same_module(function.module, parsed.foundation.types):
			function_span = Some(function.function_name.span)
	functionless ?= reject_at(function_span, FoundationFunctions)
	var import_span: Option[Span] = None
	for row in parsed.modules:
		if same_module(row.module, parsed.foundation.types):
			match row.imports.get(0):
				Some(request): import_span = Some(request.span)
				None: void
	reject_at(import_span, FoundationImports)


private pure func same_role(left: BuiltinTypeRole, right: BuiltinTypeRole) -> Bool:
	match left:
		IntegerType:
			match right:
				IntegerType: True
				_: False
		FloatType:
			match right:
				FloatType: True
				_: False
		StringType:
			match right:
				StringType: True
				_: False
		VoidType:
			match right:
				VoidType: True
				_: False
		ListType:
			match right:
				ListType: True
				_: False


-- Each builtin declaration must be in the foundation module and the first of its role.
private pure func accept_builtins(parsed: ParsedContents, accepted: List[ParsedBuiltinDeclaration]) -> Result[List[ParsedBuiltinDeclaration], BuiltinTypeError]:
	match parsed.builtin_types.get(accepted.length()):
		None:
			Ok(accepted)
		Some(row):
			role = builtin_type_role(row.declaration)
			span = builtin_type_name(row.declaration).span
			var repeated = False
			for earlier in accepted:
				repeated = repeated or same_role(builtin_type_role(earlier.declaration), role)
			if not same_module(row.module, parsed.foundation.types):
				Err(builtin_type_error(span, BuiltinOutsideFoundation))
			else if repeated:
				Err(builtin_type_error(span, DuplicateBuiltinType(role)))
			else:
				accept_builtins(parsed, accepted.append(row))


-- Accepted declarations name each role at most once; a missing one ends the foundation module.
private pure func builtin_head(accepted: List[ParsedBuiltinDeclaration], role: BuiltinTypeRole, end: Span) -> Result[NameId, BuiltinTypeError]:
	var head: Option[NameId] = None
	for row in accepted:
		if same_role(builtin_type_role(row.declaration), role):
			head = Some(builtin_type_name(row.declaration).id)
	head.to_result(builtin_type_error(end, MissingBuiltinType(role)))


-- One constructor of a designated union: its wired-in name, and the position of
-- the union's type parameter it carries, or None when it has no payload.
private fixed record ConstructorShape {
	name: NameId,
	payload: Option[Int]
}


private fixed record UnionShape {
	name: NameId,
	parameters: Int,
	first: ConstructorShape,
	second: ConstructorShape
}


private pure func designated_shape(role: DesignatedUnionRole, words: FoundationWords) -> UnionShape:
	match role:
		BoolUnion:
			{ name = words.bool_word, parameters = 0, first = { name = words.true_word, payload = None }, second = { name = words.false_word, payload = None } }
		OptionUnion:
			{ name = words.option_word, parameters = 1, first = { name = words.some_word, payload = Some(0) }, second = { name = words.none_word, payload = None } }
		ResultUnion:
			{ name = words.result_word, parameters = 2, first = { name = words.ok_word, payload = Some(0) }, second = { name = words.err_word, payload = Some(1) } }


-- A payload matches when it is exactly the union's own parameter at that position.
-- Comparing the written name is sound: _base imports nothing, so no imported
-- type can share the parameter's name, and declaration checking rejects a
-- parameter named like any visible type, so a match always denotes the parameter.
private pure func carries(row: UnionRow, fields: List[TypeSyntax], payload: Option[Int]) -> Bool:
	match payload:
		None:
			fields.is_empty()
		Some(position):
			match fields:
				[AtomicType(written)]:
					match row.type_parameters.get(position):
						Some(parameter): same_name(written.id, parameter.id)
						None: False
				_:
					False


private pure func shaped_variant(row: UnionRow, shape: ConstructorShape) -> Option[VariantId]:
	var found: Option[VariantId] = None
	for variant in row.variants:
		if same_name(variant.declaration.name.id, shape.name) and carries(row, variant.declaration.fields, shape.payload):
			found = Some(variant.id)
			break
	found


-- The designated union's two constructors, in its shape's order. The union's
-- variant order is its own: layout follows declaration order as for any union.
private fixed record DesignatedPair {
	first: VariantId,
	second: VariantId
}


private pure func designated_pair(parsed: ParsedContents, role: DesignatedUnionRole, end: Span) -> Result[DesignatedPair, BuiltinTypeError]:
	shape = designated_shape(role, foundation_words(parsed.names))
	var declaration: Option[UnionRow] = None
	for row in inventory_unions(parsed.declarations):
		if declaration.is_none() and same_module(row.module, parsed.foundation.types) and same_name(row.type_name.id, shape.name):
			declaration = Some(row)
	match declaration:
		None:
			Err(builtin_type_error(end, MissingDesignatedUnion(role)))
		Some(row):
			wrong = builtin_type_error(row.type_name.span, MalformedDesignatedUnion(role))
			match shaped_variant(row, shape.first).to_result(wrong):
				Ok(first):
					match shaped_variant(row, shape.second).to_result(wrong):
						Ok(second):
							if IntOps.equals(row.type_parameters.length(), shape.parameters) and IntOps.equals(row.variants.length(), 2):
								Ok({ first = first, second = second })
							else:
								Err(wrong)
						Err(error): Err(error)
				Err(error): Err(error)


-- Bool, Option and Result are ordinary unions; designating them is an identity
-- fact only, decided here once from the foundation module by wired-in name.
-- A same-named union elsewhere is an ordinary declaration.
private pure func designate_unions(parsed: ParsedContents, end: Span) -> Result[DesignatedUnions, BuiltinTypeError]:
	boolean ?= designated_pair(parsed, BoolUnion, end)
	option ?= designated_pair(parsed, OptionUnion, end)
	result ?= designated_pair(parsed, ResultUnion, end)
	Ok({
		boolean = { true_variant = boolean.first, false_variant = boolean.second },
		option = { some = option.first, none = option.second },
		result = { ok = result.first, err = result.second }
	})


-- The accepted foundation, published once for this compilation: the primitive
-- heads' names and the designated unions. Its ids are this compilation's.
fixed record CheckedFoundation {
	initial: InitialNames,
	designated: DesignatedUnions
}


-- Primitive names are checked once from the sealed designated source inventory.
-- Ordinary unions remain nominal declarations owned by the normal namespace.
-- There is no invalid-name error: the parser assigns each builtin's role from its
-- spelling and append_module rejects a foreign name table, so every name id here
-- has a spelling and the five role names and the entrypoint are distinct.
pure func check_builtin_types(program: ParsedProgram) -> Result[CheckedFoundation, BuiltinTypeError]:
	parsed = parsed_contents(program)
	-- A missing builtin declaration is reported at the end of the foundation types module.
	var end = parsed.end
	for row in parsed.modules:
		if same_module(row.module, parsed.foundation.types):
			end = row.end
	shaped ?= check_foundation_shape(parsed)
	accepted ?= accept_builtins(parsed, [])
	integer_id ?= builtin_head(accepted, IntegerType, end)
	string_id ?= builtin_head(accepted, StringType, end)
	unit_id ?= builtin_head(accepted, VoidType, end)
	float_id ?= builtin_head(accepted, FloatType, end)
	list_id ?= builtin_head(accepted, ListType, end)
	designated ?= designate_unions(parsed, end)
	initial: InitialNames = { names = parsed.names, special = {
		main = parsed.entrypoint, integer = integer_id, float = float_id, string = string_id,
		unit = unit_id, list = list_id,
	} }
	Ok({ initial = initial, designated = designated })


private pure func builtin_type_spelling(role: BuiltinTypeRole) -> String:
	match role:
		IntegerType: "Int"
		FloatType: "Float"
		StringType: "String"
		VoidType: "Void"
		ListType: "List"


private pure func builtin_type_declaration(role: BuiltinTypeRole) -> String:
	match role:
		ListType: "type List[T] = builtin"
		_: Text.concat("type ", builtin_type_spelling(role)).concat(" = builtin")


private pure func designated_union_spelling(role: DesignatedUnionRole) -> String:
	match role:
		BoolUnion: "Bool"
		OptionUnion: "Option"
		ResultUnion: "Result"


private pure func designated_union_declaration(role: DesignatedUnionRole) -> String:
	match role:
		BoolUnion: "fixed union Bool with exactly the variants True and False"
		OptionUnion: "fixed union Option[A] with exactly the variants Some(A) and None"
		ResultUnion: "fixed union Result[Value, Error] with exactly the variants Ok(Value) and Err(Error)"


pure func render_builtin_type_error(error: BuiltinTypeError) -> Diagnostic:
	message = match error.kind:
		DuplicateBuiltinType(_): "duplicate builtin type declaration"
		MissingBuiltinType(role): Text.concat("missing ", builtin_type_spelling(role)).concat(" builtin declaration")
		MissingDesignatedUnion(role): Text.concat("missing ", designated_union_spelling(role)).concat(" union declaration")
		MalformedDesignatedUnion(role): Text.concat("foundation union ", designated_union_spelling(role)).concat(" does not have its designated shape")
		BuiltinOutsideFoundation: "builtin type declarations belong in the configured foundation module"
		FoundationImports: "foundation types cannot import modules"
		FoundationFunctions: "foundation types cannot declare functions"
	help = match error.kind:
		DuplicateBuiltinType(role): Text.concat("declare ", builtin_type_declaration(role)).concat(" exactly once")
		MissingBuiltinType(role): Text.concat("add ", builtin_type_declaration(role)).concat(" to _base.brp")
		MissingDesignatedUnion(role): Text.concat("add ", designated_union_declaration(role)).concat(" to _base.brp")
		MalformedDesignatedUnion(role): Text.concat("declare it as ", designated_union_declaration(role))
		BuiltinOutsideFoundation: "remove this declaration; builtin types are supplied by _base.brp under --library-root"
		FoundationImports: "keep _base.brp independent; put operation imports in prelude.brp"
		FoundationFunctions: "move functions to a library operation module and select its methods in prelude.brp"
	{ span = error.span, note = None, message = message, help = help }
