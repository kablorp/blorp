-- Concrete immutable List[String] storage. The root owns every child once;
-- lookups borrow the root and return one independently retained String owner.
pure func list_runtime() -> String:
	raw
		|struct blorp_string_list {
		|atomic_size_t references;
		|int64_t length;
		|struct blorp_string *values[];
		|};
		|struct blorp_string_list *blorp_string_list_from_argv(int argc,char **argv){
		|if(argc<0){abort();}
		|const size_t count=(size_t)argc;
		|if(count>(SIZE_MAX-sizeof(struct blorp_string_list))/sizeof(struct blorp_string *)){abort();}
		|struct blorp_string_list *result=malloc(sizeof *result+count*sizeof *result->values);
		|if(result==NULL){abort();}
		|atomic_init(&result->references,1);result->length=(int64_t)argc;
		|for(size_t index=0;index<count;index++){
		|const size_t length=strlen(argv[index]);
		|if(length>(size_t)INT64_MAX||length>SIZE_MAX-sizeof(struct blorp_string)-1){abort();}
		|result->values[index]=blorp_string_from_bytes(argv[index],(int64_t)length);
		|}
		|return result;
		|}
		|void blorp_string_list_retain(struct blorp_string_list *value){
		|atomic_fetch_add_explicit(&value->references,1,memory_order_relaxed);
		|}
		|void blorp_string_list_release(struct blorp_string_list *value){
		|if(atomic_fetch_sub_explicit(&value->references,1,memory_order_acq_rel)==1){
		|for(int64_t index=0;index<value->length;index++){blorp_string_release(value->values[index]);}
		|free(value);
		|}
		|}
		|int64_t blorp_string_list_length(const struct blorp_string_list *value){return value->length;}
		|struct blorp_string *blorp_string_list_get(const struct blorp_string_list *value,int64_t index){
		|if(index<0||index>=value->length){return NULL;}
		|struct blorp_string *result=value->values[index];blorp_string_retain(result);return result;
		|}
		|
