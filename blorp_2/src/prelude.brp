import:
	names: InitialNames, NameId, NameTable, SpecialNames, name_spelling, same_name
	option: is_some, to_result
	parse: ParsedProgram, ParsedBuiltinDeclaration, parsed_contents
	source: same_module
	syntax:
		Diagnostic,
		ParsedBuiltinType(IntegerBuiltin, FloatBuiltin, StringBuiltin, VoidBuiltin, ListBuiltin),
		ParsedRuntimeOperation(
			IntegerAddBuiltin, IntegerSubtractBuiltin, IntegerMultiplyBuiltin, IntegerDivideBuiltin,
			IntegerRemainderBuiltin, IntegerToStringBuiltin, StringLengthBuiltin,
			FloatAddBuiltin, FloatSubtractBuiltin, FloatMultiplyBuiltin, FloatDivideBuiltin,
			FloatRemainderBuiltin, FloatToStringBuiltin, StringParseFloatBuiltin,
			StringPrintBuiltin, StringParseIntBuiltin, ListLengthBuiltin, ListGetBuiltin, StringEqualsBuiltin, IntegerEqualsBuiltin,
		),
		Purity(Pure, Impure),
		Span,
		WrittenName,
	text as Text


fixed record OptionalRoles[Variant] {
	present: Variant,
	absent: Variant
}


fixed record BooleanRoles[Variant] {
	equal: Variant,
	different: Variant
}


fixed union RuntimeOperation[Variant]:
	IntAdd
	IntSubtract
	IntMultiply
	IntDivide
	IntRemainder
	IntToString
	FloatAdd
	FloatSubtract
	FloatMultiply
	FloatDivide
	FloatRemainder
	FloatToString
	StringLength
	StringPrint
	StringParseInt(OptionalRoles[Variant])
	StringParseFloat(OptionalRoles[Variant])
	ListLength
	ListGet(OptionalRoles[Variant])
	StringEquals(BooleanRoles[Variant])
	IntEquals(BooleanRoles[Variant])


fixed union PrimitiveType:
	BuiltinInt
	BuiltinFloat
	BuiltinString
	BuiltinVoid


fixed union RuntimeResult[Variant]:
	PrimitiveResult(PrimitiveType)
	OptionalResult(PrimitiveType, OptionalRoles[Variant])
	BooleanResult(BooleanRoles[Variant])


-- These closed operations need one concrete container parameter, not generic
-- runtime functions or arbitrary element descriptors.
fixed union RuntimeParameter:
	PrimitiveParameter(PrimitiveType)
	StringListParameter


fixed record RuntimeContract[Variant] {
	purity: Purity,
	parameters: List[RuntimeParameter],
	return_type: RuntimeResult[Variant]
}


-- One closed contract authority, shared across declaration and instance roles.
pure func runtime_contract[Variant](
	operation: RuntimeOperation[Variant],
) -> RuntimeContract[Variant]:
	match operation:
		StringPrint:
			{
				purity = Impure,
				parameters = [PrimitiveParameter(BuiltinString)],
				return_type = PrimitiveResult(BuiltinVoid)
			}
		IntAdd | IntSubtract | IntMultiply | IntDivide | IntRemainder:
			{
				purity = Pure,
				parameters = [PrimitiveParameter(BuiltinInt), PrimitiveParameter(BuiltinInt)],
				return_type = PrimitiveResult(BuiltinInt)
			}
		FloatAdd | FloatSubtract | FloatMultiply | FloatDivide | FloatRemainder:
			{ purity = Pure, parameters = [PrimitiveParameter(BuiltinFloat), PrimitiveParameter(BuiltinFloat)], return_type = PrimitiveResult(BuiltinFloat) }
		FloatToString:
			{ purity = Pure, parameters = [PrimitiveParameter(BuiltinFloat)], return_type = PrimitiveResult(BuiltinString) }
		IntToString:
			{
				purity = Pure,
				parameters = [PrimitiveParameter(BuiltinInt)],
				return_type = PrimitiveResult(BuiltinString)
			}
		StringLength:
			{
				purity = Pure,
				parameters = [PrimitiveParameter(BuiltinString)],
				return_type = PrimitiveResult(BuiltinInt)
			}
		StringParseInt(roles):
			{
				purity = Pure,
				parameters = [PrimitiveParameter(BuiltinString)],
				return_type = OptionalResult(BuiltinInt, roles)
			}
		StringParseFloat(roles):
			{ purity = Pure, parameters = [PrimitiveParameter(BuiltinString)], return_type = OptionalResult(BuiltinFloat, roles) }
		ListLength:
			{ purity = Pure, parameters = [StringListParameter], return_type = PrimitiveResult(BuiltinInt) }
		ListGet(roles):
			{
				purity = Pure,
				parameters = [StringListParameter, PrimitiveParameter(BuiltinInt)],
				return_type = OptionalResult(BuiltinString, roles)
			}
		IntEquals(roles):
			{
				purity = Pure,
				parameters = [PrimitiveParameter(BuiltinInt), PrimitiveParameter(BuiltinInt)],
				return_type = BooleanResult(roles)
			}
		StringEquals(roles):
			{
				purity = Pure,
				parameters = [PrimitiveParameter(BuiltinString), PrimitiveParameter(BuiltinString)],
				return_type = BooleanResult(roles)
			}


pure func builtin_operation(parsed: ParsedRuntimeOperation) -> RuntimeOperation[WrittenName]:
	match parsed:
		IntegerAddBuiltin:
			IntAdd
		IntegerSubtractBuiltin:
			IntSubtract
		IntegerMultiplyBuiltin:
			IntMultiply
		IntegerDivideBuiltin:
			IntDivide
		IntegerRemainderBuiltin:
			IntRemainder
		FloatAddBuiltin:
			FloatAdd
		FloatSubtractBuiltin:
			FloatSubtract
		FloatMultiplyBuiltin:
			FloatMultiply
		FloatDivideBuiltin:
			FloatDivide
		FloatRemainderBuiltin:
			FloatRemainder
		FloatToStringBuiltin:
			FloatToString
		IntegerToStringBuiltin:
			IntToString
		StringLengthBuiltin:
			StringLength
		StringPrintBuiltin:
			StringPrint
		StringParseIntBuiltin(present, absent):
			StringParseInt({
				present = present,
				absent = absent,
			})
		StringParseFloatBuiltin(present, absent):
			StringParseFloat({ present = present, absent = absent })
		ListGetBuiltin(present, absent):
			ListGet({
				present = present,
				absent = absent,
			})
		ListLengthBuiltin:
			ListLength
		StringEqualsBuiltin(equal, different):
			StringEquals({
				equal = equal,
				different = different,
			})
		IntegerEqualsBuiltin(equal, different):
			IntEquals({ equal = equal, different = different })


-- Generic callers of this helper admit only operations without constructor roles.
pure func primitive_operation[Variant](
	parsed: ParsedRuntimeOperation,
) -> Option[RuntimeOperation[Variant]]:
	match parsed:
		IntegerAddBuiltin:
			Some(IntAdd)
		IntegerSubtractBuiltin:
			Some(IntSubtract)
		IntegerMultiplyBuiltin:
			Some(IntMultiply)
		IntegerDivideBuiltin:
			Some(IntDivide)
		IntegerRemainderBuiltin:
			Some(IntRemainder)
		FloatAddBuiltin:
			Some(FloatAdd)
		FloatSubtractBuiltin:
			Some(FloatSubtract)
		FloatMultiplyBuiltin:
			Some(FloatMultiply)
		FloatDivideBuiltin:
			Some(FloatDivide)
		FloatRemainderBuiltin:
			Some(FloatRemainder)
		FloatToStringBuiltin:
			Some(FloatToString)
		IntegerToStringBuiltin:
			Some(IntToString)
		StringLengthBuiltin:
			Some(StringLength)
		StringPrintBuiltin:
			Some(StringPrint)
		ListLengthBuiltin:
			Some(ListLength)
		StringParseIntBuiltin(_, _) | StringParseFloatBuiltin(_, _) | ListGetBuiltin(_, _) | StringEqualsBuiltin(_, _) | IntegerEqualsBuiltin(_, _):
			None


pure func runtime_declaration_help[Variant](operation: RuntimeOperation[Variant]) -> String:
	match operation:
		StringPrint:
			"declare an impure function with one String parameter returning Void"
		IntAdd | IntSubtract | IntMultiply | IntDivide | IntRemainder:
			"declare a pure function with two Int parameters returning Int"
		FloatAdd | FloatSubtract | FloatMultiply | FloatDivide | FloatRemainder:
			"declare a pure function with two Float parameters returning Float"
		FloatToString:
			"declare a pure function with one Float parameter returning String"
		IntToString:
			"declare a pure function with one Int parameter returning String"
		StringLength:
			"declare a pure function with one String parameter returning Int"
		StringParseInt(_):
			(
				"declare a pure nongeneric function with one String parameter returning a two-"
				+ "variant union of Int and an empty case"
			)
		StringParseFloat(_):
			"declare a pure nongeneric function with one String parameter returning a two-variant union of Float and an empty case"
		ListGet(_):
			"declare a pure nongeneric function with List[String] and Int parameters returning a two-variant union of String and an empty case"
		ListLength:
			"declare a pure function with one List[String] parameter returning Int"
		IntEquals(_):
			"declare a pure nongeneric function with two Int parameters returning a union of two empty variants"
		StringEquals(_):
			(
				"declare a pure nongeneric function with two String parameters returning a union "
				+ "of two empty variants"
			)


fixed union BuiltinTypeRole:
	IntegerType
	FloatType
	StringType
	VoidType
	ListType


fixed union BuiltinTypeErrorKind:
	InvalidBuiltinName
	InvalidEntrypointName
	DuplicateBuiltinType(BuiltinTypeRole)
	MissingBuiltinType(BuiltinTypeRole)
	ConflictingBuiltinIdentities
	BuiltinOutsideFoundation
	FoundationImports
	FoundationFunctions
	FoundationTypeConflict(BuiltinTypeRole)


fixed record BuiltinTypeError {
	span: Span,
	kind: BuiltinTypeErrorKind
}


private pure func builtin_type_error(span: Span, kind: BuiltinTypeErrorKind) -> BuiltinTypeError:
	{ span = span, kind = kind }


pure func builtin_type_name(declaration: ParsedBuiltinType) -> WrittenName:
	match declaration:
		IntegerBuiltin(name): name
		FloatBuiltin(name): name
		StringBuiltin(name): name
		VoidBuiltin(name): name
		ListBuiltin(name): name


private pure func builtin_type_role(declaration: ParsedBuiltinType) -> BuiltinTypeRole:
	match declaration:
		IntegerBuiltin(_): IntegerType
		FloatBuiltin(_): FloatType
		StringBuiltin(_): StringType
		VoidBuiltin(_): VoidType
		ListBuiltin(_): ListType


private pure func foundation_type_conflict(
	name: WrittenName,
	builtins: List[ParsedBuiltinDeclaration],
) -> Option[BuiltinTypeError]:
	var conflict: Option[BuiltinTypeError] = None
	for row in builtins:
		if same_name(name.id, builtin_type_name(row.declaration).id):
			conflict = Some(builtin_type_error(name.span, FoundationTypeConflict(builtin_type_role(row.declaration))))
			break
	conflict


-- Primitive names are checked once from the sealed designated source inventory.
-- Ordinary unions remain nominal declarations owned by the normal namespace.
pure func check_builtin_types(program: ParsedProgram) -> Result[InitialNames, BuiltinTypeError]:
	parsed = parsed_contents(program)
	base = parsed.foundation.types
	var end = parsed.end
	var failure: Option[BuiltinTypeError] = None
	for row in parsed.modules:
		if same_module(row.module, base):
			end = row.end
			match row.imports.get(0):
				Some(request): failure = Some(builtin_type_error(request.span, FoundationImports))
				None: void
	for function in parsed.functions:
		if same_module(function.module, base):
			failure = Some(builtin_type_error(function.function_name.span, FoundationFunctions))
			break
	if not name_spelling(parsed.names, parsed.entrypoint).is_some():
		failure = Some(builtin_type_error(parsed.end, InvalidEntrypointName))
	var integer: Option[NameId] = None
	var float: Option[NameId] = None
	var string: Option[NameId] = None
	var unit: Option[NameId] = None
	var list: Option[NameId] = None
	for row in parsed.builtin_types:
		if failure.is_some():
			break
		name = builtin_type_name(row.declaration)
		if not same_module(row.module, base):
			failure = Some(builtin_type_error(name.span, BuiltinOutsideFoundation))
			break
		if not name_spelling(parsed.names, name.id).is_some():
			failure = Some(builtin_type_error(name.span, InvalidBuiltinName))
			break
		previous = match row.declaration:
			IntegerBuiltin(_): integer
			FloatBuiltin(_): float
			StringBuiltin(_): string
			VoidBuiltin(_): unit
			ListBuiltin(_): list
		if previous.is_some():
			failure = Some(builtin_type_error(name.span, DuplicateBuiltinType(builtin_type_role(row.declaration))))
			break
		match row.declaration:
			IntegerBuiltin(_): integer = Some(name.id)
			FloatBuiltin(_): float = Some(name.id)
			StringBuiltin(_): string = Some(name.id)
			VoidBuiltin(_): unit = Some(name.id)
			ListBuiltin(_): list = Some(name.id)
	valid ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	integer_id ?= integer.to_result(builtin_type_error(end, MissingBuiltinType(IntegerType)))
	string_id ?= string.to_result(builtin_type_error(end, MissingBuiltinType(StringType)))
	unit_id ?= unit.to_result(builtin_type_error(end, MissingBuiltinType(VoidType)))
	float_id ?= float.to_result(builtin_type_error(end, MissingBuiltinType(FloatType)))
	list_id ?= list.to_result(builtin_type_error(end, MissingBuiltinType(ListType)))
	var known: List[NameId] = [parsed.entrypoint]
	var conflict = False
	for id in [integer_id, float_id, string_id, unit_id, list_id]:
		for previous in known:
			conflict = conflict or same_name(previous, id)
		known = known.append(id)
	-- Base declarations share the same type namespace as these primitive heads.
	-- Other modules see the base through their implicit namespace; the base
	-- itself needs this check before its own declarations are published.
	for declaration in parsed.unions:
		if same_module(declaration.module, base):
			failure = foundation_type_conflict(declaration.type_name, parsed.builtin_types)
			if failure.is_some():
				break
	for declaration in parsed.records:
		if failure.is_some():
			break
		if same_module(declaration.module, base):
			failure = foundation_type_conflict(declaration.type_name, parsed.builtin_types)
	valid_nominals ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	if conflict:
		Err(builtin_type_error(end, ConflictingBuiltinIdentities))
	else:
		Ok({ names = parsed.names, special = {
			main = parsed.entrypoint, integer = integer_id, float = float_id, string = string_id,
			unit = unit_id, list = list_id,
		} })


private pure func builtin_type_spelling(role: BuiltinTypeRole) -> String:
	match role:
		IntegerType: "Int"
		FloatType: "Float"
		StringType: "String"
		VoidType: "Void"
		ListType: "List"


private pure func builtin_type_declaration(role: BuiltinTypeRole) -> String:
	match role:
		ListType: "type List[T] = builtin"
		_: Text.concat("type ", builtin_type_spelling(role)).concat(" = builtin")


pure func render_builtin_type_error(error: BuiltinTypeError) -> Diagnostic:
	message = match error.kind:
		InvalidBuiltinName: "invalid parsed builtin name identity"
		InvalidEntrypointName: "invalid parsed entrypoint name identity"
		DuplicateBuiltinType(_): "duplicate builtin type declaration"
		MissingBuiltinType(role): Text.concat("missing ", builtin_type_spelling(role)).concat(" builtin declaration")
		ConflictingBuiltinIdentities: "foundation builtin identities conflict"
		BuiltinOutsideFoundation: "builtin type declarations belong in the configured foundation module"
		FoundationImports: "foundation types cannot import modules"
		FoundationFunctions: "foundation types cannot declare functions"
		FoundationTypeConflict(_): "foundation type conflicts with a builtin declaration"
	help = match error.kind:
		DuplicateBuiltinType(role): Text.concat("declare ", builtin_type_declaration(role)).concat(" exactly once")
		MissingBuiltinType(role): Text.concat("add ", builtin_type_declaration(role)).concat(" to _base/types.brp")
		BuiltinOutsideFoundation: "remove this declaration; builtin types are supplied by _base/types.brp under --library-root"
		FoundationImports: "keep _base/types.brp independent; put operation imports in _base/prelude.brp"
		FoundationFunctions: "move functions to a library operation module and select its type in _base/prelude.brp"
		FoundationTypeConflict(role): Text.concat("remove or rename this fixed union or record; ", builtin_type_spelling(role)).concat(" is owned by its builtin declaration")
		InvalidBuiltinName | InvalidEntrypointName | ConflictingBuiltinIdentities: "report this compiler error with the foundation input"
	{ span = error.span, note = None, message = message, help = help }
