import:
	int as IntOps
	syntax:
		Diagnostic,
		IntegerValue(Zero, One),
		LexedProgram,
		Symbol(PureKeyword, FunctionKeyword, LeftParen, RightParen, Arrow, Colon, Newline, Indent),
		Token,
		TokenKind(IdentifierToken, SymbolToken, IntegerLiteral),
	text as Text


private SPACE_INDENT_WIDTH: Int = 4

private IDENTIFIER_START: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_"

private DIGITS: String = "0123456789"


private fixed union LinePosition:
	AtLineStart
	WithinLine


private pure func token(kind: TokenKind, start: Int, end: Int) -> Token:
	{
		kind = kind,
		span = {
			start = start,
			end = end
		}
	}


private pure func diagnostic(
	start: Int,
	end: Int,
	message: String,
	help: String,
) -> Diagnostic:
	{
		span = {
			start = start,
			end = end
		},
		message = message,
		help = help
	}


-- The preceding byte already belongs to the run; inspect the remaining bytes.
private pure func run_end(source: String, byte_offset: Int, accepted_bytes: String) -> Int:
	var end: Int = byte_offset

	while (
		IntOps.less_than(end, source.length())
		and accepted_bytes.contains(source.substring(end, 1))
	):
		end = IntOps.add(end, 1)

	end


pure func lex(source: String) -> Result[LexedProgram, Diagnostic]:
	identifier_continue: String = Text.concat(IDENTIFIER_START, DIGITS)
	var tokens: List[Token] = []
	var cursor: Int = 0
	var line_position: LinePosition = AtLineStart
	var failure: Option[Diagnostic] = None

	while IntOps.less_than(cursor, source.length()):
		byte_slice: String = source.substring(cursor, 1)

		at_line_start: Bool = match line_position:
			AtLineStart:
				True
			WithinLine:
				False

		if at_line_start and (Text.equals(byte_slice, "\t") or Text.equals(byte_slice, " ")):
			if Text.equals(byte_slice, "\t"):
				next_slice: String = source.substring(
					IntOps.add(cursor, 1),
					1,
				)

				if Text.equals(next_slice, " ") or Text.equals(next_slice, "\t"):
					failure = Some(
						diagnostic(
							cursor,
							IntOps.add(cursor, 1),
							"expected an indent of one tab or four spaces",
							"use exactly one tab or exactly four spaces before the return expression",
						),
					)
					break

				tokens = tokens.append(token(SymbolToken(Indent), cursor, IntOps.add(cursor, 1)))
				cursor = IntOps.add(cursor, 1)
			else:
				indentation_end: Int = run_end(
					source,
					IntOps.add(cursor, 1),
					" ",
				)

				if IntOps.not_equals(
					IntOps.subtract(indentation_end, cursor),
					SPACE_INDENT_WIDTH,
				) or Text.equals(
					source.substring(indentation_end, 1),
					"\t",
				):
					failure = Some(
						diagnostic(
							cursor,
							indentation_end,
							"expected an indent of one tab or four spaces",
							"use exactly one tab or exactly four spaces before the return expression",
						),
					)
					break

				tokens = tokens.append(token(SymbolToken(Indent), cursor, indentation_end))
				cursor = indentation_end

			line_position = WithinLine
		else:
			line_position = WithinLine

			if Text.equals(byte_slice, " "):
				cursor = IntOps.add(cursor, 1)
			else if Text.equals(byte_slice, "\n"):
				tokens = tokens.append(token(SymbolToken(Newline), cursor, IntOps.add(cursor, 1)))
				cursor = IntOps.add(cursor, 1)
				line_position = AtLineStart
			else if Text.equals(byte_slice, "\r"):
				failure = Some(
					diagnostic(
						cursor,
						IntOps.add(cursor, 1),
						"only LF line endings are supported",
						"replace CRLF or CR line endings with LF",
					),
				)
				break
			else if Text.equals(byte_slice, "\t"):
				failure = Some(
					diagnostic(
						cursor,
						IntOps.add(cursor, 1),
						"tabs are allowed only in the body indentation",
						"separate tokens with spaces and indent the body with one tab or four spaces",
					),
				)
				break
			else if IDENTIFIER_START.contains(byte_slice):
				identifier_end: Int = run_end(
					source,
					IntOps.add(cursor, 1),
					identifier_continue,
				)
				spelling: String = source.substring(
					cursor,
					IntOps.subtract(identifier_end, cursor),
				)

				kind: TokenKind = if Text.equals(spelling, "func"):
					SymbolToken(FunctionKeyword)
				else if Text.equals(spelling, "pure"):
					SymbolToken(PureKeyword)
				else:
					IdentifierToken(spelling)

				tokens = tokens.append(token(kind, cursor, identifier_end))
				cursor = identifier_end
			else if DIGITS.contains(byte_slice):
				number_end: Int = run_end(
					source,
					IntOps.add(cursor, 1),
					DIGITS,
				)

				spelling: String = source.substring(
					cursor,
					IntOps.subtract(number_end, cursor),
				)

				if not Text.equals(spelling, "0") and not Text.equals(spelling, "1"):
					failure = Some(
						diagnostic(
							cursor,
							number_end,
							"only the integer literals 0 and 1 are supported",
							"use the single character 0 or 1 as the function body",
						),
					)
					break

				value: IntegerValue = if Text.equals(spelling, "0"):
					Zero
				else:
					One

				tokens = tokens.append(token(IntegerLiteral(value), cursor, number_end))
				cursor = number_end
			else if Text.equals(byte_slice, "-") and Text.equals(
				source.substring(
					IntOps.add(cursor, 1),
					1,
				),
				">",
			):
				tokens = tokens.append(token(SymbolToken(Arrow), cursor, IntOps.add(cursor, 2)))
				cursor = IntOps.add(cursor, 2)
			else:
				symbol: Option[Symbol] = match byte_slice:
					"(":
						Some(LeftParen)
					")":
						Some(RightParen)
					":":
						Some(Colon)
					_:
						None

				match symbol:
					Some(value):
						tokens = tokens.append(
							token(
								SymbolToken(value),
								cursor,
								IntOps.add(cursor, 1),
							),
						)
						cursor = IntOps.add(cursor, 1)
					None:
						failure = Some(
							diagnostic(
								cursor,
								IntOps.add(cursor, 1),
								"unsupported character",
								"use func main() -> Int: followed by an indented 0; keep -> adjacent",
							),
						)
						break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({
				tokens = tokens,
				end = {
					start = source.length(),
					end = source.length()
				},
			})
