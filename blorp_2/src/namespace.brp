import:
	declarations:
		FunctionId,
		RecordId,
		UnionId,
		VariantId,
		function_id,
		record_id,
		union_id,
		union_number,
		variant_id,
		variant_owner,
	int as IntOps
	names: NameId, same_name
	parse:
		ImportSelection(FunctionSelection, UnionSelection),
		ModuleImport,
		ParsedProgram,
		parsed_contents,
	source: ModuleId, same_module
	syntax: Span, WrittenName


fixed union FunctionOrigin:
	LocalFunction
	ImportedFunction(Span)


fixed record FunctionCandidate {
	function: FunctionId,
	origin: FunctionOrigin
}


fixed record ImportedFunctionBinding {
	module: ModuleId,
	name: WrittenName,
	function: FunctionId
}


fixed record ImportedVariantBinding {
	module: ModuleId,
	name: WrittenName,
	variant: VariantId
}


fixed union TypeCandidate:
	UnionCandidate(UnionId)
	RecordCandidate(RecordId)


fixed union ImportProblem:
	RepeatedModuleImport(ModuleId, Span, Span)
	MissingImportedFunction(ModuleId, WrittenName)
	UnsupportedTypeImport(ModuleId, WrittenName)
	MissingImportedUnion(WrittenName)
	AmbiguousImportedUnion(WrittenName)
	MissingImportedVariant(WrittenName)
	RepeatedImportedVariant(WrittenName, Span)
	ImportedTypeConflict(WrittenName, Span)


private fixed record LocalFunctionBinding {
	module: ModuleId,
	name: NameId,
	function: FunctionId
}


private fixed record LocalTypeBinding {
	module: ModuleId,
	name: WrittenName,
	target: TypeCandidate
}


private fixed record LocalVariantBinding {
	module: ModuleId,
	name: NameId,
	variant: VariantId
}


private fixed record NamespaceContents {
	functions: List[LocalFunctionBinding],
	imports: List[ImportedFunctionBinding],
	constructors: List[ImportedVariantBinding],
	types: List[LocalTypeBinding],
	variants: List[LocalVariantBinding],
	problems: List[ImportProblem]
}


-- Derived solely from one parsed program. Complete candidate sets preserve
-- conflicts for the checker without publishing any accepted semantic types.
opaque type Namespace = NamespaceContents


pure func local_function_candidates(
	namespace: Namespace,
	module: ModuleId,
	name: NameId,
) -> List[FunctionId]:
	var candidates: List[FunctionId] = []

	for binding in from_opaque Namespace(namespace).functions:
		if same_module(binding.module, module) and same_name(binding.name, name):
			candidates = candidates.append(binding.function)

	candidates


pure func function_candidates(
	namespace: Namespace,
	module: ModuleId,
	name: NameId,
) -> List[FunctionCandidate]:
	var candidates: List[FunctionCandidate] = []

	for function in local_function_candidates(namespace, module, name):
		candidates = candidates.append({ function = function, origin = LocalFunction })
	for binding in from_opaque Namespace(namespace).imports:
		if same_module(binding.module, module) and same_name(binding.name.id, name):
			candidates = candidates.append({
				function = binding.function,
				origin = ImportedFunction(binding.name.span),
			})

	candidates


pure func type_candidates(
	namespace: Namespace,
	module: ModuleId,
	name: NameId,
) -> List[TypeCandidate]:
	var candidates: List[TypeCandidate] = []

	for binding in from_opaque Namespace(namespace).types:
		if same_module(binding.module, module) and same_name(binding.name.id, name):
			candidates = candidates.append(binding.target)

	candidates


pure func variant_candidates(
	namespace: Namespace,
	module: ModuleId,
	name: NameId,
) -> List[VariantId]:
	var candidates: List[VariantId] = []

	for binding in from_opaque Namespace(namespace).variants:
		if same_module(binding.module, module) and same_name(binding.name, name):
			candidates = candidates.append(binding.variant)

	for binding in from_opaque Namespace(namespace).constructors:
		if same_module(binding.module, module) and same_name(binding.name.id, name):
			candidates = candidates.append(binding.variant)

	candidates


pure func imported_variants(namespace: Namespace) -> List[ImportedVariantBinding]:
	from_opaque Namespace(namespace).constructors


pure func imported_functions(namespace: Namespace) -> List[ImportedFunctionBinding]:
	from_opaque Namespace(namespace).imports


pure func import_problems(namespace: Namespace) -> List[ImportProblem]:
	from_opaque Namespace(namespace).problems


pure func build_namespace(program: ParsedProgram) -> Namespace:
	parsed = parsed_contents(program)
	var functions: List[LocalFunctionBinding] = []
	var types: List[LocalTypeBinding] = []
	var variants: List[LocalVariantBinding] = []
	var position: Int = 0

	for function in parsed.functions:
		functions = functions.append({
			module = function.module,
			name = function.function_name.id,
			function = function_id(position),
		})
		position = IntOps.add(position, 1)

	position = 0

	for declaration in parsed.unions:
		owner = union_id(position)
		types = types.append({
			module = declaration.module,
			name = declaration.type_name,
			target = UnionCandidate(owner),
		})
		var variant_position: Int = 0

		for variant in declaration.variants:
			variants = variants.append({
				module = declaration.module,
				name = variant.name.id,
				variant = variant_id(owner, variant_position),
			})
			variant_position = IntOps.add(variant_position, 1)

		position = IntOps.add(position, 1)

	position = 0

	for declaration in parsed.records:
		types = types.append({
			module = declaration.module,
			name = declaration.type_name,
			target = RecordCandidate(record_id(position)),
		})
		position = IntOps.add(position, 1)

	local = into_opaque Namespace({
			functions = functions,
			imports = [],
			constructors = [],
			types = types,
			variants = variants,
			problems = []
		})
	var imports: List[ImportedFunctionBinding] = []
	var constructors: List[ImportedVariantBinding] = []
	var problems: List[ImportProblem] = []

	for module in parsed.modules:
		var previous: List[ModuleImport] = []

		for request in module.imports:
			for first in previous:
				if same_module(first.target, request.target):
					problems = problems.append(RepeatedModuleImport(request.target, first.span, request.span))
					break

			previous = previous.append(request)

			for selection in request.symbols:
				match selection:
					FunctionSelection(symbol):
						candidates = local_function_candidates(local, request.target, symbol.id)

						match candidates:
							[]:
								problem = match type_candidates(local, request.target, symbol.id):
									[]:
										MissingImportedFunction(request.target, symbol)
									_:
										UnsupportedTypeImport(request.target, symbol)

								problems = problems.append(problem)
							_:
								for function in candidates:
									imports = imports.append({
										module = module.module,
										name = symbol,
										function = function,
									})
					UnionSelection(name, selected):
						owner_result: Result[UnionId, ImportProblem] = match type_candidates(
							local,
							request.target,
							name.id,
						):
							[UnionCandidate(owner)]:
								Ok(owner)
							[] | [RecordCandidate(_)]:
								Err(MissingImportedUnion(name))
							_:
								Err(AmbiguousImportedUnion(name))

						match owner_result:
							Err(problem):
								problems = problems.append(problem)
							Ok(owner):
								for previous_type in types:
									if (
										same_module(previous_type.module, module.module)
										and same_name(previous_type.name.id, name.id)
									):
										problems = problems.append(
											ImportedTypeConflict(
												name,
												previous_type.name.span,
											),
										)
										break

								types = types.append({
									module = module.module,
									name = name,
									target = UnionCandidate(owner),
								})
								var previous_variants: List[WrittenName] = []

								for written in selected:
									for previous_variant in previous_variants:
										if same_name(previous_variant.id, written.id):
											problems = problems.append(
												RepeatedImportedVariant(
													written,
													previous_variant.span,
												),
											)
											break

									previous_variants = previous_variants.append(written)
									var found = False

									for variant in variant_candidates(
										local,
										request.target,
										written.id,
									):
										if IntOps.equals(
											union_number(variant_owner(variant)),
											union_number(owner),
										):
											constructors = constructors.append({
												module = module.module,
												name = written,
												variant = variant,
											})
											found = True
											break

									if not found:
										problems = problems.append(MissingImportedVariant(written))

	contents = from_opaque Namespace(local)
	into_opaque Namespace({ contents |
			imports = imports,
			constructors = constructors,
			types = types,
			problems = problems
		})
