import:
	bool: not, or
	../utils/ids: DeclarationInventory, issue_inventory
	int: Int methods
	../utils/names: NameId, NameTable, intern_names, program_names, same_name_table
	option: Option methods
	list: repeat, List methods
	./parse: ImportSelection, ImportOrigin(LibraryImport), ModulePath, ParsedModule, ParsedModuleContents, module_contents
	../utils/source: ModuleId, ModuleKind(FoundationTypesModule, FoundationPreludeModule, LibraryModule, UserModule), ModuleStem, module_stem, module_number, root_module_id, same_module
	../utils/syntax:
		Diagnostic, DiagnosticNote(PreviousDeclaration), ExpressionBase(NameExpression, QualifiedApplication),
		ParsedBody(ParsedValueBody), ParsedBuiltinType, ParsedConstant, ParsedFunction, ParsedOpaque,
		ParsedRecord, ParsedUnion, ParsedTrait, ParsedFunctionGroup(FreeFunction, ImplementationGroup), function_group_module, Purity(Impure), Span, TypeSyntax(QualifiedType), ValueExpression,
		Visibility(Private), WrittenName, compiler_span, diagnostic, source_bundle_error


-- Program assembly: the loader appends each parsed module in inventory order,
-- and sealing validates the complete bundle once for checking.


-- `path` is the written path, kept for diagnostics that name the module.
fixed record ModuleImport {
	target: ModuleId,
	path: ModulePath,
	module_alias: Option[WrittenName],
	symbols: List[ImportSelection],
	span: Span
}


fixed record FoundationModules {
	types: ModuleId,
	prelude: ModuleId
}


fixed record ParsedBuiltinDeclaration {
	module: ModuleId,
	declaration: ParsedBuiltinType
}


fixed record ParsedModuleRow {
	module: ModuleId,
	role: ModuleKind,
	stem: ModuleStem,
	imports: List[ModuleImport],
	end: Span
}


fixed record ParsedContents {
	names: NameTable,
	entrypoint: NameId,
	foundation: FoundationModules,
	builtin_types: List[ParsedBuiltinDeclaration],
	modules: List[ParsedModuleRow],
	-- The rows of `modules` again, each once, after the modules it imports
	-- and, for a user module, after the prelude it receives.
	dependency_order: List[ParsedModuleRow],
	declarations: DeclarationInventory,
	end: Span
}


private fixed record ProgramBuilder {
	names: NameTable,
	entrypoint: NameId,
	builtin_types: List[ParsedBuiltinDeclaration],
	modules: List[ParsedModuleRow],
	functions: List[ParsedFunctionGroup],
	traits: List[ParsedTrait],
	unions: List[ParsedUnion],
	records: List[ParsedRecord],
	opaques: List[ParsedOpaque],
	constants: List[ParsedConstant]
}


opaque type ParsedAssembly = ProgramBuilder

-- All module syntax shares one complete spelling authority per compilation.
opaque type ParsedProgram = ParsedContents


pure func parsed_contents(program: ParsedProgram) -> ParsedContents:
	from_opaque ParsedProgram(program)


pure func begin_program() -> ParsedAssembly:
	seed = program_names()
	into_opaque ParsedAssembly({
			names = seed.names,
			entrypoint = seed.main,
			builtin_types = [],
			modules = [],
			functions = [],
			traits = [],
			unions = [],
			records = [],
			opaques = [],
			constants = []
		})


pure func assembly_names(assembly: ParsedAssembly) -> NameTable:
	from_opaque ParsedAssembly(assembly).names


-- Test entry is ordinary syntax before the one declaration-ID publication.
-- These display labels cannot be source identifiers; their issued IDs, never
-- their spelling or ordinal, select the entry and its private library alias.
pure func prepare_test_entry(assembly: ParsedAssembly, library: ModuleId, types: ModuleId) -> Result[ParsedAssembly, Diagnostic]:
	builder = from_opaque ParsedAssembly(assembly)
	root ?= builder.modules.get(0).to_result(source_bundle_error("test entry requires a root module"))
	library_row ?= builder.modules.get(module_number(library)).to_result(source_bundle_error("test entry requires the configured test library module"))
	_: Void ?= match library_row.role:
		LibraryModule: Ok(void)
		_: Err(source_bundle_error("test entry requires the configured test library module"))
	types_row ?= builder.modules.get(module_number(types)).to_result(source_bundle_error("test entry requires the foundation types module"))
	_: Void ?= match types_row.role:
		FoundationTypesModule: Ok(void)
		_: Err(source_bundle_error("test entry requires the foundation types module"))
	words = intern_names(builder.names, ["<test entry>", "<test library>", "tests", "test", "run_suite", "Int", "<test types>", "_base"])
	match words.ids:
		[entry_id, alias_id, suite_id, library_name, runner_id, integer_id, types_alias_id, types_name]:
			internal: Span = compiler_span()
			var library_alias: WrittenName = { id = alias_id, span = internal }
			var types_alias: WrittenName = { id = types_alias_id, span = internal }
			var imports: List[ModuleImport] = []
			var found: Bool = False
			var found_types: Bool = False
			for request in root.imports:
				if same_module(request.target, library):
					library_alias = request.module_alias.get_or(library_alias)
					imports = imports.append({ request | module_alias = Some(library_alias) })
					found = True
				else if same_module(request.target, types):
					types_alias = request.module_alias.get_or(types_alias)
					imports = imports.append({ request | module_alias = Some(types_alias) })
					found_types = True
				else:
					imports = imports.append(request)
			if found.not():
				imports = imports.append({
					target = library, path = { origin = LibraryImport, parts = [library_name] },
					module_alias = Some(library_alias), symbols = [], span = internal,
				})
			if found_types.not():
				imports = imports.append({
					target = types, path = { origin = LibraryImport, parts = [types_name] },
					module_alias = Some(types_alias), symbols = [], span = internal,
				})
			-- The CLI has no written call token: its implicit operand points to
			-- the real root EOF, so ordinary suite diagnostics name a real file.
			suite: ValueExpression = {
				base = NameExpression({ id = suite_id, span = root.end }),
				base_span = root.end, applications = [], span = root.end,
			}
			call: ValueExpression = {
				base = QualifiedApplication({ module = library_alias, name = { id = runner_id, span = root.end } }, [suite]),
				base_span = root.end, applications = [], span = root.end,
			}
			entry: ParsedFunction = {
				module = root_module_id(), visibility = Private(internal), tail_annotation = None,
				purity = Impure, function_name = { id = entry_id, span = root.end },
				type_parameters = [], parameters = [],
				return_type = Some(QualifiedType({ module = types_alias, name = { id = integer_id, span = internal } }, [], internal)),
				statements = [], body = ParsedValueBody(call),
			}
			-- Namespace consumes functions grouped by module; the implicit root
			-- declaration belongs at that group's EOF before IDs are issued.
			var functions: List[ParsedFunctionGroup] = []
			for function in builder.functions:
				if same_module(function_group_module(function), root_module_id()):
					functions = functions.append(function)
			functions = functions.append(FreeFunction(entry))
			for function in builder.functions:
				if same_module(function_group_module(function), root_module_id()).not():
					functions = functions.append(function)
			Ok(into_opaque ParsedAssembly({ builder |
				names = words.names, entrypoint = entry_id,
				modules = builder.modules.set(0, { root | imports = imports }),
				functions = functions,
			}))
		_:
			Err(source_bundle_error("test entry names were not issued together"))


private REPEATED_IMPORT_HELP: String = "combine the alias and the selected names into one import, such as path as Alias: name"


-- Pairs each import request with its target, in order. A module imports each
-- module once (GUIDE, One Import Per Module): an alias and selections share a row.
private pure func linked_imports(
	contents: ParsedModuleContents,
	position: Int,
	targets: List[ModuleId],
	linked: List[ModuleImport],
) -> Result[List[ModuleImport], Diagnostic]:
	match contents.imports.get(position):
		None:
			if position == targets.length():
				Ok(linked)
			else:
				Err(source_bundle_error("source bundle does not supply exactly one target per import"))
		Some(request):
			match targets.get(position):
				Some(target):
					var earlier: Option[Span] = None
					for previous in linked:
						if same_module(previous.target, target):
							earlier = Some(previous.span)
							break
					match earlier:
						Some(first):
							Err({ diagnostic(request.span, "module imported more than once", REPEATED_IMPORT_HELP) | note = Some(PreviousDeclaration(first)) })
						None:
							link: ModuleImport = { target = target, path = request.path, module_alias = request.module_alias, symbols = request.symbols, span = request.span }
							linked_imports(contents, position.add(1), targets, linked.append(link))
				None:
					Err(source_bundle_error("source bundle does not supply exactly one target per import"))


pure func append_module(
	assembly: ParsedAssembly,
	parsed: ParsedModule,
	targets: List[ModuleId],
	role: ModuleKind,
	path: String,
) -> Result[ParsedAssembly, Diagnostic]:
	builder = from_opaque ParsedAssembly(assembly)
	contents = module_contents(parsed)
	_: Void ?= if same_name_table(builder.names, contents.base_names).not():
		Err(source_bundle_error("parsed module does not extend this source bundle's name authority"))
	else if module_number(contents.module) != builder.modules.length():
		Err(source_bundle_error("parsed module does not have the next source bundle identity"))
	else:
		Ok(void)
	stem ?= module_stem(path).to_result(source_bundle_error("module path has no file name"))
	imports ?= linked_imports(contents, 0, targets, [])
	var builtin_types = builder.builtin_types

	for declaration in contents.builtin_types:
		builtin_types = builtin_types.append({ module = contents.module, declaration = declaration })

	Ok(into_opaque ParsedAssembly({
				names = contents.names,
				entrypoint = builder.entrypoint,
				builtin_types = builtin_types,
				modules = builder.modules.append({ module = contents.module, role = role, stem = stem, imports = imports, end = contents.end }),
				functions = builder.functions.concat(contents.functions),
				traits = builder.traits.concat(contents.traits),
				unions = builder.unions.concat(contents.unions),
				records = builder.records.concat(contents.records),
				opaques = builder.opaques.concat(contents.opaques),
				constants = builder.constants.concat(contents.constants)
			}))


-- Exactly one row has each foundation role.
private pure func foundation_module(
	rows: List[ParsedModuleRow],
	missing: String,
	repeated: String,
	root: ParsedModuleRow,
) -> Result[ModuleId, SealFailure]:
	match rows:
		[]:
			Err(MalformedBundle({ source_bundle_error(missing) | span = root.end }))
		[row]:
			Ok(row.module)
		[_, duplicate, ..._]:
			Err(MalformedBundle({ source_bundle_error(repeated) | span = duplicate.end }))


-- Why a bundle cannot be sealed. The loader renders a cycle: it owns the
-- modules' display paths.
union SealFailure:
	MalformedBundle(Diagnostic)
	ImportCycle(List[ModuleId], Span)


-- Seal-only edges distinguish the implicit prelude from written imports.
private union ModuleEdge:
	PreludeEdge(ModuleId)
	ImportEdge(ModuleImport)


private fixed record WalkFrame {
	module: ModuleId,
	next_edge: Int
}


private union VisitState:
	Unvisited
	Active
	Complete


private fixed record ModuleWalk {
	frames: List[WalkFrame],
	visits: List[VisitState],
	explored: List[ParsedModuleRow],
	failure: Option[SealFailure]
}


-- The active suffix closed by this edge, followed by its target again.
private pure func cycle_to(frames: List[WalkFrame], target: ModuleId) -> List[ModuleId]:
	var cycle: List[ModuleId] = []
	for frame in frames:
		if or(cycle.is_empty().not(), same_module(frame.module, target)):
			cycle = cycle.append(frame.module)
	cycle.append(target)


-- Advance one frame, following its edge or publishing its completed row.
-- Every result updates this walk directly, so the host can consume its lists.
private pure func walk_step(walk: ModuleWalk, top: WalkFrame, edges: List[ModuleEdge], row: ParsedModuleRow) -> ModuleWalk:
	depth = walk.frames.length().subtract(1)
	match edges.get(top.next_edge):
		None:
			{ walk |
				frames = walk.frames.take(depth),
				visits = walk.visits.set(module_number(top.module), Complete),
				explored = walk.explored.append(row)
			}
		Some(edge):
			target = match edge:
				PreludeEdge(module): module
				ImportEdge(request): request.target
			number = module_number(target)
			advanced = walk.frames.set(depth, { top | next_edge = top.next_edge.add(1) })
			visit: VisitState = walk.visits.get_or(number, Unvisited)
			match visit:
				Active:
					closing = match edge:
						PreludeEdge(_): row.end
						ImportEdge(request): request.span
					{ walk | frames = advanced, failure = Some(ImportCycle(cycle_to(advanced, target), closing)) }
				Complete:
					{ walk | frames = advanced }
				Unvisited:
					{ walk | frames = advanced.append({ module = target, next_edge = 0 }), visits = walk.visits.set(number, Active) }


-- Build the transient edge inventory once, prelude first. DFS keeps load and
-- written-import order, publishing each row after its dependencies. Only the
-- resulting order survives sealing; indices follow the assembly's dense rows.
private pure func ordered_rows(rows: List[ParsedModuleRow], prelude: ModuleId) -> Result[List[ParsedModuleRow], SealFailure]:
	var edges_by_module: List[List[ModuleEdge]] = []
	for row in rows:
		var edges: List[ModuleEdge] = match row.role:
			UserModule: [PreludeEdge(prelude)]
			FoundationTypesModule | FoundationPreludeModule | LibraryModule: []
		for request in row.imports:
			edges = edges.append(ImportEdge(request))
		edges_by_module = edges_by_module.append(edges)
	var walk: ModuleWalk = { frames = [], visits = repeat(Unvisited, rows.length()), explored = [], failure = None }
	for start in rows:
		visit: VisitState = walk.visits.get_or(module_number(start.module), Unvisited)
		match visit:
			Unvisited:
				walk = { walk | frames = [{ module = start.module, next_edge = 0 }], visits = walk.visits.set(module_number(start.module), Active) }
			Active | Complete: void
		while walk.failure.is_none():
			match walk.frames.last():
				Some(top):
					match rows.get(module_number(top.module)):
						Some(row): walk = walk_step(walk, top, edges_by_module.get_or(module_number(top.module), []), row)
						None: walk = { walk | failure = Some(MalformedBundle(source_bundle_error("source bundle is missing an imported module"))) }
				None: break
		if walk.failure.is_some():
			break
	match walk.failure:
		Some(stop): Err(stop)
		None: Ok(walk.explored)


pure func seal_program(assembly: ParsedAssembly) -> Result[ParsedProgram, SealFailure]:
	builder = from_opaque ParsedAssembly(assembly)
	root: ParsedModuleRow ?= builder.modules.get(0).to_result(MalformedBundle(source_bundle_error("source bundle has no root module")))
	var types_rows: List[ParsedModuleRow] = []
	var prelude_rows: List[ParsedModuleRow] = []

	for row in builder.modules:
		match row.role:
			FoundationTypesModule:
				types_rows = types_rows.append(row)
			FoundationPreludeModule:
				prelude_rows = prelude_rows.append(row)
			LibraryModule | UserModule:
				void

	types ?= foundation_module(types_rows, "source bundle has no foundation types module", "source bundle has more than one foundation types module", root)
	prelude ?= foundation_module(prelude_rows, "source bundle has no foundation prelude module", "source bundle has more than one foundation prelude module", root)
	_: Void ?= match root.role:
		UserModule:
			Ok(void)
		_:
			Err(MalformedBundle({ source_bundle_error("source bundle root must be a user module") | span = root.end }))
	-- Walking from each module in load order reports the first cycle
	-- deterministically, at the import that closes it.
	ordered ?= ordered_rows(builder.modules, prelude)
	Ok(into_opaque ParsedProgram({
		names = builder.names,
		entrypoint = builder.entrypoint,
		foundation = { types = types, prelude = prelude },
		builtin_types = builder.builtin_types,
		modules = builder.modules,
		dependency_order = ordered,
		declarations = issue_inventory(builder.functions, builder.records, builder.unions, builder.opaques, builder.constants, builder.traits),
		end = root.end
	}))
