private pure func at_integer_literal(state: ParserState) -> Bool:
	match current(state):
		Some(token):
			match token.kind:
				IntegerLiteral(_):
					True
				_:
					False
		None:
			False


private pure func at_question_equals(state: ParserState) -> Bool:
