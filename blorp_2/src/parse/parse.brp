		ParsedQualified,
		ParsedBinder(NamedBinder, DiscardBinder),
		ForBinder(SingleForBinder, TupleForBinder),
		LambdaParameter,
		LambdaBody(InlineBody, BlockBody),
		ParsedLambda,
		ParsedMatch,
		FunctionHeader,
		Keyword(
			PureKeyword, FunctionKeyword, MatchKeyword, VarKeyword, VoidKeyword,
			IfKeyword, ElseKeyword,
			WhileKeyword, ForKeyword, InKeyword, BreakKeyword, ContinueKeyword,
			ImportKeyword, TypeKeyword, PrivateKeyword, RecordKeyword, UnionKeyword, TraitKeyword, ImplementsKeyword,
			BuiltinKeyword, AsKeyword, OpaqueKeyword, IntoOpaqueKeyword, FromOpaqueKeyword,
		),
		LexedProgram,
		ParsedBinding,
		ParsedBlock,
		ParsedBody(ParsedBuiltinBody, ParsedValueBody, ParsedMatchBody),
		ParsedBuiltinType(IntegerBuiltin, FloatBuiltin, StringBuiltin, VoidBuiltin, ListBuiltin),
		ParsedConstant,
		ParsedFunction, ParsedTrait, ParsedTraitMethod(AbstractTraitMethod, DefaultTraitMethod), ParsedImplementationHeader,
		ParsedTypeParameter, ParsedReceiverHead(ReceiverName, QualifiedReceiverName),
		ParsedFunctionGroup(FreeFunction, ImplementationGroup),
		ParsedMatchArm,
		ParsedOpaque,
		ParsedParameter,
		ParsedPattern(PatternName, PatternWildcard, PatternConstructor, PatternOr, PatternList, PatternTuple, PatternString, PatternChar),
		PatternHead(BareHead, QualifiedHead),
		ParsedRecord,
		ParsedRecordField,
		ParsedDictEntry,
		SpreadTarget(SpreadName, SpreadWildcard),
		ParsedRuntimeOperation(
			FloatCopySignBuiltin, FloatEqualsBuiltin, FloatLessThanBuiltin,
			IntegerAddBuiltin, IntegerToStringBuiltin, StringLengthBuiltin, StringConcatBuiltin, StringAppendIntBuiltin, StringPrintBuiltin, StringPrintErrorBuiltin,
			StringParseIntBuiltin, ListRepeatBuiltin, ListLengthBuiltin, ListGetBuiltin, ListAppendBuiltin, ListSetBuiltin, ListConcatBuiltin, StringEqualsBuiltin, IntegerEqualsBuiltin, IntegerLessThanBuiltin, IntegerSubtractBuiltin,
			IntegerMultiplyBuiltin, IntegerDivideBuiltin, IntegerRemainderBuiltin,
			FloatAddBuiltin, FloatSubtractBuiltin, FloatMultiplyBuiltin, FloatDivideBuiltin,
			FloatRemainderBuiltin, FloatToStringBuiltin, StringParseFloatBuiltin,
			StringByteAtBuiltin, StringFromCodepointBuiltin, StringSliceBuiltin, SystemBuiltin,
		),
		SystemOperation,
		SYSTEM_OPERATIONS,
		ParsedPropagation,
		ParsedWhile,
		ParsedFor,
