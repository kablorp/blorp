-- `aliases` are the module aliases its import block declared so far; a name
-- followed by '.' is a qualified name only when it is one of them.
-- A function's own statements admit `?=`; every `if` or `match` block
-- rejects it. Loop bodies admit loop controls; value blocks inside loops
-- admit none. Lambdas reject `?=` and need their own loop for loop control.
-- Each block restores its caller's context when it ends.
private fixed union StatementContext:
	FunctionBody
	FunctionBlock
	InsideLambda
	LoopBody
	ValueInLoop


-- Whether the parser stands inside an open bracket, where a block's last
-- line may wrongly carry the closing bracket (host 4.9).
private fixed union Enclosure:
	Unbracketed
	Bracketed


private fixed record ParserState {
	input: LexedProgram,
	position: Int,
	aliases: List[NameId],
	context: StatementContext,
	enclosure: Enclosure
}


private pure func with_context(state: ParserState, context: StatementContext) -> ParserState:
	{ state | context = context }


private pure func with_enclosure(state: ParserState, enclosure: Enclosure) -> ParserState:
	{ state | enclosure = enclosure }


private pure func bracketed(state: ParserState) -> Bool:
	match state.enclosure:
		Bracketed:
			True
		Unbracketed:
			False


fixed union ImportOrigin:
	RelativeImport(Int)
	LibraryImport


fixed record ModulePath {
	origin: ImportOrigin,
	parts: List[NameId]
}


fixed union ImportSelection:
	NamedSelection(WrittenName)
	ConstructorSelection(WrittenName, List[WrittenName])
	MethodsSelection(WrittenName, Span)


-- `alias` is the module alias written as `path as Alias`; its selections may
-- be empty.
fixed record ParsedImport {
	path: ModulePath,
	module_alias: Option[WrittenName],
	symbols: List[ImportSelection],
	span: Span
}


-- `base_names` is the table lexing extended; `names` adds the module's spellings.
fixed record ParsedModuleContents {
	base_names: NameTable,
	names: NameTable,
	module: ModuleId,
	imports: List[ParsedImport],
	builtin_types: List[ParsedBuiltinType],
	functions: List[ParsedFunctionGroup],
	traits: List[ParsedTrait],
	unions: List[ParsedUnion],
	records: List[ParsedRecord],
	opaques: List[ParsedOpaque],
	constants: List[ParsedConstant],
	end: Span
}


-- Only `parse_module` constructs a module's syntax; readers see its contents.
opaque type ParsedModule = ParsedModuleContents


pure func module_contents(parsed: ParsedModule) -> ParsedModuleContents:
	from_opaque ParsedModule(parsed)


pure func module_names(parsed: ParsedModule) -> NameTable:
	from_opaque ParsedModule(parsed).names


pure func module_imports(parsed: ParsedModule) -> List[ParsedImport]:
	from_opaque ParsedModule(parsed).imports


private IMPORT_IN_BODY_MESSAGE: String = "imports belong at module scope"

private IMPORT_IN_BODY_HELP: String = "move import: and its selected functions before the module's declarations at column 1"

private IDENTIFIER_HELP: String = "use an ASCII identifier starting with a letter or underscore; keywords and lone '_' are reserved"

private EXPRESSION_HELP: String = "use a literal, a parameter or variant name, or a call as the entire body"

private DISCARD_VALUE_MESSAGE: String = "`_` is not a value"

private DISCARD_VALUE_HELP: String = "use a named value or void; use _ only as a binder or pattern"

private DECIMAL_RADIX: Int = 10

private STRING_ESCAPE_HELP: String = "use \\n, \\r, \\t, \\0, \\\\, \\\", \\', \\{, \\}, or a Unicode scalar escape such as \\u{E9}"

private UNICODE_ESCAPE_HELP: String = "write \\u{H} with one to six hexadecimal digits for a scalar from 0 to 10FFFF, excluding D800 through DFFF"

private MAX_UNICODE_HEX_DIGITS: Int = 6

private HEX_RADIX: Int = 16

-- ASCII codes used by literal decoding and type-parameter classification.
private ZERO_BYTE: Int = 48
private NINE_BYTE: Int = 57
private MINUS_BYTE: Int = 45
private UPPER_A_BYTE: Int = 65
private UPPER_F_BYTE: Int = 70
private UPPER_Z_BYTE: Int = 90
private LOWER_A_BYTE: Int = 97
private LOWER_F_BYTE: Int = 102
private LOWER_Z_BYTE: Int = 122
private LOWER_N_BYTE: Int = 110
private LOWER_R_BYTE: Int = 114
private LOWER_T_BYTE: Int = 116
private LOWER_U_BYTE: Int = 117
private BACKSLASH_BYTE: Int = 92
private OPEN_BRACE_BYTE: Int = 123
private CLOSE_BRACE_BYTE: Int = 125
private DOUBLE_QUOTE_BYTE: Int = 34
private SINGLE_QUOTE_BYTE: Int = 39


private pure func current_token(state: ParserState) -> Option[Token]:
	state.input.tokens.get(state.position)


private pure func shifted(state: ParserState, count: Int) -> ParserState:
	{ state | position = state.position.add(count) }


private pure func at_end(state: ParserState) -> Bool:
	state.position.greater_than_or_equal(state.input.tokens.length())


private pure func parser_span(state: ParserState) -> Span:
	match current_token(state):
		Some(token):
			token.span
		None:
			state.input.end


private pure func expected_syntax(state: ParserState, message: String, help: String) -> Diagnostic:
	diagnostic(parser_span(state), message, help)


private pure func misplaced_annotation(state: ParserState) -> Diagnostic:
	expected_syntax(state, "misplaced function annotation", "put @tail_recursive before the optional pure and func keywords at column 1")


-- The symbol at the parser position, or None for any other token or the end.
private pure func current_symbol(state: ParserState) -> Option[Symbol]:
	match current_token(state):
		Some(token):
			match token.kind:
				SymbolToken(symbol):
					Some(symbol)
				_:
					None
		None:
			None


-- Reserved words have their own identity; punctuation never enters this query.
private pure func current_keyword(state: ParserState) -> Option[Keyword]:
	match current_token(state):
		Some(token):
			match token.kind:
				KeywordToken(keyword):
					Some(keyword)
				_:
					None
		None:
			None


private pure func at_keyword(state: ParserState, keyword: Keyword) -> Bool:
	current_keyword(state) == Some(keyword)


private pure func at_symbol(state: ParserState, symbol: Symbol) -> Bool:
	current_symbol(state) == Some(symbol)


-- Each token role the parser tests at several sites has one predicate here.
private pure func at_comma(state: ParserState) -> Bool:
	match current_symbol(state):
		Some(Comma):
			True
		_:
			False


private pure func at_left_paren(state: ParserState) -> Bool:
	match current_symbol(state):
		Some(LeftParen):
			True
		_:
			False


private pure func at_right_paren(state: ParserState) -> Bool:
	match current_symbol(state):
		Some(RightParen):
			True
		_:
			False


private pure func at_dot(state: ParserState) -> Bool:
	match current_symbol(state):
		Some(Dot):
			True
		_:
			False


private pure func at_dedent(state: ParserState) -> Bool:
	match current_symbol(state):
		Some(Dedent):
			True
		_:
			False


private pure func at_newline(state: ParserState) -> Bool:
	match current_symbol(state):
		Some(Newline):
			True
		_:
			False


private pure func at_slash(state: ParserState) -> Bool:
	match current_symbol(state):
		Some(Slash):
			True
		_:
			False


private pure func at_at_sign(state: ParserState) -> Bool:
	match current_symbol(state):
		Some(AtSign):
			True
		_:
			False


private pure func at_left_bracket(state: ParserState) -> Bool:
	match current_symbol(state):
		Some(LeftBracket):
			True
		_:
			False


private pure func at_right_bracket(state: ParserState) -> Bool:
	match current_symbol(state):
		Some(RightBracket):
			True
		_:
			False


private pure func at_import(state: ParserState) -> Bool:
	match current_keyword(state):
		Some(ImportKeyword):
			True
		_:
			False


private pure func at_type_keyword(state: ParserState) -> Bool:
	match current_keyword(state):
		Some(TypeKeyword):
			True
		_:
			False


private pure func at_private(state: ParserState) -> Bool:
	match current_keyword(state):
		Some(PrivateKeyword):
			True
		_:
			False


private pure func at_builtin(state: ParserState) -> Bool:
	match current_keyword(state):
		Some(BuiltinKeyword):
			True
		_:
			False


private pure func at_as(state: ParserState) -> Bool:
	match current_keyword(state):
		Some(AsKeyword):
			True
		_:
			False


private pure func at_not(state: ParserState) -> Bool:
	match current_keyword(state):
		Some(NotKeyword):
			True
		_:
			False


private pure func at_if(state: ParserState) -> Bool:
	match current_keyword(state):
		Some(IfKeyword):
			True
		_:
			False


private pure func at_for(state: ParserState) -> Bool:
	match current_keyword(state):
		Some(ForKeyword):
			True
		_:
			False


private fixed union LoopControl:
	BreakControl
	ContinueControl


-- The loop control a line starts with, if any.
private pure func at_loop_control(state: ParserState) -> Option[LoopControl]:
	match current_keyword(state):
		Some(BreakKeyword):
			Some(BreakControl)
		Some(ContinueKeyword):
			Some(ContinueControl)
		_:
			None


private pure func at_dot_dot(state: ParserState) -> Bool:
	match current_symbol(state):
		Some(DotDot):
			True
		_:
			False


private pure func at_bar(state: ParserState) -> Bool:
	match current_symbol(state):
		Some(Bar):
			True
		_:
			False


private pure func at_wildcard(state: ParserState) -> Bool:
	match current_symbol(state):
		Some(Wildcard):
			True
		_:
			False


private pure func at_var(state: ParserState) -> Bool:
	match current_keyword(state):
		Some(VarKeyword):
			True
		_:
			False


private pure func at_pure(state: ParserState) -> Bool:
	match current_keyword(state):
		Some(PureKeyword):
			True
		_:
			False


private pure func at_arrow(state: ParserState) -> Bool:
	match current_symbol(state):
		Some(Arrow):
			True
		_:
			False


private pure func at_func(state: ParserState) -> Bool:
	match current_keyword(state):
		Some(FunctionKeyword):
			True
		_:
			False


private pure func at_colon(state: ParserState) -> Bool:
	match current_symbol(state):
		Some(Colon):
			True
		_:
			False


private pure func at_indent(state: ParserState) -> Bool:
	match current_symbol(state):
		Some(Indent):
			True
		_:
			False


private pure func at_equals(state: ParserState) -> Bool:
	match current_symbol(state):
		Some(Equals):
			True
		_:
			False


private pure func at_integer_literal(state: ParserState) -> Bool:
	match current_token(state):
		Some(token):
			match token.kind:
				IntegerLiteral(_):
					True
				_:
					False
		None:
			False


private pure func at_question_equals(state: ParserState) -> Bool:
	match current_symbol(state):
		Some(QuestionEquals):
			True
		_:
			False


private pure func at_right_brace(state: ParserState) -> Bool:
	match current_symbol(state):
		Some(RightBrace):
			True
		_:
			False


-- The seeded IDs of the recognised names, from the table the source was lexed with.
private pure func recognized_words(state: ParserState) -> ContextualWords:
	contextual_words(state.input.names)


-- A recognised name (`fixed`, `methods`, a base type name) is an ordinary
-- identifier the parser compares by its seeded ID; keywords are keyword tokens.
private pure func at_word(state: ParserState, word: NameId) -> Bool:
	match current_token(state):
		Some(token):
			match token.kind:
				IdentifierToken(id):
					same_name(id, word)
				_:
					False
		None:
			False


private pure func at_identifier(state: ParserState) -> Bool:
	match current_token(state):
		Some(token):
			match token.kind:
				IdentifierToken(_):
					True
				_:
					False
		None:
			False


private pure func at_spaced_token(state: ParserState) -> Bool:
	match current_token(state):
		Some(token):
			match token.spacing:
				Spaced:
					True
				Adjacent:
					False
		None:
			False


private pure func at_closing_bracket(state: ParserState) -> Bool:
	or(or(at_right_paren(state), at_right_bracket(state)), at_right_brace(state))


-- What follows one item of a bracketed, comma-separated list.
private fixed union ListSeparator:
	ListContinues(ParserState)
	ListEnds(ParserState)


-- A comma followed by another item continues the list; no comma, or a
-- trailing comma before the closing bracket, ends it. The caller then
-- expects its own closing bracket, so a mismatched closer is still an error.
private pure func list_separator(state: ParserState) -> ListSeparator:
	if at_comma(state).not():
		ListEnds(state)
	else:
		after_comma = shifted(state, 1)

		if at_closing_bracket(after_comma):
			ListEnds(after_comma)
		else:
			ListContinues(after_comma)


-- One parsed list item and the state after it.
private fixed record ParsedItem[Item] {
	item: Item,
	next: ParserState
}


private fixed record ParsedList[Item] {
	items: List[Item],
	next: ParserState
}


-- The comma-separated items of a parenthesized list, after the items already
-- read; an empty list or a trailing comma ends at the closing parenthesis,
-- which the caller expects. `parse_item` receives how many items precede it,
-- for a limit on the count, and its error ends the list.
private pure func consume_parenthesized_items[Item](
	state: ParserState,
	items: List[Item],
	parse_item: pure (Int, ParserState) -> Result[ParsedItem[Item], Diagnostic],
) -> Result[ParsedList[Item], Diagnostic]:
	if at_right_paren(state):
		Ok({ items = items, next = state })
	else:
		match parse_item(items.length(), state):
			Err(error): Err(error)
			Ok(parsed):
				gathered = items.append(parsed.item)

				match list_separator(parsed.next):
					ListContinues(next): consume_parenthesized_items(next, gathered, parse_item)
					ListEnds(next): Ok({ items = gathered, next = next })


-- Consumes the token at `state` when the caller's match found it `present`.
private pure func expect(state: ParserState, present: Bool, message: String, help: String) -> Result[ParserState, Diagnostic]:
	if present:
		Ok(shifted(state, 1))
	else:
		Err(unexpected(state, message, help))


private pure func unexpected(state: ParserState, message: String, help: String) -> Diagnostic:
	if at_at_sign(state):
		misplaced_annotation(state)
	else:
		expected_syntax(state, message, help)


-- Ends a line that opens no block, so the next line cannot be indented.
private pure func consume_line_end(state: ParserState, message: String, help: String) -> Result[ParserState, Diagnostic]:
	next ?= expect(state, at_newline(state), message, help)

	if at_indent(next):
		Err(expected_syntax(next, "unexpected indentation", "indent a line only to open the block of a header ending in ':'; otherwise align it with the line above"))
	else:
		Ok(next)


private VALUE_LINE_MESSAGE: String = "expected a newline after the return expression"

private VALUE_LINE_HELP: String = "put each declaration on a new line"


-- Ends a line whose value or declaration is complete.
private pure func end_value_line(state: ParserState) -> Result[ParserState, Diagnostic]:
	consume_line_end(state, VALUE_LINE_MESSAGE, VALUE_LINE_HELP)


private DECLARATION_WORD_HELP: String = "use the ordinary declaration syntax, such as type Int = builtin or builtin(\"int.add\")"


-- A reserved word where a name was expected, in the host's words.
private pure func reserved_name(span: Span, spelling: String) -> Diagnostic:
	diagnostic(
		span,
		"`${spelling}` is a reserved keyword and cannot be used as a name",
		"choose another identifier such as `${spelling}_name`",
	)


private pure func statement_as_value(state: ParserState, message: String) -> Diagnostic:
	expected_syntax(state, message, "write it on a line of its own; a loop or loop control has no value to bind, pass or return")


private fixed record ParsedName {
	name: WrittenName,
	next: ParserState
}


private pure func consume_name(state: ParserState, message: String) -> Result[ParsedName, Diagnostic]:
	match current_token(state):
		Some(token):
			match token.kind:
				IdentifierToken(id):
					Ok({ name = { id = id, span = token.span }, next = shifted(state, 1) })
				SymbolToken(AtSign):
					Err(misplaced_annotation(state))
				KeywordToken(_):
					-- Lexer-issued keyword spans select complete ASCII words in this source.
					spelling = state.input.source_text.slice(token.span.start, token.span.end).get_or("")
					Err(reserved_name(token.span, spelling))
				_:
					Err(expected_syntax(state, message, IDENTIFIER_HELP))
		None:
			Err(expected_syntax(state, message, IDENTIFIER_HELP))


-- Only these reserved tokens may name ordinary functions. The program seed
-- already issued their IDs; bindings, types and fields still use consume_name.
private pure func callable_keyword_name(state: ParserState) -> Option[NameId]:
	match current_keyword(state):
		Some(NotKeyword): Some(recognized_words(state).not_word)
		Some(AndKeyword): Some(recognized_words(state).and_word)
		Some(OrKeyword): Some(recognized_words(state).or_word)
		_: None


private pure func consume_callable_name(state: ParserState, message: String) -> Result[ParsedName, Diagnostic]:
	match callable_keyword_name(state):
		Some(id): Ok({ name = { id = id, span = parser_span(state) }, next = shifted(state, 1) })
		None: consume_name(state, message)


private fixed record BinderResult {
	binder: ParsedBinder,
	next: ParserState
}


-- `_` or a name (the host's binder_name).
private pure func consume_binder(state: ParserState, message: String) -> Result[BinderResult, Diagnostic]:
	if at_wildcard(state):
		Ok({ binder = DiscardBinder(parser_span(state)), next = shifted(state, 1) })
	else:
		match consume_name(state, message):
			Ok(name): Ok({ binder = NamedBinder(name.name), next = name.next })
			Err(error): Err(error)


private fixed record NameList {
	names: List[WrittenName],
	next: ParserState
}


-- The digits read so far and their negated value.
private fixed record DigitScan {
	position: Int,
	value: Int
}


private pure func invalid_integer(span: Span) -> Diagnostic:
	diagnostic(span, "invalid integer literal", "write decimal digits, optionally preceded by an adjacent '-'")


private pure func decimal_digit(byte: Int) -> Option[Int]:
	if and(byte.greater_than_or_equal(ZERO_BYTE), byte.less_than_or_equal(NINE_BYTE)):
		Some(byte.subtract(ZERO_BYTE))
	else:
		None


private pure func hexadecimal_digit(byte: Int) -> Option[Int]:
	if and(byte.greater_than_or_equal(LOWER_A_BYTE), byte.less_than_or_equal(LOWER_F_BYTE)):
		Some(DECIMAL_RADIX.add(byte.subtract(LOWER_A_BYTE)))
	else if and(byte.greater_than_or_equal(UPPER_A_BYTE), byte.less_than_or_equal(UPPER_F_BYTE)):
		Some(DECIMAL_RADIX.add(byte.subtract(UPPER_A_BYTE)))
	else:
		decimal_digit(byte)


-- Accumulates negatively against `limit`, checking before multiplication, so
-- the minimum needs no overflowing positive magnitude.
private pure func accumulate_digit(spelling: String, span: Span, limit: Int, scan: DigitScan) -> Result[DigitScan, Diagnostic]:
	shifted_value = scan.value.multiply(DECIMAL_RADIX)

	possible_digit = match spelling.byte_at(scan.position):
		Some(byte): decimal_digit(byte)
		None: None
	match possible_digit:
		None:
			Err(invalid_integer(span))
		Some(digit):
			if (
				or(
					scan.value.less_than(limit.divide(DECIMAL_RADIX)),
					shifted_value.less_than(limit.add(digit)),
				)
			):
				Err(diagnostic(span, "integer literal is outside the Int64 range", "use a value from -9223372036854775808 to 9223372036854775807"))
			else:
				Ok({ position = scan.position.add(1), value = shifted_value.subtract(digit) })


private pure func integer_value(spelling: String, span: Span) -> Result[Int, Diagnostic]:
	negative: Bool = byte_is(spelling, 0, MINUS_BYTE)
	digit_start: Int = if negative:
		1
	else:
		0

	if digit_start == spelling.length():
		Err(invalid_integer(span))
	else if and(digit_start.add(1).less_than(spelling.length()), byte_is(spelling, digit_start, ZERO_BYTE)):
		Err(diagnostic(span, "integer literals cannot have leading zeros", "write 0 or -0, or remove the leading zeros"))
	else:
		limit: Int = if negative:
			INT_MIN
		else:
			0.subtract(INT_MAX)
		-- One Result carries the digits to the end of the spelling or to the first error.
		var scan: Result[DigitScan, Diagnostic] = Ok({ position = digit_start, value = 0 })

		while True:
			match scan:
				Ok(digits):
					if digits.position == spelling.length():
						break

					scan = accumulate_digit(spelling, span, limit, digits)
				Err(_):
					break

		match scan:
			Ok(digits):

				if negative:
					Ok(digits.value)
				else:
					Ok(0.subtract(digits.value))
			Err(error): Err(error)


private pure func float_value(spelling: String, span: Span) -> Result[Float, Diagnostic]:
	start = if byte_is(spelling, 0, MINUS_BYTE):
		1
	else:
		0

	-- Only forged zero-only Float spellings treat an absent second byte as a digit.
	leading_zero: Bool = if byte_is(spelling, start, ZERO_BYTE):
		match spelling.byte_at(start.add(1)):
			Some(byte):
				match decimal_digit(byte):
					Some(_): True
					None: False
			None: True
	else:
		False
	if leading_zero:
		Err(diagnostic(span, "Float literals cannot have leading zeros", "write 0.5 or remove the leading zeros from the integer part"))
	else:
		match spelling.parse_float():
			Some(value):
				if value.is_finite():
					Ok(value)
				else:
					Err(diagnostic(span, "Float literal is outside the finite Float64 range", "use a smaller magnitude or exponent; infinities are produced by arithmetic, not literals"))
			None:
				Err(diagnostic(span, "invalid decimal Float literal", "write a decimal Float such as 1.0, 0.5 or 1e2"))


-- Offsets are within the actual contents, including an interpolated segment.
private pure func string_error(span: Span, start: Int, end: Int, message: String, help: String) -> Diagnostic:
	diagnostic({ span | start = span.start.add(start), end = span.start.add(end) }, message, help)


-- The lexer has validated UTF-8; this only finds one scalar's byte extent for
-- diagnostics, without decoding or validating its contents again.
private pure func character_end(raw: String, start: Int) -> Int:
	var end = start.add(1).min(raw.length())

	while and(end.less_than(raw.length()), is_continuation_byte(raw, end)):
		end = end.add(1)

	end


private pure func is_continuation_byte(raw: String, position: Int) -> Bool:
	match raw.byte_at(position):
		Some(byte):
			and(byte.greater_than_or_equal(UTF8_CONTINUATION_START), byte.less_than_or_equal(UTF8_CONTINUATION_END))
		None:
			False


private fixed record DecodedEscape {
	bytes: String,
	next: Int
}


-- The hexadecimal digits read so far: the scan stops at a non-digit or once
-- it has read one digit more than an escape allows.
private fixed record HexDigits {
	end: Int,
	scalar: Int
}


private pure func hex_digits(raw: String, start: Int, read: HexDigits) -> HexDigits:
	possible_digit = match raw.byte_at(read.end):
		Some(byte): hexadecimal_digit(byte)
		None: None
	if read.end.subtract(start).greater_than(MAX_UNICODE_HEX_DIGITS):
		read
	else:
		match possible_digit:
			Some(digit):
				hex_digits(raw, start, { end = read.end.add(1), scalar = read.scalar.multiply(HEX_RADIX).add(digit) })
			None:
				read


-- `start` is the backslash of a \u{H} escape.
private pure func unicode_escape(raw: String, start: Int, span: Span) -> Result[DecodedEscape, Diagnostic]:
	opening = start.add(2)
	opened = byte_is(raw, opening, OPEN_BRACE_BYTE)
	digits_start = opening.add(1)
	digits = hex_digits(raw, digits_start, { end = digits_start, scalar = 0 })
	count = digits.end.subtract(digits_start)
	encoded = if opened.and(raw.byte_is(digits.end, CLOSE_BRACE_BYTE)).and(count.greater_than(0)).and(
		count.less_than_or_equal(MAX_UNICODE_HEX_DIGITS)
	):
		from_codepoint(digits.scalar)
	else:
		None

	match encoded:
		Some(bytes):
			Ok({ bytes = bytes, next = digits.end.add(1) })
		None:
			error_end = if opened:
				digits.end.min(digits_start.add(MAX_UNICODE_HEX_DIGITS))
			else:
				opening
			Err(string_error(span, start, character_end(raw, error_end), "invalid Unicode escape", UNICODE_ESCAPE_HELP))


private pure func fixed_escape(code: Int) -> Option[String]:
	if code == LOWER_N_BYTE:
		Some("\n")
	else if code == LOWER_R_BYTE:
		Some("\r")
	else if code == LOWER_T_BYTE:
		Some("\t")
	else if code == ZERO_BYTE:
		Some("\0")
	else if code == BACKSLASH_BYTE:
		Some("\\")
	else if code == DOUBLE_QUOTE_BYTE:
		Some("\"")
	else if code == SINGLE_QUOTE_BYTE:
		Some("'")
	else if code == OPEN_BRACE_BYTE:
		Some("{")
	else if code == CLOSE_BRACE_BYTE:
		Some("}")
	else:
		None


-- `start` is the escape's backslash.
private pure func decode_escape(raw: String, start: Int, span: Span) -> Result[DecodedEscape, Diagnostic]:
	code = raw.byte_at(start.add(1))
	is_unicode = match code:
		Some(byte): byte == LOWER_U_BYTE
		None: False
	if is_unicode:
		unicode_escape(raw, start, span)
	else:
		escaped = match code:
			Some(byte): fixed_escape(byte)
			None: None
		match escaped:
			Some(bytes):
				Ok({ bytes = bytes, next = start.add(2) })
			None:
				Err(string_error(span, start, character_end(raw, start.add(1)), "unknown String escape", STRING_ESCAPE_HELP))


-- Bytes are compared by code: a one-byte substring would allocate a String.
-- False past the end of `raw`.
private pure func byte_is(raw: String, position: Int, expected: Int) -> Bool:
	match raw.byte_at(position):
		Some(byte):
			byte == expected
		None:
			False


-- The next backslash or the end of a lexer-delimited text segment.
private pure func escape_start(raw: String, start: Int) -> Int:
	var position = start

	while and(position.less_than(raw.length()), byte_is(raw, position, BACKSLASH_BYTE).not()):
		position = position.add(1)

	position


-- Each raw run between escapes and each decoded escape is one piece, joined
-- once at the end. UTF-8 source bytes are never reconstructed as characters
-- or normalized.
private pure func string_value(raw: String, span: Span) -> Result[String, Diagnostic]:
	var pieces: List[String] = []
	var cursor = 0
	var failure: Option[Diagnostic] = None

	while failure.is_none():
		stop = escape_start(raw, cursor)
		-- cursor is zero or a decoded escape end; stop is ASCII backslash or
		-- raw end. Validated source UTF-8 puts both on scalar boundaries.
		pieces = pieces.append(raw.slice(cursor, stop).get_or(""))

		if stop == raw.length():
			break

		match decode_escape(raw, stop, span):
			Ok(decoded):
				pieces = pieces.append(decoded.bytes)
				cursor = decoded.next
			Err(error):
				failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(pieces.join(""))


-- How a value's syntax ended: inline, so a Newline must follow it, or with
-- a control form's block or a method chain's last line, whose Dedent has
-- already ended the line.
private fixed union ValueEnding:
	InlineEnding
	BlockEnding


-- `owed` counts the Indents a method chain inside the value still owns
-- (host 4.2): their Dedents follow the value's line end and belong to the
-- enclosing statement (host D4), so `end_value` consumes them.
private fixed record ParsedValue {
	body: ValueExpression,
	next: ParserState,
	ending: ValueEnding,
	owed: Int
}


private pure func inline(value: ParsedValue) -> Bool:
	match value.ending:
		InlineEnding:
			True
		BlockEnding:
			False


-- Ends a value's line: at its Newline, or already at its block's Dedent.
-- Inside brackets, a closing bracket here is on a block's last line, which
-- the host rejects (4.9): the block must end before its bracket closes.
private pure func end_value(value: ParsedValue, message: String, help: String) -> Result[ParserState, Diagnostic]:
	match value.ending:
		BlockEnding:
			consume_owed_dedents(value.next, value.owed)
		InlineEnding:
			if and(bracketed(value.next), at_closing_bracket(value.next)):
				Err(expected_syntax(value.next, "a block inside brackets must end before the closing bracket", "put the closing bracket on its own line, at or below the indentation of the line that opened the block"))
			else:
				match consume_line_end(value.next, message, help):
					Ok(ended): consume_owed_dedents(ended, value.owed)
					Err(error): Err(error)


-- The Dedents closing a method chain's levels after the value's line end.
private pure func consume_owed_dedents(state: ParserState, owed: Int) -> Result[ParserState, Diagnostic]:
	if owed == 0:
		Ok(state)
	else:
		match expect(state, at_dedent(state), "expected the method chain's deeper lines to end", "dedent back to the statement's own indentation after the chain"):
			Ok(closed): consume_owed_dedents(closed, owed.subtract(1))
			Err(error): Err(error)


-- An `if`, `while`, `for` or `match` header's value. An indented method
-- chain there would still own its Indent when the header's `:` opens the
-- block, leaving its Dedent inside the block; the host rejects it too.
private pure func consume_header_value(state: ParserState) -> Result[ParsedValue, Diagnostic]:
	value ?= consume_value(state)

	if value.owed == 0:
		Ok(value)
	else:
		Err(expected_syntax(value.next, "a method chain in a block header must end on its line", "bind the chained value before the header, then use the binding"))


-- An expression's base before its postfix operations.
private fixed record ParsedBase {
	base: ExpressionBase,
	span: Span,
	next: ParserState
}


private fixed record ParsedValues {
	values: List[ValueExpression],
	next: ParserState
}


private pure func consume_argument_list(state: ParserState, arguments: List[ValueExpression]) -> Result[ParsedValues, Diagnostic]:
	value ?= consume_value(state)
	gathered = arguments.append(value.body)

	match list_separator(value.next):
		ListContinues(next):
			consume_argument_list(next, gathered)
		ListEnds(next):
			Ok({ values = gathered, next = next })


-- `end` is where the closing parenthesis ends.
private fixed record ParsedArguments {
	arguments: List[ValueExpression],
	end: Int,
	next: ParserState
}


-- `state` is at the opening parenthesis.
private pure func consume_call_arguments(state: ParserState) -> Result[ParsedArguments, Diagnostic]:
	opened = with_enclosure(shifted(state, 1), Bracketed)
	listed: ParsedValues ?= if at_right_paren(opened):
		Ok({ values = [], next = opened })
	else:
		consume_argument_list(opened, [])
	closed ?= expect(
		listed.next,
		at_right_paren(listed.next),
		"expected ')' after the call arguments",
		"separate complete expressions with commas, then close the call with ')'",
	)
	Ok({ arguments = listed.values, end = parser_span(listed.next).end, next = with_enclosure(closed, state.enclosure) })


-- Whether the import block declared `id` as a module alias.
private pure func is_module_alias(state: ParserState, id: NameId) -> Bool:
	var found: Bool = False

	for candidate in state.aliases:
		if same_name(candidate, id):
			found = True
			break

	found


-- `Alias.name` and `Alias.name(arguments)` where Alias is a declared module
-- alias; `module` is the alias just consumed.
private pure func consume_qualified(module: ParsedName) -> Result[ParsedBase, Diagnostic]:
	member ?= consume_callable_name(shifted(module.next, 1), "expected a name after the module alias and '.'")
	qualified: ParsedQualified = { module = module.name, name = member.name }

	if at_left_paren(member.next):
		match consume_call_arguments(member.next):
			Ok(call): Ok({ base = QualifiedApplication(qualified, call.arguments), span = { module.name.span | end = call.end }, next = call.next })
			Err(error): Err(error)
	else:
		Ok({ base = QualifiedName(qualified), span = { module.name.span | end = member.name.span.end }, next = member.next })


private pure func consume_name_or_call(start: ParserState) -> Result[ParsedBase, Diagnostic]:
	name ?= consume_callable_name(start, "expected a value name")
	after_dot = shifted(name.next, 1)

	if at_left_paren(name.next):
		match consume_call_arguments(name.next):
			Ok(call): Ok({ base = DirectApplication(name.name, call.arguments), span = { name.name.span | end = call.end }, next = call.next })
			Err(error): Err(error)
	else:
		qualified_alias = match at_dot(name.next):
			True:
				match or(at_identifier(after_dot), callable_keyword_name(after_dot).is_some()):
					True: is_module_alias(start, name.name.id)
					False: False
			False: False

		if qualified_alias:
			consume_qualified(name)
		else:
			Ok({ base = NameExpression(name.name), span = name.name.span, next = name.next })


private fixed record StringTextPiece {
	bytes: String,
	span: Span
}


-- Decode against each physical span first, then publish one literal per
-- contiguous text run, including a pipe run's joining LFs.
private pure func append_string_text(parts: List[ValueExpression], pieces: List[StringTextPiece]) -> List[ValueExpression]:
	match pieces.get(0):
		None: parts
		Some(first):
			var bytes: List[String] = []
			var last = first.span
			for piece in pieces:
				bytes = bytes.append(piece.bytes)
				last = piece.span
			span = { first.span | end = last.end }
			parts.append({ base = StringExpression(bytes.join("")), base_span = span, applications = [], span = span })


-- Parts are flat and already located: no reparsing, fake declaration or
-- synthetic callable name is needed to parse a hole in its lexical scope.
private pure func consume_interpolated(start: ParserState, opening: Span, form: StringForm) -> Result[ParsedBase, Diagnostic]:
	var parts: List[ValueExpression] = []
	var text: List[StringTextPiece] = []
	var scan: Result[ParserState, Diagnostic] = Ok(shifted(start, 1))
	var end = opening.end
	while True:
		match scan:
			Err(_): break
			Ok(current):
				match current_token(current):
					Some(token):
						match token.kind:
							StringEnd:
								parts = append_string_text(parts, text)
								end = token.span.end
								scan = Ok(shifted(current, 1))
								break
							StringSegment(raw):
								decoded = match form:
									QuotedStringForm: string_value(raw, token.span)
									PipeStringForm: Ok(raw)
								scan = match decoded:
									Err(error): Err(error)
									Ok(bytes):
										if bytes.length().greater_than(0):
											text = text.append({ bytes = bytes, span = token.span })
										Ok(shifted(current, 1))
							InterpolationOpen:
								parts = append_string_text(parts, text)
								text = []
								scan = match consume_value(shifted(current, 1)):
									Err(error): Err(error)
									Ok(hole):
										match current_token(hole.next):
											Some(closing):
												match closing.kind:
													InterpolationClose:
														parts = parts.append(hole.body)
														Ok(shifted(hole.next, 1))
													_: Err(expected_syntax(hole.next, "an interpolation hole must hold exactly one expression", "remove extra tokens or bind the expression before the String"))
											None: Err(expected_syntax(hole.next, "expected '}' after the interpolation expression", "close each hole on the same line"))
							_: scan = Err(expected_syntax(current, "expected String text or an interpolation hole", "close the String after its text and holes"))
					None: scan = Err(expected_syntax(current, "unterminated interpolated String", "close the String after its text and holes"))
	next ?= scan
	Ok({ base = InterpolatedString(parts), span = { opening | end = end }, next = next })


private pure func consume_base(start: ParserState, token: Token) -> Result[ParsedBase, Diagnostic]:
	after = shifted(start, 1)

	match token.kind:
		SymbolToken(AtSign):
			Err(misplaced_annotation(start))
		KeywordToken(VoidKeyword):
			Ok({ base = VoidExpression, span = token.span, next = after })
		SymbolToken(Wildcard):
			Err(diagnostic(token.span, DISCARD_VALUE_MESSAGE, DISCARD_VALUE_HELP))
		-- `.5` teaches the Float form; any other leading dot (a UFCS call on
		-- its own line, say) is simply no expression, as in the host.
		SymbolToken(Dot):
			if at_integer_literal(after):
				Err(diagnostic({ token.span | end = parser_span(after).end }, "Float literals need digits before the decimal point", "write 0.5; a source Float literal needs an integer part"))
			else:
				Err(expected_syntax(start, "expected a return expression", EXPRESSION_HELP))
		SymbolToken(LeftBrace):
			consume_braced_record(after, token.span)
		SymbolToken(LeftBracket):
			consume_list_literal(after, token.span)
		FloatLiteral(spelling):
			match float_value(spelling, token.span):
				Ok(value): Ok({ base = FloatExpression(value), span = token.span, next = after })
				Err(error): Err(error)
		IntegerLiteral(spelling):
			match integer_value(spelling, token.span):
				Ok(value): Ok({ base = IntegerExpression(value), span = token.span, next = after })
				Err(error): Err(error)
		QuotedString(raw):
			match string_value(raw, { token.span | start = token.span.start.add(1), end = token.span.end.subtract(1) }):
				Ok(bytes): Ok({ base = StringExpression(bytes), span = token.span, next = after })
				Err(error): Err(error)
		PipeString(value):
			Ok({ base = StringExpression(value), span = token.span, next = after })
		StringStart(form):
			consume_interpolated(start, token.span, form)
		InterpolationClose:
			Err(diagnostic(token.span, "expected an expression in interpolation hole", "write one String expression between the hole's braces"))
		CharLiteral:
			Err(diagnostic(token.span, "Char literals are not supported yet", "use a one-character String literal such as \"a\""))
		IdentifierToken(_):
			consume_name_or_call(start)
		KeywordToken(AndKeyword) | KeywordToken(OrKeyword) | KeywordToken(NotKeyword):
			if at_left_paren(after):
				consume_name_or_call(start)
			else:
				Err(expected_syntax(start, "expected a return expression", EXPRESSION_HELP))
		KeywordToken(IntoOpaqueKeyword):
			consume_opaque_conversion(start, Wrapping)
		KeywordToken(FromOpaqueKeyword):
			consume_opaque_conversion(start, Unwrapping)
		KeywordToken(WhileKeyword):
			Err(statement_as_value(start, "`while` is a statement and has no value"))
		KeywordToken(ForKeyword):
			Err(statement_as_value(start, "`for` is a statement and has no value"))
		KeywordToken(BreakKeyword):
			Err(statement_as_value(start, "`break` is a statement and has no value"))
		KeywordToken(ContinueKeyword):
			Err(statement_as_value(start, "`continue` is a statement and has no value"))
		-- In any value position: a dangling `else` line, or `x = else`.
		KeywordToken(ElseKeyword):
			Err(expected_syntax(start, "`else` has no matching `if`", "write else on its own line at the indentation of its if, directly after the if branch; else is not a value"))
		_:
			Err(expected_syntax(start, "expected a return expression", EXPRESSION_HELP))


private OPAQUE_CONVERSION_HELP: String = "write into_opaque Name(value) or from_opaque Name(value) with one value"


-- The two conversion keywords: into_opaque wraps, from_opaque unwraps.
private fixed union OpaqueDirection:
	Wrapping
	Unwrapping


-- `state` is at the conversion keyword: `into_opaque Name(value)`.
private pure func consume_opaque_conversion(state: ParserState, direction: OpaqueDirection) -> Result[ParsedBase, Diagnostic]:
	keyword = parser_span(state)
	name ?= consume_name(shifted(state, 1), "expected an opaque type name")
	opened ?= expect(name.next, at_left_paren(name.next), "expected '(' after the opaque type name", OPAQUE_CONVERSION_HELP)
	value ?= consume_value(opened)
	closing = parser_span(value.next)
	closed ?= expect(value.next, at_right_paren(value.next), "expected ')' after the converted value", OPAQUE_CONVERSION_HELP)
	base: ExpressionBase = match direction:
		Wrapping:
			OpaqueWrap(name.name, value.body)
		Unwrapping:
			OpaqueUnwrap(name.name, value.body)
	Ok({ base = base, span = { keyword | end = closing.end }, next = closed })


private fixed record ParsedPostfix {
	operation: PostfixOperation,
	end: Int,
	next: ParserState
}


-- `state` follows the dot.
private pure func consume_postfix(state: ParserState) -> Result[ParsedPostfix, Diagnostic]:
	name ?= if at_left_paren(shifted(state, 1)):
		consume_callable_name(state, "expected a field or function name after '.'")
	else:
		consume_name(state, "expected a field or function name after '.'")

	if at_left_paren(name.next):
		match consume_call_arguments(name.next):
			Ok(call):
				Ok({
					operation = ReceiverInvocation({
						span = { name.name.span | end = call.end },
						callee = name.name,
						arguments = call.arguments,
					}),
					end = call.end,
					next = call.next,
				})
			Err(error): Err(error)
	else:
		Ok({ operation = FieldAccess(name.name), end = name.name.span.end, next = name.next })


-- `ending` is BlockEnding when an indented chain's Dedent ended the line;
-- `owed` counts the chain's Indents still open when the chain ended with
-- something other than a line break (host 4.2, leaked indentation).
private fixed record ParsedPostfixes {
	applications: List[PostfixOperation],
	end: Int,
	next: ParserState,
	ending: ValueEnding,
	owed: Int
}


-- `end` is where the last postfix operation, or else the base, ends.
private pure func consume_postfixes(state: ParserState, applications: List[PostfixOperation], end: Int) -> Result[ParsedPostfixes, Diagnostic]:
	consume_chain(state, applications, end, 0)


-- Index syntax is independent of the receiver's type. Check establishes the
-- tuple and literal ordinal once; no spelling distinguishes type arguments.
private pure func consume_tuple_index(state: ParserState) -> Result[ParsedPostfix, Diagnostic]:
	opened = with_enclosure(shifted(state, 1), Bracketed)
	index ?= consume_value(opened)
	closed ?= expect(index.next, at_right_bracket(index.next), "expected ']' after the tuple index", "write one integer literal index, such as value[0]")
	if at_left_paren(closed):
		Err(expected_syntax(state, "explicit function type arguments are unsupported", "omit the brackets at calls; argument types determine the type parameters"))
	else:
		span = { parser_span(state) | end = parser_span(index.next).end }
		Ok({ operation = TupleIndex(index.body, span), end = span.end, next = with_enclosure(closed, state.enclosure) })


-- The postfix loop with the host's method-chain continuation (4.2): a `.`
-- on the next line continues the chain, at the same indentation or one
-- Indent deeper, and the chain owns each Indent it takes (`owned`). A
-- Dedent, with or without a Newline before it, closes one owned level and
-- ends the chain when none remains. Inside an indented chain a line must
-- start with `.`. The chain ends with the line's Dedent already consumed,
-- or inline with its owned levels owed to the enclosing statement.
private pure func consume_chain(state: ParserState, applications: List[PostfixOperation], end: Int, owned: Int) -> Result[ParsedPostfixes, Diagnostic]:
	after_newline = shifted(state, 1)

	if at_symbol(state, Plus):
		Err(expected_syntax(state, "'+' is only supported between trait bounds", "use a named arithmetic function in expressions; write multiple bounds as T: First + Second"))
	else if at_left_bracket(state):
		match consume_tuple_index(state):
			Ok(postfix): consume_chain(postfix.next, applications.append(postfix.operation), postfix.end, owned)
			Err(error): Err(error)
	else if at_dot(state):
		match consume_postfix(shifted(state, 1)):
			Ok(postfix): consume_chain(postfix.next, applications.append(postfix.operation), postfix.end, owned)
			Err(error): Err(error)
	else if and(and(at_newline(state), at_indent(after_newline)), at_dot(shifted(state, 2))):
		consume_chain(shifted(state, 2), applications, end, owned.add(1))
	else if and(at_newline(state), at_dot(after_newline)):
		consume_chain(after_newline, applications, end, owned)
	else if and(owned.greater_than(0), at_dedent(state)):
		close_chain_level(after_newline, applications, end, owned)
	else if and(and(owned.greater_than(0), at_newline(state)), at_dedent(after_newline)):
		close_chain_level(shifted(state, 2), applications, end, owned)
	else if and(owned.greater_than(0), at_newline(state)):
		Err(expected_syntax(after_newline, "expected `.` to continue the method chain", "start the line with `.`, or move it out of the chain"))
	else:
		Ok({ applications = applications, end = end, next = state, ending = InlineEnding, owed = owned })


-- `state` follows the Dedent that closed one owned level.
private pure func close_chain_level(state: ParserState, applications: List[PostfixOperation], end: Int, owned: Int) -> Result[ParsedPostfixes, Diagnostic]:
	remaining = owned.subtract(1)

	if remaining == 0:
		Ok({ applications = applications, end = end, next = state, ending = BlockEnding, owed = 0 })
	else:
		consume_chain(state, applications, end, remaining)


-- Precedence, lowest first: `or`, `and`, `not`, comparison, `..`, then
-- postfix operations. `or` and `and` associate left. A `not` binds below a
-- range, so `not a..b` negates the range and `a..not b` needs parentheses.
private pure func consume_value(start: ParserState) -> Result[ParsedValue, Diagnostic]:
	first ?= consume_conjunction(start)
	consume_disjunction_rest(first)


private pure func consume_disjunction_rest(first: ParsedValue) -> Result[ParsedValue, Diagnostic]:
	consume_logical_rest(first, OrOperator, consume_conjunction)


private pure func consume_conjunction(start: ParserState) -> Result[ParsedValue, Diagnostic]:
	first ?= consume_negation(start)
	consume_conjunction_rest(first)


private pure func consume_conjunction_rest(first: ParsedValue) -> Result[ParsedValue, Diagnostic]:
	consume_logical_rest(first, AndOperator, consume_negation)


-- Left-associates `first op operand op operand ...` while each value ends
-- inline; `parse_operand` is the next-tighter level.
private pure func consume_logical_rest(
	first: ParsedValue,
	operator: LogicalOperator,
	parse_operand: pure (ParserState) -> Result[ParsedValue, Diagnostic],
) -> Result[ParsedValue, Diagnostic]:
	keyword: Keyword = match operator:
		AndOperator: AndKeyword
		OrOperator: OrKeyword
	-- A loop, not recursion, so a long chain uses constant stack.
	var current = first
	var failure: Option[Diagnostic] = None
	while and(and(inline(current), at_keyword(current.next, keyword)), failure.is_none()):
		match parse_operand(shifted(current.next, 1)):
			Err(error): failure = Some(error)
			Ok(right): current = logical(operator, current, right)
	match failure:
		Some(error): Err(error)
		None: Ok(current)


-- `left op right` as one value spanning both operands, with no postfix
-- operations of its own.
private pure func logical(operator: LogicalOperator, left: ParsedValue, right: ParsedValue) -> ParsedValue:
	span = { left.body.span | end = right.body.span.end }
	{ body = { base = LogicalExpression(operator, left.body, right.body), base_span = span, applications = [], span = span }, next = right.next, ending = right.ending, owed = left.owed.add(right.owed) }


private pure func consume_negation(start: ParserState) -> Result[ParsedValue, Diagnostic]:
	if or(at_not(start).not(), at_left_paren(shifted(start, 1))):
		consume_comparison(start)
	else:
		keyword = parser_span(start)
		match consume_negation(shifted(start, 1)):
			Ok(operand):
				span = { keyword | end = operand.body.span.end }
				Ok({ body = { base = NotExpression(operand.body), base_span = span, applications = [], span = span }, next = operand.next, ending = operand.ending, owed = operand.owed })
			Err(error): Err(error)


-- The six comparisons share one level and never chain with each other.
private pure func comparison_operator(state: ParserState) -> Option[ComparisonOperator]:
	match current_token(state):
		Some(token):
			match token.kind:
				SymbolToken(EqualsEquals): Some(EqualOperator)
				SymbolToken(NotEquals): Some(NotEqualOperator)
				SymbolToken(Less): Some(LessOperator)
				SymbolToken(Greater): Some(GreaterOperator)
				SymbolToken(LessEquals): Some(LessEqualOperator)
				SymbolToken(GreaterEquals): Some(GreaterEqualOperator)
				_: None
		None: None


-- Comparison owns only its token and operands; preserve the right operand's
-- layout ending and both operands' outstanding chain levels.
private pure func consume_comparison(start: ParserState) -> Result[ParsedValue, Diagnostic]:
	left ?= consume_range(start)
	consume_comparison_rest(left)


private pure func consume_comparison_rest(left: ParsedValue) -> Result[ParsedValue, Diagnostic]:
	match comparison_operator(left.next):
		Some(operator):
			if inline(left):
				consume_comparison_right(left, operator)
			else:
				Ok(left)
		None: Ok(left)


private pure func consume_comparison_right(left: ParsedValue, operator: ComparisonOperator) -> Result[ParsedValue, Diagnostic]:
	token = parser_span(left.next)
	after = shifted(left.next, 1)
	right: ParsedValue ?= if and(at_not(after), at_left_paren(shifted(after, 1)).not()):
		Err(expected_syntax(after, "'not' cannot be a comparison operand", "write (not value) in parentheses; not binds below comparison"))
	else:
		consume_range(after)
	if and(inline(right), comparison_operator(right.next).is_some()):
		Err(expected_syntax(right.next, "comparisons cannot be chained", "compare each pair separately, or parenthesize an intended nested comparison"))
	else:
		span = { left.body.span | end = right.body.span.end }
		Ok({ body = { base = ComparisonExpression(operator, token, left.body, right.body), base_span = span, applications = [], span = span }, next = right.next, ending = right.ending, owed = left.owed.add(right.owed) })

-- One operand, or `low..high`: two operands around '..'. A range has no
-- postfix operations of its own; group it to apply any.
private pure func consume_range(start: ParserState) -> Result[ParsedValue, Diagnostic]:
	low ?= consume_operand(start)
	consume_range_rest(low)


private pure func consume_range_rest(low: ParsedValue) -> Result[ParsedValue, Diagnostic]:

	if (and(inline(low), at_dot_dot(low.next))).not():
		Ok(low)
	else:
		after_dots = shifted(low.next, 1)
		high_result: Result[ParsedValue, Diagnostic] = if and(at_not(after_dots), at_left_paren(shifted(after_dots, 1)).not()):
			Err(expected_syntax(after_dots, "'not' cannot be an operand of '..'", "write (not value) in parentheses; not binds below a range"))
		else if or(or(at_newline(after_dots), at_closing_bracket(after_dots)), at_end(after_dots)):
			Err(expected_syntax(after_dots, "expected the range's end after '..'", "write low..high with a value on each side of '..'"))
		else:
			consume_operand(after_dots)
		match high_result:
			Ok(high):
				span = { low.body.span | end = high.body.span.end }
				Ok({ body = { base = RangeExpression(low.body, high.body), base_span = span, applications = [], span = span }, next = high.next, ending = high.ending, owed = low.owed.add(high.owed) })
			Err(error): Err(error)


-- A base and its postfix operations, or a control form, which takes none.
private pure func consume_operand(start: ParserState) -> Result[ParsedValue, Diagnostic]:
	_: Void ?= if and(at_import(start), at_colon(shifted(start, 1))):
		Err(expected_syntax(start, IMPORT_IN_BODY_MESSAGE, IMPORT_IN_BODY_HELP))
	else:
		Ok(void)
	match current_token(start):
		None:
			Err(expected_syntax(start, "expected a return expression", EXPRESSION_HELP))
		Some(token):
			match token.kind:
				SymbolToken(LeftParen):
					consume_grouped_value(start, token.span)
				KeywordToken(IfKeyword):
					resume_context(consume_if(as_value_position(start)), start.context)
				KeywordToken(MatchKeyword):
					resume_context(consume_match_value(as_value_position(start)), start.context)
				KeywordToken(FunctionKeyword):
					consume_lambda(start)
				KeywordToken(PureKeyword):
					consume_lambda(start)
				_:
					match consume_base(start, token):
						Ok(base):
							match consume_postfixes(base.next, [], base.span.end):
								Ok(postfixes):
									Ok({
										body = {
											base = base.base,
											base_span = base.span,
											applications = postfixes.applications,
											span = { token.span | end = postfixes.end }
										},
										next = postfixes.next,
										ending = postfixes.ending,
										owed = postfixes.owed,
									})
								Err(error): Err(error)
						Err(error): Err(error)


-- An `if` or `match` block starts a restricted function context while
-- preserving loop-control and lambda restrictions already in effect.
private pure func as_function_block(state: ParserState) -> ParserState:
	match state.context:
		FunctionBody:
			with_context(state, FunctionBlock)
		FunctionBlock | InsideLambda | LoopBody | ValueInLoop:
			state


-- An `if` or `match` operand is a value wherever its line stands: in a
-- loop its blocks admit no loop control (owner rule).
private pure func as_value_position(state: ParserState) -> ParserState:
	match state.context:
		LoopBody:
			with_context(state, ValueInLoop)
		FunctionBody | FunctionBlock | InsideLambda | ValueInLoop:
			state


-- The operand's caller's context returns once its value is read.
private pure func resume_context(parsed: Result[ParsedValue, Diagnostic], context: StatementContext) -> Result[ParsedValue, Diagnostic]:
	value ?= parsed
	Ok({ value | next = with_context(value.next, context) })


private KEYWORD_HELP: String = "a keyword is missing or misspelled: `in` follows a loop variable and `func` starts a lambda"


-- `start` is at `pure` or `func` in value position: `[pure] func(params)
-- [-> Type]:` then one expression on the same line or an indented block.
-- A lambda body starts a new statement context (host 5.3), in which `?=`
-- is rejected (owner rule). The lambda takes no postfix operations; an
-- inline body absorbs them as its own.
private pure func consume_lambda(start: ParserState) -> Result[ParsedValue, Diagnostic]:
	keyword = parser_span(start)
	purity: Purity = if at_pure(start):
		Pure
	else:
		Impure
	after_function ?= match purity:
		Pure:
			expect(shifted(start, 1), at_func(shifted(start, 1)), "expected `func` before lambda", KEYWORD_HELP)
		Impure:
			Ok(shifted(start, 1))
	opened ?= expect(after_function, at_left_paren(after_function), "expected `(` after lambda `func`", "write the parameters or arguments inside parentheses")
	parameters ?= consume_parenthesized_items(opened, [], consume_lambda_parameter)
	closed ?= expect(parameters.next, at_right_paren(parameters.next), "expected `)` after lambda parameters", "close the parenthesis opened earlier with `)`")
	returns ?= consume_optional_return_type(closed)
	colon ?= expect(returns.next, at_colon(returns.next), "expected `:` before lambda body", BLOCK_HEADER_HELP)
	body ?= consume_lambda_body(with_context(colon, InsideLambda))
	lambda: ParsedLambda = {
		purity = purity,
		parameters = parameters.items,
		return_type = returns.written,
		body = body.body,
		span = { keyword | end = body.end }
	}
	span = lambda.span
	Ok({
		body = { base = LambdaExpression(lambda), base_span = span, applications = [], span = span },
		next = with_context(body.next, start.context),
		ending = body.ending,
		owed = body.owed,
	})


private LAMBDA_PARAMETER_HELP: String = "write an identifier here; it starts with a letter or `_` and is not a reserved keyword"


-- A name or `_`, then an optional annotation.
private pure func consume_lambda_parameter(_count: Int, state: ParserState) -> Result[ParsedItem[LambdaParameter], Diagnostic]:
	binder ?= consume_lambda_binder(state)
	annotation ?= consume_optional_annotation(binder.next, "expected a parameter type")
	Ok({ item = { binder = binder.binder, annotation = annotation.written }, next = annotation.next })


-- A reserved word reports itself; any other non-name token gets the host's
-- lambda-parameter help.
private pure func consume_lambda_binder(state: ParserState) -> Result[BinderResult, Diagnostic]:
	if or(or(at_wildcard(state), at_identifier(state)), at_any_keyword(state)):
		consume_binder(state, "expected lambda parameter")
	else:
		Err(expected_syntax(state, "expected lambda parameter", LAMBDA_PARAMETER_HELP))


private fixed record OptionalReturnType {
	written: Option[TypeSyntax],
	next: ParserState
}


private pure func consume_optional_return_type(state: ParserState) -> Result[OptionalReturnType, Diagnostic]:
	if at_arrow(state).not():
		Ok({ written = None, next = state })
	else:
		match consume_type(shifted(state, 1), "expected a return type"):
			Ok(written): Ok({ written = Some(written.written), next = written.next })
			Err(error): Err(error)


private fixed record LambdaBodyResult {
	body: LambdaBody,
	end: Int,
	ending: ValueEnding,
	owed: Int,
	next: ParserState
}


-- `after_colon` follows the header's `:`: an indented block on the next
-- lines, or one expression on the same line.
private pure func consume_lambda_body(after_colon: ParserState) -> Result[LambdaBodyResult, Diagnostic]:
	if at_newline(after_colon):
		newline = shifted(after_colon, 1)
		match expect(newline, at_indent(newline), INDENTED_BLOCK_MESSAGE, INDENTED_BLOCK_HELP):
			Ok(first):
				match consume_block(first):
					Ok(block): Ok({ body = BlockBody(block.block), end = block.block.span.end, ending = BlockEnding, owed = 0, next = block.next })
					Err(error): Err(error)
			Err(error): Err(error)
	else:
		match consume_value(after_colon):
			Ok(value): Ok({ body = InlineBody(value.body), end = value.body.span.end, ending = value.ending, owed = value.owed, next = value.next })
			Err(error): Err(error)


-- `start` is at `if`: the condition, `:` and an indented block, then an
-- optional `else:` block or `else if` chain. A control form ends its
-- expression at its last block's Dedent: no postfix operation, operator or
-- range continues it, and its line needs no Newline of its own.
private pure func consume_if(start: ParserState) -> Result[ParsedValue, Diagnostic]:
	parsed ?= consume_if_form(start)
	span = parsed.form.span
	Ok({ body = { base = IfExpression(parsed.form), base_span = span, applications = [], span = span }, next = parsed.next, ending = BlockEnding, owed = 0 })


private fixed record IfResult {
	form: ParsedIf,
	next: ParserState
}


private pure func consume_if_form(start: ParserState) -> Result[IfResult, Diagnostic]:
	keyword = parser_span(start)
	condition ?= consume_header_value(shifted(start, 1))
	then_block ?= consume_header_block(as_function_block(condition.next), "expected `:` after if condition")
	otherwise ?= consume_else_branch(then_block.next)
	end = match otherwise.branch:
		None:
			then_block.block.span.end
		Some(ElseIf(nested)):
			nested.span.end
		Some(ElseBlock(block)):
			block.span.end
	Ok({
		form = { condition = condition.body, then_block = then_block.block, else_branch = otherwise.branch, span = { keyword | end = end } },
		next = with_context(otherwise.next, start.context),
	})


private fixed record ElseResult {
	branch: Option[ElseBranch],
	next: ParserState
}


-- Nothing, `else:` with a block, or `else if`, which nests the next if-form.
private pure func consume_else_branch(state: ParserState) -> Result[ElseResult, Diagnostic]:
	if at_keyword(state, ElseKeyword).not():
		Ok({ branch = None, next = state })
	else if at_if(shifted(state, 1)):
		match consume_if_form(shifted(state, 1)):
			Ok(nested): Ok({ branch = Some(ElseIf(nested.form)), next = nested.next })
			Err(error): Err(error)
	else:
		match consume_header_block(shifted(state, 1), "expected `:` after else"):
			Ok(block): Ok({ branch = Some(ElseBlock(block.block)), next = block.next })
			Err(error): Err(error)


private INDENTED_BLOCK_MESSAGE: String = "expected an indented block"

private INDENTED_BLOCK_HELP: String = "indent the lines of the block under its header"

private BLOCK_HEADER_HELP: String = "a block header ends with `:` before its indented body, as in `if condition:` or `func name() -> Type:`"


-- `:` Newline Indent after a block header, in the host's words; `next`
-- is the block's first token.
private pure func consume_block_header(state: ParserState, colon_message: String, newline_message: String) -> Result[ParserState, Diagnostic]:
	newline ?= expect(state, at_colon(state), colon_message, BLOCK_HEADER_HELP)
	opened ?= expect(newline, at_newline(newline), newline_message, "start the next statement or item on its own line")
	expect(opened, at_indent(opened), INDENTED_BLOCK_MESSAGE, INDENTED_BLOCK_HELP)


private pure func consume_header_block(state: ParserState, colon_message: String) -> Result[BlockResult, Diagnostic]:
	first ?= consume_block_header(state, colon_message, "expected newline before indented block")
	consume_block(first)


-- `start` follows the opening bracket: zero or more comma-separated
-- elements, then ']'.
private pure func consume_list_literal(start: ParserState, opening: Span) -> Result[ParsedBase, Diagnostic]:
	inside = with_enclosure(start, Bracketed)
	listed: ParsedValues ?= if at_right_bracket(inside):
		Ok({ values = [], next = inside })
	else:
		consume_argument_list(inside, [])
	closed ?= expect(
		listed.next,
		at_right_bracket(listed.next),
		"expected ']' after the list elements",
		"separate elements with commas, then close the list with ']'",
	)
	Ok({ base = ListExpression(listed.values), span = { opening | end = parser_span(listed.next).end }, next = with_enclosure(closed, start.enclosure) })


private TUPLE_MINIMUM_ELEMENTS: Int = 2

private TUPLE_MAXIMUM_ELEMENTS: Int = 4

private TUPLE_SIZE_HELP: String = "nest tuples or use a named record for more fields"

private FLAT_TUPLE_MESSAGE: String = "tuple destructuring requires flat names or '_'"

private FLAT_TUPLE_HELP: String = "bind a nested tuple to a name, then destructure it separately"

private TUPLE_BINDER_ANNOTATION_MESSAGE: String = "tuple destructuring names cannot have type annotations"

private TUPLE_BINDER_ANNOTATION_HELP: String = "annotate the tuple value before destructuring it"


-- Preserve a bare binder at its syntactic boundary. A leading parenthesized
-- line is parsed once, then '=' distinguishes declaration from expression.
-- This avoids rescanning tokens or recovering binders from expression shapes.
private fixed union EnclosedMember:
	BareMember(ParsedBinder)
	ValueMember(ValueExpression)


private pure func enclosed_value(member: EnclosedMember) -> Result[ValueExpression, Diagnostic]:
	match member:
		BareMember(NamedBinder(name)):
			Ok({ base = NameExpression(name), base_span = name.span, applications = [], span = name.span })
		BareMember(DiscardBinder(span)): Err(diagnostic(span, DISCARD_VALUE_MESSAGE, DISCARD_VALUE_HELP))
		ValueMember(value): Ok(value)


private pure func consume_enclosed_member(state: ParserState) -> Result[ParsedItem[EnclosedMember], Diagnostic]:
	after = shifted(state, 1)
	bare = and(or(at_identifier(state), at_wildcard(state)), or(at_comma(after), at_right_paren(after)))
	if and(or(at_identifier(state), at_wildcard(state)), at_colon(after)):
		Err(expected_syntax(after, TUPLE_BINDER_ANNOTATION_MESSAGE, TUPLE_BINDER_ANNOTATION_HELP))
	else if bare:
		consume_bare_member(state)
	else:
		match consume_value(state):
			Ok(value): Ok({ item = ValueMember(value.body), next = value.next })
			Err(error): Err(error)


private pure func consume_bare_member(state: ParserState) -> Result[ParsedItem[EnclosedMember], Diagnostic]:
	binder ?= consume_binder(state, "expected a tuple element")
	Ok({ item = BareMember(binder.binder), next = binder.next })


private fixed union EnclosedContents:
	GroupedContents(ValueExpression)
	TupleContents(List[EnclosedMember])


private fixed record ParsedEnclosed {
	contents: EnclosedContents,
	span: Span,
	next: ParserState
}


-- `start` is at '('. Commas select a tuple; without one the group remains
-- transparent, including the inner expression's existing postfix operations.
private pure func consume_enclosed_values(start: ParserState, opening: Span) -> Result[ParsedEnclosed, Diagnostic]:
	first ?= consume_enclosed_member(with_enclosure(shifted(start, 1), Bracketed))
	if at_comma(first.next).not():
		match expect(first.next, at_right_paren(first.next), "expected ')' after the grouped expression", "close the parentheses after one expression; UFCS and field reads may follow ')'"):
			Ok(closed):
				match enclosed_value(first.item):
					Err(error): Err(error)
					Ok(value): Ok({ contents = GroupedContents(value), span = { opening | end = parser_span(first.next).end }, next = with_enclosure(closed, start.enclosure) })
			Err(error): Err(error)
	else:
		consume_tuple_values(start, opening, first)


private pure func consume_tuple_values(start: ParserState, opening: Span, first: ParsedItem[EnclosedMember]) -> Result[ParsedEnclosed, Diagnostic]:
	listed ?= consume_parenthesized_items(shifted(first.next, 1), [first.item], consume_tuple_element)
	closed ?= expect(listed.next, at_right_paren(listed.next), "expected ')' after the tuple elements", "separate complete expressions with commas, then close the tuple with ')'")
	span = { opening | end = parser_span(listed.next).end }
	if listed.items.length().less_than(TUPLE_MINIMUM_ELEMENTS):
		Err(diagnostic(span, "a tuple requires two to four elements", "write the value itself for one element, or [value] for a one-element List"))
	else:
		Ok({ contents = TupleContents(listed.items), span = span, next = with_enclosure(closed, start.enclosure) })


private pure func consume_tuple_element(count: Int, state: ParserState) -> Result[ParsedItem[EnclosedMember], Diagnostic]:
	member ?= consume_enclosed_member(state)
	if count == TUPLE_MAXIMUM_ELEMENTS:
		span = match member.item:
			BareMember(NamedBinder(name)): name.span
			BareMember(DiscardBinder(span)): span
			ValueMember(value): value.span
		Err(diagnostic(span, "tuples support two to four elements", TUPLE_SIZE_HELP))
	else:
		Ok(member)


private pure func finish_enclosed_value(enclosed: ParsedEnclosed) -> Result[ParsedValue, Diagnostic]:
	inner: ValueExpression ?= match enclosed.contents:
		GroupedContents(value): Ok(value)
		TupleContents(members):
			var values: List[ValueExpression] = []
			var failure: Option[Diagnostic] = None
			for member in members:
				match enclosed_value(member):
					Ok(value): values = values.append(value)
					Err(error):
						failure = Some(error)
						break
			match failure:
				Some(error): Err(error)
				None: Ok({ base = TupleExpression(values), base_span = enclosed.span, applications = [], span = enclosed.span })
	postfixes ?= consume_postfixes(enclosed.next, inner.applications, enclosed.span.end)
	Ok({
		body = { base = inner.base, base_span = inner.base_span, applications = postfixes.applications, span = { enclosed.span | end = postfixes.end } },
		next = postfixes.next, ending = postfixes.ending, owed = postfixes.owed,
	})


private pure func consume_grouped_value(start: ParserState, opening: Span) -> Result[ParsedValue, Diagnostic]:
	enclosed ?= consume_enclosed_values(start, opening)
	finish_enclosed_value(enclosed)


private fixed record ParsedType {
	written: TypeSyntax,
	next: ParserState
}


private fixed record ParsedTypes {
	types: List[TypeSyntax],
	next: ParserState
}


private pure func consume_types(state: ParserState, types: List[TypeSyntax], message: String) -> Result[ParsedTypes, Diagnostic]:
	argument ?= consume_type(state, message)
	gathered = types.append(argument.written)

	match list_separator(argument.next):
		ListContinues(next):
			consume_types(next, gathered, message)
		ListEnds(next):
			Ok({ types = gathered, next = next })


-- The bracketed type arguments after a type name at `state`, or none;
-- `end` is where the closing bracket ends, or `name_end` without brackets.
private fixed record ParsedTypeArguments {
	types: List[TypeSyntax],
	end: Int,
	next: ParserState
}


private pure func consume_optional_type_arguments(state: ParserState, name_end: Int) -> Result[ParsedTypeArguments, Diagnostic]:
	if at_left_bracket(state).not():
		Ok({ types = [], end = name_end, next = state })
	else:
		match consume_types(shifted(state, 1), [], "expected a type argument"):
			Ok(arguments):
				match expect(
					arguments.next,
					at_right_bracket(arguments.next),
					"expected ']' after the type arguments",
					"write comma-separated type arguments, such as Result[Box[Int], Int]",
				):
					Ok(closed): Ok({ types = arguments.types, end = parser_span(arguments.next).end, next = closed })
					Err(error): Err(error)
			Err(error): Err(error)


private fixed union EnclosedTypeMode:
	PureCallable
	TupleOrCallable


private fixed union EnclosedTypes:
	UnseparatedType(TypeSyntax, ParserState)
	SeparatedTypes(List[TypeSyntax], ParserState)


private pure func consume_first_enclosed_type(state: ParserState) -> Result[EnclosedTypes, Diagnostic]:
	first ?= consume_type(state, "expected an enclosed type")
	if at_comma(first.next).not():
		Ok(UnseparatedType(first.written, first.next))
	else:
		match list_separator(first.next):
			ListEnds(next): Ok(SeparatedTypes([first.written], next))
			ListContinues(next):
				match consume_types(next, [first.written], "expected an enclosed type"):
					Ok(types): Ok(SeparatedTypes(types.types, types.next))
					Err(error): Err(error)


-- Read the enclosed types once before classifying the closing arrow. Callable
-- parameter lists have no tuple arity limit; result types associate right.
private pure func consume_enclosed_type(state: ParserState, mode: EnclosedTypeMode, opened_at: ParserState) -> Result[ParsedType, Diagnostic]:
	parenthesized ?= expect(
		opened_at,
		at_left_paren(opened_at),
		"expected '(' at the start of a callable type",
		"write a callback type as pure (Int, String) -> Int",
	)
	opened = with_enclosure(parenthesized, Bracketed)
	members: EnclosedTypes ?= if at_right_paren(opened):
		Ok(SeparatedTypes([], opened))
	else:
		consume_first_enclosed_type(opened)
	parameters: ParsedTypes = match members:
		UnseparatedType(only, next): { types = [only], next = next }
		SeparatedTypes(types, next): { types = types, next = next }
	closing_message = match mode:
		PureCallable: "expected ')' after the callback parameter types"
		TupleOrCallable: "expected ')' after the enclosed types"
	closing_help = match mode:
		PureCallable: "write parameter types separated by commas, then ')' and '-> ReturnType'"
		TupleOrCallable: "separate complete types with commas, then close the parentheses with ')'"
	closed ?= expect(
		parameters.next,
		at_right_paren(parameters.next),
		closing_message,
		closing_help,
	)
	after = with_enclosure(closed, state.enclosure)
	required: Bool = match mode:
		PureCallable: True
		TupleOrCallable: False
	if or(required, at_arrow(after)):
		consume_callable_result(state, mode, parameters.types, after)
	else:
		span = { parser_span(state) | end = parser_span(parameters.next).end }
		match members:
			UnseparatedType(only, _): Ok({ written = only, next = after })
			SeparatedTypes(types, _):
				if types.length().less_than(TUPLE_MINIMUM_ELEMENTS):
					Err(diagnostic(span, "a tuple type requires two to four elements", "write the type itself for one element, or List[Type] for a List type"))
				else:
					match types.get(TUPLE_MAXIMUM_ELEMENTS):
						Some(fifth): Err(diagnostic(type_span(fifth), "tuple types support two to four elements", "nest tuple types or use a named record for more fields"))
						None: Ok({ written = TupleTypeSyntax(types, span), next = after })


private pure func consume_callable_result(state: ParserState, mode: EnclosedTypeMode, parameters: List[TypeSyntax], after: ParserState) -> Result[ParsedType, Diagnostic]:
	arrow ?= expect(after, at_arrow(after), "expected '->' after the callback parameter types", "write a callback type as pure (Int, String) -> Int")
	returned ?= consume_type(arrow, "expected a callback return type after '->'")
	span = { parser_span(state) | end = type_span(returned.written).end }
	purity: Purity = match mode:
		PureCallable: Pure
		TupleOrCallable: Impure
	Ok({ written = CallableTypeSyntax(purity, parameters, returned.written, span), next = returned.next })


-- A dot in a named type can only qualify, so no alias set is consulted here.
private pure func consume_named_type(state: ParserState, message: String) -> Result[ParsedType, Diagnostic]:
	name ?= consume_name(state, message)

	if at_dot(name.next):
		match consume_name(shifted(name.next, 1), "expected a type name after the module alias and '.'"):
			Ok(member):
				match consume_optional_type_arguments(member.next, member.name.span.end):
					Ok(arguments):
						span = { name.name.span | end = arguments.end }
						Ok({ written = QualifiedType({ module = name.name, name = member.name }, arguments.types, span), next = arguments.next })
					Err(error): Err(error)
			Err(error): Err(error)
	else if at_left_bracket(name.next).not():
		Ok({ written = AtomicType(name.name), next = name.next })
	else:
		match consume_optional_type_arguments(name.next, name.name.span.end):
			Ok(arguments):
				span = { name.name.span | end = arguments.end }
				Ok({ written = AppliedType(name.name, arguments.types, span), next = arguments.next })
			Err(error): Err(error)


private pure func consume_type(state: ParserState, message: String) -> Result[ParsedType, Diagnostic]:
	if at_pure(state):
		consume_enclosed_type(state, PureCallable, shifted(state, 1))
	else if at_left_paren(state):
		consume_enclosed_type(state, TupleOrCallable, state)
	else:
		consume_named_type(state, message)


private fixed record ParameterResult {
	parameter: ParsedParameter,
	next: ParserState
}


private pure func consume_parameter(state: ParserState, message: String) -> Result[ParameterResult, Diagnostic]:
	name ?= consume_name(state, message)
	after_colon ?= expect(name.next, at_colon(name.next), "expected ':' after the parameter name", "write each parameter as name: Type")
	type_name ?= consume_type(after_colon, "expected a parameter type")
	Ok({ parameter = { name = name.name, type_name = type_name.written }, next = type_name.next })


private fixed record ParsedParameters {
	parameters: List[ParsedParameter],
	next: ParserState
}


-- Parses `name: Type { , name: Type }` for function parameters and record fields.
private pure func consume_parameter_list(
	state: ParserState,
	message: String,
	parameters: List[ParsedParameter],
) -> Result[ParsedParameters, Diagnostic]:
	parameter ?= consume_parameter(state, message)
	gathered = parameters.append(parameter.parameter)

	match list_separator(parameter.next):
		ListContinues(next):
			consume_parameter_list(next, message, gathered)
		ListEnds(next):
			Ok({ parameters = gathered, next = next })


private pure func consume_parameters(start: ParserState) -> Result[ParsedParameters, Diagnostic]:
	listed: ParsedParameters ?= if at_right_paren(start):
		empty: ParsedParameters = { parameters = [], next = start }
		Ok(empty)
	else:
		consume_parameter_list(start, "expected a parameter name or ')'", [])
	closed ?= expect(listed.next, at_right_paren(listed.next), "expected ')' after the parameters", "separate explicitly typed parameters with commas, then close with ')'")
	Ok({ listed | next = closed })


private fixed record PatternResult {
	pattern: ParsedPattern,
	span: Span,
	next: ParserState
}


-- The fields of a constructor pattern, each a pattern; `end` is where the
-- closing parenthesis ends.
private fixed record PatternFields {
	fields: List[ParsedPattern],
	end: Int,
	next: ParserState
}


-- `state` follows the opening parenthesis.
private pure func consume_pattern_fields(state: ParserState) -> Result[PatternFields, Diagnostic]:
	listed ?= consume_parenthesized_items(state, [], consume_pattern_field)
	closed ?= expect(listed.next, at_right_paren(listed.next), "expected ')' after the constructor pattern", "write one pattern per field, such as Pair(left, _)")
	Ok({ fields = listed.items, end = parser_span(listed.next).end, next = closed })


private pure func consume_pattern_field(_count: Int, state: ParserState) -> Result[ParsedItem[ParsedPattern], Diagnostic]:
	field ?= consume_pattern(state)
	Ok({ item = field.pattern, next = field.next })


-- `opening` is at the '(' after a bare or qualified head; the pattern spans
-- from `start`, the head's first byte, to the closing parenthesis.
private pure func consume_constructor_pattern(opening: ParserState, start: Span, head: PatternHead) -> Result[PatternResult, Diagnostic]:
	fields ?= consume_pattern_fields(shifted(opening, 1))
	span = { start | end = fields.end }
	Ok({ pattern = PatternConstructor(head, fields.fields, span), span = span, next = fields.next })


-- The spread ending a list pattern: `...rest` or `..._`, after its '...'.
private fixed record ParsedSpread {
	target: SpreadTarget,
	next: ParserState
}


private pure func consume_spread(state: ParserState) -> Result[ParsedSpread, Diagnostic]:
	if at_wildcard(state):
		Ok({ target = SpreadWildcard(parser_span(state)), next = shifted(state, 1) })
	else:
		match consume_name(state, "expected a name or '_' after '...'"):
			Ok(name): Ok({ target = SpreadName(name.name), next = name.next })
			Err(error): Err(error)


-- `[]`, `[...rest]`, `[a, b]` or `[a, b, ...rest]`; as in the host, a list
-- pattern takes no trailing comma. `start` follows the opening bracket.
private pure func consume_list_pattern(start: ParserState, opening: Span) -> Result[PatternResult, Diagnostic]:
	var current = start
	var elements: List[ParsedPattern] = []
	var spread: Option[SpreadTarget] = None
	var failure: Option[Diagnostic] = None

	while and(at_right_bracket(current).not(), failure.is_none()):
		if at_symbol(current, Ellipsis):
			match consume_spread(shifted(current, 1)):
				Err(error):
					failure = Some(error)
				Ok(rest):
					spread = Some(rest.target)
					current = rest.next

					if at_right_bracket(current).not():
						failure = Some(expected_syntax(current, "expected ']' after the list rest pattern", "write the rest pattern last, such as [first, ...rest]"))
		else:
			match consume_pattern(current):
				Err(error):
					failure = Some(error)
				Ok(element):
					elements = elements.append(element.pattern)
					current = element.next

					if at_comma(current):
						current = shifted(current, 1)

						if at_right_bracket(current):
							failure = Some(expected_syntax(current, "expected a pattern or '...' after ','", "list patterns take no trailing comma"))
					else if at_right_bracket(current).not():
						failure = Some(expected_syntax(current, "expected ']' after the list pattern", "separate element patterns with commas; '...rest' may end the list"))

	_: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	span = { opening | end = parser_span(current).end }
	Ok({ pattern = PatternList(elements, spread, span), span = span, next = shifted(current, 1) })


private pure func consume_tuple_pattern(start: ParserState, opening: Span) -> Result[PatternResult, Diagnostic]:
	listed ?= consume_parenthesized_items(start, [], consume_tuple_pattern_field)
	closed ?= expect(listed.next, at_right_paren(listed.next), "expected ')' after the tuple pattern", "separate two to four patterns with commas, such as (first, _)")
	span = { opening | end = parser_span(listed.next).end }
	if listed.items.length().less_than(TUPLE_MINIMUM_ELEMENTS):
		Err(diagnostic(span, "a tuple pattern requires two to four elements", "write two to four comma-separated patterns, such as (first, _)"))
	else:
		Ok({ pattern = PatternTuple(listed.items, span), span = span, next = closed })


private pure func consume_tuple_pattern_field(count: Int, state: ParserState) -> Result[ParsedItem[ParsedPattern], Diagnostic]:
	field ?= consume_pattern(state)
	if count == TUPLE_MAXIMUM_ELEMENTS:
		Err(diagnostic(field.span, "tuple patterns support two to four elements", TUPLE_SIZE_HELP))
	else:
		Ok({ item = field.pattern, next = field.next })


-- A String or Char literal token at `state` as a pattern, or None when
-- the token is not a literal. A String pattern's escapes decode as in a
-- String expression.
private pure func literal_pattern(state: ParserState) -> Option[Result[PatternResult, Diagnostic]]:
	match current_token(state):
		Some(token):
			match token.kind:
				QuotedString(raw):
					decoded: Result[PatternResult, Diagnostic] = match string_value(raw, { token.span | start = token.span.start.add(1), end = token.span.end.subtract(1) }):
						Ok(bytes):
							Ok({ pattern = PatternString(bytes, token.span), span = token.span, next = shifted(state, 1) })
						Err(error):
							Err(error)
					Some(decoded)
				CharLiteral:
					Some(Ok({ pattern = PatternChar(token.span), span = token.span, next = shifted(state, 1) }))
				StringStart(_):
					Some(Err(diagnostic(token.span, "interpolated Strings are not patterns", "use a literal String pattern, or bind the String and compare it in the arm")))
				_:
					None
		None:
			None


-- One alternative of a pattern: no '|' is read here.
private pure func consume_alternative(state: ParserState, message: String) -> Result[PatternResult, Diagnostic]:
	if at_wildcard(state):
		Ok({ pattern = PatternWildcard(parser_span(state)), span = parser_span(state), next = shifted(state, 1) })
	else if at_left_bracket(state):
		consume_list_pattern(shifted(state, 1), parser_span(state))
	else if at_left_paren(state):
		consume_tuple_pattern(shifted(state, 1), parser_span(state))
	else:
		match literal_pattern(state):
			Some(literal):
				literal
			None:
				consume_named_alternative(state, message)


-- A name, `Name(fields)`, or `Module.Name[(fields)]`: a dot in a pattern can
-- only qualify, so no alias set is consulted, as in a type. A qualified head
-- without fields is still a constructor pattern.
private pure func consume_named_alternative(state: ParserState, message: String) -> Result[PatternResult, Diagnostic]:
	name ?= consume_name(state, message)

	if at_dot(name.next):
		match consume_name(shifted(name.next, 1), "expected a constructor name after the module alias and '.'"):
			Ok(member):
				head: PatternHead = QualifiedHead({ module = name.name, name = member.name })

				if at_left_paren(member.next):
					consume_constructor_pattern(member.next, name.name.span, head)
				else:
					span = { name.name.span | end = member.name.span.end }
					Ok({ pattern = PatternConstructor(head, [], span), span = span, next = member.next })
			Err(error): Err(error)
	else if at_left_paren(name.next):
		consume_constructor_pattern(name.next, name.name.span, BareHead(name.name))
	else:
		Ok({ pattern = PatternName(name.name), span = name.name.span, next = name.next })


-- A pattern is one alternative, or several separated by '|', which span
-- from the first to the last.
private pure func consume_pattern(state: ParserState) -> Result[PatternResult, Diagnostic]:
	first ?= consume_alternative(state, "expected a match pattern")

	if at_bar(first.next).not():
		Ok(first)
	else:
		var alternatives: List[ParsedPattern] = [first.pattern]
		var current = first.next
		var end = first.span.end
		var failure: Option[Diagnostic] = None

		while at_bar(current):
			match consume_alternative(shifted(current, 1), "expected a pattern after '|'"):
				Err(error):
					failure = Some(error)
					break
				Ok(alternative):
					alternatives = alternatives.append(alternative.pattern)
					current = alternative.next
					end = alternative.span.end

		match failure:
			Some(error): Err(error)
			None:
				span = { first.span | end = end }
				Ok({ pattern = PatternOr(alternatives, span), span = span, next = current })


private fixed record BodyResult {
	body: ParsedBody,
	next: ParserState
}


-- One code line of a statement block, after its Newline.
private fixed union BlockLine:
	StatementLine(ParsedStatement, ParserState)
	FinalLine(ValueExpression, ParserState)


-- What one code line holds before its line end is read: a statement
-- (binding, propagation, loop or loop control), which has consumed its own
-- line end, or a value still to be ended.
private fixed union LineForm:
	StatementForm(ParsedStatement, ParserState)
	ValueForm(ParsedValue)


-- A binding line: `var`, a name/discard followed by '=', '?=' or
-- ':', or a keyword followed by '=' or '?=' so that `in = 1` reports the
-- reserved word rather than a missing expression. `else:` is a block
-- header, not a binding.
private pure func at_binding(state: ParserState) -> Bool:
	or(
		or(
			at_var(state),
			(and(or(at_identifier(state), at_wildcard(state)), (or(at_assignment(shifted(state, 1)), at_colon(shifted(state, 1)))))),
		),
		(and(at_any_keyword(state), at_assignment(shifted(state, 1)))),
	)


private pure func at_assignment(state: ParserState) -> Bool:
	or(at_equals(state), at_question_equals(state))


-- Token identity alone classifies reserved words; spelling is diagnostic data.
private pure func at_any_keyword(state: ParserState) -> Bool:
	current_keyword(state).is_some()


-- The operator a binding's value follows: '=' or '?='.
private fixed union BindingOperator:
	Assign
	Propagate


-- The value after the operator and the end of its line: on the same line,
-- or alone on an indented next line, whose Dedent closes it. `next` follows
-- the line end.
private pure func consume_initializer(equals: ParserState, operator: BindingOperator, line_message: String, line_help: String) -> Result[ParsedValue, Diagnostic]:
	if at_newline(equals).not():
		consume_inline_initializer(equals, line_message, line_help)
	else:
		consume_indented_initializer(shifted(equals, 1), operator)


private pure func consume_inline_initializer(state: ParserState, line_message: String, line_help: String) -> Result[ParsedValue, Diagnostic]:
	value ?= consume_value(state)
	next ?= end_value(value, line_message, line_help)
	Ok({ value | next = next })


-- The messages are in the words of the binding's operator.
private pure func consume_indented_initializer(state: ParserState, operator: BindingOperator) -> Result[ParsedValue, Diagnostic]:
	spelling = match operator:
		Assign: "="
		Propagate: "?="
	one_expression = "expected one expression after '${spelling}'"
	help = "put the value on the same line as '${spelling}', or alone on the next line indented one level"
	opened ?= expect(state, at_indent(state), "expected an indented value after '${spelling}'", help)
	value ?= consume_value(opened)
	ended ?= end_value(value, one_expression, help)
	closed ?= expect(ended, at_dedent(ended), one_expression, help)
	Ok({ value | next = closed })


private BINDING_LINE_MESSAGE: String = "expected a newline after the binding"

private BINDING_LINE_HELP: String = "put each statement on its own line"


private pure func consume_binding(state: ParserState) -> Result[LineForm, Diagnostic]:
	mutable = at_var(state)
	after_keyword = if mutable:
		shifted(state, 1)
	else:
		state
	target: BinderResult ?= if at_left_paren(after_keyword):
		Err(expected_syntax(after_keyword, "tuple destructuring declares immutable names", "omit var before the tuple target; declare individual mutable bindings separately if needed"))
	else:
		if mutable:
			match consume_name(after_keyword, "expected a binding name"):
				Ok(name): Ok({ binder = NamedBinder(name.name), next = name.next })
				Err(error): Err(error)
		else:
			consume_binder(after_keyword, "expected a binding name")
	annotation ?= consume_optional_annotation(target.next, "expected the binding's type after ':'")
	binder_span = match target.binder:
		NamedBinder(name): name.span
		DiscardBinder(span): span

	-- Only an immutable binder propagates; `var` keeps the plain binding form.
	propagating = and(not(mutable), at_question_equals(annotation.next))

	if propagating:
		match state.context:
			FunctionBody:
				match consume_initializer(shifted(annotation.next, 1), Propagate, BINDING_LINE_MESSAGE, BINDING_LINE_HELP):
					Ok(value):
						propagation: ParsedPropagation = { binder = target.binder, annotation = annotation.written, value = value.body, span = { binder_span | end = value.body.span.end } }
						Ok(StatementForm(PropagatingBinding(propagation), value.next))
					Err(error): Err(error)
			InsideLambda:
				Err(expected_syntax(annotation.next, "`?=` cannot be used inside a lambda body", "match on the Result or Option inside the lambda, or bind the value before the lambda"))
			FunctionBlock:
				Err(expected_syntax(annotation.next, "`?=` cannot be used inside an `if` or `match` block", "match on the Result or Option in place, or move the block into its own function and use `?=` at its top"))
			LoopBody | ValueInLoop:
				Err(expected_syntax(annotation.next, "`?=` cannot be used inside a loop body", "bind it before the loop, or use `match` inside the loop"))
	else:
		match target.binder:
			DiscardBinder(_): Err(expected_syntax(after_keyword, "discard binding requires '?='", "write _ ?= expression to propagate and discard a Result payload"))
			NamedBinder(name):
				match expect(annotation.next, at_equals(annotation.next), "expected '=' after the binding name", "write name = expression or var name = expression; a propagating binding is name ?= expression"):
					Ok(equals):
						match consume_initializer(equals, Assign, BINDING_LINE_MESSAGE, BINDING_LINE_HELP):
							Ok(initializer):
								binding: ParsedBinding = { name = name, annotation = annotation.written, mutable = mutable, initializer = initializer.body }
								Ok(StatementForm(BindingStatement(binding), initializer.next))
							Err(error): Err(error)
					Err(error): Err(error)


private pure func tuple_declaration_binders(enclosed: ParsedEnclosed) -> Result[List[ParsedBinder], Diagnostic]:
	match enclosed.contents:
		GroupedContents(_):
			Err(diagnostic(enclosed.span, "tuple destructuring requires two to four names", "write two to four comma-separated names or '_', such as (first, _) = value"))
		TupleContents(members):
			var binders: List[ParsedBinder] = []
			var failure: Option[Diagnostic] = None
			for member in members:
				match member:
					BareMember(binder): binders = binders.append(binder)
					ValueMember(value):
						failure = Some(diagnostic(value.span, FLAT_TUPLE_MESSAGE, FLAT_TUPLE_HELP))
						break
			match failure:
				Some(error): Err(error)
				None: Ok(binders)


private pure func consume_tuple_binding(enclosed: ParsedEnclosed) -> Result[LineForm, Diagnostic]:
	binders ?= tuple_declaration_binders(enclosed)
	equals ?= expect(enclosed.next, at_equals(enclosed.next), "tuple destructuring requires '='", "propagate into a name first, then destructure the result")
	initializer ?= consume_initializer(equals, Assign, BINDING_LINE_MESSAGE, BINDING_LINE_HELP)
	Ok(StatementForm(TupleBinding(binders, initializer.body, enclosed.span), initializer.next))


-- A line beginning with '(' shares the ordinary expression parser's rest
-- functions after classification, so ranges and logical operators still parse.
private pure func consume_parenthesized_line(state: ParserState) -> Result[LineForm, Diagnostic]:
	enclosed ?= consume_enclosed_values(state, parser_span(state))
	if at_assignment(enclosed.next):
		consume_tuple_binding(enclosed)
	else:
		consume_parenthesized_line_value(enclosed)


private pure func consume_parenthesized_line_value(enclosed: ParsedEnclosed) -> Result[LineForm, Diagnostic]:
	operand ?= finish_enclosed_value(enclosed)
	range ?= consume_range_rest(operand)
	comparison ?= consume_comparison_rest(range)
	conjunction ?= consume_conjunction_rest(comparison)
	value ?= consume_disjunction_rest(conjunction)
	value_line_form(value)


private pure func value_line_form(value: ParsedValue) -> Result[LineForm, Diagnostic]:
	var indexed: Bool = False
	for application in value.body.applications:
		match application:
			TupleIndex(_, _): indexed = True
			ReceiverInvocation(_) | FieldAccess(_): void
	if and(indexed, at_assignment(value.next)):
		Err(expected_syntax(value.next, "tuple elements cannot be assigned", "construct a new tuple and bind it to a name instead"))
	else:
		Ok(ValueForm(value))


private fixed record OptionalAnnotation {
	written: Option[TypeSyntax],
	next: ParserState
}


-- `: Type` after a binding or lambda parameter name, or nothing.
private pure func consume_optional_annotation(state: ParserState, message: String) -> Result[OptionalAnnotation, Diagnostic]:
	if at_colon(state).not():
		Ok({ written = None, next = state })
	else:
		match consume_type(shifted(state, 1), message):
			Ok(written): Ok({ written = Some(written.written), next = written.next })
			Err(error): Err(error)


-- A value line ends its block when the block's Dedent follows it. An
-- `import:` line is tested first so that it teaches where imports go rather
-- than reporting `import` as a reserved binding name.
private pure func consume_block_line(state: ParserState) -> Result[BlockLine, Diagnostic]:
	form ?= consume_line_form(state)

	match form:
		StatementForm(statement, next):
			Ok(StatementLine(statement, next))
		ValueForm(value):
			match end_value(value, VALUE_LINE_MESSAGE, VALUE_LINE_HELP):
				Ok(next):

					if at_dedent(next):
						Ok(FinalLine(value.body, shifted(next, 1)))
					else:
						Ok(StatementLine(ExpressionStatement(value.body), next))
				Err(error): Err(error)


-- The statement or value a code line starts with. A line-leading `if` or
-- `match` preserves statement loop-control permissions and bypasses
-- consume_value, where an `if` or `match` operand is a value.
private pure func consume_line_form(state: ParserState) -> Result[LineForm, Diagnostic]:
	if and(at_import(state), at_colon(shifted(state, 1))):
		Err(expected_syntax(state, IMPORT_IN_BODY_MESSAGE, IMPORT_IN_BODY_HELP))
	else if and(at_wildcard(state), at_equals(shifted(state, 1))):
		Err(expected_syntax(state, "expected a return expression", EXPRESSION_HELP))
	else if at_binding(state):
		consume_binding(state)
	else if at_left_paren(state):
		consume_parenthesized_line(state)
	else if at_keyword(state, WhileKeyword):
		consume_while(state)
	else if at_for(state):
		consume_for(state)
	else:
		match at_loop_control(state):
			Some(control):
				consume_loop_control(state, control)
			None:
				value_result: Result[ParsedValue, Diagnostic] = if at_if(state):
					consume_if(state)
				else if at_keyword(state, MatchKeyword):
					consume_match_value(state)
				else:
					consume_value(state)
				match value_result:
					Ok(value): value_line_form(value)
					Err(error): Err(error)


-- `state` is at `while`: the condition, then a body read as a loop body.
-- The loop's context ends with its block.
private pure func consume_while(state: ParserState) -> Result[LineForm, Diagnostic]:
	keyword = parser_span(state)
	condition ?= consume_header_value(shifted(state, 1))
	body ?= consume_header_block(with_context(condition.next, LoopBody), "expected `:` after while condition")
	loop: ParsedWhile = { condition = condition.body, body = body.block, span = { keyword | end = body.block.span.end } }
	Ok(StatementForm(WhileLoop(loop), with_context(body.next, state.context)))


-- `state` is at `for`: `for name in iterable:` or `for _ in iterable:`,
-- and a loop body.
private pure func consume_for(state: ParserState) -> Result[LineForm, Diagnostic]:
	keyword = parser_span(state)
	binder ?= consume_for_binder(shifted(state, 1))
	in_word ?= expect(binder.next, at_keyword(binder.next, InKeyword), "expected `in` after for loop variable", KEYWORD_HELP)
	iterable ?= consume_header_value(in_word)
	body ?= consume_header_block(with_context(iterable.next, LoopBody), "expected `:` after for loop iterable")
	loop: ParsedFor = { binder = binder.binder, iterable = iterable.body, body = body.block, span = { keyword | end = body.block.span.end } }
	Ok(StatementForm(ForLoop(loop), with_context(body.next, state.context)))


private fixed record ForBinderResult {
	binder: ForBinder,
	next: ParserState
}


private pure func consume_for_binder(state: ParserState) -> Result[ForBinderResult, Diagnostic]:
	if at_left_paren(state):
		consume_tuple_for_binder(state)
	else:
		match consume_binder(state, "expected a loop variable after `for`"):
			Ok(binder): Ok({ binder = SingleForBinder(binder.binder), next = binder.next })
			Err(error): Err(error)


private pure func consume_tuple_for_binder(state: ParserState) -> Result[ForBinderResult, Diagnostic]:
	listed ?= consume_parenthesized_items(shifted(state, 1), [], consume_tuple_binder)
	closed ?= expect(listed.next, at_right_paren(listed.next), FLAT_TUPLE_MESSAGE, FLAT_TUPLE_HELP)
	span = { parser_span(state) | end = parser_span(listed.next).end }
	if listed.items.length().less_than(TUPLE_MINIMUM_ELEMENTS):
		Err(diagnostic(span, "tuple destructuring requires two to four names", "write two to four comma-separated names or '_', such as (first, _)"))
	else:
		Ok({ binder = TupleForBinder(listed.items, span), next = closed })


private pure func consume_tuple_binder(count: Int, state: ParserState) -> Result[ParsedItem[ParsedBinder], Diagnostic]:
	if at_left_paren(state):
		Err(expected_syntax(state, FLAT_TUPLE_MESSAGE, FLAT_TUPLE_HELP))
	else:
		match consume_binder(state, FLAT_TUPLE_MESSAGE):
			Err(error): Err(error)
			Ok(binder):
				if at_colon(binder.next):
					Err(expected_syntax(binder.next, TUPLE_BINDER_ANNOTATION_MESSAGE, TUPLE_BINDER_ANNOTATION_HELP))
				else if count == TUPLE_MAXIMUM_ELEMENTS:
					Err(expected_syntax(state, "tuple binders support two to four elements", TUPLE_SIZE_HELP))
				else:
					Ok({ item = binder.binder, next = binder.next })


-- `state` is at `break` or `continue`: a statement of its own line, valid
-- only in a loop body (host 5.3) and never in an `if` or `match` used as a
-- value within the loop (owner rule).
private pure func consume_loop_control(state: ParserState, control: LoopControl) -> Result[LineForm, Diagnostic]:
	keyword = parser_span(state)
	word = match control:
		BreakControl: "break"
		ContinueControl: "continue"
	_: Void ?= match state.context:
		LoopBody:
			Ok(void)
		FunctionBody | FunctionBlock | InsideLambda:
			Err(expected_syntax(state, "`${word}` can only be used inside a loop", "move `${word}` into a `while` or `for` body, or remove it"))
		ValueInLoop:
			Err(expected_syntax(state, "`${word}` cannot be used inside an `if` or `match` used as a value", "write the `if` or `match` as a statement on its own line, or move `${word}` out of it"))
	next ?= consume_line_end(shifted(state, 1), "expected a newline after `${word}`", "put `${word}` on a line of its own")
	statement: ParsedStatement = match control:
		BreakControl:
			Break(keyword)
		ContinueControl:
			Continue(keyword)
	Ok(StatementForm(statement, next))


private fixed record BlockResult {
	block: ParsedBlock,
	next: ParserState
}


-- Where a statement's syntax ends.
private pure func statement_end(statement: ParsedStatement) -> Int:
	match statement:
		BindingStatement(binding):
			binding.initializer.span.end
		TupleBinding(_, initializer, _):
			initializer.span.end
		PropagatingBinding(propagation):
			propagation.value.span.end
		ExpressionStatement(value):
			value.span.end
		WhileLoop(loop):
			loop.span.end
		ForLoop(loop):
			loop.span.end
		Break(span):
			span.end
		Continue(span):
			span.end


-- The lines of an indented block, after its Indent, in one loop: statement
-- lines accumulate; the block's value is its last line when that line is an
-- expression, and a block ending after a statement has none. Whether a
-- valueless block is allowed where it stands is the checker's decision.
private pure func consume_block(opened: ParserState) -> Result[BlockResult, Diagnostic]:
	first = parser_span(opened)
	var statements: List[ParsedStatement] = []
	-- One Result carries each consumed line, or the first error.
	var line: Result[BlockLine, Diagnostic] = consume_block_line(opened)

	while True:
		match line:
			Ok(StatementLine(statement, next)):
				statements = statements.append(statement)

				if at_dedent(next):
					break

				line = consume_block_line(next)
			_:
				break

	ended ?= line

	match ended:
		FinalLine(value, next):
			Ok({ block = { statements = statements, value = Some(value), span = { first | end = value.span.end } }, next = next })
		StatementLine(statement, next):
			Ok({ block = { statements = statements, value = None, span = { first | end = statement_end(statement) } }, next = shifted(next, 1) })


private fixed record ArmResult {
	arm: ParsedMatchArm,
	next: ParserState
}


-- `colon` follows the pattern: an indented block, or one inline line that
-- is a value or a statement (host case_body: a match case is the one place
-- a statement may share the line with its header). A statement arm's block
-- holds that statement and no value.
private pure func consume_arm_result(colon: ParserState) -> Result[BlockResult, Diagnostic]:
	if at_newline(colon):
		newline = shifted(colon, 1)
		match expect(newline, at_indent(newline), "expected an indented match arm result", "put the arm's statements and final value on lines indented deeper than its pattern"):
			Ok(opened): consume_block(opened)
			Err(error): Err(error)
	else:
		match consume_line_form(colon):
			Ok(form):

				match form:
					StatementForm(statement, next):
						first = parser_span(colon)
						Ok({ block = { statements = [statement], value = None, span = { first | end = statement_end(statement) } }, next = next })
					ValueForm(value):
						match end_value(value, VALUE_LINE_MESSAGE, VALUE_LINE_HELP):
							Ok(next): Ok({ block = { statements = [], value = Some(value.body), span = value.body.span }, next = next })
							Err(error): Err(error)
			Err(error): Err(error)


private pure func consume_arm(state: ParserState) -> Result[ArmResult, Diagnostic]:
	pattern ?= consume_pattern(state)
	colon ?= expect(pattern.next, at_colon(pattern.next), "expected ':' after the match pattern", "write Pattern: expression, or put the arm body on the next indented line")
	block ?= consume_arm_result(colon)
	Ok({
		arm = {
			pattern = pattern.pattern,
			block = block.block,
			span = { pattern.span | end = block.block.span.end }
		},
		next = block.next,
	})


-- `end` is where the last arm ends.
private fixed record ParsedArms {
	arms: List[ParsedMatchArm],
	end: Int,
	next: ParserState
}


private pure func consume_arms(state: ParserState, arms: List[ParsedMatchArm]) -> Result[ParsedArms, Diagnostic]:
	arm ?= consume_arm(state)
	gathered = arms.append(arm.arm)

	if at_dedent(arm.next):
		Ok({ arms = gathered, end = arm.arm.span.end, next = shifted(arm.next, 1) })
	else:
		consume_arms(arm.next, gathered)


-- A match anywhere but a function's tail: one value, ending at its last
-- arm's Dedent like an if-expression.
private pure func consume_match_value(start: ParserState) -> Result[ParsedValue, Diagnostic]:
	parsed ?= consume_match_form(start)
	Ok({ body = match_expression(parsed.form), next = parsed.next, ending = BlockEnding, owed = 0 })


-- The match as one value with no postfix operations.
private pure func match_expression(form: ParsedMatch) -> ValueExpression:
	{ base = MatchExpression(form), base_span = form.span, applications = [], span = form.span }


private fixed record MatchResult {
	form: ParsedMatch,
	next: ParserState
}


-- `start` is at `match`: the scrutinee, `:` and the indented arms.
private pure func consume_match_form(start: ParserState) -> Result[MatchResult, Diagnostic]:
	keyword = parser_span(start)
	after_keyword = shifted(start, 1)
	_: Void ?= if at_spaced_token(after_keyword):
		Ok(void)
	else:
		Err(expected_syntax(after_keyword, "expected a space after 'match'", "put a space between 'match' and the matched expression"))
	scrutinee ?= consume_header_value(after_keyword)
	opened ?= consume_block_header(scrutinee.next, "expected `:` after match expression", "expected newline before match cases")
	arms ?= consume_arms(as_function_block(opened), [])
	Ok({
		form = {
			scrutinee = scrutinee.body,
			arms = arms.arms,
			keyword_span = keyword,
			span = { keyword | end = arms.end }
		},
		next = with_context(arms.next, start.context),
	})


private BUILTIN_LABEL_HELP: String = "use int.equals, int.less_than, int.add, int.subtract, int.multiply, int.divide, int.remainder, int.to_string, float.add, float.subtract, float.multiply, float.divide, float.remainder, float.to_string, float.copysign, float.equals, float.less_than, float.is_nan, float.is_finite, string.length, string.add, string.append_int, string.print, string.print_error, string.parse_int, string.parse_float, string.byte_at, string.from_codepoint, string.slice, system.get_current_directory, system.read_file, system.write_file, process.run_to_files, string.equals, list.repeat, list.length, list.get, list.append, list.set or list.concat"


private pure func primitive_operation(label: String) -> Option[ParsedRuntimeOperation]:
	match label:
		"string.print":
			Some(StringPrintBuiltin)
		"string.print_error":
			Some(StringPrintErrorBuiltin)
		"int.add":
			Some(IntegerAddBuiltin)
		"int.subtract":
			Some(IntegerSubtractBuiltin)
		"int.multiply":
			Some(IntegerMultiplyBuiltin)
		"int.divide":
			Some(IntegerDivideBuiltin)
		"int.remainder":
			Some(IntegerRemainderBuiltin)
		"int.to_string":
			Some(IntegerToStringBuiltin)
		"float.add":
			Some(FloatAddBuiltin)
		"float.subtract":
			Some(FloatSubtractBuiltin)
		"float.multiply":
			Some(FloatMultiplyBuiltin)
		"float.divide":
			Some(FloatDivideBuiltin)
		"float.remainder":
			Some(FloatRemainderBuiltin)
		"float.to_string":
			Some(FloatToStringBuiltin)
		"float.copysign":
			Some(FloatCopySignBuiltin)
		"float.equals":
			Some(FloatEqualsBuiltin)
		"float.less_than":
			Some(FloatLessThanBuiltin)
		"float.is_nan":
			Some(FloatIsNaNBuiltin)
		"float.is_finite":
			Some(FloatIsFiniteBuiltin)
		"list.repeat":
			Some(ListRepeatBuiltin)
		"list.length":
			Some(ListLengthBuiltin)
		"list.append":
			Some(ListAppendBuiltin)
		"list.set":
			Some(ListSetBuiltin)
		"list.concat":
			Some(ListConcatBuiltin)
		"string.length":
			Some(StringLengthBuiltin)
		"string.add":
			Some(StringConcatBuiltin)
		"string.append_int":
			Some(StringAppendIntBuiltin)
		"string.parse_int":
			Some(StringParseIntBuiltin)
		"string.parse_float":
			Some(StringParseFloatBuiltin)
		"string.byte_at":
			Some(StringByteAtBuiltin)
		"string.from_codepoint":
			Some(StringFromCodepointBuiltin)
		"string.slice":
			Some(StringSliceBuiltin)
		"system.read_file":
			Some(ReadFileBuiltin)
		"system.write_file":
			Some(WriteFileBuiltin)
		"process.run_to_files":
			Some(RunToFilesBuiltin)
		"system.get_current_directory":
			Some(GetCurrentDirectoryBuiltin)
		"list.get":
			Some(ListGetBuiltin)
		"int.equals":
			Some(IntegerEqualsBuiltin)
		"int.less_than":
			Some(IntegerLessThanBuiltin)
		"string.equals":
			Some(StringEqualsBuiltin)
		_:
			None


private fixed record BuiltinOperationResult {
	operation: ParsedRuntimeOperation,
	next: ParserState
}


private pure func consume_builtin_operation(opened: ParserState, label: String) -> Result[BuiltinOperationResult, Diagnostic]:
	match primitive_operation(label):
		Some(primitive):
			Ok({ operation = primitive, next = shifted(opened, 1) })
		None:
			Err(expected_syntax(opened, "unknown builtin operation", BUILTIN_LABEL_HELP))


private pure func consume_builtin_body(start: ParserState) -> Result[BodyResult, Diagnostic]:
	after_builtin ?= expect(start, at_builtin(start), "expected 'builtin'", DECLARATION_WORD_HELP)
	opened ?= expect(after_builtin, at_left_paren(after_builtin), "expected '(' after builtin", "write builtin(\"int.add\") with one quoted operation label")
	operation ?= match current_token(opened):
		Some(label):
			match label.kind:
				QuotedString(spelling):
					consume_builtin_operation(opened, spelling)
				StringStart(_):
					Err(diagnostic(label.span, "builtin labels cannot contain interpolation holes", "write one concrete quoted operation label such as \"string.add\""))
				_:
					Err(expected_syntax(opened, "expected a quoted builtin label", BUILTIN_LABEL_HELP))
		None:
			Err(expected_syntax(opened, "expected a builtin label", "use a quoted closed operation label"))
	closed ?= expect(operation.next, at_right_paren(operation.next), "expected ')' after the builtin label", "give the builtin one quoted label; Bool and Option results use the foundation's unions")
	Ok({ body = ParsedBuiltinBody(operation.operation, parser_span(opened)), next = closed })


private fixed record StatementBlock {
	statements: List[ParsedStatement],
	body: ParsedBody,
	next: ParserState
}


private pure func builtin_not_alone(state: ParserState) -> Diagnostic:
	expected_syntax(state, "builtin must be the entire function body", "use builtin as the entire function body; put other work in an ordinary wrapper function")


-- One code line of a function body, after its Newline: a statement, or the
-- body that ends the block.
private fixed union FunctionLine:
	BodyStatement(ParsedStatement, ParserState)
	BodyEnd(ParsedBody, ParserState)


-- The function's final line is a value, a builtin body or a tail match; the
-- block's Dedent must follow it.
private pure func consume_function_line(state: ParserState, statements: List[ParsedStatement]) -> Result[FunctionLine, Diagnostic]:
	match current_keyword(state):
		-- The function's last match is its tail body; an earlier one is a
		-- statement whose value is a MatchExpression.
		Some(MatchKeyword):
			match consume_match_form(state):
				Ok(matched):

					if at_dedent(matched.next):
						Ok(BodyEnd(ParsedMatchBody(matched.form), shifted(matched.next, 1)))
					else:
						Ok(BodyStatement(ExpressionStatement(match_expression(matched.form)), matched.next))
				Err(error): Err(error)
		Some(BuiltinKeyword):
			match consume_builtin_lines(state, statements):
				Ok(closed): Ok(BodyEnd(closed.body, closed.next))
				Err(error): Err(error)
		_:
			match consume_block_line(state):
				Ok(line):

					match line:
						StatementLine(statement, next):
							Ok(BodyStatement(statement, next))
						FinalLine(value, next):
							Ok(BodyEnd(ParsedValueBody(value), next))
				Err(error): Err(error)


-- Statement lines accumulate in a loop, one host frame for the whole block,
-- until the body line ends it. A Dedent directly after a statement means the
-- body line is missing.
private pure func consume_function_lines(start: ParserState) -> Result[StatementBlock, Diagnostic]:
	var statements: List[ParsedStatement] = []
	-- One Result carries each consumed line, or the first error.
	var line: Result[FunctionLine, Diagnostic] = consume_function_line(start, statements)

	while True:
		match line:
			Ok(BodyStatement(statement, next)):
				if at_dedent(next):
					break

				statements = statements.append(statement)
				line = consume_function_line(next, statements)
			_:
				break

	ended ?= line

	match ended:
		BodyEnd(body, next):
			Ok({ statements = statements, body = body, next = next })
		BodyStatement(_, next):
			Err(expected_syntax(next, "expected a final expression after the bindings", "finish the function with a value expression or tail match"))


-- A builtin body is the function's only line.
private pure func consume_builtin_lines(state: ParserState, statements: List[ParsedStatement]) -> Result[BodyResult, Diagnostic]:
	_: Void ?= if statements.is_empty():
		Ok(void)
	else:
		Err(builtin_not_alone(state))
	operation ?= consume_builtin_body(state)
	after ?= end_value_line(operation.next)

	if at_dedent(after):
		Ok({ body = operation.body, next = shifted(after, 1) })
	else:
		Err(builtin_not_alone(state))


-- A capital ASCII letter followed by ASCII letters and digits.
private pure func valid_type_parameter_name(spelling: String) -> Bool:
	var valid = spelling.length().greater_than(0)
	var position = 0
	while and(valid, position.less_than(spelling.length())):
		valid = match spelling.byte_at(position):
			Some(byte):
				upper = and(byte.greater_than_or_equal(UPPER_A_BYTE), byte.less_than_or_equal(UPPER_Z_BYTE))
				lower = and(byte.greater_than_or_equal(LOWER_A_BYTE), byte.less_than_or_equal(LOWER_Z_BYTE))
				digit = and(byte.greater_than_or_equal(ZERO_BYTE), byte.less_than_or_equal(NINE_BYTE))
				or(upper, (and(position.greater_than(0), (or(lower, digit)))))
			None: False
		position = position.add(1)
	valid


private pure func consume_type_parameter(state: ParserState) -> Result[ParsedName, Diagnostic]:
	match current_token(state):
		Some(token):
			match token.kind:
				IdentifierToken(id):
					-- The capital rule reads the spelling by ID until the lexer
					-- distinguishes upper and lower identifiers. Every ID came
					-- from the lexed table, so the `None` arm never runs.
					valid = match name_spelling(state.input.names, id):
						Some(spelling):
							valid_type_parameter_name(spelling)
						None:
							False

					if valid:
						consume_name(state, "expected a type parameter name")
					else:
						Err(diagnostic(token.span, "invalid type parameter name", "start with a capital ASCII letter and use only ASCII letters and digits, such as T or Element2"))
				_:
					Err(expected_syntax(state, "expected a type parameter name", "declare type parameters separated by commas, such as [A, B]"))
		None:
			Err(expected_syntax(state, "expected a type parameter name", "declare type parameters separated by commas, such as [A, B]"))


private fixed record TypeParameterList {
	parameters: List[ParsedTypeParameter],
	next: ParserState
}


private pure func consume_parameter_bounds(state: ParserState, bounds: List[TypeSyntax]) -> Result[ParsedTypes, Diagnostic]:
	bound ?= consume_type(state, "expected a trait name after ':' or '+'")
	gathered = bounds.append(bound.written)
	match current_symbol(bound.next):
		Some(Plus): consume_parameter_bounds(shifted(bound.next, 1), gathered)
		_: Ok({ types = gathered, next = bound.next })


-- A bound is read only where `allows_bounds` is set; otherwise its `:` is not
-- a separator and ends the list with the closing-bracket diagnostic.
private pure func consume_type_parameter_list(
	state: ParserState,
	parameters: List[ParsedTypeParameter],
	allows_bounds: Bool,
) -> Result[TypeParameterList, Diagnostic]:
	name ?= consume_type_parameter(state)
	bounds: ParsedTypes ?= if and(allows_bounds, at_colon(name.next)):
		consume_parameter_bounds(shifted(name.next, 1), [])
	else:
		Ok({ types = [], next = name.next })
	parameter: ParsedTypeParameter = { name = name.name, bounds = bounds.types }
	gathered = parameters.append(parameter)
	match list_separator(bounds.next):
		ListContinues(next): consume_type_parameter_list(next, gathered, allows_bounds)
		ListEnds(next):
			if at_right_bracket(next):
				Ok({ parameters = gathered, next = shifted(next, 1) })
			else:
				Err(expected_syntax(next, "expected ',' or ']' after a type parameter", "separate type parameters with commas and close the list with ']'"))


private pure func consume_type_parameters(state: ParserState, allows_bounds: Bool) -> Result[TypeParameterList, Diagnostic]:
	if at_left_bracket(state):
		consume_type_parameter_list(shifted(state, 1), [], allows_bounds)
	else:
		Ok({ parameters = [], next = state })


-- Nominal declarations keep their unbounded parameters as bare names.
private pure func consume_type_parameter_names(state: ParserState) -> Result[NameList, Diagnostic]:
	declared ?= consume_type_parameters(state, False)
	Ok({ names = declared.parameters.map(pure func(parameter): parameter.name), next = declared.next })


private fixed record ParsedReturnAnnotation {
	written: Option[TypeSyntax],
	next: ParserState
}


private pure func consume_return_annotation(start: ParserState) -> Result[ParsedReturnAnnotation, Diagnostic]:
	if or(at_colon(start), at_newline(start)):
		Ok({ written = None, next = start })
	else:
		match current_symbol(start):
			Some(Arrow):
				match consume_type(shifted(start, 1), "expected a return type"):
					Ok(return_type): Ok({ written = Some(return_type.written), next = return_type.next })
					Err(error): Err(error)
			_:
				Err(unexpected(start, "expected '->' before the return type", "write main() -> Int with adjacent arrow characters, or main(): for Void"))


private fixed record HeaderResult {
	header: FunctionHeader,
	next: ParserState
}


-- The shared signature ends before its body colon or requirement newline.
private pure func consume_signature(start: ParserState) -> Result[HeaderResult, Diagnostic]:
	purity: Purity = if at_pure(start):
		Pure
	else:
		Impure
	after_func ?= match purity:
		Pure:
			after_pure = shifted(start, 1)
			expect(after_pure, at_func(after_pure), "expected 'func' after 'pure'", "write pure func name() -> Int:")
		Impure:
			expect(start, at_func(start), "expected a function declaration at column 1", "start with func main() -> Int:")
	function ?= consume_callable_name(after_func, "expected a function name")
	type_parameters ?= consume_type_parameters(function.next, True)
	after_open ?= expect(type_parameters.next, at_left_paren(type_parameters.next), "expected '(' after the function name", "write main() or helper(value: Int)")
	parameters ?= consume_parameters(after_open)
	return_type ?= consume_return_annotation(parameters.next)
	Ok({
		header = {
			purity = purity,
			function_name = function.name,
			type_parameters = type_parameters.parameters,
			parameters = parameters.parameters,
			return_type = return_type.written
		},
		next = return_type.next,
	})


-- Ordinary functions still require their colon and actual indented body.
private pure func consume_header(start: ParserState) -> Result[HeaderResult, Diagnostic]:
	signature ?= consume_signature(start)
	after_header ?= expect(signature.next, at_colon(signature.next), "expected ':' after the function header", "end the header with ':' and put the return expression on the next line")
	after_newline ?= expect(after_header, at_newline(after_header), "expected a newline after the function header", "put the return expression on the next line")
	after_indent ?= expect(after_newline, at_indent(after_newline), INDENTED_BLOCK_MESSAGE, INDENTED_BLOCK_HELP)
	Ok({ signature | next = after_indent })


private fixed record ParsedAnnotation {
	span: Option[Span],
	next: ParserState
}


-- `@tail_recursive` precedes `pure` or `func` on its line or on the next one.
private pure func consume_annotation_target(span: Span, after_name: ParserState) -> Result[ParsedAnnotation, Diagnostic]:
	declaration = if at_newline(after_name):
		shifted(after_name, 1)
	else:
		after_name

	if at_left_paren(after_name):
		Err(expected_syntax(after_name, "@tail_recursive takes no arguments", "write @tail_recursive before the optional pure and func keywords"))
	else if at_at_sign(declaration):
		Err(expected_syntax(declaration, "multiple function annotations are not supported", "write @tail_recursive only once before a function"))
	else if at_end(declaration):
		Err(diagnostic(span, "@tail_recursive has no function declaration", "put a function declaration immediately after @tail_recursive"))
	else if or(at_pure(declaration), at_func(declaration)):
		Ok({ span = Some(span), next = declaration })
	else:
		Err(expected_syntax(declaration, "@tail_recursive requires a function declaration", "put @tail_recursive before the optional pure and func keywords"))


private pure func consume_annotation(start: ParserState) -> Result[ParsedAnnotation, Diagnostic]:
	if at_at_sign(start).not():
		Ok({ span = None, next = start })
	else:
		after_at = shifted(start, 1)
		match current_token(after_at).to_result(expected_syntax(start, "expected a function annotation", "write @tail_recursive before a function declaration")):
			Ok(name):
				known = and(at_word(after_at, recognized_words(after_at).tail_recursive_word), at_spaced_token(after_at).not())
				span = { parser_span(start) | end = name.span.end }

				if known:
					consume_annotation_target(span, shifted(after_at, 1))
				else:
					Err(diagnostic(span, "unknown function annotation", "use @tail_recursive before a function declaration"))
			Err(error): Err(error)


private fixed record FunctionResult {
	function: ParsedFunction,
	next: ParserState
}


private pure func consume_function(start: ParserState, module: ModuleId, visibility: Visibility) -> Result[FunctionResult, Diagnostic]:
	annotation ?= consume_annotation(start)
	header ?= consume_header(annotation.next)
	body ?= consume_function_lines(header.next)
	Ok({
		function = {
			module = module,
			visibility = visibility,
			tail_annotation = annotation.span,
			purity = header.header.purity,
			function_name = header.header.function_name,
			type_parameters = header.header.type_parameters,
			parameters = header.header.parameters,
			return_type = header.header.return_type,
			statements = body.statements,
			body = body.body
		},
		next = body.next,
	})


private fixed record ParsedTraitMethods {
	methods: List[ParsedTraitMethod],
	next: ParserState
}


private pure func consume_default_trait_method(state: ParserState, signature: HeaderResult, module: ModuleId, visibility: Visibility) -> Result[ParsedTraitMethods, Diagnostic]:
	after_colon = shifted(signature.next, 1)
	newline ?= expect(after_colon, at_newline(after_colon), "expected a newline after the default method header", "put the return expression on the next line")
	opened ?= expect(newline, at_indent(newline), INDENTED_BLOCK_MESSAGE, INDENTED_BLOCK_HELP)
	body ?= consume_function_lines(opened)
	function: ParsedFunction = {
		module = module, visibility = visibility, tail_annotation = None,
		purity = signature.header.purity, function_name = signature.header.function_name,
		type_parameters = signature.header.type_parameters, parameters = signature.header.parameters,
		return_type = signature.header.return_type, statements = body.statements, body = body.body
	}
	span = { parser_span(state) | end = parser_span(signature.next).start }
	Ok({ methods = [DefaultTraitMethod(function, span)], next = body.next })


private pure func consume_trait_method(state: ParserState, module: ModuleId, visibility: Visibility) -> Result[ParsedTraitMethods, Diagnostic]:
	signature ?= consume_signature(state)
	span = { parser_span(state) | end = parser_span(signature.next).start }
	if at_colon(signature.next):
		consume_default_trait_method(state, signature, module, visibility)
	else:
		match consume_line_end(signature.next, "expected a newline after the trait method signature", "put each method signature on its own indented line"):
			Ok(next): Ok({ methods = [AbstractTraitMethod(signature.header, span)], next = next })
			Err(error): Err(error)


private pure func consume_trait_methods(state: ParserState, module: ModuleId, visibility: Visibility, methods: List[ParsedTraitMethod]) -> Result[ParsedTraitMethods, Diagnostic]:
	method ?= consume_trait_method(state, module, visibility)
	gathered = methods.concat(method.methods)
	if at_dedent(method.next):
		Ok({ methods = gathered, next = shifted(method.next, 1) })
	else:
		consume_trait_methods(method.next, module, visibility, gathered)


private fixed record TraitResult {
	declaration: ParsedTrait,
	next: ParserState
}


private pure func consume_trait(start: ParserState, module: ModuleId, visibility: Visibility) -> Result[TraitResult, Diagnostic]:
	name ?= consume_name(shifted(start, 1), "expected a trait name")
	_: Void ?= if at_left_bracket(name.next):
		Err(expected_syntax(name.next, "traits do not take type parameters", "use Self for the implementing type"))
	else:
		Ok(void)
	colon ?= expect(name.next, at_colon(name.next), "expected ':' after the trait name", "write trait Equatable: followed by indented method signatures")
	newline ?= expect(colon, at_newline(colon), "expected a newline after the trait header", "put each method signature on its own indented line")
	opened ?= expect(newline, at_indent(newline), "expected an indented trait method", "declare at least one pure method signature")
	methods ?= consume_trait_methods(opened, module, visibility, [])
	Ok({
		declaration = {
			module = module, visibility = visibility, type_name = name.name,
			methods = methods.methods, span = { parser_span(start) | end = parser_span(colon).start }
		},
		next = methods.next
	})


private fixed record ImplementationMethods {
	methods: List[ParsedFunction],
	next: ParserState
}


private pure func consume_implementation_methods(state: ParserState, module: ModuleId, visibility: Visibility, methods: List[ParsedFunction]) -> Result[ImplementationMethods, Diagnostic]:
	method ?= consume_function(state, module, visibility)
	gathered = methods.append(method.function)
	if at_dedent(method.next):
		Ok({ methods = gathered, next = shifted(method.next, 1) })
	else:
		consume_implementation_methods(method.next, module, visibility, gathered)


private fixed record ImplementationResult {
	header: ParsedImplementationHeader,
	methods: List[ParsedFunction],
	next: ParserState
}


private fixed record ReceiverHeadResult {
	head: ParsedReceiverHead,
	next: ParserState
}


private pure func consume_receiver_head(state: ParserState) -> Result[ReceiverHeadResult, Diagnostic]:
	name ?= consume_name(state, "expected a named implementation receiver")
	if at_dot(name.next):
		match consume_name(shifted(name.next, 1), "expected a receiver type after the module alias and '.'"):
			Ok(member): Ok({ head = QualifiedReceiverName({ module = name.name, name = member.name }), next = member.next })
			Err(error): Err(error)
	else:
		Ok({ head = ReceiverName(name.name), next = name.next })


private pure func consume_authored_implementation(state: ParserState, module: ModuleId, visibility: Visibility) -> Result[ImplementationMethods, Diagnostic]:
	after_colon = shifted(state, 1)
	newline ?= expect(after_colon, at_newline(after_colon), "expected a newline after the implementation header", "put each method body on its own indented line")
	opened ?= expect(newline, at_indent(newline), "expected an indented implementation method", "define at least one method after ':', or omit ':' to use only trait defaults")
	consume_implementation_methods(opened, module, visibility, [])


private pure func consume_implementation_body(state: ParserState, module: ModuleId, visibility: Visibility) -> Result[ImplementationMethods, Diagnostic]:
	if at_colon(state):
		consume_authored_implementation(state, module, visibility)
	else if at_end(state):
		Ok({ methods = [], next = state })
	else:
		match consume_line_end(state, "expected ':' or a newline after the implementation receiver", "add ':' before authored methods, or end the line to use only trait defaults"):
			Ok(next): Ok({ methods = [], next = next })
			Err(error): Err(error)


private pure func consume_implementation(start: ParserState, module: ModuleId, visibility: Visibility) -> Result[ImplementationResult, Diagnostic]:
	after_keyword = shifted(start, 1)
	requirement: ParsedType ?= if at_left_bracket(after_keyword):
		Err(expected_syntax(after_keyword, "implementation parameters belong after the receiver head", "write implements Equatable for Box[T: Equatable]"))
	else:
		consume_type(after_keyword, "expected the implemented trait name")
	after_for ?= expect(requirement.next, at_for(requirement.next), "expected 'for' after the trait name", "write implements Equatable for Int:")
	receiver ?= consume_receiver_head(after_for)
	parameters ?= consume_type_parameters(receiver.next, True)
	methods ?= consume_implementation_body(parameters.next, module, visibility)
	header_end = if at_colon(parameters.next):
		parser_span(shifted(parameters.next, 1)).start
	else:
		parser_span(parameters.next).start
	Ok({
		header = {
			module = module, visibility = visibility, trait_name = requirement.written,
			receiver = receiver.head, type_parameters = parameters.parameters,
			span = { parser_span(start) | end = header_end }
		},
		methods = methods.methods,
		next = methods.next
	})


private fixed record VariantResult {
	variant: ParsedVariant,
	next: ParserState
}


private pure func consume_variant(state: ParserState) -> Result[VariantResult, Diagnostic]:
	name ?= consume_name(state, "expected a union variant name")

	if at_left_paren(name.next):
		var current = shifted(name.next, 1)
		var fields: List[TypeSyntax] = []
		var failure: Option[Diagnostic] = None

		if at_right_paren(current):
			failure = Some(expected_syntax(current, "expected a payload type", "write bare Variant for no fields, or Variant(String, Int) for fields"))
		else:
			while True:
				match consume_type(current, "expected a payload type"):
					Err(error):
						failure = Some(error)
						break
					Ok(field):
						fields = fields.append(field.written)
						current = field.next

				match list_separator(current):
					ListContinues(next):
						current = next
					ListEnds(next):
						current = next
						break

		match failure:
			Some(error): Err(error)
			None:
				match expect(current, at_right_paren(current), "expected ')' after the variant fields", "write comma-separated field types, such as Pair(String, String)"):
					Ok(closed): Ok({ variant = { name = name.name, fields = fields }, next = closed })
					Err(error): Err(error)
	else:
		Ok({ variant = { name = name.name, fields = [] }, next = name.next })


private fixed record ParsedVariants {
	variants: List[ParsedVariant],
	next: ParserState
}


private pure func consume_variants(state: ParserState, variants: List[ParsedVariant]) -> Result[ParsedVariants, Diagnostic]:
	variant ?= consume_variant(state)
	next ?= consume_line_end(variant.next, "expected a newline after the variant name", "put each variant on its own indented line")
	gathered = variants.append(variant.variant)

	if at_dedent(next):
		Ok({ variants = gathered, next = shifted(next, 1) })
	else:
		consume_variants(next, gathered)


private fixed record UnionResult {
	declaration: ParsedUnion,
	next: ParserState
}


private pure func consume_union(start: ParserState, module: ModuleId, visibility: Visibility) -> Result[UnionResult, Diagnostic]:
	after_fixed = shifted(start, 1)
	word: ParserState ?= if at_keyword(after_fixed, UnionKeyword):
		Ok(shifted(after_fixed, 1))
	else:
		Err(expected_syntax(after_fixed, "expected 'union' after 'fixed'", "write fixed union Choice: followed by indented variant names"))
	name ?= consume_name(word, "expected a union type name")
	type_parameters ?= consume_type_parameter_names(name.next)
	colon ?= expect(type_parameters.next, at_colon(type_parameters.next), "expected ':' after the union type name", "write fixed union Choice: or fixed union Box[T]:")
	newline ?= expect(colon, at_newline(colon), "expected a newline after the union header", "put each variant name on its own indented line")
	opened ?= expect(newline, at_indent(newline), "expected an indented union variant", "declare at least one variant on an indented line")
	variants ?= consume_variants(opened, [])
	Ok({
		declaration = {
			module = module,
			visibility = visibility,
			type_name = name.name,
			type_parameters = type_parameters.names,
			variants = variants.variants
		},
		next = variants.next,
	})


private fixed record ParsedLiteralFields {
	fields: List[ParsedRecordField],
	next: ParserState
}


private pure func consume_literal_fields(state: ParserState, fields: List[ParsedRecordField]) -> Result[ParsedLiteralFields, Diagnostic]:
	name ?= consume_name(state, "expected a record field name")
	after_equals ?= expect(name.next, at_equals(name.next), "expected '=' after the record field name", "write field = expression")
	value ?= consume_value(after_equals)
	gathered: List[ParsedRecordField] = fields.append({ name = name.name, value = value.body })

	match list_separator(value.next):
		ListContinues(next):
			consume_literal_fields(next, gathered)
		ListEnds(next):
			Ok({ fields = gathered, next = next })


-- `start` follows the opening brace.
private pure func consume_record_literal(start: ParserState, opening: Span) -> Result[ParsedBase, Diagnostic]:
	listed: ParsedLiteralFields ?= if at_right_brace(start):
		Ok({ fields = [], next = start })
	else:
		consume_literal_fields(start, [])
	closed ?= expect(listed.next, at_right_brace(listed.next), "expected '}' after the record fields", "separate record fields with commas, then close the literal with '}'")
	Ok({ base = RecordExpression(listed.fields), span = { opening | end = parser_span(listed.next).end }, next = closed })


private pure func consume_braced_record(start: ParserState, opening: Span) -> Result[ParsedBase, Diagnostic]:
	inside = with_enclosure(start, Bracketed)
	literal = and(at_identifier(inside), at_equals(shifted(inside, 1)))
	braced ?= if or(at_right_brace(inside), literal):
		consume_record_literal(inside, opening)
	else:
		consume_record_update(inside, opening)
	Ok({ braced | next = with_enclosure(braced.next, start.enclosure) })


-- `start` follows the opening brace of `{ base | field = value, ... }`.
private pure func consume_record_update(start: ParserState, opening: Span) -> Result[ParsedBase, Diagnostic]:
	base ?= consume_value(start)
	bar ?= expect(base.next, at_bar(base.next), "expected '|' after the record update base", "write { existing_record | field = expression }")
	fields ?= consume_literal_fields(bar, [])
	closed ?= expect(fields.next, at_right_brace(fields.next), "expected '}' after the record update fields", "separate replacement fields with commas, then close the update with '}'")
	Ok({ base = RecordUpdateExpression(base.body, fields.fields), span = { opening | end = parser_span(fields.next).end }, next = closed })


private fixed record ParsedRecordResult {
	declaration: ParsedRecord,
	next: ParserState
}


private pure func consume_record(start: ParserState, module: ModuleId, visibility: Visibility) -> Result[ParsedRecordResult, Diagnostic]:
	name ?= consume_name(shifted(start, 2), "expected a record type name")
	type_parameters ?= consume_type_parameter_names(name.next)
	opened: ParserState ?= match current_symbol(type_parameters.next):
		Some(LeftBrace):
			Ok(shifted(type_parameters.next, 1))
		_:
			Err(unexpected(type_parameters.next, "expected '{' after the record type name", "write fixed record Name { field: Int }"))
	fields ?= consume_parameter_list(opened, "expected a record field name", [])
	closed ?= expect(fields.next, at_right_brace(fields.next), "expected '}' after the record declaration", "separate record fields with commas, then close the declaration with '}'")
	Ok({ declaration = { module = module, visibility = visibility, type_name = name.name, type_parameters = type_parameters.names, fields = fields.parameters }, next = closed })


private fixed record BuiltinTypeResult {
	declaration: ParsedBuiltinType,
	next: ParserState
}


private BUILTIN_TYPE_HELP: String = "declare type Int = builtin, type Float = builtin, type String = builtin, type Void = builtin or type List[T] = builtin"


private pure func consume_list_parameter(state: ParserState) -> Result[ParserState, Diagnostic]:
	opened ?= expect(state, at_left_bracket(state), "List requires one type parameter", "write type List[T] = builtin")
	parameter ?= consume_name(opened, "expected the List type parameter")
	expect(parameter.next, at_right_bracket(parameter.next), "List requires exactly one type parameter", "write type List[T] = builtin")


-- `state` is at the declared type name.
private pure func builtin_type(state: ParserState, name: WrittenName) -> Option[ParsedBuiltinType]:
	if at_word(state, recognized_words(state).int_word):
		Some(IntegerBuiltin(name))
	else if at_word(state, recognized_words(state).float_word):
		Some(FloatBuiltin(name))
	else if at_word(state, recognized_words(state).string_word):
		Some(StringBuiltin(name))
	else if at_word(state, recognized_words(state).void_word):
		Some(VoidBuiltin(name))
	else if at_word(state, recognized_words(state).list_word):
		Some(ListBuiltin(name))
	else:
		None


private pure func unknown_builtin_type(state: ParserState) -> Diagnostic:
	expected_syntax(state, "unknown builtin type", BUILTIN_TYPE_HELP)


private pure func consume_builtin_type(start: ParserState) -> Result[BuiltinTypeResult, Diagnostic]:
	after_type ?= expect(start, at_type_keyword(start), "expected 'type'", DECLARATION_WORD_HELP)
	name ?= if at_identifier(after_type):
		consume_name(after_type, "expected a builtin type name")
	else:
		Err(unknown_builtin_type(after_type))
	declaration: ParsedBuiltinType ?= match builtin_type(after_type, name.name):
		Some(declared):
			Ok(declared)
		None:
			Err(unknown_builtin_type(after_type))
	after_name ?= match declaration:
		ListBuiltin(_):
			consume_list_parameter(name.next)
		_:
			Ok(name.next)
	equals ?= expect(after_name, at_equals(after_name), "expected '=' after the builtin type name", "write type Int = builtin, type Float = builtin, type String = builtin, type Void = builtin or type List[T] = builtin")
	end ?= expect(equals, at_builtin(equals), "expected 'builtin'", DECLARATION_WORD_HELP)
	Ok({ declaration = declaration, next = end })


private fixed record ParsedPath {
	path: ModulePath,
	span: Span,
	next: ParserState
}


-- `../` lexes as the range symbol and a slash.
private pure func parent_prefix(state: ParserState) -> Bool:
	and(at_dot_dot(state), at_slash(shifted(state, 1)))


private fixed record ParsedPathParts {
	parts: List[NameId],
	last: Span,
	next: ParserState
}


private pure func consume_path_parts(state: ParserState, parts: List[NameId]) -> Result[ParsedPathParts, Diagnostic]:
	_: Void ?= if or(at_dot(state), at_dot_dot(state)):
		Err(expected_syntax(state, "'.' and '..' may only begin an import path", "write ../shared/helper or ./shared/helper without interior dot segments"))
	else:
		Ok(void)
	part ?= consume_name(state, "expected a module name in the import path")
	gathered = parts.append(part.name.id)

	if at_slash(part.next):
		consume_path_parts(shifted(part.next, 1), gathered)
	else:
		Ok({ parts = gathered, last = part.name.span, next = part.next })


-- Path bytes are contiguous: no token after the path's first is spaced.
private pure func reject_spaced_path(state: ParserState, end: Int) -> Result[Void, Diagnostic]:
	if state.position.greater_than_or_equal(end):
		Ok(void)
	else if at_spaced_token(state):
		Err(expected_syntax(state, "import paths cannot contain spaces", "write adjacent path characters, such as ./helper or ../shared/helper"))
	else:
		reject_spaced_path(shifted(state, 1), end)


private pure func consume_module_path(start: ParserState) -> Result[ParsedPath, Diagnostic]:
	var state = start
	var origin: ImportOrigin = LibraryImport

	if and(at_dot(state), at_slash(shifted(state, 1))):
		origin = RelativeImport(0)
		state = shifted(state, 2)
	else:
		var parents: Int = 0

		while parent_prefix(state):
			parents = parents.add(1)
			state = shifted(state, 2)

		if parents.greater_than(0):
			origin = RelativeImport(parents)

	_: Void ?= if at_slash(start):
		Err(expected_syntax(start, "absolute import paths are not supported", "write int: add for the target library or ./helper: answer for a local module"))
	else if and(state.position == start.position, (or(at_dot(start), at_dot_dot(start)))):
		Err(expected_syntax(start, "expected './' or '../' before a relative import path", "write ./helper: answer or ../shared/helper: answer"))
	else:
		Ok(void)
	parts ?= consume_path_parts(state, [])
	contiguous ?= reject_spaced_path(shifted(start, 1), parts.next.position)
	Ok({
		path = { origin = origin, parts = parts.parts },
		span = { parser_span(start) | end = parts.last.end },
		next = parts.next
	})


private fixed record ImportSelectionResult {
	selection: ImportSelection,
	span: Span,
	next: ParserState
}


-- Where `name` was listed earlier in `names`, if it was.
private pure func listed_at(names: List[WrittenName], name: WrittenName) -> Option[Span]:
	var first: Option[Span] = None
	for listed in names:
		if same_name(listed.id, name.id):
			first = Some(listed.span)
			break
	first


private LIST_ONCE_HELP: String = "list each selected name once; combine constructor selections, such as Shape(Circle, Square)"


-- `selection` repeats no name of the `symbols` listed before it.
private pure func unique_selection(symbols: List[ImportSelection], selection: ImportSelection) -> Result[Void, Diagnostic]:
	name = selection_name(selection)
	var unique: Result[Void, Diagnostic] = Ok(void)
	for listed in symbols:
		if same_name(selection_name(listed).id, name.id):
			unique = Err({ diagnostic(name.span, "name selected more than once", LIST_ONCE_HELP) | note = Some(PreviousDeclaration(selection_name(listed).span)) })
			break
	unique


-- `opened` follows the opening parenthesis of a constructor selection.
private pure func consume_constructor_names(state: ParserState, names: List[WrittenName]) -> Result[NameList, Diagnostic]:
	name ?= consume_name(state, "expected an imported constructor name")
	_: Void ?= match listed_at(names, name.name):
		Some(first): Err({ diagnostic(name.name.span, "constructor selected more than once", "list each selected constructor once") | note = Some(PreviousDeclaration(first)) })
		None: Ok(void)
	gathered = names.append(name.name)

	match list_separator(name.next):
		ListContinues(next):
			consume_constructor_names(next, gathered)
		ListEnds(next):
			Ok({ names = gathered, next = next })


private METHODS_SELECTION_HELP: String = "write Foo(First) to import the type and constructors, or Foo methods to import only methods"


private pure func consume_constructor_selection(name: ParsedName) -> Result[ImportSelectionResult, Diagnostic]:
	opened = shifted(name.next, 1)
	selected: NameList ?= if at_right_paren(opened):
		Ok({ names = [], next = opened })
	else:
		consume_constructor_names(opened, [])
	closed ?= expect(selected.next, at_right_paren(selected.next), "expected ')' after selected constructors", "write Option(Some, None) or Option(), then close the selection with ')'")

	if at_methods_word(closed):
		Err(expected_syntax(closed, "constructor selection cannot be combined with methods", METHODS_SELECTION_HELP))
	else:
		Ok({
			selection = ConstructorSelection(name.name, selected.names),
			span = { name.name.span | end = parser_span(selected.next).end },
			next = closed,
		})


private pure func at_methods_word(state: ParserState) -> Bool:
	at_word(state, recognized_words(state).methods_word)


private pure func consume_methods(name: ParsedName) -> Result[ImportSelectionResult, Diagnostic]:
	modifier = parser_span(name.next)
	after_modifier = shifted(name.next, 1)

	if at_left_paren(after_modifier):
		Err(expected_syntax(after_modifier, "methods cannot include constructor selection", METHODS_SELECTION_HELP))
	else if at_methods_word(after_modifier):
		Err(expected_syntax(after_modifier, "methods must appear once after a type name", "write ops: Foo methods without constructors or another modifier"))
	else:
		Ok({ selection = MethodsSelection(name.name, modifier), span = { name.name.span | end = modifier.end }, next = after_modifier })


-- The name a selection writes: a function, type or union name.
pure func selection_name(selection: ImportSelection) -> WrittenName:
	match selection:
		NamedSelection(name): name
		ConstructorSelection(name, _): name
		MethodsSelection(name, _): name


private pure func consume_import_symbol(state: ParserState) -> Result[ImportSelectionResult, Diagnostic]:
	match current_symbol(state):
		Some(Star):
			Err(expected_syntax(state, "wildcard imports are not supported", "list the functions you need, such as ./helper: answer"))
		_:
			match consume_callable_name(state, "expected an imported function or type name"):
				Ok(name):

					if at_as(name.next):
						Err(expected_syntax(name.next, "selection aliases are not supported yet", "select the name by its declared spelling, such as ./helper: answer; a module alias is written path as Alias"))
					else if at_left_paren(name.next):
						consume_constructor_selection(name)
					else if at_methods_word(name.next):
						consume_methods(name)
					else:
						Ok({ selection = NamedSelection(name.name), span = name.name.span, next = name.next })
				Err(error): Err(error)


private fixed record ImportSymbols {
	symbols: List[ImportSelection],
	last: Span,
	next: ParserState
}


private SELECTION_LINE_HELP: String = "separate imported names with commas; a path ending in ':' may list them on indented lines"


-- The selections written on one line: a comma continues the line unless the
-- line ends after it.
private pure func consume_import_symbols(state: ParserState, symbols: List[ImportSelection]) -> Result[ImportSymbols, Diagnostic]:
	symbol ?= consume_import_symbol(state)
	unique ?= unique_selection(symbols, symbol.selection)
	gathered = symbols.append(symbol.selection)
	after_comma = shifted(symbol.next, 1)

	if at_comma(symbol.next).not():
		Ok({ symbols = gathered, last = symbol.span, next = symbol.next })
	else if at_newline(after_comma):
		Ok({ symbols = gathered, last = symbol.span, next = after_comma })
	else:
		consume_import_symbols(after_comma, gathered)


-- `state` is at a selection line of an indented block; the block ends at its Dedent.
private pure func consume_selection_lines(state: ParserState, symbols: List[ImportSelection]) -> Result[ImportSymbols, Diagnostic]:
	line ?= consume_import_symbols(state, symbols)
	next ?= consume_line_end(line.next, "expected ',' between imported function names", SELECTION_LINE_HELP)

	if at_dedent(next):
		Ok({ line | next = shifted(next, 1) })
	else:
		consume_selection_lines(next, line.symbols)


-- `colon` follows the import path's ':': the selections are on this line or
-- on an indented block of lines.
private pure func consume_import_selection(colon: ParserState) -> Result[ImportSymbols, Diagnostic]:
	if at_newline(colon).not():
		match consume_import_symbols(colon, []):
			Ok(symbols):
				match consume_line_end(symbols.next, "expected ',' between imported function names", SELECTION_LINE_HELP):
					Ok(next): Ok({ symbols | next = next })
					Err(error): Err(error)
			Err(error): Err(error)
	else if at_indent(shifted(colon, 1)):
		consume_selection_lines(shifted(colon, 2), [])
	else:
		Err(expected_syntax(colon, "expected an imported function or type name", IDENTIFIER_HELP))


private fixed record ImportResult {
	request: ParsedImport,
	next: ParserState
}


private fixed record ParsedAlias {
	module_alias: Option[WrittenName],
	next: ParserState
}


-- `path as Alias` names the module; the alias joins the parser's alias set.
private pure func consume_module_alias(state: ParserState) -> Result[ParsedAlias, Diagnostic]:
	if at_as(state).not():
		Ok({ module_alias = None, next = state })
	else:
		match consume_name(shifted(state, 1), "expected a module alias name after 'as'"):
			Ok(name): Ok({ module_alias = Some(name.name), next = { name.next | aliases = name.next.aliases.append(name.name.id) } })
			Err(error): Err(error)


-- A row is `path: selections`, `path as Alias`, or `path as Alias: selections`.
private pure func consume_import_row(start: ParserState) -> Result[ImportResult, Diagnostic]:
	path ?= consume_module_path(start)
	_: Void ?= if at_dot(path.next):
		Err(expected_syntax(path.next, "import paths omit file extensions", "write ./helper: answer instead of ./helper.brp: answer"))
	else:
		Ok(void)
	aliased ?= consume_module_alias(path.next)

	if at_colon(aliased.next):
		match consume_import_selection(shifted(aliased.next, 1)):
			Ok(symbols):
				Ok({
					request = { path = path.path, module_alias = aliased.module_alias, symbols = symbols.symbols, span = { path.span | end = symbols.last.end } },
					next = symbols.next,
				})
			Err(error): Err(error)
	else:
		match aliased.module_alias:
			Some(module_alias):
				match consume_line_end(aliased.next, "expected a newline after the module alias", "write path as Alias, or path as Alias: followed by selected names"):
					Ok(next):
						Ok({
							request = { path = path.path, module_alias = Some(module_alias), symbols = [], span = { path.span | end = module_alias.span.end } },
							next = next,
						})
					Err(error): Err(error)
			None:
				Err(expected_syntax(aliased.next, "expected ':' and selected function names after the import path", "write ./helper: answer, or int as IntOps to alias a module"))


private fixed record ImportBlockResult {
	imports: List[ParsedImport],
	next: ParserState
}


private pure func consume_import_rows(state: ParserState, imports: List[ParsedImport]) -> Result[ImportBlockResult, Diagnostic]:
	row ?= consume_import_row(state)
	gathered = imports.append(row.request)

	if at_dedent(row.next):
		Ok({ imports = gathered, next = shifted(row.next, 1) })
	else:
		consume_import_rows(row.next, gathered)


private pure func consume_import_block(start: ParserState) -> Result[ImportBlockResult, Diagnostic]:
	keyword_end = shifted(start, 1)
	colon ?= expect(keyword_end, at_colon(keyword_end), "expected ':' after 'import'", "write import: followed by indented relative imports")
	newline ?= expect(colon, at_newline(colon), "expected a newline after 'import:'", "put each ./helper: answer import on its own indented line")
	opened ?= expect(newline, at_indent(newline), "expected an indented import", "indent each ./helper: answer line under import:")
	consume_import_rows(opened, [])


-- One top-level item of a module.
private fixed union Declaration:
	ImportBlock(List[ParsedImport])
	BuiltinTypeDeclaration(ParsedBuiltinType)
	FunctionDeclaration(ParsedFunctionGroup)
	TraitDeclaration(ParsedTrait)
	UnionDeclaration(ParsedUnion)
	RecordDeclaration(ParsedRecord)
	OpaqueDeclaration(ParsedOpaque)
	ConstantDeclaration(ParsedConstant)


private fixed record ParsedConstantResult {
	declaration: ParsedConstant,
	next: ParserState
}


-- `NAME: Type = value`; the value may stand alone on the next line.
private pure func consume_constant(start: ParserState, module: ModuleId, visibility: Visibility) -> Result[ParsedConstantResult, Diagnostic]:
	name ?= consume_name(start, "expected a constant name")
	colon ?= expect(name.next, at_colon(name.next), "expected ':' after the constant name", "write NAME: Type = value")
	type_name ?= consume_type(colon, "expected the constant's type after ':'")
	equals ?= expect(type_name.next, at_equals(type_name.next), "expected '=' after the constant type", "write NAME: Type = value")
	value ?= consume_initializer(equals, Assign, "expected a newline after the constant value", "put each declaration on a new line")
	Ok({
		declaration = { module = module, visibility = visibility, name = name.name, type_name = type_name.written, value = value.body },
		next = value.next,
	})


private fixed record ParsedOpaqueResult {
	declaration: ParsedOpaque,
	next: ParserState
}


-- `opaque type Name = Underlying` on one line.
private pure func consume_opaque(start: ParserState, module: ModuleId, visibility: Visibility) -> Result[ParsedOpaqueResult, Diagnostic]:
	after_opaque = shifted(start, 1)
	type_word: ParserState ?= if at_type_keyword(after_opaque):
		Ok(shifted(after_opaque, 1))
	else:
		Err(expected_syntax(after_opaque, "expected 'type' after 'opaque'", "write opaque type Name = Underlying"))
	name ?= consume_name(type_word, "expected an opaque type name")
	equals ?= expect(name.next, at_equals(name.next), "expected '=' after the opaque type name", "write opaque type Name = Underlying")
	underlying ?= consume_type(equals, "expected the underlying type after '='")
	next ?= end_value_line(underlying.next)
	Ok({ declaration = { module = module, visibility = visibility, type_name = name.name, underlying = underlying.written }, next = next })


private fixed record DeclarationResult {
	declaration: Declaration,
	next: ParserState
}


-- `declared` says whether a non-import declaration precedes `state`.
private pure func consume_declaration(state: ParserState, module: ModuleId, declared: Bool) -> Result[DeclarationResult, Diagnostic]:
	if and(at_import(state), declared):
		Err(expected_syntax(state, "imports must precede declarations", "move every import: block before the module's functions, fixed unions, and fixed records"))
	else if at_import(state):
		match consume_import_block(state):
			Ok(block): Ok({ declaration = ImportBlock(block.imports), next = block.next })
			Err(error): Err(error)
	else if at_type_keyword(state):
		match consume_builtin_type(state):
			Ok(parsed):
				match end_value_line(parsed.next):
					Ok(next): Ok({ declaration = BuiltinTypeDeclaration(parsed.declaration), next = next })
					Err(error): Err(error)
			Err(error): Err(error)
	else if and(at_private(state), at_type_keyword(shifted(state, 1))):
		-- Only a well-formed builtin type declaration is rejected as private;
		-- any other `type` line reports the builtin-type parser's own error.
		match consume_builtin_type(shifted(state, 1)):
			Ok(_):
				Err(expected_syntax(state, "builtin type declarations cannot be private", "remove private; builtin types belong to the foundation module"))
			Err(error):
				Err(error)
	else if at_private(state):
		consume_visible_declaration(shifted(state, 1), module, Private(parser_span(state)))
	else:
		consume_visible_declaration(state, module, Public)


-- The declarations that may carry `private`.
private pure func consume_visible_declaration(state: ParserState, module: ModuleId, visibility: Visibility) -> Result[DeclarationResult, Diagnostic]:
	if at_keyword(state, TraitKeyword):
		match consume_trait(state, module, visibility):
			Ok(parsed): Ok({ declaration = TraitDeclaration(parsed.declaration), next = parsed.next })
			Err(error): Err(error)
	else if at_keyword(state, ImplementsKeyword):
		match consume_implementation(state, module, visibility):
			Ok(parsed): Ok({ declaration = FunctionDeclaration(ImplementationGroup(parsed.header, parsed.methods)), next = parsed.next })
			Err(error): Err(error)
	else if and(at_word(state, recognized_words(state).fixed_word), at_keyword(shifted(state, 1), RecordKeyword)):
		match consume_record(state, module, visibility):
			Ok(parsed):
				match end_value_line(parsed.next):
					Ok(next): Ok({ declaration = RecordDeclaration(parsed.declaration), next = next })
					Err(error): Err(error)
			Err(error): Err(error)
	else if at_keyword(state, OpaqueKeyword):
		match consume_opaque(state, module, visibility):
			Ok(parsed): Ok({ declaration = OpaqueDeclaration(parsed.declaration), next = parsed.next })
			Err(error): Err(error)
	else if and(at_identifier(state), at_colon(shifted(state, 1))):
		match consume_constant(state, module, visibility):
			Ok(parsed): Ok({ declaration = ConstantDeclaration(parsed.declaration), next = parsed.next })
			Err(error): Err(error)
	else if at_word(state, recognized_words(state).fixed_word):
		match consume_union(state, module, visibility):
			Ok(parsed): Ok({ declaration = UnionDeclaration(parsed.declaration), next = parsed.next })
			Err(error): Err(error)
	else:
		match consume_function(state, module, visibility):
			Ok(parsed): Ok({ declaration = FunctionDeclaration(FreeFunction(parsed.function)), next = parsed.next })
			Err(error): Err(error)


pure func parse_module(input: LexedProgram, module: ModuleId) -> Result[ParsedModule, Diagnostic]:
	var correct_source = same_source(input.end.source, module_source(module))

	for token in input.tokens:
		correct_source = and(correct_source, same_source(token.span.source, module_source(module)))

	_: Void ?= if correct_source:
		Ok(void)
	else:
		Err(source_bundle_error("parsed module's source does not match its module identity"))
	var imports: List[ParsedImport] = []
	var builtin_types: List[ParsedBuiltinType] = []
	var functions: List[ParsedFunctionGroup] = []
	var traits: List[ParsedTrait] = []
	var unions: List[ParsedUnion] = []
	var records: List[ParsedRecord] = []
	var opaques: List[ParsedOpaque] = []
	var constants: List[ParsedConstant] = []
	-- Whether a declaration other than an import block has been read.
	var declared: Bool = False
	-- One Result carries the parser to the end of the module or to the first error.
	var scan: Result[ParserState, Diagnostic] = Ok({ input = input, position = 0, aliases = [], context = FunctionBody, enclosure = Unbracketed })

	while True:
		match scan:
			Ok(state):
				if at_end(state):
					break

				scan = match consume_declaration(state, module, declared):
					Ok(parsed):
						match parsed.declaration:
							ImportBlock(rows):
								for row in rows:
									imports = imports.append(row)
							BuiltinTypeDeclaration(declaration):
								builtin_types = builtin_types.append(declaration)
								declared = True
							FunctionDeclaration(function):
								functions = functions.append(function)
								declared = True
							TraitDeclaration(declaration):
								traits = traits.append(declaration)
								declared = True
							UnionDeclaration(declaration):
								unions = unions.append(declaration)
								declared = True
							RecordDeclaration(declaration):
								records = records.append(declaration)
								declared = True
							OpaqueDeclaration(declaration):
								opaques = opaques.append(declaration)
								declared = True
							ConstantDeclaration(declaration):
								constants = constants.append(declaration)
								declared = True

						Ok(parsed.next)
					Err(error):
						Err(error)
			Err(_):
				break

	finished ?= scan
	Ok(into_opaque ParsedModule({
				base_names = input.base_names,
				names = input.names,
				module = module,
				imports = imports,
				builtin_types = builtin_types,
				functions = functions,
				traits = traits,
				unions = unions,
				records = records,
				opaques = opaques,
				constants = constants,
				end = input.end
			}))
