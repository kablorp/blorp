		ParsedConstant,
		ParsedFunction, ParsedTrait, ParsedTraitMethod(AbstractTraitMethod, DefaultTraitMethod), ParsedImplementationHeader,
		ParsedTypeParameter, ParsedReceiverHead(ReceiverName, QualifiedReceiverName),
