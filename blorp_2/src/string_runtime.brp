-- String is currently one immutable managed leaf: its bytes are inline in the
-- root allocation, so final release has no child ownership to traverse.
pure func string_runtime() -> String:
	raw
		|#include <inttypes.h>
		|#include <stdatomic.h>
		|#include <stddef.h>
		|#include <stdint.h>
		|#include <stdio.h>
		|#include <stdlib.h>
		|#include <string.h>
		|struct blorp_string {
		|atomic_size_t references;
		|int64_t length;
		|char bytes[];
		|};
		|/* Int64 decimal needs at most one sign, 19 digits and a trailing NUL. */
		|enum {BLORP_INT64_DECIMAL_CAPACITY=21};
		|struct blorp_string *blorp_int_to_string(int64_t value) {
		|char buffer[BLORP_INT64_DECIMAL_CAPACITY];
		|const int length=snprintf(buffer,sizeof buffer,"%" PRId64,value);
		|struct blorp_string *result=malloc(sizeof *result+(size_t)length+1);
		|if(result==NULL){abort();}
		|atomic_init(&result->references,1);
		|result->length=(int64_t)length;
		|memcpy(result->bytes,buffer,(size_t)length+1);
		|return result;
		|}
		|int64_t blorp_string_length(const struct blorp_string *value) {
		|return value->length;
		|}
		|void blorp_string_retain(struct blorp_string *value) {
		|atomic_fetch_add_explicit(&value->references,1,memory_order_relaxed);
		|}
		|void blorp_string_release(struct blorp_string *value) {
		|if(atomic_fetch_sub_explicit(&value->references,1,memory_order_acq_rel)==1){
		|free(value);
		|}
		|}
		|
