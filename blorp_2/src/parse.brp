import:
	./prelude: CheckedPrelude, prelude_names
	int as IntOps
	list: reverse
	names: NameTable, find_name, intern_name, program_names
	option: is_some, to_result
	result: and_then
	string: index_of
	syntax:
		BindingSyntax(ImmutableBinding, MutableBinding),
		CallNotation(DirectCall, ReceiverCall),
		DECIMAL_DIGITS,
		Diagnostic,
		ExpressionBase(IntegerExpression, NameExpression, DirectApplication),
		FieldPattern(FieldName, FieldWildcard),
		FunctionHeader,
		LexedProgram,
		ParsedBinding,
		ParsedBody(ParsedValueBody, ParsedMatchBody),
		ParsedBuiltinType(IntegerBuiltin, StringBuiltin),
		ParsedFunction,
		ParsedMatchArm,
		ParsedParameter,
		ParsedPattern(PatternName, PatternWildcard, PatternConstructor),
		ParsedPrelude,
		ParsedRuntimeFunction,
		ParsedRuntimeOperation(IntegerToStringBuiltin, StringLengthBuiltin),
		ParsedUnion,
		ParsedVariant,
		Purity(Pure, Impure),
		ReceiverApplication,
		Span,
		Symbol(
			PureKeyword, FunctionKeyword, MatchKeyword, Wildcard, LeftParen, RightParen, Dot, Arrow,
			Colon, Newline, VarKeyword, Equals, LeftBracket, RightBracket, Comma,
		),
		TokenKind(IdentifierToken, SymbolToken, IntegerLiteral, BuiltinLabel, Indentation),
		TypeSyntax(AtomicType, AppliedType),
		ValueExpression,
		WrittenName,
	text as Text


private fixed record ParserState {
	input: LexedProgram,
	position: Int,
	names: NameTable
}


fixed record ParsedContents {
	names: NameTable,
	prelude: CheckedPrelude,
	functions: List[ParsedFunction],
	unions: List[ParsedUnion],
	end: Span
}


-- Parsing carries its accepted prelude authority with its complete name table.
opaque type ParsedProgram = ParsedContents


pure func parsed_contents(program: ParsedProgram) -> ParsedContents:
	from_opaque ParsedProgram(program)


private fixed record ParsedName {
	name: WrittenName,
	next: ParserState
}


private pure func expected(state: ParserState, message: String, help: String) -> Diagnostic:
	span: Span = match state.input.tokens.get(state.position):
		Some(token):
			token.span
		None:
			state.input.end

	{
		span = span,
		note = None,
		message = message,
		help = help
	}


private pure func symbol_matches(actual: Symbol, expected: Symbol) -> Bool:
	match actual:
		VarKeyword:
			match expected:
				VarKeyword:
					True
				_:
					False
		Equals:
			match expected:
				Equals:
					True
				_:
					False
		PureKeyword:
			match expected:
				PureKeyword:
					True
				_:
					False
		FunctionKeyword:
			match expected:
				FunctionKeyword:
					True
				_:
					False
		LeftParen:
			match expected:
				LeftParen:
					True
				_:
					False
		RightParen:
			match expected:
				RightParen:
					True
				_:
					False
		LeftBracket:
			match expected:
				LeftBracket:
					True
				_:
					False
		RightBracket:
			match expected:
				RightBracket:
					True
				_:
					False
		Comma:
			match expected:
				Comma:
					True
				_:
					False
		Dot:
			match expected:
				Dot:
					True
				_:
					False
		Arrow:
			match expected:
				Arrow:
					True
				_:
					False
		Colon:
			match expected:
				Colon:
					True
				_:
					False
		Newline:
			match expected:
				Newline:
					True
				_:
					False
		MatchKeyword:
			match expected:
				MatchKeyword:
					True
				_:
					False
		Wildcard:
			match expected:
				Wildcard:
					True
				_:
					False


private pure func consume_symbol(
	state: ParserState,
	symbol: Symbol,
	message: String,
	help: String,
) -> Result[ParserState, Diagnostic]:
	match state.input.tokens.get(state.position):
		Some(token):
			match token.kind:
				SymbolToken(actual):
					if symbol_matches(actual, symbol):
						Ok({ state | position = IntOps.add(state.position, 1) })
					else:
						Err(expected(state, message, help))
				_:
					Err(expected(state, message, help))
		None:
			Err(expected(state, message, help))


private pure func identifier_help() -> String:
	"use an ASCII identifier starting with a letter or underscore; ".concat(
		"'func', 'pure', 'match', 'var', and lone '_' are reserved",
	)


private pure func consume_name(
	state: ParserState,
	message: String,
) -> Result[ParsedName, Diagnostic]:
	match state.input.tokens.get(state.position):
		Some(token):
			match token.kind:
				IdentifierToken(spelling):
					names = intern_name(state.names, spelling)

					match find_name(names, spelling):
						None:
							Err(
								expected(
									state,
									"invalid parsed name identity",
									"report this compiler error with the input program",
								),
							)
						Some(id):
							Ok({
								name = {
									id = id,
									span = token.span
								},
								next = { state |
									position = IntOps.add(state.position, 1),
									names = names
								},
							})
				_:
					Err(expected(state, message, identifier_help()))
		None:
			Err(expected(state, message, identifier_help()))


private fixed record ParsedValue {
	body: ValueExpression,
	next: ParserState
}


private fixed record ParsedParameters {
	parameters: List[ParsedParameter],
	next: ParserState
}


private fixed record FunctionResult {
	function: ParsedFunction,
	next: ParserState
}


private fixed record HeaderResult {
	header: FunctionHeader,
	next: ParserState
}


private pure func at_symbol(state: ParserState, symbol: Symbol) -> Bool:
	match state.input.tokens.get(state.position):
		Some(token):
			match token.kind:
				SymbolToken(actual):
					symbol_matches(actual, symbol)
				_:
					False
		None:
			False


private pure func at_indent(state: ParserState) -> Bool:
	match state.input.tokens.get(state.position):
		Some(token):
			match token.kind:
				Indentation(_):
					True
				_:
					False
		None:
			False


private pure func consume_indent(
	state: ParserState,
	depth: Int,
	message: String,
	help: String,
) -> Result[ParserState, Diagnostic]:
	match state.input.tokens.get(state.position):
		Some(token):
			match token.kind:
				Indentation(actual):
					if IntOps.equals(actual, depth):
						Ok({ state | position = IntOps.add(state.position, 1) })
					else:
						Err(expected(state, message, help))
				_:
					Err(expected(state, message, help))
		None:
			Err(expected(state, message, help))


private DECIMAL_RADIX: Int = 10


private pure func integer_error(span: Span, message: String, help: String) -> Diagnostic:
	{
		span = span,
		note = None,
		message = message,
		help = help
	}


private pure func invalid_integer(span: Span) -> Diagnostic:
	integer_error(
		span,
		"invalid integer literal",
		"write decimal digits, optionally preceded by an adjacent '-'",
	)


private pure func integer_value(spelling: String, span: Span) -> Result[Int, Diagnostic]:
	negative: Bool = spelling.starts_with("-")

	digit_start: Int = if negative:
		1
	else:
		0

	if IntOps.equals(digit_start, spelling.length()):
		Err(invalid_integer(span))
	else if IntOps.less_than(
		IntOps.add(digit_start, 1),
		spelling.length(),
	) and Text.equals(
		spelling.substring(digit_start, 1),
		"0",
	):
		Err(
			integer_error(
				span,
				"integer literals cannot have leading zeros",
				"write 0 or -0, or remove the leading zeros",
			),
		)
	else:
		limit: Int = if negative:
			IntOps.INT_MIN
		else:
			IntOps.subtract(0, IntOps.INT_MAX)

		decimal_cutoff: Int = IntOps.divide(limit, DECIMAL_RADIX)
		var position: Int = digit_start
		var value: Int = 0
		var failure: Option[Diagnostic] = None

		while IntOps.less_than(position, spelling.length()):
			match DECIMAL_DIGITS.index_of(spelling.substring(position, 1)):
				None:
					failure = Some(invalid_integer(span))
					break
				Some(digit):
					-- Accumulate negatively so the minimum needs no overflowing magnitude.
					if IntOps.less_than(value, decimal_cutoff) or IntOps.less_than(
						IntOps.multiply(value, DECIMAL_RADIX),
						IntOps.add(limit, digit),
					):
						failure = Some(
							integer_error(
								span,
								"integer literal is outside the Int64 range",
								"use a value from -9223372036854775808 to 9223372036854775807",
							),
						)
						break

					value = IntOps.subtract(
						IntOps.multiply(value, DECIMAL_RADIX),
						digit,
					)
					position = IntOps.add(position, 1)

		match failure:
			Some(error):
				Err(error)
			None:
				if negative:
					Ok(value)
				else:
					Ok(IntOps.subtract(0, value))


private pure func reject_function_type_arguments(state: ParserState) -> Result[Void, Diagnostic]:
	if at_symbol(state, LeftBracket):
		Err(
			expected(
				state,
				"explicit function type arguments are unsupported",
				"omit the brackets at calls; argument types determine the type parameters",
			),
		)
	else:
		Ok(void)


private fixed record ParsedArguments {
	arguments: List[ValueExpression],
	next: ParserState
}


private pure func consume_arguments(start: ParserState) -> Result[ParsedArguments, Diagnostic]:
	var state = start
	var arguments: List[ValueExpression] = []
	var failure: Option[Diagnostic] = None

	if not at_symbol(state, RightParen):
		while True:
			match consume_value(state):
				Err(error):
					failure = Some(error)
					break
				Ok(value):
					arguments = arguments.append(value.body)
					state = value.next

			if not at_symbol(state, Comma):
				break

			state = { state | position = IntOps.add(state.position, 1) }

	ready ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	closed ?= consume_symbol(
		state,
		RightParen,
		"expected ')' after the call arguments",
		"separate complete expressions with commas, then close the call with ')'",
	)
	Ok({
		arguments = arguments,
		next = closed,
	})


private pure func consume_value(start: ParserState) -> Result[ParsedValue, Diagnostic]:
	token ?= start.input.tokens
		.get(start.position)
		.to_result(
			expected(
				start,
				"expected a return expression",
				"use a literal, a parameter or variant name, or a call as the entire body",
			),
		)
	after_token = { start | position = IntOps.add(start.position, 1) }

	base_result: Result[ParsedValue, Diagnostic] = match token.kind:
		IntegerLiteral(spelling):
			integer ?= integer_value(spelling, token.span)
			Ok({
				body = {
					base = IntegerExpression(integer),
					base_span = token.span,
					applications = [],
					span = token.span
				},
				next = after_token,
			})
		IdentifierToken(_):
			name ?= consume_name(start, "expected a value name")
			implicit_arguments ?= reject_function_type_arguments(name.next)

			if at_symbol(name.next, LeftParen):
				arguments ?= consume_arguments(
					{ name.next | position = IntOps.add(name.next.position, 1) },
				)
				Ok({
					body = {
						base = DirectApplication(name.name, arguments.arguments),
						base_span = token.span,
						applications = [],
						span = token.span
					},
					next = arguments.next,
				})
			else:
				Ok({
					body = {
						base = NameExpression(name.name),
						base_span = token.span,
						applications = [],
						span = token.span
					},
					next = name.next,
				})
		BuiltinLabel(_):
			Err(
				expected(
					start,
					"quoted builtin labels are only allowed in the prelude",
					"call a String-producing prelude function; String literals are not supported yet",
				),
			)
		_:
			Err(
				expected(
					start,
					"expected a return expression",
					"use a literal, a parameter or variant name, or a call as the entire body",
				),
			)

	parsed ?= base_result
	var state = parsed.next
	var applications: List[ReceiverApplication] = []
	var failure: Option[Diagnostic] = None

	while at_symbol(state, Dot):
		name_result = consume_name(
			{ state | position = IntOps.add(state.position, 1) },
			"expected a function name after '.'",
		)

		result: Result[ParsedArguments, Diagnostic] = match name_result:
			Err(error):
				Err(error)
			Ok(name):
				consume_receiver_arguments(name)

		match result:
			Err(error):
				failure = Some(error)
				break
			Ok(arguments):
				match name_result:
					Ok(name):
						applications = applications.append({
							callee = name.name,
							arguments = arguments.arguments,
						})
					Err(_):
						void

				state = arguments.next

	ready ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	last ?= state.input.tokens
		.get(IntOps.subtract(state.position, 1))
		.to_result(
			expected(
				state,
				"invalid expression span",
				"report this compiler error with the input program",
			),
		)
	Ok({
		body = { parsed.body |
			applications = applications,
			span = {
				start = token.span.start,
				end = last.span.end
			}
		},
		next = state,
	})


private fixed record ParsedType {
	written: TypeSyntax,
	next: ParserState
}


private pure func consume_type(
	state: ParserState,
	message: String,
) -> Result[ParsedType, Diagnostic]:
	name ?= consume_name(state, message)

	if not at_symbol(name.next, LeftBracket):
		Ok({
			written = AtomicType(name.name),
			next = name.next,
		})
	else:
		var current = { name.next | position = IntOps.add(name.next.position, 1) }
		var arguments: List[WrittenName] = []
		var failure: Option[Diagnostic] = None

		while True:
			match consume_name(current, "expected a type argument"):
				Err(error):
					failure = Some(error)
					break
				Ok(argument):
					arguments = arguments.append(argument.name)
					current = argument.next

			if at_symbol(current, LeftBracket):
				failure = Some(
					expected(
						current,
						"nested type applications are not supported",
						Text.concat(
							"use Int, String, a declared parameter, or an ordinary union ",
							"as the written argument",
						),
					),
				)
				break

			if not at_symbol(current, Comma):
				break

			current = { current | position = IntOps.add(current.position, 1) }

		ready ?= match failure:
			Some(error):
				Err(error)
			None:
				Ok(void)

		closed ?= consume_symbol(
			current,
			RightBracket,
			"expected ']' after the type arguments",
			"write comma-separated atomic type arguments, such as Result[Int, Int]",
		)
		closing ?= current.input.tokens
			.get(current.position)
			.to_result(
				expected(
					current,
					"expected ']' after the type arguments",
					"close the type application",
				),
			)
		Ok({
			written = AppliedType(
				name.name,
				arguments,
				{
					start = name.name.span.start,
					end = closing.span.end
				},
			),
			next = closed,
		})


private pure func consume_parameters(start: ParserState) -> Result[ParsedParameters, Diagnostic]:
	var state = start
	var parameters: List[ParsedParameter] = []
	var failure: Option[Diagnostic] = None

	if not at_symbol(state, RightParen):
		while True:
			result: Result[ParsedParameterResult, Diagnostic] = match consume_name(
				state,
				"expected a parameter name or ')'",
			):
				Err(error):
					Err(error)
				Ok(name):
					consume_parameter_type(name)

			match result:
				Err(error):
					failure = Some(error)
					break
				Ok(next):
					parameters = parameters.append(next.parameter)
					state = next.next

			if not at_symbol(state, Comma):
				break

			state = { state | position = IntOps.add(state.position, 1) }

	ready ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	closed ?= consume_symbol(
		state,
		RightParen,
		"expected ')' after the parameters",
		"separate explicitly typed parameters with commas, then close with ')'",
	)
	Ok({
		parameters = parameters,
		next = closed,
	})


private fixed record PatternResult {
	pattern: ParsedPattern,
	span: Span,
	next: ParserState
}


private pure func consume_pattern(state: ParserState) -> Result[PatternResult, Diagnostic]:
	if at_symbol(state, Wildcard):
		token ?= state.input.tokens
			.get(state.position)
			.to_result(expected(state, "expected a pattern", "write a variant, a binding, or '_'"))
		Ok({
			pattern = PatternWildcard(token.span),
			span = token.span,
			next = { state | position = IntOps.add(state.position, 1) },
		})
	else:
		name ?= consume_name(state, "expected a match pattern")

		if not at_symbol(name.next, LeftParen):
			Ok({
				pattern = PatternName(name.name),
				span = name.name.span,
				next = name.next,
			})
		else:
			opened = { name.next | position = IntOps.add(name.next.position, 1) }
			field ?= consume_pattern_field(opened)
			closed ?= consume_symbol(
				field.next,
				RightParen,
				"expected ')' after the constructor pattern",
				"write Variant(name), Variant(_), or a nullary Variant()",
			)
			last ?= field.next.input.tokens
				.get(field.next.position)
				.to_result(expected(field.next, "expected ')'", "close the constructor pattern"))
			span: Span = {
				start = name.name.span.start,
				end = last.span.end
			}
			Ok({
				pattern = PatternConstructor(name.name, field.fields, span),
				span = span,
				next = closed,
			})


private fixed record PatternFieldResult {
	fields: Option[FieldPattern],
	next: ParserState
}


private pure func consume_pattern_field(
	state: ParserState,
) -> Result[PatternFieldResult, Diagnostic]:
	if at_symbol(state, RightParen):
		Ok({
			fields = None,
			next = state,
		})
	else if at_symbol(state, Wildcard):
		token ?= state.input.tokens
			.get(state.position)
			.to_result(
				expected(
					state,
					"expected a field pattern",
					"bind the Int field with a name or ignore it with '_'",
				),
			)
		Ok({
			fields = Some(FieldWildcard(token.span)),
			next = { state | position = IntOps.add(state.position, 1) },
		})
	else:
		name ?= consume_name(state, "expected an Int field binding or '_'")
		Ok({
			fields = Some(FieldName(name.name)),
			next = name.next,
		})


private fixed record BodyResult {
	body: ParsedBody,
	next: ParserState
}


private pure func consume_match(start: ParserState) -> Result[BodyResult, Diagnostic]:
	keyword ?= start.input.tokens
		.get(start.position)
		.to_result(
			expected(
				start,
				"expected 'match'",
				"write match value: followed by indented arms",
			),
		)
	after_keyword = { start | position = IntOps.add(start.position, 1) }

	scrutinee ?= match after_keyword.input.tokens.get(after_keyword.position):
		Some(token):
			if IntOps.greater_than(token.span.start, keyword.span.end):
				consume_value(after_keyword)
			else:
				Err(
					expected(
						after_keyword,
						"expected a space after 'match'",
						"put a space between 'match' and the matched expression",
					),
				)
		None:
			consume_value(after_keyword)

	colon ?= consume_symbol(
		scrutinee.next,
		Colon,
		"expected ':' after the match value",
		"write match value: and put each arm on the next line",
	)
	newline ?= consume_symbol(
		colon,
		Newline,
		"expected a newline after the match header",
		"put each pattern on its own indented line, with an inline or indented result",
	)
	var state = newline
	var arms: List[ParsedMatchArm] = []
	var end = keyword.span.end
	var failure: Option[Diagnostic] = None

	while True:
		match consume_arm(state):
			Err(error):
				failure = Some(error)
				break
			Ok(arm):
				arms = arms.append(arm.arm)
				end = arm.arm.span.end
				state = arm.next

		if not at_symbol(state, Newline):
			break

		next = { state | position = IntOps.add(state.position, 1) }

		if not at_indent(next):
			break

		state = next

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({
				body = ParsedMatchBody({
					scrutinee = scrutinee.body,
					arms = arms,
					keyword_span = keyword.span,
					span = {
						start = keyword.span.start,
						end = end
					},
				}),
				next = state,
			})


private fixed record ArmResult {
	arm: ParsedMatchArm,
	next: ParserState
}


private pure func consume_arm(state: ParserState) -> Result[ArmResult, Diagnostic]:
	indented ?= consume_indent(
		state,
		2,
		"expected a match arm indented two levels",
		"indent each arm with two tabs or eight spaces",
	)
	pattern ?= consume_pattern(indented)
	colon ?= consume_symbol(
		pattern.next,
		Colon,
		"expected ':' after the match pattern",
		"write Pattern: expression, or put the arm body on the next indented line",
	)

	prefix ?= if at_symbol(colon, Newline):
		consume_binding_indent(
			{ colon | position = IntOps.add(colon.position, 1) },
			ArmBindings,
		).and_then(
			pure func(
				indented: ParserState,
			) -> Result[BindingPrefix, Diagnostic]: consume_bindings(indented, ArmBindings),
		)
	else:
		Ok({
			bindings = [],
			next = colon,
		})

	body ?= consume_value(prefix.next)
	Ok({
		arm = {
			pattern = pattern.pattern,
			bindings = prefix.bindings,
			body = body.body,
			span = {
				start = pattern.span.start,
				end = body.body.span.end
			}
		},
		next = body.next,
	})


private pure func consume_function_body(state: ParserState) -> Result[BodyResult, Diagnostic]:
	if at_symbol(state, MatchKeyword):
		consume_match(state)
	else:
		value ?= consume_value(state)
		Ok({
			body = ParsedValueBody(value.body),
			next = value.next,
		})


private fixed record BindingPrefix {
	bindings: List[ParsedBinding],
	next: ParserState
}


private fixed union BindingBlock:
	FunctionBindings
	ArmBindings


private pure func consume_binding_indent(
	state: ParserState,
	block: BindingBlock,
) -> Result[ParserState, Diagnostic]:
	match block:
		FunctionBindings:
			consume_indent(
				state,
				1,
				"expected a final expression after the bindings",
				"finish the function with a value expression or tail match indented one level",
			)
		ArmBindings:
			consume_indent(
				state,
				3,
				"expected a match arm result indented three levels",
				"finish the arm with a value expression indented with three tabs or twelve spaces",
			)


private pure func at_binding(state: ParserState) -> Bool:
	if at_symbol(state, VarKeyword):
		True
	else:
		match state.input.tokens.get(state.position):
			Some(token):
				match token.kind:
					IdentifierToken(_):
						at_symbol({ state | position = IntOps.add(state.position, 1) }, Equals)
					_:
						False
			None:
				False


private fixed record BindingLine {
	binding: ParsedBinding,
	next: ParserState
}


private pure func consume_binding(
	state: ParserState,
	block: BindingBlock,
) -> Result[BindingLine, Diagnostic]:
	mutability = if at_symbol(state, VarKeyword):
		MutableBinding
	else:
		ImmutableBinding

	after_keyword = match mutability:
		MutableBinding:
			{ state | position = IntOps.add(state.position, 1) }
		ImmutableBinding:
			state

	name ?= consume_name(after_keyword, "expected a binding name")
	equals ?= consume_symbol(
		name.next,
		Equals,
		"expected '=' after the binding name",
		"write name = expression or var name = expression",
	)

	initializer ?= if (
		at_symbol(equals, Newline)
		or IntOps.equals(equals.position, equals.input.tokens.length())
	):
		Err(
			expected(
				equals,
				"expected a binding initializer",
				"put one expression after '=' on the same line",
			),
		)
	else:
		consume_value(equals)

	message = match block:
		FunctionBindings:
			"expected a final expression after the bindings"
		ArmBindings:
			"expected a final expression after the arm bindings"

	help = match block:
		FunctionBindings:
			"finish the function with a value expression or tail match"
		ArmBindings:
			"finish the arm with a value expression on its own indented line"

	newline ?= consume_symbol(initializer.next, Newline, message, help)
	next ?= consume_binding_indent(newline, block)
	Ok({
		binding = {
			name = name.name,
			mutability = mutability,
			initializer = initializer.body
		},
		next = next,
	})


private pure func consume_bindings(
	start: ParserState,
	block: BindingBlock,
) -> Result[BindingPrefix, Diagnostic]:
	var state = start
	var bindings: List[ParsedBinding] = []
	var failure: Option[Diagnostic] = None

	while at_binding(state):
		match consume_binding(state, block):
			Err(error):
				failure = Some(error)
				break
			Ok(line):
				bindings = bindings.append(line.binding)
				state = line.next

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({
				bindings = bindings,
				next = state,
			})


private fixed record ParsedTypeParameters {
	parameters: List[WrittenName],
	next: ParserState
}


private pure func valid_type_parameter_name(spelling: String) -> Bool:
	var accepted = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".contains(spelling.substring(0, 1))
	var position: Int = 1

	while IntOps.less_than(position, spelling.length()):
		accepted = (
			accepted
			and "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789".contains(
				spelling.substring(
					position,
					1,
				),
			)
		)
		position = IntOps.add(position, 1)

	accepted


private pure func consume_type_parameters(
	state: ParserState,
) -> Result[ParsedTypeParameters, Diagnostic]:
	if not at_symbol(state, LeftBracket):
		Ok({
			parameters = [],
			next = state,
		})
	else:
		var current: ParserState = { state | position = IntOps.add(state.position, 1) }
		var parameters: List[WrittenName] = []
		var failure: Option[Diagnostic] = None

		while True:
			name_result = match current.input.tokens.get(current.position):
				Some(token):
					match token.kind:
						IdentifierToken(spelling):
							if valid_type_parameter_name(spelling):
								consume_name(current, "expected a type parameter name")
							else:
								Err({
									span = token.span,
									note = None,
									message = "invalid type parameter name",
									help = (
										"start with a capital ASCII letter and use only ASCII letters and digits, such "
										+ "as T or Element2"
									),
								})
						_:
							Err(
								expected(
									current,
									"expected a type parameter name",
									"declare type parameters separated by commas, such as [A, B]",
								),
							)
				None:
					Err(
						expected(
							current,
							"expected a type parameter name",
							"declare type parameters separated by commas, such as [A, B]",
						),
					)

			match name_result:
				Err(error):
					failure = Some(error)
					break
				Ok(name):
					parameters = parameters.append(name.name)
					current = name.next

			if at_symbol(current, RightBracket):
				current = { current | position = IntOps.add(current.position, 1) }
				break
			else if at_symbol(current, Comma):
				current = { current | position = IntOps.add(current.position, 1) }
			else:
				failure = Some(
					expected(
						current,
						"expected ',' or ']' after a type parameter",
						"separate type parameters with commas and close the list with ']'",
					),
				)
				break

		match failure:
			Some(error):
				Err(error)
			None:
				Ok({
					parameters = parameters,
					next = current,
				})


private pure func consume_header(start: ParserState) -> Result[HeaderResult, Diagnostic]:
	purity: Purity = match start.input.tokens.get(start.position):
		Some(token):
			match token.kind:
				SymbolToken(PureKeyword):
					Pure
				_:
					Impure
		None:
			Impure

	after_func ?= match purity:
		Pure:
			consume_symbol(
				{ start | position = IntOps.add(start.position, 1) },
				FunctionKeyword,
				"expected 'func' after 'pure'",
				"write pure func name() -> Int:",
			)
		Impure:
			consume_symbol(
				start,
				FunctionKeyword,
				"expected a function declaration at column 1",
				"start with func main() -> Int:",
			)

	function ?= consume_name(after_func, "expected a function name")
	type_parameters ?= consume_type_parameters(function.next)
	after_open ?= consume_symbol(
		type_parameters.next,
		LeftParen,
		"expected '(' after the function name",
		"write main() or helper(value: Int)",
	)
	parameters ?= consume_parameters(after_open)
	after_arrow ?= consume_symbol(
		parameters.next,
		Arrow,
		"expected '->' before the return type",
		"write main() -> Int with adjacent arrow characters",
	)
	return_type ?= consume_type(after_arrow, "expected a return type")
	after_header ?= consume_symbol(
		return_type.next,
		Colon,
		"expected ':' after the function header",
		"end the header with ':' and put the return expression on the next line",
	)
	after_newline ?= consume_symbol(
		after_header,
		Newline,
		"expected a newline after the function header",
		"put the return expression on the next line",
	)
	after_indent ?= consume_indent(
		after_newline,
		1,
		"expected an indent of one tab or four spaces",
		"indent the body with exactly one tab or four spaces",
	)
	Ok({
		header = {
			purity = purity,
			function_name = function.name,
			type_parameters = type_parameters.parameters,
			parameters = parameters.parameters,
			return_type = return_type.written
		},
		next = after_indent,
	})


private pure func consume_function(start: ParserState) -> Result[FunctionResult, Diagnostic]:
	header ?= consume_header(start)
	prefix ?= consume_bindings(header.next, FunctionBindings)
	body ?= consume_function_body(prefix.next)
	Ok({
		function = {
			purity = header.header.purity,
			function_name = header.header.function_name,
			type_parameters = header.header.type_parameters,
			parameters = header.header.parameters,
			return_type = header.header.return_type,
			bindings = prefix.bindings,
			body = body.body
		},
		next = body.next,
	})


private pure func at_word(state: ParserState, word: String) -> Bool:
	match state.input.tokens.get(state.position):
		Some(token):
			match token.kind:
				IdentifierToken(spelling):
					Text.equals(spelling, word)
				_:
					False
		None:
			False


private fixed record UnionResult {
	declaration: ParsedUnion,
	next: ParserState
}


private fixed record VariantResult {
	variant: ParsedVariant,
	next: ParserState
}


private pure func consume_variant(state: ParserState) -> Result[VariantResult, Diagnostic]:
	indented ?= consume_indent(
		state,
		1,
		"expected an indented union variant",
		"declare at least one variant, indented with one tab or four spaces",
	)
	name ?= consume_name(indented, "expected a union variant name")

	if at_symbol(name.next, LeftParen):
		field ?= consume_name(
			{ name.next | position = IntOps.add(name.next.position, 1) },
			"expected a payload type",
		)
		closed ?= consume_symbol(
			field.next,
			RightParen,
			"expected ')' after the payload type",
			"declare zero fields or one payload field, written Variant(Int) or Variant(T)",
		)
		Ok({
			variant = {
				name = name.name,
				payload = Some(field.name)
			},
			next = closed,
		})
	else:
		Ok({
			variant = {
				name = name.name,
				payload = None
			},
			next = name.next,
		})


private pure func consume_union(start: ParserState) -> Result[UnionResult, Diagnostic]:
	after_fixed: ParserState = { start | position = IntOps.add(start.position, 1) }

	word ?= if at_word(after_fixed, "union"):
		Ok({ after_fixed | position = IntOps.add(after_fixed.position, 1) })
	else:
		Err(
			expected(
				after_fixed,
				"expected 'union' after 'fixed'",
				"write fixed union Choice: followed by indented variant names",
			),
		)

	name ?= consume_name(word, "expected a union type name")
	type_parameters ?= consume_type_parameters(name.next)

	colon ?= consume_symbol(
		type_parameters.next,
		Colon,
		"expected ':' after the union type name",
		"write fixed union Choice: or fixed union Box[T]:",
	)
	newline ?= consume_symbol(
		colon,
		Newline,
		"expected a newline after the union header",
		"put each variant name on its own indented line",
	)
	var state = newline
	var variants: List[ParsedVariant] = []
	var failure: Option[Diagnostic] = None

	while True:
		match consume_variant(state):
			Err(error):
				failure = Some(error)
				break
			Ok(variant):
				variants = variants.append(variant.variant)
				state = variant.next

		if IntOps.equals(state.position, start.input.tokens.length()):
			break

		if not at_symbol(state, Newline):
			failure = Some(
				expected(
					state,
					"expected a newline after the variant name",
					"put each variant on its own indented line",
				),
			)
			break

		next: ParserState = { state | position = IntOps.add(state.position, 1) }

		if not at_indent(next):
			break

		state = next

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({
				declaration = {
					type_name = name.name,
					type_parameters = type_parameters.parameters,
					variants = variants
				},
				next = state,
			})


private pure func consume_word(state: ParserState, word: String) -> Result[ParserState, Diagnostic]:
	if at_word(state, word):
		Ok({ state | position = IntOps.add(state.position, 1) })
	else:
		Err(
			expected(
				state,
				Text
					.concat("expected '", word)
					.concat("'"),
				"use the temporary prelude declaration syntax",
			),
		)


private fixed record BuiltinTypeResult {
	declaration: ParsedBuiltinType,
	next: ParserState
}


private pure func consume_builtin_type(start: ParserState) -> Result[BuiltinTypeResult, Diagnostic]:
	after_type ?= consume_word(start, "type")
	integer = at_word(after_type, "Int")

	known ?= if integer or at_word(after_type, "String"):
		Ok(void)
	else:
		Err(
			expected(
				after_type,
				"unknown builtin type",
				"declare type Int = builtin or type String = builtin",
			),
		)

	name ?= consume_name(after_type, "expected a builtin type name")
	equals ?= consume_symbol(
		name.next,
		Equals,
		"expected '=' after the builtin type name",
		"write type Int = builtin or type String = builtin",
	)
	end ?= consume_word(equals, "builtin")

	declaration = if integer:
		IntegerBuiltin(name.name)
	else:
		StringBuiltin(name.name)

	Ok({
		declaration = declaration,
		next = end,
	})


private fixed record RuntimeFunctionResult {
	function: ParsedRuntimeFunction,
	next: ParserState
}


private pure func consume_runtime_function(
	start: ParserState,
) -> Result[RuntimeFunctionResult, Diagnostic]:
	header ?= consume_header(start)
	after_builtin ?= consume_word(header.next, "builtin")
	opened ?= consume_symbol(
		after_builtin,
		LeftParen,
		"expected '(' after builtin",
		"write builtin(\"int.to_string\") or builtin(\"string.length\")",
	)
	label ?= opened.input.tokens
		.get(opened.position)
		.to_result(
			expected(
				opened,
				"expected a builtin label",
				"use \"int.to_string\" or \"string.length\"",
			),
		)

	operation ?= match label.kind:
		BuiltinLabel(spelling):
			if Text.equals(spelling, "int.to_string"):
				Ok(IntegerToStringBuiltin)
			else if Text.equals(spelling, "string.length"):
				Ok(StringLengthBuiltin)
			else:
				Err(
					expected(
						opened,
						"unknown builtin operation",
						"use \"int.to_string\" or \"string.length\"",
					),
				)
		_:
			Err(
				expected(
					opened,
					"expected a quoted builtin label",
					"use \"int.to_string\" or \"string.length\"",
				),
			)

	closed ?= consume_symbol(
		{ opened | position = IntOps.add(opened.position, 1) },
		RightParen,
		"expected ')' after the builtin label",
		"give builtin exactly one quoted operation label",
	)
	Ok({
		function = {
			header = header.header,
			operation = operation,
			span = label.span
		},
		next = closed,
	})


-- Prelude parsing uses the same tokens, headers and name authority as programs.
-- Only this entrypoint admits compiler-known type and operation declarations.
pure func parse_prelude(input: LexedProgram) -> Result[ParsedPrelude, Diagnostic]:
	seed = program_names()
	var state: ParserState = {
		input = input,
		position = 0,
		names = seed.names
	}
	var types: List[ParsedBuiltinType] = []
	var functions: List[ParsedRuntimeFunction] = []
	var failure: Option[Diagnostic] = None

	while IntOps.less_than(state.position, input.tokens.length()):
		if at_word(state, "type"):
			match consume_builtin_type(state):
				Err(error):
					failure = Some(error)
					break
				Ok(parsed):
					types = types.append(parsed.declaration)
					state = parsed.next
		else if at_symbol(state, FunctionKeyword) or at_symbol(state, PureKeyword):
			match consume_runtime_function(state):
				Err(error):
					failure = Some(error)
					break
				Ok(parsed):
					functions = functions.append(parsed.function)
					state = parsed.next
		else:
			failure = Some(
				expected(
					state,
					"expected a builtin prelude declaration",
					Text.concat(
						"declare type Int = builtin, type String = builtin, ",
						"or a pure function with a builtin(...) body",
					),
				),
			)
			break

		if IntOps.equals(state.position, input.tokens.length()):
			break

		match consume_symbol(
			state,
			Newline,
			"expected a newline after the prelude declaration",
			"put each prelude declaration on its own line without blank lines",
		):
			Err(error):
				failure = Some(error)
				break
			Ok(next):
				state = next

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({
				names = state.names,
				main = seed.main,
				types = types,
				functions = functions,
				end = input.end,
			})


pure func parse(input: LexedProgram, prelude: CheckedPrelude) -> Result[ParsedProgram, Diagnostic]:
	initial = prelude_names(prelude)
	var state: ParserState = {
		input = input,
		position = 0,
		names = initial.names
	}
	var functions: List[ParsedFunction] = []
	var unions: List[ParsedUnion] = []
	var failure: Option[Diagnostic] = None

	while True:
		if at_word(state, "fixed"):
			match consume_union(state):
				Err(error):
					failure = Some(error)
					break
				Ok(parsed):
					unions = unions.append(parsed.declaration)
					state = parsed.next
		else:
			match consume_function(state):
				Err(error):
					failure = Some(error)
					break
				Ok(parsed):
					functions = functions.append(parsed.function)
					state = parsed.next

		if IntOps.equals(state.position, input.tokens.length()):
			break

		match consume_symbol(
			state,
			Newline,
			"expected a newline after the return expression",
			"separate declarations with one newline and no blank lines",
		):
			Err(error):
				failure = Some(error)
				break
			Ok(next):
				state = next

		if IntOps.equals(state.position, input.tokens.length()):
			break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(into_opaque ParsedProgram({
						names = state.names,
						prelude = prelude,
						functions = functions,
						unions = unions,
						end = input.end
					}))


private pure func consume_receiver_arguments(
	name: ParsedName,
) -> Result[ParsedArguments, Diagnostic]:
	implicit_arguments ?= reject_function_type_arguments(name.next)
	opened ?= consume_symbol(
		name.next,
		LeftParen,
		"expected '(' after the UFCS function name",
		"write receiver.function(arguments)",
	)
	consume_arguments(opened)


private fixed record ParsedParameterResult {
	parameter: ParsedParameter,
	next: ParserState
}


private pure func consume_parameter_type(
	name: ParsedName,
) -> Result[ParsedParameterResult, Diagnostic]:
	after_colon ?= consume_symbol(
		name.next,
		Colon,
		"expected ':' after the parameter name",
		"write each parameter as name: Type",
	)
	type_name ?= consume_type(after_colon, "expected a parameter type")
	Ok({
		parameter = {
			name = name.name,
			type_name = type_name.written
		},
		next = type_name.next,
	})
