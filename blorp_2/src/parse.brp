import:
	float as FloatOps
	int as IntOps
	list: reverse
	names: NameId, NameTable, intern_name
	option: is_some, to_result
	result: and_then
	source: ModuleId, module_source, same_source
	string as StringOps: index_of
	syntax:
		BindingSyntax(ImmutableBinding, MutableBinding),
		CallNotation(DirectCall, ReceiverCall),
		DECIMAL_DIGITS,
		Diagnostic,
		ExpressionBase(
			VoidExpression, IntegerExpression, FloatExpression, StringExpression, NameExpression, DirectApplication,
			RecordExpression,
		),
		FieldPattern(FieldName, FieldWildcard),
		FunctionHeader,
		LexedProgram,
		ParsedBinding,
		ParsedBody(ParsedBuiltinBody, ParsedValueBody, ParsedMatchBody),
		ParsedBuiltinType(IntegerBuiltin, FloatBuiltin, StringBuiltin, VoidBuiltin, ListBuiltin),
		ParsedFunction,
		ParsedMatchArm,
		ParsedParameter,
		ParsedPattern(PatternName, PatternWildcard, PatternConstructor),
		ParsedRecord,
		ParsedRecordField,
		ParsedRuntimeOperation(
			IntegerAddBuiltin, IntegerToStringBuiltin, StringLengthBuiltin, StringPrintBuiltin,
			StringParseIntBuiltin, ListLengthBuiltin, ListGetBuiltin, StringEqualsBuiltin, IntegerEqualsBuiltin, IntegerSubtractBuiltin,
			IntegerMultiplyBuiltin, IntegerDivideBuiltin, IntegerRemainderBuiltin,
			FloatAddBuiltin, FloatSubtractBuiltin, FloatMultiplyBuiltin, FloatDivideBuiltin,
			FloatRemainderBuiltin, FloatToStringBuiltin, StringParseFloatBuiltin,
		),
		ParsedStatement(BindingStatement, ExpressionStatement),
		ParsedUnion,
		ParsedVariant,
		PostfixOperation(ReceiverInvocation, FieldAccess),
		Purity(Pure, Impure),
		ReceiverApplication,
		Span,
		Symbol(
			PureKeyword, FunctionKeyword, MatchKeyword, Wildcard, LeftParen, RightParen, Dot, Arrow,
			Colon, Newline, VarKeyword, VoidKeyword, Equals, LeftBracket, RightBracket, LeftBrace,
			RightBrace, Comma, AtSign, Slash, Star,
		),
		TokenKind(IdentifierToken, SymbolToken, IntegerLiteral, FloatLiteral, QuotedString, Indentation),
		TypeSyntax(AtomicType, AppliedType),
		ValueExpression,
		WrittenName,
		source_bundle_error,
	text as Text: concat


private fixed record ParserState {
	input: LexedProgram,
	position: Int,
	names: NameTable
}


fixed union ImportOrigin:
	RelativeImport(Int)
	LibraryImport


fixed record ModulePath {
	origin: ImportOrigin,
	parts: List[NameId]
}


fixed union ImportSelection:
	NamedSelection(WrittenName)
	ConstructorSelection(WrittenName, List[WrittenName])
	MethodsOnlySelection(WrittenName, Span)


fixed record ParsedImport {
	path: ModulePath,
	symbols: List[ImportSelection],
	span: Span
}


-- `base_names` is the table this parse extended; `names` adds its spellings.
fixed record ParsedModuleContents {
	base_names: NameTable,
	names: NameTable,
	module: ModuleId,
	imports: List[ParsedImport],
	builtin_types: List[ParsedBuiltinType],
	functions: List[ParsedFunction],
	unions: List[ParsedUnion],
	records: List[ParsedRecord],
	end: Span
}


-- Only `parse_module` constructs a module's syntax; readers see its contents.
opaque type ParsedModule = ParsedModuleContents


pure func module_contents(parsed: ParsedModule) -> ParsedModuleContents:
	from_opaque ParsedModule(parsed)


private fixed record ParsedName {
	name: WrittenName,
	next: ParserState
}


private pure func expected(state: ParserState, message: String, help: String) -> Diagnostic:
	span: Span = match state.input.tokens.get(state.position):
		Some(token):
			token.span
		None:
			state.input.end

	{
		span = span,
		note = None,
		message = message,
		help = help
	}


private pure func symbol_matches(actual: Symbol, expected: Symbol) -> Bool:
	match actual:
		AtSign:
			match expected:
				AtSign:
					True
				_:
					False
		LeftBrace:
			match expected:
				LeftBrace:
					True
				_:
					False
		RightBrace:
			match expected:
				RightBrace:
					True
				_:
					False
		VoidKeyword:
			match expected:
				VoidKeyword:
					True
				_:
					False
		VarKeyword:
			match expected:
				VarKeyword:
					True
				_:
					False
		Equals:
			match expected:
				Equals:
					True
				_:
					False
		PureKeyword:
			match expected:
				PureKeyword:
					True
				_:
					False
		FunctionKeyword:
			match expected:
				FunctionKeyword:
					True
				_:
					False
		LeftParen:
			match expected:
				LeftParen:
					True
				_:
					False
		RightParen:
			match expected:
				RightParen:
					True
				_:
					False
		LeftBracket:
			match expected:
				LeftBracket:
					True
				_:
					False
		RightBracket:
			match expected:
				RightBracket:
					True
				_:
					False
		Comma:
			match expected:
				Comma:
					True
				_:
					False
		Slash:
			match expected:
				Slash:
					True
				_:
					False
		Star:
			match expected:
				Star:
					True
				_:
					False
		Dot:
			match expected:
				Dot:
					True
				_:
					False
		Arrow:
			match expected:
				Arrow:
					True
				_:
					False
		Colon:
			match expected:
				Colon:
					True
				_:
					False
		Newline:
			match expected:
				Newline:
					True
				_:
					False
		MatchKeyword:
			match expected:
				MatchKeyword:
					True
				_:
					False
		Wildcard:
			match expected:
				Wildcard:
					True
				_:
					False


private pure func consume_symbol(
	state: ParserState,
	symbol: Symbol,
	message: String,
	help: String,
) -> Result[ParserState, Diagnostic]:
	match state.input.tokens.get(state.position):
		Some(token):
			match token.kind:
				SymbolToken(actual):
					if symbol_matches(actual, symbol):
						Ok({ state | position = IntOps.add(state.position, 1) })
					else if symbol_matches(actual, AtSign):
						Err(
							expected(
								state,
								"misplaced function annotation",
								"put @tail_recursive before the optional pure and func keywords at column 1",
							),
						)
					else:
						Err(expected(state, message, help))
				_:
					Err(expected(state, message, help))
		None:
			Err(expected(state, message, help))


private pure func identifier_help() -> String:
	"use an ASCII identifier starting with a letter or underscore; ".concat(
		"'func', 'pure', 'match', 'var', and lone '_' are reserved",
	)


private pure func consume_name(
	state: ParserState,
	message: String,
) -> Result[ParsedName, Diagnostic]:
	match state.input.tokens.get(state.position):
		Some(token):
			match token.kind:
				IdentifierToken(spelling):
					interned = intern_name(state.names, spelling)
					Ok({
						name = {
							id = interned.id,
							span = token.span
						},
						next = { state |
							position = IntOps.add(state.position, 1),
							names = interned.names
						},
					})
				SymbolToken(AtSign):
					Err(
						expected(
							state,
							"misplaced function annotation",
							"put @tail_recursive before the optional pure and func keywords at column 1",
						),
					)
				_:
					Err(expected(state, message, identifier_help()))
		None:
			Err(expected(state, message, identifier_help()))


private fixed record ParsedValue {
	body: ValueExpression,
	next: ParserState
}


private fixed record ParsedParameters {
	parameters: List[ParsedParameter],
	next: ParserState
}


private fixed record FunctionResult {
	function: ParsedFunction,
	next: ParserState
}


private fixed record HeaderResult {
	header: FunctionHeader,
	next: ParserState
}


private pure func at_symbol(state: ParserState, symbol: Symbol) -> Bool:
	match state.input.tokens.get(state.position):
		Some(token):
			match token.kind:
				SymbolToken(actual):
					symbol_matches(actual, symbol)
				_:
					False
		None:
			False


private pure func at_indent(state: ParserState) -> Bool:
	match state.input.tokens.get(state.position):
		Some(token):
			match token.kind:
				Indentation(_):
					True
				_:
					False
		None:
			False


private pure func consume_indent(
	state: ParserState,
	depth: Int,
	message: String,
	help: String,
) -> Result[ParserState, Diagnostic]:
	match state.input.tokens.get(state.position):
		Some(token):
			match token.kind:
				Indentation(actual):
					if IntOps.equals(actual, depth):
						Ok({ state | position = IntOps.add(state.position, 1) })
					else:
						Err(expected(state, message, help))
				_:
					Err(expected(state, message, help))
		None:
			Err(expected(state, message, help))


private DECIMAL_RADIX: Int = 10


private pure func integer_error(span: Span, message: String, help: String) -> Diagnostic:
	{
		span = span,
		note = None,
		message = message,
		help = help
	}


private pure func invalid_integer(span: Span) -> Diagnostic:
	integer_error(
		span,
		"invalid integer literal",
		"write decimal digits, optionally preceded by an adjacent '-'",
	)


private pure func integer_value(spelling: String, span: Span) -> Result[Int, Diagnostic]:
	negative: Bool = spelling.starts_with("-")

	digit_start: Int = if negative:
		1
	else:
		0

	if IntOps.equals(digit_start, spelling.length()):
		Err(invalid_integer(span))
	else if IntOps.less_than(
		IntOps.add(digit_start, 1),
		spelling.length(),
	) and Text.equals(
		spelling.substring(digit_start, 1),
		"0",
	):
		Err(
			integer_error(
				span,
				"integer literals cannot have leading zeros",
				"write 0 or -0, or remove the leading zeros",
			),
		)
	else:
		limit: Int = if negative:
			IntOps.INT_MIN
		else:
			IntOps.subtract(0, IntOps.INT_MAX)

		decimal_cutoff: Int = IntOps.divide(limit, DECIMAL_RADIX)
		var position: Int = digit_start
		var value: Int = 0
		var failure: Option[Diagnostic] = None

		while IntOps.less_than(position, spelling.length()):
			match DECIMAL_DIGITS.index_of(spelling.substring(position, 1)):
				None:
					failure = Some(invalid_integer(span))
					break
				Some(digit):
					-- Accumulate negatively so the minimum needs no overflowing magnitude.
					if IntOps.less_than(value, decimal_cutoff) or IntOps.less_than(
						IntOps.multiply(value, DECIMAL_RADIX),
						IntOps.add(limit, digit),
					):
						failure = Some(
							integer_error(
								span,
								"integer literal is outside the Int64 range",
								"use a value from -9223372036854775808 to 9223372036854775807",
							),
						)
						break

					value = IntOps.subtract(
						IntOps.multiply(value, DECIMAL_RADIX),
						digit,
					)
					position = IntOps.add(position, 1)

		match failure:
			Some(error):
				Err(error)
			None:
				if negative:
					Ok(value)
				else:
					Ok(IntOps.subtract(0, value))


private pure func reject_function_type_arguments(state: ParserState) -> Result[Void, Diagnostic]:
	if at_symbol(state, LeftBracket):
		Err(
			expected(
				state,
				"explicit function type arguments are unsupported",
				"omit the brackets at calls; argument types determine the type parameters",
			),
		)
	else:
		Ok(void)


private fixed record ParsedArguments {
	arguments: List[ValueExpression],
	next: ParserState
}


private pure func consume_arguments(start: ParserState) -> Result[ParsedArguments, Diagnostic]:
	var state = start
	var arguments: List[ValueExpression] = []
	var failure: Option[Diagnostic] = None

	if not at_symbol(state, RightParen):
		while True:
			match consume_value(state):
				Err(error):
					failure = Some(error)
					break
				Ok(value):
					arguments = arguments.append(value.body)
					state = value.next

			if not at_symbol(state, Comma):
				break

			state = { state | position = IntOps.add(state.position, 1) }

	ready ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	closed ?= consume_symbol(
		state,
		RightParen,
		"expected ')' after the call arguments",
		"separate complete expressions with commas, then close the call with ')'",
	)
	Ok({
		arguments = arguments,
		next = closed,
	})


private STRING_ESCAPE_HELP: String = "use \\n, \\r, \\t, \\0, \\\\, \\\", \\', \\{, \\}, or a Unicode scalar escape such as \\u{E9}"

private UNICODE_ESCAPE_HELP: String = "write \\u{H} with one to six hexadecimal digits for a scalar from 0 to 10FFFF, excluding D800 through DFFF"

private HEX_DIGITS: String = "0123456789abcdef"

private MAX_UNICODE_HEX_DIGITS: Int = 6

private HEX_RADIX: Int = 16

private UNICODE_MAX: Int = 1114111

private SURROGATE_START: Int = 55296

private SURROGATE_END: Int = 57343


private fixed record DecodedEscape {
	bytes: String,
	next: Int
}


private pure func string_error(
	span: Span,
	start: Int,
	end: Int,
	message: String,
	help: String,
) -> Diagnostic:
	{
		span = { span |
			start = IntOps.add(
				IntOps.add(span.start, 1),
				start,
			),
			end = IntOps.add(
				IntOps.add(span.start, 1),
				end,
			)
		},
		note = None,
		message = message,
		help = help
	}


-- The lexer has validated UTF-8; this only finds one scalar's byte extent for
-- diagnostics, without decoding or validating its contents again.
private pure func character_end(raw: String, start: Int) -> Int:
	var end = IntOps.min(
		IntOps.add(start, 1),
		raw.length(),
	)

	while IntOps.less_than(end, raw.length()):
		match StringOps.get(raw, end):
			Some(character):
				byte = to_int(character)

				if IntOps.greater_than_or_equal(byte, 128) and IntOps.less_than_or_equal(byte, 191):
					end = IntOps.add(end, 1)
				else:
					break
			None:
				break

	end


private pure func unicode_escape(
	raw: String,
	start: Int,
	span: Span,
) -> Result[DecodedEscape, Diagnostic]:
	var cursor = IntOps.add(start, 2)

	if not Text.equals(
		raw.substring(cursor, 1),
		"{",
	):
		Err(
			string_error(
				span,
				start,
				character_end(raw, cursor),
				"invalid Unicode escape",
				UNICODE_ESCAPE_HELP,
			),
		)
	else:
		cursor = IntOps.add(cursor, 1)
		digits_start = cursor
		var scalar = 0
		var invalid = False

		while IntOps.less_than(cursor, raw.length()) and not Text.equals(
			raw.substring(cursor, 1),
			"}",
		):
			if IntOps.greater_than_or_equal(
				IntOps.subtract(cursor, digits_start),
				MAX_UNICODE_HEX_DIGITS,
			):
				invalid = True
				break

			match HEX_DIGITS.index_of(StringOps.lower(raw.substring(cursor, 1))):
				None:
					invalid = True
					break
				Some(digit):
					scalar = IntOps.add(
						IntOps.multiply(scalar, HEX_RADIX),
						digit,
					)

			cursor = IntOps.add(cursor, 1)

		if (
			invalid
			or IntOps.equals(cursor, digits_start)
			or not Text.equals(
				raw.substring(cursor, 1),
				"}",
			)
			or IntOps.greater_than(scalar, UNICODE_MAX)
			or (
				IntOps.greater_than_or_equal(scalar, SURROGATE_START)
				and IntOps.less_than_or_equal(scalar, SURROGATE_END)
			)
		):
			Err(
				string_error(
					span,
					start,
					character_end(raw, cursor),
					"invalid Unicode escape",
					UNICODE_ESCAPE_HELP,
				),
			)
		else:
			Ok({
				bytes = StringOps.from_char(to_char(scalar)),
				next = IntOps.add(cursor, 1),
			})


private pure func decode_escape(
	raw: String,
	start: Int,
	span: Span,
) -> Result[DecodedEscape, Diagnostic]:
	code = raw.substring(
		IntOps.add(start, 1),
		1,
	)

	if Text.equals(code, "u"):
		unicode_escape(raw, start, span)
	else:
		bytes: Option[String] = match code:
			"n":
				Some("\n")
			"r":
				Some("\r")
			"t":
				Some("\t")
			"0":
				Some("\0")
			"\\":
				Some("\\")
			"\"":
				Some("\"")
			"'":
				Some("'")
			"{":
				Some("{")
			"}":
				Some("}")
			_:
				None

		match bytes:
			Some(value):
				Ok({
					bytes = value,
					next = IntOps.add(start, 2),
				})
			None:
				Err(
					string_error(
						span,
						start,
						character_end(
							raw,
							IntOps.add(start, 1),
						),
						"unknown String escape",
						STRING_ESCAPE_HELP,
					),
				)


-- Copy raw runs intact. Only escape values are encoded; UTF-8 source bytes are
-- never reconstructed as characters or normalized.
private pure func string_value(raw: String, span: Span) -> Result[String, Diagnostic]:
	var cursor = 0
	var run_start = 0
	var decoded = ""
	var failure: Option[Diagnostic] = None

	while IntOps.less_than(cursor, raw.length()):
		if Text.equals(
			raw.substring(cursor, 2),
			"$".concat("{"),
		):
			failure = Some(
				string_error(
					span,
					cursor,
					IntOps.add(cursor, 2),
					"String interpolation is not supported yet",
					"escape the opening brace as \\{ for literal $".concat("{ text"),
				),
			)
			break
		else if Text.equals(
			raw.substring(cursor, 1),
			"\\",
		):
			match decode_escape(raw, cursor, span):
				Err(error):
					failure = Some(error)
					break
				Ok(escape):
					decoded = decoded
						.concat(raw.substring(run_start, IntOps.subtract(cursor, run_start)))
						.concat(escape.bytes)
					cursor = escape.next
					run_start = cursor
		else:
			cursor = IntOps.add(cursor, 1)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(decoded.concat(raw.substring(run_start, IntOps.subtract(cursor, run_start))))


private pure func float_value(spelling: String, span: Span) -> Result[Float, Diagnostic]:
	start = if spelling.starts_with("-"):
		1
	else:
		0
	if Text.equals(spelling.substring(start, 1), "0") and DECIMAL_DIGITS.contains(spelling.substring(IntOps.add(start, 1), 1)):
		Err(integer_error(span, "Float literals cannot have leading zeros", "write 0.5 or remove the leading zeros from the integer part"))
	else:
		match StringOps.parse_float(spelling):
			Some(value):
				if FloatOps.is_finite(value):
					Ok(value)
				else:
					Err(integer_error(span, "Float literal is outside the finite Float64 range", "use a smaller magnitude or exponent; infinities are produced by arithmetic, not literals"))
			None:
				Err(integer_error(span, "invalid decimal Float literal", "write a decimal Float such as 1.0, 0.5 or 1e2"))


private pure func consume_value(start: ParserState) -> Result[ParsedValue, Diagnostic]:
	scope ?= if at_word(start, "import") and at_symbol(
		shifted(start, 1),
		Colon,
	):
		Err(
			expected(
				start,
				"imports belong at module scope",
				(
					"move import: and its selected functions before the module's declarations at "
					+ "column 1"
				),
			),
		)
	else:
		Ok(void)

	token ?= start.input.tokens
		.get(start.position)
		.to_result(
			expected(
				start,
				"expected a return expression",
				"use a literal, a parameter or variant name, or a call as the entire body",
			),
		)
	after_token = { start | position = IntOps.add(start.position, 1) }

	base_result: Result[ParsedValue, Diagnostic] = match token.kind:
		SymbolToken(AtSign):
			Err(
				expected(
					start,
					"misplaced function annotation",
					"put @tail_recursive before the optional pure and func keywords at column 1",
				),
			)
		SymbolToken(VoidKeyword):
			Ok({
				body = {
					base = VoidExpression,
					base_span = token.span,
					applications = [],
					span = token.span
				},
				next = after_token,
			})
		SymbolToken(Dot):
			end = match after_token.input.tokens.get(after_token.position):
				Some(next): next.span.end
				None: token.span.end
			Err(integer_error({ token.span | end = end }, "Float literals need digits before the decimal point", "write 0.5; a source Float literal needs an integer part"))
		FloatLiteral(spelling):
			value ?= float_value(spelling, token.span)
			Ok({ body = { base = FloatExpression(value), base_span = token.span, applications = [], span = token.span }, next = after_token })
		IntegerLiteral(spelling):
			integer ?= integer_value(spelling, token.span)
			Ok({
				body = {
					base = IntegerExpression(integer),
					base_span = token.span,
					applications = [],
					span = token.span
				},
				next = after_token,
			})
		IdentifierToken(_):
			name ?= consume_name(start, "expected a value name")
			implicit_arguments ?= reject_function_type_arguments(name.next)

			if at_symbol(name.next, LeftParen):
				arguments ?= consume_arguments(
					{ name.next | position = IntOps.add(name.next.position, 1) },
				)
				closing ?= arguments.next.input.tokens
					.get(IntOps.subtract(arguments.next.position, 1))
					.to_result(
						expected(
							arguments.next,
							"invalid call span",
							"report this compiler error with the input program",
						),
					)
				Ok({
					body = {
						base = DirectApplication(name.name, arguments.arguments),
						base_span = {
							source = token.span.source,
							start = token.span.start,
							end = closing.span.end
						},
						applications = [],
						span = token.span
					},
					next = arguments.next,
				})
			else:
				Ok({
					body = {
						base = NameExpression(name.name),
						base_span = token.span,
						applications = [],
						span = token.span
					},
					next = name.next,
				})
		SymbolToken(LeftBrace):
			consume_record_literal(after_token, token.span)
		QuotedString(raw):
			bytes ?= string_value(raw, token.span)
			Ok({
				body = {
					base = StringExpression(bytes),
					base_span = token.span,
					applications = [],
					span = token.span
				},
				next = after_token,
			})
		_:
			Err(
				expected(
					start,
					"expected a return expression",
					"use a literal, a parameter or variant name, or a call as the entire body",
				),
			)

	parsed ?= base_result
	var state = parsed.next
	var applications: List[PostfixOperation] = []
	var failure: Option[Diagnostic] = None

	while at_symbol(state, Dot):
		numeric = match token.kind:
			IntegerLiteral(_) | FloatLiteral(_): True
			_: False
		missing_fraction = match state.input.tokens.get(IntOps.add(state.position, 1)):
			Some(next):
				match next.kind:
					SymbolToken(Newline) | SymbolToken(RightParen) | SymbolToken(Comma) | SymbolToken(RightBrace) | SymbolToken(RightBracket): True
					_: False
			None: True
		if numeric and missing_fraction:
			end = match state.input.tokens.get(state.position):
				Some(dot): dot.span.end
				None: token.span.end
			failure = Some(integer_error({ token.span | end = end }, "Float literals need digits after the decimal point", "write 1.0; otherwise use a UFCS function call after '.'"))
			break
		result = consume_postfix({ state | position = IntOps.add(state.position, 1) })

		match result:
			Err(error):
				failure = Some(error)
				break
			Ok(postfix):
				applications = applications.append(postfix.operation)
				state = postfix.next

	ready ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	last ?= state.input.tokens
		.get(IntOps.subtract(state.position, 1))
		.to_result(
			expected(
				state,
				"invalid expression span",
				"report this compiler error with the input program",
			),
		)
	Ok({
		body = { parsed.body |
			applications = applications,
			span = {
				source = token.span.source,
				start = token.span.start,
				end = last.span.end
			}
		},
		next = state,
	})


private fixed record ParsedType {
	written: TypeSyntax,
	next: ParserState
}


private pure func consume_type(
	state: ParserState,
	message: String,
) -> Result[ParsedType, Diagnostic]:
	name ?= consume_name(state, message)

	if not at_symbol(name.next, LeftBracket):
		Ok({
			written = AtomicType(name.name),
			next = name.next,
		})
	else:
		var current = { name.next | position = IntOps.add(name.next.position, 1) }
		var arguments: List[TypeSyntax] = []
		var failure: Option[Diagnostic] = None

		while True:
			match consume_type(current, "expected a type argument"):
				Err(error):
					failure = Some(error)
					break
				Ok(argument):
					arguments = arguments.append(argument.written)
					current = argument.next

			if not at_symbol(current, Comma):
				break

			current = { current | position = IntOps.add(current.position, 1) }

		ready ?= match failure:
			Some(error):
				Err(error)
			None:
				Ok(void)

		closed ?= consume_symbol(
			current,
			RightBracket,
			"expected ']' after the type arguments",
			"write comma-separated type arguments, such as Result[Box[Int], Int]",
		)
		closing ?= current.input.tokens
			.get(current.position)
			.to_result(
				expected(
					current,
					"expected ']' after the type arguments",
					"close the type application",
				),
			)
		Ok({
			written = AppliedType(
				name.name,
				arguments,
				{
					source = name.name.span.source,
					start = name.name.span.start,
					end = closing.span.end
				},
			),
			next = closed,
		})


private pure func consume_parameters(start: ParserState) -> Result[ParsedParameters, Diagnostic]:
	var state = start
	var parameters: List[ParsedParameter] = []
	var failure: Option[Diagnostic] = None

	if not at_symbol(state, RightParen):
		while True:
			result: Result[ParsedParameterResult, Diagnostic] = match consume_name(
				state,
				"expected a parameter name or ')'",
			):
				Err(error):
					Err(error)
				Ok(name):
					consume_parameter_type(name)

			match result:
				Err(error):
					failure = Some(error)
					break
				Ok(next):
					parameters = parameters.append(next.parameter)
					state = next.next

			if not at_symbol(state, Comma):
				break

			state = { state | position = IntOps.add(state.position, 1) }

	ready ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	closed ?= consume_symbol(
		state,
		RightParen,
		"expected ')' after the parameters",
		"separate explicitly typed parameters with commas, then close with ')'",
	)
	Ok({
		parameters = parameters,
		next = closed,
	})


private fixed record PatternResult {
	pattern: ParsedPattern,
	span: Span,
	next: ParserState
}


private pure func consume_pattern(state: ParserState) -> Result[PatternResult, Diagnostic]:
	if at_symbol(state, Wildcard):
		token ?= state.input.tokens
			.get(state.position)
			.to_result(expected(state, "expected a pattern", "write a variant, a binding, or '_'"))
		Ok({
			pattern = PatternWildcard(token.span),
			span = token.span,
			next = { state | position = IntOps.add(state.position, 1) },
		})
	else:
		name ?= consume_name(state, "expected a match pattern")

		if not at_symbol(name.next, LeftParen):
			Ok({
				pattern = PatternName(name.name),
				span = name.name.span,
				next = name.next,
			})
		else:
			opened = { name.next | position = IntOps.add(name.next.position, 1) }
			field ?= consume_pattern_field(opened)
			closed ?= consume_symbol(
				field.next,
				RightParen,
				"expected ')' after the constructor pattern",
				"write Variant(name), Variant(_), or a nullary Variant()",
			)
			last ?= field.next.input.tokens
				.get(field.next.position)
				.to_result(expected(field.next, "expected ')'", "close the constructor pattern"))
			span: Span = {
				source = name.name.span.source,
				start = name.name.span.start,
				end = last.span.end
			}
			Ok({
				pattern = PatternConstructor(name.name, field.fields, span),
				span = span,
				next = closed,
			})


private fixed record PatternFieldResult {
	fields: Option[FieldPattern],
	next: ParserState
}


private pure func consume_pattern_field(
	state: ParserState,
) -> Result[PatternFieldResult, Diagnostic]:
	if at_symbol(state, RightParen):
		Ok({
			fields = None,
			next = state,
		})
	else if at_symbol(state, Wildcard):
		token ?= state.input.tokens
			.get(state.position)
			.to_result(
				expected(
					state,
					"expected a field pattern",
					"bind the Int field with a name or ignore it with '_'",
				),
			)
		Ok({
			fields = Some(FieldWildcard(token.span)),
			next = { state | position = IntOps.add(state.position, 1) },
		})
	else:
		name ?= consume_name(state, "expected an Int field binding or '_'")
		Ok({
			fields = Some(FieldName(name.name)),
			next = name.next,
		})


private fixed record BodyResult {
	body: ParsedBody,
	next: ParserState
}


private pure func consume_match(start: ParserState) -> Result[BodyResult, Diagnostic]:
	keyword ?= start.input.tokens
		.get(start.position)
		.to_result(
			expected(
				start,
				"expected 'match'",
				"write match value: followed by indented arms",
			),
		)
	after_keyword = { start | position = IntOps.add(start.position, 1) }

	scrutinee ?= match after_keyword.input.tokens.get(after_keyword.position):
		Some(token):
			if IntOps.greater_than(token.span.start, keyword.span.end):
				consume_value(after_keyword)
			else:
				Err(
					expected(
						after_keyword,
						"expected a space after 'match'",
						"put a space between 'match' and the matched expression",
					),
				)
		None:
			consume_value(after_keyword)

	colon ?= consume_symbol(
		scrutinee.next,
		Colon,
		"expected ':' after the match value",
		"write match value: and put each arm on the next line",
	)
	newline ?= consume_symbol(
		colon,
		Newline,
		"expected a newline after the match header",
		"put each pattern on its own indented line, with an inline or indented result",
	)
	var state = newline
	var arms: List[ParsedMatchArm] = []
	var end = keyword.span.end
	var failure: Option[Diagnostic] = None

	while True:
		match consume_arm(state):
			Err(error):
				failure = Some(error)
				break
			Ok(arm):
				arms = arms.append(arm.arm)
				end = arm.arm.span.end
				state = arm.next

		if not at_symbol(state, Newline):
			break

		next = { state | position = IntOps.add(state.position, 1) }

		if not at_indent(next):
			break

		state = next

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({
				body = ParsedMatchBody({
					scrutinee = scrutinee.body,
					arms = arms,
					keyword_span = keyword.span,
					span = {
						source = keyword.span.source,
						start = keyword.span.start,
						end = end
					},
				}),
				next = state,
			})


private fixed record ArmResult {
	arm: ParsedMatchArm,
	next: ParserState
}


private pure func consume_arm(state: ParserState) -> Result[ArmResult, Diagnostic]:
	indented ?= consume_indent(
		state,
		2,
		"expected a match arm indented two levels",
		"indent each arm with two tabs or eight spaces",
	)
	pattern ?= consume_pattern(indented)
	colon ?= consume_symbol(
		pattern.next,
		Colon,
		"expected ':' after the match pattern",
		"write Pattern: expression, or put the arm body on the next indented line",
	)

	block ?= if at_symbol(colon, Newline):
		consume_block_indent(
			{ colon | position = IntOps.add(colon.position, 1) },
			ArmBlock,
		).and_then(
			pure func(
				indented: ParserState,
			) -> Result[StatementBlock, Diagnostic]: consume_block(indented, ArmBlock),
		)
	else:
		consume_value(colon).map(pure func(value: ParsedValue) -> StatementBlock: {
				statements = [],
				body = ParsedValueBody(value.body),
				next = value.next
			})

	value ?= match block.body:
		ParsedValueBody(value):
			Ok(value)
		_:
			Err(
				expected(
					colon,
					"expected a match arm result",
					"finish the arm with a value expression",
				),
			)

	Ok({
		arm = {
			pattern = pattern.pattern,
			statements = block.statements,
			body = value,
			span = {
				source = pattern.span.source,
				start = pattern.span.start,
				end = value.span.end
			}
		},
		next = block.next,
	})


private pure func at_builtin_body(state: ParserState) -> Bool:
	if (
		at_word(state, "builtin")
		and at_symbol({ state | position = IntOps.add(state.position, 1) }, LeftParen)
	):
		match state.input.tokens.get(IntOps.add(state.position, 2)):
			Some(token):
				match token.kind:
					QuotedString(_): True
					_: False
			None: False
	else:
		False


private pure func consume_function_body(state: ParserState) -> Result[BodyResult, Diagnostic]:
	if at_symbol(state, MatchKeyword):
		consume_match(state)
	else if at_builtin_body(state):
		consume_builtin_body(state)
	else:
		value ?= consume_value(state)
		Ok({
			body = ParsedValueBody(value.body),
			next = value.next,
		})


private fixed record StatementBlock {
	statements: List[ParsedStatement],
	body: ParsedBody,
	next: ParserState
}


private fixed union BlockScope:
	FunctionBlock
	ArmBlock


private pure func consume_block_indent(
	state: ParserState,
	block: BlockScope,
) -> Result[ParserState, Diagnostic]:
	match block:
		FunctionBlock:
			consume_indent(
				state,
				1,
				"expected a final expression after the bindings",
				"finish the function with a value expression or tail match indented one level",
			)
		ArmBlock:
			consume_indent(
				state,
				3,
				"expected a match arm result indented three levels",
				"finish the arm with a value expression indented with three tabs or twelve spaces",
			)


private pure func at_binding(state: ParserState) -> Bool:
	if at_symbol(state, VarKeyword):
		True
	else:
		match state.input.tokens.get(state.position):
			Some(token):
				match token.kind:
					IdentifierToken(_):
						at_symbol({ state | position = IntOps.add(state.position, 1) }, Equals)
					_:
						False
			None:
				False


private fixed record BindingLine {
	binding: ParsedBinding,
	next: ParserState
}


private pure func consume_binding(
	state: ParserState,
	block: BlockScope,
) -> Result[BindingLine, Diagnostic]:
	mutability = if at_symbol(state, VarKeyword):
		MutableBinding
	else:
		ImmutableBinding

	after_keyword = match mutability:
		MutableBinding:
			{ state | position = IntOps.add(state.position, 1) }
		ImmutableBinding:
			state

	name ?= consume_name(after_keyword, "expected a binding name")
	equals ?= consume_symbol(
		name.next,
		Equals,
		"expected '=' after the binding name",
		"write name = expression or var name = expression",
	)

	initializer ?= if (
		at_symbol(equals, Newline)
		or IntOps.equals(equals.position, equals.input.tokens.length())
	):
		Err(
			expected(
				equals,
				"expected a binding initializer",
				"put one expression after '=' on the same line",
			),
		)
	else:
		consume_value(equals)

	message = match block:
		FunctionBlock:
			"expected a final expression after the bindings"
		ArmBlock:
			"expected a final expression after the arm bindings"

	help = match block:
		FunctionBlock:
			"finish the function with a value expression or tail match"
		ArmBlock:
			"finish the arm with a value expression on its own indented line"

	newline ?= consume_symbol(initializer.next, Newline, message, help)
	next ?= consume_block_indent(newline, block)
	Ok({
		binding = {
			name = name.name,
			mutability = mutability,
			initializer = initializer.body
		},
		next = next,
	})


-- Code-line indentation decides whether an expression is final. The lexer has
-- already removed blank/comment-only lines, so those never alter sequencing.
private pure func following_statement(state: ParserState, block: BlockScope) -> Bool:
	if at_symbol(state, Newline):
		match state.input.tokens.get(IntOps.add(state.position, 1)):
			Some(token):
				match token.kind:
					Indentation(depth):
						IntOps.equals(
							depth,
							match block:
								FunctionBlock:
									1
								ArmBlock:
									3
						)
					_:
						False
			None:
				False
	else:
		False


private pure func consume_block(
	start: ParserState,
	block: BlockScope,
) -> Result[StatementBlock, Diagnostic]:
	var state = start
	var statements: List[ParsedStatement] = []
	var result: Option[Result[StatementBlock, Diagnostic]] = None

	while True:
		if at_binding(state):
			match consume_binding(state, block):
				Err(error):
					result = Some(Err(error))
					break
				Ok(line):
					statements = statements.append(BindingStatement(line.binding))
					state = line.next
		else:
			parsed = match block:
				FunctionBlock:
					consume_function_body(state)
				ArmBlock:
					consume_value(state).map(pure func(value: ParsedValue) -> BodyResult: {
							body = ParsedValueBody(value.body),
							next = value.next
						})

			match parsed:
				Err(error):
					result = Some(Err(error))
					break
				Ok(line):
					match line.body:
						ParsedValueBody(value):
							if following_statement(line.next, block):
								statements = statements.append(ExpressionStatement(value))
								-- following_statement validated the Newline + Indentation token pair.
								state = shifted(line.next, 2)
								continue
						ParsedBuiltinBody(_, at):
							if (
								IntOps.greater_than(statements.length(), 0)
								or following_statement(line.next, block)
							):
								result = Some(
									Err(
										expected(
											state,
											"builtin must be the entire function body",
											(
												"use builtin as the entire function body; put other work in an ordinary wrapper "
												+ "function"
											),
										),
									),
								)
								break
						ParsedMatchBody(_):
							void

					result = Some(Ok({
						statements = statements,
						body = line.body,
						next = line.next,
					}))
					break

	match result:
		Some(value):
			value
		None:
			Err(
				expected(
					state,
					"expected a final expression",
					"finish the block with a value expression",
				),
			)


private fixed record ParsedTypeParameters {
	parameters: List[WrittenName],
	next: ParserState
}


private pure func valid_type_parameter_name(spelling: String) -> Bool:
	var accepted = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".contains(spelling.substring(0, 1))
	var position: Int = 1

	while IntOps.less_than(position, spelling.length()):
		accepted = (
			accepted
			and "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789".contains(
				spelling.substring(
					position,
					1,
				),
			)
		)
		position = IntOps.add(position, 1)

	accepted


private pure func consume_type_parameters(
	state: ParserState,
) -> Result[ParsedTypeParameters, Diagnostic]:
	if not at_symbol(state, LeftBracket):
		Ok({
			parameters = [],
			next = state,
		})
	else:
		var current: ParserState = { state | position = IntOps.add(state.position, 1) }
		var parameters: List[WrittenName] = []
		var failure: Option[Diagnostic] = None

		while True:
			name_result = match current.input.tokens.get(current.position):
				Some(token):
					match token.kind:
						IdentifierToken(spelling):
							if valid_type_parameter_name(spelling):
								consume_name(current, "expected a type parameter name")
							else:
								Err({
									span = token.span,
									note = None,
									message = "invalid type parameter name",
									help = Text.concat(
										"start with a capital ASCII letter and use only ASCII letters and digits, such ",
										"as T or Element2",
									),
								})
						_:
							Err(
								expected(
									current,
									"expected a type parameter name",
									"declare type parameters separated by commas, such as [A, B]",
								),
							)
				None:
					Err(
						expected(
							current,
							"expected a type parameter name",
							"declare type parameters separated by commas, such as [A, B]",
						),
					)

			match name_result:
				Err(error):
					failure = Some(error)
					break
				Ok(name):
					parameters = parameters.append(name.name)
					current = name.next

			if at_symbol(current, RightBracket):
				current = { current | position = IntOps.add(current.position, 1) }
				break
			else if at_symbol(current, Comma):
				current = { current | position = IntOps.add(current.position, 1) }
			else:
				failure = Some(
					expected(
						current,
						"expected ',' or ']' after a type parameter",
						"separate type parameters with commas and close the list with ']'",
					),
				)
				break

		match failure:
			Some(error):
				Err(error)
			None:
				Ok({
					parameters = parameters,
					next = current,
				})


private fixed record ParsedReturnAnnotation {
	written: Option[TypeSyntax],
	next: ParserState
}


private pure func consume_return_annotation(start: ParserState) -> Result[ParsedReturnAnnotation, Diagnostic]:
	if at_symbol(start, Colon):
		Ok({ written = None, next = start })
	else:
		after_arrow ?= consume_symbol(
			start,
			Arrow,
			"expected '->' before the return type",
			"write main() -> Int with adjacent arrow characters, or main(): for Void",
		)
		return_type ?= consume_type(after_arrow, "expected a return type")
		Ok({ written = Some(return_type.written), next = return_type.next })


private pure func consume_header(start: ParserState) -> Result[HeaderResult, Diagnostic]:
	purity: Purity = match start.input.tokens.get(start.position):
		Some(token):
			match token.kind:
				SymbolToken(PureKeyword):
					Pure
				_:
					Impure
		None:
			Impure

	after_func ?= match purity:
		Pure:
			consume_symbol(
				{ start | position = IntOps.add(start.position, 1) },
				FunctionKeyword,
				"expected 'func' after 'pure'",
				"write pure func name() -> Int:",
			)
		Impure:
			consume_symbol(
				start,
				FunctionKeyword,
				"expected a function declaration at column 1",
				"start with func main() -> Int:",
			)

	function ?= consume_name(after_func, "expected a function name")
	type_parameters ?= consume_type_parameters(function.next)
	after_open ?= consume_symbol(
		type_parameters.next,
		LeftParen,
		"expected '(' after the function name",
		"write main() or helper(value: Int)",
	)
	parameters ?= consume_parameters(after_open)
	return_type ?= consume_return_annotation(parameters.next)
	after_header ?= consume_symbol(
		return_type.next,
		Colon,
		"expected ':' after the function header",
		"end the header with ':' and put the return expression on the next line",
	)
	after_newline ?= consume_symbol(
		after_header,
		Newline,
		"expected a newline after the function header",
		"put the return expression on the next line",
	)
	after_indent ?= consume_indent(
		after_newline,
		1,
		"expected an indent of one tab or four spaces",
		"indent the body with exactly one tab or four spaces",
	)
	Ok({
		header = {
			purity = purity,
			function_name = function.name,
			type_parameters = type_parameters.parameters,
			parameters = parameters.parameters,
			return_type = return_type.written
		},
		next = after_indent,
	})


private fixed record ParsedAnnotation {
	span: Option[Span],
	next: ParserState
}


private pure func consume_annotation(start: ParserState) -> Result[ParsedAnnotation, Diagnostic]:
	if not at_symbol(start, AtSign):
		Ok({
			span = None,
			next = start,
		})
	else:
		opening ?= start.input.tokens
			.get(start.position)
			.to_result(
				expected(
					start,
					"expected a function annotation",
					"write @tail_recursive before a function declaration",
				),
			)
		after_at = { start | position = IntOps.add(start.position, 1) }
		name ?= after_at.input.tokens
			.get(after_at.position)
			.to_result(
				expected(
					start,
					"expected a function annotation",
					"write @tail_recursive before a function declaration",
				),
			)

		valid = match name.kind:
			IdentifierToken(spelling):
				(
					Text.equals(spelling, "tail_recursive")
					and IntOps.equals(opening.span.end, name.span.start)
				)
			_:
				False

		span: Span = {
			source = opening.span.source,
			start = opening.span.start,
			end = name.span.end
		}

		if not valid:
			Err({
				span = span,
				note = None,
				message = "unknown function annotation",
				help = "use @tail_recursive before a function declaration",
			})
		else:
			var next = { after_at | position = IntOps.add(after_at.position, 1) }

			if at_symbol(next, LeftParen):
				Err(
					expected(
						next,
						"@tail_recursive takes no arguments",
						"write @tail_recursive before the optional pure and func keywords",
					),
				)
			else:
				if at_symbol(next, Newline):
					next = { next | position = IntOps.add(next.position, 1) }

				if at_symbol(next, AtSign):
					Err(
						expected(
							next,
							"multiple function annotations are not supported",
							"write @tail_recursive only once before a function",
						),
					)
				else if IntOps.equals(next.position, next.input.tokens.length()):
					Err({
						span = span,
						note = None,
						message = "@tail_recursive has no function declaration",
						help = "put a function declaration immediately after @tail_recursive",
					})
				else if not at_symbol(next, PureKeyword) and not at_symbol(next, FunctionKeyword):
					Err(
						expected(
							next,
							"@tail_recursive requires a function declaration",
							"put @tail_recursive before the optional pure and func keywords",
						),
					)
				else:
					Ok({
						span = Some(span),
						next = next,
					})


private pure func consume_function(
	start: ParserState,
	module: ModuleId,
) -> Result[FunctionResult, Diagnostic]:
	annotation ?= consume_annotation(start)
	header ?= consume_header(annotation.next)
	body ?= consume_block(header.next, FunctionBlock)
	Ok({
		function = {
			module = module,
			tail_annotation = annotation.span,
			purity = header.header.purity,
			function_name = header.header.function_name,
			type_parameters = header.header.type_parameters,
			parameters = header.header.parameters,
			return_type = header.header.return_type,
			statements = body.statements,
			body = body.body
		},
		next = body.next,
	})


private pure func at_word(state: ParserState, word: String) -> Bool:
	match state.input.tokens.get(state.position):
		Some(token):
			match token.kind:
				IdentifierToken(spelling):
					Text.equals(spelling, word)
				_:
					False
		None:
			False


private fixed record UnionResult {
	declaration: ParsedUnion,
	next: ParserState
}


private fixed record VariantResult {
	variant: ParsedVariant,
	next: ParserState
}


private pure func consume_variant(state: ParserState) -> Result[VariantResult, Diagnostic]:
	indented ?= consume_indent(
		state,
		1,
		"expected an indented union variant",
		"declare at least one variant, indented with one tab or four spaces",
	)
	name ?= consume_name(indented, "expected a union variant name")

	if at_symbol(name.next, LeftParen):
		field ?= consume_name(
			{ name.next | position = IntOps.add(name.next.position, 1) },
			"expected a payload type",
		)
		closed ?= consume_symbol(
			field.next,
			RightParen,
			"expected ')' after the payload type",
			"declare zero fields or one payload field, written Variant(Int) or Variant(T)",
		)
		Ok({
			variant = {
				name = name.name,
				payload = Some(field.name)
			},
			next = closed,
		})
	else:
		Ok({
			variant = {
				name = name.name,
				payload = None
			},
			next = name.next,
		})


private pure func consume_union(start: ParserState, module: ModuleId) -> Result[UnionResult, Diagnostic]:
	after_fixed: ParserState = { start | position = IntOps.add(start.position, 1) }

	word ?= if at_word(after_fixed, "union"):
		Ok({ after_fixed | position = IntOps.add(after_fixed.position, 1) })
	else:
		Err(
			expected(
				after_fixed,
				"expected 'union' after 'fixed'",
				"write fixed union Choice: followed by indented variant names",
			),
		)

	name ?= consume_name(word, "expected a union type name")
	type_parameters ?= consume_type_parameters(name.next)

	colon ?= consume_symbol(
		type_parameters.next,
		Colon,
		"expected ':' after the union type name",
		"write fixed union Choice: or fixed union Box[T]:",
	)
	newline ?= consume_symbol(
		colon,
		Newline,
		"expected a newline after the union header",
		"put each variant name on its own indented line",
	)
	var state = newline
	var variants: List[ParsedVariant] = []
	var failure: Option[Diagnostic] = None

	while True:
		match consume_variant(state):
			Err(error):
				failure = Some(error)
				break
			Ok(variant):
				variants = variants.append(variant.variant)
				state = variant.next

		if IntOps.equals(state.position, start.input.tokens.length()):
			break

		if not at_symbol(state, Newline):
			failure = Some(
				expected(
					state,
					"expected a newline after the variant name",
					"put each variant on its own indented line",
				),
			)
			break

		next: ParserState = { state | position = IntOps.add(state.position, 1) }

		if not at_indent(next):
			break

		state = next

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({
				declaration = {
					module = module,
					type_name = name.name,
					type_parameters = type_parameters.parameters,
					variants = variants
				},
				next = state,
			})


private pure func consume_word(state: ParserState, word: String) -> Result[ParserState, Diagnostic]:
	if at_word(state, word):
		Ok({ state | position = IntOps.add(state.position, 1) })
	else:
		Err(
			expected(
				state,
				Text
					.concat("expected '", word)
					.concat("'"),
				"use the ordinary declaration syntax, such as type Int = builtin or builtin(\"int.add\")",
			),
		)


private fixed record BuiltinTypeResult {
	declaration: ParsedBuiltinType,
	next: ParserState
}


private pure func consume_list_parameter(state: ParserState) -> Result[ParserState, Diagnostic]:
	opened ?= consume_symbol(state, LeftBracket, "List requires one type parameter", "write type List[T] = builtin")
	parameter ?= consume_name(opened, "expected the List type parameter")
	consume_symbol(parameter.next, RightBracket, "List requires exactly one type parameter", "write type List[T] = builtin")


private pure func consume_builtin_type(start: ParserState) -> Result[BuiltinTypeResult, Diagnostic]:
	after_type ?= consume_word(start, "type")
	integer = at_word(after_type, "Int")

	known ?= if (
		integer
		or at_word(after_type, "Float")
		or at_word(after_type, "String")
		or at_word(after_type, "Void")
		or at_word(after_type, "List")
	):
		Ok(void)
	else:
		Err(
			expected(
				after_type,
				"unknown builtin type",
				"declare type Int = builtin, type Float = builtin, type String = builtin, type Void = builtin or type List[T] = builtin",
			),
		)

	name ?= consume_name(after_type, "expected a builtin type name")
	after_name ?= if at_word(after_type, "List"):
		consume_list_parameter(name.next)
	else:
		Ok(name.next)
	equals ?= consume_symbol(
		after_name,
		Equals,
		"expected '=' after the builtin type name",
		"write type Int = builtin, type Float = builtin, type String = builtin, type Void = builtin or type List[T] = builtin",
	)
	end ?= consume_word(equals, "builtin")

	declaration = if at_word(after_type, "List"):
		ListBuiltin(name.name)
	else if integer:
		IntegerBuiltin(name.name)
	else if at_word(after_type, "Float"):
		FloatBuiltin(name.name)
	else:
		if at_word(after_type, "Void"):
			VoidBuiltin(name.name)
		else:
			StringBuiltin(name.name)

	Ok({
		declaration = declaration,
		next = end,
	})


private fixed union UnionBuiltinKind:
	IntegerParseRoles
	FloatParseRoles
	ListGetRoles
	StringEqualityRoles
	IntegerEqualityRoles


private fixed record BuiltinOperationResult {
	operation: ParsedRuntimeOperation,
	next: ParserState
}


private BUILTIN_LABEL_HELP: String = (
	"use int.equals, int.add, int.subtract, int.multiply, int.divide, int.remainder, int."
	+ "to_string, float.add, float.subtract, float.multiply, float.divide, float.remainder, float.to_string, string.length, string.print, string.parse_int, string.parse_float, string.equals, list.length or list.get"
)


private pure func consume_builtin_roles(
	state: ParserState,
	kind: UnionBuiltinKind,
) -> Result[BuiltinOperationResult, Diagnostic]:
	present_start ?= consume_symbol(
		state,
		Comma,
		"expected constructor roles after the builtin label",
		"bind the two result constructors after the quoted label",
	)
	present ?= consume_name(present_start, "expected the first result constructor")
	absent_start ?= consume_symbol(
		present.next,
		Comma,
		"expected ',' between constructor roles",
		"separate the two result constructors with a comma",
	)
	absent ?= consume_name(absent_start, "expected the second result constructor")

	operation = match kind:
		FloatParseRoles:
			StringParseFloatBuiltin(present.name, absent.name)
		IntegerParseRoles:
			StringParseIntBuiltin(present.name, absent.name)
		ListGetRoles:
			ListGetBuiltin(present.name, absent.name)
		StringEqualityRoles:
			StringEqualsBuiltin(present.name, absent.name)
		IntegerEqualityRoles:
			IntegerEqualsBuiltin(present.name, absent.name)

	Ok({
		operation = operation,
		next = absent.next,
	})


private pure func consume_builtin_body(start: ParserState) -> Result[BodyResult, Diagnostic]:
	after_builtin ?= consume_word(start, "builtin")
	opened ?= consume_symbol(
		after_builtin,
		LeftParen,
		"expected '(' after builtin",
		"write builtin(\"int.add\") or bind union constructors as builtin(\"string.parse_int\", Some, None)",
	)
	label ?= opened.input.tokens
		.get(opened.position)
		.to_result(
			expected(
				opened,
				"expected a builtin label",
				"use a quoted closed operation label",
			),
		)

	operation_result: Result[BuiltinOperationResult, Diagnostic] = match label.kind:
		QuotedString(spelling):
			if Text.equals(spelling, "string.parse_int"):
				consume_builtin_roles(
					shifted(opened, 1),
					IntegerParseRoles,
				)
			else if Text.equals(spelling, "string.parse_float"):
				consume_builtin_roles(shifted(opened, 1), FloatParseRoles)
			else if Text.equals(spelling, "list.get"):
				consume_builtin_roles(
					shifted(opened, 1),
					ListGetRoles,
				)
			else if Text.equals(spelling, "int.equals"):
				consume_builtin_roles(shifted(opened, 1), IntegerEqualityRoles)
			else if Text.equals(spelling, "string.equals"):
				consume_builtin_roles(
					shifted(opened, 1),
					StringEqualityRoles,
				)
			else:
				primitive_result: Result[ParsedRuntimeOperation, Diagnostic] = if Text.equals(
					spelling,
					"string.print",
				):
					Ok(StringPrintBuiltin)
				else if Text.equals(spelling, "int.add"):
					Ok(IntegerAddBuiltin)
				else if Text.equals(spelling, "int.subtract"):
					Ok(IntegerSubtractBuiltin)
				else if Text.equals(spelling, "int.multiply"):
					Ok(IntegerMultiplyBuiltin)
				else if Text.equals(spelling, "int.divide"):
					Ok(IntegerDivideBuiltin)
				else if Text.equals(spelling, "int.remainder"):
					Ok(IntegerRemainderBuiltin)
				else if Text.equals(spelling, "int.to_string"):
					Ok(IntegerToStringBuiltin)
				else if Text.equals(spelling, "float.add"):
					Ok(FloatAddBuiltin)
				else if Text.equals(spelling, "float.subtract"):
					Ok(FloatSubtractBuiltin)
				else if Text.equals(spelling, "float.multiply"):
					Ok(FloatMultiplyBuiltin)
				else if Text.equals(spelling, "float.divide"):
					Ok(FloatDivideBuiltin)
				else if Text.equals(spelling, "float.remainder"):
					Ok(FloatRemainderBuiltin)
				else if Text.equals(spelling, "float.to_string"):
					Ok(FloatToStringBuiltin)
				else if Text.equals(spelling, "list.length"):
					Ok(ListLengthBuiltin)
				else if Text.equals(spelling, "string.length"):
					Ok(StringLengthBuiltin)
				else:
					Err(expected(opened, "unknown builtin operation", BUILTIN_LABEL_HELP))

				primitive ?= primitive_result
				parsed: BuiltinOperationResult = {
					operation = primitive,
					next = shifted(opened, 1)
				}
				Ok(parsed)
		_:
			Err(expected(opened, "expected a quoted builtin label", BUILTIN_LABEL_HELP))

	operation ?= operation_result
	closed ?= consume_symbol(
		operation.next,
		RightParen,
		"expected ')' after the builtin label",
		(
			"give primitive builtins one quoted label, or bind both constructors of a union "
			+ "result"
		),
	)
	Ok({
		body = ParsedBuiltinBody(operation.operation, label.span),
		next = closed,
	})


private pure func shifted(state: ParserState, count: Int) -> ParserState:
	{ state | position = IntOps.add(state.position, count) }


private pure func parser_span(state: ParserState) -> Span:
	match state.input.tokens.get(state.position):
		Some(token):
			token.span
		None:
			state.input.end


private fixed record ParsedPath {
	path: ModulePath,
	span: Span,
	next: ParserState
}


private pure func parent_prefix(state: ParserState) -> Bool:
	at_symbol(state, Dot) and at_symbol(shifted(state, 1), Dot) and at_symbol(shifted(state, 2), Slash)


private pure func consume_module_path(start: ParserState) -> Result[ParsedPath, Diagnostic]:
	var state = start
	var origin: ImportOrigin = LibraryImport

	if at_symbol(state, Dot) and at_symbol(
		shifted(state, 1),
		Slash,
	):
		origin = RelativeImport(0)
		state = shifted(state, 2)
	else if parent_prefix(state):
		var parents: Int = 0

		while parent_prefix(state):
			parents = IntOps.add(parents, 1)
			state = shifted(state, 3)

		origin = RelativeImport(parents)

	prefix ?= if at_symbol(start, Slash):
		Err(expected(start, "absolute import paths are not supported", "write int: add for the target library or ./helper: answer for a local module"))
	else if IntOps.equals(state.position, start.position) and at_symbol(start, Dot):
		Err(expected(start, "expected './' or '../' before a relative import path", "write ./helper: answer or ../shared/helper: answer"))
	else:
		Ok(void)

	var parts: List[NameId] = []
	var failure: Option[Diagnostic] = None
	var last = parser_span(state)

	while True:
		if at_symbol(state, Dot):
			failure = Some(expected(state, "'.' and '..' may only begin an import path", "write ../shared/helper or ./shared/helper without interior dot segments"))
			break

		match consume_name(state, "expected a module name in the import path"):
			Err(error):
				failure = Some(error)
				break
			Ok(part):
				parts = parts.append(part.name.id)
				last = part.name.span
				state = part.next

		if not at_symbol(state, Slash):
			break

		state = shifted(state, 1)

	valid ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	-- The lexer skips spaces. Path characters must still be adjacent bytes.
	var position = start.position
	var previous_end = parser_span(start).start

	while IntOps.less_than(position, state.position):
		match state.input.tokens.get(position):
			None:
				failure = Some(expected(state, "incomplete import path", "write ./helper or ../shared/helper"))
				break
			Some(token):
				if not IntOps.equals(token.span.start, previous_end):
					failure = Some(expected({ state | position = position }, "import paths cannot contain spaces", "write adjacent path characters, such as ./helper or ../shared/helper"))
					break

				previous_end = token.span.end

		position = IntOps.add(position, 1)

	spaced ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	first = parser_span(start)
	Ok({
		path = { origin = origin, parts = parts },
		span = { source = first.source, start = first.start, end = last.end },
		next = state
	})


private fixed record ImportSelectionResult {
	selection: ImportSelection,
	span: Span,
	next: ParserState
}


private pure func consume_import_symbol(
	state: ParserState,
) -> Result[ImportSelectionResult, Diagnostic]:
	if at_symbol(state, Star):
		Err(expected(state, "wildcard imports are not supported", "list the functions you need, such as ./helper: answer"))
	else:
		name ?= consume_name(state, "expected an imported function or type name")

		if at_word(name.next, "as"):
			Err(expected(name.next, "import aliases are not supported yet", "select the function by its declared name, such as ./helper: answer"))
		else if at_symbol(name.next, LeftParen):
			var next = shifted(name.next, 1)
			var variants: List[WrittenName] = []
			var failure: Option[Diagnostic] = None

			while not at_symbol(next, RightParen):
				match consume_name(next, "expected an imported constructor name"):
					Err(error):
						failure = Some(error)
						break
					Ok(variant):
						variants = variants.append(variant.name)
						next = variant.next

				if not at_symbol(next, Comma):
					break

				next = shifted(next, 1)

				if at_symbol(next, RightParen):
					failure = Some(
						expected(
							next,
							"expected a constructor after ','",
							"omit the trailing comma in Option(Some, None)",
						),
					)
					break

			valid ?= match failure:
				Some(error):
					Err(error)
				None:
					Ok(void)

			end = parser_span(next)
			closed ?= consume_symbol(
				next,
				RightParen,
				"expected ')' after selected constructors",
				"write Option(Some, None) or Option() on one line",
			)
			modifier ?= if at_word(closed, "methods_only"):
				Err(expected(closed, "constructor selection cannot be combined with methods_only", "write Foo(First) to import the type and constructors, or Foo methods_only to import only methods"))
			else:
				Ok(void)
			Ok({
				selection = ConstructorSelection(name.name, variants),
				span = { name.name.span | end = end.end },
				next = closed,
			})
		else if at_word(name.next, "methods_only"):
			modifier = parser_span(name.next)
			after_modifier = shifted(name.next, 1)
			valid ?= if at_symbol(after_modifier, LeftParen):
				Err(expected(after_modifier, "methods_only cannot include constructor selection", "write Foo(First) to import the type and constructors, or Foo methods_only to import only methods"))
			else if at_word(after_modifier, "methods_only"):
				Err(expected(after_modifier, "methods_only must appear once after a type name", "write ops: Foo methods_only without constructors or another modifier"))
			else:
				Ok(void)
			Ok({ selection = MethodsOnlySelection(name.name, modifier), span = { name.name.span | end = modifier.end }, next = after_modifier })
		else:
			Ok({
				selection = NamedSelection(name.name),
				span = name.name.span,
				next = name.next,
			})


private fixed record ImportResult {
	request: ParsedImport,
	next: ParserState
}


private pure func consume_import_row(start: ParserState) -> Result[ImportResult, Diagnostic]:
	indented ?= consume_indent(start, 1, "expected an indented import", "indent each ./helper: answer line with one tab or four spaces")
	path ?= consume_module_path(indented)

	selection ?= if at_word(path.next, "as"):
		Err(expected(path.next, "import aliases are not supported yet", "select functions directly, such as ./helper: answer"))
	else if at_symbol(path.next, Dot):
		Err(expected(path.next, "import paths omit file extensions", "write ./helper: answer instead of ./helper.brp: answer"))
	else:
		consume_symbol(
			path.next,
			Colon,
			"expected ':' and selected function names after the import path",
			(
				"write ./helper: answer; module aliases and whole-module imports are not "
				+ "supported yet"
			),
		)

	var state = selection
	var symbols: List[ImportSelection] = []
	var last = path.span
	var failure: Option[Diagnostic] = None

	while True:
		match consume_import_symbol(state):
			Err(error):
				failure = Some(error)
				break
			Ok(symbol):
				symbols = symbols.append(symbol.selection)
				last = symbol.span
				state = symbol.next

		if not at_symbol(state, Comma):
			break

		state = shifted(state, 1)

	valid ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	complete ?= if (
		at_symbol(state, Newline)
		or IntOps.equals(state.position, state.input.tokens.length())
	):
		Ok(void)
	else:
		Err(expected(state, "expected ',' between imported function names", "write ./helper: answer, other on one line"))
	Ok({
		request = {
			path = path.path,
			symbols = symbols,
			span = { source = path.span.source, start = path.span.start, end = last.end }
		},
		next = state,
	})


private fixed record ImportBlockResult {
	imports: List[ParsedImport],
	next: ParserState
}


private pure func consume_import_block(start: ParserState) -> Result[ImportBlockResult, Diagnostic]:
	colon ?= consume_symbol(shifted(start, 1), Colon, "expected ':' after 'import'", "write import: followed by indented relative imports")
	newline ?= consume_symbol(colon, Newline, "expected a newline after 'import:'", "put each ./helper: answer import on its own indented line")
	var state = newline
	var imports: List[ParsedImport] = []
	var failure: Option[Diagnostic] = None

	while True:
		match consume_import_row(state):
			Err(error):
				failure = Some(error)
				break
			Ok(row):
				imports = imports.append(row.request)
				state = row.next

		if not at_symbol(state, Newline) or not at_indent(shifted(state, 1)):
			break

		state = shifted(state, 1)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({ imports = imports, next = state })


pure func module_names(parsed: ParsedModule) -> NameTable:
	from_opaque ParsedModule(parsed).names


pure func module_imports(parsed: ParsedModule) -> List[ParsedImport]:
	from_opaque ParsedModule(parsed).imports


pure func parse_module(
	input: LexedProgram,
	module: ModuleId,
	names: NameTable,
) -> Result[ParsedModule, Diagnostic]:
	var correct_source = same_source(input.end.source, module_source(module))

	for token in input.tokens:
		correct_source = correct_source and same_source(token.span.source, module_source(module))

	origin ?= if correct_source:
		Ok(void)
	else:
		Err(source_bundle_error("parsed module's source does not match its module identity"))

	var state: ParserState = {
		input = input,
		position = 0,
		names = names
	}
	var imports: List[ParsedImport] = []
	var builtin_types: List[ParsedBuiltinType] = []
	var functions: List[ParsedFunction] = []
	var unions: List[ParsedUnion] = []
	var records: List[ParsedRecord] = []
	var failure: Option[Diagnostic] = None

	while IntOps.less_than(state.position, input.tokens.length()):
		if (
			at_word(state, "import")
			and ((
				not IntOps.equals(functions.length(), 0)
				or not IntOps.equals(unions.length(), 0)
				or not IntOps.equals(records.length(), 0)
				or not IntOps.equals(builtin_types.length(), 0)
			))
		):
			failure = Some(
				expected(
					state,
					"imports must precede declarations",
					(
						"move every import: block before the module's functions, fixed unions, and fixed "
						+ "records"
					),
				),
			)
			break
		else if at_word(state, "import"):
			match consume_import_block(state):
				Err(error):
					failure = Some(error)
					break
				Ok(block):
					imports = imports.concat(block.imports)
					state = block.next
		else if at_word(state, "type"):
			match consume_builtin_type(state):
				Err(error):
					failure = Some(error)
					break
				Ok(parsed):
					builtin_types = builtin_types.append(parsed.declaration)
					state = parsed.next
		else if at_word(state, "private"):
			failure = Some(expected(state, "private declarations are not supported yet", "omit private; local module declarations are public by default"))
			break
		else if (
			at_word(state, "fixed")
			and at_word({ state | position = IntOps.add(state.position, 1) }, "record")
		):
			match consume_record(state, module):
				Err(error):
					failure = Some(error)
					break
				Ok(parsed):
					records = records.append(parsed.declaration)
					state = parsed.next
		else if at_word(state, "fixed"):
			match consume_union(state, module):
				Err(error):
					failure = Some(error)
					break
				Ok(parsed):
					unions = unions.append(parsed.declaration)
					state = parsed.next
		else:
			match consume_function(state, module):
				Err(error):
					failure = Some(error)
					break
				Ok(parsed):
					functions = functions.append(parsed.function)
					state = parsed.next

		if IntOps.equals(state.position, input.tokens.length()):
			break

		match consume_symbol(
			state,
			Newline,
			"expected a newline after the return expression",
			"put each declaration on a new line",
		):
			Err(error):
				failure = Some(error)
				break
			Ok(next):
				state = next

		if IntOps.equals(state.position, input.tokens.length()):
			break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(into_opaque ParsedModule({
						base_names = names,
						module = module,
						imports = imports,
						builtin_types = builtin_types,
						names = state.names,
						functions = functions,
						unions = unions,
						records = records,
						end = input.end
					}))


private fixed record ParsedPostfix {
	operation: PostfixOperation,
	next: ParserState
}


private pure func consume_postfix(state: ParserState) -> Result[ParsedPostfix, Diagnostic]:
	name ?= consume_name(state, "expected a field or function name after '.'")
	implicit_arguments ?= reject_function_type_arguments(name.next)

	if at_symbol(name.next, LeftParen):
		arguments ?= consume_arguments({ name.next | position = IntOps.add(name.next.position, 1) })
		closing ?= arguments.next.input.tokens
			.get(IntOps.subtract(arguments.next.position, 1))
			.to_result(
				expected(
					arguments.next,
					"invalid call span",
					"report this compiler error with the input program",
				),
			)
		Ok({
			operation = ReceiverInvocation({
				span = {
					source = name.name.span.source,
					start = name.name.span.start,
					end = closing.span.end
				},
				callee = name.name,
				arguments = arguments.arguments,
			}),
			next = arguments.next,
		})
	else:
		Ok({
			operation = FieldAccess(name.name),
			next = name.next,
		})


private pure func consume_record_literal(
	start: ParserState,
	opening: Span,
) -> Result[ParsedValue, Diagnostic]:
	var state = start
	var fields: List[ParsedRecordField] = []
	var failure: Option[Diagnostic] = None

	if not at_symbol(state, RightBrace):
		while True:
			result: Result[ParsedLiteralField, Diagnostic] = consume_name(
				state,
				"expected a record field name",
			).and_then(pure func(name: ParsedName) -> Result[ParsedLiteralField, Diagnostic]:
				after_equals ?= consume_symbol(
					name.next,
					Equals,
					"expected '=' after the record field name",
					"write field = expression",
				)
				value ?= consume_value(after_equals)
				Ok({
					field = {
						name = name.name,
						value = value.body
					},
					next = value.next,
				})
			)

			match result:
				Err(error):
					failure = Some(error)
					break
				Ok(field):
					fields = fields.append(field.field)
					state = field.next

			if not at_symbol(state, Comma):
				break

			state = { state | position = IntOps.add(state.position, 1) }

	ready ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	closed ?= consume_symbol(
		state,
		RightBrace,
		"expected '}' after the record fields",
		"keep record fields on one line, separated by commas",
	)

	last = match state.input.tokens.get(state.position):
		Some(token):
			token.span.end
		None:
			opening.end

	span: Span = {
		source = opening.source,
		start = opening.start,
		end = last
	}
	Ok({
		body = {
			base = RecordExpression(fields),
			base_span = span,
			applications = [],
			span = span
		},
		next = closed,
	})


private fixed record ParsedLiteralField {
	field: ParsedRecordField,
	next: ParserState
}


private fixed record ParsedParameterResult {
	parameter: ParsedParameter,
	next: ParserState
}


private pure func consume_parameter_type(
	name: ParsedName,
) -> Result[ParsedParameterResult, Diagnostic]:
	after_colon ?= consume_symbol(
		name.next,
		Colon,
		"expected ':' after the parameter name",
		"write each parameter as name: Type",
	)
	type_name ?= consume_type(after_colon, "expected a parameter type")
	Ok({
		parameter = {
			name = name.name,
			type_name = type_name.written
		},
		next = type_name.next,
	})


private fixed record ParsedRecordResult {
	declaration: ParsedRecord,
	next: ParserState
}


private pure func consume_record(start: ParserState, module: ModuleId) -> Result[ParsedRecordResult, Diagnostic]:
	name ?= consume_name(
		{ start | position = IntOps.add(start.position, 2) },
		"expected a record type name",
	)
	opened ?= consume_symbol(
		name.next,
		LeftBrace,
		"expected '{' after the record type name",
		"write fixed record Name { field: Int }",
	)
	var state = opened
	var fields: List[ParsedParameter] = []
	var failure: Option[Diagnostic] = None

	while True:
		result = consume_name(
			state,
			"expected a record field name",
		).and_then(
			pure func(field): consume_parameter_type(field),
		)

		match result:
			Err(error):
				failure = Some(error)
				break
			Ok(field):
				fields = fields.append(field.parameter)
				state = field.next

		if not at_symbol(state, Comma):
			break

		state = { state | position = IntOps.add(state.position, 1) }

	ready ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	closed ?= consume_symbol(
		state,
		RightBrace,
		"expected '}' after the record declaration",
		"keep nonempty record fields on one line, separated by commas",
	)
	Ok({
		declaration = {
			module = module,
			type_name = name.name,
			fields = fields
		},
		next = closed,
	})
