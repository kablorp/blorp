import:
	int as IntOps
	syntax:
		Diagnostic,
		LexedProgram,
		ParsedFunction,
		ParsedProgram,
		Purity(Pure, Impure),
		ReturnExpression(IntegerExpression, CallExpression),
		Span,
		Symbol(PureKeyword, FunctionKeyword, LeftParen, RightParen, Arrow, Colon, Newline, Indent),
		TokenKind(IdentifierToken, SymbolToken, IntegerLiteral),
		WrittenName,
	text: concat


private fixed record ParserState {
	input: LexedProgram,
	position: Int
}


private fixed record ParsedName {
	name: WrittenName,
	next: ParserState
}


private pure func expected(state: ParserState, message: String, help: String) -> Diagnostic:
	span: Span = match state.input.tokens.get(state.position):
		Some(token):
			token.span
		None:
			state.input.end

	{
		span = span,
		message = message,
		help = help
	}


private pure func symbol_matches(actual: Symbol, expected: Symbol) -> Bool:
	match actual:
		PureKeyword:
			match expected:
				PureKeyword:
					True
				_:
					False
		FunctionKeyword:
			match expected:
				FunctionKeyword:
					True
				_:
					False
		LeftParen:
			match expected:
				LeftParen:
					True
				_:
					False
		RightParen:
			match expected:
				RightParen:
					True
				_:
					False
		Arrow:
			match expected:
				Arrow:
					True
				_:
					False
		Colon:
			match expected:
				Colon:
					True
				_:
					False
		Newline:
			match expected:
				Newline:
					True
				_:
					False
		Indent:
			match expected:
				Indent:
					True
				_:
					False


private pure func consume_symbol(
	state: ParserState,
	symbol: Symbol,
	message: String,
	help: String,
) -> Result[ParserState, Diagnostic]:
	match state.input.tokens.get(state.position):
		Some(token):
			match token.kind:
				SymbolToken(actual):
					if symbol_matches(actual, symbol):
						Ok({
							input = state.input,
							position = IntOps.add(state.position, 1),
						})
					else:
						Err(expected(state, message, help))
				_:
					Err(expected(state, message, help))
		None:
			Err(expected(state, message, help))


private pure func identifier_help() -> String:
	"use an ASCII identifier starting with a letter or underscore; ".concat(
		"'func' and 'pure' are reserved",
	)


private pure func consume_name(
	state: ParserState,
	message: String,
) -> Result[ParsedName, Diagnostic]:
	match state.input.tokens.get(state.position):
		Some(token):
			match token.kind:
				IdentifierToken(spelling):
					Ok({
						name = {
							spelling = spelling,
							span = token.span
						},
						next = {
							input = state.input,
							position = IntOps.add(state.position, 1)
						},
					})
				_:
					Err(expected(state, message, identifier_help()))
		None:
			Err(expected(state, message, identifier_help()))


private fixed record ParsedBody {
	body: ReturnExpression,
	next: ParserState
}


private fixed record FunctionResult {
	function: ParsedFunction,
	next: ParserState
}


private pure func consume_body(state: ParserState) -> Result[ParsedBody, Diagnostic]:
	match state.input.tokens.get(state.position):
		Some(token):
			next: ParserState = {
				input = state.input,
				position = IntOps.add(state.position, 1)
			}

			match token.kind:
				IntegerLiteral(value):
					Ok({
						body = IntegerExpression(value),
						next = next,
					})
				IdentifierToken(spelling):
					opened ?= consume_symbol(
						next,
						LeftParen,
						"expected '(' after the called function",
						"write a zero-argument call such as one()",
					)
					closed ?= consume_symbol(
						opened,
						RightParen,
						"expected ')' with no arguments",
						"calls take no arguments in this increment",
					)
					Ok({
						body = CallExpression({
							spelling = spelling,
							span = token.span,
						}),
						next = closed,
					})
				_:
					Err(
						expected(
							state,
							"expected a return expression",
							"use 0, 1, or a zero-argument function call as the entire body",
						),
					)
		None:
			Err(
				expected(
					state,
					"expected a return expression",
					"use 0, 1, or a zero-argument function call as the entire body",
				),
			)


private pure func consume_function(start: ParserState) -> Result[FunctionResult, Diagnostic]:
	purity: Purity = match start.input.tokens.get(start.position):
		Some(token):
			match token.kind:
				SymbolToken(PureKeyword):
					Pure
				_:
					Impure
		None:
			Impure

	after_func ?= match purity:
		Pure:
			consume_symbol(
				{ start | position = IntOps.add(start.position, 1) },
				FunctionKeyword,
				"expected 'func' after 'pure'",
				"write pure func name() -> Int:",
			)
		Impure:
			consume_symbol(
				start,
				FunctionKeyword,
				"expected a function declaration at column 1",
				"start with func main() -> Int:",
			)

	function ?= consume_name(after_func, "expected a function name")
	after_open ?= consume_symbol(
		function.next,
		LeftParen,
		"expected '(' after the function name",
		"write main() with no parameters",
	)
	after_parameters ?= consume_symbol(
		after_open,
		RightParen,
		"expected ')' with no parameters",
		"write main() with no parameters",
	)
	after_arrow ?= consume_symbol(
		after_parameters,
		Arrow,
		"expected '->' before the return type",
		"write main() -> Int with adjacent arrow characters",
	)
	return_type ?= consume_name(after_arrow, "expected a return type")
	after_header ?= consume_symbol(
		return_type.next,
		Colon,
		"expected ':' after the function header",
		"end the header with ':' and put the return expression on the next line",
	)
	after_newline ?= consume_symbol(
		after_header,
		Newline,
		"expected a newline after the function header",
		"put the return expression on the next line",
	)
	after_indent ?= consume_symbol(
		after_newline,
		Indent,
		"expected an indent of one tab or four spaces",
		"indent the body with exactly one tab or four spaces",
	)
	body ?= consume_body(after_indent)
	Ok({
		function = {
			purity = purity,
			function_name = function.name,
			return_type = return_type.name,
			body = body.body
		},
		next = body.next,
	})


pure func parse(input: LexedProgram) -> Result[ParsedProgram, Diagnostic]:
	var state: ParserState = {
		input = input,
		position = 0
	}
	var functions: List[ParsedFunction] = []
	var failure: Option[Diagnostic] = None

	while True:
		match consume_function(state):
			Err(error):
				failure = Some(error)
				break
			Ok(parsed):
				functions = functions.append(parsed.function)
				state = parsed.next

		if IntOps.equals(state.position, input.tokens.length()):
			break

		match consume_symbol(
			state,
			Newline,
			"expected a newline after the return expression",
			"put each declaration on its own two lines with no blank lines",
		):
			Err(error):
				failure = Some(error)
				break
			Ok(next):
				state = next

		if IntOps.equals(state.position, input.tokens.length()):
			break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({
				functions = functions,
				end = input.end,
			})
