import:
	names: NameId, NameTable, SpecialNames


-- Source spans are half-open byte ranges; spelling belongs to the name table.
fixed record Span {
	start: Int,
	end: Int
}


fixed record Diagnostic {
	span: Span,
	message: String,
	help: String
}


fixed union Symbol:
	PureKeyword
	FunctionKeyword
	LeftParen
	RightParen
	Dot
	Arrow
	Colon
	Newline
	Indent


fixed union TokenKind:
	IdentifierToken(String)
	SymbolToken(Symbol)
	IntegerLiteral(String)


DECIMAL_DIGITS: String = "0123456789"


fixed record Token {
	kind: TokenKind,
	span: Span
}


fixed record LexedProgram {
	tokens: List[Token],
	end: Span
}


fixed record WrittenName {
	id: NameId,
	span: Span
}


fixed record ParsedParameter {
	name: WrittenName,
	type_name: WrittenName
}


fixed union ParameterList:
	EmptyParameters
	SingleParameter(ParsedParameter)


fixed union ExpressionBase:
	IntegerExpression(Int)
	NameExpression(WrittenName)
	CallExpression(WrittenName)


fixed union CallNotation:
	DirectCall
	ReceiverCall


fixed record UnaryCall {
	callee: WrittenName,
	notation: CallNotation
}


-- Each call has at most one argument, so a body is one base followed by
-- unary calls in evaluation order, from the innermost call to the outermost.
fixed record ReturnExpression {
	base: ExpressionBase,
	unary_calls: List[UnaryCall]
}


fixed union Purity:
	Pure
	Impure


fixed record ParsedFunction {
	purity: Purity,
	function_name: WrittenName,
	parameters: ParameterList,
	return_type: WrittenName,
	body: ReturnExpression
}


fixed record ParsedContents {
	names: NameTable,
	special: SpecialNames,
	functions: List[ParsedFunction],
	end: Span
}
