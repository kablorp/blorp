-- Source spans are half-open byte ranges. Only syntax owns written names.
fixed record Span {
	start: Int,
	end: Int
}


fixed record Diagnostic {
	span: Span,
	message: String,
	help: String
}


fixed union Symbol:
	PureKeyword
	FunctionKeyword
	LeftParen
	RightParen
	Arrow
	Colon
	Newline
	Indent


fixed union TokenKind:
	IdentifierToken(String)
	SymbolToken(Symbol)
	IntegerLiteral(IntegerValue)


fixed union IntegerValue:
	Zero
	One


fixed record Token {
	kind: TokenKind,
	span: Span
}


fixed record LexedProgram {
	tokens: List[Token],
	end: Span
}


fixed record WrittenName {
	spelling: String,
	span: Span
}


fixed record ParsedParameter {
	name: WrittenName,
	type_name: WrittenName
}


fixed union ParameterList:
	EmptyParameters
	SingleParameter(ParsedParameter)


fixed union ExpressionBase:
	IntegerExpression(IntegerValue)
	NameExpression(WrittenName)
	CallExpression(WrittenName)


-- Each call has at most one argument, so a body is one base followed by
-- unary calls in evaluation order, from the innermost call to the outermost.
fixed record ReturnExpression {
	base: ExpressionBase,
	unary_calls: List[WrittenName]
}


fixed union Purity:
	Pure
	Impure


fixed record ParsedFunction {
	purity: Purity,
	function_name: WrittenName,
	parameters: ParameterList,
	return_type: WrittenName,
	body: ReturnExpression
}


fixed record ParsedProgram {
	functions: List[ParsedFunction],
	end: Span
}
