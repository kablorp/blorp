import:
	names: NameId, NameTable, SpecialNames


-- Source spans are half-open byte ranges; spelling belongs to the name table.
fixed record Span {
	start: Int,
	end: Int
}


fixed record Diagnostic {
	span: Span,
	message: String,
	help: String
}


fixed union Symbol:
	PureKeyword
	FunctionKeyword
	MatchKeyword
	VarKeyword
	Equals
	Wildcard
	LeftParen
	RightParen
	Dot
	Arrow
	Colon
	Newline


fixed union TokenKind:
	IdentifierToken(String)
	SymbolToken(Symbol)
	IntegerLiteral(String)
	Indentation(Int)


DECIMAL_DIGITS: String = "0123456789"


fixed record Token {
	kind: TokenKind,
	span: Span
}


fixed record LexedProgram {
	tokens: List[Token],
	end: Span
}


fixed record WrittenName {
	id: NameId,
	span: Span
}


fixed record ParsedParameter {
	name: WrittenName,
	type_name: WrittenName
}


fixed union ParameterList:
	EmptyParameters
	SingleParameter(ParsedParameter)


fixed union ExpressionBase:
	IntegerExpression(Int)
	NameExpression(WrittenName)
	ZeroArgumentApplication(WrittenName)


fixed union CallNotation:
	DirectCall
	ReceiverCall


fixed record UnaryApplication {
	callee: WrittenName,
	notation: CallNotation
}


-- A value leaf is one base followed by unary applications in evaluation
-- order, from the innermost application to the outermost.
fixed record ValueExpression {
	base: ExpressionBase,
	base_span: Span,
	applications: List[UnaryApplication],
	span: Span
}


fixed union Purity:
	Pure
	Impure


fixed union FieldPattern:
	FieldName(WrittenName)
	FieldWildcard(Span)


fixed union PatternFields:
	NoPatternFields
	OnePatternField(FieldPattern)


fixed union ParsedPattern:
	PatternName(WrittenName)
	PatternWildcard(Span)
	PatternConstructor(WrittenName, PatternFields, Span)


fixed record ParsedMatchArm {
	pattern: ParsedPattern,
	bindings: List[ParsedBinding],
	body: ValueExpression,
	span: Span
}


fixed record ParsedMatch {
	scrutinee: ValueExpression,
	arms: List[ParsedMatchArm],
	keyword_span: Span,
	span: Span
}


fixed union ParsedBody:
	ParsedValueBody(ValueExpression)
	ParsedMatchBody(ParsedMatch)


fixed union BindingSyntax:
	ImmutableBinding
	MutableBinding


fixed record ParsedBinding {
	name: WrittenName,
	mutability: BindingSyntax,
	initializer: ValueExpression
}


fixed record ParsedFunction {
	purity: Purity,
	function_name: WrittenName,
	parameters: ParameterList,
	return_type: WrittenName,
	bindings: List[ParsedBinding],
	body: ParsedBody
}


fixed union PayloadSyntax:
	NoPayloadSyntax
	OnePayloadSyntax(WrittenName)


fixed record ParsedVariant {
	name: WrittenName,
	payload: PayloadSyntax
}


fixed record ParsedUnion {
	type_name: WrittenName,
	variants: List[ParsedVariant]
}


fixed record ParsedContents {
	names: NameTable,
	special: SpecialNames,
	functions: List[ParsedFunction],
	unions: List[ParsedUnion],
	end: Span
}
