-- Source spans are half-open byte ranges. Only syntax owns written names.
fixed record Span {
	start: Int,
	end: Int
}


fixed record Diagnostic {
	span: Span,
	message: String,
	help: String
}


fixed union Symbol:
	FunctionKeyword
	LeftParen
	RightParen
	Arrow
	Colon
	Newline
	Indent


fixed union TokenKind:
	IdentifierToken(String)
	SymbolToken(Symbol)
	ZeroLiteral


fixed record Token {
	kind: TokenKind,
	span: Span
}


fixed record LexedProgram {
	tokens: List[Token],
	end: Span
}


fixed record WrittenName {
	spelling: String,
	span: Span
}


fixed union ReturnExpression:
	ZeroExpression


fixed record ParsedProgram {
	function_name: WrittenName,
	return_type: WrittenName,
	body: ReturnExpression
}
